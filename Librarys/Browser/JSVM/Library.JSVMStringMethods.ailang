// Library.JSVMStringMethods.ailang — String method dispatch
// Split from Library.JSVM.ailang. FixedPools declared in root file.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// ES WhiteSpace + LineTerminator used by trim* (common BMP)
Function.JSVM__IsTrimWS {
    Input: ch: Integer
    Output: Integer
    Body: {
        // TAB LF VT FF CR SPACE
        IfCondition EqualTo(ch, 9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 11) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 12) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 13) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 32) ThenBlock: { ReturnValue(1) }
        // NBSP
        IfCondition EqualTo(ch, 160) ThenBlock: { ReturnValue(1) }
        // BOM / ZWNBSP
        IfCondition EqualTo(ch, 65279) ThenBlock: { ReturnValue(1) }
        // Ogham space
        IfCondition EqualTo(ch, 5760) ThenBlock: { ReturnValue(1) }
        // en/em/etc spaces U+2000..U+200A
        IfCondition And(GreaterEqual(ch, 8192), LessEqual(ch, 8202)) ThenBlock: { ReturnValue(1) }
        // line/paragraph separator U+2028 U+2029
        IfCondition EqualTo(ch, 8232) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 8233) ThenBlock: { ReturnValue(1) }
        // narrow NBSP U+202F, medium math space U+205F, ideographic space U+3000
        IfCondition EqualTo(ch, 8239) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 8287) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 12288) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// =============================================================================
// STRING METHOD DISPATCH — execute string methods with receiver
// =============================================================================
Function.JSVM__DispatchStringMethod {
    Input: method_id: Integer
    Input: receiver: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = method_id
        save_recv = receiver
        save_args = args
        save_argc = argc

        // Debug trace (disabled)
        // PrintMessage("[DispStr] id=")
        // PrintNumber(save_id)
        // PrintMessage(" recv=")
        // PrintNumber(save_recv)
        // PrintMessage("\n")

        // M30a: RequireObjectCoercible + ToString(this) for String.prototype methods.
        // Skip static fromCharCode (72), fromCodePoint (229), Array ctor/methods
        // and RegExp methods (80-87 range uses own extract).
        str_ptr = 0
        str_len = 0
        need_str_this = 0
        IfCondition And(GreaterEqual(save_id, 62), LessEqual(save_id, 75)) ThenBlock: {
            IfCondition And(NotEqual(save_id, 72), NotEqual(save_id, 229)) ThenBlock: { need_str_this = 1 }
        }
        IfCondition EqualTo(save_id, 230) ThenBlock: { need_str_this = 1 }
        IfCondition EqualTo(save_id, 232) ThenBlock: { need_str_this = 1 }
        IfCondition EqualTo(save_id, 97) ThenBlock: { need_str_this = 1 }
        IfCondition And(GreaterEqual(save_id, 180), LessEqual(save_id, 186)) ThenBlock: {
            need_str_this = 1
        }
        IfCondition EqualTo(need_str_this, 1) ThenBlock: {
            recv_type = JSType.UNDEFINED
            IfCondition NotEqual(save_recv, 0) ThenBlock: {
                recv_type = JSRT_GetType(save_recv)
            }
            IfCondition Or(EqualTo(recv_type, JSType.NULL), EqualTo(recv_type, JSType.UNDEFINED)) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "String method called on null or undefined")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            IfCondition NotEqual(recv_type, JSType.STRING) ThenBlock: {
                save_recv = JSRT_ToString(save_recv)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
            }
            str_ptr = JSRT_GetPayload(save_recv)
            str_len = 0
            IfCondition NotEqual(str_ptr, 0) ThenBlock: {
                str_len = JSRT_StrLen(str_ptr)
            }
        } ElseBlock: {
            // Static / non-string-method: optional raw string extract
            IfCondition NotEqual(save_recv, 0) ThenBlock: {
                recv_type = JSRT_GetType(save_recv)
                IfCondition EqualTo(recv_type, JSType.STRING) ThenBlock: {
                    str_ptr = JSRT_GetPayload(save_recv)
                    str_len = JSRT_StrLen(str_ptr)
                }
            }
        }

        // ─── charAt (62) ───
        IfCondition EqualTo(save_id, 62) ThenBlock: {
            idx = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                idx = Float_ToInt(JSRT_ToNumber(a0))
            }
            oob = 0
            IfCondition LessThan(idx, 0) ThenBlock: { oob = 1 }
            IfCondition GreaterEqual(idx, str_len) ThenBlock: { oob = 1 }
            IfCondition EqualTo(oob, 1) ThenBlock: {
                ReturnValue(JSRT_CreateString(""))
            }
            // M31a: one code unit as new string
            ReturnValue(JSRT_CreateStringSlice(str_ptr, idx, 1))
        }

        // ─── at (232) ─── relative index; OOB → undefined
        IfCondition EqualTo(save_id, 232) ThenBlock: {
            idx = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                idx = Float_ToInt(JSRT_ToNumber(a0))
            }
            IfCondition LessThan(idx, 0) ThenBlock: {
                idx = Add(str_len, idx)
            }
            IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, str_len)) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            ReturnValue(JSRT_CreateStringSlice(str_ptr, idx, 1))
        }

        // ─── charCodeAt (63) ───
        IfCondition EqualTo(save_id, 63) ThenBlock: {
            idx = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                idx = Float_ToInt(JSRT_ToNumber(a0))
            }
            oob = 0
            IfCondition LessThan(idx, 0) ThenBlock: { oob = 1 }
            IfCondition GreaterEqual(idx, str_len) ThenBlock: { oob = 1 }
            IfCondition EqualTo(oob, 1) ThenBlock: {
                nan_bits = Float_Div(Float_FromInt(0), Float_FromInt(0))
                ReturnValue(JSRT_CreateFloat(nan_bits))
            }
            code = JSRT_StrUnit(str_ptr, idx)
            ReturnValue(JSRT_CreateNumber(code))
        }

        // ─── codePointAt (230) ─── M31a UTF-16 code point
        IfCondition EqualTo(save_id, 230) ThenBlock: {
            idx = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                idx = Float_ToInt(JSRT_ToNumber(a0))
            }
            oob = 0
            IfCondition LessThan(idx, 0) ThenBlock: { oob = 1 }
            IfCondition GreaterEqual(idx, str_len) ThenBlock: { oob = 1 }
            IfCondition EqualTo(oob, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            cu1 = JSRT_StrUnit(str_ptr, idx)
            // high surrogate D800-DBFF, low DC00-DFFF
            is_hi = 0
            IfCondition GreaterEqual(cu1, 55296) ThenBlock: {
                IfCondition LessEqual(cu1, 56319) ThenBlock: { is_hi = 1 }
            }
            IfCondition EqualTo(is_hi, 1) ThenBlock: {
                IfCondition LessThan(Add(idx, 1), str_len) ThenBlock: {
                    cu2 = JSRT_StrUnit(str_ptr, Add(idx, 1))
                    is_lo = 0
                    IfCondition GreaterEqual(cu2, 56320) ThenBlock: {
                        IfCondition LessEqual(cu2, 57343) ThenBlock: { is_lo = 1 }
                    }
                    IfCondition EqualTo(is_lo, 1) ThenBlock: {
                        hi_off = Subtract(cu1, 55296)
                        lo_off = Subtract(cu2, 56320)
                        cp = Add(65536, Add(Multiply(hi_off, 1024), lo_off))
                        ReturnValue(JSRT_CreateNumber(cp))
                    }
                }
            }
            ReturnValue(JSRT_CreateNumber(cu1))
        }

        // ─── indexOf (64) — ToString(search), optional fromIndex ───
        IfCondition EqualTo(save_id, 64) ThenBlock: {
            // searchString defaults to "undefined" if missing
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                search_str = JSRT_ToString(JSRT_Undefined())
            } ElseBlock: {
                search_str = JSRT_ToString(Dereference(save_args))
            }
            search_ptr = JSRT_GetPayload(search_str)
            IfCondition EqualTo(search_ptr, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(-1))
            }
            search_len = JSRT_StrLen(search_ptr)
            // fromIndex (default 0)
            off = 0
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                off = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
            }
            IfCondition LessThan(off, 0) ThenBlock: { off = 0 }
            IfCondition GreaterThan(off, str_len) ThenBlock: { off = str_len }
            IfCondition EqualTo(search_len, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(off))
            }
            si = off
            found = -1
            WhileLoop LessEqual(Add(si, search_len), str_len) {
                IfCondition EqualTo(found, -1) ThenBlock: {
                    match = 1
                    mi = 0
                    WhileLoop LessThan(mi, search_len) {
                        IfCondition NotEqual(JSRT_StrUnit(str_ptr, Add(si, mi)), JSRT_StrUnit(search_ptr, mi)) ThenBlock: {
                            match = 0
                            mi = search_len
                        }
                        mi = Add(mi, 1)
                    }
                    IfCondition EqualTo(match, 1) ThenBlock: {
                        found = si
                    }
                }
                si = Add(si, 1)
            }
            ReturnValue(JSRT_CreateNumber(found))
        }

        // ─── substring (65) ───
        IfCondition EqualTo(save_id, 65) ThenBlock: {
            start = 0
            end_idx = str_len
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                start = Float_ToInt(JSRT_ToNumber(a0))
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                a1 = Dereference(Add(save_args, 8))
                end_idx = Float_ToInt(JSRT_ToNumber(a1))
            }
            // Clamp
            IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
            IfCondition GreaterThan(start, str_len) ThenBlock: { start = str_len }
            IfCondition LessThan(end_idx, 0) ThenBlock: { end_idx = 0 }
            IfCondition GreaterThan(end_idx, str_len) ThenBlock: { end_idx = str_len }
            // Swap if start > end
            IfCondition GreaterThan(start, end_idx) ThenBlock: {
                tmp_s = start
                start = end_idx
                end_idx = tmp_s
            }
            sub_len = Subtract(end_idx, start)
            ReturnValue(JSRT_CreateStringSlice(str_ptr, start, sub_len))
        }

        // ─── slice (66) ───
        IfCondition EqualTo(save_id, 66) ThenBlock: {
            start = 0
            end_idx = str_len
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                start = Float_ToInt(JSRT_ToNumber(a0))
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                a1 = Dereference(Add(save_args, 8))
                end_idx = Float_ToInt(JSRT_ToNumber(a1))
            }
            // Negative indices
            IfCondition LessThan(start, 0) ThenBlock: {
                start = Add(str_len, start)
                IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
            }
            IfCondition LessThan(end_idx, 0) ThenBlock: {
                end_idx = Add(str_len, end_idx)
                IfCondition LessThan(end_idx, 0) ThenBlock: { end_idx = 0 }
            }
            IfCondition GreaterThan(start, str_len) ThenBlock: { start = str_len }
            IfCondition GreaterThan(end_idx, str_len) ThenBlock: { end_idx = str_len }
            IfCondition GreaterEqual(start, end_idx) ThenBlock: {
                ReturnValue(JSRT_CreateString(""))
            }
            sub_len = Subtract(end_idx, start)
            ReturnValue(JSRT_CreateStringSlice(str_ptr, start, sub_len))
        }

        // ─── replace (67) — string or RegExp search; ToString replacement ───
        IfCondition EqualTo(save_id, 67) ThenBlock: {
            IfCondition EqualTo(str_ptr, 0) ThenBlock: {
                ReturnValue(JSRT_CreateString(""))
            }
            is_re = 0
            rx_h = 0
            is_global = 0
            is_sticky = 0
            re_obj = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                a0_type = JSRT_GetType(a0)
                IfCondition EqualTo(a0_type, JSType.OBJECT) ThenBlock: {
                    rh = JSRT_ObjGet(a0, "__regex_handle__")
                    IfCondition EqualTo(JSRT_GetType(rh), JSType.NUMBER) ThenBlock: {
                        is_re = 1
                        re_obj = a0
                        rx_h = JSRT_GetPayload(rh)
                        gv = JSRT_ObjGet(a0, "global")
                        IfCondition EqualTo(JSRT_GetType(gv), JSType.BOOLEAN) ThenBlock: {
                            IfCondition NotEqual(JSRT_GetPayload(gv), 0) ThenBlock: { is_global = 1 }
                        }
                        yv = JSRT_ObjGet(a0, "sticky")
                        IfCondition EqualTo(JSRT_GetType(yv), JSType.BOOLEAN) ThenBlock: {
                            IfCondition NotEqual(JSRT_GetPayload(yv), 0) ThenBlock: { is_sticky = 1 }
                        }
                    }
                }
                IfCondition EqualTo(is_re, 0) ThenBlock: {
                    search_str = JSRT_ToString(a0)
                }
            } ElseBlock: {
                search_str = JSRT_ToString(JSRT_Undefined())
            }
            is_fn_repl = 0
            repl_fn = 0
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                a1 = Dereference(Add(save_args, 8))
                IfCondition EqualTo(JSRT_GetType(a1), JSType.FUNCTION) ThenBlock: {
                    // M30i: functional replace
                    is_fn_repl = 1
                    repl_fn = a1
                    repl_ptr = ""
                    repl_len = 0
                } ElseBlock: {
                    repl_str = JSRT_ToString(a1)
                    repl_ptr = JSRT_GetPayload(repl_str)
                    IfCondition EqualTo(repl_ptr, 0) ThenBlock: { repl_ptr = "" }
                    repl_len = JSRT_StrLen(repl_ptr)
                }
            } ElseBlock: {
                repl_str = JSRT_ToString(JSRT_Undefined())
                repl_ptr = JSRT_GetPayload(repl_str)
                IfCondition EqualTo(repl_ptr, 0) ThenBlock: { repl_ptr = "" }
                repl_len = JSRT_StrLen(repl_ptr)
            }

            // ── RegExp path ──
            IfCondition EqualTo(is_re, 1) ThenBlock: {
                IfCondition EqualTo(rx_h, 0) ThenBlock: { ReturnValue(save_recv) }
                rbuf = JSRTState.str_work_buf
                // M30h: snapshot replacement template — may alias str_work_buf after ToString
                // M31a: snapshot as C/Latin-1 units for GetSubstitution
                repl_copy = 0
                IfCondition And(EqualTo(is_fn_repl, 0), GreaterThan(repl_len, 0)) ThenBlock: {
                    repl_copy = Allocate(Add(repl_len, 1))
                    IfCondition NotEqual(repl_copy, 0) ThenBlock: {
                        JSRT_StrEmit(repl_copy, 0, repl_ptr, 0, repl_len)
                        SetByte(repl_copy, repl_len, 0)
                        repl_ptr = repl_copy
                    }
                }
                out_pos = 0
                scan = 0
                // sticky (and global sticky) honor lastIndex as start
                IfCondition Or(EqualTo(is_global, 1), EqualTo(is_sticky, 1)) ThenBlock: {
                    liv = JSRT_ObjGet(re_obj, "lastIndex")
                    IfCondition EqualTo(JSRT_GetType(liv), JSType.NUMBER) ThenBlock: {
                        scan = Float_ToInt(JSRT_GetPayload(liv))
                        IfCondition LessThan(scan, 0) ThenBlock: { scan = 0 }
                    }
                }
                // copy prefix before lastIndex for sticky non-global
                IfCondition And(EqualTo(is_sticky, 1), EqualTo(is_global, 0)) ThenBlock: {
                    IfCondition GreaterThan(scan, 0) ThenBlock: {
                        IfCondition GreaterThan(scan, str_len) ThenBlock: { scan = str_len }
                        out_pos = JSRT_StrEmit(rbuf, 0, str_ptr, 0, scan)
                    }
                }
                did = 0
                WhileLoop LessEqual(scan, str_len) {
                    found_re = JSRegex_SearchPosLenFrom(rx_h, str_ptr, str_len, scan)
                    IfCondition EqualTo(found_re, 0) ThenBlock: {
                        // copy rest
                        rest = Subtract(str_len, scan)
                        IfCondition GreaterThan(rest, 0) ThenBlock: {
                            out_pos = JSRT_StrEmit(rbuf, out_pos, str_ptr, scan, rest)
                        }
                        scan = Add(str_len, 1)
                        IfCondition Or(EqualTo(is_global, 1), EqualTo(is_sticky, 1)) ThenBlock: {
                            JSRT_ObjSet(re_obj, "lastIndex", JSRT_CreateNumber(0))
                        }
                    } ElseBlock: {
                        mpos = JSRxResult.pos
                        mlen = JSRxResult.len
                        // copy prefix before match
                        pre = Subtract(mpos, scan)
                        IfCondition GreaterThan(pre, 0) ThenBlock: {
                            out_pos = JSRT_StrEmit(rbuf, out_pos, str_ptr, scan, pre)
                        }
                        // M30i: functional replace or GetSubstitution
                        IfCondition EqualTo(is_fn_repl, 1) ThenBlock: {
                            ab = JSVMCallBuf.buf
                            ac = 0
                            JSBridge__Push(str_ptr)
                            JSBridge__Push(str_len)
                            JSBridge__Push(rbuf)
                            JSBridge__Push(out_pos)
                            JSBridge__Push(rx_h)
                            JSBridge__Push(re_obj)
                            JSBridge__Push(repl_fn)
                            m_str = JSRT_CreateStringSlice(str_ptr, mpos, mlen)
                            StoreValue(ab, m_str)
                            ac = 1
                            ng = JSRxResult.ngroups
                            cbuf = JSRxResult.cap_buf
                            gi = 0
                            WhileLoop LessThan(gi, ng) {
                                cs = -1
                                ce = -1
                                IfCondition NotEqual(cbuf, 0) ThenBlock: {
                                    cs = Dereference(Add(cbuf, Multiply(Multiply(gi, 2), 8)))
                                    ce = Dereference(Add(cbuf, Multiply(Add(Multiply(gi, 2), 1), 8)))
                                }
                                IfCondition And(GreaterEqual(cs, 0), GreaterEqual(ce, cs)) ThenBlock: {
                                    c_str = JSRT_CreateStringSlice(str_ptr, cs, Subtract(ce, cs))
                                    StoreValue(Add(ab, Multiply(ac, 8)), c_str)
                                } ElseBlock: {
                                    StoreValue(Add(ab, Multiply(ac, 8)), JSRT_Undefined())
                                }
                                ac = Add(ac, 1)
                                gi = Add(gi, 1)
                            }
                            StoreValue(Add(ab, Multiply(ac, 8)), JSRT_CreateNumber(mpos))
                            ac = Add(ac, 1)
                            inp_s = JSRT_CreateStringSlice(str_ptr, 0, str_len)
                            StoreValue(Add(ab, Multiply(ac, 8)), inp_s)
                            ac = Add(ac, 1)
                            tmp_arr = JSRT_CreateArray()
                            tmp_arr = JSVM__AttachRegExpGroups(tmp_arr, rx_h, str_ptr)
                            groups_v = JSRT_ObjGet(tmp_arr, "groups")
                            StoreValue(Add(ab, Multiply(ac, 8)), groups_v)
                            ac = Add(ac, 1)
                            repl_fn = JSBridge__Pop()
                            re_obj = JSBridge__Pop()
                            rx_h = JSBridge__Pop()
                            out_pos = JSBridge__Pop()
                            rbuf = JSBridge__Pop()
                            str_len = JSBridge__Pop()
                            str_ptr = JSBridge__Pop()
                            ret_v = JSVM__CallFunc(repl_fn, ab, ac)
                            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                ReturnValue(JSRT_Undefined())
                            }
                            ret_s = JSRT_ToString(ret_v)
                            ret_p = JSRT_GetPayload(ret_s)
                            ret_l = 0
                            IfCondition NotEqual(ret_p, 0) ThenBlock: { ret_l = JSRT_StrLen(ret_p) }
                            IfCondition GreaterThan(ret_l, 0) ThenBlock: {
                                out_pos = JSRT_StrEmit(rbuf, out_pos, ret_p, 0, ret_l)
                            }
                        } ElseBlock: {
                            IfCondition GreaterThan(repl_len, 0) ThenBlock: {
                                JSVMReplCtx.rx_h = rx_h
                                JSVMReplCtx.text_ptr = str_ptr
                                JSVMReplCtx.text_len = str_len
                                out_pos = JSVM__GetSubstitution(rbuf, out_pos, repl_ptr, repl_len)
                            }
                        }
                        did = 1
                        // advance past match
                        IfCondition EqualTo(mlen, 0) ThenBlock: {
                            // empty match — advance 1 to avoid infinite loop
                            IfCondition LessThan(mpos, str_len) ThenBlock: {
                                out_pos = JSRT_StrEmit(rbuf, out_pos, str_ptr, mpos, 1)
                            }
                            scan = Add(mpos, 1)
                        } ElseBlock: {
                            scan = Add(mpos, mlen)
                        }
                        IfCondition Or(EqualTo(is_global, 1), EqualTo(is_sticky, 1)) ThenBlock: {
                            JSRT_ObjSet(re_obj, "lastIndex", JSRT_CreateNumber(scan))
                        }
                        IfCondition EqualTo(is_global, 0) ThenBlock: {
                            // first only — copy rest and stop
                            rest = Subtract(str_len, scan)
                            IfCondition GreaterThan(rest, 0) ThenBlock: {
                                out_pos = JSRT_StrEmit(rbuf, out_pos, str_ptr, scan, rest)
                            }
                            scan = Add(str_len, 1)
                        }
                    }
                }
                IfCondition EqualTo(did, 0) ThenBlock: {
                    IfCondition NotEqual(repl_copy, 0) ThenBlock: {
                        Deallocate(repl_copy, Add(repl_len, 1))
                    }
                    ReturnValue(save_recv)
                }
                SetByte(rbuf, out_pos, 0)
                IfCondition NotEqual(repl_copy, 0) ThenBlock: {
                    Deallocate(repl_copy, Add(repl_len, 1))
                }
                ReturnValue(JSRT_CreateString(rbuf))
            }

            // ── String path ──
            search_ptr = JSRT_GetPayload(search_str)
            IfCondition EqualTo(search_ptr, 0) ThenBlock: {
                ReturnValue(save_recv)
            }
            search_len = JSRT_StrLen(search_ptr)
            si = 0
            found = -1
            WhileLoop LessEqual(Add(si, search_len), str_len) {
                IfCondition EqualTo(found, -1) ThenBlock: {
                    match = 1
                    mi = 0
                    WhileLoop LessThan(mi, search_len) {
                        IfCondition NotEqual(JSRT_StrUnit(str_ptr, Add(si, mi)), JSRT_StrUnit(search_ptr, mi)) ThenBlock: {
                            match = 0
                            mi = search_len
                        }
                        mi = Add(mi, 1)
                    }
                    IfCondition EqualTo(match, 1) ThenBlock: { found = si }
                }
                si = Add(si, 1)
            }
            IfCondition EqualTo(found, -1) ThenBlock: {
                ReturnValue(save_recv)
            }
            new_len = Add(Subtract(str_len, search_len), repl_len)
            rbuf = JSRTState.str_work_buf
            out_p = 0
            IfCondition GreaterThan(found, 0) ThenBlock: {
                out_p = JSRT_StrEmit(rbuf, out_p, str_ptr, 0, found)
            }
            IfCondition GreaterThan(repl_len, 0) ThenBlock: {
                out_p = JSRT_StrEmit(rbuf, out_p, repl_ptr, 0, repl_len)
            }
            suffix_start = Add(found, search_len)
            suffix_len = Subtract(str_len, suffix_start)
            IfCondition GreaterThan(suffix_len, 0) ThenBlock: {
                out_p = JSRT_StrEmit(rbuf, out_p, str_ptr, suffix_start, suffix_len)
            }
            SetByte(rbuf, out_p, 0)
            ReturnValue(JSRT_CreateString(rbuf))
        }

        // ─── split (68) — ToString(sep), optional limit ───
        IfCondition EqualTo(save_id, 68) ThenBlock: {
            result_arr = JSRT_CreateArray()
            // limit: undefined → unlimited; 0 → empty array
            lim = 4294967295
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                lim_v = Dereference(Add(save_args, 8))
                IfCondition NotEqual(JSRT_GetType(lim_v), JSType.UNDEFINED) ThenBlock: {
                    lim = Float_ToInt(JSRT_ToNumber(lim_v))
                    IfCondition LessThan(lim, 0) ThenBlock: { lim = 0 }
                }
            }
            IfCondition EqualTo(lim, 0) ThenBlock: {
                ReturnValue(result_arr)
            }
            // separator undefined → [ToString(this)]
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                JSRT_ArrPush(result_arr, save_recv)
                ReturnValue(result_arr)
            }
            a0 = Dereference(save_args)
            IfCondition EqualTo(JSRT_GetType(a0), JSType.UNDEFINED) ThenBlock: {
                JSRT_ArrPush(result_arr, save_recv)
                ReturnValue(result_arr)
            }
            // M30c: RegExp separator
            IfCondition EqualTo(JSRT_GetType(a0), JSType.OBJECT) ThenBlock: {
                rh = JSRT_ObjGet(a0, "__regex_handle__")
                IfCondition EqualTo(JSRT_GetType(rh), JSType.NUMBER) ThenBlock: {
                    rx_h = JSRT_GetPayload(rh)
                    pos = 0
                    parts = 0
                    WhileLoop And(LessEqual(pos, str_len), LessThan(parts, lim)) {
                        found_re = JSRegex_SearchPosLenFrom(rx_h, str_ptr, str_len, pos)
                        IfCondition EqualTo(found_re, 0) ThenBlock: {
                            part_len = Subtract(str_len, pos)
                            part_val = JSRT_CreateStringSlice(str_ptr, pos, part_len)
                            JSRT_ArrPush(result_arr, part_val)
                            pos = Add(str_len, 1)
                        } ElseBlock: {
                            mpos = JSRxResult.pos
                            mlen = JSRxResult.len
                            part_len = Subtract(mpos, pos)
                            part_val = JSRT_CreateStringSlice(str_ptr, pos, part_len)
                            JSRT_ArrPush(result_arr, part_val)
                            parts = Add(parts, 1)
                            IfCondition EqualTo(mlen, 0) ThenBlock: {
                                pos = Add(mpos, 1)
                            } ElseBlock: {
                                pos = Add(mpos, mlen)
                            }
                            IfCondition GreaterEqual(JSRT_ArrLen(result_arr), lim) ThenBlock: {
                                pos = Add(str_len, 1)
                            }
                        }
                    }
                    ReturnValue(result_arr)
                }
            }
            sep_str = JSRT_ToString(a0)
            sep_ptr = JSRT_GetPayload(sep_str)
            IfCondition EqualTo(sep_ptr, 0) ThenBlock: {
                sep_ptr = ""
            }
            sep_len = JSRT_StrLen(sep_ptr)
            IfCondition EqualTo(sep_len, 0) ThenBlock: {
                // Split into chars (respect limit)
                ci = 0
                WhileLoop And(LessThan(ci, str_len), LessThan(JSRT_ArrLen(result_arr), lim)) {
                    ch_val = JSRT_CreateStringSlice(str_ptr, ci, 1)
                    JSRT_ArrPush(result_arr, ch_val)
                    ci = Add(ci, 1)
                }
                ReturnValue(result_arr)
            }
            // Split by separator
            pos = 0
            WhileLoop And(LessEqual(pos, str_len), LessThan(JSRT_ArrLen(result_arr), lim)) {
                found_at = -1
                si = pos
                WhileLoop LessEqual(Add(si, sep_len), str_len) {
                    IfCondition EqualTo(found_at, -1) ThenBlock: {
                        match = 1
                        mi = 0
                        WhileLoop LessThan(mi, sep_len) {
                            IfCondition NotEqual(JSRT_StrUnit(str_ptr, Add(si, mi)), JSRT_StrUnit(sep_ptr, mi)) ThenBlock: {
                                match = 0
                                mi = sep_len
                            }
                            mi = Add(mi, 1)
                        }
                        IfCondition EqualTo(match, 1) ThenBlock: { found_at = si }
                    }
                    si = Add(si, 1)
                }
                IfCondition EqualTo(found_at, -1) ThenBlock: {
                    part_len = Subtract(str_len, pos)
                    part_val = JSRT_CreateStringSlice(str_ptr, pos, part_len)
                    JSRT_ArrPush(result_arr, part_val)
                    pos = Add(str_len, 1)
                } ElseBlock: {
                    // If at limit-1 slots filled and more seps remain, still push part
                    part_len = Subtract(found_at, pos)
                    part_val = JSRT_CreateStringSlice(str_ptr, pos, part_len)
                    JSRT_ArrPush(result_arr, part_val)
                    pos = Add(found_at, sep_len)
                    // If next push would exceed lim, stop (don't add trailing empty if at lim)
                    IfCondition GreaterEqual(JSRT_ArrLen(result_arr), lim) ThenBlock: {
                        pos = Add(str_len, 1)
                    }
                }
            }
            ReturnValue(result_arr)
        }

        // ─── trim (69) — WhiteSpace + LineTerminator (byte subset) ───
        IfCondition EqualTo(save_id, 69) ThenBlock: {
            ls = 0
            trim_go = 1
            WhileLoop EqualTo(trim_go, 1) {
                IfCondition GreaterEqual(ls, str_len) ThenBlock: {
                    trim_go = 0
                } ElseBlock: {
                    ch = JSRT_StrUnit(str_ptr, ls)
                    is_ws = JSVM__IsTrimWS(ch)
                    IfCondition EqualTo(is_ws, 1) ThenBlock: {
                        ls = Add(ls, 1)
                    } ElseBlock: {
                        trim_go = 0
                    }
                }
            }
            re = str_len
            trim_go = 1
            WhileLoop EqualTo(trim_go, 1) {
                IfCondition LessEqual(re, ls) ThenBlock: {
                    trim_go = 0
                } ElseBlock: {
                    ch = JSRT_StrUnit(str_ptr, Subtract(re, 1))
                    is_ws = JSVM__IsTrimWS(ch)
                    IfCondition EqualTo(is_ws, 1) ThenBlock: {
                        re = Subtract(re, 1)
                    } ElseBlock: {
                        trim_go = 0
                    }
                }
            }
            sub_len = Subtract(re, ls)
            ReturnValue(JSRT_CreateStringSlice(str_ptr, ls, sub_len))
        }

        // ─── toLowerCase (70) ───
        IfCondition EqualTo(save_id, 70) ThenBlock: {
            lbuf = JSRTState.str_work_buf
            li = 0
            WhileLoop LessThan(li, str_len) {
                ch = JSRT_StrUnit(str_ptr, li)
                SetByte(lbuf, li, ch)
                IfCondition GreaterEqual(ch, 65) ThenBlock: {
                    IfCondition LessEqual(ch, 90) ThenBlock: {
                        SetByte(lbuf, li, Add(ch, 32))
                    }
                }
                li = Add(li, 1)
            }
            SetByte(lbuf, str_len, 0)
            ReturnValue(JSRT_CreateString(lbuf))
        }

        // ─── toUpperCase (71) ───
        IfCondition EqualTo(save_id, 71) ThenBlock: {
            ubuf = JSRTState.str_work_buf
            ui = 0
            WhileLoop LessThan(ui, str_len) {
                ch = JSRT_StrUnit(str_ptr, ui)
                SetByte(ubuf, ui, ch)
                IfCondition GreaterEqual(ch, 97) ThenBlock: {
                    IfCondition LessEqual(ch, 122) ThenBlock: {
                        SetByte(ubuf, ui, Subtract(ch, 32))
                    }
                }
                ui = Add(ui, 1)
            }
            SetByte(ubuf, str_len, 0)
            ReturnValue(JSRT_CreateString(ubuf))
        }

        // ─── String.fromCharCode (72) — static; ToUint16 per arg → code units ───
        IfCondition EqualTo(save_id, 72) ThenBlock: {
            n_units = save_argc
            IfCondition LessThan(n_units, 0) ThenBlock: { n_units = 0 }
            buf = JSRT_StrAlloc(n_units)
            IfCondition EqualTo(buf, 0) ThenBlock: {
                ReturnValue(JSRT_CreateString(""))
            }
            fi = 0
            WhileLoop LessThan(fi, n_units) {
                a_val = Dereference(Add(save_args, Multiply(fi, 8)))
                code = Float_ToInt(JSRT_ToNumber(a_val))
                // ToUint16
                IfCondition LessThan(code, 0) ThenBlock: {
                    code = BitwiseAnd(code, 65535)
                }
                IfCondition GreaterThan(code, 65535) ThenBlock: {
                    code = BitwiseAnd(code, 65535)
                }
                JSRT_StrSetUnit(buf, fi, code)
                fi = Add(fi, 1)
            }
            val = JSRT__AllocValue()
            IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(JSRT_CreateString("")) }
            StoreValue(val, JSType.STRING)
            StoreValue(Add(val, 8), buf)
            ReturnValue(val)
        }

        // ─── String.fromCodePoint (229) — static; UTF-16 code units (surrogate pairs) ───
        IfCondition EqualTo(save_id, 229) ThenBlock: {
            // count units
            n_units = 0
            fi = 0
            WhileLoop LessThan(fi, save_argc) {
                a_val = Dereference(Add(save_args, Multiply(fi, 8)))
                code = Float_ToInt(JSRT_ToNumber(a_val))
                IfCondition Or(LessThan(code, 0), GreaterThan(code, 1114111)) ThenBlock: {
                    terr = JSVM_CreateTypedError("RangeError", "Invalid code point")
                    JSVMCall.exc_prop = 1
                    JSVM_ThrowValue(terr)
                    ReturnValue(JSRT_Undefined())
                }
                IfCondition LessThan(code, 65536) ThenBlock: {
                    n_units = Add(n_units, 1)
                } ElseBlock: {
                    n_units = Add(n_units, 2)
                }
                fi = Add(fi, 1)
            }
            buf = JSRT_StrAlloc(n_units)
            IfCondition EqualTo(buf, 0) ThenBlock: {
                ReturnValue(JSRT_CreateString(""))
            }
            oi = 0
            fi = 0
            WhileLoop LessThan(fi, save_argc) {
                a_val = Dereference(Add(save_args, Multiply(fi, 8)))
                code = Float_ToInt(JSRT_ToNumber(a_val))
                IfCondition LessThan(code, 65536) ThenBlock: {
                    JSRT_StrSetUnit(buf, oi, code)
                    oi = Add(oi, 1)
                } ElseBlock: {
                    // surrogate pair
                    adj = Subtract(code, 65536)
                    hi = Add(55296, Divide(adj, 1024))
                    lo = Add(56320, BitwiseAnd(adj, 1023))
                    JSRT_StrSetUnit(buf, oi, hi)
                    JSRT_StrSetUnit(buf, Add(oi, 1), lo)
                    oi = Add(oi, 2)
                }
                fi = Add(fi, 1)
            }
            val = JSRT__AllocValue()
            IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(JSRT_CreateString("")) }
            StoreValue(val, JSType.STRING)
            StoreValue(Add(val, 8), buf)
            ReturnValue(val)
        }

        // ─── substr (73) — substr(start, length) ───
        IfCondition EqualTo(save_id, 73) ThenBlock: {
            start = 0
            sub_count = str_len
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                start = Float_ToInt(JSRT_ToNumber(a0))
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                a1 = Dereference(Add(save_args, 8))
                sub_count = Float_ToInt(JSRT_ToNumber(a1))
            }
            // Negative start
            IfCondition LessThan(start, 0) ThenBlock: {
                start = Add(str_len, start)
                IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
            }
            IfCondition GreaterThan(start, str_len) ThenBlock: { start = str_len }
            // Clamp length
            IfCondition LessThan(sub_count, 0) ThenBlock: { sub_count = 0 }
            IfCondition GreaterThan(Add(start, sub_count), str_len) ThenBlock: {
                sub_count = Subtract(str_len, start)
            }
            ReturnValue(JSRT_CreateStringSlice(str_ptr, start, sub_count))
        }

        // ─── lastIndexOf (74) — ToString(search), optional fromIndex ───
        IfCondition EqualTo(save_id, 74) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                search_str = JSRT_ToString(JSRT_Undefined())
            } ElseBlock: {
                search_str = JSRT_ToString(Dereference(save_args))
            }
            search_ptr = JSRT_GetPayload(search_str)
            IfCondition EqualTo(search_ptr, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(-1))
            }
            search_len = JSRT_StrLen(search_ptr)
            max_start = Subtract(str_len, search_len)
            IfCondition LessThan(max_start, 0) ThenBlock: { max_start = 0 }
            start_si = max_start
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                start_si = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
                IfCondition GreaterThan(start_si, max_start) ThenBlock: { start_si = max_start }
                IfCondition LessThan(start_si, 0) ThenBlock: { start_si = 0 }
            }
            IfCondition EqualTo(search_len, 0) ThenBlock: {
                empty_pos = start_si
                IfCondition GreaterThan(empty_pos, str_len) ThenBlock: { empty_pos = str_len }
                ReturnValue(JSRT_CreateNumber(empty_pos))
            }
            found = -1
            si = start_si
            WhileLoop GreaterEqual(si, 0) {
                match = 1
                mi = 0
                WhileLoop LessThan(mi, search_len) {
                    IfCondition NotEqual(JSRT_StrUnit(str_ptr, Add(si, mi)), JSRT_StrUnit(search_ptr, mi)) ThenBlock: {
                        match = 0
                        mi = search_len
                    }
                    mi = Add(mi, 1)
                }
                IfCondition EqualTo(match, 1) ThenBlock: {
                    found = si
                    si = -1
                } ElseBlock: {
                    si = Subtract(si, 1)
                }
            }
            ReturnValue(JSRT_CreateNumber(found))
        }

        // ─── concat (75) — ToString each arg ───
        IfCondition EqualTo(save_id, 75) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(save_recv)
            }
            cbuf = JSRTState.str_work_buf
            str_ptr = JSRT_GetPayload(save_recv)
            str_len = 0
            IfCondition NotEqual(str_ptr, 0) ThenBlock: { str_len = JSRT_StrLen(str_ptr) }
            cpos = 0
            IfCondition GreaterThan(str_len, 0) ThenBlock: {
                cpos = JSRT_StrEmit(cbuf, cpos, str_ptr, 0, str_len)
            }
            ci = 0
            WhileLoop LessThan(ci, save_argc) {
                a_val = Dereference(Add(save_args, Multiply(ci, 8)))
                JSBridge__Push(save_recv)
                a_str = JSRT_ToString(a_val)
                a_ptr = JSRT_GetPayload(a_str)
                save_recv = JSBridge__Pop()
                IfCondition NotEqual(a_ptr, 0) ThenBlock: {
                    a_len = JSRT_StrLen(a_ptr)
                    IfCondition GreaterThan(a_len, 0) ThenBlock: {
                        cpos = JSRT_StrEmit(cbuf, cpos, a_ptr, 0, a_len)
                    }
                }
                ci = Add(ci, 1)
            }
            SetByte(cbuf, cpos, 0)
            ReturnValue(JSRT_CreateString(cbuf))
        }

        // ─── Array constructor (76) — new Array(n) or Array(a,b,c) ───
        // M26j: under SuperCall/construct, stamp [[Prototype]] from new.target.prototype
        IfCondition EqualTo(save_id, 76) ThenBlock: {
            IfCondition EqualTo(save_argc, 1) ThenBlock: {
                a0 = Dereference(save_args)
                a0_type = JSRT_GetType(a0)
                IfCondition EqualTo(a0_type, JSType.NUMBER) ThenBlock: {
                    // M42: new Array(n) — n holes (raw 0), NOT n×undefined
                    // (undefined is a defined value; ArrHas must be false for holes)
                    n = Float_ToInt(JSRT_ToNumber(a0))
                    IfCondition LessThan(n, 0) ThenBlock: { n = 0 }
                    // ArrayCreate length > 2^32-1 → RangeError
                    IfCondition GreaterThan(n, 4294967295) ThenBlock: {
                        terr = JSVM_CreateTypedError("RangeError", "Invalid array length")
                        JSVM__SetGlobal("__pend_exc__", terr)
                        JSVMCall.exc_prop = 1
                        JSVMCall.thrown_val = terr
                        JSVM_ThrowValue(terr)
                        ReturnValue(JSRT_Undefined())
                    }
                    arr = JSRT_CreateArray()
                    JSRT_ArrSetLen(arr, n)
                    // subclass proto stamp
                    nt_a = JSVM__GetGlobal("__new_target__")
                    IfCondition EqualTo(JSRT_GetType(nt_a), JSType.FUNCTION) ThenBlock: {
                        ntp = JSRT_ObjGet(nt_a, "prototype")
                        IfCondition EqualTo(JSRT_GetType(ntp), JSType.OBJECT) ThenBlock: {
                            JSRT_ObjSet(arr, "__proto__", ntp)
                        }
                    }
                    ReturnValue(arr)
                }
            }
            // Array(a, b, c) — create array with elements
            arr = JSRT_CreateArray()
            ai = 0
            WhileLoop LessThan(ai, save_argc) {
                a_val = Dereference(Add(save_args, Multiply(ai, 8)))
                JSRT_ArrPush(arr, a_val)
                ai = Add(ai, 1)
            }
            nt_a = JSVM__GetGlobal("__new_target__")
            IfCondition EqualTo(JSRT_GetType(nt_a), JSType.FUNCTION) ThenBlock: {
                ntp = JSRT_ObjGet(nt_a, "prototype")
                IfCondition EqualTo(JSRT_GetType(ntp), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(arr, "__proto__", ntp)
                }
            }
            ReturnValue(arr)
        }

        // ─── arr.push (98) / pop (99) — M45 array-like generic ───
        IfCondition EqualTo(save_id, 98) ThenBlock: {
            ReturnValue(JSVM__ArrPush(save_recv, save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 99) ThenBlock: {
            ReturnValue(JSVM__ArrPop(save_recv, save_args, save_argc))
        }

        // ─── repeat (97) — "abc".repeat(3) → "abcabcabc" ───
        IfCondition EqualTo(save_id, 97) ThenBlock: {
            rep_count = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                rep_count = Float_ToInt(JSRT_ToNumber(a0))
            }
            IfCondition LessEqual(rep_count, 0) ThenBlock: {
                ReturnValue(JSRT_CreateString(""))
            }
            IfCondition EqualTo(rep_count, 1) ThenBlock: {
                ReturnValue(save_recv)
            }
            // Use native StringRepeat intrinsic (SSE2-backed)
            rep_result = StringRepeat(str_ptr, rep_count)
            ReturnValue(JSRT_CreateString(rep_result))
        }

        // ─── Array methods (150-174) — dispatch to dedicated functions ───
        IfCondition EqualTo(save_id, 150) ThenBlock: { ReturnValue(JSVM__ArrForEach(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 151) ThenBlock: { ReturnValue(JSVM__ArrMap(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 152) ThenBlock: { ReturnValue(JSVM__ArrFilter(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 153) ThenBlock: { ReturnValue(JSVM__ArrReduce(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 154) ThenBlock: { ReturnValue(JSVM__ArrFind(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 155) ThenBlock: { ReturnValue(JSVM__ArrFindIndex(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 156) ThenBlock: { ReturnValue(JSVM__ArrSome(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 157) ThenBlock: { ReturnValue(JSVM__ArrEvery(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 158) ThenBlock: { ReturnValue(JSVM__ArrIndexOf(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 159) ThenBlock: { ReturnValue(JSVM__ArrLastIndexOf(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 160) ThenBlock: { ReturnValue(JSVM__ArrIncludes(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 233) ThenBlock: { ReturnValue(JSVM__ArrAt(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 161) ThenBlock: { ReturnValue(JSVM__ArrJoin(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 162) ThenBlock: { ReturnValue(JSVM__ArrReverse(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 163) ThenBlock: { ReturnValue(JSVM__ArrSlice(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 164) ThenBlock: { ReturnValue(JSVM__ArrConcat(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 165) ThenBlock: { ReturnValue(JSVM__ArrShift(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 166) ThenBlock: { ReturnValue(JSVM__ArrUnshift(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 167) ThenBlock: { ReturnValue(JSVM__ArrSplice(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 168) ThenBlock: { ReturnValue(JSVM__ArrFill(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 169) ThenBlock: { ReturnValue(JSVM__ArrSort(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 170) ThenBlock: { ReturnValue(JSVM__ArrFlat(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 171) ThenBlock: { ReturnValue(JSVM__ArrFlatMap(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 174) ThenBlock: { ReturnValue(JSVM__ArrReduceRight(save_recv, save_args, save_argc)) }
        // M29h: copyWithin / findLast / findLastIndex
        IfCondition EqualTo(save_id, 208) ThenBlock: { ReturnValue(JSVM__ArrCopyWithin(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 209) ThenBlock: { ReturnValue(JSVM__ArrFindLast(save_recv, save_args, save_argc)) }
        IfCondition EqualTo(save_id, 210) ThenBlock: { ReturnValue(JSVM__ArrFindLastIndex(save_recv, save_args, save_argc)) }

        // ─── includes (180) — str.includes(search, pos?) → boolean ───
        // M34: UTF-16 unit search (C StringContains wrong for JS strings)
        IfCondition EqualTo(save_id, 180) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                search_str = JSRT_ToString(JSRT_Undefined())
            } ElseBlock: {
                search_str = JSRT_ToString(Dereference(save_args))
            }
            search_ptr = JSRT_GetPayload(search_str)
            search_len = 0
            IfCondition NotEqual(search_ptr, 0) ThenBlock: { search_len = JSRT_StrLen(search_ptr) }
            off = 0
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                off = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
                IfCondition LessThan(off, 0) ThenBlock: { off = 0 }
                IfCondition GreaterThan(off, str_len) ThenBlock: { off = str_len }
            }
            IfCondition EqualTo(search_len, 0) ThenBlock: { ReturnValue(JSRTState.true_val) }
            found_b = 0
            si = off
            WhileLoop LessEqual(Add(si, search_len), str_len) {
                IfCondition EqualTo(found_b, 0) ThenBlock: {
                    match = 1
                    mi = 0
                    WhileLoop LessThan(mi, search_len) {
                        IfCondition NotEqual(JSRT_StrUnit(str_ptr, Add(si, mi)), JSRT_StrUnit(search_ptr, mi)) ThenBlock: {
                            match = 0
                            mi = search_len
                        }
                        mi = Add(mi, 1)
                    }
                    IfCondition EqualTo(match, 1) ThenBlock: { found_b = 1 }
                }
                si = Add(si, 1)
            }
            ReturnValue(JSRT_CreateBool(found_b))
        }

        // ─── startsWith (181) — str.startsWith(search, pos?) → boolean ───
        IfCondition EqualTo(save_id, 181) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                search_str = JSRT_ToString(JSRT_Undefined())
            } ElseBlock: {
                search_str = JSRT_ToString(Dereference(save_args))
            }
            search_ptr = JSRT_GetPayload(search_str)
            search_len = 0
            IfCondition NotEqual(search_ptr, 0) ThenBlock: { search_len = JSRT_StrLen(search_ptr) }
            off = 0
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                off = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
                IfCondition LessThan(off, 0) ThenBlock: { off = 0 }
                IfCondition GreaterThan(off, str_len) ThenBlock: { off = str_len }
            }
            IfCondition EqualTo(search_len, 0) ThenBlock: { ReturnValue(JSRTState.true_val) }
            IfCondition GreaterThan(Add(off, search_len), str_len) ThenBlock: {
                ReturnValue(JSRTState.false_val)
            }
            match = 1
            mi = 0
            WhileLoop LessThan(mi, search_len) {
                IfCondition NotEqual(JSRT_StrUnit(str_ptr, Add(off, mi)), JSRT_StrUnit(search_ptr, mi)) ThenBlock: {
                    match = 0
                    mi = search_len
                }
                mi = Add(mi, 1)
            }
            ReturnValue(JSRT_CreateBool(match))
        }

        // ─── endsWith (182) — str.endsWith(search, endPosition?) → boolean ───
        IfCondition EqualTo(save_id, 182) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                search_str = JSRT_ToString(JSRT_Undefined())
            } ElseBlock: {
                search_str = JSRT_ToString(Dereference(save_args))
            }
            search_ptr = JSRT_GetPayload(search_str)
            search_len = 0
            IfCondition NotEqual(search_ptr, 0) ThenBlock: { search_len = JSRT_StrLen(search_ptr) }
            ew_len = str_len
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                ew_len = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
                IfCondition LessThan(ew_len, 0) ThenBlock: { ew_len = 0 }
                IfCondition GreaterThan(ew_len, str_len) ThenBlock: { ew_len = str_len }
            }
            IfCondition EqualTo(search_len, 0) ThenBlock: { ReturnValue(JSRTState.true_val) }
            IfCondition GreaterThan(search_len, ew_len) ThenBlock: {
                ReturnValue(JSRTState.false_val)
            }
            start = Subtract(ew_len, search_len)
            match = 1
            mi = 0
            WhileLoop LessThan(mi, search_len) {
                IfCondition NotEqual(JSRT_StrUnit(str_ptr, Add(start, mi)), JSRT_StrUnit(search_ptr, mi)) ThenBlock: {
                    match = 0
                    mi = search_len
                }
                mi = Add(mi, 1)
            }
            ReturnValue(JSRT_CreateBool(match))
        }

        // ─── trimStart (183) ───
        IfCondition EqualTo(save_id, 183) ThenBlock: {
            si = 0
            WhileLoop LessThan(si, str_len) {
                ch = JSRT_StrUnit(str_ptr, si)
                is_ws = JSVM__IsTrimWS(ch)
                IfCondition EqualTo(is_ws, 0) ThenBlock: {
                    ReturnValue(JSRT_CreateStringSlice(str_ptr, si, Subtract(str_len, si)))
                }
                si = Add(si, 1)
            }
            ReturnValue(JSRT_CreateString(""))
        }

        // ─── trimEnd (184) ───
        // M44: CreateStringLen treats ptr as Latin-1 bytes; JS strings are UTF-16
        IfCondition EqualTo(save_id, 184) ThenBlock: {
            ei = Subtract(str_len, 1)
            WhileLoop GreaterEqual(ei, 0) {
                ch = JSRT_StrUnit(str_ptr, ei)
                is_ws = JSVM__IsTrimWS(ch)
                IfCondition EqualTo(is_ws, 0) ThenBlock: {
                    ReturnValue(JSRT_CreateStringSlice(str_ptr, 0, Add(ei, 1)))
                }
                ei = Subtract(ei, 1)
            }
            ReturnValue(JSRT_CreateString(""))
        }

        // ─── padStart (185) — str.padStart(targetLen, padStr?) → string ───
        // M43: UTF-16 units via StrAlloc (SetByte+CreateString corrupted output)
        IfCondition EqualTo(save_id, 185) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: { ReturnValue(save_recv) }
            target_len = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
            IfCondition LessThan(target_len, 0) ThenBlock: { target_len = 0 }
            IfCondition LessEqual(target_len, str_len) ThenBlock: { ReturnValue(save_recv) }
            pad_ptr = 0
            pad_len = 1
            // default pad " "
            space_u = 32
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                p_arg = Dereference(Add(save_args, 8))
                IfCondition NotEqual(JSRT_GetType(p_arg), JSType.UNDEFINED) ThenBlock: {
                    ps = JSRT_ToString(p_arg)
                    pad_ptr = JSRT_GetPayload(ps)
                    pad_len = JSRT_StrLen(pad_ptr)
                }
            }
            IfCondition EqualTo(pad_len, 0) ThenBlock: { ReturnValue(save_recv) }
            need = Subtract(target_len, str_len)
            out_len = Add(need, str_len)
            obuf = JSRT_StrAlloc(out_len)
            IfCondition EqualTo(obuf, 0) ThenBlock: { ReturnValue(save_recv) }
            oi = 0
            pi = 0
            WhileLoop LessThan(oi, need) {
                IfCondition EqualTo(pad_ptr, 0) ThenBlock: {
                    JSRT_StrSetUnit(obuf, oi, space_u)
                } ElseBlock: {
                    JSRT_StrSetUnit(obuf, oi, JSRT_StrUnit(pad_ptr, pi))
                }
                oi = Add(oi, 1)
                pi = Add(pi, 1)
                IfCondition GreaterEqual(pi, pad_len) ThenBlock: { pi = 0 }
            }
            ci = 0
            WhileLoop LessThan(ci, str_len) {
                JSRT_StrSetUnit(obuf, oi, JSRT_StrUnit(str_ptr, ci))
                oi = Add(oi, 1)
                ci = Add(ci, 1)
            }
            val = JSRT__AllocValue()
            IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(save_recv) }
            StoreValue(val, JSType.STRING)
            StoreValue(Add(val, 8), obuf)
            ReturnValue(val)
        }

        // ─── padEnd (186) — str.padEnd(targetLen, padStr?) → string ───
        IfCondition EqualTo(save_id, 186) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: { ReturnValue(save_recv) }
            target_len = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
            IfCondition LessThan(target_len, 0) ThenBlock: { target_len = 0 }
            IfCondition LessEqual(target_len, str_len) ThenBlock: { ReturnValue(save_recv) }
            pad_ptr = 0
            pad_len = 1
            space_u = 32
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                p_arg = Dereference(Add(save_args, 8))
                IfCondition NotEqual(JSRT_GetType(p_arg), JSType.UNDEFINED) ThenBlock: {
                    ps = JSRT_ToString(p_arg)
                    pad_ptr = JSRT_GetPayload(ps)
                    pad_len = JSRT_StrLen(pad_ptr)
                }
            }
            IfCondition EqualTo(pad_len, 0) ThenBlock: { ReturnValue(save_recv) }
            need = Subtract(target_len, str_len)
            out_len = Add(need, str_len)
            obuf = JSRT_StrAlloc(out_len)
            IfCondition EqualTo(obuf, 0) ThenBlock: { ReturnValue(save_recv) }
            ci = 0
            WhileLoop LessThan(ci, str_len) {
                JSRT_StrSetUnit(obuf, ci, JSRT_StrUnit(str_ptr, ci))
                ci = Add(ci, 1)
            }
            oi = str_len
            pi = 0
            WhileLoop LessThan(pi, need) {
                IfCondition EqualTo(pad_ptr, 0) ThenBlock: {
                    JSRT_StrSetUnit(obuf, oi, space_u)
                } ElseBlock: {
                    JSRT_StrSetUnit(obuf, oi, JSRT_StrUnit(pad_ptr, Modulo(pi, pad_len)))
                }
                oi = Add(oi, 1)
                pi = Add(pi, 1)
            }
            val = JSRT__AllocValue()
            IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(save_recv) }
            StoreValue(val, JSType.STRING)
            StoreValue(Add(val, 8), obuf)
            ReturnValue(val)
        }

        // Unknown method
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// STRING METHOD MATCHING — returns JSNativeID or 0
// =============================================================================
Function.JSVM__MatchStringMethod {
    Input: name: Address
    Output: Integer
    Body: {
        save_name = name
        c0 = JSRT_StrUnit(save_name, 0)
        c1 = JSRT_StrUnit(save_name, 1)

        // at (97 116 0)
        IfCondition EqualTo(c0, 97) ThenBlock: {
            IfCondition EqualTo(c1, 116) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 0) ThenBlock: {
                    ReturnValue(JSNativeID.STR_AT)
                }
            }
        }

        // charAt (99 104 97 114 65 116 0)
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(c1, 104) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 97) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 114) ThenBlock: {
                        // charA vs charC
                        c4 = JSRT_StrUnit(save_name, 4)
                        IfCondition EqualTo(c4, 65) ThenBlock: {
                            // charAt (65 116 0)
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 116) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.STR_CHAR_AT)
                                }
                            }
                        }
                        // charCodeAt (67 111 100 101 65 116 0)
                        IfCondition EqualTo(c4, 67) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 111) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 100) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 101) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 65) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 116) ThenBlock: {
                                                IfCondition EqualTo(JSRT_StrUnit(save_name, 10), 0) ThenBlock: {
                                                    ReturnValue(JSNativeID.STR_CHAR_CODE_AT)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // concat (99 111 110 99 97 116 0) / codePointAt (99 111 100 101 ...)
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 110) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 99) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 97) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 116) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.STR_CONCAT)
                                }
                            }
                        }
                    }
                }
                // codePointAt
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 100) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 101) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 80) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 111) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 105) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 110) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 116) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 65) ThenBlock: {
                                                IfCondition EqualTo(JSRT_StrUnit(save_name, 10), 116) ThenBlock: {
                                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 11), 0) ThenBlock: {
                                                        ReturnValue(JSNativeID.STR_CODE_POINT_AT)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // indexOf (105 110 100 101 120 79 102 0)
        IfCondition EqualTo(c0, 105) ThenBlock: {
            IfCondition EqualTo(c1, 110) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 100) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 101) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 120) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 79) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 102) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.STR_INDEX_OF)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // substring (115 117 98 115 116 114 105 110 103 0)
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition EqualTo(c1, 117) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 98) ThenBlock: {
                    // substr vs substring
                    c3 = JSRT_StrUnit(save_name, 3)
                    IfCondition EqualTo(c3, 115) ThenBlock: {
                        // substring (115 116 114 105 110 103 0)
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 116) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 114) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 105) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 110) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 103) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 0) ThenBlock: {
                                                ReturnValue(JSNativeID.STR_SUBSTRING)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // substr (114 0)
                    IfCondition EqualTo(c3, 116) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 114) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.STR_SUBSTR)
                            }
                        }
                    }
                }
            }
            // slice (115 108 105 99 101 0)
            IfCondition EqualTo(c1, 108) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 105) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 99) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 101) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.STR_SLICE)
                            }
                        }
                    }
                }
            }
            // search (115 101 97 114 99 104 0) — M30c
            IfCondition EqualTo(c1, 101) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 97) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 114) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 99) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 104) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.STR_SEARCH_RE)
                                }
                            }
                        }
                    }
                }
            }
            // split (115 112 108 105 116 0)
            IfCondition EqualTo(c1, 112) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 108) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 105) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 116) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.STR_SPLIT)
                            }
                        }
                    }
                }
            }
            // startsWith (115 116 97 114 116 115 87 105 116 104 0) — c1=116='t'
            IfCondition EqualTo(c1, 116) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 97) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 114) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 116) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 115) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 87) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 105) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 116) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 104) ThenBlock: {
                                                IfCondition EqualTo(JSRT_StrUnit(save_name, 10), 0) ThenBlock: {
                                                    ReturnValue(JSNativeID.STR_STARTS_WITH)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // trim / trimStart / trimEnd (116 114 105 109 ...)
        IfCondition EqualTo(c0, 116) ThenBlock: {
            IfCondition EqualTo(c1, 114) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 105) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 109) ThenBlock: {
                        c4t = JSRT_StrUnit(save_name, 4)
                        IfCondition EqualTo(c4t, 0) ThenBlock: {
                            ReturnValue(JSNativeID.STR_TRIM)
                        }
                        // trimStart (83 116 97 114 116 0)
                        IfCondition EqualTo(c4t, 83) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 116) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 97) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 114) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 116) ThenBlock: {
                                            IfCondition EqualTo(JSRT_StrUnit(save_name, 9), 0) ThenBlock: {
                                                ReturnValue(JSNativeID.STR_TRIM_START)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // trimEnd (69 110 100 0)
                        IfCondition EqualTo(c4t, 69) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 110) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 100) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.STR_TRIM_END)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // toLowerCase (116 111 76 111 ...)
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 76) ThenBlock: {
                    ReturnValue(JSNativeID.STR_TO_LOWER)
                }
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 85) ThenBlock: {
                    ReturnValue(JSNativeID.STR_TO_UPPER)
                }
            }
        }

        // replace (114 101 112 108 97 99 101 0)
        // repeat  (114 101 112 101 97 116 0)
        IfCondition EqualTo(c0, 114) ThenBlock: {
            IfCondition EqualTo(c1, 101) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 112) ThenBlock: {
                    // rep_l_ vs rep_e_ — byte 3 distinguishes
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 108) ThenBlock: {
                        // replace
                        ReturnValue(JSNativeID.STR_REPLACE)
                    }
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 101) ThenBlock: {
                        // repeat
                        ReturnValue(JSNativeID.STR_REPEAT)
                    }
                }
            }
        }

        // lastIndexOf (108 97 115 116 73 ...)
        IfCondition EqualTo(c0, 108) ThenBlock: {
            IfCondition EqualTo(c1, 97) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 115) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 116) ThenBlock: {
                        ReturnValue(JSNativeID.STR_LAST_INDEX_OF)
                    }
                }
            }
        }

        // match (109 97 116 99 104 0) / matchAll — M30c
        IfCondition EqualTo(c0, 109) ThenBlock: {
            IfCondition EqualTo(c1, 97) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 116) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 99) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 104) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.STR_MATCH_RE)
                            }
                        }
                    }
                }
            }
        }

        // search (115 101 97 114 99 104 0) — under c0=115 may collide with slice/split
        // handled in c0=115 branch: byte2='a' for search vs 'u'/'l'/'p'

        // includes (105 110 99 108 117 100 101 115 0) — c0=105='i', c1=110='n'
        IfCondition EqualTo(c0, 105) ThenBlock: {
            IfCondition EqualTo(c1, 110) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 99) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 108) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 117) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 100) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 101) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 115) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 0) ThenBlock: {
                                            ReturnValue(JSNativeID.STR_INCLUDES)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // startsWith (115 116 97 114 116 115 87 105 116 104 0) — c0=115='s', c1=116='t'
        // Note: c0='s' branch already exists above for substring/substr/slice/split
        // startsWith starts with 'st' like substr/substring, but byte 2 = 'a'(97) not 'b'(98)
        // Need to add under existing c0=115 branch
        // endsWith (101 110 100 115 87 105 116 104 0) — c0=101='e'
        IfCondition EqualTo(c0, 101) ThenBlock: {
            IfCondition EqualTo(c1, 110) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 100) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 115) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 87) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 105) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 116) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 104) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 0) ThenBlock: {
                                            ReturnValue(JSNativeID.STR_ENDS_WITH)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // padStart (112 97 100 83 116 97 114 116 0) / padEnd (112 97 100 69 110 100 0)
        // c0=112='p', c1=97='a'
        IfCondition EqualTo(c0, 112) ThenBlock: {
            IfCondition EqualTo(c1, 97) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 100) ThenBlock: {
                    // pad'S' vs pad'E'
                    c3p = JSRT_StrUnit(save_name, 3)
                    IfCondition EqualTo(c3p, 83) ThenBlock: {
                        // padStart
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 116) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 97) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 114) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 116) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 0) ThenBlock: {
                                            ReturnValue(JSNativeID.STR_PAD_START)
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(c3p, 69) ThenBlock: {
                        // padEnd
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 110) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 100) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.STR_PAD_END)
                                }
                            }
                        }
                    }
                }
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// M30h: replace-time context (avoids multi-arg call issues for rx handle)
FixedPool.JSVMReplCtx {
    "rx_h": Initialize=0
    "text_ptr": Initialize=0
    "text_len": Initialize=0
}

// M30h: GetSubstitution — expand $$, $&, $`, $', $n, $nn, $<name>
// Match pos/len/captures from JSRxResult; rx/text from JSVMReplCtx.
Function.JSVM__GetSubstitution {
    Input: out_buf: Address
    Input: out_pos: Integer
    Input: repl_ptr: Address
    Input: repl_len: Integer
    Output: Integer
    Body: {
        mpos = JSRxResult.pos
        mlen = JSRxResult.len
        text_ptr = JSVMReplCtx.text_ptr
        text_len = JSVMReplCtx.text_len
        rx_h = JSVMReplCtx.rx_h
        IfCondition LessThan(mpos, 0) ThenBlock: { mpos = 0 }
        IfCondition LessThan(mlen, 0) ThenBlock: { mlen = 0 }
        ri = 0
        WhileLoop LessThan(ri, repl_len) {
            ch = JSRT_StrUnit(repl_ptr, ri)
            IfCondition NotEqual(ch, 36) ThenBlock: {
                SetByte(out_buf, out_pos, ch)
                out_pos = Add(out_pos, 1)
                ri = Add(ri, 1)
            } ElseBlock: {
                IfCondition GreaterEqual(Add(ri, 1), repl_len) ThenBlock: {
                    SetByte(out_buf, out_pos, 36)
                    out_pos = Add(out_pos, 1)
                    ri = Add(ri, 1)
                } ElseBlock: {
                    nch = JSRT_StrUnit(repl_ptr, Add(ri, 1))
                    handled = 0
                    // $$
                    IfCondition EqualTo(nch, 36) ThenBlock: {
                        SetByte(out_buf, out_pos, 36)
                        out_pos = Add(out_pos, 1)
                        ri = Add(ri, 2)
                        handled = 1
                    }
                    // $& matched
                    IfCondition And(EqualTo(handled, 0), EqualTo(nch, 38)) ThenBlock: {
                        IfCondition And(GreaterThan(mlen, 0), NotEqual(text_ptr, 0)) ThenBlock: {
                            out_pos = JSRT_StrEmit(out_buf, out_pos, text_ptr, mpos, mlen)
                        }
                        ri = Add(ri, 2)
                        handled = 1
                    }
                    // $` before
                    IfCondition And(EqualTo(handled, 0), EqualTo(nch, 96)) ThenBlock: {
                        IfCondition GreaterThan(mpos, 0) ThenBlock: {
                            out_pos = JSRT_StrEmit(out_buf, out_pos, text_ptr, 0, mpos)
                        }
                        ri = Add(ri, 2)
                        handled = 1
                    }
                    // $' after
                    IfCondition And(EqualTo(handled, 0), EqualTo(nch, 39)) ThenBlock: {
                        after = Add(mpos, mlen)
                        alen = Subtract(text_len, after)
                        IfCondition GreaterThan(alen, 0) ThenBlock: {
                            out_pos = JSRT_StrEmit(out_buf, out_pos, text_ptr, after, alen)
                        }
                        ri = Add(ri, 2)
                        handled = 1
                    }
                    // $<name>
                    IfCondition And(EqualTo(handled, 0), EqualTo(nch, 60)) ThenBlock: {
                        nc_chk = 0
                        IfCondition NotEqual(rx_h, 0) ThenBlock: {
                            nc_chk = JSRegex_NameCount(rx_h)
                            IfCondition Or(LessThan(nc_chk, 0), GreaterThan(nc_chk, 32)) ThenBlock: {
                                nc_chk = 0
                            }
                        }
                        IfCondition EqualTo(nc_chk, 0) ThenBlock: {
                            SetByte(out_buf, out_pos, 36)
                            out_pos = Add(out_pos, 1)
                            ri = Add(ri, 1)
                        } ElseBlock: {
                            ns = Add(ri, 2)
                            ne = ns
                            WhileLoop And(LessThan(ne, repl_len), NotEqual(JSRT_StrUnit(repl_ptr, ne), 62)) {
                                ne = Add(ne, 1)
                            }
                            IfCondition GreaterEqual(ne, repl_len) ThenBlock: {
                                SetByte(out_buf, out_pos, 36)
                                out_pos = Add(out_pos, 1)
                                ri = Add(ri, 1)
                            } ElseBlock: {
                                nlen = Subtract(ne, ns)
                                found_g = 0
                                gnum = 0
                                ni = 0
                                WhileLoop LessThan(ni, nc_chk) {
                                    np = JSRegex_NameAt(rx_h, ni)
                                    gn = JSRegex_NameGnum(rx_h, ni)
                                    IfCondition And(NotEqual(np, 0), GreaterThan(nlen, 0)) ThenBlock: {
                                        same = 1
                                        ci = 0
                                        WhileLoop LessThan(ci, nlen) {
                                            IfCondition Or(EqualTo(GetByte(np, ci), 0), NotEqual(JSRT_StrUnit(repl_ptr, Add(ns, ci)), GetByte(np, ci))) ThenBlock: {
                                                same = 0
                                                ci = nlen
                                            }
                                            ci = Add(ci, 1)
                                        }
                                        IfCondition And(EqualTo(same, 1), NotEqual(GetByte(np, nlen), 0)) ThenBlock: {
                                            same = 0
                                        }
                                        IfCondition EqualTo(same, 1) ThenBlock: {
                                            gnum = gn
                                            found_g = 1
                                            ni = nc_chk
                                        }
                                    }
                                    ni = Add(ni, 1)
                                }
                                IfCondition EqualTo(found_g, 1) ThenBlock: {
                                    cbuf = JSRxResult.cap_buf
                                    IfCondition And(NotEqual(cbuf, 0), GreaterThan(gnum, 0)) ThenBlock: {
                                        gi = Subtract(gnum, 1)
                                        IfCondition LessThan(gi, 32) ThenBlock: {
                                            cs = Dereference(Add(cbuf, Multiply(Multiply(gi, 2), 8)))
                                            ce = Dereference(Add(cbuf, Multiply(Add(Multiply(gi, 2), 1), 8)))
                                            IfCondition And(GreaterEqual(cs, 0), GreaterEqual(ce, cs)) ThenBlock: {
                                                clen = Subtract(ce, cs)
                                                IfCondition And(GreaterThan(clen, 0), NotEqual(text_ptr, 0)) ThenBlock: {
                                                    out_pos = JSRT_StrEmit(out_buf, out_pos, text_ptr, cs, clen)
                                                }
                                            }
                                        }
                                    }
                                }
                                ri = Add(ne, 1)
                            }
                        }
                        handled = 1
                    }
                    // $n / $nn
                    IfCondition And(EqualTo(handled, 0), And(GreaterEqual(nch, 49), LessEqual(nch, 57))) ThenBlock: {
                        gnum = Subtract(nch, 48)
                        used = 1
                        IfCondition LessThan(Add(ri, 2), repl_len) ThenBlock: {
                            d2 = JSRT_StrUnit(repl_ptr, Add(ri, 2))
                            IfCondition And(GreaterEqual(d2, 48), LessEqual(d2, 57)) ThenBlock: {
                                cand = Add(Multiply(gnum, 10), Subtract(d2, 48))
                                ng = JSRxResult.ngroups
                                IfCondition And(GreaterThan(cand, 0), LessEqual(cand, ng)) ThenBlock: {
                                    gnum = cand
                                    used = 2
                                }
                            }
                        }
                        cbuf = JSRxResult.cap_buf
                        ng = JSRxResult.ngroups
                        IfCondition And(And(NotEqual(cbuf, 0), GreaterThan(gnum, 0)), LessEqual(gnum, ng)) ThenBlock: {
                            gi = Subtract(gnum, 1)
                            cs = Dereference(Add(cbuf, Multiply(Multiply(gi, 2), 8)))
                            ce = Dereference(Add(cbuf, Multiply(Add(Multiply(gi, 2), 1), 8)))
                            IfCondition And(GreaterEqual(cs, 0), GreaterEqual(ce, cs)) ThenBlock: {
                                clen = Subtract(ce, cs)
                                IfCondition GreaterThan(clen, 0) ThenBlock: {
                                    out_pos = JSRT_StrEmit(out_buf, out_pos, text_ptr, cs, clen)
                                }
                            }
                        }
                        ri = Add(ri, Add(1, used))
                        handled = 1
                    }
                    // unknown $X → literal $
                    IfCondition EqualTo(handled, 0) ThenBlock: {
                        SetByte(out_buf, out_pos, 36)
                        out_pos = Add(out_pos, 1)
                        ri = Add(ri, 1)
                    }
                }
            }
        }
        ReturnValue(out_pos)
    }
}

// M30h: attach match.groups from named captures (or undefined if none)
// res_arr = match array, rx_h = compiled regex handle, text_ptr = subject string
Function.JSVM__AttachRegExpGroups {
    Input: res_arr: Address
    Input: rx_h: Address
    Input: text_ptr: Address
    Output: Address
    Body: {
        IfCondition EqualTo(res_arr, 0) ThenBlock: {
            ReturnValue(res_arr)
        }
        nc = 0
        IfCondition NotEqual(rx_h, 0) ThenBlock: {
            nc = JSRegex_NameCount(rx_h)
        }
        IfCondition EqualTo(nc, 0) ThenBlock: {
            // Always own-property groups (undefined when no GroupName)
            JSRT_ObjSet(res_arr, "groups", JSRT_Undefined())
            ReturnValue(res_arr)
        }
        // ObjectCreate(null) — JSRT_CreateObject has no default proto
        go = JSRT_CreateObject()
        cbuf = JSRxResult.cap_buf
        ni = 0
        WhileLoop LessThan(ni, nc) {
            gnum = JSRegex_NameGnum(rx_h, ni)
            nptr = JSRegex_NameAt(rx_h, ni)
            JSBridge__Push(res_arr)
            JSBridge__Push(go)
            JSBridge__Push(text_ptr)
            cap_val = JSRT_Undefined()
            IfCondition And(And(NotEqual(cbuf, 0), NotEqual(nptr, 0)), GreaterThan(gnum, 0)) ThenBlock: {
                gi = Subtract(gnum, 1)
                cs = Dereference(Add(cbuf, Multiply(Multiply(gi, 2), 8)))
                ce = Dereference(Add(cbuf, Multiply(Add(Multiply(gi, 2), 1), 8)))
                IfCondition And(GreaterEqual(cs, 0), GreaterEqual(ce, cs)) ThenBlock: {
                    IfCondition NotEqual(text_ptr, 0) ThenBlock: {
                        cap_val = JSRT_CreateStringLen(Add(text_ptr, cs), Subtract(ce, cs))
                    }
                }
            }
            text_ptr = JSBridge__Pop()
            go = JSBridge__Pop()
            res_arr = JSBridge__Pop()
            IfCondition NotEqual(nptr, 0) ThenBlock: {
                // M30i: duplicate names — prefer defined captures; don't clobber
                // a matched value with later undefined (ES duplicate named groups).
                IfCondition NotEqual(JSRT_GetType(cap_val), JSType.UNDEFINED) ThenBlock: {
                    JSRT_ObjSet(go, nptr, cap_val)
                } ElseBlock: {
                    // only set undefined if name not already present
                    existing = JSRT_ObjGet(go, nptr)
                    IfCondition EqualTo(JSRT_GetType(existing), JSType.UNDEFINED) ThenBlock: {
                        // ObjGet may return inherited undefined — check if we already set
                        // Always define first occurrence as undefined
                        JSRT_ObjSet(go, nptr, cap_val)
                    }
                }
            }
            ni = Add(ni, 1)
        }
        JSRT_ObjSet(res_arr, "groups", go)
        ReturnValue(res_arr)
    }
}

// REGEXP METHOD MATCHER — match property name to regexp native handler ID
// Returns handler ID (83-85) or 0 if not a regexp method.
// Pattern: same byte-matching approach as JSVM__MatchStringMethod.
// =============================================================================
Function.JSVM__MatchRegExpMethod {
    Input: name: Address
    Output: Integer
    Body: {
        save_name = name
        c0 = JSRT_StrUnit(save_name, 0)

        // test (116 101 115 116 0)
        IfCondition EqualTo(c0, 116) ThenBlock: {
            c1 = JSRT_StrUnit(save_name, 1)
            // test vs toString
            IfCondition EqualTo(c1, 101) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 115) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 116) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.REGEXP_TEST)
                        }
                    }
                }
            }
            // toString (116 111 83 116 114 105 110 103 0)
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 83) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 116) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 114) ThenBlock: {
                            IfCondition EqualTo(JSRT_StrUnit(save_name, 5), 105) ThenBlock: {
                                IfCondition EqualTo(JSRT_StrUnit(save_name, 6), 110) ThenBlock: {
                                    IfCondition EqualTo(JSRT_StrUnit(save_name, 7), 103) ThenBlock: {
                                        IfCondition EqualTo(JSRT_StrUnit(save_name, 8), 0) ThenBlock: {
                                            ReturnValue(JSNativeID.REGEXP_TO_STRING)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // exec (101 120 101 99 0)
        IfCondition EqualTo(c0, 101) ThenBlock: {
            IfCondition EqualTo(JSRT_StrUnit(save_name, 1), 120) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(save_name, 2), 101) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(save_name, 3), 99) ThenBlock: {
                        IfCondition EqualTo(JSRT_StrUnit(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.REGEXP_EXEC)
                        }
                    }
                }
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// REGEXP METHOD DISPATCH — execute regexp methods with receiver
// Handler IDs: 83=test, 84=exec, 85=toString, 86=str.match, 87=str.search
// =============================================================================
Function.JSVM__DispatchRegExpMethod {
    Input: method_id: Integer
    Input: receiver: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = method_id
        save_recv = receiver
        save_args = args
        save_argc = argc

        // ─── REGEXP_TEST (83) — regexp.test(string) → boolean ───
        // M30c: lastIndex for global/sticky
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_TEST) ThenBlock: {
            rh_val = JSRT_ObjGet(save_recv, "__regex_handle__")
            IfCondition NotEqual(JSRT_GetType(rh_val), JSType.NUMBER) ThenBlock: {
                ReturnValue(JSRTState.false_val)
            }
            rx_h = JSRT_GetPayload(rh_val)
            IfCondition EqualTo(rx_h, 0) ThenBlock: {
                ReturnValue(JSRTState.false_val)
            }
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRTState.false_val)
            }
            t_arg = Dereference(save_args)
            IfCondition NotEqual(JSRT_GetType(t_arg), JSType.STRING) ThenBlock: {
                JSBridge__Push(save_recv)
                t_arg = JSRT_ToString(t_arg)
                save_recv = JSBridge__Pop()
            }
            t_ptr = JSRT_GetPayload(t_arg)
            IfCondition EqualTo(t_ptr, 0) ThenBlock: {
                ReturnValue(JSRTState.false_val)
            }
            t_len = JSRT_StrLen(t_ptr)
            // lastIndex when global OR sticky
            start_i = 0
            is_g = 0
            is_y = 0
            gv = JSRT_ObjGet(save_recv, "global")
            IfCondition EqualTo(JSRT_GetType(gv), JSType.BOOLEAN) ThenBlock: {
                IfCondition NotEqual(JSRT_GetPayload(gv), 0) ThenBlock: { is_g = 1 }
            }
            yv = JSRT_ObjGet(save_recv, "sticky")
            IfCondition EqualTo(JSRT_GetType(yv), JSType.BOOLEAN) ThenBlock: {
                IfCondition NotEqual(JSRT_GetPayload(yv), 0) ThenBlock: { is_y = 1 }
            }
            IfCondition Or(EqualTo(is_g, 1), EqualTo(is_y, 1)) ThenBlock: {
                liv = JSRT_ObjGet(save_recv, "lastIndex")
                IfCondition EqualTo(JSRT_GetType(liv), JSType.NUMBER) ThenBlock: {
                    start_i = Float_ToInt(JSRT_GetPayload(liv))
                    IfCondition LessThan(start_i, 0) ThenBlock: { start_i = 0 }
                }
            }
            found = JSRegex_SearchPosLenFrom(rx_h, t_ptr, t_len, start_i)
            IfCondition Or(EqualTo(is_g, 1), EqualTo(is_y, 1)) ThenBlock: {
                IfCondition EqualTo(found, 0) ThenBlock: {
                    JSRT_ObjSet(save_recv, "lastIndex", JSRT_CreateNumber(0))
                } ElseBlock: {
                    end_i = Add(JSRxResult.pos, JSRxResult.len)
                    IfCondition EqualTo(JSRxResult.len, 0) ThenBlock: {
                        end_i = Add(JSRxResult.pos, 1)
                    }
                    JSRT_ObjSet(save_recv, "lastIndex", JSRT_CreateNumber(end_i))
                }
            }
            ReturnValue(JSRT_CreateBool(found))
        }

        // ─── REGEXP_EXEC (84) — regexp.exec(string) → array|null ───
        // M30c/g: Array result + lastIndex for global/sticky
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_EXEC) ThenBlock: {
            rh_val2 = JSRT_ObjGet(save_recv, "__regex_handle__")
            IfCondition NotEqual(JSRT_GetType(rh_val2), JSType.NUMBER) ThenBlock: {
                ReturnValue(JSRTState.null_val)
            }
            rx_h2 = JSRT_GetPayload(rh_val2)
            IfCondition EqualTo(rx_h2, 0) ThenBlock: {
                ReturnValue(JSRTState.null_val)
            }
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRTState.null_val)
            }
            e_arg = Dereference(save_args)
            IfCondition NotEqual(JSRT_GetType(e_arg), JSType.STRING) ThenBlock: {
                JSBridge__Push(save_recv)
                e_arg = JSRT_ToString(e_arg)
                save_recv = JSBridge__Pop()
            }
            e_ptr = JSRT_GetPayload(e_arg)
            IfCondition EqualTo(e_ptr, 0) ThenBlock: {
                ReturnValue(JSRTState.null_val)
            }
            e_len = JSRT_StrLen(e_ptr)
            start_i = 0
            is_g = 0
            is_y = 0
            gv = JSRT_ObjGet(save_recv, "global")
            IfCondition EqualTo(JSRT_GetType(gv), JSType.BOOLEAN) ThenBlock: {
                IfCondition NotEqual(JSRT_GetPayload(gv), 0) ThenBlock: { is_g = 1 }
            }
            yv = JSRT_ObjGet(save_recv, "sticky")
            IfCondition EqualTo(JSRT_GetType(yv), JSType.BOOLEAN) ThenBlock: {
                IfCondition NotEqual(JSRT_GetPayload(yv), 0) ThenBlock: { is_y = 1 }
            }
            IfCondition Or(EqualTo(is_g, 1), EqualTo(is_y, 1)) ThenBlock: {
                liv = JSRT_ObjGet(save_recv, "lastIndex")
                IfCondition EqualTo(JSRT_GetType(liv), JSType.NUMBER) ThenBlock: {
                    start_i = Float_ToInt(JSRT_GetPayload(liv))
                    IfCondition LessThan(start_i, 0) ThenBlock: { start_i = 0 }
                }
            }
            found2 = JSRegex_SearchPosLenFrom(rx_h2, e_ptr, e_len, start_i)
            IfCondition EqualTo(found2, 0) ThenBlock: {
                IfCondition Or(EqualTo(is_g, 1), EqualTo(is_y, 1)) ThenBlock: {
                    JSRT_ObjSet(save_recv, "lastIndex", JSRT_CreateNumber(0))
                }
                ReturnValue(JSRTState.null_val)
            }
            m_pos = JSRxResult.pos
            m_len = JSRxResult.len
            IfCondition Or(EqualTo(is_g, 1), EqualTo(is_y, 1)) ThenBlock: {
                end_i = Add(m_pos, m_len)
                IfCondition EqualTo(m_len, 0) ThenBlock: { end_i = Add(m_pos, 1) }
                JSRT_ObjSet(save_recv, "lastIndex", JSRT_CreateNumber(end_i))
            }
            // Result as Array with index/input + capture groups
            res_arr = JSRT_CreateArray()
            JSBridge__Push(save_recv)
            JSBridge__Push(e_ptr)
            JSBridge__Push(e_len)
            m_str = JSRT_CreateStringSlice(e_ptr, m_pos, m_len)
            e_len = JSBridge__Pop()
            e_ptr = JSBridge__Pop()
            save_recv = JSBridge__Pop()
            JSRT_ArrPush(res_arr, m_str)
            // M30d: push capture groups 1..ngroups
            ng = JSRxResult.ngroups
            cbuf = JSRxResult.cap_buf
            gi = 0
            WhileLoop LessThan(gi, ng) {
                JSBridge__Push(save_recv)
                JSBridge__Push(e_ptr)
                JSBridge__Push(e_len)
                JSBridge__Push(res_arr)
                cs = -1
                ce = -1
                IfCondition NotEqual(cbuf, 0) ThenBlock: {
                    cs = Dereference(Add(cbuf, Multiply(Multiply(gi, 2), 8)))
                    ce = Dereference(Add(cbuf, Multiply(Add(Multiply(gi, 2), 1), 8)))
                }
                IfCondition And(GreaterEqual(cs, 0), GreaterEqual(ce, cs)) ThenBlock: {
                    c_str = JSRT_CreateStringSlice(e_ptr, cs, Subtract(ce, cs))
                    res_arr = JSBridge__Pop()
                    e_len = JSBridge__Pop()
                    e_ptr = JSBridge__Pop()
                    save_recv = JSBridge__Pop()
                    JSRT_ArrPush(res_arr, c_str)
                } ElseBlock: {
                    res_arr = JSBridge__Pop()
                    e_len = JSBridge__Pop()
                    e_ptr = JSBridge__Pop()
                    save_recv = JSBridge__Pop()
                    JSRT_ArrPush(res_arr, JSRT_Undefined())
                }
                gi = Add(gi, 1)
            }
            JSBridge__Push(res_arr)
            JSBridge__Push(e_ptr)
            JSBridge__Push(e_len)
            JSBridge__Push(rx_h2)
            JSRT_ObjSet(res_arr, "index", JSRT_CreateNumber(m_pos))
            rx_h2 = JSBridge__Pop()
            e_len = JSBridge__Pop()
            e_ptr = JSBridge__Pop()
            res_arr = JSBridge__Pop()
            JSBridge__Push(res_arr)
            JSBridge__Push(rx_h2)
            JSBridge__Push(e_ptr)
            inp_val = JSRT_CreateStringLen(e_ptr, e_len)
            e_ptr = JSBridge__Pop()
            rx_h2 = JSBridge__Pop()
            res_arr = JSBridge__Pop()
            JSRT_ObjSet(res_arr, "input", inp_val)
            // M30h: groups object
            res_arr = JSVM__AttachRegExpGroups(res_arr, rx_h2, e_ptr)
            ReturnValue(res_arr)
        }

        // ─── REGEXP_TO_STRING (85) — regexp.toString() → "/pattern/flags" ───
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_TO_STRING) ThenBlock: {
            // Get source and flags from receiver
            src_v = JSRT_ObjGet(save_recv, "source")
            flg_v = JSRT_ObjGet(save_recv, "flags")
            // If flags undefined (proto placeholder), synthesize
            IfCondition EqualTo(JSRT_GetType(flg_v), JSType.UNDEFINED) ThenBlock: {
                // fall through — build from boolean flags below
                flg_v = 0
            }
            src_p = 0
            IfCondition EqualTo(JSRT_GetType(src_v), JSType.STRING) ThenBlock: {
                src_p = JSRT_GetPayload(src_v)
            }
            flg_p = 0
            IfCondition EqualTo(JSRT_GetType(flg_v), JSType.STRING) ThenBlock: {
                flg_p = JSRT_GetPayload(flg_v)
            }
            IfCondition EqualTo(src_p, 0) ThenBlock: { src_p = "(?:)" }
            IfCondition EqualTo(flg_p, 0) ThenBlock: {
                // synthesize flags string
                fbuf = JSRTState.str_work_buf
                fi = 0
                IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "hasIndices")), 0) ThenBlock: {
                    SetByte(fbuf, fi, 100)
                    fi = Add(fi, 1)
                }
                IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "global")), 0) ThenBlock: {
                    SetByte(fbuf, fi, 103)
                    fi = Add(fi, 1)
                }
                IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "ignoreCase")), 0) ThenBlock: {
                    SetByte(fbuf, fi, 105)
                    fi = Add(fi, 1)
                }
                IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "multiline")), 0) ThenBlock: {
                    SetByte(fbuf, fi, 109)
                    fi = Add(fi, 1)
                }
                IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "dotAll")), 0) ThenBlock: {
                    SetByte(fbuf, fi, 115)
                    fi = Add(fi, 1)
                }
                IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "unicode")), 0) ThenBlock: {
                    SetByte(fbuf, fi, 117)
                    fi = Add(fi, 1)
                }
                IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "sticky")), 0) ThenBlock: {
                    SetByte(fbuf, fi, 121)
                    fi = Add(fi, 1)
                }
                SetByte(fbuf, fi, 0)
                flg_p = fbuf
            }

            // Build "/source/flags" via StringConcat
            JSRT__Push(save_recv)
            tmp1 = StringConcat("/", src_p)
            tmp2 = StringConcat(tmp1, "/")
            result_str = StringConcat(tmp2, flg_p)
            save_recv = JSRT__Pop()
            ReturnValue(JSRT_CreateString(result_str))
        }

        // ─── REGEXP getters 216-224 (this = receiver) ───
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_GET_SOURCE) ThenBlock: {
            // Prefer own data "source"; default "(?:)" for prototype
            sv = JSRT_ObjGet(save_recv, "source")
            IfCondition EqualTo(JSRT_GetType(sv), JSType.STRING) ThenBlock: {
                ReturnValue(sv)
            }
            ReturnValue(JSRT_CreateString("(?:)"))
        }
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_GET_FLAGS) ThenBlock: {
            // ToBoolean each flag prop, build sorted-ish string d g i m s u y
            fbuf = JSRTState.str_work_buf
            fi = 0
            IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "hasIndices")), 0) ThenBlock: {
                SetByte(fbuf, fi, 100)
                    fi = Add(fi, 1)
            }
            IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "global")), 0) ThenBlock: {
                SetByte(fbuf, fi, 103)
                    fi = Add(fi, 1)
            }
            IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "ignoreCase")), 0) ThenBlock: {
                SetByte(fbuf, fi, 105)
                    fi = Add(fi, 1)
            }
            IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "multiline")), 0) ThenBlock: {
                SetByte(fbuf, fi, 109)
                    fi = Add(fi, 1)
            }
            IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "dotAll")), 0) ThenBlock: {
                SetByte(fbuf, fi, 115)
                    fi = Add(fi, 1)
            }
            IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "unicode")), 0) ThenBlock: {
                SetByte(fbuf, fi, 117)
                    fi = Add(fi, 1)
            }
            // M31c: 'v' before 'y' (spec flag order d g i m s u v y)
            IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "unicodeSets")), 0) ThenBlock: {
                SetByte(fbuf, fi, 118)
                fi = Add(fi, 1)
            }
            IfCondition NotEqual(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "sticky")), 0) ThenBlock: {
                SetByte(fbuf, fi, 121)
                    fi = Add(fi, 1)
            }
            SetByte(fbuf, fi, 0)
            ReturnValue(JSRT_CreateString(fbuf))
        }
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_GET_GLOBAL) ThenBlock: {
            ReturnValue(JSRT_CreateBool(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "global"))))
        }
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_GET_IGNORE_CASE) ThenBlock: {
            ReturnValue(JSRT_CreateBool(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "ignoreCase"))))
        }
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_GET_MULTILINE) ThenBlock: {
            ReturnValue(JSRT_CreateBool(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "multiline"))))
        }
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_GET_DOTALL) ThenBlock: {
            ReturnValue(JSRT_CreateBool(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "dotAll"))))
        }
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_GET_STICKY) ThenBlock: {
            ReturnValue(JSRT_CreateBool(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "sticky"))))
        }
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_GET_UNICODE) ThenBlock: {
            ReturnValue(JSRT_CreateBool(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "unicode"))))
        }
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_GET_UNICODE_SETS) ThenBlock: {
            ReturnValue(JSRT_CreateBool(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "unicodeSets"))))
        }
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_GET_HAS_INDICES) ThenBlock: {
            ReturnValue(JSRT_CreateBool(JSRT_IsTruthy(JSRT_ObjGet(save_recv, "hasIndices"))))
        }

        // ─── @@match (225) — same as string.match(re) with this=re ───
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_SYMBOL_MATCH) ThenBlock: {
            // arg0 = string
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRTState.null_val)
            }
            sarg = Dereference(save_args)
            IfCondition NotEqual(JSRT_GetType(sarg), JSType.STRING) ThenBlock: {
                sarg = JSRT_ToString(sarg)
            }
            // Reuse match path: DispatchStringMethod STR_MATCH_RE with recv=string, args=[this]
            // Build 1-arg buffer with regexp receiver
            ab = JSVMCallBuf.buf
            StoreValue(ab, save_recv)
            ReturnValue(JSVM__DispatchRegExpMethod(JSNativeID.STR_MATCH_RE, sarg, ab, 1))
        }

        // ─── @@search (227) ───
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_SYMBOL_SEARCH) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(-1))
            }
            sarg = Dereference(save_args)
            IfCondition NotEqual(JSRT_GetType(sarg), JSType.STRING) ThenBlock: {
                sarg = JSRT_ToString(sarg)
            }
            ab = JSVMCallBuf.buf
            StoreValue(ab, save_recv)
            ReturnValue(JSVM__DispatchRegExpMethod(JSNativeID.STR_SEARCH_RE, sarg, ab, 1))
        }

        // ─── @@replace (226) — string.replace(re, repl) ───
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_SYMBOL_REPLACE) ThenBlock: {
            // this=re, arg0=string, arg1=replacement
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_CreateString(""))
            }
            sarg = Dereference(save_args)
            IfCondition NotEqual(JSRT_GetType(sarg), JSType.STRING) ThenBlock: {
                JSBridge__Push(save_recv)
                sarg = JSRT_ToString(sarg)
                save_recv = JSBridge__Pop()
            }
            // Build args [re, repl] for string replace with recv=string
            ab = JSVMCallBuf.buf
            StoreValue(ab, save_recv)
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                StoreValue(Add(ab, 8), Dereference(Add(save_args, 8)))
                ReturnValue(JSVM__DispatchStringMethod(67, sarg, ab, 2))
            }
            StoreValue(Add(ab, 8), JSRT_Undefined())
            ReturnValue(JSVM__DispatchStringMethod(67, sarg, ab, 2))
        }

        // ─── @@split (228) ───
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_SYMBOL_SPLIT) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_CreateArray())
            }
            sarg = Dereference(save_args)
            IfCondition NotEqual(JSRT_GetType(sarg), JSType.STRING) ThenBlock: {
                JSBridge__Push(save_recv)
                sarg = JSRT_ToString(sarg)
                save_recv = JSBridge__Pop()
            }
            ab = JSVMCallBuf.buf
            StoreValue(ab, save_recv)
            ac = 1
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                StoreValue(Add(ab, 8), Dereference(Add(save_args, 8)))
                ac = 2
            }
            ReturnValue(JSVM__DispatchStringMethod(68, sarg, ab, ac))
        }

        // ─── STR_MATCH_RE (86) — string.match(regexp|string) ───
        // M30c/g: ToString this; sticky lastIndex; Array result
        IfCondition EqualTo(save_id, JSNativeID.STR_MATCH_RE) ThenBlock: {
            sr_type = JSRT_GetType(save_recv)
            IfCondition Or(EqualTo(sr_type, JSType.NULL), EqualTo(sr_type, JSType.UNDEFINED)) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "String.prototype.match called on null or undefined")
                JSVMCall.exc_prop = 1
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            IfCondition NotEqual(sr_type, JSType.STRING) ThenBlock: {
                save_recv = JSRT_ToString(save_recv)
            }
            sm_ptr = JSRT_GetPayload(save_recv)
            sm_len = 0
            IfCondition NotEqual(sm_ptr, 0) ThenBlock: { sm_len = JSRT_StrLen(sm_ptr) }
            re_h = 0
            is_g = 0
            is_y = 0
            re_arg = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                re_arg = Dereference(save_args)
                IfCondition EqualTo(JSRT_GetType(re_arg), JSType.OBJECT) ThenBlock: {
                    re_rh = JSRT_ObjGet(re_arg, "__regex_handle__")
                    IfCondition EqualTo(JSRT_GetType(re_rh), JSType.NUMBER) ThenBlock: {
                        re_h = JSRT_GetPayload(re_rh)
                        gv = JSRT_ObjGet(re_arg, "global")
                        IfCondition EqualTo(JSRT_GetType(gv), JSType.BOOLEAN) ThenBlock: {
                            IfCondition NotEqual(JSRT_GetPayload(gv), 0) ThenBlock: { is_g = 1 }
                        }
                        yv = JSRT_ObjGet(re_arg, "sticky")
                        IfCondition EqualTo(JSRT_GetType(yv), JSType.BOOLEAN) ThenBlock: {
                            IfCondition NotEqual(JSRT_GetPayload(yv), 0) ThenBlock: { is_y = 1 }
                        }
                    }
                }
                IfCondition EqualTo(re_h, 0) ThenBlock: {
                    // string → compile as RegExp
                    pat_s = JSRT_ToString(re_arg)
                    pat_p = JSRT_GetPayload(pat_s)
                    IfCondition EqualTo(pat_p, 0) ThenBlock: { pat_p = "" }
                    re_h = JSRegex_Compile(pat_p, 0)
                    re_arg = 0
                }
            } ElseBlock: {
                re_h = JSRegex_Compile("(?:)", 0)
            }
            IfCondition EqualTo(re_h, 0) ThenBlock: {
                ReturnValue(JSRTState.null_val)
            }
            // global: collect all matches as array of strings
            IfCondition EqualTo(is_g, 1) ThenBlock: {
                out = JSRT_CreateArray()
                scan = 0
                // ES: global match resets lastIndex to 0 then loops
                IfCondition NotEqual(re_arg, 0) ThenBlock: {
                    JSRT_ObjSet(re_arg, "lastIndex", JSRT_CreateNumber(0))
                }
                WhileLoop LessEqual(scan, sm_len) {
                    mf = JSRegex_SearchPosLenFrom(re_h, sm_ptr, sm_len, scan)
                    IfCondition EqualTo(mf, 0) ThenBlock: {
                        scan = Add(sm_len, 1)
                    } ElseBlock: {
                        mpos = JSRxResult.pos
                        mlen = JSRxResult.len
                        JSBridge__Push(out)
                        JSBridge__Push(sm_ptr)
                        JSBridge__Push(sm_len)
                        m_str = JSRT_CreateStringSlice(sm_ptr, mpos, mlen)
                        sm_len = JSBridge__Pop()
                        sm_ptr = JSBridge__Pop()
                        out = JSBridge__Pop()
                        JSRT_ArrPush(out, m_str)
                        IfCondition EqualTo(mlen, 0) ThenBlock: {
                            scan = Add(mpos, 1)
                        } ElseBlock: {
                            scan = Add(mpos, mlen)
                        }
                    }
                }
                IfCondition NotEqual(re_arg, 0) ThenBlock: {
                    JSRT_ObjSet(re_arg, "lastIndex", JSRT_CreateNumber(0))
                }
                IfCondition EqualTo(JSRT_ArrLen(out), 0) ThenBlock: {
                    ReturnValue(JSRTState.null_val)
                }
                ReturnValue(out)
            }
            // non-global: sticky uses lastIndex; plain searches from 0
            start_i = 0
            IfCondition EqualTo(is_y, 1) ThenBlock: {
                IfCondition NotEqual(re_arg, 0) ThenBlock: {
                    liv = JSRT_ObjGet(re_arg, "lastIndex")
                    IfCondition EqualTo(JSRT_GetType(liv), JSType.NUMBER) ThenBlock: {
                        start_i = Float_ToInt(JSRT_GetPayload(liv))
                        IfCondition LessThan(start_i, 0) ThenBlock: { start_i = 0 }
                    }
                }
                mf = JSRegex_SearchPosLenFrom(re_h, sm_ptr, sm_len, start_i)
            } ElseBlock: {
                mf = JSRegex_SearchPosLen(re_h, sm_ptr, sm_len)
            }
            IfCondition EqualTo(mf, 0) ThenBlock: {
                IfCondition And(EqualTo(is_y, 1), NotEqual(re_arg, 0)) ThenBlock: {
                    JSRT_ObjSet(re_arg, "lastIndex", JSRT_CreateNumber(0))
                }
                ReturnValue(JSRTState.null_val)
            }
            mm_pos = JSRxResult.pos
            mm_len = JSRxResult.len
            IfCondition And(EqualTo(is_y, 1), NotEqual(re_arg, 0)) ThenBlock: {
                end_i = Add(mm_pos, mm_len)
                IfCondition EqualTo(mm_len, 0) ThenBlock: { end_i = Add(mm_pos, 1) }
                JSRT_ObjSet(re_arg, "lastIndex", JSRT_CreateNumber(end_i))
            }
            res_arr = JSRT_CreateArray()
            JSBridge__Push(sm_ptr)
            JSBridge__Push(sm_len)
            mm_str = JSRT_CreateStringSlice(sm_ptr, mm_pos, mm_len)
            sm_len = JSBridge__Pop()
            sm_ptr = JSBridge__Pop()
            JSRT_ArrPush(res_arr, mm_str)
            // capture groups for non-global match
            ng = JSRxResult.ngroups
            cbuf = JSRxResult.cap_buf
            gi = 0
            WhileLoop LessThan(gi, ng) {
                JSBridge__Push(sm_ptr)
                JSBridge__Push(sm_len)
                JSBridge__Push(res_arr)
                cs = -1
                ce = -1
                IfCondition NotEqual(cbuf, 0) ThenBlock: {
                    cs = Dereference(Add(cbuf, Multiply(Multiply(gi, 2), 8)))
                    ce = Dereference(Add(cbuf, Multiply(Add(Multiply(gi, 2), 1), 8)))
                }
                IfCondition And(GreaterEqual(cs, 0), GreaterEqual(ce, cs)) ThenBlock: {
                    c_str = JSRT_CreateStringSlice(sm_ptr, cs, Subtract(ce, cs))
                    res_arr = JSBridge__Pop()
                    sm_len = JSBridge__Pop()
                    sm_ptr = JSBridge__Pop()
                    JSRT_ArrPush(res_arr, c_str)
                } ElseBlock: {
                    res_arr = JSBridge__Pop()
                    sm_len = JSBridge__Pop()
                    sm_ptr = JSBridge__Pop()
                    JSRT_ArrPush(res_arr, JSRT_Undefined())
                }
                gi = Add(gi, 1)
            }
            JSBridge__Push(res_arr)
            JSBridge__Push(sm_ptr)
            JSBridge__Push(sm_len)
            JSBridge__Push(re_h)
            JSRT_ObjSet(res_arr, "index", JSRT_CreateNumber(mm_pos))
            re_h = JSBridge__Pop()
            sm_len = JSBridge__Pop()
            sm_ptr = JSBridge__Pop()
            res_arr = JSBridge__Pop()
            JSBridge__Push(res_arr)
            JSBridge__Push(re_h)
            JSBridge__Push(sm_ptr)
            ms_val = JSRT_CreateStringLen(sm_ptr, sm_len)
            sm_ptr = JSBridge__Pop()
            re_h = JSBridge__Pop()
            res_arr = JSBridge__Pop()
            JSRT_ObjSet(res_arr, "input", ms_val)
            // M30h: groups (re_h may be ephemeral compile — still has name table)
            res_arr = JSVM__AttachRegExpGroups(res_arr, re_h, sm_ptr)
            ReturnValue(res_arr)
        }

        // ─── STR_SEARCH_RE (87) — string.search(regexp|string) → index|-1 ───
        // M30g: sticky only matches at 0 (search saves/restores lastIndex → 0)
        IfCondition EqualTo(save_id, JSNativeID.STR_SEARCH_RE) ThenBlock: {
            sr2_type = JSRT_GetType(save_recv)
            IfCondition Or(EqualTo(sr2_type, JSType.NULL), EqualTo(sr2_type, JSType.UNDEFINED)) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "String.prototype.search called on null or undefined")
                JSVMCall.exc_prop = 1
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            IfCondition NotEqual(sr2_type, JSType.STRING) ThenBlock: {
                save_recv = JSRT_ToString(save_recv)
            }
            ss_ptr = JSRT_GetPayload(save_recv)
            ss_len = 0
            IfCondition NotEqual(ss_ptr, 0) ThenBlock: { ss_len = JSRT_StrLen(ss_ptr) }
            se_h = 0
            se_arg = 0
            saved_li = 0
            has_re_obj = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                se_arg = Dereference(save_args)
                IfCondition EqualTo(JSRT_GetType(se_arg), JSType.OBJECT) ThenBlock: {
                    se_rh = JSRT_ObjGet(se_arg, "__regex_handle__")
                    IfCondition EqualTo(JSRT_GetType(se_rh), JSType.NUMBER) ThenBlock: {
                        se_h = JSRT_GetPayload(se_rh)
                        has_re_obj = 1
                        // ES @@search: save lastIndex, set 0, exec, restore
                        liv = JSRT_ObjGet(se_arg, "lastIndex")
                        IfCondition EqualTo(JSRT_GetType(liv), JSType.NUMBER) ThenBlock: {
                            saved_li = Float_ToInt(JSRT_GetPayload(liv))
                        }
                        JSRT_ObjSet(se_arg, "lastIndex", JSRT_CreateNumber(0))
                    }
                }
                IfCondition EqualTo(se_h, 0) ThenBlock: {
                    pat_s = JSRT_ToString(se_arg)
                    pat_p = JSRT_GetPayload(pat_s)
                    IfCondition EqualTo(pat_p, 0) ThenBlock: { pat_p = "" }
                    se_h = JSRegex_Compile(pat_p, 0)
                }
            } ElseBlock: {
                se_h = JSRegex_Compile("(?:)", 0)
            }
            IfCondition EqualTo(se_h, 0) ThenBlock: {
                IfCondition EqualTo(has_re_obj, 1) ThenBlock: {
                    JSRT_ObjSet(se_arg, "lastIndex", JSRT_CreateNumber(saved_li))
                }
                ReturnValue(JSRT_CreateNumber(-1))
            }
            // sticky regex: SearchPosLenFrom at 0 only (flag on handle)
            sf = JSRegex_SearchPosLenFrom(se_h, ss_ptr, ss_len, 0)
            IfCondition EqualTo(has_re_obj, 1) ThenBlock: {
                JSRT_ObjSet(se_arg, "lastIndex", JSRT_CreateNumber(saved_li))
            }
            IfCondition EqualTo(sf, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(-1))
            }
            ReturnValue(JSRT_CreateNumber(JSRxResult.pos))
        }

        // Unknown method — return undefined
        ReturnValue(JSRT_Undefined())
    }
}
