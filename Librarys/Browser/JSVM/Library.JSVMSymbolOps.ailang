        IfCondition EqualTo(save_n, 0) ThenBlock: { ReturnValue(0) }
        ctor = JSVM__GetGlobal(save_n)
        JSBridge__Push(ctor)
        ct = JSRT_GetType(ctor)
        ctor = JSBridge__Pop()
        IfCondition NotEqual(ct, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        JSBridge__SetAttrBits(ctor, "prototype", 0)
        ReturnValue(1)
    }
}


// globalThis owns eval/isNaN/isFinite (W, !E, C). Called from Stamp, after
// glob_this exists. Does not edit InstallBuiltins.
Function.JSVM__StampBuiltinAttrs {
    Output: Integer
