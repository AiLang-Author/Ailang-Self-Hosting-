Function.JSVM__MakeChildProto {
    Input: parent: Address
    Output: Address
    Body: {
        JSBridge__Push(parent)
        obj = JSRT_CreateObject()
        JSBridge__Push(obj)
        JSRTStack.hold = JSBridge__Pop()
        parent = JSBridge__Pop()
        IfCondition NotEqual(parent, 0) ThenBlock: {
            JSRTStack.hold2 = parent
            JSBridge__Push(JSRTStack.hold)
            JSRT_ObjSet(JSRTStack.hold, "__proto__", JSRTStack.hold2)
            obj = JSBridge__Pop()
        } ElseBlock: {
            obj = JSRTStack.hold
        }
        JSRTStack.hold = 0
        JSRTStack.hold2 = 0
        ReturnValue(obj)
    }
}

