        ctor = JSVM__GetGlobal("WeakSet")
        JSBridgeTmp.ptr = ctor
        ct = JSRT_GetType(JSBridgeTmp.ptr)
        IfCondition NotEqual(ct, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        proto = JSRT_ObjGet(JSBridgeTmp.ptr, "prototype")
        JSBridgeTmp.len = proto
        JSBridge__Push(JSBridgeTmp.len)
        JSVM__StampMapMethod(JSBridgeTmp.len, "add", JSNativeID.WEAKSET_ADD, 1)
        JSBridgeTmp.len = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.len)
        JSVM__StampMapMethod(JSBridgeTmp.len, "has", JSNativeID.WEAKSET_HAS, 1)
        JSBridgeTmp.len = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.len)
        JSVM__StampMapMethod(JSBridgeTmp.len, "delete", JSNativeID.WEAKSET_DELETE, 1)
        JSBridgeTmp.len = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.len)
        sk = JSVM_SymbolToKey(JSVMSymbol.toStringTag)
        JSBridgeTmp.name_ptr = sk
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition NotEqual(JSBridgeTmp.name_ptr, 0) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.name_ptr)
            tag = JSRT_CreateString("WeakSet")
            JSBridgeTmp.val = tag
            JSBridgeTmp.addr = JSBridge__Pop()
            JSBridgeTmp.cb_val = JSBridge__Pop()
            JSRT_ObjSet(JSBridgeTmp.cb_val, JSBridgeTmp.addr, JSBridgeTmp.val)
            JSBridge__SetAttrBits(JSBridgeTmp.cb_val, JSBridgeTmp.addr, 4)
        }
        ReturnValue(1)
    }
}

// Math and JSON: tag on the object. BigInt and Promise: tag on the prototype.
Function.JSVM_StampToStringTags {
    Output: Integer
    Body: {
        JSVM__InstallProtoAcc()
        JSVM__InstallWeakCtors()
        JSVM__StampBuiltinAttrs()
        IfCondition EqualTo(JSVMSymbol.toStringTag, 0) ThenBlock: {
            ReturnValue(0)
        }
        obj = JSVM__GetGlobal("Math")
        IfCondition NotEqual(obj, 0) ThenBlock: {
            IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                JSRT_ObjSet(obj, "__proto__", JSRTState.object_proto)
            }
        }
        JSVM__WriteMathTag(obj)
        obj = JSVM__GetGlobal("BigInt")
        proto = JSRT_ObjGet(obj, "prototype")
        JSVM__WriteBigIntTag(proto)
        obj = JSVM__GetGlobal("Promise")
        proto = JSRT_ObjGet(obj, "prototype")
        JSVM__WritePromiseTag(proto)
        obj = JSVM__GetGlobal("JSON")
        IfCondition NotEqual(obj, 0) ThenBlock: {
            IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                JSRT_ObjSet(obj, "__proto__", JSRTState.object_proto)
            }
        }
        JSVM__WriteJSONTag(obj)
        JSVM__WriteGenTag(JSRTState.generator_proto)
        JSVM__WriteGenFnTag(JSRTState.generator_function_proto)
        obj = JSVM__MakeChildProto(JSRTState.object_proto)
        JSRTState.iterator_proto = obj
        JSVM__WriteIterTag(JSRTState.iterator_proto)
        obj = JSVM__MakeChildProto(JSRTState.iterator_proto)
        JSRTState.array_iter_proto = obj
        JSVM__WriteArrIterTag(JSRTState.array_iter_proto)
        obj = JSVM__MakeChildProto(JSRTState.iterator_proto)
        JSRTState.string_iter_proto = obj
        JSVM__WriteStrIterTag(JSRTState.string_iter_proto)
        obj = JSVM__MakeChildProto(JSRTState.iterator_proto)
        JSRTState.map_iter_proto = obj
        JSVM__WriteMapIterTag(JSRTState.map_iter_proto)
        obj = JSVM__MakeChildProto(JSRTState.iterator_proto)
        JSRTState.set_iter_proto = obj
        JSVM__WriteSetIterTag(JSRTState.set_iter_proto)
        JSVM__InstallStrIter()
        JSVM__InstallAsyncFn()
        JSVM__BindGenFnCtor()
        JSVM__StampMapMethods()
        JSVM__StampSetMethods()
        JSVM__StampWeakMapMethods()
        JSVM__StampWeakSetMethods()
        JSVM__StampPromiseMethods()
        ReturnValue(1)
    }
}

// try, withResolvers, allKeyed, allSettledKeyed on the Promise constructor.
Function.JSVM__StampPromiseMethods {
    Output: Integer
    Body: {
        ctor = JSVM__GetGlobal("Promise")
        JSBridgeTmp.ptr = ctor
        ct = JSRT_GetType(JSBridgeTmp.ptr)
        IfCondition NotEqual(ct, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(JSBridgeTmp.ptr)
        JSVM__StampMapMethod(JSBridgeTmp.ptr, "try", JSNativeID.PROMISE_TRY, 1)
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        JSVM__StampMapMethod(JSBridgeTmp.ptr, "withResolvers", JSNativeID.PROMISE_WITH_RESOLVERS, 0)
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        JSVM__StampMapMethod(JSBridgeTmp.ptr, "allKeyed", JSNativeID.PROMISE_ALL_KEYED, 1)
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        JSVM__StampMapMethod(JSBridgeTmp.ptr, "allSettledKeyed", JSNativeID.PROMISE_ALL_SETTLED_KEYED, 1)
        JSBridgeTmp.ptr = JSBridge__Pop()
        ReturnValue(1)
    }
}
