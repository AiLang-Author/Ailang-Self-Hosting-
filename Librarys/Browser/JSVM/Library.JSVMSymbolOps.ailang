// Library.JSVMSymbolOps.ailang — Symbol.for / keyFor, description, @@toPrimitive
// No FixedPool. JSVMSymbol stays on Library.JSVM.ailang.
// Native ids are literals so JSNativeID slot layout does not move:
//   353 Symbol.for, 354 Symbol.keyFor, 355 description getter, 356 @@toPrimitive
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Primitive symbol: class Symbol, and not an Object(symbol) wrapper.
// Wrappers are also class Symbol and store the primitive in __value__.
Function.JSVM_IsPrimSymbol {
    Input: v: Address
    Output: Integer
    Body: {
        save_v = v
        IfCondition EqualTo(JSVM_IsSymbol(save_v), 0) ThenBlock: {
            ReturnValue(0)
        }
        boxed = JSRT_ObjGet(save_v, "__value__")
        IfCondition EqualTo(JSVM_IsSymbol(boxed), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// thisSymbolValue. Returns the primitive, or 0 after a TypeError.
Function.JSVM_ThisSymbolValue {
    Input: v: Address
    Output: Address
    Body: {
        save_v = v
        IfCondition EqualTo(JSVM_IsSymbol(save_v), 1) ThenBlock: {
            boxed = JSRT_ObjGet(save_v, "__value__")
            IfCondition EqualTo(JSVM_IsSymbol(boxed), 1) ThenBlock: {
                ReturnValue(boxed)
            }
            ReturnValue(save_v)
        }
        terr = JSVM_CreateTypedError("TypeError", "this is not a Symbol")
        JSVM__SetGlobal("__pend_exc__", terr)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = terr
        JSVM_ThrowValue(terr)
        ReturnValue(0)
    }
}

// SymbolDescriptiveString. Reads [[Description]] from __desc__.
Function.JSVM_SymbolDescriptiveString {
    Input: sym: Address
    Output: Address
    Body: {
        save_sym = sym
        dval_s = JSRT_ObjGet(save_sym, "__desc__")
        mid_s = JSRT_CreateString("")
        IfCondition And(NotEqual(dval_s, 0), NotEqual(dval_s, JSRTState.undef_val)) ThenBlock: {
            IfCondition EqualTo(JSRT_GetType(dval_s), JSType.STRING) ThenBlock: {
                mid_s = dval_s
            }
        }
        pre_s = JSRT_CreateString("Symbol")
        lp_s = JSRT_CreateString("(")
        rp_s = JSRT_CreateString(")")
        p1s = JSRT__StrConcat(JSRT_GetPayload(pre_s), JSRT_GetPayload(lp_s))
        IfCondition EqualTo(p1s, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString("Symbol()"))
        }
        p2s = JSRT__StrConcat(JSRT_GetPayload(p1s), JSRT_GetPayload(mid_s))
        IfCondition EqualTo(p2s, 0) ThenBlock: {
            ReturnValue(p1s)
        }
        p3s = JSRT__StrConcat(JSRT_GetPayload(p2s), JSRT_GetPayload(rp_s))
        IfCondition EqualTo(p3s, 0) ThenBlock: {
            ReturnValue(p2s)
        }
        ReturnValue(p3s)
    }
}

// GlobalSymbolRegistry object, hung off the sid registry so no new pool field.
Function.JSVM_SymbolGSR {
    Output: Address
    Body: {
        IfCondition EqualTo(JSVMSymbol.registry, 0) ThenBlock: {
            JSVMSymbol.registry = JSRT_CreateObject()
        }
        gsr = JSRT_ObjGet(JSVMSymbol.registry, "__gsr__")
        IfCondition NotEqual(JSRT_GetType(gsr), JSType.OBJECT) ThenBlock: {
            gsr = JSRT_CreateObject()
            JSBridge__Push(gsr)
            JSRT_ObjSet(JSVMSymbol.registry, "__gsr__", gsr)
            gsr = JSBridge__Pop()
        }
        ReturnValue(gsr)
    }
}

// Symbol.for(key) — handler 353
Function.JSVM_SymbolForNative {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        keyv = JSRTState.undef_val
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            keyv = Dereference(save_args)
        }
        s = JSRT_ToString(keyv)
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        sp = JSRT_GetPayload(s)
        JSBridge__Push(s)
        ck = JSRT_StrClone(sp)
        s = JSBridge__Pop()
        IfCondition EqualTo(ck, 0) ThenBlock: {
            ck = sp
        }
        JSBridge__Push(s)
        JSBridge__Push(ck)
        gsr = JSVM_SymbolGSR()
        ck = JSBridge__Pop()
        s = JSBridge__Pop()
        JSBridge__Push(s)
        JSBridge__Push(ck)
        JSBridge__Push(gsr)
        existing = JSRT_ObjGet(gsr, ck)
        gsr = JSBridge__Pop()
        ck = JSBridge__Pop()
        s = JSBridge__Pop()
        IfCondition EqualTo(JSVM_IsPrimSymbol(existing), 1) ThenBlock: {
            ReturnValue(existing)
        }
        JSBridge__Push(gsr)
        JSBridge__Push(ck)
        JSBridge__Push(s)
        neu = JSVM_CreateSymbol(s)
        s = JSBridge__Pop()
        ck = JSBridge__Pop()
        gsr = JSBridge__Pop()
        IfCondition EqualTo(neu, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__Push(gsr)
        JSBridge__Push(ck)
        JSBridge__Push(neu)
        JSBridge__Push(s)
        JSRT_ObjSet(neu, "__gsrkey__", s)
        s = JSBridge__Pop()
        neu = JSBridge__Pop()
        ck = JSBridge__Pop()
        gsr = JSBridge__Pop()
        JSBridge__Push(gsr)
        JSBridge__Push(ck)
        JSBridge__Push(neu)
        JSBridge__SetAttrBits(neu, "__gsrkey__", 0)
        neu = JSBridge__Pop()
        ck = JSBridge__Pop()
        gsr = JSBridge__Pop()
        JSRT_ObjSet(gsr, ck, neu)
        ReturnValue(neu)
    }
}

// Symbol.keyFor(sym) — handler 354. Throws unless the arg is a primitive symbol.
Function.JSVM_SymbolKeyForNative {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Symbol.keyFor requires a symbol")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        arg0 = Dereference(save_args)
        IfCondition EqualTo(JSVM_IsPrimSymbol(arg0), 0) ThenBlock: {
            terr2 = JSVM_CreateTypedError("TypeError", "Symbol.keyFor requires a symbol")
            JSVM__SetGlobal("__pend_exc__", terr2)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr2
            JSVM_ThrowValue(terr2)
            ReturnValue(JSRT_Undefined())
        }
        k = JSRT_ObjGet(arg0, "__gsrkey__")
        IfCondition EqualTo(JSRT_GetType(k), JSType.STRING) ThenBlock: {
            ReturnValue(k)
        }
        ReturnValue(JSRT_Undefined())
    }
}

// get Symbol.prototype.description — handler 355
Function.JSVM_SymbolDescGet {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        this_v = JSVM__GetGlobal("this")
        sym = JSVM_ThisSymbolValue(this_v)
        IfCondition EqualTo(sym, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        d = JSRT_ObjGet(sym, "__desc__")
        IfCondition EqualTo(d, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(d)
    }
}

// Symbol.prototype[@@toPrimitive] — handler 356. Data property, length 1.
Function.JSVM_SymbolToPrimNative {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        this_v = JSVM__GetGlobal("this")
        sym = JSVM_ThisSymbolValue(this_v)
        IfCondition EqualTo(sym, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(sym)
    }
}

// Assignment to a primitive symbol.
// Strict: TypeError. Sloppy: ignore the write. Returns 1 if the write was handled.
Function.JSVM_SymbolWriteBarrier {
    Input: base: Address
    Output: Integer
    Body: {
        save_b = base
        IfCondition EqualTo(JSVM_IsPrimSymbol(save_b), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSVMState.is_strict, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot assign to symbol")
            JSVM_ThrowValue(terr)
            ReturnValue(1)
        }
        ReturnValue(1)
    }
}

// Stamp well-known symbol props !W !E !C, add the three missing symbols,
// and install Symbol.for / Symbol.keyFor (W !E C, the function default).
Function.JSVM_FinishSymbolCtor {
    Input: sym_func: Address
    Output: Integer
    Body: {
        save_f = sym_func
        JSBridge__SetAttrBits(save_f, "iterator", 0)
        JSBridge__SetAttrBits(save_f, "asyncIterator", 0)
        JSBridge__SetAttrBits(save_f, "species", 0)
        JSBridge__SetAttrBits(save_f, "match", 0)
        JSBridge__SetAttrBits(save_f, "replace", 0)
        JSBridge__SetAttrBits(save_f, "search", 0)
        JSBridge__SetAttrBits(save_f, "split", 0)
        JSBridge__SetAttrBits(save_f, "toStringTag", 0)
        JSBridge__SetAttrBits(save_f, "toPrimitive", 0)
        JSBridge__SetAttrBits(save_f, "unscopables", 0)
        JSBridge__SetAttrBits(save_f, "hasInstance", 0)
        JSBridge__SetAttrBits(save_f, "isConcatSpreadable", 0)
        JSBridge__Push(save_f)
        ms = JSVM_CreateSymbol(JSRT_CreateString("Symbol.matchAll"))
        save_f = JSBridge__Pop()
        JSRT_FuncPropSet(save_f, "matchAll", ms)
        JSBridge__SetAttrBits(save_f, "matchAll", 0)
        JSBridge__Push(save_f)
        ds = JSVM_CreateSymbol(JSRT_CreateString("Symbol.dispose"))
        save_f = JSBridge__Pop()
        JSRT_FuncPropSet(save_f, "dispose", ds)
        JSBridge__SetAttrBits(save_f, "dispose", 0)
        JSBridge__Push(save_f)
        ad = JSVM_CreateSymbol(JSRT_CreateString("Symbol.asyncDispose"))
        save_f = JSBridge__Pop()
        JSRT_FuncPropSet(save_f, "asyncDispose", ad)
        JSBridge__SetAttrBits(save_f, "asyncDispose", 0)
        JSBridge__Push(save_f)
        ff = JSBridge__CreateNativeFunc(353, "for", 1)
        save_f = JSBridge__Pop()
        JSRT_FuncPropSet(save_f, "for", ff)
        JSBridge__Push(save_f)
        kf = JSBridge__CreateNativeFunc(354, "keyFor", 1)
        save_f = JSBridge__Pop()
        JSRT_FuncPropSet(save_f, "keyFor", kf)
        ReturnValue(1)
    }
}

Function.JSVM__RelinkOneSymbol {
    Input: sym_g: Address
    Input: name: Address
    Input: proto: Address
    Output: Integer
    Body: {
        save_g = sym_g
        save_n = name
        save_p = proto
        w = JSRT_ObjGet(save_g, save_n)
        IfCondition EqualTo(JSVM_IsSymbol(w), 1) ThenBlock: {
            JSRT_ObjSet(w, "__proto__", save_p)
        }
        ReturnValue(1)
    }
}

// constructor, description getter, @@toStringTag, @@toPrimitive.
// Called after Symbol.prototype exists and the early well-known symbols are linked.
Function.JSVM_FinishSymbolProto {
    Output: Integer
    Body: {
        sym_g = JSVM__GetGlobal("Symbol")
        proto = JSVMSymbol.symbol_proto
        IfCondition EqualTo(proto, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSRT_ObjSet(proto, "constructor", sym_g)
        JSBridge__Push(sym_g)
        JSBridge__Push(proto)
        JSVM__InstallProtoGetter(proto, "description", 355, "get description")
        proto = JSBridge__Pop()
        sym_g = JSBridge__Pop()
        IfCondition NotEqual(JSVMSymbol.toStringTag, 0) ThenBlock: {
            JSBridge__Push(sym_g)
            JSBridge__Push(proto)
            sk = JSVM_SymbolToKey(JSVMSymbol.toStringTag)
            proto = JSBridge__Pop()
            sym_g = JSBridge__Pop()
            IfCondition NotEqual(sk, 0) ThenBlock: {
                JSBridge__Push(sym_g)
                JSBridge__Push(proto)
                JSBridge__Push(sk)
                tag = JSRT_CreateString("Symbol")
                sk = JSBridge__Pop()
                proto = JSBridge__Pop()
                sym_g = JSBridge__Pop()
                JSBridge__Push(sym_g)
                JSBridge__Push(proto)
                JSBridge__Push(sk)
                JSRT_ObjSet(proto, sk, tag)
                sk = JSBridge__Pop()
                proto = JSBridge__Pop()
                sym_g = JSBridge__Pop()
                JSBridge__SetAttrBits(proto, sk, JSAttr.C)
            }
        }
        IfCondition NotEqual(JSVMSymbol.toPrimitive, 0) ThenBlock: {
            JSBridge__Push(sym_g)
            JSBridge__Push(proto)
            sk2 = JSVM_SymbolToKey(JSVMSymbol.toPrimitive)
            proto = JSBridge__Pop()
            sym_g = JSBridge__Pop()
            IfCondition NotEqual(sk2, 0) ThenBlock: {
                JSBridge__Push(sym_g)
                JSBridge__Push(proto)
                JSBridge__Push(sk2)
                gf = JSBridge__CreateNativeFunc(356, "[Symbol.toPrimitive]", 1)
                sk2 = JSBridge__Pop()
                proto = JSBridge__Pop()
                sym_g = JSBridge__Pop()
                JSBridge__Push(sym_g)
                JSBridge__Push(proto)
                JSBridge__Push(sk2)
                JSRT_ObjSet(proto, sk2, gf)
                sk2 = JSBridge__Pop()
                proto = JSBridge__Pop()
                sym_g = JSBridge__Pop()
                JSBridge__SetAttrBits(proto, sk2, JSAttr.C)
            }
        }
        JSVM__RelinkOneSymbol(sym_g, "matchAll", proto)
        JSVM__RelinkOneSymbol(sym_g, "dispose", proto)
        JSVM__RelinkOneSymbol(sym_g, "asyncDispose", proto)
        ReturnValue(1)
    }
}

Function.JSVM__InstallOneSpecies {
    Input: ctor: Address
    Output: Integer
    Body: {
        save_c = ctor
        IfCondition NotEqual(JSRT_GetType(save_c), JSType.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSVMSymbol.species, 0) ThenBlock: {
            ReturnValue(0)
        }
        sk = JSVM_SymbolToKey(JSVMSymbol.species)
        IfCondition EqualTo(sk, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSVM__InstallProtoGetter(save_c, sk, JSNativeID.TA_GET_SPECIES, "get [Symbol.species]")
        ReturnValue(1)
    }
}

// @@species getters on the constructors the Symbol species tests name.
Function.JSVM_InstallBuiltinSpecies {
    Output: Integer
    Body: {
        c = JSVM__GetGlobal("Array")
        JSVM__InstallOneSpecies(c)
        c = JSVM__GetGlobal("Map")
        JSVM__InstallOneSpecies(c)
        c = JSVM__GetGlobal("Set")
        JSVM__InstallOneSpecies(c)
        c = JSVM__GetGlobal("RegExp")
        JSVM__InstallOneSpecies(c)
        c = JSVM__GetGlobal("Promise")
        JSVM__InstallOneSpecies(c)
        ReturnValue(1)
    }
}

// Same push order as the JSON @@toStringTag stamp. Bits 4.
Function.JSVM__WriteMathTag {
    Input: obj: Address
    Output: Integer
    Body: {
        save_o = obj
        IfCondition EqualTo(save_o, 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_o)
        sk = JSVM_SymbolToKey(JSVMSymbol.toStringTag)
        save_o = JSBridge__Pop()
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_o)
        JSBridge__Push(sk)
        tag = JSRT_CreateString("Math")
        sk = JSBridge__Pop()
        save_o = JSBridge__Pop()
        JSRT_ObjSet(save_o, sk, tag)
        JSBridge__SetAttrBits(save_o, sk, 4)
        ReturnValue(1)
    }
}

