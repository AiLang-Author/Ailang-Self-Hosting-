            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "isFinite")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "String")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "Object")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "Array")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "Boolean")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "Number")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "Symbol")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "Error")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "Function")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "Date")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "RegExp")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
            JSVM_MirrorBuiltin(gt, "Map")
            gt = JSBridge__Pop()
            JSBridge__Push(gt)
