        JSVM__FreezeBuiltinProto("Function")
        JSVM__FreezeBuiltinProto("Array")
        JSVM__FreezeBuiltinProto("String")
        JSVM__FreezeBuiltinProto("Boolean")
        JSVM__FreezeBuiltinProto("Number")
