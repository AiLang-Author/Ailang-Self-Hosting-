// String.prototype is a String exotic object: [[StringData]] "" and class String.
// valueOf reads __value__. Object.prototype.toString reads __class__.
Function.JSVM__StampStringData {
    Output: Integer
    Body: {
        ctor = JSVM__GetGlobal("String")
        JSBridge__Push(ctor)
        ct = JSRT_GetType(ctor)
        ctor = JSBridge__Pop()
        IfCondition NotEqual(ct, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(ctor)
        proto = JSRT_ObjGet(ctor, "prototype")
        ctor = JSBridge__Pop()
        IfCondition NotEqual(JSRT_GetType(proto), JSType.OBJECT) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(proto)
        has_c = JSRT_ObjHas(proto, "__class__")
        proto = JSBridge__Pop()
        IfCondition EqualTo(has_c, 0) ThenBlock: {
            JSBridge__Push(proto)
            cls = JSRT_CreateString("String")
            JSRTStack.hold = cls
            proto = JSBridge__Pop()
            cls = JSRTStack.hold
            JSRT_ObjSet(proto, "__class__", cls)
            JSRTStack.hold = 0
        }
        ctor = JSVM__GetGlobal("String")
        JSBridge__Push(ctor)
        proto = JSRT_ObjGet(ctor, "prototype")
        ctor = JSBridge__Pop()
        JSBridge__Push(proto)
        has_v = JSRT_ObjHas(proto, "__value__")
        proto = JSBridge__Pop()
        IfCondition EqualTo(has_v, 0) ThenBlock: {
            JSBridge__Push(proto)
            z = JSRT_CreateString("")
            JSRTStack.hold = z
            proto = JSBridge__Pop()
            z = JSRTStack.hold
            JSRT_ObjSet(proto, "__value__", z)
            JSRTStack.hold = 0
        }
        ctor = JSVM__GetGlobal("String")
        JSBridge__Push(ctor)
        proto = JSRT_ObjGet(ctor, "prototype")
        ctor = JSBridge__Pop()
        JSBridge__Push(proto)
        has_l = JSRT_ObjHas(proto, "length")
        proto = JSBridge__Pop()
        IfCondition EqualTo(has_l, 0) ThenBlock: {
            JSBridge__Push(proto)
            ln = JSRT_CreateNumber(0)
            JSRTStack.hold = ln
            proto = JSBridge__Pop()
            ln = JSRTStack.hold
            JSBridge__Push(proto)
            JSRT_ObjSet(proto, "length", ln)
            proto = JSBridge__Pop()
            JSRTStack.hold = 0
            JSBridge__SetAttrBits(proto, "length", 0)
        }
        ReturnValue(1)
    }
}

// prototype.constructor is writable, not enumerable, configurable.
// Missing constructor (RegExp.prototype) is installed here.
Function.JSVM__StampCtorNonEnum {
    Input: name: Address
    Output: Integer
    Body: {
        save_n = name
        ctor = JSVM__GetGlobal(save_n)
        JSBridge__Push(ctor)
        ct = JSRT_GetType(ctor)
        ctor = JSBridge__Pop()
        IfCondition NotEqual(ct, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(ctor)
        proto = JSRT_ObjGet(ctor, "prototype")
        ctor = JSBridge__Pop()
        pt = JSRT_GetType(proto)
        ok = 0
        IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: { ok = 1 }
        IfCondition EqualTo(pt, JSType.FUNCTION) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(proto)
        JSBridge__Push(ctor)
        has_c = JSRT_ObjHas(proto, "constructor")
        ctor = JSBridge__Pop()
        proto = JSBridge__Pop()
        IfCondition EqualTo(has_c, 0) ThenBlock: {
            JSBridge__Push(proto)
            JSRT_ObjSet(proto, "constructor", ctor)
            proto = JSBridge__Pop()
        }
        JSBridge__Push(proto)
        JSBridge__SetAttrBits(proto, "constructor", 5)
        proto = JSBridge__Pop()
        // Built-in prototypes except Object.prototype inherit Object.prototype.
        // ObjHas, not ObjGet: ObjGet("__proto__") on Function.prototype recurses.
        // RegExp.prototype had no [[Prototype]], so instances missed hasOwnProperty.
        IfCondition NotEqual(proto, JSRTState.object_proto) ThenBlock: {
            JSBridge__Push(proto)
            has_pp = JSRT_ObjHas(proto, "__proto__")
            proto = JSBridge__Pop()
            IfCondition EqualTo(has_pp, 0) ThenBlock: {
                IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                    JSRT_ObjSet(proto, "__proto__", JSRTState.object_proto)
                }
            }
        }
        ReturnValue(1)
    }
}

