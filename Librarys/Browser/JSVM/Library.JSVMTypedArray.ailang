                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(JSRT_GetType(nt), JSType.FUNCTION) ThenBlock: {
                pr = JSRT_ObjGet(nt, "prototype")
                IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ta, "__proto__", pr)
                }
            }
            ReturnValue(ta)
        }
        // fallback length 0
        ab = JSVM_ArrayBufferCreate(0)
        ta = JSVM_TypedArrayCreate(k, ab, 0, 0)
        ReturnValue(ta)
    }
}

// TypedArray.prototype.set(array [, offset])
Function.JSVM__NTASet {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        ta = recv
        IfCondition EqualTo(JSVM_IsTypedArray(ta), 0) ThenBlock: {
            ta = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsTypedArray(ta), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "TypedArray.prototype.set requires TypedArray")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition LessThan(argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        src = Dereference(args)
        // ToInteger(offset); default 0; negative → RangeError
        off = 0
        IfCondition GreaterThan(argc, 1) ThenBlock: {
            off_v = Dereference(Add(args, 8))
            // ToNumber abrupt (Symbol) propagates
            nbits = JSRT_ToNumber(off_v)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            // NaN → 0
            IfCondition EqualTo(Float_Ne(nbits, nbits), 1) ThenBlock: {
                off = 0
            } ElseBlock: {
                off = Float_ToInt(nbits)
            }
            IfCondition LessThan(off, 0) ThenBlock: {
                terr = JSVM_CreateTypedError("RangeError", "TypedArray set negative offset")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
        }
        dest_len = JSVM_TA_Length(ta)
        src_len = 0
        IfCondition EqualTo(JSVM_IsTypedArray(src), 1) ThenBlock: {
            src_len = JSVM_TA_Length(src)
        } ElseBlock: {
            // ToObject(src) array-like
            st = JSRT_GetType(src)
            IfCondition Or(EqualTo(st, JSType.NULL), EqualTo(st, JSType.UNDEFINED)) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "TypedArray.set cannot convert null/undefined")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            src_len = JSVM__ArrayLikeLen(src)
            IfCondition LessThan(src_len, 0) ThenBlock: { src_len = 0 }
        }
        IfCondition GreaterThan(Add(off, src_len), dest_len) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "TypedArray set out of range")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // M128e7dg: TypedArray src — always snapshot source bytes first.
        // Spec only requires CloneArrayBuffer when SameValue(srcBuffer,
        // targetBuffer); always cloning is correct and avoids missing
        // same-buffer detection (set/*same-buffer*).
        IfCondition EqualTo(JSVM_IsTypedArray(src), 1) ThenBlock: {
            src_buf = JSRT_ObjGet(src, "__ta_buf__")
            src_kind = JSVM_TA_Kind(src)
            src_es = JSVM_TA_ElementSize(src_kind)
            src_off_v = JSRT_ObjGet(src, "__ta_off__")
            src_bo = Float_ToInt(JSRT_GetPayload(src_off_v))
            src_bytes = Multiply(src_len, src_es)
            src_data = JSVM_AB_DataPtr(src_buf)
            clone_ab = JSVM_ArrayBufferCreate(src_bytes)
            clone_data = JSVM_AB_DataPtr(clone_ab)
            IfCondition And(NotEqual(src_data, 0), And(NotEqual(clone_data, 0), GreaterThan(src_bytes, 0))) ThenBlock: {
                MemoryCopy(clone_data, Add(src_data, src_bo), src_bytes)
            }
            src = JSVM_TypedArrayCreate(src_kind, clone_ab, 0, src_len)
        }
        i = 0
        WhileLoop LessThan(i, src_len) {
            JSBridge__Push(ta)
            JSBridge__Push(src)
            JSBridge__Push(i)
            JSBridge__Push(off)
            JSBridge__Push(src_len)
            IfCondition EqualTo(JSVM_IsTypedArray(src), 1) ThenBlock: {
                v = JSVM_TA_Get(src, i)
            } ElseBlock: {
                v = JSVM__ArrayLikeGet(src, i)
            }
            src_len = JSBridge__Pop()
            off = JSBridge__Pop()
            i = JSBridge__Pop()
            src = JSBridge__Pop()
            ta = JSBridge__Pop()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            JSVM_TA_Set(ta, Add(off, i), v)
            // M128e7de: ToNumber/ToBigInt abrupt from set src values
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            i = Add(i, 1)
        }
        ReturnValue(JSRT_Undefined())
    }
}

// TypedArray.prototype.subarray(begin, end)
Function.JSVM__NTASubarray {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        ta = recv
        IfCondition EqualTo(JSVM_IsTypedArray(ta), 0) ThenBlock: {
            ta = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsTypedArray(ta), 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        len = JSVM_TA_Length(ta)
        begin = 0
        end = len
        IfCondition GreaterThan(argc, 0) ThenBlock: {
            begin = Float_ToInt(JSRT_ToNumber(Dereference(args)))
            IfCondition LessThan(begin, 0) ThenBlock: {
                begin = Add(len, begin)
                IfCondition LessThan(begin, 0) ThenBlock: { begin = 0 }
            }
            IfCondition GreaterThan(begin, len) ThenBlock: { begin = len }
        }
        IfCondition GreaterThan(argc, 1) ThenBlock: {
            end = Float_ToInt(JSRT_ToNumber(Dereference(Add(args, 8))))
            IfCondition LessThan(end, 0) ThenBlock: {
                end = Add(len, end)
                IfCondition LessThan(end, 0) ThenBlock: { end = 0 }
            }
            IfCondition GreaterThan(end, len) ThenBlock: { end = len }
        }
        IfCondition LessThan(end, begin) ThenBlock: { end = begin }
        kind = JSVM_TA_Kind(ta)
        es = JSVM_TA_ElementSize(kind)
        buf = JSRT_ObjGet(ta, "__ta_buf__")
        off_v = JSRT_ObjGet(ta, "__ta_off__")
        base = Float_ToInt(JSRT_GetPayload(off_v))
        nlen = Subtract(end, begin)
        nbo = Add(base, Multiply(begin, es))
        // M128e7d3: TypedArraySpeciesCreate(O, « buffer, byteOffset, length »)
        species_ctor = 0
        use_species = 0
        IfCondition NotEqual(JSVMSymbol.species, 0) ThenBlock: {
            JSRT__Push(ta)
            JSRT__Push(buf)
            JSRT__Push(nbo)
            JSRT__Push(nlen)
            JSRT__Push(kind)
            ctor = JSVM__GetProperty(ta, "constructor")
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                kind = JSRT__Pop()
                nlen = JSRT__Pop()
                nbo = JSRT__Pop()
                buf = JSRT__Pop()
                ta = JSRT__Pop()
                ReturnValue(JSRT_Undefined())
            }
            kind = JSRT__Pop()
            nlen = JSRT__Pop()
            nbo = JSRT__Pop()
            buf = JSRT__Pop()
            ta = JSRT__Pop()
            ct = JSRT_GetType(ctor)
            IfCondition Or(EqualTo(ct, JSType.FUNCTION), EqualTo(ct, JSType.OBJECT)) ThenBlock: {
                sk = JSVM_SymbolToKey(JSVMSymbol.species)
                JSRT__Push(ta)
                JSRT__Push(buf)
                JSRT__Push(nbo)
                JSRT__Push(nlen)
                JSRT__Push(kind)
                JSRT__Push(ctor)
                species = JSVM__GetProperty(ctor, sk)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ctor = JSRT__Pop()
                    kind = JSRT__Pop()
                    nlen = JSRT__Pop()
                    nbo = JSRT__Pop()
                    buf = JSRT__Pop()
                    ta = JSRT__Pop()
                    ReturnValue(JSRT_Undefined())
                }
                ctor = JSRT__Pop()
                kind = JSRT__Pop()
                nlen = JSRT__Pop()
                nbo = JSRT__Pop()
                buf = JSRT__Pop()
                ta = JSRT__Pop()
                st = JSRT_GetType(species)
                IfCondition And(NotEqual(st, JSType.UNDEFINED), NotEqual(st, JSType.NULL)) ThenBlock: {
                    species_ctor = species
                    use_species = 1
                }
            }
        }
        IfCondition EqualTo(use_species, 1) ThenBlock: {
            IfCondition EqualTo(JSVM__IsConstructor(species_ctor), 0) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "species is not a constructor")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            // Construct(species, buffer, byteOffset, length)
            StoreValue(JSVMCallBuf.buf, buf)
            StoreValue(Add(JSVMCallBuf.buf, 8), JSRT_CreateNumber(nbo))
            StoreValue(Add(JSVMCallBuf.buf, 16), JSRT_CreateNumber(nlen))
            nta = JSVM__Construct(species_ctor, JSVMCallBuf.buf, 3)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            ReturnValue(nta)
        }
        // default: same-kind view on same buffer
        nta = JSVM_TypedArrayCreate(kind, buf, nbo, nlen)
        pr = JSRT_ObjGet(ta, "__proto__")
        IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
            JSRT_ObjSet(nta, "__proto__", pr)
        }
        ReturnValue(nta)
    }
}

// DataView constructor
Function.JSVM__NDataViewCtor {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        // M128e7dl: NewTarget required
        nt = JSVM__GetGlobal("__new_target__")
        IfCondition NotEqual(JSRT_GetType(nt), JSType.FUNCTION) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "DataView constructor requires 'new'")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition LessThan(argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "DataView requires ArrayBuffer")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        buf = Dereference(args)
        IfCondition EqualTo(JSVM_IsArrayBuffer(buf), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "DataView buffer must be ArrayBuffer")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        bl = JSVM_AB_ByteLength(buf)
        // ToIndex(byteOffset); missing/undefined → 0
        bo = 0
        IfCondition GreaterThan(argc, 1) ThenBlock: {
            bo = JSVM_ToIndex(Dereference(Add(args, 8)))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            IfCondition LessThan(bo, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        }
        view_len = Subtract(bl, bo)
        IfCondition GreaterThan(argc, 2) ThenBlock: {
            IfCondition NotEqual(JSRT_GetType(Dereference(Add(args, 16))), JSType.UNDEFINED) ThenBlock: {
                view_len = JSVM_ToIndex(Dereference(Add(args, 16)))
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
                IfCondition LessThan(view_len, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            }
        }
        IfCondition Or(LessThan(bo, 0), Or(LessThan(view_len, 0), GreaterThan(Add(bo, view_len), bl))) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid DataView range")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        dv = JSRT_CreateObject()
        JSRT_ObjSet(dv, "__dv_buf__", buf)
        JSRT_ObjSet(dv, "__dv_off__", JSRT_CreateNumber(bo))
        JSRT_ObjSet(dv, "__dv_len__", JSRT_CreateNumber(view_len))
        // M128e7d9: buffer/byteOffset/byteLength are accessors on DataView.prototype
        pr = JSRT_ObjGet(nt, "prototype")
        IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
            JSRT_ObjSet(dv, "__proto__", pr)
        }
        ReturnValue(dv)
    }
}

// DataView getUint8 / setUint8 as templates for others
Function.JSVM__NDVGetUint8 {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        dv = recv
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            dv = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        boff = 0
        IfCondition GreaterThan(argc, 0) ThenBlock: {
            boff = Float_ToInt(JSRT_ToNumber(Dereference(args)))
        }
        buf = JSRT_ObjGet(dv, "__dv_buf__")
        base = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_off__")))
        vlen = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_len__")))
        IfCondition Or(LessThan(boff, 0), GreaterThan(Add(boff, 1), vlen)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Offset outside DataView")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        data = JSVM_AB_DataPtr(buf)
        b = GetByte(Add(data, Add(base, boff)), 0)
        ReturnValue(JSRT_CreateNumber(b))
    }
}

Function.JSVM__NDVSetUint8 {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        dv = recv
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            dv = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition LessThan(argc, 2) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        boff = Float_ToInt(JSRT_ToNumber(Dereference(args)))
        val = Float_ToInt(JSRT_ToNumber(Dereference(Add(args, 8))))
        buf = JSRT_ObjGet(dv, "__dv_buf__")
        base = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_off__")))
        vlen = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_len__")))
        IfCondition Or(LessThan(boff, 0), GreaterThan(Add(boff, 1), vlen)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Offset outside DataView")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        data = JSVM_AB_DataPtr(buf)
        SetByte(Add(data, Add(base, boff)), 0, BitwiseAnd(val, 255))
        ReturnValue(JSRT_Undefined())
    }
}

// M128e7dl: ES ToIndex — ToIntegerOrInfinity then reject <0 and +∞.
// Returns index >= 0; on abrupt/RangeError sets exception and returns -1.
Function.JSVM_ToIndex {
    Input: val: Address
    Output: Integer
    Body: {
        nbits = JSRT_ToNumber(val)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(-1)
        }
        // NaN → +0
        IfCondition EqualTo(Float_Ne(nbits, nbits), 1) ThenBlock: {
            ReturnValue(0)
        }
        // +Infinity / -Infinity → RangeError (ToIndex)
        pos_inf = 9218868437227405312
        IfCondition EqualTo(nbits, pos_inf) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid index")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(-1)
        }
        // -Infinity bits (0xFFF0000000000000 as unsigned → signed wrap)
        neg_inf = -4503599627370496
        IfCondition EqualTo(nbits, neg_inf) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid index")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(-1)
        }
        // also detect -Inf via CreateFloat path used elsewhere
        neg_inf2 = 18442240474082181120
        IfCondition EqualTo(nbits, neg_inf2) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid index")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(-1)
        }
        // ToIntegerOrInfinity: trunc toward 0
        bo = Float_ToInt(nbits)
        IfCondition LessThan(bo, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid index")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(-1)
        }
        ReturnValue(bo)
    }
}

// Generic DataView get/set for 1/2/4/8-byte kinds.
// kind: 0=u8 1=i8 2=u16 3=i16 4=u32 5=i32 6=f32 7=f64
//       8=BigInt64 9=BigUint64 10=Float16
// littleEndian arg for multi-byte kinds (default false = big-endian).
Function.JSVM__NDVGetN {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        dv = recv
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            dv = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            // brand check TypeError
            terr = JSVM_CreateTypedError("TypeError", "DataView method requires DataView")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // ToIndex(byteOffset); missing → ToIndex(undefined) = 0
        boff = 0
        IfCondition GreaterThan(argc, 0) ThenBlock: {
            boff = JSVM_ToIndex(Dereference(args))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            IfCondition LessThan(boff, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        }
        // M128e7dk: littleEndian for all multi-byte kinds (default BE)
        le = 0
        IfCondition And(GreaterThan(argc, 1), GreaterThan(kind, 1)) ThenBlock: {
            le = JSRT_IsTruthy(Dereference(Add(args, 8)))
        }
        es = 1
        IfCondition Or(EqualTo(kind, 2), EqualTo(kind, 3)) ThenBlock: { es = 2 }
        IfCondition EqualTo(kind, 10) ThenBlock: { es = 2 }
        IfCondition Or(EqualTo(kind, 4), Or(EqualTo(kind, 5), EqualTo(kind, 6))) ThenBlock: { es = 4 }
        IfCondition Or(EqualTo(kind, 7), Or(EqualTo(kind, 8), EqualTo(kind, 9))) ThenBlock: { es = 8 }
        buf = JSRT_ObjGet(dv, "__dv_buf__")
        base = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_off__")))
        vlen = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_len__")))
        IfCondition Or(LessThan(boff, 0), GreaterThan(Add(boff, es), vlen)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Offset outside DataView")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        data = JSVM_AB_DataPtr(buf)
        p = Add(data, Add(base, boff))
        IfCondition EqualTo(kind, 0) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(GetByte(p, 0)))
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            b = GetByte(p, 0)
            IfCondition GreaterThan(b, 127) ThenBlock: { b = Subtract(b, 256) }
            ReturnValue(JSRT_CreateNumber(b))
        }
        // u16 / i16 endian-aware
        IfCondition Or(EqualTo(kind, 2), EqualTo(kind, 3)) ThenBlock: {
            IfCondition EqualTo(le, 1) ThenBlock: {
                v = Add(GetByte(p, 0), Multiply(GetByte(p, 1), 256))
            } ElseBlock: {
                v = Add(GetByte(p, 1), Multiply(GetByte(p, 0), 256))
            }
            IfCondition EqualTo(kind, 3) ThenBlock: {
                IfCondition GreaterThan(v, 32767) ThenBlock: { v = Subtract(v, 65536) }
            }
            ReturnValue(JSRT_CreateNumber(v))
        }
        // u32 / i32 endian-aware
        IfCondition Or(EqualTo(kind, 4), EqualTo(kind, 5)) ThenBlock: {
            IfCondition EqualTo(le, 1) ThenBlock: {
                b0 = GetByte(p, 0)
                b1 = GetByte(p, 1)
                b2 = GetByte(p, 2)
                b3 = GetByte(p, 3)
            } ElseBlock: {
                b0 = GetByte(p, 3)
                b1 = GetByte(p, 2)
                b2 = GetByte(p, 1)
                b3 = GetByte(p, 0)
            }
            v = b0
            v = Add(v, Multiply(b1, 256))
            v = Add(v, Multiply(b2, 65536))
            v = Add(v, Multiply(b3, 16777216))
            IfCondition EqualTo(kind, 5) ThenBlock: {
                IfCondition GreaterEqual(v, 2147483648) ThenBlock: {
                    v = Subtract(v, 4294967296)
                }
                ReturnValue(JSRT_CreateNumber(v))
            }
            // u32: use float path so values >2^31 stay exact as IEEE int
            vf = Float_FromInt(b0)
            vf = Float_Add(vf, Float_FromInt(Multiply(b1, 256)))
            vf = Float_Add(vf, Float_FromInt(Multiply(b2, 65536)))
            vf = Float_Add(vf, Float_Mul(Float_FromInt(b3), Float_FromInt(16777216)))
            ReturnValue(JSRT_CreateFloat(vf))
        }
        // f32: endian-aware IEEE bits → number
        IfCondition EqualTo(kind, 6) ThenBlock: {
            IfCondition EqualTo(le, 1) ThenBlock: {
                bits = GetByte(p, 0)
                bits = Add(bits, Multiply(GetByte(p, 1), 256))
                bits = Add(bits, Multiply(GetByte(p, 2), 65536))
                bits = Add(bits, Multiply(GetByte(p, 3), 16777216))
            } ElseBlock: {
                bits = GetByte(p, 3)
                bits = Add(bits, Multiply(GetByte(p, 2), 256))
                bits = Add(bits, Multiply(GetByte(p, 1), 65536))
                bits = Add(bits, Multiply(GetByte(p, 0), 16777216))
            }
            ReturnValue(JSVM_F32BitsToNumber(bits))
        }
        // f64 endian-aware
        IfCondition EqualTo(kind, 7) ThenBlock: {
            bits = 0
            bi = 0
            WhileLoop LessThan(bi, 8) {
                IfCondition EqualTo(le, 1) ThenBlock: {
                    sh = GetByte(p, bi)
                } ElseBlock: {
                    sh = GetByte(p, Subtract(7, bi))
                }
                sj = 0
                WhileLoop LessThan(sj, bi) {
                    sh = Multiply(sh, 256)
                    sj = Add(sj, 1)
                }
                bits = Add(bits, sh)
                bi = Add(bi, 1)
            }
            ReturnValue(JSRT_CreateFloat(bits))
        }
        // BigInt64 / BigUint64 — 8 bytes, endian-aware
        IfCondition Or(EqualTo(kind, 8), EqualTo(kind, 9)) ThenBlock: {
            // assemble LE limb order: byte[i] for LE is i, for BE is 7-i
            tw = BI__Alloc(2)
            IfCondition EqualTo(tw, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBigIntZero())
            }
            StoreValue(Add(tw, 8), 2)
            bi = 0
            lo = 0
            hi = 0
            WhileLoop LessThan(bi, 4) {
                IfCondition EqualTo(le, 1) ThenBlock: {
                    bb = GetByte(p, bi)
                } ElseBlock: {
                    bb = GetByte(p, Subtract(7, bi))
                }
                sh = bb
                sj = 0
                WhileLoop LessThan(sj, bi) {
                    sh = Multiply(sh, 256)
                    sj = Add(sj, 1)
                }
                lo = Add(lo, sh)
                bi = Add(bi, 1)
            }
            bi = 0
            WhileLoop LessThan(bi, 4) {
                IfCondition EqualTo(le, 1) ThenBlock: {
                    bb = GetByte(p, Add(bi, 4))
                } ElseBlock: {
                    bb = GetByte(p, Subtract(3, bi))
                }
                sh = bb
                sj = 0
                WhileLoop LessThan(sj, bi) {
                    sh = Multiply(sh, 256)
                    sj = Add(sj, 1)
                }
                hi = Add(hi, sh)
                bi = Add(bi, 1)
            }
            BI__SetLimb(tw, 0, BitwiseAnd(lo, BIConst.MASK))
            BI__SetLimb(tw, 1, BitwiseAnd(hi, BIConst.MASK))
            IfCondition EqualTo(kind, 9) ThenBlock: {
                // unsigned: keep two's limbs as positive BigInt
                rbi = BI__Alloc(2)
                IfCondition EqualTo(rbi, 0) ThenBlock: {
                    ReturnValue(JSRT_CreateBigIntZero())
                }
                StoreValue(rbi, 0)
                StoreValue(Add(rbi, 8), 2)
                BI__SetLimb(rbi, 0, BI__Limb(tw, 0))
                BI__SetLimb(rbi, 1, BI__Limb(tw, 1))
                BI__Normalize(rbi)
                val = JSRT__AllocValue()
                IfCondition EqualTo(val, 0) ThenBlock: {
                    ReturnValue(JSRT_CreateBigIntZero())
                }
                StoreValue(val, JSType.BIGINT)
                StoreValue(Add(val, 8), rbi)
                ReturnValue(val)
            }
            signed = BI__FromTwos(tw)
            IfCondition EqualTo(signed, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBigIntZero())
            }
            BI__Normalize(signed)
            val = JSRT__AllocValue()
            IfCondition EqualTo(val, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBigIntZero())
            }
            StoreValue(val, JSType.BIGINT)
            StoreValue(Add(val, 8), signed)
            ReturnValue(val)
        }
        // Float16 — 2 bytes, endian-aware; promote to f32 then JS number
        IfCondition EqualTo(kind, 10) ThenBlock: {
            IfCondition EqualTo(le, 1) ThenBlock: {
                hbits = Add(GetByte(p, 0), Multiply(GetByte(p, 1), 256))
            } ElseBlock: {
                hbits = Add(GetByte(p, 1), Multiply(GetByte(p, 0), 256))
            }
            sign = BitwiseAnd(Divide(hbits, 32768), 1)
            exp = BitwiseAnd(Divide(hbits, 1024), 31)
            man = BitwiseAnd(hbits, 1023)
            // f16 → f32 bits then JSVM_F32BitsToNumber
            f32 = 0
            IfCondition EqualTo(exp, 31) ThenBlock: {
                // Inf / NaN
                f32 = 2139095040
                IfCondition NotEqual(man, 0) ThenBlock: {
                    f32 = Add(f32, Multiply(man, 8192))
                }
            } ElseBlock: {
                IfCondition EqualTo(exp, 0) ThenBlock: {
                    IfCondition EqualTo(man, 0) ThenBlock: {
                        f32 = 0
                    } ElseBlock: {
                        // subnormal: approx as 0 for MVP
                        f32 = 0
                    }
                } ElseBlock: {
                    // normal: f32_exp = exp - 15 + 127 = exp + 112
                    f32 = Multiply(Add(exp, 112), 8388608)
                    f32 = Add(f32, Multiply(man, 8192))
                }
            }
            IfCondition EqualTo(sign, 1) ThenBlock: {
                f32 = Add(f32, 2147483648)
            }
            ReturnValue(JSVM_F32BitsToNumber(f32))
        }
        ReturnValue(JSRT_CreateNumber(0))
    }
}

Function.JSVM__NDVSetN {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        dv = recv
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            dv = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "DataView method requires DataView")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // M128e7dl: ToIndex(byteOffset) first (RangeError before value conversion)
        boff = 0
        IfCondition GreaterThan(argc, 0) ThenBlock: {
            boff = JSVM_ToIndex(Dereference(args))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            IfCondition LessThan(boff, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        }
        // missing value → undefined (ToNumber/ToBigInt after ToIndex)
        save_val = JSRT_Undefined()
        IfCondition GreaterThan(argc, 1) ThenBlock: {
            save_val = Dereference(Add(args, 8))
        }
        le = 0
        IfCondition And(GreaterThan(argc, 2), GreaterThan(kind, 1)) ThenBlock: {
            le = JSRT_IsTruthy(Dereference(Add(args, 16)))
        }
        es = 1
        IfCondition Or(EqualTo(kind, 2), EqualTo(kind, 3)) ThenBlock: { es = 2 }
        IfCondition EqualTo(kind, 10) ThenBlock: { es = 2 }
        IfCondition Or(EqualTo(kind, 4), Or(EqualTo(kind, 5), EqualTo(kind, 6))) ThenBlock: { es = 4 }
        IfCondition Or(EqualTo(kind, 7), Or(EqualTo(kind, 8), EqualTo(kind, 9))) ThenBlock: { es = 8 }
        // Convert value BEFORE range check (range-check-after-value-conversion)
        nbits = 0
        ni = 0
        bits = 0
        lo = 0
        hi = 0
        IfCondition Or(EqualTo(kind, 8), EqualTo(kind, 9)) ThenBlock: {
            JSBridge__Push(kind)
            JSBridge__Push(le)
            JSBridge__Push(boff)
            JSBridge__Push(es)
            bv = JSRT_ToBigInt(save_val)
            es = JSBridge__Pop()
            boff = JSBridge__Pop()
            le = JSBridge__Pop()
            kind = JSBridge__Pop()
            IfCondition EqualTo(bv, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            JSBridge__Push(le)
            JSBridge__Push(boff)
            JSBridge__Push(es)
            IfCondition EqualTo(kind, 8) ThenBlock: {
                trunc = JSRT_BigIntAsIntN(64, bv)
            } ElseBlock: {
                trunc = JSRT_BigIntAsUintN(64, bv)
            }
            es = JSBridge__Pop()
            boff = JSBridge__Pop()
            le = JSBridge__Pop()
            IfCondition EqualTo(trunc, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            JSBridge__Push(le)
            JSBridge__Push(boff)
            JSBridge__Push(es)
            tbi = Dereference(Add(trunc, 8))
            tw = BI__ToTwos(tbi, 2)
            es = JSBridge__Pop()
            boff = JSBridge__Pop()
            le = JSBridge__Pop()
            IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            lo = BI__Limb(tw, 0)
            hi = BI__Limb(tw, 1)
        } ElseBlock: {
            IfCondition EqualTo(kind, 10) ThenBlock: {
                JSBridge__Push(le)
                JSBridge__Push(boff)
                JSBridge__Push(es)
                bits = JSVM_NumberToF32Bits(save_val)
                es = JSBridge__Pop()
                boff = JSBridge__Pop()
                le = JSBridge__Pop()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            } ElseBlock: {
                IfCondition EqualTo(kind, 6) ThenBlock: {
                    JSBridge__Push(le)
                    JSBridge__Push(boff)
                    JSBridge__Push(es)
                    bits = JSVM_NumberToF32Bits(save_val)
                    es = JSBridge__Pop()
                    boff = JSBridge__Pop()
                    le = JSBridge__Pop()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
                } ElseBlock: {
                    JSBridge__Push(kind)
                    JSBridge__Push(le)
                    JSBridge__Push(boff)
                    JSBridge__Push(es)
                    nbits = JSRT_ToNumber(save_val)
                    es = JSBridge__Pop()
                    boff = JSBridge__Pop()
                    le = JSBridge__Pop()
                    kind = JSBridge__Pop()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
                    ni = Float_ToInt(nbits)
                    IfCondition EqualTo(kind, 7) ThenBlock: {
                        nv = JSRT_CreateFloat(nbits)
                        bits = JSRT_GetPayload(nv)
                    }
                }
            }
        }
        // range check after value conversion
        buf = JSRT_ObjGet(dv, "__dv_buf__")
        base = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_off__")))
        vlen = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_len__")))
        IfCondition Or(LessThan(boff, 0), GreaterThan(Add(boff, es), vlen)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Offset outside DataView")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        data = JSVM_AB_DataPtr(buf)
        p = Add(data, Add(base, boff))
        // write BigInt64/BigUint64
        IfCondition Or(EqualTo(kind, 8), EqualTo(kind, 9)) ThenBlock: {
            bi = 0
            WhileLoop LessThan(bi, 4) {
                bb = BitwiseAnd(lo, 255)
                lo = Divide(lo, 256)
                IfCondition EqualTo(le, 1) ThenBlock: {
                    SetByte(p, bi, bb)
                } ElseBlock: {
                    SetByte(p, Subtract(7, bi), bb)
                }
                bi = Add(bi, 1)
            }
            bi = 0
            WhileLoop LessThan(bi, 4) {
                bb = BitwiseAnd(hi, 255)
                hi = Divide(hi, 256)
                IfCondition EqualTo(le, 1) ThenBlock: {
                    SetByte(p, Add(bi, 4), bb)
                } ElseBlock: {
                    SetByte(p, Subtract(3, bi), bb)
                }
                bi = Add(bi, 1)
            }
            ReturnValue(JSRT_Undefined())
        }
        // write Float16 (bits still hold f32; convert to f16)
        IfCondition EqualTo(kind, 10) ThenBlock: {
            sign = BitwiseAnd(Divide(bits, 2147483648), 1)
            exp = BitwiseAnd(Divide(bits, 8388608), 255)
            man = BitwiseAnd(bits, 8388607)
            hbits = 0
            IfCondition EqualTo(exp, 255) ThenBlock: {
                hbits = 31744
                IfCondition NotEqual(man, 0) ThenBlock: {
                    hbits = Add(hbits, 512)
                }
            } ElseBlock: {
                IfCondition GreaterThan(exp, 142) ThenBlock: {
                    hbits = 31744
                } ElseBlock: {
                    IfCondition LessThan(exp, 113) ThenBlock: {
                        hbits = 0
                    } ElseBlock: {
                        hbits = Multiply(Subtract(exp, 112), 1024)
                        hbits = Add(hbits, BitwiseAnd(Divide(man, 8192), 1023))
                    }
                }
            }
            IfCondition EqualTo(sign, 1) ThenBlock: {
                hbits = Add(hbits, 32768)
            }
            IfCondition EqualTo(le, 1) ThenBlock: {
                SetByte(p, 0, BitwiseAnd(hbits, 255))
                SetByte(p, 1, BitwiseAnd(Divide(hbits, 256), 255))
            } ElseBlock: {
                SetByte(p, 1, BitwiseAnd(hbits, 255))
                SetByte(p, 0, BitwiseAnd(Divide(hbits, 256), 255))
            }
            ReturnValue(JSRT_Undefined())
        }
        IfCondition Or(EqualTo(kind, 0), EqualTo(kind, 1)) ThenBlock: {
            // M128e7dk: map negative ToInt to two's-complement byte
            u = ni
            IfCondition LessThan(u, 0) ThenBlock: { u = Add(u, 256) }
            SetByte(p, 0, BitwiseAnd(u, 255))
            ReturnValue(JSRT_Undefined())
        }
        IfCondition Or(EqualTo(kind, 2), EqualTo(kind, 3)) ThenBlock: {
            u = ni
            IfCondition LessThan(u, 0) ThenBlock: { u = Add(u, 65536) }
            u = BitwiseAnd(u, 65535)
            b0 = BitwiseAnd(u, 255)
            b1 = BitwiseAnd(Divide(u, 256), 255)
            IfCondition EqualTo(le, 1) ThenBlock: {
                SetByte(p, 0, b0)
                SetByte(p, 1, b1)
            } ElseBlock: {
                SetByte(p, 1, b0)
                SetByte(p, 0, b1)
            }
            ReturnValue(JSRT_Undefined())
        }
        IfCondition Or(EqualTo(kind, 4), EqualTo(kind, 5)) ThenBlock: {
            // M128e7dk: negative → +2^32 so Divide/BitwiseAnd see unsigned pattern
            u = ni
            IfCondition LessThan(u, 0) ThenBlock: { u = Add(u, 4294967296) }
            b0 = BitwiseAnd(u, 255)
            u = Divide(u, 256)
            b1 = BitwiseAnd(u, 255)
            u = Divide(u, 256)
            b2 = BitwiseAnd(u, 255)
            u = Divide(u, 256)
            b3 = BitwiseAnd(u, 255)
            IfCondition EqualTo(le, 1) ThenBlock: {
                SetByte(p, 0, b0)
                SetByte(p, 1, b1)
                SetByte(p, 2, b2)
                SetByte(p, 3, b3)
            } ElseBlock: {
                SetByte(p, 3, b0)
                SetByte(p, 2, b1)
                SetByte(p, 1, b2)
                SetByte(p, 0, b3)
            }
            ReturnValue(JSRT_Undefined())
        }
        IfCondition EqualTo(kind, 6) ThenBlock: {
            b0 = BitwiseAnd(bits, 255)
            tmpu = Divide(bits, 256)
            b1 = BitwiseAnd(tmpu, 255)
            tmpu = Divide(tmpu, 256)
            b2 = BitwiseAnd(tmpu, 255)
            tmpu = Divide(tmpu, 256)
            b3 = BitwiseAnd(tmpu, 255)
            IfCondition EqualTo(le, 1) ThenBlock: {
                SetByte(p, 0, b0)
                SetByte(p, 1, b1)
                SetByte(p, 2, b2)
                SetByte(p, 3, b3)
            } ElseBlock: {
                SetByte(p, 3, b0)
                SetByte(p, 2, b1)
                SetByte(p, 1, b2)
                SetByte(p, 0, b3)
            }
            ReturnValue(JSRT_Undefined())
        }
        // f64
        bi = 0
        tmp = bits
        WhileLoop LessThan(bi, 8) {
            bb = BitwiseAnd(tmp, 255)
            tmp = Divide(tmp, 256)
            IfCondition EqualTo(le, 1) ThenBlock: {
                SetByte(p, bi, bb)
            } ElseBlock: {
                SetByte(p, Subtract(7, bi), bb)
            }
            bi = Add(bi, 1)
        }
        ReturnValue(JSRT_Undefined())
    }
}

// Install methods once on %TypedArray%.prototype (shared)
Function.JSVM__InstallTAProtoMethods {
    Input: ta_proto: Address
    Output: Integer
    Body: {
        proto = ta_proto
        // M128e7d8: length / byteLength / byteOffset / buffer accessors
        JSVM__InstallProtoGetter(proto, "length", JSNativeID.TA_GET_LENGTH, "get length")
        JSVM__InstallProtoGetter(proto, "byteLength", JSNativeID.TA_GET_BYTE_LENGTH, "get byteLength")
        JSVM__InstallProtoGetter(proto, "byteOffset", JSNativeID.TA_GET_BYTE_OFFSET, "get byteOffset")
        JSVM__InstallProtoGetter(proto, "buffer", JSNativeID.TA_GET_BUFFER, "get buffer")
        // helper: install one method name/id/len onto proto
        // (unrolled for Ailang)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.TA_SET, "set", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "set", mf)
        JSBridge__SetAttrBits(proto, "set", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.TA_SUBARRAY, "subarray", 2)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "subarray", mf)
        JSBridge__SetAttrBits(proto, "subarray", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_MAP, "map", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "map", mf)
        JSBridge__SetAttrBits(proto, "map", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FILTER, "filter", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "filter", mf)
        JSBridge__SetAttrBits(proto, "filter", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FOR_EACH, "forEach", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "forEach", mf)
        JSBridge__SetAttrBits(proto, "forEach", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_EVERY, "every", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "every", mf)
        JSBridge__SetAttrBits(proto, "every", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_SOME, "some", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "some", mf)
        JSBridge__SetAttrBits(proto, "some", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FIND, "find", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "find", mf)
        JSBridge__SetAttrBits(proto, "find", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FIND_INDEX, "findIndex", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "findIndex", mf)
        JSBridge__SetAttrBits(proto, "findIndex", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FIND_LAST, "findLast", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "findLast", mf)
        JSBridge__SetAttrBits(proto, "findLast", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FIND_LAST_INDEX, "findLastIndex", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "findLastIndex", mf)
        JSBridge__SetAttrBits(proto, "findLastIndex", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_REDUCE, "reduce", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "reduce", mf)
        JSBridge__SetAttrBits(proto, "reduce", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_REDUCE_RIGHT, "reduceRight", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "reduceRight", mf)
        JSBridge__SetAttrBits(proto, "reduceRight", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_INDEX_OF, "indexOf", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "indexOf", mf)
        JSBridge__SetAttrBits(proto, "indexOf", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_LAST_INDEX_OF, "lastIndexOf", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "lastIndexOf", mf)
        JSBridge__SetAttrBits(proto, "lastIndexOf", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_INCLUDES, "includes", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "includes", mf)
        JSBridge__SetAttrBits(proto, "includes", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_JOIN, "join", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "join", mf)
        JSBridge__SetAttrBits(proto, "join", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_TO_STRING, "toString", 0)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "toString", mf)
        JSBridge__SetAttrBits(proto, "toString", 5)
        // toLocaleString → same as toString/join for MVP
        JSRT_ObjSet(proto, "toLocaleString", mf)
        JSBridge__SetAttrBits(proto, "toLocaleString", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FILL, "fill", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "fill", mf)
        JSBridge__SetAttrBits(proto, "fill", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_COPY_WITHIN, "copyWithin", 2)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "copyWithin", mf)
        JSBridge__SetAttrBits(proto, "copyWithin", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_REVERSE, "reverse", 0)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "reverse", mf)
        JSBridge__SetAttrBits(proto, "reverse", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_SLICE, "slice", 2)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "slice", mf)
        JSBridge__SetAttrBits(proto, "slice", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_SORT, "sort", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "sort", mf)
        JSBridge__SetAttrBits(proto, "sort", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_AT, "at", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "at", mf)
        JSBridge__SetAttrBits(proto, "at", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_VALUES, "values", 0)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "values", mf)
        JSBridge__SetAttrBits(proto, "values", 5)
        IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
            iks = JSVM_SymbolToKey(JSVMSymbol.iterator)
            IfCondition NotEqual(iks, 0) ThenBlock: {
                JSRT_ObjSet(proto, iks, mf)
                JSBridge__SetAttrBits(proto, iks, 5)
            }
        }
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_KEYS, "keys", 0)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "keys", mf)
        JSBridge__SetAttrBits(proto, "keys", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_ENTRIES, "entries", 0)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "entries", mf)
        JSBridge__SetAttrBits(proto, "entries", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_WITH, "with", 2)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "with", mf)
        JSBridge__SetAttrBits(proto, "with", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_TO_REVERSED, "toReversed", 0)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "toReversed", mf)
        JSBridge__SetAttrBits(proto, "toReversed", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_TO_SORTED, "toSorted", 1)
        mf = JSVM__MarkTAMethod(mf)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "toSorted", mf)
        JSBridge__SetAttrBits(proto, "toSorted", 5)
        // Symbol.toStringTag = "TypedArray" on %TypedArray%.prototype
        IfCondition NotEqual(JSVMSymbol.toStringTag, 0) ThenBlock: {
            tts = JSVM_SymbolToKey(JSVMSymbol.toStringTag)
            IfCondition NotEqual(tts, 0) ThenBlock: {
                JSRT_ObjSet(proto, tts, JSRT_CreateString("TypedArray"))
                JSBridge__SetAttrBits(proto, tts, 0)
            }
        }
        ReturnValue(1)
    }
}

// Install one TypedArray ctor; methods live on shared ta_proto.
// ta_base = %TypedArray% intrinsic (Function [[Prototype]] of each ctor).
Function.JSVM__InstallOneTA {
    Input: kind: Integer
    Input: name: Address
    Input: nid: Integer
    Input: bpe: Integer
    Input: ta_proto: Address
    Input: ta_base: Address
    Output: Address
    Body: {
        save_name = name
        save_nid = nid
        save_bpe = bpe
        save_tp = ta_proto
        save_base = ta_base
        ctor = JSBridge__CreateNativeFunc(save_nid, save_name, 3)
        JSVM__SetGlobal(save_name, ctor)
        // [[Prototype]] of ctor = %TypedArray% so Object.getPrototypeOf(Int8Array) works
        IfCondition EqualTo(JSRT_GetType(save_base), JSType.FUNCTION) ThenBlock: {
            JSRT_ObjSet(ctor, "__proto__", save_base)
        }
        JSRT_ObjSet(ctor, "BYTES_PER_ELEMENT", JSRT_CreateNumber(save_bpe))
        JSBridge__SetAttrBits(ctor, "BYTES_PER_ELEMENT", 0)
        // Symbol.species data property → this constructor (ES getter returns this)
        IfCondition NotEqual(JSVMSymbol.species, 0) ThenBlock: {
            sk = JSVM_SymbolToKey(JSVMSymbol.species)
            IfCondition NotEqual(sk, 0) ThenBlock: {
                JSRT_ObjSet(ctor, sk, ctor)
                JSBridge__SetAttrBits(ctor, sk, 0)
            }
        }
        proto = JSRT_ObjGet(ctor, "prototype")
        IfCondition EqualTo(JSRT_GetType(proto), JSType.OBJECT) ThenBlock: {
            // [[Prototype]] = %TypedArray%.prototype
            IfCondition EqualTo(JSRT_GetType(save_tp), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(proto, "__proto__", save_tp)
            } ElseBlock: {
                IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                    JSRT_ObjSet(proto, "__proto__", JSRTState.object_proto)
                }
            }
            JSRT_ObjSet(proto, "BYTES_PER_ELEMENT", JSRT_CreateNumber(save_bpe))
            JSBridge__SetAttrBits(proto, "BYTES_PER_ELEMENT", 0)
            // W+C so tests may reassign sample.constructor for species
            JSRT_ObjSet(proto, "constructor", ctor)
            JSBridge__SetAttrBits(proto, "constructor", 5)
        }
        // M128e7d2: static from / of (TA_* IDs — require constructor this)
        JSRT__Push(ctor)
        mf = JSBridge__CreateNativeFunc(JSNativeID.TA_FROM, "from", 1)
        ctor = JSRT__Pop()
        JSRT_ObjSet(ctor, "from", mf)
        JSBridge__SetAttrBits(ctor, "from", 5)
        JSRT__Push(ctor)
        mf = JSBridge__CreateNativeFunc(JSNativeID.TA_OF, "of", 0)
        ctor = JSRT__Pop()
        JSRT_ObjSet(ctor, "of", mf)
        JSBridge__SetAttrBits(ctor, "of", 5)
        ReturnValue(ctor)
    }
}

// %TypedArray%.from — this must be constructor; Construct + fill
Function.JSVM__NTAFrom {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        this_c = JSVM__GetGlobal("this")
        IfCondition EqualTo(JSVM__IsConstructor(this_c), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "TypedArray.from requires new.target constructor")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // force this to constructor for ArrFrom species path
        JSVM__SetGlobal("this", this_c)
        // Reuse ArrFrom with species detection (no isArray on TA ctors)
        ReturnValue(JSBridge__NArrFrom(args, argc))
    }
}

// %TypedArray%.of — this must be constructor
Function.JSVM__NTAOf {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        this_c = JSVM__GetGlobal("this")
        IfCondition EqualTo(JSVM__IsConstructor(this_c), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "TypedArray.of requires constructor this")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        JSVM__SetGlobal("this", this_c)
        ReturnValue(JSBridge__NArrOf(args, argc))
    }
}

// Install ArrayBuffer, all TypedArray ctors, DataView into globals.
Function.JSVM_InstallTypedArrayBuiltins {
    Output: Integer
    Body: {
        // ArrayBuffer
        ab_ctor = JSBridge__CreateNativeFunc(JSNativeID.AB_CTOR, "ArrayBuffer", 1)
        JSVM__SetGlobal("ArrayBuffer", ab_ctor)
        JSRT__Push(ab_ctor)
        isv = JSBridge__CreateNativeFunc(JSNativeID.AB_IS_VIEW, "isView", 1)
        ab_ctor = JSRT__Pop()
        JSRT_ObjSet(ab_ctor, "isView", isv)
        JSBridge__SetAttrBits(ab_ctor, "isView", 5)
        ab_proto = JSRT_ObjGet(ab_ctor, "prototype")
        IfCondition EqualTo(JSRT_GetType(ab_proto), JSType.OBJECT) ThenBlock: {
            IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                JSRT_ObjSet(ab_proto, "__proto__", JSRTState.object_proto)
            }
            JSRT_ObjSet(ab_proto, "constructor", ab_ctor)
            JSBridge__SetAttrBits(ab_proto, "constructor", 1)
            JSRT__Push(ab_ctor)
            JSRT__Push(ab_proto)
            sl = JSBridge__CreateNativeFunc(JSNativeID.AB_SLICE, "slice", 2)
            ab_proto = JSRT__Pop()
            ab_ctor = JSRT__Pop()
            JSRT_ObjSet(ab_proto, "slice", sl)
            JSBridge__SetAttrBits(ab_proto, "slice", 5)
            // M128e7d8: byteLength accessor on ArrayBuffer.prototype
            JSVM__InstallProtoGetter(ab_proto, "byteLength", JSNativeID.AB_GET_BYTE_LENGTH, "get byteLength")
        }

        // %TypedArray%.prototype — shared methods (inherited by all TAs)
        ta_proto = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(ta_proto, "__proto__", JSRTState.object_proto)
        }
        JSVM__InstallTAProtoMethods(ta_proto)
        JSVM__SetGlobal("__TypedArrayProto__", ta_proto)

        // %TypedArray% intrinsic — Object.getPrototypeOf(Int8Array) === TypedArray
        // Not constructible via new (tests use prototype only). Use a dummy native id.
        ta_base = JSBridge__CreateNativeFunc(JSNativeID.TA_FROM, "TypedArray", 0)
        // point .prototype at shared methods object
        JSRT_ObjSet(ta_base, "prototype", ta_proto)
        JSBridge__SetAttrBits(ta_base, "prototype", 0)
        JSRT_ObjSet(ta_proto, "constructor", ta_base)
        JSBridge__SetAttrBits(ta_proto, "constructor", 1)
        // from/of on %TypedArray% itself
        JSRT__Push(ta_base)
        JSRT__Push(ta_proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.TA_FROM, "from", 1)
        ta_proto = JSRT__Pop()
        ta_base = JSRT__Pop()
        JSRT_ObjSet(ta_base, "from", mf)
        JSBridge__SetAttrBits(ta_base, "from", 5)
        JSRT__Push(ta_base)
        JSRT__Push(ta_proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.TA_OF, "of", 0)
        ta_proto = JSRT__Pop()
        ta_base = JSRT__Pop()
        JSRT_ObjSet(ta_base, "of", mf)
        JSBridge__SetAttrBits(ta_base, "of", 5)
        JSVM__SetGlobal("__TypedArray__", ta_base)

        // TypedArray constructors (kind 0..10)
        JSVM__InstallOneTA(0, "Int8Array", JSNativeID.TA_INT8, 1, ta_proto, ta_base)
        JSVM__InstallOneTA(1, "Uint8Array", JSNativeID.TA_UINT8, 1, ta_proto, ta_base)
        JSVM__InstallOneTA(2, "Uint8ClampedArray", JSNativeID.TA_UINT8C, 1, ta_proto, ta_base)
        JSVM__InstallOneTA(3, "Int16Array", JSNativeID.TA_INT16, 2, ta_proto, ta_base)
        JSVM__InstallOneTA(4, "Uint16Array", JSNativeID.TA_UINT16, 2, ta_proto, ta_base)
        JSVM__InstallOneTA(5, "Int32Array", JSNativeID.TA_INT32, 4, ta_proto, ta_base)
        JSVM__InstallOneTA(6, "Uint32Array", JSNativeID.TA_UINT32, 4, ta_proto, ta_base)
        JSVM__InstallOneTA(7, "Float32Array", JSNativeID.TA_FLOAT32, 4, ta_proto, ta_base)
        JSVM__InstallOneTA(8, "Float64Array", JSNativeID.TA_FLOAT64, 8, ta_proto, ta_base)
        JSVM__InstallOneTA(9, "BigInt64Array", JSNativeID.TA_BIGINT64, 8, ta_proto, ta_base)
        JSVM__InstallOneTA(10, "BigUint64Array", JSNativeID.TA_BIGUINT64, 8, ta_proto, ta_base)

        // DataView — length 1 (only buffer is required named arg)
        dv_ctor = JSBridge__CreateNativeFunc(JSNativeID.DV_CTOR, "DataView", 1)
        JSVM__SetGlobal("DataView", dv_ctor)
        // prototype {writable:false, enumerable:false, configurable:false}
        JSBridge__SetAttrBits(dv_ctor, "prototype", 0)
        dv_proto = JSRT_ObjGet(dv_ctor, "prototype")
        IfCondition EqualTo(JSRT_GetType(dv_proto), JSType.OBJECT) ThenBlock: {
            IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                JSRT_ObjSet(dv_proto, "__proto__", JSRTState.object_proto)
            }
            JSRT_ObjSet(dv_proto, "constructor", dv_ctor)
            JSBridge__SetAttrBits(dv_proto, "constructor", 1)
            // M128e7d9: buffer / byteOffset / byteLength accessors
            JSVM__InstallProtoGetter(dv_proto, "byteLength", JSNativeID.DV_GET_BYTE_LENGTH, "get byteLength")
            JSVM__InstallProtoGetter(dv_proto, "byteOffset", JSNativeID.DV_GET_BYTE_OFFSET, "get byteOffset")
            JSVM__InstallProtoGetter(dv_proto, "buffer", JSNativeID.DV_GET_BUFFER, "get buffer")
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_UINT8, "getUint8", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getUint8", mf)
            JSBridge__SetAttrBits(dv_proto, "getUint8", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_UINT8, "setUint8", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setUint8", mf)
            JSBridge__SetAttrBits(dv_proto, "setUint8", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_INT8, "getInt8", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getInt8", mf)
            JSBridge__SetAttrBits(dv_proto, "getInt8", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_INT8, "setInt8", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setInt8", mf)
            JSBridge__SetAttrBits(dv_proto, "setInt8", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_UINT16, "getUint16", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getUint16", mf)
            JSBridge__SetAttrBits(dv_proto, "getUint16", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_UINT16, "setUint16", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setUint16", mf)
            JSBridge__SetAttrBits(dv_proto, "setUint16", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_INT16, "getInt16", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getInt16", mf)
            JSBridge__SetAttrBits(dv_proto, "getInt16", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_INT16, "setInt16", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setInt16", mf)
            JSBridge__SetAttrBits(dv_proto, "setInt16", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_UINT32, "getUint32", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getUint32", mf)
            JSBridge__SetAttrBits(dv_proto, "getUint32", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_UINT32, "setUint32", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setUint32", mf)
            JSBridge__SetAttrBits(dv_proto, "setUint32", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_INT32, "getInt32", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getInt32", mf)
            JSBridge__SetAttrBits(dv_proto, "getInt32", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_INT32, "setInt32", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setInt32", mf)
            JSBridge__SetAttrBits(dv_proto, "setInt32", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
