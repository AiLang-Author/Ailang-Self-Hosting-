                    ReturnValue(JSRT_Undefined())
                }
                elen = Float_ToInt(nbits)
            }
            IfCondition LessThan(elen, 0) ThenBlock: { elen = 0 }
            ab = JSVM_ArrayBufferCreate(Multiply(elen, es))
            ta = JSVM_TypedArrayCreate(k, ab, 0, elen)
            i = 0
            WhileLoop LessThan(i, elen) {
                JSBridge__Push(ta)
                JSBridge__Push(a0)
                JSBridge__Push(i)
                JSBridge__Push(elen)
                JSBridge__Push(k)
                IfCondition EqualTo(JSRT_GetType(a0), JSType.ARRAY) ThenBlock: {
                    v = JSRT_ArrGet(a0, i)
                } ElseBlock: {
                    // ObjGet string key
                    // use IntToStr key
                    tmpk = JSRT__IntToStr(i)
                    tkl = StringLength(tmpk)
                    kptr = JSRT__StrSlabAlloc(Add(tkl, 1))
                    IfCondition NotEqual(kptr, 0) ThenBlock: {
                        MemoryCopy(kptr, tmpk, Add(tkl, 1))
                    } ElseBlock: {
                        kptr = tmpk
                    }
                    v = JSVM__GetProperty(a0, kptr)
                }
                k = JSBridge__Pop()
                elen = JSBridge__Pop()
                i = JSBridge__Pop()
                a0 = JSBridge__Pop()
                ta = JSBridge__Pop()
