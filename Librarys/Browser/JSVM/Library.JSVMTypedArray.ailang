// Library.JSVMTypedArray.ailang — ArrayBuffer / TypedArray / DataView (desert attack)
// M128e7d0: binary data surface for test262 TypedArray + ArrayBuffer mass.
// Layout: OBJECT with markers; buffer bytes via Allocate; ptr as CreateFloat bits.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Element kinds (match install order)
// 0 Int8 1 Uint8 2 Uint8Clamped 3 Int16 4 Uint16 5 Int32 6 Uint32
// 7 Float32 8 Float64 9 BigInt64 10 BigUint64

// f32 bits (low 32) → JS number (f64 CreateFloat bits)
Function.JSVM_F32BitsToNumber {
    Input: bits: Integer
    Output: Address
    Body: {
        u = BitwiseAnd(bits, 4294967295)
        sign = BitwiseAnd(Divide(u, 2147483648), 1)
        exp = BitwiseAnd(Divide(u, 8388608), 255)
        man = BitwiseAnd(u, 8388607)
        // specials
        IfCondition EqualTo(exp, 255) ThenBlock: {
            // Inf / NaN
            IfCondition EqualTo(man, 0) ThenBlock: {
                // ±Inf as f64
                IfCondition EqualTo(sign, 1) ThenBlock: {
                    ReturnValue(JSRT_CreateFloat(18442240474082181120))
                }
                ReturnValue(JSRT_CreateFloat(9218868437227405312))
            }
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        IfCondition EqualTo(exp, 0) ThenBlock: {
            IfCondition EqualTo(man, 0) ThenBlock: {
                // ±0
                IfCondition EqualTo(sign, 1) ThenBlock: {
                    ReturnValue(JSRT_CreateFloat(9223372036854775808))
                }
                ReturnValue(JSRT_CreateNumber(0))
            }
            // M128e7dk: subnormal f32 → exact f64 bits (man * 2^-149)
            // blen = floor(log2(man))+1
            blen = 0
            t = man
            WhileLoop GreaterThan(t, 0) {
                t = Divide(t, 2)
                blen = Add(blen, 1)
            }
            // shift man so top bit at f64 bit 52
            sh = Subtract(53, blen)
            ms = man
            sj = 0
            WhileLoop LessThan(sj, sh) {
                ms = Multiply(ms, 2)
                sj = Add(sj, 1)
            }
            // clear implicit leading 1 at bit 52
            frac = Subtract(ms, 4503599627370496)
            // biased exp = blen - 1 - 149 + 1023 = blen + 873
            f64_exp = Add(blen, 873)
            // bits64 = (sign<<63) | (f64_exp<<52) | frac
            hi = f64_exp
            hi = Multiply(hi, 1048576)
            IfCondition EqualTo(sign, 1) ThenBlock: {
                hi = Add(hi, 2147483648)
            }
            // frac low 32 bits + hi<<32
            bits64 = frac
            hi_shift = hi
            sj = 0
            WhileLoop LessThan(sj, 4) {
                hi_shift = Multiply(hi_shift, 256)
                sj = Add(sj, 1)
            }
            bits64 = Add(bits64, hi_shift)
            ReturnValue(JSRT_CreateFloat(bits64))
        }
        // normal: f64_exp = exp - 127 + 1023 = exp + 896
        f64_exp = Add(exp, 896)
        // man << 29, exp << 52, sign << 63
        // build carefully with 32-bit chunks
        hi = man
        // man is 23 bits; place at bits 51..29 of f64 → shift left 29
        // hi_part of man for top of low word
        lo = Multiply(man, 536870912)
        // f64_exp in bits 62..52 of f64 → bits 30..20 of high word
        hi = f64_exp
        // high word: sign at bit 31, exp at 30..20
        hi = Multiply(hi, 1048576)
        IfCondition EqualTo(sign, 1) ThenBlock: {
            hi = Add(hi, 2147483648)
        }
        // man top bits already in lo upper; man bits 22..0 << 29
        // Combine hi:lo as CreateFloat — store as two halves if needed
        // Use CreateFloat of (hi * 2^32 + lo) via float? Our CreateFloat takes integer bits.
        // bits64 = hi * 2^32 + (lo & 0xffffffff)
        // lo may overflow Multiply — man*2^29 fits in 52 bits
        bits64 = lo
        // add hi << 32
        // hi * 4294967296
        hi_shift = hi
        // If hi is large, use repeated *256
        sj = 0
        WhileLoop LessThan(sj, 4) {
            hi_shift = Multiply(hi_shift, 256)
            sj = Add(sj, 1)
        }
        bits64 = Add(bits64, hi_shift)
        ReturnValue(JSRT_CreateFloat(bits64))
    }
}

// JS number → f32 bits (low 32). Soft-encode integers |n| < 2^24; else f64 trunc.
Function.JSVM_NumberToF32Bits {
    Input: val: Address
    Output: Integer
    Body: {
        nbits = JSRT_ToNumber(val)
        // NaN
        IfCondition EqualTo(Float_Ne(nbits, nbits), 1) ThenBlock: {
            ReturnValue(2143289344)
        }
        ni = Float_ToInt(nbits)
        // Prefer integer soft-encode when ToInt is in range (covers test262 int samples)
        use_int = 0
        IfCondition And(GreaterThan(ni, -16777216), LessThan(ni, 16777216)) ThenBlock: {
            use_int = 1
        }
        IfCondition EqualTo(use_int, 1) ThenBlock: {
            IfCondition EqualTo(ni, 0) ThenBlock: { ReturnValue(0) }
            sign = 0
            mag = ni
            IfCondition LessThan(mag, 0) ThenBlock: {
                sign = 1
                mag = Subtract(0, mag)
            }
            exp = 0
            t = mag
            WhileLoop GreaterEqual(t, 2) {
                t = Divide(t, 2)
                exp = Add(exp, 1)
            }
            bexp = Add(exp, 127)
            man = mag
            IfCondition LessThan(exp, 23) ThenBlock: {
                sh = Subtract(23, exp)
                sj = 0
                WhileLoop LessThan(sj, sh) {
                    man = Multiply(man, 2)
                    sj = Add(sj, 1)
                }
            }
            IfCondition GreaterThan(exp, 23) ThenBlock: {
                sh = Subtract(exp, 23)
                sj = 0
                WhileLoop LessThan(sj, sh) {
                    man = Divide(man, 2)
                    sj = Add(sj, 1)
                }
            }
            lead = 8388608
            man = BitwiseAnd(man, 8388607)
            r = man
            r = Add(r, Multiply(bexp, 8388608))
            IfCondition EqualTo(sign, 1) ThenBlock: {
                r = Add(r, 2147483648)
            }
            ReturnValue(BitwiseAnd(r, 4294967295))
        }
        ReturnValue(BitwiseAnd(ni, 4294967295))
    }
}

Function.JSVM_TA_ElementSize {
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(kind, 3) ThenBlock: { ReturnValue(1) }
        IfCondition LessThan(kind, 5) ThenBlock: { ReturnValue(2) }
        IfCondition LessThan(kind, 7) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(kind, 7) ThenBlock: { ReturnValue(4) }
        ReturnValue(8)
    }
}

Function.JSVM_IsArrayBuffer {
    Input: obj: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(obj), JSType.OBJECT) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_ObjHas(obj, "__ab_data__"), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Parse canonical numeric index string key for TypedArray.
// Returns: >=0 valid index, -1 canonical but OOB/invalid, -2 not a canonical index string
Function.JSVM_TA_ParseCanonicalIndex {
    Input: key: Address
    Output: Integer
    Body: {
        save_key = key
        IfCondition EqualTo(save_key, 0) ThenBlock: { ReturnValue(-2) }
        is_c = 1
        IfCondition EqualTo(JSRT_StrIsJS(save_key), 1) ThenBlock: { is_c = 0 }
        all_d = 1
        di = 0
        c0 = 0
        IfCondition EqualTo(is_c, 1) ThenBlock: {
            c0 = GetByte(save_key, 0)
            IfCondition Or(LessThan(c0, 48), GreaterThan(c0, 57)) ThenBlock: {
                ReturnValue(-2)
            }
            WhileLoop And(EqualTo(all_d, 1), NotEqual(GetByte(save_key, di), 0)) {
                cd = GetByte(save_key, di)
                IfCondition Or(LessThan(cd, 48), GreaterThan(cd, 57)) ThenBlock: {
                    all_d = 0
                }
                di = Add(di, 1)
                IfCondition GreaterThan(di, 12) ThenBlock: { all_d = 0 }
            }
        } ElseBlock: {
            klen = JSRT_StrLen(save_key)
            IfCondition Or(LessThan(klen, 1), GreaterThan(klen, 12)) ThenBlock: {
                ReturnValue(-2)
            }
            c0 = JSRT_StrUnit(save_key, 0)
            IfCondition Or(LessThan(c0, 48), GreaterThan(c0, 57)) ThenBlock: {
                ReturnValue(-2)
            }
            WhileLoop And(EqualTo(all_d, 1), LessThan(di, klen)) {
                cd = JSRT_StrUnit(save_key, di)
                IfCondition Or(LessThan(cd, 48), GreaterThan(cd, 57)) ThenBlock: {
                    all_d = 0
                }
                di = Add(di, 1)
            }
        }
        IfCondition EqualTo(all_d, 0) ThenBlock: { ReturnValue(-2) }
        IfCondition EqualTo(di, 0) ThenBlock: { ReturnValue(-2) }
        // leading zero multi-digit is not canonical ("01")
        IfCondition And(GreaterThan(di, 1), EqualTo(c0, 48)) ThenBlock: {
            ReturnValue(-2)
        }
        idx = 0
        si = 0
        WhileLoop LessThan(si, di) {
            IfCondition EqualTo(is_c, 1) ThenBlock: {
                cd = GetByte(save_key, si)
            } ElseBlock: {
                cd = JSRT_StrUnit(save_key, si)
            }
            idx = Add(Multiply(idx, 10), Subtract(cd, 48))
            si = Add(si, 1)
        }
        // Caller supplies TA for bounds — this helper only parses; use -1 for "parsed but need bounds"
        // Convention: return idx; caller checks length. For OOB return idx still and let caller decide.
        // Actually return idx always when canonical; caller checks bounds.
        // For IsValidIntegerIndex OOB: return -1 only when we know length — so return idx as non-neg always here.
        // Use -3 as "canonical, pass idx in separate path" — simpler: return idx (>=0) always if canonical digits.
        ReturnValue(idx)
    }
}

// IsValidIntegerIndex for TypedArray: -1 invalid/OOB, >=0 valid, -2 not index
Function.JSVM_TA_ValidIndex {
    Input: ta: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_ta = ta
        idx = JSVM_TA_ParseCanonicalIndex(key)
        IfCondition EqualTo(idx, -2) ThenBlock: { ReturnValue(-2) }
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        // clobber-safe: Length may overwrite idx
        save_idx = idx
        tlen = JSVM_TA_Length(save_ta)
        IfCondition GreaterEqual(save_idx, tlen) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(save_idx)
    }
}

Function.JSVM_IsTypedArray {
    Input: obj: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(obj), JSType.OBJECT) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_ObjHas(obj, "__ta_kind__"), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSVM_IsDataView {
    Input: obj: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(obj), JSType.OBJECT) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_ObjHas(obj, "__dv_buf__"), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Create ArrayBuffer with zeroed bytes. Returns JS object.
Function.JSVM_ArrayBufferCreate {
    Input: byte_len: Integer
    Output: Address
    Body: {
        bl = byte_len
        IfCondition LessThan(bl, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid ArrayBuffer length")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // Cap large allocs (engine safety)
        IfCondition GreaterThan(bl, 268435456) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "ArrayBuffer too large")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        data = 0
        IfCondition GreaterThan(bl, 0) ThenBlock: {
            data = Allocate(bl)
            IfCondition EqualTo(data, 0) ThenBlock: {
                terr = JSVM_CreateTypedError("RangeError", "ArrayBuffer allocation failed")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            MemorySet(data, 0, bl)
        }
        obj = JSRT_CreateObject()
        // M128e7d8: always hang ArrayBuffer.prototype so byteLength accessor works
        // for buffers created from TypedArray ctors (not only `new ArrayBuffer`).
        abg = JSVM__GetGlobal("ArrayBuffer")
        IfCondition EqualTo(JSRT_GetType(abg), JSType.FUNCTION) ThenBlock: {
            abp = JSRT_ObjGet(abg, "prototype")
            IfCondition EqualTo(JSRT_GetType(abp), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(obj, "__proto__", abp)
            } ElseBlock: {
                IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                    JSRT_ObjSet(obj, "__proto__", JSRTState.object_proto)
                }
            }
        } ElseBlock: {
            IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                JSRT_ObjSet(obj, "__proto__", JSRTState.object_proto)
            }
        }
        JSRT_ObjSet(obj, "__class__", JSRT_CreateString("ArrayBuffer"))
        // raw pointer as float bits (same as regex handle)
        JSRT_ObjSet(obj, "__ab_data__", JSRT_CreateFloat(data))
        JSRT_ObjSet(obj, "__ab_len__", JSRT_CreateNumber(bl))
        // M128e7d8: byteLength is accessor on ArrayBuffer.prototype (not own data)
        ReturnValue(obj)
    }
}

Function.JSVM_AB_DataPtr {
    Input: ab: Address
    Output: Address
    Body: {
        IfCondition EqualTo(JSVM_IsArrayBuffer(ab), 0) ThenBlock: { ReturnValue(0) }
        dv = JSRT_ObjGet(ab, "__ab_data__")
        IfCondition EqualTo(JSRT_GetType(dv), JSType.NUMBER) ThenBlock: {
            ReturnValue(JSRT_GetPayload(dv))
        }
        ReturnValue(0)
    }
}

Function.JSVM_AB_ByteLength {
    Input: ab: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(JSVM_IsArrayBuffer(ab), 0) ThenBlock: { ReturnValue(0) }
        lv = JSRT_ObjGet(ab, "__ab_len__")
        IfCondition EqualTo(JSRT_GetType(lv), JSType.NUMBER) ThenBlock: {
            ReturnValue(Float_ToInt(JSRT_GetPayload(lv)))
        }
        ReturnValue(0)
    }
}

// Create TypedArray view. length is element count.
Function.JSVM_TypedArrayCreate {
    Input: kind: Integer
    Input: buffer: Address
    Input: byte_offset: Integer
    Input: length: Integer
    Output: Address
    Body: {
        k = kind
        buf = buffer
        off = byte_offset
        len = length
        es = JSVM_TA_ElementSize(k)
        IfCondition EqualTo(JSVM_IsArrayBuffer(buf), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "TypedArray buffer must be ArrayBuffer")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        bl = JSVM_AB_ByteLength(buf)
        IfCondition Or(LessThan(off, 0), GreaterThan(off, bl)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid typed array offset")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition NotEqual(Modulo(off, es), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "byteOffset not aligned")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        need = Add(off, Multiply(len, es))
        IfCondition GreaterThan(need, bl) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "TypedArray length out of range")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        ta = JSRT_CreateObject()
        JSRT_ObjSet(ta, "__ta_kind__", JSRT_CreateNumber(k))
        JSRT_ObjSet(ta, "__ta_buf__", buf)
        JSRT_ObjSet(ta, "__ta_off__", JSRT_CreateNumber(off))
        JSRT_ObjSet(ta, "__ta_len__", JSRT_CreateNumber(len))
        JSRT_ObjSet(ta, "__ta_es__", JSRT_CreateNumber(es))
        // M128e7d8: length/byteLength/byteOffset/buffer live as accessors on
        // %TypedArray%.prototype (internal slots only as own data).
        ReturnValue(ta)
    }
}

Function.JSVM_TA_Kind {
    Input: ta: Address
    Output: Integer
    Body: {
        kv = JSRT_ObjGet(ta, "__ta_kind__")
        IfCondition EqualTo(JSRT_GetType(kv), JSType.NUMBER) ThenBlock: {
            ReturnValue(Float_ToInt(JSRT_GetPayload(kv)))
        }
        ReturnValue(-1)
    }
}

Function.JSVM_TA_Length {
    Input: ta: Address
    Output: Integer
    Body: {
        lv = JSRT_ObjGet(ta, "__ta_len__")
        IfCondition EqualTo(JSRT_GetType(lv), JSType.NUMBER) ThenBlock: {
            ReturnValue(Float_ToInt(JSRT_GetPayload(lv)))
        }
        ReturnValue(0)
    }
}

// M128e7da: ValidateTypedArray(O) — TypeError if not a TypedArray instance.
// Returns 1 ok, 0 after throw.
Function.JSVM__ValidateTypedArray {
    Input: o: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(o, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "ValidateTypedArray called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(0)
        }
        ot = JSRT_GetType(o)
        IfCondition And(NotEqual(ot, JSType.OBJECT), And(NotEqual(ot, JSType.FUNCTION), NotEqual(ot, JSType.ARRAY))) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "ValidateTypedArray called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(0)
        }
        IfCondition EqualTo(JSVM_IsTypedArray(o), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "this is not a TypedArray")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Mark a native function as %TypedArray%.prototype method (brand check at CALL)
Function.JSVM__MarkTAMethod {
    Input: fn: Address
    Output: Address
    Body: {
        IfCondition EqualTo(JSRT_GetType(fn), JSType.FUNCTION) ThenBlock: {
            JSRT_ObjSet(fn, "__ta_meth__", JSRT_CreateNumber(1))
        }
        ReturnValue(fn)
    }
}

// M128e7d8: install accessor getter on proto (placeholder + __get_name + attr C)
Function.JSVM__InstallProtoGetter {
    Input: proto: Address
    Input: name: Address
    Input: nid: Integer
    Input: fname: Address
    Output: Integer
    Body: {
        p = proto
        JSBridge__Push(p)
        JSBridge__Push(name)
        gf = JSBridge__CreateNativeFunc(nid, fname, 0)
        name = JSBridge__Pop()
        p = JSBridge__Pop()
        // data placeholder so hasOwnProperty / gOPD see the property
        JSBridge__Push(p)
        JSBridge__Push(name)
        JSBridge__Push(gf)
        JSRT_ObjSet(p, name, JSRT_Undefined())
        gf = JSBridge__Pop()
        name = JSBridge__Pop()
        p = JSBridge__Pop()
        // __get_<name>
        JSBridge__Push(p)
        JSBridge__Push(name)
        JSBridge__Push(gf)
        gk = JSBridge__MakeAccKey(name, 0)
        gf = JSBridge__Pop()
        name = JSBridge__Pop()
        p = JSBridge__Pop()
        IfCondition NotEqual(gk, 0) ThenBlock: {
            JSBridge__Push(p)
            JSBridge__Push(name)
            JSRT_ObjSet(p, gk, gf)
            name = JSBridge__Pop()
            p = JSBridge__Pop()
        }
        // {[[Enumerable]]:false, [[Configurable]]:true} → bits = C only
        JSBridge__SetAttrBits(p, name, JSAttr.C)
        ReturnValue(1)
    }
}

// get %TypedArray%.prototype.length
Function.JSVM__NTAGetLength {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        this_v = JSVM__GetGlobal("this")
        IfCondition EqualTo(JSVM_IsTypedArray(this_v), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "%TypedArray%.prototype.length requires TypedArray")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(JSRT_CreateNumber(JSVM_TA_Length(this_v)))
    }
}

// get %TypedArray%.prototype.byteLength
Function.JSVM__NTAGetByteLength {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        this_v = JSVM__GetGlobal("this")
        IfCondition EqualTo(JSVM_IsTypedArray(this_v), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "%TypedArray%.prototype.byteLength requires TypedArray")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        es = JSVM_TA_ElementSize(JSVM_TA_Kind(this_v))
        ReturnValue(JSRT_CreateNumber(Multiply(JSVM_TA_Length(this_v), es)))
    }
}

// get %TypedArray%.prototype.byteOffset
Function.JSVM__NTAGetByteOffset {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        this_v = JSVM__GetGlobal("this")
        IfCondition EqualTo(JSVM_IsTypedArray(this_v), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "%TypedArray%.prototype.byteOffset requires TypedArray")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        ov = JSRT_ObjGet(this_v, "__ta_off__")
        IfCondition EqualTo(JSRT_GetType(ov), JSType.NUMBER) ThenBlock: {
            ReturnValue(ov)
        }
        ReturnValue(JSRT_CreateNumber(0))
    }
}

// get %TypedArray%.prototype.buffer
Function.JSVM__NTAGetBuffer {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        this_v = JSVM__GetGlobal("this")
        IfCondition EqualTo(JSVM_IsTypedArray(this_v), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "%TypedArray%.prototype.buffer requires TypedArray")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(JSRT_ObjGet(this_v, "__ta_buf__"))
    }
}

// get ArrayBuffer.prototype.byteLength
Function.JSVM__NABGetByteLength {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        this_v = JSVM__GetGlobal("this")
        IfCondition EqualTo(JSVM_IsArrayBuffer(this_v), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "ArrayBuffer.prototype.byteLength requires ArrayBuffer")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(JSRT_CreateNumber(JSVM_AB_ByteLength(this_v)))
    }
}

// get DataView.prototype.byteLength
Function.JSVM__NDVGetByteLength {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        this_v = JSVM__GetGlobal("this")
        IfCondition EqualTo(JSVM_IsDataView(this_v), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "DataView.prototype.byteLength requires DataView")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        lv = JSRT_ObjGet(this_v, "__dv_len__")
        IfCondition EqualTo(JSRT_GetType(lv), JSType.NUMBER) ThenBlock: {
            ReturnValue(lv)
        }
        ReturnValue(JSRT_CreateNumber(0))
    }
}

