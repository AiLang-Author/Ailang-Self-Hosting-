// Library.JSVMTypedArray.ailang — ArrayBuffer / TypedArray / DataView (desert attack)
// M128e7d0: binary data surface for test262 TypedArray + ArrayBuffer mass.
// Layout: OBJECT with markers; buffer bytes via Allocate; ptr as CreateFloat bits.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Element kinds (match install order)
// 0 Int8 1 Uint8 2 Uint8Clamped 3 Int16 4 Uint16 5 Int32 6 Uint32
// 7 Float32 8 Float64 9 BigInt64 10 BigUint64

Function.JSVM_TA_ElementSize {
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(kind, 3) ThenBlock: { ReturnValue(1) }
        IfCondition LessThan(kind, 5) ThenBlock: { ReturnValue(2) }
        IfCondition LessThan(kind, 7) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(kind, 7) ThenBlock: { ReturnValue(4) }
        ReturnValue(8)
    }
}

Function.JSVM_IsArrayBuffer {
    Input: obj: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(obj), JSType.OBJECT) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_ObjHas(obj, "__ab_data__"), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSVM_IsTypedArray {
    Input: obj: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(obj), JSType.OBJECT) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_ObjHas(obj, "__ta_kind__"), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSVM_IsDataView {
    Input: obj: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(obj), JSType.OBJECT) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_ObjHas(obj, "__dv_buf__"), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Create ArrayBuffer with zeroed bytes. Returns JS object.
Function.JSVM_ArrayBufferCreate {
    Input: byte_len: Integer
    Output: Address
    Body: {
        bl = byte_len
        IfCondition LessThan(bl, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid ArrayBuffer length")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // Cap large allocs (engine safety)
        IfCondition GreaterThan(bl, 268435456) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "ArrayBuffer too large")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        data = 0
        IfCondition GreaterThan(bl, 0) ThenBlock: {
            data = Allocate(bl)
            IfCondition EqualTo(data, 0) ThenBlock: {
                terr = JSVM_CreateTypedError("RangeError", "ArrayBuffer allocation failed")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            MemorySet(data, 0, bl)
        }
        obj = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            // [[Prototype]] set by caller to ArrayBuffer.prototype when available
        }
        JSRT_ObjSet(obj, "__class__", JSRT_CreateString("ArrayBuffer"))
        // raw pointer as float bits (same as regex handle)
        JSRT_ObjSet(obj, "__ab_data__", JSRT_CreateFloat(data))
        JSRT_ObjSet(obj, "__ab_len__", JSRT_CreateNumber(bl))
        JSRT_ObjSet(obj, "byteLength", JSRT_CreateNumber(bl))
        JSBridge__SetAttrBits(obj, "byteLength", 0)
        ReturnValue(obj)
    }
}

Function.JSVM_AB_DataPtr {
    Input: ab: Address
    Output: Address
    Body: {
        IfCondition EqualTo(JSVM_IsArrayBuffer(ab), 0) ThenBlock: { ReturnValue(0) }
        dv = JSRT_ObjGet(ab, "__ab_data__")
        IfCondition EqualTo(JSRT_GetType(dv), JSType.NUMBER) ThenBlock: {
            ReturnValue(JSRT_GetPayload(dv))
        }
        ReturnValue(0)
    }
}

Function.JSVM_AB_ByteLength {
    Input: ab: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(JSVM_IsArrayBuffer(ab), 0) ThenBlock: { ReturnValue(0) }
        lv = JSRT_ObjGet(ab, "__ab_len__")
        IfCondition EqualTo(JSRT_GetType(lv), JSType.NUMBER) ThenBlock: {
            ReturnValue(Float_ToInt(JSRT_GetPayload(lv)))
        }
        ReturnValue(0)
    }
}

// Create TypedArray view. length is element count.
Function.JSVM_TypedArrayCreate {
    Input: kind: Integer
    Input: buffer: Address
    Input: byte_offset: Integer
    Input: length: Integer
    Output: Address
    Body: {
        k = kind
        buf = buffer
        off = byte_offset
        len = length
        es = JSVM_TA_ElementSize(k)
        IfCondition EqualTo(JSVM_IsArrayBuffer(buf), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "TypedArray buffer must be ArrayBuffer")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        bl = JSVM_AB_ByteLength(buf)
        IfCondition Or(LessThan(off, 0), GreaterThan(off, bl)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid typed array offset")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition NotEqual(Modulo(off, es), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "byteOffset not aligned")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        need = Add(off, Multiply(len, es))
        IfCondition GreaterThan(need, bl) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "TypedArray length out of range")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        ta = JSRT_CreateObject()
        JSRT_ObjSet(ta, "__ta_kind__", JSRT_CreateNumber(k))
        JSRT_ObjSet(ta, "__ta_buf__", buf)
        JSRT_ObjSet(ta, "__ta_off__", JSRT_CreateNumber(off))
        JSRT_ObjSet(ta, "__ta_len__", JSRT_CreateNumber(len))
        JSRT_ObjSet(ta, "__ta_es__", JSRT_CreateNumber(es))
        JSRT_ObjSet(ta, "buffer", buf)
        JSRT_ObjSet(ta, "byteOffset", JSRT_CreateNumber(off))
        JSRT_ObjSet(ta, "byteLength", JSRT_CreateNumber(Multiply(len, es)))
        JSRT_ObjSet(ta, "length", JSRT_CreateNumber(len))
        // non-writable accessors-ish: stamp !W !E !C for length/buffer/etc.
        JSBridge__SetAttrBits(ta, "buffer", 0)
        JSBridge__SetAttrBits(ta, "byteOffset", 0)
        JSBridge__SetAttrBits(ta, "byteLength", 0)
        JSBridge__SetAttrBits(ta, "length", 0)
        ReturnValue(ta)
    }
}

Function.JSVM_TA_Kind {
    Input: ta: Address
    Output: Integer
    Body: {
        kv = JSRT_ObjGet(ta, "__ta_kind__")
        IfCondition EqualTo(JSRT_GetType(kv), JSType.NUMBER) ThenBlock: {
            ReturnValue(Float_ToInt(JSRT_GetPayload(kv)))
        }
        ReturnValue(-1)
    }
}

Function.JSVM_TA_Length {
    Input: ta: Address
    Output: Integer
    Body: {
        lv = JSRT_ObjGet(ta, "__ta_len__")
        IfCondition EqualTo(JSRT_GetType(lv), JSType.NUMBER) ThenBlock: {
            ReturnValue(Float_ToInt(JSRT_GetPayload(lv)))
        }
        ReturnValue(0)
    }
}

// Read element at index → JS number/bigint
Function.JSVM_TA_Get {
    Input: ta: Address
    Input: index: Integer
    Output: Address
    Body: {
        save_ta = ta
        idx = index
        IfCondition EqualTo(JSVM_IsTypedArray(save_ta), 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        len = JSVM_TA_Length(save_ta)
        IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, len)) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        kind = JSVM_TA_Kind(save_ta)
        es = JSVM_TA_ElementSize(kind)
        buf = JSRT_ObjGet(save_ta, "__ta_buf__")
        off_v = JSRT_ObjGet(save_ta, "__ta_off__")
        byte_off = Float_ToInt(JSRT_GetPayload(off_v))
        data = JSVM_AB_DataPtr(buf)
        IfCondition EqualTo(data, 0) ThenBlock: {
            // empty buffer / zero length
            IfCondition Or(EqualTo(kind, 9), EqualTo(kind, 10)) ThenBlock: {
                ReturnValue(JSRT_CreateBigIntZero())
            }
            ReturnValue(JSRT_CreateNumber(0))
        }
        p = Add(data, Add(byte_off, Multiply(idx, es)))
        // Int8
        IfCondition EqualTo(kind, 0) ThenBlock: {
            b = GetByte(p, 0)
            IfCondition GreaterThan(b, 127) ThenBlock: { b = Subtract(b, 256) }
            ReturnValue(JSRT_CreateNumber(b))
        }
        // Uint8 / Uint8Clamped
        IfCondition Or(EqualTo(kind, 1), EqualTo(kind, 2)) ThenBlock: {
            b = GetByte(p, 0)
            ReturnValue(JSRT_CreateNumber(b))
        }
        // Int16 LE
        IfCondition EqualTo(kind, 3) ThenBlock: {
            lo = GetByte(p, 0)
            hi = GetByte(p, 1)
            v = Add(lo, Multiply(hi, 256))
            IfCondition GreaterThan(v, 32767) ThenBlock: { v = Subtract(v, 65536) }
            ReturnValue(JSRT_CreateNumber(v))
        }
        // Uint16 LE
        IfCondition EqualTo(kind, 4) ThenBlock: {
            lo = GetByte(p, 0)
            hi = GetByte(p, 1)
            v = Add(lo, Multiply(hi, 256))
            ReturnValue(JSRT_CreateNumber(v))
        }
        // Int32 LE
        IfCondition EqualTo(kind, 5) ThenBlock: {
            b0 = GetByte(p, 0)
            b1 = GetByte(p, 1)
            b2 = GetByte(p, 2)
            b3 = GetByte(p, 3)
            v = b0
            v = Add(v, Multiply(b1, 256))
            v = Add(v, Multiply(b2, 65536))
            // high byte signed via careful 24-bit then *256
            IfCondition GreaterThan(b3, 127) ThenBlock: {
                // negative: use unsigned 32 then interpret — host int may be 64-bit
                v = Add(v, Multiply(b3, 16777216))
                // if host treats as signed 32, ok; else subtract 2^32
                IfCondition GreaterEqual(v, 2147483648) ThenBlock: {
                    v = Subtract(v, 4294967296)
                }
            } ElseBlock: {
                v = Add(v, Multiply(b3, 16777216))
            }
            ReturnValue(JSRT_CreateNumber(v))
        }
        // Uint32 LE
        IfCondition EqualTo(kind, 6) ThenBlock: {
            b0 = GetByte(p, 0)
            b1 = GetByte(p, 1)
            b2 = GetByte(p, 2)
            b3 = GetByte(p, 3)
            // store as float (may lose precision >2^53 — ok for many tests)
            vf = Float_FromInt(b0)
            vf = Float_Add(vf, Float_FromInt(Multiply(b1, 256)))
            vf = Float_Add(vf, Float_FromInt(Multiply(b2, 65536)))
            vf = Float_Add(vf, Float_Mul(Float_FromInt(b3), Float_FromInt(16777216)))
            ReturnValue(JSRT_CreateFloat(vf))
        }
        // Float32 — assemble bits then reinterpret via CreateFloat
        IfCondition EqualTo(kind, 7) ThenBlock: {
            b0 = GetByte(p, 0)
            b1 = GetByte(p, 1)
            b2 = GetByte(p, 2)
            b3 = GetByte(p, 3)
            bits = b0
            bits = Add(bits, Multiply(b1, 256))
            bits = Add(bits, Multiply(b2, 65536))
            bits = Add(bits, Multiply(b3, 16777216))
            // Approximate: convert int bits as float payload — CreateFloat stores raw
            // For IEEE float32 in low 32 bits of f64 payload slot — engine NUMBER is f64.
            // Use simple scale: treat as host float via CreateFloat of bit pattern extended.
            ReturnValue(JSRT_CreateFloat(bits))
        }
        // Float64 — 8 bytes LE into CreateFloat payload
        IfCondition EqualTo(kind, 8) ThenBlock: {
            // read 8 bytes into host integer if 64-bit; else approximate
            bits = 0
            bi = 0
            WhileLoop LessThan(bi, 8) {
                bb = GetByte(p, bi)
                // shift left 8*bi — use repeated *256
                sh = bb
                sj = 0
                WhileLoop LessThan(sj, bi) {
                    sh = Multiply(sh, 256)
                    sj = Add(sj, 1)
                }
                bits = Add(bits, sh)
                bi = Add(bi, 1)
            }
            ReturnValue(JSRT_CreateFloat(bits))
        }
        // BigInt64 / BigUint64 — simplified via number for now if small
        IfCondition Or(EqualTo(kind, 9), EqualTo(kind, 10)) ThenBlock: {
            // assemble low 32 + high 32 into BigInt if available
            b0 = GetByte(p, 0)
            b1 = GetByte(p, 1)
            b2 = GetByte(p, 2)
            b3 = GetByte(p, 3)
            lo = b0
            lo = Add(lo, Multiply(b1, 256))
            lo = Add(lo, Multiply(b2, 65536))
            lo = Add(lo, Multiply(b3, 16777216))
            // Use BigInt from number low part only (MVP — full 64 later)
            ReturnValue(JSRT_ToBigInt(JSRT_CreateNumber(BitwiseAnd(lo, 2147483647))))
        }
        ReturnValue(JSRT_CreateNumber(0))
    }
}

// Write element. Returns 1 ok, 0 fail.
Function.JSVM_TA_Set {
    Input: ta: Address
    Input: index: Integer
    Input: val: Address
    Output: Integer
    Body: {
        save_ta = ta
        idx = index
        save_val = val
        IfCondition EqualTo(JSVM_IsTypedArray(save_ta), 0) ThenBlock: { ReturnValue(0) }
        len = JSVM_TA_Length(save_ta)
        IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, len)) ThenBlock: { ReturnValue(0) }
        kind = JSVM_TA_Kind(save_ta)
        es = JSVM_TA_ElementSize(kind)
        buf = JSRT_ObjGet(save_ta, "__ta_buf__")
        off_v = JSRT_ObjGet(save_ta, "__ta_off__")
        byte_off = Float_ToInt(JSRT_GetPayload(off_v))
        data = JSVM_AB_DataPtr(buf)
        IfCondition EqualTo(data, 0) ThenBlock: { ReturnValue(0) }
        p = Add(data, Add(byte_off, Multiply(idx, es)))
        // ToNumber for most; BigInt for 9/10
        IfCondition Or(EqualTo(kind, 9), EqualTo(kind, 10)) ThenBlock: {
            // MVP: ToNumber truncate
            n = Float_ToInt(JSRT_ToNumber(save_val))
            bi = 0
            WhileLoop LessThan(bi, 8) {
                SetByte(p, bi, BitwiseAnd(n, 255))
                n = Divide(n, 256)
                bi = Add(bi, 1)
            }
            ReturnValue(1)
        }
        nbits = JSRT_ToNumber(save_val)
        ni = Float_ToInt(nbits)
        // Uint8Clamped
        IfCondition EqualTo(kind, 2) ThenBlock: {
            IfCondition LessThan(ni, 0) ThenBlock: { ni = 0 }
            IfCondition GreaterThan(ni, 255) ThenBlock: { ni = 255 }
            SetByte(p, 0, ni)
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 0) ThenBlock: {
            // Int8
            ni = BitwiseAnd(ni, 255)
            SetByte(p, 0, ni)
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            ni = BitwiseAnd(ni, 255)
            SetByte(p, 0, ni)
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            // Int16
            ni = BitwiseAnd(ni, 65535)
            SetByte(p, 0, BitwiseAnd(ni, 255))
            SetByte(p, 1, BitwiseAnd(Divide(ni, 256), 255))
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 4) ThenBlock: {
            ni = BitwiseAnd(ni, 65535)
            SetByte(p, 0, BitwiseAnd(ni, 255))
            SetByte(p, 1, BitwiseAnd(Divide(ni, 256), 255))
            ReturnValue(1)
        }
        IfCondition Or(EqualTo(kind, 5), EqualTo(kind, 6)) ThenBlock: {
            // 32-bit
            u = ni
            SetByte(p, 0, BitwiseAnd(u, 255))
            u = Divide(u, 256)
            SetByte(p, 1, BitwiseAnd(u, 255))
            u = Divide(u, 256)
            SetByte(p, 2, BitwiseAnd(u, 255))
            u = Divide(u, 256)
            SetByte(p, 3, BitwiseAnd(u, 255))
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 7) ThenBlock: {
            // Float32: store CreateFloat payload low 32 if available
            // Fallback: write ToInt32 of number
            u = ni
            SetByte(p, 0, BitwiseAnd(u, 255))
            u = Divide(u, 256)
            SetByte(p, 1, BitwiseAnd(u, 255))
            u = Divide(u, 256)
            SetByte(p, 2, BitwiseAnd(u, 255))
            u = Divide(u, 256)
            SetByte(p, 3, BitwiseAnd(u, 255))
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 8) ThenBlock: {
            // Float64: write 0 for MVP of non-integer; or payload bits
            bits = nbits
            // if CreateNumber returns value, get its bits
            nv = JSRT_CreateFloat(nbits)
            bits = JSRT_GetPayload(nv)
            bi = 0
            tmp = bits
            WhileLoop LessThan(bi, 8) {
                SetByte(p, bi, BitwiseAnd(tmp, 255))
                tmp = Divide(tmp, 256)
                bi = Add(bi, 1)
            }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// ─── Native: ArrayBuffer(length) ───
Function.JSVM__NArrayBufferCtor {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        // Must be constructed with new
        nt = JSVM__GetGlobal("__new_target__")
        IfCondition Or(EqualTo(nt, 0), EqualTo(nt, JSRTState.undef_val)) ThenBlock: {
            // also check type
            IfCondition NotEqual(JSRT_GetType(nt), JSType.FUNCTION) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "ArrayBuffer constructor requires 'new'")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
        }
        bl = 0
        IfCondition GreaterThan(argc, 0) ThenBlock: {
            bl = Float_ToInt(JSRT_ToNumber(Dereference(args)))
        }
        ab = JSVM_ArrayBufferCreate(bl)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        // stamp prototype from new.target.prototype or ArrayBuffer.prototype
        IfCondition EqualTo(JSRT_GetType(nt), JSType.FUNCTION) ThenBlock: {
            proto = JSRT_ObjGet(nt, "prototype")
            IfCondition EqualTo(JSRT_GetType(proto), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(ab, "__proto__", proto)
            }
        }
        ReturnValue(ab)
    }
}

Function.JSVM__NArrayBufferIsView {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: { ReturnValue(JSRT_False()) }
        v = Dereference(args)
        IfCondition EqualTo(JSVM_IsTypedArray(v), 1) ThenBlock: { ReturnValue(JSRT_True()) }
        IfCondition EqualTo(JSVM_IsDataView(v), 1) ThenBlock: { ReturnValue(JSRT_True()) }
        ReturnValue(JSRT_False())
    }
}

Function.JSVM__NArrayBufferSlice {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        ab = recv
        IfCondition EqualTo(JSVM_IsArrayBuffer(ab), 0) ThenBlock: {
            // try this
            ab = JSVM__GetGlobal("this")
            IfCondition EqualTo(JSVM_IsArrayBuffer(ab), 0) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "ArrayBuffer.prototype.slice requires ArrayBuffer")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
        }
        bl = JSVM_AB_ByteLength(ab)
        start = 0
        end = bl
        IfCondition GreaterThan(argc, 0) ThenBlock: {
            start = Float_ToInt(JSRT_ToNumber(Dereference(args)))
            IfCondition LessThan(start, 0) ThenBlock: {
                start = Add(bl, start)
                IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
            }
            IfCondition GreaterThan(start, bl) ThenBlock: { start = bl }
        }
        IfCondition GreaterThan(argc, 1) ThenBlock: {
            end = Float_ToInt(JSRT_ToNumber(Dereference(Add(args, 8))))
            IfCondition LessThan(end, 0) ThenBlock: {
                end = Add(bl, end)
                IfCondition LessThan(end, 0) ThenBlock: { end = 0 }
            }
            IfCondition GreaterThan(end, bl) ThenBlock: { end = bl }
        }
        IfCondition LessThan(end, start) ThenBlock: { end = start }
        nlen = Subtract(end, start)
        nab = JSVM_ArrayBufferCreate(nlen)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        // copy prototype from ArrayBuffer
        abg = JSVM__GetGlobal("ArrayBuffer")
        IfCondition EqualTo(JSRT_GetType(abg), JSType.FUNCTION) ThenBlock: {
            pr = JSRT_ObjGet(abg, "prototype")
            IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(nab, "__proto__", pr)
            }
        }
        src = JSVM_AB_DataPtr(ab)
        dst = JSVM_AB_DataPtr(nab)
        IfCondition And(NotEqual(src, 0), And(NotEqual(dst, 0), GreaterThan(nlen, 0))) ThenBlock: {
            MemoryCopy(dst, Add(src, start), nlen)
        }
        ReturnValue(nab)
    }
}

// TypedArray constructor body: kind in env via FuncProp or argc packing
// Convention: handler uses fixed kind per native id; this function takes kind.
// new C(length) | new C(buffer, byteOffset, length) | new C(arrayLike) | new C(typedArray)
Function.JSVM__NTypedArrayCtor {
    Input: kind: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        k = kind
        save_args = args
        save_argc = argc
        es = JSVM_TA_ElementSize(k)
        nt = JSVM__GetGlobal("__new_target__")
        // length-only
        IfCondition EqualTo(save_argc, 0) ThenBlock: {
            ab = JSVM_ArrayBufferCreate(0)
            ta = JSVM_TypedArrayCreate(k, ab, 0, 0)
            IfCondition EqualTo(JSRT_GetType(nt), JSType.FUNCTION) ThenBlock: {
                pr = JSRT_ObjGet(nt, "prototype")
                IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ta, "__proto__", pr)
                }
            }
            ReturnValue(ta)
        }
        a0 = Dereference(save_args)
        a0t = JSRT_GetType(a0)
        // ArrayBuffer argument
        IfCondition EqualTo(JSVM_IsArrayBuffer(a0), 1) ThenBlock: {
            bo = 0
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                bo = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 8))))
            }
            bl = JSVM_AB_ByteLength(a0)
            // default length = remaining / es
            rem = Subtract(bl, bo)
            IfCondition LessThan(rem, 0) ThenBlock: { rem = 0 }
            elen = Divide(rem, es)
            IfCondition GreaterThan(save_argc, 2) ThenBlock: {
                elen = Float_ToInt(JSRT_ToNumber(Dereference(Add(save_args, 16))))
            }
            ta = JSVM_TypedArrayCreate(k, a0, bo, elen)
            IfCondition EqualTo(JSRT_GetType(nt), JSType.FUNCTION) ThenBlock: {
                pr = JSRT_ObjGet(nt, "prototype")
                IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ta, "__proto__", pr)
                }
            }
            ReturnValue(ta)
        }
        // TypedArray argument — copy
        IfCondition EqualTo(JSVM_IsTypedArray(a0), 1) ThenBlock: {
            src_len = JSVM_TA_Length(a0)
            ab = JSVM_ArrayBufferCreate(Multiply(src_len, es))
            ta = JSVM_TypedArrayCreate(k, ab, 0, src_len)
            i = 0
            WhileLoop LessThan(i, src_len) {
                JSBridge__Push(ta)
                JSBridge__Push(a0)
                JSBridge__Push(i)
                JSBridge__Push(src_len)
                JSBridge__Push(k)
                v = JSVM_TA_Get(a0, i)
                k = JSBridge__Pop()
                src_len = JSBridge__Pop()
                i = JSBridge__Pop()
                a0 = JSBridge__Pop()
                ta = JSBridge__Pop()
                JSVM_TA_Set(ta, i, v)
                i = Add(i, 1)
            }
            IfCondition EqualTo(JSRT_GetType(nt), JSType.FUNCTION) ThenBlock: {
                pr = JSRT_ObjGet(nt, "prototype")
                IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ta, "__proto__", pr)
                }
            }
            ReturnValue(ta)
        }
        // Number length
        IfCondition EqualTo(a0t, JSType.NUMBER) ThenBlock: {
            elen = Float_ToInt(JSRT_GetPayload(a0))
            IfCondition LessThan(elen, 0) ThenBlock: {
                terr = JSVM_CreateTypedError("RangeError", "Invalid typed array length")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            ab = JSVM_ArrayBufferCreate(Multiply(elen, es))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            ta = JSVM_TypedArrayCreate(k, ab, 0, elen)
            IfCondition EqualTo(JSRT_GetType(nt), JSType.FUNCTION) ThenBlock: {
                pr = JSRT_ObjGet(nt, "prototype")
                IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ta, "__proto__", pr)
                }
            }
            ReturnValue(ta)
        }
        // Array or array-like object
        IfCondition Or(EqualTo(a0t, JSType.ARRAY), EqualTo(a0t, JSType.OBJECT)) ThenBlock: {
            elen = 0
            IfCondition EqualTo(a0t, JSType.ARRAY) ThenBlock: {
                elen = JSRT_ArrLen(a0)
            } ElseBlock: {
                lv = JSRT_ObjGet(a0, "length")
                IfCondition EqualTo(JSRT_GetType(lv), JSType.NUMBER) ThenBlock: {
                    elen = Float_ToInt(JSRT_GetPayload(lv))
                }
            }
            IfCondition LessThan(elen, 0) ThenBlock: { elen = 0 }
            ab = JSVM_ArrayBufferCreate(Multiply(elen, es))
            ta = JSVM_TypedArrayCreate(k, ab, 0, elen)
            i = 0
            WhileLoop LessThan(i, elen) {
                JSBridge__Push(ta)
                JSBridge__Push(a0)
                JSBridge__Push(i)
                JSBridge__Push(elen)
                JSBridge__Push(k)
                IfCondition EqualTo(JSRT_GetType(a0), JSType.ARRAY) ThenBlock: {
                    v = JSRT_ArrGet(a0, i)
                } ElseBlock: {
                    // ObjGet string key
                    // use IntToStr key
                    tmpk = JSRT__IntToStr(i)
                    tkl = StringLength(tmpk)
                    kptr = JSRT__StrSlabAlloc(Add(tkl, 1))
                    IfCondition NotEqual(kptr, 0) ThenBlock: {
                        MemoryCopy(kptr, tmpk, Add(tkl, 1))
                    } ElseBlock: {
                        kptr = tmpk
                    }
                    v = JSRT_ObjGet(a0, kptr)
                }
                k = JSBridge__Pop()
                elen = JSBridge__Pop()
                i = JSBridge__Pop()
                a0 = JSBridge__Pop()
                ta = JSBridge__Pop()
                JSVM_TA_Set(ta, i, v)
                i = Add(i, 1)
            }
            IfCondition EqualTo(JSRT_GetType(nt), JSType.FUNCTION) ThenBlock: {
                pr = JSRT_ObjGet(nt, "prototype")
                IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(ta, "__proto__", pr)
                }
            }
            ReturnValue(ta)
        }
        // fallback length 0
        ab = JSVM_ArrayBufferCreate(0)
        ta = JSVM_TypedArrayCreate(k, ab, 0, 0)
        ReturnValue(ta)
    }
}

// TypedArray.prototype.set(array [, offset])
Function.JSVM__NTASet {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        ta = recv
        IfCondition EqualTo(JSVM_IsTypedArray(ta), 0) ThenBlock: {
            ta = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsTypedArray(ta), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "TypedArray.prototype.set requires TypedArray")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition LessThan(argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        src = Dereference(args)
        off = 0
        IfCondition GreaterThan(argc, 1) ThenBlock: {
            off = Float_ToInt(JSRT_ToNumber(Dereference(Add(args, 8))))
        }
        dest_len = JSVM_TA_Length(ta)
        src_len = 0
        IfCondition EqualTo(JSVM_IsTypedArray(src), 1) ThenBlock: {
            src_len = JSVM_TA_Length(src)
        } ElseBlock: {
            IfCondition EqualTo(JSRT_GetType(src), JSType.ARRAY) ThenBlock: {
                src_len = JSRT_ArrLen(src)
            } ElseBlock: {
                lv = JSRT_ObjGet(src, "length")
                IfCondition EqualTo(JSRT_GetType(lv), JSType.NUMBER) ThenBlock: {
                    src_len = Float_ToInt(JSRT_GetPayload(lv))
                }
            }
        }
        IfCondition GreaterThan(Add(off, src_len), dest_len) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "TypedArray set out of range")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        i = 0
        WhileLoop LessThan(i, src_len) {
            JSBridge__Push(ta)
            JSBridge__Push(src)
            JSBridge__Push(i)
            JSBridge__Push(off)
            JSBridge__Push(src_len)
            IfCondition EqualTo(JSVM_IsTypedArray(src), 1) ThenBlock: {
                v = JSVM_TA_Get(src, i)
            } ElseBlock: {
                IfCondition EqualTo(JSRT_GetType(src), JSType.ARRAY) ThenBlock: {
                    v = JSRT_ArrGet(src, i)
                } ElseBlock: {
                    tmpk = JSRT__IntToStr(i)
                    v = JSRT_ObjGet(src, tmpk)
                }
            }
            src_len = JSBridge__Pop()
            off = JSBridge__Pop()
            i = JSBridge__Pop()
            src = JSBridge__Pop()
            ta = JSBridge__Pop()
            JSVM_TA_Set(ta, Add(off, i), v)
            i = Add(i, 1)
        }
        ReturnValue(JSRT_Undefined())
    }
}

// TypedArray.prototype.subarray(begin, end)
Function.JSVM__NTASubarray {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        ta = recv
        IfCondition EqualTo(JSVM_IsTypedArray(ta), 0) ThenBlock: {
            ta = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsTypedArray(ta), 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        len = JSVM_TA_Length(ta)
        begin = 0
        end = len
        IfCondition GreaterThan(argc, 0) ThenBlock: {
            begin = Float_ToInt(JSRT_ToNumber(Dereference(args)))
            IfCondition LessThan(begin, 0) ThenBlock: {
                begin = Add(len, begin)
                IfCondition LessThan(begin, 0) ThenBlock: { begin = 0 }
            }
            IfCondition GreaterThan(begin, len) ThenBlock: { begin = len }
        }
        IfCondition GreaterThan(argc, 1) ThenBlock: {
            end = Float_ToInt(JSRT_ToNumber(Dereference(Add(args, 8))))
            IfCondition LessThan(end, 0) ThenBlock: {
                end = Add(len, end)
                IfCondition LessThan(end, 0) ThenBlock: { end = 0 }
            }
            IfCondition GreaterThan(end, len) ThenBlock: { end = len }
        }
        IfCondition LessThan(end, begin) ThenBlock: { end = begin }
        kind = JSVM_TA_Kind(ta)
        es = JSVM_TA_ElementSize(kind)
        buf = JSRT_ObjGet(ta, "__ta_buf__")
        off_v = JSRT_ObjGet(ta, "__ta_off__")
        base = Float_ToInt(JSRT_GetPayload(off_v))
        nlen = Subtract(end, begin)
        nta = JSVM_TypedArrayCreate(kind, buf, Add(base, Multiply(begin, es)), nlen)
        // same proto as this
        pr = JSRT_ObjGet(ta, "__proto__")
        IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
            JSRT_ObjSet(nta, "__proto__", pr)
        }
        ReturnValue(nta)
    }
}

// DataView constructor
Function.JSVM__NDataViewCtor {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "DataView requires ArrayBuffer")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        buf = Dereference(args)
        IfCondition EqualTo(JSVM_IsArrayBuffer(buf), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "DataView buffer must be ArrayBuffer")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        bl = JSVM_AB_ByteLength(buf)
        bo = 0
        IfCondition GreaterThan(argc, 1) ThenBlock: {
            bo = Float_ToInt(JSRT_ToNumber(Dereference(Add(args, 8))))
        }
        view_len = Subtract(bl, bo)
        IfCondition GreaterThan(argc, 2) ThenBlock: {
            IfCondition NotEqual(JSRT_GetType(Dereference(Add(args, 16))), JSType.UNDEFINED) ThenBlock: {
                view_len = Float_ToInt(JSRT_ToNumber(Dereference(Add(args, 16))))
            }
        }
        IfCondition Or(LessThan(bo, 0), Or(LessThan(view_len, 0), GreaterThan(Add(bo, view_len), bl))) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Invalid DataView range")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        dv = JSRT_CreateObject()
        JSRT_ObjSet(dv, "__dv_buf__", buf)
        JSRT_ObjSet(dv, "__dv_off__", JSRT_CreateNumber(bo))
        JSRT_ObjSet(dv, "__dv_len__", JSRT_CreateNumber(view_len))
        JSRT_ObjSet(dv, "buffer", buf)
        JSRT_ObjSet(dv, "byteOffset", JSRT_CreateNumber(bo))
        JSRT_ObjSet(dv, "byteLength", JSRT_CreateNumber(view_len))
        JSBridge__SetAttrBits(dv, "buffer", 0)
        JSBridge__SetAttrBits(dv, "byteOffset", 0)
        JSBridge__SetAttrBits(dv, "byteLength", 0)
        nt = JSVM__GetGlobal("__new_target__")
        IfCondition EqualTo(JSRT_GetType(nt), JSType.FUNCTION) ThenBlock: {
            pr = JSRT_ObjGet(nt, "prototype")
            IfCondition EqualTo(JSRT_GetType(pr), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(dv, "__proto__", pr)
            }
        }
        ReturnValue(dv)
    }
}

// DataView getUint8 / setUint8 as templates for others
Function.JSVM__NDVGetUint8 {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        dv = recv
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            dv = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        boff = 0
        IfCondition GreaterThan(argc, 0) ThenBlock: {
            boff = Float_ToInt(JSRT_ToNumber(Dereference(args)))
        }
        buf = JSRT_ObjGet(dv, "__dv_buf__")
        base = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_off__")))
        vlen = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_len__")))
        IfCondition Or(LessThan(boff, 0), GreaterThan(Add(boff, 1), vlen)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Offset outside DataView")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        data = JSVM_AB_DataPtr(buf)
        b = GetByte(Add(data, Add(base, boff)), 0)
        ReturnValue(JSRT_CreateNumber(b))
    }
}

Function.JSVM__NDVSetUint8 {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        dv = recv
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            dv = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition LessThan(argc, 2) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        boff = Float_ToInt(JSRT_ToNumber(Dereference(args)))
        val = Float_ToInt(JSRT_ToNumber(Dereference(Add(args, 8))))
        buf = JSRT_ObjGet(dv, "__dv_buf__")
        base = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_off__")))
        vlen = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_len__")))
        IfCondition Or(LessThan(boff, 0), GreaterThan(Add(boff, 1), vlen)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Offset outside DataView")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        data = JSVM_AB_DataPtr(buf)
        SetByte(Add(data, Add(base, boff)), 0, BitwiseAnd(val, 255))
        ReturnValue(JSRT_Undefined())
    }
}

// Generic DataView get/set for 1/2/4/8-byte LE integer kinds.
// kind: 0=u8 1=i8 2=u16 3=i16 4=u32 5=i32 6=f32 7=f64
Function.JSVM__NDVGetN {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        dv = recv
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            dv = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        boff = 0
        IfCondition GreaterThan(argc, 0) ThenBlock: {
            boff = Float_ToInt(JSRT_ToNumber(Dereference(args)))
        }
        es = 1
        IfCondition Or(EqualTo(kind, 2), EqualTo(kind, 3)) ThenBlock: { es = 2 }
        IfCondition Or(EqualTo(kind, 4), Or(EqualTo(kind, 5), EqualTo(kind, 6))) ThenBlock: { es = 4 }
        IfCondition EqualTo(kind, 7) ThenBlock: { es = 8 }
        buf = JSRT_ObjGet(dv, "__dv_buf__")
        base = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_off__")))
        vlen = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_len__")))
        IfCondition Or(LessThan(boff, 0), GreaterThan(Add(boff, es), vlen)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Offset outside DataView")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        data = JSVM_AB_DataPtr(buf)
        p = Add(data, Add(base, boff))
        IfCondition EqualTo(kind, 0) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(GetByte(p, 0)))
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            b = GetByte(p, 0)
            IfCondition GreaterThan(b, 127) ThenBlock: { b = Subtract(b, 256) }
            ReturnValue(JSRT_CreateNumber(b))
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            v = Add(GetByte(p, 0), Multiply(GetByte(p, 1), 256))
            ReturnValue(JSRT_CreateNumber(v))
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            v = Add(GetByte(p, 0), Multiply(GetByte(p, 1), 256))
            IfCondition GreaterThan(v, 32767) ThenBlock: { v = Subtract(v, 65536) }
            ReturnValue(JSRT_CreateNumber(v))
        }
        IfCondition Or(EqualTo(kind, 4), EqualTo(kind, 5)) ThenBlock: {
            b0 = GetByte(p, 0)
            b1 = GetByte(p, 1)
            b2 = GetByte(p, 2)
            b3 = GetByte(p, 3)
            v = b0
            v = Add(v, Multiply(b1, 256))
            v = Add(v, Multiply(b2, 65536))
            v = Add(v, Multiply(b3, 16777216))
            IfCondition EqualTo(kind, 5) ThenBlock: {
                IfCondition GreaterEqual(v, 2147483648) ThenBlock: {
                    v = Subtract(v, 4294967296)
                }
            }
            IfCondition EqualTo(kind, 4) ThenBlock: {
                vf = Float_FromInt(b0)
                vf = Float_Add(vf, Float_FromInt(Multiply(b1, 256)))
                vf = Float_Add(vf, Float_FromInt(Multiply(b2, 65536)))
                vf = Float_Add(vf, Float_Mul(Float_FromInt(b3), Float_FromInt(16777216)))
                ReturnValue(JSRT_CreateFloat(vf))
            }
            ReturnValue(JSRT_CreateNumber(v))
        }
        // f32/f64 MVP: reassemble bits via CreateFloat
        IfCondition EqualTo(kind, 6) ThenBlock: {
            bits = GetByte(p, 0)
            bits = Add(bits, Multiply(GetByte(p, 1), 256))
            bits = Add(bits, Multiply(GetByte(p, 2), 65536))
            bits = Add(bits, Multiply(GetByte(p, 3), 16777216))
            ReturnValue(JSRT_CreateFloat(bits))
        }
        bits = 0
        bi = 0
        WhileLoop LessThan(bi, 8) {
            sh = GetByte(p, bi)
            sj = 0
            WhileLoop LessThan(sj, bi) {
                sh = Multiply(sh, 256)
                sj = Add(sj, 1)
            }
            bits = Add(bits, sh)
            bi = Add(bi, 1)
        }
        ReturnValue(JSRT_CreateFloat(bits))
    }
}

Function.JSVM__NDVSetN {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        dv = recv
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            dv = JSVM__GetGlobal("this")
        }
        IfCondition EqualTo(JSVM_IsDataView(dv), 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition LessThan(argc, 2) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        boff = Float_ToInt(JSRT_ToNumber(Dereference(args)))
        nbits = JSRT_ToNumber(Dereference(Add(args, 8)))
        ni = Float_ToInt(nbits)
        es = 1
        IfCondition Or(EqualTo(kind, 2), EqualTo(kind, 3)) ThenBlock: { es = 2 }
        IfCondition Or(EqualTo(kind, 4), Or(EqualTo(kind, 5), EqualTo(kind, 6))) ThenBlock: { es = 4 }
        IfCondition EqualTo(kind, 7) ThenBlock: { es = 8 }
        buf = JSRT_ObjGet(dv, "__dv_buf__")
        base = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_off__")))
        vlen = Float_ToInt(JSRT_GetPayload(JSRT_ObjGet(dv, "__dv_len__")))
        IfCondition Or(LessThan(boff, 0), GreaterThan(Add(boff, es), vlen)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "Offset outside DataView")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        data = JSVM_AB_DataPtr(buf)
        p = Add(data, Add(base, boff))
        IfCondition Or(EqualTo(kind, 0), EqualTo(kind, 1)) ThenBlock: {
            SetByte(p, 0, BitwiseAnd(ni, 255))
            ReturnValue(JSRT_Undefined())
        }
        IfCondition Or(EqualTo(kind, 2), EqualTo(kind, 3)) ThenBlock: {
            SetByte(p, 0, BitwiseAnd(ni, 255))
            SetByte(p, 1, BitwiseAnd(Divide(ni, 256), 255))
            ReturnValue(JSRT_Undefined())
        }
        IfCondition Or(EqualTo(kind, 4), EqualTo(kind, 5)) ThenBlock: {
            u = ni
            SetByte(p, 0, BitwiseAnd(u, 255))
            u = Divide(u, 256)
            SetByte(p, 1, BitwiseAnd(u, 255))
            u = Divide(u, 256)
            SetByte(p, 2, BitwiseAnd(u, 255))
            u = Divide(u, 256)
            SetByte(p, 3, BitwiseAnd(u, 255))
            ReturnValue(JSRT_Undefined())
        }
        // f32/f64: write number payload bits
        nv = JSRT_CreateFloat(nbits)
        bits = JSRT_GetPayload(nv)
        bi = 0
        tmp = bits
        WhileLoop LessThan(bi, es) {
            SetByte(p, bi, BitwiseAnd(tmp, 255))
            tmp = Divide(tmp, 256)
            bi = Add(bi, 1)
        }
        ReturnValue(JSRT_Undefined())
    }
}

// Install methods once on %TypedArray%.prototype (shared)
Function.JSVM__InstallTAProtoMethods {
    Input: ta_proto: Address
    Output: Integer
    Body: {
        proto = ta_proto
        // helper: install one method name/id/len onto proto
        // (unrolled for Ailang)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.TA_SET, "set", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "set", mf)
        JSBridge__SetAttrBits(proto, "set", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.TA_SUBARRAY, "subarray", 2)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "subarray", mf)
        JSBridge__SetAttrBits(proto, "subarray", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_MAP, "map", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "map", mf)
        JSBridge__SetAttrBits(proto, "map", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FILTER, "filter", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "filter", mf)
        JSBridge__SetAttrBits(proto, "filter", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FOR_EACH, "forEach", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "forEach", mf)
        JSBridge__SetAttrBits(proto, "forEach", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_EVERY, "every", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "every", mf)
        JSBridge__SetAttrBits(proto, "every", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_SOME, "some", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "some", mf)
        JSBridge__SetAttrBits(proto, "some", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FIND, "find", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "find", mf)
        JSBridge__SetAttrBits(proto, "find", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FIND_INDEX, "findIndex", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "findIndex", mf)
        JSBridge__SetAttrBits(proto, "findIndex", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FIND_LAST, "findLast", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "findLast", mf)
        JSBridge__SetAttrBits(proto, "findLast", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FIND_LAST_INDEX, "findLastIndex", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "findLastIndex", mf)
        JSBridge__SetAttrBits(proto, "findLastIndex", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_REDUCE, "reduce", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "reduce", mf)
        JSBridge__SetAttrBits(proto, "reduce", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_REDUCE_RIGHT, "reduceRight", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "reduceRight", mf)
        JSBridge__SetAttrBits(proto, "reduceRight", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_INDEX_OF, "indexOf", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "indexOf", mf)
        JSBridge__SetAttrBits(proto, "indexOf", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_LAST_INDEX_OF, "lastIndexOf", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "lastIndexOf", mf)
        JSBridge__SetAttrBits(proto, "lastIndexOf", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_INCLUDES, "includes", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "includes", mf)
        JSBridge__SetAttrBits(proto, "includes", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_JOIN, "join", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "join", mf)
        JSBridge__SetAttrBits(proto, "join", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_TO_STRING, "toString", 0)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "toString", mf)
        JSBridge__SetAttrBits(proto, "toString", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_FILL, "fill", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "fill", mf)
        JSBridge__SetAttrBits(proto, "fill", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_COPY_WITHIN, "copyWithin", 2)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "copyWithin", mf)
        JSBridge__SetAttrBits(proto, "copyWithin", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_REVERSE, "reverse", 0)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "reverse", mf)
        JSBridge__SetAttrBits(proto, "reverse", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_SLICE, "slice", 2)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "slice", mf)
        JSBridge__SetAttrBits(proto, "slice", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_SORT, "sort", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "sort", mf)
        JSBridge__SetAttrBits(proto, "sort", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_AT, "at", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "at", mf)
        JSBridge__SetAttrBits(proto, "at", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_VALUES, "values", 0)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "values", mf)
        JSBridge__SetAttrBits(proto, "values", 5)
        IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
            iks = JSVM_SymbolToKey(JSVMSymbol.iterator)
            IfCondition NotEqual(iks, 0) ThenBlock: {
                JSRT_ObjSet(proto, iks, mf)
                JSBridge__SetAttrBits(proto, iks, 5)
            }
        }
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_KEYS, "keys", 0)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "keys", mf)
        JSBridge__SetAttrBits(proto, "keys", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_ENTRIES, "entries", 0)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "entries", mf)
        JSBridge__SetAttrBits(proto, "entries", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_WITH, "with", 2)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "with", mf)
        JSBridge__SetAttrBits(proto, "with", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_TO_REVERSED, "toReversed", 0)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "toReversed", mf)
        JSBridge__SetAttrBits(proto, "toReversed", 5)
        JSRT__Push(proto)
        mf = JSBridge__CreateNativeFunc(JSNativeID.ARR_TO_SORTED, "toSorted", 1)
        proto = JSRT__Pop()
        JSRT_ObjSet(proto, "toSorted", mf)
        JSBridge__SetAttrBits(proto, "toSorted", 5)
        ReturnValue(1)
    }
}

// Install one TypedArray ctor; methods live on shared ta_proto.
Function.JSVM__InstallOneTA {
    Input: kind: Integer
    Input: name: Address
    Input: nid: Integer
    Input: bpe: Integer
    Input: ta_proto: Address
    Output: Address
    Body: {
        save_name = name
        save_nid = nid
        save_bpe = bpe
        save_tp = ta_proto
        ctor = JSBridge__CreateNativeFunc(save_nid, save_name, 3)
        JSVM__SetGlobal(save_name, ctor)
        JSRT_ObjSet(ctor, "BYTES_PER_ELEMENT", JSRT_CreateNumber(save_bpe))
        JSBridge__SetAttrBits(ctor, "BYTES_PER_ELEMENT", 0)
        proto = JSRT_ObjGet(ctor, "prototype")
        IfCondition EqualTo(JSRT_GetType(proto), JSType.OBJECT) ThenBlock: {
            // [[Prototype]] = %TypedArray%.prototype
            IfCondition EqualTo(JSRT_GetType(save_tp), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(proto, "__proto__", save_tp)
            } ElseBlock: {
                IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                    JSRT_ObjSet(proto, "__proto__", JSRTState.object_proto)
                }
            }
            JSRT_ObjSet(proto, "BYTES_PER_ELEMENT", JSRT_CreateNumber(save_bpe))
            JSBridge__SetAttrBits(proto, "BYTES_PER_ELEMENT", 0)
            JSRT_ObjSet(proto, "constructor", ctor)
            JSBridge__SetAttrBits(proto, "constructor", 1)
        }
        ReturnValue(ctor)
    }
}

// Install ArrayBuffer, all TypedArray ctors, DataView into globals.
Function.JSVM_InstallTypedArrayBuiltins {
    Output: Integer
    Body: {
        // ArrayBuffer
        ab_ctor = JSBridge__CreateNativeFunc(JSNativeID.AB_CTOR, "ArrayBuffer", 1)
        JSVM__SetGlobal("ArrayBuffer", ab_ctor)
        JSRT__Push(ab_ctor)
        isv = JSBridge__CreateNativeFunc(JSNativeID.AB_IS_VIEW, "isView", 1)
        ab_ctor = JSRT__Pop()
        JSRT_ObjSet(ab_ctor, "isView", isv)
        JSBridge__SetAttrBits(ab_ctor, "isView", 5)
        ab_proto = JSRT_ObjGet(ab_ctor, "prototype")
        IfCondition EqualTo(JSRT_GetType(ab_proto), JSType.OBJECT) ThenBlock: {
            IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                JSRT_ObjSet(ab_proto, "__proto__", JSRTState.object_proto)
            }
            JSRT_ObjSet(ab_proto, "constructor", ab_ctor)
            JSBridge__SetAttrBits(ab_proto, "constructor", 1)
            JSRT__Push(ab_ctor)
            JSRT__Push(ab_proto)
            sl = JSBridge__CreateNativeFunc(JSNativeID.AB_SLICE, "slice", 2)
            ab_proto = JSRT__Pop()
            ab_ctor = JSRT__Pop()
            JSRT_ObjSet(ab_proto, "slice", sl)
            JSBridge__SetAttrBits(ab_proto, "slice", 5)
        }

        // %TypedArray%.prototype — shared methods (inherited by all TAs)
        ta_proto = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(ta_proto, "__proto__", JSRTState.object_proto)
        }
        JSVM__InstallTAProtoMethods(ta_proto)
        JSVM__SetGlobal("__TypedArrayProto__", ta_proto)

        // TypedArray constructors (kind 0..10)
        JSVM__InstallOneTA(0, "Int8Array", JSNativeID.TA_INT8, 1, ta_proto)
        JSVM__InstallOneTA(1, "Uint8Array", JSNativeID.TA_UINT8, 1, ta_proto)
        JSVM__InstallOneTA(2, "Uint8ClampedArray", JSNativeID.TA_UINT8C, 1, ta_proto)
        JSVM__InstallOneTA(3, "Int16Array", JSNativeID.TA_INT16, 2, ta_proto)
        JSVM__InstallOneTA(4, "Uint16Array", JSNativeID.TA_UINT16, 2, ta_proto)
        JSVM__InstallOneTA(5, "Int32Array", JSNativeID.TA_INT32, 4, ta_proto)
        JSVM__InstallOneTA(6, "Uint32Array", JSNativeID.TA_UINT32, 4, ta_proto)
        JSVM__InstallOneTA(7, "Float32Array", JSNativeID.TA_FLOAT32, 4, ta_proto)
        JSVM__InstallOneTA(8, "Float64Array", JSNativeID.TA_FLOAT64, 8, ta_proto)
        JSVM__InstallOneTA(9, "BigInt64Array", JSNativeID.TA_BIGINT64, 8, ta_proto)
        JSVM__InstallOneTA(10, "BigUint64Array", JSNativeID.TA_BIGUINT64, 8, ta_proto)

        // DataView
        dv_ctor = JSBridge__CreateNativeFunc(JSNativeID.DV_CTOR, "DataView", 3)
        JSVM__SetGlobal("DataView", dv_ctor)
        dv_proto = JSRT_ObjGet(dv_ctor, "prototype")
        IfCondition EqualTo(JSRT_GetType(dv_proto), JSType.OBJECT) ThenBlock: {
            IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                JSRT_ObjSet(dv_proto, "__proto__", JSRTState.object_proto)
            }
            JSRT_ObjSet(dv_proto, "constructor", dv_ctor)
            JSBridge__SetAttrBits(dv_proto, "constructor", 1)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_UINT8, "getUint8", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getUint8", mf)
            JSBridge__SetAttrBits(dv_proto, "getUint8", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_UINT8, "setUint8", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setUint8", mf)
            JSBridge__SetAttrBits(dv_proto, "setUint8", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_INT8, "getInt8", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getInt8", mf)
            JSBridge__SetAttrBits(dv_proto, "getInt8", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_INT8, "setInt8", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setInt8", mf)
            JSBridge__SetAttrBits(dv_proto, "setInt8", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_UINT16, "getUint16", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getUint16", mf)
            JSBridge__SetAttrBits(dv_proto, "getUint16", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_UINT16, "setUint16", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setUint16", mf)
            JSBridge__SetAttrBits(dv_proto, "setUint16", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_INT16, "getInt16", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getInt16", mf)
            JSBridge__SetAttrBits(dv_proto, "getInt16", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_INT16, "setInt16", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setInt16", mf)
            JSBridge__SetAttrBits(dv_proto, "setInt16", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_UINT32, "getUint32", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getUint32", mf)
            JSBridge__SetAttrBits(dv_proto, "getUint32", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_UINT32, "setUint32", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setUint32", mf)
            JSBridge__SetAttrBits(dv_proto, "setUint32", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_INT32, "getInt32", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getInt32", mf)
            JSBridge__SetAttrBits(dv_proto, "getInt32", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_INT32, "setInt32", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setInt32", mf)
            JSBridge__SetAttrBits(dv_proto, "setInt32", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_FLOAT32, "getFloat32", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getFloat32", mf)
            JSBridge__SetAttrBits(dv_proto, "getFloat32", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_FLOAT32, "setFloat32", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setFloat32", mf)
            JSBridge__SetAttrBits(dv_proto, "setFloat32", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_GET_FLOAT64, "getFloat64", 1)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "getFloat64", mf)
            JSBridge__SetAttrBits(dv_proto, "getFloat64", 5)
            JSRT__Push(dv_ctor)
            JSRT__Push(dv_proto)
            mf = JSBridge__CreateNativeFunc(JSNativeID.DV_SET_FLOAT64, "setFloat64", 2)
            dv_proto = JSRT__Pop()
            dv_ctor = JSRT__Pop()
            JSRT_ObjSet(dv_proto, "setFloat64", mf)
            JSBridge__SetAttrBits(dv_proto, "setFloat64", 5)
        }
        ReturnValue(1)
    }
}
