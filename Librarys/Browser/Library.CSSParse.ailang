// Library.CSSParse.ailang — Browser-grade CSS parser
// Parses inline style="" attributes and <style> block content.
// Produces rule objects with selectors and property maps.
// Standalone — no dependency on HTMLTokenizer or HTMLDom.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils

// =============================================================================
// SELECTOR TYPES
// =============================================================================
FixedPool.CSSSelType {
    "UNIVERSAL":   Initialize=1    // *
    "TAG":         Initialize=2    // div, p, span
    "CLASS":       Initialize=3    // .classname
    "ID":          Initialize=4    // #idname
    "COMPOUND":    Initialize=5    // tag.class, tag#id (future)
}

// Combinator types for compound selectors
FixedPool.CSSCmb {
    "NONE":        Initialize=0    // no combinator (simple selector)
    "DESC":        Initialize=1    // descendant (space): div p
    "CHILD":       Initialize=2    // child (>): div > p
    "ADJ":         Initialize=3    // adjacent sibling (+): h1 + p
    "GEN":         Initialize=4    // general sibling (~): h1 ~ p
}

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.CSSConst {
    // Property entry: 32 bytes
    "P_NAME_PTR":    Initialize=0
    "P_NAME_LEN":    Initialize=8
    "P_VAL_PTR":     Initialize=16
    "P_VAL_LEN":     Initialize=24
    "PROP_SIZE":     Initialize=32
    "MAX_PROPS":     Initialize=16384

    // Rule entry: 80 bytes
    "R_SEL_TYPE":    Initialize=0     // CSSSelType (subject)
    "R_SEL_PTR":     Initialize=8     // selector string pointer
    "R_SEL_LEN":     Initialize=16    // selector string length
    "R_PROP_FIRST":  Initialize=24    // first property index
    "R_PROP_CT":     Initialize=32    // property count
    "R_SPECIFICITY": Initialize=40    // computed specificity
    "R_CMB_TYPE":    Initialize=48    // combinator: 0=none, 1=descendant, 2=child, 3=adjacent+, 4=general~
    "R_CMB_SEL_TYPE": Initialize=56   // ancestor selector type
    "R_CMB_SEL_PTR": Initialize=64    // ancestor selector string
    "R_CMB_SEL_LEN": Initialize=72    // ancestor selector string length
    "R_PSEUDO":      Initialize=80    // 0=none, 1=interactive (skip), 2=structural
    "RULE_SIZE":     Initialize=88
    "MAX_RULES":     Initialize=4096

    // String intern table
    "STR_CAP":       Initialize=524288  // 512 KB

    // Important flag bit (stored in upper bit of P_VAL_LEN)
    "IMPORTANT_BIT": Initialize=2147483648  // 1 << 31
}

// =============================================================================
// PARSER STATE
// =============================================================================
FixedPool.CSSState {
    // Property pool
    "prop_pool":   Initialize=0
    "prop_count":  Initialize=0

    // Rule pool
    "rule_pool":   Initialize=0
    "rule_count":  Initialize=0

    // String intern
    "str_buf":     Initialize=0
    "str_pos":     Initialize=0

    // Lexer cursor
    "source":      Initialize=0
    "src_len":     Initialize=0
    "pos":         Initialize=0
    "error":       Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.CSSTmp {
    "ch":          Initialize=0
    "ch2":         Initialize=0
    "start":       Initialize=0
    "len":         Initialize=0
    "ptr":         Initialize=0
    "interned":    Initialize=0
    "val":         Initialize=0
    "done":        Initialize=0
    "rule":        Initialize=0
    "prop":        Initialize=0
    "count":       Initialize=0
    "spec":        Initialize=0
    "pseudo":      Initialize=0     // 0=none, 1=interactive, 2=structural
}

// =============================================================================
// INIT / RESET
// =============================================================================
Function.CSS_Init {
    Output: Integer
    Body: {
        // Property pool
        psz = Multiply(CSSConst.MAX_PROPS, CSSConst.PROP_SIZE)
        CSSState.prop_pool = Allocate(psz)
        IfCondition EqualTo(CSSState.prop_pool, 0) ThenBlock: {
            PrintMessage("[CSS] prop alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(CSSState.prop_pool, 0, psz)
        CSSState.prop_count = 0

        // Rule pool
        rsz = Multiply(CSSConst.MAX_RULES, CSSConst.RULE_SIZE)
        CSSState.rule_pool = Allocate(rsz)
        IfCondition EqualTo(CSSState.rule_pool, 0) ThenBlock: {
            PrintMessage("[CSS] rule alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(CSSState.rule_pool, 0, rsz)
        CSSState.rule_count = 0

        // String table
        CSSState.str_buf = Allocate(CSSConst.STR_CAP)
        IfCondition EqualTo(CSSState.str_buf, 0) ThenBlock: {
            PrintMessage("[CSS] string alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(CSSState.str_buf, 0, CSSConst.STR_CAP)
        CSSState.str_pos = 0

        CSSState.error = 0
        CSS_VarInit()
        ReturnValue(1)
    }
}

Function.CSS_Reset {
    Body: {
        psz = Multiply(CSSConst.MAX_PROPS, CSSConst.PROP_SIZE)
        MemorySet(CSSState.prop_pool, 0, psz)
        CSSState.prop_count = 0

        rsz = Multiply(CSSConst.MAX_RULES, CSSConst.RULE_SIZE)
        MemorySet(CSSState.rule_pool, 0, rsz)
        CSSState.rule_count = 0

        CSSState.str_pos = 0
        CSSState.pos = 0
        CSSState.error = 0
        CSS_VarReset()
    }
}

// =============================================================================
// STRING INTERNING — lowercase on intern for property names
// =============================================================================
Function.CSS__Intern {
    Input: src: Address
    Input: len: Integer
    Output: Address
    Body: {
        needed = Add(CSSState.str_pos, Add(len, 1))
        IfCondition GreaterEqual(needed, CSSConst.STR_CAP) ThenBlock: {
            PrintMessage("[CSS] STRING INTERN OVERFLOW at pos=")
            PrintNumber(CSSState.str_pos)
            PrintMessage("\n")
            ReturnValue(0)
        }
        dest = Add(CSSState.str_buf, CSSState.str_pos)
        IfCondition GreaterThan(len, 0) ThenBlock: {
            MemoryCopy(dest, src, len)
        }
        SetByte(dest, len, 0)
        CSSState.str_pos = Add(CSSState.str_pos, Add(len, 1))
        ReturnValue(dest)
    }
}

Function.CSS__InternLower {
    Input: src: Address
    Input: len: Integer
    Output: Address
    Body: {
        needed = Add(CSSState.str_pos, Add(len, 1))
        IfCondition GreaterEqual(needed, CSSConst.STR_CAP) ThenBlock: {
            PrintMessage("[CSS] STRING INTERN OVERFLOW (lower) at pos=")
            PrintNumber(CSSState.str_pos)
            PrintMessage("\n")
            ReturnValue(0)
        }
        dest = Add(CSSState.str_buf, CSSState.str_pos)
        ci = 0
        WhileLoop LessThan(ci, len) {
            ch = GetByte(src, ci)
            IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: {
                ch = Add(ch, 32)
            }
            SetByte(dest, ci, ch)
            ci = Add(ci, 1)
        }
        SetByte(dest, len, 0)
        CSSState.str_pos = Add(CSSState.str_pos, Add(len, 1))
        ReturnValue(dest)
    }
}

// =============================================================================
// LEXER HELPERS
// =============================================================================
Function.CSS__Peek {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(CSSState.pos, CSSState.src_len) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(GetByte(CSSState.source, CSSState.pos))
    }
}

Function.CSS__PeekAt {
    Input: offset: Integer
    Output: Integer
    Body: {
        p = Add(CSSState.pos, offset)
        IfCondition GreaterEqual(p, CSSState.src_len) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(GetByte(CSSState.source, p))
    }
}

Function.CSS__Advance {
    Body: {
        CSSState.pos = Add(CSSState.pos, 1)
    }
}

Function.CSS__SkipWhitespace {
    Body: {
        WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
            CSSTmp.ch = GetByte(CSSState.source, CSSState.pos)
            is_space = EqualTo(CSSTmp.ch, 32)
            is_tab = EqualTo(CSSTmp.ch, 9)
            is_nl = EqualTo(CSSTmp.ch, 10)
            is_cr = EqualTo(CSSTmp.ch, 13)
            is_ws = Or(is_space, Or(is_tab, Or(is_nl, is_cr)))
            IfCondition EqualTo(is_ws, 0) ThenBlock: {
                BreakLoop
            }
            CSSState.pos = Add(CSSState.pos, 1)
        }
    }
}

// Skip /* ... */ comments
Function.CSS__SkipComment {
    Body: {
        CSSTmp.ch = CSS__Peek()
        IfCondition NotEqual(CSSTmp.ch, 47) ThenBlock: { ReturnValue(0) }
        CSSTmp.ch2 = CSS__PeekAt(1)
        IfCondition NotEqual(CSSTmp.ch2, 42) ThenBlock: { ReturnValue(0) }

        // Skip /*
        CSS__Advance()
        CSS__Advance()

        // Scan to */
        WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
            c1 = GetByte(CSSState.source, CSSState.pos)
            IfCondition EqualTo(c1, 42) ThenBlock: {
                c2 = CSS__PeekAt(1)
                IfCondition EqualTo(c2, 47) ThenBlock: {
                    CSS__Advance()
                    CSS__Advance()
                    BreakLoop
                }
            }
            CSSState.pos = Add(CSSState.pos, 1)
        }
    }
}

// Skip whitespace and comments
Function.CSS__SkipWS {
    Body: {
        prev_pos = -1
        WhileLoop NotEqual(CSSState.pos, prev_pos) {
            prev_pos = CSSState.pos
            CSS__SkipWhitespace()
            CSS__SkipComment()
        }
    }
}

// Check if char is valid CSS identifier char
Function.CSS__IsIdentChar {
    Input: ch: Integer
    Output: Integer
    Body: {
        // a-z
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: { ReturnValue(1) }
        // A-Z
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { ReturnValue(1) }
        // 0-9
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: { ReturnValue(1) }
        // - (45), _ (95)
        IfCondition EqualTo(ch, 45) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 95) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// =============================================================================
// PROPERTY POOL
// =============================================================================
Function.CSS__PropAddr {
    Input: idx: Integer
    Output: Address
    Body: {
        off = Multiply(idx, CSSConst.PROP_SIZE)
        ReturnValue(Add(CSSState.prop_pool, off))
    }
}

Function.CSS__AddProp {
    Input: name_ptr: Address
    Input: name_len: Integer
    Input: val_ptr: Address
    Input: val_len: Integer
    Output: Integer
    Body: {
        idx = CSSState.prop_count
        IfCondition GreaterEqual(idx, CSSConst.MAX_PROPS) ThenBlock: {
            PrintMessage("[CSS] prop pool full\n")
            ReturnValue(-1)
        }
        CSSState.prop_count = Add(idx, 1)

        CSSTmp.ptr = CSS__PropAddr(idx)
        StoreValue(Add(CSSTmp.ptr, CSSConst.P_NAME_PTR), name_ptr)
        StoreValue(Add(CSSTmp.ptr, CSSConst.P_NAME_LEN), name_len)
        StoreValue(Add(CSSTmp.ptr, CSSConst.P_VAL_PTR), val_ptr)
        StoreValue(Add(CSSTmp.ptr, CSSConst.P_VAL_LEN), val_len)
        ReturnValue(idx)
    }
}

// =============================================================================
// RULE POOL
// =============================================================================
Function.CSS__RuleAddr {
    Input: idx: Integer
    Output: Address
    Body: {
        off = Multiply(idx, CSSConst.RULE_SIZE)
        ReturnValue(Add(CSSState.rule_pool, off))
    }
}

Function.CSS__RuleGet {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        CSSTmp.ptr = CSS__RuleAddr(idx)
        ReturnValue(Dereference(Add(CSSTmp.ptr, field)))
    }
}

Function.CSS__RuleSet {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        CSSTmp.ptr = CSS__RuleAddr(idx)
        StoreValue(Add(CSSTmp.ptr, field), val)
    }
}

Function.CSS__CreateRule {
    Input: sel_type: Integer
    Input: sel_ptr: Address
    Input: sel_len: Integer
    Output: Integer
    Body: {
        idx = CSSState.rule_count
        IfCondition GreaterEqual(idx, CSSConst.MAX_RULES) ThenBlock: {
            PrintMessage("[CSS] rule pool full\n")
            ReturnValue(-1)
        }
        CSSState.rule_count = Add(idx, 1)

        CSS__RuleSet(idx, CSSConst.R_SEL_TYPE, sel_type)
        CSS__RuleSet(idx, CSSConst.R_SEL_PTR, sel_ptr)
        CSS__RuleSet(idx, CSSConst.R_SEL_LEN, sel_len)
        CSS__RuleSet(idx, CSSConst.R_PROP_FIRST, CSSState.prop_count)
        CSS__RuleSet(idx, CSSConst.R_PROP_CT, 0)
        CSS__RuleSet(idx, CSSConst.R_SPECIFICITY, 0)
        ReturnValue(idx)
    }
}

// =============================================================================
// SPECIFICITY CALCULATION
// #id = 100, .class = 10, tag = 1, * = 0
// =============================================================================
Function.CSS__CalcSpecificity {
    Input: sel_type: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sel_type, CSSSelType.ID) ThenBlock: { ReturnValue(100) }
        IfCondition EqualTo(sel_type, CSSSelType.CLASS) ThenBlock: { ReturnValue(10) }
        IfCondition EqualTo(sel_type, CSSSelType.TAG) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// =============================================================================
// SHORTHAND EXPANSION — expands box-model shorthands into individual properties
// margin → margin-top/right/bottom/left
// padding → padding-top/right/bottom/left
// border-width → border-top-width/right/bottom/left
// border-style → border-top-style/right/bottom/left
// border-color → border-top-color/right/bottom/left
// =============================================================================
Function.CSS__ExpandBoxShorthand {
    Input: top_name: Address
    Input: right_name: Address
    Input: bottom_name: Address
    Input: left_name: Address
    Input: val_ptr: Address
    Input: store_len: Integer
    Body: {
        // Derive actual value length from store_len (mask out important bit)
        val_len = BitwiseAnd(store_len, 2147483647)
        // Parse value into 1-4 parts by splitting on whitespace
        // Scan for up to 4 values
        src = val_ptr
        slen = val_len
        pos = 0

        // Skip leading whitespace
        WhileLoop LessThan(pos, slen) {
            bch = GetByte(src, pos)
            IfCondition Or(EqualTo(bch, 32), EqualTo(bch, 9)) ThenBlock: {
                pos = Add(pos, 1)
            } ElseBlock: { BreakLoop }
        }

        // Value 1 start
        v1_start = pos
        v1_len = 0
        val_count = 0
        IfCondition LessThan(pos, slen) ThenBlock: {
            // Scan non-whitespace for value 1
            WhileLoop LessThan(pos, slen) {
                bch = GetByte(src, pos)
                IfCondition Or(EqualTo(bch, 32), EqualTo(bch, 9)) ThenBlock: { BreakLoop }
                pos = Add(pos, 1)
            }
            v1_len = Subtract(pos, v1_start)
            val_count = 1

            // Skip whitespace
            WhileLoop LessThan(pos, slen) {
                bch = GetByte(src, pos)
                IfCondition Or(EqualTo(bch, 32), EqualTo(bch, 9)) ThenBlock: {
                    pos = Add(pos, 1)
                } ElseBlock: { BreakLoop }
            }
        }

        // Value 2 start
        v2_start = pos
        v2_len = 0
        IfCondition LessThan(pos, slen) ThenBlock: {
            WhileLoop LessThan(pos, slen) {
                bch = GetByte(src, pos)
                IfCondition Or(EqualTo(bch, 32), EqualTo(bch, 9)) ThenBlock: { BreakLoop }
                pos = Add(pos, 1)
            }
            v2_len = Subtract(pos, v2_start)
            IfCondition GreaterThan(v2_len, 0) ThenBlock: { val_count = 2 }
            WhileLoop LessThan(pos, slen) {
                bch = GetByte(src, pos)
                IfCondition Or(EqualTo(bch, 32), EqualTo(bch, 9)) ThenBlock: {
                    pos = Add(pos, 1)
                } ElseBlock: { BreakLoop }
            }
        }

        // Value 3 start
        v3_start = pos
        v3_len = 0
        IfCondition LessThan(pos, slen) ThenBlock: {
            WhileLoop LessThan(pos, slen) {
                bch = GetByte(src, pos)
                IfCondition Or(EqualTo(bch, 32), EqualTo(bch, 9)) ThenBlock: { BreakLoop }
                pos = Add(pos, 1)
            }
            v3_len = Subtract(pos, v3_start)
            IfCondition GreaterThan(v3_len, 0) ThenBlock: { val_count = 3 }
            WhileLoop LessThan(pos, slen) {
                bch = GetByte(src, pos)
                IfCondition Or(EqualTo(bch, 32), EqualTo(bch, 9)) ThenBlock: {
                    pos = Add(pos, 1)
                } ElseBlock: { BreakLoop }
            }
        }

        // Value 4 start
        v4_start = pos
        v4_len = 0
        IfCondition LessThan(pos, slen) ThenBlock: {
            WhileLoop LessThan(pos, slen) {
                bch = GetByte(src, pos)
                IfCondition Or(EqualTo(bch, 32), EqualTo(bch, 9)) ThenBlock: { BreakLoop }
                pos = Add(pos, 1)
            }
            v4_len = Subtract(pos, v4_start)
            IfCondition GreaterThan(v4_len, 0) ThenBlock: { val_count = 4 }
        }

        // Now assign top/right/bottom/left based on CSS box shorthand rules:
        // 1 value:  all sides = value1
        // 2 values: top/bottom = value1, left/right = value2
        // 3 values: top = value1, left/right = value2, bottom = value3
        // 4 values: top = value1, right = value2, bottom = value3, left = value4
        t_start = v1_start
        t_len = v1_len
        r_start = v1_start
        r_len = v1_len
        b_start = v1_start
        b_len = v1_len
        l_start = v1_start
        l_len = v1_len

        IfCondition EqualTo(val_count, 2) ThenBlock: {
            // top/bottom = v1, left/right = v2
            r_start = v2_start
            r_len = v2_len
            l_start = v2_start
            l_len = v2_len
        }
        IfCondition EqualTo(val_count, 3) ThenBlock: {
            // top = v1, left/right = v2, bottom = v3
            r_start = v2_start
            r_len = v2_len
            l_start = v2_start
            l_len = v2_len
            b_start = v3_start
            b_len = v3_len
        }
        IfCondition EqualTo(val_count, 4) ThenBlock: {
            // top = v1, right = v2, bottom = v3, left = v4
            r_start = v2_start
            r_len = v2_len
            b_start = v3_start
            b_len = v3_len
            l_start = v4_start
            l_len = v4_len
        }

        // Intern each value and add properties
        // Use store_len's important bit for all expanded properties
        imp_bit = BitwiseAnd(store_len, CSSConst.IMPORTANT_BIT)

        tv = CSS__Intern(Add(src, t_start), t_len)
        t_slen = t_len
        IfCondition NotEqual(imp_bit, 0) ThenBlock: { t_slen = BitwiseOr(t_len, CSSConst.IMPORTANT_BIT) }
        CSS__AddProp(top_name, StringLength(top_name), tv, t_slen)

        rv = CSS__Intern(Add(src, r_start), r_len)
        r_slen = r_len
        IfCondition NotEqual(imp_bit, 0) ThenBlock: { r_slen = BitwiseOr(r_len, CSSConst.IMPORTANT_BIT) }
        CSS__AddProp(right_name, StringLength(right_name), rv, r_slen)

        bv = CSS__Intern(Add(src, b_start), b_len)
        b_slen = b_len
        IfCondition NotEqual(imp_bit, 0) ThenBlock: { b_slen = BitwiseOr(b_len, CSSConst.IMPORTANT_BIT) }
        CSS__AddProp(bottom_name, StringLength(bottom_name), bv, b_slen)

        lv = CSS__Intern(Add(src, l_start), l_len)
        l_slen = l_len
        IfCondition NotEqual(imp_bit, 0) ThenBlock: { l_slen = BitwiseOr(l_len, CSSConst.IMPORTANT_BIT) }
        CSS__AddProp(left_name, StringLength(left_name), lv, l_slen)
    }
}

// =============================================================================
// PARSE PROPERTY DECLARATIONS — "name: value [!important];"
// Returns number of properties parsed
// =============================================================================
Function.CSS__ParseDeclarations {
    Input: rule_idx: Integer
    Output: Integer
    Body: {
        prop_start = CSSState.prop_count
        CSS__SkipWS()

        WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
            CSSTmp.ch = CSS__Peek()

            // End of block
            IfCondition EqualTo(CSSTmp.ch, 125) ThenBlock: {
                // } char — don't consume, caller handles it
                CSSTmp.count = Subtract(CSSState.prop_count, prop_start)
                CSS__RuleSet(rule_idx, CSSConst.R_PROP_CT, CSSTmp.count)
                ReturnValue(CSSTmp.count)
            }

            // End of input (for inline styles that don't have {})
            IfCondition EqualTo(CSSTmp.ch, 0) ThenBlock: {
                CSSTmp.count = Subtract(CSSState.prop_count, prop_start)
                CSS__RuleSet(rule_idx, CSSConst.R_PROP_CT, CSSTmp.count)
                ReturnValue(CSSTmp.count)
            }

            // Scan property name (identifier chars up to ':')
            name_start = CSSState.pos
            WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                nc = GetByte(CSSState.source, CSSState.pos)
                // Stop at : or whitespace or } or ;
                is_colon = EqualTo(nc, 58)
                is_ws_n = Or(EqualTo(nc, 32), Or(EqualTo(nc, 9), Or(EqualTo(nc, 10), EqualTo(nc, 13))))
                is_end = Or(EqualTo(nc, 125), EqualTo(nc, 59))
                is_stop = Or(is_colon, Or(is_ws_n, is_end))
                IfCondition EqualTo(is_stop, 1) ThenBlock: {
                    BreakLoop
                }
                CSSState.pos = Add(CSSState.pos, 1)
            }
            name_len = Subtract(CSSState.pos, name_start)

            // Skip empty names (e.g. leading semicolons)
            IfCondition EqualTo(name_len, 0) ThenBlock: {
                // Skip this char and continue
                IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                    CSS__Advance()
                }
                CSS__SkipWS()
            }

            IfCondition GreaterThan(name_len, 0) ThenBlock: {
                // Intern property name (lowercase)
                CSSTmp.interned = CSS__InternLower(Add(CSSState.source, name_start), name_len)

                CSS__SkipWS()

                // Expect ':'
                CSSTmp.ch = CSS__Peek()
                IfCondition EqualTo(CSSTmp.ch, 58) ThenBlock: {
                    CSS__Advance()
                }

                CSS__SkipWS()

                // Scan value (up to ; or } or end)
                val_start = CSSState.pos
                WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                    vc = GetByte(CSSState.source, CSSState.pos)
                    is_semi = EqualTo(vc, 59)
                    is_brace = EqualTo(vc, 125)
                    IfCondition Or(is_semi, is_brace) ThenBlock: {
                        BreakLoop
                    }
                    CSSState.pos = Add(CSSState.pos, 1)
                }
                val_end = CSSState.pos

                // Trim trailing whitespace from value
                WhileLoop GreaterThan(val_end, val_start) {
                    tc = GetByte(CSSState.source, Subtract(val_end, 1))
                    is_ws_t = Or(EqualTo(tc, 32), Or(EqualTo(tc, 9), Or(EqualTo(tc, 10), EqualTo(tc, 13))))
                    IfCondition EqualTo(is_ws_t, 0) ThenBlock: {
                        BreakLoop
                    }
                    val_end = Subtract(val_end, 1)
                }

                val_len = Subtract(val_end, val_start)

                // Check for !important at end of value
                // Intern last 10 chars and compare with "!important"
                has_important = 0
                IfCondition GreaterEqual(val_len, 10) ThenBlock: {
                    imp_start = Subtract(val_end, 10)
                    imp_src = Add(CSSState.source, imp_start)
                    imp_str = CSS__Intern(imp_src, 10)
                    IfCondition NotEqual(imp_str, 0) ThenBlock: {
                        imp_cmp = StringCompare(imp_str, "!important")
                        IfCondition EqualTo(imp_cmp, 0) ThenBlock: {
                            has_important = 1
                            // Trim !important from value
                            val_end = imp_start
                            // Trim trailing whitespace again
                            WhileLoop GreaterThan(val_end, val_start) {
                                tc2 = GetByte(CSSState.source, Subtract(val_end, 1))
                                is_ws2 = Or(EqualTo(tc2, 32), Or(EqualTo(tc2, 9), EqualTo(tc2, 10)))
                                IfCondition EqualTo(is_ws2, 0) ThenBlock: {
                                    BreakLoop
                                }
                                val_end = Subtract(val_end, 1)
                            }
                            val_len = Subtract(val_end, val_start)
                        }
                    }
                }

                // Intern value
                CSSTmp.val = CSS__Intern(Add(CSSState.source, val_start), val_len)

                // Check if this is a CSS custom property (--name)
                // name_len >= 2 and first two chars are '-' (45)
                CSSVarTmp.is_custom = 0
                IfCondition GreaterEqual(name_len, 2) ThenBlock: {
                    IfCondition NotEqual(CSSTmp.interned, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(CSSTmp.interned, 0), 45) ThenBlock: {
                            IfCondition EqualTo(GetByte(CSSTmp.interned, 1), 45) ThenBlock: {
                                CSSVarTmp.is_custom = 1
                            }
                        }
                    }
                }

                IfCondition EqualTo(CSSVarTmp.is_custom, 1) ThenBlock: {
                    // Store as CSS variable (don't add to regular prop pool)
                    CSS_VarStore(CSSTmp.interned, CSSTmp.val)
                }

                IfCondition EqualTo(CSSVarTmp.is_custom, 0) ThenBlock: {
                    // Store val_len with important bit
                    store_len = val_len
                    IfCondition EqualTo(has_important, 1) ThenBlock: {
                        store_len = BitwiseOr(val_len, CSSConst.IMPORTANT_BIT)
                    }

                    // Detect box-model shorthands and expand to individual properties
                    // This ensures proper cascade: shorthand from page overrides
                    // individual properties from UA stylesheet at same specificity
                    sh_expanded = 0
                    IfCondition EqualTo(name_len, 6) ThenBlock: {
                        IfCondition EqualTo(StringCompare(CSSTmp.interned, "margin"), 0) ThenBlock: {
                            CSS__ExpandBoxShorthand("margin-top", "margin-right", "margin-bottom", "margin-left", CSSTmp.val, store_len)
                            sh_expanded = 1
                        }
                    }
                    IfCondition EqualTo(sh_expanded, 0) ThenBlock: {
                        IfCondition EqualTo(name_len, 7) ThenBlock: {
                            IfCondition EqualTo(StringCompare(CSSTmp.interned, "padding"), 0) ThenBlock: {
                                CSS__ExpandBoxShorthand("padding-top", "padding-right", "padding-bottom", "padding-left", CSSTmp.val, store_len)
                                sh_expanded = 1
                            }
                        }
                    }
                    IfCondition EqualTo(sh_expanded, 0) ThenBlock: {
                        IfCondition EqualTo(name_len, 12) ThenBlock: {
                            IfCondition EqualTo(StringCompare(CSSTmp.interned, "border-width"), 0) ThenBlock: {
                                CSS__ExpandBoxShorthand("border-top-width", "border-right-width", "border-bottom-width", "border-left-width", CSSTmp.val, store_len)
                                sh_expanded = 1
                            }
                            IfCondition EqualTo(sh_expanded, 0) ThenBlock: {
                                IfCondition EqualTo(StringCompare(CSSTmp.interned, "border-style"), 0) ThenBlock: {
                                    CSS__ExpandBoxShorthand("border-top-style", "border-right-style", "border-bottom-style", "border-left-style", CSSTmp.val, store_len)
                                    sh_expanded = 1
                                }
                                IfCondition EqualTo(sh_expanded, 0) ThenBlock: {
                                    IfCondition EqualTo(StringCompare(CSSTmp.interned, "border-color"), 0) ThenBlock: {
                                        CSS__ExpandBoxShorthand("border-top-color", "border-right-color", "border-bottom-color", "border-left-color", CSSTmp.val, store_len)
                                        sh_expanded = 1
                                    }
                                }
                            }
                        }
                    }

                    // Non-shorthand: store directly
                    IfCondition EqualTo(sh_expanded, 0) ThenBlock: {
                        CSS__AddProp(CSSTmp.interned, name_len, CSSTmp.val, store_len)
                    }
                }

                // Skip semicolon
                CSSTmp.ch = CSS__Peek()
                IfCondition EqualTo(CSSTmp.ch, 59) ThenBlock: {
                    CSS__Advance()
                }
            }

            CSS__SkipWS()
        }

        // End of input
        CSSTmp.count = Subtract(CSSState.prop_count, prop_start)
        CSS__RuleSet(rule_idx, CSSConst.R_PROP_CT, CSSTmp.count)
        ReturnValue(CSSTmp.count)
    }
}

// =============================================================================
// PARSE SELECTOR — returns selector type and interns the selector string
// =============================================================================
// Parse one simple selector, return type+ptr+len via CSSTmp fields
// CSSTmp.val = type, CSSTmp.ptr = interned ptr, CSSTmp.len = length
Function.CSS__ParseSimpleSel {
    Body: {
        CSSTmp.ch = CSS__Peek()

        // * (universal)
        IfCondition EqualTo(CSSTmp.ch, 42) ThenBlock: {
            CSS__Advance()
            CSSTmp.val = CSSSelType.UNIVERSAL
            CSSTmp.ptr = 0
            CSSTmp.len = 0
            ReturnValue(0)
        }

        // # (ID selector)
        IfCondition EqualTo(CSSTmp.ch, 35) ThenBlock: {
            CSS__Advance()
            sel_start = CSSState.pos
            WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                sc = GetByte(CSSState.source, CSSState.pos)
                IfCondition EqualTo(CSS__IsIdentChar(sc), 0) ThenBlock: { BreakLoop }
                CSSState.pos = Add(CSSState.pos, 1)
            }
            sel_len = Subtract(CSSState.pos, sel_start)
            CSSTmp.val = CSSSelType.ID
            CSSTmp.ptr = CSS__InternLower(Add(CSSState.source, sel_start), sel_len)
            CSSTmp.len = sel_len
            // Consume additional compound parts (.class, #id2) — keep ID as selector
            IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                cmpd3_ch = GetByte(CSSState.source, CSSState.pos)
                WhileLoop Or(EqualTo(cmpd3_ch, 46), EqualTo(cmpd3_ch, 35)) {
                    CSS__Advance()
                    WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                        cmpd3_sc = GetByte(CSSState.source, CSSState.pos)
                        IfCondition EqualTo(CSS__IsIdentChar(cmpd3_sc), 0) ThenBlock: { BreakLoop }
                        CSSState.pos = Add(CSSState.pos, 1)
                    }
                    IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                        cmpd3_ch = GetByte(CSSState.source, CSSState.pos)
                    } ElseBlock: {
                        cmpd3_ch = 0
                    }
                }
            }
            ReturnValue(0)
        }

        // . (class selector)
        IfCondition EqualTo(CSSTmp.ch, 46) ThenBlock: {
            CSS__Advance()
            sel_start = CSSState.pos
            WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                sc = GetByte(CSSState.source, CSSState.pos)
                IfCondition EqualTo(CSS__IsIdentChar(sc), 0) ThenBlock: { BreakLoop }
                CSSState.pos = Add(CSSState.pos, 1)
            }
            sel_len = Subtract(CSSState.pos, sel_start)
            CSSTmp.val = CSSSelType.CLASS
            CSSTmp.ptr = CSS__InternLower(Add(CSSState.source, sel_start), sel_len)
            CSSTmp.len = sel_len
            // Consume additional compound parts (.class2, #id) — keep first class as selector
            IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                cmpd2_ch = GetByte(CSSState.source, CSSState.pos)
                WhileLoop Or(EqualTo(cmpd2_ch, 46), EqualTo(cmpd2_ch, 35)) {
                    CSS__Advance()
                    WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                        cmpd2_sc = GetByte(CSSState.source, CSSState.pos)
                        IfCondition EqualTo(CSS__IsIdentChar(cmpd2_sc), 0) ThenBlock: { BreakLoop }
                        CSSState.pos = Add(CSSState.pos, 1)
                    }
                    IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                        cmpd2_ch = GetByte(CSSState.source, CSSState.pos)
                    } ElseBlock: {
                        cmpd2_ch = 0
                    }
                }
            }
            ReturnValue(0)
        }

        // Tag name (default)
        sel_start = CSSState.pos
        WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
            sc = GetByte(CSSState.source, CSSState.pos)
            IfCondition EqualTo(CSS__IsIdentChar(sc), 0) ThenBlock: { BreakLoop }
            CSSState.pos = Add(CSSState.pos, 1)
        }
        sel_len = Subtract(CSSState.pos, sel_start)
        IfCondition GreaterThan(sel_len, 0) ThenBlock: {
            CSSTmp.val = CSSSelType.TAG
            CSSTmp.ptr = CSS__InternLower(Add(CSSState.source, sel_start), sel_len)
            CSSTmp.len = sel_len

            // Handle compound selectors: tag.class or tag#id
            // If next char is '.' or '#' (no whitespace), consume the more specific part
            // and use it as the selector (CLASS or ID is more restrictive than TAG)
            IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                cmpd_ch = GetByte(CSSState.source, CSSState.pos)
                // tag.class or tag#id → consume all compound parts, keep most specific
                IfCondition Or(EqualTo(cmpd_ch, 46), EqualTo(cmpd_ch, 35)) ThenBlock: {
                    cmpd_is_id = EqualTo(cmpd_ch, 35)
                    CSS__Advance()
                    cmpd_start = CSSState.pos
                    WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                        cmpd_sc = GetByte(CSSState.source, CSSState.pos)
                        IfCondition EqualTo(CSS__IsIdentChar(cmpd_sc), 0) ThenBlock: { BreakLoop }
                        CSSState.pos = Add(CSSState.pos, 1)
                    }
                    cmpd_len = Subtract(CSSState.pos, cmpd_start)
                    IfCondition GreaterThan(cmpd_len, 0) ThenBlock: {
                        IfCondition EqualTo(cmpd_is_id, 1) ThenBlock: {
                            CSSTmp.val = CSSSelType.ID
                        } ElseBlock: {
                            CSSTmp.val = CSSSelType.CLASS
                        }
                        CSSTmp.ptr = CSS__InternLower(Add(CSSState.source, cmpd_start), cmpd_len)
                        CSSTmp.len = cmpd_len
                    }
                    // Consume any remaining compound parts (.class2, #id2, etc.)
                    IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                        cmpd4_ch = GetByte(CSSState.source, CSSState.pos)
                        WhileLoop Or(EqualTo(cmpd4_ch, 46), EqualTo(cmpd4_ch, 35)) {
                            CSS__Advance()
                            WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                                cmpd4_sc = GetByte(CSSState.source, CSSState.pos)
                                IfCondition EqualTo(CSS__IsIdentChar(cmpd4_sc), 0) ThenBlock: { BreakLoop }
                                CSSState.pos = Add(CSSState.pos, 1)
                            }
                            IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                                cmpd4_ch = GetByte(CSSState.source, CSSState.pos)
                            } ElseBlock: {
                                cmpd4_ch = 0
                            }
                        }
                    }
                }
            }
        } ElseBlock: {
            // Check if selector starts with ':' or '[' (pseudo or attribute selector)
            IfCondition Or(EqualTo(CSSTmp.ch, 58), EqualTo(CSSTmp.ch, 91)) ThenBlock: {
                // Treat as universal selector — pseudo/attr will be consumed below
                CSSTmp.val = CSSSelType.UNIVERSAL
                CSSTmp.ptr = 0
                CSSTmp.len = 0
            } ElseBlock: {
                CSSTmp.val = 0
                CSSTmp.ptr = 0
                CSSTmp.len = 0
            }
        }

        // Consume any pseudo-classes/elements after the main selector
        // e.g. .foo:hover, .bar::before, p:first-child, :not(.x), :is(.a, .b)
        // Classify: interactive pseudo-classes (hover/focus/active/visited) → mark as skip
        CSSTmp.pseudo = 0
        pc_done = 0
        WhileLoop EqualTo(pc_done, 0) {
            IfCondition GreaterEqual(CSSState.pos, CSSState.src_len) ThenBlock: { pc_done = 1 }
            IfCondition EqualTo(pc_done, 0) ThenBlock: {
                pc_ch = GetByte(CSSState.source, CSSState.pos)
                IfCondition NotEqual(pc_ch, 58) ThenBlock: {
                    // Not a colon — no more pseudo-classes
                    pc_done = 1
                }
                IfCondition EqualTo(pc_done, 0) ThenBlock: {
                    // Consume the colon
                    CSSState.pos = Add(CSSState.pos, 1)
                    // Consume optional second colon for pseudo-elements (::before)
                    pc_is_element = 0
                    IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                        IfCondition EqualTo(GetByte(CSSState.source, CSSState.pos), 58) ThenBlock: {
                            CSSState.pos = Add(CSSState.pos, 1)
                            pc_is_element = 1
                        }
                    }
                    // Record start of pseudo name
                    pc_name_start = CSSState.pos
                    // Consume pseudo name (identifier)
                    WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                        pc_sc = GetByte(CSSState.source, CSSState.pos)
                        // Allow hyphens (45) in pseudo names like first-child
                        IfCondition And(EqualTo(CSS__IsIdentChar(pc_sc), 0), NotEqual(pc_sc, 45)) ThenBlock: { BreakLoop }
                        CSSState.pos = Add(CSSState.pos, 1)
                    }
                    pc_name_len = Subtract(CSSState.pos, pc_name_start)
                    // Classify the pseudo-class as interactive or structural
                    // Interactive: hover(5), focus(5), active(6), visited(7),
                    //   focus-within(12), focus-visible(13), any-link(8), link(4), target(6)
                    IfCondition EqualTo(pc_is_element, 0) ThenBlock: {
                        pc_name_ptr = Add(CSSState.source, pc_name_start)
                        // Check 'h' for hover (len=5)
                        IfCondition EqualTo(pc_name_len, 5) ThenBlock: {
                            IfCondition EqualTo(GetByte(pc_name_ptr, 0), 104) ThenBlock: {
                                IfCondition EqualTo(GetByte(pc_name_ptr, 1), 111) ThenBlock: {
                                    CSSTmp.pseudo = 1
                                }
                            }
                            // focus (len=5)
                            IfCondition EqualTo(GetByte(pc_name_ptr, 0), 102) ThenBlock: {
                                IfCondition EqualTo(GetByte(pc_name_ptr, 1), 111) ThenBlock: {
                                    CSSTmp.pseudo = 1
                                }
                            }
                        }
                        // active (len=6)
                        IfCondition EqualTo(pc_name_len, 6) ThenBlock: {
                            IfCondition EqualTo(GetByte(pc_name_ptr, 0), 97) ThenBlock: {
                                IfCondition EqualTo(GetByte(pc_name_ptr, 1), 99) ThenBlock: {
                                    CSSTmp.pseudo = 1
                                }
                            }
                            // target (len=6)
                            IfCondition EqualTo(GetByte(pc_name_ptr, 0), 116) ThenBlock: {
                                IfCondition EqualTo(GetByte(pc_name_ptr, 1), 97) ThenBlock: {
                                    CSSTmp.pseudo = 1
                                }
                            }
                        }
                        // visited (len=7)
                        IfCondition EqualTo(pc_name_len, 7) ThenBlock: {
                            IfCondition EqualTo(GetByte(pc_name_ptr, 0), 118) ThenBlock: {
                                CSSTmp.pseudo = 1
                            }
                        }
                        // link (len=4)
                        IfCondition EqualTo(pc_name_len, 4) ThenBlock: {
                            IfCondition EqualTo(GetByte(pc_name_ptr, 0), 108) ThenBlock: {
                                IfCondition EqualTo(GetByte(pc_name_ptr, 1), 105) ThenBlock: {
                                    CSSTmp.pseudo = 1
                                }
                            }
                        }
                        // any-link (len=8)
                        IfCondition EqualTo(pc_name_len, 8) ThenBlock: {
                            IfCondition EqualTo(GetByte(pc_name_ptr, 0), 97) ThenBlock: {
                                IfCondition EqualTo(GetByte(pc_name_ptr, 1), 110) ThenBlock: {
                                    CSSTmp.pseudo = 1
                                }
                            }
                        }
                        // focus-within (len=12), focus-visible (len=13)
                        IfCondition GreaterEqual(pc_name_len, 12) ThenBlock: {
                            IfCondition EqualTo(GetByte(pc_name_ptr, 0), 102) ThenBlock: {
                                IfCondition EqualTo(GetByte(pc_name_ptr, 5), 45) ThenBlock: {
                                    CSSTmp.pseudo = 1
                                }
                            }
                        }
                    }
                    // If followed by '(' — consume parenthesized argument
                    IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                        IfCondition EqualTo(GetByte(CSSState.source, CSSState.pos), 40) ThenBlock: {
                            CSSState.pos = Add(CSSState.pos, 1)
                            // Consume until matching ')' — handle nested parens
                            pc_depth = 1
                            WhileLoop And(LessThan(CSSState.pos, CSSState.src_len), GreaterThan(pc_depth, 0)) {
                                pc_ic = GetByte(CSSState.source, CSSState.pos)
                                IfCondition EqualTo(pc_ic, 40) ThenBlock: { pc_depth = Add(pc_depth, 1) }
                                IfCondition EqualTo(pc_ic, 41) ThenBlock: { pc_depth = Subtract(pc_depth, 1) }
                                CSSState.pos = Add(CSSState.pos, 1)
                            }
                        }
                    }
                    // Continue loop to handle chained pseudo-classes like :first-child:hover
                }
            }
        }

        // Consume attribute selectors [attr], [attr=val], etc.
        IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
            at_ch = GetByte(CSSState.source, CSSState.pos)
            WhileLoop EqualTo(at_ch, 91) {
                // Skip until matching ']' (93)
                CSSState.pos = Add(CSSState.pos, 1)
                WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                    at_ic = GetByte(CSSState.source, CSSState.pos)
                    CSSState.pos = Add(CSSState.pos, 1)
                    IfCondition EqualTo(at_ic, 93) ThenBlock: { BreakLoop }
                }
                // Check for more attribute selectors or pseudo-classes
                IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                    at_ch = GetByte(CSSState.source, CSSState.pos)
                } ElseBlock: {
                    at_ch = 0
                }
            }
        }

        // After consuming pseudo-classes, also consume compound parts (.class, #id)
        // that follow pseudo-classes, e.g. :not(.x).active
        IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
            pc_after = GetByte(CSSState.source, CSSState.pos)
            WhileLoop Or(EqualTo(pc_after, 46), EqualTo(pc_after, 35)) {
                CSS__Advance()
                WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                    pc_as = GetByte(CSSState.source, CSSState.pos)
                    IfCondition EqualTo(CSS__IsIdentChar(pc_as), 0) ThenBlock: { BreakLoop }
                    CSSState.pos = Add(CSSState.pos, 1)
                }
                IfCondition LessThan(CSSState.pos, CSSState.src_len) ThenBlock: {
                    pc_after = GetByte(CSSState.source, CSSState.pos)
                } ElseBlock: {
                    pc_after = 0
                }
            }
        }
    }
}

Function.CSS__ParseSelector {
    Input: rule_idx: Integer
    Body: {
        CSS__SkipWS()

        // Parse first simple selector
        CSS__ParseSimpleSel()
        first_type = CSSTmp.val
        first_ptr = CSSTmp.ptr
        first_len = CSSTmp.len
        first_pseudo = CSSTmp.pseudo

        IfCondition EqualTo(first_type, 0) ThenBlock: { ReturnValue(0) }

        // Check for combinator: look for whitespace or > + ~ before '{'
        // Save position to detect whitespace combinator
        pos_after_first = CSSState.pos
        has_ws = 0

        // Skip whitespace (but not comments) — check if there IS whitespace
        WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
            wc = GetByte(CSSState.source, CSSState.pos)
            IfCondition Or(EqualTo(wc, 32), EqualTo(wc, 9)) ThenBlock: {
                CSSState.pos = Add(CSSState.pos, 1)
                has_ws = 1
            } ElseBlock: {
                BreakLoop
            }
        }

        // Check what follows — combinator operator or start of next selector
        cmb_type = CSSCmb.NONE
        nc = CSS__Peek()

        // > child combinator
        IfCondition EqualTo(nc, 62) ThenBlock: {
            cmb_type = CSSCmb.CHILD
            CSS__Advance()
            CSS__SkipWS()
        }
        // + adjacent sibling
        IfCondition And(EqualTo(cmb_type, 0), EqualTo(nc, 43)) ThenBlock: {
            cmb_type = CSSCmb.ADJ
            CSS__Advance()
            CSS__SkipWS()
        }
        // ~ general sibling
        IfCondition And(EqualTo(cmb_type, 0), EqualTo(nc, 126)) ThenBlock: {
            cmb_type = CSSCmb.GEN
            CSS__Advance()
            CSS__SkipWS()
        }
        // If whitespace + next char is selector start (not '{'), it's descendant combinator
        IfCondition EqualTo(cmb_type, 0) ThenBlock: {
            IfCondition EqualTo(has_ws, 1) ThenBlock: {
                // Check if next char starts a selector (not '{' or end)
                IfCondition And(NotEqual(nc, 123), NotEqual(nc, 0)) ThenBlock: {
                    ds_ok = CSS__IsIdentChar(nc)
                    IfCondition Or(EqualTo(ds_ok, 1), Or(EqualTo(nc, 46), Or(EqualTo(nc, 35), EqualTo(nc, 42)))) ThenBlock: {
                        cmb_type = CSSCmb.DESC
                    }
                }
            }
        }

        // If we have a combinator, parse the subject selector
        IfCondition NotEqual(cmb_type, 0) ThenBlock: {
            CSS__ParseSimpleSel()
            subj_type = CSSTmp.val
            subj_ptr = CSSTmp.ptr
            subj_len = CSSTmp.len

            IfCondition NotEqual(subj_type, 0) ThenBlock: {
                // Subject (rightmost) goes into R_SEL_*
                CSS__RuleSet(rule_idx, CSSConst.R_SEL_TYPE, subj_type)
                CSS__RuleSet(rule_idx, CSSConst.R_SEL_PTR, subj_ptr)
                CSS__RuleSet(rule_idx, CSSConst.R_SEL_LEN, subj_len)
                // Context (leftmost) goes into R_CMB_*
                CSS__RuleSet(rule_idx, CSSConst.R_CMB_TYPE, cmb_type)
                CSS__RuleSet(rule_idx, CSSConst.R_CMB_SEL_TYPE, first_type)
                CSS__RuleSet(rule_idx, CSSConst.R_CMB_SEL_PTR, first_ptr)
                CSS__RuleSet(rule_idx, CSSConst.R_CMB_SEL_LEN, first_len)
                // Pseudo flag: interactive if either part has it
                rule_pseudo = first_pseudo
                IfCondition EqualTo(CSSTmp.pseudo, 1) ThenBlock: { rule_pseudo = 1 }
                CSS__RuleSet(rule_idx, CSSConst.R_PSEUDO, rule_pseudo)
                // Specificity = sum of both parts
                spec1 = CSS__CalcSpecificity(first_type)
                spec2 = CSS__CalcSpecificity(subj_type)
                CSS__RuleSet(rule_idx, CSSConst.R_SPECIFICITY, Add(spec1, spec2))
                ReturnValue(0)
            }
        }

        // No combinator — simple selector (original behavior)
        CSS__RuleSet(rule_idx, CSSConst.R_SEL_TYPE, first_type)
        CSS__RuleSet(rule_idx, CSSConst.R_SEL_PTR, first_ptr)
        CSS__RuleSet(rule_idx, CSSConst.R_SEL_LEN, first_len)
        CSS__RuleSet(rule_idx, CSSConst.R_CMB_TYPE, CSSCmb.NONE)
        CSS__RuleSet(rule_idx, CSSConst.R_PSEUDO, first_pseudo)
        CSSTmp.spec = CSS__CalcSpecificity(first_type)
        CSS__RuleSet(rule_idx, CSSConst.R_SPECIFICITY, CSSTmp.spec)
    }
}

// =============================================================================
// PUBLIC API — PARSE INLINE STYLE
// Returns rule index (properties attached to this rule)
// =============================================================================
Function.CSS_ParseInline {
    Input: style: Address
    Input: style_len: Integer
    Output: Integer
    Body: {
        CSSState.source = style
        CSSState.src_len = style_len
        CSSState.pos = 0

        // Create a pseudo-rule with no selector (inline style)
        rule = CSS__CreateRule(CSSSelType.UNIVERSAL, 0, 0)
        IfCondition LessThan(rule, 0) ThenBlock: { ReturnValue(-1) }

        // Inline styles have highest specificity (1000)
        CSS__RuleSet(rule, CSSConst.R_SPECIFICITY, 1000)

        CSS__ParseDeclarations(rule)
        ReturnValue(rule)
    }
}

// =============================================================================
// PUBLIC API — PARSE STYLESHEET
// Parses full CSS: selector { declarations } blocks
// Returns number of rules parsed
// =============================================================================
Function.CSS_ParseSheet {
    Input: source: Address
    Input: src_len: Integer
    Output: Integer
    Body: {
        CSSState.source = source
        CSSState.src_len = src_len
        CSSState.pos = 0

        rule_start = CSSState.rule_count

        CSS__SkipWS()

        // Strip CDATA markers from XHTML style blocks: <![CDATA[ ... ]]>
        // Check for <![CDATA[ (9 bytes: 60,33,91,67,68,65,84,65,91)
        IfCondition LessThan(Add(CSSState.pos, 8), CSSState.src_len) ThenBlock: {
            cd_ok = 0
            cd0 = GetByte(CSSState.source, CSSState.pos)
            IfCondition EqualTo(cd0, 60) ThenBlock: {
                cd1 = GetByte(CSSState.source, Add(CSSState.pos, 1))
                cd2 = GetByte(CSSState.source, Add(CSSState.pos, 2))
                cd3 = GetByte(CSSState.source, Add(CSSState.pos, 3))
                cd4 = GetByte(CSSState.source, Add(CSSState.pos, 4))
                cd5 = GetByte(CSSState.source, Add(CSSState.pos, 5))
                cd6 = GetByte(CSSState.source, Add(CSSState.pos, 6))
                cd7 = GetByte(CSSState.source, Add(CSSState.pos, 7))
                cd8 = GetByte(CSSState.source, Add(CSSState.pos, 8))
                IfCondition And(EqualTo(cd1, 33), And(EqualTo(cd2, 91), And(EqualTo(cd3, 67), And(EqualTo(cd4, 68), And(EqualTo(cd5, 65), And(EqualTo(cd6, 84), And(EqualTo(cd7, 65), EqualTo(cd8, 91)))))))) ThenBlock: {
                    cd_ok = 1
                }
            }
            IfCondition EqualTo(cd_ok, 1) ThenBlock: {
                CSSState.pos = Add(CSSState.pos, 9)
                CSS__SkipWS()
                // Trim ]]> from end (93,93,62)
                IfCondition GreaterEqual(CSSState.src_len, 3) ThenBlock: {
                    ce1 = GetByte(CSSState.source, Subtract(CSSState.src_len, 3))
                    ce2 = GetByte(CSSState.source, Subtract(CSSState.src_len, 2))
                    ce3 = GetByte(CSSState.source, Subtract(CSSState.src_len, 1))
                    IfCondition And(EqualTo(ce1, 93), And(EqualTo(ce2, 93), EqualTo(ce3, 62))) ThenBlock: {
                        CSSState.src_len = Subtract(CSSState.src_len, 3)
                        // Also trim trailing whitespace before ]]>
                        cd_trim_done = 0
                        WhileLoop And(GreaterThan(CSSState.src_len, CSSState.pos), EqualTo(cd_trim_done, 0)) {
                            cd_tb = GetByte(CSSState.source, Subtract(CSSState.src_len, 1))
                            IfCondition Or(EqualTo(cd_tb, 32), Or(EqualTo(cd_tb, 10), Or(EqualTo(cd_tb, 13), EqualTo(cd_tb, 9)))) ThenBlock: {
                                CSSState.src_len = Subtract(CSSState.src_len, 1)
                            } ElseBlock: {
                                cd_trim_done = 1
                            }
                        }
                    }
                }
            }
        }

        WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
            // Safety: track pos to prevent infinite loops
            loop_guard_pos = CSSState.pos

            CSSTmp.ch = CSS__Peek()
            IfCondition EqualTo(CSSTmp.ch, 0) ThenBlock: {
                ReturnValue(Subtract(CSSState.rule_count, rule_start))
            }

            // Handle @-rules: parse @media/@supports contents, skip others
            IfCondition EqualTo(CSSTmp.ch, 64) ThenBlock: {
                // Check if this is @media by looking at next 5 bytes: m(109) e(101) d(100) i(105) a(97)
                is_media = 0
                at_pos = Add(CSSState.pos, 1)
                IfCondition LessThan(Add(at_pos, 4), CSSState.src_len) ThenBlock: {
                    am1 = GetByte(CSSState.source, at_pos)
                    am2 = GetByte(CSSState.source, Add(at_pos, 1))
                    am3 = GetByte(CSSState.source, Add(at_pos, 2))
                    am4 = GetByte(CSSState.source, Add(at_pos, 3))
                    am5 = GetByte(CSSState.source, Add(at_pos, 4))
                    IfCondition And(EqualTo(am1, 109), And(EqualTo(am2, 101), And(EqualTo(am3, 100), And(EqualTo(am4, 105), EqualTo(am5, 97))))) ThenBlock: {
                        is_media = 1
                    }
                }
                // Check if this is @supports: s(115) u(117) p(112) p(112) o(111) r(114) t(116) s(115)
                IfCondition EqualTo(is_media, 0) ThenBlock: {
                    IfCondition LessThan(Add(at_pos, 7), CSSState.src_len) ThenBlock: {
                        as1 = GetByte(CSSState.source, at_pos)
                        as2 = GetByte(CSSState.source, Add(at_pos, 1))
                        as3 = GetByte(CSSState.source, Add(at_pos, 2))
                        as4 = GetByte(CSSState.source, Add(at_pos, 3))
                        as5 = GetByte(CSSState.source, Add(at_pos, 4))
                        as6 = GetByte(CSSState.source, Add(at_pos, 5))
                        as7 = GetByte(CSSState.source, Add(at_pos, 6))
                        as8 = GetByte(CSSState.source, Add(at_pos, 7))
                        IfCondition And(EqualTo(as1, 115), And(EqualTo(as2, 117), And(EqualTo(as3, 112), And(EqualTo(as4, 112), And(EqualTo(as5, 111), And(EqualTo(as6, 114), And(EqualTo(as7, 116), EqualTo(as8, 115)))))))) ThenBlock: {
                            is_media = 1
                        }
                    }
                }
                IfCondition EqualTo(is_media, 1) ThenBlock: {
                    // Evaluate @media condition for screen rendering
                    // Strategy: extract condition, check for known types/negations
                    media_skip = 0
                    cond_start = CSSState.pos
                    // Find the '{' first to know the condition extent
                    cond_end = CSSState.pos
                    WhileLoop LessThan(cond_end, CSSState.src_len) {
                        IfCondition EqualTo(GetByte(CSSState.source, cond_end), 123) ThenBlock: { BreakLoop }
                        cond_end = Add(cond_end, 1)
                    }
                    // Skip past @media/supports keyword to condition text
                    // CSSState.pos is at '@', advance past keyword
                    mc_pos = CSSState.pos
                    // Skip '@media ' or '@supports '
                    WhileLoop LessThan(mc_pos, cond_end) {
                        mc_c = GetByte(CSSState.source, mc_pos)
                        // Stop after first space/tab after keyword
                        IfCondition Or(EqualTo(mc_c, 32), EqualTo(mc_c, 9)) ThenBlock: { BreakLoop }
                        mc_pos = Add(mc_pos, 1)
                    }
                    // Skip whitespace
                    WhileLoop LessThan(mc_pos, cond_end) {
                        mc_c2 = GetByte(CSSState.source, mc_pos)
                        IfCondition And(NotEqual(mc_c2, 32), NotEqual(mc_c2, 9)) ThenBlock: { BreakLoop }
                        mc_pos = Add(mc_pos, 1)
                    }
                    // mc_pos now points to condition start
                    cond_len = Subtract(cond_end, mc_pos)

                    // Check for 'not ' prefix: n(110) o(111) t(116) space(32)
                    has_not = 0
                    IfCondition GreaterEqual(cond_len, 4) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(CSSState.source, mc_pos), 110), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 1)), 111), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 2)), 116), EqualTo(GetByte(CSSState.source, Add(mc_pos, 3)), 32)))) ThenBlock: {
                            has_not = 1
                            mc_pos = Add(mc_pos, 4)
                            // Skip whitespace after 'not '
                            WhileLoop LessThan(mc_pos, cond_end) {
                                mc_c3 = GetByte(CSSState.source, mc_pos)
                                IfCondition And(NotEqual(mc_c3, 32), NotEqual(mc_c3, 9)) ThenBlock: { BreakLoop }
                                mc_pos = Add(mc_pos, 1)
                            }
                            cond_len = Subtract(cond_end, mc_pos)
                        }
                    }

                    // Now check what the media type/condition is
                    // 'all' (97,108,108) — 3 chars
                    is_all = 0
                    IfCondition GreaterEqual(cond_len, 3) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(CSSState.source, mc_pos), 97), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 1)), 108), EqualTo(GetByte(CSSState.source, Add(mc_pos, 2)), 108))) ThenBlock: {
                            // Check it's a complete word (next char is space/tab/{ or end)
                            mc_next = Add(mc_pos, 3)
                            IfCondition Or(GreaterEqual(mc_next, cond_end), Or(EqualTo(GetByte(CSSState.source, mc_next), 32), Or(EqualTo(GetByte(CSSState.source, mc_next), 123), EqualTo(GetByte(CSSState.source, mc_next), 44)))) ThenBlock: {
                                is_all = 1
                            }
                        }
                    }
                    // 'screen' (115,99,114,101,101,110) — 6 chars
                    is_screen = 0
                    IfCondition GreaterEqual(cond_len, 6) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(CSSState.source, mc_pos), 115), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 1)), 99), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 2)), 114), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 3)), 101), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 4)), 101), EqualTo(GetByte(CSSState.source, Add(mc_pos, 5)), 110)))))) ThenBlock: {
                            is_screen = 1
                        }
                    }
                    // 'print' (112,114,105,110,116) — 5 chars
                    is_print = 0
                    IfCondition GreaterEqual(cond_len, 5) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(CSSState.source, mc_pos), 112), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 1)), 114), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 2)), 105), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 3)), 110), EqualTo(GetByte(CSSState.source, Add(mc_pos, 4)), 116))))) ThenBlock: {
                            is_print = 1
                        }
                    }
                    // 'speech' (115,112,101,101,99,104) — 6 chars
                    is_speech = 0
                    IfCondition GreaterEqual(cond_len, 6) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(CSSState.source, mc_pos), 115), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 1)), 112), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 2)), 101), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 3)), 101), And(EqualTo(GetByte(CSSState.source, Add(mc_pos, 4)), 99), EqualTo(GetByte(CSSState.source, Add(mc_pos, 5)), 104)))))) ThenBlock: {
                            is_speech = 1
                        }
                    }

                    // Evaluate: apply logic based on has_not and detected type
                    IfCondition EqualTo(has_not, 1) ThenBlock: {
                        // 'not all' → skip (negates everything)
                        IfCondition EqualTo(is_all, 1) ThenBlock: { media_skip = 1 }
                        // 'not screen' → skip (we are screen)
                        IfCondition EqualTo(is_screen, 1) ThenBlock: { media_skip = 1 }
                        // 'not print' → apply (we are not print) — media_skip stays 0
                        // 'not speech' → apply — media_skip stays 0
                        // 'not (unknown)' → skip (unknown negated = unknown = false)
                        IfCondition And(EqualTo(is_print, 0), And(EqualTo(is_speech, 0), And(EqualTo(is_all, 0), EqualTo(is_screen, 0)))) ThenBlock: {
                            media_skip = 1
                        }
                    } ElseBlock: {
                        // No 'not': positive match
                        // 'print' or 'speech' → skip
                        IfCondition EqualTo(is_print, 1) ThenBlock: { media_skip = 1 }
                        IfCondition EqualTo(is_speech, 1) ThenBlock: { media_skip = 1 }
                        // 'all', 'screen' → apply
                        // Feature query starting with '(' → check for known features
                        // Unknown bare media type → skip
                        IfCondition And(EqualTo(is_all, 0), And(EqualTo(is_screen, 0), And(EqualTo(is_print, 0), EqualTo(is_speech, 0)))) ThenBlock: {
                            IfCondition GreaterThan(cond_len, 0) ThenBlock: {
                                mc_first = GetByte(CSSState.source, mc_pos)
                                IfCondition EqualTo(mc_first, 40) ThenBlock: {
                                    // Feature query '(...)' — scan for ':' inside parens
                                    // If colon found → value query like (min-width: 800px) → apply
                                    // If no colon → boolean feature, only apply if known
                                    has_colon = 0
                                    mf_i = mc_pos
                                    WhileLoop LessThan(mf_i, cond_end) {
                                        mf_c = GetByte(CSSState.source, mf_i)
                                        IfCondition EqualTo(mf_c, 58) ThenBlock: { has_colon = 1  BreakLoop }
                                        IfCondition EqualTo(mf_c, 41) ThenBlock: { BreakLoop }
                                        mf_i = Add(mf_i, 1)
                                    }
                                    IfCondition EqualTo(has_colon, 0) ThenBlock: {
                                        // Boolean feature without colon — skip (unknown)
                                        // Known boolean features: color, hover, pointer, any-hover, any-pointer, grid
                                        // For simplicity: check for 'color' (99,111,108,111,114)
                                        mf_s = Add(mc_pos, 1)
                                        mf_known = 0
                                        // 'color' at mf_s
                                        IfCondition LessThan(Add(mf_s, 4), cond_end) ThenBlock: {
                                            IfCondition And(EqualTo(GetByte(CSSState.source, mf_s), 99), And(EqualTo(GetByte(CSSState.source, Add(mf_s, 1)), 111), And(EqualTo(GetByte(CSSState.source, Add(mf_s, 2)), 108), And(EqualTo(GetByte(CSSState.source, Add(mf_s, 3)), 111), EqualTo(GetByte(CSSState.source, Add(mf_s, 4)), 114))))) ThenBlock: {
                                                mf_known = 1
                                            }
                                        }
                                        IfCondition EqualTo(mf_known, 0) ThenBlock: {
                                            media_skip = 1
                                        }
                                    }
                                    // has_colon=1: value feature query → apply (media_skip stays 0)
                                } ElseBlock: {
                                    // Not a feature query, not a known type → unknown media type
                                    media_skip = 1
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(media_skip, 1) ThenBlock: {
                        // Skip entire @media block (scan past matching '}')
                        CSSState.pos = Add(cond_end, 1)
                        brace_depth = 1
                        WhileLoop And(LessThan(CSSState.pos, CSSState.src_len), GreaterThan(brace_depth, 0)) {
                            skip_c = GetByte(CSSState.source, CSSState.pos)
                            IfCondition EqualTo(skip_c, 123) ThenBlock: { brace_depth = Add(brace_depth, 1) }
                            IfCondition EqualTo(skip_c, 125) ThenBlock: { brace_depth = Subtract(brace_depth, 1) }
                            CSSState.pos = Add(CSSState.pos, 1)
                        }
                        CSS__SkipWS()
                    } ElseBlock: {
                        // @media/@supports: skip condition to '{', consume it, let main loop parse inner rules
                        // The closing '}' of @media will be handled by a stray '}' check below
                        WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                            amc = GetByte(CSSState.source, CSSState.pos)
                            IfCondition EqualTo(amc, 123) ThenBlock: {
                                CSSState.pos = Add(CSSState.pos, 1)
                                BreakLoop
                            }
                            CSSState.pos = Add(CSSState.pos, 1)
                        }
                        CSS__SkipWS()
                    }
                }

                IfCondition EqualTo(is_media, 0) ThenBlock: {
                    // Non-media @-rule: skip entire { } block or to ;
                    WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                        ac = GetByte(CSSState.source, CSSState.pos)
                        IfCondition EqualTo(ac, 59) ThenBlock: {
                            CSS__Advance()
                            BreakLoop
                        }
                        IfCondition EqualTo(ac, 123) ThenBlock: {
                            CSS__Advance()
                            depth = 1
                            WhileLoop And(LessThan(CSSState.pos, CSSState.src_len), GreaterThan(depth, 0)) {
                                bc = GetByte(CSSState.source, CSSState.pos)
                                IfCondition EqualTo(bc, 123) ThenBlock: { depth = Add(depth, 1) }
                                IfCondition EqualTo(bc, 125) ThenBlock: { depth = Subtract(depth, 1) }
                                CSSState.pos = Add(CSSState.pos, 1)
                            }
                            BreakLoop
                        }
                        CSSState.pos = Add(CSSState.pos, 1)
                    }
                    CSS__SkipWS()
                }
            }

            // Handle stray '}' — closing brace of @media block
            IfCondition NotEqual(CSSTmp.ch, 64) ThenBlock: {
                IfCondition EqualTo(CSSTmp.ch, 125) ThenBlock: {
                    CSS__Advance()
                    CSS__SkipWS()
                }
            }

            IfCondition And(NotEqual(CSSTmp.ch, 64), NotEqual(CSSTmp.ch, 125)) ThenBlock: {
                // Normal rule: selector { declarations }
                // Support comma-separated selectors: .a, .b, .c { ... }
                // Parse first rule + selector
                rule = CSS__CreateRule(CSSSelType.TAG, 0, 0)
                IfCondition LessThan(rule, 0) ThenBlock: {
                    ReturnValue(Subtract(CSSState.rule_count, rule_start))
                }

                CSS__ParseSelector(rule)
                CSS__SkipWS()

                // Now check for comma-separated additional selectors
                // We'll create extra rules and fill their props later
                extra_r0 = -1
                extra_r1 = -1
                extra_r2 = -1
                extra_r3 = -1
                extra_r4 = -1
                extra_r5 = -1
                extra_r6 = -1
                extra_r7 = -1
                extra_count = 0

                CSSTmp.ch = CSS__Peek()
                WhileLoop EqualTo(CSSTmp.ch, 44) {
                    // Comma found — consume it and parse next selector
                    CSS__Advance()
                    CSS__SkipWS()

                    // Skip pseudo-selectors before the next real selector part
                    // e.g. ".foo:hover, .bar" — skip ":hover" leftovers if any
                    // Actually: comma comes after full selector, so just parse next
                    xr = CSS__CreateRule(CSSSelType.TAG, 0, 0)
                    IfCondition LessThan(xr, 0) ThenBlock: { BreakLoop }

                    CSS__ParseSelector(xr)
                    CSS__SkipWS()

                    // Store in extra_rN slots (up to 8 extra selectors)
                    IfCondition EqualTo(extra_count, 0) ThenBlock: { extra_r0 = xr }
                    IfCondition EqualTo(extra_count, 1) ThenBlock: { extra_r1 = xr }
                    IfCondition EqualTo(extra_count, 2) ThenBlock: { extra_r2 = xr }
                    IfCondition EqualTo(extra_count, 3) ThenBlock: { extra_r3 = xr }
                    IfCondition EqualTo(extra_count, 4) ThenBlock: { extra_r4 = xr }
                    IfCondition EqualTo(extra_count, 5) ThenBlock: { extra_r5 = xr }
                    IfCondition EqualTo(extra_count, 6) ThenBlock: { extra_r6 = xr }
                    IfCondition EqualTo(extra_count, 7) ThenBlock: { extra_r7 = xr }
                    extra_count = Add(extra_count, 1)
                    IfCondition GreaterEqual(extra_count, 8) ThenBlock: { BreakLoop }

                    CSSTmp.ch = CSS__Peek()
                }

                // If not at '{', scan forward to find it (skip pseudo-selectors etc.)
                CSSTmp.ch = CSS__Peek()
                IfCondition NotEqual(CSSTmp.ch, 123) ThenBlock: {
                    WhileLoop LessThan(CSSState.pos, CSSState.src_len) {
                        sc = GetByte(CSSState.source, CSSState.pos)
                        IfCondition EqualTo(sc, 123) ThenBlock: { BreakLoop }
                        IfCondition EqualTo(sc, 125) ThenBlock: { BreakLoop }
                        CSSState.pos = Add(CSSState.pos, 1)
                    }
                    CSSTmp.ch = CSS__Peek()
                }

                // Parse declarations if we found '{'
                IfCondition EqualTo(CSSTmp.ch, 123) ThenBlock: {
                    CSS__Advance()
                    CSS__SkipWS()
                    CSS__ParseDeclarations(rule)
                    CSS__SkipWS()
                    // Expect '}'
                    CSSTmp.ch = CSS__Peek()
                    IfCondition EqualTo(CSSTmp.ch, 125) ThenBlock: {
                        CSS__Advance()
                    }

                    // Copy property range from first rule to all extra comma-separated rules
                    IfCondition GreaterThan(extra_count, 0) ThenBlock: {
                        shared_pf = CSS__RuleGet(rule, CSSConst.R_PROP_FIRST)
                        shared_pc = CSS__RuleGet(rule, CSSConst.R_PROP_CT)

                        IfCondition GreaterThan(extra_count, 0) ThenBlock: {
                            CSS__RuleSet(extra_r0, CSSConst.R_PROP_FIRST, shared_pf)
                            CSS__RuleSet(extra_r0, CSSConst.R_PROP_CT, shared_pc)
                        }
                        IfCondition GreaterThan(extra_count, 1) ThenBlock: {
                            CSS__RuleSet(extra_r1, CSSConst.R_PROP_FIRST, shared_pf)
                            CSS__RuleSet(extra_r1, CSSConst.R_PROP_CT, shared_pc)
                        }
                        IfCondition GreaterThan(extra_count, 2) ThenBlock: {
                            CSS__RuleSet(extra_r2, CSSConst.R_PROP_FIRST, shared_pf)
                            CSS__RuleSet(extra_r2, CSSConst.R_PROP_CT, shared_pc)
                        }
                        IfCondition GreaterThan(extra_count, 3) ThenBlock: {
                            CSS__RuleSet(extra_r3, CSSConst.R_PROP_FIRST, shared_pf)
                            CSS__RuleSet(extra_r3, CSSConst.R_PROP_CT, shared_pc)
                        }
                        IfCondition GreaterThan(extra_count, 4) ThenBlock: {
                            CSS__RuleSet(extra_r4, CSSConst.R_PROP_FIRST, shared_pf)
                            CSS__RuleSet(extra_r4, CSSConst.R_PROP_CT, shared_pc)
                        }
                        IfCondition GreaterThan(extra_count, 5) ThenBlock: {
                            CSS__RuleSet(extra_r5, CSSConst.R_PROP_FIRST, shared_pf)
                            CSS__RuleSet(extra_r5, CSSConst.R_PROP_CT, shared_pc)
                        }
                        IfCondition GreaterThan(extra_count, 6) ThenBlock: {
                            CSS__RuleSet(extra_r6, CSSConst.R_PROP_FIRST, shared_pf)
                            CSS__RuleSet(extra_r6, CSSConst.R_PROP_CT, shared_pc)
                        }
                        IfCondition GreaterThan(extra_count, 7) ThenBlock: {
                            CSS__RuleSet(extra_r7, CSSConst.R_PROP_FIRST, shared_pf)
                            CSS__RuleSet(extra_r7, CSSConst.R_PROP_CT, shared_pc)
                        }
                    }
                }
            }

            CSS__SkipWS()

            // Safety: if pos didn't advance, skip one char to prevent infinite loop
            IfCondition EqualTo(CSSState.pos, loop_guard_pos) ThenBlock: {
                CSSState.pos = Add(CSSState.pos, 1)
            }
        }

        ReturnValue(Subtract(CSSState.rule_count, rule_start))
    }
}

// =============================================================================
// PUBLIC ACCESSORS
// =============================================================================
Function.CSS_RuleCount {
    Output: Integer
    Body: { ReturnValue(CSSState.rule_count) }
}

Function.CSS_PropCount {
    Output: Integer
    Body: { ReturnValue(CSSState.prop_count) }
}

Function.CSS_RuleSelType {
    Input: rule: Integer
    Output: Integer
    Body: { ReturnValue(CSS__RuleGet(rule, CSSConst.R_SEL_TYPE)) }
}

Function.CSS_RuleSelPtr {
    Input: rule: Integer
    Output: Address
    Body: { ReturnValue(CSS__RuleGet(rule, CSSConst.R_SEL_PTR)) }
}

Function.CSS_RuleSelLen {
    Input: rule: Integer
    Output: Integer
    Body: { ReturnValue(CSS__RuleGet(rule, CSSConst.R_SEL_LEN)) }
}

Function.CSS_RulePropFirst {
    Input: rule: Integer
    Output: Integer
    Body: { ReturnValue(CSS__RuleGet(rule, CSSConst.R_PROP_FIRST)) }
}

Function.CSS_RulePropCount {
    Input: rule: Integer
    Output: Integer
    Body: { ReturnValue(CSS__RuleGet(rule, CSSConst.R_PROP_CT)) }
}

Function.CSS_RuleSpecificity {
    Input: rule: Integer
    Output: Integer
    Body: { ReturnValue(CSS__RuleGet(rule, CSSConst.R_SPECIFICITY)) }
}

// Combinator accessors
Function.CSS_RuleCmbType {
    Input: rule: Integer
    Output: Integer
    Body: { ReturnValue(CSS__RuleGet(rule, CSSConst.R_CMB_TYPE)) }
}

Function.CSS_RuleCmbSelType {
    Input: rule: Integer
    Output: Integer
    Body: { ReturnValue(CSS__RuleGet(rule, CSSConst.R_CMB_SEL_TYPE)) }
}

Function.CSS_RuleCmbSelPtr {
    Input: rule: Integer
    Output: Address
    Body: { ReturnValue(CSS__RuleGet(rule, CSSConst.R_CMB_SEL_PTR)) }
}

Function.CSS_RulePseudo {
    Input: rule: Integer
    Output: Integer
    Body: { ReturnValue(CSS__RuleGet(rule, CSSConst.R_PSEUDO)) }
}

// Property accessor by absolute index
Function.CSS_PropName {
    Input: idx: Integer
    Output: Address
    Body: {
        CSSTmp.ptr = CSS__PropAddr(idx)
        ReturnValue(Dereference(Add(CSSTmp.ptr, CSSConst.P_NAME_PTR)))
    }
}

Function.CSS_PropVal {
    Input: idx: Integer
    Output: Address
    Body: {
        CSSTmp.ptr = CSS__PropAddr(idx)
        ReturnValue(Dereference(Add(CSSTmp.ptr, CSSConst.P_VAL_PTR)))
    }
}

Function.CSS_PropIsImportant {
    Input: idx: Integer
    Output: Integer
    Body: {
        CSSTmp.ptr = CSS__PropAddr(idx)
        CSSTmp.len = Dereference(Add(CSSTmp.ptr, CSSConst.P_VAL_LEN))
        result = BitwiseAnd(CSSTmp.len, CSSConst.IMPORTANT_BIT)
        IfCondition NotEqual(result, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// =============================================================================
// PROPERTY LOOKUP BY NAME ON A RULE
// =============================================================================
Function.CSS_GetPropVal {
    Input: rule: Integer
    Input: name: Address
    Output: Address
    Body: {
        CSSTmp.start = CSS__RuleGet(rule, CSSConst.R_PROP_FIRST)
        CSSTmp.count = CSS__RuleGet(rule, CSSConst.R_PROP_CT)
        IfCondition EqualTo(CSSTmp.count, 0) ThenBlock: { ReturnValue(0) }

        // Return LAST match — explicit longhands after expanded shorthands win
        best = 0
        pi = CSSTmp.start
        pi_end = Add(CSSTmp.start, CSSTmp.count)
        WhileLoop LessThan(pi, pi_end) {
            pn = CSS_PropName(pi)
            IfCondition NotEqual(pn, 0) ThenBlock: {
                cmp = StringCompare(pn, name)
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    best = CSS_PropVal(pi)
                }
            }
            pi = Add(pi, 1)
        }
        ReturnValue(best)
    }
}

// =============================================================================
// SELECTOR MATCHING
// =============================================================================

// Match a rule's selector against an element's tag name
Function.CSS_MatchesTag {
    Input: rule: Integer
    Input: tag: Address
    Output: Integer
    Body: {
        sel_type = CSS__RuleGet(rule, CSSConst.R_SEL_TYPE)

        // Universal matches everything
        IfCondition EqualTo(sel_type, CSSSelType.UNIVERSAL) ThenBlock: { ReturnValue(1) }

        // Tag selector
        IfCondition EqualTo(sel_type, CSSSelType.TAG) ThenBlock: {
            sel_ptr = CSS__RuleGet(rule, CSSConst.R_SEL_PTR)
            IfCondition EqualTo(sel_ptr, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(0) }
            cmp = StringCompare(sel_ptr, tag)
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        }

        ReturnValue(0)
    }
}

// Match against class attribute value
Function.CSS_MatchesClass {
    Input: rule: Integer
    Input: class_attr: Address
    Output: Integer
    Body: {
        sel_type = CSS__RuleGet(rule, CSSConst.R_SEL_TYPE)
        IfCondition NotEqual(sel_type, CSSSelType.CLASS) ThenBlock: { ReturnValue(0) }

        sel_ptr = CSS__RuleGet(rule, CSSConst.R_SEL_PTR)
        IfCondition EqualTo(sel_ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(class_attr, 0) ThenBlock: { ReturnValue(0) }

        // Simple: exact match (doesn't handle space-separated class lists yet)
        cmp = StringCompare(sel_ptr, class_attr)
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// =============================================================================
// CSS CUSTOM PROPERTIES (CSS VARIABLES)
// Stores --name: value declarations, resolves var(--name) references
// =============================================================================
FixedPool.CSSVar {
    "pool":    Initialize=0    // array of entries: [name_ptr(8), val_ptr(8)] = 16 bytes each
    "count":   Initialize=0
    "max":     Initialize=2048
    "entry_sz": Initialize=16
}

FixedPool.CSSVarTmp {
    "name":    Initialize=0
    "val":     Initialize=0
    "i":       Initialize=0
    "is_custom": Initialize=0
}

Function.CSS_VarInit {
    Body: {
        sz = Multiply(CSSVar.max, CSSVar.entry_sz)
        CSSVar.pool = Allocate(sz)
        IfCondition NotEqual(CSSVar.pool, 0) ThenBlock: {
            MemorySet(CSSVar.pool, 0, sz)
        }
        CSSVar.count = 0
    }
}

Function.CSS_VarReset {
    Body: {
        CSSVar.count = 0
        IfCondition NotEqual(CSSVar.pool, 0) ThenBlock: {
            sz = Multiply(CSSVar.max, CSSVar.entry_sz)
            MemorySet(CSSVar.pool, 0, sz)
        }
    }
}

// Store a CSS variable: --name with its value string
Function.CSS_VarStore {
    Input: name_ptr: Address
    Input: val_ptr: Address
    Body: {
        IfCondition EqualTo(CSSVar.pool, 0) ThenBlock: { ReturnValue(0) }

        // Check if variable already exists — overwrite if so
        CSSVarTmp.i = 0
        WhileLoop LessThan(CSSVarTmp.i, CSSVar.count) {
            eaddr = Add(CSSVar.pool, Multiply(CSSVarTmp.i, CSSVar.entry_sz))
            existing_name = Dereference(eaddr)
            IfCondition NotEqual(existing_name, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(existing_name, name_ptr), 0) ThenBlock: {
                    // Overwrite value
                    StoreValue(Add(eaddr, 8), val_ptr)
                    ReturnValue(1)
                }
            }
            CSSVarTmp.i = Add(CSSVarTmp.i, 1)
        }

        // New entry
        IfCondition GreaterEqual(CSSVar.count, CSSVar.max) ThenBlock: { ReturnValue(0) }
        eaddr2 = Add(CSSVar.pool, Multiply(CSSVar.count, CSSVar.entry_sz))
        StoreValue(eaddr2, name_ptr)
        StoreValue(Add(eaddr2, 8), val_ptr)
        CSSVar.count = Add(CSSVar.count, 1)
        ReturnValue(1)
    }
}

// Resolve a CSS variable name (without the -- prefix, just the full name like "--sp-2")
// Returns pointer to value string, or 0 if not found
Function.CSS_VarResolve {
    Input: name_ptr: Address
    Output: Address
    Body: {
        IfCondition EqualTo(CSSVar.pool, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name_ptr, 0) ThenBlock: { ReturnValue(0) }

        CSSVarTmp.i = 0
        WhileLoop LessThan(CSSVarTmp.i, CSSVar.count) {
            eaddr = Add(CSSVar.pool, Multiply(CSSVarTmp.i, CSSVar.entry_sz))
            existing_name = Dereference(eaddr)
            IfCondition NotEqual(existing_name, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(existing_name, name_ptr), 0) ThenBlock: {
                    ReturnValue(Dereference(Add(eaddr, 8)))
                }
            }
            CSSVarTmp.i = Add(CSSVarTmp.i, 1)
        }
        ReturnValue(0)
    }
}

// Resolve var(--name) from a CSS value string
// Input: value string that starts with "var("
// Output: resolved value string, or 0 if not found
Function.CSS_ResolveVarExpr {
    Input: str: Address
    Output: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }

        // Check starts with var(
        IfCondition NotEqual(GetByte(str, 0), 118) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(str, 1), 97) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(str, 2), 114) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(str, 3), 40) ThenBlock: { ReturnValue(0) }

        // Extract variable name: skip "var(" (4 chars), read until ')' or ',' (for fallback)
        slen = StringLength(str)
        // Find end of variable name
        ni = 4
        // Skip leading whitespace
        WhileLoop LessThan(ni, slen) {
            nc = GetByte(str, ni)
            IfCondition And(NotEqual(nc, 32), NotEqual(nc, 9)) ThenBlock: { BreakLoop }
            ni = Add(ni, 1)
        }
        name_start = ni
        WhileLoop LessThan(ni, slen) {
            nc = GetByte(str, ni)
            // Stop at ) or , or whitespace
            IfCondition EqualTo(nc, 41) ThenBlock: { BreakLoop }
            IfCondition EqualTo(nc, 44) ThenBlock: { BreakLoop }
            IfCondition EqualTo(nc, 32) ThenBlock: { BreakLoop }
            ni = Add(ni, 1)
        }
        name_len = Subtract(ni, name_start)
        IfCondition EqualTo(name_len, 0) ThenBlock: { ReturnValue(0) }

        // Intern the variable name for comparison
        var_name = CSS__Intern(Add(str, name_start), name_len)
        IfCondition EqualTo(var_name, 0) ThenBlock: { ReturnValue(0) }

        // Look up
        resolved = CSS_VarResolve(var_name)
        IfCondition NotEqual(resolved, 0) ThenBlock: {
            // Check if resolved value itself is a var() — one level of indirection
            IfCondition EqualTo(GetByte(resolved, 0), 118) ThenBlock: {
                IfCondition EqualTo(GetByte(resolved, 1), 97) ThenBlock: {
                    IfCondition EqualTo(GetByte(resolved, 2), 114) ThenBlock: {
                        IfCondition EqualTo(GetByte(resolved, 3), 40) ThenBlock: {
                            resolved2 = CSS_ResolveVarExpr(resolved)
                            IfCondition NotEqual(resolved2, 0) ThenBlock: {
                                ReturnValue(resolved2)
                            }
                        }
                    }
                }
            }
            ReturnValue(resolved)
        }

        // Check for fallback value after comma: var(--name, fallback)
        IfCondition LessThan(ni, slen) ThenBlock: {
            fc = GetByte(str, ni)
            IfCondition EqualTo(fc, 44) ThenBlock: {
                fi = Add(ni, 1)
                // Skip whitespace after comma
                WhileLoop LessThan(fi, slen) {
                    fc2 = GetByte(str, fi)
                    IfCondition And(NotEqual(fc2, 32), NotEqual(fc2, 9)) ThenBlock: { BreakLoop }
                    fi = Add(fi, 1)
                }
                // Find closing paren
                fb_start = fi
                WhileLoop LessThan(fi, slen) {
                    fc3 = GetByte(str, fi)
                    IfCondition EqualTo(fc3, 41) ThenBlock: { BreakLoop }
                    fi = Add(fi, 1)
                }
                fb_len = Subtract(fi, fb_start)
                IfCondition GreaterThan(fb_len, 0) ThenBlock: {
                    fallback = CSS__Intern(Add(str, fb_start), fb_len)
                    ReturnValue(fallback)
                }
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// SELECTOR MATCHING
// =============================================================================

// Match against id attribute value
Function.CSS_MatchesId {
    Input: rule: Integer
    Input: id_attr: Address
    Output: Integer
    Body: {
        sel_type = CSS__RuleGet(rule, CSSConst.R_SEL_TYPE)
        IfCondition NotEqual(sel_type, CSSSelType.ID) ThenBlock: { ReturnValue(0) }

        sel_ptr = CSS__RuleGet(rule, CSSConst.R_SEL_PTR)
        IfCondition EqualTo(sel_ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(id_attr, 0) ThenBlock: { ReturnValue(0) }

        cmp = StringCompare(sel_ptr, id_attr)
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}
