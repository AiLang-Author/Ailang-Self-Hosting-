    Output: Integer
    Body: { ReturnValue(DOMState.node_count) }
}

Function.DOM_GetType {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(DOM__NodeGet(idx, DOMConst.N_TYPE)) }
}

Function.DOM_GetTag {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(DOM__NodeGet(idx, DOMConst.N_TAG_PTR)) }
}

Function.DOM_GetTagLen {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(DOM__NodeGet(idx, DOMConst.N_TAG_LEN)) }
}

Function.DOM_GetText {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(DOM__NodeGet(idx, DOMConst.N_TEXT_PTR)) }
}

Function.DOM_GetTextLen {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(DOM__NodeGet(idx, DOMConst.N_TEXT_LEN)) }
}

Function.DOM_GetParent {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(DOM__NodeGet(idx, DOMConst.N_PARENT)) }
}

Function.DOM_GetFirstChild {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(DOM__NodeGet(idx, DOMConst.N_FIRST_CH)) }
}

Function.DOM_GetLastChild {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(DOM__NodeGet(idx, DOMConst.N_LAST_CH)) }
}

