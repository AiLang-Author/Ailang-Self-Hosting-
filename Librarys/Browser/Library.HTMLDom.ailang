// =============================================================================
// ATTRIBUTE LOOKUP BY NAME
// =============================================================================
Function.DOM_GetAttr {
    Input: node: Integer
    Input: attr_name: Address
    Output: Address
    Body: {
        DOMTmp.first = DOM__NodeGet(node, DOMConst.N_ATTR_FIRST)
        IfCondition EqualTo(DOMTmp.first, -1) ThenBlock: { ReturnValue(0) }

        DOMTmp.count = DOM__NodeGet(node, DOMConst.N_ATTR_CT)
        IfCondition EqualTo(DOMTmp.count, 0) ThenBlock: { ReturnValue(0) }

        ga_i = DOMTmp.first
        ga_end = Add(DOMTmp.first, DOMTmp.count)
        WhileLoop LessThan(ga_i, ga_end) {
            DOMTmp.ptr = DOM__AttrAddr(ga_i)
            ga_name = Dereference(Add(DOMTmp.ptr, DOMConst.A_NAME_PTR))
            IfCondition NotEqual(ga_name, 0) ThenBlock: {
                cmp = StringCompare(ga_name, attr_name)
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    ReturnValue(Dereference(Add(DOMTmp.ptr, DOMConst.A_VAL_PTR)))
                }
            }
            ga_i = Add(ga_i, 1)
        }
        ReturnValue(0)
    }
}

// Set attribute value (update existing or add new)
Function.DOM_SetAttr {
    Input: node: Integer
    Input: attr_name: Address
    Input: attr_val: Address
    Body: {
        DOMTmp.first = DOM__NodeGet(node, DOMConst.N_ATTR_FIRST)
        IfCondition NotEqual(DOMTmp.first, -1) ThenBlock: {
            DOMTmp.count = DOM__NodeGet(node, DOMConst.N_ATTR_CT)
            sa_i = DOMTmp.first
            sa_end = Add(DOMTmp.first, DOMTmp.count)
            WhileLoop LessThan(sa_i, sa_end) {
                DOMTmp.ptr = DOM__AttrAddr(sa_i)
                sa_name = Dereference(Add(DOMTmp.ptr, DOMConst.A_NAME_PTR))
                IfCondition NotEqual(sa_name, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(sa_name, attr_name), 0) ThenBlock: {
                        // Found — update value pointer and length
                        StoreValue(Add(DOMTmp.ptr, DOMConst.A_VAL_PTR), attr_val)
                        sa_vl = StringLength(attr_val)
                        StoreValue(Add(DOMTmp.ptr, DOMConst.A_VAL_LEN), sa_vl)
                        ReturnValue(0)
                    }
                }
                sa_i = Add(sa_i, 1)
            }
        }
        // Not found — add new attribute
        nlen = StringLength(attr_name)
        vlen = StringLength(attr_val)
        DOM__AddAttr(node, attr_name, nlen, attr_val, vlen)
    }
}

// Get attribute name by index within a node
Function.DOM_AttrName {
    Input: node: Integer
    Input: attr_offset: Integer
    Output: Address
    Body: {
        DOMTmp.first = DOM__NodeGet(node, DOMConst.N_ATTR_FIRST)
        IfCondition EqualTo(DOMTmp.first, -1) ThenBlock: { ReturnValue(0) }
        real_idx = Add(DOMTmp.first, attr_offset)
        DOMTmp.ptr = DOM__AttrAddr(real_idx)
        ReturnValue(Dereference(Add(DOMTmp.ptr, DOMConst.A_NAME_PTR)))
    }
}

// Get attribute value by index within a node
Function.DOM_AttrVal {
    Input: node: Integer
    Input: attr_offset: Integer
    Output: Address
    Body: {
        DOMTmp.first = DOM__NodeGet(node, DOMConst.N_ATTR_FIRST)
        IfCondition EqualTo(DOMTmp.first, -1) ThenBlock: { ReturnValue(0) }
        real_idx = Add(DOMTmp.first, attr_offset)
        DOMTmp.ptr = DOM__AttrAddr(real_idx)
        ReturnValue(Dereference(Add(DOMTmp.ptr, DOMConst.A_VAL_PTR)))
    }
}

// =============================================================================
// DFS SEARCH — find first node with matching tag name
// =============================================================================
Function.DOM_FindByTag {
    Input: start: Integer
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition LessThan(start, 0) ThenBlock: { ReturnValue(-1) }

        ntype = DOM__NodeGet(start, DOMConst.N_TYPE)
        IfCondition EqualTo(ntype, DOMType.ELEMENT) ThenBlock: {
            DOMTmp.ptr = DOM__NodeGet(start, DOMConst.N_TAG_PTR)
            IfCondition NotEqual(DOMTmp.ptr, 0) ThenBlock: {
                cmp = StringCompare(DOMTmp.ptr, tag)
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    ReturnValue(start)
                }
            }
        }

        // Search children
        ch = DOM__NodeGet(start, DOMConst.N_FIRST_CH)
        WhileLoop NotEqual(ch, -1) {
            result = DOM_FindByTag(ch, tag)
            IfCondition NotEqual(result, -1) ThenBlock: {
                ReturnValue(result)
            }
            ch = DOM__NodeGet(ch, DOMConst.N_NEXT_SIB)
        }

        ReturnValue(-1)
    }
}

// =============================================================================
// DFS SEARCH — find first node with matching id attribute
// =============================================================================
Function.DOM_FindById {
    Input: start: Integer
    Input: id: Address
    Output: Integer
    Body: {
        IfCondition LessThan(start, 0) ThenBlock: { ReturnValue(-1) }

        ntype = DOM__NodeGet(start, DOMConst.N_TYPE)
        IfCondition EqualTo(ntype, DOMType.ELEMENT) ThenBlock: {
            id_val = DOM_GetAttr(start, "id")
            IfCondition NotEqual(id_val, 0) ThenBlock: {
                cmp = StringCompare(id_val, id)
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    ReturnValue(start)
                }
            }
        }

        // Search children
        ch = DOM__NodeGet(start, DOMConst.N_FIRST_CH)
        WhileLoop NotEqual(ch, -1) {
            result = DOM_FindById(ch, id)
            IfCondition NotEqual(result, -1) ThenBlock: {
                ReturnValue(result)
            }
            ch = DOM__NodeGet(ch, DOMConst.N_NEXT_SIB)
        }

        ReturnValue(-1)
    }
}

// =============================================================================
// DEBUG — DUMP DOM TREE
// =============================================================================
Function.DOM_Dump {
    Input: node: Integer
    Input: depth: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }

        // Indent
        di = 0
        WhileLoop LessThan(di, depth) {
            PrintMessage("  ")
            di = Add(di, 1)
        }

        ntype = DOM__NodeGet(node, DOMConst.N_TYPE)

        IfCondition EqualTo(ntype, DOMType.ROOT) ThenBlock: {
            PrintMessage("[ROOT]\n")
        }
        IfCondition EqualTo(ntype, DOMType.TEXT) ThenBlock: {
            tp = DOM__NodeGet(node, DOMConst.N_TEXT_PTR)
            PrintMessage("[TEXT] \"")
            IfCondition NotEqual(tp, 0) ThenBlock: { PrintMessage(tp) }
            PrintMessage("\"\n")
        }
        IfCondition EqualTo(ntype, DOMType.COMMENT) ThenBlock: {
            tp = DOM__NodeGet(node, DOMConst.N_TEXT_PTR)
            PrintMessage("[COMMENT] \"")
            IfCondition NotEqual(tp, 0) ThenBlock: { PrintMessage(tp) }
            PrintMessage("\"\n")
        }
        IfCondition EqualTo(ntype, DOMType.ELEMENT) ThenBlock: {
            tname = DOM__NodeGet(node, DOMConst.N_TAG_PTR)
            PrintMessage("<")
            IfCondition NotEqual(tname, 0) ThenBlock: { PrintMessage(tname) }
            PrintMessage(">")

            // Print attributes
            acount = DOM__NodeGet(node, DOMConst.N_ATTR_CT)
            afirst = DOM__NodeGet(node, DOMConst.N_ATTR_FIRST)
            IfCondition GreaterThan(acount, 0) ThenBlock: {
                da_i = afirst
                da_end = Add(afirst, acount)
                WhileLoop LessThan(da_i, da_end) {
                    DOMTmp.ptr = DOM__AttrAddr(da_i)
                    da_n = Dereference(Add(DOMTmp.ptr, DOMConst.A_NAME_PTR))
                    IfCondition NotEqual(da_n, 0) ThenBlock: {
                        PrintMessage(" ")
                        PrintMessage(da_n)
                        da_v = Dereference(Add(DOMTmp.ptr, DOMConst.A_VAL_PTR))
                        IfCondition NotEqual(da_v, 0) ThenBlock: {
                            PrintMessage("=\"")
                            PrintMessage(da_v)
                            PrintMessage("\"")
                        }
                    }
                    da_i = Add(da_i, 1)
                }
            }
            PrintMessage("\n")
        }

        // Recurse children
        dchild = DOM__NodeGet(node, DOMConst.N_FIRST_CH)
        child_depth = Add(depth, 1)
        WhileLoop NotEqual(dchild, -1) {
            DOM_Dump(dchild, child_depth)
            dchild = DOM__NodeGet(dchild, DOMConst.N_NEXT_SIB)
        }
    }
}

// =============================================================================
// DOM MUTATION API — createElement, createTextNode, appendChild, removeChild,
// insertBefore, createComment, replaceChild, cloneNode (shallow)
// =============================================================================

// Create element node with given tag name (copies tag string to arena)
Function.DOM_CreateElement {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(-1) }
        elem = DOM__CreateNode(DOMType.ELEMENT)
        IfCondition LessThan(elem, 0) ThenBlock: { ReturnValue(-1) }

        // Copy tag name to arena for stable storage
        tlen = StringLength(tag)
        tbuf = Allocate(Add(tlen, 1))
        MemoryCopy(tbuf, tag, tlen)
        SetByte(tbuf, tlen, 0)
        DOM__NodeSet(elem, DOMConst.N_TAG_PTR, tbuf)
        DOM__NodeSet(elem, DOMConst.N_TAG_LEN, tlen)
        ReturnValue(elem)
    }
}

// Create text node with given content (copies text to arena)
Function.DOM_CreateTextNode {
    Input: text: Address
    Input: text_len: Integer
    Output: Integer
    Body: {
        tnode = DOM__CreateNode(DOMType.TEXT)
        IfCondition LessThan(tnode, 0) ThenBlock: { ReturnValue(-1) }

        IfCondition And(NotEqual(text, 0), GreaterThan(text_len, 0)) ThenBlock: {
            tbuf = Allocate(Add(text_len, 1))
            MemoryCopy(tbuf, text, text_len)
            SetByte(tbuf, text_len, 0)
            DOM__NodeSet(tnode, DOMConst.N_TEXT_PTR, tbuf)
            DOM__NodeSet(tnode, DOMConst.N_TEXT_LEN, text_len)
        }
        ReturnValue(tnode)
    }
}

// Create comment node
Function.DOM_CreateComment {
    Input: text: Address
    Input: text_len: Integer
    Output: Integer
    Body: {
        cnode = DOM__CreateNode(DOMType.COMMENT)
        IfCondition LessThan(cnode, 0) ThenBlock: { ReturnValue(-1) }

        IfCondition And(NotEqual(text, 0), GreaterThan(text_len, 0)) ThenBlock: {
            cbuf = Allocate(Add(text_len, 1))
            MemoryCopy(cbuf, text, text_len)
            SetByte(cbuf, text_len, 0)
            DOM__NodeSet(cnode, DOMConst.N_TEXT_PTR, cbuf)
            DOM__NodeSet(cnode, DOMConst.N_TEXT_LEN, text_len)
        }
        ReturnValue(cnode)
    }
}

// Public appendChild — delegates to internal O(1) append
Function.DOM_AppendChild {
    Input: parent: Integer
    Input: child: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(parent, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(child, 0) ThenBlock: { ReturnValue(-1) }

        // If child already has a parent, remove it first
        old_parent = DOM__NodeGet(child, DOMConst.N_PARENT)
        IfCondition NotEqual(old_parent, -1) ThenBlock: {
            DOM_RemoveChild(old_parent, child)
        }

        DOM__AppendChild(parent, child)
        ReturnValue(child)
    }
}

// Remove child from parent — fixes sibling chain
Function.DOM_RemoveChild {
    Input: parent: Integer
    Input: child: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(parent, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(child, 0) ThenBlock: { ReturnValue(-1) }

        prev = DOM__NodeGet(child, DOMConst.N_PREV_SIB)
        next = DOM__NodeGet(child, DOMConst.N_NEXT_SIB)

        // Fix previous sibling's next pointer
        IfCondition NotEqual(prev, -1) ThenBlock: {
            DOM__NodeSet(prev, DOMConst.N_NEXT_SIB, next)
        } ElseBlock: {
            // Child was first child — update parent's first_child
            DOM__NodeSet(parent, DOMConst.N_FIRST_CH, next)
        }

        // Fix next sibling's prev pointer
        IfCondition NotEqual(next, -1) ThenBlock: {
            DOM__NodeSet(next, DOMConst.N_PREV_SIB, prev)
        } ElseBlock: {
            // Child was last child — update parent's last_child
            DOM__NodeSet(parent, DOMConst.N_LAST_CH, prev)
        }

        // Decrement child count
        DOMTmp.count = DOM__NodeGet(parent, DOMConst.N_CHILD_CT)
        IfCondition GreaterThan(DOMTmp.count, 0) ThenBlock: {
            DOM__NodeSet(parent, DOMConst.N_CHILD_CT, Subtract(DOMTmp.count, 1))
        }

        // Detach child from tree
        DOM__NodeSet(child, DOMConst.N_PARENT, -1)
        DOM__NodeSet(child, DOMConst.N_PREV_SIB, -1)
        DOM__NodeSet(child, DOMConst.N_NEXT_SIB, -1)

        ReturnValue(child)
    }
}

// Insert newChild before refChild under parent
Function.DOM_InsertBefore {
    Input: parent: Integer
    Input: newChild: Integer
    Input: refChild: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(parent, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(newChild, 0) ThenBlock: { ReturnValue(-1) }

        // If refChild is -1, behave like appendChild
        IfCondition LessThan(refChild, 0) ThenBlock: {
            ReturnValue(DOM_AppendChild(parent, newChild))
        }

        // If newChild already has a parent, remove it first
        old_parent = DOM__NodeGet(newChild, DOMConst.N_PARENT)
        IfCondition NotEqual(old_parent, -1) ThenBlock: {
            DOM_RemoveChild(old_parent, newChild)
        }

        // Set parent
        DOM__NodeSet(newChild, DOMConst.N_PARENT, parent)

        // Get refChild's previous sibling
        ref_prev = DOM__NodeGet(refChild, DOMConst.N_PREV_SIB)

        // Link newChild into chain before refChild
        DOM__NodeSet(newChild, DOMConst.N_NEXT_SIB, refChild)
        DOM__NodeSet(newChild, DOMConst.N_PREV_SIB, ref_prev)
        DOM__NodeSet(refChild, DOMConst.N_PREV_SIB, newChild)

        IfCondition NotEqual(ref_prev, -1) ThenBlock: {
            DOM__NodeSet(ref_prev, DOMConst.N_NEXT_SIB, newChild)
        } ElseBlock: {
            // refChild was first child — newChild is now first
            DOM__NodeSet(parent, DOMConst.N_FIRST_CH, newChild)
        }

        // Increment child count
        DOMTmp.count = DOM__NodeGet(parent, DOMConst.N_CHILD_CT)
        DOM__NodeSet(parent, DOMConst.N_CHILD_CT, Add(DOMTmp.count, 1))

        ReturnValue(newChild)
    }
}

// Replace oldChild with newChild under parent
Function.DOM_ReplaceChild {
    Input: parent: Integer
    Input: newChild: Integer
    Input: oldChild: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(parent, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(newChild, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(oldChild, 0) ThenBlock: { ReturnValue(-1) }

        DOM_InsertBefore(parent, newChild, oldChild)
        DOM_RemoveChild(parent, oldChild)
        ReturnValue(oldChild)
    }
}

// Check if ancestor contains descendant (or is same node)
Function.DOM_Contains {
    Input: ancestor: Integer
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(ancestor, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }

        cur = node
        WhileLoop NotEqual(cur, -1) {
            IfCondition EqualTo(cur, ancestor) ThenBlock: {
                ReturnValue(1)
            }
            cur = DOM__NodeGet(cur, DOMConst.N_PARENT)
        }
        ReturnValue(0)
    }
}

// Set text content of a node (replaces all children with single text node)
Function.DOM_SetTextContent {
    Input: node: Integer
    Input: text: Address
    Input: text_len: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }

        // Remove all children
        ch = DOM__NodeGet(node, DOMConst.N_FIRST_CH)
        WhileLoop NotEqual(ch, -1) {
            next_ch = DOM__NodeGet(ch, DOMConst.N_NEXT_SIB)
            DOM__NodeSet(ch, DOMConst.N_PARENT, -1)
            DOM__NodeSet(ch, DOMConst.N_PREV_SIB, -1)
            DOM__NodeSet(ch, DOMConst.N_NEXT_SIB, -1)
            ch = next_ch
        }
        DOM__NodeSet(node, DOMConst.N_FIRST_CH, -1)
        DOM__NodeSet(node, DOMConst.N_LAST_CH, -1)
        DOM__NodeSet(node, DOMConst.N_CHILD_CT, 0)

        // If text is non-empty, create and append text node
        IfCondition And(NotEqual(text, 0), GreaterThan(text_len, 0)) ThenBlock: {
            tnode = DOM_CreateTextNode(text, text_len)
            IfCondition GreaterEqual(tnode, 0) ThenBlock: {
                DOM__AppendChild(node, tnode)
            }
        }
    }
}

// Get aggregated text content of a subtree
Function.DOM_GetTextContent {
    Input: node: Integer
    Input: buf: Address
    Input: buf_cap: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }

        ntype = DOM__NodeGet(node, DOMConst.N_TYPE)

        // Text/Comment nodes — copy directly
        IfCondition Or(EqualTo(ntype, DOMType.TEXT), EqualTo(ntype, DOMType.COMMENT)) ThenBlock: {
            tp = DOM__NodeGet(node, DOMConst.N_TEXT_PTR)
            tl = DOM__NodeGet(node, DOMConst.N_TEXT_LEN)
            IfCondition And(NotEqual(tp, 0), GreaterThan(tl, 0)) ThenBlock: {
                IfCondition GreaterThan(tl, buf_cap) ThenBlock: { tl = buf_cap }
                MemoryCopy(buf, tp, tl)
                ReturnValue(tl)
            }
            ReturnValue(0)
        }

        // Element/Root nodes — recurse children
        total = 0
        ch = DOM__NodeGet(node, DOMConst.N_FIRST_CH)
        WhileLoop NotEqual(ch, -1) {
            remain = Subtract(buf_cap, total)
            IfCondition LessEqual(remain, 0) ThenBlock: { BreakLoop }
            wrote = DOM_GetTextContent(ch, Add(buf, total), remain)
            total = Add(total, wrote)
            ch = DOM__NodeGet(ch, DOMConst.N_NEXT_SIB)
        }
        ReturnValue(total)
    }
}

// =============================================================================
// QUERY — find all elements matching a tag name (returns count, fills array)
// =============================================================================
Function.DOM_GetElementsByTagName {
    Input: start: Integer
    Input: tag: Address
    Input: result_buf: Address
    Input: max_results: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(start, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(0) }

        count = 0
        ni = 0
        WhileLoop LessThan(ni, DOMState.node_count) {
            IfCondition GreaterEqual(count, max_results) ThenBlock: { BreakLoop }
            ntype = DOM__NodeGet(ni, DOMConst.N_TYPE)
            IfCondition EqualTo(ntype, DOMType.ELEMENT) ThenBlock: {
                // Check if this node is a descendant of start (or start itself)
                is_desc = DOM_Contains(start, ni)
                IfCondition EqualTo(is_desc, 1) ThenBlock: {
                    ntag = DOM__NodeGet(ni, DOMConst.N_TAG_PTR)
                    IfCondition NotEqual(ntag, 0) ThenBlock: {
                        // "*" matches all elements
                        IfCondition EqualTo(GetByte(tag, 0), 42) ThenBlock: {
                            StoreValue(Add(result_buf, Multiply(count, 8)), ni)
                            count = Add(count, 1)
                        }
                        IfCondition NotEqual(GetByte(tag, 0), 42) ThenBlock: {
                            IfCondition EqualTo(StringCompare(ntag, tag), 0) ThenBlock: {
                                StoreValue(Add(result_buf, Multiply(count, 8)), ni)
                                count = Add(count, 1)
                            }
                        }
                    }
                }
            }
            ni = Add(ni, 1)
        }
        ReturnValue(count)
    }
}

// Find all elements with matching class name
Function.DOM_GetElementsByClassName {
    Input: start: Integer
    Input: cls: Address
    Input: result_buf: Address
    Input: max_results: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(start, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cls, 0) ThenBlock: { ReturnValue(0) }

        count = 0
        ni = 0
        WhileLoop LessThan(ni, DOMState.node_count) {
            IfCondition GreaterEqual(count, max_results) ThenBlock: { BreakLoop }
            ntype = DOM__NodeGet(ni, DOMConst.N_TYPE)
            IfCondition EqualTo(ntype, DOMType.ELEMENT) ThenBlock: {
                is_desc = DOM_Contains(start, ni)
                IfCondition EqualTo(is_desc, 1) ThenBlock: {
                    node_cls = DOM_GetAttr(ni, "class")
                    IfCondition NotEqual(node_cls, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(node_cls, cls), 0) ThenBlock: {
                            StoreValue(Add(result_buf, Multiply(count, 8)), ni)
                            count = Add(count, 1)
                        }
                    }
                }
            }
            ni = Add(ni, 1)
        }
        ReturnValue(count)
    }
}

// =============================================================================
// DEBUG — DUMP DOM TREE
// =============================================================================
Function.DOM_DumpAll {
    Body: {
        PrintMessage("\n--- DOM TREE ---\n")
        IfCondition GreaterEqual(DOMState.root, 0) ThenBlock: {
            DOM_Dump(DOMState.root, 0)
        }
        PrintMessage("--- END DOM ---\n\n")
    }
}
