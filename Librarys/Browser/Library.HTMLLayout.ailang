// Library.HTMLLayout.ailang — Simple block-level HTML layout engine
// Walks DOM tree, resolves CSS styles, produces flat draw command list.
// Vertical block stacking with inline text flow (word wrap).
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse

// =============================================================================
// DISPLAY TYPES
// =============================================================================
FixedPool.LYDisp {
    "BLOCK":     Initialize=1
    "INLINE":    Initialize=2
    "NONE":      Initialize=3
    "TEXT":       Initialize=4
}

// =============================================================================
// DRAW COMMAND TYPES
// =============================================================================
FixedPool.LYCmd {
    "FILL_RECT":  Initialize=1
    "DRAW_TEXT":  Initialize=2
    "DRAW_LINE":  Initialize=3
    "DRAW_IMAGE": Initialize=4
}

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.LYConst {
    "MAX_CMDS":    Initialize=8192
    "CMD_SIZE":    Initialize=56    // 7 fields x 8 bytes
    // Command field offsets
    "C_TYPE":      Initialize=0
    "C_X":         Initialize=8
    "C_Y":         Initialize=16
    "C_W":         Initialize=24
    "C_H":         Initialize=32
    "C_COLOR":     Initialize=40
    "C_PTR":       Initialize=48   // text pointer or pixel pointer
    // Font metrics (TermFont 8x16)
    "FONT_W":      Initialize=8
    "FONT_H":      Initialize=16
    // Default colors (BGRA: B + G*256 + R*65536 + A*16777216)
    "COLOR_BLACK":    Initialize=4278190080  // 0xFF000000 R=0,G=0,B=0
    "COLOR_WHITE":    Initialize=4294967295  // 0xFFFFFFFF R=255,G=255,B=255
    "COLOR_BG":       Initialize=4293848050  // 0xFFF2F0F0 #f0f0f2
    "COLOR_LINK":     Initialize=4278190335  // 0xFF0000FF R=0,G=0,B=255 (blue)
    "COLOR_GRAY":     Initialize=4286611584  // 0xFF808080
    "COLOR_TRANSP":   Initialize=0           // transparent
    // Heading sizes (line heights in multiples of FONT_H)
    "H1_SCALE":    Initialize=2    // 32px = 2x16
    "H2_SCALE":    Initialize=2    // 24px ~= 1.5x16, use 2 for simplicity
    "H3_SCALE":    Initialize=1    // 20px ~= 1x16
    "DEFAULT_MARGIN": Initialize=16
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.LYState {
    "cmd_pool":     Initialize=0
    "cmd_count":    Initialize=0
    "viewport_w":   Initialize=1024
    "viewport_h":   Initialize=700
    "cursor_x":     Initialize=0
    "cursor_y":     Initialize=0
    "content_h":    Initialize=0    // total content height after layout
    "indent":       Initialize=0    // current left indent (from nested blocks)
    "avail_w":      Initialize=1024 // current available width
    "fg_color":     Initialize=255  // current text color (black default)
    "bg_color":     Initialize=0    // current bg color (transparent)
    "font_scale":   Initialize=1    // current font scale factor
    "in_pre":       Initialize=0    // inside <pre> block
    "text_align":   Initialize=0    // 0=left, 1=center, 2=right
    "show_noscript": Initialize=0   // 1=render <noscript> content (JS failed)
    "visible":       Initialize=1   // 0=visibility:hidden (layout preserved, no paint)
    "line_height":   Initialize=0   // line-height in px (0=default: FONT_H * font_scale)
    "font_size_px":  Initialize=16  // actual font size in pixels (from CSS font-size)
    "font_w_px":     Initialize=8   // glyph advance width in pixels (8 for TermFont, font_size_px for Ahem)
    "is_ahem":       Initialize=0   // 1 if current font-family is Ahem
    // Hit-test regions for interactive elements
    "hit_pool":     Initialize=0
    "hit_count":    Initialize=0
}

// =============================================================================
// HIT-TEST REGION TYPES AND CONSTANTS
// =============================================================================
FixedPool.LYHit {
    "MAX_REGIONS":  Initialize=256
    "REGION_SIZE":  Initialize=48   // 6 fields x 8 bytes
    // Field offsets
    "H_X":          Initialize=0
    "H_Y":          Initialize=8
    "H_W":          Initialize=16
    "H_H":          Initialize=24
    "H_NODE":       Initialize=32   // DOM node index
    "H_TYPE":       Initialize=40   // 1=text_input, 2=button/submit, 3=link
}

FixedPool.LYHitType {
    "INPUT":    Initialize=1
    "BUTTON":   Initialize=2
    "LINK":     Initialize=3
}

// =============================================================================
// FLEXBOX STATE
// =============================================================================
FixedPool.LYFlex {
    "pool":         Initialize=0    // flex item data buffer
    "count":        Initialize=0    // number of flex items this pass
    "MAX_ITEMS":    Initialize=128  // max flex children per container
    "ITEM_SIZE":    Initialize=48   // 6 fields × 8 bytes per item
    // Per-item field offsets
    "I_NODE":       Initialize=0    // DOM node index
    "I_MEAS_W":     Initialize=8    // measured width
    "I_MEAS_H":     Initialize=16   // measured height
    "I_CMD_START":  Initialize=24   // first command index
    "I_CMD_COUNT":  Initialize=32   // number of commands emitted
    "I_GROW":       Initialize=40   // flex-grow (integer, default 0)
}

FixedPool.LYFlexTmp {
    "dir":       Initialize=0    // 0=row, 1=column
    "justify":   Initialize=0    // 0=start, 1=end, 2=center, 3=space-between, 4=space-around
    "align":     Initialize=0    // 0=stretch, 1=start, 2=end, 3=center
    "gap":       Initialize=0    // gap in pixels
    "wrap":      Initialize=0    // 0=nowrap, 1=wrap
    "total_main": Initialize=0   // sum of children's main-axis sizes
    "free_space": Initialize=0   // remaining space after children placed
    "total_grow": Initialize=0   // sum of flex-grow values
    "item_i":    Initialize=0    // iterator for flex items
}

// =============================================================================
// CSS RULE MATCHING TEMPORARIES (separate pool to avoid clobbering LYTmp)
// =============================================================================
FixedPool.LYCss {
    "ri":        Initialize=0
    "rcount":    Initialize=0
    "matched":   Initialize=0
    "result":    Initialize=0
    "tag":       Initialize=0
    "cls":       Initialize=0
    "id":        Initialize=0
    "val":       Initialize=0
    "best":      Initialize=0
    "spec":      Initialize=0
    "ci":        Initialize=0
    "clen":      Initialize=0
    "nlen":      Initialize=0
    "wstart":    Initialize=0
    "cmb_node":  Initialize=0
    "cmb_depth": Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.LYTmp {
    "idx":       Initialize=0
    "type":      Initialize=0
    "tag":       Initialize=0
    "tag_len":   Initialize=0
    "text":      Initialize=0
    "text_len":  Initialize=0
    "disp":      Initialize=0
    "child":     Initialize=0
    "x":         Initialize=0
    "y":         Initialize=0
    "w":         Initialize=0
    "h":         Initialize=0
    "color":     Initialize=0
    "val":       Initialize=0
    "ptr":       Initialize=0
    "save_x":    Initialize=0
    "save_y":    Initialize=0
    "save_w":    Initialize=0
    "save_fg":   Initialize=0
    "save_bg":   Initialize=0
    "save_sc":   Initialize=0
    "save_ind":  Initialize=0
    "ns_addr":   Initialize=0    // dedicated for CmdSet/CmdGet
    "ch":        Initialize=0
    "line_x":    Initialize=0
    "line_w":    Initialize=0
    "word_st":   Initialize=0
    "ci":        Initialize=0
}

// =============================================================================
// INIT / RESET
// =============================================================================
Function.Layout_Init {
    Output: Integer
    Body: {
        // Only allocate once — guard against repeated calls leaking memory
        IfCondition NotEqual(LYState.cmd_pool, 0) ThenBlock: {
            Layout_Reset()
            ReturnValue(1)
        }

        csz = Multiply(LYConst.MAX_CMDS, LYConst.CMD_SIZE)
        LYState.cmd_pool = Allocate(csz)
        IfCondition EqualTo(LYState.cmd_pool, 0) ThenBlock: {
            PrintMessage("[LAYOUT] alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(LYState.cmd_pool, 0, csz)
        LYState.cmd_count = 0

        // Allocate hit-test region pool
        hsz = Multiply(LYHit.MAX_REGIONS, LYHit.REGION_SIZE)
        LYState.hit_pool = Allocate(hsz)
        IfCondition EqualTo(LYState.hit_pool, 0) ThenBlock: {
            PrintMessage("[LAYOUT] hit pool alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(LYState.hit_pool, 0, hsz)
        LYState.hit_count = 0

        // Allocate flex item pool
        fsz = Multiply(LYFlex.MAX_ITEMS, LYFlex.ITEM_SIZE)
        LYFlex.pool = Allocate(fsz)
        IfCondition EqualTo(LYFlex.pool, 0) ThenBlock: {
            PrintMessage("[LAYOUT] flex pool alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(LYFlex.pool, 0, fsz)
        LYFlex.count = 0

        // Inject UA stylesheet — default styles for all HTML elements
        // This fires once on first Layout_Init (before any page CSS)
        LY__InjectUAStyles()

        ReturnValue(1)
    }
}

// =============================================================================
// UA STYLESHEET — inject default styles for standard HTML elements
// Must be called AFTER CSS_Init() and BEFORE any CSS_ParseSheet for page CSS.
// The CSS cascade ensures page CSS overrides these (lower specificity).
// =============================================================================
Function.LY__InjectUAStyles {
    Body: {
        ua = "html,body{display:block;margin:0}body{margin:8px}h1{display:block;font-size:32px;margin-top:21px;margin-bottom:21px}h2{display:block;font-size:24px;margin-top:19px;margin-bottom:19px}h3{display:block;font-size:18px;margin-top:18px;margin-bottom:18px}h4{display:block;margin-top:21px;margin-bottom:21px}h5{display:block;margin-top:22px;margin-bottom:22px}h6{display:block;margin-top:24px;margin-bottom:24px}p{display:block;margin-top:16px;margin-bottom:16px}div{display:block}ul,ol{display:block;margin-top:16px;margin-bottom:16px;padding-left:40px}li{display:block}pre{display:block;margin-top:16px;margin-bottom:16px}blockquote{display:block;margin-top:16px;margin-bottom:16px;margin-left:40px;margin-right:40px}hr{display:block;margin-top:8px;margin-bottom:8px;border-top:1px solid #ccc}table{display:block}form{display:block}header,footer,main,section,article,nav,aside{display:block}figure{display:block;margin-top:16px;margin-bottom:16px;margin-left:40px;margin-right:40px}figcaption{display:block}fieldset{display:block;margin-left:2px;margin-right:2px;padding-top:8px;padding-bottom:12px;padding-left:12px;padding-right:12px;border:2px solid #ccc}a{color:#0000ee}span,em,strong,b,i,u,s,code,small,big,sub,sup{display:inline}dd{margin-left:40px}dt{display:block}"
        ua_len = StringLength(ua)
        ua_rules = CSS_ParseSheet(ua, ua_len)
        PrintMessage("[LAYOUT] UA stylesheet: ")
        PrintNumber(ua_rules)
        PrintMessage(" rules\n")
    }
}

Function.Layout_Reset {
    Body: {
        LYState.cmd_count = 0
        LYState.hit_count = 0
        LYState.cursor_x = 0
        LYState.cursor_y = 0
        LYState.content_h = 0
        LYState.indent = 0
        LYState.avail_w = LYState.viewport_w
        LYState.fg_color = LYConst.COLOR_BLACK
        LYState.bg_color = LYConst.COLOR_TRANSP
        LYState.font_scale = 1
        LYState.in_pre = 0
        LYState.text_align = 0
        LYState.visible = 1
        LYState.line_height = 0
        LYState.font_size_px = 16
        LYState.font_w_px = 8
        LYState.is_ahem = 0
    }
}

// =============================================================================
// COMMAND POOL HELPERS
// =============================================================================
Function.LY__CmdAddr {
    Input: idx: Integer
    Output: Address
    Body: {
        ReturnValue(Add(LYState.cmd_pool, Multiply(idx, LYConst.CMD_SIZE)))
    }
}

Function.LY__CmdSet {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        LYTmp.ns_addr = LY__CmdAddr(idx)
        StoreValue(Add(LYTmp.ns_addr, field), val)
    }
}

Function.LY__CmdGet {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        LYTmp.ns_addr = LY__CmdAddr(idx)
        ReturnValue(Dereference(Add(LYTmp.ns_addr, field)))
    }
}

// =============================================================================
// EMIT DRAW COMMANDS
// =============================================================================
Function.LY__EmitFillRect {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(LYState.visible, 0) ThenBlock: { ReturnValue(0) }
        idx = LYState.cmd_count
        IfCondition GreaterEqual(idx, LYConst.MAX_CMDS) ThenBlock: { ReturnValue(0) }
        LYState.cmd_count = Add(idx, 1)
        LY__CmdSet(idx, LYConst.C_TYPE, LYCmd.FILL_RECT)
        LY__CmdSet(idx, LYConst.C_X, x)
        LY__CmdSet(idx, LYConst.C_Y, y)
        LY__CmdSet(idx, LYConst.C_W, w)
        LY__CmdSet(idx, LYConst.C_H, h)
        LY__CmdSet(idx, LYConst.C_COLOR, color)
    }
}

// Note: 6-arg limit means we need to split text emit
// Store text pointer in LYTmp.ptr before calling
Function.LY__EmitDrawText {
    Input: x: Integer
    Input: y: Integer
    Input: len: Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(LYState.visible, 0) ThenBlock: { ReturnValue(0) }
        idx = LYState.cmd_count
        IfCondition GreaterEqual(idx, LYConst.MAX_CMDS) ThenBlock: { ReturnValue(0) }
        LYState.cmd_count = Add(idx, 1)
        LY__CmdSet(idx, LYConst.C_TYPE, LYCmd.DRAW_TEXT)
        LY__CmdSet(idx, LYConst.C_X, x)
        LY__CmdSet(idx, LYConst.C_Y, y)
        LY__CmdSet(idx, LYConst.C_W, len)
        LY__CmdSet(idx, LYConst.C_H, LYState.font_w_px)
        LY__CmdSet(idx, LYConst.C_COLOR, color)
        LY__CmdSet(idx, LYConst.C_PTR, LYTmp.ptr)
    }
}

Function.LY__EmitDrawLine {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(LYState.visible, 0) ThenBlock: { ReturnValue(0) }
        idx = LYState.cmd_count
        IfCondition GreaterEqual(idx, LYConst.MAX_CMDS) ThenBlock: { ReturnValue(0) }
        LYState.cmd_count = Add(idx, 1)
        LY__CmdSet(idx, LYConst.C_TYPE, LYCmd.DRAW_LINE)
        LY__CmdSet(idx, LYConst.C_X, x)
        LY__CmdSet(idx, LYConst.C_Y, y)
        LY__CmdSet(idx, LYConst.C_W, w)
        LY__CmdSet(idx, LYConst.C_COLOR, color)
    }
}

// =============================================================================
// LINE HEIGHT HELPER
// =============================================================================
// Returns effective line height in pixels: CSS line-height if set, else FONT_H * font_scale
Function.LY__LineHeight {
    Output: Integer
    Body: {
        IfCondition GreaterThan(LYState.line_height, 0) ThenBlock: {
            ReturnValue(LYState.line_height)
        }
        // Ahem font: line height = font_size_px (1em = font_size_px)
        IfCondition EqualTo(LYState.is_ahem, 1) ThenBlock: {
            ReturnValue(LYState.font_size_px)
        }
        ReturnValue(Multiply(LYConst.FONT_H, LYState.font_scale))
    }
}

// =============================================================================
// HIT-REGION RECORDING + LOOKUP
// =============================================================================
Function.LY__AddHitRegion {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: node: Integer
    Input: htype: Integer
    Body: {
        IfCondition GreaterEqual(LYState.hit_count, LYHit.MAX_REGIONS) ThenBlock: { ReturnValue(0) }
        off = Multiply(LYState.hit_count, LYHit.REGION_SIZE)
        base = Add(LYState.hit_pool, off)
        StoreValue(Add(base, LYHit.H_X), x)
        StoreValue(Add(base, LYHit.H_Y), y)
        StoreValue(Add(base, LYHit.H_W), w)
        StoreValue(Add(base, LYHit.H_H), h)
        StoreValue(Add(base, LYHit.H_NODE), node)
        StoreValue(Add(base, LYHit.H_TYPE), htype)
        LYState.hit_count = Add(LYState.hit_count, 1)
    }
}

// Hit-test: find which interactive region contains (px, py)
// Returns region index or -1
Function.Layout_HitTest {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        hi = 0
        WhileLoop LessThan(hi, LYState.hit_count) {
            off = Multiply(hi, LYHit.REGION_SIZE)
            base = Add(LYState.hit_pool, off)
            hx = Dereference(Add(base, LYHit.H_X))
            hy = Dereference(Add(base, LYHit.H_Y))
            hw = Dereference(Add(base, LYHit.H_W))
            hh = Dereference(Add(base, LYHit.H_H))
            IfCondition And(And(GreaterEqual(px, hx), LessThan(px, Add(hx, hw))),
                           And(GreaterEqual(py, hy), LessThan(py, Add(hy, hh)))) ThenBlock: {
                ReturnValue(hi)
            }
            hi = Add(hi, 1)
        }
        ReturnValue(-1)
    }
}

Function.Layout_HitNode {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        off = Multiply(idx, LYHit.REGION_SIZE)
        base = Add(LYState.hit_pool, off)
        ReturnValue(Dereference(Add(base, LYHit.H_NODE)))
    }
}

Function.Layout_HitType {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        off = Multiply(idx, LYHit.REGION_SIZE)
        base = Add(LYState.hit_pool, off)
        ReturnValue(Dereference(Add(base, LYHit.H_TYPE)))
    }
}

Function.Layout_HitCount {
    Output: Integer
    Body: { ReturnValue(LYState.hit_count) }
}

// =============================================================================
// DISPLAY TYPE CLASSIFICATION
// =============================================================================
Function.LY__GetDisplay {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }

        // NONE — skip entirely
        IfCondition EqualTo(StringCompare(tag, "head"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "script"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "style"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "meta"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "link"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "title"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "noscript"), 0) ThenBlock: {
            IfCondition EqualTo(LYState.show_noscript, 1) ThenBlock: {
                ReturnValue(LYDisp.BLOCK)
            }
            ReturnValue(LYDisp.NONE)
        }
        IfCondition EqualTo(StringCompare(tag, "template"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "svg"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }

        // BLOCK elements
        IfCondition EqualTo(StringCompare(tag, "html"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "body"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "div"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "p"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h1"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h2"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h3"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h4"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h5"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h6"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "ul"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "ol"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "li"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "header"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "footer"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "main"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "section"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "article"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "nav"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "aside"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "blockquote"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "pre"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "hr"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "form"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "table"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "thead"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "tbody"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "tfoot"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "tr"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "caption"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "center"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "figure"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "figcaption"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "details"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "fieldset"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "legend"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "summary"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "address"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "dd"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "dt"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "dl"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "dialog"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "hgroup"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "search"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }

        // Everything else is INLINE
        ReturnValue(LYDisp.INLINE)
    }
}

// =============================================================================
// HEADING SCALE — returns font scale for heading tags
// =============================================================================
Function.LY__HeadingScale {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(tag, "h1"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(tag, "h2"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(tag, "h3"), 0) ThenBlock: { ReturnValue(2) }
        ReturnValue(1)
    }
}

// =============================================================================
// COLOR PARSING — CSS color name or hex to BGRA
// =============================================================================
Function.LY__ParseColor {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }

        // Check for hex color #RGB or #RRGGBB
        c0 = GetByte(str, 0)
        IfCondition EqualTo(c0, 35) ThenBlock: {
            slen = StringLength(str)
            IfCondition EqualTo(slen, 7) ThenBlock: {
                // #RRGGBB — parse hex digits
                r = LY__HexPair(str, 1)
                g = LY__HexPair(str, 3)
                b = LY__HexPair(str, 5)
                // BGRA format: B | (G<<8) | (R<<16) | (0xFF<<24)
                bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
                ReturnValue(bgra)
            }
            IfCondition EqualTo(slen, 4) ThenBlock: {
                // #RGB — expand each digit
                r1 = LY__HexDigit(str, 1)
                g1 = LY__HexDigit(str, 2)
                b1 = LY__HexDigit(str, 3)
                r = Add(Multiply(r1, 16), r1)
                g = Add(Multiply(g1, 16), g1)
                b = Add(Multiply(b1, 16), b1)
                bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
                ReturnValue(bgra)
            }
            IfCondition EqualTo(slen, 9) ThenBlock: {
                // #RRGGBBAA — parse 8-digit hex (ignore alpha, treat as opaque)
                r = LY__HexPair(str, 1)
                g = LY__HexPair(str, 3)
                b = LY__HexPair(str, 5)
                bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
                ReturnValue(bgra)
            }
            IfCondition EqualTo(slen, 5) ThenBlock: {
                // #RGBA — expand each digit (ignore alpha)
                r1 = LY__HexDigit(str, 1)
                g1 = LY__HexDigit(str, 2)
                b1 = LY__HexDigit(str, 3)
                r = Add(Multiply(r1, 16), r1)
                g = Add(Multiply(g1, 16), g1)
                b = Add(Multiply(b1, 16), b1)
                bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
                ReturnValue(bgra)
            }
            // Unknown hex length — treat as transparent
            ReturnValue(0)
        }

        // Keywords that mean "no color"
        IfCondition EqualTo(StringCompare(str, "none"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(str, "initial"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(str, "inherit"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(str, "unset"), 0) ThenBlock: { ReturnValue(0) }
        // currentcolor — sentinel value 1, callers resolve to LYState.fg_color
        IfCondition EqualTo(StringCompare(str, "currentcolor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(str, "currentColor"), 0) ThenBlock: { ReturnValue(1) }

        // rgb() / rgba() functional notation
        IfCondition EqualTo(GetByte(str, 0), 114) ThenBlock: {
            IfCondition EqualTo(GetByte(str, 1), 103) ThenBlock: {
                IfCondition EqualTo(GetByte(str, 2), 98) ThenBlock: {
                    rgb_res = LY__ParseRGB(str)
                    ReturnValue(rgb_res)
                }
            }
        }
        IfCondition EqualTo(GetByte(str, 0), 118) ThenBlock: {
            // starts with 'v' — check var(
            IfCondition EqualTo(GetByte(str, 1), 97) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(GetByte(str, 0), 104) ThenBlock: {
            // starts with 'h' — check hsl( / hsla( / hwb(
            IfCondition EqualTo(GetByte(str, 1), 115) ThenBlock: {
                hsl_res = LY__ParseHSL(str)
                ReturnValue(hsl_res)
            }
            IfCondition EqualTo(GetByte(str, 1), 119) ThenBlock: {
                // hw -> hwb(
                IfCondition EqualTo(GetByte(str, 2), 98) ThenBlock: {
                    hwb_res = LY__ParseHWB(str)
                    ReturnValue(hwb_res)
                }
            }
        }

        // Named colors — BGRA format: B + G*256 + R*65536 + 0xFF*16777216
        IfCondition EqualTo(StringCompare(str, "black"), 0) ThenBlock: {
            ReturnValue(4278190080) // 0xFF000000
        }
        IfCondition EqualTo(StringCompare(str, "white"), 0) ThenBlock: {
            ReturnValue(4294967295) // 0xFFFFFFFF
        }
        IfCondition EqualTo(StringCompare(str, "red"), 0) ThenBlock: {
            ReturnValue(4294901760) // 0xFFFF0000 R=255,G=0,B=0
        }
        IfCondition EqualTo(StringCompare(str, "green"), 0) ThenBlock: {
            ReturnValue(4278222848) // 0xFF008000 R=0,G=128,B=0
        }
        IfCondition EqualTo(StringCompare(str, "blue"), 0) ThenBlock: {
            ReturnValue(4278190335) // 0xFF0000FF R=0,G=0,B=255
        }
        IfCondition EqualTo(StringCompare(str, "gray"), 0) ThenBlock: {
            ReturnValue(4286611584) // 0xFF808080
        }
        IfCondition EqualTo(StringCompare(str, "grey"), 0) ThenBlock: {
            ReturnValue(4286611584) // 0xFF808080
        }
        IfCondition EqualTo(StringCompare(str, "silver"), 0) ThenBlock: {
            ReturnValue(4290822336) // 0xFFC0C0C0
        }
        IfCondition EqualTo(StringCompare(str, "navy"), 0) ThenBlock: {
            ReturnValue(4278190208) // 0xFF000080 R=0,G=0,B=128
        }
        IfCondition EqualTo(StringCompare(str, "teal"), 0) ThenBlock: {
            ReturnValue(4278222976) // 0xFF008080 R=0,G=128,B=128
        }
        IfCondition EqualTo(StringCompare(str, "purple"), 0) ThenBlock: {
            ReturnValue(4286578816) // 0xFF800080 R=128,G=0,B=128
        }
        IfCondition EqualTo(StringCompare(str, "orange"), 0) ThenBlock: {
            ReturnValue(4294944000) // 0xFFFFA500 R=255,G=165,B=0
        }
        IfCondition EqualTo(StringCompare(str, "yellow"), 0) ThenBlock: {
            ReturnValue(4294967040) // 0xFFFFFF00 R=255,G=255,B=0
        }
        IfCondition EqualTo(StringCompare(str, "transparent"), 0) ThenBlock: {
            ReturnValue(0)
        }
        // Extended named colors (BGRA = B + G*256 + R*65536 + 0xFF*16777216)
        IfCondition EqualTo(StringCompare(str, "maroon"), 0) ThenBlock: { ReturnValue(4286578688) }
        IfCondition EqualTo(StringCompare(str, "olive"), 0) ThenBlock: { ReturnValue(4286611456) }
        IfCondition EqualTo(StringCompare(str, "lime"), 0) ThenBlock: { ReturnValue(4278255360) }
        IfCondition EqualTo(StringCompare(str, "aqua"), 0) ThenBlock: { ReturnValue(4278255615) }
        IfCondition EqualTo(StringCompare(str, "cyan"), 0) ThenBlock: { ReturnValue(4278255615) }
        IfCondition EqualTo(StringCompare(str, "fuchsia"), 0) ThenBlock: { ReturnValue(4294902015) }
        IfCondition EqualTo(StringCompare(str, "magenta"), 0) ThenBlock: { ReturnValue(4294902015) }
        IfCondition EqualTo(StringCompare(str, "pink"), 0) ThenBlock: { ReturnValue(4294951115) }
        IfCondition EqualTo(StringCompare(str, "brown"), 0) ThenBlock: { ReturnValue(4289014314) }
        IfCondition EqualTo(StringCompare(str, "coral"), 0) ThenBlock: { ReturnValue(4294934352) }
        IfCondition EqualTo(StringCompare(str, "gold"), 0) ThenBlock: { ReturnValue(4294956800) }
        IfCondition EqualTo(StringCompare(str, "khaki"), 0) ThenBlock: { ReturnValue(4293977740) }
        IfCondition EqualTo(StringCompare(str, "tomato"), 0) ThenBlock: { ReturnValue(4294927175) }
        IfCondition EqualTo(StringCompare(str, "tan"), 0) ThenBlock: { ReturnValue(4291998860) }
        IfCondition EqualTo(StringCompare(str, "wheat"), 0) ThenBlock: { ReturnValue(4294303411) }
        IfCondition EqualTo(StringCompare(str, "ivory"), 0) ThenBlock: { ReturnValue(4294967280) }
        IfCondition EqualTo(StringCompare(str, "beige"), 0) ThenBlock: { ReturnValue(4294309340) }
        IfCondition EqualTo(StringCompare(str, "linen"), 0) ThenBlock: { ReturnValue(4294635750) }
        IfCondition EqualTo(StringCompare(str, "salmon"), 0) ThenBlock: { ReturnValue(4294606962) }
        IfCondition EqualTo(StringCompare(str, "crimson"), 0) ThenBlock: { ReturnValue(4292613180) }
        IfCondition EqualTo(StringCompare(str, "indigo"), 0) ThenBlock: { ReturnValue(4283105410) }
        IfCondition EqualTo(StringCompare(str, "violet"), 0) ThenBlock: { ReturnValue(4293821166) }
        IfCondition EqualTo(StringCompare(str, "plum"), 0) ThenBlock: { ReturnValue(4292714717) }
        IfCondition EqualTo(StringCompare(str, "orchid"), 0) ThenBlock: { ReturnValue(4292505814) }
        IfCondition EqualTo(StringCompare(str, "chocolate"), 0) ThenBlock: { ReturnValue(4291979550) }
        IfCondition EqualTo(StringCompare(str, "sienna"), 0) ThenBlock: { ReturnValue(4288696877) }
        IfCondition EqualTo(StringCompare(str, "peru"), 0) ThenBlock: { ReturnValue(4291659071) }
        IfCondition EqualTo(StringCompare(str, "skyblue"), 0) ThenBlock: { ReturnValue(4287090411) }
        IfCondition EqualTo(StringCompare(str, "steelblue"), 0) ThenBlock: { ReturnValue(4282811060) }
        IfCondition EqualTo(StringCompare(str, "slategray"), 0) ThenBlock: { ReturnValue(4285563024) }
        IfCondition EqualTo(StringCompare(str, "darkgray"), 0) ThenBlock: { ReturnValue(4289309097) }
        IfCondition EqualTo(StringCompare(str, "darkgrey"), 0) ThenBlock: { ReturnValue(4289309097) }
        IfCondition EqualTo(StringCompare(str, "lightgray"), 0) ThenBlock: { ReturnValue(4292072403) }
        IfCondition EqualTo(StringCompare(str, "lightgrey"), 0) ThenBlock: { ReturnValue(4292072403) }
        IfCondition EqualTo(StringCompare(str, "dimgray"), 0) ThenBlock: { ReturnValue(4285098345) }
        IfCondition EqualTo(StringCompare(str, "whitesmoke"), 0) ThenBlock: { ReturnValue(4294309365) }
        IfCondition EqualTo(StringCompare(str, "gainsboro"), 0) ThenBlock: { ReturnValue(4292664540) }

        // Additional CSS named colors
        IfCondition EqualTo(StringCompare(str, "rebeccapurple"), 0) ThenBlock: { ReturnValue(4284887961) }
        IfCondition EqualTo(StringCompare(str, "orangered"), 0) ThenBlock: { ReturnValue(4294919424) }
        IfCondition EqualTo(StringCompare(str, "hotpink"), 0) ThenBlock: { ReturnValue(4290987578) }
        IfCondition EqualTo(StringCompare(str, "deeppink"), 0) ThenBlock: { ReturnValue(4293874390) }
        IfCondition EqualTo(StringCompare(str, "darkred"), 0) ThenBlock: { ReturnValue(4287299584) }
        IfCondition EqualTo(StringCompare(str, "darkgreen"), 0) ThenBlock: { ReturnValue(4278222848) }
        IfCondition EqualTo(StringCompare(str, "darkblue"), 0) ThenBlock: { ReturnValue(4278190219) }
        IfCondition EqualTo(StringCompare(str, "darkcyan"), 0) ThenBlock: { ReturnValue(4278222976) }
        IfCondition EqualTo(StringCompare(str, "darkmagenta"), 0) ThenBlock: { ReturnValue(4287299723) }
        IfCondition EqualTo(StringCompare(str, "darkorange"), 0) ThenBlock: { ReturnValue(4294937600) }
        IfCondition EqualTo(StringCompare(str, "darkviolet"), 0) ThenBlock: { ReturnValue(4292018324) }
        IfCondition EqualTo(StringCompare(str, "lightblue"), 0) ThenBlock: { ReturnValue(4293318829) }
        IfCondition EqualTo(StringCompare(str, "lightgreen"), 0) ThenBlock: { ReturnValue(4287688336) }
        IfCondition EqualTo(StringCompare(str, "lightyellow"), 0) ThenBlock: { ReturnValue(4294967264) }
        IfCondition EqualTo(StringCompare(str, "lightcoral"), 0) ThenBlock: { ReturnValue(4289999360) }
        IfCondition EqualTo(StringCompare(str, "lightcyan"), 0) ThenBlock: { ReturnValue(4292935679) }
        IfCondition EqualTo(StringCompare(str, "lightpink"), 0) ThenBlock: { ReturnValue(4294634455) }
        IfCondition EqualTo(StringCompare(str, "lightsalmon"), 0) ThenBlock: { ReturnValue(4294942842) }
        IfCondition EqualTo(StringCompare(str, "mediumblue"), 0) ThenBlock: { ReturnValue(4278190285) }
        IfCondition EqualTo(StringCompare(str, "greenyellow"), 0) ThenBlock: { ReturnValue(4281335725) }
        IfCondition EqualTo(StringCompare(str, "limegreen"), 0) ThenBlock: { ReturnValue(4281519410) }
        IfCondition EqualTo(StringCompare(str, "royalblue"), 0) ThenBlock: { ReturnValue(4292281093) }
        IfCondition EqualTo(StringCompare(str, "dodgerblue"), 0) ThenBlock: { ReturnValue(4294924574) }
        IfCondition EqualTo(StringCompare(str, "cornflowerblue"), 0) ThenBlock: { ReturnValue(4293760356) }

        // Remaining CSS4 named colors (full 148-color set)
        IfCondition EqualTo(StringCompare(str, "aliceblue"), 0) ThenBlock: { ReturnValue(4293982463) }
        IfCondition EqualTo(StringCompare(str, "antiquewhite"), 0) ThenBlock: { ReturnValue(4294634455) }
        IfCondition EqualTo(StringCompare(str, "aquamarine"), 0) ThenBlock: { ReturnValue(4286578644) }
        IfCondition EqualTo(StringCompare(str, "azure"), 0) ThenBlock: { ReturnValue(4293984255) }
        IfCondition EqualTo(StringCompare(str, "bisque"), 0) ThenBlock: { ReturnValue(4294960324) }
        IfCondition EqualTo(StringCompare(str, "blanchedalmond"), 0) ThenBlock: { ReturnValue(4294962125) }
        IfCondition EqualTo(StringCompare(str, "blueviolet"), 0) ThenBlock: { ReturnValue(4287245282) }
        IfCondition EqualTo(StringCompare(str, "burlywood"), 0) ThenBlock: { ReturnValue(4292786311) }
        IfCondition EqualTo(StringCompare(str, "cadetblue"), 0) ThenBlock: { ReturnValue(4284456608) }
        IfCondition EqualTo(StringCompare(str, "chartreuse"), 0) ThenBlock: { ReturnValue(4286578432) }
        IfCondition EqualTo(StringCompare(str, "cornsilk"), 0) ThenBlock: { ReturnValue(4294965468) }
        IfCondition EqualTo(StringCompare(str, "darkgoldenrod"), 0) ThenBlock: { ReturnValue(4290283019) }
        IfCondition EqualTo(StringCompare(str, "darkkhaki"), 0) ThenBlock: { ReturnValue(4290623339) }
        IfCondition EqualTo(StringCompare(str, "darkolivegreen"), 0) ThenBlock: { ReturnValue(4283788079) }
        IfCondition EqualTo(StringCompare(str, "darksalmon"), 0) ThenBlock: { ReturnValue(4293498490) }
        IfCondition EqualTo(StringCompare(str, "darkseagreen"), 0) ThenBlock: { ReturnValue(4287609999) }
        IfCondition EqualTo(StringCompare(str, "darkslateblue"), 0) ThenBlock: { ReturnValue(4282924427) }
        IfCondition EqualTo(StringCompare(str, "darkslategray"), 0) ThenBlock: { ReturnValue(4281290575) }
        IfCondition EqualTo(StringCompare(str, "darkslategrey"), 0) ThenBlock: { ReturnValue(4281290575) }
        IfCondition EqualTo(StringCompare(str, "darkturquoise"), 0) ThenBlock: { ReturnValue(4278243025) }
        IfCondition EqualTo(StringCompare(str, "deepskyblue"), 0) ThenBlock: { ReturnValue(4278239231) }
        IfCondition EqualTo(StringCompare(str, "firebrick"), 0) ThenBlock: { ReturnValue(4289864226) }
        IfCondition EqualTo(StringCompare(str, "floralwhite"), 0) ThenBlock: { ReturnValue(4294966000) }
        IfCondition EqualTo(StringCompare(str, "forestgreen"), 0) ThenBlock: { ReturnValue(4280453922) }
        IfCondition EqualTo(StringCompare(str, "ghostwhite"), 0) ThenBlock: { ReturnValue(4294506751) }
        IfCondition EqualTo(StringCompare(str, "goldenrod"), 0) ThenBlock: { ReturnValue(4292519200) }
        IfCondition EqualTo(StringCompare(str, "honeydew"), 0) ThenBlock: { ReturnValue(4293984240) }
        IfCondition EqualTo(StringCompare(str, "indianred"), 0) ThenBlock: { ReturnValue(4291648604) }
        IfCondition EqualTo(StringCompare(str, "lavender"), 0) ThenBlock: { ReturnValue(4293322490) }
        IfCondition EqualTo(StringCompare(str, "lavenderblush"), 0) ThenBlock: { ReturnValue(4294963445) }
        IfCondition EqualTo(StringCompare(str, "lawngreen"), 0) ThenBlock: { ReturnValue(4286381056) }
        IfCondition EqualTo(StringCompare(str, "lemonchiffon"), 0) ThenBlock: { ReturnValue(4294965965) }
        IfCondition EqualTo(StringCompare(str, "lightseagreen"), 0) ThenBlock: { ReturnValue(4280332970) }
        IfCondition EqualTo(StringCompare(str, "lightslategray"), 0) ThenBlock: { ReturnValue(4286023833) }
        IfCondition EqualTo(StringCompare(str, "lightslategrey"), 0) ThenBlock: { ReturnValue(4286023833) }
        IfCondition EqualTo(StringCompare(str, "lightsteelblue"), 0) ThenBlock: { ReturnValue(4289774814) }
        IfCondition EqualTo(StringCompare(str, "mediumaquamarine"), 0) ThenBlock: { ReturnValue(4284927402) }
        IfCondition EqualTo(StringCompare(str, "mediumorchid"), 0) ThenBlock: { ReturnValue(4290401747) }
        IfCondition EqualTo(StringCompare(str, "mediumpurple"), 0) ThenBlock: { ReturnValue(4287852763) }
        IfCondition EqualTo(StringCompare(str, "mediumseagreen"), 0) ThenBlock: { ReturnValue(4282168177) }
        IfCondition EqualTo(StringCompare(str, "mediumslateblue"), 0) ThenBlock: { ReturnValue(4286277870) }
        IfCondition EqualTo(StringCompare(str, "mediumspringgreen"), 0) ThenBlock: { ReturnValue(4278254234) }
        IfCondition EqualTo(StringCompare(str, "mediumturquoise"), 0) ThenBlock: { ReturnValue(4282962380) }
        IfCondition EqualTo(StringCompare(str, "mediumvioletred"), 0) ThenBlock: { ReturnValue(4291237253) }
        IfCondition EqualTo(StringCompare(str, "midnightblue"), 0) ThenBlock: { ReturnValue(4279834992) }
        IfCondition EqualTo(StringCompare(str, "mintcream"), 0) ThenBlock: { ReturnValue(4294311930) }
        IfCondition EqualTo(StringCompare(str, "mistyrose"), 0) ThenBlock: { ReturnValue(4294960353) }
        IfCondition EqualTo(StringCompare(str, "moccasin"), 0) ThenBlock: { ReturnValue(4294960309) }
        IfCondition EqualTo(StringCompare(str, "navajowhite"), 0) ThenBlock: { ReturnValue(4294958765) }
        IfCondition EqualTo(StringCompare(str, "oldlace"), 0) ThenBlock: { ReturnValue(4294833638) }
        IfCondition EqualTo(StringCompare(str, "olivedrab"), 0) ThenBlock: { ReturnValue(4285238819) }
        IfCondition EqualTo(StringCompare(str, "palegreen"), 0) ThenBlock: { ReturnValue(4288215960) }
        IfCondition EqualTo(StringCompare(str, "palegoldenrod"), 0) ThenBlock: { ReturnValue(4293847210) }
        IfCondition EqualTo(StringCompare(str, "paleturquoise"), 0) ThenBlock: { ReturnValue(4289720046) }
        IfCondition EqualTo(StringCompare(str, "palevioletred"), 0) ThenBlock: { ReturnValue(4292571283) }
        IfCondition EqualTo(StringCompare(str, "papayawhip"), 0) ThenBlock: { ReturnValue(4294963157) }
        IfCondition EqualTo(StringCompare(str, "peachpuff"), 0) ThenBlock: { ReturnValue(4294957753) }
        IfCondition EqualTo(StringCompare(str, "powderblue"), 0) ThenBlock: { ReturnValue(4289781990) }
        IfCondition EqualTo(StringCompare(str, "rosybrown"), 0) ThenBlock: { ReturnValue(4290547599) }
        IfCondition EqualTo(StringCompare(str, "saddlebrown"), 0) ThenBlock: { ReturnValue(4287317267) }
        IfCondition EqualTo(StringCompare(str, "sandybrown"), 0) ThenBlock: { ReturnValue(4294222944) }
        IfCondition EqualTo(StringCompare(str, "seagreen"), 0) ThenBlock: { ReturnValue(4281240407) }
        IfCondition EqualTo(StringCompare(str, "seashell"), 0) ThenBlock: { ReturnValue(4294964718) }
        IfCondition EqualTo(StringCompare(str, "slateblue"), 0) ThenBlock: { ReturnValue(4285160141) }
        IfCondition EqualTo(StringCompare(str, "slategrey"), 0) ThenBlock: { ReturnValue(4285563024) }
        IfCondition EqualTo(StringCompare(str, "snow"), 0) ThenBlock: { ReturnValue(4294966010) }
        IfCondition EqualTo(StringCompare(str, "springgreen"), 0) ThenBlock: { ReturnValue(4278255487) }
        IfCondition EqualTo(StringCompare(str, "thistle"), 0) ThenBlock: { ReturnValue(4292394968) }
        IfCondition EqualTo(StringCompare(str, "turquoise"), 0) ThenBlock: { ReturnValue(4282441936) }
        IfCondition EqualTo(StringCompare(str, "yellowgreen"), 0) ThenBlock: { ReturnValue(4288335154) }

        // CSS System Colors (mapped to sensible defaults)
        IfCondition EqualTo(StringCompare(str, "canvas"), 0) ThenBlock: { ReturnValue(4294967295) }
        IfCondition EqualTo(StringCompare(str, "canvastext"), 0) ThenBlock: { ReturnValue(4278190080) }
        IfCondition EqualTo(StringCompare(str, "linktext"), 0) ThenBlock: { ReturnValue(4278190335) }
        IfCondition EqualTo(StringCompare(str, "visitedtext"), 0) ThenBlock: { ReturnValue(4286578816) }
        IfCondition EqualTo(StringCompare(str, "activetext"), 0) ThenBlock: { ReturnValue(4294901760) }
        IfCondition EqualTo(StringCompare(str, "buttonface"), 0) ThenBlock: { ReturnValue(4293848050) }
        IfCondition EqualTo(StringCompare(str, "buttontext"), 0) ThenBlock: { ReturnValue(4278190080) }
        IfCondition EqualTo(StringCompare(str, "buttonborder"), 0) ThenBlock: { ReturnValue(4285953654) }
        IfCondition EqualTo(StringCompare(str, "field"), 0) ThenBlock: { ReturnValue(4294967295) }
        IfCondition EqualTo(StringCompare(str, "fieldtext"), 0) ThenBlock: { ReturnValue(4278190080) }
        IfCondition EqualTo(StringCompare(str, "highlight"), 0) ThenBlock: { ReturnValue(4281356794) }
        IfCondition EqualTo(StringCompare(str, "highlighttext"), 0) ThenBlock: { ReturnValue(4294967295) }
        IfCondition EqualTo(StringCompare(str, "mark"), 0) ThenBlock: { ReturnValue(4294967040) }
        IfCondition EqualTo(StringCompare(str, "marktext"), 0) ThenBlock: { ReturnValue(4278190080) }
        IfCondition EqualTo(StringCompare(str, "graytext"), 0) ThenBlock: { ReturnValue(4286611584) }

        // Unknown color — return transparent (don't paint what we can't parse)
        ReturnValue(0)
    }
}

// =============================================================================
// RGB / RGBA PARSER — parse rgb(R, G, B) and rgba(R, G, B, A)
// Also handles space-separated: rgb(R G B) and rgb(R G B / A)
// Returns BGRA color or 0 on failure
// =============================================================================
Function.LY__ParseRGB {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        // Find opening paren
        pi = 0
        p_found = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(p_found, 0)) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: {
                p_found = 1
            } ElseBlock: {
                pi = Add(pi, 1)
            }
        }
        IfCondition EqualTo(p_found, 0) ThenBlock: { ReturnValue(0) }
        pi = Add(pi, 1)  // skip '('

        // Parse up to 4 numbers (R, G, B, optional A)
        rgb_vals_0 = 0
        rgb_vals_1 = 0
        rgb_vals_2 = 0
        rgb_val_count = 0

        vc = 0
        WhileLoop And(LessThan(vc, 3), LessThan(pi, slen)) {
            // Skip whitespace, commas, and CSS comments
            sk_done = 0
            WhileLoop And(LessThan(pi, slen), EqualTo(sk_done, 0)) {
                sc = GetByte(str, pi)
                sc_skip = 0
                IfCondition EqualTo(sc, 32) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 44) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 9) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 10) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 13) ThenBlock: { sc_skip = 1 }
                // Skip CSS comments: /* ... */
                IfCondition EqualTo(sc, 47) ThenBlock: {
                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 42) ThenBlock: {
                            // Found /*, skip to */
                            pi = Add(pi, 2)
                            cm_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(cm_done, 0)) {
                                IfCondition EqualTo(GetByte(str, pi), 42) ThenBlock: {
                                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 47) ThenBlock: {
                                            pi = Add(pi, 2)
                                            cm_done = 1
                                        }
                                    }
                                }
                                IfCondition EqualTo(cm_done, 0) ThenBlock: {
                                    pi = Add(pi, 1)
                                }
                            }
                            sc_skip = 2  // already advanced, don't add 1
                        }
                    }
                }
                IfCondition EqualTo(sc_skip, 1) ThenBlock: {
                    pi = Add(pi, 1)
                }
                IfCondition EqualTo(sc_skip, 0) ThenBlock: {
                    sk_done = 1
                }
            }
            // Check for closing paren or slash
            IfCondition LessThan(pi, slen) ThenBlock: {
                ec = GetByte(str, pi)
                IfCondition EqualTo(ec, 41) ThenBlock: {
                    vc = 3  // done
                }
                IfCondition EqualTo(ec, 47) ThenBlock: {
                    vc = 3  // slash for alpha, skip
                }
            }
            // Parse number
            IfCondition LessThan(vc, 3) ThenBlock: {
                num = 0
                nd = 0
                num_done = 0
                WhileLoop And(LessThan(pi, slen), EqualTo(num_done, 0)) {
                    dc = GetByte(str, pi)
                    is_digit = 0
                    IfCondition And(GreaterEqual(dc, 48), LessEqual(dc, 57)) ThenBlock: {
                        is_digit = 1
                    }
                    IfCondition EqualTo(is_digit, 1) ThenBlock: {
                        num = Add(Multiply(num, 10), Subtract(dc, 48))
                        pi = Add(pi, 1)
                        nd = 1
                    } ElseBlock: {
                        // Skip decimal point and fractional part (e.g. 128.5)
                        IfCondition EqualTo(dc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            // Skip remaining digits after decimal
                            frac_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(frac_done, 0)) {
                                fc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(fc, 48), LessEqual(fc, 57)) ThenBlock: {
                                    pi = Add(pi, 1)
                                } ElseBlock: {
                                    frac_done = 1
                                }
                            }
                            num_done = 1
                        } ElseBlock: {
                            num_done = 1
                        }
                    }
                }
                // Check for % suffix
                IfCondition LessThan(pi, slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, pi), 37) ThenBlock: {
                        // Percentage: convert 0-100% to 0-255
                        num = Divide(Multiply(num, 255), 100)
                        pi = Add(pi, 1)
                    }
                }
                // Clamp 0-255
                IfCondition GreaterThan(num, 255) ThenBlock: { num = 255 }
                IfCondition LessThan(num, 0) ThenBlock: { num = 0 }
                // Store
                IfCondition EqualTo(vc, 0) ThenBlock: { rgb_vals_0 = num }
                IfCondition EqualTo(vc, 1) ThenBlock: { rgb_vals_1 = num }
                IfCondition EqualTo(vc, 2) ThenBlock: { rgb_vals_2 = num }
                vc = Add(vc, 1)
            }
        }

        // Parse optional alpha (4th value after comma or slash)
        rgb_alpha = 1000  // default: fully opaque (x1000)
        ra_sk = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(ra_sk, 0)) {
            rac = GetByte(str, pi)
            IfCondition EqualTo(rac, 32) ThenBlock: { pi = Add(pi, 1) }
            ElseBlock: {
                IfCondition EqualTo(rac, 44) ThenBlock: { pi = Add(pi, 1) }
                ElseBlock: {
                    IfCondition EqualTo(rac, 47) ThenBlock: { pi = Add(pi, 1) }
                    ElseBlock: {
                        IfCondition EqualTo(rac, 9) ThenBlock: { pi = Add(pi, 1) }
                        ElseBlock: { ra_sk = 1 }
                    }
                }
            }
        }
        IfCondition LessThan(pi, slen) ThenBlock: {
            rapc = GetByte(str, pi)
            IfCondition EqualTo(EqualTo(rapc, 41), 0) ThenBlock: {
                // Parse alpha as fixed-point x1000
                ra_int = 0
                ra_frac = 0
                ra_fmul = 100
                ra_done = 0
                WhileLoop And(LessThan(pi, slen), EqualTo(ra_done, 0)) {
                    radc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(radc, 48), LessEqual(radc, 57)) ThenBlock: {
                        ra_int = Add(Multiply(ra_int, 10), Subtract(radc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(radc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            raf_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(raf_done, 0)) {
                                rafc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(rafc, 48), LessEqual(rafc, 57)) ThenBlock: {
                                    IfCondition GreaterThan(ra_fmul, 0) ThenBlock: {
                                        ra_frac = Add(ra_frac, Multiply(Subtract(rafc, 48), ra_fmul))
                                        ra_fmul = Divide(ra_fmul, 10)
                                    }
                                    pi = Add(pi, 1)
                                } ElseBlock: { raf_done = 1 }
                            }
                        }
                        ra_done = 1
                    }
                }
                rgb_alpha = Add(Multiply(ra_int, 1000), ra_frac)
                IfCondition GreaterThan(rgb_alpha, 1000) ThenBlock: { rgb_alpha = 1000 }
                IfCondition LessThan(rgb_alpha, 0) ThenBlock: { rgb_alpha = 0 }
            }
        }

        // Apply alpha: blend against white background
        IfCondition LessThan(rgb_alpha, 1000) ThenBlock: {
            rgb_vals_0 = Divide(Add(Multiply(rgb_vals_0, rgb_alpha), Multiply(255, Subtract(1000, rgb_alpha))), 1000)
            rgb_vals_1 = Divide(Add(Multiply(rgb_vals_1, rgb_alpha), Multiply(255, Subtract(1000, rgb_alpha))), 1000)
            rgb_vals_2 = Divide(Add(Multiply(rgb_vals_2, rgb_alpha), Multiply(255, Subtract(1000, rgb_alpha))), 1000)
        }

        // Build BGRA: B + G*256 + R*65536 + 0xFF*16777216
        bgra = Add(rgb_vals_2, Add(Multiply(rgb_vals_1, 256), Add(Multiply(rgb_vals_0, 65536), 4278190080)))
        ReturnValue(bgra)
    }
}

// =============================================================================
// HSL / HSLA PARSER — parse hsl(H, S%, L%) and hsla(H, S%, L%, A)
// H = hue in degrees (0-360), S = saturation (0-100%), L = lightness (0-100%)
// Uses fixed-point arithmetic (multiply by 1000 for 3 decimal places)
// Returns BGRA color
// =============================================================================
Function.LY__HueToRGB {
    Input: p: Integer
    Input: q: Integer
    Input: t: Integer
    Output: Integer
    Body: {
        // All inputs scaled by 1000 (so 1.0 = 1000)
        // t is hue fraction * 1000
        ht = t
        IfCondition LessThan(ht, 0) ThenBlock: { ht = Add(ht, 1000) }
        IfCondition GreaterThan(ht, 1000) ThenBlock: { ht = Subtract(ht, 1000) }

        // if t < 1/6: p + (q-p) * 6 * t
        IfCondition LessThan(ht, 166) ThenBlock: {
            diff = Subtract(q, p)
            ReturnValue(Add(p, Divide(Multiply(Multiply(diff, 6), ht), 1000)))
        }
        // if t < 1/2: q
        IfCondition LessThan(ht, 500) ThenBlock: {
            ReturnValue(q)
        }
        // if t < 2/3: p + (q-p) * (2/3 - t) * 6
        IfCondition LessThan(ht, 666) ThenBlock: {
            diff = Subtract(q, p)
            ReturnValue(Add(p, Divide(Multiply(Multiply(diff, 6), Subtract(666, ht)), 1000)))
        }
        ReturnValue(p)
    }
}

Function.LY__ParseHSL {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        // Find opening paren
        pi = 0
        p_found = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(p_found, 0)) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: {
                p_found = 1
            } ElseBlock: {
                pi = Add(pi, 1)
            }
        }
        IfCondition EqualTo(p_found, 0) ThenBlock: { ReturnValue(0) }
        pi = Add(pi, 1)

        // Parse 3 numbers: H, S, L (reuse ParseRGB number parsing pattern)
        hsl_0 = 0
        hsl_1 = 0
        hsl_2 = 0
        vc = 0
        WhileLoop And(LessThan(vc, 3), LessThan(pi, slen)) {
            // Skip whitespace, commas, and CSS comments
            sk_done = 0
            WhileLoop And(LessThan(pi, slen), EqualTo(sk_done, 0)) {
                sc = GetByte(str, pi)
                sc_skip = 0
                IfCondition EqualTo(sc, 32) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 44) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 9) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 10) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 13) ThenBlock: { sc_skip = 1 }
                // Skip CSS comments: /* ... */
                IfCondition EqualTo(sc, 47) ThenBlock: {
                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 42) ThenBlock: {
                            pi = Add(pi, 2)
                            cm_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(cm_done, 0)) {
                                IfCondition EqualTo(GetByte(str, pi), 42) ThenBlock: {
                                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 47) ThenBlock: {
                                            pi = Add(pi, 2)
                                            cm_done = 1
                                        }
                                    }
                                }
                                IfCondition EqualTo(cm_done, 0) ThenBlock: {
                                    pi = Add(pi, 1)
                                }
                            }
                            sc_skip = 2  // already advanced past comment
                        }
                    }
                }
                IfCondition EqualTo(sc_skip, 1) ThenBlock: {
                    pi = Add(pi, 1)
                }
                IfCondition EqualTo(sc_skip, 0) ThenBlock: {
                    sk_done = 1
                }
            }
            // Check for closing paren or slash (alpha separator)
            IfCondition LessThan(pi, slen) ThenBlock: {
                ec = GetByte(str, pi)
                IfCondition EqualTo(ec, 41) ThenBlock: { vc = 3 }
                // Bare / is alpha separator; /* is comment (already handled above)
                IfCondition EqualTo(ec, 47) ThenBlock: {
                    is_cmt = 0
                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 42) ThenBlock: {
                            is_cmt = 1
                        }
                    }
                    IfCondition EqualTo(is_cmt, 0) ThenBlock: {
                        vc = 3  // alpha separator — stop
                    }
                }
            }
            // Parse number (integer + fractional x1000 for hue precision)
            IfCondition LessThan(vc, 3) ThenBlock: {
                num = 0
                num_frac = 0
                frac_div = 1
                is_neg = 0
                IfCondition LessThan(pi, slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, pi), 45) ThenBlock: {
                        is_neg = 1
                        pi = Add(pi, 1)
                    }
                }
                num_done = 0
                WhileLoop And(LessThan(pi, slen), EqualTo(num_done, 0)) {
                    dc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(dc, 48), LessEqual(dc, 57)) ThenBlock: {
                        num = Add(Multiply(num, 10), Subtract(dc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        // Parse decimal fraction into x1000 scale
                        IfCondition EqualTo(dc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            frac_mul = 100
                            frac_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(frac_done, 0)) {
                                fc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(fc, 48), LessEqual(fc, 57)) ThenBlock: {
                                    IfCondition GreaterThan(frac_mul, 0) ThenBlock: {
                                        num_frac = Add(num_frac, Multiply(Subtract(fc, 48), frac_mul))
                                        frac_mul = Divide(frac_mul, 10)
                                    }
                                    pi = Add(pi, 1)
                                } ElseBlock: {
                                    frac_done = 1
                                }
                            }
                        }
                        num_done = 1
                    }
                }
                // Handle scientific notation: e.g. 1.2e2 = 120
                // Check for 'e' or 'E' (101 or 69)
                IfCondition LessThan(pi, slen) ThenBlock: {
                    ec_ch = GetByte(str, pi)
                    IfCondition Or(EqualTo(ec_ch, 101), EqualTo(ec_ch, 69)) ThenBlock: {
                        pi = Add(pi, 1)
                        // Parse exponent sign and digits
                        exp_neg = 0
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            exp_s = GetByte(str, pi)
                            IfCondition EqualTo(exp_s, 43) ThenBlock: { pi = Add(pi, 1) }
                            IfCondition EqualTo(exp_s, 45) ThenBlock: {
                                exp_neg = 1
                                pi = Add(pi, 1)
                            }
                        }
                        exp_val = 0
                        exp_done = 0
                        WhileLoop And(LessThan(pi, slen), EqualTo(exp_done, 0)) {
                            exp_d = GetByte(str, pi)
                            IfCondition And(GreaterEqual(exp_d, 48), LessEqual(exp_d, 57)) ThenBlock: {
                                exp_val = Add(Multiply(exp_val, 10), Subtract(exp_d, 48))
                                pi = Add(pi, 1)
                            } ElseBlock: {
                                exp_done = 1
                            }
                        }
                        // Apply exponent: multiply or divide num and num_frac by 10^exp
                        IfCondition EqualTo(exp_neg, 0) ThenBlock: {
                            exp_i = 0
                            WhileLoop LessThan(exp_i, exp_val) {
                                num = Multiply(num, 10)
                                num_frac = Multiply(num_frac, 10)
                                // Carry from frac to int: frac >= 1000 → add to int
                                IfCondition GreaterEqual(num_frac, 1000) ThenBlock: {
                                    num = Add(num, Divide(num_frac, 1000))
                                    num_frac = Subtract(num_frac, Multiply(Divide(num_frac, 1000), 1000))
                                }
                                exp_i = Add(exp_i, 1)
                            }
                        } ElseBlock: {
                            // Negative exponent: divide
                            exp_i = 0
                            WhileLoop LessThan(exp_i, exp_val) {
                                num_frac = Add(num_frac, Multiply(Subtract(num, Multiply(Divide(num, 10), 10)), 100))
                                num = Divide(num, 10)
                                num_frac = Divide(num_frac, 10)
                                exp_i = Add(exp_i, 1)
                            }
                        }
                    }
                }
                // num_x1000 = integer * 1000 + fractional (always positive here)
                num_x1000 = Add(Multiply(num, 1000), num_frac)
                IfCondition EqualTo(is_neg, 1) ThenBlock: {
                    num = Subtract(0, num)
                    num_x1000 = Subtract(0, num_x1000)
                }
                // Handle angle unit suffix for hue (vc==0): deg, grad, rad, turn
                angle_unit = 0
                IfCondition LessThan(pi, slen) ThenBlock: {
                    sf = GetByte(str, pi)
                    IfCondition EqualTo(sf, 37) ThenBlock: { pi = Add(pi, 1) }
                    // 'd' for 'deg'
                    IfCondition EqualTo(sf, 100) ThenBlock: {
                        angle_unit = 1
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 101) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 103) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                    // 'g' for 'grad'
                    IfCondition EqualTo(sf, 103) ThenBlock: {
                        angle_unit = 2
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 114) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 97) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 100) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                    // 'r' for 'rad'
                    IfCondition EqualTo(sf, 114) ThenBlock: {
                        angle_unit = 3
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 97) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 100) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                    // 't' for 'turn'
                    IfCondition EqualTo(sf, 116) ThenBlock: {
                        angle_unit = 4
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 117) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 114) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 110) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                }
                // Convert angle units to degrees (only for hue = vc==0)
                IfCondition EqualTo(vc, 0) ThenBlock: {
                    // grad: degrees = value * 360 / 400 = value * 9 / 10
                    IfCondition EqualTo(angle_unit, 2) ThenBlock: {
                        num = Divide(Multiply(num_x1000, 9), 10000)
                    } ElseBlock: {
                        // rad: degrees = value * 180 / pi ≈ value * 5730 / 100000
                        // Using x1000 scale: num_x1000 * 5730 / 100000 = num_x1000 * 573 / 10000
                        IfCondition EqualTo(angle_unit, 3) ThenBlock: {
                            num = Divide(Multiply(num_x1000, 573), 10000)
                        } ElseBlock: {
                            // turn: degrees = value * 360
                            IfCondition EqualTo(angle_unit, 4) ThenBlock: {
                                num = Divide(Multiply(num_x1000, 360), 1000)
                            } ElseBlock: {
                                // deg or no unit: use integer part directly
                                num = Divide(num_x1000, 1000)
                            }
                        }
                    }
                }
                IfCondition EqualTo(vc, 0) ThenBlock: { hsl_0 = num }
                IfCondition EqualTo(vc, 1) ThenBlock: { hsl_1 = num }
                IfCondition EqualTo(vc, 2) ThenBlock: { hsl_2 = num }
                vc = Add(vc, 1)
            }
        }

        // Normalize: H to 0-360, S and L to 0-100
        hue = hsl_0
        WhileLoop LessThan(hue, 0) { hue = Add(hue, 360) }
        WhileLoop GreaterEqual(hue, 360) { hue = Subtract(hue, 360) }
        sat = hsl_1
        IfCondition LessThan(sat, 0) ThenBlock: { sat = 0 }
        IfCondition GreaterThan(sat, 100) ThenBlock: { sat = 100 }
        lit = hsl_2
        IfCondition LessThan(lit, 0) ThenBlock: { lit = 0 }
        IfCondition GreaterThan(lit, 100) ThenBlock: { lit = 100 }

        // Convert HSL to RGB using fixed-point (x1000)
        // s1000 = S/100 * 1000, l1000 = L/100 * 1000
        s1000 = Multiply(sat, 10)
        l1000 = Multiply(lit, 10)

        // If saturation is 0, it's a gray
        IfCondition EqualTo(s1000, 0) ThenBlock: {
            gray = Divide(Multiply(lit, 255), 100)
            bgra = Add(gray, Add(Multiply(gray, 256), Add(Multiply(gray, 65536), 4278190080)))
            ReturnValue(bgra)
        }

        // q = l < 0.5 ? l * (1+s) : l + s - l*s
        IfCondition LessThan(l1000, 500) ThenBlock: {
            q1000 = Divide(Multiply(l1000, Add(1000, s1000)), 1000)
        } ElseBlock: {
            q1000 = Subtract(Add(l1000, s1000), Divide(Multiply(l1000, s1000), 1000))
        }
        // p = 2*l - q
        p1000 = Subtract(Multiply(2, l1000), q1000)

        // h_frac = hue / 360 * 1000
        h_frac = Divide(Multiply(hue, 1000), 360)

        // R = hueToRGB(p, q, h + 1/3)
        r1000 = LY__HueToRGB(p1000, q1000, Add(h_frac, 333))
        // G = hueToRGB(p, q, h)
        g1000 = LY__HueToRGB(p1000, q1000, h_frac)
        // B = hueToRGB(p, q, h - 1/3)
        b1000 = LY__HueToRGB(p1000, q1000, Subtract(h_frac, 333))

        // Convert to 0-255
        r = Divide(Multiply(r1000, 255), 1000)
        g = Divide(Multiply(g1000, 255), 1000)
        b = Divide(Multiply(b1000, 255), 1000)
        IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }

        // Parse optional alpha (4th value after comma or slash)
        alpha_1000 = 1000  // default: fully opaque
        // After vc=3, pi should be past the 3rd number; skip whitespace/comma/slash
        a_sk = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(a_sk, 0)) {
            ac = GetByte(str, pi)
            IfCondition EqualTo(ac, 32) ThenBlock: { pi = Add(pi, 1) }
            ElseBlock: {
                IfCondition EqualTo(ac, 44) ThenBlock: { pi = Add(pi, 1) }
                ElseBlock: {
                    IfCondition EqualTo(ac, 47) ThenBlock: { pi = Add(pi, 1) }
                    ElseBlock: {
                        IfCondition EqualTo(ac, 9) ThenBlock: { pi = Add(pi, 1) }
                        ElseBlock: {
                            IfCondition EqualTo(ac, 10) ThenBlock: { pi = Add(pi, 1) }
                            ElseBlock: { a_sk = 1 }
                        }
                    }
                }
            }
        }
        // Parse alpha number if present (not a closing paren)
        IfCondition LessThan(pi, slen) ThenBlock: {
            apc = GetByte(str, pi)
            IfCondition EqualTo(EqualTo(apc, 41), 0) ThenBlock: {
                // Parse alpha as fixed-point x1000
                a_int = 0
                a_frac = 0
                a_frac_mul = 100
                a_done = 0
                // Skip leading whitespace
                WhileLoop And(LessThan(pi, slen), EqualTo(a_done, 0)) {
                    adc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(adc, 48), LessEqual(adc, 57)) ThenBlock: {
                        a_int = Add(Multiply(a_int, 10), Subtract(adc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(adc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            af_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(af_done, 0)) {
                                afc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(afc, 48), LessEqual(afc, 57)) ThenBlock: {
                                    IfCondition GreaterThan(a_frac_mul, 0) ThenBlock: {
                                        a_frac = Add(a_frac, Multiply(Subtract(afc, 48), a_frac_mul))
                                        a_frac_mul = Divide(a_frac_mul, 10)
                                    }
                                    pi = Add(pi, 1)
                                } ElseBlock: { af_done = 1 }
                            }
                        }
                        a_done = 1
                    }
                }
                // alpha_1000 = integer_part * 1000 + frac_part
                // For 0.2 -> a_int=0, a_frac=200 -> alpha_1000=200
                // For 1.0 -> a_int=1, a_frac=0 -> alpha_1000=1000
                alpha_1000 = Add(Multiply(a_int, 1000), a_frac)
                IfCondition GreaterThan(alpha_1000, 1000) ThenBlock: { alpha_1000 = 1000 }
                IfCondition LessThan(alpha_1000, 0) ThenBlock: { alpha_1000 = 0 }
            }
        }

        // Apply alpha: blend against white background
        // result = color * alpha + 255 * (1 - alpha)
        IfCondition LessThan(alpha_1000, 1000) ThenBlock: {
            r = Divide(Add(Multiply(r, alpha_1000), Multiply(255, Subtract(1000, alpha_1000))), 1000)
            g = Divide(Add(Multiply(g, alpha_1000), Multiply(255, Subtract(1000, alpha_1000))), 1000)
            b = Divide(Add(Multiply(b, alpha_1000), Multiply(255, Subtract(1000, alpha_1000))), 1000)
        }

        bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
        ReturnValue(bgra)
    }
}

// =============================================================================
// HWB PARSER — parse hwb(H, W%, B%) and hwb(H W% B% / A)
// H = hue in degrees (0-360), W = whiteness (0-100%), B = blackness (0-100%)
// Conversion: mix hsl(H, 100%, 50%) with white (W) and black (B)
// Returns BGRA color
// =============================================================================
Function.LY__ParseHWB {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        // Find opening paren
        pi = 0
        p_found = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(p_found, 0)) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: {
                p_found = 1
            } ElseBlock: {
                pi = Add(pi, 1)
            }
        }
        IfCondition EqualTo(p_found, 0) ThenBlock: { ReturnValue(0) }
        pi = Add(pi, 1)

        // Parse 3 numbers: H, W, B
        hwb_0 = 0
        hwb_1 = 0
        hwb_2 = 0
        vc = 0
        WhileLoop And(LessThan(vc, 3), LessThan(pi, slen)) {
            // Skip whitespace, commas
            sk_done = 0
            WhileLoop And(LessThan(pi, slen), EqualTo(sk_done, 0)) {
                sc = GetByte(str, pi)
                sc_skip = 0
                IfCondition EqualTo(sc, 32) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 44) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 9) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 10) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 13) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc_skip, 1) ThenBlock: {
                    pi = Add(pi, 1)
                }
                IfCondition EqualTo(sc_skip, 0) ThenBlock: {
                    sk_done = 1
                }
            }
            // Check for closing paren or slash (alpha separator)
            IfCondition LessThan(pi, slen) ThenBlock: {
                ec = GetByte(str, pi)
                IfCondition EqualTo(ec, 41) ThenBlock: { vc = 3 }
                IfCondition EqualTo(ec, 47) ThenBlock: { vc = 3 }
            }
            // Parse number
            IfCondition LessThan(vc, 3) ThenBlock: {
                num = 0
                is_neg = 0
                IfCondition LessThan(pi, slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, pi), 45) ThenBlock: {
                        is_neg = 1
                        pi = Add(pi, 1)
                    }
                }
                num_done = 0
                WhileLoop And(LessThan(pi, slen), EqualTo(num_done, 0)) {
                    dc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(dc, 48), LessEqual(dc, 57)) ThenBlock: {
                        num = Add(Multiply(num, 10), Subtract(dc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(dc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            frac_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(frac_done, 0)) {
                                fc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(fc, 48), LessEqual(fc, 57)) ThenBlock: {
                                    pi = Add(pi, 1)
                                } ElseBlock: {
                                    frac_done = 1
                                }
                            }
                        }
                        num_done = 1
                    }
                }
                IfCondition EqualTo(is_neg, 1) ThenBlock: { num = Subtract(0, num) }
                // Skip % or 'deg' suffix
                IfCondition LessThan(pi, slen) ThenBlock: {
                    sf = GetByte(str, pi)
                    IfCondition EqualTo(sf, 37) ThenBlock: { pi = Add(pi, 1) }
                    IfCondition EqualTo(sf, 100) ThenBlock: {
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 101) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 103) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                }
                IfCondition EqualTo(vc, 0) ThenBlock: { hwb_0 = num }
                IfCondition EqualTo(vc, 1) ThenBlock: { hwb_1 = num }
                IfCondition EqualTo(vc, 2) ThenBlock: { hwb_2 = num }
                vc = Add(vc, 1)
            }
        }

        // Normalize: H to 0-360, W and B to 0-100
        hue = hwb_0
        WhileLoop LessThan(hue, 0) { hue = Add(hue, 360) }
        WhileLoop GreaterEqual(hue, 360) { hue = Subtract(hue, 360) }
        wt = hwb_1
        IfCondition LessThan(wt, 0) ThenBlock: { wt = 0 }
        IfCondition GreaterThan(wt, 100) ThenBlock: { wt = 100 }
        bk = hwb_2
        IfCondition LessThan(bk, 0) ThenBlock: { bk = 0 }
        IfCondition GreaterThan(bk, 100) ThenBlock: { bk = 100 }

        // If whiteness + blackness >= 100, result is gray
        wb_sum = Add(wt, bk)
        IfCondition GreaterEqual(wb_sum, 100) ThenBlock: {
            // gray = whiteness / (whiteness + blackness) * 255
            gray = Divide(Multiply(wt, 255), wb_sum)
            bgra = Add(gray, Add(Multiply(gray, 256), Add(Multiply(gray, 65536), 4278190080)))
            ReturnValue(bgra)
        }

        // Get pure hue color via HSL (S=100%, L=50%) using HueToRGB
        h_frac = Divide(Multiply(hue, 1000), 360)
        // For S=100%, L=50%: p=0, q=1000
        r1000 = LY__HueToRGB(0, 1000, Add(h_frac, 333))
        g1000 = LY__HueToRGB(0, 1000, h_frac)
        b1000 = LY__HueToRGB(0, 1000, Subtract(h_frac, 333))

        // Mix with white and black: color = color * (1 - W - B) + W
        // Using x1000 scale: factor = 1000 - W*10 - B*10
        factor = Subtract(1000, Add(Multiply(wt, 10), Multiply(bk, 10)))
        w1000 = Multiply(wt, 10)

        r_final = Divide(Add(Multiply(r1000, factor), Multiply(w1000, 1000)), 1000)
        g_final = Divide(Add(Multiply(g1000, factor), Multiply(w1000, 1000)), 1000)
        b_final = Divide(Add(Multiply(b1000, factor), Multiply(w1000, 1000)), 1000)

        r = Divide(Multiply(r_final, 255), 1000)
        g = Divide(Multiply(g_final, 255), 1000)
        b = Divide(Multiply(b_final, 255), 1000)
        IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }

        bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
        ReturnValue(bgra)
    }
}

Function.LY__HexDigit {
    Input: str: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        c = GetByte(str, pos)
        // 0-9
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
            ReturnValue(Subtract(c, 48))
        }
        // a-f
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 102)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 97), 10))
        }
        // A-F
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 70)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 65), 10))
        }
        ReturnValue(0)
    }
}

Function.LY__HexPair {
    Input: str: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        hi = LY__HexDigit(str, pos)
        lo = LY__HexDigit(str, Add(pos, 1))
        ReturnValue(Add(Multiply(hi, 16), lo))
    }
}

// =============================================================================
// CSS VALUE PARSING — parse pixel/em values
// =============================================================================
Function.LY__ParsePx {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(str)
        IfCondition EqualTo(slen, 0) ThenBlock: { ReturnValue(0) }

        // Parse leading digits
        val = 0
        pi = 0
        WhileLoop LessThan(pi, slen) {
            pc = GetByte(str, pi)
            IfCondition And(GreaterEqual(pc, 48), LessEqual(pc, 57)) ThenBlock: {
                val = Add(Multiply(val, 10), Subtract(pc, 48))
            }
            // Stop at non-digit (px, em, %, etc.)
            IfCondition LessThan(pc, 48) ThenBlock: { BreakLoop }
            IfCondition GreaterThan(pc, 57) ThenBlock: { BreakLoop }
            pi = Add(pi, 1)
        }

        // Check for unit suffix
        IfCondition LessThan(pi, slen) ThenBlock: {
            su = GetByte(str, pi)
            IfCondition EqualTo(su, 101) ThenBlock: {
                // 'e' for em — multiply by 16
                val = Multiply(val, 16)
            }
            // 'v' for vw/vh — viewport-relative units
            IfCondition EqualTo(su, 118) ThenBlock: {
                su2 = 0
                IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                    su2 = GetByte(str, Add(pi, 1))
                }
                IfCondition EqualTo(su2, 119) ThenBlock: {
                    // vw: 1vw = 1% of viewport width
                    val = Divide(Multiply(val, LYState.viewport_w), 100)
                }
                IfCondition EqualTo(su2, 104) ThenBlock: {
                    // vh: 1vh = 1% of viewport height
                    val = Divide(Multiply(val, LYState.viewport_h), 100)
                }
            }
            // '%' for percentage — relative to avail_w
            IfCondition EqualTo(su, 37) ThenBlock: {
                val = Divide(Multiply(val, LYState.avail_w), 100)
            }
        }

        ReturnValue(val)
    }
}

// =============================================================================
// VIEWPORT SETUP
// =============================================================================
Function.Layout_SetViewport {
    Input: w: Integer
    Input: h: Integer
    Body: {
        LYState.viewport_w = w
        LYState.viewport_h = h
        LYState.avail_w = w
    }
}

// =============================================================================
// TEXT WORD-WRAP + EMIT
// Wraps text to fit within current avail_w, emits CMD_DRAW_TEXT per line
// =============================================================================
Function.LY__EmitText {
    Input: text: Address
    Input: text_len: Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(text_len, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }

        font_w = LYState.font_w_px
        font_h = LY__LineHeight()

        // Available width from current X position to right edge
        right_edge = Add(LYState.indent, LYState.avail_w)

        si = 0
        WhileLoop LessThan(si, text_len) {
            // Skip leading whitespace at start of line (after wrap)
            IfCondition EqualTo(LYState.cursor_x, LYState.indent) ThenBlock: {
                ws_done = 0
                WhileLoop And(LessThan(si, text_len), EqualTo(ws_done, 0)) {
                    lsc = GetByte(text, si)
                    lsc_is_ws = 0
                    IfCondition EqualTo(lsc, 32) ThenBlock: { lsc_is_ws = 1 }
                    IfCondition EqualTo(lsc, 9) ThenBlock: { lsc_is_ws = 1 }
                    IfCondition EqualTo(lsc, 10) ThenBlock: { lsc_is_ws = 1 }
                    IfCondition EqualTo(lsc, 13) ThenBlock: { lsc_is_ws = 1 }
                    IfCondition EqualTo(lsc_is_ws, 1) ThenBlock: {
                        si = Add(si, 1)
                    } ElseBlock: {
                        ws_done = 1
                    }
                }
            }
            IfCondition GreaterEqual(si, text_len) ThenBlock: { ReturnValue(0) }

            // Find next word boundary (space or newline)
            wi = si
            word_end = text_len
            wb_done = 0
            WhileLoop And(LessThan(wi, text_len), EqualTo(wb_done, 0)) {
                wch = GetByte(text, wi)
                wch_is_sep = 0
                IfCondition EqualTo(wch, 32) ThenBlock: { wch_is_sep = 1 }
                IfCondition EqualTo(wch, 10) ThenBlock: { wch_is_sep = 1 }
                IfCondition EqualTo(wch, 13) ThenBlock: { wch_is_sep = 1 }
                IfCondition EqualTo(wch, 9) ThenBlock: { wch_is_sep = 1 }
                IfCondition EqualTo(wch_is_sep, 1) ThenBlock: {
                    word_end = wi
                    wb_done = 1
                } ElseBlock: {
                    wi = Add(wi, 1)
                }
            }

            word_len = Subtract(word_end, si)
            word_px = Multiply(word_len, font_w)

            // If word doesn't fit on current line and we're not at line start, wrap
            IfCondition GreaterThan(Add(LYState.cursor_x, word_px), right_edge) ThenBlock: {
                IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
                    // Wrap to next line
                    LYState.cursor_y = Add(LYState.cursor_y, font_h)
                    LYState.cursor_x = LYState.indent
                }
            }

            // If word is too long for a full line, break it character by character
            IfCondition GreaterThan(word_px, LYState.avail_w) ThenBlock: {
                ci = si
                WhileLoop LessThan(ci, word_end) {
                    // How many chars fit on this line?
                    remain_px = Subtract(right_edge, LYState.cursor_x)
                    fit_chars = Divide(remain_px, font_w)
                    IfCondition LessThan(fit_chars, 1) ThenBlock: {
                        // Wrap first
                        LYState.cursor_y = Add(LYState.cursor_y, font_h)
                        LYState.cursor_x = LYState.indent
                        remain_px = LYState.avail_w
                        fit_chars = Divide(remain_px, font_w)
                        IfCondition LessThan(fit_chars, 1) ThenBlock: { fit_chars = 1 }
                    }
                    chunk = Subtract(word_end, ci)
                    IfCondition GreaterThan(chunk, fit_chars) ThenBlock: {
                        chunk = fit_chars
                    }
                    LYTmp.ptr = Add(text, ci)
                    LY__EmitDrawText(LYState.cursor_x, LYState.cursor_y, chunk, color)
                    LYState.cursor_x = Add(LYState.cursor_x, Multiply(chunk, font_w))
                    ci = Add(ci, chunk)
                }
            } ElseBlock: {
                // Emit word at current position
                IfCondition GreaterThan(word_len, 0) ThenBlock: {
                    LYTmp.ptr = Add(text, si)
                    // Calculate X position based on text-align (only for first word on line)
                    emit_x = LYState.cursor_x
                    LY__EmitDrawText(emit_x, LYState.cursor_y, word_len, color)
                    LYState.cursor_x = Add(LYState.cursor_x, word_px)
                }
            }

            // Advance past the word
            si = word_end
            // Handle the delimiter (space, newline, etc.)
            IfCondition LessThan(si, text_len) ThenBlock: {
                dch = GetByte(text, si)
                IfCondition EqualTo(dch, 10) ThenBlock: {
                    // Newline — move to next line
                    LYState.cursor_y = Add(LYState.cursor_y, font_h)
                    LYState.cursor_x = LYState.indent
                    si = Add(si, 1)
                } ElseBlock: {
                    IfCondition Or(EqualTo(dch, 32), EqualTo(dch, 9)) ThenBlock: {
                        // Space — add space width to cursor_x
                        LYState.cursor_x = Add(LYState.cursor_x, font_w)
                        si = Add(si, 1)
                        // If space pushed us past right edge, wrap
                        IfCondition GreaterEqual(LYState.cursor_x, right_edge) ThenBlock: {
                            LYState.cursor_y = Add(LYState.cursor_y, font_h)
                            LYState.cursor_x = LYState.indent
                        }
                    }
                }
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// CSS RULE MATCHING — check class list for substring match
// Handles space-separated class attributes: "foo bar baz"
// =============================================================================
Function.LY__ClassContains {
    Input: class_attr: Address
    Input: target: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(class_attr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }

        LYCss.clen = StringLength(class_attr)
        LYCss.nlen = StringLength(target)
        IfCondition EqualTo(LYCss.clen, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LYCss.nlen, 0) ThenBlock: { ReturnValue(0) }

        // Exact match (single class)
        IfCondition EqualTo(StringCompare(class_attr, target), 0) ThenBlock: {
            ReturnValue(1)
        }

        // Walk space-separated words
        LYCss.ci = 0
        WhileLoop LessEqual(LYCss.ci, LYCss.clen) {
            // Skip spaces
            WhileLoop LessThan(LYCss.ci, LYCss.clen) {
                IfCondition EqualTo(GetByte(class_attr, LYCss.ci), 32) ThenBlock: {
                    LYCss.ci = Add(LYCss.ci, 1)
                } ElseBlock: {
                    BreakLoop
                }
            }
            IfCondition GreaterEqual(LYCss.ci, LYCss.clen) ThenBlock: { ReturnValue(0) }

            // Start of word
            LYCss.wstart = LYCss.ci
            // Find end of word
            WhileLoop LessThan(LYCss.ci, LYCss.clen) {
                IfCondition NotEqual(GetByte(class_attr, LYCss.ci), 32) ThenBlock: {
                    LYCss.ci = Add(LYCss.ci, 1)
                } ElseBlock: {
                    BreakLoop
                }
            }
            // Compare word length and content
            wlen = Subtract(LYCss.ci, LYCss.wstart)
            IfCondition EqualTo(wlen, LYCss.nlen) ThenBlock: {
                wmatch = 1
                wi = 0
                WhileLoop LessThan(wi, wlen) {
                    c1 = GetByte(class_attr, Add(LYCss.wstart, wi))
                    c2 = GetByte(target, wi)
                    IfCondition NotEqual(c1, c2) ThenBlock: {
                        wmatch = 0
                        wi = wlen
                    }
                    wi = Add(wi, 1)
                }
                IfCondition EqualTo(wmatch, 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// COMBINATOR MATCHING — check if context selector matches a candidate node
// Returns 1 if sel_type+sel_ptr matches the candidate node's tag/class/id
// =============================================================================
Function.LY__NodeMatchesSel {
    Input: cand: Integer
    Input: sel_type: Integer
    Input: sel_ptr: Address
    Output: Integer
    Body: {
        IfCondition LessEqual(cand, 0) ThenBlock: { ReturnValue(0) }

        // Universal matches everything
        IfCondition EqualTo(sel_type, CSSSelType.UNIVERSAL) ThenBlock: { ReturnValue(1) }

        // TAG match
        IfCondition EqualTo(sel_type, CSSSelType.TAG) ThenBlock: {
            cand_tag = DOM_GetTag(cand)
            IfCondition EqualTo(cand_tag, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(StringCompare(sel_ptr, cand_tag), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }

        // CLASS match
        IfCondition EqualTo(sel_type, CSSSelType.CLASS) ThenBlock: {
            cand_cls = DOM_GetAttr(cand, "class")
            IfCondition EqualTo(cand_cls, 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(LY__ClassContains(cand_cls, sel_ptr))
        }

        // ID match
        IfCondition EqualTo(sel_type, CSSSelType.ID) ThenBlock: {
            cand_id = DOM_GetAttr(cand, "id")
            IfCondition EqualTo(cand_id, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(StringCompare(sel_ptr, cand_id), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// CHECK COMBINATOR — verify that a rule's combinator context matches
// node = the subject element that matched R_SEL_*
// rule = the rule index (has R_CMB_TYPE, R_CMB_SEL_TYPE, R_CMB_SEL_PTR)
// Returns 1 if combinator context satisfied, 0 otherwise
// =============================================================================
Function.LY__CheckCombinator {
    Input: node: Integer
    Input: rule: Integer
    Output: Integer
    Body: {
        cmb_type = CSS_RuleCmbType(rule)
        IfCondition EqualTo(cmb_type, CSSCmb.NONE) ThenBlock: { ReturnValue(1) }

        cmb_sel_type = CSS_RuleCmbSelType(rule)
        cmb_sel_ptr = CSS_RuleCmbSelPtr(rule)

        // CHILD combinator (>): parent must match
        IfCondition EqualTo(cmb_type, CSSCmb.CHILD) ThenBlock: {
            par = DOM_GetParent(node)
            ReturnValue(LY__NodeMatchesSel(par, cmb_sel_type, cmb_sel_ptr))
        }

        // DESCENDANT combinator (space): any ancestor must match
        IfCondition EqualTo(cmb_type, CSSCmb.DESC) ThenBlock: {
            LYCss.cmb_node = DOM_GetParent(node)
            LYCss.cmb_depth = 0
            WhileLoop And(GreaterThan(LYCss.cmb_node, 0), LessThan(LYCss.cmb_depth, 32)) {
                IfCondition EqualTo(LY__NodeMatchesSel(LYCss.cmb_node, cmb_sel_type, cmb_sel_ptr), 1) ThenBlock: {
                    ReturnValue(1)
                }
                LYCss.cmb_node = DOM_GetParent(LYCss.cmb_node)
                LYCss.cmb_depth = Add(LYCss.cmb_depth, 1)
            }
            ReturnValue(0)
        }

        // ADJACENT SIBLING (+): previous sibling must match
        IfCondition EqualTo(cmb_type, CSSCmb.ADJ) ThenBlock: {
            prev = DOM_GetPrevSib(node)
            ReturnValue(LY__NodeMatchesSel(prev, cmb_sel_type, cmb_sel_ptr))
        }

        // GENERAL SIBLING (~): any earlier sibling must match
        IfCondition EqualTo(cmb_type, CSSCmb.GEN) ThenBlock: {
            LYCss.cmb_node = DOM_GetPrevSib(node)
            LYCss.cmb_depth = 0
            WhileLoop And(GreaterThan(LYCss.cmb_node, 0), LessThan(LYCss.cmb_depth, 64)) {
                IfCondition EqualTo(LY__NodeMatchesSel(LYCss.cmb_node, cmb_sel_type, cmb_sel_ptr), 1) ThenBlock: {
                    ReturnValue(1)
                }
                LYCss.cmb_node = DOM_GetPrevSib(LYCss.cmb_node)
                LYCss.cmb_depth = Add(LYCss.cmb_depth, 1)
            }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// CSS RULE LOOKUP — find property value for a DOM node from stylesheet rules
// Iterates all parsed CSS rules, returns value pointer or 0
// =============================================================================
Function.LY__CSSLookupProp {
    Input: node: Integer
    Input: prop: Address
    Output: Address
    Body: {
        LYCss.rcount = CSS_RuleCount()
        IfCondition EqualTo(LYCss.rcount, 0) ThenBlock: { ReturnValue(0) }

        LYCss.tag = DOM_GetTag(node)
        LYCss.cls = DOM_GetAttr(node, "class")
        LYCss.id = DOM_GetAttr(node, "id")

        LYCss.result = 0
        LYCss.best = -1

        LYCss.ri = 0
        WhileLoop LessThan(LYCss.ri, LYCss.rcount) {
            LYCss.matched = 0

            // Check tag match
            IfCondition EqualTo(CSS_MatchesTag(LYCss.ri, LYCss.tag), 1) ThenBlock: {
                LYCss.matched = 1
            }

            // Check class match (with space-separated support)
            IfCondition EqualTo(LYCss.matched, 0) ThenBlock: {
                IfCondition NotEqual(LYCss.cls, 0) ThenBlock: {
                    sel_type = CSS_RuleSelType(LYCss.ri)
                    IfCondition EqualTo(sel_type, CSSSelType.CLASS) ThenBlock: {
                        sel_ptr = CSS_RuleSelPtr(LYCss.ri)
                        IfCondition NotEqual(sel_ptr, 0) ThenBlock: {
                            IfCondition EqualTo(LY__ClassContains(LYCss.cls, sel_ptr), 1) ThenBlock: {
                                LYCss.matched = 1
                            }
                        }
                    }
                }
            }

            // Check id match
            IfCondition EqualTo(LYCss.matched, 0) ThenBlock: {
                IfCondition EqualTo(CSS_MatchesId(LYCss.ri, LYCss.id), 1) ThenBlock: {
                    LYCss.matched = 1
                }
            }

            // If subject matched, verify combinator context
            IfCondition EqualTo(LYCss.matched, 1) ThenBlock: {
                IfCondition EqualTo(LY__CheckCombinator(node, LYCss.ri), 0) ThenBlock: {
                    LYCss.matched = 0
                }
            }

            // If fully matched, look up the property — highest specificity wins
            IfCondition EqualTo(LYCss.matched, 1) ThenBlock: {
                LYCss.val = CSS_GetPropVal(LYCss.ri, prop)
                IfCondition NotEqual(LYCss.val, 0) ThenBlock: {
                    LYCss.spec = CSS_RuleSpecificity(LYCss.ri)
                    // Higher or equal specificity wins (equal = source order)
                    IfCondition GreaterEqual(LYCss.spec, LYCss.best) ThenBlock: {
                        LYCss.best = LYCss.spec
                        LYCss.result = LYCss.val
                    }
                }
            }

            LYCss.ri = Add(LYCss.ri, 1)
        }

        ReturnValue(LYCss.result)
    }
}

// =============================================================================
// STYLE RESOLUTION — get CSS properties for a DOM node
// Uses tag-based defaults + inline style + CSS rule matching
// =============================================================================
Function.LY__ResolveBgColor {
    Input: node: Integer
    Output: Integer
    Body: {
        // Check inline style (highest priority)
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            bg_idx = StringIndexOf(style_str, "background")
            IfCondition GreaterEqual(bg_idx, 0) ThenBlock: {
                slen = StringLength(style_str)
                rule = CSS_ParseInline(style_str, slen)
                IfCondition GreaterEqual(rule, 0) ThenBlock: {
                    bgv = CSS_GetPropVal(rule, "background-color")
                    IfCondition NotEqual(bgv, 0) ThenBlock: {
                        bgv_c = LY__ParseColor(bgv)
                        IfCondition EqualTo(bgv_c, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
                        ReturnValue(bgv_c)
                    }
                    bgv2 = CSS_GetPropVal(rule, "background")
                    IfCondition NotEqual(bgv2, 0) ThenBlock: {
                        bgv2_c = LY__ParseColor(bgv2)
                        IfCondition EqualTo(bgv2_c, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
                        ReturnValue(bgv2_c)
                    }
                }
            }
        }

        // Check CSS stylesheet rules
        css_bg = LY__CSSLookupProp(node, "background-color")
        IfCondition NotEqual(css_bg, 0) ThenBlock: {
            bg_parsed = LY__ParseColor(css_bg)
            IfCondition EqualTo(bg_parsed, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
            ReturnValue(bg_parsed)
        }
        css_bg2 = LY__CSSLookupProp(node, "background")
        IfCondition NotEqual(css_bg2, 0) ThenBlock: {
            bg_parsed2 = LY__ParseColor(css_bg2)
            IfCondition EqualTo(bg_parsed2, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
            ReturnValue(bg_parsed2)
        }

        ReturnValue(LYConst.COLOR_TRANSP)
    }
}

Function.LY__ResolveFgColor {
    Input: node: Integer
    Output: Integer
    Body: {
        tag = DOM_GetTag(node)

        // Links are blue
        IfCondition NotEqual(tag, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(tag, "a"), 0) ThenBlock: {
                ReturnValue(LYConst.COLOR_LINK)
            }
        }

        // Check inline style for color (highest priority)
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            col_idx = StringIndexOf(style_str, "color")
            IfCondition GreaterEqual(col_idx, 0) ThenBlock: {
                slen = StringLength(style_str)
                rule = CSS_ParseInline(style_str, slen)
                IfCondition GreaterEqual(rule, 0) ThenBlock: {
                    cv = CSS_GetPropVal(rule, "color")
                    IfCondition NotEqual(cv, 0) ThenBlock: {
                        ReturnValue(LY__ParseColor(cv))
                    }
                }
            }
        }

        // Check CSS stylesheet rules
        css_fg = LY__CSSLookupProp(node, "color")
        IfCondition NotEqual(css_fg, 0) ThenBlock: {
            ReturnValue(LY__ParseColor(css_fg))
        }

        // Inherit from parent state
        ReturnValue(LYState.fg_color)
    }
}

// =============================================================================
// BOX SHORTHAND PARSING — parse "10px", "10px 20px", "10px 20px 30px 40px"
// Returns individual side values via LYBox FixedPool
// =============================================================================
FixedPool.LYBox {
    "top":     Initialize=0
    "right":   Initialize=0
    "bottom":  Initialize=0
    "left":    Initialize=0
}

// Parse a CSS box shorthand value string into top/right/bottom/left
// Handles 1-value, 2-value, 3-value, and 4-value syntax
Function.LY__ParseBoxShorthand {
    Input: str: Address
    Body: {
        LYBox.top = 0
        LYBox.right = 0
        LYBox.bottom = 0
        LYBox.left = 0
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(str)
        IfCondition EqualTo(slen, 0) ThenBlock: { ReturnValue(0) }

        // Skip "auto" — handled separately by margin:auto logic
        IfCondition GreaterEqual(StringIndexOf(str, "auto"), 0) ThenBlock: {
            ReturnValue(0)
        }

        // Collect up to 4 space-separated values
        // vals[0..3] stored in v1..v4, count in val_count
        v1 = 0
        v2 = 0
        v3 = 0
        v4 = 0
        val_count = 0
        pos = 0

        // Skip leading whitespace
        WhileLoop LessThan(pos, slen) {
            bch = GetByte(str, pos)
            IfCondition And(NotEqual(bch, 32), NotEqual(bch, 9)) ThenBlock: {
                pos = Add(slen, 1)   // break
            } ElseBlock: {
                pos = Add(pos, 1)
            }
        }
        IfCondition GreaterThan(pos, slen) ThenBlock: { pos = Subtract(pos, 1) }

        // Parse value 1
        IfCondition LessThan(pos, slen) ThenBlock: {
            bch1 = GetByte(str, pos)
            // Accept digit or '.' (for .5em etc)
            IfCondition Or(And(GreaterEqual(bch1, 48), LessEqual(bch1, 57)), EqualTo(bch1, 46)) ThenBlock: {
                v1 = LY__ParsePx(Add(str, pos))
                val_count = 1
                // Skip past this value (digits, dots, letters like 'px', 'em', '%')
                WhileLoop LessThan(pos, slen) {
                    bsk = GetByte(str, pos)
                    IfCondition Or(EqualTo(bsk, 32), EqualTo(bsk, 9)) ThenBlock: {
                        pos = Add(slen, 1)
                    } ElseBlock: {
                        pos = Add(pos, 1)
                    }
                }
                IfCondition GreaterThan(pos, slen) ThenBlock: { pos = Subtract(pos, 1) }
                // Skip whitespace
                WhileLoop LessThan(pos, slen) {
                    bsp = GetByte(str, pos)
                    IfCondition And(NotEqual(bsp, 32), NotEqual(bsp, 9)) ThenBlock: {
                        pos = Add(slen, 1)
                    } ElseBlock: {
                        pos = Add(pos, 1)
                    }
                }
                IfCondition GreaterThan(pos, slen) ThenBlock: { pos = Subtract(pos, 1) }
            }
        }

        // Parse value 2
        IfCondition And(LessThan(pos, slen), GreaterEqual(val_count, 1)) ThenBlock: {
            bch2 = GetByte(str, pos)
            IfCondition Or(And(GreaterEqual(bch2, 48), LessEqual(bch2, 57)), EqualTo(bch2, 46)) ThenBlock: {
                v2 = LY__ParsePx(Add(str, pos))
                val_count = 2
                WhileLoop LessThan(pos, slen) {
                    bsk2 = GetByte(str, pos)
                    IfCondition Or(EqualTo(bsk2, 32), EqualTo(bsk2, 9)) ThenBlock: {
                        pos = Add(slen, 1)
                    } ElseBlock: {
                        pos = Add(pos, 1)
                    }
                }
                IfCondition GreaterThan(pos, slen) ThenBlock: { pos = Subtract(pos, 1) }
                WhileLoop LessThan(pos, slen) {
                    bsp2 = GetByte(str, pos)
                    IfCondition And(NotEqual(bsp2, 32), NotEqual(bsp2, 9)) ThenBlock: {
                        pos = Add(slen, 1)
                    } ElseBlock: {
                        pos = Add(pos, 1)
                    }
                }
                IfCondition GreaterThan(pos, slen) ThenBlock: { pos = Subtract(pos, 1) }
            }
        }

        // Parse value 3
        IfCondition And(LessThan(pos, slen), GreaterEqual(val_count, 2)) ThenBlock: {
            bch3 = GetByte(str, pos)
            IfCondition Or(And(GreaterEqual(bch3, 48), LessEqual(bch3, 57)), EqualTo(bch3, 46)) ThenBlock: {
                v3 = LY__ParsePx(Add(str, pos))
                val_count = 3
                WhileLoop LessThan(pos, slen) {
                    bsk3 = GetByte(str, pos)
                    IfCondition Or(EqualTo(bsk3, 32), EqualTo(bsk3, 9)) ThenBlock: {
                        pos = Add(slen, 1)
                    } ElseBlock: {
                        pos = Add(pos, 1)
                    }
                }
                IfCondition GreaterThan(pos, slen) ThenBlock: { pos = Subtract(pos, 1) }
                WhileLoop LessThan(pos, slen) {
                    bsp3 = GetByte(str, pos)
                    IfCondition And(NotEqual(bsp3, 32), NotEqual(bsp3, 9)) ThenBlock: {
                        pos = Add(slen, 1)
                    } ElseBlock: {
                        pos = Add(pos, 1)
                    }
                }
                IfCondition GreaterThan(pos, slen) ThenBlock: { pos = Subtract(pos, 1) }
            }
        }

        // Parse value 4
        IfCondition And(LessThan(pos, slen), GreaterEqual(val_count, 3)) ThenBlock: {
            bch4 = GetByte(str, pos)
            IfCondition Or(And(GreaterEqual(bch4, 48), LessEqual(bch4, 57)), EqualTo(bch4, 46)) ThenBlock: {
                v4 = LY__ParsePx(Add(str, pos))
                val_count = 4
            }
        }

        // Apply CSS box model rules:
        // 1 value:  all sides = v1
        // 2 values: top/bottom = v1, right/left = v2
        // 3 values: top = v1, right/left = v2, bottom = v3
        // 4 values: top = v1, right = v2, bottom = v3, left = v4
        IfCondition EqualTo(val_count, 1) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v1
            LYBox.bottom = v1
            LYBox.left = v1
        }
        IfCondition EqualTo(val_count, 2) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v2
            LYBox.bottom = v1
            LYBox.left = v2
        }
        IfCondition EqualTo(val_count, 3) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v2
            LYBox.bottom = v3
            LYBox.left = v2
        }
        IfCondition EqualTo(val_count, 4) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v2
            LYBox.bottom = v3
            LYBox.left = v4
        }
    }
}

// =============================================================================
// RESOLVE MARGIN — CSS-aware, falls back to tag defaults
// side: 0=top, 1=right, 2=bottom, 3=left
// =============================================================================
Function.LY__ResolveMarginSide {
    Input: node: Integer
    Input: tag: Address
    Input: side: Integer
    Output: Integer
    Body: {
        // 1. Check individual CSS property (highest priority)
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "margin-top" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "margin-right" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "margin-bottom" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "margin-left" }

        // Check inline style first
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "margin"), 0) ThenBlock: {
                mslen = StringLength(style_str)
                mrule = CSS_ParseInline(style_str, mslen)
                IfCondition GreaterEqual(mrule, 0) ThenBlock: {
                    // Try individual property
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        mv = CSS_GetPropVal(mrule, side_prop)
                        IfCondition NotEqual(mv, 0) ThenBlock: {
                            ReturnValue(LY__ParsePx(mv))
                        }
                    }
                    // Try shorthand
                    msh = CSS_GetPropVal(mrule, "margin")
                    IfCondition NotEqual(msh, 0) ThenBlock: {
                        LY__ParseBoxShorthand(msh)
                        IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
                        IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
                        IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
                        IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
                    }
                }
            }
        }

        // 2. Check CSS stylesheet rules — individual property
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_side = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_side, 0) ThenBlock: {
                ReturnValue(LY__ParsePx(css_side))
            }
        }

        // 3. Check CSS stylesheet rules — shorthand
        css_sh = LY__CSSLookupProp(node, "margin")
        IfCondition NotEqual(css_sh, 0) ThenBlock: {
            LY__ParseBoxShorthand(css_sh)
            IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
            IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
            IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
            IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
        }

        // 4. Fall back to tag defaults (top/bottom only)
        IfCondition Or(EqualTo(side, 0), EqualTo(side, 2)) ThenBlock: {
            ReturnValue(LY__ResolveMarginDefault(tag))
        }
        ReturnValue(0)
    }
}

Function.LY__ResolveMarginDefault {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(tag, "p"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "h1"), 0) ThenBlock: { ReturnValue(20) }
        IfCondition EqualTo(StringCompare(tag, "h2"), 0) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(StringCompare(tag, "h3"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "div"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(tag, "ul"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "ol"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "li"), 0) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(StringCompare(tag, "blockquote"), 0) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(StringCompare(tag, "pre"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "hr"), 0) ThenBlock: { ReturnValue(8) }
        ReturnValue(0)
    }
}

// Backward-compatible wrapper: returns top margin (used by existing code)
Function.LY__ResolveMargin {
    Input: tag: Address
    Output: Integer
    Body: {
        ReturnValue(LY__ResolveMarginDefault(tag))
    }
}

// =============================================================================
// RESOLVE PADDING — CSS-aware, falls back to tag defaults
// side: 0=top, 1=right, 2=bottom, 3=left
// =============================================================================
Function.LY__ResolvePaddingSide {
    Input: node: Integer
    Input: tag: Address
    Input: side: Integer
    Output: Integer
    Body: {
        // 1. Check individual CSS property
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "padding-top" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "padding-right" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "padding-bottom" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "padding-left" }

        // Check inline style first
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "padding"), 0) ThenBlock: {
                pslen = StringLength(style_str)
                prule = CSS_ParseInline(style_str, pslen)
                IfCondition GreaterEqual(prule, 0) ThenBlock: {
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        pv = CSS_GetPropVal(prule, side_prop)
                        IfCondition NotEqual(pv, 0) ThenBlock: {
                            ReturnValue(LY__ParsePx(pv))
                        }
                    }
                    psh = CSS_GetPropVal(prule, "padding")
                    IfCondition NotEqual(psh, 0) ThenBlock: {
                        LY__ParseBoxShorthand(psh)
                        IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
                        IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
                        IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
                        IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
                    }
                }
            }
        }

        // 2. CSS stylesheet — individual property
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_side = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_side, 0) ThenBlock: {
                ReturnValue(LY__ParsePx(css_side))
            }
        }

        // 3. CSS stylesheet — shorthand
        css_sh = LY__CSSLookupProp(node, "padding")
        IfCondition NotEqual(css_sh, 0) ThenBlock: {
            LY__ParseBoxShorthand(css_sh)
            IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
            IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
            IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
            IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
        }

        // 4. Fall back to tag defaults (uniform for now)
        ReturnValue(LY__ResolvePaddingDefault(tag))
    }
}

Function.LY__ResolvePaddingDefault {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(tag, "body"), 0) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(StringCompare(tag, "blockquote"), 0) ThenBlock: { ReturnValue(20) }
        IfCondition EqualTo(StringCompare(tag, "pre"), 0) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(StringCompare(tag, "li"), 0) ThenBlock: { ReturnValue(16) }
        ReturnValue(0)
    }
}

// Backward-compatible wrapper: returns uniform padding (used by existing code)
Function.LY__ResolvePadding {
    Input: tag: Address
    Output: Integer
    Body: {
        ReturnValue(LY__ResolvePaddingDefault(tag))
    }
}

// =============================================================================
// BORDER SHORTHAND — parse "1px solid #ccc" into width/style/color
// Also resolves per-side border-width from shorthand or individual properties
// =============================================================================
FixedPool.LYBorder {
    "width":   Initialize=0
    "color":   Initialize=0
}

// Parse border shorthand: "1px solid #ccc" or "1px solid" or "none"
// Stores width in LYBorder.width, color in LYBorder.color
// Strategy: scan chars for digit (width) and '#' (hex color)
Function.LY__ParseBorderShorthand {
    Input: str: Address
    Body: {
        LYBorder.width = 0
        LYBorder.color = 0
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(str)
        IfCondition EqualTo(slen, 0) ThenBlock: { ReturnValue(0) }

        // "none" or "0" means no border
        IfCondition EqualTo(StringCompare(str, "none"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(str, "0"), 0) ThenBlock: { ReturnValue(0) }

        // Scan for width: first digit character → parse from that position
        // LY__ParsePx reads digits until non-digit, so passing str ptr at digit start works
        pos = 0
        WhileLoop LessThan(pos, slen) {
            ch = Dereference(Add(str, pos), "byte")
            // Digit 0-9: parse width from this position
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                LYBorder.width = LY__ParsePx(Add(str, pos))
                pos = slen // break
            } ElseBlock: {
                pos = Add(pos, 1)
            }
        }

        // Scan for color: '#' character → parse from that position
        pos = 0
        WhileLoop LessThan(pos, slen) {
            ch = Dereference(Add(str, pos), "byte")
            IfCondition EqualTo(ch, 35) ThenBlock: {
                LYBorder.color = LY__ParseColor(Add(str, pos))
                pos = slen // break
            } ElseBlock: {
                pos = Add(pos, 1)
            }
        }

        // If no hex color found, try parsing the whole string as a color
        // (handles "border: 1px solid red" where color is a named color)
        IfCondition EqualTo(LYBorder.color, 0) ThenBlock: {
            // Try each space-separated word as a potential color name
            // Skip style keywords (solid, dashed, dotted, double, groove, ridge, inset, outset, none, hidden)
            // Skip size keywords (thin, medium, thick) and numbers
            wpos = 0
            w_found = 0
            WhileLoop And(LessThan(wpos, slen), EqualTo(w_found, 0)) {
                // Skip whitespace
                ws_skip_done = 0
                WhileLoop And(LessThan(wpos, slen), EqualTo(ws_skip_done, 0)) {
                    wch = Dereference(Add(str, wpos), "byte")
                    IfCondition EqualTo(wch, 32) ThenBlock: { wpos = Add(wpos, 1) }
                    ElseBlock: { ws_skip_done = 1 }
                }
                IfCondition LessThan(wpos, slen) ThenBlock: {
                    // Find end of word
                    wend = wpos
                    wend_done = 0
                    WhileLoop And(LessThan(wend, slen), EqualTo(wend_done, 0)) {
                        wech = Dereference(Add(str, wend), "byte")
                        IfCondition EqualTo(wech, 32) ThenBlock: { wend_done = 1 }
                        ElseBlock: { wend = Add(wend, 1) }
                    }
                    // Extract word
                    wlen = Subtract(wend, wpos)
                    IfCondition GreaterThan(wlen, 0) ThenBlock: {
                        word_ptr = Add(str, wpos)
                        first_ch = Dereference(word_ptr, "byte")
                        // Skip digits (size values) and '#' (already handled)
                        is_skip = 0
                        IfCondition And(GreaterEqual(first_ch, 48), LessEqual(first_ch, 57)) ThenBlock: { is_skip = 1 }
                        IfCondition EqualTo(first_ch, 35) ThenBlock: { is_skip = 1 }
                        IfCondition EqualTo(is_skip, 0) ThenBlock: {
                            // Try as color — extract word to temp buffer
                            word_buf = Allocate(Add(wlen, 1))
                            MemoryCopy(word_buf, word_ptr, wlen)
                            StoreValue(Add(word_buf, wlen), 0, "byte")
                            // Skip border-style keywords
                            is_style = 0
                            IfCondition EqualTo(StringCompare(word_buf, "solid"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "dashed"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "dotted"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "double"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "groove"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "ridge"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "inset"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "outset"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "none"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "hidden"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "thin"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "medium"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "thick"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(is_style, 0) ThenBlock: {
                                try_color = LY__ParseColor(word_buf)
                                IfCondition NotEqual(try_color, 0) ThenBlock: {
                                    LYBorder.color = try_color
                                    w_found = 1
                                }
                            }
                        }
                    }
                    wpos = wend
                }
            }
        }

        // Check for named keywords: thin/medium/thick (if no digit width found)
        IfCondition EqualTo(LYBorder.width, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(str, "thin"), 0) ThenBlock: {
                LYBorder.width = 1
            }
            IfCondition GreaterEqual(StringIndexOf(str, "medium"), 0) ThenBlock: {
                LYBorder.width = 3
            }
            IfCondition GreaterEqual(StringIndexOf(str, "thick"), 0) ThenBlock: {
                LYBorder.width = 5
            }
        }
        // CSS spec: border shorthand with no explicit width defaults to medium (3px)
        IfCondition EqualTo(LYBorder.width, 0) ThenBlock: {
            LYBorder.width = 3
        }
    }
}

// Resolve border-width for a given side (0=top, 1=right, 2=bottom, 3=left)
Function.LY__ResolveBorderWidth {
    Input: node: Integer
    Input: side: Integer
    Output: Integer
    Body: {
        // Individual property name
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "border-top-width" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "border-right-width" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "border-bottom-width" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "border-left-width" }

        // Check inline style
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "border"), 0) ThenBlock: {
                bslen = StringLength(style_str)
                brule = CSS_ParseInline(style_str, bslen)
                IfCondition GreaterEqual(brule, 0) ThenBlock: {
                    // Try individual side width
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        bv = CSS_GetPropVal(brule, side_prop)
                        IfCondition NotEqual(bv, 0) ThenBlock: {
                            ReturnValue(LY__ParsePx(bv))
                        }
                    }
                    // Try border-width shorthand (1/2/3/4 values like margin)
                    bw = CSS_GetPropVal(brule, "border-width")
                    IfCondition NotEqual(bw, 0) ThenBlock: {
                        LY__ParseBoxShorthand(bw)
                        IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
                        IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
                        IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
                        IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
                    }
                    // Try border shorthand
                    bsh = CSS_GetPropVal(brule, "border")
                    IfCondition NotEqual(bsh, 0) ThenBlock: {
                        LY__ParseBorderShorthand(bsh)
                        ReturnValue(LYBorder.width)
                    }
                }
            }
        }

        // Check CSS stylesheet rules — individual property
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_bw = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_bw, 0) ThenBlock: {
                ReturnValue(LY__ParsePx(css_bw))
            }
        }

        // Check CSS stylesheet — border-width shorthand
        css_bwsh = LY__CSSLookupProp(node, "border-width")
        IfCondition NotEqual(css_bwsh, 0) ThenBlock: {
            LY__ParseBoxShorthand(css_bwsh)
            IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
            IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
            IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
            IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
        }

        // Check CSS stylesheet — border shorthand
        css_bsh = LY__CSSLookupProp(node, "border")
        IfCondition NotEqual(css_bsh, 0) ThenBlock: {
            LY__ParseBorderShorthand(css_bsh)
            ReturnValue(LYBorder.width)
        }

        ReturnValue(0)
    }
}

// Resolve border-color for a given side
Function.LY__ResolveBorderColor {
    Input: node: Integer
    Input: side: Integer
    Output: Integer
    Body: {
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "border-top-color" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "border-right-color" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "border-bottom-color" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "border-left-color" }

        // Check inline style
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "border"), 0) ThenBlock: {
                bslen = StringLength(style_str)
                brule = CSS_ParseInline(style_str, bslen)
                IfCondition GreaterEqual(brule, 0) ThenBlock: {
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        bv = CSS_GetPropVal(brule, side_prop)
                        IfCondition NotEqual(bv, 0) ThenBlock: {
                            ReturnValue(LY__ParseColor(bv))
                        }
                    }
                    bsh = CSS_GetPropVal(brule, "border")
                    IfCondition NotEqual(bsh, 0) ThenBlock: {
                        LY__ParseBorderShorthand(bsh)
                        IfCondition NotEqual(LYBorder.color, 0) ThenBlock: {
                            ReturnValue(LYBorder.color)
                        }
                    }
                }
            }
        }

        // CSS rules — individual
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_bc = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_bc, 0) ThenBlock: {
                ReturnValue(LY__ParseColor(css_bc))
            }
        }

        // CSS rules — shorthand
        css_bsh = LY__CSSLookupProp(node, "border")
        IfCondition NotEqual(css_bsh, 0) ThenBlock: {
            LY__ParseBorderShorthand(css_bsh)
            IfCondition NotEqual(LYBorder.color, 0) ThenBlock: {
                ReturnValue(LYBorder.color)
            }
        }

        // Default: use foreground color
        ReturnValue(LYState.fg_color)
    }
}

// =============================================================================
// BACKGROUND SHORTHAND — extract background-color from "background" property
// "background: #fff url(...) no-repeat" → returns #fff color
// =============================================================================
Function.LY__ResolveBackgroundColor {
    Input: node: Integer
    Output: Integer
    Body: {
        // Already checked background-color directly in LY__ResolveBgColor
        // This handles the "background" shorthand property
        bg_sh = 0

        // Check inline style
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "background"), 0) ThenBlock: {
                bslen = StringLength(style_str)
                brule = CSS_ParseInline(style_str, bslen)
                IfCondition GreaterEqual(brule, 0) ThenBlock: {
                    bg_sh = CSS_GetPropVal(brule, "background")
                }
            }
        }

        // Check CSS rules
        IfCondition EqualTo(bg_sh, 0) ThenBlock: {
            bg_sh = LY__CSSLookupProp(node, "background")
        }

        IfCondition NotEqual(bg_sh, 0) ThenBlock: {
            // Try to extract a color from the shorthand
            // The color is typically the first token that looks like a color
            first_ch = Dereference(bg_sh, "byte")
            // Hex color
            IfCondition EqualTo(first_ch, 35) ThenBlock: {
                ReturnValue(LY__ParseColor(bg_sh))
            }
            // Named color or rgb(...)
            c = LY__ParseColor(bg_sh)
            IfCondition NotEqual(c, 0) ThenBlock: {
                ReturnValue(c)
            }
        }

        ReturnValue(LYConst.COLOR_TRANSP)
    }
}

// =============================================================================
// FLEX ITEM HELPERS
// =============================================================================
Function.LY__FlexItemAddr {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(Add(LYFlex.pool, Multiply(idx, LYFlex.ITEM_SIZE))) }
}

Function.LY__FlexItemSet {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        addr = LY__FlexItemAddr(idx)
        StoreValue(Add(addr, field), val)
    }
}

Function.LY__FlexItemGet {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        addr = LY__FlexItemAddr(idx)
        ReturnValue(Dereference(Add(addr, field)))
    }
}

// =============================================================================
// FLEXBOX LAYOUT — two-pass: measure children, then place them
// Called when a block element has display:flex
// =============================================================================
Function.LY__FlexLayout {
    Input: node: Integer
    Body: {
        // Resolve flex container properties
        LYFlexTmp.dir = 0      // default: row
        LYFlexTmp.justify = 0  // default: flex-start
        LYFlexTmp.align = 0    // default: stretch
        LYFlexTmp.gap = 0
        LYFlexTmp.wrap = 0

        // Check flex-direction
        fd_val = LY__CSSLookupProp(node, "flex-direction")
        IfCondition NotEqual(fd_val, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(fd_val, "column"), 0) ThenBlock: {
                LYFlexTmp.dir = 1
            }
        }
        // Also check inline style
        fd_style = DOM_GetAttr(node, "style")
        IfCondition NotEqual(fd_style, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(fd_style, "flex-direction"), 0) ThenBlock: {
                fd_slen = StringLength(fd_style)
                fd_rule = CSS_ParseInline(fd_style, fd_slen)
                IfCondition GreaterEqual(fd_rule, 0) ThenBlock: {
                    fd_v2 = CSS_GetPropVal(fd_rule, "flex-direction")
                    IfCondition NotEqual(fd_v2, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(fd_v2, "column"), 0) ThenBlock: {
                            LYFlexTmp.dir = 1
                        }
                    }
                }
            }
        }

        // Check justify-content
        jc_val = LY__CSSLookupProp(node, "justify-content")
        IfCondition NotEqual(jc_val, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(jc_val, "center"), 0) ThenBlock: { LYFlexTmp.justify = 2 }
            IfCondition EqualTo(StringCompare(jc_val, "flex-end"), 0) ThenBlock: { LYFlexTmp.justify = 1 }
            IfCondition EqualTo(StringCompare(jc_val, "space-between"), 0) ThenBlock: { LYFlexTmp.justify = 3 }
            IfCondition EqualTo(StringCompare(jc_val, "space-around"), 0) ThenBlock: { LYFlexTmp.justify = 4 }
        }

        // Check align-items
        ai_val = LY__CSSLookupProp(node, "align-items")
        IfCondition NotEqual(ai_val, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(ai_val, "center"), 0) ThenBlock: { LYFlexTmp.align = 3 }
            IfCondition EqualTo(StringCompare(ai_val, "flex-start"), 0) ThenBlock: { LYFlexTmp.align = 1 }
            IfCondition EqualTo(StringCompare(ai_val, "flex-end"), 0) ThenBlock: { LYFlexTmp.align = 2 }
        }

        // Check gap
        gap_val = LY__CSSLookupProp(node, "gap")
        IfCondition NotEqual(gap_val, 0) ThenBlock: {
            LYFlexTmp.gap = LY__ParsePx(gap_val)
        }

        // =============================================
        // PASS 1: Measure children
        // =============================================
        LYFlex.count = 0
        container_x = LYState.indent
        container_y = LYState.cursor_y
        container_w = LYState.avail_w

        fc = DOM_GetFirstChild(node)
        WhileLoop And(GreaterEqual(fc, 0), LessThan(LYFlex.count, LYFlex.MAX_ITEMS)) {
            next_fc = DOM_GetNextSib(fc)

            // Skip text-only whitespace nodes
            fc_type = DOM_GetType(fc)
            IfCondition EqualTo(fc_type, DOMType.TEXT) ThenBlock: {
                fc = next_fc
            }
            IfCondition NotEqual(fc_type, DOMType.TEXT) ThenBlock: {
                // Check display:none on child
                fc_hidden = 0
                fc_tag = DOM_GetTag(fc)
                fc_disp = LY__GetDisplay(fc_tag)
                IfCondition EqualTo(fc_disp, LYDisp.NONE) ThenBlock: { fc_hidden = 1 }
                IfCondition EqualTo(fc_hidden, 0) ThenBlock: {
                    fc_css_d = LY__CSSLookupProp(fc, "display")
                    IfCondition NotEqual(fc_css_d, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(fc_css_d, "none"), 0) ThenBlock: {
                            fc_hidden = 1
                        }
                    }
                }

                IfCondition EqualTo(fc_hidden, 0) ThenBlock: {
                    fi = LYFlex.count

                    // Record cmd_start before laying out this child
                    cmd_before = LYState.cmd_count
                    cy_before = LYState.cursor_y

                    // Layout child normally (it emits commands at current cursor)
                    LY__LayoutNode(fc)

                    // Measure: height is cursor advance, width is avail_w (block) or content
                    item_h = Subtract(LYState.cursor_y, cy_before)
                    item_w = LYState.avail_w
                    cmd_after = LYState.cmd_count

                    // Check flex-grow on child
                    fg_grow = 0
                    fg_v = LY__CSSLookupProp(fc, "flex-grow")
                    IfCondition NotEqual(fg_v, 0) ThenBlock: {
                        fg_grow = LY__ParsePx(fg_v)
                    }

                    // Store flex item data
                    LY__FlexItemSet(fi, LYFlex.I_NODE, fc)
                    LY__FlexItemSet(fi, LYFlex.I_MEAS_W, item_w)
                    LY__FlexItemSet(fi, LYFlex.I_MEAS_H, item_h)
                    LY__FlexItemSet(fi, LYFlex.I_CMD_START, cmd_before)
                    LY__FlexItemSet(fi, LYFlex.I_CMD_COUNT, Subtract(cmd_after, cmd_before))
                    LY__FlexItemSet(fi, LYFlex.I_GROW, fg_grow)

                    LYFlex.count = Add(LYFlex.count, 1)
                }

                fc = next_fc
            }
        }

        // =============================================
        // PASS 2: Distribute space and relocate commands
        // =============================================
        IfCondition EqualTo(LYFlex.count, 0) ThenBlock: { ReturnValue(0) }

        // Calculate total main-axis size and total grow
        LYFlexTmp.total_main = 0
        LYFlexTmp.total_grow = 0
        LYFlexTmp.item_i = 0
        WhileLoop LessThan(LYFlexTmp.item_i, LYFlex.count) {
            IfCondition EqualTo(LYFlexTmp.dir, 0) ThenBlock: {
                // Row: main axis is width
                im = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_MEAS_H)
                // For row, we use a fraction of container width per item
                iw = Divide(container_w, LYFlex.count)
                LYFlexTmp.total_main = Add(LYFlexTmp.total_main, iw)
            }
            IfCondition EqualTo(LYFlexTmp.dir, 1) ThenBlock: {
                // Column: main axis is height
                ih = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_MEAS_H)
                LYFlexTmp.total_main = Add(LYFlexTmp.total_main, ih)
            }
            ig = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_GROW)
            LYFlexTmp.total_grow = Add(LYFlexTmp.total_grow, ig)
            LYFlexTmp.item_i = Add(LYFlexTmp.item_i, 1)
        }

        // Total gap space
        gap_total = Multiply(LYFlexTmp.gap, Subtract(LYFlex.count, 1))

        // Free space on main axis
        IfCondition EqualTo(LYFlexTmp.dir, 0) ThenBlock: {
            LYFlexTmp.free_space = Subtract(container_w, Add(LYFlexTmp.total_main, gap_total))
        }
        IfCondition EqualTo(LYFlexTmp.dir, 1) ThenBlock: {
            // Column: free space isn't bounded (page grows vertically)
            LYFlexTmp.free_space = 0
        }
        IfCondition LessThan(LYFlexTmp.free_space, 0) ThenBlock: {
            LYFlexTmp.free_space = 0
        }

        // Calculate starting offset based on justify-content
        main_offset = 0
        item_spacing = 0
        IfCondition EqualTo(LYFlexTmp.justify, 1) ThenBlock: {
            // flex-end: push to end
            main_offset = LYFlexTmp.free_space
        }
        IfCondition EqualTo(LYFlexTmp.justify, 2) ThenBlock: {
            // center: center the items
            main_offset = Divide(LYFlexTmp.free_space, 2)
        }
        IfCondition EqualTo(LYFlexTmp.justify, 3) ThenBlock: {
            // space-between: distribute between items
            IfCondition GreaterThan(LYFlex.count, 1) ThenBlock: {
                item_spacing = Divide(LYFlexTmp.free_space, Subtract(LYFlex.count, 1))
            }
        }
        IfCondition EqualTo(LYFlexTmp.justify, 4) ThenBlock: {
            // space-around: equal space around each item
            item_spacing = Divide(LYFlexTmp.free_space, LYFlex.count)
            main_offset = Divide(item_spacing, 2)
        }

        // Now relocate all commands
        // Reset cursor to container start
        LYState.cursor_y = container_y

        cur_main = main_offset
        max_cross = 0

        LYFlexTmp.item_i = 0
        WhileLoop LessThan(LYFlexTmp.item_i, LYFlex.count) {
            i_cmd_start = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_CMD_START)
            i_cmd_count = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_CMD_COUNT)
            i_meas_w = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_MEAS_W)
            i_meas_h = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_MEAS_H)

            // Calculate item width in row mode
            item_main_sz = i_meas_h
            IfCondition EqualTo(LYFlexTmp.dir, 0) ThenBlock: {
                item_main_sz = Divide(container_w, LYFlex.count)
                // Apply flex-grow if there's free space
                IfCondition And(GreaterThan(LYFlexTmp.total_grow, 0), GreaterThan(LYFlexTmp.free_space, 0)) ThenBlock: {
                    ig2 = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_GROW)
                    IfCondition GreaterThan(ig2, 0) ThenBlock: {
                        grow_px = Divide(Multiply(LYFlexTmp.free_space, ig2), LYFlexTmp.total_grow)
                        item_main_sz = Add(item_main_sz, grow_px)
                    }
                }
            }

            // Calculate delta from where commands were placed to where they should be
            IfCondition EqualTo(LYFlexTmp.dir, 0) ThenBlock: {
                // Row: shift X, keep relative Y
                dx = Subtract(Add(container_x, cur_main), LYState.indent)
                dy = Subtract(container_y, container_y) // commands already at correct Y baseline
                // Actually: commands were placed at sequential Y positions by normal block layout
                // We need to move them to container_y (same row) with offset X = cur_main
                // The commands' Y was set starting from cy_before (which incremented sequentially)
                // We want all at container_y, shifted right by cur_main
                // dy = container_y - (the Y where they were originally placed)
                // Since we laid them out sequentially, item 0 started at container_y, item 1 at container_y + item0_h, etc.
                // Original Y for this item: container_y + sum of all previous items' heights
                orig_y = container_y
                oi = 0
                WhileLoop LessThan(oi, LYFlexTmp.item_i) {
                    orig_y = Add(orig_y, LY__FlexItemGet(oi, LYFlex.I_MEAS_H))
                    oi = Add(oi, 1)
                }
                dx = Add(container_x, cur_main)
                dy = Subtract(container_y, orig_y)

                // Relocate commands: add dx to X, add dy to Y
                ci = i_cmd_start
                ci_end = Add(i_cmd_start, i_cmd_count)
                WhileLoop LessThan(ci, ci_end) {
                    cmd_addr = Add(LYState.cmd_pool, Multiply(ci, LYConst.CMD_SIZE))
                    old_x = Dereference(Add(cmd_addr, LYConst.C_X))
                    old_y = Dereference(Add(cmd_addr, LYConst.C_Y))
                    // Set X relative to container: (old_x - container_x) + container_x + cur_main
                    new_x = Add(Subtract(old_x, container_x), Add(container_x, cur_main))
                    new_y = Add(old_y, dy)
                    StoreValue(Add(cmd_addr, LYConst.C_X), new_x)
                    StoreValue(Add(cmd_addr, LYConst.C_Y), new_y)
                    ci = Add(ci, 1)
                }

                // Track max cross-axis size (height in row mode)
                IfCondition GreaterThan(i_meas_h, max_cross) ThenBlock: {
                    max_cross = i_meas_h
                }
            }

            IfCondition EqualTo(LYFlexTmp.dir, 1) ThenBlock: {
                // Column: commands are already in correct Y order, just apply gap
                IfCondition GreaterThan(LYFlexTmp.item_i, 0) ThenBlock: {
                    // Shift this item and all subsequent down by accumulated gaps
                    gap_shift = Multiply(LYFlexTmp.gap, LYFlexTmp.item_i)
                    ci = i_cmd_start
                    ci_end = Add(i_cmd_start, i_cmd_count)
                    WhileLoop LessThan(ci, ci_end) {
                        cmd_addr = Add(LYState.cmd_pool, Multiply(ci, LYConst.CMD_SIZE))
                        old_y = Dereference(Add(cmd_addr, LYConst.C_Y))
                        StoreValue(Add(cmd_addr, LYConst.C_Y), Add(old_y, gap_shift))
                        ci = Add(ci, 1)
                    }
                }
                max_cross = container_w
            }

            // Advance main-axis cursor
            cur_main = Add(cur_main, Add(item_main_sz, LYFlexTmp.gap))
            IfCondition GreaterThan(item_spacing, 0) ThenBlock: {
                cur_main = Add(cur_main, item_spacing)
            }

            LYFlexTmp.item_i = Add(LYFlexTmp.item_i, 1)
        }

        // Update cursor_y after flex container
        IfCondition EqualTo(LYFlexTmp.dir, 0) ThenBlock: {
            // Row: advance by tallest item
            LYState.cursor_y = Add(container_y, max_cross)
        }
        IfCondition EqualTo(LYFlexTmp.dir, 1) ThenBlock: {
            // Column: cursor_y is already advanced by child layouts + gaps
            total_gap = Multiply(LYFlexTmp.gap, Subtract(LYFlex.count, 1))
            LYState.cursor_y = Add(LYState.cursor_y, total_gap)
        }
    }
}

// =============================================================================
// MAIN LAYOUT — RECURSIVE DFS OVER DOM TREE
// ALL locals are stack variables — FixedPool temps get clobbered by recursion
// =============================================================================
Function.LY__LayoutNode {
    Input: node: Integer
    Body: {
        ntype = DOM_GetType(node)

        // TEXT nodes — emit text content
        IfCondition EqualTo(ntype, DOMType.TEXT) ThenBlock: {
            t_ptr = DOM_GetText(node)
            t_len = DOM_GetTextLen(node)
            IfCondition And(NotEqual(t_ptr, 0), GreaterThan(t_len, 0)) ThenBlock: {
                LY__EmitText(t_ptr, t_len, LYState.fg_color)
            }
            ReturnValue(0)
        }

        // COMMENT nodes — skip
        IfCondition EqualTo(ntype, DOMType.COMMENT) ThenBlock: {
            ReturnValue(0)
        }

        // ROOT node — process children
        IfCondition EqualTo(ntype, DOMType.ROOT) ThenBlock: {
            rc = DOM_GetFirstChild(node)
            WhileLoop GreaterEqual(rc, 0) {
                next_rc = DOM_GetNextSib(rc)
                LY__LayoutNode(rc)
                rc = next_rc
            }
            ReturnValue(0)
        }

        // ELEMENT node — classify and layout
        tag = DOM_GetTag(node)
        disp = LY__GetDisplay(tag)

        // Check HTML hidden attribute
        IfCondition NotEqual(disp, LYDisp.NONE) ThenBlock: {
            hidden_attr = DOM_GetAttr(node, "hidden")
            IfCondition NotEqual(hidden_attr, 0) ThenBlock: {
                disp = LYDisp.NONE
            }
        }

        // Check CSS display:none override
        // Never hide <html> or <body> — sites use "body{display:none}" as anti-FOUC
        // (e.g. DDG: "body{display:none}" + JS adds class to reveal). Since we run
        // scripts before layout, FOUC isn't an issue and body must always render.
        is_root_tag = 0
        IfCondition NotEqual(tag, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(tag, "body"), 0) ThenBlock: { is_root_tag = 1 }
            IfCondition EqualTo(StringCompare(tag, "html"), 0) ThenBlock: { is_root_tag = 1 }
        }
        // Resolve CSS display override (stylesheet + inline style)
        // Inline style overrides stylesheet which overrides tag default
        css_disp = 0
        IfCondition And(NotEqual(disp, LYDisp.NONE), EqualTo(is_root_tag, 0)) ThenBlock: {
            // 1. Check CSS stylesheet rules for display
            css_disp = LY__CSSLookupProp(node, "display")
            IfCondition NotEqual(css_disp, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(css_disp, "none"), 0) ThenBlock: {
                    disp = LYDisp.NONE
                }
                IfCondition EqualTo(StringCompare(css_disp, "block"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline"), 0) ThenBlock: {
                    disp = LYDisp.INLINE
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline-block"), 0) ThenBlock: {
                    disp = LYDisp.INLINE
                }
                IfCondition EqualTo(StringCompare(css_disp, "flex"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline-flex"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "list-item"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-row"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-cell"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-row-group"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-header-group"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-footer-group"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-caption"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "grid"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline-grid"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "flow-root"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "contents"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
            }
            // 2. Inline style overrides everything (higher specificity)
            // Must always check — inline style can override CSS display:none back to block
            ds_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(ds_str, 0) ThenBlock: {
                ds_idx = StringIndexOf(ds_str, "display")
                IfCondition GreaterEqual(ds_idx, 0) ThenBlock: {
                    ds_len = StringLength(ds_str)
                    ds_rule = CSS_ParseInline(ds_str, ds_len)
                    IfCondition GreaterEqual(ds_rule, 0) ThenBlock: {
                        ds_val = CSS_GetPropVal(ds_rule, "display")
                        IfCondition NotEqual(ds_val, 0) ThenBlock: {
                            css_disp = ds_val
                            IfCondition EqualTo(StringCompare(ds_val, "none"), 0) ThenBlock: {
                                disp = LYDisp.NONE
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "block"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline"), 0) ThenBlock: {
                                disp = LYDisp.INLINE
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline-block"), 0) ThenBlock: {
                                disp = LYDisp.INLINE
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "flex"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline-flex"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "list-item"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-row"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-cell"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-row-group"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-header-group"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-footer-group"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-caption"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "grid"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline-grid"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "flow-root"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "contents"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                        }
                    }
                }
            }
        }

        // NONE — skip
        IfCondition EqualTo(disp, LYDisp.NONE) ThenBlock: {
            ReturnValue(0)
        }

        // Check visibility: hidden (element takes space but isn't painted)
        is_visible = 1
        vis_css = LY__CSSLookupProp(node, "visibility")
        IfCondition NotEqual(vis_css, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(vis_css, "hidden"), 0) ThenBlock: {
                is_visible = 0
            }
            IfCondition EqualTo(StringCompare(vis_css, "collapse"), 0) ThenBlock: {
                is_visible = 0
            }
        }
        // Also check inline style
        IfCondition EqualTo(is_visible, 1) ThenBlock: {
            vis_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(vis_str, 0) ThenBlock: {
                IfCondition GreaterEqual(StringIndexOf(vis_str, "visibility"), 0) ThenBlock: {
                    vis_slen = StringLength(vis_str)
                    vis_rule = CSS_ParseInline(vis_str, vis_slen)
                    IfCondition GreaterEqual(vis_rule, 0) ThenBlock: {
                        vis_v = CSS_GetPropVal(vis_rule, "visibility")
                        IfCondition NotEqual(vis_v, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(vis_v, "hidden"), 0) ThenBlock: {
                                is_visible = 0
                            }
                            IfCondition EqualTo(StringCompare(vis_v, "collapse"), 0) ThenBlock: {
                                is_visible = 0
                            }
                        }
                    }
                }
            }
        }

        // BLOCK element
        IfCondition EqualTo(disp, LYDisp.BLOCK) ThenBlock: {
            // Flush any inline content on the current line before starting block
            IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
                blk_fh = LY__LineHeight()
                LYState.cursor_y = Add(LYState.cursor_y, blk_fh)
                LYState.cursor_x = LYState.indent
            }

            // Save parent state to stack locals
            sv_fg = LYState.fg_color
            sv_bg = LYState.bg_color
            sv_sc = LYState.font_scale
            sv_ind = LYState.indent
            sv_aw = LYState.avail_w
            sv_ta = LYState.text_align
            sv_vis = LYState.visible
            sv_lh = LYState.line_height
            sv_fspx = LYState.font_size_px
            sv_fwpx = LYState.font_w_px
            sv_ahem = LYState.is_ahem

            // Apply visibility:hidden — suppress paint but preserve layout
            IfCondition EqualTo(is_visible, 0) ThenBlock: {
                LYState.visible = 0
            }

            // Resolve per-side margin and padding from CSS/inline/defaults
            margin_top = LY__ResolveMarginSide(node, tag, 0)
            margin_right = LY__ResolveMarginSide(node, tag, 1)
            margin_bottom = LY__ResolveMarginSide(node, tag, 2)
            margin_left = LY__ResolveMarginSide(node, tag, 3)
            pad_top = LY__ResolvePaddingSide(node, tag, 0)
            pad_right = LY__ResolvePaddingSide(node, tag, 1)
            pad_bottom = LY__ResolvePaddingSide(node, tag, 2)
            pad_left = LY__ResolvePaddingSide(node, tag, 3)

            heading_sc = LY__HeadingScale(tag)

            // Font-size resolution: heading tag > CSS rule > inherited from parent
            IfCondition GreaterThan(heading_sc, 1) ThenBlock: {
                // Heading tags have fixed scale
                LYState.font_scale = heading_sc
            } ElseBlock: {
                // Check CSS font-size (inline style, then stylesheet)
                fs_val = 0
                fs_str = DOM_GetAttr(node, "style")
                IfCondition NotEqual(fs_str, 0) ThenBlock: {
                    fs_idx = StringIndexOf(fs_str, "font-size")
                    IfCondition GreaterEqual(fs_idx, 0) ThenBlock: {
                        fs_slen = StringLength(fs_str)
                        fs_rule = CSS_ParseInline(fs_str, fs_slen)
                        IfCondition GreaterEqual(fs_rule, 0) ThenBlock: {
                            fs_val = CSS_GetPropVal(fs_rule, "font-size")
                        }
                    }
                }
                IfCondition EqualTo(fs_val, 0) ThenBlock: {
                    fs_val = LY__CSSLookupProp(node, "font-size")
                }
                IfCondition NotEqual(fs_val, 0) ThenBlock: {
                    fs_px = LY__ParsePx(fs_val)
                    LYState.font_size_px = fs_px
                    IfCondition GreaterEqual(fs_px, 32) ThenBlock: {
                        LYState.font_scale = 3
                    } ElseBlock: {
                        IfCondition GreaterEqual(fs_px, 24) ThenBlock: {
                            LYState.font_scale = 2
                        } ElseBlock: {
                            LYState.font_scale = 1
                        }
                    }
                }
                // If no CSS font-size found, inherit from parent (LYState.font_scale unchanged)
            }

            // Resolve font-family: detect Ahem test font
            // Ahem glyphs are solid squares, 1em x 1em — every char is font_size_px wide
            ff_val = 0
            ff_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(ff_str, 0) ThenBlock: {
                ff_idx = StringIndexOf(ff_str, "font-family")
                IfCondition GreaterEqual(ff_idx, 0) ThenBlock: {
                    ff_slen = StringLength(ff_str)
                    ff_rule = CSS_ParseInline(ff_str, ff_slen)
                    IfCondition GreaterEqual(ff_rule, 0) ThenBlock: {
                        ff_val = CSS_GetPropVal(ff_rule, "font-family")
                    }
                }
            }
            IfCondition EqualTo(ff_val, 0) ThenBlock: {
                ff_val = LY__CSSLookupProp(node, "font-family")
            }
            IfCondition NotEqual(ff_val, 0) ThenBlock: {
                // Check if font-family contains "Ahem" (case-sensitive)
                ff_ahem = StringIndexOf(ff_val, "Ahem")
                IfCondition GreaterEqual(ff_ahem, 0) ThenBlock: {
                    LYState.is_ahem = 1
                    // Ahem: every glyph is a filled square of font_size_px x font_size_px
                    LYState.font_w_px = LYState.font_size_px
                }
            }

            // Resolve CSS line-height (inline style > stylesheet > inherited)
            lh_val = 0
            lh_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(lh_str, 0) ThenBlock: {
                lh_idx = StringIndexOf(lh_str, "line-height")
                IfCondition GreaterEqual(lh_idx, 0) ThenBlock: {
                    lh_slen = StringLength(lh_str)
                    lh_rule = CSS_ParseInline(lh_str, lh_slen)
                    IfCondition GreaterEqual(lh_rule, 0) ThenBlock: {
                        lh_cv = CSS_GetPropVal(lh_rule, "line-height")
                        IfCondition NotEqual(lh_cv, 0) ThenBlock: {
                            lh_val = LY__ParsePx(lh_cv)
                        }
                    }
                }
            }
            IfCondition EqualTo(lh_val, 0) ThenBlock: {
                lh_css = LY__CSSLookupProp(node, "line-height")
                IfCondition NotEqual(lh_css, 0) ThenBlock: {
                    lh_val = LY__ParsePx(lh_css)
                }
            }
            IfCondition GreaterThan(lh_val, 0) ThenBlock: {
                // Small values (< 10) are unitless multipliers of font height
                // e.g. line-height: 2 means 2x font_h
                IfCondition LessThan(lh_val, 10) ThenBlock: {
                    cur_fh = Multiply(LYConst.FONT_H, LYState.font_scale)
                    LYState.line_height = Multiply(lh_val, cur_fh)
                } ElseBlock: {
                    LYState.line_height = lh_val
                }
            }
            // If no CSS line-height found, inherit from parent (LYState.line_height unchanged)

            fg = LY__ResolveFgColor(node)
            LYState.fg_color = fg

            bg = LY__ResolveBgColor(node)

            // Resolve text-align from inline style or CSS rules
            ta_val = 0
            ta_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(ta_str, 0) ThenBlock: {
                ta_idx = StringIndexOf(ta_str, "text-align")
                IfCondition GreaterEqual(ta_idx, 0) ThenBlock: {
                    ta_slen = StringLength(ta_str)
                    ta_rule = CSS_ParseInline(ta_str, ta_slen)
                    IfCondition GreaterEqual(ta_rule, 0) ThenBlock: {
                        ta_cv = CSS_GetPropVal(ta_rule, "text-align")
                        IfCondition NotEqual(ta_cv, 0) ThenBlock: { ta_val = ta_cv }
                    }
                }
            }
            IfCondition EqualTo(ta_val, 0) ThenBlock: {
                ta_val = LY__CSSLookupProp(node, "text-align")
            }
            IfCondition NotEqual(ta_val, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(ta_val, "center"), 0) ThenBlock: {
                    LYState.text_align = 1
                }
                IfCondition EqualTo(StringCompare(ta_val, "right"), 0) ThenBlock: {
                    LYState.text_align = 2
                }
                IfCondition EqualTo(StringCompare(ta_val, "left"), 0) ThenBlock: {
                    LYState.text_align = 0
                }
            }
            // <center> tag implicitly sets text-align: center
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "center"), 0) ThenBlock: {
                    LYState.text_align = 1
                }
            }
            // HTML align attribute (legacy: <div align="center">, <td align="center">)
            align_attr = DOM_GetAttr(node, "align")
            IfCondition NotEqual(align_attr, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(align_attr, "center"), 0) ThenBlock: {
                    LYState.text_align = 1
                }
                IfCondition EqualTo(StringCompare(align_attr, "right"), 0) ThenBlock: {
                    LYState.text_align = 2
                }
            }

            // Resolve width/max-width constraints + margin:auto centering
            blk_constrained = 0
            w_val = 0
            mw_val = 0
            // Check inline style
            ws_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(ws_str, 0) ThenBlock: {
                ws_idx = StringIndexOf(ws_str, "width")
                IfCondition GreaterEqual(ws_idx, 0) ThenBlock: {
                    ws_slen = StringLength(ws_str)
                    ws_rule = CSS_ParseInline(ws_str, ws_slen)
                    IfCondition GreaterEqual(ws_rule, 0) ThenBlock: {
                        w_cv = CSS_GetPropVal(ws_rule, "width")
                        IfCondition NotEqual(w_cv, 0) ThenBlock: {
                            w_val = LY__ParsePx(w_cv)
                        }
                        mw_cv = CSS_GetPropVal(ws_rule, "max-width")
                        IfCondition NotEqual(mw_cv, 0) ThenBlock: {
                            mw_val = LY__ParsePx(mw_cv)
                        }
                    }
                }
            }
            // Check CSS rules
            IfCondition EqualTo(w_val, 0) ThenBlock: {
                w_css = LY__CSSLookupProp(node, "width")
                IfCondition NotEqual(w_css, 0) ThenBlock: {
                    w_val = LY__ParsePx(w_css)
                }
            }
            IfCondition EqualTo(mw_val, 0) ThenBlock: {
                mw_css = LY__CSSLookupProp(node, "max-width")
                IfCondition NotEqual(mw_css, 0) ThenBlock: {
                    mw_val = LY__ParsePx(mw_css)
                }
            }
            // Apply width constraint
            IfCondition GreaterThan(w_val, 0) ThenBlock: {
                IfCondition LessThan(w_val, LYState.avail_w) ThenBlock: {
                    blk_constrained = 1
                    LYState.avail_w = w_val
                }
            }
            IfCondition GreaterThan(mw_val, 0) ThenBlock: {
                IfCondition LessThan(mw_val, LYState.avail_w) ThenBlock: {
                    blk_constrained = 1
                    LYState.avail_w = mw_val
                }
            }
            // Check margin:auto (center the block)
            IfCondition EqualTo(blk_constrained, 1) ThenBlock: {
                m_auto = 0
                // Check inline margin
                IfCondition NotEqual(ws_str, 0) ThenBlock: {
                    ma_idx = StringIndexOf(ws_str, "margin")
                    IfCondition GreaterEqual(ma_idx, 0) ThenBlock: {
                        ma_slen = StringLength(ws_str)
                        ma_rule = CSS_ParseInline(ws_str, ma_slen)
                        IfCondition GreaterEqual(ma_rule, 0) ThenBlock: {
                            ma_v = CSS_GetPropVal(ma_rule, "margin")
                            IfCondition NotEqual(ma_v, 0) ThenBlock: {
                                IfCondition GreaterEqual(StringIndexOf(ma_v, "auto"), 0) ThenBlock: {
                                    m_auto = 1
                                }
                            }
                        }
                    }
                }
                // Check CSS rules for margin
                IfCondition EqualTo(m_auto, 0) ThenBlock: {
                    m_css = LY__CSSLookupProp(node, "margin")
                    IfCondition NotEqual(m_css, 0) ThenBlock: {
                        IfCondition GreaterEqual(StringIndexOf(m_css, "auto"), 0) ThenBlock: {
                            m_auto = 1
                        }
                    }
                }
                // Apply centering
                IfCondition EqualTo(m_auto, 1) ThenBlock: {
                    extra = Subtract(sv_aw, LYState.avail_w)
                    IfCondition GreaterThan(extra, 0) ThenBlock: {
                        LYState.indent = Add(LYState.indent, Divide(extra, 2))
                    }
                }
            }

            // Apply margin-top + margin-left
            LYState.cursor_y = Add(LYState.cursor_y, margin_top)
            IfCondition GreaterThan(margin_left, 0) ThenBlock: {
                LYState.indent = Add(LYState.indent, margin_left)
                LYState.avail_w = Subtract(LYState.avail_w, margin_left)
            }
            IfCondition GreaterThan(margin_right, 0) ThenBlock: {
                LYState.avail_w = Subtract(LYState.avail_w, margin_right)
            }

            // Resolve CSS height (explicit height on block element)
            h_val = 0
            IfCondition NotEqual(ws_str, 0) ThenBlock: {
                hs_idx = StringIndexOf(ws_str, "height")
                IfCondition GreaterEqual(hs_idx, 0) ThenBlock: {
                    hs_slen = StringLength(ws_str)
                    hs_rule = CSS_ParseInline(ws_str, hs_slen)
                    IfCondition GreaterEqual(hs_rule, 0) ThenBlock: {
                        h_cv = CSS_GetPropVal(hs_rule, "height")
                        IfCondition NotEqual(h_cv, 0) ThenBlock: {
                            h_val = LY__ParsePx(h_cv)
                        }
                    }
                }
            }
            IfCondition EqualTo(h_val, 0) ThenBlock: {
                h_css = LY__CSSLookupProp(node, "height")
                IfCondition NotEqual(h_css, 0) ThenBlock: {
                    h_val = LY__ParsePx(h_css)
                }
            }
            // Also check min-height
            minh_val = 0
            minh_css = LY__CSSLookupProp(node, "min-height")
            IfCondition NotEqual(minh_css, 0) ThenBlock: {
                minh_val = LY__ParsePx(minh_css)
            }

            // Resolve border widths for all 4 sides
            bdr_top = LY__ResolveBorderWidth(node, 0)
            bdr_right = LY__ResolveBorderWidth(node, 1)
            bdr_bottom = LY__ResolveBorderWidth(node, 2)
            bdr_left = LY__ResolveBorderWidth(node, 3)

            // Save border-box start position (after margin, before border)
            border_start_y = LYState.cursor_y
            border_start_x = LYState.indent

            // Apply border + padding — per-side indent and avail width
            IfCondition GreaterThan(bdr_left, 0) ThenBlock: {
                LYState.indent = Add(LYState.indent, bdr_left)
                LYState.avail_w = Subtract(LYState.avail_w, bdr_left)
            }
            IfCondition GreaterThan(bdr_right, 0) ThenBlock: {
                LYState.avail_w = Subtract(LYState.avail_w, bdr_right)
            }
            IfCondition GreaterThan(bdr_top, 0) ThenBlock: {
                LYState.cursor_y = Add(LYState.cursor_y, bdr_top)
            }
            IfCondition GreaterThan(pad_left, 0) ThenBlock: {
                LYState.indent = Add(LYState.indent, pad_left)
                LYState.avail_w = Subtract(LYState.avail_w, pad_left)
            }
            IfCondition GreaterThan(pad_right, 0) ThenBlock: {
                LYState.avail_w = Subtract(LYState.avail_w, pad_right)
            }
            IfCondition GreaterThan(pad_top, 0) ThenBlock: {
                LYState.cursor_y = Add(LYState.cursor_y, pad_top)
            }

            // Save content start Y for background rect
            block_start_y = LYState.cursor_y
            // Reset cursor_x for inline text flow within this block
            LYState.cursor_x = LYState.indent

            // Special: <hr> draws a line
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "hr"), 0) ThenBlock: {
                    LY__EmitDrawLine(LYState.indent, LYState.cursor_y, LYState.avail_w, LYConst.COLOR_GRAY)
                    LYState.cursor_y = Add(LYState.cursor_y, 2)
                }
            }

            // Check if this is a flex container
            is_flex = 0
            IfCondition NotEqual(css_disp, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(css_disp, "flex"), 0) ThenBlock: {
                    is_flex = 1
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline-flex"), 0) ThenBlock: {
                    is_flex = 1
                }
            }
            // Also check inline style for display:flex
            IfCondition EqualTo(is_flex, 0) ThenBlock: {
                fl_style = DOM_GetAttr(node, "style")
                IfCondition NotEqual(fl_style, 0) ThenBlock: {
                    IfCondition GreaterEqual(StringIndexOf(fl_style, "flex"), 0) ThenBlock: {
                        fl_slen = StringLength(fl_style)
                        fl_rule = CSS_ParseInline(fl_style, fl_slen)
                        IfCondition GreaterEqual(fl_rule, 0) ThenBlock: {
                            fl_dv = CSS_GetPropVal(fl_rule, "display")
                            IfCondition NotEqual(fl_dv, 0) ThenBlock: {
                                IfCondition EqualTo(StringCompare(fl_dv, "flex"), 0) ThenBlock: {
                                    is_flex = 1
                                }
                                IfCondition EqualTo(StringCompare(fl_dv, "inline-flex"), 0) ThenBlock: {
                                    is_flex = 1
                                }
                            }
                        }
                    }
                }
            }

            // Process children — flex or normal flow
            IfCondition EqualTo(is_flex, 1) ThenBlock: {
                LY__FlexLayout(node)
            }
            IfCondition EqualTo(is_flex, 0) ThenBlock: {
                // Normal block flow — get next sibling BEFORE recursing
                bc = DOM_GetFirstChild(node)
                WhileLoop GreaterEqual(bc, 0) {
                    next_bc = DOM_GetNextSib(bc)
                    LY__LayoutNode(bc)
                    bc = next_bc
                }
            }

            // Flush trailing inline content on the current line
            IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
                end_fh = LY__LineHeight()
                LYState.cursor_y = Add(LYState.cursor_y, end_fh)
                LYState.cursor_x = LYState.indent
            }

            // Compute content height — use explicit CSS height if set
            content_h = Subtract(LYState.cursor_y, block_start_y)
            IfCondition GreaterThan(h_val, 0) ThenBlock: {
                // Explicit height: override content height
                IfCondition GreaterThan(h_val, content_h) ThenBlock: {
                    content_h = h_val
                    LYState.cursor_y = Add(block_start_y, h_val)
                }
            }
            IfCondition GreaterThan(minh_val, 0) ThenBlock: {
                // Min-height: ensure at least this tall
                IfCondition GreaterThan(minh_val, content_h) ThenBlock: {
                    content_h = minh_val
                    LYState.cursor_y = Add(block_start_y, minh_val)
                }
            }

            // Emit background rect now that we know height
            block_x = Subtract(LYState.indent, pad_left)
            block_w = Add(LYState.avail_w, Add(pad_left, pad_right))
            IfCondition NotEqual(bg, LYConst.COLOR_TRANSP) ThenBlock: {
                IfCondition GreaterThan(content_h, 0) ThenBlock: {
                    LY__EmitFillRect(block_x, block_start_y, block_w, content_h, bg)
                }
            }

            // Apply padding-bottom
            IfCondition GreaterThan(pad_bottom, 0) ThenBlock: {
                LYState.cursor_y = Add(LYState.cursor_y, pad_bottom)
            }

            // Emit border rects (4 thin FILL_RECTs around the border-box)
            has_border = Or(GreaterThan(bdr_top, 0), Or(GreaterThan(bdr_right, 0), Or(GreaterThan(bdr_bottom, 0), GreaterThan(bdr_left, 0))))
            IfCondition EqualTo(has_border, 1) ThenBlock: {
                // Compute border-box dimensions
                bdr_box_x = border_start_x
                bdr_box_y = border_start_y
                bdr_box_w = Add(LYState.avail_w, Add(pad_left, Add(pad_right, Add(bdr_left, bdr_right))))
                bdr_box_h = Add(Subtract(LYState.cursor_y, border_start_y), bdr_bottom)

                // Resolve border color (default to currentColor / fg)
                bdr_color = LY__ResolveBorderColor(node, 0)
                IfCondition EqualTo(bdr_color, 0) ThenBlock: {
                    bdr_color = fg
                }

                // Top border
                IfCondition GreaterThan(bdr_top, 0) ThenBlock: {
                    LY__EmitFillRect(bdr_box_x, bdr_box_y, bdr_box_w, bdr_top, bdr_color)
                }
                // Bottom border
                IfCondition GreaterThan(bdr_bottom, 0) ThenBlock: {
                    LY__EmitFillRect(bdr_box_x, Add(bdr_box_y, Subtract(bdr_box_h, bdr_bottom)), bdr_box_w, bdr_bottom, bdr_color)
                }
                // Left border
                IfCondition GreaterThan(bdr_left, 0) ThenBlock: {
                    LY__EmitFillRect(bdr_box_x, bdr_box_y, bdr_left, bdr_box_h, bdr_color)
                }
                // Right border
                IfCondition GreaterThan(bdr_right, 0) ThenBlock: {
                    LY__EmitFillRect(Add(bdr_box_x, Subtract(bdr_box_w, bdr_right)), bdr_box_y, bdr_right, bdr_box_h, bdr_color)
                }
            }

            // Apply border-bottom to cursor
            IfCondition GreaterThan(bdr_bottom, 0) ThenBlock: {
                LYState.cursor_y = Add(LYState.cursor_y, bdr_bottom)
            }

            // Apply margin-bottom
            LYState.cursor_y = Add(LYState.cursor_y, margin_bottom)

            // Restore parent state from stack locals
            LYState.fg_color = sv_fg
            LYState.bg_color = sv_bg
            LYState.font_scale = sv_sc
            LYState.indent = sv_ind
            LYState.avail_w = sv_aw
            LYState.text_align = sv_ta
            LYState.visible = sv_vis
            LYState.line_height = sv_lh
            LYState.font_size_px = sv_fspx
            LYState.font_w_px = sv_fwpx
            LYState.is_ahem = sv_ahem
            LYState.cursor_x = sv_ind
            ReturnValue(0)
        }

        // INLINE element — process children with possible color change
        IfCondition EqualTo(disp, LYDisp.INLINE) ThenBlock: {
            sv_fg2 = LYState.fg_color
            sv_vis2 = LYState.visible

            // Apply visibility:hidden for inline elements
            IfCondition EqualTo(is_visible, 0) ThenBlock: {
                LYState.visible = 0
            }

            fg2 = LY__ResolveFgColor(node)
            LYState.fg_color = fg2

            // Special: <br> — line break
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "br"), 0) ThenBlock: {
                    font_h = LY__LineHeight()
                    LYState.cursor_y = Add(LYState.cursor_y, font_h)
                    LYState.cursor_x = LYState.indent
                }
            }

            // Special: <input> — render as visible text box
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "input"), 0) ThenBlock: {
                    in_type = DOM_GetAttr(node, "type")
                    in_hidden = 0
                    IfCondition NotEqual(in_type, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(in_type, "hidden"), 0) ThenBlock: {
                            in_hidden = 1
                        }
                    }
                    IfCondition EqualTo(in_hidden, 0) ThenBlock: {
                        // Determine if button-style or text-style
                        in_is_btn = 0
                        IfCondition NotEqual(in_type, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(in_type, "submit"), 0) ThenBlock: { in_is_btn = 1 }
                            IfCondition EqualTo(StringCompare(in_type, "button"), 0) ThenBlock: { in_is_btn = 1 }
                            IfCondition EqualTo(StringCompare(in_type, "reset"), 0) ThenBlock: { in_is_btn = 1 }
                        }
                        IfCondition EqualTo(in_is_btn, 1) ThenBlock: {
                            // Button: draw filled rect with label text
                            in_val = DOM_GetAttr(node, "value")
                            IfCondition EqualTo(in_val, 0) ThenBlock: { in_val = "Submit" }
                            in_tlen = StringLength(in_val)
                            in_bw = Add(Multiply(in_tlen, 8), 16)
                            // Position at cursor_x (inline flow)
                            in_x = LYState.cursor_x
                            // Wrap if doesn't fit
                            in_re = Add(LYState.indent, LYState.avail_w)
                            IfCondition GreaterThan(Add(in_x, in_bw), in_re) ThenBlock: {
                                IfCondition GreaterThan(in_x, LYState.indent) ThenBlock: {
                                    LYState.cursor_y = Add(LYState.cursor_y, 28)
                                    in_x = LYState.indent
                                }
                            }
                            // Button background (light gray)
                            LY__EmitFillRect(in_x, LYState.cursor_y, in_bw, 24, 4293388263)
                            // Border (dark gray)
                            LY__EmitDrawLine(in_x, LYState.cursor_y, in_bw, LYConst.COLOR_GRAY)
                            LY__EmitDrawLine(in_x, Add(LYState.cursor_y, 23), in_bw, LYConst.COLOR_GRAY)
                            // Record hit-region for click
                            LY__AddHitRegion(in_x, LYState.cursor_y, in_bw, 24, node, LYHitType.BUTTON)
                            // Text
                            LYTmp.ptr = in_val
                            LY__EmitDrawText(Add(in_x, 8), Add(LYState.cursor_y, 4), in_tlen, LYConst.COLOR_BLACK)
                            // Advance cursor_x past button (inline flow)
                            LYState.cursor_x = Add(in_x, Add(in_bw, 4))
                        } ElseBlock: {
                            // Text input: draw bordered rect with placeholder
                            in_ph = DOM_GetAttr(node, "placeholder")
                            in_val = DOM_GetAttr(node, "value")
                            in_w = 240
                            // Check size attribute
                            in_sz = DOM_GetAttr(node, "size")
                            IfCondition NotEqual(in_sz, 0) ThenBlock: {
                                in_szv = LY__ParsePx(in_sz)
                                IfCondition GreaterThan(in_szv, 0) ThenBlock: {
                                    in_w = Multiply(in_szv, 8)
                                }
                            }
                            // Also check CSS width from inline style
                            in_wstr = DOM_GetAttr(node, "style")
                            IfCondition NotEqual(in_wstr, 0) ThenBlock: {
                                IfCondition GreaterEqual(StringIndexOf(in_wstr, "width"), 0) ThenBlock: {
                                    in_wslen = StringLength(in_wstr)
                                    in_wrule = CSS_ParseInline(in_wstr, in_wslen)
                                    IfCondition GreaterEqual(in_wrule, 0) ThenBlock: {
                                        in_wcss = CSS_GetPropVal(in_wrule, "width")
                                        IfCondition NotEqual(in_wcss, 0) ThenBlock: {
                                            in_wpx = LY__ParsePx(in_wcss)
                                            IfCondition GreaterThan(in_wpx, 0) ThenBlock: {
                                                in_w = in_wpx
                                            }
                                        }
                                    }
                                }
                            }
                            // Position at cursor_x (inline flow)
                            in_x = LYState.cursor_x
                            // Wrap if doesn't fit
                            in_re = Add(LYState.indent, LYState.avail_w)
                            IfCondition GreaterThan(Add(in_x, in_w), in_re) ThenBlock: {
                                IfCondition GreaterThan(in_x, LYState.indent) ThenBlock: {
                                    LYState.cursor_y = Add(LYState.cursor_y, 28)
                                    in_x = LYState.indent
                                }
                            }
                            // Clamp width to available space
                            IfCondition GreaterThan(in_w, LYState.avail_w) ThenBlock: {
                                in_w = LYState.avail_w
                            }
                            // White background
                            LY__EmitFillRect(in_x, LYState.cursor_y, in_w, 24, LYConst.COLOR_WHITE)
                            // Border lines (top, bottom)
                            LY__EmitDrawLine(in_x, LYState.cursor_y, in_w, LYConst.COLOR_GRAY)
                            LY__EmitDrawLine(in_x, Add(LYState.cursor_y, 23), in_w, LYConst.COLOR_GRAY)
                            // Record hit-region for click focus
                            LY__AddHitRegion(in_x, LYState.cursor_y, in_w, 24, node, LYHitType.INPUT)
                            // Placeholder or value text
                            in_txt = in_val
                            in_clr = LYConst.COLOR_BLACK
                            IfCondition EqualTo(in_txt, 0) ThenBlock: {
                                in_txt = in_ph
                                in_clr = LYConst.COLOR_GRAY
                            }
                            IfCondition NotEqual(in_txt, 0) ThenBlock: {
                                in_tl = StringLength(in_txt)
                                IfCondition GreaterThan(in_tl, 0) ThenBlock: {
                                    LYTmp.ptr = in_txt
                                    LY__EmitDrawText(Add(in_x, 4), Add(LYState.cursor_y, 4), in_tl, in_clr)
                                }
                            }
                            // Advance cursor_x past input (inline flow)
                            LYState.cursor_x = Add(in_x, Add(in_w, 4))
                        }
                    }
                }
            }

            // Special: <select> — render as dropdown box
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "select"), 0) ThenBlock: {
                    // Draw a compact dropdown-like box
                    sel_w = 160
                    LY__EmitFillRect(LYState.indent, LYState.cursor_y, sel_w, 24, LYConst.COLOR_WHITE)
                    LY__EmitDrawLine(LYState.indent, LYState.cursor_y, sel_w, LYConst.COLOR_GRAY)
                    LY__EmitDrawLine(LYState.indent, Add(LYState.cursor_y, 23), sel_w, LYConst.COLOR_GRAY)
                    // Draw dropdown arrow indicator
                    LYTmp.ptr = "v"
                    LY__EmitDrawText(Add(LYState.indent, Subtract(sel_w, 12)), Add(LYState.cursor_y, 4), 1, LYConst.COLOR_GRAY)
                    LYState.cursor_y = Add(LYState.cursor_y, 28)
                    // Skip children (option elements)
                    LYState.fg_color = sv_fg2
                    LYState.visible = sv_vis2
                    ReturnValue(0)
                }
            }

            // Special: <textarea> — render as multi-line text box with input support
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "textarea"), 0) ThenBlock: {
                    ta_w = 400
                    ta_h = 24
                    // Google uses textarea with rows="1" — treat as single-line input
                    ta_rows = DOM_GetAttr(node, "rows")
                    IfCondition NotEqual(ta_rows, 0) ThenBlock: {
                        ta_rv = LY__ParsePx(ta_rows)
                        IfCondition GreaterThan(ta_rv, 1) ThenBlock: {
                            ta_h = Multiply(ta_rv, 16)
                        }
                    }
                    // Center if text-align: center
                    ta_x = LYState.indent
                    IfCondition EqualTo(LYState.text_align, 1) ThenBlock: {
                        IfCondition LessThan(ta_w, LYState.avail_w) ThenBlock: {
                            ta_x = Add(LYState.indent, Divide(Subtract(LYState.avail_w, ta_w), 2))
                        }
                    }
                    // White background
                    LY__EmitFillRect(ta_x, LYState.cursor_y, ta_w, ta_h, LYConst.COLOR_WHITE)
                    // Border
                    LY__EmitDrawLine(ta_x, LYState.cursor_y, ta_w, LYConst.COLOR_GRAY)
                    LY__EmitDrawLine(ta_x, Add(LYState.cursor_y, Subtract(ta_h, 1)), ta_w, LYConst.COLOR_GRAY)
                    // Record hit-region for click focus (same as text input)
                    LY__AddHitRegion(ta_x, LYState.cursor_y, ta_w, ta_h, node, LYHitType.INPUT)
                    // Show placeholder or value text
                    ta_ph = DOM_GetAttr(node, "placeholder")
                    ta_val = DOM_GetAttr(node, "value")
                    ta_txt = ta_val
                    ta_clr = LYConst.COLOR_BLACK
                    IfCondition EqualTo(ta_txt, 0) ThenBlock: {
                        ta_txt = ta_ph
                        ta_clr = LYConst.COLOR_GRAY
                    }
                    IfCondition NotEqual(ta_txt, 0) ThenBlock: {
                        ta_tl = StringLength(ta_txt)
                        IfCondition GreaterThan(ta_tl, 0) ThenBlock: {
                            LYTmp.ptr = ta_txt
                            LY__EmitDrawText(Add(ta_x, 4), Add(LYState.cursor_y, 4), ta_tl, ta_clr)
                        }
                    }
                    LYState.cursor_y = Add(LYState.cursor_y, Add(ta_h, 4))
                    // Skip children — textarea content is the value, not child nodes
                    LYState.fg_color = sv_fg2
                    LYState.visible = sv_vis2
                    ReturnValue(0)
                }
            }

            // Special: <button> — render as button
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "button"), 0) ThenBlock: {
                    // Save cursor, process children to get text, then wrap in button box
                    btn_y = LYState.cursor_y
                    // Button background
                    LY__EmitFillRect(LYState.indent, btn_y, 120, 24, 4293388263)
                    LY__EmitDrawLine(LYState.indent, btn_y, 120, LYConst.COLOR_GRAY)
                    LY__EmitDrawLine(LYState.indent, Add(btn_y, 23), 120, LYConst.COLOR_GRAY)
                    // Record hit-region for click
                    LY__AddHitRegion(LYState.indent, btn_y, 120, 24, node, LYHitType.BUTTON)
                    // Offset text inside button
                    LYState.indent = Add(LYState.indent, 8)
                    LYState.cursor_y = Add(LYState.cursor_y, 4)

                    ic = DOM_GetFirstChild(node)
                    WhileLoop GreaterEqual(ic, 0) {
                        next_ic = DOM_GetNextSib(ic)
                        LY__LayoutNode(ic)
                        ic = next_ic
                    }

                    LYState.indent = Subtract(LYState.indent, 8)
                    LYState.cursor_y = Add(btn_y, 28)
                    LYState.fg_color = sv_fg2
                    LYState.visible = sv_vis2
                    ReturnValue(0)
                }
            }

            // Special: <img> — render placeholder with alt text
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "img"), 0) ThenBlock: {
                    img_alt = DOM_GetAttr(node, "alt")
                    img_w = 64
                    img_h = 20
                    // Try to get dimensions
                    img_ws = DOM_GetAttr(node, "width")
                    IfCondition NotEqual(img_ws, 0) ThenBlock: {
                        img_wv = LY__ParsePx(img_ws)
                        IfCondition GreaterThan(img_wv, 0) ThenBlock: { img_w = img_wv }
                    }
                    img_hs = DOM_GetAttr(node, "height")
                    IfCondition NotEqual(img_hs, 0) ThenBlock: {
                        img_hv = LY__ParsePx(img_hs)
                        IfCondition GreaterThan(img_hv, 0) ThenBlock: { img_h = img_hv }
                    }
                    // Only show if it has alt text and reasonable size
                    IfCondition NotEqual(img_alt, 0) ThenBlock: {
                        alt_len = StringLength(img_alt)
                        IfCondition GreaterThan(alt_len, 0) ThenBlock: {
                            LYTmp.ptr = img_alt
                            LY__EmitDrawText(LYState.indent, LYState.cursor_y, alt_len, LYConst.COLOR_GRAY)
                            LYState.cursor_y = Add(LYState.cursor_y, 18)
                        }
                    }
                }
            }

            // Table cell padding: emit a space separator between <td>/<th> cells
            IfCondition NotEqual(tag, 0) ThenBlock: {
                td_sep = 0
                IfCondition EqualTo(StringCompare(tag, "td"), 0) ThenBlock: { td_sep = 1 }
                IfCondition EqualTo(StringCompare(tag, "th"), 0) ThenBlock: { td_sep = 1 }
                IfCondition EqualTo(td_sep, 1) ThenBlock: {
                    LYTmp.ptr = "  "
                    LY__EmitText(LYTmp.ptr, 2, LYState.fg_color)
                }
            }

            // Record hit-region for <a> links before processing children
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "a"), 0) ThenBlock: {
                    // Estimate width from first text child
                    link_w = 80
                    link_fc = DOM_GetFirstChild(node)
                    IfCondition GreaterEqual(link_fc, 0) ThenBlock: {
                        link_tl = DOM_GetTextLen(link_fc)
                        IfCondition GreaterThan(link_tl, 0) ThenBlock: {
                            link_w = Multiply(link_tl, LYState.font_w_px)
                        }
                    }
                    LY__AddHitRegion(LYState.cursor_x, LYState.cursor_y, link_w, 16, node, LYHitType.LINK)
                }
            }

            // Process children — get next sibling BEFORE recursing
            ic = DOM_GetFirstChild(node)
            WhileLoop GreaterEqual(ic, 0) {
                next_ic = DOM_GetNextSib(ic)
                LY__LayoutNode(ic)
                ic = next_ic
            }

            LYState.fg_color = sv_fg2
            LYState.visible = sv_vis2
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// PUBLIC API — RUN LAYOUT
// =============================================================================
Function.Layout_Run {
    Input: dom_root: Integer
    Output: Integer
    Body: {
        Layout_Reset()

        // Layout all nodes
        LY__LayoutNode(dom_root)

        LYState.content_h = LYState.cursor_y
        ReturnValue(LYState.cmd_count)
    }
}

// =============================================================================
// PUBLIC ACCESSORS
// =============================================================================
Function.Layout_CmdCount {
    Output: Integer
    Body: { ReturnValue(LYState.cmd_count) }
}

Function.Layout_ContentHeight {
    Output: Integer
    Body: { ReturnValue(LYState.content_h) }
}

Function.Layout_CmdType {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_TYPE)) }
}

Function.Layout_CmdX {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_X)) }
}

Function.Layout_CmdY {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_Y)) }
}

Function.Layout_CmdW {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_W)) }
}

Function.Layout_CmdH {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_H)) }
}

Function.Layout_CmdColor {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_COLOR)) }
}

Function.Layout_CmdPtr {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_PTR)) }
}

// =============================================================================
// DEBUG — dump all commands
// =============================================================================
Function.Layout_Dump {
    Body: {
        PrintMessage("[LAYOUT] commands: ")
        PrintNumber(LYState.cmd_count)
        PrintMessage("  content_h: ")
        PrintNumber(LYState.content_h)
        PrintMessage("\n")

        di = 0
        WhileLoop LessThan(di, LYState.cmd_count) {
            ct = LY__CmdGet(di, LYConst.C_TYPE)
            cx = LY__CmdGet(di, LYConst.C_X)
            cy = LY__CmdGet(di, LYConst.C_Y)
            cw = LY__CmdGet(di, LYConst.C_W)

            IfCondition EqualTo(ct, LYCmd.FILL_RECT) ThenBlock: {
                PrintMessage("  FILL_RECT x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" w=")
                PrintNumber(cw)
                ch = LY__CmdGet(di, LYConst.C_H)
                PrintMessage(" h=")
                PrintNumber(ch)
                PrintMessage("\n")
            }

            IfCondition EqualTo(ct, LYCmd.DRAW_TEXT) ThenBlock: {
                PrintMessage("  DRAW_TEXT x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" len=")
                PrintNumber(cw)
                cp = LY__CmdGet(di, LYConst.C_PTR)
                IfCondition NotEqual(cp, 0) ThenBlock: {
                    PrintMessage(" '")
                    PrintMessage(cp)
                    PrintMessage("'")
                }
                PrintMessage("\n")
            }

            IfCondition EqualTo(ct, LYCmd.DRAW_LINE) ThenBlock: {
                PrintMessage("  DRAW_LINE x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" w=")
                PrintNumber(cw)
                PrintMessage("\n")
            }

            di = Add(di, 1)
        }
    }
}
