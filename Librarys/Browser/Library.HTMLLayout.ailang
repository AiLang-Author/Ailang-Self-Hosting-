// Library.HTMLLayout.ailang — Simple block-level HTML layout engine
// Walks DOM tree, resolves CSS styles, produces flat draw command list.
// Vertical block stacking with inline text flow (word wrap).
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutColors
LibraryImport.Browser.HTMLLayoutCSS
LibraryImport.Browser.HTMLLayoutFlex
LibraryImport.Browser.HTMLLayoutEngine

// =============================================================================
// DISPLAY TYPES
// =============================================================================
FixedPool.LYDisp {
    "BLOCK":     Initialize=1
    "INLINE":    Initialize=2
    "NONE":      Initialize=3
    "TEXT":       Initialize=4
}

// =============================================================================
// DRAW COMMAND TYPES
// =============================================================================
FixedPool.LYCmd {
    "FILL_RECT":  Initialize=1
    "DRAW_TEXT":  Initialize=2
    "DRAW_LINE":  Initialize=3
    "DRAW_IMAGE": Initialize=4
}

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.LYConst {
    "MAX_CMDS":    Initialize=8192
    "CMD_SIZE":    Initialize=56    // 7 fields x 8 bytes
    // Command field offsets
    "C_TYPE":      Initialize=0
    "C_X":         Initialize=8
    "C_Y":         Initialize=16
    "C_W":         Initialize=24
    "C_H":         Initialize=32
    "C_COLOR":     Initialize=40
    "C_PTR":       Initialize=48   // text pointer or pixel pointer
    // Font metrics (TermFont 8x16)
    "FONT_W":      Initialize=8
    "FONT_H":      Initialize=16
    // Default colors (BGRA: B + G*256 + R*65536 + A*16777216)
    "COLOR_BLACK":    Initialize=4278190080  // 0xFF000000 R=0,G=0,B=0
    "COLOR_WHITE":    Initialize=4294967295  // 0xFFFFFFFF R=255,G=255,B=255
    "COLOR_BG":       Initialize=4293848050  // 0xFFF2F0F0 #f0f0f2
    "COLOR_LINK":     Initialize=4278190335  // 0xFF0000FF R=0,G=0,B=255 (blue)
    "COLOR_GRAY":     Initialize=4286611584  // 0xFF808080
    "COLOR_TRANSP":   Initialize=0           // transparent
    // Heading sizes (line heights in multiples of FONT_H)
    "H1_SCALE":    Initialize=2    // 32px = 2x16
    "H2_SCALE":    Initialize=2    // 24px ~= 1.5x16, use 2 for simplicity
    "H3_SCALE":    Initialize=1    // 20px ~= 1x16
    "DEFAULT_MARGIN": Initialize=16
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.LYState {
    "cmd_pool":     Initialize=0
    "cmd_count":    Initialize=0
    "viewport_w":   Initialize=1024
    "viewport_h":   Initialize=700
    "cursor_x":     Initialize=0
    "cursor_y":     Initialize=0
    "content_h":    Initialize=0    // total content height after layout
    "indent":       Initialize=0    // current left indent (from nested blocks)
    "avail_w":      Initialize=1024 // current available width
    "fg_color":     Initialize=255  // current text color (black default)
    "bg_color":     Initialize=0    // current bg color (transparent)
    "font_scale":   Initialize=1    // current font scale factor
    "in_pre":       Initialize=0    // inside <pre> block
    "text_align":   Initialize=0    // 0=left, 1=center, 2=right
    "show_noscript": Initialize=0   // 1=render <noscript> content (JS failed)
    "visible":       Initialize=1   // 0=visibility:hidden (layout preserved, no paint)
    "line_height":   Initialize=0   // line-height in px (0=default: FONT_H * font_scale)
    "font_size_px":  Initialize=16  // actual font size in pixels (from CSS font-size)
    "font_w_px":     Initialize=8   // glyph advance width in pixels (8 for TermFont, font_size_px for Ahem)
    "is_ahem":       Initialize=0   // 1 if current font-family is Ahem
    // Hit-test regions for interactive elements
    "hit_pool":     Initialize=0
    "hit_count":    Initialize=0
    // Diagnostic counters (reset each Layout_Run)
    "dbg_nodes":     Initialize=0   // total nodes visited
    "dbg_blocks":    Initialize=0   // block elements processed
    "dbg_inlines":   Initialize=0   // inline elements processed
    "dbg_texts":     Initialize=0   // text nodes processed
    "dbg_none":      Initialize=0   // display:none skipped
    "dbg_hidden":    Initialize=0   // visibility:hidden
    "dbg_floats":    Initialize=0   // float elements detected
    "dbg_fl_chk":    Initialize=0   // blocks where float was checked
    "dbg_visit":     Initialize=0   // total LY__LayoutNode calls
    "last_margin_b": Initialize=0   // previous sibling's margin-bottom (for collapsing)
}

// =============================================================================
// HIT-TEST REGION TYPES AND CONSTANTS
// =============================================================================
FixedPool.LYHit {
    "MAX_REGIONS":  Initialize=256
    "REGION_SIZE":  Initialize=48   // 6 fields x 8 bytes
    // Field offsets
    "H_X":          Initialize=0
    "H_Y":          Initialize=8
    "H_W":          Initialize=16
    "H_H":          Initialize=24
    "H_NODE":       Initialize=32   // DOM node index
    "H_TYPE":       Initialize=40   // 1=text_input, 2=button/submit, 3=link
}

FixedPool.LYHitType {
    "INPUT":    Initialize=1
    "BUTTON":   Initialize=2
    "LINK":     Initialize=3
}

// =============================================================================
// FLEXBOX STATE
// =============================================================================
FixedPool.LYFlex {
    "pool":         Initialize=0    // flex item data buffer
    "count":        Initialize=0    // number of flex items this pass
    "MAX_ITEMS":    Initialize=128  // max flex children per container
    "ITEM_SIZE":    Initialize=48   // 6 fields × 8 bytes per item
    // Per-item field offsets
    "I_NODE":       Initialize=0    // DOM node index
    "I_MEAS_W":     Initialize=8    // measured width
    "I_MEAS_H":     Initialize=16   // measured height
    "I_CMD_START":  Initialize=24   // first command index
    "I_CMD_COUNT":  Initialize=32   // number of commands emitted
    "I_GROW":       Initialize=40   // flex-grow (integer, default 0)
}

FixedPool.LYFlexTmp {
    "dir":       Initialize=0    // 0=row, 1=column
    "justify":   Initialize=0    // 0=start, 1=end, 2=center, 3=space-between, 4=space-around
    "align":     Initialize=0    // 0=stretch, 1=start, 2=end, 3=center
    "gap":       Initialize=0    // gap in pixels
    "wrap":      Initialize=0    // 0=nowrap, 1=wrap
    "total_main": Initialize=0   // sum of children's main-axis sizes
    "free_space": Initialize=0   // remaining space after children placed
    "total_grow": Initialize=0   // sum of flex-grow values
    "item_i":    Initialize=0    // iterator for flex items
}

// =============================================================================
// GRID STATE
// =============================================================================
FixedPool.LYGridTmp {
    "num_cols":    Initialize=0    // resolved number of columns
    "col_gap":     Initialize=0    // column-gap in px
    "row_gap":     Initialize=0    // row-gap in px
    "total_fr":    Initialize=0    // sum of all fr values across columns
    "fixed_total": Initialize=0    // sum of all fixed-px columns
    "item_i":      Initialize=0    // iterator
}

FixedPool.LYGridTrack {
    "pool":        Initialize=0    // buffer for column defs: 12 entries x 16 bytes = 192 bytes
    "MAX_COLS":    Initialize=12   // max columns supported
    "ENTRY_SIZE":  Initialize=16   // 2 fields x 8 bytes per track: [type(8), value(8)]
    "T_TYPE":      Initialize=0    // 0=fixed_px, 1=fr
    "T_VALUE":     Initialize=8    // px value or fr multiplier
}

// =============================================================================
// FLOAT STATE — tracks active CSS float:left/right boxes
// =============================================================================
FixedPool.LYFloatState {
    "count":      Initialize=0    // number of active floats
    "max":        Initialize=64   // max simultaneous floats
    "pool":       Initialize=0    // flat buffer: 64 entries x 40 bytes = 2560 bytes
    // Per-float field offsets (40 bytes per entry)
    "F_DIR":      Initialize=0    // 1=left, 2=right
    "F_X":        Initialize=8    // x position of float box
    "F_Y":        Initialize=16   // y position (top) of float box
    "F_W":        Initialize=24   // width of float box
    "F_H":        Initialize=32   // height (bottom = F_Y + F_H)
    "ENTRY_SIZE": Initialize=40
}

// =============================================================================
// CSS RULE MATCHING TEMPORARIES (separate pool to avoid clobbering LYTmp)
// =============================================================================
FixedPool.LYCss {
    "ri":        Initialize=0
    "rcount":    Initialize=0
    "matched":   Initialize=0
    "result":    Initialize=0
    "tag":       Initialize=0
    "cls":       Initialize=0
    "id":        Initialize=0
    "val":       Initialize=0
    "best":      Initialize=0
    "spec":      Initialize=0
    "ci":        Initialize=0
    "clen":      Initialize=0
    "nlen":      Initialize=0
    "wstart":    Initialize=0
    "cmb_node":  Initialize=0
    "cmb_depth": Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.LYTmp {
    "idx":       Initialize=0
    "type":      Initialize=0
    "tag":       Initialize=0
    "tag_len":   Initialize=0
    "text":      Initialize=0
    "text_len":  Initialize=0
    "disp":      Initialize=0
    "child":     Initialize=0
    "x":         Initialize=0
    "y":         Initialize=0
    "w":         Initialize=0
    "h":         Initialize=0
    "color":     Initialize=0
    "val":       Initialize=0
    "ptr":       Initialize=0
    "save_x":    Initialize=0
    "save_y":    Initialize=0
    "save_w":    Initialize=0
    "save_fg":   Initialize=0
    "save_bg":   Initialize=0
    "save_sc":   Initialize=0
    "save_ind":  Initialize=0
    "ns_addr":   Initialize=0    // dedicated for CmdSet/CmdGet
    "ch":        Initialize=0
    "line_x":    Initialize=0
    "line_w":    Initialize=0
    "word_st":   Initialize=0
    "ci":        Initialize=0
}

// =============================================================================
// INIT / RESET
// =============================================================================
Function.Layout_Init {
    Output: Integer
    Body: {
        // Only allocate once — guard against repeated calls leaking memory
        IfCondition NotEqual(LYState.cmd_pool, 0) ThenBlock: {
            Layout_Reset()
            ReturnValue(1)
        }

        csz = Multiply(LYConst.MAX_CMDS, LYConst.CMD_SIZE)
        LYState.cmd_pool = Allocate(csz)
        IfCondition EqualTo(LYState.cmd_pool, 0) ThenBlock: {
            PrintMessage("[LAYOUT] alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(LYState.cmd_pool, 0, csz)
        LYState.cmd_count = 0

        // Allocate hit-test region pool
        hsz = Multiply(LYHit.MAX_REGIONS, LYHit.REGION_SIZE)
        LYState.hit_pool = Allocate(hsz)
        IfCondition EqualTo(LYState.hit_pool, 0) ThenBlock: {
            PrintMessage("[LAYOUT] hit pool alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(LYState.hit_pool, 0, hsz)
        LYState.hit_count = 0

        // Allocate flex item pool
        fsz = Multiply(LYFlex.MAX_ITEMS, LYFlex.ITEM_SIZE)
        LYFlex.pool = Allocate(fsz)
        IfCondition EqualTo(LYFlex.pool, 0) ThenBlock: {
            PrintMessage("[LAYOUT] flex pool alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(LYFlex.pool, 0, fsz)
        LYFlex.count = 0

        // Allocate grid track pool (12 columns x 16 bytes = 192 bytes)
        gsz = Multiply(LYGridTrack.MAX_COLS, LYGridTrack.ENTRY_SIZE)
        LYGridTrack.pool = Allocate(gsz)
        IfCondition EqualTo(LYGridTrack.pool, 0) ThenBlock: {
            PrintMessage("[LAYOUT] grid track pool alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(LYGridTrack.pool, 0, gsz)

        // Allocate float tracking pool (64 entries x 40 bytes = 2560 bytes)
        float_sz = Multiply(LYFloatState.max, LYFloatState.ENTRY_SIZE)
        LYFloatState.pool = Allocate(float_sz)
        IfCondition EqualTo(LYFloatState.pool, 0) ThenBlock: {
            PrintMessage("[LAYOUT] float pool alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(LYFloatState.pool, 0, float_sz)
        LYFloatState.count = 0

        // Inject UA stylesheet — default styles for all HTML elements
        // This fires once on first Layout_Init (before any page CSS)
        LY__InjectUAStyles()

        ReturnValue(1)
    }
}

// =============================================================================
// UA STYLESHEET — inject default styles for standard HTML elements
// Must be called AFTER CSS_Init() and BEFORE any CSS_ParseSheet for page CSS.
// The CSS cascade ensures page CSS overrides these (lower specificity).
// =============================================================================
Function.LY__InjectUAStyles {
    Body: {
        ua = "html,body{display:block;margin:0}body{margin:8px}h1{display:block;font-size:32px;margin-top:21px;margin-bottom:21px}h2{display:block;font-size:24px;margin-top:19px;margin-bottom:19px}h3{display:block;font-size:18px;margin-top:18px;margin-bottom:18px}h4{display:block;margin-top:21px;margin-bottom:21px}h5{display:block;margin-top:22px;margin-bottom:22px}h6{display:block;margin-top:24px;margin-bottom:24px}p{display:block;margin-top:16px;margin-bottom:16px}div{display:block}ul,ol{display:block;margin-top:16px;margin-bottom:16px;padding-left:40px}li{display:block}pre{display:block;margin-top:16px;margin-bottom:16px}blockquote{display:block;margin-top:16px;margin-bottom:16px;margin-left:40px;margin-right:40px}hr{display:block;margin-top:8px;margin-bottom:8px;border-top:1px solid #ccc}table{display:block}form{display:block}header,footer,main,section,article,nav,aside{display:block}figure{display:block;margin-top:16px;margin-bottom:16px;margin-left:40px;margin-right:40px}figcaption{display:block}fieldset{display:block;margin-left:2px;margin-right:2px;padding-top:8px;padding-bottom:12px;padding-left:12px;padding-right:12px;border:2px solid #ccc}a{color:#0000ee}span,em,strong,b,i,u,s,code,small,big,sub,sup{display:inline}dd{margin-left:40px}dt{display:block}"
        ua_len = StringLength(ua)
        ua_rules = CSS_ParseSheet(ua, ua_len)
        PrintMessage("[LAYOUT] UA stylesheet: ")
        PrintNumber(ua_rules)
        PrintMessage(" rules\n")
    }
}

Function.Layout_Reset {
    Body: {
        LYState.cmd_count = 0
        LYState.hit_count = 0
        LYState.cursor_x = 0
        LYState.cursor_y = 0
        LYState.content_h = 0
        LYState.indent = 0
        LYState.avail_w = LYState.viewport_w
        LYState.fg_color = LYConst.COLOR_BLACK
        LYState.bg_color = LYConst.COLOR_TRANSP
        LYState.font_scale = 1
        LYState.in_pre = 0
        LYState.text_align = 0
        LYState.visible = 1
        LYState.line_height = 0
        LYState.font_size_px = 16
        LYState.font_w_px = 8
        LYState.is_ahem = 0
        // Reset diagnostic counters
        LYState.dbg_nodes = 0
        LYState.dbg_blocks = 0
        LYState.dbg_inlines = 0
        LYState.dbg_texts = 0
        LYState.dbg_none = 0
        LYState.dbg_hidden = 0
        LYState.dbg_floats = 0
        LYState.dbg_fl_chk = 0
        LYState.dbg_visit = 0
        LYState.last_margin_b = 0
        // Reset float tracking
        LYFloatState.count = 0
    }
}

// =============================================================================
// COMMAND POOL HELPERS
// =============================================================================
Function.LY__CmdAddr {
    Input: idx: Integer
    Output: Address
    Body: {
        ReturnValue(Add(LYState.cmd_pool, Multiply(idx, LYConst.CMD_SIZE)))
    }
}

Function.LY__CmdSet {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        LYTmp.ns_addr = LY__CmdAddr(idx)
        StoreValue(Add(LYTmp.ns_addr, field), val)
    }
}

Function.LY__CmdGet {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        LYTmp.ns_addr = LY__CmdAddr(idx)
        ReturnValue(Dereference(Add(LYTmp.ns_addr, field)))
    }
}

// =============================================================================
// EMIT DRAW COMMANDS
// =============================================================================
Function.LY__EmitFillRect {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(LYState.visible, 0) ThenBlock: { ReturnValue(0) }
        idx = LYState.cmd_count
        IfCondition GreaterEqual(idx, LYConst.MAX_CMDS) ThenBlock: { ReturnValue(0) }
        LYState.cmd_count = Add(idx, 1)
        LY__CmdSet(idx, LYConst.C_TYPE, LYCmd.FILL_RECT)
        LY__CmdSet(idx, LYConst.C_X, x)
        LY__CmdSet(idx, LYConst.C_Y, y)
        LY__CmdSet(idx, LYConst.C_W, w)
        LY__CmdSet(idx, LYConst.C_H, h)
        LY__CmdSet(idx, LYConst.C_COLOR, color)
    }
}

// Note: 6-arg limit means we need to split text emit
// Store text pointer in LYTmp.ptr before calling
Function.LY__EmitDrawText {
    Input: x: Integer
    Input: y: Integer
    Input: len: Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(LYState.visible, 0) ThenBlock: { ReturnValue(0) }
        idx = LYState.cmd_count
        IfCondition GreaterEqual(idx, LYConst.MAX_CMDS) ThenBlock: { ReturnValue(0) }
        LYState.cmd_count = Add(idx, 1)
        LY__CmdSet(idx, LYConst.C_TYPE, LYCmd.DRAW_TEXT)
        LY__CmdSet(idx, LYConst.C_X, x)
        LY__CmdSet(idx, LYConst.C_Y, y)
        LY__CmdSet(idx, LYConst.C_W, len)
        LY__CmdSet(idx, LYConst.C_H, LYState.font_w_px)
        LY__CmdSet(idx, LYConst.C_COLOR, color)
        LY__CmdSet(idx, LYConst.C_PTR, LYTmp.ptr)
    }
}

Function.LY__EmitDrawLine {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(LYState.visible, 0) ThenBlock: { ReturnValue(0) }
        idx = LYState.cmd_count
        IfCondition GreaterEqual(idx, LYConst.MAX_CMDS) ThenBlock: { ReturnValue(0) }
        LYState.cmd_count = Add(idx, 1)
        LY__CmdSet(idx, LYConst.C_TYPE, LYCmd.DRAW_LINE)
        LY__CmdSet(idx, LYConst.C_X, x)
        LY__CmdSet(idx, LYConst.C_Y, y)
        LY__CmdSet(idx, LYConst.C_W, w)
        LY__CmdSet(idx, LYConst.C_COLOR, color)
    }
}

// =============================================================================
// LINE HEIGHT HELPER
// =============================================================================
// Returns effective line height in pixels: CSS line-height if set, else FONT_H * font_scale
Function.LY__LineHeight {
    Output: Integer
    Body: {
        IfCondition GreaterThan(LYState.line_height, 0) ThenBlock: {
            ReturnValue(LYState.line_height)
        }
        // Ahem font: line height = font_size_px (1em = font_size_px)
        IfCondition EqualTo(LYState.is_ahem, 1) ThenBlock: {
            ReturnValue(LYState.font_size_px)
        }
        ReturnValue(Multiply(LYConst.FONT_H, LYState.font_scale))
    }
}

// =============================================================================
// HIT-REGION RECORDING + LOOKUP
// =============================================================================
Function.LY__AddHitRegion {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: node: Integer
    Input: htype: Integer
    Body: {
        IfCondition GreaterEqual(LYState.hit_count, LYHit.MAX_REGIONS) ThenBlock: { ReturnValue(0) }
        off = Multiply(LYState.hit_count, LYHit.REGION_SIZE)
        base = Add(LYState.hit_pool, off)
        StoreValue(Add(base, LYHit.H_X), x)
        StoreValue(Add(base, LYHit.H_Y), y)
        StoreValue(Add(base, LYHit.H_W), w)
        StoreValue(Add(base, LYHit.H_H), h)
        StoreValue(Add(base, LYHit.H_NODE), node)
        StoreValue(Add(base, LYHit.H_TYPE), htype)
        LYState.hit_count = Add(LYState.hit_count, 1)
    }
}

// Hit-test: find which interactive region contains (px, py)
// Returns region index or -1
Function.Layout_HitTest {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        hi = 0
        WhileLoop LessThan(hi, LYState.hit_count) {
            off = Multiply(hi, LYHit.REGION_SIZE)
            base = Add(LYState.hit_pool, off)
            hx = Dereference(Add(base, LYHit.H_X))
            hy = Dereference(Add(base, LYHit.H_Y))
            hw = Dereference(Add(base, LYHit.H_W))
            hh = Dereference(Add(base, LYHit.H_H))
            IfCondition And(And(GreaterEqual(px, hx), LessThan(px, Add(hx, hw))),
                           And(GreaterEqual(py, hy), LessThan(py, Add(hy, hh)))) ThenBlock: {
                ReturnValue(hi)
            }
            hi = Add(hi, 1)
        }
        ReturnValue(-1)
    }
}

Function.Layout_HitNode {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        off = Multiply(idx, LYHit.REGION_SIZE)
        base = Add(LYState.hit_pool, off)
        ReturnValue(Dereference(Add(base, LYHit.H_NODE)))
    }
}

Function.Layout_HitType {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        off = Multiply(idx, LYHit.REGION_SIZE)
        base = Add(LYState.hit_pool, off)
        ReturnValue(Dereference(Add(base, LYHit.H_TYPE)))
    }
}

Function.Layout_HitCount {
    Output: Integer
    Body: { ReturnValue(LYState.hit_count) }
}

// =============================================================================
// DISPLAY TYPE CLASSIFICATION
// =============================================================================
Function.LY__GetDisplay {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }

        // NONE — skip entirely
        IfCondition EqualTo(StringCompare(tag, "head"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "script"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "style"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "meta"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "link"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "title"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "noscript"), 0) ThenBlock: {
            IfCondition EqualTo(LYState.show_noscript, 1) ThenBlock: {
                ReturnValue(LYDisp.BLOCK)
            }
            ReturnValue(LYDisp.NONE)
        }
        IfCondition EqualTo(StringCompare(tag, "template"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(tag, "svg"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }

        // BLOCK elements
        IfCondition EqualTo(StringCompare(tag, "html"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "body"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "div"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "p"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h1"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h2"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h3"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h4"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h5"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "h6"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "ul"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "ol"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "li"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "header"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "footer"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "main"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "section"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "article"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "nav"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "aside"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "blockquote"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "pre"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "hr"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "form"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "table"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "thead"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "tbody"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "tfoot"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "tr"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "caption"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "center"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "figure"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "figcaption"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "details"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "fieldset"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "legend"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "summary"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "address"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "dd"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "dt"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "dl"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "dialog"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "hgroup"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(tag, "search"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }

        // Everything else is INLINE
        ReturnValue(LYDisp.INLINE)
    }
}

