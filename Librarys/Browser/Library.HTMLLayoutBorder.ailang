LibraryImport.StringUtils
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutUnits
LibraryImport.Browser.HTMLLayoutColors

// =============================================================================
// BORDER SHORTHAND — parse "1px solid #ccc" into width/style/color
// Also resolves per-side border-width from shorthand or individual properties
// =============================================================================
FixedPool.LYBorder {
    "width":   Initialize=0
    "color":   Initialize=0
}

// Parse border shorthand: "1px solid #ccc" or "1px solid" or "none"
// Stores width in LYBorder.width, color in LYBorder.color
// Strategy: scan chars for digit (width) and '#' (hex color)
Function.LY__ParseBorderShorthand {
    Input: str: Address
    Body: {
        LYBorder.width = 0
        LYBorder.color = 0
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(str)
        IfCondition EqualTo(slen, 0) ThenBlock: { ReturnValue(0) }

        // "none" or "0" means no border
        IfCondition EqualTo(StringCompare(str, "none"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(str, "0"), 0) ThenBlock: { ReturnValue(0) }

        // Scan for width: first digit character → parse from that position
        // LY__ParsePx reads digits until non-digit, so passing str ptr at digit start works
        pos = 0
        WhileLoop LessThan(pos, slen) {
            ch = Dereference(Add(str, pos), "byte")
            // Digit 0-9: parse width from this position
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                LYBorder.width = LY__ParsePx(Add(str, pos))
                pos = slen // break
            } ElseBlock: {
                pos = Add(pos, 1)
            }
        }

        // Scan for color: '#' character → parse from that position
        pos = 0
        WhileLoop LessThan(pos, slen) {
            ch = Dereference(Add(str, pos), "byte")
            IfCondition EqualTo(ch, 35) ThenBlock: {
                LYBorder.color = LY__ParseColor(Add(str, pos))
                pos = slen // break
            } ElseBlock: {
                pos = Add(pos, 1)
            }
        }

        // Check for explicit "transparent" keyword before trying named colors
        IfCondition GreaterEqual(StringIndexOf(str, "transparent"), 0) ThenBlock: {
            LYBorder.color = -1  // sentinel: explicitly transparent
        }

        // If no hex color found, try parsing the whole string as a color
        // (handles "border: 1px solid red" where color is a named color)
        IfCondition EqualTo(LYBorder.color, 0) ThenBlock: {
            // Try each space-separated word as a potential color name
            // Skip style keywords (solid, dashed, dotted, double, groove, ridge, inset, outset, none, hidden)
            // Skip size keywords (thin, medium, thick) and numbers
            wpos = 0
            w_found = 0
            WhileLoop And(LessThan(wpos, slen), EqualTo(w_found, 0)) {
                // Skip whitespace
                ws_skip_done = 0
                WhileLoop And(LessThan(wpos, slen), EqualTo(ws_skip_done, 0)) {
                    wch = Dereference(Add(str, wpos), "byte")
                    IfCondition EqualTo(wch, 32) ThenBlock: { wpos = Add(wpos, 1) }
                    ElseBlock: { ws_skip_done = 1 }
                }
                IfCondition LessThan(wpos, slen) ThenBlock: {
                    // Find end of word
                    wend = wpos
                    wend_done = 0
                    WhileLoop And(LessThan(wend, slen), EqualTo(wend_done, 0)) {
                        wech = Dereference(Add(str, wend), "byte")
                        IfCondition EqualTo(wech, 32) ThenBlock: { wend_done = 1 }
                        ElseBlock: { wend = Add(wend, 1) }
                    }
                    // Extract word
                    wlen = Subtract(wend, wpos)
                    IfCondition GreaterThan(wlen, 0) ThenBlock: {
                        word_ptr = Add(str, wpos)
                        first_ch = Dereference(word_ptr, "byte")
                        // Skip digits (size values) and '#' (already handled)
                        is_skip = 0
                        IfCondition And(GreaterEqual(first_ch, 48), LessEqual(first_ch, 57)) ThenBlock: { is_skip = 1 }
                        IfCondition EqualTo(first_ch, 35) ThenBlock: { is_skip = 1 }
                        IfCondition EqualTo(is_skip, 0) ThenBlock: {
                            // Try as color — extract word to temp buffer
                            word_buf = Allocate(Add(wlen, 1))
                            MemoryCopy(word_buf, word_ptr, wlen)
                            StoreValue(Add(word_buf, wlen), 0, "byte")
                            // Skip border-style keywords
                            is_style = 0
                            IfCondition EqualTo(StringCompare(word_buf, "solid"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "dashed"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "dotted"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "double"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "groove"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "ridge"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "inset"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "outset"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "none"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "hidden"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "thin"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "medium"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "thick"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(is_style, 0) ThenBlock: {
                                try_color = LY__ParseColor(word_buf)
                                IfCondition NotEqual(try_color, 0) ThenBlock: {
                                    LYBorder.color = try_color
                                    w_found = 1
                                }
                            }
                        }
                    }
                    wpos = wend
                }
            }
        }

        // Check for named keywords: thin/medium/thick (if no digit width found)
        IfCondition EqualTo(LYBorder.width, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(str, "thin"), 0) ThenBlock: {
                LYBorder.width = 1
            }
            IfCondition GreaterEqual(StringIndexOf(str, "medium"), 0) ThenBlock: {
                LYBorder.width = 3
            }
            IfCondition GreaterEqual(StringIndexOf(str, "thick"), 0) ThenBlock: {
                LYBorder.width = 5
            }
        }
        // CSS spec: border shorthand with no explicit width defaults to medium (3px)
        IfCondition EqualTo(LYBorder.width, 0) ThenBlock: {
            LYBorder.width = 3
        }
    }
}

// Resolve border-width for a given side (0=top, 1=right, 2=bottom, 3=left)
Function.LY__ResolveBorderWidth {
    Input: node: Integer
    Input: side: Integer
    Output: Integer
    Body: {
        // Individual property name
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "border-top-width" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "border-right-width" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "border-bottom-width" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "border-left-width" }

        // Check inline style
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "border"), 0) ThenBlock: {
                bslen = StringLength(style_str)
                brule = CSS_ParseInline(style_str, bslen)
                IfCondition GreaterEqual(brule, 0) ThenBlock: {
                    // Try individual side width
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        bv = CSS_GetPropVal(brule, side_prop)
                        IfCondition NotEqual(bv, 0) ThenBlock: {
                            bv_px = LY__ParsePx(bv)
                            IfCondition NotEqual(bv_px, -999999) ThenBlock: {
                                ReturnValue(bv_px)
                            }
                        }
                    }
                    // Try border-width shorthand (1/2/3/4 values like margin)
                    bw = CSS_GetPropVal(brule, "border-width")
                    IfCondition NotEqual(bw, 0) ThenBlock: {
                        LY__ParseBoxShorthand(bw)
                        IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
                        IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
                        IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
                        IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
                    }
                    // Try border shorthand
                    bsh = CSS_GetPropVal(brule, "border")
                    IfCondition NotEqual(bsh, 0) ThenBlock: {
                        LY__ParseBorderShorthand(bsh)
                        ReturnValue(LYBorder.width)
                    }
                }
            }
        }

        // Check CSS stylesheet rules — individual property
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_bw = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_bw, 0) ThenBlock: {
                css_bw_px = LY__ParsePx(css_bw)
                IfCondition NotEqual(css_bw_px, -999999) ThenBlock: {
                    ReturnValue(css_bw_px)
                }
            }
        }

        // Check CSS logical border properties (LTR assumed)
        blog_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { blog_prop = "border-block-start-width" }
        IfCondition EqualTo(side, 1) ThenBlock: { blog_prop = "border-inline-end-width" }
        IfCondition EqualTo(side, 2) ThenBlock: { blog_prop = "border-block-end-width" }
        IfCondition EqualTo(side, 3) ThenBlock: { blog_prop = "border-inline-start-width" }
        IfCondition NotEqual(blog_prop, 0) ThenBlock: {
            css_blog = LY__CSSLookupProp(node, blog_prop)
            IfCondition NotEqual(css_blog, 0) ThenBlock: {
                css_blog_px = LY__ParsePx(css_blog)
                IfCondition NotEqual(css_blog_px, -999999) ThenBlock: {
                    ReturnValue(css_blog_px)
                }
            }
        }
        // Logical border-width shorthands: border-block-width, border-inline-width
        bwlog_sh = 0
        IfCondition Or(EqualTo(side, 0), EqualTo(side, 2)) ThenBlock: { bwlog_sh = "border-block-width" }
        IfCondition Or(EqualTo(side, 1), EqualTo(side, 3)) ThenBlock: { bwlog_sh = "border-inline-width" }
        IfCondition NotEqual(bwlog_sh, 0) ThenBlock: {
            css_bwlsh = LY__CSSLookupProp(node, bwlog_sh)
            IfCondition NotEqual(css_bwlsh, 0) ThenBlock: {
                css_bwlsh_px = LY__ParsePx(css_bwlsh)
                IfCondition NotEqual(css_bwlsh_px, -999999) ThenBlock: {
                    ReturnValue(css_bwlsh_px)
                }
            }
        }
        // Logical border shorthands: border-block, border-inline (like "border: 1px solid red")
        bslog_sh = 0
        IfCondition Or(EqualTo(side, 0), EqualTo(side, 2)) ThenBlock: { bslog_sh = "border-block" }
        IfCondition Or(EqualTo(side, 1), EqualTo(side, 3)) ThenBlock: { bslog_sh = "border-inline" }
        IfCondition NotEqual(bslog_sh, 0) ThenBlock: {
            css_bslsh = LY__CSSLookupProp(node, bslog_sh)
            IfCondition NotEqual(css_bslsh, 0) ThenBlock: {
                LY__ParseBorderShorthand(css_bslsh)
                IfCondition GreaterThan(LYBorder.width, 0) ThenBlock: {
                    ReturnValue(LYBorder.width)
                }
            }
        }

        // Check CSS stylesheet — border-width shorthand
        css_bwsh = LY__CSSLookupProp(node, "border-width")
        IfCondition NotEqual(css_bwsh, 0) ThenBlock: {
            LY__ParseBoxShorthand(css_bwsh)
            IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
            IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
            IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
            IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
        }

        // Check CSS stylesheet — border shorthand
        css_bsh = LY__CSSLookupProp(node, "border")
        IfCondition NotEqual(css_bsh, 0) ThenBlock: {
            LY__ParseBorderShorthand(css_bsh)
            ReturnValue(LYBorder.width)
        }

        // CSS spec: if border-style is set (not none/hidden) but no width was found,
        // use the initial value "medium" (3px).
        // Check per-side border-style, border-style shorthand, then border-*-style logical
        bstyle_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { bstyle_prop = "border-top-style" }
        IfCondition EqualTo(side, 1) ThenBlock: { bstyle_prop = "border-right-style" }
        IfCondition EqualTo(side, 2) ThenBlock: { bstyle_prop = "border-bottom-style" }
        IfCondition EqualTo(side, 3) ThenBlock: { bstyle_prop = "border-left-style" }
        bstyle_val = 0
        // Check inline style for border-style
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "border"), 0) ThenBlock: {
                bsslen = StringLength(style_str)
                bsrule = CSS_ParseInline(style_str, bsslen)
                IfCondition GreaterEqual(bsrule, 0) ThenBlock: {
                    IfCondition NotEqual(bstyle_prop, 0) ThenBlock: {
                        bstyle_val = CSS_GetPropVal(bsrule, bstyle_prop)
                    }
                    IfCondition EqualTo(bstyle_val, 0) ThenBlock: {
                        bstyle_val = CSS_GetPropVal(bsrule, "border-style")
                    }
                }
            }
        }
        // Check CSS rules for border-style
        IfCondition EqualTo(bstyle_val, 0) ThenBlock: {
            IfCondition NotEqual(bstyle_prop, 0) ThenBlock: {
                bstyle_val = LY__CSSLookupProp(node, bstyle_prop)
            }
        }
        IfCondition EqualTo(bstyle_val, 0) ThenBlock: {
            bstyle_val = LY__CSSLookupProp(node, "border-style")
        }
        // Logical border-style properties
        IfCondition EqualTo(bstyle_val, 0) ThenBlock: {
            bslog = 0
            IfCondition EqualTo(side, 0) ThenBlock: { bslog = "border-block-start-style" }
            IfCondition EqualTo(side, 1) ThenBlock: { bslog = "border-inline-end-style" }
            IfCondition EqualTo(side, 2) ThenBlock: { bslog = "border-block-end-style" }
            IfCondition EqualTo(side, 3) ThenBlock: { bslog = "border-inline-start-style" }
            IfCondition NotEqual(bslog, 0) ThenBlock: {
                bstyle_val = LY__CSSLookupProp(node, bslog)
            }
        }
        IfCondition EqualTo(bstyle_val, 0) ThenBlock: {
            bslogs = 0
            IfCondition Or(EqualTo(side, 0), EqualTo(side, 2)) ThenBlock: { bslogs = "border-block-style" }
            IfCondition Or(EqualTo(side, 1), EqualTo(side, 3)) ThenBlock: { bslogs = "border-inline-style" }
            IfCondition NotEqual(bslogs, 0) ThenBlock: {
                bstyle_val = LY__CSSLookupProp(node, bslogs)
            }
        }
        // If a visible style is set, return medium (3px)
        IfCondition NotEqual(bstyle_val, 0) ThenBlock: {
            IfCondition NotEqual(StringCompare(bstyle_val, "none"), 0) ThenBlock: {
                IfCondition NotEqual(StringCompare(bstyle_val, "hidden"), 0) ThenBlock: {
                    ReturnValue(3)
                }
            }
        }

        ReturnValue(0)
    }
}

// Resolve border-color for a given side
Function.LY__ResolveBorderColor {
    Input: node: Integer
    Input: side: Integer
    Output: Integer
    Body: {
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "border-top-color" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "border-right-color" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "border-bottom-color" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "border-left-color" }

        // Check inline style
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "border"), 0) ThenBlock: {
                bslen = StringLength(style_str)
                brule = CSS_ParseInline(style_str, bslen)
                IfCondition GreaterEqual(brule, 0) ThenBlock: {
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        bv = CSS_GetPropVal(brule, side_prop)
                        IfCondition NotEqual(bv, 0) ThenBlock: {
                            ReturnValue(LY__ParseColor(bv))
                        }
                    }
                    bsh = CSS_GetPropVal(brule, "border")
                    IfCondition NotEqual(bsh, 0) ThenBlock: {
                        LY__ParseBorderShorthand(bsh)
                        IfCondition NotEqual(LYBorder.color, 0) ThenBlock: {
                            ReturnValue(LYBorder.color)
                        }
                    }
                }
            }
        }

        // CSS rules — individual
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_bc = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_bc, 0) ThenBlock: {
                ReturnValue(LY__ParseColor(css_bc))
            }
        }

        // CSS logical border-color properties (LTR assumed)
        bclog_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { bclog_prop = "border-block-start-color" }
        IfCondition EqualTo(side, 1) ThenBlock: { bclog_prop = "border-inline-end-color" }
        IfCondition EqualTo(side, 2) ThenBlock: { bclog_prop = "border-block-end-color" }
        IfCondition EqualTo(side, 3) ThenBlock: { bclog_prop = "border-inline-start-color" }
        IfCondition NotEqual(bclog_prop, 0) ThenBlock: {
            css_bclog = LY__CSSLookupProp(node, bclog_prop)
            IfCondition NotEqual(css_bclog, 0) ThenBlock: {
                ReturnValue(LY__ParseColor(css_bclog))
            }
        }
        // Logical border-color shorthands: border-block-color, border-inline-color
        bclog_sh = 0
        IfCondition Or(EqualTo(side, 0), EqualTo(side, 2)) ThenBlock: { bclog_sh = "border-block-color" }
        IfCondition Or(EqualTo(side, 1), EqualTo(side, 3)) ThenBlock: { bclog_sh = "border-inline-color" }
        IfCondition NotEqual(bclog_sh, 0) ThenBlock: {
            css_bcsh = LY__CSSLookupProp(node, bclog_sh)
            IfCondition NotEqual(css_bcsh, 0) ThenBlock: {
                ReturnValue(LY__ParseColor(css_bcsh))
            }
        }
        // Logical border shorthands: border-block, border-inline → extract color
        bclog_full = 0
        IfCondition Or(EqualTo(side, 0), EqualTo(side, 2)) ThenBlock: { bclog_full = "border-block" }
        IfCondition Or(EqualTo(side, 1), EqualTo(side, 3)) ThenBlock: { bclog_full = "border-inline" }
        IfCondition NotEqual(bclog_full, 0) ThenBlock: {
            css_bcf = LY__CSSLookupProp(node, bclog_full)
            IfCondition NotEqual(css_bcf, 0) ThenBlock: {
                LY__ParseBorderShorthand(css_bcf)
                IfCondition NotEqual(LYBorder.color, 0) ThenBlock: {
                    ReturnValue(LYBorder.color)
                }
            }
        }

        // CSS rules — shorthand
        css_bsh = LY__CSSLookupProp(node, "border")
        IfCondition NotEqual(css_bsh, 0) ThenBlock: {
            LY__ParseBorderShorthand(css_bsh)
            IfCondition NotEqual(LYBorder.color, 0) ThenBlock: {
                ReturnValue(LYBorder.color)
            }
        }

        // Default: use foreground color
        ReturnValue(LYState.fg_color)
    }
}

// =============================================================================
// BACKGROUND SHORTHAND — extract background-color from "background" property
// "background: #fff url(...) no-repeat" → returns #fff color
// =============================================================================
Function.LY__ResolveBackgroundColor {
    Input: node: Integer
    Output: Integer
    Body: {
        // Already checked background-color directly in LY__ResolveBgColor
        // This handles the "background" shorthand property
        bg_sh = 0

        // Check inline style
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "background"), 0) ThenBlock: {
                bslen = StringLength(style_str)
                brule = CSS_ParseInline(style_str, bslen)
                IfCondition GreaterEqual(brule, 0) ThenBlock: {
                    bg_sh = CSS_GetPropVal(brule, "background")
                }
            }
        }

        // Check CSS rules
        IfCondition EqualTo(bg_sh, 0) ThenBlock: {
            bg_sh = LY__CSSLookupProp(node, "background")
        }

        IfCondition NotEqual(bg_sh, 0) ThenBlock: {
            // Try to extract a color from the shorthand
            // The color is typically the first token that looks like a color
            first_ch = Dereference(bg_sh, "byte")
            // Hex color
            IfCondition EqualTo(first_ch, 35) ThenBlock: {
                ReturnValue(LY__ParseColor(bg_sh))
            }
            // Named color or rgb(...)
            c = LY__ParseColor(bg_sh)
            IfCondition NotEqual(c, 0) ThenBlock: {
                ReturnValue(c)
            }
        }

        ReturnValue(LYConst.COLOR_TRANSP)
    }
}

