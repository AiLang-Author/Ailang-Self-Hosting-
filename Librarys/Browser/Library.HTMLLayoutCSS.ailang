LibraryImport.StringUtils
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutColors

Function.LY__ClassContains {
    Input: class_attr: Address
    Input: target: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(class_attr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }

        LYCss.clen = StringLength(class_attr)
        LYCss.nlen = StringLength(target)
        IfCondition EqualTo(LYCss.clen, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LYCss.nlen, 0) ThenBlock: { ReturnValue(0) }

        // Exact match (single class)
        IfCondition EqualTo(StringCompare(class_attr, target), 0) ThenBlock: {
            ReturnValue(1)
        }

        // Walk space-separated words
        LYCss.ci = 0
        WhileLoop LessEqual(LYCss.ci, LYCss.clen) {
            // Skip spaces
            WhileLoop LessThan(LYCss.ci, LYCss.clen) {
                IfCondition EqualTo(GetByte(class_attr, LYCss.ci), 32) ThenBlock: {
                    LYCss.ci = Add(LYCss.ci, 1)
                } ElseBlock: {
                    BreakLoop
                }
            }
            IfCondition GreaterEqual(LYCss.ci, LYCss.clen) ThenBlock: { ReturnValue(0) }

            // Start of word
            LYCss.wstart = LYCss.ci
            // Find end of word
            WhileLoop LessThan(LYCss.ci, LYCss.clen) {
                IfCondition NotEqual(GetByte(class_attr, LYCss.ci), 32) ThenBlock: {
                    LYCss.ci = Add(LYCss.ci, 1)
                } ElseBlock: {
                    BreakLoop
                }
            }
            // Compare word length and content
            wlen = Subtract(LYCss.ci, LYCss.wstart)
            IfCondition EqualTo(wlen, LYCss.nlen) ThenBlock: {
                wmatch = 1
                wi = 0
                WhileLoop LessThan(wi, wlen) {
                    c1 = GetByte(class_attr, Add(LYCss.wstart, wi))
                    c2 = GetByte(target, wi)
                    IfCondition NotEqual(c1, c2) ThenBlock: {
                        wmatch = 0
                        wi = wlen
                    }
                    wi = Add(wi, 1)
                }
                IfCondition EqualTo(wmatch, 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// COMBINATOR MATCHING — check if context selector matches a candidate node
// Returns 1 if sel_type+sel_ptr matches the candidate node's tag/class/id
// =============================================================================
Function.LY__NodeMatchesSel {
    Input: cand: Integer
    Input: sel_type: Integer
    Input: sel_ptr: Address
    Output: Integer
    Body: {
        IfCondition LessEqual(cand, 0) ThenBlock: { ReturnValue(0) }

        // Universal matches everything
        IfCondition EqualTo(sel_type, CSSSelType.UNIVERSAL) ThenBlock: { ReturnValue(1) }

        // TAG match
        IfCondition EqualTo(sel_type, CSSSelType.TAG) ThenBlock: {
            cand_tag = DOM_GetTag(cand)
            IfCondition EqualTo(cand_tag, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(StringCompare(sel_ptr, cand_tag), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }

        // CLASS match
        IfCondition EqualTo(sel_type, CSSSelType.CLASS) ThenBlock: {
            cand_cls = DOM_GetAttr(cand, "class")
            IfCondition EqualTo(cand_cls, 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(LY__ClassContains(cand_cls, sel_ptr))
        }

        // ID match
        IfCondition EqualTo(sel_type, CSSSelType.ID) ThenBlock: {
            cand_id = DOM_GetAttr(cand, "id")
            IfCondition EqualTo(cand_id, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(StringCompare(sel_ptr, cand_id), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// CHECK COMBINATOR — verify that a rule's combinator context matches
// node = the subject element that matched R_SEL_*
// rule = the rule index (has R_CMB_TYPE, R_CMB_SEL_TYPE, R_CMB_SEL_PTR)
// Returns 1 if combinator context satisfied, 0 otherwise
// =============================================================================
Function.LY__CheckCombinator {
    Input: node: Integer
    Input: rule: Integer
    Output: Integer
    Body: {
        cmb_type = CSS_RuleCmbType(rule)
        IfCondition EqualTo(cmb_type, CSSCmb.NONE) ThenBlock: { ReturnValue(1) }

        cmb_sel_type = CSS_RuleCmbSelType(rule)
        cmb_sel_ptr = CSS_RuleCmbSelPtr(rule)

        // CHILD combinator (>): parent must match
        IfCondition EqualTo(cmb_type, CSSCmb.CHILD) ThenBlock: {
            par = DOM_GetParent(node)
            ReturnValue(LY__NodeMatchesSel(par, cmb_sel_type, cmb_sel_ptr))
        }

        // DESCENDANT combinator (space): any ancestor must match
        IfCondition EqualTo(cmb_type, CSSCmb.DESC) ThenBlock: {
            LYCss.cmb_node = DOM_GetParent(node)
            LYCss.cmb_depth = 0
            WhileLoop And(GreaterThan(LYCss.cmb_node, 0), LessThan(LYCss.cmb_depth, 32)) {
                IfCondition EqualTo(LY__NodeMatchesSel(LYCss.cmb_node, cmb_sel_type, cmb_sel_ptr), 1) ThenBlock: {
                    ReturnValue(1)
                }
                LYCss.cmb_node = DOM_GetParent(LYCss.cmb_node)
                LYCss.cmb_depth = Add(LYCss.cmb_depth, 1)
            }
            ReturnValue(0)
        }

        // ADJACENT SIBLING (+): previous sibling must match
        IfCondition EqualTo(cmb_type, CSSCmb.ADJ) ThenBlock: {
            prev = DOM_GetPrevSib(node)
            ReturnValue(LY__NodeMatchesSel(prev, cmb_sel_type, cmb_sel_ptr))
        }

        // GENERAL SIBLING (~): any earlier sibling must match
        IfCondition EqualTo(cmb_type, CSSCmb.GEN) ThenBlock: {
            LYCss.cmb_node = DOM_GetPrevSib(node)
            LYCss.cmb_depth = 0
            WhileLoop And(GreaterThan(LYCss.cmb_node, 0), LessThan(LYCss.cmb_depth, 64)) {
                IfCondition EqualTo(LY__NodeMatchesSel(LYCss.cmb_node, cmb_sel_type, cmb_sel_ptr), 1) ThenBlock: {
                    ReturnValue(1)
                }
                LYCss.cmb_node = DOM_GetPrevSib(LYCss.cmb_node)
                LYCss.cmb_depth = Add(LYCss.cmb_depth, 1)
            }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// CSS RULE LOOKUP — find property value for a DOM node from stylesheet rules
// Iterates all parsed CSS rules, returns value pointer or 0
// =============================================================================
Function.LY__CSSLookupProp {
    Input: node: Integer
    Input: prop: Address
    Output: Address
    Body: {
        LYCss.rcount = CSS_RuleCount()
        IfCondition EqualTo(LYCss.rcount, 0) ThenBlock: { ReturnValue(0) }

        LYCss.tag = DOM_GetTag(node)
        LYCss.cls = DOM_GetAttr(node, "class")
        LYCss.id = DOM_GetAttr(node, "id")

        LYCss.result = 0
        LYCss.best = -1

        LYCss.ri = 0
        WhileLoop LessThan(LYCss.ri, LYCss.rcount) {
            LYCss.matched = 0

            // Skip inline-style rules (UNIVERSAL with specificity >= 1000)
            // These are created by CSS_ParseInline and must NOT match other elements
            LYCss.ri_spec = CSS_RuleSpecificity(LYCss.ri)
            IfCondition GreaterEqual(LYCss.ri_spec, 1000) ThenBlock: {
                LYCss.ri = Add(LYCss.ri, 1)
                ContinueLoop
            }

            // Check tag match
            IfCondition EqualTo(CSS_MatchesTag(LYCss.ri, LYCss.tag), 1) ThenBlock: {
                LYCss.matched = 1
            }

            // Check class match (with space-separated support)
            IfCondition EqualTo(LYCss.matched, 0) ThenBlock: {
                IfCondition NotEqual(LYCss.cls, 0) ThenBlock: {
                    sel_type = CSS_RuleSelType(LYCss.ri)
                    IfCondition EqualTo(sel_type, CSSSelType.CLASS) ThenBlock: {
                        sel_ptr = CSS_RuleSelPtr(LYCss.ri)
                        IfCondition NotEqual(sel_ptr, 0) ThenBlock: {
                            IfCondition EqualTo(LY__ClassContains(LYCss.cls, sel_ptr), 1) ThenBlock: {
                                LYCss.matched = 1
                            }
                        }
                    }
                }
            }

            // Check id match
            IfCondition EqualTo(LYCss.matched, 0) ThenBlock: {
                IfCondition EqualTo(CSS_MatchesId(LYCss.ri, LYCss.id), 1) ThenBlock: {
                    LYCss.matched = 1
                }
            }

            // If subject matched, verify combinator context
            IfCondition EqualTo(LYCss.matched, 1) ThenBlock: {
                IfCondition EqualTo(LY__CheckCombinator(node, LYCss.ri), 0) ThenBlock: {
                    LYCss.matched = 0
                }
            }

            // If fully matched, look up the property — highest specificity wins
            IfCondition EqualTo(LYCss.matched, 1) ThenBlock: {
                LYCss.val = CSS_GetPropVal(LYCss.ri, prop)
                IfCondition NotEqual(LYCss.val, 0) ThenBlock: {
                    LYCss.spec = CSS_RuleSpecificity(LYCss.ri)
                    // Debug: log when width is matched for body
                    IfCondition NotEqual(LYCss.tag, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(LYCss.tag, "body"), 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(prop, "width"), 0) ThenBlock: {
                                PrintMessage("[CSS-MATCH body width] rule=")
                                PrintNumber(LYCss.ri)
                                PrintMessage(" spec=")
                                PrintNumber(LYCss.spec)
                                PrintMessage(" val=")
                                PrintMessage(LYCss.val)
                                PrintMessage(" sel_type=")
                                PrintNumber(CSS_RuleSelType(LYCss.ri))
                                PrintMessage(" sel_ptr=")
                                dbg_sp = CSS_RuleSelPtr(LYCss.ri)
                                IfCondition NotEqual(dbg_sp, 0) ThenBlock: { PrintMessage(dbg_sp) }
                                PrintMessage("\n")
                            }
                        }
                    }
                    // Higher or equal specificity wins (equal = source order)
                    IfCondition GreaterEqual(LYCss.spec, LYCss.best) ThenBlock: {
                        LYCss.best = LYCss.spec
                        LYCss.result = LYCss.val
                    }
                }
            }

            LYCss.ri = Add(LYCss.ri, 1)
        }

        ReturnValue(LYCss.result)
    }
}

// =============================================================================
// STYLE RESOLUTION — get CSS properties for a DOM node
// Uses tag-based defaults + inline style + CSS rule matching
// =============================================================================
Function.LY__ResolveBgColor {
    Input: node: Integer
    Output: Integer
    Body: {
        // Check inline style (highest priority)
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            bg_idx = StringIndexOf(style_str, "background")
            IfCondition GreaterEqual(bg_idx, 0) ThenBlock: {
                slen = StringLength(style_str)
                rule = CSS_ParseInline(style_str, slen)
                IfCondition GreaterEqual(rule, 0) ThenBlock: {
                    bgv = CSS_GetPropVal(rule, "background-color")
                    IfCondition NotEqual(bgv, 0) ThenBlock: {
                        bgv_c = LY__ParseColor(bgv)
                        IfCondition EqualTo(bgv_c, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
                        ReturnValue(bgv_c)
                    }
                    bgv2 = CSS_GetPropVal(rule, "background")
                    IfCondition NotEqual(bgv2, 0) ThenBlock: {
                        bgv2_c = LY__ParseColor(bgv2)
                        IfCondition EqualTo(bgv2_c, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
                        ReturnValue(bgv2_c)
                    }
                }
            }
        }

        // Check CSS stylesheet rules
        css_bg = LY__CSSLookupProp(node, "background-color")
        IfCondition NotEqual(css_bg, 0) ThenBlock: {
            bg_parsed = LY__ParseColor(css_bg)
            IfCondition EqualTo(bg_parsed, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
            ReturnValue(bg_parsed)
        }
        css_bg2 = LY__CSSLookupProp(node, "background")
        IfCondition NotEqual(css_bg2, 0) ThenBlock: {
            bg_parsed2 = LY__ParseColor(css_bg2)
            IfCondition EqualTo(bg_parsed2, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
            ReturnValue(bg_parsed2)
        }

        ReturnValue(LYConst.COLOR_TRANSP)
    }
}

Function.LY__ResolveFgColor {
    Input: node: Integer
    Output: Integer
    Body: {
        tag = DOM_GetTag(node)

        // Check inline style for color (highest priority)
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            col_idx = StringIndexOf(style_str, "color")
            IfCondition GreaterEqual(col_idx, 0) ThenBlock: {
                slen = StringLength(style_str)
                rule = CSS_ParseInline(style_str, slen)
                IfCondition GreaterEqual(rule, 0) ThenBlock: {
                    cv = CSS_GetPropVal(rule, "color")
                    IfCondition NotEqual(cv, 0) ThenBlock: {
                        ReturnValue(LY__ParseColor(cv))
                    }
                }
            }
        }

        // Check CSS stylesheet rules
        css_fg = LY__CSSLookupProp(node, "color")
        IfCondition NotEqual(css_fg, 0) ThenBlock: {
            ReturnValue(LY__ParseColor(css_fg))
        }

        // Default: links are blue (only if no CSS override found)
        IfCondition NotEqual(tag, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(tag, "a"), 0) ThenBlock: {
                ReturnValue(LYConst.COLOR_LINK)
            }
        }

        // Inherit from parent state
        ReturnValue(LYState.fg_color)
    }
}

// =============================================================================
// BOX SHORTHAND PARSING — parse "10px", "10px 20px", "10px 20px 30px 40px"
// Returns individual side values via LYBox FixedPool
// =============================================================================
FixedPool.LYBox {
    "top":     Initialize=0
    "right":   Initialize=0
    "bottom":  Initialize=0
    "left":    Initialize=0
}

// Parse a CSS box shorthand value string into top/right/bottom/left
// Handles 1-value, 2-value, 3-value, and 4-value syntax
Function.LY__ParseBoxShorthand {
    Input: str: Address
    Body: {
        LYBox.top = 0
        LYBox.right = 0
        LYBox.bottom = 0
        LYBox.left = 0
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(str)
        IfCondition EqualTo(slen, 0) ThenBlock: { ReturnValue(0) }

        // Skip "auto" — handled separately by margin:auto logic
        IfCondition GreaterEqual(StringIndexOf(str, "auto"), 0) ThenBlock: {
            ReturnValue(0)
        }

        // Collect up to 4 space-separated values
        // vals[0..3] stored in v1..v4, count in val_count
        v1 = 0
        v2 = 0
        v3 = 0
        v4 = 0
        val_count = 0
        pos = 0

        // Skip leading whitespace — use flag instead of And(NotEqual, NotEqual)
        ws_done = 0
        WhileLoop LessThan(pos, slen) {
            IfCondition NotEqual(ws_done, 0) ThenBlock: { pos = slen }
            IfCondition EqualTo(ws_done, 0) ThenBlock: {
                bch = GetByte(str, pos)
                is_ws = 0
                IfCondition EqualTo(bch, 32) ThenBlock: { is_ws = 1 }
                IfCondition EqualTo(bch, 9) ThenBlock: { is_ws = 1 }
                IfCondition EqualTo(is_ws, 1) ThenBlock: {
                    pos = Add(pos, 1)
                } ElseBlock: {
                    ws_done = 1
                }
            }
        }

        // Parse value 1
        IfCondition LessThan(pos, slen) ThenBlock: {
            bch1 = GetByte(str, pos)
            // Accept digit (48-57), '.' (46), or 'v' (118) — use flags
            bch1_ok = 0
            IfCondition EqualTo(bch1, 46) ThenBlock: { bch1_ok = 1 }
            IfCondition EqualTo(bch1, 118) ThenBlock: { bch1_ok = 1 }
            bch1_isdig = 0
            IfCondition GreaterEqual(bch1, 48) ThenBlock: {
                IfCondition LessEqual(bch1, 57) ThenBlock: {
                    bch1_isdig = 1
                }
            }
            IfCondition EqualTo(bch1_isdig, 1) ThenBlock: { bch1_ok = 1 }
            IfCondition EqualTo(bch1_ok, 1) ThenBlock: {
                v1 = LY__ParsePx(Add(str, pos))
                val_count = 1
                // Skip past this value (non-whitespace chars)
                sk_done = 0
                WhileLoop LessThan(pos, slen) {
                    IfCondition NotEqual(sk_done, 0) ThenBlock: { pos = slen }
                    IfCondition EqualTo(sk_done, 0) ThenBlock: {
                        bsk = GetByte(str, pos)
                        bsk_ws = 0
                        IfCondition EqualTo(bsk, 32) ThenBlock: { bsk_ws = 1 }
                        IfCondition EqualTo(bsk, 9) ThenBlock: { bsk_ws = 1 }
                        IfCondition EqualTo(bsk_ws, 1) ThenBlock: {
                            sk_done = 1
                        } ElseBlock: {
                            pos = Add(pos, 1)
                        }
                    }
                }
                // Skip whitespace after value
                ws2_done = 0
                WhileLoop LessThan(pos, slen) {
                    IfCondition NotEqual(ws2_done, 0) ThenBlock: { pos = slen }
                    IfCondition EqualTo(ws2_done, 0) ThenBlock: {
                        bsp = GetByte(str, pos)
                        bsp_ws = 0
                        IfCondition EqualTo(bsp, 32) ThenBlock: { bsp_ws = 1 }
                        IfCondition EqualTo(bsp, 9) ThenBlock: { bsp_ws = 1 }
                        IfCondition EqualTo(bsp_ws, 1) ThenBlock: {
                            pos = Add(pos, 1)
                        } ElseBlock: {
                            ws2_done = 1
                        }
                    }
                }
            }
        }

        // Parse value 2 — use nested ifs instead of And(LessThan, GreaterEqual)
        IfCondition LessThan(pos, slen) ThenBlock: {
            IfCondition GreaterEqual(val_count, 1) ThenBlock: {
                bch2 = GetByte(str, pos)
                bch2_ok = 0
                IfCondition EqualTo(bch2, 46) ThenBlock: { bch2_ok = 1 }
                IfCondition EqualTo(bch2, 118) ThenBlock: { bch2_ok = 1 }
                bch2_isdig = 0
                IfCondition GreaterEqual(bch2, 48) ThenBlock: {
                    IfCondition LessEqual(bch2, 57) ThenBlock: {
                        bch2_isdig = 1
                    }
                }
                IfCondition EqualTo(bch2_isdig, 1) ThenBlock: { bch2_ok = 1 }
                IfCondition EqualTo(bch2_ok, 1) ThenBlock: {
                    v2 = LY__ParsePx(Add(str, pos))
                    val_count = 2
                    sk2_done = 0
                    WhileLoop LessThan(pos, slen) {
                        IfCondition NotEqual(sk2_done, 0) ThenBlock: { pos = slen }
                        IfCondition EqualTo(sk2_done, 0) ThenBlock: {
                            bsk2 = GetByte(str, pos)
                            bsk2_ws = 0
                            IfCondition EqualTo(bsk2, 32) ThenBlock: { bsk2_ws = 1 }
                            IfCondition EqualTo(bsk2, 9) ThenBlock: { bsk2_ws = 1 }
                            IfCondition EqualTo(bsk2_ws, 1) ThenBlock: {
                                sk2_done = 1
                            } ElseBlock: {
                                pos = Add(pos, 1)
                            }
                        }
                    }
                    ws3_done = 0
                    WhileLoop LessThan(pos, slen) {
                        IfCondition NotEqual(ws3_done, 0) ThenBlock: { pos = slen }
                        IfCondition EqualTo(ws3_done, 0) ThenBlock: {
                            bsp2 = GetByte(str, pos)
                            bsp2_ws = 0
                            IfCondition EqualTo(bsp2, 32) ThenBlock: { bsp2_ws = 1 }
                            IfCondition EqualTo(bsp2, 9) ThenBlock: { bsp2_ws = 1 }
                            IfCondition EqualTo(bsp2_ws, 1) ThenBlock: {
                                pos = Add(pos, 1)
                            } ElseBlock: {
                                ws3_done = 1
                            }
                        }
                    }
                }
            }
        }

        // Parse value 3
        IfCondition LessThan(pos, slen) ThenBlock: {
            IfCondition GreaterEqual(val_count, 2) ThenBlock: {
                bch3 = GetByte(str, pos)
                bch3_ok = 0
                IfCondition EqualTo(bch3, 46) ThenBlock: { bch3_ok = 1 }
                IfCondition EqualTo(bch3, 118) ThenBlock: { bch3_ok = 1 }
                bch3_isdig = 0
                IfCondition GreaterEqual(bch3, 48) ThenBlock: {
                    IfCondition LessEqual(bch3, 57) ThenBlock: {
                        bch3_isdig = 1
                    }
                }
                IfCondition EqualTo(bch3_isdig, 1) ThenBlock: { bch3_ok = 1 }
                IfCondition EqualTo(bch3_ok, 1) ThenBlock: {
                    v3 = LY__ParsePx(Add(str, pos))
                    val_count = 3
                    sk3_done = 0
                    WhileLoop LessThan(pos, slen) {
                        IfCondition NotEqual(sk3_done, 0) ThenBlock: { pos = slen }
                        IfCondition EqualTo(sk3_done, 0) ThenBlock: {
                            bsk3 = GetByte(str, pos)
                            bsk3_ws = 0
                            IfCondition EqualTo(bsk3, 32) ThenBlock: { bsk3_ws = 1 }
                            IfCondition EqualTo(bsk3, 9) ThenBlock: { bsk3_ws = 1 }
                            IfCondition EqualTo(bsk3_ws, 1) ThenBlock: {
                                sk3_done = 1
                            } ElseBlock: {
                                pos = Add(pos, 1)
                            }
                        }
                    }
                    ws4_done = 0
                    WhileLoop LessThan(pos, slen) {
                        IfCondition NotEqual(ws4_done, 0) ThenBlock: { pos = slen }
                        IfCondition EqualTo(ws4_done, 0) ThenBlock: {
                            bsp3 = GetByte(str, pos)
                            bsp3_ws = 0
                            IfCondition EqualTo(bsp3, 32) ThenBlock: { bsp3_ws = 1 }
                            IfCondition EqualTo(bsp3, 9) ThenBlock: { bsp3_ws = 1 }
                            IfCondition EqualTo(bsp3_ws, 1) ThenBlock: {
                                pos = Add(pos, 1)
                            } ElseBlock: {
                                ws4_done = 1
                            }
                        }
                    }
                }
            }
        }

        // Parse value 4
        IfCondition LessThan(pos, slen) ThenBlock: {
            IfCondition GreaterEqual(val_count, 3) ThenBlock: {
                bch4 = GetByte(str, pos)
                bch4_ok = 0
                IfCondition EqualTo(bch4, 46) ThenBlock: { bch4_ok = 1 }
                IfCondition EqualTo(bch4, 118) ThenBlock: { bch4_ok = 1 }
                bch4_isdig = 0
                IfCondition GreaterEqual(bch4, 48) ThenBlock: {
                    IfCondition LessEqual(bch4, 57) ThenBlock: {
                        bch4_isdig = 1
                    }
                }
                IfCondition EqualTo(bch4_isdig, 1) ThenBlock: { bch4_ok = 1 }
                IfCondition EqualTo(bch4_ok, 1) ThenBlock: {
                    v4 = LY__ParsePx(Add(str, pos))
                    val_count = 4
                }
            }
        }

        // Apply CSS box model rules:
        // 1 value:  all sides = v1
        // 2 values: top/bottom = v1, right/left = v2
        // 3 values: top = v1, right/left = v2, bottom = v3
        // 4 values: top = v1, right = v2, bottom = v3, left = v4
        IfCondition EqualTo(val_count, 1) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v1
            LYBox.bottom = v1
            LYBox.left = v1
        }
        IfCondition EqualTo(val_count, 2) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v2
            LYBox.bottom = v1
            LYBox.left = v2
        }
        IfCondition EqualTo(val_count, 3) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v2
            LYBox.bottom = v3
            LYBox.left = v2
        }
        IfCondition EqualTo(val_count, 4) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v2
            LYBox.bottom = v3
            LYBox.left = v4
        }
    }
}

// =============================================================================
// RESOLVE MARGIN — CSS-aware, falls back to tag defaults
// side: 0=top, 1=right, 2=bottom, 3=left
// =============================================================================
Function.LY__ResolveMarginSide {
    Input: node: Integer
    Input: tag: Address
    Input: side: Integer
    Output: Integer
    Body: {
        // 1. Check individual CSS property (highest priority)
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "margin-top" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "margin-right" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "margin-bottom" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "margin-left" }

        // Check inline style first
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "margin"), 0) ThenBlock: {
                mslen = StringLength(style_str)
                mrule = CSS_ParseInline(style_str, mslen)
                IfCondition GreaterEqual(mrule, 0) ThenBlock: {
                    // Try individual property
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        mv = CSS_GetPropVal(mrule, side_prop)
                        IfCondition NotEqual(mv, 0) ThenBlock: {
                            ReturnValue(LY__ParsePx(mv))
                        }
                    }
                    // Try shorthand
                    msh = CSS_GetPropVal(mrule, "margin")
                    IfCondition NotEqual(msh, 0) ThenBlock: {
                        LY__ParseBoxShorthand(msh)
                        IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
                        IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
                        IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
                        IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
                    }
                }
            }
        }

        // 2. Check CSS stylesheet rules — individual property
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_side = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_side, 0) ThenBlock: {
                ReturnValue(LY__ParsePx(css_side))
            }
        }

        // 3. Check CSS stylesheet rules — shorthand
        css_sh = LY__CSSLookupProp(node, "margin")
        IfCondition NotEqual(css_sh, 0) ThenBlock: {
            LY__ParseBoxShorthand(css_sh)
            IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
            IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
            IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
            IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
        }

        // 4. Fall back to tag defaults (top/bottom only)
        IfCondition Or(EqualTo(side, 0), EqualTo(side, 2)) ThenBlock: {
            ReturnValue(LY__ResolveMarginDefault(tag))
        }
        ReturnValue(0)
    }
}

Function.LY__ResolveMarginDefault {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(tag, "p"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "h1"), 0) ThenBlock: { ReturnValue(20) }
        IfCondition EqualTo(StringCompare(tag, "h2"), 0) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(StringCompare(tag, "h3"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "div"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(tag, "ul"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "ol"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "li"), 0) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(StringCompare(tag, "blockquote"), 0) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(StringCompare(tag, "pre"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "hr"), 0) ThenBlock: { ReturnValue(8) }
        ReturnValue(0)
    }
}

// Backward-compatible wrapper: returns top margin (used by existing code)
Function.LY__ResolveMargin {
    Input: tag: Address
    Output: Integer
    Body: {
        ReturnValue(LY__ResolveMarginDefault(tag))
    }
}

// =============================================================================
// RESOLVE PADDING — CSS-aware, falls back to tag defaults
// side: 0=top, 1=right, 2=bottom, 3=left
// =============================================================================
Function.LY__ResolvePaddingSide {
    Input: node: Integer
    Input: tag: Address
    Input: side: Integer
    Output: Integer
    Body: {
        // 1. Check individual CSS property
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "padding-top" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "padding-right" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "padding-bottom" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "padding-left" }

        // Check inline style first
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "padding"), 0) ThenBlock: {
                pslen = StringLength(style_str)
                prule = CSS_ParseInline(style_str, pslen)
                IfCondition GreaterEqual(prule, 0) ThenBlock: {
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        pv = CSS_GetPropVal(prule, side_prop)
                        IfCondition NotEqual(pv, 0) ThenBlock: {
                            ReturnValue(LY__ParsePx(pv))
                        }
                    }
                    psh = CSS_GetPropVal(prule, "padding")
                    IfCondition NotEqual(psh, 0) ThenBlock: {
                        LY__ParseBoxShorthand(psh)
                        IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
                        IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
                        IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
                        IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
                    }
                }
            }
        }

        // 2. CSS stylesheet — individual property
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_side = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_side, 0) ThenBlock: {
                ReturnValue(LY__ParsePx(css_side))
            }
        }

        // 3. CSS stylesheet — shorthand
        css_sh = LY__CSSLookupProp(node, "padding")
        IfCondition NotEqual(css_sh, 0) ThenBlock: {
            LY__ParseBoxShorthand(css_sh)
            IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
            IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
            IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
            IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
        }

        // 4. Fall back to tag defaults (uniform for now)
        ReturnValue(LY__ResolvePaddingDefault(tag))
    }
}

Function.LY__ResolvePaddingDefault {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(tag, "body"), 0) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(StringCompare(tag, "blockquote"), 0) ThenBlock: { ReturnValue(20) }
        IfCondition EqualTo(StringCompare(tag, "pre"), 0) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(StringCompare(tag, "li"), 0) ThenBlock: { ReturnValue(16) }
        ReturnValue(0)
    }
}

// Backward-compatible wrapper: returns uniform padding (used by existing code)
Function.LY__ResolvePadding {
    Input: tag: Address
    Output: Integer
    Body: {
        ReturnValue(LY__ResolvePaddingDefault(tag))
    }
}

// =============================================================================
// BORDER SHORTHAND — parse "1px solid #ccc" into width/style/color
// Also resolves per-side border-width from shorthand or individual properties
// =============================================================================
FixedPool.LYBorder {
    "width":   Initialize=0
    "color":   Initialize=0
}

// Parse border shorthand: "1px solid #ccc" or "1px solid" or "none"
// Stores width in LYBorder.width, color in LYBorder.color
// Strategy: scan chars for digit (width) and '#' (hex color)
Function.LY__ParseBorderShorthand {
    Input: str: Address
    Body: {
        LYBorder.width = 0
        LYBorder.color = 0
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(str)
        IfCondition EqualTo(slen, 0) ThenBlock: { ReturnValue(0) }

        // "none" or "0" means no border
        IfCondition EqualTo(StringCompare(str, "none"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(str, "0"), 0) ThenBlock: { ReturnValue(0) }

        // Scan for width: first digit character → parse from that position
        // LY__ParsePx reads digits until non-digit, so passing str ptr at digit start works
        pos = 0
        WhileLoop LessThan(pos, slen) {
            ch = Dereference(Add(str, pos), "byte")
            // Digit 0-9: parse width from this position
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                LYBorder.width = LY__ParsePx(Add(str, pos))
                pos = slen // break
            } ElseBlock: {
                pos = Add(pos, 1)
            }
        }

        // Scan for color: '#' character → parse from that position
        pos = 0
        WhileLoop LessThan(pos, slen) {
            ch = Dereference(Add(str, pos), "byte")
            IfCondition EqualTo(ch, 35) ThenBlock: {
                LYBorder.color = LY__ParseColor(Add(str, pos))
                pos = slen // break
            } ElseBlock: {
                pos = Add(pos, 1)
            }
        }

        // If no hex color found, try parsing the whole string as a color
        // (handles "border: 1px solid red" where color is a named color)
        IfCondition EqualTo(LYBorder.color, 0) ThenBlock: {
            // Try each space-separated word as a potential color name
            // Skip style keywords (solid, dashed, dotted, double, groove, ridge, inset, outset, none, hidden)
            // Skip size keywords (thin, medium, thick) and numbers
            wpos = 0
            w_found = 0
            WhileLoop And(LessThan(wpos, slen), EqualTo(w_found, 0)) {
                // Skip whitespace
                ws_skip_done = 0
                WhileLoop And(LessThan(wpos, slen), EqualTo(ws_skip_done, 0)) {
                    wch = Dereference(Add(str, wpos), "byte")
                    IfCondition EqualTo(wch, 32) ThenBlock: { wpos = Add(wpos, 1) }
                    ElseBlock: { ws_skip_done = 1 }
                }
                IfCondition LessThan(wpos, slen) ThenBlock: {
                    // Find end of word
                    wend = wpos
                    wend_done = 0
                    WhileLoop And(LessThan(wend, slen), EqualTo(wend_done, 0)) {
                        wech = Dereference(Add(str, wend), "byte")
                        IfCondition EqualTo(wech, 32) ThenBlock: { wend_done = 1 }
                        ElseBlock: { wend = Add(wend, 1) }
                    }
                    // Extract word
                    wlen = Subtract(wend, wpos)
                    IfCondition GreaterThan(wlen, 0) ThenBlock: {
                        word_ptr = Add(str, wpos)
                        first_ch = Dereference(word_ptr, "byte")
                        // Skip digits (size values) and '#' (already handled)
                        is_skip = 0
                        IfCondition And(GreaterEqual(first_ch, 48), LessEqual(first_ch, 57)) ThenBlock: { is_skip = 1 }
                        IfCondition EqualTo(first_ch, 35) ThenBlock: { is_skip = 1 }
                        IfCondition EqualTo(is_skip, 0) ThenBlock: {
                            // Try as color — extract word to temp buffer
                            word_buf = Allocate(Add(wlen, 1))
                            MemoryCopy(word_buf, word_ptr, wlen)
                            StoreValue(Add(word_buf, wlen), 0, "byte")
                            // Skip border-style keywords
                            is_style = 0
                            IfCondition EqualTo(StringCompare(word_buf, "solid"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "dashed"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "dotted"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "double"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "groove"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "ridge"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "inset"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "outset"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "none"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "hidden"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "thin"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "medium"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(StringCompare(word_buf, "thick"), 0) ThenBlock: { is_style = 1 }
                            IfCondition EqualTo(is_style, 0) ThenBlock: {
                                try_color = LY__ParseColor(word_buf)
                                IfCondition NotEqual(try_color, 0) ThenBlock: {
                                    LYBorder.color = try_color
                                    w_found = 1
                                }
                            }
                        }
                    }
                    wpos = wend
                }
            }
        }

        // Check for named keywords: thin/medium/thick (if no digit width found)
        IfCondition EqualTo(LYBorder.width, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(str, "thin"), 0) ThenBlock: {
                LYBorder.width = 1
            }
            IfCondition GreaterEqual(StringIndexOf(str, "medium"), 0) ThenBlock: {
                LYBorder.width = 3
            }
            IfCondition GreaterEqual(StringIndexOf(str, "thick"), 0) ThenBlock: {
                LYBorder.width = 5
            }
        }
        // CSS spec: border shorthand with no explicit width defaults to medium (3px)
        IfCondition EqualTo(LYBorder.width, 0) ThenBlock: {
            LYBorder.width = 3
        }
    }
}

// Resolve border-width for a given side (0=top, 1=right, 2=bottom, 3=left)
Function.LY__ResolveBorderWidth {
    Input: node: Integer
    Input: side: Integer
    Output: Integer
    Body: {
        // Individual property name
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "border-top-width" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "border-right-width" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "border-bottom-width" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "border-left-width" }

        // Check inline style
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "border"), 0) ThenBlock: {
                bslen = StringLength(style_str)
                brule = CSS_ParseInline(style_str, bslen)
                IfCondition GreaterEqual(brule, 0) ThenBlock: {
                    // Try individual side width
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        bv = CSS_GetPropVal(brule, side_prop)
                        IfCondition NotEqual(bv, 0) ThenBlock: {
                            ReturnValue(LY__ParsePx(bv))
                        }
                    }
                    // Try border-width shorthand (1/2/3/4 values like margin)
                    bw = CSS_GetPropVal(brule, "border-width")
                    IfCondition NotEqual(bw, 0) ThenBlock: {
                        LY__ParseBoxShorthand(bw)
                        IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
                        IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
                        IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
                        IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
                    }
                    // Try border shorthand
                    bsh = CSS_GetPropVal(brule, "border")
                    IfCondition NotEqual(bsh, 0) ThenBlock: {
                        LY__ParseBorderShorthand(bsh)
                        ReturnValue(LYBorder.width)
                    }
                }
            }
        }

        // Check CSS stylesheet rules — individual property
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_bw = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_bw, 0) ThenBlock: {
                ReturnValue(LY__ParsePx(css_bw))
            }
        }

        // Check CSS stylesheet — border-width shorthand
        css_bwsh = LY__CSSLookupProp(node, "border-width")
        IfCondition NotEqual(css_bwsh, 0) ThenBlock: {
            LY__ParseBoxShorthand(css_bwsh)
            IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
            IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
            IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
            IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
        }

        // Check CSS stylesheet — border shorthand
        css_bsh = LY__CSSLookupProp(node, "border")
        IfCondition NotEqual(css_bsh, 0) ThenBlock: {
            LY__ParseBorderShorthand(css_bsh)
            ReturnValue(LYBorder.width)
        }

        ReturnValue(0)
    }
}

// Resolve border-color for a given side
Function.LY__ResolveBorderColor {
    Input: node: Integer
    Input: side: Integer
    Output: Integer
    Body: {
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "border-top-color" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "border-right-color" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "border-bottom-color" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "border-left-color" }

        // Check inline style
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "border"), 0) ThenBlock: {
                bslen = StringLength(style_str)
                brule = CSS_ParseInline(style_str, bslen)
                IfCondition GreaterEqual(brule, 0) ThenBlock: {
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        bv = CSS_GetPropVal(brule, side_prop)
                        IfCondition NotEqual(bv, 0) ThenBlock: {
                            ReturnValue(LY__ParseColor(bv))
                        }
                    }
                    bsh = CSS_GetPropVal(brule, "border")
                    IfCondition NotEqual(bsh, 0) ThenBlock: {
                        LY__ParseBorderShorthand(bsh)
                        IfCondition NotEqual(LYBorder.color, 0) ThenBlock: {
                            ReturnValue(LYBorder.color)
                        }
                    }
                }
            }
        }

        // CSS rules — individual
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_bc = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_bc, 0) ThenBlock: {
                ReturnValue(LY__ParseColor(css_bc))
            }
        }

        // CSS rules — shorthand
        css_bsh = LY__CSSLookupProp(node, "border")
        IfCondition NotEqual(css_bsh, 0) ThenBlock: {
            LY__ParseBorderShorthand(css_bsh)
            IfCondition NotEqual(LYBorder.color, 0) ThenBlock: {
                ReturnValue(LYBorder.color)
            }
        }

        // Default: use foreground color
        ReturnValue(LYState.fg_color)
    }
}

// =============================================================================
// BACKGROUND SHORTHAND — extract background-color from "background" property
// "background: #fff url(...) no-repeat" → returns #fff color
// =============================================================================
Function.LY__ResolveBackgroundColor {
    Input: node: Integer
    Output: Integer
    Body: {
        // Already checked background-color directly in LY__ResolveBgColor
        // This handles the "background" shorthand property
        bg_sh = 0

        // Check inline style
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "background"), 0) ThenBlock: {
                bslen = StringLength(style_str)
                brule = CSS_ParseInline(style_str, bslen)
                IfCondition GreaterEqual(brule, 0) ThenBlock: {
                    bg_sh = CSS_GetPropVal(brule, "background")
                }
            }
        }

        // Check CSS rules
        IfCondition EqualTo(bg_sh, 0) ThenBlock: {
            bg_sh = LY__CSSLookupProp(node, "background")
        }

        IfCondition NotEqual(bg_sh, 0) ThenBlock: {
            // Try to extract a color from the shorthand
            // The color is typically the first token that looks like a color
            first_ch = Dereference(bg_sh, "byte")
            // Hex color
            IfCondition EqualTo(first_ch, 35) ThenBlock: {
                ReturnValue(LY__ParseColor(bg_sh))
            }
            // Named color or rgb(...)
            c = LY__ParseColor(bg_sh)
            IfCondition NotEqual(c, 0) ThenBlock: {
                ReturnValue(c)
            }
        }

        ReturnValue(LYConst.COLOR_TRANSP)
    }
}

