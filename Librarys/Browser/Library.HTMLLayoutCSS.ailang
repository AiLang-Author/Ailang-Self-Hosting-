// Library.HTMLLayoutCSS.ailang — CSS selector matching and property resolution
// ClassContains, NodeMatchesSel, CSSLookupProp, margin/padding/border resolution.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutUnits
LibraryImport.Browser.HTMLLayoutColors
LibraryImport.Browser.HTMLLayoutBorder

Function.LY__ClassContains {
    Input: class_attr: Address
    Input: target: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(class_attr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }

        LYCss.clen = StringLength(class_attr)
        LYCss.nlen = StringLength(target)
        IfCondition EqualTo(LYCss.clen, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LYCss.nlen, 0) ThenBlock: { ReturnValue(0) }

        // Exact match (single class)
        IfCondition EqualTo(StringCompare(class_attr, target), 0) ThenBlock: {
            ReturnValue(1)
        }

        // Walk space-separated words
        LYCss.ci = 0
        WhileLoop LessEqual(LYCss.ci, LYCss.clen) {
            // Skip spaces
            WhileLoop LessThan(LYCss.ci, LYCss.clen) {
                IfCondition EqualTo(GetByte(class_attr, LYCss.ci), 32) ThenBlock: {
                    LYCss.ci = Add(LYCss.ci, 1)
                } ElseBlock: {
                    BreakLoop
                }
            }
            IfCondition GreaterEqual(LYCss.ci, LYCss.clen) ThenBlock: { ReturnValue(0) }

            // Start of word
            LYCss.wstart = LYCss.ci
            // Find end of word
            WhileLoop LessThan(LYCss.ci, LYCss.clen) {
                IfCondition NotEqual(GetByte(class_attr, LYCss.ci), 32) ThenBlock: {
                    LYCss.ci = Add(LYCss.ci, 1)
                } ElseBlock: {
                    BreakLoop
                }
            }
            // Compare word length and content
            wlen = Subtract(LYCss.ci, LYCss.wstart)
            IfCondition EqualTo(wlen, LYCss.nlen) ThenBlock: {
                wmatch = 1
                wi = 0
                WhileLoop LessThan(wi, wlen) {
                    c1 = GetByte(class_attr, Add(LYCss.wstart, wi))
                    c2 = GetByte(target, wi)
                    IfCondition NotEqual(c1, c2) ThenBlock: {
                        wmatch = 0
                        wi = wlen
                    }
                    wi = Add(wi, 1)
                }
                IfCondition EqualTo(wmatch, 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// COMBINATOR MATCHING — check if context selector matches a candidate node
// Returns 1 if sel_type+sel_ptr matches the candidate node's tag/class/id
// =============================================================================
Function.LY__NodeMatchesSel {
    Input: cand: Integer
    Input: sel_type: Integer
    Input: sel_ptr: Address
    Output: Integer
    Body: {
        IfCondition LessEqual(cand, 0) ThenBlock: { ReturnValue(0) }

        // Universal matches everything
        IfCondition EqualTo(sel_type, CSSSelType.UNIVERSAL) ThenBlock: { ReturnValue(1) }

        // TAG match
        IfCondition EqualTo(sel_type, CSSSelType.TAG) ThenBlock: {
            cand_tag = DOM_GetTag(cand)
            IfCondition EqualTo(cand_tag, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(StringCompare(sel_ptr, cand_tag), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }

        // CLASS match
        IfCondition EqualTo(sel_type, CSSSelType.CLASS) ThenBlock: {
            cand_cls = DOM_GetAttr(cand, "class")
            IfCondition EqualTo(cand_cls, 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(LY__ClassContains(cand_cls, sel_ptr))
        }

        // ID match
        IfCondition EqualTo(sel_type, CSSSelType.ID) ThenBlock: {
            cand_id = DOM_GetAttr(cand, "id")
            IfCondition EqualTo(cand_id, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(StringCompare(sel_ptr, cand_id), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// CHECK COMBINATOR — verify that a rule's combinator context matches
// node = the subject element that matched R_SEL_*
// rule = the rule index (has R_CMB_TYPE, R_CMB_SEL_TYPE, R_CMB_SEL_PTR)
// Returns 1 if combinator context satisfied, 0 otherwise
// =============================================================================
Function.LY__CheckCombinator {
    Input: node: Integer
    Input: rule: Integer
    Output: Integer
    Body: {
        cmb_type = CSS_RuleCmbType(rule)
        IfCondition EqualTo(cmb_type, CSSCmb.NONE) ThenBlock: { ReturnValue(1) }

        cmb_sel_type = CSS_RuleCmbSelType(rule)
        cmb_sel_ptr = CSS_RuleCmbSelPtr(rule)

        // CHILD combinator (>): parent must match
        IfCondition EqualTo(cmb_type, CSSCmb.CHILD) ThenBlock: {
            par = DOM_GetParent(node)
            ReturnValue(LY__NodeMatchesSel(par, cmb_sel_type, cmb_sel_ptr))
        }

        // DESCENDANT combinator (space): any ancestor must match
        IfCondition EqualTo(cmb_type, CSSCmb.DESC) ThenBlock: {
            LYCss.cmb_node = DOM_GetParent(node)
            LYCss.cmb_depth = 0
            WhileLoop And(GreaterThan(LYCss.cmb_node, 0), LessThan(LYCss.cmb_depth, 32)) {
                IfCondition EqualTo(LY__NodeMatchesSel(LYCss.cmb_node, cmb_sel_type, cmb_sel_ptr), 1) ThenBlock: {
                    ReturnValue(1)
                }
                LYCss.cmb_node = DOM_GetParent(LYCss.cmb_node)
                LYCss.cmb_depth = Add(LYCss.cmb_depth, 1)
            }
            ReturnValue(0)
        }

        // ADJACENT SIBLING (+): previous sibling must match
        IfCondition EqualTo(cmb_type, CSSCmb.ADJ) ThenBlock: {
            prev = DOM_GetPrevSib(node)
            ReturnValue(LY__NodeMatchesSel(prev, cmb_sel_type, cmb_sel_ptr))
        }

        // GENERAL SIBLING (~): any earlier sibling must match
        IfCondition EqualTo(cmb_type, CSSCmb.GEN) ThenBlock: {
            LYCss.cmb_node = DOM_GetPrevSib(node)
            LYCss.cmb_depth = 0
            WhileLoop And(GreaterThan(LYCss.cmb_node, 0), LessThan(LYCss.cmb_depth, 64)) {
                IfCondition EqualTo(LY__NodeMatchesSel(LYCss.cmb_node, cmb_sel_type, cmb_sel_ptr), 1) ThenBlock: {
                    ReturnValue(1)
                }
                LYCss.cmb_node = DOM_GetPrevSib(LYCss.cmb_node)
                LYCss.cmb_depth = Add(LYCss.cmb_depth, 1)
            }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// CSS RULE LOOKUP — find property value for a DOM node from stylesheet rules
// Iterates all parsed CSS rules, returns value pointer or 0
// =============================================================================
Function.LY__CSSLookupProp {
    Input: node: Integer
    Input: prop: Address
    Output: Address
    Body: {
        LYCss.rcount = CSS_RuleCount()
        IfCondition EqualTo(LYCss.rcount, 0) ThenBlock: { ReturnValue(0) }

        LYCss.tag = DOM_GetTag(node)
        LYCss.cls = DOM_GetAttr(node, "class")
        LYCss.id = DOM_GetAttr(node, "id")

        LYCss.result = 0
        LYCss.best = -1

        LYCss.ri = 0
        WhileLoop LessThan(LYCss.ri, LYCss.rcount) {
            LYCss.matched = 0

            // Skip inline-style rules (UNIVERSAL with specificity >= 1000)
            // These are created by CSS_ParseInline and must NOT match other elements
            LYCss.ri_spec = CSS_RuleSpecificity(LYCss.ri)
            IfCondition GreaterEqual(LYCss.ri_spec, 1000) ThenBlock: {
                LYCss.ri = Add(LYCss.ri, 1)
                ContinueLoop
            }

            // Skip rules with interactive pseudo-classes (:hover, :focus, :active, etc.)
            // These can never match since we have no interaction state tracking
            IfCondition EqualTo(CSS_RulePseudo(LYCss.ri), 1) ThenBlock: {
                LYCss.ri = Add(LYCss.ri, 1)
                ContinueLoop
            }

            // Check tag match
            IfCondition EqualTo(CSS_MatchesTag(LYCss.ri, LYCss.tag), 1) ThenBlock: {
                LYCss.matched = 1
            }

            // Check class match (with space-separated support)
            IfCondition EqualTo(LYCss.matched, 0) ThenBlock: {
                IfCondition NotEqual(LYCss.cls, 0) ThenBlock: {
                    sel_type = CSS_RuleSelType(LYCss.ri)
                    IfCondition EqualTo(sel_type, CSSSelType.CLASS) ThenBlock: {
                        sel_ptr = CSS_RuleSelPtr(LYCss.ri)
                        IfCondition NotEqual(sel_ptr, 0) ThenBlock: {
                            IfCondition EqualTo(LY__ClassContains(LYCss.cls, sel_ptr), 1) ThenBlock: {
                                LYCss.matched = 1
                            }
                        }
                    }
                }
            }

            // Check id match
            IfCondition EqualTo(LYCss.matched, 0) ThenBlock: {
                IfCondition EqualTo(CSS_MatchesId(LYCss.ri, LYCss.id), 1) ThenBlock: {
                    LYCss.matched = 1
                }
            }

            // If subject matched, verify combinator context
            IfCondition EqualTo(LYCss.matched, 1) ThenBlock: {
                IfCondition EqualTo(LY__CheckCombinator(node, LYCss.ri), 0) ThenBlock: {
                    LYCss.matched = 0
                }
            }

            // If fully matched, look up the property — highest specificity wins
            IfCondition EqualTo(LYCss.matched, 1) ThenBlock: {
                LYCss.val = CSS_GetPropVal(LYCss.ri, prop)
                IfCondition NotEqual(LYCss.val, 0) ThenBlock: {
                    LYCss.spec = CSS_RuleSpecificity(LYCss.ri)
                    // Higher or equal specificity wins (equal = source order)
                    IfCondition GreaterEqual(LYCss.spec, LYCss.best) ThenBlock: {
                        LYCss.best = LYCss.spec
                        LYCss.result = LYCss.val
                    }
                }
            }

            LYCss.ri = Add(LYCss.ri, 1)
        }

        ReturnValue(LYCss.result)
    }
}

// =============================================================================
// STYLE RESOLUTION — get CSS properties for a DOM node
// Uses tag-based defaults + inline style + CSS rule matching
// =============================================================================
Function.LY__ResolveBgColor {
    Input: node: Integer
    Output: Integer
    Body: {
        // Check inline style (highest priority)
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            bg_idx = StringIndexOf(style_str, "background")
            IfCondition GreaterEqual(bg_idx, 0) ThenBlock: {
                slen = StringLength(style_str)
                rule = CSS_ParseInline(style_str, slen)
                IfCondition GreaterEqual(rule, 0) ThenBlock: {
                    bgv = CSS_GetPropVal(rule, "background-color")
                    IfCondition NotEqual(bgv, 0) ThenBlock: {
                        bgv_c = LY__ParseColor(bgv)
                        IfCondition EqualTo(bgv_c, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
                        ReturnValue(bgv_c)
                    }
                    bgv2 = CSS_GetPropVal(rule, "background")
                    IfCondition NotEqual(bgv2, 0) ThenBlock: {
                        bgv2_c = LY__ParseColor(bgv2)
                        IfCondition EqualTo(bgv2_c, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
                        ReturnValue(bgv2_c)
                    }
                }
            }
        }

        // Check CSS stylesheet rules
        css_bg = LY__CSSLookupProp(node, "background-color")
        IfCondition NotEqual(css_bg, 0) ThenBlock: {
            bg_parsed = LY__ParseColor(css_bg)
            IfCondition EqualTo(bg_parsed, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
            ReturnValue(bg_parsed)
        }
        css_bg2 = LY__CSSLookupProp(node, "background")
        IfCondition NotEqual(css_bg2, 0) ThenBlock: {
            bg_parsed2 = LY__ParseColor(css_bg2)
            IfCondition EqualTo(bg_parsed2, 1) ThenBlock: { ReturnValue(LYState.fg_color) }
            ReturnValue(bg_parsed2)
        }

        ReturnValue(LYConst.COLOR_TRANSP)
    }
}

Function.LY__ResolveFgColor {
    Input: node: Integer
    Output: Integer
    Body: {
        tag = DOM_GetTag(node)

        // Check inline style for color (highest priority)
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            col_idx = StringIndexOf(style_str, "color")
            IfCondition GreaterEqual(col_idx, 0) ThenBlock: {
                slen = StringLength(style_str)
                rule = CSS_ParseInline(style_str, slen)
                IfCondition GreaterEqual(rule, 0) ThenBlock: {
                    cv = CSS_GetPropVal(rule, "color")
                    IfCondition NotEqual(cv, 0) ThenBlock: {
                        ReturnValue(LY__ParseColor(cv))
                    }
                }
            }
        }

        // Check CSS stylesheet rules
        css_fg = LY__CSSLookupProp(node, "color")
        IfCondition NotEqual(css_fg, 0) ThenBlock: {
            ReturnValue(LY__ParseColor(css_fg))
        }

        // Default: links are blue (only if no CSS override found)
        IfCondition NotEqual(tag, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(tag, "a"), 0) ThenBlock: {
                ReturnValue(LYConst.COLOR_LINK)
            }
        }

        // Inherit from parent state
        ReturnValue(LYState.fg_color)
    }
}

// =============================================================================
// RESOLVE MARGIN — CSS-aware, falls back to tag defaults
// side: 0=top, 1=right, 2=bottom, 3=left
// =============================================================================
Function.LY__ResolveMarginSide {
    Input: node: Integer
    Input: tag: Address
    Input: side: Integer
    Output: Integer
    Body: {
        // 1. Check individual CSS property (highest priority)
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "margin-top" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "margin-right" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "margin-bottom" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "margin-left" }

        // Check inline style first
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "margin"), 0) ThenBlock: {
                mslen = StringLength(style_str)
                mrule = CSS_ParseInline(style_str, mslen)
                IfCondition GreaterEqual(mrule, 0) ThenBlock: {
                    // Try individual property
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        mv = CSS_GetPropVal(mrule, side_prop)
                        IfCondition NotEqual(mv, 0) ThenBlock: {
                            ReturnValue(LY__ParsePx(mv))
                        }
                    }
                    // Try shorthand
                    msh = CSS_GetPropVal(mrule, "margin")
                    IfCondition NotEqual(msh, 0) ThenBlock: {
                        LY__ParseBoxShorthand(msh)
                        IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
                        IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
                        IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
                        IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
                    }
                }
            }
        }

        // 2. Check CSS stylesheet rules — individual property
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_side = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_side, 0) ThenBlock: {
                ReturnValue(LY__ParsePx(css_side))
            }
        }

        // 2b. Check CSS logical properties (LTR assumed)
        // block-start=top(0), inline-end=right(1), block-end=bottom(2), inline-start=left(3)
        log_prop = 0
        log_short = 0
        IfCondition EqualTo(side, 0) ThenBlock: { log_prop = "margin-block-start"  log_short = "margin-block" }
        IfCondition EqualTo(side, 1) ThenBlock: { log_prop = "margin-inline-end"   log_short = "margin-inline" }
        IfCondition EqualTo(side, 2) ThenBlock: { log_prop = "margin-block-end"    log_short = "margin-block" }
        IfCondition EqualTo(side, 3) ThenBlock: { log_prop = "margin-inline-start" log_short = "margin-inline" }
        IfCondition NotEqual(log_prop, 0) ThenBlock: {
            css_log = LY__CSSLookupProp(node, log_prop)
            IfCondition NotEqual(css_log, 0) ThenBlock: {
                ReturnValue(LY__ParsePx(css_log))
            }
        }
        // Check logical shorthand (margin-block, margin-inline)
        IfCondition NotEqual(log_short, 0) ThenBlock: {
            css_ls = LY__CSSLookupProp(node, log_short)
            IfCondition NotEqual(css_ls, 0) ThenBlock: {
                LY__ParseBoxShorthand(css_ls)
                // shorthand: 1 value=all, 2 values=start/end
                IfCondition Or(EqualTo(side, 0), EqualTo(side, 3)) ThenBlock: { ReturnValue(LYBox.top) }
                IfCondition Or(EqualTo(side, 2), EqualTo(side, 1)) ThenBlock: { ReturnValue(LYBox.right) }
            }
        }

        // 3. Check CSS stylesheet rules — shorthand
        css_sh = LY__CSSLookupProp(node, "margin")
        IfCondition NotEqual(css_sh, 0) ThenBlock: {
            LY__ParseBoxShorthand(css_sh)
            IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
            IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
            IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
            IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
        }

        // 4. Fall back to tag defaults (top/bottom only)
        IfCondition Or(EqualTo(side, 0), EqualTo(side, 2)) ThenBlock: {
            ReturnValue(LY__ResolveMarginDefault(tag))
        }
        ReturnValue(0)
    }
}

Function.LY__ResolveMarginDefault {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(tag, "p"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "h1"), 0) ThenBlock: { ReturnValue(20) }
        IfCondition EqualTo(StringCompare(tag, "h2"), 0) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(StringCompare(tag, "h3"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "div"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(tag, "ul"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "ol"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "li"), 0) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(StringCompare(tag, "blockquote"), 0) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(StringCompare(tag, "pre"), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(StringCompare(tag, "hr"), 0) ThenBlock: { ReturnValue(8) }
        ReturnValue(0)
    }
}

// Backward-compatible wrapper: returns top margin (used by existing code)
Function.LY__ResolveMargin {
    Input: tag: Address
    Output: Integer
    Body: {
        ReturnValue(LY__ResolveMarginDefault(tag))
    }
}

// =============================================================================
// RESOLVE PADDING — CSS-aware, falls back to tag defaults
// side: 0=top, 1=right, 2=bottom, 3=left
// =============================================================================
Function.LY__ResolvePaddingSide {
    Input: node: Integer
    Input: tag: Address
    Input: side: Integer
    Output: Integer
    Body: {
        // 1. Check individual CSS property
        side_prop = 0
        IfCondition EqualTo(side, 0) ThenBlock: { side_prop = "padding-top" }
        IfCondition EqualTo(side, 1) ThenBlock: { side_prop = "padding-right" }
        IfCondition EqualTo(side, 2) ThenBlock: { side_prop = "padding-bottom" }
        IfCondition EqualTo(side, 3) ThenBlock: { side_prop = "padding-left" }

        // Check inline style first
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "padding"), 0) ThenBlock: {
                pslen = StringLength(style_str)
                prule = CSS_ParseInline(style_str, pslen)
                IfCondition GreaterEqual(prule, 0) ThenBlock: {
                    IfCondition NotEqual(side_prop, 0) ThenBlock: {
                        pv = CSS_GetPropVal(prule, side_prop)
                        IfCondition NotEqual(pv, 0) ThenBlock: {
                            ReturnValue(LY__ParsePx(pv))
                        }
                    }
                    psh = CSS_GetPropVal(prule, "padding")
                    IfCondition NotEqual(psh, 0) ThenBlock: {
                        LY__ParseBoxShorthand(psh)
                        IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
                        IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
                        IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
                        IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
                    }
                }
            }
        }

        // 2. CSS stylesheet — individual property
        IfCondition NotEqual(side_prop, 0) ThenBlock: {
            css_side = LY__CSSLookupProp(node, side_prop)
            IfCondition NotEqual(css_side, 0) ThenBlock: {
                ReturnValue(LY__ParsePx(css_side))
            }
        }

        // 2b. CSS logical properties (LTR assumed)
        plog_prop = 0
        plog_short = 0
        IfCondition EqualTo(side, 0) ThenBlock: { plog_prop = "padding-block-start"  plog_short = "padding-block" }
        IfCondition EqualTo(side, 1) ThenBlock: { plog_prop = "padding-inline-end"   plog_short = "padding-inline" }
        IfCondition EqualTo(side, 2) ThenBlock: { plog_prop = "padding-block-end"    plog_short = "padding-block" }
        IfCondition EqualTo(side, 3) ThenBlock: { plog_prop = "padding-inline-start" plog_short = "padding-inline" }
        IfCondition NotEqual(plog_prop, 0) ThenBlock: {
            css_plog = LY__CSSLookupProp(node, plog_prop)
            IfCondition NotEqual(css_plog, 0) ThenBlock: {
                ReturnValue(LY__ParsePx(css_plog))
            }
        }
        IfCondition NotEqual(plog_short, 0) ThenBlock: {
            css_pls = LY__CSSLookupProp(node, plog_short)
            IfCondition NotEqual(css_pls, 0) ThenBlock: {
                LY__ParseBoxShorthand(css_pls)
                IfCondition Or(EqualTo(side, 0), EqualTo(side, 3)) ThenBlock: { ReturnValue(LYBox.top) }
                IfCondition Or(EqualTo(side, 2), EqualTo(side, 1)) ThenBlock: { ReturnValue(LYBox.right) }
            }
        }

        // 3. CSS stylesheet — shorthand
        css_sh = LY__CSSLookupProp(node, "padding")
        IfCondition NotEqual(css_sh, 0) ThenBlock: {
            LY__ParseBoxShorthand(css_sh)
            IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(LYBox.top) }
            IfCondition EqualTo(side, 1) ThenBlock: { ReturnValue(LYBox.right) }
            IfCondition EqualTo(side, 2) ThenBlock: { ReturnValue(LYBox.bottom) }
            IfCondition EqualTo(side, 3) ThenBlock: { ReturnValue(LYBox.left) }
        }

        // 4. Fall back to tag defaults (uniform for now)
        ReturnValue(LY__ResolvePaddingDefault(tag))
    }
}

Function.LY__ResolvePaddingDefault {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(0) }
        // Note: body has 8px MARGIN (not padding) per CSS spec
        IfCondition EqualTo(StringCompare(tag, "blockquote"), 0) ThenBlock: { ReturnValue(20) }
        IfCondition EqualTo(StringCompare(tag, "pre"), 0) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(StringCompare(tag, "li"), 0) ThenBlock: { ReturnValue(16) }
        ReturnValue(0)
    }
}

// Backward-compatible wrapper: returns uniform padding (used by existing code)
Function.LY__ResolvePadding {
    Input: tag: Address
    Output: Integer
    Body: {
        ReturnValue(LY__ResolvePaddingDefault(tag))
    }
}

