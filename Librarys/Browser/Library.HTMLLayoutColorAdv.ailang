        IfCondition LessEqual(val, 9000) ThenBlock: {
            rv = Add(7464, Divide(Multiply(Subtract(val, 8500), 808), 500))
            ReturnValue(rv)
        }
        IfCondition LessEqual(val, 9500) ThenBlock: {
            rv = Add(8272, Divide(Multiply(Subtract(val, 9000), 846), 500))
            ReturnValue(rv)
        }
        rv = Add(9118, Divide(Multiply(Subtract(val, 9500), 882), 500))
        IfCondition GreaterThan(rv, 10000) ThenBlock: { rv = 10000 }
        ReturnValue(rv)
    }
}

