            ReturnValue(rv)
        }
        rv = Add(9017, Divide(Multiply(Subtract(val, 9500), 983), 500))
        IfCondition GreaterThan(rv, 10000) ThenBlock: { rv = 10000 }
        ReturnValue(rv)
    }
}

// Parse 3 floating-point values from a color function string (x10000 precision).
FixedPool.ColorParse3 {
    "v0":  Initialize=0
    "v1":  Initialize=0
    "v2":  Initialize=0
}

Function.LY__ColorParse3 {
    Input: str: Address
    Input: start: Integer
    Output: Integer
    Body: {
        slen = StringLength(str)
        pi = start
        vc = 0
        WhileLoop And(LessThan(vc, 3), LessThan(pi, slen)) {
            sk_done = 0
            WhileLoop And(LessThan(pi, slen), EqualTo(sk_done, 0)) {
                sc = GetByte(str, pi)
                sc_skip = 0
                IfCondition EqualTo(sc, 32) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 44) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 9) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 10) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 47) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc_skip, 1) ThenBlock: { pi = Add(pi, 1) }
                IfCondition EqualTo(sc_skip, 0) ThenBlock: { sk_done = 1 }
            }
            IfCondition GreaterEqual(pi, slen) ThenBlock: { vc = 3 }
            IfCondition LessThan(vc, 3) ThenBlock: {
                IfCondition LessThan(pi, slen) ThenBlock: {
                    ec = GetByte(str, pi)
                    IfCondition EqualTo(ec, 41) ThenBlock: { vc = 3 }
                }
            }
            IfCondition LessThan(vc, 3) ThenBlock: {
                num = 0
                is_neg = 0
                IfCondition LessThan(pi, slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, pi), 45) ThenBlock: {
                        is_neg = 1
                        pi = Add(pi, 1)
                    }
                }
                num_done = 0
                WhileLoop And(LessThan(pi, slen), EqualTo(num_done, 0)) {
                    dc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(dc, 48), LessEqual(dc, 57)) ThenBlock: {
                        num = Add(Multiply(num, 10), Subtract(dc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(dc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            frac_val = 0
                            frac_digits = 0
                            frac_done2 = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(frac_done2, 0)) {
                                fc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(fc, 48), LessEqual(fc, 57)) ThenBlock: {
                                    IfCondition LessThan(frac_digits, 4) ThenBlock: {
                                        frac_val = Add(Multiply(frac_val, 10), Subtract(fc, 48))
                                        frac_digits = Add(frac_digits, 1)
                                    }
                                    pi = Add(pi, 1)
                                } ElseBlock: {
                                    frac_done2 = 1
                                }
                            }
                            WhileLoop LessThan(frac_digits, 4) {
                                frac_val = Multiply(frac_val, 10)
                                frac_digits = Add(frac_digits, 1)
                            }
                            num = Add(Multiply(num, 10000), frac_val)
                        } ElseBlock: {
                            num = Multiply(num, 10000)
                        }
                        num_done = 1
                    }
                }
                IfCondition EqualTo(num_done, 0) ThenBlock: { num = Multiply(num, 10000) }
                IfCondition EqualTo(is_neg, 1) ThenBlock: { num = Subtract(0, num) }
                // Skip % suffix
                IfCondition LessThan(pi, slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, pi), 37) ThenBlock: { pi = Add(pi, 1) }
                }
                IfCondition EqualTo(vc, 0) ThenBlock: { ColorParse3.v0 = num }
                IfCondition EqualTo(vc, 1) ThenBlock: { ColorParse3.v1 = num }
                IfCondition EqualTo(vc, 2) ThenBlock: { ColorParse3.v2 = num }
                vc = Add(vc, 1)
            }
        }
        ReturnValue(vc)
    }
}

// LAB → sRGB BGRA
Function.LY__LabToSRGB {
    Input: L_in: Integer
    Input: a_in: Integer
    Input: b_in: Integer
    Output: Integer
    Body: {
        // L_in is L*10000 (e.g. 46.2775 → 462775), a/b are x10000
        fy = Divide(Add(L_in, 160000), 116)
        fx = Add(fy, Divide(a_in, 500))
        fz = Subtract(fy, Divide(b_in, 200))

        IfCondition GreaterThan(fx, 2069) ThenBlock: {
            xx = Divide(Multiply(Divide(Multiply(fx, fx), 10000), fx), 10000)
        } ElseBlock: {
            xx = Divide(Multiply(Subtract(fx, 1379), 1284), 10000)
        }
        IfCondition GreaterThan(fy, 2069) ThenBlock: {
            yy = Divide(Multiply(Divide(Multiply(fy, fy), 10000), fy), 10000)
        } ElseBlock: {
            yy = Divide(Multiply(Subtract(fy, 1379), 1284), 10000)
        }
        IfCondition GreaterThan(fz, 2069) ThenBlock: {
            zz = Divide(Multiply(Divide(Multiply(fz, fz), 10000), fz), 10000)
        } ElseBlock: {
            zz = Divide(Multiply(Subtract(fz, 1379), 1284), 10000)
        }

        // D50 white point
        xyz_x = Divide(Multiply(xx, 9642), 10000)
        xyz_y = yy
        xyz_z = Divide(Multiply(zz, 8252), 10000)

        // D50 XYZ → linear sRGB (combined Bradford + XYZ→sRGB)
        lr = Divide(Add(Add(Multiply(xyz_x, 31339), Multiply(xyz_y, -16170)), Multiply(xyz_z, -4907)), 10000)
        lg = Divide(Add(Add(Multiply(xyz_x, -9785), Multiply(xyz_y, 19162)), Multiply(xyz_z, 334)), 10000)
        lb = Divide(Add(Add(Multiply(xyz_x, 720), Multiply(xyz_y, -2290)), Multiply(xyz_z, 14053)), 10000)
        IfCondition LessThan(lr, 15) ThenBlock: { lr = 0 }
        IfCondition LessThan(lg, 15) ThenBlock: { lg = 0 }
        IfCondition LessThan(lb, 15) ThenBlock: { lb = 0 }
        IfCondition GreaterThan(lr, 9985) ThenBlock: { lr = 10000 }
        IfCondition GreaterThan(lg, 9985) ThenBlock: { lg = 10000 }
        IfCondition GreaterThan(lb, 9985) ThenBlock: { lb = 10000 }
        r = LY__LinearToSRGB(lr)
        g = LY__LinearToSRGB(lg)
        b = LY__LinearToSRGB(lb)
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
        IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
        bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
        ReturnValue(bgra)
    }
}

// OkLab → sRGB BGRA
Function.LY__OkLabToSRGB {
    Input: L_in: Integer
    Input: a_in: Integer
    Input: b_in: Integer
    Output: Integer
    Body: {
        // L (0-1 x10000), a/b (-0.4..0.4 x10000)
        // M2 inverse: OkLab → LMS cube-root
        lms_l = Add(L_in, Add(Divide(Multiply(a_in, 3963), 10000), Divide(Multiply(b_in, 2158), 10000)))
        lms_m = Add(L_in, Add(Divide(Multiply(a_in, -1056), 10000), Divide(Multiply(b_in, -639), 10000)))
        lms_s = Add(L_in, Add(Divide(Multiply(a_in, -895), 10000), Divide(Multiply(b_in, -12915), 10000)))

        // Cube (single-division to minimize truncation error)
        // lms values are ~5000 (x10000), so lms^3 ~ 125*10^9 — fits 64-bit
        ll = Divide(Multiply(Multiply(lms_l, lms_l), lms_l), 100000000)
        mm = Divide(Multiply(Multiply(lms_m, lms_m), lms_m), 100000000)
        ss = Divide(Multiply(Multiply(lms_s, lms_s), lms_s), 100000000)

        // LMS → linear sRGB (M1 inverse from CSS Color 4 spec)
        lr = Divide(Add(Add(Multiply(ll, 40767), Multiply(mm, -33077)), Multiply(ss, 2310)), 10000)
        lg = Divide(Add(Add(Multiply(ll, -12684), Multiply(mm, 26098)), Multiply(ss, -3413)), 10000)
        lb = Divide(Add(Add(Multiply(ll, -42), Multiply(mm, -7034)), Multiply(ss, 17076)), 10000)
        // Snap near-zero/max (OkLab cube+matrix has ~2% integer noise)
        IfCondition LessThan(lr, 200) ThenBlock: { lr = 0 }
        IfCondition LessThan(lg, 200) ThenBlock: { lg = 0 }
        IfCondition LessThan(lb, 200) ThenBlock: { lb = 0 }
        IfCondition GreaterThan(lr, 9800) ThenBlock: { lr = 10000 }
        IfCondition GreaterThan(lg, 9800) ThenBlock: { lg = 10000 }
        IfCondition GreaterThan(lb, 9800) ThenBlock: { lb = 10000 }
        r = LY__LinearToSRGB(lr)
        g = LY__LinearToSRGB(lg)
        b = LY__LinearToSRGB(lb)
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
        IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
        bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
        ReturnValue(bgra)
    }
}

// Integer cos approximation for degrees x1000 (6 segments per quadrant)
// Breakpoints: 0°→10000, 15°→9659, 30°→8660, 45°→7071, 60°→5000, 75°→2588, 90°→0
Function.LY__CosApprox {
    Input: deg_x1000: Integer
    Output: Integer
    Body: {
        a = deg_x1000
        WhileLoop LessThan(a, 0) { a = Add(a, 360000) }
        WhileLoop GreaterEqual(a, 360000) { a = Subtract(a, 360000) }
        neg = 0
        IfCondition GreaterThan(a, 180000) ThenBlock: { a = Subtract(360000, a) }
        IfCondition GreaterThan(a, 90000) ThenBlock: {
            a = Subtract(180000, a)
            neg = 1
        }
        // 6 linear segments for [0,90] degrees (a is in x1000)
        IfCondition LessEqual(a, 15000) ThenBlock: {
            rv = Subtract(10000, Divide(Multiply(a, 341), 15000))
        } ElseBlock: {
            IfCondition LessEqual(a, 30000) ThenBlock: {
                rv = Subtract(9659, Divide(Multiply(Subtract(a, 15000), 999), 15000))
            } ElseBlock: {
                IfCondition LessEqual(a, 45000) ThenBlock: {
                    rv = Subtract(8660, Divide(Multiply(Subtract(a, 30000), 1589), 15000))
                } ElseBlock: {
                    IfCondition LessEqual(a, 60000) ThenBlock: {
                        rv = Subtract(7071, Divide(Multiply(Subtract(a, 45000), 2071), 15000))
                    } ElseBlock: {
                        IfCondition LessEqual(a, 75000) ThenBlock: {
                            rv = Subtract(5000, Divide(Multiply(Subtract(a, 60000), 2412), 15000))
                        } ElseBlock: {
                            rv = Subtract(2588, Divide(Multiply(Subtract(a, 75000), 2588), 15000))
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(neg, 1) ThenBlock: { rv = Subtract(0, rv) }
        ReturnValue(rv)
    }
}

Function.LY__SinApprox {
    Input: deg_x1000: Integer
    Output: Integer
    Body: {
        rv = LY__CosApprox(Subtract(90000, deg_x1000))
        ReturnValue(rv)
    }
}

// Parse lab(L a b) → BGRA
Function.LY__ParseLab {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        pi = 0
        WhileLoop LessThan(pi, slen) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: { pi = Add(pi, 1) BreakLoop }
            pi = Add(pi, 1)
        }
        cnt = LY__ColorParse3(str, pi)
        bgra = LY__LabToSRGB(ColorParse3.v0, ColorParse3.v1, ColorParse3.v2)
        ReturnValue(bgra)
    }
}

// Parse lch(L C H) → BGRA
Function.LY__ParseLCH {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        pi = 0
        WhileLoop LessThan(pi, slen) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: { pi = Add(pi, 1) BreakLoop }
            pi = Add(pi, 1)
        }
        cnt = LY__ColorParse3(str, pi)
        L_v = ColorParse3.v0
        C_v = ColorParse3.v1
        H_v = ColorParse3.v2
        // L=0% → black, L>=100% → white (regardless of chroma/hue)
        IfCondition LessEqual(L_v, 0) ThenBlock: { ReturnValue(4278190080) }
        IfCondition GreaterEqual(L_v, 1000000) ThenBlock: { ReturnValue(4294967295) }
        H_deg_x1000 = Divide(H_v, 10)
        cos_h = LY__CosApprox(H_deg_x1000)
        sin_h = LY__SinApprox(H_deg_x1000)
        a_val = Divide(Multiply(C_v, cos_h), 10000)
        b_val = Divide(Multiply(C_v, sin_h), 10000)
        bgra = LY__LabToSRGB(L_v, a_val, b_val)
        ReturnValue(bgra)
    }
}

// Parse oklab(L a b) → BGRA
Function.LY__ParseOkLab {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        pi = 0
        WhileLoop LessThan(pi, slen) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: { pi = Add(pi, 1) BreakLoop }
            pi = Add(pi, 1)
        }
        cnt = LY__ColorParse3(str, pi)
        ok_L = ColorParse3.v0
        ok_a = ColorParse3.v1
        ok_b = ColorParse3.v2
        // OkLab L: if >10000, it's a percentage (51.975% → 519750), divide by 100
        IfCondition GreaterThan(ok_L, 10000) ThenBlock: { ok_L = Divide(ok_L, 100) }
        // OkLab a/b: if using %, 100% = 0.4 — detect via magnitude > 4000
        // a/b with % would be e.g. 35% → 350000. Raw a/b are -0.4..0.4 → -4000..4000
        IfCondition GreaterThan(ok_a, 4000) ThenBlock: { ok_a = Divide(Multiply(ok_a, 4), 1000) }
        IfCondition LessThan(ok_a, -4000) ThenBlock: { ok_a = Divide(Multiply(ok_a, 4), 1000) }
        IfCondition GreaterThan(ok_b, 4000) ThenBlock: { ok_b = Divide(Multiply(ok_b, 4), 1000) }
        IfCondition LessThan(ok_b, -4000) ThenBlock: { ok_b = Divide(Multiply(ok_b, 4), 1000) }
        // L=0 → black, L>=10000 → white
        IfCondition LessEqual(ok_L, 0) ThenBlock: { ReturnValue(4278190080) }
        IfCondition GreaterEqual(ok_L, 10000) ThenBlock: { ReturnValue(4294967295) }
        bgra = LY__OkLabToSRGB(ok_L, ok_a, ok_b)
        ReturnValue(bgra)
    }
}

// Parse oklch(L C H) → BGRA
Function.LY__ParseOkLCH {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        pi = 0
        WhileLoop LessThan(pi, slen) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: { pi = Add(pi, 1) BreakLoop }
            pi = Add(pi, 1)
        }
        cnt = LY__ColorParse3(str, pi)
        L_v = ColorParse3.v0
        C_v = ColorParse3.v1
        H_v = ColorParse3.v2
        // OkLCH L: if >10000 (i.e. percentage or >1.0), divide by 100 to get 0-1 x10000
        IfCondition GreaterThan(L_v, 10000) ThenBlock: { L_v = Divide(L_v, 100) }
        // OkLCH C: if >4000 (i.e. percentage), scale: 100%=0.4 x10000=4000
        IfCondition GreaterThan(C_v, 4000) ThenBlock: { C_v = Divide(Multiply(C_v, 4), 1000) }
        // L=0 → black, L>=10000 (1.0) → white
        IfCondition LessEqual(L_v, 0) ThenBlock: { ReturnValue(4278190080) }
        IfCondition GreaterEqual(L_v, 10000) ThenBlock: { ReturnValue(4294967295) }
        H_deg_x1000 = Divide(H_v, 10)
        cos_h = LY__CosApprox(H_deg_x1000)
        sin_h = LY__SinApprox(H_deg_x1000)
        a_val = Divide(Multiply(C_v, cos_h), 10000)
        b_val = Divide(Multiply(C_v, sin_h), 10000)
        bgra = LY__OkLabToSRGB(L_v, a_val, b_val)
        ReturnValue(bgra)
    }
}

// Parse color(colorspace r g b) → BGRA
Function.LY__ParseColorFunc {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        pi = 0
        WhileLoop LessThan(pi, slen) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: { pi = Add(pi, 1) BreakLoop }
            pi = Add(pi, 1)
        }
        WhileLoop And(LessThan(pi, slen), EqualTo(GetByte(str, pi), 32)) { pi = Add(pi, 1) }

        // Detect colorspace: 1=srgb, 2=srgb-linear, 3=display-p3, 4=a98-rgb,
        // 5=prophoto-rgb, 6=rec2020, 7=xyz-d65, 8=display-p3-linear, 9=xyz-d50
        cs_type = 0
        IfCondition LessThan(pi, slen) ThenBlock: {
            c1 = GetByte(str, pi)
            IfCondition EqualTo(c1, 115) ThenBlock: {
                // srgb or srgb-linear — check for '-l' at offset 4
                IfCondition LessThan(Add(pi, 5), slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, Add(pi, 5)), 108) ThenBlock: { cs_type = 2 }
                    IfCondition EqualTo(cs_type, 0) ThenBlock: { cs_type = 1 }
                } ElseBlock: {
                    cs_type = 1
                }
            }
            IfCondition EqualTo(c1, 100) ThenBlock: {
                // display-p3 or display-p3-linear — check char at offset 10
                cs_type = 3
                IfCondition LessThan(Add(pi, 11), slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, Add(pi, 10)), 45) ThenBlock: { cs_type = 8 }
                }
            }
            IfCondition EqualTo(c1, 97) ThenBlock: { cs_type = 4 }
            IfCondition EqualTo(c1, 112) ThenBlock: { cs_type = 5 }
            IfCondition EqualTo(c1, 114) ThenBlock: { cs_type = 6 }
            IfCondition EqualTo(c1, 120) ThenBlock: {
                // xyz, xyz-d65, or xyz-d50 — check for '-' at offset 3 (hyphen = part of name)
                cs_type = 7
                IfCondition LessThan(Add(pi, 6), slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, Add(pi, 3)), 45) ThenBlock: {
                        // Has hyphen: xyz-d50 or xyz-d65. Check '0' at offset 6
                        IfCondition EqualTo(GetByte(str, Add(pi, 6)), 48) ThenBlock: { cs_type = 9 }
                    }
                }
            }
        }

        // Skip colorspace name
        WhileLoop And(LessThan(pi, slen), NotEqual(GetByte(str, pi), 32)) { pi = Add(pi, 1) }

        cnt = LY__ColorParse3(str, pi)
        rv = ColorParse3.v0
        gv = ColorParse3.v1
        bv = ColorParse3.v2

        IfCondition EqualTo(cs_type, 1) ThenBlock: {
            // srgb: direct 0-1 → 0-255
            r = Divide(Multiply(rv, 255), 10000)
            g = Divide(Multiply(gv, 255), 10000)
            b = Divide(Multiply(bv, 255), 10000)
            IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
            ReturnValue(bgra)
        }
        IfCondition EqualTo(cs_type, 2) ThenBlock: {
            // srgb-linear: apply gamma
            r = LY__LinearToSRGB(rv)
            g = LY__LinearToSRGB(gv)
            b = LY__LinearToSRGB(bv)
            bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
            ReturnValue(bgra)
        }
        IfCondition EqualTo(cs_type, 3) ThenBlock: {
            // display-p3: inputs are gamma-encoded, linearize first
            rv_lin = LY__SRGBToLinear(rv)
            gv_lin = LY__SRGBToLinear(gv)
            bv_lin = LY__SRGBToLinear(bv)
            // P3 linear → sRGB linear matrix
            lr = Divide(Add(Add(Multiply(rv_lin, 12249), Multiply(gv_lin, -2247)), Multiply(bv_lin, 0)), 10000)
            lg = Divide(Add(Add(Multiply(rv_lin, -420), Multiply(gv_lin, 10419)), Multiply(bv_lin, 0)), 10000)
            lb = Divide(Add(Add(Multiply(rv_lin, -197), Multiply(gv_lin, -786)), Multiply(bv_lin, 10979)), 10000)
            // Snap near-zero and near-max to handle integer approximation noise
            IfCondition LessThan(lr, 15) ThenBlock: { lr = 0 }
            IfCondition LessThan(lg, 15) ThenBlock: { lg = 0 }
            IfCondition LessThan(lb, 15) ThenBlock: { lb = 0 }
            IfCondition GreaterThan(lr, 9985) ThenBlock: { lr = 10000 }
            IfCondition GreaterThan(lg, 9985) ThenBlock: { lg = 10000 }
            IfCondition GreaterThan(lb, 9985) ThenBlock: { lb = 10000 }
            r = LY__LinearToSRGB(lr)
            g = LY__LinearToSRGB(lg)
            b = LY__LinearToSRGB(lb)
            IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
            ReturnValue(bgra)
        }
        IfCondition EqualTo(cs_type, 4) ThenBlock: {
            // a98-rgb: gamma=563/256≈2.2 (dedicated linearizer)
            rv_lin = LY__A98ToLinear(rv)
            gv_lin = LY__A98ToLinear(gv)
            bv_lin = LY__A98ToLinear(bv)
            // a98 linear → sRGB linear (correct combined matrix)
            lr = Divide(Add(Add(Multiply(rv_lin, 13981), Multiply(gv_lin, -3983)), Multiply(bv_lin, 0)), 10000)
            lg = Divide(Add(Add(Multiply(rv_lin, 0), Multiply(gv_lin, 10000)), Multiply(bv_lin, 0)), 10000)
            lb = Divide(Add(Add(Multiply(rv_lin, 0), Multiply(gv_lin, -429)), Multiply(bv_lin, 10432)), 10000)
            // a98 piecewise has ~5% noise, need wider snap
            IfCondition LessThan(lr, 50) ThenBlock: { lr = 0 }
            IfCondition LessThan(lg, 50) ThenBlock: { lg = 0 }
            IfCondition LessThan(lb, 50) ThenBlock: { lb = 0 }
            IfCondition GreaterThan(lr, 9950) ThenBlock: { lr = 10000 }
            IfCondition GreaterThan(lg, 9950) ThenBlock: { lg = 10000 }
            IfCondition GreaterThan(lb, 9950) ThenBlock: { lb = 10000 }
            r = LY__LinearToSRGB(lr)
            g = LY__LinearToSRGB(lg)
            b = LY__LinearToSRGB(lb)
            IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
            ReturnValue(bgra)
        }
        IfCondition EqualTo(cs_type, 7) ThenBlock: {
            // xyz-d65: inputs are already linear, matrix to sRGB linear
            lr = Divide(Add(Add(Multiply(rv, 32406), Multiply(gv, -15372)), Multiply(bv, -4986)), 10000)
            lg = Divide(Add(Add(Multiply(rv, -9689), Multiply(gv, 18758)), Multiply(bv, 415)), 10000)
            lb = Divide(Add(Add(Multiply(rv, 557), Multiply(gv, -2040)), Multiply(bv, 10570)), 10000)
            IfCondition LessThan(lr, 15) ThenBlock: { lr = 0 }
            IfCondition LessThan(lg, 15) ThenBlock: { lg = 0 }
            IfCondition LessThan(lb, 15) ThenBlock: { lb = 0 }
            IfCondition GreaterThan(lr, 9985) ThenBlock: { lr = 10000 }
            IfCondition GreaterThan(lg, 9985) ThenBlock: { lg = 10000 }
            IfCondition GreaterThan(lb, 9985) ThenBlock: { lb = 10000 }
            r = LY__LinearToSRGB(lr)
            g = LY__LinearToSRGB(lg)
            b = LY__LinearToSRGB(lb)
            IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
            ReturnValue(bgra)
        }

        IfCondition EqualTo(cs_type, 8) ThenBlock: {
            // display-p3-linear: inputs are ALREADY linear P3, matrix to sRGB linear
            lr = Divide(Add(Add(Multiply(rv, 12249), Multiply(gv, -2247)), Multiply(bv, 0)), 10000)
            lg = Divide(Add(Add(Multiply(rv, -420), Multiply(gv, 10419)), Multiply(bv, 0)), 10000)
            lb = Divide(Add(Add(Multiply(rv, -197), Multiply(gv, -786)), Multiply(bv, 10979)), 10000)
            IfCondition LessThan(lr, 15) ThenBlock: { lr = 0 }
            IfCondition LessThan(lg, 15) ThenBlock: { lg = 0 }
            IfCondition LessThan(lb, 15) ThenBlock: { lb = 0 }
            IfCondition GreaterThan(lr, 9985) ThenBlock: { lr = 10000 }
            IfCondition GreaterThan(lg, 9985) ThenBlock: { lg = 10000 }
            IfCondition GreaterThan(lb, 9985) ThenBlock: { lb = 10000 }
            r = LY__LinearToSRGB(lr)
            g = LY__LinearToSRGB(lg)
            b = LY__LinearToSRGB(lb)
            IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
            ReturnValue(bgra)
        }
        IfCondition EqualTo(cs_type, 9) ThenBlock: {
            // xyz-d50: D50 XYZ → linear sRGB (Bradford + XYZ→sRGB combined matrix)
            lr = Divide(Add(Add(Multiply(rv, 31339), Multiply(gv, -16170)), Multiply(bv, -4907)), 10000)
            lg = Divide(Add(Add(Multiply(rv, -9785), Multiply(gv, 19162)), Multiply(bv, 334)), 10000)
            lb = Divide(Add(Add(Multiply(rv, 720), Multiply(gv, -2290)), Multiply(bv, 14053)), 10000)
            IfCondition LessThan(lr, 15) ThenBlock: { lr = 0 }
            IfCondition LessThan(lg, 15) ThenBlock: { lg = 0 }
            IfCondition LessThan(lb, 15) ThenBlock: { lb = 0 }
            IfCondition GreaterThan(lr, 9985) ThenBlock: { lr = 10000 }
            IfCondition GreaterThan(lg, 9985) ThenBlock: { lg = 10000 }
            IfCondition GreaterThan(lb, 9985) ThenBlock: { lb = 10000 }
            r = LY__LinearToSRGB(lr)
            g = LY__LinearToSRGB(lg)
            b = LY__LinearToSRGB(lb)
            IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
            ReturnValue(bgra)
        }

        IfCondition EqualTo(cs_type, 5) ThenBlock: {
            // prophoto-rgb: gamma 1.8, linearize then matrix
            rv_lin = LY__ProPhotoToLinear(rv)
            gv_lin = LY__ProPhotoToLinear(gv)
            bv_lin = LY__ProPhotoToLinear(bv)
            lr = Divide(Add(Add(Multiply(rv_lin, 20343), Multiply(gv_lin, -7273)), Multiply(bv_lin, -3067)), 10000)
            lg = Divide(Add(Add(Multiply(rv_lin, -2288), Multiply(gv_lin, 12317)), Multiply(bv_lin, -29)), 10000)
            lb = Divide(Add(Add(Multiply(rv_lin, -86), Multiply(gv_lin, -1533)), Multiply(bv_lin, 11617)), 10000)
            IfCondition LessThan(lr, 15) ThenBlock: { lr = 0 }
            IfCondition LessThan(lg, 15) ThenBlock: { lg = 0 }
            IfCondition LessThan(lb, 15) ThenBlock: { lb = 0 }
            IfCondition GreaterThan(lr, 9985) ThenBlock: { lr = 10000 }
            IfCondition GreaterThan(lg, 9985) ThenBlock: { lg = 10000 }
            IfCondition GreaterThan(lb, 9985) ThenBlock: { lb = 10000 }
            r = LY__LinearToSRGB(lr)
            g = LY__LinearToSRGB(lg)
            b = LY__LinearToSRGB(lb)
            IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
            ReturnValue(bgra)
        }
        IfCondition EqualTo(cs_type, 6) ThenBlock: {
            // rec2020: EOTF ((V+0.0993)/1.0993)^2.222
            rv_lin = LY__Rec2020ToLinear(rv)
            gv_lin = LY__Rec2020ToLinear(gv)
            bv_lin = LY__Rec2020ToLinear(bv)
            lr = Divide(Add(Add(Multiply(rv_lin, 16602), Multiply(gv_lin, -5875)), Multiply(bv_lin, -728)), 10000)
            lg = Divide(Add(Add(Multiply(rv_lin, -1246), Multiply(gv_lin, 11329)), Multiply(bv_lin, -83)), 10000)
            lb = Divide(Add(Add(Multiply(rv_lin, -182), Multiply(gv_lin, -1006)), Multiply(bv_lin, 11190)), 10000)
            IfCondition LessThan(lr, 15) ThenBlock: { lr = 0 }
            IfCondition LessThan(lg, 15) ThenBlock: { lg = 0 }
            IfCondition LessThan(lb, 15) ThenBlock: { lb = 0 }
            IfCondition GreaterThan(lr, 9985) ThenBlock: { lr = 10000 }
            IfCondition GreaterThan(lg, 9985) ThenBlock: { lg = 10000 }
            IfCondition GreaterThan(lb, 9985) ThenBlock: { lb = 10000 }
            r = LY__LinearToSRGB(lr)
            g = LY__LinearToSRGB(lg)
            b = LY__LinearToSRGB(lb)
            IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
            IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
            IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
            IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
            IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
            IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
            bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
            ReturnValue(bgra)
        }

        // Final fallback: unknown colorspace, treat as sRGB
        r = Divide(Multiply(rv, 255), 10000)
        g = Divide(Multiply(gv, 255), 10000)
        b = Divide(Multiply(bv, 255), 10000)
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }
        IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
        bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
        ReturnValue(bgra)
    }
}
