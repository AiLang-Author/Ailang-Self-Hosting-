        }
        IfCondition LessEqual(val, 6500) ThenBlock: {
            rv = Add(3987, Divide(Multiply(Subtract(val, 6000), 618), 500))
            ReturnValue(rv)
        }
        IfCondition LessEqual(val, 7000) ThenBlock: {
            rv = Add(4605, Divide(Multiply(Subtract(val, 6500), 657), 500))
            ReturnValue(rv)
        }
        IfCondition LessEqual(val, 7500) ThenBlock: {
            rv = Add(5262, Divide(Multiply(Subtract(val, 7000), 696), 500))
            ReturnValue(rv)
        }
        IfCondition LessEqual(val, 8000) ThenBlock: {
            rv = Add(5958, Divide(Multiply(Subtract(val, 7500), 734), 500))
