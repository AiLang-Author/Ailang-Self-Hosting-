// Library.HTMLLayoutColorAdv.ailang — Advanced CSS color parsing (HSL, HWB)
// HueToRGB helper, ParseHSL, ParseHWB with angle unit support.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils

// =============================================================================
// HSL / HSLA PARSER — parse hsl(H, S%, L%) and hsla(H, S%, L%, A)
// H = hue in degrees (0-360), S = saturation (0-100%), L = lightness (0-100%)
// Uses fixed-point arithmetic (multiply by 1000 for 3 decimal places)
// Returns BGRA color
// =============================================================================
Function.LY__HueToRGB {
    Input: p: Integer
    Input: q: Integer
    Input: t: Integer
    Output: Integer
    Body: {
        // All inputs scaled by 1000 (so 1.0 = 1000)
        // t is hue fraction * 1000
        ht = t
        IfCondition LessThan(ht, 0) ThenBlock: { ht = Add(ht, 1000) }
        IfCondition GreaterThan(ht, 1000) ThenBlock: { ht = Subtract(ht, 1000) }

        // if t < 1/6: p + (q-p) * 6 * t
        IfCondition LessThan(ht, 166) ThenBlock: {
            diff = Subtract(q, p)
            ReturnValue(Add(p, Divide(Multiply(Multiply(diff, 6), ht), 1000)))
        }
        // if t < 1/2: q
        IfCondition LessThan(ht, 500) ThenBlock: {
            ReturnValue(q)
        }
        // if t < 2/3: p + (q-p) * (2/3 - t) * 6
        IfCondition LessThan(ht, 666) ThenBlock: {
            diff = Subtract(q, p)
            ReturnValue(Add(p, Divide(Multiply(Multiply(diff, 6), Subtract(666, ht)), 1000)))
        }
        ReturnValue(p)
    }
}

Function.LY__ParseHSL {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        // Find opening paren
        pi = 0
        p_found = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(p_found, 0)) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: {
                p_found = 1
            } ElseBlock: {
                pi = Add(pi, 1)
            }
        }
        IfCondition EqualTo(p_found, 0) ThenBlock: { ReturnValue(0) }
        pi = Add(pi, 1)

        // Parse 3 numbers: H, S, L (reuse ParseRGB number parsing pattern)
        hsl_0 = 0
        hsl_1 = 0
        hsl_2 = 0
        vc = 0
        WhileLoop And(LessThan(vc, 3), LessThan(pi, slen)) {
            // Skip whitespace, commas, and CSS comments
            sk_done = 0
            WhileLoop And(LessThan(pi, slen), EqualTo(sk_done, 0)) {
                sc = GetByte(str, pi)
                sc_skip = 0
                IfCondition EqualTo(sc, 32) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 44) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 9) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 10) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 13) ThenBlock: { sc_skip = 1 }
                // Skip CSS comments: /* ... */
                IfCondition EqualTo(sc, 47) ThenBlock: {
                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 42) ThenBlock: {
                            pi = Add(pi, 2)
                            cm_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(cm_done, 0)) {
                                IfCondition EqualTo(GetByte(str, pi), 42) ThenBlock: {
                                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 47) ThenBlock: {
                                            pi = Add(pi, 2)
                                            cm_done = 1
                                        }
                                    }
                                }
                                IfCondition EqualTo(cm_done, 0) ThenBlock: {
                                    pi = Add(pi, 1)
                                }
                            }
                            sc_skip = 2  // already advanced past comment
                        }
                    }
                }
                IfCondition EqualTo(sc_skip, 1) ThenBlock: {
                    pi = Add(pi, 1)
                }
                IfCondition EqualTo(sc_skip, 0) ThenBlock: {
                    sk_done = 1
                }
            }
            // Check for closing paren or slash (alpha separator)
            IfCondition LessThan(pi, slen) ThenBlock: {
                ec = GetByte(str, pi)
                IfCondition EqualTo(ec, 41) ThenBlock: { vc = 3 }
                // Bare / is alpha separator; /* is comment (already handled above)
                IfCondition EqualTo(ec, 47) ThenBlock: {
                    is_cmt = 0
                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 42) ThenBlock: {
                            is_cmt = 1
                        }
                    }
                    IfCondition EqualTo(is_cmt, 0) ThenBlock: {
                        vc = 3  // alpha separator — stop
                    }
                }
            }
            // Parse number (integer + fractional x1000 for hue precision)
            IfCondition LessThan(vc, 3) ThenBlock: {
                num = 0
                num_frac = 0
                frac_div = 1
                is_neg = 0
                IfCondition LessThan(pi, slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, pi), 45) ThenBlock: {
                        is_neg = 1
                        pi = Add(pi, 1)
                    }
                }
                num_done = 0
                WhileLoop And(LessThan(pi, slen), EqualTo(num_done, 0)) {
                    dc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(dc, 48), LessEqual(dc, 57)) ThenBlock: {
                        num = Add(Multiply(num, 10), Subtract(dc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        // Parse decimal fraction into x1000 scale
                        IfCondition EqualTo(dc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            frac_mul = 100
                            frac_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(frac_done, 0)) {
                                fc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(fc, 48), LessEqual(fc, 57)) ThenBlock: {
                                    IfCondition GreaterThan(frac_mul, 0) ThenBlock: {
                                        num_frac = Add(num_frac, Multiply(Subtract(fc, 48), frac_mul))
                                        frac_mul = Divide(frac_mul, 10)
                                    }
                                    pi = Add(pi, 1)
                                } ElseBlock: {
                                    frac_done = 1
                                }
                            }
                        }
                        num_done = 1
                    }
                }
                // Handle scientific notation: e.g. 1.2e2 = 120
                // Check for 'e' or 'E' (101 or 69)
                IfCondition LessThan(pi, slen) ThenBlock: {
                    ec_ch = GetByte(str, pi)
                    IfCondition Or(EqualTo(ec_ch, 101), EqualTo(ec_ch, 69)) ThenBlock: {
                        pi = Add(pi, 1)
                        // Parse exponent sign and digits
                        exp_neg = 0
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            exp_s = GetByte(str, pi)
                            IfCondition EqualTo(exp_s, 43) ThenBlock: { pi = Add(pi, 1) }
                            IfCondition EqualTo(exp_s, 45) ThenBlock: {
                                exp_neg = 1
                                pi = Add(pi, 1)
                            }
                        }
                        exp_val = 0
                        exp_done = 0
                        WhileLoop And(LessThan(pi, slen), EqualTo(exp_done, 0)) {
                            exp_d = GetByte(str, pi)
                            IfCondition And(GreaterEqual(exp_d, 48), LessEqual(exp_d, 57)) ThenBlock: {
                                exp_val = Add(Multiply(exp_val, 10), Subtract(exp_d, 48))
                                pi = Add(pi, 1)
                            } ElseBlock: {
                                exp_done = 1
                            }
                        }
                        // Apply exponent: multiply or divide num and num_frac by 10^exp
                        IfCondition EqualTo(exp_neg, 0) ThenBlock: {
                            exp_i = 0
                            WhileLoop LessThan(exp_i, exp_val) {
                                num = Multiply(num, 10)
                                num_frac = Multiply(num_frac, 10)
                                // Carry from frac to int: frac >= 1000 → add to int
                                IfCondition GreaterEqual(num_frac, 1000) ThenBlock: {
                                    num = Add(num, Divide(num_frac, 1000))
                                    num_frac = Subtract(num_frac, Multiply(Divide(num_frac, 1000), 1000))
                                }
                                exp_i = Add(exp_i, 1)
                            }
                        } ElseBlock: {
                            // Negative exponent: divide
                            exp_i = 0
                            WhileLoop LessThan(exp_i, exp_val) {
                                num_frac = Add(num_frac, Multiply(Subtract(num, Multiply(Divide(num, 10), 10)), 100))
                                num = Divide(num, 10)
                                num_frac = Divide(num_frac, 10)
                                exp_i = Add(exp_i, 1)
                            }
                        }
                    }
                }
                // num_x1000 = integer * 1000 + fractional (always positive here)
                num_x1000 = Add(Multiply(num, 1000), num_frac)
                IfCondition EqualTo(is_neg, 1) ThenBlock: {
                    num = Subtract(0, num)
                    num_x1000 = Subtract(0, num_x1000)
                }
                // Handle angle unit suffix for hue (vc==0): deg, grad, rad, turn
                angle_unit = 0
                IfCondition LessThan(pi, slen) ThenBlock: {
                    sf = GetByte(str, pi)
                    IfCondition EqualTo(sf, 37) ThenBlock: { pi = Add(pi, 1) }
                    // 'd' for 'deg'
                    IfCondition EqualTo(sf, 100) ThenBlock: {
                        angle_unit = 1
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 101) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 103) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                    // 'g' for 'grad'
                    IfCondition EqualTo(sf, 103) ThenBlock: {
                        angle_unit = 2
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 114) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 97) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 100) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                    // 'r' for 'rad'
                    IfCondition EqualTo(sf, 114) ThenBlock: {
                        angle_unit = 3
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 97) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 100) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                    // 't' for 'turn'
                    IfCondition EqualTo(sf, 116) ThenBlock: {
                        angle_unit = 4
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 117) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 114) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 110) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                }
                // Convert angle units to degrees (only for hue = vc==0)
                IfCondition EqualTo(vc, 0) ThenBlock: {
                    // grad: degrees = value * 360 / 400 = value * 9 / 10
                    IfCondition EqualTo(angle_unit, 2) ThenBlock: {
                        num = Divide(Multiply(num_x1000, 9), 10000)
                    } ElseBlock: {
                        // rad: degrees = value * 180 / pi ≈ value * 5730 / 100000
                        // Using x1000 scale: num_x1000 * 5730 / 100000 = num_x1000 * 573 / 10000
                        IfCondition EqualTo(angle_unit, 3) ThenBlock: {
                            num = Divide(Multiply(num_x1000, 573), 10000)
                        } ElseBlock: {
                            // turn: degrees = value * 360
                            IfCondition EqualTo(angle_unit, 4) ThenBlock: {
                                num = Divide(Multiply(num_x1000, 360), 1000)
                            } ElseBlock: {
                                // deg or no unit: use integer part directly
                                num = Divide(num_x1000, 1000)
                            }
                        }
                    }
                }
                IfCondition EqualTo(vc, 0) ThenBlock: { hsl_0 = num }
                IfCondition EqualTo(vc, 1) ThenBlock: { hsl_1 = num }
                IfCondition EqualTo(vc, 2) ThenBlock: { hsl_2 = num }
                vc = Add(vc, 1)
            }
        }

        // Normalize: H to 0-360, S and L to 0-100
        hue = hsl_0
        WhileLoop LessThan(hue, 0) { hue = Add(hue, 360) }
        WhileLoop GreaterEqual(hue, 360) { hue = Subtract(hue, 360) }
        sat = hsl_1
        IfCondition LessThan(sat, 0) ThenBlock: { sat = 0 }
        IfCondition GreaterThan(sat, 100) ThenBlock: { sat = 100 }
        lit = hsl_2
        IfCondition LessThan(lit, 0) ThenBlock: { lit = 0 }
        IfCondition GreaterThan(lit, 100) ThenBlock: { lit = 100 }

        // Convert HSL to RGB using fixed-point (x1000)
        // s1000 = S/100 * 1000, l1000 = L/100 * 1000
        s1000 = Multiply(sat, 10)
        l1000 = Multiply(lit, 10)

        // If saturation is 0, it's a gray
        IfCondition EqualTo(s1000, 0) ThenBlock: {
            gray = Divide(Multiply(lit, 255), 100)
            bgra = Add(gray, Add(Multiply(gray, 256), Add(Multiply(gray, 65536), 4278190080)))
            ReturnValue(bgra)
        }

        // q = l < 0.5 ? l * (1+s) : l + s - l*s
        IfCondition LessThan(l1000, 500) ThenBlock: {
            q1000 = Divide(Multiply(l1000, Add(1000, s1000)), 1000)
        } ElseBlock: {
            q1000 = Subtract(Add(l1000, s1000), Divide(Multiply(l1000, s1000), 1000))
        }
        // p = 2*l - q
        p1000 = Subtract(Multiply(2, l1000), q1000)

        // h_frac = hue / 360 * 1000
        h_frac = Divide(Multiply(hue, 1000), 360)

        // R = hueToRGB(p, q, h + 1/3)
        r1000 = LY__HueToRGB(p1000, q1000, Add(h_frac, 333))
        // G = hueToRGB(p, q, h)
        g1000 = LY__HueToRGB(p1000, q1000, h_frac)
        // B = hueToRGB(p, q, h - 1/3)
        b1000 = LY__HueToRGB(p1000, q1000, Subtract(h_frac, 333))

        // Convert to 0-255
        r = Divide(Multiply(r1000, 255), 1000)
        g = Divide(Multiply(g1000, 255), 1000)
        b = Divide(Multiply(b1000, 255), 1000)
        IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }

        // Parse optional alpha (4th value after comma or slash)
        alpha_1000 = 1000  // default: fully opaque
        // After vc=3, pi should be past the 3rd number; skip whitespace/comma/slash
        a_sk = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(a_sk, 0)) {
            ac = GetByte(str, pi)
            IfCondition EqualTo(ac, 32) ThenBlock: { pi = Add(pi, 1) }
            ElseBlock: {
                IfCondition EqualTo(ac, 44) ThenBlock: { pi = Add(pi, 1) }
                ElseBlock: {
                    IfCondition EqualTo(ac, 47) ThenBlock: { pi = Add(pi, 1) }
                    ElseBlock: {
                        IfCondition EqualTo(ac, 9) ThenBlock: { pi = Add(pi, 1) }
                        ElseBlock: {
                            IfCondition EqualTo(ac, 10) ThenBlock: { pi = Add(pi, 1) }
                            ElseBlock: { a_sk = 1 }
                        }
                    }
                }
            }
        }
        // Parse alpha number if present (not a closing paren)
        IfCondition LessThan(pi, slen) ThenBlock: {
            apc = GetByte(str, pi)
            IfCondition EqualTo(EqualTo(apc, 41), 0) ThenBlock: {
                // Parse alpha as fixed-point x1000
                a_int = 0
                a_frac = 0
                a_frac_mul = 100
                a_done = 0
                // Skip leading whitespace
                WhileLoop And(LessThan(pi, slen), EqualTo(a_done, 0)) {
                    adc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(adc, 48), LessEqual(adc, 57)) ThenBlock: {
                        a_int = Add(Multiply(a_int, 10), Subtract(adc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(adc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            af_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(af_done, 0)) {
                                afc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(afc, 48), LessEqual(afc, 57)) ThenBlock: {
                                    IfCondition GreaterThan(a_frac_mul, 0) ThenBlock: {
                                        a_frac = Add(a_frac, Multiply(Subtract(afc, 48), a_frac_mul))
                                        a_frac_mul = Divide(a_frac_mul, 10)
                                    }
                                    pi = Add(pi, 1)
                                } ElseBlock: { af_done = 1 }
                            }
                        }
                        a_done = 1
                    }
                }
                // alpha_1000 = integer_part * 1000 + frac_part
                // For 0.2 -> a_int=0, a_frac=200 -> alpha_1000=200
                // For 1.0 -> a_int=1, a_frac=0 -> alpha_1000=1000
                alpha_1000 = Add(Multiply(a_int, 1000), a_frac)
                IfCondition GreaterThan(alpha_1000, 1000) ThenBlock: { alpha_1000 = 1000 }
                IfCondition LessThan(alpha_1000, 0) ThenBlock: { alpha_1000 = 0 }
            }
        }

        // Apply alpha: blend against white background
        // result = color * alpha + 255 * (1 - alpha)
        IfCondition LessThan(alpha_1000, 1000) ThenBlock: {
            r = Divide(Add(Multiply(r, alpha_1000), Multiply(255, Subtract(1000, alpha_1000))), 1000)
            g = Divide(Add(Multiply(g, alpha_1000), Multiply(255, Subtract(1000, alpha_1000))), 1000)
            b = Divide(Add(Multiply(b, alpha_1000), Multiply(255, Subtract(1000, alpha_1000))), 1000)
        }

        bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
        ReturnValue(bgra)
    }
}

// =============================================================================
// HWB PARSER — parse hwb(H, W%, B%) and hwb(H W% B% / A)
// H = hue in degrees (0-360), W = whiteness (0-100%), B = blackness (0-100%)
// Conversion: mix hsl(H, 100%, 50%) with white (W) and black (B)
// Returns BGRA color
// =============================================================================
Function.LY__ParseHWB {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        // Find opening paren
        pi = 0
        p_found = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(p_found, 0)) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: {
                p_found = 1
            } ElseBlock: {
                pi = Add(pi, 1)
            }
        }
        IfCondition EqualTo(p_found, 0) ThenBlock: { ReturnValue(0) }
        pi = Add(pi, 1)

        // Parse 3 numbers: H, W, B
        hwb_0 = 0
        hwb_1 = 0
        hwb_2 = 0
        vc = 0
        WhileLoop And(LessThan(vc, 3), LessThan(pi, slen)) {
            // Skip whitespace, commas
            sk_done = 0
            WhileLoop And(LessThan(pi, slen), EqualTo(sk_done, 0)) {
                sc = GetByte(str, pi)
                sc_skip = 0
                IfCondition EqualTo(sc, 32) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 44) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 9) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 10) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 13) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc_skip, 1) ThenBlock: {
                    pi = Add(pi, 1)
                }
                IfCondition EqualTo(sc_skip, 0) ThenBlock: {
                    sk_done = 1
                }
            }
            // Check for closing paren or slash (alpha separator)
            IfCondition LessThan(pi, slen) ThenBlock: {
                ec = GetByte(str, pi)
                IfCondition EqualTo(ec, 41) ThenBlock: { vc = 3 }
                IfCondition EqualTo(ec, 47) ThenBlock: { vc = 3 }
            }
            // Parse number
            IfCondition LessThan(vc, 3) ThenBlock: {
                num = 0
                is_neg = 0
                IfCondition LessThan(pi, slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, pi), 45) ThenBlock: {
                        is_neg = 1
                        pi = Add(pi, 1)
                    }
                }
                num_done = 0
                WhileLoop And(LessThan(pi, slen), EqualTo(num_done, 0)) {
                    dc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(dc, 48), LessEqual(dc, 57)) ThenBlock: {
                        num = Add(Multiply(num, 10), Subtract(dc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(dc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            frac_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(frac_done, 0)) {
                                fc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(fc, 48), LessEqual(fc, 57)) ThenBlock: {
                                    pi = Add(pi, 1)
                                } ElseBlock: {
                                    frac_done = 1
                                }
                            }
                        }
                        num_done = 1
                    }
                }
                IfCondition EqualTo(is_neg, 1) ThenBlock: { num = Subtract(0, num) }
                // Skip % or 'deg' suffix
                IfCondition LessThan(pi, slen) ThenBlock: {
                    sf = GetByte(str, pi)
                    IfCondition EqualTo(sf, 37) ThenBlock: { pi = Add(pi, 1) }
                    IfCondition EqualTo(sf, 100) ThenBlock: {
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 101) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 103) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                }
                IfCondition EqualTo(vc, 0) ThenBlock: { hwb_0 = num }
                IfCondition EqualTo(vc, 1) ThenBlock: { hwb_1 = num }
                IfCondition EqualTo(vc, 2) ThenBlock: { hwb_2 = num }
                vc = Add(vc, 1)
            }
        }

        // Normalize: H to 0-360, W and B to 0-100
        hue = hwb_0
        WhileLoop LessThan(hue, 0) { hue = Add(hue, 360) }
        WhileLoop GreaterEqual(hue, 360) { hue = Subtract(hue, 360) }
        wt = hwb_1
        IfCondition LessThan(wt, 0) ThenBlock: { wt = 0 }
        IfCondition GreaterThan(wt, 100) ThenBlock: { wt = 100 }
        bk = hwb_2
        IfCondition LessThan(bk, 0) ThenBlock: { bk = 0 }
        IfCondition GreaterThan(bk, 100) ThenBlock: { bk = 100 }

        // If whiteness + blackness >= 100, result is gray
        wb_sum = Add(wt, bk)
        IfCondition GreaterEqual(wb_sum, 100) ThenBlock: {
            // gray = whiteness / (whiteness + blackness) * 255
            gray = Divide(Multiply(wt, 255), wb_sum)
            bgra = Add(gray, Add(Multiply(gray, 256), Add(Multiply(gray, 65536), 4278190080)))
            ReturnValue(bgra)
        }

        // Get pure hue color via HSL (S=100%, L=50%) using HueToRGB
        h_frac = Divide(Multiply(hue, 1000), 360)
        // For S=100%, L=50%: p=0, q=1000
        r1000 = LY__HueToRGB(0, 1000, Add(h_frac, 333))
        g1000 = LY__HueToRGB(0, 1000, h_frac)
        b1000 = LY__HueToRGB(0, 1000, Subtract(h_frac, 333))

        // Mix with white and black: color = color * (1 - W - B) + W
        // Using x1000 scale: factor = 1000 - W*10 - B*10
        factor = Subtract(1000, Add(Multiply(wt, 10), Multiply(bk, 10)))
        w1000 = Multiply(wt, 10)

        r_final = Divide(Add(Multiply(r1000, factor), Multiply(w1000, 1000)), 1000)
        g_final = Divide(Add(Multiply(g1000, factor), Multiply(w1000, 1000)), 1000)
        b_final = Divide(Add(Multiply(b1000, factor), Multiply(w1000, 1000)), 1000)

        r = Divide(Multiply(r_final, 255), 1000)
        g = Divide(Multiply(g_final, 255), 1000)
        b = Divide(Multiply(b_final, 255), 1000)
        IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }

        bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
        ReturnValue(bgra)
    }
}
