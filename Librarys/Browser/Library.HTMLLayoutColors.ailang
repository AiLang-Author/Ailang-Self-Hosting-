// Library.HTMLLayoutColors.ailang — CSS color and value parsing for layout engine
// Handles named colors, hex, rgb(), hsl(), hwb(), px/em/vw/vh/% values.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.Browser.CSSParse

// =============================================================================
// HEADING SCALE — returns font scale for heading tags
// =============================================================================
Function.LY__HeadingScale {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(tag, "h1"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(tag, "h2"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(tag, "h3"), 0) ThenBlock: { ReturnValue(2) }
        ReturnValue(1)
    }
}

// =============================================================================
// COLOR PARSING — CSS color name or hex to BGRA
// =============================================================================
Function.LY__ParseColor {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }

        // Check for hex color #RGB or #RRGGBB
        c0 = GetByte(str, 0)
        IfCondition EqualTo(c0, 35) ThenBlock: {
            slen = StringLength(str)
            IfCondition EqualTo(slen, 7) ThenBlock: {
                // #RRGGBB — parse hex digits
                r = LY__HexPair(str, 1)
                g = LY__HexPair(str, 3)
                b = LY__HexPair(str, 5)
                // BGRA format: B | (G<<8) | (R<<16) | (0xFF<<24)
                bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
                ReturnValue(bgra)
            }
            IfCondition EqualTo(slen, 4) ThenBlock: {
                // #RGB — expand each digit
                r1 = LY__HexDigit(str, 1)
                g1 = LY__HexDigit(str, 2)
                b1 = LY__HexDigit(str, 3)
                r = Add(Multiply(r1, 16), r1)
                g = Add(Multiply(g1, 16), g1)
                b = Add(Multiply(b1, 16), b1)
                bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
                ReturnValue(bgra)
            }
            IfCondition EqualTo(slen, 9) ThenBlock: {
                // #RRGGBBAA — parse 8-digit hex (ignore alpha, treat as opaque)
                r = LY__HexPair(str, 1)
                g = LY__HexPair(str, 3)
                b = LY__HexPair(str, 5)
                bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
                ReturnValue(bgra)
            }
            IfCondition EqualTo(slen, 5) ThenBlock: {
                // #RGBA — expand each digit (ignore alpha)
                r1 = LY__HexDigit(str, 1)
                g1 = LY__HexDigit(str, 2)
                b1 = LY__HexDigit(str, 3)
                r = Add(Multiply(r1, 16), r1)
                g = Add(Multiply(g1, 16), g1)
                b = Add(Multiply(b1, 16), b1)
                bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
                ReturnValue(bgra)
            }
            // Unknown hex length — treat as transparent
            ReturnValue(0)
        }

        // Keywords that mean "no color"
        IfCondition EqualTo(StringCompare(str, "none"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(str, "initial"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(str, "inherit"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(str, "unset"), 0) ThenBlock: { ReturnValue(0) }
        // currentcolor — sentinel value 1, callers resolve to LYState.fg_color
        IfCondition EqualTo(StringCompare(str, "currentcolor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(str, "currentColor"), 0) ThenBlock: { ReturnValue(1) }

        // rgb() / rgba() functional notation
        IfCondition EqualTo(GetByte(str, 0), 114) ThenBlock: {
            IfCondition EqualTo(GetByte(str, 1), 103) ThenBlock: {
                IfCondition EqualTo(GetByte(str, 2), 98) ThenBlock: {
                    rgb_res = LY__ParseRGB(str)
                    ReturnValue(rgb_res)
                }
            }
        }
        IfCondition EqualTo(GetByte(str, 0), 118) ThenBlock: {
            // starts with 'v' — check var(
            IfCondition EqualTo(GetByte(str, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(str, 2), 114) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, 3), 40) ThenBlock: {
                        resolved_var = CSS_ResolveVarExpr(str)
                        IfCondition NotEqual(resolved_var, 0) ThenBlock: {
                            var_color = LY__ParseColor(resolved_var)
                            ReturnValue(var_color)
                        }
                        ReturnValue(0)
                    }
                }
            }
        }
        IfCondition EqualTo(GetByte(str, 0), 104) ThenBlock: {
            // starts with 'h' — check hsl( / hsla( / hwb(
            IfCondition EqualTo(GetByte(str, 1), 115) ThenBlock: {
                hsl_res = LY__ParseHSL(str)
                ReturnValue(hsl_res)
            }
            IfCondition EqualTo(GetByte(str, 1), 119) ThenBlock: {
                // hw -> hwb(
                IfCondition EqualTo(GetByte(str, 2), 98) ThenBlock: {
                    hwb_res = LY__ParseHWB(str)
                    ReturnValue(hwb_res)
                }
            }
        }

        // Named colors — BGRA format: B + G*256 + R*65536 + 0xFF*16777216
        IfCondition EqualTo(StringCompare(str, "black"), 0) ThenBlock: {
            ReturnValue(4278190080) // 0xFF000000
        }
        IfCondition EqualTo(StringCompare(str, "white"), 0) ThenBlock: {
            ReturnValue(4294967295) // 0xFFFFFFFF
        }
        IfCondition EqualTo(StringCompare(str, "red"), 0) ThenBlock: {
            ReturnValue(4294901760) // 0xFFFF0000 R=255,G=0,B=0
        }
        IfCondition EqualTo(StringCompare(str, "green"), 0) ThenBlock: {
            ReturnValue(4278222848) // 0xFF008000 R=0,G=128,B=0
        }
        IfCondition EqualTo(StringCompare(str, "blue"), 0) ThenBlock: {
            ReturnValue(4278190335) // 0xFF0000FF R=0,G=0,B=255
        }
        IfCondition EqualTo(StringCompare(str, "gray"), 0) ThenBlock: {
            ReturnValue(4286611584) // 0xFF808080
        }
        IfCondition EqualTo(StringCompare(str, "grey"), 0) ThenBlock: {
            ReturnValue(4286611584) // 0xFF808080
        }
        IfCondition EqualTo(StringCompare(str, "silver"), 0) ThenBlock: {
            ReturnValue(4290822336) // 0xFFC0C0C0
        }
        IfCondition EqualTo(StringCompare(str, "navy"), 0) ThenBlock: {
            ReturnValue(4278190208) // 0xFF000080 R=0,G=0,B=128
        }
        IfCondition EqualTo(StringCompare(str, "teal"), 0) ThenBlock: {
            ReturnValue(4278222976) // 0xFF008080 R=0,G=128,B=128
        }
        IfCondition EqualTo(StringCompare(str, "purple"), 0) ThenBlock: {
            ReturnValue(4286578816) // 0xFF800080 R=128,G=0,B=128
        }
        IfCondition EqualTo(StringCompare(str, "orange"), 0) ThenBlock: {
            ReturnValue(4294944000) // 0xFFFFA500 R=255,G=165,B=0
        }
        IfCondition EqualTo(StringCompare(str, "yellow"), 0) ThenBlock: {
            ReturnValue(4294967040) // 0xFFFFFF00 R=255,G=255,B=0
        }
        IfCondition EqualTo(StringCompare(str, "transparent"), 0) ThenBlock: {
            ReturnValue(0)
        }
        // Extended named colors (BGRA = B + G*256 + R*65536 + 0xFF*16777216)
        IfCondition EqualTo(StringCompare(str, "maroon"), 0) ThenBlock: { ReturnValue(4286578688) }
        IfCondition EqualTo(StringCompare(str, "olive"), 0) ThenBlock: { ReturnValue(4286611456) }
        IfCondition EqualTo(StringCompare(str, "lime"), 0) ThenBlock: { ReturnValue(4278255360) }
        IfCondition EqualTo(StringCompare(str, "aqua"), 0) ThenBlock: { ReturnValue(4278255615) }
        IfCondition EqualTo(StringCompare(str, "cyan"), 0) ThenBlock: { ReturnValue(4278255615) }
        IfCondition EqualTo(StringCompare(str, "fuchsia"), 0) ThenBlock: { ReturnValue(4294902015) }
        IfCondition EqualTo(StringCompare(str, "magenta"), 0) ThenBlock: { ReturnValue(4294902015) }
        IfCondition EqualTo(StringCompare(str, "pink"), 0) ThenBlock: { ReturnValue(4294951115) }
        IfCondition EqualTo(StringCompare(str, "brown"), 0) ThenBlock: { ReturnValue(4289014314) }
        IfCondition EqualTo(StringCompare(str, "coral"), 0) ThenBlock: { ReturnValue(4294934352) }
        IfCondition EqualTo(StringCompare(str, "gold"), 0) ThenBlock: { ReturnValue(4294956800) }
        IfCondition EqualTo(StringCompare(str, "khaki"), 0) ThenBlock: { ReturnValue(4293977740) }
        IfCondition EqualTo(StringCompare(str, "tomato"), 0) ThenBlock: { ReturnValue(4294927175) }
        IfCondition EqualTo(StringCompare(str, "tan"), 0) ThenBlock: { ReturnValue(4291998860) }
        IfCondition EqualTo(StringCompare(str, "wheat"), 0) ThenBlock: { ReturnValue(4294303411) }
        IfCondition EqualTo(StringCompare(str, "ivory"), 0) ThenBlock: { ReturnValue(4294967280) }
        IfCondition EqualTo(StringCompare(str, "beige"), 0) ThenBlock: { ReturnValue(4294309340) }
        IfCondition EqualTo(StringCompare(str, "linen"), 0) ThenBlock: { ReturnValue(4294635750) }
        IfCondition EqualTo(StringCompare(str, "salmon"), 0) ThenBlock: { ReturnValue(4294606962) }
        IfCondition EqualTo(StringCompare(str, "crimson"), 0) ThenBlock: { ReturnValue(4292613180) }
        IfCondition EqualTo(StringCompare(str, "indigo"), 0) ThenBlock: { ReturnValue(4283105410) }
        IfCondition EqualTo(StringCompare(str, "violet"), 0) ThenBlock: { ReturnValue(4293821166) }
        IfCondition EqualTo(StringCompare(str, "plum"), 0) ThenBlock: { ReturnValue(4292714717) }
        IfCondition EqualTo(StringCompare(str, "orchid"), 0) ThenBlock: { ReturnValue(4292505814) }
        IfCondition EqualTo(StringCompare(str, "chocolate"), 0) ThenBlock: { ReturnValue(4291979550) }
        IfCondition EqualTo(StringCompare(str, "sienna"), 0) ThenBlock: { ReturnValue(4288696877) }
        IfCondition EqualTo(StringCompare(str, "peru"), 0) ThenBlock: { ReturnValue(4291659071) }
        IfCondition EqualTo(StringCompare(str, "skyblue"), 0) ThenBlock: { ReturnValue(4287090411) }
        IfCondition EqualTo(StringCompare(str, "steelblue"), 0) ThenBlock: { ReturnValue(4282811060) }
        IfCondition EqualTo(StringCompare(str, "slategray"), 0) ThenBlock: { ReturnValue(4285563024) }
        IfCondition EqualTo(StringCompare(str, "darkgray"), 0) ThenBlock: { ReturnValue(4289309097) }
        IfCondition EqualTo(StringCompare(str, "darkgrey"), 0) ThenBlock: { ReturnValue(4289309097) }
        IfCondition EqualTo(StringCompare(str, "lightgray"), 0) ThenBlock: { ReturnValue(4292072403) }
        IfCondition EqualTo(StringCompare(str, "lightgrey"), 0) ThenBlock: { ReturnValue(4292072403) }
        IfCondition EqualTo(StringCompare(str, "dimgray"), 0) ThenBlock: { ReturnValue(4285098345) }
        IfCondition EqualTo(StringCompare(str, "whitesmoke"), 0) ThenBlock: { ReturnValue(4294309365) }
        IfCondition EqualTo(StringCompare(str, "gainsboro"), 0) ThenBlock: { ReturnValue(4292664540) }

        // Additional CSS named colors
        IfCondition EqualTo(StringCompare(str, "rebeccapurple"), 0) ThenBlock: { ReturnValue(4284887961) }
        IfCondition EqualTo(StringCompare(str, "orangered"), 0) ThenBlock: { ReturnValue(4294919424) }
        IfCondition EqualTo(StringCompare(str, "hotpink"), 0) ThenBlock: { ReturnValue(4290987578) }
        IfCondition EqualTo(StringCompare(str, "deeppink"), 0) ThenBlock: { ReturnValue(4293874390) }
        IfCondition EqualTo(StringCompare(str, "darkred"), 0) ThenBlock: { ReturnValue(4287299584) }
        IfCondition EqualTo(StringCompare(str, "darkgreen"), 0) ThenBlock: { ReturnValue(4278222848) }
        IfCondition EqualTo(StringCompare(str, "darkblue"), 0) ThenBlock: { ReturnValue(4278190219) }
        IfCondition EqualTo(StringCompare(str, "darkcyan"), 0) ThenBlock: { ReturnValue(4278222976) }
        IfCondition EqualTo(StringCompare(str, "darkmagenta"), 0) ThenBlock: { ReturnValue(4287299723) }
        IfCondition EqualTo(StringCompare(str, "darkorange"), 0) ThenBlock: { ReturnValue(4294937600) }
        IfCondition EqualTo(StringCompare(str, "darkviolet"), 0) ThenBlock: { ReturnValue(4292018324) }
        IfCondition EqualTo(StringCompare(str, "lightblue"), 0) ThenBlock: { ReturnValue(4293318829) }
        IfCondition EqualTo(StringCompare(str, "lightgreen"), 0) ThenBlock: { ReturnValue(4287688336) }
        IfCondition EqualTo(StringCompare(str, "lightyellow"), 0) ThenBlock: { ReturnValue(4294967264) }
        IfCondition EqualTo(StringCompare(str, "lightcoral"), 0) ThenBlock: { ReturnValue(4289999360) }
        IfCondition EqualTo(StringCompare(str, "lightcyan"), 0) ThenBlock: { ReturnValue(4292935679) }
        IfCondition EqualTo(StringCompare(str, "lightpink"), 0) ThenBlock: { ReturnValue(4294634455) }
        IfCondition EqualTo(StringCompare(str, "lightsalmon"), 0) ThenBlock: { ReturnValue(4294942842) }
        IfCondition EqualTo(StringCompare(str, "mediumblue"), 0) ThenBlock: { ReturnValue(4278190285) }
        IfCondition EqualTo(StringCompare(str, "greenyellow"), 0) ThenBlock: { ReturnValue(4281335725) }
        IfCondition EqualTo(StringCompare(str, "limegreen"), 0) ThenBlock: { ReturnValue(4281519410) }
        IfCondition EqualTo(StringCompare(str, "royalblue"), 0) ThenBlock: { ReturnValue(4292281093) }
        IfCondition EqualTo(StringCompare(str, "dodgerblue"), 0) ThenBlock: { ReturnValue(4294924574) }
        IfCondition EqualTo(StringCompare(str, "cornflowerblue"), 0) ThenBlock: { ReturnValue(4293760356) }

        // Remaining CSS4 named colors (full 148-color set)
        IfCondition EqualTo(StringCompare(str, "aliceblue"), 0) ThenBlock: { ReturnValue(4293982463) }
        IfCondition EqualTo(StringCompare(str, "antiquewhite"), 0) ThenBlock: { ReturnValue(4294634455) }
        IfCondition EqualTo(StringCompare(str, "aquamarine"), 0) ThenBlock: { ReturnValue(4286578644) }
        IfCondition EqualTo(StringCompare(str, "azure"), 0) ThenBlock: { ReturnValue(4293984255) }
        IfCondition EqualTo(StringCompare(str, "bisque"), 0) ThenBlock: { ReturnValue(4294960324) }
        IfCondition EqualTo(StringCompare(str, "blanchedalmond"), 0) ThenBlock: { ReturnValue(4294962125) }
        IfCondition EqualTo(StringCompare(str, "blueviolet"), 0) ThenBlock: { ReturnValue(4287245282) }
        IfCondition EqualTo(StringCompare(str, "burlywood"), 0) ThenBlock: { ReturnValue(4292786311) }
        IfCondition EqualTo(StringCompare(str, "cadetblue"), 0) ThenBlock: { ReturnValue(4284456608) }
        IfCondition EqualTo(StringCompare(str, "chartreuse"), 0) ThenBlock: { ReturnValue(4286578432) }
        IfCondition EqualTo(StringCompare(str, "cornsilk"), 0) ThenBlock: { ReturnValue(4294965468) }
        IfCondition EqualTo(StringCompare(str, "darkgoldenrod"), 0) ThenBlock: { ReturnValue(4290283019) }
        IfCondition EqualTo(StringCompare(str, "darkkhaki"), 0) ThenBlock: { ReturnValue(4290623339) }
        IfCondition EqualTo(StringCompare(str, "darkolivegreen"), 0) ThenBlock: { ReturnValue(4283788079) }
        IfCondition EqualTo(StringCompare(str, "darksalmon"), 0) ThenBlock: { ReturnValue(4293498490) }
        IfCondition EqualTo(StringCompare(str, "darkseagreen"), 0) ThenBlock: { ReturnValue(4287609999) }
        IfCondition EqualTo(StringCompare(str, "darkslateblue"), 0) ThenBlock: { ReturnValue(4282924427) }
        IfCondition EqualTo(StringCompare(str, "darkslategray"), 0) ThenBlock: { ReturnValue(4281290575) }
        IfCondition EqualTo(StringCompare(str, "darkslategrey"), 0) ThenBlock: { ReturnValue(4281290575) }
        IfCondition EqualTo(StringCompare(str, "darkturquoise"), 0) ThenBlock: { ReturnValue(4278243025) }
        IfCondition EqualTo(StringCompare(str, "deepskyblue"), 0) ThenBlock: { ReturnValue(4278239231) }
        IfCondition EqualTo(StringCompare(str, "firebrick"), 0) ThenBlock: { ReturnValue(4289864226) }
        IfCondition EqualTo(StringCompare(str, "floralwhite"), 0) ThenBlock: { ReturnValue(4294966000) }
        IfCondition EqualTo(StringCompare(str, "forestgreen"), 0) ThenBlock: { ReturnValue(4280453922) }
        IfCondition EqualTo(StringCompare(str, "ghostwhite"), 0) ThenBlock: { ReturnValue(4294506751) }
        IfCondition EqualTo(StringCompare(str, "goldenrod"), 0) ThenBlock: { ReturnValue(4292519200) }
        IfCondition EqualTo(StringCompare(str, "honeydew"), 0) ThenBlock: { ReturnValue(4293984240) }
        IfCondition EqualTo(StringCompare(str, "indianred"), 0) ThenBlock: { ReturnValue(4291648604) }
        IfCondition EqualTo(StringCompare(str, "lavender"), 0) ThenBlock: { ReturnValue(4293322490) }
        IfCondition EqualTo(StringCompare(str, "lavenderblush"), 0) ThenBlock: { ReturnValue(4294963445) }
        IfCondition EqualTo(StringCompare(str, "lawngreen"), 0) ThenBlock: { ReturnValue(4286381056) }
        IfCondition EqualTo(StringCompare(str, "lemonchiffon"), 0) ThenBlock: { ReturnValue(4294965965) }
        IfCondition EqualTo(StringCompare(str, "lightseagreen"), 0) ThenBlock: { ReturnValue(4280332970) }
        IfCondition EqualTo(StringCompare(str, "lightslategray"), 0) ThenBlock: { ReturnValue(4286023833) }
        IfCondition EqualTo(StringCompare(str, "lightslategrey"), 0) ThenBlock: { ReturnValue(4286023833) }
        IfCondition EqualTo(StringCompare(str, "lightsteelblue"), 0) ThenBlock: { ReturnValue(4289774814) }
        IfCondition EqualTo(StringCompare(str, "mediumaquamarine"), 0) ThenBlock: { ReturnValue(4284927402) }
        IfCondition EqualTo(StringCompare(str, "mediumorchid"), 0) ThenBlock: { ReturnValue(4290401747) }
        IfCondition EqualTo(StringCompare(str, "mediumpurple"), 0) ThenBlock: { ReturnValue(4287852763) }
        IfCondition EqualTo(StringCompare(str, "mediumseagreen"), 0) ThenBlock: { ReturnValue(4282168177) }
        IfCondition EqualTo(StringCompare(str, "mediumslateblue"), 0) ThenBlock: { ReturnValue(4286277870) }
        IfCondition EqualTo(StringCompare(str, "mediumspringgreen"), 0) ThenBlock: { ReturnValue(4278254234) }
        IfCondition EqualTo(StringCompare(str, "mediumturquoise"), 0) ThenBlock: { ReturnValue(4282962380) }
        IfCondition EqualTo(StringCompare(str, "mediumvioletred"), 0) ThenBlock: { ReturnValue(4291237253) }
        IfCondition EqualTo(StringCompare(str, "midnightblue"), 0) ThenBlock: { ReturnValue(4279834992) }
        IfCondition EqualTo(StringCompare(str, "mintcream"), 0) ThenBlock: { ReturnValue(4294311930) }
        IfCondition EqualTo(StringCompare(str, "mistyrose"), 0) ThenBlock: { ReturnValue(4294960353) }
        IfCondition EqualTo(StringCompare(str, "moccasin"), 0) ThenBlock: { ReturnValue(4294960309) }
        IfCondition EqualTo(StringCompare(str, "navajowhite"), 0) ThenBlock: { ReturnValue(4294958765) }
        IfCondition EqualTo(StringCompare(str, "oldlace"), 0) ThenBlock: { ReturnValue(4294833638) }
        IfCondition EqualTo(StringCompare(str, "olivedrab"), 0) ThenBlock: { ReturnValue(4285238819) }
        IfCondition EqualTo(StringCompare(str, "palegreen"), 0) ThenBlock: { ReturnValue(4288215960) }
        IfCondition EqualTo(StringCompare(str, "palegoldenrod"), 0) ThenBlock: { ReturnValue(4293847210) }
        IfCondition EqualTo(StringCompare(str, "paleturquoise"), 0) ThenBlock: { ReturnValue(4289720046) }
        IfCondition EqualTo(StringCompare(str, "palevioletred"), 0) ThenBlock: { ReturnValue(4292571283) }
        IfCondition EqualTo(StringCompare(str, "papayawhip"), 0) ThenBlock: { ReturnValue(4294963157) }
        IfCondition EqualTo(StringCompare(str, "peachpuff"), 0) ThenBlock: { ReturnValue(4294957753) }
        IfCondition EqualTo(StringCompare(str, "powderblue"), 0) ThenBlock: { ReturnValue(4289781990) }
        IfCondition EqualTo(StringCompare(str, "rosybrown"), 0) ThenBlock: { ReturnValue(4290547599) }
        IfCondition EqualTo(StringCompare(str, "saddlebrown"), 0) ThenBlock: { ReturnValue(4287317267) }
        IfCondition EqualTo(StringCompare(str, "sandybrown"), 0) ThenBlock: { ReturnValue(4294222944) }
        IfCondition EqualTo(StringCompare(str, "seagreen"), 0) ThenBlock: { ReturnValue(4281240407) }
        IfCondition EqualTo(StringCompare(str, "seashell"), 0) ThenBlock: { ReturnValue(4294964718) }
        IfCondition EqualTo(StringCompare(str, "slateblue"), 0) ThenBlock: { ReturnValue(4285160141) }
        IfCondition EqualTo(StringCompare(str, "slategrey"), 0) ThenBlock: { ReturnValue(4285563024) }
        IfCondition EqualTo(StringCompare(str, "snow"), 0) ThenBlock: { ReturnValue(4294966010) }
        IfCondition EqualTo(StringCompare(str, "springgreen"), 0) ThenBlock: { ReturnValue(4278255487) }
        IfCondition EqualTo(StringCompare(str, "thistle"), 0) ThenBlock: { ReturnValue(4292394968) }
        IfCondition EqualTo(StringCompare(str, "turquoise"), 0) ThenBlock: { ReturnValue(4282441936) }
        IfCondition EqualTo(StringCompare(str, "yellowgreen"), 0) ThenBlock: { ReturnValue(4288335154) }

        // CSS System Colors (mapped to sensible defaults)
        IfCondition EqualTo(StringCompare(str, "canvas"), 0) ThenBlock: { ReturnValue(4294967295) }
        IfCondition EqualTo(StringCompare(str, "canvastext"), 0) ThenBlock: { ReturnValue(4278190080) }
        IfCondition EqualTo(StringCompare(str, "linktext"), 0) ThenBlock: { ReturnValue(4278190335) }
        IfCondition EqualTo(StringCompare(str, "visitedtext"), 0) ThenBlock: { ReturnValue(4286578816) }
        IfCondition EqualTo(StringCompare(str, "activetext"), 0) ThenBlock: { ReturnValue(4294901760) }
        IfCondition EqualTo(StringCompare(str, "buttonface"), 0) ThenBlock: { ReturnValue(4293848050) }
        IfCondition EqualTo(StringCompare(str, "buttontext"), 0) ThenBlock: { ReturnValue(4278190080) }
        IfCondition EqualTo(StringCompare(str, "buttonborder"), 0) ThenBlock: { ReturnValue(4285953654) }
        IfCondition EqualTo(StringCompare(str, "field"), 0) ThenBlock: { ReturnValue(4294967295) }
        IfCondition EqualTo(StringCompare(str, "fieldtext"), 0) ThenBlock: { ReturnValue(4278190080) }
        IfCondition EqualTo(StringCompare(str, "highlight"), 0) ThenBlock: { ReturnValue(4281356794) }
        IfCondition EqualTo(StringCompare(str, "highlighttext"), 0) ThenBlock: { ReturnValue(4294967295) }
        IfCondition EqualTo(StringCompare(str, "mark"), 0) ThenBlock: { ReturnValue(4294967040) }
        IfCondition EqualTo(StringCompare(str, "marktext"), 0) ThenBlock: { ReturnValue(4278190080) }
        IfCondition EqualTo(StringCompare(str, "graytext"), 0) ThenBlock: { ReturnValue(4286611584) }

        // Unknown color — return transparent (don't paint what we can't parse)
        ReturnValue(0)
    }
}

// =============================================================================
// RGB / RGBA PARSER — parse rgb(R, G, B) and rgba(R, G, B, A)
// Also handles space-separated: rgb(R G B) and rgb(R G B / A)
// Returns BGRA color or 0 on failure
// =============================================================================
Function.LY__ParseRGB {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        // Find opening paren
        pi = 0
        p_found = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(p_found, 0)) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: {
                p_found = 1
            } ElseBlock: {
                pi = Add(pi, 1)
            }
        }
        IfCondition EqualTo(p_found, 0) ThenBlock: { ReturnValue(0) }
        pi = Add(pi, 1)  // skip '('

        // Parse up to 4 numbers (R, G, B, optional A)
        rgb_vals_0 = 0
        rgb_vals_1 = 0
        rgb_vals_2 = 0
        rgb_val_count = 0

        vc = 0
        WhileLoop And(LessThan(vc, 3), LessThan(pi, slen)) {
            // Skip whitespace, commas, and CSS comments
            sk_done = 0
            WhileLoop And(LessThan(pi, slen), EqualTo(sk_done, 0)) {
                sc = GetByte(str, pi)
                sc_skip = 0
                IfCondition EqualTo(sc, 32) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 44) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 9) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 10) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 13) ThenBlock: { sc_skip = 1 }
                // Skip CSS comments: /* ... */
                IfCondition EqualTo(sc, 47) ThenBlock: {
                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 42) ThenBlock: {
                            // Found /*, skip to */
                            pi = Add(pi, 2)
                            cm_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(cm_done, 0)) {
                                IfCondition EqualTo(GetByte(str, pi), 42) ThenBlock: {
                                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 47) ThenBlock: {
                                            pi = Add(pi, 2)
                                            cm_done = 1
                                        }
                                    }
                                }
                                IfCondition EqualTo(cm_done, 0) ThenBlock: {
                                    pi = Add(pi, 1)
                                }
                            }
                            sc_skip = 2  // already advanced, don't add 1
                        }
                    }
                }
                IfCondition EqualTo(sc_skip, 1) ThenBlock: {
                    pi = Add(pi, 1)
                }
                IfCondition EqualTo(sc_skip, 0) ThenBlock: {
                    sk_done = 1
                }
            }
            // Check for closing paren or slash
            IfCondition LessThan(pi, slen) ThenBlock: {
                ec = GetByte(str, pi)
                IfCondition EqualTo(ec, 41) ThenBlock: {
                    vc = 3  // done
                }
                IfCondition EqualTo(ec, 47) ThenBlock: {
                    vc = 3  // slash for alpha, skip
                }
            }
            // Parse number
            IfCondition LessThan(vc, 3) ThenBlock: {
                num = 0
                nd = 0
                num_done = 0
                WhileLoop And(LessThan(pi, slen), EqualTo(num_done, 0)) {
                    dc = GetByte(str, pi)
                    is_digit = 0
                    IfCondition And(GreaterEqual(dc, 48), LessEqual(dc, 57)) ThenBlock: {
                        is_digit = 1
                    }
                    IfCondition EqualTo(is_digit, 1) ThenBlock: {
                        num = Add(Multiply(num, 10), Subtract(dc, 48))
                        pi = Add(pi, 1)
                        nd = 1
                    } ElseBlock: {
                        // Skip decimal point and fractional part (e.g. 128.5)
                        IfCondition EqualTo(dc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            // Skip remaining digits after decimal
                            frac_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(frac_done, 0)) {
                                fc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(fc, 48), LessEqual(fc, 57)) ThenBlock: {
                                    pi = Add(pi, 1)
                                } ElseBlock: {
                                    frac_done = 1
                                }
                            }
                            num_done = 1
                        } ElseBlock: {
                            num_done = 1
                        }
                    }
                }
                // Check for % suffix
                IfCondition LessThan(pi, slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, pi), 37) ThenBlock: {
                        // Percentage: convert 0-100% to 0-255
                        num = Divide(Multiply(num, 255), 100)
                        pi = Add(pi, 1)
                    }
                }
                // Clamp 0-255
                IfCondition GreaterThan(num, 255) ThenBlock: { num = 255 }
                IfCondition LessThan(num, 0) ThenBlock: { num = 0 }
                // Store
                IfCondition EqualTo(vc, 0) ThenBlock: { rgb_vals_0 = num }
                IfCondition EqualTo(vc, 1) ThenBlock: { rgb_vals_1 = num }
                IfCondition EqualTo(vc, 2) ThenBlock: { rgb_vals_2 = num }
                vc = Add(vc, 1)
            }
        }

        // Parse optional alpha (4th value after comma or slash)
        rgb_alpha = 1000  // default: fully opaque (x1000)
        ra_sk = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(ra_sk, 0)) {
            rac = GetByte(str, pi)
            IfCondition EqualTo(rac, 32) ThenBlock: { pi = Add(pi, 1) }
            ElseBlock: {
                IfCondition EqualTo(rac, 44) ThenBlock: { pi = Add(pi, 1) }
                ElseBlock: {
                    IfCondition EqualTo(rac, 47) ThenBlock: { pi = Add(pi, 1) }
                    ElseBlock: {
                        IfCondition EqualTo(rac, 9) ThenBlock: { pi = Add(pi, 1) }
                        ElseBlock: { ra_sk = 1 }
                    }
                }
            }
        }
        IfCondition LessThan(pi, slen) ThenBlock: {
            rapc = GetByte(str, pi)
            IfCondition EqualTo(EqualTo(rapc, 41), 0) ThenBlock: {
                // Parse alpha as fixed-point x1000
                ra_int = 0
                ra_frac = 0
                ra_fmul = 100
                ra_done = 0
                WhileLoop And(LessThan(pi, slen), EqualTo(ra_done, 0)) {
                    radc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(radc, 48), LessEqual(radc, 57)) ThenBlock: {
                        ra_int = Add(Multiply(ra_int, 10), Subtract(radc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(radc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            raf_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(raf_done, 0)) {
                                rafc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(rafc, 48), LessEqual(rafc, 57)) ThenBlock: {
                                    IfCondition GreaterThan(ra_fmul, 0) ThenBlock: {
                                        ra_frac = Add(ra_frac, Multiply(Subtract(rafc, 48), ra_fmul))
                                        ra_fmul = Divide(ra_fmul, 10)
                                    }
                                    pi = Add(pi, 1)
                                } ElseBlock: { raf_done = 1 }
                            }
                        }
                        ra_done = 1
                    }
                }
                rgb_alpha = Add(Multiply(ra_int, 1000), ra_frac)
                IfCondition GreaterThan(rgb_alpha, 1000) ThenBlock: { rgb_alpha = 1000 }
                IfCondition LessThan(rgb_alpha, 0) ThenBlock: { rgb_alpha = 0 }
            }
        }

        // Apply alpha: blend against white background
        IfCondition LessThan(rgb_alpha, 1000) ThenBlock: {
            rgb_vals_0 = Divide(Add(Multiply(rgb_vals_0, rgb_alpha), Multiply(255, Subtract(1000, rgb_alpha))), 1000)
            rgb_vals_1 = Divide(Add(Multiply(rgb_vals_1, rgb_alpha), Multiply(255, Subtract(1000, rgb_alpha))), 1000)
            rgb_vals_2 = Divide(Add(Multiply(rgb_vals_2, rgb_alpha), Multiply(255, Subtract(1000, rgb_alpha))), 1000)
        }

        // Build BGRA: B + G*256 + R*65536 + 0xFF*16777216
        bgra = Add(rgb_vals_2, Add(Multiply(rgb_vals_1, 256), Add(Multiply(rgb_vals_0, 65536), 4278190080)))
        ReturnValue(bgra)
    }
}

// =============================================================================
// HSL / HSLA PARSER — parse hsl(H, S%, L%) and hsla(H, S%, L%, A)
// H = hue in degrees (0-360), S = saturation (0-100%), L = lightness (0-100%)
// Uses fixed-point arithmetic (multiply by 1000 for 3 decimal places)
// Returns BGRA color
// =============================================================================
Function.LY__HueToRGB {
    Input: p: Integer
    Input: q: Integer
    Input: t: Integer
    Output: Integer
    Body: {
        // All inputs scaled by 1000 (so 1.0 = 1000)
        // t is hue fraction * 1000
        ht = t
        IfCondition LessThan(ht, 0) ThenBlock: { ht = Add(ht, 1000) }
        IfCondition GreaterThan(ht, 1000) ThenBlock: { ht = Subtract(ht, 1000) }

        // if t < 1/6: p + (q-p) * 6 * t
        IfCondition LessThan(ht, 166) ThenBlock: {
            diff = Subtract(q, p)
            ReturnValue(Add(p, Divide(Multiply(Multiply(diff, 6), ht), 1000)))
        }
        // if t < 1/2: q
        IfCondition LessThan(ht, 500) ThenBlock: {
            ReturnValue(q)
        }
        // if t < 2/3: p + (q-p) * (2/3 - t) * 6
        IfCondition LessThan(ht, 666) ThenBlock: {
            diff = Subtract(q, p)
            ReturnValue(Add(p, Divide(Multiply(Multiply(diff, 6), Subtract(666, ht)), 1000)))
        }
        ReturnValue(p)
    }
}

Function.LY__ParseHSL {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        // Find opening paren
        pi = 0
        p_found = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(p_found, 0)) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: {
                p_found = 1
            } ElseBlock: {
                pi = Add(pi, 1)
            }
        }
        IfCondition EqualTo(p_found, 0) ThenBlock: { ReturnValue(0) }
        pi = Add(pi, 1)

        // Parse 3 numbers: H, S, L (reuse ParseRGB number parsing pattern)
        hsl_0 = 0
        hsl_1 = 0
        hsl_2 = 0
        vc = 0
        WhileLoop And(LessThan(vc, 3), LessThan(pi, slen)) {
            // Skip whitespace, commas, and CSS comments
            sk_done = 0
            WhileLoop And(LessThan(pi, slen), EqualTo(sk_done, 0)) {
                sc = GetByte(str, pi)
                sc_skip = 0
                IfCondition EqualTo(sc, 32) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 44) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 9) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 10) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 13) ThenBlock: { sc_skip = 1 }
                // Skip CSS comments: /* ... */
                IfCondition EqualTo(sc, 47) ThenBlock: {
                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 42) ThenBlock: {
                            pi = Add(pi, 2)
                            cm_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(cm_done, 0)) {
                                IfCondition EqualTo(GetByte(str, pi), 42) ThenBlock: {
                                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 47) ThenBlock: {
                                            pi = Add(pi, 2)
                                            cm_done = 1
                                        }
                                    }
                                }
                                IfCondition EqualTo(cm_done, 0) ThenBlock: {
                                    pi = Add(pi, 1)
                                }
                            }
                            sc_skip = 2  // already advanced past comment
                        }
                    }
                }
                IfCondition EqualTo(sc_skip, 1) ThenBlock: {
                    pi = Add(pi, 1)
                }
                IfCondition EqualTo(sc_skip, 0) ThenBlock: {
                    sk_done = 1
                }
            }
            // Check for closing paren or slash (alpha separator)
            IfCondition LessThan(pi, slen) ThenBlock: {
                ec = GetByte(str, pi)
                IfCondition EqualTo(ec, 41) ThenBlock: { vc = 3 }
                // Bare / is alpha separator; /* is comment (already handled above)
                IfCondition EqualTo(ec, 47) ThenBlock: {
                    is_cmt = 0
                    IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                        IfCondition EqualTo(GetByte(str, Add(pi, 1)), 42) ThenBlock: {
                            is_cmt = 1
                        }
                    }
                    IfCondition EqualTo(is_cmt, 0) ThenBlock: {
                        vc = 3  // alpha separator — stop
                    }
                }
            }
            // Parse number (integer + fractional x1000 for hue precision)
            IfCondition LessThan(vc, 3) ThenBlock: {
                num = 0
                num_frac = 0
                frac_div = 1
                is_neg = 0
                IfCondition LessThan(pi, slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, pi), 45) ThenBlock: {
                        is_neg = 1
                        pi = Add(pi, 1)
                    }
                }
                num_done = 0
                WhileLoop And(LessThan(pi, slen), EqualTo(num_done, 0)) {
                    dc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(dc, 48), LessEqual(dc, 57)) ThenBlock: {
                        num = Add(Multiply(num, 10), Subtract(dc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        // Parse decimal fraction into x1000 scale
                        IfCondition EqualTo(dc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            frac_mul = 100
                            frac_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(frac_done, 0)) {
                                fc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(fc, 48), LessEqual(fc, 57)) ThenBlock: {
                                    IfCondition GreaterThan(frac_mul, 0) ThenBlock: {
                                        num_frac = Add(num_frac, Multiply(Subtract(fc, 48), frac_mul))
                                        frac_mul = Divide(frac_mul, 10)
                                    }
                                    pi = Add(pi, 1)
                                } ElseBlock: {
                                    frac_done = 1
                                }
                            }
                        }
                        num_done = 1
                    }
                }
                // Handle scientific notation: e.g. 1.2e2 = 120
                // Check for 'e' or 'E' (101 or 69)
                IfCondition LessThan(pi, slen) ThenBlock: {
                    ec_ch = GetByte(str, pi)
                    IfCondition Or(EqualTo(ec_ch, 101), EqualTo(ec_ch, 69)) ThenBlock: {
                        pi = Add(pi, 1)
                        // Parse exponent sign and digits
                        exp_neg = 0
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            exp_s = GetByte(str, pi)
                            IfCondition EqualTo(exp_s, 43) ThenBlock: { pi = Add(pi, 1) }
                            IfCondition EqualTo(exp_s, 45) ThenBlock: {
                                exp_neg = 1
                                pi = Add(pi, 1)
                            }
                        }
                        exp_val = 0
                        exp_done = 0
                        WhileLoop And(LessThan(pi, slen), EqualTo(exp_done, 0)) {
                            exp_d = GetByte(str, pi)
                            IfCondition And(GreaterEqual(exp_d, 48), LessEqual(exp_d, 57)) ThenBlock: {
                                exp_val = Add(Multiply(exp_val, 10), Subtract(exp_d, 48))
                                pi = Add(pi, 1)
                            } ElseBlock: {
                                exp_done = 1
                            }
                        }
                        // Apply exponent: multiply or divide num and num_frac by 10^exp
                        IfCondition EqualTo(exp_neg, 0) ThenBlock: {
                            exp_i = 0
                            WhileLoop LessThan(exp_i, exp_val) {
                                num = Multiply(num, 10)
                                num_frac = Multiply(num_frac, 10)
                                // Carry from frac to int: frac >= 1000 → add to int
                                IfCondition GreaterEqual(num_frac, 1000) ThenBlock: {
                                    num = Add(num, Divide(num_frac, 1000))
                                    num_frac = Subtract(num_frac, Multiply(Divide(num_frac, 1000), 1000))
                                }
                                exp_i = Add(exp_i, 1)
                            }
                        } ElseBlock: {
                            // Negative exponent: divide
                            exp_i = 0
                            WhileLoop LessThan(exp_i, exp_val) {
                                num_frac = Add(num_frac, Multiply(Subtract(num, Multiply(Divide(num, 10), 10)), 100))
                                num = Divide(num, 10)
                                num_frac = Divide(num_frac, 10)
                                exp_i = Add(exp_i, 1)
                            }
                        }
                    }
                }
                // num_x1000 = integer * 1000 + fractional (always positive here)
                num_x1000 = Add(Multiply(num, 1000), num_frac)
                IfCondition EqualTo(is_neg, 1) ThenBlock: {
                    num = Subtract(0, num)
                    num_x1000 = Subtract(0, num_x1000)
                }
                // Handle angle unit suffix for hue (vc==0): deg, grad, rad, turn
                angle_unit = 0
                IfCondition LessThan(pi, slen) ThenBlock: {
                    sf = GetByte(str, pi)
                    IfCondition EqualTo(sf, 37) ThenBlock: { pi = Add(pi, 1) }
                    // 'd' for 'deg'
                    IfCondition EqualTo(sf, 100) ThenBlock: {
                        angle_unit = 1
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 101) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 103) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                    // 'g' for 'grad'
                    IfCondition EqualTo(sf, 103) ThenBlock: {
                        angle_unit = 2
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 114) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 97) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 100) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                    // 'r' for 'rad'
                    IfCondition EqualTo(sf, 114) ThenBlock: {
                        angle_unit = 3
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 97) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 100) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                    // 't' for 'turn'
                    IfCondition EqualTo(sf, 116) ThenBlock: {
                        angle_unit = 4
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 117) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 114) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 110) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                }
                // Convert angle units to degrees (only for hue = vc==0)
                IfCondition EqualTo(vc, 0) ThenBlock: {
                    // grad: degrees = value * 360 / 400 = value * 9 / 10
                    IfCondition EqualTo(angle_unit, 2) ThenBlock: {
                        num = Divide(Multiply(num_x1000, 9), 10000)
                    } ElseBlock: {
                        // rad: degrees = value * 180 / pi ≈ value * 5730 / 100000
                        // Using x1000 scale: num_x1000 * 5730 / 100000 = num_x1000 * 573 / 10000
                        IfCondition EqualTo(angle_unit, 3) ThenBlock: {
                            num = Divide(Multiply(num_x1000, 573), 10000)
                        } ElseBlock: {
                            // turn: degrees = value * 360
                            IfCondition EqualTo(angle_unit, 4) ThenBlock: {
                                num = Divide(Multiply(num_x1000, 360), 1000)
                            } ElseBlock: {
                                // deg or no unit: use integer part directly
                                num = Divide(num_x1000, 1000)
                            }
                        }
                    }
                }
                IfCondition EqualTo(vc, 0) ThenBlock: { hsl_0 = num }
                IfCondition EqualTo(vc, 1) ThenBlock: { hsl_1 = num }
                IfCondition EqualTo(vc, 2) ThenBlock: { hsl_2 = num }
                vc = Add(vc, 1)
            }
        }

        // Normalize: H to 0-360, S and L to 0-100
        hue = hsl_0
        WhileLoop LessThan(hue, 0) { hue = Add(hue, 360) }
        WhileLoop GreaterEqual(hue, 360) { hue = Subtract(hue, 360) }
        sat = hsl_1
        IfCondition LessThan(sat, 0) ThenBlock: { sat = 0 }
        IfCondition GreaterThan(sat, 100) ThenBlock: { sat = 100 }
        lit = hsl_2
        IfCondition LessThan(lit, 0) ThenBlock: { lit = 0 }
        IfCondition GreaterThan(lit, 100) ThenBlock: { lit = 100 }

        // Convert HSL to RGB using fixed-point (x1000)
        // s1000 = S/100 * 1000, l1000 = L/100 * 1000
        s1000 = Multiply(sat, 10)
        l1000 = Multiply(lit, 10)

        // If saturation is 0, it's a gray
        IfCondition EqualTo(s1000, 0) ThenBlock: {
            gray = Divide(Multiply(lit, 255), 100)
            bgra = Add(gray, Add(Multiply(gray, 256), Add(Multiply(gray, 65536), 4278190080)))
            ReturnValue(bgra)
        }

        // q = l < 0.5 ? l * (1+s) : l + s - l*s
        IfCondition LessThan(l1000, 500) ThenBlock: {
            q1000 = Divide(Multiply(l1000, Add(1000, s1000)), 1000)
        } ElseBlock: {
            q1000 = Subtract(Add(l1000, s1000), Divide(Multiply(l1000, s1000), 1000))
        }
        // p = 2*l - q
        p1000 = Subtract(Multiply(2, l1000), q1000)

        // h_frac = hue / 360 * 1000
        h_frac = Divide(Multiply(hue, 1000), 360)

        // R = hueToRGB(p, q, h + 1/3)
        r1000 = LY__HueToRGB(p1000, q1000, Add(h_frac, 333))
        // G = hueToRGB(p, q, h)
        g1000 = LY__HueToRGB(p1000, q1000, h_frac)
        // B = hueToRGB(p, q, h - 1/3)
        b1000 = LY__HueToRGB(p1000, q1000, Subtract(h_frac, 333))

        // Convert to 0-255
        r = Divide(Multiply(r1000, 255), 1000)
        g = Divide(Multiply(g1000, 255), 1000)
        b = Divide(Multiply(b1000, 255), 1000)
        IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }

        // Parse optional alpha (4th value after comma or slash)
        alpha_1000 = 1000  // default: fully opaque
        // After vc=3, pi should be past the 3rd number; skip whitespace/comma/slash
        a_sk = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(a_sk, 0)) {
            ac = GetByte(str, pi)
            IfCondition EqualTo(ac, 32) ThenBlock: { pi = Add(pi, 1) }
            ElseBlock: {
                IfCondition EqualTo(ac, 44) ThenBlock: { pi = Add(pi, 1) }
                ElseBlock: {
                    IfCondition EqualTo(ac, 47) ThenBlock: { pi = Add(pi, 1) }
                    ElseBlock: {
                        IfCondition EqualTo(ac, 9) ThenBlock: { pi = Add(pi, 1) }
                        ElseBlock: {
                            IfCondition EqualTo(ac, 10) ThenBlock: { pi = Add(pi, 1) }
                            ElseBlock: { a_sk = 1 }
                        }
                    }
                }
            }
        }
        // Parse alpha number if present (not a closing paren)
        IfCondition LessThan(pi, slen) ThenBlock: {
            apc = GetByte(str, pi)
            IfCondition EqualTo(EqualTo(apc, 41), 0) ThenBlock: {
                // Parse alpha as fixed-point x1000
                a_int = 0
                a_frac = 0
                a_frac_mul = 100
                a_done = 0
                // Skip leading whitespace
                WhileLoop And(LessThan(pi, slen), EqualTo(a_done, 0)) {
                    adc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(adc, 48), LessEqual(adc, 57)) ThenBlock: {
                        a_int = Add(Multiply(a_int, 10), Subtract(adc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(adc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            af_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(af_done, 0)) {
                                afc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(afc, 48), LessEqual(afc, 57)) ThenBlock: {
                                    IfCondition GreaterThan(a_frac_mul, 0) ThenBlock: {
                                        a_frac = Add(a_frac, Multiply(Subtract(afc, 48), a_frac_mul))
                                        a_frac_mul = Divide(a_frac_mul, 10)
                                    }
                                    pi = Add(pi, 1)
                                } ElseBlock: { af_done = 1 }
                            }
                        }
                        a_done = 1
                    }
                }
                // alpha_1000 = integer_part * 1000 + frac_part
                // For 0.2 -> a_int=0, a_frac=200 -> alpha_1000=200
                // For 1.0 -> a_int=1, a_frac=0 -> alpha_1000=1000
                alpha_1000 = Add(Multiply(a_int, 1000), a_frac)
                IfCondition GreaterThan(alpha_1000, 1000) ThenBlock: { alpha_1000 = 1000 }
                IfCondition LessThan(alpha_1000, 0) ThenBlock: { alpha_1000 = 0 }
            }
        }

        // Apply alpha: blend against white background
        // result = color * alpha + 255 * (1 - alpha)
        IfCondition LessThan(alpha_1000, 1000) ThenBlock: {
            r = Divide(Add(Multiply(r, alpha_1000), Multiply(255, Subtract(1000, alpha_1000))), 1000)
            g = Divide(Add(Multiply(g, alpha_1000), Multiply(255, Subtract(1000, alpha_1000))), 1000)
            b = Divide(Add(Multiply(b, alpha_1000), Multiply(255, Subtract(1000, alpha_1000))), 1000)
        }

        bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
        ReturnValue(bgra)
    }
}

// =============================================================================
// HWB PARSER — parse hwb(H, W%, B%) and hwb(H W% B% / A)
// H = hue in degrees (0-360), W = whiteness (0-100%), B = blackness (0-100%)
// Conversion: mix hsl(H, 100%, 50%) with white (W) and black (B)
// Returns BGRA color
// =============================================================================
Function.LY__ParseHWB {
    Input: str: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        // Find opening paren
        pi = 0
        p_found = 0
        WhileLoop And(LessThan(pi, slen), EqualTo(p_found, 0)) {
            IfCondition EqualTo(GetByte(str, pi), 40) ThenBlock: {
                p_found = 1
            } ElseBlock: {
                pi = Add(pi, 1)
            }
        }
        IfCondition EqualTo(p_found, 0) ThenBlock: { ReturnValue(0) }
        pi = Add(pi, 1)

        // Parse 3 numbers: H, W, B
        hwb_0 = 0
        hwb_1 = 0
        hwb_2 = 0
        vc = 0
        WhileLoop And(LessThan(vc, 3), LessThan(pi, slen)) {
            // Skip whitespace, commas
            sk_done = 0
            WhileLoop And(LessThan(pi, slen), EqualTo(sk_done, 0)) {
                sc = GetByte(str, pi)
                sc_skip = 0
                IfCondition EqualTo(sc, 32) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 44) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 9) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 10) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc, 13) ThenBlock: { sc_skip = 1 }
                IfCondition EqualTo(sc_skip, 1) ThenBlock: {
                    pi = Add(pi, 1)
                }
                IfCondition EqualTo(sc_skip, 0) ThenBlock: {
                    sk_done = 1
                }
            }
            // Check for closing paren or slash (alpha separator)
            IfCondition LessThan(pi, slen) ThenBlock: {
                ec = GetByte(str, pi)
                IfCondition EqualTo(ec, 41) ThenBlock: { vc = 3 }
                IfCondition EqualTo(ec, 47) ThenBlock: { vc = 3 }
            }
            // Parse number
            IfCondition LessThan(vc, 3) ThenBlock: {
                num = 0
                is_neg = 0
                IfCondition LessThan(pi, slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, pi), 45) ThenBlock: {
                        is_neg = 1
                        pi = Add(pi, 1)
                    }
                }
                num_done = 0
                WhileLoop And(LessThan(pi, slen), EqualTo(num_done, 0)) {
                    dc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(dc, 48), LessEqual(dc, 57)) ThenBlock: {
                        num = Add(Multiply(num, 10), Subtract(dc, 48))
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(dc, 46) ThenBlock: {
                            pi = Add(pi, 1)
                            frac_done = 0
                            WhileLoop And(LessThan(pi, slen), EqualTo(frac_done, 0)) {
                                fc = GetByte(str, pi)
                                IfCondition And(GreaterEqual(fc, 48), LessEqual(fc, 57)) ThenBlock: {
                                    pi = Add(pi, 1)
                                } ElseBlock: {
                                    frac_done = 1
                                }
                            }
                        }
                        num_done = 1
                    }
                }
                IfCondition EqualTo(is_neg, 1) ThenBlock: { num = Subtract(0, num) }
                // Skip % or 'deg' suffix
                IfCondition LessThan(pi, slen) ThenBlock: {
                    sf = GetByte(str, pi)
                    IfCondition EqualTo(sf, 37) ThenBlock: { pi = Add(pi, 1) }
                    IfCondition EqualTo(sf, 100) ThenBlock: {
                        pi = Add(pi, 1)
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 101) ThenBlock: { pi = Add(pi, 1) }
                        }
                        IfCondition LessThan(pi, slen) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, pi), 103) ThenBlock: { pi = Add(pi, 1) }
                        }
                    }
                }
                IfCondition EqualTo(vc, 0) ThenBlock: { hwb_0 = num }
                IfCondition EqualTo(vc, 1) ThenBlock: { hwb_1 = num }
                IfCondition EqualTo(vc, 2) ThenBlock: { hwb_2 = num }
                vc = Add(vc, 1)
            }
        }

        // Normalize: H to 0-360, W and B to 0-100
        hue = hwb_0
        WhileLoop LessThan(hue, 0) { hue = Add(hue, 360) }
        WhileLoop GreaterEqual(hue, 360) { hue = Subtract(hue, 360) }
        wt = hwb_1
        IfCondition LessThan(wt, 0) ThenBlock: { wt = 0 }
        IfCondition GreaterThan(wt, 100) ThenBlock: { wt = 100 }
        bk = hwb_2
        IfCondition LessThan(bk, 0) ThenBlock: { bk = 0 }
        IfCondition GreaterThan(bk, 100) ThenBlock: { bk = 100 }

        // If whiteness + blackness >= 100, result is gray
        wb_sum = Add(wt, bk)
        IfCondition GreaterEqual(wb_sum, 100) ThenBlock: {
            // gray = whiteness / (whiteness + blackness) * 255
            gray = Divide(Multiply(wt, 255), wb_sum)
            bgra = Add(gray, Add(Multiply(gray, 256), Add(Multiply(gray, 65536), 4278190080)))
            ReturnValue(bgra)
        }

        // Get pure hue color via HSL (S=100%, L=50%) using HueToRGB
        h_frac = Divide(Multiply(hue, 1000), 360)
        // For S=100%, L=50%: p=0, q=1000
        r1000 = LY__HueToRGB(0, 1000, Add(h_frac, 333))
        g1000 = LY__HueToRGB(0, 1000, h_frac)
        b1000 = LY__HueToRGB(0, 1000, Subtract(h_frac, 333))

        // Mix with white and black: color = color * (1 - W - B) + W
        // Using x1000 scale: factor = 1000 - W*10 - B*10
        factor = Subtract(1000, Add(Multiply(wt, 10), Multiply(bk, 10)))
        w1000 = Multiply(wt, 10)

        r_final = Divide(Add(Multiply(r1000, factor), Multiply(w1000, 1000)), 1000)
        g_final = Divide(Add(Multiply(g1000, factor), Multiply(w1000, 1000)), 1000)
        b_final = Divide(Add(Multiply(b1000, factor), Multiply(w1000, 1000)), 1000)

        r = Divide(Multiply(r_final, 255), 1000)
        g = Divide(Multiply(g_final, 255), 1000)
        b = Divide(Multiply(b_final, 255), 1000)
        IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
        IfCondition LessThan(b, 0) ThenBlock: { b = 0 }

        bgra = Add(b, Add(Multiply(g, 256), Add(Multiply(r, 65536), 4278190080)))
        ReturnValue(bgra)
    }
}

Function.LY__HexDigit {
    Input: str: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        c = GetByte(str, pos)
        // 0-9
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
            ReturnValue(Subtract(c, 48))
        }
        // a-f
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 102)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 97), 10))
        }
        // A-F
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 70)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 65), 10))
        }
        ReturnValue(0)
    }
}

Function.LY__HexPair {
    Input: str: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        hi = LY__HexDigit(str, pos)
        lo = LY__HexDigit(str, Add(pos, 1))
        ReturnValue(Add(Multiply(hi, 16), lo))
    }
}

// =============================================================================
// CSS VALUE PARSING — parse pixel/em values
// =============================================================================
Function.LY__ParsePx {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(str)
        IfCondition EqualTo(slen, 0) ThenBlock: { ReturnValue(0) }

        // Check for var() — resolve first
        IfCondition EqualTo(GetByte(str, 0), 118) ThenBlock: {
            IfCondition EqualTo(GetByte(str, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(str, 2), 114) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, 3), 40) ThenBlock: {
                        resolved_px = CSS_ResolveVarExpr(str)
                        IfCondition NotEqual(resolved_px, 0) ThenBlock: {
                            var_px_val = LY__ParsePx(resolved_px)
                            ReturnValue(var_px_val)
                        }
                        ReturnValue(0)
                    }
                }
            }
        }

        // Parse integer part
        val = 0
        pi = 0
        WhileLoop LessThan(pi, slen) {
            pc = GetByte(str, pi)
            IfCondition And(GreaterEqual(pc, 48), LessEqual(pc, 57)) ThenBlock: {
                val = Add(Multiply(val, 10), Subtract(pc, 48))
            }
            // Stop at non-digit (px, em, %, '.', etc.)
            IfCondition LessThan(pc, 48) ThenBlock: { BreakLoop }
            IfCondition GreaterThan(pc, 57) ThenBlock: { BreakLoop }
            pi = Add(pi, 1)
        }

        // Parse decimal part if present (e.g., 0.5rem, 1.25em)
        // Store as val_x1000 = val * 1000 + fractional millipixels
        frac = 0
        frac_div = 1
        IfCondition LessThan(pi, slen) ThenBlock: {
            IfCondition EqualTo(GetByte(str, pi), 46) ThenBlock: {
                // decimal point
                pi = Add(pi, 1)
                WhileLoop LessThan(pi, slen) {
                    fc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(fc, 48), LessEqual(fc, 57)) ThenBlock: {
                        frac = Add(Multiply(frac, 10), Subtract(fc, 48))
                        frac_div = Multiply(frac_div, 10)
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        BreakLoop
                    }
                }
            }
        }

        // Compute val_x1000 = integer part * 1000 + fractional part scaled to 1000
        val_x1000 = Multiply(val, 1000)
        IfCondition GreaterThan(frac_div, 1) ThenBlock: {
            val_x1000 = Add(val_x1000, Divide(Multiply(frac, 1000), frac_div))
        }

        // Check for unit suffix
        IfCondition LessThan(pi, slen) ThenBlock: {
            su = GetByte(str, pi)
            // 'r' for rem — 1rem = 16px
            IfCondition EqualTo(su, 114) ThenBlock: {
                IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, Add(pi, 1)), 101) ThenBlock: {
                        // re -> rem
                        ReturnValue(Divide(Multiply(val_x1000, 16), 1000))
                    }
                }
            }
            // 'e' for em — 1em = 16px (or current font size)
            IfCondition EqualTo(su, 101) ThenBlock: {
                ReturnValue(Divide(Multiply(val_x1000, 16), 1000))
            }
            // 'v' for vw/vh — viewport-relative units
            IfCondition EqualTo(su, 118) ThenBlock: {
                su2 = 0
                IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                    su2 = GetByte(str, Add(pi, 1))
                }
                IfCondition EqualTo(su2, 119) ThenBlock: {
                    // vw: 1vw = 1% of viewport width
                    ReturnValue(Divide(Multiply(val_x1000, LYState.viewport_w), 100000))
                }
                IfCondition EqualTo(su2, 104) ThenBlock: {
                    // vh: 1vh = 1% of viewport height
                    ReturnValue(Divide(Multiply(val_x1000, LYState.viewport_h), 100000))
                }
            }
            // '%' for percentage — relative to avail_w
            IfCondition EqualTo(su, 37) ThenBlock: {
                ReturnValue(Divide(Multiply(val_x1000, LYState.avail_w), 100000))
            }
            // 'p' for px or pt
            IfCondition EqualTo(su, 112) ThenBlock: {
                ReturnValue(Divide(val_x1000, 1000))
            }
        }

        // No unit or unrecognized — return integer value
        ReturnValue(Divide(val_x1000, 1000))
    }
}

