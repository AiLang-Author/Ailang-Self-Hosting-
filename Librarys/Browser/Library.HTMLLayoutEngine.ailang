// Library.HTMLLayoutEngine.ailang — Main recursive layout engine (LY__LayoutNode)
// Block/inline layout recursion, element-specific rendering, Layout_Run entry point.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutColors
LibraryImport.Browser.HTMLLayoutCSS
LibraryImport.Browser.HTMLLayoutFlex

Function.LY__LayoutNode {
    Input: node: Integer
    Body: {
        ntype = DOM_GetType(node)

        // TEXT nodes — emit text content
        IfCondition EqualTo(ntype, DOMType.TEXT) ThenBlock: {
            LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
            LYState.dbg_texts = Add(LYState.dbg_texts, 1)
            t_ptr = DOM_GetText(node)
            t_len = DOM_GetTextLen(node)
            IfCondition And(NotEqual(t_ptr, 0), GreaterThan(t_len, 0)) ThenBlock: {
                LY__EmitText(t_ptr, t_len, LYState.fg_color)
            }
            ReturnValue(0)
        }

        // COMMENT nodes — skip
        IfCondition EqualTo(ntype, DOMType.COMMENT) ThenBlock: {
            ReturnValue(0)
        }

        // ROOT node — process children
        IfCondition EqualTo(ntype, DOMType.ROOT) ThenBlock: {
            rc = DOM_GetFirstChild(node)
            WhileLoop GreaterEqual(rc, 0) {
                next_rc = DOM_GetNextSib(rc)
                LY__LayoutNode(rc)
                rc = next_rc
            }
            ReturnValue(0)
        }

        // ELEMENT node — classify and layout
        tag = DOM_GetTag(node)
        disp = LY__GetDisplay(tag)

        // Check HTML hidden attribute
        IfCondition NotEqual(disp, LYDisp.NONE) ThenBlock: {
            hidden_attr = DOM_GetAttr(node, "hidden")
            IfCondition NotEqual(hidden_attr, 0) ThenBlock: {
                disp = LYDisp.NONE
            }
        }

        // Check CSS display:none override
        // Never hide <html> or <body> — sites use "body{display:none}" as anti-FOUC
        // (e.g. DDG: "body{display:none}" + JS adds class to reveal). Since we run
        // scripts before layout, FOUC isn't an issue and body must always render.
        is_root_tag = 0
        IfCondition NotEqual(tag, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(tag, "body"), 0) ThenBlock: { is_root_tag = 1 }
            IfCondition EqualTo(StringCompare(tag, "html"), 0) ThenBlock: { is_root_tag = 1 }
        }
        // Resolve CSS display override (stylesheet + inline style)
        // Inline style overrides stylesheet which overrides tag default
        css_disp = 0
        IfCondition And(NotEqual(disp, LYDisp.NONE), EqualTo(is_root_tag, 0)) ThenBlock: {
            // 1. Check CSS stylesheet rules for display
            css_disp = LY__CSSLookupProp(node, "display")
            IfCondition NotEqual(css_disp, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(css_disp, "none"), 0) ThenBlock: {
                    disp = LYDisp.NONE
                }
                IfCondition EqualTo(StringCompare(css_disp, "block"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline"), 0) ThenBlock: {
                    disp = LYDisp.INLINE
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline-block"), 0) ThenBlock: {
                    disp = LYDisp.INLINE
                }
                IfCondition EqualTo(StringCompare(css_disp, "flex"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline-flex"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "list-item"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-row"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-cell"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-row-group"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-header-group"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-footer-group"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-caption"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "grid"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline-grid"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "flow-root"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "contents"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
            }
            // 2. Inline style overrides everything (higher specificity)
            // Must always check — inline style can override CSS display:none back to block
            ds_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(ds_str, 0) ThenBlock: {
                ds_idx = StringIndexOf(ds_str, "display")
                IfCondition GreaterEqual(ds_idx, 0) ThenBlock: {
                    ds_len = StringLength(ds_str)
                    ds_rule = CSS_ParseInline(ds_str, ds_len)
                    IfCondition GreaterEqual(ds_rule, 0) ThenBlock: {
                        ds_val = CSS_GetPropVal(ds_rule, "display")
                        IfCondition NotEqual(ds_val, 0) ThenBlock: {
                            css_disp = ds_val
                            IfCondition EqualTo(StringCompare(ds_val, "none"), 0) ThenBlock: {
                                disp = LYDisp.NONE
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "block"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline"), 0) ThenBlock: {
                                disp = LYDisp.INLINE
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline-block"), 0) ThenBlock: {
                                disp = LYDisp.INLINE
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "flex"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline-flex"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "list-item"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-row"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-cell"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-row-group"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-header-group"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-footer-group"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-caption"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "grid"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline-grid"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "flow-root"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "contents"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                        }
                    }
                }
            }
        }

        // NONE — skip
        IfCondition EqualTo(disp, LYDisp.NONE) ThenBlock: {
            LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
            LYState.dbg_none = Add(LYState.dbg_none, 1)
            // Diagnostic: print first 10 elements getting display:none
            IfCondition LessThan(LYState.dbg_none, 11) ThenBlock: {
                PrintMessage("[NONE #")
                PrintNumber(node)
                PrintMessage("] <")
                IfCondition NotEqual(tag, 0) ThenBlock: { PrintMessage(tag) }
                PrintMessage("> class=")
                dbg_cls = DOM_GetAttr(node, "class")
                IfCondition NotEqual(dbg_cls, 0) ThenBlock: { PrintMessage(dbg_cls) }
                PrintMessage(" css_disp=")
                IfCondition NotEqual(css_disp, 0) ThenBlock: { PrintMessage(css_disp) }
                PrintMessage("\n")
            }
            ReturnValue(0)
        }

        // Check visibility: hidden (element takes space but isn't painted)
        is_visible = 1
        vis_css = LY__CSSLookupProp(node, "visibility")
        IfCondition NotEqual(vis_css, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(vis_css, "hidden"), 0) ThenBlock: {
                is_visible = 0
            }
            IfCondition EqualTo(StringCompare(vis_css, "collapse"), 0) ThenBlock: {
                is_visible = 0
            }
        }
        // Also check inline style
        IfCondition EqualTo(is_visible, 1) ThenBlock: {
            vis_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(vis_str, 0) ThenBlock: {
                IfCondition GreaterEqual(StringIndexOf(vis_str, "visibility"), 0) ThenBlock: {
                    vis_slen = StringLength(vis_str)
                    vis_rule = CSS_ParseInline(vis_str, vis_slen)
                    IfCondition GreaterEqual(vis_rule, 0) ThenBlock: {
                        vis_v = CSS_GetPropVal(vis_rule, "visibility")
                        IfCondition NotEqual(vis_v, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(vis_v, "hidden"), 0) ThenBlock: {
                                is_visible = 0
                            }
                            IfCondition EqualTo(StringCompare(vis_v, "collapse"), 0) ThenBlock: {
                                is_visible = 0
                            }
                        }
                    }
                }
            }
        }

        // Check aria-hidden="true" — skip element entirely (unambiguous signal)
        aria_h = DOM_GetAttr(node, "aria-hidden")
        IfCondition NotEqual(aria_h, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(aria_h, "true"), 0) ThenBlock: {
                LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
                LYState.dbg_none = Add(LYState.dbg_none, 1)
                ReturnValue(0)
            }
        }

        // BLOCK element
        IfCondition EqualTo(disp, LYDisp.BLOCK) ThenBlock: {
            LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
            LYState.dbg_blocks = Add(LYState.dbg_blocks, 1)
            // Flush any inline content on the current line before starting block
            IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
                blk_fh = LY__LineHeight()
                LYState.cursor_y = Add(LYState.cursor_y, blk_fh)
                LYState.cursor_x = LYState.indent
            }

            // Save parent state to stack locals
            sv_fg = LYState.fg_color
            sv_bg = LYState.bg_color
            sv_sc = LYState.font_scale
            sv_ind = LYState.indent
            sv_aw = LYState.avail_w
            sv_ta = LYState.text_align
            sv_vis = LYState.visible
            sv_lh = LYState.line_height
            sv_fspx = LYState.font_size_px
            sv_fwpx = LYState.font_w_px
            sv_ahem = LYState.is_ahem
            sv_float_count = LYFloatState.count

            // Apply visibility:hidden — suppress paint but preserve layout
            IfCondition EqualTo(is_visible, 0) ThenBlock: {
                LYState.visible = 0
            }

            // Pre-parse inline style ONCE and cache the rule index
            // This avoids re-parsing the same inline style string 8+ times per block
            inline_style = DOM_GetAttr(node, "style")
            inline_rule = -1
            IfCondition NotEqual(inline_style, 0) ThenBlock: {
                is_len = StringLength(inline_style)
                IfCondition GreaterThan(is_len, 0) ThenBlock: {
                    inline_rule = CSS_ParseInline(inline_style, is_len)
                }
            }

            // =====================================================================
            // FLOAT DETECTION — check CSS float property before normal block flow
            // Floated elements are removed from normal flow and positioned at
            // the left or right edge of their container.
            // =====================================================================
            float_dir = 0   // 0=none, 1=left, 2=right
            LYState.dbg_fl_chk = Add(LYState.dbg_fl_chk, 1)
            // Check cached inline style for float
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                fl_v = CSS_GetPropVal(inline_rule, "float")
                IfCondition NotEqual(fl_v, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(fl_v, "left"), 0) ThenBlock: {
                        float_dir = 1
                    }
                    IfCondition EqualTo(StringCompare(fl_v, "right"), 0) ThenBlock: {
                        float_dir = 2
                    }
                }
            }
            // Check CSS rules for float (if inline didn't set it)
            IfCondition EqualTo(float_dir, 0) ThenBlock: {
                fl_css = LY__CSSLookupProp(node, "float")
                IfCondition NotEqual(fl_css, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(fl_css, "left"), 0) ThenBlock: {
                        float_dir = 1
                    }
                    IfCondition EqualTo(StringCompare(fl_css, "right"), 0) ThenBlock: {
                        float_dir = 2
                    }
                }
            }

            // =====================================================================
            // FLOAT LAYOUT PATH — separate from normal block flow
            // =====================================================================
            IfCondition GreaterThan(float_dir, 0) ThenBlock: {
                // Save cursor_y — float children will modify it but we must restore
                sv_cursor_y = LYState.cursor_y
                // Resolve width for the float (required; default to half container)
                flt_w = 0
                IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                    flt_wv = CSS_GetPropVal(inline_rule, "width")
                    IfCondition NotEqual(flt_wv, 0) ThenBlock: {
                        flt_w = LY__ParsePx(flt_wv)
                    }
                }
                IfCondition EqualTo(flt_w, 0) ThenBlock: {
                    flt_wc = LY__CSSLookupProp(node, "width")
                    IfCondition NotEqual(flt_wc, 0) ThenBlock: {
                        flt_w = LY__ParsePx(flt_wc)
                    }
                }
                // If no explicit width, use half the available width as default
                IfCondition EqualTo(flt_w, 0) ThenBlock: {
                    flt_w = Divide(LYState.avail_w, 2)
                }
                // Clamp to available width
                IfCondition GreaterThan(flt_w, LYState.avail_w) ThenBlock: {
                    flt_w = LYState.avail_w
                }

                // Resolve padding for the float
                flt_pad_top = LY__ResolvePaddingSide(node, tag, 0)
                flt_pad_right = LY__ResolvePaddingSide(node, tag, 1)
                flt_pad_bottom = LY__ResolvePaddingSide(node, tag, 2)
                flt_pad_left = LY__ResolvePaddingSide(node, tag, 3)

                // Resolve margin for the float
                flt_mar_top = LY__ResolveMarginSide(node, tag, 0)
                flt_mar_right = LY__ResolveMarginSide(node, tag, 1)
                flt_mar_bottom = LY__ResolveMarginSide(node, tag, 2)
                flt_mar_left = LY__ResolveMarginSide(node, tag, 3)

                // Position the float — with line-wrapping if it doesn't fit
                flt_y = Add(LYState.cursor_y, flt_mar_top)
                flt_x = 0
                flt_container_r = Add(LYState.indent, LYState.avail_w)
                IfCondition EqualTo(float_dir, 1) ThenBlock: {
                    // Float left: position after existing left floats
                    flt_x = LYFloat_LeftAt(flt_y, LYState.indent)
                    flt_x = Add(flt_x, flt_mar_left)
                    // If float doesn't fit, drop below existing floats
                    flt_need = Add(flt_x, flt_w)
                    flt_wrap_tries = 0
                    WhileLoop And(GreaterThan(flt_need, flt_container_r), LessThan(flt_wrap_tries, 32)) {
                        // Move below the lowest float at current y
                        flt_y = LYFloat_ClearY(0)
                        IfCondition EqualTo(flt_y, 0) ThenBlock: {
                            flt_y = Add(LYState.cursor_y, flt_mar_top)
                            flt_wrap_tries = 32
                        }
                        flt_x = LYFloat_LeftAt(flt_y, LYState.indent)
                        flt_x = Add(flt_x, flt_mar_left)
                        flt_need = Add(flt_x, flt_w)
                        flt_wrap_tries = Add(flt_wrap_tries, 1)
                    }
                }
                IfCondition EqualTo(float_dir, 2) ThenBlock: {
                    // Float right: position at right edge minus width
                    flt_rmax = LYFloat_RightAt(flt_y, flt_container_r)
                    flt_x = Subtract(flt_rmax, flt_w)
                    flt_x = Subtract(flt_x, flt_mar_right)
                    // If float doesn't fit (pushed past left edge), drop below
                    flt_wrap_tries = 0
                    WhileLoop And(LessThan(flt_x, LYState.indent), LessThan(flt_wrap_tries, 32)) {
                        flt_y = LYFloat_ClearY(0)
                        IfCondition EqualTo(flt_y, 0) ThenBlock: {
                            flt_y = Add(LYState.cursor_y, flt_mar_top)
                            flt_wrap_tries = 32
                        }
                        flt_rmax = LYFloat_RightAt(flt_y, flt_container_r)
                        flt_x = Subtract(flt_rmax, flt_w)
                        flt_x = Subtract(flt_x, flt_mar_right)
                        flt_wrap_tries = Add(flt_wrap_tries, 1)
                    }
                }

                // Resolve colors
                flt_fg = LY__ResolveFgColor(node)
                LYState.fg_color = flt_fg
                flt_bg = LY__ResolveBgColor(node)

                // Set up layout state for float contents
                flt_content_w = Subtract(flt_w, Add(flt_pad_left, flt_pad_right))
                IfCondition LessThan(flt_content_w, 8) ThenBlock: {
                    flt_content_w = 8
                }
                LYState.indent = Add(flt_x, flt_pad_left)
                LYState.avail_w = flt_content_w
                LYState.cursor_x = LYState.indent
                LYState.cursor_y = Add(flt_y, flt_pad_top)

                // Layout children within the float box
                // Save float count — floats inside this float don't leak out
                sv_flt_count = LYFloatState.count
                flt_start_y = LYState.cursor_y
                fc = DOM_GetFirstChild(node)
                WhileLoop GreaterEqual(fc, 0) {
                    next_fc = DOM_GetNextSib(fc)
                    LY__LayoutNode(fc)
                    fc = next_fc
                }
                // Restore float count — inner floats scoped to this float box
                LYFloatState.count = sv_flt_count

                // Flush trailing inline content
                IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
                    flt_lh = LY__LineHeight()
                    LYState.cursor_y = Add(LYState.cursor_y, flt_lh)
                }

                // Compute float content height
                flt_ch = Subtract(LYState.cursor_y, flt_start_y)
                // Apply explicit height if set
                flt_hv = 0
                IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                    flt_hcv = CSS_GetPropVal(inline_rule, "height")
                    IfCondition NotEqual(flt_hcv, 0) ThenBlock: {
                        flt_hv = LY__ParsePx(flt_hcv)
                    }
                }
                IfCondition EqualTo(flt_hv, 0) ThenBlock: {
                    flt_hcss = LY__CSSLookupProp(node, "height")
                    IfCondition NotEqual(flt_hcss, 0) ThenBlock: {
                        flt_hv = LY__ParsePx(flt_hcss)
                    }
                }
                IfCondition GreaterThan(flt_hv, flt_ch) ThenBlock: {
                    flt_ch = flt_hv
                }

                // Total float box height including padding
                flt_total_h = Add(flt_ch, Add(flt_pad_top, flt_pad_bottom))

                // Emit background rect for the float
                IfCondition NotEqual(flt_bg, LYConst.COLOR_TRANSP) ThenBlock: {
                    IfCondition GreaterThan(flt_total_h, 0) ThenBlock: {
                        LY__EmitFillRect(flt_x, flt_y, flt_w, flt_total_h, flt_bg)
                    }
                }

                // Register this float in the float pool
                LYFloat_Add(float_dir, flt_x, flt_y, flt_w, flt_total_h)
                LYState.dbg_floats = Add(LYState.dbg_floats, 1)

                PrintMessage("[FLOAT] dir=")
                PrintNumber(float_dir)
                PrintMessage(" x=")
                PrintNumber(flt_x)
                PrintMessage(" y=")
                PrintNumber(flt_y)
                PrintMessage(" w=")
                PrintNumber(flt_w)
                PrintMessage(" h=")
                PrintNumber(flt_total_h)
                PrintMessage(" <")
                IfCondition NotEqual(tag, 0) ThenBlock: { PrintMessage(tag) }
                PrintMessage(">\n")

                // Restore parent state — cursor_y NOT advanced (floats don't push content down)
                LYState.fg_color = sv_fg
                LYState.bg_color = sv_bg
                LYState.font_scale = sv_sc
                LYState.indent = sv_ind
                LYState.avail_w = sv_aw
                LYState.text_align = sv_ta
                LYState.visible = sv_vis
                LYState.line_height = sv_lh
                LYState.font_size_px = sv_fspx
                LYState.font_w_px = sv_fwpx
                LYState.is_ahem = sv_ahem
                LYState.cursor_x = sv_ind
                // Restore cursor_y — float children modified it but floats are out of flow
                LYState.cursor_y = sv_cursor_y
                ReturnValue(0)
            }

            // =====================================================================
            // CLEAR PROPERTY — advance past floats
            // =====================================================================
            clear_dir = 0   // 0=none, 1=left, 2=right, 3=both
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                cl_v = CSS_GetPropVal(inline_rule, "clear")
                IfCondition NotEqual(cl_v, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(cl_v, "left"), 0) ThenBlock: { clear_dir = 1 }
                    IfCondition EqualTo(StringCompare(cl_v, "right"), 0) ThenBlock: { clear_dir = 2 }
                    IfCondition EqualTo(StringCompare(cl_v, "both"), 0) ThenBlock: { clear_dir = 3 }
                }
            }
            IfCondition EqualTo(clear_dir, 0) ThenBlock: {
                cl_css = LY__CSSLookupProp(node, "clear")
                IfCondition NotEqual(cl_css, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(cl_css, "left"), 0) ThenBlock: { clear_dir = 1 }
                    IfCondition EqualTo(StringCompare(cl_css, "right"), 0) ThenBlock: { clear_dir = 2 }
                    IfCondition EqualTo(StringCompare(cl_css, "both"), 0) ThenBlock: { clear_dir = 3 }
                }
            }
            IfCondition GreaterThan(clear_dir, 0) ThenBlock: {
                // Map clear_dir to LYFloat_ClearY convention: 1=left, 2=right, 0=both
                clear_arg = clear_dir
                IfCondition EqualTo(clear_dir, 3) ThenBlock: { clear_arg = 0 }
                clear_y = LYFloat_ClearY(clear_arg)
                IfCondition GreaterThan(clear_y, LYState.cursor_y) ThenBlock: {
                    LYState.cursor_y = clear_y
                }
            }

            // =====================================================================
            // NORMAL BLOCK FLOW (non-floated)
            // =====================================================================

            // Resolve per-side margin and padding from CSS/inline/defaults
            margin_top = LY__ResolveMarginSide(node, tag, 0)
            margin_right = LY__ResolveMarginSide(node, tag, 1)
            margin_bottom = LY__ResolveMarginSide(node, tag, 2)
            margin_left = LY__ResolveMarginSide(node, tag, 3)
            pad_top = LY__ResolvePaddingSide(node, tag, 0)
            pad_right = LY__ResolvePaddingSide(node, tag, 1)
            pad_bottom = LY__ResolvePaddingSide(node, tag, 2)
            pad_left = LY__ResolvePaddingSide(node, tag, 3)

            heading_sc = LY__HeadingScale(tag)

            // Font-size resolution: heading tag > CSS rule > inherited from parent
            IfCondition GreaterThan(heading_sc, 1) ThenBlock: {
                // Heading tags have fixed scale
                LYState.font_scale = heading_sc
            } ElseBlock: {
                // Check CSS font-size (cached inline style, then stylesheet)
                fs_val = 0
                IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                    fs_val = CSS_GetPropVal(inline_rule, "font-size")
                }
                IfCondition EqualTo(fs_val, 0) ThenBlock: {
                    fs_val = LY__CSSLookupProp(node, "font-size")
                }
                IfCondition NotEqual(fs_val, 0) ThenBlock: {
                    fs_px = LY__ParsePx(fs_val)
                    LYState.font_size_px = fs_px
                    IfCondition GreaterEqual(fs_px, 32) ThenBlock: {
                        LYState.font_scale = 3
                    } ElseBlock: {
                        IfCondition GreaterEqual(fs_px, 24) ThenBlock: {
                            LYState.font_scale = 2
                        } ElseBlock: {
                            LYState.font_scale = 1
                        }
                    }
                }
                // If no CSS font-size found, inherit from parent (LYState.font_scale unchanged)
            }

            // Resolve font-family: detect Ahem test font
            // Ahem glyphs are solid squares, 1em x 1em — every char is font_size_px wide
            ff_val = 0
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                ff_val = CSS_GetPropVal(inline_rule, "font-family")
            }
            IfCondition EqualTo(ff_val, 0) ThenBlock: {
                ff_val = LY__CSSLookupProp(node, "font-family")
            }
            IfCondition NotEqual(ff_val, 0) ThenBlock: {
                // Check if font-family contains "Ahem" (case-sensitive)
                ff_ahem = StringIndexOf(ff_val, "Ahem")
                IfCondition GreaterEqual(ff_ahem, 0) ThenBlock: {
                    LYState.is_ahem = 1
                    // Ahem: every glyph is a filled square of font_size_px x font_size_px
                    LYState.font_w_px = LYState.font_size_px
                }
            }

            // Resolve CSS line-height (cached inline style > stylesheet > inherited)
            lh_val = 0
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                lh_cv = CSS_GetPropVal(inline_rule, "line-height")
                IfCondition NotEqual(lh_cv, 0) ThenBlock: {
                    lh_val = LY__ParsePx(lh_cv)
                }
            }
            IfCondition EqualTo(lh_val, 0) ThenBlock: {
                lh_css = LY__CSSLookupProp(node, "line-height")
                IfCondition NotEqual(lh_css, 0) ThenBlock: {
                    lh_val = LY__ParsePx(lh_css)
                }
            }
            IfCondition GreaterThan(lh_val, 0) ThenBlock: {
                // Small values (< 10) are unitless multipliers of font height
                // e.g. line-height: 2 means 2x font_h
                IfCondition LessThan(lh_val, 10) ThenBlock: {
                    cur_fh = Multiply(LYConst.FONT_H, LYState.font_scale)
                    LYState.line_height = Multiply(lh_val, cur_fh)
                } ElseBlock: {
                    LYState.line_height = lh_val
                }
            }
            // If no CSS line-height found, inherit from parent (LYState.line_height unchanged)

            fg = LY__ResolveFgColor(node)
            LYState.fg_color = fg

            bg = LY__ResolveBgColor(node)

            // Default <body> and <html> to white background if no explicit bg set
            // (CSS spec: canvas background defaults to white; body/html propagate)
            IfCondition EqualTo(bg, LYConst.COLOR_TRANSP) ThenBlock: {
                IfCondition NotEqual(tag, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(tag, "body"), 0) ThenBlock: {
                        bg = 4294967295
                    }
                    IfCondition EqualTo(StringCompare(tag, "html"), 0) ThenBlock: {
                        bg = 4294967295
                    }
                }
            }

            // Resolve text-align from cached inline style or CSS rules
            ta_val = 0
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                ta_val = CSS_GetPropVal(inline_rule, "text-align")
            }
            IfCondition EqualTo(ta_val, 0) ThenBlock: {
                ta_val = LY__CSSLookupProp(node, "text-align")
            }
            IfCondition NotEqual(ta_val, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(ta_val, "center"), 0) ThenBlock: {
                    LYState.text_align = 1
                }
                IfCondition EqualTo(StringCompare(ta_val, "right"), 0) ThenBlock: {
                    LYState.text_align = 2
                }
                IfCondition EqualTo(StringCompare(ta_val, "left"), 0) ThenBlock: {
                    LYState.text_align = 0
                }
            }
            // <center> tag implicitly sets text-align: center
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "center"), 0) ThenBlock: {
                    LYState.text_align = 1
                }
            }
            // HTML align attribute (legacy: <div align="center">, <td align="center">)
            align_attr = DOM_GetAttr(node, "align")
            IfCondition NotEqual(align_attr, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(align_attr, "center"), 0) ThenBlock: {
                    LYState.text_align = 1
                }
                IfCondition EqualTo(StringCompare(align_attr, "right"), 0) ThenBlock: {
                    LYState.text_align = 2
                }
            }

            // Resolve width/max-width constraints + margin:auto centering
            blk_constrained = 0
            w_val = 0
            mw_val = 0
            // Check cached inline style
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                w_cv = CSS_GetPropVal(inline_rule, "width")
                IfCondition NotEqual(w_cv, 0) ThenBlock: {
                    w_val = LY__ParsePx(w_cv)
                }
                mw_cv = CSS_GetPropVal(inline_rule, "max-width")
                IfCondition NotEqual(mw_cv, 0) ThenBlock: {
                    mw_val = LY__ParsePx(mw_cv)
                }
            }
            // Check CSS rules
            IfCondition EqualTo(w_val, 0) ThenBlock: {
                w_css = LY__CSSLookupProp(node, "width")
                IfCondition NotEqual(w_css, 0) ThenBlock: {
                    w_val = LY__ParsePx(w_css)
                }
            }
            IfCondition EqualTo(mw_val, 0) ThenBlock: {
                mw_css = LY__CSSLookupProp(node, "max-width")
                IfCondition NotEqual(mw_css, 0) ThenBlock: {
                    mw_val = LY__ParsePx(mw_css)
                }
            }
            // Apply width constraint
            IfCondition GreaterThan(w_val, 0) ThenBlock: {
                PrintMessage("[WIDTH] <")
                IfCondition NotEqual(tag, 0) ThenBlock: { PrintMessage(tag) }
                PrintMessage("> w_val=")
                PrintNumber(w_val)
                PrintMessage(" avail_w=")
                PrintNumber(LYState.avail_w)
                PrintMessage("\n")
                IfCondition LessThan(w_val, LYState.avail_w) ThenBlock: {
                    blk_constrained = 1
                    LYState.avail_w = w_val
                }
            }
            IfCondition GreaterThan(mw_val, 0) ThenBlock: {
                PrintMessage("[MAX-W] <")
                IfCondition NotEqual(tag, 0) ThenBlock: { PrintMessage(tag) }
                PrintMessage("> mw_val=")
                PrintNumber(mw_val)
                PrintMessage(" avail_w=")
                PrintNumber(LYState.avail_w)
                PrintMessage("\n")
                IfCondition LessThan(mw_val, LYState.avail_w) ThenBlock: {
                    blk_constrained = 1
                    LYState.avail_w = mw_val
                }
            }
            // Check margin:auto (center the block)
            IfCondition EqualTo(blk_constrained, 1) ThenBlock: {
                m_auto = 0
                // Check cached inline margin
                IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                    ma_v = CSS_GetPropVal(inline_rule, "margin")
                    IfCondition NotEqual(ma_v, 0) ThenBlock: {
                        IfCondition GreaterEqual(StringIndexOf(ma_v, "auto"), 0) ThenBlock: {
                            m_auto = 1
                        }
                    }
                }
                // Check CSS rules for margin
                IfCondition EqualTo(m_auto, 0) ThenBlock: {
                    m_css = LY__CSSLookupProp(node, "margin")
                    IfCondition NotEqual(m_css, 0) ThenBlock: {
                        IfCondition GreaterEqual(StringIndexOf(m_css, "auto"), 0) ThenBlock: {
                            m_auto = 1
                        }
                    }
                }
                // Apply centering
                IfCondition EqualTo(m_auto, 1) ThenBlock: {
                    extra = Subtract(sv_aw, LYState.avail_w)
                    IfCondition GreaterThan(extra, 0) ThenBlock: {
                        LYState.indent = Add(LYState.indent, Divide(extra, 2))
                    }
                }
            }

            // Apply margin-top + margin-left
            LYState.cursor_y = Add(LYState.cursor_y, margin_top)
            IfCondition GreaterThan(margin_left, 0) ThenBlock: {
                LYState.indent = Add(LYState.indent, margin_left)
                LYState.avail_w = Subtract(LYState.avail_w, margin_left)
            }
            IfCondition GreaterThan(margin_right, 0) ThenBlock: {
                LYState.avail_w = Subtract(LYState.avail_w, margin_right)
            }

            // Resolve CSS height (explicit height on block element)
            h_val = 0
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                h_cv = CSS_GetPropVal(inline_rule, "height")
                IfCondition NotEqual(h_cv, 0) ThenBlock: {
                    h_val = LY__ParsePx(h_cv)
                }
            }
            IfCondition EqualTo(h_val, 0) ThenBlock: {
                h_css = LY__CSSLookupProp(node, "height")
                IfCondition NotEqual(h_css, 0) ThenBlock: {
                    h_val = LY__ParsePx(h_css)
                }
            }
            // Also check min-height (cached inline style, then stylesheet)
            minh_val = 0
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                minh_cv = CSS_GetPropVal(inline_rule, "min-height")
                IfCondition NotEqual(minh_cv, 0) ThenBlock: {
                    minh_val = LY__ParsePx(minh_cv)
                }
            }
            IfCondition EqualTo(minh_val, 0) ThenBlock: {
                minh_css = LY__CSSLookupProp(node, "min-height")
                IfCondition NotEqual(minh_css, 0) ThenBlock: {
                    minh_val = LY__ParsePx(minh_css)
                }
            }

            // Resolve border widths for all 4 sides
            bdr_top = LY__ResolveBorderWidth(node, 0)
            bdr_right = LY__ResolveBorderWidth(node, 1)
            bdr_bottom = LY__ResolveBorderWidth(node, 2)
            bdr_left = LY__ResolveBorderWidth(node, 3)

            // Save border-box start position (after margin, before border)
            border_start_y = LYState.cursor_y
            border_start_x = LYState.indent

            // Apply border + padding — per-side indent and avail width
            IfCondition GreaterThan(bdr_left, 0) ThenBlock: {
                LYState.indent = Add(LYState.indent, bdr_left)
                LYState.avail_w = Subtract(LYState.avail_w, bdr_left)
            }
            IfCondition GreaterThan(bdr_right, 0) ThenBlock: {
                LYState.avail_w = Subtract(LYState.avail_w, bdr_right)
            }
            IfCondition GreaterThan(bdr_top, 0) ThenBlock: {
                LYState.cursor_y = Add(LYState.cursor_y, bdr_top)
            }
            IfCondition GreaterThan(pad_left, 0) ThenBlock: {
                LYState.indent = Add(LYState.indent, pad_left)
                LYState.avail_w = Subtract(LYState.avail_w, pad_left)
            }
            IfCondition GreaterThan(pad_right, 0) ThenBlock: {
                LYState.avail_w = Subtract(LYState.avail_w, pad_right)
            }
            IfCondition GreaterThan(pad_top, 0) ThenBlock: {
                LYState.cursor_y = Add(LYState.cursor_y, pad_top)
            }
            // If avail_w has gone to zero or negative from nested padding/margin/border,
            // skip children entirely — there's no space to render anything.
            // (Without this, text wraps to 1 char per line → vertical text columns)
            IfCondition LessThan(LYState.avail_w, 16) ThenBlock: {
                PrintMessage("[BAIL] <")
                IfCondition NotEqual(tag, 0) ThenBlock: { PrintMessage(tag) }
                PrintMessage("> avail_w=")
                PrintNumber(LYState.avail_w)
                PrintMessage(" indent=")
                PrintNumber(LYState.indent)
                PrintMessage(" pad_l=")
                PrintNumber(pad_left)
                PrintMessage(" pad_r=")
                PrintNumber(pad_right)
                PrintMessage(" marg_l=")
                PrintNumber(margin_left)
                PrintMessage(" marg_r=")
                PrintNumber(margin_right)
                PrintMessage(" bdr_l=")
                PrintNumber(bdr_left)
                PrintMessage(" bdr_r=")
                PrintNumber(bdr_right)
                PrintMessage("\n")
                // Restore parent state and return — nothing fits
                LYState.fg_color = sv_fg
                LYState.bg_color = sv_bg
                LYState.font_scale = sv_sc
                LYState.indent = sv_ind
                LYState.avail_w = sv_aw
                LYState.text_align = sv_ta
                LYState.visible = sv_vis
                LYState.line_height = sv_lh
                LYState.font_size_px = sv_fspx
                LYState.font_w_px = sv_fwpx
                LYState.is_ahem = sv_ahem
                LYFloatState.count = sv_float_count
                LYState.cursor_x = sv_ind
                ReturnValue(0)
            }

            // Save content start Y for background rect
            block_start_y = LYState.cursor_y
            // Reset cursor_x for inline text flow within this block
            LYState.cursor_x = LYState.indent

            // Special: <hr> draws a line
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "hr"), 0) ThenBlock: {
                    LY__EmitDrawLine(LYState.indent, LYState.cursor_y, LYState.avail_w, LYConst.COLOR_GRAY)
                    LYState.cursor_y = Add(LYState.cursor_y, 2)
                }
            }

            // Check if this is a flex container
            is_flex = 0
            IfCondition NotEqual(css_disp, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(css_disp, "flex"), 0) ThenBlock: {
                    is_flex = 1
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline-flex"), 0) ThenBlock: {
                    is_flex = 1
                }
            }
            // Also check cached inline style for display:flex
            IfCondition EqualTo(is_flex, 0) ThenBlock: {
                IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                    fl_dv = CSS_GetPropVal(inline_rule, "display")
                    IfCondition NotEqual(fl_dv, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(fl_dv, "flex"), 0) ThenBlock: {
                            is_flex = 1
                        }
                        IfCondition EqualTo(StringCompare(fl_dv, "inline-flex"), 0) ThenBlock: {
                            is_flex = 1
                        }
                    }
                }
            }

            // Process children — flex or normal flow
            IfCondition EqualTo(is_flex, 1) ThenBlock: {
                LY__FlexLayout(node)
            }
            IfCondition EqualTo(is_flex, 0) ThenBlock: {
                // Normal block flow — get next sibling BEFORE recursing
                bc = DOM_GetFirstChild(node)
                WhileLoop GreaterEqual(bc, 0) {
                    next_bc = DOM_GetNextSib(bc)
                    LY__LayoutNode(bc)
                    bc = next_bc
                }
            }

            // Flush trailing inline content on the current line
            IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
                end_fh = LY__LineHeight()
                LYState.cursor_y = Add(LYState.cursor_y, end_fh)
                LYState.cursor_x = LYState.indent
            }

            // Float containment — if this block has child floats, expand to contain them
            // This implements BFC (Block Formatting Context) behavior:
            // blocks with overflow != visible, or floats, or flex, auto-contain floats.
            // For simplicity, we do this for ALL blocks that have child floats,
            // which is slightly incorrect per spec but works for most real-world sites.
            IfCondition GreaterThan(LYFloatState.count, sv_float_count) ThenBlock: {
                fci = sv_float_count
                WhileLoop LessThan(fci, LYFloatState.count) {
                    fc_off = Multiply(fci, LYFloatState.ENTRY_SIZE)
                    fc_base = Add(LYFloatState.pool, fc_off)
                    fc_fy = Dereference(Add(fc_base, LYFloatState.F_Y))
                    fc_fh = Dereference(Add(fc_base, LYFloatState.F_H))
                    fc_bot = Add(fc_fy, fc_fh)
                    IfCondition GreaterThan(fc_bot, LYState.cursor_y) ThenBlock: {
                        LYState.cursor_y = fc_bot
                    }
                    fci = Add(fci, 1)
                }
            }

            // Compute content height — use explicit CSS height if set
            content_h = Subtract(LYState.cursor_y, block_start_y)
            IfCondition GreaterThan(h_val, 0) ThenBlock: {
                // Explicit height: override content height
                IfCondition GreaterThan(h_val, content_h) ThenBlock: {
                    content_h = h_val
                    LYState.cursor_y = Add(block_start_y, h_val)
                }
            }
            IfCondition GreaterThan(minh_val, 0) ThenBlock: {
                // Min-height: ensure at least this tall
                IfCondition GreaterThan(minh_val, content_h) ThenBlock: {
                    content_h = minh_val
                    LYState.cursor_y = Add(block_start_y, minh_val)
                }
            }

            // Emit background rect now that we know height
            block_x = Subtract(LYState.indent, pad_left)
            block_w = Add(LYState.avail_w, Add(pad_left, pad_right))
            IfCondition NotEqual(bg, LYConst.COLOR_TRANSP) ThenBlock: {
                IfCondition GreaterThan(content_h, 0) ThenBlock: {
                    LY__EmitFillRect(block_x, block_start_y, block_w, content_h, bg)
                }
            }

            // Apply padding-bottom
            IfCondition GreaterThan(pad_bottom, 0) ThenBlock: {
                LYState.cursor_y = Add(LYState.cursor_y, pad_bottom)
            }

            // Emit border rects (4 thin FILL_RECTs around the border-box)
            // Use flag instead of Or(GreaterThan, Or(GreaterThan, ...)) assignment
            has_border = 0
            IfCondition GreaterThan(bdr_top, 0) ThenBlock: { has_border = 1 }
            IfCondition GreaterThan(bdr_right, 0) ThenBlock: { has_border = 1 }
            IfCondition GreaterThan(bdr_bottom, 0) ThenBlock: { has_border = 1 }
            IfCondition GreaterThan(bdr_left, 0) ThenBlock: { has_border = 1 }
            IfCondition EqualTo(has_border, 1) ThenBlock: {
                // Compute border-box dimensions
                bdr_box_x = border_start_x
                bdr_box_y = border_start_y
                bdr_box_w = Add(LYState.avail_w, Add(pad_left, Add(pad_right, Add(bdr_left, bdr_right))))
                bdr_box_h = Add(Subtract(LYState.cursor_y, border_start_y), bdr_bottom)

                // Resolve border color (default to currentColor / fg)
                bdr_color = LY__ResolveBorderColor(node, 0)
                IfCondition EqualTo(bdr_color, 0) ThenBlock: {
                    bdr_color = fg
                }

                // Top border
                IfCondition GreaterThan(bdr_top, 0) ThenBlock: {
                    LY__EmitFillRect(bdr_box_x, bdr_box_y, bdr_box_w, bdr_top, bdr_color)
                }
                // Bottom border
                IfCondition GreaterThan(bdr_bottom, 0) ThenBlock: {
                    LY__EmitFillRect(bdr_box_x, Add(bdr_box_y, Subtract(bdr_box_h, bdr_bottom)), bdr_box_w, bdr_bottom, bdr_color)
                }
                // Left border
                IfCondition GreaterThan(bdr_left, 0) ThenBlock: {
                    LY__EmitFillRect(bdr_box_x, bdr_box_y, bdr_left, bdr_box_h, bdr_color)
                }
                // Right border
                IfCondition GreaterThan(bdr_right, 0) ThenBlock: {
                    LY__EmitFillRect(Add(bdr_box_x, Subtract(bdr_box_w, bdr_right)), bdr_box_y, bdr_right, bdr_box_h, bdr_color)
                }
            }

            // Apply border-bottom to cursor
            IfCondition GreaterThan(bdr_bottom, 0) ThenBlock: {
                LYState.cursor_y = Add(LYState.cursor_y, bdr_bottom)
            }

            // Apply margin-bottom
            LYState.cursor_y = Add(LYState.cursor_y, margin_bottom)

            // Restore parent state from stack locals
            LYState.fg_color = sv_fg
            LYState.bg_color = sv_bg
            LYState.font_scale = sv_sc
            LYState.indent = sv_ind
            LYState.avail_w = sv_aw
            LYState.text_align = sv_ta
            LYState.visible = sv_vis
            LYState.line_height = sv_lh
            LYState.font_size_px = sv_fspx
            LYState.font_w_px = sv_fwpx
            LYState.is_ahem = sv_ahem
            LYFloatState.count = sv_float_count
            LYState.cursor_x = sv_ind
            ReturnValue(0)
        }

        // INLINE element — process children with possible color change
        IfCondition EqualTo(disp, LYDisp.INLINE) ThenBlock: {
            LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
            LYState.dbg_inlines = Add(LYState.dbg_inlines, 1)
            sv_fg2 = LYState.fg_color
            sv_vis2 = LYState.visible

            // Apply visibility:hidden for inline elements
            IfCondition EqualTo(is_visible, 0) ThenBlock: {
                LYState.visible = 0
            }

            fg2 = LY__ResolveFgColor(node)
            LYState.fg_color = fg2

            // Special: <br> — line break
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "br"), 0) ThenBlock: {
                    font_h = LY__LineHeight()
                    LYState.cursor_y = Add(LYState.cursor_y, font_h)
                    LYState.cursor_x = LYState.indent
                }
            }

            // Special: <input> — render as visible text box
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "input"), 0) ThenBlock: {
                    in_type = DOM_GetAttr(node, "type")
                    in_hidden = 0
                    IfCondition NotEqual(in_type, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(in_type, "hidden"), 0) ThenBlock: {
                            in_hidden = 1
                        }
                    }
                    IfCondition EqualTo(in_hidden, 0) ThenBlock: {
                        // Determine if button-style or text-style
                        in_is_btn = 0
                        IfCondition NotEqual(in_type, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(in_type, "submit"), 0) ThenBlock: { in_is_btn = 1 }
                            IfCondition EqualTo(StringCompare(in_type, "button"), 0) ThenBlock: { in_is_btn = 1 }
                            IfCondition EqualTo(StringCompare(in_type, "reset"), 0) ThenBlock: { in_is_btn = 1 }
                        }
                        IfCondition EqualTo(in_is_btn, 1) ThenBlock: {
                            // Button: draw filled rect with label text
                            in_val = DOM_GetAttr(node, "value")
                            IfCondition EqualTo(in_val, 0) ThenBlock: { in_val = "Submit" }
                            in_tlen = StringLength(in_val)
                            in_bw = Add(Multiply(in_tlen, 8), 16)
                            // Position at cursor_x (inline flow)
                            in_x = LYState.cursor_x
                            // Wrap if doesn't fit
                            in_re = Add(LYState.indent, LYState.avail_w)
                            IfCondition GreaterThan(Add(in_x, in_bw), in_re) ThenBlock: {
                                IfCondition GreaterThan(in_x, LYState.indent) ThenBlock: {
                                    LYState.cursor_y = Add(LYState.cursor_y, 28)
                                    in_x = LYState.indent
                                }
                            }
                            // Button background (light gray)
                            LY__EmitFillRect(in_x, LYState.cursor_y, in_bw, 24, 4293388263)
                            // Border (dark gray)
                            LY__EmitDrawLine(in_x, LYState.cursor_y, in_bw, LYConst.COLOR_GRAY)
                            LY__EmitDrawLine(in_x, Add(LYState.cursor_y, 23), in_bw, LYConst.COLOR_GRAY)
                            // Record hit-region for click
                            LY__AddHitRegion(in_x, LYState.cursor_y, in_bw, 24, node, LYHitType.BUTTON)
                            // Text
                            LYTmp.ptr = in_val
                            LY__EmitDrawText(Add(in_x, 8), Add(LYState.cursor_y, 4), in_tlen, LYConst.COLOR_BLACK)
                            // Advance cursor_x past button (inline flow)
                            LYState.cursor_x = Add(in_x, Add(in_bw, 4))
                        } ElseBlock: {
                            // Text input: draw bordered rect with placeholder
                            in_ph = DOM_GetAttr(node, "placeholder")
                            in_val = DOM_GetAttr(node, "value")
                            in_w = 240
                            // Check size attribute
                            in_sz = DOM_GetAttr(node, "size")
                            IfCondition NotEqual(in_sz, 0) ThenBlock: {
                                in_szv = LY__ParsePx(in_sz)
                                IfCondition GreaterThan(in_szv, 0) ThenBlock: {
                                    in_w = Multiply(in_szv, 8)
                                }
                            }
                            // Also check CSS width from inline style
                            in_wstr = DOM_GetAttr(node, "style")
                            IfCondition NotEqual(in_wstr, 0) ThenBlock: {
                                IfCondition GreaterEqual(StringIndexOf(in_wstr, "width"), 0) ThenBlock: {
                                    in_wslen = StringLength(in_wstr)
                                    in_wrule = CSS_ParseInline(in_wstr, in_wslen)
                                    IfCondition GreaterEqual(in_wrule, 0) ThenBlock: {
                                        in_wcss = CSS_GetPropVal(in_wrule, "width")
                                        IfCondition NotEqual(in_wcss, 0) ThenBlock: {
                                            in_wpx = LY__ParsePx(in_wcss)
                                            IfCondition GreaterThan(in_wpx, 0) ThenBlock: {
                                                in_w = in_wpx
                                            }
                                        }
                                    }
                                }
                            }
                            // Position at cursor_x (inline flow)
                            in_x = LYState.cursor_x
                            // Wrap if doesn't fit
                            in_re = Add(LYState.indent, LYState.avail_w)
                            IfCondition GreaterThan(Add(in_x, in_w), in_re) ThenBlock: {
                                IfCondition GreaterThan(in_x, LYState.indent) ThenBlock: {
                                    LYState.cursor_y = Add(LYState.cursor_y, 28)
                                    in_x = LYState.indent
                                }
                            }
                            // Clamp width to available space
                            IfCondition GreaterThan(in_w, LYState.avail_w) ThenBlock: {
                                in_w = LYState.avail_w
                            }
                            // White background
                            LY__EmitFillRect(in_x, LYState.cursor_y, in_w, 24, LYConst.COLOR_WHITE)
                            // Border lines (top, bottom)
                            LY__EmitDrawLine(in_x, LYState.cursor_y, in_w, LYConst.COLOR_GRAY)
                            LY__EmitDrawLine(in_x, Add(LYState.cursor_y, 23), in_w, LYConst.COLOR_GRAY)
                            // Record hit-region for click focus
                            LY__AddHitRegion(in_x, LYState.cursor_y, in_w, 24, node, LYHitType.INPUT)
                            // Placeholder or value text
                            in_txt = in_val
                            in_clr = LYConst.COLOR_BLACK
                            IfCondition EqualTo(in_txt, 0) ThenBlock: {
                                in_txt = in_ph
                                in_clr = LYConst.COLOR_GRAY
                            }
                            IfCondition NotEqual(in_txt, 0) ThenBlock: {
                                in_tl = StringLength(in_txt)
                                IfCondition GreaterThan(in_tl, 0) ThenBlock: {
                                    LYTmp.ptr = in_txt
                                    LY__EmitDrawText(Add(in_x, 4), Add(LYState.cursor_y, 4), in_tl, in_clr)
                                }
                            }
                            // Advance cursor_x past input (inline flow)
                            LYState.cursor_x = Add(in_x, Add(in_w, 4))
                        }
                    }
                }
            }

            // Special: <select> — render as dropdown box
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "select"), 0) ThenBlock: {
                    // Draw a compact dropdown-like box
                    sel_w = 160
                    LY__EmitFillRect(LYState.indent, LYState.cursor_y, sel_w, 24, LYConst.COLOR_WHITE)
                    LY__EmitDrawLine(LYState.indent, LYState.cursor_y, sel_w, LYConst.COLOR_GRAY)
                    LY__EmitDrawLine(LYState.indent, Add(LYState.cursor_y, 23), sel_w, LYConst.COLOR_GRAY)
                    // Draw dropdown arrow indicator
                    LYTmp.ptr = "v"
                    LY__EmitDrawText(Add(LYState.indent, Subtract(sel_w, 12)), Add(LYState.cursor_y, 4), 1, LYConst.COLOR_GRAY)
                    LYState.cursor_y = Add(LYState.cursor_y, 28)
                    // Skip children (option elements)
                    LYState.fg_color = sv_fg2
                    LYState.visible = sv_vis2
                    ReturnValue(0)
                }
            }

            // Special: <textarea> — render as multi-line text box with input support
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "textarea"), 0) ThenBlock: {
                    ta_w = 400
                    ta_h = 24
                    // Google uses textarea with rows="1" — treat as single-line input
                    ta_rows = DOM_GetAttr(node, "rows")
                    IfCondition NotEqual(ta_rows, 0) ThenBlock: {
                        ta_rv = LY__ParsePx(ta_rows)
                        IfCondition GreaterThan(ta_rv, 1) ThenBlock: {
                            ta_h = Multiply(ta_rv, 16)
                        }
                    }
                    // Center if text-align: center
                    ta_x = LYState.indent
                    IfCondition EqualTo(LYState.text_align, 1) ThenBlock: {
                        IfCondition LessThan(ta_w, LYState.avail_w) ThenBlock: {
                            ta_x = Add(LYState.indent, Divide(Subtract(LYState.avail_w, ta_w), 2))
                        }
                    }
                    // White background
                    LY__EmitFillRect(ta_x, LYState.cursor_y, ta_w, ta_h, LYConst.COLOR_WHITE)
                    // Border
                    LY__EmitDrawLine(ta_x, LYState.cursor_y, ta_w, LYConst.COLOR_GRAY)
                    LY__EmitDrawLine(ta_x, Add(LYState.cursor_y, Subtract(ta_h, 1)), ta_w, LYConst.COLOR_GRAY)
                    // Record hit-region for click focus (same as text input)
                    LY__AddHitRegion(ta_x, LYState.cursor_y, ta_w, ta_h, node, LYHitType.INPUT)
                    // Show placeholder or value text
                    ta_ph = DOM_GetAttr(node, "placeholder")
                    ta_val = DOM_GetAttr(node, "value")
                    ta_txt = ta_val
                    ta_clr = LYConst.COLOR_BLACK
                    IfCondition EqualTo(ta_txt, 0) ThenBlock: {
                        ta_txt = ta_ph
                        ta_clr = LYConst.COLOR_GRAY
                    }
                    IfCondition NotEqual(ta_txt, 0) ThenBlock: {
                        ta_tl = StringLength(ta_txt)
                        IfCondition GreaterThan(ta_tl, 0) ThenBlock: {
                            LYTmp.ptr = ta_txt
                            LY__EmitDrawText(Add(ta_x, 4), Add(LYState.cursor_y, 4), ta_tl, ta_clr)
                        }
                    }
                    LYState.cursor_y = Add(LYState.cursor_y, Add(ta_h, 4))
                    // Skip children — textarea content is the value, not child nodes
                    LYState.fg_color = sv_fg2
                    LYState.visible = sv_vis2
                    ReturnValue(0)
                }
            }

            // Special: <button> — render as button
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "button"), 0) ThenBlock: {
                    // Save cursor, process children to get text, then wrap in button box
                    btn_y = LYState.cursor_y
                    // Button background
                    LY__EmitFillRect(LYState.indent, btn_y, 120, 24, 4293388263)
                    LY__EmitDrawLine(LYState.indent, btn_y, 120, LYConst.COLOR_GRAY)
                    LY__EmitDrawLine(LYState.indent, Add(btn_y, 23), 120, LYConst.COLOR_GRAY)
                    // Record hit-region for click
                    LY__AddHitRegion(LYState.indent, btn_y, 120, 24, node, LYHitType.BUTTON)
                    // Offset text inside button
                    LYState.indent = Add(LYState.indent, 8)
                    LYState.cursor_y = Add(LYState.cursor_y, 4)

                    ic = DOM_GetFirstChild(node)
                    WhileLoop GreaterEqual(ic, 0) {
                        next_ic = DOM_GetNextSib(ic)
                        LY__LayoutNode(ic)
                        ic = next_ic
                    }

                    LYState.indent = Subtract(LYState.indent, 8)
                    LYState.cursor_y = Add(btn_y, 28)
                    LYState.fg_color = sv_fg2
                    LYState.visible = sv_vis2
                    ReturnValue(0)
                }
            }

            // Special: <img> — render placeholder with alt text
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "img"), 0) ThenBlock: {
                    img_alt = DOM_GetAttr(node, "alt")
                    img_w = 64
                    img_h = 20
                    // Try to get dimensions
                    img_ws = DOM_GetAttr(node, "width")
                    IfCondition NotEqual(img_ws, 0) ThenBlock: {
                        img_wv = LY__ParsePx(img_ws)
                        IfCondition GreaterThan(img_wv, 0) ThenBlock: { img_w = img_wv }
                    }
                    img_hs = DOM_GetAttr(node, "height")
                    IfCondition NotEqual(img_hs, 0) ThenBlock: {
                        img_hv = LY__ParsePx(img_hs)
                        IfCondition GreaterThan(img_hv, 0) ThenBlock: { img_h = img_hv }
                    }
                    // Only show if it has alt text and reasonable size
                    IfCondition NotEqual(img_alt, 0) ThenBlock: {
                        alt_len = StringLength(img_alt)
                        IfCondition GreaterThan(alt_len, 0) ThenBlock: {
                            LYTmp.ptr = img_alt
                            LY__EmitDrawText(LYState.indent, LYState.cursor_y, alt_len, LYConst.COLOR_GRAY)
                            LYState.cursor_y = Add(LYState.cursor_y, 18)
                        }
                    }
                }
            }

            // Table cell padding: emit a space separator between <td>/<th> cells
            IfCondition NotEqual(tag, 0) ThenBlock: {
                td_sep = 0
                IfCondition EqualTo(StringCompare(tag, "td"), 0) ThenBlock: { td_sep = 1 }
                IfCondition EqualTo(StringCompare(tag, "th"), 0) ThenBlock: { td_sep = 1 }
                IfCondition EqualTo(td_sep, 1) ThenBlock: {
                    LYTmp.ptr = "  "
                    LY__EmitText(LYTmp.ptr, 2, LYState.fg_color)
                }
            }

            // Record hit-region for <a> links before processing children
            IfCondition NotEqual(tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tag, "a"), 0) ThenBlock: {
                    // Estimate width from first text child
                    link_w = 80
                    link_fc = DOM_GetFirstChild(node)
                    IfCondition GreaterEqual(link_fc, 0) ThenBlock: {
                        link_tl = DOM_GetTextLen(link_fc)
                        IfCondition GreaterThan(link_tl, 0) ThenBlock: {
                            link_w = Multiply(link_tl, LYState.font_w_px)
                        }
                    }
                    LY__AddHitRegion(LYState.cursor_x, LYState.cursor_y, link_w, 16, node, LYHitType.LINK)
                }
            }

            // Process children — get next sibling BEFORE recursing
            ic = DOM_GetFirstChild(node)
            WhileLoop GreaterEqual(ic, 0) {
                next_ic = DOM_GetNextSib(ic)
                LY__LayoutNode(ic)
                ic = next_ic
            }

            LYState.fg_color = sv_fg2
            LYState.visible = sv_vis2
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// PUBLIC API — RUN LAYOUT
// =============================================================================
Function.Layout_Run {
    Input: dom_root: Integer
    Output: Integer
    Body: {
        Layout_Reset()

        // Layout all nodes
        LY__LayoutNode(dom_root)

        LYState.content_h = LYState.cursor_y

        // Print diagnostic summary
        PrintMessage("[LAYOUT] nodes=")
        PrintNumber(LYState.dbg_nodes)
        PrintMessage(" blocks=")
        PrintNumber(LYState.dbg_blocks)
        PrintMessage(" inlines=")
        PrintNumber(LYState.dbg_inlines)
        PrintMessage(" texts=")
        PrintNumber(LYState.dbg_texts)
        PrintMessage(" none=")
        PrintNumber(LYState.dbg_none)
        PrintMessage(" hidden=")
        PrintNumber(LYState.dbg_hidden)
        PrintMessage(" cmds=")
        PrintNumber(LYState.cmd_count)
        PrintMessage("\n")

        ReturnValue(LYState.cmd_count)
    }
}

// =============================================================================
// PUBLIC ACCESSORS
// =============================================================================
Function.Layout_CmdCount {
    Output: Integer
    Body: { ReturnValue(LYState.cmd_count) }
}

Function.Layout_ContentHeight {
    Output: Integer
    Body: { ReturnValue(LYState.content_h) }
}

Function.Layout_CmdType {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_TYPE)) }
}

Function.Layout_CmdX {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_X)) }
}

Function.Layout_CmdY {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_Y)) }
}

Function.Layout_CmdW {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_W)) }
}

Function.Layout_CmdH {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_H)) }
}

Function.Layout_CmdColor {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_COLOR)) }
}

Function.Layout_CmdPtr {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_PTR)) }
}

// =============================================================================
// DEBUG — dump all commands
// =============================================================================
Function.Layout_Dump {
    Body: {
        PrintMessage("[LAYOUT] commands: ")
        PrintNumber(LYState.cmd_count)
        PrintMessage("  content_h: ")
        PrintNumber(LYState.content_h)
        PrintMessage("\n")

        di = 0
        WhileLoop LessThan(di, LYState.cmd_count) {
            ct = LY__CmdGet(di, LYConst.C_TYPE)
            cx = LY__CmdGet(di, LYConst.C_X)
            cy = LY__CmdGet(di, LYConst.C_Y)
            cw = LY__CmdGet(di, LYConst.C_W)

            IfCondition EqualTo(ct, LYCmd.FILL_RECT) ThenBlock: {
                PrintMessage("  FILL_RECT x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" w=")
                PrintNumber(cw)
                ch = LY__CmdGet(di, LYConst.C_H)
                PrintMessage(" h=")
                PrintNumber(ch)
                PrintMessage("\n")
            }

            IfCondition EqualTo(ct, LYCmd.DRAW_TEXT) ThenBlock: {
                PrintMessage("  DRAW_TEXT x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" len=")
                PrintNumber(cw)
                cp = LY__CmdGet(di, LYConst.C_PTR)
                IfCondition NotEqual(cp, 0) ThenBlock: {
                    PrintMessage(" '")
                    PrintMessage(cp)
                    PrintMessage("'")
                }
                PrintMessage("\n")
            }

            IfCondition EqualTo(ct, LYCmd.DRAW_LINE) ThenBlock: {
                PrintMessage("  DRAW_LINE x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" w=")
                PrintNumber(cw)
                PrintMessage("\n")
            }

            di = Add(di, 1)
        }
    }
}
