// Library.HTMLLayoutEngine.ailang — Layout engine dispatcher + public API
// Thin node dispatcher: classifies nodes, delegates to LY__LayoutBlock / LY__LayoutInline.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutColors
LibraryImport.Browser.HTMLLayoutCSS
LibraryImport.Browser.HTMLLayoutFlex
LibraryImport.Browser.HTMLLayoutTraversal
LibraryImport.Browser.HTMLLayoutPositioning
LibraryImport.Browser.HTMLLayoutGrid

Function.LY__LayoutNode {
    Input: node: Integer
    Body: {
        ntype = DOM_GetType(node)

        // TEXT nodes — emit text content
        IfCondition EqualTo(ntype, DOMType.TEXT) ThenBlock: {
            LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
            LYState.dbg_texts = Add(LYState.dbg_texts, 1)
            t_ptr = DOM_GetText(node)
            t_len = DOM_GetTextLen(node)
            IfCondition And(NotEqual(t_ptr, 0), GreaterThan(t_len, 0)) ThenBlock: {
                LY__EmitText(t_ptr, t_len, LYState.fg_color)
            }
            ReturnValue(0)
        }

        // COMMENT nodes — skip
        IfCondition EqualTo(ntype, DOMType.COMMENT) ThenBlock: {
            ReturnValue(0)
        }

        // ROOT node — process children
        IfCondition EqualTo(ntype, DOMType.ROOT) ThenBlock: {
            rc = DOM_GetFirstChild(node)
            WhileLoop GreaterEqual(rc, 0) {
                next_rc = DOM_GetNextSib(rc)
                LY__LayoutNode(rc)
                rc = next_rc
            }
            ReturnValue(0)
        }

        // ELEMENT node — classify and layout
        tag = DOM_GetTag(node)
        disp = LY__GetDisplay(tag)

        // Check HTML hidden attribute
        IfCondition NotEqual(disp, LYDisp.NONE) ThenBlock: {
            hidden_attr = DOM_GetAttr(node, "hidden")
            IfCondition NotEqual(hidden_attr, 0) ThenBlock: {
                disp = LYDisp.NONE
            }
        }

        // Check CSS display:none override
        // Never hide <html> or <body> — sites use "body{display:none}" as anti-FOUC
        // (e.g. DDG: "body{display:none}" + JS adds class to reveal). Since we run
        // scripts before layout, FOUC isn't an issue and body must always render.
        is_root_tag = 0
        IfCondition NotEqual(tag, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(tag, "body"), 0) ThenBlock: { is_root_tag = 1 }
            IfCondition EqualTo(StringCompare(tag, "html"), 0) ThenBlock: { is_root_tag = 1 }
        }
        // Resolve CSS display override (stylesheet + inline style)
        // Inline style overrides stylesheet which overrides tag default
        css_disp = 0
        IfCondition And(NotEqual(disp, LYDisp.NONE), EqualTo(is_root_tag, 0)) ThenBlock: {
            // 1. Check CSS stylesheet rules for display
            css_disp = LY__CSSLookupProp(node, "display")
            IfCondition NotEqual(css_disp, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(css_disp, "none"), 0) ThenBlock: {
                    disp = LYDisp.NONE
                }
                IfCondition EqualTo(StringCompare(css_disp, "block"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline"), 0) ThenBlock: {
                    disp = LYDisp.INLINE
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline-block"), 0) ThenBlock: {
                    disp = LYDisp.INLINE
                }
                IfCondition EqualTo(StringCompare(css_disp, "flex"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline-flex"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "list-item"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-row"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-cell"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-row-group"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-header-group"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-footer-group"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "table-caption"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "grid"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "inline-grid"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "flow-root"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
                IfCondition EqualTo(StringCompare(css_disp, "contents"), 0) ThenBlock: {
                    disp = LYDisp.BLOCK
                }
            }
            // 2. Inline style overrides everything (higher specificity)
            // Must always check — inline style can override CSS display:none back to block
            ds_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(ds_str, 0) ThenBlock: {
                ds_idx = StringIndexOf(ds_str, "display")
                IfCondition GreaterEqual(ds_idx, 0) ThenBlock: {
                    ds_len = StringLength(ds_str)
                    ds_rule = CSS_ParseInline(ds_str, ds_len)
                    IfCondition GreaterEqual(ds_rule, 0) ThenBlock: {
                        ds_val = CSS_GetPropVal(ds_rule, "display")
                        IfCondition NotEqual(ds_val, 0) ThenBlock: {
                            css_disp = ds_val
                            IfCondition EqualTo(StringCompare(ds_val, "none"), 0) ThenBlock: {
                                disp = LYDisp.NONE
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "block"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline"), 0) ThenBlock: {
                                disp = LYDisp.INLINE
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline-block"), 0) ThenBlock: {
                                disp = LYDisp.INLINE
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "flex"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline-flex"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "list-item"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-row"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-cell"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-row-group"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-header-group"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-footer-group"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "table-caption"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "grid"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "inline-grid"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "flow-root"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                            IfCondition EqualTo(StringCompare(ds_val, "contents"), 0) ThenBlock: {
                                disp = LYDisp.BLOCK
                            }
                        }
                    }
                }
            }
        }

        // NONE — skip
        IfCondition EqualTo(disp, LYDisp.NONE) ThenBlock: {
            LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
            LYState.dbg_none = Add(LYState.dbg_none, 1)
            // Diagnostic: print first 10 elements getting display:none
            IfCondition LessThan(LYState.dbg_none, 11) ThenBlock: {
                PrintMessage("[NONE #")
                PrintNumber(node)
                PrintMessage("] <")
                IfCondition NotEqual(tag, 0) ThenBlock: { PrintMessage(tag) }
                PrintMessage("> class=")
                dbg_cls = DOM_GetAttr(node, "class")
                IfCondition NotEqual(dbg_cls, 0) ThenBlock: { PrintMessage(dbg_cls) }
                PrintMessage(" css_disp=")
                IfCondition NotEqual(css_disp, 0) ThenBlock: { PrintMessage(css_disp) }
                PrintMessage("\n")
            }
            ReturnValue(0)
        }

        // Check visibility: hidden (element takes space but isn't painted)
        is_visible = 1
        vis_css = LY__CSSLookupProp(node, "visibility")
        IfCondition NotEqual(vis_css, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(vis_css, "hidden"), 0) ThenBlock: {
                is_visible = 0
            }
            IfCondition EqualTo(StringCompare(vis_css, "collapse"), 0) ThenBlock: {
                is_visible = 0
            }
        }
        // Also check inline style
        IfCondition EqualTo(is_visible, 1) ThenBlock: {
            vis_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(vis_str, 0) ThenBlock: {
                IfCondition GreaterEqual(StringIndexOf(vis_str, "visibility"), 0) ThenBlock: {
                    vis_slen = StringLength(vis_str)
                    vis_rule = CSS_ParseInline(vis_str, vis_slen)
                    IfCondition GreaterEqual(vis_rule, 0) ThenBlock: {
                        vis_v = CSS_GetPropVal(vis_rule, "visibility")
                        IfCondition NotEqual(vis_v, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(vis_v, "hidden"), 0) ThenBlock: {
                                is_visible = 0
                            }
                            IfCondition EqualTo(StringCompare(vis_v, "collapse"), 0) ThenBlock: {
                                is_visible = 0
                            }
                        }
                    }
                }
            }
        }

        // Check aria-hidden="true" — skip element entirely (unambiguous signal)
        aria_h = DOM_GetAttr(node, "aria-hidden")
        IfCondition NotEqual(aria_h, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(aria_h, "true"), 0) ThenBlock: {
                LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
                LYState.dbg_none = Add(LYState.dbg_none, 1)
                ReturnValue(0)
            }
        }

        // BLOCK element — delegate to LY__LayoutBlock
        IfCondition EqualTo(disp, LYDisp.BLOCK) ThenBlock: {
            LY__LayoutBlock(node, tag, css_disp, 0, is_visible)
            ReturnValue(0)
        }

        // INLINE element — delegate to LY__LayoutInline
        IfCondition EqualTo(disp, LYDisp.INLINE) ThenBlock: {
            LY__LayoutInline(node, tag, is_visible)
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// PUBLIC API — RUN LAYOUT
// =============================================================================
Function.Layout_Run {
    Input: dom_root: Integer
    Output: Integer
    Body: {
        Layout_Reset()

        // Layout all nodes
        LY__LayoutNode(dom_root)

        LYState.content_h = LYState.cursor_y

        // Print diagnostic summary
        PrintMessage("[LAYOUT] nodes=")
        PrintNumber(LYState.dbg_nodes)
        PrintMessage(" blocks=")
        PrintNumber(LYState.dbg_blocks)
        PrintMessage(" inlines=")
        PrintNumber(LYState.dbg_inlines)
        PrintMessage(" texts=")
        PrintNumber(LYState.dbg_texts)
        PrintMessage(" none=")
        PrintNumber(LYState.dbg_none)
        PrintMessage(" hidden=")
        PrintNumber(LYState.dbg_hidden)
        PrintMessage(" cmds=")
        PrintNumber(LYState.cmd_count)
        PrintMessage("\n")

        ReturnValue(LYState.cmd_count)
    }
}

// =============================================================================
// PUBLIC ACCESSORS
// =============================================================================
Function.Layout_CmdCount {
    Output: Integer
    Body: { ReturnValue(LYState.cmd_count) }
}

Function.Layout_ContentHeight {
    Output: Integer
    Body: { ReturnValue(LYState.content_h) }
}

Function.Layout_CmdType {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_TYPE)) }
}

Function.Layout_CmdX {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_X)) }
}

Function.Layout_CmdY {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_Y)) }
}

Function.Layout_CmdW {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_W)) }
}

Function.Layout_CmdH {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_H)) }
}

Function.Layout_CmdColor {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_COLOR)) }
}

Function.Layout_CmdPtr {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_PTR)) }
}

// =============================================================================
// DEBUG — dump all commands
// =============================================================================
Function.Layout_Dump {
    Body: {
        PrintMessage("[LAYOUT] commands: ")
        PrintNumber(LYState.cmd_count)
        PrintMessage("  content_h: ")
        PrintNumber(LYState.content_h)
        PrintMessage("\n")

        di = 0
        WhileLoop LessThan(di, LYState.cmd_count) {
            ct = LY__CmdGet(di, LYConst.C_TYPE)
            cx = LY__CmdGet(di, LYConst.C_X)
            cy = LY__CmdGet(di, LYConst.C_Y)
            cw = LY__CmdGet(di, LYConst.C_W)

            IfCondition EqualTo(ct, LYCmd.FILL_RECT) ThenBlock: {
                PrintMessage("  FILL_RECT x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" w=")
                PrintNumber(cw)
                ch = LY__CmdGet(di, LYConst.C_H)
                PrintMessage(" h=")
                PrintNumber(ch)
                cc = LY__CmdGet(di, LYConst.C_COLOR)
                PrintMessage(" color=0x")
                PrintNumber(cc)
                PrintMessage("\n")
            }

            IfCondition EqualTo(ct, LYCmd.DRAW_TEXT) ThenBlock: {
                PrintMessage("  DRAW_TEXT x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" len=")
                PrintNumber(cw)
                cp = LY__CmdGet(di, LYConst.C_PTR)
                IfCondition NotEqual(cp, 0) ThenBlock: {
                    PrintMessage(" '")
                    PrintMessage(cp)
                    PrintMessage("'")
                }
                PrintMessage("\n")
            }

            IfCondition EqualTo(ct, LYCmd.DRAW_LINE) ThenBlock: {
                PrintMessage("  DRAW_LINE x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" w=")
                PrintNumber(cw)
                PrintMessage("\n")
            }

            di = Add(di, 1)
        }
    }
}
