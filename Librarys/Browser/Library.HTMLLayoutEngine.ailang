// Library.HTMLLayoutEngine.ailang — Layout engine dispatcher + public API
// Thin node dispatcher: classifies nodes, delegates to LY__LayoutBlock / LY__LayoutInline.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutColors
LibraryImport.Browser.HTMLLayoutCSS
LibraryImport.Browser.HTMLLayoutFlex
LibraryImport.Browser.HTMLLayoutTable
LibraryImport.Browser.HTMLLayoutTraversal
LibraryImport.Browser.HTMLLayoutPositioning
LibraryImport.Browser.HTMLLayoutGrid

// =============================================================================
// DISPLAY STRING → INTEGER LOOKUP TABLE
// Single conversion point: all downstream code uses integer constants.
// Returns the LYDisp integer for a CSS display value string.
// fallback = default if the string doesn't match any known value.
// =============================================================================
Function.LY__MapDisplay {
    Input: val: Address
    Input: fallback: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(fallback) }
        IfCondition EqualTo(StringCompare(val, "none"), 0) ThenBlock: { ReturnValue(LYDisp.NONE) }
        IfCondition EqualTo(StringCompare(val, "block"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(val, "inline"), 0) ThenBlock: { ReturnValue(LYDisp.INLINE) }
        IfCondition EqualTo(StringCompare(val, "inline-block"), 0) ThenBlock: { ReturnValue(LYDisp.INLINE_BLOCK) }
        IfCondition EqualTo(StringCompare(val, "flex"), 0) ThenBlock: { ReturnValue(LYDisp.FLEX) }
        IfCondition EqualTo(StringCompare(val, "inline-flex"), 0) ThenBlock: { ReturnValue(LYDisp.INLINE_FLEX) }
        IfCondition EqualTo(StringCompare(val, "-webkit-flex"), 0) ThenBlock: { ReturnValue(LYDisp.FLEX) }
        IfCondition EqualTo(StringCompare(val, "-webkit-box"), 0) ThenBlock: { ReturnValue(LYDisp.FLEX) }
        IfCondition EqualTo(StringCompare(val, "-webkit-inline-flex"), 0) ThenBlock: { ReturnValue(LYDisp.INLINE_FLEX) }
        IfCondition EqualTo(StringCompare(val, "grid"), 0) ThenBlock: { ReturnValue(LYDisp.GRID) }
        IfCondition EqualTo(StringCompare(val, "inline-grid"), 0) ThenBlock: { ReturnValue(LYDisp.INLINE_GRID) }
        IfCondition EqualTo(StringCompare(val, "contents"), 0) ThenBlock: { ReturnValue(LYDisp.CONTENTS) }
        IfCondition EqualTo(StringCompare(val, "list-item"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(val, "table"), 0) ThenBlock: { ReturnValue(LYDisp.TABLE) }
        IfCondition EqualTo(StringCompare(val, "table-row"), 0) ThenBlock: { ReturnValue(LYDisp.TABLE_ROW) }
        IfCondition EqualTo(StringCompare(val, "table-cell"), 0) ThenBlock: { ReturnValue(LYDisp.TABLE_CELL) }
        IfCondition EqualTo(StringCompare(val, "table-row-group"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(val, "table-header-group"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(val, "table-footer-group"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(val, "table-caption"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        IfCondition EqualTo(StringCompare(val, "-webkit-inline-box"), 0) ThenBlock: { ReturnValue(LYDisp.INLINE_FLEX) }
        IfCondition EqualTo(StringCompare(val, "flow-root"), 0) ThenBlock: { ReturnValue(LYDisp.BLOCK) }
        // Unknown display value — keep current
        ReturnValue(fallback)
    }
}

// =============================================================================
// FLOAT STRING → INTEGER LOOKUP TABLE
// =============================================================================
Function.LY__MapFloat {
    Input: val: Address
    Input: fallback: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(fallback) }
        IfCondition EqualTo(StringCompare(val, "none"), 0) ThenBlock: { ReturnValue(LYFloat.NONE) }
        IfCondition EqualTo(StringCompare(val, "left"), 0) ThenBlock: { ReturnValue(LYFloat.LEFT) }
        IfCondition EqualTo(StringCompare(val, "right"), 0) ThenBlock: { ReturnValue(LYFloat.RIGHT) }
        ReturnValue(fallback)
    }
}

// =============================================================================
// POSITION STRING → INTEGER LOOKUP TABLE
// =============================================================================
Function.LY__MapPosition {
    Input: val: Address
    Input: fallback: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(fallback) }
        IfCondition EqualTo(StringCompare(val, "static"), 0) ThenBlock: { ReturnValue(LYPos.STATIC) }
        IfCondition EqualTo(StringCompare(val, "relative"), 0) ThenBlock: { ReturnValue(LYPos.RELATIVE) }
        IfCondition EqualTo(StringCompare(val, "absolute"), 0) ThenBlock: { ReturnValue(LYPos.ABSOLUTE) }
        IfCondition EqualTo(StringCompare(val, "fixed"), 0) ThenBlock: { ReturnValue(LYPos.FIXED) }
        IfCondition EqualTo(StringCompare(val, "sticky"), 0) ThenBlock: { ReturnValue(LYPos.RELATIVE) }
        ReturnValue(fallback)
    }
}

// =============================================================================
// CLEAR STRING → INTEGER LOOKUP TABLE
// =============================================================================
Function.LY__MapClear {
    Input: val: Address
    Input: fallback: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(fallback) }
        IfCondition EqualTo(StringCompare(val, "none"), 0) ThenBlock: { ReturnValue(LYClear.NONE) }
        IfCondition EqualTo(StringCompare(val, "left"), 0) ThenBlock: { ReturnValue(LYClear.LEFT) }
        IfCondition EqualTo(StringCompare(val, "right"), 0) ThenBlock: { ReturnValue(LYClear.RIGHT) }
        IfCondition EqualTo(StringCompare(val, "both"), 0) ThenBlock: { ReturnValue(LYClear.BOTH) }
        ReturnValue(fallback)
    }
}

// =============================================================================
// TEXT-ALIGN STRING → INTEGER LOOKUP TABLE
// =============================================================================
Function.LY__MapTextAlign {
    Input: val: Address
    Input: fallback: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(fallback) }
        IfCondition EqualTo(StringCompare(val, "left"), 0) ThenBlock: { ReturnValue(LYAlign.LEFT) }
        IfCondition EqualTo(StringCompare(val, "center"), 0) ThenBlock: { ReturnValue(LYAlign.CENTER) }
        IfCondition EqualTo(StringCompare(val, "right"), 0) ThenBlock: { ReturnValue(LYAlign.RIGHT) }
        IfCondition EqualTo(StringCompare(val, "justify"), 0) ThenBlock: { ReturnValue(LYAlign.JUSTIFY) }
        IfCondition EqualTo(StringCompare(val, "-webkit-center"), 0) ThenBlock: { ReturnValue(LYAlign.CENTER) }
        IfCondition EqualTo(StringCompare(val, "-webkit-right"), 0) ThenBlock: { ReturnValue(LYAlign.RIGHT) }
        IfCondition EqualTo(StringCompare(val, "-webkit-left"), 0) ThenBlock: { ReturnValue(LYAlign.LEFT) }
        IfCondition EqualTo(StringCompare(val, "start"), 0) ThenBlock: { ReturnValue(LYAlign.LEFT) }
        IfCondition EqualTo(StringCompare(val, "end"), 0) ThenBlock: { ReturnValue(LYAlign.RIGHT) }
        ReturnValue(fallback)
    }
}

// =============================================================================
// VISIBILITY STRING → INTEGER LOOKUP TABLE
// =============================================================================
Function.LY__MapVisibility {
    Input: val: Address
    Input: fallback: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(fallback) }
        IfCondition EqualTo(StringCompare(val, "visible"), 0) ThenBlock: { ReturnValue(LYVis.VISIBLE) }
        IfCondition EqualTo(StringCompare(val, "hidden"), 0) ThenBlock: { ReturnValue(LYVis.HIDDEN) }
        IfCondition EqualTo(StringCompare(val, "collapse"), 0) ThenBlock: { ReturnValue(LYVis.COLLAPSE) }
        ReturnValue(fallback)
    }
}

// =============================================================================
// BOX-SIZING STRING → INTEGER LOOKUP TABLE
// =============================================================================
Function.LY__MapBoxSizing {
    Input: val: Address
    Input: fallback: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(fallback) }
        IfCondition EqualTo(StringCompare(val, "content-box"), 0) ThenBlock: { ReturnValue(LYBox.CONTENT_BOX) }
        IfCondition EqualTo(StringCompare(val, "border-box"), 0) ThenBlock: { ReturnValue(LYBox.BORDER_BOX) }
        ReturnValue(fallback)
    }
}

Function.LY__LayoutNode {
    Input: node: Integer
    Body: {
        LYState.dbg_visit = Add(LYState.dbg_visit, 1)
        ntype = DOM_GetType(node)

        // TEXT nodes — emit text content
        IfCondition EqualTo(ntype, DOMType.TEXT) ThenBlock: {
            LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
            LYState.dbg_texts = Add(LYState.dbg_texts, 1)
            t_ptr = DOM_GetText(node)
            t_len = DOM_GetTextLen(node)
            IfCondition And(NotEqual(t_ptr, 0), GreaterThan(t_len, 0)) ThenBlock: {
                LY__EmitText(t_ptr, t_len, LYState.fg_color)
            }
            ReturnValue(0)
        }

        // COMMENT nodes — skip
        IfCondition EqualTo(ntype, DOMType.COMMENT) ThenBlock: {
            ReturnValue(0)
        }

        // ROOT node — process children
        IfCondition EqualTo(ntype, DOMType.ROOT) ThenBlock: {
            rc = DOM_GetFirstChild(node)
            WhileLoop GreaterEqual(rc, 0) {
                next_rc = DOM_GetNextSib(rc)
                LY__LayoutNode(rc)
                rc = next_rc
            }
            ReturnValue(0)
        }

        // ELEMENT node — classify and layout
        tag = DOM_GetTag(node)
        disp = LY__GetDisplay(tag)
        // Check HTML hidden attribute
        IfCondition NotEqual(disp, LYDisp.NONE) ThenBlock: {
            hidden_attr = DOM_GetAttr(node, "hidden")
            IfCondition NotEqual(hidden_attr, 0) ThenBlock: {
                disp = LYDisp.NONE
            }
        }

        // Check CSS display:none override
        // Never hide <html> or <body> — sites use "body{display:none}" as anti-FOUC
        // (e.g. DDG: "body{display:none}" + JS adds class to reveal). Since we run
        // scripts before layout, FOUC isn't an issue and body must always render.
        is_root_tag = 0
        IfCondition NotEqual(tag, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(tag, "body"), 0) ThenBlock: { is_root_tag = 1 }
            IfCondition EqualTo(StringCompare(tag, "html"), 0) ThenBlock: { is_root_tag = 1 }
        }
        // Resolve CSS display override (stylesheet + inline style)
        // Single string→integer conversion here; integer propagates everywhere else
        IfCondition And(NotEqual(disp, LYDisp.NONE), EqualTo(is_root_tag, 0)) ThenBlock: {
            // 1. Check CSS stylesheet rules for display
            css_dv = LY__CSSLookupProp(node, "display")
            IfCondition NotEqual(css_dv, 0) ThenBlock: {
                disp = LY__MapDisplay(css_dv, disp)
            }
            // 2. Inline style overrides everything (higher specificity)
            ds_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(ds_str, 0) ThenBlock: {
                ds_idx = StringIndexOf(ds_str, "display")
                IfCondition GreaterEqual(ds_idx, 0) ThenBlock: {
                    ds_len = StringLength(ds_str)
                    ds_rule = CSS_ParseInline(ds_str, ds_len)
                    IfCondition GreaterEqual(ds_rule, 0) ThenBlock: {
                        ds_val = CSS_GetPropVal(ds_rule, "display")
                        IfCondition NotEqual(ds_val, 0) ThenBlock: {
                            disp = LY__MapDisplay(ds_val, disp)
                        }
                    }
                }
            }
        }

        // CONTENTS — no box, just recurse into children
        IfCondition EqualTo(disp, LYDisp.CONTENTS) ThenBlock: {
            LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
            cont_child = DOM_GetFirstChild(node)
            WhileLoop GreaterEqual(cont_child, 0) {
                cont_next = DOM_GetNextSib(cont_child)
                LY__LayoutNode(cont_child)
                cont_child = cont_next
            }
            ReturnValue(0)
        }

        // NONE — skip
        IfCondition EqualTo(disp, LYDisp.NONE) ThenBlock: {
            LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
            LYState.dbg_none = Add(LYState.dbg_none, 1)
            ReturnValue(0)
        }

        // Check visibility: hidden (element takes space but isn't painted)
        is_visible = LYVis.VISIBLE
        vis_css = LY__CSSLookupProp(node, "visibility")
        is_visible = LY__MapVisibility(vis_css, is_visible)
        // Also check inline style
        IfCondition EqualTo(is_visible, LYVis.VISIBLE) ThenBlock: {
            vis_str = DOM_GetAttr(node, "style")
            IfCondition NotEqual(vis_str, 0) ThenBlock: {
                IfCondition GreaterEqual(StringIndexOf(vis_str, "visibility"), 0) ThenBlock: {
                    vis_slen = StringLength(vis_str)
                    vis_rule = CSS_ParseInline(vis_str, vis_slen)
                    IfCondition GreaterEqual(vis_rule, 0) ThenBlock: {
                        vis_v = CSS_GetPropVal(vis_rule, "visibility")
                        is_visible = LY__MapVisibility(vis_v, is_visible)
                    }
                }
            }
        }

        // Check opacity: 0 — treat as invisible (preserve layout, no paint)
        // Only exact "0" or "0.0"/"0.00" should hide — NOT "0.5", "0.8", etc.
        IfCondition EqualTo(is_visible, 1) ThenBlock: {
            op_css = LY__CSSLookupProp(node, "opacity")
            IfCondition NotEqual(op_css, 0) ThenBlock: {
                op_b0 = GetByte(op_css, 0)
                IfCondition EqualTo(op_b0, 48) ThenBlock: {
                    op_b1 = GetByte(op_css, 1)
                    // "0" (null terminator) = invisible
                    IfCondition EqualTo(op_b1, 0) ThenBlock: {
                        is_visible = 0
                    }
                    // "0.0" or "0.00" = invisible, but "0.5" is visible
                    IfCondition EqualTo(op_b1, 46) ThenBlock: {
                        op_b2 = GetByte(op_css, 2)
                        // Only invisible if next digit is '0' or missing
                        IfCondition Or(EqualTo(op_b2, 0), EqualTo(op_b2, 48)) ThenBlock: {
                            is_visible = 0
                        }
                    }
                }
            }
            // Also check inline style for opacity
            IfCondition EqualTo(is_visible, 1) ThenBlock: {
                op_str = DOM_GetAttr(node, "style")
                IfCondition NotEqual(op_str, 0) ThenBlock: {
                    IfCondition GreaterEqual(StringIndexOf(op_str, "opacity"), 0) ThenBlock: {
                        op_slen = StringLength(op_str)
                        op_rule = CSS_ParseInline(op_str, op_slen)
                        IfCondition GreaterEqual(op_rule, 0) ThenBlock: {
                            op_v = CSS_GetPropVal(op_rule, "opacity")
                            IfCondition NotEqual(op_v, 0) ThenBlock: {
                                op_vb = GetByte(op_v, 0)
                                IfCondition EqualTo(op_vb, 48) ThenBlock: {
                                    op_vb2 = GetByte(op_v, 1)
                                    IfCondition EqualTo(op_vb2, 0) ThenBlock: {
                                        is_visible = 0
                                    }
                                    IfCondition EqualTo(op_vb2, 46) ThenBlock: {
                                        op_vb3 = GetByte(op_v, 2)
                                        IfCondition Or(EqualTo(op_vb3, 0), EqualTo(op_vb3, 48)) ThenBlock: {
                                            is_visible = 0
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Check aria-hidden="true" — skip element entirely (unambiguous signal)
        aria_h = DOM_GetAttr(node, "aria-hidden")
        IfCondition NotEqual(aria_h, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(aria_h, "true"), 0) ThenBlock: {
                LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
                LYState.dbg_none = Add(LYState.dbg_none, 1)
                ReturnValue(0)
            }
        }

        // BLOCK / FLEX / GRID — delegate to LY__LayoutBlock with integer disp
        IfCondition EqualTo(disp, LYDisp.BLOCK) ThenBlock: {
            LY__LayoutBlock(node, tag, disp, is_visible)
            ReturnValue(0)
        }
        IfCondition EqualTo(disp, LYDisp.FLEX) ThenBlock: {
            LY__LayoutBlock(node, tag, disp, is_visible)
            ReturnValue(0)
        }
        IfCondition EqualTo(disp, LYDisp.INLINE_FLEX) ThenBlock: {
            LY__LayoutBlock(node, tag, disp, is_visible)
            ReturnValue(0)
        }
        IfCondition EqualTo(disp, LYDisp.GRID) ThenBlock: {
            LY__LayoutBlock(node, tag, disp, is_visible)
            ReturnValue(0)
        }
        IfCondition EqualTo(disp, LYDisp.INLINE_GRID) ThenBlock: {
            LY__LayoutBlock(node, tag, disp, is_visible)
            ReturnValue(0)
        }

        // TABLE — delegate to LY__LayoutTable
        IfCondition EqualTo(disp, LYDisp.TABLE) ThenBlock: {
            LY__LayoutTable(node, tag, is_visible)
            ReturnValue(0)
        }
        // TABLE_ROW / TABLE_CELL outside of table context — treat as block
        IfCondition EqualTo(disp, LYDisp.TABLE_ROW) ThenBlock: {
            LY__LayoutBlock(node, tag, LYDisp.BLOCK, is_visible)
            ReturnValue(0)
        }
        IfCondition EqualTo(disp, LYDisp.TABLE_CELL) ThenBlock: {
            LY__LayoutBlock(node, tag, LYDisp.BLOCK, is_visible)
            ReturnValue(0)
        }

        // INLINE element — delegate to LY__LayoutInline
        IfCondition EqualTo(disp, LYDisp.INLINE) ThenBlock: {
            LY__LayoutInline(node, tag, is_visible)
            ReturnValue(0)
        }

        // INLINE-BLOCK — block box that flows inline (no line break before/after)
        IfCondition EqualTo(disp, LYDisp.INLINE_BLOCK) ThenBlock: {
            // Save cursor position — inline-block doesn't break flow
            ib_save_x = LYState.cursor_x
            ib_save_y = LYState.cursor_y
            ib_save_ind = LYState.indent
            ib_save_aw = LYState.avail_w
            ib_save_ta = LYState.text_align
            ib_cmd_start = LYState.cmd_count

            // Set indent so block positions content from cursor_x
            LYState.indent = ib_save_x
            // Constrain avail_w to remaining space (shrink-to-fit)
            LYState.avail_w = Subtract(Add(ib_save_ind, ib_save_aw), ib_save_x)
            // Internal content is left-aligned; parent text-align positions the IB itself
            LYState.text_align = LYAlign.LEFT

            // Layout as block (resolves CSS, emits background, borders, children)
            LY__LayoutBlock(node, tag, disp, is_visible)

            // After block layout, the block will have advanced cursor_y.
            ib_height = Subtract(LYState.cursor_y, ib_save_y)

            // Determine width: check explicit CSS width first
            ib_w_str = LY__CSSLookupProp(node, "width")
            ib_w = 0
            IfCondition NotEqual(ib_w_str, 0) ThenBlock: {
                ib_w = LY__ParsePx(ib_w_str)
            }
            IfCondition EqualTo(ib_w, 0) ThenBlock: {
                ib_style = DOM_GetAttr(node, "style")
                IfCondition NotEqual(ib_style, 0) ThenBlock: {
                    IfCondition GreaterEqual(StringIndexOf(ib_style, "width"), 0) ThenBlock: {
                        ib_slen = StringLength(ib_style)
                        ib_rule = CSS_ParseInline(ib_style, ib_slen)
                        IfCondition GreaterEqual(ib_rule, 0) ThenBlock: {
                            ib_wv = CSS_GetPropVal(ib_rule, "width")
                            IfCondition NotEqual(ib_wv, 0) ThenBlock: {
                                ib_w = LY__ParsePx(ib_wv)
                            }
                        }
                    }
                }
            }

            // If no explicit width, compute from content commands only
            // (text + images define content width; fills/lines are decoration)
            IfCondition LessEqual(ib_w, 0) ThenBlock: {
                ib_max_r = ib_save_x
                ib_ci = ib_cmd_start
                WhileLoop LessThan(ib_ci, LYState.cmd_count) {
                    ib_ct = LY__CmdGet(ib_ci, LYConst.C_TYPE)
                    ib_cx = LY__CmdGet(ib_ci, LYConst.C_X)
                    ib_cw = LY__CmdGet(ib_ci, LYConst.C_W)
                    ib_r = 0
                    IfCondition EqualTo(ib_ct, LYCmd.DRAW_TEXT) ThenBlock: {
                        // For text: W is char count, approximate pixel width
                        ib_ch = LY__CmdGet(ib_ci, LYConst.C_H)
                        ib_fsz = BitwiseAnd(ib_ch, 32767)
                        IfCondition LessThan(ib_fsz, 1) ThenBlock: { ib_fsz = 16 }
                        ib_tw = Divide(Multiply(Multiply(ib_cw, ib_fsz), 6), 10)
                        ib_r = Add(ib_cx, ib_tw)
                    }
                    IfCondition EqualTo(ib_ct, LYCmd.DRAW_IMAGE) ThenBlock: {
                        ib_r = Add(ib_cx, ib_cw)
                    }
                    IfCondition GreaterThan(ib_r, ib_max_r) ThenBlock: {
                        ib_max_r = ib_r
                    }
                    ib_ci = Add(ib_ci, 1)
                }
                ib_w = Subtract(ib_max_r, ib_save_x)
                IfCondition LessEqual(ib_w, 0) ThenBlock: { ib_w = 0 }
            }

            // Shrink-to-fit: clamp background/border FILL_RECTs to content width
            IfCondition GreaterThan(ib_w, 0) ThenBlock: {
                ib_fi = ib_cmd_start
                WhileLoop LessThan(ib_fi, LYState.cmd_count) {
                    ib_ft = LY__CmdGet(ib_fi, LYConst.C_TYPE)
                    IfCondition EqualTo(ib_ft, LYCmd.FILL_RECT) ThenBlock: {
                        ib_fw = LY__CmdGet(ib_fi, LYConst.C_W)
                        IfCondition GreaterThan(ib_fw, ib_w) ThenBlock: {
                            LY__CmdSet(ib_fi, LYConst.C_W, ib_w)
                        }
                    }
                    IfCondition EqualTo(ib_ft, LYCmd.DRAW_LINE) ThenBlock: {
                        ib_lw = LY__CmdGet(ib_fi, LYConst.C_W)
                        IfCondition GreaterThan(ib_lw, ib_w) ThenBlock: {
                            LY__CmdSet(ib_fi, LYConst.C_W, ib_w)
                        }
                    }
                    ib_fi = Add(ib_fi, 1)
                }
            }

            // Resolve margins (left/right for inline spacing)
            ib_ml = LY__ResolveMarginSide(node, tag, 3)
            ib_mr = LY__ResolveMarginSide(node, tag, 1)

            // Position: keep on same line, advance x past margin + content + margin
            LYState.cursor_x = Add(Add(ib_save_x, ib_ml), Add(ib_w, ib_mr))
            // Don't advance cursor_y for inline-block — keep on same line
            LYState.cursor_y = ib_save_y
            // Restore parent state
            LYState.indent = ib_save_ind
            LYState.avail_w = ib_save_aw
            LYState.text_align = ib_save_ta

            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// PUBLIC API — RUN LAYOUT
// =============================================================================
Function.Layout_Run {
    Input: dom_root: Integer
    Output: Integer
    Body: {
        Layout_Reset()

        // Layout all nodes
        LY__LayoutNode(dom_root)

        LYState.content_h = LYState.cursor_y

        // Print diagnostic summary
        PrintMessage("[LAYOUT] nodes=")
        PrintNumber(LYState.dbg_nodes)
        PrintMessage(" blocks=")
        PrintNumber(LYState.dbg_blocks)
        PrintMessage(" inlines=")
        PrintNumber(LYState.dbg_inlines)
        PrintMessage(" texts=")
        PrintNumber(LYState.dbg_texts)
        PrintMessage(" none=")
        PrintNumber(LYState.dbg_none)
        PrintMessage(" hidden=")
        PrintNumber(LYState.dbg_hidden)
        PrintMessage(" cmds=")
        PrintNumber(LYState.cmd_count)
        PrintMessage("\n")

        ReturnValue(LYState.cmd_count)
    }
}

// =============================================================================
// PUBLIC ACCESSORS
// =============================================================================
Function.Layout_CmdCount {
    Output: Integer
    Body: { ReturnValue(LYState.cmd_count) }
}

Function.Layout_ContentHeight {
    Output: Integer
    Body: { ReturnValue(LYState.content_h) }
}

Function.Layout_CmdType {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_TYPE)) }
}

Function.Layout_CmdX {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_X)) }
}

Function.Layout_CmdY {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_Y)) }
}

Function.Layout_CmdW {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_W)) }
}

Function.Layout_CmdH {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_H)) }
}

Function.Layout_CmdColor {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_COLOR)) }
}

Function.Layout_CmdPtr {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(LY__CmdGet(idx, LYConst.C_PTR)) }
}

// =============================================================================
// DEBUG — dump all commands
// =============================================================================
Function.Layout_Dump {
    Body: {
        PrintMessage("[LAYOUT] commands: ")
        PrintNumber(LYState.cmd_count)
        PrintMessage("  content_h: ")
        PrintNumber(LYState.content_h)
        PrintMessage("\n")

        di = 0
        WhileLoop LessThan(di, LYState.cmd_count) {
            ct = LY__CmdGet(di, LYConst.C_TYPE)
            cx = LY__CmdGet(di, LYConst.C_X)
            cy = LY__CmdGet(di, LYConst.C_Y)
            cw = LY__CmdGet(di, LYConst.C_W)

            IfCondition EqualTo(ct, LYCmd.FILL_RECT) ThenBlock: {
                PrintMessage("  FILL_RECT x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" w=")
                PrintNumber(cw)
                ch = LY__CmdGet(di, LYConst.C_H)
                PrintMessage(" h=")
                PrintNumber(ch)
                cc = LY__CmdGet(di, LYConst.C_COLOR)
                PrintMessage(" color=0x")
                PrintNumber(cc)
                PrintMessage("\n")
            }

            IfCondition EqualTo(ct, LYCmd.DRAW_TEXT) ThenBlock: {
                PrintMessage("  DRAW_TEXT x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" len=")
                PrintNumber(cw)
                cp = LY__CmdGet(di, LYConst.C_PTR)
                IfCondition NotEqual(cp, 0) ThenBlock: {
                    PrintMessage(" '")
                    PrintMessage(cp)
                    PrintMessage("'")
                }
                PrintMessage("\n")
            }

            IfCondition EqualTo(ct, LYCmd.DRAW_LINE) ThenBlock: {
                PrintMessage("  DRAW_LINE x=")
                PrintNumber(cx)
                PrintMessage(" y=")
                PrintNumber(cy)
                PrintMessage(" w=")
                PrintNumber(cw)
                PrintMessage("\n")
            }

            di = Add(di, 1)
        }
    }
}
