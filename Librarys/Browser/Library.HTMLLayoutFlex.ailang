LibraryImport.StringUtils
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutColors
LibraryImport.Browser.HTMLLayoutCSS

Function.Layout_SetViewport {
    Input: w: Integer
    Input: h: Integer
    Body: {
        LYState.viewport_w = w
        LYState.viewport_h = h
        LYState.avail_w = w
    }
}

// =============================================================================
// FLOAT HELPERS — manage active float boxes
// =============================================================================

// Add a float entry to the pool
// dir: 1=left, 2=right; x,y,w,h = float box position and size
Function.LYFloat_Add {
    Input: dir: Integer
    Input: fx: Integer
    Input: fy: Integer
    Input: fw: Integer
    Input: fh: Integer
    Body: {
        IfCondition GreaterEqual(LYFloatState.count, LYFloatState.max) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(LYFloatState.count, LYFloatState.ENTRY_SIZE)
        base = Add(LYFloatState.pool, off)
        StoreValue(Add(base, LYFloatState.F_DIR), dir)
        StoreValue(Add(base, LYFloatState.F_X), fx)
        StoreValue(Add(base, LYFloatState.F_Y), fy)
        StoreValue(Add(base, LYFloatState.F_W), fw)
        StoreValue(Add(base, LYFloatState.F_H), fh)
        LYFloatState.count = Add(LYFloatState.count, 1)
        ReturnValue(1)
    }
}

// Get total left-float intrusion at a given y coordinate
// Returns the right edge of the rightmost left-float that overlaps y
Function.LYFloat_LeftAt {
    Input: y: Integer
    Input: container_x: Integer
    Output: Integer
    Body: {
        result = container_x
        fi = 0
        WhileLoop LessThan(fi, LYFloatState.count) {
            off = Multiply(fi, LYFloatState.ENTRY_SIZE)
            base = Add(LYFloatState.pool, off)
            f_dir = Dereference(Add(base, LYFloatState.F_DIR))
            IfCondition EqualTo(f_dir, 1) ThenBlock: {
                f_y = Dereference(Add(base, LYFloatState.F_Y))
                f_h = Dereference(Add(base, LYFloatState.F_H))
                f_bot = Add(f_y, f_h)
                // Does this float overlap the given y?
                IfCondition And(LessThan(y, f_bot), GreaterEqual(y, f_y)) ThenBlock: {
                    f_x = Dereference(Add(base, LYFloatState.F_X))
                    f_w = Dereference(Add(base, LYFloatState.F_W))
                    f_right = Add(f_x, f_w)
                    IfCondition GreaterThan(f_right, result) ThenBlock: {
                        result = f_right
                    }
                }
            }
            fi = Add(fi, 1)
        }
        ReturnValue(result)
    }
}

// Get right-float intrusion at a given y coordinate
// Returns the left edge of the leftmost right-float that overlaps y
Function.LYFloat_RightAt {
    Input: y: Integer
    Input: container_right: Integer
    Output: Integer
    Body: {
        result = container_right
        fi = 0
        WhileLoop LessThan(fi, LYFloatState.count) {
            off = Multiply(fi, LYFloatState.ENTRY_SIZE)
            base = Add(LYFloatState.pool, off)
            f_dir = Dereference(Add(base, LYFloatState.F_DIR))
            IfCondition EqualTo(f_dir, 2) ThenBlock: {
                f_y = Dereference(Add(base, LYFloatState.F_Y))
                f_h = Dereference(Add(base, LYFloatState.F_H))
                f_bot = Add(f_y, f_h)
                // Does this float overlap the given y?
                IfCondition And(LessThan(y, f_bot), GreaterEqual(y, f_y)) ThenBlock: {
                    f_x = Dereference(Add(base, LYFloatState.F_X))
                    IfCondition LessThan(f_x, result) ThenBlock: {
                        result = f_x
                    }
                }
            }
            fi = Add(fi, 1)
        }
        ReturnValue(result)
    }
}

// Get the y position past all floats of given direction
// dir: 0=both, 1=left, 2=right
// Returns the y coordinate below all matching floats
Function.LYFloat_ClearY {
    Input: dir: Integer
    Output: Integer
    Body: {
        result = 0
        fi = 0
        WhileLoop LessThan(fi, LYFloatState.count) {
            off = Multiply(fi, LYFloatState.ENTRY_SIZE)
            base = Add(LYFloatState.pool, off)
            f_dir = Dereference(Add(base, LYFloatState.F_DIR))
            should_check = 0
            IfCondition EqualTo(dir, 0) ThenBlock: { should_check = 1 }
            IfCondition EqualTo(f_dir, dir) ThenBlock: { should_check = 1 }
            IfCondition EqualTo(should_check, 1) ThenBlock: {
                f_y = Dereference(Add(base, LYFloatState.F_Y))
                f_h = Dereference(Add(base, LYFloatState.F_H))
                f_bot = Add(f_y, f_h)
                IfCondition GreaterThan(f_bot, result) ThenBlock: {
                    result = f_bot
                }
            }
            fi = Add(fi, 1)
        }
        ReturnValue(result)
    }
}

// =============================================================================
// TEXT WORD-WRAP + EMIT
// Wraps text to fit within current avail_w, emits CMD_DRAW_TEXT per line
// =============================================================================
Function.LY__EmitText {
    Input: text: Address
    Input: text_len: Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(text_len, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }

        font_w = LYState.font_w_px
        font_h = LY__LineHeight()

        // Available width from current X position to right edge
        // Adjust for floats at current y position
        base_left = LYState.indent
        base_right = Add(LYState.indent, LYState.avail_w)
        float_left = LYFloat_LeftAt(LYState.cursor_y, base_left)
        float_right = LYFloat_RightAt(LYState.cursor_y, base_right)
        right_edge = float_right
        // Adjust cursor_x if left-floats push us rightward
        IfCondition GreaterThan(float_left, LYState.cursor_x) ThenBlock: {
            LYState.cursor_x = float_left
        }
        // Sanity: if floats leave less than 1 char width, ignore float adjustment
        float_avail = Subtract(right_edge, LYState.cursor_x)
        IfCondition LessThan(float_avail, font_w) ThenBlock: {
            right_edge = base_right
            LYState.cursor_x = base_left
        }

        si = 0
        WhileLoop LessThan(si, text_len) {
            // Skip leading whitespace at start of line (after wrap)
            IfCondition EqualTo(LYState.cursor_x, LYState.indent) ThenBlock: {
                ws_done = 0
                WhileLoop And(LessThan(si, text_len), EqualTo(ws_done, 0)) {
                    lsc = GetByte(text, si)
                    lsc_is_ws = 0
                    IfCondition EqualTo(lsc, 32) ThenBlock: { lsc_is_ws = 1 }
                    IfCondition EqualTo(lsc, 9) ThenBlock: { lsc_is_ws = 1 }
                    IfCondition EqualTo(lsc, 10) ThenBlock: { lsc_is_ws = 1 }
                    IfCondition EqualTo(lsc, 13) ThenBlock: { lsc_is_ws = 1 }
                    IfCondition EqualTo(lsc_is_ws, 1) ThenBlock: {
                        si = Add(si, 1)
                    } ElseBlock: {
                        ws_done = 1
                    }
                }
            }
            IfCondition GreaterEqual(si, text_len) ThenBlock: { ReturnValue(0) }

            // Find next word boundary (space or newline)
            wi = si
            word_end = text_len
            wb_done = 0
            WhileLoop And(LessThan(wi, text_len), EqualTo(wb_done, 0)) {
                wch = GetByte(text, wi)
                wch_is_sep = 0
                IfCondition EqualTo(wch, 32) ThenBlock: { wch_is_sep = 1 }
                IfCondition EqualTo(wch, 10) ThenBlock: { wch_is_sep = 1 }
                IfCondition EqualTo(wch, 13) ThenBlock: { wch_is_sep = 1 }
                IfCondition EqualTo(wch, 9) ThenBlock: { wch_is_sep = 1 }
                IfCondition EqualTo(wch_is_sep, 1) ThenBlock: {
                    word_end = wi
                    wb_done = 1
                } ElseBlock: {
                    wi = Add(wi, 1)
                }
            }

            word_len = Subtract(word_end, si)
            word_px = Multiply(word_len, font_w)

            // If word doesn't fit on current line and we're not at line start, wrap
            IfCondition GreaterThan(Add(LYState.cursor_x, word_px), right_edge) ThenBlock: {
                IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
                    // Wrap to next line — recalculate float edges for new y
                    LYState.cursor_y = Add(LYState.cursor_y, font_h)
                    float_left = LYFloat_LeftAt(LYState.cursor_y, base_left)
                    float_right = LYFloat_RightAt(LYState.cursor_y, base_right)
                    right_edge = float_right
                    LYState.cursor_x = float_left
                    // Sanity: if no space, ignore floats
                    float_avail = Subtract(right_edge, LYState.cursor_x)
                    IfCondition LessThan(float_avail, font_w) ThenBlock: {
                        right_edge = base_right
                        LYState.cursor_x = base_left
                    }
                }
            }

            // If word is too long for a full line, break it character by character
            IfCondition GreaterThan(word_px, Subtract(right_edge, LYState.cursor_x)) ThenBlock: {
                IfCondition GreaterThan(word_px, 0) ThenBlock: {
                ci = si
                WhileLoop LessThan(ci, word_end) {
                    // How many chars fit on this line?
                    remain_px = Subtract(right_edge, LYState.cursor_x)
                    fit_chars = Divide(remain_px, font_w)
                    IfCondition LessThan(fit_chars, 1) ThenBlock: {
                        // Wrap first — recalculate float edges for new y
                        LYState.cursor_y = Add(LYState.cursor_y, font_h)
                        float_left = LYFloat_LeftAt(LYState.cursor_y, base_left)
                        float_right = LYFloat_RightAt(LYState.cursor_y, base_right)
                        right_edge = float_right
                        LYState.cursor_x = float_left
                        // Sanity: if no space, ignore floats
                        float_avail = Subtract(right_edge, LYState.cursor_x)
                        IfCondition LessThan(float_avail, font_w) ThenBlock: {
                            right_edge = base_right
                            LYState.cursor_x = base_left
                        }
                        remain_px = Subtract(right_edge, LYState.cursor_x)
                        fit_chars = Divide(remain_px, font_w)
                        IfCondition LessThan(fit_chars, 1) ThenBlock: { fit_chars = 1 }
                    }
                    chunk = Subtract(word_end, ci)
                    IfCondition GreaterThan(chunk, fit_chars) ThenBlock: {
                        chunk = fit_chars
                    }
                    LYTmp.ptr = Add(text, ci)
                    LY__EmitDrawText(LYState.cursor_x, LYState.cursor_y, chunk, color)
                    LYState.cursor_x = Add(LYState.cursor_x, Multiply(chunk, font_w))
                    ci = Add(ci, chunk)
                }
                }
            } ElseBlock: {
                // Emit word at current position
                IfCondition GreaterThan(word_len, 0) ThenBlock: {
                    LYTmp.ptr = Add(text, si)
                    // Calculate X position based on text-align (only for first word on line)
                    emit_x = LYState.cursor_x
                    LY__EmitDrawText(emit_x, LYState.cursor_y, word_len, color)
                    LYState.cursor_x = Add(LYState.cursor_x, word_px)
                }
            }

            // Advance past the word
            si = word_end
            // Handle the delimiter (space, newline, etc.)
            IfCondition LessThan(si, text_len) ThenBlock: {
                dch = GetByte(text, si)
                IfCondition EqualTo(dch, 10) ThenBlock: {
                    // Newline — move to next line, recalc float edges
                    LYState.cursor_y = Add(LYState.cursor_y, font_h)
                    float_left = LYFloat_LeftAt(LYState.cursor_y, base_left)
                    float_right = LYFloat_RightAt(LYState.cursor_y, base_right)
                    right_edge = float_right
                    LYState.cursor_x = float_left
                    // Sanity: if no space, ignore floats
                    float_avail = Subtract(right_edge, LYState.cursor_x)
                    IfCondition LessThan(float_avail, font_w) ThenBlock: {
                        right_edge = base_right
                        LYState.cursor_x = base_left
                    }
                    si = Add(si, 1)
                } ElseBlock: {
                    IfCondition Or(EqualTo(dch, 32), EqualTo(dch, 9)) ThenBlock: {
                        // Space — add space width to cursor_x
                        LYState.cursor_x = Add(LYState.cursor_x, font_w)
                        si = Add(si, 1)
                        // If space pushed us past right edge, wrap + recalc float edges
                        IfCondition GreaterEqual(LYState.cursor_x, right_edge) ThenBlock: {
                            LYState.cursor_y = Add(LYState.cursor_y, font_h)
                            float_left = LYFloat_LeftAt(LYState.cursor_y, base_left)
                            float_right = LYFloat_RightAt(LYState.cursor_y, base_right)
                            right_edge = float_right
                            LYState.cursor_x = float_left
                            // Sanity: if no space, ignore floats
                            float_avail = Subtract(right_edge, LYState.cursor_x)
                            IfCondition LessThan(float_avail, font_w) ThenBlock: {
                                right_edge = base_right
                                LYState.cursor_x = base_left
                            }
                        }
                    }
                }
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// CSS RULE MATCHING — check class list for substring match
// Handles space-separated class attributes: "foo bar baz"
// =============================================================================

Function.LY__FlexItemAddr {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(Add(LYFlex.pool, Multiply(idx, LYFlex.ITEM_SIZE))) }
}

Function.LY__FlexItemSet {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        addr = LY__FlexItemAddr(idx)
        StoreValue(Add(addr, field), val)
    }
}

Function.LY__FlexItemGet {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        addr = LY__FlexItemAddr(idx)
        ReturnValue(Dereference(Add(addr, field)))
    }
}

// =============================================================================
// FLEXBOX LAYOUT — two-pass: measure children, then place them
// Called when a block element has display:flex
// =============================================================================
Function.LY__FlexLayout {
    Input: node: Integer
    Body: {
        // Resolve flex container properties
        LYFlexTmp.dir = 0      // default: row
        LYFlexTmp.justify = 0  // default: flex-start
        LYFlexTmp.align = 0    // default: stretch
        LYFlexTmp.gap = 0
        LYFlexTmp.wrap = 0

        // Check flex-direction
        fd_val = LY__CSSLookupProp(node, "flex-direction")
        IfCondition NotEqual(fd_val, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(fd_val, "column"), 0) ThenBlock: {
                LYFlexTmp.dir = 1
            }
        }
        // Also check inline style
        fd_style = DOM_GetAttr(node, "style")
        IfCondition NotEqual(fd_style, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(fd_style, "flex-direction"), 0) ThenBlock: {
                fd_slen = StringLength(fd_style)
                fd_rule = CSS_ParseInline(fd_style, fd_slen)
                IfCondition GreaterEqual(fd_rule, 0) ThenBlock: {
                    fd_v2 = CSS_GetPropVal(fd_rule, "flex-direction")
                    IfCondition NotEqual(fd_v2, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(fd_v2, "column"), 0) ThenBlock: {
                            LYFlexTmp.dir = 1
                        }
                    }
                }
            }
        }

        // Check justify-content
        jc_val = LY__CSSLookupProp(node, "justify-content")
        IfCondition NotEqual(jc_val, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(jc_val, "center"), 0) ThenBlock: { LYFlexTmp.justify = 2 }
            IfCondition EqualTo(StringCompare(jc_val, "flex-end"), 0) ThenBlock: { LYFlexTmp.justify = 1 }
            IfCondition EqualTo(StringCompare(jc_val, "space-between"), 0) ThenBlock: { LYFlexTmp.justify = 3 }
            IfCondition EqualTo(StringCompare(jc_val, "space-around"), 0) ThenBlock: { LYFlexTmp.justify = 4 }
        }

        // Check align-items
        ai_val = LY__CSSLookupProp(node, "align-items")
        IfCondition NotEqual(ai_val, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(ai_val, "center"), 0) ThenBlock: { LYFlexTmp.align = 3 }
            IfCondition EqualTo(StringCompare(ai_val, "flex-start"), 0) ThenBlock: { LYFlexTmp.align = 1 }
            IfCondition EqualTo(StringCompare(ai_val, "flex-end"), 0) ThenBlock: { LYFlexTmp.align = 2 }
        }

        // Check gap
        gap_val = LY__CSSLookupProp(node, "gap")
        IfCondition NotEqual(gap_val, 0) ThenBlock: {
            LYFlexTmp.gap = LY__ParsePx(gap_val)
        }

        // =============================================
        // PASS 1: Measure children
        // =============================================
        LYFlex.count = 0
        container_x = LYState.indent
        container_y = LYState.cursor_y
        container_w = LYState.avail_w

        fc = DOM_GetFirstChild(node)
        WhileLoop And(GreaterEqual(fc, 0), LessThan(LYFlex.count, LYFlex.MAX_ITEMS)) {
            next_fc = DOM_GetNextSib(fc)

            // Skip text-only whitespace nodes
            fc_type = DOM_GetType(fc)
            IfCondition EqualTo(fc_type, DOMType.TEXT) ThenBlock: {
                fc = next_fc
            }
            IfCondition NotEqual(fc_type, DOMType.TEXT) ThenBlock: {
                // Check display:none on child
                fc_hidden = 0
                fc_tag = DOM_GetTag(fc)
                fc_disp = LY__GetDisplay(fc_tag)
                IfCondition EqualTo(fc_disp, LYDisp.NONE) ThenBlock: { fc_hidden = 1 }
                IfCondition EqualTo(fc_hidden, 0) ThenBlock: {
                    fc_css_d = LY__CSSLookupProp(fc, "display")
                    IfCondition NotEqual(fc_css_d, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(fc_css_d, "none"), 0) ThenBlock: {
                            fc_hidden = 1
                        }
                    }
                }

                IfCondition EqualTo(fc_hidden, 0) ThenBlock: {
                    fi = LYFlex.count

                    // Record cmd_start before laying out this child
                    cmd_before = LYState.cmd_count
                    cy_before = LYState.cursor_y

                    // Layout child normally (it emits commands at current cursor)
                    LY__LayoutNode(fc)

                    // Measure: height is cursor advance, width is avail_w (block) or content
                    item_h = Subtract(LYState.cursor_y, cy_before)
                    item_w = LYState.avail_w
                    cmd_after = LYState.cmd_count

                    // Check flex-grow on child
                    fg_grow = 0
                    fg_v = LY__CSSLookupProp(fc, "flex-grow")
                    IfCondition NotEqual(fg_v, 0) ThenBlock: {
                        fg_grow = LY__ParsePx(fg_v)
                    }

                    // Store flex item data
                    LY__FlexItemSet(fi, LYFlex.I_NODE, fc)
                    LY__FlexItemSet(fi, LYFlex.I_MEAS_W, item_w)
                    LY__FlexItemSet(fi, LYFlex.I_MEAS_H, item_h)
                    LY__FlexItemSet(fi, LYFlex.I_CMD_START, cmd_before)
                    LY__FlexItemSet(fi, LYFlex.I_CMD_COUNT, Subtract(cmd_after, cmd_before))
                    LY__FlexItemSet(fi, LYFlex.I_GROW, fg_grow)

                    LYFlex.count = Add(LYFlex.count, 1)
                }

                fc = next_fc
            }
        }

        // =============================================
        // PASS 2: Distribute space and relocate commands
        // =============================================
        IfCondition EqualTo(LYFlex.count, 0) ThenBlock: { ReturnValue(0) }

        // Calculate total main-axis size and total grow
        LYFlexTmp.total_main = 0
        LYFlexTmp.total_grow = 0
        LYFlexTmp.item_i = 0
        WhileLoop LessThan(LYFlexTmp.item_i, LYFlex.count) {
            IfCondition EqualTo(LYFlexTmp.dir, 0) ThenBlock: {
                // Row: main axis is width
                im = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_MEAS_H)
                // For row, we use a fraction of container width per item
                iw = Divide(container_w, LYFlex.count)
                LYFlexTmp.total_main = Add(LYFlexTmp.total_main, iw)
            }
            IfCondition EqualTo(LYFlexTmp.dir, 1) ThenBlock: {
                // Column: main axis is height
                ih = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_MEAS_H)
                LYFlexTmp.total_main = Add(LYFlexTmp.total_main, ih)
            }
            ig = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_GROW)
            LYFlexTmp.total_grow = Add(LYFlexTmp.total_grow, ig)
            LYFlexTmp.item_i = Add(LYFlexTmp.item_i, 1)
        }

        // Total gap space
        gap_total = Multiply(LYFlexTmp.gap, Subtract(LYFlex.count, 1))

        // Free space on main axis
        IfCondition EqualTo(LYFlexTmp.dir, 0) ThenBlock: {
            LYFlexTmp.free_space = Subtract(container_w, Add(LYFlexTmp.total_main, gap_total))
        }
        IfCondition EqualTo(LYFlexTmp.dir, 1) ThenBlock: {
            // Column: free space isn't bounded (page grows vertically)
            LYFlexTmp.free_space = 0
        }
        IfCondition LessThan(LYFlexTmp.free_space, 0) ThenBlock: {
            LYFlexTmp.free_space = 0
        }

        // Calculate starting offset based on justify-content
        main_offset = 0
        item_spacing = 0
        IfCondition EqualTo(LYFlexTmp.justify, 1) ThenBlock: {
            // flex-end: push to end
            main_offset = LYFlexTmp.free_space
        }
        IfCondition EqualTo(LYFlexTmp.justify, 2) ThenBlock: {
            // center: center the items
            main_offset = Divide(LYFlexTmp.free_space, 2)
        }
        IfCondition EqualTo(LYFlexTmp.justify, 3) ThenBlock: {
            // space-between: distribute between items
            IfCondition GreaterThan(LYFlex.count, 1) ThenBlock: {
                item_spacing = Divide(LYFlexTmp.free_space, Subtract(LYFlex.count, 1))
            }
        }
        IfCondition EqualTo(LYFlexTmp.justify, 4) ThenBlock: {
            // space-around: equal space around each item
            item_spacing = Divide(LYFlexTmp.free_space, LYFlex.count)
            main_offset = Divide(item_spacing, 2)
        }

        // Now relocate all commands
        // Reset cursor to container start
        LYState.cursor_y = container_y

        cur_main = main_offset
        max_cross = 0

        LYFlexTmp.item_i = 0
        WhileLoop LessThan(LYFlexTmp.item_i, LYFlex.count) {
            i_cmd_start = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_CMD_START)
            i_cmd_count = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_CMD_COUNT)
            i_meas_w = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_MEAS_W)
            i_meas_h = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_MEAS_H)

            // Calculate item width in row mode
            item_main_sz = i_meas_h
            IfCondition EqualTo(LYFlexTmp.dir, 0) ThenBlock: {
                item_main_sz = Divide(container_w, LYFlex.count)
                // Apply flex-grow if there's free space
                IfCondition And(GreaterThan(LYFlexTmp.total_grow, 0), GreaterThan(LYFlexTmp.free_space, 0)) ThenBlock: {
                    ig2 = LY__FlexItemGet(LYFlexTmp.item_i, LYFlex.I_GROW)
                    IfCondition GreaterThan(ig2, 0) ThenBlock: {
                        grow_px = Divide(Multiply(LYFlexTmp.free_space, ig2), LYFlexTmp.total_grow)
                        item_main_sz = Add(item_main_sz, grow_px)
                    }
                }
            }

            // Calculate delta from where commands were placed to where they should be
            IfCondition EqualTo(LYFlexTmp.dir, 0) ThenBlock: {
                // Row: shift X, keep relative Y
                dx = Subtract(Add(container_x, cur_main), LYState.indent)
                dy = Subtract(container_y, container_y) // commands already at correct Y baseline
                // Actually: commands were placed at sequential Y positions by normal block layout
                // We need to move them to container_y (same row) with offset X = cur_main
                // The commands' Y was set starting from cy_before (which incremented sequentially)
                // We want all at container_y, shifted right by cur_main
                // dy = container_y - (the Y where they were originally placed)
                // Since we laid them out sequentially, item 0 started at container_y, item 1 at container_y + item0_h, etc.
                // Original Y for this item: container_y + sum of all previous items' heights
                orig_y = container_y
                oi = 0
                WhileLoop LessThan(oi, LYFlexTmp.item_i) {
                    orig_y = Add(orig_y, LY__FlexItemGet(oi, LYFlex.I_MEAS_H))
                    oi = Add(oi, 1)
                }
                dx = Add(container_x, cur_main)
                dy = Subtract(container_y, orig_y)

                // Relocate commands: add dx to X, add dy to Y
                ci = i_cmd_start
                ci_end = Add(i_cmd_start, i_cmd_count)
                WhileLoop LessThan(ci, ci_end) {
                    cmd_addr = Add(LYState.cmd_pool, Multiply(ci, LYConst.CMD_SIZE))
                    old_x = Dereference(Add(cmd_addr, LYConst.C_X))
                    old_y = Dereference(Add(cmd_addr, LYConst.C_Y))
                    // Set X relative to container: (old_x - container_x) + container_x + cur_main
                    new_x = Add(Subtract(old_x, container_x), Add(container_x, cur_main))
                    new_y = Add(old_y, dy)
                    StoreValue(Add(cmd_addr, LYConst.C_X), new_x)
                    StoreValue(Add(cmd_addr, LYConst.C_Y), new_y)
                    ci = Add(ci, 1)
                }

                // Track max cross-axis size (height in row mode)
                IfCondition GreaterThan(i_meas_h, max_cross) ThenBlock: {
                    max_cross = i_meas_h
                }
            }

            IfCondition EqualTo(LYFlexTmp.dir, 1) ThenBlock: {
                // Column: commands are already in correct Y order, just apply gap
                IfCondition GreaterThan(LYFlexTmp.item_i, 0) ThenBlock: {
                    // Shift this item and all subsequent down by accumulated gaps
                    gap_shift = Multiply(LYFlexTmp.gap, LYFlexTmp.item_i)
                    ci = i_cmd_start
                    ci_end = Add(i_cmd_start, i_cmd_count)
                    WhileLoop LessThan(ci, ci_end) {
                        cmd_addr = Add(LYState.cmd_pool, Multiply(ci, LYConst.CMD_SIZE))
                        old_y = Dereference(Add(cmd_addr, LYConst.C_Y))
                        StoreValue(Add(cmd_addr, LYConst.C_Y), Add(old_y, gap_shift))
                        ci = Add(ci, 1)
                    }
                }
                max_cross = container_w
            }

            // Advance main-axis cursor
            cur_main = Add(cur_main, Add(item_main_sz, LYFlexTmp.gap))
            IfCondition GreaterThan(item_spacing, 0) ThenBlock: {
                cur_main = Add(cur_main, item_spacing)
            }

            LYFlexTmp.item_i = Add(LYFlexTmp.item_i, 1)
        }

        // Update cursor_y after flex container
        IfCondition EqualTo(LYFlexTmp.dir, 0) ThenBlock: {
            // Row: advance by tallest item
            LYState.cursor_y = Add(container_y, max_cross)
        }
        IfCondition EqualTo(LYFlexTmp.dir, 1) ThenBlock: {
            // Column: cursor_y is already advanced by child layouts + gaps
            total_gap = Multiply(LYFlexTmp.gap, Subtract(LYFlex.count, 1))
            LYState.cursor_y = Add(LYState.cursor_y, total_gap)
        }
    }
}

// =============================================================================
// MAIN LAYOUT — RECURSIVE DFS OVER DOM TREE
// ALL locals are stack variables — FixedPool temps get clobbered by recursion
// =============================================================================
