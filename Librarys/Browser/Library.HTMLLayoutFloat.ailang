// Library.HTMLLayoutFloat.ailang — Float helpers and float layout path
// Manages active float boxes and handles floated element layout.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutColors
LibraryImport.Browser.HTMLLayoutCSS

// =============================================================================
// FLOAT HELPERS — manage active float boxes
// =============================================================================

// Add a float entry to the pool
// dir: 1=left, 2=right; x,y,w,h = float box position and size
Function.LYFloat_Add {
    Input: dir: Integer
    Input: fx: Integer
    Input: fy: Integer
    Input: fw: Integer
    Input: fh: Integer
    Body: {
        IfCondition GreaterEqual(LYFloatState.count, LYFloatState.max) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(LYFloatState.count, LYFloatState.ENTRY_SIZE)
        base = Add(LYFloatState.pool, off)
        StoreValue(Add(base, LYFloatState.F_DIR), dir)
        StoreValue(Add(base, LYFloatState.F_X), fx)
        StoreValue(Add(base, LYFloatState.F_Y), fy)
        StoreValue(Add(base, LYFloatState.F_W), fw)
        StoreValue(Add(base, LYFloatState.F_H), fh)
        LYFloatState.count = Add(LYFloatState.count, 1)
        ReturnValue(1)
    }
}

// Get total left-float intrusion at a given y coordinate
// Returns the right edge of the rightmost left-float that overlaps y
Function.LYFloat_LeftAt {
    Input: y: Integer
    Input: container_x: Integer
    Output: Integer
    Body: {
        result = container_x
        fi = 0
        WhileLoop LessThan(fi, LYFloatState.count) {
            off = Multiply(fi, LYFloatState.ENTRY_SIZE)
            base = Add(LYFloatState.pool, off)
            f_dir = Dereference(Add(base, LYFloatState.F_DIR))
            IfCondition EqualTo(f_dir, 1) ThenBlock: {
                f_y = Dereference(Add(base, LYFloatState.F_Y))
                f_h = Dereference(Add(base, LYFloatState.F_H))
                f_bot = Add(f_y, f_h)
                // Does this float overlap the given y?
                IfCondition And(LessThan(y, f_bot), GreaterEqual(y, f_y)) ThenBlock: {
                    f_x = Dereference(Add(base, LYFloatState.F_X))
                    f_w = Dereference(Add(base, LYFloatState.F_W))
                    f_right = Add(f_x, f_w)
                    IfCondition GreaterThan(f_right, result) ThenBlock: {
                        result = f_right
                    }
                }
            }
            fi = Add(fi, 1)
        }
        ReturnValue(result)
    }
}

// Get right-float intrusion at a given y coordinate
// Returns the left edge of the leftmost right-float that overlaps y
Function.LYFloat_RightAt {
    Input: y: Integer
    Input: container_right: Integer
    Output: Integer
    Body: {
        result = container_right
        fi = 0
        WhileLoop LessThan(fi, LYFloatState.count) {
            off = Multiply(fi, LYFloatState.ENTRY_SIZE)
            base = Add(LYFloatState.pool, off)
            f_dir = Dereference(Add(base, LYFloatState.F_DIR))
            IfCondition EqualTo(f_dir, 2) ThenBlock: {
                f_y = Dereference(Add(base, LYFloatState.F_Y))
                f_h = Dereference(Add(base, LYFloatState.F_H))
                f_bot = Add(f_y, f_h)
                // Does this float overlap the given y?
                IfCondition And(LessThan(y, f_bot), GreaterEqual(y, f_y)) ThenBlock: {
                    f_x = Dereference(Add(base, LYFloatState.F_X))
                    IfCondition LessThan(f_x, result) ThenBlock: {
                        result = f_x
                    }
                }
            }
            fi = Add(fi, 1)
        }
        ReturnValue(result)
    }
}

// Get the y position past all floats of given direction
// dir: 0=both, 1=left, 2=right
// Returns the y coordinate below all matching floats
Function.LYFloat_ClearY {
    Input: dir: Integer
    Output: Integer
    Body: {
        result = 0
        fi = 0
        WhileLoop LessThan(fi, LYFloatState.count) {
            off = Multiply(fi, LYFloatState.ENTRY_SIZE)
            base = Add(LYFloatState.pool, off)
            f_dir = Dereference(Add(base, LYFloatState.F_DIR))
            should_check = 0
            IfCondition EqualTo(dir, 0) ThenBlock: { should_check = 1 }
            IfCondition EqualTo(f_dir, dir) ThenBlock: { should_check = 1 }
            IfCondition EqualTo(should_check, 1) ThenBlock: {
                f_y = Dereference(Add(base, LYFloatState.F_Y))
                f_h = Dereference(Add(base, LYFloatState.F_H))
                f_bot = Add(f_y, f_h)
                IfCondition GreaterThan(f_bot, result) ThenBlock: {
                    result = f_bot
                }
            }
            fi = Add(fi, 1)
        }
        ReturnValue(result)
    }
}

// =============================================================================
// FLOAT LAYOUT — extracted from LY__LayoutBlock
// Handles positioning and layout of floated elements.
// Saves/restores all LYState internally.
// =============================================================================
Function.LY__LayoutFloat {
    Input: node: Integer
    Input: tag: Address
    Input: inline_rule: Integer
    Input: float_dir: Integer
    Body: {
        // Save parent state
        sv_fg = LYState.fg_color
        sv_bg = LYState.bg_color
        sv_sc = LYState.font_scale
        sv_ind = LYState.indent
        sv_aw = LYState.avail_w
        sv_ta = LYState.text_align
        sv_vis = LYState.visible
        sv_lh = LYState.line_height
        sv_fspx = LYState.font_size_px
        sv_fwpx = LYState.font_w_px
        sv_ahem = LYState.is_ahem
        sv_cursor_x = LYState.cursor_x
        sv_cursor_y = LYState.cursor_y

        // Resolve width for the float
        flt_w = 0
        flt_w_auto = 0   // 1 = no explicit width, needs shrink-wrap
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            flt_wv = CSS_GetPropVal(inline_rule, "width")
            IfCondition NotEqual(flt_wv, 0) ThenBlock: {
                flt_w = LY__ParsePx(flt_wv)
            }
        }
        IfCondition EqualTo(flt_w, 0) ThenBlock: {
            flt_wc = LY__CSSLookupProp(node, "width")
            IfCondition NotEqual(flt_wc, 0) ThenBlock: {
                flt_w = LY__ParsePx(flt_wc)
            }
        }
        // If no explicit width, use full available width for initial layout
        // and shrink-wrap to content after measuring children
        IfCondition EqualTo(flt_w, 0) ThenBlock: {
            flt_w = LYState.avail_w
            flt_w_auto = 1
        }
        // Clamp to available width
        IfCondition GreaterThan(flt_w, LYState.avail_w) ThenBlock: {
            flt_w = LYState.avail_w
        }

        // Resolve padding for the float
        flt_pad_top = LY__ResolvePaddingSide(node, tag, 0)
        flt_pad_right = LY__ResolvePaddingSide(node, tag, 1)
        flt_pad_bottom = LY__ResolvePaddingSide(node, tag, 2)
        flt_pad_left = LY__ResolvePaddingSide(node, tag, 3)

        // Resolve margin for the float
        flt_mar_top = LY__ResolveMarginSide(node, tag, 0)
        flt_mar_right = LY__ResolveMarginSide(node, tag, 1)
        flt_mar_bottom = LY__ResolveMarginSide(node, tag, 2)
        flt_mar_left = LY__ResolveMarginSide(node, tag, 3)

        // Position the float — with line-wrapping if it doesn't fit
        flt_y = Add(LYState.cursor_y, flt_mar_top)
        flt_x = 0
        flt_container_r = Add(LYState.indent, LYState.avail_w)
        IfCondition EqualTo(float_dir, 1) ThenBlock: {
            // Float left: position after existing left floats
            flt_x = LYFloat_LeftAt(flt_y, LYState.indent)
            flt_x = Add(flt_x, flt_mar_left)
            // If float doesn't fit, drop below existing floats
            // (skip for auto-width since we'll shrink-wrap to content)
            IfCondition EqualTo(flt_w_auto, 0) ThenBlock: {
                flt_need = Add(flt_x, flt_w)
                flt_wrap_tries = 0
                WhileLoop And(GreaterThan(flt_need, flt_container_r), LessThan(flt_wrap_tries, 32)) {
                    // Move below the lowest float at current y
                    flt_y = LYFloat_ClearY(0)
                    IfCondition EqualTo(flt_y, 0) ThenBlock: {
                        flt_y = Add(LYState.cursor_y, flt_mar_top)
                        flt_wrap_tries = 32
                    }
                    flt_x = LYFloat_LeftAt(flt_y, LYState.indent)
                    flt_x = Add(flt_x, flt_mar_left)
                    flt_need = Add(flt_x, flt_w)
                    flt_wrap_tries = Add(flt_wrap_tries, 1)
                }
            }
        }
        IfCondition EqualTo(float_dir, 2) ThenBlock: {
            // Float right: position at right edge minus width
            flt_rmax = LYFloat_RightAt(flt_y, flt_container_r)
            IfCondition EqualTo(flt_w_auto, 1) ThenBlock: {
                // Auto-width: start at right edge, will shrink-wrap later
                flt_x = LYState.indent
            } ElseBlock: {
                flt_x = Subtract(flt_rmax, flt_w)
                flt_x = Subtract(flt_x, flt_mar_right)
                // If float doesn't fit (pushed past left edge), drop below
                flt_wrap_tries = 0
                WhileLoop And(LessThan(flt_x, LYState.indent), LessThan(flt_wrap_tries, 32)) {
                    flt_y = LYFloat_ClearY(0)
                    IfCondition EqualTo(flt_y, 0) ThenBlock: {
                        flt_y = Add(LYState.cursor_y, flt_mar_top)
                        flt_wrap_tries = 32
                    }
                    flt_rmax = LYFloat_RightAt(flt_y, flt_container_r)
                    flt_x = Subtract(flt_rmax, flt_w)
                    flt_x = Subtract(flt_x, flt_mar_right)
                    flt_wrap_tries = Add(flt_wrap_tries, 1)
                }
            }
        }

        // Resolve colors
        flt_fg = LY__ResolveFgColor(node)
        LYState.fg_color = flt_fg
        flt_bg = LY__ResolveBgColor(node)

        // Set up layout state for float contents
        flt_content_w = Subtract(flt_w, Add(flt_pad_left, flt_pad_right))
        IfCondition LessThan(flt_content_w, 8) ThenBlock: {
            flt_content_w = 8
        }
        LYState.indent = Add(flt_x, flt_pad_left)
        LYState.avail_w = flt_content_w
        LYState.cursor_x = LYState.indent
        LYState.cursor_y = Add(flt_y, flt_pad_top)

        // Layout children within the float box
        // Save float count — floats inside this float don't leak out
        sv_flt_count = LYFloatState.count
        flt_start_y = LYState.cursor_y
        flt_cmd_start = LYState.cmd_count
        fc = DOM_GetFirstChild(node)
        WhileLoop GreaterEqual(fc, 0) {
            next_fc = DOM_GetNextSib(fc)
            LY__LayoutNode(fc)
            fc = next_fc
        }
        // Restore float count — inner floats scoped to this float box
        LYFloatState.count = sv_flt_count

        // Flush trailing inline content
        IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
            flt_lh = LY__LineHeight()
            LYState.cursor_y = Add(LYState.cursor_y, flt_lh)
        }

        // =====================================================================
        // SHRINK-WRAP: if no explicit width, measure actual content width
        // from emitted commands and shrink the float box to fit
        // =====================================================================
        IfCondition EqualTo(flt_w_auto, 1) ThenBlock: {
            flt_cmd_end = LYState.cmd_count
            sw_max_r = 0
            sw_min_x = 999999
            sw_ci = flt_cmd_start
            WhileLoop LessThan(sw_ci, flt_cmd_end) {
                sw_addr = Add(LYState.cmd_pool, Multiply(sw_ci, LYConst.CMD_SIZE))
                sw_type = Dereference(Add(sw_addr, LYConst.C_TYPE))
                sw_x = Dereference(Add(sw_addr, LYConst.C_X))
                sw_right = 0
                IfCondition EqualTo(sw_type, LYCmd.DRAW_TEXT) ThenBlock: {
                    sw_len = Dereference(Add(sw_addr, LYConst.C_W))
                    sw_ptr = Dereference(Add(sw_addr, LYConst.C_PTR))
                    sw_fw = Dereference(Add(sw_addr, LYConst.C_H))
                    sw_fsz = BitwiseAnd(sw_fw, 32767)
                    IfCondition LessEqual(sw_fsz, 0) ThenBlock: { sw_fsz = 16 }
                    IfCondition And(NotEqual(sw_ptr, 0), GreaterThan(sw_len, 0)) ThenBlock: {
                        sw_tw = LY__MeasureText(sw_ptr, sw_len, sw_fsz)
                        sw_right = Add(sw_x, sw_tw)
                    } ElseBlock: {
                        sw_right = Add(sw_x, Multiply(sw_len, sw_fsz))
                    }
                }
                IfCondition EqualTo(sw_type, LYCmd.FILL_RECT) ThenBlock: {
                    sw_cw = Dereference(Add(sw_addr, LYConst.C_W))
                    sw_right = Add(sw_x, sw_cw)
                }
                IfCondition GreaterThan(sw_right, 0) ThenBlock: {
                    IfCondition LessThan(sw_x, sw_min_x) ThenBlock: {
                        sw_min_x = sw_x
                    }
                    IfCondition GreaterThan(sw_right, sw_max_r) ThenBlock: {
                        sw_max_r = sw_right
                    }
                }
                sw_ci = Add(sw_ci, 1)
            }
            // Compute content width from bounding box
            sw_content_w = 0
            IfCondition LessThan(sw_min_x, 999999) ThenBlock: {
                sw_content_w = Subtract(sw_max_r, flt_x)
            }
            // Add padding to get total float width
            IfCondition GreaterThan(sw_content_w, 0) ThenBlock: {
                flt_w = Add(sw_content_w, flt_pad_right)
            }
            // Minimum: at least padding-left + padding-right + 1 char
            IfCondition LessEqual(flt_w, Add(flt_pad_left, flt_pad_right)) ThenBlock: {
                flt_w = Add(Add(flt_pad_left, flt_pad_right), 16)
            }
            // Clamp to available width
            IfCondition GreaterThan(flt_w, sv_aw) ThenBlock: {
                flt_w = sv_aw
            }
            // For right floats, recompute flt_x and relocate commands
            IfCondition EqualTo(float_dir, 2) ThenBlock: {
                old_flt_x = flt_x
                flt_rmax2 = LYFloat_RightAt(flt_y, Add(sv_ind, sv_aw))
                flt_x = Subtract(flt_rmax2, flt_w)
                flt_x = Subtract(flt_x, flt_mar_right)
                sw_dx = Subtract(flt_x, old_flt_x)
                IfCondition NotEqual(sw_dx, 0) ThenBlock: {
                    sw_ri = flt_cmd_start
                    WhileLoop LessThan(sw_ri, flt_cmd_end) {
                        sw_raddr = Add(LYState.cmd_pool, Multiply(sw_ri, LYConst.CMD_SIZE))
                        sw_old_x = Dereference(Add(sw_raddr, LYConst.C_X))
                        StoreValue(Add(sw_raddr, LYConst.C_X), Add(sw_old_x, sw_dx))
                        sw_ri = Add(sw_ri, 1)
                    }
                }
            }
        }

        // Compute float content height
        flt_ch = Subtract(LYState.cursor_y, flt_start_y)
        // Apply explicit height if set
        flt_hv = 0
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            flt_hcv = CSS_GetPropVal(inline_rule, "height")
            IfCondition NotEqual(flt_hcv, 0) ThenBlock: {
                flt_hv = LY__ParsePx(flt_hcv)
            }
        }
        IfCondition EqualTo(flt_hv, 0) ThenBlock: {
            flt_hcss = LY__CSSLookupProp(node, "height")
            IfCondition NotEqual(flt_hcss, 0) ThenBlock: {
                flt_hv = LY__ParsePx(flt_hcss)
            }
        }
        IfCondition GreaterThan(flt_hv, flt_ch) ThenBlock: {
            flt_ch = flt_hv
        }

        // Total float box height including padding
        flt_total_h = Add(flt_ch, Add(flt_pad_top, flt_pad_bottom))

        // Emit background rect for the float
        IfCondition NotEqual(flt_bg, LYConst.COLOR_TRANSP) ThenBlock: {
            IfCondition GreaterThan(flt_total_h, 0) ThenBlock: {
                LY__EmitFillRect(flt_x, flt_y, flt_w, flt_total_h, flt_bg)
            }
        }

        // Register this float in the float pool
        LYFloat_Add(float_dir, flt_x, flt_y, flt_w, flt_total_h)
        LYState.dbg_floats = Add(LYState.dbg_floats, 1)

        // Restore parent state — cursor_y NOT advanced (floats don't push content down)
        LYState.fg_color = sv_fg
        LYState.bg_color = sv_bg
        LYState.font_scale = sv_sc
        LYState.indent = sv_ind
        LYState.avail_w = sv_aw
        LYState.text_align = sv_ta
        LYState.visible = sv_vis
        LYState.line_height = sv_lh
        LYState.font_size_px = sv_fspx
        LYState.font_w_px = sv_fwpx
        LYState.is_ahem = sv_ahem
        LYState.cursor_x = sv_ind
        LYState.cursor_y = sv_cursor_y
        ReturnValue(0)
    }
}
