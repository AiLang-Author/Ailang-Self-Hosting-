// Library.HTMLLayoutGrid.ailang — CSS Grid layout algorithm
// Parses grid-template-columns, auto-places items in row-first order,
// resolves fr/px track sizes, relocates child commands into grid cells.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutColors
LibraryImport.Browser.HTMLLayoutCSS
LibraryImport.Browser.HTMLLayoutFloat

// =============================================================================
// GRID TRACK HELPERS — access column definition pool
// =============================================================================
Function.LY__GridTrackAddr {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(Add(LYGridTrack.pool, Multiply(idx, LYGridTrack.ENTRY_SIZE))) }
}

Function.LY__GridTrackSet {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        addr = LY__GridTrackAddr(idx)
        StoreValue(Add(addr, field), val)
    }
}

Function.LY__GridTrackGet {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        addr = LY__GridTrackAddr(idx)
        ReturnValue(Dereference(Add(addr, field)))
    }
}

// =============================================================================
// PARSE grid-template-columns INTO TRACK POOL
// Handles: repeat(N, minmax(0, 1fr)), repeat(auto-fill, minmax(220px, 1fr)),
//          1fr, 100px 200px, etc.
// =============================================================================
Function.LY__GridParseColumns {
    Input: gtc_str: Address
    Input: container_w: Integer
    Body: {
        // Default: 1 column spanning full width (1fr)
        LYGridTmp.num_cols = 1
        LY__GridTrackSet(0, LYGridTrack.T_TYPE, 1)
        LY__GridTrackSet(0, LYGridTrack.T_VALUE, 1000)

        IfCondition EqualTo(gtc_str, 0) ThenBlock: { ReturnValue(0) }
        gtc_len = StringLength(gtc_str)
        IfCondition LessEqual(gtc_len, 0) ThenBlock: { ReturnValue(0) }

        // Check for repeat( syntax
        rep_idx = StringIndexOf(gtc_str, "repeat(")
        IfCondition GreaterEqual(rep_idx, 0) ThenBlock: {
            // Position after "repeat(" (7 chars)
            rp = Add(rep_idx, 7)

            // Check if auto-fill or auto-fit: first byte is 'a' (97)
            is_auto = 0
            IfCondition LessThan(rp, gtc_len) ThenBlock: {
                rb = GetByte(gtc_str, rp)
                IfCondition EqualTo(rb, 97) ThenBlock: {
                    is_auto = 1
                }
            }

            // Parse repeat count
            rep_count = 0
            IfCondition EqualTo(is_auto, 1) ThenBlock: {
                // auto-fill/auto-fit: compute count from container width
                // Find minmax( to get min value
                mm_idx = StringIndexOf(gtc_str, "minmax(")
                min_val = 0
                IfCondition GreaterEqual(mm_idx, 0) ThenBlock: {
                    min_val = LY__ParsePx(Add(gtc_str, Add(mm_idx, 7)))
                }
                IfCondition LessEqual(min_val, 0) ThenBlock: { min_val = 100 }
                // N = (container_w + col_gap) / (min_val + col_gap)
                denom = Add(min_val, LYGridTmp.col_gap)
                IfCondition LessEqual(denom, 0) ThenBlock: { denom = 1 }
                rep_count = Divide(Add(container_w, LYGridTmp.col_gap), denom)
                IfCondition LessThan(rep_count, 1) ThenBlock: { rep_count = 1 }
            }
            IfCondition EqualTo(is_auto, 0) ThenBlock: {
                // Integer count: parse number at rp
                rep_count = LY__ParsePx(Add(gtc_str, rp))
                IfCondition LessThan(rep_count, 1) ThenBlock: { rep_count = 1 }
            }

            // Clamp to MAX_COLS
            IfCondition GreaterThan(rep_count, LYGridTrack.MAX_COLS) ThenBlock: {
                rep_count = LYGridTrack.MAX_COLS
            }

            // Determine track type inside repeat
            // Look for "fr" after the comma in repeat() or inside minmax()
            // Check for minmax — if present, determine type from max value
            mm_idx2 = StringIndexOf(gtc_str, "minmax(")
            track_type = 1   // default: fr
            track_val = 1000 // default: 1fr (x1000 scale)

            IfCondition GreaterEqual(mm_idx2, 0) ThenBlock: {
                // Find the comma inside minmax to get to max value
                // Scan from minmax( position for comma
                mc_i = Add(mm_idx2, 7)
                mc_done = 0
                WhileLoop And(LessThan(mc_i, gtc_len), EqualTo(mc_done, 0)) {
                    mc_b = GetByte(gtc_str, mc_i)
                    IfCondition EqualTo(mc_b, 44) ThenBlock: {
                        mc_done = 1
                    } ElseBlock: {
                        mc_i = Add(mc_i, 1)
                    }
                }
                // mc_i points at comma, max value starts after it
                // Skip spaces after comma
                mc_i = Add(mc_i, 1)
                WhileLoop LessThan(mc_i, gtc_len) {
                    mc_sb = GetByte(gtc_str, mc_i)
                    IfCondition EqualTo(mc_sb, 32) ThenBlock: {
                        mc_i = Add(mc_i, 1)
                    } ElseBlock: {
                        mc_sb = 0
                    }
                }
                // Check if max value contains "fr"
                // Scan from mc_i for 'f' (102) followed by 'r' (114)
                has_fr = 0
                fr_scan = mc_i
                WhileLoop LessThan(fr_scan, gtc_len) {
                    fr_b = GetByte(gtc_str, fr_scan)
                    IfCondition EqualTo(fr_b, 102) ThenBlock: {
                        has_fr = 1
                    }
                    IfCondition EqualTo(fr_b, 41) ThenBlock: {
                        // Close paren — stop scanning
                        fr_scan = gtc_len
                    } ElseBlock: {
                        fr_scan = Add(fr_scan, 1)
                    }
                }

                IfCondition EqualTo(has_fr, 1) ThenBlock: {
                    track_type = 1
                    max_num = LY__ParsePx(Add(gtc_str, mc_i))
                    IfCondition LessEqual(max_num, 0) ThenBlock: { max_num = 1 }
                    track_val = Multiply(max_num, 1000)
                } ElseBlock: {
                    // Fixed px max value
                    track_type = 0
                    track_val = LY__ParsePx(Add(gtc_str, mc_i))
                    IfCondition LessEqual(track_val, 0) ThenBlock: { track_val = 100 }
                }
            }
            IfCondition LessThan(mm_idx2, 0) ThenBlock: {
                // No minmax — look for "fr" anywhere in repeat value
                // Scan after the comma past the count
                fr_found = 0
                fr_i = rp
                WhileLoop LessThan(fr_i, gtc_len) {
                    fr_b2 = GetByte(gtc_str, fr_i)
                    IfCondition EqualTo(fr_b2, 102) ThenBlock: { fr_found = 1 }
                    fr_i = Add(fr_i, 1)
                }
                IfCondition EqualTo(fr_found, 1) ThenBlock: {
                    // Find the track value after comma
                    cm_idx = Add(rp, 1)
                    WhileLoop LessThan(cm_idx, gtc_len) {
                        cm_b = GetByte(gtc_str, cm_idx)
                        IfCondition EqualTo(cm_b, 44) ThenBlock: {
                            cm_idx = gtc_len
                        } ElseBlock: {
                            cm_idx = Add(cm_idx, 1)
                        }
                    }
                    track_type = 1
                    track_val = 1000
                } ElseBlock: {
                    // Fixed px value
                    track_type = 0
                    // Find value after comma
                    cm_idx2 = rp
                    WhileLoop LessThan(cm_idx2, gtc_len) {
                        cm_b2 = GetByte(gtc_str, cm_idx2)
                        IfCondition EqualTo(cm_b2, 44) ThenBlock: {
                            cm_idx2 = Add(cm_idx2, 1)
                            // Skip spaces
                            WhileLoop LessThan(cm_idx2, gtc_len) {
                                cm_sb = GetByte(gtc_str, cm_idx2)
                                IfCondition EqualTo(cm_sb, 32) ThenBlock: {
                                    cm_idx2 = Add(cm_idx2, 1)
                                } ElseBlock: {
                                    cm_sb = 0
                                }
                            }
                            track_val = LY__ParsePx(Add(gtc_str, cm_idx2))
                            cm_idx2 = gtc_len
                        } ElseBlock: {
                            cm_idx2 = Add(cm_idx2, 1)
                        }
                    }
                }
            }

            // Fill all tracks with the same definition
            rc_i = 0
            WhileLoop LessThan(rc_i, rep_count) {
                LY__GridTrackSet(rc_i, LYGridTrack.T_TYPE, track_type)
                LY__GridTrackSet(rc_i, LYGridTrack.T_VALUE, track_val)
                rc_i = Add(rc_i, 1)
            }
            LYGridTmp.num_cols = rep_count
            ReturnValue(0)
        }

        // No repeat — parse space-separated tokens
        col_i = 0
        ti = 0
        WhileLoop And(LessThan(ti, gtc_len), LessThan(col_i, LYGridTrack.MAX_COLS)) {
            // Skip leading spaces
            WhileLoop And(LessThan(ti, gtc_len), EqualTo(GetByte(gtc_str, ti), 32)) {
                ti = Add(ti, 1)
            }
            IfCondition GreaterEqual(ti, gtc_len) ThenBlock: {
                ti = gtc_len
            }
            IfCondition LessThan(ti, gtc_len) ThenBlock: {
                // Find end of token (next space or end)
                tok_start = ti
                WhileLoop And(LessThan(ti, gtc_len), NotEqual(GetByte(gtc_str, ti), 32)) {
                    ti = Add(ti, 1)
                }
                // Check if token contains 'f' (102) for fr unit
                tok_has_fr = 0
                tf_i = tok_start
                WhileLoop LessThan(tf_i, ti) {
                    IfCondition EqualTo(GetByte(gtc_str, tf_i), 102) ThenBlock: {
                        tok_has_fr = 1
                    }
                    tf_i = Add(tf_i, 1)
                }
                tok_val = LY__ParsePx(Add(gtc_str, tok_start))
                IfCondition EqualTo(tok_has_fr, 1) ThenBlock: {
                    // fr unit
                    IfCondition LessEqual(tok_val, 0) ThenBlock: { tok_val = 1 }
                    LY__GridTrackSet(col_i, LYGridTrack.T_TYPE, 1)
                    LY__GridTrackSet(col_i, LYGridTrack.T_VALUE, Multiply(tok_val, 1000))
                } ElseBlock: {
                    // px value
                    IfCondition LessEqual(tok_val, 0) ThenBlock: { tok_val = 0 }
                    LY__GridTrackSet(col_i, LYGridTrack.T_TYPE, 0)
                    LY__GridTrackSet(col_i, LYGridTrack.T_VALUE, tok_val)
                }
                col_i = Add(col_i, 1)
            }
        }
        IfCondition GreaterThan(col_i, 0) ThenBlock: {
            LYGridTmp.num_cols = col_i
        }

        ReturnValue(0)
    }
}

// =============================================================================
// GRID LAYOUT — two-pass: measure children, then place into grid cells
// Called when a block element has display:grid
// =============================================================================
Function.LY__GridLayout {
    Input: node: Integer
    Body: {
        // =============================================
        // CSS PROPERTY PARSING
        // =============================================

        // Resolve gap / column-gap / row-gap
        LYGridTmp.col_gap = 0
        LYGridTmp.row_gap = 0

        // Check shorthand gap (applies to both)
        g_gap = LY__CSSLookupProp(node, "gap")
        IfCondition NotEqual(g_gap, 0) ThenBlock: {
            g_gap_px = LY__ParsePx(g_gap)
            LYGridTmp.col_gap = g_gap_px
            LYGridTmp.row_gap = g_gap_px
        }
        // Also check inline style for gap
        g_style = DOM_GetAttr(node, "style")
        IfCondition NotEqual(g_style, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(g_style, "gap"), 0) ThenBlock: {
                gs_len = StringLength(g_style)
                gs_rule = CSS_ParseInline(g_style, gs_len)
                IfCondition GreaterEqual(gs_rule, 0) ThenBlock: {
                    gs_gap = CSS_GetPropVal(gs_rule, "gap")
                    IfCondition NotEqual(gs_gap, 0) ThenBlock: {
                        gs_px = LY__ParsePx(gs_gap)
                        LYGridTmp.col_gap = gs_px
                        LYGridTmp.row_gap = gs_px
                    }
                    // column-gap / row-gap override shorthand
                    gs_cg = CSS_GetPropVal(gs_rule, "column-gap")
                    IfCondition NotEqual(gs_cg, 0) ThenBlock: {
                        LYGridTmp.col_gap = LY__ParsePx(gs_cg)
                    }
                    gs_rg = CSS_GetPropVal(gs_rule, "row-gap")
                    IfCondition NotEqual(gs_rg, 0) ThenBlock: {
                        LYGridTmp.row_gap = LY__ParsePx(gs_rg)
                    }
                }
            }
        }
        // CSS rules for column-gap / row-gap override
        cg_css = LY__CSSLookupProp(node, "column-gap")
        IfCondition NotEqual(cg_css, 0) ThenBlock: {
            LYGridTmp.col_gap = LY__ParsePx(cg_css)
        }
        rg_css = LY__CSSLookupProp(node, "row-gap")
        IfCondition NotEqual(rg_css, 0) ThenBlock: {
            LYGridTmp.row_gap = LY__ParsePx(rg_css)
        }

        // Resolve grid-template-columns
        gtc_str = 0
        IfCondition NotEqual(g_style, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(g_style, "grid-template"), 0) ThenBlock: {
                gs_len2 = StringLength(g_style)
                gs_rule2 = CSS_ParseInline(g_style, gs_len2)
                IfCondition GreaterEqual(gs_rule2, 0) ThenBlock: {
                    gtc_str = CSS_GetPropVal(gs_rule2, "grid-template-columns")
                }
            }
        }
        IfCondition EqualTo(gtc_str, 0) ThenBlock: {
            gtc_str = LY__CSSLookupProp(node, "grid-template-columns")
        }

        // Save container geometry
        container_x = LYState.indent
        container_y = LYState.cursor_y
        container_w = LYState.avail_w

        // Parse columns
        LY__GridParseColumns(gtc_str, container_w)

        // =============================================
        // COLUMN WIDTH RESOLUTION
        // =============================================
        num_cols = LYGridTmp.num_cols
        col_gap = LYGridTmp.col_gap
        row_gap = LYGridTmp.row_gap

        // Sum fixed-px and fr values
        fixed_total = 0
        total_fr = 0
        ri = 0
        WhileLoop LessThan(ri, num_cols) {
            rt = LY__GridTrackGet(ri, LYGridTrack.T_TYPE)
            rv = LY__GridTrackGet(ri, LYGridTrack.T_VALUE)
            IfCondition EqualTo(rt, 0) ThenBlock: {
                fixed_total = Add(fixed_total, rv)
            }
            IfCondition EqualTo(rt, 1) ThenBlock: {
                total_fr = Add(total_fr, rv)
            }
            ri = Add(ri, 1)
        }

        // Remaining space for fr columns
        gap_total = 0
        IfCondition GreaterThan(num_cols, 1) ThenBlock: {
            gap_total = Multiply(col_gap, Subtract(num_cols, 1))
        }
        remaining = Subtract(container_w, Add(fixed_total, gap_total))
        IfCondition LessThan(remaining, 0) ThenBlock: { remaining = 0 }

        // Resolve fr columns to px
        ri = 0
        WhileLoop LessThan(ri, num_cols) {
            rt = LY__GridTrackGet(ri, LYGridTrack.T_TYPE)
            IfCondition EqualTo(rt, 1) ThenBlock: {
                rv = LY__GridTrackGet(ri, LYGridTrack.T_VALUE)
                IfCondition GreaterThan(total_fr, 0) ThenBlock: {
                    col_px = Divide(Multiply(remaining, rv), total_fr)
                } ElseBlock: {
                    col_px = Divide(remaining, num_cols)
                }
                LY__GridTrackSet(ri, LYGridTrack.T_TYPE, 0)
                LY__GridTrackSet(ri, LYGridTrack.T_VALUE, col_px)
            }
            ri = Add(ri, 1)
        }

        // Copy resolved column widths to stack locals (nested grid safety)
        cw0 = LY__GridTrackGet(0, LYGridTrack.T_VALUE)
        cw1 = 0
        IfCondition GreaterThan(num_cols, 1) ThenBlock: { cw1 = LY__GridTrackGet(1, LYGridTrack.T_VALUE) }
        cw2 = 0
        IfCondition GreaterThan(num_cols, 2) ThenBlock: { cw2 = LY__GridTrackGet(2, LYGridTrack.T_VALUE) }
        cw3 = 0
        IfCondition GreaterThan(num_cols, 3) ThenBlock: { cw3 = LY__GridTrackGet(3, LYGridTrack.T_VALUE) }
        cw4 = 0
        IfCondition GreaterThan(num_cols, 4) ThenBlock: { cw4 = LY__GridTrackGet(4, LYGridTrack.T_VALUE) }
        cw5 = 0
        IfCondition GreaterThan(num_cols, 5) ThenBlock: { cw5 = LY__GridTrackGet(5, LYGridTrack.T_VALUE) }
        cw6 = 0
        IfCondition GreaterThan(num_cols, 6) ThenBlock: { cw6 = LY__GridTrackGet(6, LYGridTrack.T_VALUE) }
        cw7 = 0
        IfCondition GreaterThan(num_cols, 7) ThenBlock: { cw7 = LY__GridTrackGet(7, LYGridTrack.T_VALUE) }
        cw8 = 0
        IfCondition GreaterThan(num_cols, 8) ThenBlock: { cw8 = LY__GridTrackGet(8, LYGridTrack.T_VALUE) }
        cw9 = 0
        IfCondition GreaterThan(num_cols, 9) ThenBlock: { cw9 = LY__GridTrackGet(9, LYGridTrack.T_VALUE) }
        cw10 = 0
        IfCondition GreaterThan(num_cols, 10) ThenBlock: { cw10 = LY__GridTrackGet(10, LYGridTrack.T_VALUE) }
        cw11 = 0
        IfCondition GreaterThan(num_cols, 11) ThenBlock: { cw11 = LY__GridTrackGet(11, LYGridTrack.T_VALUE) }

        // =============================================
        // PASS 1: Measure children
        // =============================================
        LYFlex.count = 0
        fc = DOM_GetFirstChild(node)
        WhileLoop And(GreaterEqual(fc, 0), LessThan(LYFlex.count, LYFlex.MAX_ITEMS)) {
            next_fc = DOM_GetNextSib(fc)

            // Skip text-only whitespace nodes
            fc_type = DOM_GetType(fc)
            IfCondition EqualTo(fc_type, DOMType.TEXT) ThenBlock: {
                fc = next_fc
            }
            IfCondition NotEqual(fc_type, DOMType.TEXT) ThenBlock: {
                // Check display:none on child
                fc_hidden = 0
                fc_tag = DOM_GetTag(fc)
                fc_disp = LY__GetDisplay(fc_tag)
                IfCondition EqualTo(fc_disp, LYDisp.NONE) ThenBlock: { fc_hidden = 1 }
                IfCondition EqualTo(fc_hidden, 0) ThenBlock: {
                    fc_css_d = LY__CSSLookupProp(fc, "display")
                    IfCondition NotEqual(fc_css_d, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(fc_css_d, "none"), 0) ThenBlock: {
                            fc_hidden = 1
                        }
                    }
                }

                IfCondition EqualTo(fc_hidden, 0) ThenBlock: {
                    fi = LYFlex.count

                    // Compute column index: fi % num_cols
                    item_col = Subtract(fi, Multiply(Divide(fi, num_cols), num_cols))

                    // Look up column width from stack locals
                    col_w = cw0
                    IfCondition EqualTo(item_col, 1) ThenBlock: { col_w = cw1 }
                    IfCondition EqualTo(item_col, 2) ThenBlock: { col_w = cw2 }
                    IfCondition EqualTo(item_col, 3) ThenBlock: { col_w = cw3 }
                    IfCondition EqualTo(item_col, 4) ThenBlock: { col_w = cw4 }
                    IfCondition EqualTo(item_col, 5) ThenBlock: { col_w = cw5 }
                    IfCondition EqualTo(item_col, 6) ThenBlock: { col_w = cw6 }
                    IfCondition EqualTo(item_col, 7) ThenBlock: { col_w = cw7 }
                    IfCondition EqualTo(item_col, 8) ThenBlock: { col_w = cw8 }
                    IfCondition EqualTo(item_col, 9) ThenBlock: { col_w = cw9 }
                    IfCondition EqualTo(item_col, 10) ThenBlock: { col_w = cw10 }
                    IfCondition EqualTo(item_col, 11) ThenBlock: { col_w = cw11 }

                    // Constrain avail_w to column width before measuring
                    sv_aw_child = LYState.avail_w
                    sv_ind_child = LYState.indent
                    LYState.avail_w = col_w

                    cmd_before = LYState.cmd_count
                    cy_before = LYState.cursor_y

                    // Layout child — emits commands at current cursor
                    LY__LayoutNode(fc)

                    // Measure height from cursor advance
                    item_h = Subtract(LYState.cursor_y, cy_before)
                    cmd_after = LYState.cmd_count

                    // Restore avail_w
                    LYState.avail_w = sv_aw_child
                    LYState.indent = sv_ind_child

                    // Store in LYFlex item pool (shared with flex — mutually exclusive)
                    LY__FlexItemSet(fi, LYFlex.I_NODE, fc)
                    LY__FlexItemSet(fi, LYFlex.I_MEAS_W, col_w)
                    LY__FlexItemSet(fi, LYFlex.I_MEAS_H, item_h)
                    LY__FlexItemSet(fi, LYFlex.I_CMD_START, cmd_before)
                    LY__FlexItemSet(fi, LYFlex.I_CMD_COUNT, Subtract(cmd_after, cmd_before))
                    LY__FlexItemSet(fi, LYFlex.I_GROW, 0)

                    LYFlex.count = Add(LYFlex.count, 1)
                }

                fc = next_fc
            }
        }

        // =============================================
        // PASS 2: Place items into grid cells
        // =============================================
        IfCondition EqualTo(LYFlex.count, 0) ThenBlock: { ReturnValue(0) }

        // Compute number of rows: ceil(count / num_cols)
        num_rows = Divide(Add(LYFlex.count, Subtract(num_cols, 1)), num_cols)

        // Reset cursor to container start for relocation
        LYState.cursor_y = container_y
        cur_row = 0
        cur_row_y = container_y

        WhileLoop LessThan(cur_row, num_rows) {
            // Find max height in this row
            row_max_h = 0
            ri_start = Multiply(cur_row, num_cols)
            ri_end = Add(ri_start, num_cols)
            IfCondition GreaterThan(ri_end, LYFlex.count) ThenBlock: { ri_end = LYFlex.count }

            ri_scan = ri_start
            WhileLoop LessThan(ri_scan, ri_end) {
                rh = LY__FlexItemGet(ri_scan, LYFlex.I_MEAS_H)
                IfCondition GreaterThan(rh, row_max_h) ThenBlock: { row_max_h = rh }
                ri_scan = Add(ri_scan, 1)
            }

            // Place each item in this row
            ri = ri_start
            WhileLoop LessThan(ri, ri_end) {
                item_col = Subtract(ri, Multiply(cur_row, num_cols))

                // Compute cell_x: container_x + sum(col widths before this col) + col * col_gap
                cell_x = container_x
                cx_i = 0
                WhileLoop LessThan(cx_i, item_col) {
                    // Get column width from stack locals
                    cx_w = cw0
                    IfCondition EqualTo(cx_i, 1) ThenBlock: { cx_w = cw1 }
                    IfCondition EqualTo(cx_i, 2) ThenBlock: { cx_w = cw2 }
                    IfCondition EqualTo(cx_i, 3) ThenBlock: { cx_w = cw3 }
                    IfCondition EqualTo(cx_i, 4) ThenBlock: { cx_w = cw4 }
                    IfCondition EqualTo(cx_i, 5) ThenBlock: { cx_w = cw5 }
                    IfCondition EqualTo(cx_i, 6) ThenBlock: { cx_w = cw6 }
                    IfCondition EqualTo(cx_i, 7) ThenBlock: { cx_w = cw7 }
                    IfCondition EqualTo(cx_i, 8) ThenBlock: { cx_w = cw8 }
                    IfCondition EqualTo(cx_i, 9) ThenBlock: { cx_w = cw9 }
                    IfCondition EqualTo(cx_i, 10) ThenBlock: { cx_w = cw10 }
                    IfCondition EqualTo(cx_i, 11) ThenBlock: { cx_w = cw11 }
                    cell_x = Add(cell_x, Add(cx_w, col_gap))
                    cx_i = Add(cx_i, 1)
                }

                cell_y = cur_row_y

                // Compute original Y where this item's commands were placed
                // Items were measured sequentially: orig_y = container_y + sum(heights[0..ri-1])
                orig_y = container_y
                oy_i = 0
                WhileLoop LessThan(oy_i, ri) {
                    orig_y = Add(orig_y, LY__FlexItemGet(oy_i, LYFlex.I_MEAS_H))
                    oy_i = Add(oy_i, 1)
                }

                dy = Subtract(cell_y, orig_y)

                // Relocate all commands for this item
                i_cmd_start = LY__FlexItemGet(ri, LYFlex.I_CMD_START)
                i_cmd_count = LY__FlexItemGet(ri, LYFlex.I_CMD_COUNT)
                ci = i_cmd_start
                ci_end = Add(i_cmd_start, i_cmd_count)
                WhileLoop LessThan(ci, ci_end) {
                    cmd_addr = Add(LYState.cmd_pool, Multiply(ci, LYConst.CMD_SIZE))
                    old_x = Dereference(Add(cmd_addr, LYConst.C_X))
                    old_y = Dereference(Add(cmd_addr, LYConst.C_Y))
                    // Shift X: (old_x - container_x) + cell_x preserves relative positioning
                    new_x = Add(Subtract(old_x, container_x), cell_x)
                    new_y = Add(old_y, dy)
                    StoreValue(Add(cmd_addr, LYConst.C_X), new_x)
                    StoreValue(Add(cmd_addr, LYConst.C_Y), new_y)
                    ci = Add(ci, 1)
                }

                ri = Add(ri, 1)
            }

            // Advance to next row
            cur_row_y = Add(cur_row_y, Add(row_max_h, row_gap))
            cur_row = Add(cur_row, 1)
        }

        // Update cursor_y to after the grid (remove trailing row_gap)
        LYState.cursor_y = cur_row_y
        IfCondition GreaterThan(num_rows, 0) ThenBlock: {
            LYState.cursor_y = Subtract(LYState.cursor_y, row_gap)
        }
    }
}
