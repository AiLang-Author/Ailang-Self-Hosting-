// Library.HTMLLayoutTable.ailang — Table layout engine
// Handles <table>, <tr>, <td>/<th> with column width distribution.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutColors
LibraryImport.Browser.HTMLLayoutCSS
LibraryImport.Browser.HTMLLayoutFlex

// Column widths storage (max 32 columns)
FixedPool.LYTable {
    "col_w_arr":     Initialize=0
    "col_x_arr":     Initialize=0
    "max_cols":      Initialize=0
    "col_min_arr":   Initialize=0
    "col_max_arr":   Initialize=0
    "col_fixed_arr": Initialize=0
    "col_type_arr":  Initialize=0
    "text_buf":      Initialize=0
}

// =============================================================================
// LY__LayoutTable — layout a <table> element with column distribution
// =============================================================================
Function.LY__LayoutTable {
    Input: node: Integer
    Input: tag: Address
    Input: is_visible: Integer
    Body: {
        LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
        LYState.dbg_blocks = Add(LYState.dbg_blocks, 1)

        // Flush any inline content before table block
        IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
            tf_h = LY__LineHeight()
            LYState.cursor_y = Add(LYState.cursor_y, tf_h)
            LYState.cursor_x = LYState.indent
        }

        // Save parent state
        sv_fg = LYState.fg_color
        sv_bg = LYState.bg_color
        sv_ind = LYState.indent
        sv_aw = LYState.avail_w
        sv_ta = LYState.text_align
        sv_vis = LYState.visible
        sv_fspx = LYState.font_size_px
        sv_fwpx = LYState.font_w_px
        sv_last_mb = LYState.last_margin_b
        sv_cursor_y = LYState.cursor_y

        // Save outer table column state (nested tables clobber LYTable globals)
        sv_tbl_col_w = LYTable.col_w_arr
        sv_tbl_col_x = LYTable.col_x_arr
        sv_tbl_max_c = LYTable.max_cols
        sv_tbl_col_min = LYTable.col_min_arr
        sv_tbl_col_max = LYTable.col_max_arr
        sv_tbl_col_fix = LYTable.col_fixed_arr
        sv_tbl_col_typ = LYTable.col_type_arr
        sv_tbl_txtbuf = LYTable.text_buf

        IfCondition EqualTo(is_visible, 0) ThenBlock: {
            LYState.visible = 0
        }

        // Resolve table background color
        tbl_bg = LY__ResolveBgColor(node)
        IfCondition NotEqual(tbl_bg, LYConst.COLOR_TRANSP) ThenBlock: {
            LYState.bg_color = tbl_bg
        }

        // Resolve table foreground color
        tbl_fg = LY__ResolveFgColor(node)
        LYState.fg_color = tbl_fg

        // Resolve margins
        tbl_mt = LY__ResolveMarginSide(node, tag, 0)
        tbl_mb = LY__ResolveMarginSide(node, tag, 2)
        tbl_ml = LY__ResolveMarginSide(node, tag, 3)
        tbl_mr = LY__ResolveMarginSide(node, tag, 1)

        // Apply top margin (collapse with previous)
        tbl_mt_eff = tbl_mt
        IfCondition GreaterThan(LYState.last_margin_b, 0) ThenBlock: {
            IfCondition GreaterThan(tbl_mt, LYState.last_margin_b) ThenBlock: {
                tbl_mt_eff = Subtract(tbl_mt, LYState.last_margin_b)
            } ElseBlock: {
                tbl_mt_eff = 0
            }
        }
        LYState.cursor_y = Add(LYState.cursor_y, tbl_mt_eff)
        LYState.last_margin_b = 0

        // Resolve table width from CSS or attribute
        tbl_w = LYState.avail_w
        tbl_w_css = 0
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            IfCondition GreaterEqual(StringIndexOf(style_str, "width"), 0) ThenBlock: {
                tw_slen = StringLength(style_str)
                tw_rule = CSS_ParseInline(style_str, tw_slen)
                IfCondition GreaterEqual(tw_rule, 0) ThenBlock: {
                    tw_v = CSS_GetPropVal(tw_rule, "width")
                    IfCondition NotEqual(tw_v, 0) ThenBlock: {
                        tw_px = LY__ParsePx(tw_v)
                        IfCondition GreaterThan(tw_px, 0) ThenBlock: {
                            tbl_w = tw_px
                            tbl_w_css = 1
                        }
                    }
                }
            }
        }
        // Check width attribute
        IfCondition EqualTo(tbl_w_css, 0) ThenBlock: {
            tw_attr = DOM_GetAttr(node, "width")
            IfCondition NotEqual(tw_attr, 0) ThenBlock: {
                tw_apx = LY__ParsePx(tw_attr)
                IfCondition GreaterThan(tw_apx, 0) ThenBlock: {
                    tbl_w = tw_apx
                }
            }
        }
        // Clamp to available width
        IfCondition GreaterThan(tbl_w, LYState.avail_w) ThenBlock: {
            tbl_w = LYState.avail_w
        }

        // Center table if margin:auto
        tbl_x = LYState.indent
        IfCondition LessThan(tbl_w, LYState.avail_w) ThenBlock: {
            // Default centering for tables (unless margins specified)
            tbl_x = Add(LYState.indent, Divide(Subtract(LYState.avail_w, tbl_w), 2))
        }

        // Emit background fill for table
        IfCondition NotEqual(tbl_bg, LYConst.COLOR_TRANSP) ThenBlock: {
            // Placeholder — height updated after layout
        }

        // === Phase 1: Count max columns per row ===
        tbl_max_cols = 0
        tbl_scan = DOM_GetFirstChild(node)
        WhileLoop GreaterEqual(tbl_scan, 0) {
            tbl_scan_next = DOM_GetNextSib(tbl_scan)
            tbl_scan_tag = DOM_GetTag(tbl_scan)
            tbl_scan_is_row = 0
            IfCondition NotEqual(tbl_scan_tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tbl_scan_tag, "tr"), 0) ThenBlock: { tbl_scan_is_row = 1 }
                // tbody/thead/tfoot: scan their children for tr
                IfCondition EqualTo(StringCompare(tbl_scan_tag, "tbody"), 0) ThenBlock: { tbl_scan_is_row = 2 }
                IfCondition EqualTo(StringCompare(tbl_scan_tag, "thead"), 0) ThenBlock: { tbl_scan_is_row = 2 }
                IfCondition EqualTo(StringCompare(tbl_scan_tag, "tfoot"), 0) ThenBlock: { tbl_scan_is_row = 2 }
            }
            IfCondition EqualTo(tbl_scan_is_row, 1) ThenBlock: {
                // Count cells in this row
                tbl_row_cols = 0
                tbl_cell = DOM_GetFirstChild(tbl_scan)
                WhileLoop GreaterEqual(tbl_cell, 0) {
                    tbl_cell_tag = DOM_GetTag(tbl_cell)
                    IfCondition NotEqual(tbl_cell_tag, 0) ThenBlock: {
                        IfCondition Or(EqualTo(StringCompare(tbl_cell_tag, "td"), 0), EqualTo(StringCompare(tbl_cell_tag, "th"), 0)) ThenBlock: {
                            // Check colspan
                            cs_attr = DOM_GetAttr(tbl_cell, "colspan")
                            cs_val = 1
                            IfCondition NotEqual(cs_attr, 0) ThenBlock: {
                                cs_p = LY__ParsePx(cs_attr)
                                IfCondition GreaterThan(cs_p, 0) ThenBlock: { cs_val = cs_p }
                            }
                            tbl_row_cols = Add(tbl_row_cols, cs_val)
                        }
                    }
                    tbl_cell = DOM_GetNextSib(tbl_cell)
                }
                IfCondition GreaterThan(tbl_row_cols, tbl_max_cols) ThenBlock: {
                    tbl_max_cols = tbl_row_cols
                }
            }
            IfCondition EqualTo(tbl_scan_is_row, 2) ThenBlock: {
                // Scan tbody/thead/tfoot for tr children
                tbl_inner = DOM_GetFirstChild(tbl_scan)
                WhileLoop GreaterEqual(tbl_inner, 0) {
                    tbl_inner_tag = DOM_GetTag(tbl_inner)
                    IfCondition NotEqual(tbl_inner_tag, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(tbl_inner_tag, "tr"), 0) ThenBlock: {
                            tbl_row_cols2 = 0
                            tbl_cell2 = DOM_GetFirstChild(tbl_inner)
                            WhileLoop GreaterEqual(tbl_cell2, 0) {
                                tbl_cell2_tag = DOM_GetTag(tbl_cell2)
                                IfCondition NotEqual(tbl_cell2_tag, 0) ThenBlock: {
                                    IfCondition Or(EqualTo(StringCompare(tbl_cell2_tag, "td"), 0), EqualTo(StringCompare(tbl_cell2_tag, "th"), 0)) ThenBlock: {
                                        cs2_attr = DOM_GetAttr(tbl_cell2, "colspan")
                                        cs2_val = 1
                                        IfCondition NotEqual(cs2_attr, 0) ThenBlock: {
                                            cs2_p = LY__ParsePx(cs2_attr)
                                            IfCondition GreaterThan(cs2_p, 0) ThenBlock: { cs2_val = cs2_p }
                                        }
                                        tbl_row_cols2 = Add(tbl_row_cols2, cs2_val)
                                    }
                                }
                                tbl_cell2 = DOM_GetNextSib(tbl_cell2)
                            }
                            IfCondition GreaterThan(tbl_row_cols2, tbl_max_cols) ThenBlock: {
                                tbl_max_cols = tbl_row_cols2
                            }
                        }
                    }
                    tbl_inner = DOM_GetNextSib(tbl_inner)
                }
            }
            tbl_scan = tbl_scan_next
        }
        IfCondition LessThan(tbl_max_cols, 1) ThenBlock: { tbl_max_cols = 1 }
        IfCondition GreaterThan(tbl_max_cols, 32) ThenBlock: { tbl_max_cols = 32 }

        // Allocate column arrays
        LYTable.col_w_arr = Allocate(Multiply(tbl_max_cols, 8))
        LYTable.col_x_arr = Allocate(Multiply(tbl_max_cols, 8))
        LYTable.col_min_arr = Allocate(Multiply(tbl_max_cols, 8))
        LYTable.col_max_arr = Allocate(Multiply(tbl_max_cols, 8))
        LYTable.col_fixed_arr = Allocate(Multiply(tbl_max_cols, 8))
        LYTable.col_type_arr = Allocate(Multiply(tbl_max_cols, 8))
        IfCondition EqualTo(LYTable.text_buf, 0) ThenBlock: {
            LYTable.text_buf = Allocate(2048)
        }

        // === Phase 2: Content-based column sizing ===
        // Zero out all arrays
        ci = 0
        WhileLoop LessThan(ci, tbl_max_cols) {
            p2_off = Multiply(ci, 8)
            StoreValue(Add(LYTable.col_w_arr, p2_off), 0, "qword")
            StoreValue(Add(LYTable.col_min_arr, p2_off), 0, "qword")
            StoreValue(Add(LYTable.col_max_arr, p2_off), 0, "qword")
            StoreValue(Add(LYTable.col_fixed_arr, p2_off), 0, "qword")
            StoreValue(Add(LYTable.col_type_arr, p2_off), 0, "qword")
            ci = Add(ci, 1)
        }

        // Scan ALL rows for content min/max widths and explicit widths
        p2_font_w = LYState.font_w_px
        IfCondition LessThan(p2_font_w, 1) ThenBlock: { p2_font_w = 8 }
        tbl_scan2 = DOM_GetFirstChild(node)
        WhileLoop GreaterEqual(tbl_scan2, 0) {
            tbl_scan2_next = DOM_GetNextSib(tbl_scan2)
            tbl_scan2_tag = DOM_GetTag(tbl_scan2)
            s2_is_row = 0
            IfCondition NotEqual(tbl_scan2_tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tbl_scan2_tag, "tr"), 0) ThenBlock: { s2_is_row = 1 }
                IfCondition EqualTo(StringCompare(tbl_scan2_tag, "tbody"), 0) ThenBlock: { s2_is_row = 2 }
                IfCondition EqualTo(StringCompare(tbl_scan2_tag, "thead"), 0) ThenBlock: { s2_is_row = 2 }
                IfCondition EqualTo(StringCompare(tbl_scan2_tag, "tfoot"), 0) ThenBlock: { s2_is_row = 2 }
            }
            IfCondition EqualTo(s2_is_row, 1) ThenBlock: {
                LY__TblScanRowMinMax(tbl_scan2, tbl_max_cols, p2_font_w)
            }
            IfCondition EqualTo(s2_is_row, 2) ThenBlock: {
                s2_inner = DOM_GetFirstChild(tbl_scan2)
                WhileLoop GreaterEqual(s2_inner, 0) {
                    s2_inner_tag = DOM_GetTag(s2_inner)
                    IfCondition NotEqual(s2_inner_tag, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(s2_inner_tag, "tr"), 0) ThenBlock: {
                            LY__TblScanRowMinMax(s2_inner, tbl_max_cols, p2_font_w)
                        }
                    }
                    s2_inner = DOM_GetNextSib(s2_inner)
                }
            }
            tbl_scan2 = tbl_scan2_next
        }

        // Distribute widths proportionally
        LY__TblDistributeWidths(tbl_w, tbl_max_cols)

        // Compute column X offsets
        cx = tbl_x
        ci = 0
        WhileLoop LessThan(ci, tbl_max_cols) {
            StoreValue(Add(LYTable.col_x_arr, Multiply(ci, 8)), cx, "qword")
            cw = Dereference(Add(LYTable.col_w_arr, Multiply(ci, 8)), "qword")
            cx = Add(cx, cw)
            ci = Add(ci, 1)
        }

        // === Phase 3: Layout rows ===
        tbl_child = DOM_GetFirstChild(node)
        WhileLoop GreaterEqual(tbl_child, 0) {
            tbl_child_next = DOM_GetNextSib(tbl_child)
            tbl_child_tag = DOM_GetTag(tbl_child)
            tc_is_row = 0
            IfCondition NotEqual(tbl_child_tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(tbl_child_tag, "tr"), 0) ThenBlock: { tc_is_row = 1 }
                IfCondition EqualTo(StringCompare(tbl_child_tag, "tbody"), 0) ThenBlock: { tc_is_row = 2 }
                IfCondition EqualTo(StringCompare(tbl_child_tag, "thead"), 0) ThenBlock: { tc_is_row = 2 }
                IfCondition EqualTo(StringCompare(tbl_child_tag, "tfoot"), 0) ThenBlock: { tc_is_row = 2 }
                IfCondition EqualTo(StringCompare(tbl_child_tag, "caption"), 0) ThenBlock: { tc_is_row = 3 }
            }
            IfCondition EqualTo(tc_is_row, 1) ThenBlock: {
                LY__LayoutTableRow(tbl_child, tbl_max_cols)
            }
            IfCondition EqualTo(tc_is_row, 2) ThenBlock: {
                // tbody/thead/tfoot: process their tr children
                tbl_sec = DOM_GetFirstChild(tbl_child)
                WhileLoop GreaterEqual(tbl_sec, 0) {
                    tbl_sec_next = DOM_GetNextSib(tbl_sec)
                    tbl_sec_tag = DOM_GetTag(tbl_sec)
                    IfCondition NotEqual(tbl_sec_tag, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(tbl_sec_tag, "tr"), 0) ThenBlock: {
                            LY__LayoutTableRow(tbl_sec, tbl_max_cols)
                        }
                    }
                    tbl_sec = tbl_sec_next
                }
            }
            IfCondition EqualTo(tc_is_row, 3) ThenBlock: {
                // Caption: just layout as block
                LY__LayoutBlock(tbl_child, tbl_child_tag, LYDisp.BLOCK, is_visible)
            }
            tbl_child = tbl_child_next
        }

        // Apply bottom margin
        LYState.last_margin_b = tbl_mb

        // Restore parent state
        LYState.fg_color = sv_fg
        LYState.bg_color = sv_bg
        LYState.indent = sv_ind
        LYState.avail_w = sv_aw
        LYState.text_align = sv_ta
        IfCondition NotEqual(is_visible, 0) ThenBlock: {
            LYState.visible = sv_vis
        }
        LYState.font_size_px = sv_fspx
        LYState.font_w_px = sv_fwpx
        LYState.cursor_x = sv_ind

        // Restore outer table column state
        LYTable.col_w_arr = sv_tbl_col_w
        LYTable.col_x_arr = sv_tbl_col_x
        LYTable.max_cols = sv_tbl_max_c
        LYTable.col_min_arr = sv_tbl_col_min
        LYTable.col_max_arr = sv_tbl_col_max
        LYTable.col_fixed_arr = sv_tbl_col_fix
        LYTable.col_type_arr = sv_tbl_col_typ
        LYTable.text_buf = sv_tbl_txtbuf
    }
}

// =============================================================================
// LY__LayoutTableRow — layout a single <tr> with cells side by side
// =============================================================================
Function.LY__LayoutTableRow {
    Input: row_node: Integer
    Input: max_cols: Integer
    Body: {
        row_y = LYState.cursor_y
        row_max_h = 0

        // Resolve row background
        row_bg = LY__ResolveBgColor(row_node)

        // Get valign attribute
        row_valign = DOM_GetAttr(row_node, "valign")

        col_idx = 0
        cell = DOM_GetFirstChild(row_node)
        WhileLoop And(GreaterEqual(cell, 0), LessThan(col_idx, max_cols)) {
            cell_next = DOM_GetNextSib(cell)
            cell_tag = DOM_GetTag(cell)
            cell_is_td = 0
            IfCondition NotEqual(cell_tag, 0) ThenBlock: {
                IfCondition Or(EqualTo(StringCompare(cell_tag, "td"), 0), EqualTo(StringCompare(cell_tag, "th"), 0)) ThenBlock: {
                    cell_is_td = 1
                }
            }
            IfCondition EqualTo(cell_is_td, 1) ThenBlock: {
                // Get colspan
                cell_cs = 1
                cs_a = DOM_GetAttr(cell, "colspan")
                IfCondition NotEqual(cs_a, 0) ThenBlock: {
                    cs_v = LY__ParsePx(cs_a)
                    IfCondition GreaterThan(cs_v, 0) ThenBlock: { cell_cs = cs_v }
                }
                // Compute cell width (sum of spanned columns)
                cell_w = 0
                cs_i = 0
                WhileLoop LessThan(cs_i, cell_cs) {
                    ci_idx = Add(col_idx, cs_i)
                    IfCondition LessThan(ci_idx, max_cols) ThenBlock: {
                        cw = Dereference(Add(LYTable.col_w_arr, Multiply(ci_idx, 8)), "qword")
                        cell_w = Add(cell_w, cw)
                    }
                    cs_i = Add(cs_i, 1)
                }
                // Get cell X from column table
                cell_x = Dereference(Add(LYTable.col_x_arr, Multiply(col_idx, 8)), "qword")

                // Save state for cell layout
                sv_cx = LYState.cursor_x
                sv_cy = LYState.cursor_y
                sv_ind = LYState.indent
                sv_aw = LYState.avail_w
                sv_fg = LYState.fg_color
                sv_bg = LYState.bg_color
                sv_ta = LYState.text_align

                // Set up cell state
                LYState.cursor_x = cell_x
                LYState.cursor_y = row_y
                LYState.indent = cell_x
                LYState.avail_w = cell_w

                // Resolve cell padding
                cell_pad = LY__ResolvePaddingSide(cell, cell_tag, 0)
                cell_pad_l = LY__ResolvePaddingSide(cell, cell_tag, 3)
                cell_pad_r = LY__ResolvePaddingSide(cell, cell_tag, 1)
                cell_pad_b = LY__ResolvePaddingSide(cell, cell_tag, 2)
                LYState.cursor_x = Add(cell_x, cell_pad_l)
                LYState.cursor_y = Add(row_y, cell_pad)
                LYState.indent = Add(cell_x, cell_pad_l)
                LYState.avail_w = Subtract(cell_w, Add(cell_pad_l, cell_pad_r))
                IfCondition LessThan(LYState.avail_w, 0) ThenBlock: { LYState.avail_w = 0 }

                // Resolve cell bg/fg
                cell_bg = LY__ResolveBgColor(cell)
                IfCondition NotEqual(cell_bg, LYConst.COLOR_TRANSP) ThenBlock: {
                    LYState.bg_color = cell_bg
                }
                cell_fg = LY__ResolveFgColor(cell)
                LYState.fg_color = cell_fg

                // Resolve text-align
                cell_align = DOM_GetAttr(cell, "align")
                IfCondition NotEqual(cell_align, 0) ThenBlock: {
                    LYState.text_align = LY__MapTextAlign(cell_align, LYState.text_align)
                }
                // Check nowrap
                cell_nowrap = DOM_GetAttr(cell, "nowrap")

                // Layout cell children
                cc = DOM_GetFirstChild(cell)
                WhileLoop GreaterEqual(cc, 0) {
                    cc_next = DOM_GetNextSib(cc)
                    LY__LayoutNode(cc)
                    cc = cc_next
                }

                // Flush trailing inline content
                IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
                    cf_h = LY__LineHeight()
                    LYState.cursor_y = Add(LYState.cursor_y, cf_h)
                    LYState.cursor_x = LYState.indent
                }

                // Compute cell height
                cell_h = Subtract(LYState.cursor_y, row_y)
                cell_h = Add(cell_h, cell_pad_b)
                IfCondition GreaterThan(cell_h, row_max_h) ThenBlock: {
                    row_max_h = cell_h
                }

                // Restore state
                LYState.cursor_x = sv_cx
                LYState.cursor_y = sv_cy
                LYState.indent = sv_ind
                LYState.avail_w = sv_aw
                LYState.fg_color = sv_fg
                LYState.bg_color = sv_bg
                LYState.text_align = sv_ta

                col_idx = Add(col_idx, cell_cs)
            }
            cell = cell_next
        }

        // Advance cursor_y by row height
        IfCondition LessThan(row_max_h, 1) ThenBlock: { row_max_h = 1 }
        LYState.cursor_y = Add(row_y, row_max_h)
        LYState.cursor_x = LYState.indent
        LYState.last_margin_b = 0
    }
}

// =============================================================================
// LY__TblMeasureMinMax — measure a cell's min (longest word) and max (one-line)
//   Returns max_w. Stores min_w in LYTable.text_buf offset 0 (side-channel).
// =============================================================================
Function.LY__TblMeasureMinMax {
    Input: cell_node: Integer
    Input: font_w: Integer
    Output: Integer
    Body: {
        // Collect all text from cell's DOM subtree
        mm_buf = Add(LYTable.text_buf, 8)
        mm_cap = 2040
        mm_len = DOM_GetTextContent(cell_node, mm_buf, mm_cap)

        IfCondition LessEqual(mm_len, 0) ThenBlock: {
            // No text — check for <img> with width attribute
            mm_img_w = 0
            mm_ch = DOM_GetFirstChild(cell_node)
            WhileLoop GreaterEqual(mm_ch, 0) {
                mm_ch_tag = DOM_GetTag(mm_ch)
                IfCondition NotEqual(mm_ch_tag, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(mm_ch_tag, "img"), 0) ThenBlock: {
                        mm_iwa = DOM_GetAttr(mm_ch, "width")
                        IfCondition NotEqual(mm_iwa, 0) ThenBlock: {
                            mm_iwv = LY__ParsePx(mm_iwa)
                            IfCondition GreaterThan(mm_iwv, 0) ThenBlock: { mm_img_w = mm_iwv }
                        }
                        IfCondition EqualTo(mm_img_w, 0) ThenBlock: { mm_img_w = 16 }
                    }
                }
                // Check one level deep (e.g. <a><img></a>)
                IfCondition EqualTo(mm_img_w, 0) ThenBlock: {
                    mm_sub = DOM_GetFirstChild(mm_ch)
                    IfCondition GreaterEqual(mm_sub, 0) ThenBlock: {
                        mm_sub_tag = DOM_GetTag(mm_sub)
                        IfCondition NotEqual(mm_sub_tag, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(mm_sub_tag, "img"), 0) ThenBlock: {
                                mm_swa = DOM_GetAttr(mm_sub, "width")
                                IfCondition NotEqual(mm_swa, 0) ThenBlock: {
                                    mm_swv = LY__ParsePx(mm_swa)
                                    IfCondition GreaterThan(mm_swv, 0) ThenBlock: { mm_img_w = mm_swv }
                                }
                                IfCondition EqualTo(mm_img_w, 0) ThenBlock: { mm_img_w = 16 }
                            }
                        }
                    }
                }
                IfCondition GreaterThan(mm_img_w, 0) ThenBlock: {
                    StoreValue(LYTable.text_buf, mm_img_w, "qword")
                    ReturnValue(mm_img_w)
                }
                mm_ch = DOM_GetNextSib(mm_ch)
            }
            StoreValue(LYTable.text_buf, 0, "qword")
            ReturnValue(0)
        }

        // Scan text for word boundaries to compute min_w and max_w
        mm_min = 0
        mm_max = 0
        mm_si = 0
        WhileLoop LessThan(mm_si, mm_len) {
            // Skip whitespace
            mm_ws = 0
            WhileLoop And(LessThan(mm_si, mm_len), EqualTo(mm_ws, 0)) {
                mm_c = GetByte(mm_buf, mm_si)
                mm_isw = 0
                IfCondition EqualTo(mm_c, 32) ThenBlock: { mm_isw = 1 }
                IfCondition EqualTo(mm_c, 10) ThenBlock: { mm_isw = 1 }
                IfCondition EqualTo(mm_c, 13) ThenBlock: { mm_isw = 1 }
                IfCondition EqualTo(mm_c, 9) ThenBlock: { mm_isw = 1 }
                IfCondition EqualTo(mm_isw, 1) ThenBlock: {
                    // Add inter-word space to max_w
                    IfCondition GreaterThan(mm_max, 0) ThenBlock: {
                        mm_max = Add(mm_max, font_w)
                    }
                    mm_si = Add(mm_si, 1)
                } ElseBlock: {
                    mm_ws = 1
                }
            }
            IfCondition GreaterEqual(mm_si, mm_len) ThenBlock: { BreakLoop }

            // Find word end
            mm_wstart = mm_si
            mm_wdone = 0
            WhileLoop And(LessThan(mm_si, mm_len), EqualTo(mm_wdone, 0)) {
                mm_c2 = GetByte(mm_buf, mm_si)
                mm_isw2 = 0
                IfCondition EqualTo(mm_c2, 32) ThenBlock: { mm_isw2 = 1 }
                IfCondition EqualTo(mm_c2, 10) ThenBlock: { mm_isw2 = 1 }
                IfCondition EqualTo(mm_c2, 13) ThenBlock: { mm_isw2 = 1 }
                IfCondition EqualTo(mm_c2, 9) ThenBlock: { mm_isw2 = 1 }
                IfCondition EqualTo(mm_isw2, 1) ThenBlock: {
                    mm_wdone = 1
                } ElseBlock: {
                    mm_si = Add(mm_si, 1)
                }
            }

            // Measure this word
            mm_wlen = Subtract(mm_si, mm_wstart)
            mm_wptr = Add(mm_buf, mm_wstart)
            mm_wpx = LY__MeasureText(mm_wptr, mm_wlen, font_w)

            // Update min (longest single word)
            IfCondition GreaterThan(mm_wpx, mm_min) ThenBlock: {
                mm_min = mm_wpx
            }
            // Accumulate max (total one-line width)
            mm_max = Add(mm_max, mm_wpx)
        }

        StoreValue(LYTable.text_buf, mm_min, "qword")
        ReturnValue(mm_max)
    }
}

// =============================================================================
// LY__TblScanRowMinMax — scan a <tr>, updating column min/max/fixed arrays
// =============================================================================
Function.LY__TblScanRowMinMax {
    Input: row_node: Integer
    Input: max_cols: Integer
    Input: font_w: Integer
    Body: {
        sr_ci = 0
        sr_cell = DOM_GetFirstChild(row_node)
        WhileLoop And(GreaterEqual(sr_cell, 0), LessThan(sr_ci, max_cols)) {
            sr_cell_next = DOM_GetNextSib(sr_cell)
            sr_cell_tag = DOM_GetTag(sr_cell)
            sr_is_td = 0
            IfCondition NotEqual(sr_cell_tag, 0) ThenBlock: {
                IfCondition Or(EqualTo(StringCompare(sr_cell_tag, "td"), 0), EqualTo(StringCompare(sr_cell_tag, "th"), 0)) ThenBlock: {
                    sr_is_td = 1
                }
            }
            IfCondition EqualTo(sr_is_td, 1) ThenBlock: {
                // Get colspan
                sr_cs = 1
                sr_csa = DOM_GetAttr(sr_cell, "colspan")
                IfCondition NotEqual(sr_csa, 0) ThenBlock: {
                    sr_csv = LY__ParsePx(sr_csa)
                    IfCondition GreaterThan(sr_csv, 0) ThenBlock: { sr_cs = sr_csv }
                }
                IfCondition GreaterThan(sr_cs, Subtract(max_cols, sr_ci)) ThenBlock: {
                    sr_cs = Subtract(max_cols, sr_ci)
                }

                // Check for explicit width on this cell
                sr_fw = 0
                sr_ft = 0
                sr_wa = DOM_GetAttr(sr_cell, "width")
                IfCondition NotEqual(sr_wa, 0) ThenBlock: {
                    sr_pct = StringIndexOf(sr_wa, "%")
                    IfCondition GreaterEqual(sr_pct, 0) ThenBlock: {
                        sr_pv = StringToInt(sr_wa)
                        IfCondition GreaterThan(sr_pv, 0) ThenBlock: {
                            sr_fw = sr_pv
                            sr_ft = 2
                        }
                    } ElseBlock: {
                        sr_wpx = LY__ParsePx(sr_wa)
                        IfCondition GreaterThan(sr_wpx, 0) ThenBlock: {
                            sr_fw = sr_wpx
                            sr_ft = 1
                        }
                    }
                }
                // Check inline style width
                IfCondition EqualTo(sr_fw, 0) ThenBlock: {
                    sr_sty = DOM_GetAttr(sr_cell, "style")
                    IfCondition NotEqual(sr_sty, 0) ThenBlock: {
                        IfCondition GreaterEqual(StringIndexOf(sr_sty, "width"), 0) ThenBlock: {
                            sr_sl = StringLength(sr_sty)
                            sr_rule = CSS_ParseInline(sr_sty, sr_sl)
                            IfCondition GreaterEqual(sr_rule, 0) ThenBlock: {
                                sr_wv = CSS_GetPropVal(sr_rule, "width")
                                IfCondition NotEqual(sr_wv, 0) ThenBlock: {
                                    sr_wpx2 = LY__ParsePx(sr_wv)
                                    IfCondition GreaterThan(sr_wpx2, 0) ThenBlock: {
                                        sr_fw = sr_wpx2
                                        sr_ft = 1
                                    }
                                }
                            }
                        }
                    }
                }

                // Measure content intrinsic widths
                sr_maxw = LY__TblMeasureMinMax(sr_cell, font_w)
                sr_minw = Dereference(LYTable.text_buf, "qword")

                // Add cell padding to intrinsic sizes
                sr_padl = LY__ResolvePaddingSide(sr_cell, sr_cell_tag, 3)
                sr_padr = LY__ResolvePaddingSide(sr_cell, sr_cell_tag, 1)
                sr_pad = Add(sr_padl, sr_padr)
                sr_minw = Add(sr_minw, sr_pad)
                sr_maxw = Add(sr_maxw, sr_pad)

                // Update column arrays
                IfCondition EqualTo(sr_cs, 1) ThenBlock: {
                    // Single column: max-merge min/max
                    sr_off = Multiply(sr_ci, 8)
                    sr_cmin = Dereference(Add(LYTable.col_min_arr, sr_off), "qword")
                    IfCondition GreaterThan(sr_minw, sr_cmin) ThenBlock: {
                        StoreValue(Add(LYTable.col_min_arr, sr_off), sr_minw, "qword")
                    }
                    sr_cmax = Dereference(Add(LYTable.col_max_arr, sr_off), "qword")
                    IfCondition GreaterThan(sr_maxw, sr_cmax) ThenBlock: {
                        StoreValue(Add(LYTable.col_max_arr, sr_off), sr_maxw, "qword")
                    }
                    // Store fixed width (first explicit wins)
                    IfCondition GreaterThan(sr_ft, 0) ThenBlock: {
                        sr_cfix = Dereference(Add(LYTable.col_fixed_arr, sr_off), "qword")
                        IfCondition EqualTo(sr_cfix, 0) ThenBlock: {
                            StoreValue(Add(LYTable.col_fixed_arr, sr_off), sr_fw, "qword")
                            StoreValue(Add(LYTable.col_type_arr, sr_off), sr_ft, "qword")
                        }
                    }
                } ElseBlock: {
                    // Colspan > 1: distribute evenly across spanned columns
                    sr_share_min = Divide(sr_minw, sr_cs)
                    sr_share_max = Divide(sr_maxw, sr_cs)
                    sr_rem_min = Subtract(sr_minw, Multiply(sr_share_min, sr_cs))
                    sr_rem_max = Subtract(sr_maxw, Multiply(sr_share_max, sr_cs))

                    sr_j = 0
                    WhileLoop LessThan(sr_j, sr_cs) {
                        sr_ji = Add(sr_ci, sr_j)
                        IfCondition LessThan(sr_ji, max_cols) ThenBlock: {
                            sr_sm = sr_share_min
                            sr_sx = sr_share_max
                            IfCondition EqualTo(sr_j, 0) ThenBlock: {
                                sr_sm = Add(sr_sm, sr_rem_min)
                                sr_sx = Add(sr_sx, sr_rem_max)
                            }
                            sr_joff = Multiply(sr_ji, 8)
                            sr_cm2 = Dereference(Add(LYTable.col_min_arr, sr_joff), "qword")
                            IfCondition GreaterThan(sr_sm, sr_cm2) ThenBlock: {
                                StoreValue(Add(LYTable.col_min_arr, sr_joff), sr_sm, "qword")
                            }
                            sr_cx2 = Dereference(Add(LYTable.col_max_arr, sr_joff), "qword")
                            IfCondition GreaterThan(sr_sx, sr_cx2) ThenBlock: {
                                StoreValue(Add(LYTable.col_max_arr, sr_joff), sr_sx, "qword")
                            }
                        }
                        sr_j = Add(sr_j, 1)
                    }
                }

                sr_ci = Add(sr_ci, sr_cs)
            }
            sr_cell = sr_cell_next
        }
    }
}

// =============================================================================
// LY__TblDistributeWidths — proportional column width distribution
// =============================================================================
Function.LY__TblDistributeWidths {
    Input: tbl_w: Integer
    Input: max_cols: Integer
    Body: {
        // Step 1: Apply fixed widths, compute sum_min/sum_max for auto columns
        dw_sum_fixed = 0
        dw_sum_min = 0
        dw_sum_max = 0
        dw_auto_cols = 0

        dw_ci = 0
        WhileLoop LessThan(dw_ci, max_cols) {
            dw_off = Multiply(dw_ci, 8)
            dw_fixed = Dereference(Add(LYTable.col_fixed_arr, dw_off), "qword")
            dw_type = Dereference(Add(LYTable.col_type_arr, dw_off), "qword")
            dw_cmin = Dereference(Add(LYTable.col_min_arr, dw_off), "qword")
            dw_cmax = Dereference(Add(LYTable.col_max_arr, dw_off), "qword")

            IfCondition EqualTo(dw_type, 2) ThenBlock: {
                // Percentage: resolve against tbl_w
                dw_fixed = Divide(Multiply(tbl_w, dw_fixed), 100)
                IfCondition LessThan(dw_fixed, dw_cmin) ThenBlock: { dw_fixed = dw_cmin }
                StoreValue(Add(LYTable.col_w_arr, dw_off), dw_fixed, "qword")
                dw_sum_fixed = Add(dw_sum_fixed, dw_fixed)
            }
            IfCondition EqualTo(dw_type, 1) ThenBlock: {
                // Fixed px: clamp to at least min_w
                IfCondition LessThan(dw_fixed, dw_cmin) ThenBlock: { dw_fixed = dw_cmin }
                StoreValue(Add(LYTable.col_w_arr, dw_off), dw_fixed, "qword")
                dw_sum_fixed = Add(dw_sum_fixed, dw_fixed)
            }
            IfCondition EqualTo(dw_type, 0) ThenBlock: {
                // Auto column: ensure min >= 8px
                IfCondition LessThan(dw_cmin, 8) ThenBlock: { dw_cmin = 8 }
                StoreValue(Add(LYTable.col_min_arr, dw_off), dw_cmin, "qword")
                IfCondition LessThan(dw_cmax, dw_cmin) ThenBlock: { dw_cmax = dw_cmin }
                StoreValue(Add(LYTable.col_max_arr, dw_off), dw_cmax, "qword")
                dw_sum_min = Add(dw_sum_min, dw_cmin)
                dw_sum_max = Add(dw_sum_max, dw_cmax)
                dw_auto_cols = Add(dw_auto_cols, 1)
                StoreValue(Add(LYTable.col_w_arr, dw_off), 0, "qword")
            }
            dw_ci = Add(dw_ci, 1)
        }

        // Step 2: Available space for auto columns
        dw_avail = Subtract(tbl_w, dw_sum_fixed)
        IfCondition LessThan(dw_avail, 0) ThenBlock: { dw_avail = 0 }

        // No auto columns — done
        IfCondition EqualTo(dw_auto_cols, 0) ThenBlock: { ReturnValue(0) }

        // Step 3: Distribute among auto columns
        IfCondition LessEqual(dw_avail, dw_sum_min) ThenBlock: {
            // Case A: each auto column gets its min_w
            dw_ci = 0
            WhileLoop LessThan(dw_ci, max_cols) {
                dw_off = Multiply(dw_ci, 8)
                dw_type = Dereference(Add(LYTable.col_type_arr, dw_off), "qword")
                IfCondition EqualTo(dw_type, 0) ThenBlock: {
                    dw_cmin = Dereference(Add(LYTable.col_min_arr, dw_off), "qword")
                    StoreValue(Add(LYTable.col_w_arr, dw_off), dw_cmin, "qword")
                }
                dw_ci = Add(dw_ci, 1)
            }
            ReturnValue(0)
        }

        IfCondition GreaterEqual(dw_avail, dw_sum_max) ThenBlock: {
            // Case B: each gets max_w + equal share of excess
            dw_excess = Subtract(dw_avail, dw_sum_max)
            dw_extra = Divide(dw_excess, dw_auto_cols)
            dw_ci = 0
            WhileLoop LessThan(dw_ci, max_cols) {
                dw_off = Multiply(dw_ci, 8)
                dw_type = Dereference(Add(LYTable.col_type_arr, dw_off), "qword")
                IfCondition EqualTo(dw_type, 0) ThenBlock: {
                    dw_cmax = Dereference(Add(LYTable.col_max_arr, dw_off), "qword")
                    StoreValue(Add(LYTable.col_w_arr, dw_off), Add(dw_cmax, dw_extra), "qword")
                }
                dw_ci = Add(dw_ci, 1)
            }
            ReturnValue(0)
        }

        // Case C: proportional interpolation between min and max
        // col_w[i] = min[i] + ((max[i] - min[i]) * (avail - sum_min)) / (sum_max - sum_min)
        dw_ext_total = Subtract(dw_avail, dw_sum_min)
        dw_rng_total = Subtract(dw_sum_max, dw_sum_min)
        IfCondition LessEqual(dw_rng_total, 0) ThenBlock: {
            // Degenerate: all auto columns have min == max, distribute equally
            dw_per = Divide(dw_avail, dw_auto_cols)
            dw_ci = 0
            WhileLoop LessThan(dw_ci, max_cols) {
                dw_off = Multiply(dw_ci, 8)
                dw_type = Dereference(Add(LYTable.col_type_arr, dw_off), "qword")
                IfCondition EqualTo(dw_type, 0) ThenBlock: {
                    StoreValue(Add(LYTable.col_w_arr, dw_off), dw_per, "qword")
                }
                dw_ci = Add(dw_ci, 1)
            }
            ReturnValue(0)
        }

        // Normal proportional distribution
        dw_distributed = 0
        dw_ci = 0
        WhileLoop LessThan(dw_ci, max_cols) {
            dw_off = Multiply(dw_ci, 8)
            dw_type = Dereference(Add(LYTable.col_type_arr, dw_off), "qword")
            IfCondition EqualTo(dw_type, 0) ThenBlock: {
                dw_cmin = Dereference(Add(LYTable.col_min_arr, dw_off), "qword")
                dw_cmax = Dereference(Add(LYTable.col_max_arr, dw_off), "qword")
                dw_col_rng = Subtract(dw_cmax, dw_cmin)
                dw_col_ext = Divide(Multiply(dw_col_rng, dw_ext_total), dw_rng_total)
                dw_col_w = Add(dw_cmin, dw_col_ext)
                StoreValue(Add(LYTable.col_w_arr, dw_off), dw_col_w, "qword")
                dw_distributed = Add(dw_distributed, dw_col_w)
            }
            dw_ci = Add(dw_ci, 1)
        }

        // Fix rounding error: give leftover to last auto column
        dw_round_err = Subtract(dw_avail, dw_distributed)
        IfCondition GreaterThan(dw_round_err, 0) ThenBlock: {
            dw_last = -1
            dw_ci = 0
            WhileLoop LessThan(dw_ci, max_cols) {
                dw_off = Multiply(dw_ci, 8)
                dw_type = Dereference(Add(LYTable.col_type_arr, dw_off), "qword")
                IfCondition EqualTo(dw_type, 0) ThenBlock: { dw_last = dw_ci }
                dw_ci = Add(dw_ci, 1)
            }
            IfCondition GreaterEqual(dw_last, 0) ThenBlock: {
                dw_loff = Multiply(dw_last, 8)
                dw_lcur = Dereference(Add(LYTable.col_w_arr, dw_loff), "qword")
                StoreValue(Add(LYTable.col_w_arr, dw_loff), Add(dw_lcur, dw_round_err), "qword")
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// LY__TableFindFirstRow — find first <tr> in a table (may be inside tbody)
// =============================================================================
Function.LY__TableFindFirstRow {
    Input: table_node: Integer
    Output: Integer
    Body: {
        ch = DOM_GetFirstChild(table_node)
        WhileLoop GreaterEqual(ch, 0) {
            ch_tag = DOM_GetTag(ch)
            IfCondition NotEqual(ch_tag, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(ch_tag, "tr"), 0) ThenBlock: {
                    ReturnValue(ch)
                }
                // Check inside tbody/thead/tfoot
                IfCondition Or(Or(EqualTo(StringCompare(ch_tag, "tbody"), 0), EqualTo(StringCompare(ch_tag, "thead"), 0)), EqualTo(StringCompare(ch_tag, "tfoot"), 0)) ThenBlock: {
                    inner = DOM_GetFirstChild(ch)
                    WhileLoop GreaterEqual(inner, 0) {
                        in_tag = DOM_GetTag(inner)
                        IfCondition NotEqual(in_tag, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(in_tag, "tr"), 0) ThenBlock: {
                                ReturnValue(inner)
                            }
                        }
                        inner = DOM_GetNextSib(inner)
                    }
                }
            }
            ch = DOM_GetNextSib(ch)
        }
        ReturnValue(-1)
    }
}
