// Library.HTMLLayoutTraversal.ailang — Block element layout traversal
// Handles block-level CSS resolution, float detection, flex dispatch, children layout.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayoutColors
LibraryImport.Browser.HTMLLayoutCSS
LibraryImport.Browser.HTMLLayoutFloat
LibraryImport.Browser.HTMLLayoutFlex
LibraryImport.Browser.HTMLLayoutGrid

Function.LY__LayoutBlock {
    Input: node: Integer
    Input: tag: Address
    Input: css_disp: Address
    Input: inline_rule: Integer
    Input: is_visible: Integer
    Body: {
        LYState.dbg_nodes = Add(LYState.dbg_nodes, 1)
        LYState.dbg_blocks = Add(LYState.dbg_blocks, 1)
        // Flush any inline content on the current line before starting block
        IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
            blk_fh = LY__LineHeight()
            LYState.cursor_y = Add(LYState.cursor_y, blk_fh)
            LYState.cursor_x = LYState.indent
        }

        // Save parent state to stack locals
        sv_fg = LYState.fg_color
        sv_bg = LYState.bg_color
        sv_sc = LYState.font_scale
        sv_ind = LYState.indent
        sv_aw = LYState.avail_w
        sv_ta = LYState.text_align
        sv_vis = LYState.visible
        sv_lh = LYState.line_height
        sv_fspx = LYState.font_size_px
        sv_fwpx = LYState.font_w_px
        sv_ahem = LYState.is_ahem
        sv_ls = LYState.letter_sp
        sv_float_count = LYFloatState.count
        sv_last_mb = LYState.last_margin_b
        sv_cursor_y = LYState.cursor_y

        // Apply visibility:hidden — suppress paint but preserve layout
        IfCondition EqualTo(is_visible, 0) ThenBlock: {
            LYState.visible = 0
        }

        // Pre-parse inline style ONCE and cache the rule index
        // This avoids re-parsing the same inline style string 8+ times per block
        inline_style = DOM_GetAttr(node, "style")
        inline_rule = -1
        IfCondition NotEqual(inline_style, 0) ThenBlock: {
            is_len = StringLength(inline_style)
            IfCondition GreaterThan(is_len, 0) ThenBlock: {
                inline_rule = CSS_ParseInline(inline_style, is_len)
            }
        }

        // =====================================================================
        // FLOAT DETECTION — check CSS float property before normal block flow
        // Floated elements are removed from normal flow and positioned at
        // the left or right edge of their container.
        // =====================================================================
        float_dir = 0   // 0=none, 1=left, 2=right
        LYState.dbg_fl_chk = Add(LYState.dbg_fl_chk, 1)
        // Check cached inline style for float
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            fl_v = CSS_GetPropVal(inline_rule, "float")
            IfCondition NotEqual(fl_v, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(fl_v, "left"), 0) ThenBlock: {
                    float_dir = 1
                }
                IfCondition EqualTo(StringCompare(fl_v, "right"), 0) ThenBlock: {
                    float_dir = 2
                }
            }
        }
        // Check CSS rules for float (if inline didn't set it)
        IfCondition EqualTo(float_dir, 0) ThenBlock: {
            fl_css = LY__CSSLookupProp(node, "float")
            IfCondition NotEqual(fl_css, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(fl_css, "left"), 0) ThenBlock: {
                    float_dir = 1
                }
                IfCondition EqualTo(StringCompare(fl_css, "right"), 0) ThenBlock: {
                    float_dir = 2
                }
            }
        }

        // =====================================================================
        // FLOAT LAYOUT PATH — delegate to LY__LayoutFloat (saves/restores LYState)
        // =====================================================================
        IfCondition GreaterThan(float_dir, 0) ThenBlock: {
            LY__LayoutFloat(node, tag, inline_rule, float_dir)
            ReturnValue(0)
        }

        // =====================================================================
        // POSITION: ABSOLUTE/FIXED — remove from flow, position with offsets
        // =====================================================================
        pos_type = 0  // 0=static/relative, 1=absolute, 2=fixed
        pos_css = 0
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            pos_css = CSS_GetPropVal(inline_rule, "position")
        }
        IfCondition EqualTo(pos_css, 0) ThenBlock: {
            pos_css = LY__CSSLookupProp(node, "position")
        }
        IfCondition NotEqual(pos_css, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(pos_css, "absolute"), 0) ThenBlock: { pos_type = 1 }
            IfCondition EqualTo(StringCompare(pos_css, "fixed"), 0) ThenBlock: { pos_type = 2 }
        }
        IfCondition GreaterThan(pos_type, 0) ThenBlock: {
            // Resolve top/left/right/bottom offsets
            pos_top = -1
            pos_left = -1
            pos_right = -1
            pos_bottom = -1
            pt_v = 0
            pl_v = 0
            pr_v = 0
            pb_v = 0
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                pt_v = CSS_GetPropVal(inline_rule, "top")
                pl_v = CSS_GetPropVal(inline_rule, "left")
                pr_v = CSS_GetPropVal(inline_rule, "right")
                pb_v = CSS_GetPropVal(inline_rule, "bottom")
            }
            IfCondition EqualTo(pt_v, 0) ThenBlock: { pt_v = LY__CSSLookupProp(node, "top") }
            IfCondition EqualTo(pl_v, 0) ThenBlock: { pl_v = LY__CSSLookupProp(node, "left") }
            IfCondition EqualTo(pr_v, 0) ThenBlock: { pr_v = LY__CSSLookupProp(node, "right") }
            IfCondition EqualTo(pb_v, 0) ThenBlock: { pb_v = LY__CSSLookupProp(node, "bottom") }
            IfCondition NotEqual(pt_v, 0) ThenBlock: {
                IfCondition NotEqual(StringCompare(pt_v, "auto"), 0) ThenBlock: {
                    pos_top = LY__ParsePx(pt_v)
                }
            }
            IfCondition NotEqual(pl_v, 0) ThenBlock: {
                IfCondition NotEqual(StringCompare(pl_v, "auto"), 0) ThenBlock: {
                    pos_left = LY__ParsePx(pl_v)
                }
            }
            IfCondition NotEqual(pr_v, 0) ThenBlock: {
                IfCondition NotEqual(StringCompare(pr_v, "auto"), 0) ThenBlock: {
                    pos_right = LY__ParsePx(pr_v)
                }
            }
            IfCondition NotEqual(pb_v, 0) ThenBlock: {
                IfCondition NotEqual(StringCompare(pb_v, "auto"), 0) ThenBlock: {
                    pos_bottom = LY__ParsePx(pb_v)
                }
            }

            // Resolve width/height for absolutely positioned element
            ap_w = 0
            ap_h = 0
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                apw_v = CSS_GetPropVal(inline_rule, "width")
                IfCondition NotEqual(apw_v, 0) ThenBlock: { ap_w = LY__ParsePx(apw_v) }
                aph_v = CSS_GetPropVal(inline_rule, "height")
                IfCondition NotEqual(aph_v, 0) ThenBlock: { ap_h = LY__ParsePx(aph_v) }
            }
            IfCondition EqualTo(ap_w, 0) ThenBlock: {
                apw_c = LY__CSSLookupProp(node, "width")
                IfCondition NotEqual(apw_c, 0) ThenBlock: { ap_w = LY__ParsePx(apw_c) }
            }
            IfCondition EqualTo(ap_h, 0) ThenBlock: {
                aph_c = LY__CSSLookupProp(node, "height")
                IfCondition NotEqual(aph_c, 0) ThenBlock: { ap_h = LY__ParsePx(aph_c) }
            }

            // Containing block origin = nearest positioned ancestor's padding edge
            cb_x = LYState.cb_x
            cb_y = LYState.cb_y
            cb_w = LYState.cb_w

            // Compute X position
            ap_x = cb_x
            IfCondition GreaterEqual(pos_left, 0) ThenBlock: {
                ap_x = Add(cb_x, pos_left)
            } ElseBlock: {
                IfCondition GreaterEqual(pos_right, 0) ThenBlock: {
                    IfCondition GreaterThan(ap_w, 0) ThenBlock: {
                        ap_x = Subtract(Add(cb_x, cb_w), Add(pos_right, ap_w))
                    }
                }
            }

            // Compute Y position
            ap_y = cb_y
            IfCondition GreaterEqual(pos_top, 0) ThenBlock: {
                ap_y = Add(cb_y, pos_top)
            } ElseBlock: {
                IfCondition GreaterEqual(pos_bottom, 0) ThenBlock: {
                    IfCondition GreaterThan(ap_h, 0) ThenBlock: {
                        ap_y = Subtract(700, Add(pos_bottom, ap_h))
                    }
                }
            }

            // Set up layout state for measuring content
            IfCondition GreaterThan(ap_w, 0) ThenBlock: {
                LYState.avail_w = ap_w
            }
            LYState.indent = ap_x
            LYState.cursor_y = ap_y
            LYState.cursor_x = ap_x

            // Record cmd position before children
            ap_cmd_before = Layout_CmdCount()

            // Layout children normally at the computed position
            bc = DOM_GetFirstChild(node)
            WhileLoop GreaterEqual(bc, 0) {
                next_bc = DOM_GetNextSib(bc)
                LY__LayoutNode(bc)
                bc = next_bc
            }

            // Compute content height
            ap_content_h = Subtract(LYState.cursor_y, ap_y)
            IfCondition GreaterThan(ap_h, ap_content_h) ThenBlock: {
                ap_content_h = ap_h
            }

            // Emit background
            ap_bg = LY__ResolveBgColor(node)
            IfCondition NotEqual(ap_bg, LYConst.COLOR_TRANSP) ThenBlock: {
                IfCondition EqualTo(ap_w, 0) ThenBlock: { ap_w = cb_w }
                IfCondition GreaterThan(ap_content_h, 0) ThenBlock: {
                    LY__EmitFillRect(ap_x, ap_y, ap_w, ap_content_h, ap_bg)
                }
            }

            // Restore parent cursor_y — absolute elements don't affect flow
            LYState.cursor_y = sv_cursor_y
            LYState.fg_color = sv_fg
            LYState.bg_color = sv_bg
            LYState.font_scale = sv_sc
            LYState.indent = sv_ind
            LYState.avail_w = sv_aw
            LYState.text_align = sv_ta
            LYState.visible = sv_vis
            LYState.line_height = sv_lh
            LYState.font_size_px = sv_fspx
            LYState.font_w_px = sv_fwpx
            LYState.is_ahem = sv_ahem
            LYFloatState.count = sv_float_count
            LYState.last_margin_b = sv_last_mb
            LYState.cursor_x = sv_ind
            ReturnValue(0)
        }

        // =====================================================================
        // CLEAR PROPERTY — advance past floats
        // =====================================================================
        clear_dir = 0   // 0=none, 1=left, 2=right, 3=both
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            cl_v = CSS_GetPropVal(inline_rule, "clear")
            IfCondition NotEqual(cl_v, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(cl_v, "left"), 0) ThenBlock: { clear_dir = 1 }
                IfCondition EqualTo(StringCompare(cl_v, "right"), 0) ThenBlock: { clear_dir = 2 }
                IfCondition EqualTo(StringCompare(cl_v, "both"), 0) ThenBlock: { clear_dir = 3 }
            }
        }
        IfCondition EqualTo(clear_dir, 0) ThenBlock: {
            cl_css = LY__CSSLookupProp(node, "clear")
            IfCondition NotEqual(cl_css, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(cl_css, "left"), 0) ThenBlock: { clear_dir = 1 }
                IfCondition EqualTo(StringCompare(cl_css, "right"), 0) ThenBlock: { clear_dir = 2 }
                IfCondition EqualTo(StringCompare(cl_css, "both"), 0) ThenBlock: { clear_dir = 3 }
            }
        }
        IfCondition GreaterThan(clear_dir, 0) ThenBlock: {
            // Map clear_dir to LYFloat_ClearY convention: 1=left, 2=right, 0=both
            clear_arg = clear_dir
            IfCondition EqualTo(clear_dir, 3) ThenBlock: { clear_arg = 0 }
            clear_y = LYFloat_ClearY(clear_arg)
            IfCondition GreaterThan(clear_y, LYState.cursor_y) ThenBlock: {
                LYState.cursor_y = clear_y
            }
        }

        // =====================================================================
        // NORMAL BLOCK FLOW (non-floated)
        // =====================================================================

        // Resolve per-side margin and padding from CSS/inline/defaults
        margin_top = LY__ResolveMarginSide(node, tag, 0)
        margin_right = LY__ResolveMarginSide(node, tag, 1)
        margin_bottom = LY__ResolveMarginSide(node, tag, 2)
        margin_left = LY__ResolveMarginSide(node, tag, 3)
        pad_top = LY__ResolvePaddingSide(node, tag, 0)
        pad_right = LY__ResolvePaddingSide(node, tag, 1)
        pad_bottom = LY__ResolvePaddingSide(node, tag, 2)
        pad_left = LY__ResolvePaddingSide(node, tag, 3)

        // Resolve border widths early (needed for box-sizing calculation)
        bdr_top = LY__ResolveBorderWidth(node, 0)
        bdr_right = LY__ResolveBorderWidth(node, 1)
        bdr_bottom = LY__ResolveBorderWidth(node, 2)
        bdr_left = LY__ResolveBorderWidth(node, 3)

        // Resolve box-sizing (default: content-box per CSS spec)
        is_border_box = 0
        bs_val = 0
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            bs_val = CSS_GetPropVal(inline_rule, "box-sizing")
        }
        IfCondition EqualTo(bs_val, 0) ThenBlock: {
            bs_val = LY__CSSLookupProp(node, "box-sizing")
        }
        IfCondition NotEqual(bs_val, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(bs_val, "border-box"), 0) ThenBlock: {
                is_border_box = 1
            }
        }

        heading_sc = LY__HeadingScale(tag)

        // Font-size resolution: heading tag > CSS rule > inherited from parent
        IfCondition GreaterThan(heading_sc, 1) ThenBlock: {
            // Heading tags have fixed scale
            LYState.font_scale = heading_sc
        } ElseBlock: {
            // Check CSS font-size (cached inline style, then stylesheet)
            fs_val = 0
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                fs_val = CSS_GetPropVal(inline_rule, "font-size")
            }
            IfCondition EqualTo(fs_val, 0) ThenBlock: {
                fs_val = LY__CSSLookupProp(node, "font-size")
            }
            IfCondition NotEqual(fs_val, 0) ThenBlock: {
                // font-size: N% means percent of inherited font-size, NOT avail_w
                // Swap avail_w to font_size_px so LY__ParsePx resolves % correctly
                fs_has_pct = StringIndexOf(fs_val, "%")
                IfCondition GreaterEqual(fs_has_pct, 0) ThenBlock: {
                    sv_aw_fs = LYState.avail_w
                    LYState.avail_w = LYState.font_size_px
                    fs_px = LY__ParsePx(fs_val)
                    LYState.avail_w = sv_aw_fs
                } ElseBlock: {
                    fs_px = LY__ParsePx(fs_val)
                }
                IfCondition LessEqual(fs_px, 0) ThenBlock: { fs_px = 16 }
                LYState.font_size_px = fs_px
                IfCondition GreaterEqual(fs_px, 32) ThenBlock: {
                    LYState.font_scale = 3
                } ElseBlock: {
                    IfCondition GreaterEqual(fs_px, 24) ThenBlock: {
                        LYState.font_scale = 2
                    } ElseBlock: {
                        LYState.font_scale = 1
                    }
                }
            }
            // If no CSS font-size found, inherit from parent (LYState.font_scale unchanged)
        }

        // Resolve font-family: detect Ahem test font
        // Ahem glyphs are solid squares, 1em x 1em — every char is font_size_px wide
        ff_val = 0
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            ff_val = CSS_GetPropVal(inline_rule, "font-family")
        }
        IfCondition EqualTo(ff_val, 0) ThenBlock: {
            ff_val = LY__CSSLookupProp(node, "font-family")
        }
        IfCondition NotEqual(ff_val, 0) ThenBlock: {
            // Check if font-family contains "Ahem" (case-sensitive)
            ff_ahem = StringIndexOf(ff_val, "Ahem")
            IfCondition GreaterEqual(ff_ahem, 0) ThenBlock: {
                LYState.is_ahem = 1
                // Ahem: every glyph is a filled square of font_size_px x font_size_px
                LYState.font_w_px = LYState.font_size_px
            }
        }

        // Resolve CSS line-height (cached inline style > stylesheet > inherited)
        lh_val = 0
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            lh_cv = CSS_GetPropVal(inline_rule, "line-height")
            IfCondition NotEqual(lh_cv, 0) ThenBlock: {
                lh_val = LY__ParsePx(lh_cv)
            }
        }
        IfCondition EqualTo(lh_val, 0) ThenBlock: {
            lh_css = LY__CSSLookupProp(node, "line-height")
            IfCondition NotEqual(lh_css, 0) ThenBlock: {
                lh_val = LY__ParsePx(lh_css)
            }
        }
        IfCondition GreaterThan(lh_val, 0) ThenBlock: {
            // Small values (< 10) are unitless multipliers of font height
            // e.g. line-height: 2 means 2x font_h
            IfCondition LessThan(lh_val, 10) ThenBlock: {
                cur_fh = Multiply(LYConst.FONT_H, LYState.font_scale)
                LYState.line_height = Multiply(lh_val, cur_fh)
            } ElseBlock: {
                LYState.line_height = lh_val
            }
        }
        // If no CSS line-height found, inherit from parent (LYState.line_height unchanged)

        // Resolve letter-spacing (cached inline style > stylesheet)
        ls_val = 0
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            ls_cv = CSS_GetPropVal(inline_rule, "letter-spacing")
            IfCondition NotEqual(ls_cv, 0) ThenBlock: {
                ls_val = LY__ParsePx(ls_cv)
            }
        }
        IfCondition EqualTo(ls_val, 0) ThenBlock: {
            ls_css = LY__CSSLookupProp(node, "letter-spacing")
            IfCondition NotEqual(ls_css, 0) ThenBlock: {
                ls_val = LY__ParsePx(ls_css)
            }
        }
        LYState.letter_sp = ls_val

        fg = LY__ResolveFgColor(node)
        LYState.fg_color = fg

        bg = LY__ResolveBgColor(node)

        // Canvas background is white (set by renderer init), so body/html
        // only need explicit bg if CSS sets one — no artificial white default

        // Resolve text-align from cached inline style or CSS rules
        ta_val = 0
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            ta_val = CSS_GetPropVal(inline_rule, "text-align")
        }
        IfCondition EqualTo(ta_val, 0) ThenBlock: {
            ta_val = LY__CSSLookupProp(node, "text-align")
        }
        IfCondition NotEqual(ta_val, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(ta_val, "center"), 0) ThenBlock: {
                LYState.text_align = 1
            }
            IfCondition EqualTo(StringCompare(ta_val, "right"), 0) ThenBlock: {
                LYState.text_align = 2
            }
            IfCondition EqualTo(StringCompare(ta_val, "left"), 0) ThenBlock: {
                LYState.text_align = 0
            }
        }
        // <center> tag implicitly sets text-align: center
        IfCondition NotEqual(tag, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(tag, "center"), 0) ThenBlock: {
                LYState.text_align = 1
            }
        }
        // HTML align attribute (legacy: <div align="center">, <td align="center">)
        align_attr = DOM_GetAttr(node, "align")
        IfCondition NotEqual(align_attr, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(align_attr, "center"), 0) ThenBlock: {
                LYState.text_align = 1
            }
            IfCondition EqualTo(StringCompare(align_attr, "right"), 0) ThenBlock: {
                LYState.text_align = 2
            }
        }

        // Resolve width/max-width constraints + margin:auto centering
        // w_explicit = 1 means a numeric width was set (not "auto")
        blk_constrained = 0
        w_val = 0
        w_explicit = 0
        mw_val = 0
        w_raw = 0
        // Check cached inline style
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            w_raw = CSS_GetPropVal(inline_rule, "width")
            mw_cv = CSS_GetPropVal(inline_rule, "max-width")
            IfCondition NotEqual(mw_cv, 0) ThenBlock: {
                mw_val = LY__ParsePx(mw_cv)
            }
        }
        // Check CSS rules
        IfCondition EqualTo(w_raw, 0) ThenBlock: {
            w_raw = LY__CSSLookupProp(node, "width")
        }
        // Logical property: inline-size → width (LTR)
        IfCondition EqualTo(w_raw, 0) ThenBlock: {
            w_raw = LY__CSSLookupProp(node, "inline-size")
        }
        // Determine if width is explicitly numeric (not auto/inherit/initial/unset)
        IfCondition NotEqual(w_raw, 0) ThenBlock: {
            w_fb = GetByte(w_raw, 0)
            w_is_kw = 0
            IfCondition EqualTo(w_fb, 97) ThenBlock: { w_is_kw = 1 }
            IfCondition EqualTo(w_fb, 105) ThenBlock: { w_is_kw = 1 }
            IfCondition EqualTo(w_fb, 117) ThenBlock: { w_is_kw = 1 }
            IfCondition EqualTo(w_is_kw, 0) ThenBlock: {
                w_val = LY__ParsePx(w_raw)
                w_explicit = 1
            }
        }
        IfCondition EqualTo(mw_val, 0) ThenBlock: {
            mw_css = LY__CSSLookupProp(node, "max-width")
            IfCondition NotEqual(mw_css, 0) ThenBlock: {
                mw_val = LY__ParsePx(mw_css)
            }
        }
        // Logical property: max-inline-size → max-width
        IfCondition EqualTo(mw_val, 0) ThenBlock: {
            mw_is = LY__CSSLookupProp(node, "max-inline-size")
            IfCondition NotEqual(mw_is, 0) ThenBlock: {
                mw_val = LY__ParsePx(mw_is)
            }
        }
        // Apply width constraint — always apply explicit width (CSS overflow is valid)
        IfCondition EqualTo(w_explicit, 1) ThenBlock: {
            blk_constrained = 1
            IfCondition EqualTo(is_border_box, 1) ThenBlock: {
                // border-box: w_val includes padding+border
                // padding+border will be subtracted later, leaving content area
                LYState.avail_w = w_val
            }
            IfCondition EqualTo(is_border_box, 0) ThenBlock: {
                // content-box: w_val IS the content area
                // Pre-add padding+border so after subtraction, content = w_val
                LYState.avail_w = Add(w_val, Add(pad_left, Add(pad_right, Add(bdr_left, bdr_right))))
            }
        }
        // max-width is a ceiling — only constrains if smaller
        IfCondition GreaterThan(mw_val, 0) ThenBlock: {
            IfCondition LessThan(mw_val, LYState.avail_w) ThenBlock: {
                blk_constrained = 1
                LYState.avail_w = mw_val
            }
        }
        // min-width is a floor — only constrains if larger
        minw_val = 0
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            minw_cv = CSS_GetPropVal(inline_rule, "min-width")
            IfCondition NotEqual(minw_cv, 0) ThenBlock: {
                minw_val = LY__ParsePx(minw_cv)
            }
        }
        IfCondition EqualTo(minw_val, 0) ThenBlock: {
            minw_css = LY__CSSLookupProp(node, "min-width")
            IfCondition NotEqual(minw_css, 0) ThenBlock: {
                minw_val = LY__ParsePx(minw_css)
            }
        }
        // Logical: min-inline-size → min-width
        IfCondition EqualTo(minw_val, 0) ThenBlock: {
            minw_is = LY__CSSLookupProp(node, "min-inline-size")
            IfCondition NotEqual(minw_is, 0) ThenBlock: {
                minw_val = LY__ParsePx(minw_is)
            }
        }
        IfCondition GreaterThan(minw_val, 0) ThenBlock: {
            IfCondition GreaterThan(minw_val, LYState.avail_w) ThenBlock: {
                blk_constrained = 1
                LYState.avail_w = minw_val
            }
        }
        // Check margin:auto (center the block)
        IfCondition EqualTo(blk_constrained, 1) ThenBlock: {
            m_auto = 0
            // Check cached inline margin
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                ma_v = CSS_GetPropVal(inline_rule, "margin")
                IfCondition NotEqual(ma_v, 0) ThenBlock: {
                    IfCondition GreaterEqual(StringIndexOf(ma_v, "auto"), 0) ThenBlock: {
                        m_auto = 1
                    }
                }
            }
            // Check CSS rules for margin shorthand
            IfCondition EqualTo(m_auto, 0) ThenBlock: {
                m_css = LY__CSSLookupProp(node, "margin")
                IfCondition NotEqual(m_css, 0) ThenBlock: {
                    IfCondition GreaterEqual(StringIndexOf(m_css, "auto"), 0) ThenBlock: {
                        m_auto = 1
                    }
                }
            }
            // Also check individual margin-left/margin-right for "auto"
            IfCondition EqualTo(m_auto, 0) ThenBlock: {
                ml_raw = 0
                mr_raw = 0
                IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                    ml_raw = CSS_GetPropVal(inline_rule, "margin-left")
                    mr_raw = CSS_GetPropVal(inline_rule, "margin-right")
                }
                IfCondition EqualTo(ml_raw, 0) ThenBlock: {
                    ml_raw = LY__CSSLookupProp(node, "margin-left")
                }
                IfCondition EqualTo(mr_raw, 0) ThenBlock: {
                    mr_raw = LY__CSSLookupProp(node, "margin-right")
                }
                ml_is_auto = 0
                mr_is_auto = 0
                IfCondition NotEqual(ml_raw, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(ml_raw, "auto"), 0) ThenBlock: {
                        ml_is_auto = 1
                    }
                }
                IfCondition NotEqual(mr_raw, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(mr_raw, "auto"), 0) ThenBlock: {
                        mr_is_auto = 1
                    }
                }
                IfCondition And(EqualTo(ml_is_auto, 1), EqualTo(mr_is_auto, 1)) ThenBlock: {
                    m_auto = 1
                }
            }
            // Apply centering
            IfCondition EqualTo(m_auto, 1) ThenBlock: {
                extra = Subtract(sv_aw, LYState.avail_w)
                IfCondition GreaterThan(extra, 0) ThenBlock: {
                    LYState.indent = Add(LYState.indent, Divide(extra, 2))
                }
            }
        }

        // Apply margin-top with collapsing against previous sibling's margin-bottom
        // CSS spec: adjacent vertical margins collapse to max(prev_bottom, this_top)
        // last_margin_b was already added to cursor_y by the previous sibling,
        // so we add only the difference if this margin is larger
        IfCondition GreaterThan(margin_top, LYState.last_margin_b) ThenBlock: {
            LYState.cursor_y = Add(LYState.cursor_y, Subtract(margin_top, LYState.last_margin_b))
        }
        LYState.last_margin_b = 0
        IfCondition GreaterThan(margin_left, 0) ThenBlock: {
            LYState.indent = Add(LYState.indent, margin_left)
            LYState.avail_w = Subtract(LYState.avail_w, margin_left)
        }
        IfCondition GreaterThan(margin_right, 0) ThenBlock: {
            LYState.avail_w = Subtract(LYState.avail_w, margin_right)
        }

        // Resolve CSS height (explicit height on block element)
        // h_explicit = 1 means a numeric height was set (not "auto")
        h_val = 0
        h_explicit = 0
        h_raw = 0
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            h_raw = CSS_GetPropVal(inline_rule, "height")
        }
        IfCondition EqualTo(h_raw, 0) ThenBlock: {
            h_raw = LY__CSSLookupProp(node, "height")
        }
        IfCondition EqualTo(h_raw, 0) ThenBlock: {
            h_raw = LY__CSSLookupProp(node, "block-size")
        }
        IfCondition NotEqual(h_raw, 0) ThenBlock: {
            // Check first byte: skip non-numeric keywords (auto/inherit/initial/unset)
            h_fb = GetByte(h_raw, 0)
            h_is_kw = 0
            IfCondition EqualTo(h_fb, 97) ThenBlock: { h_is_kw = 1 }
            IfCondition EqualTo(h_fb, 105) ThenBlock: { h_is_kw = 1 }
            IfCondition EqualTo(h_fb, 117) ThenBlock: { h_is_kw = 1 }
            IfCondition EqualTo(h_is_kw, 0) ThenBlock: {
                h_val = LY__ParsePx(h_raw)
                h_explicit = 1
            }
        }
        // Also check min-height (cached inline style, then stylesheet)
        minh_val = 0
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            minh_cv = CSS_GetPropVal(inline_rule, "min-height")
            IfCondition NotEqual(minh_cv, 0) ThenBlock: {
                minh_val = LY__ParsePx(minh_cv)
            }
        }
        IfCondition EqualTo(minh_val, 0) ThenBlock: {
            minh_css = LY__CSSLookupProp(node, "min-height")
            IfCondition NotEqual(minh_css, 0) ThenBlock: {
                minh_val = LY__ParsePx(minh_css)
            }
        }
        // Logical property: min-block-size → min-height
        IfCondition EqualTo(minh_val, 0) ThenBlock: {
            minh_bs = LY__CSSLookupProp(node, "min-block-size")
            IfCondition NotEqual(minh_bs, 0) ThenBlock: {
                minh_val = LY__ParsePx(minh_bs)
            }
        }
        // Also check max-height (ceiling on block height)
        maxh_val = 0
        IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
            maxh_cv = CSS_GetPropVal(inline_rule, "max-height")
            IfCondition NotEqual(maxh_cv, 0) ThenBlock: {
                maxh_val = LY__ParsePx(maxh_cv)
            }
        }
        IfCondition EqualTo(maxh_val, 0) ThenBlock: {
            maxh_css = LY__CSSLookupProp(node, "max-height")
            IfCondition NotEqual(maxh_css, 0) ThenBlock: {
                maxh_val = LY__ParsePx(maxh_css)
            }
        }
        // Logical property: max-block-size → max-height
        IfCondition EqualTo(maxh_val, 0) ThenBlock: {
            maxh_bs = LY__CSSLookupProp(node, "max-block-size")
            IfCondition NotEqual(maxh_bs, 0) ThenBlock: {
                maxh_val = LY__ParsePx(maxh_bs)
            }
        }

        // (border widths already resolved above for box-sizing calculation)

        // Save border-box start position (after margin, before border)
        border_start_y = LYState.cursor_y
        border_start_x = LYState.indent

        // Apply border + padding — per-side indent and avail width
        IfCondition GreaterThan(bdr_left, 0) ThenBlock: {
            LYState.indent = Add(LYState.indent, bdr_left)
            LYState.avail_w = Subtract(LYState.avail_w, bdr_left)
        }
        IfCondition GreaterThan(bdr_right, 0) ThenBlock: {
            LYState.avail_w = Subtract(LYState.avail_w, bdr_right)
        }
        IfCondition GreaterThan(bdr_top, 0) ThenBlock: {
            LYState.cursor_y = Add(LYState.cursor_y, bdr_top)
        }
        IfCondition GreaterThan(pad_left, 0) ThenBlock: {
            LYState.indent = Add(LYState.indent, pad_left)
            LYState.avail_w = Subtract(LYState.avail_w, pad_left)
        }
        IfCondition GreaterThan(pad_right, 0) ThenBlock: {
            LYState.avail_w = Subtract(LYState.avail_w, pad_right)
        }
        IfCondition GreaterThan(pad_top, 0) ThenBlock: {
            LYState.cursor_y = Add(LYState.cursor_y, pad_top)
        }
        // If avail_w has gone to zero or negative from nested padding/margin/border,
        // skip children (text wraps to 1 char per line otherwise) but still emit
        // borders/background for this element.
        skip_children = 0
        IfCondition LessThan(LYState.avail_w, 16) ThenBlock: {
            skip_children = 1
        }

        // Save content start Y for background rect
        block_start_y = LYState.cursor_y
        // Reset cursor_x for inline text flow within this block
        LYState.cursor_x = LYState.indent
        // Fresh margin-collapsing context for children
        LYState.last_margin_b = 0

        // If this element is position:relative, it becomes the containing block
        // for position:absolute children. Save old CB and set new one.
        sv_cb_x = LYState.cb_x
        sv_cb_y = LYState.cb_y
        sv_cb_w = LYState.cb_w
        IfCondition NotEqual(pos_css, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(pos_css, "relative"), 0) ThenBlock: {
                LYState.cb_x = LYState.indent
                LYState.cb_y = block_start_y
                LYState.cb_w = LYState.avail_w
            }
        }

        // Special: <hr> draws a line
        IfCondition NotEqual(tag, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(tag, "hr"), 0) ThenBlock: {
                LY__EmitDrawLine(LYState.indent, LYState.cursor_y, LYState.avail_w, LYConst.COLOR_GRAY)
                LYState.cursor_y = Add(LYState.cursor_y, 2)
            }
        }

        // Check if this is a flex container
        is_flex = 0
        IfCondition NotEqual(css_disp, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(css_disp, "flex"), 0) ThenBlock: {
                is_flex = 1
            }
            IfCondition EqualTo(StringCompare(css_disp, "inline-flex"), 0) ThenBlock: {
                is_flex = 1
            }
        }
        // Also check cached inline style for display:flex
        IfCondition EqualTo(is_flex, 0) ThenBlock: {
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                fl_dv = CSS_GetPropVal(inline_rule, "display")
                IfCondition NotEqual(fl_dv, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(fl_dv, "flex"), 0) ThenBlock: {
                        is_flex = 1
                    }
                    IfCondition EqualTo(StringCompare(fl_dv, "inline-flex"), 0) ThenBlock: {
                        is_flex = 1
                    }
                }
            }
        }

        // Check if this is a grid container
        is_grid = 0
        IfCondition NotEqual(css_disp, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(css_disp, "grid"), 0) ThenBlock: {
                is_grid = 1
            }
            IfCondition EqualTo(StringCompare(css_disp, "inline-grid"), 0) ThenBlock: {
                is_grid = 1
            }
        }
        // Also check cached inline style for display:grid
        IfCondition EqualTo(is_grid, 0) ThenBlock: {
            IfCondition GreaterEqual(inline_rule, 0) ThenBlock: {
                gd_dv = CSS_GetPropVal(inline_rule, "display")
                IfCondition NotEqual(gd_dv, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(gd_dv, "grid"), 0) ThenBlock: {
                        is_grid = 1
                    }
                    IfCondition EqualTo(StringCompare(gd_dv, "inline-grid"), 0) ThenBlock: {
                        is_grid = 1
                    }
                }
            }
        }

        // Process children — grid, flex, or normal flow
        // Skip if content area is too narrow for any content (< 1 char width)
        IfCondition EqualTo(skip_children, 0) ThenBlock: {
            IfCondition EqualTo(is_grid, 1) ThenBlock: {
                LY__GridLayout(node)
            }
            IfCondition EqualTo(is_grid, 0) ThenBlock: {
                IfCondition EqualTo(is_flex, 1) ThenBlock: {
                    LY__FlexLayout(node)
                }
                IfCondition EqualTo(is_flex, 0) ThenBlock: {
                    // Normal block flow — get next sibling BEFORE recursing
                    bc = DOM_GetFirstChild(node)
                    WhileLoop GreaterEqual(bc, 0) {
                        next_bc = DOM_GetNextSib(bc)
                        LY__LayoutNode(bc)
                        bc = next_bc
                    }
                }
            }
        }

        // Flush trailing inline content on the current line
        IfCondition GreaterThan(LYState.cursor_x, LYState.indent) ThenBlock: {
            end_fh = LY__LineHeight()
            LYState.cursor_y = Add(LYState.cursor_y, end_fh)
            LYState.cursor_x = LYState.indent
        }

        // Float containment — if this block has child floats, expand to contain them
        // This implements BFC (Block Formatting Context) behavior:
        // blocks with overflow != visible, or floats, or flex, auto-contain floats.
        // For simplicity, we do this for ALL blocks that have child floats,
        // which is slightly incorrect per spec but works for most real-world sites.
        IfCondition GreaterThan(LYFloatState.count, sv_float_count) ThenBlock: {
            fci = sv_float_count
            WhileLoop LessThan(fci, LYFloatState.count) {
                fc_off = Multiply(fci, LYFloatState.ENTRY_SIZE)
                fc_base = Add(LYFloatState.pool, fc_off)
                fc_fy = Dereference(Add(fc_base, LYFloatState.F_Y))
                fc_fh = Dereference(Add(fc_base, LYFloatState.F_H))
                fc_bot = Add(fc_fy, fc_fh)
                IfCondition GreaterThan(fc_bot, LYState.cursor_y) ThenBlock: {
                    LYState.cursor_y = fc_bot
                }
                fci = Add(fci, 1)
            }
        }

        // Compute content height — use explicit CSS height if set
        content_h = Subtract(LYState.cursor_y, block_start_y)

        // EMPTY BLOCK COLLAPSE — if this block produced zero visible content
        // and has no explicit height/min-height, undo all spacing and bail.
        // This prevents empty wrapper divs (all children display:none) from
        // creating massive vertical gaps with their padding+margin.
        IfCondition EqualTo(content_h, 0) ThenBlock: {
            IfCondition EqualTo(h_val, 0) ThenBlock: {
                IfCondition EqualTo(minh_val, 0) ThenBlock: {
                    IfCondition EqualTo(Add(Add(bdr_top, bdr_bottom), Add(bdr_left, bdr_right)), 0) ThenBlock: {
                        IfCondition EqualTo(bg, LYConst.COLOR_TRANSP) ThenBlock: {
                            // Nothing to show — rewind cursor to before this block's margin+padding
                            LYState.cursor_y = sv_cursor_y
                            // Restore parent state and return
                            LYState.fg_color = sv_fg
                            LYState.bg_color = sv_bg
                            LYState.font_scale = sv_sc
                            LYState.indent = sv_ind
                            LYState.avail_w = sv_aw
                            LYState.text_align = sv_ta
                            LYState.visible = sv_vis
                            LYState.line_height = sv_lh
                            LYState.font_size_px = sv_fspx
                            LYState.font_w_px = sv_fwpx
                            LYState.is_ahem = sv_ahem
                            LYFloatState.count = sv_float_count
                            LYState.last_margin_b = sv_last_mb
                            LYState.cursor_x = sv_ind
                            ReturnValue(0)
                        }
                    }
                }
            }
        }

        // Explicit height: override content height (both grow AND shrink)
        IfCondition EqualTo(h_explicit, 1) ThenBlock: {
            content_h = h_val
            LYState.cursor_y = Add(block_start_y, h_val)
        }
        IfCondition GreaterThan(minh_val, 0) ThenBlock: {
            // Min-height: ensure at least this tall
            IfCondition GreaterThan(minh_val, content_h) ThenBlock: {
                content_h = minh_val
                LYState.cursor_y = Add(block_start_y, minh_val)
            }
        }
        // Max-height: ceiling on block height (applied after h_val and minh_val)
        IfCondition GreaterThan(maxh_val, 0) ThenBlock: {
            IfCondition GreaterThan(content_h, maxh_val) ThenBlock: {
                content_h = maxh_val
                LYState.cursor_y = Add(block_start_y, maxh_val)
            }
        }

        // Emit background rect now that we know height
        // CSS spec: background covers the padding box (content + padding)
        // Skip for grid containers — LY__GridLayout emits its own background
        block_x = Subtract(LYState.indent, pad_left)
        block_w = Add(LYState.avail_w, Add(pad_left, pad_right))
        bg_y = Subtract(block_start_y, pad_top)
        bg_h = Add(content_h, Add(pad_top, pad_bottom))
        IfCondition NotEqual(bg, LYConst.COLOR_TRANSP) ThenBlock: {
            IfCondition EqualTo(is_grid, 0) ThenBlock: {
                IfCondition GreaterThan(bg_h, 0) ThenBlock: {
                    // CSS spec: html bg always propagates to canvas; body bg
                    // propagates only if html has no background
                    is_canvas_bg = 0
                    IfCondition NotEqual(tag, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(tag, "html"), 0) ThenBlock: { is_canvas_bg = 1 }
                        IfCondition EqualTo(StringCompare(tag, "body"), 0) ThenBlock: {
                            // Body propagates only if html parent had no bg
                            html_node = DOM_GetParent(node)
                            html_bg = 0
                            IfCondition GreaterEqual(html_node, 0) ThenBlock: {
                                html_bg = LY__ResolveBgColor(html_node)
                            }
                            IfCondition EqualTo(html_bg, LYConst.COLOR_TRANSP) ThenBlock: {
                                is_canvas_bg = 1
                            }
                        }
                    }
                    IfCondition EqualTo(is_canvas_bg, 1) ThenBlock: {
                        LY__EmitFillRect(0, 0, LYState.viewport_w, LYState.viewport_h, bg)
                    } ElseBlock: {
                        LY__EmitFillRect(block_x, bg_y, block_w, bg_h, bg)
                    }
                }
            }
        }

        // Apply padding-bottom
        IfCondition GreaterThan(pad_bottom, 0) ThenBlock: {
            LYState.cursor_y = Add(LYState.cursor_y, pad_bottom)
        }

        // Emit border rects (4 thin FILL_RECTs around the border-box)
        // Use flag instead of Or(GreaterThan, Or(GreaterThan, ...)) assignment
        has_border = 0
        IfCondition GreaterThan(bdr_top, 0) ThenBlock: { has_border = 1 }
        IfCondition GreaterThan(bdr_right, 0) ThenBlock: { has_border = 1 }
        IfCondition GreaterThan(bdr_bottom, 0) ThenBlock: { has_border = 1 }
        IfCondition GreaterThan(bdr_left, 0) ThenBlock: { has_border = 1 }
        IfCondition EqualTo(has_border, 1) ThenBlock: {
            // Compute border-box dimensions
            bdr_box_x = border_start_x
            bdr_box_y = border_start_y
            bdr_box_w = Add(LYState.avail_w, Add(pad_left, Add(pad_right, Add(bdr_left, bdr_right))))
            bdr_box_h = Add(Subtract(LYState.cursor_y, border_start_y), bdr_bottom)

            // Resolve border color (default to currentColor / fg)
            bdr_color = LY__ResolveBorderColor(node, 0)
            IfCondition EqualTo(bdr_color, 0) ThenBlock: {
                bdr_color = fg
            }

            // Top border
            IfCondition GreaterThan(bdr_top, 0) ThenBlock: {
                LY__EmitFillRect(bdr_box_x, bdr_box_y, bdr_box_w, bdr_top, bdr_color)
            }
            // Bottom border
            IfCondition GreaterThan(bdr_bottom, 0) ThenBlock: {
                LY__EmitFillRect(bdr_box_x, Add(bdr_box_y, Subtract(bdr_box_h, bdr_bottom)), bdr_box_w, bdr_bottom, bdr_color)
            }
            // Left border
            IfCondition GreaterThan(bdr_left, 0) ThenBlock: {
                LY__EmitFillRect(bdr_box_x, bdr_box_y, bdr_left, bdr_box_h, bdr_color)
            }
            // Right border
            IfCondition GreaterThan(bdr_right, 0) ThenBlock: {
                LY__EmitFillRect(Add(bdr_box_x, Subtract(bdr_box_w, bdr_right)), bdr_box_y, bdr_right, bdr_box_h, bdr_color)
            }
        }

        // Apply border-bottom to cursor
        IfCondition GreaterThan(bdr_bottom, 0) ThenBlock: {
            LYState.cursor_y = Add(LYState.cursor_y, bdr_bottom)
        }

        // Apply margin-bottom — store for collapsing with next sibling's margin-top
        LYState.cursor_y = Add(LYState.cursor_y, margin_bottom)
        LYState.last_margin_b = margin_bottom

        // Restore parent state from stack locals
        LYState.fg_color = sv_fg
        LYState.bg_color = sv_bg
        LYState.font_scale = sv_sc
        LYState.indent = sv_ind
        LYState.avail_w = sv_aw
        LYState.text_align = sv_ta
        LYState.visible = sv_vis
        LYState.line_height = sv_lh
        LYState.font_size_px = sv_fspx
        LYState.font_w_px = sv_fwpx
        LYState.is_ahem = sv_ahem
        LYState.letter_sp = sv_ls
        LYFloatState.count = sv_float_count
        LYState.cb_x = sv_cb_x
        LYState.cb_y = sv_cb_y
        LYState.cb_w = sv_cb_w
        LYState.cursor_x = sv_ind
        ReturnValue(0)
    }
}
