// Library.HTMLLayoutUnits.ailang — CSS value parsing and box shorthand resolution
// ParsePx (px/em/rem/vw/vh/%), HexDigit, HexPair, HeadingScale, ParseBoxShorthand.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.Browser.CSSParse

// =============================================================================
// HEADING SCALE — returns font scale for heading tags
// =============================================================================
Function.LY__HeadingScale {
    Input: tag: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tag, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(tag, "h1"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(tag, "h2"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(tag, "h3"), 0) ThenBlock: { ReturnValue(2) }
        ReturnValue(1)
    }
}

// =============================================================================
// HEX DIGIT / HEX PAIR — used by color parsing
// =============================================================================
Function.LY__HexDigit {
    Input: str: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        c = GetByte(str, pos)
        // 0-9
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
            ReturnValue(Subtract(c, 48))
        }
        // a-f
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 102)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 97), 10))
        }
        // A-F
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 70)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 65), 10))
        }
        ReturnValue(0)
    }
}

Function.LY__HexPair {
    Input: str: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        hi = LY__HexDigit(str, pos)
        lo = LY__HexDigit(str, Add(pos, 1))
        ReturnValue(Add(Multiply(hi, 16), lo))
    }
}

// =============================================================================
// CSS calc() EVALUATION — parse calc(expr), min(), max(), clamp()
// Supports: +, -, *, /, nested parens, px/em/rem/vw/vh/% operands
// =============================================================================
Function.LY__CalcEval {
    Input: str: Address
    Input: start: Integer
    Input: end: Integer
    Output: Integer
    Body: {
        // Two-pass left-to-right evaluation:
        // Pass 1: collect operands and operators
        // Pass 2: evaluate respecting * / before + -
        // Uses x1000 fixed-point for precision
        //
        // Operands stored in op0..op7 (x1000), operators in ot0..ot7
        // This handles: calc(100% - 20px), calc(2 * 3em + 5px)
        op0 = 0
        op1 = 0
        op2 = 0
        op3 = 0
        op4 = 0
        op5 = 0
        op6 = 0
        op7 = 0
        ot0 = 0
        ot1 = 0
        ot2 = 0
        ot3 = 0
        ot4 = 0
        ot5 = 0
        ot6 = 0
        num_ops = 0
        num_ots = 0

        ci = start
        // Skip whitespace
        WhileLoop LessThan(ci, end) {
            cc = GetByte(str, ci)
            IfCondition And(NotEqual(cc, 32), NotEqual(cc, 9)) ThenBlock: { BreakLoop }
            ci = Add(ci, 1)
        }

        // Parse operands and operators
        calc_done = 0
        WhileLoop And(LessThan(ci, end), EqualTo(calc_done, 0)) {
            cc = GetByte(str, ci)
            // Skip whitespace
            IfCondition Or(EqualTo(cc, 32), EqualTo(cc, 9)) ThenBlock: {
                ci = Add(ci, 1)
            }
            IfCondition And(NotEqual(cc, 32), NotEqual(cc, 9)) ThenBlock: {
                // Check for nested calc( or parens
                IfCondition EqualTo(cc, 40) ThenBlock: {
                    // '(' — find matching ')'
                    pdepth = 1
                    pstart = Add(ci, 1)
                    ci = Add(ci, 1)
                    WhileLoop And(LessThan(ci, end), GreaterThan(pdepth, 0)) {
                        pc = GetByte(str, ci)
                        IfCondition EqualTo(pc, 40) ThenBlock: { pdepth = Add(pdepth, 1) }
                        IfCondition EqualTo(pc, 41) ThenBlock: { pdepth = Subtract(pdepth, 1) }
                        IfCondition GreaterThan(pdepth, 0) ThenBlock: { ci = Add(ci, 1) }
                    }
                    // Recursively evaluate inner expression
                    sub_val = LY__CalcEval(str, pstart, ci)
                    ci = Add(ci, 1) // skip ')'
                    // Store as operand (already in px, convert to x1000)
                    IfCondition EqualTo(num_ops, 0) ThenBlock: { op0 = Multiply(sub_val, 1000) }
                    IfCondition EqualTo(num_ops, 1) ThenBlock: { op1 = Multiply(sub_val, 1000) }
                    IfCondition EqualTo(num_ops, 2) ThenBlock: { op2 = Multiply(sub_val, 1000) }
                    IfCondition EqualTo(num_ops, 3) ThenBlock: { op3 = Multiply(sub_val, 1000) }
                    IfCondition EqualTo(num_ops, 4) ThenBlock: { op4 = Multiply(sub_val, 1000) }
                    IfCondition EqualTo(num_ops, 5) ThenBlock: { op5 = Multiply(sub_val, 1000) }
                    IfCondition EqualTo(num_ops, 6) ThenBlock: { op6 = Multiply(sub_val, 1000) }
                    IfCondition EqualTo(num_ops, 7) ThenBlock: { op7 = Multiply(sub_val, 1000) }
                    num_ops = Add(num_ops, 1)
                }

                // Check for operator: + - * /
                // + (43) and - (45) are operators only if preceded by an operand
                // and followed by whitespace (to distinguish from negative numbers)
                is_op = 0
                IfCondition And(EqualTo(cc, 43), GreaterThan(num_ops, num_ots)) ThenBlock: { is_op = 43 }
                IfCondition And(EqualTo(cc, 42), GreaterThan(num_ops, num_ots)) ThenBlock: { is_op = 42 }
                IfCondition And(EqualTo(cc, 47), GreaterThan(num_ops, num_ots)) ThenBlock: { is_op = 47 }
                // Minus: only operator if we already have more operands than operators
                IfCondition EqualTo(cc, 45) ThenBlock: {
                    IfCondition GreaterThan(num_ops, num_ots) ThenBlock: {
                        // Check if preceded by whitespace (CSS requires it for calc operators)
                        IfCondition GreaterThan(ci, start) ThenBlock: {
                            prev_c = GetByte(str, Subtract(ci, 1))
                            IfCondition EqualTo(prev_c, 32) ThenBlock: { is_op = 45 }
                        }
                    }
                }

                IfCondition GreaterThan(is_op, 0) ThenBlock: {
                    IfCondition EqualTo(num_ots, 0) ThenBlock: { ot0 = is_op }
                    IfCondition EqualTo(num_ots, 1) ThenBlock: { ot1 = is_op }
                    IfCondition EqualTo(num_ots, 2) ThenBlock: { ot2 = is_op }
                    IfCondition EqualTo(num_ots, 3) ThenBlock: { ot3 = is_op }
                    IfCondition EqualTo(num_ots, 4) ThenBlock: { ot4 = is_op }
                    IfCondition EqualTo(num_ots, 5) ThenBlock: { ot5 = is_op }
                    IfCondition EqualTo(num_ots, 6) ThenBlock: { ot6 = is_op }
                    num_ots = Add(num_ots, 1)
                    ci = Add(ci, 1)
                }

                // Otherwise parse a value operand (digit, '.', '-' as negative, or letter for units)
                IfCondition EqualTo(is_op, 0) ThenBlock: {
                    IfCondition NotEqual(cc, 40) ThenBlock: {
                        // Check if this looks like a value start
                        is_val = 0
                        IfCondition And(GreaterEqual(cc, 48), LessEqual(cc, 57)) ThenBlock: { is_val = 1 }
                        IfCondition EqualTo(cc, 46) ThenBlock: { is_val = 1 }
                        IfCondition EqualTo(cc, 45) ThenBlock: { is_val = 1 }
                        IfCondition EqualTo(is_val, 1) ThenBlock: {
                            // Extract substring from ci to next whitespace/operator/paren/end
                            // Use LY__ParsePx on this substring
                            // We need a null-terminated copy
                            vstart = ci
                            WhileLoop LessThan(ci, end) {
                                vc = GetByte(str, ci)
                                vc_stop = 0
                                IfCondition EqualTo(vc, 32) ThenBlock: { vc_stop = 1 }
                                IfCondition EqualTo(vc, 9) ThenBlock: { vc_stop = 1 }
                                IfCondition EqualTo(vc, 41) ThenBlock: { vc_stop = 1 }
                                IfCondition EqualTo(vc, 44) ThenBlock: { vc_stop = 1 }
                                IfCondition EqualTo(vc_stop, 1) ThenBlock: { BreakLoop }
                                ci = Add(ci, 1)
                            }
                            vlen = Subtract(ci, vstart)
                            IfCondition GreaterThan(vlen, 0) ThenBlock: {
                                // Make null-terminated copy for LY__ParsePx
                                vcopy = Allocate(Add(vlen, 1))
                                MemoryCopy(vcopy, Add(str, vstart), vlen)
                                SetByte(vcopy, vlen, 0)
                                pxv = LY__ParsePx(vcopy)
                                Deallocate(vcopy, Add(vlen, 1))
                                // Store in x1000
                                IfCondition EqualTo(num_ops, 0) ThenBlock: { op0 = Multiply(pxv, 1000) }
                                IfCondition EqualTo(num_ops, 1) ThenBlock: { op1 = Multiply(pxv, 1000) }
                                IfCondition EqualTo(num_ops, 2) ThenBlock: { op2 = Multiply(pxv, 1000) }
                                IfCondition EqualTo(num_ops, 3) ThenBlock: { op3 = Multiply(pxv, 1000) }
                                IfCondition EqualTo(num_ops, 4) ThenBlock: { op4 = Multiply(pxv, 1000) }
                                IfCondition EqualTo(num_ops, 5) ThenBlock: { op5 = Multiply(pxv, 1000) }
                                IfCondition EqualTo(num_ops, 6) ThenBlock: { op6 = Multiply(pxv, 1000) }
                                IfCondition EqualTo(num_ops, 7) ThenBlock: { op7 = Multiply(pxv, 1000) }
                                num_ops = Add(num_ops, 1)
                            }
                        }
                        // Skip unrecognized chars (like 'c','a','l' from calc prefix)
                        IfCondition EqualTo(is_val, 0) ThenBlock: {
                            ci = Add(ci, 1)
                        }
                    }
                }
            }
            IfCondition GreaterEqual(num_ops, 8) ThenBlock: { calc_done = 1 }
        }

        // Now evaluate: first handle * and / (higher precedence)
        // Then handle + and -
        // Pass 1: * and /
        ei = 0
        WhileLoop LessThan(ei, num_ots) {
            eop = 0
            IfCondition EqualTo(ei, 0) ThenBlock: { eop = ot0 }
            IfCondition EqualTo(ei, 1) ThenBlock: { eop = ot1 }
            IfCondition EqualTo(ei, 2) ThenBlock: { eop = ot2 }
            IfCondition EqualTo(ei, 3) ThenBlock: { eop = ot3 }
            IfCondition EqualTo(ei, 4) ThenBlock: { eop = ot4 }
            IfCondition EqualTo(ei, 5) ThenBlock: { eop = ot5 }
            IfCondition EqualTo(ei, 6) ThenBlock: { eop = ot6 }

            // Get left operand
            lv = 0
            IfCondition EqualTo(ei, 0) ThenBlock: { lv = op0 }
            IfCondition EqualTo(ei, 1) ThenBlock: { lv = op1 }
            IfCondition EqualTo(ei, 2) ThenBlock: { lv = op2 }
            IfCondition EqualTo(ei, 3) ThenBlock: { lv = op3 }
            IfCondition EqualTo(ei, 4) ThenBlock: { lv = op4 }
            IfCondition EqualTo(ei, 5) ThenBlock: { lv = op5 }
            IfCondition EqualTo(ei, 6) ThenBlock: { lv = op6 }

            // Get right operand
            ri = Add(ei, 1)
            rv = 0
            IfCondition EqualTo(ri, 1) ThenBlock: { rv = op1 }
            IfCondition EqualTo(ri, 2) ThenBlock: { rv = op2 }
            IfCondition EqualTo(ri, 3) ThenBlock: { rv = op3 }
            IfCondition EqualTo(ri, 4) ThenBlock: { rv = op4 }
            IfCondition EqualTo(ri, 5) ThenBlock: { rv = op5 }
            IfCondition EqualTo(ri, 6) ThenBlock: { rv = op6 }
            IfCondition EqualTo(ri, 7) ThenBlock: { rv = op7 }

            is_muldiv = 0
            IfCondition EqualTo(eop, 42) ThenBlock: { is_muldiv = 1 }
            IfCondition EqualTo(eop, 47) ThenBlock: { is_muldiv = 1 }

            IfCondition EqualTo(is_muldiv, 1) ThenBlock: {
                res = 0
                IfCondition EqualTo(eop, 42) ThenBlock: {
                    // Multiply: (lv * rv) / 1000  (both are x1000)
                    res = Divide(Multiply(lv, rv), 1000)
                }
                IfCondition EqualTo(eop, 47) ThenBlock: {
                    // Divide: (lv * 1000) / rv
                    IfCondition NotEqual(rv, 0) ThenBlock: {
                        res = Divide(Multiply(lv, 1000), rv)
                    }
                }
                // Store result back into left operand slot, mark operator as done (0)
                IfCondition EqualTo(ei, 0) ThenBlock: { op0 = res  ot0 = 0 }
                IfCondition EqualTo(ei, 1) ThenBlock: { op1 = res  ot1 = 0 }
                IfCondition EqualTo(ei, 2) ThenBlock: { op2 = res  ot2 = 0 }
                IfCondition EqualTo(ei, 3) ThenBlock: { op3 = res  ot3 = 0 }
                IfCondition EqualTo(ei, 4) ThenBlock: { op4 = res  ot4 = 0 }
                IfCondition EqualTo(ei, 5) ThenBlock: { op5 = res  ot5 = 0 }
                IfCondition EqualTo(ei, 6) ThenBlock: { op6 = res  ot6 = 0 }
                // Copy right operand's value to left (collapse)
                IfCondition EqualTo(ri, 1) ThenBlock: { op1 = res }
                IfCondition EqualTo(ri, 2) ThenBlock: { op2 = res }
                IfCondition EqualTo(ri, 3) ThenBlock: { op3 = res }
                IfCondition EqualTo(ri, 4) ThenBlock: { op4 = res }
                IfCondition EqualTo(ri, 5) ThenBlock: { op5 = res }
                IfCondition EqualTo(ri, 6) ThenBlock: { op6 = res }
                IfCondition EqualTo(ri, 7) ThenBlock: { op7 = res }
            }
            ei = Add(ei, 1)
        }

        // Pass 2: + and - (left to right, skip already-resolved * / ops marked as 0)
        result = op0
        ei = 0
        WhileLoop LessThan(ei, num_ots) {
            eop = 0
            IfCondition EqualTo(ei, 0) ThenBlock: { eop = ot0 }
            IfCondition EqualTo(ei, 1) ThenBlock: { eop = ot1 }
            IfCondition EqualTo(ei, 2) ThenBlock: { eop = ot2 }
            IfCondition EqualTo(ei, 3) ThenBlock: { eop = ot3 }
            IfCondition EqualTo(ei, 4) ThenBlock: { eop = ot4 }
            IfCondition EqualTo(ei, 5) ThenBlock: { eop = ot5 }
            IfCondition EqualTo(ei, 6) ThenBlock: { eop = ot6 }

            ri = Add(ei, 1)
            rv = 0
            IfCondition EqualTo(ri, 1) ThenBlock: { rv = op1 }
            IfCondition EqualTo(ri, 2) ThenBlock: { rv = op2 }
            IfCondition EqualTo(ri, 3) ThenBlock: { rv = op3 }
            IfCondition EqualTo(ri, 4) ThenBlock: { rv = op4 }
            IfCondition EqualTo(ri, 5) ThenBlock: { rv = op5 }
            IfCondition EqualTo(ri, 6) ThenBlock: { rv = op6 }
            IfCondition EqualTo(ri, 7) ThenBlock: { rv = op7 }

            IfCondition EqualTo(eop, 43) ThenBlock: { result = Add(result, rv) }
            IfCondition EqualTo(eop, 45) ThenBlock: { result = Subtract(result, rv) }
            // Skip 0 (already resolved * /) — just carry result forward
            ei = Add(ei, 1)
        }

        // Convert from x1000 back to px
        ReturnValue(Divide(result, 1000))
    }
}

// =============================================================================
// CSS min()/max()/clamp() evaluation
// =============================================================================
Function.LY__ParseMinMaxClamp {
    Input: str: Address
    Input: slen: Integer
    Output: Integer
    Body: {
        // Detect min(, max(, clamp( by first bytes
        b0 = GetByte(str, 0)
        b1 = GetByte(str, 1)
        b2 = GetByte(str, 2)

        // min( = 109,105,110,40
        is_min = 0
        IfCondition And(EqualTo(b0, 109), And(EqualTo(b1, 105), EqualTo(b2, 110))) ThenBlock: {
            IfCondition EqualTo(GetByte(str, 3), 40) ThenBlock: { is_min = 1 }
        }

        // max( = 109,97,120,40
        is_max = 0
        IfCondition And(EqualTo(b0, 109), And(EqualTo(b1, 97), EqualTo(b2, 120))) ThenBlock: {
            IfCondition EqualTo(GetByte(str, 3), 40) ThenBlock: { is_max = 1 }
        }

        // clamp( = 99,108,97,109,112,40
        is_clamp = 0
        IfCondition EqualTo(b0, 99) ThenBlock: {
            IfCondition EqualTo(b1, 108) ThenBlock: {
                IfCondition And(EqualTo(b2, 97), EqualTo(GetByte(str, 3), 109)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(str, 4), 112), EqualTo(GetByte(str, 5), 40)) ThenBlock: {
                        is_clamp = 1
                    }
                }
            }
        }

        IfCondition EqualTo(is_min, 0) ThenBlock: {
            IfCondition EqualTo(is_max, 0) ThenBlock: {
                IfCondition EqualTo(is_clamp, 0) ThenBlock: {
                    ReturnValue(-999999)
                }
            }
        }

        // Find opening paren and closing paren
        paren_start = 0
        IfCondition EqualTo(is_min, 1) ThenBlock: { paren_start = 4 }
        IfCondition EqualTo(is_max, 1) ThenBlock: { paren_start = 4 }
        IfCondition EqualTo(is_clamp, 1) ThenBlock: { paren_start = 6 }

        // Find matching close paren
        paren_end = Subtract(slen, 1)
        WhileLoop GreaterThan(paren_end, paren_start) {
            IfCondition EqualTo(GetByte(str, paren_end), 41) ThenBlock: { BreakLoop }
            paren_end = Subtract(paren_end, 1)
        }

        // Split on commas (top-level only, not inside nested parens)
        // Parse each arg via LY__ParsePx
        // For min/max: use running best to support arbitrary arg count (spec requires 20+)
        // For clamp: need exactly 3 args
        arg0 = 0
        arg1 = 0
        arg2 = 0
        running_best = 0
        arg_count = 0
        arg_start = paren_start
        pdep = 0
        ai = paren_start
        WhileLoop LessEqual(ai, paren_end) {
            is_comma = 0
            is_end = 0
            IfCondition LessThan(ai, paren_end) ThenBlock: {
                ac = GetByte(str, ai)
                IfCondition EqualTo(ac, 40) ThenBlock: { pdep = Add(pdep, 1) }
                IfCondition EqualTo(ac, 41) ThenBlock: { pdep = Subtract(pdep, 1) }
                IfCondition And(EqualTo(ac, 44), EqualTo(pdep, 0)) ThenBlock: { is_comma = 1 }
            }
            IfCondition EqualTo(ai, paren_end) ThenBlock: { is_end = 1 }
            IfCondition Or(EqualTo(is_comma, 1), EqualTo(is_end, 1)) ThenBlock: {
                // Extract arg from arg_start..ai
                alen = Subtract(ai, arg_start)
                IfCondition GreaterThan(alen, 0) ThenBlock: {
                    acopy = Allocate(Add(alen, 1))
                    MemoryCopy(acopy, Add(str, arg_start), alen)
                    SetByte(acopy, alen, 0)
                    aval = LY__ParsePx(acopy)
                    Deallocate(acopy, Add(alen, 1))
                    // Store first 3 args for clamp
                    IfCondition EqualTo(arg_count, 0) ThenBlock: { arg0 = aval }
                    IfCondition EqualTo(arg_count, 1) ThenBlock: { arg1 = aval }
                    IfCondition EqualTo(arg_count, 2) ThenBlock: { arg2 = aval }
                    // Running min/max for arbitrary arg count
                    IfCondition EqualTo(arg_count, 0) ThenBlock: {
                        running_best = aval
                    } ElseBlock: {
                        IfCondition EqualTo(is_min, 1) ThenBlock: {
                            IfCondition LessThan(aval, running_best) ThenBlock: { running_best = aval }
                        }
                        IfCondition EqualTo(is_max, 1) ThenBlock: {
                            IfCondition GreaterThan(aval, running_best) ThenBlock: { running_best = aval }
                        }
                    }
                    arg_count = Add(arg_count, 1)
                }
                arg_start = Add(ai, 1)
            }
            ai = Add(ai, 1)
        }

        // min/max: return running best (supports any number of args)
        IfCondition EqualTo(is_min, 1) ThenBlock: { ReturnValue(running_best) }
        IfCondition EqualTo(is_max, 1) ThenBlock: { ReturnValue(running_best) }
        // clamp(min, val, max): clamp val between min and max
        IfCondition EqualTo(is_clamp, 1) ThenBlock: {
            cval = arg1
            IfCondition LessThan(cval, arg0) ThenBlock: { cval = arg0 }
            IfCondition GreaterThan(cval, arg2) ThenBlock: { cval = arg2 }
            ReturnValue(cval)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// CSS VALUE PARSING — parse pixel/em/rem/vw/vh/% values
// =============================================================================
Function.LY__ParsePx {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(str)
        IfCondition EqualTo(slen, 0) ThenBlock: { ReturnValue(0) }

        // Skip leading whitespace
        ppx_skip = 0
        WhileLoop LessThan(ppx_skip, slen) {
            ppx_sc = GetByte(str, ppx_skip)
            IfCondition And(NotEqual(ppx_sc, 32), NotEqual(ppx_sc, 9)) ThenBlock: { BreakLoop }
            ppx_skip = Add(ppx_skip, 1)
        }
        IfCondition GreaterThan(ppx_skip, 0) ThenBlock: {
            str = Add(str, ppx_skip)
            slen = Subtract(slen, ppx_skip)
        }
        IfCondition EqualTo(slen, 0) ThenBlock: { ReturnValue(0) }

        // Check for calc() — evaluate expression
        IfCondition EqualTo(GetByte(str, 0), 99) ThenBlock: {
            IfCondition GreaterEqual(slen, 5) ThenBlock: {
                IfCondition EqualTo(GetByte(str, 1), 97) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, 2), 108) ThenBlock: {
                        IfCondition EqualTo(GetByte(str, 3), 99) ThenBlock: {
                            IfCondition EqualTo(GetByte(str, 4), 40) ThenBlock: {
                                // calc( found — find closing paren and evaluate
                                calc_end = Subtract(slen, 1)
                                WhileLoop GreaterThan(calc_end, 5) {
                                    IfCondition EqualTo(GetByte(str, calc_end), 41) ThenBlock: { BreakLoop }
                                    calc_end = Subtract(calc_end, 1)
                                }
                                ReturnValue(LY__CalcEval(str, 5, calc_end))
                            }
                        }
                    }
                }
            }
        }

        // Check for min()/max()/clamp()
        IfCondition EqualTo(GetByte(str, 0), 109) ThenBlock: {
            mmc_res = LY__ParseMinMaxClamp(str, slen)
            IfCondition NotEqual(mmc_res, -999999) ThenBlock: { ReturnValue(mmc_res) }
        }
        IfCondition EqualTo(GetByte(str, 0), 99) ThenBlock: {
            // clamp starts with 'c' but we already checked calc above
            IfCondition GreaterEqual(slen, 7) ThenBlock: {
                IfCondition EqualTo(GetByte(str, 1), 108) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, 2), 97) ThenBlock: {
                        mmc_res2 = LY__ParseMinMaxClamp(str, slen)
                        IfCondition NotEqual(mmc_res2, -999999) ThenBlock: { ReturnValue(mmc_res2) }
                    }
                }
            }
        }

        // Check for var() — resolve first
        // Returns -999999 if var() can't be resolved (callers must treat as "not set")
        IfCondition EqualTo(GetByte(str, 0), 118) ThenBlock: {
            IfCondition EqualTo(GetByte(str, 1), 97) ThenBlock: {
                IfCondition EqualTo(GetByte(str, 2), 114) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, 3), 40) ThenBlock: {
                        resolved_px = CSS_ResolveVarExpr(str)
                        IfCondition NotEqual(resolved_px, 0) ThenBlock: {
                            var_px_val = LY__ParsePx(resolved_px)
                            ReturnValue(var_px_val)
                        }
                        ReturnValue(-999999)
                    }
                }
            }
        }

        // Check for leading minus sign (negative values: -10px, -0.5em, etc.)
        is_neg = 0
        IfCondition EqualTo(GetByte(str, 0), 45) ThenBlock: {
            is_neg = 1
        }

        // Parse integer part (skip leading minus)
        val = 0
        pi = is_neg
        WhileLoop LessThan(pi, slen) {
            pc = GetByte(str, pi)
            IfCondition And(GreaterEqual(pc, 48), LessEqual(pc, 57)) ThenBlock: {
                val = Add(Multiply(val, 10), Subtract(pc, 48))
            }
            // Stop at non-digit (px, em, %, '.', etc.)
            IfCondition LessThan(pc, 48) ThenBlock: { BreakLoop }
            IfCondition GreaterThan(pc, 57) ThenBlock: { BreakLoop }
            pi = Add(pi, 1)
        }

        // Parse decimal part if present (e.g., 0.5rem, 1.25em)
        // Store as val_x1000 = val * 1000 + fractional millipixels
        frac = 0
        frac_div = 1
        IfCondition LessThan(pi, slen) ThenBlock: {
            IfCondition EqualTo(GetByte(str, pi), 46) ThenBlock: {
                // decimal point
                pi = Add(pi, 1)
                WhileLoop LessThan(pi, slen) {
                    fc = GetByte(str, pi)
                    IfCondition And(GreaterEqual(fc, 48), LessEqual(fc, 57)) ThenBlock: {
                        frac = Add(Multiply(frac, 10), Subtract(fc, 48))
                        frac_div = Multiply(frac_div, 10)
                        pi = Add(pi, 1)
                    } ElseBlock: {
                        BreakLoop
                    }
                }
            }
        }

        // Compute val_x1000 = integer part * 1000 + fractional part scaled to 1000
        val_x1000 = Multiply(val, 1000)
        IfCondition GreaterThan(frac_div, 1) ThenBlock: {
            val_x1000 = Add(val_x1000, Divide(Multiply(frac, 1000), frac_div))
        }

        // Negate if leading minus sign was present
        IfCondition EqualTo(is_neg, 1) ThenBlock: {
            val_x1000 = Subtract(0, val_x1000)
        }

        // Check for unit suffix
        IfCondition LessThan(pi, slen) ThenBlock: {
            su = GetByte(str, pi)
            // 'r' for rem — 1rem = 16px
            IfCondition EqualTo(su, 114) ThenBlock: {
                IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                    IfCondition EqualTo(GetByte(str, Add(pi, 1)), 101) ThenBlock: {
                        // re -> rem
                        ReturnValue(Divide(Multiply(val_x1000, 16), 1000))
                    }
                }
            }
            // 'e' for em/ex — 1em = current font-size, 1ex ≈ 0.5em
            IfCondition EqualTo(su, 101) ThenBlock: {
                su2e = 0
                IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                    su2e = GetByte(str, Add(pi, 1))
                }
                em_size = LYState.font_size_px
                IfCondition LessThan(em_size, 1) ThenBlock: { em_size = 16 }
                // 'ex' — 1ex ≈ 0.5em (half of current font-size)
                IfCondition EqualTo(su2e, 120) ThenBlock: {
                    ReturnValue(Divide(Multiply(val_x1000, Divide(em_size, 2)), 1000))
                }
                // 'em' or just 'e' — 1em = current font-size
                ReturnValue(Divide(Multiply(val_x1000, em_size), 1000))
            }
            // 'v' for vw/vh — viewport-relative units
            IfCondition EqualTo(su, 118) ThenBlock: {
                su2 = 0
                IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                    su2 = GetByte(str, Add(pi, 1))
                }
                IfCondition EqualTo(su2, 119) ThenBlock: {
                    // vw: 1vw = 1% of viewport width
                    ReturnValue(Divide(Multiply(val_x1000, LYState.viewport_w), 100000))
                }
                IfCondition EqualTo(su2, 104) ThenBlock: {
                    // vh: 1vh = 1% of viewport height
                    ReturnValue(Divide(Multiply(val_x1000, LYState.viewport_h), 100000))
                }
            }
            // '%' for percentage — relative to avail_w
            IfCondition EqualTo(su, 37) ThenBlock: {
                ReturnValue(Divide(Multiply(val_x1000, LYState.avail_w), 100000))
            }
            // 'p' for px, pt, pc
            IfCondition EqualTo(su, 112) ThenBlock: {
                su2p = 0
                IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                    su2p = GetByte(str, Add(pi, 1))
                }
                // 'pt' — 1pt = 96/72 px ≈ 1.333px → val_x1000 * 96 / 72
                IfCondition EqualTo(su2p, 116) ThenBlock: {
                    ReturnValue(Divide(Multiply(val_x1000, 96), 72000))
                }
                // 'pc' — 1pc = 16px → val_x1000 * 16 / 1000
                IfCondition EqualTo(su2p, 99) ThenBlock: {
                    ReturnValue(Divide(Multiply(val_x1000, 16), 1000))
                }
                // 'px' or unknown p-unit — treat as px
                ReturnValue(Divide(val_x1000, 1000))
            }
            // 'i' for in (inches) — 1in = 96px
            IfCondition EqualTo(su, 105) ThenBlock: {
                ReturnValue(Divide(Multiply(val_x1000, 96), 1000))
            }
            // 'c' for cm, ch
            IfCondition EqualTo(su, 99) ThenBlock: {
                su2c = 0
                IfCondition LessThan(Add(pi, 1), slen) ThenBlock: {
                    su2c = GetByte(str, Add(pi, 1))
                }
                // 'ch' — 1ch = width of '0' character (font_w_px)
                IfCondition EqualTo(su2c, 104) ThenBlock: {
                    ch_w = LYState.font_w_px
                    IfCondition LessThan(ch_w, 1) ThenBlock: { ch_w = 8 }
                    ReturnValue(Divide(Multiply(val_x1000, ch_w), 1000))
                }
                // 'cm' — 1cm = 96/2.54 ≈ 37.795px → val_x1000 * 48 / 1270
                ReturnValue(Divide(Multiply(val_x1000, 48), 1270))
            }
            // 'm' for mm (millimeters) — 1mm = 96/25.4 ≈ 3.7795px
            // Use integer approx: val_x1000 * 96 / 25400 = val_x1000 * 48 / 12700
            IfCondition EqualTo(su, 109) ThenBlock: {
                ReturnValue(Divide(Multiply(val_x1000, 48), 12700))
            }
        }

        // No unit or unrecognized — return integer value
        ReturnValue(Divide(val_x1000, 1000))
    }
}

// =============================================================================
// BOX SHORTHAND — parse CSS margin/padding shorthand into 4 sides
// =============================================================================
FixedPool.LYBox {
    "top":     Initialize=0
    "right":   Initialize=0
    "bottom":  Initialize=0
    "left":    Initialize=0
}

// Parse a CSS box shorthand value string into top/right/bottom/left
// Handles 1-value, 2-value, 3-value, and 4-value syntax
Function.LY__ParseBoxShorthand {
    Input: str: Address
    Body: {
        LYBox.top = 0
        LYBox.right = 0
        LYBox.bottom = 0
        LYBox.left = 0
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(str)
        IfCondition EqualTo(slen, 0) ThenBlock: { ReturnValue(0) }

        // Skip "auto" — handled separately by margin:auto logic
        IfCondition GreaterEqual(StringIndexOf(str, "auto"), 0) ThenBlock: {
            ReturnValue(0)
        }

        // Collect up to 4 space-separated values
        // vals[0..3] stored in v1..v4, count in val_count
        v1 = 0
        v2 = 0
        v3 = 0
        v4 = 0
        val_count = 0
        pos = 0

        // Skip leading whitespace
        WhileLoop LessThan(pos, slen) {
            bch = GetByte(str, pos)
            is_ws = 0
            IfCondition EqualTo(bch, 32) ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(bch, 9) ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(is_ws, 0) ThenBlock: {
                BreakLoop
            }
            pos = Add(pos, 1)
        }

        // Parse value 1
        IfCondition LessThan(pos, slen) ThenBlock: {
            bch1 = GetByte(str, pos)
            bch1_ok = 0
            IfCondition EqualTo(bch1, 45) ThenBlock: { bch1_ok = 1 }
            IfCondition EqualTo(bch1, 46) ThenBlock: { bch1_ok = 1 }
            IfCondition EqualTo(bch1, 118) ThenBlock: { bch1_ok = 1 }
            IfCondition GreaterEqual(bch1, 48) ThenBlock: {
                IfCondition LessEqual(bch1, 57) ThenBlock: { bch1_ok = 1 }
            }
            IfCondition EqualTo(bch1_ok, 1) ThenBlock: {
                v1 = LY__ParsePx(Add(str, pos))
                IfCondition EqualTo(v1, -999999) ThenBlock: { v1 = 0 }
                val_count = 1
                // Skip past value (non-whitespace)
                WhileLoop LessThan(pos, slen) {
                    bsk = GetByte(str, pos)
                    IfCondition Or(EqualTo(bsk, 32), EqualTo(bsk, 9)) ThenBlock: { BreakLoop }
                    pos = Add(pos, 1)
                }
                // Skip whitespace
                WhileLoop LessThan(pos, slen) {
                    bsp = GetByte(str, pos)
                    IfCondition Or(EqualTo(bsp, 32), EqualTo(bsp, 9)) ThenBlock: {
                        pos = Add(pos, 1)
                    } ElseBlock: { BreakLoop }
                }
            }
        }

        // Parse value 2
        IfCondition LessThan(pos, slen) ThenBlock: {
            IfCondition GreaterEqual(val_count, 1) ThenBlock: {
                bch2 = GetByte(str, pos)
                bch2_ok = 0
                IfCondition EqualTo(bch2, 45) ThenBlock: { bch2_ok = 1 }
                IfCondition EqualTo(bch2, 46) ThenBlock: { bch2_ok = 1 }
                IfCondition EqualTo(bch2, 118) ThenBlock: { bch2_ok = 1 }
                IfCondition GreaterEqual(bch2, 48) ThenBlock: {
                    IfCondition LessEqual(bch2, 57) ThenBlock: { bch2_ok = 1 }
                }
                IfCondition EqualTo(bch2_ok, 1) ThenBlock: {
                    v2 = LY__ParsePx(Add(str, pos))
                    IfCondition EqualTo(v2, -999999) ThenBlock: { v2 = 0 }
                    val_count = 2
                    WhileLoop LessThan(pos, slen) {
                        bsk2 = GetByte(str, pos)
                        IfCondition Or(EqualTo(bsk2, 32), EqualTo(bsk2, 9)) ThenBlock: { BreakLoop }
                        pos = Add(pos, 1)
                    }
                    WhileLoop LessThan(pos, slen) {
                        bsp2 = GetByte(str, pos)
                        IfCondition Or(EqualTo(bsp2, 32), EqualTo(bsp2, 9)) ThenBlock: {
                            pos = Add(pos, 1)
                        } ElseBlock: { BreakLoop }
                    }
                }
            }
        }

        // Parse value 3
        IfCondition LessThan(pos, slen) ThenBlock: {
            IfCondition GreaterEqual(val_count, 2) ThenBlock: {
                bch3 = GetByte(str, pos)
                bch3_ok = 0
                IfCondition EqualTo(bch3, 45) ThenBlock: { bch3_ok = 1 }
                IfCondition EqualTo(bch3, 46) ThenBlock: { bch3_ok = 1 }
                IfCondition EqualTo(bch3, 118) ThenBlock: { bch3_ok = 1 }
                IfCondition GreaterEqual(bch3, 48) ThenBlock: {
                    IfCondition LessEqual(bch3, 57) ThenBlock: { bch3_ok = 1 }
                }
                IfCondition EqualTo(bch3_ok, 1) ThenBlock: {
                    v3 = LY__ParsePx(Add(str, pos))
                    IfCondition EqualTo(v3, -999999) ThenBlock: { v3 = 0 }
                    val_count = 3
                    WhileLoop LessThan(pos, slen) {
                        bsk3 = GetByte(str, pos)
                        IfCondition Or(EqualTo(bsk3, 32), EqualTo(bsk3, 9)) ThenBlock: { BreakLoop }
                        pos = Add(pos, 1)
                    }
                    WhileLoop LessThan(pos, slen) {
                        bsp3 = GetByte(str, pos)
                        IfCondition Or(EqualTo(bsp3, 32), EqualTo(bsp3, 9)) ThenBlock: {
                            pos = Add(pos, 1)
                        } ElseBlock: { BreakLoop }
                    }
                }
            }
        }

        // Parse value 4
        IfCondition LessThan(pos, slen) ThenBlock: {
            IfCondition GreaterEqual(val_count, 3) ThenBlock: {
                bch4 = GetByte(str, pos)
                bch4_ok = 0
                IfCondition EqualTo(bch4, 45) ThenBlock: { bch4_ok = 1 }
                IfCondition EqualTo(bch4, 46) ThenBlock: { bch4_ok = 1 }
                IfCondition EqualTo(bch4, 118) ThenBlock: { bch4_ok = 1 }
                IfCondition GreaterEqual(bch4, 48) ThenBlock: {
                    IfCondition LessEqual(bch4, 57) ThenBlock: { bch4_ok = 1 }
                }
                IfCondition EqualTo(bch4_ok, 1) ThenBlock: {
                    v4 = LY__ParsePx(Add(str, pos))
                    IfCondition EqualTo(v4, -999999) ThenBlock: { v4 = 0 }
                    val_count = 4
                }
            }
        }

        // Apply CSS box model rules:
        // 1 value:  all sides = v1
        // 2 values: top/bottom = v1, right/left = v2
        // 3 values: top = v1, right/left = v2, bottom = v3
        // 4 values: top = v1, right = v2, bottom = v3, left = v4
        IfCondition EqualTo(val_count, 1) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v1
            LYBox.bottom = v1
            LYBox.left = v1
        }
        IfCondition EqualTo(val_count, 2) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v2
            LYBox.bottom = v1
            LYBox.left = v2
        }
        IfCondition EqualTo(val_count, 3) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v2
            LYBox.bottom = v3
            LYBox.left = v2
        }
        IfCondition EqualTo(val_count, 4) ThenBlock: {
            LYBox.top = v1
            LYBox.right = v2
            LYBox.bottom = v3
            LYBox.left = v4
        }
    }
}
