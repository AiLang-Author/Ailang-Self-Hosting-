// Library.HTMLRender.ailang — Renders layout commands to BGRA pixel buffer
// Consumes draw command list from HTMLLayout, paints to ShmCanvas or raw buffer.
// Uses VIF vector fonts for scalable anti-aliased text rendering.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.Fonts
LibraryImport.Browser.HTMLLayout

// =============================================================================
// STATE
// =============================================================================
FixedPool.RenderState {
    "buf":          Initialize=0    // target pixel buffer (BGRA)
    "width":        Initialize=0    // buffer width in pixels
    "height":       Initialize=0    // buffer height in pixels
    "pitch":        Initialize=0    // bytes per row (width * 4)
    "ready":        Initialize=0    // 1 if initialized
    "scroll_y":     Initialize=0    // vertical scroll offset (pixels)
    "dst_surf":     Initialize=0    // DSurface header wrapping buf (for VFont blit)
    "default_face": Initialize=-1   // VIF font face handle
}

Function.Render_SetScroll {
    Input: sy: Integer
    Body: {
        RenderState.scroll_y = sy
    }
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.RenderTmp {
    "x":       Initialize=0
    "y":       Initialize=0
    "w":       Initialize=0
    "h":       Initialize=0
    "color":   Initialize=0
    "ptr":     Initialize=0
    "ci":      Initialize=0
    "ri":      Initialize=0
    "row":     Initialize=0
    "off":     Initialize=0
}

// =============================================================================
// INIT
// =============================================================================
Function.Render_Init {
    Output: Integer
    Body: {
        VIF_Init()
        VFont_Init()
        // Load default vector font
        face = VFont_LoadFace("fonts/DejaVuSans.vif")
        IfCondition LessThan(face, 0) ThenBlock: {
            // Fallback: try AlteixSans
            face = VFont_LoadFace("fonts/AlteixSans.vif")
        }
        RenderState.default_face = face
        FontState.default_face = face
        // Pre-create common size instance (16px default)
        IfCondition GreaterEqual(face, 0) ThenBlock: {
            def_inst = VFont_CreateInstance(face, 16)
            FontState.default_inst = def_inst
        }
        // Allocate DSurface header for render target wrapping
        RenderState.dst_surf = Allocate(SurfaceConst.HEADER_SIZE)
        RenderState.ready = 1
        ReturnValue(1)
    }
}

// =============================================================================
// SET TARGET BUFFER
// =============================================================================
Function.Render_SetTarget {
    Input: buf: Address
    Input: width: Integer
    Input: height: Integer
    Body: {
        RenderState.buf = buf
        RenderState.width = width
        RenderState.height = height
        RenderState.pitch = Multiply(width, 4)
        // Update DSurface wrapper so VFont can blit to our buffer
        ds = RenderState.dst_surf
        IfCondition NotEqual(ds, 0) ThenBlock: {
            StoreValue(Add(ds, SurfaceFields.FORMAT), SurfaceFormat.PIXEL_32)
            StoreValue(Add(ds, SurfaceFields.WIDTH), width)
            StoreValue(Add(ds, SurfaceFields.HEIGHT), height)
            StoreValue(Add(ds, SurfaceFields.PITCH), Multiply(width, 4))
            StoreValue(Add(ds, SurfaceFields.DATA), buf)
            StoreValue(Add(ds, SurfaceFields.DATA_SIZE), Multiply(Multiply(width, 4), height))
        }
    }
}

// =============================================================================
// CLEAR — fill entire buffer with color
// =============================================================================
Function.Render_Clear {
    Input: color: Integer
    Body: {
        total_px = Multiply(RenderState.width, RenderState.height)
        ci = 0
        WhileLoop LessThan(ci, total_px) {
            off = Multiply(ci, 4)
            StoreValue(Add(RenderState.buf, off), color, "dword")
            ci = Add(ci, 1)
        }
    }
}

// =============================================================================
// FILL RECT — draw filled rectangle
// =============================================================================
Function.Render__FillRect {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        // Clamp to buffer bounds
        IfCondition LessThan(x, 0) ThenBlock: {
            w = Add(w, x)
            x = 0
        }
        IfCondition LessThan(y, 0) ThenBlock: {
            h = Add(h, y)
            y = 0
        }
        x2 = Add(x, w)
        y2 = Add(y, h)
        IfCondition GreaterThan(x2, RenderState.width) ThenBlock: {
            x2 = RenderState.width
        }
        IfCondition GreaterThan(y2, RenderState.height) ThenBlock: {
            y2 = RenderState.height
        }
        IfCondition GreaterEqual(x, x2) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(y, y2) ThenBlock: { ReturnValue(0) }

        cw = Subtract(x2, x)

        ry = y
        WhileLoop LessThan(ry, y2) {
            row_off = Add(Multiply(ry, RenderState.pitch), Multiply(x, 4))
            row_ptr = Add(RenderState.buf, row_off)
            px = 0
            WhileLoop LessThan(px, cw) {
                StoreValue(Add(row_ptr, Multiply(px, 4)), color, "dword")
                px = Add(px, 1)
            }
            ry = Add(ry, 1)
        }
    }
}

// =============================================================================
// DRAW LINE — horizontal line (1px tall)
// =============================================================================
Function.Render__DrawLine {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: color: Integer
    Body: {
        Render__FillRect(x, y, w, 1, color)
    }
}

// =============================================================================
// GET FONT INSTANCE — returns cached VIF font instance for given pixel size
// =============================================================================
Function.Render__GetFontInstance {
    Input: size_px: Integer
    Output: Integer
    Body: {
        face = RenderState.default_face
        IfCondition LessThan(face, 0) ThenBlock: { ReturnValue(-1) }
        // Clamp minimum size
        IfCondition LessThan(size_px, 8) ThenBlock: { size_px = 8 }
        // Clamp maximum size
        IfCondition GreaterThan(size_px, 72) ThenBlock: { size_px = 72 }
        // VFont_CreateInstance returns cached instance if already exists
        inst = VFont_CreateInstance(face, size_px)
        ReturnValue(inst)
    }
}

// =============================================================================
// DRAW TEXT — render string using VIF vector font at x,y with color
// font_w = font size in pixels (from layout's font_size_px)
// =============================================================================
Function.Render__DrawText {
    Input: x: Integer
    Input: y: Integer
    Input: ptr: Address
    Input: len: Integer
    Input: color: Integer
    Input: font_w: Integer
    Body: {
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(len, 0) ThenBlock: { ReturnValue(0) }
        // Default font size to 16px if not set
        IfCondition LessEqual(font_w, 0) ThenBlock: { font_w = 16 }

        // Ahem test font: every glyph is a solid filled square of font_w x font_w
        IfCondition EqualTo(RenderTmp.ri, 1) ThenBlock: {
            max_y = Subtract(RenderState.height, font_w)
            IfCondition GreaterThan(y, max_y) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(y, 0) ThenBlock: { ReturnValue(0) }
            cx = x
            ci = 0
            WhileLoop LessThan(ci, len) {
                ch = GetByte(ptr, ci)
                IfCondition NotEqual(ch, 32) ThenBlock: {
                    IfCondition And(GreaterEqual(cx, 0), LessThan(cx, RenderState.width)) ThenBlock: {
                        Render__FillRect(cx, y, font_w, font_w, color)
                    }
                }
                cx = Add(cx, font_w)
                ci = Add(ci, 1)
                IfCondition GreaterThan(cx, RenderState.width) ThenBlock: { ci = len }
            }
            ReturnValue(0)
        }

        // VIF vector font path — scalable anti-aliased glyphs
        IfCondition LessThan(y, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(y, RenderState.height) ThenBlock: { ReturnValue(0) }

        inst = Render__GetFontInstance(font_w)
        IfCondition LessThan(inst, 0) ThenBlock: { ReturnValue(0) }

        // Set draw color and render via VFont
        FontState.draw_color = color
        ds = RenderState.dst_surf
        IfCondition NotEqual(ds, 0) ThenBlock: {
            VInst_DrawString(inst, ds, ptr, len, x, y)
        }
    }
}

// =============================================================================
// DRAW IMAGE — blit BGRA pixel buffer with nearest-neighbor scaling
// RenderTmp.ptr must be set to pixel pointer before calling (6-arg limit)
// =============================================================================
Function.Render__DrawImage {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: src_w: Integer
    Input: src_h: Integer
    Body: {
        pixels = RenderTmp.ptr
        IfCondition EqualTo(pixels, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(src_w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(src_h, 0) ThenBlock: { ReturnValue(0) }

        // Clamp destination to buffer bounds
        dx0 = x
        dy0 = y
        dx1 = Add(x, w)
        dy1 = Add(y, h)
        IfCondition LessThan(dx0, 0) ThenBlock: { dx0 = 0 }
        IfCondition LessThan(dy0, 0) ThenBlock: { dy0 = 0 }
        IfCondition GreaterThan(dx1, RenderState.width) ThenBlock: { dx1 = RenderState.width }
        IfCondition GreaterThan(dy1, RenderState.height) ThenBlock: { dy1 = RenderState.height }
        IfCondition GreaterEqual(dx0, dx1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(dy0, dy1) ThenBlock: { ReturnValue(0) }

        src_pitch = Multiply(src_w, 4)

        // Nearest-neighbor scaling: for each dest pixel, find corresponding source pixel
        // Scale factors: src_x = (dx - x) * src_w / w,  src_y = (dy - y) * src_h / h
        // Use integer math: src_x = ((dx - x) * src_w) / w
        dy = dy0
        WhileLoop LessThan(dy, dy1) {
            // Source Y = ((dy - y) * src_h) / h
            sy_num = Multiply(Subtract(dy, y), src_h)
            sy = Divide(sy_num, h)
            IfCondition GreaterEqual(sy, src_h) ThenBlock: { sy = Subtract(src_h, 1) }
            src_row = Add(pixels, Multiply(sy, src_pitch))
            dst_row = Add(RenderState.buf, Multiply(dy, RenderState.pitch))

            dx = dx0
            WhileLoop LessThan(dx, dx1) {
                // Source X = ((dx - x) * src_w) / w
                sx_num = Multiply(Subtract(dx, x), src_w)
                sx = Divide(sx_num, w)
                IfCondition GreaterEqual(sx, src_w) ThenBlock: { sx = Subtract(src_w, 1) }

                // Read source pixel (BGRA)
                src_px = Dereference(Add(src_row, Multiply(sx, 4)), "dword")
                // Alpha blending: skip fully transparent pixels
                src_a = BitwiseAnd(ShiftRight(src_px, 24), 255)
                IfCondition EqualTo(src_a, 255) ThenBlock: {
                    // Fully opaque — direct copy
                    StoreValue(Add(dst_row, Multiply(dx, 4)), src_px, "dword")
                }
                IfCondition And(GreaterThan(src_a, 0), LessThan(src_a, 255)) ThenBlock: {
                    // Semi-transparent — simple alpha blend with destination
                    dst_px = Dereference(Add(dst_row, Multiply(dx, 4)), "dword")
                    inv_a = Subtract(255, src_a)
                    // Blend each channel: out = (src * src_a + dst * inv_a) / 255
                    sb = BitwiseAnd(src_px, 255)
                    sg = BitwiseAnd(ShiftRight(src_px, 8), 255)
                    sr = BitwiseAnd(ShiftRight(src_px, 16), 255)
                    db = BitwiseAnd(dst_px, 255)
                    dg = BitwiseAnd(ShiftRight(dst_px, 8), 255)
                    dr = BitwiseAnd(ShiftRight(dst_px, 16), 255)
                    ob = Divide(Add(Multiply(sb, src_a), Multiply(db, inv_a)), 255)
                    og = Divide(Add(Multiply(sg, src_a), Multiply(dg, inv_a)), 255)
                    or_v = Divide(Add(Multiply(sr, src_a), Multiply(dr, inv_a)), 255)
                    out_px = BitwiseOr(BitwiseOr(BitwiseOr(ob, ShiftLeft(og, 8)), ShiftLeft(or_v, 16)), ShiftLeft(255, 24))
                    StoreValue(Add(dst_row, Multiply(dx, 4)), out_px, "dword")
                }
                // src_a == 0: fully transparent — skip (keep destination)

                dx = Add(dx, 1)
            }
            dy = Add(dy, 1)
        }
    }
}

// =============================================================================
// EXECUTE — process all layout commands
// =============================================================================
Function.Render_Exec {
    Body: {
        count = Layout_CmdCount()
        sy = RenderState.scroll_y

        // Pass 1: FILL_RECT (backgrounds) — REVERSE order so parents paint first
        // Layout emits child backgrounds before parent backgrounds (post-order),
        // so reversing ensures parent bg is underneath child bg (correct z-order).
        ri = Subtract(count, 1)
        WhileLoop GreaterEqual(ri, 0) {
            ctype = Layout_CmdType(ri)
            IfCondition EqualTo(ctype, LYCmd.FILL_RECT) ThenBlock: {
                cx = Layout_CmdX(ri)
                cy = Subtract(Layout_CmdY(ri), sy)
                cw = Layout_CmdW(ri)
                ch = Layout_CmdH(ri)
                cc = Layout_CmdColor(ri)
                IfCondition And(GreaterEqual(Add(cy, ch), 0), LessThan(cy, RenderState.height)) ThenBlock: {
                    Render__FillRect(cx, cy, cw, ch, cc)
                }
            }
            ri = Subtract(ri, 1)
        }

        // Pass 1b: DRAW_LINE (borders) — forward order is fine for borders
        ri = 0
        WhileLoop LessThan(ri, count) {
            ctype = Layout_CmdType(ri)
            IfCondition EqualTo(ctype, LYCmd.DRAW_LINE) ThenBlock: {
                cx = Layout_CmdX(ri)
                cy = Subtract(Layout_CmdY(ri), sy)
                cw = Layout_CmdW(ri)
                cc = Layout_CmdColor(ri)
                IfCondition And(GreaterEqual(cy, 0), LessThan(cy, RenderState.height)) ThenBlock: {
                    Render__DrawLine(cx, cy, cw, cc)
                }
            }
            ri = Add(ri, 1)
        }

        // Pass 1c: DRAW_IMAGE (images on top of backgrounds, below text)
        ri = 0
        WhileLoop LessThan(ri, count) {
            ctype = Layout_CmdType(ri)
            IfCondition EqualTo(ctype, LYCmd.DRAW_IMAGE) ThenBlock: {
                cx = Layout_CmdX(ri)
                cy = Subtract(Layout_CmdY(ri), sy)
                cw = Layout_CmdW(ri)
                ch = Layout_CmdH(ri)
                cc = Layout_CmdColor(ri)
                cp = Layout_CmdPtr(ri)
                // Unpack source dimensions from cc: src_w = cc & 0xFFFF, src_h = cc >> 16
                img_src_w = BitwiseAnd(cc, 65535)
                img_src_h = Divide(cc, 65536)
                IfCondition And(GreaterThan(Add(cy, ch), 0), LessThan(cy, RenderState.height)) ThenBlock: {
                    RenderTmp.ptr = cp
                    Render__DrawImage(cx, cy, cw, ch, img_src_w, img_src_h)
                }
            }
            ri = Add(ri, 1)
        }

        // Pass 2: DRAW_TEXT (text on top of backgrounds)
        ri = 0
        WhileLoop LessThan(ri, count) {
            ctype = Layout_CmdType(ri)

            IfCondition EqualTo(ctype, LYCmd.DRAW_TEXT) ThenBlock: {
                cx = Layout_CmdX(ri)
                cy = Subtract(Layout_CmdY(ri), sy)
                cw = Layout_CmdW(ri)
                ch = Layout_CmdH(ri)
                cc = Layout_CmdColor(ri)
                cp = Layout_CmdPtr(ri)
                // H field = font_size_px | (is_ahem << 15)
                // Extract is_ahem flag from bit 15
                RenderTmp.ri = 0
                font_sz = ch
                IfCondition GreaterEqual(ch, 32768) ThenBlock: {
                    RenderTmp.ri = 1
                    font_sz = Subtract(ch, 32768)
                }
                glyph_h = font_sz
                IfCondition LessThan(glyph_h, 16) ThenBlock: { glyph_h = 16 }
                IfCondition And(GreaterThan(Add(cy, glyph_h), 0), LessThan(cy, RenderState.height)) ThenBlock: {
                    Render__DrawText(cx, cy, cp, cw, cc, font_sz)
                }
            }

            ri = Add(ri, 1)
        }
    }
}

// =============================================================================
// RENDER TEXT WITH BACKGROUND
// Draws text with a background color behind the text area
// =============================================================================
Function.Render_DrawTextBg {
    Input: x: Integer
    Input: y: Integer
    Input: ptr: Address
    Input: len: Integer
    Input: fg: Integer
    Body: {
        // Estimate width using 60% of default 16px font size
        bg_w = Multiply(len, 10)
        // Draw bg rect
        Render__FillRect(x, y, bg_w, 20, LYConst.COLOR_WHITE)
        // Draw text (16 = default VIF font size)
        RenderTmp.ri = 0
        Render__DrawText(x, y, ptr, len, fg, 16)
    }
}
