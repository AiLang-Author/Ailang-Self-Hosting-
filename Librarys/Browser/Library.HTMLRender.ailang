// Library.HTMLRender.ailang — Renders layout commands to BGRA pixel buffer
// Consumes draw command list from HTMLLayout, paints to ShmCanvas or raw buffer.
// Uses TermFont (8x16 bitmap) for text rendering.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.TermFont
LibraryImport.Browser.HTMLLayout

// =============================================================================
// STATE
// =============================================================================
FixedPool.RenderState {
    "buf":       Initialize=0    // target pixel buffer (BGRA)
    "width":     Initialize=0    // buffer width in pixels
    "height":    Initialize=0    // buffer height in pixels
    "pitch":     Initialize=0    // bytes per row (width * 4)
    "ready":     Initialize=0    // 1 if initialized
    "scroll_y":  Initialize=0    // vertical scroll offset (pixels)
}

Function.Render_SetScroll {
    Input: sy: Integer
    Body: {
        RenderState.scroll_y = sy
    }
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.RenderTmp {
    "x":       Initialize=0
    "y":       Initialize=0
    "w":       Initialize=0
    "h":       Initialize=0
    "color":   Initialize=0
    "ptr":     Initialize=0
    "ci":      Initialize=0
    "ri":      Initialize=0
    "row":     Initialize=0
    "off":     Initialize=0
}

// =============================================================================
// INIT
// =============================================================================
Function.Render_Init {
    Output: Integer
    Body: {
        TermFont_Init()
        RenderState.ready = 1
        ReturnValue(1)
    }
}

// =============================================================================
// SET TARGET BUFFER
// =============================================================================
Function.Render_SetTarget {
    Input: buf: Address
    Input: width: Integer
    Input: height: Integer
    Body: {
        RenderState.buf = buf
        RenderState.width = width
        RenderState.height = height
        RenderState.pitch = Multiply(width, 4)
    }
}

// =============================================================================
// CLEAR — fill entire buffer with color
// =============================================================================
Function.Render_Clear {
    Input: color: Integer
    Body: {
        total_px = Multiply(RenderState.width, RenderState.height)
        ci = 0
        WhileLoop LessThan(ci, total_px) {
            off = Multiply(ci, 4)
            StoreValue(Add(RenderState.buf, off), color, "dword")
            ci = Add(ci, 1)
        }
    }
}

// =============================================================================
// FILL RECT — draw filled rectangle
// =============================================================================
Function.Render__FillRect {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        // Clamp to buffer bounds
        IfCondition LessThan(x, 0) ThenBlock: {
            w = Add(w, x)
            x = 0
        }
        IfCondition LessThan(y, 0) ThenBlock: {
            h = Add(h, y)
            y = 0
        }
        x2 = Add(x, w)
        y2 = Add(y, h)
        IfCondition GreaterThan(x2, RenderState.width) ThenBlock: {
            x2 = RenderState.width
        }
        IfCondition GreaterThan(y2, RenderState.height) ThenBlock: {
            y2 = RenderState.height
        }
        IfCondition GreaterEqual(x, x2) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(y, y2) ThenBlock: { ReturnValue(0) }

        cw = Subtract(x2, x)

        ry = y
        WhileLoop LessThan(ry, y2) {
            row_off = Add(Multiply(ry, RenderState.pitch), Multiply(x, 4))
            row_ptr = Add(RenderState.buf, row_off)
            px = 0
            WhileLoop LessThan(px, cw) {
                StoreValue(Add(row_ptr, Multiply(px, 4)), color, "dword")
                px = Add(px, 1)
            }
            ry = Add(ry, 1)
        }
    }
}

// =============================================================================
// DRAW LINE — horizontal line (1px tall)
// =============================================================================
Function.Render__DrawLine {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: color: Integer
    Body: {
        Render__FillRect(x, y, w, 1, color)
    }
}

// =============================================================================
// DRAW TEXT — render string using TermFont at x,y with color
// =============================================================================
Function.Render__DrawText {
    Input: x: Integer
    Input: y: Integer
    Input: ptr: Address
    Input: len: Integer
    Input: color: Integer
    Input: font_w: Integer
    Body: {
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(len, 0) ThenBlock: { ReturnValue(0) }
        // Default font_w to 8 if not set (legacy commands)
        IfCondition LessEqual(font_w, 0) ThenBlock: { font_w = 8 }

        // Ahem font: every glyph is a solid filled square of font_w x font_w
        IfCondition GreaterThan(font_w, 8) ThenBlock: {
            max_y = Subtract(RenderState.height, font_w)
            IfCondition GreaterThan(y, max_y) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(y, 0) ThenBlock: { ReturnValue(0) }
            cx = x
            ci = 0
            WhileLoop LessThan(ci, len) {
                ch = GetByte(ptr, ci)
                // Ahem: space (32) is blank, all other chars are solid squares
                IfCondition NotEqual(ch, 32) ThenBlock: {
                    IfCondition And(GreaterEqual(cx, 0), LessThan(cx, RenderState.width)) ThenBlock: {
                        Render__FillRect(cx, y, font_w, font_w, color)
                    }
                }
                cx = Add(cx, font_w)
                ci = Add(ci, 1)
                IfCondition GreaterThan(cx, RenderState.width) ThenBlock: { ci = len }
            }
            ReturnValue(0)
        }

        // Normal TermFont path (8x16 bitmap)
        TermFont_SetColors(color, 0)

        // Clip: glyph is 8x16, so Y must be < height-15 and X < width-7
        max_y = Subtract(RenderState.height, 16)
        max_x = Subtract(RenderState.width, 8)
        IfCondition GreaterThan(y, max_y) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(y, 0) ThenBlock: { ReturnValue(0) }

        cx = x
        ci = 0
        WhileLoop LessThan(ci, len) {
            ch = GetByte(ptr, ci)
            // Only render if X within viewport
            IfCondition And(GreaterEqual(cx, 0), LessEqual(cx, max_x)) ThenBlock: {
                TermFont_DrawCharFgOnly(RenderState.buf, RenderState.width, cx, y, ch)
            }
            cx = Add(cx, 8) // FONT_W = 8
            ci = Add(ci, 1)
            // Early exit if past right edge
            IfCondition GreaterThan(cx, RenderState.width) ThenBlock: { ci = len }
        }
    }
}

// =============================================================================
// EXECUTE — process all layout commands
// =============================================================================
Function.Render_Exec {
    Body: {
        count = Layout_CmdCount()
        sy = RenderState.scroll_y

        // Pass 1: FILL_RECT (backgrounds) — REVERSE order so parents paint first
        // Layout emits child backgrounds before parent backgrounds (post-order),
        // so reversing ensures parent bg is underneath child bg (correct z-order).
        ri = Subtract(count, 1)
        WhileLoop GreaterEqual(ri, 0) {
            ctype = Layout_CmdType(ri)
            IfCondition EqualTo(ctype, LYCmd.FILL_RECT) ThenBlock: {
                cx = Layout_CmdX(ri)
                cy = Subtract(Layout_CmdY(ri), sy)
                cw = Layout_CmdW(ri)
                ch = Layout_CmdH(ri)
                cc = Layout_CmdColor(ri)
                IfCondition And(GreaterEqual(Add(cy, ch), 0), LessThan(cy, RenderState.height)) ThenBlock: {
                    Render__FillRect(cx, cy, cw, ch, cc)
                }
            }
            ri = Subtract(ri, 1)
        }

        // Pass 1b: DRAW_LINE (borders) — forward order is fine for borders
        ri = 0
        WhileLoop LessThan(ri, count) {
            ctype = Layout_CmdType(ri)
            IfCondition EqualTo(ctype, LYCmd.DRAW_LINE) ThenBlock: {
                cx = Layout_CmdX(ri)
                cy = Subtract(Layout_CmdY(ri), sy)
                cw = Layout_CmdW(ri)
                cc = Layout_CmdColor(ri)
                IfCondition And(GreaterEqual(cy, 0), LessThan(cy, RenderState.height)) ThenBlock: {
                    Render__DrawLine(cx, cy, cw, cc)
                }
            }
            ri = Add(ri, 1)
        }

        // Pass 2: DRAW_TEXT (text on top of backgrounds)
        ri = 0
        WhileLoop LessThan(ri, count) {
            ctype = Layout_CmdType(ri)

            IfCondition EqualTo(ctype, LYCmd.DRAW_TEXT) ThenBlock: {
                cx = Layout_CmdX(ri)
                cy = Subtract(Layout_CmdY(ri), sy)
                cw = Layout_CmdW(ri)
                ch = Layout_CmdH(ri)
                cc = Layout_CmdColor(ri)
                cp = Layout_CmdPtr(ri)
                // ch = font_w_px from layout (8=TermFont, >8=Ahem/vector)
                // Use font_w for glyph height clipping: Ahem glyph is font_w tall
                glyph_h = 16
                IfCondition GreaterThan(ch, 8) ThenBlock: { glyph_h = ch }
                IfCondition And(GreaterThan(Add(cy, glyph_h), 0), LessThan(cy, RenderState.height)) ThenBlock: {
                    Render__DrawText(cx, cy, cp, cw, cc, ch)
                }
            }

            ri = Add(ri, 1)
        }
    }
}

// =============================================================================
// RENDER TEXT WITH BACKGROUND
// Draws text with a background color behind the text area
// =============================================================================
Function.Render_DrawTextBg {
    Input: x: Integer
    Input: y: Integer
    Input: ptr: Address
    Input: len: Integer
    Input: fg: Integer
    Body: {
        // Save bg color
        bg_w = Multiply(len, 8)
        // Draw bg rect
        Render__FillRect(x, y, bg_w, 16, LYConst.COLOR_WHITE)
        // Draw text (8 = default TermFont width)
        Render__DrawText(x, y, ptr, len, fg, 8)
    }
}
