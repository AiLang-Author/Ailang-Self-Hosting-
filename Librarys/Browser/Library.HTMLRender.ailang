// Library.HTMLRender.ailang — Renders layout commands to BGRA pixel buffer
// Consumes draw command list from HTMLLayout, paints to ShmCanvas or raw buffer.
// Uses TermFont (8x16 bitmap) for text rendering.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.TermFont
LibraryImport.Browser.HTMLLayout

// =============================================================================
// STATE
// =============================================================================
FixedPool.RenderState {
    "buf":       Initialize=0    // target pixel buffer (BGRA)
    "width":     Initialize=0    // buffer width in pixels
    "height":    Initialize=0    // buffer height in pixels
    "pitch":     Initialize=0    // bytes per row (width * 4)
    "ready":     Initialize=0    // 1 if initialized
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.RenderTmp {
    "x":       Initialize=0
    "y":       Initialize=0
    "w":       Initialize=0
    "h":       Initialize=0
    "color":   Initialize=0
    "ptr":     Initialize=0
    "ci":      Initialize=0
    "ri":      Initialize=0
    "row":     Initialize=0
    "off":     Initialize=0
}

// =============================================================================
// INIT
// =============================================================================
Function.Render_Init {
    Output: Integer
    Body: {
        TermFont_Init()
        RenderState.ready = 1
        ReturnValue(1)
    }
}

// =============================================================================
// SET TARGET BUFFER
// =============================================================================
Function.Render_SetTarget {
    Input: buf: Address
    Input: width: Integer
    Input: height: Integer
    Body: {
        RenderState.buf = buf
        RenderState.width = width
        RenderState.height = height
        RenderState.pitch = Multiply(width, 4)
    }
}

// =============================================================================
// CLEAR — fill entire buffer with color
// =============================================================================
Function.Render_Clear {
    Input: color: Integer
    Body: {
        total_px = Multiply(RenderState.width, RenderState.height)
        ci = 0
        WhileLoop LessThan(ci, total_px) {
            off = Multiply(ci, 4)
            StoreValue(Add(RenderState.buf, off), color, "dword")
            ci = Add(ci, 1)
        }
    }
}

// =============================================================================
// FILL RECT — draw filled rectangle
// =============================================================================
Function.Render__FillRect {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        // Clamp to buffer bounds
        IfCondition LessThan(x, 0) ThenBlock: {
            w = Add(w, x)
            x = 0
        }
        IfCondition LessThan(y, 0) ThenBlock: {
            h = Add(h, y)
            y = 0
        }
        x2 = Add(x, w)
        y2 = Add(y, h)
        IfCondition GreaterThan(x2, RenderState.width) ThenBlock: {
            x2 = RenderState.width
        }
        IfCondition GreaterThan(y2, RenderState.height) ThenBlock: {
            y2 = RenderState.height
        }
        IfCondition GreaterEqual(x, x2) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(y, y2) ThenBlock: { ReturnValue(0) }

        cw = Subtract(x2, x)

        ry = y
        WhileLoop LessThan(ry, y2) {
            row_off = Add(Multiply(ry, RenderState.pitch), Multiply(x, 4))
            row_ptr = Add(RenderState.buf, row_off)
            px = 0
            WhileLoop LessThan(px, cw) {
                StoreValue(Add(row_ptr, Multiply(px, 4)), color, "dword")
                px = Add(px, 1)
            }
            ry = Add(ry, 1)
        }
    }
}

// =============================================================================
// DRAW LINE — horizontal line (1px tall)
// =============================================================================
Function.Render__DrawLine {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: color: Integer
    Body: {
        Render__FillRect(x, y, w, 1, color)
    }
}

// =============================================================================
// DRAW TEXT — render string using TermFont at x,y with color
// =============================================================================
Function.Render__DrawText {
    Input: x: Integer
    Input: y: Integer
    Input: ptr: Address
    Input: len: Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(len, 0) ThenBlock: { ReturnValue(0) }

        // Set TermFont colors: fg = color, bg = transparent (0)
        // TermFont_SetColors expects BGRA fg and bg
        // For transparent bg, we render char-by-char skipping bg pixels
        // But TermFont_DrawCharFgBg draws both fg and bg
        // We'll use it with bg=0 and accept the black bg for now
        // OR we can use a dedicated render that only draws fg pixels

        // For now, set fg=color, bg=white (will show as white bg behind text)
        // Actually, let's try bg=0 (transparent/black) — we can fix later
        TermFont_SetColors(color, 0)

        cx = x
        ci = 0
        WhileLoop LessThan(ci, len) {
            ch = GetByte(ptr, ci)
            // Only render if within viewport
            IfCondition LessThan(cx, RenderState.width) ThenBlock: {
                IfCondition LessThan(y, RenderState.height) ThenBlock: {
                    IfCondition GreaterEqual(y, 0) ThenBlock: {
                        TermFont_DrawCharFgBg(RenderState.buf, RenderState.width, cx, y, ch)
                    }
                }
            }
            cx = Add(cx, 8) // FONT_W = 8
            ci = Add(ci, 1)
        }
    }
}

// =============================================================================
// EXECUTE — process all layout commands
// =============================================================================
Function.Render_Exec {
    Body: {
        count = Layout_CmdCount()
        ri = 0
        WhileLoop LessThan(ri, count) {
            ctype = Layout_CmdType(ri)
            cx = Layout_CmdX(ri)
            cy = Layout_CmdY(ri)
            cw = Layout_CmdW(ri)

            IfCondition EqualTo(ctype, LYCmd.FILL_RECT) ThenBlock: {
                ch = Layout_CmdH(ri)
                cc = Layout_CmdColor(ri)
                Render__FillRect(cx, cy, cw, ch, cc)
            }

            IfCondition EqualTo(ctype, LYCmd.DRAW_TEXT) ThenBlock: {
                cc = Layout_CmdColor(ri)
                cp = Layout_CmdPtr(ri)
                Render__DrawText(cx, cy, cp, cw, cc)
            }

            IfCondition EqualTo(ctype, LYCmd.DRAW_LINE) ThenBlock: {
                cc = Layout_CmdColor(ri)
                Render__DrawLine(cx, cy, cw, cc)
            }

            ri = Add(ri, 1)
        }
    }
}

// =============================================================================
// RENDER TEXT WITH BACKGROUND
// Draws text with a background color behind the text area
// =============================================================================
Function.Render_DrawTextBg {
    Input: x: Integer
    Input: y: Integer
    Input: ptr: Address
    Input: len: Integer
    Input: fg: Integer
    Body: {
        // Save bg color
        bg_w = Multiply(len, 8)
        // Draw bg rect
        Render__FillRect(x, y, bg_w, 16, LYConst.COLOR_WHITE)
        // Draw text
        Render__DrawText(x, y, ptr, len, fg)
    }
}
