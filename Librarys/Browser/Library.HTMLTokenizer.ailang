// Library.HTMLTokenizer.ailang — Browser-grade HTML tokenizer
// Tokenizes raw HTML into a flat token stream. Handles real-world web HTML:
// entity decoding, void elements, raw text (script/style), single/unquoted attrs,
// case-insensitive tags, DOCTYPE, comments.
// Based on Display/Content/Library.HTMLParse.ailang lexer, adapted for browser use.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils

// =============================================================================
// TOKEN TYPES
// =============================================================================
FixedPool.HTKType {
    "TAG_OPEN":       Initialize=1    // <tagname
    "TAG_CLOSE":      Initialize=2    // </tagname>
    "TAG_SELF_CLOSE": Initialize=3    // />
    "TAG_END":        Initialize=4    // > (end of opening tag)
    "ATTR_NAME":      Initialize=5    // attribute name
    "ATTR_VALUE":     Initialize=6    // attribute value (entity-decoded)
    "ATTR_BARE":      Initialize=7    // bare attribute (no value, e.g. disabled)
    "TEXT":           Initialize=8    // text content between tags
    "COMMENT":        Initialize=9    // <!-- ... --> content
    "DOCTYPE":        Initialize=10   // <!DOCTYPE ...>
    "EOF":            Initialize=11
}

// =============================================================================
// TOKEN STRUCTURE — 40 bytes per token
// =============================================================================
FixedPool.HTKConst {
    "MAX_TOKENS":   Initialize=8192
    "TOKEN_SIZE":   Initialize=40
    "T_TYPE":       Initialize=0
    "T_PTR":        Initialize=8     // interned string pointer
    "T_LEN":        Initialize=16    // string length
    "T_LINE":       Initialize=24    // source line number
    "T_COL":        Initialize=32    // source column number
    "STR_CAP":      Initialize=131072  // 128 KB string intern table
}

// =============================================================================
// LEXER STATE
// =============================================================================
FixedPool.HTKState {
    "tok_pool":   Initialize=0
    "tok_count":  Initialize=0
    "str_buf":    Initialize=0
    "str_pos":    Initialize=0
    "source":     Initialize=0
    "src_len":    Initialize=0
    "pos":        Initialize=0
    "line":       Initialize=1
    "col":        Initialize=1
    "error":      Initialize=0
    "err_msg":    Initialize=0
}

// Clobber-safe temporaries for scan loops
FixedPool.HTKTmp {
    "ch":         Initialize=0
    "ch2":        Initialize=0
    "ch3":        Initialize=0
    "start":      Initialize=0
    "len":        Initialize=0
    "ptr":        Initialize=0
    "interned":   Initialize=0
    "tag_name":   Initialize=0    // for raw text detection
    "tag_len":    Initialize=0
    "quote":      Initialize=0    // quote char (34 or 39)
    "done":       Initialize=0
    "ent_val":    Initialize=0    // entity decoded value
    "cmt_state":  Initialize=0    // comment state: 0=normal, 1=end-dash, 2=end, 3=end-bang
    "attr_name":  Initialize=0    // clobber-safe attr name ptr
    "attr_len":   Initialize=0    // clobber-safe attr name length
    "buf":        Initialize=0    // clobber-safe buffer ptr for scan functions
    "di":         Initialize=0    // clobber-safe buffer write index
    "in_attr":    Initialize=0    // 1 if decoding entity in attribute context
}

// =============================================================================
// INIT / RESET
// =============================================================================
Function.HTK_Init {
    Output: Integer
    Body: {
        tsz = Multiply(HTKConst.MAX_TOKENS, HTKConst.TOKEN_SIZE)
        HTKState.tok_pool = Allocate(tsz)
        MemorySet(HTKState.tok_pool, 0, tsz)
        HTKState.tok_count = 0

        HTKState.str_buf = Allocate(HTKConst.STR_CAP)
        MemorySet(HTKState.str_buf, 0, HTKConst.STR_CAP)
        HTKState.str_pos = 0

        HTKState.error = 0
        ReturnValue(1)
    }
}

Function.HTK_Reset {
    Output: Integer
    Body: {
        HTKState.tok_count = 0
        HTKState.str_pos = 0
        HTKState.pos = 0
        HTKState.line = 1
        HTKState.col = 1
        HTKState.error = 0
        ReturnValue(0)
    }
}

// =============================================================================
// STRING INTERNING
// =============================================================================
Function.HTK__Intern {
    Input: src: Address
    Input: len: Integer
    Output: Address
    Body: {
        needed = Add(HTKState.str_pos, Add(len, 1))
        IfCondition GreaterEqual(needed, HTKConst.STR_CAP) ThenBlock: {
            ReturnValue(0)
        }
        dest = Add(HTKState.str_buf, HTKState.str_pos)
        MemoryCopy(dest, src, len)
        SetByte(dest, len, 0)
        HTKState.str_pos = Add(HTKState.str_pos, Add(len, 1))
        ReturnValue(dest)
    }
}

// Intern with lowercase conversion (for tag/attr names)
Function.HTK__InternLower {
    Input: src: Address
    Input: len: Integer
    Output: Address
    Body: {
        needed = Add(HTKState.str_pos, Add(len, 1))
        IfCondition GreaterEqual(needed, HTKConst.STR_CAP) ThenBlock: {
            ReturnValue(0)
        }
        dest = Add(HTKState.str_buf, HTKState.str_pos)
        ci = 0
        WhileLoop LessThan(ci, len) {
            ch = GetByte(src, ci)
            // A-Z (65-90) -> a-z (97-122)
            IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: {
                ch = Add(ch, 32)
            }
            SetByte(dest, ci, ch)
            ci = Add(ci, 1)
        }
        SetByte(dest, len, 0)
        HTKState.str_pos = Add(HTKState.str_pos, Add(len, 1))
        ReturnValue(dest)
    }
}

// =============================================================================
// TOKEN EMISSION
// =============================================================================
Function.HTK__TokBase {
    Input: idx: Integer
    Output: Address
    Body: {
        ReturnValue(Add(HTKState.tok_pool, Multiply(idx, HTKConst.TOKEN_SIZE)))
    }
}

Function.HTK__AddToken {
    Input: ttype: Integer
    Input: ptr: Address
    Input: len: Integer
    Output: Integer
    Body: {
        idx = HTKState.tok_count
        IfCondition GreaterEqual(idx, HTKConst.MAX_TOKENS) ThenBlock: {
            ReturnValue(-1)
        }
        // Save params to locals before any compound expressions
        save_type = ttype
        save_ptr = ptr
        save_len = len
        HTKState.tok_count = Add(idx, 1)
        base = Add(HTKState.tok_pool, Multiply(idx, HTKConst.TOKEN_SIZE))
        StoreValue(Add(base, HTKConst.T_TYPE), save_type)
        StoreValue(Add(base, HTKConst.T_PTR), save_ptr)
        StoreValue(Add(base, HTKConst.T_LEN), save_len)
        StoreValue(Add(base, HTKConst.T_LINE), HTKState.line)
        StoreValue(Add(base, HTKConst.T_COL), HTKState.col)
        ReturnValue(idx)
    }
}

// =============================================================================
// CHARACTER NAVIGATION
// =============================================================================
Function.HTK__Peek {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(HTKState.pos, HTKState.src_len) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(GetByte(HTKState.source, HTKState.pos))
    }
}

Function.HTK__PeekAt {
    Input: offset: Integer
    Output: Integer
    Body: {
        p = Add(HTKState.pos, offset)
        IfCondition GreaterEqual(p, HTKState.src_len) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(GetByte(HTKState.source, p))
    }
}

Function.HTK__Advance {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(HTKState.pos, HTKState.src_len) ThenBlock: {
            ReturnValue(0)
        }
        ch = GetByte(HTKState.source, HTKState.pos)
        HTKState.pos = Add(HTKState.pos, 1)
        IfCondition EqualTo(ch, 10) ThenBlock: {
            HTKState.line = Add(HTKState.line, 1)
            HTKState.col = 1
        }
        IfCondition NotEqual(ch, 10) ThenBlock: {
            HTKState.col = Add(HTKState.col, 1)
        }
        ReturnValue(ch)
    }
}

Function.HTK__SkipWS {
    Output: Integer
    Body: {
        HTKTmp.ch = HTK__Peek()
        WhileLoop Or(Or(EqualTo(HTKTmp.ch, 32), EqualTo(HTKTmp.ch, 9)),
                     Or(Or(EqualTo(HTKTmp.ch, 10), EqualTo(HTKTmp.ch, 13)),
                        EqualTo(HTKTmp.ch, 12))) {
            HTK__Advance()
            HTKTmp.ch = HTK__Peek()
        }
        ReturnValue(0)
    }
}

// =============================================================================
// CHARACTER CLASSIFICATION
// =============================================================================
Function.HTK__IsWS {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ch, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 13) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.HTK__IsNameChar {
    Input: ch: Integer
    Output: Integer
    Body: {
        // Per HTML spec: tag name chars are anything except whitespace, >, /, null
        IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 32) ThenBlock: { ReturnValue(0) }    // space
        IfCondition EqualTo(ch, 9) ThenBlock: { ReturnValue(0) }     // tab
        IfCondition EqualTo(ch, 10) ThenBlock: { ReturnValue(0) }    // LF
        IfCondition EqualTo(ch, 13) ThenBlock: { ReturnValue(0) }    // CR
        IfCondition EqualTo(ch, 12) ThenBlock: { ReturnValue(0) }    // FF
        IfCondition EqualTo(ch, 62) ThenBlock: { ReturnValue(0) }    // >
        IfCondition EqualTo(ch, 47) ThenBlock: { ReturnValue(0) }    // /
        ReturnValue(1)
    }
}

Function.HTK__IsNameStart {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Attribute name chars: any char except whitespace, >, /, =, null
// Note: ", ' are valid attr name chars per spec (parse errors but still valid)
Function.HTK__IsAttrNameChar {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 32) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 9) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 10) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 13) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 12) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 62) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 47) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 61) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Scan attribute name — like ScanName but uses IsAttrNameChar
Function.HTK__ScanAttrName {
    Output: Integer
    Body: {
        HTKTmp.start = HTKState.pos
        HTKTmp.ch = HTK__Peek()
        HTKTmp.done = HTK__IsAttrNameChar(HTKTmp.ch)
        WhileLoop EqualTo(HTKTmp.done, 1) {
            HTK__Advance()
            HTKTmp.ch = HTK__Peek()
            HTKTmp.done = HTK__IsAttrNameChar(HTKTmp.ch)
        }
        HTKTmp.len = Subtract(HTKState.pos, HTKTmp.start)
        IfCondition EqualTo(HTKTmp.len, 0) ThenBlock: {
            HTKTmp.ptr = 0
            ReturnValue(0)
        }
        HTKTmp.ptr = HTK__InternLower(Add(HTKState.source, HTKTmp.start), HTKTmp.len)
        ReturnValue(HTKTmp.len)
    }
}

// =============================================================================
// ENTITY DECODING — &amp; &lt; &gt; &quot; &apos; &nbsp; &#NNN; &#xHHH;
// Returns decoded byte value or -1 on failure.
// Advances HTKState.pos past the entity (including trailing ;).
// =============================================================================
Function.HTK__HexVal {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
            ReturnValue(Subtract(ch, 48))
        }
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: {
            ReturnValue(Add(Subtract(ch, 97), 10))
        }
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: {
            ReturnValue(Add(Subtract(ch, 65), 10))
        }
        ReturnValue(-1)
    }
}

// Write a Unicode codepoint as UTF-8 bytes into HTKTmp.buf at HTKTmp.di.
// Advances HTKTmp.di by number of bytes written.
// Handles: 0=U+FFFD, surrogates(D800-DFFF)=U+FFFD, >10FFFF=U+FFFD
Function.HTK__WriteUTF8 {
    Input: cp: Integer
    Output: Integer
    Body: {
        // Null, surrogates, and out-of-range → U+FFFD
        IfCondition EqualTo(cp, 0) ThenBlock: {
            SetByte(HTKTmp.buf, HTKTmp.di, 239)
            SetByte(HTKTmp.buf, Add(HTKTmp.di, 1), 191)
            SetByte(HTKTmp.buf, Add(HTKTmp.di, 2), 189)
            HTKTmp.di = Add(HTKTmp.di, 3)
            ReturnValue(3)
        }
        IfCondition And(GreaterEqual(cp, 55296), LessEqual(cp, 57343)) ThenBlock: {
            SetByte(HTKTmp.buf, HTKTmp.di, 239)
            SetByte(HTKTmp.buf, Add(HTKTmp.di, 1), 191)
            SetByte(HTKTmp.buf, Add(HTKTmp.di, 2), 189)
            HTKTmp.di = Add(HTKTmp.di, 3)
            ReturnValue(3)
        }
        IfCondition GreaterThan(cp, 1114111) ThenBlock: {
            SetByte(HTKTmp.buf, HTKTmp.di, 239)
            SetByte(HTKTmp.buf, Add(HTKTmp.di, 1), 191)
            SetByte(HTKTmp.buf, Add(HTKTmp.di, 2), 189)
            HTKTmp.di = Add(HTKTmp.di, 3)
            ReturnValue(3)
        }
        // 1-byte: 0x01-0x7F
        IfCondition LessEqual(cp, 127) ThenBlock: {
            SetByte(HTKTmp.buf, HTKTmp.di, cp)
            HTKTmp.di = Add(HTKTmp.di, 1)
            ReturnValue(1)
        }
        // 2-byte: 0x80-0x7FF → 110xxxxx 10xxxxxx
        IfCondition LessEqual(cp, 2047) ThenBlock: {
            SetByte(HTKTmp.buf, HTKTmp.di, BitwiseOr(192, ShiftRight(cp, 6)))
            SetByte(HTKTmp.buf, Add(HTKTmp.di, 1), BitwiseOr(128, BitwiseAnd(cp, 63)))
            HTKTmp.di = Add(HTKTmp.di, 2)
            ReturnValue(2)
        }
        // 3-byte: 0x800-0xFFFF → 1110xxxx 10xxxxxx 10xxxxxx
        IfCondition LessEqual(cp, 65535) ThenBlock: {
            SetByte(HTKTmp.buf, HTKTmp.di, BitwiseOr(224, ShiftRight(cp, 12)))
            SetByte(HTKTmp.buf, Add(HTKTmp.di, 1), BitwiseOr(128, BitwiseAnd(ShiftRight(cp, 6), 63)))
            SetByte(HTKTmp.buf, Add(HTKTmp.di, 2), BitwiseOr(128, BitwiseAnd(cp, 63)))
            HTKTmp.di = Add(HTKTmp.di, 3)
            ReturnValue(3)
        }
        // 4-byte: 0x10000-0x10FFFF → 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
        SetByte(HTKTmp.buf, HTKTmp.di, BitwiseOr(240, ShiftRight(cp, 18)))
        SetByte(HTKTmp.buf, Add(HTKTmp.di, 1), BitwiseOr(128, BitwiseAnd(ShiftRight(cp, 12), 63)))
        SetByte(HTKTmp.buf, Add(HTKTmp.di, 2), BitwiseOr(128, BitwiseAnd(ShiftRight(cp, 6), 63)))
        SetByte(HTKTmp.buf, Add(HTKTmp.di, 3), BitwiseOr(128, BitwiseAnd(cp, 63)))
        HTKTmp.di = Add(HTKTmp.di, 4)
        ReturnValue(4)
    }
}

// Check if named entity without semicolon should be consumed in attribute context.
// Returns 1 if entity should NOT be consumed (attr context + next char is = or alnum).
Function.HTK__AttrEntityBlock {
    Output: Integer
    Body: {
        IfCondition EqualTo(HTKTmp.in_attr, 0) ThenBlock: { ReturnValue(0) }
        HTKTmp.ch3 = HTK__Peek()
        // '=' = 61
        IfCondition EqualTo(HTKTmp.ch3, 61) ThenBlock: { ReturnValue(1) }
        // 0-9
        IfCondition And(GreaterEqual(HTKTmp.ch3, 48), LessEqual(HTKTmp.ch3, 57)) ThenBlock: { ReturnValue(1) }
        // A-Z
        IfCondition And(GreaterEqual(HTKTmp.ch3, 65), LessEqual(HTKTmp.ch3, 90)) ThenBlock: { ReturnValue(1) }
        // a-z
        IfCondition And(GreaterEqual(HTKTmp.ch3, 97), LessEqual(HTKTmp.ch3, 122)) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Decode entity starting AFTER the '&'. Advances pos past entity.
// Returns Unicode codepoint (>=0), or -1 if not recognized.
// On failure (-1), pos is restored to right after '&' so caller can emit raw text.
// Caller must pass result to HTK__WriteUTF8 to emit the bytes.
Function.HTK__DecodeEntity {
    Output: Integer
    Body: {
        HTKTmp.start = HTKState.pos
        HTKTmp.ch = HTK__Peek()

        // Numeric: &#NNN; or &#xHHH;
        IfCondition EqualTo(HTKTmp.ch, 35) ThenBlock: {
            HTK__Advance()
            HTKTmp.ch = HTK__Peek()
            // Hex: &#x
            IfCondition Or(EqualTo(HTKTmp.ch, 120), EqualTo(HTKTmp.ch, 88)) ThenBlock: {
                HTK__Advance()
                HTKTmp.ent_val = 0
                HTKTmp.len = 0
                HTKTmp.ch = HTK__Peek()
                HTKTmp.ch2 = HTK__HexVal(HTKTmp.ch)
                WhileLoop NotEqual(HTKTmp.ch2, -1) {
                    HTKTmp.ent_val = Add(Multiply(HTKTmp.ent_val, 16), HTKTmp.ch2)
                    // Cap at a safe large value to avoid 64-bit overflow
                    IfCondition GreaterThan(HTKTmp.ent_val, 1114112) ThenBlock: {
                        HTKTmp.ent_val = 1114112
                    }
                    HTKTmp.len = Add(HTKTmp.len, 1)
                    HTK__Advance()
                    HTKTmp.ch = HTK__Peek()
                    HTKTmp.ch2 = HTK__HexVal(HTKTmp.ch)
                }
                IfCondition EqualTo(HTKTmp.len, 0) ThenBlock: {
                    HTKState.pos = HTKTmp.start
                    ReturnValue(-1)
                }
                IfCondition EqualTo(HTKTmp.ch, 59) ThenBlock: { HTK__Advance() }
                ReturnValue(HTKTmp.ent_val)
            }
            // Decimal: &#NNN
            HTKTmp.ent_val = 0
            HTKTmp.len = 0
            WhileLoop And(GreaterEqual(HTKTmp.ch, 48), LessEqual(HTKTmp.ch, 57)) {
                HTKTmp.ent_val = Add(Multiply(HTKTmp.ent_val, 10), Subtract(HTKTmp.ch, 48))
                IfCondition GreaterThan(HTKTmp.ent_val, 1114112) ThenBlock: {
                    HTKTmp.ent_val = 1114112
                }
                HTKTmp.len = Add(HTKTmp.len, 1)
                HTK__Advance()
                HTKTmp.ch = HTK__Peek()
            }
            IfCondition EqualTo(HTKTmp.len, 0) ThenBlock: {
                HTKState.pos = HTKTmp.start
                ReturnValue(-1)
            }
            IfCondition EqualTo(HTKTmp.ch, 59) ThenBlock: { HTK__Advance() }
            ReturnValue(HTKTmp.ent_val)
        }

        // Named entities — scan letters
        HTKTmp.len = 0
        WhileLoop And(Or(And(GreaterEqual(HTKTmp.ch, 97), LessEqual(HTKTmp.ch, 122)),
                         And(GreaterEqual(HTKTmp.ch, 65), LessEqual(HTKTmp.ch, 90))),
                      LessThan(HTKTmp.len, 16)) {
            HTK__Advance()
            HTKTmp.len = Add(HTKTmp.len, 1)
            HTKTmp.ch = HTK__Peek()
        }

        // Match known entities
        // Strategy: if semicolon present, try exact match for full name.
        // Then try longest prefix match (legacy entities work without semicolon).
        HTKTmp.ptr = Add(HTKState.source, HTKTmp.start)
        HTKTmp.ent_val = -1

        // With semicolon: try exact-length matches first
        IfCondition EqualTo(HTKTmp.ch, 59) ThenBlock: {
            // &notin; (5 chars: n o t i n) → U+2209
            IfCondition And(EqualTo(HTKTmp.len, 5), EqualTo(HTKTmp.ent_val, -1)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(HTKTmp.ptr, 0), 110),
                               And(EqualTo(GetByte(HTKTmp.ptr, 1), 111),
                                   And(EqualTo(GetByte(HTKTmp.ptr, 2), 116),
                                       And(EqualTo(GetByte(HTKTmp.ptr, 3), 105),
                                           EqualTo(GetByte(HTKTmp.ptr, 4), 110))))) ThenBlock: {
                    HTK__Advance()
                    ReturnValue(8713)
                }
            }
        }

        // Try prefix matches (with or without semicolon)
        // For each: if semicolon, consume and return. If no semicolon, check attr context rule.
        // &amp; (3 chars: a m p)
        IfCondition And(GreaterEqual(HTKTmp.len, 3), EqualTo(HTKTmp.ent_val, -1)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(HTKTmp.ptr, 0), 97),
                           And(EqualTo(GetByte(HTKTmp.ptr, 1), 109),
                               EqualTo(GetByte(HTKTmp.ptr, 2), 112))) ThenBlock: {
                HTKState.pos = Add(HTKTmp.start, 3)
                HTKTmp.ch = HTK__Peek()
                IfCondition EqualTo(HTKTmp.ch, 59) ThenBlock: { HTK__Advance() ReturnValue(38) }
                HTKTmp.ch3 = HTK__AttrEntityBlock()
                IfCondition EqualTo(HTKTmp.ch3, 1) ThenBlock: { HTKState.pos = HTKTmp.start ReturnValue(-1) }
                ReturnValue(38)
            }
        }
        // &lt; (2 chars: l t)
        IfCondition And(GreaterEqual(HTKTmp.len, 2), EqualTo(HTKTmp.ent_val, -1)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(HTKTmp.ptr, 0), 108),
                           EqualTo(GetByte(HTKTmp.ptr, 1), 116)) ThenBlock: {
                HTKState.pos = Add(HTKTmp.start, 2)
                HTKTmp.ch = HTK__Peek()
                IfCondition EqualTo(HTKTmp.ch, 59) ThenBlock: { HTK__Advance() ReturnValue(60) }
                HTKTmp.ch3 = HTK__AttrEntityBlock()
                IfCondition EqualTo(HTKTmp.ch3, 1) ThenBlock: { HTKState.pos = HTKTmp.start ReturnValue(-1) }
                ReturnValue(60)
            }
            // &gt;
            IfCondition And(EqualTo(GetByte(HTKTmp.ptr, 0), 103),
                           EqualTo(GetByte(HTKTmp.ptr, 1), 116)) ThenBlock: {
                HTKState.pos = Add(HTKTmp.start, 2)
                HTKTmp.ch = HTK__Peek()
                IfCondition EqualTo(HTKTmp.ch, 59) ThenBlock: { HTK__Advance() ReturnValue(62) }
                HTKTmp.ch3 = HTK__AttrEntityBlock()
                IfCondition EqualTo(HTKTmp.ch3, 1) ThenBlock: { HTKState.pos = HTKTmp.start ReturnValue(-1) }
                ReturnValue(62)
            }
        }
        // &not; (3 chars: n o t) → U+00AC — also matches as prefix of &notin etc.
        IfCondition And(GreaterEqual(HTKTmp.len, 3), EqualTo(HTKTmp.ent_val, -1)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(HTKTmp.ptr, 0), 110),
                           And(EqualTo(GetByte(HTKTmp.ptr, 1), 111),
                               EqualTo(GetByte(HTKTmp.ptr, 2), 116))) ThenBlock: {
                HTKState.pos = Add(HTKTmp.start, 3)
                HTKTmp.ch = HTK__Peek()
                IfCondition EqualTo(HTKTmp.ch, 59) ThenBlock: { HTK__Advance() ReturnValue(172) }
                HTKTmp.ch3 = HTK__AttrEntityBlock()
                IfCondition EqualTo(HTKTmp.ch3, 1) ThenBlock: { HTKState.pos = HTKTmp.start ReturnValue(-1) }
                ReturnValue(172)
            }
        }
        // &quot; (4 chars: q u o t)
        IfCondition And(GreaterEqual(HTKTmp.len, 4), EqualTo(HTKTmp.ent_val, -1)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(HTKTmp.ptr, 0), 113),
                           And(EqualTo(GetByte(HTKTmp.ptr, 1), 117),
                               And(EqualTo(GetByte(HTKTmp.ptr, 2), 111),
                                   EqualTo(GetByte(HTKTmp.ptr, 3), 116)))) ThenBlock: {
                HTKState.pos = Add(HTKTmp.start, 4)
                HTKTmp.ch = HTK__Peek()
                IfCondition EqualTo(HTKTmp.ch, 59) ThenBlock: { HTK__Advance() ReturnValue(34) }
                HTKTmp.ch3 = HTK__AttrEntityBlock()
                IfCondition EqualTo(HTKTmp.ch3, 1) ThenBlock: { HTKState.pos = HTKTmp.start ReturnValue(-1) }
                ReturnValue(34)
            }
        }
        // &apos; (4 chars: a p o s)
        IfCondition And(GreaterEqual(HTKTmp.len, 4), EqualTo(HTKTmp.ent_val, -1)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(HTKTmp.ptr, 0), 97),
                           And(EqualTo(GetByte(HTKTmp.ptr, 1), 112),
                               And(EqualTo(GetByte(HTKTmp.ptr, 2), 111),
                                   EqualTo(GetByte(HTKTmp.ptr, 3), 115)))) ThenBlock: {
                HTKState.pos = Add(HTKTmp.start, 4)
                HTKTmp.ch = HTK__Peek()
                IfCondition EqualTo(HTKTmp.ch, 59) ThenBlock: { HTK__Advance() ReturnValue(39) }
                HTKTmp.ch3 = HTK__AttrEntityBlock()
                IfCondition EqualTo(HTKTmp.ch3, 1) ThenBlock: { HTKState.pos = HTKTmp.start ReturnValue(-1) }
                ReturnValue(39)
            }
        }
        // &nbsp; (4 chars: n b s p)
        IfCondition And(GreaterEqual(HTKTmp.len, 4), EqualTo(HTKTmp.ent_val, -1)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(HTKTmp.ptr, 0), 110),
                           And(EqualTo(GetByte(HTKTmp.ptr, 1), 98),
                               And(EqualTo(GetByte(HTKTmp.ptr, 2), 115),
                                   EqualTo(GetByte(HTKTmp.ptr, 3), 112)))) ThenBlock: {
                HTKState.pos = Add(HTKTmp.start, 4)
                HTKTmp.ch = HTK__Peek()
                IfCondition EqualTo(HTKTmp.ch, 59) ThenBlock: { HTK__Advance() ReturnValue(160) }
                HTKTmp.ch3 = HTK__AttrEntityBlock()
                IfCondition EqualTo(HTKTmp.ch3, 1) ThenBlock: { HTKState.pos = HTKTmp.start ReturnValue(-1) }
                ReturnValue(160)
            }
        }
        // &copy; or &COPY; (4 chars: c/C o/O p/P y/Y) → U+00A9
        IfCondition And(GreaterEqual(HTKTmp.len, 4), EqualTo(HTKTmp.ent_val, -1)) ThenBlock: {
            IfCondition And(Or(EqualTo(GetByte(HTKTmp.ptr, 0), 99), EqualTo(GetByte(HTKTmp.ptr, 0), 67)),
                           And(Or(EqualTo(GetByte(HTKTmp.ptr, 1), 111), EqualTo(GetByte(HTKTmp.ptr, 1), 79)),
                               And(Or(EqualTo(GetByte(HTKTmp.ptr, 2), 112), EqualTo(GetByte(HTKTmp.ptr, 2), 80)),
                                   Or(EqualTo(GetByte(HTKTmp.ptr, 3), 121), EqualTo(GetByte(HTKTmp.ptr, 3), 89))))) ThenBlock: {
                HTKState.pos = Add(HTKTmp.start, 4)
                HTKTmp.ch = HTK__Peek()
                IfCondition EqualTo(HTKTmp.ch, 59) ThenBlock: { HTK__Advance() ReturnValue(169) }
                HTKTmp.ch3 = HTK__AttrEntityBlock()
                IfCondition EqualTo(HTKTmp.ch3, 1) ThenBlock: { HTKState.pos = HTKTmp.start ReturnValue(-1) }
                ReturnValue(169)
            }
        }

        // Unknown entity — restore position, return -1
        HTKState.pos = HTKTmp.start
        ReturnValue(-1)
    }
}

// =============================================================================
// VOID ELEMENT DETECTION — tags that must not have a close tag
// =============================================================================
Function.HTK__IsVoid {
    Input: name: Address
    Input: len: Integer
    Output: Integer
    Body: {
        // Quick reject by length
        IfCondition LessThan(len, 2) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(len, 8) ThenBlock: { ReturnValue(0) }

        c0 = GetByte(name, 0)
        // br (2)
        IfCondition And(EqualTo(c0, 98), EqualTo(len, 2)) ThenBlock: {
            IfCondition EqualTo(GetByte(name, 1), 114) ThenBlock: { ReturnValue(1) }
        }
        // hr (2)
        IfCondition And(EqualTo(c0, 104), EqualTo(len, 2)) ThenBlock: {
            IfCondition EqualTo(GetByte(name, 1), 114) ThenBlock: { ReturnValue(1) }
        }
        // img (3)
        IfCondition And(EqualTo(c0, 105), EqualTo(len, 3)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 109), EqualTo(GetByte(name, 2), 103)) ThenBlock: {
                ReturnValue(1)
            }
        }
        // input (5)
        IfCondition And(EqualTo(c0, 105), EqualTo(len, 5)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 110), EqualTo(GetByte(name, 2), 112)) ThenBlock: {
                ReturnValue(1)
            }
        }
        // meta (4)
        IfCondition And(EqualTo(c0, 109), EqualTo(len, 4)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 101), EqualTo(GetByte(name, 2), 116)) ThenBlock: {
                ReturnValue(1)
            }
        }
        // link (4)
        IfCondition And(EqualTo(c0, 108), EqualTo(len, 4)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 105), EqualTo(GetByte(name, 2), 110)) ThenBlock: {
                ReturnValue(1)
            }
        }
        // base (4)
        IfCondition And(EqualTo(c0, 98), EqualTo(len, 4)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 97), EqualTo(GetByte(name, 2), 115)) ThenBlock: {
                ReturnValue(1)
            }
        }
        // col (3)
        IfCondition And(EqualTo(c0, 99), EqualTo(len, 3)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 111), EqualTo(GetByte(name, 2), 108)) ThenBlock: {
                ReturnValue(1)
            }
        }
        // embed (5)
        IfCondition And(EqualTo(c0, 101), EqualTo(len, 5)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 109), EqualTo(GetByte(name, 2), 98)) ThenBlock: {
                ReturnValue(1)
            }
        }
        // source (6)
        IfCondition And(EqualTo(c0, 115), EqualTo(len, 6)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 111), EqualTo(GetByte(name, 2), 117)) ThenBlock: {
                ReturnValue(1)
            }
        }
        // track (5)
        IfCondition And(EqualTo(c0, 116), EqualTo(len, 5)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 114), EqualTo(GetByte(name, 2), 97)) ThenBlock: {
                ReturnValue(1)
            }
        }
        // wbr (3)
        IfCondition And(EqualTo(c0, 119), EqualTo(len, 3)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 98), EqualTo(GetByte(name, 2), 114)) ThenBlock: {
                ReturnValue(1)
            }
        }
        // area (4)
        IfCondition And(EqualTo(c0, 97), EqualTo(len, 4)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 114), EqualTo(GetByte(name, 2), 101)) ThenBlock: {
                ReturnValue(1)
            }
        }
        // param (5)
        IfCondition And(EqualTo(c0, 112), EqualTo(len, 5)) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 1), 97), EqualTo(GetByte(name, 2), 114)) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// RAW TEXT ELEMENT DETECTION — script, style
// =============================================================================
Function.HTK__IsRawText {
    Input: name: Address
    Input: len: Integer
    Output: Integer
    Body: {
        // script (6)
        IfCondition EqualTo(len, 6) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 0), 115), EqualTo(GetByte(name, 1), 99)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(name, 2), 114), EqualTo(GetByte(name, 3), 105)) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        // style (5)
        IfCondition EqualTo(len, 5) ThenBlock: {
            IfCondition And(EqualTo(GetByte(name, 0), 115), EqualTo(GetByte(name, 1), 116)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(name, 2), 121), EqualTo(GetByte(name, 3), 108)) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SCAN TAG NAME — scan name chars, intern as lowercase
// Stores result in HTKTmp.ptr and HTKTmp.len
// =============================================================================
Function.HTK__ScanName {
    Output: Integer
    Body: {
        HTKTmp.start = HTKState.pos
        HTKTmp.ch = HTK__Peek()
        HTKTmp.done = HTK__IsNameChar(HTKTmp.ch)
        WhileLoop EqualTo(HTKTmp.done, 1) {
            HTK__Advance()
            HTKTmp.ch = HTK__Peek()
            HTKTmp.done = HTK__IsNameChar(HTKTmp.ch)
        }
        HTKTmp.len = Subtract(HTKState.pos, HTKTmp.start)
        IfCondition EqualTo(HTKTmp.len, 0) ThenBlock: {
            HTKTmp.ptr = 0
            ReturnValue(0)
        }
        HTKTmp.ptr = HTK__InternLower(Add(HTKState.source, HTKTmp.start), HTKTmp.len)
        ReturnValue(HTKTmp.len)
    }
}

// =============================================================================
// SCAN QUOTED ATTRIBUTE VALUE — handles both " and ' quotes, with entity decoding
// Quote char must be in HTKTmp.quote. Stores result in HTKTmp.ptr/HTKTmp.len.
// =============================================================================
Function.HTK__ScanQuoted {
    Output: Integer
    Body: {
        HTKTmp.buf = Allocate(4096)
        HTKTmp.di = 0
        HTKTmp.ch = HTK__Peek()
        WhileLoop And(NotEqual(HTKTmp.ch, HTKTmp.quote), NotEqual(HTKTmp.ch, 0)) {
            IfCondition EqualTo(HTKTmp.ch, 38) ThenBlock: {
                HTK__Advance()
                HTKTmp.in_attr = 1
                HTKTmp.ent_val = HTK__DecodeEntity()
                HTKTmp.in_attr = 0
                IfCondition EqualTo(HTKTmp.ent_val, -1) ThenBlock: {
                    SetByte(HTKTmp.buf, HTKTmp.di, 38)
                    HTKTmp.di = Add(HTKTmp.di, 1)
                } ElseBlock: {
                    HTK__WriteUTF8(HTKTmp.ent_val)
                }
            } ElseBlock: {
                SetByte(HTKTmp.buf, HTKTmp.di, HTKTmp.ch)
                HTKTmp.di = Add(HTKTmp.di, 1)
                HTK__Advance()
            }
            HTKTmp.ch = HTK__Peek()
        }
        IfCondition EqualTo(HTKTmp.ch, HTKTmp.quote) ThenBlock: {
            HTK__Advance()
        }
        HTKTmp.ptr = HTK__Intern(HTKTmp.buf, HTKTmp.di)
        HTKTmp.len = HTKTmp.di
        ReturnValue(0)
    }
}

// =============================================================================
// SCAN UNQUOTED ATTRIBUTE VALUE — stops at whitespace, >, /
// =============================================================================
Function.HTK__ScanUnquoted {
    Output: Integer
    Body: {
        HTKTmp.start = HTKState.pos
        HTKTmp.ch = HTK__Peek()
        WhileLoop And(And(NotEqual(HTKTmp.ch, 32), NotEqual(HTKTmp.ch, 9)),
                     And(And(NotEqual(HTKTmp.ch, 10), NotEqual(HTKTmp.ch, 13)),
                         And(And(NotEqual(HTKTmp.ch, 12), NotEqual(HTKTmp.ch, 62)),
                             NotEqual(HTKTmp.ch, 0)))) {
            HTK__Advance()
            HTKTmp.ch = HTK__Peek()
        }
        HTKTmp.len = Subtract(HTKState.pos, HTKTmp.start)
        IfCondition EqualTo(HTKTmp.len, 0) ThenBlock: {
            HTKTmp.ptr = 0
            ReturnValue(0)
        }
        HTKTmp.ptr = HTK__Intern(Add(HTKState.source, HTKTmp.start), HTKTmp.len)
        ReturnValue(0)
    }
}

// =============================================================================
// SCAN COMMENT — after <!-- detected. Scans to --> or --!>
// Uses a state machine: 0=normal, 1=saw-dash, 2=saw-dash-dash, 3=saw-dash-dash-bang
// Comment data is built in a temp buffer, with proper handling of trailing dashes.
// =============================================================================
Function.HTK__ScanComment {
    Output: Integer
    Body: {
        // Handle short comments: <!--> and <!--->
        HTKTmp.ch = HTK__Peek()
        IfCondition EqualTo(HTKTmp.ch, 62) ThenBlock: {
            // <!--> : empty comment
            HTK__Advance()
            HTKTmp.interned = HTK__Intern(HTKState.source, 0)
            HTK__AddToken(HTKType.COMMENT, HTKTmp.interned, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(HTKTmp.ch, 45) ThenBlock: {
            HTKTmp.ch2 = HTK__PeekAt(1)
            IfCondition EqualTo(HTKTmp.ch2, 62) ThenBlock: {
                // <!---> : empty comment
                HTK__Advance()
                HTK__Advance()
                HTKTmp.interned = HTK__Intern(HTKState.source, 0)
                HTK__AddToken(HTKType.COMMENT, HTKTmp.interned, 0)
                ReturnValue(0)
            }
        }

        // Allocate buffer for comment content
        HTKTmp.buf = Allocate(16384)
        HTKTmp.di = 0
        HTKTmp.cmt_state = 0
        HTKTmp.done = 0

        WhileLoop EqualTo(HTKTmp.done, 0) {
            HTKTmp.ch = HTK__Peek()
            IfCondition EqualTo(HTKTmp.ch, 0) ThenBlock: {
                // EOF — emit comment with accumulated buffer only
                // Pending dashes/bang from state machine are NOT included (they're part of end-marker)
                HTKTmp.done = 1
            }
            IfCondition EqualTo(HTKTmp.done, 0) ThenBlock: {
                // State 0: normal comment content
                IfCondition EqualTo(HTKTmp.cmt_state, 0) ThenBlock: {
                    IfCondition EqualTo(HTKTmp.ch, 45) ThenBlock: {
                        HTKTmp.cmt_state = 1
                        HTK__Advance()
                    } ElseBlock: {
                        // CR→LF normalization
                        IfCondition EqualTo(HTKTmp.ch, 13) ThenBlock: {
                            SetByte(HTKTmp.buf, HTKTmp.di, 10)
                            HTKTmp.di = Add(HTKTmp.di, 1)
                            HTK__Advance()
                            HTKTmp.ch2 = HTK__Peek()
                            IfCondition EqualTo(HTKTmp.ch2, 10) ThenBlock: { HTK__Advance() }
                        } ElseBlock: {
                            SetByte(HTKTmp.buf, HTKTmp.di, HTKTmp.ch)
                            HTKTmp.di = Add(HTKTmp.di, 1)
                            HTK__Advance()
                        }
                    }
                } ElseBlock: {
                // State 1: saw one dash
                IfCondition EqualTo(HTKTmp.cmt_state, 1) ThenBlock: {
                    IfCondition EqualTo(HTKTmp.ch, 45) ThenBlock: {
                        HTKTmp.cmt_state = 2
                        HTK__Advance()
                    } ElseBlock: {
                        SetByte(HTKTmp.buf, HTKTmp.di, 45)
                        HTKTmp.di = Add(HTKTmp.di, 1)
                        SetByte(HTKTmp.buf, HTKTmp.di, HTKTmp.ch)
                        HTKTmp.di = Add(HTKTmp.di, 1)
                        HTKTmp.cmt_state = 0
                        HTK__Advance()
                    }
                } ElseBlock: {
                // State 2: saw two dashes (--)
                IfCondition EqualTo(HTKTmp.cmt_state, 2) ThenBlock: {
                    IfCondition EqualTo(HTKTmp.ch, 62) ThenBlock: {
                        HTK__Advance()
                        HTKTmp.done = 1
                    }
                    IfCondition EqualTo(HTKTmp.done, 0) ThenBlock: {
                        IfCondition EqualTo(HTKTmp.ch, 33) ThenBlock: {
                            HTKTmp.cmt_state = 3
                            HTK__Advance()
                        } ElseBlock: {
                            IfCondition EqualTo(HTKTmp.ch, 45) ThenBlock: {
                                SetByte(HTKTmp.buf, HTKTmp.di, 45)
                                HTKTmp.di = Add(HTKTmp.di, 1)
                                HTK__Advance()
                            } ElseBlock: {
                                SetByte(HTKTmp.buf, HTKTmp.di, 45)
                                HTKTmp.di = Add(HTKTmp.di, 1)
                                SetByte(HTKTmp.buf, HTKTmp.di, 45)
                                HTKTmp.di = Add(HTKTmp.di, 1)
                                SetByte(HTKTmp.buf, HTKTmp.di, HTKTmp.ch)
                                HTKTmp.di = Add(HTKTmp.di, 1)
                                HTKTmp.cmt_state = 0
                                HTK__Advance()
                            }
                        }
                    }
                } ElseBlock: {
                // State 3: saw --!
                IfCondition EqualTo(HTKTmp.cmt_state, 3) ThenBlock: {
                    IfCondition EqualTo(HTKTmp.ch, 62) ThenBlock: {
                        HTK__Advance()
                        HTKTmp.done = 1
                    }
                    IfCondition EqualTo(HTKTmp.done, 0) ThenBlock: {
                        IfCondition EqualTo(HTKTmp.ch, 45) ThenBlock: {
                            SetByte(HTKTmp.buf, HTKTmp.di, 45)
                            HTKTmp.di = Add(HTKTmp.di, 1)
                            SetByte(HTKTmp.buf, HTKTmp.di, 45)
                            HTKTmp.di = Add(HTKTmp.di, 1)
                            SetByte(HTKTmp.buf, HTKTmp.di, 33)
                            HTKTmp.di = Add(HTKTmp.di, 1)
                            HTKTmp.cmt_state = 1
                            HTK__Advance()
                        } ElseBlock: {
                            SetByte(HTKTmp.buf, HTKTmp.di, 45)
                            HTKTmp.di = Add(HTKTmp.di, 1)
                            SetByte(HTKTmp.buf, HTKTmp.di, 45)
                            HTKTmp.di = Add(HTKTmp.di, 1)
                            SetByte(HTKTmp.buf, HTKTmp.di, 33)
                            HTKTmp.di = Add(HTKTmp.di, 1)
                            SetByte(HTKTmp.buf, HTKTmp.di, HTKTmp.ch)
                            HTKTmp.di = Add(HTKTmp.di, 1)
                            HTKTmp.cmt_state = 0
                            HTK__Advance()
                        }
                    }
                }
                }
                }
                }
            }
        }

        // Emit comment token
        HTKTmp.interned = HTK__Intern(HTKTmp.buf, HTKTmp.di)
        HTK__AddToken(HTKType.COMMENT, HTKTmp.interned, HTKTmp.di)
        ReturnValue(0)
    }
}

// =============================================================================
// CHECK DOCTYPE KEYWORD — returns 1 if next 7 chars at pos are DOCTYPE (case-insensitive)
// Uses HTKTmp.ch to check each character sequentially (clobber-safe).
// =============================================================================
Function.HTK__IsDoctypeKW {
    Output: Integer
    Body: {
        // D/d = 68/100
        HTKTmp.ch = HTK__PeekAt(0)
        IfCondition And(NotEqual(HTKTmp.ch, 68), NotEqual(HTKTmp.ch, 100)) ThenBlock: { ReturnValue(0) }
        // O/o = 79/111
        HTKTmp.ch = HTK__PeekAt(1)
        IfCondition And(NotEqual(HTKTmp.ch, 79), NotEqual(HTKTmp.ch, 111)) ThenBlock: { ReturnValue(0) }
        // C/c = 67/99
        HTKTmp.ch = HTK__PeekAt(2)
        IfCondition And(NotEqual(HTKTmp.ch, 67), NotEqual(HTKTmp.ch, 99)) ThenBlock: { ReturnValue(0) }
        // T/t = 84/116
        HTKTmp.ch = HTK__PeekAt(3)
        IfCondition And(NotEqual(HTKTmp.ch, 84), NotEqual(HTKTmp.ch, 116)) ThenBlock: { ReturnValue(0) }
        // Y/y = 89/121
        HTKTmp.ch = HTK__PeekAt(4)
        IfCondition And(NotEqual(HTKTmp.ch, 89), NotEqual(HTKTmp.ch, 121)) ThenBlock: { ReturnValue(0) }
        // P/p = 80/112
        HTKTmp.ch = HTK__PeekAt(5)
        IfCondition And(NotEqual(HTKTmp.ch, 80), NotEqual(HTKTmp.ch, 112)) ThenBlock: { ReturnValue(0) }
        // E/e = 69/101
        HTKTmp.ch = HTK__PeekAt(6)
        IfCondition And(NotEqual(HTKTmp.ch, 69), NotEqual(HTKTmp.ch, 101)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// =============================================================================
// SCAN BOGUS COMMENT — after <! (not -- or DOCTYPE) or <? or </invalid
// Everything until > is comment content.
// =============================================================================
Function.HTK__ScanBogusComment {
    Output: Integer
    Body: {
        HTKTmp.buf = Allocate(8192)
        HTKTmp.di = 0
        HTKTmp.done = 0
        WhileLoop EqualTo(HTKTmp.done, 0) {
            HTKTmp.ch = HTK__Peek()
            IfCondition EqualTo(HTKTmp.ch, 0) ThenBlock: {
                HTKTmp.done = 1
            }
            IfCondition EqualTo(HTKTmp.ch, 62) ThenBlock: {
                HTK__Advance()
                HTKTmp.done = 1
            }
            IfCondition EqualTo(HTKTmp.done, 0) ThenBlock: {
                // CR→LF normalization
                IfCondition EqualTo(HTKTmp.ch, 13) ThenBlock: {
                    SetByte(HTKTmp.buf, HTKTmp.di, 10)
                    HTKTmp.di = Add(HTKTmp.di, 1)
                    HTK__Advance()
                    HTKTmp.ch2 = HTK__Peek()
                    IfCondition EqualTo(HTKTmp.ch2, 10) ThenBlock: { HTK__Advance() }
                } ElseBlock: {
                    SetByte(HTKTmp.buf, HTKTmp.di, HTKTmp.ch)
                    HTKTmp.di = Add(HTKTmp.di, 1)
                    HTK__Advance()
                }
            }
        }
        HTKTmp.interned = HTK__Intern(HTKTmp.buf, HTKTmp.di)
        HTK__AddToken(HTKType.COMMENT, HTKTmp.interned, HTKTmp.di)
        ReturnValue(0)
    }
}

// =============================================================================
// SCAN DOCTYPE — after <!DOCTYPE detected. Pos is at char after DOCTYPE keyword.
// Handles both <!DOCTYPE html> and <!DOCTYPEhtml> (no space before name).
// =============================================================================
Function.HTK__ScanDoctype {
    Output: Integer
    Body: {
        // Skip whitespace after DOCTYPE keyword (if any)
        HTK__SkipWS()

        // Scan doctype name — accepts ANY char except whitespace, '>', and EOF
        // (not restricted to tag-name chars like ScanName)
        HTKTmp.start = HTKState.pos
        HTKTmp.ch = HTK__Peek()
        WhileLoop And(And(NotEqual(HTKTmp.ch, 62), NotEqual(HTKTmp.ch, 0)),
                      And(And(NotEqual(HTKTmp.ch, 32), NotEqual(HTKTmp.ch, 9)),
                          And(And(NotEqual(HTKTmp.ch, 10), NotEqual(HTKTmp.ch, 13)),
                              NotEqual(HTKTmp.ch, 12)))) {
            HTK__Advance()
            HTKTmp.ch = HTK__Peek()
        }
        HTKTmp.len = Subtract(HTKState.pos, HTKTmp.start)
        IfCondition GreaterThan(HTKTmp.len, 0) ThenBlock: {
            HTKTmp.tag_name = HTK__InternLower(Add(HTKState.source, HTKTmp.start), HTKTmp.len)
            HTKTmp.tag_len = HTKTmp.len
        } ElseBlock: {
            HTKTmp.tag_name = 0
            HTKTmp.tag_len = 0
        }

        // Skip rest until '>'
        HTKTmp.ch = HTK__Peek()
        WhileLoop And(NotEqual(HTKTmp.ch, 62), NotEqual(HTKTmp.ch, 0)) {
            HTK__Advance()
            HTKTmp.ch = HTK__Peek()
        }
        IfCondition EqualTo(HTKTmp.ch, 62) ThenBlock: {
            HTK__Advance()
        }
        HTK__AddToken(HTKType.DOCTYPE, HTKTmp.tag_name, HTKTmp.tag_len)
        ReturnValue(0)
    }
}

// =============================================================================
// SCAN RAW TEXT — content of <script> or <style> until matching </tag>
// Tag name must be in HTKTmp.tag_name/HTKTmp.tag_len
// =============================================================================
Function.HTK__ScanRawText {
    Output: Integer
    Body: {
        HTKTmp.start = HTKState.pos
        HTKTmp.done = 0

        WhileLoop EqualTo(HTKTmp.done, 0) {
            HTKTmp.ch = HTK__Peek()
            IfCondition EqualTo(HTKTmp.ch, 0) ThenBlock: {
                HTKTmp.done = 1
            }
            // Look for </
            IfCondition EqualTo(HTKTmp.ch, 60) ThenBlock: {
                HTKTmp.ch2 = HTK__PeekAt(1)
                IfCondition EqualTo(HTKTmp.ch2, 47) ThenBlock: {
                    // Check if following name matches tag_name (case-insensitive)
                    mi = 0
                    match = 1
                    WhileLoop LessThan(mi, HTKTmp.tag_len) {
                        mc = HTK__PeekAt(Add(2, mi))
                        // lowercase
                        IfCondition And(GreaterEqual(mc, 65), LessEqual(mc, 90)) ThenBlock: {
                            mc = Add(mc, 32)
                        }
                        tc = GetByte(HTKTmp.tag_name, mi)
                        IfCondition NotEqual(mc, tc) ThenBlock: {
                            match = 0
                        }
                        mi = Add(mi, 1)
                    }
                    // Check char after name is > or whitespace
                    IfCondition EqualTo(match, 1) ThenBlock: {
                        ec = HTK__PeekAt(Add(2, HTKTmp.tag_len))
                        IfCondition Or(EqualTo(ec, 62), Or(EqualTo(ec, 32), EqualTo(ec, 9))) ThenBlock: {
                            // Emit raw text content
                            HTKTmp.len = Subtract(HTKState.pos, HTKTmp.start)
                            IfCondition GreaterThan(HTKTmp.len, 0) ThenBlock: {
                                HTKTmp.interned = HTK__Intern(Add(HTKState.source, HTKTmp.start), HTKTmp.len)
                                HTK__AddToken(HTKType.TEXT, HTKTmp.interned, HTKTmp.len)
                            }
                            // Consume </ + tag name
                            HTK__Advance()
                            HTK__Advance()
                            ci = 0
                            WhileLoop LessThan(ci, HTKTmp.tag_len) {
                                HTK__Advance()
                                ci = Add(ci, 1)
                            }
                            // Skip whitespace and consume >
                            HTK__SkipWS()
                            HTKTmp.ch3 = HTK__Peek()
                            IfCondition EqualTo(HTKTmp.ch3, 62) ThenBlock: {
                                HTK__Advance()
                            }
                            // Emit TAG_CLOSE
                            HTK__AddToken(HTKType.TAG_CLOSE, HTKTmp.tag_name, HTKTmp.tag_len)
                            HTKTmp.done = 1
                        }
                    }
                }
            }
            IfCondition EqualTo(HTKTmp.done, 0) ThenBlock: {
                HTK__Advance()
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SCAN TEXT CONTENT — between tags, with entity decoding
// =============================================================================
Function.HTK__ScanText {
    Output: Integer
    Body: {
        HTKTmp.buf = Allocate(8192)
        HTKTmp.di = 0
        HTKTmp.ch = HTK__Peek()

        WhileLoop And(NotEqual(HTKTmp.ch, 60), NotEqual(HTKTmp.ch, 0)) {
            IfCondition EqualTo(HTKTmp.ch, 38) ThenBlock: {
                // Entity — try to decode
                HTK__Advance()
                HTKTmp.ent_val = HTK__DecodeEntity()
                IfCondition EqualTo(HTKTmp.ent_val, -1) ThenBlock: {
                    // Not a recognized entity — emit '&' literally, pos already restored
                    SetByte(HTKTmp.buf, HTKTmp.di, 38)
                    HTKTmp.di = Add(HTKTmp.di, 1)
                } ElseBlock: {
                    HTK__WriteUTF8(HTKTmp.ent_val)
                }
            } ElseBlock: {
                // CR normalization: CR → LF, skip LF after CR
                IfCondition EqualTo(HTKTmp.ch, 13) ThenBlock: {
                    SetByte(HTKTmp.buf, HTKTmp.di, 10)
                    HTKTmp.di = Add(HTKTmp.di, 1)
                    HTK__Advance()
                    // Skip LF following CR (CRLF → single LF)
                    HTKTmp.ch2 = HTK__Peek()
                    IfCondition EqualTo(HTKTmp.ch2, 10) ThenBlock: {
                        HTK__Advance()
                    }
                } ElseBlock: {
                    SetByte(HTKTmp.buf, HTKTmp.di, HTKTmp.ch)
                    HTKTmp.di = Add(HTKTmp.di, 1)
                    HTK__Advance()
                }
            }
            HTKTmp.ch = HTK__Peek()
        }

        // Emit all text tokens including whitespace-only
        IfCondition GreaterThan(HTKTmp.di, 0) ThenBlock: {
            HTKTmp.interned = HTK__Intern(HTKTmp.buf, HTKTmp.di)
            HTK__AddToken(HTKType.TEXT, HTKTmp.interned, HTKTmp.di)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SCAN ATTRIBUTES on current open tag
// =============================================================================
Function.HTK__ScanAttrs {
    Output: Integer
    Body: {
        HTK__SkipWS()
        HTKTmp.ch = HTK__Peek()
        HTKTmp.done = 0

        WhileLoop EqualTo(HTKTmp.done, 0) {
            // End of tag?
            IfCondition Or(EqualTo(HTKTmp.ch, 62), Or(EqualTo(HTKTmp.ch, 47), EqualTo(HTKTmp.ch, 0))) ThenBlock: {
                HTKTmp.done = 1
            }

            IfCondition EqualTo(HTKTmp.done, 0) ThenBlock: {
                // Scan attribute name (broader char set than tag names)
                HTK__ScanAttrName()
                IfCondition EqualTo(HTKTmp.len, 0) ThenBlock: {
                    // Check if = starts an attribute name (per spec, = is valid as attr name start)
                    HTKTmp.ch = HTK__Peek()
                    IfCondition EqualTo(HTKTmp.ch, 61) ThenBlock: {
                        // = as attribute name — intern single char
                        HTKTmp.buf = Allocate(2)
                        SetByte(HTKTmp.buf, 0, 61)
                        HTKTmp.ptr = HTK__Intern(HTKTmp.buf, 1)
                        HTKTmp.len = 1
                        HTK__Advance()
                    } ElseBlock: {
                        // Bad char — skip it
                        HTK__Advance()
                    }
                }
                IfCondition GreaterThan(HTKTmp.len, 0) ThenBlock: {
                    // Save attr name in clobber-safe FixedPool fields
                    HTKTmp.attr_name = HTKTmp.ptr
                    HTKTmp.attr_len = HTKTmp.len

                    HTK__SkipWS()
                    HTKTmp.ch = HTK__Peek()

                    // Check for = (attribute has value)
                    IfCondition EqualTo(HTKTmp.ch, 61) ThenBlock: {
                        HTK__AddToken(HTKType.ATTR_NAME, HTKTmp.attr_name, HTKTmp.attr_len)
                        HTK__Advance()
                        HTK__SkipWS()
                        HTKTmp.ch = HTK__Peek()

                        // Double quote
                        IfCondition EqualTo(HTKTmp.ch, 34) ThenBlock: {
                            HTK__Advance()
                            HTKTmp.quote = 34
                            HTK__ScanQuoted()
                            HTK__AddToken(HTKType.ATTR_VALUE, HTKTmp.ptr, HTKTmp.len)
                        } ElseBlock: {
                        // Single quote
                        IfCondition EqualTo(HTKTmp.ch, 39) ThenBlock: {
                            HTK__Advance()
                            HTKTmp.quote = 39
                            HTK__ScanQuoted()
                            HTK__AddToken(HTKType.ATTR_VALUE, HTKTmp.ptr, HTKTmp.len)
                        } ElseBlock: {
                        // Unquoted value or empty (=>)
                        IfCondition Or(EqualTo(HTKTmp.ch, 62), EqualTo(HTKTmp.ch, 0)) ThenBlock: {
                            // a=> or a=EOF : empty value
                            HTKTmp.interned = HTK__Intern(HTKState.source, 0)
                            HTK__AddToken(HTKType.ATTR_VALUE, HTKTmp.interned, 0)
                        } ElseBlock: {
                            // Unquoted value
                            HTK__ScanUnquoted()
                            HTK__AddToken(HTKType.ATTR_VALUE, HTKTmp.ptr, HTKTmp.len)
                        }
                        }
                        }
                    } ElseBlock: {
                        // No = sign: bare attribute (disabled, checked, etc.)
                        HTK__AddToken(HTKType.ATTR_BARE, HTKTmp.attr_name, HTKTmp.attr_len)
                    }
                }

                HTK__SkipWS()
                HTKTmp.ch = HTK__Peek()
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN TOKENIZE ENTRY POINT
// =============================================================================
Function.HTK_Tokenize {
    Input: source: Address
    Input: src_len: Integer
    Output: Integer
    Body: {
        HTKState.source = source
        HTKState.src_len = src_len
        HTKState.pos = 0
        HTKState.line = 1
        HTKState.col = 1
        HTKState.error = 0
        HTKState.tok_count = 0

        HTKTmp.ch = HTK__Peek()

        WhileLoop And(NotEqual(HTKTmp.ch, 0), EqualTo(HTKState.error, 0)) {

            // ─── TAG START: < ───
            IfCondition EqualTo(HTKTmp.ch, 60) ThenBlock: {
                HTK__Advance()
                HTKTmp.ch2 = HTK__Peek()

                // ─── CLOSE TAG: </ ───
                IfCondition EqualTo(HTKTmp.ch2, 47) ThenBlock: {
                    HTK__Advance()
                    HTKTmp.ch3 = HTK__Peek()
                    IfCondition EqualTo(HTKTmp.ch3, 0) ThenBlock: {
                        // </EOF : emit </ as text
                        HTKTmp.buf = Allocate(4)
                        SetByte(HTKTmp.buf, 0, 60)
                        SetByte(HTKTmp.buf, 1, 47)
                        HTKTmp.interned = HTK__Intern(HTKTmp.buf, 2)
                        HTK__AddToken(HTKType.TEXT, HTKTmp.interned, 2)
                    } ElseBlock: {
                    IfCondition EqualTo(HTKTmp.ch3, 62) ThenBlock: {
                        // </> : empty end tag — skip
                        HTK__Advance()
                    } ElseBlock: {
                        HTKTmp.done = HTK__IsNameStart(HTKTmp.ch3)
                        IfCondition EqualTo(HTKTmp.done, 1) ThenBlock: {
                            // Valid end tag name
                            HTK__ScanName()
                            IfCondition GreaterThan(HTKTmp.len, 0) ThenBlock: {
                                HTK__AddToken(HTKType.TAG_CLOSE, HTKTmp.ptr, HTKTmp.len)
                                // Skip any attributes on end tag (per spec, ignored)
                                HTKTmp.ch3 = HTK__Peek()
                                WhileLoop And(NotEqual(HTKTmp.ch3, 62), NotEqual(HTKTmp.ch3, 0)) {
                                    HTK__Advance()
                                    HTKTmp.ch3 = HTK__Peek()
                                }
                                IfCondition EqualTo(HTKTmp.ch3, 62) ThenBlock: {
                                    HTK__Advance()
                                }
                            }
                        } ElseBlock: {
                            // </non-alpha> : bogus comment
                            HTK__ScanBogusComment()
                        }
                    }
                    }

                } ElseBlock: {
                // ─── COMMENT, DOCTYPE, or BOGUS COMMENT: <! ───
                IfCondition EqualTo(HTKTmp.ch2, 33) ThenBlock: {
                    HTK__Advance()
                    // pos is now past '!', check what follows
                    HTKTmp.ch3 = HTK__Peek()
                    IfCondition EqualTo(HTKTmp.ch3, 45) ThenBlock: {
                        // <!- — check for second dash
                        HTKTmp.ch3 = HTK__PeekAt(1)
                        IfCondition EqualTo(HTKTmp.ch3, 45) ThenBlock: {
                            // <!-- : real comment
                            HTK__Advance()
                            HTK__Advance()
                            HTK__ScanComment()
                        } ElseBlock: {
                            // <!- without second dash: bogus comment
                            HTK__ScanBogusComment()
                        }
                    } ElseBlock: {
                        // Check for DOCTYPE keyword (case-insensitive)
                        HTKTmp.done = HTK__IsDoctypeKW()
                        IfCondition EqualTo(HTKTmp.done, 1) ThenBlock: {
                            // <!DOCTYPE — advance past 7-char keyword
                            HTK__Advance()
                            HTK__Advance()
                            HTK__Advance()
                            HTK__Advance()
                            HTK__Advance()
                            HTK__Advance()
                            HTK__Advance()
                            HTK__ScanDoctype()
                        } ElseBlock: {
                            // <!anything-else: bogus comment
                            HTK__ScanBogusComment()
                        }
                    }

                } ElseBlock: {
                // ─── PROCESSING INSTRUCTION: <? → bogus comment ───
                IfCondition EqualTo(HTKTmp.ch2, 63) ThenBlock: {
                    HTK__ScanBogusComment()

                } ElseBlock: {
                // ─── OPEN TAG: <tagname ───
                    // Must be a name-start character
                    HTKTmp.done = HTK__IsNameStart(HTKTmp.ch2)
                    IfCondition EqualTo(HTKTmp.done, 1) ThenBlock: {
                        HTK__ScanName()
                        IfCondition GreaterThan(HTKTmp.len, 0) ThenBlock: {
                            // Save token count so we can roll back if EOF before >
                            saved_count = HTKState.tok_count
                            HTK__AddToken(HTKType.TAG_OPEN, HTKTmp.ptr, HTKTmp.len)
                            // Save tag name for potential raw text detection
                            HTKTmp.tag_name = HTKTmp.ptr
                            HTKTmp.tag_len = HTKTmp.len

                            // Scan attributes
                            HTK__ScanAttrs()

                            // End of tag: > or /> — skip stray / chars
                            HTKTmp.ch3 = HTK__Peek()
                            is_self_close = 0
                            // Skip whitespace and stray characters before > or />
                            WhileLoop And(NotEqual(HTKTmp.ch3, 62), NotEqual(HTKTmp.ch3, 0)) {
                                IfCondition EqualTo(HTKTmp.ch3, 47) ThenBlock: {
                                    // Check for />
                                    HTKTmp.ch3 = HTK__PeekAt(1)
                                    IfCondition EqualTo(HTKTmp.ch3, 62) ThenBlock: {
                                        // /> : self-close
                                        HTK__Advance()
                                        HTK__Advance()
                                        HTK__AddToken(HTKType.TAG_SELF_CLOSE, 0, 0)
                                        is_self_close = 1
                                        HTKTmp.ch3 = 0
                                    } ElseBlock: {
                                        // /X : skip the /, scan more attrs
                                        HTK__Advance()
                                        HTK__ScanAttrs()
                                        HTKTmp.ch3 = HTK__Peek()
                                    }
                                } ElseBlock: {
                                    // Skip unexpected chars
                                    HTK__Advance()
                                    HTKTmp.ch3 = HTK__Peek()
                                }
                            }
                            IfCondition And(EqualTo(is_self_close, 0), EqualTo(HTKTmp.ch3, 62)) ThenBlock: {
                                HTK__Advance()
                                HTK__AddToken(HTKType.TAG_END, 0, 0)

                                // Check for raw text element (script/style)
                                HTKTmp.done = HTK__IsRawText(HTKTmp.tag_name, HTKTmp.tag_len)
                                IfCondition EqualTo(HTKTmp.done, 1) ThenBlock: {
                                    HTK__ScanRawText()
                                }
                            }
                            // EOF before > : roll back all tokens from this tag
                            IfCondition And(EqualTo(is_self_close, 0), EqualTo(HTKTmp.ch3, 0)) ThenBlock: {
                                HTKState.tok_count = saved_count
                            }
                        }
                    } ElseBlock: {
                        // Not a valid tag start — emit '<' as text character
                        HTKTmp.buf = Allocate(2)
                        SetByte(HTKTmp.buf, 0, 60)
                        HTKTmp.interned = HTK__Intern(HTKTmp.buf, 1)
                        HTK__AddToken(HTKType.TEXT, HTKTmp.interned, 1)
                    }
                }
                }
                }
            } ElseBlock: {
                // ─── TEXT CONTENT (not a tag start) ───
                HTK__ScanText()
            }

            HTKTmp.ch = HTK__Peek()
        }

        // EOF token
        HTK__AddToken(HTKType.EOF, 0, 0)

        IfCondition EqualTo(HTKState.error, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// PUBLIC ACCESSORS
// =============================================================================
Function.HTK_Count {
    Output: Integer
    Body: { ReturnValue(HTKState.tok_count) }
}

Function.HTK_GetType {
    Input: idx: Integer
    Output: Integer
    Body: {
        base = Add(HTKState.tok_pool, Multiply(idx, HTKConst.TOKEN_SIZE))
        ReturnValue(Dereference(Add(base, HTKConst.T_TYPE)))
    }
}

Function.HTK_GetPtr {
    Input: idx: Integer
    Output: Address
    Body: {
        base = Add(HTKState.tok_pool, Multiply(idx, HTKConst.TOKEN_SIZE))
        ReturnValue(Dereference(Add(base, HTKConst.T_PTR)))
    }
}

Function.HTK_GetLen {
    Input: idx: Integer
    Output: Integer
    Body: {
        base = Add(HTKState.tok_pool, Multiply(idx, HTKConst.TOKEN_SIZE))
        ReturnValue(Dereference(Add(base, HTKConst.T_LEN)))
    }
}

Function.HTK_GetLine {
    Input: idx: Integer
    Output: Integer
    Body: {
        base = Add(HTKState.tok_pool, Multiply(idx, HTKConst.TOKEN_SIZE))
        ReturnValue(Dereference(Add(base, HTKConst.T_LINE)))
    }
}

Function.HTK_GetCol {
    Input: idx: Integer
    Output: Integer
    Body: {
        base = Add(HTKState.tok_pool, Multiply(idx, HTKConst.TOKEN_SIZE))
        ReturnValue(Dereference(Add(base, HTKConst.T_COL)))
    }
}
