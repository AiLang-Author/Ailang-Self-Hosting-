// Library.HTTPChunked.ailang — Chunked transfer-encoding decoder
// Decodes HTTP chunked bodies in-place: strips chunk-size headers and trailers.
// Format: <hex-size>\r\n<data>\r\n ... 0\r\n\r\n
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena

// =============================================================================
// STATE — cursor positions for decode pass
// =============================================================================
FixedPool.HCKState {
    "src":  Initialize=0
    "dst":  Initialize=0
}

// =============================================================================
// HELPERS
// =============================================================================

// Parse a single hex digit, returns 0-15 or -1 if invalid
Function.HCK__HexVal {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
            ReturnValue(Subtract(c, 48))
        }
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 102)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 97), 10))
        }
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 70)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 65), 10))
        }
        ReturnValue(-1)
    }
}

// Skip forward from HCKState.src past the next LF (0x0A).
// Advances HCKState.src to the byte AFTER the LF.
// If no LF found, sets src = buf_len.
Function.HCK__SkipToLF {
    Input: buf: Address
    Input: buf_len: Integer
    Body: {
        pos = HCKState.src
        WhileLoop LessThan(pos, buf_len) {
            c = GetByte(buf, pos)
            pos = Add(pos, 1)
            IfCondition EqualTo(c, 10) ThenBlock: {
                HCKState.src = pos
                ReturnValue(0)
            }
        }
        HCKState.src = buf_len
    }
}

// Parse hex chunk-size starting at HCKState.src.
// Returns the parsed size. Advances HCKState.src past the hex digits.
// If no hex digits found, returns -1.
Function.HCK__ParseHexSize {
    Input: buf: Address
    Input: buf_len: Integer
    Output: Integer
    Body: {
        pos = HCKState.src
        val = 0
        count = 0

        hex_done = 0
        WhileLoop And(LessThan(pos, buf_len), EqualTo(hex_done, 0)) {
            c = GetByte(buf, pos)
            hv = HCK__HexVal(c)
            IfCondition GreaterEqual(hv, 0) ThenBlock: {
                val = Add(Multiply(val, 16), hv)
                count = Add(count, 1)
                pos = Add(pos, 1)
            } ElseBlock: {
                hex_done = 1
            }
        }

        HCKState.src = pos

        IfCondition EqualTo(count, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(val)
    }
}

// =============================================================================
// HTTPChunked_IsChunked — check if Transfer-Encoding header contains "chunked"
// Input:  hdrs = pointer to raw headers (before \r\n\r\n)
//         hdr_len = length of headers region
// Output: 1 if chunked, 0 if not
// =============================================================================
Function.HTTPChunked_IsChunked {
    Input: hdrs: Address
    Input: hdr_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(hdrs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(hdr_len, 0) ThenBlock: { ReturnValue(0) }

        // Search for "transfer-encoding" (case-insensitive) then "chunked"
        needle = "transfer-encoding"
        nlen = 17
        i = 0
        limit = Subtract(hdr_len, nlen)
        WhileLoop LessEqual(i, limit) {
            // Case-insensitive match of needle at position i
            match = 1
            j = 0
            WhileLoop LessThan(j, nlen) {
                c1 = GetByte(hdrs, Add(i, j))
                c2 = GetByte(needle, j)
                IfCondition And(GreaterEqual(c1, 65), LessEqual(c1, 90)) ThenBlock: {
                    c1 = Add(c1, 32)
                }
                IfCondition NotEqual(c1, c2) ThenBlock: {
                    match = 0
                    j = nlen
                }
                j = Add(j, 1)
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                // Found header name, scan value for "chunked"
                vpos = Add(i, nlen)
                WhileLoop LessThan(vpos, hdr_len) {
                    vc = GetByte(hdrs, vpos)
                    IfCondition Or(EqualTo(vc, 13), EqualTo(vc, 10)) ThenBlock: {
                        vpos = hdr_len
                    } ElseBlock: {
                        IfCondition LessEqual(Add(vpos, 7), hdr_len) ThenBlock: {
                            cm = 1
                            ck = 0
                            chunked_str = "chunked"
                            WhileLoop LessThan(ck, 7) {
                                cc1 = GetByte(hdrs, Add(vpos, ck))
                                cc2 = GetByte(chunked_str, ck)
                                IfCondition And(GreaterEqual(cc1, 65), LessEqual(cc1, 90)) ThenBlock: {
                                    cc1 = Add(cc1, 32)
                                }
                                IfCondition NotEqual(cc1, cc2) ThenBlock: {
                                    cm = 0
                                    ck = 7
                                }
                                ck = Add(ck, 1)
                            }
                            IfCondition EqualTo(cm, 1) ThenBlock: {
                                ReturnValue(1)
                            }
                        }
                        vpos = Add(vpos, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// HTTPChunked_Decode — decode chunked body in-place
// Input:  buf = pointer to raw chunked body (after HTTP headers)
//         buf_len = length of raw data
// Output: decoded length (bytes written to buf), or -1 on error
// The decoded data is written back into buf starting at offset 0.
// =============================================================================
Function.HTTPChunked_Decode {
    Input: buf: Address
    Input: buf_len: Integer
    Output: Integer
    Body: {
        HCKState.src = 0
        HCKState.dst = 0

        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition GreaterEqual(HCKState.src, buf_len) ThenBlock: {
                done = 1
            } ElseBlock: {
                // Parse hex chunk size
                chunk_size = HCK__ParseHexSize(buf, buf_len)

                IfCondition LessThan(chunk_size, 0) ThenBlock: {
                    // No hex digits — malformed, return what we have
                    done = 1
                } ElseBlock: {
                    // Skip rest of chunk-size line (extensions + CRLF)
                    HCK__SkipToLF(buf, buf_len)

                    IfCondition EqualTo(chunk_size, 0) ThenBlock: {
                        // Terminal chunk — we're done
                        done = 1
                    } ElseBlock: {
                        // Copy chunk_size bytes from src to dst
                        copied = 0
                        WhileLoop And(LessThan(copied, chunk_size), LessThan(HCKState.src, buf_len)) {
                            SetByte(buf, HCKState.dst, GetByte(buf, HCKState.src))
                            HCKState.src = Add(HCKState.src, 1)
                            HCKState.dst = Add(HCKState.dst, 1)
                            copied = Add(copied, 1)
                        }

                        // Skip trailing CRLF after chunk data
                        HCK__SkipToLF(buf, buf_len)
                    }
                }
            }
        }

        ReturnValue(HCKState.dst)
    }
}
