// Library.HTTPClient.ailang — HTTP/1.1 client for the Ailang browser engine
// Direct TCP via Socket library. Supports GET/POST, chunked transfer,
// redirects, and keep-alive connection reuse.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Socket
LibraryImport.Browser.URL
LibraryImport.Browser.DNS
LibraryImport.Browser.HTTPChunked
LibraryImport.Browser.HTTPGzip
LibraryImport.Browser.HTTPCookie

FixedPool.HTTPSys {
    "SYS_READ":     Initialize=0
    "SYS_WRITE":    Initialize=1
    "SYS_CLOSE":    Initialize=3
}

FixedPool.HTTPConst {
    "MAX_RESP":     Initialize=16
    "RESP_SIZE":    Initialize=64
    "R_STATUS":     Initialize=0
    "R_BODY_PTR":   Initialize=8
    "R_BODY_LEN":   Initialize=16
    "R_CTYPE_PTR":  Initialize=24
    "R_HDRS_PTR":   Initialize=32
    "R_HDRS_LEN":   Initialize=40
    "R_VALID":      Initialize=48
    "R_LOCATION":   Initialize=56
    "MAX_REDIR":    Initialize=5
    "RECV_BUF":     Initialize=65536
    "MAX_BODY":     Initialize=4194304
}

FixedPool.HTTPState {
    "pool":         Initialize=0
    "next":         Initialize=0
    "recv_buf":     Initialize=0
}

Function.HTTP_Init {
    Output: Integer
    Body: {
        total = Multiply(HTTPConst.MAX_RESP, HTTPConst.RESP_SIZE)
        HTTPState.pool = Allocate(total)
        MemorySet(HTTPState.pool, 0, total)
        HTTPState.recv_buf = Allocate(HTTPConst.RECV_BUF)
        HTTPState.next = 0
        Cookie_Init()
        ReturnValue(0)
    }
}

// ---- Allocate response slot ----
Function.HTTP__AllocResp {
    Output: Integer
    Body: {
        h = HTTPState.next
        IfCondition GreaterEqual(h, HTTPConst.MAX_RESP) ThenBlock: {
            h = 0   // Wrap around
        }
        HTTPState.next = Add(h, 1)
        base = Add(HTTPState.pool, Multiply(h, HTTPConst.RESP_SIZE))
        MemorySet(base, 0, HTTPConst.RESP_SIZE)
        ReturnValue(h)
    }
}

Function.HTTP__RespBase {
    Input: h: Integer
    Output: Address
    Body: {
        ReturnValue(Add(HTTPState.pool, Multiply(h, HTTPConst.RESP_SIZE)))
    }
}

// ---- GET request with redirect following ----
Function.HTTP_Get {
    Input: url_h: Integer
    Output: Integer
    Body: {
        // Open debug log (O_WRONLY|O_CREAT|O_APPEND = 1089, mode 0644 = 420)
        dbg_fd = SystemCall(2, "/tmp/http_debug.log", 1089, 420)

        redir = 0
        cur_url = url_h
        WhileLoop LessThan(redir, HTTPConst.MAX_REDIR) {
            IfCondition GreaterEqual(dbg_fd, 0) ThenBlock: {
                SystemCall(1, dbg_fd, "[HTTP_Get] loop redir=", 22)
            }
            resp_h = HTTP__DoGet(cur_url)
            IfCondition LessThan(resp_h, 0) ThenBlock: {
                IfCondition GreaterEqual(dbg_fd, 0) ThenBlock: {
                    SystemCall(1, dbg_fd, "DoGet FAILED\n", 13)
                    SystemCall(3, dbg_fd)
                }
                ReturnValue(-1)
            }
            status = HTTP_GetStatus(resp_h)

            // Check redirect — use simple if-chain, not Or(EqualTo(...))
            is_redir = 0
            IfCondition EqualTo(status, 301) ThenBlock: { is_redir = 1 }
            IfCondition EqualTo(status, 302) ThenBlock: { is_redir = 1 }
            IfCondition EqualTo(status, 307) ThenBlock: { is_redir = 1 }
            IfCondition EqualTo(status, 308) ThenBlock: { is_redir = 1 }

            IfCondition GreaterEqual(dbg_fd, 0) ThenBlock: {
                // Write status + is_redir to log as raw text
                dbg_tmp = Allocate(64)
                MemorySet(dbg_tmp, 0, 64)
                MemoryCopy(dbg_tmp, "status=", 7)
                dbg_sstr = IntToString(status)
                dbg_slen = StringLength(dbg_sstr)
                MemoryCopy(Add(dbg_tmp, 7), dbg_sstr, dbg_slen)
                dbg_off = Add(7, dbg_slen)
                MemoryCopy(Add(dbg_tmp, dbg_off), " is_redir=", 10)
                dbg_off = Add(dbg_off, 10)
                dbg_rstr = IntToString(is_redir)
                dbg_rlen = StringLength(dbg_rstr)
                MemoryCopy(Add(dbg_tmp, dbg_off), dbg_rstr, dbg_rlen)
                dbg_off = Add(dbg_off, dbg_rlen)
                SetByte(dbg_tmp, dbg_off, 10)
                dbg_off = Add(dbg_off, 1)
                SystemCall(1, dbg_fd, dbg_tmp, dbg_off)
                Deallocate(dbg_tmp, 64)
            }

            IfCondition EqualTo(is_redir, 1) ThenBlock: {
                loc = HTTP_GetLocation(resp_h)
                IfCondition EqualTo(loc, 0) ThenBlock: {
                    IfCondition GreaterEqual(dbg_fd, 0) ThenBlock: {
                        SystemCall(1, dbg_fd, "no Location header\n", 19)
                        SystemCall(3, dbg_fd)
                    }
                    ReturnValue(resp_h)
                }
                loc_len = StringLength(loc)
                IfCondition EqualTo(loc_len, 0) ThenBlock: {
                    IfCondition GreaterEqual(dbg_fd, 0) ThenBlock: {
                        SystemCall(1, dbg_fd, "empty Location\n", 15)
                        SystemCall(3, dbg_fd)
                    }
                    ReturnValue(resp_h)
                }

                IfCondition GreaterEqual(dbg_fd, 0) ThenBlock: {
                    SystemCall(1, dbg_fd, "redirect to: ", 13)
                    SystemCall(1, dbg_fd, loc, loc_len)
                    SystemCall(1, dbg_fd, "\n", 1)
                }

                // Parse location URL
                cur_url = URL_Parse(loc, loc_len)
                IfCondition LessThan(cur_url, 0) ThenBlock: {
                    IfCondition GreaterEqual(dbg_fd, 0) ThenBlock: {
                        SystemCall(1, dbg_fd, "URL_Parse FAILED for Location\n", 30)
                        SystemCall(3, dbg_fd)
                    }
                    ReturnValue(resp_h)
                }
                redir = Add(redir, 1)
            } ElseBlock: {
                IfCondition GreaterEqual(dbg_fd, 0) ThenBlock: {
                    SystemCall(1, dbg_fd, "final response, done\n", 21)
                    SystemCall(3, dbg_fd)
                }
                ReturnValue(resp_h)
            }
        }
        IfCondition GreaterEqual(dbg_fd, 0) ThenBlock: {
            SystemCall(1, dbg_fd, "too many redirects\n", 19)
            SystemCall(3, dbg_fd)
        }
        ReturnValue(-1)
    }
}

// ---- Internal: single GET without redirect ----
Function.HTTP__DoGet {
    Input: url_h: Integer
    Output: Integer
    Body: {
        host = URL_GetHost(url_h)
        port = URL_GetPort(url_h)
        path = URL_GetPath(url_h)
        is_https = URL_IsHTTPS(url_h)

        // Bail on empty/null host
        IfCondition EqualTo(host, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(StringLength(host), 0) ThenBlock: { ReturnValue(-1) }

        // Debug to file
        dg_dbg = SystemCall(2, "/tmp/http_doget.log", 1089, 420)
        IfCondition GreaterEqual(dg_dbg, 0) ThenBlock: {
            SystemCall(1, dg_dbg, "[DoGet] host=", 13)
            SystemCall(1, dg_dbg, host, StringLength(host))
            SystemCall(1, dg_dbg, " port=", 6)
            dg_ps = IntToString(port)
            SystemCall(1, dg_dbg, dg_ps, StringLength(dg_ps))
            SystemCall(1, dg_dbg, " https=", 7)
            dg_hs = IntToString(is_https)
            SystemCall(1, dg_dbg, dg_hs, StringLength(dg_hs))
            SystemCall(1, dg_dbg, " path=", 6)
            SystemCall(1, dg_dbg, path, StringLength(path))
            SystemCall(1, dg_dbg, "\n", 1)
        }

        // Append query string to path if present (for request line)
        qstr = URL_GetQuery(url_h)
        IfCondition NotEqual(qstr, 0) ThenBlock: {
            qlen = StringLength(qstr)
            IfCondition GreaterThan(qlen, 0) ThenBlock: {
                plen = StringLength(path)
                full_path = Allocate(Add(plen, Add(qlen, 2)))
                MemoryCopy(full_path, path, plen)
                SetByte(full_path, plen, 63)
                MemoryCopy(Add(full_path, Add(plen, 1)), qstr, qlen)
                SetByte(full_path, Add(plen, Add(qlen, 1)), 0)
                path = full_path
            }
        }

        // Resolve hostname
        host_len = StringLength(host)
        ip4 = DNS_Resolve(host, host_len)
        IfCondition LessThan(ip4, 0) ThenBlock: {
            IfCondition GreaterEqual(dg_dbg, 0) ThenBlock: {
                SystemCall(1, dg_dbg, "DNS FAILED\n", 11)
                SystemCall(3, dg_dbg)
            }
            ReturnValue(-1)
        }
        IfCondition GreaterEqual(dg_dbg, 0) ThenBlock: {
            dg_ip = IntToString(ip4)
            SystemCall(1, dg_dbg, "DNS ok ip4=", 11)
            SystemCall(1, dg_dbg, dg_ip, StringLength(dg_ip))
            SystemCall(1, dg_dbg, "\n", 1)
            SystemCall(3, dg_dbg)
        }

        ip_str = DNS_IP4ToString(ip4)

        // For HTTPS, use TLS subprocess (if available)
        IfCondition EqualTo(is_https, 1) ThenBlock: {
            ReturnValue(HTTP__DoGetTLS(url_h, host, port, path, ip_str))
        }

        // TCP connect
        sock = Socket.Create(2, 1)
        IfCondition LessThan(sock, 0) ThenBlock: {
            ReturnValue(-1)
        }
        // Set connect/send timeout: 5 seconds (SO_SNDTIMEO = 21, SOL_SOCKET = 1)
        ct_tval = Allocate(16)
        StoreValue(Add(ct_tval, 0), 5)   // tv_sec
        StoreValue(Add(ct_tval, 8), 0)   // tv_usec
        SystemCall(54, sock, 1, 21, ct_tval, 16)
        // Set receive timeout: 5 seconds (SO_RCVTIMEO = 20)
        SystemCall(54, sock, 1, 20, ct_tval, 16)
        Deallocate(ct_tval, 16)
        // Build sockaddr_in directly (bypasses Socket.CreateAddr/ArrayGet mismatch)
        addr = Allocate(16)
        MemorySet(addr, 0, 16)
        SetByte(addr, 0, 2)  // AF_INET
        SetByte(addr, 1, 0)
        SetByte(addr, 2, Divide(port, 256))
        SetByte(addr, 3, Subtract(port, Multiply(Divide(port, 256), 256)))
        // IP from ip4 integer
        SetByte(addr, 4, Divide(ip4, 16777216))
        ipr1 = Subtract(ip4, Multiply(Divide(ip4, 16777216), 16777216))
        SetByte(addr, 5, Divide(ipr1, 65536))
        ipr2 = Subtract(ipr1, Multiply(Divide(ipr1, 65536), 65536))
        SetByte(addr, 6, Divide(ipr2, 256))
        SetByte(addr, 7, Subtract(ipr2, Multiply(Divide(ipr2, 256), 256)))
        conn = Socket.Connect(sock, addr)
        IfCondition LessThan(conn, 0) ThenBlock: {
            SystemCall(HTTPSys.SYS_CLOSE, sock, 0, 0)
            ReturnValue(-1)
        }

        // Build request (includes Cookie header if any)
        req = HTTP__BuildRequest("GET", path, host)
        req_len = StringLength(req)

        // Send
        sent = Socket.Send(sock, req, req_len)
        IfCondition LessEqual(sent, 0) ThenBlock: {
            SystemCall(HTTPSys.SYS_CLOSE, sock, 0, 0)
            ReturnValue(-1)
        }

        // Receive response
        resp_h = HTTP__RecvResponse(sock)
        SystemCall(HTTPSys.SYS_CLOSE, sock, 0, 0)

        // Process Set-Cookie from response headers
        IfCondition GreaterEqual(resp_h, 0) ThenBlock: {
            rbase = HTTP__RespBase(resp_h)
            rhdrs = Dereference(Add(rbase, HTTPConst.R_HDRS_PTR))
            rhlen = Dereference(Add(rbase, HTTPConst.R_HDRS_LEN))
            IfCondition GreaterThan(rhlen, 0) ThenBlock: {
                Cookie_ProcessHeaders(rhdrs, rhlen, host, path)
            }
        }

        ReturnValue(resp_h)
    }
}

// ---- HTTPS via openssl s_client subprocess ----
Function.HTTP__DoGetTLS {
    Input: url_h: Integer
    Input: host: Address
    Input: port: Integer
    Input: path: Address
    Input: ip_str: Address
    Output: Integer
    Body: {
        // Build "host:port" connect string for openssl
        port_str = IntToString(port)
        // "openssl s_client -connect host:port -quiet -servername host"
        // We fork/exec with pipes

        // Create pipe for stdin (we write request)
        pipe_in = Allocate(16)
        SystemCall(22, pipe_in, 0, 0, 0, 0)   // SYS_PIPE
        read_in = Dereference(pipe_in, "dword")
        write_in = Dereference(Add(pipe_in, 4), "dword")

        // Create pipe for stdout (we read response)
        pipe_out = Allocate(16)
        SystemCall(22, pipe_out, 0, 0, 0, 0)
        read_out = Dereference(pipe_out, "dword")
        write_out = Dereference(Add(pipe_out, 4), "dword")

        // Fork
        pid = SystemCall(57, 0, 0, 0, 0, 0)   // SYS_FORK
        IfCondition EqualTo(pid, 0) ThenBlock: {
            // Child: wire pipes, exec openssl
            SystemCall(33, read_in, 0, 0, 0, 0)    // dup2(read_in, 0)  — stdin
            SystemCall(33, write_out, 1, 0, 0, 0)  // dup2(write_out, 1) — stdout
            // Redirect stderr to /dev/null (cert chain messages corrupt response)
            devnull = SystemCall(2, "/dev/null", 1, 0)  // open("/dev/null", O_WRONLY)
            SystemCall(33, devnull, 2, 0, 0, 0)    // dup2(devnull, 2) — stderr
            SystemCall(HTTPSys.SYS_CLOSE, devnull, 0, 0)
            SystemCall(HTTPSys.SYS_CLOSE, write_in, 0, 0)
            SystemCall(HTTPSys.SYS_CLOSE, read_out, 0, 0)

            // Build connect arg: "host:port"
            connect_arg = Allocate(256)
            hl = StringLength(host)
            MemoryCopy(connect_arg, host, hl)
            ci = hl
            SetByte(connect_arg, ci, 58)
            ci = Add(ci, 1)
            pl = StringLength(port_str)
            MemoryCopy(Add(connect_arg, ci), port_str, pl)
            ci = Add(ci, pl)
            SetByte(connect_arg, ci, 0)

            argv = Allocate(56)
            StoreValue(Add(argv, 0), "/usr/bin/openssl")
            StoreValue(Add(argv, 8), "s_client")
            StoreValue(Add(argv, 16), "-connect")
            StoreValue(Add(argv, 24), connect_arg)
            StoreValue(Add(argv, 32), "-quiet")
            StoreValue(Add(argv, 40), "-servername")
            StoreValue(Add(argv, 48), host)

            // Need null terminator for argv but we're at 7 args = 56 bytes
            // Reallocate with space for null
            argv2 = Allocate(64)
            MemoryCopy(argv2, argv, 56)
            StoreValue(Add(argv2, 56), 0)

            envp = Allocate(16)
            StoreValue(Add(envp, 0), "PATH=/usr/bin:/bin")
            StoreValue(Add(envp, 8), 0)

            SystemCall(59, "/usr/bin/openssl", argv2, envp)
            SystemCall(60, 1, 0, 0, 0, 0)  // exit(1) if execve fails
        }

        // Parent: close unused ends
        SystemCall(HTTPSys.SYS_CLOSE, read_in, 0, 0)
        SystemCall(HTTPSys.SYS_CLOSE, write_out, 0, 0)

        // Debug to file
        tls_dbg = SystemCall(2, "/tmp/http_tls.log", 1089, 420)
        IfCondition GreaterEqual(tls_dbg, 0) ThenBlock: {
            SystemCall(1, tls_dbg, "[TLS] host=", 11)
            SystemCall(1, tls_dbg, host, StringLength(host))
            tls_ps = IntToString(port)
            SystemCall(1, tls_dbg, " port=", 6)
            SystemCall(1, tls_dbg, tls_ps, StringLength(tls_ps))
            tls_pids = IntToString(pid)
            SystemCall(1, tls_dbg, " fork_pid=", 10)
            SystemCall(1, tls_dbg, tls_pids, StringLength(tls_pids))
            SystemCall(1, tls_dbg, "\n", 1)
        }

        // Write HTTP request to pipe immediately — kernel pipe buffer (64KB)
        req = HTTP__BuildRequest("GET", path, host)
        req_len = StringLength(req)
        wr = SystemCall(HTTPSys.SYS_WRITE, write_in, req, req_len)

        IfCondition GreaterEqual(tls_dbg, 0) ThenBlock: {
            tls_ws = IntToString(wr)
            SystemCall(1, tls_dbg, "pipe write=", 11)
            SystemCall(1, tls_dbg, tls_ws, StringLength(tls_ws))
            tls_rls = IntToString(req_len)
            SystemCall(1, tls_dbg, " req_len=", 9)
            SystemCall(1, tls_dbg, tls_rls, StringLength(tls_rls))
            SystemCall(1, tls_dbg, "\n", 1)
        }

        // If write failed (child died immediately), bail
        IfCondition LessEqual(wr, 0) ThenBlock: {
            IfCondition GreaterEqual(tls_dbg, 0) ThenBlock: {
                SystemCall(1, tls_dbg, "PIPE WRITE FAILED\n", 18)
                SystemCall(3, tls_dbg)
            }
            SystemCall(HTTPSys.SYS_CLOSE, write_in, 0, 0)
            SystemCall(HTTPSys.SYS_CLOSE, read_out, 0, 0)
            SystemCall(62, pid, 9, 0, 0, 0)    // SIGKILL
            SystemCall(61, pid, 0, 0, 0, 0)    // wait4
            ReturnValue(-1)
        }

        // Close write end — signals EOF to openssl stdin after it reads request
        SystemCall(HTTPSys.SYS_CLOSE, write_in, 0, 0)

        // Read response (blocks until openssl connects + sends + receives)
        resp_h = HTTP__RecvResponse(read_out)

        IfCondition GreaterEqual(tls_dbg, 0) ThenBlock: {
            tls_rs = IntToString(resp_h)
            SystemCall(1, tls_dbg, "RecvResponse=", 13)
            SystemCall(1, tls_dbg, tls_rs, StringLength(tls_rs))
            SystemCall(1, tls_dbg, "\n", 1)
            SystemCall(3, tls_dbg)
        }

        // Cleanup (write_in already closed above)
        SystemCall(HTTPSys.SYS_CLOSE, read_out, 0, 0)
        // Kill child
        SystemCall(62, pid, 9, 0, 0, 0)    // SYS_KILL SIGKILL
        // Reap
        SystemCall(61, pid, 0, 0, 0, 0)    // SYS_WAIT4

        // Process Set-Cookie from response headers
        IfCondition GreaterEqual(resp_h, 0) ThenBlock: {
            rbase = HTTP__RespBase(resp_h)
            rhdrs = Dereference(Add(rbase, HTTPConst.R_HDRS_PTR))
            rhlen = Dereference(Add(rbase, HTTPConst.R_HDRS_LEN))
            IfCondition GreaterThan(rhlen, 0) ThenBlock: {
                Cookie_ProcessHeaders(rhdrs, rhlen, host, path)
            }
        }

        ReturnValue(resp_h)
    }
}

// ---- Build HTTP/1.1 request ----
Function.HTTP__BuildRequest {
    Input: method: Address
    Input: path: Address
    Input: host: Address
    Output: Address
    Body: {
        // Calculate buffer size: method + path + host + headers + cookies + slack
        ml = StringLength(method)
        pl = StringLength(path)
        hl2 = StringLength(host)
        buf_sz = Add(ml, Add(pl, Add(hl2, 1024)))
        IfCondition LessThan(buf_sz, 2048) ThenBlock: { buf_sz = 2048 }
        buf = Allocate(buf_sz)
        pos = 0

        // "METHOD /path HTTP/1.1\r\n"
        ml = StringLength(method)
        MemoryCopy(Add(buf, pos), method, ml)
        pos = Add(pos, ml)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)

        pl = StringLength(path)
        IfCondition GreaterThan(pl, 0) ThenBlock: {
            MemoryCopy(Add(buf, pos), path, pl)
            pos = Add(pos, pl)
        } ElseBlock: {
            SetByte(buf, pos, 47)
            pos = Add(pos, 1)
        }

        http_ver = " HTTP/1.1\r\n"
        hvl = StringLength(http_ver)
        MemoryCopy(Add(buf, pos), http_ver, hvl)
        pos = Add(pos, hvl)

        // "Host: host\r\n"
        hdr_host = "Host: "
        hl = StringLength(hdr_host)
        MemoryCopy(Add(buf, pos), hdr_host, hl)
        pos = Add(pos, hl)
        hl2 = StringLength(host)
        MemoryCopy(Add(buf, pos), host, hl2)
        pos = Add(pos, hl2)
        SetByte(buf, pos, 13)
        pos = Add(pos, 1)
        SetByte(buf, pos, 10)
        pos = Add(pos, 1)

        // Standard headers
        std_hdrs = "User-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:120.0) Gecko/20100101 Firefox/120.0\r\nAccept: text/html,application/xhtml+xml,*/*\r\nAccept-Encoding: identity\r\nConnection: close\r\n"
        sl = StringLength(std_hdrs)
        MemoryCopy(Add(buf, pos), std_hdrs, sl)
        pos = Add(pos, sl)

        // Append Cookie header if we have matching cookies
        cookie_hdr = Cookie_BuildHeader(host, path)
        IfCondition NotEqual(cookie_hdr, 0) ThenBlock: {
            // cookie_hdr starts with "Cookie: ..." — append it + CRLF
            cl = StringLength(cookie_hdr)
            IfCondition GreaterThan(cl, 0) ThenBlock: {
                MemoryCopy(Add(buf, pos), cookie_hdr, cl)
                pos = Add(pos, cl)
                SetByte(buf, pos, 13)
                pos = Add(pos, 1)
                SetByte(buf, pos, 10)
                pos = Add(pos, 1)
            }
        }

        // Final CRLF (end of headers)
        SetByte(buf, pos, 13)
        pos = Add(pos, 1)
        SetByte(buf, pos, 10)
        pos = Add(pos, 1)
        SetByte(buf, pos, 0)
        ReturnValue(buf)
    }
}

// ---- Receive and parse HTTP response ----
Function.HTTP__RecvResponse {
    Input: sock: Integer
    Output: Integer
    Body: {
        // Set recv timeout: 10 seconds (works on sockets, not pipes)
        tval = Allocate(16)
        StoreValue(Add(tval, 0), 10)
        StoreValue(Add(tval, 8), 0)
        SystemCall(54, sock, 1, 20, tval, 16)

        // Allocate pollfd struct for pipe timeout (8 bytes: fd(4) + events(2) + revents(2))
        pfd = Allocate(8)

        // Read all data into a buffer
        body_buf = Allocate(HTTPConst.MAX_BODY)
        recv_total = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            remain = Subtract(HTTPConst.MAX_BODY, recv_total)
            IfCondition LessEqual(remain, 0) ThenBlock: {
                done = 1
            } ElseBlock: {
                // poll() with timeout — works on both sockets AND pipes
                // Use 10s for initial data, 2s after first data arrives
                poll_ms = 10000
                IfCondition GreaterThan(recv_total, 0) ThenBlock: { poll_ms = 2000 }
                StoreValue(pfd, sock, "dword")
                SetByte(pfd, 4, 1)     // events = POLLIN
                SetByte(pfd, 5, 0)
                SetByte(pfd, 6, 0)     // revents = 0
                SetByte(pfd, 7, 0)
                pr = SystemCall(7, pfd, 1, poll_ms)   // poll(pfd, 1, timeout_ms)
                IfCondition LessEqual(pr, 0) ThenBlock: {
                    // Timeout or error — stop reading
                    done = 1
                } ElseBlock: {
                    rsize = remain
                    IfCondition GreaterThan(rsize, HTTPConst.RECV_BUF) ThenBlock: {
                        rsize = HTTPConst.RECV_BUF
                    }
                    n = SystemCall(HTTPSys.SYS_READ, sock, Add(body_buf, recv_total), rsize)
                    IfCondition LessEqual(n, 0) ThenBlock: {
                        done = 1
                    } ElseBlock: {
                        recv_total = Add(recv_total, n)
                    }
                }
            }
        }

        IfCondition EqualTo(recv_total, 0) ThenBlock: {
            PrintMessage("[HTTP] no data received\n")
            ReturnValue(-1)
        }

        resp_h = HTTP__AllocResp()
        base = HTTP__RespBase(resp_h)

        // Find \r\n\r\n (end of headers)
        hdr_end = -1
        si = 0
        search_max = Subtract(recv_total, 3)
        WhileLoop LessThan(si, search_max) {
            c0 = GetByte(body_buf, si)
            c1 = GetByte(body_buf, Add(si, 1))
            c2 = GetByte(body_buf, Add(si, 2))
            c3 = GetByte(body_buf, Add(si, 3))
            IfCondition And(And(EqualTo(c0, 13), EqualTo(c1, 10)), And(EqualTo(c2, 13), EqualTo(c3, 10))) ThenBlock: {
                hdr_end = si
                si = search_max  // break
            }
            si = Add(si, 1)
        }

        IfCondition LessThan(hdr_end, 0) ThenBlock: {
            PrintMessage("[HTTP] no header terminator\n")
            StoreValue(Add(base, HTTPConst.R_STATUS), 0)
            StoreValue(Add(base, HTTPConst.R_VALID), 1)
            ReturnValue(resp_h)
        }

        // Parse status line: "HTTP/1.1 NNN reason\r\n"
        status = HTTP__ParseStatus(body_buf, hdr_end)
        StoreValue(Add(base, HTTPConst.R_STATUS), status)

        // Store headers region
        StoreValue(Add(base, HTTPConst.R_HDRS_PTR), body_buf)
        StoreValue(Add(base, HTTPConst.R_HDRS_LEN), hdr_end)

        // Parse Location header for redirects
        // Debug: dump raw headers to file
        hdr_dbg = SystemCall(2, "/tmp/http_headers.log", 1089, 420)
        IfCondition GreaterEqual(hdr_dbg, 0) ThenBlock: {
            dbg_hs = IntToString(status)
            SystemCall(1, hdr_dbg, "--- status=", 11)
            SystemCall(1, hdr_dbg, dbg_hs, StringLength(dbg_hs))
            SystemCall(1, hdr_dbg, " hdr_end=", 9)
            dbg_he = IntToString(hdr_end)
            SystemCall(1, hdr_dbg, dbg_he, StringLength(dbg_he))
            SystemCall(1, hdr_dbg, " ---\n", 5)
            // Dump raw header bytes
            IfCondition GreaterThan(hdr_end, 0) ThenBlock: {
                SystemCall(1, hdr_dbg, body_buf, hdr_end)
                SystemCall(1, hdr_dbg, "\n---END---\n", 11)
            }
            SystemCall(3, hdr_dbg)
        }
        loc = HTTP__FindHeader(body_buf, hdr_end, "Location")
        StoreValue(Add(base, HTTPConst.R_LOCATION), loc)

        // Parse Content-Type
        ctype = HTTP__FindHeader(body_buf, hdr_end, "Content-Type")
        StoreValue(Add(base, HTTPConst.R_CTYPE_PTR), ctype)

        // Body starts after \r\n\r\n
        body_start = Add(hdr_end, 4)
        body_len = Subtract(recv_total, body_start)
        IfCondition LessThan(body_len, 0) ThenBlock: { body_len = 0 }

        body_ptr = Add(body_buf, body_start)

        // Decode chunked transfer-encoding if present
        IfCondition GreaterThan(body_len, 0) ThenBlock: {
            is_chunked = HTTPChunked_IsChunked(body_buf, hdr_end)
            IfCondition EqualTo(is_chunked, 1) ThenBlock: {
                decoded_len = HTTPChunked_Decode(body_ptr, body_len)
                IfCondition GreaterThan(decoded_len, 0) ThenBlock: {
                    body_len = decoded_len
                }
            }
        }

        // Decompress gzip/deflate if present
        IfCondition GreaterThan(body_len, 0) ThenBlock: {
            gz_type = HTTPGzip_IsGzip(body_buf, hdr_end)
            IfCondition GreaterThan(gz_type, 0) ThenBlock: {
                decomp_len_buf = Allocate(8)
                StoreValue(decomp_len_buf, 0)
                decomp_ptr = HTTPGzip_Decompress(body_ptr, body_len, decomp_len_buf)
                IfCondition NotEqual(decomp_ptr, 0) ThenBlock: {
                    decomp_len = Dereference(decomp_len_buf)
                    IfCondition GreaterThan(decomp_len, 0) ThenBlock: {
                        body_ptr = decomp_ptr
                        body_len = decomp_len
                    }
                }
            }
        }

        StoreValue(Add(base, HTTPConst.R_BODY_PTR), body_ptr)
        StoreValue(Add(base, HTTPConst.R_BODY_LEN), body_len)
        StoreValue(Add(base, HTTPConst.R_VALID), 1)

        // Note: Set-Cookie processed by caller who knows the domain

        ReturnValue(resp_h)
    }
}

// ---- Parse "HTTP/1.x NNN" -> status code ----
Function.HTTP__ParseStatus {
    Input: buf: Address
    Input: len: Integer
    Output: Integer
    Body: {
        // Find "HTTP/" marker first, then scan for space + 3 digits
        i = 0
        limit = Subtract(len, 12)
        WhileLoop LessThan(i, limit) {
            // Look for 'H','T','T','P','/' (72,84,84,80,47)
            IfCondition And(EqualTo(GetByte(buf, i), 72),
                           And(EqualTo(GetByte(buf, Add(i, 1)), 84),
                               And(EqualTo(GetByte(buf, Add(i, 2)), 84),
                                   And(EqualTo(GetByte(buf, Add(i, 3)), 80),
                                       EqualTo(GetByte(buf, Add(i, 4)), 47))))) ThenBlock: {
                // Found "HTTP/", now find space after version (e.g. "HTTP/1.1 ")
                j = Add(i, 5)
                WhileLoop LessThan(j, len) {
                    IfCondition EqualTo(GetByte(buf, j), 32) ThenBlock: {
                        // Parse 3 digits after space
                        d1 = Subtract(GetByte(buf, Add(j, 1)), 48)
                        d2 = Subtract(GetByte(buf, Add(j, 2)), 48)
                        d3 = Subtract(GetByte(buf, Add(j, 3)), 48)
                        ReturnValue(Add(Add(Multiply(d1, 100), Multiply(d2, 10)), d3))
                    }
                    j = Add(j, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// ---- Find header value by name (case-insensitive) ----
// NOTE: Avoids Or/And with comparison primitives — compiler bug makes those return 0.
// Uses simple if-chains instead.
Function.HTTP__FindHeader {
    Input: buf: Address
    Input: hdr_end: Integer
    Input: name: Address
    Output: Address
    Body: {
        nlen = StringLength(name)
        IfCondition EqualTo(nlen, 0) ThenBlock: { ReturnValue(0) }

        // Debug: log to file
        fh_dbg = SystemCall(2, "/tmp/http_findheader.log", 1089, 420)
        IfCondition GreaterEqual(fh_dbg, 0) ThenBlock: {
            SystemCall(1, fh_dbg, "FindHeader name=", 16)
            SystemCall(1, fh_dbg, name, nlen)
            SystemCall(1, fh_dbg, " hdr_end=", 9)
            fh_he = IntToString(hdr_end)
            SystemCall(1, fh_dbg, fh_he, StringLength(fh_he))
            SystemCall(1, fh_dbg, "\n", 1)
        }

        // Scan line by line
        line_start = 0
        i = 0
        WhileLoop LessThan(i, hdr_end) {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, 10) ThenBlock: {
                line_start = Add(i, 1)
            }
            // At line start, try to match header name
            IfCondition EqualTo(i, line_start) ThenBlock: {
                match = 1
                j = 0
                WhileLoop LessThan(j, nlen) {
                    c1 = GetByte(buf, Add(i, j))
                    c2 = GetByte(name, j)
                    // Lowercase c1 if uppercase (avoid And with comparisons)
                    c1_is_upper = 0
                    IfCondition GreaterEqual(c1, 65) ThenBlock: {
                        IfCondition LessEqual(c1, 90) ThenBlock: {
                            c1_is_upper = 1
                        }
                    }
                    IfCondition EqualTo(c1_is_upper, 1) ThenBlock: {
                        c1 = Add(c1, 32)
                    }
                    // Lowercase c2 if uppercase
                    c2_is_upper = 0
                    IfCondition GreaterEqual(c2, 65) ThenBlock: {
                        IfCondition LessEqual(c2, 90) ThenBlock: {
                            c2_is_upper = 1
                        }
                    }
                    IfCondition EqualTo(c2_is_upper, 1) ThenBlock: {
                        c2 = Add(c2, 32)
                    }
                    IfCondition NotEqual(c1, c2) ThenBlock: {
                        match = 0
                        j = nlen
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(match, 1) ThenBlock: {
                    // Check for ':' after name
                    colon_pos = Add(i, nlen)
                    IfCondition LessThan(colon_pos, hdr_end) ThenBlock: {
                        cc = GetByte(buf, colon_pos)
                        IfCondition EqualTo(cc, 58) ThenBlock: {
                            // Skip colon + optional space
                            val_start = Add(colon_pos, 1)
                            IfCondition LessThan(val_start, hdr_end) ThenBlock: {
                                sp = GetByte(buf, val_start)
                                IfCondition EqualTo(sp, 32) ThenBlock: {
                                    val_start = Add(val_start, 1)
                                }
                            }
                            // Find end of value: scan for CR(13) or LF(10)
                            val_end = val_start
                            found_end = 0
                            WhileLoop LessThan(val_end, hdr_end) {
                                vc = GetByte(buf, val_end)
                                is_eol = 0
                                IfCondition EqualTo(vc, 13) ThenBlock: { is_eol = 1 }
                                IfCondition EqualTo(vc, 10) ThenBlock: { is_eol = 1 }
                                IfCondition EqualTo(is_eol, 1) ThenBlock: {
                                    found_end = 1
                                    // Break out of loop
                                    val_end = Add(val_end, hdr_end)
                                } ElseBlock: {
                                    val_end = Add(val_end, 1)
                                }
                            }
                            // Recover actual val_end (we added hdr_end to break)
                            IfCondition EqualTo(found_end, 1) ThenBlock: {
                                val_end = Subtract(val_end, hdr_end)
                            }
                            // Copy value string
                            vlen = Subtract(val_end, val_start)
                            IfCondition GreaterThan(vlen, 0) ThenBlock: {
                                vbuf = Allocate(Add(vlen, 1))
                                MemoryCopy(vbuf, Add(buf, val_start), vlen)
                                SetByte(vbuf, vlen, 0)
                                // Debug log the found value
                                IfCondition GreaterEqual(fh_dbg, 0) ThenBlock: {
                                    SystemCall(1, fh_dbg, "FOUND: ", 7)
                                    SystemCall(1, fh_dbg, vbuf, vlen)
                                    SystemCall(1, fh_dbg, "\n", 1)
                                    SystemCall(3, fh_dbg)
                                }
                                ReturnValue(vbuf)
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(fh_dbg, 0) ThenBlock: {
            SystemCall(1, fh_dbg, "NOT FOUND\n", 10)
            SystemCall(3, fh_dbg)
        }
        ReturnValue(0)
    }
}

// ---- Accessors ----
Function.HTTP_GetStatus {
    Input: h: Integer
    Output: Integer
    Body: {
        base = HTTP__RespBase(h)
        ReturnValue(Dereference(Add(base, HTTPConst.R_STATUS)))
    }
}

Function.HTTP_GetBody {
    Input: h: Integer
    Output: Address
    Body: {
        base = HTTP__RespBase(h)
        ReturnValue(Dereference(Add(base, HTTPConst.R_BODY_PTR)))
    }
}

Function.HTTP_GetBodyLen {
    Input: h: Integer
    Output: Integer
    Body: {
        base = HTTP__RespBase(h)
        ReturnValue(Dereference(Add(base, HTTPConst.R_BODY_LEN)))
    }
}

Function.HTTP_GetContentType {
    Input: h: Integer
    Output: Address
    Body: {
        base = HTTP__RespBase(h)
        ReturnValue(Dereference(Add(base, HTTPConst.R_CTYPE_PTR)))
    }
}

Function.HTTP_GetLocation {
    Input: h: Integer
    Output: Address
    Body: {
        base = HTTP__RespBase(h)
        ReturnValue(Dereference(Add(base, HTTPConst.R_LOCATION)))
    }
}
