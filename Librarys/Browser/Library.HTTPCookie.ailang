// Library.HTTPCookie.ailang — HTTP cookie jar
// Stores cookies from Set-Cookie headers, sends Cookie header with requests.
// Simple flat store: 64 cookies max, domain+path scoping.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.CookieConst {
    "MAX_COOKIES":   Initialize=64
    "ENTRY_SIZE":    Initialize=80   // 10 fields x 8 bytes
    // Entry layout offsets
    "E_DOMAIN":      Initialize=0    // ptr to domain string
    "E_PATH":        Initialize=8    // ptr to path string
    "E_NAME":        Initialize=16   // ptr to name string
    "E_VALUE":       Initialize=24   // ptr to value string
    "E_SECURE":      Initialize=32   // 1 if Secure flag
    "E_HTTPONLY":     Initialize=40   // 1 if HttpOnly flag
    "E_EXPIRES":     Initialize=48   // expiry unix timestamp (0 = session)
    "E_NAME_LEN":    Initialize=56   // name length
    "E_VALUE_LEN":   Initialize=64   // value length
    "E_VALID":       Initialize=72   // 1 if slot in use
}

FixedPool.CookieState {
    "jar":       Initialize=0   // pointer to cookie table
    "count":     Initialize=0   // number of valid cookies
    "ready":     Initialize=0
}

// =============================================================================
// INIT
// =============================================================================
Function.Cookie_Init {
    Output: Integer
    Body: {
        total = Multiply(CookieConst.MAX_COOKIES, CookieConst.ENTRY_SIZE)
        CookieState.jar = Allocate(total)
        MemorySet(CookieState.jar, 0, total)
        CookieState.count = 0
        CookieState.ready = 1
        ReturnValue(1)
    }
}

// =============================================================================
// Cookie_ParseSetCookie — parse a Set-Cookie header value and store it
// Input: domain = request host (for implicit domain)
//        path   = request path (for implicit path)
//        value  = full Set-Cookie header value string
// =============================================================================
Function.Cookie_ParseSetCookie {
    Input: domain: Address
    Input: path: Address
    Input: value: Address
    Body: {
        IfCondition EqualTo(CookieState.ready, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }

        vlen = StringLength(value)
        IfCondition EqualTo(vlen, 0) ThenBlock: { ReturnValue(0) }

        // Parse "name=val" (everything before first ';')
        eq_pos = -1
        semi_pos = vlen
        i = 0
        WhileLoop LessThan(i, vlen) {
            c = GetByte(value, i)
            IfCondition And(EqualTo(eq_pos, -1), EqualTo(c, 61)) ThenBlock: {
                eq_pos = i
            }
            IfCondition And(EqualTo(semi_pos, vlen), EqualTo(c, 59)) ThenBlock: {
                semi_pos = i
            }
            i = Add(i, 1)
        }

        IfCondition LessThan(eq_pos, 1) ThenBlock: { ReturnValue(0) }

        // Extract name
        name_len = eq_pos
        name = Allocate(Add(name_len, 1))
        MemoryCopy(name, value, name_len)
        SetByte(name, name_len, 0)

        // Extract value (between '=' and first ';')
        val_start = Add(eq_pos, 1)
        val_len = Subtract(semi_pos, val_start)
        IfCondition LessThan(val_len, 0) ThenBlock: { val_len = 0 }
        cval = Allocate(Add(val_len, 1))
        IfCondition GreaterThan(val_len, 0) ThenBlock: {
            MemoryCopy(cval, Add(value, val_start), val_len)
        }
        SetByte(cval, val_len, 0)

        // Find or allocate a slot (overwrite existing same-name+domain)
        slot = Cookie__FindSlot(domain, name, name_len)
        base = Add(CookieState.jar, Multiply(slot, CookieConst.ENTRY_SIZE))

        // Store domain (copy)
        dlen = StringLength(domain)
        dcopy = Allocate(Add(dlen, 1))
        MemoryCopy(dcopy, domain, dlen)
        SetByte(dcopy, dlen, 0)

        // Store path (copy)
        plen = StringLength(path)
        pcopy = Allocate(Add(plen, 1))
        MemoryCopy(pcopy, path, plen)
        SetByte(pcopy, plen, 0)

        StoreValue(Add(base, CookieConst.E_DOMAIN), dcopy)
        StoreValue(Add(base, CookieConst.E_PATH), pcopy)
        StoreValue(Add(base, CookieConst.E_NAME), name)
        StoreValue(Add(base, CookieConst.E_VALUE), cval)
        StoreValue(Add(base, CookieConst.E_NAME_LEN), name_len)
        StoreValue(Add(base, CookieConst.E_VALUE_LEN), val_len)
        StoreValue(Add(base, CookieConst.E_VALID), 1)
        StoreValue(Add(base, CookieConst.E_SECURE), 0)
        StoreValue(Add(base, CookieConst.E_HTTPONLY), 0)
        StoreValue(Add(base, CookieConst.E_EXPIRES), 0)
    }
}

// Find existing slot with same domain+name, or allocate new
Function.Cookie__FindSlot {
    Input: domain: Address
    Input: name: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, CookieConst.MAX_COOKIES) {
            base = Add(CookieState.jar, Multiply(i, CookieConst.ENTRY_SIZE))
            valid = Dereference(Add(base, CookieConst.E_VALID))
            IfCondition EqualTo(valid, 1) ThenBlock: {
                // Compare domain and name
                existing_name = Dereference(Add(base, CookieConst.E_NAME))
                existing_domain = Dereference(Add(base, CookieConst.E_DOMAIN))
                IfCondition And(EqualTo(StringCompare(existing_domain, domain), 0),
                               EqualTo(StringCompare(existing_name, name), 0)) ThenBlock: {
                    ReturnValue(i)
                }
            }
            i = Add(i, 1)
        }

        // No existing match — find first empty slot
        j = 0
        WhileLoop LessThan(j, CookieConst.MAX_COOKIES) {
            base = Add(CookieState.jar, Multiply(j, CookieConst.ENTRY_SIZE))
            valid = Dereference(Add(base, CookieConst.E_VALID))
            IfCondition EqualTo(valid, 0) ThenBlock: {
                CookieState.count = Add(CookieState.count, 1)
                ReturnValue(j)
            }
            j = Add(j, 1)
        }

        // Full — evict slot 0 (LRU would be better but this is simple)
        ReturnValue(0)
    }
}

// =============================================================================
// Cookie_BuildHeader — build "Cookie: name=val; name2=val2" for a given host+path
// Returns pointer to assembled string, or 0 if no cookies match.
// Caller should not Deallocate — uses arena bump allocator.
// =============================================================================
Function.Cookie_BuildHeader {
    Input: host: Address
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(CookieState.ready, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CookieState.count, 0) ThenBlock: { ReturnValue(0) }

        // Build into a 4KB buffer
        out = Allocate(4096)
        pos = 0

        // Prefix "Cookie: "
        prefix = "Cookie: "
        plen = 8
        MemoryCopy(out, prefix, plen)
        pos = plen

        found = 0
        i = 0
        WhileLoop LessThan(i, CookieConst.MAX_COOKIES) {
            base = Add(CookieState.jar, Multiply(i, CookieConst.ENTRY_SIZE))
            valid = Dereference(Add(base, CookieConst.E_VALID))
            IfCondition EqualTo(valid, 1) ThenBlock: {
                // Check domain match (suffix match)
                cdomain = Dereference(Add(base, CookieConst.E_DOMAIN))
                IfCondition EqualTo(Cookie__DomainMatch(host, cdomain), 1) ThenBlock: {
                    // Add separator if not first
                    IfCondition GreaterThan(found, 0) ThenBlock: {
                        SetByte(out, pos, 59) // ;
                        pos = Add(pos, 1)
                        SetByte(out, pos, 32) // space
                        pos = Add(pos, 1)
                    }

                    // Append name=value
                    cname = Dereference(Add(base, CookieConst.E_NAME))
                    cname_len = Dereference(Add(base, CookieConst.E_NAME_LEN))
                    cval = Dereference(Add(base, CookieConst.E_VALUE))
                    cval_len = Dereference(Add(base, CookieConst.E_VALUE_LEN))

                    IfCondition LessThan(Add(pos, Add(cname_len, Add(cval_len, 2))), 4090) ThenBlock: {
                        MemoryCopy(Add(out, pos), cname, cname_len)
                        pos = Add(pos, cname_len)
                        SetByte(out, pos, 61) // =
                        pos = Add(pos, 1)
                        IfCondition GreaterThan(cval_len, 0) ThenBlock: {
                            MemoryCopy(Add(out, pos), cval, cval_len)
                            pos = Add(pos, cval_len)
                        }
                    }
                    found = Add(found, 1)
                }
            }
            i = Add(i, 1)
        }

        IfCondition EqualTo(found, 0) ThenBlock: {
            ReturnValue(0)
        }

        SetByte(out, pos, 0)
        ReturnValue(out)
    }
}

// Simple domain match: cookie domain matches if host ends with it
Function.Cookie__DomainMatch {
    Input: host: Address
    Input: cookie_domain: Address
    Output: Integer
    Body: {
        hlen = StringLength(host)
        dlen = StringLength(cookie_domain)
        IfCondition LessThan(hlen, dlen) ThenBlock: { ReturnValue(0) }

        // Exact match
        IfCondition EqualTo(StringCompare(host, cookie_domain), 0) ThenBlock: {
            ReturnValue(1)
        }

        // Suffix match: host ends with cookie_domain
        off = Subtract(hlen, dlen)
        i = 0
        WhileLoop LessThan(i, dlen) {
            c1 = GetByte(host, Add(off, i))
            c2 = GetByte(cookie_domain, i)
            // Case-insensitive
            IfCondition And(GreaterEqual(c1, 65), LessEqual(c1, 90)) ThenBlock: { c1 = Add(c1, 32) }
            IfCondition And(GreaterEqual(c2, 65), LessEqual(c2, 90)) ThenBlock: { c2 = Add(c2, 32) }
            IfCondition NotEqual(c1, c2) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// Cookie_ProcessHeaders — scan response headers for Set-Cookie and store them
// Input: hdrs = raw headers buffer, hdr_len = length, domain/path = request context
// =============================================================================
Function.Cookie_ProcessHeaders {
    Input: hdrs: Address
    Input: hdr_len: Integer
    Input: domain: Address
    Input: path: Address
    Body: {
        IfCondition EqualTo(CookieState.ready, 0) ThenBlock: { ReturnValue(0) }

        // Scan for "set-cookie:" (case-insensitive)
        needle = "set-cookie"
        nlen = 10
        i = 0
        limit = Subtract(hdr_len, nlen)
        WhileLoop LessEqual(i, limit) {
            // Only match at start of a line (i==0 or preceded by LF)
            at_line = 0
            IfCondition EqualTo(i, 0) ThenBlock: { at_line = 1 }
            IfCondition GreaterThan(i, 0) ThenBlock: {
                prev = GetByte(hdrs, Subtract(i, 1))
                IfCondition EqualTo(prev, 10) ThenBlock: { at_line = 1 }
            }

            IfCondition EqualTo(at_line, 1) ThenBlock: {
                match = 1
                j = 0
                WhileLoop LessThan(j, nlen) {
                    c1 = GetByte(hdrs, Add(i, j))
                    c2 = GetByte(needle, j)
                    IfCondition And(GreaterEqual(c1, 65), LessEqual(c1, 90)) ThenBlock: {
                        c1 = Add(c1, 32)
                    }
                    IfCondition NotEqual(c1, c2) ThenBlock: {
                        match = 0
                        j = nlen
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(match, 1) ThenBlock: {
                    // Skip ": "
                    vstart = Add(i, nlen)
                    IfCondition LessThan(vstart, hdr_len) ThenBlock: {
                        IfCondition EqualTo(GetByte(hdrs, vstart), 58) ThenBlock: {
                            vstart = Add(vstart, 1)
                        }
                    }
                    IfCondition LessThan(vstart, hdr_len) ThenBlock: {
                        IfCondition EqualTo(GetByte(hdrs, vstart), 32) ThenBlock: {
                            vstart = Add(vstart, 1)
                        }
                    }
                    // Find end of value (CR or LF)
                    vend = vstart
                    WhileLoop LessThan(vend, hdr_len) {
                        vc = GetByte(hdrs, vend)
                        IfCondition Or(EqualTo(vc, 13), EqualTo(vc, 10)) ThenBlock: {
                            vend = hdr_len  // break
                        } ElseBlock: {
                            vend = Add(vend, 1)
                        }
                    }
                    // Re-scan for actual end
                    vend = vstart
                    ve_done = 0
                    WhileLoop And(LessThan(vend, hdr_len), EqualTo(ve_done, 0)) {
                        vc = GetByte(hdrs, vend)
                        IfCondition Or(EqualTo(vc, 13), EqualTo(vc, 10)) ThenBlock: {
                            ve_done = 1
                        } ElseBlock: {
                            vend = Add(vend, 1)
                        }
                    }
                    // Copy value and parse
                    vl = Subtract(vend, vstart)
                    IfCondition GreaterThan(vl, 0) ThenBlock: {
                        vbuf = Allocate(Add(vl, 1))
                        MemoryCopy(vbuf, Add(hdrs, vstart), vl)
                        SetByte(vbuf, vl, 0)
                        Cookie_ParseSetCookie(domain, path, vbuf)
                    }
                }
            }
            i = Add(i, 1)
        }
    }
}
