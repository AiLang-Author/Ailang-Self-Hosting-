// Library.HTTPGzip.ailang — Gzip/deflate decompression via subprocess
// Uses /usr/bin/gzip -d or /bin/gunzip for decompression.
// Writes compressed data to a pipe, reads decompressed data back.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena

FixedPool.GzipConst {
    "MAX_DECOMP":   Initialize=8388608  // 8 MB max decompressed
}

// =============================================================================
// HTTPGzip_IsGzip — check Content-Encoding header for gzip/deflate
// Input:  hdrs = raw headers, hdr_len = length
// Output: 1 = gzip, 2 = deflate, 0 = none/identity
// =============================================================================
Function.HTTPGzip_IsGzip {
    Input: hdrs: Address
    Input: hdr_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(hdrs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(hdr_len, 0) ThenBlock: { ReturnValue(0) }

        needle = "content-encoding"
        nlen = 16
        i = 0
        limit = Subtract(hdr_len, nlen)
        WhileLoop LessEqual(i, limit) {
            match = 1
            j = 0
            WhileLoop LessThan(j, nlen) {
                c1 = GetByte(hdrs, Add(i, j))
                c2 = GetByte(needle, j)
                IfCondition And(GreaterEqual(c1, 65), LessEqual(c1, 90)) ThenBlock: {
                    c1 = Add(c1, 32)
                }
                IfCondition NotEqual(c1, c2) ThenBlock: {
                    match = 0
                    j = nlen
                }
                j = Add(j, 1)
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                // Check value after ": "
                vpos = Add(i, nlen)
                WhileLoop LessThan(vpos, hdr_len) {
                    vc = GetByte(hdrs, vpos)
                    IfCondition Or(EqualTo(vc, 13), EqualTo(vc, 10)) ThenBlock: {
                        vpos = hdr_len
                    } ElseBlock: {
                        // Check "gzip"
                        IfCondition LessEqual(Add(vpos, 4), hdr_len) ThenBlock: {
                            IfCondition And(And(
                                Or(EqualTo(GetByte(hdrs, vpos), 103), EqualTo(GetByte(hdrs, vpos), 71)),
                                Or(EqualTo(GetByte(hdrs, Add(vpos, 1)), 122), EqualTo(GetByte(hdrs, Add(vpos, 1)), 90))),
                                And(
                                Or(EqualTo(GetByte(hdrs, Add(vpos, 2)), 105), EqualTo(GetByte(hdrs, Add(vpos, 2)), 73)),
                                Or(EqualTo(GetByte(hdrs, Add(vpos, 3)), 112), EqualTo(GetByte(hdrs, Add(vpos, 3)), 80))))
                            ThenBlock: {
                                ReturnValue(1)
                            }
                        }
                        // Check "deflate"
                        IfCondition LessEqual(Add(vpos, 7), hdr_len) ThenBlock: {
                            dm = 1
                            dk = 0
                            def_str = "deflate"
                            WhileLoop LessThan(dk, 7) {
                                dc1 = GetByte(hdrs, Add(vpos, dk))
                                dc2 = GetByte(def_str, dk)
                                IfCondition And(GreaterEqual(dc1, 65), LessEqual(dc1, 90)) ThenBlock: {
                                    dc1 = Add(dc1, 32)
                                }
                                IfCondition NotEqual(dc1, dc2) ThenBlock: {
                                    dm = 0
                                    dk = 7
                                }
                                dk = Add(dk, 1)
                            }
                            IfCondition EqualTo(dm, 1) ThenBlock: {
                                ReturnValue(2)
                            }
                        }
                        vpos = Add(vpos, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// HTTPGzip_Decompress — decompress gzip/deflate data via subprocess
// Input:  data = compressed bytes, data_len = length
//         out_len_ptr = address to store output length
// Output: pointer to decompressed data, or 0 on failure
// =============================================================================
Function.HTTPGzip_Decompress {
    Input: data: Address
    Input: data_len: Integer
    Input: out_len_ptr: Address
    Output: Address
    Body: {
        IfCondition LessEqual(data_len, 0) ThenBlock: { ReturnValue(0) }

        // Create pipe for stdin (we write compressed data)
        pipe_in = Allocate(16)
        SystemCall(22, pipe_in, 0, 0, 0, 0)
        read_in = Dereference(pipe_in, "dword")
        write_in = Dereference(Add(pipe_in, 4), "dword")

        // Create pipe for stdout (we read decompressed data)
        pipe_out = Allocate(16)
        SystemCall(22, pipe_out, 0, 0, 0, 0)
        read_out = Dereference(pipe_out, "dword")
        write_out = Dereference(Add(pipe_out, 4), "dword")

        // Fork
        pid = SystemCall(57, 0, 0, 0, 0, 0)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            // Child: gzip -d (stdin->stdout)
            SystemCall(33, read_in, 0, 0, 0, 0)     // dup2(read_in, 0)
            SystemCall(33, write_out, 1, 0, 0, 0)   // dup2(write_out, 1)
            SystemCall(3, write_in, 0, 0)            // close write_in
            SystemCall(3, read_out, 0, 0)            // close read_out

            argv = Allocate(24)
            StoreValue(Add(argv, 0), "/bin/gzip")
            StoreValue(Add(argv, 8), "-d")
            StoreValue(Add(argv, 16), 0)

            envp = Allocate(8)
            StoreValue(envp, 0)

            SystemCall(59, "/bin/gzip", argv, envp)
            SystemCall(60, 1, 0, 0, 0, 0)
        }

        // Parent
        SystemCall(3, read_in, 0, 0)     // close read_in
        SystemCall(3, write_out, 0, 0)   // close write_out

        // Write compressed data to child stdin
        written = 0
        WhileLoop LessThan(written, data_len) {
            chunk = Subtract(data_len, written)
            IfCondition GreaterThan(chunk, 65536) ThenBlock: { chunk = 65536 }
            n = SystemCall(1, write_in, Add(data, written), chunk)
            IfCondition LessEqual(n, 0) ThenBlock: {
                written = data_len  // break
            } ElseBlock: {
                written = Add(written, n)
            }
        }
        // Close write end to signal EOF
        SystemCall(3, write_in, 0, 0)

        // Read decompressed data
        out_buf = Allocate(GzipConst.MAX_DECOMP)
        out_total = 0
        read_done = 0
        WhileLoop EqualTo(read_done, 0) {
            remain = Subtract(GzipConst.MAX_DECOMP, out_total)
            IfCondition LessEqual(remain, 0) ThenBlock: {
                read_done = 1
            } ElseBlock: {
                rsize = remain
                IfCondition GreaterThan(rsize, 65536) ThenBlock: { rsize = 65536 }
                n = SystemCall(0, read_out, Add(out_buf, out_total), rsize)
                IfCondition LessEqual(n, 0) ThenBlock: {
                    read_done = 1
                } ElseBlock: {
                    out_total = Add(out_total, n)
                }
            }
        }

        SystemCall(3, read_out, 0, 0)
        // Reap child
        SystemCall(62, pid, 9, 0, 0, 0)    // SIGKILL
        SystemCall(61, pid, 0, 0, 0, 0)    // wait4

        IfCondition EqualTo(out_total, 0) ThenBlock: {
            ReturnValue(0)
        }

        StoreValue(out_len_ptr, out_total)
        ReturnValue(out_buf)
    }
}
