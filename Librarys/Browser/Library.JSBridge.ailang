// STATE QUERY — public accessors
// =============================================================================
Function.JSBridge_GetListenerCount {
    Output: Integer
    Body: {
        ReturnValue(JSBridgeState.listener_count)
    }
}

Function.JSBridge_GetWrapCount {
    Output: Integer
    Body: {
        ReturnValue(JSBridgeState.wrap_count)
    }
}

Function.JSBridge_GetDocObj {
    Output: Address
    Body: {
        ReturnValue(JSBridgeState.document_obj)
    }
}

Function.JSBridge_GetConsoleObj {
    Output: Address
    Body: {
        ReturnValue(JSBridgeState.console_obj)
    }
}

Function.JSBridge_GetMathObj {
    Output: Address
    Body: {
        ReturnValue(JSBridgeState.math_obj)
    }
}

Function.JSBridge_GetWindowObj {
    Output: Address
    Body: {
        ReturnValue(JSBridgeState.window_obj)
    }
}

Function.JSBridge_IsInitialized {
    Output: Integer
    Body: {
        ReturnValue(JSBridgeState.initialized)
    }
}

// =============================================================================
// GET LISTENER CALLBACK — retrieve callback JSValue for a listener by index
// Used by the engine to invoke callbacks via JSVM.
// =============================================================================
Function.JSBridge_GetListenerCB {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(save_idx, JSBridgeState.listener_count) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSBridgeState.listeners, Multiply(save_idx, JSBridgeConst.LISTENER_SIZE))
        ReturnValue(Dereference(Add(base, 16)))
    }
}

// =============================================================================
// GET LISTENER NODE — retrieve the DOM node index for a listener by index
// =============================================================================
Function.JSBridge_GetListenerNode {
    Input: idx: Integer
    Output: Integer
    Body: {
        save_idx = idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterEqual(save_idx, JSBridgeState.listener_count) ThenBlock: {
            ReturnValue(-1)
        }
        base = Add(JSBridgeState.listeners, Multiply(save_idx, JSBridgeConst.LISTENER_SIZE))
        ReturnValue(Dereference(base))
    }
}

// =============================================================================
// GET LISTENER EVENT NAME — retrieve event name ptr for a listener by index
// =============================================================================
Function.JSBridge_GetListenerName {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(save_idx, JSBridgeState.listener_count) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSBridgeState.listeners, Multiply(save_idx, JSBridgeConst.LISTENER_SIZE))
        ReturnValue(Dereference(Add(base, 8)))
    }
}

// =============================================================================
// DEBUG — dump bridge state
// =============================================================================
Function.JSBridge_Dump {
    Body: {
        PrintMessage("\n--- JSBridge State ---\n")
        PrintMessage("  initialized: ")
        PrintNumber(JSBridgeState.initialized)
        PrintMessage("\n  dom_root: ")
        PrintNumber(JSBridgeState.dom_root)
        PrintMessage("\n  wrap_count: ")
        PrintNumber(JSBridgeState.wrap_count)
        PrintMessage("\n  listener_count: ")
        PrintNumber(JSBridgeState.listener_count)
        PrintMessage("\n  stack sp: ")
        PrintNumber(JSBridgeStack.sp)
        PrintMessage("\n--- End JSBridge ---\n\n")
    }
}
