        rec = JSVM_GetGlobal("__bound_rec__")
        IfCondition NotEqual(JSRT_GetType(rec), JSType.OBJECT) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = JSRT_ObjGet(rec, "__bt__")
        this_arg = JSRT_ObjGet(rec, "__bthis__")
        parr = JSRT_ObjGet(rec, "__bargs__")
        ab = JSVMCallBuf.buf
        call_argc = 0
        IfCondition EqualTo(JSRT_GetType(parr), JSType.ARRAY) ThenBlock: {
            plen = JSRT_ArrLen(parr)
            pi = 0
            WhileLoop LessThan(pi, plen) {
                StoreValue(Add(ab, Multiply(call_argc, 8)), JSRT_ArrGet(parr, pi))
                call_argc = Add(call_argc, 1)
                pi = Add(pi, 1)
            }
        }
        ai = 0
        WhileLoop LessThan(ai, save_argc) {
            StoreValue(Add(ab, Multiply(call_argc, 8)), Dereference(Add(save_args, Multiply(ai, 8))))
            call_argc = Add(call_argc, 1)
            ai = Add(ai, 1)
        }
        JSVM__SetGlobal("this", this_arg)
        ret = JSVM__CallFunc(target, ab, call_argc)
        ReturnValue(ret)
    }
