// =============================================================================
// STACK PUSH / POP — save/restore values across clobbering calls
// =============================================================================
Function.JSBridge__Push {
    Input: val: Integer
    Output: Integer
    Body: {
        save_val = val
        addr = Add(JSBridgeStack.pool, Multiply(JSBridgeStack.sp, 8))
        StoreValue(addr, save_val)
        JSBridgeStack.sp = Add(JSBridgeStack.sp, 1)
        ReturnValue(0)
    }
}

Function.JSBridge__Pop {
    Output: Integer
    Body: {
        JSBridgeStack.sp = Subtract(JSBridgeStack.sp, 1)
        addr = Add(JSBridgeStack.pool, Multiply(JSBridgeStack.sp, 8))
        ReturnValue(Dereference(addr))
    }
}

// =============================================================================
// INIT — allocate pools, create global objects, register native functions
// =============================================================================
Function.JSBridge_Init {
    Input: dom_root: Integer
    Output: Integer
    Body: {
        save_root = dom_root

        // Allocate listener pool: 256 * 24 = 6144 bytes
        lsz = Multiply(JSBridgeConst.MAX_LISTENERS, JSBridgeConst.LISTENER_SIZE)
        JSBridgeState.listeners = Allocate(lsz)
        IfCondition EqualTo(JSBridgeState.listeners, 0) ThenBlock: {
            PrintMessage("[JSBridge] listener alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(JSBridgeState.listeners, 0, lsz)
        JSBridgeState.listener_count = 0

        // Allocate DOM wrap pool: 512 * 16 = 8192 bytes
        wsz = Multiply(JSBridgeConst.MAX_DOM_WRAPS, JSBridgeConst.WRAP_SIZE)
        JSBridgeState.dom_wraps = Allocate(wsz)
        IfCondition EqualTo(JSBridgeState.dom_wraps, 0) ThenBlock: {
            PrintMessage("[JSBridge] wrap alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(JSBridgeState.dom_wraps, 0, wsz)
        JSBridgeState.wrap_count = 0

        // Allocate push/pop stack: 2048 * 8 = 16384 bytes
        JSBridgeStack.pool = Allocate(16384)
        IfCondition EqualTo(JSBridgeStack.pool, 0) ThenBlock: {
            PrintMessage("[JSBridge] stack alloc fail\n")
            ReturnValue(0)
        }
        JSBridgeStack.capacity = 2048
        JSBridgeStack.sp = 0

        // Allocate event arg buffer: 8 bytes for passing 1 arg to callbacks
        JSBridgeState.evt_arg_buf = Allocate(8)
        IfCondition EqualTo(JSBridgeState.evt_arg_buf, 0) ThenBlock: {
            PrintMessage("[JSBridge] evt_arg_buf alloc fail\n")
            ReturnValue(0)
        }

        // Save DOM root
        JSBridgeState.dom_root = save_root

        // Create the document object
        JSBridgeState.document_obj = JSBridge__CreateDocObj()

        // Set document.body and document.documentElement from DOM tree
        body_idx = DOM_FindByTag(save_root, "body")
        IfCondition GreaterThan(body_idx, -1) ThenBlock: {
            body_wrap = JSBridge_WrapNode(body_idx)
            JSRT_ObjSet(JSBridgeState.document_obj, "body", body_wrap)
        }
        html_idx = DOM_FindByTag(save_root, "html")
        IfCondition GreaterThan(html_idx, -1) ThenBlock: {
            html_wrap = JSBridge_WrapNode(html_idx)
            JSRT_ObjSet(JSBridgeState.document_obj, "documentElement", html_wrap)
        }

        // Create the console object (bridge version with actual I/O)
        JSBridgeState.console_obj = JSBridge__CreateConsoleObj()

        // Create the Math object (delegates to JSRT built-ins)
        JSBridgeState.math_obj = JSBridge__CreateMathObj()

        // Create the window object (location, navigator, matchMedia, etc.)
        JSBridgeState.window_obj = JSBridge__CreateWindowObj()

        JSBridgeState.initialized = 1
        PrintMessage("[JSBridge] initialized\n")
        ReturnValue(1)
    }
}

// =============================================================================
// SET PAGE URL — call before JSEngine_LoadPage so window.location is correct
// =============================================================================
Function.JSBridge_SetPageURL {
    Input: url: Address
    Input: url_len: Integer
    Output: Integer
    Body: {
        JSBridgeState.page_url = url
        JSBridgeState.page_url_len = url_len
        ReturnValue(1)
    }
}

// =============================================================================
// CREATE WINDOW OBJECT — window.location, window.navigator, window.matchMedia
// =============================================================================
Function.JSBridge__CreateWindowObj {
    Output: Address
    Body: {
        win = JSRT_CreateObject()

        // ─── window.document (alias — set later by RegisterBridgeGlobals) ───
        JSRT_ObjSet(win, "document", JSRT_Null())

        // ─── window.location ───
        loc = JSRT_CreateObject()
        url_ptr = JSBridgeState.page_url
        url_len = JSBridgeState.page_url_len

        IfCondition And(NotEqual(url_ptr, 0), GreaterThan(url_len, 0)) ThenBlock: {
            // Set href = full URL
            JSRT_ObjSet(loc, "href", JSRT_CreateStringLen(url_ptr, url_len))

            // Parse protocol (everything up to "://")
            pi = 0
            proto_end = 0
            WhileLoop LessThan(pi, url_len) {
                IfCondition And(EqualTo(GetByte(url_ptr, pi), 58), EqualTo(proto_end, 0)) ThenBlock: {
                    proto_end = Add(pi, 1)
                }
                pi = Add(pi, 1)
            }
            IfCondition GreaterThan(proto_end, 0) ThenBlock: {
                JSRT_ObjSet(loc, "protocol", JSRT_CreateStringLen(url_ptr, proto_end))
            } ElseBlock: {
                JSRT_ObjSet(loc, "protocol", JSRT_CreateString("http:"))
            }

            // Parse hostname (between "://" and next "/" or end)
            host_start = 0
            IfCondition GreaterThan(proto_end, 0) ThenBlock: {
                // skip "://"
                host_start = Add(proto_end, 2)
            }
            host_end = host_start
            WhileLoop LessThan(host_end, url_len) {
                IfCondition EqualTo(GetByte(url_ptr, host_end), 47) ThenBlock: {
                    host_end = Add(url_len, 1)
                } ElseBlock: {
                    host_end = Add(host_end, 1)
                }
            }
            // host_end might have overshot by 1 if we found /
            IfCondition GreaterThan(host_end, url_len) ThenBlock: {
                host_end = Subtract(host_end, 1)
            }
            actual_host_len = Subtract(host_end, host_start)
            IfCondition GreaterThan(actual_host_len, 0) ThenBlock: {
                JSRT_ObjSet(loc, "hostname", JSRT_CreateStringLen(Add(url_ptr, host_start), actual_host_len))
                JSRT_ObjSet(loc, "host", JSRT_CreateStringLen(Add(url_ptr, host_start), actual_host_len))
            } ElseBlock: {
                JSRT_ObjSet(loc, "hostname", JSRT_CreateString(""))
                JSRT_ObjSet(loc, "host", JSRT_CreateString(""))
            }

            // Parse pathname (from host_end to "?" or "#" or end)
            path_start = host_end
            path_end = path_start
            WhileLoop LessThan(path_end, url_len) {
                pb = GetByte(url_ptr, path_end)
                IfCondition Or(EqualTo(pb, 63), EqualTo(pb, 35)) ThenBlock: {
                    path_end = Add(url_len, 1)
                } ElseBlock: {
                    path_end = Add(path_end, 1)
                }
            }
            IfCondition GreaterThan(path_end, url_len) ThenBlock: {
                path_end = Subtract(path_end, 1)
            }
            path_len = Subtract(path_end, path_start)
            IfCondition GreaterThan(path_len, 0) ThenBlock: {
                JSRT_ObjSet(loc, "pathname", JSRT_CreateStringLen(Add(url_ptr, path_start), path_len))
            } ElseBlock: {
                JSRT_ObjSet(loc, "pathname", JSRT_CreateString("/"))
            }

            // Parse search (from "?" to "#" or end)
            search_start = 0
            si = path_end
            WhileLoop LessThan(si, url_len) {
                IfCondition And(EqualTo(GetByte(url_ptr, si), 63), EqualTo(search_start, 0)) ThenBlock: {
                    search_start = si
                }
                si = Add(si, 1)
            }
            IfCondition GreaterThan(search_start, 0) ThenBlock: {
                // find end of search (# or end)
                se = search_start
                WhileLoop LessThan(se, url_len) {
                    IfCondition EqualTo(GetByte(url_ptr, se), 35) ThenBlock: {
                        se = Add(url_len, 1)
                    } ElseBlock: {
                        se = Add(se, 1)
                    }
                }
                IfCondition GreaterThan(se, url_len) ThenBlock: {
                    se = Subtract(se, 1)
                }
                s_len = Subtract(se, search_start)
                JSRT_ObjSet(loc, "search", JSRT_CreateStringLen(Add(url_ptr, search_start), s_len))
            } ElseBlock: {
                JSRT_ObjSet(loc, "search", JSRT_CreateString(""))
            }

            // Parse hash (from "#" to end)
            hash_start = 0
            hi = 0
            WhileLoop LessThan(hi, url_len) {
                IfCondition And(EqualTo(GetByte(url_ptr, hi), 35), EqualTo(hash_start, 0)) ThenBlock: {
                    hash_start = hi
                }
                hi = Add(hi, 1)
            }
            IfCondition GreaterThan(hash_start, 0) ThenBlock: {
                h_len = Subtract(url_len, hash_start)
                JSRT_ObjSet(loc, "hash", JSRT_CreateStringLen(Add(url_ptr, hash_start), h_len))
            } ElseBlock: {
                JSRT_ObjSet(loc, "hash", JSRT_CreateString(""))
            }

            // origin = protocol + "//" + host
            JSRT_ObjSet(loc, "origin", JSRT_CreateStringLen(url_ptr, host_end))
        } ElseBlock: {
            // No URL — set all to empty
            JSRT_ObjSet(loc, "href", JSRT_CreateString(""))
            JSRT_ObjSet(loc, "protocol", JSRT_CreateString("http:"))
            JSRT_ObjSet(loc, "hostname", JSRT_CreateString(""))
            JSRT_ObjSet(loc, "host", JSRT_CreateString(""))
            JSRT_ObjSet(loc, "pathname", JSRT_CreateString("/"))
            JSRT_ObjSet(loc, "search", JSRT_CreateString(""))
            JSRT_ObjSet(loc, "hash", JSRT_CreateString(""))
            JSRT_ObjSet(loc, "origin", JSRT_CreateString(""))
        }
        JSRT_ObjSet(win, "location", loc)

        // ─── window.navigator ───
        nav = JSRT_CreateObject()
        JSRT_ObjSet(nav, "userAgent", JSRT_CreateString("AilangBrowser/1.0"))
        JSRT_ObjSet(nav, "language", JSRT_CreateString("en-US"))
        JSRT_ObjSet(nav, "platform", JSRT_CreateString("Linux x86_64"))
        JSRT_ObjSet(nav, "cookieEnabled", JSRT_CreateBool(0))
        JSRT_ObjSet(nav, "onLine", JSRT_CreateBool(1))
        JSRT_ObjSet(win, "navigator", nav)

        // ─── window.matchMedia ───
        JSBridge__Push(win)
        mm_func = JSBridge__CreateNativeFunc(JSNativeID.WIN_MATCH_MEDIA, "matchMedia", 1)
        win = JSBridge__Pop()
        JSRT_ObjSet(win, "matchMedia", mm_func)

        // ─── window.addEventListener ───
        JSBridge__Push(win)
        wael_func = JSBridge__CreateNativeFunc(JSNativeID.WIN_ADD_EVENT_LISTENER, "addEventListener", 2)
        win = JSBridge__Pop()
        JSRT_ObjSet(win, "addEventListener", wael_func)

        // ─── window.getComputedStyle ───
        JSBridge__Push(win)
        gcs_func = JSBridge__CreateNativeFunc(JSNativeID.WIN_GET_COMPUTED_STYLE, "getComputedStyle", 1)
        win = JSBridge__Pop()
        JSRT_ObjSet(win, "getComputedStyle", gcs_func)

        // ─── window.requestAnimationFrame ───
        JSBridge__Push(win)
        raf_func = JSBridge__CreateNativeFunc(JSNativeID.WIN_REQUEST_ANIM_FRAME, "requestAnimationFrame", 1)
        win = JSBridge__Pop()
        JSRT_ObjSet(win, "requestAnimationFrame", raf_func)

        // ─── window.cancelAnimationFrame ───
        JSBridge__Push(win)
        caf_func = JSBridge__CreateNativeFunc(JSNativeID.WIN_CANCEL_ANIM_FRAME, "cancelAnimationFrame", 1)
        win = JSBridge__Pop()
        JSRT_ObjSet(win, "cancelAnimationFrame", caf_func)

        // ─── window.innerWidth / window.innerHeight ───
        JSRT_ObjSet(win, "innerWidth", JSRT_CreateNumber(1024))
        JSRT_ObjSet(win, "innerHeight", JSRT_CreateNumber(700))
        JSRT_ObjSet(win, "outerWidth", JSRT_CreateNumber(1024))
        JSRT_ObjSet(win, "outerHeight", JSRT_CreateNumber(700))
        JSRT_ObjSet(win, "screenX", JSRT_CreateNumber(0))
        JSRT_ObjSet(win, "screenY", JSRT_CreateNumber(0))
        JSRT_ObjSet(win, "scrollX", JSRT_CreateNumber(0))
        JSRT_ObjSet(win, "scrollY", JSRT_CreateNumber(0))
        JSRT_ObjSet(win, "devicePixelRatio", JSRT_CreateNumber(1))

        // ─── window.localStorage ───
        ls = JSRT_CreateObject()
        JSBridge__Push(ls)
        lsg_func = JSBridge__CreateNativeFunc(JSNativeID.LOCALSTORAGE_GET, "getItem", 1)
        ls = JSBridge__Pop()
        JSRT_ObjSet(ls, "getItem", lsg_func)
        JSBridge__Push(ls)
        lss_func = JSBridge__CreateNativeFunc(JSNativeID.LOCALSTORAGE_SET, "setItem", 2)
        ls = JSBridge__Pop()
        JSRT_ObjSet(ls, "setItem", lss_func)
        JSBridge__Push(ls)
        lsr_func = JSBridge__CreateNativeFunc(JSNativeID.LOCALSTORAGE_REMOVE, "removeItem", 1)
        ls = JSBridge__Pop()
        JSRT_ObjSet(ls, "removeItem", lsr_func)
        JSRT_ObjSet(win, "localStorage", ls)

        // ─── window.sessionStorage (same stub as localStorage) ───
        JSRT_ObjSet(win, "sessionStorage", ls)

        // ─── window.self / window.window / window.top / window.parent ───
        JSRT_ObjSet(win, "self", win)
        JSRT_ObjSet(win, "window", win)
        JSRT_ObjSet(win, "top", win)
        JSRT_ObjSet(win, "parent", win)

        ReturnValue(win)
    }
}

// =============================================================================
// RESET — clear all pools, reset state
// =============================================================================
Function.JSBridge_Reset {
    Output: Integer
    Body: {
        lsz = Multiply(JSBridgeConst.MAX_LISTENERS, JSBridgeConst.LISTENER_SIZE)
        IfCondition NotEqual(JSBridgeState.listeners, 0) ThenBlock: {
            MemorySet(JSBridgeState.listeners, 0, lsz)
        }
        JSBridgeState.listener_count = 0

        wsz = Multiply(JSBridgeConst.MAX_DOM_WRAPS, JSBridgeConst.WRAP_SIZE)
        IfCondition NotEqual(JSBridgeState.dom_wraps, 0) ThenBlock: {
            MemorySet(JSBridgeState.dom_wraps, 0, wsz)
        }
        JSBridgeState.wrap_count = 0

        JSBridgeState.document_obj = 0
        JSBridgeState.console_obj = 0
        JSBridgeState.math_obj = 0
        JSBridgeState.dom_root = 0
        JSBridgeState.initialized = 0
        JSBridgeStack.sp = 0
        ReturnValue(1)
    }
}

// =============================================================================
// REGISTER GLOBALS — inject document, console, Math, setTimeout, etc.
// into the VM's global hash. Called from JSEngine which passes JSVM_SetGlobal.
// =============================================================================
Function.JSBridge_RegisterGlobals {
    Output: Integer
    Body: {
        // This function is now a stub — actual registration is done by
        // JSEngine__RegisterBridgeGlobals which has access to both
        // JSVM_SetGlobal and JSBridge state.
        ReturnValue(1)
    }
}

// =============================================================================
// HELPER — create a native function JSValue for a given handler ID
// bc_off = -(handler_id + 1), which JSVM decodes back to handler_id
// =============================================================================
Function.JSBridge__CreateNativeFunc {
    Input: handler_id: Integer
    Input: name: Address
    Input: param_count: Integer
    Output: Address
    Body: {
        save_id = handler_id
        save_name = name
        save_pc = param_count
        // bytecode offset = -(handler_id + 1)
        bc_off = Subtract(0, Add(save_id, 1))
        ReturnValue(JSRT_CreateFunc(bc_off, save_pc, 0, save_name))
    }
}

// =============================================================================
// CREATE DOCUMENT OBJECT — JS object with getElementById, querySelector, etc.
// =============================================================================
Function.JSBridge__CreateDocObj {
    Output: Address
    Body: {
        doc = JSRT_CreateObject()

        // ─── document.getElementById ───
        JSBridge__Push(doc)
        gbi_func = JSBridge__CreateNativeFunc(JSNativeID.DOC_GET_BY_ID, "getElementById", 1)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "getElementById", gbi_func)

        // ─── document.querySelector ───
        JSBridge__Push(doc)
        qs_func = JSBridge__CreateNativeFunc(JSNativeID.DOC_QUERY_SEL, "querySelector", 1)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "querySelector", qs_func)

        // ─── document.createElement ───
        JSBridge__Push(doc)
        ce_func = JSBridge__CreateNativeFunc(JSNativeID.DOC_CREATE_ELEM, "createElement", 1)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "createElement", ce_func)

        // ─── document.createTextNode ───
        JSBridge__Push(doc)
        ctn_func = JSBridge__CreateNativeFunc(JSNativeID.DOC_CREATE_TEXT, "createTextNode", 1)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "createTextNode", ctn_func)

        // ─── document.createComment ───
        JSBridge__Push(doc)
        cc_func = JSBridge__CreateNativeFunc(JSNativeID.DOC_CREATE_COMMENT, "createComment", 1)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "createComment", cc_func)

        // ─── document.querySelectorAll ───
        JSBridge__Push(doc)
        qsa_func = JSBridge__CreateNativeFunc(JSNativeID.DOC_QUERY_SEL_ALL, "querySelectorAll", 1)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "querySelectorAll", qsa_func)

        // ─── document.getElementsByTagName ───
        JSBridge__Push(doc)
        gbt_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_GET_ELEMS_TAG, "getElementsByTagName", 1)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "getElementsByTagName", gbt_func)

        // ─── document.getElementsByClassName ───
        JSBridge__Push(doc)
        gbc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_GET_ELEMS_CLS, "getElementsByClassName", 1)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "getElementsByClassName", gbc_func)

        // ─── document.body (set later after parse) ───
        JSRT_ObjSet(doc, "body", JSRT_Null())

        // ─── document.documentElement (set later after parse) ───
        JSRT_ObjSet(doc, "documentElement", JSRT_Null())

        // ─── document.cookie (empty string — no cookie jar yet) ───
        JSRT_ObjSet(doc, "cookie", JSRT_CreateString(""))

        // ─── document.readyState ───
        JSRT_ObjSet(doc, "readyState", JSRT_CreateString("complete"))

        // ─── document.addEventListener ───
        JSBridge__Push(doc)
        dael_func = JSBridge__CreateNativeFunc(JSNativeID.DOC_ADD_EVENT_LISTENER, "addEventListener", 2)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "addEventListener", dael_func)

        // ─── document.head ───
        JSRT_ObjSet(doc, "head", JSRT_Null())

        // ─── document.title ───
        JSRT_ObjSet(doc, "title", JSRT_CreateString(""))

        ReturnValue(doc)
    }
}

