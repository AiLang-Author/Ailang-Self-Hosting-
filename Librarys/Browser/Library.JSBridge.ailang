// M40: user-visible plain object with [[Prototype]] = Object.prototype
// (JSRT_CreateObject intentionally leaves proto null for bootstrap/internal bags)
Function.JSBridge__CreateUserObject {
    Output: Address
    Body: {
        o = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSBridge__Push(o)
            JSRT_ObjSet(o, "__proto__", JSRTState.object_proto)
            o = JSBridge__Pop()
        }
        ReturnValue(o)
    }
}

// Object.getOwnPropertyDescriptor(obj, prop) — return descriptor object
Function.JSBridge__NGetOwnPropDesc {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(save_args)
        name_val = Dereference(Add(save_args, 8))

        // M27b: ToObject(O) — null/undefined TypeError; STRING exotic handled below
        tt0 = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt0, JSType.NULL), EqualTo(tt0, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.getOwnPropertyDescriptor called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }

        // Mole 16: ToPropertyKey so Symbol.iterator descriptors work
        JSBridge__Push(target)
        name_ptr = JSVM_ToPropertyKey(name_val)
        target = JSBridge__Pop()

        // M128e6ai: Proxy [[GetOwnProperty]] trap
        IfCondition EqualTo(JSVM__IsProxy(target), 1) ThenBlock: {
            hnd_gd = JSRT_ObjGet(target, "__p_h__")
            tgt_gd = JSRT_ObjGet(target, "__p_t__")
            trap_gd = JSRT_ObjGet(hnd_gd, "getOwnPropertyDescriptor")
            IfCondition EqualTo(JSRT_GetType(trap_gd), JSType.FUNCTION) ThenBlock: {
                kv_gd = JSRT__AllocValue()
                StoreValue(kv_gd, JSType.STRING)
                StoreValue(Add(kv_gd, 8), name_ptr)
                ab_gd = JSVMCallBuf.buf
                StoreValue(ab_gd, tgt_gd)
                StoreValue(Add(ab_gd, 8), kv_gd)
                save_this_gd = JSVM__GetGlobal("this")
                JSVM__SetGlobal("this", hnd_gd)
                res_gd = JSVM__CallFunc(trap_gd, ab_gd, 2)
                JSVM__SetGlobal("this", save_this_gd)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                ReturnValue(res_gd)
            }
            // No trap — gOPD on target
            target = tgt_gd
        }

