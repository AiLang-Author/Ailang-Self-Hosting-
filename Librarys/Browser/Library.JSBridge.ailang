        // ─── DOC_CREATE_TEXT (100) — document.createTextNode(text) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_CREATE_TEXT) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: {
                ReturnValue(JSBridge_WrapNode(DOM_CreateTextNode("", 0)))
            }
            arg0 = Dereference(save_args)
            str0 = JSRT_ToString(arg0)
            s_ptr = JSRT_GetPayload(str0)
            IfCondition EqualTo(s_ptr, 0) ThenBlock: {
                ReturnValue(JSBridge_WrapNode(DOM_CreateTextNode("", 0)))
            }
            s_len = StringLength(s_ptr)
            ReturnValue(JSBridge_WrapNode(DOM_CreateTextNode(s_ptr, s_len)))
        }

        // ─── DOC_CREATE_COMMENT (101) — document.createComment(text) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_CREATE_COMMENT) ThenBlock: {
