            }
            arg0 = Dereference(save_args)
            str0 = JSRT_ToString(arg0)
            s_ptr = JSRT_GetPayload(str0)
            IfCondition EqualTo(s_ptr, 0) ThenBlock: {
                ReturnValue(JSBridge_WrapNode(DOM_CreateComment("", 0)))
            }
            s_len = StringLength(s_ptr)
            ReturnValue(JSBridge_WrapNode(DOM_CreateComment(s_ptr, s_len)))
        }

        // ─── ELEM_INSERT_BEFORE (102) — node.insertBefore(newNode, refNode) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_INSERT_BEFORE) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            parent_idx = JSBridge__GetThisDomIdx()
            arg1 = Dereference(save_args)
            new_idx = JSBridge__GetArgDomIdx(save_args, 0)
            ref_idx = -1
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                arg2 = Dereference(Add(save_args, 8))
                a2_type = JSRT_GetType(arg2)
                IfCondition NotEqual(a2_type, 1) ThenBlock: {
                    ref_idx = JSBridge__GetArgDomIdx(save_args, 8)
                }
            }
            DOM_InsertBefore(parent_idx, new_idx, ref_idx)
            ReturnValue(arg1)
        }

        // ─── ELEM_REPLACE_CHILD (103) — node.replaceChild(newChild, oldChild) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_REPLACE_CHILD) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            parent_idx = JSBridge__GetThisDomIdx()
            new_idx = JSBridge__GetArgDomIdx(save_args, 0)
            old_idx = JSBridge__GetArgDomIdx(save_args, 8)
            DOM_ReplaceChild(parent_idx, new_idx, old_idx)
            ReturnValue(Dereference(Add(save_args, 8)))
        }

        // ─── ELEM_CONTAINS (104) — node.contains(other) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CONTAINS) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            anc_idx = JSBridge__GetThisDomIdx()
            other_idx = JSBridge__GetArgDomIdx(save_args, 0)
            result = DOM_Contains(anc_idx, other_idx)
            ReturnValue(JSRT_CreateBool(result))
        }

        // ─── ELEM_PARENT_NODE (105) — node.parentNode getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_PARENT_NODE) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            p_idx = DOM_GetParent(node_idx)
            IfCondition LessThan(p_idx, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSBridge_WrapNode(p_idx))
        }

        // ─── ELEM_CHILD_NODES (106) — node.childNodes getter (returns array) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CHILD_NODES) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            arr = JSRT_CreateArray()
            ch = DOM_GetFirstChild(node_idx)
            WhileLoop NotEqual(ch, -1) {
                JSBridge__Push(arr)
                JSBridge__Push(ch)
                wrapped = JSBridge_WrapNode(ch)
                ch = JSBridge__Pop()
                arr = JSBridge__Pop()
                JSRT_ArrPush(arr, wrapped)
                ch = DOM_GetNextSib(ch)
            }
            ReturnValue(arr)
        }

        // ─── ELEM_FIRST_CHILD (107) — node.firstChild getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_FIRST_CHILD) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            fc_idx = DOM_GetFirstChild(node_idx)
            IfCondition LessThan(fc_idx, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSBridge_WrapNode(fc_idx))
        }

        // ─── ELEM_LAST_CHILD (108) — node.lastChild getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_LAST_CHILD) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            lc_idx = DOM_GetLastChild(node_idx)
            IfCondition LessThan(lc_idx, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSBridge_WrapNode(lc_idx))
        }

        // ─── ELEM_NEXT_SIBLING (109) — node.nextSibling getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_NEXT_SIBLING) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            ns_idx = DOM_GetNextSib(node_idx)
            IfCondition LessThan(ns_idx, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSBridge_WrapNode(ns_idx))
        }

        // ─── ELEM_PREV_SIBLING (110) — node.previousSibling getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_PREV_SIBLING) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            ps_idx = DOM_GetPrevSib(node_idx)
            IfCondition LessThan(ps_idx, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSBridge_WrapNode(ps_idx))
        }

        // ─── ELEM_REMOVE (111) — node.remove() ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_REMOVE) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            p_idx = DOM_GetParent(node_idx)
            IfCondition GreaterEqual(p_idx, 0) ThenBlock: {
                DOM_RemoveChild(p_idx, node_idx)
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_TAG_NAME (112) — node.tagName getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_TAG_NAME) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            tag_p = DOM_GetTag(node_idx)
            IfCondition EqualTo(tag_p, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSRT_CreateString(tag_p))
        }

        // ─── ELEM_SET_TEXT_CONTENT (113) — node.textContent = val ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_SET_TEXT_CONTENT) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            node_idx = JSBridge__GetThisDomIdx()
            arg1 = Dereference(save_args)
            str1 = JSRT_ToString(arg1)
            t_ptr = JSRT_GetPayload(str1)
            t_len = 0
            IfCondition NotEqual(t_ptr, 0) ThenBlock: {
                t_len = StringLength(t_ptr)
            }
            DOM_SetTextContent(node_idx, t_ptr, t_len)
            ReturnValue(JSRT_Undefined())
        }

        // ─── DOC_QUERY_SEL_ALL (114) — document.querySelectorAll(sel) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_QUERY_SEL_ALL) ThenBlock: {
            // Simplified: returns array of wrapped nodes matching tag/class/id
            arr = JSRT_CreateArray()
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(arr) }
            arg0 = Dereference(save_args)
            str0 = JSRT_ToString(arg0)
            sel_ptr = JSRT_GetPayload(str0)
            IfCondition EqualTo(sel_ptr, 0) ThenBlock: { ReturnValue(arr) }
            // Use DOM_GetElementsByTagName for tag selectors
            sel_c0 = GetByte(sel_ptr, 0)
            // Allocate result buffer (up to 256 results)
            rbuf = Allocate(2048)
            count = 0
            IfCondition EqualTo(sel_c0, 46) ThenBlock: {
                // .class selector
                count = DOM_GetElementsByClassName(DOMState.root, Add(sel_ptr, 1), rbuf, 256)
            }
            IfCondition NotEqual(sel_c0, 46) ThenBlock: {
                IfCondition EqualTo(sel_c0, 35) ThenBlock: {
                    // #id selector — find single element
                    found = DOM_FindById(DOMState.root, Add(sel_ptr, 1))
                    IfCondition GreaterEqual(found, 0) ThenBlock: {
                        StoreValue(rbuf, found)
                        count = 1
                    }
                }
                IfCondition NotEqual(sel_c0, 35) ThenBlock: {
                    // tag selector
                    count = DOM_GetElementsByTagName(DOMState.root, sel_ptr, rbuf, 256)
                }
            }
            // Wrap each result
            ci = 0
            WhileLoop LessThan(ci, count) {
                JSBridge__Push(arr)
                JSBridge__Push(ci)
                ni = Dereference(Add(rbuf, Multiply(ci, 8)))
                wrapped = JSBridge_WrapNode(ni)
                ci = JSBridge__Pop()
                arr = JSBridge__Pop()
                JSRT_ArrPush(arr, wrapped)
                ci = Add(ci, 1)
            }
            ReturnValue(arr)
        }

        // ─── ELEM_CLASS_LIST_ADD (115) — element.classList.add(cls) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLASS_LIST_ADD) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            cl_idx = JSBridge__GetThisDomIdx()
            cl_arg = Dereference(save_args)
            JSBridge__Push(cl_idx)
            cl_str = JSRT_ToString(cl_arg)
            cl_idx = JSBridge__Pop()
            cl_new = JSRT_GetPayload(cl_str)
            IfCondition EqualTo(cl_new, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            JSBridge__Push(cl_new)
            JSBridge__Push(cl_idx)
            cl_cur = DOM_GetAttr(cl_idx, "class")
            cl_idx = JSBridge__Pop()
            cl_new = JSBridge__Pop()
            // Build new class string: "old new" or just "new"
            cl_nlen = StringLength(cl_new)
            IfCondition EqualTo(cl_cur, 0) ThenBlock: {
                cl_buf = JSRT__StrSlabAlloc(Add(cl_nlen, 1))
                MemoryCopy(cl_buf, cl_new, cl_nlen)
                SetByte(cl_buf, cl_nlen, 0)
                DOM_SetAttr(cl_idx, "class", cl_buf)
            } ElseBlock: {
                // Check if class already present (simple substring check)
                cl_found = StringIndexOf(cl_cur, cl_new)
                IfCondition LessThan(cl_found, 0) ThenBlock: {
                    cl_olen = StringLength(cl_cur)
                    cl_total = Add(Add(cl_olen, 1), cl_nlen)
                    cl_buf = JSRT__StrSlabAlloc(Add(cl_total, 1))
                    MemoryCopy(cl_buf, cl_cur, cl_olen)
                    SetByte(cl_buf, cl_olen, 32)
                    MemoryCopy(Add(cl_buf, Add(cl_olen, 1)), cl_new, cl_nlen)
                    SetByte(cl_buf, cl_total, 0)
                    DOM_SetAttr(cl_idx, "class", cl_buf)
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_CLASS_LIST_RM (116) — element.classList.remove(cls) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLASS_LIST_RM) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            cr_idx = JSBridge__GetThisDomIdx()
            cr_arg = Dereference(save_args)
            JSBridge__Push(cr_idx)
            cr_str = JSRT_ToString(cr_arg)
            cr_idx = JSBridge__Pop()
            cr_rem = JSRT_GetPayload(cr_str)
            IfCondition EqualTo(cr_rem, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            JSBridge__Push(cr_rem)
            JSBridge__Push(cr_idx)
            cr_cur = DOM_GetAttr(cr_idx, "class")
            cr_idx = JSBridge__Pop()
            cr_rem = JSBridge__Pop()
            IfCondition NotEqual(cr_cur, 0) ThenBlock: {
                cr_pos = StringIndexOf(cr_cur, cr_rem)
                IfCondition GreaterEqual(cr_pos, 0) ThenBlock: {
                    // Rebuild class string without the removed token
                    cr_olen = StringLength(cr_cur)
                    cr_rlen = StringLength(cr_rem)
                    cr_buf = JSRT__StrSlabAlloc(Add(cr_olen, 1))
                    cr_wi = 0
                    cr_ri = 0
                    WhileLoop LessThan(cr_ri, cr_olen) {
                        // Skip past the removed class token
                        IfCondition EqualTo(cr_ri, cr_pos) ThenBlock: {
                            cr_ri = Add(cr_ri, cr_rlen)
                            // Skip trailing space
                            IfCondition LessThan(cr_ri, cr_olen) ThenBlock: {
                                IfCondition EqualTo(GetByte(cr_cur, cr_ri), 32) ThenBlock: {
                                    cr_ri = Add(cr_ri, 1)
                                }
                            }
                        } ElseBlock: {
                            SetByte(cr_buf, cr_wi, GetByte(cr_cur, cr_ri))
                            cr_wi = Add(cr_wi, 1)
                            cr_ri = Add(cr_ri, 1)
                        }
                    }
                    // Trim trailing space
                    IfCondition GreaterThan(cr_wi, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(cr_buf, Subtract(cr_wi, 1)), 32) ThenBlock: {
                            cr_wi = Subtract(cr_wi, 1)
                        }
                    }
                    SetByte(cr_buf, cr_wi, 0)
                    DOM_SetAttr(cr_idx, "class", cr_buf)
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_CLASS_LIST_TOG (117) — element.classList.toggle(cls) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLASS_LIST_TOG) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            ct_idx = JSBridge__GetThisDomIdx()
            ct_arg = Dereference(save_args)
            JSBridge__Push(ct_idx)
            ct_str = JSRT_ToString(ct_arg)
            ct_idx = JSBridge__Pop()
            ct_tok = JSRT_GetPayload(ct_str)
            IfCondition EqualTo(ct_tok, 0) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            JSBridge__Push(ct_tok)
            JSBridge__Push(ct_idx)
            ct_cur = DOM_GetAttr(ct_idx, "class")
            ct_idx = JSBridge__Pop()
            ct_tok = JSBridge__Pop()
            ct_has = 0
            IfCondition NotEqual(ct_cur, 0) ThenBlock: {
                IfCondition GreaterEqual(StringIndexOf(ct_cur, ct_tok), 0) ThenBlock: {
                    ct_has = 1
                }
            }
            IfCondition EqualTo(ct_has, 1) ThenBlock: {
                // Remove — call classList.remove logic inline
                // Simplified: set class to empty for v1
                DOM_SetAttr(ct_idx, "class", "")
                ReturnValue(JSRT_CreateBool(0))
            } ElseBlock: {
                // Add
                ct_nlen = StringLength(ct_tok)
                IfCondition EqualTo(ct_cur, 0) ThenBlock: {
                    ct_buf = JSRT__StrSlabAlloc(Add(ct_nlen, 1))
                    MemoryCopy(ct_buf, ct_tok, ct_nlen)
                    SetByte(ct_buf, ct_nlen, 0)
                    DOM_SetAttr(ct_idx, "class", ct_buf)
                } ElseBlock: {
                    ct_olen = StringLength(ct_cur)
                    ct_total = Add(Add(ct_olen, 1), ct_nlen)
                    ct_buf = JSRT__StrSlabAlloc(Add(ct_total, 1))
                    MemoryCopy(ct_buf, ct_cur, ct_olen)
                    SetByte(ct_buf, ct_olen, 32)
                    MemoryCopy(Add(ct_buf, Add(ct_olen, 1)), ct_tok, ct_nlen)
                    SetByte(ct_buf, ct_total, 0)
                    DOM_SetAttr(ct_idx, "class", ct_buf)
                }
                ReturnValue(JSRT_CreateBool(1))
            }
        }

        // ─── ELEM_CLASS_LIST_HAS (118) — element.classList.contains(cls) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLASS_LIST_HAS) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            ch_idx = JSBridge__GetThisDomIdx()
            ch_arg = Dereference(save_args)
            JSBridge__Push(ch_idx)
            ch_str = JSRT_ToString(ch_arg)
            ch_idx = JSBridge__Pop()
            ch_tok = JSRT_GetPayload(ch_str)
            IfCondition EqualTo(ch_tok, 0) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            JSBridge__Push(ch_idx)
            ch_cur = DOM_GetAttr(ch_idx, "class")
            ch_idx = JSBridge__Pop()
            IfCondition EqualTo(ch_cur, 0) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            IfCondition GreaterEqual(StringIndexOf(ch_cur, ch_tok), 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
            ReturnValue(JSRT_CreateBool(0))
        }

        // ─── ELEM_GET_ELEMS_TAG (119) — getElementsByTagName ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_GET_ELEMS_TAG) ThenBlock: {
            arr = JSRT_CreateArray()
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(arr) }
            node_idx = JSBridge__GetDomIdx(save_args)
            arg1 = Dereference(Add(save_args, 8))
            str1 = JSRT_ToString(arg1)
            tag_ptr = JSRT_GetPayload(str1)
            IfCondition EqualTo(tag_ptr, 0) ThenBlock: { ReturnValue(arr) }
            rbuf = Allocate(2048)
            count = DOM_GetElementsByTagName(node_idx, tag_ptr, rbuf, 256)
            ci = 0
            WhileLoop LessThan(ci, count) {
                JSBridge__Push(arr)
                JSBridge__Push(ci)
                ni = Dereference(Add(rbuf, Multiply(ci, 8)))
                wrapped = JSBridge_WrapNode(ni)
                ci = JSBridge__Pop()
                arr = JSBridge__Pop()
                JSRT_ArrPush(arr, wrapped)
                ci = Add(ci, 1)
            }
            ReturnValue(arr)
        }

        // ─── ELEM_GET_ELEMS_CLS (120) — getElementsByClassName ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_GET_ELEMS_CLS) ThenBlock: {
            arr = JSRT_CreateArray()
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(arr) }
            node_idx = JSBridge__GetDomIdx(save_args)
            arg1 = Dereference(Add(save_args, 8))
            str1 = JSRT_ToString(arg1)
            cls_ptr = JSRT_GetPayload(str1)
            IfCondition EqualTo(cls_ptr, 0) ThenBlock: { ReturnValue(arr) }
            rbuf = Allocate(2048)
            count = DOM_GetElementsByClassName(node_idx, cls_ptr, rbuf, 256)
            ci = 0
            WhileLoop LessThan(ci, count) {
                JSBridge__Push(arr)
                JSBridge__Push(ci)
                ni = Dereference(Add(rbuf, Multiply(ci, 8)))
                wrapped = JSBridge_WrapNode(ni)
                ci = JSBridge__Pop()
                arr = JSBridge__Pop()
                JSRT_ArrPush(arr, wrapped)
                ci = Add(ci, 1)
            }
            ReturnValue(arr)
        }

        // ─── WIN_MATCH_MEDIA (121) — window.matchMedia(query) ───
        // Returns { matches: false, media: query, addEventListener: stub }
        IfCondition EqualTo(save_id, JSNativeID.WIN_MATCH_MEDIA) ThenBlock: {
            mql = JSRT_CreateObject()
            // Default: matches = false (dark mode not detected)
            JSRT_ObjSet(mql, "matches", JSRT_CreateBool(0))
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                mq_arg = Dereference(save_args)
                mq_str = JSRT_ToString(mq_arg)
                JSRT_ObjSet(mql, "media", mq_str)
            } ElseBlock: {
                JSRT_ObjSet(mql, "media", JSRT_CreateString(""))
            }
            // Stub addEventListener on the MediaQueryList
            JSRT_ObjSet(mql, "addEventListener", JSRT_Undefined())
            JSRT_ObjSet(mql, "addListener", JSRT_Undefined())
            ReturnValue(mql)
        }

        // ─── WIN_ADD_EVENT_LISTENER (122) — window.addEventListener(event, cb) ───
        IfCondition EqualTo(save_id, JSNativeID.WIN_ADD_EVENT_LISTENER) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            // args[0] = event name, args[1] = callback
            wae_name = Dereference(save_args)
            wae_nstr = JSRT_GetPayload(wae_name)
            IfCondition EqualTo(wae_nstr, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            wae_cb = Dereference(Add(save_args, 8))
            // Register on DOM root (0) as window proxy
            JSBridge_AddListener(0, wae_nstr, wae_cb)
            ReturnValue(JSRT_Undefined())
        }

        // ─── WIN_GET_COMPUTED_STYLE (123) — window.getComputedStyle(elem) ───
        IfCondition EqualTo(save_id, JSNativeID.WIN_GET_COMPUTED_STYLE) ThenBlock: {
            cs = JSRT_CreateObject()
            // Get DOM node from argument
            gcs_dom = -1
            IfCondition GreaterEqual(save_argc, 1) ThenBlock: {
                gcs_arg = Dereference(save_args)
                gcs_dom = JSBridge__GetDomIdx(gcs_arg)
            }
            IfCondition LessThan(gcs_dom, 0) ThenBlock: {
                // No valid element — return defaults
                JSRT_ObjSet(cs, "display", JSRT_CreateString("block"))
                JSRT_ObjSet(cs, "visibility", JSRT_CreateString("visible"))
                JSRT_ObjSet(cs, "position", JSRT_CreateString("static"))
                ReturnValue(cs)
            }
            // Look up common properties via inline style + CSS rules
            // display
            gcs_v = JSBridge__CSSLookup(gcs_dom, "display")
            JSRT__Push(cs)
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                cs = JSRT__Pop()
                JSRT_ObjSet(cs, "display", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                cs = JSRT__Pop()
                JSRT_ObjSet(cs, "display", JSRT_CreateString("block"))
            }
            // visibility
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "visibility")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "visibility", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "visibility", JSRT_CreateString("visible"))
            }
            // position
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "position")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "position", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "position", JSRT_CreateString("static"))
            }
            // color
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "color")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "color", JSRT_CreateString(gcs_v))
            }
            // background-color (also as backgroundColor)
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "background-color")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "backgroundColor", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "background-color", JSRT_CreateString(gcs_v))
            }
            // float (also as cssFloat)
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "float")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "float", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "cssFloat", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "float", JSRT_CreateString("none"))
                JSRT_ObjSet(cs, "cssFloat", JSRT_CreateString("none"))
            }
            // clear
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "clear")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "clear", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "clear", JSRT_CreateString("none"))
            }
            // overflow
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "overflow")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "overflow", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "overflow", JSRT_CreateString("visible"))
            }
            // width, height
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "width")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "width", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "width", JSRT_CreateString("auto"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "height")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "height", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "height", JSRT_CreateString("auto"))
            }
            // margin-top/right/bottom/left (also camelCase)
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "margin-top")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "margin-top", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "marginTop", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "margin-top", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "marginTop", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "margin-right")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "margin-right", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "marginRight", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "margin-right", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "marginRight", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "margin-bottom")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "margin-bottom", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "marginBottom", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "margin-bottom", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "marginBottom", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "margin-left")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "margin-left", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "marginLeft", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "margin-left", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "marginLeft", JSRT_CreateString("0px"))
            }
            // padding-top/right/bottom/left
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "padding-top")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "padding-top", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "paddingTop", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "padding-top", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "paddingTop", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "padding-right")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "padding-right", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "paddingRight", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "padding-right", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "paddingRight", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "padding-bottom")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "padding-bottom", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "paddingBottom", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "padding-bottom", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "paddingBottom", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "padding-left")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "padding-left", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "paddingLeft", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "padding-left", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "paddingLeft", JSRT_CreateString("0px"))
            }
            // font-size, font-weight, font-family
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "font-size")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "fontSize", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "font-size", JSRT_CreateString(gcs_v))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "font-weight")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "fontWeight", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "font-weight", JSRT_CreateString(gcs_v))
            }
            // opacity
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "opacity")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "opacity", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "opacity", JSRT_CreateString("1"))
            }
            // text-align, text-decoration
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "text-align")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "textAlign", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "text-align", JSRT_CreateString(gcs_v))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "text-decoration")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "textDecoration", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "text-decoration", JSRT_CreateString(gcs_v))
            }
            // border-color, border-style, border-width
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "border-color")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "borderColor", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "border-color", JSRT_CreateString(gcs_v))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "border-style")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "borderStyle", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "border-style", JSRT_CreateString(gcs_v))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "border-width")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "borderWidth", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "border-width", JSRT_CreateString(gcs_v))
            }
            // max-width, max-height, min-width, min-height
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "max-width")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "maxWidth", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "max-width", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "maxWidth", JSRT_CreateString("none"))
                JSRT_ObjSet(cs, "max-width", JSRT_CreateString("none"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "max-height")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "maxHeight", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "max-height", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "maxHeight", JSRT_CreateString("none"))
                JSRT_ObjSet(cs, "max-height", JSRT_CreateString("none"))
            }
            // line-height
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "line-height")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "lineHeight", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "line-height", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "lineHeight", JSRT_CreateString("normal"))
                JSRT_ObjSet(cs, "line-height", JSRT_CreateString("normal"))
            }
            ReturnValue(cs)
        }

        // ─── WIN_REQUEST_ANIM_FRAME (124) — requestAnimationFrame(cb) ───
        IfCondition EqualTo(save_id, JSNativeID.WIN_REQUEST_ANIM_FRAME) ThenBlock: {
            // Return a fake ID (non-zero) — actual scheduling not implemented
            ReturnValue(JSRT_CreateNumber(1))
        }

        // ─── WIN_CANCEL_ANIM_FRAME (125) — cancelAnimationFrame(id) ───
        IfCondition EqualTo(save_id, JSNativeID.WIN_CANCEL_ANIM_FRAME) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // ─── DOC_ADD_EVENT_LISTENER (126) — document.addEventListener(event, cb) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_ADD_EVENT_LISTENER) ThenBlock: {
            // If event is "DOMContentLoaded", call cb immediately (page is already loaded)
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                ev_arg = Dereference(save_args)
                ev_str = JSRT_ToString(ev_arg)
                ev_ptr = JSRT_GetPayload(ev_str)
                // Check if "DOMContentLoaded" — starts with 'D' (68)
                IfCondition EqualTo(GetByte(ev_ptr, 0), 68) ThenBlock: {
                    // Call the callback immediately
                    cb_val = Dereference(Add(save_args, 8))
                    cb_type = JSRT_GetType(cb_val)
                    IfCondition EqualTo(cb_type, JSType.FUNCTION) ThenBlock: {
                        JSVM__CallFunc(cb_val, 0, 0)
                    }
                }
                // "load" — starts with 'l' (108)
                IfCondition EqualTo(GetByte(ev_ptr, 0), 108) ThenBlock: {
                    cb_val = Dereference(Add(save_args, 8))
                    cb_type = JSRT_GetType(cb_val)
                    IfCondition EqualTo(cb_type, JSType.FUNCTION) ThenBlock: {
                        JSVM__CallFunc(cb_val, 0, 0)
                    }
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── LOCALSTORAGE_GET (127) — localStorage.getItem(key) ───
        IfCondition EqualTo(save_id, JSNativeID.LOCALSTORAGE_GET) ThenBlock: {
            // Stub — always returns null (no persistent storage yet)
            ReturnValue(JSRT_Null())
        }

        // ─── LOCALSTORAGE_SET (128) — localStorage.setItem(key, value) ───
        IfCondition EqualTo(save_id, JSNativeID.LOCALSTORAGE_SET) ThenBlock: {
            // Stub — accept silently
            ReturnValue(JSRT_Undefined())
        }

        // ─── LOCALSTORAGE_REMOVE (129) — localStorage.removeItem(key) ───
        IfCondition EqualTo(save_id, JSNativeID.LOCALSTORAGE_REMOVE) ThenBlock: {
            // Stub — accept silently
            ReturnValue(JSRT_Undefined())
        }

        // ─── FETCH (140) — fetch(url, options) → Promise<Response> ───
        IfCondition EqualTo(save_id, JSNativeID.FETCH) ThenBlock: {
            // Build a stub Response object
            resp = JSRT_CreateObject()
            JSRT__Push(resp)
            JSRT_ObjSet(resp, "ok", JSRT_CreateBool(0))
            resp = JSRT__Pop()
            JSRT__Push(resp)
            st_val = JSRT_CreateNumber(0)
            resp = JSRT__Pop()
            JSRT_ObjSet(resp, "status", st_val)
            JSRT__Push(resp)
            st_txt = JSRT_CreateString("Network Error")
            resp = JSRT__Pop()
            JSRT_ObjSet(resp, "statusText", st_txt)
            // text() method — returns Promise resolved with ""
            JSRT__Push(resp)
            txt_fn = JSBridge__CreateNativeFunc(JSNativeID.FETCH_TEXT, "text", 0)
            resp = JSRT__Pop()
            JSRT_ObjSet(resp, "text", txt_fn)
            // json() method — returns Promise resolved with {}
            JSRT__Push(resp)
            json_fn = JSBridge__CreateNativeFunc(JSNativeID.FETCH_JSON, "json", 0)
            resp = JSRT__Pop()
            JSRT_ObjSet(resp, "json", json_fn)
            // Wrap in resolved Promise
            JSRT__Push(resp)
            promise = JSRT_CreateObject()
            JSRT__Push(promise)
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(1))
            resp = JSRT__Pop()
            promise = JSRT__Pop()
            JSRT__Push(promise)
            JSRT_ObjSet(promise, "__value__", resp)
            promise = JSRT__Pop()
            JSRT__Push(promise)
            then_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "then", then_fn)
            JSRT__Push(promise)
            catch_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "catch", catch_fn)
            ReturnValue(promise)
        }

        // ─── FETCH_TEXT (141) — response.text() → Promise<string> ───
        IfCondition EqualTo(save_id, JSNativeID.FETCH_TEXT) ThenBlock: {
            empty_str = JSRT_CreateString("")
            // Wrap in resolved Promise
            JSRT__Push(empty_str)
            promise = JSRT_CreateObject()
            JSRT__Push(promise)
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(1))
            empty_str = JSRT__Pop()
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "__value__", empty_str)
            JSRT__Push(promise)
            then_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "then", then_fn)
            JSRT__Push(promise)
            catch_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "catch", catch_fn)
            ReturnValue(promise)
        }

        // ─── FETCH_JSON (142) — response.json() → Promise<object> ───
        IfCondition EqualTo(save_id, JSNativeID.FETCH_JSON) ThenBlock: {
            empty_obj = JSRT_CreateObject()
            // Wrap in resolved Promise
            JSRT__Push(empty_obj)
            promise = JSRT_CreateObject()
            JSRT__Push(promise)
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(1))
            empty_obj = JSRT__Pop()
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "__value__", empty_obj)
            JSRT__Push(promise)
            then_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "then", then_fn)
            JSRT__Push(promise)
            catch_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "catch", catch_fn)
            ReturnValue(promise)
        }

        // ─── ELEM_GET_BOUNDING_RECT (133) — elem.getBoundingClientRect() ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_GET_BOUNDING_RECT) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            bx = JSBridgeState.box_x
            by = JSBridgeState.box_y
            bw = JSBridgeState.box_w
            bh = JSBridgeState.box_h

            rect = JSRT_CreateObject()
            JSRT__Push(rect)
            x_val = JSRT_CreateNumber(bx)
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "x", x_val)
            JSRT_ObjSet(rect, "left", x_val)

            JSRT__Push(rect)
            y_val = JSRT_CreateNumber(by)
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "y", y_val)
            JSRT_ObjSet(rect, "top", y_val)

            JSRT__Push(rect)
            w_val = JSRT_CreateNumber(bw)
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "width", w_val)

            JSRT__Push(rect)
            h_val = JSRT_CreateNumber(bh)
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "height", h_val)

            JSRT__Push(rect)
            r_val = JSRT_CreateNumber(Add(bx, bw))
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "right", r_val)

            JSRT__Push(rect)
            b_val = JSRT_CreateNumber(Add(by, bh))
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "bottom", b_val)

            ReturnValue(rect)
        }

        // ─── ELEM_OFFSET_WIDTH (134) — elem.offsetWidth getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_OFFSET_WIDTH) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_w))
        }

        // ─── ELEM_OFFSET_HEIGHT (135) — elem.offsetHeight getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_OFFSET_HEIGHT) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_h))
        }

        // ─── ELEM_CLIENT_WIDTH (136) — elem.clientWidth getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLIENT_WIDTH) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            // clientWidth = width minus borders (no borders yet, same as offsetWidth)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_w))
        }

        // ─── ELEM_CLIENT_HEIGHT (137) — elem.clientHeight getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLIENT_HEIGHT) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_h))
        }

        // ─── ELEM_SCROLL_WIDTH (138) — elem.scrollWidth getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_SCROLL_WIDTH) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            // scrollWidth = same as clientWidth (no overflow yet)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_w))
        }

        // ─── ELEM_SCROLL_HEIGHT (139) — elem.scrollHeight getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_SCROLL_HEIGHT) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_h))
        }

        // ─── EVT_PREVENT_DEFAULT (130) — event.preventDefault() ───
        IfCondition EqualTo(save_id, JSNativeID.EVT_PREVENT_DEFAULT) ThenBlock: {
            // Set defaultPrevented = true on the event object
            pd_this = JSVM_GetGlobal("this")
            IfCondition NotEqual(pd_this, 0) ThenBlock: {
                pd_type = JSRT_GetType(pd_this)
                IfCondition EqualTo(pd_type, JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(pd_this, "defaultPrevented", JSRT_CreateBool(1))
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── EVT_STOP_PROPAGATION (131) — event.stopPropagation() ───
        IfCondition EqualTo(save_id, JSNativeID.EVT_STOP_PROPAGATION) ThenBlock: {
            // Set flag on event object — checked by event dispatch loop
            sp_this = JSVM_GetGlobal("this")
            IfCondition NotEqual(sp_this, 0) ThenBlock: {
                sp_type = JSRT_GetType(sp_this)
                IfCondition EqualTo(sp_type, JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(sp_this, "__stop_propagation", JSRT_CreateBool(1))
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── EVT_STOP_IMMEDIATE (132) — event.stopImmediatePropagation() ───
        IfCondition EqualTo(save_id, JSNativeID.EVT_STOP_IMMEDIATE) ThenBlock: {
            // Set flags on event object
            si_this = JSVM_GetGlobal("this")
            IfCondition NotEqual(si_this, 0) ThenBlock: {
                si_type = JSRT_GetType(si_this)
                IfCondition EqualTo(si_type, JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(si_this, "__stop_propagation", JSRT_CreateBool(1))
                    JSRT_ObjSet(si_this, "__stop_immediate", JSRT_CreateBool(1))
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // Unknown handler — return undefined
        PrintMessage("[JSBridge] unknown native id: ")
        PrintNumber(save_id)
        PrintMessage("\n")
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// MATH RUNTIME FUNCTIONS — polynomial approximations using Float_* primitives
// =============================================================================

// PRNG state for Math.random()
FixedPool.JSMathState {
    "rng_state":  Initialize=1234567890
}

// IEEE 754 double bit constants
FixedPool.JSMathConst {
    "PI":           Initialize=4614256656552045848     // 3.141592653589793
    "PI_OVER_2":    Initialize=4609753056924675352     // 1.5707963267948966
    "PI_OVER_4":    Initialize=4608983858650965898     // 0.7853981633974483
    "TWO_PI":       Initialize=4618760256179416344     // 6.283185307179586
    "E":            Initialize=4613303445314885481     // 2.718281828459045
    "LN2":          Initialize=4604418534313441775     // 0.6931471805599453
    "ONE":          Initialize=4607182418800017408     // 1.0
    "HALF":         Initialize=4602678819172646912     // 0.5
    "NEG_ONE":      Initialize=-4616189618054758400    // -1.0
    "ZERO":         Initialize=0                       // 0.0
    "TWO":          Initialize=4611686018427387904     // 2.0
    "INV_LN2":      Initialize=4609176140021203710     // 1.4426950408889634 (1/ln2)
}

Function.JSBridge__MathSin {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        arg0 = Dereference(args)
        x = JSRT_ToNumber(arg0)

        // Range reduction: x = x mod 2π, then to [-π, π]
        twopi = JSMathConst.TWO_PI
        pi = JSMathConst.PI
        pi2 = JSMathConst.PI_OVER_2
        zero = JSMathConst.ZERO
        one = JSMathConst.ONE
        neg_one = JSMathConst.NEG_ONE

        // x = x - floor(x / 2π) * 2π
        q = Float_Div(x, twopi)
        qi = Float_FromInt(Float_ToInt(q))
        // Adjust for negative: if x < 0 and qi*2π > x, subtract 1
        IfCondition EqualTo(Float_Lt(x, zero), 1) ThenBlock: {
            IfCondition EqualTo(Float_Gt(Float_Mul(qi, twopi), x), 1) ThenBlock: {
                qi = Float_Sub(qi, one)
            }
        }
        x = Float_Sub(x, Float_Mul(qi, twopi))

        // Now x is in [0, 2π). Shift to [-π, π]
        IfCondition EqualTo(Float_Gt(x, pi), 1) ThenBlock: {
            x = Float_Sub(x, twopi)
        }

        // Determine quadrant and reduce to [-π/4, π/4]
        negate = 0
        use_cos = 0
        IfCondition EqualTo(Float_Lt(x, zero), 1) ThenBlock: {
            x = Float_Sub(zero, x)
            negate = 1
        }
        // x is now in [0, π]
        IfCondition EqualTo(Float_Gt(x, pi2), 1) ThenBlock: {
            x = Float_Sub(pi, x)
        }
        // x is now in [0, π/2]
        pi4 = JSMathConst.PI_OVER_4
        IfCondition EqualTo(Float_Gt(x, pi4), 1) ThenBlock: {
            x = Float_Sub(pi2, x)
            use_cos = 1
        }

        // Horner polynomial for sin(r) on [-π/4, π/4]:
        // sin(r) ≈ r * (1 + r² * (S1 + r² * (S3 + r² * S5)))
        // S1 = -1/6, S3 = 1/120, S5 = -1/5040
        r2 = Float_Mul(x, x)
        s5 = -4690140042714716877   // -1.984126984126984e-04 ~ -1/5040
        s3 = 4587366580439060480    //  8.333333333333334e-03 ~ 1/120
        s1 = -4628224478906402638   // -1.666666666666667e-01 ~ -1/6

        p = Float_Add(s3, Float_Mul(r2, s5))
        p = Float_Add(s1, Float_Mul(r2, p))
        p = Float_Add(one, Float_Mul(r2, p))
        sin_r = Float_Mul(x, p)

        // Horner polynomial for cos(r) on [-π/4, π/4]:
        // cos(r) ≈ 1 - r²/2 + r⁴ * (C2 + r² * C4)
        // C2 = 1/24, C4 = -1/720
        c4 = -4694822388953498778   // -1.388888888888889e-03 ~ -1/720
        c2 = 4555984893392498483    //  4.166666666666667e-02 ~ 1/24
        half = JSMathConst.HALF

        r4 = Float_Mul(r2, r2)
        cp = Float_Add(c2, Float_Mul(r2, c4))
        cos_r = Float_Add(Float_Sub(one, Float_Mul(half, r2)), Float_Mul(r4, cp))

        IfCondition EqualTo(use_cos, 1) ThenBlock: {
            result = cos_r
        } ElseBlock: {
            result = sin_r
        }

        IfCondition EqualTo(negate, 1) ThenBlock: {
            result = Float_Sub(zero, result)
        }

        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathCos {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        arg0 = Dereference(args)
        x = JSRT_ToNumber(arg0)

        // Range reduction: same as sin but shifted by π/2
        twopi = JSMathConst.TWO_PI
        pi = JSMathConst.PI
        pi2 = JSMathConst.PI_OVER_2
        zero = JSMathConst.ZERO
        one = JSMathConst.ONE

        // x = x - floor(x / 2π) * 2π
        q = Float_Div(x, twopi)
        qi = Float_FromInt(Float_ToInt(q))
        IfCondition EqualTo(Float_Lt(x, zero), 1) ThenBlock: {
            IfCondition EqualTo(Float_Gt(Float_Mul(qi, twopi), x), 1) ThenBlock: {
                qi = Float_Sub(qi, one)
            }
        }
        x = Float_Sub(x, Float_Mul(qi, twopi))

        // Shift to [-π, π]
        IfCondition EqualTo(Float_Gt(x, pi), 1) ThenBlock: {
            x = Float_Sub(x, twopi)
        }

        // cos(x) = sin(x + π/2), so shift by π/2
        x = Float_Add(x, pi2)
        // Re-normalize to [-π, π]
        IfCondition EqualTo(Float_Gt(x, pi), 1) ThenBlock: {
            x = Float_Sub(x, twopi)
        }

        // Now compute sin(x) with the same polynomial
        negate = 0
        use_cos = 0
        IfCondition EqualTo(Float_Lt(x, zero), 1) ThenBlock: {
            x = Float_Sub(zero, x)
            negate = 1
        }
        IfCondition EqualTo(Float_Gt(x, pi2), 1) ThenBlock: {
            x = Float_Sub(pi, x)
        }
        pi4 = JSMathConst.PI_OVER_4
        IfCondition EqualTo(Float_Gt(x, pi4), 1) ThenBlock: {
            x = Float_Sub(pi2, x)
            use_cos = 1
        }

        r2 = Float_Mul(x, x)
        s5 = -4690140042714716877
        s3 = 4587366580439060480
        s1 = -4628224478906402638

        p = Float_Add(s3, Float_Mul(r2, s5))
        p = Float_Add(s1, Float_Mul(r2, p))
        p = Float_Add(one, Float_Mul(r2, p))
        sin_r = Float_Mul(x, p)

        c4 = -4694822388953498778
        c2 = 4555984893392498483
        half = JSMathConst.HALF

        r4 = Float_Mul(r2, r2)
        cp = Float_Add(c2, Float_Mul(r2, c4))
        cos_r = Float_Add(Float_Sub(one, Float_Mul(half, r2)), Float_Mul(r4, cp))

        IfCondition EqualTo(use_cos, 1) ThenBlock: {
            result = cos_r
        } ElseBlock: {
            result = sin_r
        }

        IfCondition EqualTo(negate, 1) ThenBlock: {
            result = Float_Sub(zero, result)
        }

        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathTan {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        // tan(x) = sin(x) / cos(x)
        // Compute sin first, save result
        sin_v = JSBridge__MathSin(args, argc)
        sin_bits = JSRT_GetPayload(sin_v)

        cos_v = JSBridge__MathCos(args, argc)
        cos_bits = JSRT_GetPayload(cos_v)

        result = Float_Div(sin_bits, cos_bits)
        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathLog {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        arg0 = Dereference(args)
        x = JSRT_ToNumber(arg0)
        zero = JSMathConst.ZERO
        one = JSMathConst.ONE
        two = JSMathConst.TWO

        // Handle edge cases
        IfCondition Or(EqualTo(Float_Le(x, zero), 1), EqualTo(x, 0)) ThenBlock: {
            // log(0) = -Infinity, log(negative) = NaN
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }

        // Decompose: x = m * 2^e where 1 <= m < 2
        // Extract exponent from IEEE 754 bits
        exp_bits = BitwiseAnd(RightShift(x, 52), 2047)
        exp_val = Subtract(exp_bits, 1023)
        // Replace exponent with 1023 (bias) → m in [1, 2)
        m = BitwiseOr(BitwiseAnd(x, 4503599627370495), 4607182418800017408)

        // ln(x) = ln(m) + e * ln(2)
        // For ln(m) where m in [1,2), use: let f = m - 1, then
        // ln(1+f) ≈ f - f²/2 + f³/3 - f⁴/4 + f⁵/5 - f⁶/6
        f = Float_Sub(m, one)
        f2 = Float_Mul(f, f)
        f3 = Float_Mul(f2, f)
        f4 = Float_Mul(f3, f)
        f5 = Float_Mul(f4, f)
        f6 = Float_Mul(f5, f)

        half = JSMathConst.HALF
        third = Float_Div(one, Float_FromInt(3))
        fourth = Float_Div(one, Float_FromInt(4))
        fifth = Float_Div(one, Float_FromInt(5))
        sixth = Float_Div(one, Float_FromInt(6))

        ln_m = Float_Sub(f, Float_Mul(half, f2))
        ln_m = Float_Add(ln_m, Float_Mul(third, f3))
        ln_m = Float_Sub(ln_m, Float_Mul(fourth, f4))
        ln_m = Float_Add(ln_m, Float_Mul(fifth, f5))
        ln_m = Float_Sub(ln_m, Float_Mul(sixth, f6))

        e_f = Float_FromInt(exp_val)
        ln2 = JSMathConst.LN2
        result = Float_Add(ln_m, Float_Mul(e_f, ln2))

        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathExp {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        arg0 = Dereference(args)
        x = JSRT_ToNumber(arg0)
        one = JSMathConst.ONE
        zero = JSMathConst.ZERO

        // exp(x) = 2^(x/ln2) = 2^n * exp(r) where n = floor(x/ln2), r = x - n*ln2
        inv_ln2 = JSMathConst.INV_LN2
        ln2 = JSMathConst.LN2

        xdl = Float_Mul(x, inv_ln2)
        n = Float_ToInt(xdl)
        // Adjust for negative
        nf = Float_FromInt(n)
        IfCondition EqualTo(Float_Gt(nf, xdl), 1) ThenBlock: {
            n = Subtract(n, 1)
            nf = Float_FromInt(n)
        }
        r = Float_Sub(x, Float_Mul(nf, ln2))

        // exp(r) for small r via Taylor series: 1 + r + r²/2! + r³/3! + ... + r⁷/7!
        r2 = Float_Mul(r, r)
        r3 = Float_Mul(r2, r)
        r4 = Float_Mul(r3, r)
        r5 = Float_Mul(r4, r)
        r6 = Float_Mul(r5, r)
        r7 = Float_Mul(r6, r)

        half = JSMathConst.HALF
        inv6 = Float_Div(one, Float_FromInt(6))
        inv24 = Float_Div(one, Float_FromInt(24))
        inv120 = Float_Div(one, Float_FromInt(120))
        inv720 = Float_Div(one, Float_FromInt(720))
        inv5040 = Float_Div(one, Float_FromInt(5040))

        exp_r = Float_Add(one, r)
        exp_r = Float_Add(exp_r, Float_Mul(half, r2))
        exp_r = Float_Add(exp_r, Float_Mul(inv6, r3))
        exp_r = Float_Add(exp_r, Float_Mul(inv24, r4))
        exp_r = Float_Add(exp_r, Float_Mul(inv120, r5))
        exp_r = Float_Add(exp_r, Float_Mul(inv720, r6))
        exp_r = Float_Add(exp_r, Float_Mul(inv5040, r7))

        // Multiply by 2^n: adjust IEEE 754 exponent
        // 2^n as double: exponent field = n + 1023
        IfCondition And(GreaterThan(n, -1023), LessThan(n, 1024)) ThenBlock: {
            exp_bias = Add(n, 1023)
            pow2n = LeftShift(exp_bias, 52)
            result = Float_Mul(exp_r, pow2n)
        } ElseBlock: {
            // Overflow/underflow
            IfCondition GreaterEqual(n, 1024) ThenBlock: {
                result = 9218868437227405312  // +Infinity
            } ElseBlock: {
                result = zero
            }
        }

        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathRandom {
    Output: Address
    Body: {
        // xorshift64 PRNG
        s = JSMathState.rng_state
        IfCondition EqualTo(s, 0) ThenBlock: { s = 88172645463325252 }
        s = BitwiseXor(s, LeftShift(s, 13))
        s = BitwiseXor(s, RightShift(s, 7))
        s = BitwiseXor(s, LeftShift(s, 17))
        JSMathState.rng_state = s

        // Convert to [0, 1): take lower 32 bits, divide by 2^32
        bits = BitwiseAnd(s, 4294967295)
        f_bits = Float_FromInt(bits)
        f_max = Float_FromInt(4294967296)
        result = Float_Div(f_bits, f_max)

        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathAtan2 {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 2) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        // Simplified atan2 using atan(y/x) with quadrant correction
        arg0 = Dereference(args)
        JSRT__Push(args)
        y = JSRT_ToNumber(arg0)
        args = JSRT__Pop()
        arg1 = Dereference(Add(args, 8))
        JSRT__Push(y)
        x = JSRT_ToNumber(arg1)
        y = JSRT__Pop()

        pi = JSMathConst.PI
        pi2 = JSMathConst.PI_OVER_2
        zero = JSMathConst.ZERO
        one = JSMathConst.ONE

        // atan(t) for |t| <= 1: t - t³/3 + t⁵/5 - t⁷/7
        // For |t| > 1: π/2 - atan(1/t)

        // Handle special cases
        x_zero = Float_Eq(x, zero)
        IfCondition EqualTo(x_zero, 1) ThenBlock: {
            IfCondition EqualTo(Float_Gt(y, zero), 1) ThenBlock: {
                ReturnValue(JSRT_CreateFloat(pi2))
            }
            IfCondition EqualTo(Float_Lt(y, zero), 1) ThenBlock: {
                ReturnValue(JSRT_CreateFloat(Float_Sub(zero, pi2)))
            }
            ReturnValue(JSRT_CreateFloat(zero))
        }

        t = Float_Div(y, x)
        // atan(t) approximation
        negate = 0
        recip = 0
        IfCondition EqualTo(Float_Lt(t, zero), 1) ThenBlock: {
            t = Float_Sub(zero, t)
            negate = 1
        }
        IfCondition EqualTo(Float_Gt(t, one), 1) ThenBlock: {
            t = Float_Div(one, t)
            recip = 1
        }

        t2 = Float_Mul(t, t)
        t3 = Float_Mul(t2, t)
        t5 = Float_Mul(t3, t2)
        t7 = Float_Mul(t5, t2)

        third = Float_Div(one, Float_FromInt(3))
        fifth = Float_Div(one, Float_FromInt(5))
        seventh = Float_Div(one, Float_FromInt(7))

        at = Float_Sub(t, Float_Mul(third, t3))
        at = Float_Add(at, Float_Mul(fifth, t5))
        at = Float_Sub(at, Float_Mul(seventh, t7))

        IfCondition EqualTo(recip, 1) ThenBlock: {
            at = Float_Sub(pi2, at)
        }
        IfCondition EqualTo(negate, 1) ThenBlock: {
            at = Float_Sub(zero, at)
        }

        // Quadrant adjustment
        IfCondition EqualTo(Float_Lt(x, zero), 1) ThenBlock: {
            IfCondition EqualTo(Float_Ge(y, zero), 1) ThenBlock: {
                at = Float_Add(at, pi)
            } ElseBlock: {
                at = Float_Sub(at, pi)
            }
        }

        ReturnValue(JSRT_CreateFloat(at))
    }
}

// =============================================================================
// PROMISE DISPATCH — handles Promise.then/catch/ctor/resolve/reject
// Called from CALL handler with func_val env = promise receiver.
// =============================================================================
Function.JSBridge__DispatchPromise {
    Input: handler_id: Integer
    Input: promise_recv: Address
    Input: arg_buf: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_hid = handler_id
        save_pr = promise_recv
        save_args = arg_buf
        save_argc = argc

        // ─── PROMISE_RESOLVE (57) ─── create fulfilled promise
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_RESOLVE) ThenBlock: {
            p_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                p_val = Dereference(save_args)
            }
            ReturnValue(JSBridge__CreatePromise(1, p_val))
        }

        // ─── PROMISE_REJECT (58) ─── create rejected promise
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_REJECT) ThenBlock: {
            p_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                p_val = Dereference(save_args)
            }
            ReturnValue(JSBridge__CreatePromise(2, p_val))
        }

        // ─── PROMISE_THEN (59) ─── eager callback on settled promise
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_THEN) ThenBlock: {
            // Get promise state and value from receiver
            p_state = JSRT_ObjGet(save_pr, "__state__")
            p_state_n = Float_ToInt(JSRT_GetPayload(p_state))
            p_value = JSRT_ObjGet(save_pr, "__value__")

            // onFulfilled = arg0, onRejected = arg1
            on_ful = JSRT_Undefined()
            on_rej = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                on_ful = Dereference(save_args)
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                on_rej = Dereference(Add(save_args, 8))
            }

            // Fulfilled: call onFulfilled(value)
            IfCondition EqualTo(p_state_n, 1) ThenBlock: {
                ful_type = JSRT_GetType(on_ful)
                IfCondition EqualTo(ful_type, JSType.FUNCTION) ThenBlock: {
                    cb_buf = JSVMCallBuf.buf
                    StoreValue(cb_buf, p_value)
                    cb_result = JSVM__CallFunc(on_ful, cb_buf, 1)
                    ReturnValue(JSBridge__CreatePromise(1, cb_result))
                }
                // No callback — pass through value
                ReturnValue(JSBridge__CreatePromise(1, p_value))
            }

            // Rejected: call onRejected(reason)
            IfCondition EqualTo(p_state_n, 2) ThenBlock: {
                rej_type = JSRT_GetType(on_rej)
                IfCondition EqualTo(rej_type, JSType.FUNCTION) ThenBlock: {
                    cb_buf = JSVMCallBuf.buf
                    StoreValue(cb_buf, p_value)
                    cb_result = JSVM__CallFunc(on_rej, cb_buf, 1)
                    ReturnValue(JSBridge__CreatePromise(1, cb_result))
                }
                // No onRejected — pass through rejection
                ReturnValue(JSBridge__CreatePromise(2, p_value))
            }

            // Pending (0) — for eager execution, just pass through
            ReturnValue(JSBridge__CreatePromise(0, JSRT_Undefined()))
        }

        // ─── PROMISE_CATCH (60) ─── shorthand for .then(undefined, onRejected)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_CATCH) ThenBlock: {
            p_state = JSRT_ObjGet(save_pr, "__state__")
            p_state_n = Float_ToInt(JSRT_GetPayload(p_state))
            p_value = JSRT_ObjGet(save_pr, "__value__")

            on_rej = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                on_rej = Dereference(save_args)
            }

            // Only call handler on rejection
            IfCondition EqualTo(p_state_n, 2) ThenBlock: {
                rej_type = JSRT_GetType(on_rej)
                IfCondition EqualTo(rej_type, JSType.FUNCTION) ThenBlock: {
                    cb_buf = JSVMCallBuf.buf
                    StoreValue(cb_buf, p_value)
                    cb_result = JSVM__CallFunc(on_rej, cb_buf, 1)
                    ReturnValue(JSBridge__CreatePromise(1, cb_result))
                }
                ReturnValue(JSBridge__CreatePromise(2, p_value))
            }

            // Fulfilled — pass through
            IfCondition EqualTo(p_state_n, 1) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(1, p_value))
            }
            ReturnValue(JSBridge__CreatePromise(0, JSRT_Undefined()))
        }

        // ─── PROMISE_CTOR (61) ─── new Promise(executor)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_CTOR) ThenBlock: {
            // Create pending promise
            promise = JSRT_CreateObject()
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(0))
            JSRT_ObjSet(promise, "__value__", JSRT_Undefined())
            ct_then = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(ct_then, promise)
            JSRT_ObjSet(promise, "then", ct_then)
            ct_catch = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(ct_catch, promise)
            JSRT_ObjSet(promise, "catch", ct_catch)

            // Get executor (arg0)
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                executor = Dereference(save_args)
                ex_type = JSRT_GetType(executor)
                IfCondition EqualTo(ex_type, JSType.FUNCTION) ThenBlock: {
                    // Create resolve/reject native functions with env = promise
                    res_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_INT_RESOLVE, "resolve", 1)
                    JSRT_FuncSetEnv(res_f, promise)
                    rej_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_INT_REJECT, "reject", 1)
                    JSRT_FuncSetEnv(rej_f, promise)
                    // Call executor(resolve, reject) with 2 args
                    ex_args = JSVMCallBuf.buf
                    StoreValue(ex_args, res_f)
                    StoreValue(Add(ex_args, 8), rej_f)
                    JSVM__CallFunc(executor, ex_args, 2)
                }
            }
            ReturnValue(promise)
        }

        // ─── PROMISE_INT_RESOLVE (77) ─── internal resolve(value)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_INT_RESOLVE) ThenBlock: {
            r_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                r_val = Dereference(save_args)
            }
            JSRT_ObjSet(save_pr, "__state__", JSRT_CreateNumber(1))
            JSRT_ObjSet(save_pr, "__value__", r_val)
            ReturnValue(JSRT_Undefined())
        }

        // ─── PROMISE_INT_REJECT (78) ─── internal reject(reason)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_INT_REJECT) ThenBlock: {
            r_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                r_val = Dereference(save_args)
            }
            JSRT_ObjSet(save_pr, "__state__", JSRT_CreateNumber(2))
            JSRT_ObjSet(save_pr, "__value__", r_val)
            ReturnValue(JSRT_Undefined())
        }

        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// PROMISE HELPER — create a promise object with given state and value
// =============================================================================
Function.JSBridge__CreatePromise {
    Input: state: Integer
    Input: value: Address
    Output: Address
    Body: {
        save_state = state
        save_value = value
        p = JSRT_CreateObject()
        JSRT_ObjSet(p, "__class__", JSRT_CreateString("Promise"))
        JSRT_ObjSet(p, "__state__", JSRT_CreateNumber(save_state))
        JSRT_ObjSet(p, "__value__", save_value)
        p_then = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
        JSRT_FuncSetEnv(p_then, p)
        JSRT_ObjSet(p, "then", p_then)
        p_catch = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
        JSRT_FuncSetEnv(p_catch, p)
        JSRT_ObjSet(p, "catch", p_catch)
        ReturnValue(p)
    }
}

// =============================================================================
// NATIVE: console.log — coerce all args to string, print each
// =============================================================================
Function.JSBridge__NConsoleLog {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        ai = 0
        WhileLoop LessThan(ai, save_argc) {
            arg_addr = Add(save_args, Multiply(ai, 8))
            arg_val = Dereference(arg_addr)

            // Convert to string for printing
            JSBridge__Push(save_args)
            JSBridge__Push(save_argc)
            JSBridge__Push(ai)
            str_val = JSRT_ToString(arg_val)
            ai = JSBridge__Pop()
            save_argc = JSBridge__Pop()
            save_args = JSBridge__Pop()

            // Get the string payload and print it
            str_ptr = JSRT_GetPayload(str_val)
            IfCondition NotEqual(str_ptr, 0) ThenBlock: {
                IfCondition GreaterThan(ai, 0) ThenBlock: {
                    PrintMessage(" ")
                }
                PrintMessage(str_ptr)
            }
            ai = Add(ai, 1)
        }
        PrintMessage("\n")
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// NATIVE: document.getElementById — find DOM node by id, return wrapped
// =============================================================================
Function.JSBridge__NGetById {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Get first arg (should be string)
        arg0 = Dereference(save_args)
        arg0_type = JSRT_GetType(arg0)
        IfCondition NotEqual(arg0_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Extract string pointer
        id_str = JSRT_GetPayload(arg0)
        IfCondition EqualTo(id_str, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Search DOM tree
        found = DOM_FindById(JSBridgeState.dom_root, id_str)
        IfCondition LessThan(found, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Wrap the DOM node as a JS object
        ReturnValue(JSBridge_WrapNode(found))
    }
}

// =============================================================================
// NATIVE: document.querySelector — simplified v1 (tag name only)
// =============================================================================
Function.JSBridge__NQuerySel {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        arg0 = Dereference(save_args)
        arg0_type = JSRT_GetType(arg0)
        IfCondition NotEqual(arg0_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        sel_str = JSRT_GetPayload(arg0)
        IfCondition EqualTo(sel_str, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // v1: treat selector as tag name
        found = DOM_FindByTag(JSBridgeState.dom_root, sel_str)
        IfCondition LessThan(found, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        ReturnValue(JSBridge_WrapNode(found))
    }
}

// =============================================================================
// NATIVE: element.getAttribute — get DOM attribute value as JS string
// args[0] = element wrapper object, args[1] = attribute name string
// Note: in practice, the element is the `this` object. For v1, we accept
// args[0] as the attribute name and determine element from the wrapper
// that was used to look up this function. Since JSVM does not pass `this`,
// we use a fallback: if args[0] is a string, treat it as attr name and
// try to find the element from the wrapper cache by scanning for the last
// accessed wrapper. This is a v1 simplification.
// =============================================================================
Function.JSBridge__NGetAttr {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // args[0] = element wrapper, args[1] = attr name
        elem_val = Dereference(save_args)
        JSBridge__Push(save_args)
        JSBridge__Push(save_argc)
        dom_idx = JSBridge__GetDomIdx(elem_val)
        save_argc = JSBridge__Pop()
        save_args = JSBridge__Pop()

        IfCondition LessThan(dom_idx, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Get attribute name string
        name_addr = Add(save_args, 8)
        name_val = Dereference(name_addr)
        name_type = JSRT_GetType(name_val)
        IfCondition NotEqual(name_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        name_str = JSRT_GetPayload(name_val)
        IfCondition EqualTo(name_str, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Look up attribute in DOM
        JSBridge__Push(dom_idx)
        attr_val = DOM_GetAttr(dom_idx, name_str)
        dom_idx = JSBridge__Pop()
        IfCondition EqualTo(attr_val, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        ReturnValue(JSRT_CreateString(attr_val))
    }
}

// =============================================================================
// NATIVE: element.addEventListener — register event listener
// args[0] = element wrapper, args[1] = event name, args[2] = callback
// =============================================================================
Function.JSBridge__NAddListener {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 3) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // args[0] = element wrapper
        elem_val = Dereference(save_args)
        JSBridge__Push(save_args)
        JSBridge__Push(save_argc)
        dom_idx = JSBridge__GetDomIdx(elem_val)
        save_argc = JSBridge__Pop()
        save_args = JSBridge__Pop()

        IfCondition LessThan(dom_idx, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // args[1] = event name string
        name_addr = Add(save_args, 8)
        name_val = Dereference(name_addr)
        name_str = JSRT_GetPayload(name_val)

        // args[2] = callback function
        cb_addr = Add(save_args, 16)
        cb_val = Dereference(cb_addr)

        // Register the listener
        JSBridge_AddListener(dom_idx, name_str, cb_val)

        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// NATIVE: element.innerHTML get — return inner text as JS string
// args[0] = element wrapper object
// =============================================================================
Function.JSBridge__NInnerHTMLGet {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }

        elem_val = Dereference(save_args)
        JSBridge__Push(save_args)
        dom_idx = JSBridge__GetDomIdx(elem_val)
        save_args = JSBridge__Pop()

        IfCondition LessThan(dom_idx, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }

        text_ptr = JSBridge__GetNodeText(dom_idx)
        IfCondition EqualTo(text_ptr, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }

        ReturnValue(JSRT_CreateString(text_ptr))
    }
}

// =============================================================================
// NATIVE: setTimeout — register one-shot timer
// args[0] = callback function, args[1] = delay in ms
// Returns timer ID as number
// =============================================================================
Function.JSBridge__NSetTimeout {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        // args[0] = callback
        cb_val = Dereference(save_args)

        // args[1] = delay
        delay_addr = Add(save_args, 8)
        delay_val = Dereference(delay_addr)
        JSBridge__Push(cb_val)
        delay_ms = JSRT_ToNumber(delay_val)
        cb_val = JSBridge__Pop()

        // Register one-shot timer (is_interval=0)
        timer_id = JSRT_TimerAdd(cb_val, delay_ms, 0)
        ReturnValue(JSRT_CreateNumber(timer_id))
    }
}

// =============================================================================
// NATIVE: setInterval — register repeating timer
// args[0] = callback function, args[1] = interval in ms
// Returns timer ID as number
// =============================================================================
Function.JSBridge__NSetInterval {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        cb_val = Dereference(save_args)
        delay_addr = Add(save_args, 8)
        delay_val = Dereference(delay_addr)
        JSBridge__Push(cb_val)
        delay_ms = JSRT_ToNumber(delay_val)
        cb_val = JSBridge__Pop()

        // Register interval timer (is_interval=1)
        timer_id = JSRT_TimerAdd(cb_val, delay_ms, 1)
        ReturnValue(JSRT_CreateNumber(timer_id))
    }
}

// =============================================================================
// NATIVE: clearTimeout / clearInterval — remove timer by ID
// args[0] = timer ID number
// =============================================================================
Function.JSBridge__NClearTimeout {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        id_val = Dereference(save_args)
        timer_id = JSRT_ToNumber(id_val)
        JSRT_TimerRemove(timer_id)
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// NATIVE: parseInt — string to integer
// args[0] = string value
// =============================================================================
Function.JSBridge__NParseInt {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        arg0 = Dereference(save_args)
        arg0_type = JSRT_GetType(arg0)
        IfCondition EqualTo(arg0_type, JSType.NUMBER) ThenBlock: {
            // Already a number — return identity
            ReturnValue(arg0)
        }
        IfCondition NotEqual(arg0_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        str_ptr = JSRT_GetPayload(arg0)
        IfCondition EqualTo(str_ptr, 0) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        result = StringToInt(str_ptr)
        ReturnValue(JSRT_CreateNumber(result))
    }
}

// =============================================================================
// LAYOUT METRICS — register hit pool for DOM node box lookups
// Call after Layout_Init so the bridge can find element dimensions.
// =============================================================================
Function.JSBridge_SetLayoutPool {
    Input: pool_ptr: Address
    Input: hit_count: Integer
    Output: Integer
    Body: {
        JSBridgeState.hit_pool_ptr = pool_ptr
        JSBridgeState.hit_count = hit_count
        ReturnValue(1)
    }
}

// =============================================================================
// LAYOUT METRICS — find DOM node box from hit-test pool
// Returns 1 if found, 0 if not. Writes x/y/w/h to JSBridgeState fields.
// =============================================================================
Function.JSBridge__FindNodeBox {
    Input: dom_idx: Integer
    Output: Integer
    Body: {
        save_idx = dom_idx
        // Check if layout hit pool is registered
        pool = JSBridgeState.hit_pool_ptr
        IfCondition EqualTo(pool, 0) ThenBlock: {
            JSBridgeState.box_x = 0
            JSBridgeState.box_y = 0
            JSBridgeState.box_w = 0
            JSBridgeState.box_h = 0
            ReturnValue(0)
        }
        hcount = JSBridgeState.hit_count

        hi = 0
        WhileLoop LessThan(hi, hcount) {
            off = Multiply(hi, 48)
            base = Add(pool, off)
            entry_node = Dereference(Add(base, 32))
            IfCondition EqualTo(entry_node, save_idx) ThenBlock: {
                JSBridgeState.box_x = Dereference(Add(base, 0))
                JSBridgeState.box_y = Dereference(Add(base, 8))
                JSBridgeState.box_w = Dereference(Add(base, 16))
                JSBridgeState.box_h = Dereference(Add(base, 24))
                ReturnValue(1)
            }
            hi = Add(hi, 1)
        }
        // Not found in hit pool — return 0
        JSBridgeState.box_x = 0
        JSBridgeState.box_y = 0
        JSBridgeState.box_w = 0
        JSBridgeState.box_h = 0
        ReturnValue(0)
    }
}

// =============================================================================
// EVENT LISTENER MANAGEMENT
// Listener pool entries (24 bytes each):
//   Offset 0:  dom_node (8) — DOM node index
//   Offset 8:  event_name_ptr (8) — pointer to event name string
//   Offset 16: callback_jsval (8) — JSValue pointer to callback function
// =============================================================================

// Add an event listener. Returns 1 on success, 0 on pool full.
Function.JSBridge_AddListener {
    Input: dom_node: Integer
    Input: event_name: Address
    Input: callback: Address
    Output: Integer
    Body: {
        save_node = dom_node
        save_name = event_name
        save_cb = callback
        IfCondition GreaterEqual(JSBridgeState.listener_count, JSBridgeConst.MAX_LISTENERS) ThenBlock: {
            PrintMessage("[JSBridge] listener pool full\n")
            ReturnValue(0)
        }

        idx = JSBridgeState.listener_count
        JSBridgeState.listener_count = Add(idx, 1)
        base = Add(JSBridgeState.listeners, Multiply(idx, JSBridgeConst.LISTENER_SIZE))
        StoreValue(base, save_node)
        StoreValue(Add(base, 8), save_name)
        StoreValue(Add(base, 16), save_cb)
        ReturnValue(1)
    }
}

// =============================================================================
// CREATE EVENT OBJECT — build a JS Event object with type, target, methods
// event_type = null-terminated string e.g. "click", "input"
// target_obj = JS object for the event target (element wrapper, document, window)
// Returns the Event JS object.
// =============================================================================
Function.JSBridge__CreateEvent {
    Input: event_type: Address
    Input: target_obj: Address
    Output: Address
    Body: {
        save_type = event_type
        save_target = target_obj

        evt = JSRT_CreateObject()
        JSRT__Push(evt)

        // event.type = string
        type_val = JSRT_CreateString(save_type)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "type", type_val)

        // event.target = target element
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "target", save_target)

        // event.currentTarget = target element
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "currentTarget", save_target)

        // event.bubbles = true
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "bubbles", JSRT_CreateBool(1))

        // event.cancelable = true
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "cancelable", JSRT_CreateBool(1))

        // event.defaultPrevented = false (mutable flag)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "defaultPrevented", JSRT_CreateBool(0))

        // event.isTrusted = true
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "isTrusted", JSRT_CreateBool(1))

        // event.timeStamp = 0 (no real clock yet)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "timeStamp", JSRT_CreateNumber(0))

        // event.eventPhase = 2 (AT_TARGET)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "eventPhase", JSRT_CreateNumber(2))

        // event.preventDefault = function
        evt = JSRT__Pop()
        JSRT__Push(evt)
        pd_func = JSBridge__CreateNativeFunc(JSNativeID.EVT_PREVENT_DEFAULT, "preventDefault", 0)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "preventDefault", pd_func)

        // event.stopPropagation = function
        evt = JSRT__Pop()
        JSRT__Push(evt)
        sp_func = JSBridge__CreateNativeFunc(JSNativeID.EVT_STOP_PROPAGATION, "stopPropagation", 0)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "stopPropagation", sp_func)

        // event.stopImmediatePropagation = function
        evt = JSRT__Pop()
        JSRT__Push(evt)
        si_func = JSBridge__CreateNativeFunc(JSNativeID.EVT_STOP_IMMEDIATE, "stopImmediatePropagation", 0)
        evt = JSRT__Pop()

        ReturnValue(evt)
    }
}

// =============================================================================
// FIRE EVENT — invoke all listeners matching dom_node + event_name
// Creates an Event object and calls each matching callback via JSVM.
// Returns number of callbacks invoked.
// =============================================================================
// Fire event on a single node (no bubbling) — internal helper
Function.JSBridge__FireOnNode {
    Input: dom_node: Integer
    Input: event_name: Address
    Output: Integer
    Body: {
        save_node = dom_node
        save_name = event_name
        fired = 0
        li = 0

        WhileLoop LessThan(li, JSBridgeState.listener_count) {
            base = Add(JSBridgeState.listeners, Multiply(li, JSBridgeConst.LISTENER_SIZE))
            entry_node = Dereference(base)
            IfCondition EqualTo(entry_node, save_node) ThenBlock: {
                entry_name = Dereference(Add(base, 8))
                IfCondition NotEqual(entry_name, 0) ThenBlock: {
                    JSBridge__Push(save_node)
                    JSBridge__Push(save_name)
                    JSBridge__Push(li)
                    JSBridge__Push(fired)
                    JSBridge__Push(base)
                    cmp = StringCompare(entry_name, save_name)
                    base = JSBridge__Pop()
                    fired = JSBridge__Pop()
                    li = JSBridge__Pop()
                    save_name = JSBridge__Pop()
                    save_node = JSBridge__Pop()

                    IfCondition EqualTo(cmp, 0) ThenBlock: {
                        // Match found — get callback
                        cb = Dereference(Add(base, 16))
                        cb_type = JSRT_GetType(cb)
                        IfCondition EqualTo(cb_type, JSType.FUNCTION) ThenBlock: {
                            // Create Event object for this callback
                            JSBridge__Push(save_node)
                            JSBridge__Push(save_name)
                            JSBridge__Push(li)
                            JSBridge__Push(fired)
                            JSBridge__Push(cb)
                            // Get the DOM wrapper object as target (or use undefined)
                            target_obj = JSBridge_GetWrapObj(save_node)
                            IfCondition EqualTo(target_obj, 0) ThenBlock: {
                                target_obj = JSRT_Undefined()
                            }
                            evt_obj = JSBridge__CreateEvent(save_name, target_obj)
                            cb = JSBridge__Pop()
                            fired = JSBridge__Pop()
                            li = JSBridge__Pop()
                            save_name = JSBridge__Pop()
                            save_node = JSBridge__Pop()

                            // Call callback with Event as first argument
                            // Store event obj pointer in evt_arg_buf, then call
                            JSBridge__Push(save_node)
                            JSBridge__Push(save_name)
                            JSBridge__Push(li)
                            JSBridge__Push(fired)
                            StoreValue(JSBridgeState.evt_arg_buf, evt_obj)
                            JSVM__CallFunc(cb, JSBridgeState.evt_arg_buf, 1)
                            fired = JSBridge__Pop()
                            li = JSBridge__Pop()
                            save_name = JSBridge__Pop()
                            save_node = JSBridge__Pop()

                            fired = Add(fired, 1)
                        }
                    }
                }
            }
            li = Add(li, 1)
        }
        ReturnValue(fired)
    }
}

// Fire event with DOM bubbling — fire on target, then walk up parent chain
Function.JSBridge_FireEvent {
    Input: dom_node: Integer
    Input: event_name: Address
    Output: Integer
    Body: {
        total_fired = 0

        // Phase 1: fire on target node
        target_fired = JSBridge__FireOnNode(dom_node, event_name)
        total_fired = Add(total_fired, target_fired)

        // Phase 2: bubble up the DOM tree (max 32 levels to prevent infinite loops)
        bubble_node = DOM_GetParent(dom_node)
        bubble_depth = 0
        WhileLoop And(GreaterEqual(bubble_node, 0), LessThan(bubble_depth, 32)) {
            parent_fired = JSBridge__FireOnNode(bubble_node, event_name)
            total_fired = Add(total_fired, parent_fired)
            bubble_node = DOM_GetParent(bubble_node)
            bubble_depth = Add(bubble_depth, 1)
        }

        ReturnValue(total_fired)
    }
}

// =============================================================================
// TIMER TICK — forward to JSRT_TimerTick
// Returns count of expired timers.
// =============================================================================
Function.JSBridge_TickTimers {
    Input: current_ms: Integer
    Output: Integer
    Body: {
        save_ms = current_ms
        ReturnValue(JSRT_TimerTick(save_ms))
    }
}

