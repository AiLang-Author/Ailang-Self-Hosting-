    }
}

// =============================================================================
// CREATE MATH OBJECT — delegates to JSRuntime built-in Math handlers
// Bridge registers its own handler IDs so it can intercept if needed.
// =============================================================================
Function.JSBridge__CreateMathObj {
    Output: Address
    Body: {
        mo = JSRT_CreateObject()

        // ─── Math.abs ───
        JSBridge__Push(mo)
        abs_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_ABS, "Math.abs", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "abs", abs_func)

        // ─── Math.max ───
        JSBridge__Push(mo)
        max_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_MAX, "Math.max", 2)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "max", max_func)

        // ─── Math.min ───
        JSBridge__Push(mo)
        min_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_MIN, "Math.min", 2)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "min", min_func)

        // ─── Math.floor ───
        JSBridge__Push(mo)
        flr_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_FLOOR, "Math.floor", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "floor", flr_func)

        // ─── Math.ceil ───
        JSBridge__Push(mo)
        ceil_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_CEIL, "Math.ceil", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "ceil", ceil_func)

        // ─── Math.round ───
        JSBridge__Push(mo)
        rnd_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_ROUND, "Math.round", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "round", rnd_func)

        // ─── Math.pow ───
        JSBridge__Push(mo)
        pow_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_POW, "Math.pow", 2)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "pow", pow_func)

        // ─── Math.sqrt ───
        JSBridge__Push(mo)
        sqrt_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_SQRT, "Math.sqrt", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "sqrt", sqrt_func)

        // ─── Math.sin ───
        JSBridge__Push(mo)
        sin_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_SIN, "Math.sin", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "sin", sin_func)

        // ─── Math.cos ───
        JSBridge__Push(mo)
        cos_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_COS, "Math.cos", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "cos", cos_func)

        // ─── Math.tan ───
        JSBridge__Push(mo)
        tan_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_TAN, "Math.tan", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "tan", tan_func)

        // ─── Math.log ───
        JSBridge__Push(mo)
        log_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_LOG, "Math.log", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "log", log_func)

        // ─── Math.exp ───
        JSBridge__Push(mo)
        exp_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_EXP, "Math.exp", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "exp", exp_func)

        // ─── Math.random ───
        JSBridge__Push(mo)
        rnd2_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_RANDOM, "Math.random", 0)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "random", rnd2_func)

        // ─── Math.atan2 ───
        JSBridge__Push(mo)
        at2_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_ATAN2, "Math.atan2", 2)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "atan2", at2_func)

        // ─── Constants ───
        // M128e6t: ES Math constants are {[[Writable]]:false,[[Enumerable]]:false,
        // [[Configurable]]:false} — attr bits 0.
        JSRT_ObjSet(mo, "PI", JSRT_CreateFloat(4614256656552045848))
        JSBridge__SetAttrBits(mo, "PI", 0)
        JSRT_ObjSet(mo, "E", JSRT_CreateFloat(4613303445314885481))
        JSBridge__SetAttrBits(mo, "E", 0)
        JSRT_ObjSet(mo, "LN2", JSRT_CreateFloat(4604418534313441775))
        JSBridge__SetAttrBits(mo, "LN2", 0)
        JSRT_ObjSet(mo, "LN10", JSRT_CreateFloat(4608117551243398251))
        JSBridge__SetAttrBits(mo, "LN10", 0)
        JSRT_ObjSet(mo, "LOG2E", JSRT_CreateFloat(4609176140021203710))
        JSBridge__SetAttrBits(mo, "LOG2E", 0)
        JSRT_ObjSet(mo, "LOG10E", JSRT_CreateFloat(4599094494223104511))
        JSBridge__SetAttrBits(mo, "LOG10E", 0)
        JSRT_ObjSet(mo, "SQRT2", JSRT_CreateFloat(4609047870845172685))
        JSBridge__SetAttrBits(mo, "SQRT2", 0)
        JSRT_ObjSet(mo, "SQRT1_2", JSRT_CreateFloat(4604544271217802189))
        JSBridge__SetAttrBits(mo, "SQRT1_2", 0)

        ReturnValue(mo)
    }
}

