// =============================================================================
// PROPERTY ATTRIBUTES (Wave 2)
// Stored as number on key "__a_<name>": bit0=writable, bit1=enumerable,
// bit2=configurable. Default for ordinary data props = 7 (all true).
// Object-level: "__frozen__", "__sealed__", "__extensible__" (0/1).
// =============================================================================
FixedPool.JSAttr {
    "W": Initialize=1
    "E": Initialize=2
    "C": Initialize=4
    "DEFAULT": Initialize=7
}

// Build stable attr key "__a_" + name into str_slab. Returns key ptr.
Function.JSBridge__MakeAttrKey {
    Input: name_ptr: Address
    Output: Address
    Body: {
        save_n = name_ptr
        IfCondition EqualTo(save_n, 0) ThenBlock: { ReturnValue(0) }
        // M31d: UTF-16-aware — attr keys are C strings of Latin-1 units
        nlen = JSRT_StrLen(save_n)
        klen = Add(5, nlen)
        k = JSRT__StrSlabAlloc(Add(klen, 1))
        IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(0) }
        SetByte(k, 0, 95)
        SetByte(k, 1, 95)
        SetByte(k, 2, 97)
        SetByte(k, 3, 95)
        gi = 0
        WhileLoop LessThan(gi, nlen) {
            u = JSRT_StrUnit(save_n, gi)
            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
            SetByte(k, Add(4, gi), u)
            gi = Add(gi, 1)
        }
        SetByte(k, Add(4, nlen), 0)
        ReturnValue(k)
    }
}

// Get attribute bits for prop; default 7 if unset. Internal __ keys → 0 enum.
Function.JSBridge__GetAttrBits {
    Input: obj: Address
    Input: name_ptr: Address
    Output: Integer
    Body: {
        save_o = obj
        save_n = name_ptr
        IfCondition EqualTo(save_o, 0) ThenBlock: { ReturnValue(JSAttr.DEFAULT) }
        IfCondition EqualTo(save_n, 0) ThenBlock: { ReturnValue(JSAttr.DEFAULT) }
        // Engine-internal mangled keys only — NOT all "__*" names.
        // User props may start with __ (test262 11.13.1-4-1 __ES3_1_...).
        // Match __a_ / __get_ / __set_ / __proto__ / __class__ / __ctor__ / __dom_ / __regex_ / __field_ / __sl_ / __cb__ / __ck__ / __lex_
        IfCondition EqualTo(JSRT_StrUnit(save_n, 0), 95) ThenBlock: {
            IfCondition EqualTo(JSRT_StrUnit(save_n, 1), 95) ThenBlock: {
                u2 = JSRT_StrUnit(save_n, 2)
                u3 = JSRT_StrUnit(save_n, 3)
                is_int = 0
                // __a_ attrs
                IfCondition And(EqualTo(u2, 97), EqualTo(u3, 95)) ThenBlock: { is_int = 1 }
                // __get_ / __set_
                IfCondition And(EqualTo(u2, 103), EqualTo(u3, 101)) ThenBlock: { is_int = 1 }
                IfCondition And(EqualTo(u2, 115), EqualTo(u3, 101)) ThenBlock: { is_int = 1 }
                // __proto__ / __class__ / __ctor__ / __cb__ / __ck__
                IfCondition And(EqualTo(u2, 112), EqualTo(u3, 114)) ThenBlock: { is_int = 1 }
                IfCondition And(EqualTo(u2, 99), EqualTo(u3, 108)) ThenBlock: { is_int = 1 }
                IfCondition And(EqualTo(u2, 99), EqualTo(u3, 116)) ThenBlock: { is_int = 1 }
                IfCondition And(EqualTo(u2, 99), EqualTo(u3, 98)) ThenBlock: { is_int = 1 }
                IfCondition And(EqualTo(u2, 99), EqualTo(u3, 107)) ThenBlock: { is_int = 1 }
                // __dom_ / __regex_ / __field_ / __sl_ / __lex_ / __pend_
                IfCondition And(EqualTo(u2, 100), EqualTo(u3, 111)) ThenBlock: { is_int = 1 }
                IfCondition And(EqualTo(u2, 114), EqualTo(u3, 101)) ThenBlock: { is_int = 1 }
                IfCondition And(EqualTo(u2, 102), EqualTo(u3, 105)) ThenBlock: { is_int = 1 }
                IfCondition And(EqualTo(u2, 115), EqualTo(u3, 108)) ThenBlock: { is_int = 1 }
                IfCondition And(EqualTo(u2, 108), EqualTo(u3, 101)) ThenBlock: { is_int = 1 }
                IfCondition And(EqualTo(u2, 112), EqualTo(u3, 101)) ThenBlock: { is_int = 1 }
                IfCondition EqualTo(is_int, 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        JSBridge__Push(save_o)
        ak = JSBridge__MakeAttrKey(save_n)
        save_o = JSBridge__Pop()
        IfCondition EqualTo(ak, 0) ThenBlock: { ReturnValue(JSAttr.DEFAULT) }
        JSBridge__Push(save_o)
        av = JSRT_ObjGet(save_o, ak)
        save_o = JSBridge__Pop()
        at = JSRT_GetType(av)
        IfCondition NotEqual(at, JSType.NUMBER) ThenBlock: {
            // M39: Array exotic length — W, !E, !C (bits=1) when no side attrs
            IfCondition EqualTo(JSRT_GetType(save_o), JSType.ARRAY) ThenBlock: {
                IfCondition EqualTo(JSRT_StrEq(save_n, "length"), 1) ThenBlock: {
                    ReturnValue(JSAttr.W)
                }
            }
            // Function name/length: !W !E C (bits=4) — name handled elsewhere
            IfCondition EqualTo(JSRT_GetType(save_o), JSType.FUNCTION) ThenBlock: {
                IfCondition EqualTo(JSRT_StrEq(save_n, "length"), 1) ThenBlock: {
                    ReturnValue(JSAttr.C)
                }
                IfCondition EqualTo(JSRT_StrEq(save_n, "name"), 1) ThenBlock: {
                    ReturnValue(JSAttr.C)
                }
                // class .prototype attrs stamped !W!E!C after MakeConstructor SET_PROP
                // (see JSVM SET_PROP); gOPD uses special-case path, not GetAttrBits.
            }
            // M26i: "constructor" on prototypes — W|!E|C. Class static ['constructor']
            // fields are CreateDataProperty (W|E|C) — only apply when target is OBJECT
            // (prototype objects). Stored attr bits above take precedence.
            IfCondition EqualTo(JSRT_StrEq(save_n, "constructor"), 1) ThenBlock: {
                IfCondition EqualTo(JSRT_GetType(save_o), JSType.OBJECT) ThenBlock: {
                    ReturnValue(5)
                }
            }
            // M26i: function-valued props default non-enumerable (class methods)
            JSBridge__Push(save_o)
            JSBridge__Push(save_n)
            pv = JSRT_ObjGet(save_o, save_n)
            save_n = JSBridge__Pop()
            save_o = JSBridge__Pop()
            IfCondition EqualTo(JSRT_GetType(pv), JSType.FUNCTION) ThenBlock: {
                // W|C = 5 (writable, non-enumerable, configurable)
                ReturnValue(5)
            }
            ReturnValue(JSAttr.DEFAULT)
        }
        ReturnValue(Float_ToInt(JSRT_GetPayload(av)))
    }
}

Function.JSBridge__SetAttrBits {
    Input: obj: Address
    Input: name_ptr: Address
    Input: bits: Integer
    Output: Integer
    Body: {
        save_o = obj
        save_n = name_ptr
        save_b = bits
        JSBridge__Push(save_o)
        JSBridge__Push(save_b)
        ak = JSBridge__MakeAttrKey(save_n)
        save_b = JSBridge__Pop()
        save_o = JSBridge__Pop()
        IfCondition EqualTo(ak, 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_o)
        bv = JSRT_CreateNumber(save_b)
        save_o = JSBridge__Pop()
        JSRT_ObjSet(save_o, ak, bv)
        ReturnValue(1)
    }
}

// 1 if assignment to obj[prop] is allowed (non-strict silent-fail otherwise)
Function.JSBridge_CanAssign {
    Input: obj: Address
    Input: prop: Address
    Output: Integer
    Body: {
        save_o = obj
        save_p = prop
        IfCondition EqualTo(save_o, 0) ThenBlock: { ReturnValue(0) }
        ot = JSRT_GetType(save_o)
        // Only object-likes participate in freeze/seal/extensible
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: { ReturnValue(1) }
        }

        // Frozen?
        JSBridge__Push(save_o)
        JSBridge__Push(save_p)
        fr = JSRT_ObjGet(save_o, "__frozen__")
        save_p = JSBridge__Pop()
        save_o = JSBridge__Pop()
        IfCondition EqualTo(JSRT_IsTruthy(fr), 1) ThenBlock: {
            ReturnValue(0)
        }

        // Existing property?
        JSBridge__Push(save_o)
        JSBridge__Push(save_p)
        has = JSRT_ObjHas(save_o, save_p)
        save_p = JSBridge__Pop()
        save_o = JSBridge__Pop()

        IfCondition EqualTo(has, 0) ThenBlock: {
            // M128e6w: walk [[Prototype]] — non-writable inherited data → fail
            // (8.14.4: o.bar=x when bar non-writable on prototype must not create own)
            walk = save_o
            hops_ca = 0
            WhileLoop And(NotEqual(walk, 0), LessThan(hops_ca, 64)) {
                JSBridge__Push(save_o)
                JSBridge__Push(save_p)
                JSBridge__Push(walk)
                proto = JSRT_ObjGet(walk, "__proto__")
                walk = JSBridge__Pop()
                save_p = JSBridge__Pop()
                save_o = JSBridge__Pop()
                pt = JSRT_GetType(proto)
                IfCondition And(NotEqual(pt, JSType.OBJECT), And(NotEqual(pt, JSType.FUNCTION), NotEqual(pt, JSType.ARRAY))) ThenBlock: {
                    hops_ca = 64
                }
                IfCondition LessThan(hops_ca, 64) ThenBlock: {
                    JSBridge__Push(save_o)
                    JSBridge__Push(save_p)
                    JSBridge__Push(proto)
                    ph = JSRT_ObjHas(proto, save_p)
                    proto = JSBridge__Pop()
                    save_p = JSBridge__Pop()
                    save_o = JSBridge__Pop()
                    IfCondition EqualTo(ph, 1) ThenBlock: {
                        // Inherited data non-writable → cannot assign / create own
                        bits_p = JSBridge__GetAttrBits(proto, save_p)
                        IfCondition EqualTo(BitwiseAnd(bits_p, JSAttr.W), 0) ThenBlock: {
                            ReturnValue(0)
                        }
                        // Inherited writable data — create own (shadow) allowed if extensible
                        hops_ca = 64
                    }
                    IfCondition EqualTo(ph, 0) ThenBlock: {
                        walk = proto
                    }
                }
                hops_ca = Add(hops_ca, 1)
            }
            // New property — check extensible (default yes unless sealed/frozen)
            JSBridge__Push(save_o)
            ex = JSRT_ObjGet(save_o, "__extensible__")
            save_o = JSBridge__Pop()
            et = JSRT_GetType(ex)
            IfCondition EqualTo(et, JSType.BOOLEAN) ThenBlock: {
                IfCondition EqualTo(JSRT_IsTruthy(ex), 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
            // Also sealed objects are non-extensible
            JSBridge__Push(save_o)
            se = JSRT_ObjGet(save_o, "__sealed__")
            save_o = JSBridge__Pop()
            IfCondition EqualTo(JSRT_IsTruthy(se), 1) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }

        // Existing — check writable bit
        bits = JSBridge__GetAttrBits(save_o, save_p)
        IfCondition EqualTo(BitwiseAnd(bits, JSAttr.W), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// NATIVE IMPLEMENTATIONS: Object.* methods
// =============================================================================

// Object.defineProperties(obj, props) — define each own enumerable? key of props
// ES: for each own property name/symbol of props, defineProperty(O, P, props[P])
Function.JSBridge__NDefineProperties {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 2) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(args)
        props = Dereference(Add(args, 8))
        // ToObject target — null/undefined/primitive → TypeError
        tt = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.defineProperties called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition And(NotEqual(tt, JSType.OBJECT), NotEqual(tt, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(tt, JSType.ARRAY) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Object.defineProperties called on non-object")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
        }
        pt = JSRT_GetType(props)
        IfCondition Or(EqualTo(pt, JSType.NULL), EqualTo(pt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // ES: [[OwnPropertyKeys]] — include non-enumerable (not Object.keys)
        JSBridge__Push(target)
        JSBridge__Push(props)
        abn = JSVMCallBuf.buf
        StoreValue(abn, props)
        keys = JSBridge__NGetOwnPropNames(abn, 1)
        props = JSBridge__Pop()
        target = JSBridge__Pop()
        klen = JSRT_ArrLen(keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            JSBridge__Push(target)
            JSBridge__Push(props)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            ksv = JSRT_ArrGet(keys, ki)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            props = JSBridge__Pop()
            target = JSBridge__Pop()
            kp = JSRT_GetPayload(ksv)
            // Skip engine-internal __* keys
            skip_k = 0
            IfCondition NotEqual(kp, 0) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(kp, 0), 95) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(kp, 1), 95) ThenBlock: {
                        skip_k = 1
                    }
                }
            }
            // M39: ES only defines enumerable own props (skip length etc.)
            IfCondition EqualTo(skip_k, 0) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(props)
                JSBridge__Push(keys)
                JSBridge__Push(ki)
                JSBridge__Push(ksv)
                abits = JSBridge__GetAttrBits(props, kp)
                ksv = JSBridge__Pop()
                ki = JSBridge__Pop()
                keys = JSBridge__Pop()
                props = JSBridge__Pop()
                target = JSBridge__Pop()
                IfCondition EqualTo(BitwiseAnd(abits, JSAttr.E), 0) ThenBlock: {
                    skip_k = 1
                }
            }
            IfCondition EqualTo(skip_k, 0) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(props)
                JSBridge__Push(keys)
                JSBridge__Push(ki)
                // M27b: OrdinaryGet so accessor Properties fields are invoked
                dval = JSBridge__DescFieldGet(props, kp)
                ki = JSBridge__Pop()
                keys = JSBridge__Pop()
                props = JSBridge__Pop()
                target = JSBridge__Pop()
                // Build arg buf: target, key string val, descriptor
                ab = JSVMCallBuf.buf
                StoreValue(ab, target)
                StoreValue(Add(ab, 8), ksv)
                StoreValue(Add(ab, 16), dval)
                JSBridge__Push(target)
                JSBridge__Push(props)
                JSBridge__Push(keys)
                JSBridge__Push(ki)
                JSBridge__NDefineProperty(ab, 3)
                // propagate throw
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                ki = JSBridge__Pop()
                keys = JSBridge__Pop()
                props = JSBridge__Pop()
                target = JSBridge__Pop()
            }
            ki = Add(ki, 1)
        }
        ReturnValue(target)
    }
}

// M39: build "__get_" / "__set_" + field into slab (C or UTF-16 field via StrUnit)
// kind: 0 = get, 1 = set. Matches defineProperty's accessor key layout.
Function.JSBridge__MakeAccKey {
    Input: field: Address
    Input: kind: Integer
    Output: Address
    Body: {
        save_f = field
        save_k = kind
        IfCondition EqualTo(save_f, 0) ThenBlock: { ReturnValue(0) }
        flen = JSRT_StrLen(save_f)
        buf = JSRT__StrSlabAlloc(Add(flen, 8))
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        SetByte(buf, 0, 95)
        SetByte(buf, 1, 95)
        IfCondition EqualTo(save_k, 0) ThenBlock: {
            SetByte(buf, 2, 103)
            SetByte(buf, 3, 101)
            SetByte(buf, 4, 116)
        } ElseBlock: {
            SetByte(buf, 2, 115)
            SetByte(buf, 3, 101)
            SetByte(buf, 4, 116)
        }
        SetByte(buf, 5, 95)
        gi = 0
        WhileLoop LessThan(gi, flen) {
            u = JSRT_StrUnit(save_f, gi)
            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
            SetByte(buf, Add(6, gi), u)
            gi = Add(gi, 1)
        }
        SetByte(buf, Add(6, flen), 0)
        ReturnValue(buf)
    }
}

// M27a: HasProperty on descriptor fields — own OR inherited data/accessor
// (ToPropertyDescriptor uses [[HasProperty]], not [[HasOwnProperty]])
Function.JSBridge__DescFieldHas {
    Input: desc: Address
    Input: field: Address
    Output: Integer
    Body: {
        save_d = desc
        save_f = field
        IfCondition EqualTo(save_d, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(save_f, 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_d)
        JSBridge__Push(save_f)
        // Data property on self or prototype chain
        IfCondition NotEqual(JSRT_ObjHasOnChain(save_d, save_f), 0) ThenBlock: {
            save_f = JSBridge__Pop()
            save_d = JSBridge__Pop()
            ReturnValue(1)
        }
        save_f = JSBridge__Pop()
        save_d = JSBridge__Pop()
        // __get_<field> on chain
        JSBridge__Push(save_d)
        JSBridge__Push(save_f)
        gk = JSBridge__MakeAccKey(save_f, 0)
        save_f = JSBridge__Pop()
        save_d = JSBridge__Pop()
        IfCondition EqualTo(gk, 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_d)
        JSBridge__Push(save_f)
        IfCondition NotEqual(JSRT_ObjHasOnChain(save_d, gk), 0) ThenBlock: {
            save_f = JSBridge__Pop()
            save_d = JSBridge__Pop()
            ReturnValue(1)
        }
        save_f = JSBridge__Pop()
        save_d = JSBridge__Pop()
        // __set_<field> on chain
        JSBridge__Push(save_d)
        sk = JSBridge__MakeAccKey(save_f, 1)
        save_d = JSBridge__Pop()
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_d)
        IfCondition NotEqual(JSRT_ObjHasOnChain(save_d, sk), 0) ThenBlock: {
            save_d = JSBridge__Pop()
            ReturnValue(1)
        }
        save_d = JSBridge__Pop()
        ReturnValue(0)
    }
}

// M27a: [[Get]] on descriptor field — OrdinaryGet order:
// own data → own getter → own setter-only → [[Prototype]]
// Receiver `this` for getters is always the original Attributes object.
Function.JSBridge__DescFieldGet {
    Input: desc: Address
    Input: field: Address
    Output: Address
    Body: {
        save_d = desc
        save_f = field
        IfCondition EqualTo(save_d, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        IfCondition EqualTo(save_f, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        recv = save_d
        cur = save_d
        // Walk prototype chain
        // M37: check own accessor BEFORE data — defineProperty leaves undefined
        // data placeholder for accessors; data-first wrongly hid getter results.
        // M39: accessor keys via MakeAccKey (UTF-16 field names from gOPN)
        hops = 0
        WhileLoop And(NotEqual(cur, 0), LessThan(hops, 64)) {
            hops = Add(hops, 1)
            // 1) Own accessor getter __get_field?
            JSBridge__Push(recv)
            JSBridge__Push(save_f)
            JSBridge__Push(cur)
            gk = JSBridge__MakeAccKey(save_f, 0)
            cur = JSBridge__Pop()
            save_f = JSBridge__Pop()
            recv = JSBridge__Pop()
            IfCondition NotEqual(gk, 0) ThenBlock: {
                JSBridge__Push(recv)
                JSBridge__Push(save_f)
                JSBridge__Push(cur)
                own_g = JSRT_ObjHas(cur, gk)
                cur = JSBridge__Pop()
                save_f = JSBridge__Pop()
                recv = JSBridge__Pop()
                IfCondition EqualTo(own_g, 1) ThenBlock: {
                    JSBridge__Push(recv)
                    JSBridge__Push(save_f)
                    JSBridge__Push(cur)
                    gfn = JSRT_ObjGet(cur, gk)
                    cur = JSBridge__Pop()
                    save_f = JSBridge__Pop()
                    recv = JSBridge__Pop()
                    IfCondition EqualTo(JSRT_GetType(gfn), JSType.FUNCTION) ThenBlock: {
                        save_this = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", recv)
                        empty_b = JSVMCallBuf.buf
                        gres = JSVM__CallFunc(gfn, empty_b, 0)
                        JSVM__SetGlobal("this", save_this)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(JSRT_Undefined())
                        }
                        ReturnValue(gres)
                    }
                    // getter present but not callable / undefined
                    ReturnValue(JSRT_Undefined())
                }
                // 2) Own setter-only → undefined (do not return data placeholder)
                JSBridge__Push(recv)
                JSBridge__Push(save_f)
                JSBridge__Push(cur)
                sk = JSBridge__MakeAccKey(save_f, 1)
                cur = JSBridge__Pop()
                save_f = JSBridge__Pop()
                recv = JSBridge__Pop()
                IfCondition NotEqual(sk, 0) ThenBlock: {
                    JSBridge__Push(recv)
                    JSBridge__Push(save_f)
                    JSBridge__Push(cur)
                    own_s = JSRT_ObjHas(cur, sk)
                    cur = JSBridge__Pop()
                    save_f = JSBridge__Pop()
                    recv = JSBridge__Pop()
                    IfCondition EqualTo(own_s, 1) ThenBlock: {
                        ReturnValue(JSRT_Undefined())
                    }
                }
            }
            // 3) Own data property (true data, not accessor placeholder)
            JSBridge__Push(recv)
            JSBridge__Push(save_f)
            JSBridge__Push(cur)
            own_data = JSRT_ObjHas(cur, save_f)
            cur = JSBridge__Pop()
            save_f = JSBridge__Pop()
            recv = JSBridge__Pop()
            IfCondition EqualTo(own_data, 1) ThenBlock: {
                JSBridge__Push(recv)
                JSBridge__Push(save_f)
                val = JSRT_ObjGet(cur, save_f)
                save_f = JSBridge__Pop()
                recv = JSBridge__Pop()
                ReturnValue(val)
            }
            // 4) Climb [[Prototype]]
            JSBridge__Push(recv)
            JSBridge__Push(save_f)
            proto = JSRT_ObjGet(cur, "__proto__")
            save_f = JSBridge__Pop()
            recv = JSBridge__Pop()
            pt = JSRT_GetType(proto)
            IfCondition And(NotEqual(pt, JSType.OBJECT), NotEqual(pt, JSType.FUNCTION)) ThenBlock: {
                // also ARRAY rare
                IfCondition NotEqual(pt, JSType.ARRAY) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
            }
            cur = proto
        }
        ReturnValue(JSRT_Undefined())
    }
}

// Object.defineProperty(obj, prop, descriptor)
// descriptor can have: value, writable, enumerable, configurable, get, set
Function.JSBridge__NDefineProperty {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 3) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Extract arguments: obj, prop_name_val, descriptor
        target = Dereference(save_args)
        name_val = Dereference(Add(save_args, 8))
        desc_val = Dereference(Add(save_args, 16))

        // ES Object.defineProperty: ToObject(O) — null/undefined/primitive → TypeError
        tt_dp = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt_dp, JSType.NULL), EqualTo(tt_dp, JSType.UNDEFINED)) ThenBlock: {
            terr_dp = JSVM_CreateTypedError("TypeError", "Object.defineProperty called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr_dp)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr_dp
            JSVM_ThrowValue(terr_dp)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition And(NotEqual(tt_dp, JSType.OBJECT), NotEqual(tt_dp, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(tt_dp, JSType.ARRAY) ThenBlock: {
                terr_dp = JSVM_CreateTypedError("TypeError", "Object.defineProperty called on non-object")
                JSVM__SetGlobal("__pend_exc__", terr_dp)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_dp
                JSVM_ThrowValue(terr_dp)
                ReturnValue(JSRT_Undefined())
            }
        }
        // Descriptor must be an object (ES: arrays, functions, boxed primitives as Objects)
        // M33: ARRAY is a distinct JSType but is an Object in the language
        dt_dp = JSRT_GetType(desc_val)
        IfCondition And(NotEqual(dt_dp, JSType.OBJECT), NotEqual(dt_dp, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(dt_dp, JSType.ARRAY) ThenBlock: {
                terr_dp = JSVM_CreateTypedError("TypeError", "Property description must be an object")
                JSVM__SetGlobal("__pend_exc__", terr_dp)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_dp
                JSVM_ThrowValue(terr_dp)
                ReturnValue(JSRT_Undefined())
            }
        }

        // Mole 16: ToPropertyKey (Symbol → @@sN, else string)
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        name_ptr = JSVM_ToPropertyKey(name_val)
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()

        // M128e6ai: Proxy [[DefineOwnProperty]] trap
        IfCondition EqualTo(JSVM__IsProxy(target), 1) ThenBlock: {
            hnd_dp = JSRT_ObjGet(target, "__p_h__")
            tgt_dp = JSRT_ObjGet(target, "__p_t__")
            trap_dp = JSRT_ObjGet(hnd_dp, "defineProperty")
            IfCondition EqualTo(JSRT_GetType(trap_dp), JSType.FUNCTION) ThenBlock: {
                kv_dp = JSRT__AllocValue()
                StoreValue(kv_dp, JSType.STRING)
                StoreValue(Add(kv_dp, 8), name_ptr)
                ab_dp = JSVMCallBuf.buf
                StoreValue(ab_dp, tgt_dp)
                StoreValue(Add(ab_dp, 8), kv_dp)
                StoreValue(Add(ab_dp, 16), desc_val)
                save_this_dp = JSVM__GetGlobal("this")
                JSVM__SetGlobal("this", hnd_dp)
                res_dp = JSVM__CallFunc(trap_dp, ab_dp, 3)
                JSVM__SetGlobal("this", save_this_dp)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                // Return target object (Object.defineProperty return value)
                ReturnValue(target)
            }
            // No trap — define on target
            target = tgt_dp
        }

        // Mole 12: track defineProperty fields for mapped arguments
        is_accessor = 0
        has_value = 0
        value_val = JSRT_Undefined()
        writable_false = 0
        has_writable_key = 0

        // Pre-scan: mixed data + accessor is a TypeError (ToPropertyDescriptor)
        // M27a: use DescFieldHas so accessor-defined fields on the Attributes object count
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        has_acc_pre = 0
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "get"), 0) ThenBlock: { has_acc_pre = 1 }
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "set"), 0) ThenBlock: { has_acc_pre = 1 }
        has_data_pre = 0
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "value"), 0) ThenBlock: { has_data_pre = 1 }
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "writable"), 0) ThenBlock: { has_data_pre = 1 }
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition And(EqualTo(has_acc_pre, 1), EqualTo(has_data_pre, 1)) ThenBlock: {
            terr_dp = JSVM_CreateTypedError("TypeError", "Invalid property descriptor")
            JSVM__SetGlobal("__pend_exc__", terr_dp)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr_dp
            JSVM_ThrowValue(terr_dp)
            ReturnValue(JSRT_Undefined())
        }

        // get/set must be undefined or callable (8.10.5)
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "get"), 0) ThenBlock: {
            g_chk = JSBridge__DescFieldGet(desc_val, "get")
            gt_chk = JSRT_GetType(g_chk)
            IfCondition And(NotEqual(gt_chk, JSType.UNDEFINED), NotEqual(gt_chk, JSType.FUNCTION)) ThenBlock: {
                name_ptr = JSBridge__Pop()
                desc_val = JSBridge__Pop()
                target = JSBridge__Pop()
                terr_dp = JSVM_CreateTypedError("TypeError", "Getter must be a function")
                JSVM__SetGlobal("__pend_exc__", terr_dp)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_dp
                JSVM_ThrowValue(terr_dp)
                ReturnValue(JSRT_Undefined())
            }
        }
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "set"), 0) ThenBlock: {
            s_chk = JSBridge__DescFieldGet(desc_val, "set")
            st_chk = JSRT_GetType(s_chk)
            IfCondition And(NotEqual(st_chk, JSType.UNDEFINED), NotEqual(st_chk, JSType.FUNCTION)) ThenBlock: {
                name_ptr = JSBridge__Pop()
                desc_val = JSBridge__Pop()
                target = JSBridge__Pop()
                terr_dp = JSVM_CreateTypedError("TypeError", "Setter must be a function")
                JSVM__SetGlobal("__pend_exc__", terr_dp)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_dp
                JSVM_ThrowValue(terr_dp)
                ReturnValue(JSRT_Undefined())
            }
        }
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()

        // New property on non-extensible object
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        exist0 = JSRT_ObjHas(target, name_ptr)
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(exist0, 0) ThenBlock: {
            JSBridge__Push(target)
            JSBridge__Push(desc_val)
            JSBridge__Push(name_ptr)
            can_new = JSBridge_CanAssign(target, name_ptr)
            name_ptr = JSBridge__Pop()
            desc_val = JSBridge__Pop()
            target = JSBridge__Pop()
            IfCondition EqualTo(can_new, 0) ThenBlock: {
                terr_dp = JSVM_CreateTypedError("TypeError", "Cannot define property: object is not extensible")
                JSVM__SetGlobal("__pend_exc__", terr_dp)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_dp
                JSVM_ThrowValue(terr_dp)
                ReturnValue(JSRT_Undefined())
            }
        }

        // Check for getter (desc.get) — M27a: DescFieldGet invokes Attributes getters
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        has_get_f = JSBridge__DescFieldHas(desc_val, "get")
        getter = JSBridge__DescFieldGet(desc_val, "get")
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(has_get_f, 1) ThenBlock: { is_accessor = 1 }

        gt = JSRT_GetType(getter)
        IfCondition EqualTo(gt, JSType.FUNCTION) ThenBlock: {
            // Store getter as __get_<prop> with STABLE C-key (Latin-1 units of name)
            // M31d: name_ptr may be UTF-16
            nlen = JSRT_StrLen(name_ptr)
            gk_len = Add(7, nlen)
            gbuf = JSRT__StrSlabAlloc(gk_len)
            IfCondition NotEqual(gbuf, 0) ThenBlock: {
                SetByte(gbuf, 0, 95)
                SetByte(gbuf, 1, 95)
                SetByte(gbuf, 2, 103)
                SetByte(gbuf, 3, 101)
                SetByte(gbuf, 4, 116)
                SetByte(gbuf, 5, 95)
                gi = 0
                WhileLoop LessThan(gi, nlen) {
                    u = JSRT_StrUnit(name_ptr, gi)
                    IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                    SetByte(gbuf, Add(6, gi), u)
                    gi = Add(gi, 1)
                }
                SetByte(gbuf, Add(6, nlen), 0)
                JSBridge__Push(target)
                JSBridge__Push(desc_val)
                JSBridge__Push(name_ptr)
                JSRT_ObjSet(target, gbuf, getter)
                name_ptr = JSBridge__Pop()
                desc_val = JSBridge__Pop()
                target = JSBridge__Pop()
            }
        }

        // Check for setter (desc.set)
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        has_set_f = JSBridge__DescFieldHas(desc_val, "set")
        setter = JSBridge__DescFieldGet(desc_val, "set")
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(has_set_f, 1) ThenBlock: { is_accessor = 1 }

        st = JSRT_GetType(setter)
        IfCondition EqualTo(st, JSType.FUNCTION) ThenBlock: {
            // Store setter as __set_<prop> with STABLE C-key
            nlen = JSRT_StrLen(name_ptr)
            sk_len = Add(7, nlen)
            sbuf = JSRT__StrSlabAlloc(sk_len)
            IfCondition NotEqual(sbuf, 0) ThenBlock: {
                SetByte(sbuf, 0, 95)
                SetByte(sbuf, 1, 95)
                SetByte(sbuf, 2, 115)
                SetByte(sbuf, 3, 101)
                SetByte(sbuf, 4, 116)
                SetByte(sbuf, 5, 95)
                gi = 0
                WhileLoop LessThan(gi, nlen) {
                    u = JSRT_StrUnit(name_ptr, gi)
                    IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                    SetByte(sbuf, Add(6, gi), u)
                    gi = Add(gi, 1)
                }
                SetByte(sbuf, Add(6, nlen), 0)
                JSBridge__Push(target)
                JSBridge__Push(desc_val)
                JSBridge__Push(name_ptr)
                JSRT_ObjSet(target, sbuf, setter)
                name_ptr = JSBridge__Pop()
                desc_val = JSBridge__Pop()
                target = JSBridge__Pop()
            }
        }

        // Check for value (desc.value) — Has/Get via DescField (accessor Attributes)
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(desc_val)
        has_vkey = JSBridge__DescFieldHas(desc_val, "value")
        desc_val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(desc_val)
        JSBridge__Push(has_vkey)
        dv = JSBridge__DescFieldGet(desc_val, "value")
        has_vkey = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // M38: only record value — ObjSet AFTER redefine reject.
        // Early ObjSet made SameValue(cur, new) always true (cur already new).
        IfCondition EqualTo(has_vkey, 1) ThenBlock: {
            has_value = 1
            value_val = dv
        } ElseBlock: {
            // legacy: non-undefined value still counts as data desc
            dvt = JSRT_GetType(dv)
            IfCondition NotEqual(dvt, JSType.UNDEFINED) ThenBlock: {
                has_value = 1
                value_val = dv
            }
        }

        // Attribute bits: existing props merge; NEW props default all-false (ES 8.10.5)
        // M27b: use exist0 from BEFORE value/getter install — re-Has after ObjSet
        // wrongly treated brand-new props as existing (DEFAULT bits=7).
        bits = 0
        exist = exist0
        IfCondition EqualTo(exist, 1) ThenBlock: {
            bits = JSBridge__GetAttrBits(target, name_ptr)
        }

        // New data property with no value key → still create with undefined
        IfCondition EqualTo(exist, 0) ThenBlock: {
            IfCondition EqualTo(is_accessor, 0) ThenBlock: {
                IfCondition EqualTo(has_value, 0) ThenBlock: {
                    has_value = 1
                    value_val = JSRT_Undefined()
                    JSBridge__Push(target)
                    JSBridge__Push(name_ptr)
                    JSBridge__Push(desc_val)
                    JSBridge__Push(bits)
                    JSBridge__Push(has_value)
                    JSBridge__Push(value_val)
                    JSBridge__Push(is_accessor)
                    JSBridge__Push(writable_false)
                    JSRT_ObjSet(target, name_ptr, JSRT_Undefined())
                    writable_false = JSBridge__Pop()
                    is_accessor = JSBridge__Pop()
                    value_val = JSBridge__Pop()
                    has_value = JSBridge__Pop()
                    bits = JSBridge__Pop()
                    desc_val = JSBridge__Pop()
                    name_ptr = JSBridge__Pop()
                    target = JSBridge__Pop()
                }
            }
        }

        // M27a: attribute presence = HasProperty (not "Get !== undefined")
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(desc_val)
        JSBridge__Push(bits)
        JSBridge__Push(has_value)
        JSBridge__Push(value_val)
        JSBridge__Push(is_accessor)
        has_w = JSBridge__DescFieldHas(desc_val, "writable")
        IfCondition EqualTo(has_w, 1) ThenBlock: {
            wdesc = JSBridge__DescFieldGet(desc_val, "writable")
            IfCondition EqualTo(JSRT_IsTruthy(wdesc), 0) ThenBlock: {
                bits = BitwiseAnd(bits, BitwiseNot(JSAttr.W))
                writable_false = 1
            } ElseBlock: {
                bits = BitwiseOr(bits, JSAttr.W)
                writable_false = 0
            }
        }
        is_accessor = JSBridge__Pop()
        value_val = JSBridge__Pop()
        has_value = JSBridge__Pop()
        JSBridge__Pop()
        desc_val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(desc_val)
        JSBridge__Push(bits)
        JSBridge__Push(has_value)
        JSBridge__Push(value_val)
        JSBridge__Push(is_accessor)
        JSBridge__Push(writable_false)
        has_e = JSBridge__DescFieldHas(desc_val, "enumerable")
        IfCondition EqualTo(has_e, 1) ThenBlock: {
            edesc = JSBridge__DescFieldGet(desc_val, "enumerable")
            IfCondition EqualTo(JSRT_IsTruthy(edesc), 0) ThenBlock: {
                bits = BitwiseAnd(bits, BitwiseNot(JSAttr.E))
            } ElseBlock: {
                bits = BitwiseOr(bits, JSAttr.E)
            }
        }
        writable_false = JSBridge__Pop()
        is_accessor = JSBridge__Pop()
        value_val = JSBridge__Pop()
        has_value = JSBridge__Pop()
        JSBridge__Pop()
        desc_val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(desc_val)
        JSBridge__Push(bits)
        JSBridge__Push(has_value)
        JSBridge__Push(value_val)
        JSBridge__Push(is_accessor)
        JSBridge__Push(writable_false)
        has_c = JSBridge__DescFieldHas(desc_val, "configurable")
        IfCondition EqualTo(has_c, 1) ThenBlock: {
            cdesc = JSBridge__DescFieldGet(desc_val, "configurable")
            IfCondition EqualTo(JSRT_IsTruthy(cdesc), 0) ThenBlock: {
                bits = BitwiseAnd(bits, BitwiseNot(JSAttr.C))
            } ElseBlock: {
                bits = BitwiseOr(bits, JSAttr.C)
            }
        }
        writable_false = JSBridge__Pop()
        is_accessor = JSBridge__Pop()
        value_val = JSBridge__Pop()
        has_value = JSBridge__Pop()
        JSBridge__Pop()
        desc_val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // Mole 16 residual: reject incompatible redefinition of !configurable props
        // ES [[DefineOwnProperty]] 10.1.6.3 / 9.1.6.3
        IfCondition EqualTo(exist, 1) ThenBlock: {
            old_bits = JSBridge__GetAttrBits(target, name_ptr)
            // Detect existing accessor via __get_/__set_ keys
            nlen_dp = JSRT_StrLen(name_ptr)
            gbuf_c = JSRT__StrSlabAlloc(Add(nlen_dp, 8))
            sbuf_c = JSRT__StrSlabAlloc(Add(nlen_dp, 8))
            had_acc = 0
            IfCondition And(NotEqual(gbuf_c, 0), NotEqual(sbuf_c, 0)) ThenBlock: {
                SetByte(gbuf_c, 0, 95)
                SetByte(gbuf_c, 1, 95)
                SetByte(gbuf_c, 2, 103)
                SetByte(gbuf_c, 3, 101)
                SetByte(gbuf_c, 4, 116)
                SetByte(gbuf_c, 5, 95)
                SetByte(sbuf_c, 0, 95)
                SetByte(sbuf_c, 1, 95)
                SetByte(sbuf_c, 2, 115)
                SetByte(sbuf_c, 3, 101)
                SetByte(sbuf_c, 4, 116)
                SetByte(sbuf_c, 5, 95)
                gi = 0
                WhileLoop LessThan(gi, nlen_dp) {
                    u = JSRT_StrUnit(name_ptr, gi)
                    IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                    SetByte(gbuf_c, Add(6, gi), u)
                    SetByte(sbuf_c, Add(6, gi), u)
                    gi = Add(gi, 1)
                }
                SetByte(gbuf_c, Add(6, nlen_dp), 0)
                SetByte(sbuf_c, Add(6, nlen_dp), 0)
                IfCondition EqualTo(JSRT_GetType(JSRT_ObjGet(target, gbuf_c)), JSType.FUNCTION) ThenBlock: {
                    had_acc = 1
                }
                IfCondition EqualTo(JSRT_GetType(JSRT_ObjGet(target, sbuf_c)), JSType.FUNCTION) ThenBlock: {
                    had_acc = 1
                }
            }
            IfCondition EqualTo(BitwiseAnd(old_bits, JSAttr.C), 0) ThenBlock: {
                reject_dp = 0
                // cannot flip configurable false → true
                IfCondition NotEqual(BitwiseAnd(bits, JSAttr.C), 0) ThenBlock: {
                    IfCondition EqualTo(has_c, 1) ThenBlock: {
                        reject_dp = 1
                    }
                }
                // cannot flip enumerable
                IfCondition EqualTo(has_e, 1) ThenBlock: {
                    old_e = BitwiseAnd(old_bits, JSAttr.E)
                    new_e = BitwiseAnd(bits, JSAttr.E)
                    IfCondition NotEqual(old_e, new_e) ThenBlock: {
                        reject_dp = 1
                    }
                }
                // accessor ↔ data conversion when !C
                IfCondition EqualTo(had_acc, 1) ThenBlock: {
                    IfCondition Or(EqualTo(has_value, 1), EqualTo(has_w, 1)) ThenBlock: {
                        reject_dp = 1
                    }
                }
                IfCondition EqualTo(had_acc, 0) ThenBlock: {
                    IfCondition EqualTo(is_accessor, 1) ThenBlock: {
                        reject_dp = 1
                    }
                }
                // data: !W and !C cannot change value or writable false→true
                IfCondition EqualTo(had_acc, 0) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(old_bits, JSAttr.W), 0) ThenBlock: {
                        IfCondition EqualTo(has_w, 1) ThenBlock: {
                            IfCondition NotEqual(BitwiseAnd(bits, JSAttr.W), 0) ThenBlock: {
                                reject_dp = 1
                            }
                        }
                        IfCondition EqualTo(has_value, 1) ThenBlock: {
                            // compare new value to current
                            JSBridge__Push(target)
                            JSBridge__Push(name_ptr)
                            JSBridge__Push(desc_val)
                            JSBridge__Push(bits)
                            JSBridge__Push(value_val)
                            cur_v = JSRT_ObjGet(target, name_ptr)
                            value_val = JSBridge__Pop()
                            bits = JSBridge__Pop()
                            desc_val = JSBridge__Pop()
                            name_ptr = JSBridge__Pop()
                            target = JSBridge__Pop()
                            // SameValue — use StrictEqual number/string/bool; else reject if different ref
                            same_v = 0
                            IfCondition EqualTo(JSRT_StrictEqual(cur_v, value_val), 1) ThenBlock: {
                                same_v = 1
                            }
                            IfCondition EqualTo(same_v, 0) ThenBlock: {
                                reject_dp = 1
                            }
                        }
                    }
                }
                IfCondition EqualTo(reject_dp, 1) ThenBlock: {
                    terr_dp = JSVM_CreateTypedError("TypeError", "Cannot redefine non-configurable property")
                    JSVM__SetGlobal("__pend_exc__", terr_dp)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr_dp
                    JSVM_ThrowValue(terr_dp)
                    ReturnValue(JSRT_Undefined())
                }
            }
        }

        // M38: apply data value after reject (exist0 may still need create)
        IfCondition EqualTo(has_value, 1) ThenBlock: {
            IfCondition EqualTo(is_accessor, 0) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                JSBridge__Push(has_value)
                JSBridge__Push(value_val)
                JSBridge__Push(is_accessor)
                JSBridge__Push(writable_false)
                JSBridge__Push(bits)
                JSRT_ObjSet(target, name_ptr, value_val)
                bits = JSBridge__Pop()
                writable_false = JSBridge__Pop()
                is_accessor = JSBridge__Pop()
                value_val = JSBridge__Pop()
                has_value = JSBridge__Pop()
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
            }
        }

        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(has_value)
        JSBridge__Push(value_val)
        JSBridge__Push(is_accessor)
        JSBridge__Push(writable_false)
        JSBridge__SetAttrBits(target, name_ptr, bits)
        writable_false = JSBridge__Pop()
        is_accessor = JSBridge__Pop()
        value_val = JSBridge__Pop()
        has_value = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // Accessor: keep undefined data key so hasOwnProperty sees the property
        // (GET_PROP prefers __get_<name>, so the placeholder is never read).
        // M27a: was ObjDelete — broke hasOwn for get:undefined / set-only accessors.
        IfCondition EqualTo(is_accessor, 1) ThenBlock: {
            JSBridge__Push(target)
            JSBridge__Push(name_ptr)
            JSBridge__Push(has_value)
            JSBridge__Push(value_val)
            JSBridge__Push(writable_false)
            JSBridge__Push(is_accessor)
            JSRT_ObjSet(target, name_ptr, JSRT_Undefined())
            is_accessor = JSBridge__Pop()
            writable_false = JSBridge__Pop()
            value_val = JSBridge__Pop()
            has_value = JSBridge__Pop()
            name_ptr = JSBridge__Pop()
            target = JSBridge__Pop()
        }

        // M33: data descriptor replaces accessor — drop own __get_/__set_ keys
        // so GET_PROP/gOPD do not keep seeing the old getter after redefine.
        IfCondition EqualTo(is_accessor, 0) ThenBlock: {
            IfCondition Or(EqualTo(has_value, 1), EqualTo(has_w, 1)) ThenBlock: {
                nlen_clr = JSRT_StrLen(name_ptr)
                gbuf_clr = JSRT__StrSlabAlloc(Add(nlen_clr, 8))
                sbuf_clr = JSRT__StrSlabAlloc(Add(nlen_clr, 8))
                IfCondition And(NotEqual(gbuf_clr, 0), NotEqual(sbuf_clr, 0)) ThenBlock: {
                    SetByte(gbuf_clr, 0, 95)
                    SetByte(gbuf_clr, 1, 95)
                    SetByte(gbuf_clr, 2, 103)
                    SetByte(gbuf_clr, 3, 101)
                    SetByte(gbuf_clr, 4, 116)
                    SetByte(gbuf_clr, 5, 95)
                    SetByte(sbuf_clr, 0, 95)
                    SetByte(sbuf_clr, 1, 95)
                    SetByte(sbuf_clr, 2, 115)
                    SetByte(sbuf_clr, 3, 101)
                    SetByte(sbuf_clr, 4, 116)
                    SetByte(sbuf_clr, 5, 95)
                    gi = 0
                    WhileLoop LessThan(gi, nlen_clr) {
                        u = JSRT_StrUnit(name_ptr, gi)
                        IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                        SetByte(gbuf_clr, Add(6, gi), u)
                        SetByte(sbuf_clr, Add(6, gi), u)
                        gi = Add(gi, 1)
                    }
                    SetByte(gbuf_clr, Add(6, nlen_clr), 0)
                    SetByte(sbuf_clr, Add(6, nlen_clr), 0)
                    JSBridge__Push(target)
                    JSBridge__Push(name_ptr)
                    JSBridge__Push(sbuf_clr)
                    IfCondition EqualTo(JSRT_ObjHas(target, gbuf_clr), 1) ThenBlock: {
                        JSRT_ObjDelete(target, gbuf_clr)
                    }
                    sbuf_clr = JSBridge__Pop()
                    name_ptr = JSBridge__Pop()
                    target = JSBridge__Pop()
                    JSBridge__Push(target)
                    JSBridge__Push(name_ptr)
                    IfCondition EqualTo(JSRT_ObjHas(target, sbuf_clr), 1) ThenBlock: {
                        JSRT_ObjDelete(target, sbuf_clr)
                    }
                    name_ptr = JSBridge__Pop()
                    target = JSBridge__Pop()
                }
            }
        }

        // Mole 12: mapped arguments — value sync + unmap on !writable / accessor
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(has_value)
        JSBridge__Push(value_val)
        JSBridge__Push(writable_false)
        JSBridge__Push(is_accessor)
        acc2 = is_accessor
        nw2 = writable_false
        vv2 = value_val
        hv2 = has_value
        np2 = name_ptr
        tg2 = target
        JSVM_ArgsAfterDefineProperty(tg2, np2, hv2, vv2, nw2, acc2)
        is_accessor = JSBridge__Pop()
        writable_false = JSBridge__Pop()
        value_val = JSBridge__Pop()
        has_value = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // M102: resync ALL mapped formals from arguments object after defineProperty
        IfCondition EqualTo(JSVM_IsArgumentsObj(target), 1) ThenBlock: {
            mi = 0
            WhileLoop LessThan(mi, 16) {
                IfCondition EqualTo(JSVM_ArgsIsMapped(target, mi), 1) ThenBlock: {
                    kbuf = JSVM__ArgIndexKey(mi)
                    IfCondition NotEqual(kbuf, 0) ThenBlock: {
                        JSBridge__Push(target)
                        JSBridge__Push(name_ptr)
                        av = JSRT_ObjGet(target, kbuf)
                        name_ptr = JSBridge__Pop()
                        target = JSBridge__Pop()
                        JSVM_ArgsSetFormalLocal(target, mi, av)
                    }
                }
                mi = Add(mi, 1)
            }
        }

        // Return the object
        ReturnValue(target)
    }
}

// Object.keys(obj) — return array of own enumerable string keys
// M128e6y: exclude engine symbol mangled keys "@@sN" (ES: no symbols in Object.keys)
Function.JSBridge__NObjKeys {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        target = Dereference(save_args)
        // Filter out __get_/__set_/… (inside ObjKeys) and symbol keys @@sN
        raw = JSRT_ObjKeys(target)
        n = JSRT_ArrLen(raw)
        filtered = JSRT_CreateArray()
        fi = 0
        WhileLoop LessThan(fi, n) {
            JSBridge__Push(raw)
            JSBridge__Push(filtered)
            JSBridge__Push(fi)
            JSBridge__Push(n)
            ksv = JSRT_ArrGet(raw, fi)
            n = JSBridge__Pop()
            fi = JSBridge__Pop()
            filtered = JSBridge__Pop()
            raw = JSBridge__Pop()
            is_sym = 0
            IfCondition EqualTo(JSRT_GetType(ksv), JSType.STRING) ThenBlock: {
                kp = JSRT_GetPayload(ksv)
                IfCondition NotEqual(kp, 0) ThenBlock: {
                    IfCondition And(EqualTo(JSRT_StrUnit(kp, 0), 64), And(EqualTo(JSRT_StrUnit(kp, 1), 64), EqualTo(JSRT_StrUnit(kp, 2), 115))) ThenBlock: {
                        is_sym = 1
                    }
                }
            }
            IfCondition EqualTo(is_sym, 0) ThenBlock: {
                JSBridge__Push(raw)
                JSBridge__Push(filtered)
                JSBridge__Push(fi)
                JSBridge__Push(n)
                JSRT_ArrPush(filtered, ksv)
                n = JSBridge__Pop()
                fi = JSBridge__Pop()
                filtered = JSBridge__Pop()
                raw = JSBridge__Pop()
            }
            fi = Add(fi, 1)
        }
        ReturnValue(filtered)
    }
}

// Object.getOwnPropertyDescriptors(obj) — M27c: map name → descriptor
Function.JSBridge__NGetOwnPropDescs {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateObject())
        }
        target = Dereference(args)
        tt = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.getOwnPropertyDescriptors called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
