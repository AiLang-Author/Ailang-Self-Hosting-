// =============================================================================
// NATIVE IMPLEMENTATIONS: Object.* methods
// =============================================================================

// Object.defineProperty(obj, prop, descriptor)
// descriptor can have: value, writable, enumerable, configurable, get, set
Function.JSBridge__NDefineProperty {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 3) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Extract arguments: obj, prop_name_val, descriptor
        target = Dereference(save_args)
        name_val = Dereference(Add(save_args, 8))
        desc_val = Dereference(Add(save_args, 16))

        // Convert property name to string
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        name_str = JSRT_ToString(name_val)
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()
        name_ptr = JSRT_GetPayload(name_str)

        // Check for getter (desc.get)
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        getter = JSRT_ObjGet(desc_val, "get")
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()

        gt = Dereference(getter)
        IfCondition EqualTo(gt, JSType.FUNCTION) ThenBlock: {
            // Store getter as __get_<prop>
            gbuf = Add(JSBridgeStack.pool, Add(Multiply(JSBridgeStack.sp, 8), 512))
            SetByte(gbuf, 0, 95)
            SetByte(gbuf, 1, 95)
            SetByte(gbuf, 2, 103)
            SetByte(gbuf, 3, 101)
            SetByte(gbuf, 4, 116)
            SetByte(gbuf, 5, 95)
            // Copy prop name after __get_
            gi = 0
            WhileLoop LessThan(gi, 120) {
                gc = GetByte(name_ptr, gi)
                SetByte(gbuf, Add(6, gi), gc)
                IfCondition EqualTo(gc, 0) ThenBlock: { gi = 999 }
                gi = Add(gi, 1)
            }
            JSBridge__Push(target)
            JSBridge__Push(desc_val)
            JSBridge__Push(name_ptr)
            JSRT_ObjSet(target, gbuf, getter)
            name_ptr = JSBridge__Pop()
            desc_val = JSBridge__Pop()
            target = JSBridge__Pop()
        }

        // Check for setter (desc.set)
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        setter = JSRT_ObjGet(desc_val, "set")
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()

        st = Dereference(setter)
        IfCondition EqualTo(st, JSType.FUNCTION) ThenBlock: {
            // Store setter as __set_<prop>
            sbuf = Add(JSBridgeStack.pool, Add(Multiply(JSBridgeStack.sp, 8), 640))
            SetByte(sbuf, 0, 95)
            SetByte(sbuf, 1, 95)
            SetByte(sbuf, 2, 115)
            SetByte(sbuf, 3, 101)
            SetByte(sbuf, 4, 116)
            SetByte(sbuf, 5, 95)
            si = 0
            WhileLoop LessThan(si, 120) {
                sc = GetByte(name_ptr, si)
                SetByte(sbuf, Add(6, si), sc)
                IfCondition EqualTo(sc, 0) ThenBlock: { si = 999 }
                si = Add(si, 1)
            }
            JSBridge__Push(target)
            JSBridge__Push(desc_val)
            JSBridge__Push(name_ptr)
            JSRT_ObjSet(target, sbuf, setter)
            name_ptr = JSBridge__Pop()
            desc_val = JSBridge__Pop()
            target = JSBridge__Pop()
        }

        // Check for value (desc.value)
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        dv = JSRT_ObjGet(desc_val, "value")
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        dvt = Dereference(dv)
        IfCondition NotEqual(dvt, JSType.UNDEFINED) ThenBlock: {
            JSBridge__Push(target)
            JSRT_ObjSet(target, name_ptr, dv)
            target = JSBridge__Pop()
        }

        // Store descriptor metadata as __desc_<prop> for writable/enumerable/configurable
        dbuf = Add(JSBridgeStack.pool, Add(Multiply(JSBridgeStack.sp, 8), 768))
        SetByte(dbuf, 0, 95)
        SetByte(dbuf, 1, 95)
        SetByte(dbuf, 2, 100)
        SetByte(dbuf, 3, 95)
        di = 0
        WhileLoop LessThan(di, 120) {
            dc = GetByte(name_ptr, di)
            SetByte(dbuf, Add(4, di), dc)
            IfCondition EqualTo(dc, 0) ThenBlock: { di = 999 }
            di = Add(di, 1)
        }
        JSBridge__Push(target)
        JSRT_ObjSet(target, dbuf, desc_val)
        target = JSBridge__Pop()

        // Return the object
        ReturnValue(target)
    }
}

// Object.keys(obj) — return array of own enumerable string keys
Function.JSBridge__NObjKeys {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        target = Dereference(save_args)
        // Filter out __get_, __set_, __desc_, __proto__, __class__, __super__ prefixed keys
        result = JSRT_ObjKeys(target)
        ReturnValue(result)
    }
}

// Object.create(proto) — create new object with proto as __proto__
Function.JSBridge__NObjCreate {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateObject())
        }
        proto = Dereference(save_args)
        JSBridge__Push(proto)
        obj = JSRT_CreateObject()
        proto = JSBridge__Pop()
        pt = Dereference(proto)
        // Set __proto__ if proto is an object (not null)
        IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: {
            JSRT_ObjSet(obj, "__proto__", proto)
        }
        ReturnValue(obj)
    }
}

// Object.getOwnPropertyDescriptor(obj, prop) — return descriptor object
Function.JSBridge__NGetOwnPropDesc {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(save_args)
        name_val = Dereference(Add(save_args, 8))

        JSBridge__Push(target)
        name_str = JSRT_ToString(name_val)
        target = JSBridge__Pop()
        name_ptr = JSRT_GetPayload(name_str)

        // Check if property exists
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        exists = JSRT_ObjHas(target, name_ptr)
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(exists, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Get value
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        val = JSRT_ObjGet(target, name_ptr)
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // Build descriptor object
        JSBridge__Push(val)
        desc = JSRT_CreateObject()
        val = JSBridge__Pop()

        JSBridge__Push(desc)
        JSRT_ObjSet(desc, "value", val)
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        wt = JSRT_CreateBool(1)
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSRT_ObjSet(desc, "writable", wt)
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        et = JSRT_CreateBool(1)
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSRT_ObjSet(desc, "enumerable", et)
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        ct = JSRT_CreateBool(1)
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSRT_ObjSet(desc, "configurable", ct)
        desc = JSBridge__Pop()

        ReturnValue(desc)
    }
}

// Object.getPrototypeOf(obj) — return __proto__
Function.JSBridge__NGetProtoOf {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_Null())
        }
        target = Dereference(save_args)
        JSBridge__Push(target)
        proto = JSRT_ObjGet(target, "__proto__")
        target = JSBridge__Pop()
        ReturnValue(proto)
    }
}

// Object.assign(target, ...sources) — copy own enumerable props
Function.JSBridge__NObjAssign {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(save_args)
        si = 1
        WhileLoop LessThan(si, save_argc) {
            src = Dereference(Add(save_args, Multiply(si, 8)))
            src_t = Dereference(src)
            IfCondition EqualTo(src_t, JSType.OBJECT) ThenBlock: {
                // Get keys of source
                JSBridge__Push(target)
                JSBridge__Push(save_args)
                JSBridge__Push(save_argc)
                JSBridge__Push(si)
                keys = JSRT_ObjKeys(src)
                si = JSBridge__Pop()
                save_argc = JSBridge__Pop()
                save_args = JSBridge__Pop()
                target = JSBridge__Pop()

                klen = JSRT_ArrLen(keys)
                ki = 0
                WhileLoop LessThan(ki, klen) {
                    JSBridge__Push(target)
                    JSBridge__Push(save_args)
                    JSBridge__Push(save_argc)
                    JSBridge__Push(si)
                    JSBridge__Push(keys)
                    JSBridge__Push(ki)
                    JSBridge__Push(klen)
                    ksv = JSRT_ArrGet(keys, ki)
                    klen = JSBridge__Pop()
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    si = JSBridge__Pop()
                    save_argc = JSBridge__Pop()
                    save_args = JSBridge__Pop()
                    target = JSBridge__Pop()

                    kp = JSRT_GetPayload(ksv)
                    src2 = Dereference(Add(save_args, Multiply(si, 8)))
                    JSBridge__Push(target)
                    JSBridge__Push(save_args)
                    JSBridge__Push(save_argc)
                    JSBridge__Push(si)
                    JSBridge__Push(keys)
                    JSBridge__Push(ki)
                    JSBridge__Push(klen)
                    v = JSRT_ObjGet(src2, kp)
                    klen = JSBridge__Pop()
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    si = JSBridge__Pop()
                    save_argc = JSBridge__Pop()
                    save_args = JSBridge__Pop()
                    target = JSBridge__Pop()

                    JSRT_ObjSet(target, kp, v)
                    ki = Add(ki, 1)
                }
            }
            si = Add(si, 1)
        }
        ReturnValue(target)
    }
}

// Object.freeze(obj) — mark object as frozen (store __frozen__ flag)
Function.JSBridge__NObjFreeze {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(args)
        JSBridge__Push(target)
        fv = JSRT_CreateBool(1)
        target = JSBridge__Pop()
        JSRT_ObjSet(target, "__frozen__", fv)
        ReturnValue(target)
    }
}

// Object.is(a, b) — strict equality (same as ===, except NaN===NaN and +0!==-0)
Function.JSBridge__NObjIs {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        IfCondition LessThan(argc, 2) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        a = Dereference(save_args)
        b = Dereference(Add(save_args, 8))
        at = Dereference(a)
        bt = Dereference(b)
        IfCondition NotEqual(at, bt) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        av = Dereference(Add(a, 8))
        bv = Dereference(Add(b, 8))
        IfCondition EqualTo(av, bv) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        // String comparison
        IfCondition EqualTo(at, JSType.STRING) ThenBlock: {
            JSBridge__Push(a)
            JSBridge__Push(b)
            cmp = StringCompare(av, bv)
            b = JSBridge__Pop()
            a = JSBridge__Pop()
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
        }
        ReturnValue(JSRT_CreateBool(0))
    }
}

// Array.isArray(val) — returns true if val is ARRAY type
Function.JSBridge__NArrIsArray {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        val = Dereference(args)
        vt = Dereference(val)
        IfCondition EqualTo(vt, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        ReturnValue(JSRT_CreateBool(0))
    }
}

// Array.from(arrayLike) — convert array-like or iterable to array
Function.JSBridge__NArrFrom {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        src = Dereference(save_args)
        st = Dereference(src)
        // If already an array, copy elements
        IfCondition EqualTo(st, JSType.ARRAY) ThenBlock: {
            JSBridge__Push(src)
            result = JSRT_CreateArray()
            src = JSBridge__Pop()
            slen = JSRT_ArrLen(src)
            ai = 0
            WhileLoop LessThan(ai, slen) {
                JSBridge__Push(src)
                JSBridge__Push(result)
                JSBridge__Push(ai)
                JSBridge__Push(slen)
                elem = JSRT_ArrGet(src, ai)
                slen = JSBridge__Pop()
                ai = JSBridge__Pop()
                result = JSBridge__Pop()
                src = JSBridge__Pop()
                JSRT_ArrPush(result, elem)
                ai = Add(ai, 1)
            }
            ReturnValue(result)
        }
        // If string, split into chars
        IfCondition EqualTo(st, JSType.STRING) ThenBlock: {
            sp = Dereference(Add(src, 8))
            JSBridge__Push(sp)
            result = JSRT_CreateArray()
            sp = JSBridge__Pop()
            ci = 0
            WhileLoop LessThan(ci, 10000) {
                ch = GetByte(sp, ci)
                IfCondition EqualTo(ch, 0) ThenBlock: { ci = 99999 }
                IfCondition NotEqual(ch, 0) ThenBlock: {
                    cp = Add(sp, ci)
                    JSBridge__Push(sp)
                    JSBridge__Push(result)
                    JSBridge__Push(ci)
                    csv = JSRT_CreateStringLen(cp, 1)
                    ci = JSBridge__Pop()
                    result = JSBridge__Pop()
                    sp = JSBridge__Pop()
                    JSRT_ArrPush(result, csv)
                    ci = Add(ci, 1)
                }
            }
            ReturnValue(result)
        }
        // Fallback: empty array
        ReturnValue(JSRT_CreateArray())
    }
}

// =============================================================================
// DOM NODE WRAPPING — create or find cached JS object for a DOM node
// Each wrapped node is a JS OBJECT with:
//   __dom_idx  : NUMBER (the DOM node index)
//   tagName    : STRING
//   id         : STRING (if present)
//   innerHTML  : STRING (text of first text child)
//   getAttribute    : FUNCTION (native)
//   setAttribute    : FUNCTION (native)
//   addEventListener: FUNCTION (native)
//   textContent     : STRING (alias of innerHTML for v1)
// =============================================================================

// Look up existing wrapper by DOM index. Returns JS object or 0.
Function.JSBridge__FindWrap {
    Input: dom_idx: Integer
    Output: Address
    Body: {
        save_idx = dom_idx
        wi = 0
        WhileLoop LessThan(wi, JSBridgeState.wrap_count) {
            base = Add(JSBridgeState.dom_wraps, Multiply(wi, JSBridgeConst.WRAP_SIZE))
            entry_idx = Dereference(base)
            IfCondition EqualTo(entry_idx, save_idx) ThenBlock: {
                ReturnValue(Dereference(Add(base, 8)))
            }
            wi = Add(wi, 1)
        }
        ReturnValue(0)
    }
}

// Public lookup: get the JS wrapper object for a DOM index (or 0 if not wrapped).
Function.JSBridge_GetWrapObj {
    Input: dom_idx: Integer
    Output: Address
    Body: {
        ReturnValue(JSBridge__FindWrap(dom_idx))
    }
}

// Store a new DOM-index -> JS-object mapping.
Function.JSBridge__StoreWrap {
    Input: dom_idx: Integer
    Input: js_obj: Address
    Output: Integer
    Body: {
        save_idx = dom_idx
        save_obj = js_obj
        IfCondition GreaterEqual(JSBridgeState.wrap_count, JSBridgeConst.MAX_DOM_WRAPS) ThenBlock: {
            PrintMessage("[JSBridge] wrap pool full\n")
            ReturnValue(0)
        }
        base = Add(JSBridgeState.dom_wraps, Multiply(JSBridgeState.wrap_count, JSBridgeConst.WRAP_SIZE))
        StoreValue(base, save_idx)
        StoreValue(Add(base, 8), save_obj)
        JSBridgeState.wrap_count = Add(JSBridgeState.wrap_count, 1)
        ReturnValue(1)
    }
}

// Public API: wrap a DOM node as a JS object (or return cached wrapper).
Function.JSBridge_WrapNode {
    Input: dom_idx: Integer
    Output: Address
    Body: {
        save_idx = dom_idx

        // Negative index means "not found" in DOM
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Check cache first
        cached = JSBridge__FindWrap(save_idx)
        IfCondition NotEqual(cached, 0) ThenBlock: {
            ReturnValue(cached)
        }

        // Create new JS object
        obj = JSRT_CreateObject()

        // Set __dom_idx property
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        idx_val = JSRT_CreateNumber(save_idx)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__dom_idx", idx_val)

        // Set tagName
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        tag_ptr = DOM_GetTag(save_idx)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        IfCondition NotEqual(tag_ptr, 0) ThenBlock: {
            JSBridge__Push(save_idx)
            JSBridge__Push(obj)
            tag_val = JSRT_CreateString(tag_ptr)
            obj = JSBridge__Pop()
            save_idx = JSBridge__Pop()
            JSRT_ObjSet(obj, "tagName", tag_val)
        }

        // Set id (from DOM attribute)
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        id_ptr = DOM_GetAttr(save_idx, "id")
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        IfCondition NotEqual(id_ptr, 0) ThenBlock: {
            JSBridge__Push(save_idx)
            JSBridge__Push(obj)
            id_val = JSRT_CreateString(id_ptr)
            obj = JSBridge__Pop()
            save_idx = JSBridge__Pop()
            JSRT_ObjSet(obj, "id", id_val)
        }

        // Set innerHTML / textContent from first TEXT child
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        text_str = JSBridge__GetNodeText(save_idx)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        IfCondition NotEqual(text_str, 0) ThenBlock: {
            JSBridge__Push(save_idx)
            JSBridge__Push(obj)
            text_val = JSRT_CreateString(text_str)
            obj = JSBridge__Pop()
            save_idx = JSBridge__Pop()
            JSRT_ObjSet(obj, "innerHTML", text_val)
            // textContent aliases innerHTML for v1
            JSRT_ObjSet(obj, "textContent", text_val)
        }

        // ─── method: getAttribute ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ga_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_GET_ATTR, "getAttribute", 1)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "getAttribute", ga_func)

        // ─── method: setAttribute ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        sa_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_SET_ATTR, "setAttribute", 2)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "setAttribute", sa_func)

        // ─── method: addEventListener ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ael_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_ADD_LISTENER, "addEventListener", 2)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "addEventListener", ael_func)

        // ─── method: appendChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ac_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_APPEND_CHILD, "appendChild", 1)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "appendChild", ac_func)

        // ─── method: removeChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        rc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_REMOVE_CHILD, "removeChild", 1)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "removeChild", rc_func)

        // ─── method: insertBefore ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ib_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_INSERT_BEFORE, "insertBefore", 2)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "insertBefore", ib_func)

        // ─── method: replaceChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        rpc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_REPLACE_CHILD, "replaceChild", 2)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "replaceChild", rpc_func)

        // ─── method: contains ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        cn_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CONTAINS, "contains", 1)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "contains", cn_func)

        // ─── method: remove ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        rm_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_REMOVE, "remove", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "remove", rm_func)

        // ─── property: parentNode ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        pn_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_PARENT_NODE, "parentNode", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_parentNode", pn_func)

        // ─── property: firstChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        fc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_FIRST_CHILD, "firstChild", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_firstChild", fc_func)

        // ─── property: lastChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        lc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_LAST_CHILD, "lastChild", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_lastChild", lc_func)

        // ─── property: nextSibling ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ns_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_NEXT_SIBLING, "nextSibling", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_nextSibling", ns_func)

        // ─── property: previousSibling ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ps_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_PREV_SIBLING, "previousSibling", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_previousSibling", ps_func)

        // ─── property: childNodes ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        cns_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CHILD_NODES, "childNodes", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_childNodes", cns_func)

        // ─── method: getBoundingClientRect ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        gbcr_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_GET_BOUNDING_RECT, "getBoundingClientRect", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "getBoundingClientRect", gbcr_func)

        // ─── property: offsetWidth (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ow_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_OFFSET_WIDTH, "offsetWidth", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_offsetWidth", ow_func)

        // ─── property: offsetHeight (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        oh_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_OFFSET_HEIGHT, "offsetHeight", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_offsetHeight", oh_func)

        // ─── property: clientWidth (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        cw_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLIENT_WIDTH, "clientWidth", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_clientWidth", cw_func)

        // ─── property: clientHeight (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ch_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLIENT_HEIGHT, "clientHeight", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_clientHeight", ch_func)

        // ─── property: scrollWidth (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        sw_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_SCROLL_WIDTH, "scrollWidth", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_scrollWidth", sw_func)

        // ─── property: scrollHeight (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        sh_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_SCROLL_HEIGHT, "scrollHeight", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_scrollHeight", sh_func)

        // ─── property: classList (sub-object with add/remove/toggle/contains) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        cl_obj = JSRT_CreateObject()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        // Store __dom_idx on classList object so handlers can find the element
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        JSBridge__Push(cl_obj)
        cl_didx = JSRT_CreateNumber(save_idx)
        cl_obj = JSBridge__Pop()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(cl_obj, "__dom_idx", cl_didx)
        // classList.add
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        JSBridge__Push(cl_obj)
        cla_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLASS_LIST_ADD, "add", 1)
        cl_obj = JSBridge__Pop()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(cl_obj, "add", cla_func)
        // classList.remove
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        JSBridge__Push(cl_obj)
        clr_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLASS_LIST_RM, "remove", 1)
        cl_obj = JSBridge__Pop()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(cl_obj, "remove", clr_func)
        // classList.toggle
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        JSBridge__Push(cl_obj)
        clt_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLASS_LIST_TOG, "toggle", 1)
        cl_obj = JSBridge__Pop()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(cl_obj, "toggle", clt_func)
        // classList.contains
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        JSBridge__Push(cl_obj)
        clc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLASS_LIST_HAS, "contains", 1)
        cl_obj = JSBridge__Pop()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(cl_obj, "contains", clc_func)
        JSRT_ObjSet(obj, "classList", cl_obj)

        // Store in wrap cache
        JSBridge__StoreWrap(save_idx, obj)

        ReturnValue(obj)
    }
}

// =============================================================================
// HELPER — get the text content of a DOM node's first TEXT child
// Returns pointer to string, or 0 if no text child
// =============================================================================
Function.JSBridge__GetNodeText {
    Input: dom_idx: Integer
    Output: Address
    Body: {
        save_idx = dom_idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Check if this node itself is a text node
        ntype = DOM_GetType(save_idx)
        IfCondition EqualTo(ntype, DOMType.TEXT) ThenBlock: {
            ReturnValue(DOM_GetText(save_idx))
        }

        // Walk children to find first TEXT node
        ch = DOM_GetFirstChild(save_idx)
        WhileLoop NotEqual(ch, -1) {
            ch_type = DOM_GetType(ch)
            IfCondition EqualTo(ch_type, DOMType.TEXT) ThenBlock: {
                ReturnValue(DOM_GetText(ch))
            }
            ch = DOM_GetNextSib(ch)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// HELPER — extract __dom_idx integer from a JS wrapper object
// Returns the DOM node index, or -1 if not a wrapper
// =============================================================================
Function.JSBridge__GetDomIdx {
    Input: js_obj: Address
    Output: Integer
    Body: {
        JSBridgeTmp.obj = js_obj
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(-1)
        }
        otype = JSRT_GetType(JSBridgeTmp.obj)
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(-1)
        }
        JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.obj, "__dom_idx")
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            ReturnValue(-1)
        }
        vtype = JSRT_GetType(JSBridgeTmp.result)
        IfCondition NotEqual(vtype, JSType.NUMBER) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(Float_ToInt(JSRT_GetPayload(JSBridgeTmp.result)))
    }
}

// =============================================================================
// HELPER — look up a CSS property for a DOM node (inline + stylesheet rules)
// Returns pointer to value string, or 0 if not found
// =============================================================================
Function.JSBridge__CSSLookup {
    Input: node: Integer
    Input: prop: Address
    Output: Address
    Body: {
        // 1. Check inline style (highest priority)
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            slen = StringLength(style_str)
            rule = CSS_ParseInline(style_str, slen)
            IfCondition GreaterEqual(rule, 0) ThenBlock: {
                cv = CSS_GetPropVal(rule, prop)
                IfCondition NotEqual(cv, 0) ThenBlock: {
                    ReturnValue(cv)
                }
            }
        }

        // 2. Check CSS stylesheet rules (tag/class/id matching)
        rcount = CSS_RuleCount()
        IfCondition EqualTo(rcount, 0) ThenBlock: { ReturnValue(0) }

        css_tag = DOM_GetTag(node)
        css_cls = DOM_GetAttr(node, "class")
        css_id = DOM_GetAttr(node, "id")

        css_result = 0
        css_best = -1
        css_ri = 0
        WhileLoop LessThan(css_ri, rcount) {
            css_matched = 0
            IfCondition EqualTo(CSS_MatchesTag(css_ri, css_tag), 1) ThenBlock: {
                css_matched = 1
            }
            IfCondition EqualTo(css_matched, 0) ThenBlock: {
                IfCondition NotEqual(css_cls, 0) ThenBlock: {
                    IfCondition EqualTo(CSS_MatchesClass(css_ri, css_cls), 1) ThenBlock: {
                        css_matched = 1
                    }
                }
            }
            IfCondition EqualTo(css_matched, 0) ThenBlock: {
                IfCondition EqualTo(CSS_MatchesId(css_ri, css_id), 1) ThenBlock: {
                    css_matched = 1
                }
            }
            IfCondition EqualTo(css_matched, 1) ThenBlock: {
                css_val = CSS_GetPropVal(css_ri, prop)
                IfCondition NotEqual(css_val, 0) ThenBlock: {
                    css_spec = CSS_RuleSpecificity(css_ri)
                    IfCondition GreaterEqual(css_spec, css_best) ThenBlock: {
                        css_best = css_spec
                        css_result = css_val
                    }
                }
            }
            css_ri = Add(css_ri, 1)
        }

        ReturnValue(css_result)
    }
}

// =============================================================================
// HELPER — get DOM index from "this" (the method receiver)
// Used by method handlers called via CALL_METHOD
// =============================================================================
Function.JSBridge__GetThisDomIdx {
    Output: Integer
    Body: {
        this_obj = JSVM_GetGlobal("this")
        ReturnValue(JSBridge__GetDomIdx(this_obj))
    }
}

// =============================================================================
// HELPER — get DOM index from arg buffer slot
// Dereferences the pointer at args+offset to get the JSValue, then extracts idx
// =============================================================================
Function.JSBridge__GetArgDomIdx {
    Input: args: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        arg_val = Dereference(Add(args, offset))
        ReturnValue(JSBridge__GetDomIdx(arg_val))
    }
}

// =============================================================================
// SET_PROP INTERCEPT — called by JSVM on SET_PROP to handle DOM mutations
// If the object has __dom_idx and the property is innerHTML/textContent,
// updates the actual DOM text node. Returns 1 if intercepted, 0 if not.
// =============================================================================
Function.JSBridge_SetProp {
    Input: obj: Address
    Input: prop: Address
    Input: val: Address
    Output: Integer
    Body: {
        // Store all inputs in FixedPool — locals get clobbered by every function call
        JSBridgeTmp.obj = obj
        JSBridgeTmp.name_ptr = prop
        JSBridgeTmp.val = val

        // Check for __dom_idx on the object
        JSBridgeTmp.dom_idx = JSBridge__GetDomIdx(JSBridgeTmp.obj)
        IfCondition LessThan(JSBridgeTmp.dom_idx, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Check if property is "innerHTML" or "textContent" by byte inspection
        p0 = GetByte(JSBridgeTmp.name_ptr, 0)

        // "innerHTML" starts with 'i' = 105, check 'n' at 1 and 'H' at 5
        JSBridgeTmp.found = 0
        IfCondition EqualTo(p0, 105) ThenBlock: {
            p1 = GetByte(JSBridgeTmp.name_ptr, 1)
            IfCondition EqualTo(p1, 110) ThenBlock: {
                p5 = GetByte(JSBridgeTmp.name_ptr, 5)
                IfCondition EqualTo(p5, 72) ThenBlock: {
                    JSBridgeTmp.found = 1
                }
            }
        }

        // "textContent" starts with 't' = 116, check 'e' at 1 and 'C' at 4
        IfCondition EqualTo(p0, 116) ThenBlock: {
            p1 = GetByte(JSBridgeTmp.name_ptr, 1)
            IfCondition EqualTo(p1, 101) ThenBlock: {
                p4 = GetByte(JSBridgeTmp.name_ptr, 4)
                IfCondition EqualTo(p4, 67) ThenBlock: {
                    JSBridgeTmp.found = 1
                }
            }
        }

        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Convert value to string
        JSBridgeTmp.result = JSRT_ToString(JSBridgeTmp.val)
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            ReturnValue(1)
        }

        // Extract raw string pointer from the JSValue
        JSBridgeTmp.ptr = JSRT_GetPayload(JSBridgeTmp.result)
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            ReturnValue(1)
        }

        // Find first TEXT child of this DOM element
        JSBridgeTmp.node = DOM_GetFirstChild(JSBridgeTmp.dom_idx)
        JSBridgeTmp.idx = -1
        WhileLoop NotEqual(JSBridgeTmp.node, -1) {
            ch_type = DOM_GetType(JSBridgeTmp.node)
            IfCondition EqualTo(ch_type, DOMType.TEXT) ThenBlock: {
                JSBridgeTmp.idx = JSBridgeTmp.node
                JSBridgeTmp.node = -1
            }
            IfCondition NotEqual(JSBridgeTmp.node, -1) ThenBlock: {
                JSBridgeTmp.node = DOM_GetNextSib(JSBridgeTmp.node)
            }
        }

        IfCondition GreaterEqual(JSBridgeTmp.idx, 0) ThenBlock: {
            // Update existing TEXT node
            JSBridgeTmp.len = StringLength(JSBridgeTmp.ptr)
            DOM__NodeSet(JSBridgeTmp.idx, DOMConst.N_TEXT_PTR, JSBridgeTmp.ptr)
            DOM__NodeSet(JSBridgeTmp.idx, DOMConst.N_TEXT_LEN, JSBridgeTmp.len)
        } ElseBlock: {
            // No TEXT child — create one and append
            JSBridgeTmp.idx = DOM__CreateNode(DOMType.TEXT)
            IfCondition GreaterEqual(JSBridgeTmp.idx, 0) ThenBlock: {
                JSBridgeTmp.len = StringLength(JSBridgeTmp.ptr)
                DOM__NodeSet(JSBridgeTmp.idx, DOMConst.N_TEXT_PTR, JSBridgeTmp.ptr)
                DOM__NodeSet(JSBridgeTmp.idx, DOMConst.N_TEXT_LEN, JSBridgeTmp.len)
                DOM__AppendChild(JSBridgeTmp.dom_idx, JSBridgeTmp.idx)
            }
        }

        // Also update the JS object's property so reads reflect the change
        JSRT_ObjSet(JSBridgeTmp.obj, JSBridgeTmp.name_ptr, JSBridgeTmp.result)

        ReturnValue(1)
    }
}

// =============================================================================
// REGEXP CONSTRUCTOR — new RegExp(pattern, flags)
// Creates a regexp object with compiled NFA handle and instance methods.
// =============================================================================
Function.JSBridge__NRegExpCtor {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc

        // ─── Extract pattern string (arg0, default "") ───
        pat_ptr = 0
        pat_len = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            arg0 = Dereference(save_args)
            a0_type = JSRT_GetType(arg0)
            IfCondition EqualTo(a0_type, JSType.STRING) ThenBlock: {
                pat_ptr = JSRT_GetPayload(arg0)
                pat_len = StringLength(pat_ptr)
            }
            IfCondition NotEqual(a0_type, JSType.STRING) ThenBlock: {
                IfCondition NotEqual(a0_type, JSType.UNDEFINED) ThenBlock: {
                    // Coerce to string
                    JSBridge__Push(save_args)
                    s_val = JSRT_ToString(arg0)
                    save_args = JSBridge__Pop()
                    pat_ptr = JSRT_GetPayload(s_val)
                    pat_len = StringLength(pat_ptr)
                }
            }
        }

        // ─── Extract flags string (arg1, default "") ───
        flg_ptr = 0
        flg_len = 0
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            arg1 = Dereference(Add(save_args, 8))
            a1_type = JSRT_GetType(arg1)
            IfCondition EqualTo(a1_type, JSType.STRING) ThenBlock: {
                flg_ptr = JSRT_GetPayload(arg1)
                flg_len = StringLength(flg_ptr)
            }
            IfCondition NotEqual(a1_type, JSType.STRING) ThenBlock: {
                IfCondition NotEqual(a1_type, JSType.UNDEFINED) ThenBlock: {
                    JSBridge__Push(save_args)
                    f_val = JSRT_ToString(arg1)
                    save_args = JSBridge__Pop()
                    flg_ptr = JSRT_GetPayload(f_val)
                    flg_len = StringLength(flg_ptr)
                }
            }
        }

        // ─── Parse flags string → bitfield ───
        // g=32 (GLOBAL), i=1 (CASE_INSENSITIVE), m=2 (MULTILINE), s=4 (DOTALL)
        // y=64 (STICKY), u=16 (UNICODE)
        flags_int = 0
        has_global = 0
        has_icase = 0
        has_mline = 0
        has_dotall = 0
        fi = 0
        WhileLoop LessThan(fi, flg_len) {
            fc = GetByte(flg_ptr, fi)
            // 'g' = 103
            IfCondition EqualTo(fc, 103) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 32)
                has_global = 1
            }
            // 'i' = 105
            IfCondition EqualTo(fc, 105) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 1)
                has_icase = 1
            }
            // 'm' = 109
            IfCondition EqualTo(fc, 109) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 2)
                has_mline = 1
            }
            // 's' = 115
            IfCondition EqualTo(fc, 115) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 4)
                has_dotall = 1
            }
            // 'u' = 117
            IfCondition EqualTo(fc, 117) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 16)
            }
            // 'y' = 121
            IfCondition EqualTo(fc, 121) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 64)
            }
            fi = Add(fi, 1)
        }

        // ─── Compile regex ───
        rx_handle = 0
        IfCondition NotEqual(pat_ptr, 0) ThenBlock: {
            rx_handle = JSRegex_Compile(pat_ptr, flags_int)
        }
        IfCondition EqualTo(pat_ptr, 0) ThenBlock: {
            // Empty pattern — matches everything
            rx_handle = JSRegex_Compile("", flags_int)
        }

        // ─── Create RegExp object ───
        re_obj = JSRT_CreateObject()

        // __class__ = "RegExp"
        JSBridge__Push(re_obj)
        cls_val = JSRT_CreateString("RegExp")
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "__class__", cls_val)

        // source = pattern string
        JSBridge__Push(re_obj)
        IfCondition NotEqual(pat_ptr, 0) ThenBlock: {
            src_val = JSRT_CreateStringLen(pat_ptr, pat_len)
        }
        IfCondition EqualTo(pat_ptr, 0) ThenBlock: {
            src_val = JSRT_CreateString("(?:)")
        }
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "source", src_val)

        // flags = flags string
        JSBridge__Push(re_obj)
        IfCondition NotEqual(flg_ptr, 0) ThenBlock: {
            flg_val = JSRT_CreateStringLen(flg_ptr, flg_len)
        }
        IfCondition EqualTo(flg_ptr, 0) ThenBlock: {
            flg_val = JSRT_CreateString("")
        }
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "flags", flg_val)

        // __regex_handle__ = raw handle (stored as float bits to avoid Float_FromInt)
        JSBridge__Push(re_obj)
        rh_val = JSRT_CreateFloat(rx_handle)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "__regex_handle__", rh_val)

        // global, ignoreCase, multiline boolean properties
        JSBridge__Push(re_obj)
        g_val = JSRT_CreateBool(has_global)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "global", g_val)

        JSBridge__Push(re_obj)
        ic_val = JSRT_CreateBool(has_icase)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "ignoreCase", ic_val)

        JSBridge__Push(re_obj)
        ml_val = JSRT_CreateBool(has_mline)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "multiline", ml_val)

        JSBridge__Push(re_obj)
        ds_val = JSRT_CreateBool(has_dotall)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "dotAll", ds_val)

        // lastIndex = 0
        JSBridge__Push(re_obj)
        li_val = JSRT_CreateNumber(0)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "lastIndex", li_val)

        // ─── Set __proto__ to RegExp.prototype ───
        // Methods (test/exec/toString) live on RegExp.prototype.
        // GET_PROP rebinds them to the instance on access (same pattern as strings).
        JSBridge__Push(re_obj)
        rp = JSBridgeState.regexp_proto
        re_obj = JSBridge__Pop()
        IfCondition NotEqual(rp, 0) ThenBlock: {
            JSRT_ObjSet(re_obj, "__proto__", rp)
        }

        ReturnValue(re_obj)
    }
}

// =============================================================================
// NATIVE DISPATCH — route handler ID to the appropriate native impl
// Called by JSVM when handler_id >= 8.
// args = pointer to array of JSValue pointers (8 bytes each)
// argc = number of arguments
// Returns a JSValue pointer (result).
// =============================================================================
Function.JSBridge_Dispatch {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

        // ─── CONSOLE_LOG (8) ───
        IfCondition EqualTo(save_id, JSNativeID.CONSOLE_LOG) ThenBlock: {
            ReturnValue(JSBridge__NConsoleLog(save_args, save_argc))
        }

        // ─── DOC_GET_BY_ID (9) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_GET_BY_ID) ThenBlock: {
            ReturnValue(JSBridge__NGetById(save_args, save_argc))
        }

        // ─── DOC_QUERY_SEL (10) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_QUERY_SEL) ThenBlock: {
            ReturnValue(JSBridge__NQuerySel(save_args, save_argc))
        }

        // ─── DOC_CREATE_ELEM (11) — document.createElement(tag) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_CREATE_ELEM) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Null()) }
            arg0 = Dereference(save_args)
            str0 = JSRT_ToString(arg0)
            tag_ptr = JSRT_GetPayload(str0)
            IfCondition EqualTo(tag_ptr, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            elem_idx = DOM_CreateElement(tag_ptr)
            ReturnValue(JSBridge_WrapNode(elem_idx))
        }

        // ─── ELEM_GET_ATTR (12) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_GET_ATTR) ThenBlock: {
            ReturnValue(JSBridge__NGetAttr(save_args, save_argc))
        }

        // ─── ELEM_SET_ATTR (13) — element.setAttribute(name, value) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_SET_ATTR) ThenBlock: {
            IfCondition LessThan(save_argc, 3) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            // args[0] = element wrapper, args[1] = attr name, args[2] = attr value
            sa_elem = Dereference(save_args)
            JSBridge__Push(save_args)
            sa_domidx = JSBridge__GetDomIdx(sa_elem)
            save_args = JSBridge__Pop()
            IfCondition LessThan(sa_domidx, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            // Get name string
            sa_name_val = Dereference(Add(save_args, 8))
            JSBridge__Push(save_args)
            JSBridge__Push(sa_domidx)
            sa_name_s = JSRT_ToString(sa_name_val)
            sa_domidx = JSBridge__Pop()
            save_args = JSBridge__Pop()
            sa_name_ptr = JSRT_GetPayload(sa_name_s)
            IfCondition EqualTo(sa_name_ptr, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            // Get value string
            sa_val_val = Dereference(Add(save_args, 16))
            JSBridge__Push(sa_name_ptr)
            JSBridge__Push(sa_domidx)
            sa_val_s = JSRT_ToString(sa_val_val)
            sa_domidx = JSBridge__Pop()
            sa_name_ptr = JSBridge__Pop()
            sa_val_ptr = JSRT_GetPayload(sa_val_s)
            IfCondition EqualTo(sa_val_ptr, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            // Copy strings to str_slab for stable storage
            sa_nlen = StringLength(sa_name_ptr)
            sa_stable_name = JSRT__StrSlabAlloc(Add(sa_nlen, 1))
            MemoryCopy(sa_stable_name, sa_name_ptr, sa_nlen)
            SetByte(sa_stable_name, sa_nlen, 0)
            sa_vlen = StringLength(sa_val_ptr)
            sa_stable_val = JSRT__StrSlabAlloc(Add(sa_vlen, 1))
            MemoryCopy(sa_stable_val, sa_val_ptr, sa_vlen)
            SetByte(sa_stable_val, sa_vlen, 0)
            DOM_SetAttr(sa_domidx, sa_stable_name, sa_stable_val)
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_ADD_LISTENER (14) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_ADD_LISTENER) ThenBlock: {
            ReturnValue(JSBridge__NAddListener(save_args, save_argc))
        }

        // ─── ELEM_INNER_HTML_GET (15) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_INNER_HTML_GET) ThenBlock: {
            ReturnValue(JSBridge__NInnerHTMLGet(save_args, save_argc))
        }

        // ─── ELEM_INNER_HTML_SET (16) — element.innerHTML = val ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_INNER_HTML_SET) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            ihs_idx = JSBridge__GetThisDomIdx()
            ihs_arg = Dereference(save_args)
            JSBridge__Push(ihs_idx)
            ihs_str = JSRT_ToString(ihs_arg)
            ihs_idx = JSBridge__Pop()
            ihs_ptr = JSRT_GetPayload(ihs_str)
            ihs_len = 0
            IfCondition NotEqual(ihs_ptr, 0) ThenBlock: {
                ihs_len = StringLength(ihs_ptr)
            }
            // For v1 treat as textContent — clears children and sets text node
            DOM_SetTextContent(ihs_idx, ihs_ptr, ihs_len)
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_TEXT_CONTENT (17) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_TEXT_CONTENT) ThenBlock: {
            // Same as innerHTML get for v1
            ReturnValue(JSBridge__NInnerHTMLGet(save_args, save_argc))
        }

        // ─── ELEM_APPEND_CHILD (18) — node.appendChild(child) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_APPEND_CHILD) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            parent_idx = JSBridge__GetThisDomIdx()
            child_val = Dereference(save_args)
            child_idx = JSBridge__GetArgDomIdx(save_args, 0)
            DOM_AppendChild(parent_idx, child_idx)
            ReturnValue(child_val)
        }

        // ─── ELEM_REMOVE_CHILD (19) — node.removeChild(child) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_REMOVE_CHILD) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            parent_idx = JSBridge__GetThisDomIdx()
            child_val = Dereference(save_args)
            child_idx = JSBridge__GetArgDomIdx(save_args, 0)
            DOM_RemoveChild(parent_idx, child_idx)
            ReturnValue(child_val)
        }

        // ─── ELEM_STYLE_SET (20) — element.style.cssText = val ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_STYLE_SET) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            ss_idx = JSBridge__GetThisDomIdx()
            ss_arg = Dereference(save_args)
            JSBridge__Push(ss_idx)
            ss_str = JSRT_ToString(ss_arg)
            ss_idx = JSBridge__Pop()
            ss_ptr = JSRT_GetPayload(ss_str)
            IfCondition NotEqual(ss_ptr, 0) ThenBlock: {
                ss_len = StringLength(ss_ptr)
                ss_stable = JSRT__StrSlabAlloc(Add(ss_len, 1))
                MemoryCopy(ss_stable, ss_ptr, ss_len)
                SetByte(ss_stable, ss_len, 0)
                DOM_SetAttr(ss_idx, "style", ss_stable)
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── SET_TIMEOUT (21) ───
        IfCondition EqualTo(save_id, JSNativeID.SET_TIMEOUT) ThenBlock: {
            ReturnValue(JSBridge__NSetTimeout(save_args, save_argc))
        }

        // ─── SET_INTERVAL (22) ───
        IfCondition EqualTo(save_id, JSNativeID.SET_INTERVAL) ThenBlock: {
            ReturnValue(JSBridge__NSetInterval(save_args, save_argc))
        }

        // ─── CLEAR_TIMEOUT (23) ───
        IfCondition EqualTo(save_id, JSNativeID.CLEAR_TIMEOUT) ThenBlock: {
            ReturnValue(JSBridge__NClearTimeout(save_args, save_argc))
        }

        // ─── PARSE_INT (24) ───
        IfCondition EqualTo(save_id, JSNativeID.PARSE_INT) ThenBlock: {
            ReturnValue(JSBridge__NParseInt(save_args, save_argc))
        }

        // ─── MATH_ABS (25) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_ABS) ThenBlock: {
            // Delegate to JSRT built-in handler 1
            ReturnValue(JSRT_CallNative(1, save_args, save_argc))
        }

        // ─── MATH_MAX (26) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_MAX) ThenBlock: {
            // Delegate to JSRT built-in handler 2
            ReturnValue(JSRT_CallNative(2, save_args, save_argc))
        }

        // ─── MATH_MIN (27) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_MIN) ThenBlock: {
            // Delegate to JSRT built-in handler 3
            ReturnValue(JSRT_CallNative(3, save_args, save_argc))
        }

        // ─── MATH_FLOOR (28) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_FLOOR) ThenBlock: {
            // Delegate to JSRT built-in handler 4
            ReturnValue(JSRT_CallNative(4, save_args, save_argc))
        }

        // ─── MATH_CEIL (79) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_CEIL) ThenBlock: {
            // Delegate to JSRT built-in handler 5
            ReturnValue(JSRT_CallNative(5, save_args, save_argc))
        }

        // ─── MATH_ROUND (80) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_ROUND) ThenBlock: {
            // Delegate to JSRT built-in handler 6
            ReturnValue(JSRT_CallNative(6, save_args, save_argc))
        }

        // ─── MATH_POW (81) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_POW) ThenBlock: {
            // Delegate to JSRT built-in handler 7
            ReturnValue(JSRT_CallNative(7, save_args, save_argc))
        }

        // ─── REGEXP_CTOR (82) — new RegExp(pattern, flags) ───
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_CTOR) ThenBlock: {
            ReturnValue(JSBridge__NRegExpCtor(save_args, save_argc))
        }

        // ─── OBJ_DEFINE_PROP (43) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_DEFINE_PROP) ThenBlock: {
            ReturnValue(JSBridge__NDefineProperty(save_args, save_argc))
        }

        // ─── OBJ_KEYS (44) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_KEYS) ThenBlock: {
            ReturnValue(JSBridge__NObjKeys(save_args, save_argc))
        }

        // ─── OBJ_CREATE (45) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_CREATE) ThenBlock: {
            ReturnValue(JSBridge__NObjCreate(save_args, save_argc))
        }

        // ─── OBJ_GET_OWN_PROP_DESC (46) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_OWN_PROP_DESC) ThenBlock: {
            ReturnValue(JSBridge__NGetOwnPropDesc(save_args, save_argc))
        }

        // ─── OBJ_GET_PROTO_OF (47) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_PROTO_OF) ThenBlock: {
            ReturnValue(JSBridge__NGetProtoOf(save_args, save_argc))
        }

        // ─── OBJ_ASSIGN (48) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_ASSIGN) ThenBlock: {
            ReturnValue(JSBridge__NObjAssign(save_args, save_argc))
        }

        // ─── OBJ_FREEZE (49) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_FREEZE) ThenBlock: {
            ReturnValue(JSBridge__NObjFreeze(save_args, save_argc))
        }

        // ─── OBJ_IS (50) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS) ThenBlock: {
            ReturnValue(JSBridge__NObjIs(save_args, save_argc))
        }

        // ─── OBJ_DEF_PROPERTIES (51) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_DEF_PROPERTIES) ThenBlock: {
            // TODO: iterate descriptor object keys and call defineProperty for each
            ReturnValue(Dereference(save_args))
        }

        // ─── OBJ_ENTRIES (52) — Object.entries(obj) → [[key, val], ...] ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_ENTRIES) ThenBlock: {
            oe_result = JSRT_CreateArray()
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(oe_result) }
            oe_obj = Dereference(save_args)
            oe_type = JSRT_GetType(oe_obj)
            IfCondition NotEqual(oe_type, JSType.OBJECT) ThenBlock: { ReturnValue(oe_result) }
            // Get keys
            JSBridge__Push(oe_result)
            JSBridge__Push(oe_obj)
            oe_keys = JSRT_ObjKeys(oe_obj)
            oe_obj = JSBridge__Pop()
            oe_result = JSBridge__Pop()
            oe_klen = JSRT_ArrLen(oe_keys)
            oe_i = 0
            WhileLoop LessThan(oe_i, oe_klen) {
                JSBridge__Push(oe_result)
                JSBridge__Push(oe_obj)
                JSBridge__Push(oe_keys)
                JSBridge__Push(oe_i)
                // Get key string value
                oe_kval = JSRT_ArrGet(oe_keys, oe_i)
                oe_kstr = JSRT_GetPayload(oe_kval)
                // Get value for this key
                oe_vval = JSRT_ObjGet(oe_obj, oe_kstr)
                // Create [key, value] pair
                oe_pair = JSRT_CreateArray()
                JSRT_ArrPush(oe_pair, oe_kval)
                JSRT_ArrPush(oe_pair, oe_vval)
                oe_i = JSBridge__Pop()
                oe_keys = JSBridge__Pop()
                oe_obj = JSBridge__Pop()
                oe_result = JSBridge__Pop()
                JSRT_ArrPush(oe_result, oe_pair)
                oe_i = Add(oe_i, 1)
            }
            ReturnValue(oe_result)
        }

        // ─── OBJ_VALUES (53) — Object.values(obj) → [val, ...] ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_VALUES) ThenBlock: {
            ov_result = JSRT_CreateArray()
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(ov_result) }
            ov_obj = Dereference(save_args)
            ov_type = JSRT_GetType(ov_obj)
            IfCondition NotEqual(ov_type, JSType.OBJECT) ThenBlock: { ReturnValue(ov_result) }
            // Get keys
            JSBridge__Push(ov_result)
            JSBridge__Push(ov_obj)
            ov_keys = JSRT_ObjKeys(ov_obj)
            ov_obj = JSBridge__Pop()
            ov_result = JSBridge__Pop()
            ov_klen = JSRT_ArrLen(ov_keys)
            ov_i = 0
            WhileLoop LessThan(ov_i, ov_klen) {
                JSBridge__Push(ov_result)
                JSBridge__Push(ov_obj)
                JSBridge__Push(ov_keys)
                JSBridge__Push(ov_i)
                ov_kval = JSRT_ArrGet(ov_keys, ov_i)
                ov_kstr = JSRT_GetPayload(ov_kval)
                ov_vval = JSRT_ObjGet(ov_obj, ov_kstr)
                ov_i = JSBridge__Pop()
                ov_keys = JSBridge__Pop()
                ov_obj = JSBridge__Pop()
                ov_result = JSBridge__Pop()
                JSRT_ArrPush(ov_result, ov_vval)
                ov_i = Add(ov_i, 1)
            }
            ReturnValue(ov_result)
        }

        // ─── OBJ_HAS_OWN_PROP (54) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_HAS_OWN_PROP) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            hop_obj = Dereference(save_args)
            hop_key_val = Dereference(Add(save_args, 8))
            JSBridge__Push(hop_obj)
            hop_key_str = JSRT_ToString(hop_key_val)
            hop_obj = JSBridge__Pop()
            hop_key_ptr = JSRT_GetPayload(hop_key_str)
            hop_has = JSRT_ObjHas(hop_obj, hop_key_ptr)
            ReturnValue(JSRT_CreateBool(hop_has))
        }

        // ─── ARR_IS_ARRAY (55) ───
        IfCondition EqualTo(save_id, JSNativeID.ARR_IS_ARRAY) ThenBlock: {
