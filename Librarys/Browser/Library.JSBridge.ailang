        IfCondition EqualTo(JSRT_GetType(target), JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(target)
            slen = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { slen = JSRT_StrLen(sp) }
            // "length" — name_ptr is property key (C or UTF-16 via StrEq)
            is_len = 0
            IfCondition EqualTo(JSRT_StrEq(name_ptr, "length"), 1) ThenBlock: { is_len = 1 }
            IfCondition EqualTo(is_len, 1) ThenBlock: {
                desc = JSBridge__CreateUserObject()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "value", JSRT_CreateNumber(slen))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "writable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "enumerable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "configurable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                ReturnValue(desc)
            }
            // integer index in range → single code unit string (M31a: StrUnit keys)
            is_idx = 1
            idxn = 0
            bi = 0
            nlen_key = JSRT_StrLen(name_ptr)
            IfCondition EqualTo(nlen_key, 0) ThenBlock: { is_idx = 0 }
            WhileLoop EqualTo(is_idx, 1) {
                IfCondition GreaterEqual(bi, nlen_key) ThenBlock: {
                    IfCondition EqualTo(bi, 0) ThenBlock: { is_idx = 0 }
                    IfCondition GreaterThan(bi, 0) ThenBlock: { is_idx = 2 }
                } ElseBlock: {
                    ch = JSRT_StrUnit(name_ptr, bi)
                    IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                        is_idx = 0
                    } ElseBlock: {
                        idxn = Add(Multiply(idxn, 10), Subtract(ch, 48))
                        bi = Add(bi, 1)
                        IfCondition GreaterThan(bi, 10) ThenBlock: { is_idx = 0 }
                    }
                }
            }
            IfCondition EqualTo(is_idx, 2) ThenBlock: {
                IfCondition And(GreaterEqual(idxn, 0), LessThan(idxn, slen)) ThenBlock: {
                    // one code unit (M31a UTF-16)
                    chv = JSRT_CreateStringSlice(sp, idxn, 1)
                    desc = JSBridge__CreateUserObject()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "value", chv)
                    desc = JSBridge__Pop()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "writable", JSRT_CreateBool(0))
                    desc = JSBridge__Pop()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "enumerable", JSRT_CreateBool(1))
                    desc = JSBridge__Pop()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "configurable", JSRT_CreateBool(0))
                    desc = JSBridge__Pop()
                    ReturnValue(desc)
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // M26k.10: mangled private #name@id only
        IfCondition NotEqual(name_ptr, 0) ThenBlock: {
            IfCondition EqualTo(GetByte(name_ptr, 0), 35) ThenBlock: {
                _mp_has_at = 0
                _mp_i = 1
                WhileLoop LessThan(_mp_i, 256) {
                    _mp_b = GetByte(name_ptr, _mp_i)
                    IfCondition EqualTo(_mp_b, 0) ThenBlock: { _mp_i = 256 }
                    IfCondition EqualTo(_mp_b, 64) ThenBlock: {
                        _mp_has_at = 1
                        _mp_i = 256
                    }
                    IfCondition And(NotEqual(_mp_b, 0), NotEqual(_mp_b, 64)) ThenBlock: {
                        _mp_i = Add(_mp_i, 1)
                    }
                }
                IfCondition EqualTo(_mp_has_at, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
            }
        }

        // FUNCTION name/length: fixed attributes w=false e=false c=true (bits=4)
        // M31c: keys may be UTF-16 JS strings — use StrEq not GetByte
        IfCondition EqualTo(JSRT_GetType(target), JSType.FUNCTION) ThenBlock: {
            is_nl = 0
            IfCondition EqualTo(JSRT_StrEq(name_ptr, "name"), 1) ThenBlock: { is_nl = 1 }
            IfCondition EqualTo(JSRT_StrEq(name_ptr, "length"), 1) ThenBlock: { is_nl = 1 }
            IfCondition EqualTo(is_nl, 1) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                val = JSRT_ObjGet(target, name_ptr)
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
                desc = JSBridge__CreateUserObject()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "value", val)
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "writable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "enumerable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "configurable", JSRT_CreateBool(1))
                desc = JSBridge__Pop()
                ReturnValue(desc)
            }
            // M26i: function.prototype — class: w=f e=f c=f; ordinary: w=t e=f c=f
            is_proto_key = 0
            IfCondition EqualTo(JSRT_StrEq(name_ptr, "prototype"), 1) ThenBlock: {
                is_proto_key = 1
            }
            IfCondition EqualTo(is_proto_key, 1) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                val = JSRT_ObjGet(target, name_ptr)
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
                // Class constructors (fdesc+88 != 0): non-writable prototype
                proto_w = 1
                fdesc_p = Dereference(Add(target, 8))
                IfCondition NotEqual(fdesc_p, 0) ThenBlock: {
                    IfCondition NotEqual(Dereference(Add(fdesc_p, 88)), 0) ThenBlock: {
                        proto_w = 0
                    }
                }
                desc = JSBridge__CreateUserObject()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "value", val)
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "writable", JSRT_CreateBool(proto_w))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "enumerable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "configurable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                ReturnValue(desc)
            }
        }

        // M29e: Array exotic length — {writable:true, enumerable:false, configurable:false}
        IfCondition EqualTo(JSRT_GetType(target), JSType.ARRAY) ThenBlock: {
            is_alen = 0
            IfCondition EqualTo(JSRT_StrEq(name_ptr, "length"), 1) ThenBlock: { is_alen = 1 }
            IfCondition EqualTo(is_alen, 1) ThenBlock: {
                alen = JSRT_ArrLen(target)
                desc = JSBridge__CreateUserObject()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "value", JSRT_CreateNumber(alen))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "writable", JSRT_CreateBool(1))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "enumerable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "configurable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                ReturnValue(desc)
            }
            // Array index own props: gOPD via side path if needed falls through
        }

        // M26i/k.11: accessor descriptor only for OWN __get_/__set_
        // gOPD must not walk proto — own data field shadows inherited setter
        // M31c: build __get_/__set_ keys with UTF-16-aware unit copy
        nlen_key = JSRT_StrLen(name_ptr)
        gk_len = Add(nlen_key, 7)
        gk = JSRT__StrSlabAlloc(Add(gk_len, 1))
        sk = JSRT__StrSlabAlloc(Add(gk_len, 1))
        IfCondition And(NotEqual(gk, 0), NotEqual(sk, 0)) ThenBlock: {
            SetByte(gk, 0, 95)
            SetByte(gk, 1, 95)
            SetByte(gk, 2, 103)
            SetByte(gk, 3, 101)
            SetByte(gk, 4, 116)
            SetByte(gk, 5, 95)
            // C-style __get_ + Latin-1 name units for PropTable C keys
            gi = 0
            WhileLoop LessThan(gi, nlen_key) {
                u = JSRT_StrUnit(name_ptr, gi)
                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                SetByte(gk, Add(6, gi), u)
                gi = Add(gi, 1)
            }
            SetByte(gk, Add(6, nlen_key), 0)
            SetByte(sk, 0, 95)
            SetByte(sk, 1, 95)
            SetByte(sk, 2, 115)
            SetByte(sk, 3, 101)
            SetByte(sk, 4, 116)
            SetByte(sk, 5, 95)
            gi = 0
            WhileLoop LessThan(gi, nlen_key) {
                u = JSRT_StrUnit(name_ptr, gi)
                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                SetByte(sk, Add(6, gi), u)
                gi = Add(gi, 1)
            }
            SetByte(sk, Add(6, nlen_key), 0)
            gfn = 0
            sfn = 0
            JSBridge__Push(target)
            JSBridge__Push(name_ptr)
            JSBridge__Push(sk)
            JSBridge__Push(gk)
            has_g = JSRT_ObjHas(target, gk)
            gk = JSBridge__Pop()
            sk = JSBridge__Pop()
            name_ptr = JSBridge__Pop()
            target = JSBridge__Pop()
            IfCondition EqualTo(has_g, 1) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                JSBridge__Push(sk)
                gfn = JSRT_ObjGet(target, gk)
                sk = JSBridge__Pop()
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
            }
            JSBridge__Push(target)
            JSBridge__Push(name_ptr)
            JSBridge__Push(gfn)
            JSBridge__Push(sk)
            has_s = JSRT_ObjHas(target, sk)
            sk = JSBridge__Pop()
            gfn = JSBridge__Pop()
            name_ptr = JSBridge__Pop()
            target = JSBridge__Pop()
            IfCondition EqualTo(has_s, 1) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                JSBridge__Push(gfn)
                sfn = JSRT_ObjGet(target, sk)
                gfn = JSBridge__Pop()
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
            }
            has_acc = 0
            IfCondition EqualTo(JSRT_GetType(gfn), JSType.FUNCTION) ThenBlock: { has_acc = 1 }
            IfCondition EqualTo(JSRT_GetType(sfn), JSType.FUNCTION) ThenBlock: { has_acc = 1 }
            IfCondition EqualTo(has_acc, 1) ThenBlock: {
                // M33: read real E/C attr bits (was hardcoding e=false c=true)
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                JSBridge__Push(gfn)
                JSBridge__Push(sfn)
                bits_acc = JSBridge__GetAttrBits(target, name_ptr)
                sfn = JSBridge__Pop()
                gfn = JSBridge__Pop()
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
                desc = JSBridge__CreateUserObject()
                IfCondition EqualTo(JSRT_GetType(gfn), JSType.FUNCTION) ThenBlock: {
                    JSBridge__Push(desc)
                    JSBridge__Push(sfn)
                    JSBridge__Push(bits_acc)
                    JSRT_ObjSet(desc, "get", gfn)
                    bits_acc = JSBridge__Pop()
                    sfn = JSBridge__Pop()
                    desc = JSBridge__Pop()
                } ElseBlock: {
                    // get: undefined when setter-only (own get key absent or non-function)
                    JSBridge__Push(desc)
                    JSBridge__Push(sfn)
                    JSBridge__Push(bits_acc)
                    JSRT_ObjSet(desc, "get", JSRT_Undefined())
                    bits_acc = JSBridge__Pop()
                    sfn = JSBridge__Pop()
                    desc = JSBridge__Pop()
                }
                IfCondition EqualTo(JSRT_GetType(sfn), JSType.FUNCTION) ThenBlock: {
                    JSBridge__Push(desc)
                    JSBridge__Push(bits_acc)
                    JSRT_ObjSet(desc, "set", sfn)
                    bits_acc = JSBridge__Pop()
                    desc = JSBridge__Pop()
                } ElseBlock: {
                    JSBridge__Push(desc)
                    JSBridge__Push(bits_acc)
                    JSRT_ObjSet(desc, "set", JSRT_Undefined())
                    bits_acc = JSBridge__Pop()
                    desc = JSBridge__Pop()
                }
                JSBridge__Push(desc)
                JSBridge__Push(bits_acc)
                IfCondition NotEqual(BitwiseAnd(bits_acc, JSAttr.E), 0) ThenBlock: {
                    et = JSRT_CreateBool(1)
                } ElseBlock: {
                    et = JSRT_CreateBool(0)
                }
                bits_acc = JSBridge__Pop()
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSBridge__Push(bits_acc)
                JSRT_ObjSet(desc, "enumerable", et)
                bits_acc = JSBridge__Pop()
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSBridge__Push(bits_acc)
                IfCondition NotEqual(BitwiseAnd(bits_acc, JSAttr.C), 0) ThenBlock: {
                    ct = JSRT_CreateBool(1)
                } ElseBlock: {
                    ct = JSRT_CreateBool(0)
                }
                bits_acc = JSBridge__Pop()
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "configurable", ct)
                desc = JSBridge__Pop()
                ReturnValue(desc)
            }
        }

        // Check if property exists
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        exists = JSRT_ObjHas(target, name_ptr)
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(exists, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Get value
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        val = JSRT_ObjGet(target, name_ptr)
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // Attribute bits
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(val)
        bits = JSBridge__GetAttrBits(target, name_ptr)
        val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // Build descriptor object
        JSBridge__Push(val)
        JSBridge__Push(bits)
        desc = JSBridge__CreateUserObject()
        bits = JSBridge__Pop()
        val = JSBridge__Pop()

        JSBridge__Push(desc)
        JSBridge__Push(bits)
        JSRT_ObjSet(desc, "value", val)
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        JSBridge__Push(bits)
        IfCondition NotEqual(BitwiseAnd(bits, JSAttr.W), 0) ThenBlock: {
            wt = JSRT_CreateBool(1)
        } ElseBlock: {
            wt = JSRT_CreateBool(0)
        }
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSBridge__Push(bits)
        JSRT_ObjSet(desc, "writable", wt)
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        JSBridge__Push(bits)
        IfCondition NotEqual(BitwiseAnd(bits, JSAttr.E), 0) ThenBlock: {
            et = JSRT_CreateBool(1)
        } ElseBlock: {
            et = JSRT_CreateBool(0)
        }
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSBridge__Push(bits)
        JSRT_ObjSet(desc, "enumerable", et)
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        JSBridge__Push(bits)
        IfCondition NotEqual(BitwiseAnd(bits, JSAttr.C), 0) ThenBlock: {
            ct = JSRT_CreateBool(1)
        } ElseBlock: {
            ct = JSRT_CreateBool(0)
        }
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSRT_ObjSet(desc, "configurable", ct)
        desc = JSBridge__Pop()

        ReturnValue(desc)
    }
}

// Object.setPrototypeOf(obj, proto) — set [[Prototype]], return obj
// M68: unlocks object-literal super / method.js / getter-super-prop
Function.JSBridge__NSetProtoOf {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        IfCondition LessThan(argc, 2) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.setPrototypeOf requires 2 arguments")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        target = Dereference(save_args)
        proto = Dereference(Add(save_args, 8))
        tt = JSRT_GetType(target)
        // null/undefined → TypeError
        IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.setPrototypeOf called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        // proto must be Object, null, Function, or Array
        pt = JSRT_GetType(proto)
        ok_proto = 0
        IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: { ok_proto = 1 }
        IfCondition EqualTo(pt, JSType.NULL) ThenBlock: { ok_proto = 1 }
        IfCondition EqualTo(pt, JSType.FUNCTION) ThenBlock: { ok_proto = 1 }
        IfCondition EqualTo(pt, JSType.ARRAY) ThenBlock: { ok_proto = 1 }
        IfCondition EqualTo(ok_proto, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object prototype may only be an Object or null")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        // Set [[Prototype]] via __proto__ slot
        JSRT_ObjSet(target, "__proto__", proto)
        ReturnValue(target)
    }
}

// Object.getPrototypeOf(obj) — return [[Prototype]]
// M26i: FUNCTION without own __proto__ → Function.prototype (not null).
Function.JSBridge__NGetProtoOf {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_Null())
        }
        target = Dereference(save_args)
        tt = JSRT_GetType(target)
        // FUNCTION: own __proto__ (class extends) or Function.prototype
        IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: {
            fdesc = Dereference(Add(target, 8))
            IfCondition NotEqual(fdesc, 0) ThenBlock: {
                pt = Dereference(Add(fdesc, 64))
                IfCondition NotEqual(pt, 0) ThenBlock: {
                    own_p = PropTable_Lookup(pt, "__proto__")
                    IfCondition NotEqual(own_p, -1) ThenBlock: {
                        ReturnValue(own_p)
                    }
                }
            }
            IfCondition NotEqual(JSRTState.function_proto, 0) ThenBlock: {
                ReturnValue(JSRTState.function_proto)
            }
            ReturnValue(JSRT_Null())
        }
        // ARRAY
        IfCondition EqualTo(tt, JSType.ARRAY) ThenBlock: {
            IfCondition NotEqual(JSRTState.array_proto, 0) ThenBlock: {
                // own __proto__ override?
                JSBridge__Push(target)
                own_a = JSRT_ObjGet(target, "__proto__")
                target = JSBridge__Pop()
                IfCondition EqualTo(JSRT_GetType(own_a), JSType.NULL) ThenBlock: {
                    ReturnValue(own_a)
                }
                IfCondition EqualTo(JSRT_GetType(own_a), JSType.OBJECT) ThenBlock: {
                    // Only if explicitly set (ObjGet may walk) — prefer array_proto when undef
                    IfCondition NotEqual(own_a, JSRTState.undef_val) ThenBlock: {
                        // If equal to default object chain from missing, use array_proto
                        ReturnValue(own_a)
                    }
                }
                ReturnValue(JSRTState.array_proto)
            }
        }
        JSBridge__Push(target)
        proto = JSRT_ObjGet(target, "__proto__")
        target = JSBridge__Pop()
        ReturnValue(proto)
    }
}

// Object.assign(target, ...sources) — copy own enumerable props
Function.JSBridge__NObjAssign {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(save_args)
        // ES: ToObject(target) — null/undefined TypeError
        tt = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        si = 1
        WhileLoop LessThan(si, save_argc) {
            src = Dereference(Add(save_args, Multiply(si, 8)))
            // null/undefined sources skipped
            IfCondition EqualTo(src, 0) ThenBlock: {
                si = Add(si, 1)
            } ElseBlock: {
                src_t = JSRT_GetType(src)
                IfCondition Or(EqualTo(src_t, JSType.NULL), EqualTo(src_t, JSType.UNDEFINED)) ThenBlock: {
                    si = Add(si, 1)
                } ElseBlock: {
                    // M34: objects, arrays, functions, strings (and other primitives via keys)
                    do_copy = 0
                    IfCondition EqualTo(src_t, JSType.OBJECT) ThenBlock: { do_copy = 1 }
                    IfCondition EqualTo(src_t, JSType.ARRAY) ThenBlock: { do_copy = 1 }
                    IfCondition EqualTo(src_t, JSType.FUNCTION) ThenBlock: { do_copy = 1 }
                    IfCondition EqualTo(src_t, JSType.STRING) ThenBlock: { do_copy = 1 }
                    IfCondition EqualTo(do_copy, 1) ThenBlock: {
                        JSBridge__Push(target)
                        JSBridge__Push(save_args)
                        JSBridge__Push(save_argc)
                        JSBridge__Push(si)
                        // String: synthetic index keys
                        IfCondition EqualTo(src_t, JSType.STRING) ThenBlock: {
                            sp = JSRT_GetPayload(src)
                            slen = 0
                            IfCondition NotEqual(sp, 0) ThenBlock: { slen = JSRT_StrLen(sp) }
                            ai = 0
                            WhileLoop LessThan(ai, slen) {
                                JSBridge__Push(target)
                                JSBridge__Push(save_args)
                                JSBridge__Push(save_argc)
                                JSBridge__Push(si)
                                JSBridge__Push(ai)
                                JSBridge__Push(sp)
                                JSBridge__Push(slen)
                                chv = JSRT_CreateStringSlice(sp, ai, 1)
                                kptr = JSRT__IntToStr(ai)
                                slen = JSBridge__Pop()
                                sp = JSBridge__Pop()
                                ai = JSBridge__Pop()
                                si = JSBridge__Pop()
                                save_argc = JSBridge__Pop()
                                save_args = JSBridge__Pop()
                                target = JSBridge__Pop()
                                JSBridge__Push(target)
                                JSBridge__Push(save_args)
                                JSBridge__Push(save_argc)
                                JSBridge__Push(si)
                                JSBridge__Push(ai)
                                JSBridge__Push(sp)
                                JSBridge__Push(slen)
                                JSRT_ObjSet(target, kptr, chv)
                                slen = JSBridge__Pop()
                                sp = JSBridge__Pop()
                                ai = JSBridge__Pop()
                                si = JSBridge__Pop()
                                save_argc = JSBridge__Pop()
                                save_args = JSBridge__Pop()
                                target = JSBridge__Pop()
                                ai = Add(ai, 1)
                            }
                        } ElseBlock: {
                            keys = JSRT_ObjKeys(src)
                            klen = JSRT_ArrLen(keys)
                            ki = 0
                            WhileLoop LessThan(ki, klen) {
                                JSBridge__Push(target)
                                JSBridge__Push(save_args)
                                JSBridge__Push(save_argc)
                                JSBridge__Push(si)
                                JSBridge__Push(keys)
                                JSBridge__Push(ki)
                                JSBridge__Push(klen)
                                ksv = JSRT_ArrGet(keys, ki)
                                kp = JSRT_GetPayload(ksv)
                                src2 = Dereference(Add(save_args, Multiply(si, 8)))
                                // Prefer ArrGet for array indices; M52: invoke __get_* accessors
                                v = JSRT_Undefined()
                                got_g = 0
                                IfCondition EqualTo(JSRT_GetType(src2), JSType.ARRAY) ThenBlock: {
                                    // try numeric
                                    is_idx = 1
                                    idxn = 0
                                    bi = 0
                                    nkey = JSRT_StrLen(kp)
                                    IfCondition EqualTo(nkey, 0) ThenBlock: { is_idx = 0 }
                                    WhileLoop EqualTo(is_idx, 1) {
                                        IfCondition GreaterEqual(bi, nkey) ThenBlock: {
                                            IfCondition EqualTo(bi, 0) ThenBlock: { is_idx = 0 }
                                            IfCondition GreaterThan(bi, 0) ThenBlock: { is_idx = 2 }
                                        } ElseBlock: {
                                            ch = JSRT_StrUnit(kp, bi)
                                            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                                                is_idx = 0
                                            } ElseBlock: {
                                                idxn = Add(Multiply(idxn, 10), Subtract(ch, 48))
                                                bi = Add(bi, 1)
                                                IfCondition GreaterThan(bi, 10) ThenBlock: { is_idx = 0 }
                                            }
                                        }
                                    }
                                    IfCondition EqualTo(is_idx, 2) ThenBlock: {
                                        v = JSRT_ArrGet(src2, idxn)
                                        got_g = 1
                                    }
                                }
                                IfCondition EqualTo(got_g, 0) ThenBlock: {
                                    // UTF-16-safe __get_<name> for defineProperty / lit getters
                                    nlen_as = JSRT_StrLen(kp)
                                    IfCondition LessThan(nlen_as, 100) ThenBlock: {
                                        gk_as = JSVMCallBuf.getter_buf
                                        SetByte(gk_as, 0, 95)
                                        SetByte(gk_as, 1, 95)
                                        SetByte(gk_as, 2, 103)
                                        SetByte(gk_as, 3, 101)
                                        SetByte(gk_as, 4, 116)
                                        SetByte(gk_as, 5, 95)
                                        gi_as = 0
                                        WhileLoop LessThan(gi_as, nlen_as) {
                                            u_as = JSRT_StrUnit(kp, gi_as)
                                            IfCondition GreaterThan(u_as, 255) ThenBlock: { u_as = 63 }
                                            SetByte(gk_as, Add(6, gi_as), u_as)
                                            gi_as = Add(gi_as, 1)
                                        }
                                        SetByte(gk_as, Add(6, nlen_as), 0)
                                        JSBridge__Push(target)
                                        JSBridge__Push(save_args)
                                        JSBridge__Push(save_argc)
                                        JSBridge__Push(si)
                                        JSBridge__Push(keys)
                                        JSBridge__Push(ki)
                                        JSBridge__Push(klen)
                                        JSBridge__Push(src2)
                                        gfn_as = JSRT_ObjGet(src2, gk_as)
                                        src2 = JSBridge__Pop()
                                        klen = JSBridge__Pop()
                                        ki = JSBridge__Pop()
                                        keys = JSBridge__Pop()
                                        si = JSBridge__Pop()
                                        save_argc = JSBridge__Pop()
                                        save_args = JSBridge__Pop()
                                        target = JSBridge__Pop()
                                        IfCondition EqualTo(JSRT_GetType(gfn_as), JSType.FUNCTION) ThenBlock: {
                                            save_this_as = JSVM__GetGlobal("this")
                                            JSVM__SetGlobal("this", src2)
                                            empty_as = JSVMCallBuf.buf
                                            JSBridge__Push(target)
                                            JSBridge__Push(save_args)
                                            JSBridge__Push(save_argc)
                                            JSBridge__Push(si)
                                            JSBridge__Push(keys)
                                            JSBridge__Push(ki)
                                            JSBridge__Push(klen)
                                            JSBridge__Push(src2)
                                            v = JSVM__CallFunc(gfn_as, empty_as, 0)
                                            src2 = JSBridge__Pop()
                                            klen = JSBridge__Pop()
                                            ki = JSBridge__Pop()
                                            keys = JSBridge__Pop()
                                            si = JSBridge__Pop()
                                            save_argc = JSBridge__Pop()
                                            save_args = JSBridge__Pop()
                                            target = JSBridge__Pop()
                                            JSVM__SetGlobal("this", save_this_as)
                                            got_g = 1
                                        }
                                    }
                                }
                                IfCondition EqualTo(got_g, 0) ThenBlock: {
                                    v = JSRT_ObjGet(src2, kp)
                                }
                                klen = JSBridge__Pop()
                                ki = JSBridge__Pop()
                                keys = JSBridge__Pop()
                                si = JSBridge__Pop()
                                save_argc = JSBridge__Pop()
                                save_args = JSBridge__Pop()
                                target = JSBridge__Pop()
                                JSBridge__Push(target)
                                JSBridge__Push(save_args)
                                JSBridge__Push(save_argc)
                                JSBridge__Push(si)
                                JSBridge__Push(keys)
                                JSBridge__Push(ki)
                                JSBridge__Push(klen)
                                JSRT_ObjSet(target, kp, v)
                                klen = JSBridge__Pop()
                                ki = JSBridge__Pop()
                                keys = JSBridge__Pop()
                                si = JSBridge__Pop()
                                save_argc = JSBridge__Pop()
                                save_args = JSBridge__Pop()
                                target = JSBridge__Pop()
                                ki = Add(ki, 1)
                            }
                        }
                        si = JSBridge__Pop()
                        save_argc = JSBridge__Pop()
                        save_args = JSBridge__Pop()
                        target = JSBridge__Pop()
                    }
                    si = Add(si, 1)
                }
            }
        }
        ReturnValue(target)
    }
}

// Object.entries(O) — M34: ToObject, enumerable own string keys → [[k,v],...]
Function.JSBridge__NObjEntries {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        result = JSRT_CreateArray()
        IfCondition LessThan(argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        obj = Dereference(args)
        ot = JSRT_GetType(obj)
        IfCondition Or(EqualTo(ot, JSType.NULL), EqualTo(ot, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        // String exotic: indices as entries
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(obj)
            slen = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { slen = JSRT_StrLen(sp) }
            ai = 0
            WhileLoop LessThan(ai, slen) {
                JSBridge__Push(result)
                JSBridge__Push(sp)
                JSBridge__Push(slen)
                JSBridge__Push(ai)
                chv = JSRT_CreateStringSlice(sp, ai, 1)
                ksv = JSRT_CreateString(JSRT__IntToStr(ai))
                pair = JSRT_CreateArray()
                JSRT_ArrPush(pair, ksv)
                JSRT_ArrPush(pair, chv)
                ai = JSBridge__Pop()
                slen = JSBridge__Pop()
                sp = JSBridge__Pop()
                result = JSBridge__Pop()
                JSBridge__Push(result)
                JSBridge__Push(sp)
                JSBridge__Push(slen)
                JSBridge__Push(ai)
                JSRT_ArrPush(result, pair)
                ai = JSBridge__Pop()
                slen = JSBridge__Pop()
                sp = JSBridge__Pop()
                result = JSBridge__Pop()
                ai = Add(ai, 1)
            }
            ReturnValue(result)
        }
        // Object / Array / Function — ObjKeys is enumerable own
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: {
                // other primitives → empty (boxed would have no enum own)
                ReturnValue(result)
            }
        }
        JSBridge__Push(result)
        keys = JSRT_ObjKeys(obj)
        result = JSBridge__Pop()
        // For arrays also emit dense indices (ObjKeys may miss pure element storage)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            alen = JSRT_ArrLen(obj)
            ai = 0
            WhileLoop LessThan(ai, alen) {
                IfCondition NotEqual(JSRT_ArrHas(obj, ai), 0) ThenBlock: {
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(keys)
                    JSBridge__Push(ai)
                    JSBridge__Push(alen)
                    ksv = JSRT_CreateString(JSRT__IntToStr(ai))
                    v = JSRT_ArrGet(obj, ai)
                    pair = JSRT_CreateArray()
                    JSRT_ArrPush(pair, ksv)
                    JSRT_ArrPush(pair, v)
                    alen = JSBridge__Pop()
                    ai = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(keys)
                    JSBridge__Push(ai)
                    JSBridge__Push(alen)
                    JSRT_ArrPush(result, pair)
                    alen = JSBridge__Pop()
                    ai = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                }
                ai = Add(ai, 1)
            }
            // named side props via keys (skip pure indices already emitted)
            klen = JSRT_ArrLen(keys)
            ki = 0
            WhileLoop LessThan(ki, klen) {
                JSBridge__Push(result)
                JSBridge__Push(obj)
                JSBridge__Push(keys)
                JSBridge__Push(ki)
                ksv = JSRT_ArrGet(keys, ki)
                kp = JSRT_GetPayload(ksv)
                // skip decimal indices
                is_idx = 1
                bi = 0
                nkey = JSRT_StrLen(kp)
                IfCondition EqualTo(nkey, 0) ThenBlock: { is_idx = 0 }
                WhileLoop EqualTo(is_idx, 1) {
                    IfCondition GreaterEqual(bi, nkey) ThenBlock: {
                        IfCondition EqualTo(bi, 0) ThenBlock: { is_idx = 0 }
                        IfCondition GreaterThan(bi, 0) ThenBlock: { is_idx = 2 }
                    } ElseBlock: {
                        ch = JSRT_StrUnit(kp, bi)
                        IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                            is_idx = 0
                        } ElseBlock: {
                            bi = Add(bi, 1)
                            IfCondition GreaterThan(bi, 10) ThenBlock: { is_idx = 0 }
                        }
                    }
                }
                IfCondition NotEqual(is_idx, 2) ThenBlock: {
                    v = JSRT_ObjGet(obj, kp)
                    pair = JSRT_CreateArray()
                    JSRT_ArrPush(pair, ksv)
                    JSRT_ArrPush(pair, v)
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(keys)
                    JSBridge__Push(ki)
                    JSRT_ArrPush(result, pair)
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                } ElseBlock: {
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                }
                ki = Add(ki, 1)
            }
            ReturnValue(result)
        }
        klen = JSRT_ArrLen(keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            JSBridge__Push(result)
            JSBridge__Push(obj)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            ksv = JSRT_ArrGet(keys, ki)
            kp = JSRT_GetPayload(ksv)
            v = JSRT_ObjGet(obj, kp)
            pair = JSRT_CreateArray()
            JSRT_ArrPush(pair, ksv)
            JSRT_ArrPush(pair, v)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            obj = JSBridge__Pop()
            result = JSBridge__Pop()
            JSBridge__Push(result)
            JSBridge__Push(obj)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            JSRT_ArrPush(result, pair)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            obj = JSBridge__Pop()
            result = JSBridge__Pop()
            ki = Add(ki, 1)
        }
        ReturnValue(result)
    }
}

// Object.values(O)
Function.JSBridge__NObjValues {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        // Reuse entries then project — simpler consistency
        // Direct path for speed
        result = JSRT_CreateArray()
        IfCondition LessThan(argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        obj = Dereference(args)
        ot = JSRT_GetType(obj)
        IfCondition Or(EqualTo(ot, JSType.NULL), EqualTo(ot, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(obj)
            slen = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { slen = JSRT_StrLen(sp) }
            ai = 0
            WhileLoop LessThan(ai, slen) {
                JSBridge__Push(result)
                JSBridge__Push(sp)
                JSBridge__Push(slen)
                JSBridge__Push(ai)
                chv = JSRT_CreateStringSlice(sp, ai, 1)
                ai = JSBridge__Pop()
                slen = JSBridge__Pop()
                sp = JSBridge__Pop()
                result = JSBridge__Pop()
                JSBridge__Push(result)
                JSBridge__Push(sp)
                JSBridge__Push(slen)
                JSBridge__Push(ai)
                JSRT_ArrPush(result, chv)
                ai = JSBridge__Pop()
                slen = JSBridge__Pop()
                sp = JSBridge__Pop()
                result = JSBridge__Pop()
                ai = Add(ai, 1)
            }
            ReturnValue(result)
        }
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            alen = JSRT_ArrLen(obj)
            ai = 0
            WhileLoop LessThan(ai, alen) {
                IfCondition NotEqual(JSRT_ArrHas(obj, ai), 0) ThenBlock: {
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(ai)
                    JSBridge__Push(alen)
                    v = JSRT_ArrGet(obj, ai)
                    alen = JSBridge__Pop()
                    ai = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(ai)
                    JSBridge__Push(alen)
                    JSRT_ArrPush(result, v)
                    alen = JSBridge__Pop()
                    ai = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                }
                ai = Add(ai, 1)
            }
            JSBridge__Push(result)
            JSBridge__Push(obj)
            keys = JSRT_ObjKeys(obj)
            obj = JSBridge__Pop()
            result = JSBridge__Pop()
            klen = JSRT_ArrLen(keys)
            ki = 0
            WhileLoop LessThan(ki, klen) {
                JSBridge__Push(result)
                JSBridge__Push(obj)
                JSBridge__Push(keys)
                JSBridge__Push(ki)
                ksv = JSRT_ArrGet(keys, ki)
                kp = JSRT_GetPayload(ksv)
                is_idx = 1
                bi = 0
                nkey = JSRT_StrLen(kp)
                IfCondition EqualTo(nkey, 0) ThenBlock: { is_idx = 0 }
                WhileLoop EqualTo(is_idx, 1) {
                    IfCondition GreaterEqual(bi, nkey) ThenBlock: {
                        IfCondition EqualTo(bi, 0) ThenBlock: { is_idx = 0 }
                        IfCondition GreaterThan(bi, 0) ThenBlock: { is_idx = 2 }
                    } ElseBlock: {
                        ch = JSRT_StrUnit(kp, bi)
                        IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                            is_idx = 0
                        } ElseBlock: {
                            bi = Add(bi, 1)
                            IfCondition GreaterThan(bi, 10) ThenBlock: { is_idx = 0 }
                        }
                    }
                }
                IfCondition NotEqual(is_idx, 2) ThenBlock: {
                    v = JSRT_ObjGet(obj, kp)
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(keys)
                    JSBridge__Push(ki)
                    JSRT_ArrPush(result, v)
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                } ElseBlock: {
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                }
                ki = Add(ki, 1)
            }
            ReturnValue(result)
        }
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            ReturnValue(result)
        }
        JSBridge__Push(result)
        keys = JSRT_ObjKeys(obj)
        result = JSBridge__Pop()
        klen = JSRT_ArrLen(keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            JSBridge__Push(result)
            JSBridge__Push(obj)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            ksv = JSRT_ArrGet(keys, ki)
            kp = JSRT_GetPayload(ksv)
            v = JSRT_ObjGet(obj, kp)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            obj = JSBridge__Pop()
            result = JSBridge__Pop()
            JSBridge__Push(result)
            JSBridge__Push(obj)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            JSRT_ArrPush(result, v)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            obj = JSBridge__Pop()
            result = JSBridge__Pop()
            ki = Add(ki, 1)
        }
        ReturnValue(result)
    }
}

// Object.fromEntries(iterable) — M34: array of [k,v] pairs → object
Function.JSBridge__NObjFromEntries {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        out = JSRT_CreateObject()
        IfCondition LessThan(argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.fromEntries requires an argument")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(out)
        }
        src = Dereference(args)
        st = JSRT_GetType(src)
        // Expand non-array iterables once
        IfCondition NotEqual(st, JSType.ARRAY) ThenBlock: {
            JSBridge__Push(out)
            expanded = JSVM_IterableToArray(src)
            out = JSBridge__Pop()
            IfCondition EqualTo(expanded, 0) ThenBlock: {
                ReturnValue(out)
            }
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(out)
            }
            src = expanded
            st = JSType.ARRAY
        }
        n = JSRT_ArrLen(src)
        i = 0
        WhileLoop LessThan(i, n) {
            JSBridge__Push(out)
            JSBridge__Push(src)
            JSBridge__Push(i)
            JSBridge__Push(n)
            entry = JSRT_ArrGet(src, i)
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            src = JSBridge__Pop()
            out = JSBridge__Pop()
            et = JSRT_GetType(entry)
            k = JSRT_Undefined()
            v = JSRT_Undefined()
            ok_entry = 0
            IfCondition EqualTo(et, JSType.ARRAY) ThenBlock: {
                JSBridge__Push(out)
                JSBridge__Push(src)
                JSBridge__Push(i)
                JSBridge__Push(n)
                k = JSRT_ArrGet(entry, 0)
                v = JSRT_ArrGet(entry, 1)
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                src = JSBridge__Pop()
                out = JSBridge__Pop()
                ok_entry = 1
            }
            IfCondition EqualTo(et, JSType.OBJECT) ThenBlock: {
                JSBridge__Push(out)
                JSBridge__Push(src)
                JSBridge__Push(i)
                JSBridge__Push(n)
                JSBridge__Push(entry)
                k = JSRT_ObjGet(entry, "0")
                v = JSRT_ObjGet(entry, "1")
                entry = JSBridge__Pop()
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                src = JSBridge__Pop()
                out = JSBridge__Pop()
                ok_entry = 1
            }
            IfCondition EqualTo(ok_entry, 0) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Iterator value is not an entry object")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(out)
            }
            JSBridge__Push(out)
            JSBridge__Push(src)
            JSBridge__Push(i)
            JSBridge__Push(n)
            JSBridge__Push(v)
            kptr = JSVM_ToPropertyKey(k)
            v = JSBridge__Pop()
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            src = JSBridge__Pop()
            out = JSBridge__Pop()
            IfCondition NotEqual(kptr, 0) ThenBlock: {
                JSBridge__Push(out)
                JSBridge__Push(src)
                JSBridge__Push(i)
                JSBridge__Push(n)
                JSRT_ObjSet(out, kptr, v)
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                src = JSBridge__Pop()
                out = JSBridge__Pop()
            }
            i = Add(i, 1)
        }
        ReturnValue(out)
    }
}

// M35: Boolean/Number/String wrapper valueOf — read [[PrimitiveValue]] (__value__)
// kind: 0=Boolean, 1=Number, 2=String
Function.JSBridge__NWrapperValueOf {
    Input: args: Address
    Input: argc: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        this_v = JSVM__GetGlobal("this")
        tt = JSRT_GetType(this_v)
        // bare primitive this
        IfCondition EqualTo(kind, 0) ThenBlock: {
            IfCondition EqualTo(tt, JSType.BOOLEAN) ThenBlock: { ReturnValue(this_v) }
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            IfCondition EqualTo(tt, JSType.NUMBER) ThenBlock: { ReturnValue(this_v) }
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            IfCondition EqualTo(tt, JSType.STRING) ThenBlock: { ReturnValue(this_v) }
        }
        IfCondition EqualTo(tt, JSType.OBJECT) ThenBlock: {
            JSBridge__Push(this_v)
            prim = JSRT_ObjGet(this_v, "__value__")
            this_v = JSBridge__Pop()
            pt = JSRT_GetType(prim)
            IfCondition EqualTo(kind, 0) ThenBlock: {
                IfCondition EqualTo(pt, JSType.BOOLEAN) ThenBlock: { ReturnValue(prim) }
            }
            IfCondition EqualTo(kind, 1) ThenBlock: {
                IfCondition EqualTo(pt, JSType.NUMBER) ThenBlock: { ReturnValue(prim) }
            }
            IfCondition EqualTo(kind, 2) ThenBlock: {
                IfCondition EqualTo(pt, JSType.STRING) ThenBlock: { ReturnValue(prim) }
            }
        }
        terr = JSVM_CreateTypedError("TypeError", "valueOf called on incompatible receiver")
        JSVM__SetGlobal("__pend_exc__", terr)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = terr
        JSVM_ThrowValue(terr)
        ReturnValue(JSRT_Undefined())
    }
}

// M35: wrapper toString — Boolean "true"/"false", Number decimal, String content
Function.JSBridge__NWrapperToString {
    Input: args: Address
    Input: argc: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        // valueOf first then ToString
        vv = JSBridge__NWrapperValueOf(args, argc, kind)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(JSRT_ToString(vv))
    }
}

// Object.prototype.toString — M34/M45: @@toStringTag then builtin brand
Function.JSBridge__NObjProtoToString {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        // this value
        this_v = JSVM__GetGlobal("this")
        tt = JSRT_GetType(this_v)
        // ES: undefined/null before ToObject
        IfCondition EqualTo(tt, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Undefined]"))
        }
        IfCondition EqualTo(tt, JSType.NULL) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Null]"))
        }
        // M45: @@toStringTag preferred for objects/arrays/functions/boxes
        IfCondition NotEqual(JSVMSymbol.toStringTag, 0) ThenBlock: {
            is_objish = 0
            IfCondition Or(Or(EqualTo(tt, JSType.OBJECT), EqualTo(tt, JSType.ARRAY)), EqualTo(tt, JSType.FUNCTION)) ThenBlock: {
                is_objish = 1
            }
            IfCondition EqualTo(is_objish, 1) ThenBlock: {
                JSBridge__Push(this_v)
                ttag_k = JSVM_SymbolToKey(JSVMSymbol.toStringTag)
                this_v = JSBridge__Pop()
                IfCondition NotEqual(ttag_k, 0) ThenBlock: {
                    JSBridge__Push(this_v)
                    ttag_v = JSRT_ObjGet(this_v, ttag_k)
                    this_v = JSBridge__Pop()
                    IfCondition EqualTo(JSRT_GetType(ttag_v), JSType.STRING) ThenBlock: {
                        // Build "[object " + tag + "]"
                        tp = JSRT_GetPayload(ttag_v)
                        tlen = 0
                        IfCondition NotEqual(tp, 0) ThenBlock: { tlen = JSRT_StrLen(tp) }
                        // cap tag length
                        IfCondition GreaterThan(tlen, 64) ThenBlock: { tlen = 64 }
                        obuf = JSRT_StrAlloc(Add(9, tlen))
                        IfCondition NotEqual(obuf, 0) ThenBlock: {
                            // "[object "
                            JSRT_StrSetUnit(obuf, 0, 91)
                            JSRT_StrSetUnit(obuf, 1, 111)
                            JSRT_StrSetUnit(obuf, 2, 98)
                            JSRT_StrSetUnit(obuf, 3, 106)
                            JSRT_StrSetUnit(obuf, 4, 101)
                            JSRT_StrSetUnit(obuf, 5, 99)
                            JSRT_StrSetUnit(obuf, 6, 116)
                            JSRT_StrSetUnit(obuf, 7, 32)
                            ti = 0
                            WhileLoop LessThan(ti, tlen) {
                                JSRT_StrSetUnit(obuf, Add(8, ti), JSRT_StrUnit(tp, ti))
                                ti = Add(ti, 1)
                            }
                            JSRT_StrSetUnit(obuf, Add(8, tlen), 93)
                            val = JSRT__AllocValue()
                            IfCondition NotEqual(val, 0) ThenBlock: {
                                StoreValue(val, JSType.STRING)
                                StoreValue(Add(val, 8), obuf)
                                ReturnValue(val)
                            }
                        }
                    }
                }
            }
        }
        // Builtin brands
        IfCondition EqualTo(tt, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Array]"))
        }
        IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Function]"))
        }
        IfCondition EqualTo(tt, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object String]"))
        }
        IfCondition EqualTo(tt, JSType.NUMBER) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Number]"))
        }
        IfCondition EqualTo(tt, JSType.BOOLEAN) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Boolean]"))
        }
        // Symbol if present as type — else object brand
        IfCondition EqualTo(tt, JSType.OBJECT) ThenBlock: {
            // Arguments exotic
            IfCondition EqualTo(JSVM_IsArgumentsObj(this_v), 1) ThenBlock: {
                ReturnValue(JSRT_CreateString("[object Arguments]"))
            }
            // __class__ brand (Math, JSON, Date, RegExp, Promise, String box, …)
            JSBridge__Push(this_v)
            cls = JSRT_ObjGet(this_v, "__class__")
            this_v = JSBridge__Pop()
            IfCondition EqualTo(JSRT_GetType(cls), JSType.STRING) ThenBlock: {
                cp = JSRT_GetPayload(cls)
                // Build "[object " + class + "]"
                // Use known short brands via StrEq
                IfCondition EqualTo(JSRT_StrEq(cp, "Math"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Math]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "JSON"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object JSON]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Date"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Date]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "RegExp"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object RegExp]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Promise"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Promise]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "String"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object String]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Number"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Number]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Boolean"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Boolean]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Error"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Error]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Array"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Array]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Function"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Function]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Arguments"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Arguments]"))
                }
            }
            // RegExp via handle
            JSBridge__Push(this_v)
            rh = JSRT_ObjGet(this_v, "__regex_handle__")
            this_v = JSBridge__Pop()
            IfCondition EqualTo(JSRT_GetType(rh), JSType.NUMBER) ThenBlock: {
                ReturnValue(JSRT_CreateString("[object RegExp]"))
            }
            // Error: name property common brands
            JSBridge__Push(this_v)
            nm = JSRT_ObjGet(this_v, "name")
            this_v = JSBridge__Pop()
            IfCondition EqualTo(JSRT_GetType(nm), JSType.STRING) ThenBlock: {
                np = JSRT_GetPayload(nm)
                IfCondition EqualTo(JSRT_StrEq(np, "Error"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Error]"))
                }
                IfCondition EqualTo(JSRT_StrEq(np, "TypeError"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Error]"))
                }
                IfCondition EqualTo(JSRT_StrEq(np, "RangeError"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Error]"))
                }
                IfCondition EqualTo(JSRT_StrEq(np, "ReferenceError"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Error]"))
                }
                IfCondition EqualTo(JSRT_StrEq(np, "SyntaxError"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Error]"))
                }
                IfCondition EqualTo(JSRT_StrEq(np, "URIError"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Error]"))
                }
                IfCondition EqualTo(JSRT_StrEq(np, "EvalError"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Error]"))
                }
            }
        }
        ReturnValue(JSRT_CreateString("[object Object]"))
    }
}

// Object.freeze(obj) — non-extensible + all own props non-writable non-configurable
Function.JSBridge__NObjFreeze {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(args)
        ot = JSRT_GetType(target)
        // M27b: also freeze functions/arrays (primitives returned as-is)
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: {
                ReturnValue(target)
            }
        }

        // Mark frozen + non-extensible
        JSBridge__Push(target)
        fv = JSRT_CreateBool(1)
        target = JSBridge__Pop()
        JSRT_ObjSet(target, "__frozen__", fv)
        JSBridge__Push(target)
        ex = JSRT_CreateBool(0)
        target = JSBridge__Pop()
        JSRT_ObjSet(target, "__extensible__", ex)

        // Clear W and C on all own user keys
        JSBridge__Push(target)
        keys = JSRT_ObjKeys(target)
        target = JSBridge__Pop()
        klen = JSRT_ArrLen(keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            JSBridge__Push(target)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            ksv = JSRT_ArrGet(keys, ki)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            target = JSBridge__Pop()
            kp = JSRT_GetPayload(ksv)
            JSBridge__Push(target)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            bits = JSBridge__GetAttrBits(target, kp)
            // keep E only (bit 2) — clear W and C → bits & 2
            bits = BitwiseAnd(bits, JSAttr.E)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            target = JSBridge__Pop()
            JSBridge__SetAttrBits(target, kp, bits)
            ki = Add(ki, 1)
        }
        ReturnValue(target)
    }
}

// Object.preventExtensions(obj) — mark non-extensible
Function.JSBridge__NObjPreventExt {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(args)
        ot = JSRT_GetType(target)
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: {
                ReturnValue(target)
            }
        }
        JSBridge__Push(target)
        ex = JSRT_CreateBool(0)
        target = JSBridge__Pop()
        JSRT_ObjSet(target, "__extensible__", ex)
        ReturnValue(target)
    }
}

// Object.isExtensible(obj)
Function.JSBridge__NObjIsExtensible {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        target = Dereference(args)
        ot = JSRT_GetType(target)
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
        }
        // Default extensible unless __extensible__ is false or frozen/sealed
        JSBridge__Push(target)
        fr = JSRT_ObjGet(target, "__frozen__")
        target = JSBridge__Pop()
        IfCondition EqualTo(JSRT_IsTruthy(fr), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSBridge__Push(target)
        se = JSRT_ObjGet(target, "__sealed__")
        target = JSBridge__Pop()
        IfCondition EqualTo(JSRT_IsTruthy(se), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSBridge__Push(target)
        ex = JSRT_ObjGet(target, "__extensible__")
        target = JSBridge__Pop()
        et = JSRT_GetType(ex)
        IfCondition EqualTo(et, JSType.BOOLEAN) ThenBlock: {
            IfCondition EqualTo(JSRT_IsTruthy(ex), 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
        }
        ReturnValue(JSRT_CreateBool(1))
    }
}

// Object.isFrozen(obj) — M27b
Function.JSBridge__NObjIsFrozen {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        target = Dereference(args)
        ot = JSRT_GetType(target)
        // Non-objects: ES returns true for primitives
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
        }
        JSBridge__Push(target)
        fr = JSRT_ObjGet(target, "__frozen__")
        target = JSBridge__Pop()
        IfCondition EqualTo(JSRT_IsTruthy(fr), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        // Must be non-extensible
        JSBridge__Push(target)
        ab = JSVMCallBuf.buf
        StoreValue(ab, target)
        extv = JSBridge__NObjIsExtensible(ab, 1)
        target = JSBridge__Pop()
        IfCondition EqualTo(JSRT_IsTruthy(extv), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        // All own enumerable keys: !writable and !configurable
        // (ObjKeys only enum; good enough for common freeze tests)
        JSBridge__Push(target)
        keys = JSRT_ObjKeys(target)
        target = JSBridge__Pop()
        klen = JSRT_ArrLen(keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            JSBridge__Push(target)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            ksv = JSRT_ArrGet(keys, ki)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            target = JSBridge__Pop()
            kp = JSRT_GetPayload(ksv)
            bits = JSBridge__GetAttrBits(target, kp)
            // if W or C set → not frozen
            IfCondition NotEqual(BitwiseAnd(bits, JSAttr.W), 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            IfCondition NotEqual(BitwiseAnd(bits, JSAttr.C), 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            ki = Add(ki, 1)
        }
        ReturnValue(JSRT_CreateBool(1))
    }
}

// Object.isSealed(obj) — M27b
Function.JSBridge__NObjIsSealed {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        target = Dereference(args)
        ot = JSRT_GetType(target)
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
        }
        JSBridge__Push(target)
        fr = JSRT_ObjGet(target, "__frozen__")
        target = JSBridge__Pop()
        IfCondition EqualTo(JSRT_IsTruthy(fr), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        JSBridge__Push(target)
        se = JSRT_ObjGet(target, "__sealed__")
        target = JSBridge__Pop()
        IfCondition EqualTo(JSRT_IsTruthy(se), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        JSBridge__Push(target)
        ab = JSVMCallBuf.buf
        StoreValue(ab, target)
        extv = JSBridge__NObjIsExtensible(ab, 1)
        target = JSBridge__Pop()
        IfCondition EqualTo(JSRT_IsTruthy(extv), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSBridge__Push(target)
        keys = JSRT_ObjKeys(target)
        target = JSBridge__Pop()
        klen = JSRT_ArrLen(keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            JSBridge__Push(target)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            ksv = JSRT_ArrGet(keys, ki)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            target = JSBridge__Pop()
            kp = JSRT_GetPayload(ksv)
            bits = JSBridge__GetAttrBits(target, kp)
            IfCondition NotEqual(BitwiseAnd(bits, JSAttr.C), 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            ki = Add(ki, 1)
        }
        ReturnValue(JSRT_CreateBool(1))
    }
}

// Object.seal(obj) — non-extensible + all own props non-configurable
Function.JSBridge__NObjSeal {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(args)
        ot = JSRT_GetType(target)
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: {
                ReturnValue(target)
            }
        }

        JSBridge__Push(target)
        sv = JSRT_CreateBool(1)
        target = JSBridge__Pop()
        JSRT_ObjSet(target, "__sealed__", sv)
        JSBridge__Push(target)
        ex = JSRT_CreateBool(0)
        target = JSBridge__Pop()
        JSRT_ObjSet(target, "__extensible__", ex)

        JSBridge__Push(target)
        keys = JSRT_ObjKeys(target)
        target = JSBridge__Pop()
        klen = JSRT_ArrLen(keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            JSBridge__Push(target)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            ksv = JSRT_ArrGet(keys, ki)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            target = JSBridge__Pop()
            kp = JSRT_GetPayload(ksv)
            JSBridge__Push(target)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            bits = JSBridge__GetAttrBits(target, kp)
            // clear C only → bits & 3
            bits = BitwiseAnd(bits, 3)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            target = JSBridge__Pop()
            JSBridge__SetAttrBits(target, kp, bits)
            ki = Add(ki, 1)
        }
        ReturnValue(target)
    }
}

// Object.is(a, b) — strict equality (same as ===, except NaN===NaN and +0!==-0)
Function.JSBridge__NObjIs {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        IfCondition LessThan(argc, 2) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        a = Dereference(save_args)
        b = Dereference(Add(save_args, 8))
        at = Dereference(a)
        bt = Dereference(b)
        IfCondition NotEqual(at, bt) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        av = Dereference(Add(a, 8))
        bv = Dereference(Add(b, 8))
        IfCondition EqualTo(av, bv) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        // String comparison
        IfCondition EqualTo(at, JSType.STRING) ThenBlock: {
            JSBridge__Push(a)
            JSBridge__Push(b)
            cmp = StringCompare(av, bv)
            b = JSBridge__Pop()
            a = JSBridge__Pop()
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
        }
        ReturnValue(JSRT_CreateBool(0))
    }
}

// Array.of(...items) — M29h
Function.JSBridge__NArrOf {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        // Prefer Construct(this, [len]) when this is a constructor other than default
        this_c = JSVM__GetGlobal("this")
        use_custom = 0
        IfCondition EqualTo(JSRT_GetType(this_c), JSType.FUNCTION) ThenBlock: {
            // If this is Array ctor (has isArray native), still create plain array
            // Custom subclasses: Construct
            use_custom = 1
            // Detect default Array: env not special — always try Construct with length
            // For Array itself Construct(Array, [n]) works; simpler: always plain array
            // when this is Array-like with ARR_IS_ARRAY property
            has_ia = JSRT_ObjHas(this_c, "isArray")
            IfCondition EqualTo(has_ia, 1) ThenBlock: {
                use_custom = 0
            }
        }
        IfCondition EqualTo(use_custom, 1) ThenBlock: {
            StoreValue(JSVMCallBuf.buf, JSRT_CreateNumber(save_argc))
            arr = JSVM__Construct(this_c, JSVMCallBuf.buf, 1)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            // set indices
            i = 0
            WhileLoop LessThan(i, save_argc) {
                JSBridge__Push(arr)
                JSBridge__Push(save_args)
                JSBridge__Push(i)
                JSBridge__Push(save_argc)
                v = Dereference(Add(save_args, Multiply(i, 8)))
                save_argc = JSBridge__Pop()
                i = JSBridge__Pop()
                save_args = JSBridge__Pop()
                arr = JSBridge__Pop()
                IfCondition EqualTo(JSRT_GetType(arr), JSType.ARRAY) ThenBlock: {
                    JSRT_ArrSet(arr, i, v)
                } ElseBlock: {
                    kptr = JSRT__IntToStr(i)
                    JSRT_ObjSet(arr, kptr, v)
                }
                i = Add(i, 1)
            }
            // length
            IfCondition EqualTo(JSRT_GetType(arr), JSType.ARRAY) ThenBlock: {
                // ArrSet may have grown; ensure length
            } ElseBlock: {
                JSRT_ObjSet(arr, "length", JSRT_CreateNumber(save_argc))
            }
            ReturnValue(arr)
        }
        result = JSRT_CreateArray()
        i = 0
        WhileLoop LessThan(i, save_argc) {
            JSBridge__Push(result)
            JSBridge__Push(save_args)
            JSBridge__Push(i)
            JSBridge__Push(save_argc)
            v = Dereference(Add(save_args, Multiply(i, 8)))
            save_argc = JSBridge__Pop()
            i = JSBridge__Pop()
            save_args = JSBridge__Pop()
            result = JSBridge__Pop()
            JSRT_ArrPush(result, v)
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

// Array.isArray(val) — returns true if val is ARRAY type
Function.JSBridge__NArrIsArray {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        val = Dereference(args)
        vt = Dereference(val)
        IfCondition EqualTo(vt, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        ReturnValue(JSRT_CreateBool(0))
    }
}

// Array.from(arrayLike[, mapFn[, thisArg]]) — convert array-like or iterable to array
// M29f: objects with .length + optional mapFn
Function.JSBridge__NArrFrom {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        src = Dereference(save_args)
        st = JSRT_GetType(src)
        // optional mapFn
        map_fn = 0
        has_map = 0
        IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
            map_fn = Dereference(Add(save_args, 8))
            IfCondition EqualTo(JSRT_GetType(map_fn), JSType.FUNCTION) ThenBlock: {
                has_map = 1
            }
            IfCondition And(NotEqual(JSRT_GetType(map_fn), JSType.UNDEFINED), EqualTo(has_map, 0)) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Array.from mapfn is not a function")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_CreateArray())
            }
        }
        IfCondition GreaterEqual(save_argc, 3) ThenBlock: {
            IfCondition EqualTo(has_map, 1) ThenBlock: {
                this_arg = Dereference(Add(save_args, 16))
                JSVM__SetGlobal("this", this_arg)
            }
        }
        // If already an array, copy elements
        IfCondition EqualTo(st, JSType.ARRAY) ThenBlock: {
            JSBridge__Push(src)
            JSBridge__Push(map_fn)
            JSBridge__Push(has_map)
            result = JSRT_CreateArray()
            has_map = JSBridge__Pop()
            map_fn = JSBridge__Pop()
            src = JSBridge__Pop()
            slen = JSRT_ArrLen(src)
            ai = 0
            WhileLoop LessThan(ai, slen) {
                JSBridge__Push(src)
                JSBridge__Push(result)
                JSBridge__Push(ai)
                JSBridge__Push(slen)
                JSBridge__Push(map_fn)
                JSBridge__Push(has_map)
                elem = JSRT_ArrGet(src, ai)
                has_map = JSBridge__Pop()
                map_fn = JSBridge__Pop()
                slen = JSBridge__Pop()
                ai = JSBridge__Pop()
                result = JSBridge__Pop()
                src = JSBridge__Pop()
                IfCondition EqualTo(has_map, 1) ThenBlock: {
                    JSBridge__Push(src)
                    JSBridge__Push(result)
                    JSBridge__Push(ai)
                    JSBridge__Push(slen)
                    JSBridge__Push(map_fn)
                    idx_v = JSRT_CreateNumber(ai)
                    StoreValue(JSVMCallBuf.buf, elem)
                    StoreValue(Add(JSVMCallBuf.buf, 8), idx_v)
                    elem = JSVM__CallFunc(map_fn, JSVMCallBuf.buf, 2)
                    map_fn = JSBridge__Pop()
                    slen = JSBridge__Pop()
                    ai = JSBridge__Pop()
                    result = JSBridge__Pop()
                    src = JSBridge__Pop()
                }
                JSRT_ArrPush(result, elem)
                ai = Add(ai, 1)
            }
            ReturnValue(result)
        }
        // If string, split into code units (M31a UTF-16)
        IfCondition EqualTo(st, JSType.STRING) ThenBlock: {
            sp = Dereference(Add(src, 8))
            slen_s = JSRT_StrLen(sp)
            JSBridge__Push(sp)
            JSBridge__Push(map_fn)
            JSBridge__Push(has_map)
            result = JSRT_CreateArray()
            has_map = JSBridge__Pop()
            map_fn = JSBridge__Pop()
            sp = JSBridge__Pop()
            ci = 0
            WhileLoop LessThan(ci, slen_s) {
                JSBridge__Push(sp)
                JSBridge__Push(result)
                JSBridge__Push(ci)
                JSBridge__Push(map_fn)
                JSBridge__Push(has_map)
                csv = JSRT_CreateStringSlice(sp, ci, 1)
                has_map = JSBridge__Pop()
                map_fn = JSBridge__Pop()
                ci = JSBridge__Pop()
                result = JSBridge__Pop()
                sp = JSBridge__Pop()
                IfCondition EqualTo(has_map, 1) ThenBlock: {
                    JSBridge__Push(sp)
                    JSBridge__Push(result)
                    JSBridge__Push(ci)
                    JSBridge__Push(map_fn)
                    idx_v = JSRT_CreateNumber(ci)
                    StoreValue(JSVMCallBuf.buf, csv)
                    StoreValue(Add(JSVMCallBuf.buf, 8), idx_v)
                    csv = JSVM__CallFunc(map_fn, JSVMCallBuf.buf, 2)
                    map_fn = JSBridge__Pop()
                    ci = JSBridge__Pop()
                    result = JSBridge__Pop()
                    sp = JSBridge__Pop()
                }
                JSRT_ArrPush(result, csv)
                ci = Add(ci, 1)
            }
            ReturnValue(result)
        }
        // M29f: array-like object (has length)
        IfCondition Or(EqualTo(st, JSType.OBJECT), EqualTo(st, JSType.FUNCTION)) ThenBlock: {
            JSBridge__Push(src)
            JSBridge__Push(map_fn)
            JSBridge__Push(has_map)
            result = JSRT_CreateArray()
            has_map = JSBridge__Pop()
            map_fn = JSBridge__Pop()
            src = JSBridge__Pop()
            slen = JSVM__ArrayLikeLen(src)
            IfCondition LessThan(slen, 0) ThenBlock: { slen = 0 }
            ai = 0
            WhileLoop LessThan(ai, slen) {
                JSBridge__Push(src)
                JSBridge__Push(result)
                JSBridge__Push(ai)
                JSBridge__Push(slen)
                JSBridge__Push(map_fn)
                JSBridge__Push(has_map)
                elem = JSVM__ArrayLikeGet(src, ai)
                has_map = JSBridge__Pop()
                map_fn = JSBridge__Pop()
                slen = JSBridge__Pop()
                ai = JSBridge__Pop()
                result = JSBridge__Pop()
                src = JSBridge__Pop()
                IfCondition EqualTo(has_map, 1) ThenBlock: {
                    JSBridge__Push(src)
                    JSBridge__Push(result)
                    JSBridge__Push(ai)
                    JSBridge__Push(slen)
                    JSBridge__Push(map_fn)
                    idx_v = JSRT_CreateNumber(ai)
                    StoreValue(JSVMCallBuf.buf, elem)
                    StoreValue(Add(JSVMCallBuf.buf, 8), idx_v)
                    elem = JSVM__CallFunc(map_fn, JSVMCallBuf.buf, 2)
                    map_fn = JSBridge__Pop()
                    slen = JSBridge__Pop()
                    ai = JSBridge__Pop()
                    result = JSBridge__Pop()
                    src = JSBridge__Pop()
                }
                JSRT_ArrPush(result, elem)
                ai = Add(ai, 1)
            }
            ReturnValue(result)
        }
        // Fallback: empty array
        ReturnValue(JSRT_CreateArray())
    }
}

// =============================================================================
// DOM NODE WRAPPING — create or find cached JS object for a DOM node
// Each wrapped node is a JS OBJECT with:
//   __dom_idx  : NUMBER (the DOM node index)
//   tagName    : STRING
//   id         : STRING (if present)
//   innerHTML  : STRING (text of first text child)
//   getAttribute    : FUNCTION (native)
//   setAttribute    : FUNCTION (native)
//   addEventListener: FUNCTION (native)
//   textContent     : STRING (alias of innerHTML for v1)
// =============================================================================

// Look up existing wrapper by DOM index. Returns JS object or 0.
Function.JSBridge__FindWrap {
    Input: dom_idx: Integer
    Output: Address
    Body: {
        save_idx = dom_idx
        wi = 0
        WhileLoop LessThan(wi, JSBridgeState.wrap_count) {
            base = Add(JSBridgeState.dom_wraps, Multiply(wi, JSBridgeConst.WRAP_SIZE))
            entry_idx = Dereference(base)
            IfCondition EqualTo(entry_idx, save_idx) ThenBlock: {
                ReturnValue(Dereference(Add(base, 8)))
            }
            wi = Add(wi, 1)
        }
        ReturnValue(0)
    }
}

// Public lookup: get the JS wrapper object for a DOM index (or 0 if not wrapped).
Function.JSBridge_GetWrapObj {
    Input: dom_idx: Integer
    Output: Address
    Body: {
        ReturnValue(JSBridge__FindWrap(dom_idx))
    }
}

// Store a new DOM-index -> JS-object mapping.
Function.JSBridge__StoreWrap {
    Input: dom_idx: Integer
    Input: js_obj: Address
    Output: Integer
    Body: {
        save_idx = dom_idx
        save_obj = js_obj
        IfCondition GreaterEqual(JSBridgeState.wrap_count, JSBridgeConst.MAX_DOM_WRAPS) ThenBlock: {
            PrintMessage("[JSBridge] wrap pool full\n")
            ReturnValue(0)
        }
        base = Add(JSBridgeState.dom_wraps, Multiply(JSBridgeState.wrap_count, JSBridgeConst.WRAP_SIZE))
        StoreValue(base, save_idx)
        StoreValue(Add(base, 8), save_obj)
        JSBridgeState.wrap_count = Add(JSBridgeState.wrap_count, 1)
        ReturnValue(1)
    }
}

// Public API: wrap a DOM node as a JS object (or return cached wrapper).
Function.JSBridge_WrapNode {
    Input: dom_idx: Integer
    Output: Address
    Body: {
        save_idx = dom_idx

        // Negative index means "not found" in DOM
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Check cache first
        cached = JSBridge__FindWrap(save_idx)
        IfCondition NotEqual(cached, 0) ThenBlock: {
            ReturnValue(cached)
        }

        // Create new JS object
        obj = JSRT_CreateObject()

        // Set __dom_idx property
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        idx_val = JSRT_CreateNumber(save_idx)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__dom_idx", idx_val)

        // Set tagName
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        tag_ptr = DOM_GetTag(save_idx)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        IfCondition NotEqual(tag_ptr, 0) ThenBlock: {
            JSBridge__Push(save_idx)
            JSBridge__Push(obj)
            tag_val = JSRT_CreateString(tag_ptr)
            obj = JSBridge__Pop()
            save_idx = JSBridge__Pop()
            JSRT_ObjSet(obj, "tagName", tag_val)
        }

        // Set id (from DOM attribute)
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        id_ptr = DOM_GetAttr(save_idx, "id")
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        IfCondition NotEqual(id_ptr, 0) ThenBlock: {
            JSBridge__Push(save_idx)
            JSBridge__Push(obj)
            id_val = JSRT_CreateString(id_ptr)
            obj = JSBridge__Pop()
            save_idx = JSBridge__Pop()
            JSRT_ObjSet(obj, "id", id_val)
        }

        // Set innerHTML / textContent from first TEXT child
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        text_str = JSBridge__GetNodeText(save_idx)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        IfCondition NotEqual(text_str, 0) ThenBlock: {
            JSBridge__Push(save_idx)
            JSBridge__Push(obj)
            text_val = JSRT_CreateString(text_str)
            obj = JSBridge__Pop()
            save_idx = JSBridge__Pop()
            JSRT_ObjSet(obj, "innerHTML", text_val)
            // textContent aliases innerHTML for v1
            JSRT_ObjSet(obj, "textContent", text_val)
        }

        // ─── method: getAttribute ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ga_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_GET_ATTR, "getAttribute", 1)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "getAttribute", ga_func)

        // ─── method: setAttribute ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        sa_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_SET_ATTR, "setAttribute", 2)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "setAttribute", sa_func)

        // ─── method: addEventListener ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ael_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_ADD_LISTENER, "addEventListener", 2)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "addEventListener", ael_func)

        // ─── method: appendChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ac_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_APPEND_CHILD, "appendChild", 1)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "appendChild", ac_func)

        // ─── method: removeChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        rc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_REMOVE_CHILD, "removeChild", 1)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "removeChild", rc_func)

        // ─── method: insertBefore ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ib_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_INSERT_BEFORE, "insertBefore", 2)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "insertBefore", ib_func)

        // ─── method: replaceChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        rpc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_REPLACE_CHILD, "replaceChild", 2)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "replaceChild", rpc_func)

        // ─── method: contains ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        cn_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CONTAINS, "contains", 1)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "contains", cn_func)

        // ─── method: remove ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        rm_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_REMOVE, "remove", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "remove", rm_func)

        // ─── property: parentNode ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        pn_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_PARENT_NODE, "parentNode", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_parentNode", pn_func)

        // ─── property: firstChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        fc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_FIRST_CHILD, "firstChild", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_firstChild", fc_func)

        // ─── property: lastChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        lc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_LAST_CHILD, "lastChild", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_lastChild", lc_func)

        // ─── property: nextSibling ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ns_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_NEXT_SIBLING, "nextSibling", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_nextSibling", ns_func)

        // ─── property: previousSibling ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ps_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_PREV_SIBLING, "previousSibling", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_previousSibling", ps_func)

        // ─── property: childNodes ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        cns_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CHILD_NODES, "childNodes", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_childNodes", cns_func)

        // ─── method: getBoundingClientRect ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        gbcr_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_GET_BOUNDING_RECT, "getBoundingClientRect", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "getBoundingClientRect", gbcr_func)

        // ─── property: offsetWidth (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ow_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_OFFSET_WIDTH, "offsetWidth", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_offsetWidth", ow_func)

        // ─── property: offsetHeight (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        oh_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_OFFSET_HEIGHT, "offsetHeight", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_offsetHeight", oh_func)

        // ─── property: clientWidth (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        cw_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLIENT_WIDTH, "clientWidth", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_clientWidth", cw_func)

        // ─── property: clientHeight (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ch_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLIENT_HEIGHT, "clientHeight", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_clientHeight", ch_func)

        // ─── property: scrollWidth (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        sw_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_SCROLL_WIDTH, "scrollWidth", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_scrollWidth", sw_func)

        // ─── property: scrollHeight (getter) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        sh_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_SCROLL_HEIGHT, "scrollHeight", 0)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__get_scrollHeight", sh_func)

        // ─── property: classList (sub-object with add/remove/toggle/contains) ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        cl_obj = JSRT_CreateObject()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        // Store __dom_idx on classList object so handlers can find the element
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        JSBridge__Push(cl_obj)
        cl_didx = JSRT_CreateNumber(save_idx)
        cl_obj = JSBridge__Pop()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(cl_obj, "__dom_idx", cl_didx)
        // classList.add
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        JSBridge__Push(cl_obj)
        cla_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLASS_LIST_ADD, "add", 1)
        cl_obj = JSBridge__Pop()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(cl_obj, "add", cla_func)
        // classList.remove
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        JSBridge__Push(cl_obj)
        clr_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLASS_LIST_RM, "remove", 1)
        cl_obj = JSBridge__Pop()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(cl_obj, "remove", clr_func)
        // classList.toggle
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        JSBridge__Push(cl_obj)
        clt_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLASS_LIST_TOG, "toggle", 1)
        cl_obj = JSBridge__Pop()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(cl_obj, "toggle", clt_func)
        // classList.contains
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        JSBridge__Push(cl_obj)
        clc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_CLASS_LIST_HAS, "contains", 1)
        cl_obj = JSBridge__Pop()
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(cl_obj, "contains", clc_func)
        JSRT_ObjSet(obj, "classList", cl_obj)

        // Store in wrap cache
        JSBridge__StoreWrap(save_idx, obj)

        ReturnValue(obj)
    }
}

// =============================================================================
// HELPER — get the text content of a DOM node's first TEXT child
// Returns pointer to string, or 0 if no text child
// =============================================================================
Function.JSBridge__GetNodeText {
    Input: dom_idx: Integer
    Output: Address
    Body: {
        save_idx = dom_idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Check if this node itself is a text node
        ntype = DOM_GetType(save_idx)
        IfCondition EqualTo(ntype, DOMType.TEXT) ThenBlock: {
            ReturnValue(DOM_GetText(save_idx))
        }

        // Walk children to find first TEXT node
        ch = DOM_GetFirstChild(save_idx)
        WhileLoop NotEqual(ch, -1) {
            ch_type = DOM_GetType(ch)
            IfCondition EqualTo(ch_type, DOMType.TEXT) ThenBlock: {
                ReturnValue(DOM_GetText(ch))
            }
            ch = DOM_GetNextSib(ch)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// HELPER — extract __dom_idx integer from a JS wrapper object
// Returns the DOM node index, or -1 if not a wrapper
// =============================================================================
Function.JSBridge__GetDomIdx {
    Input: js_obj: Address
    Output: Integer
    Body: {
        JSBridgeTmp.obj = js_obj
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(-1)
        }
        otype = JSRT_GetType(JSBridgeTmp.obj)
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(-1)
        }
        JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.obj, "__dom_idx")
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            ReturnValue(-1)
        }
        vtype = JSRT_GetType(JSBridgeTmp.result)
        IfCondition NotEqual(vtype, JSType.NUMBER) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(Float_ToInt(JSRT_GetPayload(JSBridgeTmp.result)))
    }
}

// =============================================================================
// HELPER — look up a CSS property for a DOM node (inline + stylesheet rules)
// Returns pointer to value string, or 0 if not found
// =============================================================================
Function.JSBridge__CSSLookup {
    Input: node: Integer
    Input: prop: Address
    Output: Address
    Body: {
        // 1. Check inline style (highest priority)
        style_str = DOM_GetAttr(node, "style")
        IfCondition NotEqual(style_str, 0) ThenBlock: {
            slen = StringLength(style_str)
            rule = CSS_ParseInline(style_str, slen)
            IfCondition GreaterEqual(rule, 0) ThenBlock: {
                cv = CSS_GetPropVal(rule, prop)
                IfCondition NotEqual(cv, 0) ThenBlock: {
                    ReturnValue(cv)
                }
            }
        }

        // 2. Check CSS stylesheet rules (tag/class/id matching)
        rcount = CSS_RuleCount()
        IfCondition EqualTo(rcount, 0) ThenBlock: { ReturnValue(0) }

        css_tag = DOM_GetTag(node)
        css_cls = DOM_GetAttr(node, "class")
        css_id = DOM_GetAttr(node, "id")

        css_result = 0
        css_best = -1
        css_ri = 0
        WhileLoop LessThan(css_ri, rcount) {
            css_matched = 0
            IfCondition EqualTo(CSS_MatchesTag(css_ri, css_tag), 1) ThenBlock: {
                css_matched = 1
            }
            IfCondition EqualTo(css_matched, 0) ThenBlock: {
                IfCondition NotEqual(css_cls, 0) ThenBlock: {
                    IfCondition EqualTo(CSS_MatchesClass(css_ri, css_cls), 1) ThenBlock: {
                        css_matched = 1
                    }
                }
            }
            IfCondition EqualTo(css_matched, 0) ThenBlock: {
                IfCondition EqualTo(CSS_MatchesId(css_ri, css_id), 1) ThenBlock: {
                    css_matched = 1
                }
            }
            IfCondition EqualTo(css_matched, 1) ThenBlock: {
                css_val = CSS_GetPropVal(css_ri, prop)
                IfCondition NotEqual(css_val, 0) ThenBlock: {
                    css_spec = CSS_RuleSpecificity(css_ri)
                    IfCondition GreaterEqual(css_spec, css_best) ThenBlock: {
                        css_best = css_spec
                        css_result = css_val
                    }
                }
            }
            css_ri = Add(css_ri, 1)
        }

        ReturnValue(css_result)
    }
}

// =============================================================================
// HELPER — get DOM index from "this" (the method receiver)
// Used by method handlers called via CALL_METHOD
// =============================================================================
Function.JSBridge__GetThisDomIdx {
    Output: Integer
    Body: {
        this_obj = JSVM_GetGlobal("this")
        ReturnValue(JSBridge__GetDomIdx(this_obj))
    }
}

// =============================================================================
// HELPER — get DOM index from arg buffer slot
// Dereferences the pointer at args+offset to get the JSValue, then extracts idx
// =============================================================================
Function.JSBridge__GetArgDomIdx {
    Input: args: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        arg_val = Dereference(Add(args, offset))
        ReturnValue(JSBridge__GetDomIdx(arg_val))
    }
}

// =============================================================================
// SET_PROP INTERCEPT — called by JSVM on SET_PROP to handle DOM mutations
// If the object has __dom_idx and the property is innerHTML/textContent,
// updates the actual DOM text node. Returns 1 if intercepted, 0 if not.
// =============================================================================
Function.JSBridge_SetProp {
    Input: obj: Address
    Input: prop: Address
    Input: val: Address
    Output: Integer
    Body: {
        // Store all inputs in FixedPool — locals get clobbered by every function call
        JSBridgeTmp.obj = obj
        JSBridgeTmp.name_ptr = prop
        JSBridgeTmp.val = val

        // Check for __dom_idx on the object
        JSBridgeTmp.dom_idx = JSBridge__GetDomIdx(JSBridgeTmp.obj)
        IfCondition LessThan(JSBridgeTmp.dom_idx, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Check if property is "innerHTML" or "textContent" by byte inspection
        p0 = GetByte(JSBridgeTmp.name_ptr, 0)

        // "innerHTML" starts with 'i' = 105, check 'n' at 1 and 'H' at 5
        JSBridgeTmp.found = 0
        IfCondition EqualTo(p0, 105) ThenBlock: {
            p1 = GetByte(JSBridgeTmp.name_ptr, 1)
            IfCondition EqualTo(p1, 110) ThenBlock: {
                p5 = GetByte(JSBridgeTmp.name_ptr, 5)
                IfCondition EqualTo(p5, 72) ThenBlock: {
                    JSBridgeTmp.found = 1
                }
            }
        }

        // "textContent" starts with 't' = 116, check 'e' at 1 and 'C' at 4
        IfCondition EqualTo(p0, 116) ThenBlock: {
            p1 = GetByte(JSBridgeTmp.name_ptr, 1)
            IfCondition EqualTo(p1, 101) ThenBlock: {
                p4 = GetByte(JSBridgeTmp.name_ptr, 4)
                IfCondition EqualTo(p4, 67) ThenBlock: {
                    JSBridgeTmp.found = 1
                }
            }
        }

        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Convert value to string
        JSBridgeTmp.result = JSRT_ToString(JSBridgeTmp.val)
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            ReturnValue(1)
        }

        // M31a: flatten UTF-16 JS string to C for DOM
        JSBridgeTmp.ptr = JSRT_GetPayload(JSBridgeTmp.result)
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            JSBridgeTmp.len = 0
        } ElseBlock: {
            JSBridgeTmp.len = JSRT_StrLen(JSBridgeTmp.ptr)
            JSBridgeTmp.ptr = JSRT_StrToC(JSBridgeTmp.ptr)
        }

        // DOM_SetTextContent copies into stable Allocate() storage and replaces
        // children. The old path stored a pointer into JS str_slab/val_pool which
        // is reclaimed — e2e then saw stale/empty text after innerHTML assign.
        DOM_SetTextContent(JSBridgeTmp.dom_idx, JSBridgeTmp.ptr, JSBridgeTmp.len)

        // Mirror onto the wrapper so el.innerHTML reads match
        JSRT_ObjSet(JSBridgeTmp.obj, JSBridgeTmp.name_ptr, JSBridgeTmp.result)

        ReturnValue(1)
    }
}

// =============================================================================
// REGEXP CONSTRUCTOR — new RegExp(pattern, flags)
// Creates a regexp object with compiled NFA handle and instance methods.
// =============================================================================
Function.JSBridge__NRegExpCtor {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc

        // ─── Extract pattern string (arg0, default "") ───
        pat_ptr = 0
        pat_len = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            arg0 = Dereference(save_args)
            a0_type = JSRT_GetType(arg0)
            IfCondition EqualTo(a0_type, JSType.STRING) ThenBlock: {
                // M31a: regex engine wants C/byte pattern
                pat_ptr = JSRT_StrToC(JSRT_GetPayload(arg0))
                pat_len = 0
                IfCondition NotEqual(pat_ptr, 0) ThenBlock: { pat_len = StringLength(pat_ptr) }
            }
            IfCondition NotEqual(a0_type, JSType.STRING) ThenBlock: {
                IfCondition NotEqual(a0_type, JSType.UNDEFINED) ThenBlock: {
                    // Coerce to string
                    JSBridge__Push(save_args)
                    s_val = JSRT_ToString(arg0)
                    save_args = JSBridge__Pop()
                    pat_ptr = JSRT_StrToC(JSRT_GetPayload(s_val))
                    pat_len = 0
                    IfCondition NotEqual(pat_ptr, 0) ThenBlock: { pat_len = StringLength(pat_ptr) }
                }
            }
        }

        // ─── Extract flags string (arg1, default "") ───
        flg_ptr = 0
        flg_len = 0
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            arg1 = Dereference(Add(save_args, 8))
            a1_type = JSRT_GetType(arg1)
            IfCondition EqualTo(a1_type, JSType.STRING) ThenBlock: {
                flg_ptr = JSRT_StrToC(JSRT_GetPayload(arg1))
                flg_len = 0
                IfCondition NotEqual(flg_ptr, 0) ThenBlock: { flg_len = StringLength(flg_ptr) }
            }
            IfCondition NotEqual(a1_type, JSType.STRING) ThenBlock: {
                IfCondition NotEqual(a1_type, JSType.UNDEFINED) ThenBlock: {
                    JSBridge__Push(save_args)
                    f_val = JSRT_ToString(arg1)
                    save_args = JSBridge__Pop()
                    flg_ptr = JSRT_StrToC(JSRT_GetPayload(f_val))
                    flg_len = 0
                    IfCondition NotEqual(flg_ptr, 0) ThenBlock: { flg_len = StringLength(flg_ptr) }
                }
            }
        }

        // ─── Parse flags string → bitfield ───
        // g=32, i=1, m=2, s=4, y=64, u=16, v=128 (UNICODE_SETS), d=hasIndices
        flags_int = 0
        has_global = 0
        has_icase = 0
        has_mline = 0
        has_dotall = 0
        has_sticky = 0
        has_unicode = 0
        has_unicode_sets = 0
        has_indices = 0
        fi = 0
        WhileLoop LessThan(fi, flg_len) {
            fc = GetByte(flg_ptr, fi)
            // 'g' = 103
            IfCondition EqualTo(fc, 103) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 32)
                has_global = 1
            }
            // 'i' = 105
            IfCondition EqualTo(fc, 105) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 1)
                has_icase = 1
            }
            // 'm' = 109
            IfCondition EqualTo(fc, 109) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 2)
                has_mline = 1
            }
            // 's' = 115
            IfCondition EqualTo(fc, 115) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 4)
                has_dotall = 1
            }
            // 'u' = 117
            IfCondition EqualTo(fc, 117) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 16)
                has_unicode = 1
            }
            // 'y' = 121
            IfCondition EqualTo(fc, 121) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 64)
                has_sticky = 1
            }
            // 'v' = 118 unicodeSets
            IfCondition EqualTo(fc, 118) ThenBlock: {
                flags_int = BitwiseOr(flags_int, 128)
                has_unicode_sets = 1
            }
            // 'd' = 100 hasIndices
            IfCondition EqualTo(fc, 100) ThenBlock: {
                has_indices = 1
            }
            fi = Add(fi, 1)
        }
        // u+v is SyntaxError (Compile also rejects)
        IfCondition And(EqualTo(has_unicode, 1), EqualTo(has_unicode_sets, 1)) ThenBlock: {
            terr = JSVM_CreateTypedError("SyntaxError", "Invalid regular expression flags")
            JSVMCall.exc_prop = 1
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }

        // ─── Compile regex ───
        rx_handle = 0
        IfCondition NotEqual(pat_ptr, 0) ThenBlock: {
            rx_handle = JSRegex_Compile(pat_ptr, flags_int)
        }
        IfCondition EqualTo(pat_ptr, 0) ThenBlock: {
            // Empty pattern — matches everything
            rx_handle = JSRegex_Compile("", flags_int)
        }
        // M30i: invalid pattern → SyntaxError
        IfCondition EqualTo(rx_handle, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("SyntaxError", "Invalid regular expression")
            JSVMCall.exc_prop = 1
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }

        // ─── Create RegExp object ───
        re_obj = JSRT_CreateObject()

        // __class__ = "RegExp"
        JSBridge__Push(re_obj)
        cls_val = JSRT_CreateString("RegExp")
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "__class__", cls_val)

        // source = pattern string
        JSBridge__Push(re_obj)
        IfCondition NotEqual(pat_ptr, 0) ThenBlock: {
            src_val = JSRT_CreateStringLen(pat_ptr, pat_len)
        }
        IfCondition EqualTo(pat_ptr, 0) ThenBlock: {
            src_val = JSRT_CreateString("(?:)")
        }
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "source", src_val)

        // flags = flags string
        JSBridge__Push(re_obj)
        IfCondition NotEqual(flg_ptr, 0) ThenBlock: {
            flg_val = JSRT_CreateStringLen(flg_ptr, flg_len)
        }
        IfCondition EqualTo(flg_ptr, 0) ThenBlock: {
            flg_val = JSRT_CreateString("")
        }
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "flags", flg_val)

        // __regex_handle__ = raw handle (stored as float bits to avoid Float_FromInt)
        JSBridge__Push(re_obj)
        rh_val = JSRT_CreateFloat(rx_handle)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "__regex_handle__", rh_val)

        // global, ignoreCase, multiline boolean properties
        JSBridge__Push(re_obj)
        g_val = JSRT_CreateBool(has_global)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "global", g_val)

        JSBridge__Push(re_obj)
        ic_val = JSRT_CreateBool(has_icase)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "ignoreCase", ic_val)

        JSBridge__Push(re_obj)
        ml_val = JSRT_CreateBool(has_mline)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "multiline", ml_val)

        JSBridge__Push(re_obj)
        ds_val = JSRT_CreateBool(has_dotall)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "dotAll", ds_val)

        JSBridge__Push(re_obj)
        st_val = JSRT_CreateBool(has_sticky)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "sticky", st_val)
        JSBridge__Push(re_obj)
        uc_val = JSRT_CreateBool(has_unicode)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "unicode", uc_val)
        JSBridge__Push(re_obj)
        us_val = JSRT_CreateBool(has_unicode_sets)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "unicodeSets", us_val)
        JSBridge__Push(re_obj)
        hi_val = JSRT_CreateBool(has_indices)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "hasIndices", hi_val)

        // lastIndex = 0
        JSBridge__Push(re_obj)
        li_val = JSRT_CreateNumber(0)
        re_obj = JSBridge__Pop()
        JSRT_ObjSet(re_obj, "lastIndex", li_val)

        // ─── Set __proto__ to RegExp.prototype ───
        // Methods (test/exec/toString) live on RegExp.prototype.
        // GET_PROP rebinds them to the instance on access (same pattern as strings).
        JSBridge__Push(re_obj)
        rp = JSBridgeState.regexp_proto
        re_obj = JSBridge__Pop()
        IfCondition NotEqual(rp, 0) ThenBlock: {
            JSRT_ObjSet(re_obj, "__proto__", rp)
        }

        ReturnValue(re_obj)
    }
}

// M62: SameValueZero index of key in Map pairs array [[k,v],...]
Function.JSBridge__MapFindIndex {
    Input: pairs: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_p = pairs
        save_k = key
        IfCondition NotEqual(JSRT_GetType(save_p), JSType.ARRAY) ThenBlock: {
            ReturnValue(-1)
        }
        i = 0
        n = JSRT_ArrLen(save_p)
        WhileLoop LessThan(i, n) {
            ent = JSRT_ArrGet(save_p, i)
            IfCondition EqualTo(JSRT_GetType(ent), JSType.ARRAY) ThenBlock: {
                IfCondition GreaterThan(JSRT_ArrLen(ent), 0) ThenBlock: {
                    ek = JSRT_ArrGet(ent, 0)
                    IfCondition EqualTo(JSBridge__SameValueZero(ek, save_k), 1) ThenBlock: {
                        ReturnValue(i)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// M62: SameValueZero index in Set values array
Function.JSBridge__SetFindIndex {
    Input: vals: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_p = vals
        save_k = key
        IfCondition NotEqual(JSRT_GetType(save_p), JSType.ARRAY) ThenBlock: {
            ReturnValue(-1)
        }
        i = 0
        n = JSRT_ArrLen(save_p)
        WhileLoop LessThan(i, n) {
            ek = JSRT_ArrGet(save_p, i)
            // skip tombstones
            is_tomb = 0
            IfCondition EqualTo(JSRT_GetType(ek), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_ObjHas(ek, "__tomb__"), 1) ThenBlock: {
                    is_tomb = 1
                }
            }
            IfCondition EqualTo(is_tomb, 1) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
                IfCondition EqualTo(JSBridge__SameValueZero(ek, save_k), 1) ThenBlock: {
                    ReturnValue(i)
                }
                i = Add(i, 1)
            }
        }
        ReturnValue(-1)
    }
}

// SameValueZero (NaN===NaN, +0===-0)
Function.JSBridge__SameValueZero {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, save_b) ThenBlock: {
            ReturnValue(1)
        }
        ta = JSRT_GetType(save_a)
        tb = JSRT_GetType(save_b)
        IfCondition NotEqual(ta, tb) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ta, JSType.NUMBER) ThenBlock: {
            pa = JSRT_GetPayload(save_a)
            pb = JSRT_GetPayload(save_b)
            IfCondition EqualTo(pa, pb) ThenBlock: {
                ReturnValue(1)
            }
            // Engine NaN bit pattern (JSVM NaN global)
            nan_bits = 9221120237041090560
            IfCondition And(EqualTo(pa, nan_bits), EqualTo(pb, nan_bits)) ThenBlock: {
                ReturnValue(1)
            }
            // +0 / -0
            IfCondition And(EqualTo(Float_ToInt(pa), 0), EqualTo(Float_ToInt(pb), 0)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(ta, JSType.STRING) ThenBlock: {
            sa = JSRT_GetPayload(save_a)
            sb = JSRT_GetPayload(save_b)
            IfCondition EqualTo(JSRT_StrEq(sa, sb), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(ta, JSType.BOOLEAN) ThenBlock: {
            IfCondition EqualTo(JSRT_IsTruthy(save_a), JSRT_IsTruthy(save_b)) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(ta, JSType.NULL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(ta, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(1)
        }
        // objects/functions: reference equality (SameValue)
        IfCondition EqualTo(JSRT_SameRef(save_a, save_b), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// NATIVE DISPATCH — route handler ID to the appropriate native impl
// Called by JSVM when handler_id >= 8.
// args = pointer to array of JSValue pointers (8 bytes each)
// argc = number of arguments
// Returns a JSValue pointer (result).
// =============================================================================
Function.JSBridge_Dispatch {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

        // ─── M110 THENABLE_RESOLVE (273) ───
        IfCondition EqualTo(save_id, JSNativeID.THENABLE_RESOLVE) ThenBlock: {
            IfCondition EqualTo(JSVMAwait.state, 0) ThenBlock: {
                v = JSRT_Undefined()
                IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                    v = Dereference(save_args)
                }
                JSVMAwait.value = v
                JSVMAwait.state = 1
            }
            ReturnValue(JSRT_Undefined())
        }
        // ─── M110 THENABLE_REJECT (274) ───
        IfCondition EqualTo(save_id, JSNativeID.THENABLE_REJECT) ThenBlock: {
            IfCondition EqualTo(JSVMAwait.state, 0) ThenBlock: {
                v2 = JSRT_Undefined()
                IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                    v2 = Dereference(save_args)
                }
                JSVMAwait.value = v2
                JSVMAwait.state = 2
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── CONSOLE_LOG (8) ───
        IfCondition EqualTo(save_id, JSNativeID.CONSOLE_LOG) ThenBlock: {
            ReturnValue(JSBridge__NConsoleLog(save_args, save_argc))
        }

        // ─── DOC_GET_BY_ID (9) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_GET_BY_ID) ThenBlock: {
            ReturnValue(JSBridge__NGetById(save_args, save_argc))
        }

        // ─── DOC_QUERY_SEL (10) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_QUERY_SEL) ThenBlock: {
            ReturnValue(JSBridge__NQuerySel(save_args, save_argc))
        }

        // ─── DOC_CREATE_ELEM (11) — document.createElement(tag) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_CREATE_ELEM) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Null()) }
            arg0 = Dereference(save_args)
            str0 = JSRT_ToString(arg0)
            tag_ptr = JSRT_StrToC(JSRT_GetPayload(str0))
            IfCondition EqualTo(tag_ptr, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            elem_idx = DOM_CreateElement(tag_ptr)
            ReturnValue(JSBridge_WrapNode(elem_idx))
        }

        // ─── ELEM_GET_ATTR (12) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_GET_ATTR) ThenBlock: {
            ReturnValue(JSBridge__NGetAttr(save_args, save_argc))
        }

        // ─── ELEM_SET_ATTR (13) — element.setAttribute(name, value) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_SET_ATTR) ThenBlock: {
            IfCondition LessThan(save_argc, 3) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            // args[0] = element wrapper, args[1] = attr name, args[2] = attr value
            sa_elem = Dereference(save_args)
            JSBridge__Push(save_args)
            sa_domidx = JSBridge__GetDomIdx(sa_elem)
            save_args = JSBridge__Pop()
            IfCondition LessThan(sa_domidx, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            // Get name string
            sa_name_val = Dereference(Add(save_args, 8))
            JSBridge__Push(save_args)
            JSBridge__Push(sa_domidx)
            sa_name_s = JSRT_ToString(sa_name_val)
            sa_domidx = JSBridge__Pop()
            save_args = JSBridge__Pop()
            sa_name_ptr = JSRT_GetPayload(sa_name_s)
            IfCondition EqualTo(sa_name_ptr, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            // Get value string
            sa_val_val = Dereference(Add(save_args, 16))
            JSBridge__Push(sa_name_ptr)
            JSBridge__Push(sa_domidx)
            sa_val_s = JSRT_ToString(sa_val_val)
            sa_domidx = JSBridge__Pop()
            sa_name_ptr = JSBridge__Pop()
            sa_val_ptr = JSRT_GetPayload(sa_val_s)
            IfCondition EqualTo(sa_val_ptr, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            // M31a: flatten UTF-16 → C for DOM attrs
            sa_name_ptr = JSRT_StrToC(sa_name_ptr)
            sa_val_ptr = JSRT_StrToC(sa_val_ptr)
            IfCondition Or(EqualTo(sa_name_ptr, 0), EqualTo(sa_val_ptr, 0)) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            sa_nlen = StringLength(sa_name_ptr)
            sa_stable_name = JSRT__StrSlabAlloc(Add(sa_nlen, 1))
            MemoryCopy(sa_stable_name, sa_name_ptr, sa_nlen)
            SetByte(sa_stable_name, sa_nlen, 0)
            sa_vlen = StringLength(sa_val_ptr)
            sa_stable_val = JSRT__StrSlabAlloc(Add(sa_vlen, 1))
            MemoryCopy(sa_stable_val, sa_val_ptr, sa_vlen)
            SetByte(sa_stable_val, sa_vlen, 0)
            DOM_SetAttr(sa_domidx, sa_stable_name, sa_stable_val)
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_ADD_LISTENER (14) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_ADD_LISTENER) ThenBlock: {
            ReturnValue(JSBridge__NAddListener(save_args, save_argc))
        }

        // ─── ELEM_INNER_HTML_GET (15) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_INNER_HTML_GET) ThenBlock: {
            ReturnValue(JSBridge__NInnerHTMLGet(save_args, save_argc))
        }

        // ─── ELEM_INNER_HTML_SET (16) — element.innerHTML = val ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_INNER_HTML_SET) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            ihs_idx = JSBridge__GetThisDomIdx()
            ihs_arg = Dereference(save_args)
            JSBridge__Push(ihs_idx)
            ihs_str = JSRT_ToString(ihs_arg)
            ihs_idx = JSBridge__Pop()
            ihs_ptr = JSRT_GetPayload(ihs_str)
            ihs_len = 0
            IfCondition NotEqual(ihs_ptr, 0) ThenBlock: {
                ihs_len = JSRT_StrLen(ihs_ptr)
                ihs_ptr = JSRT_StrToC(ihs_ptr)
            }
            // For v1 treat as textContent — clears children and sets text node
            DOM_SetTextContent(ihs_idx, ihs_ptr, ihs_len)
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_TEXT_CONTENT (17) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_TEXT_CONTENT) ThenBlock: {
            // Same as innerHTML get for v1
            ReturnValue(JSBridge__NInnerHTMLGet(save_args, save_argc))
        }

        // ─── ELEM_APPEND_CHILD (18) — node.appendChild(child) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_APPEND_CHILD) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            parent_idx = JSBridge__GetThisDomIdx()
            child_val = Dereference(save_args)
            child_idx = JSBridge__GetArgDomIdx(save_args, 0)
            DOM_AppendChild(parent_idx, child_idx)
            ReturnValue(child_val)
        }

        // ─── ELEM_REMOVE_CHILD (19) — node.removeChild(child) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_REMOVE_CHILD) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            parent_idx = JSBridge__GetThisDomIdx()
            child_val = Dereference(save_args)
            child_idx = JSBridge__GetArgDomIdx(save_args, 0)
            DOM_RemoveChild(parent_idx, child_idx)
            ReturnValue(child_val)
        }

        // ─── ELEM_STYLE_SET (20) — element.style.cssText = val ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_STYLE_SET) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            ss_idx = JSBridge__GetThisDomIdx()
            ss_arg = Dereference(save_args)
            JSBridge__Push(ss_idx)
            ss_str = JSRT_ToString(ss_arg)
            ss_idx = JSBridge__Pop()
            ss_ptr = JSRT_GetPayload(ss_str)
            IfCondition NotEqual(ss_ptr, 0) ThenBlock: {
                ss_ptr = JSRT_StrToC(ss_ptr)
                ss_len = 0
                IfCondition NotEqual(ss_ptr, 0) ThenBlock: { ss_len = StringLength(ss_ptr) }
                ss_stable = JSRT__StrSlabAlloc(Add(ss_len, 1))
                MemoryCopy(ss_stable, ss_ptr, ss_len)
                SetByte(ss_stable, ss_len, 0)
                DOM_SetAttr(ss_idx, "style", ss_stable)
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── SET_TIMEOUT (21) ───
        IfCondition EqualTo(save_id, JSNativeID.SET_TIMEOUT) ThenBlock: {
            ReturnValue(JSBridge__NSetTimeout(save_args, save_argc))
        }

        // ─── SET_INTERVAL (22) ───
        IfCondition EqualTo(save_id, JSNativeID.SET_INTERVAL) ThenBlock: {
            ReturnValue(JSBridge__NSetInterval(save_args, save_argc))
        }

        // ─── CLEAR_TIMEOUT (23) ───
        IfCondition EqualTo(save_id, JSNativeID.CLEAR_TIMEOUT) ThenBlock: {
            ReturnValue(JSBridge__NClearTimeout(save_args, save_argc))
        }

        // ─── PARSE_INT (24) ───
        IfCondition EqualTo(save_id, JSNativeID.PARSE_INT) ThenBlock: {
            ReturnValue(JSBridge__NParseInt(save_args, save_argc))
        }

        // ─── MATH_ABS (25) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_ABS) ThenBlock: {
            // Delegate to JSRT built-in handler 1
            ReturnValue(JSRT_CallNative(1, save_args, save_argc))
        }

        // ─── MATH_MAX (26) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_MAX) ThenBlock: {
            // Delegate to JSRT built-in handler 2
            ReturnValue(JSRT_CallNative(2, save_args, save_argc))
        }

        // ─── MATH_MIN (27) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_MIN) ThenBlock: {
            // Delegate to JSRT built-in handler 3
            ReturnValue(JSRT_CallNative(3, save_args, save_argc))
        }

        // ─── MATH_FLOOR (28) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_FLOOR) ThenBlock: {
            // Delegate to JSRT built-in handler 4
            ReturnValue(JSRT_CallNative(4, save_args, save_argc))
        }

        // ─── MATH_CEIL (79) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_CEIL) ThenBlock: {
            // Delegate to JSRT built-in handler 5
            ReturnValue(JSRT_CallNative(5, save_args, save_argc))
        }

        // ─── MATH_ROUND (80) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_ROUND) ThenBlock: {
            // Delegate to JSRT built-in handler 6
            ReturnValue(JSRT_CallNative(6, save_args, save_argc))
        }

        // ─── MATH_POW (81) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_POW) ThenBlock: {
            // Delegate to JSRT built-in handler 7
            ReturnValue(JSRT_CallNative(7, save_args, save_argc))
        }

        // ─── REGEXP_CTOR (82) — new RegExp(pattern, flags) ───
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_CTOR) ThenBlock: {
            ReturnValue(JSBridge__NRegExpCtor(save_args, save_argc))
        }

        // ─── OBJ_DEFINE_PROP (43) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_DEFINE_PROP) ThenBlock: {
            ReturnValue(JSBridge__NDefineProperty(save_args, save_argc))
        }

        // ─── OBJ_KEYS (44) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_KEYS) ThenBlock: {
            ReturnValue(JSBridge__NObjKeys(save_args, save_argc))
        }
        // ─── OBJ_GET_OWN_PROP_NAMES (205) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_OWN_PROP_NAMES) ThenBlock: {
            ReturnValue(JSBridge__NGetOwnPropNames(save_args, save_argc))
        }
        // ─── OBJ_GET_OWN_PROP_DESCS (206) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_OWN_PROP_DESCS) ThenBlock: {
            ReturnValue(JSBridge__NGetOwnPropDescs(save_args, save_argc))
        }

        // ─── OBJ_CREATE (45) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_CREATE) ThenBlock: {
            ReturnValue(JSBridge__NObjCreate(save_args, save_argc))
        }

        // ─── FUNC_CALL (195) — Function.prototype.call ───
        IfCondition EqualTo(save_id, JSNativeID.FUNC_CALL) ThenBlock: {
            ReturnValue(JSBridge__NFuncCall(save_args, save_argc))
        }
        // ─── FUNC_APPLY (196) ───
        IfCondition EqualTo(save_id, JSNativeID.FUNC_APPLY) ThenBlock: {
            ReturnValue(JSBridge__NFuncApply(save_args, save_argc))
        }
        // ─── FUNC_BIND (197) ───
        IfCondition EqualTo(save_id, JSNativeID.FUNC_BIND) ThenBlock: {
            ReturnValue(JSBridge__NFuncBind(save_args, save_argc))
        }
        // ─── FUNC_BOUND (198) ───
        IfCondition EqualTo(save_id, JSNativeID.FUNC_BOUND) ThenBlock: {
            ReturnValue(JSBridge__NFuncBound(save_args, save_argc))
        }

        // ─── OBJ_GET_OWN_PROP_DESC (46) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_OWN_PROP_DESC) ThenBlock: {
            ReturnValue(JSBridge__NGetOwnPropDesc(save_args, save_argc))
        }

        // ─── OBJ_GET_PROTO_OF (47) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_PROTO_OF) ThenBlock: {
            ReturnValue(JSBridge__NGetProtoOf(save_args, save_argc))
        }

        // ─── OBJ_SET_PROTO_OF (207) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_SET_PROTO_OF) ThenBlock: {
            ReturnValue(JSBridge__NSetProtoOf(save_args, save_argc))
        }

        // ─── OBJ_ASSIGN (48) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_ASSIGN) ThenBlock: {
            ReturnValue(JSBridge__NObjAssign(save_args, save_argc))
        }

        // ─── OBJ_FREEZE (49) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_FREEZE) ThenBlock: {
            ReturnValue(JSBridge__NObjFreeze(save_args, save_argc))
        }

        // ─── OBJ_SEAL (192) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_SEAL) ThenBlock: {
            ReturnValue(JSBridge__NObjSeal(save_args, save_argc))
        }

        // ─── OBJ_PREVENT_EXT (201) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_PREVENT_EXT) ThenBlock: {
            ReturnValue(JSBridge__NObjPreventExt(save_args, save_argc))
        }

        // ─── OBJ_IS_EXTENSIBLE (202) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS_EXTENSIBLE) ThenBlock: {
            ReturnValue(JSBridge__NObjIsExtensible(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS_FROZEN) ThenBlock: {
            ReturnValue(JSBridge__NObjIsFrozen(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS_SEALED) ThenBlock: {
            ReturnValue(JSBridge__NObjIsSealed(save_args, save_argc))
        }

        // ─── OBJ_IS (50) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS) ThenBlock: {
            ReturnValue(JSBridge__NObjIs(save_args, save_argc))
        }

        // ─── OBJ_DEF_PROPERTIES (51) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_DEF_PROPERTIES) ThenBlock: {
            ReturnValue(JSBridge__NDefineProperties(save_args, save_argc))
        }

        // ─── OBJ_ENTRIES (52) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_ENTRIES) ThenBlock: {
            ReturnValue(JSBridge__NObjEntries(save_args, save_argc))
        }

        // ─── OBJ_VALUES (53) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_VALUES) ThenBlock: {
            ReturnValue(JSBridge__NObjValues(save_args, save_argc))
        }

        // ─── OBJ_FROM_ENTRIES (234) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_FROM_ENTRIES) ThenBlock: {
            ReturnValue(JSBridge__NObjFromEntries(save_args, save_argc))
        }

        // ─── OBJ_PROTO_TO_STRING (235) — Object.prototype.toString ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_PROTO_TO_STRING) ThenBlock: {
            ReturnValue(JSBridge__NObjProtoToString(save_args, save_argc))
        }

        // ─── Boolean/Number/String.prototype valueOf/toString (236-240) ───
        IfCondition EqualTo(save_id, JSNativeID.BOOL_VALUE_OF) ThenBlock: {
            ReturnValue(JSBridge__NWrapperValueOf(save_args, save_argc, 0))
        }
        IfCondition EqualTo(save_id, JSNativeID.BOOL_TO_STRING) ThenBlock: {
            ReturnValue(JSBridge__NWrapperToString(save_args, save_argc, 0))
        }
        IfCondition EqualTo(save_id, JSNativeID.NUM_VALUE_OF) ThenBlock: {
            ReturnValue(JSBridge__NWrapperValueOf(save_args, save_argc, 1))
        }
        IfCondition EqualTo(save_id, JSNativeID.NUM_TO_STRING) ThenBlock: {
            ReturnValue(JSBridge__NWrapperToString(save_args, save_argc, 1))
        }
        IfCondition EqualTo(save_id, JSNativeID.STR_VALUE_OF) ThenBlock: {
            ReturnValue(JSBridge__NWrapperValueOf(save_args, save_argc, 2))
        }
        IfCondition EqualTo(save_id, JSNativeID.STR_TO_STRING) ThenBlock: {
            ReturnValue(JSBridge__NWrapperToString(save_args, save_argc, 2))
        }

        // ─── OBJ_PROTO_VALUE_OF (242) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_PROTO_VALUE_OF) ThenBlock: {
            // ES: ToObject(this) then return that object
            this_v = JSVM__GetGlobal("this")
            tt = JSRT_GetType(this_v)
            IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            // primitives → Object(this) box via OBJ_CTOR
            IfCondition And(NotEqual(tt, JSType.OBJECT), NotEqual(tt, JSType.FUNCTION)) ThenBlock: {
                IfCondition NotEqual(tt, JSType.ARRAY) ThenBlock: {
                    ab = JSVMCallBuf.buf
                    StoreValue(ab, this_v)
                    ReturnValue(JSBridge_Dispatch(JSNativeID.OBJ_CTOR, ab, 1))
                }
            }
            ReturnValue(this_v)
        }

        // ─── OBJ_HAS_OWN_PROP (54) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_HAS_OWN_PROP) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            hop_obj = Dereference(save_args)
            hop_key_val = Dereference(Add(save_args, 8))
            // M80: ToPropertyKey (Symbol → @@sN); ToString would yield "Symbol()"
            JSBridge__Push(hop_obj)
            hop_key_ptr = JSVM_ToPropertyKey(hop_key_val)
            hop_obj = JSBridge__Pop()
            IfCondition EqualTo(hop_key_ptr, 0) ThenBlock: {
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(JSRT_CreateBool(0))
            }
            // M26k.10: mangled private #name@id only (public "#foo" is own)
            IfCondition NotEqual(hop_key_ptr, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(hop_key_ptr, 0), 35) ThenBlock: {
                    _mp_has_at = 0
                    _mp_i = 1
                    WhileLoop LessThan(_mp_i, 256) {
                        _mp_b = GetByte(hop_key_ptr, _mp_i)
                        IfCondition EqualTo(_mp_b, 0) ThenBlock: { _mp_i = 256 }
                        IfCondition EqualTo(_mp_b, 64) ThenBlock: {
                            _mp_has_at = 1
                            _mp_i = 256
                        }
                        IfCondition And(NotEqual(_mp_b, 0), NotEqual(_mp_b, 64)) ThenBlock: {
                            _mp_i = Add(_mp_i, 1)
                        }
                    }
                    IfCondition EqualTo(_mp_has_at, 1) ThenBlock: {
                        ReturnValue(JSRT_CreateBool(0))
                    }
                }
            }
            hop_has = JSRT_ObjHas(hop_obj, hop_key_ptr)
            ReturnValue(JSRT_CreateBool(hop_has))
        }

        // ─── OBJ_IS_PROTO_OF (199) — V.isPrototypeOf(O)
        // Walk O's [[Prototype]] chain; true if V appears (SameRef for ObjSet copies).
        // Note: JSRT_ObjGet(fn,"__proto__") wrongly skips Function.prototype (FuncPropGet
        // falls through to function_proto.__proto__ = Object.prototype). Use implicit protos.
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS_PROTO_OF) ThenBlock: {
            V = JSVM__GetGlobal("this")
            IfCondition LessThan(save_argc, 1) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            O = Dereference(save_args)
            ot = JSRT_GetType(O)
            IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
                IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: {
                    ReturnValue(JSRT_CreateBool(0))
                }
            }
            hops = 0
            cur = O
            found = 0
            WhileLoop And(LessThan(hops, 100), EqualTo(found, 0)) {
                hops = Add(hops, 1)
                pt = JSRT_GetType(cur)
                proto = 0
                IfCondition EqualTo(pt, JSType.FUNCTION) ThenBlock: {
                    proto = JSRTState.function_proto
                }
                IfCondition EqualTo(pt, JSType.ARRAY) ThenBlock: {
                    proto = JSRTState.array_proto
                }
                IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: {
                    proto = JSRT_ObjGet(cur, "__proto__")
                }
                IfCondition EqualTo(proto, 0) ThenBlock: {
                    found = 2
                } ElseBlock: {
                    ptt = JSRT_GetType(proto)
                    IfCondition EqualTo(ptt, JSType.NULL) ThenBlock: {
                        found = 2
                    } ElseBlock: {
                        IfCondition EqualTo(ptt, JSType.UNDEFINED) ThenBlock: {
                            found = 2
                        } ElseBlock: {
                            IfCondition EqualTo(JSRT_SameRef(proto, V), 1) ThenBlock: {
                                found = 1
                            } ElseBlock: {
                                cur = proto
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(found, 1) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
            ReturnValue(JSRT_CreateBool(0))
        }

        // ─── OBJ_PROTO_HAS_OWN (200) — this.hasOwnProperty(key)
        IfCondition EqualTo(save_id, JSNativeID.OBJ_PROTO_HAS_OWN) ThenBlock: {
            hop_obj = JSVM__GetGlobal("this")
            IfCondition LessThan(save_argc, 1) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            hop_key_val = Dereference(save_args)
            // M80: ToPropertyKey so Symbol keys match @@sN storage
            JSBridge__Push(hop_obj)
            hop_key_ptr = JSVM_ToPropertyKey(hop_key_val)
            hop_obj = JSBridge__Pop()
            IfCondition EqualTo(hop_key_ptr, 0) ThenBlock: {
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(JSRT_CreateBool(0))
            }
            // M26k.10: mangled private #name@id only (public "#foo" is own)
            IfCondition NotEqual(hop_key_ptr, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(hop_key_ptr, 0), 35) ThenBlock: {
                    _mp_has_at = 0
                    _mp_i = 1
                    WhileLoop LessThan(_mp_i, 256) {
                        _mp_b = GetByte(hop_key_ptr, _mp_i)
                        IfCondition EqualTo(_mp_b, 0) ThenBlock: { _mp_i = 256 }
                        IfCondition EqualTo(_mp_b, 64) ThenBlock: {
                            _mp_has_at = 1
                            _mp_i = 256
                        }
                        IfCondition And(NotEqual(_mp_b, 0), NotEqual(_mp_b, 64)) ThenBlock: {
                            _mp_i = Add(_mp_i, 1)
                        }
                    }
                    IfCondition EqualTo(_mp_has_at, 1) ThenBlock: {
                        ReturnValue(JSRT_CreateBool(0))
                    }
                }
            }
            hop_has = JSRT_ObjHas(hop_obj, hop_key_ptr)
            ReturnValue(JSRT_CreateBool(hop_has))
        }

        // ─── OBJ_LOOKUP_GETTER (270) / OBJ_LOOKUP_SETTER (271) ───
        // Walk [[Prototype]] for __get_/__set_<name>; return accessor fn or undefined.
        // Public "#m" does not match private mangled keys (M76 + private-is-not-own).
        IfCondition Or(EqualTo(save_id, JSNativeID.OBJ_LOOKUP_GETTER), EqualTo(save_id, JSNativeID.OBJ_LOOKUP_SETTER)) ThenBlock: {
            lg_obj = JSVM__GetGlobal("this")
            IfCondition LessThan(save_argc, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            lg_key_val = Dereference(save_args)
            JSBridge__Push(lg_obj)
            lg_key_str = JSRT_ToString(lg_key_val)
            lg_obj = JSBridge__Pop()
            lg_key_ptr = JSRT_GetPayload(lg_key_str)
            IfCondition EqualTo(lg_key_ptr, 0) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            // Prefer prefix for getter vs setter
            is_set = 0
            IfCondition EqualTo(save_id, JSNativeID.OBJ_LOOKUP_SETTER) ThenBlock: {
                is_set = 1
            }
            // Build __get_/__set_ + name into getter_buf
            gbuf = JSVMCallBuf.getter_buf
            IfCondition EqualTo(is_set, 1) ThenBlock: {
                SetByte(gbuf, 0, 95)
                SetByte(gbuf, 1, 95)
                SetByte(gbuf, 2, 115)
                SetByte(gbuf, 3, 101)
                SetByte(gbuf, 4, 116)
                SetByte(gbuf, 5, 95)
                gpre = 6
            } ElseBlock: {
                SetByte(gbuf, 0, 95)
                SetByte(gbuf, 1, 95)
                SetByte(gbuf, 2, 103)
                SetByte(gbuf, 3, 101)
                SetByte(gbuf, 4, 116)
                SetByte(gbuf, 5, 95)
                gpre = 6
            }
            gi = 0
            gdone = 0
            WhileLoop EqualTo(gdone, 0) {
                IfCondition GreaterThan(gi, 240) ThenBlock: { gdone = 1 }
                IfCondition EqualTo(gdone, 0) ThenBlock: {
                    gb = JSRT_StrUnit(lg_key_ptr, gi)
                    IfCondition EqualTo(gb, 0) ThenBlock: {
                        SetByte(gbuf, Add(gpre, gi), 0)
                        gdone = 1
                    } ElseBlock: {
                        IfCondition GreaterThan(gb, 255) ThenBlock: { gb = 63 }
                        SetByte(gbuf, Add(gpre, gi), gb)
                        gi = Add(gi, 1)
                    }
                }
            }
            // Walk prototype chain
            cur = lg_obj
            depth = 0
            WhileLoop And(NotEqual(cur, 0), LessThan(depth, 64)) {
                IfCondition EqualTo(cur, JSRTState.undef_val) ThenBlock: {
                    cur = 0
                }
                IfCondition NotEqual(cur, 0) ThenBlock: {
                    // Own accessor only (ObjGet would walk — use ObjHas then ObjGet)
                    IfCondition EqualTo(JSRT_ObjHas(cur, gbuf), 1) ThenBlock: {
                        acc = JSRT_ObjGet(cur, gbuf)
                        IfCondition EqualTo(JSRT_GetType(acc), JSType.FUNCTION) ThenBlock: {
                            ReturnValue(acc)
                        }
                        ReturnValue(JSRT_Undefined())
                    }
                    // next [[Prototype]]
                    ct = JSRT_GetType(cur)
                    next_p = 0
                    IfCondition EqualTo(ct, JSType.OBJECT) ThenBlock: {
                        next_p = JSRT_ObjGet(cur, "__proto__")
                    }
                    IfCondition EqualTo(ct, JSType.FUNCTION) ThenBlock: {
                        // own __proto__ or Function.prototype
                        fdesc = Dereference(Add(cur, 8))
                        IfCondition NotEqual(fdesc, 0) ThenBlock: {
                            pt = Dereference(Add(fdesc, 64))
                            IfCondition NotEqual(pt, 0) ThenBlock: {
                                next_p = PropTable_Lookup(pt, "__proto__")
                                IfCondition EqualTo(next_p, -1) ThenBlock: { next_p = 0 }
                            }
                        }
                        IfCondition Or(EqualTo(next_p, 0), EqualTo(next_p, JSRTState.undef_val)) ThenBlock: {
                            next_p = JSRTState.function_proto
                        }
                    }
                    IfCondition EqualTo(ct, JSType.ARRAY) ThenBlock: {
                        next_p = JSRTState.array_proto
                    }
                    cur = next_p
                    IfCondition EqualTo(cur, JSRTState.undef_val) ThenBlock: { cur = 0 }
                    IfCondition EqualTo(cur, JSRTState.null_val) ThenBlock: { cur = 0 }
                }
                depth = Add(depth, 1)
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── ARR_IS_ARRAY (55) ───
        IfCondition EqualTo(save_id, JSNativeID.ARR_IS_ARRAY) ThenBlock: {
            ReturnValue(JSBridge__NArrIsArray(save_args, save_argc))
        }

        // ─── ARR_FROM (56) ───
        IfCondition EqualTo(save_id, JSNativeID.ARR_FROM) ThenBlock: {
            ReturnValue(JSBridge__NArrFrom(save_args, save_argc))
        }
        // ─── ARR_OF (207) ───
        IfCondition EqualTo(save_id, JSNativeID.ARR_OF) ThenBlock: {
            ReturnValue(JSBridge__NArrOf(save_args, save_argc))
        }

        // ─── ARR_VALUES / @@iterator (172) — kind 0 ───
        // ─── ARR_KEYS (240) — kind 1 ───
        // ─── ARR_ENTRIES (241) — kind 2 ───
        IfCondition Or(EqualTo(save_id, JSNativeID.ARR_VALUES), Or(EqualTo(save_id, JSNativeID.ARR_KEYS), EqualTo(save_id, JSNativeID.ARR_ENTRIES))) ThenBlock: {
            this_obj = JSVM__GetGlobal("this")
            // Build { __a__: this, __i__: 0, __k__: kind, next: ARR_ITER_NEXT }
            it = JSRT_CreateObject()
            JSRT_ObjSet(it, "__a__", this_obj)
            JSRT__Push(it)
            z2 = JSRT_CreateNumber(0)
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__i__", z2)
            // kind: 0=values, 1=keys, 2=entries
            ikind = 0
            IfCondition EqualTo(save_id, JSNativeID.ARR_KEYS) ThenBlock: { ikind = 1 }
            IfCondition EqualTo(save_id, JSNativeID.ARR_ENTRIES) ThenBlock: { ikind = 2 }
            JSRT__Push(it)
            knd = JSRT_CreateNumber(ikind)
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__k__", knd)
            JSRT__Push(it)
            nf = JSBridge__CreateNativeFunc(JSNativeID.ARR_ITER_NEXT, "next", 0)
            it = JSRT__Pop()
            JSRT_FuncSetEnv(nf, it)
            JSRT_ObjSet(it, "next", nf)
            ReturnValue(it)
        }

        // ─── ARR_ITER_NEXT (173) ───
        IfCondition EqualTo(save_id, JSNativeID.ARR_ITER_NEXT) ThenBlock: {
            // this or env is the iterator record
            it = JSVM__GetGlobal("this")
            // Prefer env from the next function if available via call path - use this
            arr = JSRT_ObjGet(it, "__a__")
            idx_v = JSRT_ObjGet(it, "__i__")
            idx = 0
            IfCondition EqualTo(JSRT_GetType(idx_v), JSType.NUMBER) ThenBlock: {
                idx = Float_ToInt(JSRT_GetPayload(idx_v))
            }
            // kind: 0=values, 1=keys, 2=entries
            kind = 0
            kind_v = JSRT_ObjGet(it, "__k__")
            IfCondition EqualTo(JSRT_GetType(kind_v), JSType.NUMBER) ThenBlock: {
                kind = Float_ToInt(JSRT_GetPayload(kind_v))
            }
            res = JSRT_CreateObject()
            // Array path
            IfCondition EqualTo(JSRT_GetType(arr), JSType.ARRAY) ThenBlock: {
                alen = JSRT_ArrLen(arr)
                IfCondition GreaterEqual(idx, alen) ThenBlock: {
                    JSRT_ObjSet(res, "done", JSRT_True())
                    JSRT_ObjSet(res, "value", JSRT_Undefined())
                    ReturnValue(res)
                }
                JSRT__Push(it)
                JSRT__Push(res)
                // value by kind
                IfCondition EqualTo(kind, 1) ThenBlock: {
                    // keys: yield index
                    ev = JSRT_CreateNumber(idx)
                } ElseBlock: {
                    IfCondition EqualTo(kind, 2) ThenBlock: {
                        // entries: yield [index, value]
                        ev0 = JSRT_ArrGet(arr, idx)
                        ent = JSRT_CreateArray()
                        JSRT__Push(it)
                        JSRT__Push(res)
                        JSRT__Push(ent)
                        ixn = JSRT_CreateNumber(idx)
                        ent = JSRT__Pop()
                        res = JSRT__Pop()
                        it = JSRT__Pop()
                        JSRT_ArrPush(ent, ixn)
                        JSRT_ArrPush(ent, ev0)
                        ev = ent
                    } ElseBlock: {
                        // values (default)
                        ev = JSRT_ArrGet(arr, idx)
                    }
                }
                res = JSRT__Pop()
                it = JSRT__Pop()
                JSRT_ObjSet(res, "value", ev)
                JSRT_ObjSet(res, "done", JSRT_False())
                JSRT__Push(it)
                JSRT__Push(res)
                ni = JSRT_CreateNumber(Add(idx, 1))
                res = JSRT__Pop()
                it = JSRT__Pop()
                JSRT_ObjSet(it, "__i__", ni)
                ReturnValue(res)
            }
            // Array-like (arguments): use length + index props
            len_v = JSRT_ObjGet(arr, "length")
            alen2 = 0
            IfCondition EqualTo(JSRT_GetType(len_v), JSType.NUMBER) ThenBlock: {
                alen2 = Float_ToInt(JSRT_GetPayload(len_v))
            }
            IfCondition GreaterEqual(idx, alen2) ThenBlock: {
                JSRT_ObjSet(res, "done", JSRT_True())
                JSRT_ObjSet(res, "value", JSRT_Undefined())
                ReturnValue(res)
            }
            kbuf = JSVM__ArgIndexKey(idx)
            JSRT__Push(it)
            JSRT__Push(res)
            JSRT__Push(arr)
            IfCondition EqualTo(kind, 1) ThenBlock: {
                ev2 = JSRT_CreateNumber(idx)
            } ElseBlock: {
                IfCondition EqualTo(kind, 2) ThenBlock: {
                    ev2b = JSRT_ObjGet(arr, kbuf)
                    ent2 = JSRT_CreateArray()
                    JSRT__Push(it)
                    JSRT__Push(res)
                    JSRT__Push(ent2)
                    ixn2 = JSRT_CreateNumber(idx)
                    ent2 = JSRT__Pop()
                    res = JSRT__Pop()
                    it = JSRT__Pop()
                    JSRT_ArrPush(ent2, ixn2)
                    JSRT_ArrPush(ent2, ev2b)
                    ev2 = ent2
                } ElseBlock: {
                    ev2 = JSRT_ObjGet(arr, kbuf)
                }
            }
            arr = JSRT__Pop()
            res = JSRT__Pop()
            it = JSRT__Pop()
            JSRT_ObjSet(res, "value", ev2)
            JSRT_ObjSet(res, "done", JSRT_False())
            JSRT__Push(it)
            JSRT__Push(res)
            ni2 = JSRT_CreateNumber(Add(idx, 1))
            res = JSRT__Pop()
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__i__", ni2)
            ReturnValue(res)
        }

        // ─── PROMISE_RESOLVE (57) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_RESOLVE) ThenBlock: {
            p_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                p_val = Dereference(save_args)
            }
            // Already a Promise → return same (identity)
            IfCondition EqualTo(JSRT_GetType(p_val), JSType.OBJECT) ThenBlock: {
                p_st2 = JSRT_ObjGet(p_val, "__state__")
                IfCondition EqualTo(JSRT_GetType(p_st2), JSType.NUMBER) ThenBlock: {
                    p_th2 = JSRT_ObjGet(p_val, "then")
                    IfCondition EqualTo(JSRT_GetType(p_th2), JSType.FUNCTION) ThenBlock: {
                        ReturnValue(p_val)
                    }
                }
            }
            promise = JSRT_CreateObject()
            IfCondition NotEqual(JSRTState.promise_proto, 0) ThenBlock: {
                JSRT_ObjSet(promise, "__proto__", JSRTState.promise_proto)
            }
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(1))
            JSRT_ObjSet(promise, "__value__", p_val)
            // Attach .then and .catch methods with env = promise
            then_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(then_f, promise)
            JSRT_ObjSet(promise, "then", then_f)
            catch_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(catch_f, promise)
            JSRT_ObjSet(promise, "catch", catch_f)
            ReturnValue(promise)
        }

        // ─── PROMISE_REJECT (58) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_REJECT) ThenBlock: {
            p_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                p_val = Dereference(save_args)
            }
            promise = JSRT_CreateObject()
            IfCondition NotEqual(JSRTState.promise_proto, 0) ThenBlock: {
                JSRT_ObjSet(promise, "__proto__", JSRTState.promise_proto)
            }
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(2))
            JSRT_ObjSet(promise, "__value__", p_val)
            then_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(then_f, promise)
            JSRT_ObjSet(promise, "then", then_f)
            catch_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(catch_f, promise)
            JSRT_ObjSet(promise, "catch", catch_f)
            ReturnValue(promise)
        }

        // ─── PROMISE_THEN (59) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_THEN) ThenBlock: {
            // Simplified: execute callback eagerly with resolved value
            // In full impl, would schedule microtask
            ReturnValue(JSRT_Undefined())
        }

        // ─── PROMISE_CATCH (60) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_CATCH) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // ─── PROMISE_CTOR (61) — new Promise(executor) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_CTOR) ThenBlock: {
            // Create promise, call executor(resolve, reject) eagerly
            promise = JSRT_CreateObject()
            // M92: [[Prototype]] = Promise.prototype
            IfCondition NotEqual(JSRTState.promise_proto, 0) ThenBlock: {
                JSRT_ObjSet(promise, "__proto__", JSRTState.promise_proto)
            }
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(0))
            JSRT_ObjSet(promise, "__value__", JSRT_Undefined())
            then_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(then_f, promise)
            JSRT_ObjSet(promise, "then", then_f)
            catch_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(catch_f, promise)
            JSRT_ObjSet(promise, "catch", catch_f)
            ReturnValue(promise)
        }

        // ─── OBJ_CTOR (88) — Object(value) / new Object(value) ───
        // ES: null/undefined/empty → {}; object-like → as-is; else ToObject box
        IfCondition EqualTo(save_id, JSNativeID.OBJ_CTOR) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                oc_arg = Dereference(save_args)
                oc_t = JSRT_GetType(oc_arg)
                IfCondition Or(EqualTo(oc_t, JSType.NULL), EqualTo(oc_t, JSType.UNDEFINED)) ThenBlock: {
                    ReturnValue(JSRT_CreateObject())
                }
                IfCondition Or(Or(EqualTo(oc_t, JSType.OBJECT), EqualTo(oc_t, JSType.ARRAY)), EqualTo(oc_t, JSType.FUNCTION)) ThenBlock: {
                    ReturnValue(oc_arg)
                }
                // Box Boolean / Number / String
                box = JSRT_CreateObject()
                IfCondition EqualTo(oc_t, JSType.BOOLEAN) ThenBlock: {
                    bg = JSVM__GetGlobal("Boolean")
                    bp = JSRT_ObjGet(bg, "prototype")
                    IfCondition EqualTo(JSRT_GetType(bp), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(box, "__proto__", bp)
                    }
                    JSRT_ObjSet(box, "__value__", oc_arg)
                    JSRT_ObjSet(box, "__class__", JSRT_CreateString("Boolean"))
                    ReturnValue(box)
                }
                IfCondition EqualTo(oc_t, JSType.NUMBER) ThenBlock: {
                    ng = JSVM__GetGlobal("Number")
                    np = JSRT_ObjGet(ng, "prototype")
                    IfCondition EqualTo(JSRT_GetType(np), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(box, "__proto__", np)
                    }
                    JSRT_ObjSet(box, "__value__", oc_arg)
                    JSRT_ObjSet(box, "__class__", JSRT_CreateString("Number"))
                    ReturnValue(box)
                }
                IfCondition EqualTo(oc_t, JSType.BIGINT) ThenBlock: {
                    big = JSVM__GetGlobal("BigInt")
                    bp = JSRT_ObjGet(big, "prototype")
                    IfCondition EqualTo(JSRT_GetType(bp), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(box, "__proto__", bp)
                    }
                    JSRT_ObjSet(box, "__value__", oc_arg)
                    JSRT_ObjSet(box, "__class__", JSRT_CreateString("BigInt"))
                    ReturnValue(box)
                }
                IfCondition EqualTo(oc_t, JSType.STRING) ThenBlock: {
                    sg = JSVM__GetGlobal("String")
                    sp = JSRT_ObjGet(sg, "prototype")
                    IfCondition EqualTo(JSRT_GetType(sp), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(box, "__proto__", sp)
                    }
                    JSRT_ObjSet(box, "__value__", oc_arg)
                    JSRT_ObjSet(box, "__class__", JSRT_CreateString("String"))
                    // length + indices for array-like / String exotic
                    spay = JSRT_GetPayload(oc_arg)
                    slen = 0
                    IfCondition NotEqual(spay, 0) ThenBlock: { slen = JSRT_StrLen(spay) }
                    JSRT_ObjSet(box, "length", JSRT_CreateNumber(slen))
                    // M39: slab-copy index keys (IntToStr is a static buffer)
                    si = 0
                    WhileLoop LessThan(si, slen) {
                        JSBridge__Push(box)
                        JSBridge__Push(oc_arg)
                        JSBridge__Push(si)
                        JSBridge__Push(slen)
                        JSBridge__Push(spay)
                        chv = JSRT_CreateStringSlice(spay, si, 1)
                        tmpk = JSRT__IntToStr(si)
                        klen = StringLength(tmpk)
                        kptr = JSRT__StrSlabAlloc(Add(klen, 1))
                        IfCondition NotEqual(kptr, 0) ThenBlock: {
                            MemoryCopy(kptr, tmpk, Add(klen, 1))
                        } ElseBlock: {
                            kptr = tmpk
                        }
                        spay = JSBridge__Pop()
                        slen = JSBridge__Pop()
                        si = JSBridge__Pop()
                        oc_arg = JSBridge__Pop()
                        box = JSBridge__Pop()
                        JSBridge__Push(box)
                        JSBridge__Push(oc_arg)
                        JSBridge__Push(si)
                        JSBridge__Push(slen)
                        JSBridge__Push(spay)
                        JSRT_ObjSet(box, kptr, chv)
                        spay = JSBridge__Pop()
                        slen = JSBridge__Pop()
                        si = JSBridge__Pop()
                        oc_arg = JSBridge__Pop()
                        box = JSBridge__Pop()
                        si = Add(si, 1)
                    }
                    ReturnValue(box)
                }
            }
            ReturnValue(JSRT_CreateObject())
        }

        // ─── DATE_NOW (175) — Date.now() → ms ───
        IfCondition EqualTo(save_id, JSNativeID.DATE_NOW) ThenBlock: {
            // ~2023-11 ms without huge literal: 1700 * 1e9
            ms = Multiply(1700, 1000000000)
            ReturnValue(JSRT_CreateNumber(ms))
        }

        // ─── DATE_CTOR (176) — new Date() / Date() → Date instance ───
        IfCondition EqualTo(save_id, JSNativeID.DATE_CTOR) ThenBlock: {
            sec = SystemCall(201, 0, 0, 0, 0, 0, 0)
            IfCondition LessThan(sec, 0) ThenBlock: { sec = 0 }
            ms = Multiply(sec, 1000)
            dobj = JSRT_CreateObject()
            // Prefer Date.prototype from global
            dg = JSVM__GetGlobal("Date")
            dproto = 0
            IfCondition EqualTo(JSRT_GetType(dg), JSType.FUNCTION) ThenBlock: {
                dproto = JSRT_ObjGet(dg, "prototype")
            }
            IfCondition EqualTo(JSRT_GetType(dproto), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(dobj, "__proto__", dproto)
            } ElseBlock: {
                IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                    JSRT_ObjSet(dobj, "__proto__", JSRTState.object_proto)
                }
            }
            JSRT_ObjSet(dobj, "__class__", JSRT_CreateString("Date"))
            JSRT_ObjSet(dobj, "__time__", JSRT_CreateNumber(ms))
            ReturnValue(dobj)
        }

        // ─── MATH_SQRT (89) — Newton-Raphson sqrt ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_SQRT) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                // Handle 0 and negative
                sq_zero = Float_FromInt(0)
                IfCondition EqualTo(Float_Eq(nval, sq_zero), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateFloat(sq_zero))
                }
                IfCondition EqualTo(Float_Lt(nval, sq_zero), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateFloat(9221120237041090560))
                }
                // Newton-Raphson: guess = x/2, iterate 20 times
                sq_two = Float_FromInt(2)
                sq_guess = Float_Div(nval, sq_two)
                sq_i = 0
                WhileLoop LessThan(sq_i, 20) {
                    sq_guess = Float_Div(Float_Add(sq_guess, Float_Div(nval, sq_guess)), sq_two)
                    sq_i = Add(sq_i, 1)
                }
                ReturnValue(JSRT_CreateFloat(sq_guess))
            }
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }

        // ─── MATH_SIN (90) — minimax polynomial on [-π/4, π/4] with range reduction ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_SIN) ThenBlock: {
            ReturnValue(JSBridge__MathSin(save_args, save_argc))
        }

        // ─── MATH_COS (91) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_COS) ThenBlock: {
            ReturnValue(JSBridge__MathCos(save_args, save_argc))
        }

        // ─── MATH_LOG (92) — natural logarithm ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_LOG) ThenBlock: {
            ReturnValue(JSBridge__MathLog(save_args, save_argc))
        }

        // ─── MATH_EXP (93) — e^x ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_EXP) ThenBlock: {
            ReturnValue(JSBridge__MathExp(save_args, save_argc))
        }

        // ─── MATH_RANDOM (94) — pseudo-random [0,1) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_RANDOM) ThenBlock: {
            ReturnValue(JSBridge__MathRandom())
        }

        // ─── MATH_TAN (95) — sin/cos ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_TAN) ThenBlock: {
            ReturnValue(JSBridge__MathTan(save_args, save_argc))
        }

        // ─── MATH_ATAN2 (96) — atan2(y, x) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_ATAN2) ThenBlock: {
            ReturnValue(JSBridge__MathAtan2(save_args, save_argc))
        }

        // ─── DOC_CREATE_TEXT (100) — document.createTextNode(text) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_CREATE_TEXT) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: {
                ReturnValue(JSBridge_WrapNode(DOM_CreateTextNode("", 0)))
            }
            arg0 = Dereference(save_args)
            str0 = JSRT_ToString(arg0)
            s_ptr = JSRT_GetPayload(str0)
            IfCondition EqualTo(s_ptr, 0) ThenBlock: {
                ReturnValue(JSBridge_WrapNode(DOM_CreateTextNode("", 0)))
            }
            s_len = StringLength(s_ptr)
            ReturnValue(JSBridge_WrapNode(DOM_CreateTextNode(s_ptr, s_len)))
        }

        // ─── DOC_CREATE_COMMENT (101) — document.createComment(text) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_CREATE_COMMENT) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: {
                ReturnValue(JSBridge_WrapNode(DOM_CreateComment("", 0)))
            }
            arg0 = Dereference(save_args)
            str0 = JSRT_ToString(arg0)
            s_ptr = JSRT_GetPayload(str0)
            IfCondition EqualTo(s_ptr, 0) ThenBlock: {
                ReturnValue(JSBridge_WrapNode(DOM_CreateComment("", 0)))
            }
            s_len = StringLength(s_ptr)
            ReturnValue(JSBridge_WrapNode(DOM_CreateComment(s_ptr, s_len)))
        }

        // ─── ELEM_INSERT_BEFORE (102) — node.insertBefore(newNode, refNode) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_INSERT_BEFORE) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            parent_idx = JSBridge__GetThisDomIdx()
            arg1 = Dereference(save_args)
            new_idx = JSBridge__GetArgDomIdx(save_args, 0)
            ref_idx = -1
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                arg2 = Dereference(Add(save_args, 8))
                a2_type = JSRT_GetType(arg2)
                IfCondition NotEqual(a2_type, 1) ThenBlock: {
                    ref_idx = JSBridge__GetArgDomIdx(save_args, 8)
                }
            }
            DOM_InsertBefore(parent_idx, new_idx, ref_idx)
            ReturnValue(arg1)
        }

        // ─── ELEM_REPLACE_CHILD (103) — node.replaceChild(newChild, oldChild) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_REPLACE_CHILD) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            parent_idx = JSBridge__GetThisDomIdx()
            new_idx = JSBridge__GetArgDomIdx(save_args, 0)
            old_idx = JSBridge__GetArgDomIdx(save_args, 8)
            DOM_ReplaceChild(parent_idx, new_idx, old_idx)
            ReturnValue(Dereference(Add(save_args, 8)))
        }

        // ─── ELEM_CONTAINS (104) — node.contains(other) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CONTAINS) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            anc_idx = JSBridge__GetThisDomIdx()
            other_idx = JSBridge__GetArgDomIdx(save_args, 0)
            result = DOM_Contains(anc_idx, other_idx)
            ReturnValue(JSRT_CreateBool(result))
        }

        // ─── ELEM_PARENT_NODE (105) — node.parentNode getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_PARENT_NODE) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            p_idx = DOM_GetParent(node_idx)
            IfCondition LessThan(p_idx, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSBridge_WrapNode(p_idx))
        }

        // ─── ELEM_CHILD_NODES (106) — node.childNodes getter (returns array) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CHILD_NODES) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            arr = JSRT_CreateArray()
            ch = DOM_GetFirstChild(node_idx)
            WhileLoop NotEqual(ch, -1) {
                JSBridge__Push(arr)
                JSBridge__Push(ch)
                wrapped = JSBridge_WrapNode(ch)
                ch = JSBridge__Pop()
                arr = JSBridge__Pop()
                JSRT_ArrPush(arr, wrapped)
                ch = DOM_GetNextSib(ch)
            }
            ReturnValue(arr)
        }

        // ─── ELEM_FIRST_CHILD (107) — node.firstChild getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_FIRST_CHILD) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            fc_idx = DOM_GetFirstChild(node_idx)
            IfCondition LessThan(fc_idx, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSBridge_WrapNode(fc_idx))
        }

        // ─── ELEM_LAST_CHILD (108) — node.lastChild getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_LAST_CHILD) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            lc_idx = DOM_GetLastChild(node_idx)
            IfCondition LessThan(lc_idx, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSBridge_WrapNode(lc_idx))
        }

        // ─── ELEM_NEXT_SIBLING (109) — node.nextSibling getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_NEXT_SIBLING) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            ns_idx = DOM_GetNextSib(node_idx)
            IfCondition LessThan(ns_idx, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSBridge_WrapNode(ns_idx))
        }

        // ─── ELEM_PREV_SIBLING (110) — node.previousSibling getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_PREV_SIBLING) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            ps_idx = DOM_GetPrevSib(node_idx)
            IfCondition LessThan(ps_idx, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSBridge_WrapNode(ps_idx))
        }

        // ─── ELEM_REMOVE (111) — node.remove() ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_REMOVE) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            p_idx = DOM_GetParent(node_idx)
            IfCondition GreaterEqual(p_idx, 0) ThenBlock: {
                DOM_RemoveChild(p_idx, node_idx)
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_TAG_NAME (112) — node.tagName getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_TAG_NAME) ThenBlock: {
            node_idx = JSBridge__GetThisDomIdx()
            tag_p = DOM_GetTag(node_idx)
            IfCondition EqualTo(tag_p, 0) ThenBlock: { ReturnValue(JSRT_Null()) }
            ReturnValue(JSRT_CreateString(tag_p))
        }

        // ─── ELEM_SET_TEXT_CONTENT (113) — node.textContent = val ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_SET_TEXT_CONTENT) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            node_idx = JSBridge__GetThisDomIdx()
            arg1 = Dereference(save_args)
            str1 = JSRT_ToString(arg1)
            t_ptr = JSRT_GetPayload(str1)
            t_len = 0
            IfCondition NotEqual(t_ptr, 0) ThenBlock: {
                t_len = StringLength(t_ptr)
            }
            DOM_SetTextContent(node_idx, t_ptr, t_len)
            ReturnValue(JSRT_Undefined())
        }

        // ─── DOC_QUERY_SEL_ALL (114) — document.querySelectorAll(sel) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_QUERY_SEL_ALL) ThenBlock: {
            // Simplified: returns array of wrapped nodes matching tag/class/id
            arr = JSRT_CreateArray()
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(arr) }
            arg0 = Dereference(save_args)
            str0 = JSRT_ToString(arg0)
            sel_ptr = JSRT_GetPayload(str0)
            IfCondition EqualTo(sel_ptr, 0) ThenBlock: { ReturnValue(arr) }
            // Use DOM_GetElementsByTagName for tag selectors
            sel_c0 = GetByte(sel_ptr, 0)
            // Allocate result buffer (up to 256 results)
            rbuf = Allocate(2048)
            count = 0
            IfCondition EqualTo(sel_c0, 46) ThenBlock: {
                // .class selector
                count = DOM_GetElementsByClassName(DOMState.root, Add(sel_ptr, 1), rbuf, 256)
            }
            IfCondition NotEqual(sel_c0, 46) ThenBlock: {
                IfCondition EqualTo(sel_c0, 35) ThenBlock: {
                    // #id selector — find single element
                    found = DOM_FindById(DOMState.root, Add(sel_ptr, 1))
                    IfCondition GreaterEqual(found, 0) ThenBlock: {
                        StoreValue(rbuf, found)
                        count = 1
                    }
                }
                IfCondition NotEqual(sel_c0, 35) ThenBlock: {
                    // tag selector
                    count = DOM_GetElementsByTagName(DOMState.root, sel_ptr, rbuf, 256)
                }
            }
            // Wrap each result
            ci = 0
            WhileLoop LessThan(ci, count) {
                JSBridge__Push(arr)
                JSBridge__Push(ci)
                ni = Dereference(Add(rbuf, Multiply(ci, 8)))
                wrapped = JSBridge_WrapNode(ni)
                ci = JSBridge__Pop()
                arr = JSBridge__Pop()
                JSRT_ArrPush(arr, wrapped)
                ci = Add(ci, 1)
            }
            ReturnValue(arr)
        }

        // ─── ELEM_CLASS_LIST_ADD (115) — element.classList.add(cls) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLASS_LIST_ADD) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            cl_idx = JSBridge__GetThisDomIdx()
            cl_arg = Dereference(save_args)
            JSBridge__Push(cl_idx)
            cl_str = JSRT_ToString(cl_arg)
            cl_idx = JSBridge__Pop()
            cl_new = JSRT_GetPayload(cl_str)
            IfCondition EqualTo(cl_new, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            JSBridge__Push(cl_new)
            JSBridge__Push(cl_idx)
            cl_cur = DOM_GetAttr(cl_idx, "class")
            cl_idx = JSBridge__Pop()
            cl_new = JSBridge__Pop()
            // Build new class string: "old new" or just "new"
            cl_nlen = StringLength(cl_new)
            IfCondition EqualTo(cl_cur, 0) ThenBlock: {
                cl_buf = JSRT__StrSlabAlloc(Add(cl_nlen, 1))
                MemoryCopy(cl_buf, cl_new, cl_nlen)
                SetByte(cl_buf, cl_nlen, 0)
                DOM_SetAttr(cl_idx, "class", cl_buf)
            } ElseBlock: {
                // Check if class already present (simple substring check)
                cl_found = StringIndexOf(cl_cur, cl_new)
                IfCondition LessThan(cl_found, 0) ThenBlock: {
                    cl_olen = StringLength(cl_cur)
                    cl_total = Add(Add(cl_olen, 1), cl_nlen)
                    cl_buf = JSRT__StrSlabAlloc(Add(cl_total, 1))
                    MemoryCopy(cl_buf, cl_cur, cl_olen)
                    SetByte(cl_buf, cl_olen, 32)
                    MemoryCopy(Add(cl_buf, Add(cl_olen, 1)), cl_new, cl_nlen)
                    SetByte(cl_buf, cl_total, 0)
                    DOM_SetAttr(cl_idx, "class", cl_buf)
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_CLASS_LIST_RM (116) — element.classList.remove(cls) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLASS_LIST_RM) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            cr_idx = JSBridge__GetThisDomIdx()
            cr_arg = Dereference(save_args)
            JSBridge__Push(cr_idx)
            cr_str = JSRT_ToString(cr_arg)
            cr_idx = JSBridge__Pop()
            cr_rem = JSRT_GetPayload(cr_str)
            IfCondition EqualTo(cr_rem, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            JSBridge__Push(cr_rem)
            JSBridge__Push(cr_idx)
            cr_cur = DOM_GetAttr(cr_idx, "class")
            cr_idx = JSBridge__Pop()
            cr_rem = JSBridge__Pop()
            IfCondition NotEqual(cr_cur, 0) ThenBlock: {
                cr_pos = StringIndexOf(cr_cur, cr_rem)
                IfCondition GreaterEqual(cr_pos, 0) ThenBlock: {
                    // Rebuild class string without the removed token
                    cr_olen = StringLength(cr_cur)
                    cr_rlen = StringLength(cr_rem)
                    cr_buf = JSRT__StrSlabAlloc(Add(cr_olen, 1))
                    cr_wi = 0
                    cr_ri = 0
                    WhileLoop LessThan(cr_ri, cr_olen) {
                        // Skip past the removed class token
                        IfCondition EqualTo(cr_ri, cr_pos) ThenBlock: {
                            cr_ri = Add(cr_ri, cr_rlen)
                            // Skip trailing space
                            IfCondition LessThan(cr_ri, cr_olen) ThenBlock: {
                                IfCondition EqualTo(GetByte(cr_cur, cr_ri), 32) ThenBlock: {
                                    cr_ri = Add(cr_ri, 1)
                                }
                            }
                        } ElseBlock: {
                            SetByte(cr_buf, cr_wi, GetByte(cr_cur, cr_ri))
                            cr_wi = Add(cr_wi, 1)
                            cr_ri = Add(cr_ri, 1)
                        }
                    }
                    // Trim trailing space
                    IfCondition GreaterThan(cr_wi, 0) ThenBlock: {
                        IfCondition EqualTo(GetByte(cr_buf, Subtract(cr_wi, 1)), 32) ThenBlock: {
                            cr_wi = Subtract(cr_wi, 1)
                        }
                    }
                    SetByte(cr_buf, cr_wi, 0)
                    DOM_SetAttr(cr_idx, "class", cr_buf)
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_CLASS_LIST_TOG (117) — element.classList.toggle(cls) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLASS_LIST_TOG) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            ct_idx = JSBridge__GetThisDomIdx()
            ct_arg = Dereference(save_args)
            JSBridge__Push(ct_idx)
            ct_str = JSRT_ToString(ct_arg)
            ct_idx = JSBridge__Pop()
            ct_tok = JSRT_GetPayload(ct_str)
            IfCondition EqualTo(ct_tok, 0) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            JSBridge__Push(ct_tok)
            JSBridge__Push(ct_idx)
            ct_cur = DOM_GetAttr(ct_idx, "class")
            ct_idx = JSBridge__Pop()
            ct_tok = JSBridge__Pop()
            ct_has = 0
            IfCondition NotEqual(ct_cur, 0) ThenBlock: {
                IfCondition GreaterEqual(StringIndexOf(ct_cur, ct_tok), 0) ThenBlock: {
                    ct_has = 1
                }
            }
            IfCondition EqualTo(ct_has, 1) ThenBlock: {
                // Remove — call classList.remove logic inline
                // Simplified: set class to empty for v1
                DOM_SetAttr(ct_idx, "class", "")
                ReturnValue(JSRT_CreateBool(0))
            } ElseBlock: {
                // Add
                ct_nlen = StringLength(ct_tok)
                IfCondition EqualTo(ct_cur, 0) ThenBlock: {
                    ct_buf = JSRT__StrSlabAlloc(Add(ct_nlen, 1))
                    MemoryCopy(ct_buf, ct_tok, ct_nlen)
                    SetByte(ct_buf, ct_nlen, 0)
                    DOM_SetAttr(ct_idx, "class", ct_buf)
                } ElseBlock: {
                    ct_olen = StringLength(ct_cur)
                    ct_total = Add(Add(ct_olen, 1), ct_nlen)
                    ct_buf = JSRT__StrSlabAlloc(Add(ct_total, 1))
                    MemoryCopy(ct_buf, ct_cur, ct_olen)
                    SetByte(ct_buf, ct_olen, 32)
                    MemoryCopy(Add(ct_buf, Add(ct_olen, 1)), ct_tok, ct_nlen)
                    SetByte(ct_buf, ct_total, 0)
                    DOM_SetAttr(ct_idx, "class", ct_buf)
                }
                ReturnValue(JSRT_CreateBool(1))
            }
        }

        // ─── ELEM_CLASS_LIST_HAS (118) — element.classList.contains(cls) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLASS_LIST_HAS) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            ch_idx = JSBridge__GetThisDomIdx()
            ch_arg = Dereference(save_args)
            JSBridge__Push(ch_idx)
            ch_str = JSRT_ToString(ch_arg)
            ch_idx = JSBridge__Pop()
            ch_tok = JSRT_GetPayload(ch_str)
            IfCondition EqualTo(ch_tok, 0) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            JSBridge__Push(ch_idx)
            ch_cur = DOM_GetAttr(ch_idx, "class")
            ch_idx = JSBridge__Pop()
            IfCondition EqualTo(ch_cur, 0) ThenBlock: { ReturnValue(JSRT_CreateBool(0)) }
            IfCondition GreaterEqual(StringIndexOf(ch_cur, ch_tok), 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
            ReturnValue(JSRT_CreateBool(0))
        }

        // ─── ELEM_GET_ELEMS_TAG (119) — getElementsByTagName ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_GET_ELEMS_TAG) ThenBlock: {
            arr = JSRT_CreateArray()
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(arr) }
            node_idx = JSBridge__GetDomIdx(save_args)
            arg1 = Dereference(Add(save_args, 8))
            str1 = JSRT_ToString(arg1)
            tag_ptr = JSRT_GetPayload(str1)
            IfCondition EqualTo(tag_ptr, 0) ThenBlock: { ReturnValue(arr) }
            rbuf = Allocate(2048)
            count = DOM_GetElementsByTagName(node_idx, tag_ptr, rbuf, 256)
            ci = 0
            WhileLoop LessThan(ci, count) {
                JSBridge__Push(arr)
                JSBridge__Push(ci)
                ni = Dereference(Add(rbuf, Multiply(ci, 8)))
                wrapped = JSBridge_WrapNode(ni)
                ci = JSBridge__Pop()
                arr = JSBridge__Pop()
                JSRT_ArrPush(arr, wrapped)
                ci = Add(ci, 1)
            }
            ReturnValue(arr)
        }

        // ─── ELEM_GET_ELEMS_CLS (120) — getElementsByClassName ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_GET_ELEMS_CLS) ThenBlock: {
            arr = JSRT_CreateArray()
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(arr) }
            node_idx = JSBridge__GetDomIdx(save_args)
            arg1 = Dereference(Add(save_args, 8))
            str1 = JSRT_ToString(arg1)
            cls_ptr = JSRT_GetPayload(str1)
            IfCondition EqualTo(cls_ptr, 0) ThenBlock: { ReturnValue(arr) }
            rbuf = Allocate(2048)
            count = DOM_GetElementsByClassName(node_idx, cls_ptr, rbuf, 256)
            ci = 0
            WhileLoop LessThan(ci, count) {
                JSBridge__Push(arr)
                JSBridge__Push(ci)
                ni = Dereference(Add(rbuf, Multiply(ci, 8)))
                wrapped = JSBridge_WrapNode(ni)
                ci = JSBridge__Pop()
                arr = JSBridge__Pop()
                JSRT_ArrPush(arr, wrapped)
                ci = Add(ci, 1)
            }
            ReturnValue(arr)
        }

        // ─── WIN_MATCH_MEDIA (121) — window.matchMedia(query) ───
        // Returns { matches: false, media: query, addEventListener: stub }
        IfCondition EqualTo(save_id, JSNativeID.WIN_MATCH_MEDIA) ThenBlock: {
            mql = JSRT_CreateObject()
            // Default: matches = false (dark mode not detected)
            JSRT_ObjSet(mql, "matches", JSRT_CreateBool(0))
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                mq_arg = Dereference(save_args)
                mq_str = JSRT_ToString(mq_arg)
                JSRT_ObjSet(mql, "media", mq_str)
            } ElseBlock: {
                JSRT_ObjSet(mql, "media", JSRT_CreateString(""))
            }
            // Stub addEventListener on the MediaQueryList
            JSRT_ObjSet(mql, "addEventListener", JSRT_Undefined())
            JSRT_ObjSet(mql, "addListener", JSRT_Undefined())
            ReturnValue(mql)
        }

        // ─── WIN_ADD_EVENT_LISTENER (122) — window.addEventListener(event, cb) ───
        IfCondition EqualTo(save_id, JSNativeID.WIN_ADD_EVENT_LISTENER) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            // args[0] = event name, args[1] = callback
            wae_name = Dereference(save_args)
            wae_nstr = JSRT_GetPayload(wae_name)
            IfCondition EqualTo(wae_nstr, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            wae_cb = Dereference(Add(save_args, 8))
            // Register on DOM root (0) as window proxy
            JSBridge_AddListener(0, wae_nstr, wae_cb)
            ReturnValue(JSRT_Undefined())
        }

        // ─── WIN_GET_COMPUTED_STYLE (123) — window.getComputedStyle(elem) ───
        IfCondition EqualTo(save_id, JSNativeID.WIN_GET_COMPUTED_STYLE) ThenBlock: {
            cs = JSRT_CreateObject()
            // Get DOM node from argument
            gcs_dom = -1
            IfCondition GreaterEqual(save_argc, 1) ThenBlock: {
                gcs_arg = Dereference(save_args)
                gcs_dom = JSBridge__GetDomIdx(gcs_arg)
            }
            IfCondition LessThan(gcs_dom, 0) ThenBlock: {
                // No valid element — return defaults
                JSRT_ObjSet(cs, "display", JSRT_CreateString("block"))
                JSRT_ObjSet(cs, "visibility", JSRT_CreateString("visible"))
                JSRT_ObjSet(cs, "position", JSRT_CreateString("static"))
                ReturnValue(cs)
            }
            // Look up common properties via inline style + CSS rules
            // display
            gcs_v = JSBridge__CSSLookup(gcs_dom, "display")
            JSRT__Push(cs)
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                cs = JSRT__Pop()
                JSRT_ObjSet(cs, "display", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                cs = JSRT__Pop()
                JSRT_ObjSet(cs, "display", JSRT_CreateString("block"))
            }
            // visibility
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "visibility")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "visibility", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "visibility", JSRT_CreateString("visible"))
            }
            // position
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "position")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "position", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "position", JSRT_CreateString("static"))
            }
            // color
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "color")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "color", JSRT_CreateString(gcs_v))
            }
            // background-color (also as backgroundColor)
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "background-color")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "backgroundColor", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "background-color", JSRT_CreateString(gcs_v))
            }
            // float (also as cssFloat)
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "float")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "float", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "cssFloat", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "float", JSRT_CreateString("none"))
                JSRT_ObjSet(cs, "cssFloat", JSRT_CreateString("none"))
            }
            // clear
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "clear")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "clear", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "clear", JSRT_CreateString("none"))
            }
            // overflow
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "overflow")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "overflow", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "overflow", JSRT_CreateString("visible"))
            }
            // width, height
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "width")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "width", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "width", JSRT_CreateString("auto"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "height")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "height", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "height", JSRT_CreateString("auto"))
            }
            // margin-top/right/bottom/left (also camelCase)
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "margin-top")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "margin-top", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "marginTop", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "margin-top", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "marginTop", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "margin-right")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "margin-right", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "marginRight", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "margin-right", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "marginRight", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "margin-bottom")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "margin-bottom", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "marginBottom", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "margin-bottom", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "marginBottom", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "margin-left")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "margin-left", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "marginLeft", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "margin-left", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "marginLeft", JSRT_CreateString("0px"))
            }
            // padding-top/right/bottom/left
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "padding-top")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "padding-top", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "paddingTop", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "padding-top", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "paddingTop", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "padding-right")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "padding-right", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "paddingRight", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "padding-right", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "paddingRight", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "padding-bottom")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "padding-bottom", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "paddingBottom", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "padding-bottom", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "paddingBottom", JSRT_CreateString("0px"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "padding-left")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "padding-left", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "paddingLeft", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "padding-left", JSRT_CreateString("0px"))
                JSRT_ObjSet(cs, "paddingLeft", JSRT_CreateString("0px"))
            }
            // font-size, font-weight, font-family
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "font-size")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "fontSize", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "font-size", JSRT_CreateString(gcs_v))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "font-weight")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "fontWeight", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "font-weight", JSRT_CreateString(gcs_v))
            }
            // opacity
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "opacity")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "opacity", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "opacity", JSRT_CreateString("1"))
            }
            // text-align, text-decoration
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "text-align")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "textAlign", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "text-align", JSRT_CreateString(gcs_v))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "text-decoration")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "textDecoration", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "text-decoration", JSRT_CreateString(gcs_v))
            }
            // border-color, border-style, border-width
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "border-color")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "borderColor", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "border-color", JSRT_CreateString(gcs_v))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "border-style")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "borderStyle", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "border-style", JSRT_CreateString(gcs_v))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "border-width")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "borderWidth", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "border-width", JSRT_CreateString(gcs_v))
            }
            // max-width, max-height, min-width, min-height
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "max-width")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "maxWidth", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "max-width", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "maxWidth", JSRT_CreateString("none"))
                JSRT_ObjSet(cs, "max-width", JSRT_CreateString("none"))
            }
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "max-height")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "maxHeight", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "max-height", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "maxHeight", JSRT_CreateString("none"))
                JSRT_ObjSet(cs, "max-height", JSRT_CreateString("none"))
            }
            // line-height
            JSRT__Push(cs)
            gcs_v = JSBridge__CSSLookup(gcs_dom, "line-height")
            cs = JSRT__Pop()
            IfCondition NotEqual(gcs_v, 0) ThenBlock: {
                JSRT_ObjSet(cs, "lineHeight", JSRT_CreateString(gcs_v))
                JSRT_ObjSet(cs, "line-height", JSRT_CreateString(gcs_v))
            } ElseBlock: {
                JSRT_ObjSet(cs, "lineHeight", JSRT_CreateString("normal"))
                JSRT_ObjSet(cs, "line-height", JSRT_CreateString("normal"))
            }
            ReturnValue(cs)
        }

        // ─── WIN_REQUEST_ANIM_FRAME (124) — requestAnimationFrame(cb) ───
        IfCondition EqualTo(save_id, JSNativeID.WIN_REQUEST_ANIM_FRAME) ThenBlock: {
            // Return a fake ID (non-zero) — actual scheduling not implemented
            ReturnValue(JSRT_CreateNumber(1))
        }

        // ─── WIN_CANCEL_ANIM_FRAME (125) — cancelAnimationFrame(id) ───
        IfCondition EqualTo(save_id, JSNativeID.WIN_CANCEL_ANIM_FRAME) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // ─── DOC_ADD_EVENT_LISTENER (126) — document.addEventListener(event, cb) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_ADD_EVENT_LISTENER) ThenBlock: {
            // If event is "DOMContentLoaded", call cb immediately (page is already loaded)
            IfCondition GreaterEqual(save_argc, 2) ThenBlock: {
                ev_arg = Dereference(save_args)
                ev_str = JSRT_ToString(ev_arg)
                ev_ptr = JSRT_GetPayload(ev_str)
                // Check if "DOMContentLoaded" — starts with 'D' (68)
                IfCondition EqualTo(GetByte(ev_ptr, 0), 68) ThenBlock: {
                    // Call the callback immediately
                    cb_val = Dereference(Add(save_args, 8))
                    cb_type = JSRT_GetType(cb_val)
                    IfCondition EqualTo(cb_type, JSType.FUNCTION) ThenBlock: {
                        JSVM__CallFunc(cb_val, 0, 0)
                    }
                }
                // "load" — starts with 'l' (108)
                IfCondition EqualTo(GetByte(ev_ptr, 0), 108) ThenBlock: {
                    cb_val = Dereference(Add(save_args, 8))
                    cb_type = JSRT_GetType(cb_val)
                    IfCondition EqualTo(cb_type, JSType.FUNCTION) ThenBlock: {
                        JSVM__CallFunc(cb_val, 0, 0)
                    }
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── LOCALSTORAGE_GET (127) — localStorage.getItem(key) ───
        IfCondition EqualTo(save_id, JSNativeID.LOCALSTORAGE_GET) ThenBlock: {
            // Stub — always returns null (no persistent storage yet)
            ReturnValue(JSRT_Null())
        }

        // ─── LOCALSTORAGE_SET (128) — localStorage.setItem(key, value) ───
        IfCondition EqualTo(save_id, JSNativeID.LOCALSTORAGE_SET) ThenBlock: {
            // Stub — accept silently
            ReturnValue(JSRT_Undefined())
        }

        // ─── LOCALSTORAGE_REMOVE (129) — localStorage.removeItem(key) ───
        IfCondition EqualTo(save_id, JSNativeID.LOCALSTORAGE_REMOVE) ThenBlock: {
            // Stub — accept silently
            ReturnValue(JSRT_Undefined())
        }

        // ─── FETCH (140) — fetch(url, options) → Promise<Response> ───
        IfCondition EqualTo(save_id, JSNativeID.FETCH) ThenBlock: {
            // Build a stub Response object
            resp = JSRT_CreateObject()
            JSRT__Push(resp)
            JSRT_ObjSet(resp, "ok", JSRT_CreateBool(0))
            resp = JSRT__Pop()
            JSRT__Push(resp)
            st_val = JSRT_CreateNumber(0)
            resp = JSRT__Pop()
            JSRT_ObjSet(resp, "status", st_val)
            JSRT__Push(resp)
            st_txt = JSRT_CreateString("Network Error")
            resp = JSRT__Pop()
            JSRT_ObjSet(resp, "statusText", st_txt)
            // text() method — returns Promise resolved with ""
            JSRT__Push(resp)
            txt_fn = JSBridge__CreateNativeFunc(JSNativeID.FETCH_TEXT, "text", 0)
            resp = JSRT__Pop()
            JSRT_ObjSet(resp, "text", txt_fn)
            // json() method — returns Promise resolved with {}
            JSRT__Push(resp)
            json_fn = JSBridge__CreateNativeFunc(JSNativeID.FETCH_JSON, "json", 0)
            resp = JSRT__Pop()
            JSRT_ObjSet(resp, "json", json_fn)
            // Wrap in resolved Promise
            JSRT__Push(resp)
            promise = JSRT_CreateObject()
            JSRT__Push(promise)
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(1))
            resp = JSRT__Pop()
            promise = JSRT__Pop()
            JSRT__Push(promise)
            JSRT_ObjSet(promise, "__value__", resp)
            promise = JSRT__Pop()
            JSRT__Push(promise)
            then_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "then", then_fn)
            JSRT__Push(promise)
            catch_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "catch", catch_fn)
            ReturnValue(promise)
        }

        // ─── FETCH_TEXT (141) — response.text() → Promise<string> ───
        IfCondition EqualTo(save_id, JSNativeID.FETCH_TEXT) ThenBlock: {
            empty_str = JSRT_CreateString("")
            // Wrap in resolved Promise
            JSRT__Push(empty_str)
            promise = JSRT_CreateObject()
            JSRT__Push(promise)
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(1))
            empty_str = JSRT__Pop()
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "__value__", empty_str)
            JSRT__Push(promise)
            then_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "then", then_fn)
            JSRT__Push(promise)
            catch_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "catch", catch_fn)
            ReturnValue(promise)
        }

        // ─── FETCH_JSON (142) — response.json() → Promise<object> ───
        IfCondition EqualTo(save_id, JSNativeID.FETCH_JSON) ThenBlock: {
            empty_obj = JSRT_CreateObject()
            // Wrap in resolved Promise
            JSRT__Push(empty_obj)
            promise = JSRT_CreateObject()
            JSRT__Push(promise)
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(1))
            empty_obj = JSRT__Pop()
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "__value__", empty_obj)
            JSRT__Push(promise)
            then_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "then", then_fn)
            JSRT__Push(promise)
            catch_fn = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            promise = JSRT__Pop()
            JSRT_ObjSet(promise, "catch", catch_fn)
            ReturnValue(promise)
        }

        // ─── ELEM_GET_BOUNDING_RECT (133) — elem.getBoundingClientRect() ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_GET_BOUNDING_RECT) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            bx = JSBridgeState.box_x
            by = JSBridgeState.box_y
            bw = JSBridgeState.box_w
            bh = JSBridgeState.box_h

            rect = JSRT_CreateObject()
            JSRT__Push(rect)
            x_val = JSRT_CreateNumber(bx)
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "x", x_val)
            JSRT_ObjSet(rect, "left", x_val)

            JSRT__Push(rect)
            y_val = JSRT_CreateNumber(by)
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "y", y_val)
            JSRT_ObjSet(rect, "top", y_val)

            JSRT__Push(rect)
            w_val = JSRT_CreateNumber(bw)
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "width", w_val)

            JSRT__Push(rect)
            h_val = JSRT_CreateNumber(bh)
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "height", h_val)

            JSRT__Push(rect)
            r_val = JSRT_CreateNumber(Add(bx, bw))
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "right", r_val)

            JSRT__Push(rect)
            b_val = JSRT_CreateNumber(Add(by, bh))
            rect = JSRT__Pop()
            JSRT_ObjSet(rect, "bottom", b_val)

            ReturnValue(rect)
        }

        // ─── ELEM_OFFSET_WIDTH (134) — elem.offsetWidth getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_OFFSET_WIDTH) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_w))
        }

        // ─── ELEM_OFFSET_HEIGHT (135) — elem.offsetHeight getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_OFFSET_HEIGHT) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_h))
        }

        // ─── ELEM_CLIENT_WIDTH (136) — elem.clientWidth getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLIENT_WIDTH) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            // clientWidth = width minus borders (no borders yet, same as offsetWidth)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_w))
        }

        // ─── ELEM_CLIENT_HEIGHT (137) — elem.clientHeight getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_CLIENT_HEIGHT) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_h))
        }

        // ─── ELEM_SCROLL_WIDTH (138) — elem.scrollWidth getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_SCROLL_WIDTH) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            // scrollWidth = same as clientWidth (no overflow yet)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_w))
        }

        // ─── ELEM_SCROLL_HEIGHT (139) — elem.scrollHeight getter ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_SCROLL_HEIGHT) ThenBlock: {
            dom_idx = JSBridge__GetThisDomIdx()
            JSBridge__FindNodeBox(dom_idx)
            ReturnValue(JSRT_CreateNumber(JSBridgeState.box_h))
        }

        // ─── EVT_PREVENT_DEFAULT (130) — event.preventDefault() ───
        IfCondition EqualTo(save_id, JSNativeID.EVT_PREVENT_DEFAULT) ThenBlock: {
            // Set defaultPrevented = true on the event object
            pd_this = JSVM_GetGlobal("this")
            IfCondition NotEqual(pd_this, 0) ThenBlock: {
                pd_type = JSRT_GetType(pd_this)
                IfCondition EqualTo(pd_type, JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(pd_this, "defaultPrevented", JSRT_CreateBool(1))
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── EVT_STOP_PROPAGATION (131) — event.stopPropagation() ───
        IfCondition EqualTo(save_id, JSNativeID.EVT_STOP_PROPAGATION) ThenBlock: {
            // Set flag on event object — checked by event dispatch loop
            sp_this = JSVM_GetGlobal("this")
            IfCondition NotEqual(sp_this, 0) ThenBlock: {
                sp_type = JSRT_GetType(sp_this)
                IfCondition EqualTo(sp_type, JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(sp_this, "__stop_propagation", JSRT_CreateBool(1))
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── EVT_STOP_IMMEDIATE (132) — event.stopImmediatePropagation() ───
        IfCondition EqualTo(save_id, JSNativeID.EVT_STOP_IMMEDIATE) ThenBlock: {
            // Set flags on event object
            si_this = JSVM_GetGlobal("this")
            IfCondition NotEqual(si_this, 0) ThenBlock: {
                si_type = JSRT_GetType(si_this)
                IfCondition EqualTo(si_type, JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(si_this, "__stop_propagation", JSRT_CreateBool(1))
                    JSRT_ObjSet(si_this, "__stop_immediate", JSRT_CreateBool(1))
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // ─── JSON_PARSE (190) — JSON.parse(text) → value ───
        // Uses Browser.JSRuntime.JSJSON (UTF-16-aware). The old path used
        // GetByte/StringLength on JS string payloads and always returned undefined.
        IfCondition EqualTo(save_id, JSNativeID.JSON_PARSE) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRTState.undef_val) }
            jp_arg = Dereference(save_args)
            ReturnValue(JSJSON_Parse(jp_arg))
        }

        // ─── JSON_STRINGIFY (191) — JSON.stringify(value) → string ───
        IfCondition EqualTo(save_id, JSNativeID.JSON_STRINGIFY) ThenBlock: {
            IfCondition LessThan(save_argc, 1) ThenBlock: { ReturnValue(JSRTState.undef_val) }
            js_arg = Dereference(save_args)
            ReturnValue(JSBridge__JSONStringify(js_arg))
        }

        // ═══════════════════════════════════════════════════════════
        // M62: Map / Set
        // Map: this.__pairs__ = [[k,v], ...]; Set: this.__vals__ = [v, ...]
        // ═══════════════════════════════════════════════════════════

        // PROXY_CTOR (275) — new Proxy(target, handler)  M128e6ac minimal
        IfCondition EqualTo(save_id, JSNativeID.PROXY_CTOR) ThenBlock: {
            tgt = JSRTState.undef_val
            hnd = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                tgt = Dereference(save_args)
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                hnd = Dereference(Add(save_args, 8))
            }
            tt = JSRT_GetType(tgt)
            ht = JSRT_GetType(hnd)
            ok_t = 0
            IfCondition Or(EqualTo(tt, JSType.OBJECT), Or(EqualTo(tt, JSType.FUNCTION), EqualTo(tt, JSType.ARRAY))) ThenBlock: {
                ok_t = 1
            }
            ok_h = 0
            IfCondition Or(EqualTo(ht, JSType.OBJECT), Or(EqualTo(ht, JSType.FUNCTION), EqualTo(ht, JSType.ARRAY))) ThenBlock: {
                ok_h = 1
            }
            IfCondition Or(EqualTo(ok_t, 0), EqualTo(ok_h, 0)) ThenBlock: {
                // Return TypeError object — CONSTRUCT/CALL will leave as result; better than crash
                terr = JSVM_CreateTypedError("TypeError", "Cannot create proxy with non-object")
                ReturnValue(terr)
            }
            pobj = JSRT_CreateObject()
            JSRT_ObjSet(pobj, "__p__", JSRT_True())
            JSRT_ObjSet(pobj, "__p_t__", tgt)
            JSRT_ObjSet(pobj, "__p_h__", hnd)
            ReturnValue(pobj)
        }

        // MAP_CTOR (245) — new Map([iterable])
        IfCondition EqualTo(save_id, JSNativeID.MAP_CTOR) ThenBlock: {
            mobj = JSRT_CreateObject()
            pairs = JSRT_CreateArray()
            JSRT_ObjSet(mobj, "__pairs__", pairs)
            JSRT_ObjSet(mobj, "__class__", JSRT_CreateString("Map"))
            JSRT__Push(mobj)
            zsz = JSRT_CreateNumber(0)
            mobj = JSRT__Pop()
            JSRT_ObjSet(mobj, "size", zsz)
            // optional iterable of [k,v] pairs
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                mit = Dereference(save_args)
                mt = JSRT_GetType(mit)
                IfCondition EqualTo(mt, JSType.ARRAY) ThenBlock: {
                    mi = 0
                    mlen = JSRT_ArrLen(mit)
                    WhileLoop LessThan(mi, mlen) {
                        ment = JSRT_ArrGet(mit, mi)
                        IfCondition EqualTo(JSRT_GetType(ment), JSType.ARRAY) ThenBlock: {
                            IfCondition GreaterEqual(JSRT_ArrLen(ment), 2) ThenBlock: {
                                mk = JSRT_ArrGet(ment, 0)
                                mv = JSRT_ArrGet(ment, 1)
                                // reuse set logic via pairs
                                pairs2 = JSRT_ObjGet(mobj, "__pairs__")
                                found = JSBridge__MapFindIndex(pairs2, mk)
                                IfCondition GreaterEqual(found, 0) ThenBlock: {
                                    entu = JSRT_ArrGet(pairs2, found)
                                    JSRT_ArrSet(entu, 1, mv)
                                } ElseBlock: {
                                    entn = JSRT_CreateArray()
                                    JSRT_ArrPush(entn, mk)
                                    JSRT_ArrPush(entn, mv)
                                    JSRT_ArrPush(pairs2, entn)
                                }
                            }
                        }
                        mi = Add(mi, 1)
                    }
                    JSRT__Push(mobj)
                    nsz = JSRT_CreateNumber(JSRT_ArrLen(JSRT_ObjGet(mobj, "__pairs__")))
                    mobj = JSRT__Pop()
                    JSRT_ObjSet(mobj, "size", nsz)
                }
            }
            ReturnValue(mobj)
        }

        // MAP_SET (246) — this.set(key, value)
        IfCondition EqualTo(save_id, JSNativeID.MAP_SET) ThenBlock: {
            mthis = JSVM__GetGlobal("this")
            pairs = JSRT_ObjGet(mthis, "__pairs__")
            IfCondition NotEqual(JSRT_GetType(pairs), JSType.ARRAY) ThenBlock: {
                pairs = JSRT_CreateArray()
                JSRT_ObjSet(mthis, "__pairs__", pairs)
            }
            mk = JSRTState.undef_val
            mv = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { mk = Dereference(save_args) }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: { mv = Dereference(Add(save_args, 8)) }
            found = JSBridge__MapFindIndex(pairs, mk)
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                entu = JSRT_ArrGet(pairs, found)
                JSRT_ArrSet(entu, 1, mv)
            } ElseBlock: {
                entn = JSRT_CreateArray()
                JSRT_ArrPush(entn, mk)
                JSRT_ArrPush(entn, mv)
                JSRT_ArrPush(pairs, entn)
            }
            JSRT__Push(mthis)
            nsz = JSRT_CreateNumber(JSRT_ArrLen(pairs))
            mthis = JSRT__Pop()
            JSRT_ObjSet(mthis, "size", nsz)
            ReturnValue(mthis)
        }

        // MAP_GET (247)
        IfCondition EqualTo(save_id, JSNativeID.MAP_GET) ThenBlock: {
            mthis = JSVM__GetGlobal("this")
            pairs = JSRT_ObjGet(mthis, "__pairs__")
            IfCondition NotEqual(JSRT_GetType(pairs), JSType.ARRAY) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            mk = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { mk = Dereference(save_args) }
            found = JSBridge__MapFindIndex(pairs, mk)
            IfCondition LessThan(found, 0) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            entu = JSRT_ArrGet(pairs, found)
            ReturnValue(JSRT_ArrGet(entu, 1))
        }

        // MAP_HAS (248)
        IfCondition EqualTo(save_id, JSNativeID.MAP_HAS) ThenBlock: {
            mthis = JSVM__GetGlobal("this")
            pairs = JSRT_ObjGet(mthis, "__pairs__")
            IfCondition NotEqual(JSRT_GetType(pairs), JSType.ARRAY) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            mk = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { mk = Dereference(save_args) }
            found = JSBridge__MapFindIndex(pairs, mk)
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
            ReturnValue(JSRT_CreateBool(0))
        }

        // MAP_DELETE (249)
        IfCondition EqualTo(save_id, JSNativeID.MAP_DELETE) ThenBlock: {
            mthis = JSVM__GetGlobal("this")
            pairs = JSRT_ObjGet(mthis, "__pairs__")
            IfCondition NotEqual(JSRT_GetType(pairs), JSType.ARRAY) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            mk = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { mk = Dereference(save_args) }
            found = JSBridge__MapFindIndex(pairs, mk)
            IfCondition LessThan(found, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            // M63: tombstone so live iterators keep stable indices
            JSRT_ArrSet(pairs, found, JSRTState.null_val)
            pi = 0
            plen = JSRT_ArrLen(pairs)
            sc = 0
            WhileLoop LessThan(pi, plen) {
                pe = JSRT_ArrGet(pairs, pi)
                IfCondition EqualTo(JSRT_GetType(pe), JSType.ARRAY) ThenBlock: {
                    sc = Add(sc, 1)
                }
                pi = Add(pi, 1)
            }
            JSRT__Push(mthis)
            nsz = JSRT_CreateNumber(sc)
            mthis = JSRT__Pop()
            JSRT_ObjSet(mthis, "size", nsz)
            ReturnValue(JSRT_CreateBool(1))
        }

        // MAP_CLEAR (250)
        IfCondition EqualTo(save_id, JSNativeID.MAP_CLEAR) ThenBlock: {
            mthis = JSVM__GetGlobal("this")
            pairs = JSRT_CreateArray()
            JSRT_ObjSet(mthis, "__pairs__", pairs)
            JSRT__Push(mthis)
            zsz = JSRT_CreateNumber(0)
            mthis = JSRT__Pop()
            JSRT_ObjSet(mthis, "size", zsz)
            ReturnValue(JSRTState.undef_val)
        }

        // MAP_ENTRIES (251) / MAP_KEYS (252) / MAP_VALUES (253)
        IfCondition Or(EqualTo(save_id, JSNativeID.MAP_ENTRIES), Or(EqualTo(save_id, JSNativeID.MAP_KEYS), EqualTo(save_id, JSNativeID.MAP_VALUES))) ThenBlock: {
            mthis = JSVM__GetGlobal("this")
            it = JSRT_CreateObject()
            // M63: hold live map ref (not pairs snapshot) for contract/expand
            JSRT_ObjSet(it, "__m__", mthis)
            JSRT__Push(it)
            z2 = JSRT_CreateNumber(0)
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__i__", z2)
            ikind = 0
            IfCondition EqualTo(save_id, JSNativeID.MAP_KEYS) ThenBlock: { ikind = 1 }
            IfCondition EqualTo(save_id, JSNativeID.MAP_VALUES) ThenBlock: { ikind = 2 }
            JSRT__Push(it)
            knd = JSRT_CreateNumber(ikind)
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__k__", knd)
            JSRT__Push(it)
            nf = JSBridge__CreateNativeFunc(JSNativeID.MAP_ITER_NEXT, "next", 0)
            it = JSRT__Pop()
            JSRT_FuncSetEnv(nf, it)
            JSRT_ObjSet(it, "next", nf)
            ReturnValue(it)
        }

        // MAP_ITER_NEXT (254)
        IfCondition EqualTo(save_id, JSNativeID.MAP_ITER_NEXT) ThenBlock: {
            it = JSVM__GetGlobal("this")
            // live pairs from map
            mmap = JSRT_ObjGet(it, "__m__")
            pairs = JSRT_ObjGet(mmap, "__pairs__")
            idx_v = JSRT_ObjGet(it, "__i__")
            idx = 0
            IfCondition EqualTo(JSRT_GetType(idx_v), JSType.NUMBER) ThenBlock: {
                idx = Float_ToInt(JSRT_GetPayload(idx_v))
            }
            kind = 0
            kind_v = JSRT_ObjGet(it, "__k__")
            IfCondition EqualTo(JSRT_GetType(kind_v), JSType.NUMBER) ThenBlock: {
                kind = Float_ToInt(JSRT_GetPayload(kind_v))
            }
            res = JSRT_CreateObject()
            IfCondition NotEqual(JSRT_GetType(pairs), JSType.ARRAY) ThenBlock: {
                JSRT_ObjSet(res, "done", JSRT_True())
                JSRT_ObjSet(res, "value", JSRTState.undef_val)
                ReturnValue(res)
            }
            plen = JSRT_ArrLen(pairs)
            // skip tombstones (null)
            WhileLoop And(LessThan(idx, plen), NotEqual(JSRT_GetType(JSRT_ArrGet(pairs, idx)), JSType.ARRAY)) {
                idx = Add(idx, 1)
            }
            IfCondition GreaterEqual(idx, plen) ThenBlock: {
                JSRT_ObjSet(res, "done", JSRT_True())
                JSRT_ObjSet(res, "value", JSRTState.undef_val)
                ReturnValue(res)
            }
            ent = JSRT_ArrGet(pairs, idx)
            IfCondition EqualTo(kind, 1) ThenBlock: {
                ev = JSRT_ArrGet(ent, 0)
            } ElseBlock: {
                IfCondition EqualTo(kind, 2) ThenBlock: {
                    ev = JSRT_ArrGet(ent, 1)
                } ElseBlock: {
                    ev = ent
                }
            }
            JSRT_ObjSet(res, "value", ev)
            JSRT_ObjSet(res, "done", JSRT_False())
            JSRT__Push(it)
            JSRT__Push(res)
            ni = JSRT_CreateNumber(Add(idx, 1))
            res = JSRT__Pop()
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__i__", ni)
            ReturnValue(res)
        }

        // SET_CTOR (255)
        IfCondition EqualTo(save_id, JSNativeID.SET_CTOR) ThenBlock: {
            sobj = JSRT_CreateObject()
            vals = JSRT_CreateArray()
            JSRT_ObjSet(sobj, "__vals__", vals)
            JSRT_ObjSet(sobj, "__class__", JSRT_CreateString("Set"))
            JSRT__Push(sobj)
            zsz = JSRT_CreateNumber(0)
            sobj = JSRT__Pop()
            JSRT_ObjSet(sobj, "size", zsz)
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                sit = Dereference(save_args)
                IfCondition EqualTo(JSRT_GetType(sit), JSType.ARRAY) ThenBlock: {
                    si = 0
                    slen = JSRT_ArrLen(sit)
                    WhileLoop LessThan(si, slen) {
                        sv = JSRT_ArrGet(sit, si)
                        vals2 = JSRT_ObjGet(sobj, "__vals__")
                        found = JSBridge__SetFindIndex(vals2, sv)
                        IfCondition LessThan(found, 0) ThenBlock: {
                            JSRT_ArrPush(vals2, sv)
                        }
                        si = Add(si, 1)
                    }
                    JSRT__Push(sobj)
                    nsz = JSRT_CreateNumber(JSRT_ArrLen(JSRT_ObjGet(sobj, "__vals__")))
                    sobj = JSRT__Pop()
                    JSRT_ObjSet(sobj, "size", nsz)
                }
            }
            ReturnValue(sobj)
        }

        // SET_ADD (256)
        IfCondition EqualTo(save_id, JSNativeID.SET_ADD) ThenBlock: {
            sthis = JSVM__GetGlobal("this")
            vals = JSRT_ObjGet(sthis, "__vals__")
            IfCondition NotEqual(JSRT_GetType(vals), JSType.ARRAY) ThenBlock: {
                vals = JSRT_CreateArray()
                JSRT_ObjSet(sthis, "__vals__", vals)
            }
            sv = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { sv = Dereference(save_args) }
            found = JSBridge__SetFindIndex(vals, sv)
            IfCondition LessThan(found, 0) ThenBlock: {
                JSRT_ArrPush(vals, sv)
            }
            JSRT__Push(sthis)
            nsz = JSRT_CreateNumber(JSRT_ArrLen(vals))
            sthis = JSRT__Pop()
            JSRT_ObjSet(sthis, "size", nsz)
            ReturnValue(sthis)
        }

        // SET_HAS (257)
        IfCondition EqualTo(save_id, JSNativeID.SET_HAS) ThenBlock: {
            sthis = JSVM__GetGlobal("this")
            vals = JSRT_ObjGet(sthis, "__vals__")
            IfCondition NotEqual(JSRT_GetType(vals), JSType.ARRAY) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            sv = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { sv = Dereference(save_args) }
            found = JSBridge__SetFindIndex(vals, sv)
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
            ReturnValue(JSRT_CreateBool(0))
        }

        // SET_DELETE (258)
        IfCondition EqualTo(save_id, JSNativeID.SET_DELETE) ThenBlock: {
            sthis = JSVM__GetGlobal("this")
            vals = JSRT_ObjGet(sthis, "__vals__")
            IfCondition NotEqual(JSRT_GetType(vals), JSType.ARRAY) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            sv = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { sv = Dereference(save_args) }
            found = JSBridge__SetFindIndex(vals, sv)
            IfCondition LessThan(found, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            // M63: unique tombstone (null can be a real Set value)
            // Tombstone: unique object with __tomb__ flag (ArrSet may copy ptr;
            // detect via ObjHas not pointer eq)
            tomb = JSRT_CreateObject()
            JSRT_ObjSet(tomb, "__tomb__", JSRT_True())
            JSRT_ArrSet(vals, found, tomb)
            pi = 0
            plen = JSRT_ArrLen(vals)
            sc = 0
            WhileLoop LessThan(pi, plen) {
                pe = JSRT_ArrGet(vals, pi)
                is_t = 0
                IfCondition EqualTo(JSRT_GetType(pe), JSType.OBJECT) ThenBlock: {
                    IfCondition EqualTo(JSRT_ObjHas(pe, "__tomb__"), 1) ThenBlock: {
                        is_t = 1
                    }
                }
                IfCondition EqualTo(is_t, 0) ThenBlock: {
                    sc = Add(sc, 1)
                }
                pi = Add(pi, 1)
            }
            JSRT__Push(sthis)
            nsz = JSRT_CreateNumber(sc)
            sthis = JSRT__Pop()
            JSRT_ObjSet(sthis, "size", nsz)
            ReturnValue(JSRT_CreateBool(1))
        }

        // SET_CLEAR (259)
        IfCondition EqualTo(save_id, JSNativeID.SET_CLEAR) ThenBlock: {
            sthis = JSVM__GetGlobal("this")
            vals = JSRT_CreateArray()
            JSRT_ObjSet(sthis, "__vals__", vals)
            JSRT__Push(sthis)
            zsz = JSRT_CreateNumber(0)
            sthis = JSRT__Pop()
            JSRT_ObjSet(sthis, "size", zsz)
            ReturnValue(JSRTState.undef_val)
        }

        // SET_VALUES (260) / SET_ENTRIES (261)
        IfCondition Or(EqualTo(save_id, JSNativeID.SET_VALUES), EqualTo(save_id, JSNativeID.SET_ENTRIES)) ThenBlock: {
            sthis = JSVM__GetGlobal("this")
            it = JSRT_CreateObject()
            JSRT_ObjSet(it, "__s__", sthis)
            JSRT__Push(it)
            z2 = JSRT_CreateNumber(0)
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__i__", z2)
            ikind = 0
            IfCondition EqualTo(save_id, JSNativeID.SET_ENTRIES) ThenBlock: { ikind = 2 }
            JSRT__Push(it)
            knd = JSRT_CreateNumber(ikind)
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__k__", knd)
            JSRT__Push(it)
            nf = JSBridge__CreateNativeFunc(JSNativeID.SET_ITER_NEXT, "next", 0)
            it = JSRT__Pop()
            JSRT_FuncSetEnv(nf, it)
            JSRT_ObjSet(it, "next", nf)
            ReturnValue(it)
        }

        // SET_ITER_NEXT (262)
        IfCondition EqualTo(save_id, JSNativeID.SET_ITER_NEXT) ThenBlock: {
            it = JSVM__GetGlobal("this")
            sset = JSRT_ObjGet(it, "__s__")
            vals = JSRT_ObjGet(sset, "__vals__")
            idx_v = JSRT_ObjGet(it, "__i__")
            idx = 0
            IfCondition EqualTo(JSRT_GetType(idx_v), JSType.NUMBER) ThenBlock: {
                idx = Float_ToInt(JSRT_GetPayload(idx_v))
            }
            kind = 0
            kind_v = JSRT_ObjGet(it, "__k__")
            IfCondition EqualTo(JSRT_GetType(kind_v), JSType.NUMBER) ThenBlock: {
                kind = Float_ToInt(JSRT_GetPayload(kind_v))
            }
            res = JSRT_CreateObject()
            IfCondition NotEqual(JSRT_GetType(vals), JSType.ARRAY) ThenBlock: {
                JSRT_ObjSet(res, "done", JSRT_True())
                JSRT_ObjSet(res, "value", JSRTState.undef_val)
                ReturnValue(res)
            }
            vlen = JSRT_ArrLen(vals)
            // skip tombstones (__tomb__ flag)
            sk_done = 0
            WhileLoop And(LessThan(idx, vlen), EqualTo(sk_done, 0)) {
                pe2 = JSRT_ArrGet(vals, idx)
                is_t2 = 0
                IfCondition EqualTo(JSRT_GetType(pe2), JSType.OBJECT) ThenBlock: {
                    IfCondition EqualTo(JSRT_ObjHas(pe2, "__tomb__"), 1) ThenBlock: {
                        is_t2 = 1
                    }
                }
                IfCondition EqualTo(is_t2, 1) ThenBlock: {
                    idx = Add(idx, 1)
                } ElseBlock: {
                    sk_done = 1
                }
            }
            IfCondition GreaterEqual(idx, vlen) ThenBlock: {
                JSRT_ObjSet(res, "done", JSRT_True())
                JSRT_ObjSet(res, "value", JSRTState.undef_val)
                ReturnValue(res)
            }
            vv = JSRT_ArrGet(vals, idx)
            IfCondition EqualTo(kind, 2) ThenBlock: {
                ent = JSRT_CreateArray()
                JSRT_ArrPush(ent, vv)
                JSRT_ArrPush(ent, vv)
                JSRT_ObjSet(res, "value", ent)
            } ElseBlock: {
                JSRT_ObjSet(res, "value", vv)
            }
            JSRT_ObjSet(res, "done", JSRT_False())
            JSRT__Push(it)
            JSRT__Push(res)
            ni = JSRT_CreateNumber(Add(idx, 1))
            res = JSRT__Pop()
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__i__", ni)
            ReturnValue(res)
        }


        // ─── SYM_PROTO_TO_STRING (276) — Symbol.prototype.toString ───
        IfCondition EqualTo(save_id, JSNativeID.SYM_PROTO_TO_STRING) ThenBlock: {
            this_v = JSVM__GetGlobal("this")
            IfCondition EqualTo(JSVM_IsSymbol(this_v), 0) ThenBlock: {
                // also accept Object-wrapped if ever boxed
                terr = JSVM_CreateTypedError("TypeError", "Symbol.prototype.toString requires that 'this' be a Symbol")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            // Format Symbol(description) — bypass ToString throw
            dval_s = JSRT_ObjGet(this_v, "description")
            mid_s = JSRT_CreateString("")
            IfCondition And(NotEqual(dval_s, 0), NotEqual(dval_s, JSRTState.undef_val)) ThenBlock: {
                IfCondition EqualTo(JSRT_GetType(dval_s), JSType.STRING) ThenBlock: {
                    mid_s = dval_s
                }
            }
            pre_s = JSRT_CreateString("Symbol")
            lp_s = JSRT_CreateString("(")
            rp_s = JSRT_CreateString(")")
            p1s = JSRT__StrConcat(JSRT_GetPayload(pre_s), JSRT_GetPayload(lp_s))
            IfCondition EqualTo(p1s, 0) ThenBlock: {
                ReturnValue(JSRT_CreateString("Symbol()"))
            }
            p2s = JSRT__StrConcat(JSRT_GetPayload(p1s), JSRT_GetPayload(mid_s))
            IfCondition EqualTo(p2s, 0) ThenBlock: {
                ReturnValue(p1s)
            }
            p3s = JSRT__StrConcat(JSRT_GetPayload(p2s), JSRT_GetPayload(rp_s))
            IfCondition EqualTo(p3s, 0) ThenBlock: {
                ReturnValue(p2s)
            }
            ReturnValue(p3s)
        }

        // ─── SYM_PROTO_VALUE_OF (277) ───
        IfCondition EqualTo(save_id, JSNativeID.SYM_PROTO_VALUE_OF) ThenBlock: {
            this_v = JSVM__GetGlobal("this")
            IfCondition EqualTo(JSVM_IsSymbol(this_v), 0) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Symbol.prototype.valueOf requires that 'this' be a Symbol")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            ReturnValue(this_v)
        }


        // ─── BIGINT (278-282) ───
        IfCondition EqualTo(save_id, JSNativeID.BIGINT_CTOR) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "BigInt requires one argument")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                ReturnValue(JSRT_Undefined())
            }
            arg0 = Dereference(save_args)
            ReturnValue(JSRT_ToBigInt(arg0))
        }
        IfCondition EqualTo(save_id, JSNativeID.BIGINT_ASINTN) ThenBlock: {
            bits = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                bits = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
            }
            av = JSRT_CreateBigIntZero()
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                av = JSRT_ToBigInt(Dereference(Add(save_args, 8)))
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            }
            ReturnValue(JSRT_BigIntAsIntN(bits, av))
        }
        IfCondition EqualTo(save_id, JSNativeID.BIGINT_ASUINTN) ThenBlock: {
            bits = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                bits = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
            }
            av = JSRT_CreateBigIntZero()
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                av = JSRT_ToBigInt(Dereference(Add(save_args, 8)))
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            }
            ReturnValue(JSRT_BigIntAsUintN(bits, av))
        }
        IfCondition EqualTo(save_id, JSNativeID.BIGINT_TO_STRING) ThenBlock: {
            this_v = JSVM__GetGlobal("this")
            IfCondition EqualTo(JSRT_GetType(this_v), JSType.OBJECT) ThenBlock: {
                pv = JSRT_ObjGet(this_v, "__value__")
                IfCondition EqualTo(JSRT_GetType(pv), JSType.BIGINT) ThenBlock: { this_v = pv }
            }
            IfCondition NotEqual(JSRT_GetType(this_v), JSType.BIGINT) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "BigInt.prototype.toString requires BigInt")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                ReturnValue(JSRT_Undefined())
            }
            rdx = 10
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                rdx = Float_ToInt(JSRT_ToNumber(Dereference(save_args)))
            }
            ReturnValue(JSRT_BigIntToString(this_v, rdx))
        }
        IfCondition EqualTo(save_id, JSNativeID.BIGINT_VALUE_OF) ThenBlock: {
            this_v = JSVM__GetGlobal("this")
            IfCondition EqualTo(JSRT_GetType(this_v), JSType.OBJECT) ThenBlock: {
                pv = JSRT_ObjGet(this_v, "__value__")
                IfCondition EqualTo(JSRT_GetType(pv), JSType.BIGINT) ThenBlock: { ReturnValue(pv) }
            }
            IfCondition EqualTo(JSRT_GetType(this_v), JSType.BIGINT) ThenBlock: { ReturnValue(this_v) }
            terr = JSVM_CreateTypedError("TypeError", "BigInt.prototype.valueOf requires BigInt")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(JSRT_Undefined())
        }

        // Unknown handler — return undefined
        PrintMessage("[JSBridge] unknown native id: ")
        PrintNumber(save_id)
        PrintMessage("\n")
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// JSON PARSE / STRINGIFY
// =============================================================================

FixedPool.JSBridge__JSONPos {
    "pos": Initialize=0
    "src": Initialize=0
    "len": Initialize=0
}

// Skip whitespace in JSON source
Function.JSBridge__JSONSkipWS {
    Output: Integer
    Body: {
        WhileLoop LessThan(JSBridge__JSONPos.pos, JSBridge__JSONPos.len) {
            ch = GetByte(JSBridge__JSONPos.src, JSBridge__JSONPos.pos)
            is_ws = 0
            IfCondition EqualTo(ch, 32)  ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(ch, 9)   ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(ch, 10)  ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(ch, 13)  ThenBlock: { is_ws = 1 }
            IfCondition EqualTo(is_ws, 0) ThenBlock: { ReturnValue(ch) }
            JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
        }
        ReturnValue(0)
    }
}

// Parse a JSON value (recursive descent)
Function.JSBridge__JSONParseValue {
    Output: Address
    Body: {
        ch = JSBridge__JSONSkipWS()
        // String
        IfCondition EqualTo(ch, 34) ThenBlock: {
            ReturnValue(JSBridge__JSONParseString())
        }
        // Number (digit or minus)
        IfCondition EqualTo(ch, 45) ThenBlock: { ReturnValue(JSBridge__JSONParseNumber()) }
        IfCondition GreaterEqual(ch, 48) ThenBlock: {
            IfCondition LessEqual(ch, 57) ThenBlock: { ReturnValue(JSBridge__JSONParseNumber()) }
        }
        // Object
        IfCondition EqualTo(ch, 123) ThenBlock: { ReturnValue(JSBridge__JSONParseObject()) }
        // Array
        IfCondition EqualTo(ch, 91) ThenBlock: { ReturnValue(JSBridge__JSONParseArray()) }
        // true
        IfCondition EqualTo(ch, 116) ThenBlock: {
            JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 4)
            ReturnValue(JSRTState.true_val)
        }
        // false
        IfCondition EqualTo(ch, 102) ThenBlock: {
            JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 5)
            ReturnValue(JSRTState.false_val)
        }
        // null
        IfCondition EqualTo(ch, 110) ThenBlock: {
            JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 4)
            ReturnValue(JSRTState.null_val)
        }
        ReturnValue(JSRTState.undef_val)
    }
}

// Parse a JSON string (pos at opening quote)
Function.JSBridge__JSONParseString {
    Output: Address
    Body: {
        JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
        out = JSRTState.str_work_buf
        oi = 0
        max = 3900
        WhileLoop LessThan(JSBridge__JSONPos.pos, JSBridge__JSONPos.len) {
            ch = GetByte(JSBridge__JSONPos.src, JSBridge__JSONPos.pos)
            JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
            IfCondition EqualTo(ch, 34) ThenBlock: {
                SetByte(out, oi, 0)
                ReturnValue(JSRT_CreateString(out))
            }
            IfCondition EqualTo(ch, 92) ThenBlock: {
                esc = GetByte(JSBridge__JSONPos.src, JSBridge__JSONPos.pos)
                JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
                IfCondition EqualTo(esc, 110) ThenBlock: { ch = 10 }
                IfCondition EqualTo(esc, 116) ThenBlock: { ch = 9 }
                IfCondition EqualTo(esc, 114) ThenBlock: { ch = 13 }
                IfCondition EqualTo(esc, 34)  ThenBlock: { ch = 34 }
                IfCondition EqualTo(esc, 92)  ThenBlock: { ch = 92 }
                IfCondition EqualTo(esc, 47)  ThenBlock: { ch = 47 }
                // \uXXXX — skip 4 hex digits, emit '?'
                IfCondition EqualTo(esc, 117) ThenBlock: {
                    JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 4)
                    ch = 63
                }
            }
            IfCondition LessThan(oi, max) ThenBlock: {
                SetByte(out, oi, ch)
                oi = Add(oi, 1)
            }
        }
        SetByte(out, oi, 0)
        ReturnValue(JSRT_CreateString(out))
    }
}

// Parse a JSON number
Function.JSBridge__JSONParseNumber {
    Output: Address
    Body: {
        // Collect number chars into buffer, then use StringToNumber/Float
        buf = JSRTState.str_work_buf
        bi = 0
        // Leading minus
        ch = GetByte(JSBridge__JSONPos.src, JSBridge__JSONPos.pos)
        neg = 0
        IfCondition EqualTo(ch, 45) ThenBlock: {
            neg = 1
            JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
        }
        // Integer part
        int_val = 0
        has_dot = 0
        WhileLoop LessThan(JSBridge__JSONPos.pos, JSBridge__JSONPos.len) {
            ch = GetByte(JSBridge__JSONPos.src, JSBridge__JSONPos.pos)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    int_val = Add(Multiply(int_val, 10), Subtract(ch, 48))
                    JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 46) ThenBlock: { has_dot = 1 }
                }
            } ElseBlock: {
                IfCondition EqualTo(ch, 46) ThenBlock: { has_dot = 1 }
            }
            IfCondition NotEqual(has_dot, 0) ThenBlock: {
                // Read fractional part using float
                JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
                frac = Float_FromInt(0)
                scale = Float_FromInt(1)
                ten = Float_FromInt(10)
                WhileLoop LessThan(JSBridge__JSONPos.pos, JSBridge__JSONPos.len) {
                    dch = GetByte(JSBridge__JSONPos.src, JSBridge__JSONPos.pos)
                    IfCondition LessThan(dch, 48) ThenBlock: {
                        // non-digit, break
                        fval = Float_Add(Float_FromInt(int_val), Float_Div(frac, scale))
                        IfCondition EqualTo(neg, 1) ThenBlock: {
                            fval = Float_Sub(Float_FromInt(0), fval)
                        }
                        ReturnValue(JSRT_CreateFloat(fval))
                    }
                    IfCondition GreaterThan(dch, 57) ThenBlock: {
                        fval = Float_Add(Float_FromInt(int_val), Float_Div(frac, scale))
                        IfCondition EqualTo(neg, 1) ThenBlock: {
                            fval = Float_Sub(Float_FromInt(0), fval)
                        }
                        ReturnValue(JSRT_CreateFloat(fval))
                    }
                    frac = Float_Add(Float_Mul(frac, ten), Float_FromInt(Subtract(dch, 48)))
                    scale = Float_Mul(scale, ten)
                    JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
                }
                fval = Float_Add(Float_FromInt(int_val), Float_Div(frac, scale))
                IfCondition EqualTo(neg, 1) ThenBlock: {
                    fval = Float_Sub(Float_FromInt(0), fval)
                }
                ReturnValue(JSRT_CreateFloat(fval))
            }
            // Check for non-digit (not dot)
            IfCondition LessThan(ch, 48) ThenBlock: {
                IfCondition EqualTo(neg, 1) ThenBlock: { int_val = Subtract(0, int_val) }
                ReturnValue(JSRT_CreateNumber(int_val))
            }
            IfCondition GreaterThan(ch, 57) ThenBlock: {
                IfCondition EqualTo(neg, 1) ThenBlock: { int_val = Subtract(0, int_val) }
                ReturnValue(JSRT_CreateNumber(int_val))
            }
        }
        IfCondition EqualTo(neg, 1) ThenBlock: { int_val = Subtract(0, int_val) }
        ReturnValue(JSRT_CreateNumber(int_val))
    }
}

// Parse a JSON object (pos at '{')
Function.JSBridge__JSONParseObject {
    Output: Address
    Body: {
        JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
        obj = JSRT_CreateObject()
        ch = JSBridge__JSONSkipWS()
        IfCondition EqualTo(ch, 125) ThenBlock: {
            JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
            ReturnValue(obj)
        }
        WhileLoop LessThan(JSBridge__JSONPos.pos, JSBridge__JSONPos.len) {
            JSBridge__JSONSkipWS()
            // Parse key (must be string)
            JSRT__Push(obj)
            key_val = JSBridge__JSONParseString()
            obj = JSRT__Pop()
            key_ptr = JSRT_GetPayload(key_val)
            // Skip colon
            JSBridge__JSONSkipWS()
            JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
            // Parse value
            JSRT__Push(obj)
            JSRT__Push(key_ptr)
            val = JSBridge__JSONParseValue()
            key_ptr = JSRT__Pop()
            obj = JSRT__Pop()
            JSRT_ObjSet(obj, key_ptr, val)
            // Comma or closing brace
            ch = JSBridge__JSONSkipWS()
            IfCondition EqualTo(ch, 125) ThenBlock: {
                JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
                ReturnValue(obj)
            }
            IfCondition EqualTo(ch, 44) ThenBlock: {
                JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
            }
        }
        ReturnValue(obj)
    }
}

// Parse a JSON array (pos at '[')
Function.JSBridge__JSONParseArray {
    Output: Address
    Body: {
        JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
        arr = JSRT_CreateArray()
        ch = JSBridge__JSONSkipWS()
        IfCondition EqualTo(ch, 93) ThenBlock: {
            JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
            ReturnValue(arr)
        }
        WhileLoop LessThan(JSBridge__JSONPos.pos, JSBridge__JSONPos.len) {
            JSRT__Push(arr)
            elem = JSBridge__JSONParseValue()
            arr = JSRT__Pop()
            JSRT_ArrPush(arr, elem)
            ch = JSBridge__JSONSkipWS()
            IfCondition EqualTo(ch, 93) ThenBlock: {
                JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
                ReturnValue(arr)
            }
            IfCondition EqualTo(ch, 44) ThenBlock: {
                JSBridge__JSONPos.pos = Add(JSBridge__JSONPos.pos, 1)
            }
        }
        ReturnValue(arr)
    }
}

// Stringify a JS value to JSON string
Function.JSBridge__JSONStringify {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(JSRT_CreateString("null")) }
        vtype = Dereference(save_val)
        // null
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: { ReturnValue(JSRT_CreateString("null")) }
        // undefined → return undefined (JSON.stringify(undefined) === undefined)
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: { ReturnValue(JSRTState.undef_val) }
        // boolean
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            bv = Dereference(Add(save_val, 8))
            IfCondition EqualTo(bv, 0) ThenBlock: { ReturnValue(JSRT_CreateString("false")) }
            ReturnValue(JSRT_CreateString("true"))
        }
        // number
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            num_str = JSRT_ToString(save_val)
            ReturnValue(num_str)
        }
        // string — wrap in quotes, escape special chars
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            s_ptr = Dereference(Add(save_val, 8))
            out = JSRTState.str_work_buf
            oi = 0
            SetByte(out, oi, 34)
            oi = Add(oi, 1)
            si = 0
            s_len = StringLength(s_ptr)
            WhileLoop LessThan(si, s_len) {
                ch = GetByte(s_ptr, si)
                // Escape backslash, quote, newline, tab, CR
                IfCondition EqualTo(ch, 92) ThenBlock: {
                    SetByte(out, oi, 92)
                    oi = Add(oi, 1)
                    SetByte(out, oi, 92)
                    oi = Add(oi, 1)
                    si = Add(si, 1)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 34) ThenBlock: {
                        SetByte(out, oi, 92)
                        oi = Add(oi, 1)
                        SetByte(out, oi, 34)
                        oi = Add(oi, 1)
                        si = Add(si, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(ch, 10) ThenBlock: {
                            SetByte(out, oi, 92)
                            oi = Add(oi, 1)
                            SetByte(out, oi, 110)
                            oi = Add(oi, 1)
                            si = Add(si, 1)
                        } ElseBlock: {
                            IfCondition EqualTo(ch, 9) ThenBlock: {
                                SetByte(out, oi, 92)
                                oi = Add(oi, 1)
                                SetByte(out, oi, 116)
                                oi = Add(oi, 1)
                                si = Add(si, 1)
                            } ElseBlock: {
                                IfCondition EqualTo(ch, 13) ThenBlock: {
                                    SetByte(out, oi, 92)
                                    oi = Add(oi, 1)
                                    SetByte(out, oi, 114)
                                    oi = Add(oi, 1)
                                    si = Add(si, 1)
                                } ElseBlock: {
                                    SetByte(out, oi, ch)
                                    oi = Add(oi, 1)
                                    si = Add(si, 1)
                                }
                            }
                        }
                    }
                }
            }
            SetByte(out, oi, 34)
            oi = Add(oi, 1)
            SetByte(out, oi, 0)
            ReturnValue(JSRT_CreateString(out))
        }
        // array
        IfCondition EqualTo(vtype, JSType.ARRAY) ThenBlock: {
            result = JSRT_CreateString("[")
            arr_len = JSRT_ArrLen(save_val)
            ai = 0
            WhileLoop LessThan(ai, arr_len) {
                IfCondition GreaterThan(ai, 0) ThenBlock: {
                    JSRT__Push(save_val)
                    rp = Dereference(Add(result, 8))
                    result = JSRT__StrConcat(rp, ",")
                    save_val = JSRT__Pop()
                }
                JSRT__Push(save_val)
                JSRT__Push(result)
                elem = JSRT_ArrGet(save_val, ai)
                elem_str = JSBridge__JSONStringify(elem)
                result = JSRT__Pop()
                save_val = JSRT__Pop()
                // undefined → "null" in arrays
                et = Dereference(elem_str)
                IfCondition EqualTo(et, JSType.UNDEFINED) ThenBlock: {
                    elem_str = JSRT_CreateString("null")
                }
                JSRT__Push(save_val)
                rp = Dereference(Add(result, 8))
                ep = Dereference(Add(elem_str, 8))
                result = JSRT__StrConcat(rp, ep)
                save_val = JSRT__Pop()
                ai = Add(ai, 1)
            }
            rp = Dereference(Add(result, 8))
            result = JSRT__StrConcat(rp, "]")
            ReturnValue(result)
        }
        // object
        IfCondition EqualTo(vtype, JSType.OBJECT) ThenBlock: {
            // Use Object.keys to iterate
            JSRT__Push(save_val)
            keys = JSRT_ObjKeys(save_val)
            save_val = JSRT__Pop()
            k_len = JSRT_ArrLen(keys)
            result = JSRT_CreateString("{")
            ki = 0
            WhileLoop LessThan(ki, k_len) {
                IfCondition GreaterThan(ki, 0) ThenBlock: {
                    JSRT__Push(save_val)
                    JSRT__Push(keys)
                    rp = Dereference(Add(result, 8))
                    result = JSRT__StrConcat(rp, ",")
                    keys = JSRT__Pop()
                    save_val = JSRT__Pop()
                }
                // Get key
                key_val = JSRT_ArrGet(keys, ki)
                key_ptr = JSRT_GetPayload(key_val)
                // Stringify key (wrap in quotes)
                JSRT__Push(save_val)
                JSRT__Push(keys)
                JSRT__Push(result)
                key_json = JSBridge__JSONStringify(key_val)
                result = JSRT__Pop()
                keys = JSRT__Pop()
                save_val = JSRT__Pop()
                // Append key + ":"
                JSRT__Push(save_val)
                JSRT__Push(keys)
                rp = Dereference(Add(result, 8))
                kp = Dereference(Add(key_json, 8))
                result = JSRT__StrConcat(rp, kp)
                rp2 = Dereference(Add(result, 8))
                result = JSRT__StrConcat(rp2, ":")
                keys = JSRT__Pop()
                save_val = JSRT__Pop()
                // Get and stringify value
                JSRT__Push(save_val)
                JSRT__Push(keys)
                JSRT__Push(result)
                prop_val = JSRT_ObjGet(save_val, key_ptr)
                val_json = JSBridge__JSONStringify(prop_val)
                result = JSRT__Pop()
                keys = JSRT__Pop()
                save_val = JSRT__Pop()
                // undefined values → skip (JSON spec) — but we already emitted key
                // Instead output "null" for undefined
                vt = Dereference(val_json)
                IfCondition EqualTo(vt, JSType.UNDEFINED) ThenBlock: {
                    val_json = JSRT_CreateString("null")
                }
                JSRT__Push(save_val)
                JSRT__Push(keys)
                rp = Dereference(Add(result, 8))
                vp = Dereference(Add(val_json, 8))
                result = JSRT__StrConcat(rp, vp)
                keys = JSRT__Pop()
                save_val = JSRT__Pop()
                ki = Add(ki, 1)
            }
            rp = Dereference(Add(result, 8))
            result = JSRT__StrConcat(rp, "}")
            ReturnValue(result)
        }
        // function → undefined (JSON spec)
        IfCondition EqualTo(vtype, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(JSRT_CreateString("null"))
    }
}

// =============================================================================
// MATH RUNTIME FUNCTIONS — polynomial approximations using Float_* primitives
// =============================================================================

// PRNG state for Math.random()
FixedPool.JSMathState {
    "rng_state":  Initialize=1234567890
}

// IEEE 754 double bit constants
FixedPool.JSMathConst {
    "PI":           Initialize=4614256656552045848     // 3.141592653589793
    "PI_OVER_2":    Initialize=4609753056924675352     // 1.5707963267948966
    "PI_OVER_4":    Initialize=4608983858650965898     // 0.7853981633974483
    "TWO_PI":       Initialize=4618760256179416344     // 6.283185307179586
    "E":            Initialize=4613303445314885481     // 2.718281828459045
    "LN2":          Initialize=4604418534313441775     // 0.6931471805599453
    "ONE":          Initialize=4607182418800017408     // 1.0
    "HALF":         Initialize=4602678819172646912     // 0.5
    "NEG_ONE":      Initialize=-4616189618054758400    // -1.0
    "ZERO":         Initialize=0                       // 0.0
    "TWO":          Initialize=4611686018427387904     // 2.0
    "INV_LN2":      Initialize=4609176140021203710     // 1.4426950408889634 (1/ln2)
}

Function.JSBridge__MathSin {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        arg0 = Dereference(args)
        x = JSRT_ToNumber(arg0)

        // Range reduction: x = x mod 2π, then to [-π, π]
        twopi = JSMathConst.TWO_PI
        pi = JSMathConst.PI
        pi2 = JSMathConst.PI_OVER_2
        zero = JSMathConst.ZERO
        one = JSMathConst.ONE
        neg_one = JSMathConst.NEG_ONE

        // x = x - floor(x / 2π) * 2π
        q = Float_Div(x, twopi)
        qi = Float_FromInt(Float_ToInt(q))
        // Adjust for negative: if x < 0 and qi*2π > x, subtract 1
        IfCondition EqualTo(Float_Lt(x, zero), 1) ThenBlock: {
            IfCondition EqualTo(Float_Gt(Float_Mul(qi, twopi), x), 1) ThenBlock: {
                qi = Float_Sub(qi, one)
            }
        }
        x = Float_Sub(x, Float_Mul(qi, twopi))

        // Now x is in [0, 2π). Shift to [-π, π]
        IfCondition EqualTo(Float_Gt(x, pi), 1) ThenBlock: {
            x = Float_Sub(x, twopi)
        }

        // Determine quadrant and reduce to [-π/4, π/4]
        negate = 0
        use_cos = 0
        IfCondition EqualTo(Float_Lt(x, zero), 1) ThenBlock: {
            x = Float_Sub(zero, x)
            negate = 1
        }
        // x is now in [0, π]
        IfCondition EqualTo(Float_Gt(x, pi2), 1) ThenBlock: {
            x = Float_Sub(pi, x)
        }
        // x is now in [0, π/2]
        pi4 = JSMathConst.PI_OVER_4
        IfCondition EqualTo(Float_Gt(x, pi4), 1) ThenBlock: {
            x = Float_Sub(pi2, x)
            use_cos = 1
        }

        // Horner polynomial for sin(r) on [-π/4, π/4]:
        // sin(r) ≈ r * (1 + r² * (S1 + r² * (S3 + r² * S5)))
        // S1 = -1/6, S3 = 1/120, S5 = -1/5040
        r2 = Float_Mul(x, x)
        s5 = -4690140042714716877   // -1.984126984126984e-04 ~ -1/5040
        s3 = 4587366580439060480    //  8.333333333333334e-03 ~ 1/120
        s1 = -4628224478906402638   // -1.666666666666667e-01 ~ -1/6

        p = Float_Add(s3, Float_Mul(r2, s5))
        p = Float_Add(s1, Float_Mul(r2, p))
        p = Float_Add(one, Float_Mul(r2, p))
        sin_r = Float_Mul(x, p)

        // Horner polynomial for cos(r) on [-π/4, π/4]:
        // cos(r) ≈ 1 - r²/2 + r⁴ * (C2 + r² * C4)
        // C2 = 1/24, C4 = -1/720
        c4 = -4694822388953498778   // -1.388888888888889e-03 ~ -1/720
        c2 = 4555984893392498483    //  4.166666666666667e-02 ~ 1/24
        half = JSMathConst.HALF

        r4 = Float_Mul(r2, r2)
        cp = Float_Add(c2, Float_Mul(r2, c4))
        cos_r = Float_Add(Float_Sub(one, Float_Mul(half, r2)), Float_Mul(r4, cp))

        IfCondition EqualTo(use_cos, 1) ThenBlock: {
            result = cos_r
        } ElseBlock: {
            result = sin_r
        }

        IfCondition EqualTo(negate, 1) ThenBlock: {
            result = Float_Sub(zero, result)
        }

        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathCos {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        arg0 = Dereference(args)
        x = JSRT_ToNumber(arg0)

        // Range reduction: same as sin but shifted by π/2
        twopi = JSMathConst.TWO_PI
        pi = JSMathConst.PI
        pi2 = JSMathConst.PI_OVER_2
        zero = JSMathConst.ZERO
        one = JSMathConst.ONE

        // x = x - floor(x / 2π) * 2π
        q = Float_Div(x, twopi)
        qi = Float_FromInt(Float_ToInt(q))
        IfCondition EqualTo(Float_Lt(x, zero), 1) ThenBlock: {
            IfCondition EqualTo(Float_Gt(Float_Mul(qi, twopi), x), 1) ThenBlock: {
                qi = Float_Sub(qi, one)
            }
        }
        x = Float_Sub(x, Float_Mul(qi, twopi))

        // Shift to [-π, π]
        IfCondition EqualTo(Float_Gt(x, pi), 1) ThenBlock: {
            x = Float_Sub(x, twopi)
        }

        // cos(x) = sin(x + π/2), so shift by π/2
        x = Float_Add(x, pi2)
        // Re-normalize to [-π, π]
        IfCondition EqualTo(Float_Gt(x, pi), 1) ThenBlock: {
            x = Float_Sub(x, twopi)
        }

        // Now compute sin(x) with the same polynomial
        negate = 0
        use_cos = 0
        IfCondition EqualTo(Float_Lt(x, zero), 1) ThenBlock: {
            x = Float_Sub(zero, x)
            negate = 1
        }
        IfCondition EqualTo(Float_Gt(x, pi2), 1) ThenBlock: {
            x = Float_Sub(pi, x)
        }
        pi4 = JSMathConst.PI_OVER_4
        IfCondition EqualTo(Float_Gt(x, pi4), 1) ThenBlock: {
            x = Float_Sub(pi2, x)
            use_cos = 1
        }

        r2 = Float_Mul(x, x)
        s5 = -4690140042714716877
        s3 = 4587366580439060480
        s1 = -4628224478906402638

        p = Float_Add(s3, Float_Mul(r2, s5))
        p = Float_Add(s1, Float_Mul(r2, p))
        p = Float_Add(one, Float_Mul(r2, p))
        sin_r = Float_Mul(x, p)

        c4 = -4694822388953498778
        c2 = 4555984893392498483
        half = JSMathConst.HALF

        r4 = Float_Mul(r2, r2)
        cp = Float_Add(c2, Float_Mul(r2, c4))
        cos_r = Float_Add(Float_Sub(one, Float_Mul(half, r2)), Float_Mul(r4, cp))

        IfCondition EqualTo(use_cos, 1) ThenBlock: {
            result = cos_r
        } ElseBlock: {
            result = sin_r
        }

        IfCondition EqualTo(negate, 1) ThenBlock: {
            result = Float_Sub(zero, result)
        }

        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathTan {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        // tan(x) = sin(x) / cos(x)
        // Compute sin first, save result
        sin_v = JSBridge__MathSin(args, argc)
        sin_bits = JSRT_GetPayload(sin_v)

        cos_v = JSBridge__MathCos(args, argc)
        cos_bits = JSRT_GetPayload(cos_v)

        result = Float_Div(sin_bits, cos_bits)
        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathLog {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        arg0 = Dereference(args)
        x = JSRT_ToNumber(arg0)
        zero = JSMathConst.ZERO
        one = JSMathConst.ONE
        two = JSMathConst.TWO

        // Handle edge cases
        IfCondition Or(EqualTo(Float_Le(x, zero), 1), EqualTo(x, 0)) ThenBlock: {
            // log(0) = -Infinity, log(negative) = NaN
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }

        // Decompose: x = m * 2^e where 1 <= m < 2
        // Extract exponent from IEEE 754 bits
        exp_bits = BitwiseAnd(RightShift(x, 52), 2047)
        exp_val = Subtract(exp_bits, 1023)
        // Replace exponent with 1023 (bias) → m in [1, 2)
        m = BitwiseOr(BitwiseAnd(x, 4503599627370495), 4607182418800017408)

        // ln(x) = ln(m) + e * ln(2)
        // For ln(m) where m in [1,2), use: let f = m - 1, then
        // ln(1+f) ≈ f - f²/2 + f³/3 - f⁴/4 + f⁵/5 - f⁶/6
        f = Float_Sub(m, one)
        f2 = Float_Mul(f, f)
        f3 = Float_Mul(f2, f)
        f4 = Float_Mul(f3, f)
        f5 = Float_Mul(f4, f)
        f6 = Float_Mul(f5, f)

        half = JSMathConst.HALF
        third = Float_Div(one, Float_FromInt(3))
        fourth = Float_Div(one, Float_FromInt(4))
        fifth = Float_Div(one, Float_FromInt(5))
        sixth = Float_Div(one, Float_FromInt(6))

        ln_m = Float_Sub(f, Float_Mul(half, f2))
        ln_m = Float_Add(ln_m, Float_Mul(third, f3))
        ln_m = Float_Sub(ln_m, Float_Mul(fourth, f4))
        ln_m = Float_Add(ln_m, Float_Mul(fifth, f5))
        ln_m = Float_Sub(ln_m, Float_Mul(sixth, f6))

        e_f = Float_FromInt(exp_val)
        ln2 = JSMathConst.LN2
        result = Float_Add(ln_m, Float_Mul(e_f, ln2))

        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathExp {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        arg0 = Dereference(args)
        x = JSRT_ToNumber(arg0)
        one = JSMathConst.ONE
        zero = JSMathConst.ZERO

        // exp(x) = 2^(x/ln2) = 2^n * exp(r) where n = floor(x/ln2), r = x - n*ln2
        inv_ln2 = JSMathConst.INV_LN2
        ln2 = JSMathConst.LN2

        xdl = Float_Mul(x, inv_ln2)
        n = Float_ToInt(xdl)
        // Adjust for negative
        nf = Float_FromInt(n)
        IfCondition EqualTo(Float_Gt(nf, xdl), 1) ThenBlock: {
            n = Subtract(n, 1)
            nf = Float_FromInt(n)
        }
        r = Float_Sub(x, Float_Mul(nf, ln2))

        // exp(r) for small r via Taylor series: 1 + r + r²/2! + r³/3! + ... + r⁷/7!
        r2 = Float_Mul(r, r)
        r3 = Float_Mul(r2, r)
        r4 = Float_Mul(r3, r)
        r5 = Float_Mul(r4, r)
        r6 = Float_Mul(r5, r)
        r7 = Float_Mul(r6, r)

        half = JSMathConst.HALF
        inv6 = Float_Div(one, Float_FromInt(6))
        inv24 = Float_Div(one, Float_FromInt(24))
        inv120 = Float_Div(one, Float_FromInt(120))
        inv720 = Float_Div(one, Float_FromInt(720))
        inv5040 = Float_Div(one, Float_FromInt(5040))

        exp_r = Float_Add(one, r)
        exp_r = Float_Add(exp_r, Float_Mul(half, r2))
        exp_r = Float_Add(exp_r, Float_Mul(inv6, r3))
        exp_r = Float_Add(exp_r, Float_Mul(inv24, r4))
        exp_r = Float_Add(exp_r, Float_Mul(inv120, r5))
        exp_r = Float_Add(exp_r, Float_Mul(inv720, r6))
        exp_r = Float_Add(exp_r, Float_Mul(inv5040, r7))

        // Multiply by 2^n: adjust IEEE 754 exponent
        // 2^n as double: exponent field = n + 1023
        IfCondition And(GreaterThan(n, -1023), LessThan(n, 1024)) ThenBlock: {
            exp_bias = Add(n, 1023)
            pow2n = LeftShift(exp_bias, 52)
            result = Float_Mul(exp_r, pow2n)
        } ElseBlock: {
            // Overflow/underflow
            IfCondition GreaterEqual(n, 1024) ThenBlock: {
                result = 9218868437227405312  // +Infinity
            } ElseBlock: {
                result = zero
            }
        }

        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathRandom {
    Output: Address
    Body: {
        // xorshift64 PRNG
        s = JSMathState.rng_state
        IfCondition EqualTo(s, 0) ThenBlock: { s = 88172645463325252 }
        s = BitwiseXor(s, LeftShift(s, 13))
        s = BitwiseXor(s, RightShift(s, 7))
        s = BitwiseXor(s, LeftShift(s, 17))
        JSMathState.rng_state = s

        // Convert to [0, 1): take lower 32 bits, divide by 2^32
        bits = BitwiseAnd(s, 4294967295)
        f_bits = Float_FromInt(bits)
        f_max = Float_FromInt(4294967296)
        result = Float_Div(f_bits, f_max)

        ReturnValue(JSRT_CreateFloat(result))
    }
}

Function.JSBridge__MathAtan2 {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 2) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        // Simplified atan2 using atan(y/x) with quadrant correction
        arg0 = Dereference(args)
        JSRT__Push(args)
        y = JSRT_ToNumber(arg0)
        args = JSRT__Pop()
        arg1 = Dereference(Add(args, 8))
        JSRT__Push(y)
        x = JSRT_ToNumber(arg1)
        y = JSRT__Pop()

        pi = JSMathConst.PI
        pi2 = JSMathConst.PI_OVER_2
        zero = JSMathConst.ZERO
        one = JSMathConst.ONE

        // atan(t) for |t| <= 1: t - t³/3 + t⁵/5 - t⁷/7
        // For |t| > 1: π/2 - atan(1/t)

        // Handle special cases
        x_zero = Float_Eq(x, zero)
        IfCondition EqualTo(x_zero, 1) ThenBlock: {
            IfCondition EqualTo(Float_Gt(y, zero), 1) ThenBlock: {
                ReturnValue(JSRT_CreateFloat(pi2))
            }
            IfCondition EqualTo(Float_Lt(y, zero), 1) ThenBlock: {
                ReturnValue(JSRT_CreateFloat(Float_Sub(zero, pi2)))
            }
            ReturnValue(JSRT_CreateFloat(zero))
        }

        t = Float_Div(y, x)
        // atan(t) approximation
        negate = 0
        recip = 0
        IfCondition EqualTo(Float_Lt(t, zero), 1) ThenBlock: {
            t = Float_Sub(zero, t)
            negate = 1
        }
        IfCondition EqualTo(Float_Gt(t, one), 1) ThenBlock: {
            t = Float_Div(one, t)
            recip = 1
        }

        t2 = Float_Mul(t, t)
        t3 = Float_Mul(t2, t)
        t5 = Float_Mul(t3, t2)
        t7 = Float_Mul(t5, t2)

        third = Float_Div(one, Float_FromInt(3))
        fifth = Float_Div(one, Float_FromInt(5))
        seventh = Float_Div(one, Float_FromInt(7))

        at = Float_Sub(t, Float_Mul(third, t3))
        at = Float_Add(at, Float_Mul(fifth, t5))
        at = Float_Sub(at, Float_Mul(seventh, t7))

        IfCondition EqualTo(recip, 1) ThenBlock: {
            at = Float_Sub(pi2, at)
        }
        IfCondition EqualTo(negate, 1) ThenBlock: {
            at = Float_Sub(zero, at)
        }

        // Quadrant adjustment
        IfCondition EqualTo(Float_Lt(x, zero), 1) ThenBlock: {
            IfCondition EqualTo(Float_Ge(y, zero), 1) ThenBlock: {
                at = Float_Add(at, pi)
            } ElseBlock: {
                at = Float_Sub(at, pi)
            }
        }

        ReturnValue(JSRT_CreateFloat(at))
    }
}

// =============================================================================
// PROMISE DISPATCH — handles Promise.then/catch/ctor/resolve/reject
// Called from CALL handler with func_val env = promise receiver.
// =============================================================================
Function.JSBridge__DispatchPromise {
    Input: handler_id: Integer
    Input: promise_recv: Address
    Input: arg_buf: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_hid = handler_id
        save_pr = promise_recv
        save_args = arg_buf
        save_argc = argc

        // ─── PROMISE_RESOLVE (57) ─── create fulfilled promise
        // If arg is already a Promise, return it (ES PromiseResolve).
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_RESOLVE) ThenBlock: {
            p_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                p_val = Dereference(save_args)
            }
            IfCondition EqualTo(JSRT_GetType(p_val), JSType.OBJECT) ThenBlock: {
                p_cls = JSRT_ObjGet(p_val, "__class__")
                IfCondition EqualTo(JSRT_GetType(p_cls), JSType.STRING) ThenBlock: {
                    p_cstr = JSRT_StrToC(JSRT_GetPayload(p_cls))
                    IfCondition NotEqual(p_cstr, 0) ThenBlock: {
                        // "Promise"
                        IfCondition EqualTo(GetByte(p_cstr, 0), 80) ThenBlock: {
                            IfCondition EqualTo(GetByte(p_cstr, 1), 114) ThenBlock: {
                                IfCondition EqualTo(GetByte(p_cstr, 6), 101) ThenBlock: {
                                    ReturnValue(p_val)
                                }
                            }
                        }
                    }
                }
                // Also accept objects with __state__ (promise internals)
                p_st = JSRT_ObjGet(p_val, "__state__")
                IfCondition EqualTo(JSRT_GetType(p_st), JSType.NUMBER) ThenBlock: {
                    p_th = JSRT_ObjGet(p_val, "then")
                    IfCondition EqualTo(JSRT_GetType(p_th), JSType.FUNCTION) ThenBlock: {
                        ReturnValue(p_val)
                    }
                }
            }
            ReturnValue(JSBridge__CreatePromise(1, p_val))
        }

        // ─── PROMISE_REJECT (58) ─── create rejected promise
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_REJECT) ThenBlock: {
            p_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                p_val = Dereference(save_args)
            }
            ReturnValue(JSBridge__CreatePromise(2, p_val))
        }

        // ─── PROMISE_THEN (59) ─── M128e6p microtask queue for settled reactions
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_THEN) ThenBlock: {
            p_state = JSRT_ObjGet(save_pr, "__state__")
            p_state_n = 0
            IfCondition EqualTo(JSRT_GetType(p_state), JSType.NUMBER) ThenBlock: {
                p_state_n = Float_ToInt(JSRT_GetPayload(p_state))
            }
            p_value = JSRT_ObjGet(save_pr, "__value__")
            on_ful = JSRT_Undefined()
            on_rej = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                on_ful = Dereference(save_args)
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                on_rej = Dereference(Add(save_args, 8))
            }
            cap = JSBridge__CreatePromise(0, JSRT_Undefined())
            // Nested CallFunc / drain: keep eager path to avoid deadlock
            use_queue = 1
            IfCondition GreaterThan(JSVMCall.depth, 0) ThenBlock: {
                use_queue = 0
            }
            IfCondition EqualTo(JSVMJobs.draining, 1) ThenBlock: {
                use_queue = 0
            }
            IfCondition EqualTo(use_queue, 0) ThenBlock: {
                IfCondition EqualTo(p_state_n, 1) ThenBlock: {
                    IfCondition EqualTo(JSRT_GetType(on_ful), JSType.FUNCTION) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        cb_buf = JSVMCallBuf.buf
                        StoreValue(cb_buf, p_value)
                        cb_result = JSVM__CallFunc(on_ful, cb_buf, 1)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            JSVMCall.exc_prop = 0
                            ReturnValue(JSBridge__CreatePromise(2, JSVMCall.thrown_val))
                        }
                        IfCondition EqualTo(JSRT_GetType(cb_result), JSType.OBJECT) ThenBlock: {
                            st2 = JSRT_ObjGet(cb_result, "__state__")
                            IfCondition EqualTo(JSRT_GetType(st2), JSType.NUMBER) ThenBlock: {
                                sn2 = Float_ToInt(JSRT_GetPayload(st2))
                                IfCondition Or(EqualTo(sn2, 1), EqualTo(sn2, 2)) ThenBlock: {
                                    ReturnValue(JSBridge__CreatePromise(sn2, JSRT_ObjGet(cb_result, "__value__")))
                                }
                            }
                        }
                        ReturnValue(JSBridge__CreatePromise(1, cb_result))
                    }
                    ReturnValue(JSBridge__CreatePromise(1, p_value))
                }
                IfCondition EqualTo(p_state_n, 2) ThenBlock: {
                    IfCondition EqualTo(JSRT_GetType(on_rej), JSType.FUNCTION) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        cb_buf = JSVMCallBuf.buf
                        StoreValue(cb_buf, p_value)
                        cb_result = JSVM__CallFunc(on_rej, cb_buf, 1)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            JSVMCall.exc_prop = 0
                            ReturnValue(JSBridge__CreatePromise(2, JSVMCall.thrown_val))
                        }
                        IfCondition EqualTo(JSRT_GetType(cb_result), JSType.OBJECT) ThenBlock: {
                            st2 = JSRT_ObjGet(cb_result, "__state__")
                            IfCondition EqualTo(JSRT_GetType(st2), JSType.NUMBER) ThenBlock: {
                                sn2 = Float_ToInt(JSRT_GetPayload(st2))
                                IfCondition Or(EqualTo(sn2, 1), EqualTo(sn2, 2)) ThenBlock: {
                                    ReturnValue(JSBridge__CreatePromise(sn2, JSRT_ObjGet(cb_result, "__value__")))
                                }
                            }
                        }
                        ReturnValue(JSBridge__CreatePromise(1, cb_result))
                    }
                    ReturnValue(JSBridge__CreatePromise(2, p_value))
                }
                ReturnValue(cap)
            }
            // Microtask path
            IfCondition EqualTo(p_state_n, 1) ThenBlock: {
                enq = JSVMJobs_Enqueue(1, on_ful, p_value, cap)
                IfCondition EqualTo(enq, -1) ThenBlock: {
                    JSRT_ObjSet(cap, "__state__", JSRT_CreateNumber(1))
                    JSRT_ObjSet(cap, "__value__", p_value)
                }
                ReturnValue(cap)
            }
            IfCondition EqualTo(p_state_n, 2) ThenBlock: {
                enq = JSVMJobs_Enqueue(2, on_rej, p_value, cap)
                IfCondition EqualTo(enq, -1) ThenBlock: {
                    JSRT_ObjSet(cap, "__state__", JSRT_CreateNumber(2))
                    JSRT_ObjSet(cap, "__value__", p_value)
                }
                ReturnValue(cap)
            }
            // Pending: single reaction slot for chain
            rx = JSRT_CreateObject()
            JSRT_ObjSet(rx, "__on_ful__", on_ful)
            JSRT_ObjSet(rx, "__on_rej__", on_rej)
            JSRT_ObjSet(rx, "__cap__", cap)
            JSRT_ObjSet(save_pr, "__rx__", rx)
            ReturnValue(cap)
        }

        // ─── PROMISE_CATCH (60) ─── .then(undefined, onRejected)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_CATCH) ThenBlock: {
            p_state = JSRT_ObjGet(save_pr, "__state__")
            p_state_n = 0
            IfCondition EqualTo(JSRT_GetType(p_state), JSType.NUMBER) ThenBlock: {
                p_state_n = Float_ToInt(JSRT_GetPayload(p_state))
            }
            p_value = JSRT_ObjGet(save_pr, "__value__")

            on_rej = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                on_rej = Dereference(save_args)
            }

            IfCondition EqualTo(p_state_n, 2) ThenBlock: {
                rej_type = JSRT_GetType(on_rej)
                IfCondition EqualTo(rej_type, JSType.FUNCTION) ThenBlock: {
                    JSVMCall.exc_prop = 0
                    cb_buf = JSVMCallBuf.buf
                    StoreValue(cb_buf, p_value)
                    cb_result = JSVM__CallFunc(on_rej, cb_buf, 1)
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        JSVMCall.exc_prop = 0
                        ReturnValue(JSBridge__CreatePromise(2, JSVMCall.thrown_val))
                    }
                    ReturnValue(JSBridge__CreatePromise(1, cb_result))
                }
                ReturnValue(JSBridge__CreatePromise(2, p_value))
            }

            IfCondition EqualTo(p_state_n, 1) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(1, p_value))
            }
            ReturnValue(JSBridge__CreatePromise(0, JSRT_Undefined()))
        }

        // ─── PROMISE_FINALLY (215) ─── onFinally; pass through state/value ───
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_FINALLY) ThenBlock: {
            p_state = JSRT_ObjGet(save_pr, "__state__")
            p_state_n = 0
            IfCondition EqualTo(JSRT_GetType(p_state), JSType.NUMBER) ThenBlock: {
                p_state_n = Float_ToInt(JSRT_GetPayload(p_state))
            }
            p_value = JSRT_ObjGet(save_pr, "__value__")
            on_fin = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                on_fin = Dereference(save_args)
            }
            IfCondition EqualTo(JSRT_GetType(on_fin), JSType.FUNCTION) ThenBlock: {
                JSVMCall.exc_prop = 0
                empty_b = JSVMCallBuf.buf
                JSVM__CallFunc(on_fin, empty_b, 0)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    JSVMCall.exc_prop = 0
                    ReturnValue(JSBridge__CreatePromise(2, JSVMCall.thrown_val))
                }
            }
            IfCondition EqualTo(p_state_n, 2) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(2, p_value))
            }
            IfCondition EqualTo(p_state_n, 1) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(1, p_value))
            }
            ReturnValue(JSBridge__CreatePromise(0, JSRT_Undefined()))
        }

        // ─── PROMISE_ALL (211) ─── eager: array of values/promises → Promise ───
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_ALL) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(2, JSRT_CreateString("Promise.all requires an argument")))
            }
            it = Dereference(save_args)
            // Only Array for now (iterable later)
            IfCondition NotEqual(JSRT_GetType(it), JSType.ARRAY) ThenBlock: {
                // single non-array: treat as empty? TypeError-ish reject
                ReturnValue(JSBridge__CreatePromise(2, JSRT_CreateString("Promise.all requires an array")))
            }
            n = JSRT_ArrLen(it)
            out = JSRT_CreateArray()
            ai = 0
            WhileLoop LessThan(ai, n) {
                JSBridge__Push(it)
                JSBridge__Push(out)
                el = JSRT_ArrGet(it, ai)
                // Promise-like: object with __state__
                adopted = 0
                IfCondition EqualTo(JSRT_GetType(el), JSType.OBJECT) ThenBlock: {
                    st = JSRT_ObjGet(el, "__state__")
                    IfCondition EqualTo(JSRT_GetType(st), JSType.NUMBER) ThenBlock: {
                        sn = Float_ToInt(JSRT_GetPayload(st))
                        IfCondition EqualTo(sn, 2) ThenBlock: {
                            out = JSBridge__Pop()
                            it = JSBridge__Pop()
                            ReturnValue(JSBridge__CreatePromise(2, JSRT_ObjGet(el, "__value__")))
                        }
                        IfCondition EqualTo(sn, 1) ThenBlock: {
                            el = JSRT_ObjGet(el, "__value__")
                            adopted = 1
                        }
                    }
                }
                out = JSBridge__Pop()
                it = JSBridge__Pop()
                JSRT_ArrPush(out, el)
                ai = Add(ai, 1)
            }
            ReturnValue(JSBridge__CreatePromise(1, out))
        }

        // ─── PROMISE_RACE (212) ─── first settled (sync: first rejected or last fulfilled) ───
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_RACE) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(0, JSRT_Undefined()))
            }
            it = Dereference(save_args)
            IfCondition NotEqual(JSRT_GetType(it), JSType.ARRAY) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(1, it))
            }
            n = JSRT_ArrLen(it)
            IfCondition EqualTo(n, 0) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(0, JSRT_Undefined()))
            }
            // Sync race: walk left-to-right; first settled wins; non-promise = fulfilled
            ai = 0
            WhileLoop LessThan(ai, n) {
                el = JSRT_ArrGet(it, ai)
                IfCondition EqualTo(JSRT_GetType(el), JSType.OBJECT) ThenBlock: {
                    st = JSRT_ObjGet(el, "__state__")
                    IfCondition EqualTo(JSRT_GetType(st), JSType.NUMBER) ThenBlock: {
                        sn = Float_ToInt(JSRT_GetPayload(st))
                        IfCondition EqualTo(sn, 1) ThenBlock: {
                            ReturnValue(JSBridge__CreatePromise(1, JSRT_ObjGet(el, "__value__")))
                        }
                        IfCondition EqualTo(sn, 2) ThenBlock: {
                            ReturnValue(JSBridge__CreatePromise(2, JSRT_ObjGet(el, "__value__")))
                        }
                        // pending — continue
                    } ElseBlock: {
                        ReturnValue(JSBridge__CreatePromise(1, el))
                    }
                } ElseBlock: {
                    ReturnValue(JSBridge__CreatePromise(1, el))
                }
                ai = Add(ai, 1)
            }
            ReturnValue(JSBridge__CreatePromise(0, JSRT_Undefined()))
        }

        // ─── PROMISE_ALL_SETTLED (213) ─── always fulfill with {status,value/reason}[] ───
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_ALL_SETTLED) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(1, JSRT_CreateArray()))
            }
            it = Dereference(save_args)
            IfCondition NotEqual(JSRT_GetType(it), JSType.ARRAY) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(1, JSRT_CreateArray()))
            }
            n = JSRT_ArrLen(it)
            out = JSRT_CreateArray()
            ai = 0
            WhileLoop LessThan(ai, n) {
                JSBridge__Push(it)
                JSBridge__Push(out)
                el = JSRT_ArrGet(it, ai)
                desc = JSRT_CreateObject()
                sn = 1
                val = el
                IfCondition EqualTo(JSRT_GetType(el), JSType.OBJECT) ThenBlock: {
                    st = JSRT_ObjGet(el, "__state__")
                    IfCondition EqualTo(JSRT_GetType(st), JSType.NUMBER) ThenBlock: {
                        sn = Float_ToInt(JSRT_GetPayload(st))
                        val = JSRT_ObjGet(el, "__value__")
                    }
                }
                IfCondition EqualTo(sn, 2) ThenBlock: {
                    JSRT_ObjSet(desc, "status", JSRT_CreateString("rejected"))
                    JSRT_ObjSet(desc, "reason", val)
                } ElseBlock: {
                    JSRT_ObjSet(desc, "status", JSRT_CreateString("fulfilled"))
                    JSRT_ObjSet(desc, "value", val)
                }
                out = JSBridge__Pop()
                it = JSBridge__Pop()
                JSRT_ArrPush(out, desc)
                ai = Add(ai, 1)
            }
            ReturnValue(JSBridge__CreatePromise(1, out))
        }

        // ─── PROMISE_ANY (214) ─── first fulfilled; else reject with errors array ───
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_ANY) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(2, JSRT_CreateString("AggregateError")))
            }
            it = Dereference(save_args)
            IfCondition NotEqual(JSRT_GetType(it), JSType.ARRAY) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(1, it))
            }
            n = JSRT_ArrLen(it)
            IfCondition EqualTo(n, 0) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(2, JSRT_CreateString("AggregateError")))
            }
            errors = JSRT_CreateArray()
            rej_count = 0
            ai = 0
            WhileLoop LessThan(ai, n) {
                JSBridge__Push(it)
                JSBridge__Push(errors)
                el = JSRT_ArrGet(it, ai)
                handled = 0
                // Non-promise → fulfilled immediately
                IfCondition NotEqual(JSRT_GetType(el), JSType.OBJECT) ThenBlock: {
                    errors = JSBridge__Pop()
                    it = JSBridge__Pop()
                    ReturnValue(JSBridge__CreatePromise(1, el))
                }
                st = JSRT_ObjGet(el, "__state__")
                IfCondition NotEqual(JSRT_GetType(st), JSType.NUMBER) ThenBlock: {
                    // plain object → fulfilled
                    errors = JSBridge__Pop()
                    it = JSBridge__Pop()
                    ReturnValue(JSBridge__CreatePromise(1, el))
                }
                sn = Float_ToInt(JSRT_GetPayload(st))
                IfCondition EqualTo(sn, 1) ThenBlock: {
                    errors = JSBridge__Pop()
                    it = JSBridge__Pop()
                    ReturnValue(JSBridge__CreatePromise(1, JSRT_ObjGet(el, "__value__")))
                }
                IfCondition EqualTo(sn, 2) ThenBlock: {
                    reason = JSRT_ObjGet(el, "__value__")
                    errors = JSBridge__Pop()
                    it = JSBridge__Pop()
                    JSRT_ArrPush(errors, reason)
                    rej_count = Add(rej_count, 1)
                    handled = 1
                }
                IfCondition EqualTo(handled, 0) ThenBlock: {
                    // pending — pop and continue
                    errors = JSBridge__Pop()
                    it = JSBridge__Pop()
                }
                ai = Add(ai, 1)
            }
            ReturnValue(JSBridge__CreatePromise(2, errors))
        }

        // ─── PROMISE_CTOR (61) ─── new Promise(executor)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_CTOR) ThenBlock: {
            // Create pending promise
            promise = JSRT_CreateObject()
            // M92: [[Prototype]] = Promise.prototype for instanceof
            IfCondition NotEqual(JSRTState.promise_proto, 0) ThenBlock: {
                JSRT_ObjSet(promise, "__proto__", JSRTState.promise_proto)
            }
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(0))
            JSRT_ObjSet(promise, "__value__", JSRT_Undefined())
            ct_then = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(ct_then, promise)
            JSRT_ObjSet(promise, "then", ct_then)
            ct_catch = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(ct_catch, promise)
            JSRT_ObjSet(promise, "catch", ct_catch)

            // Get executor (arg0)
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                executor = Dereference(save_args)
                ex_type = JSRT_GetType(executor)
                IfCondition EqualTo(ex_type, JSType.FUNCTION) ThenBlock: {
                    // Create resolve/reject native functions with env = promise
                    res_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_INT_RESOLVE, "resolve", 1)
                    JSRT_FuncSetEnv(res_f, promise)
                    rej_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_INT_REJECT, "reject", 1)
                    JSRT_FuncSetEnv(rej_f, promise)
                    // Call executor(resolve, reject) with 2 args
                    ex_args = JSVMCallBuf.buf
                    StoreValue(ex_args, res_f)
                    StoreValue(Add(ex_args, 8), rej_f)
                    JSVM__CallFunc(executor, ex_args, 2)
                }
            }
            ReturnValue(promise)
        }

        // ─── PROMISE_INT_RESOLVE (77) ─── internal resolve(value)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_INT_RESOLVE) ThenBlock: {
            r_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                r_val = Dereference(save_args)
            }
            JSRT_ObjSet(save_pr, "__state__", JSRT_CreateNumber(1))
            JSRT_ObjSet(save_pr, "__value__", r_val)
            JSVMJobs_FireReactions(save_pr)
            ReturnValue(JSRT_Undefined())
        }

        // ─── PROMISE_INT_REJECT (78) ─── internal reject(reason)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_INT_REJECT) ThenBlock: {
            r_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                r_val = Dereference(save_args)
            }
            JSRT_ObjSet(save_pr, "__state__", JSRT_CreateNumber(2))
            JSRT_ObjSet(save_pr, "__value__", r_val)
            JSVMJobs_FireReactions(save_pr)
            ReturnValue(JSRT_Undefined())
        }

        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// PROMISE HELPER — create a promise object with given state and value
// =============================================================================
Function.JSBridge__CreatePromise {
    Input: state: Integer
    Input: value: Address
    Output: Address
    Body: {
        save_state = state
        save_value = value
        p = JSRT_CreateObject()
        // M92: [[Prototype]] = Promise.prototype (function or object ctor)
        IfCondition NotEqual(JSRTState.promise_proto, 0) ThenBlock: {
            JSRT_ObjSet(p, "__proto__", JSRTState.promise_proto)
        } ElseBlock: {
            pglob = JSVM__GetGlobal("Promise")
            pgt = JSRT_GetType(pglob)
            IfCondition Or(EqualTo(pgt, JSType.OBJECT), EqualTo(pgt, JSType.FUNCTION)) ThenBlock: {
                JSBridge__Push(p)
                JSBridge__Push(save_value)
                pproto = JSRT_ObjGet(pglob, "prototype")
                save_value = JSBridge__Pop()
                p = JSBridge__Pop()
                IfCondition EqualTo(JSRT_GetType(pproto), JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(p, "__proto__", pproto)
                }
            }
        }
        JSRT_ObjSet(p, "__class__", JSRT_CreateString("Promise"))
        JSRT_ObjSet(p, "__state__", JSRT_CreateNumber(save_state))
        JSRT_ObjSet(p, "__value__", save_value)
        // Spec: then/catch/finally on Promise.prototype only (no own props).
        // CALL_METHOD supplies receiver to DispatchPromise. Fallback own
        // methods only when shared prototype is missing.
        IfCondition EqualTo(JSRTState.promise_proto, 0) ThenBlock: {
            p_then = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(p_then, p)
            JSRT_ObjSet(p, "then", p_then)
            p_catch = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(p_catch, p)
            JSRT_ObjSet(p, "catch", p_catch)
            p_fin = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_FINALLY, "finally", 1)
            JSRT_FuncSetEnv(p_fin, p)
            JSRT_ObjSet(p, "finally", p_fin)
        }
        ReturnValue(p)
    }
}

// =============================================================================
// NATIVE: console.log — coerce all args to string, print each
// =============================================================================
Function.JSBridge__NConsoleLog {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        ai = 0
        WhileLoop LessThan(ai, save_argc) {
            arg_addr = Add(save_args, Multiply(ai, 8))
            arg_val = Dereference(arg_addr)

            // Convert to string for printing
            JSBridge__Push(save_args)
            JSBridge__Push(save_argc)
            JSBridge__Push(ai)
            str_val = JSRT_ToString(arg_val)
            ai = JSBridge__Pop()
            save_argc = JSBridge__Pop()
            save_args = JSBridge__Pop()

            // Get the string payload and print it (M31a: UTF-16 JS strings)
            str_ptr = JSRT_GetPayload(str_val)
            IfCondition NotEqual(str_ptr, 0) ThenBlock: {
                IfCondition GreaterThan(ai, 0) ThenBlock: {
                    PrintMessage(" ")
                }
                JSRT_PrintJSString(str_ptr)
            }
            ai = Add(ai, 1)
        }
        PrintMessage("\n")
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// NATIVE: document.getElementById — find DOM node by id, return wrapped
// =============================================================================
Function.JSBridge__NGetById {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Get first arg (should be string)
        arg0 = Dereference(save_args)
        arg0_type = JSRT_GetType(arg0)
        IfCondition NotEqual(arg0_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Extract string pointer (M31a: DOM needs C string)
        id_str = JSRT_StrToC(JSRT_GetPayload(arg0))
        IfCondition EqualTo(id_str, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Search DOM tree
        found = DOM_FindById(JSBridgeState.dom_root, id_str)
        IfCondition LessThan(found, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Wrap the DOM node as a JS object
        ReturnValue(JSBridge_WrapNode(found))
    }
}

// =============================================================================
// NATIVE: document.querySelector — simplified v1 (tag name only)
// =============================================================================
Function.JSBridge__NQuerySel {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        arg0 = Dereference(save_args)
        arg0_type = JSRT_GetType(arg0)
        IfCondition NotEqual(arg0_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        sel_str = JSRT_StrToC(JSRT_GetPayload(arg0))
        IfCondition EqualTo(sel_str, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // v1: treat selector as tag name
        found = DOM_FindByTag(JSBridgeState.dom_root, sel_str)
        IfCondition LessThan(found, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        ReturnValue(JSBridge_WrapNode(found))
    }
}

// =============================================================================
// NATIVE: element.getAttribute — get DOM attribute value as JS string
// args[0] = element wrapper object, args[1] = attribute name string
// Note: in practice, the element is the `this` object. For v1, we accept
// args[0] as the attribute name and determine element from the wrapper
// that was used to look up this function. Since JSVM does not pass `this`,
// we use a fallback: if args[0] is a string, treat it as attr name and
// try to find the element from the wrapper cache by scanning for the last
// accessed wrapper. This is a v1 simplification.
// =============================================================================
Function.JSBridge__NGetAttr {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // args[0] = element wrapper, args[1] = attr name
        elem_val = Dereference(save_args)
        JSBridge__Push(save_args)
        JSBridge__Push(save_argc)
        dom_idx = JSBridge__GetDomIdx(elem_val)
        save_argc = JSBridge__Pop()
        save_args = JSBridge__Pop()

        IfCondition LessThan(dom_idx, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Get attribute name string
        name_addr = Add(save_args, 8)
        name_val = Dereference(name_addr)
        name_type = JSRT_GetType(name_val)
        IfCondition NotEqual(name_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        name_str = JSRT_StrToC(JSRT_GetPayload(name_val))
        IfCondition EqualTo(name_str, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Look up attribute in DOM
        JSBridge__Push(dom_idx)
        attr_val = DOM_GetAttr(dom_idx, name_str)
        dom_idx = JSBridge__Pop()
        IfCondition EqualTo(attr_val, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        ReturnValue(JSRT_CreateString(attr_val))
    }
}

// =============================================================================
// NATIVE: element.addEventListener — register event listener
// args[0] = element wrapper, args[1] = event name, args[2] = callback
// =============================================================================
Function.JSBridge__NAddListener {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 3) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // args[0] = element wrapper
        elem_val = Dereference(save_args)
        JSBridge__Push(save_args)
        JSBridge__Push(save_argc)
        dom_idx = JSBridge__GetDomIdx(elem_val)
        save_argc = JSBridge__Pop()
        save_args = JSBridge__Pop()

        IfCondition LessThan(dom_idx, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // args[1] = event name string
        name_addr = Add(save_args, 8)
        name_val = Dereference(name_addr)
        name_str = JSRT_GetPayload(name_val)

        // args[2] = callback function
        cb_addr = Add(save_args, 16)
        cb_val = Dereference(cb_addr)

        // Register the listener
        JSBridge_AddListener(dom_idx, name_str, cb_val)

        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// NATIVE: element.innerHTML get — return inner text as JS string
// args[0] = element wrapper object
// =============================================================================
Function.JSBridge__NInnerHTMLGet {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }

        elem_val = Dereference(save_args)
        JSBridge__Push(save_args)
        dom_idx = JSBridge__GetDomIdx(elem_val)
        save_args = JSBridge__Pop()

        IfCondition LessThan(dom_idx, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }

        text_ptr = JSBridge__GetNodeText(dom_idx)
        IfCondition EqualTo(text_ptr, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }

        ReturnValue(JSRT_CreateString(text_ptr))
    }
}

// =============================================================================
// NATIVE: setTimeout — register one-shot timer
// args[0] = callback function, args[1] = delay in ms
// Returns timer ID as number
// =============================================================================
Function.JSBridge__NSetTimeout {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        // args[0] = callback
        cb_val = Dereference(save_args)

        // args[1] = delay
        delay_addr = Add(save_args, 8)
        delay_val = Dereference(delay_addr)
        JSBridge__Push(cb_val)
        delay_ms = JSRT_ToNumber(delay_val)
        cb_val = JSBridge__Pop()

        // Register one-shot timer (is_interval=0)
        timer_id = JSRT_TimerAdd(cb_val, delay_ms, 0)
        ReturnValue(JSRT_CreateNumber(timer_id))
    }
}

// =============================================================================
// NATIVE: setInterval — register repeating timer
// args[0] = callback function, args[1] = interval in ms
// Returns timer ID as number
// =============================================================================
Function.JSBridge__NSetInterval {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        cb_val = Dereference(save_args)
        delay_addr = Add(save_args, 8)
        delay_val = Dereference(delay_addr)
        JSBridge__Push(cb_val)
        delay_ms = JSRT_ToNumber(delay_val)
        cb_val = JSBridge__Pop()

        // Register interval timer (is_interval=1)
        timer_id = JSRT_TimerAdd(cb_val, delay_ms, 1)
        ReturnValue(JSRT_CreateNumber(timer_id))
    }
}

// =============================================================================
// NATIVE: clearTimeout / clearInterval — remove timer by ID
// args[0] = timer ID number
// =============================================================================
Function.JSBridge__NClearTimeout {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        id_val = Dereference(save_args)
        timer_id = JSRT_ToNumber(id_val)
        JSRT_TimerRemove(timer_id)
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// NATIVE: parseInt — string to integer
// args[0] = string value
// =============================================================================
Function.JSBridge__NParseInt {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        arg0 = Dereference(save_args)
        arg0_type = JSRT_GetType(arg0)
        IfCondition EqualTo(arg0_type, JSType.NUMBER) ThenBlock: {
            // Already a number — return identity
            ReturnValue(arg0)
        }
        IfCondition NotEqual(arg0_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        str_ptr = JSRT_GetPayload(arg0)
        IfCondition EqualTo(str_ptr, 0) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        result = StringToInt(str_ptr)
        ReturnValue(JSRT_CreateNumber(result))
    }
}

// =============================================================================
// LAYOUT METRICS — register hit pool for DOM node box lookups
// Call after Layout_Init so the bridge can find element dimensions.
// =============================================================================
Function.JSBridge_SetLayoutPool {
    Input: pool_ptr: Address
    Input: hit_count: Integer
    Output: Integer
    Body: {
        JSBridgeState.hit_pool_ptr = pool_ptr
        JSBridgeState.hit_count = hit_count
        ReturnValue(1)
    }
}

// =============================================================================
// LAYOUT METRICS — find DOM node box from hit-test pool
// Returns 1 if found, 0 if not. Writes x/y/w/h to JSBridgeState fields.
// =============================================================================
Function.JSBridge__FindNodeBox {
    Input: dom_idx: Integer
    Output: Integer
    Body: {
        save_idx = dom_idx
        // Check if layout hit pool is registered
        pool = JSBridgeState.hit_pool_ptr
        IfCondition EqualTo(pool, 0) ThenBlock: {
            JSBridgeState.box_x = 0
            JSBridgeState.box_y = 0
            JSBridgeState.box_w = 0
            JSBridgeState.box_h = 0
            ReturnValue(0)
        }
        hcount = JSBridgeState.hit_count

        hi = 0
        WhileLoop LessThan(hi, hcount) {
            off = Multiply(hi, 48)
            base = Add(pool, off)
            entry_node = Dereference(Add(base, 32))
            IfCondition EqualTo(entry_node, save_idx) ThenBlock: {
                JSBridgeState.box_x = Dereference(Add(base, 0))
                JSBridgeState.box_y = Dereference(Add(base, 8))
                JSBridgeState.box_w = Dereference(Add(base, 16))
                JSBridgeState.box_h = Dereference(Add(base, 24))
                ReturnValue(1)
            }
            hi = Add(hi, 1)
        }
        // Not found in hit pool — return 0
        JSBridgeState.box_x = 0
        JSBridgeState.box_y = 0
        JSBridgeState.box_w = 0
        JSBridgeState.box_h = 0
        ReturnValue(0)
    }
}

// =============================================================================
// EVENT LISTENER MANAGEMENT
// Listener pool entries (24 bytes each):
//   Offset 0:  dom_node (8) — DOM node index
//   Offset 8:  event_name_ptr (8) — pointer to event name string
//   Offset 16: callback_jsval (8) — JSValue pointer to callback function
// =============================================================================

// Add an event listener. Returns 1 on success, 0 on pool full.
Function.JSBridge_AddListener {
    Input: dom_node: Integer
    Input: event_name: Address
    Input: callback: Address
    Output: Integer
    Body: {
        save_node = dom_node
        save_name = event_name
        save_cb = callback
        IfCondition GreaterEqual(JSBridgeState.listener_count, JSBridgeConst.MAX_LISTENERS) ThenBlock: {
            PrintMessage("[JSBridge] listener pool full\n")
            ReturnValue(0)
        }

        idx = JSBridgeState.listener_count
        JSBridgeState.listener_count = Add(idx, 1)
        base = Add(JSBridgeState.listeners, Multiply(idx, JSBridgeConst.LISTENER_SIZE))
        StoreValue(base, save_node)
        StoreValue(Add(base, 8), save_name)
        StoreValue(Add(base, 16), save_cb)
        ReturnValue(1)
    }
}

// =============================================================================
// CREATE EVENT OBJECT — build a JS Event object with type, target, methods
// event_type = null-terminated string e.g. "click", "input"
// target_obj = JS object for the event target (element wrapper, document, window)
// Returns the Event JS object.
// =============================================================================
Function.JSBridge__CreateEvent {
    Input: event_type: Address
    Input: target_obj: Address
    Output: Address
    Body: {
        save_type = event_type
        save_target = target_obj

        evt = JSRT_CreateObject()
        JSRT__Push(evt)

        // event.type = string
        type_val = JSRT_CreateString(save_type)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "type", type_val)

        // event.target = target element
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "target", save_target)

        // event.currentTarget = target element
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "currentTarget", save_target)

        // event.bubbles = true
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "bubbles", JSRT_CreateBool(1))

        // event.cancelable = true
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "cancelable", JSRT_CreateBool(1))

        // event.defaultPrevented = false (mutable flag)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "defaultPrevented", JSRT_CreateBool(0))

        // event.isTrusted = true
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "isTrusted", JSRT_CreateBool(1))

        // event.timeStamp = 0 (no real clock yet)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "timeStamp", JSRT_CreateNumber(0))

        // event.eventPhase = 2 (AT_TARGET)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "eventPhase", JSRT_CreateNumber(2))

        // event.preventDefault = function
        evt = JSRT__Pop()
        JSRT__Push(evt)
        pd_func = JSBridge__CreateNativeFunc(JSNativeID.EVT_PREVENT_DEFAULT, "preventDefault", 0)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "preventDefault", pd_func)

        // event.stopPropagation = function
        evt = JSRT__Pop()
        JSRT__Push(evt)
        sp_func = JSBridge__CreateNativeFunc(JSNativeID.EVT_STOP_PROPAGATION, "stopPropagation", 0)
        evt = JSRT__Pop()
        JSRT__Push(evt)
        JSRT_ObjSet(evt, "stopPropagation", sp_func)

        // event.stopImmediatePropagation = function
        evt = JSRT__Pop()
        JSRT__Push(evt)
        si_func = JSBridge__CreateNativeFunc(JSNativeID.EVT_STOP_IMMEDIATE, "stopImmediatePropagation", 0)
        evt = JSRT__Pop()

        ReturnValue(evt)
    }
}

// =============================================================================
// FIRE EVENT — invoke all listeners matching dom_node + event_name
// Creates an Event object and calls each matching callback via JSVM.
// Returns number of callbacks invoked.
// =============================================================================
// Fire event on a single node (no bubbling) — internal helper
Function.JSBridge__FireOnNode {
    Input: dom_node: Integer
    Input: event_name: Address
    Output: Integer
    Body: {
        save_node = dom_node
        save_name = event_name
        fired = 0
        li = 0

        WhileLoop LessThan(li, JSBridgeState.listener_count) {
            base = Add(JSBridgeState.listeners, Multiply(li, JSBridgeConst.LISTENER_SIZE))
            entry_node = Dereference(base)
            IfCondition EqualTo(entry_node, save_node) ThenBlock: {
                entry_name = Dereference(Add(base, 8))
                IfCondition NotEqual(entry_name, 0) ThenBlock: {
                    JSBridge__Push(save_node)
                    JSBridge__Push(save_name)
                    JSBridge__Push(li)
                    JSBridge__Push(fired)
                    JSBridge__Push(base)
                    cmp = StringCompare(entry_name, save_name)
                    base = JSBridge__Pop()
                    fired = JSBridge__Pop()
                    li = JSBridge__Pop()
                    save_name = JSBridge__Pop()
                    save_node = JSBridge__Pop()

                    IfCondition EqualTo(cmp, 0) ThenBlock: {
                        // Match found — get callback
                        cb = Dereference(Add(base, 16))
                        cb_type = JSRT_GetType(cb)
                        IfCondition EqualTo(cb_type, JSType.FUNCTION) ThenBlock: {
                            // Create Event object for this callback
                            JSBridge__Push(save_node)
                            JSBridge__Push(save_name)
                            JSBridge__Push(li)
                            JSBridge__Push(fired)
                            JSBridge__Push(cb)
                            // Get the DOM wrapper object as target (or use undefined)
                            target_obj = JSBridge_GetWrapObj(save_node)
                            IfCondition EqualTo(target_obj, 0) ThenBlock: {
                                target_obj = JSRT_Undefined()
                            }
                            evt_obj = JSBridge__CreateEvent(save_name, target_obj)
                            cb = JSBridge__Pop()
                            fired = JSBridge__Pop()
                            li = JSBridge__Pop()
                            save_name = JSBridge__Pop()
                            save_node = JSBridge__Pop()

                            // Call callback with Event as first argument
                            // Store event obj pointer in evt_arg_buf, then call
                            JSBridge__Push(save_node)
                            JSBridge__Push(save_name)
                            JSBridge__Push(li)
                            JSBridge__Push(fired)
                            StoreValue(JSBridgeState.evt_arg_buf, evt_obj)
                            JSVM__CallFunc(cb, JSBridgeState.evt_arg_buf, 1)
                            fired = JSBridge__Pop()
                            li = JSBridge__Pop()
                            save_name = JSBridge__Pop()
                            save_node = JSBridge__Pop()

                            fired = Add(fired, 1)
                        }
                    }
                }
            }
            li = Add(li, 1)
        }
        ReturnValue(fired)
    }
}

// Fire event with DOM bubbling — fire on target, then walk up parent chain
Function.JSBridge_FireEvent {
    Input: dom_node: Integer
    Input: event_name: Address
    Output: Integer
    Body: {
        total_fired = 0

        // Phase 1: fire on target node
        target_fired = JSBridge__FireOnNode(dom_node, event_name)
        total_fired = Add(total_fired, target_fired)

        // Phase 2: bubble up the DOM tree (max 32 levels to prevent infinite loops)
        bubble_node = DOM_GetParent(dom_node)
        bubble_depth = 0
        WhileLoop And(GreaterEqual(bubble_node, 0), LessThan(bubble_depth, 32)) {
            parent_fired = JSBridge__FireOnNode(bubble_node, event_name)
            total_fired = Add(total_fired, parent_fired)
            bubble_node = DOM_GetParent(bubble_node)
            bubble_depth = Add(bubble_depth, 1)
        }

        ReturnValue(total_fired)
    }
}

// =============================================================================
// TIMER TICK — forward to JSRT_TimerTick
// Returns count of expired timers.
// =============================================================================
Function.JSBridge_TickTimers {
    Input: current_ms: Integer
    Output: Integer
    Body: {
        save_ms = current_ms
        ReturnValue(JSRT_TimerTick(save_ms))
    }
}

// =============================================================================
// STATE QUERY — public accessors
// =============================================================================
Function.JSBridge_GetListenerCount {
    Output: Integer
    Body: {
        ReturnValue(JSBridgeState.listener_count)
    }
}

Function.JSBridge_GetWrapCount {
    Output: Integer
    Body: {
        ReturnValue(JSBridgeState.wrap_count)
    }
}

Function.JSBridge_GetDocObj {
    Output: Address
    Body: {
        ReturnValue(JSBridgeState.document_obj)
    }
}

Function.JSBridge_GetConsoleObj {
    Output: Address
    Body: {
        ReturnValue(JSBridgeState.console_obj)
    }
}

Function.JSBridge_GetMathObj {
    Output: Address
    Body: {
        ReturnValue(JSBridgeState.math_obj)
    }
}

Function.JSBridge_GetWindowObj {
    Output: Address
    Body: {
        ReturnValue(JSBridgeState.window_obj)
    }
}

Function.JSBridge_IsInitialized {
    Output: Integer
    Body: {
        ReturnValue(JSBridgeState.initialized)
    }
}

// =============================================================================
// GET LISTENER CALLBACK — retrieve callback JSValue for a listener by index
// Used by the engine to invoke callbacks via JSVM.
// =============================================================================
Function.JSBridge_GetListenerCB {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(save_idx, JSBridgeState.listener_count) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSBridgeState.listeners, Multiply(save_idx, JSBridgeConst.LISTENER_SIZE))
        ReturnValue(Dereference(Add(base, 16)))
    }
}

// =============================================================================
// GET LISTENER NODE — retrieve the DOM node index for a listener by index
// =============================================================================
Function.JSBridge_GetListenerNode {
    Input: idx: Integer
    Output: Integer
    Body: {
        save_idx = idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterEqual(save_idx, JSBridgeState.listener_count) ThenBlock: {
            ReturnValue(-1)
        }
        base = Add(JSBridgeState.listeners, Multiply(save_idx, JSBridgeConst.LISTENER_SIZE))
        ReturnValue(Dereference(base))
    }
}

// =============================================================================
// GET LISTENER EVENT NAME — retrieve event name ptr for a listener by index
// =============================================================================
Function.JSBridge_GetListenerName {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(save_idx, JSBridgeState.listener_count) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSBridgeState.listeners, Multiply(save_idx, JSBridgeConst.LISTENER_SIZE))
        ReturnValue(Dereference(Add(base, 8)))
    }
}

// =============================================================================
// DEBUG — dump bridge state
// =============================================================================
Function.JSBridge_Dump {
    Body: {
        PrintMessage("\n--- JSBridge State ---\n")
        PrintMessage("  initialized: ")
        PrintNumber(JSBridgeState.initialized)
        PrintMessage("\n  dom_root: ")
        PrintNumber(JSBridgeState.dom_root)
        PrintMessage("\n  wrap_count: ")
        PrintNumber(JSBridgeState.wrap_count)
        PrintMessage("\n  listener_count: ")
        PrintNumber(JSBridgeState.listener_count)
        PrintMessage("\n  stack sp: ")
        PrintNumber(JSBridgeStack.sp)
        PrintMessage("\n--- End JSBridge ---\n\n")
    }
}
