// Library.JSBridge.ailang — DOM bindings for JavaScript engine
// Connects JSVM to the HTMLDom tree. Creates JS wrapper objects for DOM
// elements (document, console, Math), registers native functions the VM
// can call, dispatches native calls to the appropriate DOM/Runtime
// functions, manages event listeners (addEventListener), and provides
// timer integration (setTimeout/setInterval forwarding).
//
// CLOBBER SAFETY: Every function saves Input params to locals on the FIRST
// line of Body. Complex expressions broken into steps. JSBridgeTmp fields
// guarded with push/pop across recursive calls.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.XArrays
LibraryImport.StringUtils
LibraryImport.HashMap
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.JSRuntime

// =============================================================================
// BRIDGE CONSTANTS
// =============================================================================
FixedPool.JSBridgeConst {
    "MAX_LISTENERS":  Initialize=256
    "LISTENER_SIZE":  Initialize=24    // dom_node:8, event_name_ptr:8, callback_jsval:8
    "MAX_DOM_WRAPS":  Initialize=512
    "WRAP_SIZE":      Initialize=16    // dom_idx:8, js_obj:8
}

// =============================================================================
// BRIDGE STATE — runtime pools and counters
// =============================================================================
FixedPool.JSBridgeState {
    "listeners":      Initialize=0    // allocated pool for event listeners
    "listener_count": Initialize=0
    "dom_wraps":      Initialize=0    // allocated pool for DOM node -> JS object mapping
    "wrap_count":     Initialize=0
    "document_obj":   Initialize=0    // JS object for 'document'
    "console_obj":    Initialize=0    // JS object for 'console'
    "math_obj":       Initialize=0    // JS object for 'Math'
    "dom_root":       Initialize=0    // DOM root node index
    "initialized":    Initialize=0
    "regexp_proto":   Initialize=0    // RegExp.prototype object
    "window_obj":     Initialize=0    // JS object for 'window'
    "page_url":       Initialize=0    // current page URL (C string ptr)
    "page_url_len":   Initialize=0    // current page URL length
    "evt_arg_buf":    Initialize=0    // 8-byte buffer for passing event arg to callbacks
    "box_x":          Initialize=0    // temp: layout box X from FindNodeBox
    "box_y":          Initialize=0    // temp: layout box Y from FindNodeBox
    "box_w":          Initialize=0    // temp: layout box W from FindNodeBox
    "box_h":          Initialize=0    // temp: layout box H from FindNodeBox
    "hit_pool_ptr":   Initialize=0    // address of Layout hit pool buffer (set by browser)
    "hit_count":      Initialize=0    // Layout hit count value (set by browser after layout)
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.JSBridgeTmp {
    "idx":        Initialize=0
    "ptr":        Initialize=0
    "len":        Initialize=0
    "type":       Initialize=0
    "val":        Initialize=0
    "val2":       Initialize=0
    "addr":       Initialize=0
    "dom_idx":    Initialize=0
    "node":       Initialize=0
    "found":      Initialize=0
    "count":      Initialize=0
    "result":     Initialize=0
    "name_ptr":   Initialize=0
    "cb_val":     Initialize=0
    "obj":        Initialize=0
}

// =============================================================================
// PUSH/POP STACK — clobber safety across function calls
// =============================================================================
FixedPool.JSBridgeStack {
    "pool":       Initialize=0
    "capacity":   Initialize=0
    "sp":         Initialize=0
}

