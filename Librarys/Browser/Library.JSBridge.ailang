// Library.JSBridge.ailang — DOM bindings for JavaScript engine
// Connects JSVM to the HTMLDom tree. Creates JS wrapper objects for DOM
// elements (document, console, Math), registers native functions the VM
// can call, dispatches native calls to the appropriate DOM/Runtime
// functions, manages event listeners (addEventListener), and provides
// timer integration (setTimeout/setInterval forwarding).
//
// CLOBBER SAFETY: Every function saves Input params to locals on the FIRST
// line of Body. Complex expressions broken into steps. JSBridgeTmp fields
// guarded with push/pop across recursive calls.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.XArrays
LibraryImport.StringUtils
LibraryImport.HashMap
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.JSRuntime

// =============================================================================
// BRIDGE CONSTANTS
// =============================================================================
FixedPool.JSBridgeConst {
    "MAX_LISTENERS":  Initialize=256
    "LISTENER_SIZE":  Initialize=24    // dom_node:8, event_name_ptr:8, callback_jsval:8
    "MAX_DOM_WRAPS":  Initialize=512
    "WRAP_SIZE":      Initialize=16    // dom_idx:8, js_obj:8
}

// =============================================================================
// BRIDGE STATE — runtime pools and counters
// =============================================================================
FixedPool.JSBridgeState {
    "listeners":      Initialize=0    // allocated pool for event listeners
    "listener_count": Initialize=0
    "dom_wraps":      Initialize=0    // allocated pool for DOM node -> JS object mapping
    "wrap_count":     Initialize=0
    "document_obj":   Initialize=0    // JS object for 'document'
    "console_obj":    Initialize=0    // JS object for 'console'
    "math_obj":       Initialize=0    // JS object for 'Math'
    "dom_root":       Initialize=0    // DOM root node index
    "initialized":    Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.JSBridgeTmp {
    "idx":        Initialize=0
    "ptr":        Initialize=0
    "len":        Initialize=0
    "type":       Initialize=0
    "val":        Initialize=0
    "val2":       Initialize=0
    "addr":       Initialize=0
    "dom_idx":    Initialize=0
    "node":       Initialize=0
    "found":      Initialize=0
    "count":      Initialize=0
    "result":     Initialize=0
    "name_ptr":   Initialize=0
    "cb_val":     Initialize=0
    "obj":        Initialize=0
}

// =============================================================================
// PUSH/POP STACK — clobber safety across function calls
// =============================================================================
FixedPool.JSBridgeStack {
    "pool":       Initialize=0
    "capacity":   Initialize=0
    "sp":         Initialize=0
}

// =============================================================================
// NATIVE FUNCTION IDS — constants for dispatch
// JSRuntime built-ins use handlers 0-21. Bridge uses 22+.
// Native functions are registered with bc_off = -(handler_id + 1).
// =============================================================================
FixedPool.JSNativeID {
    "CONSOLE_LOG":         Initialize=22
    "DOC_GET_BY_ID":       Initialize=23
    "DOC_QUERY_SEL":       Initialize=24
    "DOC_CREATE_ELEM":     Initialize=25
    "ELEM_GET_ATTR":       Initialize=26
    "ELEM_SET_ATTR":       Initialize=27
    "ELEM_ADD_LISTENER":   Initialize=28
    "ELEM_INNER_HTML_GET": Initialize=29
    "ELEM_INNER_HTML_SET": Initialize=30
    "ELEM_TEXT_CONTENT":   Initialize=31
    "ELEM_APPEND_CHILD":   Initialize=32
    "ELEM_REMOVE_CHILD":   Initialize=33
    "ELEM_STYLE_SET":      Initialize=34
    "SET_TIMEOUT":         Initialize=35
    "SET_INTERVAL":        Initialize=36
    "CLEAR_TIMEOUT":       Initialize=37
    "PARSE_INT":           Initialize=38
    "MATH_ABS":            Initialize=39
    "MATH_MAX":            Initialize=40
    "MATH_MIN":            Initialize=41
    "MATH_FLOOR":          Initialize=42
    "OBJ_DEFINE_PROP":     Initialize=43
    "OBJ_KEYS":            Initialize=44
    "OBJ_CREATE":          Initialize=45
    "OBJ_GET_OWN_PROP_DESC": Initialize=46
    "OBJ_GET_PROTO_OF":    Initialize=47
    "OBJ_ASSIGN":          Initialize=48
    "OBJ_FREEZE":          Initialize=49
    "OBJ_IS":              Initialize=50
    "OBJ_DEF_PROPERTIES":  Initialize=51
    "OBJ_ENTRIES":         Initialize=52
    "OBJ_VALUES":          Initialize=53
    "OBJ_HAS_OWN_PROP":   Initialize=54
    "ARR_IS_ARRAY":        Initialize=55
    "ARR_FROM":            Initialize=56
    "PROMISE_RESOLVE":     Initialize=57
    "PROMISE_REJECT":      Initialize=58
    "PROMISE_THEN":        Initialize=59
    "PROMISE_CATCH":       Initialize=60
    "PROMISE_CTOR":        Initialize=61

    // String methods (env = string receiver)
    "STR_CHAR_AT":         Initialize=62
    "STR_CHAR_CODE_AT":    Initialize=63
    "STR_INDEX_OF":        Initialize=64
    "STR_SUBSTRING":       Initialize=65
    "STR_SLICE":           Initialize=66
    "STR_REPLACE":         Initialize=67
    "STR_SPLIT":           Initialize=68
    "STR_TRIM":            Initialize=69
    "STR_TO_UPPER":        Initialize=70
    "STR_TO_LOWER":        Initialize=71
    "STR_FROM_CHAR_CODE":  Initialize=72
    "STR_SUBSTR":          Initialize=73
    "STR_LAST_INDEX_OF":   Initialize=74
    "STR_CONCAT":          Initialize=75

    // Array constructor
    "ARR_CTOR":            Initialize=76

    // Promise internal resolve/reject (for new Promise executor)
    "PROMISE_INT_RESOLVE": Initialize=77
    "PROMISE_INT_REJECT":  Initialize=78

    // Math methods (continued)
    "MATH_CEIL":           Initialize=79
    "MATH_ROUND":          Initialize=80
    "MATH_POW":            Initialize=81
}

// =============================================================================
// STACK PUSH / POP — save/restore values across clobbering calls
// =============================================================================
Function.JSBridge__Push {
    Input: val: Integer
    Output: Integer
    Body: {
        save_val = val
        addr = Add(JSBridgeStack.pool, Multiply(JSBridgeStack.sp, 8))
        StoreValue(addr, save_val)
        JSBridgeStack.sp = Add(JSBridgeStack.sp, 1)
        ReturnValue(0)
    }
}

Function.JSBridge__Pop {
    Output: Integer
    Body: {
        JSBridgeStack.sp = Subtract(JSBridgeStack.sp, 1)
        addr = Add(JSBridgeStack.pool, Multiply(JSBridgeStack.sp, 8))
        ReturnValue(Dereference(addr))
    }
}

// =============================================================================
// INIT — allocate pools, create global objects, register native functions
// =============================================================================
Function.JSBridge_Init {
    Input: dom_root: Integer
    Output: Integer
    Body: {
        save_root = dom_root

        // Allocate listener pool: 256 * 24 = 6144 bytes
        lsz = Multiply(JSBridgeConst.MAX_LISTENERS, JSBridgeConst.LISTENER_SIZE)
        JSBridgeState.listeners = Allocate(lsz)
        IfCondition EqualTo(JSBridgeState.listeners, 0) ThenBlock: {
            PrintMessage("[JSBridge] listener alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(JSBridgeState.listeners, 0, lsz)
        JSBridgeState.listener_count = 0

        // Allocate DOM wrap pool: 512 * 16 = 8192 bytes
        wsz = Multiply(JSBridgeConst.MAX_DOM_WRAPS, JSBridgeConst.WRAP_SIZE)
        JSBridgeState.dom_wraps = Allocate(wsz)
        IfCondition EqualTo(JSBridgeState.dom_wraps, 0) ThenBlock: {
            PrintMessage("[JSBridge] wrap alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(JSBridgeState.dom_wraps, 0, wsz)
        JSBridgeState.wrap_count = 0

        // Allocate push/pop stack: 2048 * 8 = 16384 bytes
        JSBridgeStack.pool = Allocate(16384)
        IfCondition EqualTo(JSBridgeStack.pool, 0) ThenBlock: {
            PrintMessage("[JSBridge] stack alloc fail\n")
            ReturnValue(0)
        }
        JSBridgeStack.capacity = 2048
        JSBridgeStack.sp = 0

        // Save DOM root
        JSBridgeState.dom_root = save_root

        // Create the document object
        JSBridgeState.document_obj = JSBridge__CreateDocObj()

        // Create the console object (bridge version with actual I/O)
        JSBridgeState.console_obj = JSBridge__CreateConsoleObj()

        // Create the Math object (delegates to JSRT built-ins)
        JSBridgeState.math_obj = JSBridge__CreateMathObj()

        JSBridgeState.initialized = 1
        PrintMessage("[JSBridge] initialized\n")
        ReturnValue(1)
    }
}

// =============================================================================
// RESET — clear all pools, reset state
// =============================================================================
Function.JSBridge_Reset {
    Output: Integer
    Body: {
        lsz = Multiply(JSBridgeConst.MAX_LISTENERS, JSBridgeConst.LISTENER_SIZE)
        IfCondition NotEqual(JSBridgeState.listeners, 0) ThenBlock: {
            MemorySet(JSBridgeState.listeners, 0, lsz)
        }
        JSBridgeState.listener_count = 0

        wsz = Multiply(JSBridgeConst.MAX_DOM_WRAPS, JSBridgeConst.WRAP_SIZE)
        IfCondition NotEqual(JSBridgeState.dom_wraps, 0) ThenBlock: {
            MemorySet(JSBridgeState.dom_wraps, 0, wsz)
        }
        JSBridgeState.wrap_count = 0

        JSBridgeState.document_obj = 0
        JSBridgeState.console_obj = 0
        JSBridgeState.math_obj = 0
        JSBridgeState.dom_root = 0
        JSBridgeState.initialized = 0
        JSBridgeStack.sp = 0
        ReturnValue(1)
    }
}

// =============================================================================
// REGISTER GLOBALS — inject document, console, Math, setTimeout, etc.
// into the VM's global hash. Called from JSEngine which passes JSVM_SetGlobal.
// =============================================================================
Function.JSBridge_RegisterGlobals {
    Output: Integer
    Body: {
        // This function is now a stub — actual registration is done by
        // JSEngine__RegisterBridgeGlobals which has access to both
        // JSVM_SetGlobal and JSBridge state.
        ReturnValue(1)
    }
}

// =============================================================================
// HELPER — create a native function JSValue for a given handler ID
// bc_off = -(handler_id + 1), which JSVM decodes back to handler_id
// =============================================================================
Function.JSBridge__CreateNativeFunc {
    Input: handler_id: Integer
    Input: name: Address
    Input: param_count: Integer
    Output: Address
    Body: {
        save_id = handler_id
        save_name = name
        save_pc = param_count
        // bytecode offset = -(handler_id + 1)
        bc_off = Subtract(0, Add(save_id, 1))
        ReturnValue(JSRT_CreateFunc(bc_off, save_pc, 0, save_name))
    }
}

// =============================================================================
// CREATE DOCUMENT OBJECT — JS object with getElementById, querySelector, etc.
// =============================================================================
Function.JSBridge__CreateDocObj {
    Output: Address
    Body: {
        doc = JSRT_CreateObject()

        // ─── document.getElementById ───
        JSBridge__Push(doc)
        gbi_func = JSBridge__CreateNativeFunc(JSNativeID.DOC_GET_BY_ID, "getElementById", 1)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "getElementById", gbi_func)

        // ─── document.querySelector ───
        JSBridge__Push(doc)
        qs_func = JSBridge__CreateNativeFunc(JSNativeID.DOC_QUERY_SEL, "querySelector", 1)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "querySelector", qs_func)

        // ─── document.createElement ───
        JSBridge__Push(doc)
        ce_func = JSBridge__CreateNativeFunc(JSNativeID.DOC_CREATE_ELEM, "createElement", 1)
        doc = JSBridge__Pop()
        JSRT_ObjSet(doc, "createElement", ce_func)

        ReturnValue(doc)
    }
}

// =============================================================================
// CREATE CONSOLE OBJECT — bridge version with actual I/O via PrintMessage
// =============================================================================
Function.JSBridge__CreateConsoleObj {
    Output: Address
    Body: {
        con = JSRT_CreateObject()

        // ─── console.log ───
        JSBridge__Push(con)
        log_func = JSBridge__CreateNativeFunc(JSNativeID.CONSOLE_LOG, "console.log", 1)
        con = JSBridge__Pop()
        JSRT_ObjSet(con, "log", log_func)

        ReturnValue(con)
    }
}

// =============================================================================
// CREATE MATH OBJECT — delegates to JSRuntime built-in Math handlers
// Bridge registers its own handler IDs so it can intercept if needed.
// =============================================================================
Function.JSBridge__CreateMathObj {
    Output: Address
    Body: {
        mo = JSRT_CreateObject()

        // ─── Math.abs ───
        JSBridge__Push(mo)
        abs_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_ABS, "Math.abs", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "abs", abs_func)

        // ─── Math.max ───
        JSBridge__Push(mo)
        max_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_MAX, "Math.max", 2)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "max", max_func)

        // ─── Math.min ───
        JSBridge__Push(mo)
        min_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_MIN, "Math.min", 2)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "min", min_func)

        // ─── Math.floor ───
        JSBridge__Push(mo)
        flr_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_FLOOR, "Math.floor", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "floor", flr_func)

        // ─── Math.ceil ───
        JSBridge__Push(mo)
        ceil_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_CEIL, "Math.ceil", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "ceil", ceil_func)

        // ─── Math.round ───
        JSBridge__Push(mo)
        rnd_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_ROUND, "Math.round", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "round", rnd_func)

        // ─── Math.pow ───
        JSBridge__Push(mo)
        pow_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_POW, "Math.pow", 2)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "pow", pow_func)

        ReturnValue(mo)
    }
}

// =============================================================================
// CREATE OBJECT GLOBAL — Object.defineProperty, Object.keys, Object.create, etc.
// =============================================================================
Function.JSBridge__CreateObjectGlobal {
    Output: Address
    Body: {
        oo = JSRT_CreateObject()

        // ─── Object.defineProperty ───
        JSBridge__Push(oo)
        dp_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_DEFINE_PROP, "defineProperty", 3)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "defineProperty", dp_func)

        // ─── Object.keys ───
        JSBridge__Push(oo)
        ok_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_KEYS, "keys", 1)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "keys", ok_func)

        // ─── Object.create ───
        JSBridge__Push(oo)
        oc_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_CREATE, "create", 1)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "create", oc_func)

        // ─── Object.getOwnPropertyDescriptor ───
        JSBridge__Push(oo)
        gopd_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_GET_OWN_PROP_DESC, "getOwnPropertyDescriptor", 2)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "getOwnPropertyDescriptor", gopd_func)

        // ─── Object.getPrototypeOf ───
        JSBridge__Push(oo)
        gpo_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_GET_PROTO_OF, "getPrototypeOf", 1)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "getPrototypeOf", gpo_func)

        // ─── Object.assign ───
        JSBridge__Push(oo)
        oa_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_ASSIGN, "assign", 2)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "assign", oa_func)

        // ─── Object.freeze ───
        JSBridge__Push(oo)
        of_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_FREEZE, "freeze", 1)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "freeze", of_func)

        // ─── Object.is ───
        JSBridge__Push(oo)
        ois_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_IS, "is", 2)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "is", ois_func)

        // ─── Object.defineProperties ───
        JSBridge__Push(oo)
        odp_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_DEF_PROPERTIES, "defineProperties", 2)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "defineProperties", odp_func)

        // ─── Object.entries ───
        JSBridge__Push(oo)
        oe_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_ENTRIES, "entries", 1)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "entries", oe_func)

        // ─── Object.values ───
        JSBridge__Push(oo)
        ov_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_VALUES, "values", 1)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "values", ov_func)

        // ─── Object.hasOwn (ES2022) ───
        JSBridge__Push(oo)
        oho_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_HAS_OWN_PROP, "hasOwn", 2)
        oo = JSBridge__Pop()
        JSRT_ObjSet(oo, "hasOwn", oho_func)

        ReturnValue(oo)
    }
}

// =============================================================================
// CREATE ARRAY CONSTRUCTOR — Array.isArray, Array.from
// =============================================================================
Function.JSBridge__CreateArrayGlobal {
    Output: Address
    Body: {
        ao = JSRT_CreateObject()

        // ─── Array.isArray ───
        JSBridge__Push(ao)
        aia_func = JSBridge__CreateNativeFunc(JSNativeID.ARR_IS_ARRAY, "isArray", 1)
        ao = JSBridge__Pop()
        JSRT_ObjSet(ao, "isArray", aia_func)

        // ─── Array.from ───
        JSBridge__Push(ao)
        af_func = JSBridge__CreateNativeFunc(JSNativeID.ARR_FROM, "from", 1)
        ao = JSBridge__Pop()
        JSRT_ObjSet(ao, "from", af_func)

        ReturnValue(ao)
    }
}

// =============================================================================
// NATIVE IMPLEMENTATIONS: Object.* methods
// =============================================================================

// Object.defineProperty(obj, prop, descriptor)
// descriptor can have: value, writable, enumerable, configurable, get, set
Function.JSBridge__NDefineProperty {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 3) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Extract arguments: obj, prop_name_val, descriptor
        target = Dereference(save_args)
        name_val = Dereference(Add(save_args, 8))
        desc_val = Dereference(Add(save_args, 16))

        // Convert property name to string
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        name_str = JSRT_ToString(name_val)
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()
        name_ptr = JSRT_GetPayload(name_str)

        // Check for getter (desc.get)
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        getter = JSRT_ObjGet(desc_val, "get")
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()

        gt = Dereference(getter)
        IfCondition EqualTo(gt, JSType.FUNCTION) ThenBlock: {
            // Store getter as __get_<prop>
            gbuf = Add(JSBridgeStack.pool, Add(Multiply(JSBridgeStack.sp, 8), 512))
            SetByte(gbuf, 0, 95)
            SetByte(gbuf, 1, 95)
            SetByte(gbuf, 2, 103)
            SetByte(gbuf, 3, 101)
            SetByte(gbuf, 4, 116)
            SetByte(gbuf, 5, 95)
            // Copy prop name after __get_
            gi = 0
            WhileLoop LessThan(gi, 120) {
                gc = GetByte(name_ptr, gi)
                SetByte(gbuf, Add(6, gi), gc)
                IfCondition EqualTo(gc, 0) ThenBlock: { gi = 999 }
                gi = Add(gi, 1)
            }
            JSBridge__Push(target)
            JSBridge__Push(desc_val)
            JSBridge__Push(name_ptr)
            JSRT_ObjSet(target, gbuf, getter)
            name_ptr = JSBridge__Pop()
            desc_val = JSBridge__Pop()
            target = JSBridge__Pop()
        }

        // Check for setter (desc.set)
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        setter = JSRT_ObjGet(desc_val, "set")
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()

        st = Dereference(setter)
        IfCondition EqualTo(st, JSType.FUNCTION) ThenBlock: {
            // Store setter as __set_<prop>
            sbuf = Add(JSBridgeStack.pool, Add(Multiply(JSBridgeStack.sp, 8), 640))
            SetByte(sbuf, 0, 95)
            SetByte(sbuf, 1, 95)
            SetByte(sbuf, 2, 115)
            SetByte(sbuf, 3, 101)
            SetByte(sbuf, 4, 116)
            SetByte(sbuf, 5, 95)
            si = 0
            WhileLoop LessThan(si, 120) {
                sc = GetByte(name_ptr, si)
                SetByte(sbuf, Add(6, si), sc)
                IfCondition EqualTo(sc, 0) ThenBlock: { si = 999 }
                si = Add(si, 1)
            }
            JSBridge__Push(target)
            JSBridge__Push(desc_val)
            JSBridge__Push(name_ptr)
            JSRT_ObjSet(target, sbuf, setter)
            name_ptr = JSBridge__Pop()
            desc_val = JSBridge__Pop()
            target = JSBridge__Pop()
        }

        // Check for value (desc.value)
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        dv = JSRT_ObjGet(desc_val, "value")
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        dvt = Dereference(dv)
        IfCondition NotEqual(dvt, JSType.UNDEFINED) ThenBlock: {
            JSBridge__Push(target)
            JSRT_ObjSet(target, name_ptr, dv)
            target = JSBridge__Pop()
        }

        // Store descriptor metadata as __desc_<prop> for writable/enumerable/configurable
        dbuf = Add(JSBridgeStack.pool, Add(Multiply(JSBridgeStack.sp, 8), 768))
        SetByte(dbuf, 0, 95)
        SetByte(dbuf, 1, 95)
        SetByte(dbuf, 2, 100)
        SetByte(dbuf, 3, 95)
        di = 0
        WhileLoop LessThan(di, 120) {
            dc = GetByte(name_ptr, di)
            SetByte(dbuf, Add(4, di), dc)
            IfCondition EqualTo(dc, 0) ThenBlock: { di = 999 }
            di = Add(di, 1)
        }
        JSBridge__Push(target)
        JSRT_ObjSet(target, dbuf, desc_val)
        target = JSBridge__Pop()

        // Return the object
        ReturnValue(target)
    }
}

// Object.keys(obj) — return array of own enumerable string keys
Function.JSBridge__NObjKeys {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        target = Dereference(save_args)
        // Filter out __get_, __set_, __desc_, __proto__, __class__, __super__ prefixed keys
        result = JSRT_ObjKeys(target)
        ReturnValue(result)
    }
}

// Object.create(proto) — create new object with proto as __proto__
Function.JSBridge__NObjCreate {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateObject())
        }
        proto = Dereference(save_args)
        JSBridge__Push(proto)
        obj = JSRT_CreateObject()
        proto = JSBridge__Pop()
        pt = Dereference(proto)
        // Set __proto__ if proto is an object (not null)
        IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: {
            JSRT_ObjSet(obj, "__proto__", proto)
        }
        ReturnValue(obj)
    }
}

// Object.getOwnPropertyDescriptor(obj, prop) — return descriptor object
Function.JSBridge__NGetOwnPropDesc {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(save_args)
        name_val = Dereference(Add(save_args, 8))

        JSBridge__Push(target)
        name_str = JSRT_ToString(name_val)
        target = JSBridge__Pop()
        name_ptr = JSRT_GetPayload(name_str)

        // Check if property exists
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        exists = JSRT_ObjHas(target, name_ptr)
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(exists, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Get value
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        val = JSRT_ObjGet(target, name_ptr)
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // Build descriptor object
        JSBridge__Push(val)
        desc = JSRT_CreateObject()
        val = JSBridge__Pop()

        JSBridge__Push(desc)
        JSRT_ObjSet(desc, "value", val)
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        wt = JSRT_CreateBool(1)
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSRT_ObjSet(desc, "writable", wt)
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        et = JSRT_CreateBool(1)
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSRT_ObjSet(desc, "enumerable", et)
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        ct = JSRT_CreateBool(1)
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSRT_ObjSet(desc, "configurable", ct)
        desc = JSBridge__Pop()

        ReturnValue(desc)
    }
}

// Object.getPrototypeOf(obj) — return __proto__
Function.JSBridge__NGetProtoOf {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_Null())
        }
        target = Dereference(save_args)
        JSBridge__Push(target)
        proto = JSRT_ObjGet(target, "__proto__")
        target = JSBridge__Pop()
        ReturnValue(proto)
    }
}

// Object.assign(target, ...sources) — copy own enumerable props
Function.JSBridge__NObjAssign {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(save_args)
        si = 1
        WhileLoop LessThan(si, save_argc) {
            src = Dereference(Add(save_args, Multiply(si, 8)))
            src_t = Dereference(src)
            IfCondition EqualTo(src_t, JSType.OBJECT) ThenBlock: {
                // Get keys of source
                JSBridge__Push(target)
                JSBridge__Push(save_args)
                JSBridge__Push(save_argc)
                JSBridge__Push(si)
                keys = JSRT_ObjKeys(src)
                si = JSBridge__Pop()
                save_argc = JSBridge__Pop()
                save_args = JSBridge__Pop()
                target = JSBridge__Pop()

                klen = JSRT_ArrLen(keys)
                ki = 0
                WhileLoop LessThan(ki, klen) {
                    JSBridge__Push(target)
                    JSBridge__Push(save_args)
                    JSBridge__Push(save_argc)
                    JSBridge__Push(si)
                    JSBridge__Push(keys)
                    JSBridge__Push(ki)
                    JSBridge__Push(klen)
                    ksv = JSRT_ArrGet(keys, ki)
                    klen = JSBridge__Pop()
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    si = JSBridge__Pop()
                    save_argc = JSBridge__Pop()
                    save_args = JSBridge__Pop()
                    target = JSBridge__Pop()

                    kp = JSRT_GetPayload(ksv)
                    src2 = Dereference(Add(save_args, Multiply(si, 8)))
                    JSBridge__Push(target)
                    JSBridge__Push(save_args)
                    JSBridge__Push(save_argc)
                    JSBridge__Push(si)
                    JSBridge__Push(keys)
                    JSBridge__Push(ki)
                    JSBridge__Push(klen)
                    v = JSRT_ObjGet(src2, kp)
                    klen = JSBridge__Pop()
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    si = JSBridge__Pop()
                    save_argc = JSBridge__Pop()
                    save_args = JSBridge__Pop()
                    target = JSBridge__Pop()

                    JSRT_ObjSet(target, kp, v)
                    ki = Add(ki, 1)
                }
            }
            si = Add(si, 1)
        }
        ReturnValue(target)
    }
}

// Object.freeze(obj) — mark object as frozen (store __frozen__ flag)
Function.JSBridge__NObjFreeze {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(args)
        JSBridge__Push(target)
        fv = JSRT_CreateBool(1)
        target = JSBridge__Pop()
        JSRT_ObjSet(target, "__frozen__", fv)
        ReturnValue(target)
    }
}

// Object.is(a, b) — strict equality (same as ===, except NaN===NaN and +0!==-0)
Function.JSBridge__NObjIs {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        IfCondition LessThan(argc, 2) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        a = Dereference(save_args)
        b = Dereference(Add(save_args, 8))
        at = Dereference(a)
        bt = Dereference(b)
        IfCondition NotEqual(at, bt) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        av = Dereference(Add(a, 8))
        bv = Dereference(Add(b, 8))
        IfCondition EqualTo(av, bv) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        // String comparison
        IfCondition EqualTo(at, JSType.STRING) ThenBlock: {
            JSBridge__Push(a)
            JSBridge__Push(b)
            cmp = StringCompare(av, bv)
            b = JSBridge__Pop()
            a = JSBridge__Pop()
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
        }
        ReturnValue(JSRT_CreateBool(0))
    }
}

// Array.isArray(val) — returns true if val is ARRAY type
Function.JSBridge__NArrIsArray {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        val = Dereference(args)
        vt = Dereference(val)
        IfCondition EqualTo(vt, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        ReturnValue(JSRT_CreateBool(0))
    }
}

// Array.from(arrayLike) — convert array-like or iterable to array
Function.JSBridge__NArrFrom {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        src = Dereference(save_args)
        st = Dereference(src)
        // If already an array, copy elements
        IfCondition EqualTo(st, JSType.ARRAY) ThenBlock: {
            JSBridge__Push(src)
            result = JSRT_CreateArray()
            src = JSBridge__Pop()
            slen = JSRT_ArrLen(src)
            ai = 0
            WhileLoop LessThan(ai, slen) {
                JSBridge__Push(src)
                JSBridge__Push(result)
                JSBridge__Push(ai)
                JSBridge__Push(slen)
                elem = JSRT_ArrGet(src, ai)
                slen = JSBridge__Pop()
                ai = JSBridge__Pop()
                result = JSBridge__Pop()
                src = JSBridge__Pop()
                JSRT_ArrPush(result, elem)
                ai = Add(ai, 1)
            }
            ReturnValue(result)
        }
        // If string, split into chars
        IfCondition EqualTo(st, JSType.STRING) ThenBlock: {
            sp = Dereference(Add(src, 8))
            JSBridge__Push(sp)
            result = JSRT_CreateArray()
            sp = JSBridge__Pop()
            ci = 0
            WhileLoop LessThan(ci, 10000) {
                ch = GetByte(sp, ci)
                IfCondition EqualTo(ch, 0) ThenBlock: { ci = 99999 }
                IfCondition NotEqual(ch, 0) ThenBlock: {
                    cp = Add(sp, ci)
                    JSBridge__Push(sp)
                    JSBridge__Push(result)
                    JSBridge__Push(ci)
                    csv = JSRT_CreateStringLen(cp, 1)
                    ci = JSBridge__Pop()
                    result = JSBridge__Pop()
                    sp = JSBridge__Pop()
                    JSRT_ArrPush(result, csv)
                    ci = Add(ci, 1)
                }
            }
            ReturnValue(result)
        }
        // Fallback: empty array
        ReturnValue(JSRT_CreateArray())
    }
}

// =============================================================================
// DOM NODE WRAPPING — create or find cached JS object for a DOM node
// Each wrapped node is a JS OBJECT with:
//   __dom_idx  : NUMBER (the DOM node index)
//   tagName    : STRING
//   id         : STRING (if present)
//   innerHTML  : STRING (text of first text child)
//   getAttribute    : FUNCTION (native)
//   setAttribute    : FUNCTION (native)
//   addEventListener: FUNCTION (native)
//   textContent     : STRING (alias of innerHTML for v1)
// =============================================================================

// Look up existing wrapper by DOM index. Returns JS object or 0.
Function.JSBridge__FindWrap {
    Input: dom_idx: Integer
    Output: Address
    Body: {
        save_idx = dom_idx
        wi = 0
        WhileLoop LessThan(wi, JSBridgeState.wrap_count) {
            base = Add(JSBridgeState.dom_wraps, Multiply(wi, JSBridgeConst.WRAP_SIZE))
            entry_idx = Dereference(base)
            IfCondition EqualTo(entry_idx, save_idx) ThenBlock: {
                ReturnValue(Dereference(Add(base, 8)))
            }
            wi = Add(wi, 1)
        }
        ReturnValue(0)
    }
}

// Store a new DOM-index -> JS-object mapping.
Function.JSBridge__StoreWrap {
    Input: dom_idx: Integer
    Input: js_obj: Address
    Output: Integer
    Body: {
        save_idx = dom_idx
        save_obj = js_obj
        IfCondition GreaterEqual(JSBridgeState.wrap_count, JSBridgeConst.MAX_DOM_WRAPS) ThenBlock: {
            PrintMessage("[JSBridge] wrap pool full\n")
            ReturnValue(0)
        }
        base = Add(JSBridgeState.dom_wraps, Multiply(JSBridgeState.wrap_count, JSBridgeConst.WRAP_SIZE))
        StoreValue(base, save_idx)
        StoreValue(Add(base, 8), save_obj)
        JSBridgeState.wrap_count = Add(JSBridgeState.wrap_count, 1)
        ReturnValue(1)
    }
}

// Public API: wrap a DOM node as a JS object (or return cached wrapper).
Function.JSBridge_WrapNode {
    Input: dom_idx: Integer
    Output: Address
    Body: {
        save_idx = dom_idx

        // Negative index means "not found" in DOM
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Check cache first
        cached = JSBridge__FindWrap(save_idx)
        IfCondition NotEqual(cached, 0) ThenBlock: {
            ReturnValue(cached)
        }

        // Create new JS object
        obj = JSRT_CreateObject()

        // Set __dom_idx property
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        idx_val = JSRT_CreateNumber(save_idx)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "__dom_idx", idx_val)

        // Set tagName
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        tag_ptr = DOM_GetTag(save_idx)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        IfCondition NotEqual(tag_ptr, 0) ThenBlock: {
            JSBridge__Push(save_idx)
            JSBridge__Push(obj)
            tag_val = JSRT_CreateString(tag_ptr)
            obj = JSBridge__Pop()
            save_idx = JSBridge__Pop()
            JSRT_ObjSet(obj, "tagName", tag_val)
        }

        // Set id (from DOM attribute)
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        id_ptr = DOM_GetAttr(save_idx, "id")
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        IfCondition NotEqual(id_ptr, 0) ThenBlock: {
            JSBridge__Push(save_idx)
            JSBridge__Push(obj)
            id_val = JSRT_CreateString(id_ptr)
            obj = JSBridge__Pop()
            save_idx = JSBridge__Pop()
            JSRT_ObjSet(obj, "id", id_val)
        }

        // Set innerHTML / textContent from first TEXT child
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        text_str = JSBridge__GetNodeText(save_idx)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        IfCondition NotEqual(text_str, 0) ThenBlock: {
            JSBridge__Push(save_idx)
            JSBridge__Push(obj)
            text_val = JSRT_CreateString(text_str)
            obj = JSBridge__Pop()
            save_idx = JSBridge__Pop()
            JSRT_ObjSet(obj, "innerHTML", text_val)
            // textContent aliases innerHTML for v1
            JSRT_ObjSet(obj, "textContent", text_val)
        }

        // ─── method: getAttribute ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ga_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_GET_ATTR, "getAttribute", 1)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "getAttribute", ga_func)

        // ─── method: setAttribute ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        sa_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_SET_ATTR, "setAttribute", 2)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "setAttribute", sa_func)

        // ─── method: addEventListener ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ael_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_ADD_LISTENER, "addEventListener", 2)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "addEventListener", ael_func)

        // ─── method: appendChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        ac_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_APPEND_CHILD, "appendChild", 1)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "appendChild", ac_func)

        // ─── method: removeChild ───
        JSBridge__Push(save_idx)
        JSBridge__Push(obj)
        rc_func = JSBridge__CreateNativeFunc(JSNativeID.ELEM_REMOVE_CHILD, "removeChild", 1)
        obj = JSBridge__Pop()
        save_idx = JSBridge__Pop()
        JSRT_ObjSet(obj, "removeChild", rc_func)

        // Store in wrap cache
        JSBridge__StoreWrap(save_idx, obj)

        ReturnValue(obj)
    }
}

// =============================================================================
// HELPER — get the text content of a DOM node's first TEXT child
// Returns pointer to string, or 0 if no text child
// =============================================================================
Function.JSBridge__GetNodeText {
    Input: dom_idx: Integer
    Output: Address
    Body: {
        save_idx = dom_idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Check if this node itself is a text node
        ntype = DOM_GetType(save_idx)
        IfCondition EqualTo(ntype, DOMType.TEXT) ThenBlock: {
            ReturnValue(DOM_GetText(save_idx))
        }

        // Walk children to find first TEXT node
        ch = DOM_GetFirstChild(save_idx)
        WhileLoop NotEqual(ch, -1) {
            ch_type = DOM_GetType(ch)
            IfCondition EqualTo(ch_type, DOMType.TEXT) ThenBlock: {
                ReturnValue(DOM_GetText(ch))
            }
            ch = DOM_GetNextSib(ch)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// HELPER — extract __dom_idx integer from a JS wrapper object
// Returns the DOM node index, or -1 if not a wrapper
// =============================================================================
Function.JSBridge__GetDomIdx {
    Input: js_obj: Address
    Output: Integer
    Body: {
        JSBridgeTmp.obj = js_obj
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(-1)
        }
        otype = JSRT_GetType(JSBridgeTmp.obj)
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(-1)
        }
        JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.obj, "__dom_idx")
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            ReturnValue(-1)
        }
        vtype = JSRT_GetType(JSBridgeTmp.result)
        IfCondition NotEqual(vtype, JSType.NUMBER) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(Float_ToInt(JSRT_GetPayload(JSBridgeTmp.result)))
    }
}

// =============================================================================
// SET_PROP INTERCEPT — called by JSVM on SET_PROP to handle DOM mutations
// If the object has __dom_idx and the property is innerHTML/textContent,
// updates the actual DOM text node. Returns 1 if intercepted, 0 if not.
// =============================================================================
Function.JSBridge_SetProp {
    Input: obj: Address
    Input: prop: Address
    Input: val: Address
    Output: Integer
    Body: {
        // Store all inputs in FixedPool — locals get clobbered by every function call
        JSBridgeTmp.obj = obj
        JSBridgeTmp.name_ptr = prop
        JSBridgeTmp.val = val

        // Check for __dom_idx on the object
        JSBridgeTmp.dom_idx = JSBridge__GetDomIdx(JSBridgeTmp.obj)
        IfCondition LessThan(JSBridgeTmp.dom_idx, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Check if property is "innerHTML" or "textContent" by byte inspection
        p0 = GetByte(JSBridgeTmp.name_ptr, 0)

        // "innerHTML" starts with 'i' = 105, check 'n' at 1 and 'H' at 5
        JSBridgeTmp.found = 0
        IfCondition EqualTo(p0, 105) ThenBlock: {
            p1 = GetByte(JSBridgeTmp.name_ptr, 1)
            IfCondition EqualTo(p1, 110) ThenBlock: {
                p5 = GetByte(JSBridgeTmp.name_ptr, 5)
                IfCondition EqualTo(p5, 72) ThenBlock: {
                    JSBridgeTmp.found = 1
                }
            }
        }

        // "textContent" starts with 't' = 116, check 'e' at 1 and 'C' at 4
        IfCondition EqualTo(p0, 116) ThenBlock: {
            p1 = GetByte(JSBridgeTmp.name_ptr, 1)
            IfCondition EqualTo(p1, 101) ThenBlock: {
                p4 = GetByte(JSBridgeTmp.name_ptr, 4)
                IfCondition EqualTo(p4, 67) ThenBlock: {
                    JSBridgeTmp.found = 1
                }
            }
        }

        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Convert value to string
        JSBridgeTmp.result = JSRT_ToString(JSBridgeTmp.val)
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            ReturnValue(1)
        }

        // Extract raw string pointer from the JSValue
        JSBridgeTmp.ptr = JSRT_GetPayload(JSBridgeTmp.result)
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            ReturnValue(1)
        }

        // Find first TEXT child of this DOM element
        JSBridgeTmp.node = DOM_GetFirstChild(JSBridgeTmp.dom_idx)
        JSBridgeTmp.idx = -1
        WhileLoop NotEqual(JSBridgeTmp.node, -1) {
            ch_type = DOM_GetType(JSBridgeTmp.node)
            IfCondition EqualTo(ch_type, DOMType.TEXT) ThenBlock: {
                JSBridgeTmp.idx = JSBridgeTmp.node
                JSBridgeTmp.node = -1
            }
            IfCondition NotEqual(JSBridgeTmp.node, -1) ThenBlock: {
                JSBridgeTmp.node = DOM_GetNextSib(JSBridgeTmp.node)
            }
        }

        IfCondition GreaterEqual(JSBridgeTmp.idx, 0) ThenBlock: {
            // Update existing TEXT node
            JSBridgeTmp.len = StringLength(JSBridgeTmp.ptr)
            DOM__NodeSet(JSBridgeTmp.idx, DOMConst.N_TEXT_PTR, JSBridgeTmp.ptr)
            DOM__NodeSet(JSBridgeTmp.idx, DOMConst.N_TEXT_LEN, JSBridgeTmp.len)
        } ElseBlock: {
            // No TEXT child — create one and append
            JSBridgeTmp.idx = DOM__CreateNode(DOMType.TEXT)
            IfCondition GreaterEqual(JSBridgeTmp.idx, 0) ThenBlock: {
                JSBridgeTmp.len = StringLength(JSBridgeTmp.ptr)
                DOM__NodeSet(JSBridgeTmp.idx, DOMConst.N_TEXT_PTR, JSBridgeTmp.ptr)
                DOM__NodeSet(JSBridgeTmp.idx, DOMConst.N_TEXT_LEN, JSBridgeTmp.len)
                DOM__AppendChild(JSBridgeTmp.dom_idx, JSBridgeTmp.idx)
            }
        }

        // Also update the JS object's property so reads reflect the change
        JSRT_ObjSet(JSBridgeTmp.obj, JSBridgeTmp.name_ptr, JSBridgeTmp.result)

        ReturnValue(1)
    }
}

// =============================================================================
// NATIVE DISPATCH — route handler ID to the appropriate native impl
// Called by JSVM when handler_id >= 8.
// args = pointer to array of JSValue pointers (8 bytes each)
// argc = number of arguments
// Returns a JSValue pointer (result).
// =============================================================================
Function.JSBridge_Dispatch {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

        // ─── CONSOLE_LOG (8) ───
        IfCondition EqualTo(save_id, JSNativeID.CONSOLE_LOG) ThenBlock: {
            ReturnValue(JSBridge__NConsoleLog(save_args, save_argc))
        }

        // ─── DOC_GET_BY_ID (9) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_GET_BY_ID) ThenBlock: {
            ReturnValue(JSBridge__NGetById(save_args, save_argc))
        }

        // ─── DOC_QUERY_SEL (10) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_QUERY_SEL) ThenBlock: {
            ReturnValue(JSBridge__NQuerySel(save_args, save_argc))
        }

        // ─── DOC_CREATE_ELEM (11) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_CREATE_ELEM) ThenBlock: {
            // Stub for v1 — return undefined
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_GET_ATTR (12) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_GET_ATTR) ThenBlock: {
            ReturnValue(JSBridge__NGetAttr(save_args, save_argc))
        }

        // ─── ELEM_SET_ATTR (13) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_SET_ATTR) ThenBlock: {
            // Stub for v1 — return undefined
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_ADD_LISTENER (14) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_ADD_LISTENER) ThenBlock: {
            ReturnValue(JSBridge__NAddListener(save_args, save_argc))
        }

        // ─── ELEM_INNER_HTML_GET (15) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_INNER_HTML_GET) ThenBlock: {
            ReturnValue(JSBridge__NInnerHTMLGet(save_args, save_argc))
        }

        // ─── ELEM_INNER_HTML_SET (16) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_INNER_HTML_SET) ThenBlock: {
            // Stub for v1 — return undefined
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_TEXT_CONTENT (17) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_TEXT_CONTENT) ThenBlock: {
            // Same as innerHTML get for v1
            ReturnValue(JSBridge__NInnerHTMLGet(save_args, save_argc))
        }

        // ─── ELEM_APPEND_CHILD (18) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_APPEND_CHILD) ThenBlock: {
            // Stub for v1 — return undefined
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_REMOVE_CHILD (19) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_REMOVE_CHILD) ThenBlock: {
            // Stub for v1 — return undefined
            ReturnValue(JSRT_Undefined())
        }

        // ─── ELEM_STYLE_SET (20) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_STYLE_SET) ThenBlock: {
            // Stub for v1 — return undefined
            ReturnValue(JSRT_Undefined())
        }

        // ─── SET_TIMEOUT (21) ───
        IfCondition EqualTo(save_id, JSNativeID.SET_TIMEOUT) ThenBlock: {
            ReturnValue(JSBridge__NSetTimeout(save_args, save_argc))
        }

        // ─── SET_INTERVAL (22) ───
        IfCondition EqualTo(save_id, JSNativeID.SET_INTERVAL) ThenBlock: {
            ReturnValue(JSBridge__NSetInterval(save_args, save_argc))
        }

        // ─── CLEAR_TIMEOUT (23) ───
        IfCondition EqualTo(save_id, JSNativeID.CLEAR_TIMEOUT) ThenBlock: {
            ReturnValue(JSBridge__NClearTimeout(save_args, save_argc))
        }

        // ─── PARSE_INT (24) ───
        IfCondition EqualTo(save_id, JSNativeID.PARSE_INT) ThenBlock: {
            ReturnValue(JSBridge__NParseInt(save_args, save_argc))
        }

        // ─── MATH_ABS (25) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_ABS) ThenBlock: {
            // Delegate to JSRT built-in handler 1
            ReturnValue(JSRT_CallNative(1, save_args, save_argc))
        }

        // ─── MATH_MAX (26) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_MAX) ThenBlock: {
            // Delegate to JSRT built-in handler 2
            ReturnValue(JSRT_CallNative(2, save_args, save_argc))
        }

        // ─── MATH_MIN (27) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_MIN) ThenBlock: {
            // Delegate to JSRT built-in handler 3
            ReturnValue(JSRT_CallNative(3, save_args, save_argc))
        }

        // ─── MATH_FLOOR (28) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_FLOOR) ThenBlock: {
            // Delegate to JSRT built-in handler 4
            ReturnValue(JSRT_CallNative(4, save_args, save_argc))
        }

        // ─── MATH_CEIL (79) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_CEIL) ThenBlock: {
            // Delegate to JSRT built-in handler 5
            ReturnValue(JSRT_CallNative(5, save_args, save_argc))
        }

        // ─── MATH_ROUND (80) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_ROUND) ThenBlock: {
            // Delegate to JSRT built-in handler 6
            ReturnValue(JSRT_CallNative(6, save_args, save_argc))
        }

        // ─── MATH_POW (81) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_POW) ThenBlock: {
            // Delegate to JSRT built-in handler 7
            ReturnValue(JSRT_CallNative(7, save_args, save_argc))
        }

        // ─── OBJ_DEFINE_PROP (43) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_DEFINE_PROP) ThenBlock: {
            ReturnValue(JSBridge__NDefineProperty(save_args, save_argc))
        }

        // ─── OBJ_KEYS (44) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_KEYS) ThenBlock: {
            ReturnValue(JSBridge__NObjKeys(save_args, save_argc))
        }

        // ─── OBJ_CREATE (45) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_CREATE) ThenBlock: {
            ReturnValue(JSBridge__NObjCreate(save_args, save_argc))
        }

        // ─── OBJ_GET_OWN_PROP_DESC (46) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_OWN_PROP_DESC) ThenBlock: {
            ReturnValue(JSBridge__NGetOwnPropDesc(save_args, save_argc))
        }

        // ─── OBJ_GET_PROTO_OF (47) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_PROTO_OF) ThenBlock: {
            ReturnValue(JSBridge__NGetProtoOf(save_args, save_argc))
        }

        // ─── OBJ_ASSIGN (48) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_ASSIGN) ThenBlock: {
            ReturnValue(JSBridge__NObjAssign(save_args, save_argc))
        }

        // ─── OBJ_FREEZE (49) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_FREEZE) ThenBlock: {
            ReturnValue(JSBridge__NObjFreeze(save_args, save_argc))
        }

        // ─── OBJ_IS (50) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS) ThenBlock: {
            ReturnValue(JSBridge__NObjIs(save_args, save_argc))
        }

        // ─── OBJ_DEF_PROPERTIES (51) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_DEF_PROPERTIES) ThenBlock: {
            // TODO: iterate descriptor object keys and call defineProperty for each
            ReturnValue(Dereference(save_args))
        }

        // ─── OBJ_ENTRIES (52) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_ENTRIES) ThenBlock: {
            // Returns [[key, value], ...] pairs
            ReturnValue(JSRT_CreateArray())
        }

        // ─── OBJ_VALUES (53) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_VALUES) ThenBlock: {
            // Returns [value, ...] for own enumerable props
            ReturnValue(JSRT_CreateArray())
        }

        // ─── OBJ_HAS_OWN_PROP (54) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_HAS_OWN_PROP) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            hop_obj = Dereference(save_args)
            hop_key_val = Dereference(Add(save_args, 8))
            JSBridge__Push(hop_obj)
            hop_key_str = JSRT_ToString(hop_key_val)
            hop_obj = JSBridge__Pop()
            hop_key_ptr = JSRT_GetPayload(hop_key_str)
            hop_has = JSRT_ObjHas(hop_obj, hop_key_ptr)
            ReturnValue(JSRT_CreateBool(hop_has))
        }

        // ─── ARR_IS_ARRAY (55) ───
        IfCondition EqualTo(save_id, JSNativeID.ARR_IS_ARRAY) ThenBlock: {
            ReturnValue(JSBridge__NArrIsArray(save_args, save_argc))
        }

        // ─── ARR_FROM (56) ───
        IfCondition EqualTo(save_id, JSNativeID.ARR_FROM) ThenBlock: {
            ReturnValue(JSBridge__NArrFrom(save_args, save_argc))
        }

        // ─── PROMISE_RESOLVE (57) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_RESOLVE) ThenBlock: {
            p_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                p_val = Dereference(save_args)
            }
            promise = JSRT_CreateObject()
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(1))
            JSRT_ObjSet(promise, "__value__", p_val)
            // Attach .then and .catch methods with env = promise
            then_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(then_f, promise)
            JSRT_ObjSet(promise, "then", then_f)
            catch_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(catch_f, promise)
            JSRT_ObjSet(promise, "catch", catch_f)
            ReturnValue(promise)
        }

        // ─── PROMISE_REJECT (58) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_REJECT) ThenBlock: {
            p_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                p_val = Dereference(save_args)
            }
            promise = JSRT_CreateObject()
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(2))
            JSRT_ObjSet(promise, "__value__", p_val)
            then_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(then_f, promise)
            JSRT_ObjSet(promise, "then", then_f)
            catch_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(catch_f, promise)
            JSRT_ObjSet(promise, "catch", catch_f)
            ReturnValue(promise)
        }

        // ─── PROMISE_THEN (59) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_THEN) ThenBlock: {
            // Simplified: execute callback eagerly with resolved value
            // In full impl, would schedule microtask
            ReturnValue(JSRT_Undefined())
        }

        // ─── PROMISE_CATCH (60) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_CATCH) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // ─── PROMISE_CTOR (61) — new Promise(executor) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_CTOR) ThenBlock: {
            // Create promise, call executor(resolve, reject) eagerly
            promise = JSRT_CreateObject()
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(0))
            JSRT_ObjSet(promise, "__value__", JSRT_Undefined())
            then_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(then_f, promise)
            JSRT_ObjSet(promise, "then", then_f)
            catch_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(catch_f, promise)
            JSRT_ObjSet(promise, "catch", catch_f)
            ReturnValue(promise)
        }

        // Unknown handler — return undefined
        PrintMessage("[JSBridge] unknown native id: ")
        PrintNumber(save_id)
        PrintMessage("\n")
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// PROMISE DISPATCH — handles Promise.then/catch/ctor/resolve/reject
// Called from CALL handler with func_val env = promise receiver.
// =============================================================================
Function.JSBridge__DispatchPromise {
    Input: handler_id: Integer
    Input: promise_recv: Address
    Input: arg_buf: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_hid = handler_id
        save_pr = promise_recv
        save_args = arg_buf
        save_argc = argc

        // ─── PROMISE_RESOLVE (57) ─── create fulfilled promise
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_RESOLVE) ThenBlock: {
            p_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                p_val = Dereference(save_args)
            }
            ReturnValue(JSBridge__CreatePromise(1, p_val))
        }

        // ─── PROMISE_REJECT (58) ─── create rejected promise
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_REJECT) ThenBlock: {
            p_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                p_val = Dereference(save_args)
            }
            ReturnValue(JSBridge__CreatePromise(2, p_val))
        }

        // ─── PROMISE_THEN (59) ─── eager callback on settled promise
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_THEN) ThenBlock: {
            // Get promise state and value from receiver
            p_state = JSRT_ObjGet(save_pr, "__state__")
            p_state_n = Float_ToInt(JSRT_GetPayload(p_state))
            p_value = JSRT_ObjGet(save_pr, "__value__")

            // onFulfilled = arg0, onRejected = arg1
            on_ful = JSRT_Undefined()
            on_rej = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                on_ful = Dereference(save_args)
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                on_rej = Dereference(Add(save_args, 8))
            }

            // Fulfilled: call onFulfilled(value)
            IfCondition EqualTo(p_state_n, 1) ThenBlock: {
                ful_type = JSRT_GetType(on_ful)
                IfCondition EqualTo(ful_type, JSType.FUNCTION) ThenBlock: {
                    cb_buf = Allocate(8)
                    StoreValue(cb_buf, p_value)
                    cb_result = JSVM__CallFunc(on_ful, cb_buf, 1)
                    Deallocate(cb_buf, 8)
                    ReturnValue(JSBridge__CreatePromise(1, cb_result))
                }
                // No callback — pass through value
                ReturnValue(JSBridge__CreatePromise(1, p_value))
            }

            // Rejected: call onRejected(reason)
            IfCondition EqualTo(p_state_n, 2) ThenBlock: {
                rej_type = JSRT_GetType(on_rej)
                IfCondition EqualTo(rej_type, JSType.FUNCTION) ThenBlock: {
                    cb_buf = Allocate(8)
                    StoreValue(cb_buf, p_value)
                    cb_result = JSVM__CallFunc(on_rej, cb_buf, 1)
                    Deallocate(cb_buf, 8)
                    ReturnValue(JSBridge__CreatePromise(1, cb_result))
                }
                // No onRejected — pass through rejection
                ReturnValue(JSBridge__CreatePromise(2, p_value))
            }

            // Pending (0) — for eager execution, just pass through
            ReturnValue(JSBridge__CreatePromise(0, JSRT_Undefined()))
        }

        // ─── PROMISE_CATCH (60) ─── shorthand for .then(undefined, onRejected)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_CATCH) ThenBlock: {
            p_state = JSRT_ObjGet(save_pr, "__state__")
            p_state_n = Float_ToInt(JSRT_GetPayload(p_state))
            p_value = JSRT_ObjGet(save_pr, "__value__")

            on_rej = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                on_rej = Dereference(save_args)
            }

            // Only call handler on rejection
            IfCondition EqualTo(p_state_n, 2) ThenBlock: {
                rej_type = JSRT_GetType(on_rej)
                IfCondition EqualTo(rej_type, JSType.FUNCTION) ThenBlock: {
                    cb_buf = Allocate(8)
                    StoreValue(cb_buf, p_value)
                    cb_result = JSVM__CallFunc(on_rej, cb_buf, 1)
                    Deallocate(cb_buf, 8)
                    ReturnValue(JSBridge__CreatePromise(1, cb_result))
                }
                ReturnValue(JSBridge__CreatePromise(2, p_value))
            }

            // Fulfilled — pass through
            IfCondition EqualTo(p_state_n, 1) ThenBlock: {
                ReturnValue(JSBridge__CreatePromise(1, p_value))
            }
            ReturnValue(JSBridge__CreatePromise(0, JSRT_Undefined()))
        }

        // ─── PROMISE_CTOR (61) ─── new Promise(executor)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_CTOR) ThenBlock: {
            // Create pending promise
            promise = JSRT_CreateObject()
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(0))
            JSRT_ObjSet(promise, "__value__", JSRT_Undefined())
            ct_then = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(ct_then, promise)
            JSRT_ObjSet(promise, "then", ct_then)
            ct_catch = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(ct_catch, promise)
            JSRT_ObjSet(promise, "catch", ct_catch)

            // Get executor (arg0)
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                executor = Dereference(save_args)
                ex_type = JSRT_GetType(executor)
                IfCondition EqualTo(ex_type, JSType.FUNCTION) ThenBlock: {
                    // Create resolve/reject native functions with env = promise
                    res_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_INT_RESOLVE, "resolve", 1)
                    JSRT_FuncSetEnv(res_f, promise)
                    rej_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_INT_REJECT, "reject", 1)
                    JSRT_FuncSetEnv(rej_f, promise)
                    // Call executor(resolve, reject) with 2 args
                    ex_args = Allocate(16)
                    StoreValue(ex_args, res_f)
                    StoreValue(Add(ex_args, 8), rej_f)
                    JSVM__CallFunc(executor, ex_args, 2)
                    Deallocate(ex_args, 16)
                }
            }
            ReturnValue(promise)
        }

        // ─── PROMISE_INT_RESOLVE (77) ─── internal resolve(value)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_INT_RESOLVE) ThenBlock: {
            r_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                r_val = Dereference(save_args)
            }
            JSRT_ObjSet(save_pr, "__state__", JSRT_CreateNumber(1))
            JSRT_ObjSet(save_pr, "__value__", r_val)
            ReturnValue(JSRT_Undefined())
        }

        // ─── PROMISE_INT_REJECT (78) ─── internal reject(reason)
        IfCondition EqualTo(save_hid, JSNativeID.PROMISE_INT_REJECT) ThenBlock: {
            r_val = JSRT_Undefined()
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                r_val = Dereference(save_args)
            }
            JSRT_ObjSet(save_pr, "__state__", JSRT_CreateNumber(2))
            JSRT_ObjSet(save_pr, "__value__", r_val)
            ReturnValue(JSRT_Undefined())
        }

        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// PROMISE HELPER — create a promise object with given state and value
// =============================================================================
Function.JSBridge__CreatePromise {
    Input: state: Integer
    Input: value: Address
    Output: Address
    Body: {
        save_state = state
        save_value = value
        p = JSRT_CreateObject()
        JSRT_ObjSet(p, "__class__", JSRT_CreateString("Promise"))
        JSRT_ObjSet(p, "__state__", JSRT_CreateNumber(save_state))
        JSRT_ObjSet(p, "__value__", save_value)
        p_then = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
        JSRT_FuncSetEnv(p_then, p)
        JSRT_ObjSet(p, "then", p_then)
        p_catch = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
        JSRT_FuncSetEnv(p_catch, p)
        JSRT_ObjSet(p, "catch", p_catch)
        ReturnValue(p)
    }
}

// =============================================================================
// NATIVE: console.log — coerce all args to string, print each
// =============================================================================
Function.JSBridge__NConsoleLog {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        ai = 0
        WhileLoop LessThan(ai, save_argc) {
            arg_addr = Add(save_args, Multiply(ai, 8))
            arg_val = Dereference(arg_addr)

            // Convert to string for printing
            JSBridge__Push(save_args)
            JSBridge__Push(save_argc)
            JSBridge__Push(ai)
            str_val = JSRT_ToString(arg_val)
            ai = JSBridge__Pop()
            save_argc = JSBridge__Pop()
            save_args = JSBridge__Pop()

            // Get the string payload and print it
            str_ptr = JSRT_GetPayload(str_val)
            IfCondition NotEqual(str_ptr, 0) ThenBlock: {
                IfCondition GreaterThan(ai, 0) ThenBlock: {
                    PrintMessage(" ")
                }
                PrintMessage(str_ptr)
            }
            ai = Add(ai, 1)
        }
        PrintMessage("\n")
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// NATIVE: document.getElementById — find DOM node by id, return wrapped
// =============================================================================
Function.JSBridge__NGetById {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Get first arg (should be string)
        arg0 = Dereference(save_args)
        arg0_type = JSRT_GetType(arg0)
        IfCondition NotEqual(arg0_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Extract string pointer
        id_str = JSRT_GetPayload(arg0)
        IfCondition EqualTo(id_str, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Search DOM tree
        found = DOM_FindById(JSBridgeState.dom_root, id_str)
        IfCondition LessThan(found, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // Wrap the DOM node as a JS object
        ReturnValue(JSBridge_WrapNode(found))
    }
}

// =============================================================================
// NATIVE: document.querySelector — simplified v1 (tag name only)
// =============================================================================
Function.JSBridge__NQuerySel {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        arg0 = Dereference(save_args)
        arg0_type = JSRT_GetType(arg0)
        IfCondition NotEqual(arg0_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        sel_str = JSRT_GetPayload(arg0)
        IfCondition EqualTo(sel_str, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        // v1: treat selector as tag name
        found = DOM_FindByTag(JSBridgeState.dom_root, sel_str)
        IfCondition LessThan(found, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        ReturnValue(JSBridge_WrapNode(found))
    }
}

// =============================================================================
// NATIVE: element.getAttribute — get DOM attribute value as JS string
// args[0] = element wrapper object, args[1] = attribute name string
// Note: in practice, the element is the `this` object. For v1, we accept
// args[0] as the attribute name and determine element from the wrapper
// that was used to look up this function. Since JSVM does not pass `this`,
// we use a fallback: if args[0] is a string, treat it as attr name and
// try to find the element from the wrapper cache by scanning for the last
// accessed wrapper. This is a v1 simplification.
// =============================================================================
Function.JSBridge__NGetAttr {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // args[0] = element wrapper, args[1] = attr name
        elem_val = Dereference(save_args)
        JSBridge__Push(save_args)
        JSBridge__Push(save_argc)
        dom_idx = JSBridge__GetDomIdx(elem_val)
        save_argc = JSBridge__Pop()
        save_args = JSBridge__Pop()

        IfCondition LessThan(dom_idx, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Get attribute name string
        name_addr = Add(save_args, 8)
        name_val = Dereference(name_addr)
        name_type = JSRT_GetType(name_val)
        IfCondition NotEqual(name_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        name_str = JSRT_GetPayload(name_val)
        IfCondition EqualTo(name_str, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Look up attribute in DOM
        JSBridge__Push(dom_idx)
        attr_val = DOM_GetAttr(dom_idx, name_str)
        dom_idx = JSBridge__Pop()
        IfCondition EqualTo(attr_val, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }

        ReturnValue(JSRT_CreateString(attr_val))
    }
}

// =============================================================================
// NATIVE: element.addEventListener — register event listener
// args[0] = element wrapper, args[1] = event name, args[2] = callback
// =============================================================================
Function.JSBridge__NAddListener {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 3) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // args[0] = element wrapper
        elem_val = Dereference(save_args)
        JSBridge__Push(save_args)
        JSBridge__Push(save_argc)
        dom_idx = JSBridge__GetDomIdx(elem_val)
        save_argc = JSBridge__Pop()
        save_args = JSBridge__Pop()

        IfCondition LessThan(dom_idx, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // args[1] = event name string
        name_addr = Add(save_args, 8)
        name_val = Dereference(name_addr)
        name_str = JSRT_GetPayload(name_val)

        // args[2] = callback function
        cb_addr = Add(save_args, 16)
        cb_val = Dereference(cb_addr)

        // Register the listener
        JSBridge_AddListener(dom_idx, name_str, cb_val)

        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// NATIVE: element.innerHTML get — return inner text as JS string
// args[0] = element wrapper object
// =============================================================================
Function.JSBridge__NInnerHTMLGet {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }

        elem_val = Dereference(save_args)
        JSBridge__Push(save_args)
        dom_idx = JSBridge__GetDomIdx(elem_val)
        save_args = JSBridge__Pop()

        IfCondition LessThan(dom_idx, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }

        text_ptr = JSBridge__GetNodeText(dom_idx)
        IfCondition EqualTo(text_ptr, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString(""))
        }

        ReturnValue(JSRT_CreateString(text_ptr))
    }
}

// =============================================================================
// NATIVE: setTimeout — register one-shot timer
// args[0] = callback function, args[1] = delay in ms
// Returns timer ID as number
// =============================================================================
Function.JSBridge__NSetTimeout {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        // args[0] = callback
        cb_val = Dereference(save_args)

        // args[1] = delay
        delay_addr = Add(save_args, 8)
        delay_val = Dereference(delay_addr)
        JSBridge__Push(cb_val)
        delay_ms = JSRT_ToNumber(delay_val)
        cb_val = JSBridge__Pop()

        // Register one-shot timer (is_interval=0)
        timer_id = JSRT_TimerAdd(cb_val, delay_ms, 0)
        ReturnValue(JSRT_CreateNumber(timer_id))
    }
}

// =============================================================================
// NATIVE: setInterval — register repeating timer
// args[0] = callback function, args[1] = interval in ms
// Returns timer ID as number
// =============================================================================
Function.JSBridge__NSetInterval {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        cb_val = Dereference(save_args)
        delay_addr = Add(save_args, 8)
        delay_val = Dereference(delay_addr)
        JSBridge__Push(cb_val)
        delay_ms = JSRT_ToNumber(delay_val)
        cb_val = JSBridge__Pop()

        // Register interval timer (is_interval=1)
        timer_id = JSRT_TimerAdd(cb_val, delay_ms, 1)
        ReturnValue(JSRT_CreateNumber(timer_id))
    }
}

// =============================================================================
// NATIVE: clearTimeout / clearInterval — remove timer by ID
// args[0] = timer ID number
// =============================================================================
Function.JSBridge__NClearTimeout {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        id_val = Dereference(save_args)
        timer_id = JSRT_ToNumber(id_val)
        JSRT_TimerRemove(timer_id)
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// NATIVE: parseInt — string to integer
// args[0] = string value
// =============================================================================
Function.JSBridge__NParseInt {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        arg0 = Dereference(save_args)
        arg0_type = JSRT_GetType(arg0)
        IfCondition EqualTo(arg0_type, JSType.NUMBER) ThenBlock: {
            // Already a number — return identity
            ReturnValue(arg0)
        }
        IfCondition NotEqual(arg0_type, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        str_ptr = JSRT_GetPayload(arg0)
        IfCondition EqualTo(str_ptr, 0) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }

        result = StringToInt(str_ptr)
        ReturnValue(JSRT_CreateNumber(result))
    }
}

// =============================================================================
// EVENT LISTENER MANAGEMENT
// Listener pool entries (24 bytes each):
//   Offset 0:  dom_node (8) — DOM node index
//   Offset 8:  event_name_ptr (8) — pointer to event name string
//   Offset 16: callback_jsval (8) — JSValue pointer to callback function
// =============================================================================

// Add an event listener. Returns 1 on success, 0 on pool full.
Function.JSBridge_AddListener {
    Input: dom_node: Integer
    Input: event_name: Address
    Input: callback: Address
    Output: Integer
    Body: {
        save_node = dom_node
        save_name = event_name
        save_cb = callback
        IfCondition GreaterEqual(JSBridgeState.listener_count, JSBridgeConst.MAX_LISTENERS) ThenBlock: {
            PrintMessage("[JSBridge] listener pool full\n")
            ReturnValue(0)
        }

        idx = JSBridgeState.listener_count
        JSBridgeState.listener_count = Add(idx, 1)
        base = Add(JSBridgeState.listeners, Multiply(idx, JSBridgeConst.LISTENER_SIZE))
        StoreValue(base, save_node)
        StoreValue(Add(base, 8), save_name)
        StoreValue(Add(base, 16), save_cb)
        ReturnValue(1)
    }
}

// =============================================================================
// FIRE EVENT — invoke all listeners matching dom_node + event_name
// Returns number of callbacks invoked.
// NOTE: Actually invoking callbacks requires running them through JSVM.
// For v1, this function finds matching listeners and returns the count.
// A future version will call JSVM to execute each callback.
// =============================================================================
Function.JSBridge_FireEvent {
    Input: dom_node: Integer
    Input: event_name: Address
    Output: Integer
    Body: {
        save_node = dom_node
        save_name = event_name
        fired = 0
        li = 0

        WhileLoop LessThan(li, JSBridgeState.listener_count) {
            base = Add(JSBridgeState.listeners, Multiply(li, JSBridgeConst.LISTENER_SIZE))
            entry_node = Dereference(base)
            IfCondition EqualTo(entry_node, save_node) ThenBlock: {
                entry_name = Dereference(Add(base, 8))
                IfCondition NotEqual(entry_name, 0) ThenBlock: {
                    JSBridge__Push(save_node)
                    JSBridge__Push(save_name)
                    JSBridge__Push(li)
                    JSBridge__Push(fired)
                    JSBridge__Push(base)
                    cmp = StringCompare(entry_name, save_name)
                    base = JSBridge__Pop()
                    fired = JSBridge__Pop()
                    li = JSBridge__Pop()
                    save_name = JSBridge__Pop()
                    save_node = JSBridge__Pop()

                    IfCondition EqualTo(cmp, 0) ThenBlock: {
                        // Match found — get callback
                        cb = Dereference(Add(base, 16))
                        IfCondition NotEqual(cb, 0) ThenBlock: {
                            // For v1: count the match. Full impl would call JSVM.
                            fired = Add(fired, 1)
                        }
                    }
                }
            }
            li = Add(li, 1)
        }
        ReturnValue(fired)
    }
}

// =============================================================================
// TIMER TICK — forward to JSRT_TimerTick
// Returns count of expired timers.
// =============================================================================
Function.JSBridge_TickTimers {
    Input: current_ms: Integer
    Output: Integer
    Body: {
        save_ms = current_ms
        ReturnValue(JSRT_TimerTick(save_ms))
    }
}

// =============================================================================
// STATE QUERY — public accessors
// =============================================================================
Function.JSBridge_GetListenerCount {
    Output: Integer
    Body: {
        ReturnValue(JSBridgeState.listener_count)
    }
}

Function.JSBridge_GetWrapCount {
    Output: Integer
    Body: {
        ReturnValue(JSBridgeState.wrap_count)
    }
}

Function.JSBridge_GetDocObj {
    Output: Address
    Body: {
        ReturnValue(JSBridgeState.document_obj)
    }
}

Function.JSBridge_GetConsoleObj {
    Output: Address
    Body: {
        ReturnValue(JSBridgeState.console_obj)
    }
}

Function.JSBridge_GetMathObj {
    Output: Address
    Body: {
        ReturnValue(JSBridgeState.math_obj)
    }
}

Function.JSBridge_IsInitialized {
    Output: Integer
    Body: {
        ReturnValue(JSBridgeState.initialized)
    }
}

// =============================================================================
// GET LISTENER CALLBACK — retrieve callback JSValue for a listener by index
// Used by the engine to invoke callbacks via JSVM.
// =============================================================================
Function.JSBridge_GetListenerCB {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(save_idx, JSBridgeState.listener_count) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSBridgeState.listeners, Multiply(save_idx, JSBridgeConst.LISTENER_SIZE))
        ReturnValue(Dereference(Add(base, 16)))
    }
}

// =============================================================================
// GET LISTENER NODE — retrieve the DOM node index for a listener by index
// =============================================================================
Function.JSBridge_GetListenerNode {
    Input: idx: Integer
    Output: Integer
    Body: {
        save_idx = idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterEqual(save_idx, JSBridgeState.listener_count) ThenBlock: {
            ReturnValue(-1)
        }
        base = Add(JSBridgeState.listeners, Multiply(save_idx, JSBridgeConst.LISTENER_SIZE))
        ReturnValue(Dereference(base))
    }
}

// =============================================================================
// GET LISTENER EVENT NAME — retrieve event name ptr for a listener by index
// =============================================================================
Function.JSBridge_GetListenerName {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(save_idx, JSBridgeState.listener_count) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSBridgeState.listeners, Multiply(save_idx, JSBridgeConst.LISTENER_SIZE))
        ReturnValue(Dereference(Add(base, 8)))
    }
}

// =============================================================================
// DEBUG — dump bridge state
// =============================================================================
Function.JSBridge_Dump {
    Body: {
        PrintMessage("\n--- JSBridge State ---\n")
        PrintMessage("  initialized: ")
        PrintNumber(JSBridgeState.initialized)
        PrintMessage("\n  dom_root: ")
        PrintNumber(JSBridgeState.dom_root)
        PrintMessage("\n  wrap_count: ")
        PrintNumber(JSBridgeState.wrap_count)
        PrintMessage("\n  listener_count: ")
        PrintNumber(JSBridgeState.listener_count)
        PrintMessage("\n  stack sp: ")
        PrintNumber(JSBridgeStack.sp)
        PrintMessage("\n--- End JSBridge ---\n\n")
    }
}
