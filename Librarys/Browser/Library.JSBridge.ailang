        names = JSBridge__NGetOwnPropNames(args, argc)
        target = JSBridge__Pop()
        out = JSRT_CreateObject()
        nlen = JSRT_ArrLen(names)
        ni = 0
        WhileLoop LessThan(ni, nlen) {
            JSBridge__Push(target)
            JSBridge__Push(names)
            JSBridge__Push(out)
            JSBridge__Push(ni)
            ksv = JSRT_ArrGet(names, ni)
            ni = JSBridge__Pop()
            out = JSBridge__Pop()
            names = JSBridge__Pop()
            target = JSBridge__Pop()
            // gOPD(target, key)
            ab = JSVMCallBuf.buf
            StoreValue(ab, target)
            StoreValue(Add(ab, 8), ksv)
            JSBridge__Push(target)
            JSBridge__Push(names)
            JSBridge__Push(out)
            JSBridge__Push(ni)
            JSBridge__Push(ksv)
            desc = JSBridge__NGetOwnPropDesc(ab, 2)
            ksv = JSBridge__Pop()
            ni = JSBridge__Pop()
            out = JSBridge__Pop()
            names = JSBridge__Pop()
            target = JSBridge__Pop()
            IfCondition NotEqual(JSRT_GetType(desc), JSType.UNDEFINED) ThenBlock: {
                kp = JSRT_GetPayload(ksv)
                JSBridge__Push(target)
                JSBridge__Push(names)
                JSBridge__Push(out)
                JSBridge__Push(ni)
                JSRT_ObjSet(out, kp, desc)
                ni = JSBridge__Pop()
                out = JSBridge__Pop()
                names = JSBridge__Pop()
                target = JSBridge__Pop()
            }
            ni = Add(ni, 1)
        }
        ReturnValue(out)
    }
}

// Object.getOwnPropertyNames(obj) — M27c: own keys including non-enumerable
Function.JSBridge__NGetOwnPropNames {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        target = Dereference(args)
        tt = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.getOwnPropertyNames called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // ToObject-ish: primitives → empty or string exotic
        IfCondition EqualTo(tt, JSType.STRING) ThenBlock: {
            // indices + length (M31a code-unit length)
            sp = JSRT_GetPayload(target)
            slen = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { slen = JSRT_StrLen(sp) }
            result = JSRT_CreateArray()
            ai = 0
            WhileLoop LessThan(ai, slen) {
                istr = JSRT__IntToStr(ai)
                JSRT_ArrPush(result, JSRT_CreateString(istr))
                ai = Add(ai, 1)
            }
            JSRT_ArrPush(result, JSRT_CreateString("length"))
            ReturnValue(result)
        }
        IfCondition And(NotEqual(tt, JSType.OBJECT), NotEqual(tt, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(tt, JSType.ARRAY) ThenBlock: {
                // number/boolean box: empty own names
                ReturnValue(JSRT_CreateArray())
            }
        }
        ReturnValue(JSRT_ObjOwnNames(target))
    }
}

// Object.create(proto [, properties]) — M27b: +Properties via defineProperties
Function.JSBridge__NObjCreate {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateObject())
        }
        proto = Dereference(save_args)
        // ES: Type(O) must be Object or Null
        pt = JSRT_GetType(proto)
        IfCondition NotEqual(pt, JSType.NULL) ThenBlock: {
            IfCondition And(NotEqual(pt, JSType.OBJECT), NotEqual(pt, JSType.FUNCTION)) ThenBlock: {
                IfCondition NotEqual(pt, JSType.ARRAY) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Object prototype may only be an Object or null")
                    JSVM__SetGlobal("__pend_exc__", terr)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr
                    JSVM_ThrowValue(terr)
                    ReturnValue(JSRT_Undefined())
                }
            }
        }
        JSBridge__Push(proto)
        JSBridge__Push(save_args)
        JSBridge__Push(save_argc)
        obj = JSRT_CreateObject()
        save_argc = JSBridge__Pop()
        save_args = JSBridge__Pop()
        proto = JSBridge__Pop()
        pt = JSRT_GetType(proto)
        // null → null prototype; object/function/array → link
        IfCondition EqualTo(pt, JSType.NULL) ThenBlock: {
            JSRT_ObjSet(obj, "__proto__", JSRTState.null_val)
        }
        IfCondition Or(Or(EqualTo(pt, JSType.OBJECT), EqualTo(pt, JSType.FUNCTION)), EqualTo(pt, JSType.ARRAY)) ThenBlock: {
            JSRT_ObjSet(obj, "__proto__", proto)
        }
        // Optional Properties bag → Object.defineProperties(obj, Properties)
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            props = Dereference(Add(save_args, 8))
            ptype = JSRT_GetType(props)
            // undefined/missing Properties: skip (only one arg used)
            IfCondition And(NotEqual(ptype, JSType.UNDEFINED), NotEqual(props, 0)) ThenBlock: {
                ab = JSVMCallBuf.buf
                StoreValue(ab, obj)
                StoreValue(Add(ab, 8), props)
                JSBridge__Push(obj)
                JSBridge__NDefineProperties(ab, 2)
                obj = JSBridge__Pop()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
            }
        }
        ReturnValue(obj)
    }
}

// Function.prototype.call(thisArg, ...args)
Function.JSBridge__NFuncCall {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        target = JSVM_GetGlobal("this")
        IfCondition NotEqual(JSRT_GetType(target), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        this_arg = JSRT_Undefined()
        call_argc = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            this_arg = Dereference(save_args)
            call_argc = Subtract(save_argc, 1)
        }
        // Build arg buffer: skip thisArg. Use getter_buf as scratch — cannot
        // MemoryCopy overlapping regions of CallBuf.buf (thisArg at [0]).
        ab = JSVMCallBuf.buf
        IfCondition GreaterThan(call_argc, 0) ThenBlock: {
            tmp_ab = JSVMCallBuf.getter_buf
            MemoryCopy(tmp_ab, Add(save_args, 8), Multiply(call_argc, 8))
            MemoryCopy(ab, tmp_ab, Multiply(call_argc, 8))
        }
        JSVM__SetGlobal("this", this_arg)
        // M29d/k.11: stamp env for native methods (FuncGetEnv = thisArg).
        // Do NOT overwrite JS closure env (descriptor+40) — breaks free vars
        // and interferes with private brand home resolution for .call/.apply.
        fenv = JSRT_FuncGetEnv(target)
        fbc = JSRT_FuncGetBC(target)
        IfCondition Or(LessThan(fbc, 0), EqualTo(fenv, 71)) ThenBlock: {
            // native (bc < 0) or leave generators alone; natives need env stamp
            IfCondition LessThan(fbc, 0) ThenBlock: {
                JSRT_FuncSetEnv(target, this_arg)
            }
        }
        ret = JSVM__CallFunc(target, ab, call_argc)
        ReturnValue(ret)
    }
}

// Function.prototype.apply(thisArg, argArray)
Function.JSBridge__NFuncApply {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        target = JSVM_GetGlobal("this")
        IfCondition NotEqual(JSRT_GetType(target), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        this_arg = JSRT_Undefined()
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            this_arg = Dereference(save_args)
        }
        call_argc = 0
        ab = JSVMCallBuf.buf
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            arr = Dereference(Add(save_args, 8))
            IfCondition EqualTo(JSRT_GetType(arr), JSType.ARRAY) ThenBlock: {
                call_argc = JSRT_ArrLen(arr)
                IfCondition GreaterThan(call_argc, 64) ThenBlock: { call_argc = 64 }
                ai = 0
                WhileLoop LessThan(ai, call_argc) {
                    StoreValue(Add(ab, Multiply(ai, 8)), JSRT_ArrGet(arr, ai))
                    ai = Add(ai, 1)
                }
            }
        }
        JSVM__SetGlobal("this", this_arg)
        // M29d/k.11: only stamp env for natives (see NFuncCall)
        fbc2 = JSRT_FuncGetBC(target)
        IfCondition LessThan(fbc2, 0) ThenBlock: {
            JSRT_FuncSetEnv(target, this_arg)
        }
        ret = JSVM__CallFunc(target, ab, call_argc)
        ReturnValue(ret)
    }
}

// Function.prototype.bind(thisArg, ...partialArgs)
Function.JSBridge__NFuncBind {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        target = JSVM_GetGlobal("this")
        IfCondition NotEqual(JSRT_GetType(target), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        this_arg = JSRT_Undefined()
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            this_arg = Dereference(save_args)
        }
        // Bound state object
        // M104: push/pop must restore in reverse order (this_arg, target, rec).
        // Previous code assigned target=Pop() first and swapped target↔this_arg,
        // so __bthis__ stored the function and bound calls returned the target.
        rec = JSRT_CreateObject()
        JSBridge__Push(rec)
        JSBridge__Push(target)
        JSBridge__Push(this_arg)
        JSRT_ObjSet(rec, "__bt__", target)
        this_arg = JSBridge__Pop()
        target = JSBridge__Pop()
        rec = JSBridge__Pop()
        JSBridge__Push(rec)
        JSBridge__Push(target)
        JSRT_ObjSet(rec, "__bthis__", this_arg)
        target = JSBridge__Pop()
        rec = JSBridge__Pop()
        // Partial args array
        parr = JSRT_CreateArray()
        pi = 1
        WhileLoop LessThan(pi, save_argc) {
            JSRT_ArrPush(parr, Dereference(Add(save_args, Multiply(pi, 8))))
            pi = Add(pi, 1)
        }
        JSBridge__Push(rec)
        JSBridge__Push(target)
        JSRT_ObjSet(rec, "__bargs__", parr)
        target = JSBridge__Pop()
        rec = JSBridge__Pop()
        // Bound function: native FUNC_BOUND, env = rec
        bf = JSBridge__CreateNativeFunc(JSNativeID.FUNC_BOUND, "bound", 0)
        JSRT_FuncSetEnv(bf, rec)
        // length = max(0, target.length - partial)
        tlen = 0
        tl_v = JSRT_ObjGet(target, "length")
        IfCondition EqualTo(JSRT_GetType(tl_v), JSType.NUMBER) ThenBlock: {
            tlen = Float_ToInt(JSRT_GetPayload(tl_v))
        }
        plen = Subtract(save_argc, 1)
        IfCondition LessThan(plen, 0) ThenBlock: { plen = 0 }
        blen = Subtract(tlen, plen)
        IfCondition LessThan(blen, 0) ThenBlock: { blen = 0 }
        fdesc = Dereference(Add(bf, 8))
        IfCondition NotEqual(fdesc, 0) ThenBlock: {
            StoreValue(Add(fdesc, 80), blen)
        }
        ReturnValue(bf)
    }
}

// Bound function invoke (FUNC_BOUND=198) — uses env as bound record
Function.JSBridge__NFuncBound {
    Input: args: Address
    Input: argc: Integer
    Output: Address
