        // ─── PROMISE_CTOR (61) — new Promise(executor) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_CTOR) ThenBlock: {
            // Create promise, call executor(resolve, reject) eagerly
            promise = JSRT_CreateObject()
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(0))
            JSRT_ObjSet(promise, "__value__", JSRT_Undefined())
            then_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(then_f, promise)
            JSRT_ObjSet(promise, "then", then_f)
            catch_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(catch_f, promise)
            JSRT_ObjSet(promise, "catch", catch_f)
            ReturnValue(promise)
        }

        // ─── OBJ_CTOR (88) — new Object() ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_CTOR) ThenBlock: {
            // new Object() returns a plain empty object
            // new Object(val) — if val is object/array, return it as-is
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                oc_arg = Dereference(save_args)
                oc_t = JSRT_GetType(oc_arg)
                IfCondition Or(EqualTo(oc_t, JSType.OBJECT), EqualTo(oc_t, JSType.ARRAY)) ThenBlock: {
                    ReturnValue(oc_arg)
                }
            }
            ReturnValue(JSRT_CreateObject())
        }

        // ─── MATH_SQRT (89) — Newton-Raphson sqrt ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_SQRT) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                // Handle 0 and negative
                sq_zero = Float_FromInt(0)
                IfCondition EqualTo(Float_Eq(nval, sq_zero), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateFloat(sq_zero))
                }
                IfCondition EqualTo(Float_Lt(nval, sq_zero), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateFloat(9221120237041090560))
                }
                // Newton-Raphson: guess = x/2, iterate 20 times
                sq_two = Float_FromInt(2)
                sq_guess = Float_Div(nval, sq_two)
                sq_i = 0
                WhileLoop LessThan(sq_i, 20) {
                    sq_guess = Float_Div(Float_Add(sq_guess, Float_Div(nval, sq_guess)), sq_two)
                    sq_i = Add(sq_i, 1)
                }
                ReturnValue(JSRT_CreateFloat(sq_guess))
            }
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }

        // ─── MATH_SIN (90) — minimax polynomial on [-π/4, π/4] with range reduction ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_SIN) ThenBlock: {
