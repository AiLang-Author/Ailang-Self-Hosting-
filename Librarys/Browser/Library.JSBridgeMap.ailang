// Saved across a user call: ptr obj val val2 addr cb_val idx.
// result / name_ptr / found / count are scratch and are NOT restored.
Function.JSBridge__MapSaveState {
    Output: Integer
    Body: {
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridge__Push(JSBridgeTmp.addr)
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.idx)
        ReturnValue(1)
    }
}

Function.JSBridge__MapLoadState {
    Output: Integer
    Body: {
        JSBridgeTmp.idx = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridge__Pop()
        JSBridgeTmp.addr = JSBridge__Pop()
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        ReturnValue(1)
    }
}

Function.JSBridge__MapThrow {
    Input: msg: Address
    Output: Address
    Body: {
        save_m = msg
        terr = JSVM_CreateTypedError("TypeError", save_m)
        JSBridgeTmp.result = terr
        JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.result)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = JSBridgeTmp.result
        JSVM_ThrowValue(JSBridgeTmp.result)
        ReturnValue(JSRTState.undef_val)
    }
}

// Copy a pending throw and clear sticky flags so a later call can run.
// SetGlobal clobbers JSBridgeTmp.ptr. Callers still hold the capability there.
Function.JSBridge__MapCapture {
    Output: Address
    Body: {
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridgeTmp.result = JSVMCall.thrown_val
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            JSBridgeTmp.result = JSVMState.exc_val
        }
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            JSBridgeTmp.result = JSVM__GetGlobal("__pend_exc__")
        }
        JSVMCall.exc_prop = 0
        JSVMCall.thrown_val = 0
        JSVMState.exc_val = 0
        JSVMState.error = 0
        JSVMState.halted = 0
        JSVMState.throw_delivered = 0
        JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
        JSBridgeTmp.ptr = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(JSBridgeTmp.result)
    }
}

// 1 if a pending throw was re-raised. 0 if the caller should continue.
Function.JSBridge__MapPropagate {
    Output: Integer
    Body: {
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(JSVMCall.exc_prop, 0) ThenBlock: {
            IfCondition EqualTo(JSVMState.error, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        err = JSBridge__MapCapture()
        JSBridgeTmp.result = err
        JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.result)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = JSBridgeTmp.result
        JSVM_ThrowValue(JSBridgeTmp.result)
        ReturnValue(1)
    }
}

Function.JSBridge__MapFreeBuf {
    Output: Integer
    Body: {
        IfCondition NotEqual(JSBridgeTmp.addr, 0) ThenBlock: {
            b = JSBridgeTmp.addr
            JSBridgeTmp.addr = 0
            Deallocate(b, 32)
        }
        ReturnValue(0)
    }
}

// -0 key becomes +0. Other keys are returned unchanged.
Function.JSBridge__MapCanonKey {
    Input: key: Address
    Output: Address
    Body: {
        JSBridgeTmp.found = key
        kt = JSRT_GetType(JSBridgeTmp.found)
        IfCondition EqualTo(kt, JSType.NUMBER) ThenBlock: {
            pa = JSRT_GetPayload(JSBridgeTmp.found)
            IfCondition EqualTo(pa, -9223372036854775808) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(0))
            }
        }
        ReturnValue(JSBridgeTmp.found)
    }
}

// Pairs array, or throw TypeError. Does not invent [[MapData]].
Function.JSBridge__MapRequirePairs {
    Input: mthis: Address
    Output: Address
    Body: {
        JSBridgeTmp.ptr = mthis
        t = JSRT_GetType(JSBridgeTmp.ptr)
        ok = 0
        IfCondition EqualTo(t, JSType.OBJECT) ThenBlock: { ok = 1 }
        IfCondition EqualTo(t, JSType.FUNCTION) ThenBlock: { ok = 1 }
        IfCondition EqualTo(t, JSType.ARRAY) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("Map method called on incompatible receiver"))
        }
        pairs = JSRT_ObjGet(JSBridgeTmp.ptr, "__pairs__")
        JSBridgeTmp.val = pairs
        pt = JSRT_GetType(JSBridgeTmp.val)
        IfCondition NotEqual(pt, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("Map method called on incompatible receiver"))
        }
        ReturnValue(JSBridgeTmp.val)
    }
}

Function.JSBridge__MapObjLike {
    Input: v: Address
    Output: Integer
    Body: {
        JSBridgeTmp.count = v
        t = JSRT_GetType(JSBridgeTmp.count)
        IfCondition EqualTo(t, JSType.OBJECT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, JSType.FUNCTION) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, JSType.ARRAY) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSBridge__MapNewObj {
    Output: Address
    Body: {
        mobj = JSRT_CreateObject()
        JSBridge__Push(mobj)
        pairs = JSRT_CreateArray()
        JSBridgeTmp.val = pairs
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        JSRT_ObjSet(JSBridgeTmp.ptr, "__pairs__", JSBridgeTmp.val)
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        cls = JSRT_CreateString("Map")
        JSBridgeTmp.val = cls
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        JSRT_ObjSet(JSBridgeTmp.ptr, "__class__", JSBridgeTmp.val)
        JSBridgeTmp.ptr = JSBridge__Pop()
        ReturnValue(JSBridgeTmp.ptr)
    }
}

// Direct [[MapData]] write. Does not call the public set method.
Function.JSBridge__MapPut {
    Input: map: Address
    Input: key: Address
    Input: val: Address
    Output: Address
    Body: {
        JSBridgeTmp.ptr = map
        JSBridgeTmp.obj = key
        JSBridgeTmp.val = val
        JSBridgeTmp.obj = JSBridge__MapCanonKey(JSBridgeTmp.obj)
        pairs = JSRT_ObjGet(JSBridgeTmp.ptr, "__pairs__")
        JSBridgeTmp.val2 = pairs
        found = JSBridge__MapFindIndex(JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            ent = JSRT_ArrGet(JSBridgeTmp.val2, found)
            JSRT_ArrSet(ent, 1, JSBridgeTmp.val)
            ReturnValue(JSBridgeTmp.val)
        }
        entn = JSRT_CreateArray()
        JSBridgeTmp.result = entn
        JSRT_ArrPush(JSBridgeTmp.result, JSBridgeTmp.obj)
        JSRT_ArrPush(JSBridgeTmp.result, JSBridgeTmp.val)
        JSRT_ArrPush(JSBridgeTmp.val2, JSBridgeTmp.result)
        ReturnValue(JSBridgeTmp.val)
    }
}

// IteratorClose. err 0 means no prior throw. A prior throw wins over return().
Function.JSBridge__MapClose {
    Input: iterator: Address
    Input: err: Address
    Output: Address
    Body: {
        JSBridgeTmp.ptr = iterator
        JSBridgeTmp.obj = err
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            IfCondition NotEqual(JSBridgeTmp.obj, 0) ThenBlock: {
                JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.obj)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = JSBridgeTmp.obj
                JSVM_ThrowValue(JSBridgeTmp.obj)
            }
            ReturnValue(JSRTState.undef_val)
        }
        JSBridge__MapSaveState()
        retm = JSVM__ObjGetAcc(JSBridgeTmp.ptr, "return")
        JSBridgeTmp.result = retm
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            cap = JSBridge__MapCapture()
            JSBridgeTmp.name_ptr = cap
            IfCondition NotEqual(JSBridgeTmp.obj, 0) ThenBlock: {
                JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.obj)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = JSBridgeTmp.obj
                JSVM_ThrowValue(JSBridgeTmp.obj)
                ReturnValue(JSRTState.undef_val)
            }
            JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.name_ptr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = JSBridgeTmp.name_ptr
            JSVM_ThrowValue(JSBridgeTmp.name_ptr)
            ReturnValue(JSRTState.undef_val)
        }
        rt = JSRT_GetType(JSBridgeTmp.result)
        IfCondition NotEqual(rt, JSType.FUNCTION) ThenBlock: {
            IfCondition NotEqual(JSBridgeTmp.obj, 0) ThenBlock: {
                JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.obj)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = JSBridgeTmp.obj
                JSVM_ThrowValue(JSBridgeTmp.obj)
            }
            ReturnValue(JSRTState.undef_val)
        }
        JSBridgeTmp.val = JSBridgeTmp.result
        JSBridge__MapSaveState()
        JSBridge__Push(JSBridgeTmp.val)
        JSVM__SetGlobal("this", JSBridgeTmp.ptr)
        JSBridgeTmp.val = JSBridge__Pop()
        rv = JSVM__CallFunc(JSBridgeTmp.val, JSVMCallBuf.buf, 0)
        JSBridgeTmp.result = rv
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            cap2 = JSBridge__MapCapture()
            JSBridgeTmp.name_ptr = cap2
            IfCondition NotEqual(JSBridgeTmp.obj, 0) ThenBlock: {
                JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.obj)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = JSBridgeTmp.obj
                JSVM_ThrowValue(JSBridgeTmp.obj)
                ReturnValue(JSRTState.undef_val)
            }
            JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.name_ptr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = JSBridgeTmp.name_ptr
            JSVM_ThrowValue(JSBridgeTmp.name_ptr)
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition NotEqual(JSBridgeTmp.obj, 0) ThenBlock: {
            JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.obj)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = JSBridgeTmp.obj
            JSVM_ThrowValue(JSBridgeTmp.obj)
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.result), 0) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("IteratorClose returned a non-object"))
        }
        ReturnValue(JSRTState.undef_val)
    }
}

// AddEntriesFromIterable. ptr is the map on entry and on success.
// Returns 1, or 0 after a throw.
Function.JSBridge__MapIngest {
    Input: map: Address
    Input: iterable: Address
    Output: Integer
    Body: {
        JSBridgeTmp.ptr = map
        JSBridgeTmp.val = iterable
        JSBridgeTmp.obj = 0
        JSBridgeTmp.val2 = 0
        JSBridgeTmp.addr = 0
        JSBridgeTmp.cb_val = 0
        JSBridgeTmp.idx = 0
        JSBridge__MapSaveState()
        adder = JSVM__ObjGetAcc(JSBridgeTmp.ptr, "set")
        JSBridgeTmp.result = adder
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.result), JSType.FUNCTION) ThenBlock: {
            JSBridge__MapThrow("Map.prototype.set is not callable")
            ReturnValue(0)
        }
        JSBridgeTmp.val2 = JSBridgeTmp.result
        ik = 0
        IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
            ik = JSVM_SymbolToKey(JSVMSymbol.iterator)
        }
        JSBridgeTmp.name_ptr = ik
        IfCondition EqualTo(JSBridgeTmp.name_ptr, 0) ThenBlock: {
            JSBridge__MapThrow("object is not iterable")
            ReturnValue(0)
        }
        JSBridge__MapSaveState()
        factory = JSVM__ObjGetAcc(JSBridgeTmp.val, JSBridgeTmp.name_ptr)
        JSBridgeTmp.result = factory
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.result), JSType.FUNCTION) ThenBlock: {
            JSBridge__MapThrow("object is not iterable")
            ReturnValue(0)
        }
        JSBridgeTmp.cb_val = JSBridgeTmp.result
        JSBridge__MapSaveState()
        JSVM__SetGlobal("this", JSBridgeTmp.val)
        it = JSVM__CallFunc(JSBridgeTmp.cb_val, JSVMCallBuf.buf, 0)
        JSBridgeTmp.result = it
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.obj = JSBridgeTmp.result
        IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.obj), 0) ThenBlock: {
            JSBridge__MapThrow("@@iterator returned a non-object")
            ReturnValue(0)
        }
        JSBridge__MapSaveState()
        nxt = JSVM__ObjGetAcc(JSBridgeTmp.obj, "next")
        JSBridgeTmp.result = nxt
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.result), JSType.FUNCTION) ThenBlock: {
            JSBridge__MapThrow("iterator.next is not a function")
            ReturnValue(0)
        }
        JSBridgeTmp.val = JSBridgeTmp.result
        buf = Allocate(32)
        JSBridgeTmp.addr = buf
        IfCondition EqualTo(JSBridgeTmp.addr, 0) ThenBlock: {
            JSBridge__MapThrow("out of memory")
            ReturnValue(0)
        }
        WhileLoop LessThan(JSBridgeTmp.idx, 1000000) {
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
            JSBridge__MapSaveState()
            JSBridge__Push(JSBridgeTmp.val)
            JSVM__SetGlobal("this", JSBridgeTmp.obj)
            JSBridgeTmp.val = JSBridge__Pop()
            res = JSVM__CallFunc(JSBridgeTmp.val, JSVMCallBuf.buf, 0)
            JSBridgeTmp.result = res
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                JSBridge__MapFreeBuf()
                JSBridge__MapPropagate()
                ReturnValue(0)
            }
            IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.result), 0) ThenBlock: {
                JSBridge__MapFreeBuf()
                JSBridge__MapThrow("iterator result is not an object")
                ReturnValue(0)
            }
            JSBridgeTmp.cb_val = JSBridgeTmp.result
            JSBridge__MapSaveState()
            donev = JSVM__ObjGetAcc(JSBridgeTmp.cb_val, "done")
            JSBridgeTmp.result = donev
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                JSBridge__MapFreeBuf()
                JSBridge__MapPropagate()
                ReturnValue(0)
            }
            IfCondition EqualTo(JSRT_IsTruthy(JSBridgeTmp.result), 1) ThenBlock: {
                JSBridge__MapFreeBuf()
                ReturnValue(1)
            }
            JSBridge__MapSaveState()
            item = JSVM__ObjGetAcc(JSBridgeTmp.cb_val, "value")
            JSBridgeTmp.result = item
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                errv = JSBridge__MapCapture()
                JSBridge__MapFreeBuf()
                JSBridge__MapClose(JSBridgeTmp.obj, errv)
                ReturnValue(0)
            }
            JSBridgeTmp.cb_val = JSBridgeTmp.result
            JSBridgeTmp.len = 0
            IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.cb_val), 0) ThenBlock: { JSBridgeTmp.len = 1 }
            IfCondition EqualTo(JSVM_IsSymbol(JSBridgeTmp.cb_val), 1) ThenBlock: { JSBridgeTmp.len = 1 }
            IfCondition EqualTo(JSBridgeTmp.len, 1) ThenBlock: {
                JSBridge__MapFreeBuf()
                terr = JSVM_CreateTypedError("TypeError", "iterator value is not an entry object")
                JSBridge__MapClose(JSBridgeTmp.obj, terr)
                ReturnValue(0)
            }
            JSBridge__MapSaveState()
            k = JSVM__ObjGetAcc(JSBridgeTmp.cb_val, "0")
            JSBridgeTmp.result = k
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                errk = JSBridge__MapCapture()
                JSBridge__MapFreeBuf()
                JSBridge__MapClose(JSBridgeTmp.obj, errk)
                ReturnValue(0)
            }
            JSBridgeTmp.name_ptr = JSBridgeTmp.result
            JSBridge__MapSaveState()
            v = JSVM__ObjGetAcc(JSBridgeTmp.cb_val, "1")
            JSBridgeTmp.result = v
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                errv2 = JSBridge__MapCapture()
                JSBridge__MapFreeBuf()
                JSBridge__MapClose(JSBridgeTmp.obj, errv2)
                ReturnValue(0)
            }
            StoreValue(JSBridgeTmp.addr, JSBridgeTmp.name_ptr)
            StoreValue(Add(JSBridgeTmp.addr, 8), JSBridgeTmp.result)
            JSBridge__MapSaveState()
            JSVM__SetGlobal("this", JSBridgeTmp.ptr)
            callr = JSVM__CallFunc(JSBridgeTmp.val2, JSBridgeTmp.addr, 2)
            JSBridgeTmp.result = callr
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                erra = JSBridge__MapCapture()
                JSBridge__MapFreeBuf()
                JSBridge__MapClose(JSBridgeTmp.obj, erra)
                ReturnValue(0)
            }
        }
        JSBridge__MapFreeBuf()
        JSBridge__MapThrow("Map iterable exceeded iteration limit")
        ReturnValue(0)
    }
}

Function.JSBridge__MapConstruct {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        JSBridgeTmp.name_ptr = save_args
        JSBridgeTmp.idx = save_argc
        nt = JSVM__GetGlobal("__new_target__")
        ntt = JSRT_GetType(nt)
        IfCondition Or(EqualTo(nt, 0), EqualTo(ntt, JSType.UNDEFINED)) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("Map constructor requires new"))
        }
        mobj = JSBridge__MapNewObj()
        JSBridgeTmp.ptr = mobj
        JSBridgeTmp.obj = 0
        JSBridgeTmp.val = 0
        JSBridgeTmp.val2 = 0
        JSBridgeTmp.addr = 0
        JSBridgeTmp.cb_val = 0
        nt2 = JSVM__GetGlobal("__new_target__")
        JSBridgeTmp.obj = nt2
        ntt2 = JSRT_GetType(JSBridgeTmp.obj)
        IfCondition EqualTo(ntt2, JSType.FUNCTION) ThenBlock: {
            JSBridge__MapSaveState()
            proto = JSVM__ObjGetAcc(JSBridgeTmp.obj, "prototype")
            JSBridgeTmp.result = proto
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.result), 1) ThenBlock: {
                JSBridgeTmp.obj = JSBridgeTmp.result
            } ElseBlock: {
                JSBridgeTmp.obj = 0
            }
        } ElseBlock: {
            JSBridgeTmp.obj = 0
        }
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            mc = JSVM__GetGlobal("Map")
            JSBridgeTmp.val = mc
            proto2 = JSRT_ObjGet(JSBridgeTmp.val, "prototype")
            JSBridgeTmp.obj = proto2
        }
        IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.obj), 1) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.ptr)
            JSRT_ObjSet(JSBridgeTmp.ptr, "__proto__", JSBridgeTmp.obj)
            JSBridgeTmp.ptr = JSBridge__Pop()
        }
        IfCondition LessThan(JSBridgeTmp.idx, 1) ThenBlock: {
            ReturnValue(JSBridgeTmp.ptr)
        }
        JSBridgeTmp.cb_val = Dereference(JSBridgeTmp.name_ptr)
        itb_t = JSRT_GetType(JSBridgeTmp.cb_val)
        IfCondition Or(EqualTo(itb_t, JSType.UNDEFINED), EqualTo(itb_t, JSType.NULL)) ThenBlock: {
            ReturnValue(JSBridgeTmp.ptr)
        }
        ok = JSBridge__MapIngest(JSBridgeTmp.ptr, JSBridgeTmp.cb_val)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(JSBridgeTmp.ptr)
    }
}

// Walk @@iterator into a fresh array. Throws if items is not iterable.
Function.JSBridge__ReadIterable {
    Input: src: Address
    Output: Address
    Body: {
        JSBridgeTmp.ptr = src
        JSBridgeTmp.obj = 0
        JSBridgeTmp.val = 0
        JSBridgeTmp.val2 = 0
        JSBridgeTmp.addr = 0
        JSBridgeTmp.cb_val = 0
        JSBridgeTmp.idx = 0
        st = JSRT_GetType(JSBridgeTmp.ptr)
        JSBridgeTmp.len = st
        IfCondition Or(EqualTo(JSBridgeTmp.len, JSType.UNDEFINED), EqualTo(JSBridgeTmp.len, JSType.NULL)) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("object is not iterable"))
        }
        // ObjGetAcc ignores string primitives. Take @@iterator from
        // String.prototype and call it with the primitive as this.
        JSBridgeTmp.count = 0
        IfCondition EqualTo(JSBridgeTmp.len, JSType.STRING) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.ptr)
            JSBridgeTmp.name_ptr = 0
            IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
                iks = JSVM_SymbolToKey(JSVMSymbol.iterator)
                JSBridgeTmp.name_ptr = iks
            }
            JSBridgeTmp.ptr = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.ptr)
            JSBridge__Push(JSBridgeTmp.name_ptr)
            sc = JSVM__GetGlobal("String")
            JSBridgeTmp.result = sc
            JSBridgeTmp.name_ptr = JSBridge__Pop()
            JSBridgeTmp.ptr = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.ptr)
            JSBridge__Push(JSBridgeTmp.name_ptr)
            JSBridge__Push(JSBridgeTmp.result)
            sp = JSRT_ObjGet(JSBridgeTmp.result, "prototype")
            JSBridgeTmp.obj = sp
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.name_ptr = JSBridge__Pop()
            JSBridgeTmp.ptr = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.ptr)
            JSBridge__Push(JSBridgeTmp.name_ptr)
            fac = JSRT_ObjGet(JSBridgeTmp.obj, JSBridgeTmp.name_ptr)
            JSBridgeTmp.cb_val = fac
            JSBridgeTmp.name_ptr = JSBridge__Pop()
            JSBridgeTmp.ptr = JSBridge__Pop()
            JSBridgeTmp.count = 1
            JSBridgeTmp.obj = 0
        }
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ik = 0
            IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
                ik = JSVM_SymbolToKey(JSVMSymbol.iterator)
                JSBridgeTmp.name_ptr = ik
            }
            IfCondition EqualTo(JSBridgeTmp.name_ptr, 0) ThenBlock: {
                ReturnValue(JSBridge__MapThrow("object is not iterable"))
            }
            JSBridge__MapSaveState()
            factory = JSVM__ObjGetAcc(JSBridgeTmp.ptr, JSBridgeTmp.name_ptr)
            JSBridgeTmp.result = factory
            JSBridge__MapLoadState()
        } ElseBlock: {
            JSBridgeTmp.result = JSBridgeTmp.cb_val
        }
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.result), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("object is not iterable"))
        }
        JSBridgeTmp.cb_val = JSBridgeTmp.result
        JSBridge__MapSaveState()
        JSVM__SetGlobal("this", JSBridgeTmp.ptr)
        it = JSVM__CallFunc(JSBridgeTmp.cb_val, JSVMCallBuf.buf, 0)
        JSBridgeTmp.result = it
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSBridgeTmp.obj = JSBridgeTmp.result
        IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("@@iterator returned a non-object"))
        }
        JSBridge__MapSaveState()
        nxt = JSVM__ObjGetAcc(JSBridgeTmp.obj, "next")
        JSBridgeTmp.result = nxt
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.result), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("iterator.next is not a function"))
        }
        JSBridgeTmp.val = JSBridgeTmp.result
        out = JSRT_CreateArray()
        JSBridgeTmp.val2 = out
        WhileLoop LessThan(JSBridgeTmp.idx, 1000000) {
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
            JSBridge__MapSaveState()
            JSBridge__Push(JSBridgeTmp.val)
            JSVM__SetGlobal("this", JSBridgeTmp.obj)
            JSBridgeTmp.val = JSBridge__Pop()
            res = JSVM__CallFunc(JSBridgeTmp.val, JSVMCallBuf.buf, 0)
            JSBridgeTmp.result = res
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.result), 0) ThenBlock: {
                ReturnValue(JSBridge__MapThrow("iterator result is not an object"))
            }
            JSBridgeTmp.cb_val = JSBridgeTmp.result
            JSBridge__MapSaveState()
            donev = JSVM__ObjGetAcc(JSBridgeTmp.cb_val, "done")
            JSBridgeTmp.result = donev
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            IfCondition EqualTo(JSRT_IsTruthy(JSBridgeTmp.result), 1) ThenBlock: {
                ReturnValue(JSBridgeTmp.val2)
            }
            JSBridge__MapSaveState()
            vv = JSVM__ObjGetAcc(JSBridgeTmp.cb_val, "value")
            JSBridgeTmp.result = vv
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            JSRT_ArrPush(JSBridgeTmp.val2, JSBridgeTmp.result)
        }
        ReturnValue(JSBridge__MapThrow("iterator too long"))
    }
}

Function.JSBridge__DMAP_GET_SIZE {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.ptr = JSVM__GetGlobal("this")
        JSBridgeTmp.val = JSBridge__MapRequirePairs(JSBridgeTmp.ptr)
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        i = 0
        n = JSRT_ArrLen(JSBridgeTmp.val)
        c = 0
        WhileLoop LessThan(i, n) {
            ent = JSRT_ArrGet(JSBridgeTmp.val, i)
            IfCondition EqualTo(JSRT_GetType(ent), JSType.ARRAY) ThenBlock: {
                c = Add(c, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(JSRT_CreateNumber(c))
    }
}

Function.JSBridge__DMAP_FOREACH {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.ptr = JSVM__GetGlobal("this")
        JSBridgeTmp.obj = JSBridge__MapRequirePairs(JSBridgeTmp.ptr)
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("Map.prototype.forEach callback is not a function"))
        }
        cb = Dereference(save_args)
        IfCondition NotEqual(JSRT_GetType(cb), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("Map.prototype.forEach callback is not a function"))
        }
        JSBridgeTmp.val = cb
        JSBridgeTmp.val2 = JSRTState.undef_val
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            JSBridgeTmp.val2 = Dereference(Add(save_args, 8))
        }
        buf = Allocate(32)
        JSBridgeTmp.addr = buf
        JSBridgeTmp.idx = 0
        JSBridgeTmp.cb_val = 0
        WhileLoop LessThan(JSBridgeTmp.idx, 1000000) {
            n = JSRT_ArrLen(JSBridgeTmp.obj)
            IfCondition GreaterEqual(JSBridgeTmp.idx, n) ThenBlock: {
                JSBridgeTmp.idx = 1000000
            } ElseBlock: {
                ent = JSRT_ArrGet(JSBridgeTmp.obj, JSBridgeTmp.idx)
                JSBridgeTmp.cb_val = ent
                JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
                IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.cb_val), JSType.ARRAY) ThenBlock: {
                    k = JSRT_ArrGet(JSBridgeTmp.cb_val, 0)
                    JSBridgeTmp.name_ptr = k
                    v = JSRT_ArrGet(JSBridgeTmp.cb_val, 1)
                    JSBridgeTmp.result = v
                    StoreValue(JSBridgeTmp.addr, JSBridgeTmp.result)
                    StoreValue(Add(JSBridgeTmp.addr, 8), JSBridgeTmp.name_ptr)
                    StoreValue(Add(JSBridgeTmp.addr, 16), JSBridgeTmp.ptr)
                    JSBridge__MapSaveState()
                    JSBridge__Push(JSBridgeTmp.val)
                    JSVM__SetGlobal("this", JSBridgeTmp.val2)
                    JSBridgeTmp.val = JSBridge__Pop()
                    cr = JSVM__CallFunc(JSBridgeTmp.val, JSBridgeTmp.addr, 3)
                    JSBridgeTmp.result = cr
                    JSBridge__MapLoadState()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        JSBridge__MapFreeBuf()
                        JSBridge__MapPropagate()
                        ReturnValue(JSRTState.undef_val)
                    }
                }
            }
        }
        JSBridge__MapFreeBuf()
        ReturnValue(JSRTState.undef_val)
    }
}

Function.JSBridge__DMAP_GET_OR_INSERT {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.ptr = JSVM__GetGlobal("this")
        JSBridgeTmp.val2 = JSBridge__MapRequirePairs(JSBridgeTmp.ptr)
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSBridgeTmp.obj = JSRTState.undef_val
        JSBridgeTmp.val = JSRTState.undef_val
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            JSBridgeTmp.obj = Dereference(save_args)
        }
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            JSBridgeTmp.val = Dereference(Add(save_args, 8))
        }
        JSBridgeTmp.obj = JSBridge__MapCanonKey(JSBridgeTmp.obj)
        found = JSBridge__MapFindIndex(JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            ent = JSRT_ArrGet(JSBridgeTmp.val2, found)
            JSBridgeTmp.result = ent
            ReturnValue(JSRT_ArrGet(JSBridgeTmp.result, 1))
        }
        ReturnValue(JSBridge__MapPut(JSBridgeTmp.ptr, JSBridgeTmp.obj, JSBridgeTmp.val))
    }
}

Function.JSBridge__DMAP_GET_OR_INSERT_COMPUTED {
