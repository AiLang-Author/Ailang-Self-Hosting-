        JSBridge__MapSaveState()
        JSBridge__Push(JSBridgeTmp.val)
        JSVM__SetGlobal("this", JSRTState.undef_val)
        JSBridgeTmp.val = JSBridge__Pop()
        cr = JSVM__CallFunc(JSBridgeTmp.val, JSBridgeTmp.addr, 1)
        JSBridgeTmp.result = cr
        JSBridge__MapLoadState()
        JSBridge__MapFreeBuf()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(JSBridge__MapPut(JSBridgeTmp.ptr, JSBridgeTmp.obj, JSBridgeTmp.result))
    }
}

Function.JSBridge__DMAP_GROUP_BY {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("Map.groupBy requires a callback"))
        }
        items = Dereference(save_args)
        JSBridgeTmp.obj = items
        cb = Dereference(Add(save_args, 8))
        JSBridgeTmp.val = cb
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.val), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("Map.groupBy callback is not a function"))
        }
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        arr = JSBridge__ReadIterable(JSBridgeTmp.obj)
        JSBridgeTmp.result = arr
        JSBridgeTmp.node = JSBridge__Pop()
        JSBridgeTmp.dom_idx = JSBridge__Pop()
        JSBridgeTmp.val = JSBridgeTmp.node
        JSBridgeTmp.obj = JSBridgeTmp.result
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        old_nt = JSVM__GetGlobal("__new_target__")
        JSBridgeTmp.cb_val = old_nt
        JSBridge__Push(JSBridgeTmp.cb_val)
        mc = JSVM__GetGlobal("Map")
        JSVM__SetGlobal("__new_target__", mc)
        m = JSBridge__MapConstruct(JSVMCallBuf.buf, 0)
        JSBridgeTmp.result = m
        JSBridgeTmp.found = JSBridge__Pop()
        JSBridgeTmp.node = JSBridge__Pop()
        JSBridgeTmp.dom_idx = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridgeTmp.found
        JSBridgeTmp.val = JSBridgeTmp.node
        JSBridgeTmp.obj = JSBridgeTmp.dom_idx
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.result)
        JSVM__SetGlobal("__new_target__", JSBridgeTmp.cb_val)
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSBridgeTmp.count = JSRT_ArrLen(JSBridgeTmp.obj)
        buf = Allocate(32)
        JSBridgeTmp.addr = buf
        i = 0
        WhileLoop LessThan(i, JSBridgeTmp.count) {
            JSBridgeTmp.idx = i
            v = JSRT_ArrGet(JSBridgeTmp.obj, JSBridgeTmp.idx)
            JSBridgeTmp.cb_val = v
            StoreValue(JSBridgeTmp.addr, JSBridgeTmp.cb_val)
            JSBridgeTmp.result = JSRT_CreateNumber(JSBridgeTmp.idx)
            StoreValue(Add(JSBridgeTmp.addr, 8), JSBridgeTmp.result)
            JSBridge__MapSaveState()
            JSBridge__Push(JSBridgeTmp.val)
            JSVM__SetGlobal("this", JSRTState.undef_val)
            JSBridgeTmp.val = JSBridge__Pop()
            key = JSVM__CallFunc(JSBridgeTmp.val, JSBridgeTmp.addr, 2)
            JSBridgeTmp.result = key
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                JSBridge__MapFreeBuf()
                JSBridge__MapPropagate()
                ReturnValue(JSRTState.undef_val)
            }
            JSBridgeTmp.name_ptr = JSBridge__MapCanonKey(JSBridgeTmp.result)
            pairs = JSRT_ObjGet(JSBridgeTmp.ptr, "__pairs__")
            JSBridgeTmp.val2 = pairs
            found = JSBridge__MapFindIndex(JSBridgeTmp.val2, JSBridgeTmp.name_ptr)
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                ent = JSRT_ArrGet(JSBridgeTmp.val2, found)
                g = JSRT_ArrGet(ent, 1)
                JSRT_ArrPush(g, JSBridgeTmp.cb_val)
            } ElseBlock: {
                g2 = JSRT_CreateArray()
                JSBridgeTmp.found = g2
                JSRT_ArrPush(JSBridgeTmp.found, JSBridgeTmp.cb_val)
                JSBridge__Push(JSBridgeTmp.obj)
                JSBridge__Push(JSBridgeTmp.val)
                JSBridge__MapPut(JSBridgeTmp.ptr, JSBridgeTmp.name_ptr, JSBridgeTmp.found)
                JSBridgeTmp.node = JSBridge__Pop()
                JSBridgeTmp.dom_idx = JSBridge__Pop()
                JSBridgeTmp.val = JSBridgeTmp.node
                JSBridgeTmp.obj = JSBridgeTmp.dom_idx
            }
            i = Add(JSBridgeTmp.idx, 1)
        }
        JSBridge__MapFreeBuf()
        ReturnValue(JSBridgeTmp.ptr)
    }
}

