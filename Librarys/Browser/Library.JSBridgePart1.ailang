        max_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_MAX, "max", 2)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "max", max_func)

        // ─── Math.min ───
        JSBridge__Push(mo)
        min_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_MIN, "min", 2)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "min", min_func)

        // ─── Math.floor ───
