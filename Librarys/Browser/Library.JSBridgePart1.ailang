        pow_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_POW, "pow", 2)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "pow", pow_func)

        // ─── Math.sqrt ───
        JSBridge__Push(mo)
        sqrt_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_SQRT, "sqrt", 1)
        mo = JSBridge__Pop()
        JSRT_ObjSet(mo, "sqrt", sqrt_func)

        // ─── Math.sin ───
        JSBridge__Push(mo)
        sin_func = JSBridge__CreateNativeFunc(JSNativeID.MATH_SIN, "sin", 1)
