        save_argc = argc

            JSBridgeTmp.ptr = JSVM__GetGlobal("this")
            JSBridgeTmp.val2 = JSBridge__MapRequirePairs(JSBridgeTmp.ptr)
            IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(JSRTState.undef_val) }
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRTState.undef_val) }
            JSBridgeTmp.obj = JSRTState.undef_val
            JSBridgeTmp.val = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { JSBridgeTmp.obj = RDMEM_64(save_args) }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: { JSBridgeTmp.val = RDMEM_64(save_args, 8) }
            JSBridgeTmp.name_ptr = JSBridge__MapCanonKey(JSBridgeTmp.obj)
            found = JSBridge__MapFindIndex(JSBridgeTmp.val2, JSBridgeTmp.name_ptr)
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                entu = JSRT_ArrGet(JSBridgeTmp.val2, found)
                JSBridgeTmp.addr = entu
                JSRT_ArrSet(JSBridgeTmp.addr, 1, JSBridgeTmp.val)
            } ElseBlock: {
                entn = JSRT_CreateArray()
                JSBridgeTmp.addr = entn
                JSRT_ArrPush(JSBridgeTmp.addr, JSBridgeTmp.name_ptr)
                JSRT_ArrPush(JSBridgeTmp.addr, JSBridgeTmp.val)
                JSRT_ArrPush(JSBridgeTmp.val2, JSBridgeTmp.addr)
            }
            ReturnValue(JSBridgeTmp.ptr)
        
    }
}


