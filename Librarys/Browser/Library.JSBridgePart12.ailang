Function.JSBridge__DMAP_DELETE {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            JSBridgeTmp.ptr = JSVM__GetGlobal("this")
            JSBridgeTmp.val2 = JSBridge__MapRequirePairs(JSBridgeTmp.ptr)
            IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(JSRTState.undef_val) }
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRTState.undef_val) }
            mk = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { mk = RDMEM_64(save_args) }
            JSBridgeTmp.name_ptr = JSBridge__MapCanonKey(mk)
            found = JSBridge__MapFindIndex(JSBridgeTmp.val2, JSBridgeTmp.name_ptr)
            IfCondition LessThan(found, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            // Tombstone so live iterators keep stable indices. size is a getter.
            JSRT_ArrSet(JSBridgeTmp.val2, found, JSRTState.null_val)
            ReturnValue(JSRT_CreateBool(1))
        
    }
}


