// String.prototype[@@iterator]. Records the string and index 0.
// next yields Unicode code points (surrogate pairs are one element).
Function.JSBridge__DStrIter {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.ptr = JSVM__GetGlobal("this")
        st = JSRT_GetType(JSBridgeTmp.ptr)
        IfCondition Or(EqualTo(st, JSType.UNDEFINED), EqualTo(st, JSType.NULL)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "String.prototype[@@iterator] called on null or undefined")
            JSVM_ThrowValue(terr)
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(st, JSType.STRING) ThenBlock: {
            JSBridgeTmp.val = JSBridgeTmp.ptr
        } ElseBlock: {
            JSBridge__Push(JSBridgeTmp.ptr)
            sv = JSRT_ToString(JSBridgeTmp.ptr)
            JSBridgeTmp.result = sv
            JSBridgeTmp.ptr = JSBridge__Pop()
            JSBridgeTmp.val = JSBridgeTmp.result
        }
        JSBridge__Push(JSBridgeTmp.val)
        it = JSRT_CreateObject()
        JSBridgeTmp.obj = it
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        z = JSRT_CreateNumber(0)
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridgeTmp.result = z
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.result)
        JSRT_ObjSet(JSBridgeTmp.obj, "__s__", JSBridgeTmp.val)
        JSBridgeTmp.result = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        JSRT_ObjSet(JSBridgeTmp.obj, "__i__", JSBridgeTmp.result)
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.obj)
        nf = JSBridge__CreateNativeFunc(JSNativeID.STR_ITER_NEXT, "next", 0)
        JSBridgeTmp.cb_val = nf
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.obj)
        JSRT_ObjSet(JSBridgeTmp.obj, "next", JSBridgeTmp.cb_val)
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition NotEqual(JSRTState.string_iter_proto, 0) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.obj)
            JSRT_ObjSet(JSBridgeTmp.obj, "__proto__", JSRTState.string_iter_proto)
            JSBridgeTmp.obj = JSBridge__Pop()
        }
        ReturnValue(JSBridgeTmp.obj)
    }
}

Function.JSBridge__DStrIterNext {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.ptr = JSVM__GetGlobal("this")
        // Internal slots are own. Object.create(iterator) inherits next but
        // not __s__/__i__, and must throw rather than walk the prototype.
        JSBridgeTmp.found = 0
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.ptr)
        IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: {
            IfCondition EqualTo(JSRT_ObjHas(JSBridgeTmp.ptr, "__s__"), 1) ThenBlock: {
                IfCondition EqualTo(JSRT_ObjHas(JSBridgeTmp.ptr, "__i__"), 1) ThenBlock: {
                    JSBridgeTmp.found = 1
                }
            }
        }
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            terr_si = JSVM_CreateTypedError("TypeError", "String iterator next called on incompatible receiver")
            JSVM_ThrowValue(terr_si)
            ReturnValue(JSRTState.undef_val)
        }
        JSBridge__Push(JSBridgeTmp.ptr)
        s = JSRT_ObjGet(JSBridgeTmp.ptr, "__s__")
        JSBridgeTmp.result = s
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.val = JSBridgeTmp.result
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.val)
        idx_v = JSRT_ObjGet(JSBridgeTmp.ptr, "__i__")
        JSBridgeTmp.result = idx_v
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        idx = 0
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.NUMBER) ThenBlock: {
            idx = Float_ToInt(JSRT_GetPayload(JSBridgeTmp.result))
        }
        JSBridgeTmp.idx = idx
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.val)
        res = JSRT_CreateObject()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.obj = res
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.val), JSType.STRING) ThenBlock: {
            JSRT_ObjSet(JSBridgeTmp.obj, "done", JSRT_True())
            JSRT_ObjSet(JSBridgeTmp.obj, "value", JSRTState.undef_val)
            ReturnValue(JSBridgeTmp.obj)
        }
        sp = JSRT_GetPayload(JSBridgeTmp.val)
        sl = JSRT_StrLen(sp)
        JSBridgeTmp.len = sl
        sp = JSRT_GetPayload(JSBridgeTmp.val)
        IfCondition GreaterEqual(JSBridgeTmp.idx, JSBridgeTmp.len) ThenBlock: {
            JSRT_ObjSet(JSBridgeTmp.obj, "done", JSRT_True())
            JSRT_ObjSet(JSBridgeTmp.obj, "value", JSRTState.undef_val)
            ReturnValue(JSBridgeTmp.obj)
        }
        sp = JSRT_GetPayload(JSBridgeTmp.val)
        cu = JSRT_StrUnit(sp, JSBridgeTmp.idx)
        cstep = 1
        IfCondition And(GreaterEqual(cu, 55296), LessThan(cu, 56320)) ThenBlock: {
            IfCondition LessThan(Add(JSBridgeTmp.idx, 1), JSBridgeTmp.len) ThenBlock: {
                sp = JSRT_GetPayload(JSBridgeTmp.val)
                cu2 = JSRT_StrUnit(sp, Add(JSBridgeTmp.idx, 1))
                IfCondition And(GreaterEqual(cu2, 56320), LessThan(cu2, 57344)) ThenBlock: {
                    cstep = 2
                }
            }
        }
        JSBridgeTmp.count = cstep
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        sp = JSRT_GetPayload(JSBridgeTmp.val)
        slice = JSRT_CreateStringSlice(sp, JSBridgeTmp.idx, JSBridgeTmp.count)
        JSBridgeTmp.result = slice
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.result)
        nidx = JSRT_CreateNumber(Add(JSBridgeTmp.idx, JSBridgeTmp.count))
        JSBridgeTmp.val2 = nidx
        JSBridgeTmp.result = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.result)
        JSRT_ObjSet(JSBridgeTmp.ptr, "__i__", JSBridgeTmp.val2)
        JSBridgeTmp.result = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.obj)
        JSRT_ObjSet(JSBridgeTmp.obj, "value", JSBridgeTmp.result)
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.obj)
        JSRT_ObjSet(JSBridgeTmp.obj, "done", JSRT_False())
        JSBridgeTmp.obj = JSBridge__Pop()
        ReturnValue(JSBridgeTmp.obj)
    }
}
