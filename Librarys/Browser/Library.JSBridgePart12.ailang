Function.JSBridge__DPROXY_REVOKE {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            this_r = JSVM__GetGlobal("this")
            JSRTStack.hold = this_r
            px = 0
            IfCondition EqualTo(JSRT_GetType(JSRTStack.hold), JSType.FUNCTION) ThenBlock: {
                px = JSRT_ObjGet(JSRTStack.hold, "__revoke_proxy__")
            }
            JSRTStack.hold2 = px
            IfCondition EqualTo(JSVM__IsProxy(JSRTStack.hold2), 0) ThenBlock: {
                px = JSRT_ObjGet(JSRTStack.hold, "proxy")
                JSRTStack.hold2 = px
            }
            IfCondition EqualTo(JSVM__IsProxy(JSRTStack.hold2), 1) ThenBlock: {
                JSRT_ObjSet(JSRTStack.hold2, "__p_t__", JSRTState.null_val)
                JSRT_ObjSet(JSRTStack.hold2, "__p_h__", JSRTState.null_val)
                JSRT_ObjSet(JSRTStack.hold2, "__p_revoked__", JSRT_True())
            }
            ReturnValue(JSRTState.undef_val)
        
    }
}


Function.JSBridge__DPROXY_REVOCABLE {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            // Create proxy via same path as PROXY_CTOR
            proxy_v = JSBridge_Dispatch(JSNativeID.PROXY_CTOR, save_args, save_argc)
            IfCondition EqualTo(JSVM__IsProxy(proxy_v), 0) ThenBlock: {
                // TypeError object returned on bad args
                ReturnValue(proxy_v)
            }
            rev_fn = JSBridge__CreateNativeFunc(JSNativeID.PROXY_REVOKE, "revoke", 0)
            // Bind proxy on revoke via env / property
            JSRT_ObjSet(rev_fn, "__revoke_proxy__", proxy_v)
            res = JSRT_CreateObject()
            JSRT_ObjSet(res, "proxy", proxy_v)
            JSRT_ObjSet(res, "revoke", rev_fn)
            ReturnValue(res)
        
    }
}


Function.JSBridge__DPROXY_CTOR {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            tgt = JSRTState.undef_val
            hnd = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                tgt = RDMEM_64(save_args)
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                hnd = RDMEM_64(save_args, 8)
            }
            tt = JSRT_GetType(tgt)
            ht = JSRT_GetType(hnd)
            ok_t = 0
            IfCondition Or(EqualTo(tt, JSType.OBJECT), Or(EqualTo(tt, JSType.FUNCTION), EqualTo(tt, JSType.ARRAY))) ThenBlock: {
                ok_t = 1
            }
            ok_h = 0
            IfCondition Or(EqualTo(ht, JSType.OBJECT), Or(EqualTo(ht, JSType.FUNCTION), EqualTo(ht, JSType.ARRAY))) ThenBlock: {
                ok_h = 1
            }
            IfCondition Or(EqualTo(ok_t, 0), EqualTo(ok_h, 0)) ThenBlock: {
                // Return TypeError object — CONSTRUCT/CALL will leave as result; better than crash
                terr = JSVM_CreateTypedError("TypeError", "Cannot create proxy with non-object")
                ReturnValue(terr)
            }
            pobj = JSRT_CreateObject()
            JSRT_ObjSet(pobj, "__p__", JSRT_True())
            JSRT_ObjSet(pobj, "__p_t__", tgt)
            JSRT_ObjSet(pobj, "__p_h__", hnd)
            // typeof Proxy follows [[Call]] of target (even after revoke)
            IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: {
                JSRT_ObjSet(pobj, "__proxy_callable__", JSRT_True())
            } ElseBlock: {
                JSRT_ObjSet(pobj, "__proxy_callable__", JSRT_False())
            }
            ReturnValue(pobj)
        
    }
}


