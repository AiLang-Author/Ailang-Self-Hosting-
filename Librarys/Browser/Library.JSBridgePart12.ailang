Function.JSBridge__DTA_FROM {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            ReturnValue(JSVM__NTAFrom(save_args, save_argc))
        
    }
}


Function.JSBridge__DBIGINT_VALUE_OF {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            this_v = JSVM__GetGlobal("this")
            IfCondition EqualTo(JSRT_GetType(this_v), JSType.OBJECT) ThenBlock: {
                pv = JSRT_ObjGet(this_v, "__value__")
                IfCondition EqualTo(JSRT_GetType(pv), JSType.BIGINT) ThenBlock: { ReturnValue(pv) }
            }
            IfCondition EqualTo(JSRT_GetType(this_v), JSType.BIGINT) ThenBlock: { ReturnValue(this_v) }
            terr = JSVM_CreateTypedError("TypeError", "BigInt.prototype.valueOf requires BigInt")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(JSRT_Undefined())
        
    }
}


Function.JSBridge__DBIGINT_TO_STRING {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            this_v = JSVM__GetGlobal("this")
            IfCondition EqualTo(JSRT_GetType(this_v), JSType.OBJECT) ThenBlock: {
                pv = JSRT_ObjGet(this_v, "__value__")
                IfCondition EqualTo(JSRT_GetType(pv), JSType.BIGINT) ThenBlock: { this_v = pv }
            }
            IfCondition NotEqual(JSRT_GetType(this_v), JSType.BIGINT) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "BigInt.prototype.toString requires BigInt")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                ReturnValue(JSRT_Undefined())
            }
            rdx = 10
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                rdx = Float_ToInt(JSRT_ToNumber(RDMEM_64(save_args)))
            }
            ReturnValue(JSRT_BigIntToString(this_v, rdx))
        
    }
}


Function.JSBridge__DBIGINT_ASUINTN {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            bits = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                bits = Float_ToInt(JSRT_ToNumber(RDMEM_64(save_args)))
            }
            av = JSRT_CreateBigIntZero()
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                av = JSRT_ToBigInt(RDMEM_64(save_args, 8))
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            }
            ReturnValue(JSRT_BigIntAsUintN(bits, av))
        
    }
}


Function.JSBridge__DBIGINT_ASINTN {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            bits = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                bits = Float_ToInt(JSRT_ToNumber(RDMEM_64(save_args)))
            }
            av = JSRT_CreateBigIntZero()
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                av = JSRT_ToBigInt(RDMEM_64(save_args, 8))
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            }
            ReturnValue(JSRT_BigIntAsIntN(bits, av))
        
    }
}


Function.JSBridge__DBIGINT_CTOR {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            // new BigInt(v) throws before ToBigInt, so valueOf is not called.
            // Ordinary BigInt(v) leaves __new_target__ undefined.
            nt_bi = JSVM__GetGlobal("__new_target__")
            nt_bit = JSRT_GetType(nt_bi)
            IfCondition Or(EqualTo(nt_bit, JSType.FUNCTION), Or(EqualTo(nt_bit, JSType.OBJECT), EqualTo(nt_bit, JSType.ARRAY))) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "BigInt is not a constructor")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "BigInt requires one argument")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                ReturnValue(JSRT_Undefined())
            }
            arg0 = RDMEM_64(save_args)
            ReturnValue(JSRT_ToBigInt(arg0))
        
    }
}


Function.JSBridge__DSYM_PROTO_VALUE_OF {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            this_v = JSVM__GetGlobal("this")
            sym = JSVM_ThisSymbolValue(this_v)
            IfCondition EqualTo(sym, 0) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            ReturnValue(sym)
        
    }
}


Function.JSBridge__DSYM_PROTO_TO_STRING {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            this_v = JSVM__GetGlobal("this")
            sym = JSVM_ThisSymbolValue(this_v)
            IfCondition EqualTo(sym, 0) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            ReturnValue(JSVM_SymbolDescriptiveString(sym))
        
    }
}


Function.JSBridge__DSET_ITER_NEXT {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            it = JSVM__GetGlobal("this")
            JSBridgeTmp.ptr = it
            sset = JSRT_ObjGet(it, "__s__")
            vals = JSRT_ObjGet(sset, "__vals__")
            idx_v = JSRT_ObjGet(it, "__i__")
            idx = 0
            IfCondition EqualTo(JSRT_GetType(idx_v), JSType.NUMBER) ThenBlock: {
                idx = Float_ToInt(JSRT_GetPayload(idx_v))
            }
            kind = 0
            kind_v = JSRT_ObjGet(it, "__k__")
            IfCondition EqualTo(JSRT_GetType(kind_v), JSType.NUMBER) ThenBlock: {
                kind = Float_ToInt(JSRT_GetPayload(kind_v))
            }
            res = JSRT_CreateObject()
            IfCondition NotEqual(JSRT_GetType(vals), JSType.ARRAY) ThenBlock: {
                JSBridgeTmp.obj = res
                JSRT_ObjSet(JSBridgeTmp.ptr, "__s__", JSRTState.undef_val)
                res = JSBridgeTmp.obj
                JSRT_ObjSet(res, "done", JSRT_True())
                JSRT_ObjSet(res, "value", JSRTState.undef_val)
                ReturnValue(res)
            }
            vlen = JSRT_ArrLen(vals)
            // skip tombstones (__tomb__ flag)
            sk_done = 0
            WhileLoop And(LessThan(idx, vlen), EqualTo(sk_done, 0)) {
                pe2 = JSRT_ArrGet(vals, idx)
                is_t2 = 0
                IfCondition EqualTo(JSRT_GetType(pe2), JSType.OBJECT) ThenBlock: {
                    IfCondition EqualTo(JSRT_ObjHas(pe2, "__tomb__"), 1) ThenBlock: {
                        is_t2 = 1
                    }
                }
                IfCondition EqualTo(is_t2, 1) ThenBlock: {
                    idx = Add(idx, 1)
                } ElseBlock: {
                    sk_done = 1
                }
            }
            IfCondition GreaterEqual(idx, vlen) ThenBlock: {
                JSBridgeTmp.obj = res
                JSRT_ObjSet(JSBridgeTmp.ptr, "__s__", JSRTState.undef_val)
                res = JSBridgeTmp.obj
                JSRT_ObjSet(res, "done", JSRT_True())
                JSRT_ObjSet(res, "value", JSRTState.undef_val)
                ReturnValue(res)
            }
            vv = JSRT_ArrGet(vals, idx)
            IfCondition EqualTo(kind, 2) ThenBlock: {
                ent = JSRT_CreateArray()
                JSRT_ArrPush(ent, vv)
                JSRT_ArrPush(ent, vv)
                JSRT_ObjSet(res, "value", ent)
            } ElseBlock: {
                JSRT_ObjSet(res, "value", vv)
            }
            JSRT_ObjSet(res, "done", JSRT_False())
            JSRT__Push(it)
            JSRT__Push(res)
            ni = JSRT_CreateNumber(Add(idx, 1))
            res = JSRT__Pop()
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__i__", ni)
            ReturnValue(res)
        
    }
}


Function.JSBridge__DSET_VALUES {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            JSBridgeTmp.ptr = JSVM__GetGlobal("this")
            JSBridgeTmp.val = JSBridge__SetRequire(JSBridgeTmp.ptr)
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            sthis = JSVM__GetGlobal("this")
            it = JSRT_CreateObject()
            JSRT_ObjSet(it, "__s__", sthis)
            JSRT__Push(it)
            z2 = JSRT_CreateNumber(0)
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__i__", z2)
            ikind = 0
            IfCondition EqualTo(save_id, JSNativeID.SET_ENTRIES) ThenBlock: { ikind = 2 }
            JSRT__Push(it)
            knd = JSRT_CreateNumber(ikind)
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__k__", knd)
            JSRT__Push(it)
            nf = JSBridge__CreateNativeFunc(JSNativeID.SET_ITER_NEXT, "next", 0)
            JSRTStack.hold2 = nf
            it = JSRT__Pop()
            JSRTStack.hold = it
            JSBridge__Push(JSRTStack.hold)
            JSBridge__Push(JSRTStack.hold2)
            JSRT_FuncSetEnv(JSRTStack.hold2, JSRTStack.hold)
            JSRTStack.hold2 = JSBridge__Pop()
            JSRTStack.hold = JSBridge__Pop()
            JSBridge__Push(JSRTStack.hold)
            JSBridge__Push(JSRTStack.hold2)
            JSRT_ObjSet(JSRTStack.hold, "next", JSRTStack.hold2)
            JSRTStack.hold2 = JSBridge__Pop()
            it = JSBridge__Pop()
            IfCondition NotEqual(JSRTState.set_iter_proto, 0) ThenBlock: {
                JSRTStack.hold = it
                JSBridge__Push(JSRTStack.hold)
                JSRT_ObjSet(JSRTStack.hold, "__proto__", JSRTState.set_iter_proto)
                it = JSBridge__Pop()
            }
            JSRTStack.hold = 0
            JSRTStack.hold2 = 0
            ReturnValue(it)
        
    }
}


// [[SetData]] array, or TypeError. Object-like, __class__ "Set", __vals__ array.
Function.JSBridge__SetRequire {
    Input: sthis: Address
    Output: Address
    Body: {
        JSBridgeTmp.ptr = sthis
        t = JSRT_GetType(JSBridgeTmp.ptr)
        ok = 0
        IfCondition EqualTo(t, JSType.OBJECT) ThenBlock: { ok = 1 }
        IfCondition EqualTo(t, JSType.FUNCTION) ThenBlock: { ok = 1 }
        IfCondition EqualTo(t, JSType.ARRAY) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("Set method called on incompatible receiver"))
        }
        cls = JSRT_ObjGet(JSBridgeTmp.ptr, "__class__")
        JSBridgeTmp.val = cls
        ct = JSRT_GetType(JSBridgeTmp.val)
        IfCondition NotEqual(ct, JSType.STRING) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("Set method called on incompatible receiver"))
        }
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.val)
        expect = JSRT_CreateString("Set")
        JSBridgeTmp.result = expect
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.found = JSRT_GetPayload(JSBridgeTmp.val)
        JSBridgeTmp.count = JSRT_GetPayload(JSBridgeTmp.result)
        IfCondition NotEqual(JSRT_StrEq(JSBridgeTmp.found, JSBridgeTmp.count), 1) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("Set method called on incompatible receiver"))
        }
        vals = JSRT_ObjGet(JSBridgeTmp.ptr, "__vals__")
        JSBridgeTmp.val = vals
        vt = JSRT_GetType(JSBridgeTmp.val)
        IfCondition NotEqual(vt, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("Set method called on incompatible receiver"))
        }
        ReturnValue(JSBridgeTmp.val)
    }
}

Function.JSBridge__DSET_GET_SIZE {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.ptr = JSVM__GetGlobal("this")
        JSBridgeTmp.val = JSBridge__SetRequire(JSBridgeTmp.ptr)
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSBridgeTmp.idx = 0
        JSBridgeTmp.len = JSRT_ArrLen(JSBridgeTmp.val)
        JSBridgeTmp.count = 0
        WhileLoop LessThan(JSBridgeTmp.idx, JSBridgeTmp.len) {
            pe = JSRT_ArrGet(JSBridgeTmp.val, JSBridgeTmp.idx)
            JSBridgeTmp.result = pe
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
            JSBridgeTmp.found = 0
            IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_ObjHas(JSBridgeTmp.result, "__tomb__"), 1) ThenBlock: {
                    JSBridgeTmp.found = 1
                }
            }
            IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
                JSBridgeTmp.count = Add(JSBridgeTmp.count, 1)
            }
        }
        ReturnValue(JSRT_CreateNumber(JSBridgeTmp.count))
    }
}

Function.JSBridge__DSET_CLEAR {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            JSBridgeTmp.ptr = JSVM__GetGlobal("this")
            JSBridgeTmp.val = JSBridge__SetRequire(JSBridgeTmp.ptr)
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            JSBridgeTmp.idx = 0
            JSBridgeTmp.len = JSRT_ArrLen(JSBridgeTmp.val)
            WhileLoop LessThan(JSBridgeTmp.idx, JSBridgeTmp.len) {
                JSBridge__Push(JSBridgeTmp.val)
                tomb = JSRT_CreateObject()
                JSBridgeTmp.obj = tomb
                JSBridgeTmp.val = JSBridge__Pop()
                JSBridge__Push(JSBridgeTmp.val)
                JSRT_ObjSet(JSBridgeTmp.obj, "__tomb__", JSRT_True())
                JSBridgeTmp.val = JSBridge__Pop()
                JSRT_ArrSet(JSBridgeTmp.val, JSBridgeTmp.idx, JSBridgeTmp.obj)
                JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
            }
            ReturnValue(JSRTState.undef_val)
        
    }
}


Function.JSBridge__DSET_DELETE {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            JSBridgeTmp.ptr = JSVM__GetGlobal("this")
            JSBridgeTmp.val = JSBridge__SetRequire(JSBridgeTmp.ptr)
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            sv = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { sv = RDMEM_64(save_args) }
            JSBridgeTmp.obj = JSBridge__MapCanonKey(sv)
            found = JSBridge__SetFindIndex(JSBridgeTmp.val, JSBridgeTmp.obj)
            IfCondition LessThan(found, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            // Unique tombstone. null is a real Set value. Detect with ObjHas.
            JSBridgeTmp.idx = found
            JSBridge__Push(JSBridgeTmp.val)
            tomb = JSRT_CreateObject()
            JSBridgeTmp.obj = tomb
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.val)
            JSRT_ObjSet(JSBridgeTmp.obj, "__tomb__", JSRT_True())
            JSBridgeTmp.val = JSBridge__Pop()
            JSRT_ArrSet(JSBridgeTmp.val, JSBridgeTmp.idx, JSBridgeTmp.obj)
            ReturnValue(JSRT_CreateBool(1))
        
    }
}


Function.JSBridge__DSET_HAS {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            JSBridgeTmp.ptr = JSVM__GetGlobal("this")
            JSBridgeTmp.val = JSBridge__SetRequire(JSBridgeTmp.ptr)
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            sv = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { sv = RDMEM_64(save_args) }
            JSBridgeTmp.obj = JSBridge__MapCanonKey(sv)
            found = JSBridge__SetFindIndex(JSBridgeTmp.val, JSBridgeTmp.obj)
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
            ReturnValue(JSRT_CreateBool(0))
        
    }
}


Function.JSBridge__DSET_ADD {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            JSBridgeTmp.ptr = JSVM__GetGlobal("this")
            JSBridgeTmp.val = JSBridge__SetRequire(JSBridgeTmp.ptr)
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            sv = JSRTState.undef_val
            IfCondition GreaterThan(save_argc, 0) ThenBlock: { sv = RDMEM_64(save_args) }
            JSBridgeTmp.obj = JSBridge__MapCanonKey(sv)
            found = JSBridge__SetFindIndex(JSBridgeTmp.val, JSBridgeTmp.obj)
            IfCondition LessThan(found, 0) ThenBlock: {
                JSRT_ArrPush(JSBridgeTmp.val, JSBridgeTmp.obj)
            }
            ReturnValue(JSBridgeTmp.ptr)
        
    }
}


Function.JSBridge__DSET_CTOR {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            JSBridgeTmp.name_ptr = save_args
            JSBridgeTmp.idx = save_argc
            nt = JSVM__GetGlobal("__new_target__")
            ntt = JSRT_GetType(nt)
            IfCondition Or(EqualTo(nt, 0), EqualTo(ntt, JSType.UNDEFINED)) ThenBlock: {
                ReturnValue(JSBridge__MapThrow("Set constructor requires new"))
            }
            mobj = JSBridge__SetNewObj()
            JSBridgeTmp.ptr = mobj
            JSBridgeTmp.obj = 0
            JSBridgeTmp.val = 0
            JSBridgeTmp.val2 = 0
            JSBridgeTmp.addr = 0
            JSBridgeTmp.cb_val = 0
            nt2 = JSVM__GetGlobal("__new_target__")
            JSBridgeTmp.obj = nt2
            ntt2 = JSRT_GetType(JSBridgeTmp.obj)
            IfCondition EqualTo(ntt2, JSType.FUNCTION) ThenBlock: {
                JSBridge__Push(JSBridgeTmp.name_ptr)
                JSBridge__MapSaveState()
                proto = JSVM__ObjGetAcc(JSBridgeTmp.obj, "prototype")
                JSBridgeTmp.result = proto
                JSBridge__MapLoadState()
                JSBridgeTmp.name_ptr = JSBridge__Pop()
                IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                    ReturnValue(JSRTState.undef_val)
                }
                IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.result), 1) ThenBlock: {
                    JSBridgeTmp.obj = JSBridgeTmp.result
                } ElseBlock: {
                    JSBridgeTmp.obj = 0
                }
            } ElseBlock: {
                JSBridgeTmp.obj = 0
            }
            IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
                sc = JSVM__GetGlobal("Set")
                JSBridgeTmp.val = sc
                proto2 = JSRT_ObjGet(JSBridgeTmp.val, "prototype")
                JSBridgeTmp.obj = proto2
            }
            IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.obj), 1) ThenBlock: {
                JSBridge__Push(JSBridgeTmp.ptr)
                JSRT_ObjSet(JSBridgeTmp.ptr, "__proto__", JSBridgeTmp.obj)
                JSBridgeTmp.ptr = JSBridge__Pop()
            }
            IfCondition LessThan(JSBridgeTmp.idx, 1) ThenBlock: {
                ReturnValue(JSBridgeTmp.ptr)
            }
            JSBridgeTmp.cb_val = RDMEM_64(JSBridgeTmp.name_ptr)
            itb_t = JSRT_GetType(JSBridgeTmp.cb_val)
            IfCondition Or(EqualTo(itb_t, JSType.UNDEFINED), EqualTo(itb_t, JSType.NULL)) ThenBlock: {
                ReturnValue(JSBridgeTmp.ptr)
            }
            ok = JSBridge__SetIngest(JSBridgeTmp.ptr, JSBridgeTmp.cb_val)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            ReturnValue(JSBridgeTmp.ptr)
        
    }
}


Function.JSBridge__DMAP_ITER_NEXT {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            JSBridgeTmp.ptr = JSVM__GetGlobal("this")
            mmap = JSRT_ObjGet(JSBridgeTmp.ptr, "__m__")
            JSBridgeTmp.val = mmap
            pairs = JSRT_ObjGet(JSBridgeTmp.val, "__pairs__")
            JSBridgeTmp.val2 = pairs
            idx_v = JSRT_ObjGet(JSBridgeTmp.ptr, "__i__")
            JSBridgeTmp.obj = idx_v
            idx = 0
            IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.obj), JSType.NUMBER) ThenBlock: {
                idx = Float_ToInt(JSRT_GetPayload(JSBridgeTmp.obj))
            }
            kind_v = JSRT_ObjGet(JSBridgeTmp.ptr, "__k__")
            JSBridgeTmp.obj = kind_v
            kind = 0
            IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.obj), JSType.NUMBER) ThenBlock: {
                kind = Float_ToInt(JSRT_GetPayload(JSBridgeTmp.obj))
            }
            JSBridgeTmp.idx = idx
            JSBridgeTmp.count = kind
            res = JSRT_CreateObject()
            JSBridgeTmp.obj = res
            IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.val2), JSType.ARRAY) ThenBlock: {
                JSRT_ObjSet(JSBridgeTmp.obj, "done", JSRT_True())
                JSRT_ObjSet(JSBridgeTmp.obj, "value", JSRTState.undef_val)
                ReturnValue(JSBridgeTmp.obj)
            }
            JSBridgeTmp.len = JSRT_ArrLen(JSBridgeTmp.val2)
            // skip tombstones (null)
            WhileLoop And(LessThan(JSBridgeTmp.idx, JSBridgeTmp.len), NotEqual(JSRT_GetType(JSRT_ArrGet(JSBridgeTmp.val2, JSBridgeTmp.idx)), JSType.ARRAY)) {
                JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
            }
            IfCondition GreaterEqual(JSBridgeTmp.idx, JSBridgeTmp.len) ThenBlock: {
                JSRT_ObjSet(JSBridgeTmp.obj, "done", JSRT_True())
                JSRT_ObjSet(JSBridgeTmp.obj, "value", JSRTState.undef_val)
                ReturnValue(JSBridgeTmp.obj)
            }
            ent = JSRT_ArrGet(JSBridgeTmp.val2, JSBridgeTmp.idx)
            JSBridgeTmp.val = ent
            IfCondition EqualTo(JSBridgeTmp.count, 1) ThenBlock: {
                ev = JSRT_ArrGet(JSBridgeTmp.val, 0)
            } ElseBlock: {
                IfCondition EqualTo(JSBridgeTmp.count, 2) ThenBlock: {
                    ev = JSRT_ArrGet(JSBridgeTmp.val, 1)
                } ElseBlock: {
                    ev = JSBridgeTmp.val
                }
            }
            JSBridgeTmp.cb_val = ev
            // Number first. A later ObjSet must not be what produces the index.
            JSBridgeTmp.result = JSRT_CreateNumber(Add(JSBridgeTmp.idx, 1))
            JSRT_ObjSet(JSBridgeTmp.ptr, "__i__", JSBridgeTmp.result)
            JSRT_ObjSet(JSBridgeTmp.obj, "value", JSBridgeTmp.cb_val)
            JSRT_ObjSet(JSBridgeTmp.obj, "done", JSRT_False())
            ReturnValue(JSBridgeTmp.obj)
        
    }
}


Function.JSBridge__DMAP_ENTRIES {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            JSBridgeTmp.ptr = JSVM__GetGlobal("this")
            JSBridge__MapRequirePairs(JSBridgeTmp.ptr)
            IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(JSRTState.undef_val) }
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(JSRTState.undef_val) }
            mthis = JSBridgeTmp.ptr
            it = JSRT_CreateObject()
            // M63: hold live map ref (not pairs snapshot) for contract/expand
            JSRT_ObjSet(it, "__m__", mthis)
            JSRT__Push(it)
            z2 = JSRT_CreateNumber(0)
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__i__", z2)
            ikind = 0
            IfCondition EqualTo(save_id, JSNativeID.MAP_KEYS) ThenBlock: { ikind = 1 }
            IfCondition EqualTo(save_id, JSNativeID.MAP_VALUES) ThenBlock: { ikind = 2 }
            JSRT__Push(it)
            knd = JSRT_CreateNumber(ikind)
            it = JSRT__Pop()
            JSRT_ObjSet(it, "__k__", knd)
            JSRT__Push(it)
            nf = JSBridge__CreateNativeFunc(JSNativeID.MAP_ITER_NEXT, "next", 0)
            JSRTStack.hold2 = nf
            it = JSRT__Pop()
            JSRTStack.hold = it
            JSBridge__Push(JSRTStack.hold)
            JSBridge__Push(JSRTStack.hold2)
            JSRT_FuncSetEnv(JSRTStack.hold2, JSRTStack.hold)
            JSRTStack.hold2 = JSBridge__Pop()
            JSRTStack.hold = JSBridge__Pop()
            JSBridge__Push(JSRTStack.hold)
            JSBridge__Push(JSRTStack.hold2)
            JSRT_ObjSet(JSRTStack.hold, "next", JSRTStack.hold2)
            JSRTStack.hold2 = JSBridge__Pop()
            it = JSBridge__Pop()
            IfCondition NotEqual(JSRTState.map_iter_proto, 0) ThenBlock: {
                JSRTStack.hold = it
                JSBridge__Push(JSRTStack.hold)
                JSRT_ObjSet(JSRTStack.hold, "__proto__", JSRTState.map_iter_proto)
                it = JSBridge__Pop()
            }
            JSRTStack.hold = 0
            JSRTStack.hold2 = 0
            ReturnValue(it)
        
    }
}


