Function.JSBridge__DMATH_SQRT {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = RDMEM_64(save_args)
                nval = JSRT_ToNumber(arg0)
                // Handle 0 and negative
                sq_zero = Float_FromInt(0)
                IfCondition EqualTo(Float_Eq(nval, sq_zero), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateFloat(sq_zero))
                }
                IfCondition EqualTo(Float_Lt(nval, sq_zero), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateFloat(9221120237041090560))
                }
                // Newton-Raphson: guess = x/2, iterate 20 times
                sq_two = Float_FromInt(2)
                sq_guess = Float_Div(nval, sq_two)
                sq_i = 0
                WhileLoop LessThan(sq_i, 20) {
                    sq_guess = Float_Div(Float_Add(sq_guess, Float_Div(nval, sq_guess)), sq_two)
                    sq_i = Add(sq_i, 1)
                }
                ReturnValue(JSRT_CreateFloat(sq_guess))
            }
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        
    }
}


Function.JSBridge__DDATE_CTOR {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            // Date() without new: new.target is undefined → return date string
            nt_d = JSVM__GetGlobal("__new_target__")
            IfCondition Or(EqualTo(nt_d, 0), EqualTo(JSRT_GetType(nt_d), JSType.UNDEFINED)) ThenBlock: {
                // ES: Date() → ToDateString(current time). Minimal valid string.
                ReturnValue(JSRT_CreateString("Thu Jan 01 1970 00:00:00 GMT+0000 (UTC)"))
            }
            // One object argument: ToPrimitive then time value. Strings have no
            // Date.parse yet, so they are NaN (Symbol wrapper → "foo").
            use_arg = 0
            arg_ms = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                darg = RDMEM_64(save_args)
                dt_d = JSRT_GetType(darg)
                is_dobj = 0
                IfCondition Or(EqualTo(dt_d, JSType.OBJECT), Or(EqualTo(dt_d, JSType.ARRAY), EqualTo(dt_d, JSType.FUNCTION))) ThenBlock: {
                    IfCondition EqualTo(JSVM_IsPrimSymbol(darg), 0) ThenBlock: { is_dobj = 1 }
                }
                IfCondition EqualTo(is_dobj, 1) ThenBlock: {
                    dprim = JSRT_ToPrimitive(darg, 0)
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        ReturnValue(JSRT_Undefined())
                    }
                    IfCondition EqualTo(dprim, 0) ThenBlock: {
                        ReturnValue(JSRT_Undefined())
                    }
                    dpt = JSRT_GetType(dprim)
                    IfCondition EqualTo(dpt, JSType.STRING) ThenBlock: {
                        arg_ms = 9221120237041090560
                        use_arg = 1
                    }
                    IfCondition EqualTo(dpt, JSType.NUMBER) ThenBlock: {
                        arg_ms = RDMEM_64(dprim, 8)
                        use_arg = 1
                    }
                    IfCondition EqualTo(use_arg, 0) ThenBlock: {
                        arg_ms = JSRT_ToNumber(dprim)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(JSRT_Undefined())
                        }
                        use_arg = 1
                    }
                }
            }
            sec = SystemCall(201, 0, 0, 0, 0, 0, 0)
            IfCondition LessThan(sec, 0) ThenBlock: { sec = 0 }
            ms = Multiply(sec, 1000)
            IfCondition EqualTo(use_arg, 1) ThenBlock: {
                ms = arg_ms
            }
            JSBridge__Push(use_arg)
            JSBridge__Push(ms)
            dobj = JSRT_CreateObject()
            ms = JSBridge__Pop()
            use_arg = JSBridge__Pop()
            JSBridge__Push(dobj)
            IfCondition EqualTo(use_arg, 1) ThenBlock: {
                dobj = JSBridge__Pop()
                JSBridge__Push(dobj)
                JSRT_ObjSet(dobj, "__time__", JSRT_CreateFloat(ms))
                dobj = JSBridge__Pop()
            } ElseBlock: {
                dobj = JSBridge__Pop()
                JSBridge__Push(dobj)
                JSRT_ObjSet(dobj, "__time__", JSRT_CreateNumber(ms))
                dobj = JSBridge__Pop()
            }
            // Prefer Date.prototype from global
            JSBridge__Push(dobj)
            dg = JSVM__GetGlobal("Date")
            dobj = JSBridge__Pop()
            dproto = 0
            IfCondition EqualTo(JSRT_GetType(dg), JSType.FUNCTION) ThenBlock: {
                JSBridge__Push(dobj)
                dproto = JSRT_ObjGet(dg, "prototype")
                dobj = JSBridge__Pop()
            }
            IfCondition EqualTo(JSRT_GetType(dproto), JSType.OBJECT) ThenBlock: {
                JSRT_ObjSet(dobj, "__proto__", dproto)
            } ElseBlock: {
                IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                    JSRT_ObjSet(dobj, "__proto__", JSRTState.object_proto)
                }
            }
            JSRT_ObjSet(dobj, "__class__", JSRT_CreateString("Date"))
            ReturnValue(dobj)
        
    }
}


// Date.prototype.getTime — handler 357. [[DateValue]] is __time__.
Function.JSBridge__DDATE_GET_TIME {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        this_v = JSVM__GetGlobal("this")
        JSBridge__Push(this_v)
        cls = JSRT_ObjGet(this_v, "__class__")
        this_v = JSBridge__Pop()
        ok_d = 0
        IfCondition EqualTo(JSRT_GetType(cls), JSType.STRING) ThenBlock: {
            IfCondition EqualTo(JSRT_StrEq(JSRT_GetPayload(cls), "Date"), 1) ThenBlock: {
                ok_d = 1
            }
        }
        IfCondition EqualTo(ok_d, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "this is not a Date object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        tv = JSRT_ObjGet(this_v, "__time__")
        IfCondition EqualTo(JSRT_GetType(tv), JSType.NUMBER) ThenBlock: {
            ReturnValue(tv)
        }
        ReturnValue(JSRT_CreateFloat(9221120237041090560))
    }
}


Function.JSBridge__DDATE_NOW {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            // ~2023-11 ms without huge literal: 1700 * 1e9
            ms = Multiply(1700, 1000000000)
            ReturnValue(JSRT_CreateNumber(ms))
        
    }
}


Function.JSBridge__DOBJ_CTOR {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            // Subclass: NewTarget is not Object. OrdinaryCreateFromConstructor
            // ignores the value (class Obj extends Object {}; new Obj()).
            nt_o = JSVM__GetGlobal("__new_target__")
            IfCondition EqualTo(JSRT_GetType(nt_o), JSType.FUNCTION) ThenBlock: {
                JSBridge__Push(nt_o)
                obj_fn = JSVM__GetGlobal("Object")
                nt_o = JSBridge__Pop()
                same_nt = 0
                IfCondition EqualTo(nt_o, obj_fn) ThenBlock: { same_nt = 1 }
                IfCondition EqualTo(same_nt, 0) ThenBlock: {
                    JSBridge__Push(nt_o)
                    JSBridge__Push(obj_fn)
                    ot_fn = JSRT_GetType(obj_fn)
                    obj_fn = JSBridge__Pop()
                    nt_o = JSBridge__Pop()
                    IfCondition EqualTo(ot_fn, JSType.FUNCTION) ThenBlock: {
                        JSBridge__Push(obj_fn)
                        JSRTStack.hold = JSRT_GetPayload(nt_o)
                        obj_fn = JSBridge__Pop()
                        pb_nt = JSRT_GetPayload(obj_fn)
                        IfCondition EqualTo(JSRTStack.hold, pb_nt) ThenBlock: { same_nt = 1 }
                        JSRTStack.hold = 0
                    }
                }
                IfCondition EqualTo(same_nt, 0) ThenBlock: {
                    JSBridge__Push(nt_o)
                    JSBridge__Push(obj_fn)
                    box = JSRT_CreateObject()
                    obj_fn = JSBridge__Pop()
                    nt_o = JSBridge__Pop()
                    JSBridge__Push(box)
                    JSBridge__Push(obj_fn)
                    np = JSRT_ObjGet(nt_o, "prototype")
                    obj_fn = JSBridge__Pop()
                    box = JSBridge__Pop()
                    JSBridge__Push(box)
                    JSBridge__Push(obj_fn)
                    JSBridge__Push(np)
                    npt = JSRT_GetType(np)
                    np = JSBridge__Pop()
                    obj_fn = JSBridge__Pop()
                    box = JSBridge__Pop()
                    IfCondition NotEqual(npt, JSType.OBJECT) ThenBlock: {
                        JSBridge__Push(box)
                        np = JSRT_ObjGet(obj_fn, "prototype")
                        box = JSBridge__Pop()
                        npt = JSRT_GetType(np)
                    }
                    IfCondition EqualTo(npt, JSType.OBJECT) ThenBlock: {
                        JSRTStack.hold = box
                        JSRTStack.hold2 = np
                        JSBridge__Push(JSRTStack.hold)
                        JSBridge__Push(JSRTStack.hold2)
                        JSRT_ObjSet(JSRTStack.hold, "__proto__", JSRTStack.hold2)
                        JSRTStack.hold2 = JSBridge__Pop()
                        JSRTStack.hold = JSBridge__Pop()
                        box = JSRTStack.hold
                        JSRTStack.hold = 0
                        JSRTStack.hold2 = 0
                    }
                    ReturnValue(box)
                }
            }

            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                oc_arg = RDMEM_64(save_args)
                oc_t = JSRT_GetType(oc_arg)
                IfCondition Or(EqualTo(oc_t, JSType.NULL), EqualTo(oc_t, JSType.UNDEFINED)) ThenBlock: {
                    ReturnValue(JSRT_CreateObject())
                }
                IfCondition Or(Or(EqualTo(oc_t, JSType.OBJECT), EqualTo(oc_t, JSType.ARRAY)), EqualTo(oc_t, JSType.FUNCTION)) ThenBlock: {
                    // Primitive Symbol is stored as OBJECT+__class__ Symbol — box it
                    // so Object(sym) !== sym and typeof Object(sym) === "object"
                    IfCondition EqualTo(JSVM_IsSymbol(oc_arg), 1) ThenBlock: {
                        // already a wrapper if it has __value__ that is a symbol
                        boxed_chk = JSRT_ObjGet(oc_arg, "__value__")
                        IfCondition EqualTo(JSVM_IsSymbol(boxed_chk), 1) ThenBlock: {
                            ReturnValue(oc_arg)
                        }
                        box_s = JSRT_CreateObject()
                        syg = JSVM__GetGlobal("Symbol")
                        syp = JSRT_ObjGet(syg, "prototype")
                        IfCondition EqualTo(JSRT_GetType(syp), JSType.OBJECT) ThenBlock: {
                            JSRT_ObjSet(box_s, "__proto__", syp)
                        }
                        JSRT_ObjSet(box_s, "__value__", oc_arg)
                        JSRT_ObjSet(box_s, "__class__", JSRT_CreateString("Symbol"))
                        ReturnValue(box_s)
                    }
                    ReturnValue(oc_arg)
                }
                // Box Boolean / Number / String
                box = JSRT_CreateObject()
                IfCondition EqualTo(oc_t, JSType.BOOLEAN) ThenBlock: {
                    bg = JSVM__GetGlobal("Boolean")
                    bp = JSRT_ObjGet(bg, "prototype")
                    IfCondition EqualTo(JSRT_GetType(bp), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(box, "__proto__", bp)
                    }
                    JSRT_ObjSet(box, "__value__", oc_arg)
                    JSRT_ObjSet(box, "__class__", JSRT_CreateString("Boolean"))
                    ReturnValue(box)
                }
                IfCondition EqualTo(oc_t, JSType.NUMBER) ThenBlock: {
                    ng = JSVM__GetGlobal("Number")
                    np = JSRT_ObjGet(ng, "prototype")
                    IfCondition EqualTo(JSRT_GetType(np), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(box, "__proto__", np)
                    }
                    JSRT_ObjSet(box, "__value__", oc_arg)
                    JSRT_ObjSet(box, "__class__", JSRT_CreateString("Number"))
                    ReturnValue(box)
                }
                IfCondition EqualTo(oc_t, JSType.BIGINT) ThenBlock: {
                    big = JSVM__GetGlobal("BigInt")
                    bp = JSRT_ObjGet(big, "prototype")
                    IfCondition EqualTo(JSRT_GetType(bp), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(box, "__proto__", bp)
                    }
                    JSRT_ObjSet(box, "__value__", oc_arg)
                    JSRT_ObjSet(box, "__class__", JSRT_CreateString("BigInt"))
                    ReturnValue(box)
                }
                IfCondition EqualTo(oc_t, JSType.STRING) ThenBlock: {
                    sg = JSVM__GetGlobal("String")
                    sp = JSRT_ObjGet(sg, "prototype")
                    IfCondition EqualTo(JSRT_GetType(sp), JSType.OBJECT) ThenBlock: {
                        JSRT_ObjSet(box, "__proto__", sp)
                    }
                    JSRT_ObjSet(box, "__value__", oc_arg)
                    JSRT_ObjSet(box, "__class__", JSRT_CreateString("String"))
                    // length + indices for array-like / String exotic
                    spay = JSRT_GetPayload(oc_arg)
                    slen = 0
                    IfCondition NotEqual(spay, 0) ThenBlock: { slen = JSRT_StrLen(spay) }
                    JSRT_ObjSet(box, "length", JSRT_CreateNumber(slen))
                    // M39: slab-copy index keys (IntToStr is a static buffer)
                    si = 0
                    WhileLoop LessThan(si, slen) {
                        JSBridge__Push(box)
                        JSBridge__Push(oc_arg)
                        JSBridge__Push(si)
                        JSBridge__Push(slen)
                        JSBridge__Push(spay)
                        chv = JSRT_CreateStringSlice(spay, si, 1)
                        tmpk = JSRT__IntToStr(si)
                        klen = StringLength(tmpk)
                        kptr = JSRT__StrSlabAlloc(Add(klen, 1))
                        IfCondition NotEqual(kptr, 0) ThenBlock: {
                            MemoryCopy(kptr, tmpk, Add(klen, 1))
                        } ElseBlock: {
                            kptr = tmpk
                        }
                        spay = JSBridge__Pop()
                        slen = JSBridge__Pop()
                        si = JSBridge__Pop()
                        oc_arg = JSBridge__Pop()
                        box = JSBridge__Pop()
                        JSBridge__Push(box)
                        JSBridge__Push(oc_arg)
                        JSBridge__Push(si)
                        JSBridge__Push(slen)
                        JSBridge__Push(spay)
                        JSRT_ObjSet(box, kptr, chv)
                        spay = JSBridge__Pop()
                        slen = JSBridge__Pop()
                        si = JSBridge__Pop()
                        oc_arg = JSBridge__Pop()
                        box = JSBridge__Pop()
                        si = Add(si, 1)
                    }
                    ReturnValue(box)
                }
            }
            ReturnValue(JSRT_CreateObject())
        
    }
}


Function.JSBridge__DPROMISE_CTOR {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            // Create promise, call executor(resolve, reject) eagerly
            promise = JSRT_CreateObject()
            // M92: [[Prototype]] = Promise.prototype
            IfCondition NotEqual(JSRTState.promise_proto, 0) ThenBlock: {
                JSRT_ObjSet(promise, "__proto__", JSRTState.promise_proto)
            }
            JSRT_ObjSet(promise, "__class__", JSRT_CreateString("Promise"))
            JSRT_ObjSet(promise, "__state__", JSRT_CreateNumber(0))
            JSRT_ObjSet(promise, "__value__", JSRT_Undefined())
            then_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_THEN, "then", 2)
            JSRT_FuncSetEnv(then_f, promise)
            JSRT_ObjSet(promise, "then", then_f)
            catch_f = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CATCH, "catch", 1)
            JSRT_FuncSetEnv(catch_f, promise)
            JSRT_ObjSet(promise, "catch", catch_f)
            ReturnValue(promise)
        
    }
}


Function.JSBridge__DPROMISE_CATCH {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            ReturnValue(JSRT_Undefined())
        
    }
}


