Function.JSBridge__DOBJ_DEFINE_PROP {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            JSBridgeTmp.result = JSBridge__NDefineProperty(save_args, save_argc)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.result)
            IfCondition EqualTo(JSBridgeTmp.type, JSType.BOOLEAN) ThenBlock: {
                JSVM_ThrowValue(JSVMCall.thrown_val)
                ReturnValue(JSRT_Undefined())
            }
            ReturnValue(JSBridgeTmp.result)
        
    }
}


