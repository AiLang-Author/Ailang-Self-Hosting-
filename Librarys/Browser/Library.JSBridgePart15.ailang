// Library.JSBridgePart15.ailang — JSBridge functions
// Moved out of Library.JSBridge.ailang. Pools stay in the parent.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.


Function.JSBridge__DOBJ_PROTO_HAS_OWN {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            // ToPropertyKey(V) before ToObject(this). A throwing key must
            // surface even when this is null or undefined.
            IfCondition LessThan(save_argc, 1) ThenBlock: {
                hop_key_val = JSRT_Undefined()
            } ElseBlock: {
                hop_key_val = Dereference(save_args)
            }
            // Save this across ToPropertyKey. A wrapper runs toString /
            // @@toPrimitive and that call replaces the global this. Reading
            // this again afterwards looks up the key on the wrong object.
            // ObjHas must use the saved receiver and the key local now:
            // a later copy of the key misses even when this early check hits.
            JSBridge__Push(JSVM__GetGlobal("this"))
            key_ptr = JSVM_ToPropertyKey(hop_key_val)
            JSBridgeTmp.obj = JSBridge__Pop()
            IfCondition EqualTo(key_ptr, 0) ThenBlock: {
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(JSRT_CreateBool(0))
            }
            JSBridgeTmp.cb_val = key_ptr
            // ObjHas before GetType / the #name scan. Both run calls, and a
            // later ObjHas on the same key then misses.
            JSBridgeTmp.found = JSRT_ObjHas(JSBridgeTmp.obj, JSBridgeTmp.cb_val)
            hop_t = JSRT_GetType(JSBridgeTmp.obj)
            IfCondition Or(EqualTo(hop_t, JSType.NULL), EqualTo(hop_t, JSType.UNDEFINED)) ThenBlock: {
                terr_hop = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
                JSVM__SetGlobal("__pend_exc__", terr_hop)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_hop
                JSVM_ThrowValue(terr_hop)
                ReturnValue(0)
            }
            // M26k.10: mangled private #name@id only (public "#foo" is own)
            IfCondition NotEqual(JSBridgeTmp.cb_val, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(JSBridgeTmp.cb_val, 0), 35) ThenBlock: {
                    _mp_has_at = 0
                    _mp_i = 1
                    WhileLoop LessThan(_mp_i, 256) {
                        _mp_b = GetByte(JSBridgeTmp.cb_val, _mp_i)
                        IfCondition EqualTo(_mp_b, 0) ThenBlock: { _mp_i = 256 }
                        IfCondition EqualTo(_mp_b, 64) ThenBlock: {
                            _mp_has_at = 1
                            _mp_i = 256
                        }
                        IfCondition And(NotEqual(_mp_b, 0), NotEqual(_mp_b, 64)) ThenBlock: {
                            _mp_i = Add(_mp_i, 1)
                        }
                    }
                    IfCondition EqualTo(_mp_has_at, 1) ThenBlock: {
                        ReturnValue(JSRT_CreateBool(0))
                    }
                }
            }
            ReturnValue(JSRT_CreateBool(JSBridgeTmp.found))
        
    }
}


Function.JSBridge__DOBJ_IS_PROTO_OF {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            V = JSVM__GetGlobal("this")
            IfCondition LessThan(save_argc, 1) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            O = Dereference(save_args)
            ot = JSRT_GetType(O)
            IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
                IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: {
                    ReturnValue(JSRT_CreateBool(0))
                }
            }
            hops = 0
            cur = O
            found = 0
            WhileLoop And(LessThan(hops, 100), EqualTo(found, 0)) {
                hops = Add(hops, 1)
                pt = JSRT_GetType(cur)
                proto = 0
                IfCondition EqualTo(pt, JSType.FUNCTION) ThenBlock: {
                    proto = JSRTState.function_proto
                }
                IfCondition EqualTo(pt, JSType.ARRAY) ThenBlock: {
                    proto = JSRTState.array_proto
                }
                IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: {
                    proto = JSRT_ObjGet(cur, "__proto__")
                }
                IfCondition EqualTo(proto, 0) ThenBlock: {
                    found = 2
                } ElseBlock: {
                    ptt = JSRT_GetType(proto)
                    IfCondition EqualTo(ptt, JSType.NULL) ThenBlock: {
                        found = 2
                    } ElseBlock: {
                        IfCondition EqualTo(ptt, JSType.UNDEFINED) ThenBlock: {
                            found = 2
                        } ElseBlock: {
                            IfCondition EqualTo(JSRT_SameRef(proto, V), 1) ThenBlock: {
                                found = 1
                            } ElseBlock: {
                                cur = proto
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(found, 1) ThenBlock: {
                ReturnValue(JSRT_CreateBool(1))
            }
            ReturnValue(JSRT_CreateBool(0))
        
    }
}



Function.JSBridge__DREFLECT_SET {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.ptr = save_args
        JSBridgeTmp.count = save_argc
        JSBridgeTmp.obj = 0
        JSBridgeTmp.val2 = JSRTState.undef_val
        JSBridgeTmp.val = JSRTState.undef_val
        JSBridgeTmp.saved_this = 0
        IfCondition GreaterThan(JSBridgeTmp.count, 0) ThenBlock: {
            JSBridgeTmp.obj = Dereference(JSBridgeTmp.ptr)
        }
        IfCondition GreaterThan(JSBridgeTmp.count, 1) ThenBlock: {
            JSBridgeTmp.val2 = Dereference(Add(JSBridgeTmp.ptr, 8))
        }
        IfCondition GreaterThan(JSBridgeTmp.count, 2) ThenBlock: {
            JSBridgeTmp.val = Dereference(Add(JSBridgeTmp.ptr, 16))
        }
        IfCondition GreaterThan(JSBridgeTmp.count, 3) ThenBlock: {
            JSBridgeTmp.saved_this = Dereference(Add(JSBridgeTmp.ptr, 24))
        }
        IfCondition LessThan(JSBridgeTmp.count, 4) ThenBlock: {
            JSBridgeTmp.saved_this = JSBridgeTmp.obj
        }
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridge__Push(JSBridgeTmp.saved_this)
        JSBridgeTmp.obj = JSBridge__ReflectNeedObj(JSBridgeTmp.obj)
        JSBridgeTmp.saved_this = JSBridge__Pop()
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(JSBridgeTmp.count, 4) ThenBlock: {
            JSBridgeTmp.saved_this = JSBridgeTmp.obj
        }
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.saved_this)
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridgeTmp.name_ptr = JSVM_ToPropertyKey(JSBridgeTmp.val2)
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.saved_this = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.name_ptr, 0) ThenBlock: {
            IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
            ReturnValue(JSRT_CreateBool(0))
        }
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.saved_this)
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridge__Push(JSBridgeTmp.name_ptr)
        JSBridgeTmp.found = JSVM__IsMangledPrivate(JSBridgeTmp.name_ptr)
        JSBridgeTmp.name_ptr = JSBridge__Pop()
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.saved_this = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.saved_this)
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridge__Push(JSBridgeTmp.name_ptr)
        JSBridgeTmp.found = JSBridge__ReflectTASet(JSBridgeTmp.obj, JSBridgeTmp.name_ptr, JSBridgeTmp.val)
        JSBridgeTmp.name_ptr = JSBridge__Pop()
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.saved_this = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.found, -1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            ReturnValue(JSBridgeTmp.result)
        }
        JSBridgeTmp.found = JSBridge__ReflectOrdinarySet(JSBridgeTmp.obj, JSBridgeTmp.name_ptr, JSBridgeTmp.val2, JSBridgeTmp.val, JSBridgeTmp.saved_this, 0)
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(JSBridgeTmp.found, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(JSRT_CreateBool(JSBridgeTmp.found))
    }
}


Function.JSBridge__DREFLECT_GET {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            IfCondition LessThan(save_argc, 2) ThenBlock: { ReturnValue(JSRT_Undefined()) }
            rg_obj = Dereference(save_args)
            rg_key_val = Dereference(Add(save_args, 8))
            rgt = JSRT_GetType(rg_obj)
            IfCondition And(NotEqual(rgt, JSType.OBJECT), And(NotEqual(rgt, JSType.FUNCTION), NotEqual(rgt, JSType.ARRAY))) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Reflect.get called on non-object")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM__SetGlobal("__pend_exc__", terr)
                ReturnValue(0)
            }
            JSBridge__Push(rg_obj)
            rgt = JSVM_IsPrimSymbol(rg_obj)
            rg_obj = JSBridge__Pop()
            IfCondition EqualTo(rgt, 1) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Reflect.get called on non-object")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM__SetGlobal("__pend_exc__", terr)
                ReturnValue(0)
            }
            JSBridge__Push(rg_obj)
            rg_key_ptr = JSVM_ToPropertyKey(rg_key_val)
            rg_obj = JSBridge__Pop()
            IfCondition EqualTo(rg_key_ptr, 0) ThenBlock: {
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
                ReturnValue(JSRT_Undefined())
            }
            IfCondition EqualTo(JSVM__IsMangledPrivate(rg_key_ptr), 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            IfCondition GreaterEqual(save_argc, 3) ThenBlock: {
                JSBridgeTmp.obj = rg_obj
                JSBridgeTmp.name_ptr = rg_key_ptr
                JSBridgeTmp.saved_this = Dereference(Add(save_args, 16))
                ReturnValue(JSBridge__ReflectGetRecv(JSBridgeTmp.obj, JSBridgeTmp.name_ptr, JSBridgeTmp.saved_this))
            }
            ReturnValue(JSVM__GetProperty(rg_obj, rg_key_ptr))
        
    }
}


Function.JSBridge__DREFLECT_HAS {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            IfCondition LessThan(save_argc, 2) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Reflect.has requires 2 arguments")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM__SetGlobal("__pend_exc__", terr)
                ReturnValue(0)
            }
            rh_obj = Dereference(save_args)
            rh_key_val = Dereference(Add(save_args, 8))
            rht = JSRT_GetType(rh_obj)
            IfCondition And(NotEqual(rht, JSType.OBJECT), And(NotEqual(rht, JSType.FUNCTION), NotEqual(rht, JSType.ARRAY))) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Reflect.has called on non-object")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM__SetGlobal("__pend_exc__", terr)
                ReturnValue(0)
            }
            JSBridge__Push(rh_obj)
            rht = JSVM_IsPrimSymbol(rh_obj)
            rh_obj = JSBridge__Pop()
            IfCondition EqualTo(rht, 1) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Reflect.has called on non-object")
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM__SetGlobal("__pend_exc__", terr)
                ReturnValue(0)
            }
            JSBridge__Push(rh_obj)
            rh_key_ptr = JSVM_ToPropertyKey(rh_key_val)
            rh_obj = JSBridge__Pop()
            IfCondition EqualTo(rh_key_ptr, 0) ThenBlock: {
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
                ReturnValue(JSRT_CreateBool(0))
            }
            IfCondition EqualTo(JSVM__IsMangledPrivate(rh_key_ptr), 1) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            rh_has = JSVM__HasProperty(rh_obj, rh_key_ptr)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { ReturnValue(0) }
            ReturnValue(JSRT_CreateBool(rh_has))
        
    }
}


Function.JSBridge__DOBJ_HAS_OWN_PROP {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            IfCondition LessThan(save_argc, 2) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            hop_obj = Dereference(save_args)
            hop_key_val = Dereference(Add(save_args, 8))
            // M80: ToPropertyKey (Symbol → @@sN); ToString would yield "Symbol()"
            JSBridge__Push(hop_obj)
            hop_key_ptr = JSVM_ToPropertyKey(hop_key_val)
            hop_obj = JSBridge__Pop()
            IfCondition EqualTo(hop_key_ptr, 0) ThenBlock: {
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(JSRT_CreateBool(0))
            }
            // M26k.10: mangled private #name@id only (public "#foo" is own)
            IfCondition NotEqual(hop_key_ptr, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(hop_key_ptr, 0), 35) ThenBlock: {
                    _mp_has_at = 0
                    _mp_i = 1
                    WhileLoop LessThan(_mp_i, 256) {
                        _mp_b = GetByte(hop_key_ptr, _mp_i)
                        IfCondition EqualTo(_mp_b, 0) ThenBlock: { _mp_i = 256 }
                        IfCondition EqualTo(_mp_b, 64) ThenBlock: {
                            _mp_has_at = 1
                            _mp_i = 256
                        }
                        IfCondition And(NotEqual(_mp_b, 0), NotEqual(_mp_b, 64)) ThenBlock: {
                            _mp_i = Add(_mp_i, 1)
                        }
                    }
                    IfCondition EqualTo(_mp_has_at, 1) ThenBlock: {
                        ReturnValue(JSRT_CreateBool(0))
                    }
                }
            }
            hop_has = JSRT_ObjHas(hop_obj, hop_key_ptr)
            ReturnValue(JSRT_CreateBool(hop_has))
        
    }
}


Function.JSBridge__DOBJ_PROTO_VALUE_OF {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            // ES: ToObject(this) then return that object
            this_v = JSVM__GetGlobal("this")
            tt = JSRT_GetType(this_v)
            IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
            // primitives → Object(this) box via OBJ_CTOR
            IfCondition And(NotEqual(tt, JSType.OBJECT), NotEqual(tt, JSType.FUNCTION)) ThenBlock: {
                IfCondition NotEqual(tt, JSType.ARRAY) ThenBlock: {
                    ab = JSVMCallBuf.buf
                    StoreValue(ab, this_v)
                    ReturnValue(JSBridge_Dispatch(JSNativeID.OBJ_CTOR, ab, 1))
                }
            }
            ReturnValue(this_v)
        
    }
}


