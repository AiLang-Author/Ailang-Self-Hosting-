    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            ReturnValue(JSBridge__NSetInterval(save_args, save_argc))
        
    }
}


