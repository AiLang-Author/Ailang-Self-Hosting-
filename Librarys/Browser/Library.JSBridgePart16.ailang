Function.JSBridge__DTHENABLE_REJECT {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            IfCondition EqualTo(JSVMAwait.state, 0) ThenBlock: {
                v2 = JSRT_Undefined()
                IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                    v2 = Dereference(save_args)
                }
                JSVMAwait.value = v2
                JSVMAwait.state = 2
            }
            ReturnValue(JSRT_Undefined())
        
    }
}


Function.JSBridge__DTHENABLE_RESOLVE {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

            IfCondition EqualTo(JSVMAwait.state, 0) ThenBlock: {
                v = JSRT_Undefined()
                IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                    v = Dereference(save_args)
                }
                JSVMAwait.value = v
                JSVMAwait.state = 1
            }
            ReturnValue(JSRT_Undefined())
        
    }
}


// [[GetPrototypeOf]]. Object.prototype is null. Proxies run getPrototypeOf
// when the trap is a function, otherwise the target. depth caps proxy chains.
Function.JSBridge__GetProtoSlot {
    Input: obj: Address
    Input: depth: Integer
    Output: Address
    Body: {
        IfCondition GreaterThan(depth, 8) ThenBlock: {
            IfCondition NotEqual(JSRTState.null_val, 0) ThenBlock: {
                ReturnValue(JSRTState.null_val)
            }
            ReturnValue(JSRT_Null())
        }
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        JSBridge__Push(obj)
        is_op = JSRT_StrictEqual(obj, JSRTState.object_proto)
        obj = JSBridge__Pop()
        IfCondition EqualTo(is_op, 1) ThenBlock: {
            IfCondition NotEqual(JSRTState.null_val, 0) ThenBlock: {
                ReturnValue(JSRTState.null_val)
            }
            ReturnValue(JSRT_Null())
        }
        JSBridge__Push(obj)
        JSBridge__Push(depth)
        ip = JSVM__IsProxy(obj)
        depth = JSBridge__Pop()
        obj = JSBridge__Pop()
        IfCondition EqualTo(ip, 1) ThenBlock: {
            JSBridge__Push(obj)
            hv = JSRT_ObjGet(obj, "__p_h__")
            obj = JSBridge__Pop()
            JSBridge__Push(hv)
            ht = JSRT_GetType(hv)
            hv = JSBridge__Pop()
            IfCondition Or(EqualTo(hv, 0), Or(EqualTo(ht, JSType.NULL), EqualTo(ht, JSType.UNDEFINED))) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "revoked proxy")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                ReturnValue(0)
            }
            JSBridge__Push(obj)
            JSBridge__Push(hv)
            tv = JSRT_ObjGet(obj, "__p_t__")
            hv = JSBridge__Pop()
            obj = JSBridge__Pop()
            JSBridge__Push(hv)
            JSBridge__Push(tv)
            JSBridge__Push(depth)
            trap = JSRT_ObjGet(hv, "getPrototypeOf")
            depth = JSBridge__Pop()
            tv = JSBridge__Pop()
            hv = JSBridge__Pop()
            JSBridge__Push(hv)
            JSBridge__Push(tv)
            JSBridge__Push(trap)
            JSBridge__Push(depth)
            tt = JSRT_GetType(trap)
            depth = JSBridge__Pop()
            trap = JSBridge__Pop()
            tv = JSBridge__Pop()
            hv = JSBridge__Pop()
            IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: {
                JSRTStack.hold = hv
                JSRTStack.hold2 = tv
                JSBridge__Push(trap)
                save_this = JSVM__GetGlobal("this")
                JSBridge__Push(save_this)
                JSVM__SetGlobal("this", JSRTStack.hold)
                save_this = JSBridge__Pop()
                trap = JSBridge__Pop()
                JSBridge__Push(save_this)
                JSBridge__Push(trap)
                ab = JSVMCallBuf.buf
                StoreValue(ab, JSRTStack.hold2)
                trap = JSBridge__Pop()
                res = JSVM__CallFunc(trap, ab, 1)
                save_this = JSBridge__Pop()
                JSVM__SetGlobal("this", save_this)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(0)
                }
                JSBridge__Push(res)
                sym = JSVM_IsPrimSymbol(res)
                res = JSBridge__Pop()
                IfCondition EqualTo(sym, 1) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "getPrototypeOf trap must return an object or null")
                    JSVM__SetGlobal("__pend_exc__", terr)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr
                    ReturnValue(0)
                }
                rt = JSRT_GetType(res)
                ok = 0
                IfCondition EqualTo(rt, JSType.OBJECT) ThenBlock: { ok = 1 }
                IfCondition EqualTo(rt, JSType.FUNCTION) ThenBlock: { ok = 1 }
                IfCondition EqualTo(rt, JSType.ARRAY) ThenBlock: { ok = 1 }
                IfCondition EqualTo(rt, JSType.NULL) ThenBlock: { ok = 1 }
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "getPrototypeOf trap must return an object or null")
                    JSVM__SetGlobal("__pend_exc__", terr)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr
                    ReturnValue(0)
                }
                ReturnValue(res)
            }
            nd = Add(depth, 1)
            res = JSBridge__GetProtoSlot(tv, nd)
            ReturnValue(res)
        }
        tt = JSRT_GetType(obj)
        IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: {
            fdesc = Dereference(Add(obj, 8))
            IfCondition NotEqual(fdesc, 0) ThenBlock: {
                ptab = Dereference(Add(fdesc, 64))
                IfCondition NotEqual(ptab, 0) ThenBlock: {
                    own_p = PropTable_Lookup(ptab, "__proto__")
                    IfCondition NotEqual(own_p, -1) ThenBlock: {
                        ReturnValue(own_p)
                    }
                }
            }
            IfCondition NotEqual(JSRTState.function_proto, 0) ThenBlock: {
                ReturnValue(JSRTState.function_proto)
            }
            ReturnValue(JSRT_Null())
        }
        IfCondition EqualTo(tt, JSType.ARRAY) ThenBlock: {
            IfCondition NotEqual(JSRTState.array_proto, 0) ThenBlock: {
                JSBridge__Push(obj)
                own = JSRT_ObjGet(obj, "__proto__")
                obj = JSBridge__Pop()
                ot = JSRT_GetType(own)
                IfCondition EqualTo(ot, JSType.NULL) ThenBlock: {
                    ReturnValue(own)
                }
                IfCondition Or(EqualTo(ot, JSType.OBJECT), Or(EqualTo(ot, JSType.FUNCTION), EqualTo(ot, JSType.ARRAY))) ThenBlock: {
                    IfCondition NotEqual(own, JSRTState.undef_val) ThenBlock: {
                        ReturnValue(own)
                    }
                }
                ReturnValue(JSRTState.array_proto)
            }
        }
        JSBridge__Push(obj)
        own = JSRT_ObjGet(obj, "__proto__")
        obj = JSBridge__Pop()
        ot = JSRT_GetType(own)
        IfCondition EqualTo(ot, JSType.NULL) ThenBlock: {
            ReturnValue(own)
        }
        IfCondition Or(EqualTo(ot, JSType.OBJECT), Or(EqualTo(ot, JSType.FUNCTION), EqualTo(ot, JSType.ARRAY))) ThenBlock: {
            ReturnValue(own)
        }
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            ReturnValue(JSRTState.object_proto)
        }
        ReturnValue(JSRT_Undefined())
    }
}


// [[SetPrototypeOf]]. 1 success, 0 reject, -1 abrupt already in exc_prop.
// A proxy in the chain stops the cycle walk (Annex B set-cycle-shadowed).
Function.JSBridge__SetProtoSlot {
    Input: target: Address
    Input: proto: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(depth, 8) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__Push(target)
        JSBridge__Push(proto)
        JSBridge__Push(depth)
        ip = JSVM__IsProxy(target)
        depth = JSBridge__Pop()
        proto = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(ip, 1) ThenBlock: {
            JSBridge__Push(target)
            JSBridge__Push(proto)
            JSBridge__Push(depth)
            hv = JSRT_ObjGet(target, "__p_h__")
            depth = JSBridge__Pop()
            proto = JSBridge__Pop()
            target = JSBridge__Pop()
            JSBridge__Push(hv)
            ht = JSRT_GetType(hv)
            hv = JSBridge__Pop()
            IfCondition Or(EqualTo(hv, 0), Or(EqualTo(ht, JSType.NULL), EqualTo(ht, JSType.UNDEFINED))) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "revoked proxy")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                ReturnValue(-1)
            }
            JSBridge__Push(target)
            JSBridge__Push(proto)
            JSBridge__Push(hv)
            JSBridge__Push(depth)
            tv = JSRT_ObjGet(target, "__p_t__")
            depth = JSBridge__Pop()
            hv = JSBridge__Pop()
            proto = JSBridge__Pop()
            target = JSBridge__Pop()
            JSBridge__Push(target)
            JSBridge__Push(proto)
            JSBridge__Push(hv)
            JSBridge__Push(tv)
            JSBridge__Push(depth)
            trap = JSRT_ObjGet(hv, "setPrototypeOf")
            depth = JSBridge__Pop()
            tv = JSBridge__Pop()
            hv = JSBridge__Pop()
            proto = JSBridge__Pop()
            target = JSBridge__Pop()
            JSBridge__Push(hv)
            JSBridge__Push(proto)
            JSBridge__Push(tv)
            JSBridge__Push(trap)
            JSBridge__Push(depth)
            tt = JSRT_GetType(trap)
            depth = JSBridge__Pop()
            trap = JSBridge__Pop()
            tv = JSBridge__Pop()
            proto = JSBridge__Pop()
            hv = JSBridge__Pop()
            IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: {
                JSRTStack.hold = hv
                JSRTStack.hold2 = tv
                JSBridge__Push(proto)
                JSBridge__Push(trap)
                save_this = JSVM__GetGlobal("this")
                JSBridge__Push(save_this)
                JSVM__SetGlobal("this", JSRTStack.hold)
                save_this = JSBridge__Pop()
                trap = JSBridge__Pop()
                proto = JSBridge__Pop()
                JSBridge__Push(save_this)
                JSBridge__Push(trap)
                JSBridge__Push(proto)
                ab = JSVMCallBuf.buf
                StoreValue(ab, JSRTStack.hold2)
                proto = JSBridge__Pop()
                StoreValue(Add(ab, 8), proto)
                trap = JSBridge__Pop()
                res = JSVM__CallFunc(trap, ab, 2)
                save_this = JSBridge__Pop()
                JSVM__SetGlobal("this", save_this)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(-1)
                }
                IfCondition EqualTo(JSRT_IsTruthy(res), 0) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(1)
            }
            nd = Add(depth, 1)
            st = JSBridge__SetProtoSlot(tv, proto, nd)
            ReturnValue(st)
        }
        JSBridge__Push(target)
        JSBridge__Push(proto)
        cur = JSBridge__GetProtoSlot(target, 0)
        proto = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(-1)
        }
        JSBridge__Push(target)
        JSBridge__Push(proto)
        eq = JSRT_StrictEqual(cur, proto)
        proto = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(eq, 1) ThenBlock: {
            ReturnValue(1)
        }
        JSBridge__Push(target)
        JSBridge__Push(proto)
        is_op = JSRT_StrictEqual(target, JSRTState.object_proto)
        proto = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(is_op, 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__Push(target)
        JSBridge__Push(proto)
        ex = JSRT_ObjGet(target, "__extensible__")
        proto = JSBridge__Pop()
        target = JSBridge__Pop()
        JSBridge__Push(ex)
        et = JSRT_GetType(ex)
        ex = JSBridge__Pop()
        IfCondition EqualTo(et, JSType.BOOLEAN) ThenBlock: {
            IfCondition EqualTo(JSRT_IsTruthy(ex), 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        JSBridge__Push(target)
        JSBridge__Push(proto)
        fr = JSRT_ObjGet(target, "__frozen__")
        proto = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(JSRT_IsTruthy(fr), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__Push(target)
        JSBridge__Push(proto)
        se = JSRT_ObjGet(target, "__sealed__")
        proto = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(JSRT_IsTruthy(se), 1) ThenBlock: {
            ReturnValue(0)
        }
        p = proto
        dep = 0
        done = 0
        cyc = 0
        WhileLoop And(EqualTo(done, 0), LessThan(dep, 64)) {
            JSBridge__Push(target)
            JSBridge__Push(proto)
            JSBridge__Push(p)
            JSBridge__Push(dep)
            pt = JSRT_GetType(p)
            dep = JSBridge__Pop()
            p = JSBridge__Pop()
            proto = JSBridge__Pop()
            target = JSBridge__Pop()
            IfCondition Or(EqualTo(p, 0), Or(EqualTo(pt, JSType.NULL), EqualTo(pt, JSType.UNDEFINED))) ThenBlock: {
                done = 1
            } ElseBlock: {
                JSBridge__Push(target)
                JSBridge__Push(proto)
                JSBridge__Push(p)
                JSBridge__Push(dep)
                eq = JSRT_StrictEqual(p, target)
                dep = JSBridge__Pop()
                p = JSBridge__Pop()
                proto = JSBridge__Pop()
                target = JSBridge__Pop()
                IfCondition EqualTo(eq, 1) ThenBlock: {
                    cyc = 1
                    done = 1
                } ElseBlock: {
                    JSBridge__Push(target)
                    JSBridge__Push(proto)
                    JSBridge__Push(p)
                    JSBridge__Push(dep)
                    ip = JSVM__IsProxy(p)
                    dep = JSBridge__Pop()
                    p = JSBridge__Pop()
                    proto = JSBridge__Pop()
                    target = JSBridge__Pop()
                    IfCondition EqualTo(ip, 1) ThenBlock: {
                        done = 1
                    } ElseBlock: {
                        JSBridge__Push(target)
                        JSBridge__Push(proto)
                        JSBridge__Push(dep)
                        nxt = JSRT_ObjGet(p, "__proto__")
                        dep = JSBridge__Pop()
                        proto = JSBridge__Pop()
                        target = JSBridge__Pop()
                        p = nxt
                    }
                }
            }
            dep = Add(dep, 1)
        }
        IfCondition EqualTo(cyc, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition And(EqualTo(done, 0), GreaterEqual(dep, 64)) ThenBlock: {
            ReturnValue(0)
        }
        JSRTStack.hold = target
        JSRTStack.hold2 = proto
        JSRT_ObjSet(JSRTStack.hold, "__proto__", JSRTStack.hold2)
        ReturnValue(1)
    }
}


Function.JSBridge__DProtoGet {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        recv = JSVM__GetGlobal("this")
        rt = JSRT_GetType(recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot get __proto__ of null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(JSRT_Undefined())
        }
        JSBridge__Push(recv)
        p = JSBridge__GetProtoSlot(recv, 0)
        recv = JSBridge__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition EqualTo(p, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }
        ReturnValue(p)
    }
}


Function.JSBridge__DProtoSet {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        recv = JSVM__GetGlobal("this")
        rt = JSRT_GetType(recv)
        IfCondition Or(EqualTo(rt, JSType.NULL), EqualTo(rt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot set __proto__ of null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(JSRT_Undefined())
        }
        proto = JSRT_Undefined()
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            proto = Dereference(save_args)
        }
        JSBridge__Push(recv)
        JSBridge__Push(proto)
        sym = JSVM_IsPrimSymbol(proto)
        proto = JSBridge__Pop()
        recv = JSBridge__Pop()
        okp = 0
        IfCondition EqualTo(sym, 0) ThenBlock: {
            pt = JSRT_GetType(proto)
            IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: { okp = 1 }
            IfCondition EqualTo(pt, JSType.FUNCTION) ThenBlock: { okp = 1 }
            IfCondition EqualTo(pt, JSType.ARRAY) ThenBlock: { okp = 1 }
            IfCondition EqualTo(pt, JSType.NULL) ThenBlock: { okp = 1 }
        }
        IfCondition EqualTo(okp, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        JSBridge__Push(recv)
        JSBridge__Push(proto)
        sym = JSVM_IsPrimSymbol(recv)
        proto = JSBridge__Pop()
        recv = JSBridge__Pop()
        is_obj = 0
        IfCondition EqualTo(sym, 0) ThenBlock: {
            rt = JSRT_GetType(recv)
            IfCondition EqualTo(rt, JSType.OBJECT) ThenBlock: { is_obj = 1 }
            IfCondition EqualTo(rt, JSType.FUNCTION) ThenBlock: { is_obj = 1 }
            IfCondition EqualTo(rt, JSType.ARRAY) ThenBlock: { is_obj = 1 }
        }
        IfCondition EqualTo(is_obj, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        JSBridge__Push(recv)
        JSBridge__Push(proto)
        st = JSBridge__SetProtoSlot(recv, proto, 0)
        proto = JSBridge__Pop()
        recv = JSBridge__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition EqualTo(st, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot set __proto__")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(JSRT_Undefined())
    }
}
