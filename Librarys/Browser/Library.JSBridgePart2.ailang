// Library.JSBridgePart2.ailang — JSBridge functions
// Moved out of Library.JSBridge.ailang. Pools stay in the parent.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.


// =============================================================================
// NATIVE IMPLEMENTATIONS: Object.* methods
// =============================================================================

// Object.defineProperties(obj, props) — define each own enumerable? key of props
// ES: for each own property name/symbol of props, defineProperty(O, P, props[P])
Function.JSBridge__NDefineProperties {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 2) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(args)
        props = Dereference(Add(args, 8))
        // ToObject target — null/undefined/primitive → TypeError
        tt = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.defineProperties called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition And(NotEqual(tt, JSType.OBJECT), NotEqual(tt, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(tt, JSType.ARRAY) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Object.defineProperties called on non-object")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(JSRT_Undefined())
            }
        }
        pt = JSRT_GetType(props)
        IfCondition Or(EqualTo(pt, JSType.NULL), EqualTo(pt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // ES: [[OwnPropertyKeys]] — include non-enumerable (not Object.keys)
        JSBridge__Push(target)
        JSBridge__Push(props)
        abn = JSVMCallBuf.buf
        StoreValue(abn, props)
        keys = JSBridge__NGetOwnPropNames(abn, 1)
        props = JSBridge__Pop()
        target = JSBridge__Pop()
        klen = JSRT_ArrLen(keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            JSBridge__Push(target)
            JSBridge__Push(props)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            ksv = JSRT_ArrGet(keys, ki)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            props = JSBridge__Pop()
            target = JSBridge__Pop()
            kp = JSRT_GetPayload(ksv)
            // Skip engine-internal __* keys
            skip_k = 0
            IfCondition NotEqual(kp, 0) ThenBlock: {
                IfCondition EqualTo(JSRT_StrUnit(kp, 0), 95) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrUnit(kp, 1), 95) ThenBlock: {
                        skip_k = 1
                    }
                }
            }
            // M39: ES only defines enumerable own props (skip length etc.)
            IfCondition EqualTo(skip_k, 0) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(props)
                JSBridge__Push(keys)
                JSBridge__Push(ki)
                JSBridge__Push(ksv)
                abits = JSBridge__GetAttrBits(props, kp)
                ksv = JSBridge__Pop()
                ki = JSBridge__Pop()
                keys = JSBridge__Pop()
                props = JSBridge__Pop()
                target = JSBridge__Pop()
                IfCondition EqualTo(BitwiseAnd(abits, JSAttr.E), 0) ThenBlock: {
                    skip_k = 1
                }
            }
            IfCondition EqualTo(skip_k, 0) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(props)
                JSBridge__Push(keys)
                JSBridge__Push(ki)
                // M27b: OrdinaryGet so accessor Properties fields are invoked
                dval = JSBridge__DescFieldGet(props, kp)
                ki = JSBridge__Pop()
                keys = JSBridge__Pop()
                props = JSBridge__Pop()
                target = JSBridge__Pop()
                // Getter Get threw. Do not define this key.
                abrupt = 0
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { abrupt = 1 }
                IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { abrupt = 1 }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: { abrupt = 1 }
                IfCondition EqualTo(abrupt, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                // Build arg buf: target, key string val, descriptor
                ab = JSVMCallBuf.buf
                StoreValue(ab, target)
                StoreValue(Add(ab, 8), ksv)
                StoreValue(Add(ab, 16), dval)
                JSBridge__Push(target)
                JSBridge__Push(props)
                JSBridge__Push(keys)
                JSBridge__Push(ki)
                JSBridgeTmp.val2 = JSBridge__NDefineProperty(ab, 3)
                JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.val2)
                IfCondition EqualTo(JSBridgeTmp.type, JSType.BOOLEAN) ThenBlock: {
                    JSVM_ThrowValue(JSVMCall.thrown_val)
                }
                // depth 0 ThrowValue delivers into the caller catch and clears
                // exc_prop. Another key would overwrite that catch value.
                abrupt = 0
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: { abrupt = 1 }
                IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: { abrupt = 1 }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: { abrupt = 1 }
                IfCondition EqualTo(abrupt, 1) ThenBlock: {
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    props = JSBridge__Pop()
                    target = JSBridge__Pop()
                    ReturnValue(JSRT_Undefined())
                }
                ki = JSBridge__Pop()
                keys = JSBridge__Pop()
                props = JSBridge__Pop()
                target = JSBridge__Pop()
            }
            ki = Add(ki, 1)
        }
        ReturnValue(target)
    }
}


// M39: build "__get_" / "__set_" + field into slab (C or UTF-16 field via StrUnit)
// kind: 0 = get, 1 = set. Matches defineProperty's accessor key layout.
Function.JSBridge__MakeAccKey {
    Input: field: Address
    Input: kind: Integer
    Output: Address
    Body: {
        save_f = field
        save_k = kind
        IfCondition EqualTo(save_f, 0) ThenBlock: { ReturnValue(0) }
        flen = JSRT_StrLen(save_f)
        buf = JSRT__StrSlabAlloc(Add(flen, 8))
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        SetByte(buf, 0, 95)
        SetByte(buf, 1, 95)
        IfCondition EqualTo(save_k, 0) ThenBlock: {
            SetByte(buf, 2, 103)
            SetByte(buf, 3, 101)
            SetByte(buf, 4, 116)
        } ElseBlock: {
            SetByte(buf, 2, 115)
            SetByte(buf, 3, 101)
            SetByte(buf, 4, 116)
        }
        SetByte(buf, 5, 95)
        gi = 0
        WhileLoop LessThan(gi, flen) {
            u = JSRT_StrUnit(save_f, gi)
            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
            SetByte(buf, Add(6, gi), u)
            gi = Add(gi, 1)
        }
        SetByte(buf, Add(6, flen), 0)
        ReturnValue(buf)
    }
}


// M27a: HasProperty on descriptor fields — own OR inherited data/accessor
// (ToPropertyDescriptor uses [[HasProperty]], not [[HasOwnProperty]])
Function.JSBridge__DescFieldHas {
    Input: desc: Address
    Input: field: Address
    Output: Integer
    Body: {
        save_d = desc
        save_f = field
        IfCondition EqualTo(save_d, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(save_f, 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_d)
        JSBridge__Push(save_f)
        // Data property on self or prototype chain
        IfCondition NotEqual(JSRT_ObjHasOnChain(save_d, save_f), 0) ThenBlock: {
            save_f = JSBridge__Pop()
            save_d = JSBridge__Pop()
            ReturnValue(1)
        }
        save_f = JSBridge__Pop()
        save_d = JSBridge__Pop()
        // __get_<field> on chain
        JSBridge__Push(save_d)
        JSBridge__Push(save_f)
        gk = JSBridge__MakeAccKey(save_f, 0)
        save_f = JSBridge__Pop()
        save_d = JSBridge__Pop()
        IfCondition EqualTo(gk, 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_d)
        JSBridge__Push(save_f)
        IfCondition NotEqual(JSRT_ObjHasOnChain(save_d, gk), 0) ThenBlock: {
            save_f = JSBridge__Pop()
            save_d = JSBridge__Pop()
            ReturnValue(1)
        }
        save_f = JSBridge__Pop()
        save_d = JSBridge__Pop()
        // __set_<field> on chain
        JSBridge__Push(save_d)
        sk = JSBridge__MakeAccKey(save_f, 1)
        save_d = JSBridge__Pop()
        IfCondition EqualTo(sk, 0) ThenBlock: { ReturnValue(0) }
        JSBridge__Push(save_d)
        IfCondition NotEqual(JSRT_ObjHasOnChain(save_d, sk), 0) ThenBlock: {
            save_d = JSBridge__Pop()
            ReturnValue(1)
        }
        save_d = JSBridge__Pop()
        ReturnValue(0)
    }
}


// M27a: [[Get]] on descriptor field — OrdinaryGet order:
// own data → own getter → own setter-only → [[Prototype]]
// Receiver `this` for getters is always the original Attributes object.
Function.JSBridge__DescFieldGet {
    Input: desc: Address
    Input: field: Address
    Output: Address
    Body: {
        save_d = desc
        save_f = field
        IfCondition EqualTo(save_d, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        IfCondition EqualTo(save_f, 0) ThenBlock: { ReturnValue(JSRT_Undefined()) }
        recv = save_d
        cur = save_d
        // Walk prototype chain
        // M37: check own accessor BEFORE data — defineProperty leaves undefined
        // data placeholder for accessors; data-first wrongly hid getter results.
        // M39: accessor keys via MakeAccKey (UTF-16 field names from gOPN)
        hops = 0
        WhileLoop And(NotEqual(cur, 0), LessThan(hops, 64)) {
            hops = Add(hops, 1)
            // 1) Own accessor getter __get_field?
            JSBridge__Push(recv)
            JSBridge__Push(save_f)
            JSBridge__Push(cur)
            gk = JSBridge__MakeAccKey(save_f, 0)
            cur = JSBridge__Pop()
            save_f = JSBridge__Pop()
            recv = JSBridge__Pop()
            IfCondition NotEqual(gk, 0) ThenBlock: {
                JSBridge__Push(recv)
                JSBridge__Push(save_f)
                JSBridge__Push(cur)
                own_g = JSRT_ObjHas(cur, gk)
                cur = JSBridge__Pop()
                save_f = JSBridge__Pop()
                recv = JSBridge__Pop()
                IfCondition EqualTo(own_g, 1) ThenBlock: {
                    JSBridge__Push(recv)
                    JSBridge__Push(save_f)
                    JSBridge__Push(cur)
                    gfn = JSRT_ObjGet(cur, gk)
                    cur = JSBridge__Pop()
                    save_f = JSBridge__Pop()
                    recv = JSBridge__Pop()
                    IfCondition EqualTo(JSRT_GetType(gfn), JSType.FUNCTION) ThenBlock: {
                        save_this = JSVM__GetGlobal("this")
                        JSVM__SetGlobal("this", recv)
                        empty_b = JSVMCallBuf.buf
                        gres = JSVM__CallFunc(gfn, empty_b, 0)
                        JSVM__SetGlobal("this", save_this)
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            ReturnValue(JSRT_Undefined())
                        }
                        ReturnValue(gres)
                    }
                    // getter present but not callable / undefined
                    ReturnValue(JSRT_Undefined())
                }
                // 2) Own setter-only → undefined (do not return data placeholder)
                JSBridge__Push(recv)
                JSBridge__Push(save_f)
                JSBridge__Push(cur)
                sk = JSBridge__MakeAccKey(save_f, 1)
                cur = JSBridge__Pop()
                save_f = JSBridge__Pop()
                recv = JSBridge__Pop()
                IfCondition NotEqual(sk, 0) ThenBlock: {
                    JSBridge__Push(recv)
                    JSBridge__Push(save_f)
                    JSBridge__Push(cur)
                    own_s = JSRT_ObjHas(cur, sk)
                    cur = JSBridge__Pop()
                    save_f = JSBridge__Pop()
                    recv = JSBridge__Pop()
                    IfCondition EqualTo(own_s, 1) ThenBlock: {
                        ReturnValue(JSRT_Undefined())
                    }
                }
            }
            // 3) Own data property (true data, not accessor placeholder)
            JSBridge__Push(recv)
            JSBridge__Push(save_f)
            JSBridge__Push(cur)
            own_data = JSRT_ObjHas(cur, save_f)
            cur = JSBridge__Pop()
            save_f = JSBridge__Pop()
            recv = JSBridge__Pop()
            IfCondition EqualTo(own_data, 1) ThenBlock: {
                JSBridge__Push(recv)
                JSBridge__Push(save_f)
                val = JSRT_ObjGet(cur, save_f)
                save_f = JSBridge__Pop()
                recv = JSBridge__Pop()
                ReturnValue(val)
            }
            // 4) Climb [[Prototype]]. A function with no stored __proto__
            // must visit Function.prototype. ObjGet("__proto__") skips it
            // and returns Function.prototype's proto instead.
            JSBridge__Push(recv)
            JSBridge__Push(save_f)
            JSBridge__Push(cur)
            tt_cur = JSRT_GetType(cur)
            cur = JSBridge__Pop()
            save_f = JSBridge__Pop()
            recv = JSBridge__Pop()
            proto = 0
            IfCondition EqualTo(tt_cur, JSType.FUNCTION) ThenBlock: {
                IfCondition NotEqual(cur, JSRTState.function_proto) ThenBlock: {
                    JSBridge__Push(recv)
                    JSBridge__Push(save_f)
                    JSBridge__Push(cur)
                    has_own_p = JSRT_ObjHas(cur, "__proto__")
                    cur = JSBridge__Pop()
                    save_f = JSBridge__Pop()
                    recv = JSBridge__Pop()
                    IfCondition EqualTo(has_own_p, 0) ThenBlock: {
                        proto = JSRTState.function_proto
                    }
                }
            }
            IfCondition EqualTo(proto, 0) ThenBlock: {
                JSBridge__Push(recv)
                JSBridge__Push(save_f)
                proto = JSRT_ObjGet(cur, "__proto__")
                save_f = JSBridge__Pop()
                recv = JSBridge__Pop()
            }
            pt = JSRT_GetType(proto)
            IfCondition And(NotEqual(pt, JSType.OBJECT), NotEqual(pt, JSType.FUNCTION)) ThenBlock: {
                // also ARRAY rare
                IfCondition NotEqual(pt, JSType.ARRAY) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
            }
            cur = proto
        }
        ReturnValue(JSRT_Undefined())
    }
}

// SameValue: NaN equals NaN, +0 does not equal -0. Other types use StrictEqual.
Function.JSBridge__SameValue {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(save_b, 0) ThenBlock: { ReturnValue(0) }
        a_type = Dereference(save_a)
        b_type = Dereference(save_b)
        IfCondition NotEqual(a_type, b_type) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(a_type, JSType.NUMBER) ThenBlock: {
            a_pay = Dereference(Add(save_a, 8))
            a_nan = Float_Ne(a_pay, a_pay)
            b_pay = Dereference(Add(save_b, 8))
            b_nan = Float_Ne(b_pay, b_pay)
            IfCondition And(EqualTo(a_nan, 1), EqualTo(b_nan, 1)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition Or(EqualTo(a_nan, 1), EqualTo(b_nan, 1)) ThenBlock: {
                ReturnValue(0)
            }
            // Re-read after Float_Ne. Integer bits distinguish +0 and -0.
            a_pay = Dereference(Add(save_a, 8))
            b_pay = Dereference(Add(save_b, 8))
            IfCondition EqualTo(a_pay, b_pay) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        ReturnValue(JSRT_StrictEqual(save_a, save_b))
    }
}

// Object.keys / for-in own keys. Array elements with stored !enumerable drop.
Function.JSBridge__EnumOwnKeys {
    Input: obj: Address
    Output: Address
    Body: {
        save_o = obj
        IfCondition EqualTo(save_o, 0) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        JSBridge__Push(save_o)
        own = JSRT_ObjKeys(save_o)
        save_o = JSBridge__Pop()
        JSBridge__Push(save_o)
        JSBridge__Push(own)
        tt = JSRT_GetType(save_o)
        own = JSBridge__Pop()
        save_o = JSBridge__Pop()
        IfCondition NotEqual(tt, JSType.ARRAY) ThenBlock: {
            ReturnValue(own)
        }
        result = JSRT_CreateArray()
        JSBridge__Push(save_o)
        JSBridge__Push(own)
        JSBridge__Push(result)
        n = JSRT_ArrLen(own)
        result = JSBridge__Pop()
        own = JSBridge__Pop()
        save_o = JSBridge__Pop()
        i = 0
        WhileLoop LessThan(i, n) {
            JSBridge__Push(save_o)
            JSBridge__Push(own)
            JSBridge__Push(result)
            JSBridge__Push(i)
            JSBridge__Push(n)
            ksv = JSRT_ArrGet(own, i)
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            result = JSBridge__Pop()
            own = JSBridge__Pop()
            save_o = JSBridge__Pop()
            keep = 1
            JSBridge__Push(save_o)
            JSBridge__Push(own)
            JSBridge__Push(result)
            JSBridge__Push(ksv)
            JSBridge__Push(i)
            JSBridge__Push(n)
            kp = JSRT_GetPayload(ksv)
            ak = JSBridge__MakeAttrKey(kp)
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            ksv = JSBridge__Pop()
            result = JSBridge__Pop()
            own = JSBridge__Pop()
            save_o = JSBridge__Pop()
            IfCondition NotEqual(ak, 0) ThenBlock: {
                JSBridge__Push(save_o)
                JSBridge__Push(own)
                JSBridge__Push(result)
                JSBridge__Push(ksv)
                JSBridge__Push(ak)
                JSBridge__Push(i)
                JSBridge__Push(n)
                av = JSRT_ObjGet(save_o, ak)
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                ak = JSBridge__Pop()
                ksv = JSBridge__Pop()
                result = JSBridge__Pop()
                own = JSBridge__Pop()
                save_o = JSBridge__Pop()
                JSBridge__Push(save_o)
                JSBridge__Push(own)
                JSBridge__Push(result)
                JSBridge__Push(ksv)
                JSBridge__Push(av)
                JSBridge__Push(i)
                JSBridge__Push(n)
                at = JSRT_GetType(av)
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                av = JSBridge__Pop()
                ksv = JSBridge__Pop()
                result = JSBridge__Pop()
                own = JSBridge__Pop()
                save_o = JSBridge__Pop()
                IfCondition EqualTo(at, JSType.NUMBER) ThenBlock: {
                    bits = Float_ToInt(JSRT_GetPayload(av))
                    IfCondition EqualTo(BitwiseAnd(bits, JSAttr.E), 0) ThenBlock: {
                        keep = 0
                    }
                }
            }
            IfCondition EqualTo(keep, 1) ThenBlock: {
                JSBridge__Push(save_o)
                JSBridge__Push(own)
                JSBridge__Push(ksv)
                JSBridge__Push(i)
                JSBridge__Push(n)
                JSRT_ArrPush(result, ksv)
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                ksv = JSBridge__Pop()
                own = JSBridge__Pop()
                save_o = JSBridge__Pop()
            }
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}

Function.JSBridge__ForInSeen {
    Input: arr: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_a = arr
        save_k = key
        JSBridge__Push(save_a)
        JSBridge__Push(save_k)
        n = JSRT_ArrLen(save_a)
        save_k = JSBridge__Pop()
        save_a = JSBridge__Pop()
        i = 0
        WhileLoop LessThan(i, n) {
            JSBridge__Push(save_a)
            JSBridge__Push(save_k)
            JSBridge__Push(i)
            JSBridge__Push(n)
            ev = JSRT_ArrGet(save_a, i)
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            save_k = JSBridge__Pop()
            save_a = JSBridge__Pop()
            JSBridge__Push(save_a)
            JSBridge__Push(save_k)
            JSBridge__Push(i)
            JSBridge__Push(n)
            eq = JSRT_StrictEqual(ev, save_k)
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            save_k = JSBridge__Pop()
            save_a = JSBridge__Pop()
            IfCondition EqualTo(eq, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when an object already visited (start until stop) has key as an own
// property. Enumerable is ignored: a non-enumerable own name still hides
// the same name on the prototype (EnumerateObjectProperties).
Function.JSBridge__ForInShadowed {
    Input: start: Address
    Input: stop: Address
    Input: key: Address
    Output: Integer
    Body: {
        cur = start
        depth = 0
        WhileLoop LessThan(depth, 16) {
            IfCondition EqualTo(cur, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(cur, stop) ThenBlock: {
                ReturnValue(0)
            }
            JSBridge__Push(cur)
            JSBridge__Push(stop)
            JSBridge__Push(key)
            JSBridge__Push(depth)
            JSRTStack.hold = cur
            kp = JSRT_GetPayload(key)
            JSRTStack.hold2 = kp
            has = JSRT_ObjHas(JSRTStack.hold, JSRTStack.hold2)
            JSRTStack.hold = 0
            JSRTStack.hold2 = 0
            depth = JSBridge__Pop()
            key = JSBridge__Pop()
            stop = JSBridge__Pop()
            cur = JSBridge__Pop()
            IfCondition EqualTo(has, 1) ThenBlock: {
                ReturnValue(1)
            }
            JSBridge__Push(cur)
            JSBridge__Push(stop)
            JSBridge__Push(key)
            JSBridge__Push(depth)
            has_p = JSRT_ObjHas(cur, "__proto__")
            depth = JSBridge__Pop()
            key = JSBridge__Pop()
            stop = JSBridge__Pop()
            cur = JSBridge__Pop()
            proto = 0
            IfCondition EqualTo(has_p, 1) ThenBlock: {
                JSBridge__Push(cur)
                JSBridge__Push(stop)
                JSBridge__Push(key)
                JSBridge__Push(depth)
                proto = JSRT_ObjGet(cur, "__proto__")
                depth = JSBridge__Pop()
                key = JSBridge__Pop()
                stop = JSBridge__Pop()
                cur = JSBridge__Pop()
            }
            IfCondition EqualTo(proto, 0) ThenBlock: {
                JSBridge__Push(cur)
                JSBridge__Push(stop)
                JSBridge__Push(key)
                JSBridge__Push(depth)
                tt2 = JSRT_GetType(cur)
                depth = JSBridge__Pop()
                key = JSBridge__Pop()
                stop = JSBridge__Pop()
                cur = JSBridge__Pop()
                IfCondition EqualTo(tt2, JSType.FUNCTION) ThenBlock: {
                    IfCondition NotEqual(cur, JSRTState.function_proto) ThenBlock: {
                        proto = JSRTState.function_proto
                    }
                }
            }
            IfCondition EqualTo(proto, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(proto, cur) ThenBlock: {
                ReturnValue(0)
            }
            JSBridge__Push(cur)
            JSBridge__Push(stop)
            JSBridge__Push(key)
            JSBridge__Push(depth)
            JSBridge__Push(proto)
            pt = JSRT_GetType(proto)
            proto = JSBridge__Pop()
            depth = JSBridge__Pop()
            key = JSBridge__Pop()
            stop = JSBridge__Pop()
            cur = JSBridge__Pop()
            nxt = 0
            IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: { nxt = 1 }
            IfCondition EqualTo(pt, JSType.FUNCTION) ThenBlock: { nxt = 1 }
            IfCondition EqualTo(pt, JSType.ARRAY) ThenBlock: { nxt = 1 }
            IfCondition EqualTo(nxt, 0) ThenBlock: {
                ReturnValue(0)
            }
            cur = proto
            depth = Add(depth, 1)
        }
        ReturnValue(0)
    }
}

// for-in keys: enumerable own keys, then the [[Prototype]] chain.
Function.JSBridge__ForInKeys {
    Input: obj: Address
    Output: Address
    Body: {
        result = JSRT_CreateArray()
        cur = obj
        start = obj
        depth = 0
        WhileLoop LessThan(depth, 16) {
            IfCondition EqualTo(cur, 0) ThenBlock: {
                ReturnValue(result)
            }
            JSBridge__Push(result)
            JSBridge__Push(start)
            tt = JSRT_GetType(cur)
            start = JSBridge__Pop()
            result = JSBridge__Pop()
            ok = 0
            IfCondition EqualTo(tt, JSType.OBJECT) ThenBlock: { ok = 1 }
            IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: { ok = 1 }
            IfCondition EqualTo(tt, JSType.ARRAY) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(result)
            }
            JSBridge__Push(result)
            JSBridge__Push(cur)
            JSBridge__Push(start)
            own = JSBridge__EnumOwnKeys(cur)
            start = JSBridge__Pop()
            cur = JSBridge__Pop()
            result = JSBridge__Pop()
            JSBridge__Push(result)
            JSBridge__Push(cur)
            JSBridge__Push(own)
            JSBridge__Push(start)
            n = JSRT_ArrLen(own)
            start = JSBridge__Pop()
            own = JSBridge__Pop()
            cur = JSBridge__Pop()
            result = JSBridge__Pop()
            i = 0
            WhileLoop LessThan(i, n) {
                JSBridge__Push(result)
                JSBridge__Push(cur)
                JSBridge__Push(own)
                JSBridge__Push(i)
                JSBridge__Push(n)
                JSBridge__Push(start)
                ksv = JSRT_ArrGet(own, i)
                start = JSBridge__Pop()
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                own = JSBridge__Pop()
                cur = JSBridge__Pop()
                result = JSBridge__Pop()
                JSBridge__Push(result)
                JSBridge__Push(cur)
                JSBridge__Push(own)
                JSBridge__Push(ksv)
                JSBridge__Push(i)
                JSBridge__Push(n)
                JSBridge__Push(start)
                seen = JSBridge__ForInSeen(result, ksv)
                start = JSBridge__Pop()
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                ksv = JSBridge__Pop()
                own = JSBridge__Pop()
                cur = JSBridge__Pop()
                result = JSBridge__Pop()
                IfCondition EqualTo(seen, 0) ThenBlock: {
                    JSBridge__Push(result)
                    JSBridge__Push(cur)
                    JSBridge__Push(own)
                    JSBridge__Push(ksv)
                    JSBridge__Push(i)
                    JSBridge__Push(n)
                    JSBridge__Push(start)
                    shadowed = JSBridge__ForInShadowed(start, cur, ksv)
                    start = JSBridge__Pop()
                    n = JSBridge__Pop()
                    i = JSBridge__Pop()
                    ksv = JSBridge__Pop()
                    own = JSBridge__Pop()
                    cur = JSBridge__Pop()
                    result = JSBridge__Pop()
                    IfCondition EqualTo(shadowed, 0) ThenBlock: {
                        JSBridge__Push(result)
                        JSBridge__Push(cur)
                        JSBridge__Push(own)
                        JSBridge__Push(ksv)
                        JSBridge__Push(i)
                        JSBridge__Push(n)
                        JSBridge__Push(start)
                        JSRT_ArrPush(result, ksv)
                        start = JSBridge__Pop()
                        n = JSBridge__Pop()
                        i = JSBridge__Pop()
                        ksv = JSBridge__Pop()
                        own = JSBridge__Pop()
                        cur = JSBridge__Pop()
                        result = JSBridge__Pop()
                    }
                }
                i = Add(i, 1)
            }
            JSBridge__Push(result)
            JSBridge__Push(cur)
            JSBridge__Push(start)
            has_p = JSRT_ObjHas(cur, "__proto__")
            start = JSBridge__Pop()
            cur = JSBridge__Pop()
            result = JSBridge__Pop()
            proto = 0
            IfCondition EqualTo(has_p, 1) ThenBlock: {
                JSBridge__Push(result)
                JSBridge__Push(start)
                proto = JSRT_ObjGet(cur, "__proto__")
                start = JSBridge__Pop()
                result = JSBridge__Pop()
            }
            IfCondition EqualTo(proto, 0) ThenBlock: {
                JSBridge__Push(result)
                JSBridge__Push(start)
                tt2 = JSRT_GetType(cur)
                start = JSBridge__Pop()
                result = JSBridge__Pop()
                IfCondition EqualTo(tt2, JSType.FUNCTION) ThenBlock: {
                    IfCondition NotEqual(cur, JSRTState.function_proto) ThenBlock: {
                        proto = JSRTState.function_proto
                    }
                }
            }
            IfCondition EqualTo(proto, 0) ThenBlock: {
                ReturnValue(result)
            }
            IfCondition EqualTo(proto, cur) ThenBlock: {
                ReturnValue(result)
            }
            JSBridge__Push(result)
            JSBridge__Push(cur)
            JSBridge__Push(start)
            JSBridge__Push(proto)
            pt = JSRT_GetType(proto)
            proto = JSBridge__Pop()
            start = JSBridge__Pop()
            cur = JSBridge__Pop()
            result = JSBridge__Pop()
            nxt = 0
            IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: { nxt = 1 }
            IfCondition EqualTo(pt, JSType.FUNCTION) ThenBlock: { nxt = 1 }
            IfCondition EqualTo(pt, JSType.ARRAY) ThenBlock: { nxt = 1 }
            IfCondition EqualTo(nxt, 0) ThenBlock: {
                ReturnValue(result)
            }
            cur = proto
            depth = Add(depth, 1)
        }
        ReturnValue(result)
    }
}
