// Library.JSBridgePart3.ailang — JSBridge functions
// Moved out of Library.JSBridge.ailang. Pools stay in the parent.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.


// Canonical array index, or -1. Rejects leading zeros except "0".
Function.JSBridge__ArrIndexOrNeg {
    Input: name_ptr: Address
    Output: Integer
    Body: {
        save_n = name_ptr
        IfCondition EqualTo(save_n, 0) ThenBlock: { ReturnValue(-1) }
        JSBridge__Push(save_n)
        nlen = JSRT_StrLen(save_n)
        save_n = JSBridge__Pop()
        IfCondition EqualTo(nlen, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(nlen, 10) ThenBlock: { ReturnValue(-1) }
        idx = 0
        bi = 0
        WhileLoop LessThan(bi, nlen) {
            JSBridge__Push(save_n)
            ch = JSRT_StrUnit(save_n, bi)
            save_n = JSBridge__Pop()
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                ReturnValue(-1)
            }
            IfCondition And(EqualTo(bi, 0), EqualTo(ch, 48)) ThenBlock: {
                IfCondition GreaterThan(nlen, 1) ThenBlock: { ReturnValue(-1) }
            }
            idx = Add(Multiply(idx, 10), Subtract(ch, 48))
            bi = Add(bi, 1)
        }
        ReturnValue(idx)
    }
}


// Install desc.get / desc.set as __get_ / __set_ after validation accepts.
Function.JSBridge__InstallAccFromDesc {
    Input: target: Address
    Input: name_ptr: Address
    Input: desc_val: Address
    Output: Integer
    Body: {
        save_t = target
        save_n = name_ptr
        save_d = desc_val
        JSBridge__Push(save_t)
        JSBridge__Push(save_n)
        JSBridge__Push(save_d)
        has_g = JSBridge__DescFieldHas(save_d, "get")
        save_d = JSBridge__Pop()
        save_n = JSBridge__Pop()
        save_t = JSBridge__Pop()
        IfCondition NotEqual(has_g, 0) ThenBlock: {
            JSBridge__Push(save_t)
            JSBridge__Push(save_n)
            JSBridge__Push(save_d)
            gv = JSBridge__DescFieldGet(save_d, "get")
            save_d = JSBridge__Pop()
            save_n = JSBridge__Pop()
            save_t = JSBridge__Pop()
            JSBridge__Push(save_t)
            JSBridge__Push(save_n)
            JSBridge__Push(save_d)
            JSBridge__Push(gv)
            gt = JSRT_GetType(gv)
            gv = JSBridge__Pop()
            save_d = JSBridge__Pop()
            save_n = JSBridge__Pop()
            save_t = JSBridge__Pop()
            // Undefined get is still an accessor. Store the undefined
            // marker so gOPD reports get: undefined rather than a data desc.
            JSBridge__Push(save_t)
            JSBridge__Push(save_d)
            JSBridge__Push(gv)
            JSBridge__Push(gt)
            gk = JSBridge__MakeAccKey(save_n, 0)
            gt = JSBridge__Pop()
            gv = JSBridge__Pop()
            save_d = JSBridge__Pop()
            save_t = JSBridge__Pop()
            IfCondition NotEqual(gt, JSType.FUNCTION) ThenBlock: {
                gv = JSRT_Undefined()
            }
            IfCondition NotEqual(gk, 0) ThenBlock: {
                JSRT_ObjSet(save_t, gk, gv)
            }
        }
        JSBridge__Push(save_t)
        JSBridge__Push(save_n)
        JSBridge__Push(save_d)
        has_s = JSBridge__DescFieldHas(save_d, "set")
        save_d = JSBridge__Pop()
        save_n = JSBridge__Pop()
        save_t = JSBridge__Pop()
        IfCondition NotEqual(has_s, 0) ThenBlock: {
            JSBridge__Push(save_t)
            JSBridge__Push(save_n)
            JSBridge__Push(save_d)
            sv = JSBridge__DescFieldGet(save_d, "set")
            save_d = JSBridge__Pop()
            save_n = JSBridge__Pop()
            save_t = JSBridge__Pop()
            JSBridge__Push(save_t)
            JSBridge__Push(save_n)
            JSBridge__Push(save_d)
            JSBridge__Push(sv)
            st = JSRT_GetType(sv)
            sv = JSBridge__Pop()
            save_d = JSBridge__Pop()
            save_n = JSBridge__Pop()
            save_t = JSBridge__Pop()
            JSBridge__Push(save_t)
            JSBridge__Push(save_d)
            JSBridge__Push(sv)
            JSBridge__Push(st)
            sk = JSBridge__MakeAccKey(save_n, 1)
            st = JSBridge__Pop()
            sv = JSBridge__Pop()
            save_d = JSBridge__Pop()
            save_t = JSBridge__Pop()
            IfCondition NotEqual(st, JSType.FUNCTION) ThenBlock: {
                sv = JSRT_Undefined()
            }
            IfCondition NotEqual(sk, 0) ThenBlock: {
                JSRT_ObjSet(save_t, sk, sv)
            }
        }
        ReturnValue(1)
    }
}


// 1 if desc's get/set match the current accessor (absent fields are skipped).
Function.JSBridge__AccCompat {
    Input: target: Address
    Input: name_ptr: Address
    Input: desc_val: Address
    Output: Integer
    Body: {
        save_t = target
        save_n = name_ptr
        save_d = desc_val
        JSBridge__Push(save_t)
        JSBridge__Push(save_n)
        JSBridge__Push(save_d)
        has_g = JSBridge__DescFieldHas(save_d, "get")
        save_d = JSBridge__Pop()
        save_n = JSBridge__Pop()
        save_t = JSBridge__Pop()
        IfCondition NotEqual(has_g, 0) ThenBlock: {
            JSBridge__Push(save_t)
            JSBridge__Push(save_n)
            JSBridge__Push(save_d)
            gv = JSBridge__DescFieldGet(save_d, "get")
            save_d = JSBridge__Pop()
            save_n = JSBridge__Pop()
            save_t = JSBridge__Pop()
            JSBridge__Push(save_t)
            JSBridge__Push(save_d)
            JSBridge__Push(gv)
            gk = JSBridge__MakeAccKey(save_n, 0)
            gv = JSBridge__Pop()
            save_d = JSBridge__Pop()
            save_t = JSBridge__Pop()
            cur = JSRT_Undefined()
            IfCondition NotEqual(gk, 0) ThenBlock: {
                JSBridge__Push(save_t)
                JSBridge__Push(save_n)
                JSBridge__Push(save_d)
                JSBridge__Push(gv)
                JSBridge__Push(gk)
                has_k = JSRT_ObjHas(save_t, gk)
                gk = JSBridge__Pop()
                gv = JSBridge__Pop()
                save_d = JSBridge__Pop()
                save_n = JSBridge__Pop()
                save_t = JSBridge__Pop()
                IfCondition EqualTo(has_k, 1) ThenBlock: {
                    JSBridge__Push(gk)
                    JSBridge__Push(save_t)
                    JSBridge__Push(save_n)
                    JSBridge__Push(save_d)
                    JSBridge__Push(gv)
                    gv = JSBridge__Pop()
                    save_d = JSBridge__Pop()
                    save_n = JSBridge__Pop()
                    save_t = JSBridge__Pop()
                    gk = JSBridge__Pop()
                    cur = JSRT_ObjGet(save_t, gk)
                }
            }
            JSBridge__Push(save_t)
            JSBridge__Push(save_n)
            JSBridge__Push(save_d)
            eq = JSRT_StrictEqual(gv, cur)
            save_d = JSBridge__Pop()
            save_n = JSBridge__Pop()
            save_t = JSBridge__Pop()
            IfCondition EqualTo(eq, 0) ThenBlock: { ReturnValue(0) }
        }
        JSBridge__Push(save_t)
        JSBridge__Push(save_n)
        JSBridge__Push(save_d)
        has_s = JSBridge__DescFieldHas(save_d, "set")
        save_d = JSBridge__Pop()
        save_n = JSBridge__Pop()
        save_t = JSBridge__Pop()
        IfCondition NotEqual(has_s, 0) ThenBlock: {
            JSBridge__Push(save_t)
            JSBridge__Push(save_n)
            JSBridge__Push(save_d)
            sv = JSBridge__DescFieldGet(save_d, "set")
            save_d = JSBridge__Pop()
            save_n = JSBridge__Pop()
            save_t = JSBridge__Pop()
            JSBridge__Push(save_t)
            JSBridge__Push(save_d)
            JSBridge__Push(sv)
            sk = JSBridge__MakeAccKey(save_n, 1)
            sv = JSBridge__Pop()
            save_d = JSBridge__Pop()
            save_t = JSBridge__Pop()
            cur = JSRT_Undefined()
            IfCondition NotEqual(sk, 0) ThenBlock: {
                JSBridge__Push(save_t)
                JSBridge__Push(save_n)
                JSBridge__Push(save_d)
                JSBridge__Push(sv)
                JSBridge__Push(sk)
                has_k = JSRT_ObjHas(save_t, sk)
                sk = JSBridge__Pop()
                sv = JSBridge__Pop()
                save_d = JSBridge__Pop()
                save_n = JSBridge__Pop()
                save_t = JSBridge__Pop()
                IfCondition EqualTo(has_k, 1) ThenBlock: {
                    JSBridge__Push(sk)
                    JSBridge__Push(save_t)
                    JSBridge__Push(save_n)
                    JSBridge__Push(save_d)
                    JSBridge__Push(sv)
                    sv = JSBridge__Pop()
                    save_d = JSBridge__Pop()
                    save_n = JSBridge__Pop()
                    save_t = JSBridge__Pop()
                    sk = JSBridge__Pop()
                    cur = JSRT_ObjGet(save_t, sk)
                }
            }
            JSBridge__Push(save_t)
            JSBridge__Push(save_n)
            JSBridge__Push(save_d)
            eq = JSRT_StrictEqual(sv, cur)
            save_d = JSBridge__Pop()
            save_n = JSBridge__Pop()
            save_t = JSBridge__Pop()
            IfCondition EqualTo(eq, 0) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}


// [[DefineOwnProperty]] returned false. Stash a TypeError for
// Object.defineProperty. Do not set error or halted: Reflect.defineProperty
// returns the false instead of throwing.
Function.JSBridge__DefineSoftFail {
    Input: msg: Address
    Output: Address
    Body: {
        JSBridgeTmp.result = JSVM_CreateTypedError("TypeError", msg)
        JSVMCall.thrown_val = JSBridgeTmp.result
        JSVMCall.exc_prop = 0
        JSVMState.error = 0
        JSVMState.halted = 0
        JSVMState.throw_delivered = 0
        JSVMState.exc_val = 0
        JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
        ReturnValue(JSRT_CreateBool(0))
    }
}

// Object.defineProperty(obj, prop, descriptor)
// descriptor can have: value, writable, enumerable, configurable, get, set
Function.JSBridge__NDefineProperty {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 3) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Extract arguments: obj, prop_name_val, descriptor
        target = RDMEM_64(save_args)
        name_val = RDMEM_64(save_args, 8)
        desc_val = RDMEM_64(save_args, 16)

        // ES Object.defineProperty: ToObject(O) — null/undefined/primitive → TypeError
        tt_dp = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt_dp, JSType.NULL), EqualTo(tt_dp, JSType.UNDEFINED)) ThenBlock: {
            terr_dp = JSVM_CreateTypedError("TypeError", "Object.defineProperty called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr_dp)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr_dp
            JSVM_ThrowValue(terr_dp)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition And(NotEqual(tt_dp, JSType.OBJECT), NotEqual(tt_dp, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(tt_dp, JSType.ARRAY) ThenBlock: {
                terr_dp = JSVM_CreateTypedError("TypeError", "Object.defineProperty called on non-object")
                JSVM__SetGlobal("__pend_exc__", terr_dp)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_dp
                JSVM_ThrowValue(terr_dp)
                ReturnValue(JSRT_Undefined())
            }
        }
        // Descriptor must be an object (ES: arrays, functions, boxed primitives as Objects)
        // M33: ARRAY is a distinct JSType but is an Object in the language
        dt_dp = JSRT_GetType(desc_val)
        IfCondition And(NotEqual(dt_dp, JSType.OBJECT), NotEqual(dt_dp, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(dt_dp, JSType.ARRAY) ThenBlock: {
                terr_dp = JSVM_CreateTypedError("TypeError", "Property description must be an object")
                JSVM__SetGlobal("__pend_exc__", terr_dp)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_dp
                JSVM_ThrowValue(terr_dp)
                ReturnValue(JSRT_Undefined())
            }
        }

        // Mole 16: ToPropertyKey (Symbol → @@sN, else string)
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        name_ptr = JSVM_ToPropertyKey(name_val)
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()

        // M128e7d4/e7du: TypedArray [[DefineOwnProperty]] for numeric indexes
        IfCondition EqualTo(JSVM_IsTypedArray(target), 1) ThenBlock: {
            ta_idx = JSVM_TA_ValidIndex(target, name_ptr)
            // digit-canonical miss may still be "-0"/"1.1"/etc.
            IfCondition EqualTo(ta_idx, -2) ThenBlock: {
                IfCondition EqualTo(JSVM_TA_IsCanonicalNumericKey(name_ptr), 1) ThenBlock: {
                    ta_idx = -1
                }
            }
            // -2 = not canonical (ordinary); -1 = OOB/invalid/detached; >=0 valid
            IfCondition NotEqual(ta_idx, -2) ThenBlock: {
                IfCondition EqualTo(ta_idx, -1) ThenBlock: {
                    // Non-integer, OOB, or detached: [[DefineOwnProperty]] is false.
                    ReturnValue(JSBridge__DefineSoftFail("Invalid typed array index"))
                }
                // Reject accessor / non-default attributes
                IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "get"), 0) ThenBlock: {
                    ReturnValue(JSBridge__DefineSoftFail("Cannot define accessor on typed array index"))
                }
                IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "set"), 0) ThenBlock: {
                    ReturnValue(JSBridge__DefineSoftFail("Cannot define accessor on typed array index"))
                }
                // If configurable/enumerable/writable present and false → fail
                IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "configurable"), 0) ThenBlock: {
                    cv = JSBridge__DescFieldGet(desc_val, "configurable")
                    IfCondition EqualTo(JSRT_IsTruthy(cv), 0) ThenBlock: {
                        ReturnValue(JSBridge__DefineSoftFail("typed array index must be configurable"))
                    }
                }
                IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "enumerable"), 0) ThenBlock: {
                    cv = JSBridge__DescFieldGet(desc_val, "enumerable")
                    IfCondition EqualTo(JSRT_IsTruthy(cv), 0) ThenBlock: {
                        ReturnValue(JSBridge__DefineSoftFail("typed array index must be enumerable"))
                    }
                }
                IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "writable"), 0) ThenBlock: {
                    cv = JSBridge__DescFieldGet(desc_val, "writable")
                    IfCondition EqualTo(JSRT_IsTruthy(cv), 0) ThenBlock: {
                        ReturnValue(JSBridge__DefineSoftFail("typed array index must be writable"))
                    }
                }
                IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "value"), 0) ThenBlock: {
                    value_val = JSBridge__DescFieldGet(desc_val, "value")
                    JSVM_TA_Set(target, ta_idx, value_val)
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        ReturnValue(JSRT_Undefined())
                    }
                }
                ReturnValue(target)
            }
        }

        // M128e6ai: Proxy [[DefineOwnProperty]] trap
        IfCondition EqualTo(JSVM__IsProxy(target), 1) ThenBlock: {
            hnd_dp = JSRT_ObjGet(target, "__p_h__")
            tgt_dp = JSRT_ObjGet(target, "__p_t__")
            trap_dp = JSRT_ObjGet(hnd_dp, "defineProperty")
            IfCondition EqualTo(JSRT_GetType(trap_dp), JSType.FUNCTION) ThenBlock: {
                kv_dp = JSRT__AllocValue()
                WRMEM_64(kv_dp, JSType.STRING)
                WRMEM_64(kv_dp, 8, name_ptr)
                ab_dp = JSVMCallBuf.buf
                WRMEM_64(ab_dp, tgt_dp)
                WRMEM_64(ab_dp, 8, kv_dp)
                WRMEM_64(ab_dp, 16, desc_val)
                save_this_dp = JSVM__GetGlobal("this")
                JSVM__SetGlobal("this", hnd_dp)
                res_dp = JSVM__CallFunc(trap_dp, ab_dp, 3)
                JSVM__SetGlobal("this", save_this_dp)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                // Return target object (Object.defineProperty return value)
                ReturnValue(target)
            }
            // No trap — define on target
            target = tgt_dp
        }

        // Mole 12: track defineProperty fields for mapped arguments
        is_accessor = 0
        has_value = 0
        value_val = JSRT_Undefined()
        writable_false = 0
        has_writable_key = 0

        // Pre-scan: mixed data + accessor is a TypeError (ToPropertyDescriptor)
        // M27a: use DescFieldHas so accessor-defined fields on the Attributes object count
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        has_acc_pre = 0
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "get"), 0) ThenBlock: { has_acc_pre = 1 }
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "set"), 0) ThenBlock: { has_acc_pre = 1 }
        has_data_pre = 0
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "value"), 0) ThenBlock: { has_data_pre = 1 }
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "writable"), 0) ThenBlock: { has_data_pre = 1 }
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition And(EqualTo(has_acc_pre, 1), EqualTo(has_data_pre, 1)) ThenBlock: {
            terr_dp = JSVM_CreateTypedError("TypeError", "Invalid property descriptor")
            JSVM__SetGlobal("__pend_exc__", terr_dp)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr_dp
            JSVM_ThrowValue(terr_dp)
            ReturnValue(JSRT_Undefined())
        }

        // get/set must be undefined or callable (8.10.5)
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "get"), 0) ThenBlock: {
            g_chk = JSBridge__DescFieldGet(desc_val, "get")
            gt_chk = JSRT_GetType(g_chk)
            IfCondition And(NotEqual(gt_chk, JSType.UNDEFINED), NotEqual(gt_chk, JSType.FUNCTION)) ThenBlock: {
                name_ptr = JSBridge__Pop()
                desc_val = JSBridge__Pop()
                target = JSBridge__Pop()
                terr_dp = JSVM_CreateTypedError("TypeError", "Getter must be a function")
                JSVM__SetGlobal("__pend_exc__", terr_dp)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_dp
                JSVM_ThrowValue(terr_dp)
                ReturnValue(JSRT_Undefined())
            }
        }
        IfCondition NotEqual(JSBridge__DescFieldHas(desc_val, "set"), 0) ThenBlock: {
            s_chk = JSBridge__DescFieldGet(desc_val, "set")
            st_chk = JSRT_GetType(s_chk)
            IfCondition And(NotEqual(st_chk, JSType.UNDEFINED), NotEqual(st_chk, JSType.FUNCTION)) ThenBlock: {
                name_ptr = JSBridge__Pop()
                desc_val = JSBridge__Pop()
                target = JSBridge__Pop()
                terr_dp = JSVM_CreateTypedError("TypeError", "Setter must be a function")
                JSVM__SetGlobal("__pend_exc__", terr_dp)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr_dp
                JSVM_ThrowValue(terr_dp)
                ReturnValue(JSRT_Undefined())
            }
        }
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()

        // New own property: only [[Extensible]] matters (8.12.9 step 3).
        // M128e7bw: do NOT use CanAssign — that walks [[Prototype]] and rejects
        // shadowing non-writable inherited data/accessors (correct for `=` assign,
        // wrong for defineProperty which may always create an own shadow).
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        exist0 = JSRT_ObjHas(target, name_ptr)
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(exist0, 0) ThenBlock: {
            JSBridge__Push(target)
            JSBridge__Push(desc_val)
            JSBridge__Push(name_ptr)
            // Frozen / sealed / __extensible__ === false
            fr_dp = JSRT_ObjGet(target, "__frozen__")
            se_dp = JSRT_ObjGet(target, "__sealed__")
            ex_dp = JSRT_ObjGet(target, "__extensible__")
            name_ptr = JSBridge__Pop()
            desc_val = JSBridge__Pop()
            target = JSBridge__Pop()
            not_ext = 0
            IfCondition EqualTo(JSRT_IsTruthy(fr_dp), 1) ThenBlock: { not_ext = 1 }
            IfCondition EqualTo(JSRT_IsTruthy(se_dp), 1) ThenBlock: { not_ext = 1 }
            IfCondition EqualTo(JSRT_GetType(ex_dp), JSType.BOOLEAN) ThenBlock: {
                IfCondition EqualTo(JSRT_IsTruthy(ex_dp), 0) ThenBlock: { not_ext = 1 }
            }
            IfCondition EqualTo(not_ext, 1) ThenBlock: {
                ReturnValue(JSBridge__DefineSoftFail("Cannot define property: object is not extensible"))
            }
        }

        // Presence only. __get_/__set_ are written after validation so a
        // rejected redefine cannot turn a data property into an accessor.
        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        has_get_f = JSBridge__DescFieldHas(desc_val, "get")
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition NotEqual(has_get_f, 0) ThenBlock: { is_accessor = 1 }

        JSBridge__Push(target)
        JSBridge__Push(desc_val)
        JSBridge__Push(name_ptr)
        has_set_f = JSBridge__DescFieldHas(desc_val, "set")
        name_ptr = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition NotEqual(has_set_f, 0) ThenBlock: { is_accessor = 1 }

        // Check for value (desc.value) — Has/Get via DescField (accessor Attributes)
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(desc_val)
        has_vkey = JSBridge__DescFieldHas(desc_val, "value")
        desc_val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(desc_val)
        JSBridge__Push(has_vkey)
        dv = JSBridge__DescFieldGet(desc_val, "value")
        has_vkey = JSBridge__Pop()
        desc_val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // M38: only record value — ObjSet AFTER redefine reject.
        // Early ObjSet made SameValue(cur, new) always true (cur already new).
        IfCondition EqualTo(has_vkey, 1) ThenBlock: {
            has_value = 1
            value_val = dv
        } ElseBlock: {
            // legacy: non-undefined value still counts as data desc
            dvt = JSRT_GetType(dv)
            IfCondition NotEqual(dvt, JSType.UNDEFINED) ThenBlock: {
                has_value = 1
                value_val = dv
            }
        }

        // Attribute bits: existing props merge; NEW props default all-false (ES 8.10.5)
        // M27b: use exist0 from BEFORE value/getter install — re-Has after ObjSet
        // wrongly treated brand-new props as existing (DEFAULT bits=7).
        bits = 0
        exist = exist0
        IfCondition EqualTo(exist, 1) ThenBlock: {
            bits = JSBridge__GetAttrBits(target, name_ptr)
        }

        // New data property with no value key → still create with undefined
        IfCondition EqualTo(exist, 0) ThenBlock: {
            IfCondition EqualTo(is_accessor, 0) ThenBlock: {
                IfCondition EqualTo(has_value, 0) ThenBlock: {
                    has_value = 1
                    value_val = JSRT_Undefined()
                    JSBridge__Push(target)
                    JSBridge__Push(name_ptr)
                    JSBridge__Push(desc_val)
                    JSBridge__Push(bits)
                    JSBridge__Push(has_value)
                    JSBridge__Push(value_val)
                    JSBridge__Push(is_accessor)
                    JSBridge__Push(writable_false)
                    JSRT_ObjSet(target, name_ptr, JSRT_Undefined())
                    writable_false = JSBridge__Pop()
                    is_accessor = JSBridge__Pop()
                    value_val = JSBridge__Pop()
                    has_value = JSBridge__Pop()
                    bits = JSBridge__Pop()
                    desc_val = JSBridge__Pop()
                    name_ptr = JSBridge__Pop()
                    target = JSBridge__Pop()
                }
            }
        }

        // M27a: attribute presence = HasProperty (not "Get !== undefined")
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(desc_val)
        JSBridge__Push(bits)
        JSBridge__Push(has_value)
        JSBridge__Push(value_val)
        JSBridge__Push(is_accessor)
        has_w = JSBridge__DescFieldHas(desc_val, "writable")
        IfCondition EqualTo(has_w, 1) ThenBlock: {
            wdesc = JSBridge__DescFieldGet(desc_val, "writable")
            IfCondition EqualTo(JSRT_IsTruthy(wdesc), 0) ThenBlock: {
                bits = BitwiseAnd(bits, BitwiseNot(JSAttr.W))
                writable_false = 1
            } ElseBlock: {
                bits = BitwiseOr(bits, JSAttr.W)
                writable_false = 0
            }
        }
        is_accessor = JSBridge__Pop()
        value_val = JSBridge__Pop()
        has_value = JSBridge__Pop()
        JSBridge__Pop()
        desc_val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(desc_val)
        JSBridge__Push(bits)
        JSBridge__Push(has_value)
        JSBridge__Push(value_val)
        JSBridge__Push(is_accessor)
        JSBridge__Push(writable_false)
        has_e = JSBridge__DescFieldHas(desc_val, "enumerable")
        IfCondition EqualTo(has_e, 1) ThenBlock: {
            edesc = JSBridge__DescFieldGet(desc_val, "enumerable")
            IfCondition EqualTo(JSRT_IsTruthy(edesc), 0) ThenBlock: {
                bits = BitwiseAnd(bits, BitwiseNot(JSAttr.E))
            } ElseBlock: {
                bits = BitwiseOr(bits, JSAttr.E)
            }
        }
        writable_false = JSBridge__Pop()
        is_accessor = JSBridge__Pop()
        value_val = JSBridge__Pop()
        has_value = JSBridge__Pop()
        JSBridge__Pop()
        desc_val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(desc_val)
        JSBridge__Push(bits)
        JSBridge__Push(has_value)
        JSBridge__Push(value_val)
        JSBridge__Push(is_accessor)
        JSBridge__Push(writable_false)
        has_c = JSBridge__DescFieldHas(desc_val, "configurable")
        IfCondition EqualTo(has_c, 1) ThenBlock: {
            cdesc = JSBridge__DescFieldGet(desc_val, "configurable")
            IfCondition EqualTo(JSRT_IsTruthy(cdesc), 0) ThenBlock: {
                bits = BitwiseAnd(bits, BitwiseNot(JSAttr.C))
            } ElseBlock: {
                bits = BitwiseOr(bits, JSAttr.C)
            }
        }
        writable_false = JSBridge__Pop()
        is_accessor = JSBridge__Pop()
        value_val = JSBridge__Pop()
        has_value = JSBridge__Pop()
        JSBridge__Pop()
        desc_val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // Mole 16 residual: reject incompatible redefinition of !configurable props
        // ES [[DefineOwnProperty]] 10.1.6.3 / 9.1.6.3
        IfCondition EqualTo(exist, 1) ThenBlock: {
            old_bits = JSBridge__GetAttrBits(target, name_ptr)
            // Detect existing accessor via __get_/__set_ keys
            nlen_dp = JSRT_StrLen(name_ptr)
            gbuf_c = JSRT__StrSlabAlloc(Add(nlen_dp, 8))
            sbuf_c = JSRT__StrSlabAlloc(Add(nlen_dp, 8))
            had_acc = 0
            IfCondition And(NotEqual(gbuf_c, 0), NotEqual(sbuf_c, 0)) ThenBlock: {
                WRMEM_8(gbuf_c, 0, 95)
                WRMEM_8(gbuf_c, 1, 95)
                WRMEM_8(gbuf_c, 2, 103)
                WRMEM_8(gbuf_c, 3, 101)
                WRMEM_8(gbuf_c, 4, 116)
                WRMEM_8(gbuf_c, 5, 95)
                WRMEM_8(sbuf_c, 0, 95)
                WRMEM_8(sbuf_c, 1, 95)
                WRMEM_8(sbuf_c, 2, 115)
                WRMEM_8(sbuf_c, 3, 101)
                WRMEM_8(sbuf_c, 4, 116)
                WRMEM_8(sbuf_c, 5, 95)
                gi = 0
                WhileLoop LessThan(gi, nlen_dp) {
                    u = JSRT_StrUnit(name_ptr, gi)
                    IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                    WRMEM_8(gbuf_c, Add(6, gi), u)
                    WRMEM_8(sbuf_c, Add(6, gi), u)
                    gi = Add(gi, 1)
                }
                WRMEM_8(gbuf_c, Add(6, nlen_dp), 0)
                WRMEM_8(sbuf_c, Add(6, nlen_dp), 0)
                // Undefined get/set is still an accessor. ObjHas, not function type.
                IfCondition EqualTo(JSRT_ObjHas(target, gbuf_c), 1) ThenBlock: {
                    had_acc = 1
                }
                IfCondition EqualTo(JSRT_ObjHas(target, sbuf_c), 1) ThenBlock: {
                    had_acc = 1
                }
            }
            IfCondition EqualTo(BitwiseAnd(old_bits, JSAttr.C), 0) ThenBlock: {
                reject_dp = 0
                // cannot flip configurable false → true
                IfCondition NotEqual(BitwiseAnd(bits, JSAttr.C), 0) ThenBlock: {
                    IfCondition EqualTo(has_c, 1) ThenBlock: {
                        reject_dp = 1
                    }
                }
                // cannot flip enumerable
                IfCondition EqualTo(has_e, 1) ThenBlock: {
                    old_e = BitwiseAnd(old_bits, JSAttr.E)
                    new_e = BitwiseAnd(bits, JSAttr.E)
                    IfCondition NotEqual(old_e, new_e) ThenBlock: {
                        reject_dp = 1
                    }
                }
                // accessor ↔ data conversion when !C
                IfCondition EqualTo(had_acc, 1) ThenBlock: {
                    IfCondition Or(EqualTo(has_value, 1), EqualTo(has_w, 1)) ThenBlock: {
                        reject_dp = 1
                    }
                    // !configurable accessor: get/set must be SameValue when present
                    JSBridge__Push(target)
                    JSBridge__Push(name_ptr)
                    JSBridge__Push(desc_val)
                    JSBridge__Push(value_val)
                    JSBridge__Push(bits)
                    JSBridge__Push(has_value)
                    JSBridge__Push(is_accessor)
                    JSBridge__Push(writable_false)
                    JSBridge__Push(reject_dp)
                    JSBridge__Push(had_acc)
                    JSBridge__Push(has_w)
                    JSBridge__Push(old_bits)
                    ok_acc = JSBridge__AccCompat(target, name_ptr, desc_val)
                    old_bits = JSBridge__Pop()
                    has_w = JSBridge__Pop()
                    had_acc = JSBridge__Pop()
                    reject_dp = JSBridge__Pop()
                    writable_false = JSBridge__Pop()
                    is_accessor = JSBridge__Pop()
                    has_value = JSBridge__Pop()
                    bits = JSBridge__Pop()
                    value_val = JSBridge__Pop()
                    desc_val = JSBridge__Pop()
                    name_ptr = JSBridge__Pop()
                    target = JSBridge__Pop()
                    IfCondition EqualTo(ok_acc, 0) ThenBlock: {
                        reject_dp = 1
                    }
                }
                IfCondition EqualTo(had_acc, 0) ThenBlock: {
                    IfCondition EqualTo(is_accessor, 1) ThenBlock: {
                        reject_dp = 1
                    }
                }
                // data: !W and !C cannot change value or writable false→true
                IfCondition EqualTo(had_acc, 0) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(old_bits, JSAttr.W), 0) ThenBlock: {
                        IfCondition EqualTo(has_w, 1) ThenBlock: {
                            IfCondition NotEqual(BitwiseAnd(bits, JSAttr.W), 0) ThenBlock: {
                                reject_dp = 1
                            }
                        }
                        IfCondition EqualTo(has_value, 1) ThenBlock: {
                            // compare new value to current
                            JSBridge__Push(target)
                            JSBridge__Push(name_ptr)
                            JSBridge__Push(desc_val)
                            JSBridge__Push(bits)
                            JSBridge__Push(value_val)
                            cur_v = JSRT_ObjGet(target, name_ptr)
                            value_val = JSBridge__Pop()
                            bits = JSBridge__Pop()
                            desc_val = JSBridge__Pop()
                            name_ptr = JSBridge__Pop()
                            target = JSBridge__Pop()
                            // Array index values live in element storage. ObjGet
                            // can miss them after defineProperty's ArrSet.
                            JSBridge__Push(cur_v)
                            JSBridge__Push(value_val)
                            JSBridge__Push(target)
                            JSBridge__Push(name_ptr)
                            idx_sv = JSBridge__ArrIndexOrNeg(name_ptr)
                            name_ptr = JSBridge__Pop()
                            target = JSBridge__Pop()
                            value_val = JSBridge__Pop()
                            cur_v = JSBridge__Pop()
                            IfCondition GreaterEqual(idx_sv, 0) ThenBlock: {
                                JSBridge__Push(target)
                                JSBridge__Push(cur_v)
                                JSBridge__Push(value_val)
                                JSBridge__Push(name_ptr)
                                JSBridge__Push(idx_sv)
                                tt_sv = JSRT_GetType(target)
                                idx_sv = JSBridge__Pop()
                                name_ptr = JSBridge__Pop()
                                value_val = JSBridge__Pop()
                                cur_v = JSBridge__Pop()
                                target = JSBridge__Pop()
                                IfCondition EqualTo(tt_sv, JSType.ARRAY) ThenBlock: {
                                    JSBridge__Push(target)
                                    JSBridge__Push(cur_v)
                                    JSBridge__Push(value_val)
                                    JSBridge__Push(name_ptr)
                                    JSBridge__Push(idx_sv)
                                    has_el = JSRT_ArrHas(target, idx_sv)
                                    idx_sv = JSBridge__Pop()
                                    name_ptr = JSBridge__Pop()
                                    value_val = JSBridge__Pop()
                                    cur_v = JSBridge__Pop()
                                    target = JSBridge__Pop()
                                    IfCondition EqualTo(has_el, 1) ThenBlock: {
                                        JSBridge__Push(target)
                                        JSBridge__Push(value_val)
                                        JSBridge__Push(name_ptr)
                                        JSBridge__Push(idx_sv)
                                        cur_v = JSRT_ArrGet(target, idx_sv)
                                        idx_sv = JSBridge__Pop()
                                        name_ptr = JSBridge__Pop()
                                        value_val = JSBridge__Pop()
                                        target = JSBridge__Pop()
                                    }
                                }
                            }
                            // length's [[Value]] is the exotic length. ObjGet misses it,
                            // so a same-value redefine of non-writable length threw.
                            JSBridge__Push(cur_v)
                            JSBridge__Push(value_val)
                            JSBridge__Push(target)
                            JSBridge__Push(name_ptr)
                            is_len_sv = JSRT_StrEq(name_ptr, "length")
                            JSRTStack.hold = is_len_sv
                            name_ptr = JSBridge__Pop()
                            target = JSBridge__Pop()
                            value_val = JSBridge__Pop()
                            cur_v = JSBridge__Pop()
                            is_len_sv = JSRTStack.hold
                            JSRTStack.hold = 0
                            IfCondition EqualTo(is_len_sv, 1) ThenBlock: {
                                JSBridge__Push(cur_v)
                                JSBridge__Push(value_val)
                                JSBridge__Push(name_ptr)
                                JSBridge__Push(target)
                                tt_len = JSRT_GetType(target)
                                JSRTStack.hold = tt_len
                                target = JSBridge__Pop()
                                name_ptr = JSBridge__Pop()
                                value_val = JSBridge__Pop()
                                cur_v = JSBridge__Pop()
                                tt_len = JSRTStack.hold
                                JSRTStack.hold = 0
                                IfCondition EqualTo(tt_len, JSType.ARRAY) ThenBlock: {
                                    JSBridge__Push(value_val)
                                    JSBridge__Push(name_ptr)
                                    JSBridge__Push(target)
                                    alen_sv = JSRT_ArrLen(target)
                                    cur_v = JSRT_CreateNumber(alen_sv)
                                    JSRTStack.hold2 = cur_v
                                    target = JSBridge__Pop()
                                    name_ptr = JSBridge__Pop()
                                    value_val = JSBridge__Pop()
                                    cur_v = JSRTStack.hold2
                                    JSRTStack.hold2 = 0
                                }
                            }
                            // SameValue: NaN equals NaN, and +0 does not equal -0.
                            same_v = 0
                            IfCondition EqualTo(JSBridge__SameValue(cur_v, value_val), 1) ThenBlock: {
                                same_v = 1
                            }
                            IfCondition EqualTo(same_v, 0) ThenBlock: {
                                reject_dp = 1
                            }
                        }
                    }
                }
                IfCondition EqualTo(reject_dp, 1) ThenBlock: {
                    terr_dp = JSVM_CreateTypedError("TypeError", "Cannot redefine non-configurable property")
                    JSVM__SetGlobal("__pend_exc__", terr_dp)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr_dp
                    JSVM_ThrowValue(terr_dp)
                    ReturnValue(JSRT_Undefined())
                }
            }
        }

        // Array exotic: an index >= length would grow length. Reject when
        // length is not writable (15.4.5.1 step 4.b).
        len_rej = 0
        IfCondition EqualTo(JSRT_GetType(target), JSType.ARRAY) ThenBlock: {
            JSBridge__Push(desc_val)
            JSBridge__Push(value_val)
            JSBridge__Push(bits)
            JSBridge__Push(has_value)
            JSBridge__Push(is_accessor)
            JSBridge__Push(writable_false)
            JSBridge__Push(target)
            JSBridge__Push(name_ptr)
            name_ptr = JSBridge__Pop()
            target = JSBridge__Pop()
            idx_len = JSBridge__ArrIndexOrNeg(name_ptr)
            JSBridge__Push(target)
            JSBridge__Push(name_ptr)
            JSBridge__Push(idx_len)
            cur_len = JSRT_ArrLen(target)
            idx_len = JSBridge__Pop()
            name_ptr = JSBridge__Pop()
            target = JSBridge__Pop()
            JSRTStack.hold = 0
            IfCondition And(GreaterEqual(idx_len, 0), GreaterEqual(idx_len, cur_len)) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                len_bits = JSBridge__GetAttrBits(target, "length")
                JSRTStack.hold = len_bits
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
                len_bits = JSRTStack.hold
                JSRTStack.hold = 0
                IfCondition EqualTo(BitwiseAnd(len_bits, JSAttr.W), 0) ThenBlock: {
                    JSRTStack.hold = 1
                }
            }
            writable_false = JSBridge__Pop()
            is_accessor = JSBridge__Pop()
            has_value = JSBridge__Pop()
            bits = JSBridge__Pop()
            value_val = JSBridge__Pop()
            desc_val = JSBridge__Pop()
            len_rej = JSRTStack.hold
            JSRTStack.hold = 0
        }
        IfCondition EqualTo(len_rej, 1) ThenBlock: {
            terr_dp = JSVM_CreateTypedError("TypeError", "Cannot define property: array length is not writable")
            JSVM__SetGlobal("__pend_exc__", terr_dp)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr_dp
            JSVM_ThrowValue(terr_dp)
            ReturnValue(JSRT_Undefined())
        }

        // Accessor keys after validation. A rejected redefine leaves the old kind.
        IfCondition EqualTo(is_accessor, 1) ThenBlock: {
            JSBridge__Push(target)
            JSBridge__Push(name_ptr)
            JSBridge__Push(desc_val)
            JSBridge__Push(value_val)
            JSBridge__Push(bits)
            JSBridge__Push(has_value)
            JSBridge__Push(writable_false)
            JSBridge__InstallAccFromDesc(target, name_ptr, desc_val)
            writable_false = JSBridge__Pop()
            has_value = JSBridge__Pop()
            bits = JSBridge__Pop()
            value_val = JSBridge__Pop()
            desc_val = JSBridge__Pop()
            name_ptr = JSBridge__Pop()
            target = JSBridge__Pop()
        }

        // M38: apply data value after reject (exist0 may still need create)
        // M128e7bz: Array exotic length — ObjSet would side-table; must ArrSetLen
        IfCondition EqualTo(has_value, 1) ThenBlock: {
            IfCondition EqualTo(is_accessor, 0) ThenBlock: {
                did_alen = 0
                IfCondition EqualTo(JSRT_GetType(target), JSType.ARRAY) ThenBlock: {
                    IfCondition EqualTo(JSRT_StrEq(name_ptr, "length"), 1) ThenBlock: {
                        // ToUint32 / RangeError
                        n_bits_dp = JSRT_ToNumber(value_val)
                        // ToPrimitive already threw. Keep that TypeError.
                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                            pend_tn = JSVMCall.thrown_val
                            IfCondition EqualTo(pend_tn, 0) ThenBlock: {
                                pend_tn = JSVM__GetGlobal("__pend_exc__")
                            }
                            JSVM_ThrowValue(pend_tn)
                            ReturnValue(JSRT_Undefined())
                        }
                        bad_len_dp = 0
                        IfCondition EqualTo(Float_Lt(n_bits_dp, Float_FromInt(0)), 1) ThenBlock: {
                            bad_len_dp = 1
                        }
                        IfCondition EqualTo(Float_Lt(n_bits_dp, Float_FromInt(4294967296)), 0) ThenBlock: {
                            bad_len_dp = 1
                        }
                        ni_len_dp = Float_ToInt(n_bits_dp)
                        IfCondition EqualTo(Float_Eq(Float_FromInt(ni_len_dp), n_bits_dp), 0) ThenBlock: {
                            bad_len_dp = 1
                        }
                        IfCondition EqualTo(bad_len_dp, 1) ThenBlock: {
                            terr_dp = JSVM_CreateTypedError("RangeError", "Invalid array length")
                            JSVM__SetGlobal("__pend_exc__", terr_dp)
                            JSVMCall.exc_prop = 1
                            JSVMCall.thrown_val = terr_dp
                            JSVM_ThrowValue(terr_dp)
                            ReturnValue(JSRT_Undefined())
                        }
                        // length is !W already → cannot change value (unless same)
                        old_bits_len = JSBridge__GetAttrBits(target, name_ptr)
                        IfCondition EqualTo(BitwiseAnd(old_bits_len, JSAttr.W), 0) ThenBlock: {
                            // same length OK
                            cur_len_dp = JSRT_ArrLen(target)
                            IfCondition NotEqual(cur_len_dp, ni_len_dp) ThenBlock: {
                                terr_dp = JSVM_CreateTypedError("TypeError", "Cannot redefine non-writable length")
                                JSVM__SetGlobal("__pend_exc__", terr_dp)
                                JSVMCall.exc_prop = 1
                                JSVMCall.thrown_val = terr_dp
                                JSVM_ThrowValue(terr_dp)
                                ReturnValue(JSRT_Undefined())
                            }
                        }
                        rc_alen = JSRT_ArrSetLen(target, ni_len_dp)
                        IfCondition EqualTo(rc_alen, 0) ThenBlock: {
                            // Shrink stopped at the non-configurable index.
                            // If desc set [[Writable]] false, that bit sticks
                            // before the TypeError (15.4.5.1 step 3.l.iii).
                            bits = BitwiseAnd(bits, JSAttr.W)
                            JSBridge__Push(target)
                            JSBridge__Push(name_ptr)
                            JSBridge__Push(bits)
                            JSBridge__SetAttrBits(target, name_ptr, bits)
                            bits = JSBridge__Pop()
                            name_ptr = JSBridge__Pop()
                            target = JSBridge__Pop()
                            terr_dp = JSVM_CreateTypedError("TypeError", "Cannot delete non-configurable array element")
                            JSVM__SetGlobal("__pend_exc__", terr_dp)
                            JSVMCall.exc_prop = 1
                            JSVMCall.thrown_val = terr_dp
                            JSVM_ThrowValue(terr_dp)
                            ReturnValue(JSRT_Undefined())
                        }
                        // length attrs: always !E !C; W from descriptor merge (bits)
                        // Force !E !C on length regardless of desc (ES Array exotic)
                        bits = BitwiseAnd(bits, JSAttr.W)
                        did_alen = 1
                    }
                }
                IfCondition EqualTo(did_alen, 0) ThenBlock: {
                    JSBridge__Push(target)
                    JSBridge__Push(name_ptr)
                    JSBridge__Push(has_value)
                    JSBridge__Push(value_val)
                    JSBridge__Push(is_accessor)
                    JSBridge__Push(writable_false)
                    JSBridge__Push(bits)
                    JSRT_ObjSet(target, name_ptr, value_val)
                    bits = JSBridge__Pop()
                    writable_false = JSBridge__Pop()
                    is_accessor = JSBridge__Pop()
                    value_val = JSBridge__Pop()
                    has_value = JSBridge__Pop()
                    name_ptr = JSBridge__Pop()
                    target = JSBridge__Pop()
                }
            }
        }

        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(has_value)
        JSBridge__Push(value_val)
        JSBridge__Push(is_accessor)
        JSBridge__Push(writable_false)
        JSBridge__SetAttrBits(target, name_ptr, bits)
        writable_false = JSBridge__Pop()
        is_accessor = JSBridge__Pop()
        value_val = JSBridge__Pop()
        has_value = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // Accessor: keep undefined data key so hasOwnProperty sees the property
        // (GET_PROP prefers __get_<name>, so the placeholder is never read).
        // M27a: was ObjDelete — broke hasOwn for get:undefined / set-only accessors.
        IfCondition EqualTo(is_accessor, 1) ThenBlock: {
            JSBridge__Push(target)
            JSBridge__Push(name_ptr)
            JSBridge__Push(has_value)
            JSBridge__Push(value_val)
            JSBridge__Push(writable_false)
            JSBridge__Push(is_accessor)
            JSRT_ObjSet(target, name_ptr, JSRT_Undefined())
            is_accessor = JSBridge__Pop()
            writable_false = JSBridge__Pop()
            value_val = JSBridge__Pop()
            has_value = JSBridge__Pop()
            name_ptr = JSBridge__Pop()
            target = JSBridge__Pop()
        }

        // M33: data descriptor replaces accessor — drop own __get_/__set_ keys
        // so GET_PROP/gOPD do not keep seeing the old getter after redefine.
        IfCondition EqualTo(is_accessor, 0) ThenBlock: {
            IfCondition Or(EqualTo(has_value, 1), EqualTo(has_w, 1)) ThenBlock: {
                nlen_clr = JSRT_StrLen(name_ptr)
                gbuf_clr = JSRT__StrSlabAlloc(Add(nlen_clr, 8))
                sbuf_clr = JSRT__StrSlabAlloc(Add(nlen_clr, 8))
                IfCondition And(NotEqual(gbuf_clr, 0), NotEqual(sbuf_clr, 0)) ThenBlock: {
                    WRMEM_8(gbuf_clr, 0, 95)
                    WRMEM_8(gbuf_clr, 1, 95)
                    WRMEM_8(gbuf_clr, 2, 103)
                    WRMEM_8(gbuf_clr, 3, 101)
                    WRMEM_8(gbuf_clr, 4, 116)
                    WRMEM_8(gbuf_clr, 5, 95)
                    WRMEM_8(sbuf_clr, 0, 95)
                    WRMEM_8(sbuf_clr, 1, 95)
                    WRMEM_8(sbuf_clr, 2, 115)
                    WRMEM_8(sbuf_clr, 3, 101)
                    WRMEM_8(sbuf_clr, 4, 116)
                    WRMEM_8(sbuf_clr, 5, 95)
                    gi = 0
                    WhileLoop LessThan(gi, nlen_clr) {
                        u = JSRT_StrUnit(name_ptr, gi)
                        IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                        WRMEM_8(gbuf_clr, Add(6, gi), u)
                        WRMEM_8(sbuf_clr, Add(6, gi), u)
                        gi = Add(gi, 1)
                    }
                    WRMEM_8(gbuf_clr, Add(6, nlen_clr), 0)
                    WRMEM_8(sbuf_clr, Add(6, nlen_clr), 0)
                    JSBridge__Push(target)
                    JSBridge__Push(name_ptr)
                    JSBridge__Push(sbuf_clr)
                    IfCondition EqualTo(JSRT_ObjHas(target, gbuf_clr), 1) ThenBlock: {
                        JSRT_ObjDelete(target, gbuf_clr)
                    }
                    sbuf_clr = JSBridge__Pop()
                    name_ptr = JSBridge__Pop()
                    target = JSBridge__Pop()
                    JSBridge__Push(target)
                    JSBridge__Push(name_ptr)
                    IfCondition EqualTo(JSRT_ObjHas(target, sbuf_clr), 1) ThenBlock: {
                        JSRT_ObjDelete(target, sbuf_clr)
                    }
                    name_ptr = JSBridge__Pop()
                    target = JSBridge__Pop()
                }
            }
        }

        // Mole 12: mapped arguments — value sync + unmap on !writable / accessor
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(has_value)
        JSBridge__Push(value_val)
        JSBridge__Push(writable_false)
        JSBridge__Push(is_accessor)
        acc2 = is_accessor
        nw2 = writable_false
        vv2 = value_val
        hv2 = has_value
        np2 = name_ptr
        tg2 = target
        JSVM_ArgsAfterDefineProperty(tg2, np2, hv2, vv2, nw2, acc2)
        is_accessor = JSBridge__Pop()
        writable_false = JSBridge__Pop()
        value_val = JSBridge__Pop()
        has_value = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // M102: resync ALL mapped formals from arguments object after defineProperty
        IfCondition EqualTo(JSVM_IsArgumentsObj(target), 1) ThenBlock: {
            mi = 0
            WhileLoop LessThan(mi, 16) {
                IfCondition EqualTo(JSVM_ArgsIsMapped(target, mi), 1) ThenBlock: {
                    kbuf = JSVM__ArgIndexKey(mi)
                    IfCondition NotEqual(kbuf, 0) ThenBlock: {
                        JSBridge__Push(target)
                        JSBridge__Push(name_ptr)
                        av = JSRT_ObjGet(target, kbuf)
                        name_ptr = JSBridge__Pop()
                        target = JSBridge__Pop()
                        JSVM_ArgsSetFormalLocal(target, mi, av)
                    }
                }
                mi = Add(mi, 1)
            }
        }

        // Return the object
        ReturnValue(target)
    }
}


// Object.keys(obj) — return array of own enumerable string keys
// M128e6y: exclude engine symbol mangled keys "@@sN" (ES: no symbols in Object.keys)
Function.JSBridge__NObjKeys {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        target = RDMEM_64(save_args)
        // M128e7d5: TypedArray — enumerable keys = integer indexes (+ user enums)
        IfCondition EqualTo(JSVM_IsTypedArray(target), 1) ThenBlock: {
            // Same as OwnPropertyKeys for our model (indexes enumerable; internals hidden)
            ReturnValue(JSBridge__NGetOwnPropNames(save_args, save_argc))
        }
        // Filter out __get_/__set_/… (inside ObjKeys) and symbol keys @@sN.
        // Array indexes honor stored !enumerable; ObjKeys lists every element.
        raw = JSBridge__EnumOwnKeys(target)
        n = JSRT_ArrLen(raw)
        filtered = JSRT_CreateArray()
        fi = 0
        WhileLoop LessThan(fi, n) {
            JSBridge__Push(raw)
            JSBridge__Push(filtered)
            JSBridge__Push(fi)
            JSBridge__Push(n)
            ksv = JSRT_ArrGet(raw, fi)
            n = JSBridge__Pop()
            fi = JSBridge__Pop()
            filtered = JSBridge__Pop()
            raw = JSBridge__Pop()
            is_sym = 0
            IfCondition EqualTo(JSRT_GetType(ksv), JSType.STRING) ThenBlock: {
                kp = JSRT_GetPayload(ksv)
                IfCondition NotEqual(kp, 0) ThenBlock: {
                    IfCondition And(EqualTo(JSRT_StrUnit(kp, 0), 64), And(EqualTo(JSRT_StrUnit(kp, 1), 64), EqualTo(JSRT_StrUnit(kp, 2), 115))) ThenBlock: {
                        is_sym = 1
                    }
                }
            }
            IfCondition EqualTo(is_sym, 0) ThenBlock: {
                JSBridge__Push(raw)
                JSBridge__Push(filtered)
                JSBridge__Push(fi)
                JSBridge__Push(n)
                JSRT_ArrPush(filtered, ksv)
                n = JSBridge__Pop()
                fi = JSBridge__Pop()
                filtered = JSBridge__Pop()
                raw = JSBridge__Pop()
            }
            fi = Add(fi, 1)
        }
        ReturnValue(filtered)
    }
}


// Object.getOwnPropertyDescriptors(obj) — M27c: map name → descriptor
Function.JSBridge__NGetOwnPropDescs {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateObject())
        }
        target = RDMEM_64(args)
        tt = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.getOwnPropertyDescriptors called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        JSBridge__Push(target)
        names = JSBridge__NGetOwnPropNames(args, argc)
        target = JSBridge__Pop()
        out = JSRT_CreateObject()
        nlen = JSRT_ArrLen(names)
        ni = 0
        WhileLoop LessThan(ni, nlen) {
            JSBridge__Push(target)
            JSBridge__Push(names)
            JSBridge__Push(out)
            JSBridge__Push(ni)
            ksv = JSRT_ArrGet(names, ni)
            ni = JSBridge__Pop()
            out = JSBridge__Pop()
            names = JSBridge__Pop()
            target = JSBridge__Pop()
            // gOPD(target, key)
            ab = JSVMCallBuf.buf
            WRMEM_64(ab, target)
            WRMEM_64(ab, 8, ksv)
            JSBridge__Push(target)
            JSBridge__Push(names)
            JSBridge__Push(out)
            JSBridge__Push(ni)
            JSBridge__Push(ksv)
            desc = JSBridge__NGetOwnPropDesc(ab, 2)
            ksv = JSBridge__Pop()
            ni = JSBridge__Pop()
            out = JSBridge__Pop()
            names = JSBridge__Pop()
            target = JSBridge__Pop()
            IfCondition NotEqual(JSRT_GetType(desc), JSType.UNDEFINED) ThenBlock: {
                kp = JSRT_GetPayload(ksv)
                JSBridge__Push(target)
                JSBridge__Push(names)
                JSBridge__Push(out)
                JSBridge__Push(ni)
                JSRT_ObjSet(out, kp, desc)
                ni = JSBridge__Pop()
                out = JSBridge__Pop()
                names = JSBridge__Pop()
                target = JSBridge__Pop()
            }
            ni = Add(ni, 1)
        }
        ReturnValue(out)
    }
}


// Object.getOwnPropertyNames(obj) — M27c: own keys including non-enumerable
Function.JSBridge__NGetOwnPropNames {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateArray())
        }
        target = RDMEM_64(args)
        tt = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.getOwnPropertyNames called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // ToObject-ish: primitives → empty or string exotic
        IfCondition EqualTo(tt, JSType.STRING) ThenBlock: {
            // indices + length (M31a code-unit length)
            sp = JSRT_GetPayload(target)
            slen = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { slen = JSRT_StrLen(sp) }
            result = JSRT_CreateArray()
            ai = 0
            WhileLoop LessThan(ai, slen) {
                istr = JSRT__IntToStr(ai)
                JSRT_ArrPush(result, JSRT_CreateString(istr))
                ai = Add(ai, 1)
            }
            JSRT_ArrPush(result, JSRT_CreateString("length"))
            ReturnValue(result)
        }
        IfCondition And(NotEqual(tt, JSType.OBJECT), NotEqual(tt, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(tt, JSType.ARRAY) ThenBlock: {
                // number/boolean box: empty own names
                ReturnValue(JSRT_CreateArray())
            }
        }
        // M128e7d5: TypedArray [[OwnPropertyKeys]] — integer indexes first,
        // then other own string keys (exclude internal slots we store as own data)
        IfCondition EqualTo(JSVM_IsTypedArray(target), 1) ThenBlock: {
            // M128e7du: detached → no integer index keys (for-in / OwnPropertyKeys)
            tbuf_ok = JSRT_ObjGet(target, "__ta_buf__")
            IfCondition EqualTo(JSVM_IsDetachedBuffer(tbuf_ok), 1) ThenBlock: {
                tlen = 0
            } ElseBlock: {
                tlen = JSVM_TA_Length(target)
            }
            result = JSRT_CreateArray()
            ai = 0
            WhileLoop LessThan(ai, tlen) {
                JSBridge__Push(result)
                JSBridge__Push(ai)
                JSBridge__Push(tlen)
                JSBridge__Push(target)
                istr = JSRT__IntToStr(ai)
                // slab-copy so prop table doesn't alias static IntToStr buf
                klen = StringLength(istr)
                kptr = JSRT__StrSlabAlloc(Add(klen, 1))
                IfCondition NotEqual(kptr, 0) ThenBlock: {
                    MemoryCopy(kptr, istr, Add(klen, 1))
                    JSRT_ArrPush(result, JSRT_CreateString(kptr))
                } ElseBlock: {
                    JSRT_ArrPush(result, JSRT_CreateString(istr))
                }
                target = JSBridge__Pop()
                tlen = JSBridge__Pop()
                ai = JSBridge__Pop()
                result = JSBridge__Pop()
                ai = Add(ai, 1)
            }
            // append ordinary own keys that are not integer indexes / internals
            JSBridge__Push(result)
            JSBridge__Push(target)
            raw = JSRT_ObjOwnNames(target)
            target = JSBridge__Pop()
            result = JSBridge__Pop()
            rlen = JSRT_ArrLen(raw)
            ri = 0
            WhileLoop LessThan(ri, rlen) {
                JSBridge__Push(result)
                JSBridge__Push(raw)
                JSBridge__Push(ri)
                JSBridge__Push(rlen)
                JSBridge__Push(target)
                ksv = JSRT_ArrGet(raw, ri)
                kp = JSRT_GetPayload(ksv)
                // skip internal markers
                skip = 0
                IfCondition EqualTo(JSRT_StrEq(kp, "__proto__"), 1) ThenBlock: { skip = 1 }
                IfCondition EqualTo(JSRT_StrEq(kp, "__class__"), 1) ThenBlock: { skip = 1 }
                IfCondition EqualTo(JSRT_StrEq(kp, "__ta_kind__"), 1) ThenBlock: { skip = 1 }
                IfCondition EqualTo(JSRT_StrEq(kp, "__ta_buf__"), 1) ThenBlock: { skip = 1 }
                IfCondition EqualTo(JSRT_StrEq(kp, "__ta_off__"), 1) ThenBlock: { skip = 1 }
                IfCondition EqualTo(JSRT_StrEq(kp, "__ta_len__"), 1) ThenBlock: { skip = 1 }
                IfCondition EqualTo(JSRT_StrEq(kp, "__ta_es__"), 1) ThenBlock: { skip = 1 }
                // engine stamps these as own; ES uses internal slots + proto accessors
                IfCondition EqualTo(JSRT_StrEq(kp, "buffer"), 1) ThenBlock: { skip = 1 }
                IfCondition EqualTo(JSRT_StrEq(kp, "byteOffset"), 1) ThenBlock: { skip = 1 }
                IfCondition EqualTo(JSRT_StrEq(kp, "byteLength"), 1) ThenBlock: { skip = 1 }
                IfCondition EqualTo(JSRT_StrEq(kp, "length"), 1) ThenBlock: { skip = 1 }
                // skip integer-index strings (already listed)
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    vi = JSVM_TA_ParseCanonicalIndex(kp)
                    IfCondition NotEqual(vi, -2) ThenBlock: { skip = 1 }
                }
                target = JSBridge__Pop()
                rlen = JSBridge__Pop()
                ri = JSBridge__Pop()
                raw = JSBridge__Pop()
                result = JSBridge__Pop()
                IfCondition EqualTo(skip, 0) ThenBlock: {
                    JSRT_ArrPush(result, ksv)
                }
                ri = Add(ri, 1)
            }
            ReturnValue(result)
        }
        ReturnValue(JSRT_ObjOwnNames(target))
    }
}
