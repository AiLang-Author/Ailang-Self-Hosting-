// Library.JSBridgePart4.ailang — JSBridge functions
// Moved out of Library.JSBridge.ailang. Pools stay in the parent.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.


// Object.create(proto [, properties]) — M27b: +Properties via defineProperties
Function.JSBridge__NObjCreate {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateObject())
        }
        proto = RDMEM_64(save_args)
        // ES: Type(O) must be Object or Null
        pt = JSRT_GetType(proto)
        IfCondition NotEqual(pt, JSType.NULL) ThenBlock: {
            IfCondition And(NotEqual(pt, JSType.OBJECT), NotEqual(pt, JSType.FUNCTION)) ThenBlock: {
                IfCondition NotEqual(pt, JSType.ARRAY) ThenBlock: {
                    terr = JSVM_CreateTypedError("TypeError", "Object prototype may only be an Object or null")
                    JSVM__SetGlobal("__pend_exc__", terr)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr
                    JSVM_ThrowValue(terr)
                    ReturnValue(JSRT_Undefined())
                }
            }
        }
        JSBridge__Push(proto)
        JSBridge__Push(save_args)
        JSBridge__Push(save_argc)
        obj = JSRT_CreateObject()
        save_argc = JSBridge__Pop()
        save_args = JSBridge__Pop()
        proto = JSBridge__Pop()
        pt = JSRT_GetType(proto)
        // null → null prototype; object/function/array → link
        IfCondition EqualTo(pt, JSType.NULL) ThenBlock: {
            JSRT_ObjSet(obj, "__proto__", JSRTState.null_val)
        }
        IfCondition Or(Or(EqualTo(pt, JSType.OBJECT), EqualTo(pt, JSType.FUNCTION)), EqualTo(pt, JSType.ARRAY)) ThenBlock: {
            JSRT_ObjSet(obj, "__proto__", proto)
        }
        // Optional Properties bag → Object.defineProperties(obj, Properties)
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            props = RDMEM_64(save_args, 8)
            ptype = JSRT_GetType(props)
            // undefined/missing Properties: skip (only one arg used)
            IfCondition And(NotEqual(ptype, JSType.UNDEFINED), NotEqual(props, 0)) ThenBlock: {
                ab = JSVMCallBuf.buf
                WRMEM_64(ab, obj)
                WRMEM_64(ab, 8, props)
                JSBridge__Push(obj)
                JSBridge__NDefineProperties(ab, 2)
                obj = JSBridge__Pop()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
            }
        }
        ReturnValue(obj)
    }
}


// 1 if a pending abrupt completion was rethrown.
Function.JSBridge__TakeAbrupt {
    Output: Integer
    Body: {
        IfCondition EqualTo(JSVMCall.exc_prop, 0) ThenBlock: {
            ReturnValue(0)
        }
        pend = JSVMCall.thrown_val
        IfCondition EqualTo(pend, 0) ThenBlock: { pend = JSVMState.exc_val }
        IfCondition EqualTo(pend, 0) ThenBlock: { pend = JSVM__GetGlobal("__pend_exc__") }
        JSVMCall.exc_prop = 0
        JSVMCall.thrown_val = 0
        JSVMState.exc_val = 0
        IfCondition And(NotEqual(pend, 0), NotEqual(pend, JSRTState.undef_val)) ThenBlock: {
            JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
            JSVM_ThrowValue(pend)
        }
        ReturnValue(1)
    }
}

Function.JSBridge__ThrowNotCallable {
    Output: Address
    Body: {
        terr = JSVM_CreateTypedError("TypeError", "is not a function")
        JSVM__SetGlobal("__pend_exc__", terr)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = terr
        JSVM_ThrowValue(terr)
        ReturnValue(JSRT_Undefined())
    }
}

// Function.prototype.call(thisArg, ...args)
Function.JSBridge__NFuncCall {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        target = JSVM_GetGlobal("this")
        IfCondition NotEqual(JSRT_GetType(target), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSBridge__ThrowNotCallable())
        }
        this_arg = JSRT_Undefined()
        call_argc = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            this_arg = RDMEM_64(save_args)
            call_argc = Subtract(save_argc, 1)
        }
        // Build arg buffer: skip thisArg. Use getter_buf as scratch — cannot
        // MemoryCopy overlapping regions of CallBuf.buf (thisArg at [0]).
        ab = JSVMCallBuf.buf
        IfCondition GreaterThan(call_argc, 0) ThenBlock: {
            tmp_ab = JSVMCallBuf.getter_buf
            MemoryCopy(tmp_ab, Add(save_args, 8), Multiply(call_argc, 8))
            MemoryCopy(ab, tmp_ab, Multiply(call_argc, 8))
        }
        JSVM__SetGlobal("this", this_arg)
        // M29d/k.11: stamp env for native methods (FuncGetEnv = thisArg).
        // Do NOT overwrite JS closure env (descriptor+40) — breaks free vars
        // and interferes with private brand home resolution for .call/.apply.
        fenv = JSRT_FuncGetEnv(target)
        fbc = JSRT_FuncGetBC(target)
        IfCondition Or(LessThan(fbc, 0), EqualTo(fenv, 71)) ThenBlock: {
            // native (bc < 0) or leave generators alone; natives need env stamp
            IfCondition LessThan(fbc, 0) ThenBlock: {
                JSRT_FuncSetEnv(target, this_arg)
            }
        }
        ret = JSVM__CallFunc(target, ab, call_argc)
        ReturnValue(ret)
    }
}


// Function.prototype.apply(thisArg, argArray)
Function.JSBridge__NFuncApply {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        target = JSVM_GetGlobal("this")
        IfCondition NotEqual(JSRT_GetType(target), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSBridge__ThrowNotCallable())
        }
        this_arg = JSRT_Undefined()
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            this_arg = RDMEM_64(save_args)
        }
        call_argc = 0
        ab = JSVMCallBuf.buf
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            arr = RDMEM_64(save_args, 8)
            at = JSRT_GetType(arr)
            skip_arr = 0
            IfCondition Or(EqualTo(at, JSType.NULL), EqualTo(at, JSType.UNDEFINED)) ThenBlock: { skip_arr = 1 }
            IfCondition EqualTo(arr, 0) ThenBlock: { skip_arr = 1 }
            IfCondition EqualTo(skip_arr, 0) ThenBlock: {
                is_obj = 0
                IfCondition Or(EqualTo(at, JSType.OBJECT), Or(EqualTo(at, JSType.ARRAY), EqualTo(at, JSType.FUNCTION))) ThenBlock: { is_obj = 1 }
                IfCondition EqualTo(JSVM_IsPrimSymbol(arr), 1) ThenBlock: { is_obj = 0 }
                IfCondition EqualTo(is_obj, 0) ThenBlock: {
                    terr_al = JSVM_CreateTypedError("TypeError", "CreateListFromArrayLike called on non-object")
                    JSVM__SetGlobal("__pend_exc__", terr_al)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = terr_al
                    JSVM_ThrowValue(terr_al)
                    ReturnValue(JSRT_Undefined())
                }
                IfCondition EqualTo(at, JSType.ARRAY) ThenBlock: {
                    call_argc = JSRT_ArrLen(arr)
                    IfCondition GreaterThan(call_argc, 64) ThenBlock: { call_argc = 64 }
                    ai = 0
                    WhileLoop LessThan(ai, call_argc) {
                        WRMEM_64(ab, Multiply(ai, 8), JSRT_ArrGet(arr, ai))
                        ai = Add(ai, 1)
                    }
                } ElseBlock: {
                    // Array-like: Get("length") then Get(index). Cap 64.
                    JSBridge__Push(target)
                    JSBridge__Push(this_arg)
                    JSBridge__Push(arr)
                    len_v = JSVM__ObjGetAcc(arr, "length")
                    arr = JSBridge__Pop()
                    this_arg = JSBridge__Pop()
                    target = JSBridge__Pop()
                    JSBridge__Push(target)
                    JSBridge__Push(this_arg)
                    JSBridge__Push(arr)
                    JSBridge__Push(len_v)
                    abrupt_l = JSBridge__TakeAbrupt()
                    len_v = JSBridge__Pop()
                    arr = JSBridge__Pop()
                    this_arg = JSBridge__Pop()
                    target = JSBridge__Pop()
                    IfCondition EqualTo(abrupt_l, 1) ThenBlock: {
                        ReturnValue(JSRT_Undefined())
                    }
                    JSBridge__Push(target)
                    JSBridge__Push(this_arg)
                    JSBridge__Push(arr)
                    nbits = JSRT_ToNumber(len_v)
                    arr = JSBridge__Pop()
                    this_arg = JSBridge__Pop()
                    target = JSBridge__Pop()
                    JSBridge__Push(target)
                    JSBridge__Push(this_arg)
                    JSBridge__Push(arr)
                    JSBridge__Push(nbits)
                    abrupt_n = JSBridge__TakeAbrupt()
                    nbits = JSBridge__Pop()
                    arr = JSBridge__Pop()
                    this_arg = JSBridge__Pop()
                    target = JSBridge__Pop()
                    IfCondition EqualTo(abrupt_n, 1) ThenBlock: {
                        ReturnValue(JSRT_Undefined())
                    }
                    alen = 0
                    IfCondition EqualTo(Float_Ne(nbits, nbits), 1) ThenBlock: {
                        alen = 0
                    } ElseBlock: {
                        IfCondition EqualTo(nbits, 9218868437227405312) ThenBlock: {
                            alen = 64
                        } ElseBlock: {
                            IfCondition Or(EqualTo(nbits, 18442240474082181120), EqualTo(nbits, -4503599627370496)) ThenBlock: {
                                alen = 0
                            } ElseBlock: {
                                trb = Float_Trunc(nbits)
                                alen = Float_ToInt(trb)
                                IfCondition LessThan(alen, 0) ThenBlock: { alen = 0 }
                            }
                        }
                    }
                    IfCondition GreaterThan(alen, 64) ThenBlock: { alen = 64 }
                    snap = JSRT_CreateArray()
                    ai = 0
                    WhileLoop LessThan(ai, alen) {
                        JSBridge__Push(target)
                        JSBridge__Push(this_arg)
                        JSBridge__Push(arr)
                        JSBridge__Push(snap)
                        JSBridge__Push(ai)
                        JSBridge__Push(alen)
                        kix = JSVM__ArgIndexKey(ai)
                        alen = JSBridge__Pop()
                        ai = JSBridge__Pop()
                        snap = JSBridge__Pop()
                        arr = JSBridge__Pop()
                        this_arg = JSBridge__Pop()
                        target = JSBridge__Pop()
                        JSBridge__Push(target)
                        JSBridge__Push(this_arg)
                        JSBridge__Push(arr)
                        JSBridge__Push(snap)
                        JSBridge__Push(ai)
                        JSBridge__Push(alen)
                        JSBridge__Push(kix)
                        ev = JSVM__ObjGetAcc(arr, kix)
                        kix = JSBridge__Pop()
                        alen = JSBridge__Pop()
                        ai = JSBridge__Pop()
                        snap = JSBridge__Pop()
                        arr = JSBridge__Pop()
                        this_arg = JSBridge__Pop()
                        target = JSBridge__Pop()
                        JSBridge__Push(target)
                        JSBridge__Push(this_arg)
                        JSBridge__Push(arr)
                        JSBridge__Push(snap)
                        JSBridge__Push(ai)
                        JSBridge__Push(alen)
                        JSBridge__Push(ev)
                        abrupt_i = JSBridge__TakeAbrupt()
                        ev = JSBridge__Pop()
                        alen = JSBridge__Pop()
                        ai = JSBridge__Pop()
                        snap = JSBridge__Pop()
                        arr = JSBridge__Pop()
                        this_arg = JSBridge__Pop()
                        target = JSBridge__Pop()
                        IfCondition EqualTo(abrupt_i, 1) ThenBlock: {
                            ReturnValue(JSRT_Undefined())
                        }
                        JSBridge__Push(target)
                        JSBridge__Push(this_arg)
                        JSBridge__Push(arr)
                        JSBridge__Push(snap)
                        JSBridge__Push(ai)
                        JSBridge__Push(alen)
                        JSRT_ArrPush(snap, ev)
                        alen = JSBridge__Pop()
                        ai = JSBridge__Pop()
                        snap = JSBridge__Pop()
                        arr = JSBridge__Pop()
                        this_arg = JSBridge__Pop()
                        target = JSBridge__Pop()
                        ai = Add(ai, 1)
                    }
                    ab = JSVMCallBuf.buf
                    call_argc = JSRT_ArrLen(snap)
                    ai = 0
                    WhileLoop LessThan(ai, call_argc) {
                        WRMEM_64(ab, Multiply(ai, 8), JSRT_ArrGet(snap, ai))
                        ai = Add(ai, 1)
                    }
                }
            }
        }
        ab = JSVMCallBuf.buf
        JSVM__SetGlobal("this", this_arg)
        // M29d/k.11: only stamp env for natives (see NFuncCall)
        fbc2 = JSRT_FuncGetBC(target)
        IfCondition LessThan(fbc2, 0) ThenBlock: {
            JSRT_FuncSetEnv(target, this_arg)
        }
        ret = JSVM__CallFunc(target, ab, call_argc)
        ReturnValue(ret)
    }
}


// Function.prototype.bind(thisArg, ...partialArgs)
Function.JSBridge__NFuncBind {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        target = JSVM_GetGlobal("this")
        IfCondition NotEqual(JSRT_GetType(target), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSBridge__ThrowNotCallable())
        }
        this_arg = JSRT_Undefined()
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            this_arg = RDMEM_64(save_args)
        }
        // Bound state object
        // M104: push/pop must restore in reverse order (this_arg, target, rec).
        // Previous code assigned target=Pop() first and swapped target↔this_arg,
        // so __bthis__ stored the function and bound calls returned the target.
        rec = JSRT_CreateObject()
        JSBridge__Push(rec)
        JSBridge__Push(target)
        JSBridge__Push(this_arg)
        JSRT_ObjSet(rec, "__bt__", target)
        this_arg = JSBridge__Pop()
        target = JSBridge__Pop()
        rec = JSBridge__Pop()
        JSBridge__Push(rec)
        JSBridge__Push(target)
        JSRT_ObjSet(rec, "__bthis__", this_arg)
        target = JSBridge__Pop()
        rec = JSBridge__Pop()
        // Partial args array
        parr = JSRT_CreateArray()
        pi = 1
        WhileLoop LessThan(pi, save_argc) {
            JSRT_ArrPush(parr, RDMEM_64(save_args, Multiply(pi, 8)))
            pi = Add(pi, 1)
        }
        JSBridge__Push(rec)
        JSBridge__Push(target)
        JSRT_ObjSet(rec, "__bargs__", parr)
        target = JSBridge__Pop()
        rec = JSBridge__Pop()
        // Bound function: native FUNC_BOUND, env = rec
        plen = Subtract(save_argc, 1)
        IfCondition LessThan(plen, 0) ThenBlock: { plen = 0 }
        JSBridge__Push(target)
        JSBridge__Push(rec)
        JSBridge__Push(plen)
        bf = JSBridge__CreateNativeFunc(JSNativeID.FUNC_BOUND, "bound", 0)
        plen = JSBridge__Pop()
        rec = JSBridge__Pop()
        target = JSBridge__Pop()
        JSBridge__Push(bf)
        JSBridge__Push(target)
        JSBridge__Push(plen)
        JSRT_FuncSetEnv(bf, rec)
        plen = JSBridge__Pop()
        target = JSBridge__Pop()
        bf = JSBridge__Pop()
        // [[Prototype]] = target.[[GetPrototypeOf]]()
        tproto = 0
        tfd = JSRT_GetPayload(target)
        IfCondition NotEqual(tfd, 0) ThenBlock: {
            tpt = RDMEM_64(tfd, 64)
            IfCondition NotEqual(tpt, 0) ThenBlock: {
                tv = PropTable_Lookup(tpt, "__proto__")
                IfCondition NotEqual(tv, -1) ThenBlock: { tproto = tv }
            }
        }
        IfCondition EqualTo(tproto, 0) ThenBlock: { tproto = JSRTState.function_proto }
        IfCondition NotEqual(tproto, 0) ThenBlock: {
            JSBridge__Push(bf)
            JSBridge__Push(target)
            JSBridge__Push(plen)
            JSRT_FuncPropSet(bf, "__proto__", tproto)
            plen = JSBridge__Pop()
            target = JSBridge__Pop()
            bf = JSBridge__Pop()
        }
        // length: HasOwn length, else 0. ToInteger. +Infinity stays +Infinity.
        blen = 0
        inf_len = 0
        inf_v = 0
        JSBridge__Push(bf)
        JSBridge__Push(target)
        JSBridge__Push(plen)
        has_len = JSRT_ObjHas(target, "length")
        plen = JSBridge__Pop()
        target = JSBridge__Pop()
        bf = JSBridge__Pop()
        IfCondition EqualTo(has_len, 1) ThenBlock: {
            JSBridge__Push(bf)
            JSBridge__Push(target)
            JSBridge__Push(plen)
            tl_v = JSVM__ObjGetAcc(target, "length")
            plen = JSBridge__Pop()
            target = JSBridge__Pop()
            bf = JSBridge__Pop()
            JSBridge__Push(bf)
            JSBridge__Push(target)
            JSBridge__Push(plen)
            JSBridge__Push(tl_v)
            abrupt_bl = JSBridge__TakeAbrupt()
            tl_v = JSBridge__Pop()
            plen = JSBridge__Pop()
            target = JSBridge__Pop()
            bf = JSBridge__Pop()
            IfCondition EqualTo(abrupt_bl, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            IfCondition EqualTo(JSRT_GetType(tl_v), JSType.NUMBER) ThenBlock: {
                nbits = JSRT_GetPayload(tl_v)
                IfCondition EqualTo(Float_Ne(nbits, nbits), 1) ThenBlock: {
                    blen = 0
                } ElseBlock: {
                    IfCondition EqualTo(nbits, 9218868437227405312) ThenBlock: {
                        inf_len = 1
                        inf_v = tl_v
                    } ElseBlock: {
                        IfCondition Or(EqualTo(nbits, 18442240474082181120), EqualTo(nbits, -4503599627370496)) ThenBlock: {
                            blen = 0
                        } ElseBlock: {
                            trb = Float_Trunc(nbits)
                            blen = Float_ToInt(trb)
                            IfCondition LessThan(blen, 0) ThenBlock: { blen = 0 }
                            blen = Subtract(blen, plen)
                            IfCondition LessThan(blen, 0) ThenBlock: { blen = 0 }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(inf_len, 1) ThenBlock: {
            JSBridge__Push(bf)
            JSBridge__Push(target)
            JSRT_FuncPropSet(bf, "length", inf_v)
            target = JSBridge__Pop()
            bf = JSBridge__Pop()
        } ElseBlock: {
            fdesc = RDMEM_64(bf, 8)
            IfCondition NotEqual(fdesc, 0) ThenBlock: {
                WRMEM_64(fdesc, 80, blen)
            }
        }
        // name = "bound " + (string target name, else "")
        JSBridge__Push(bf)
        JSBridge__Push(target)
        nm_v = JSVM__ObjGetAcc(target, "name")
        target = JSBridge__Pop()
        bf = JSBridge__Pop()
        JSBridge__Push(bf)
        JSBridge__Push(nm_v)
        abrupt_bn = JSBridge__TakeAbrupt()
        nm_v = JSBridge__Pop()
        bf = JSBridge__Pop()
        IfCondition EqualTo(abrupt_bn, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        nm_pay = 0
        IfCondition EqualTo(JSRT_GetType(nm_v), JSType.STRING) ThenBlock: {
            nm_pay = JSRT_GetPayload(nm_v)
        }
        IfCondition EqualTo(nm_pay, 0) ThenBlock: {
            empty_s = JSRT_CreateString("")
            nm_pay = JSRT_GetPayload(empty_s)
        }
        JSBridge__Push(bf)
        named = JSRT__StrConcat("bound ", nm_pay)
        bf = JSBridge__Pop()
        IfCondition NotEqual(named, 0) ThenBlock: {
            JSBridge__Push(bf)
            JSRT_FuncPropSet(bf, "name", named)
            bf = JSBridge__Pop()
            // PropTable name is enumerable unless __a_name says otherwise.
            // Exotic name is !W !E C. for-in / verifyNotEnumerable require that.
            JSBridge__Push(bf)
            JSBridge__SetAttrBits(bf, "name", JSAttr.C)
            bf = JSBridge__Pop()
            fdesc_n = RDMEM_64(bf, 8)
            IfCondition NotEqual(fdesc_n, 0) ThenBlock: {
                WRMEM_64(fdesc_n, 24, JSRT_GetPayload(named))
            }
        }
        ReturnValue(bf)
    }
}


// Bound function invoke (FUNC_BOUND=198) — uses env as bound record
Function.JSBridge__NFuncBound {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        // Bound record is in global __bound_rec__ set by CALL handler
        rec = JSVM_GetGlobal("__bound_rec__")
        IfCondition NotEqual(JSRT_GetType(rec), JSType.OBJECT) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = JSRT_ObjGet(rec, "__bt__")
        this_arg = JSRT_ObjGet(rec, "__bthis__")
        parr = JSRT_ObjGet(rec, "__bargs__")
        // M128e7d6: snapshot call-time args FIRST — save_args often aliases
        // JSVMCallBuf.buf; writing partials into CallBuf would clobber them
        // (bound(1)(2,3) became (1,1,1); makeCtorArg factories returned TA).
        call_snap = JSRT_CreateArray()
        ai = 0
        WhileLoop LessThan(ai, save_argc) {
            JSBridge__Push(call_snap)
            JSBridge__Push(save_args)
            JSBridge__Push(save_argc)
            JSBridge__Push(ai)
            JSBridge__Push(target)
            JSBridge__Push(this_arg)
            JSBridge__Push(parr)
            av = RDMEM_64(save_args, Multiply(ai, 8))
            parr = JSBridge__Pop()
            this_arg = JSBridge__Pop()
            target = JSBridge__Pop()
            ai = JSBridge__Pop()
            save_argc = JSBridge__Pop()
            save_args = JSBridge__Pop()
            call_snap = JSBridge__Pop()
            JSBridge__Push(save_args)
            JSBridge__Push(save_argc)
            JSBridge__Push(ai)
            JSBridge__Push(target)
            JSBridge__Push(this_arg)
            JSBridge__Push(parr)
            JSRT_ArrPush(call_snap, av)
            parr = JSBridge__Pop()
            this_arg = JSBridge__Pop()
            target = JSBridge__Pop()
            ai = JSBridge__Pop()
            save_argc = JSBridge__Pop()
            save_args = JSBridge__Pop()
            ai = Add(ai, 1)
        }
        ab = JSVMCallBuf.buf
        call_argc = 0
        IfCondition EqualTo(JSRT_GetType(parr), JSType.ARRAY) ThenBlock: {
            plen = JSRT_ArrLen(parr)
            pi = 0
            WhileLoop LessThan(pi, plen) {
                JSBridge__Push(ab)
                JSBridge__Push(call_argc)
                JSBridge__Push(parr)
                JSBridge__Push(plen)
                JSBridge__Push(pi)
                JSBridge__Push(target)
                JSBridge__Push(this_arg)
                JSBridge__Push(call_snap)
                pv = JSRT_ArrGet(parr, pi)
                call_snap = JSBridge__Pop()
                this_arg = JSBridge__Pop()
                target = JSBridge__Pop()
                pi = JSBridge__Pop()
                plen = JSBridge__Pop()
                parr = JSBridge__Pop()
                call_argc = JSBridge__Pop()
                ab = JSBridge__Pop()
                WRMEM_64(ab, Multiply(call_argc, 8), pv)
                call_argc = Add(call_argc, 1)
                pi = Add(pi, 1)
            }
        }
        snap_len = JSRT_ArrLen(call_snap)
        ai = 0
        WhileLoop LessThan(ai, snap_len) {
            JSBridge__Push(ab)
            JSBridge__Push(call_argc)
            JSBridge__Push(call_snap)
            JSBridge__Push(snap_len)
            JSBridge__Push(ai)
            JSBridge__Push(target)
            JSBridge__Push(this_arg)
            av = JSRT_ArrGet(call_snap, ai)
            this_arg = JSBridge__Pop()
            target = JSBridge__Pop()
            ai = JSBridge__Pop()
            snap_len = JSBridge__Pop()
            call_snap = JSBridge__Pop()
            call_argc = JSBridge__Pop()
            ab = JSBridge__Pop()
            WRMEM_64(ab, Multiply(call_argc, 8), av)
            call_argc = Add(call_argc, 1)
            ai = Add(ai, 1)
        }
        JSVM__SetGlobal("this", this_arg)
        ret = JSVM__CallFunc(target, ab, call_argc)
        ReturnValue(ret)
    }
}


// M40: user-visible plain object with [[Prototype]] = Object.prototype
// (JSRT_CreateObject intentionally leaves proto null for bootstrap/internal bags)
Function.JSBridge__CreateUserObject {
    Output: Address
    Body: {
        o = JSRT_CreateObject()
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSBridge__Push(o)
            JSRT_ObjSet(o, "__proto__", JSRTState.object_proto)
            o = JSBridge__Pop()
        }
        ReturnValue(o)
    }
}


// Object.getOwnPropertyDescriptor(obj, prop) — return descriptor object
// Data descriptor. bits: W=1 E=2 C=4.
Function.JSBridge__DataDesc {
    Input: val: Address
    Input: bits: Integer
    Output: Address
    Body: {
        save_v = val
        save_b = bits
        JSBridge__Push(save_v)
        JSBridge__Push(save_b)
        desc = JSBridge__CreateUserObject()
        save_b = JSBridge__Pop()
        save_v = JSBridge__Pop()
        JSBridge__Push(desc)
        JSBridge__Push(save_b)
        JSRT_ObjSet(desc, "value", save_v)
        save_b = JSBridge__Pop()
        desc = JSBridge__Pop()
        wt = 0
        IfCondition NotEqual(BitwiseAnd(save_b, JSAttr.W), 0) ThenBlock: { wt = 1 }
        JSBridge__Push(desc)
        JSBridge__Push(save_b)
        bv = JSRT_CreateBool(wt)
        save_b = JSBridge__Pop()
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSBridge__Push(save_b)
        JSRT_ObjSet(desc, "writable", bv)
        save_b = JSBridge__Pop()
        desc = JSBridge__Pop()
        et = 0
        IfCondition NotEqual(BitwiseAnd(save_b, JSAttr.E), 0) ThenBlock: { et = 1 }
        JSBridge__Push(desc)
        JSBridge__Push(save_b)
        bv = JSRT_CreateBool(et)
        save_b = JSBridge__Pop()
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSBridge__Push(save_b)
        JSRT_ObjSet(desc, "enumerable", bv)
        save_b = JSBridge__Pop()
        desc = JSBridge__Pop()
        ct = 0
        IfCondition NotEqual(BitwiseAnd(save_b, JSAttr.C), 0) ThenBlock: { ct = 1 }
        JSBridge__Push(desc)
        bv = JSRT_CreateBool(ct)
        desc = JSBridge__Pop()
        JSRT_ObjSet(desc, "configurable", bv)
        ReturnValue(desc)
    }
}


Function.JSBridge__NGetOwnPropDesc {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 2) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = RDMEM_64(save_args)
        name_val = RDMEM_64(save_args, 8)

        // M27b: ToObject(O) — null/undefined TypeError; STRING exotic handled below
        tt0 = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt0, JSType.NULL), EqualTo(tt0, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.getOwnPropertyDescriptor called on non-object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }

        // Mole 16: ToPropertyKey so Symbol.iterator descriptors work
        JSBridge__Push(target)
        name_ptr = JSVM_ToPropertyKey(name_val)
        target = JSBridge__Pop()

        // M128e7d4/e7du: TypedArray [[GetOwnProperty]] for integer indexes
        // detached / invalid → undefined; valid → data descriptor
        IfCondition EqualTo(JSVM_IsTypedArray(target), 1) ThenBlock: {
            ta_idx = JSVM_TA_ValidIndex(target, name_ptr)
            IfCondition GreaterEqual(ta_idx, 0) ThenBlock: {
                // valid index → data descriptor {value, w:true, e:true, c:true}
                JSBridge__Push(target)
                JSBridge__Push(ta_idx)
                val = JSVM_TA_Get(target, ta_idx)
                ta_idx = JSBridge__Pop()
                target = JSBridge__Pop()
                // IntegerIndexedElementGet undefined (detached race) → no property
                IfCondition EqualTo(JSRT_GetType(val), JSType.UNDEFINED) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                desc = JSBridge__CreateUserObject()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "value", val)
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "writable", JSRT_CreateBool(1))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "enumerable", JSRT_CreateBool(1))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "configurable", JSRT_CreateBool(1))
                desc = JSBridge__Pop()
                ReturnValue(desc)
            }
            IfCondition EqualTo(ta_idx, -1) ThenBlock: {
                // canonical OOB / detached index → undefined (not ordinary)
                ReturnValue(JSRT_Undefined())
            }
            // named props (buffer, length, …) fall through
        }

        // M128e6ai: Proxy [[GetOwnProperty]] trap
        IfCondition EqualTo(JSVM__IsProxy(target), 1) ThenBlock: {
            hnd_gd = JSRT_ObjGet(target, "__p_h__")
            tgt_gd = JSRT_ObjGet(target, "__p_t__")
            trap_gd = JSRT_ObjGet(hnd_gd, "getOwnPropertyDescriptor")
            IfCondition EqualTo(JSRT_GetType(trap_gd), JSType.FUNCTION) ThenBlock: {
                kv_gd = JSRT__AllocValue()
                WRMEM_64(kv_gd, JSType.STRING)
                WRMEM_64(kv_gd, 8, name_ptr)
                ab_gd = JSVMCallBuf.buf
                WRMEM_64(ab_gd, tgt_gd)
                WRMEM_64(ab_gd, 8, kv_gd)
                save_this_gd = JSVM__GetGlobal("this")
                JSVM__SetGlobal("this", hnd_gd)
                res_gd = JSVM__CallFunc(trap_gd, ab_gd, 2)
                JSVM__SetGlobal("this", save_this_gd)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                ReturnValue(res_gd)
            }
            // No trap — gOPD on target
            target = tgt_gd
        }

        // M27b: String exotic [[GetOwnProperty]] for primitive strings
        IfCondition EqualTo(JSRT_GetType(target), JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(target)
            slen = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { slen = JSRT_StrLen(sp) }
            // "length" — name_ptr is property key (C or UTF-16 via StrEq)
            is_len = 0
            IfCondition EqualTo(JSRT_StrEq(name_ptr, "length"), 1) ThenBlock: { is_len = 1 }
            IfCondition EqualTo(is_len, 1) ThenBlock: {
                desc = JSBridge__CreateUserObject()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "value", JSRT_CreateNumber(slen))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "writable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "enumerable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "configurable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                ReturnValue(desc)
            }
            // integer index in range → single code unit string (M31a: StrUnit keys)
            is_idx = 1
            idxn = 0
            bi = 0
            nlen_key = JSRT_StrLen(name_ptr)
            IfCondition EqualTo(nlen_key, 0) ThenBlock: { is_idx = 0 }
            WhileLoop EqualTo(is_idx, 1) {
                IfCondition GreaterEqual(bi, nlen_key) ThenBlock: {
                    IfCondition EqualTo(bi, 0) ThenBlock: { is_idx = 0 }
                    IfCondition GreaterThan(bi, 0) ThenBlock: { is_idx = 2 }
                } ElseBlock: {
                    ch = JSRT_StrUnit(name_ptr, bi)
                    IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                        is_idx = 0
                    } ElseBlock: {
                        idxn = Add(Multiply(idxn, 10), Subtract(ch, 48))
                        bi = Add(bi, 1)
                        IfCondition GreaterThan(bi, 10) ThenBlock: { is_idx = 0 }
                    }
                }
            }
            IfCondition EqualTo(is_idx, 2) ThenBlock: {
                IfCondition And(GreaterEqual(idxn, 0), LessThan(idxn, slen)) ThenBlock: {
                    // one code unit (M31a UTF-16)
                    chv = JSRT_CreateStringSlice(sp, idxn, 1)
                    desc = JSBridge__CreateUserObject()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "value", chv)
                    desc = JSBridge__Pop()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "writable", JSRT_CreateBool(0))
                    desc = JSBridge__Pop()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "enumerable", JSRT_CreateBool(1))
                    desc = JSBridge__Pop()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "configurable", JSRT_CreateBool(0))
                    desc = JSBridge__Pop()
                    ReturnValue(desc)
                }
            }
            ReturnValue(JSRT_Undefined())
        }

        // M26k.10: mangled private #name@id only
        IfCondition NotEqual(name_ptr, 0) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(name_ptr, 0), 35) ThenBlock: {
                _mp_has_at = 0
                _mp_i = 1
                WhileLoop LessThan(_mp_i, 256) {
                    _mp_b = RDMEM_8(name_ptr, _mp_i)
                    IfCondition EqualTo(_mp_b, 0) ThenBlock: { _mp_i = 256 }
                    IfCondition EqualTo(_mp_b, 64) ThenBlock: {
                        _mp_has_at = 1
                        _mp_i = 256
                    }
                    IfCondition And(NotEqual(_mp_b, 0), NotEqual(_mp_b, 64)) ThenBlock: {
                        _mp_i = Add(_mp_i, 1)
                    }
                }
                IfCondition EqualTo(_mp_has_at, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
            }
        }

        // FUNCTION name/length: fixed attributes w=false e=false c=true (bits=4)
        // M31c: keys may be UTF-16 JS strings — use StrEq not RDMEM_8
        IfCondition EqualTo(JSRT_GetType(target), JSType.FUNCTION) ThenBlock: {
            is_nl = 0
            IfCondition EqualTo(JSRT_StrEq(name_ptr, "name"), 1) ThenBlock: { is_nl = 1 }
            IfCondition EqualTo(JSRT_StrEq(name_ptr, "length"), 1) ThenBlock: { is_nl = 1 }
            IfCondition EqualTo(is_nl, 1) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                has_nl = JSRT_ObjHas(target, name_ptr)
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
                IfCondition EqualTo(has_nl, 1) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                val = JSRT_ObjGet(target, name_ptr)
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
                desc = JSBridge__CreateUserObject()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "value", val)
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "writable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "enumerable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "configurable", JSRT_CreateBool(1))
                desc = JSBridge__Pop()
                ReturnValue(desc)
                }
            }
            // M26i: function.prototype — class: w=f e=f c=f; ordinary: w=t e=f c=f
            // Absent when fdesc+48 is 0 (Function.prototype / methods)
            is_proto_key = 0
            IfCondition EqualTo(JSRT_StrEq(name_ptr, "prototype"), 1) ThenBlock: {
                is_proto_key = 1
            }
            IfCondition EqualTo(is_proto_key, 1) ThenBlock: {
                fdesc_p = RDMEM_64(target, 8)
                has_proto_slot = 0
                IfCondition NotEqual(fdesc_p, 0) ThenBlock: {
                    IfCondition NotEqual(RDMEM_64(fdesc_p, 48), 0) ThenBlock: {
                        has_proto_slot = 1
                    }
                }
                IfCondition EqualTo(has_proto_slot, 1) ThenBlock: {
                    JSBridge__Push(target)
                    JSBridge__Push(name_ptr)
                    val = JSRT_ObjGet(target, name_ptr)
                    name_ptr = JSBridge__Pop()
                    target = JSBridge__Pop()
                    proto_w = 1
                    fdesc_p = RDMEM_64(target, 8)
                    IfCondition NotEqual(fdesc_p, 0) ThenBlock: {
                        IfCondition NotEqual(RDMEM_64(fdesc_p, 88), 0) ThenBlock: {
                            proto_w = 0
                        }
                    }
                    // M128e7e1: honor SetAttrBits("prototype") when stamped
                    // (TypedArray/ArrayBuffer/DataView ctors: !W!E!C)
                    abits_p = JSBridge__GetAttrBits(target, name_ptr)
                    IfCondition NotEqual(abits_p, JSAttr.DEFAULT) ThenBlock: {
                        IfCondition EqualTo(BitwiseAnd(abits_p, 1), 0) ThenBlock: {
                            proto_w = 0
                        } ElseBlock: {
                            proto_w = 1
                        }
                    }
                    desc = JSBridge__CreateUserObject()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "value", val)
                    desc = JSBridge__Pop()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "writable", JSRT_CreateBool(proto_w))
                    desc = JSBridge__Pop()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "enumerable", JSRT_CreateBool(0))
                    desc = JSBridge__Pop()
                    JSBridge__Push(desc)
                    JSRT_ObjSet(desc, "configurable", JSRT_CreateBool(0))
                    desc = JSBridge__Pop()
                    ReturnValue(desc)
                }
                // no own prototype — fall through (may find accessor on PropTable)
            }
        }

        // Array exotic length — W from stored bits (default writable), !E !C.
        // Own indexes read element storage. Generic ObjGet misses ArrSet values.
        IfCondition EqualTo(JSRT_GetType(target), JSType.ARRAY) ThenBlock: {
            is_alen = 0
            IfCondition EqualTo(JSRT_StrEq(name_ptr, "length"), 1) ThenBlock: { is_alen = 1 }
            IfCondition EqualTo(is_alen, 1) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                ab_len = JSBridge__GetAttrBits(target, name_ptr)
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
                alen = JSRT_ArrLen(target)
                wlen = 0
                IfCondition NotEqual(BitwiseAnd(ab_len, JSAttr.W), 0) ThenBlock: { wlen = 1 }
                desc = JSBridge__CreateUserObject()
                JSBridge__Push(desc)
                JSBridge__Push(wlen)
                JSRT_ObjSet(desc, "value", JSRT_CreateNumber(alen))
                wlen = JSBridge__Pop()
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                bv = JSRT_CreateBool(wlen)
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "writable", bv)
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "enumerable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "configurable", JSRT_CreateBool(0))
                desc = JSBridge__Pop()
                ReturnValue(desc)
            }
            JSBridge__Push(target)
            JSBridge__Push(name_ptr)
            idx_ai = JSBridge__ArrIndexOrNeg(name_ptr)
            name_ptr = JSBridge__Pop()
            target = JSBridge__Pop()
            IfCondition GreaterEqual(idx_ai, 0) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                JSBridge__Push(idx_ai)
                has_el = JSRT_ArrHas(target, idx_ai)
                idx_ai = JSBridge__Pop()
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
                IfCondition EqualTo(has_el, 1) ThenBlock: {
                    // Accessor on an index also stores an undefined element so
                    // hasOwn is true. Prefer the accessor descriptor.
                    JSBridge__Push(target)
                    JSBridge__Push(name_ptr)
                    JSBridge__Push(idx_ai)
                    gk_ai = JSBridge__MakeAccKey(name_ptr, 0)
                    idx_ai = JSBridge__Pop()
                    name_ptr = JSBridge__Pop()
                    target = JSBridge__Pop()
                    has_own_acc = 0
                    IfCondition NotEqual(gk_ai, 0) ThenBlock: {
                        JSBridge__Push(target)
                        JSBridge__Push(name_ptr)
                        JSBridge__Push(idx_ai)
                        JSBridge__Push(gk_ai)
                        own_get = JSRT_ObjHas(target, gk_ai)
                        gk_ai = JSBridge__Pop()
                        idx_ai = JSBridge__Pop()
                        name_ptr = JSBridge__Pop()
                        target = JSBridge__Pop()
                        IfCondition EqualTo(own_get, 1) ThenBlock: { has_own_acc = 1 }
                    }
                    JSBridge__Push(target)
                    JSBridge__Push(name_ptr)
                    JSBridge__Push(idx_ai)
                    JSBridge__Push(has_own_acc)
                    sk_ai = JSBridge__MakeAccKey(name_ptr, 1)
                    has_own_acc = JSBridge__Pop()
                    idx_ai = JSBridge__Pop()
                    name_ptr = JSBridge__Pop()
                    target = JSBridge__Pop()
                    IfCondition NotEqual(sk_ai, 0) ThenBlock: {
                        JSBridge__Push(target)
                        JSBridge__Push(name_ptr)
                        JSBridge__Push(idx_ai)
                        JSBridge__Push(has_own_acc)
                        JSBridge__Push(sk_ai)
                        own_set = JSRT_ObjHas(target, sk_ai)
                        sk_ai = JSBridge__Pop()
                        has_own_acc = JSBridge__Pop()
                        idx_ai = JSBridge__Pop()
                        name_ptr = JSBridge__Pop()
                        target = JSBridge__Pop()
                        IfCondition EqualTo(own_set, 1) ThenBlock: { has_own_acc = 1 }
                    }
                    IfCondition EqualTo(has_own_acc, 0) ThenBlock: {
                        JSBridge__Push(target)
                        JSBridge__Push(name_ptr)
                        JSBridge__Push(idx_ai)
                        val_ai = JSRT_ArrGet(target, idx_ai)
                        idx_ai = JSBridge__Pop()
                        name_ptr = JSBridge__Pop()
                        target = JSBridge__Pop()
                        JSBridge__Push(target)
                        JSBridge__Push(name_ptr)
                        JSBridge__Push(val_ai)
                        bits_ai = JSBridge__GetAttrBits(target, name_ptr)
                        val_ai = JSBridge__Pop()
                        name_ptr = JSBridge__Pop()
                        target = JSBridge__Pop()
                        ReturnValue(JSBridge__DataDesc(val_ai, bits_ai))
                    }
                }
            }
        }

        // M26i/k.11: accessor descriptor only for OWN __get_/__set_
        // gOPD must not walk proto — own data field shadows inherited setter
        // M31c: build __get_/__set_ keys with UTF-16-aware unit copy
        nlen_key = JSRT_StrLen(name_ptr)
        gk_len = Add(nlen_key, 7)
        gk = JSRT__StrSlabAlloc(Add(gk_len, 1))
        sk = JSRT__StrSlabAlloc(Add(gk_len, 1))
        IfCondition And(NotEqual(gk, 0), NotEqual(sk, 0)) ThenBlock: {
            WRMEM_8(gk, 0, 95)
            WRMEM_8(gk, 1, 95)
            WRMEM_8(gk, 2, 103)
            WRMEM_8(gk, 3, 101)
            WRMEM_8(gk, 4, 116)
            WRMEM_8(gk, 5, 95)
            // C-style __get_ + Latin-1 name units for PropTable C keys
            gi = 0
            WhileLoop LessThan(gi, nlen_key) {
                u = JSRT_StrUnit(name_ptr, gi)
                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                WRMEM_8(gk, Add(6, gi), u)
                gi = Add(gi, 1)
            }
            WRMEM_8(gk, Add(6, nlen_key), 0)
            WRMEM_8(sk, 0, 95)
            WRMEM_8(sk, 1, 95)
            WRMEM_8(sk, 2, 115)
            WRMEM_8(sk, 3, 101)
            WRMEM_8(sk, 4, 116)
            WRMEM_8(sk, 5, 95)
            gi = 0
            WhileLoop LessThan(gi, nlen_key) {
                u = JSRT_StrUnit(name_ptr, gi)
                IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
                WRMEM_8(sk, Add(6, gi), u)
                gi = Add(gi, 1)
            }
            WRMEM_8(sk, Add(6, nlen_key), 0)
            gfn = 0
            sfn = 0
            JSBridge__Push(target)
            JSBridge__Push(name_ptr)
            JSBridge__Push(sk)
            JSBridge__Push(gk)
            has_g = JSRT_ObjHas(target, gk)
            gk = JSBridge__Pop()
            sk = JSBridge__Pop()
            name_ptr = JSBridge__Pop()
            target = JSBridge__Pop()
            IfCondition EqualTo(has_g, 1) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                JSBridge__Push(sk)
                gfn = JSRT_ObjGet(target, gk)
                sk = JSBridge__Pop()
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
            }
            JSBridge__Push(target)
            JSBridge__Push(name_ptr)
            JSBridge__Push(gfn)
            JSBridge__Push(sk)
            has_s = JSRT_ObjHas(target, sk)
            sk = JSBridge__Pop()
            gfn = JSBridge__Pop()
            name_ptr = JSBridge__Pop()
            target = JSBridge__Pop()
            IfCondition EqualTo(has_s, 1) ThenBlock: {
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                JSBridge__Push(gfn)
                sfn = JSRT_ObjGet(target, sk)
                gfn = JSBridge__Pop()
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
            }
            // Own __get_/__set_ marks an accessor even when the value is
            // undefined (get: undefined, set: undefined).
            has_acc = 0
            IfCondition EqualTo(has_g, 1) ThenBlock: { has_acc = 1 }
            IfCondition EqualTo(has_s, 1) ThenBlock: { has_acc = 1 }
            IfCondition EqualTo(has_acc, 1) ThenBlock: {
                // M33: read real E/C attr bits (was hardcoding e=false c=true)
                JSBridge__Push(target)
                JSBridge__Push(name_ptr)
                JSBridge__Push(gfn)
                JSBridge__Push(sfn)
                bits_acc = JSBridge__GetAttrBits(target, name_ptr)
                sfn = JSBridge__Pop()
                gfn = JSBridge__Pop()
                name_ptr = JSBridge__Pop()
                target = JSBridge__Pop()
                desc = JSBridge__CreateUserObject()
                IfCondition EqualTo(JSRT_GetType(gfn), JSType.FUNCTION) ThenBlock: {
                    JSBridge__Push(desc)
                    JSBridge__Push(sfn)
                    JSBridge__Push(bits_acc)
                    JSRT_ObjSet(desc, "get", gfn)
                    bits_acc = JSBridge__Pop()
                    sfn = JSBridge__Pop()
                    desc = JSBridge__Pop()
                } ElseBlock: {
                    // get: undefined when setter-only (own get key absent or non-function)
                    JSBridge__Push(desc)
                    JSBridge__Push(sfn)
                    JSBridge__Push(bits_acc)
                    JSRT_ObjSet(desc, "get", JSRT_Undefined())
                    bits_acc = JSBridge__Pop()
                    sfn = JSBridge__Pop()
                    desc = JSBridge__Pop()
                }
                IfCondition EqualTo(JSRT_GetType(sfn), JSType.FUNCTION) ThenBlock: {
                    JSBridge__Push(desc)
                    JSBridge__Push(bits_acc)
                    JSRT_ObjSet(desc, "set", sfn)
                    bits_acc = JSBridge__Pop()
                    desc = JSBridge__Pop()
                } ElseBlock: {
                    JSBridge__Push(desc)
                    JSBridge__Push(bits_acc)
                    JSRT_ObjSet(desc, "set", JSRT_Undefined())
                    bits_acc = JSBridge__Pop()
                    desc = JSBridge__Pop()
                }
                JSBridge__Push(desc)
                JSBridge__Push(bits_acc)
                IfCondition NotEqual(BitwiseAnd(bits_acc, JSAttr.E), 0) ThenBlock: {
                    et = JSRT_CreateBool(1)
                } ElseBlock: {
                    et = JSRT_CreateBool(0)
                }
                bits_acc = JSBridge__Pop()
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSBridge__Push(bits_acc)
                JSRT_ObjSet(desc, "enumerable", et)
                bits_acc = JSBridge__Pop()
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSBridge__Push(bits_acc)
                IfCondition NotEqual(BitwiseAnd(bits_acc, JSAttr.C), 0) ThenBlock: {
                    ct = JSRT_CreateBool(1)
                } ElseBlock: {
                    ct = JSRT_CreateBool(0)
                }
                bits_acc = JSBridge__Pop()
                desc = JSBridge__Pop()
                JSBridge__Push(desc)
                JSRT_ObjSet(desc, "configurable", ct)
                desc = JSBridge__Pop()
                ReturnValue(desc)
            }
        }

        // Check if property exists
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        exists = JSRT_ObjHas(target, name_ptr)
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(exists, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Get value
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        val = JSRT_ObjGet(target, name_ptr)
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // Attribute bits
        JSBridge__Push(target)
        JSBridge__Push(name_ptr)
        JSBridge__Push(val)
        bits = JSBridge__GetAttrBits(target, name_ptr)
        val = JSBridge__Pop()
        name_ptr = JSBridge__Pop()
        target = JSBridge__Pop()

        // Build descriptor object
        JSBridge__Push(val)
        JSBridge__Push(bits)
        desc = JSBridge__CreateUserObject()
        bits = JSBridge__Pop()
        val = JSBridge__Pop()

        JSBridge__Push(desc)
        JSBridge__Push(bits)
        JSRT_ObjSet(desc, "value", val)
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        JSBridge__Push(bits)
        IfCondition NotEqual(BitwiseAnd(bits, JSAttr.W), 0) ThenBlock: {
            wt = JSRT_CreateBool(1)
        } ElseBlock: {
            wt = JSRT_CreateBool(0)
        }
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSBridge__Push(bits)
        JSRT_ObjSet(desc, "writable", wt)
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        JSBridge__Push(bits)
        IfCondition NotEqual(BitwiseAnd(bits, JSAttr.E), 0) ThenBlock: {
            et = JSRT_CreateBool(1)
        } ElseBlock: {
            et = JSRT_CreateBool(0)
        }
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSBridge__Push(bits)
        JSRT_ObjSet(desc, "enumerable", et)
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()

        JSBridge__Push(desc)
        JSBridge__Push(bits)
        IfCondition NotEqual(BitwiseAnd(bits, JSAttr.C), 0) ThenBlock: {
            ct = JSRT_CreateBool(1)
        } ElseBlock: {
            ct = JSRT_CreateBool(0)
        }
        bits = JSBridge__Pop()
        desc = JSBridge__Pop()
        JSBridge__Push(desc)
        JSRT_ObjSet(desc, "configurable", ct)
        desc = JSBridge__Pop()

        ReturnValue(desc)
    }
}


// Object.setPrototypeOf(obj, proto) — set [[Prototype]], return obj
// M68: unlocks object-literal super / method.js / getter-super-prop
Function.JSBridge__NSetProtoOf {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        IfCondition LessThan(argc, 2) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.setPrototypeOf requires 2 arguments")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        target = RDMEM_64(save_args)
        proto = RDMEM_64(save_args, 8)
        tt = JSRT_GetType(target)
        // null/undefined → TypeError
        IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.setPrototypeOf called on null or undefined")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        // proto must be Object, null, Function, or Array
        pt = JSRT_GetType(proto)
        ok_proto = 0
        IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: { ok_proto = 1 }
        IfCondition EqualTo(pt, JSType.NULL) ThenBlock: { ok_proto = 1 }
        IfCondition EqualTo(pt, JSType.FUNCTION) ThenBlock: { ok_proto = 1 }
        IfCondition EqualTo(pt, JSType.ARRAY) ThenBlock: { ok_proto = 1 }
        IfCondition EqualTo(ok_proto, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object prototype may only be an Object or null")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        // Primitive symbols are objects in this runtime. Spec still rejects them.
        // Object(symbol) has __value__ and stays a valid prototype.
        JSBridge__Push(target)
        JSBridge__Push(proto)
        sym_proto = JSVM_IsPrimSymbol(proto)
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition EqualTo(sym_proto, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object prototype may only be an Object or null")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        target = JSBridgeTmp.obj
        proto = JSBridgeTmp.val
        // OrdinarySetPrototypeOf: cycle, extensible, immutable Object.prototype.
        JSBridge__Push(target)
        JSBridge__Push(proto)
        st_sp = JSBridge__SetProtoSlot(target, proto, 0)
        proto = JSBridge__Pop()
        target = JSBridge__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(st_sp, 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.setPrototypeOf failed")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            ReturnValue(0)
        }
        ReturnValue(target)
    }
}


// Object.getPrototypeOf(obj) — return [[Prototype]]
// M26i: FUNCTION without own __proto__ → Function.prototype (not null).
Function.JSBridge__NGetProtoOf {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_Null())
        }
        target = RDMEM_64(save_args)
        JSBridge__Push(target)
        proto = JSBridge__GetProtoSlot(target, 0)
        target = JSBridge__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition EqualTo(proto, 0) ThenBlock: {
            ReturnValue(JSRT_Null())
        }
        ReturnValue(proto)
    }
}
