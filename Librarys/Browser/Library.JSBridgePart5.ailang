// Library.JSBridgePart5.ailang — JSBridge functions
// Moved out of Library.JSBridge.ailang. Pools stay in the parent.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.


// Object.assign(target, ...sources) — copy own enumerable props
Function.JSBridge__NObjAssign {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(save_args)
        // ES: ToObject(target) — null/undefined TypeError; primitives → boxed object
        tt = JSRT_GetType(target)
        IfCondition Or(EqualTo(tt, JSType.NULL), EqualTo(tt, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        // M128e7bu: box Number/String/Boolean/BigInt/Symbol so ObjSet works
        // (Object.assign(1, {a:1}) → Number object with a=1)
        need_box = 0
        IfCondition EqualTo(tt, JSType.NUMBER) ThenBlock: { need_box = 1 }
        IfCondition EqualTo(tt, JSType.STRING) ThenBlock: { need_box = 1 }
        IfCondition EqualTo(tt, JSType.BOOLEAN) ThenBlock: { need_box = 1 }
        IfCondition EqualTo(tt, JSType.BIGINT) ThenBlock: { need_box = 1 }
        IfCondition EqualTo(JSVM_IsSymbol(target), 1) ThenBlock: { need_box = 1 }
        IfCondition EqualTo(need_box, 1) ThenBlock: {
            ab_as = JSVMCallBuf.buf
            StoreValue(ab_as, target)
            JSBridge__Push(save_args)
            JSBridge__Push(save_argc)
            target = JSBridge_Dispatch(JSNativeID.OBJ_CTOR, ab_as, 1)
            save_argc = JSBridge__Pop()
            save_args = JSBridge__Pop()
        }
        si = 1
        WhileLoop LessThan(si, save_argc) {
            src = Dereference(Add(save_args, Multiply(si, 8)))
            // null/undefined sources skipped
            IfCondition EqualTo(src, 0) ThenBlock: {
                si = Add(si, 1)
            } ElseBlock: {
                src_t = JSRT_GetType(src)
                IfCondition Or(EqualTo(src_t, JSType.NULL), EqualTo(src_t, JSType.UNDEFINED)) ThenBlock: {
                    si = Add(si, 1)
                } ElseBlock: {
                    // M34: objects, arrays, functions, strings (and other primitives via keys)
                    do_copy = 0
                    IfCondition EqualTo(src_t, JSType.OBJECT) ThenBlock: { do_copy = 1 }
                    IfCondition EqualTo(src_t, JSType.ARRAY) ThenBlock: { do_copy = 1 }
                    IfCondition EqualTo(src_t, JSType.FUNCTION) ThenBlock: { do_copy = 1 }
                    IfCondition EqualTo(src_t, JSType.STRING) ThenBlock: { do_copy = 1 }
                    IfCondition EqualTo(do_copy, 1) ThenBlock: {
                        JSBridge__Push(target)
                        JSBridge__Push(save_args)
                        JSBridge__Push(save_argc)
                        JSBridge__Push(si)
                        // String: synthetic index keys
                        IfCondition EqualTo(src_t, JSType.STRING) ThenBlock: {
                            sp = JSRT_GetPayload(src)
                            slen = 0
                            IfCondition NotEqual(sp, 0) ThenBlock: { slen = JSRT_StrLen(sp) }
                            ai = 0
                            WhileLoop LessThan(ai, slen) {
                                JSBridge__Push(target)
                                JSBridge__Push(save_args)
                                JSBridge__Push(save_argc)
                                JSBridge__Push(si)
                                JSBridge__Push(ai)
                                JSBridge__Push(sp)
                                JSBridge__Push(slen)
                                chv = JSRT_CreateStringSlice(sp, ai, 1)
                                // M128e7bv: IntToStr is a static buffer — slab-copy key
                                // or every index overwrites prior keys (t["0"] lost)
                                tmpk = JSRT__IntToStr(ai)
                                tkl = StringLength(tmpk)
                                kptr = JSRT__StrSlabAlloc(Add(tkl, 1))
                                IfCondition NotEqual(kptr, 0) ThenBlock: {
                                    MemoryCopy(kptr, tmpk, Add(tkl, 1))
                                } ElseBlock: {
                                    kptr = tmpk
                                }
                                slen = JSBridge__Pop()
                                sp = JSBridge__Pop()
                                ai = JSBridge__Pop()
                                si = JSBridge__Pop()
                                save_argc = JSBridge__Pop()
                                save_args = JSBridge__Pop()
                                target = JSBridge__Pop()
                                JSBridge__Push(target)
                                JSBridge__Push(save_args)
                                JSBridge__Push(save_argc)
                                JSBridge__Push(si)
                                JSBridge__Push(ai)
                                JSBridge__Push(sp)
                                JSBridge__Push(slen)
                                JSRT_ObjSet(target, kptr, chv)
                                slen = JSBridge__Pop()
                                sp = JSBridge__Pop()
                                ai = JSBridge__Pop()
                                si = JSBridge__Pop()
                                save_argc = JSBridge__Pop()
                                save_args = JSBridge__Pop()
                                target = JSBridge__Pop()
                                ai = Add(ai, 1)
                            }
                        } ElseBlock: {
                            keys = JSRT_ObjKeys(src)
                            klen = JSRT_ArrLen(keys)
                            ki = 0
                            WhileLoop LessThan(ki, klen) {
                                JSBridge__Push(target)
                                JSBridge__Push(save_args)
                                JSBridge__Push(save_argc)
                                JSBridge__Push(si)
                                JSBridge__Push(keys)
                                JSBridge__Push(ki)
                                JSBridge__Push(klen)
                                ksv = JSRT_ArrGet(keys, ki)
                                kp = JSRT_GetPayload(ksv)
                                src2 = Dereference(Add(save_args, Multiply(si, 8)))
                                // Prefer ArrGet for array indices; M52: invoke __get_* accessors
                                v = JSRT_Undefined()
                                got_g = 0
                                IfCondition EqualTo(JSRT_GetType(src2), JSType.ARRAY) ThenBlock: {
                                    // try numeric
                                    is_idx = 1
                                    idxn = 0
                                    bi = 0
                                    nkey = JSRT_StrLen(kp)
                                    IfCondition EqualTo(nkey, 0) ThenBlock: { is_idx = 0 }
                                    WhileLoop EqualTo(is_idx, 1) {
                                        IfCondition GreaterEqual(bi, nkey) ThenBlock: {
                                            IfCondition EqualTo(bi, 0) ThenBlock: { is_idx = 0 }
                                            IfCondition GreaterThan(bi, 0) ThenBlock: { is_idx = 2 }
                                        } ElseBlock: {
                                            ch = JSRT_StrUnit(kp, bi)
                                            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                                                is_idx = 0
                                            } ElseBlock: {
                                                idxn = Add(Multiply(idxn, 10), Subtract(ch, 48))
                                                bi = Add(bi, 1)
                                                IfCondition GreaterThan(bi, 10) ThenBlock: { is_idx = 0 }
                                            }
                                        }
                                    }
                                    IfCondition EqualTo(is_idx, 2) ThenBlock: {
                                        v = JSRT_ArrGet(src2, idxn)
                                        got_g = 1
                                    }
                                }
                                IfCondition EqualTo(got_g, 0) ThenBlock: {
                                    // UTF-16-safe __get_<name> for defineProperty / lit getters
                                    nlen_as = JSRT_StrLen(kp)
                                    IfCondition LessThan(nlen_as, 100) ThenBlock: {
                                        gk_as = JSVMCallBuf.getter_buf
                                        SetByte(gk_as, 0, 95)
                                        SetByte(gk_as, 1, 95)
                                        SetByte(gk_as, 2, 103)
                                        SetByte(gk_as, 3, 101)
                                        SetByte(gk_as, 4, 116)
                                        SetByte(gk_as, 5, 95)
                                        gi_as = 0
                                        WhileLoop LessThan(gi_as, nlen_as) {
                                            u_as = JSRT_StrUnit(kp, gi_as)
                                            IfCondition GreaterThan(u_as, 255) ThenBlock: { u_as = 63 }
                                            SetByte(gk_as, Add(6, gi_as), u_as)
                                            gi_as = Add(gi_as, 1)
                                        }
                                        SetByte(gk_as, Add(6, nlen_as), 0)
                                        JSBridge__Push(target)
                                        JSBridge__Push(save_args)
                                        JSBridge__Push(save_argc)
                                        JSBridge__Push(si)
                                        JSBridge__Push(keys)
                                        JSBridge__Push(ki)
                                        JSBridge__Push(klen)
                                        JSBridge__Push(src2)
                                        gfn_as = JSRT_ObjGet(src2, gk_as)
                                        src2 = JSBridge__Pop()
                                        klen = JSBridge__Pop()
                                        ki = JSBridge__Pop()
                                        keys = JSBridge__Pop()
                                        si = JSBridge__Pop()
                                        save_argc = JSBridge__Pop()
                                        save_args = JSBridge__Pop()
                                        target = JSBridge__Pop()
                                        IfCondition EqualTo(JSRT_GetType(gfn_as), JSType.FUNCTION) ThenBlock: {
                                            save_this_as = JSVM__GetGlobal("this")
                                            JSVM__SetGlobal("this", src2)
                                            empty_as = JSVMCallBuf.buf
                                            JSBridge__Push(target)
                                            JSBridge__Push(save_args)
                                            JSBridge__Push(save_argc)
                                            JSBridge__Push(si)
                                            JSBridge__Push(keys)
                                            JSBridge__Push(ki)
                                            JSBridge__Push(klen)
                                            JSBridge__Push(src2)
                                            v = JSVM__CallFunc(gfn_as, empty_as, 0)
                                            src2 = JSBridge__Pop()
                                            klen = JSBridge__Pop()
                                            ki = JSBridge__Pop()
                                            keys = JSBridge__Pop()
                                            si = JSBridge__Pop()
                                            save_argc = JSBridge__Pop()
                                            save_args = JSBridge__Pop()
                                            target = JSBridge__Pop()
                                            JSVM__SetGlobal("this", save_this_as)
                                            got_g = 1
                                        }
                                    }
                                }
                                IfCondition EqualTo(got_g, 0) ThenBlock: {
                                    v = JSRT_ObjGet(src2, kp)
                                }
                                klen = JSBridge__Pop()
                                ki = JSBridge__Pop()
                                keys = JSBridge__Pop()
                                si = JSBridge__Pop()
                                save_argc = JSBridge__Pop()
                                save_args = JSBridge__Pop()
                                target = JSBridge__Pop()
                                // M128e7c0: Set(to, key, v, true) — honor setters + [[Writable]]
                                // (was raw ObjSet: freeze/seal assign never TypeError'd)
                                JSBridge__Push(target)
                                JSBridge__Push(save_args)
                                JSBridge__Push(save_argc)
                                JSBridge__Push(si)
                                JSBridge__Push(keys)
                                JSBridge__Push(ki)
                                JSBridge__Push(klen)
                                JSBridge__Push(v)
                                JSBridge__Push(kp)
                                // build __set_<key>
                                nlen_set = JSRT_StrLen(kp)
                                did_set_as = 0
                                IfCondition LessThan(nlen_set, 100) ThenBlock: {
                                    sk_as = JSVMCallBuf.getter_buf
                                    SetByte(sk_as, 0, 95)
                                    SetByte(sk_as, 1, 95)
                                    SetByte(sk_as, 2, 115)
                                    SetByte(sk_as, 3, 101)
                                    SetByte(sk_as, 4, 116)
                                    SetByte(sk_as, 5, 95)
                                    gi_s = 0
                                    WhileLoop LessThan(gi_s, nlen_set) {
                                        u_s = JSRT_StrUnit(kp, gi_s)
                                        IfCondition GreaterThan(u_s, 255) ThenBlock: { u_s = 63 }
                                        SetByte(sk_as, Add(6, gi_s), u_s)
                                        gi_s = Add(gi_s, 1)
                                    }
                                    SetByte(sk_as, Add(6, nlen_set), 0)
                                    sfn_as = JSRT_ObjGet(target, sk_as)
                                    IfCondition EqualTo(JSRT_GetType(sfn_as), JSType.FUNCTION) ThenBlock: {
                                        save_this_s = JSVM__GetGlobal("this")
                                        JSVM__SetGlobal("this", target)
                                        ab_s = JSVMCallBuf.buf
                                        StoreValue(ab_s, v)
                                        JSVM__CallFunc(sfn_as, ab_s, 1)
                                        JSVM__SetGlobal("this", save_this_s)
                                        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                                            // rethrow user setter error
                                            pend_as = JSVMCall.thrown_val
                                            IfCondition EqualTo(pend_as, 0) ThenBlock: { pend_as = JSVMState.exc_val }
                                            JSVMCall.thrown_val = 0
                                            JSVMState.exc_val = 0
                                            JSVMCall.exc_prop = 0
                                            IfCondition And(NotEqual(pend_as, 0), NotEqual(pend_as, JSRTState.undef_val)) ThenBlock: {
                                                JSVM__SetGlobal("__pend_exc__", pend_as)
                                                JSVMCall.exc_prop = 1
                                                JSVMCall.thrown_val = pend_as
                                                JSVM_ThrowValue(pend_as)
                                            }
                                            ReturnValue(JSRT_Undefined())
                                        }
                                        did_set_as = 1
                                    }
                                }
                                IfCondition EqualTo(did_set_as, 0) ThenBlock: {
                                    can_as = JSBridge_CanAssign(target, kp)
                                    IfCondition EqualTo(can_as, 0) ThenBlock: {
                                        terr = JSVM_CreateTypedError("TypeError", "Cannot assign to non-writable property")
                                        JSVM__SetGlobal("__pend_exc__", terr)
                                        JSVMCall.exc_prop = 1
                                        JSVMCall.thrown_val = terr
                                        JSVM_ThrowValue(terr)
                                        ReturnValue(JSRT_Undefined())
                                    }
                                    JSRT_ObjSet(target, kp, v)
                                }
                                kp = JSBridge__Pop()
                                v = JSBridge__Pop()
                                klen = JSBridge__Pop()
                                ki = JSBridge__Pop()
                                keys = JSBridge__Pop()
                                si = JSBridge__Pop()
                                save_argc = JSBridge__Pop()
                                save_args = JSBridge__Pop()
                                target = JSBridge__Pop()
                                ki = Add(ki, 1)
                            }
                        }
                        si = JSBridge__Pop()
                        save_argc = JSBridge__Pop()
                        save_args = JSBridge__Pop()
                        target = JSBridge__Pop()
                    }
                    si = Add(si, 1)
                }
            }
        }
        ReturnValue(target)
    }
}


// Object.entries(O) — M34: ToObject, enumerable own string keys → [[k,v],...]
Function.JSBridge__NObjEntries {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        result = JSRT_CreateArray()
        IfCondition LessThan(argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        obj = Dereference(args)
        ot = JSRT_GetType(obj)
        IfCondition Or(EqualTo(ot, JSType.NULL), EqualTo(ot, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        // String exotic: indices as entries
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(obj)
            slen = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { slen = JSRT_StrLen(sp) }
            ai = 0
            WhileLoop LessThan(ai, slen) {
                JSBridge__Push(result)
                JSBridge__Push(sp)
                JSBridge__Push(slen)
                JSBridge__Push(ai)
                chv = JSRT_CreateStringSlice(sp, ai, 1)
                ksv = JSRT_CreateString(JSRT__IntToStr(ai))
                pair = JSRT_CreateArray()
                JSRT_ArrPush(pair, ksv)
                JSRT_ArrPush(pair, chv)
                ai = JSBridge__Pop()
                slen = JSBridge__Pop()
                sp = JSBridge__Pop()
                result = JSBridge__Pop()
                JSBridge__Push(result)
                JSBridge__Push(sp)
                JSBridge__Push(slen)
                JSBridge__Push(ai)
                JSRT_ArrPush(result, pair)
                ai = JSBridge__Pop()
                slen = JSBridge__Pop()
                sp = JSBridge__Pop()
                result = JSBridge__Pop()
                ai = Add(ai, 1)
            }
            ReturnValue(result)
        }
        // Object / Array / Function — ObjKeys is enumerable own
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: {
                // other primitives → empty (boxed would have no enum own)
                ReturnValue(result)
            }
        }
        JSBridge__Push(result)
        keys = JSRT_ObjKeys(obj)
        result = JSBridge__Pop()
        // For arrays also emit dense indices (ObjKeys may miss pure element storage)
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            alen = JSRT_ArrLen(obj)
            ai = 0
            WhileLoop LessThan(ai, alen) {
                IfCondition NotEqual(JSRT_ArrHas(obj, ai), 0) ThenBlock: {
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(keys)
                    JSBridge__Push(ai)
                    JSBridge__Push(alen)
                    ksv = JSRT_CreateString(JSRT__IntToStr(ai))
                    v = JSRT_ArrGet(obj, ai)
                    pair = JSRT_CreateArray()
                    JSRT_ArrPush(pair, ksv)
                    JSRT_ArrPush(pair, v)
                    alen = JSBridge__Pop()
                    ai = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(keys)
                    JSBridge__Push(ai)
                    JSBridge__Push(alen)
                    JSRT_ArrPush(result, pair)
                    alen = JSBridge__Pop()
                    ai = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                }
                ai = Add(ai, 1)
            }
            // named side props via keys (skip pure indices already emitted)
            klen = JSRT_ArrLen(keys)
            ki = 0
            WhileLoop LessThan(ki, klen) {
                JSBridge__Push(result)
                JSBridge__Push(obj)
                JSBridge__Push(keys)
                JSBridge__Push(ki)
                ksv = JSRT_ArrGet(keys, ki)
                kp = JSRT_GetPayload(ksv)
                // skip decimal indices
                is_idx = 1
                bi = 0
                nkey = JSRT_StrLen(kp)
                IfCondition EqualTo(nkey, 0) ThenBlock: { is_idx = 0 }
                WhileLoop EqualTo(is_idx, 1) {
                    IfCondition GreaterEqual(bi, nkey) ThenBlock: {
                        IfCondition EqualTo(bi, 0) ThenBlock: { is_idx = 0 }
                        IfCondition GreaterThan(bi, 0) ThenBlock: { is_idx = 2 }
                    } ElseBlock: {
                        ch = JSRT_StrUnit(kp, bi)
                        IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                            is_idx = 0
                        } ElseBlock: {
                            bi = Add(bi, 1)
                            IfCondition GreaterThan(bi, 10) ThenBlock: { is_idx = 0 }
                        }
                    }
                }
                IfCondition NotEqual(is_idx, 2) ThenBlock: {
                    v = JSRT_ObjGet(obj, kp)
                    pair = JSRT_CreateArray()
                    JSRT_ArrPush(pair, ksv)
                    JSRT_ArrPush(pair, v)
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(keys)
                    JSBridge__Push(ki)
                    JSRT_ArrPush(result, pair)
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                } ElseBlock: {
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                }
                ki = Add(ki, 1)
            }
            ReturnValue(result)
        }
        klen = JSRT_ArrLen(keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            JSBridge__Push(result)
            JSBridge__Push(obj)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            ksv = JSRT_ArrGet(keys, ki)
            kp = JSRT_GetPayload(ksv)
            v = JSRT_ObjGet(obj, kp)
            pair = JSRT_CreateArray()
            JSRT_ArrPush(pair, ksv)
            JSRT_ArrPush(pair, v)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            obj = JSBridge__Pop()
            result = JSBridge__Pop()
            JSBridge__Push(result)
            JSBridge__Push(obj)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            JSRT_ArrPush(result, pair)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            obj = JSBridge__Pop()
            result = JSBridge__Pop()
            ki = Add(ki, 1)
        }
        ReturnValue(result)
    }
}


// Object.values(O)
Function.JSBridge__NObjValues {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        // Reuse entries then project — simpler consistency
        // Direct path for speed
        result = JSRT_CreateArray()
        IfCondition LessThan(argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        obj = Dereference(args)
        ot = JSRT_GetType(obj)
        IfCondition Or(EqualTo(ot, JSType.NULL), EqualTo(ot, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Cannot convert undefined or null to object")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(result)
        }
        IfCondition EqualTo(ot, JSType.STRING) ThenBlock: {
            sp = JSRT_GetPayload(obj)
            slen = 0
            IfCondition NotEqual(sp, 0) ThenBlock: { slen = JSRT_StrLen(sp) }
            ai = 0
            WhileLoop LessThan(ai, slen) {
                JSBridge__Push(result)
                JSBridge__Push(sp)
                JSBridge__Push(slen)
                JSBridge__Push(ai)
                chv = JSRT_CreateStringSlice(sp, ai, 1)
                ai = JSBridge__Pop()
                slen = JSBridge__Pop()
                sp = JSBridge__Pop()
                result = JSBridge__Pop()
                JSBridge__Push(result)
                JSBridge__Push(sp)
                JSBridge__Push(slen)
                JSBridge__Push(ai)
                JSRT_ArrPush(result, chv)
                ai = JSBridge__Pop()
                slen = JSBridge__Pop()
                sp = JSBridge__Pop()
                result = JSBridge__Pop()
                ai = Add(ai, 1)
            }
            ReturnValue(result)
        }
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: {
            alen = JSRT_ArrLen(obj)
            ai = 0
            WhileLoop LessThan(ai, alen) {
                IfCondition NotEqual(JSRT_ArrHas(obj, ai), 0) ThenBlock: {
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(ai)
                    JSBridge__Push(alen)
                    v = JSRT_ArrGet(obj, ai)
                    alen = JSBridge__Pop()
                    ai = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(ai)
                    JSBridge__Push(alen)
                    JSRT_ArrPush(result, v)
                    alen = JSBridge__Pop()
                    ai = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                }
                ai = Add(ai, 1)
            }
            JSBridge__Push(result)
            JSBridge__Push(obj)
            keys = JSRT_ObjKeys(obj)
            obj = JSBridge__Pop()
            result = JSBridge__Pop()
            klen = JSRT_ArrLen(keys)
            ki = 0
            WhileLoop LessThan(ki, klen) {
                JSBridge__Push(result)
                JSBridge__Push(obj)
                JSBridge__Push(keys)
                JSBridge__Push(ki)
                ksv = JSRT_ArrGet(keys, ki)
                kp = JSRT_GetPayload(ksv)
                is_idx = 1
                bi = 0
                nkey = JSRT_StrLen(kp)
                IfCondition EqualTo(nkey, 0) ThenBlock: { is_idx = 0 }
                WhileLoop EqualTo(is_idx, 1) {
                    IfCondition GreaterEqual(bi, nkey) ThenBlock: {
                        IfCondition EqualTo(bi, 0) ThenBlock: { is_idx = 0 }
                        IfCondition GreaterThan(bi, 0) ThenBlock: { is_idx = 2 }
                    } ElseBlock: {
                        ch = JSRT_StrUnit(kp, bi)
                        IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                            is_idx = 0
                        } ElseBlock: {
                            bi = Add(bi, 1)
                            IfCondition GreaterThan(bi, 10) ThenBlock: { is_idx = 0 }
                        }
                    }
                }
                IfCondition NotEqual(is_idx, 2) ThenBlock: {
                    v = JSRT_ObjGet(obj, kp)
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                    JSBridge__Push(result)
                    JSBridge__Push(obj)
                    JSBridge__Push(keys)
                    JSBridge__Push(ki)
                    JSRT_ArrPush(result, v)
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                } ElseBlock: {
                    ki = JSBridge__Pop()
                    keys = JSBridge__Pop()
                    obj = JSBridge__Pop()
                    result = JSBridge__Pop()
                }
                ki = Add(ki, 1)
            }
            ReturnValue(result)
        }
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            ReturnValue(result)
        }
        JSBridge__Push(result)
        keys = JSRT_ObjKeys(obj)
        result = JSBridge__Pop()
        klen = JSRT_ArrLen(keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            JSBridge__Push(result)
            JSBridge__Push(obj)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            ksv = JSRT_ArrGet(keys, ki)
            kp = JSRT_GetPayload(ksv)
            v = JSRT_ObjGet(obj, kp)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            obj = JSBridge__Pop()
            result = JSBridge__Pop()
            JSBridge__Push(result)
            JSBridge__Push(obj)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            JSRT_ArrPush(result, v)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            obj = JSBridge__Pop()
            result = JSBridge__Pop()
            ki = Add(ki, 1)
        }
        ReturnValue(result)
    }
}


// Object.fromEntries(iterable) — M34: array of [k,v] pairs → object
Function.JSBridge__NObjFromEntries {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        out = JSRT_CreateObject()
        IfCondition LessThan(argc, 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Object.fromEntries requires an argument")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(out)
        }
        src = Dereference(args)
        st = JSRT_GetType(src)
        // Expand non-array iterables once
        IfCondition NotEqual(st, JSType.ARRAY) ThenBlock: {
            JSBridge__Push(out)
            expanded = JSVM_IterableToArray(src)
            out = JSBridge__Pop()
            IfCondition EqualTo(expanded, 0) ThenBlock: {
                ReturnValue(out)
            }
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(out)
            }
            src = expanded
            st = JSType.ARRAY
        }
        n = JSRT_ArrLen(src)
        i = 0
        WhileLoop LessThan(i, n) {
            JSBridge__Push(out)
            JSBridge__Push(src)
            JSBridge__Push(i)
            JSBridge__Push(n)
            entry = JSRT_ArrGet(src, i)
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            src = JSBridge__Pop()
            out = JSBridge__Pop()
            et = JSRT_GetType(entry)
            k = JSRT_Undefined()
            v = JSRT_Undefined()
            ok_entry = 0
            IfCondition EqualTo(et, JSType.ARRAY) ThenBlock: {
                JSBridge__Push(out)
                JSBridge__Push(src)
                JSBridge__Push(i)
                JSBridge__Push(n)
                k = JSRT_ArrGet(entry, 0)
                v = JSRT_ArrGet(entry, 1)
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                src = JSBridge__Pop()
                out = JSBridge__Pop()
                ok_entry = 1
            }
            IfCondition EqualTo(et, JSType.OBJECT) ThenBlock: {
                JSBridge__Push(out)
                JSBridge__Push(src)
                JSBridge__Push(i)
                JSBridge__Push(n)
                JSBridge__Push(entry)
                k = JSRT_ObjGet(entry, "0")
                v = JSRT_ObjGet(entry, "1")
                entry = JSBridge__Pop()
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                src = JSBridge__Pop()
                out = JSBridge__Pop()
                ok_entry = 1
            }
            IfCondition EqualTo(ok_entry, 0) ThenBlock: {
                terr = JSVM_CreateTypedError("TypeError", "Iterator value is not an entry object")
                JSVM__SetGlobal("__pend_exc__", terr)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = terr
                JSVM_ThrowValue(terr)
                ReturnValue(out)
            }
            JSBridge__Push(out)
            JSBridge__Push(src)
            JSBridge__Push(i)
            JSBridge__Push(n)
            JSBridge__Push(v)
            kptr = JSVM_ToPropertyKey(k)
            v = JSBridge__Pop()
            n = JSBridge__Pop()
            i = JSBridge__Pop()
            src = JSBridge__Pop()
            out = JSBridge__Pop()
            IfCondition NotEqual(kptr, 0) ThenBlock: {
                JSBridge__Push(out)
                JSBridge__Push(src)
                JSBridge__Push(i)
                JSBridge__Push(n)
                JSRT_ObjSet(out, kptr, v)
                n = JSBridge__Pop()
                i = JSBridge__Pop()
                src = JSBridge__Pop()
                out = JSBridge__Pop()
            }
            i = Add(i, 1)
        }
        ReturnValue(out)
    }
}


// M35: Boolean/Number/String wrapper valueOf — read [[PrimitiveValue]] (__value__)
// kind: 0=Boolean, 1=Number, 2=String
Function.JSBridge__NWrapperValueOf {
    Input: args: Address
    Input: argc: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        this_v = JSVM__GetGlobal("this")
        tt = JSRT_GetType(this_v)
        // bare primitive this
        IfCondition EqualTo(kind, 0) ThenBlock: {
            IfCondition EqualTo(tt, JSType.BOOLEAN) ThenBlock: { ReturnValue(this_v) }
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            IfCondition EqualTo(tt, JSType.NUMBER) ThenBlock: { ReturnValue(this_v) }
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            IfCondition EqualTo(tt, JSType.STRING) ThenBlock: { ReturnValue(this_v) }
        }
        IfCondition EqualTo(tt, JSType.OBJECT) ThenBlock: {
            // [[NumberData]] is an own slot. ObjGet would inherit
            // Number.prototype.__value__ onto Object.create(Number.prototype).
            skip_box = 0
            IfCondition EqualTo(kind, 1) ThenBlock: {
                JSBridge__Push(this_v)
                own_n = JSRT_ObjHas(this_v, "__value__")
                this_v = JSBridge__Pop()
                IfCondition EqualTo(own_n, 0) ThenBlock: {
                    skip_box = 1
                }
            }
            IfCondition EqualTo(skip_box, 0) ThenBlock: {
            JSBridge__Push(this_v)
            prim = JSRT_ObjGet(this_v, "__value__")
            this_v = JSBridge__Pop()
            pt = JSRT_GetType(prim)
            IfCondition EqualTo(kind, 0) ThenBlock: {
                IfCondition EqualTo(pt, JSType.BOOLEAN) ThenBlock: { ReturnValue(prim) }
            }
            IfCondition EqualTo(kind, 1) ThenBlock: {
                IfCondition EqualTo(pt, JSType.NUMBER) ThenBlock: { ReturnValue(prim) }
            }
            IfCondition EqualTo(kind, 2) ThenBlock: {
                IfCondition EqualTo(pt, JSType.STRING) ThenBlock: { ReturnValue(prim) }
            }
            }
        }
        terr = JSVM_CreateTypedError("TypeError", "valueOf called on incompatible receiver")
        JSVM__SetGlobal("__pend_exc__", terr)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = terr
        JSVM_ThrowValue(terr)
        ReturnValue(JSRT_Undefined())
    }
}


// M35: wrapper toString — Boolean "true"/"false", Number decimal, String content
Function.JSBridge__NWrapperToString {
    Input: args: Address
    Input: argc: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        // Number.prototype.toString honors radix. Boolean and String stay decimal.
        IfCondition EqualTo(kind, 1) ThenBlock: {
            ReturnValue(JSNum__NumberToString(args, argc))
        }
        // valueOf first then ToString
        vv = JSBridge__NWrapperValueOf(args, argc, kind)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(JSRT_ToString(vv))
    }
}


// Box a BigInt primitive onto BigInt.prototype. No __class__ brand.
Function.JSBridge__BoxBigInt {
    Input: prim: Address
    Output: Address
    Body: {
        save_p = prim
        JSBridge__Push(save_p)
        big = JSVM__GetGlobal("BigInt")
        bp = JSRT_ObjGet(big, "prototype")
        JSBridge__Push(bp)
        box = JSRT_CreateObject()
        bp = JSBridge__Pop()
        save_p = JSBridge__Pop()
        has_bp = 0
        IfCondition EqualTo(JSRT_GetType(bp), JSType.OBJECT) ThenBlock: {
            has_bp = 1
        }
        IfCondition EqualTo(has_bp, 1) ThenBlock: {
            JSBridge__Push(save_p)
            JSBridge__Push(box)
            JSRT_ObjSet(box, "__proto__", bp)
            box = JSBridge__Pop()
            save_p = JSBridge__Pop()
        }
        JSBridge__Push(box)
        JSRT_ObjSet(box, "__value__", save_p)
        box = JSBridge__Pop()
        ReturnValue(box)
    }
}


// 1 = array, 2 = function, 0 = neither, -1 = revoked (TypeError already thrown).
// Walks proxy targets. Does not use JSRTState.ots_hold.
Function.JSBridge__ProxyBuiltin {
    Input: obj: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        JSRTStack.hold = obj
        JSRTStack.hold2 = depth
        IfCondition GreaterThan(JSRTStack.hold2, 8) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSRTStack.hold, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSVM__IsProxy(JSRTStack.hold), 0) ThenBlock: {
            tt = JSRT_GetType(JSRTStack.hold)
            IfCondition EqualTo(tt, JSType.ARRAY) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: { ReturnValue(2) }
            ReturnValue(0)
        }
        JSBridge__Push(JSRTStack.hold)
        hv = JSRT_ObjGet(JSRTStack.hold, "__p_h__")
        JSRTStack.hold = hv
        ht = JSRT_GetType(JSRTStack.hold)
        IfCondition Or(EqualTo(JSRTStack.hold, 0), Or(EqualTo(ht, JSType.NULL), EqualTo(ht, JSType.UNDEFINED))) ThenBlock: {
            JSBridge__Pop()
            terr = JSVM_CreateTypedError("TypeError", "revoked proxy")
            JSVM_ThrowValue(terr)
            ReturnValue(-1)
        }
        JSRTStack.hold = JSBridge__Pop()
        JSBridge__Push(JSRTStack.hold)
        tv = JSRT_ObjGet(JSRTStack.hold, "__p_t__")
        JSRTStack.hold = tv
        tt = JSRT_GetType(JSRTStack.hold)
        IfCondition EqualTo(tt, JSType.ARRAY) ThenBlock: {
            JSBridge__Pop()
            ReturnValue(1)
        }
        IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: {
            JSBridge__Pop()
            ReturnValue(2)
        }
        IfCondition EqualTo(JSVM__IsProxy(JSRTStack.hold), 1) ThenBlock: {
            JSBridge__Pop()
            JSRTStack.hold2 = Add(JSRTStack.hold2, 1)
            tv = JSBridge__ProxyBuiltin(JSRTStack.hold, JSRTStack.hold2)
            ReturnValue(tv)
        }
        JSBridge__Pop()
        ReturnValue(0)
    }
}


// Object.prototype.toString — M34/M45: @@toStringTag then builtin brand
Function.JSBridge__NObjProtoToString {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        // this value
        this_v = JSVM__GetGlobal("this")
        tt = JSRT_GetType(this_v)
        // ES: undefined/null before ToObject
        IfCondition EqualTo(tt, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Undefined]"))
        }
        IfCondition EqualTo(tt, JSType.NULL) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Null]"))
        }
        // ToObject so @@toStringTag on Boolean/Number/String/BigInt.prototype is visible.
        // BigInt is not a builtin brand: a non-string tag must fall through to Object.
        IfCondition Or(EqualTo(tt, JSType.BOOLEAN), EqualTo(tt, JSType.NUMBER)) ThenBlock: {
            this_v = JSVM__ArrayToObject(this_v)
            tt = JSType.OBJECT
        }
        IfCondition EqualTo(tt, JSType.STRING) ThenBlock: {
            this_v = JSVM__ArrayCallbackThis(this_v)
            tt = JSType.OBJECT
        }
        IfCondition EqualTo(tt, JSType.BIGINT) ThenBlock: {
            this_v = JSBridge__BoxBigInt(this_v)
            tt = JSType.OBJECT
        }
        // Proxy IsArray / [[Call]] before Get. 1 = Array, 2 = Function.
        // Brand stays on the JSBridge stack so a revoke inside Get still returns it.
        JSRTStack.hold2 = this_v
        JSBridge__Push(JSRTState.ots_hold)
        JSRTState.ots_hold = JSRTStack.hold2
        pbrand = 0
        tt = JSRT_GetType(JSRTState.ots_hold)
        is_objish = 0
        IfCondition Or(Or(EqualTo(tt, JSType.OBJECT), EqualTo(tt, JSType.ARRAY)), EqualTo(tt, JSType.FUNCTION)) ThenBlock: {
            is_objish = 1
        }
        IfCondition EqualTo(is_objish, 1) ThenBlock: {
            pbrand = JSBridge__ProxyBuiltin(JSRTState.ots_hold, 0)
        }
        IfCondition EqualTo(pbrand, -1) ThenBlock: {
            JSRTState.ots_hold = JSBridge__Pop()
            ReturnValue(JSRT_Undefined())
        }
        JSBridge__Push(pbrand)
        this_v = JSRTState.ots_hold
        // M45: @@toStringTag preferred for objects/arrays/functions/boxes
        IfCondition NotEqual(JSVMSymbol.toStringTag, 0) ThenBlock: {
            is_objish = 0
            IfCondition Or(Or(EqualTo(tt, JSType.OBJECT), EqualTo(tt, JSType.ARRAY)), EqualTo(tt, JSType.FUNCTION)) ThenBlock: {
                is_objish = 1
            }
            IfCondition EqualTo(is_objish, 1) ThenBlock: {
                JSBridge__Push(this_v)
                ttag_k = JSVM_SymbolToKey(JSVMSymbol.toStringTag)
                this_v = JSBridge__Pop()
                IfCondition NotEqual(ttag_k, 0) ThenBlock: {
                    JSBridge__Push(this_v)
                    ttag_v = JSVM__GetProperty(this_v, ttag_k)
                    this_v = JSBridge__Pop()
                    // A throwing getter must propagate. Stack stays balanced.
                    JSBridge__Push(this_v)
                    JSBridge__Push(ttag_v)
                    IfCondition EqualTo(JSVM_ErrorSawAbrupt(), 1) ThenBlock: {
                        ttag_v = JSBridge__Pop()
                        this_v = JSBridge__Pop()
                        JSBridge__Pop()
                        JSRTState.ots_hold = JSBridge__Pop()
                        ReturnValue(JSRT_Undefined())
                    }
                    ttag_v = JSBridge__Pop()
                    this_v = JSBridge__Pop()
                    IfCondition EqualTo(JSRT_GetType(ttag_v), JSType.STRING) ThenBlock: {
                        // Build "[object " + tag + "]"
                        tp = JSRT_GetPayload(ttag_v)
                        tlen = 0
                        IfCondition NotEqual(tp, 0) ThenBlock: { tlen = JSRT_StrLen(tp) }
                        // cap tag length
                        IfCondition GreaterThan(tlen, 64) ThenBlock: { tlen = 64 }
                        obuf = JSRT_StrAlloc(Add(9, tlen))
                        IfCondition NotEqual(obuf, 0) ThenBlock: {
                            // "[object "
                            JSRT_StrSetUnit(obuf, 0, 91)
                            JSRT_StrSetUnit(obuf, 1, 111)
                            JSRT_StrSetUnit(obuf, 2, 98)
                            JSRT_StrSetUnit(obuf, 3, 106)
                            JSRT_StrSetUnit(obuf, 4, 101)
                            JSRT_StrSetUnit(obuf, 5, 99)
                            JSRT_StrSetUnit(obuf, 6, 116)
                            JSRT_StrSetUnit(obuf, 7, 32)
                            ti = 0
                            WhileLoop LessThan(ti, tlen) {
                                JSRT_StrSetUnit(obuf, Add(8, ti), JSRT_StrUnit(tp, ti))
                                ti = Add(ti, 1)
                            }
                            JSRT_StrSetUnit(obuf, Add(8, tlen), 93)
                            val = JSRT__AllocValue()
                            IfCondition NotEqual(val, 0) ThenBlock: {
                                StoreValue(val, JSType.STRING)
                                StoreValue(Add(val, 8), obuf)
                                JSRTStack.hold = val
                                JSBridge__Pop()
                                JSRTState.ots_hold = JSBridge__Pop()
                                ReturnValue(JSRTStack.hold)
                            }
                        }
                    }
                }
            }
        }
        pbrand = JSBridge__Pop()
        JSRTStack.hold2 = pbrand
        JSRTStack.hold = JSRTState.ots_hold
        JSRTState.ots_hold = JSBridge__Pop()
        pbrand = JSRTStack.hold2
        this_v = JSRTStack.hold
        IfCondition EqualTo(pbrand, 1) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Array]"))
        }
        IfCondition EqualTo(pbrand, 2) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Function]"))
        }
        tt = JSRT_GetType(JSRTStack.hold)
        this_v = JSRTStack.hold
        // Builtin brands
        IfCondition EqualTo(tt, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Array]"))
        }
        IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Function]"))
        }
        IfCondition EqualTo(tt, JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object String]"))
        }
        IfCondition EqualTo(tt, JSType.NUMBER) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Number]"))
        }
        IfCondition EqualTo(tt, JSType.BOOLEAN) ThenBlock: {
            ReturnValue(JSRT_CreateString("[object Boolean]"))
        }
        // Symbol if present as type — else object brand
        IfCondition EqualTo(tt, JSType.OBJECT) ThenBlock: {
            // Arguments exotic
            IfCondition EqualTo(JSVM_IsArgumentsObj(this_v), 1) ThenBlock: {
                ReturnValue(JSRT_CreateString("[object Arguments]"))
            }
            // __class__ brand (Math, JSON, Date, RegExp, Promise, String box, …)
            JSBridge__Push(this_v)
            cls = JSRT_ObjGet(this_v, "__class__")
            this_v = JSBridge__Pop()
            IfCondition EqualTo(JSRT_GetType(cls), JSType.STRING) ThenBlock: {
                cp = JSRT_GetPayload(cls)
                // Build "[object " + class + "]"
                // Use known short brands via StrEq
                IfCondition EqualTo(JSRT_StrEq(cp, "Date"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Date]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "RegExp"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object RegExp]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "String"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object String]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Number"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Number]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Boolean"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Boolean]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Error"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Error]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Array"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Array]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Function"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Function]"))
                }
                IfCondition EqualTo(JSRT_StrEq(cp, "Arguments"), 1) ThenBlock: {
                    ReturnValue(JSRT_CreateString("[object Arguments]"))
                }
            }
            // RegExp via handle
            JSBridge__Push(this_v)
            rh = JSRT_ObjGet(this_v, "__regex_handle__")
            this_v = JSBridge__Pop()
            IfCondition EqualTo(JSRT_GetType(rh), JSType.NUMBER) ThenBlock: {
                ReturnValue(JSRT_CreateString("[object RegExp]"))
            }
            // [[ErrorData]] is an own slot. Error.prototype.name is "Error"
            // but the prototype itself is not an error instance.
            JSBridge__Push(this_v)
            ie = JSRT_ObjHas(this_v, "__is_error__")
            this_v = JSBridge__Pop()
            IfCondition EqualTo(ie, 1) ThenBlock: {
                ReturnValue(JSRT_CreateString("[object Error]"))
            }
        }
        ReturnValue(JSRT_CreateString("[object Object]"))
    }
}


// Object.freeze(obj) — non-extensible + all own props non-writable non-configurable
Function.JSBridge__NObjFreeze {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        IfCondition LessThan(argc, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        target = Dereference(args)
        ot = JSRT_GetType(target)
        // M27b: also freeze functions/arrays (primitives returned as-is)
        IfCondition And(NotEqual(ot, JSType.OBJECT), NotEqual(ot, JSType.FUNCTION)) ThenBlock: {
            IfCondition NotEqual(ot, JSType.ARRAY) ThenBlock: {
                ReturnValue(target)
            }
        }

        // Mark frozen + non-extensible
        JSBridge__Push(target)
        fv = JSRT_CreateBool(1)
        target = JSBridge__Pop()
        JSRT_ObjSet(target, "__frozen__", fv)
        JSBridge__Push(target)
        ex = JSRT_CreateBool(0)
        target = JSBridge__Pop()
        JSRT_ObjSet(target, "__extensible__", ex)

        // Clear W and C on all own user keys
        JSBridge__Push(target)
        keys = JSRT_ObjKeys(target)
        target = JSBridge__Pop()
        klen = JSRT_ArrLen(keys)
        ki = 0
        WhileLoop LessThan(ki, klen) {
            JSBridge__Push(target)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            ksv = JSRT_ArrGet(keys, ki)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            target = JSBridge__Pop()
            kp = JSRT_GetPayload(ksv)
            JSBridge__Push(target)
            JSBridge__Push(keys)
            JSBridge__Push(ki)
            bits = JSBridge__GetAttrBits(target, kp)
            // keep E only (bit 2) — clear W and C → bits & 2
            bits = BitwiseAnd(bits, JSAttr.E)
            ki = JSBridge__Pop()
            keys = JSBridge__Pop()
            target = JSBridge__Pop()
            JSBridge__SetAttrBits(target, kp, bits)
            ki = Add(ki, 1)
        }
        ReturnValue(target)
    }
}
