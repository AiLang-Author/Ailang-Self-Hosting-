        }
        IfCondition EqualTo(save_id, JSNativeID.WEAKSET_DELETE) ThenBlock: {
            disp_rv = JSBridge__DWEAKSET_DELETE(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        IfCondition And(GreaterEqual(save_id, JSNativeID.FUNC_TO_STRING), LessEqual(save_id, JSNativeID.FUNC_THROW_TYPE)) ThenBlock: {
            disp_rv = JSVM__DispatchFnProto(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // Unknown handler — return undefined
        PrintMessage("[JSBridge] unknown native id: ")
        PrintNumber(save_id)
        PrintMessage("\n")
        ReturnValue(JSRT_Undefined())
    }
}
