// Library.JSBridgePart8.ailang — JSBridge functions
// Moved out of Library.JSBridge.ailang. Pools stay in the parent.
// Split from the JS engine so one function fits in context.
// FixedPools stay in the parent library. Function names are unchanged
// except for the new helpers this split adds.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.


// =============================================================================
// NATIVE DISPATCH — route handler ID to the appropriate native impl
// Called by JSVM when handler_id >= 8.
// args = pointer to array of JSValue pointers (8 bytes each)
// argc = number of arguments
// Returns a JSValue pointer (result).
// =============================================================================
Function.JSBridge_Dispatch {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc

        // %AsyncFunction% is Function with a different prototype object.
        // Call and construct both build the function the way Function does.
        IfCondition EqualTo(save_id, JSNativeID.ASYNCFN_CTOR) ThenBlock: {
            disp_rv = JSVM__CallDynFn(save_args, save_argc, 2)
            ReturnValue(disp_rv)
        }
        IfCondition EqualTo(save_id, JSNativeID.GENFN_CTOR) ThenBlock: {
            disp_rv = JSVM__CallDynFn(save_args, save_argc, 1)
            ReturnValue(disp_rv)
        }

        // ─── M110 THENABLE_RESOLVE (273) ───
        IfCondition EqualTo(save_id, JSNativeID.THENABLE_RESOLVE) ThenBlock: {
            disp_rv = JSBridge__DTHENABLE_RESOLVE(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        // ─── M110 THENABLE_REJECT (274) ───
        IfCondition EqualTo(save_id, JSNativeID.THENABLE_REJECT) ThenBlock: {
            disp_rv = JSBridge__DTHENABLE_REJECT(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── CONSOLE_LOG (8) ───
        IfCondition EqualTo(save_id, JSNativeID.CONSOLE_LOG) ThenBlock: {
            disp_rv = JSBridge__DCONSOLE_LOG(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── DOC_GET_BY_ID (9) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_GET_BY_ID) ThenBlock: {
            disp_rv = JSBridge__DDOC_GET_BY_ID(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── DOC_QUERY_SEL (10) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_QUERY_SEL) ThenBlock: {
            disp_rv = JSBridge__DDOC_QUERY_SEL(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── DOC_CREATE_ELEM (11) — document.createElement(tag) ───
        IfCondition EqualTo(save_id, JSNativeID.DOC_CREATE_ELEM) ThenBlock: {
            disp_rv = JSBridge__DDOC_CREATE_ELEM(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ELEM_GET_ATTR (12) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_GET_ATTR) ThenBlock: {
            disp_rv = JSBridge__DELEM_GET_ATTR(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ELEM_SET_ATTR (13) — element.setAttribute(name, value) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_SET_ATTR) ThenBlock: {
            disp_rv = JSBridge__DELEM_SET_ATTR(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ELEM_ADD_LISTENER (14) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_ADD_LISTENER) ThenBlock: {
            disp_rv = JSBridge__DELEM_ADD_LISTENER(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ELEM_INNER_HTML_GET (15) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_INNER_HTML_GET) ThenBlock: {
            disp_rv = JSBridge__DELEM_INNER_HTML_GET(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ELEM_INNER_HTML_SET (16) — element.innerHTML = val ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_INNER_HTML_SET) ThenBlock: {
            disp_rv = JSBridge__DELEM_INNER_HTML_SET(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ELEM_TEXT_CONTENT (17) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_TEXT_CONTENT) ThenBlock: {
            disp_rv = JSBridge__DELEM_TEXT_CONTENT(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ELEM_APPEND_CHILD (18) — node.appendChild(child) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_APPEND_CHILD) ThenBlock: {
            disp_rv = JSBridge__DELEM_APPEND_CHILD(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ELEM_REMOVE_CHILD (19) — node.removeChild(child) ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_REMOVE_CHILD) ThenBlock: {
            disp_rv = JSBridge__DELEM_REMOVE_CHILD(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ELEM_STYLE_SET (20) — element.style.cssText = val ───
        IfCondition EqualTo(save_id, JSNativeID.ELEM_STYLE_SET) ThenBlock: {
            disp_rv = JSBridge__DELEM_STYLE_SET(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── SET_TIMEOUT (21) ───
        IfCondition EqualTo(save_id, JSNativeID.SET_TIMEOUT) ThenBlock: {
            disp_rv = JSBridge__DSET_TIMEOUT(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── SET_INTERVAL (22) ───
        IfCondition EqualTo(save_id, JSNativeID.SET_INTERVAL) ThenBlock: {
            disp_rv = JSBridge__DSET_INTERVAL(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── CLEAR_TIMEOUT (23) ───
        IfCondition EqualTo(save_id, JSNativeID.CLEAR_TIMEOUT) ThenBlock: {
            disp_rv = JSBridge__DCLEAR_TIMEOUT(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── PARSE_INT (24) ───
        IfCondition EqualTo(save_id, JSNativeID.PARSE_INT) ThenBlock: {
            disp_rv = JSBridge__DPARSE_INT(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── MATH_ABS (25) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_ABS) ThenBlock: {
            disp_rv = JSBridge__DMATH_ABS(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── MATH_MAX (26) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_MAX) ThenBlock: {
            disp_rv = JSBridge__DMATH_MAX(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── MATH_MIN (27) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_MIN) ThenBlock: {
            disp_rv = JSBridge__DMATH_MIN(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── MATH_FLOOR (28) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_FLOOR) ThenBlock: {
            disp_rv = JSBridge__DMATH_FLOOR(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── MATH_CEIL (79) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_CEIL) ThenBlock: {
            disp_rv = JSBridge__DMATH_CEIL(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── MATH_ROUND (80) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_ROUND) ThenBlock: {
            disp_rv = JSBridge__DMATH_ROUND(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── MATH_POW (81) ───
        IfCondition EqualTo(save_id, JSNativeID.MATH_POW) ThenBlock: {
            disp_rv = JSBridge__DMATH_POW(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── REGEXP_CTOR (82) — new RegExp(pattern, flags) ───
        IfCondition EqualTo(save_id, JSNativeID.REGEXP_CTOR) ThenBlock: {
            disp_rv = JSBridge__DREGEXP_CTOR(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_DEFINE_PROP (43) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_DEFINE_PROP) ThenBlock: {
            disp_rv = JSBridge__DOBJ_DEFINE_PROP(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_KEYS (44) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_KEYS) ThenBlock: {
            disp_rv = JSBridge__DOBJ_KEYS(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        // ─── OBJ_GET_OWN_PROP_NAMES (205) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_OWN_PROP_NAMES) ThenBlock: {
            disp_rv = JSBridge__DOBJ_GET_OWN_PROP_NAMES(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        // ─── OBJ_GET_OWN_PROP_DESCS (206) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_OWN_PROP_DESCS) ThenBlock: {
            disp_rv = JSBridge__DOBJ_GET_OWN_PROP_DESCS(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_CREATE (45) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_CREATE) ThenBlock: {
            disp_rv = JSBridge__DOBJ_CREATE(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── FUNC_PROTO (285) — Function.prototype itself (callable no-op → undefined)
        IfCondition EqualTo(save_id, JSNativeID.FUNC_PROTO) ThenBlock: {
            disp_rv = JSBridge__DFUNC_PROTO(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── FUNC_CALL (195) — Function.prototype.call ───
        IfCondition EqualTo(save_id, JSNativeID.FUNC_CALL) ThenBlock: {
            disp_rv = JSBridge__DFUNC_CALL(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        // ─── FUNC_APPLY (196) ───
        IfCondition EqualTo(save_id, JSNativeID.FUNC_APPLY) ThenBlock: {
            disp_rv = JSBridge__DFUNC_APPLY(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        // ─── FUNC_BIND (197) ───
        IfCondition EqualTo(save_id, JSNativeID.FUNC_BIND) ThenBlock: {
            disp_rv = JSBridge__DFUNC_BIND(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        // ─── FUNC_BOUND (198) ───
        IfCondition EqualTo(save_id, JSNativeID.FUNC_BOUND) ThenBlock: {
            disp_rv = JSBridge__DFUNC_BOUND(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_GET_OWN_PROP_DESC (46) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_OWN_PROP_DESC) ThenBlock: {
            disp_rv = JSBridge__DOBJ_GET_OWN_PROP_DESC(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        // ─── OBJ_GET_OWN_PROP_SYMBOLS (289) — body in JSVMObjectMethods ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_OWN_PROP_SYMBOLS) ThenBlock: {
            disp_rv = JSBridge__DOBJ_GET_OWN_PROP_SYMBOLS(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        // ─── OBJ_GROUP_BY (290) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GROUP_BY) ThenBlock: {
            disp_rv = JSBridge__DOBJ_GROUP_BY(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        // ─── OBJ_PROP_IS_ENUM (291) / DEFINE_GETTER (292) / DEFINE_SETTER (293) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_PROP_IS_ENUM) ThenBlock: {
            disp_rv = JSBridge__DOBJ_PROP_IS_ENUM(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        IfCondition EqualTo(save_id, JSNativeID.OBJ_DEFINE_GETTER) ThenBlock: {
            disp_rv = JSBridge__DOBJ_DEFINE_GETTER(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        IfCondition EqualTo(save_id, JSNativeID.OBJ_DEFINE_SETTER) ThenBlock: {
            disp_rv = JSBridge__DOBJ_DEFINE_SETTER(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_GET_PROTO_OF (47) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_GET_PROTO_OF) ThenBlock: {
            disp_rv = JSBridge__DOBJ_GET_PROTO_OF(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_SET_PROTO_OF (207) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_SET_PROTO_OF) ThenBlock: {
            disp_rv = JSBridge__DOBJ_SET_PROTO_OF(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_ASSIGN (48) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_ASSIGN) ThenBlock: {
            disp_rv = JSBridge__DOBJ_ASSIGN(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_FREEZE (49) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_FREEZE) ThenBlock: {
            disp_rv = JSBridge__DOBJ_FREEZE(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_SEAL (192) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_SEAL) ThenBlock: {
            disp_rv = JSBridge__DOBJ_SEAL(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_PREVENT_EXT (201) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_PREVENT_EXT) ThenBlock: {
            disp_rv = JSBridge__DOBJ_PREVENT_EXT(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_IS_EXTENSIBLE (202) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS_EXTENSIBLE) ThenBlock: {
            disp_rv = JSBridge__DOBJ_IS_EXTENSIBLE(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS_FROZEN) ThenBlock: {
            disp_rv = JSBridge__DOBJ_IS_FROZEN(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS_SEALED) ThenBlock: {
            disp_rv = JSBridge__DOBJ_IS_SEALED(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_IS (50) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS) ThenBlock: {
            disp_rv = JSBridge__DOBJ_IS(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_DEF_PROPERTIES (51) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_DEF_PROPERTIES) ThenBlock: {
            disp_rv = JSBridge__DOBJ_DEF_PROPERTIES(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_ENTRIES (52) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_ENTRIES) ThenBlock: {
            disp_rv = JSBridge__DOBJ_ENTRIES(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_VALUES (53) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_VALUES) ThenBlock: {
            disp_rv = JSBridge__DOBJ_VALUES(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_FROM_ENTRIES (234) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_FROM_ENTRIES) ThenBlock: {
            disp_rv = JSBridge__DOBJ_FROM_ENTRIES(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_PROTO_TO_STRING (235) — Object.prototype.toString ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_PROTO_TO_STRING) ThenBlock: {
            disp_rv = JSBridge__DOBJ_PROTO_TO_STRING(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── Boolean/Number/String.prototype valueOf/toString (236-240) ───
        IfCondition EqualTo(save_id, JSNativeID.BOOL_VALUE_OF) ThenBlock: {
            disp_rv = JSBridge__DBOOL_VALUE_OF(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        IfCondition EqualTo(save_id, JSNativeID.BOOL_TO_STRING) ThenBlock: {
            disp_rv = JSBridge__DBOOL_TO_STRING(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        IfCondition EqualTo(save_id, JSNativeID.NUM_VALUE_OF) ThenBlock: {
            disp_rv = JSBridge__DNUM_VALUE_OF(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        IfCondition EqualTo(save_id, JSNativeID.NUM_TO_STRING) ThenBlock: {
            disp_rv = JSBridge__DNUM_TO_STRING(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        IfCondition EqualTo(save_id, JSNativeID.STR_VALUE_OF) ThenBlock: {
            disp_rv = JSBridge__DSTR_VALUE_OF(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        IfCondition EqualTo(save_id, JSNativeID.STR_TO_STRING) ThenBlock: {
            disp_rv = JSBridge__DSTR_TO_STRING(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_PROTO_VALUE_OF (242) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_PROTO_VALUE_OF) ThenBlock: {
            disp_rv = JSBridge__DOBJ_PROTO_VALUE_OF(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_HAS_OWN_PROP (54) ───
        IfCondition EqualTo(save_id, JSNativeID.OBJ_HAS_OWN_PROP) ThenBlock: {
            disp_rv = JSBridge__DOBJ_HAS_OWN_PROP(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── REFLECT_HAS (286) ───
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_HAS) ThenBlock: {
            disp_rv = JSBridge__DREFLECT_HAS(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── REFLECT_GET (287) ───
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_GET) ThenBlock: {
            disp_rv = JSBridge__DREFLECT_GET(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── REFLECT_SET (288) ───
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_SET) ThenBlock: {
            disp_rv = JSBridge__DREFLECT_SET(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // Reflect.apply / defineProperty / deleteProperty / gOPD / getPrototypeOf
        // / isExtensible / ownKeys / preventExtensions / setPrototypeOf / construct
        // (435..444). construct is not itself a constructor.
        IfCondition And(GreaterEqual(save_id, JSNativeID.REFLECT_APPLY), LessEqual(save_id, JSNativeID.REFLECT_CONSTRUCT)) ThenBlock: {
            disp_rv = JSBridge__DReflect(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_IS_PROTO_OF (199) — V.isPrototypeOf(O)
        // Walk O's [[Prototype]] chain; true if V appears (SameRef for ObjSet copies).
        // Note: JSRT_ObjGet(fn,"__proto__") wrongly skips Function.prototype (FuncPropGet
        // falls through to function_proto.__proto__ = Object.prototype). Use implicit protos.
        IfCondition EqualTo(save_id, JSNativeID.OBJ_IS_PROTO_OF) ThenBlock: {
            disp_rv = JSBridge__DOBJ_IS_PROTO_OF(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_PROTO_HAS_OWN (200) — this.hasOwnProperty(key)
        IfCondition EqualTo(save_id, JSNativeID.OBJ_PROTO_HAS_OWN) ThenBlock: {
            disp_rv = JSBridge__DOBJ_PROTO_HAS_OWN(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── OBJ_LOOKUP_GETTER (270) / OBJ_LOOKUP_SETTER (271) ───
        // Walk [[Prototype]] for __get_/__set_<name>; return accessor fn or undefined.
        // Public "#m" does not match private mangled keys (M76 + private-is-not-own).
        IfCondition Or(EqualTo(save_id, JSNativeID.OBJ_LOOKUP_GETTER), EqualTo(save_id, JSNativeID.OBJ_LOOKUP_SETTER)) ThenBlock: {
            disp_rv = JSBridge__DOBJ_LOOKUP_GETTER(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ARR_IS_ARRAY (55) ───
        IfCondition EqualTo(save_id, JSNativeID.ARR_IS_ARRAY) ThenBlock: {
            disp_rv = JSBridge__DARR_IS_ARRAY(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ARR_FROM (56) ───
        IfCondition EqualTo(save_id, JSNativeID.ARR_FROM) ThenBlock: {
            disp_rv = JSBridge__DARR_FROM(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }
        // ─── ARR_OF (207) ───
        IfCondition EqualTo(save_id, JSNativeID.ARR_OF) ThenBlock: {
            disp_rv = JSBridge__DARR_OF(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ARR_VALUES / @@iterator (172) — kind 0 ───
        // ─── ARR_KEYS (240) — kind 1 ───
        // ─── ARR_ENTRIES (241) — kind 2 ───
        IfCondition Or(EqualTo(save_id, JSNativeID.ARR_VALUES), Or(EqualTo(save_id, JSNativeID.ARR_KEYS), EqualTo(save_id, JSNativeID.ARR_ENTRIES))) ThenBlock: {
            disp_rv = JSBridge__DARR_VALUES(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── ARR_ITER_NEXT (173) ───
        IfCondition EqualTo(save_id, JSNativeID.ARR_ITER_NEXT) ThenBlock: {
            disp_rv = JSBridge__DARR_ITER_NEXT(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── PROMISE_RESOLVE (57) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_RESOLVE) ThenBlock: {
            disp_rv = JSBridge__DPROMISE_RESOLVE(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── PROMISE_REJECT (58) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_REJECT) ThenBlock: {
            disp_rv = JSBridge__DPROMISE_REJECT(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

        // ─── PROMISE_THEN (59) ───
        IfCondition EqualTo(save_id, JSNativeID.PROMISE_THEN) ThenBlock: {
            disp_rv = JSBridge__DPROMISE_THEN(save_id, save_args, save_argc)
            ReturnValue(disp_rv)
        }

