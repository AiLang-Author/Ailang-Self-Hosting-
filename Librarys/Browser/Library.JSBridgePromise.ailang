    Body: {
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        ReturnValue(JSBridge__PromiseDoCombinator(2, JSBridgeTmp.obj, JSBridgeTmp.node, JSBridgeTmp.idx))
