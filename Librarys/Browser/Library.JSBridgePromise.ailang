}

Function.JSBridge__PromiseDoFinally {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSBridge__PThrow("Promise.prototype.finally called on non-object"))
        }
        IfCondition EqualTo(JSBridge__PSpecies(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        onf = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            onf = Dereference(JSBridgeTmp.node)
        }
        JSBridgeTmp.val = onf
        IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.val), 0) ThenBlock: {
            ret = JSBridge__PInvokeThen(JSBridgeTmp.obj, JSBridgeTmp.val, JSBridgeTmp.val)
            JSBridgeTmp.result = ret
            ReturnValue(JSBridgeTmp.result)
        }
        // Species result is the constructor. Build two thunks bound to onFinally.
        // PMakeElem overwrites obj and val, so keep the promise and callback on a holder.
        JSBridgeTmp.val2 = JSBridgeTmp.result
        hold = JSRT_CreateObject()
        JSBridgeTmp.ptr = hold
        JSRT_ObjSet(JSBridgeTmp.ptr, "__p__", JSBridgeTmp.obj)
        JSRT_ObjSet(JSBridgeTmp.ptr, "__cb__", JSBridgeTmp.val)
        el1 = JSBridge__PMakeElem(5, 0)
        JSBridgeTmp.cb_val = el1
        env1 = JSRT_FuncGetEnv(JSBridgeTmp.cb_val)
        JSBridgeTmp.type = env1
        cbf = JSRT_ObjGet(JSBridgeTmp.ptr, "__cb__")
        JSBridgeTmp.val = cbf
        JSRT_ObjSet(JSBridgeTmp.type, "__cb__", JSBridgeTmp.val)
        el2 = JSBridge__PMakeElem(6, 0)
        JSBridgeTmp.len = el2
        env2 = JSRT_FuncGetEnv(JSBridgeTmp.len)
        JSBridgeTmp.type = env2
        cbf2 = JSRT_ObjGet(JSBridgeTmp.ptr, "__cb__")
        JSBridgeTmp.val = cbf2
        JSRT_ObjSet(JSBridgeTmp.type, "__cb__", JSBridgeTmp.val)
        prec = JSRT_ObjGet(JSBridgeTmp.ptr, "__p__")
        JSBridgeTmp.obj = prec
        ret2 = JSBridge__PInvokeThen(JSBridgeTmp.obj, JSBridgeTmp.cb_val, JSBridgeTmp.len)
        JSBridgeTmp.result = ret2
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__PromiseDoTry {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        // Copy args before NewPromiseCapability. super() reuses JSVMCallBuf.
        ncopy = JSBridgeTmp.idx
        IfCondition GreaterThan(ncopy, 16) ThenBlock: { ncopy = 16 }
        IfCondition LessThan(ncopy, 0) ThenBlock: { ncopy = 0 }
        buf = Allocate(128)
        JSBridgeTmp.addr = buf
        IfCondition EqualTo(JSBridgeTmp.addr, 0) ThenBlock: {
            ReturnValue(JSBridge__PThrow("out of memory"))
        }
        ci = 0
        WhileLoop LessThan(ci, ncopy) {
            JSBridgeTmp.len = ci
            JSBridgeTmp.val = Dereference(Add(JSBridgeTmp.node, Multiply(JSBridgeTmp.len, 8)))
            StoreValue(Add(JSBridgeTmp.addr, Multiply(JSBridgeTmp.len, 8)), JSBridgeTmp.val)
            ci = Add(JSBridgeTmp.len, 1)
        }
        JSBridgeTmp.count = ncopy
        JSBridge__Push(JSBridgeTmp.addr)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridgeTmp.ptr = JSBridge__PNewCap(JSBridgeTmp.obj)
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.addr = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            Deallocate(JSBridgeTmp.addr, 128)
            JSBridgeTmp.addr = 0
            ReturnValue(JSRTState.undef_val)
        }
        JSBridgeTmp.idx = JSBridgeTmp.count
        cb = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            cb = Dereference(JSBridgeTmp.addr)
        }
        JSBridgeTmp.val = cb
        nrest = 0
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            nrest = Subtract(JSBridgeTmp.idx, 1)
        }
        JSBridgeTmp.val2 = JSBridgeTmp.addr
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            JSBridgeTmp.val2 = Add(JSBridgeTmp.addr, 8)
        }
        JSBridgeTmp.count = nrest
        JSBridgeTmp.dom_idx = JSBridge__PromiseCallN(JSBridgeTmp.val, JSRTState.undef_val, JSBridgeTmp.val2, JSBridgeTmp.count)
        Deallocate(JSBridgeTmp.addr, 128)
        JSBridgeTmp.addr = 0
        IfCondition EqualTo(JSBridgeTmp.dom_idx, 0) ThenBlock: {
            jf = JSBridge__PGet("__rej__")
            JSBridgeTmp.val = jf
            JSBridge__PromiseCallRaw(JSBridgeTmp.val, JSRTState.undef_val, JSBridgeTmp.found, JSRTState.undef_val, 1)
        } ElseBlock: {
            JSBridgeTmp.cb_val = JSBridgeTmp.result
            rf = JSBridge__PGet("__res__")
            JSBridgeTmp.val = rf
            JSBridge__PromiseCallRaw(JSBridgeTmp.val, JSRTState.undef_val, JSBridgeTmp.cb_val, JSRTState.undef_val, 1)
        }
        pret = JSBridge__PGet("__p__")
        JSBridgeTmp.result = pret
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__PromiseDoWithResolvers {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.obj = recv
        cap = JSBridge__PNewCap(JSBridgeTmp.obj)
        JSBridgeTmp.ptr = cap
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        o = JSRT_CreateObject()
        JSBridgeTmp.obj = o
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(JSBridgeTmp.obj, "__proto__", JSRTState.object_proto)
        }
        JSBridge__PGet("__p__")
        JSBridgeTmp.val = JSBridgeTmp.result
        JSRT_ObjSet(JSBridgeTmp.obj, "promise", JSBridgeTmp.val)
        JSBridge__PGet("__res__")
        JSBridgeTmp.val = JSBridgeTmp.result
        JSRT_ObjSet(JSBridgeTmp.obj, "resolve", JSBridgeTmp.val)
        JSBridge__PGet("__rej__")
        JSBridgeTmp.val = JSBridgeTmp.result
        JSRT_ObjSet(JSBridgeTmp.obj, "reject", JSBridgeTmp.val)
        // Function values default non-enumerable. These are ordinary data properties.
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__SetAttrBits(JSBridgeTmp.obj, "reject", JSAttr.DEFAULT)
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__SetAttrBits(JSBridgeTmp.obj, "resolve", JSAttr.DEFAULT)
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__SetAttrBits(JSBridgeTmp.obj, "promise", JSAttr.DEFAULT)
        ReturnValue(JSBridgeTmp.obj)
    }
}

// mode 5 allKeyed, 6 allSettledKeyed. String keys via Object.keys.
Function.JSBridge__PromiseDoKeyed {
    Input: mode: Integer
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.count = mode
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        JSBridgeTmp.type = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            JSBridgeTmp.type = Dereference(JSBridgeTmp.node)
        }
        JSBridge__Push(JSBridgeTmp.node)
        JSBridge__Push(JSBridgeTmp.type)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridge__Push(JSBridgeTmp.idx)
        JSBridgeTmp.ptr = JSBridge__PNewCap(JSBridgeTmp.obj)
        JSBridgeTmp.idx = JSBridge__Pop()
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.type = JSBridge__Pop()
        JSBridgeTmp.node = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSBridgeTmp.val = JSBridgeTmp.type
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.val), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Promise keyed combinator requires an object")
            JSBridgeTmp.found = terr
            ReturnValue(JSBridge__PRejectFound())
        }
        JSBridge__MapSaveState()
        rsf = JSVM__ObjGetAcc(JSBridgeTmp.obj, "resolve")
        JSBridgeTmp.result = rsf
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            e = JSBridge__MapCapture()
            JSBridgeTmp.found = e
            ReturnValue(JSBridge__PRejectFound())
        }
        IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.result), 0) ThenBlock: {
            terr2 = JSVM_CreateTypedError("TypeError", "resolve is not a function")
            JSBridgeTmp.found = terr2
            ReturnValue(JSBridge__PRejectFound())
        }
        JSBridgeTmp.cb_val = JSBridgeTmp.result
        keys = JSRT_ObjKeys(JSBridgeTmp.val)
        JSBridgeTmp.val2 = keys
        slot = JSRT_CreateObject()
        JSBridgeTmp.dom_idx = slot
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__cap__", JSBridgeTmp.ptr)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__c__", JSBridgeTmp.obj)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__rs__", JSBridgeTmp.cb_val)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__keys__", JSBridgeTmp.val2)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__src__", JSBridgeTmp.val)
        mn = JSRT_CreateNumber(JSBridgeTmp.count)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__mode__", mn)
        one = JSRT_CreateNumber(1)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__n__", one)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__alive__", one)
        va = JSRT_CreateArray()
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__vals__", va)
        JSBridgeTmp.ptr = JSBridgeTmp.dom_idx
        nkeys = JSRT_ArrLen(JSBridgeTmp.val2)
        JSBridge__PSetNum("__nk__", nkeys)
        JSBridge__PSetNum("__i__", 0)
        JSBridgeTmp.idx = 0
        WhileLoop LessThan(JSBridgeTmp.idx, 1000000) {
            ix = JSBridge__PNum("__i__")
            JSBridgeTmp.len = ix
            nk = JSBridge__PNum("__nk__")
            JSBridgeTmp.count = nk
            IfCondition GreaterEqual(JSBridgeTmp.len, JSBridgeTmp.count) ThenBlock: {
                JSBridgeTmp.idx = 1000000
            }
            IfCondition LessThan(JSBridgeTmp.idx, 1000000) ThenBlock: {
                JSBridgeTmp.val2 = JSBridge__PGet("__keys__")
                ks = JSRT_ArrGet(JSBridgeTmp.val2, JSBridgeTmp.len)
                JSBridgeTmp.type = ks
                sp = 0
                IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.type), JSType.STRING) ThenBlock: {
                    sp = JSRT_GetPayload(JSBridgeTmp.type)
                }
                JSBridgeTmp.addr = sp
                JSBridgeTmp.val = JSBridge__PGet("__src__")
                JSBridge__MapSaveState()
                prop = JSVM__ObjGetAcc(JSBridgeTmp.val, JSBridgeTmp.addr)
                JSBridgeTmp.result = prop
                JSBridge__MapLoadState()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    e2 = JSBridge__MapCapture()
                    JSBridgeTmp.found = e2
                    JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                    ReturnValue(JSBridge__PRejectFound())
                }
                JSBridge__PSet("__np__", JSBridgeTmp.result)
                JSBridgeTmp.count = JSBridge__PNum("__n__")
                JSBridgeTmp.count = Add(JSBridgeTmp.count, 1)
                JSBridge__PSetNum("__n__", JSBridgeTmp.count)
                ctor = JSBridge__PGet("__c__")
                JSBridgeTmp.obj = ctor
                rfn = JSBridge__PGet("__rs__")
                JSBridgeTmp.cb_val = rfn
                JSBridgeTmp.type = JSBridge__PGet("__np__")
                ok = JSBridge__PromiseCallRaw(JSBridgeTmp.cb_val, JSBridgeTmp.obj, JSBridgeTmp.type, JSRTState.undef_val, 1)
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                    ReturnValue(JSBridge__PRejectFound())
                }
                JSBridge__PSet("__np__", JSBridgeTmp.result)
                JSBridgeTmp.count = JSBridge__PNum("__mode__")
                JSBridgeTmp.idx = 9
                IfCondition EqualTo(JSBridgeTmp.count, 6) ThenBlock: { JSBridgeTmp.idx = 10 }
                JSBridgeTmp.len = JSBridge__PNum("__i__")
                JSBridgeTmp.cb_val = JSBridge__PMakeElem(JSBridgeTmp.idx, JSBridgeTmp.len)
                JSBridge__PSet("__a0__", JSBridgeTmp.cb_val)
                IfCondition EqualTo(JSBridge__PNum("__mode__"), 6) ThenBlock: {
                    JSBridgeTmp.len = JSBridge__PNum("__i__")
                    JSBridgeTmp.cb_val = JSBridge__PMakeElem(11, JSBridgeTmp.len)
                    JSBridge__PSet("__a1__", JSBridgeTmp.cb_val)
                } ElseBlock: {
                    JSBridge__PGet("__cap__")
                    JSBridgeTmp.obj = JSBridgeTmp.result
                    JSBridgeTmp.val = JSRT_ObjGet(JSBridgeTmp.obj, "__rej__")
                    JSBridge__PSet("__a1__", JSBridgeTmp.val)
                }
                JSBridgeTmp.type = JSBridge__PGet("__np__")
                IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.type), 0) ThenBlock: {
                    terr3 = JSVM_CreateTypedError("TypeError", "then is not a function")
                    JSBridgeTmp.found = terr3
                    JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                    ReturnValue(JSBridge__PRejectFound())
                }
                JSBridge__MapSaveState()
                thg = JSVM__ObjGetAcc(JSBridgeTmp.type, "then")
                JSBridgeTmp.result = thg
                JSBridge__MapLoadState()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    e3 = JSBridge__MapCapture()
                    JSBridgeTmp.found = e3
                    JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                    ReturnValue(JSBridge__PRejectFound())
                }
                IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.result), 0) ThenBlock: {
                    terr4 = JSVM_CreateTypedError("TypeError", "then is not a function")
                    JSBridgeTmp.found = terr4
                    JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                    ReturnValue(JSBridge__PRejectFound())
                }
                JSBridgeTmp.cb_val = JSBridgeTmp.result
                JSBridgeTmp.type = JSBridge__PGet("__np__")
                JSBridgeTmp.val2 = JSBridge__PGet("__a0__")
                JSBridgeTmp.addr = JSBridge__PGet("__a1__")
                ok2 = JSBridge__PromiseCallRaw(JSBridgeTmp.cb_val, JSBridgeTmp.type, JSBridgeTmp.val2, JSBridgeTmp.addr, 2)
                IfCondition EqualTo(ok2, 0) ThenBlock: {
                    JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                    ReturnValue(JSBridge__PRejectFound())
                }
                JSBridgeTmp.len = JSBridge__PNum("__i__")
                JSBridge__PSetNum("__i__", Add(JSBridgeTmp.len, 1))
                JSBridgeTmp.idx = JSBridge__PNum("__i__")
            }
        }
        IfCondition EqualTo(JSBridge__PDec(), 1) ThenBlock: {
            IfCondition EqualTo(JSBridge__PFinish(), 0) ThenBlock: {
                JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                ReturnValue(JSBridge__PRejectFound())
            }
        }
        cap2 = JSBridge__PGet("__cap__")
        outp = JSRT_ObjGet(cap2, "__p__")
        JSBridgeTmp.result = outp
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__PromiseDispatchNew {
    Input: handler_id: Integer
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.idx = handler_id
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.count = argc
        IfCondition EqualTo(JSBridgeTmp.idx, 426) ThenBlock: {
            ReturnValue(JSBridge__PromiseDoCap(JSBridgeTmp.obj, JSBridgeTmp.node, JSBridgeTmp.count))
        }
        IfCondition EqualTo(JSBridgeTmp.idx, 427) ThenBlock: {
            ReturnValue(JSBridge__PromiseDoTry(JSBridgeTmp.obj, JSBridgeTmp.node, JSBridgeTmp.count))
        }
        IfCondition EqualTo(JSBridgeTmp.idx, 428) ThenBlock: {
            ReturnValue(JSBridge__PromiseDoWithResolvers(JSBridgeTmp.obj, JSBridgeTmp.node, JSBridgeTmp.count))
        }
        IfCondition EqualTo(JSBridgeTmp.idx, 429) ThenBlock: {
            ReturnValue(JSBridge__PromiseDoKeyed(5, JSBridgeTmp.obj, JSBridgeTmp.node, JSBridgeTmp.count))
        }
        IfCondition EqualTo(JSBridgeTmp.idx, 430) ThenBlock: {
            ReturnValue(JSBridge__PromiseDoKeyed(6, JSBridgeTmp.obj, JSBridgeTmp.node, JSBridgeTmp.count))
        }
        IfCondition EqualTo(JSBridgeTmp.idx, 431) ThenBlock: {
            ReturnValue(JSBridge__PromiseDoElem(JSBridgeTmp.obj, JSBridgeTmp.node, JSBridgeTmp.count))
        }
        ReturnValue(JSRTState.undef_val)
    }
}
