// Library.JSBridgePromise.ailang — Promise capability, reactions, combinators.
// Pools stay on Library.JSBridge.ailang. No FixedPool in this file.
//
// Native ids: 426 cap-exec, 427 try, 428 withResolvers, 429 allKeyed,
// 430 allSettledKeyed, 431 element/finally thunk. None are constructors.
// Microtask drain stays after the script. Depth 0 then() still enqueues.
// Pending then() stores __rx__ even when the eager path is active.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// 1 if v is undefined. Does not allocate.
Function.JSBridge__PIsUndef {
    Input: v: Address
    Output: Integer
    Body: {
        JSBridgeTmp.found = v
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.found), JSType.UNDEFINED) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(JSBridgeTmp.found, JSRTState.undef_val) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// 1 if v is object, function, or array.
Function.JSBridge__PIsObj {
    Input: v: Address
    Output: Integer
    Body: {
        JSBridgeTmp.found = v
        t = JSRT_GetType(JSBridgeTmp.found)
        IfCondition EqualTo(t, JSType.OBJECT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, JSType.FUNCTION) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, JSType.ARRAY) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 if v is a function.
Function.JSBridge__PIsFn {
    Input: v: Address
    Output: Integer
    Body: {
        JSBridgeTmp.found = v
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.found), JSType.FUNCTION) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// IsPromise: object-like, __class__ "Promise", numeric [[PromiseState]].
Function.JSBridge__PromiseIs {
    Input: v: Address
    Output: Integer
    Body: {
        JSBridgeTmp.found = v
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.found), 0) ThenBlock: {
            ReturnValue(0)
        }
        cls = JSRT_ObjGet(JSBridgeTmp.found, "__class__")
        JSBridgeTmp.result = cls
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.result), JSType.STRING) ThenBlock: {
            ReturnValue(0)
        }
        sp = JSRT_StrToC(JSRT_GetPayload(JSBridgeTmp.result))
        IfCondition EqualTo(sp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(sp, 0), 80) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(sp, 1), 114) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(sp, 2), 111) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(sp, 3), 109) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(sp, 4), 105) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(sp, 5), 115) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(sp, 6), 101) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(sp, 7), 0) ThenBlock: { ReturnValue(0) }
        st = JSRT_ObjGet(JSBridgeTmp.found, "__state__")
        IfCondition NotEqual(JSRT_GetType(st), JSType.NUMBER) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Read a property of the record in JSBridgeTmp.ptr.
Function.JSBridge__PGet {
    Input: key: Address
    Output: Address
    Body: {
        JSBridgeTmp.name_ptr = key
        v = JSRT_ObjGet(JSBridgeTmp.ptr, JSBridgeTmp.name_ptr)
        JSBridgeTmp.result = v
        ReturnValue(JSBridgeTmp.result)
    }
}

// Write a property of the record in JSBridgeTmp.ptr.
Function.JSBridge__PSet {
    Input: key: Address
    Input: val: Address
    Output: Integer
    Body: {
        JSBridgeTmp.name_ptr = key
        JSBridgeTmp.val = val
        JSRT_ObjSet(JSBridgeTmp.ptr, JSBridgeTmp.name_ptr, JSBridgeTmp.val)
        ReturnValue(0)
    }
}

// Write an integer number property of JSBridgeTmp.ptr.
Function.JSBridge__PSetNum {
    Input: key: Address
    Input: n: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.name_ptr = key
        JSBridgeTmp.idx = n
        nv = JSRT_CreateNumber(JSBridgeTmp.idx)
        JSBridgeTmp.val = nv
        JSRT_ObjSet(JSBridgeTmp.ptr, JSBridgeTmp.name_ptr, JSBridgeTmp.val)
        ReturnValue(0)
    }
}

// Integer number property of JSBridgeTmp.ptr. Missing reads as 0.
Function.JSBridge__PNum {
    Input: key: Address
    Output: Integer
    Body: {
        JSBridgeTmp.name_ptr = key
        v = JSRT_ObjGet(JSBridgeTmp.ptr, JSBridgeTmp.name_ptr)
        JSBridgeTmp.result = v
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.result), JSType.NUMBER) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Float_ToInt(JSRT_GetPayload(JSBridgeTmp.result)))
    }
}

// Throw TypeError. Longjmps at depth 0. Returns undef at depth > 0.
Function.JSBridge__PThrow {
    Input: msg: Address
    Output: Address
    Body: {
        JSBridgeTmp.name_ptr = msg
        ReturnValue(JSBridge__MapThrow(JSBridgeTmp.name_ptr))
    }
}

// Rethrow an existing value. Does not wrap it in a new TypeError.
Function.JSBridge__PRethrow {
    Input: err: Address
    Output: Address
    Body: {
        JSBridgeTmp.found = err
        JSBridgeTmp.result = JSBridgeTmp.found
        JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.result)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = JSBridgeTmp.result
        JSVM_ThrowValue(JSBridgeTmp.result)
        ReturnValue(JSRTState.undef_val)
    }
}

// Call fn with up to 2 args. Restores ptr/obj/val/val2/addr/cb_val/idx.
// Returns 1 and leaves the JS result in JSBridgeTmp.result.
// Returns 0 and leaves the thrown value in JSBridgeTmp.found. Does not longjmp.
// Clobbers node, dom_idx, type, len, count.
Function.JSBridge__PromiseCallRaw {
    Input: fn: Address
    Input: recv: Address
    Input: a0: Address
    Input: a1: Address
    Input: nargs: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.node = fn
        JSBridgeTmp.dom_idx = recv
        JSBridgeTmp.type = a0
        JSBridgeTmp.len = a1
        JSBridgeTmp.count = nargs
        JSBridge__MapSaveState()
        JSBridgeTmp.val = JSBridgeTmp.node
        JSBridgeTmp.obj = JSBridgeTmp.dom_idx
        JSBridgeTmp.val2 = JSBridgeTmp.type
        JSBridgeTmp.cb_val = JSBridgeTmp.len
        JSBridgeTmp.idx = JSBridgeTmp.count
        buf = Allocate(32)
        JSBridgeTmp.addr = buf
        IfCondition EqualTo(JSBridgeTmp.addr, 0) ThenBlock: {
            JSBridge__MapLoadState()
            terr = JSVM_CreateTypedError("TypeError", "out of memory")
            JSBridgeTmp.found = terr
            ReturnValue(0)
        }
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            StoreValue(JSBridgeTmp.addr, JSBridgeTmp.val2)
        }
        IfCondition GreaterThan(JSBridgeTmp.idx, 1) ThenBlock: {
            StoreValue(Add(JSBridgeTmp.addr, 8), JSBridgeTmp.cb_val)
        }
        JSBridge__MapSaveState()
        JSBridge__Push(JSBridgeTmp.val)
        JSVM__SetGlobal("this", JSBridgeTmp.obj)
        JSBridgeTmp.val = JSBridge__Pop()
        JSVMCall.exc_prop = 0
        cr = JSVM__CallFunc(JSBridgeTmp.val, JSBridgeTmp.addr, JSBridgeTmp.idx)
        JSBridgeTmp.result = cr
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            err = JSBridge__MapCapture()
            JSBridgeTmp.found = err
            b = JSBridgeTmp.addr
            JSBridgeTmp.addr = 0
            Deallocate(b, 32)
            JSBridge__MapLoadState()
            ReturnValue(0)
        }
        b2 = JSBridgeTmp.addr
        JSBridgeTmp.addr = 0
        Deallocate(b2, 32)
        JSBridge__MapLoadState()
        ReturnValue(1)
    }
}

// Call fn with up to 16 args copied from src. Same return contract as PromiseCallRaw.
Function.JSBridge__PromiseCallN {
    Input: fn: Address
    Input: recv: Address
    Input: src: Address
    Input: nargs: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.node = fn
        JSBridgeTmp.dom_idx = recv
        JSBridgeTmp.type = src
        JSBridgeTmp.count = nargs
        IfCondition GreaterThan(JSBridgeTmp.count, 16) ThenBlock: {
            JSBridgeTmp.count = 16
        }
        IfCondition LessThan(JSBridgeTmp.count, 0) ThenBlock: {
            JSBridgeTmp.count = 0
        }
        JSBridge__MapSaveState()
        JSBridgeTmp.val = JSBridgeTmp.node
        JSBridgeTmp.obj = JSBridgeTmp.dom_idx
        JSBridgeTmp.val2 = JSBridgeTmp.type
        JSBridgeTmp.idx = JSBridgeTmp.count
        buf = Allocate(128)
        JSBridgeTmp.addr = buf
        IfCondition EqualTo(JSBridgeTmp.addr, 0) ThenBlock: {
            JSBridge__MapLoadState()
            terr = JSVM_CreateTypedError("TypeError", "out of memory")
            JSBridgeTmp.found = terr
            ReturnValue(0)
        }
        ci = 0
        WhileLoop LessThan(ci, JSBridgeTmp.idx) {
            JSBridgeTmp.len = ci
            one = Dereference(Add(JSBridgeTmp.val2, Multiply(JSBridgeTmp.len, 8)))
            StoreValue(Add(JSBridgeTmp.addr, Multiply(JSBridgeTmp.len, 8)), one)
            ci = Add(JSBridgeTmp.len, 1)
        }
        JSBridge__MapSaveState()
        JSBridge__Push(JSBridgeTmp.val)
        JSVM__SetGlobal("this", JSBridgeTmp.obj)
        JSBridgeTmp.val = JSBridge__Pop()
        JSVMCall.exc_prop = 0
        cr = JSVM__CallFunc(JSBridgeTmp.val, JSBridgeTmp.addr, JSBridgeTmp.idx)
        JSBridgeTmp.result = cr
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            err = JSBridge__MapCapture()
            JSBridgeTmp.found = err
            b = JSBridgeTmp.addr
            JSBridgeTmp.addr = 0
            Deallocate(b, 128)
            JSBridge__MapLoadState()
            ReturnValue(0)
        }
        b2 = JSBridgeTmp.addr
        JSBridgeTmp.addr = 0
        Deallocate(b2, 128)
        JSBridge__MapLoadState()
        ReturnValue(1)
    }
}

// Propagate JSBridgeTmp.found. Used after PromiseCallRaw returns 0.
Function.JSBridge__PPropagateFound {
    Output: Address
    Body: {
        ReturnValue(JSBridge__PRethrow(JSBridgeTmp.found))
    }
}

// Promise state: 0 pending, 1 fulfilled, 2 rejected. Already settled is a no-op.
// Promise object is JSBridgeTmp.obj.
Function.JSBridge__PSettle {
    Input: st: Integer
    Input: val: Address
    Output: Integer
    Body: {
        JSBridgeTmp.idx = st
        JSBridgeTmp.val = val
        stv = JSRT_ObjGet(JSBridgeTmp.obj, "__state__")
        JSBridgeTmp.result = stv
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.NUMBER) ThenBlock: {
            sn = Float_ToInt(JSRT_GetPayload(JSBridgeTmp.result))
            IfCondition Or(EqualTo(sn, 1), EqualTo(sn, 2)) ThenBlock: {
                ReturnValue(0)
            }
        }
        nv = JSRT_CreateNumber(JSBridgeTmp.idx)
        JSBridgeTmp.val2 = nv
        JSRT_ObjSet(JSBridgeTmp.obj, "__state__", JSBridgeTmp.val2)
        JSRT_ObjSet(JSBridgeTmp.obj, "__value__", JSBridgeTmp.val)
        JSVMJobs_FireReactions(JSBridgeTmp.obj)
        ReturnValue(1)
    }
}

// Anonymous built-in. Env is the record in JSBridgeTmp.ptr. Returns the function.
Function.JSBridge__PMakeNative {
    Input: nid: Integer
    Input: len: Integer
    Output: Address
    Body: {
        JSBridgeTmp.idx = nid
        JSBridgeTmp.count = len
        JSBridge__Push(JSBridgeTmp.ptr)
        fn = JSBridge__CreateNativeFunc(JSBridgeTmp.idx, "", JSBridgeTmp.count)
        JSBridgeTmp.val = fn
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSRT_FuncSetEnv(JSBridgeTmp.val, JSBridgeTmp.ptr)
        ReturnValue(JSBridgeTmp.val)
    }
}

// GetCapabilitiesExecutor. promise_recv is the capability record.
Function.JSBridge__PromiseDoCap {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        r0 = JSBridge__PGet("__res__")
        JSBridgeTmp.val = r0
        r1 = JSBridge__PGet("__rej__")
        JSBridgeTmp.val2 = r1
        bad = 0
        IfCondition EqualTo(JSBridge__PIsUndef(JSBridgeTmp.val), 0) ThenBlock: { bad = 1 }
        IfCondition EqualTo(JSBridge__PIsUndef(JSBridgeTmp.val2), 0) ThenBlock: { bad = 1 }
        IfCondition EqualTo(bad, 1) ThenBlock: {
            ReturnValue(JSBridge__PThrow("Promise capability executor called twice"))
        }
        a0 = JSRTState.undef_val
        a1 = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            a0 = Dereference(JSBridgeTmp.node)
        }
        IfCondition GreaterThan(JSBridgeTmp.idx, 1) ThenBlock: {
            a1 = Dereference(Add(JSBridgeTmp.node, 8))
        }
        JSBridgeTmp.val = a0
        JSBridgeTmp.val2 = a1
        JSBridge__PSet("__res__", JSBridgeTmp.val)
        JSBridge__PSet("__rej__", JSBridgeTmp.val2)
        ReturnValue(JSRTState.undef_val)
    }
}

// NewPromiseCapability(ctor). Returns the capability record, or 0 if thrown.
// On success JSBridgeTmp.ptr is the capability and __p__ is the promise.
Function.JSBridge__PNewCap {
    Input: ctor: Address
    Output: Address
    Body: {
        JSBridgeTmp.obj = ctor
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.obj), 0) ThenBlock: {
            JSBridge__PThrow("Promise constructor is not an object")
            ReturnValue(0)
        }
        IfCondition EqualTo(JSVM__IsConstructor(JSBridgeTmp.obj), 0) ThenBlock: {
            JSBridge__PThrow("Promise constructor is not a constructor")
            ReturnValue(0)
        }
        cap = JSRT_CreateObject()
        JSBridgeTmp.ptr = cap
        JSBridge__PSet("__res__", JSRTState.undef_val)
        JSBridge__PSet("__rej__", JSRTState.undef_val)
        JSBridge__PSet("__p__", JSRTState.undef_val)
        ex = JSBridge__PMakeNative(426, 2)
        JSBridgeTmp.val = ex
        buf = Allocate(32)
        JSBridgeTmp.addr = buf
        IfCondition EqualTo(JSBridgeTmp.addr, 0) ThenBlock: {
            JSBridge__PThrow("out of memory")
            ReturnValue(0)
        }
        StoreValue(JSBridgeTmp.addr, JSBridgeTmp.val)
        JSBridge__MapSaveState()
        pr = JSVM__Construct(JSBridgeTmp.obj, JSBridgeTmp.addr, 1)
        JSBridgeTmp.result = pr
        JSBridge__MapLoadState()
        b = JSBridgeTmp.addr
        JSBridgeTmp.addr = 0
        Deallocate(b, 32)
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__PSet("__p__", JSBridgeTmp.result)
        rf = JSBridge__PGet("__res__")
        JSBridgeTmp.val = rf
        jf = JSBridge__PGet("__rej__")
        JSBridgeTmp.val2 = jf
        IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.val), 0) ThenBlock: {
            JSBridge__PThrow("Promise resolve is not a function")
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.val2), 0) ThenBlock: {
            JSBridge__PThrow("Promise reject is not a function")
            ReturnValue(0)
        }
        ReturnValue(JSBridgeTmp.ptr)
    }
}

// SpeciesConstructor(promise, %Promise%). 1 and constructor in result, or 0 if thrown.
Function.JSBridge__PSpecies {
    Input: prom: Address
    Output: Integer
    Body: {
        JSBridgeTmp.obj = prom
        JSBridge__MapSaveState()
        ctor = JSVM__ObjGetAcc(JSBridgeTmp.obj, "constructor")
        JSBridgeTmp.result = ctor
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridge__PIsUndef(JSBridgeTmp.result), 1) ThenBlock: {
            d = JSVM__GetGlobal("Promise")
            JSBridgeTmp.result = d
            ReturnValue(1)
        }
        IfCondition EqualTo(JSVM_IsSymbol(JSBridgeTmp.result), 1) ThenBlock: {
            JSBridge__PThrow("Promise species constructor is not an object")
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.result), 0) ThenBlock: {
            JSBridge__PThrow("Promise species constructor is not an object")
            ReturnValue(0)
        }
        JSBridgeTmp.val = JSBridgeTmp.result
        sk = 0
        IfCondition NotEqual(JSVMSymbol.species, 0) ThenBlock: {
            sk = JSVM_SymbolToKey(JSVMSymbol.species)
        }
        JSBridgeTmp.name_ptr = sk
        IfCondition EqualTo(JSBridgeTmp.name_ptr, 0) ThenBlock: {
            d2 = JSVM__GetGlobal("Promise")
            JSBridgeTmp.result = d2
            ReturnValue(1)
        }
        JSBridge__MapSaveState()
        spv = JSVM__ObjGetAcc(JSBridgeTmp.val, JSBridgeTmp.name_ptr)
        JSBridgeTmp.result = spv
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.NULL) ThenBlock: {
            d3 = JSVM__GetGlobal("Promise")
            JSBridgeTmp.result = d3
            ReturnValue(1)
        }
        IfCondition EqualTo(JSBridge__PIsUndef(JSBridgeTmp.result), 1) ThenBlock: {
            d4 = JSVM__GetGlobal("Promise")
            JSBridgeTmp.result = d4
            ReturnValue(1)
        }
        IfCondition EqualTo(JSVM__IsConstructor(JSBridgeTmp.result), 0) ThenBlock: {
            JSBridge__PThrow("Promise species is not a constructor")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Direct fulfill/reject used by the resolve functions. Promise in obj.
// Resolution algorithm for INT_RESOLVE. Once-record is ptr.
Function.JSBridge__PromiseDoIntResolve {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        p = JSBridge__PGet("__p__")
        JSBridgeTmp.obj = p
        st = JSRT_ObjGet(JSBridgeTmp.obj, "__state__")
        JSBridgeTmp.result = st
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.NUMBER) ThenBlock: {
            sn = Float_ToInt(JSRT_GetPayload(JSBridgeTmp.result))
            IfCondition Or(EqualTo(sn, 1), EqualTo(sn, 2)) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
        }
        resv = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            resv = Dereference(JSBridgeTmp.node)
        }
        JSBridgeTmp.val = resv
        IfCondition EqualTo(JSBridge__PNum("__v__"), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__PSetNum("__v__", 1)
        JSBridgeTmp.val = JSBridge__Pop()
        IfCondition EqualTo(JSRT_SameRef(JSBridgeTmp.val, JSBridgeTmp.obj), 1) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Promise cannot resolve to itself")
            JSBridgeTmp.val = terr
            JSBridge__PSettle(2, JSBridgeTmp.val)
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.val), 0) ThenBlock: {
            JSBridge__PSettle(1, JSBridgeTmp.val)
            ReturnValue(JSRTState.undef_val)
        }
        JSBridge__MapSaveState()
        th = JSVM__ObjGetAcc(JSBridgeTmp.val, "then")
        JSBridgeTmp.result = th
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            err = JSBridge__MapCapture()
            JSBridgeTmp.val = err
            JSBridge__PSettle(2, JSBridgeTmp.val)
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.result), 0) ThenBlock: {
            JSBridge__PSettle(1, JSBridgeTmp.val)
            ReturnValue(JSRTState.undef_val)
        }
        // Thenable: fresh resolving functions so the inner resolve still runs.
        JSBridgeTmp.cb_val = JSBridgeTmp.result
        nrec = JSRT_CreateObject()
        JSBridgeTmp.val2 = nrec
        JSRT_ObjSet(JSBridgeTmp.val2, "__p__", JSBridgeTmp.obj)
        z = JSRT_CreateNumber(0)
        JSRT_ObjSet(JSBridgeTmp.val2, "__v__", z)
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridgeTmp.ptr = JSBridgeTmp.val2
        nres = JSBridge__PMakeNative(77, 1)
        JSBridgeTmp.type = nres
        nrej = JSBridge__PMakeNative(78, 1)
        JSBridgeTmp.len = nrej
        JSBridgeTmp.cb_val = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        recjob = JSRT_CreateObject()
        JSBridgeTmp.val2 = recjob
        JSRT_ObjSet(JSBridgeTmp.val2, "__t__", JSBridgeTmp.val)
        JSRT_ObjSet(JSBridgeTmp.val2, "__res__", JSBridgeTmp.type)
        JSRT_ObjSet(JSBridgeTmp.val2, "__rej__", JSBridgeTmp.len)
        en = JSVMJobs_Enqueue(3, JSBridgeTmp.cb_val, JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition EqualTo(en, -1) ThenBlock: {
            JSVMJobs_RunThenable(JSBridgeTmp.cb_val, JSBridgeTmp.val2)
        }
        ReturnValue(JSRTState.undef_val)
    }
}

Function.JSBridge__PromiseDoIntReject {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        p = JSBridge__PGet("__p__")
        JSBridgeTmp.obj = p
        st = JSRT_ObjGet(JSBridgeTmp.obj, "__state__")
        JSBridgeTmp.result = st
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.NUMBER) ThenBlock: {
            sn = Float_ToInt(JSRT_GetPayload(JSBridgeTmp.result))
            IfCondition Or(EqualTo(sn, 1), EqualTo(sn, 2)) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
        }
        rv = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            rv = Dereference(JSBridgeTmp.node)
        }
        JSBridgeTmp.val = rv
        IfCondition EqualTo(JSBridge__PNum("__v__"), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__PSetNum("__v__", 1)
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridge__PSettle(2, JSBridgeTmp.val)
        ReturnValue(JSRTState.undef_val)
    }
}

// new Promise(executor). NewTarget must already be set by the caller.
Function.JSBridge__PromiseDoCtor {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        nt = JSVM__GetGlobal("__new_target__")
        JSBridgeTmp.found = nt
        IfCondition EqualTo(JSBridge__PIsUndef(JSBridgeTmp.found), 1) ThenBlock: {
            ReturnValue(JSBridge__PThrow("Promise constructor requires new"))
        }
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.found), JSType.NULL) ThenBlock: {
            ReturnValue(JSBridge__PThrow("Promise constructor requires new"))
        }
        ex = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            ex = Dereference(JSBridgeTmp.node)
        }
        JSBridgeTmp.val = ex
        IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.val), 0) ThenBlock: {
            ReturnValue(JSBridge__PThrow("Promise executor is not a function"))
        }
        JSBridge__MapSaveState()
        // PIsFn overwrites found with the executor. Re-read new.target.
        nt2 = JSVM__GetGlobal("__new_target__")
        JSBridgeTmp.found = nt2
        proto = JSVM__ObjGetAcc(JSBridgeTmp.found, "prototype")
        JSBridgeTmp.result = proto
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        use_def = 0
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.result), 0) ThenBlock: { use_def = 1 }
        IfCondition EqualTo(use_def, 1) ThenBlock: {
            JSBridgeTmp.result = JSRTState.promise_proto
        }
        p = JSRT_CreateObject()
        JSBridgeTmp.obj = p
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.result), 1) ThenBlock: {
            JSRT_ObjSet(JSBridgeTmp.obj, "__proto__", JSBridgeTmp.result)
        }
        cls = JSRT_CreateString("Promise")
        JSBridgeTmp.result = cls
        JSRT_ObjSet(JSBridgeTmp.obj, "__class__", JSBridgeTmp.result)
        z = JSRT_CreateNumber(0)
        JSRT_ObjSet(JSBridgeTmp.obj, "__state__", z)
        JSRT_ObjSet(JSBridgeTmp.obj, "__value__", JSRTState.undef_val)
        rec = JSRT_CreateObject()
        JSBridgeTmp.ptr = rec
        // PSet and PSetNum overwrite val. cb_val is not touched by those helpers.
        JSBridgeTmp.cb_val = JSBridgeTmp.val
        JSBridge__PSet("__p__", JSBridgeTmp.obj)
        JSBridge__PSetNum("__v__", 0)
        rfn = JSBridge__PMakeNative(77, 1)
        JSBridgeTmp.val2 = rfn
        jfn = JSBridge__PMakeNative(78, 1)
        JSBridgeTmp.type = jfn
        JSBridgeTmp.val = JSBridgeTmp.cb_val
        JSBridgeTmp.cb_val = JSBridgeTmp.type
        ok = JSBridge__PromiseCallRaw(JSBridgeTmp.val, JSRTState.undef_val, JSBridgeTmp.val2, JSBridgeTmp.cb_val, 2)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            JSBridgeTmp.obj = JSBridge__PGet("__p__")
            JSBridge__PSettle(2, JSBridgeTmp.found)
        }
        pret = JSBridge__PGet("__p__")
        JSBridgeTmp.result = pret
        ReturnValue(JSBridgeTmp.result)
    }
}

// Promise.resolve(x). this is the constructor.
Function.JSBridge__PromiseDoResolve {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        // Primitive symbols are objects in this VM. ES Type(symbol) is not Object.
        bad_this = 0
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.obj), 0) ThenBlock: {
            bad_this = 1
        }
        IfCondition EqualTo(JSVM_IsPrimSymbol(JSBridgeTmp.obj), 1) ThenBlock: {
            bad_this = 1
        }
        IfCondition EqualTo(bad_this, 1) ThenBlock: {
            ReturnValue(JSBridge__PThrow("Promise.resolve called on non-object"))
        }
        x = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            x = Dereference(JSBridgeTmp.node)
        }
        JSBridgeTmp.val = x
        IfCondition EqualTo(JSBridge__PromiseIs(JSBridgeTmp.val), 1) ThenBlock: {
            JSBridge__MapSaveState()
            c = JSVM__ObjGetAcc(JSBridgeTmp.val, "constructor")
            JSBridgeTmp.result = c
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            IfCondition EqualTo(JSRT_SameRef(JSBridgeTmp.result, JSBridgeTmp.obj), 1) ThenBlock: {
                ReturnValue(JSBridgeTmp.val)
            }
        }
        JSBridge__Push(JSBridgeTmp.val)
        cap = JSBridge__PNewCap(JSBridgeTmp.obj)
        JSBridgeTmp.ptr = cap
        JSBridgeTmp.val = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        rf = JSBridge__PGet("__res__")
        JSBridgeTmp.val2 = rf
        ok = JSBridge__PromiseCallRaw(JSBridgeTmp.val2, JSRTState.undef_val, JSBridgeTmp.val, JSRTState.undef_val, 1)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(JSBridge__PPropagateFound())
        }
        pret = JSBridge__PGet("__p__")
        JSBridgeTmp.result = pret
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__PromiseDoReject {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        bad_this = 0
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.obj), 0) ThenBlock: {
            bad_this = 1
        }
        IfCondition EqualTo(JSVM_IsPrimSymbol(JSBridgeTmp.obj), 1) ThenBlock: {
            bad_this = 1
        }
        IfCondition EqualTo(bad_this, 1) ThenBlock: {
            ReturnValue(JSBridge__PThrow("Promise.reject called on non-object"))
        }
        x = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            x = Dereference(JSBridgeTmp.node)
        }
        JSBridgeTmp.val = x
        JSBridge__Push(JSBridgeTmp.val)
        cap = JSBridge__PNewCap(JSBridgeTmp.obj)
        JSBridgeTmp.ptr = cap
        JSBridgeTmp.val = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        jf = JSBridge__PGet("__rej__")
        JSBridgeTmp.val2 = jf
        ok = JSBridge__PromiseCallRaw(JSBridgeTmp.val2, JSRTState.undef_val, JSBridgeTmp.val, JSRTState.undef_val, 1)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(JSBridge__PPropagateFound())
        }
        pret = JSBridge__PGet("__p__")
        JSBridgeTmp.result = pret
        ReturnValue(JSBridgeTmp.result)
    }
}

// Attach reactions. promise in obj, capability record in ptr.
// onFul in val, onRej in val2. Returns the capability promise.
Function.JSBridge__PAttach {
    Output: Address
    Body: {
        st = JSRT_ObjGet(JSBridgeTmp.obj, "__state__")
        JSBridgeTmp.result = st
        sn = 0
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.NUMBER) ThenBlock: {
            sn = Float_ToInt(JSRT_GetPayload(JSBridgeTmp.result))
        }
        JSBridgeTmp.count = sn
        pv = JSRT_ObjGet(JSBridgeTmp.obj, "__value__")
        JSBridgeTmp.type = pv
        cap_p = JSBridge__PGet("__p__")
        JSBridgeTmp.node = cap_p
        use_q = 1
        IfCondition GreaterThan(JSVMCall.depth, 0) ThenBlock: { use_q = 0 }
        IfCondition EqualTo(JSVMJobs.draining, 1) ThenBlock: { use_q = 0 }
        // Pending always records the reaction, including the eager path.
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            rx = JSRT_CreateObject()
            JSBridgeTmp.dom_idx = rx
            JSRT_ObjSet(JSBridgeTmp.dom_idx, "__on_ful__", JSBridgeTmp.val)
            JSRT_ObjSet(JSBridgeTmp.dom_idx, "__on_rej__", JSBridgeTmp.val2)
            JSRT_ObjSet(JSBridgeTmp.dom_idx, "__cap__", JSBridgeTmp.node)
            JSRT_ObjSet(JSBridgeTmp.obj, "__rx__", JSBridgeTmp.dom_idx)
            ReturnValue(JSBridgeTmp.node)
        }
        IfCondition EqualTo(use_q, 1) ThenBlock: {
            kind = 1
            cb = JSBridgeTmp.val
            IfCondition EqualTo(JSBridgeTmp.count, 2) ThenBlock: {
                kind = 2
                cb = JSBridgeTmp.val2
            }
            JSBridgeTmp.idx = kind
            JSBridgeTmp.cb_val = cb
            en = JSVMJobs_Enqueue(JSBridgeTmp.idx, JSBridgeTmp.cb_val, JSBridgeTmp.type, JSBridgeTmp.node)
            IfCondition NotEqual(en, -1) ThenBlock: {
                ReturnValue(JSBridgeTmp.node)
            }
        }
        // Eager settlement of an already-settled promise into the species promise.
        handler = JSBridgeTmp.val
        IfCondition EqualTo(JSBridgeTmp.count, 2) ThenBlock: {
            handler = JSBridgeTmp.val2
        }
        JSBridgeTmp.cb_val = handler
        IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.cb_val), 0) ThenBlock: {
            JSBridgeTmp.dom_idx = JSBridgeTmp.obj
            JSBridgeTmp.obj = JSBridgeTmp.node
            stn = 1
            IfCondition EqualTo(JSBridgeTmp.count, 2) ThenBlock: { stn = 2 }
            JSBridge__PSettle(stn, JSBridgeTmp.type)
            JSBridgeTmp.obj = JSBridgeTmp.dom_idx
            ReturnValue(JSBridgeTmp.node)
        }
        ok = JSBridge__PromiseCallRaw(JSBridgeTmp.cb_val, JSRTState.undef_val, JSBridgeTmp.type, JSRTState.undef_val, 1)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            species = JSBridge__PGet("__p__")
            JSBridgeTmp.obj = species
            JSBridge__PSettle(2, JSBridgeTmp.found)
            ReturnValue(JSBridgeTmp.obj)
        }
        // PromiseCallRaw clobbers node. Keep the callback return, then re-get the species promise.
        JSBridgeTmp.cb_val = JSBridgeTmp.result
        JSBridgeTmp.dom_idx = 0
        IfCondition EqualTo(JSBridge__PromiseIs(JSBridgeTmp.cb_val), 1) ThenBlock: {
            ast = JSRT_ObjGet(JSBridgeTmp.cb_val, "__state__")
            IfCondition EqualTo(JSRT_GetType(ast), JSType.NUMBER) ThenBlock: {
                asn = Float_ToInt(JSRT_GetPayload(ast))
                IfCondition Or(EqualTo(asn, 1), EqualTo(asn, 2)) ThenBlock: {
                    av = JSRT_ObjGet(JSBridgeTmp.cb_val, "__value__")
                    JSBridgeTmp.type = av
                    JSBridgeTmp.idx = asn
                    JSBridgeTmp.dom_idx = 1
                }
            }
        }
        species2 = JSBridge__PGet("__p__")
        JSBridgeTmp.obj = species2
        IfCondition EqualTo(JSBridgeTmp.dom_idx, 1) ThenBlock: {
            JSBridge__PSettle(JSBridgeTmp.idx, JSBridgeTmp.type)
        } ElseBlock: {
            JSBridge__PSettle(1, JSBridgeTmp.cb_val)
        }
        ReturnValue(JSBridgeTmp.obj)
    }
}

Function.JSBridge__PromiseDoThen {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        IfCondition EqualTo(JSBridge__PromiseIs(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSBridge__PThrow("Promise.prototype.then called on non-promise"))
        }
        onf = JSRTState.undef_val
        onr = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            onf = Dereference(JSBridgeTmp.node)
        }
        IfCondition GreaterThan(JSBridgeTmp.idx, 1) ThenBlock: {
            onr = Dereference(Add(JSBridgeTmp.node, 8))
        }
        JSBridgeTmp.val = onf
        JSBridgeTmp.val2 = onr
        // PSpecies and PNewCap overwrite val, val2, obj, and node.
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.val2)
        sp_ok = JSBridge__PSpecies(JSBridgeTmp.obj)
        JSBridgeTmp.count = sp_ok
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.val2)
        cap = JSBridge__PNewCap(JSBridgeTmp.result)
        JSBridgeTmp.ptr = cap
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ret = JSBridge__PAttach()
        JSBridgeTmp.result = ret
        ReturnValue(JSBridgeTmp.result)
    }
}

// Box boolean, number, and string so GetV walks the wrapper prototype.
Function.JSBridge__PBox {
    Input: v: Address
    Output: Address
    Body: {
        JSBridgeTmp.val = v
        otb = JSRT_GetType(JSBridgeTmp.val)
        IfCondition Or(Or(EqualTo(otb, JSType.OBJECT), EqualTo(otb, JSType.ARRAY)), EqualTo(otb, JSType.FUNCTION)) ThenBlock: {
            ReturnValue(JSBridgeTmp.val)
        }
        IfCondition EqualTo(otb, JSType.STRING) ThenBlock: {
            bs = JSVM__ArrayCallbackThis(JSBridgeTmp.val)
            JSBridgeTmp.val = bs
            ReturnValue(JSBridgeTmp.val)
        }
        IfCondition Or(EqualTo(otb, JSType.BOOLEAN), EqualTo(otb, JSType.NUMBER)) ThenBlock: {
            bn = JSVM__ArrayToObject(JSBridgeTmp.val)
            JSBridgeTmp.val = bn
            ReturnValue(JSBridgeTmp.val)
        }
        ReturnValue(JSBridgeTmp.val)
    }
}

// Invoke(recv, "then", a0, a1). No brand check. Result in result, or throw.
Function.JSBridge__PInvokeThen {
    Input: recv: Address
    Input: a0: Address
    Input: a1: Address
    Output: Address
    Body: {
        JSBridgeTmp.val = a0
        JSBridgeTmp.val2 = a1
        JSBridgeTmp.obj = recv
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.val2)
        boxed = JSBridge__PBox(JSBridgeTmp.obj)
        JSBridgeTmp.obj = boxed
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridge__MapSaveState()
        // [[Get]] so a Proxy with no get trap forwards to the target.
        th = JSVM__GetProperty(JSBridgeTmp.obj, "then")
        JSBridgeTmp.result = th
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.result), 0) ThenBlock: {
            ReturnValue(JSBridge__PThrow("then is not a function"))
        }
        ok = JSBridge__PromiseCallRaw(JSBridgeTmp.result, JSBridgeTmp.obj, JSBridgeTmp.val, JSBridgeTmp.val2, 2)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(JSBridge__PPropagateFound())
        }
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__PromiseDoCatch {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        onr = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            onr = Dereference(JSBridgeTmp.node)
        }
        JSBridgeTmp.val2 = onr
        ret = JSBridge__PInvokeThen(JSBridgeTmp.obj, JSRTState.undef_val, JSBridgeTmp.val2)
        JSBridgeTmp.result = ret
        ReturnValue(JSBridgeTmp.result)
    }
}

// Element record: __slot__ __k__ __i__ __v__ plus finally __cb__.
Function.JSBridge__PMakeElem {
    Input: kind: Integer
    Input: index: Integer
    Output: Address
    Body: {
        JSBridgeTmp.idx = kind
        JSBridgeTmp.count = index
        JSBridge__Push(JSBridgeTmp.ptr)
        rec = JSRT_CreateObject()
        JSBridgeTmp.obj = rec
        JSBridgeTmp.ptr = JSBridge__Pop()
        // CreateNumber's return dies across ObjSet. Store each number first.
        JSBridgeTmp.val2 = JSBridgeTmp.ptr
        JSRT_ObjSet(JSBridgeTmp.obj, "__slot__", JSBridgeTmp.val2)
        JSBridgeTmp.val = JSRT_CreateNumber(JSBridgeTmp.idx)
        JSRT_ObjSet(JSBridgeTmp.obj, "__k__", JSBridgeTmp.val)
        JSBridgeTmp.val = JSRT_CreateNumber(JSBridgeTmp.count)
        JSRT_ObjSet(JSBridgeTmp.obj, "__i__", JSBridgeTmp.val)
        JSBridgeTmp.val = JSRT_CreateNumber(0)
        JSRT_ObjSet(JSBridgeTmp.obj, "__v__", JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridgeTmp.ptr = JSBridgeTmp.obj
        JSBridgeTmp.val = JSBridge__PMakeNative(431, 1)
        JSBridgeTmp.ptr = JSBridge__Pop()
        ReturnValue(JSBridgeTmp.val)
    }
}

// Decrement slot.__n__. Returns 1 if this call should finish the combinator.
Function.JSBridge__PDec {
    Output: Integer
    Body: {
        JSBridgeTmp.count = JSBridge__PNum("__n__")
        JSBridgeTmp.count = Subtract(JSBridgeTmp.count, 1)
        JSBridge__PSetNum("__n__", JSBridgeTmp.count)
        IfCondition NotEqual(JSBridgeTmp.count, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSBridge__PNum("__alive__"), 1) ThenBlock: { ReturnValue(0) }
        JSBridge__PSetNum("__alive__", 0)
        ReturnValue(1)
    }
}

// Build AggregateError from an array. Falls back to a branded object.
Function.JSBridge__PAggregate {
    Input: errs: Address
    Output: Address
    Body: {
        JSBridgeTmp.val = errs
        ctor = JSVM__GetGlobal("AggregateError")
        JSBridgeTmp.obj = ctor
        buf = Allocate(32)
        JSBridgeTmp.addr = buf
        IfCondition EqualTo(JSBridgeTmp.addr, 0) ThenBlock: {
            ReturnValue(JSBridgeTmp.val)
        }
        StoreValue(JSBridgeTmp.addr, JSBridgeTmp.val)
        JSBridge__MapSaveState()
        er = JSVM__Construct(JSBridgeTmp.obj, JSBridgeTmp.addr, 1)
        JSBridgeTmp.result = er
        JSBridge__MapLoadState()
        b = JSBridgeTmp.addr
        JSBridgeTmp.addr = 0
        Deallocate(b, 32)
        JSVMCall.exc_prop = 0
        JSVMCall.thrown_val = 0
        JSVMState.halted = 0
        JSVMState.error = 0
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.result), 1) ThenBlock: {
            JSRT_ObjSet(JSBridgeTmp.result, "errors", JSBridgeTmp.val)
            ReturnValue(JSBridgeTmp.result)
        }
        fb = JSRT_CreateObject()
        JSBridgeTmp.result = fb
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(JSBridgeTmp.result, "__proto__", JSRTState.object_proto)
        }
        nm = JSRT_CreateString("AggregateError")
        JSRT_ObjSet(JSBridgeTmp.result, "name", nm)
        JSRT_ObjSet(JSBridgeTmp.result, "errors", JSBridgeTmp.val)
        ReturnValue(JSBridgeTmp.result)
    }
}

// Finish a combinator slot. ptr is the slot. alive is already 0.
Function.JSBridge__PFinish {
    Output: Integer
    Body: {
        mode = JSBridge__PNum("__mode__")
        JSBridgeTmp.count = mode
        vals = JSBridge__PGet("__vals__")
        JSBridgeTmp.result = vals
        // PGet writes result. Keep the values array in node across later PGets.
        JSBridgeTmp.node = JSBridgeTmp.result
        IfCondition EqualTo(JSBridgeTmp.count, 4) ThenBlock: {
            JSBridgeTmp.cb_val = JSBridge__PAggregate(JSBridgeTmp.node)
            cap = JSBridge__PGet("__cap__")
            JSBridgeTmp.obj = cap
            rej = JSRT_ObjGet(JSBridgeTmp.obj, "__rej__")
            JSBridgeTmp.val = rej
            okf = JSBridge__PromiseCallRaw(JSBridgeTmp.val, JSRTState.undef_val, JSBridgeTmp.cb_val, JSRTState.undef_val, 1)
            IfCondition EqualTo(okf, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        IfCondition Or(EqualTo(JSBridgeTmp.count, 5), EqualTo(JSBridgeTmp.count, 6)) ThenBlock: {
            obj = JSRT_CreateObject()
            JSBridgeTmp.dom_idx = obj
            JSRT_ObjSet(JSBridgeTmp.dom_idx, "__proto__", JSRTState.null_val)
            keys = JSBridge__PGet("__keys__")
            JSBridgeTmp.val2 = keys
            n = JSRT_ArrLen(JSBridgeTmp.val2)
            ki = 0
            WhileLoop LessThan(ki, n) {
                JSBridgeTmp.idx = ki
                ks = JSRT_ArrGet(JSBridgeTmp.val2, JSBridgeTmp.idx)
                vs = JSRT_ArrGet(JSBridgeTmp.node, JSBridgeTmp.idx)
                JSBridgeTmp.type = ks
                JSBridgeTmp.len = vs
                IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.type), JSType.STRING) ThenBlock: {
                    sp = JSRT_GetPayload(JSBridgeTmp.type)
                    JSRT_ObjSet(JSBridgeTmp.dom_idx, sp, JSBridgeTmp.len)
                }
                ki = Add(JSBridgeTmp.idx, 1)
            }
            JSBridgeTmp.cb_val = JSBridgeTmp.dom_idx
        } ElseBlock: {
            JSBridgeTmp.cb_val = JSBridgeTmp.node
        }
        cap2 = JSBridge__PGet("__cap__")
        JSBridgeTmp.obj = cap2
        res = JSRT_ObjGet(JSBridgeTmp.obj, "__res__")
        JSBridgeTmp.val = res
        okf2 = JSBridge__PromiseCallRaw(JSBridgeTmp.val, JSRTState.undef_val, JSBridgeTmp.cb_val, JSRTState.undef_val, 1)
        IfCondition EqualTo(okf2, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Status object {status, value|reason} with Object.prototype.
Function.JSBridge__PStatus {
    Input: ok: Integer
    Input: val: Address
    Output: Address
    Body: {
        JSBridgeTmp.idx = ok
        JSBridgeTmp.val = val
        o = JSRT_CreateObject()
        JSBridgeTmp.obj = o
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(JSBridgeTmp.obj, "__proto__", JSRTState.object_proto)
        }
        IfCondition EqualTo(JSBridgeTmp.idx, 1) ThenBlock: {
            s = JSRT_CreateString("fulfilled")
            JSRT_ObjSet(JSBridgeTmp.obj, "status", s)
            JSRT_ObjSet(JSBridgeTmp.obj, "value", JSBridgeTmp.val)
        } ElseBlock: {
            s2 = JSRT_CreateString("rejected")
            JSRT_ObjSet(JSBridgeTmp.obj, "status", s2)
            JSRT_ObjSet(JSBridgeTmp.obj, "reason", JSBridgeTmp.val)
        }
        ReturnValue(JSBridgeTmp.obj)
    }
}

// Element / finally thunk. Env is the element record.
Function.JSBridge__PromiseDoElem {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        // allSettled fulfill/reject elements share one alreadyCalled record.
        ac = JSRT_ObjGet(JSBridgeTmp.ptr, "__ac__")
        JSBridgeTmp.dom_idx = ac
        use_ac = 0
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.dom_idx), JSType.OBJECT) ThenBlock: {
            use_ac = 1
        }
        IfCondition EqualTo(use_ac, 1) ThenBlock: {
            vn = JSRT_ObjGet(JSBridgeTmp.dom_idx, "__v__")
            JSBridgeTmp.result = vn
            already = 0
            IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.NUMBER) ThenBlock: {
                IfCondition EqualTo(Float_ToInt(JSRT_GetPayload(JSBridgeTmp.result)), 1) ThenBlock: {
                    already = 1
                }
            }
            IfCondition EqualTo(already, 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            one_ac = JSRT_CreateNumber(1)
            JSRT_ObjSet(JSBridgeTmp.dom_idx, "__v__", one_ac)
        }
        IfCondition EqualTo(use_ac, 0) ThenBlock: {
            IfCondition EqualTo(JSBridge__PNum("__v__"), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
        }
        kind = JSBridge__PNum("__k__")
        JSBridgeTmp.count = kind
        // finally thunks are not once-flags of a combinator element
        IfCondition Or(EqualTo(JSBridgeTmp.count, 5), EqualTo(JSBridgeTmp.count, 6)) ThenBlock: {
            cb = JSBridge__PGet("__cb__")
            JSBridgeTmp.val = cb
            arg0 = JSRTState.undef_val
            IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
                arg0 = Dereference(JSBridgeTmp.node)
            }
            JSBridgeTmp.val2 = arg0
            ok = JSBridge__PromiseCallRaw(JSBridgeTmp.val, JSRTState.undef_val, JSRTState.undef_val, JSRTState.undef_val, 0)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(JSBridge__PPropagateFound())
            }
            IfCondition EqualTo(JSBridgeTmp.count, 6) ThenBlock: {
                ReturnValue(JSBridge__PRethrow(JSBridgeTmp.val2))
            }
            ReturnValue(JSBridgeTmp.val2)
        }
        JSBridge__PSetNum("__v__", 1)
        arg = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            arg = Dereference(JSBridgeTmp.node)
        }
        JSBridgeTmp.val = arg
        JSBridgeTmp.len = JSBridge__PNum("__i__")
        JSBridge__PGet("__slot__")
        JSBridgeTmp.obj = JSBridgeTmp.result
        // Build the slot value, then maybe finish.
        JSBridgeTmp.ptr = JSBridgeTmp.obj
        IfCondition EqualTo(JSBridgeTmp.count, 1) ThenBlock: {
            JSBridge__PGet("__vals__")
            JSBridgeTmp.node = JSBridgeTmp.result
            JSRT_ArrSet(JSBridgeTmp.node, JSBridgeTmp.len, JSBridgeTmp.val)
        }
        IfCondition EqualTo(JSBridgeTmp.count, 2) ThenBlock: {
            JSBridgeTmp.result = JSBridge__PStatus(1, JSBridgeTmp.val)
            JSBridgeTmp.val = JSBridgeTmp.result
            JSBridge__PGet("__vals__")
            JSBridgeTmp.node = JSBridgeTmp.result
            JSRT_ArrSet(JSBridgeTmp.node, JSBridgeTmp.len, JSBridgeTmp.val)
        }
        IfCondition EqualTo(JSBridgeTmp.count, 3) ThenBlock: {
            JSBridgeTmp.result = JSBridge__PStatus(0, JSBridgeTmp.val)
            JSBridgeTmp.val = JSBridgeTmp.result
            JSBridge__PGet("__vals__")
            JSBridgeTmp.node = JSBridgeTmp.result
            JSRT_ArrSet(JSBridgeTmp.node, JSBridgeTmp.len, JSBridgeTmp.val)
        }
        IfCondition EqualTo(JSBridgeTmp.count, 4) ThenBlock: {
            JSBridge__PGet("__vals__")
            JSBridgeTmp.node = JSBridgeTmp.result
            JSRT_ArrSet(JSBridgeTmp.node, JSBridgeTmp.len, JSBridgeTmp.val)
        }
        IfCondition Or(EqualTo(JSBridgeTmp.count, 9), EqualTo(JSBridgeTmp.count, 10)) ThenBlock: {
            IfCondition EqualTo(JSBridgeTmp.count, 10) ThenBlock: {
                JSBridgeTmp.result = JSBridge__PStatus(1, JSBridgeTmp.val)
                JSBridgeTmp.val = JSBridgeTmp.result
            }
            JSBridge__PGet("__vals__")
            JSBridgeTmp.node = JSBridgeTmp.result
            JSRT_ArrSet(JSBridgeTmp.node, JSBridgeTmp.len, JSBridgeTmp.val)
        }
        IfCondition EqualTo(JSBridgeTmp.count, 11) ThenBlock: {
            JSBridgeTmp.result = JSBridge__PStatus(0, JSBridgeTmp.val)
            JSBridgeTmp.val = JSBridgeTmp.result
            JSBridge__PGet("__vals__")
            JSBridgeTmp.node = JSBridgeTmp.result
            JSRT_ArrSet(JSBridgeTmp.node, JSBridgeTmp.len, JSBridgeTmp.val)
        }
        IfCondition EqualTo(JSBridge__PDec(), 1) ThenBlock: {
            IfCondition EqualTo(JSBridge__PFinish(), 0) ThenBlock: {
                ReturnValue(JSBridge__PRethrow(JSBridgeTmp.found))
            }
        }
        ReturnValue(JSRTState.undef_val)
    }
}

// Reject the capability in ptr with JSBridgeTmp.found and return the promise.
Function.JSBridge__PRejectFound {
    Output: Address
    Body: {
        jf = JSBridge__PGet("__rej__")
        JSBridgeTmp.val = jf
        err = JSBridgeTmp.found
        JSBridgeTmp.val2 = err
        JSBridge__PromiseCallRaw(JSBridgeTmp.val, JSRTState.undef_val, JSBridgeTmp.val2, JSRTState.undef_val, 1)
        pret = JSBridge__PGet("__p__")
        JSBridgeTmp.result = pret
        ReturnValue(JSBridgeTmp.result)
    }
}

// IteratorClose for a throw completion. Call return when it is a function
// (side effect only). GetMethod and return() throws lose to the original error.
// PIsObj/PIsFn overwrite found, so the original error stays on the bridge stack.
Function.JSBridge__PClose {
    Input: iterator: Address
    Input: err: Address
    Output: Address
    Body: {
        JSBridgeTmp.obj = iterator
        JSBridgeTmp.found = err
        JSBridge__Push(JSBridgeTmp.found)
        ot = JSRT_GetType(JSBridgeTmp.obj)
        notobj = 1
        IfCondition EqualTo(ot, JSType.OBJECT) ThenBlock: { notobj = 0 }
        IfCondition EqualTo(ot, JSType.FUNCTION) ThenBlock: { notobj = 0 }
        IfCondition EqualTo(ot, JSType.ARRAY) ThenBlock: { notobj = 0 }
        IfCondition EqualTo(notobj, 1) ThenBlock: {
            JSBridgeTmp.found = JSBridge__Pop()
            ReturnValue(JSBridgeTmp.found)
        }
        JSBridge__MapSaveState()
        retf = JSVM__ObjGetAcc(JSBridgeTmp.obj, "return")
        JSBridgeTmp.result = retf
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSBridge__MapCapture()
            JSBridgeTmp.found = JSBridge__Pop()
            ReturnValue(JSBridgeTmp.found)
        }
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.FUNCTION) ThenBlock: {
            JSBridge__PromiseCallRaw(JSBridgeTmp.result, JSBridgeTmp.obj, JSRTState.undef_val, JSRTState.undef_val, 0)
        }
        JSBridgeTmp.found = JSBridge__Pop()
        ReturnValue(JSBridgeTmp.found)
    }
}

// Open @@iterator. 1 and obj=iterator, val=next. 0 and found=error.
// Restores ptr. iterable is the argument.
Function.JSBridge__POpen {
    Input: iterable: Address
    Output: Integer
    Body: {
        JSBridgeTmp.val2 = iterable
        JSBridge__MapSaveState()
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.val2), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "is not iterable")
            JSBridgeTmp.found = terr
            JSBridge__MapLoadState()
            ReturnValue(0)
        }
        ik = 0
        IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
            ik = JSVM_SymbolToKey(JSVMSymbol.iterator)
        }
        JSBridgeTmp.name_ptr = ik
        IfCondition EqualTo(JSBridgeTmp.name_ptr, 0) ThenBlock: {
            terr2 = JSVM_CreateTypedError("TypeError", "is not iterable")
            JSBridgeTmp.found = terr2
            JSBridge__MapLoadState()
            ReturnValue(0)
        }
        JSBridge__MapSaveState()
        fac = JSVM__ObjGetAcc(JSBridgeTmp.val2, JSBridgeTmp.name_ptr)
        JSBridgeTmp.result = fac
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            e = JSBridge__MapCapture()
            JSBridgeTmp.found = e
            JSBridge__MapLoadState()
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.result), 0) ThenBlock: {
            terr3 = JSVM_CreateTypedError("TypeError", "is not iterable")
            JSBridgeTmp.found = terr3
            JSBridge__MapLoadState()
            ReturnValue(0)
        }
        JSBridgeTmp.cb_val = JSBridgeTmp.result
        JSBridge__MapSaveState()
        JSVM__SetGlobal("this", JSBridgeTmp.val2)
        it = JSVM__CallFunc(JSBridgeTmp.cb_val, JSVMCallBuf.buf, 0)
        JSBridgeTmp.result = it
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            e2 = JSBridge__MapCapture()
            JSBridgeTmp.found = e2
            JSBridge__MapLoadState()
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.result), 0) ThenBlock: {
            terr4 = JSVM_CreateTypedError("TypeError", "iterator is not an object")
            JSBridgeTmp.found = terr4
            JSBridge__MapLoadState()
            ReturnValue(0)
        }
        JSBridgeTmp.node = JSBridgeTmp.result
        JSBridge__MapSaveState()
        nx = JSVM__ObjGetAcc(JSBridgeTmp.node, "next")
        JSBridgeTmp.result = nx
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            e3 = JSBridge__MapCapture()
            JSBridgeTmp.found = e3
            JSBridge__MapLoadState()
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.result), 0) ThenBlock: {
            terr5 = JSVM_CreateTypedError("TypeError", "iterator.next is not a function")
            JSBridgeTmp.found = terr5
            JSBridge__MapLoadState()
            ReturnValue(0)
        }
        JSBridgeTmp.dom_idx = JSBridgeTmp.result
        JSBridge__MapLoadState()
        JSBridgeTmp.obj = JSBridgeTmp.node
        JSBridgeTmp.val = JSBridgeTmp.dom_idx
        ReturnValue(1)
    }
}

// One iterator step. iterator obj, next val. 2 done, 1 value in result, 0 throw.
// On value-get throw, closes. On next/done throw, does not close.
Function.JSBridge__PStep {
    Output: Integer
    Body: {
        JSBridge__MapSaveState()
        JSBridge__Push(JSBridgeTmp.val)
        JSVM__SetGlobal("this", JSBridgeTmp.obj)
        JSBridgeTmp.val = JSBridge__Pop()
        JSVMCall.exc_prop = 0
        st = JSVM__CallFunc(JSBridgeTmp.val, JSVMCallBuf.buf, 0)
        JSBridgeTmp.result = st
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            e = JSBridge__MapCapture()
            JSBridgeTmp.found = e
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.result), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "iterator result is not an object")
            JSBridgeTmp.found = terr
            ReturnValue(0)
        }
        JSBridgeTmp.cb_val = JSBridgeTmp.result
        JSBridge__MapSaveState()
        dv = JSVM__ObjGetAcc(JSBridgeTmp.cb_val, "done")
        JSBridgeTmp.result = dv
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            e2 = JSBridge__MapCapture()
            JSBridgeTmp.found = e2
            ReturnValue(0)
        }
        IfCondition EqualTo(JSRT_IsTruthy(JSBridgeTmp.result), 1) ThenBlock: {
            ReturnValue(2)
        }
        JSBridge__MapSaveState()
        vv = JSVM__ObjGetAcc(JSBridgeTmp.cb_val, "value")
        JSBridgeTmp.result = vv
        JSBridge__MapLoadState()
        // IteratorValue abrupt sets [[done]] so the outer close is skipped.
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSBridgeTmp.found = JSBridge__MapCapture()
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// mode 1 all, 2 allSettled, 3 race, 4 any.
Function.JSBridge__PromiseDoCombinator {
    Input: mode: Integer
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.count = mode
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSBridge__PThrow("Promise combinator called on non-object"))
        }
        // Snapshot the iterable. PNewCap runs user constructors, and super()
        // reuses JSVMCallBuf, which is the caller's arg buffer.
        itv0 = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            itv0 = Dereference(JSBridgeTmp.node)
        }
        JSBridgeTmp.type = itv0
        JSBridge__Push(JSBridgeTmp.node)
        JSBridge__Push(JSBridgeTmp.type)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridge__Push(JSBridgeTmp.idx)
        cap = JSBridge__PNewCap(JSBridgeTmp.obj)
        JSBridgeTmp.ptr = cap
        JSBridgeTmp.idx = JSBridge__Pop()
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.type = JSBridge__Pop()
        JSBridgeTmp.node = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.ptr, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        // constructor.resolve before GetIterator. A throw rejects; no iterator yet.
        // MapSave does not keep type (iterable) or count (mode). A getter that
        // creates a function stores JSType.FUNCTION (6) in type, and POpen
        // then calls GetType on that 6.
        JSBridge__Push(JSBridgeTmp.type)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridge__MapSaveState()
        rsf = JSVM__ObjGetAcc(JSBridgeTmp.obj, "resolve")
        JSBridgeTmp.result = rsf
        JSBridge__MapLoadState()
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.type = JSBridge__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            e = JSBridge__MapCapture()
            JSBridgeTmp.found = e
            ReturnValue(JSBridge__PRejectFound())
        }
        IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.result), 0) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "resolve is not a function")
            JSBridgeTmp.found = terr
            ReturnValue(JSBridge__PRejectFound())
        }
        JSBridge__PSet("__rs__", JSBridgeTmp.result)
        JSBridge__PSet("__c__", JSBridgeTmp.obj)
        IfCondition EqualTo(JSBridge__POpen(JSBridgeTmp.type), 0) ThenBlock: {
            ReturnValue(JSBridge__PRejectFound())
        }
        slot = JSRT_CreateObject()
        JSBridgeTmp.dom_idx = slot
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__it__", JSBridgeTmp.obj)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__nx__", JSBridgeTmp.val)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__cap__", JSBridgeTmp.ptr)
        capc = JSRT_ObjGet(JSBridgeTmp.ptr, "__c__")
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__c__", capc)
        caprs = JSRT_ObjGet(JSBridgeTmp.ptr, "__rs__")
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__rs__", caprs)
        mn = JSRT_CreateNumber(JSBridgeTmp.count)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__mode__", mn)
        one = JSRT_CreateNumber(1)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__n__", one)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__alive__", one)
        z = JSRT_CreateNumber(0)
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__i__", z)
        arr = JSRT_CreateArray()
        JSRT_ObjSet(JSBridgeTmp.dom_idx, "__vals__", arr)
        JSBridgeTmp.ptr = JSBridgeTmp.dom_idx
        JSBridge__PSetNum("__g__", 0)
        JSBridgeTmp.idx = 0
        WhileLoop LessThan(JSBridgeTmp.idx, 1000000) {
            g = JSBridge__PNum("__g__")
            JSBridge__PSetNum("__g__", Add(g, 1))
            JSBridgeTmp.obj = JSBridge__PGet("__it__")
            JSBridgeTmp.val = JSBridge__PGet("__nx__")
            step = JSBridge__PStep()
            IfCondition EqualTo(step, 0) ThenBlock: {
                JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                // PStep may have clobbered ptr. The slot's __cap__ is needed.
                // ptr was the slot before PStep. PStep MapSave/Load restores it
                // only around its own calls. ptr should still be the slot if
                // PStep's Load is balanced. Re-get cap from the slot.
                ReturnValue(JSBridge__PRejectFound())
            }
            IfCondition EqualTo(step, 2) ThenBlock: {
                IfCondition NotEqual(JSBridge__PNum("__mode__"), 3) ThenBlock: {
                    IfCondition EqualTo(JSBridge__PDec(), 1) ThenBlock: {
                        IfCondition EqualTo(JSBridge__PFinish(), 0) ThenBlock: {
                            JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                            ReturnValue(JSBridge__PRejectFound())
                        }
                    }
                }
                pret = JSBridge__PGet("__cap__")
                JSBridgeTmp.obj = pret
                outp = JSRT_ObjGet(JSBridgeTmp.obj, "__p__")
                JSBridgeTmp.result = outp
                ReturnValue(JSBridgeTmp.result)
            }
            // value is in result. Bump remaining before then(), except race.
            JSBridgeTmp.type = JSBridgeTmp.result
            IfCondition NotEqual(JSBridge__PNum("__mode__"), 3) ThenBlock: {
                JSBridgeTmp.count = JSBridge__PNum("__n__")
                JSBridgeTmp.count = Add(JSBridgeTmp.count, 1)
                JSBridge__PSetNum("__n__", JSBridgeTmp.count)
            }
            JSBridgeTmp.len = JSBridge__PNum("__i__")
            JSBridge__PSetNum("__i__", Add(JSBridgeTmp.len, 1))
            ctor = JSBridge__PGet("__c__")
            JSBridgeTmp.obj = ctor
            rfn = JSBridge__PGet("__rs__")
            JSBridgeTmp.val = rfn
            ok = JSBridge__PromiseCallRaw(JSBridgeTmp.val, JSBridgeTmp.obj, JSBridgeTmp.type, JSRTState.undef_val, 1)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                itc = JSBridge__PGet("__it__")
                cerr = JSBridge__PClose(itc, JSBridgeTmp.found)
                JSBridgeTmp.found = cerr
                JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                ReturnValue(JSBridge__PRejectFound())
            }
            JSBridgeTmp.type = JSBridgeTmp.result
            JSBridge__PSet("__np__", JSBridgeTmp.type)
            JSBridge__PSet("__a0__", JSRTState.undef_val)
            JSBridge__PSet("__a1__", JSRTState.undef_val)
            // PromiseCallRaw clobbers len. Slot __i__ was already bumped.
            JSBridgeTmp.len = JSBridge__PNum("__i__")
            JSBridgeTmp.len = Subtract(JSBridgeTmp.len, 1)
            IfCondition EqualTo(JSBridge__PNum("__mode__"), 3) ThenBlock: {
                JSBridge__PGet("__cap__")
                JSBridgeTmp.obj = JSBridgeTmp.result
                JSBridgeTmp.val = JSRT_ObjGet(JSBridgeTmp.obj, "__res__")
                JSBridge__PSet("__a0__", JSBridgeTmp.val)
                JSBridgeTmp.val = JSRT_ObjGet(JSBridgeTmp.obj, "__rej__")
                JSBridge__PSet("__a1__", JSBridgeTmp.val)
            }
            IfCondition EqualTo(JSBridge__PNum("__mode__"), 1) ThenBlock: {
                JSBridgeTmp.cb_val = JSBridge__PMakeElem(1, JSBridgeTmp.len)
                JSBridge__PSet("__a0__", JSBridgeTmp.cb_val)
                JSBridge__PGet("__cap__")
                JSBridgeTmp.obj = JSBridgeTmp.result
                JSBridgeTmp.val = JSRT_ObjGet(JSBridgeTmp.obj, "__rej__")
                JSBridge__PSet("__a1__", JSBridgeTmp.val)
            }
            IfCondition EqualTo(JSBridge__PNum("__mode__"), 2) ThenBlock: {
                JSBridgeTmp.cb_val = JSBridge__PMakeElem(2, JSBridgeTmp.len)
                JSBridge__PSet("__a0__", JSBridgeTmp.cb_val)
                JSBridgeTmp.cb_val = JSBridge__PMakeElem(3, JSBridgeTmp.len)
                JSBridge__PSet("__a1__", JSBridgeTmp.cb_val)
                flag = JSRT_CreateObject()
                JSBridgeTmp.dom_idx = flag
                zf = JSRT_CreateNumber(0)
                JSRT_ObjSet(JSBridgeTmp.dom_idx, "__v__", zf)
                JSBridge__Push(JSBridgeTmp.dom_idx)
                fn0 = JSBridge__PGet("__a0__")
                JSBridgeTmp.val = fn0
                env0 = JSRT_FuncGetEnv(JSBridgeTmp.val)
                JSBridgeTmp.type = env0
                JSBridgeTmp.dom_idx = JSBridge__Pop()
                JSRT_ObjSet(JSBridgeTmp.type, "__ac__", JSBridgeTmp.dom_idx)
                JSBridge__Push(JSBridgeTmp.dom_idx)
                fn1 = JSBridge__PGet("__a1__")
                JSBridgeTmp.val = fn1
                env1 = JSRT_FuncGetEnv(JSBridgeTmp.val)
                JSBridgeTmp.type = env1
                JSBridgeTmp.dom_idx = JSBridge__Pop()
                JSRT_ObjSet(JSBridgeTmp.type, "__ac__", JSBridgeTmp.dom_idx)
            }
            IfCondition EqualTo(JSBridge__PNum("__mode__"), 4) ThenBlock: {
                JSBridge__PGet("__cap__")
                JSBridgeTmp.obj = JSBridgeTmp.result
                JSBridgeTmp.val = JSRT_ObjGet(JSBridgeTmp.obj, "__res__")
                JSBridge__PSet("__a0__", JSBridgeTmp.val)
                JSBridgeTmp.cb_val = JSBridge__PMakeElem(4, JSBridgeTmp.len)
                JSBridge__PSet("__a1__", JSBridgeTmp.cb_val)
            }
            JSBridgeTmp.val = JSBridge__PGet("__a0__")
            JSBridgeTmp.val2 = JSBridge__PGet("__a1__")
            JSBridgeTmp.type = JSBridge__PGet("__np__")
            JSBridgeTmp.cb_val = JSRTState.undef_val
            IfCondition EqualTo(JSBridge__PIsObj(JSBridgeTmp.type), 1) ThenBlock: {
                JSBridge__MapSaveState()
                thg = JSVM__ObjGetAcc(JSBridgeTmp.type, "then")
                JSBridgeTmp.result = thg
                JSBridge__MapLoadState()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    e4 = JSBridge__MapCapture()
                    itc2 = JSBridge__PGet("__it__")
                    cerr2 = JSBridge__PClose(itc2, e4)
                    JSBridgeTmp.found = cerr2
                    JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                    ReturnValue(JSBridge__PRejectFound())
                }
                JSBridgeTmp.cb_val = JSBridgeTmp.result
            }
            IfCondition EqualTo(JSBridge__PIsFn(JSBridgeTmp.cb_val), 0) ThenBlock: {
                terr6 = JSVM_CreateTypedError("TypeError", "then is not a function")
                itc3 = JSBridge__PGet("__it__")
                cerr3 = JSBridge__PClose(itc3, terr6)
                JSBridgeTmp.found = cerr3
                JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                ReturnValue(JSBridge__PRejectFound())
            }
            JSBridgeTmp.type = JSBridge__PGet("__np__")
            JSBridgeTmp.val = JSBridge__PGet("__a0__")
            JSBridgeTmp.val2 = JSBridge__PGet("__a1__")
            ok2 = JSBridge__PromiseCallRaw(JSBridgeTmp.cb_val, JSBridgeTmp.type, JSBridgeTmp.val, JSBridgeTmp.val2, 2)
            IfCondition EqualTo(ok2, 0) ThenBlock: {
                itc4 = JSBridge__PGet("__it__")
                cerr4 = JSBridge__PClose(itc4, JSBridgeTmp.found)
                JSBridgeTmp.found = cerr4
                JSBridgeTmp.ptr = JSBridge__PGet("__cap__")
                ReturnValue(JSBridge__PRejectFound())
            }
            JSBridgeTmp.idx = JSBridge__PNum("__g__")
        }
        pret2 = JSBridge__PGet("__cap__")
        JSBridgeTmp.obj = pret2
        out2 = JSRT_ObjGet(JSBridgeTmp.obj, "__p__")
        JSBridgeTmp.result = out2
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__PromiseDoAll {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        ReturnValue(JSBridge__PromiseDoCombinator(1, JSBridgeTmp.obj, JSBridgeTmp.node, JSBridgeTmp.idx))
    }
}

Function.JSBridge__PromiseDoAllSettled {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
