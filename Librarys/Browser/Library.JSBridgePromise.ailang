}

Function.JSBridge__PromiseDoAny {
    Input: recv: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.obj = recv
        JSBridgeTmp.node = args
        JSBridgeTmp.idx = argc
        ReturnValue(JSBridge__PromiseDoCombinator(4, JSBridgeTmp.obj, JSBridgeTmp.node, JSBridgeTmp.idx))
