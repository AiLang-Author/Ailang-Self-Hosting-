// Reflect methods other than has/get/set.
// set is OrdinarySet in Part15 (receiver, accessors, proxy set trap).
// construct is id 444. It is not a constructor.
// Ids 435..444. Not constructors.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// 1 if the pending throw is a TypeError we turn into false.
// mode 0: any TypeError. mode 1: only "Object.setPrototypeOf failed".
// Other throws are raised again.
Function.JSBridge__ReflectSwallow {
    Input: mode: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.idx = mode
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition And(NotEqual(JSVMCall.exc_prop, 1), NotEqual(JSVMState.error, 1)) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.result = JSBridge__MapCapture()
        JSBridge__Push(JSBridgeTmp.result)
        JSBridgeTmp.val = JSVM__GetProperty(JSBridgeTmp.result, "name")
        JSBridgeTmp.result = JSBridge__Pop()
        JSBridgeTmp.found = 0
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.val), JSType.STRING) ThenBlock: {
            JSBridgeTmp.addr = JSRT_GetPayload(JSBridgeTmp.val)
            JSBridgeTmp.found = JSRT_StrEq(JSBridgeTmp.addr, "TypeError")
        }
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            JSVM_ThrowValue(JSBridgeTmp.result)
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridgeTmp.idx, 1) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.result)
            JSBridgeTmp.val = JSVM__GetProperty(JSBridgeTmp.result, "message")
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.found = 0
            IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.val), JSType.STRING) ThenBlock: {
                JSBridgeTmp.addr = JSRT_GetPayload(JSBridgeTmp.val)
                JSBridgeTmp.found = JSRT_StrEq(JSBridgeTmp.addr, "Object.setPrototypeOf failed")
            }
            IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
                JSVM_ThrowValue(JSBridgeTmp.result)
                ReturnValue(0)
            }
        }
        ReturnValue(1)
    }
}

// Object, function, or array, and not a primitive symbol. Throws otherwise.
Function.JSBridge__ReflectNeedObj {
    Input: v: Address
    Output: Address
    Body: {
        JSBridgeTmp.obj = v
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.obj)
        JSBridgeTmp.found = 0
        IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.ARRAY) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.obj)
            // len, not count: callers keep argc in count.
            JSBridgeTmp.len = JSVM_IsPrimSymbol(JSBridgeTmp.obj)
            JSBridgeTmp.obj = JSBridge__Pop()
            IfCondition EqualTo(JSBridgeTmp.len, 1) ThenBlock: {
                JSBridgeTmp.found = 0
            }
        }
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            JSBridgeTmp.result = JSVM_CreateTypedError("TypeError", "Reflect called on non-object")
            JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.result)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = JSBridgeTmp.result
            JSVM_ThrowValue(JSBridgeTmp.result)
            ReturnValue(0)
        }
        ReturnValue(JSBridgeTmp.obj)
    }
}

// Reflect.get(target, key, receiver): call an accessor with receiver as this.
// Data properties and proxies fall through to ordinary Get.
Function.JSBridge__ReflectGetRecv {
    Input: obj: Address
    Input: key: Address
    Input: recv: Address
    Output: Address
    Body: {
        JSBridgeTmp.obj = obj
        JSBridgeTmp.name_ptr = key
        JSBridgeTmp.saved_this = recv
        JSBridgeTmp.found = 0
        JSBridge__Push(JSBridgeTmp.name_ptr)
        JSBridgeTmp.addr = JSBridge__MakeAccKey(JSBridgeTmp.name_ptr, 0)
        JSBridgeTmp.name_ptr = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.addr, 0) ThenBlock: {
            ReturnValue(JSVM__GetProperty(JSBridgeTmp.obj, JSBridgeTmp.name_ptr))
        }
        JSBridgeTmp.val = JSBridgeTmp.obj
        JSBridgeTmp.idx = 0
        WhileLoop And(EqualTo(JSBridgeTmp.found, 0), LessThan(JSBridgeTmp.idx, 32)) {
            JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.val)
            JSBridgeTmp.count = 0
            IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.count = 1 }
            IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.count = 1 }
            IfCondition EqualTo(JSBridgeTmp.type, JSType.ARRAY) ThenBlock: { JSBridgeTmp.count = 1 }
            IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
                JSBridgeTmp.found = 3
            } ElseBlock: {
                JSBridgeTmp.count = JSRT_ObjHas(JSBridgeTmp.val, JSBridgeTmp.addr)
                IfCondition EqualTo(JSBridgeTmp.count, 1) ThenBlock: {
                    JSBridgeTmp.cb_val = JSRT_ObjGet(JSBridgeTmp.val, JSBridgeTmp.addr)
                    JSBridgeTmp.found = 1
                } ElseBlock: {
                    JSBridgeTmp.count = JSRT_ObjHas(JSBridgeTmp.val, JSBridgeTmp.name_ptr)
                    IfCondition EqualTo(JSBridgeTmp.count, 1) ThenBlock: {
                        JSBridgeTmp.found = 2
                    } ElseBlock: {
                        JSBridgeTmp.val2 = JSRT_ObjGet(JSBridgeTmp.val, "__proto__")
                        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.val2)
                        IfCondition Or(EqualTo(JSBridgeTmp.type, JSType.NULL), EqualTo(JSBridgeTmp.type, JSType.UNDEFINED)) ThenBlock: {
                            JSBridgeTmp.found = 3
                        } ElseBlock: {
                            IfCondition EqualTo(JSBridgeTmp.val2, JSBridgeTmp.val) ThenBlock: {
                                JSBridgeTmp.found = 3
                            } ElseBlock: {
                                JSBridgeTmp.val = JSBridgeTmp.val2
                            }
                        }
                    }
                }
            }
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
        }
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.cb_val)
            IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: {
                JSBridge__Push(JSVM__GetGlobal("this"))
                JSVM__SetGlobal("this", JSBridgeTmp.saved_this)
                JSBridgeTmp.result = JSVM__CallFunc(JSBridgeTmp.cb_val, JSVMCallBuf.buf, 0)
                JSBridgeTmp.ptr = JSBridge__Pop()
                JSVM__SetGlobal("this", JSBridgeTmp.ptr)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(JSRT_Undefined())
                }
                ReturnValue(JSBridgeTmp.result)
            }
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(JSVM__GetProperty(JSBridgeTmp.obj, JSBridgeTmp.name_ptr))
    }
}

Function.JSBridge__ReflectApply {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = args
        JSBridgeTmp.count = argc
        JSBridgeTmp.obj = JSRT_Undefined()
        IfCondition GreaterThan(JSBridgeTmp.count, 0) ThenBlock: {
            JSBridgeTmp.obj = RDMEM_64(JSBridgeTmp.ptr)
        }
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.obj)
        IfCondition NotEqual(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSBridge__ThrowNotCallable())
        }
        IfCondition LessThan(JSBridgeTmp.count, 3) ThenBlock: {
            JSBridgeTmp.result = JSVM_CreateTypedError("TypeError", "CreateListFromArrayLike called on non-object")
            JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.result)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = JSBridgeTmp.result
            JSVM_ThrowValue(JSBridgeTmp.result)
            ReturnValue(0)
        }
        JSBridgeTmp.val = RDMEM_64(JSBridgeTmp.ptr, 8)
        JSBridgeTmp.val2 = RDMEM_64(JSBridgeTmp.ptr, 16)
        // Function.prototype.apply allows null/undefined. Reflect.apply does not.
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.val2)
        JSBridgeTmp.found = 0
        IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.ARRAY) ThenBlock: { JSBridgeTmp.found = 1 }
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridgeTmp.len = JSVM_IsPrimSymbol(JSBridgeTmp.val2)
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.len, 1) ThenBlock: { JSBridgeTmp.found = 0 }
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            JSBridgeTmp.result = JSVM_CreateTypedError("TypeError", "CreateListFromArrayLike called on non-object")
            JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.result)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = JSBridgeTmp.result
            JSVM_ThrowValue(JSBridgeTmp.result)
            ReturnValue(0)
        }
        WRMEM_64(JSVMCallBuf.buf, JSBridgeTmp.val)
        WRMEM_64(JSVMCallBuf.buf, 8, JSBridgeTmp.val2)
        JSBridge__Push(JSVM__GetGlobal("this"))
        JSVM__SetGlobal("this", JSBridgeTmp.obj)
        JSBridgeTmp.result = JSBridge__NFuncApply(JSVMCallBuf.buf, 2)
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSVM__SetGlobal("this", JSBridgeTmp.ptr)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__ReflectDefine {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = args
        JSBridgeTmp.count = argc
        IfCondition LessThan(JSBridgeTmp.count, 1) ThenBlock: {
            ReturnValue(JSBridge__ReflectNeedObj(0))
        }
        JSBridgeTmp.obj = JSBridge__ReflectNeedObj(RDMEM_64(JSBridgeTmp.ptr))
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        // ToPropertyKey runs before the descriptor check. argc < 3 never
        // reaches NDefineProperty, which returns before converting the key.
        IfCondition LessThan(JSBridgeTmp.count, 3) ThenBlock: {
            IfCondition GreaterThan(JSBridgeTmp.count, 1) ThenBlock: {
                JSBridgeTmp.val = RDMEM_64(JSBridgeTmp.ptr, 8)
                JSBridge__Push(JSBridgeTmp.ptr)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridgeTmp.result = JSVM_ToPropertyKey(JSBridgeTmp.val)
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.ptr = JSBridge__Pop()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(0)
                }
                IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
            JSBridgeTmp.result = JSVM_CreateTypedError("TypeError", "Property description must be an object")
            JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.result)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = JSBridgeTmp.result
            JSVM_ThrowValue(JSBridgeTmp.result)
            ReturnValue(0)
        }
        JSBridgeTmp.result = JSBridge__NDefineProperty(JSBridgeTmp.ptr, JSBridgeTmp.count)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSBridgeTmp.found = JSBridge__ReflectSwallow(0)
            IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            ReturnValue(0)
        }
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.result)
        IfCondition EqualTo(JSBridgeTmp.type, JSType.BOOLEAN) ThenBlock: {
            JSVMCall.thrown_val = 0
            JSVMState.exc_val = 0
            ReturnValue(JSBridgeTmp.result)
        }
        ReturnValue(JSRT_CreateBool(1))
    }
}

Function.JSBridge__ReflectDelete {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = args
        JSBridgeTmp.count = argc
        IfCondition LessThan(JSBridgeTmp.count, 1) ThenBlock: {
            ReturnValue(JSBridge__ReflectNeedObj(0))
        }
        JSBridgeTmp.obj = JSBridge__ReflectNeedObj(RDMEM_64(JSBridgeTmp.ptr))
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.val = JSRT_Undefined()
        IfCondition GreaterThan(JSBridgeTmp.count, 1) ThenBlock: {
            JSBridgeTmp.val = RDMEM_64(JSBridgeTmp.ptr, 8)
        }
        // Proxy [[Delete]]. A throwing deleteProperty trap is the abrupt result.
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridgeTmp.found = JSBridge__ReflectInvokeTrap(JSBridgeTmp.obj, "deleteProperty", JSBridgeTmp.val, 2)
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition LessThan(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(JSRT_IsTruthy(JSBridgeTmp.result)))
        }
        JSBridge__Push(JSVMState.is_strict)
        JSVMState.is_strict = 0
        JSVM__StackPush(JSBridgeTmp.obj)
        JSVM__StackPush(JSBridgeTmp.val)
        JSVM_OpDeleteProp()
        JSBridgeTmp.idx = JSBridge__Pop()
        JSVMState.is_strict = JSBridgeTmp.idx
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.result = JSVM__StackPop()
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__ReflectGetDesc {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = args
        JSBridgeTmp.count = argc
        IfCondition LessThan(JSBridgeTmp.count, 1) ThenBlock: {
            ReturnValue(JSBridge__ReflectNeedObj(0))
        }
        JSBridgeTmp.obj = JSBridge__ReflectNeedObj(RDMEM_64(JSBridgeTmp.ptr))
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.result = JSBridge__NGetOwnPropDesc(JSBridgeTmp.ptr, JSBridgeTmp.count)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__ReflectGetProto {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = args
        JSBridgeTmp.count = argc
        IfCondition LessThan(JSBridgeTmp.count, 1) ThenBlock: {
            ReturnValue(JSBridge__ReflectNeedObj(0))
        }
        JSBridgeTmp.obj = JSBridge__ReflectNeedObj(RDMEM_64(JSBridgeTmp.ptr))
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.result = JSBridge__NGetProtoOf(JSBridgeTmp.ptr, JSBridgeTmp.count)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__ReflectIsExt {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = args
        JSBridgeTmp.count = argc
        IfCondition LessThan(JSBridgeTmp.count, 1) ThenBlock: {
            ReturnValue(JSBridge__ReflectNeedObj(0))
        }
        JSBridgeTmp.obj = JSBridge__ReflectNeedObj(RDMEM_64(JSBridgeTmp.ptr))
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridgeTmp.found = JSBridge__ReflectInvokeTrap(JSBridgeTmp.obj, "isExtensible", 0, 1)
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition LessThan(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(JSRT_IsTruthy(JSBridgeTmp.result)))
        }
        JSBridgeTmp.result = JSBridge__NObjIsExtensible(JSBridgeTmp.ptr, JSBridgeTmp.count)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__ReflectPrevent {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = args
        JSBridgeTmp.count = argc
        IfCondition LessThan(JSBridgeTmp.count, 1) ThenBlock: {
            ReturnValue(JSBridge__ReflectNeedObj(0))
        }
        JSBridgeTmp.obj = JSBridge__ReflectNeedObj(RDMEM_64(JSBridgeTmp.ptr))
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Proxy [[PreventExtensions]] returns the trap boolean. true is a
        // TypeError when the target is still extensible.
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridgeTmp.found = JSBridge__ReflectInvokeTrap(JSBridgeTmp.obj, "preventExtensions", 0, 1)
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition LessThan(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            JSBridgeTmp.len = JSRT_IsTruthy(JSBridgeTmp.result)
            IfCondition EqualTo(JSBridgeTmp.len, 1) ThenBlock: {
                JSBridge__Push(JSBridgeTmp.obj)
                JSBridgeTmp.addr = JSRT_ObjGet(JSBridgeTmp.obj, "__p_t__")
                JSBridgeTmp.obj = JSBridge__Pop()
                WRMEM_64(JSVMCallBuf.buf, JSBridgeTmp.addr)
                JSBridgeTmp.result = JSBridge__NObjIsExtensible(JSVMCallBuf.buf, 1)
                IfCondition EqualTo(JSRT_IsTruthy(JSBridgeTmp.result), 1) ThenBlock: {
                    JSBridgeTmp.result = JSVM_CreateTypedError("TypeError", "preventExtensions trap returned true")
                    JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.result)
                    JSVMCall.exc_prop = 1
                    JSVMCall.thrown_val = JSBridgeTmp.result
                    JSVM_ThrowValue(JSBridgeTmp.result)
                    ReturnValue(0)
                }
            }
            ReturnValue(JSRT_CreateBool(JSBridgeTmp.len))
        }
        JSBridgeTmp.result = JSBridge__NObjPreventExt(JSBridgeTmp.ptr, JSBridgeTmp.count)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(JSRT_CreateBool(1))
    }
}

Function.JSBridge__ReflectSetProto {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = args
        JSBridgeTmp.count = argc
        IfCondition LessThan(JSBridgeTmp.count, 1) ThenBlock: {
            ReturnValue(JSBridge__ReflectNeedObj(0))
        }
        JSBridgeTmp.obj = JSBridge__ReflectNeedObj(RDMEM_64(JSBridgeTmp.ptr))
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.result = JSBridge__NSetProtoOf(JSBridgeTmp.ptr, JSBridgeTmp.count)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSBridgeTmp.found = JSBridge__ReflectSwallow(1)
            IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                ReturnValue(JSRT_CreateBool(0))
            }
            ReturnValue(0)
        }
        ReturnValue(JSRT_CreateBool(1))
    }
}

Function.JSBridge__ReflectAppend {
    Input: dst: Address
    Input: src: Address
    Output: Address
    Body: {
        JSBridgeTmp.obj = dst
        JSBridgeTmp.val = src
        JSBridgeTmp.count = JSRT_ArrLen(JSBridgeTmp.val)
        JSBridgeTmp.idx = 0
        WhileLoop LessThan(JSBridgeTmp.idx, JSBridgeTmp.count) {
            JSBridge__Push(JSBridgeTmp.idx)
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.val)
            JSBridgeTmp.result = JSRT_ArrGet(JSBridgeTmp.val, JSBridgeTmp.idx)
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            JSBridgeTmp.idx = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.idx)
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.val)
            JSRT_ArrPush(JSBridgeTmp.obj, JSBridgeTmp.result)
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            JSBridgeTmp.idx = JSBridge__Pop()
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
        }
        ReturnValue(JSBridgeTmp.obj)
    }
}

// Canonical array index, or -1. 2^32-1 is not an index.
Function.JSBridge__ReflectKeyIndex {
    Input: key: Address
    Output: Integer
    Body: {
        JSBridgeTmp.val = key
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.val)
        IfCondition NotEqual(JSBridgeTmp.type, JSType.STRING) ThenBlock: {
            ReturnValue(-1)
        }
        JSBridge__Push(JSBridgeTmp.val)
        JSBridgeTmp.addr = JSRT_GetPayload(JSBridgeTmp.val)
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.val)
        JSBridgeTmp.found = JSBridge__ArrIndexOrNeg(JSBridgeTmp.addr)
        JSBridgeTmp.val = JSBridge__Pop()
        IfCondition LessThan(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterEqual(JSBridgeTmp.found, 4294967295) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(JSBridgeTmp.found)
    }
}

// Array indices ascending, then other strings in creation order.
Function.JSBridge__ReflectOrderKeys {
    Input: src: Address
    Output: Address
    Body: {
        JSBridgeTmp.obj = src
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridgeTmp.count = JSRT_ArrLen(JSBridgeTmp.obj)
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridgeTmp.result = JSRT_CreateArray()
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridge__Push(JSBridgeTmp.result)
        JSBridgeTmp.val2 = JSRT_CreateArray()
        JSBridgeTmp.result = JSBridge__Pop()
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridgeTmp.idx = 0
        WhileLoop LessThan(JSBridgeTmp.idx, JSBridgeTmp.count) {
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.count)
            JSBridge__Push(JSBridgeTmp.result)
            JSBridge__Push(JSBridgeTmp.val2)
            JSBridge__Push(JSBridgeTmp.idx)
            JSBridgeTmp.saved_this = JSRT_ArrGet(JSBridgeTmp.obj, JSBridgeTmp.idx)
            JSBridgeTmp.idx = JSBridge__Pop()
            JSBridgeTmp.val2 = JSBridge__Pop()
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.count = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.count)
            JSBridge__Push(JSBridgeTmp.result)
            JSBridge__Push(JSBridgeTmp.val2)
            JSBridge__Push(JSBridgeTmp.idx)
            JSBridge__Push(JSBridgeTmp.saved_this)
            JSBridgeTmp.found = JSBridge__ReflectKeyIndex(JSBridgeTmp.saved_this)
            JSBridgeTmp.saved_this = JSBridge__Pop()
            JSBridgeTmp.idx = JSBridge__Pop()
            JSBridgeTmp.val2 = JSBridge__Pop()
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.count = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            IfCondition GreaterEqual(JSBridgeTmp.found, 0) ThenBlock: {
                JSBridge__Push(JSBridgeTmp.obj)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridge__Push(JSBridgeTmp.result)
                JSBridge__Push(JSBridgeTmp.val2)
                JSBridge__Push(JSBridgeTmp.idx)
                JSBridge__Push(JSBridgeTmp.saved_this)
                JSRT_ArrPush(JSBridgeTmp.result, JSBridgeTmp.saved_this)
                JSBridgeTmp.saved_this = JSBridge__Pop()
                JSBridgeTmp.idx = JSBridge__Pop()
                JSBridgeTmp.val2 = JSBridge__Pop()
                JSBridgeTmp.result = JSBridge__Pop()
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.obj = JSBridge__Pop()
            } ElseBlock: {
                JSBridge__Push(JSBridgeTmp.obj)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridge__Push(JSBridgeTmp.result)
                JSBridge__Push(JSBridgeTmp.val2)
                JSBridge__Push(JSBridgeTmp.idx)
                JSBridge__Push(JSBridgeTmp.saved_this)
                JSRT_ArrPush(JSBridgeTmp.val2, JSBridgeTmp.saved_this)
                JSBridgeTmp.saved_this = JSBridge__Pop()
                JSBridgeTmp.idx = JSBridge__Pop()
                JSBridgeTmp.val2 = JSBridge__Pop()
                JSBridgeTmp.result = JSBridge__Pop()
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.obj = JSBridge__Pop()
            }
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
        }
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridgeTmp.len = JSRT_ArrLen(JSBridgeTmp.result)
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.idx = 0
        WhileLoop LessThan(JSBridgeTmp.idx, JSBridgeTmp.len) {
            JSBridgeTmp.count = JSBridgeTmp.idx
            JSBridge__Push(JSBridgeTmp.val2)
            JSBridge__Push(JSBridgeTmp.result)
            JSBridge__Push(JSBridgeTmp.len)
            JSBridge__Push(JSBridgeTmp.idx)
            JSBridge__Push(JSBridgeTmp.count)
            JSBridgeTmp.saved_this = JSRT_ArrGet(JSBridgeTmp.result, JSBridgeTmp.idx)
            JSBridgeTmp.count = JSBridge__Pop()
            JSBridgeTmp.idx = JSBridge__Pop()
            JSBridgeTmp.len = JSBridge__Pop()
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.val2 = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.val2)
            JSBridge__Push(JSBridgeTmp.result)
            JSBridge__Push(JSBridgeTmp.len)
            JSBridge__Push(JSBridgeTmp.idx)
            JSBridge__Push(JSBridgeTmp.count)
            JSBridge__Push(JSBridgeTmp.saved_this)
            JSBridgeTmp.found = JSBridge__ReflectKeyIndex(JSBridgeTmp.saved_this)
            JSBridgeTmp.saved_this = JSBridge__Pop()
            JSBridgeTmp.count = JSBridge__Pop()
            JSBridgeTmp.idx = JSBridge__Pop()
            JSBridgeTmp.len = JSBridge__Pop()
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.val2 = JSBridge__Pop()
            JSBridgeTmp.node = Add(JSBridgeTmp.idx, 1)
            WhileLoop LessThan(JSBridgeTmp.node, JSBridgeTmp.len) {
                JSBridge__Push(JSBridgeTmp.val2)
                JSBridge__Push(JSBridgeTmp.result)
                JSBridge__Push(JSBridgeTmp.len)
                JSBridge__Push(JSBridgeTmp.idx)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridge__Push(JSBridgeTmp.found)
                JSBridge__Push(JSBridgeTmp.node)
                JSBridgeTmp.cb_val = JSRT_ArrGet(JSBridgeTmp.result, JSBridgeTmp.node)
                JSBridgeTmp.node = JSBridge__Pop()
                JSBridgeTmp.found = JSBridge__Pop()
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.idx = JSBridge__Pop()
                JSBridgeTmp.len = JSBridge__Pop()
                JSBridgeTmp.result = JSBridge__Pop()
                JSBridgeTmp.val2 = JSBridge__Pop()
                JSBridge__Push(JSBridgeTmp.val2)
                JSBridge__Push(JSBridgeTmp.result)
                JSBridge__Push(JSBridgeTmp.len)
                JSBridge__Push(JSBridgeTmp.idx)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridge__Push(JSBridgeTmp.found)
                JSBridge__Push(JSBridgeTmp.node)
                JSBridge__Push(JSBridgeTmp.cb_val)
                JSBridgeTmp.addr = JSBridge__ReflectKeyIndex(JSBridgeTmp.cb_val)
                JSBridgeTmp.cb_val = JSBridge__Pop()
                JSBridgeTmp.node = JSBridge__Pop()
                JSBridgeTmp.found = JSBridge__Pop()
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.idx = JSBridge__Pop()
                JSBridgeTmp.len = JSBridge__Pop()
                JSBridgeTmp.result = JSBridge__Pop()
                JSBridgeTmp.val2 = JSBridge__Pop()
                IfCondition LessThan(JSBridgeTmp.addr, JSBridgeTmp.found) ThenBlock: {
                    JSBridgeTmp.found = JSBridgeTmp.addr
                    JSBridgeTmp.count = JSBridgeTmp.node
                }
                JSBridgeTmp.node = Add(JSBridgeTmp.node, 1)
            }
            IfCondition NotEqual(JSBridgeTmp.count, JSBridgeTmp.idx) ThenBlock: {
                JSBridge__Push(JSBridgeTmp.val2)
                JSBridge__Push(JSBridgeTmp.result)
                JSBridge__Push(JSBridgeTmp.len)
                JSBridge__Push(JSBridgeTmp.idx)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridgeTmp.saved_this = JSRT_ArrGet(JSBridgeTmp.result, JSBridgeTmp.idx)
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.idx = JSBridge__Pop()
                JSBridgeTmp.len = JSBridge__Pop()
                JSBridgeTmp.result = JSBridge__Pop()
                JSBridgeTmp.val2 = JSBridge__Pop()
                JSBridge__Push(JSBridgeTmp.val2)
                JSBridge__Push(JSBridgeTmp.result)
                JSBridge__Push(JSBridgeTmp.len)
                JSBridge__Push(JSBridgeTmp.idx)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridge__Push(JSBridgeTmp.saved_this)
                JSBridgeTmp.cb_val = JSRT_ArrGet(JSBridgeTmp.result, JSBridgeTmp.count)
                JSBridgeTmp.saved_this = JSBridge__Pop()
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.idx = JSBridge__Pop()
                JSBridgeTmp.len = JSBridge__Pop()
                JSBridgeTmp.result = JSBridge__Pop()
                JSBridgeTmp.val2 = JSBridge__Pop()
                JSBridge__Push(JSBridgeTmp.val2)
                JSBridge__Push(JSBridgeTmp.result)
                JSBridge__Push(JSBridgeTmp.len)
                JSBridge__Push(JSBridgeTmp.idx)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridge__Push(JSBridgeTmp.saved_this)
                JSBridge__Push(JSBridgeTmp.cb_val)
                JSRT_ArrSet(JSBridgeTmp.result, JSBridgeTmp.idx, JSBridgeTmp.cb_val)
                JSBridgeTmp.cb_val = JSBridge__Pop()
                JSBridgeTmp.saved_this = JSBridge__Pop()
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.idx = JSBridge__Pop()
                JSBridgeTmp.len = JSBridge__Pop()
                JSBridgeTmp.result = JSBridge__Pop()
                JSBridgeTmp.val2 = JSBridge__Pop()
                JSBridge__Push(JSBridgeTmp.val2)
                JSBridge__Push(JSBridgeTmp.result)
                JSBridge__Push(JSBridgeTmp.len)
                JSBridge__Push(JSBridgeTmp.idx)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridge__Push(JSBridgeTmp.saved_this)
                JSRT_ArrSet(JSBridgeTmp.result, JSBridgeTmp.count, JSBridgeTmp.saved_this)
                JSBridgeTmp.saved_this = JSBridge__Pop()
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.idx = JSBridge__Pop()
                JSBridgeTmp.len = JSBridge__Pop()
                JSBridgeTmp.result = JSBridge__Pop()
                JSBridgeTmp.val2 = JSBridge__Pop()
            }
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
        }
        JSBridgeTmp.result = JSBridge__ReflectAppend(JSBridgeTmp.result, JSBridgeTmp.val2)
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__ReflectOwnKeys {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.ptr = args
        JSBridgeTmp.count = argc
        IfCondition LessThan(JSBridgeTmp.count, 1) ThenBlock: {
            ReturnValue(JSBridge__ReflectNeedObj(0))
        }
        JSBridgeTmp.obj = JSBridge__ReflectNeedObj(RDMEM_64(JSBridgeTmp.ptr))
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridgeTmp.found = JSBridge__ReflectInvokeTrap(JSBridgeTmp.obj, "ownKeys", 0, 1)
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition LessThan(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.ARRAY) ThenBlock: {
                ReturnValue(JSBridgeTmp.result)
            }
        }
        // Target stays under the name-list traffic so holes can be dropped.
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridgeTmp.obj = JSBridge__NGetOwnPropNames(JSBridgeTmp.ptr, 1)
        JSBridgeTmp.ptr = JSBridge__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSBridgeTmp.saved_this = JSBridge__Pop()
            ReturnValue(0)
        }
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridgeTmp.val2 = JSVM__NObjGetOwnPropertySymbols(JSBridgeTmp.ptr, 1)
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSBridgeTmp.saved_this = JSBridge__Pop()
            ReturnValue(0)
        }
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridgeTmp.obj = JSBridge__ReflectOrderKeys(JSBridgeTmp.obj)
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridgeTmp.result = JSRT_CreateArray()
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridgeTmp.result = JSBridge__ReflectAppend(JSBridgeTmp.result, JSBridgeTmp.obj)
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.result = JSBridge__ReflectAppend(JSBridgeTmp.result, JSBridgeTmp.val2)
        JSBridgeTmp.saved_this = JSBridge__Pop()
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.saved_this), JSType.ARRAY) ThenBlock: {
            JSBridgeTmp.result = JSBridge__ReflectStripHoles(JSBridgeTmp.saved_this, JSBridgeTmp.result)
        }
        ReturnValue(JSBridgeTmp.result)
    }
}

Function.JSBridge__ReflectThrowTE {
    Output: Address
    Body: {
        JSBridgeTmp.result = JSVM_CreateTypedError("TypeError", "is not a constructor")
        JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.result)
        JSVMCall.exc_prop = 1
        JSVMCall.thrown_val = JSBridgeTmp.result
        JSVM_ThrowValue(JSBridgeTmp.result)
        ReturnValue(0)
    }
}

// Re-throw the pending getter/CallFunc exception. A missing value becomes TypeError.
Function.JSBridge__ReflectPropagate {
    Output: Address
    Body: {
        JSBridgeTmp.result = JSVMCall.thrown_val
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            JSBridgeTmp.result = JSVMState.exc_val
        }
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            JSBridgeTmp.result = JSVM__GetGlobal("__pend_exc__")
        }
        JSVMCall.exc_prop = 0
        JSVMCall.thrown_val = 0
        JSVMState.exc_val = 0
        JSVMState.throw_delivered = 0
        IfCondition EqualTo(JSBridgeTmp.result, 0) ThenBlock: {
            ReturnValue(JSBridge__ReflectThrowTE())
        }
        IfCondition EqualTo(JSBridgeTmp.result, JSRTState.undef_val) ThenBlock: {
            ReturnValue(JSBridge__ReflectThrowTE())
        }
        JSVM__SetGlobal("__pend_exc__", JSRTState.undef_val)
        JSVM_ThrowValue(JSBridgeTmp.result)
        ReturnValue(0)
    }
}

// CreateListFromArrayLike element. Leaves exc_prop set when Get throws.
Function.JSBridge__ReflectArgAt {
    Input: list: Address
    Input: idx: Integer
    Output: Address
    Body: {
        JSBridgeTmp.val2 = list
        JSBridgeTmp.idx = idx
        JSBridgeTmp.name_ptr = JSRT__IntToStr(JSBridgeTmp.idx)
        JSBridgeTmp.len = StringLength(JSBridgeTmp.name_ptr)
        JSBridgeTmp.addr = JSRT__StrSlabAlloc(Add(JSBridgeTmp.len, 1))
        IfCondition NotEqual(JSBridgeTmp.addr, 0) ThenBlock: {
            MemoryCopy(JSBridgeTmp.addr, JSBridgeTmp.name_ptr, Add(JSBridgeTmp.len, 1))
            JSBridgeTmp.name_ptr = JSBridgeTmp.addr
        }
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridgeTmp.result = JSVM__GetProperty(JSBridgeTmp.val2, JSBridgeTmp.name_ptr)
        JSBridge__Push(JSBridgeTmp.result)
        JSBridgeTmp.result = JSBridge__Pop()
        JSBridgeTmp.val2 = JSBridge__Pop()
        ReturnValue(JSBridgeTmp.result)
    }
}

// One bound-function [[Construct]] unwrap. Prepends [[BoundArguments]] into the
// high arg buffer at ptr. If newTarget is this bound function, it becomes [[BoundTargetFunction]].
// Returns 1 to keep unwrapping, 0 if the bound target is not a function.
Function.JSBridge__ReflectBindShift {
    Input: rec: Address
    Output: Integer
    Body: {
        JSBridgeTmp.addr = rec
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.addr)
        JSBridgeTmp.node = JSRT_ObjGet(JSBridgeTmp.addr, "__bt__")
        JSBridgeTmp.addr = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridge__Pop()
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.node), JSType.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        // Same function can be two value headers. === compares the descriptor.
        IfCondition EqualTo(JSRT_StrictEqual(JSBridgeTmp.val, JSBridgeTmp.cb_val), 1) ThenBlock: {
            JSBridgeTmp.val = JSBridgeTmp.node
        }
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.node)
        JSBridge__Push(JSBridgeTmp.addr)
        JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.addr, "__bargs__")
        JSBridgeTmp.addr = JSBridge__Pop()
        JSBridgeTmp.node = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridge__Pop()
        JSBridgeTmp.addr = JSBridgeTmp.result
        JSBridgeTmp.len = 0
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.addr), JSType.ARRAY) ThenBlock: {
            JSBridgeTmp.len = JSRT_ArrLen(JSBridgeTmp.addr)
        }
        JSBridgeTmp.dom_idx = Add(JSBridgeTmp.count, JSBridgeTmp.len)
        IfCondition GreaterThan(JSBridgeTmp.dom_idx, 128) ThenBlock: {
            JSBridgeTmp.len = Subtract(128, JSBridgeTmp.count)
            IfCondition LessThan(JSBridgeTmp.len, 0) ThenBlock: {
                JSBridgeTmp.len = 0
            }
        }
        JSBridgeTmp.idx = Subtract(JSBridgeTmp.count, 1)
        WhileLoop GreaterEqual(JSBridgeTmp.idx, 0) {
            JSBridgeTmp.result = RDMEM_64(JSBridgeTmp.ptr, Multiply(JSBridgeTmp.idx, 8))
            WRMEM_64(JSBridgeTmp.ptr, Multiply(Add(JSBridgeTmp.idx, JSBridgeTmp.len), 8), JSBridgeTmp.result)
            JSBridgeTmp.idx = Subtract(JSBridgeTmp.idx, 1)
        }
        JSBridgeTmp.idx = 0
        WhileLoop LessThan(JSBridgeTmp.idx, JSBridgeTmp.len) {
            JSBridge__Push(JSBridgeTmp.cb_val)
            JSBridge__Push(JSBridgeTmp.val)
            JSBridge__Push(JSBridgeTmp.node)
            JSBridge__Push(JSBridgeTmp.count)
            JSBridge__Push(JSBridgeTmp.ptr)
            JSBridge__Push(JSBridgeTmp.addr)
            JSBridge__Push(JSBridgeTmp.len)
            JSBridge__Push(JSBridgeTmp.idx)
            JSBridgeTmp.result = JSRT_ArrGet(JSBridgeTmp.addr, JSBridgeTmp.idx)
            JSBridge__Push(JSBridgeTmp.result)
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.idx = JSBridge__Pop()
            JSBridgeTmp.len = JSBridge__Pop()
            JSBridgeTmp.addr = JSBridge__Pop()
            JSBridgeTmp.ptr = JSBridge__Pop()
            JSBridgeTmp.count = JSBridge__Pop()
            JSBridgeTmp.node = JSBridge__Pop()
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridgeTmp.cb_val = JSBridge__Pop()
            WRMEM_64(JSBridgeTmp.ptr, Multiply(JSBridgeTmp.idx, 8), JSBridgeTmp.result)
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
        }
        JSBridgeTmp.count = Add(JSBridgeTmp.count, JSBridgeTmp.len)
        JSBridgeTmp.cb_val = JSBridgeTmp.node
        ReturnValue(1)
    }
}

// Reflect.construct(target, argumentsList[, newTarget]).
// Args are staged at buf+1024 so a length/element getter can use the low buffer.
// new.target and the instance [[Prototype]] come from newTarget, not target.
Function.JSBridge__ReflectConstruct {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        JSVMCall.ctor_keep = 0
        JSBridgeTmp.node = args
        JSBridgeTmp.count = argc
        JSBridgeTmp.cb_val = JSRT_Undefined()
        IfCondition GreaterThan(JSBridgeTmp.count, 0) ThenBlock: {
            JSBridgeTmp.cb_val = RDMEM_64(JSBridgeTmp.node)
        }
        JSBridge__Push(JSBridgeTmp.node)
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridgeTmp.found = JSVM__IsConstructor(JSBridgeTmp.cb_val)
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridge__Pop()
        JSBridgeTmp.node = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(JSBridge__ReflectThrowTE())
        }
        JSBridgeTmp.val = JSBridgeTmp.cb_val
        IfCondition GreaterEqual(JSBridgeTmp.count, 3) ThenBlock: {
            JSBridgeTmp.val = RDMEM_64(JSBridgeTmp.node, 16)
            JSBridge__Push(JSBridgeTmp.node)
            JSBridge__Push(JSBridgeTmp.cb_val)
            JSBridge__Push(JSBridgeTmp.val)
            JSBridge__Push(JSBridgeTmp.count)
            JSBridgeTmp.found = JSVM__IsConstructor(JSBridgeTmp.val)
            JSBridgeTmp.count = JSBridge__Pop()
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridgeTmp.cb_val = JSBridge__Pop()
            JSBridgeTmp.node = JSBridge__Pop()
            IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
                ReturnValue(JSBridge__ReflectThrowTE())
            }
        }
        IfCondition LessThan(JSBridgeTmp.count, 2) ThenBlock: {
            ReturnValue(JSBridge__ReflectThrowTE())
        }
        JSBridgeTmp.val2 = RDMEM_64(JSBridgeTmp.node, 8)
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.val2)
        JSBridgeTmp.found = 0
        IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.ARRAY) ThenBlock: { JSBridgeTmp.found = 1 }
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridgeTmp.len = JSVM_IsPrimSymbol(JSBridgeTmp.val2)
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.len, 1) ThenBlock: { JSBridgeTmp.found = 0 }
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            JSBridgeTmp.result = JSVM_CreateTypedError("TypeError", "CreateListFromArrayLike called on non-object")
            JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.result)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = JSBridgeTmp.result
            JSVM_ThrowValue(JSBridgeTmp.result)
            ReturnValue(0)
        }
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridgeTmp.len = JSVM__ArrayLikeLen(JSBridgeTmp.val2)
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridge__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSBridge__ReflectPropagate())
        }
        IfCondition LessThan(JSBridgeTmp.len, 0) ThenBlock: {
            ReturnValue(JSBridge__ReflectPropagate())
        }
        IfCondition GreaterThan(JSBridgeTmp.len, 128) ThenBlock: {
            JSBridgeTmp.len = 128
        }
        JSBridgeTmp.count = JSBridgeTmp.len
        JSBridgeTmp.ptr = Add(JSVMCallBuf.buf, 1024)
        JSBridgeTmp.idx = 0
        WhileLoop LessThan(JSBridgeTmp.idx, JSBridgeTmp.count) {
            JSBridge__Push(JSBridgeTmp.cb_val)
            JSBridge__Push(JSBridgeTmp.val)
            JSBridge__Push(JSBridgeTmp.val2)
            JSBridge__Push(JSBridgeTmp.count)
            JSBridge__Push(JSBridgeTmp.ptr)
            JSBridge__Push(JSBridgeTmp.idx)
            JSBridgeTmp.result = JSBridge__ReflectArgAt(JSBridgeTmp.val2, JSBridgeTmp.idx)
            JSBridge__Push(JSBridgeTmp.result)
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.idx = JSBridge__Pop()
            JSBridgeTmp.ptr = JSBridge__Pop()
            JSBridgeTmp.count = JSBridge__Pop()
            JSBridgeTmp.val2 = JSBridge__Pop()
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridgeTmp.cb_val = JSBridge__Pop()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSBridge__ReflectPropagate())
            }
            // GetProperty delivers into the caller's catch at depth 0 and
            // clears exc_prop. Continuing would run a second throw uncaught.
            IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                ReturnValue(0)
            }
            WRMEM_64(JSBridgeTmp.ptr, Multiply(JSBridgeTmp.idx, 8), JSBridgeTmp.result)
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
        }
        JSBridgeTmp.found = 1
        JSBridgeTmp.dom_idx = 0
        WhileLoop EqualTo(JSBridgeTmp.found, 1) {
            JSBridgeTmp.found = 0
            IfCondition LessThan(JSBridgeTmp.dom_idx, 8) ThenBlock: {
                JSBridgeTmp.dom_idx = Add(JSBridgeTmp.dom_idx, 1)
                JSBridgeTmp.len = JSRT_FuncGetBC(JSBridgeTmp.cb_val)
                IfCondition LessThan(JSBridgeTmp.len, 0) ThenBlock: {
                    JSBridgeTmp.idx = Subtract(-1, JSBridgeTmp.len)
                    IfCondition EqualTo(JSBridgeTmp.idx, 198) ThenBlock: {
                        JSBridgeTmp.addr = JSRT_FuncGetEnv(JSBridgeTmp.cb_val)
                        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.addr), JSType.OBJECT) ThenBlock: {
                            JSBridgeTmp.found = JSBridge__ReflectBindShift(JSBridgeTmp.addr)
                            IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
                                ReturnValue(JSBridge__ReflectThrowTE())
                            }
                        }
                    }
                }
            }
        }
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridgeTmp.found = JSVM__IsConstructor(JSBridgeTmp.cb_val)
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(JSBridge__ReflectThrowTE())
        }
        // Promise [[Construct]] checks the executor before GetPrototypeFromConstructor.
        // Getting newTarget.prototype here throws the getter's error first.
        JSBridgeTmp.dom_idx = 0
        JSBridgeTmp.idx = JSRT_FuncGetBC(JSBridgeTmp.cb_val)
        IfCondition LessThan(JSBridgeTmp.idx, 0) ThenBlock: {
            JSBridgeTmp.len = Subtract(-1, JSBridgeTmp.idx)
            IfCondition EqualTo(JSBridgeTmp.len, JSNativeID.PROMISE_CTOR) ThenBlock: {
                JSBridgeTmp.dom_idx = 1
                JSBridgeTmp.obj = 0
            }
            // DataView validates byteOffset before GetPrototypeFromConstructor.
            IfCondition EqualTo(JSBridgeTmp.len, JSNativeID.DV_CTOR) ThenBlock: {
                JSBridgeTmp.dom_idx = 1
                JSBridgeTmp.obj = 0
            }
        }
        IfCondition EqualTo(JSBridgeTmp.dom_idx, 0) ThenBlock: {
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridgeTmp.obj = JSRT_CreateObject()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            ReturnValue(JSBridge__ReflectThrowTE())
        }
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.count)
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridgeTmp.result = JSVM__GetProperty(JSBridgeTmp.val, "prototype")
        JSBridge__Push(JSBridgeTmp.result)
        JSBridgeTmp.result = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridge__Pop()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSBridge__ReflectPropagate())
        }
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.result)
        JSBridgeTmp.found = 0
        IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.ARRAY) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.cb_val)
            JSBridge__Push(JSBridgeTmp.val)
            JSBridge__Push(JSBridgeTmp.count)
            JSBridge__Push(JSBridgeTmp.ptr)
            JSBridge__Push(JSBridgeTmp.obj)
            JSRT_ObjSet(JSBridgeTmp.obj, "__proto__", JSBridgeTmp.result)
            JSBridgeTmp.obj = JSBridge__Pop()
            JSBridgeTmp.ptr = JSBridge__Pop()
            JSBridgeTmp.count = JSBridge__Pop()
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridgeTmp.cb_val = JSBridge__Pop()
        } ElseBlock: {
            IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
                JSBridge__Push(JSBridgeTmp.cb_val)
                JSBridge__Push(JSBridgeTmp.val)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridge__Push(JSBridgeTmp.ptr)
                JSBridge__Push(JSBridgeTmp.obj)
                JSRT_ObjSet(JSBridgeTmp.obj, "__proto__", JSRTState.object_proto)
                JSBridgeTmp.obj = JSBridge__Pop()
                JSBridgeTmp.ptr = JSBridge__Pop()
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.val = JSBridge__Pop()
                JSBridgeTmp.cb_val = JSBridge__Pop()
            }
        }
        }
        JSBridgeTmp.saved_this = JSVM__GetGlobal("this")
        JSBridgeTmp.val2 = JSVM__GetGlobal("__new_target__")
        JSBridgeTmp.len = 0
        JSBridgeTmp.addr = JSRT_GetPayload(JSBridgeTmp.cb_val)
        IfCondition NotEqual(JSBridgeTmp.addr, 0) ThenBlock: {
            JSBridgeTmp.len = RDMEM_64(JSBridgeTmp.addr, 88)
        }
        JSBridgeTmp.idx = JSRT_FuncGetBC(JSBridgeTmp.cb_val)
        IfCondition And(GreaterEqual(JSBridgeTmp.idx, 0), NotEqual(JSBridgeTmp.len, 2)) ThenBlock: {
            // SetGlobal clobbers val and ptr. Park them across each call.
            JSBridge__Push(JSBridgeTmp.val)
            JSBridge__Push(JSBridgeTmp.ptr)
            JSVM__SetGlobal("this", JSBridgeTmp.obj)
            JSBridgeTmp.ptr = JSBridge__Pop()
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.val)
            JSBridge__Push(JSBridgeTmp.ptr)
            JSVM__SetGlobal("__new_target__", JSBridgeTmp.val)
            JSBridgeTmp.ptr = JSBridge__Pop()
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.cb_val)
            JSBridge__Push(JSBridgeTmp.val)
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.count)
            JSBridge__Push(JSBridgeTmp.ptr)
            JSBridge__Push(JSBridgeTmp.saved_this)
            JSBridge__Push(JSBridgeTmp.val2)
            JSVMCall.ctor_keep = 1
            JSBridgeTmp.found = JSVM__RunFieldInitForCtor(JSBridgeTmp.obj, JSBridgeTmp.cb_val)
            JSVMCall.ctor_keep = 0
            JSBridgeTmp.val2 = JSBridge__Pop()
            JSBridgeTmp.saved_this = JSBridge__Pop()
            JSBridgeTmp.ptr = JSBridge__Pop()
            JSBridgeTmp.count = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridgeTmp.cb_val = JSBridge__Pop()
            IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                JSVM__SetGlobal("this", JSBridgeTmp.saved_this)
                JSVM__SetGlobal("__new_target__", JSBridgeTmp.val2)
                ReturnValue(JSBridge__ReflectPropagate())
            }
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                JSVM__SetGlobal("this", JSBridgeTmp.saved_this)
                JSVM__SetGlobal("__new_target__", JSBridgeTmp.val2)
                ReturnValue(JSBridge__ReflectPropagate())
            }
        }
        IfCondition GreaterThan(JSBridgeTmp.count, 0) ThenBlock: {
            MemoryCopy(JSVMCallBuf.buf, JSBridgeTmp.ptr, Multiply(JSBridgeTmp.count, 8))
        }
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.ptr)
        // Promise builds its own instance after the executor check. A prebuilt
        // this would be the wrong object, and Error reuses an object this.
        IfCondition EqualTo(JSBridgeTmp.dom_idx, 1) ThenBlock: {
            JSVM__SetGlobal("this", JSRTState.undef_val)
        } ElseBlock: {
            JSVM__SetGlobal("this", JSBridgeTmp.obj)
        }
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.val)
        JSVM__SetGlobal("__new_target__", JSBridgeTmp.val)
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.idx = 0
        JSBridgeTmp.len = JSRT_FuncGetBC(JSBridgeTmp.cb_val)
        IfCondition LessThan(JSBridgeTmp.len, 0) ThenBlock: {
            JSBridgeTmp.idx = Subtract(-1, JSBridgeTmp.len)
        }
        JSVMCall.ctor_keep = 0
        IfCondition GreaterEqual(JSBridgeTmp.len, 0) ThenBlock: {
            JSVMCall.ctor_keep = 1
        }
        JSBridge__Push(JSBridgeTmp.saved_this)
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.idx)
        JSBridgeTmp.result = JSVM__CallFunc(JSBridgeTmp.cb_val, JSVMCallBuf.buf, JSBridgeTmp.count)
        JSBridge__Push(JSBridgeTmp.result)
        JSBridgeTmp.result = JSBridge__Pop()
        JSBridgeTmp.idx = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridgeTmp.saved_this = JSBridge__Pop()
        JSVMCall.ctor_keep = 0
        JSVM__SetGlobal("this", JSBridgeTmp.saved_this)
        JSVM__SetGlobal("__new_target__", JSBridgeTmp.val2)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSBridge__ReflectPropagate())
        }
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.result)
        JSBridgeTmp.found = 0
        IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.ARRAY) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.found = 1 }
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            ReturnValue(JSBridgeTmp.result)
        }
        IfCondition EqualTo(JSBridgeTmp.idx, 8) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.result)
            JSRT_ObjSet(JSBridgeTmp.obj, "__value__", JSBridgeTmp.result)
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridgeTmp.name_ptr = JSRT_CreateString("Number")
            JSBridgeTmp.obj = JSBridge__Pop()
            JSRT_ObjSet(JSBridgeTmp.obj, "__class__", JSBridgeTmp.name_ptr)
        }
        IfCondition EqualTo(JSBridgeTmp.idx, 9) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.result)
            JSRT_ObjSet(JSBridgeTmp.obj, "__value__", JSBridgeTmp.result)
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.result)
            JSBridgeTmp.name_ptr = JSRT_CreateString("String")
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            JSRT_ObjSet(JSBridgeTmp.obj, "__class__", JSBridgeTmp.name_ptr)
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.result)
            JSBridgeTmp.addr = JSRT_GetPayload(JSBridgeTmp.result)
            JSBridgeTmp.len = 0
            IfCondition NotEqual(JSBridgeTmp.addr, 0) ThenBlock: {
                JSBridgeTmp.len = JSRT_StrLen(JSBridgeTmp.addr)
            }
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridgeTmp.val = JSRT_CreateNumber(JSBridgeTmp.len)
            JSBridgeTmp.obj = JSBridge__Pop()
            JSRT_ObjSet(JSBridgeTmp.obj, "length", JSBridgeTmp.val)
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__SetAttrBits(JSBridgeTmp.obj, "length", 0)
            JSBridgeTmp.obj = JSBridge__Pop()
        }
        IfCondition EqualTo(JSBridgeTmp.idx, 10) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.result)
            JSRT_ObjSet(JSBridgeTmp.obj, "__value__", JSBridgeTmp.result)
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridgeTmp.name_ptr = JSRT_CreateString("Boolean")
            JSBridgeTmp.obj = JSBridge__Pop()
            JSRT_ObjSet(JSBridgeTmp.obj, "__class__", JSBridgeTmp.name_ptr)
        }
        ReturnValue(JSBridgeTmp.obj)
    }
}

Function.JSBridge__DReflect {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_APPLY) ThenBlock: {
            ReturnValue(JSBridge__ReflectApply(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_DEFINE_PROP) ThenBlock: {
            ReturnValue(JSBridge__ReflectDefine(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_DELETE_PROP) ThenBlock: {
            ReturnValue(JSBridge__ReflectDelete(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_GET_OWN_DESC) ThenBlock: {
            ReturnValue(JSBridge__ReflectGetDesc(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_GET_PROTO) ThenBlock: {
            ReturnValue(JSBridge__ReflectGetProto(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_IS_EXTENSIBLE) ThenBlock: {
            ReturnValue(JSBridge__ReflectIsExt(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_OWN_KEYS) ThenBlock: {
            ReturnValue(JSBridge__ReflectOwnKeys(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_PREVENT_EXT) ThenBlock: {
            ReturnValue(JSBridge__ReflectPrevent(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_SET_PROTO) ThenBlock: {
            ReturnValue(JSBridge__ReflectSetProto(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, JSNativeID.REFLECT_CONSTRUCT) ThenBlock: {
            ReturnValue(JSBridge__ReflectConstruct(save_args, save_argc))
        }
        ReturnValue(JSRT_Undefined())
    }
}

Function.JSBridge__ReflectInstall {
    Input: id: Integer
    Input: name: Address
    Input: nlen: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.idx = id
        JSBridgeTmp.name_ptr = name
        JSBridgeTmp.len = nlen
        JSBridgeTmp.obj = JSVM__GetGlobal("Reflect")
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.name_ptr)
        JSBridgeTmp.val = JSBridge__CreateNativeFunc(JSBridgeTmp.idx, JSBridgeTmp.name_ptr, JSBridgeTmp.len)
        JSBridgeTmp.name_ptr = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSRT_ObjSet(JSBridgeTmp.obj, JSBridgeTmp.name_ptr, JSBridgeTmp.val)
        JSBridge__SetAttrBits(JSBridgeTmp.obj, JSBridgeTmp.name_ptr, 5)
        ReturnValue(1)
    }
}

// Link Reflect to Object.prototype, stamp @@toStringTag, and mirror the
// global binding as writable, not enumerable, configurable.
Function.JSVM__StampReflect {
    Output: Integer
    Body: {
        JSBridgeTmp.obj = JSVM__GetGlobal("Reflect")
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.obj)
        IfCondition And(NotEqual(JSBridgeTmp.type, JSType.OBJECT), NotEqual(JSBridgeTmp.type, JSType.FUNCTION)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(JSBridgeTmp.obj, "__proto__", JSRTState.object_proto)
        }
        IfCondition NotEqual(JSVMSymbol.toStringTag, 0) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridgeTmp.name_ptr = JSVM_SymbolToKey(JSVMSymbol.toStringTag)
            JSBridgeTmp.obj = JSBridge__Pop()
            IfCondition NotEqual(JSBridgeTmp.name_ptr, 0) ThenBlock: {
                JSBridge__Push(JSBridgeTmp.obj)
                JSBridge__Push(JSBridgeTmp.name_ptr)
                JSBridgeTmp.val = JSRT_CreateString("Reflect")
                JSBridgeTmp.name_ptr = JSBridge__Pop()
                JSBridgeTmp.obj = JSBridge__Pop()
                JSRT_ObjSet(JSBridgeTmp.obj, JSBridgeTmp.name_ptr, JSBridgeTmp.val)
                JSBridge__SetAttrBits(JSBridgeTmp.obj, JSBridgeTmp.name_ptr, 4)
            }
        }
        JSBridgeTmp.val = JSVM__GetGlobal("globalThis")
        JSVM_MirrorBuiltin(JSBridgeTmp.val, "Reflect")
        JSBridge__ReflectInstall(JSNativeID.REFLECT_APPLY, "apply", 3)
        JSBridge__ReflectInstall(JSNativeID.REFLECT_DEFINE_PROP, "defineProperty", 3)
        JSBridge__ReflectInstall(JSNativeID.REFLECT_DELETE_PROP, "deleteProperty", 2)
        JSBridge__ReflectInstall(JSNativeID.REFLECT_GET_OWN_DESC, "getOwnPropertyDescriptor", 2)
        JSBridge__ReflectInstall(JSNativeID.REFLECT_GET_PROTO, "getPrototypeOf", 1)
        JSBridge__ReflectInstall(JSNativeID.REFLECT_IS_EXTENSIBLE, "isExtensible", 1)
        JSBridge__ReflectInstall(JSNativeID.REFLECT_OWN_KEYS, "ownKeys", 1)
        JSBridge__ReflectInstall(JSNativeID.REFLECT_PREVENT_EXT, "preventExtensions", 1)
        JSBridge__ReflectInstall(JSNativeID.REFLECT_SET_PROTO, "setPrototypeOf", 2)
        JSBridge__ReflectInstall(JSNativeID.REFLECT_CONSTRUCT, "construct", 2)
        ReturnValue(1)
    }
}
