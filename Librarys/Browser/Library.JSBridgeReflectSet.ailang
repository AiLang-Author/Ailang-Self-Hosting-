// Reflect.set OrdinarySet and the Proxy traps Reflect calls.
// Moved out of Part15 and JSBridgeReflect so those files stay under 1500 lines.
// No FixedPool. Pools stay on the JSBridge facade.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// Park OrdinarySet's target, key, original key value, V, receiver, and hop.
// CallTrap and OwnKind reuse JSBridgeTmp. Unhold restores these six only.
Function.JSBridge__ReflectHold {
    Output: Integer
    Body: {
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.name_ptr)
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.saved_this)
        JSBridge__Push(JSBridgeTmp.idx)
        ReturnValue(0)
    }
}

Function.JSBridge__ReflectUnhold {
    Output: Integer
    Body: {
        JSBridgeTmp.idx = JSBridge__Pop()
        JSBridgeTmp.saved_this = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridge__Pop()
        JSBridgeTmp.name_ptr = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        ReturnValue(0)
    }
}

// Call trap with this = handler. Args are already in JSVMCallBuf.buf.
// nargs is 1..4. A throw leaves exc_prop or throw_delivered set and returns 0.
// Six inputs is the register limit, so the args are not parameters.
Function.JSBridge__ReflectCallTrap {
    Input: handler: Address
    Input: trap: Address
    Input: nargs: Integer
    Output: Address
    Body: {
        JSBridgeTmp.obj = handler
        JSBridgeTmp.node = trap
        JSBridgeTmp.count = nargs
        JSBridgeTmp.saved_this = JSVM__GetGlobal("this")
        JSBridge__Push(JSBridgeTmp.saved_this)
        JSBridge__Push(JSBridgeTmp.node)
        JSBridge__Push(JSBridgeTmp.count)
        JSVM__SetGlobal("this", JSBridgeTmp.obj)
        JSBridgeTmp.count = JSBridge__Pop()
        JSBridgeTmp.node = JSBridge__Pop()
        JSBridgeTmp.result = JSVM__CallFunc(JSBridgeTmp.node, JSVMCallBuf.buf, JSBridgeTmp.count)
        JSBridgeTmp.saved_this = JSBridge__Pop()
        JSVM__SetGlobal("this", JSBridgeTmp.saved_this)
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(JSBridgeTmp.result)
    }
}

// 1 and the trap result in JSBridgeTmp.result. 0 if this is not a proxy
// or the trap is missing. -1 if the trap throws.
Function.JSBridge__ReflectInvokeTrap {
    Input: proxy: Address
    Input: name: Address
    Input: extra: Address
    Input: nargs: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.obj = proxy
        JSBridgeTmp.name_ptr = name
        JSBridgeTmp.val = extra
        JSBridgeTmp.count = nargs
        JSBridge__ReflectHold()
        JSBridgeTmp.found = JSVM__IsProxy(JSBridgeTmp.obj)
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.node = JSRT_ObjGet(JSBridgeTmp.obj, "__p_h__")
        JSBridge__ReflectUnhold()
        JSBridge__ReflectHold()
        JSBridgeTmp.addr = JSRT_ObjGet(JSBridgeTmp.obj, "__p_t__")
        JSBridge__ReflectUnhold()
        JSBridge__Push(JSBridgeTmp.node)
        JSBridge__Push(JSBridgeTmp.addr)
        JSBridge__ReflectHold()
        JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.node, JSBridgeTmp.name_ptr)
        JSBridge__ReflectUnhold()
        JSBridgeTmp.addr = JSBridge__Pop()
        JSBridgeTmp.node = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.result)
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.result)
        JSBridgeTmp.result = JSBridge__Pop()
        IfCondition NotEqual(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(JSVMCallBuf.buf, JSBridgeTmp.addr)
        StoreValue(Add(JSVMCallBuf.buf, 8), JSBridgeTmp.val)
        JSBridgeTmp.result = JSBridge__ReflectCallTrap(JSBridgeTmp.node, JSBridgeTmp.result, JSBridgeTmp.count)
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(1)
    }
}

// 0 no own property, 1 data, 2 accessor. Own __get_/__set_ wins over the
// placeholder data value defineProperty stores beside an accessor.
Function.JSBridge__ReflectOwnKind {
    Input: obj: Address
    Input: key: Address
    Output: Integer
    Body: {
        JSBridgeTmp.obj = obj
        JSBridgeTmp.name_ptr = key
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.name_ptr)
        JSBridgeTmp.addr = JSBridge__MakeAccKey(JSBridgeTmp.name_ptr, 0)
        JSBridgeTmp.name_ptr = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition NotEqual(JSBridgeTmp.addr, 0) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.name_ptr)
            JSBridge__Push(JSBridgeTmp.addr)
            JSBridgeTmp.found = JSRT_ObjHas(JSBridgeTmp.obj, JSBridgeTmp.addr)
            JSBridgeTmp.addr = JSBridge__Pop()
            JSBridgeTmp.name_ptr = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                ReturnValue(2)
            }
        }
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.name_ptr)
        JSBridgeTmp.addr = JSBridge__MakeAccKey(JSBridgeTmp.name_ptr, 1)
        JSBridgeTmp.name_ptr = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition NotEqual(JSBridgeTmp.addr, 0) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.name_ptr)
            JSBridge__Push(JSBridgeTmp.addr)
            JSBridgeTmp.found = JSRT_ObjHas(JSBridgeTmp.obj, JSBridgeTmp.addr)
            JSBridgeTmp.addr = JSBridge__Pop()
            JSBridgeTmp.name_ptr = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                ReturnValue(2)
            }
        }
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.name_ptr)
        JSBridgeTmp.found = JSRT_ObjHas(JSBridgeTmp.obj, JSBridgeTmp.name_ptr)
        JSBridgeTmp.name_ptr = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// OrdinarySet. 1 true, 0 false, -1 throw (exc_prop or throw_delivered set).
// len 1 means the descriptor was synthesized at the end of the chain, so it
// is writable. A real data property uses its [[Writable]] bit.
Function.JSBridge__ReflectOrdinarySet {
    Input: target: Address
    Input: key: Address
    Input: keyv: Address
    Input: val: Address
    Input: recv: Address
    Input: hops: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.obj = target
        JSBridgeTmp.name_ptr = key
        JSBridgeTmp.cb_val = keyv
        JSBridgeTmp.val = val
        JSBridgeTmp.saved_this = recv
        JSBridgeTmp.idx = hops
        IfCondition GreaterThan(JSBridgeTmp.idx, 16) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.found = JSVM__IsProxy(JSBridgeTmp.obj)
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            JSBridge__ReflectHold()
            JSBridgeTmp.node = JSRT_ObjGet(JSBridgeTmp.obj, "__p_h__")
            JSBridge__ReflectUnhold()
            JSBridge__ReflectHold()
            JSBridgeTmp.addr = JSRT_ObjGet(JSBridgeTmp.obj, "__p_t__")
            JSBridge__ReflectUnhold()
            JSBridge__Push(JSBridgeTmp.addr)
            JSBridge__Push(JSBridgeTmp.node)
            JSBridge__ReflectHold()
            JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.node, "set")
            JSBridge__ReflectUnhold()
            JSBridgeTmp.node = JSBridge__Pop()
            JSBridgeTmp.addr = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.result)
            JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.result)
            JSBridgeTmp.result = JSBridge__Pop()
            IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: {
                // result is the set trap. Keep it off the six held fields.
                JSBridge__Push(JSBridgeTmp.node)
                JSBridge__Push(JSBridgeTmp.addr)
                JSBridge__Push(JSBridgeTmp.result)
                JSBridgeTmp.len = 0
                JSBridge__ReflectHold()
                JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.cb_val)
                JSBridge__ReflectUnhold()
                IfCondition EqualTo(JSBridgeTmp.type, JSType.STRING) ThenBlock: {
                    JSBridgeTmp.len = 1
                }
                JSBridge__ReflectHold()
                JSBridgeTmp.found = JSVM_IsPrimSymbol(JSBridgeTmp.cb_val)
                JSBridge__ReflectUnhold()
                IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                    JSBridgeTmp.len = 1
                }
                IfCondition EqualTo(JSBridgeTmp.len, 0) ThenBlock: {
                    JSBridge__ReflectHold()
                    JSBridgeTmp.result = JSRT_CreateString(JSBridgeTmp.name_ptr)
                    JSBridge__ReflectUnhold()
                    JSBridgeTmp.cb_val = JSBridgeTmp.result
                }
                JSBridgeTmp.result = JSBridge__Pop()
                JSBridgeTmp.addr = JSBridge__Pop()
                JSBridgeTmp.node = JSBridge__Pop()
                StoreValue(JSVMCallBuf.buf, JSBridgeTmp.addr)
                StoreValue(Add(JSVMCallBuf.buf, 8), JSBridgeTmp.cb_val)
                StoreValue(Add(JSVMCallBuf.buf, 16), JSBridgeTmp.val)
                StoreValue(Add(JSVMCallBuf.buf, 24), JSBridgeTmp.saved_this)
                JSBridgeTmp.result = JSBridge__ReflectCallTrap(JSBridgeTmp.node, JSBridgeTmp.result, 4)
                IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                    ReturnValue(-1)
                }
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    ReturnValue(-1)
                }
                ReturnValue(JSRT_IsTruthy(JSBridgeTmp.result))
            }
            ReturnValue(JSBridge__ReflectOrdinarySet(JSBridgeTmp.addr, JSBridgeTmp.name_ptr, JSBridgeTmp.cb_val, JSBridgeTmp.val, JSBridgeTmp.saved_this, Add(JSBridgeTmp.idx, 1)))
        }
        JSBridgeTmp.len = 0
        JSBridge__ReflectHold()
        JSBridgeTmp.found = JSBridge__ReflectOwnKind(JSBridgeTmp.obj, JSBridgeTmp.name_ptr)
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            JSBridge__ReflectHold()
            JSBridgeTmp.addr = JSRT_ObjGet(JSBridgeTmp.obj, "__proto__")
            JSBridge__ReflectUnhold()
            JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.addr)
            JSBridgeTmp.count = 0
            IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.count = 1 }
            IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.count = 1 }
            IfCondition EqualTo(JSBridgeTmp.type, JSType.ARRAY) ThenBlock: { JSBridgeTmp.count = 1 }
            IfCondition EqualTo(JSBridgeTmp.count, 1) ThenBlock: {
                JSBridge__ReflectHold()
                JSBridgeTmp.count = JSVM_IsPrimSymbol(JSBridgeTmp.addr)
                JSBridge__ReflectUnhold()
                IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
                    IfCondition NotEqual(JSBridgeTmp.addr, JSBridgeTmp.obj) ThenBlock: {
                        ReturnValue(JSBridge__ReflectOrdinarySet(JSBridgeTmp.addr, JSBridgeTmp.name_ptr, JSBridgeTmp.cb_val, JSBridgeTmp.val, JSBridgeTmp.saved_this, Add(JSBridgeTmp.idx, 1)))
                    }
                }
            }
            JSBridgeTmp.found = 1
            JSBridgeTmp.len = 1
        }
        IfCondition EqualTo(JSBridgeTmp.found, 2) ThenBlock: {
            JSBridge__ReflectHold()
            JSBridgeTmp.addr = JSBridge__MakeAccKey(JSBridgeTmp.name_ptr, 1)
            JSBridge__ReflectUnhold()
            JSBridge__ReflectHold()
            JSBridgeTmp.count = JSRT_ObjHas(JSBridgeTmp.obj, JSBridgeTmp.addr)
            JSBridge__ReflectUnhold()
            IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
                ReturnValue(0)
            }
            JSBridge__ReflectHold()
            JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.obj, JSBridgeTmp.addr)
            JSBridge__ReflectUnhold()
            IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.result), JSType.FUNCTION) ThenBlock: {
                ReturnValue(0)
            }
            StoreValue(JSVMCallBuf.buf, JSBridgeTmp.val)
            JSBridgeTmp.result = JSBridge__ReflectCallTrap(JSBridgeTmp.saved_this, JSBridgeTmp.result, 1)
            IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
                ReturnValue(-1)
            }
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(-1)
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(JSBridgeTmp.len, 0) ThenBlock: {
            JSBridge__ReflectHold()
            JSBridgeTmp.len = JSBridge__GetAttrBits(JSBridgeTmp.obj, JSBridgeTmp.name_ptr)
            JSBridge__ReflectUnhold()
            IfCondition EqualTo(BitwiseAnd(JSBridgeTmp.len, 1), 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.saved_this)
        JSBridgeTmp.count = 0
        IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.count = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.count = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.ARRAY) ThenBlock: { JSBridgeTmp.count = 1 }
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.count = JSVM_IsPrimSymbol(JSBridgeTmp.saved_this)
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSBridgeTmp.count, 1) ThenBlock: {
            ReturnValue(0)
        }
        // Proxy receiver: [[GetOwnProperty]] then [[DefineOwnProperty]], not ObjSet.
        // 2 means the receiver is ordinary, so the data path below still runs.
        JSBridgeTmp.found = JSBridge__ReflectProxyRecvSet()
        IfCondition EqualTo(JSBridgeTmp.found, -1) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition NotEqual(JSBridgeTmp.found, 2) ThenBlock: {
            ReturnValue(JSBridgeTmp.found)
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.count = JSBridge__ReflectOwnKind(JSBridgeTmp.saved_this, JSBridgeTmp.name_ptr)
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSBridgeTmp.count, 2) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(JSBridgeTmp.count, 1) ThenBlock: {
            JSBridge__ReflectHold()
            JSBridgeTmp.len = JSBridge__GetAttrBits(JSBridgeTmp.saved_this, JSBridgeTmp.name_ptr)
            JSBridge__ReflectUnhold()
            IfCondition EqualTo(BitwiseAnd(JSBridgeTmp.len, 1), 0) ThenBlock: {
                ReturnValue(0)
            }
            JSBridge__ReflectHold()
            JSRT_ObjSet(JSBridgeTmp.saved_this, JSBridgeTmp.name_ptr, JSBridgeTmp.val)
            JSBridge__ReflectUnhold()
            ReturnValue(1)
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.saved_this, "__frozen__")
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSRT_IsTruthy(JSBridgeTmp.result), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.saved_this, "__sealed__")
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSRT_IsTruthy(JSBridgeTmp.result), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.saved_this, "__extensible__")
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.BOOLEAN) ThenBlock: {
            IfCondition EqualTo(JSRT_IsTruthy(JSBridgeTmp.result), 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        JSBridge__ReflectHold()
        JSRT_ObjSet(JSBridgeTmp.saved_this, JSBridgeTmp.name_ptr, JSBridgeTmp.val)
        JSBridge__ReflectUnhold()
        JSBridge__ReflectHold()
        JSBridge__SetAttrBits(JSBridgeTmp.saved_this, JSBridgeTmp.name_ptr, JSAttr.DEFAULT)
        JSBridge__ReflectUnhold()
        ReturnValue(1)
    }
}


// OrdinarySet's receiver is a proxy. Invoke getOwnPropertyDescriptor, then
// defineProperty. Return 2 when this is not that case so ObjSet still runs.
// 1 true, 0 false, -1 throw.
Function.JSBridge__ReflectProxyRecvSet {
    Output: Integer
    Body: {
        JSBridge__ReflectHold()
        JSBridgeTmp.found = JSVM__IsProxy(JSBridgeTmp.saved_this)
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(2)
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.node = JSRT_ObjGet(JSBridgeTmp.saved_this, "__p_h__")
        JSBridge__ReflectUnhold()
        JSBridge__ReflectHold()
        JSBridgeTmp.addr = JSRT_ObjGet(JSBridgeTmp.saved_this, "__p_t__")
        JSBridge__ReflectUnhold()
        JSBridge__Push(JSBridgeTmp.node)
        JSBridge__Push(JSBridgeTmp.addr)
        JSBridge__ReflectHold()
        JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.node, "getOwnPropertyDescriptor")
        JSBridge__ReflectUnhold()
        JSBridgeTmp.addr = JSBridge__Pop()
        JSBridgeTmp.node = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.result)
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.result)
        JSBridgeTmp.result = JSBridge__Pop()
        IfCondition NotEqual(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: {
            ReturnValue(2)
        }
        JSBridge__Push(JSBridgeTmp.node)
        JSBridge__Push(JSBridgeTmp.addr)
        JSBridge__Push(JSBridgeTmp.result)
        JSBridgeTmp.len = 0
        JSBridge__ReflectHold()
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.cb_val)
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSBridgeTmp.type, JSType.STRING) ThenBlock: {
            JSBridgeTmp.len = 1
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.found = JSVM_IsPrimSymbol(JSBridgeTmp.cb_val)
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            JSBridgeTmp.len = 1
        }
        IfCondition EqualTo(JSBridgeTmp.len, 0) ThenBlock: {
            JSBridge__ReflectHold()
            JSBridgeTmp.result = JSRT_CreateString(JSBridgeTmp.name_ptr)
            JSBridge__ReflectUnhold()
            JSBridgeTmp.cb_val = JSBridgeTmp.result
        }
        JSBridgeTmp.result = JSBridge__Pop()
        JSBridgeTmp.addr = JSBridge__Pop()
        JSBridgeTmp.node = JSBridge__Pop()
        StoreValue(JSVMCallBuf.buf, JSBridgeTmp.addr)
        StoreValue(Add(JSVMCallBuf.buf, 8), JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.saved_this)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridge__Push(JSBridgeTmp.cb_val)
        JSBridge__Push(JSBridgeTmp.addr)
        JSBridge__Push(JSBridgeTmp.node)
        JSBridgeTmp.result = JSBridge__ReflectCallTrap(JSBridgeTmp.node, JSBridgeTmp.result, 2)
        JSBridgeTmp.val2 = JSBridgeTmp.result
        JSBridgeTmp.node = JSBridge__Pop()
        JSBridgeTmp.addr = JSBridge__Pop()
        JSBridgeTmp.cb_val = JSBridge__Pop()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.saved_this = JSBridge__Pop()
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(-1)
        }
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.val2)
        JSBridgeTmp.len = 0
        IfCondition EqualTo(JSBridgeTmp.type, JSType.UNDEFINED) ThenBlock: { JSBridgeTmp.len = 1 }
        IfCondition EqualTo(JSBridgeTmp.type, JSType.NULL) ThenBlock: { JSBridgeTmp.len = 1 }
        IfCondition EqualTo(JSBridgeTmp.len, 0) ThenBlock: {
            JSBridgeTmp.count = 0
            IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.count = 1 }
            IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.count = 1 }
            IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
                JSBridgeTmp.result = JSVM_CreateTypedError("TypeError", "GetOwnProperty trap returned a non-object")
                JSVM__SetGlobal("__pend_exc__", JSBridgeTmp.result)
                JSVMCall.exc_prop = 1
                JSVMCall.thrown_val = JSBridgeTmp.result
                JSVM_ThrowValue(JSBridgeTmp.result)
                ReturnValue(-1)
            }
            JSBridge__ReflectHold()
            JSBridgeTmp.found = JSRT_ObjHas(JSBridgeTmp.val2, "get")
            JSBridge__ReflectUnhold()
            IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: { ReturnValue(0) }
            JSBridge__ReflectHold()
            JSBridgeTmp.found = JSRT_ObjHas(JSBridgeTmp.val2, "set")
            JSBridge__ReflectUnhold()
            IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: { ReturnValue(0) }
            JSBridge__ReflectHold()
            JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.val2, "writable")
            JSBridge__ReflectUnhold()
            IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.BOOLEAN) ThenBlock: {
                IfCondition EqualTo(JSRT_IsTruthy(JSBridgeTmp.result), 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.result = JSBridge__CreateUserObject()
        JSBridge__ReflectUnhold()
        JSBridge__Push(JSBridgeTmp.result)
        JSBridge__ReflectHold()
        JSRT_ObjSet(JSBridgeTmp.result, "value", JSBridgeTmp.val)
        JSBridge__ReflectUnhold()
        JSBridgeTmp.result = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.len, 1) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.result)
            JSBridgeTmp.ptr = JSRT_CreateBool(1)
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.result)
            JSRT_ObjSet(JSBridgeTmp.result, "writable", JSBridgeTmp.ptr)
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.result)
            JSRT_ObjSet(JSBridgeTmp.result, "enumerable", JSBridgeTmp.ptr)
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.result)
            JSRT_ObjSet(JSBridgeTmp.result, "configurable", JSBridgeTmp.ptr)
            JSBridgeTmp.result = JSBridge__Pop()
        }
        JSBridgeTmp.val2 = JSBridgeTmp.result
        JSBridge__Push(JSBridgeTmp.val2)
        JSBridge__ReflectHold()
        JSBridgeTmp.node = JSRT_ObjGet(JSBridgeTmp.saved_this, "__p_h__")
        JSBridge__ReflectUnhold()
        JSBridge__ReflectHold()
        JSBridgeTmp.addr = JSRT_ObjGet(JSBridgeTmp.saved_this, "__p_t__")
        JSBridge__ReflectUnhold()
        JSBridge__Push(JSBridgeTmp.node)
        JSBridge__Push(JSBridgeTmp.addr)
        JSBridge__ReflectHold()
        JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.node, "defineProperty")
        JSBridge__ReflectUnhold()
        JSBridgeTmp.addr = JSBridge__Pop()
        JSBridgeTmp.node = JSBridge__Pop()
        JSBridgeTmp.val2 = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.result)
        JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.result)
        JSBridgeTmp.result = JSBridge__Pop()
        IfCondition NotEqual(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: {
            ReturnValue(2)
        }
        StoreValue(JSVMCallBuf.buf, JSBridgeTmp.addr)
        StoreValue(Add(JSVMCallBuf.buf, 8), JSBridgeTmp.cb_val)
        StoreValue(Add(JSVMCallBuf.buf, 16), JSBridgeTmp.val2)
        JSBridgeTmp.result = JSBridge__ReflectCallTrap(JSBridgeTmp.node, JSBridgeTmp.result, 3)
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(JSRT_IsTruthy(JSBridgeTmp.result))
    }
}

// [[Set]] on an integer-indexed exotic object. Canonical numeric keys never
// consult the prototype. Returns 1 handled (bool in result, or -1 thrown),
// 0 if the key is not a typed-array index.
Function.JSBridge__ReflectTASet {
    Input: target: Address
    Input: key: Address
    Input: val: Address
    Output: Integer
    Body: {
        JSBridgeTmp.obj = target
        JSBridgeTmp.name_ptr = key
        JSBridgeTmp.val = val
        JSBridge__ReflectHold()
        JSBridgeTmp.found = JSVM_IsTypedArray(JSBridgeTmp.obj)
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.found = JSVM_TA_IsCanonicalNumericKey(JSBridgeTmp.name_ptr)
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(0)
        }
        // SameValue(target, receiver) takes IntegerIndexedElementSet.
        // A different receiver with a valid index is OrdinarySet, so valueOf
        // does not run and the value lands on the receiver. An invalid
        // canonical index (out of bounds, detached, "-0") returns true.
        IfCondition NotEqual(JSBridgeTmp.saved_this, JSBridgeTmp.obj) ThenBlock: {
            JSBridge__ReflectHold()
            JSBridgeTmp.len = JSVM_TA_ValidIndex(JSBridgeTmp.obj, JSBridgeTmp.name_ptr)
            JSBridge__ReflectUnhold()
            IfCondition LessThan(JSBridgeTmp.len, 0) ThenBlock: {
                JSBridgeTmp.result = JSRT_CreateBool(1)
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        // len, not idx: ReflectUnhold restores idx and would wipe the index.
        JSBridge__ReflectHold()
        JSBridgeTmp.len = JSVM_TA_ParseCanonicalIndex(JSBridgeTmp.name_ptr)
        JSBridge__ReflectUnhold()
        IfCondition LessThan(JSBridgeTmp.len, 0) ThenBlock: {
            JSBridgeTmp.len = -1
        }
        JSBridge__ReflectHold()
        JSBridgeTmp.found = JSVM_TA_Set(JSBridgeTmp.obj, JSBridgeTmp.len, JSBridgeTmp.val)
        JSBridge__ReflectUnhold()
        IfCondition EqualTo(JSVMState.throw_delivered, 1) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(-1)
        }
        JSBridgeTmp.result = JSRT_CreateBool(1)
        ReturnValue(1)
    }
}

// newTarget.prototype is not an object: use the builtin TypedArray prototype
// for this kind (GetPrototypeFromConstructor's intrinsic default).
Function.JSVM_TA_StampNewProto {
    Input: ta: Address
    Input: nt: Address
    Input: kind: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.obj = ta
        JSBridgeTmp.saved_this = nt
        JSBridgeTmp.idx = kind
        JSBridgeTmp.found = 0
        JSBridgeTmp.result = 0
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.saved_this), JSType.FUNCTION) ThenBlock: {
            JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.saved_this, "prototype")
            JSBridgeTmp.type = JSRT_GetType(JSBridgeTmp.result)
            IfCondition EqualTo(JSBridgeTmp.type, JSType.OBJECT) ThenBlock: { JSBridgeTmp.found = 1 }
            IfCondition EqualTo(JSBridgeTmp.type, JSType.ARRAY) ThenBlock: { JSBridgeTmp.found = 1 }
            IfCondition EqualTo(JSBridgeTmp.type, JSType.FUNCTION) ThenBlock: { JSBridgeTmp.found = 1 }
            IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                JSBridge__Push(JSBridgeTmp.result)
                JSBridgeTmp.count = JSVM_IsPrimSymbol(JSBridgeTmp.result)
                JSBridgeTmp.result = JSBridge__Pop()
                IfCondition EqualTo(JSBridgeTmp.count, 1) ThenBlock: { JSBridgeTmp.found = 0 }
            }
        }
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            JSBridgeTmp.addr = 0
            IfCondition EqualTo(JSBridgeTmp.idx, 0) ThenBlock: { JSBridgeTmp.addr = JSVM__GetGlobal("Int8Array") }
            IfCondition EqualTo(JSBridgeTmp.idx, 1) ThenBlock: { JSBridgeTmp.addr = JSVM__GetGlobal("Uint8Array") }
            IfCondition EqualTo(JSBridgeTmp.idx, 2) ThenBlock: { JSBridgeTmp.addr = JSVM__GetGlobal("Uint8ClampedArray") }
            IfCondition EqualTo(JSBridgeTmp.idx, 3) ThenBlock: { JSBridgeTmp.addr = JSVM__GetGlobal("Int16Array") }
            IfCondition EqualTo(JSBridgeTmp.idx, 4) ThenBlock: { JSBridgeTmp.addr = JSVM__GetGlobal("Uint16Array") }
            IfCondition EqualTo(JSBridgeTmp.idx, 5) ThenBlock: { JSBridgeTmp.addr = JSVM__GetGlobal("Int32Array") }
            IfCondition EqualTo(JSBridgeTmp.idx, 6) ThenBlock: { JSBridgeTmp.addr = JSVM__GetGlobal("Uint32Array") }
            IfCondition EqualTo(JSBridgeTmp.idx, 7) ThenBlock: { JSBridgeTmp.addr = JSVM__GetGlobal("Float32Array") }
            IfCondition EqualTo(JSBridgeTmp.idx, 8) ThenBlock: { JSBridgeTmp.addr = JSVM__GetGlobal("Float64Array") }
            IfCondition EqualTo(JSBridgeTmp.idx, 9) ThenBlock: { JSBridgeTmp.addr = JSVM__GetGlobal("BigInt64Array") }
            IfCondition EqualTo(JSBridgeTmp.idx, 10) ThenBlock: { JSBridgeTmp.addr = JSVM__GetGlobal("BigUint64Array") }
            IfCondition NotEqual(JSBridgeTmp.addr, 0) ThenBlock: {
                JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.addr, "prototype")
                IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.OBJECT) ThenBlock: {
                    JSBridgeTmp.found = 1
                }
            }
        }
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            JSRT_ObjSet(JSBridgeTmp.obj, "__proto__", JSBridgeTmp.result)
        }
        ReturnValue(JSBridgeTmp.found)
    }
}

// Array holes are not own keys. A raw 0 slot fails ArrHas.
Function.JSBridge__ReflectStripHoles {
    Input: arr: Address
    Input: names: Address
    Output: Address
    Body: {
        JSBridgeTmp.obj = arr
        JSBridgeTmp.val = names
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridge__Push(JSBridgeTmp.val)
        JSBridgeTmp.result = JSRT_CreateArray()
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.obj)
        JSBridgeTmp.count = JSRT_ArrLen(JSBridgeTmp.val)
        JSBridgeTmp.obj = JSBridge__Pop()
        JSBridgeTmp.idx = 0
        WhileLoop LessThan(JSBridgeTmp.idx, JSBridgeTmp.count) {
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.val)
            JSBridge__Push(JSBridgeTmp.result)
            JSBridge__Push(JSBridgeTmp.count)
            JSBridge__Push(JSBridgeTmp.idx)
            JSBridgeTmp.saved_this = JSRT_ArrGet(JSBridgeTmp.val, JSBridgeTmp.idx)
            JSBridgeTmp.idx = JSBridge__Pop()
            JSBridgeTmp.count = JSBridge__Pop()
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.obj)
            JSBridge__Push(JSBridgeTmp.val)
            JSBridge__Push(JSBridgeTmp.result)
            JSBridge__Push(JSBridgeTmp.count)
            JSBridge__Push(JSBridgeTmp.idx)
            JSBridge__Push(JSBridgeTmp.saved_this)
            JSBridgeTmp.found = JSBridge__ReflectKeyIndex(JSBridgeTmp.saved_this)
            JSBridgeTmp.saved_this = JSBridge__Pop()
            JSBridgeTmp.idx = JSBridge__Pop()
            JSBridgeTmp.count = JSBridge__Pop()
            JSBridgeTmp.result = JSBridge__Pop()
            JSBridgeTmp.val = JSBridge__Pop()
            JSBridgeTmp.obj = JSBridge__Pop()
            JSBridgeTmp.len = 1
            IfCondition GreaterEqual(JSBridgeTmp.found, 0) ThenBlock: {
                JSBridge__Push(JSBridgeTmp.obj)
                JSBridge__Push(JSBridgeTmp.val)
                JSBridge__Push(JSBridgeTmp.result)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridge__Push(JSBridgeTmp.idx)
                JSBridge__Push(JSBridgeTmp.saved_this)
                JSBridge__Push(JSBridgeTmp.found)
                JSBridgeTmp.len = JSRT_ArrHas(JSBridgeTmp.obj, JSBridgeTmp.found)
                JSBridgeTmp.found = JSBridge__Pop()
                JSBridgeTmp.saved_this = JSBridge__Pop()
                JSBridgeTmp.idx = JSBridge__Pop()
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.result = JSBridge__Pop()
                JSBridgeTmp.val = JSBridge__Pop()
                JSBridgeTmp.obj = JSBridge__Pop()
            }
            IfCondition EqualTo(JSBridgeTmp.len, 1) ThenBlock: {
                JSBridge__Push(JSBridgeTmp.obj)
                JSBridge__Push(JSBridgeTmp.val)
                JSBridge__Push(JSBridgeTmp.result)
                JSBridge__Push(JSBridgeTmp.count)
                JSBridge__Push(JSBridgeTmp.idx)
                JSBridge__Push(JSBridgeTmp.saved_this)
                JSRT_ArrPush(JSBridgeTmp.result, JSBridgeTmp.saved_this)
                JSBridgeTmp.saved_this = JSBridge__Pop()
                JSBridgeTmp.idx = JSBridge__Pop()
                JSBridgeTmp.count = JSBridge__Pop()
                JSBridgeTmp.result = JSBridge__Pop()
                JSBridgeTmp.val = JSBridge__Pop()
                JSBridgeTmp.obj = JSBridge__Pop()
            }
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
        }
        ReturnValue(JSBridgeTmp.result)
    }
}

