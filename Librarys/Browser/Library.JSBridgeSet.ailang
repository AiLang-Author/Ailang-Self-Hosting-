// Library.JSBridgeSet.ailang — ES set algebra. Pools stay on JSBridge.
//
// After SetMethodOpen: ptr=receiver, obj=other, val=has, val2=keys,
// idx=other size, type=this size. MapSaveState does not keep type,
// dom_idx, node, len, found, count, result, or name_ptr.
// dom_idx is the walk mode and is pushed across every user call.
// Producers insert with SetPut/SetDrop, never Set.prototype.add.
// Result objects are ordinary Sets. Symbol.species is not read.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

Function.JSBridge__SetBadSize {
    Output: Integer
    Body: {
        JSBridge__MapThrow("size is not a valid integer")
        ReturnValue(0)
    }
}

// 1 if key is in set. Skips tombstones. Does not touch the walker's fields.
Function.JSBridge__SetHasInternal {
    Input: set: Address
    Input: key: Address
    Output: Integer
    Body: {
        JSBridgeTmp.name_ptr = set
        JSBridgeTmp.result = key
        JSBridgeTmp.result = JSBridge__MapCanonKey(JSBridgeTmp.result)
        JSBridgeTmp.name_ptr = JSRT_ObjGet(JSBridgeTmp.name_ptr, "__vals__")
        JSBridgeTmp.found = JSBridge__SetFindIndex(JSBridgeTmp.name_ptr, JSBridgeTmp.result)
        IfCondition GreaterEqual(JSBridgeTmp.found, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Internal add. Canon -0 to +0. No public add.
Function.JSBridge__SetPut {
    Input: set: Address
    Input: key: Address
    Output: Integer
    Body: {
        JSBridgeTmp.name_ptr = set
        JSBridgeTmp.result = key
        JSBridgeTmp.result = JSBridge__MapCanonKey(JSBridgeTmp.result)
        JSBridgeTmp.len = JSRT_ObjGet(JSBridgeTmp.name_ptr, "__vals__")
        JSBridgeTmp.found = JSBridge__SetFindIndex(JSBridgeTmp.len, JSBridgeTmp.result)
        IfCondition LessThan(JSBridgeTmp.found, 0) ThenBlock: {
            JSRT_ArrPush(JSBridgeTmp.len, JSBridgeTmp.result)
        }
        ReturnValue(1)
    }
}

// Internal delete. Tombstone, so null stays a real value.
Function.JSBridge__SetDrop {
    Input: set: Address
    Input: key: Address
    Output: Integer
    Body: {
        JSBridgeTmp.name_ptr = set
        JSBridgeTmp.result = key
        JSBridgeTmp.result = JSBridge__MapCanonKey(JSBridgeTmp.result)
        JSBridgeTmp.len = JSRT_ObjGet(JSBridgeTmp.name_ptr, "__vals__")
        JSBridgeTmp.found = JSBridge__SetFindIndex(JSBridgeTmp.len, JSBridgeTmp.result)
        IfCondition GreaterEqual(JSBridgeTmp.found, 0) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.len)
            tomb = JSRT_CreateObject()
            JSBridgeTmp.result = tomb
            JSBridgeTmp.len = JSBridge__Pop()
            JSBridge__Push(JSBridgeTmp.len)
            JSRT_ObjSet(JSBridgeTmp.result, "__tomb__", JSRT_True())
            JSBridgeTmp.len = JSBridge__Pop()
            JSRT_ArrSet(JSBridgeTmp.len, JSBridgeTmp.found, JSBridgeTmp.result)
        }
        ReturnValue(1)
    }
}

// Live element count. Uses type as a tomb flag. Caller stores the return.
Function.JSBridge__SetLiveCount {
    Input: set: Address
    Output: Integer
    Body: {
        JSBridgeTmp.result = set
        JSBridgeTmp.result = JSRT_ObjGet(JSBridgeTmp.result, "__vals__")
        JSBridgeTmp.name_ptr = 0
        JSBridgeTmp.count = 0
        JSBridgeTmp.len = 0
        IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.result), JSType.ARRAY) ThenBlock: {
            JSBridgeTmp.len = JSRT_ArrLen(JSBridgeTmp.result)
        }
        WhileLoop LessThan(JSBridgeTmp.count, JSBridgeTmp.len) {
            JSBridgeTmp.found = JSRT_ArrGet(JSBridgeTmp.result, JSBridgeTmp.count)
            JSBridgeTmp.count = Add(JSBridgeTmp.count, 1)
            JSBridgeTmp.type = 0
            IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.found), JSType.OBJECT) ThenBlock: {
                IfCondition EqualTo(JSRT_ObjHas(JSBridgeTmp.found, "__tomb__"), 1) ThenBlock: {
                    JSBridgeTmp.type = 1
                }
            }
            IfCondition EqualTo(JSBridgeTmp.type, 0) ThenBlock: {
                JSBridgeTmp.name_ptr = Add(JSBridgeTmp.name_ptr, 1)
            }
        }
        ReturnValue(JSBridgeTmp.name_ptr)
    }
}

// GetSetRecord. idx becomes the integer size. val=has, val2=keys.
Function.JSBridge__SetRecord {
    Input: other: Address
    Output: Integer
    Body: {
        JSBridgeTmp.obj = other
        JSBridgeTmp.count = JSBridge__MapObjLike(JSBridgeTmp.obj)
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            JSBridge__MapThrow("Set method called on a non-object")
            ReturnValue(0)
        }
        JSBridge__MapSaveState()
        sz = JSVM__ObjGetAcc(JSBridgeTmp.obj, "size")
        JSBridgeTmp.result = sz
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.val = JSBridgeTmp.result
        JSBridge__MapSaveState()
        JSBridgeTmp.found = JSRT_ToNumber(JSBridgeTmp.val)
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.count = Float_Ne(JSBridgeTmp.found, JSBridgeTmp.found)
        IfCondition EqualTo(JSBridgeTmp.count, 1) ThenBlock: {
            ReturnValue(JSBridge__SetBadSize())
        }
        IfCondition EqualTo(JSBridgeTmp.found, 9218868437227405312) ThenBlock: {
            JSBridgeTmp.idx = 2147483647
        } ElseBlock: {
            IfCondition EqualTo(JSBridgeTmp.found, -4503599627370496) ThenBlock: {
                ReturnValue(JSBridge__SetBadSize())
            }
            JSBridgeTmp.count = Float_Abs(JSBridgeTmp.found)
            JSBridgeTmp.len = Float_FromInt(2147483647)
            JSBridgeTmp.name_ptr = Float_Ge(JSBridgeTmp.count, JSBridgeTmp.len)
            IfCondition EqualTo(JSBridgeTmp.name_ptr, 1) ThenBlock: {
                JSBridgeTmp.name_ptr = Float_Lt(JSBridgeTmp.found, 0)
                IfCondition EqualTo(JSBridgeTmp.name_ptr, 1) ThenBlock: {
                    ReturnValue(JSBridge__SetBadSize())
                }
                JSBridgeTmp.idx = 2147483647
            } ElseBlock: {
                JSBridgeTmp.count = Float_ToInt(JSBridgeTmp.found)
                IfCondition LessThan(JSBridgeTmp.count, 0) ThenBlock: {
                    ReturnValue(JSBridge__SetBadSize())
                }
                JSBridgeTmp.idx = JSBridgeTmp.count
            }
        }
        JSBridge__MapSaveState()
        hf = JSVM__ObjGetAcc(JSBridgeTmp.obj, "has")
        JSBridgeTmp.result = hf
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.count = JSRT_GetType(JSBridgeTmp.result)
        IfCondition NotEqual(JSBridgeTmp.count, JSType.FUNCTION) ThenBlock: {
            JSBridge__MapThrow("has is not callable")
            ReturnValue(0)
        }
        JSBridgeTmp.val = JSBridgeTmp.result
        JSBridge__MapSaveState()
        kf = JSVM__ObjGetAcc(JSBridgeTmp.obj, "keys")
        JSBridgeTmp.result = kf
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.count = JSRT_GetType(JSBridgeTmp.result)
        IfCondition NotEqual(JSBridgeTmp.count, JSType.FUNCTION) ThenBlock: {
            JSBridge__MapThrow("keys is not callable")
            ReturnValue(0)
        }
        JSBridgeTmp.val2 = JSBridgeTmp.result
        ReturnValue(1)
    }
}

// Brand, GetSetRecord, then this size into type. 1 or 0.
Function.JSBridge__SetMethodOpen {
    Input: args: Address
    Input: argc: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.node = args
        JSBridgeTmp.dom_idx = argc
        JSBridgeTmp.cb_val = 0
        JSBridgeTmp.addr = 0
        JSBridgeTmp.ptr = JSVM__GetGlobal("this")
        JSBridgeTmp.val = JSBridge__SetRequire(JSBridgeTmp.ptr)
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.obj = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.dom_idx, 0) ThenBlock: {
            JSBridgeTmp.obj = RDMEM_64(JSBridgeTmp.node)
        }
        JSBridgeTmp.count = JSBridge__SetRecord(JSBridgeTmp.obj)
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.type = JSBridge__SetLiveCount(JSBridgeTmp.ptr)
        ReturnValue(1)
    }
}

// Fresh ordinary Set. LoadState restores the receiver. Caller keeps the return.
Function.JSBridge__SetCreate {
    Output: Address
    Body: {
        JSBridge__MapSaveState()
        made = JSBridge__SetNewObj()
        JSBridgeTmp.result = made
        JSBridge__Push(JSBridgeTmp.result)
        JSBridgeTmp.name_ptr = JSVM__GetGlobal("Set")
        JSBridgeTmp.name_ptr = JSRT_ObjGet(JSBridgeTmp.name_ptr, "prototype")
        JSBridgeTmp.result = JSBridge__Pop()
        JSBridgeTmp.found = JSBridge__MapObjLike(JSBridgeTmp.name_ptr)
        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.result)
            JSRT_ObjSet(JSBridgeTmp.result, "__proto__", JSBridgeTmp.name_ptr)
            JSBridgeTmp.result = JSBridge__Pop()
        }
        JSBridge__MapLoadState()
        ReturnValue(JSBridgeTmp.result)
    }
}

// Copy live values from src into cb_val. Overwrites idx. Call after the size test.
Function.JSBridge__SetCopyLive {
    Input: src: Address
    Output: Integer
    Body: {
        JSBridgeTmp.node = src
        JSBridgeTmp.node = JSRT_ObjGet(JSBridgeTmp.node, "__vals__")
        JSBridgeTmp.idx = 0
        WhileLoop LessThan(JSBridgeTmp.idx, 1000000) {
            JSBridgeTmp.len = JSRT_ArrLen(JSBridgeTmp.node)
            IfCondition GreaterEqual(JSBridgeTmp.idx, JSBridgeTmp.len) ThenBlock: {
                JSBridgeTmp.idx = 1000000
            } ElseBlock: {
                JSBridgeTmp.count = JSRT_ArrGet(JSBridgeTmp.node, JSBridgeTmp.idx)
                JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
                JSBridgeTmp.found = 0
                IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.count), JSType.OBJECT) ThenBlock: {
                    IfCondition EqualTo(JSRT_ObjHas(JSBridgeTmp.count, "__tomb__"), 1) ThenBlock: {
                        JSBridgeTmp.found = 1
                    }
                }
                IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
                    JSBridge__SetPut(JSBridgeTmp.cb_val, JSBridgeTmp.count)
                }
            }
        }
        ReturnValue(1)
    }
}

// Walk this. Mode in dom_idx: 1 put if !has, 2 put if has, 3 false if !has, 4 false if has.
// Returns 1, 0, or -1. Does not close an iterator.
Function.JSBridge__SetWalkThis {
    Output: Integer
    Body: {
        JSBridgeTmp.idx = 0
        buf = Allocate(32)
        JSBridgeTmp.addr = buf
        IfCondition EqualTo(JSBridgeTmp.addr, 0) ThenBlock: {
            JSBridge__MapThrow("out of memory")
            ReturnValue(-1)
        }
        WhileLoop LessThan(JSBridgeTmp.idx, 1000000) {
            JSBridgeTmp.node = JSRT_ObjGet(JSBridgeTmp.ptr, "__vals__")
            JSBridgeTmp.len = JSRT_ArrLen(JSBridgeTmp.node)
            IfCondition GreaterEqual(JSBridgeTmp.idx, JSBridgeTmp.len) ThenBlock: {
                JSBridgeTmp.idx = 1000000
            } ElseBlock: {
                JSBridgeTmp.count = JSRT_ArrGet(JSBridgeTmp.node, JSBridgeTmp.idx)
                JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
                JSBridgeTmp.found = 0
                IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.count), JSType.OBJECT) ThenBlock: {
                    IfCondition EqualTo(JSRT_ObjHas(JSBridgeTmp.count, "__tomb__"), 1) ThenBlock: {
                        JSBridgeTmp.found = 1
                    }
                }
                IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
                    WRMEM_64(JSBridgeTmp.addr, JSBridgeTmp.count)
                    JSBridge__MapSaveState()
                    JSBridge__Push(JSBridgeTmp.dom_idx)
                    JSBridge__Push(JSBridgeTmp.val)
                    JSVM__SetGlobal("this", JSBridgeTmp.obj)
                    JSBridgeTmp.val = JSBridge__Pop()
                    cr = JSVM__CallFunc(JSBridgeTmp.val, JSBridgeTmp.addr, 1)
                    JSBridgeTmp.result = cr
                    JSBridgeTmp.dom_idx = JSBridge__Pop()
                    JSBridge__MapLoadState()
                    IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                        JSBridge__MapFreeBuf()
                        JSBridge__MapPropagate()
                        ReturnValue(-1)
                    }
                    JSBridgeTmp.found = JSRT_IsTruthy(JSBridgeTmp.result)
                    IfCondition EqualTo(JSBridgeTmp.dom_idx, 1) ThenBlock: {
                        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
                            JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                            JSBridge__SetPut(JSBridgeTmp.cb_val, JSBridgeTmp.count)
                        }
                    }
                    IfCondition EqualTo(JSBridgeTmp.dom_idx, 2) ThenBlock: {
                        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                            JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                            JSBridge__SetPut(JSBridgeTmp.cb_val, JSBridgeTmp.count)
                        }
                    }
                    IfCondition EqualTo(JSBridgeTmp.dom_idx, 3) ThenBlock: {
                        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
                            JSBridge__MapFreeBuf()
                            ReturnValue(0)
                        }
                    }
                    IfCondition EqualTo(JSBridgeTmp.dom_idx, 4) ThenBlock: {
                        IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                            JSBridge__MapFreeBuf()
                            ReturnValue(0)
                        }
                    }
                }
            }
        }
        JSBridge__MapFreeBuf()
        ReturnValue(1)
    }
}

// Walk other's keys. Mode: 1 add to cb_val, 2 drop from cb_val,
// 4 superset, 5 disjoint, 6 intersection, 7 symmetricDifference.
// return() runs only on an early false or a value-getter throw.
Function.JSBridge__SetWalkKeys {
    Output: Integer
    Body: {
        JSBridgeTmp.idx = 0
        JSBridge__MapSaveState()
        JSBridge__Push(JSBridgeTmp.dom_idx)
        JSBridge__Push(JSBridgeTmp.val2)
        JSVM__SetGlobal("this", JSBridgeTmp.obj)
        JSBridgeTmp.val2 = JSBridge__Pop()
        kr = JSVM__CallFunc(JSBridgeTmp.val2, JSVMCallBuf.buf, 0)
        JSBridgeTmp.result = kr
        JSBridgeTmp.dom_idx = JSBridge__Pop()
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSBridge__MapPropagate()
            ReturnValue(-1)
        }
        JSBridgeTmp.obj = JSBridgeTmp.result
        JSBridgeTmp.found = JSBridge__MapObjLike(JSBridgeTmp.obj)
        IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
            JSBridge__MapThrow("keys() returned a non-object")
            ReturnValue(-1)
        }
        JSBridge__MapSaveState()
        JSBridge__Push(JSBridgeTmp.dom_idx)
        nx = JSVM__ObjGetAcc(JSBridgeTmp.obj, "next")
        JSBridgeTmp.result = nx
        JSBridgeTmp.dom_idx = JSBridge__Pop()
        JSBridge__MapLoadState()
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSBridge__MapPropagate()
            ReturnValue(-1)
        }
        JSBridgeTmp.count = JSRT_GetType(JSBridgeTmp.result)
        IfCondition NotEqual(JSBridgeTmp.count, JSType.FUNCTION) ThenBlock: {
            JSBridge__MapThrow("iterator.next is not a function")
            ReturnValue(-1)
        }
        JSBridgeTmp.val = JSBridgeTmp.result
        buf = Allocate(32)
        JSBridgeTmp.addr = buf
        IfCondition EqualTo(JSBridgeTmp.addr, 0) ThenBlock: {
            JSBridge__MapThrow("out of memory")
            ReturnValue(-1)
        }
        WhileLoop LessThan(JSBridgeTmp.idx, 1000000) {
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
            JSBridge__MapSaveState()
            JSBridge__Push(JSBridgeTmp.dom_idx)
            JSBridge__Push(JSBridgeTmp.val)
            JSVM__SetGlobal("this", JSBridgeTmp.obj)
            JSBridgeTmp.val = JSBridge__Pop()
            st = JSVM__CallFunc(JSBridgeTmp.val, JSVMCallBuf.buf, 0)
            JSBridgeTmp.result = st
            JSBridgeTmp.dom_idx = JSBridge__Pop()
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                JSBridge__MapFreeBuf()
                JSBridge__MapPropagate()
                ReturnValue(-1)
            }
            JSBridgeTmp.found = JSBridge__MapObjLike(JSBridgeTmp.result)
            IfCondition EqualTo(JSBridgeTmp.found, 0) ThenBlock: {
                JSBridge__MapFreeBuf()
                JSBridge__MapThrow("iterator result is not an object")
                ReturnValue(-1)
            }
            JSBridgeTmp.val2 = JSBridgeTmp.result
            JSBridge__MapSaveState()
            JSBridge__Push(JSBridgeTmp.dom_idx)
            dv = JSVM__ObjGetAcc(JSBridgeTmp.val2, "done")
            JSBridgeTmp.result = dv
            JSBridgeTmp.dom_idx = JSBridge__Pop()
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                JSBridge__MapFreeBuf()
                JSBridge__MapPropagate()
                ReturnValue(-1)
            }
            JSBridgeTmp.found = JSRT_IsTruthy(JSBridgeTmp.result)
            IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                JSBridge__MapFreeBuf()
                ReturnValue(1)
            }
            JSBridge__MapSaveState()
            JSBridge__Push(JSBridgeTmp.dom_idx)
            item = JSVM__ObjGetAcc(JSBridgeTmp.val2, "value")
            JSBridgeTmp.result = item
            JSBridgeTmp.dom_idx = JSBridge__Pop()
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                errv = JSBridge__MapCapture()
                JSBridgeTmp.name_ptr = errv
                JSBridge__MapFreeBuf()
                JSBridge__MapClose(JSBridgeTmp.obj, JSBridgeTmp.name_ptr)
                ReturnValue(-1)
            }
            JSBridgeTmp.result = JSBridge__MapCanonKey(JSBridgeTmp.result)
            WRMEM_64(JSBridgeTmp.addr, JSBridgeTmp.result)
            IfCondition EqualTo(JSBridgeTmp.dom_idx, 1) ThenBlock: {
                JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                JSBridge__SetPut(JSBridgeTmp.cb_val, JSBridgeTmp.count)
            }
            IfCondition EqualTo(JSBridgeTmp.dom_idx, 2) ThenBlock: {
                JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                JSBridge__SetDrop(JSBridgeTmp.cb_val, JSBridgeTmp.count)
            }
            IfCondition EqualTo(JSBridgeTmp.dom_idx, 4) ThenBlock: {
                JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                JSBridgeTmp.len = JSBridge__SetHasInternal(JSBridgeTmp.ptr, JSBridgeTmp.count)
                IfCondition EqualTo(JSBridgeTmp.len, 0) ThenBlock: {
                    JSBridge__MapFreeBuf()
                    JSBridge__MapClose(JSBridgeTmp.obj, 0)
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(JSBridgeTmp.dom_idx, 5) ThenBlock: {
                JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                JSBridgeTmp.len = JSBridge__SetHasInternal(JSBridgeTmp.ptr, JSBridgeTmp.count)
                IfCondition EqualTo(JSBridgeTmp.len, 1) ThenBlock: {
                    JSBridge__MapFreeBuf()
                    JSBridge__MapClose(JSBridgeTmp.obj, 0)
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(JSBridgeTmp.dom_idx, 6) ThenBlock: {
                JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                JSBridgeTmp.len = JSBridge__SetHasInternal(JSBridgeTmp.ptr, JSBridgeTmp.count)
                IfCondition EqualTo(JSBridgeTmp.len, 1) ThenBlock: {
                    JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                    JSBridge__SetPut(JSBridgeTmp.cb_val, JSBridgeTmp.count)
                }
            }
            IfCondition EqualTo(JSBridgeTmp.dom_idx, 7) ThenBlock: {
                JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                JSBridgeTmp.len = JSBridge__SetHasInternal(JSBridgeTmp.cb_val, JSBridgeTmp.count)
                JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                JSBridgeTmp.found = JSBridge__SetHasInternal(JSBridgeTmp.ptr, JSBridgeTmp.count)
                IfCondition EqualTo(JSBridgeTmp.found, 1) ThenBlock: {
                    IfCondition EqualTo(JSBridgeTmp.len, 1) ThenBlock: {
                        JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                        JSBridge__SetDrop(JSBridgeTmp.cb_val, JSBridgeTmp.count)
                    }
                } ElseBlock: {
                    IfCondition EqualTo(JSBridgeTmp.len, 0) ThenBlock: {
                        JSBridgeTmp.count = RDMEM_64(JSBridgeTmp.addr)
                        JSBridge__SetPut(JSBridgeTmp.cb_val, JSBridgeTmp.count)
                    }
                }
            }
        }
        JSBridge__MapFreeBuf()
        JSBridge__MapThrow("Set iterable exceeded iteration limit")
        ReturnValue(-1)
    }
}

Function.JSBridge__SetFinishSet {
    Input: rc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.count = rc
        IfCondition LessThan(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(JSBridgeTmp.cb_val)
    }
}

Function.JSBridge__SetFinishBool {
    Input: rc: Integer
    Output: Address
    Body: {
        JSBridgeTmp.count = rc
        IfCondition LessThan(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        ReturnValue(JSRT_CreateBool(1))
    }
}

Function.JSBridge__DSET_UNION {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.count = JSBridge__SetMethodOpen(save_args, save_argc)
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        made = JSBridge__SetCreate()
        JSBridgeTmp.cb_val = made
        JSBridge__SetCopyLive(JSBridgeTmp.ptr)
        JSBridgeTmp.dom_idx = 1
        JSBridgeTmp.count = JSBridge__SetWalkKeys()
        ReturnValue(JSBridge__SetFinishSet(JSBridgeTmp.count))
    }
}

Function.JSBridge__DSET_DIFFERENCE {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.count = JSBridge__SetMethodOpen(save_args, save_argc)
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        made = JSBridge__SetCreate()
        JSBridgeTmp.cb_val = made
        IfCondition LessEqual(JSBridgeTmp.type, JSBridgeTmp.idx) ThenBlock: {
            JSBridgeTmp.dom_idx = 1
            JSBridgeTmp.count = JSBridge__SetWalkThis()
        } ElseBlock: {
            JSBridge__SetCopyLive(JSBridgeTmp.ptr)
            JSBridgeTmp.dom_idx = 2
            JSBridgeTmp.count = JSBridge__SetWalkKeys()
        }
        ReturnValue(JSBridge__SetFinishSet(JSBridgeTmp.count))
    }
}

Function.JSBridge__DSET_INTERSECTION {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.count = JSBridge__SetMethodOpen(save_args, save_argc)
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        made = JSBridge__SetCreate()
        JSBridgeTmp.cb_val = made
        IfCondition LessEqual(JSBridgeTmp.type, JSBridgeTmp.idx) ThenBlock: {
            JSBridgeTmp.dom_idx = 2
            JSBridgeTmp.count = JSBridge__SetWalkThis()
        } ElseBlock: {
            JSBridgeTmp.dom_idx = 6
            JSBridgeTmp.count = JSBridge__SetWalkKeys()
        }
        ReturnValue(JSBridge__SetFinishSet(JSBridgeTmp.count))
    }
}

Function.JSBridge__DSET_SYMMETRIC {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.count = JSBridge__SetMethodOpen(save_args, save_argc)
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        made = JSBridge__SetCreate()
        JSBridgeTmp.cb_val = made
        JSBridge__SetCopyLive(JSBridgeTmp.ptr)
        JSBridgeTmp.dom_idx = 7
        JSBridgeTmp.count = JSBridge__SetWalkKeys()
        ReturnValue(JSBridge__SetFinishSet(JSBridgeTmp.count))
    }
}

Function.JSBridge__DSET_IS_SUBSET {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.count = JSBridge__SetMethodOpen(save_args, save_argc)
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition GreaterThan(JSBridgeTmp.type, JSBridgeTmp.idx) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSBridgeTmp.dom_idx = 3
        JSBridgeTmp.count = JSBridge__SetWalkThis()
        ReturnValue(JSBridge__SetFinishBool(JSBridgeTmp.count))
    }
}

Function.JSBridge__DSET_IS_SUPERSET {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.count = JSBridge__SetMethodOpen(save_args, save_argc)
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition LessThan(JSBridgeTmp.type, JSBridgeTmp.idx) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSBridgeTmp.dom_idx = 4
        JSBridgeTmp.count = JSBridge__SetWalkKeys()
        ReturnValue(JSBridge__SetFinishBool(JSBridgeTmp.count))
    }
}

Function.JSBridge__DSET_IS_DISJOINT {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        JSBridgeTmp.count = JSBridge__SetMethodOpen(save_args, save_argc)
        IfCondition EqualTo(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition LessEqual(JSBridgeTmp.type, JSBridgeTmp.idx) ThenBlock: {
            JSBridgeTmp.dom_idx = 4
            JSBridgeTmp.count = JSBridge__SetWalkThis()
        } ElseBlock: {
            JSBridgeTmp.dom_idx = 5
            JSBridgeTmp.count = JSBridge__SetWalkKeys()
        }
        ReturnValue(JSBridge__SetFinishBool(JSBridgeTmp.count))
    }
}
