// Library.JSBridgeWeakMap.ailang — WeakMap ctor, brand, set/get/has/delete, upsert.
// Pools stay on Library.JSBridge.ailang. No FixedPool in this file.
//
// Instance: __wpairs__ array of [key, value], __class__ "WeakMap". No own size.
// Delete tombstones a pair slot with null. Null is not a holdable key.
// Registered symbols (own string __gsrkey__) are not holdable. Other symbols are.
// get/has/delete swallow an unholdable key. set and both upserts throw.
// Iterable ingest reuses MapIngest, which calls the public set method.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// 1 if key can be held weakly. Does not throw. Clobbers found, count, node.
Function.JSBridge__WMCanHold {
    Input: key: Address
    Output: Integer
    Body: {
        JSBridgeTmp.found = key
        JSBridge__Push(JSBridgeTmp.found)
        JSBridgeTmp.count = JSVM_IsPrimSymbol(JSBridgeTmp.found)
        JSBridgeTmp.found = JSBridge__Pop()
        IfCondition EqualTo(JSBridgeTmp.count, 1) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.found)
            JSBridgeTmp.node = JSRT_ObjGet(JSBridgeTmp.found, "__gsrkey__")
            JSBridgeTmp.found = JSBridge__Pop()
            IfCondition EqualTo(JSRT_GetType(JSBridgeTmp.node), JSType.STRING) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        JSBridge__Push(JSBridgeTmp.found)
        JSBridgeTmp.count = JSBridge__MapObjLike(JSBridgeTmp.found)
        JSBridgeTmp.found = JSBridge__Pop()
        ReturnValue(JSBridgeTmp.count)
    }
}

// __wpairs__ array, or TypeError. Does not write name_ptr or idx.
Function.JSBridge__WMRequire {
    Input: wthis: Address
    Output: Address
    Body: {
        JSBridgeTmp.ptr = wthis
        t = JSRT_GetType(JSBridgeTmp.ptr)
        ok = 0
        IfCondition EqualTo(t, JSType.OBJECT) ThenBlock: { ok = 1 }
        IfCondition EqualTo(t, JSType.FUNCTION) ThenBlock: { ok = 1 }
        IfCondition EqualTo(t, JSType.ARRAY) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakMap method called on incompatible receiver"))
        }
        cls = JSRT_ObjGet(JSBridgeTmp.ptr, "__class__")
        JSBridgeTmp.val = cls
        ct = JSRT_GetType(JSBridgeTmp.val)
        IfCondition NotEqual(ct, JSType.STRING) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakMap method called on incompatible receiver"))
        }
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.val)
        expect = JSRT_CreateString("WeakMap")
        JSBridgeTmp.result = expect
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.found = JSRT_GetPayload(JSBridgeTmp.val)
        JSBridgeTmp.count = JSRT_GetPayload(JSBridgeTmp.result)
        IfCondition NotEqual(JSRT_StrEq(JSBridgeTmp.found, JSBridgeTmp.count), 1) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakMap method called on incompatible receiver"))
        }
        pairs = JSRT_ObjGet(JSBridgeTmp.ptr, "__wpairs__")
        JSBridgeTmp.val = pairs
        vt = JSRT_GetType(JSBridgeTmp.val)
        IfCondition NotEqual(vt, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakMap method called on incompatible receiver"))
        }
        ReturnValue(JSBridgeTmp.val)
    }
}

// Fresh WeakMap. __proto__ is filled by the constructor.
Function.JSBridge__WMNewObj {
    Output: Address
    Body: {
        mobj = JSRT_CreateObject()
        JSBridge__Push(mobj)
        pairs = JSRT_CreateArray()
        JSBridgeTmp.val = pairs
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        JSRT_ObjSet(JSBridgeTmp.ptr, "__wpairs__", JSBridgeTmp.val)
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        cls = JSRT_CreateString("WeakMap")
        JSBridgeTmp.val = cls
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        JSRT_ObjSet(JSBridgeTmp.ptr, "__class__", JSBridgeTmp.val)
        JSBridgeTmp.ptr = JSBridge__Pop()
        ReturnValue(JSBridgeTmp.ptr)
    }
}

// Overwrite or append [key, value] on __wpairs__. Does not canon the key.
// First three stores run before any call. Returns the value.
Function.JSBridge__WMPut {
    Input: map: Address
    Input: key: Address
    Input: value: Address
    Output: Address
    Body: {
        JSBridgeTmp.ptr = map
        JSBridgeTmp.obj = key
        JSBridgeTmp.val = value
        JSBridgeTmp.val2 = JSRT_ObjGet(JSBridgeTmp.ptr, "__wpairs__")
        JSBridgeTmp.count = JSBridge__MapFindIndex(JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition GreaterEqual(JSBridgeTmp.count, 0) ThenBlock: {
            JSBridgeTmp.addr = JSRT_ArrGet(JSBridgeTmp.val2, JSBridgeTmp.count)
            JSRT_ArrSet(JSBridgeTmp.addr, 1, JSBridgeTmp.val)
            ReturnValue(JSBridgeTmp.val)
        }
        JSBridgeTmp.result = JSRT_CreateArray()
        JSRT_ArrPush(JSBridgeTmp.result, JSBridgeTmp.obj)
        JSRT_ArrPush(JSBridgeTmp.result, JSBridgeTmp.val)
        JSRT_ArrPush(JSBridgeTmp.val2, JSBridgeTmp.result)
        ReturnValue(JSBridgeTmp.val)
    }
}

// Brand-check and read arg0 into obj, arg1 into val. 0 after a throw.
// name_ptr is the args pointer. idx is argc. ptr is the map. val2 is __wpairs__.
Function.JSBridge__WMBind {
    Input: args: Address
    Input: argc: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.name_ptr = args
        JSBridgeTmp.idx = argc
        JSBridgeTmp.ptr = JSVM__GetGlobal("this")
        JSBridgeTmp.val2 = JSBridge__WMRequire(JSBridgeTmp.ptr)
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.obj = JSRTState.undef_val
        JSBridgeTmp.val = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            JSBridgeTmp.obj = Dereference(JSBridgeTmp.name_ptr)
        }
        IfCondition GreaterThan(JSBridgeTmp.idx, 1) ThenBlock: {
            JSBridgeTmp.val = Dereference(Add(JSBridgeTmp.name_ptr, 8))
        }
        ReturnValue(1)
    }
}

Function.JSBridge__DWEAKMAP_CTOR {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        nt = JSVM__GetGlobal("__new_target__")
        ntt = JSRT_GetType(nt)
        IfCondition Or(EqualTo(nt, 0), EqualTo(ntt, JSType.UNDEFINED)) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakMap constructor requires new"))
        }
        mobj = JSBridge__WMNewObj()
        JSBridgeTmp.ptr = mobj
        JSBridgeTmp.obj = 0
        JSBridgeTmp.val = 0
        JSBridgeTmp.val2 = 0
        JSBridgeTmp.addr = 0
        JSBridgeTmp.cb_val = 0
        nt2 = JSVM__GetGlobal("__new_target__")
        JSBridgeTmp.obj = nt2
        ntt2 = JSRT_GetType(JSBridgeTmp.obj)
        IfCondition EqualTo(ntt2, JSType.FUNCTION) ThenBlock: {
            JSBridge__MapSaveState()
            proto = JSVM__ObjGetAcc(JSBridgeTmp.obj, "prototype")
            JSBridgeTmp.result = proto
            JSBridge__MapLoadState()
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.result), 1) ThenBlock: {
                JSBridgeTmp.obj = JSBridgeTmp.result
            } ElseBlock: {
                JSBridgeTmp.obj = 0
            }
        } ElseBlock: {
            JSBridgeTmp.obj = 0
        }
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            mc = JSVM__GetGlobal("WeakMap")
            JSBridgeTmp.val = mc
            proto2 = JSRT_ObjGet(JSBridgeTmp.val, "prototype")
            JSBridgeTmp.obj = proto2
        }
        IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.obj), 1) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.ptr)
            JSRT_ObjSet(JSBridgeTmp.ptr, "__proto__", JSBridgeTmp.obj)
            JSBridgeTmp.ptr = JSBridge__Pop()
        }
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSBridgeTmp.ptr)
        }
        JSBridgeTmp.cb_val = Dereference(save_args)
        itb_t = JSRT_GetType(JSBridgeTmp.cb_val)
        IfCondition Or(EqualTo(itb_t, JSType.UNDEFINED), EqualTo(itb_t, JSType.NULL)) ThenBlock: {
            ReturnValue(JSBridgeTmp.ptr)
        }
        ok = JSBridge__MapIngest(JSBridgeTmp.ptr, JSBridgeTmp.cb_val)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(JSBridgeTmp.ptr)
    }
}

Function.JSBridge__DWEAKMAP_SET {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        IfCondition EqualTo(JSBridge__WMBind(args, argc), 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__WMCanHold(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakMap key must be an object or a symbol"))
        }
        JSBridge__WMPut(JSBridgeTmp.ptr, JSBridgeTmp.obj, JSBridgeTmp.val)
        ReturnValue(JSBridgeTmp.ptr)
    }
}

Function.JSBridge__DWEAKMAP_GET {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        IfCondition EqualTo(JSBridge__WMBind(args, argc), 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__WMCanHold(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSBridgeTmp.count = JSBridge__MapFindIndex(JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition LessThan(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        JSBridgeTmp.addr = JSRT_ArrGet(JSBridgeTmp.val2, JSBridgeTmp.count)
        ReturnValue(JSRT_ArrGet(JSBridgeTmp.addr, 1))
    }
}

Function.JSBridge__DWEAKMAP_HAS {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        IfCondition EqualTo(JSBridge__WMBind(args, argc), 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__WMCanHold(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSBridgeTmp.count = JSBridge__MapFindIndex(JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition GreaterEqual(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        ReturnValue(JSRT_CreateBool(0))
    }
}

Function.JSBridge__DWEAKMAP_DELETE {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        IfCondition EqualTo(JSBridge__WMBind(args, argc), 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__WMCanHold(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSBridgeTmp.count = JSBridge__MapFindIndex(JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition LessThan(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSRT_ArrSet(JSBridgeTmp.val2, JSBridgeTmp.count, JSRTState.null_val)
        ReturnValue(JSRT_CreateBool(1))
    }
}

Function.JSBridge__DWEAKMAP_GET_OR_INSERT {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        IfCondition EqualTo(JSBridge__WMBind(args, argc), 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__WMCanHold(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakMap key must be an object or a symbol"))
        }
        JSBridgeTmp.count = JSBridge__MapFindIndex(JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition GreaterEqual(JSBridgeTmp.count, 0) ThenBlock: {
            JSBridgeTmp.addr = JSRT_ArrGet(JSBridgeTmp.val2, JSBridgeTmp.count)
            ReturnValue(JSRT_ArrGet(JSBridgeTmp.addr, 1))
        }
        ReturnValue(JSBridge__WMPut(JSBridgeTmp.ptr, JSBridgeTmp.obj, JSBridgeTmp.val))
    }
}

Function.JSBridge__DWEAKMAP_GET_OR_INSERT_COMPUTED {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        IfCondition EqualTo(JSBridge__WMBind(args, argc), 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__WMCanHold(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakMap key must be an object or a symbol"))
        }
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.val), JSType.FUNCTION) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakMap getOrInsertComputed callback is not a function"))
        }
        JSBridgeTmp.count = JSBridge__MapFindIndex(JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition GreaterEqual(JSBridgeTmp.count, 0) ThenBlock: {
            JSBridgeTmp.addr = JSRT_ArrGet(JSBridgeTmp.val2, JSBridgeTmp.count)
            ReturnValue(JSRT_ArrGet(JSBridgeTmp.addr, 1))
        }
        JSBridgeTmp.addr = Allocate(32)
        IfCondition EqualTo(JSBridgeTmp.addr, 0) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("out of memory"))
        }
        StoreValue(JSBridgeTmp.addr, JSBridgeTmp.obj)
        JSBridge__MapSaveState()
        JSBridge__Push(JSBridgeTmp.val)
        JSVM__SetGlobal("this", JSRTState.undef_val)
        JSBridgeTmp.val = JSBridge__Pop()
        cr = JSVM__CallFunc(JSBridgeTmp.val, JSBridgeTmp.addr, 1)
        JSBridgeTmp.result = cr
        JSBridge__MapLoadState()
        JSBridge__MapFreeBuf()
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(JSBridge__WMPut(JSBridgeTmp.ptr, JSBridgeTmp.obj, JSBridgeTmp.result))
    }
}
