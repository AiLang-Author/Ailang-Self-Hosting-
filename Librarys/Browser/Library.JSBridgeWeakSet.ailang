// Library.JSBridgeWeakSet.ailang — WeakSet ctor, brand, add/has/delete.
// Pools stay on Library.JSBridge.ailang. No FixedPool in this file.
//
// Instance: __wvals__ array of values, __class__ "WeakSet". No own size.
// Delete tombstones a slot with null. Null is not a holdable value.
// Hold check is JSBridge__WMCanHold. Iterable ingest reuses SetIngest,
// which calls the public add method.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// __wvals__ array, or TypeError. Does not write name_ptr or idx.
Function.JSBridge__WSRequire {
    Input: wthis: Address
    Output: Address
    Body: {
        JSBridgeTmp.ptr = wthis
        t = JSRT_GetType(JSBridgeTmp.ptr)
        ok = 0
        IfCondition EqualTo(t, JSType.OBJECT) ThenBlock: { ok = 1 }
        IfCondition EqualTo(t, JSType.FUNCTION) ThenBlock: { ok = 1 }
        IfCondition EqualTo(t, JSType.ARRAY) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakSet method called on incompatible receiver"))
        }
        cls = JSRT_ObjGet(JSBridgeTmp.ptr, "__class__")
        JSBridgeTmp.val = cls
        ct = JSRT_GetType(JSBridgeTmp.val)
        IfCondition NotEqual(ct, JSType.STRING) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakSet method called on incompatible receiver"))
        }
        JSBridge__Push(JSBridgeTmp.ptr)
        JSBridge__Push(JSBridgeTmp.val)
        expect = JSRT_CreateString("WeakSet")
        JSBridgeTmp.result = expect
        JSBridgeTmp.val = JSBridge__Pop()
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridgeTmp.found = JSRT_GetPayload(JSBridgeTmp.val)
        JSBridgeTmp.count = JSRT_GetPayload(JSBridgeTmp.result)
        IfCondition NotEqual(JSRT_StrEq(JSBridgeTmp.found, JSBridgeTmp.count), 1) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakSet method called on incompatible receiver"))
        }
        vals = JSRT_ObjGet(JSBridgeTmp.ptr, "__wvals__")
        JSBridgeTmp.val = vals
        vt = JSRT_GetType(JSBridgeTmp.val)
        IfCondition NotEqual(vt, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakSet method called on incompatible receiver"))
        }
        ReturnValue(JSBridgeTmp.val)
    }
}

// Fresh WeakSet. __proto__ is filled by the constructor.
Function.JSBridge__WSNewObj {
    Output: Address
    Body: {
        mobj = JSRT_CreateObject()
        JSBridge__Push(mobj)
        vals = JSRT_CreateArray()
        JSBridgeTmp.val = vals
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        JSRT_ObjSet(JSBridgeTmp.ptr, "__wvals__", JSBridgeTmp.val)
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        cls = JSRT_CreateString("WeakSet")
        JSBridgeTmp.val = cls
        JSBridgeTmp.ptr = JSBridge__Pop()
        JSBridge__Push(JSBridgeTmp.ptr)
        JSRT_ObjSet(JSBridgeTmp.ptr, "__class__", JSBridgeTmp.val)
        JSBridgeTmp.ptr = JSBridge__Pop()
        ReturnValue(JSBridgeTmp.ptr)
    }
}

// Index of key in __wvals__, or -1. Null slots are empty. Does not skip
// objects that happen to own __tomb__.
Function.JSBridge__WSFind {
    Input: vals: Address
    Input: key: Address
    Output: Integer
    Body: {
        JSBridgeTmp.addr = vals
        JSBridgeTmp.found = key
        IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.addr), JSType.ARRAY) ThenBlock: {
            ReturnValue(-1)
        }
        JSBridgeTmp.idx = 0
        JSBridgeTmp.len = JSRT_ArrLen(JSBridgeTmp.addr)
        WhileLoop LessThan(JSBridgeTmp.idx, JSBridgeTmp.len) {
            JSBridgeTmp.node = JSRT_ArrGet(JSBridgeTmp.addr, JSBridgeTmp.idx)
            IfCondition NotEqual(JSRT_GetType(JSBridgeTmp.node), JSType.NULL) ThenBlock: {
                IfCondition EqualTo(JSBridge__SameValueZero(JSBridgeTmp.node, JSBridgeTmp.found), 1) ThenBlock: {
                    ReturnValue(JSBridgeTmp.idx)
                }
            }
            JSBridgeTmp.idx = Add(JSBridgeTmp.idx, 1)
        }
        ReturnValue(-1)
    }
}

// Brand-check and read arg0 into obj. 0 after a throw.
// name_ptr is the args pointer. idx is argc. ptr is the set. val2 is __wvals__.
Function.JSBridge__WSBind {
    Input: args: Address
    Input: argc: Integer
    Output: Integer
    Body: {
        JSBridgeTmp.name_ptr = args
        JSBridgeTmp.idx = argc
        JSBridgeTmp.ptr = JSVM__GetGlobal("this")
        JSBridgeTmp.val2 = JSBridge__WSRequire(JSBridgeTmp.ptr)
        IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
            ReturnValue(0)
        }
        JSBridgeTmp.obj = JSRTState.undef_val
        IfCondition GreaterThan(JSBridgeTmp.idx, 0) ThenBlock: {
            JSBridgeTmp.obj = RDMEM_64(JSBridgeTmp.name_ptr)
        }
        ReturnValue(1)
    }
}

Function.JSBridge__DWEAKSET_CTOR {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        JSBridgeTmp.name_ptr = args
        JSBridgeTmp.idx = argc
        nt = JSVM__GetGlobal("__new_target__")
        ntt = JSRT_GetType(nt)
        IfCondition Or(EqualTo(nt, 0), EqualTo(ntt, JSType.UNDEFINED)) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakSet constructor requires new"))
        }
        mobj = JSBridge__WSNewObj()
        JSBridgeTmp.ptr = mobj
        JSBridgeTmp.obj = 0
        JSBridgeTmp.val = 0
        JSBridgeTmp.val2 = 0
        JSBridgeTmp.addr = 0
        JSBridgeTmp.cb_val = 0
        nt2 = JSVM__GetGlobal("__new_target__")
        JSBridgeTmp.obj = nt2
        ntt2 = JSRT_GetType(JSBridgeTmp.obj)
        IfCondition EqualTo(ntt2, JSType.FUNCTION) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.name_ptr)
            JSBridge__MapSaveState()
            proto = JSVM__ObjGetAcc(JSBridgeTmp.obj, "prototype")
            JSBridgeTmp.result = proto
            JSBridge__MapLoadState()
            JSBridgeTmp.name_ptr = JSBridge__Pop()
            IfCondition EqualTo(JSBridge__MapPropagate(), 1) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.result), 1) ThenBlock: {
                JSBridgeTmp.obj = JSBridgeTmp.result
            } ElseBlock: {
                JSBridgeTmp.obj = 0
            }
        } ElseBlock: {
            JSBridgeTmp.obj = 0
        }
        IfCondition EqualTo(JSBridgeTmp.obj, 0) ThenBlock: {
            sc = JSVM__GetGlobal("WeakSet")
            JSBridgeTmp.val = sc
            proto2 = JSRT_ObjGet(JSBridgeTmp.val, "prototype")
            JSBridgeTmp.obj = proto2
        }
        IfCondition EqualTo(JSBridge__MapObjLike(JSBridgeTmp.obj), 1) ThenBlock: {
            JSBridge__Push(JSBridgeTmp.ptr)
            JSRT_ObjSet(JSBridgeTmp.ptr, "__proto__", JSBridgeTmp.obj)
            JSBridgeTmp.ptr = JSBridge__Pop()
        }
        IfCondition LessThan(JSBridgeTmp.idx, 1) ThenBlock: {
            ReturnValue(JSBridgeTmp.ptr)
        }
        JSBridgeTmp.cb_val = RDMEM_64(JSBridgeTmp.name_ptr)
        itb_t = JSRT_GetType(JSBridgeTmp.cb_val)
        IfCondition Or(EqualTo(itb_t, JSType.UNDEFINED), EqualTo(itb_t, JSType.NULL)) ThenBlock: {
            ReturnValue(JSBridgeTmp.ptr)
        }
        ok = JSBridge__SetIngest(JSBridgeTmp.ptr, JSBridgeTmp.cb_val)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(JSBridgeTmp.ptr)
    }
}

Function.JSBridge__DWEAKSET_ADD {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        IfCondition EqualTo(JSBridge__WSBind(args, argc), 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__WMCanHold(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSBridge__MapThrow("WeakSet value must be an object or a symbol"))
        }
        JSBridgeTmp.count = JSBridge__WSFind(JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition LessThan(JSBridgeTmp.count, 0) ThenBlock: {
            JSRT_ArrPush(JSBridgeTmp.val2, JSBridgeTmp.obj)
        }
        ReturnValue(JSBridgeTmp.ptr)
    }
}

Function.JSBridge__DWEAKSET_HAS {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        IfCondition EqualTo(JSBridge__WSBind(args, argc), 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__WMCanHold(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSBridgeTmp.count = JSBridge__WSFind(JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition GreaterEqual(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        ReturnValue(JSRT_CreateBool(0))
    }
}

Function.JSBridge__DWEAKSET_DELETE {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        IfCondition EqualTo(JSBridge__WSBind(args, argc), 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition EqualTo(JSBridge__WMCanHold(JSBridgeTmp.obj), 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSBridgeTmp.count = JSBridge__WSFind(JSBridgeTmp.val2, JSBridgeTmp.obj)
        IfCondition LessThan(JSBridgeTmp.count, 0) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        JSRT_ArrSet(JSBridgeTmp.val2, JSBridgeTmp.count, JSRTState.null_val)
        ReturnValue(JSRT_CreateBool(1))
    }
}
