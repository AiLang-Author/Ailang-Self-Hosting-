// Library.JSCompiler.ailang — JavaScript AST-to-bytecode compiler
// Walks the AST from JSParser, emits a flat bytecode stream + constant pool.
// Stack-based VM target (no register allocation). 1-byte opcode + 0-2 byte
// big-endian operands. Handles scoped variable resolution, jump patching,
// loop break/continue, and function compilation.
//
// CLOBBER SAFETY: Every function saves Input params to locals on the FIRST
// line of Body. Complex expressions broken into steps. JSCompTmp fields
// guarded with push/pop across recursive calls.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Browser.JSParser
LibraryImport.Browser.JSLexer
LibraryImport.Arena
LibraryImport.StringUtils

LibraryImport.Browser.JSCompiler.JSCompExpr
LibraryImport.Browser.JSCompiler.JSCompStmt

// =============================================================================
// OPCODES (~50)
// =============================================================================
FixedPool.JSOp {
    // Stack
    "PUSH_CONST":    Initialize=1
    "PUSH_UNDEF":    Initialize=2
    "PUSH_NULL":     Initialize=3
    "PUSH_TRUE":     Initialize=4
    "PUSH_FALSE":    Initialize=5
    // M29c: array elision hole
    "PUSH_HOLE":     Initialize=9
    "POP":           Initialize=6
    "DUP":           Initialize=7
    "SWAP":          Initialize=8

    // Variables
    "GET_LOCAL":     Initialize=10
    "SET_LOCAL":     Initialize=11
    "GET_GLOBAL":    Initialize=12
    "SET_GLOBAL":    Initialize=13

    // Properties
    "GET_PROP":      Initialize=16
    "SET_PROP":      Initialize=17
    "GET_ELEM":      Initialize=18
    "SET_ELEM":      Initialize=19

    // Arithmetic
    "ADD":           Initialize=20
    "SUB":           Initialize=21
    "MUL":           Initialize=22
    "DIV":           Initialize=23
    "MOD":           Initialize=24
    "NEG":           Initialize=25
    "EXP":           Initialize=26

    // Comparison
    "EQ":            Initialize=30
    "NEQ":           Initialize=31
    "LT":            Initialize=32
    "GT":            Initialize=33
    "LTE":           Initialize=34
    "GTE":           Initialize=35
    "STRICT_EQ":     Initialize=36
    "STRICT_NEQ":    Initialize=37

    // Logic/Bits
    "NOT":           Initialize=40
    "BIT_AND":       Initialize=41
    "BIT_OR":        Initialize=42
    "BIT_XOR":       Initialize=43
    "BIT_NOT":       Initialize=44
    "SHL":           Initialize=45
    "SHR":           Initialize=46
    "USHR":          Initialize=48
    "INSTANCEOF":    Initialize=49
    "TYPEOF":        Initialize=47
    "IN":            Initialize=38
    // delete obj.prop — stack: [obj, key_str] → push boolean
    "DELETE_PROP":   Initialize=39

    // Control
    "JMP":           Initialize=50
    "JMP_FALSE":     Initialize=51
    "JMP_TRUE":      Initialize=52

    "JMP_NULLISH":   Initialize=53
    "JMP_IF_NULLISH": Initialize=54

    // Functions
    "CALL":          Initialize=55
    "RETURN":        Initialize=56
    "CLOSURE":       Initialize=57

    // Objects
    "NEW_OBJECT":    Initialize=60
    "NEW_ARRAY":     Initialize=61
    "CONCAT":        Initialize=62
    "SET_PROP_COMPUTED": Initialize=63
    "DEF_GETTER":    Initialize=64
    "DEF_SETTER":    Initialize=65
    "OBJ_KEYS":      Initialize=66
    "ARR_APPEND":    Initialize=67
    "ARR_EXTEND":    Initialize=68
    "CALL_SPREAD":   Initialize=69

    // Exception handling
    "TRY_PUSH":      Initialize=70
    "TRY_POP":       Initialize=71
    "THROW":         Initialize=72

    // Generators
    "YIELD":         Initialize=73
    "YIELD_STAR":    Initialize=98   // M26k.11: yield* delegation
    "GEN_CLOSURE":   Initialize=74

    // Iterators (for-of)
    "TO_ARRAY":      Initialize=75

    // Computed getters/setters (class/object)
    "DEF_GETTER_COMPUTED": Initialize=76
    "DEF_SETTER_COMPUTED": Initialize=77

    // TDZ
    "THROW_TDZ":     Initialize=78
    // M20c: TypeError on assignment to const binding
    "THROW_CONST":   Initialize=88

    // Async/await
    "ASYNC_CLOSURE": Initialize=79
    "AWAIT":         Initialize=80

    // Async generators
    "ASYNC_GEN_CLOSURE": Initialize=82

    // Constructor (new)
    "CONSTRUCT":     Initialize=81

    // Method call (obj.method() with this binding)
    "CALL_METHOD":   Initialize=83

    // typeof-safe global get (unresolvable → undefined, no ReferenceError)
    "GET_GLOBAL_SOFT": Initialize=84
    // Assignment to global (strict: undeclared → ReferenceError). Decls use SET_GLOBAL.
    "SET_GLOBAL_ASSIGN": Initialize=85
    // M19d: ToPropertyKey once — [val] → [string key] (compound base[prop] op=)
    "TO_PROP_KEY":   Initialize=86
    // RequireObjectCoercible — [val] → [val] or TypeError if null/undefined
    "CHECK_COERCIBLE": Initialize=87

    // Mole 7: per-activation closure env (high numbers — avoid clashing)
    // GET_FREE name — free-var read via callee.__cenv chain
    "GET_FREE":      Initialize=90
    // SET_FRAME_ENV name — dual-write own local into current frame env object
    "SET_FRAME_ENV": Initialize=91
    // SET_FREE name — free-var write on __cenv chain
    "SET_FREE":      Initialize=92
    // OBJ_SPREAD — CopyDataProperties for object spread `{...src}` (Mole 11)
    "OBJ_SPREAD":    Initialize=93
    // Mole 15: array destructuring via iterator protocol
    "GET_ITER":      Initialize=94   // [iterable] → [iter_record]
    "ITER_NEXT":     Initialize=95   // [iter_record] → [value]; sets JSVMIter.done
    "ITER_CLOSE":    Initialize=96   // [iter_record] → []; call return if !done
    // M128e6h: for-await-of — GetIterator(obj, async) prefers @@asyncIterator
    "GET_ASYNC_ITER": Initialize=111
    // M26k.5: allow next private SET to PrivateFieldAdd (field define only)
    "PRIVATE_INIT_PULSE": Initialize=97

    // Special
    "HALT":          Initialize=0
    "NOP":           Initialize=99
    // M50: SuperBase = [[GetPrototypeOf]]([[HomeObject]]) of current function
    "SUPER_BASE":    Initialize=100
    // M59: per-iteration let env for for-of/for-in — [value] → fresh env with name=value
    "FRESH_LET_ENV": Initialize=101
    // M60: push TDZ sentinel for free-var TDZ env mark
    "PUSH_TDZ_UNINIT": Initialize=102
    // M62: pop for-of head TDZ env → parent
    "RESTORE_ENV":     Initialize=103
    // M69: super.prop = val — lookup on SuperBase, set with this as Receiver
    "SET_PROP_SUPER":  Initialize=104
    // M128e6d: super.prop get — lookup on SuperBase, getter this = Receiver
    "GET_PROP_SUPER":  Initialize=110
    "CHECK_CTOR":     Initialize=105  // M100: heritage IsConstructor
    // M105: delete IdentReference — false if global binding exists
    "DELETE_GLOBAL": Initialize=106
    // M128: dynamic import(spec) — [spec] → Promise (module NS or reject)
    "IMPORT_DYN":    Initialize=107
    // M128b: direct eval(code) — same as CALL to eval but marks direct-eval
    "DIRECT_EVAL":   Initialize=108
    // M128v: CreateGlobalVarBinding — set undefined only if name missing
    // (eval/program hoist must not re-init existing globals)
    "SET_GLOBAL_VAR": Initialize=109
    "WITH_PUSH":      Initialize=121
    "WITH_POP":       Initialize=122
    // M128e: runtime resolve IDENT under with (ObjectEnv before locals)
    "GET_WITH":       Initialize=123
    "SET_WITH":       Initialize=124
    // M128e6v: capture free-var env for PutValue before RHS (A6 T1/T2)
    "RESOLVE_FREE":   Initialize=125
}

// =============================================================================
// COMPILER CONSTANTS
// =============================================================================
FixedPool.JSCompConst {
    "MAX_CODE":      Initialize=524288
    "MAX_CONSTS":    Initialize=65536
    "MAX_LOCALS":    Initialize=512
    "MAX_SCOPES":    Initialize=256
    "SCOPE_SIZE":    Initialize=24576
    "CONST_SIZE":    Initialize=16
    "MAX_PATCHES":   Initialize=1024
    "MAX_LOOPS":     Initialize=256
    "LOOP_SIZE":     Initialize=32
    // M53: labeled statement stack — name_ptr, name_len, break_chain, loop_depth, can_bind
    "MAX_LABELS":    Initialize=64
    "LABEL_SIZE":    Initialize=40
    // M55: open for-of iterators — irec_slot + loop_depth (for IteratorClose on abrupt)
    "MAX_ITERS":     Initialize=32
    "ITER_SIZE":     Initialize=16
    "STR_CAP":       Initialize=524288
    // +0 bc, +8 params, +16 locals, +24 name_ptr, +32 name_len,
    // +40 body_start, +48 es_length (Function.length)
    "FUNC_SIZE":     Initialize=56
    "MAX_FUNCS":     Initialize=4096
    // Finally stack: [fin_body_ast, in_try_flag] per frame
    "MAX_FINALLY":   Initialize=32
    "FINALLY_SIZE":  Initialize=16
    "MAX_ENCL":      Initialize=64
    "ENCL_ENTRY":    Initialize=24
}

// =============================================================================
// COMPILER STATE
// =============================================================================
FixedPool.JSCompState {
    "code":          Initialize=0
    "code_pos":      Initialize=0
    "const_pool":    Initialize=0
    "const_count":   Initialize=0
    "scope_stack":   Initialize=0
    "scope_depth":   Initialize=0
    "scope_locals":  Initialize=0
    "str_buf":       Initialize=0
    "str_pos":       Initialize=0
    "func_pool":     Initialize=0
    "func_count":    Initialize=0
    "loop_stack":    Initialize=0
    "loop_depth":    Initialize=0
    "label_stack":   Initialize=0
    "label_depth":   Initialize=0
    "iter_stack":    Initialize=0
    "iter_depth":    Initialize=0
    "error":         Initialize=0
    "tdz_map":       Initialize=0
    // const_map: 256 bytes, 1 = slot is const (immutable after init)
    "const_map":     Initialize=0
    // const_names: linear list of const binding names (for free/global write checks)
    // 16-byte entries: name_ptr(8) + name_len(8). Max 128 names.
    "const_names":   Initialize=0
    "const_name_count": Initialize=0
    // M60: let binding names — free-var GET uses GET_FREE (TDZ / for-of fresh)
    "let_names":     Initialize=0
    "let_name_count": Initialize=0
    // M71: per-function body let/const name blobs for direct-eval SyntaxError
    // (var conflict with outer lexical). Pointer per fidx, 0 if none.
    "func_lex_names": Initialize=0
    // M71: param binding name blobs (default-param direct eval checks)
    "func_param_names": Initialize=0
    // M71: body_start PC per fidx (survives method-flag overwrite at pool+40)
    "func_body_starts": Initialize=0
    // M107: named function-expression name local slot per fidx (-1 = none)
    "func_name_slots": Initialize=0
    // M60: top-level var names — free-var GET uses GET_GLOBAL (dual-bound)
    "script_var_names": Initialize=0
    "script_var_count": Initialize=0
    "switch_jmps":   Initialize=0
    "func_nesting":  Initialize=0
    "in_arrow":      Initialize=0
    "is_derived_ctor": Initialize=0
    // M26g: 1 while compiling a static class method (SuperBase = parent ctor)
    "in_static_method": Initialize=0
    // M74: named class expression/decl — free-var class name (immutable binding)
    "class_name_ptr":  Initialize=0
    "class_name_len":  Initialize=0
    "eval_mode":       Initialize=0 // 1=REPL/eval: last EXPR_STMT keeps value on stack
    "is_last_stmt":    Initialize=0 // 1=currently compiling the last statement in program
    // M128e6q: 1 while compiling body that propagates eval completion (with/if)
    // so CompileBlock marks its last stmt is_last without loops leaking values
    "cptn_prop":       Initialize=0
    "is_strict":       Initialize=0 // Wave 3: "use strict" directive detected
    // M64: for-of/for-in let/const — skip SET_GLOBAL so bindings stay block-scoped
    "skip_let_global": Initialize=0
    // M65: eval completion slot for for-of body (-1 = off)
    "loop_cptn_slot": Initialize=-1
    "finally_stack":   Initialize=0
    "finally_depth":   Initialize=0
    // Closure capture: current function index + enclosing locals for free-var lookup
    "current_fidx":    Initialize=0
    "encl_count":      Initialize=0
    "encl_buf":        Initialize=0  // [name_ptr, name_len, owner_fidx] x MAX_ENCL
    // M26k.5/7: private-name brand stack (nested class outer private visibility)
    "priv_class_id":   Initialize=0
    "next_priv_class_id": Initialize=1
    "priv_depth":      Initialize=0
    "priv_name_count": Initialize=0
    "priv_name_ptrs":  Initialize=0   // 64 x 8
    "priv_name_lens":  Initialize=0   // 64 x 8
    "priv_name_depths": Initialize=0  // 64 x 8 owner depth
    "priv_stack_ids":  Initialize=0   // 16 x 8 brand id at depth
    // M26k.11: 1 while compiling sync generator (yield* → YIELD_STAR)
    // Default 0 → plain YIELD (safe for async gens until async-iter protocol)
    "in_sync_gen":     Initialize=0
    "with_depth":      Initialize=0
    // M128e6ah: monotonic absolute local slot allocator (no reuse after PopScope)
    "next_abs_slot":   Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.JSCompTmp {
    "idx":       Initialize=0
    "type":      Initialize=0
    "ptr":       Initialize=0
    "len":       Initialize=0
    "node":      Initialize=0
    "left":      Initialize=0
    "right":     Initialize=0
    "op":        Initialize=0
    "val":       Initialize=0
    "addr":      Initialize=0
    "done":      Initialize=0
    "count":     Initialize=0
    "slot":      Initialize=0
    "name_ptr":  Initialize=0
    "name_len":  Initialize=0
    "patch":     Initialize=0
}

// =============================================================================
// MEMBER_DOT ASSIGNMENT — dedicated state (not clobbered by recursive compile)
// =============================================================================
FixedPool.JSCompDot {
    "assign_node":  Initialize=0
    "member_node":  Initialize=0
}

// =============================================================================
// COMPILER STACK — save/restore JSCompTmp fields across recursive calls
// =============================================================================
FixedPool.JSCompStack {
    "pool":       Initialize=0
    "sp":         Initialize=0
    "capacity":   Initialize=0
    "tmp_val":    Initialize=0
    "tmp_addr":   Initialize=0
}

// =============================================================================
// STACK PUSH / POP
// =============================================================================
Function.JSComp__Push {
    Input: val: Integer
    Output: Integer
    Body: {
        JSCompStack.tmp_val = val
        JSCompStack.tmp_addr = Add(JSCompStack.pool, Multiply(JSCompStack.sp, 8))
        StoreValue(JSCompStack.tmp_addr, JSCompStack.tmp_val)
        JSCompStack.sp = Add(JSCompStack.sp, 1)
        ReturnValue(0)
    }
}

Function.JSComp__Pop {
    Output: Integer
    Body: {
        JSCompStack.sp = Subtract(JSCompStack.sp, 1)
        ReturnValue(Dereference(Add(JSCompStack.pool, Multiply(JSCompStack.sp, 8))))
    }
}

// =============================================================================
// INIT / RESET
// =============================================================================
Function.JSComp_Init {
    Output: Integer
    Body: {
        JSCompState.code = Allocate(JSCompConst.MAX_CODE)
        MemorySet(JSCompState.code, 0, JSCompConst.MAX_CODE)

        csz = Multiply(JSCompConst.MAX_CONSTS, JSCompConst.CONST_SIZE)
        JSCompState.const_pool = Allocate(csz)
        MemorySet(JSCompState.const_pool, 0, csz)

        ssz = Multiply(JSCompConst.MAX_SCOPES, JSCompConst.SCOPE_SIZE)
        JSCompState.scope_stack = Allocate(ssz)
        MemorySet(JSCompState.scope_stack, 0, ssz)

        slsz = Multiply(JSCompConst.MAX_SCOPES, 8)
        JSCompState.scope_locals = Allocate(slsz)
        MemorySet(JSCompState.scope_locals, 0, slsz)

        JSCompState.str_buf = Allocate(JSCompConst.STR_CAP)
        MemorySet(JSCompState.str_buf, 0, JSCompConst.STR_CAP)

        fsz = Multiply(JSCompConst.MAX_FUNCS, JSCompConst.FUNC_SIZE)
        JSCompState.func_pool = Allocate(fsz)
        MemorySet(JSCompState.func_pool, 0, fsz)

        lsz = Multiply(JSCompConst.MAX_LOOPS, JSCompConst.LOOP_SIZE)
        JSCompState.loop_stack = Allocate(lsz)
        MemorySet(JSCompState.loop_stack, 0, lsz)

        lbsz = Multiply(JSCompConst.MAX_LABELS, JSCompConst.LABEL_SIZE)
        JSCompState.label_stack = Allocate(lbsz)
        MemorySet(JSCompState.label_stack, 0, lbsz)
        JSCompState.label_depth = 0

        isz = Multiply(JSCompConst.MAX_ITERS, JSCompConst.ITER_SIZE)
        JSCompState.iter_stack = Allocate(isz)
        MemorySet(JSCompState.iter_stack, 0, isz)
        JSCompState.iter_depth = 0

        fsz2 = Multiply(JSCompConst.MAX_FINALLY, JSCompConst.FINALLY_SIZE)
        JSCompState.finally_stack = Allocate(fsz2)
        MemorySet(JSCompState.finally_stack, 0, fsz2)
        JSCompState.finally_depth = 0

        // Compiler frame stack (2048 entries x 8 bytes)
        JSCompStack.pool = Allocate(16384)
        JSCompStack.capacity = 2048
        JSCompStack.sp = 0

        JSCompState.code_pos = 0
        JSCompState.const_count = 0
        JSCompState.scope_depth = 0
        JSCompState.next_abs_slot = 0
        JSCompState.str_pos = 0
        JSCompState.func_count = 0
        JSCompState.loop_depth = 0
        JSCompState.label_depth = 0
        JSCompState.iter_depth = 0
        JSCompState.error = 0
        JSCompState.func_nesting = 0
        JSCompState.priv_class_id = 0
        JSCompState.next_priv_class_id = 1

        // TDZ map: 256 bytes, one per local slot (0=ok, 1=in TDZ)
        JSCompState.tdz_map = Allocate(256)
        MemorySet(JSCompState.tdz_map, 0, 256)
        // const_map: 1 = cannot reassign
        JSCompState.const_map = Allocate(256)
        MemorySet(JSCompState.const_map, 0, 256)
        JSCompState.const_names = Allocate(2048)
        MemorySet(JSCompState.const_names, 0, 2048)
        JSCompState.const_name_count = 0
        JSCompState.let_names = Allocate(2048)
        MemorySet(JSCompState.let_names, 0, 2048)
        JSCompState.let_name_count = 0
        // M71: MAX_FUNCS pointers for per-function lex/param name blobs + body_start
        flx = Multiply(JSCompConst.MAX_FUNCS, 8)
        JSCompState.func_lex_names = Allocate(flx)
        MemorySet(JSCompState.func_lex_names, 0, flx)
        JSCompState.func_param_names = Allocate(flx)
        MemorySet(JSCompState.func_param_names, 0, flx)
        JSCompState.func_body_starts = Allocate(flx)
        MemorySet(JSCompState.func_body_starts, 0, flx)
        JSCompState.func_name_slots = Allocate(flx)
        // 0 = no name binding; else name_slot+1
        MemorySet(JSCompState.func_name_slots, 0, flx)
        JSCompState.script_var_names = Allocate(2048)
        MemorySet(JSCompState.script_var_names, 0, 2048)
        JSCompState.script_var_count = 0

        // Switch case jump table: 256 entries x 8 bytes (stores JMP_TRUE addresses)
        JSCompState.switch_jmps = Allocate(2048)
        MemorySet(JSCompState.switch_jmps, 0, 2048)

        // Enclosing-local table for free-var / closure capture
        esz = Multiply(JSCompConst.MAX_ENCL, JSCompConst.ENCL_ENTRY)
        JSCompState.encl_buf = Allocate(esz)
        MemorySet(JSCompState.encl_buf, 0, esz)
        JSCompState.encl_count = 0
        JSCompState.current_fidx = 0

        // M26k.7: private name brand stack (64 names, 16 class depth)
        JSCompState.priv_name_ptrs = Allocate(512)
        MemorySet(JSCompState.priv_name_ptrs, 0, 512)
        JSCompState.priv_name_lens = Allocate(512)
        MemorySet(JSCompState.priv_name_lens, 0, 512)
        JSCompState.priv_name_depths = Allocate(512)
        MemorySet(JSCompState.priv_name_depths, 0, 512)
        JSCompState.priv_stack_ids = Allocate(128)
        MemorySet(JSCompState.priv_stack_ids, 0, 128)
        JSCompState.priv_depth = 0
        JSCompState.priv_name_count = 0

        ReturnValue(1)
    }
}

Function.JSComp_Reset {
    Output: Integer
    Body: {
        MemorySet(JSCompState.code, 0, JSCompConst.MAX_CODE)
        csz = Multiply(JSCompConst.MAX_CONSTS, JSCompConst.CONST_SIZE)
        MemorySet(JSCompState.const_pool, 0, csz)
        ssz = Multiply(JSCompConst.MAX_SCOPES, JSCompConst.SCOPE_SIZE)
        MemorySet(JSCompState.scope_stack, 0, ssz)
        slsz = Multiply(JSCompConst.MAX_SCOPES, 8)
        MemorySet(JSCompState.scope_locals, 0, slsz)
        JSCompState.str_pos = 0
        fsz = Multiply(JSCompConst.MAX_FUNCS, JSCompConst.FUNC_SIZE)
        MemorySet(JSCompState.func_pool, 0, fsz)
        lsz = Multiply(JSCompConst.MAX_LOOPS, JSCompConst.LOOP_SIZE)
        MemorySet(JSCompState.loop_stack, 0, lsz)
        lbsz = Multiply(JSCompConst.MAX_LABELS, JSCompConst.LABEL_SIZE)
        MemorySet(JSCompState.label_stack, 0, lbsz)
        JSCompState.label_depth = 0
        isz = Multiply(JSCompConst.MAX_ITERS, JSCompConst.ITER_SIZE)
        MemorySet(JSCompState.iter_stack, 0, isz)
        JSCompState.iter_depth = 0
        fsz2 = Multiply(JSCompConst.MAX_FINALLY, JSCompConst.FINALLY_SIZE)
        MemorySet(JSCompState.finally_stack, 0, fsz2)
        JSCompState.code_pos = 0
        JSCompState.const_count = 0
        JSCompState.scope_depth = 0
        JSCompState.next_abs_slot = 0
        JSCompState.func_count = 0
        JSCompState.loop_depth = 0
        JSCompState.finally_depth = 0
        JSCompState.error = 0
        JSCompState.func_nesting = 0
        JSCompState.eval_mode = 0
        JSCompState.is_last_stmt = 0
        JSCompState.cptn_prop = 0
        JSCompState.is_strict = 0
        JSCompState.skip_let_global = 0
        JSCompState.loop_cptn_slot = -1
        JSCompState.priv_class_id = 0
        JSCompState.next_priv_class_id = 1
        JSCompState.priv_depth = 0
        JSCompState.priv_name_count = 0
        JSCompStack.sp = 0
        MemorySet(JSCompState.tdz_map, 0, 256)
        MemorySet(JSCompState.const_map, 0, 256)
        MemorySet(JSCompState.const_names, 0, 2048)
        JSCompState.const_name_count = 0
        IfCondition NotEqual(JSCompState.let_names, 0) ThenBlock: {
            MemorySet(JSCompState.let_names, 0, 2048)
        }
        JSCompState.let_name_count = 0
        IfCondition NotEqual(JSCompState.func_lex_names, 0) ThenBlock: {
            MemorySet(JSCompState.func_lex_names, 0, Multiply(JSCompConst.MAX_FUNCS, 8))
        }
        IfCondition NotEqual(JSCompState.func_param_names, 0) ThenBlock: {
            MemorySet(JSCompState.func_param_names, 0, Multiply(JSCompConst.MAX_FUNCS, 8))
        }
        IfCondition NotEqual(JSCompState.func_body_starts, 0) ThenBlock: {
            MemorySet(JSCompState.func_body_starts, 0, Multiply(JSCompConst.MAX_FUNCS, 8))
        }
        IfCondition NotEqual(JSCompState.func_name_slots, 0) ThenBlock: {
            MemorySet(JSCompState.func_name_slots, 0, Multiply(JSCompConst.MAX_FUNCS, 8))
        }
        IfCondition NotEqual(JSCompState.script_var_names, 0) ThenBlock: {
            MemorySet(JSCompState.script_var_names, 0, 2048)
        }
        JSCompState.script_var_count = 0
        IfCondition NotEqual(JSCompState.priv_name_ptrs, 0) ThenBlock: {
            MemorySet(JSCompState.priv_name_ptrs, 0, 512)
            MemorySet(JSCompState.priv_name_lens, 0, 512)
            MemorySet(JSCompState.priv_name_depths, 0, 512)
            MemorySet(JSCompState.priv_stack_ids, 0, 128)
        }
        ReturnValue(0)
    }
}

// Register a const binding name (stable str_buf copy already in name_ptr)
Function.JSComp__RegisterConstName {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_p = name_ptr
        save_l = name_len
        IfCondition GreaterEqual(JSCompState.const_name_count, 128) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSCompState.const_names, Multiply(JSCompState.const_name_count, 16))
        StoreValue(base, save_p)
        StoreValue(Add(base, 8), save_l)
        JSCompState.const_name_count = Add(JSCompState.const_name_count, 1)
        ReturnValue(1)
    }
}

// 1 if name is a registered const binding
Function.JSComp__IsConstName {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_p = name_ptr
        save_l = name_len
        i = 0
        WhileLoop LessThan(i, JSCompState.const_name_count) {
            base = Add(JSCompState.const_names, Multiply(i, 16))
            ep = Dereference(base)
            el = Dereference(Add(base, 8))
            JSComp__Push(i)
            eq = JSComp__StrEq(save_p, save_l, ep, el)
            i = JSComp__Pop()
            IfCondition EqualTo(eq, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// M60: register let binding (free-var GET must use GET_FREE for TDZ / fresh)
Function.JSComp__RegisterLetName {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_p = name_ptr
        save_l = name_len
        IfCondition GreaterEqual(JSCompState.let_name_count, 128) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSCompState.let_names, Multiply(JSCompState.let_name_count, 16))
        StoreValue(base, save_p)
        StoreValue(Add(base, 8), save_l)
        JSCompState.let_name_count = Add(JSCompState.let_name_count, 1)
        ReturnValue(1)
    }
}

Function.JSComp__IsLetName {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_p = name_ptr
        save_l = name_len
        i = 0
        WhileLoop LessThan(i, JSCompState.let_name_count) {
            base = Add(JSCompState.let_names, Multiply(i, 16))
            ep = Dereference(base)
            el = Dereference(Add(base, 8))
            JSComp__Push(i)
            eq = JSComp__StrEq(save_p, save_l, ep, el)
            i = JSComp__Pop()
            IfCondition EqualTo(eq, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// M60: top-level var — free-var readers use GET_GLOBAL (dual-bound)
Function.JSComp__RegisterScriptVar {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_p = name_ptr
        save_l = name_len
        IfCondition GreaterEqual(JSCompState.script_var_count, 128) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSCompState.script_var_names, Multiply(JSCompState.script_var_count, 16))
        StoreValue(base, save_p)
        StoreValue(Add(base, 8), save_l)
        JSCompState.script_var_count = Add(JSCompState.script_var_count, 1)
        ReturnValue(1)
    }
}

Function.JSComp__IsScriptVar {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_p = name_ptr
        save_l = name_len
        i = 0
        WhileLoop LessThan(i, JSCompState.script_var_count) {
            base = Add(JSCompState.script_var_names, Multiply(i, 16))
            ep = Dereference(base)
            el = Dereference(Add(base, 8))
            JSComp__Push(i)
            eq = JSComp__StrEq(save_p, save_l, ep, el)
            i = JSComp__Pop()
            IfCondition EqualTo(eq, 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// FINALLY STACK — run finally on continue/break/return (inline bodies)
// Entry: [0]=fin_body AST idx, [8]=in_try (1 while compiling try body)
// =============================================================================

Function.JSComp__PushFinally {
    Input: fin_body: Integer
    Output: Integer
    Body: {
        save_fb = fin_body
        IfCondition GreaterEqual(JSCompState.finally_depth, JSCompConst.MAX_FINALLY) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        base = Add(JSCompState.finally_stack, Multiply(JSCompState.finally_depth, JSCompConst.FINALLY_SIZE))
        StoreValue(base, save_fb)
        StoreValue(Add(base, 8), 1)
        JSCompState.finally_depth = Add(JSCompState.finally_depth, 1)
        ReturnValue(0)
    }
}

Function.JSComp__PopFinally {
    Output: Integer
    Body: {
        IfCondition LessThan(JSCompState.finally_depth, 1) ThenBlock: {
            ReturnValue(-1)
        }
        JSCompState.finally_depth = Subtract(JSCompState.finally_depth, 1)
        ReturnValue(0)
    }
}

Function.JSComp__SetFinallyInTry {
    Input: flag: Integer
    Output: Integer
    Body: {
        save_flag = flag
        IfCondition LessThan(JSCompState.finally_depth, 1) ThenBlock: {
            ReturnValue(-1)
        }
        depth_idx = Subtract(JSCompState.finally_depth, 1)
        base = Add(JSCompState.finally_stack, Multiply(depth_idx, JSCompConst.FINALLY_SIZE))
        StoreValue(Add(base, 8), save_flag)
        ReturnValue(0)
    }
}

Function.JSComp__PeekFinallyBody {
    Output: Integer
    Body: {
        IfCondition LessThan(JSCompState.finally_depth, 1) ThenBlock: {
            ReturnValue(-1)
        }
        depth_idx = Subtract(JSCompState.finally_depth, 1)
        base = Add(JSCompState.finally_stack, Multiply(depth_idx, JSCompConst.FINALLY_SIZE))
        ReturnValue(Dereference(base))
    }
}

Function.JSComp_IsStrict {
    Output: Integer
    Body: {
        ReturnValue(JSCompState.is_strict)
    }
}

// Set eval mode: last expression statement keeps its value on the stack
// M128g: also skip dual-writing let/const to global/script_env (eval has its
// own declarative LexicalEnvironment — must not leak or clash with outer let).
Function.JSComp_SetEvalMode {
    Input: mode: Integer
    Body: {
        JSCompState.eval_mode = mode
        JSCompState.skip_let_global = mode
    }
}

// =============================================================================
// BYTECODE EMISSION HELPERS
// =============================================================================

// Emit single byte
Function.JSComp__Emit1 {
    Input: byte: Integer
    Output: Integer
    Body: {
        save_byte = byte
        IfCondition GreaterEqual(JSCompState.code_pos, JSCompConst.MAX_CODE) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        SetByte(JSCompState.code, JSCompState.code_pos, save_byte)
        JSCompState.code_pos = Add(JSCompState.code_pos, 1)
        ReturnValue(0)
    }
}

// Emit opcode + 24-bit big-endian operand (4 bytes total)
Function.JSComp__EmitOp16 {
    Input: opcode: Integer
    Input: operand: Integer
    Output: Integer
    Body: {
        save_op = opcode
        save_operand = operand
        b2 = BitwiseAnd(ShiftRight(save_operand, 16), 255)
        b1 = BitwiseAnd(ShiftRight(save_operand, 8), 255)
        b0 = BitwiseAnd(save_operand, 255)
        JSComp__Emit1(save_op)
        JSComp__Emit1(b2)
        JSComp__Emit1(b1)
        JSComp__Emit1(b0)
        ReturnValue(0)
    }
}

// Patch a 24-bit jump target at addr+1, addr+2, addr+3 with current code_pos
Function.JSComp__PatchJump {
    Input: addr: Integer
    Output: Integer
    Body: {
        save_addr = addr
        target = JSCompState.code_pos
        b2 = BitwiseAnd(ShiftRight(target, 16), 255)
        b1 = BitwiseAnd(ShiftRight(target, 8), 255)
        b0 = BitwiseAnd(target, 255)
        SetByte(JSCompState.code, Add(save_addr, 1), b2)
        SetByte(JSCompState.code, Add(save_addr, 2), b1)
        SetByte(JSCompState.code, Add(save_addr, 3), b0)
        ReturnValue(0)
    }
}

// =============================================================================
// CONSTANT POOL
// =============================================================================

// Add number constant from integer (converts to IEEE 754 double bits), return pool index
Function.JSComp__AddNumber {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        idx = JSCompState.const_count
        IfCondition GreaterEqual(idx, JSCompConst.MAX_CONSTS) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        JSCompState.const_count = Add(idx, 1)
        base = Add(JSCompState.const_pool, Multiply(idx, JSCompConst.CONST_SIZE))
        // Type 1 = NUMBER (store as IEEE 754 double bits)
        StoreValue(base, 1)
        fbits = Float_FromInt(save_n)
        StoreValue(Add(base, 8), fbits)
        ReturnValue(idx)
    }
}

// M97: PropertyName ToPropertyKey for numeric literals.
// Source text "0x10" / "0o10" / "0b10" / "1e2" must become ToString(Number) keys
// ("16", "8", "2", "100"), not the raw source spelling.
Function.JSComp__AddPropName {
    Input: ptr: Address
    Input: len: Integer
    Output: Integer
    Body: {
        save_ptr = ptr
        save_len = len
        IfCondition Or(EqualTo(save_ptr, 0), LessEqual(save_len, 0)) ThenBlock: {
            ReturnValue(JSComp__AddString(save_ptr, save_len))
        }
        // Detect numeric PropertyName: starts with digit, or '.' digit, or 0x/0o/0b
        is_num = 0
        b0 = GetByte(save_ptr, 0)
        IfCondition And(GreaterEqual(b0, 48), LessEqual(b0, 57)) ThenBlock: { is_num = 1 }
        IfCondition And(EqualTo(b0, 46), GreaterThan(save_len, 1)) ThenBlock: {
            b1 = GetByte(save_ptr, 1)
            IfCondition And(GreaterEqual(b1, 48), LessEqual(b1, 57)) ThenBlock: { is_num = 1 }
        }
        IfCondition EqualTo(is_num, 0) ThenBlock: {
            ReturnValue(JSComp__AddString(save_ptr, save_len))
        }
        // Parse Number value (handles 0x/0o/0b/decimal/exponent)
        fbits = JSParse__ParseFloat(save_ptr, save_len)
        // ES ToString(Number) via runtime float formatter (.1 → "0.1", 1e-7 → "1e-7")
        fstr = JSRT__FloatToStr(fbits)
        IfCondition EqualTo(fstr, 0) ThenBlock: {
            ReturnValue(JSComp__AddString(save_ptr, save_len))
        }
        flen = 0
        WhileLoop NotEqual(GetByte(fstr, flen), 0) {
            flen = Add(flen, 1)
            IfCondition GreaterThan(flen, 64) ThenBlock: {
                // safety
                ReturnValue(JSComp__AddString(save_ptr, save_len))
            }
        }
        ReturnValue(JSComp__AddString(fstr, flen))
    }
}

// Add number constant from pre-computed IEEE 754 double bits, return pool index
Function.JSComp__AddFloat {
    Input: bits: Integer
    Output: Integer
    Body: {
        save_bits = bits
        idx = JSCompState.const_count
        IfCondition GreaterEqual(idx, JSCompConst.MAX_CONSTS) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        JSCompState.const_count = Add(idx, 1)
        base = Add(JSCompState.const_pool, Multiply(idx, JSCompConst.CONST_SIZE))
        // Type 1 = NUMBER (already IEEE 754 double bits)
        StoreValue(base, 1)
        StoreValue(Add(base, 8), save_bits)
        ReturnValue(idx)
    }
}

// Add string constant: copy string into str_buf, add pool entry, return index
// Intern string as const pool entry WITHOUT private-name mangling.
// Use for STRING_LIT / user string values — "#m" must stay literal.
Function.JSComp__AddStringRaw {
    Input: ptr: Address
    Input: len: Integer
    Output: Integer
    Body: {
        save_ptr = ptr
        save_len = len
        needed = Add(JSCompState.str_pos, Add(save_len, 1))
        IfCondition GreaterEqual(needed, JSCompConst.STR_CAP) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        dest = Add(JSCompState.str_buf, JSCompState.str_pos)
        IfCondition And(NotEqual(save_ptr, 0), GreaterThan(save_len, 0)) ThenBlock: {
            MemoryCopy(dest, save_ptr, save_len)
        }
        SetByte(dest, save_len, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, Add(save_len, 1))
        idx = JSCompState.const_count
        IfCondition GreaterEqual(idx, JSCompConst.MAX_CONSTS) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        JSCompState.const_count = Add(idx, 1)
        base = Add(JSCompState.const_pool, Multiply(idx, JSCompConst.CONST_SIZE))
        StoreValue(base, 2)
        StoreValue(Add(base, 8), dest)
        ReturnValue(idx)
    }
}

Function.JSComp__AddString {
    Input: ptr: Address
    Input: len: Integer
    Output: Integer
    Body: {
        save_ptr = ptr
        save_len = len
        // M26k.7: mangle private names "#name@id" using declaring class brand.
        // Nested classes without own #x still resolve #x to outer brand.
        use_mangle = 0
        cid = 0
        IfCondition And(NotEqual(JSCompState.priv_depth, 0), GreaterThan(save_len, 0)) ThenBlock: {
            IfCondition EqualTo(GetByte(save_ptr, 0), 35) ThenBlock: {
                has_at = 0
                ai = 0
                WhileLoop LessThan(ai, save_len) {
                    IfCondition EqualTo(GetByte(save_ptr, ai), 64) ThenBlock: { has_at = 1 }
                    ai = Add(ai, 1)
                }
                IfCondition EqualTo(has_at, 0) ThenBlock: {
                    // Find declaring class: search private name table from newest
                    found_d = -1
                    ni = Subtract(JSCompState.priv_name_count, 1)
                    WhileLoop GreaterEqual(ni, 0) {
                        nptr = Dereference(Add(JSCompState.priv_name_ptrs, Multiply(ni, 8)))
                        nlen = Dereference(Add(JSCompState.priv_name_lens, Multiply(ni, 8)))
                        IfCondition EqualTo(nlen, save_len) ThenBlock: {
                            same = 1
                            bi = 0
                            WhileLoop And(EqualTo(same, 1), LessThan(bi, save_len)) {
                                IfCondition NotEqual(GetByte(nptr, bi), GetByte(save_ptr, bi)) ThenBlock: {
                                    same = 0
                                }
                                bi = Add(bi, 1)
                            }
                            IfCondition EqualTo(same, 1) ThenBlock: {
                                found_d = Dereference(Add(JSCompState.priv_name_depths, Multiply(ni, 8)))
                                ni = -1
                            }
                        }
                        ni = Subtract(ni, 1)
                    }
                    IfCondition GreaterEqual(found_d, 0) ThenBlock: {
                        cid = Dereference(Add(JSCompState.priv_stack_ids, Multiply(found_d, 8)))
                        use_mangle = 1
                    }
                    // M26k.10: do NOT mangle undeclared "#..." — public string keys
                    // like ["#constructor"] must stay literal. Declared privates are
                    // in the name table; undeclared this.#x is a parse-time error.
                }
            }
        }
        IfCondition EqualTo(use_mangle, 1) ThenBlock: {
            digs = 1
            tmp = cid
            WhileLoop GreaterEqual(tmp, 10) {
                digs = Add(digs, 1)
                tmp = Divide(tmp, 10)
            }
            nlen = Add(save_len, Add(1, digs))
            needed = Add(JSCompState.str_pos, Add(nlen, 1))
            IfCondition GreaterEqual(needed, JSCompConst.STR_CAP) ThenBlock: {
                JSCompState.error = 1
                ReturnValue(-1)
            }
            dest = Add(JSCompState.str_buf, JSCompState.str_pos)
            MemoryCopy(dest, save_ptr, save_len)
            SetByte(dest, save_len, 64)
            di = Subtract(nlen, 1)
            tmp = cid
            WhileLoop GreaterEqual(di, Add(save_len, 1)) {
                d10 = Divide(tmp, 10)
                digit = Subtract(tmp, Multiply(d10, 10))
                SetByte(dest, di, Add(48, digit))
                tmp = d10
                di = Subtract(di, 1)
            }
            SetByte(dest, nlen, 0)
            str_start = dest
            JSCompState.str_pos = Add(JSCompState.str_pos, Add(nlen, 1))
        } ElseBlock: {
            needed = Add(JSCompState.str_pos, Add(save_len, 1))
            IfCondition GreaterEqual(needed, JSCompConst.STR_CAP) ThenBlock: {
                JSCompState.error = 1
                ReturnValue(-1)
            }
            dest = Add(JSCompState.str_buf, JSCompState.str_pos)
            MemoryCopy(dest, save_ptr, save_len)
            SetByte(dest, save_len, 0)
            str_start = dest
            JSCompState.str_pos = Add(JSCompState.str_pos, Add(save_len, 1))
        }

        // Add pool entry
        idx = JSCompState.const_count
        IfCondition GreaterEqual(idx, JSCompConst.MAX_CONSTS) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        JSCompState.const_count = Add(idx, 1)
        base = Add(JSCompState.const_pool, Multiply(idx, JSCompConst.CONST_SIZE))
        // Type 2 = STRING
        StoreValue(base, 2)
        StoreValue(Add(base, 8), str_start)
        ReturnValue(idx)
    }
}

// =============================================================================
// STRING COMPARISON — byte-by-byte
// =============================================================================
Function.JSComp__StrEq {
    Input: p1: Address
    Input: l1: Integer
    Input: p2: Address
    Input: l2: Integer
    Output: Integer
    Body: {
        save_p1 = p1
        save_l1 = l1
        save_p2 = p2
        save_l2 = l2
        IfCondition NotEqual(save_l1, save_l2) ThenBlock: {
            ReturnValue(0)
        }
        JSCompTmp.idx = 0
        WhileLoop LessThan(JSCompTmp.idx, save_l1) {
            JSCompTmp.op = GetByte(save_p1, JSCompTmp.idx)
            JSCompTmp.val = GetByte(save_p2, JSCompTmp.idx)
            IfCondition NotEqual(JSCompTmp.op, JSCompTmp.val) ThenBlock: {
                ReturnValue(0)
            }
            JSCompTmp.idx = Add(JSCompTmp.idx, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// SCOPE MANAGEMENT
// =============================================================================

Function.JSComp__PushScope {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(JSCompState.scope_depth, JSCompConst.MAX_SCOPES) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        // Zero the local count for this scope
        addr = Add(JSCompState.scope_locals, Multiply(JSCompState.scope_depth, 8))
        StoreValue(addr, 0)
        // Zero the scope entry area
        sbase = Add(JSCompState.scope_stack, Multiply(JSCompState.scope_depth, JSCompConst.SCOPE_SIZE))
        MemorySet(sbase, 0, JSCompConst.SCOPE_SIZE)
        JSCompState.scope_depth = Add(JSCompState.scope_depth, 1)
        ReturnValue(0)
    }
}

Function.JSComp__PopScope {
    Output: Integer
    Body: {
        IfCondition LessThan(JSCompState.scope_depth, 1) ThenBlock: {
            ReturnValue(-1)
        }
        JSCompState.scope_depth = Subtract(JSCompState.scope_depth, 1)
        ReturnValue(0)
    }
}

// M128e: var is function-scoped — bind at depth_idx 0 (function/program root),
// not the current block scope (with/if/for blocks PushScope).
Function.JSComp__AddVarLocal {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_ptr = name_ptr
        save_len = name_len
        // Already present in any scope → reuse (idempotent hoist)
        existing = JSComp__FindLocal(save_ptr, save_len)
        IfCondition GreaterEqual(existing, 0) ThenBlock: {
            ReturnValue(existing)
        }
        // Function compile resets scope_depth to 0 then PushScope → root is 0.
        // Program PushScope once → root is 0. Block scopes are >0.
        depth_idx = 0
        IfCondition LessThan(JSCompState.scope_depth, 1) ThenBlock: {
            ReturnValue(-1)
        }
        lc_addr = Add(JSCompState.scope_locals, Multiply(depth_idx, 8))
        lc = Dereference(lc_addr)
        IfCondition GreaterEqual(lc, 1024) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        sbase = Add(JSCompState.scope_stack, Multiply(depth_idx, JSCompConst.SCOPE_SIZE))
        entry = Add(sbase, Multiply(lc, 24))
        // M128e6ah: monotonic next_abs_slot — never reuse after PopScope
        abs_slot = JSCompState.next_abs_slot
        JSCompState.next_abs_slot = Add(abs_slot, 1)
        StoreValue(entry, save_ptr)
        StoreValue(Add(entry, 8), save_len)
        StoreValue(Add(entry, 16), abs_slot)
        StoreValue(lc_addr, Add(lc, 1))
        ReturnValue(abs_slot)
    }
}

// Add a local variable to the current scope, return its slot index
Function.JSComp__AddLocal {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_ptr = name_ptr
        save_len = name_len
        depth_idx = Subtract(JSCompState.scope_depth, 1)
        IfCondition LessThan(depth_idx, 0) ThenBlock: {
            ReturnValue(-1)
        }
        // Get current local count for this scope
        lc_addr = Add(JSCompState.scope_locals, Multiply(depth_idx, 8))
        lc = Dereference(lc_addr)
        IfCondition GreaterEqual(lc, 1024) ThenBlock: {
            PrintMessage("[COMP] locals overflow lc=")
            PrintNumber(lc)
            PrintMessage(" depth=")
            PrintNumber(JSCompState.scope_depth)
            PrintMessage("\n")
            JSCompState.error = 1
            ReturnValue(-1)
        }
        // Each local entry: 24 bytes (name_ptr(8) + name_len(8) + slot(8))
        sbase = Add(JSCompState.scope_stack, Multiply(depth_idx, JSCompConst.SCOPE_SIZE))
        entry = Add(sbase, Multiply(lc, 24))
        // M128e6ah: monotonic next_abs_slot (no reuse after PopScope)
        abs_slot = JSCompState.next_abs_slot
        JSCompState.next_abs_slot = Add(abs_slot, 1)
        StoreValue(entry, save_ptr)
        StoreValue(Add(entry, 8), save_len)
        StoreValue(Add(entry, 16), abs_slot)
        // Increment local count
        StoreValue(lc_addr, Add(lc, 1))
        ReturnValue(abs_slot)
    }
}

// Find a local variable by name, searching from current scope outward.
// Returns slot index or -1 if not found.
Function.JSComp__FindLocal {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_ptr = name_ptr
        save_len = name_len
        // Search from innermost scope to outermost
        JSCompTmp.idx = Subtract(JSCompState.scope_depth, 1)
        WhileLoop GreaterEqual(JSCompTmp.idx, 0) {
            lc_addr = Add(JSCompState.scope_locals, Multiply(JSCompTmp.idx, 8))
            lc = Dereference(lc_addr)
            sbase = Add(JSCompState.scope_stack, Multiply(JSCompTmp.idx, JSCompConst.SCOPE_SIZE))
            JSCompTmp.val = 0
            WhileLoop LessThan(JSCompTmp.val, lc) {
                entry = Add(sbase, Multiply(JSCompTmp.val, 24))
                ep = Dereference(entry)
                el = Dereference(Add(entry, 8))

                // CLOBBER GUARD: StrEq clobbers JSCompTmp.idx and JSCompTmp.val
                JSComp__Push(JSCompTmp.idx)
                JSComp__Push(JSCompTmp.val)

                eq = JSComp__StrEq(save_ptr, save_len, ep, el)

                // RESTORE
                JSCompTmp.val = JSComp__Pop()
                JSCompTmp.idx = JSComp__Pop()

                IfCondition EqualTo(eq, 1) ThenBlock: {
                    ReturnValue(Dereference(Add(entry, 16)))
                }
                JSCompTmp.val = Add(JSCompTmp.val, 1)
            }
            JSCompTmp.idx = Subtract(JSCompTmp.idx, 1)
        }
        ReturnValue(-1)
    }
}

// Find a local variable by name in the CURRENT (innermost) scope ONLY.
// Returns slot index or -1 if not found in current scope.
// Used for redeclaration detection — let/const cannot shadow same-scope names.
Function.JSComp__FindLocalInScope {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_ptr = name_ptr
        save_len = name_len
        depth_idx = Subtract(JSCompState.scope_depth, 1)
        IfCondition LessThan(depth_idx, 0) ThenBlock: { ReturnValue(-1) }

        lc_addr = Add(JSCompState.scope_locals, Multiply(depth_idx, 8))
        lc = Dereference(lc_addr)
        sbase = Add(JSCompState.scope_stack, Multiply(depth_idx, JSCompConst.SCOPE_SIZE))
        JSCompTmp.val = 0
        WhileLoop LessThan(JSCompTmp.val, lc) {
            entry = Add(sbase, Multiply(JSCompTmp.val, 24))
            ep = Dereference(entry)
            el = Dereference(Add(entry, 8))

            JSComp__Push(JSCompTmp.val)
            eq = JSComp__StrEq(save_ptr, save_len, ep, el)
            JSCompTmp.val = JSComp__Pop()

            IfCondition EqualTo(eq, 1) ThenBlock: {
                ReturnValue(Dereference(Add(entry, 16)))
            }
            JSCompTmp.val = Add(JSCompTmp.val, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// VARIABLE RESOLUTION — emit GET/SET LOCAL or GLOBAL + closure capture cells
// Capture cells: "__uv_<fidx>_<name>" — function-local mirrors for free vars
// =============================================================================

Function.JSComp__CapNameAdd {
    Input: owner_fidx: Integer
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_f = owner_fidx
        save_ptr = name_ptr
        save_len = name_len
        p = Add(JSCompState.str_buf, JSCompState.str_pos)
        SetByte(p, 0, 95)
        SetByte(p, 1, 95)
        SetByte(p, 2, 117)
        SetByte(p, 3, 118)
        SetByte(p, 4, 95)
        pos = 5
        IfCondition GreaterEqual(save_f, 100) ThenBlock: {
            SetByte(p, pos, Add(48, Divide(save_f, 100)))
            pos = Add(pos, 1)
            save_f = Subtract(save_f, Multiply(Divide(save_f, 100), 100))
        }
        IfCondition GreaterEqual(save_f, 10) ThenBlock: {
            SetByte(p, pos, Add(48, Divide(save_f, 10)))
            pos = Add(pos, 1)
            save_f = Subtract(save_f, Multiply(Divide(save_f, 10), 10))
        }
        SetByte(p, pos, Add(48, save_f))
        pos = Add(pos, 1)
        SetByte(p, pos, 95)
        pos = Add(pos, 1)
        MemoryCopy(Add(p, pos), save_ptr, save_len)
        pos = Add(pos, save_len)
        SetByte(p, pos, 0)
        JSCompState.str_pos = Add(JSCompState.str_pos, Add(pos, 1))
        ReturnValue(JSComp__AddString(p, pos))
    }
}

Function.JSComp__FindEnclosing {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        // Search newest-first so inner shadowing wins over grandparent names
        save_ptr = name_ptr
        save_len = name_len
        i = Subtract(JSCompState.encl_count, 1)
        WhileLoop GreaterEqual(i, 0) {
            ebase = Add(JSCompState.encl_buf, Multiply(i, JSCompConst.ENCL_ENTRY))
            ep = Dereference(ebase)
            el = Dereference(Add(ebase, 8))
            JSComp__Push(i)
            eq = JSComp__StrEq(save_ptr, save_len, ep, el)
            i = JSComp__Pop()
            IfCondition EqualTo(eq, 1) ThenBlock: {
                ReturnValue(Dereference(Add(ebase, 16)))
            }
            i = Subtract(i, 1)
        }
        ReturnValue(-1)
    }
}

// True if name is "arguments" (VM injects bare global arguments per call).
// Must not capture outer `var arguments` as free-var for nested functions.
Function.JSComp__IsArgumentsName {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(name_len, 9) ThenBlock: {
            ReturnValue(0)
        }
        // a r g u m e n t s
        IfCondition NotEqual(GetByte(name_ptr, 0), 97) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name_ptr, 1), 114) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name_ptr, 2), 103) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name_ptr, 3), 117) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name_ptr, 4), 109) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name_ptr, 5), 101) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name_ptr, 6), 110) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name_ptr, 7), 116) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name_ptr, 8), 115) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.JSComp__EmitVarGet {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_ptr = name_ptr
        save_len = name_len
        slot = JSComp__FindLocal(save_ptr, save_len)
        // M128e: under with, ObjectEnv is consulted at runtime before locals
        // (function var x shadowed by with-object .x). Capture Reference base
        // for PutValue (getter may delete property before assignment).
        IfCondition GreaterThan(JSCompState.with_depth, 0) ThenBlock: {
            ci = JSComp__AddString(save_ptr, save_len)
            JSComp__EmitOp16(JSOp.GET_WITH, ci)
            // trailing slot: 0xFFFFFF = no local fallback
            IfCondition GreaterEqual(slot, 0) ThenBlock: {
                JSComp__Emit1(0)
                JSComp__Emit1(BitwiseAnd(ShiftRight(slot, 8), 255))
                JSComp__Emit1(BitwiseAnd(slot, 255))
            } ElseBlock: {
                JSComp__Emit1(255)
                JSComp__Emit1(255)
                JSComp__Emit1(255)
            }
            ReturnValue(0)
        }
        IfCondition GreaterEqual(slot, 0) ThenBlock: {
            IfCondition And(LessThan(slot, 256), EqualTo(GetByte(JSCompState.tdz_map, slot), 1)) ThenBlock: {
                ci = JSComp__AddString(save_ptr, save_len)
                JSComp__EmitOp16(JSOp.THROW_TDZ, ci)
            } ElseBlock: {
                // M128e6: always GET_LOCAL when a slot exists. Free-var SET_FREE
                // stores durable GlobalHash gvals into stack via __sl_ (and
                // GET_LOCAL dual-reads GlobalHash if stack lags). Preferring
                // GET_GLOBAL for script vars fixed super.prop but regressed with
                // (SET_WITH dual-bind expects stack locals).
                JSComp__EmitOp16(JSOp.GET_LOCAL, slot)
            }
        } ElseBlock: {
            // "arguments": arrows capture enclosing activation's args via __cenv
            // (VM dual-writes args obj onto frame env). Non-arrows use global.
            is_args = JSComp__IsArgumentsName(save_ptr, save_len)
            IfCondition EqualTo(is_args, 1) ThenBlock: {
                ci = JSComp__AddString(save_ptr, save_len)
                IfCondition EqualTo(JSCompState.in_arrow, 1) ThenBlock: {
                    JSComp__EmitOp16(JSOp.GET_FREE, ci)
                } ElseBlock: {
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ci)
                }
            } ElseBlock: {
                // M74: named class body free-var (class C { m(){ return C } })
                is_cn = 0
                IfCondition And(GreaterThan(JSCompState.class_name_len, 0), EqualTo(JSCompState.class_name_len, save_len)) ThenBlock: {
                    IfCondition EqualTo(JSComp__StrEq(save_ptr, save_len, JSCompState.class_name_ptr, JSCompState.class_name_len), 1) ThenBlock: {
                        is_cn = 1
                    }
                }
                IfCondition EqualTo(is_cn, 1) ThenBlock: {
                    ci = JSComp__AddString(save_ptr, save_len)
                    JSComp__EmitOp16(JSOp.GET_FREE, ci)
                } ElseBlock: {
                owner = JSComp__FindEnclosing(save_ptr, save_len)
                IfCondition GreaterEqual(owner, 0) ThenBlock: {
                    ci = JSComp__AddString(save_ptr, save_len)
                    // M73: always GET_FREE when an enclosing binding exists.
                    // Old IsScriptVar→GET_GLOBAL broke shadowing: nested free-var
                    // of function-local `x` used global when script also had `var x`
                    // (paramsbody + nest_local free-var). script_env dual-write
                    // keeps top-level var/let readable via the parent env chain.
                    JSComp__EmitOp16(JSOp.GET_FREE, ci)
                } ElseBlock: {
                    ci = JSComp__AddString(save_ptr, save_len)
                    JSComp__EmitOp16(JSOp.GET_GLOBAL, ci)
                }
                }
            }
        }
        ReturnValue(0)
    }
}

// M60: mark let/const binding as TDZ on frame/script env so free-var
// GET_FREE/SET_FREE throw ReferenceError (tdz_uninit sentinel).
Function.JSComp__EmitTdzEnvMark {
    Input: name_ptr: Address
    Input: name_len: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        save_ptr = name_ptr
        save_len = name_len
        save_slot = slot
        JSComp__RegisterLetName(save_ptr, save_len)
        JSComp__Emit1(JSOp.PUSH_TDZ_UNINIT)
        ci = JSComp__AddString(save_ptr, save_len)
        JSComp__EmitOp16(JSOp.SET_FRAME_ENV, ci)
        JSComp__Emit1(0)
        JSComp__Emit1(BitwiseAnd(ShiftRight(save_slot, 8), 255))
        JSComp__Emit1(BitwiseAnd(save_slot, 255))
        ReturnValue(0)
    }
}

Function.JSComp__EmitVarSet {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_ptr = name_ptr
        save_len = name_len
        slot = JSComp__FindLocal(save_ptr, save_len)
        // M128e: under with — runtime PutValue (Reference base from GET_WITH)
        IfCondition GreaterThan(JSCompState.with_depth, 0) ThenBlock: {
            ci = JSComp__AddString(save_ptr, save_len)
            JSComp__EmitOp16(JSOp.SET_WITH, ci)
            IfCondition GreaterEqual(slot, 0) ThenBlock: {
                JSComp__Emit1(0)
                JSComp__Emit1(BitwiseAnd(ShiftRight(slot, 8), 255))
                JSComp__Emit1(BitwiseAnd(slot, 255))
            } ElseBlock: {
                JSComp__Emit1(255)
                JSComp__Emit1(255)
                JSComp__Emit1(255)
            }
            ReturnValue(0)
        }
        // M108: named fn-expr name (const_map=2): strict TypeError, sloppy silent no-op
        IfCondition And(GreaterEqual(slot, 0), LessThan(slot, 256)) ThenBlock: {
            IfCondition EqualTo(GetByte(JSCompState.const_map, slot), 2) ThenBlock: {
                IfCondition EqualTo(JSCompState.is_strict, 1) ThenBlock: {
                    JSComp__Emit1(JSOp.THROW_CONST)
                }
                // Leave RHS on stack as assignment result
                ReturnValue(0)
            }
        }
        // M20c: const binding anywhere (local/free/global dual-write)
        IfCondition EqualTo(JSComp__IsConstName(save_ptr, save_len), 1) ThenBlock: {
            JSComp__Emit1(JSOp.THROW_CONST)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(slot, 0) ThenBlock: {
            // M20c: TDZ write → ReferenceError
            IfCondition And(LessThan(slot, 256), EqualTo(GetByte(JSCompState.tdz_map, slot), 1)) ThenBlock: {
                ci = JSComp__AddString(save_ptr, save_len)
                JSComp__EmitOp16(JSOp.THROW_TDZ, ci)
                ReturnValue(0)
            }
            // Top-level: mirror bare global name. M64: for-of/for-in let pattern
            // init skips SET_GLOBAL only for the let/const names themselves so
            // outer var side-effects in defaults still dual-write.
            IfCondition EqualTo(JSCompState.func_nesting, 0) ThenBlock: {
                do_sg = 1
                IfCondition EqualTo(JSCompState.skip_let_global, 1) ThenBlock: {
                    IfCondition EqualTo(JSComp__IsLetName(save_ptr, save_len), 1) ThenBlock: {
                        do_sg = 0
                    }
                    IfCondition EqualTo(JSComp__IsConstName(save_ptr, save_len), 1) ThenBlock: {
                        do_sg = 0
                    }
                }
                IfCondition EqualTo(do_sg, 1) ThenBlock: {
                    JSComp__Emit1(JSOp.DUP)
                    ci = JSComp__AddString(save_ptr, save_len)
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ci)
                }
            }
            // Dual-write into frame/script env for nested free-var reads.
            // M59: also at top-level (script_env) so closures capture lets.
            // Skip "arguments" — VM owns bare global "arguments" per call.
            is_args2 = JSComp__IsArgumentsName(save_ptr, save_len)
            IfCondition EqualTo(is_args2, 0) ThenBlock: {
                JSComp__Emit1(JSOp.DUP)
                ci = JSComp__AddString(save_ptr, save_len)
                JSComp__EmitOp16(JSOp.SET_FRAME_ENV, ci)
                // Mole 16: trailing u16 = local slot for free-var stack sync
                JSComp__Emit1(0)
                JSComp__Emit1(BitwiseAnd(ShiftRight(slot, 8), 255))
                JSComp__Emit1(BitwiseAnd(slot, 255))
            }
            JSComp__EmitOp16(JSOp.SET_LOCAL, slot)
        } ElseBlock: {
            // M74: class name binding is immutable (heritage setHeritage TypeError)
            is_cn_s = 0
            IfCondition And(GreaterThan(JSCompState.class_name_len, 0), EqualTo(JSCompState.class_name_len, save_len)) ThenBlock: {
                IfCondition EqualTo(JSComp__StrEq(save_ptr, save_len, JSCompState.class_name_ptr, JSCompState.class_name_len), 1) ThenBlock: {
                    is_cn_s = 1
                }
            }
            IfCondition EqualTo(is_cn_s, 1) ThenBlock: {
                JSComp__Emit1(JSOp.THROW_CONST)
                ReturnValue(0)
            }
            is_args3 = JSComp__IsArgumentsName(save_ptr, save_len)
            owner = -1
            IfCondition EqualTo(is_args3, 0) ThenBlock: {
                owner = JSComp__FindEnclosing(save_ptr, save_len)
            }
            // M128v: top-level script vars are dual-bound; free-var writers must
            // always SET_GLOBAL (+ SET_FREE when captured). Pass-1 function
            // decls may compile before encl lists script vars — IsScriptVar
            // still forces the dual-bound path (not bare SET_GLOBAL_ASSIGN).
            is_script_v = JSComp__IsScriptVar(save_ptr, save_len)
            IfCondition Or(GreaterEqual(owner, 0), EqualTo(is_script_v, 1)) ThenBlock: {
                // Free var may be const in enclosing scope — still marked on slot
                // via const_map if slot is known; encl path uses name only.
                // M59: also SET_GLOBAL so top-level dual-bound names stay live
                // for GET_GLOBAL (script body / free-var writers in deep nests).
                ci = JSComp__AddString(save_ptr, save_len)
                JSComp__Emit1(JSOp.DUP)
                JSComp__EmitOp16(JSOp.SET_GLOBAL, ci)
                // SET_FREE syncs script_env / __sl_ stack when binding is on cenv
                JSComp__EmitOp16(JSOp.SET_FREE, ci)
            } ElseBlock: {
                ci = JSComp__AddString(save_ptr, save_len)
                IfCondition EqualTo(JSCompState.is_strict, 1) ThenBlock: {
                    JSComp__EmitOp16(JSOp.SET_GLOBAL_ASSIGN, ci)
                } ElseBlock: {
                    JSComp__EmitOp16(JSOp.SET_GLOBAL, ci)
                }
            }
        }
        ReturnValue(0)
    }
}

// M20c: bind stack-top value to dstr target (IDENT / MEMBER_DOT / MEMBER_BRACKET)
Function.JSComp__EmitDstrBind {
    Input: target_node: Integer
    Output: Integer
    Body: {
        save_t = target_node
        IfCondition LessThan(save_t, 0) ThenBlock: {
            JSComp__Emit1(JSOp.POP)
            ReturnValue(0)
        }
        tt = JSParse_GetType(save_t)
        // IDENT
        IfCondition EqualTo(tt, ASTType.IDENT) ThenBlock: {
            tnp = JSParse_GetNamePtr(save_t)
            tnl = JSParse_GetNameLen(save_t)
            JSComp__EmitVarSet(tnp, tnl)
            ReturnValue(0)
        }
        // obj.prop — stack [value]; need [obj, value] for SET_PROP
        IfCondition EqualTo(tt, ASTType.MEMBER_DOT) ThenBlock: {
            pnp = JSParse_GetNamePtr(save_t)
            pnl = JSParse_GetNameLen(save_t)
            obj_n = JSParse_GetLeft(save_t)
            JSComp__Push(pnp)
            JSComp__Push(pnl)
            JSComp__CompileExpr(obj_n)
            pnl = JSComp__Pop()
            pnp = JSComp__Pop()
            JSComp__Emit1(JSOp.SWAP)
            ci = JSComp__AddString(pnp, pnl)
            JSComp__EmitOp16(JSOp.SET_PROP, ci)
            ReturnValue(0)
        }
        // obj[key] — stack [value]; SET_ELEM wants [value, obj, key]
        IfCondition EqualTo(tt, ASTType.MEMBER_BRACKET) ThenBlock: {
            obj_n = JSParse_GetLeft(save_t)
            key_n = JSParse_GetRight(save_t)
            JSComp__Push(key_n)
            JSComp__CompileExpr(obj_n)
            key_n = JSComp__Pop()
            JSComp__CompileExpr(key_n)
            JSComp__Emit1(JSOp.SET_ELEM)
            ReturnValue(0)
        }
        // Fallback: discard value
        JSComp__Emit1(JSOp.POP)
        ReturnValue(0)
    }
}

// =============================================================================
// LOOP STACK — for break/continue
// =============================================================================

// Push a new loop frame: break_patch=-1, continue_target, break_count=0
// M53: also bind open labeled wrappers (can_bind) to this loop depth.
Function.JSComp__PushLoop {
    Input: cont_target: Integer
    Output: Integer
    Body: {
        save_ct = cont_target
        IfCondition GreaterEqual(JSCompState.loop_depth, JSCompConst.MAX_LOOPS) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        base = Add(JSCompState.loop_stack, Multiply(JSCompState.loop_depth, JSCompConst.LOOP_SIZE))
        // break_patch slot (will be patched later)
        StoreValue(base, -1)
        // continue_target
        StoreValue(Add(base, 8), save_ct)
        // M128e6ah: with_depth at loop entry (break/continue emit WITH_POP delta)
        StoreValue(Add(base, 16), JSCompState.with_depth)
        // continue_chain head (-1 = empty)
        StoreValue(Add(base, 24), -1)
        JSCompState.loop_depth = Add(JSCompState.loop_depth, 1)
        // Bind direct labeled wrappers: a: b: while → both bind to this depth
        li = Subtract(JSCompState.label_depth, 1)
        WhileLoop GreaterEqual(li, 0) {
            lbase = Add(JSCompState.label_stack, Multiply(li, JSCompConst.LABEL_SIZE))
            can_bind = Dereference(Add(lbase, 32))
            loop_d = Dereference(Add(lbase, 24))
            // stop at already-bound or non-bindable label
            IfCondition Or(EqualTo(can_bind, 0), NotEqual(loop_d, -1)) ThenBlock: {
                li = -2
            } ElseBlock: {
                StoreValue(Add(lbase, 24), Subtract(JSCompState.loop_depth, 1))
                li = Subtract(li, 1)
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// LABEL STACK — labeled break / continue (M53)
// Frame: +0 name_ptr, +8 name_len, +16 break_chain, +24 loop_depth (-1), +32 can_bind
// =============================================================================
Function.JSComp__PushLabel {
    Input: name_ptr: Address
    Input: name_len: Integer
    Input: can_bind: Integer
    Output: Integer
    Body: {
        save_np = name_ptr
        save_nl = name_len
        save_cb = can_bind
        IfCondition GreaterEqual(JSCompState.label_depth, JSCompConst.MAX_LABELS) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        base = Add(JSCompState.label_stack, Multiply(JSCompState.label_depth, JSCompConst.LABEL_SIZE))
        StoreValue(base, save_np)
        StoreValue(Add(base, 8), save_nl)
        StoreValue(Add(base, 16), -1)
        StoreValue(Add(base, 24), -1)
        StoreValue(Add(base, 32), save_cb)
        JSCompState.label_depth = Add(JSCompState.label_depth, 1)
        ReturnValue(0)
    }
}

// Pop label and patch its break chain to current code_pos
Function.JSComp__PopLabel {
    Output: Integer
    Body: {
        IfCondition LessThan(JSCompState.label_depth, 1) ThenBlock: {
            ReturnValue(-1)
        }
        JSCompState.label_depth = Subtract(JSCompState.label_depth, 1)
        base = Add(JSCompState.label_stack, Multiply(JSCompState.label_depth, JSCompConst.LABEL_SIZE))
        cur = Dereference(Add(base, 16))
        WhileLoop GreaterEqual(cur, 0) {
            b2 = GetByte(JSCompState.code, Add(cur, 1))
            b1 = GetByte(JSCompState.code, Add(cur, 2))
            b0 = GetByte(JSCompState.code, Add(cur, 3))
            prev = Add(Add(Multiply(b2, 65536), Multiply(b1, 256)), b0)
            IfCondition EqualTo(prev, 16777215) ThenBlock: { prev = -1 }
            JSComp__PatchJump(cur)
            cur = prev
        }
        ReturnValue(0)
    }
}

// Find label by name; returns depth index or -1
Function.JSComp__FindLabel {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_np = name_ptr
        save_nl = name_len
        li = Subtract(JSCompState.label_depth, 1)
        WhileLoop GreaterEqual(li, 0) {
            lbase = Add(JSCompState.label_stack, Multiply(li, JSCompConst.LABEL_SIZE))
            lnp = Dereference(lbase)
            lnl = Dereference(Add(lbase, 8))
            match = 0
            IfCondition EqualTo(lnl, save_nl) ThenBlock: {
                match = 1
                bi = 0
                WhileLoop LessThan(bi, save_nl) {
                    IfCondition NotEqual(GetByte(lnp, bi), GetByte(save_np, bi)) ThenBlock: {
                        match = 0
                        bi = save_nl
                    }
                    bi = Add(bi, 1)
                }
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(li)
            }
            li = Subtract(li, 1)
        }
        ReturnValue(-1)
    }
}

// Record a break JMP onto a label's break chain
Function.JSComp__RecordLabelBreak {
    Input: label_idx: Integer
    Input: jmp_addr: Integer
    Output: Integer
    Body: {
        save_li = label_idx
        save_addr = jmp_addr
        IfCondition Or(LessThan(save_li, 0), GreaterEqual(save_li, JSCompState.label_depth)) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        base = Add(JSCompState.label_stack, Multiply(save_li, JSCompConst.LABEL_SIZE))
        old_head = Dereference(Add(base, 16))
        IfCondition LessThan(old_head, 0) ThenBlock: {
            SetByte(JSCompState.code, Add(save_addr, 1), 255)
            SetByte(JSCompState.code, Add(save_addr, 2), 255)
            SetByte(JSCompState.code, Add(save_addr, 3), 255)
        } ElseBlock: {
            b2 = BitwiseAnd(ShiftRight(old_head, 16), 255)
            b1 = BitwiseAnd(ShiftRight(old_head, 8), 255)
            b0 = BitwiseAnd(old_head, 255)
            SetByte(JSCompState.code, Add(save_addr, 1), b2)
            SetByte(JSCompState.code, Add(save_addr, 2), b1)
            SetByte(JSCompState.code, Add(save_addr, 3), b0)
        }
        StoreValue(Add(base, 16), save_addr)
        ReturnValue(0)
    }
}

// =============================================================================
// ITER CLOSE STACK — for-of IteratorClose on return/throw/outer break-continue
// Frame: +0 irec_slot, +8 loop_depth (index of for-of's loop frame)
// =============================================================================
Function.JSComp__PushIterClose {
    Input: irec_slot: Integer
    Input: loop_depth: Integer
    Output: Integer
    Body: {
        save_ir = irec_slot
        save_ld = loop_depth
        IfCondition GreaterEqual(JSCompState.iter_depth, JSCompConst.MAX_ITERS) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        base = Add(JSCompState.iter_stack, Multiply(JSCompState.iter_depth, JSCompConst.ITER_SIZE))
        StoreValue(base, save_ir)
        StoreValue(Add(base, 8), save_ld)
        JSCompState.iter_depth = Add(JSCompState.iter_depth, 1)
        ReturnValue(0)
    }
}

Function.JSComp__PopIterClose {
    Output: Integer
    Body: {
        IfCondition LessThan(JSCompState.iter_depth, 1) ThenBlock: {
            ReturnValue(-1)
        }
        JSCompState.iter_depth = Subtract(JSCompState.iter_depth, 1)
        ReturnValue(0)
    }
}

// Emit ITER_CLOSE for open for-of loops.
// min_depth: close for-of with loop_depth > min_depth (continue) or >= if inclusive=1 (break/return)
// close_kind: 0 normal, 1 throw completion
Function.JSComp__EmitPendingIterClose {
    Input: min_depth: Integer
    Input: inclusive: Integer
    Input: close_kind: Integer
    Output: Integer
    Body: {
        save_min = min_depth
        save_inc = inclusive
        save_ck = close_kind
        IfCondition LessThan(JSCompState.iter_depth, 1) ThenBlock: {
            ReturnValue(0)
        }
        ii = Subtract(JSCompState.iter_depth, 1)
        WhileLoop GreaterEqual(ii, 0) {
            base = Add(JSCompState.iter_stack, Multiply(ii, JSCompConst.ITER_SIZE))
            islot = Dereference(base)
            ild = Dereference(Add(base, 8))
            do_close = 0
            IfCondition EqualTo(save_inc, 1) ThenBlock: {
                IfCondition GreaterEqual(ild, save_min) ThenBlock: { do_close = 1 }
            } ElseBlock: {
                IfCondition GreaterThan(ild, save_min) ThenBlock: { do_close = 1 }
            }
            IfCondition EqualTo(do_close, 1) ThenBlock: {
                JSComp__EmitOp16(JSOp.GET_LOCAL, islot)
                JSComp__EmitOp16(JSOp.ITER_CLOSE, save_ck)
            }
            ii = Subtract(ii, 1)
        }
        ReturnValue(0)
    }
}

// Pop loop frame and patch all break jumps to current code_pos.
// Break addresses form a linked list: each break's 16-bit operand holds
// the address of the previous break (or 0xFFFF = -1 = end of chain).
Function.JSComp__PopLoop {
    Output: Integer
    Body: {
        IfCondition LessThan(JSCompState.loop_depth, 1) ThenBlock: {
            ReturnValue(-1)
        }
        JSCompState.loop_depth = Subtract(JSCompState.loop_depth, 1)
        base = Add(JSCompState.loop_stack, Multiply(JSCompState.loop_depth, JSCompConst.LOOP_SIZE))
        cur = Dereference(base)
        // Walk the break chain and patch each JMP to current code_pos
        WhileLoop GreaterEqual(cur, 0) {
            // Read the 24-bit operand of this JMP (= prev break addr)
            b2 = GetByte(JSCompState.code, Add(cur, 1))
            b1 = GetByte(JSCompState.code, Add(cur, 2))
            b0 = GetByte(JSCompState.code, Add(cur, 3))
            prev = Add(Add(Multiply(b2, 65536), Multiply(b1, 256)), b0)
            // Convert sentinel 16777215 to -1
            IfCondition EqualTo(prev, 16777215) ThenBlock: { prev = -1 }
            // Patch this JMP to jump to current code_pos
            JSComp__PatchJump(cur)
            cur = prev
        }
        ReturnValue(0)
    }
}

// Record a break jump address for the current loop.
// Chains breaks as a linked list through their 24-bit JMP operands.
Function.JSComp__RecordBreak {
    Input: jmp_addr: Integer
    Output: Integer
    Body: {
        save_addr = jmp_addr
        IfCondition LessThan(JSCompState.loop_depth, 1) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        depth_idx = Subtract(JSCompState.loop_depth, 1)
        base = Add(JSCompState.loop_stack, Multiply(depth_idx, JSCompConst.LOOP_SIZE))
        // Read old head of break chain
        old_head = Dereference(base)
        // Encode old_head into this JMP's operand (chain link)
        IfCondition LessThan(old_head, 0) ThenBlock: {
            // End of chain: write 0xFFFFFF sentinel
            SetByte(JSCompState.code, Add(save_addr, 1), 255)
            SetByte(JSCompState.code, Add(save_addr, 2), 255)
            SetByte(JSCompState.code, Add(save_addr, 3), 255)
        } ElseBlock: {
            b2 = BitwiseAnd(ShiftRight(old_head, 16), 255)
            b1 = BitwiseAnd(ShiftRight(old_head, 8), 255)
            b0 = BitwiseAnd(old_head, 255)
            SetByte(JSCompState.code, Add(save_addr, 1), b2)
            SetByte(JSCompState.code, Add(save_addr, 2), b1)
            SetByte(JSCompState.code, Add(save_addr, 3), b0)
        }
        // New head = this break address
        StoreValue(base, save_addr)
        ReturnValue(0)
    }
}

// Get continue target for current loop
Function.JSComp__GetContinueTarget {
    Output: Integer
    Body: {
        IfCondition LessThan(JSCompState.loop_depth, 1) ThenBlock: {
            ReturnValue(-1)
        }
        depth_idx = Subtract(JSCompState.loop_depth, 1)
        base = Add(JSCompState.loop_stack, Multiply(depth_idx, JSCompConst.LOOP_SIZE))
        ReturnValue(Dereference(Add(base, 8)))
    }
}

// Record a continue jump for later patching (for-loop forward continues).
// Chains through the JMP operands just like RecordBreak.
Function.JSComp__RecordContinue {
    Input: jmp_addr: Integer
    Output: Integer
    Body: {
        save_addr = jmp_addr
        IfCondition LessThan(JSCompState.loop_depth, 1) ThenBlock: {
            JSCompState.error = 1
            ReturnValue(-1)
        }
        depth_idx = Subtract(JSCompState.loop_depth, 1)
        base = Add(JSCompState.loop_stack, Multiply(depth_idx, JSCompConst.LOOP_SIZE))
        // Read old head of continue chain (offset 24)
        old_head = Dereference(Add(base, 24))
        // Encode old_head into this JMP's operand (chain link)
        IfCondition LessThan(old_head, 0) ThenBlock: {
            SetByte(JSCompState.code, Add(save_addr, 1), 255)
            SetByte(JSCompState.code, Add(save_addr, 2), 255)
            SetByte(JSCompState.code, Add(save_addr, 3), 255)
        } ElseBlock: {
            b2 = BitwiseAnd(ShiftRight(old_head, 16), 255)
            b1 = BitwiseAnd(ShiftRight(old_head, 8), 255)
            b0 = BitwiseAnd(old_head, 255)
            SetByte(JSCompState.code, Add(save_addr, 1), b2)
            SetByte(JSCompState.code, Add(save_addr, 2), b1)
            SetByte(JSCompState.code, Add(save_addr, 3), b0)
        }
        // New head = this continue address
        StoreValue(Add(base, 24), save_addr)
        ReturnValue(0)
    }
}

// Patch all recorded continue jumps to the current code_pos.
Function.JSComp__PatchContinues {
    Output: Integer
    Body: {
        IfCondition LessThan(JSCompState.loop_depth, 1) ThenBlock: {
            ReturnValue(-1)
        }
        depth_idx = Subtract(JSCompState.loop_depth, 1)
        base = Add(JSCompState.loop_stack, Multiply(depth_idx, JSCompConst.LOOP_SIZE))
        cur = Dereference(Add(base, 24))
        WhileLoop GreaterEqual(cur, 0) {
            b2 = GetByte(JSCompState.code, Add(cur, 1))
            b1 = GetByte(JSCompState.code, Add(cur, 2))
            b0 = GetByte(JSCompState.code, Add(cur, 3))
            prev = Add(Add(Multiply(b2, 65536), Multiply(b1, 256)), b0)
            IfCondition EqualTo(prev, 16777215) ThenBlock: { prev = -1 }
            JSComp__PatchJump(cur)
            cur = prev
        }
        // Clear the chain
        StoreValue(Add(base, 24), -1)
        ReturnValue(0)
    }
}

// =============================================================================
// BINARY OPERATOR MAPPING — token type to bytecode opcode
// =============================================================================
Function.JSComp__MapBinOp {
    Input: tok_type: Integer
    Output: Integer
    Body: {
        save_tt = tok_type
        IfCondition EqualTo(save_tt, JSTokType.PLUS) ThenBlock: { ReturnValue(JSOp.ADD) }
        IfCondition EqualTo(save_tt, JSTokType.MINUS) ThenBlock: { ReturnValue(JSOp.SUB) }
        IfCondition EqualTo(save_tt, JSTokType.STAR) ThenBlock: { ReturnValue(JSOp.MUL) }
        IfCondition EqualTo(save_tt, JSTokType.SLASH) ThenBlock: { ReturnValue(JSOp.DIV) }
        IfCondition EqualTo(save_tt, JSTokType.PERCENT) ThenBlock: { ReturnValue(JSOp.MOD) }
        IfCondition EqualTo(save_tt, JSTokType.STAR_STAR) ThenBlock: { ReturnValue(JSOp.EXP) }
        IfCondition EqualTo(save_tt, JSTokType.EQ) ThenBlock: { ReturnValue(JSOp.EQ) }
        IfCondition EqualTo(save_tt, JSTokType.NEQ) ThenBlock: { ReturnValue(JSOp.NEQ) }
        IfCondition EqualTo(save_tt, JSTokType.STRICT_EQ) ThenBlock: { ReturnValue(JSOp.STRICT_EQ) }
        IfCondition EqualTo(save_tt, JSTokType.STRICT_NEQ) ThenBlock: { ReturnValue(JSOp.STRICT_NEQ) }
        IfCondition EqualTo(save_tt, JSTokType.LT) ThenBlock: { ReturnValue(JSOp.LT) }
        IfCondition EqualTo(save_tt, JSTokType.GT) ThenBlock: { ReturnValue(JSOp.GT) }
        IfCondition EqualTo(save_tt, JSTokType.LTE) ThenBlock: { ReturnValue(JSOp.LTE) }
        IfCondition EqualTo(save_tt, JSTokType.GTE) ThenBlock: { ReturnValue(JSOp.GTE) }
        IfCondition EqualTo(save_tt, JSTokType.AMP) ThenBlock: { ReturnValue(JSOp.BIT_AND) }
        IfCondition EqualTo(save_tt, JSTokType.PIPE) ThenBlock: { ReturnValue(JSOp.BIT_OR) }
        IfCondition EqualTo(save_tt, JSTokType.CARET) ThenBlock: { ReturnValue(JSOp.BIT_XOR) }
        IfCondition EqualTo(save_tt, JSTokType.SHL) ThenBlock: { ReturnValue(JSOp.SHL) }
        IfCondition EqualTo(save_tt, JSTokType.SHR) ThenBlock: { ReturnValue(JSOp.SHR) }
        IfCondition EqualTo(save_tt, JSTokType.USHR) ThenBlock: { ReturnValue(JSOp.USHR) }
        IfCondition EqualTo(save_tt, JSTokType.KW_INSTANCEOF) ThenBlock: { ReturnValue(JSOp.INSTANCEOF) }
        IfCondition EqualTo(save_tt, JSTokType.KW_IN) ThenBlock: { ReturnValue(JSOp.IN) }
        // AND/OR are short-circuit — handled separately in CompileExpr
        ReturnValue(JSOp.NOP)
    }
}

