// Library.JSLexer.ailang — JavaScript lexer/tokenizer
// Tokenizes JS source into a flat token stream for the parser.
// Handles identifiers, numbers, strings, operators, keywords, comments.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils

// =============================================================================
// TOKEN TYPES (~45)
// =============================================================================
FixedPool.JSTokType {
    // Literals & identifiers
    "IDENT":        Initialize=1
    "NUMBER":       Initialize=2
    "STRING":       Initialize=3

    // Punctuation
    "LPAREN":       Initialize=10
    "RPAREN":       Initialize=11
    "LBRACE":       Initialize=12
    "RBRACE":       Initialize=13
    "LBRACKET":     Initialize=14
    "RBRACKET":     Initialize=15
    "SEMI":         Initialize=16
    "COMMA":        Initialize=17
    "DOT":          Initialize=18
    "COLON":        Initialize=19
    "QUESTION":     Initialize=20

    // Operators
    "PLUS":         Initialize=30
    "MINUS":        Initialize=31
    "STAR":         Initialize=32
    "SLASH":        Initialize=33
    "PERCENT":      Initialize=34
    "ASSIGN":       Initialize=35
    "EQ":           Initialize=36
    "STRICT_EQ":    Initialize=37
    "NEQ":          Initialize=38
    "STRICT_NEQ":   Initialize=39
    "LT":           Initialize=40
    "GT":           Initialize=41
    "LTE":          Initialize=42
    "GTE":          Initialize=43
    "AND":          Initialize=44
    "OR":           Initialize=45
    "NOT":          Initialize=46
    "AMP":          Initialize=47
    "PIPE":         Initialize=48
    "CARET":        Initialize=49
    "TILDE":        Initialize=50
    "SHL":          Initialize=51
    "SHR":          Initialize=52
    "PLUS_ASSIGN":  Initialize=53
    "MINUS_ASSIGN": Initialize=54
    "STAR_ASSIGN":  Initialize=55
    "SLASH_ASSIGN": Initialize=56
    "PLUS_PLUS":    Initialize=57
    "MINUS_MINUS":  Initialize=58
    "DOT3":         Initialize=59
    "STAR_STAR":    Initialize=110
    "STAR_STAR_ASSIGN": Initialize=111
    "NULLISH":      Initialize=112
    "NULLISH_ASSIGN": Initialize=113
    "AND_ASSIGN":   Initialize=114
    "OR_ASSIGN":    Initialize=115

    // Keywords
    "KW_VAR":       Initialize=70
    "KW_LET":       Initialize=71
    "KW_CONST":     Initialize=72
    "KW_FUNCTION":  Initialize=73
    "KW_RETURN":    Initialize=74
    "KW_IF":        Initialize=75
    "KW_ELSE":      Initialize=76
    "KW_WHILE":     Initialize=77
    "KW_FOR":       Initialize=78
    "KW_BREAK":     Initialize=79
    "KW_CONTINUE":  Initialize=80
    "KW_TRUE":      Initialize=81
    "KW_FALSE":     Initialize=82
    "KW_NULL":      Initialize=83
    "KW_UNDEFINED": Initialize=84
    "KW_NEW":       Initialize=85
    "KW_THIS":      Initialize=86
    "KW_TYPEOF":    Initialize=87
    "KW_VOID":      Initialize=88
    "KW_DELETE":    Initialize=89
    "KW_IN":        Initialize=90
    "KW_DO":        Initialize=91
    "KW_SWITCH":    Initialize=92
    "KW_CASE":      Initialize=93
    "KW_DEFAULT":   Initialize=94
    "KW_TRY":       Initialize=95
    "KW_CATCH":     Initialize=96
    "KW_FINALLY":   Initialize=97
    "KW_THROW":     Initialize=98

    "USHR":         Initialize=59
    "PERCENT_ASSIGN": Initialize=60
    "AMP_ASSIGN":   Initialize=61
    "PIPE_ASSIGN":  Initialize=62
    "CARET_ASSIGN": Initialize=63
    "SHL_ASSIGN":   Initialize=64
    "SHR_ASSIGN":   Initialize=65
    "USHR_ASSIGN":  Initialize=66
    "ARROW":        Initialize=67
    "KW_INSTANCEOF": Initialize=100
    "KW_YIELD":     Initialize=101
    "KW_CLASS":     Initialize=102
    "KW_EXTENDS":   Initialize=103
    "KW_SUPER":     Initialize=104
    "KW_STATIC":    Initialize=105
    "KW_ASYNC":     Initialize=106
    "KW_AWAIT":     Initialize=107

    // Optional chaining
    "QUESTION_DOT": Initialize=116

    // Private name (#identifier)
    "PRIVATE_NAME": Initialize=120

    // Template literals
    "TMPL_FULL":    Initialize=125
    "TMPL_HEAD":    Initialize=126
    "TMPL_MID":     Initialize=127
    "TMPL_TAIL":    Initialize=128

    // Regex literal
    "REGEX_LIT":    Initialize=130

    // Arrow
    "ARROW":        Initialize=67

    "EOF":          Initialize=199
}

// =============================================================================
// TOKEN STRUCTURE — 32 bytes per token
// =============================================================================
FixedPool.JSTokConst {
    "MAX_TOKENS":  Initialize=262144
    "TOKEN_SIZE":  Initialize=32
    "T_TYPE":      Initialize=0
    "T_PTR":       Initialize=8
    "T_LEN":       Initialize=16
    "T_LINE":      Initialize=24
    "STR_CAP":     Initialize=1048576
}

// =============================================================================
// LEXER STATE
// =============================================================================
FixedPool.JSTokState {
    "tok_pool":   Initialize=0
    "tok_count":  Initialize=0
    "str_buf":    Initialize=0
    "str_pos":    Initialize=0
    "source":     Initialize=0
    "src_len":    Initialize=0
    "pos":        Initialize=0
    "line":       Initialize=1
    "col":        Initialize=1
    "error":      Initialize=0
    "last_type":  Initialize=0
    "div_table":  Initialize=0
    "ctrl_table": Initialize=0
    "paren_stack": Initialize=0
    "paren_sp":   Initialize=0
    "rparen_is_ctrl": Initialize=0
}

// Clobber-safe temporaries for scan loops
FixedPool.JSTokTmp {
    "ch":         Initialize=0
    "ch2":        Initialize=0
    "start":      Initialize=0
    "len":        Initialize=0
    "ptr":        Initialize=0
    "interned":   Initialize=0
    "done":       Initialize=0
    "quote":      Initialize=0
    "val":        Initialize=0
    "tmpl_depth": Initialize=0
    "tmpl_braces": Initialize=0
}

// =============================================================================
// INIT / RESET
// =============================================================================
Function.JSLex_Init {
    Output: Integer
    Body: {
        tsz = Multiply(JSTokConst.MAX_TOKENS, JSTokConst.TOKEN_SIZE)
        JSTokState.tok_pool = Allocate(tsz)
        MemorySet(JSTokState.tok_pool, 0, tsz)
        JSTokState.tok_count = 0

        JSTokState.str_buf = Allocate(JSTokConst.STR_CAP)
        MemorySet(JSTokState.str_buf, 0, JSTokConst.STR_CAP)
        JSTokState.str_pos = 0

        JSTokState.error = 0

        // Allocate and populate division-preceding lookup table (256 bytes)
        // Index = token type, value = 1 means "/" after this token is division
        JSTokState.div_table = Allocate(256)
        MemorySet(JSTokState.div_table, 0, 256)
        SetByte(JSTokState.div_table, 1, 1)    // IDENT
        SetByte(JSTokState.div_table, 2, 1)    // NUMBER
        SetByte(JSTokState.div_table, 3, 1)    // STRING
        SetByte(JSTokState.div_table, 11, 1)   // RPAREN (overridden at runtime for ctrl)
        SetByte(JSTokState.div_table, 13, 1)   // RBRACE
        SetByte(JSTokState.div_table, 15, 1)   // RBRACKET
        SetByte(JSTokState.div_table, 57, 1)   // PLUS_PLUS
        SetByte(JSTokState.div_table, 58, 1)   // MINUS_MINUS
        SetByte(JSTokState.div_table, 81, 1)   // KW_TRUE
        SetByte(JSTokState.div_table, 82, 1)   // KW_FALSE
        SetByte(JSTokState.div_table, 83, 1)   // KW_NULL
        SetByte(JSTokState.div_table, 84, 1)   // KW_UNDEFINED
        SetByte(JSTokState.div_table, 86, 1)   // KW_THIS
        SetByte(JSTokState.div_table, 130, 1)  // REGEX_LIT
        SetByte(JSTokState.div_table, 125, 1)  // TMPL_FULL
        SetByte(JSTokState.div_table, 128, 1)  // TMPL_TAIL

        // Allocate and populate control-flow keyword lookup table (256 bytes)
        // Index = token type, value = 1 means "(" after this is a ctrl paren
        JSTokState.ctrl_table = Allocate(256)
        MemorySet(JSTokState.ctrl_table, 0, 256)
        SetByte(JSTokState.ctrl_table, 75, 1)  // KW_IF
        SetByte(JSTokState.ctrl_table, 77, 1)  // KW_WHILE
        SetByte(JSTokState.ctrl_table, 78, 1)  // KW_FOR
        SetByte(JSTokState.ctrl_table, 91, 1)  // KW_DO
        SetByte(JSTokState.ctrl_table, 92, 1)  // KW_SWITCH
        SetByte(JSTokState.ctrl_table, 96, 1)  // KW_CATCH

        // Paren stack: 256 levels deep, each 1 byte (0=expr paren, 1=ctrl paren)
        JSTokState.paren_stack = Allocate(256)
        MemorySet(JSTokState.paren_stack, 0, 256)
        JSTokState.paren_sp = 0
        JSTokState.rparen_is_ctrl = 0

        ReturnValue(1)
    }
}

Function.JSLex_Reset {
    Output: Integer
    Body: {
        JSTokState.tok_count = 0
        JSTokState.str_pos = 0
        JSTokState.pos = 0
        JSTokState.line = 1
        JSTokState.col = 1
        JSTokState.error = 0
        JSTokState.last_type = 0
        JSTokState.paren_sp = 0
        JSTokState.rparen_is_ctrl = 0
        ReturnValue(0)
    }
}

// =============================================================================
// STRING INTERNING — copies token text into contiguous buffer
// =============================================================================
Function.JSLex__Intern {
    Input: src: Address
    Input: len: Integer
    Output: Address
    Body: {
        needed = Add(JSTokState.str_pos, Add(len, 1))
        IfCondition GreaterEqual(needed, JSTokConst.STR_CAP) ThenBlock: {
            ReturnValue(0)
        }
        dest = Add(JSTokState.str_buf, JSTokState.str_pos)
        MemoryCopy(dest, src, len)
        SetByte(dest, len, 0)
        JSTokState.str_pos = Add(JSTokState.str_pos, Add(len, 1))
        ReturnValue(dest)
    }
}

// =============================================================================
// TOKEN EMISSION — writes token to pool
// =============================================================================
Function.JSLex__AddToken {
    Input: ttype: Integer
    Input: ptr: Address
    Input: len: Integer
    Output: Integer
    Body: {
        idx = JSTokState.tok_count
        IfCondition GreaterEqual(idx, JSTokConst.MAX_TOKENS) ThenBlock: {
            ReturnValue(-1)
        }
        save_type = ttype
        save_ptr = ptr
        save_len = len
        JSTokState.tok_count = Add(idx, 1)
        base = Add(JSTokState.tok_pool, Multiply(idx, JSTokConst.TOKEN_SIZE))
        StoreValue(Add(base, JSTokConst.T_TYPE), save_type)
        StoreValue(Add(base, JSTokConst.T_PTR), save_ptr)
        StoreValue(Add(base, JSTokConst.T_LEN), save_len)
        StoreValue(Add(base, JSTokConst.T_LINE), JSTokState.line)
        JSTokState.last_type = save_type
        ReturnValue(idx)
    }
}

// =============================================================================
// CHARACTER NAVIGATION
// =============================================================================
Function.JSLex__Peek {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(JSTokState.pos, JSTokState.src_len) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(GetByte(JSTokState.source, JSTokState.pos))
    }
}

Function.JSLex__PeekAt {
    Input: offset: Integer
    Output: Integer
    Body: {
        p = Add(JSTokState.pos, offset)
        IfCondition GreaterEqual(p, JSTokState.src_len) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(GetByte(JSTokState.source, p))
    }
}

Function.JSLex__Advance {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(JSTokState.pos, JSTokState.src_len) ThenBlock: {
            ReturnValue(0)
        }
        ch = GetByte(JSTokState.source, JSTokState.pos)
        JSTokState.pos = Add(JSTokState.pos, 1)
        IfCondition EqualTo(ch, 10) ThenBlock: {
            JSTokState.line = Add(JSTokState.line, 1)
            JSTokState.col = 1
        }
        IfCondition NotEqual(ch, 10) ThenBlock: {
            JSTokState.col = Add(JSTokState.col, 1)
        }
        ReturnValue(ch)
    }
}

// =============================================================================
// SKIP WHITESPACE — spaces, tabs, newlines (track line numbers)
// =============================================================================
Function.JSLex__SkipWS {
    Output: Integer
    Body: {
        JSTokTmp.ch = JSLex__Peek()
        WhileLoop Or(Or(EqualTo(JSTokTmp.ch, 32), EqualTo(JSTokTmp.ch, 9)),
                     Or(EqualTo(JSTokTmp.ch, 10), EqualTo(JSTokTmp.ch, 13))) {
            JSLex__Advance()
            JSTokTmp.ch = JSLex__Peek()
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SKIP LINE COMMENT — // to end of line
// =============================================================================
Function.JSLex__SkipLineComment {
    Output: Integer
    Body: {
        // Consume the two '/' chars
        JSLex__Advance()
        JSLex__Advance()
        JSTokTmp.ch = JSLex__Peek()
        WhileLoop And(NotEqual(JSTokTmp.ch, 10), NotEqual(JSTokTmp.ch, 0)) {
            JSLex__Advance()
            JSTokTmp.ch = JSLex__Peek()
        }
        // Consume the newline if present
        IfCondition EqualTo(JSTokTmp.ch, 10) ThenBlock: {
            JSLex__Advance()
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SKIP BLOCK COMMENT — /* to */
// =============================================================================
Function.JSLex__SkipBlockComment {
    Output: Integer
    Body: {
        // Consume /*
        JSLex__Advance()
        JSLex__Advance()
        JSTokTmp.done = 0
        WhileLoop EqualTo(JSTokTmp.done, 0) {
            JSTokTmp.ch = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch, 0) ThenBlock: {
                // Unterminated block comment — stop scanning
                JSTokTmp.done = 1
            }
            IfCondition EqualTo(JSTokTmp.ch, 42) ThenBlock: {
                // '*' — check for '/'
                JSTokTmp.ch2 = JSLex__PeekAt(1)
                IfCondition EqualTo(JSTokTmp.ch2, 47) ThenBlock: {
                    // Consume */
                    JSLex__Advance()
                    JSLex__Advance()
                    JSTokTmp.done = 1
                }
            }
            IfCondition EqualTo(JSTokTmp.done, 0) ThenBlock: {
                JSLex__Advance()
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// CHARACTER CLASSIFICATION
// =============================================================================
Function.JSLex__IsAlpha {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSLex__IsDigit {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Check if char is valid identifier start: [a-zA-Z_$] or non-ASCII (>= 128) or backslash (92)
Function.JSLex__IsIdentStart {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 95) ThenBlock: { ReturnValue(1) }   // underscore
        IfCondition EqualTo(ch, 36) ThenBlock: { ReturnValue(1) }   // dollar sign
        IfCondition EqualTo(ch, 92) ThenBlock: { ReturnValue(1) }   // backslash (unicode escape)
        IfCondition GreaterEqual(ch, 128) ThenBlock: { ReturnValue(1) } // non-ASCII UTF-8
        ReturnValue(0)
    }
}

// Check if char is valid identifier continuation: [a-zA-Z0-9_$] or non-ASCII (>= 128) or backslash (92)
Function.JSLex__IsIdentCont {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 95) ThenBlock: { ReturnValue(1) }   // underscore
        IfCondition EqualTo(ch, 36) ThenBlock: { ReturnValue(1) }   // dollar sign
        IfCondition EqualTo(ch, 92) ThenBlock: { ReturnValue(1) }   // backslash (unicode escape)
        IfCondition GreaterEqual(ch, 128) ThenBlock: { ReturnValue(1) } // non-ASCII UTF-8
        ReturnValue(0)
    }
}

// Decode a single hex digit to its numeric value (0-15), or -1 if invalid
Function.JSLex__HexVal {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: { ReturnValue(Subtract(ch, 48)) }
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: { ReturnValue(Add(Subtract(ch, 97), 10)) }
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: { ReturnValue(Add(Subtract(ch, 65), 10)) }
        ReturnValue(-1)
    }
}

// Encode a Unicode codepoint into UTF-8 bytes in a buffer.
// Returns number of bytes written (1-4).
// NOTE: must use BitwiseOr/BitwiseAnd — logical Or/And collapse to 0/1.
Function.JSLex__EncodeUTF8 {
    Input: buf: Address
    Input: offset: Integer
    Input: cp: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(cp, 128) ThenBlock: {
            SetByte(buf, offset, cp)
            ReturnValue(1)
        }
        IfCondition LessThan(cp, 2048) ThenBlock: {
            SetByte(buf, offset, BitwiseOr(192, ShiftRight(cp, 6)))
            SetByte(buf, Add(offset, 1), BitwiseOr(128, BitwiseAnd(cp, 63)))
            ReturnValue(2)
        }
        IfCondition LessThan(cp, 65536) ThenBlock: {
            SetByte(buf, offset, BitwiseOr(224, ShiftRight(cp, 12)))
            SetByte(buf, Add(offset, 1), BitwiseOr(128, BitwiseAnd(ShiftRight(cp, 6), 63)))
            SetByte(buf, Add(offset, 2), BitwiseOr(128, BitwiseAnd(cp, 63)))
            ReturnValue(3)
        }
        // 4-byte (codepoints above U+FFFF)
        SetByte(buf, offset, BitwiseOr(240, ShiftRight(cp, 18)))
        SetByte(buf, Add(offset, 1), BitwiseOr(128, BitwiseAnd(ShiftRight(cp, 12), 63)))
        SetByte(buf, Add(offset, 2), BitwiseOr(128, BitwiseAnd(ShiftRight(cp, 6), 63)))
        SetByte(buf, Add(offset, 3), BitwiseOr(128, BitwiseAnd(cp, 63)))
        ReturnValue(4)
    }
}

// =============================================================================
// KEYWORD MATCHING — compare interned identifier against all JS keywords
// Returns keyword token type, or JSTokType.IDENT if not a keyword.
// Uses StringCompare on null-terminated interned strings.
// =============================================================================
Function.JSLex__MatchKeyword {
    Input: ptr: Address
    Input: len: Integer
    Output: Integer
    Body: {
        // Dispatch on length for fast rejection, then StringCompare

        // --- Length 2 ---
        IfCondition EqualTo(len, 2) ThenBlock: {
            // "if"  105 102
            IfCondition And(EqualTo(GetByte(ptr, 0), 105), EqualTo(GetByte(ptr, 1), 102)) ThenBlock: {
                ReturnValue(JSTokType.KW_IF)
            }
            // "in"  105 110
            IfCondition And(EqualTo(GetByte(ptr, 0), 105), EqualTo(GetByte(ptr, 1), 110)) ThenBlock: {
                ReturnValue(JSTokType.KW_IN)
            }
            // "do"  100 111
            IfCondition And(EqualTo(GetByte(ptr, 0), 100), EqualTo(GetByte(ptr, 1), 111)) ThenBlock: {
                ReturnValue(JSTokType.KW_DO)
            }
        }

        // --- Length 3 ---
        IfCondition EqualTo(len, 3) ThenBlock: {
            // "var"  118 97 114
            IfCondition And(EqualTo(GetByte(ptr, 0), 118), EqualTo(GetByte(ptr, 1), 97)) ThenBlock: {
                IfCondition EqualTo(GetByte(ptr, 2), 114) ThenBlock: {
                    ReturnValue(JSTokType.KW_VAR)
                }
            }
            // "let"  108 101 116
            IfCondition And(EqualTo(GetByte(ptr, 0), 108), EqualTo(GetByte(ptr, 1), 101)) ThenBlock: {
                IfCondition EqualTo(GetByte(ptr, 2), 116) ThenBlock: {
                    ReturnValue(JSTokType.KW_LET)
                }
            }
            // "for"  102 111 114
            IfCondition And(EqualTo(GetByte(ptr, 0), 102), EqualTo(GetByte(ptr, 1), 111)) ThenBlock: {
                IfCondition EqualTo(GetByte(ptr, 2), 114) ThenBlock: {
                    ReturnValue(JSTokType.KW_FOR)
                }
            }
            // "new"  110 101 119
            IfCondition And(EqualTo(GetByte(ptr, 0), 110), EqualTo(GetByte(ptr, 1), 101)) ThenBlock: {
                IfCondition EqualTo(GetByte(ptr, 2), 119) ThenBlock: {
                    ReturnValue(JSTokType.KW_NEW)
                }
            }
            // "try"  116 114 121
            IfCondition And(EqualTo(GetByte(ptr, 0), 116), EqualTo(GetByte(ptr, 1), 114)) ThenBlock: {
                IfCondition EqualTo(GetByte(ptr, 2), 121) ThenBlock: {
                    ReturnValue(JSTokType.KW_TRY)
                }
            }
        }

        // --- Length 4 ---
        IfCondition EqualTo(len, 4) ThenBlock: {
            c0 = GetByte(ptr, 0)
            c1 = GetByte(ptr, 1)
            // "else"  101 108 115 101
            IfCondition And(EqualTo(c0, 101), EqualTo(c1, 108)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 115), EqualTo(GetByte(ptr, 3), 101)) ThenBlock: {
                    ReturnValue(JSTokType.KW_ELSE)
                }
            }
            // "true"  116 114 117 101
            IfCondition And(EqualTo(c0, 116), EqualTo(c1, 114)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 117), EqualTo(GetByte(ptr, 3), 101)) ThenBlock: {
                    ReturnValue(JSTokType.KW_TRUE)
                }
            }
            // "null"  110 117 108 108
            IfCondition And(EqualTo(c0, 110), EqualTo(c1, 117)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 108), EqualTo(GetByte(ptr, 3), 108)) ThenBlock: {
                    ReturnValue(JSTokType.KW_NULL)
                }
            }
            // "this"  116 104 105 115
            IfCondition And(EqualTo(c0, 116), EqualTo(c1, 104)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 105), EqualTo(GetByte(ptr, 3), 115)) ThenBlock: {
                    ReturnValue(JSTokType.KW_THIS)
                }
            }
            // "void"  118 111 105 100
            IfCondition And(EqualTo(c0, 118), EqualTo(c1, 111)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 105), EqualTo(GetByte(ptr, 3), 100)) ThenBlock: {
                    ReturnValue(JSTokType.KW_VOID)
                }
            }
            // "case"  99 97 115 101
            IfCondition And(EqualTo(c0, 99), EqualTo(c1, 97)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 115), EqualTo(GetByte(ptr, 3), 101)) ThenBlock: {
                    ReturnValue(JSTokType.KW_CASE)
                }
            }
        }

        // --- Length 5 ---
        IfCondition EqualTo(len, 5) ThenBlock: {
            c0 = GetByte(ptr, 0)
            c1 = GetByte(ptr, 1)
            // "const"  99 111 110 115 116
            IfCondition And(EqualTo(c0, 99), EqualTo(c1, 111)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 110), EqualTo(GetByte(ptr, 3), 115)) ThenBlock: {
                    IfCondition EqualTo(GetByte(ptr, 4), 116) ThenBlock: {
                        ReturnValue(JSTokType.KW_CONST)
                    }
                }
            }
            // "while"  119 104 105 108 101
            IfCondition And(EqualTo(c0, 119), EqualTo(c1, 104)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 105), EqualTo(GetByte(ptr, 3), 108)) ThenBlock: {
                    IfCondition EqualTo(GetByte(ptr, 4), 101) ThenBlock: {
                        ReturnValue(JSTokType.KW_WHILE)
                    }
                }
            }
            // "break"  98 114 101 97 107
            IfCondition And(EqualTo(c0, 98), EqualTo(c1, 114)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 101), EqualTo(GetByte(ptr, 3), 97)) ThenBlock: {
                    IfCondition EqualTo(GetByte(ptr, 4), 107) ThenBlock: {
                        ReturnValue(JSTokType.KW_BREAK)
                    }
                }
            }
            // "false"  102 97 108 115 101
            IfCondition And(EqualTo(c0, 102), EqualTo(c1, 97)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 108), EqualTo(GetByte(ptr, 3), 115)) ThenBlock: {
                    IfCondition EqualTo(GetByte(ptr, 4), 101) ThenBlock: {
                        ReturnValue(JSTokType.KW_FALSE)
                    }
                }
            }
            // "throw"  116 104 114 111 119
            IfCondition And(EqualTo(c0, 116), EqualTo(c1, 104)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 114), EqualTo(GetByte(ptr, 3), 111)) ThenBlock: {
                    IfCondition EqualTo(GetByte(ptr, 4), 119) ThenBlock: {
                        ReturnValue(JSTokType.KW_THROW)
                    }
                }
            }
            // "catch"  99 97 116 99 104
            IfCondition And(EqualTo(c0, 99), EqualTo(c1, 97)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 116), EqualTo(GetByte(ptr, 3), 99)) ThenBlock: {
                    IfCondition EqualTo(GetByte(ptr, 4), 104) ThenBlock: {
                        ReturnValue(JSTokType.KW_CATCH)
                    }
                }
            }
            // "yield"  121 105 101 108 100
            IfCondition And(EqualTo(c0, 121), EqualTo(c1, 105)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 101), EqualTo(GetByte(ptr, 3), 108)) ThenBlock: {
                    IfCondition EqualTo(GetByte(ptr, 4), 100) ThenBlock: {
                        ReturnValue(JSTokType.KW_YIELD)
                    }
                }
            }
            // "class"  99 108 97 115 115
            IfCondition And(EqualTo(c0, 99), EqualTo(c1, 108)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 97), EqualTo(GetByte(ptr, 3), 115)) ThenBlock: {
                    IfCondition EqualTo(GetByte(ptr, 4), 115) ThenBlock: {
                        ReturnValue(JSTokType.KW_CLASS)
                    }
                }
            }
            // "super"  115 117 112 101 114
            IfCondition And(EqualTo(c0, 115), EqualTo(c1, 117)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 112), EqualTo(GetByte(ptr, 3), 101)) ThenBlock: {
                    IfCondition EqualTo(GetByte(ptr, 4), 114) ThenBlock: {
                        ReturnValue(JSTokType.KW_SUPER)
                    }
                }
            }
            // "async"  97 115 121 110 99
            IfCondition And(EqualTo(c0, 97), EqualTo(c1, 115)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 121), EqualTo(GetByte(ptr, 3), 110)) ThenBlock: {
                    IfCondition EqualTo(GetByte(ptr, 4), 99) ThenBlock: {
                        ReturnValue(JSTokType.KW_ASYNC)
                    }
                }
            }
            // "await"  97 119 97 105 116
            IfCondition And(EqualTo(c0, 97), EqualTo(c1, 119)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 97), EqualTo(GetByte(ptr, 3), 105)) ThenBlock: {
                    IfCondition EqualTo(GetByte(ptr, 4), 116) ThenBlock: {
                        ReturnValue(JSTokType.KW_AWAIT)
                    }
                }
            }
        }

        // --- Length 6 ---
        IfCondition EqualTo(len, 6) ThenBlock: {
            c0 = GetByte(ptr, 0)
            c1 = GetByte(ptr, 1)
            // "return"  114 101 116 117 114 110
            IfCondition And(EqualTo(c0, 114), EqualTo(c1, 101)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 116), EqualTo(GetByte(ptr, 3), 117)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 114), EqualTo(GetByte(ptr, 5), 110)) ThenBlock: {
                        ReturnValue(JSTokType.KW_RETURN)
                    }
                }
            }
            // "typeof"  116 121 112 101 111 102
            IfCondition And(EqualTo(c0, 116), EqualTo(c1, 121)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 112), EqualTo(GetByte(ptr, 3), 101)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 111), EqualTo(GetByte(ptr, 5), 102)) ThenBlock: {
                        ReturnValue(JSTokType.KW_TYPEOF)
                    }
                }
            }
            // "delete"  100 101 108 101 116 101
            IfCondition And(EqualTo(c0, 100), EqualTo(c1, 101)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 108), EqualTo(GetByte(ptr, 3), 101)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 116), EqualTo(GetByte(ptr, 5), 101)) ThenBlock: {
                        ReturnValue(JSTokType.KW_DELETE)
                    }
                }
            }
            // "switch"  115 119 105 116 99 104
            IfCondition And(EqualTo(c0, 115), EqualTo(c1, 119)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 105), EqualTo(GetByte(ptr, 3), 116)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 99), EqualTo(GetByte(ptr, 5), 104)) ThenBlock: {
                        ReturnValue(JSTokType.KW_SWITCH)
                    }
                }
            }
            // "static"  115 116 97 116 105 99
            IfCondition And(EqualTo(c0, 115), EqualTo(c1, 116)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 97), EqualTo(GetByte(ptr, 3), 116)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 105), EqualTo(GetByte(ptr, 5), 99)) ThenBlock: {
                        ReturnValue(JSTokType.KW_STATIC)
                    }
                }
            }
        }

        // --- Length 7 ---
        IfCondition EqualTo(len, 7) ThenBlock: {
            c0 = GetByte(ptr, 0)
            c1 = GetByte(ptr, 1)
            // "default"  100 101 102 97 117 108 116
            IfCondition And(EqualTo(c0, 100), EqualTo(c1, 101)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 102), EqualTo(GetByte(ptr, 3), 97)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 117), EqualTo(GetByte(ptr, 5), 108)) ThenBlock: {
                        IfCondition EqualTo(GetByte(ptr, 6), 116) ThenBlock: {
                            ReturnValue(JSTokType.KW_DEFAULT)
                        }
                    }
                }
            }
            // "finally"  102 105 110 97 108 108 121
            IfCondition And(EqualTo(c0, 102), EqualTo(c1, 105)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 110), EqualTo(GetByte(ptr, 3), 97)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 108), EqualTo(GetByte(ptr, 5), 108)) ThenBlock: {
                        IfCondition EqualTo(GetByte(ptr, 6), 121) ThenBlock: {
                            ReturnValue(JSTokType.KW_FINALLY)
                        }
                    }
                }
            }
            // "extends"  101 120 116 101 110 100 115
            IfCondition And(EqualTo(c0, 101), EqualTo(c1, 120)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 116), EqualTo(GetByte(ptr, 3), 101)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 110), EqualTo(GetByte(ptr, 5), 100)) ThenBlock: {
                        IfCondition EqualTo(GetByte(ptr, 6), 115) ThenBlock: {
                            ReturnValue(JSTokType.KW_EXTENDS)
                        }
                    }
                }
            }
        }

        // --- Length 8 ---
        IfCondition EqualTo(len, 8) ThenBlock: {
            c0 = GetByte(ptr, 0)
            c1 = GetByte(ptr, 1)
            // "function"  102 117 110 99 116 105 111 110
            IfCondition And(EqualTo(c0, 102), EqualTo(c1, 117)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 110), EqualTo(GetByte(ptr, 3), 99)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 116), EqualTo(GetByte(ptr, 5), 105)) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(ptr, 6), 111), EqualTo(GetByte(ptr, 7), 110)) ThenBlock: {
                            ReturnValue(JSTokType.KW_FUNCTION)
                        }
                    }
                }
            }
            // "continue"  99 111 110 116 105 110 117 101
            IfCondition And(EqualTo(c0, 99), EqualTo(c1, 111)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 110), EqualTo(GetByte(ptr, 3), 116)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 105), EqualTo(GetByte(ptr, 5), 110)) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(ptr, 6), 117), EqualTo(GetByte(ptr, 7), 101)) ThenBlock: {
                            ReturnValue(JSTokType.KW_CONTINUE)
                        }
                    }
                }
            }
        }

        // --- Length 9 ---
        IfCondition EqualTo(len, 9) ThenBlock: {
            // "undefined"  117 110 100 101 102 105 110 101 100
            IfCondition And(EqualTo(GetByte(ptr, 0), 117), EqualTo(GetByte(ptr, 1), 110)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 100), EqualTo(GetByte(ptr, 3), 101)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 102), EqualTo(GetByte(ptr, 5), 105)) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(ptr, 6), 110), EqualTo(GetByte(ptr, 7), 101)) ThenBlock: {
                            IfCondition EqualTo(GetByte(ptr, 8), 100) ThenBlock: {
                                ReturnValue(JSTokType.KW_UNDEFINED)
                            }
                        }
                    }
                }
            }
        }

        // --- Length 10 ---
        IfCondition EqualTo(len, 10) ThenBlock: {
            // "instanceof"  105 110 115 116 97 110 99 101 111 102
            IfCondition And(EqualTo(GetByte(ptr, 0), 105), EqualTo(GetByte(ptr, 1), 110)) ThenBlock: {
                IfCondition And(EqualTo(GetByte(ptr, 2), 115), EqualTo(GetByte(ptr, 3), 116)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(ptr, 4), 97), EqualTo(GetByte(ptr, 5), 110)) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(ptr, 6), 99), EqualTo(GetByte(ptr, 7), 101)) ThenBlock: {
                            IfCondition And(EqualTo(GetByte(ptr, 8), 111), EqualTo(GetByte(ptr, 9), 102)) ThenBlock: {
                                ReturnValue(JSTokType.KW_INSTANCEOF)
                            }
                        }
                    }
                }
            }
        }

        // Not a keyword — return IDENT
        ReturnValue(JSTokType.IDENT)
    }
}

// =============================================================================
// SCAN IDENTIFIER — [a-zA-Z_$\u...][a-zA-Z0-9_$\u...]*
// Handles \uXXXX and \u{XXXX} unicode escapes in identifier names.
// Decoded identifier is built in the intern buffer. Emits IDENT or KW_*.
// =============================================================================
Function.JSLex__ScanIdent {
    Output: Integer
    Body: {
        JSTokTmp.start = JSTokState.pos
        // Quick scan: check if there are any backslashes or non-ASCII bytes
        has_escape = 0
        scan_pos = JSTokState.pos
        scan_ch = JSLex__Peek()
        WhileLoop EqualTo(JSLex__IsIdentCont(scan_ch), 1) {
            IfCondition Or(EqualTo(scan_ch, 92), GreaterEqual(scan_ch, 128)) ThenBlock: {
                has_escape = 1
            }
            JSLex__Advance()
            scan_ch = JSLex__Peek()
        }

        IfCondition EqualTo(has_escape, 0) ThenBlock: {
            // Fast path — no escapes, no non-ASCII, just intern raw bytes
            JSTokTmp.len = Subtract(JSTokState.pos, JSTokTmp.start)
            IfCondition EqualTo(JSTokTmp.len, 0) ThenBlock: {
                ReturnValue(0)
            }
            JSTokTmp.interned = JSLex__Intern(Add(JSTokState.source, JSTokTmp.start), JSTokTmp.len)
            kw_type = JSLex__MatchKeyword(JSTokTmp.interned, JSTokTmp.len)
            JSLex__AddToken(kw_type, JSTokTmp.interned, JSTokTmp.len)
            ReturnValue(1)
        }

        // Slow path — decode escapes into intern buffer
        // Reset pos to re-scan with decoding
        JSTokState.pos = JSTokTmp.start
        dest = Add(JSTokState.str_buf, JSTokState.str_pos)
        di = 0
        id_ch = GetByte(JSTokState.source, JSTokState.pos)

        WhileLoop EqualTo(JSLex__IsIdentCont(id_ch), 1) {
            IfCondition EqualTo(id_ch, 92) ThenBlock: {
                // Backslash — expect \uXXXX or \u{XXXX}
                JSTokState.pos = Add(JSTokState.pos, 1)
                u_ch = GetByte(JSTokState.source, JSTokState.pos)
                IfCondition EqualTo(u_ch, 117) ThenBlock: {
                    // 'u' — unicode escape
                    JSTokState.pos = Add(JSTokState.pos, 1)
                    brace_ch = GetByte(JSTokState.source, JSTokState.pos)
                    IfCondition EqualTo(brace_ch, 123) ThenBlock: {
                        // \u{XXXX} — braced form, 1-6 hex digits
                        JSTokState.pos = Add(JSTokState.pos, 1)
                        cp = 0
                        hex_ch = GetByte(JSTokState.source, JSTokState.pos)
                        WhileLoop And(NotEqual(hex_ch, 125), NotEqual(hex_ch, 0)) {
                            hv = JSLex__HexVal(hex_ch)
                            IfCondition EqualTo(hv, -1) ThenBlock: {
                                JSTokState.error = 1
                                ReturnValue(0)
                            }
                            cp = Add(Multiply(cp, 16), hv)
                            JSTokState.pos = Add(JSTokState.pos, 1)
                            hex_ch = GetByte(JSTokState.source, JSTokState.pos)
                        }
                        // Skip closing }
                        IfCondition EqualTo(hex_ch, 125) ThenBlock: {
                            JSTokState.pos = Add(JSTokState.pos, 1)
                        }
                        // Encode codepoint as UTF-8 into dest
                        n_bytes = JSLex__EncodeUTF8(dest, di, cp)
                        di = Add(di, n_bytes)
                    } ElseBlock: {
                        // \uXXXX — exactly 4 hex digits
                        cp = 0
                        esc_i = 0
                        WhileLoop LessThan(esc_i, 4) {
                            hex_ch = GetByte(JSTokState.source, JSTokState.pos)
                            hv = JSLex__HexVal(hex_ch)
                            IfCondition EqualTo(hv, -1) ThenBlock: {
                                JSTokState.error = 1
                                ReturnValue(0)
                            }
                            cp = Add(Multiply(cp, 16), hv)
                            JSTokState.pos = Add(JSTokState.pos, 1)
                            esc_i = Add(esc_i, 1)
                        }
                        n_bytes = JSLex__EncodeUTF8(dest, di, cp)
                        di = Add(di, n_bytes)
                    }
                } ElseBlock: {
                    // Invalid escape in identifier — just emit the backslash
                    SetByte(dest, di, 92)
                    di = Add(di, 1)
                }
            } ElseBlock: {
                // Regular character (ASCII or non-ASCII) — copy byte
                SetByte(dest, di, id_ch)
                di = Add(di, 1)
                JSTokState.pos = Add(JSTokState.pos, 1)
            }
            IfCondition GreaterEqual(JSTokState.pos, JSTokState.src_len) ThenBlock: {
                id_ch = 0
            } ElseBlock: {
                id_ch = GetByte(JSTokState.source, JSTokState.pos)
            }
        }

        // Null-terminate and update str_pos
        SetByte(dest, di, 0)
        JSTokTmp.interned = dest
        JSTokTmp.len = di
        JSTokState.str_pos = Add(JSTokState.str_pos, Add(di, 1))
        // Check if it is a keyword
        kw_type = JSLex__MatchKeyword(JSTokTmp.interned, JSTokTmp.len)
        JSLex__AddToken(kw_type, JSTokTmp.interned, JSTokTmp.len)
        ReturnValue(1)
    }
}

// =============================================================================
// SCAN NUMBER — integer, float, hex (0x...), octal (0o..), binary (0b..)
// Float decimal part is consumed but truncated to integer at parse time.
// =============================================================================
Function.JSLex__IsHexDigit {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSLex__ScanNumber {
    Output: Integer
    Body: {
        JSTokTmp.start = JSTokState.pos

        // Check for 0x (hex), 0o (octal), 0b (binary) prefix
        JSTokTmp.ch = JSLex__Peek()
        IfCondition EqualTo(JSTokTmp.ch, 48) ThenBlock: {
            JSTokTmp.ch2 = JSLex__PeekAt(1)

            // --- 0x / 0X hex ---
            IfCondition Or(EqualTo(JSTokTmp.ch2, 120), EqualTo(JSTokTmp.ch2, 88)) ThenBlock: {
                JSLex__Advance()
                JSLex__Advance()
                JSTokTmp.ch = JSLex__Peek()
                // Reject _ immediately after 0x prefix
                IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                    JSTokState.error = 1
                    ReturnValue(0)
                }
                ns_prev_us = 0
                JSTokTmp.done = Or(JSLex__IsHexDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
                WhileLoop EqualTo(JSTokTmp.done, 1) {
                    IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                        // Reject double underscore
                        IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                            JSTokState.error = 1
                            ReturnValue(0)
                        }
                        ns_prev_us = 1
                    } ElseBlock: {
                        ns_prev_us = 0
                    }
                    JSLex__Advance()
                    JSTokTmp.ch = JSLex__Peek()
                    JSTokTmp.done = Or(JSLex__IsHexDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
                }
                // Reject trailing underscore
                IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                    JSTokState.error = 1
                    ReturnValue(0)
                }
                JSTokTmp.len = Subtract(JSTokState.pos, JSTokTmp.start)
                JSTokTmp.interned = JSLex__Intern(Add(JSTokState.source, JSTokTmp.start), JSTokTmp.len)
                JSLex__AddToken(JSTokType.NUMBER, JSTokTmp.interned, JSTokTmp.len)
                ReturnValue(1)
            }

            // --- 0o / 0O octal ---
            IfCondition Or(EqualTo(JSTokTmp.ch2, 111), EqualTo(JSTokTmp.ch2, 79)) ThenBlock: {
                JSLex__Advance()
                JSLex__Advance()
                JSTokTmp.ch = JSLex__Peek()
                // Reject _ immediately after 0o prefix
                IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                    JSTokState.error = 1
                    ReturnValue(0)
                }
                ns_prev_us = 0
                WhileLoop Or(And(GreaterEqual(JSTokTmp.ch, 48), LessEqual(JSTokTmp.ch, 55)), EqualTo(JSTokTmp.ch, 95)) {
                    IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                        IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                            JSTokState.error = 1
                            ReturnValue(0)
                        }
                        ns_prev_us = 1
                    } ElseBlock: {
                        ns_prev_us = 0
                    }
                    JSLex__Advance()
                    JSTokTmp.ch = JSLex__Peek()
                }
                // Reject trailing underscore
                IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                    JSTokState.error = 1
                    ReturnValue(0)
                }
                JSTokTmp.len = Subtract(JSTokState.pos, JSTokTmp.start)
                JSTokTmp.interned = JSLex__Intern(Add(JSTokState.source, JSTokTmp.start), JSTokTmp.len)
                JSLex__AddToken(JSTokType.NUMBER, JSTokTmp.interned, JSTokTmp.len)
                ReturnValue(1)
            }

            // --- 0b / 0B binary ---
            IfCondition Or(EqualTo(JSTokTmp.ch2, 98), EqualTo(JSTokTmp.ch2, 66)) ThenBlock: {
                JSLex__Advance()
                JSLex__Advance()
                JSTokTmp.ch = JSLex__Peek()
                // Reject _ immediately after 0b prefix
                IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                    JSTokState.error = 1
                    ReturnValue(0)
                }
                ns_prev_us = 0
                WhileLoop Or(Or(EqualTo(JSTokTmp.ch, 48), EqualTo(JSTokTmp.ch, 49)), EqualTo(JSTokTmp.ch, 95)) {
                    IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                        IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                            JSTokState.error = 1
                            ReturnValue(0)
                        }
                        ns_prev_us = 1
                    } ElseBlock: {
                        ns_prev_us = 0
                    }
                    JSLex__Advance()
                    JSTokTmp.ch = JSLex__Peek()
                }
                // Reject trailing underscore
                IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                    JSTokState.error = 1
                    ReturnValue(0)
                }
                JSTokTmp.len = Subtract(JSTokState.pos, JSTokTmp.start)
                JSTokTmp.interned = JSLex__Intern(Add(JSTokState.source, JSTokTmp.start), JSTokTmp.len)
                JSLex__AddToken(JSTokType.NUMBER, JSTokTmp.interned, JSTokTmp.len)
                ReturnValue(1)
            }

            // --- Legacy octal or 0_ — reject _ in these contexts ---
            // If next char after 0 is _ → SyntaxError (0_N not allowed)
            IfCondition EqualTo(JSTokTmp.ch2, 95) ThenBlock: {
                JSTokState.error = 1
                ReturnValue(0)
            }
            // If next char after 0 is a digit (legacy octal 00, 01, ..., 09)
            // consume digits but reject any _ in the literal
            IfCondition And(GreaterEqual(JSTokTmp.ch2, 48), LessEqual(JSTokTmp.ch2, 57)) ThenBlock: {
                // Advance past the leading 0
                JSLex__Advance()
                JSTokTmp.ch = JSLex__Peek()
                WhileLoop Or(JSLex__IsDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95)) {
                    IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                        // _ not allowed in legacy octal / implicit octal
                        JSTokState.error = 1
                        ReturnValue(0)
                    }
                    JSLex__Advance()
                    JSTokTmp.ch = JSLex__Peek()
                }
                // Legacy octals can have decimal point (e.g. 09.5)
                IfCondition EqualTo(JSTokTmp.ch, 46) ThenBlock: {
                    JSTokTmp.ch2 = JSLex__PeekAt(1)
                    IfCondition And(GreaterEqual(JSTokTmp.ch2, 48), LessEqual(JSTokTmp.ch2, 57)) ThenBlock: {
                        JSLex__Advance()
                        JSTokTmp.ch = JSLex__Peek()
                        WhileLoop JSLex__IsDigit(JSTokTmp.ch) {
                            JSLex__Advance()
                            JSTokTmp.ch = JSLex__Peek()
                        }
                    }
                }
                // Legacy octals can have exponent
                IfCondition Or(EqualTo(JSTokTmp.ch, 101), EqualTo(JSTokTmp.ch, 69)) ThenBlock: {
                    JSLex__Advance()
                    JSTokTmp.ch = JSLex__Peek()
                    IfCondition Or(EqualTo(JSTokTmp.ch, 43), EqualTo(JSTokTmp.ch, 45)) ThenBlock: {
                        JSLex__Advance()
                    }
                    JSTokTmp.ch = JSLex__Peek()
                    WhileLoop JSLex__IsDigit(JSTokTmp.ch) {
                        JSLex__Advance()
                        JSTokTmp.ch = JSLex__Peek()
                    }
                }
                JSTokTmp.len = Subtract(JSTokState.pos, JSTokTmp.start)
                JSTokTmp.interned = JSLex__Intern(Add(JSTokState.source, JSTokTmp.start), JSTokTmp.len)
                JSLex__AddToken(JSTokType.NUMBER, JSTokTmp.interned, JSTokTmp.len)
                ReturnValue(1)
            }
        }

        // --- Decimal integer part (with numeric separator _) ---
        JSTokTmp.ch = JSLex__Peek()
        ns_prev_us = 0
        JSTokTmp.done = Or(JSLex__IsDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
        WhileLoop EqualTo(JSTokTmp.done, 1) {
            IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                    JSTokState.error = 1
                    ReturnValue(0)
                }
                ns_prev_us = 1
            } ElseBlock: {
                ns_prev_us = 0
            }
            JSLex__Advance()
            JSTokTmp.ch = JSLex__Peek()
            JSTokTmp.done = Or(JSLex__IsDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
        }
        // Reject trailing underscore before . or end
        IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
            JSTokState.error = 1
            ReturnValue(0)
        }

        // --- Float: consume decimal point + fractional digits ---
        JSTokTmp.ch = JSLex__Peek()
        IfCondition EqualTo(JSTokTmp.ch, 46) ThenBlock: {
            // Check next char is a digit (not a method call like 1.toString)
            JSTokTmp.ch2 = JSLex__PeekAt(1)
            IfCondition And(GreaterEqual(JSTokTmp.ch2, 48), LessEqual(JSTokTmp.ch2, 57)) ThenBlock: {
                JSLex__Advance()
                JSTokTmp.ch = JSLex__Peek()
                ns_prev_us = 0
                JSTokTmp.done = Or(JSLex__IsDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
                WhileLoop EqualTo(JSTokTmp.done, 1) {
                    IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                        IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                            JSTokState.error = 1
                            ReturnValue(0)
                        }
                        ns_prev_us = 1
                    } ElseBlock: {
                        ns_prev_us = 0
                    }
                    JSLex__Advance()
                    JSTokTmp.ch = JSLex__Peek()
                    JSTokTmp.done = Or(JSLex__IsDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
                }
                // Reject trailing underscore in fractional part
                IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                    JSTokState.error = 1
                    ReturnValue(0)
                }
            }
        }

        // --- Exponent: e/E [+/-] digits ---
        JSTokTmp.ch = JSLex__Peek()
        IfCondition Or(EqualTo(JSTokTmp.ch, 101), EqualTo(JSTokTmp.ch, 69)) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch = JSLex__Peek()
            IfCondition Or(EqualTo(JSTokTmp.ch, 43), EqualTo(JSTokTmp.ch, 45)) ThenBlock: {
                JSLex__Advance()
            }
            JSTokTmp.ch = JSLex__Peek()
            // Reject _ immediately after e/E or +/-
            IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                JSTokState.error = 1
                ReturnValue(0)
            }
            ns_prev_us = 0
            JSTokTmp.done = Or(JSLex__IsDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
            WhileLoop EqualTo(JSTokTmp.done, 1) {
                IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                    IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                        JSTokState.error = 1
                        ReturnValue(0)
                    }
                    ns_prev_us = 1
                } ElseBlock: {
                    ns_prev_us = 0
                }
                JSLex__Advance()
                JSTokTmp.ch = JSLex__Peek()
                JSTokTmp.done = Or(JSLex__IsDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
            }
            // Reject trailing underscore in exponent
            IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                JSTokState.error = 1
                ReturnValue(0)
            }
        }

        JSTokTmp.len = Subtract(JSTokState.pos, JSTokTmp.start)
        JSTokTmp.interned = JSLex__Intern(Add(JSTokState.source, JSTokTmp.start), JSTokTmp.len)
        JSLex__AddToken(JSTokType.NUMBER, JSTokTmp.interned, JSTokTmp.len)
        ReturnValue(1)
    }
}

// =============================================================================
// SCAN STRING — "..." or '...' with escape handling
// Quote char must be set in JSTokTmp.quote before calling.
// =============================================================================
Function.JSLex__ScanString {
    Output: Integer
    Body: {
        // Consume opening quote
        JSLex__Advance()
        buf = JSRTState.str_lex_buf
        di = 0
        JSTokTmp.ch = JSLex__Peek()

        WhileLoop And(NotEqual(JSTokTmp.ch, JSTokTmp.quote), NotEqual(JSTokTmp.ch, 0)) {
            // Reject raw line terminators (LF=10, CR=13) in string literals
            IfCondition Or(EqualTo(JSTokTmp.ch, 10), EqualTo(JSTokTmp.ch, 13)) ThenBlock: {
                JSTokState.error = 1
                ReturnValue(0)
            }

            // Check for backslash escapes
            IfCondition EqualTo(JSTokTmp.ch, 92) ThenBlock: {
                // Consume backslash
                JSLex__Advance()
                JSTokTmp.ch2 = JSLex__Peek()

                // EOF after backslash → unterminated string
                IfCondition EqualTo(JSTokTmp.ch2, 0) ThenBlock: {
                    JSTokState.error = 1
                    ReturnValue(0)
                }

                // \u — validate unicode escape (but emit chars same as before)
                IfCondition EqualTo(JSTokTmp.ch2, 117) ThenBlock: {
                    // Peek ahead to validate without consuming
                    ufirst = JSLex__PeekAt(1)
                    IfCondition EqualTo(ufirst, 123) ThenBlock: {
                        // \u{...} form — validate hex digits, reject non-hex
                        uoff = 2
                        uhex_count = 0
                        uch = JSLex__PeekAt(uoff)
                        WhileLoop And(NotEqual(uch, 125), NotEqual(uch, 0)) {
                            IfCondition EqualTo(JSLex__IsHexDigit(uch), 0) ThenBlock: {
                                JSTokState.error = 1
                                ReturnValue(0)
                            }
                            uhex_count = Add(uhex_count, 1)
                            uoff = Add(uoff, 1)
                            uch = JSLex__PeekAt(uoff)
                        }
                        IfCondition Or(EqualTo(uch, 0), EqualTo(uhex_count, 0)) ThenBlock: {
                            JSTokState.error = 1
                            ReturnValue(0)
                        }
                    } ElseBlock: {
                        // \uHHHH form — require exactly 4 hex digits
                        uh_i = 0
                        WhileLoop LessThan(uh_i, 4) {
                            uch2 = JSLex__PeekAt(Add(1, uh_i))
                            IfCondition EqualTo(JSLex__IsHexDigit(uch2), 0) ThenBlock: {
                                JSTokState.error = 1
                                ReturnValue(0)
                            }
                            uh_i = Add(uh_i, 1)
                        }
                    }
                    // Validation passed — fall through to emit char literally
                }

                // \x — validate hex escape (require 2 hex digits after x)
                IfCondition EqualTo(JSTokTmp.ch2, 120) ThenBlock: {
                    xh1 = JSLex__PeekAt(1)
                    xh2 = JSLex__PeekAt(2)
                    IfCondition Or(EqualTo(JSLex__IsHexDigit(xh1), 0),
                                   EqualTo(JSLex__IsHexDigit(xh2), 0)) ThenBlock: {
                        JSTokState.error = 1
                        ReturnValue(0)
                    }
                    // Validation passed — fall through to emit char literally
                }

                // \n -> newline (10)
                IfCondition EqualTo(JSTokTmp.ch2, 110) ThenBlock: {
                    SetByte(buf, di, 10)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \t -> tab (9)
                IfCondition EqualTo(JSTokTmp.ch2, 116) ThenBlock: {
                    SetByte(buf, di, 9)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \\ -> backslash (92)
                IfCondition EqualTo(JSTokTmp.ch2, 92) ThenBlock: {
                    SetByte(buf, di, 92)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \" -> double quote (34)
                IfCondition EqualTo(JSTokTmp.ch2, 34) ThenBlock: {
                    SetByte(buf, di, 34)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \' -> single quote (39)
                IfCondition EqualTo(JSTokTmp.ch2, 39) ThenBlock: {
                    SetByte(buf, di, 39)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \r -> carriage return (13)
                IfCondition EqualTo(JSTokTmp.ch2, 114) ThenBlock: {
                    SetByte(buf, di, 13)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \0 -> null (0) — use char code 48 for '0'
                IfCondition EqualTo(JSTokTmp.ch2, 48) ThenBlock: {
                    SetByte(buf, di, 0)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // Unknown escape — emit the char literally (same as original behavior)
                IfCondition And(And(NotEqual(JSTokTmp.ch2, 110), NotEqual(JSTokTmp.ch2, 116)),
                               And(And(NotEqual(JSTokTmp.ch2, 92), NotEqual(JSTokTmp.ch2, 34)),
                                   And(NotEqual(JSTokTmp.ch2, 39), And(NotEqual(JSTokTmp.ch2, 114),
                                       NotEqual(JSTokTmp.ch2, 48))))) ThenBlock: {
                    SetByte(buf, di, JSTokTmp.ch2)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
            } ElseBlock: {
                // Regular character
                SetByte(buf, di, JSTokTmp.ch)
                di = Add(di, 1)
                JSLex__Advance()
            }
            JSTokTmp.ch = JSLex__Peek()
        }

        // Unterminated string (EOF without closing quote)
        IfCondition EqualTo(JSTokTmp.ch, 0) ThenBlock: {
            JSTokState.error = 1
            ReturnValue(0)
        }

        // Consume closing quote
        JSLex__Advance()

        JSTokTmp.interned = JSLex__Intern(buf, di)
        JSTokTmp.len = di
        JSLex__AddToken(JSTokType.STRING, JSTokTmp.interned, JSTokTmp.len)
        ReturnValue(1)
    }
}

// =============================================================================
// SCAN TEMPLATE — template literal scanning
// Scans chars inside a backtick string until closing ` or ${
// Called initially when ` is found (emits TMPL_FULL or TMPL_HEAD)
// Called again from RBRACE handler (emits TMPL_MID or TMPL_TAIL)
// is_cont=0 for initial scan (after opening `), is_cont=1 for continuation (after })
// =============================================================================
Function.JSLex__ScanTemplate {
    Input: is_cont: Integer
    Output: Integer
    Body: {
        buf = JSRTState.str_lex_buf
        di = 0
        JSTokTmp.ch = JSLex__Peek()

        JSTokTmp.done = 0
        WhileLoop And(EqualTo(JSTokTmp.done, 0), NotEqual(JSTokTmp.ch, 0)) {
            // Check for closing backtick (96)
            IfCondition EqualTo(JSTokTmp.ch, 96) ThenBlock: {
                JSLex__Advance()
                // Intern the string content
                JSTokTmp.interned = JSLex__Intern(buf, di)
                JSTokTmp.len = di
                // Emit TMPL_FULL (initial, no interpolation) or TMPL_TAIL (continuation)
                IfCondition EqualTo(is_cont, 0) ThenBlock: {
                    JSLex__AddToken(JSTokType.TMPL_FULL, JSTokTmp.interned, JSTokTmp.len)
                } ElseBlock: {
                    JSLex__AddToken(JSTokType.TMPL_TAIL, JSTokTmp.interned, JSTokTmp.len)
                }
                ReturnValue(1)
            }
            // Check for ${ (36=$ followed by 123={)
            IfCondition EqualTo(JSTokTmp.ch, 36) ThenBlock: {
                JSTokTmp.ch2 = JSLex__PeekAt(1)
                IfCondition EqualTo(JSTokTmp.ch2, 123) ThenBlock: {
                    // Consume $ and {
                    JSLex__Advance()
                    JSLex__Advance()
                    // Intern the string content so far
                    JSTokTmp.interned = JSLex__Intern(buf, di)
                    JSTokTmp.len = di
                    // Emit TMPL_HEAD (initial) or TMPL_MID (continuation)
                    IfCondition EqualTo(is_cont, 0) ThenBlock: {
                        JSLex__AddToken(JSTokType.TMPL_HEAD, JSTokTmp.interned, JSTokTmp.len)
                    } ElseBlock: {
                        JSLex__AddToken(JSTokType.TMPL_MID, JSTokTmp.interned, JSTokTmp.len)
                    }
                    // Track template nesting
                    JSTokTmp.tmpl_depth = Add(JSTokTmp.tmpl_depth, 1)
                    JSTokTmp.tmpl_braces = 0
                    ReturnValue(1)
                }
                // Not ${, just a literal $ sign
                SetByte(buf, di, JSTokTmp.ch)
                di = Add(di, 1)
                JSLex__Advance()
            }
            // Check for backslash escapes
            IfCondition And(NotEqual(JSTokTmp.ch, 96), And(NotEqual(JSTokTmp.ch, 36), EqualTo(JSTokTmp.ch, 92))) ThenBlock: {
                JSLex__Advance()
                JSTokTmp.ch2 = JSLex__Peek()
                // Reject legacy octal escapes \1-\9 (49-57) in template literals
                IfCondition And(GreaterEqual(JSTokTmp.ch2, 49), LessEqual(JSTokTmp.ch2, 57)) ThenBlock: {
                    JSTokState.error = 1
                    JSTokTmp.done = 1
                }
                // \n -> newline (10)
                IfCondition EqualTo(JSTokTmp.ch2, 110) ThenBlock: {
                    SetByte(buf, di, 10)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \t -> tab (9)
                IfCondition EqualTo(JSTokTmp.ch2, 116) ThenBlock: {
                    SetByte(buf, di, 9)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \\ -> backslash (92)
                IfCondition EqualTo(JSTokTmp.ch2, 92) ThenBlock: {
                    SetByte(buf, di, 92)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \` -> backtick (96)
                IfCondition EqualTo(JSTokTmp.ch2, 96) ThenBlock: {
                    SetByte(buf, di, 96)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \$ -> dollar (36)
                IfCondition EqualTo(JSTokTmp.ch2, 36) ThenBlock: {
                    SetByte(buf, di, 36)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \r -> carriage return (13)
                IfCondition EqualTo(JSTokTmp.ch2, 114) ThenBlock: {
                    SetByte(buf, di, 13)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
                // \0 -> null (only if NOT followed by another digit)
                IfCondition EqualTo(JSTokTmp.ch2, 48) ThenBlock: {
                    JSLex__Advance()
                    esc_next = JSLex__Peek()
                    IfCondition And(GreaterEqual(esc_next, 48), LessEqual(esc_next, 57)) ThenBlock: {
                        // \0 followed by digit = legacy octal, forbidden in templates
                        JSTokState.error = 1
                        JSTokTmp.done = 1
                    } ElseBlock: {
                        SetByte(buf, di, 0)
                        di = Add(di, 1)
                    }
                }
                // \x -> hex escape (must be 2 hex digits)
                IfCondition EqualTo(JSTokTmp.ch2, 120) ThenBlock: {
                    JSLex__Advance()
                    hex1 = JSLex__Peek()
                    hex2 = JSLex__PeekAt(1)
                    // Validate both are hex digits (0-9, A-F, a-f)
                    esc_ok = 1
                    IfCondition Not(Or(And(GreaterEqual(hex1, 48), LessEqual(hex1, 57)),
                                       Or(And(GreaterEqual(hex1, 65), LessEqual(hex1, 70)),
                                          And(GreaterEqual(hex1, 97), LessEqual(hex1, 102))))) ThenBlock: {
                        esc_ok = 0
                    }
                    IfCondition Not(Or(And(GreaterEqual(hex2, 48), LessEqual(hex2, 57)),
                                       Or(And(GreaterEqual(hex2, 65), LessEqual(hex2, 70)),
                                          And(GreaterEqual(hex2, 97), LessEqual(hex2, 102))))) ThenBlock: {
                        esc_ok = 0
                    }
                    IfCondition EqualTo(esc_ok, 0) ThenBlock: {
                        JSTokState.error = 1
                        JSTokTmp.done = 1
                    } ElseBlock: {
                        // Compute hex value
                        JSTokTmp.val = 0
                        IfCondition And(GreaterEqual(hex1, 48), LessEqual(hex1, 57)) ThenBlock: {
                            JSTokTmp.val = Multiply(Subtract(hex1, 48), 16)
                        }
                        IfCondition And(GreaterEqual(hex1, 65), LessEqual(hex1, 70)) ThenBlock: {
                            JSTokTmp.val = Multiply(Add(Subtract(hex1, 65), 10), 16)
                        }
                        IfCondition And(GreaterEqual(hex1, 97), LessEqual(hex1, 102)) ThenBlock: {
                            JSTokTmp.val = Multiply(Add(Subtract(hex1, 97), 10), 16)
                        }
                        IfCondition And(GreaterEqual(hex2, 48), LessEqual(hex2, 57)) ThenBlock: {
                            JSTokTmp.val = Add(JSTokTmp.val, Subtract(hex2, 48))
                        }
                        IfCondition And(GreaterEqual(hex2, 65), LessEqual(hex2, 70)) ThenBlock: {
                            JSTokTmp.val = Add(JSTokTmp.val, Add(Subtract(hex2, 65), 10))
                        }
                        IfCondition And(GreaterEqual(hex2, 97), LessEqual(hex2, 102)) ThenBlock: {
                            JSTokTmp.val = Add(JSTokTmp.val, Add(Subtract(hex2, 97), 10))
                        }
                        SetByte(buf, di, JSTokTmp.val)
                        di = Add(di, 1)
                        JSLex__Advance()
                        JSLex__Advance()
                    }
                }
                // \u -> unicode escape (must be 4 hex digits or {hex+})
                IfCondition EqualTo(JSTokTmp.ch2, 117) ThenBlock: {
                    JSLex__Advance()
                    esc_next = JSLex__Peek()
                    IfCondition EqualTo(esc_next, 123) ThenBlock: {
                        // \u{...} — just validate at least one hex digit before }
                        JSLex__Advance()
                        esc_ok = 0
                        esc_next = JSLex__Peek()
                        WhileLoop And(NotEqual(esc_next, 125), NotEqual(esc_next, 0)) {
                            IfCondition Or(And(GreaterEqual(esc_next, 48), LessEqual(esc_next, 57)),
                                           Or(And(GreaterEqual(esc_next, 65), LessEqual(esc_next, 70)),
                                              And(GreaterEqual(esc_next, 97), LessEqual(esc_next, 102)))) ThenBlock: {
                                esc_ok = 1
                            } ElseBlock: {
                                JSTokState.error = 1
                                JSTokTmp.done = 1
                            }
                            JSLex__Advance()
                            esc_next = JSLex__Peek()
                        }
                        IfCondition EqualTo(esc_ok, 0) ThenBlock: {
                            JSTokState.error = 1
                            JSTokTmp.done = 1
                        } ElseBlock: {
                            // Skip closing }
                            JSLex__Advance()
                            // Emit placeholder (full unicode decode not needed for validation)
                            SetByte(buf, di, 63)
                            di = Add(di, 1)
                        }
                    } ElseBlock: {
                        // \uXXXX — need exactly 4 hex digits
                        esc_ok = 1
                        esc_i = 0
                        WhileLoop LessThan(esc_i, 4) {
                            esc_next = JSLex__Peek()
                            IfCondition Not(Or(And(GreaterEqual(esc_next, 48), LessEqual(esc_next, 57)),
                                               Or(And(GreaterEqual(esc_next, 65), LessEqual(esc_next, 70)),
                                                  And(GreaterEqual(esc_next, 97), LessEqual(esc_next, 102))))) ThenBlock: {
                                esc_ok = 0
                                esc_i = 4
                            } ElseBlock: {
                                JSLex__Advance()
                            }
                            esc_i = Add(esc_i, 1)
                        }
                        IfCondition EqualTo(esc_ok, 0) ThenBlock: {
                            JSTokState.error = 1
                            JSTokTmp.done = 1
                        } ElseBlock: {
                            // Emit placeholder
                            SetByte(buf, di, 63)
                            di = Add(di, 1)
                        }
                    }
                }
                // Unknown escape — emit char literally (only for safe escapes not handled above)
                IfCondition And(And(NotEqual(JSTokTmp.ch2, 110), NotEqual(JSTokTmp.ch2, 116)),
                               And(And(NotEqual(JSTokTmp.ch2, 92), NotEqual(JSTokTmp.ch2, 96)),
                                   And(NotEqual(JSTokTmp.ch2, 36), And(NotEqual(JSTokTmp.ch2, 114),
                                       And(NotEqual(JSTokTmp.ch2, 48), And(NotEqual(JSTokTmp.ch2, 120),
                                           NotEqual(JSTokTmp.ch2, 117))))))) ThenBlock: {
                    SetByte(buf, di, JSTokTmp.ch2)
                    di = Add(di, 1)
                    JSLex__Advance()
                }
            }
            // Regular character (not `, not $, not \)
            IfCondition And(NotEqual(JSTokTmp.ch, 96), And(NotEqual(JSTokTmp.ch, 36), NotEqual(JSTokTmp.ch, 92))) ThenBlock: {
                SetByte(buf, di, JSTokTmp.ch)
                di = Add(di, 1)
                JSLex__Advance()
            }
            JSTokTmp.ch = JSLex__Peek()
        }
        // Unterminated template — emit what we have as TMPL_FULL
        JSTokTmp.interned = JSLex__Intern(buf, di)
        JSTokTmp.len = di
        JSLex__AddToken(JSTokType.TMPL_FULL, JSTokTmp.interned, JSTokTmp.len)
        ReturnValue(1)
    }
}

// =============================================================================
// SCAN OPERATOR — multi-char operator detection
// Handles ==, ===, !=, !==, <=, >=, &&, ||, <<, >>, +=, -=, *=, /=, ++, --
// and single-char punctuation/operators
// =============================================================================
// =============================================================================
// REGEX LITERAL SCANNER — scan /pattern/flags
// Stores: pattern\0flags\0 in string buffer
// Token: T_PTR = pattern start, T_LEN = pattern length
// Flags accessible at: T_PTR + T_LEN + 1
// =============================================================================
Function.JSLex__ScanRegexLit {
    Output: Integer
    Body: {
        // Opening / already confirmed by caller. Advance past it.
        JSLex__Advance()

        // Record pattern start in string buffer
        pat_start = Add(JSTokState.str_buf, JSTokState.str_pos)
        pat_len = 0
        in_class = 0

        // Scan pattern body until unescaped / outside character class
        scan_done = 0
        WhileLoop EqualTo(scan_done, 0) {
            IfCondition GreaterEqual(JSTokState.pos, JSTokState.src_len) ThenBlock: {
                // Unterminated regex — error
                JSTokState.error = 1
                ReturnValue(0)
            }
            rc = JSLex__Peek()

            // Newline inside regex is an error
            IfCondition Or(EqualTo(rc, 10), EqualTo(rc, 13)) ThenBlock: {
                JSTokState.error = 1
                ReturnValue(0)
            }

            // Backslash escape — copy both chars
            IfCondition EqualTo(rc, 92) ThenBlock: {
                SetByte(JSTokState.str_buf, JSTokState.str_pos, rc)
                JSTokState.str_pos = Add(JSTokState.str_pos, 1)
                pat_len = Add(pat_len, 1)
                JSLex__Advance()
                // Copy the escaped char
                IfCondition LessThan(JSTokState.pos, JSTokState.src_len) ThenBlock: {
                    rc2 = JSLex__Peek()
                    SetByte(JSTokState.str_buf, JSTokState.str_pos, rc2)
                    JSTokState.str_pos = Add(JSTokState.str_pos, 1)
                    pat_len = Add(pat_len, 1)
                    JSLex__Advance()
                }
            }

            // Character class [ ... ]
            IfCondition And(NotEqual(rc, 92), EqualTo(rc, 91)) ThenBlock: {
                in_class = 1
                SetByte(JSTokState.str_buf, JSTokState.str_pos, rc)
                JSTokState.str_pos = Add(JSTokState.str_pos, 1)
                pat_len = Add(pat_len, 1)
                JSLex__Advance()
            }
            IfCondition And(NotEqual(rc, 92), EqualTo(rc, 93)) ThenBlock: {
                in_class = 0
                SetByte(JSTokState.str_buf, JSTokState.str_pos, rc)
                JSTokState.str_pos = Add(JSTokState.str_pos, 1)
                pat_len = Add(pat_len, 1)
                JSLex__Advance()
            }

            // Closing / (only if not in character class and not backslash)
            IfCondition And(And(NotEqual(rc, 92), NotEqual(rc, 91)), NotEqual(rc, 93)) ThenBlock: {
                IfCondition And(EqualTo(rc, 47), EqualTo(in_class, 0)) ThenBlock: {
                    // End of pattern
                    JSLex__Advance()
                    scan_done = 1
                }
                IfCondition Or(NotEqual(rc, 47), NotEqual(in_class, 0)) ThenBlock: {
                    // Regular pattern character — copy
                    SetByte(JSTokState.str_buf, JSTokState.str_pos, rc)
                    JSTokState.str_pos = Add(JSTokState.str_pos, 1)
                    pat_len = Add(pat_len, 1)
                    JSLex__Advance()
                }
            }
        }

        // Null-terminate pattern
        SetByte(JSTokState.str_buf, JSTokState.str_pos, 0)
        JSTokState.str_pos = Add(JSTokState.str_pos, 1)

        // Scan flags: [gimsuy]*
        flg_start = Add(JSTokState.str_buf, JSTokState.str_pos)
        flg_len = 0
        flg_done = 0
        WhileLoop EqualTo(flg_done, 0) {
            IfCondition GreaterEqual(JSTokState.pos, JSTokState.src_len) ThenBlock: {
                flg_done = 1
            }
            IfCondition LessThan(JSTokState.pos, JSTokState.src_len) ThenBlock: {
                fc = JSLex__Peek()
                // g=103, i=105, m=109, s=115, u=117, y=121, v=118, d=100
                is_flag = 0
                IfCondition EqualTo(fc, 103) ThenBlock: { is_flag = 1 }
                IfCondition EqualTo(fc, 105) ThenBlock: { is_flag = 1 }
                IfCondition EqualTo(fc, 109) ThenBlock: { is_flag = 1 }
                IfCondition EqualTo(fc, 115) ThenBlock: { is_flag = 1 }
                IfCondition EqualTo(fc, 117) ThenBlock: { is_flag = 1 }
                IfCondition EqualTo(fc, 121) ThenBlock: { is_flag = 1 }
                IfCondition EqualTo(fc, 118) ThenBlock: { is_flag = 1 }
                IfCondition EqualTo(fc, 100) ThenBlock: { is_flag = 1 }
                IfCondition EqualTo(is_flag, 1) ThenBlock: {
                    SetByte(JSTokState.str_buf, JSTokState.str_pos, fc)
                    JSTokState.str_pos = Add(JSTokState.str_pos, 1)
                    flg_len = Add(flg_len, 1)
                    JSLex__Advance()
                }
                IfCondition EqualTo(is_flag, 0) ThenBlock: {
                    flg_done = 1
                }
            }
        }
        // Null-terminate flags
        SetByte(JSTokState.str_buf, JSTokState.str_pos, 0)
        JSTokState.str_pos = Add(JSTokState.str_pos, 1)

        // Emit REGEX_LIT token: ptr=pattern, len=pat_len
        // Flags at pat_start + pat_len + 1
        JSLex__AddToken(JSTokType.REGEX_LIT, pat_start, pat_len)
        ReturnValue(1)
    }
}

Function.JSLex__ScanOp {
    Output: Integer
    Body: {
        JSTokTmp.ch = JSLex__Peek()

        // --- LPAREN ( ---
        IfCondition EqualTo(JSTokTmp.ch, 40) ThenBlock: {
            JSLex__Advance()
            // Push onto paren stack: 1 if preceding token is ctrl keyword, else 0
            sp = JSTokState.paren_sp
            IfCondition LessThan(sp, 256) ThenBlock: {
                is_ctrl = GetByte(JSTokState.ctrl_table, JSTokState.last_type)
                SetByte(JSTokState.paren_stack, sp, is_ctrl)
                JSTokState.paren_sp = Add(sp, 1)
            }
            JSLex__AddToken(JSTokType.LPAREN, 0, 0)
            ReturnValue(1)
        }
        // --- RPAREN ) ---
        IfCondition EqualTo(JSTokTmp.ch, 41) ThenBlock: {
            JSLex__Advance()
            // Pop from paren stack to determine if this closes a ctrl paren
            JSTokState.rparen_is_ctrl = 0
            sp = JSTokState.paren_sp
            IfCondition GreaterThan(sp, 0) ThenBlock: {
                sp = Subtract(sp, 1)
                JSTokState.rparen_is_ctrl = GetByte(JSTokState.paren_stack, sp)
                JSTokState.paren_sp = sp
            }
            JSLex__AddToken(JSTokType.RPAREN, 0, 0)
            ReturnValue(1)
        }
        // --- LBRACE { ---
        IfCondition EqualTo(JSTokTmp.ch, 123) ThenBlock: {
            JSLex__Advance()
            // Track brace depth inside template interpolation
            IfCondition GreaterThan(JSTokTmp.tmpl_depth, 0) ThenBlock: {
                JSTokTmp.tmpl_braces = Add(JSTokTmp.tmpl_braces, 1)
            }
            JSLex__AddToken(JSTokType.LBRACE, 0, 0)
            ReturnValue(1)
        }
        // --- RBRACE } ---
        IfCondition EqualTo(JSTokTmp.ch, 125) ThenBlock: {
            // If inside template interpolation and brace depth is 0,
            // this } closes the ${...} — continue scanning template
            IfCondition And(GreaterThan(JSTokTmp.tmpl_depth, 0), EqualTo(JSTokTmp.tmpl_braces, 0)) ThenBlock: {
                JSLex__Advance()
                JSTokTmp.tmpl_depth = Subtract(JSTokTmp.tmpl_depth, 1)
                // Continue scanning template content (is_cont=1)
                JSLex__ScanTemplate(1)
                ReturnValue(1)
            }
            // Normal RBRACE (or nested brace inside interpolation)
            IfCondition GreaterThan(JSTokTmp.tmpl_braces, 0) ThenBlock: {
                JSTokTmp.tmpl_braces = Subtract(JSTokTmp.tmpl_braces, 1)
            }
            JSLex__Advance()
            JSLex__AddToken(JSTokType.RBRACE, 0, 0)
            ReturnValue(1)
        }
        // --- LBRACKET [ ---
        IfCondition EqualTo(JSTokTmp.ch, 91) ThenBlock: {
            JSLex__Advance()
            JSLex__AddToken(JSTokType.LBRACKET, 0, 0)
            ReturnValue(1)
        }
        // --- RBRACKET ] ---
        IfCondition EqualTo(JSTokTmp.ch, 93) ThenBlock: {
            JSLex__Advance()
            JSLex__AddToken(JSTokType.RBRACKET, 0, 0)
            ReturnValue(1)
        }
        // --- SEMI ; ---
        IfCondition EqualTo(JSTokTmp.ch, 59) ThenBlock: {
            JSLex__Advance()
            JSLex__AddToken(JSTokType.SEMI, 0, 0)
            ReturnValue(1)
        }
        // --- COMMA , ---
        IfCondition EqualTo(JSTokTmp.ch, 44) ThenBlock: {
            JSLex__Advance()
            JSLex__AddToken(JSTokType.COMMA, 0, 0)
            ReturnValue(1)
        }
        // --- DOT . or DOT3 ... or .NNN numeric literal ---
        IfCondition EqualTo(JSTokTmp.ch, 46) ThenBlock: {
            // Check if next char is a digit → .NNN numeric literal
            JSTokTmp.ch2 = JSLex__PeekAt(1)
            IfCondition And(GreaterEqual(JSTokTmp.ch2, 48), LessEqual(JSTokTmp.ch2, 57)) ThenBlock: {
                // Scan .NNN as a numeric literal
                JSTokTmp.start = JSTokState.pos
                JSLex__Advance()
                JSTokTmp.ch = JSLex__Peek()
                ns_prev_us = 0
                JSTokTmp.done = Or(JSLex__IsDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
                WhileLoop EqualTo(JSTokTmp.done, 1) {
                    IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                        IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                            JSTokState.error = 1
                            ReturnValue(0)
                        }
                        ns_prev_us = 1
                    } ElseBlock: {
                        ns_prev_us = 0
                    }
                    JSLex__Advance()
                    JSTokTmp.ch = JSLex__Peek()
                    JSTokTmp.done = Or(JSLex__IsDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
                }
                // Reject trailing underscore in fractional part
                IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                    JSTokState.error = 1
                    ReturnValue(0)
                }
                // Exponent part
                IfCondition Or(EqualTo(JSTokTmp.ch, 101), EqualTo(JSTokTmp.ch, 69)) ThenBlock: {
                    JSLex__Advance()
                    JSTokTmp.ch = JSLex__Peek()
                    IfCondition Or(EqualTo(JSTokTmp.ch, 43), EqualTo(JSTokTmp.ch, 45)) ThenBlock: {
                        JSLex__Advance()
                    }
                    JSTokTmp.ch = JSLex__Peek()
                    IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                        JSTokState.error = 1
                        ReturnValue(0)
                    }
                    ns_prev_us = 0
                    JSTokTmp.done = Or(JSLex__IsDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
                    WhileLoop EqualTo(JSTokTmp.done, 1) {
                        IfCondition EqualTo(JSTokTmp.ch, 95) ThenBlock: {
                            IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                                JSTokState.error = 1
                                ReturnValue(0)
                            }
                            ns_prev_us = 1
                        } ElseBlock: {
                            ns_prev_us = 0
                        }
                        JSLex__Advance()
                        JSTokTmp.ch = JSLex__Peek()
                        JSTokTmp.done = Or(JSLex__IsDigit(JSTokTmp.ch), EqualTo(JSTokTmp.ch, 95))
                    }
                    IfCondition EqualTo(ns_prev_us, 1) ThenBlock: {
                        JSTokState.error = 1
                        ReturnValue(0)
                    }
                }
                JSTokTmp.len = Subtract(JSTokState.pos, JSTokTmp.start)
                JSTokTmp.interned = JSLex__Intern(Add(JSTokState.source, JSTokTmp.start), JSTokTmp.len)
                JSLex__AddToken(JSTokType.NUMBER, JSTokTmp.interned, JSTokTmp.len)
                ReturnValue(1)
            }
            JSLex__Advance()
            // Check for .. then .
            IfCondition EqualTo(JSLex__Peek(), 46) ThenBlock: {
                JSLex__Advance()
                IfCondition EqualTo(JSLex__Peek(), 46) ThenBlock: {
                    JSLex__Advance()
                    JSLex__AddToken(JSTokType.DOT3, 0, 0)
                    ReturnValue(1)
                }
                // Two dots but not three — emit DOT, DOT
                JSLex__AddToken(JSTokType.DOT, 0, 0)
                JSLex__AddToken(JSTokType.DOT, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.DOT, 0, 0)
            ReturnValue(1)
        }
        // --- COLON : ---
        IfCondition EqualTo(JSTokTmp.ch, 58) ThenBlock: {
            JSLex__Advance()
            JSLex__AddToken(JSTokType.COLON, 0, 0)
            ReturnValue(1)
        }
        // --- QUESTION ? / NULLISH ?? / ??= / OPTIONAL ?. ---
        IfCondition EqualTo(JSTokTmp.ch, 63) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 63) ThenBlock: {
                JSLex__Advance()
                JSTokTmp.ch2 = JSLex__Peek()
                IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                    JSLex__Advance()
                    JSLex__AddToken(JSTokType.NULLISH_ASSIGN, 0, 0)
                    ReturnValue(1)
                }
                JSLex__AddToken(JSTokType.NULLISH, 0, 0)
                ReturnValue(1)
            }
            // Check for ?. (optional chaining) — but not ?.digit (ternary + decimal)
            IfCondition EqualTo(JSTokTmp.ch2, 46) ThenBlock: {
                // Peek at char after the dot
                ch_after_dot = JSLex__PeekAt(1)
                // If next char is NOT a digit (0-9), this is optional chaining
                IfCondition Or(LessThan(ch_after_dot, 48), GreaterThan(ch_after_dot, 57)) ThenBlock: {
                    JSLex__Advance()
                    JSLex__AddToken(JSTokType.QUESTION_DOT, 0, 0)
                    ReturnValue(1)
                }
            }
            JSLex__AddToken(JSTokType.QUESTION, 0, 0)
            ReturnValue(1)
        }
        // --- TILDE ~ ---
        IfCondition EqualTo(JSTokTmp.ch, 126) ThenBlock: {
            JSLex__Advance()
            JSLex__AddToken(JSTokType.TILDE, 0, 0)
            ReturnValue(1)
        }
        // --- PERCENT % / %= ---
        IfCondition EqualTo(JSTokTmp.ch, 37) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.PERCENT_ASSIGN, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.PERCENT, 0, 0)
            ReturnValue(1)
        }
        // --- CARET ^ / ^= ---
        IfCondition EqualTo(JSTokTmp.ch, 94) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.CARET_ASSIGN, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.CARET, 0, 0)
            ReturnValue(1)
        }

        // --- PLUS + / ++ / += ---
        IfCondition EqualTo(JSTokTmp.ch, 43) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 43) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.PLUS_PLUS, 0, 0)
                ReturnValue(1)
            }
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.PLUS_ASSIGN, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.PLUS, 0, 0)
            ReturnValue(1)
        }

        // --- MINUS - / -- / -= ---
        IfCondition EqualTo(JSTokTmp.ch, 45) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 45) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.MINUS_MINUS, 0, 0)
                ReturnValue(1)
            }
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.MINUS_ASSIGN, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.MINUS, 0, 0)
            ReturnValue(1)
        }

        // --- STAR * / ** / **= / *= ---
        IfCondition EqualTo(JSTokTmp.ch, 42) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 42) ThenBlock: {
                JSLex__Advance()
                JSTokTmp.ch2 = JSLex__Peek()
                IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                    JSLex__Advance()
                    JSLex__AddToken(JSTokType.STAR_STAR_ASSIGN, 0, 0)
                    ReturnValue(1)
                }
                JSLex__AddToken(JSTokType.STAR_STAR, 0, 0)
                ReturnValue(1)
            }
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.STAR_ASSIGN, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.STAR, 0, 0)
            ReturnValue(1)
        }

        // --- SLASH / / /= --- (comments handled earlier in main loop)
        IfCondition EqualTo(JSTokTmp.ch, 47) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.SLASH_ASSIGN, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.SLASH, 0, 0)
            ReturnValue(1)
        }

        // --- ARROW => / ASSIGN = / EQ == / STRICT_EQ === ---
        IfCondition EqualTo(JSTokTmp.ch, 61) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            // Check for => (arrow)
            IfCondition EqualTo(JSTokTmp.ch2, 62) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.ARROW, 0, 0)
                ReturnValue(1)
            }
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                // Check for ===
                JSTokTmp.ch2 = JSLex__Peek()
                IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                    JSLex__Advance()
                    JSLex__AddToken(JSTokType.STRICT_EQ, 0, 0)
                    ReturnValue(1)
                }
                JSLex__AddToken(JSTokType.EQ, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.ASSIGN, 0, 0)
            ReturnValue(1)
        }

        // --- NOT ! / NEQ != / STRICT_NEQ !== ---
        IfCondition EqualTo(JSTokTmp.ch, 33) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                // Check for !==
                JSTokTmp.ch2 = JSLex__Peek()
                IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                    JSLex__Advance()
                    JSLex__AddToken(JSTokType.STRICT_NEQ, 0, 0)
                    ReturnValue(1)
                }
                JSLex__AddToken(JSTokType.NEQ, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.NOT, 0, 0)
            ReturnValue(1)
        }

        // --- LT < / LTE <= / SHL << / <<= ---
        IfCondition EqualTo(JSTokTmp.ch, 60) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.LTE, 0, 0)
                ReturnValue(1)
            }
            IfCondition EqualTo(JSTokTmp.ch2, 60) ThenBlock: {
                JSLex__Advance()
                JSTokTmp.ch2 = JSLex__Peek()
                IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                    JSLex__Advance()
                    JSLex__AddToken(JSTokType.SHL_ASSIGN, 0, 0)
                    ReturnValue(1)
                }
                JSLex__AddToken(JSTokType.SHL, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.LT, 0, 0)
            ReturnValue(1)
        }

        // --- GT > / GTE >= / SHR >> / USHR >>> / >>= / >>>= ---
        IfCondition EqualTo(JSTokTmp.ch, 62) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.GTE, 0, 0)
                ReturnValue(1)
            }
            IfCondition EqualTo(JSTokTmp.ch2, 62) ThenBlock: {
                JSLex__Advance()
                JSTokTmp.ch2 = JSLex__Peek()
                // >>> or >>>=
                IfCondition EqualTo(JSTokTmp.ch2, 62) ThenBlock: {
                    JSLex__Advance()
                    JSTokTmp.ch2 = JSLex__Peek()
                    IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                        JSLex__Advance()
                        JSLex__AddToken(JSTokType.USHR_ASSIGN, 0, 0)
                        ReturnValue(1)
                    }
                    JSLex__AddToken(JSTokType.USHR, 0, 0)
                    ReturnValue(1)
                }
                // >>=
                IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                    JSLex__Advance()
                    JSLex__AddToken(JSTokType.SHR_ASSIGN, 0, 0)
                    ReturnValue(1)
                }
                JSLex__AddToken(JSTokType.SHR, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.GT, 0, 0)
            ReturnValue(1)
        }

        // --- AMP & / AND && / &&= / &= ---
        IfCondition EqualTo(JSTokTmp.ch, 38) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 38) ThenBlock: {
                JSLex__Advance()
                JSTokTmp.ch2 = JSLex__Peek()
                IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                    JSLex__Advance()
                    JSLex__AddToken(JSTokType.AND_ASSIGN, 0, 0)
                    ReturnValue(1)
                }
                JSLex__AddToken(JSTokType.AND, 0, 0)
                ReturnValue(1)
            }
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.AMP_ASSIGN, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.AMP, 0, 0)
            ReturnValue(1)
        }

        // --- PIPE | / OR || / ||= / |= ---
        IfCondition EqualTo(JSTokTmp.ch, 124) ThenBlock: {
            JSLex__Advance()
            JSTokTmp.ch2 = JSLex__Peek()
            IfCondition EqualTo(JSTokTmp.ch2, 124) ThenBlock: {
                JSLex__Advance()
                JSTokTmp.ch2 = JSLex__Peek()
                IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                    JSLex__Advance()
                    JSLex__AddToken(JSTokType.OR_ASSIGN, 0, 0)
                    ReturnValue(1)
                }
                JSLex__AddToken(JSTokType.OR, 0, 0)
                ReturnValue(1)
            }
            IfCondition EqualTo(JSTokTmp.ch2, 61) ThenBlock: {
                JSLex__Advance()
                JSLex__AddToken(JSTokType.PIPE_ASSIGN, 0, 0)
                ReturnValue(1)
            }
            JSLex__AddToken(JSTokType.PIPE, 0, 0)
            ReturnValue(1)
        }

        // --- HASH # --- private name (#identifier with unicode escapes)
        IfCondition EqualTo(JSTokTmp.ch, 35) ThenBlock: {
            pn_raw_start = JSTokState.pos
            JSLex__Advance()
            // Scan identifier part after #
            JSTokTmp.ch = JSLex__Peek()
            IfCondition EqualTo(JSLex__IsIdentStart(JSTokTmp.ch), 1) ThenBlock: {
                // Check if the identifier part has escapes/non-ASCII
                pn_id_start = JSTokState.pos
                pn_has_esc = 0
                WhileLoop EqualTo(JSLex__IsIdentCont(JSTokTmp.ch), 1) {
                    IfCondition Or(EqualTo(JSTokTmp.ch, 92), GreaterEqual(JSTokTmp.ch, 128)) ThenBlock: {
                        pn_has_esc = 1
                    }
                    JSLex__Advance()
                    JSTokTmp.ch = JSLex__Peek()
                }
                IfCondition EqualTo(pn_has_esc, 0) ThenBlock: {
                    // Fast path — use raw source (#ident)
                    pn_start = Add(JSTokState.source, pn_raw_start)
                    pn_len = Subtract(JSTokState.pos, pn_raw_start)
                    JSLex__AddToken(JSTokType.PRIVATE_NAME, pn_start, pn_len)
                } ElseBlock: {
                    // Slow path — decode escapes, build #decoded in intern buffer
                    JSTokState.pos = pn_id_start
                    pn_dest = Add(JSTokState.str_buf, JSTokState.str_pos)
                    SetByte(pn_dest, 0, 35) // '#' prefix
                    pn_di = 1
                    pn_ch = GetByte(JSTokState.source, JSTokState.pos)
                    WhileLoop EqualTo(JSLex__IsIdentCont(pn_ch), 1) {
                        IfCondition EqualTo(pn_ch, 92) ThenBlock: {
                            JSTokState.pos = Add(JSTokState.pos, 1)
                            pn_u = GetByte(JSTokState.source, JSTokState.pos)
                            IfCondition EqualTo(pn_u, 117) ThenBlock: {
                                JSTokState.pos = Add(JSTokState.pos, 1)
                                pn_br = GetByte(JSTokState.source, JSTokState.pos)
                                IfCondition EqualTo(pn_br, 123) ThenBlock: {
                                    // \u{XXXX}
                                    JSTokState.pos = Add(JSTokState.pos, 1)
                                    pn_cp = 0
                                    pn_hc = GetByte(JSTokState.source, JSTokState.pos)
                                    WhileLoop And(NotEqual(pn_hc, 125), NotEqual(pn_hc, 0)) {
                                        pn_hv = JSLex__HexVal(pn_hc)
                                        pn_cp = Add(Multiply(pn_cp, 16), pn_hv)
                                        JSTokState.pos = Add(JSTokState.pos, 1)
                                        pn_hc = GetByte(JSTokState.source, JSTokState.pos)
                                    }
                                    IfCondition EqualTo(pn_hc, 125) ThenBlock: { JSTokState.pos = Add(JSTokState.pos, 1) }
                                    pn_nb = JSLex__EncodeUTF8(pn_dest, pn_di, pn_cp)
                                    pn_di = Add(pn_di, pn_nb)
                                } ElseBlock: {
                                    // \uXXXX
                                    pn_cp = 0
                                    pn_ei = 0
                                    WhileLoop LessThan(pn_ei, 4) {
                                        pn_hc = GetByte(JSTokState.source, JSTokState.pos)
                                        pn_hv = JSLex__HexVal(pn_hc)
                                        pn_cp = Add(Multiply(pn_cp, 16), pn_hv)
                                        JSTokState.pos = Add(JSTokState.pos, 1)
                                        pn_ei = Add(pn_ei, 1)
                                    }
                                    pn_nb = JSLex__EncodeUTF8(pn_dest, pn_di, pn_cp)
                                    pn_di = Add(pn_di, pn_nb)
                                }
                            }
                        } ElseBlock: {
                            SetByte(pn_dest, pn_di, pn_ch)
                            pn_di = Add(pn_di, 1)
                            JSTokState.pos = Add(JSTokState.pos, 1)
                        }
                        IfCondition GreaterEqual(JSTokState.pos, JSTokState.src_len) ThenBlock: {
                            pn_ch = 0
                        } ElseBlock: {
                            pn_ch = GetByte(JSTokState.source, JSTokState.pos)
                        }
                    }
                    SetByte(pn_dest, pn_di, 0)
                    JSTokState.str_pos = Add(JSTokState.str_pos, Add(pn_di, 1))
                    JSLex__AddToken(JSTokType.PRIVATE_NAME, pn_dest, pn_di)
                }
            }
            ReturnValue(1)
        }

        // Unknown char — skip it to avoid infinite loop
        JSLex__Advance()
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN TOKENIZE ENTRY POINT
// Scans source bytes in a WhileLoop, dispatching to sub-scanners.
// =============================================================================
Function.JSLex_Tokenize {
    Input: source: Address
    Input: src_len: Integer
    Output: Integer
    Body: {
        JSTokState.source = source
        JSTokState.src_len = src_len
        JSTokState.pos = 0
        JSTokState.line = 1
        JSTokState.col = 1
        JSTokState.error = 0
        JSTokState.tok_count = 0
        JSTokState.str_pos = 0
        JSTokState.last_type = 0
        JSTokState.paren_sp = 0
        JSTokState.rparen_is_ctrl = 0

        JSTokTmp.ch = JSLex__Peek()

        WhileLoop And(NotEqual(JSTokTmp.ch, 0), EqualTo(JSTokState.error, 0)) {

            // ─── WHITESPACE ───
            IfCondition Or(Or(EqualTo(JSTokTmp.ch, 32), EqualTo(JSTokTmp.ch, 9)),
                          Or(EqualTo(JSTokTmp.ch, 10), EqualTo(JSTokTmp.ch, 13))) ThenBlock: {
                JSLex__SkipWS()
            }

            // ─── SLASH: // comment, /* comment, /regex/, / division, /= ───
            IfCondition EqualTo(JSTokTmp.ch, 47) ThenBlock: {
                JSTokTmp.ch2 = JSLex__PeekAt(1)
                IfCondition EqualTo(JSTokTmp.ch2, 47) ThenBlock: {
                    // Line comment
                    JSLex__SkipLineComment()
                }
                IfCondition EqualTo(JSTokTmp.ch2, 42) ThenBlock: {
                    // Block comment
                    JSLex__SkipBlockComment()
                }
                // If neither // nor /*, determine regex vs division by context
                IfCondition And(NotEqual(JSTokTmp.ch2, 47), NotEqual(JSTokTmp.ch2, 42)) ThenBlock: {
                    // Lookup table: is "/" after last_type a division?
                    lt = JSTokState.last_type
                    is_div = GetByte(JSTokState.div_table, lt)
                    // Override: RPAREN after control-flow keyword → regex, not division
                    IfCondition And(EqualTo(lt, 11), EqualTo(JSTokState.rparen_is_ctrl, 1)) ThenBlock: {
                        is_div = 0
                    }

                    IfCondition EqualTo(is_div, 1) ThenBlock: {
                        // Division operator or /=
                        JSLex__ScanOp()
                    }
                    IfCondition EqualTo(is_div, 0) ThenBlock: {
                        // Regex literal
                        JSLex__ScanRegexLit()
                    }
                }
            }

            // ─── IDENTIFIERS & KEYWORDS: [a-zA-Z_$] ───
            // Must check after whitespace/comments to avoid re-scanning
            IfCondition And(And(NotEqual(JSTokTmp.ch, 32), NotEqual(JSTokTmp.ch, 9)),
                           And(NotEqual(JSTokTmp.ch, 10), NotEqual(JSTokTmp.ch, 13))) ThenBlock: {
                IfCondition NotEqual(JSTokTmp.ch, 47) ThenBlock: {
                    is_id = JSLex__IsIdentStart(JSTokTmp.ch)
                    IfCondition EqualTo(is_id, 1) ThenBlock: {
                        JSLex__ScanIdent()
                    }

                    // ─── NUMBERS: [0-9] ───
                    IfCondition EqualTo(is_id, 0) ThenBlock: {
                        is_num = JSLex__IsDigit(JSTokTmp.ch)
                        IfCondition EqualTo(is_num, 1) ThenBlock: {
                            JSLex__ScanNumber()
                        }

                        // ─── STRINGS: " or ' or ` ───
                        IfCondition EqualTo(is_num, 0) ThenBlock: {
                            // Save original ch before sub-scanners can clobber JSTokTmp.ch
                            saved_ch = JSTokTmp.ch
                            IfCondition EqualTo(saved_ch, 34) ThenBlock: {
                                JSTokTmp.quote = 34
                                JSLex__ScanString()
                            }
                            IfCondition EqualTo(saved_ch, 39) ThenBlock: {
                                JSTokTmp.quote = 39
                                JSLex__ScanString()
                            }
                            // ─── TEMPLATE LITERALS: ` ───
                            IfCondition EqualTo(saved_ch, 96) ThenBlock: {
                                JSLex__Advance()
                                JSLex__ScanTemplate(0)
                            }

                            // ─── OPERATORS & PUNCTUATION ───
                            IfCondition And(And(NotEqual(saved_ch, 34), NotEqual(saved_ch, 39)), NotEqual(saved_ch, 96)) ThenBlock: {
                                JSLex__ScanOp()
                            }
                        }
                    }
                }
            }

            JSTokTmp.ch = JSLex__Peek()
        }

        // EOF token
        JSLex__AddToken(JSTokType.EOF, 0, 0)

        // If error was set (e.g. invalid template escape), return 0
        IfCondition EqualTo(JSTokState.error, 1) ThenBlock: {
            ReturnValue(0)
        }

        ReturnValue(JSTokState.tok_count)
    }
}

// =============================================================================
// PUBLIC ACCESSORS
// =============================================================================
Function.JSLex_Count {
    Output: Integer
    Body: { ReturnValue(JSTokState.tok_count) }
}

Function.JSLex_GetType {
    Input: idx: Integer
    Output: Integer
    Body: {
        base = Add(JSTokState.tok_pool, Multiply(idx, JSTokConst.TOKEN_SIZE))
        ReturnValue(Dereference(Add(base, JSTokConst.T_TYPE)))
    }
}

Function.JSLex_GetPtr {
    Input: idx: Integer
    Output: Address
    Body: {
        base = Add(JSTokState.tok_pool, Multiply(idx, JSTokConst.TOKEN_SIZE))
        ReturnValue(Dereference(Add(base, JSTokConst.T_PTR)))
    }
}

Function.JSLex_GetLen {
    Input: idx: Integer
    Output: Integer
    Body: {
        base = Add(JSTokState.tok_pool, Multiply(idx, JSTokConst.TOKEN_SIZE))
        ReturnValue(Dereference(Add(base, JSTokConst.T_LEN)))
    }
}

Function.JSLex_GetLine {
    Input: idx: Integer
    Output: Integer
    Body: {
        base = Add(JSTokState.tok_pool, Multiply(idx, JSTokConst.TOKEN_SIZE))
        ReturnValue(Dereference(Add(base, JSTokConst.T_LINE)))
    }
}
