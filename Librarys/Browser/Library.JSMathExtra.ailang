// Math.trunc/sign/imul/clz32/hypot/log2/log10 and Number.isNaN/isFinite/isInteger/isSafeInteger.
// No FixedPool: float bits ride on the existing JSRT stack across calls.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Browser.JSRuntime

// NaN bits 9221120237041090560. +Inf 9218868437227405312. -Inf -4503599627370496.
// -0 bits -9223372036854775808. Exponent mask equals +Inf bits.

Function.JSMath__Bind {
    Input: obj: Address
    Input: name: Address
    Input: hid: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        save_obj = obj
        save_name = name
        save_id = hid
        save_len = len
        JSRT__Push(save_obj)
        JSRT__Push(save_name)
        fn = JSBridge__CreateNativeFunc(save_id, save_name, save_len)
        save_name = JSRT__Pop()
        save_obj = JSRT__Pop()
        IfCondition EqualTo(fn, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSRT_ObjSet(save_obj, save_name, fn)
        JSBridge__SetAttrBits(save_obj, save_name, 5)
        ReturnValue(1)
    }
}

Function.JSMath_Install {
    Output: Integer
    Body: {
        math = JSVM__GetGlobal("Math")
        IfCondition Or(EqualTo(JSRT_GetType(math), JSType.OBJECT), EqualTo(JSRT_GetType(math), JSType.FUNCTION)) ThenBlock: {
            JSMath__Bind(math, "trunc", 365, 1)
            math = JSVM__GetGlobal("Math")
            JSMath__Bind(math, "sign", 366, 1)
            math = JSVM__GetGlobal("Math")
            JSMath__Bind(math, "imul", 367, 2)
            math = JSVM__GetGlobal("Math")
            JSMath__Bind(math, "clz32", 368, 1)
            math = JSVM__GetGlobal("Math")
            JSMath__Bind(math, "hypot", 369, 2)
            math = JSVM__GetGlobal("Math")
            JSMath__Bind(math, "log2", 370, 1)
            math = JSVM__GetGlobal("Math")
            JSMath__Bind(math, "log10", 371, 1)
        }
        num = JSVM__GetGlobal("Number")
        IfCondition Or(EqualTo(JSRT_GetType(num), JSType.OBJECT), EqualTo(JSRT_GetType(num), JSType.FUNCTION)) ThenBlock: {
            JSMath__Bind(num, "isNaN", 372, 1)
            num = JSVM__GetGlobal("Number")
            JSMath__Bind(num, "isFinite", 373, 1)
            num = JSVM__GetGlobal("Number")
            JSMath__Bind(num, "isInteger", 374, 1)
            num = JSVM__GetGlobal("Number")
            JSMath__Bind(num, "isSafeInteger", 375, 1)
        }
        JSMath_InstallMore()
        ReturnValue(1)
    }
}

Function.JSMath__ArgBits {
    Input: args: Address
    Input: argc: Integer
    Input: idx: Integer
    Output: Integer
    Body: {
        save_args = args
        save_argc = argc
        save_idx = idx
        IfCondition LessEqual(save_argc, save_idx) ThenBlock: {
            // missing arg → NaN
            ReturnValue(9221120237041090560)
        }
        arg = RDMEM_64(save_args, Multiply(save_idx, 8))
        n = JSRT_ToNumber(arg)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(n)
    }
}

Function.JSMath__Trunc {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        n = JSMath__ArgBits(save_args, save_argc, 0)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        expf = BitwiseAnd(n, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(n))
        }
        IfCondition EqualTo(n, -9223372036854775808) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(n))
        }
        ab = Float_Abs(n)
        lim = Float_FromInt(4503599627370496)
        IfCondition EqualTo(Float_Ge(ab, lim), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(n))
        }
        t = Float_FromInt(Float_ToInt(n))
        IfCondition And(EqualTo(Float_Eq(t, 0), 1), EqualTo(Float_Lt(n, 0), 1)) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(-9223372036854775808))
        }
        ReturnValue(JSRT_CreateFloat(t))
    }
}

Function.JSMath__Sign {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        n = JSMath__ArgBits(save_args, save_argc, 0)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition EqualTo(Float_Ne(n, n), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        IfCondition Or(EqualTo(n, 0), EqualTo(n, -9223372036854775808)) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(n))
        }
        IfCondition EqualTo(Float_Gt(n, 0), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(Float_FromInt(1)))
        }
        ReturnValue(JSRT_CreateFloat(Float_FromInt(-1)))
    }
}

Function.JSMath__Imul {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        a = 0
        b = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            a = JSParse_ToInt32(RDMEM_64(save_args))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
        }
        IfCondition GreaterThan(save_argc, 1) ThenBlock: {
            b = JSParse_ToInt32(RDMEM_64(save_args, 8))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
        }
        prod = Multiply(a, b)
        low = BitwiseAnd(prod, 4294967295)
        IfCondition GreaterEqual(low, 2147483648) ThenBlock: {
            low = Subtract(low, 4294967296)
        }
        ReturnValue(JSRT_CreateFloat(Float_FromInt(low)))
    }
}

Function.JSMath__Clz32 {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        s = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            s = JSParse_ToInt32(RDMEM_64(save_args))
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
        }
        IfCondition LessThan(s, 0) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(Float_FromInt(0)))
        }
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(Float_FromInt(32)))
        }
        c = 0
        WhileLoop And(LessThan(s, 2147483648), LessThan(c, 32)) {
            s = Multiply(s, 2)
            c = Add(c, 1)
        }
        ReturnValue(JSRT_CreateFloat(Float_FromInt(c)))
    }
}

Function.JSMath__Hypot {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        has_inf = 0
        has_nan = 0
        maxb = 0
        i = 0
        WhileLoop LessThan(i, save_argc) {
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            JSRT__Push(i)
            JSRT__Push(has_inf)
            JSRT__Push(has_nan)
            JSRT__Push(maxb)
            n = JSMath__ArgBits(save_args, save_argc, i)
            maxb = JSRT__Pop()
            has_nan = JSRT__Pop()
            has_inf = JSRT__Pop()
            i = JSRT__Pop()
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                ReturnValue(JSRT_Undefined())
            }
            expf = BitwiseAnd(n, 9218868437227405312)
            IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
                IfCondition EqualTo(Float_Ne(n, n), 1) ThenBlock: {
                    has_nan = 1
                } ElseBlock: {
                    has_inf = 1
                }
            } ElseBlock: {
                ab = Float_Abs(n)
                IfCondition EqualTo(Float_Gt(ab, maxb), 1) ThenBlock: {
                    maxb = ab
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(has_inf, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9218868437227405312))
        }
        IfCondition EqualTo(has_nan, 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        IfCondition EqualTo(Float_Eq(maxb, 0), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(0))
        }
        sum = 0
        i = 0
        WhileLoop LessThan(i, save_argc) {
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            JSRT__Push(i)
            JSRT__Push(maxb)
            JSRT__Push(sum)
            n2 = JSMath__ArgBits(save_args, save_argc, i)
            sum = JSRT__Pop()
            maxb = JSRT__Pop()
            i = JSRT__Pop()
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            exp2 = BitwiseAnd(n2, 9218868437227405312)
            IfCondition NotEqual(exp2, 9218868437227405312) ThenBlock: {
                r = Float_Div(n2, maxb)
                sum = Float_Add(sum, Float_Mul(r, r))
            }
            i = Add(i, 1)
        }
        outb = Float_Mul(maxb, Float_Sqrt(sum))
        ReturnValue(JSRT_CreateFloat(outb))
    }
}

Function.JSMath__Log2 {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        n = JSMath__ArgBits(save_args, save_argc, 0)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition EqualTo(Float_Ne(n, n), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        IfCondition EqualTo(n, 9218868437227405312) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(n))
        }
        IfCondition Or(EqualTo(n, 0), EqualTo(n, -9223372036854775808)) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(-4503599627370496))
        }
        IfCondition EqualTo(Float_Lt(n, 0), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        exp_bits = BitwiseAnd(RightShift(n, 52), 2047)
        exp_val = Subtract(exp_bits, 1023)
        mant = BitwiseAnd(n, 4503599627370495)
        IfCondition EqualTo(mant, 0) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(Float_FromInt(exp_val)))
        }
        // ln(m)/ln(2) + exp, m in [1, 2)
        m = BitwiseOr(mant, 4607182418800017408)
        JSRT__Push(exp_val)
        lv = JSBridge__MathLogBits(m)
        exp_val = JSRT__Pop()
        q = Float_Div(lv, JSMathConst.LN2)
        outb = Float_Add(q, Float_FromInt(exp_val))
        ReturnValue(JSRT_CreateFloat(outb))
    }
}

Function.JSMath__Log10 {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        n = JSMath__ArgBits(save_args, save_argc, 0)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        IfCondition EqualTo(Float_Ne(n, n), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        IfCondition EqualTo(n, 9218868437227405312) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(n))
        }
        IfCondition Or(EqualTo(n, 0), EqualTo(n, -9223372036854775808)) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(-4503599627370496))
        }
        IfCondition EqualTo(Float_Lt(n, 0), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(9221120237041090560))
        }
        IfCondition EqualTo(Float_Eq(n, Float_FromInt(1)), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(0))
        }
        IfCondition EqualTo(Float_Eq(n, Float_FromInt(10)), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(Float_FromInt(1)))
        }
        IfCondition EqualTo(Float_Eq(n, Float_FromInt(100)), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(Float_FromInt(2)))
        }
        IfCondition EqualTo(Float_Eq(n, Float_FromInt(1000)), 1) ThenBlock: {
            ReturnValue(JSRT_CreateFloat(Float_FromInt(3)))
        }
        lx = JSBridge__MathLogBits(n)
        l10 = JSBridge__MathLogBits(Float_FromInt(10))
        ReturnValue(JSRT_CreateFloat(Float_Div(lx, l10)))
    }
}

// ln of a positive finite bit pattern. 0 if the value is not usable.
Function.JSBridge__MathLogBits {
    Input: bits: Integer
    Output: Integer
    Body: {
        save_b = bits
        nv = JSRT_CreateFloat(save_b)
        JSRT__Push(nv)
        slot = Allocate(8)
        nv = JSRT__Pop()
        WRMEM_64(slot, nv)
        lv = JSBridge__MathLog(slot, 1)
        JSRT__Push(lv)
        Deallocate(slot, 8)
        lv = JSRT__Pop()
        IfCondition NotEqual(JSRT_GetType(lv), JSType.NUMBER) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(JSRT_GetPayload(lv))
    }
}

Function.JSMath__IsNum {
    Input: args: Address
    Input: argc: Integer
    Output: Integer
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(0)
        }
        arg = RDMEM_64(save_args)
        IfCondition NotEqual(JSRT_GetType(arg), JSType.NUMBER) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(JSRT_GetPayload(arg))
    }
}

Function.JSMath__IsNaN {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        arg = RDMEM_64(save_args)
        IfCondition NotEqual(JSRT_GetType(arg), JSType.NUMBER) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        n = JSRT_GetPayload(arg)
        ReturnValue(JSRT_CreateBool(Float_Ne(n, n)))
    }
}

Function.JSMath__IsFinite {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        arg = RDMEM_64(save_args)
        IfCondition NotEqual(JSRT_GetType(arg), JSType.NUMBER) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        n = JSRT_GetPayload(arg)
        expf = BitwiseAnd(n, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        ReturnValue(JSRT_CreateBool(1))
    }
}

Function.JSMath__IsInteger {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        arg = RDMEM_64(save_args)
        IfCondition NotEqual(JSRT_GetType(arg), JSType.NUMBER) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        n = JSRT_GetPayload(arg)
        expf = BitwiseAnd(n, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        ab = Float_Abs(n)
        lim = Float_FromInt(4503599627370496)
        IfCondition EqualTo(Float_Ge(ab, lim), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        t = Float_FromInt(Float_ToInt(ab))
        IfCondition EqualTo(Float_Ne(t, ab), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        ReturnValue(JSRT_CreateBool(1))
    }
}

Function.JSMath__IsSafeInteger {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        IfCondition LessThan(save_argc, 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        arg = RDMEM_64(save_args)
        IfCondition NotEqual(JSRT_GetType(arg), JSType.NUMBER) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        n = JSRT_GetPayload(arg)
        expf = BitwiseAnd(n, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        ab = Float_Abs(n)
        mx = Float_FromInt(9007199254740991)
        IfCondition EqualTo(Float_Gt(ab, mx), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        // Every finite value in [2^52, 2^53-1] is an integer.
        lim = Float_FromInt(4503599627370496)
        IfCondition EqualTo(Float_Ge(ab, lim), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(1))
        }
        t = Float_FromInt(Float_ToInt(ab))
        IfCondition EqualTo(Float_Ne(t, ab), 1) ThenBlock: {
            ReturnValue(JSRT_CreateBool(0))
        }
        ReturnValue(JSRT_CreateBool(1))
    }
}

// Floor / ceil / round on the IEEE bits. Float_ToInt is only safe for |n| < 2^63.
Function.JSMath__FloorBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        expf = BitwiseAnd(save_n, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            ReturnValue(save_n)
        }
        IfCondition Or(EqualTo(save_n, 0), EqualTo(save_n, -9223372036854775808)) ThenBlock: {
            ReturnValue(save_n)
        }
        mag = BitwiseAnd(save_n, 9223372036854775807)
        ebits = RightShift(BitwiseAnd(mag, 9218868437227405312), 52)
        sign = 0
        IfCondition LessThan(save_n, 0) ThenBlock: { sign = 1 }
        // |x| < 1, including subnormals.
        IfCondition LessThan(ebits, 1023) ThenBlock: {
            IfCondition EqualTo(sign, 1) ThenBlock: {
                ReturnValue(Float_Neg(Float_FromInt(1)))
            }
            ReturnValue(0)
        }
        unb = Subtract(ebits, 1023)
        IfCondition GreaterEqual(unb, 52) ThenBlock: {
            ReturnValue(save_n)
        }
        drop = Subtract(52, unb)
        mask = Subtract(ShiftLeft(1, drop), 1)
        frac = BitwiseAnd(mag, mask)
        IfCondition EqualTo(frac, 0) ThenBlock: {
            ReturnValue(save_n)
        }
        trunc_mag = BitwiseAnd(mag, BitwiseNot(mask))
        IfCondition EqualTo(sign, 0) ThenBlock: {
            ReturnValue(trunc_mag)
        }
        ReturnValue(Float_Neg(Float_Add(trunc_mag, Float_FromInt(1))))
    }
}

Function.JSMath__CeilBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        expf = BitwiseAnd(save_n, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            ReturnValue(save_n)
        }
        IfCondition Or(EqualTo(save_n, 0), EqualTo(save_n, -9223372036854775808)) ThenBlock: {
            ReturnValue(save_n)
        }
        mag = BitwiseAnd(save_n, 9223372036854775807)
        ebits = RightShift(BitwiseAnd(mag, 9218868437227405312), 52)
        sign = 0
        IfCondition LessThan(save_n, 0) ThenBlock: { sign = 1 }
        IfCondition LessThan(ebits, 1023) ThenBlock: {
            IfCondition EqualTo(sign, 1) ThenBlock: {
                ReturnValue(-9223372036854775808)
            }
            ReturnValue(Float_FromInt(1))
        }
        unb = Subtract(ebits, 1023)
        IfCondition GreaterEqual(unb, 52) ThenBlock: {
            ReturnValue(save_n)
        }
        drop = Subtract(52, unb)
        mask = Subtract(ShiftLeft(1, drop), 1)
        frac = BitwiseAnd(mag, mask)
        IfCondition EqualTo(frac, 0) ThenBlock: {
            ReturnValue(save_n)
        }
        trunc_mag = BitwiseAnd(mag, BitwiseNot(mask))
        IfCondition EqualTo(sign, 0) ThenBlock: {
            ReturnValue(Float_Add(trunc_mag, Float_FromInt(1)))
        }
        IfCondition EqualTo(trunc_mag, 0) ThenBlock: {
            ReturnValue(-9223372036854775808)
        }
        ReturnValue(Float_Neg(trunc_mag))
    }
}

Function.JSMath__RoundBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        expf = BitwiseAnd(save_n, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            ReturnValue(save_n)
        }
        IfCondition Or(EqualTo(save_n, 0), EqualTo(save_n, -9223372036854775808)) ThenBlock: {
            ReturnValue(save_n)
        }
        ab = Float_Abs(save_n)
        IfCondition EqualTo(Float_Ge(ab, Float_FromInt(4503599627370496)), 1) ThenBlock: {
            ReturnValue(save_n)
        }
        half = 4602678819172646912
        IfCondition And(EqualTo(Float_Gt(save_n, 0), 1), EqualTo(Float_Lt(save_n, half), 1)) ThenBlock: {
            ReturnValue(0)
        }
        nh = Float_Neg(half)
        IfCondition And(EqualTo(Float_Lt(save_n, 0), 1), EqualTo(Float_Ge(save_n, nh), 1)) ThenBlock: {
            ReturnValue(-9223372036854775808)
        }
        sum = Float_Add(save_n, half)
        ReturnValue(JSMath__FloorBits(sum))
    }
}

Function.JSMath__Floor {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        n = JSMath__ArgBits(save_args, save_argc, 0)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(JSRT_CreateFloat(JSMath__FloorBits(n)))
    }
}

