    }
}

Function.JSMath__Round {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        n = JSMath__ArgBits(save_args, save_argc, 0)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(JSRT_CreateFloat(JSMath__RoundBits(n)))
    }
}

Function.JSMath_Call {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        IfCondition EqualTo(save_id, 365) ThenBlock: {
            ReturnValue(JSMath__Trunc(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 366) ThenBlock: {
            ReturnValue(JSMath__Sign(save_args, save_argc))
        }
