Function.JSMath_CallMore {
    Input: native_id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = native_id
        save_args = args
        save_argc = argc
        IfCondition EqualTo(save_id, 379) ThenBlock: {
            ReturnValue(JSMath__Fround(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 380) ThenBlock: {
            ReturnValue(JSMath__F16Round(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 381) ThenBlock: {
            ReturnValue(JSMath__Atan(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 382) ThenBlock: {
            ReturnValue(JSMath__Cbrt(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 383) ThenBlock: {
            ReturnValue(JSMath__Expm1(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 384) ThenBlock: {
            ReturnValue(JSMath__Log1p(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 385) ThenBlock: {
            ReturnValue(JSMath__Asin(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 386) ThenBlock: {
            ReturnValue(JSMath__Acos(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 387) ThenBlock: {
            ReturnValue(JSMath__Acosh(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 388) ThenBlock: {
            ReturnValue(JSMath__Asinh(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 389) ThenBlock: {
            ReturnValue(JSMath__Atanh(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 390) ThenBlock: {
            ReturnValue(JSMath__Cosh(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 391) ThenBlock: {
            ReturnValue(JSMath__Sinh(save_args, save_argc))
        }
        IfCondition EqualTo(save_id, 392) ThenBlock: {
            ReturnValue(JSMath__Tanh(save_args, save_argc))
        }
        ReturnValue(JSRT_Undefined())
    }
}

