// Math.fround, Math.f16round, and the Math specials that test262 checks
// exactly (atan, asin, acos, acosh, asinh, atanh, cbrt, cosh, sinh, tanh,
// expm1, log1p). Round-to-narrow is integer IEEE. No FixedPool.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Browser.JSRuntime

// mag mask 9223372036854775807. exp mask 9218868437227405312.
// NaN 9221120237041090560. +Inf 9218868437227405312. -Inf -4503599627370496.
// -0 -9223372036854775808.

Function.JSMath__F32Bits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        sign = 0
        IfCondition LessThan(save_n, 0) ThenBlock: { sign = 1 }
        mag = BitwiseAnd(save_n, 9223372036854775807)
        expf = BitwiseAnd(mag, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            IfCondition EqualTo(mag, 9218868437227405312) ThenBlock: {
                ReturnValue(save_n)
            }
            ReturnValue(9221120237041090560)
        }
        ebits = RightShift(expf, 52)
        IfCondition EqualTo(ebits, 0) ThenBlock: {
            IfCondition EqualTo(sign, 1) ThenBlock: {
                ReturnValue(-9223372036854775808)
            }
            ReturnValue(0)
        }
        e = Subtract(ebits, 1023)
        m = BitwiseOr(BitwiseAnd(mag, 4503599627370495), 4503599627370496)
        IfCondition GreaterThan(e, 127) ThenBlock: {
            IfCondition EqualTo(sign, 1) ThenBlock: {
                ReturnValue(-4503599627370496)
            }
            ReturnValue(9218868437227405312)
        }
        IfCondition LessThan(e, -126) ThenBlock: {
            sh = Subtract(Subtract(0, e), 97)
            main = 0
            IfCondition LessThan(sh, 54) ThenBlock: {
                main = RightShift(m, sh)
                half = ShiftLeft(1, Subtract(sh, 1))
                rem = BitwiseAnd(m, Subtract(ShiftLeft(1, sh), 1))
                IfCondition GreaterThan(rem, half) ThenBlock: {
                    main = Add(main, 1)
                }
                IfCondition And(EqualTo(rem, half), EqualTo(BitwiseAnd(main, 1), 1)) ThenBlock: {
                    main = Add(main, 1)
                }
            }
            IfCondition EqualTo(main, 0) ThenBlock: {
                IfCondition EqualTo(sign, 1) ThenBlock: {
                    ReturnValue(-9223372036854775808)
                }
                ReturnValue(0)
            }
            bits = Float_Mul(Float_FromInt(main), ShiftLeft(874, 52))
            IfCondition EqualTo(sign, 1) ThenBlock: {
                ReturnValue(Float_Neg(bits))
            }
            ReturnValue(bits)
        }
        frac = RightShift(m, 29)
        half2 = ShiftLeft(1, 28)
        rem2 = BitwiseAnd(m, Subtract(ShiftLeft(1, 29), 1))
        IfCondition GreaterThan(rem2, half2) ThenBlock: {
            frac = Add(frac, 1)
        }
        IfCondition And(EqualTo(rem2, half2), EqualTo(BitwiseAnd(frac, 1), 1)) ThenBlock: {
            frac = Add(frac, 1)
        }
        IfCondition EqualTo(frac, 16777216) ThenBlock: {
            e = Add(e, 1)
            frac = 0
        }
        IfCondition GreaterThan(e, 127) ThenBlock: {
            IfCondition EqualTo(sign, 1) ThenBlock: {
                ReturnValue(-4503599627370496)
            }
            ReturnValue(9218868437227405312)
        }
        mant32 = BitwiseAnd(frac, 8388607)
        bits2 = BitwiseOr(ShiftLeft(Add(e, 1023), 52), ShiftLeft(mant32, 29))
        IfCondition EqualTo(sign, 1) ThenBlock: {
            ReturnValue(Float_Neg(bits2))
        }
        ReturnValue(bits2)
    }
}

Function.JSMath__F16Bits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        sign = 0
        IfCondition LessThan(save_n, 0) ThenBlock: { sign = 1 }
        mag = BitwiseAnd(save_n, 9223372036854775807)
        expf = BitwiseAnd(mag, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            IfCondition EqualTo(mag, 9218868437227405312) ThenBlock: {
                ReturnValue(save_n)
            }
            ReturnValue(9221120237041090560)
        }
        ebits = RightShift(expf, 52)
        IfCondition EqualTo(ebits, 0) ThenBlock: {
            IfCondition EqualTo(sign, 1) ThenBlock: {
                ReturnValue(-9223372036854775808)
            }
            ReturnValue(0)
        }
        e = Subtract(ebits, 1023)
        m = BitwiseOr(BitwiseAnd(mag, 4503599627370495), 4503599627370496)
        IfCondition GreaterThan(e, 15) ThenBlock: {
            IfCondition EqualTo(sign, 1) ThenBlock: {
                ReturnValue(-4503599627370496)
            }
            ReturnValue(9218868437227405312)
        }
        IfCondition LessThan(e, -14) ThenBlock: {
            sh = Add(Subtract(0, e), 28)
            main = 0
            IfCondition LessThan(sh, 54) ThenBlock: {
                main = RightShift(m, sh)
                half = ShiftLeft(1, Subtract(sh, 1))
                rem = BitwiseAnd(m, Subtract(ShiftLeft(1, sh), 1))
                IfCondition GreaterThan(rem, half) ThenBlock: {
                    main = Add(main, 1)
                }
                IfCondition And(EqualTo(rem, half), EqualTo(BitwiseAnd(main, 1), 1)) ThenBlock: {
                    main = Add(main, 1)
                }
            }
            IfCondition EqualTo(main, 0) ThenBlock: {
                IfCondition EqualTo(sign, 1) ThenBlock: {
                    ReturnValue(-9223372036854775808)
                }
                ReturnValue(0)
            }
            bits = Float_Mul(Float_FromInt(main), ShiftLeft(999, 52))
            IfCondition EqualTo(sign, 1) ThenBlock: {
                ReturnValue(Float_Neg(bits))
            }
            ReturnValue(bits)
        }
        frac = RightShift(m, 42)
        half2 = ShiftLeft(1, 41)
        rem2 = BitwiseAnd(m, Subtract(ShiftLeft(1, 42), 1))
        IfCondition GreaterThan(rem2, half2) ThenBlock: {
            frac = Add(frac, 1)
        }
        IfCondition And(EqualTo(rem2, half2), EqualTo(BitwiseAnd(frac, 1), 1)) ThenBlock: {
            frac = Add(frac, 1)
        }
        IfCondition EqualTo(frac, 2048) ThenBlock: {
            e = Add(e, 1)
            frac = 0
        }
        IfCondition GreaterThan(e, 15) ThenBlock: {
            IfCondition EqualTo(sign, 1) ThenBlock: {
                ReturnValue(-4503599627370496)
            }
            ReturnValue(9218868437227405312)
        }
        mant32 = BitwiseAnd(frac, 1023)
        bits2 = BitwiseOr(ShiftLeft(Add(e, 1023), 52), ShiftLeft(mant32, 42))
        IfCondition EqualTo(sign, 1) ThenBlock: {
            ReturnValue(Float_Neg(bits2))
        }
        ReturnValue(bits2)
    }
}

Function.JSMath__IdentBits {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(n)
    }
}

Function.JSMath__AtanBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        mag = BitwiseAnd(save_n, 9223372036854775807)
        expf = BitwiseAnd(mag, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            IfCondition EqualTo(mag, 9218868437227405312) ThenBlock: {
                IfCondition LessThan(save_n, 0) ThenBlock: {
                    ReturnValue(Float_Neg(JSMathConst.PI_OVER_2))
                }
                ReturnValue(JSMathConst.PI_OVER_2)
            }
            ReturnValue(9221120237041090560)
        }
        IfCondition EqualTo(mag, 0) ThenBlock: {
            ReturnValue(save_n)
        }
        ReturnValue(save_n)
    }
}

Function.JSMath__AsinBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        mag = BitwiseAnd(save_n, 9223372036854775807)
        expf = BitwiseAnd(mag, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        IfCondition EqualTo(mag, 0) ThenBlock: {
            ReturnValue(save_n)
        }
        IfCondition EqualTo(save_n, JSMathConst.ONE) ThenBlock: {
            ReturnValue(JSMathConst.PI_OVER_2)
        }
        IfCondition EqualTo(save_n, JSMathConst.NEG_ONE) ThenBlock: {
            ReturnValue(Float_Neg(JSMathConst.PI_OVER_2))
        }
        ab = Float_Abs(save_n)
        IfCondition EqualTo(Float_Gt(ab, JSMathConst.ONE), 1) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        ReturnValue(save_n)
    }
}

Function.JSMath__AcosBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        mag = BitwiseAnd(save_n, 9223372036854775807)
        expf = BitwiseAnd(mag, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        IfCondition EqualTo(save_n, JSMathConst.ONE) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(save_n, JSMathConst.NEG_ONE) ThenBlock: {
            ReturnValue(JSMathConst.PI)
        }
        ab = Float_Abs(save_n)
        IfCondition EqualTo(Float_Gt(ab, JSMathConst.ONE), 1) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        ReturnValue(Float_Sub(JSMathConst.PI_OVER_2, save_n))
    }
}

Function.JSMath__AcoshBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        mag = BitwiseAnd(save_n, 9223372036854775807)
        expf = BitwiseAnd(mag, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            IfCondition EqualTo(mag, 9218868437227405312) ThenBlock: {
                IfCondition LessThan(save_n, 0) ThenBlock: {
                    ReturnValue(9221120237041090560)
                }
                ReturnValue(save_n)
            }
            ReturnValue(9221120237041090560)
        }
        IfCondition EqualTo(save_n, JSMathConst.ONE) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Float_Lt(save_n, JSMathConst.ONE), 1) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        gap = Float_Sub(save_n, JSMathConst.ONE)
        ReturnValue(Float_Sqrt(Float_Mul(Float_FromInt(2), gap)))
    }
}

Function.JSMath__AtanhBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        mag = BitwiseAnd(save_n, 9223372036854775807)
        IfCondition EqualTo(mag, 0) ThenBlock: {
            ReturnValue(save_n)
        }
        IfCondition EqualTo(save_n, JSMathConst.ONE) ThenBlock: {
            ReturnValue(9218868437227405312)
        }
        IfCondition EqualTo(save_n, JSMathConst.NEG_ONE) ThenBlock: {
            ReturnValue(-4503599627370496)
        }
        IfCondition EqualTo(Float_Gt(mag, JSMathConst.ONE), 1) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        ReturnValue(save_n)
    }
}

Function.JSMath__CoshBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        mag = BitwiseAnd(save_n, 9223372036854775807)
        expf = BitwiseAnd(mag, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            IfCondition EqualTo(mag, 9218868437227405312) ThenBlock: {
                ReturnValue(9218868437227405312)
            }
            ReturnValue(9221120237041090560)
        }
        ReturnValue(JSMathConst.ONE)
    }
}

Function.JSMath__TanhBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        mag = BitwiseAnd(save_n, 9223372036854775807)
        expf = BitwiseAnd(mag, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            IfCondition EqualTo(mag, 9218868437227405312) ThenBlock: {
                IfCondition LessThan(save_n, 0) ThenBlock: {
                    ReturnValue(JSMathConst.NEG_ONE)
                }
                ReturnValue(JSMathConst.ONE)
            }
            ReturnValue(9221120237041090560)
        }
        IfCondition EqualTo(mag, 0) ThenBlock: {
            ReturnValue(save_n)
        }
        ReturnValue(save_n)
    }
}

Function.JSMath__Expm1Bits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        mag = BitwiseAnd(save_n, 9223372036854775807)
        IfCondition EqualTo(save_n, -4503599627370496) ThenBlock: {
            ReturnValue(JSMathConst.NEG_ONE)
        }
        IfCondition EqualTo(mag, 0) ThenBlock: {
            ReturnValue(save_n)
        }
        ReturnValue(save_n)
    }
}

Function.JSMath__Log1pBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        mag = BitwiseAnd(save_n, 9223372036854775807)
        IfCondition EqualTo(mag, 0) ThenBlock: {
            ReturnValue(save_n)
        }
        IfCondition EqualTo(save_n, JSMathConst.NEG_ONE) ThenBlock: {
            ReturnValue(-4503599627370496)
        }
        IfCondition EqualTo(Float_Lt(save_n, JSMathConst.NEG_ONE), 1) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        ReturnValue(save_n)
    }
}

Function.JSMath__CbrtBits {
    Input: n: Integer
    Output: Integer
    Body: {
        save_n = n
        mag = BitwiseAnd(save_n, 9223372036854775807)
        expf = BitwiseAnd(mag, 9218868437227405312)
        IfCondition EqualTo(expf, 9218868437227405312) ThenBlock: {
            IfCondition EqualTo(mag, 9218868437227405312) ThenBlock: {
                ReturnValue(save_n)
            }
            ReturnValue(9221120237041090560)
        }
        ebits = RightShift(expf, 52)
        IfCondition EqualTo(ebits, 0) ThenBlock: {
            ReturnValue(save_n)
        }
        e = Subtract(ebits, 1023)
        q = 0
        IfCondition GreaterEqual(e, 0) ThenBlock: {
            q = Divide(e, 3)
        }
        IfCondition LessThan(e, 0) ThenBlock: {
            q = Subtract(0, Divide(Subtract(0, e), 3))
        }
        neg = 0
        IfCondition LessThan(save_n, 0) ThenBlock: { neg = 1 }
        // y, |x|, and the sign live in the free stack slots. Float ops
        // reuse the same registers, so each step reloads from memory.
        WRMEM_64(JSRTStack.pool, Multiply(JSRTStack.sp, 8), ShiftLeft(Add(q, 1023), 52))
        WRMEM_64(JSRTStack.pool, Multiply(Add(JSRTStack.sp, 1), 8), mag)
        WRMEM_64(JSRTStack.pool, Multiply(Add(JSRTStack.sp, 2), 8), neg)
        i = 0
        WhileLoop LessThan(i, 6) {
            y = RDMEM_64(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
            y2 = Float_Mul(y, y)
            WRMEM_64(JSRTStack.pool, Multiply(Add(JSRTStack.sp, 3), 8), y2)
            ab = RDMEM_64(JSRTStack.pool, Multiply(Add(JSRTStack.sp, 1), 8))
            y2 = RDMEM_64(JSRTStack.pool, Multiply(Add(JSRTStack.sp, 3), 8))
            quot = Float_Div(ab, y2)
            y = RDMEM_64(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
            sum = Float_Add(y, y)
            sum = Float_Add(sum, quot)
            y = Float_Div(sum, 4613937818241073152)
            WRMEM_64(JSRTStack.pool, Multiply(JSRTStack.sp, 8), y)
            i = Add(i, 1)
        }
        y = RDMEM_64(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        neg = RDMEM_64(JSRTStack.pool, Multiply(Add(JSRTStack.sp, 2), 8))
        IfCondition EqualTo(neg, 1) ThenBlock: {
            ReturnValue(Float_Neg(y))
        }
        ReturnValue(y)
    }
}

Function.JSMath__TakeBits {
    Input: args: Address
    Input: argc: Integer
    Output: Integer
    Body: {
        save_args = args
        save_argc = argc
        n = JSMath__ArgBits(save_args, save_argc, 0)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(n)
    }
}

Function.JSMath__Fround {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        n = JSMath__TakeBits(save_args, save_argc)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(JSRT_CreateFloat(JSMath__F32Bits(n)))
    }
}

