// Number.prototype.toExponential and toPrecision.
// Big-integer scale uses the JSNumParse limb layout (base 2^32):
//   0 num[56], 448 den[56], 896 nlen, 904 dlen, 1000 cmp.
// Extra: 1024 quot[56], 1472 qlen, 1480 digits, 1600 text,
//   1792 saved den, 2240 saved dlen,
//   2248 sig, 2256 bexp, 2264 m, 2272 p, 2280 n, 2288 neg,
//   2296 ndigits, 2304 count, 2312 off, 2320 len_off, 2328 abs bits,
//   2336 kind, 2344 out_len, 2352 i, 2360 short, 2368 f,
//   2376 bitlen, 2384 shift, 2392 signed bits, 2400 go.
//   2416 is the Pow5 and ShlBits loop counter (not live together).
// Allocate(2560). Helpers return the buffer.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Browser.JSRuntime
LibraryImport.Browser.JSNumParse

Function.JSNum__Mul5At {
    Input: buf: Address
    Input: off: Integer
    Input: len_off: Integer
    Output: Address
    Body: {
        save = buf
        save_off = off
        save_lo = len_off
        nlen = RDMEM_64(save, save_lo)
        carry = 0
        i = 0
        WhileLoop LessThan(i, nlen) {
            limb = RDMEM_64(Add(save, save_off), Multiply(i, 8))
            v = Add(Multiply(limb, 5), carry)
            WRMEM_64(Add(save, save_off), Multiply(i, 8), BitwiseAnd(v, 4294967295))
            carry = RightShift(v, 32)
            i = Add(i, 1)
        }
        IfCondition GreaterThan(carry, 0) ThenBlock: {
            IfCondition GreaterEqual(nlen, 56) ThenBlock: {
                WRMEM_64(save, save_lo, -1)
            }
            IfCondition LessThan(nlen, 56) ThenBlock: {
                WRMEM_64(Add(save, save_off), Multiply(nlen, 8), carry)
                WRMEM_64(save, save_lo, Add(nlen, 1))
            }
        }
        ReturnValue(save)
    }
}

Function.JSNum__TrimAt {
    Input: buf: Address
    Input: off: Integer
    Input: len_off: Integer
    Output: Address
    Body: {
        save = buf
        save_off = off
        save_lo = len_off
        len = RDMEM_64(save, save_lo)
        go = 1
        WhileLoop And(EqualTo(go, 1), GreaterThan(len, 1)) {
            top = RDMEM_64(Add(save, save_off), Multiply(Subtract(len, 1), 8))
            IfCondition EqualTo(top, 0) ThenBlock: {
                len = Subtract(len, 1)
            } ElseBlock: {
                go = 0
            }
        }
        IfCondition LessThan(len, 1) ThenBlock: { len = 1 }
        WRMEM_64(save, save_lo, len)
        ReturnValue(save)
    }
}

Function.JSNum__ZeroAll {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        i = 0
        WhileLoop LessThan(i, 56) {
            WRMEM_64(save, Multiply(i, 8), 0)
            WRMEM_64(Add(save, 448), Multiply(i, 8), 0)
            WRMEM_64(Add(save, 1024), Multiply(i, 8), 0)
            i = Add(i, 1)
        }
        WRMEM_64(save, 896, 1)
        WRMEM_64(save, 904, 1)
        WRMEM_64(save, 1472, 1)
        ReturnValue(save)
    }
}

Function.JSNum__BitLen {
    Input: buf: Address
    Input: off: Integer
    Input: len_off: Integer
    Output: Address
    Body: {
        save = buf
        save_off = off
        save_lo = len_off
        len = RDMEM_64(save, save_lo)
        IfCondition LessEqual(len, 0) ThenBlock: {
            WRMEM_64(save, 2376, 0)
            ReturnValue(save)
        }
        top = RDMEM_64(Add(save, save_off), Multiply(Subtract(len, 1), 8))
        IfCondition EqualTo(top, 0) ThenBlock: {
            WRMEM_64(save, 2376, 0)
            ReturnValue(save)
        }
        bits = Multiply(Subtract(len, 1), 32)
        n = 0
        WhileLoop GreaterThan(top, 0) {
            top = RightShift(top, 1)
            n = Add(n, 1)
        }
        WRMEM_64(save, 2376, Add(bits, n))
        ReturnValue(save)
    }
}

Function.JSNum__ShlBits {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        // One-bit ShlAt. A wide shift in this function dropped the high limb
        // and invented a carry, so the bit count stays in the buffer.
        WRMEM_64(save, 2416, 0)
        WhileLoop LessThan(RDMEM_64(save, 2416), RDMEM_64(save, 2304)) {
            off = RDMEM_64(save, 2312)
            lo = RDMEM_64(save, 2320)
            save = JSNum__ShlAt(save, off, lo)
            lo = RDMEM_64(save, 2320)
            IfCondition EqualTo(RDMEM_64(save, lo), -1) ThenBlock: {
                WRMEM_64(save, 2416, RDMEM_64(save, 2304))
            }
            IfCondition NotEqual(RDMEM_64(save, lo), -1) ThenBlock: {
                WRMEM_64(save, 2416, Add(RDMEM_64(save, 2416), 1))
            }
        }
        ReturnValue(save)
    }
}

Function.JSNum__Pow5 {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        WRMEM_64(save, 2416, 0)
        WhileLoop LessThan(RDMEM_64(save, 2416), RDMEM_64(save, 2304)) {
            off = RDMEM_64(save, 2312)
            lo = RDMEM_64(save, 2320)
            save = JSNum__Mul5At(save, off, lo)
            lo = RDMEM_64(save, 2320)
            IfCondition EqualTo(RDMEM_64(save, lo), -1) ThenBlock: {
                WRMEM_64(save, 2416, RDMEM_64(save, 2304))
            }
            IfCondition NotEqual(RDMEM_64(save, lo), -1) ThenBlock: {
                WRMEM_64(save, 2416, Add(RDMEM_64(save, 2416), 1))
            }
        }
        ReturnValue(save)
    }
}

Function.JSNum__QuotInc {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        carry = 1
        i = 0
        len = RDMEM_64(save, 1472)
        go = 1
        WhileLoop EqualTo(go, 1) {
            IfCondition GreaterEqual(i, 56) ThenBlock: {
                WRMEM_64(save, 1472, -1)
                go = 0
            }
            IfCondition LessThan(i, 56) ThenBlock: {
                limb = 0
                IfCondition LessThan(i, len) ThenBlock: {
                    limb = RDMEM_64(Add(save, 1024), Multiply(i, 8))
                }
                v = Add(limb, carry)
                WRMEM_64(Add(save, 1024), Multiply(i, 8), BitwiseAnd(v, 4294967295))
                carry = RightShift(v, 32)
                IfCondition GreaterEqual(i, len) ThenBlock: {
                    len = Add(i, 1)
                    WRMEM_64(save, 1472, len)
                }
                IfCondition EqualTo(carry, 0) ThenBlock: { go = 0 }
                i = Add(i, 1)
            }
        }
        ReturnValue(save)
    }
}

Function.JSNum__Build {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        save = JSNum__ZeroAll(save)
        sig = RDMEM_64(save, 2248)
        limb0 = BitwiseAnd(sig, 4294967295)
        limb1 = RightShift(sig, 32)
        WRMEM_64(save, limb0)
        WRMEM_64(save, 896, 1)
        IfCondition GreaterThan(limb1, 0) ThenBlock: {
            WRMEM_64(save, 8, limb1)
            WRMEM_64(save, 896, 2)
        }
        WRMEM_64(save, 448, 1)
        WRMEM_64(save, 904, 1)
        m = RDMEM_64(save, 2264)
        IfCondition GreaterEqual(m, 0) ThenBlock: {
            WRMEM_64(save, 2304, m)
            WRMEM_64(save, 2312, 0)
            WRMEM_64(save, 2320, 896)
        } ElseBlock: {
            WRMEM_64(save, 2304, Subtract(0, m))
            WRMEM_64(save, 2312, 448)
            WRMEM_64(save, 2320, 904)
        }
        save = JSNum__Pow5(save)
        bexp = RDMEM_64(save, 2256)
        m = RDMEM_64(save, 2264)
        e2 = Add(bexp, m)
        IfCondition GreaterEqual(e2, 0) ThenBlock: {
            WRMEM_64(save, 2304, e2)
            WRMEM_64(save, 2312, 0)
            WRMEM_64(save, 2320, 896)
        } ElseBlock: {
            WRMEM_64(save, 2304, Subtract(0, e2))
            WRMEM_64(save, 2312, 448)
            WRMEM_64(save, 2320, 904)
        }
        save = JSNum__ShlBits(save)
        ReturnValue(save)
    }
}

Function.JSNum__DivRound {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        save = JSNum__TrimAt(save, 0, 896)
        save = JSNum__TrimAt(save, 448, 904)
        dlen = RDMEM_64(save, 904)
        d0 = RDMEM_64(save, 448)
        IfCondition And(EqualTo(dlen, 1), EqualTo(d0, 1)) ThenBlock: {
            nlen = RDMEM_64(save, 896)
            i = 0
            WhileLoop LessThan(i, nlen) {
                limb = RDMEM_64(save, Multiply(i, 8))
                WRMEM_64(Add(save, 1024), Multiply(i, 8), limb)
                i = Add(i, 1)
            }
            IfCondition LessEqual(nlen, 0) ThenBlock: { nlen = 1 }
            WRMEM_64(save, 1472, nlen)
            ReturnValue(save)
        }
        dlen = RDMEM_64(save, 904)
        i = 0
        WhileLoop LessThan(i, 56) {
            limb = RDMEM_64(Add(save, 448), Multiply(i, 8))
            WRMEM_64(Add(save, 1792), Multiply(i, 8), limb)
            i = Add(i, 1)
        }
        WRMEM_64(save, 2240, dlen)
        save = JSNum__BitLen(save, 0, 896)
        bn = RDMEM_64(save, 2376)
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        WRMEM_64(addr, bn)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        save = JSNum__BitLen(save, 448, 904)
        bd = RDMEM_64(save, 2376)
        bn = JSRT__Pop()
        IfCondition LessThan(bn, bd) ThenBlock: {
            WRMEM_64(save, 1472, 1)
            WRMEM_64(save, 1024, 0)
        } ElseBlock: {
            WRMEM_64(save, 2384, Subtract(bn, bd))
            WRMEM_64(save, 2304, Subtract(bn, bd))
            WRMEM_64(save, 2312, 448)
            WRMEM_64(save, 2320, 904)
            save = JSNum__ShlBits(save)
            WRMEM_64(save, 1472, 1)
            WRMEM_64(save, 1024, 0)
            WRMEM_64(save, 2352, 0)
            WRMEM_64(save, 2400, 1)
            WhileLoop EqualTo(RDMEM_64(save, 2400), 1) {
                save = JSNum__ShlAt(save, 1024, 1472)
                save = JSNum__Cmp(save)
                cmpv = RDMEM_64(save, 1000)
                IfCondition GreaterEqual(cmpv, 0) ThenBlock: {
                    save = JSNum__Sub(save)
                    save = JSNum__QuotInc(save)
                }
                save = JSNum__ShrDen(save)
                i = RDMEM_64(save, 2352)
                i = Add(i, 1)
                WRMEM_64(save, 2352, i)
                sh = RDMEM_64(save, 2384)
                IfCondition GreaterThan(i, sh) ThenBlock: {
                    WRMEM_64(save, 2400, 0)
                }
            }
        }
        i = 0
        WhileLoop LessThan(i, 56) {
            limb = RDMEM_64(Add(save, 1792), Multiply(i, 8))
            WRMEM_64(Add(save, 448), Multiply(i, 8), limb)
            i = Add(i, 1)
        }
        WRMEM_64(save, 904, RDMEM_64(save, 2240))
        save = JSNum__ShlAt(save, 0, 896)
        save = JSNum__Cmp(save)
        cmpv = RDMEM_64(save, 1000)
        IfCondition GreaterEqual(cmpv, 0) ThenBlock: {
            save = JSNum__QuotInc(save)
        }
        ReturnValue(save)
    }
}

Function.JSNum__Digits {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        len = RDMEM_64(save, 1472)
        go = 1
        WhileLoop And(EqualTo(go, 1), GreaterThan(len, 1)) {
            top = RDMEM_64(Add(save, 1024), Multiply(Subtract(len, 1), 8))
            IfCondition EqualTo(top, 0) ThenBlock: {
                len = Subtract(len, 1)
            } ElseBlock: {
                go = 0
            }
        }
        WRMEM_64(save, 1472, len)
        IfCondition And(EqualTo(len, 1), EqualTo(RDMEM_64(save, 1024), 0)) ThenBlock: {
            WRMEM_8(save, 1480, 48)
            WRMEM_64(save, 2296, 1)
            ReturnValue(save)
        }
        nd = 0
        guard = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            z = 1
            i = 0
            len = RDMEM_64(save, 1472)
            WhileLoop LessThan(i, len) {
                IfCondition NotEqual(RDMEM_64(Add(save, 1024), Multiply(i, 8)), 0) ThenBlock: {
                    z = 0
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(z, 1) ThenBlock: { done = 1 }
            IfCondition EqualTo(z, 0) ThenBlock: {
                rem = 0
                i = Subtract(len, 1)
                WhileLoop GreaterEqual(i, 0) {
                    limb = RDMEM_64(Add(save, 1024), Multiply(i, 8))
                    cur = Add(Multiply(rem, 4294967296), limb)
                    WRMEM_64(Add(save, 1024), Multiply(i, 8), Divide(cur, 10))
                    rem = Modulo(cur, 10)
                    i = Subtract(i, 1)
                }
                WRMEM_8(save, Add(1480, nd), Add(48, rem))
                nd = Add(nd, 1)
                len = RDMEM_64(save, 1472)
                go = 1
                WhileLoop And(EqualTo(go, 1), GreaterThan(len, 1)) {
                    top = RDMEM_64(Add(save, 1024), Multiply(Subtract(len, 1), 8))
                    IfCondition EqualTo(top, 0) ThenBlock: {
                        len = Subtract(len, 1)
                    } ElseBlock: {
                        go = 0
                    }
                }
                WRMEM_64(save, 1472, len)
            }
            guard = Add(guard, 1)
            IfCondition GreaterEqual(guard, 130) ThenBlock: { done = 1 }
        }
        IfCondition LessEqual(nd, 0) ThenBlock: {
            WRMEM_8(save, 1480, 48)
            nd = 1
        }
        i = 0
        j = Subtract(nd, 1)
        WhileLoop LessThan(i, j) {
            a = RDMEM_8(save, Add(1480, i))
            b = RDMEM_8(save, Add(1480, j))
            WRMEM_8(save, Add(1480, i), b)
            WRMEM_8(save, Add(1480, j), a)
            i = Add(i, 1)
            j = Subtract(j, 1)
        }
        WRMEM_64(save, 2296, nd)
        ReturnValue(save)
    }
}

Function.JSNum__Guess {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        sig = RDMEM_64(save, 2248)
        t = sig
        dc = 0
        WhileLoop GreaterThan(t, 0) {
            t = Divide(t, 10)
            dc = Add(dc, 1)
        }
        IfCondition LessEqual(dc, 0) ThenBlock: { dc = 1 }
        bexp = RDMEM_64(save, 2256)
        IfCondition GreaterEqual(bexp, 0) ThenBlock: {
            addv = Divide(Multiply(bexp, 30102999566), 100000000000)
        } ElseBlock: {
            prod = Multiply(Subtract(0, bexp), 30102999566)
            addv = Subtract(0, Divide(Add(prod, 99999999999), 100000000000))
        }
        WRMEM_64(save, 2280, Add(addv, Subtract(dc, 1)))
        ReturnValue(save)
    }
}

Function.JSNum__Scale {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        WRMEM_64(save, 2424, 0)
        WhileLoop LessThan(RDMEM_64(save, 2424), 6) {
            p = RDMEM_64(save, 2272)
            n = RDMEM_64(save, 2280)
            WRMEM_64(save, 2264, Subtract(Subtract(p, 1), n))
            save = JSNum__Build(save)
            save = JSNum__DivRound(save)
            save = JSNum__Digits(save)
            nd = RDMEM_64(save, 2296)
            p = RDMEM_64(save, 2272)
            IfCondition EqualTo(nd, p) ThenBlock: {
                WRMEM_64(save, 2424, 6)
            }
            IfCondition NotEqual(nd, p) ThenBlock: {
                n = RDMEM_64(save, 2280)
                WRMEM_64(save, 2280, Add(n, Subtract(nd, p)))
                WRMEM_64(save, 2424, Add(RDMEM_64(save, 2424), 1))
            }
        }
        ReturnValue(save)
    }
}

Function.JSNum__WriteExp {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        pos = 0
        neg = RDMEM_64(save, 2288)
        IfCondition EqualTo(neg, 1) ThenBlock: {
            WRMEM_8(save, 1600, 45)
            pos = 1
        }
        WRMEM_8(save, Add(1600, pos), RDMEM_8(save, 1480))
        pos = Add(pos, 1)
        p = RDMEM_64(save, 2272)
        IfCondition GreaterThan(p, 1) ThenBlock: {
            WRMEM_8(save, Add(1600, pos), 46)
            pos = Add(pos, 1)
            i = 1
            WhileLoop LessThan(i, p) {
                WRMEM_8(save, Add(1600, pos), RDMEM_8(save, Add(1480, i)))
                pos = Add(pos, 1)
                i = Add(i, 1)
            }
        }
        WRMEM_8(save, Add(1600, pos), 101)
        pos = Add(pos, 1)
        n = RDMEM_64(save, 2280)
        IfCondition LessThan(n, 0) ThenBlock: {
            WRMEM_8(save, Add(1600, pos), 45)
            n = Subtract(0, n)
        } ElseBlock: {
            WRMEM_8(save, Add(1600, pos), 43)
        }
        pos = Add(pos, 1)
        e0 = Modulo(n, 10)
        n = Divide(n, 10)
        e1 = Modulo(n, 10)
        n = Divide(n, 10)
        e2 = Modulo(n, 10)
        IfCondition GreaterThan(e2, 0) ThenBlock: {
            WRMEM_8(save, Add(1600, pos), Add(48, e2))
            pos = Add(pos, 1)
        }
        IfCondition Or(GreaterThan(e2, 0), GreaterThan(e1, 0)) ThenBlock: {
            WRMEM_8(save, Add(1600, pos), Add(48, e1))
            pos = Add(pos, 1)
        }
        WRMEM_8(save, Add(1600, pos), Add(48, e0))
        pos = Add(pos, 1)
        WRMEM_8(save, Add(1600, pos), 0)
        WRMEM_64(save, 2344, pos)
        ReturnValue(save)
    }
}

Function.JSNum__WriteFixed {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        pos = 0
        neg = RDMEM_64(save, 2288)
        IfCondition EqualTo(neg, 1) ThenBlock: {
            WRMEM_8(save, 1600, 45)
            pos = 1
        }
        n = RDMEM_64(save, 2280)
        p = RDMEM_64(save, 2272)
        IfCondition GreaterEqual(n, 0) ThenBlock: {
            idn = Add(n, 1)
            i = 0
            WhileLoop LessThan(i, idn) {
                WRMEM_8(save, Add(1600, pos), RDMEM_8(save, Add(1480, i)))
                pos = Add(pos, 1)
                i = Add(i, 1)
            }
            IfCondition GreaterThan(p, idn) ThenBlock: {
                WRMEM_8(save, Add(1600, pos), 46)
                pos = Add(pos, 1)
                WhileLoop LessThan(i, p) {
                    WRMEM_8(save, Add(1600, pos), RDMEM_8(save, Add(1480, i)))
                    pos = Add(pos, 1)
                    i = Add(i, 1)
                }
            }
        } ElseBlock: {
            WRMEM_8(save, Add(1600, pos), 48)
            pos = Add(pos, 1)
            WRMEM_8(save, Add(1600, pos), 46)
            pos = Add(pos, 1)
            z = 0
            zc = Subtract(Subtract(0, n), 1)
            WhileLoop LessThan(z, zc) {
                WRMEM_8(save, Add(1600, pos), 48)
                pos = Add(pos, 1)
                z = Add(z, 1)
            }
            i = 0
            WhileLoop LessThan(i, p) {
                WRMEM_8(save, Add(1600, pos), RDMEM_8(save, Add(1480, i)))
                pos = Add(pos, 1)
                i = Add(i, 1)
            }
        }
        WRMEM_8(save, Add(1600, pos), 0)
        WRMEM_64(save, 2344, pos)
        ReturnValue(save)
    }
}

Function.JSNum__SealOut {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        JSRTStack.hold2 = save
        s = JSRT_CreateString(Add(save, 1600))
        JSRTStack.hold = s
        Deallocate(JSRTStack.hold2, 2560)
        ReturnValue(JSRTStack.hold)
    }
}

Function.JSNum__Emit {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        kind = RDMEM_64(save, 2336)
        sh = RDMEM_64(save, 2360)
        IfCondition And(EqualTo(kind, 0), EqualTo(sh, 1)) ThenBlock: {
            save = JSNum__Guess(save)
            WRMEM_64(save, 2272, 1)
            WRMEM_64(save, 2432, 1)
            WhileLoop EqualTo(RDMEM_64(save, 2432), 1) {
                save = JSNum__Scale(save)
                p = RDMEM_64(save, 2272)
                use = 1
                IfCondition GreaterThan(p, 1) ThenBlock: {
                    last = RDMEM_8(save, Add(1480, Subtract(p, 1)))
                    IfCondition EqualTo(last, 48) ThenBlock: { use = 0 }
                }
                IfCondition EqualTo(use, 1) ThenBlock: {
                    save = JSNum__WriteExp(save)
                    olen = RDMEM_64(save, 2344)
                    poff = 1600
                    IfCondition EqualTo(RDMEM_8(save, 1600), 45) ThenBlock: {
                        poff = 1601
                        olen = Subtract(olen, 1)
                    }
                    WRMEM_64(save, 2304, poff)
                    WRMEM_64(save, 2344, olen)
                    JSRTStack.hold = save
                    bits = JSNum_ParseCStr(Add(JSRTStack.hold, RDMEM_64(JSRTStack.hold, 2304)), RDMEM_64(JSRTStack.hold, 2344))
                    save = JSRTStack.hold
                    IfCondition EqualTo(bits, RDMEM_64(save, 2328)) ThenBlock: {
                        WRMEM_64(save, 2432, 0)
                    }
                }
                p = RDMEM_64(save, 2272)
                IfCondition GreaterEqual(p, 17) ThenBlock: {
                    WRMEM_64(save, 2432, 0)
                }
                IfCondition EqualTo(RDMEM_64(save, 2432), 1) ThenBlock: {
                    WRMEM_64(save, 2272, Add(p, 1))
                }
            }
            save = JSNum__WriteExp(save)
            save = JSNum__SealOut(save)
            ReturnValue(save)
        }
        f = RDMEM_64(save, 2368)
        IfCondition EqualTo(kind, 0) ThenBlock: {
            WRMEM_64(save, 2272, Add(f, 1))
        } ElseBlock: {
            WRMEM_64(save, 2272, f)
        }
        save = JSNum__Guess(save)
        save = JSNum__Scale(save)
        nd = RDMEM_64(save, 2296)
        p = RDMEM_64(save, 2272)
        IfCondition NotEqual(nd, p) ThenBlock: {
            nb = RDMEM_64(save, 2392)
            JSRTStack.hold2 = save
            fv = JSRT_CreateFloat(nb)
            s = JSRT_ToString(fv)
            JSRTStack.hold = s
            Deallocate(JSRTStack.hold2, 2560)
            ReturnValue(JSRTStack.hold)
        }
        kind = RDMEM_64(save, 2336)
        n = RDMEM_64(save, 2280)
        expf = 0
        IfCondition EqualTo(kind, 0) ThenBlock: { expf = 1 }
        IfCondition Or(LessThan(n, -6), GreaterEqual(n, p)) ThenBlock: { expf = 1 }
        IfCondition EqualTo(expf, 1) ThenBlock: {
            save = JSNum__WriteExp(save)
        } ElseBlock: {
            save = JSNum__WriteFixed(save)
        }
        save = JSNum__SealOut(save)
        ReturnValue(save)
    }
}

Function.JSNum__NumFmt {
    Input: args: Address
    Input: argc: Integer
    Input: kind: Integer
    Output: Address
