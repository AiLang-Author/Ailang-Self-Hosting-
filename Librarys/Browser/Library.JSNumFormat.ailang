// Number.prototype [[NumberData]], toString(radix), and toFixed.
// Digit state sits in one heap buffer. JSRTStack.hold / hold2 are scratch
// across a call; the push stack itself stays balanced.
// Radix buffer: digits at 0, nbits +1104, radix +1112, neg +1120, length +1128.
// toFixed buffer is 256 bytes: digits at 0, scratch at 200, iv +224, f +232, neg +240.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Browser.JSRuntime
LibraryImport.Browser.JSMathExtra
LibraryImport.Browser.JSNumDtoa

Function.JSNum_Stamp {
    Output: Integer
    Body: {
        num = JSVM__GetGlobal("Number")
        nt = 0
        IfCondition NotEqual(num, 0) ThenBlock: {
            nt = Dereference(num)
        }
        IfCondition NotEqual(nt, JSType.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        proto = JSRT_ObjGet(num, "prototype")
        pt = 0
        IfCondition NotEqual(proto, 0) ThenBlock: {
            pt = Dereference(proto)
        }
        IfCondition NotEqual(pt, JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        JSRT__Push(proto)
        z = JSRT_CreateNumber(0)
        JSRTStack.hold = z
        proto = JSRT__Pop()
        z = JSRTStack.hold
        JSRT_ObjSet(proto, "__value__", z)
        JSRT__Push(proto)
        cls = JSRT_CreateString("Number")
        JSRTStack.hold = cls
        proto = JSRT__Pop()
        cls = JSRTStack.hold
        JSRT_ObjSet(proto, "__class__", cls)
        JSRT__Push(proto)
        proto = JSRT__Pop()
        ts = JSRT_ObjGet(proto, "toString")
        tt = 0
        IfCondition NotEqual(ts, 0) ThenBlock: {
            tt = Dereference(ts)
        }
        IfCondition EqualTo(tt, JSType.FUNCTION) ThenBlock: {
            fd = Dereference(Add(ts, 8))
            IfCondition NotEqual(fd, 0) ThenBlock: {
                // Spec length is 1. Install built it as 0.
                StoreValue(Add(fd, 80), 1)
            }
        }
        num = JSVM__GetGlobal("Number")
        proto = JSRT_ObjGet(num, "prototype")
        JSRTStack.hold = proto
        pt = 0
        IfCondition NotEqual(JSRTStack.hold, 0) ThenBlock: {
            pt = Dereference(JSRTStack.hold)
        }
        IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: {
            JSMath__Bind(JSRTStack.hold, "toFixed", JSNativeID.NUM_TO_FIXED, 1)
        }
        num = JSVM__GetGlobal("Number")
        proto = JSRT_ObjGet(num, "prototype")
        JSRTStack.hold = proto
        pt = 0
        IfCondition NotEqual(JSRTStack.hold, 0) ThenBlock: {
            pt = Dereference(JSRTStack.hold)
        }
        IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: {
            JSMath__Bind(JSRTStack.hold, "toExponential", JSNativeID.NUM_TO_EXPONENTIAL, 1)
            num = JSVM__GetGlobal("Number")
            proto = JSRT_ObjGet(num, "prototype")
            JSRTStack.hold = proto
            JSMath__Bind(JSRTStack.hold, "toPrecision", JSNativeID.NUM_TO_PRECISION, 1)
        }
        ReturnValue(1)
    }
}

// pos at +1160, iv at +1168, radix at +1112. Returns the same buffer.
Function.JSNum__EmitInt {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        save_pos = Dereference(Add(save, 1160))
        save_iv = Dereference(Add(save, 1168))
        save_r = Dereference(Add(save, 1112))
        IfCondition EqualTo(save_iv, 0) ThenBlock: {
            SetByte(save, save_pos, 48)
            StoreValue(Add(save, 1160), Add(save_pos, 1))
            ReturnValue(save)
        }
        dc = 0
        WhileLoop GreaterThan(save_iv, 0) {
            d = Modulo(save_iv, save_r)
            save_iv = Divide(save_iv, save_r)
            ch = Add(48, d)
            IfCondition GreaterEqual(d, 10) ThenBlock: {
                ch = Add(87, d)
            }
            SetByte(save, Add(1000, dc), ch)
            dc = Add(dc, 1)
        }
        k = 0
        WhileLoop LessThan(k, dc) {
            SetByte(save, save_pos, GetByte(save, Add(1000, Subtract(Subtract(dc, 1), k))))
            save_pos = Add(save_pos, 1)
            k = Add(k, 1)
        }
        StoreValue(Add(save, 1160), save_pos)
        ReturnValue(save)
    }
}

Function.JSNum__FillSmall {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        n = Dereference(Add(save, 1104))
        r = Dereference(Add(save, 1112))
        neg = Dereference(Add(save, 1120))
        mag = BitwiseAnd(n, 9223372036854775807)
        ebits = RightShift(BitwiseAnd(mag, 9218868437227405312), 52)
        is_int = 0
        iv = 0
        IfCondition GreaterEqual(ebits, 1075) ThenBlock: {
            is_int = 1
            iv = Float_ToInt(n)
        }
        IfCondition EqualTo(is_int, 0) ThenBlock: {
            iv = Float_ToInt(n)
            IfCondition EqualTo(Float_Eq(Float_FromInt(iv), n), 1) ThenBlock: {
                is_int = 1
            }
        }
        pos = 0
        IfCondition EqualTo(neg, 1) ThenBlock: {
            SetByte(save, 0, 45)
            pos = 1
        }
        IfCondition EqualTo(is_int, 1) ThenBlock: {
            StoreValue(Add(save, 1160), pos)
            StoreValue(Add(save, 1168), iv)
            save = JSNum__EmitInt(save)
            StoreValue(Add(save, 1128), Dereference(Add(save, 1160)))
            ReturnValue(save)
        }
        ip = Float_ToInt(n)
        frac = Float_Sub(n, Float_FromInt(ip))
        StoreValue(Add(save, 1160), pos)
        StoreValue(Add(save, 1168), ip)
        StoreValue(Add(save, 1176), frac)
        save = JSNum__EmitInt(save)
        pos = Dereference(Add(save, 1160))
        r = Dereference(Add(save, 1112))
        frac = Dereference(Add(save, 1176))
        IfCondition EqualTo(Float_Gt(frac, 0), 1) ThenBlock: {
            SetByte(save, pos, 46)
            dot = pos
            pos = Add(pos, 1)
            fc = 0
            WhileLoop And(LessThan(fc, 54), EqualTo(Float_Gt(frac, 0), 1)) {
                frac = Float_Mul(frac, Float_FromInt(r))
                d = Float_ToInt(frac)
                IfCondition LessThan(d, 0) ThenBlock: { d = 0 }
                IfCondition GreaterEqual(d, r) ThenBlock: { d = Subtract(r, 1) }
                ch = Add(48, d)
                IfCondition GreaterEqual(d, 10) ThenBlock: { ch = Add(87, d) }
                SetByte(save, pos, ch)
                pos = Add(pos, 1)
                frac = Float_Sub(frac, Float_FromInt(d))
                fc = Add(fc, 1)
            }
            WhileLoop And(GreaterThan(pos, Add(dot, 1)), EqualTo(GetByte(save, Subtract(pos, 1)), 48)) {
                pos = Subtract(pos, 1)
            }
            IfCondition EqualTo(GetByte(save, Subtract(pos, 1)), 46) ThenBlock: {
                pos = Subtract(pos, 1)
            }
        }
        StoreValue(Add(save, 1128), pos)
        ReturnValue(save)
    }
}

Function.JSNum__FillBig {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        dc = 0
        guard = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            n = Dereference(Add(save, 1104))
            r = Dereference(Add(save, 1112))
            q = Float_Div(n, Float_FromInt(r))
            StoreValue(Add(save, 1136), q)
            StoreValue(Add(save, 1144), dc)
            StoreValue(Add(save, 1184), guard)
            JSRTStack.hold2 = q
            JSRT__Push(save)
            qf = JSMath__FloorBits(JSRTStack.hold2)
            JSRTStack.hold = qf
            save = JSRT__Pop()
            qf = JSRTStack.hold
            dc = Dereference(Add(save, 1144))
            guard = Dereference(Add(save, 1184))
            n = Dereference(Add(save, 1104))
            r = Dereference(Add(save, 1112))
            IfCondition Or(EqualTo(qf, n), EqualTo(Float_Eq(qf, 0), 1)) ThenBlock: {
                rem = n
                IfCondition EqualTo(Float_Eq(qf, 0), 1) ThenBlock: {
                    rem = Float_Sub(n, Float_Mul(qf, Float_FromInt(r)))
                }
                d = Float_ToInt(rem)
                IfCondition LessThan(d, 0) ThenBlock: { d = 0 }
                IfCondition GreaterEqual(d, r) ThenBlock: { d = Subtract(r, 1) }
                ch = Add(48, d)
                IfCondition GreaterEqual(d, 10) ThenBlock: { ch = Add(87, d) }
                SetByte(save, dc, ch)
                dc = Add(dc, 1)
                done = 1
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
                rem = Float_Sub(n, Float_Mul(qf, Float_FromInt(r)))
                d = Float_ToInt(rem)
                IfCondition LessThan(d, 0) ThenBlock: { d = 0 }
                IfCondition GreaterEqual(d, r) ThenBlock: { d = Subtract(r, 1) }
                ch = Add(48, d)
                IfCondition GreaterEqual(d, 10) ThenBlock: { ch = Add(87, d) }
                SetByte(save, dc, ch)
                dc = Add(dc, 1)
                StoreValue(Add(save, 1104), qf)
            }
            guard = Add(guard, 1)
            IfCondition GreaterEqual(guard, 1024) ThenBlock: { done = 1 }
        }
        IfCondition EqualTo(dc, 0) ThenBlock: {
            SetByte(save, 0, 48)
            dc = 1
        }
        i = 0
        j = Subtract(dc, 1)
        WhileLoop LessThan(i, j) {
            a = GetByte(save, i)
            b = GetByte(save, j)
            SetByte(save, i, b)
            SetByte(save, j, a)
            i = Add(i, 1)
            j = Subtract(j, 1)
        }
        neg = Dereference(Add(save, 1120))
        IfCondition EqualTo(neg, 1) ThenBlock: {
            i = dc
            WhileLoop GreaterThan(i, 0) {
                SetByte(save, i, GetByte(save, Subtract(i, 1)))
                i = Subtract(i, 1)
            }
            SetByte(save, 0, 45)
            dc = Add(dc, 1)
        }
        StoreValue(Add(save, 1128), dc)
        ReturnValue(save)
    }
}

Function.JSNum__Seal {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        len = Dereference(Add(save, 1128))
        IfCondition LessEqual(len, 0) ThenBlock: {
            SetByte(save, 0, 48)
            len = 1
        }
        SetByte(save, len, 0)
        JSRTStack.hold2 = save
        s = JSRT_CreateString(save)
        JSRTStack.hold = s
        Deallocate(JSRTStack.hold2, 1280)
        ReturnValue(JSRTStack.hold)
    }
}

Function.JSNum__RadixBits {
    Input: radix: Integer
    Output: Address
    Body: {
        save_r = radix
        save_n = JSRTStack.hold
        neg = 0
        IfCondition LessThan(save_n, 0) ThenBlock: {
            IfCondition NotEqual(save_n, -9223372036854775808) ThenBlock: {
                neg = 1
                save_n = Float_Abs(save_n)
            }
        }
        mag = BitwiseAnd(save_n, 9223372036854775807)
        ebits = RightShift(BitwiseAnd(mag, 9218868437227405312), 52)
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(addr, save_n)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(addr, save_r)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(addr, neg)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(addr, ebits)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        buf = Allocate(1280)
        JSRTStack.hold = buf
        ebits = JSRT__Pop()
        buf = JSRTStack.hold
        IfCondition NotEqual(buf, 0) ThenBlock: {
            StoreValue(Add(buf, 1152), ebits)
        }
        neg = JSRT__Pop()
        buf = JSRTStack.hold
        IfCondition NotEqual(buf, 0) ThenBlock: {
            StoreValue(Add(buf, 1120), neg)
        }
        save_r = JSRT__Pop()
        buf = JSRTStack.hold
        IfCondition NotEqual(buf, 0) ThenBlock: {
            StoreValue(Add(buf, 1112), save_r)
        }
        save_n = JSRT__Pop()
        buf = JSRTStack.hold
        IfCondition EqualTo(buf, 0) ThenBlock: {
            ReturnValue(JSRT_CreateString("0"))
        }
        StoreValue(Add(buf, 1104), save_n)
        ebits = Dereference(Add(buf, 1152))
        IfCondition GreaterEqual(ebits, 1086) ThenBlock: {
            buf = JSNum__FillBig(buf)
        } ElseBlock: {
            buf = JSNum__FillSmall(buf)
        }
        buf = JSNum__Seal(buf)
        ReturnValue(buf)
    }
}

Function.JSNum__NumberToString {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(addr, save_args)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        JSRTStack.hold2 = save_argc
        vv = JSBridge__NWrapperValueOf(save_args, save_argc, 1)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSRT__Pop()
            ReturnValue(JSRT_Undefined())
        }
        nb = 0
        IfCondition NotEqual(vv, 0) ThenBlock: {
            nb = Dereference(Add(vv, 8))
        }
        JSRTStack.hold = nb
        save_argc = JSRTStack.hold2
        save_args = JSRT__Pop()
        use10 = 0
        IfCondition LessEqual(save_argc, 0) ThenBlock: {
            use10 = 1
        }
        IfCondition EqualTo(use10, 0) ThenBlock: {
            arg = Dereference(save_args)
            at = 0
            IfCondition NotEqual(arg, 0) ThenBlock: {
                at = Dereference(arg)
            }
            IfCondition EqualTo(at, JSType.UNDEFINED) ThenBlock: {
                use10 = 1
            }
        }
        IfCondition EqualTo(use10, 1) ThenBlock: {
            s17 = JSNum__TrySig17()
            IfCondition NotEqual(s17, 0) ThenBlock: {
                ReturnValue(s17)
            }
            fv = JSRT_CreateFloat(JSRTStack.hold)
            ReturnValue(JSRT_ToString(fv))
        }
        arg = Dereference(save_args)
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(addr, JSRTStack.hold)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        rb = JSRT_ToNumber(arg)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSRT__Pop()
            ReturnValue(JSRT_Undefined())
        }
        JSRTStack.hold2 = rb
        nb = JSRT__Pop()
        JSRTStack.hold = nb
        rb = JSRTStack.hold2
        ri = -1
        expf = BitwiseAnd(rb, 9218868437227405312)
        IfCondition NotEqual(expf, 9218868437227405312) ThenBlock: {
            IfCondition NotEqual(rb, -9223372036854775808) ThenBlock: {
                ab = Float_Abs(rb)
                IfCondition EqualTo(Float_Lt(ab, Float_FromInt(37)), 1) ThenBlock: {
                    ri = Float_ToInt(rb)
                }
            }
        }
        IfCondition Or(LessThan(ri, 2), GreaterThan(ri, 36)) ThenBlock: {
            terr = JSVM_CreateTypedError("RangeError", "toString() radix argument must be between 2 and 36")
            JSVM__SetGlobal("__pend_exc__", terr)
            JSVMCall.exc_prop = 1
            JSVMCall.thrown_val = terr
            JSVM_ThrowValue(terr)
            ReturnValue(JSRT_Undefined())
        }
        IfCondition EqualTo(ri, 10) ThenBlock: {
            s17 = JSNum__TrySig17()
            IfCondition NotEqual(s17, 0) ThenBlock: {
                ReturnValue(s17)
            }
            fv = JSRT_CreateFloat(JSRTStack.hold)
            ReturnValue(JSRT_ToString(fv))
        }
        nb = JSRTStack.hold
        expn = BitwiseAnd(nb, 9218868437227405312)
        IfCondition EqualTo(expn, 9218868437227405312) ThenBlock: {
            fv = JSRT_CreateFloat(nb)
            ReturnValue(JSRT_ToString(fv))
        }
        IfCondition Or(EqualTo(nb, 0), EqualTo(nb, -9223372036854775808)) ThenBlock: {
            ReturnValue(JSRT_CreateString("0"))
        }
        JSRTStack.hold = nb
        ReturnValue(JSNum__RadixBits(ri))
    }
}

// 17 significant digits, round-half-away. Returns 0 when ToString should be used.
// Does not write JSRTStack.hold on the 0 path. Only integers in [2^52, 2^63).
Function.JSNum__TrySig17 {
    Output: Address
    Body: {
        nb = JSRTStack.hold
        expn = BitwiseAnd(nb, 9218868437227405312)
        IfCondition EqualTo(expn, 9218868437227405312) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(nb, 0), EqualTo(nb, -9223372036854775808)) ThenBlock: {
            ReturnValue(0)
        }
        mag = BitwiseAnd(nb, 9223372036854775807)
        ebits = RightShift(BitwiseAnd(mag, 9218868437227405312), 52)
        IfCondition LessThan(ebits, 1075) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(ebits, 1086) ThenBlock: {
            ReturnValue(0)
        }
        iv = Float_ToInt(BitwiseAnd(JSRTStack.hold, 9223372036854775807))
        IfCondition LessEqual(iv, 0) ThenBlock: {
            ReturnValue(0)
        }
        nb = JSRTStack.hold
        neg = 0
        IfCondition LessThan(nb, 0) ThenBlock: {
            neg = 1
        }
        tmp = iv
        digits = 0
        WhileLoop GreaterThan(tmp, 0) {
            tmp = Divide(tmp, 10)
            digits = Add(digits, 1)
        }
        IfCondition LessEqual(digits, 17) ThenBlock: {
            ReturnValue(0)
        }
        drop = Subtract(digits, 17)
        pow = 1
        k = 0
        WhileLoop LessThan(k, drop) {
            pow = Multiply(pow, 10)
            k = Add(k, 1)
        }
        high = Divide(iv, pow)
        rem = Modulo(iv, pow)
        half = Divide(pow, 2)
        IfCondition GreaterEqual(rem, half) ThenBlock: {
            high = Add(high, 1)
        }
        nb = JSRTStack.hold
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(addr, nb)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(addr, high)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(addr, neg)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(addr, drop)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        buf = Allocate(64)
        JSRTStack.hold = buf
        drop = JSRT__Pop()
        buf = JSRTStack.hold
        IfCondition NotEqual(buf, 0) ThenBlock: {
            StoreValue(Add(buf, 56), drop)
        }
        neg = JSRT__Pop()
        buf = JSRTStack.hold
        IfCondition NotEqual(buf, 0) ThenBlock: {
            StoreValue(Add(buf, 48), neg)
        }
        high = JSRT__Pop()
        buf = JSRTStack.hold
        IfCondition NotEqual(buf, 0) ThenBlock: {
            StoreValue(Add(buf, 40), high)
        }
        nb = JSRT__Pop()
        buf = JSRTStack.hold
        IfCondition EqualTo(buf, 0) ThenBlock: {
            JSRTStack.hold = nb
            ReturnValue(0)
        }
        buf = JSNum__SigFinish(buf)
        ReturnValue(buf)
    }
}

// high +40, neg +48, drop +56. Overwrites the buffer, then returns a string.
Function.JSNum__SigFinish {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        high = Dereference(Add(save, 40))
        neg = Dereference(Add(save, 48))
        drop = Dereference(Add(save, 56))
        pos = 0
        IfCondition EqualTo(neg, 1) ThenBlock: {
            SetByte(save, 0, 45)
            pos = 1
        }
        dc = 0
        IfCondition EqualTo(high, 0) ThenBlock: {
            SetByte(save, pos, 48)
            dc = 1
        }
        WhileLoop GreaterThan(high, 0) {
            d = Modulo(high, 10)
            high = Divide(high, 10)
            SetByte(save, Add(pos, dc), Add(48, d))
            dc = Add(dc, 1)
        }
        i = 0
        j = Subtract(dc, 1)
        WhileLoop LessThan(i, j) {
            a = GetByte(save, Add(pos, i))
            b = GetByte(save, Add(pos, j))
            SetByte(save, Add(pos, i), b)
            SetByte(save, Add(pos, j), a)
            i = Add(i, 1)
            j = Subtract(j, 1)
        }
        z = 0
        WhileLoop LessThan(z, drop) {
            SetByte(save, Add(pos, dc), 48)
            dc = Add(dc, 1)
            z = Add(z, 1)
        }
        SetByte(save, Add(pos, dc), 0)
        JSRTStack.hold2 = save
        s = JSRT_CreateString(save)
        JSRTStack.hold = s
        Deallocate(JSRTStack.hold2, 64)
        ReturnValue(JSRTStack.hold)
    }
}

// iv +224, f +232, neg +240. Scratch digits at 200. Returns the string.
Function.JSNum__FmtFixed {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        iv = Dereference(Add(save, 224))
        f = Dereference(Add(save, 232))
        neg = Dereference(Add(save, 240))
        pos = 0
        IfCondition EqualTo(neg, 1) ThenBlock: {
            SetByte(save, 0, 45)
            pos = 1
        }
        IfCondition EqualTo(iv, 0) ThenBlock: {
            SetByte(save, pos, 48)
            pos = Add(pos, 1)
        }
        IfCondition GreaterThan(iv, 0) ThenBlock: {
            dc = 0
            WhileLoop GreaterThan(iv, 0) {
                d = Modulo(iv, 10)
                iv = Divide(iv, 10)
                SetByte(save, Add(200, dc), Add(48, d))
                dc = Add(dc, 1)
            }
            k = 0
            WhileLoop LessThan(k, dc) {
                SetByte(save, pos, GetByte(save, Add(200, Subtract(Subtract(dc, 1), k))))
                pos = Add(pos, 1)
                k = Add(k, 1)
            }
        }
        IfCondition GreaterThan(f, 0) ThenBlock: {
            SetByte(save, pos, 46)
            pos = Add(pos, 1)
            z = 0
            WhileLoop LessThan(z, f) {
                SetByte(save, pos, 48)
                pos = Add(pos, 1)
                z = Add(z, 1)
            }
        }
        SetByte(save, pos, 0)
        JSRTStack.hold2 = save
        s = JSRT_CreateString(save)
        JSRTStack.hold = s
        Deallocate(JSRTStack.hold2, 256)
        ReturnValue(JSRTStack.hold)
    }
}

Function.JSNum__ToFixed {
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_args = args
        save_argc = argc
        addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(addr, save_args)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        JSRTStack.hold2 = save_argc
        vv = JSBridge__NWrapperValueOf(save_args, save_argc, 1)
        IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
            JSRT__Pop()
            ReturnValue(JSRT_Undefined())
        }
        nb = 0
        IfCondition NotEqual(vv, 0) ThenBlock: {
            nb = Dereference(Add(vv, 8))
        }
        JSRTStack.hold = nb
        save_argc = JSRTStack.hold2
        save_args = JSRT__Pop()
        f = 0
        bad = 0
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            arg = Dereference(save_args)
            at = 0
            IfCondition NotEqual(arg, 0) ThenBlock: {
                at = Dereference(arg)
            }
            IfCondition NotEqual(at, JSType.UNDEFINED) ThenBlock: {
                addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
                StoreValue(addr, JSRTStack.hold)
                JSRTStack.sp = Add(JSRTStack.sp, 1)
                rb = JSRT_ToNumber(arg)
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    JSRT__Pop()
