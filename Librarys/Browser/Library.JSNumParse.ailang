// Decimal literals → IEEE-754 bits.
// Limb state lives in one heap buffer so a call can only clobber the pointer,
// which every helper returns. Layout (byte offsets):
//   0    num limbs, 56 × 8, base 2^32, little-endian
//   448  den limbs, 56 × 8
//   896  nlen   904 dlen   912 bin_exp   920 dec_exp
//   928  idx    936 saw_dot  944 has     952 src     960 slen
//   968  kind (0 = run, 1 = finished)
//   976  result  984 mant  992 steps  1000 cmp
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Browser.JSRuntime

Function.JSNum__MulAt {
    Input: buf: Address
    Input: off: Integer
    Input: len_off: Integer
    Output: Address
    Body: {
        save = buf
        save_off = off
        save_lo = len_off
        nlen = RDMEM_64(save, save_lo)
        carry = 0
        i = 0
        WhileLoop LessThan(i, nlen) {
            limb = RDMEM_64(Add(save, save_off), Multiply(i, 8))
            v = Add(Multiply(limb, 10), carry)
            WRMEM_64(Add(save, save_off), Multiply(i, 8), BitwiseAnd(v, 4294967295))
            carry = RightShift(v, 32)
            i = Add(i, 1)
        }
        IfCondition GreaterThan(carry, 0) ThenBlock: {
            IfCondition GreaterEqual(nlen, 56) ThenBlock: {
                // Caller distinguishes num-overflow (Inf) from den-overflow (0)
                // by the length slot: -1 means overflow.
                WRMEM_64(save, save_lo, -1)
            }
            IfCondition LessThan(nlen, 56) ThenBlock: {
                WRMEM_64(Add(save, save_off), Multiply(nlen, 8), carry)
                WRMEM_64(save, save_lo, Add(nlen, 1))
            }
        }
        ReturnValue(save)
    }
}

Function.JSNum__AddNum {
    Input: buf: Address
    Input: dig: Integer
    Output: Address
    Body: {
        save = buf
        save_d = dig
        nlen = RDMEM_64(save, 896)
        carry = save_d
        i = 0
        WhileLoop GreaterThan(carry, 0) {
            IfCondition GreaterEqual(i, 56) ThenBlock: {
                WRMEM_64(save, 896, -1)
                carry = 0
            }
            IfCondition LessThan(i, 56) ThenBlock: {
                limb = 0
                IfCondition LessThan(i, nlen) ThenBlock: {
                    limb = RDMEM_64(save, Multiply(i, 8))
                }
                v = Add(limb, carry)
                WRMEM_64(save, Multiply(i, 8), BitwiseAnd(v, 4294967295))
                carry = RightShift(v, 32)
                IfCondition GreaterEqual(i, nlen) ThenBlock: {
                    nlen = Add(i, 1)
                    WRMEM_64(save, 896, nlen)
                }
                i = Add(i, 1)
            }
        }
        ReturnValue(save)
    }
}

Function.JSNum__ShlAt {
    Input: buf: Address
    Input: off: Integer
    Input: len_off: Integer
    Output: Address
    Body: {
        save = buf
        save_off = off
        save_lo = len_off
        nlen = RDMEM_64(save, save_lo)
        carry = 0
        i = 0
        WhileLoop LessThan(i, nlen) {
            limb = RDMEM_64(Add(save, save_off), Multiply(i, 8))
            v = Add(Multiply(limb, 2), carry)
            WRMEM_64(Add(save, save_off), Multiply(i, 8), BitwiseAnd(v, 4294967295))
            carry = RightShift(v, 32)
            i = Add(i, 1)
        }
        IfCondition GreaterThan(carry, 0) ThenBlock: {
            IfCondition GreaterEqual(nlen, 56) ThenBlock: {
                WRMEM_64(save, save_lo, -1)
            }
            IfCondition LessThan(nlen, 56) ThenBlock: {
                WRMEM_64(Add(save, save_off), Multiply(nlen, 8), carry)
                WRMEM_64(save, save_lo, Add(nlen, 1))
            }
        }
        ReturnValue(save)
    }
}

Function.JSNum__ShrDen {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        nlen = RDMEM_64(save, 904)
        carry = 0
        i = Subtract(nlen, 1)
        WhileLoop GreaterEqual(i, 0) {
            limb = RDMEM_64(Add(save, 448), Multiply(i, 8))
            low = BitwiseAnd(limb, 1)
            wide = Add(ShiftLeft(carry, 32), limb)
            WRMEM_64(Add(save, 448), Multiply(i, 8), RightShift(wide, 1))
            carry = low
            i = Subtract(i, 1)
        }
        IfCondition GreaterThan(nlen, 1) ThenBlock: {
            hi = RDMEM_64(Add(save, 448), Multiply(Subtract(nlen, 1), 8))
            IfCondition EqualTo(hi, 0) ThenBlock: {
                nlen = Subtract(nlen, 1)
            }
        }
        WRMEM_64(save, 904, nlen)
        ReturnValue(save)
    }
}

Function.JSNum__Cmp {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        an = RDMEM_64(save, 896)
        bn = RDMEM_64(save, 904)
        cmpv = 0
        IfCondition GreaterThan(an, bn) ThenBlock: { cmpv = 1 }
        IfCondition LessThan(an, bn) ThenBlock: { cmpv = -1 }
        IfCondition EqualTo(an, bn) ThenBlock: {
            i = Subtract(an, 1)
            go = 1
            WhileLoop And(EqualTo(go, 1), GreaterEqual(i, 0)) {
                av = RDMEM_64(save, Multiply(i, 8))
                bv = RDMEM_64(Add(save, 448), Multiply(i, 8))
                IfCondition GreaterThan(av, bv) ThenBlock: {
                    cmpv = 1
                    go = 0
                }
                IfCondition LessThan(av, bv) ThenBlock: {
                    cmpv = -1
                    go = 0
                }
                i = Subtract(i, 1)
            }
        }
        WRMEM_64(save, 1000, cmpv)
        ReturnValue(save)
    }
}

Function.JSNum__Sub {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        nlen = RDMEM_64(save, 896)
        dlen = RDMEM_64(save, 904)
        borrow = 0
        i = 0
        WhileLoop LessThan(i, nlen) {
            av = RDMEM_64(save, Multiply(i, 8))
            bv = 0
            IfCondition LessThan(i, dlen) ThenBlock: {
                bv = RDMEM_64(Add(save, 448), Multiply(i, 8))
            }
            v = Subtract(av, Add(bv, borrow))
            IfCondition LessThan(v, 0) ThenBlock: {
                v = Add(v, 4294967296)
                borrow = 1
            } ElseBlock: {
                borrow = 0
            }
            WRMEM_64(save, Multiply(i, 8), v)
            i = Add(i, 1)
        }
        go = 1
        WhileLoop EqualTo(go, 1) {
            IfCondition LessEqual(nlen, 1) ThenBlock: { go = 0 }
            IfCondition GreaterThan(nlen, 1) ThenBlock: {
                hi = RDMEM_64(save, Multiply(Subtract(nlen, 1), 8))
                IfCondition EqualTo(hi, 0) ThenBlock: {
                    nlen = Subtract(nlen, 1)
                }
                IfCondition NotEqual(hi, 0) ThenBlock: { go = 0 }
            }
        }
        WRMEM_64(save, 896, nlen)
        ReturnValue(save)
    }
}

Function.JSNum__ZeroNum {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        nlen = RDMEM_64(save, 896)
        i = 0
        z = 1
        WhileLoop LessThan(i, nlen) {
            limb = RDMEM_64(save, Multiply(i, 8))
            IfCondition NotEqual(limb, 0) ThenBlock: { z = 0 }
            i = Add(i, 1)
        }
        WRMEM_64(save, 1008, z)
        ReturnValue(save)
    }
}

Function.JSNum__Finish {
    Input: buf: Address
    Input: bits: Integer
    Output: Address
    Body: {
        save = buf
        WRMEM_64(save, 976, bits)
        WRMEM_64(save, 968, 1)
        ReturnValue(save)
    }
}

// Walk the literal into num * 10^dec_exp. Legacy octal 0[0-7]+ stays base 8.
Function.JSNum__ParseDigits {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        slen = RDMEM_64(save, 960)
        src = RDMEM_64(save, 952)
        // Annex B: 0[0-7]+ with no dot and no exponent.
        IfCondition And(GreaterEqual(slen, 2), EqualTo(RDMEM_8(src, 0), 48)) ThenBlock: {
            pure = 1
            saw = 0
            j = 1
            go = 1
            WhileLoop EqualTo(go, 1) {
                IfCondition GreaterEqual(j, slen) ThenBlock: { go = 0 }
                IfCondition LessThan(j, slen) ThenBlock: {
                    cj = RDMEM_8(src, j)
                    IfCondition And(GreaterEqual(cj, 48), LessEqual(cj, 57)) ThenBlock: {
                        saw = 1
                        IfCondition GreaterThan(cj, 55) ThenBlock: { pure = 0 }
                        j = Add(j, 1)
                    } ElseBlock: {
                        IfCondition Or(EqualTo(cj, 46), Or(EqualTo(cj, 101), EqualTo(cj, 69))) ThenBlock: {
                            pure = 0
                        }
                        go = 0
                    }
                }
            }
            IfCondition And(EqualTo(pure, 1), EqualTo(saw, 1)) ThenBlock: {
                acc = 0
                j = 1
                WhileLoop LessThan(j, slen) {
                    acc = Add(Multiply(acc, 8), Subtract(RDMEM_8(src, j), 48))
                    j = Add(j, 1)
                }
                save = JSNum__Finish(save, Float_FromInt(acc))
                ReturnValue(save)
            }
        }
        WhileLoop And(EqualTo(RDMEM_64(save, 968), 0), EqualTo(RDMEM_64(save, 992), 0)) {
            idx = RDMEM_64(save, 928)
            slen = RDMEM_64(save, 960)
            IfCondition GreaterEqual(idx, slen) ThenBlock: {
                WRMEM_64(save, 992, 1)
            }
            IfCondition LessThan(idx, slen) ThenBlock: {
                src = RDMEM_64(save, 952)
                ch = RDMEM_8(src, idx)
                is_dig = 0
                IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: { is_dig = 1 }
                IfCondition EqualTo(is_dig, 1) ThenBlock: {
                    WRMEM_64(save, 944, 1)
                    WRMEM_64(save, 1016, Subtract(ch, 48))
                    save = JSNum__MulAt(save, 0, 896)
                    IfCondition EqualTo(RDMEM_64(save, 896), -1) ThenBlock: {
                        save = JSNum__Finish(save, 9218868437227405312)
                    }
                    IfCondition NotEqual(RDMEM_64(save, 968), 1) ThenBlock: {
                        dig = RDMEM_64(save, 1016)
                        save = JSNum__AddNum(save, dig)
                        IfCondition EqualTo(RDMEM_64(save, 896), -1) ThenBlock: {
                            save = JSNum__Finish(save, 9218868437227405312)
                        }
                        IfCondition EqualTo(RDMEM_64(save, 936), 1) ThenBlock: {
                            dec = RDMEM_64(save, 920)
                            WRMEM_64(save, 920, Subtract(dec, 1))
                        }
                        idx = RDMEM_64(save, 928)
                        WRMEM_64(save, 928, Add(idx, 1))
                    }
                }
                IfCondition EqualTo(is_dig, 0) ThenBlock: {
                    was_dot = RDMEM_64(save, 936)
                    IfCondition And(EqualTo(ch, 46), EqualTo(was_dot, 0)) ThenBlock: {
                        WRMEM_64(save, 936, 1)
                        WRMEM_64(save, 928, Add(idx, 1))
                    }
                    IfCondition And(EqualTo(ch, 46), EqualTo(was_dot, 1)) ThenBlock: {
                        WRMEM_64(save, 992, 1)
                    }
                    IfCondition Or(EqualTo(ch, 101), EqualTo(ch, 69)) ThenBlock: {
                        // scientific exponent
                        k = Add(idx, 1)
                        esign = 1
                        slen = RDMEM_64(save, 960)
                        src = RDMEM_64(save, 952)
                        IfCondition LessThan(k, slen) ThenBlock: {
                            ek = RDMEM_8(src, k)
                            IfCondition EqualTo(ek, 45) ThenBlock: {
                                esign = -1
                                k = Add(k, 1)
                            }
                            IfCondition EqualTo(ek, 43) ThenBlock: {
                                k = Add(k, 1)
                            }
                        }
                        ev = 0
                        ed = 0
                        huge = 0
                        goe = 1
                        WhileLoop EqualTo(goe, 1) {
                            IfCondition GreaterEqual(k, slen) ThenBlock: { goe = 0 }
                            IfCondition LessThan(k, slen) ThenBlock: {
                                ek = RDMEM_8(src, k)
                                IfCondition And(GreaterEqual(ek, 48), LessEqual(ek, 57)) ThenBlock: {
                                    ed = Add(ed, 1)
                                    IfCondition LessThan(ev, 2000) ThenBlock: {
                                        ev = Add(Multiply(ev, 10), Subtract(ek, 48))
                                    }
                                    IfCondition GreaterEqual(ed, 6) ThenBlock: { huge = 1 }
                                    k = Add(k, 1)
                                }
                                IfCondition Or(LessThan(ek, 48), GreaterThan(ek, 57)) ThenBlock: { goe = 0 }
                            }
                        }
                        dec = RDMEM_64(save, 920)
                        IfCondition EqualTo(huge, 1) ThenBlock: {
                            IfCondition EqualTo(esign, 1) ThenBlock: {
                                save = JSNum__Finish(save, 9218868437227405312)
                            }
                            IfCondition EqualTo(esign, -1) ThenBlock: {
                                save = JSNum__Finish(save, 0)
                            }
                        }
                        IfCondition EqualTo(RDMEM_64(save, 968), 0) ThenBlock: {
                            IfCondition EqualTo(esign, 1) ThenBlock: {
                                WRMEM_64(save, 920, Add(dec, ev))
                            }
                            IfCondition EqualTo(esign, -1) ThenBlock: {
                                WRMEM_64(save, 920, Subtract(dec, ev))
                            }
                        }
                        WRMEM_64(save, 928, -2)
                        WRMEM_64(save, 992, 1)
                    }
                    IfCondition And(NotEqual(ch, 46), And(NotEqual(ch, 101), NotEqual(ch, 69))) ThenBlock: {
                        WRMEM_64(save, 992, 1)
                    }
                }
            }
        }
        IfCondition EqualTo(RDMEM_64(save, 944), 0) ThenBlock: {
            save = JSNum__Finish(save, 9221120237041090560)
        }
        ReturnValue(save)
    }
}

Function.JSNum__ApplyExp {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        IfCondition EqualTo(RDMEM_64(save, 968), 1) ThenBlock: {
            ReturnValue(save)
        }
        save = JSNum__ZeroNum(save)
        IfCondition EqualTo(RDMEM_64(save, 1008), 1) ThenBlock: {
            save = JSNum__Finish(save, 0)
            ReturnValue(save)
        }
        dec = RDMEM_64(save, 920)
        IfCondition GreaterThan(dec, 1100) ThenBlock: {
            save = JSNum__Finish(save, 9218868437227405312)
            ReturnValue(save)
        }
        IfCondition LessThan(dec, -1100) ThenBlock: {
            save = JSNum__Finish(save, 0)
            ReturnValue(save)
        }
        IfCondition GreaterThan(dec, 0) ThenBlock: {
            WRMEM_64(save, 992, dec)
            WhileLoop And(GreaterThan(RDMEM_64(save, 992), 0), EqualTo(RDMEM_64(save, 968), 0)) {
                save = JSNum__MulAt(save, 0, 896)
                IfCondition EqualTo(RDMEM_64(save, 896), -1) ThenBlock: {
                    save = JSNum__Finish(save, 9218868437227405312)
                }
                IfCondition EqualTo(RDMEM_64(save, 968), 0) ThenBlock: {
                    left = RDMEM_64(save, 992)
                    WRMEM_64(save, 992, Subtract(left, 1))
                }
            }
        }
        dec = RDMEM_64(save, 920)
        IfCondition LessThan(dec, 0) ThenBlock: {
            WRMEM_64(save, 992, Subtract(0, dec))
            WhileLoop And(GreaterThan(RDMEM_64(save, 992), 0), EqualTo(RDMEM_64(save, 968), 0)) {
                save = JSNum__MulAt(save, 448, 904)
                IfCondition EqualTo(RDMEM_64(save, 904), -1) ThenBlock: {
                    save = JSNum__Finish(save, 0)
                }
                IfCondition EqualTo(RDMEM_64(save, 968), 0) ThenBlock: {
                    left = RDMEM_64(save, 992)
                    WRMEM_64(save, 992, Subtract(left, 1))
                }
            }
        }
        ReturnValue(save)
    }
}

Function.JSNum__ToBits {
    Input: buf: Address
    Output: Address
    Body: {
        save = buf
        IfCondition EqualTo(RDMEM_64(save, 968), 1) ThenBlock: {
            ReturnValue(save)
        }
        // while num < den: shl num, bin_exp--. Slot 936 is the loop flag.
        WRMEM_64(save, 992, 0)
        WRMEM_64(save, 936, 1)
        WhileLoop EqualTo(RDMEM_64(save, 936), 1) {
            save = JSNum__Cmp(save)
            IfCondition GreaterEqual(RDMEM_64(save, 1000), 0) ThenBlock: {
                WRMEM_64(save, 936, 0)
            }
            IfCondition LessThan(RDMEM_64(save, 1000), 0) ThenBlock: {
                save = JSNum__ShlAt(save, 0, 896)
                IfCondition EqualTo(RDMEM_64(save, 896), -1) ThenBlock: {
                    save = JSNum__Finish(save, 0)
                    WRMEM_64(save, 936, 0)
                }
                IfCondition EqualTo(RDMEM_64(save, 968), 0) ThenBlock: {
                    be = RDMEM_64(save, 912)
                    WRMEM_64(save, 912, Subtract(be, 1))
                    st = Add(RDMEM_64(save, 992), 1)
                    WRMEM_64(save, 992, st)
                    IfCondition GreaterThan(st, 8000) ThenBlock: {
                        save = JSNum__Finish(save, 0)
                        WRMEM_64(save, 936, 0)
                    }
                }
            }
        }
        IfCondition EqualTo(RDMEM_64(save, 968), 1) ThenBlock: {
            ReturnValue(save)
        }
        // while num >= den<<1: shl den, bin_exp++. Trial-shift and undo.
        WRMEM_64(save, 992, 0)
        WRMEM_64(save, 936, 1)
        WhileLoop EqualTo(RDMEM_64(save, 936), 1) {
            save = JSNum__ShlAt(save, 448, 904)
            IfCondition EqualTo(RDMEM_64(save, 904), -1) ThenBlock: {
                save = JSNum__Finish(save, 9218868437227405312)
                WRMEM_64(save, 936, 0)
            }
            IfCondition EqualTo(RDMEM_64(save, 968), 0) ThenBlock: {
                save = JSNum__Cmp(save)
                IfCondition LessThan(RDMEM_64(save, 1000), 0) ThenBlock: {
                    save = JSNum__ShrDen(save)
                    WRMEM_64(save, 936, 0)
                }
                IfCondition GreaterEqual(RDMEM_64(save, 1000), 0) ThenBlock: {
                    be = RDMEM_64(save, 912)
                    WRMEM_64(save, 912, Add(be, 1))
                    st = Add(RDMEM_64(save, 992), 1)
                    WRMEM_64(save, 992, st)
                    IfCondition GreaterThan(st, 8000) ThenBlock: {
                        save = JSNum__Finish(save, 9218868437227405312)
                        WRMEM_64(save, 936, 0)
                    }
                }
            }
        }
        IfCondition EqualTo(RDMEM_64(save, 968), 1) ThenBlock: {
            ReturnValue(save)
        }
        be = RDMEM_64(save, 912)
        IfCondition GreaterThan(be, 1023) ThenBlock: {
            save = JSNum__Finish(save, 9218868437227405312)
            ReturnValue(save)
        }
        // Peel the leading 1. Remainder is in [0, den).
        save = JSNum__Sub(save)
        be = RDMEM_64(save, 912)
        IfCondition GreaterEqual(be, -1022) ThenBlock: {
            WRMEM_64(save, 984, 1)
            WRMEM_64(save, 1016, 0)
            WhileLoop LessThan(RDMEM_64(save, 1016), 52) {
                save = JSNum__ShlAt(save, 0, 896)
                save = JSNum__Cmp(save)
                bit = 0
                IfCondition GreaterEqual(RDMEM_64(save, 1000), 0) ThenBlock: {
                    save = JSNum__Sub(save)
                    bit = 1
                }
                mant = RDMEM_64(save, 984)
                mant = BitwiseOr(ShiftLeft(mant, 1), bit)
                WRMEM_64(save, 984, mant)
                kk = RDMEM_64(save, 1016)
                WRMEM_64(save, 1016, Add(kk, 1))
            }
            save = JSNum__ShlAt(save, 0, 896)
            save = JSNum__Cmp(save)
            WRMEM_64(save, 1016, 0)
            IfCondition GreaterEqual(RDMEM_64(save, 1000), 0) ThenBlock: {
                save = JSNum__Sub(save)
                WRMEM_64(save, 1016, 1)
            }
            save = JSNum__ZeroNum(save)
            sticky = 0
            IfCondition EqualTo(RDMEM_64(save, 1008), 0) ThenBlock: { sticky = 1 }
            rbit = RDMEM_64(save, 1016)
            mant = RDMEM_64(save, 984)
            IfCondition And(EqualTo(rbit, 1), Or(EqualTo(sticky, 1), EqualTo(BitwiseAnd(mant, 1), 1))) ThenBlock: {
                mant = Add(mant, 1)
            }
            be = RDMEM_64(save, 912)
            IfCondition EqualTo(mant, 9007199254740992) ThenBlock: {
                mant = 4503599627370496
                be = Add(be, 1)
            }
            IfCondition GreaterThan(be, 1023) ThenBlock: {
                save = JSNum__Finish(save, 9218868437227405312)
            }
            IfCondition LessEqual(be, 1023) ThenBlock: {
                frac = BitwiseAnd(mant, 4503599627370495)
                field = ShiftLeft(Add(be, 1023), 52)
                save = JSNum__Finish(save, BitwiseOr(field, frac))
            }
            ReturnValue(save)
        }
        // Subnormal, or underflow.
        IfCondition LessThan(be, -1075) ThenBlock: {
            save = JSNum__Finish(save, 0)
            ReturnValue(save)
        }
        IfCondition EqualTo(be, -1075) ThenBlock: {
            save = JSNum__ZeroNum(save)
            IfCondition EqualTo(RDMEM_64(save, 1008), 1) ThenBlock: {
                save = JSNum__Finish(save, 0)
            }
            IfCondition EqualTo(RDMEM_64(save, 1008), 0) ThenBlock: {
                save = JSNum__Finish(save, 1)
            }
            ReturnValue(save)
        }
        WRMEM_64(save, 920, Add(be, 1074))
        WRMEM_64(save, 984, 1)
        WRMEM_64(save, 1016, 0)
        WhileLoop LessThan(RDMEM_64(save, 1016), RDMEM_64(save, 920)) {
            save = JSNum__ShlAt(save, 0, 896)
            save = JSNum__Cmp(save)
            bit = 0
            IfCondition GreaterEqual(RDMEM_64(save, 1000), 0) ThenBlock: {
                save = JSNum__Sub(save)
                bit = 1
            }
            mant = RDMEM_64(save, 984)
            mant = BitwiseOr(ShiftLeft(mant, 1), bit)
            WRMEM_64(save, 984, mant)
            kk = RDMEM_64(save, 1016)
            WRMEM_64(save, 1016, Add(kk, 1))
        }
        save = JSNum__ShlAt(save, 0, 896)
        save = JSNum__Cmp(save)
        WRMEM_64(save, 1016, 0)
        IfCondition GreaterEqual(RDMEM_64(save, 1000), 0) ThenBlock: {
            save = JSNum__Sub(save)
            WRMEM_64(save, 1016, 1)
        }
        save = JSNum__ZeroNum(save)
        sticky = 0
        IfCondition EqualTo(RDMEM_64(save, 1008), 0) ThenBlock: { sticky = 1 }
        rbit = RDMEM_64(save, 1016)
        mant = RDMEM_64(save, 984)
        IfCondition And(EqualTo(rbit, 1), Or(EqualTo(sticky, 1), EqualTo(BitwiseAnd(mant, 1), 1))) ThenBlock: {
            mant = Add(mant, 1)
        }
        extra = RDMEM_64(save, 920)
        cap = ShiftLeft(1, Add(extra, 1))
        IfCondition EqualTo(mant, cap) ThenBlock: {
            save = JSNum__Finish(save, 4503599627370496)
            ReturnValue(save)
        }
        save = JSNum__Finish(save, mant)
        ReturnValue(save)
    }
}

Function.JSNum_ParseCStr {
    Input: ptr: Address
    Input: len: Integer
    Output: Integer
    Body: {
        save_p = ptr
        save_n = len
        IfCondition LessEqual(save_n, 0) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        buf = Allocate(1024)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            ReturnValue(9221120237041090560)
        }
        i = 0
        WhileLoop LessThan(i, 128) {
            WRMEM_64(buf, Multiply(i, 8), 0)
            i = Add(i, 1)
        }
        // den = 1
        WRMEM_64(buf, 448, 1)
        WRMEM_64(buf, 896, 1)
        WRMEM_64(buf, 904, 1)
        WRMEM_64(buf, 952, save_p)
        WRMEM_64(buf, 960, save_n)
        buf = JSNum__ParseDigits(buf)
        buf = JSNum__ApplyExp(buf)
        buf = JSNum__ToBits(buf)
        result = RDMEM_64(buf, 976)
        JSRT__Push(result)
        Deallocate(buf, 1024)
        result = JSRT__Pop()
        ReturnValue(result)
    }
}
