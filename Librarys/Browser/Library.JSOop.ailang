// Library.JSOop.ailang — JavaScript Object-Oriented Programming Support
// Forked from Library.OOP.ailang for JS engine use (prototype chains, constructors,
// instanceof, getter/setter descriptors, Object.create, etc.)
//
// All symbols renamed from OOP.* -> JSOop.* to avoid collisions with base library.
// Will be extended with JS-specific semantics as needed.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.XArrays
LibraryImport.TArrays
LibraryImport.HashMap

//=============================================================================
// INTERNAL DATA STRUCTURES
//=============================================================================

// Global registry of all defined classes
// Key: class_name (String)
// Value: ClassDef hash
FixedPool.JSClassRegistry {
    "registry": Initialize=0
    "initialized": Initialize=0
}

// ClassDef structure (stored in registry as hash):
//   "name": String - class name
//   "parent": String|Null - parent class name (prototype chain)
//   "fields": Hash - field_name -> field_type
//   "methods": Hash - method_name -> function_address
//   "field_defaults": Hash - field_name -> default_value
//   "getters": Hash - property_name -> getter_function_address
//   "setters": Hash - property_name -> setter_function_address

// Object structure (returned by JSOop.ObjectNew as hash):
//   "__class__": String - class name (constructor.name)
//   "__data__": Hash - field_name -> current_value
//   "__proto__": Address - prototype chain link


//=============================================================================
// REGISTRY INITIALIZATION
//=============================================================================

Function.JSOop.EnsureInit {
    Output: Integer
    Body: {
        IfCondition EqualTo(JSClassRegistry.initialized, 0) ThenBlock: {
            JSClassRegistry.registry = HashMap.Create(256)
            JSClassRegistry.initialized = 1
        }
        ReturnValue(1)
    }
}


//=============================================================================
// CLASS DEFINITION
//=============================================================================

Function.JSOop.ClassDefine {
    Input: name: Address
    Input: parent: Address
    Output: Integer
    Body: {
        JSOop.EnsureInit()

        existing = HashMap.HGet(JSClassRegistry.registry, name)
        IfCondition NotEqual(existing, 0) ThenBlock: {
            ReturnValue(0)
        }

        class_def = HashMap.Create(64)
        HashMap.HSet(class_def, "name", name)
        HashMap.HSet(class_def, "parent", parent)
        HashMap.HSet(class_def, "fields", HashMap.Create(32))
        HashMap.HSet(class_def, "methods", HashMap.Create(32))
        HashMap.HSet(class_def, "field_defaults", HashMap.Create(32))
        HashMap.HSet(class_def, "getters", HashMap.Create(16))
        HashMap.HSet(class_def, "setters", HashMap.Create(16))

        IfCondition NotEqual(parent, 0) ThenBlock: {
            parent_def = HashMap.HGet(JSClassRegistry.registry, parent)
            IfCondition EqualTo(parent_def, 0) ThenBlock: {
                ReturnValue(0)
            }

            parent_fields = HashMap.HGet(parent_def, "fields")
            parent_field_keys = HashMap.HKeysSimple(parent_fields)
            num_parent_fields = XArray.XSize(parent_field_keys)

            i = 0
            WhileLoop LessThan(i, num_parent_fields) {
                field_key = XArray.XGet(parent_field_keys, i)
                field_type = HashMap.HGet(parent_fields, field_key)
                HashMap.HSet(HashMap.HGet(class_def, "fields"), field_key, field_type)
                i = Add(i, 1)
            }
            XArray.XDestroy(parent_field_keys)

            parent_defaults = HashMap.HGet(parent_def, "field_defaults")
            parent_default_keys = HashMap.HKeysSimple(parent_defaults)
            num_defaults = XArray.XSize(parent_default_keys)

            j = 0
            WhileLoop LessThan(j, num_defaults) {
                default_key = XArray.XGet(parent_default_keys, j)
                default_val = HashMap.HGet(parent_defaults, default_key)
                HashMap.HSet(HashMap.HGet(class_def, "field_defaults"), default_key, default_val)
                j = Add(j, 1)
            }
            XArray.XDestroy(parent_default_keys)

            parent_methods = HashMap.HGet(parent_def, "methods")
            parent_method_keys = HashMap.HKeysSimple(parent_methods)
            num_methods = XArray.XSize(parent_method_keys)

            k = 0
            WhileLoop LessThan(k, num_methods) {
                method_key = XArray.XGet(parent_method_keys, k)
                method_addr = HashMap.HGet(parent_methods, method_key)
                HashMap.HSet(HashMap.HGet(class_def, "methods"), method_key, method_addr)
                k = Add(k, 1)
            }
            XArray.XDestroy(parent_method_keys)

            // Inherit getters
            parent_getters = HashMap.HGet(parent_def, "getters")
            IfCondition NotEqual(parent_getters, 0) ThenBlock: {
                parent_getter_keys = HashMap.HKeysSimple(parent_getters)
                num_getters = XArray.XSize(parent_getter_keys)
                g = 0
                WhileLoop LessThan(g, num_getters) {
                    getter_key = XArray.XGet(parent_getter_keys, g)
                    getter_addr = HashMap.HGet(parent_getters, getter_key)
                    HashMap.HSet(HashMap.HGet(class_def, "getters"), getter_key, getter_addr)
                    g = Add(g, 1)
                }
                XArray.XDestroy(parent_getter_keys)
            }

            // Inherit setters
            parent_setters = HashMap.HGet(parent_def, "setters")
            IfCondition NotEqual(parent_setters, 0) ThenBlock: {
                parent_setter_keys = HashMap.HKeysSimple(parent_setters)
                num_setters = XArray.XSize(parent_setter_keys)
                s = 0
                WhileLoop LessThan(s, num_setters) {
                    setter_key = XArray.XGet(parent_setter_keys, s)
                    setter_addr = HashMap.HGet(parent_setters, setter_key)
                    HashMap.HSet(HashMap.HGet(class_def, "setters"), setter_key, setter_addr)
                    s = Add(s, 1)
                }
                XArray.XDestroy(parent_setter_keys)
            }
        }

        HashMap.HSet(JSClassRegistry.registry, name, class_def)
        ReturnValue(1)
    }
}

Function.JSOop.ClassField {
    Input: class_name: Address
    Input: field_name: Address
    Input: field_type: Address
    Output: Integer
    Body: {
        JSOop.EnsureInit()

        class_def = HashMap.HGet(JSClassRegistry.registry, class_name)
        IfCondition EqualTo(class_def, 0) ThenBlock: {
            ReturnValue(0)
        }

        fields = HashMap.HGet(class_def, "fields")
        HashMap.HSet(fields, field_name, field_type)
        ReturnValue(1)
    }
}

Function.JSOop.ClassFieldDefault {
    Input: class_name: Address
    Input: field_name: Address
    Input: default_val: Integer
    Output: Integer
    Body: {
        JSOop.EnsureInit()

        class_def = HashMap.HGet(JSClassRegistry.registry, class_name)
        IfCondition EqualTo(class_def, 0) ThenBlock: {
            ReturnValue(0)
        }

        field_defaults = HashMap.HGet(class_def, "field_defaults")
        HashMap.HSet(field_defaults, field_name, default_val)
        ReturnValue(1)
    }
}

Function.JSOop.ClassMethod {
    Input: class_name: Address
    Input: method_name: Address
    Input: func_addr: Address
    Output: Integer
    Body: {
        JSOop.EnsureInit()

        class_def = HashMap.HGet(JSClassRegistry.registry, class_name)
        IfCondition EqualTo(class_def, 0) ThenBlock: {
            ReturnValue(0)
        }

        methods = HashMap.HGet(class_def, "methods")
        HashMap.HSet(methods, method_name, func_addr)
        ReturnValue(1)
    }
}


//=============================================================================
// GETTER / SETTER SUPPORT (JS-specific extension)
//=============================================================================

Function.JSOop.ClassGetter {
    Input: class_name: Address
    Input: prop_name: Address
    Input: func_addr: Address
    Output: Integer
    Body: {
        JSOop.EnsureInit()

        class_def = HashMap.HGet(JSClassRegistry.registry, class_name)
        IfCondition EqualTo(class_def, 0) ThenBlock: {
            ReturnValue(0)
        }

        getters = HashMap.HGet(class_def, "getters")
        HashMap.HSet(getters, prop_name, func_addr)
        ReturnValue(1)
    }
}

Function.JSOop.ClassSetter {
    Input: class_name: Address
    Input: prop_name: Address
    Input: func_addr: Address
    Output: Integer
    Body: {
        JSOop.EnsureInit()

        class_def = HashMap.HGet(JSClassRegistry.registry, class_name)
        IfCondition EqualTo(class_def, 0) ThenBlock: {
            ReturnValue(0)
        }

        setters = HashMap.HGet(class_def, "setters")
        HashMap.HSet(setters, prop_name, func_addr)
        ReturnValue(1)
    }
}


//=============================================================================
// MIXIN SUPPORT
//=============================================================================

Function.JSOop.ClassMixin {
    Input: target_class: Address
    Input: mixin_class: Address
    Output: Integer
    Body: {
        JSOop.EnsureInit()

        target_def = HashMap.HGet(JSClassRegistry.registry, target_class)
        mixin_def = HashMap.HGet(JSClassRegistry.registry, mixin_class)

        IfCondition EqualTo(target_def, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(mixin_def, 0) ThenBlock: {
            ReturnValue(0)
        }

        target_methods = HashMap.HGet(target_def, "methods")
        mixin_methods = HashMap.HGet(mixin_def, "methods")
        mixin_method_keys = HashMap.HKeysSimple(mixin_methods)
        num_mixin_methods = XArray.XSize(mixin_method_keys)

        i = 0
        WhileLoop LessThan(i, num_mixin_methods) {
            method_key = XArray.XGet(mixin_method_keys, i)
            existing = HashMap.HGet(target_methods, method_key)
            IfCondition EqualTo(existing, 0) ThenBlock: {
                method_addr = HashMap.HGet(mixin_methods, method_key)
                HashMap.HSet(target_methods, method_key, method_addr)
            }
            i = Add(i, 1)
        }
        XArray.XDestroy(mixin_method_keys)

        ReturnValue(1)
    }
}

Function.JSOop.ClassMixinOverride {
    Input: target_class: Address
    Input: mixin_class: Address
    Output: Integer
    Body: {
        JSOop.EnsureInit()

        target_def = HashMap.HGet(JSClassRegistry.registry, target_class)
        mixin_def = HashMap.HGet(JSClassRegistry.registry, mixin_class)

        IfCondition EqualTo(target_def, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(mixin_def, 0) ThenBlock: {
            ReturnValue(0)
        }

        target_methods = HashMap.HGet(target_def, "methods")
        mixin_methods = HashMap.HGet(mixin_def, "methods")
        mixin_method_keys = HashMap.HKeysSimple(mixin_methods)
        num_mixin_methods = XArray.XSize(mixin_method_keys)

        i = 0
        WhileLoop LessThan(i, num_mixin_methods) {
            method_key = XArray.XGet(mixin_method_keys, i)
            method_addr = HashMap.HGet(mixin_methods, method_key)
            HashMap.HSet(target_methods, method_key, method_addr)
            i = Add(i, 1)
        }
        XArray.XDestroy(mixin_method_keys)

        ReturnValue(1)
    }
}


//=============================================================================
// OBJECT INSTANTIATION
//=============================================================================

Function.JSOop.ObjectNew {
    Input: class_name: Address
    Output: Address
    Body: {
        JSOop.EnsureInit()

        class_def = HashMap.HGet(JSClassRegistry.registry, class_name)
        IfCondition EqualTo(class_def, 0) ThenBlock: {
            ReturnValue(0)
        }

        obj = HashMap.Create(32)
        HashMap.HSet(obj, "__class__", class_name)
        HashMap.HSet(obj, "__data__", HashMap.Create(32))
        HashMap.HSet(obj, "__proto__", 0)

        data = HashMap.HGet(obj, "__data__")
        fields = HashMap.HGet(class_def, "fields")
        field_defaults = HashMap.HGet(class_def, "field_defaults")
        field_keys = HashMap.HKeysSimple(fields)
        num_fields = XArray.XSize(field_keys)

        i = 0
        WhileLoop LessThan(i, num_fields) {
            field_name = XArray.XGet(field_keys, i)

            default_val = HashMap.HGet(field_defaults, field_name)
            IfCondition NotEqual(default_val, 0) ThenBlock: {
                HashMap.HSet(data, field_name, default_val)
            } ElseBlock: {
                field_type = HashMap.HGet(fields, field_name)
                HashMap.HSet(data, field_name, 0)
            }
            i = Add(i, 1)
        }
        XArray.XDestroy(field_keys)

        ReturnValue(obj)
    }
}

Function.JSOop.ObjectNewInit {
    // Create instance AND call constructor (__init__) with args
    Input: class_name: Address
    Input: init_args: Address
    Output: Address
    Body: {
        obj = JSOop.ObjectNew(class_name)
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }

        IfCondition JSOop.MethodExists(obj, "__init__") ThenBlock: {
            JSOop.MethodCall(obj, "__init__", init_args)
        }

        ReturnValue(obj)
    }
}


//=============================================================================
// FIELD ACCESS
//=============================================================================

Function.JSOop.ObjectGet {
    Input: obj: Address
    Input: field_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        data = HashMap.HGet(obj, "__data__")
        ReturnValue(HashMap.HGet(data, field_name))
    }
}

Function.JSOop.ObjectSet {
    Input: obj: Address
    Input: field_name: Address
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        data = HashMap.HGet(obj, "__data__")
        HashMap.HSet(data, field_name, value)
        ReturnValue(1)
    }
}

Function.JSOop.ObjectHasField {
    Input: obj: Address
    Input: field_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        data = HashMap.HGet(obj, "__data__")
        value = HashMap.HGet(data, field_name)
        IfCondition NotEqual(value, 0) ThenBlock: {
            ReturnValue(1)
        }
        keys = HashMap.HKeysSimple(data)
        num_keys = XArray.XSize(keys)
        found = 0
        i = 0
        WhileLoop LessThan(i, num_keys) {
            key = XArray.XGet(keys, i)
            cmp = StringCompare(key, field_name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                found = 1
            }
            i = Add(i, 1)
        }
        XArray.XDestroy(keys)
        ReturnValue(found)
    }
}


//=============================================================================
// METHOD DISPATCH
//=============================================================================

Function.JSOop._MethodLookupInClass {
    Input: class_name: Address
    Input: method_name: Address
    Output: Address
    Body: {
        class_def = HashMap.HGet(JSClassRegistry.registry, class_name)
        IfCondition EqualTo(class_def, 0) ThenBlock: {
            ReturnValue(0)
        }
        methods = HashMap.HGet(class_def, "methods")
        ReturnValue(HashMap.HGet(methods, method_name))
    }
}

Function.JSOop._MethodLookupWithInheritance {
    Input: class_name: Address
    Input: method_name: Address
    Output: Address
    Body: {
        current_class = class_name

        WhileLoop NotEqual(current_class, 0) {
            func_addr = JSOop._MethodLookupInClass(current_class, method_name)
            IfCondition NotEqual(func_addr, 0) ThenBlock: {
                ReturnValue(func_addr)
            }

            class_def = HashMap.HGet(JSClassRegistry.registry, current_class)
            IfCondition EqualTo(class_def, 0) ThenBlock: {
                ReturnValue(0)
            }
            current_class = HashMap.HGet(class_def, "parent")
        }

        ReturnValue(0)
    }
}

Function.JSOop.MethodCall {
    Input: obj: Address
    Input: method_name: Address
    Input: args: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }

        class_name = HashMap.HGet(obj, "__class__")
        func_addr = JSOop._MethodLookupWithInheritance(class_name, method_name)

        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            ReturnValue(0)
        }

        num_args = TArray.TSize(args)

        IfCondition EqualTo(num_args, 0) ThenBlock: {
            result = CallIndirect(func_addr, obj)
            ReturnValue(result)
        }

        IfCondition EqualTo(num_args, 1) ThenBlock: {
            arg0 = TArray.TGet(args, 0)
            result = CallIndirect(func_addr, obj, arg0)
            ReturnValue(result)
        }

        IfCondition EqualTo(num_args, 2) ThenBlock: {
            arg0 = TArray.TGet(args, 0)
            arg1 = TArray.TGet(args, 1)
            result = CallIndirect(func_addr, obj, arg0, arg1)
            ReturnValue(result)
        }

        IfCondition EqualTo(num_args, 3) ThenBlock: {
            arg0 = TArray.TGet(args, 0)
            arg1 = TArray.TGet(args, 1)
            arg2 = TArray.TGet(args, 2)
            result = CallIndirect(func_addr, obj, arg0, arg1, arg2)
            ReturnValue(result)
        }

        IfCondition EqualTo(num_args, 4) ThenBlock: {
            arg0 = TArray.TGet(args, 0)
            arg1 = TArray.TGet(args, 1)
            arg2 = TArray.TGet(args, 2)
            arg3 = TArray.TGet(args, 3)
            result = CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3)
            ReturnValue(result)
        }

        // 5+ args
        arg0 = TArray.TGet(args, 0)
        arg1 = TArray.TGet(args, 1)
        arg2 = TArray.TGet(args, 2)
        arg3 = TArray.TGet(args, 3)
        arg4 = TArray.TGet(args, 4)
        result = CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3, arg4)
        ReturnValue(result)
    }
}

Function.JSOop.MethodExists {
    Input: obj: Address
    Input: method_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }

        class_name = HashMap.HGet(obj, "__class__")
        func_addr = JSOop._MethodLookupWithInheritance(class_name, method_name)

        IfCondition NotEqual(func_addr, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.JSOop.MethodLookup {
    Input: obj: Address
    Input: method_name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }

        class_name = HashMap.HGet(obj, "__class__")
        ReturnValue(JSOop._MethodLookupWithInheritance(class_name, method_name))
    }
}


//=============================================================================
// GETTER / SETTER DISPATCH (JS-specific)
//=============================================================================

Function.JSOop._GetterLookup {
    Input: class_name: Address
    Input: prop_name: Address
    Output: Address
    Body: {
        current_class = class_name
        WhileLoop NotEqual(current_class, 0) {
            class_def = HashMap.HGet(JSClassRegistry.registry, current_class)
            IfCondition EqualTo(class_def, 0) ThenBlock: {
                ReturnValue(0)
            }
            getters = HashMap.HGet(class_def, "getters")
            IfCondition NotEqual(getters, 0) ThenBlock: {
                func_addr = HashMap.HGet(getters, prop_name)
                IfCondition NotEqual(func_addr, 0) ThenBlock: {
                    ReturnValue(func_addr)
                }
            }
            current_class = HashMap.HGet(class_def, "parent")
        }
        ReturnValue(0)
    }
}

Function.JSOop._SetterLookup {
    Input: class_name: Address
    Input: prop_name: Address
    Output: Address
    Body: {
        current_class = class_name
        WhileLoop NotEqual(current_class, 0) {
            class_def = HashMap.HGet(JSClassRegistry.registry, current_class)
            IfCondition EqualTo(class_def, 0) ThenBlock: {
                ReturnValue(0)
            }
            setters = HashMap.HGet(class_def, "setters")
            IfCondition NotEqual(setters, 0) ThenBlock: {
                func_addr = HashMap.HGet(setters, prop_name)
                IfCondition NotEqual(func_addr, 0) ThenBlock: {
                    ReturnValue(func_addr)
                }
            }
            current_class = HashMap.HGet(class_def, "parent")
        }
        ReturnValue(0)
    }
}

Function.JSOop.GetterCall {
    // Call a getter on an object — returns the property value
    Input: obj: Address
    Input: prop_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        class_name = HashMap.HGet(obj, "__class__")
        func_addr = JSOop._GetterLookup(class_name, prop_name)
        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            ReturnValue(0)
        }
        result = CallIndirect(func_addr, obj)
        ReturnValue(result)
    }
}

Function.JSOop.SetterCall {
    // Call a setter on an object — sets the property value
    Input: obj: Address
    Input: prop_name: Address
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        class_name = HashMap.HGet(obj, "__class__")
        func_addr = JSOop._SetterLookup(class_name, prop_name)
        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            ReturnValue(0)
        }
        result = CallIndirect(func_addr, obj, value)
        ReturnValue(result)
    }
}

Function.JSOop.HasGetter {
    Input: obj: Address
    Input: prop_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        class_name = HashMap.HGet(obj, "__class__")
        func_addr = JSOop._GetterLookup(class_name, prop_name)
        IfCondition NotEqual(func_addr, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.JSOop.HasSetter {
    Input: obj: Address
    Input: prop_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        class_name = HashMap.HGet(obj, "__class__")
        func_addr = JSOop._SetterLookup(class_name, prop_name)
        IfCondition NotEqual(func_addr, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}


//=============================================================================
// INTROSPECTION
//=============================================================================

Function.JSOop.ObjectClass {
    Input: obj: Address
    Output: Address
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(HashMap.HGet(obj, "__class__"))
    }
}

Function.JSOop.ObjectIsInstance {
    Input: obj: Address
    Input: class_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }

        obj_class = HashMap.HGet(obj, "__class__")
        current_class = obj_class

        WhileLoop NotEqual(current_class, 0) {
            cmp = StringCompare(current_class, class_name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }

            class_def = HashMap.HGet(JSClassRegistry.registry, current_class)
            IfCondition EqualTo(class_def, 0) ThenBlock: {
                ReturnValue(0)
            }
            current_class = HashMap.HGet(class_def, "parent")
        }

        ReturnValue(0)
    }
}

Function.JSOop.ClassGetFields {
    Input: class_name: Address
    Output: Address
    Body: {
        JSOop.EnsureInit()

        class_def = HashMap.HGet(JSClassRegistry.registry, class_name)
        IfCondition EqualTo(class_def, 0) ThenBlock: {
            ReturnValue(XArray.XCreate(0))
        }

        fields = HashMap.HGet(class_def, "fields")
        ReturnValue(HashMap.HKeysSimple(fields))
    }
}

Function.JSOop.ClassGetMethods {
    Input: class_name: Address
    Output: Address
    Body: {
        JSOop.EnsureInit()

        class_def = HashMap.HGet(JSClassRegistry.registry, class_name)
        IfCondition EqualTo(class_def, 0) ThenBlock: {
            ReturnValue(XArray.XCreate(0))
        }

        methods = HashMap.HGet(class_def, "methods")
        ReturnValue(HashMap.HKeysSimple(methods))
    }
}

Function.JSOop.ClassGetParent {
    Input: class_name: Address
    Output: Address
    Body: {
        JSOop.EnsureInit()

        class_def = HashMap.HGet(JSClassRegistry.registry, class_name)
        IfCondition EqualTo(class_def, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(HashMap.HGet(class_def, "parent"))
    }
}

Function.JSOop.ClassExists {
    Input: class_name: Address
    Output: Integer
    Body: {
        JSOop.EnsureInit()

        class_def = HashMap.HGet(JSClassRegistry.registry, class_name)
        IfCondition NotEqual(class_def, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}


//=============================================================================
// SUPER CALL SUPPORT (prototype chain traversal)
//=============================================================================

Function.JSOop.SuperCall {
    Input: obj: Address
    Input: current_class: Address
    Input: method_name: Address
    Input: args: Address
    Output: Integer
    Body: {
        class_def = HashMap.HGet(JSClassRegistry.registry, current_class)
        IfCondition EqualTo(class_def, 0) ThenBlock: {
            ReturnValue(0)
        }

        parent_class = HashMap.HGet(class_def, "parent")
        IfCondition EqualTo(parent_class, 0) ThenBlock: {
            ReturnValue(0)
        }

        func_addr = JSOop._MethodLookupWithInheritance(parent_class, method_name)
        IfCondition EqualTo(func_addr, 0) ThenBlock: {
            ReturnValue(0)
        }

        num_args = TArray.TSize(args)

        IfCondition EqualTo(num_args, 0) ThenBlock: {
            result = CallIndirect(func_addr, obj)
            ReturnValue(result)
        }

        IfCondition EqualTo(num_args, 1) ThenBlock: {
            arg0 = TArray.TGet(args, 0)
            result = CallIndirect(func_addr, obj, arg0)
            ReturnValue(result)
        }

        IfCondition EqualTo(num_args, 2) ThenBlock: {
            arg0 = TArray.TGet(args, 0)
            arg1 = TArray.TGet(args, 1)
            result = CallIndirect(func_addr, obj, arg0, arg1)
            ReturnValue(result)
        }

        IfCondition EqualTo(num_args, 3) ThenBlock: {
            arg0 = TArray.TGet(args, 0)
            arg1 = TArray.TGet(args, 1)
            arg2 = TArray.TGet(args, 2)
            result = CallIndirect(func_addr, obj, arg0, arg1, arg2)
            ReturnValue(result)
        }

        IfCondition EqualTo(num_args, 4) ThenBlock: {
            arg0 = TArray.TGet(args, 0)
            arg1 = TArray.TGet(args, 1)
            arg2 = TArray.TGet(args, 2)
            arg3 = TArray.TGet(args, 3)
            result = CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3)
            ReturnValue(result)
        }

        // 5+ args
        arg0 = TArray.TGet(args, 0)
        arg1 = TArray.TGet(args, 1)
        arg2 = TArray.TGet(args, 2)
        arg3 = TArray.TGet(args, 3)
        arg4 = TArray.TGet(args, 4)
        result = CallIndirect(func_addr, obj, arg0, arg1, arg2, arg3, arg4)
        ReturnValue(result)
    }
}


//=============================================================================
// END Library.JSOop.ailang
//=============================================================================
