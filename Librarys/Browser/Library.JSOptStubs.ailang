// Library.JSOptStubs.ailang — inactive register-scan hooks
// The JS method JIT emits through Compiler.CodeEmit, and those emitters
// call the AILANG register scanner. The scanner returns immediately when
// it is off. The JS harness never turns it on, and importing
// Library.COptLinScan would register a second set of pools.
// These bodies are that early return.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// These pools belong to the AILANG register scanner. The emitters read
// them and take the scan-off path at the initial values. Declared here,
// after the JS pools, so the JS slot numbers stay put.
FixedPool.ScanState {
    "want": Initialize=-1, CanChange=True
    "eligible": Initialize=0, CanChange=True
}

FixedPool.LoopHome {
    "ip_hit_reg": Initialize=0, CanChange=True
}

Function.Optimize_ScanClobberReg {
    Input: reg: Integer
    Body: {
        ReturnValue(0)
    }
}

Function.Optimize_ScanDropXmm {
    Body: {
        ReturnValue(0)
    }
}

Function.Optimize_ScanForgetCallers {
    Body: {
        ReturnValue(0)
    }
}

Function.Optimize_ScanNoteAsm {
    Input: asm_str: Address
    Body: {
        ReturnValue(0)
    }
}

Function.Optimize_ScanSpillCallers {
    Body: {
        ReturnValue(0)
    }
}

Function.Optimize_VerifyCover {
    Input: start: Integer
    Body: {
        ReturnValue(0)
    }
}

// Frame slots are not held in registers inside the JS harness.
// Compile.ph0..ph5 initialize to -1, and nothing here calls HoldSet.
Function.CompileFunc_HoldReg {
    Input: offset: Integer
    Output: Integer
    Body: {
        ReturnValue(-1)
    }
}

// Listing is off in the harness, so this line lookup is not called.
Function.AST_GetLine {
    Input: node: Address
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}
