// Library.JSParser.ailang — Recursive descent JavaScript parser with Pratt precedence
// Consumes token stream from JSLexer, builds AST with linked-list children.
// Handles statements, expressions, Pratt precedence climbing for binary ops,
// assignment, ternary, unary prefix/postfix, member access, calls.
//
// CLOBBER FIX: ASTTmp fields are global — recursive calls overwrite them.
// ASTStack (push/pop) saves/restores critical values across every recursive
// parse call so that callers see their own values after the callee returns.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Browser.JSLexer
// JSValidate — imported via JSEngine (truth table validation)

// =============================================================================
// AST NODE TYPES (~35)
// =============================================================================
FixedPool.ASTType {
    "PROGRAM":        Initialize=1
    "BLOCK":          Initialize=2
    "VAR_DECL":       Initialize=3
    "FUNC_DECL":      Initialize=4
    "RETURN_STMT":    Initialize=5
    "IF_STMT":        Initialize=6
    "WHILE_STMT":     Initialize=7
    "FOR_STMT":       Initialize=8
    "BREAK_STMT":     Initialize=9
    "CONTINUE_STMT":  Initialize=10
    "EXPR_STMT":      Initialize=11
    "ASSIGN":         Initialize=12
    "BINARY_OP":      Initialize=13
    "UNARY_OP":       Initialize=14
    "CALL":           Initialize=15
    "MEMBER_DOT":     Initialize=16
    "MEMBER_BRACKET": Initialize=17
    "IDENT":          Initialize=18
    "NUMBER_LIT":     Initialize=19
    "STRING_LIT":     Initialize=20
    "BOOL_LIT":       Initialize=21
    "NULL_LIT":       Initialize=22
    "UNDEF_LIT":      Initialize=23
    "OBJECT_LIT":     Initialize=24
    "ARRAY_LIT":      Initialize=25
    "PROPERTY":       Initialize=26
    "FUNC_EXPR":      Initialize=27
    "TERNARY":        Initialize=28
    "UPDATE_EXPR":    Initialize=29
    "TYPEOF_EXPR":    Initialize=30
    "NEW_EXPR":       Initialize=31
    "THIS_EXPR":      Initialize=32
    "DO_WHILE":       Initialize=33
    "SWITCH_STMT":    Initialize=34
    "CASE_CLAUSE":    Initialize=35
    "TRY_STMT":       Initialize=36
    "THROW_STMT":     Initialize=37
}

// =============================================================================
// AST NODE STRUCTURE — 80 bytes per node
// =============================================================================
FixedPool.ASTConst {
    "NODE_SIZE":     Initialize=80
    "MAX_NODES":     Initialize=16384
    "N_TYPE":        Initialize=0
    "N_OP":          Initialize=8
    "N_LEFT":        Initialize=16
    "N_RIGHT":       Initialize=24
    "N_COND":        Initialize=32
    "N_BODY":        Initialize=40
    "N_NAME_PTR":    Initialize=48
    "N_NAME_LEN":    Initialize=56
    "N_VALUE":       Initialize=64
    "N_NEXT":        Initialize=72
}

// =============================================================================
// PARSER STATE
// =============================================================================
FixedPool.ASTState {
    "node_pool":   Initialize=0
    "node_count":  Initialize=0
    "tok_pos":     Initialize=0
    "tok_total":   Initialize=0
    "error":       Initialize=0
    "err_msg":     Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.ASTTmp {
    "idx":         Initialize=0
    "type":        Initialize=0
    "ptr":         Initialize=0
    "len":         Initialize=0
    "node":        Initialize=0
    "left":        Initialize=0
    "right":       Initialize=0
    "cond":        Initialize=0
    "body":        Initialize=0
    "op":          Initialize=0
    "count":       Initialize=0
    "done":        Initialize=0
    "val":         Initialize=0
    "first":       Initialize=0
    "last":        Initialize=0
    "prec":        Initialize=0
    "name_ptr":    Initialize=0
    "name_len":    Initialize=0
}

// =============================================================================
// PARSER FRAME STACK — save/restore ASTTmp fields across recursive calls
// =============================================================================
FixedPool.ASTStack {
    "pool":       Initialize=0
    "sp":         Initialize=0
    "capacity":   Initialize=0
    "tmp_val":    Initialize=0
    "tmp_addr":   Initialize=0
}

// =============================================================================
// STACK PUSH / POP
// =============================================================================
Function.AST__Push {
    Input: val: Integer
    Output: Integer
    Body: {
        // Save val to ASTStack scratch — must NOT touch ASTTmp fields
        ASTStack.tmp_val = val
        ASTStack.tmp_addr = Add(ASTStack.pool, Multiply(ASTStack.sp, 8))
        StoreValue(ASTStack.tmp_addr, ASTStack.tmp_val)
        ASTStack.sp = Add(ASTStack.sp, 1)
        ReturnValue(0)
    }
}

Function.AST__Pop {
    Output: Integer
    Body: {
        ASTStack.sp = Subtract(ASTStack.sp, 1)
        ReturnValue(Dereference(Add(ASTStack.pool, Multiply(ASTStack.sp, 8))))
    }
}

// =============================================================================
// INIT / RESET
// =============================================================================
Function.JSParse_Init {
    Output: Integer
    Body: {
        sz = Multiply(ASTConst.MAX_NODES, ASTConst.NODE_SIZE)
        ASTState.node_pool = Allocate(sz)
        MemorySet(ASTState.node_pool, 0, sz)
        ASTState.node_count = 0
        ASTState.error = 0

        // Init parser frame stack (1024 entries x 8 bytes = 8192)
        ASTStack.pool = Allocate(8192)
        ASTStack.capacity = 1024
        ASTStack.sp = 0

        ReturnValue(1)
    }
}

Function.JSParse_Reset {
    Output: Integer
    Body: {
        sz = Multiply(ASTConst.MAX_NODES, ASTConst.NODE_SIZE)
        MemorySet(ASTState.node_pool, 0, sz)
        ASTState.node_count = 0
        ASTState.tok_pos = 0
        ASTState.tok_total = 0
        ASTState.error = 0
        ASTState.err_msg = 0
        ASTStack.sp = 0
        ReturnValue(0)
    }
}

// =============================================================================
// INTERNAL: NODE ALLOCATION
// =============================================================================
Function.JSParse__AllocNode {
    Output: Integer
    Body: {
        idx = ASTState.node_count
        IfCondition GreaterEqual(idx, ASTConst.MAX_NODES) ThenBlock: {
            ASTState.error = 1
            ReturnValue(-1)
        }
        ASTState.node_count = Add(idx, 1)
        base = Add(ASTState.node_pool, Multiply(idx, ASTConst.NODE_SIZE))
        MemorySet(base, 0, ASTConst.NODE_SIZE)
        // Set all link fields to -1
        StoreValue(Add(base, ASTConst.N_LEFT), -1)
        StoreValue(Add(base, ASTConst.N_RIGHT), -1)
        StoreValue(Add(base, ASTConst.N_COND), -1)
        StoreValue(Add(base, ASTConst.N_BODY), -1)
        StoreValue(Add(base, ASTConst.N_NEXT), -1)
        ReturnValue(idx)
    }
}

// =============================================================================
// INTERNAL: NODE FIELD ACCESS
// =============================================================================
Function.JSParse__NodeSet {
    Input: node_idx: Integer
    Input: field_off: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        // Save all Input params to locals before any calls clobber registers
        save_idx = node_idx
        save_off = field_off
        save_val = value
        base = Add(ASTState.node_pool, Multiply(save_idx, ASTConst.NODE_SIZE))
        StoreValue(Add(base, save_off), save_val)
        ReturnValue(0)
    }
}

Function.JSParse__NodeGet {
    Input: node_idx: Integer
    Input: field_off: Integer
    Output: Integer
    Body: {
        // Save all Input params to locals before any calls clobber registers
        save_idx = node_idx
        save_off = field_off
        base = Add(ASTState.node_pool, Multiply(save_idx, ASTConst.NODE_SIZE))
        ReturnValue(Dereference(Add(base, save_off)))
    }
}

// =============================================================================
// INTERNAL: TOKEN NAVIGATION
// =============================================================================
Function.JSParse__Peek {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(ASTState.tok_pos, ASTState.tok_total) ThenBlock: {
            ReturnValue(JSTokType.EOF)
        }
        ReturnValue(JSLex_GetType(ASTState.tok_pos))
    }
}

Function.JSParse__PeekType {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(ASTState.tok_pos, ASTState.tok_total) ThenBlock: {
            ReturnValue(JSTokType.EOF)
        }
        ReturnValue(JSLex_GetType(ASTState.tok_pos))
    }
}

Function.JSParse__Advance {
    Output: Integer
    Body: {
        prev = ASTState.tok_pos
        IfCondition LessThan(ASTState.tok_pos, ASTState.tok_total) ThenBlock: {
            ASTState.tok_pos = Add(ASTState.tok_pos, 1)
        }
        ReturnValue(prev)
    }
}

Function.JSParse__Expect {
    Input: tok_type: Integer
    Output: Integer
    Body: {
        // Save tok_type to FixedPool — register won't survive PeekType call
        ASTTmp.type = tok_type
        ASTTmp.idx = JSParse__PeekType()
        IfCondition NotEqual(ASTTmp.idx, ASTTmp.type) ThenBlock: {
            ASTState.error = 1
            ReturnValue(-1)
        }
        ReturnValue(JSParse__Advance())
    }
}

// =============================================================================
// INTERNAL: NUMBER PARSING — decimal, hex, octal, binary, float (truncated)
// =============================================================================
Function.JSParse__ParseInt {
    Input: ptr: Address
    Input: len: Integer
    Output: Integer
    Body: {
        ASTTmp.ptr = ptr
        ASTTmp.len = len
        ASTTmp.val = 0
        ASTTmp.idx = 0

        // Check for 0x/0X, 0o/0O, 0b/0B prefix (need at least 2 chars)
        IfCondition And(GreaterEqual(ASTTmp.len, 2), EqualTo(GetByte(ASTTmp.ptr, 0), 48)) ThenBlock: {
            ASTTmp.count = GetByte(ASTTmp.ptr, 1)

            // --- HEX: 0x / 0X ---
            IfCondition Or(EqualTo(ASTTmp.count, 120), EqualTo(ASTTmp.count, 88)) ThenBlock: {
                ASTTmp.idx = 2
                WhileLoop LessThan(ASTTmp.idx, ASTTmp.len) {
                    ASTTmp.op = Multiply(ASTTmp.val, 16)
                    ASTTmp.count = GetByte(ASTTmp.ptr, ASTTmp.idx)
                    // 0-9
                    IfCondition And(GreaterEqual(ASTTmp.count, 48), LessEqual(ASTTmp.count, 57)) ThenBlock: {
                        ASTTmp.val = Add(ASTTmp.op, Subtract(ASTTmp.count, 48))
                    }
                    // a-f
                    IfCondition And(GreaterEqual(ASTTmp.count, 97), LessEqual(ASTTmp.count, 102)) ThenBlock: {
                        ASTTmp.val = Add(ASTTmp.op, Subtract(ASTTmp.count, 87))
                    }
                    // A-F
                    IfCondition And(GreaterEqual(ASTTmp.count, 65), LessEqual(ASTTmp.count, 70)) ThenBlock: {
                        ASTTmp.val = Add(ASTTmp.op, Subtract(ASTTmp.count, 55))
                    }
                    ASTTmp.idx = Add(ASTTmp.idx, 1)
                }
                ReturnValue(ASTTmp.val)
            }

            // --- OCTAL: 0o / 0O ---
            IfCondition Or(EqualTo(ASTTmp.count, 111), EqualTo(ASTTmp.count, 79)) ThenBlock: {
                ASTTmp.idx = 2
                WhileLoop LessThan(ASTTmp.idx, ASTTmp.len) {
                    ASTTmp.op = Multiply(ASTTmp.val, 8)
                    ASTTmp.count = GetByte(ASTTmp.ptr, ASTTmp.idx)
                    ASTTmp.val = Add(ASTTmp.op, Subtract(ASTTmp.count, 48))
                    ASTTmp.idx = Add(ASTTmp.idx, 1)
                }
                ReturnValue(ASTTmp.val)
            }

            // --- BINARY: 0b / 0B ---
            IfCondition Or(EqualTo(ASTTmp.count, 98), EqualTo(ASTTmp.count, 66)) ThenBlock: {
                ASTTmp.idx = 2
                WhileLoop LessThan(ASTTmp.idx, ASTTmp.len) {
                    ASTTmp.op = Multiply(ASTTmp.val, 2)
                    ASTTmp.count = GetByte(ASTTmp.ptr, ASTTmp.idx)
                    ASTTmp.val = Add(ASTTmp.op, Subtract(ASTTmp.count, 48))
                    ASTTmp.idx = Add(ASTTmp.idx, 1)
                }
                ReturnValue(ASTTmp.val)
            }
        }

        // --- DECIMAL (with float truncation) ---
        // Parse integer part; stop at '.' or 'e'/'E'
        WhileLoop LessThan(ASTTmp.idx, ASTTmp.len) {
            ASTTmp.count = GetByte(ASTTmp.ptr, ASTTmp.idx)
            // Stop at decimal point or exponent
            IfCondition Or(EqualTo(ASTTmp.count, 46), Or(EqualTo(ASTTmp.count, 101), EqualTo(ASTTmp.count, 69))) ThenBlock: {
                // Break out — set idx to len to exit loop
                ASTTmp.idx = ASTTmp.len
            } ElseBlock: {
                ASTTmp.op = Multiply(ASTTmp.val, 10)
                ASTTmp.count = Subtract(ASTTmp.count, 48)
                ASTTmp.val = Add(ASTTmp.op, ASTTmp.count)
                ASTTmp.idx = Add(ASTTmp.idx, 1)
            }
        }
        // Float decimals and exponents are consumed by the lexer but
        // truncated here — integer semantics throughout the engine.
        ReturnValue(ASTTmp.val)
    }
}

// =============================================================================
// FORWARD DECLARATIONS — Ailang resolves within a library file
// Expression entry points called recursively from statement parsers
// =============================================================================

// JSParse__Expr()        — full expression (assignment level)
// JSParse__Assign()      — assignment / ternary / precedence
// JSParse__Ternary()     — ternary conditional
// JSParse__Precedence(min_prec) — Pratt climbing
// JSParse__Unary()       — prefix operators
// JSParse__Postfix()     — postfix / member / call
// JSParse__Primary()     — atoms
// JSParse__Block()       — { ... }
// JSParse__Statement()   — single statement

// =============================================================================
// EXPRESSION PARSING — Pratt precedence climbing
// =============================================================================

// ---------------------------------------------------------------------------
// Get binary operator precedence (0 = not a binary op)
// ---------------------------------------------------------------------------
Function.JSParse__GetPrec {
    Input: tok_type: Integer
    Output: Integer
    Body: {
        // OR = 1
        IfCondition EqualTo(tok_type, JSTokType.OR) ThenBlock: { ReturnValue(1) }
        // AND = 2
        IfCondition EqualTo(tok_type, JSTokType.AND) ThenBlock: { ReturnValue(2) }
        // PIPE = 3
        IfCondition EqualTo(tok_type, JSTokType.PIPE) ThenBlock: { ReturnValue(3) }
        // CARET = 4
        IfCondition EqualTo(tok_type, JSTokType.CARET) ThenBlock: { ReturnValue(4) }
        // AMP = 5
        IfCondition EqualTo(tok_type, JSTokType.AMP) ThenBlock: { ReturnValue(5) }
        // Equality = 6
        IfCondition EqualTo(tok_type, JSTokType.EQ) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(tok_type, JSTokType.NEQ) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(tok_type, JSTokType.STRICT_EQ) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(tok_type, JSTokType.STRICT_NEQ) ThenBlock: { ReturnValue(6) }
        // Relational = 7
        IfCondition EqualTo(tok_type, JSTokType.LT) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(tok_type, JSTokType.GT) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(tok_type, JSTokType.LTE) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(tok_type, JSTokType.GTE) ThenBlock: { ReturnValue(7) }
        // Shift = 8
        IfCondition EqualTo(tok_type, JSTokType.SHL) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(tok_type, JSTokType.SHR) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(tok_type, JSTokType.USHR) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(tok_type, JSTokType.KW_INSTANCEOF) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(tok_type, JSTokType.KW_IN) ThenBlock: { ReturnValue(7) }
        // Additive = 9
        IfCondition EqualTo(tok_type, JSTokType.PLUS) ThenBlock: { ReturnValue(9) }
        IfCondition EqualTo(tok_type, JSTokType.MINUS) ThenBlock: { ReturnValue(9) }
        // Multiplicative = 10
        IfCondition EqualTo(tok_type, JSTokType.STAR) ThenBlock: { ReturnValue(10) }
        IfCondition EqualTo(tok_type, JSTokType.SLASH) ThenBlock: { ReturnValue(10) }
        IfCondition EqualTo(tok_type, JSTokType.PERCENT) ThenBlock: { ReturnValue(10) }
        // Not a binary operator
        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// Check if token is an assignment operator
// ---------------------------------------------------------------------------
Function.JSParse__IsAssignOp {
    Input: tok_type: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(tok_type, JSTokType.ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tok_type, JSTokType.PLUS_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tok_type, JSTokType.MINUS_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tok_type, JSTokType.STAR_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tok_type, JSTokType.SLASH_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tok_type, JSTokType.PERCENT_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tok_type, JSTokType.AMP_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tok_type, JSTokType.PIPE_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tok_type, JSTokType.CARET_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tok_type, JSTokType.SHL_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tok_type, JSTokType.SHR_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tok_type, JSTokType.USHR_ASSIGN) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// Primary — atoms: number, string, bool, null, undefined, this, ident,
//           grouped expr, object lit, array lit, function expr
// ---------------------------------------------------------------------------
Function.JSParse__Primary {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        ASTTmp.type = JSParse__PeekType()

        // --- NUMBER ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.NUMBER) ThenBlock: {
            ASTTmp.idx = JSParse__Advance()
            ASTTmp.ptr = JSLex_GetPtr(ASTTmp.idx)
            ASTTmp.len = JSLex_GetLen(ASTTmp.idx)
            ASTTmp.val = JSParse__ParseInt(ASTTmp.ptr, ASTTmp.len)
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.NUMBER_LIT)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, ASTTmp.val)
            ReturnValue(ASTTmp.node)
        }

        // --- STRING ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.STRING) ThenBlock: {
            ASTTmp.idx = JSParse__Advance()
            ASTTmp.ptr = JSLex_GetPtr(ASTTmp.idx)
            ASTTmp.len = JSLex_GetLen(ASTTmp.idx)
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.STRING_LIT)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, ASTTmp.ptr)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, ASTTmp.len)
            ReturnValue(ASTTmp.node)
        }

        // --- TRUE ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_TRUE) ThenBlock: {
            JSParse__Advance()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.BOOL_LIT)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, 1)
            ReturnValue(ASTTmp.node)
        }

        // --- FALSE ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_FALSE) ThenBlock: {
            JSParse__Advance()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.BOOL_LIT)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, 0)
            ReturnValue(ASTTmp.node)
        }

        // --- NULL ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_NULL) ThenBlock: {
            JSParse__Advance()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.NULL_LIT)
            ReturnValue(ASTTmp.node)
        }

        // --- UNDEFINED ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_UNDEFINED) ThenBlock: {
            JSParse__Advance()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.UNDEF_LIT)
            ReturnValue(ASTTmp.node)
        }

        // --- THIS ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_THIS) ThenBlock: {
            JSParse__Advance()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.THIS_EXPR)
            ReturnValue(ASTTmp.node)
        }

        // --- IDENT ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.IDENT) ThenBlock: {
            ASTTmp.idx = JSParse__Advance()
            ASTTmp.ptr = JSLex_GetPtr(ASTTmp.idx)
            ASTTmp.len = JSLex_GetLen(ASTTmp.idx)
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.IDENT)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, ASTTmp.ptr)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, ASTTmp.len)
            ReturnValue(ASTTmp.node)
        }

        // --- GROUPED EXPRESSION (parenthesized) ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.LPAREN) ThenBlock: {
            JSParse__Advance()
            ASTTmp.node = JSParse__Expr()
            JSParse__Expect(JSTokType.RPAREN)
            ReturnValue(ASTTmp.node)
        }

        // --- OBJECT LITERAL ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.LBRACE) ThenBlock: {
            JSParse__Advance()
            ASTTmp.node = JSParse__ObjLit()
            ReturnValue(ASTTmp.node)
        }

        // --- ARRAY LITERAL ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.LBRACKET) ThenBlock: {
            JSParse__Advance()
            ASTTmp.node = JSParse__ArrLit()
            ReturnValue(ASTTmp.node)
        }

        // --- FUNCTION EXPRESSION ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_FUNCTION) ThenBlock: {
            ASTTmp.node = JSParse__FuncExpr()
            ReturnValue(ASTTmp.node)
        }

        // --- UNEXPECTED TOKEN ---
        ASTState.error = 1
        ReturnValue(-1)
    }
}

// ---------------------------------------------------------------------------
// Object literal — LBRACE already consumed
// Parse key:value pairs linked via N_NEXT
// CLOBBER FIX: push node, first, last, prop(right) before JSParse__Assign()
// ---------------------------------------------------------------------------
Function.JSParse__ObjLit {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.OBJECT_LIT)
        ASTTmp.first = -1
        ASTTmp.last = -1

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RBRACE) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // Parse property: key (IDENT, STRING, or NUMBER), then value
                prop = JSParse__AllocNode()
                JSParse__NodeSet(prop, ASTConst.N_TYPE, ASTType.PROPERTY)

                // Key — identifier, string, or number
                ASTTmp.type = JSParse__PeekType()
                key_is_ident = 0
                IfCondition EqualTo(ASTTmp.type, JSTokType.IDENT) ThenBlock: {
                    ASTTmp.idx = JSParse__Advance()
                    ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
                    ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
                    JSParse__NodeSet(prop, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
                    JSParse__NodeSet(prop, ASTConst.N_NAME_LEN, ASTTmp.name_len)
                    key_is_ident = 1
                }
                IfCondition EqualTo(ASTTmp.type, JSTokType.STRING) ThenBlock: {
                    ASTTmp.idx = JSParse__Advance()
                    ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
                    ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
                    JSParse__NodeSet(prop, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
                    JSParse__NodeSet(prop, ASTConst.N_NAME_LEN, ASTTmp.name_len)
                }
                IfCondition EqualTo(ASTTmp.type, JSTokType.NUMBER) ThenBlock: {
                    ASTTmp.idx = JSParse__Advance()
                    ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
                    ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
                    JSParse__NodeSet(prop, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
                    JSParse__NodeSet(prop, ASTConst.N_NAME_LEN, ASTTmp.name_len)
                }
                IfCondition And(And(NotEqual(ASTTmp.type, JSTokType.IDENT), NotEqual(ASTTmp.type, JSTokType.STRING)),
                               NotEqual(ASTTmp.type, JSTokType.NUMBER)) ThenBlock: {
                    ASTState.error = 1
                }

                // Check what follows the key:
                //   COLON → regular property (key: value)
                //   LPAREN → shorthand method (key(args){ body })
                //   COMMA/RBRACE → shorthand property (key → key: key)
                ASTTmp.type = JSParse__PeekType()

                IfCondition EqualTo(ASTTmp.type, JSTokType.LPAREN) ThenBlock: {
                    // ── Shorthand method: key(params) { body } ──
                    // Build a FUNC_EXPR node inline, same pattern as FuncExpr
                    JSParse__Advance()

                    // Save prop via ASTTmp.right, build func node
                    ASTTmp.right = prop

                    // CLOBBER GUARD — save outer obj state
                    AST__Push(ASTTmp.node)
                    AST__Push(ASTTmp.first)
                    AST__Push(ASTTmp.last)
                    AST__Push(ASTTmp.right)
                    AST__Push(ASTTmp.done)

                    ASTTmp.node = JSParse__AllocNode()
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.FUNC_EXPR)

                    // Parse parameter list (reuse ASTTmp.first/last/count/done)
                    ASTTmp.first = -1
                    ASTTmp.last = -1
                    ASTTmp.count = 0
                    ASTTmp.done = 0
                    ASTTmp.type = JSParse__PeekType()
                    IfCondition EqualTo(ASTTmp.type, JSTokType.RPAREN) ThenBlock: {
                        ASTTmp.done = 1
                    }
                    WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
                        ASTTmp.type = JSParse__PeekType()
                        IfCondition EqualTo(ASTTmp.type, JSTokType.RPAREN) ThenBlock: {
                            ASTTmp.done = 1
                        }
                        IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                            ASTTmp.done = 1
                        }
                        IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                            ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)

                            // CLOBBER GUARD for AllocNode
                            AST__Push(ASTTmp.node)
                            AST__Push(ASTTmp.first)
                            AST__Push(ASTTmp.last)
                            AST__Push(ASTTmp.count)

                            param = JSParse__AllocNode()

                            ASTTmp.count = AST__Pop()
                            ASTTmp.last = AST__Pop()
                            ASTTmp.first = AST__Pop()
                            ASTTmp.node = AST__Pop()

                            JSParse__NodeSet(param, ASTConst.N_TYPE, ASTType.IDENT)
                            ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
                            ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
                            JSParse__NodeSet(param, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
                            JSParse__NodeSet(param, ASTConst.N_NAME_LEN, ASTTmp.name_len)
                            ASTTmp.count = Add(ASTTmp.count, 1)

                            IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                                ASTTmp.first = param
                                ASTTmp.last = param
                            } ElseBlock: {
                                JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, param)
                                ASTTmp.last = param
                            }

                            ASTTmp.type = JSParse__PeekType()
                            IfCondition EqualTo(ASTTmp.type, JSTokType.COMMA) ThenBlock: {
                                JSParse__Advance()
                            }
                        }
                    }
                    JSParse__Expect(JSTokType.RPAREN)

                    // Store param chain on func node
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.first)

                    // Parse function body: { ... }
                    JSParse__Expect(JSTokType.LBRACE)

                    AST__Push(ASTTmp.node)
                    ASTTmp.left = JSParse__Block()
                    ASTTmp.node = AST__Pop()

                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.left)

                    // Save func node idx into ASTTmp.idx (clobber-safe FixedPool field)
                    ASTTmp.idx = ASTTmp.node

                    // RESTORE outer obj state (5 pops, reverse of 5 pushes)
                    ASTTmp.done = AST__Pop()
                    ASTTmp.right = AST__Pop()
                    ASTTmp.last = AST__Pop()
                    ASTTmp.first = AST__Pop()
                    ASTTmp.node = AST__Pop()

                    prop = ASTTmp.right

                    // Set function value on property (ASTTmp.idx survived pops)
                    JSParse__NodeSet(prop, ASTConst.N_LEFT, ASTTmp.idx)
                }

                IfCondition EqualTo(ASTTmp.type, JSTokType.COLON) ThenBlock: {
                    // ── Regular property: key: value ──
                    JSParse__Advance()

                    // Save prop via ASTTmp.right so we can push it
                    ASTTmp.right = prop

                    // CLOBBER GUARD: push node, first, last, right(prop), done before recursive call
                    AST__Push(ASTTmp.node)
                    AST__Push(ASTTmp.first)
                    AST__Push(ASTTmp.last)
                    AST__Push(ASTTmp.right)
                    AST__Push(ASTTmp.done)

                    // Parse value expression (assignment level to avoid comma)
                    ASTTmp.left = JSParse__Assign()

                    // RESTORE
                    ASTTmp.done = AST__Pop()
                    ASTTmp.right = AST__Pop()
                    ASTTmp.last = AST__Pop()
                    ASTTmp.first = AST__Pop()
                    ASTTmp.node = AST__Pop()

                    // right held the prop index
                    prop = ASTTmp.right
                    JSParse__NodeSet(prop, ASTConst.N_LEFT, ASTTmp.left)
                }

                // ── Shorthand property: { x } → { x: x } ──
                // If neither colon nor lparen, and key was an ident, create
                // an IDENT node referencing the same name
                IfCondition And(And(NotEqual(ASTTmp.type, JSTokType.COLON), NotEqual(ASTTmp.type, JSTokType.LPAREN)),
                               EqualTo(key_is_ident, 1)) ThenBlock: {
                    ident_node = JSParse__AllocNode()
                    JSParse__NodeSet(ident_node, ASTConst.N_TYPE, ASTType.IDENT)
                    JSParse__NodeSet(ident_node, ASTConst.N_NAME_PTR, JSParse_GetNamePtr(prop))
                    JSParse__NodeSet(ident_node, ASTConst.N_NAME_LEN, JSParse_GetNameLen(prop))
                    JSParse__NodeSet(prop, ASTConst.N_LEFT, ident_node)
                }

                // Error: non-ident key without colon or lparen (e.g. {0} or {"x"})
                IfCondition And(And(NotEqual(ASTTmp.type, JSTokType.COLON), NotEqual(ASTTmp.type, JSTokType.LPAREN)),
                               EqualTo(key_is_ident, 0)) ThenBlock: {
                    ASTState.error = 1
                }

                // Link property into chain
                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = prop
                    ASTTmp.last = prop
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, prop)
                    ASTTmp.last = prop
                }

                // Optional comma between properties
                ASTTmp.type = JSParse__PeekType()
                IfCondition EqualTo(ASTTmp.type, JSTokType.COMMA) ThenBlock: {
                    JSParse__Advance()
                }
            }
        }

        JSParse__Expect(JSTokType.RBRACE)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.first)
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// Array literal — LBRACKET already consumed
// Parse elements linked via N_NEXT
// CLOBBER FIX: push node, first, last before JSParse__Assign()
// ---------------------------------------------------------------------------
Function.JSParse__ArrLit {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.ARRAY_LIT)
        ASTTmp.first = -1
        ASTTmp.last = -1

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RBRACKET) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // CLOBBER GUARD: push node, first, last, done before recursive call
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.done)

                // Parse element (assignment level, not full Expr to avoid comma confusion)
                elem = JSParse__Assign()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                // Link element into chain via N_NEXT
                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = elem
                    ASTTmp.last = elem
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, elem)
                    ASTTmp.last = elem
                }

                // Optional comma between elements
                ASTTmp.type = JSParse__PeekType()
                IfCondition EqualTo(ASTTmp.type, JSTokType.COMMA) ThenBlock: {
                    JSParse__Advance()
                }
            }
        }

        JSParse__Expect(JSTokType.RBRACKET)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.first)
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// Call arguments — LPAREN already consumed
// Parse args linked via N_NEXT, return CALL node
// CLOBBER FIX: push node, first, last, count before JSParse__Assign()
// ---------------------------------------------------------------------------
Function.JSParse__CallArgs {
    Input: callee: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Save callee to FixedPool immediately — register won't survive AllocNode call
        ASTTmp.left = callee

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.CALL)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
        ASTTmp.first = -1
        ASTTmp.last = -1
        ASTTmp.count = 0

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RPAREN) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // CLOBBER GUARD: push node, first, last, count, done before recursive call
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.count)
                AST__Push(ASTTmp.done)

                // Parse argument (assignment level)
                arg = JSParse__Assign()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.count = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                ASTTmp.count = Add(ASTTmp.count, 1)

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = arg
                    ASTTmp.last = arg
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, arg)
                    ASTTmp.last = arg
                }

                // Optional comma between arguments
                ASTTmp.type = JSParse__PeekType()
                IfCondition EqualTo(ASTTmp.type, JSTokType.COMMA) ThenBlock: {
                    JSParse__Advance()
                }
            }
        }

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.first)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, ASTTmp.count)
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// Function expression — 'function' [name] '(' params ')' block
// CLOBBER FIX: push node, first, last, count before AllocNode for params;
//              push node before JSParse__Block()
// ---------------------------------------------------------------------------
Function.JSParse__FuncExpr {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'function' keyword
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.FUNC_EXPR)

        // Optional name
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.IDENT) ThenBlock: {
            ASTTmp.idx = JSParse__Advance()
            ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
            ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, ASTTmp.name_len)
        }

        // Parameters
        JSParse__Expect(JSTokType.LPAREN)
        ASTTmp.first = -1
        ASTTmp.last = -1
        ASTTmp.count = 0

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RPAREN) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)

                // CLOBBER GUARD: push node, first, last, count before AllocNode for param
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.count)

                param = JSParse__AllocNode()

                // RESTORE
                ASTTmp.count = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                JSParse__NodeSet(param, ASTConst.N_TYPE, ASTType.IDENT)
                ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
                ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
                JSParse__NodeSet(param, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
                JSParse__NodeSet(param, ASTConst.N_NAME_LEN, ASTTmp.name_len)
                ASTTmp.count = Add(ASTTmp.count, 1)

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = param
                    ASTTmp.last = param
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, param)
                    ASTTmp.last = param
                }

                ASTTmp.type = JSParse__PeekType()
                IfCondition EqualTo(ASTTmp.type, JSTokType.COMMA) ThenBlock: {
                    JSParse__Advance()
                }
            }
        }

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.first)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, ASTTmp.count)

        // CLOBBER GUARD: push node before Block parse
        AST__Push(ASTTmp.node)

        // Body
        ASTTmp.body = JSParse__Block()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// Postfix — primary then loop: DOT, LBRACKET, LPAREN, ++, --
// CLOBBER FIX: push left before JSParse__Expr() (BRACKET) and CallArgs (CALL)
// ---------------------------------------------------------------------------
Function.JSParse__Postfix {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        ASTTmp.left = JSParse__Primary()

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()

            // --- DOT member access ---
            IfCondition EqualTo(ASTTmp.type, JSTokType.DOT) ThenBlock: {
                JSParse__Advance()
                ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)
                ASTTmp.node = JSParse__AllocNode()
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.MEMBER_DOT)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
                ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
                ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, ASTTmp.name_len)
                ASTTmp.left = ASTTmp.node
            }

            // --- BRACKET member access ---
            IfCondition EqualTo(ASTTmp.type, JSTokType.LBRACKET) ThenBlock: {
                JSParse__Advance()

                // CLOBBER GUARD: push left, done before Expr
                AST__Push(ASTTmp.left)
                AST__Push(ASTTmp.done)

                ASTTmp.right = JSParse__Expr()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.left = AST__Pop()

                JSParse__Expect(JSTokType.RBRACKET)
                ASTTmp.node = JSParse__AllocNode()
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.MEMBER_BRACKET)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.right)
                ASTTmp.left = ASTTmp.node
            }

            // --- CALL ---
            IfCondition EqualTo(ASTTmp.type, JSTokType.LPAREN) ThenBlock: {
                JSParse__Advance()
                // CLOBBER GUARD: push done before CallArgs
                AST__Push(ASTTmp.done)

                // CallArgs takes callee as argument and returns CALL node;
                // ASTTmp.left is passed by value (integer), so the callee
                // arg is safe. CallArgs will clobber ASTTmp.left internally
                // but we overwrite it with the result anyway.
                ASTTmp.left = JSParse__CallArgs(ASTTmp.left)

                // RESTORE
                ASTTmp.done = AST__Pop()
            }

            // --- POSTFIX ++ ---
            // [no LineTerminator here] per spec — if ++ is on a new line, it's
            // not postfix; stop the postfix loop and let it be parsed as prefix.
            IfCondition EqualTo(ASTTmp.type, JSTokType.PLUS_PLUS) ThenBlock: {
                prev_line = JSLex_GetLine(Subtract(ASTState.tok_pos, 1))
                curr_line = JSLex_GetLine(ASTState.tok_pos)
                IfCondition GreaterThan(curr_line, prev_line) ThenBlock: {
                    ASTTmp.done = 1
                } ElseBlock: {
                    // Truth table postfix target check
                    pv = JSValidate_IsPostfixTarget(JSParse_GetType(ASTTmp.left))
                    IfCondition EqualTo(pv, 0) ThenBlock: {
                        ASTState.error = 1
                        ReturnValue(-1)
                    }
                    JSParse__Advance()
                    ASTTmp.node = JSParse__AllocNode()
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.UPDATE_EXPR)
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, JSTokType.PLUS_PLUS)
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, 0)
                    ASTTmp.left = ASTTmp.node
                }
            }

            // --- POSTFIX -- ---
            IfCondition EqualTo(ASTTmp.type, JSTokType.MINUS_MINUS) ThenBlock: {
                prev_line = JSLex_GetLine(Subtract(ASTState.tok_pos, 1))
                curr_line = JSLex_GetLine(ASTState.tok_pos)
                IfCondition GreaterThan(curr_line, prev_line) ThenBlock: {
                    ASTTmp.done = 1
                } ElseBlock: {
                    // Truth table postfix target check
                    pv = JSValidate_IsPostfixTarget(JSParse_GetType(ASTTmp.left))
                    IfCondition EqualTo(pv, 0) ThenBlock: {
                        ASTState.error = 1
                        ReturnValue(-1)
                    }
                    JSParse__Advance()
                    ASTTmp.node = JSParse__AllocNode()
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.UPDATE_EXPR)
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, JSTokType.MINUS_MINUS)
                    JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, 0)
                    ASTTmp.left = ASTTmp.node
                }
            }

            // --- NONE OF THE ABOVE — stop postfix loop ---
            // Re-peek since branches above clobber ASTTmp.type via internal calls
            ASTTmp.type = JSParse__PeekType()
            IfCondition And(And(NotEqual(ASTTmp.type, JSTokType.DOT), NotEqual(ASTTmp.type, JSTokType.LBRACKET)),
                           And(And(NotEqual(ASTTmp.type, JSTokType.LPAREN), NotEqual(ASTTmp.type, JSTokType.PLUS_PLUS)),
                               NotEqual(ASTTmp.type, JSTokType.MINUS_MINUS))) ThenBlock: {
                ASTTmp.done = 1
            }
        }

        ReturnValue(ASTTmp.left)
    }
}

// ---------------------------------------------------------------------------
// Unary — prefix operators: -, !, ~, typeof, void, delete, ++, --, new
// NOTE: Unary is safe from clobber because each prefix case does:
//   ASTTmp.left = JSParse__Unary()   (return value in register -> stored)
//   ASTTmp.node = JSParse__AllocNode()  (AllocNode does NOT touch ASTTmp)
//   NodeSet(ASTTmp.node, ..., ASTTmp.left)  (both just read, no clobber)
//   ReturnValue(ASTTmp.node)
// The 'new' case needs a push for ASTTmp.left before CallArgs though.
// ---------------------------------------------------------------------------
Function.JSParse__Unary {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        ASTTmp.type = JSParse__PeekType()

        // --- PREFIX MINUS ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.MINUS) ThenBlock: {
            JSParse__Advance()
            ASTTmp.left = JSParse__Unary()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.UNARY_OP)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, JSTokType.MINUS)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            ReturnValue(ASTTmp.node)
        }

        // --- PREFIX PLUS (unary +, just evaluate operand) ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.PLUS) ThenBlock: {
            JSParse__Advance()
            ASTTmp.left = JSParse__Unary()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.UNARY_OP)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, JSTokType.PLUS)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            ReturnValue(ASTTmp.node)
        }

        // --- LOGICAL NOT ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.NOT) ThenBlock: {
            JSParse__Advance()
            ASTTmp.left = JSParse__Unary()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.UNARY_OP)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, JSTokType.NOT)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            ReturnValue(ASTTmp.node)
        }

        // --- BITWISE NOT ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.TILDE) ThenBlock: {
            JSParse__Advance()
            ASTTmp.left = JSParse__Unary()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.UNARY_OP)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, JSTokType.TILDE)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            ReturnValue(ASTTmp.node)
        }

        // --- TYPEOF ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_TYPEOF) ThenBlock: {
            JSParse__Advance()
            ASTTmp.left = JSParse__Unary()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.TYPEOF_EXPR)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            ReturnValue(ASTTmp.node)
        }

        // --- VOID ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_VOID) ThenBlock: {
            JSParse__Advance()
            ASTTmp.left = JSParse__Unary()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.UNARY_OP)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, JSTokType.KW_VOID)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            ReturnValue(ASTTmp.node)
        }

        // --- DELETE ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_DELETE) ThenBlock: {
            JSParse__Advance()
            ASTTmp.left = JSParse__Unary()
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.UNARY_OP)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, JSTokType.KW_DELETE)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            ReturnValue(ASTTmp.node)
        }

        // --- PREFIX ++ ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.PLUS_PLUS) ThenBlock: {
            JSParse__Advance()
            ASTTmp.left = JSParse__Unary()
            // Truth table prefix target check
            pv = JSValidate_IsPostfixTarget(JSParse_GetType(ASTTmp.left))
            IfCondition EqualTo(pv, 0) ThenBlock: {
                ASTState.error = 1
                ReturnValue(-1)
            }
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.UPDATE_EXPR)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, JSTokType.PLUS_PLUS)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, 1)
            ReturnValue(ASTTmp.node)
        }

        // --- PREFIX -- ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.MINUS_MINUS) ThenBlock: {
            JSParse__Advance()
            ASTTmp.left = JSParse__Unary()
            // Truth table prefix target check
            pv = JSValidate_IsPostfixTarget(JSParse_GetType(ASTTmp.left))
            IfCondition EqualTo(pv, 0) ThenBlock: {
                ASTState.error = 1
                ReturnValue(-1)
            }
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.UPDATE_EXPR)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, JSTokType.MINUS_MINUS)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, 1)
            ReturnValue(ASTTmp.node)
        }

        // --- NEW ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_NEW) ThenBlock: {
            JSParse__Advance()
            // Parse callee — use Postfix to handle member access chains (new Foo.Bar())
            // Postfix also consumes (args) as a CALL — we detect and convert to NEW_EXPR
            ASTTmp.left = JSParse__Postfix()

            // If Postfix already produced a CALL node (it consumed the args),
            // just convert it to NEW_EXPR — no double-call
            ASTTmp.type = JSParse_GetType(ASTTmp.left)
            IfCondition EqualTo(ASTTmp.type, ASTType.CALL) ThenBlock: {
                JSParse__NodeSet(ASTTmp.left, ASTConst.N_TYPE, ASTType.NEW_EXPR)
                ReturnValue(ASTTmp.left)
            }

            // Check for argument list (callee was not a call — e.g. new Foo.Bar())
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.LPAREN) ThenBlock: {
                JSParse__Advance()

                // CLOBBER GUARD: push left before CallArgs (it clobbers ASTTmp.left)
                AST__Push(ASTTmp.left)

                // Reuse CallArgs to parse arguments
                ASTTmp.node = JSParse__CallArgs(ASTTmp.left)

                // RESTORE (not used directly, but keeps stack balanced)
                AST__Pop()

                // Convert from CALL to NEW_EXPR
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.NEW_EXPR)
                ReturnValue(ASTTmp.node)
            }

            // new without parens: new Foo => 0 args
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.NEW_EXPR)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, 0)
            ReturnValue(ASTTmp.node)
        }

        // --- Not a unary prefix — delegate to postfix ---
        ReturnValue(JSParse__Postfix())
    }
}

// ---------------------------------------------------------------------------
// Pratt precedence climbing — binary operators
// CLOBBER FIX: push left and op before recursive JSParse__Precedence()
// ---------------------------------------------------------------------------
Function.JSParse__Precedence {
    Input: min_prec: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // CLOBBER GUARD: push min_prec before Unary — Primary clobbers ASTTmp.val
        // with parsed number values (e.g. ParseInt stores result in ASTTmp.val)
        AST__Push(min_prec)

        ASTTmp.left = JSParse__Unary()

        ASTTmp.val = AST__Pop()

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            ASTTmp.prec = JSParse__GetPrec(ASTTmp.type)

            IfCondition LessThan(ASTTmp.prec, ASTTmp.val) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.prec, 0) ThenBlock: {
                ASTTmp.done = 1
            }

            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                ASTTmp.op = ASTTmp.type
                JSParse__Advance()

                // CLOBBER GUARD: push left, op, min_prec, done before recursive Precedence
                AST__Push(ASTTmp.left)
                AST__Push(ASTTmp.op)
                AST__Push(ASTTmp.val)
                AST__Push(ASTTmp.done)

                // Right side: parse with prec+1 for left-associativity
                ASTTmp.right = JSParse__Precedence(Add(ASTTmp.prec, 1))

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.val = AST__Pop()
                ASTTmp.op = AST__Pop()
                ASTTmp.left = AST__Pop()

                ASTTmp.node = JSParse__AllocNode()
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.BINARY_OP)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, ASTTmp.op)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.right)
                ASTTmp.left = ASTTmp.node
            }
        }

        ReturnValue(ASTTmp.left)
    }
}

// ---------------------------------------------------------------------------
// Ternary — parse LogicalOr (via Precedence(1)), then check for ?
// CLOBBER FIX: push left (condition) before JSParse__Assign() for consequent;
//              push cond and left before JSParse__Assign() for alternate
// ---------------------------------------------------------------------------
Function.JSParse__Ternary {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        ASTTmp.left = JSParse__Precedence(1)

        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.QUESTION) ThenBlock: {
            JSParse__Advance()
            // Save condition
            ASTTmp.cond = ASTTmp.left

            // CLOBBER GUARD: push cond before Assign (consequent)
            AST__Push(ASTTmp.cond)

            // Consequent (assignment level for nested ternaries)
            ASTTmp.left = JSParse__Assign()

            // RESTORE cond
            ASTTmp.cond = AST__Pop()

            JSParse__Expect(JSTokType.COLON)

            // CLOBBER GUARD: push cond and left before Assign (alternate)
            AST__Push(ASTTmp.cond)
            AST__Push(ASTTmp.left)

            ASTTmp.right = JSParse__Assign()

            // RESTORE
            ASTTmp.left = AST__Pop()
            ASTTmp.cond = AST__Pop()

            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.TERNARY)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.right)
            ReturnValue(ASTTmp.node)
        }

        ReturnValue(ASTTmp.left)
    }
}

// ---------------------------------------------------------------------------
// Assign — parse Ternary, then check for assignment ops (right-associative)
// CLOBBER FIX: push left and op before recursive JSParse__Assign()
// ---------------------------------------------------------------------------
Function.JSParse__Assign {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        ASTTmp.left = JSParse__Ternary()

        ASTTmp.type = JSParse__PeekType()
        ASTTmp.val = JSParse__IsAssignOp(ASTTmp.type)
        IfCondition EqualTo(ASTTmp.val, 1) ThenBlock: {
            // Truth table lvalue check — reject invalid assignment targets
            lv = JSValidate_IsLValue(JSParse_GetType(ASTTmp.left))
            IfCondition EqualTo(lv, 0) ThenBlock: {
                ASTState.error = 1
                ReturnValue(-1)
            }
            ASTTmp.op = ASTTmp.type
            JSParse__Advance()

            // CLOBBER GUARD: push left and op before recursive Assign
            AST__Push(ASTTmp.left)
            AST__Push(ASTTmp.op)

            // Right-associative: recurse into Assign
            ASTTmp.right = JSParse__Assign()

            // RESTORE
            ASTTmp.op = AST__Pop()
            ASTTmp.left = AST__Pop()

            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.ASSIGN)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, ASTTmp.op)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.right)
            ReturnValue(ASTTmp.node)
        }

        ReturnValue(ASTTmp.left)
    }
}

// ---------------------------------------------------------------------------
// Expression entry point — currently same as Assign (no comma operator)
// ---------------------------------------------------------------------------
Function.JSParse__Expr {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        ASTTmp.left = JSParse__Assign()

        // Comma operator: expr , expr — evaluates both, returns last
        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.COMMA) ThenBlock: {
                JSParse__Advance()

                // CLOBBER GUARD: push left before recursive Assign
                AST__Push(ASTTmp.left)

                ASTTmp.right = JSParse__Assign()

                // RESTORE
                ASTTmp.left = AST__Pop()

                ASTTmp.node = JSParse__AllocNode()
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.BINARY_OP)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, JSTokType.COMMA)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
                JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.right)
                ASTTmp.left = ASTTmp.node
            } ElseBlock: {
                ASTTmp.done = 1
            }
        }

        ReturnValue(ASTTmp.left)
    }
}

// =============================================================================
// STATEMENT PARSING — recursive descent
// =============================================================================

// ---------------------------------------------------------------------------
// Block — { statement* }
// CLOBBER FIX: push node, first, last before JSParse__Statement()
// ---------------------------------------------------------------------------
Function.JSParse__Block {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        JSParse__Expect(JSTokType.LBRACE)
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.BLOCK)
        ASTTmp.first = -1
        ASTTmp.last = -1

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RBRACE) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // CLOBBER GUARD: push node, first, last, done before Statement
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.done)

                stmt = JSParse__Statement()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = stmt
                    ASTTmp.last = stmt
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, stmt)
                    ASTTmp.last = stmt
                }

                // Walk to end of multi-var chain (var x=1, y=2 creates linked VAR_DECLs)
                ASTTmp.idx = JSParse_GetNext(ASTTmp.last)
                WhileLoop GreaterEqual(ASTTmp.idx, 0) {
                    ASTTmp.last = ASTTmp.idx
                    ASTTmp.idx = JSParse_GetNext(ASTTmp.last)
                }
            }
        }

        JSParse__Expect(JSTokType.RBRACE)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.first)
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// VarDecl — var/let/const IDENT [= expr] ;
// When called from ForStmt with skip_semi=1, does not consume trailing SEMI
// CLOBBER FIX: push node before JSParse__Expr()
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// VarDeclSingle — parse one declarator: IDENT (= expr)?
// Used by VarDecl for comma-separated multi-var: var x=1, y=2;
// kw_type: the var/let/const keyword type, skip_semi: 1 to skip trailing ;
// Chains additional declarators via N_NEXT on COMMA.
// ---------------------------------------------------------------------------
Function.JSParse__VarDeclSingle {
    Input: kw_type: Integer
    Input: skip_semi: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Save inputs to FixedPool — registers won't survive calls
        ASTTmp.op = kw_type
        ASTTmp.done = skip_semi

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.VAR_DECL)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_OP, ASTTmp.op)

        // Expect identifier name
        ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)
        ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
        ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, ASTTmp.name_len)

        // Optional initializer
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.ASSIGN) ThenBlock: {
            JSParse__Advance()

            // CLOBBER GUARD: push node, op, skip_semi before Assign
            // NOTE: use Assign, not Expr — Expr consumes comma operator,
            // but var initializer commas separate declarators
            AST__Push(ASTTmp.node)
            AST__Push(ASTTmp.op)
            AST__Push(ASTTmp.done)

            ASTTmp.left = JSParse__Assign()

            // RESTORE
            ASTTmp.done = AST__Pop()
            ASTTmp.op = AST__Pop()
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
        }

        // Multi-variable: check for COMMA -> chain another declarator
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.COMMA) ThenBlock: {
            JSParse__Advance()

            // CLOBBER GUARD: push node, done before recursive call
            AST__Push(ASTTmp.node)
            AST__Push(ASTTmp.done)

            ASTTmp.left = JSParse__VarDeclSingle(ASTTmp.op, ASTTmp.done)

            // RESTORE
            ASTTmp.done = AST__Pop()
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NEXT, ASTTmp.left)
            ReturnValue(ASTTmp.node)
        }

        // Consume semicolon unless skip_semi is set (for-loop init)
        IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
            JSParse__Expect(JSTokType.SEMI)
        }

        ReturnValue(ASTTmp.node)
    }
}

Function.JSParse__VarDecl {
    Input: skip_semi: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume var/let/const keyword and save its type
        ASTTmp.op = JSParse__PeekType()
        JSParse__Advance()

        // Delegate to VarDeclSingle for the first (and possibly only) declarator
        ReturnValue(JSParse__VarDeclSingle(ASTTmp.op, skip_semi))
    }
}

// ---------------------------------------------------------------------------
// FuncDecl — function IDENT ( params ) block
// CLOBBER FIX: push node, first, last, count before AllocNode for params;
//              push node before JSParse__Block()
// ---------------------------------------------------------------------------
Function.JSParse__FuncDecl {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'function' keyword
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.FUNC_DECL)

        // Function name (required for declarations)
        ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)
        ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
        ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, ASTTmp.name_len)

        // Parameters
        JSParse__Expect(JSTokType.LPAREN)
        ASTTmp.first = -1
        ASTTmp.last = -1
        ASTTmp.count = 0

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RPAREN) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                ASTTmp.idx = JSParse__Expect(JSTokType.IDENT)

                // CLOBBER GUARD: push node, first, last, count before AllocNode for param
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.count)

                param = JSParse__AllocNode()

                // RESTORE
                ASTTmp.count = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                JSParse__NodeSet(param, ASTConst.N_TYPE, ASTType.IDENT)
                ASTTmp.name_ptr = JSLex_GetPtr(ASTTmp.idx)
                ASTTmp.name_len = JSLex_GetLen(ASTTmp.idx)
                JSParse__NodeSet(param, ASTConst.N_NAME_PTR, ASTTmp.name_ptr)
                JSParse__NodeSet(param, ASTConst.N_NAME_LEN, ASTTmp.name_len)
                ASTTmp.count = Add(ASTTmp.count, 1)

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = param
                    ASTTmp.last = param
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, param)
                    ASTTmp.last = param
                }

                ASTTmp.type = JSParse__PeekType()
                IfCondition EqualTo(ASTTmp.type, JSTokType.COMMA) ThenBlock: {
                    JSParse__Advance()
                }
            }
        }

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.first)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_VALUE, ASTTmp.count)

        // CLOBBER GUARD: push node before Block parse
        AST__Push(ASTTmp.node)

        // Body
        ASTTmp.body = JSParse__Block()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// ReturnStmt — return [expr] ;
// CLOBBER FIX: push node before JSParse__Expr()
// ---------------------------------------------------------------------------
Function.JSParse__ReturnStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'return'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.RETURN_STMT)

        // Check if there's an expression before SEMI or RBRACE
        ASTTmp.type = JSParse__PeekType()
        IfCondition And(NotEqual(ASTTmp.type, JSTokType.SEMI), NotEqual(ASTTmp.type, JSTokType.RBRACE)) ThenBlock: {
            IfCondition NotEqual(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                // CLOBBER GUARD: push node before Expr
                AST__Push(ASTTmp.node)

                ASTTmp.left = JSParse__Expr()

                // RESTORE
                ASTTmp.node = AST__Pop()

                JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            }
        }

        // Consume semicolon (optional — tolerate missing for robustness)
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
        }

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// IfStmt — if ( cond ) body [else body]
// CLOBBER FIX: push node before Expr (cond), Statement (body), Statement (else)
// ---------------------------------------------------------------------------
Function.JSParse__IfStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'if'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.IF_STMT)

        // Condition
        JSParse__Expect(JSTokType.LPAREN)

        // CLOBBER GUARD: push node before Expr (condition)
        AST__Push(ASTTmp.node)

        ASTTmp.cond = JSParse__Expr()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)

        // CLOBBER GUARD: push node before Statement (consequent body)
        AST__Push(ASTTmp.node)

        // Consequent body
        ASTTmp.body = JSParse__Statement()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        // Optional else
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_ELSE) ThenBlock: {
            JSParse__Advance()

            // CLOBBER GUARD: push node before Statement (else body)
            AST__Push(ASTTmp.node)

            ASTTmp.right = JSParse__Statement()

            // RESTORE
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.right)
        }

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// WhileStmt — while ( cond ) body
// CLOBBER FIX: push node before Expr (cond) and Statement (body)
// ---------------------------------------------------------------------------
Function.JSParse__WhileStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'while'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.WHILE_STMT)

        JSParse__Expect(JSTokType.LPAREN)

        // CLOBBER GUARD: push node before Expr (condition)
        AST__Push(ASTTmp.node)

        ASTTmp.cond = JSParse__Expr()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)

        // CLOBBER GUARD: push node before Statement (body)
        AST__Push(ASTTmp.node)

        ASTTmp.body = JSParse__Statement()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// ForStmt — for ( init ; cond ; update ) body
// init can be: var/let/const decl, expression, or empty (bare ;)
// CLOBBER FIX: push node before each VarDecl/Expr/Statement call
// ---------------------------------------------------------------------------
Function.JSParse__ForStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'for'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.FOR_STMT)

        JSParse__Expect(JSTokType.LPAREN)

        // --- INIT clause ---
        ASTTmp.type = JSParse__PeekType()

        // Empty init: bare semicolon
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
            // left stays -1 (already initialized by AllocNode)
        }

        // Var decl init: var/let/const
        IfCondition Or(EqualTo(ASTTmp.type, JSTokType.KW_VAR),
                      Or(EqualTo(ASTTmp.type, JSTokType.KW_LET), EqualTo(ASTTmp.type, JSTokType.KW_CONST))) ThenBlock: {
            // CLOBBER GUARD: push node before VarDecl
            AST__Push(ASTTmp.node)

            // Parse var decl without trailing semi (skip_semi=1)
            ASTTmp.left = JSParse__VarDecl(1)

            // RESTORE
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            JSParse__Expect(JSTokType.SEMI)
        }

        // Expression init: anything else (not SEMI and not var/let/const)
        IfCondition And(NotEqual(ASTTmp.type, JSTokType.SEMI),
                       And(NotEqual(ASTTmp.type, JSTokType.KW_VAR),
                           And(NotEqual(ASTTmp.type, JSTokType.KW_LET), NotEqual(ASTTmp.type, JSTokType.KW_CONST)))) ThenBlock: {
            // CLOBBER GUARD: push node before Expr
            AST__Push(ASTTmp.node)

            ASTTmp.left = JSParse__Expr()

            // RESTORE
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            JSParse__Expect(JSTokType.SEMI)
        }

        // --- CONDITION clause ---
        ASTTmp.type = JSParse__PeekType()
        IfCondition NotEqual(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            // CLOBBER GUARD: push node before Expr (condition)
            AST__Push(ASTTmp.node)

            ASTTmp.cond = JSParse__Expr()

            // RESTORE
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)
        }
        JSParse__Expect(JSTokType.SEMI)

        // --- UPDATE clause ---
        ASTTmp.type = JSParse__PeekType()
        IfCondition NotEqual(ASTTmp.type, JSTokType.RPAREN) ThenBlock: {
            // CLOBBER GUARD: push node before Expr (update)
            AST__Push(ASTTmp.node)

            ASTTmp.right = JSParse__Expr()

            // RESTORE
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, ASTTmp.right)
        }
        JSParse__Expect(JSTokType.RPAREN)

        // --- BODY ---
        // CLOBBER GUARD: push node before Statement (body)
        AST__Push(ASTTmp.node)

        ASTTmp.body = JSParse__Statement()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// DoWhile — do body while ( cond ) ;
// CLOBBER FIX: push node before Statement (body) and Expr (cond)
// ---------------------------------------------------------------------------
Function.JSParse__DoWhile {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'do'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.DO_WHILE)

        // CLOBBER GUARD: push node before Statement (body)
        AST__Push(ASTTmp.node)

        // Body
        ASTTmp.body = JSParse__Statement()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.body)

        // Expect 'while'
        JSParse__Expect(JSTokType.KW_WHILE)

        // Condition
        JSParse__Expect(JSTokType.LPAREN)

        // CLOBBER GUARD: push node before Expr (condition)
        AST__Push(ASTTmp.node)

        ASTTmp.cond = JSParse__Expr()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_COND, ASTTmp.cond)

        // Semicolon
        JSParse__Expect(JSTokType.SEMI)

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// SwitchStmt — switch ( expr ) { case/default clauses }
// CLOBBER FIX: push node, first, last before Expr and CaseClause calls
// ---------------------------------------------------------------------------
Function.JSParse__SwitchStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Consume 'switch'
        JSParse__Advance()

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.SWITCH_STMT)

        // Discriminant
        JSParse__Expect(JSTokType.LPAREN)

        // CLOBBER GUARD: push node before Expr (discriminant)
        AST__Push(ASTTmp.node)

        ASTTmp.left = JSParse__Expr()

        // RESTORE
        ASTTmp.node = AST__Pop()

        JSParse__Expect(JSTokType.RPAREN)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)

        // Case clauses
        JSParse__Expect(JSTokType.LBRACE)
        ASTTmp.first = -1
        ASTTmp.last = -1

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.RBRACE) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // CLOBBER GUARD: push node, first, last, done before CaseClause
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.done)

                clause = JSParse__CaseClause()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = clause
                    ASTTmp.last = clause
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, clause)
                    ASTTmp.last = clause
                }
            }
        }

        JSParse__Expect(JSTokType.RBRACE)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.first)

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// CaseClause — case expr : stmts  |  default : stmts
// Statements run until next case/default/}
// CLOBBER FIX: push node, first, last before Expr and Statement calls
// ---------------------------------------------------------------------------
Function.JSParse__CaseClause {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.CASE_CLAUSE)

        ASTTmp.type = JSParse__PeekType()

        // --- case expr : ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_CASE) ThenBlock: {
            JSParse__Advance()

            // CLOBBER GUARD: push node before Expr (case test)
            AST__Push(ASTTmp.node)

            ASTTmp.left = JSParse__Expr()

            // RESTORE
            ASTTmp.node = AST__Pop()

            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)
            JSParse__Expect(JSTokType.COLON)
        } ElseBlock: {
            // --- default : ---
            IfCondition EqualTo(ASTTmp.type, JSTokType.KW_DEFAULT) ThenBlock: {
                JSParse__Advance()
                // left stays -1 (signals default clause)
                JSParse__Expect(JSTokType.COLON)
            } ElseBlock: {
                // Neither case nor default — error
                ASTState.error = 1
                ReturnValue(-1)
            }
        }

        // Parse body statements until case/default/}
        ASTTmp.first = -1
        ASTTmp.last = -1
        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.KW_CASE) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.KW_DEFAULT) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.RBRACE) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // CLOBBER GUARD: push node, first, last, done before Statement
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.done)

                stmt = JSParse__Statement()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = stmt
                    ASTTmp.last = stmt
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, stmt)
                    ASTTmp.last = stmt
                }
            }
        }

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.first)
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// BreakStmt — break [label] ;
// If a label follows, consume it (treated as break from nearest loop for now)
// ---------------------------------------------------------------------------
Function.JSParse__BreakStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        JSParse__Advance()
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.BREAK_STMT)
        // Consume optional label identifier
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.IDENT) ThenBlock: {
            JSParse__Advance()
        }
        // Consume optional semicolon
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
        }
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// ContStmt — continue [label] ;
// If a label follows, consume it (treated as continue of nearest loop for now)
// ---------------------------------------------------------------------------
Function.JSParse__ContStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        JSParse__Advance()
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.CONTINUE_STMT)
        // Consume optional label identifier
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.IDENT) ThenBlock: {
            JSParse__Advance()
        }
        // Consume optional semicolon
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
        }
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// ThrowStmt — throw expr ;
// ---------------------------------------------------------------------------
Function.JSParse__ThrowStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        JSParse__Advance()
        expr = JSParse__Expr()
        // Save expr across AllocNode (clobber protection)
        AST__Push(expr)
        ASTTmp.node = JSParse__AllocNode()
        expr = AST__Pop()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.THROW_STMT)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, expr)
        // Consume optional semicolon
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
        }
        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// TryStmt — try { body } catch (ident) { handler } [finally { finbody }]
// ---------------------------------------------------------------------------
Function.JSParse__TryStmt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }
        // Consume 'try'
        JSParse__Advance()

        // Parse try body block
        try_body = JSParse__Block()

        // Save try_body across AllocNode
        AST__Push(try_body)
        ASTTmp.node = JSParse__AllocNode()
        try_body = AST__Pop()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.TRY_STMT)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, try_body)

        // Parse optional catch clause
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_CATCH) ThenBlock: {
            JSParse__Advance()
            // Expect '(' ident ')'
            AST__Push(ASTTmp.node)
            JSParse__Expect(JSTokType.LPAREN)
            ASTTmp.node = AST__Pop()

            // Get catch variable name
            cv_idx = JSParse__Advance()
            cv_ptr = JSLex_GetPtr(cv_idx)
            cv_len = JSLex_GetLen(cv_idx)

            // Save node, cv_ptr, cv_len across Expect and Block calls
            AST__Push(ASTTmp.node)
            AST__Push(cv_ptr)
            AST__Push(cv_len)
            JSParse__Expect(JSTokType.RPAREN)

            // Parse catch body block
            catch_body = JSParse__Block()
            cv_len = AST__Pop()
            cv_ptr = AST__Pop()
            ASTTmp.node = AST__Pop()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, catch_body)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_PTR, cv_ptr)
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_NAME_LEN, cv_len)
        }

        // Parse optional finally clause
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_FINALLY) ThenBlock: {
            JSParse__Advance()
            AST__Push(ASTTmp.node)
            fin_body = JSParse__Block()
            ASTTmp.node = AST__Pop()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_RIGHT, fin_body)
        }

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// Statement — dispatch on current token type
// ---------------------------------------------------------------------------
Function.JSParse__Statement {
    Output: Integer
    Body: {
        IfCondition EqualTo(ASTState.error, 1) ThenBlock: { ReturnValue(-1) }

        ASTTmp.type = JSParse__PeekType()

        // --- var / let / const ---
        IfCondition Or(EqualTo(ASTTmp.type, JSTokType.KW_VAR),
                      Or(EqualTo(ASTTmp.type, JSTokType.KW_LET), EqualTo(ASTTmp.type, JSTokType.KW_CONST))) ThenBlock: {
            ReturnValue(JSParse__VarDecl(0))
        }

        // --- function ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_FUNCTION) ThenBlock: {
            ReturnValue(JSParse__FuncDecl())
        }

        // --- return ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_RETURN) ThenBlock: {
            ReturnValue(JSParse__ReturnStmt())
        }

        // --- if ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_IF) ThenBlock: {
            ReturnValue(JSParse__IfStmt())
        }

        // --- while ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_WHILE) ThenBlock: {
            ReturnValue(JSParse__WhileStmt())
        }

        // --- for ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_FOR) ThenBlock: {
            ReturnValue(JSParse__ForStmt())
        }

        // --- do ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_DO) ThenBlock: {
            ReturnValue(JSParse__DoWhile())
        }

        // --- switch ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_SWITCH) ThenBlock: {
            ReturnValue(JSParse__SwitchStmt())
        }

        // --- try ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_TRY) ThenBlock: {
            ReturnValue(JSParse__TryStmt())
        }

        // --- throw ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_THROW) ThenBlock: {
            ReturnValue(JSParse__ThrowStmt())
        }

        // --- break ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_BREAK) ThenBlock: {
            ReturnValue(JSParse__BreakStmt())
        }

        // --- continue ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.KW_CONTINUE) ThenBlock: {
            ReturnValue(JSParse__ContStmt())
        }

        // --- block ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.LBRACE) ThenBlock: {
            ReturnValue(JSParse__Block())
        }

        // --- empty statement (bare semicolon) ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
            // Allocate an empty BLOCK node for empty statements
            ASTTmp.node = JSParse__AllocNode()
            JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.BLOCK)
            ReturnValue(ASTTmp.node)
        }

        // --- labeled statement (IDENT COLON — skip label, parse inner statement) ---
        IfCondition EqualTo(ASTTmp.type, JSTokType.IDENT) ThenBlock: {
            // Peek at the token after the identifier
            next_pos = Add(ASTState.tok_pos, 1)
            IfCondition LessThan(next_pos, ASTState.tok_total) ThenBlock: {
                next_type = JSLex_GetType(next_pos)
                IfCondition EqualTo(next_type, JSTokType.COLON) ThenBlock: {
                    // Skip IDENT and COLON tokens
                    JSParse__Advance()
                    JSParse__Advance()
                    // Recurse: parse the labeled statement body
                    ReturnValue(JSParse__Statement())
                }
            }
        }

        // --- expression statement ---
        ASTTmp.left = JSParse__Expr()
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.EXPR_STMT)
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_LEFT, ASTTmp.left)

        // Consume semicolon (tolerate missing for robustness)
        ASTTmp.type = JSParse__PeekType()
        IfCondition EqualTo(ASTTmp.type, JSTokType.SEMI) ThenBlock: {
            JSParse__Advance()
        }

        ReturnValue(ASTTmp.node)
    }
}

// ---------------------------------------------------------------------------
// Program — top-level: parse statements until EOF, link via N_NEXT
// CLOBBER FIX: push node, first, last before JSParse__Statement()
// ---------------------------------------------------------------------------
Function.JSParse__Program {
    Output: Integer
    Body: {
        ASTTmp.node = JSParse__AllocNode()
        JSParse__NodeSet(ASTTmp.node, ASTConst.N_TYPE, ASTType.PROGRAM)
        ASTTmp.first = -1
        ASTTmp.last = -1

        ASTTmp.done = 0
        WhileLoop And(EqualTo(ASTTmp.done, 0), EqualTo(ASTState.error, 0)) {
            ASTTmp.type = JSParse__PeekType()
            IfCondition EqualTo(ASTTmp.type, JSTokType.EOF) ThenBlock: {
                ASTTmp.done = 1
            }
            IfCondition EqualTo(ASTTmp.done, 0) ThenBlock: {
                // CLOBBER GUARD: push node, first, last, done before Statement
                AST__Push(ASTTmp.node)
                AST__Push(ASTTmp.first)
                AST__Push(ASTTmp.last)
                AST__Push(ASTTmp.done)

                stmt = JSParse__Statement()

                // RESTORE
                ASTTmp.done = AST__Pop()
                ASTTmp.last = AST__Pop()
                ASTTmp.first = AST__Pop()
                ASTTmp.node = AST__Pop()

                IfCondition EqualTo(ASTTmp.first, -1) ThenBlock: {
                    ASTTmp.first = stmt
                    ASTTmp.last = stmt
                } ElseBlock: {
                    JSParse__NodeSet(ASTTmp.last, ASTConst.N_NEXT, stmt)
                    ASTTmp.last = stmt
                }

                // Walk to end of multi-var chain (var x=1, y=2 creates linked VAR_DECLs)
                ASTTmp.idx = JSParse_GetNext(ASTTmp.last)
                WhileLoop GreaterEqual(ASTTmp.idx, 0) {
                    ASTTmp.last = ASTTmp.idx
                    ASTTmp.idx = JSParse_GetNext(ASTTmp.last)
                }
            }
        }

        JSParse__NodeSet(ASTTmp.node, ASTConst.N_BODY, ASTTmp.first)
        ReturnValue(ASTTmp.node)
    }
}

// =============================================================================
// PUBLIC API
// =============================================================================

// ---------------------------------------------------------------------------
// Parse — tokenized stream -> AST. Returns root node index.
// ---------------------------------------------------------------------------
Function.JSParse_Parse {
    Output: Integer
    Body: {
        ASTState.tok_pos = 0
        ASTState.tok_total = JSLex_Count()
        ASTState.node_count = 0
        ASTState.error = 0
        ASTState.err_msg = 0
        ASTStack.sp = 0
        ReturnValue(JSParse__Program())
    }
}

// ---------------------------------------------------------------------------
// Node field accessors
// ---------------------------------------------------------------------------
Function.JSParse_GetType {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(JSParse__NodeGet(idx, ASTConst.N_TYPE)) }
}

Function.JSParse_GetOp {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(JSParse__NodeGet(idx, ASTConst.N_OP)) }
}

Function.JSParse_GetLeft {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(JSParse__NodeGet(idx, ASTConst.N_LEFT)) }
}

Function.JSParse_GetRight {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(JSParse__NodeGet(idx, ASTConst.N_RIGHT)) }
}

Function.JSParse_GetCond {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(JSParse__NodeGet(idx, ASTConst.N_COND)) }
}

Function.JSParse_GetBody {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(JSParse__NodeGet(idx, ASTConst.N_BODY)) }
}

Function.JSParse_GetNamePtr {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(JSParse__NodeGet(idx, ASTConst.N_NAME_PTR)) }
}

Function.JSParse_GetNameLen {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(JSParse__NodeGet(idx, ASTConst.N_NAME_LEN)) }
}

Function.JSParse_GetValue {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(JSParse__NodeGet(idx, ASTConst.N_VALUE)) }
}

Function.JSParse_GetNext {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(JSParse__NodeGet(idx, ASTConst.N_NEXT)) }
}

Function.JSParse_NodeCount {
    Output: Integer
    Body: { ReturnValue(ASTState.node_count) }
}

Function.JSParse_HasError {
    Output: Integer
    Body: { ReturnValue(ASTState.error) }
}
