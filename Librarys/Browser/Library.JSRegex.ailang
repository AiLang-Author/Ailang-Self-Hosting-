// Library.JSRegex.ailang — JavaScript RegExp Engine
// Forked from Library.Regex_Thompson.ailang for JS engine use.
// Thompson NFA-based regex with lazy DFA optimization.
//
// All symbols renamed to JSRx* / JSRegex* namespace to avoid collisions
// with the base regex library. Will be extended with JS-specific semantics:
// capture groups, lastIndex, global/sticky flags, String.prototype.match, etc.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena

// ============================================================================
// CONFIGURATION AND CONSTANTS
// ============================================================================

FixedPool.JSRxFlags {
    "CASE_INSENSITIVE": Initialize=1
    "MULTILINE": Initialize=2
    "DOTALL": Initialize=4
    "VERBOSE": Initialize=8
    "UNICODE": Initialize=16
    "GLOBAL": Initialize=32
    "STICKY": Initialize=64
}

FixedPool.JSRxConstants {
    "MAX_STATES": Initialize=4096
    "MAX_CAPTURES": Initialize=32
    "MAX_THREADS": Initialize=1024
    "CACHE_SIZE": Initialize=256
    "STATE_SIZE": Initialize=40
}

FixedPool.JSRxStateType {
    "CHAR": Initialize=0
    "RANGE": Initialize=1
    "DOT": Initialize=2
    "SPLIT": Initialize=3
    "MATCH": Initialize=4
    "SAVE": Initialize=5
    "EMPTY": Initialize=6
    "ASSERT_START": Initialize=7
    "ASSERT_END": Initialize=8
    "WORD_BOUNDARY": Initialize=9
    "NOT_WORD_BOUNDARY": Initialize=10
    "LOOKAHEAD": Initialize=11
    "LOOKBEHIND": Initialize=12
    "BACKREF": Initialize=13
}

// ============================================================================
// CORE DATA STRUCTURES
// ============================================================================

FixedPool.JSRxState {
    "states": Initialize=0
    "num_states": Initialize=0
    "start_state": Initialize=0
    "capture_count": Initialize=0
}

FixedPool.JSRxCompiler {
    "pattern": Initialize=0
    "pos": Initialize=0
    "len": Initialize=0
    "group_count": Initialize=0
    "flags": Initialize=0
    "error": Initialize=0
}

FixedPool.JSRxMatch {
    "text": Initialize=0
    "text_len": Initialize=0
    "pos": Initialize=0
    "threads": Initialize=0
    "next_threads": Initialize=0
    "thread_count": Initialize=0
    "next_count": Initialize=0
    "captures": Initialize=0
    "thread_size": Initialize=0
    "flags": Initialize=0
}

// Ring-buffer slot pools for parser AST nodes
FixedPool.JSRxFragPool {
    "buf":  Initialize=0, CanChange=True
    "head": Initialize=0, CanChange=True
    "cap":  Initialize=65536
}
FixedPool.JSRxListPool {
    "buf":  Initialize=0, CanChange=True
    "head": Initialize=0, CanChange=True
    "cap":  Initialize=65536
}
FixedPool.JSRxClassPool {
    "buf":  Initialize=0, CanChange=True
    "head": Initialize=0, CanChange=True
    "cap":  Initialize=4096
}

// ============================================================================
// INITIALIZATION
// ============================================================================

SubRoutine.JSRegex_Initialize {
    JSRxState.states = 0
    JSRxState.num_states = 0
    JSRxState.start_state = 0
    JSRxState.capture_count = 0

    JSRxCompiler.pattern = 0
    JSRxCompiler.pos = 0
    JSRxCompiler.len = 0
    JSRxCompiler.group_count = 0
    JSRxCompiler.flags = 0
    JSRxCompiler.error = 0

    JSRxMatch.text = 0
    JSRxMatch.text_len = 0
    JSRxMatch.pos = 0
    JSRxMatch.threads = 0
    JSRxMatch.next_threads = 0
    JSRxMatch.thread_count = 0
    JSRxMatch.next_count = 0
    JSRxMatch.captures = 0
    JSRxMatch.thread_size = 0
}

// ============================================================================
// POOL ALLOCATORS
// ============================================================================

Function.JSRx_FragAlloc {
    Output: Address
    Body: {
        IfCondition EqualTo(JSRxFragPool.buf, 0) ThenBlock: {
            JSRxFragPool.buf = Allocate(Multiply(JSRxFragPool.cap, 16))
            IfCondition EqualTo(JSRxFragPool.buf, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(JSRxFragPool.head, JSRxFragPool.cap) ThenBlock: {
            ReturnValue(0)
        }
        slot = Add(JSRxFragPool.buf, Multiply(JSRxFragPool.head, 16))
        JSRxFragPool.head = Add(JSRxFragPool.head, 1)
        ReturnValue(slot)
    }
}

Function.JSRx_ListAlloc {
    Output: Address
    Body: {
        IfCondition EqualTo(JSRxListPool.buf, 0) ThenBlock: {
            JSRxListPool.buf = Allocate(Multiply(JSRxListPool.cap, 24))
            IfCondition EqualTo(JSRxListPool.buf, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(JSRxListPool.head, JSRxListPool.cap) ThenBlock: {
            ReturnValue(0)
        }
        slot = Add(JSRxListPool.buf, Multiply(JSRxListPool.head, 24))
        JSRxListPool.head = Add(JSRxListPool.head, 1)
        ReturnValue(slot)
    }
}

Function.JSRx_ClassAlloc {
    Output: Address
    Body: {
        IfCondition EqualTo(JSRxClassPool.buf, 0) ThenBlock: {
            JSRxClassPool.buf = Allocate(Multiply(JSRxClassPool.cap, 32))
            IfCondition EqualTo(JSRxClassPool.buf, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(JSRxClassPool.head, JSRxClassPool.cap) ThenBlock: {
            ReturnValue(0)
        }
        slot = Add(JSRxClassPool.buf, Multiply(JSRxClassPool.head, 32))
        JSRxClassPool.head = Add(JSRxClassPool.head, 1)
        ReturnValue(slot)
    }
}

// ============================================================================
// PUBLIC API
// ============================================================================

Function.JSRegex_Compile {
    Input: pattern: Address
    Input: flags: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(pattern, 0) ThenBlock: {
            ReturnValue(0)
        }

        JSRxCompiler.pattern = pattern
        JSRxCompiler.pos = 0
        JSRxCompiler.len = StringLength(pattern)
        JSRxCompiler.group_count = 0
        JSRxCompiler.flags = flags
        JSRxCompiler.error = 0

        total_size = Multiply(JSRxConstants.MAX_STATES, JSRxConstants.STATE_SIZE)

        JSRxState.states = Allocate(total_size)
        IfCondition EqualTo(JSRxState.states, 0) ThenBlock: {
            ReturnValue(0)
        }

        JSRxState.num_states = 0

        // Initialize memory
        i = 0
        WhileLoop LessThan(i, total_size) {
            SetByte(JSRxState.states, i, 0)
            i = Add(i, 1)
        }

        start_frag = JSRx_ParsePattern()

        IfCondition EqualTo(start_frag, 0) ThenBlock: {
            Deallocate(JSRxState.states, total_size)
            ReturnValue(0)
        }

        IfCondition NotEqual(JSRxCompiler.error, 0) ThenBlock: {
            Deallocate(JSRxState.states, total_size)
            ReturnValue(0)
        }

        match_state = JSRx_AddState(JSRxStateType.MATCH, 0, 0)
        frag_out = Dereference(Add(start_frag, 8))
        JSRx_PatchList(frag_out, match_state)

        handle = Allocate(40)
        IfCondition EqualTo(handle, 0) ThenBlock: {
            Deallocate(JSRxState.states, total_size)
            ReturnValue(0)
        }

        StoreValue(handle, JSRxState.states)
        StoreValue(Add(handle, 8), JSRxState.num_states)
        frag_start = Dereference(start_frag)
        StoreValue(Add(handle, 16), frag_start)
        StoreValue(Add(handle, 24), JSRxCompiler.group_count)
        // M30e: flags at +32
        StoreValue(Add(handle, 32), JSRxCompiler.flags)

        ReturnValue(handle)
    }
}

Function.JSRegex_Match {
    Input: regex: Address
    Input: text: Address
    Input: start_pos: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(regex, 0) ThenBlock: {
            ReturnValue(-1)
        }

        IfCondition EqualTo(text, 0) ThenBlock: {
            ReturnValue(-1)
        }

        states = Dereference(regex)
        num_states = Dereference(Add(regex, 8))
        start_state = Dereference(Add(regex, 16))
        capture_count = Dereference(Add(regex, 24))
        JSRxMatch.flags = Dereference(Add(regex, 32))

        JSRxMatch.text = text
        JSRxMatch.text_len = StringLength(text)
        JSRxMatch.pos = start_pos

        JSRxMatch.thread_size = 16

        IfCondition GreaterThan(start_pos, JSRxMatch.text_len) ThenBlock: {
            ReturnValue(-1)
        }

        threads_size = Multiply(JSRxConstants.MAX_THREADS, JSRxMatch.thread_size)

        IfCondition EqualTo(JSRxMatch.threads, 0) ThenBlock: {
            JSRxMatch.threads = Allocate(threads_size)
            IfCondition EqualTo(JSRxMatch.threads, 0) ThenBlock: {
                ReturnValue(-1)
            }
        }
        IfCondition EqualTo(JSRxMatch.next_threads, 0) ThenBlock: {
            JSRxMatch.next_threads = Allocate(threads_size)
            IfCondition EqualTo(JSRxMatch.next_threads, 0) ThenBlock: {
                ReturnValue(-1)
            }
        }
        // Capture slots: 64 ints (32 groups * start/end)
        IfCondition EqualTo(JSRxMatch.captures, 0) ThenBlock: {
            JSRxMatch.captures = Allocate(512)
        }
        IfCondition NotEqual(JSRxMatch.captures, 0) ThenBlock: {
            ci = 0
            WhileLoop LessThan(ci, 64) {
                StoreValue(Add(JSRxMatch.captures, Multiply(ci, 8)), -1)
                ci = Add(ci, 1)
            }
        }
        JSRxResult.ngroups = capture_count
        JSRxResult.cap_buf = JSRxMatch.captures

        JSRxMatch.thread_count = 0
        JSRxMatch.next_count = 0

        JSRx_AddThread(start_state, start_pos, 0)

        // M30d: track longest match (greedy). Early MATCH return broke a+/a*/a{n}.
        best_len = -1

        WhileLoop LessEqual(JSRxMatch.pos, JSRxMatch.text_len) {
            ch = 0

            IfCondition LessThan(JSRxMatch.pos, JSRxMatch.text_len) ThenBlock: {
                ch = GetByte(text, JSRxMatch.pos)
            }

            JSRxMatch.next_count = 0
            i = 0
            WhileLoop LessThan(i, JSRxMatch.thread_count) {
                thread = JSRx_GetThread(i)
                state_id = Dereference(thread)

                result = JSRx_ProcessState(states, state_id, ch, thread)

                IfCondition EqualTo(result, 1) ThenBlock: {
                    match_len = Subtract(JSRxMatch.pos, start_pos)
                    IfCondition GreaterThan(match_len, best_len) ThenBlock: {
                        best_len = match_len
                    }
                }

                i = Add(i, 1)
            }

            IfCondition LessThan(JSRxMatch.pos, JSRxMatch.text_len) ThenBlock: {
                temp = JSRxMatch.threads
                JSRxMatch.threads = JSRxMatch.next_threads
                JSRxMatch.next_threads = temp
                JSRxMatch.thread_count = JSRxMatch.next_count

                IfCondition EqualTo(JSRxMatch.thread_count, 0) ThenBlock: {
                    // no more paths — return best so far (greedy)
                    ReturnValue(best_len)
                }
            } ElseBlock: {
                BreakLoop
            }

            JSRxMatch.pos = Add(JSRxMatch.pos, 1)
        }

        // Check final states at end of input
        i = 0
        WhileLoop LessThan(i, JSRxMatch.thread_count) {
            thread = JSRx_GetThread(i)
            state_id = Dereference(thread)
            state_type = JSRx_GetStateType(states, state_id)

            IfCondition EqualTo(state_type, JSRxStateType.MATCH) ThenBlock: {
                match_len = Subtract(JSRxMatch.pos, start_pos)
                IfCondition GreaterThan(match_len, best_len) ThenBlock: {
                    best_len = match_len
                }
            }

            i = Add(i, 1)
        }

        ReturnValue(best_len)
    }
}

Function.JSRegex_Search {
    Input: regex: Address
    Input: text: Address
    Input: text_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(regex, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }

        states      = Dereference(regex)
        start_state = Dereference(Add(regex, 16))

        JSRxMatch.text        = text
        JSRxMatch.text_len    = text_len
        JSRxMatch.pos         = 0
        JSRxMatch.thread_size = 16

        threads_size = Multiply(JSRxConstants.MAX_THREADS, JSRxMatch.thread_size)
        IfCondition EqualTo(JSRxMatch.threads, 0) ThenBlock: {
            JSRxMatch.threads = Allocate(threads_size)
            IfCondition EqualTo(JSRxMatch.threads, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(JSRxMatch.next_threads, 0) ThenBlock: {
            JSRxMatch.next_threads = Allocate(threads_size)
            IfCondition EqualTo(JSRxMatch.next_threads, 0) ThenBlock: { ReturnValue(0) }
        }

        JSRxMatch.thread_count = 0
        JSRxMatch.next_count   = 0

        JSRx_AddThread(start_state, 0, 0)

        WhileLoop LessEqual(JSRxMatch.pos, JSRxMatch.text_len) {
            ch = 0
            IfCondition LessThan(JSRxMatch.pos, JSRxMatch.text_len) ThenBlock: {
                ch = GetByte(text, JSRxMatch.pos)
            }

            JSRx_AddThread(start_state, JSRxMatch.pos, 0)

            JSRxMatch.next_count = 0
            i = 0
            WhileLoop LessThan(i, JSRxMatch.thread_count) {
                thread = JSRx_GetThread(i)
                state_id = Dereference(thread)
                result = JSRx_ProcessState(states, state_id, ch, thread)
                IfCondition EqualTo(result, 1) ThenBlock: {
                    ReturnValue(1)
                }
                i = Add(i, 1)
            }

            IfCondition LessThan(JSRxMatch.pos, JSRxMatch.text_len) ThenBlock: {
                temp = JSRxMatch.threads
                JSRxMatch.threads = JSRxMatch.next_threads
                JSRxMatch.next_threads = temp
                JSRxMatch.thread_count = JSRxMatch.next_count
            } ElseBlock: {
                BreakLoop
            }

            JSRxMatch.pos = Add(JSRxMatch.pos, 1)
        }

        // Final sweep
        i = 0
        WhileLoop LessThan(i, JSRxMatch.thread_count) {
            thread = JSRx_GetThread(i)
            state_id = Dereference(thread)
            state_type = JSRx_GetStateType(states, state_id)
            IfCondition EqualTo(state_type, JSRxStateType.MATCH) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }

        ReturnValue(0)
    }
}

Function.JSRegex_FreeMatchState {
    Body: {
        IfCondition NotEqual(JSRxMatch.threads, 0) ThenBlock: {
            threads_size = Multiply(JSRxConstants.MAX_THREADS, JSRxMatch.thread_size)
            Deallocate(JSRxMatch.threads, threads_size)
            JSRxMatch.threads = 0
        }
        IfCondition NotEqual(JSRxMatch.next_threads, 0) ThenBlock: {
            threads_size = Multiply(JSRxConstants.MAX_THREADS, JSRxMatch.thread_size)
            Deallocate(JSRxMatch.next_threads, threads_size)
            JSRxMatch.next_threads = 0
        }
    }
}

Function.JSRegex_Free {
    Input: regex: Address
    Body: {
        IfCondition EqualTo(regex, 0) ThenBlock: {
            ReturnValue(0)
        }

        states = Dereference(regex)
        total_size = Multiply(JSRxConstants.MAX_STATES, JSRxConstants.STATE_SIZE)

        IfCondition NotEqual(states, 0) ThenBlock: {
            Deallocate(states, total_size)
        }

        Deallocate(regex, 32)
        ReturnValue(1)
    }
}

// ============================================================================
// PARSER FUNCTIONS
// ============================================================================

Function.JSRx_ParsePattern {
    Output: Address
    Body: {
        frag = JSRx_ParseAlt()
        ReturnValue(frag)
    }
}

Function.JSRx_ParseAlt {
    Output: Address
    Body: {
        left = JSRx_ParseSeq()

        IfCondition EqualTo(left, 0) ThenBlock: {
            ReturnValue(0)
        }

        WhileLoop 1 {
            IfCondition GreaterEqual(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                BreakLoop
            }

            ch = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)
            IfCondition NotEqual(ch, 124) ThenBlock: {
                BreakLoop
            }

            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            right = JSRx_ParseSeq()

            IfCondition EqualTo(right, 0) ThenBlock: {
                ReturnValue(0)
            }

            split = JSRx_AddState(JSRxStateType.SPLIT, 0, 0)
            left_start = Dereference(left)
            right_start = Dereference(right)
            JSRx_SetStateOut1(split, left_start)
            JSRx_SetStateOut2(split, right_start)

            left_out = Dereference(Add(left, 8))
            right_out = Dereference(Add(right, 8))
            new_out = JSRx_MergeLists(left_out, right_out)

            left = JSRx_FragAlloc()
            IfCondition EqualTo(left, 0) ThenBlock: {
                ReturnValue(0)
            }

            StoreValue(left, split)
            StoreValue(Add(left, 8), new_out)
        }

        ReturnValue(left)
    }
}

Function.JSRx_ParseSeq {
    Output: Address
    Body: {
        result = 0

        WhileLoop 1 {
            IfCondition GreaterEqual(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                BreakLoop
            }

            ch = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)

            IfCondition EqualTo(ch, 124) ThenBlock: { BreakLoop }
            IfCondition EqualTo(ch, 41) ThenBlock: { BreakLoop }

            atom = JSRx_ParseAtom()

            IfCondition EqualTo(atom, 0) ThenBlock: {
                ReturnValue(0)
            }

            IfCondition EqualTo(result, 0) ThenBlock: {
                result = atom
            } ElseBlock: {
                result_out = Dereference(Add(result, 8))
                atom_start = Dereference(atom)
                JSRx_PatchList(result_out, atom_start)

                result_start = Dereference(result)
                atom_out = Dereference(Add(atom, 8))

                result = JSRx_FragAlloc()
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }

                StoreValue(result, result_start)
                StoreValue(Add(result, 8), atom_out)
            }
        }

        IfCondition EqualTo(result, 0) ThenBlock: {
            empty = JSRx_AddState(JSRxStateType.EMPTY, 0, 0)
            result = JSRx_FragAlloc()
            IfCondition NotEqual(result, 0) ThenBlock: {
                StoreValue(result, empty)
                list = JSRx_CreateList(empty)
                StoreValue(Add(result, 8), list)
            }
        }

        ReturnValue(result)
    }
}

Function.JSRx_ParseAtom {
    Output: Address
    Body: {
        IfCondition GreaterEqual(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
            ReturnValue(0)
        }

        ch = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)

        IfCondition EqualTo(ch, 46) ThenBlock: {
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            state = JSRx_AddState(JSRxStateType.DOT, 0, 0)
            frag = JSRx_FragAlloc()
            IfCondition NotEqual(frag, 0) ThenBlock: {
                StoreValue(frag, state)
                list = JSRx_CreateList(state)
                StoreValue(Add(frag, 8), list)
            }
            ReturnValue(JSRx_ParsePost(frag))
        }

        IfCondition EqualTo(ch, 94) ThenBlock: {
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            state = JSRx_AddState(JSRxStateType.ASSERT_START, 0, 0)
            frag = JSRx_FragAlloc()
            IfCondition NotEqual(frag, 0) ThenBlock: {
                StoreValue(frag, state)
                list = JSRx_CreateList(state)
                StoreValue(Add(frag, 8), list)
            }
            ReturnValue(frag)
        }

        IfCondition EqualTo(ch, 36) ThenBlock: {
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            state = JSRx_AddState(JSRxStateType.ASSERT_END, 0, 0)
            frag = JSRx_FragAlloc()
            IfCondition NotEqual(frag, 0) ThenBlock: {
                StoreValue(frag, state)
                list = JSRx_CreateList(state)
                StoreValue(Add(frag, 8), list)
            }
            ReturnValue(frag)
        }

        IfCondition EqualTo(ch, 40) ThenBlock: {
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            // M30d: (?: non-capturing) vs ( capturing )
            is_cap = 1
            IfCondition LessThan(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                IfCondition EqualTo(GetByte(JSRxCompiler.pattern, JSRxCompiler.pos), 63) ThenBlock: {
                    // (?...
                    IfCondition LessThan(Add(JSRxCompiler.pos, 1), JSRxCompiler.len) ThenBlock: {
                        q2 = GetByte(JSRxCompiler.pattern, Add(JSRxCompiler.pos, 1))
                        // (?:  non-capturing
                        IfCondition EqualTo(q2, 58) ThenBlock: {
                            is_cap = 0
                            JSRxCompiler.pos = Add(JSRxCompiler.pos, 2)
                        }
                        // (?= (?! deferred — treat as non-cap empty for now skip
                    }
                }
            }
            gid = 0
            IfCondition EqualTo(is_cap, 1) ThenBlock: {
                JSRxCompiler.group_count = Add(JSRxCompiler.group_count, 1)
                gid = JSRxCompiler.group_count
            }
            sub = JSRx_ParseAlt()
            IfCondition GreaterEqual(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                JSRxCompiler.error = 1
                ReturnValue(0)
            }
            ch = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)
            IfCondition NotEqual(ch, 41) ThenBlock: {
                JSRxCompiler.error = 1
                ReturnValue(0)
            }
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            // Wrap capturing group with SAVE open/close (data1 = slot index)
            // slot 2*(gid-1)=start, 2*(gid-1)+1=end
            IfCondition And(EqualTo(is_cap, 1), GreaterThan(gid, 0)) ThenBlock: {
                open_slot = Multiply(Subtract(gid, 1), 2)
                close_slot = Add(open_slot, 1)
                s_open = JSRx_AddState(JSRxStateType.SAVE, open_slot, 0)
                s_close = JSRx_AddState(JSRxStateType.SAVE, close_slot, 0)
                sub_start = Dereference(sub)
                sub_out = Dereference(Add(sub, 8))
                JSRx_SetStateOut1(s_open, sub_start)
                JSRx_PatchList(sub_out, s_close)
                close_list = JSRx_CreateList(s_close)
                wrapped = JSRx_FragAlloc()
                IfCondition NotEqual(wrapped, 0) ThenBlock: {
                    StoreValue(wrapped, s_open)
                    StoreValue(Add(wrapped, 8), close_list)
                }
                ReturnValue(JSRx_ParsePost(wrapped))
            }
            ReturnValue(JSRx_ParsePost(sub))
        }

        IfCondition EqualTo(ch, 91) ThenBlock: {
            ReturnValue(JSRx_ParseClass())
        }

        IfCondition EqualTo(ch, 92) ThenBlock: {
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            IfCondition GreaterEqual(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                JSRxCompiler.error = 1
                ReturnValue(0)
            }
            ch = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)

            // M30d: class escapes \d \D \w \W \s \S as RANGE bitmaps
            is_class_esc = 0
            neg_esc = 0
            IfCondition EqualTo(ch, 100) ThenBlock: { is_class_esc = 1 } // \d
            IfCondition EqualTo(ch, 68) ThenBlock: { is_class_esc = 1 neg_esc = 1 } // \D
            IfCondition EqualTo(ch, 119) ThenBlock: { is_class_esc = 2 } // \w
            IfCondition EqualTo(ch, 87) ThenBlock: { is_class_esc = 2 neg_esc = 1 } // \W
            IfCondition EqualTo(ch, 115) ThenBlock: { is_class_esc = 3 } // \s
            IfCondition EqualTo(ch, 83) ThenBlock: { is_class_esc = 3 neg_esc = 1 } // \S
            IfCondition EqualTo(ch, 98) ThenBlock: {
                // \b word boundary
                state = JSRx_AddState(JSRxStateType.WORD_BOUNDARY, 0, 0)
                frag = JSRx_FragAlloc()
                IfCondition NotEqual(frag, 0) ThenBlock: {
                    StoreValue(frag, state)
                    list = JSRx_CreateList(state)
                    StoreValue(Add(frag, 8), list)
                }
                ReturnValue(frag)
            }
            IfCondition EqualTo(ch, 66) ThenBlock: {
                // \B
                state = JSRx_AddState(JSRxStateType.NOT_WORD_BOUNDARY, 0, 0)
                frag = JSRx_FragAlloc()
                IfCondition NotEqual(frag, 0) ThenBlock: {
                    StoreValue(frag, state)
                    list = JSRx_CreateList(state)
                    StoreValue(Add(frag, 8), list)
                }
                ReturnValue(frag)
            }
            IfCondition GreaterThan(is_class_esc, 0) ThenBlock: {
                bitmap = JSRx_ClassAlloc()
                IfCondition EqualTo(bitmap, 0) ThenBlock: {
                    JSRxCompiler.error = 1
                    ReturnValue(0)
                }
                bi = 0
                WhileLoop LessThan(bi, 32) {
                    SetByte(bitmap, bi, 0)
                    bi = Add(bi, 1)
                }
                IfCondition EqualTo(is_class_esc, 1) ThenBlock: {
                    // digits 0-9
                    dj = 48
                    WhileLoop LessEqual(dj, 57) {
                        JSRx_SetBit(bitmap, dj)
                        dj = Add(dj, 1)
                    }
                }
                IfCondition EqualTo(is_class_esc, 2) ThenBlock: {
                    // word: A-Z a-z 0-9 _
                    dj = 65
                    WhileLoop LessEqual(dj, 90) {
                        JSRx_SetBit(bitmap, dj)
                        dj = Add(dj, 1)
                    }
                    dj = 97
                    WhileLoop LessEqual(dj, 122) {
                        JSRx_SetBit(bitmap, dj)
                        dj = Add(dj, 1)
                    }
                    dj = 48
                    WhileLoop LessEqual(dj, 57) {
                        JSRx_SetBit(bitmap, dj)
                        dj = Add(dj, 1)
                    }
                    JSRx_SetBit(bitmap, 95)
                }
                IfCondition EqualTo(is_class_esc, 3) ThenBlock: {
                    // whitespace: tab LF VT FF CR space
                    JSRx_SetBit(bitmap, 9)
                    JSRx_SetBit(bitmap, 10)
                    JSRx_SetBit(bitmap, 11)
                    JSRx_SetBit(bitmap, 12)
                    JSRx_SetBit(bitmap, 13)
                    JSRx_SetBit(bitmap, 32)
                    JSRx_SetBit(bitmap, 160)
                }
                state = JSRx_AddState(JSRxStateType.RANGE, bitmap, neg_esc)
                frag = JSRx_FragAlloc()
                IfCondition NotEqual(frag, 0) ThenBlock: {
                    StoreValue(frag, state)
                    list = JSRx_CreateList(state)
                    StoreValue(Add(frag, 8), list)
                }
                ReturnValue(JSRx_ParsePost(frag))
            }

            // single-char escapes
            IfCondition EqualTo(ch, 110) ThenBlock: { ch = 10 }
            IfCondition EqualTo(ch, 114) ThenBlock: { ch = 13 }
            IfCondition EqualTo(ch, 116) ThenBlock: { ch = 9 }
            IfCondition EqualTo(ch, 102) ThenBlock: { ch = 12 }
            IfCondition EqualTo(ch, 118) ThenBlock: { ch = 11 }

            state = JSRx_AddState(JSRxStateType.CHAR, ch, 0)
            frag = JSRx_FragAlloc()
            IfCondition NotEqual(frag, 0) ThenBlock: {
                StoreValue(frag, state)
                list = JSRx_CreateList(state)
                StoreValue(Add(frag, 8), list)
            }
            ReturnValue(JSRx_ParsePost(frag))
        }

        // Literal character
        JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
        state = JSRx_AddState(JSRxStateType.CHAR, ch, 0)
        frag = JSRx_FragAlloc()
        IfCondition NotEqual(frag, 0) ThenBlock: {
            StoreValue(frag, state)
            list = JSRx_CreateList(state)
            StoreValue(Add(frag, 8), list)
        }
        ReturnValue(JSRx_ParsePost(frag))
    }
}

Function.JSRx_ParsePost {
    Input: atom: Address
    Output: Address
    Body: {
        IfCondition EqualTo(atom, 0) ThenBlock: {
            ReturnValue(0)
        }

        IfCondition GreaterEqual(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
            ReturnValue(atom)
        }

        ch = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)

        IfCondition EqualTo(ch, 42) ThenBlock: {
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            split = JSRx_AddState(JSRxStateType.SPLIT, 0, 0)
            atom_start = Dereference(atom)
            JSRx_SetStateOut1(split, atom_start)
            atom_out = Dereference(Add(atom, 8))
            JSRx_PatchList(atom_out, split)

            out = JSRx_CreateList(split)
            JSRx_SetListNext(out, 1)

            result = JSRx_FragAlloc()
            IfCondition NotEqual(result, 0) ThenBlock: {
                StoreValue(result, split)
                StoreValue(Add(result, 8), out)
            }

            ReturnValue(result)
        }

        IfCondition EqualTo(ch, 43) ThenBlock: {
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            split = JSRx_AddState(JSRxStateType.SPLIT, 0, 0)
            atom_start = Dereference(atom)
            JSRx_SetStateOut1(split, atom_start)
            atom_out = Dereference(Add(atom, 8))
            JSRx_PatchList(atom_out, split)

            out = JSRx_CreateList(split)
            JSRx_SetListNext(out, 1)

            result = JSRx_FragAlloc()
            IfCondition NotEqual(result, 0) ThenBlock: {
                StoreValue(result, atom_start)
                StoreValue(Add(result, 8), out)
            }

            ReturnValue(result)
        }

        IfCondition EqualTo(ch, 63) ThenBlock: {
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            // trailing ? after quantifier = lazy — ignore (treat greedy)
            split = JSRx_AddState(JSRxStateType.SPLIT, 0, 0)
            atom_start = Dereference(atom)
            JSRx_SetStateOut1(split, atom_start)

            atom_out = Dereference(Add(atom, 8))
            split_out = JSRx_CreateList(split)
            JSRx_SetListNext(split_out, 1)

            out_list = JSRx_MergeLists(atom_out, split_out)

            result = JSRx_FragAlloc()
            IfCondition NotEqual(result, 0) ThenBlock: {
                StoreValue(result, split)
                StoreValue(Add(result, 8), out_list)
            }

            ReturnValue(result)
        }

        // M30e: {n} {n,} {n,m} brace quantifiers
        IfCondition EqualTo(ch, 123) ThenBlock: {
            // Save pos in case not a valid quantifier
            save_pos = JSRxCompiler.pos
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            // parse min digits
            min_n = 0
            has_digit = 0
            WhileLoop LessThan(JSRxCompiler.pos, JSRxCompiler.len) {
                dc = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)
                IfCondition Or(LessThan(dc, 48), GreaterThan(dc, 57)) ThenBlock: {
                    BreakLoop
                }
                has_digit = 1
                min_n = Add(Multiply(min_n, 10), Subtract(dc, 48))
                JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
                // cap absurd
                IfCondition GreaterThan(min_n, 100) ThenBlock: { min_n = 100 }
            }
            IfCondition EqualTo(has_digit, 0) ThenBlock: {
                // not a quantifier — restore, treat as literal later
                JSRxCompiler.pos = save_pos
                ReturnValue(atom)
            }
            max_n = min_n
            unbounded = 0
            IfCondition LessThan(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                IfCondition EqualTo(GetByte(JSRxCompiler.pattern, JSRxCompiler.pos), 44) ThenBlock: {
                    // comma present
                    JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
                    // optional max
                    has_max = 0
                    max_n = 0
                    WhileLoop LessThan(JSRxCompiler.pos, JSRxCompiler.len) {
                        dc = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)
                        IfCondition Or(LessThan(dc, 48), GreaterThan(dc, 57)) ThenBlock: {
                            BreakLoop
                        }
                        has_max = 1
                        max_n = Add(Multiply(max_n, 10), Subtract(dc, 48))
                        JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
                        IfCondition GreaterThan(max_n, 100) ThenBlock: { max_n = 100 }
                    }
                    IfCondition EqualTo(has_max, 0) ThenBlock: {
                        unbounded = 1
                        max_n = min_n
                    }
                }
            }
            // expect }
            IfCondition GreaterEqual(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                JSRxCompiler.pos = save_pos
                ReturnValue(atom)
            }
            IfCondition NotEqual(GetByte(JSRxCompiler.pattern, JSRxCompiler.pos), 125) ThenBlock: {
                JSRxCompiler.pos = save_pos
                ReturnValue(atom)
            }
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            // skip lazy ?
            IfCondition LessThan(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                IfCondition EqualTo(GetByte(JSRxCompiler.pattern, JSRxCompiler.pos), 63) ThenBlock: {
                    JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
                }
            }
            // invalid range
            IfCondition And(EqualTo(unbounded, 0), LessThan(max_n, min_n)) ThenBlock: {
                JSRxCompiler.error = 1
                ReturnValue(0)
            }
            // Build: atom repeated min_n times, then optional up to (max-min) or star if unbounded
            // {0} → empty
            IfCondition EqualTo(min_n, 0) ThenBlock: {
                IfCondition EqualTo(unbounded, 1) ThenBlock: {
                    // {0,} = *
                    ReturnValue(JSRx_ApplyStar(atom))
                }
                IfCondition EqualTo(max_n, 0) ThenBlock: {
                    empty = JSRx_AddState(JSRxStateType.EMPTY, 0, 0)
                    result = JSRx_FragAlloc()
                    IfCondition NotEqual(result, 0) ThenBlock: {
                        StoreValue(result, empty)
                        list = JSRx_CreateList(empty)
                        StoreValue(Add(result, 8), list)
                    }
                    ReturnValue(result)
                }
                // {0,m} = optional chain of m atoms
                result = atom
                // first optional
                result = JSRx_ApplyQuestion(result)
                oi = 1
                WhileLoop LessThan(oi, max_n) {
                    // need another optional atom copy — re-parse impossible; use star-limited via nested ?
                    // approximate: for {0,m} use (atom?){m} via repeated optional concat of SAME atom states
                    // (sharing atom is wrong for backtracking but OK for pure NFA char matches)
                    // Safer: apply nested optionals: a(a(a)?)?)?
                    result = JSRx_ConcatOptional(atom, result)
                    oi = Add(oi, 1)
                }
                ReturnValue(result)
            }
            // min_n >= 1: always clone so original atom outs stay unpatched
            result = JSRx_CloneFrag(atom)
            IfCondition EqualTo(result, 0) ThenBlock: {
                result = atom
            }
            ci = 1
            WhileLoop LessThan(ci, min_n) {
                clone = JSRx_CloneFrag(atom)
                IfCondition EqualTo(clone, 0) ThenBlock: {
                    JSRxCompiler.error = 1
                    ReturnValue(0)
                }
                result = JSRx_ConcatFrag(result, clone)
                ci = Add(ci, 1)
            }
            IfCondition EqualTo(unbounded, 1) ThenBlock: {
                // {n,} = required n then *
                star_atom = JSRx_CloneFrag(atom)
                IfCondition EqualTo(star_atom, 0) ThenBlock: {
                    ReturnValue(result)
                }
                star_atom = JSRx_ApplyStar(star_atom)
                result = JSRx_ConcatFrag(result, star_atom)
                ReturnValue(result)
            }
            // {n,m}: add (m-n) optional atoms
            extra = Subtract(max_n, min_n)
            ei = 0
            WhileLoop LessThan(ei, extra) {
                opt = JSRx_CloneFrag(atom)
                IfCondition EqualTo(opt, 0) ThenBlock: {
                    BreakLoop
                }
                opt = JSRx_ApplyQuestion(opt)
                result = JSRx_ConcatFrag(result, opt)
                ei = Add(ei, 1)
            }
            ReturnValue(result)
        }

        ReturnValue(atom)
    }
}

// ─── Frag helpers for brace quantifiers ───
Function.JSRx_ApplyStar {
    Input: atom: Address
    Output: Address
    Body: {
        IfCondition EqualTo(atom, 0) ThenBlock: { ReturnValue(0) }
        split = JSRx_AddState(JSRxStateType.SPLIT, 0, 0)
        atom_start = Dereference(atom)
        JSRx_SetStateOut1(split, atom_start)
        atom_out = Dereference(Add(atom, 8))
        JSRx_PatchList(atom_out, split)
        out = JSRx_CreateList(split)
        JSRx_SetListNext(out, 1)
        result = JSRx_FragAlloc()
        IfCondition NotEqual(result, 0) ThenBlock: {
            StoreValue(result, split)
            StoreValue(Add(result, 8), out)
        }
        ReturnValue(result)
    }
}

Function.JSRx_ApplyQuestion {
    Input: atom: Address
    Output: Address
    Body: {
        IfCondition EqualTo(atom, 0) ThenBlock: { ReturnValue(0) }
        split = JSRx_AddState(JSRxStateType.SPLIT, 0, 0)
        atom_start = Dereference(atom)
        JSRx_SetStateOut1(split, atom_start)
        atom_out = Dereference(Add(atom, 8))
        split_out = JSRx_CreateList(split)
        JSRx_SetListNext(split_out, 1)
        out_list = JSRx_MergeLists(atom_out, split_out)
        result = JSRx_FragAlloc()
        IfCondition NotEqual(result, 0) ThenBlock: {
            StoreValue(result, split)
            StoreValue(Add(result, 8), out_list)
        }
        ReturnValue(result)
    }
}

Function.JSRx_ConcatFrag {
    Input: left: Address
    Input: right: Address
    Output: Address
    Body: {
        IfCondition EqualTo(left, 0) ThenBlock: { ReturnValue(right) }
        IfCondition EqualTo(right, 0) ThenBlock: { ReturnValue(left) }
        left_out = Dereference(Add(left, 8))
        right_start = Dereference(right)
        JSRx_PatchList(left_out, right_start)
        result = JSRx_FragAlloc()
        IfCondition NotEqual(result, 0) ThenBlock: {
            StoreValue(result, Dereference(left))
            StoreValue(Add(result, 8), Dereference(Add(right, 8)))
        }
        ReturnValue(result)
    }
}

// For {0,m} nesting: outer optional of atom then inner result
Function.JSRx_ConcatOptional {
    Input: atom: Address
    Input: inner: Address
    Output: Address
    Body: {
        // atom then inner, all optional: (atom inner)?
        // Actually for {0,m} greedy: a(a(a)?)?)?
        // Build: atom + inner, then ?
        joined = JSRx_ConcatFrag(atom, inner)
        ReturnValue(JSRx_ApplyQuestion(joined))
    }
}

// Clone a fragment's NFA states (for brace unrolling)
Function.JSRx_CloneFrag {
    Input: frag: Address
    Output: Address
    Body: {
        IfCondition EqualTo(frag, 0) ThenBlock: { ReturnValue(0) }
        // Map old state id → new state id for all states reachable from frag
        // Simple approach: clone ALL states created after a watermark is hard.
        // Instead: walk BFS from start through out1/out2, clone each once.
        old_start = Dereference(frag)
        IfCondition LessThan(old_start, 0) ThenBlock: { ReturnValue(0) }
        // id map array (max states) on heap
        map_sz = Multiply(JSRxConstants.MAX_STATES, 8)
        idmap = Allocate(map_sz)
        IfCondition EqualTo(idmap, 0) ThenBlock: { ReturnValue(0) }
        mi = 0
        WhileLoop LessThan(mi, JSRxConstants.MAX_STATES) {
            StoreValue(Add(idmap, Multiply(mi, 8)), -1)
            mi = Add(mi, 1)
        }
        // work stack of old ids
        stack = Allocate(Multiply(JSRxConstants.MAX_STATES, 8))
        IfCondition EqualTo(stack, 0) ThenBlock: {
            Deallocate(idmap, map_sz)
            ReturnValue(0)
        }
        sp = 0
        StoreValue(stack, old_start)
        sp = 1
        states = JSRxState.states
        WhileLoop GreaterThan(sp, 0) {
            sp = Subtract(sp, 1)
            oid = Dereference(Add(stack, Multiply(sp, 8)))
            IfCondition Or(LessThan(oid, 0), GreaterEqual(oid, JSRxState.num_states)) ThenBlock: {
                ContinueLoop
            }
            IfCondition NotEqual(Dereference(Add(idmap, Multiply(oid, 8))), -1) ThenBlock: {
                ContinueLoop
            }
            // clone state
            off = Multiply(oid, JSRxConstants.STATE_SIZE)
            base = Add(states, off)
            typ = Dereference(base)
            d1 = Dereference(Add(base, 8))
            d2 = Dereference(Add(base, 16))
            // RANGE bitmaps: share pointer (read-only after compile)
            nid = JSRx_AddState(typ, d1, d2)
            StoreValue(Add(idmap, Multiply(oid, 8)), nid)
            o1 = Dereference(Add(base, 24))
            o2 = Dereference(Add(base, 32))
            IfCondition GreaterEqual(o1, 0) ThenBlock: {
                StoreValue(Add(stack, Multiply(sp, 8)), o1)
                sp = Add(sp, 1)
            }
            IfCondition GreaterEqual(o2, 0) ThenBlock: {
                StoreValue(Add(stack, Multiply(sp, 8)), o2)
                sp = Add(sp, 1)
            }
        }
        // second pass: wire outs
        mi = 0
        WhileLoop LessThan(mi, JSRxState.num_states) {
            nid = Dereference(Add(idmap, Multiply(mi, 8)))
            IfCondition NotEqual(nid, -1) ThenBlock: {
                off = Multiply(mi, JSRxConstants.STATE_SIZE)
                base = Add(states, off)
                o1 = Dereference(Add(base, 24))
                o2 = Dereference(Add(base, 32))
                IfCondition GreaterEqual(o1, 0) ThenBlock: {
                    n1 = Dereference(Add(idmap, Multiply(o1, 8)))
                    IfCondition GreaterEqual(n1, 0) ThenBlock: {
                        JSRx_SetStateOut1(nid, n1)
                    }
                }
                IfCondition GreaterEqual(o2, 0) ThenBlock: {
                    n2 = Dereference(Add(idmap, Multiply(o2, 8)))
                    IfCondition GreaterEqual(n2, 0) ThenBlock: {
                        JSRx_SetStateOut2(nid, n2)
                    }
                }
            }
            mi = Add(mi, 1)
        }
        // new start
        new_start = Dereference(Add(idmap, Multiply(old_start, 8)))
        // out list: map each old out entry
        // list node: +0 state_id, +8 next, +16 is_out2
        old_out = Dereference(Add(frag, 8))
        new_out = 0
        cur = old_out
        hops = 0
        WhileLoop And(NotEqual(cur, 0), LessThan(hops, 256)) {
            hops = Add(hops, 1)
            os = Dereference(cur)
            is2 = Dereference(Add(cur, 16))
            ns = Dereference(Add(idmap, Multiply(os, 8)))
            IfCondition NotEqual(ns, -1) ThenBlock: {
                node = JSRx_CreateList(ns)
                JSRx_SetListNext(node, is2)
                IfCondition EqualTo(new_out, 0) ThenBlock: {
                    new_out = node
                } ElseBlock: {
                    new_out = JSRx_MergeLists(new_out, node)
                }
            }
            cur = Dereference(Add(cur, 8))
        }
        Deallocate(stack, Multiply(JSRxConstants.MAX_STATES, 8))
        Deallocate(idmap, map_sz)
        result = JSRx_FragAlloc()
        IfCondition NotEqual(result, 0) ThenBlock: {
            StoreValue(result, new_start)
            StoreValue(Add(result, 8), new_out)
        }
        ReturnValue(result)
    }
}

Function.JSRx_ParseClass {
    Output: Address
    Body: {
        JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)

        negated = 0
        ch = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)
        IfCondition EqualTo(ch, 94) ThenBlock: {
            negated = 1
            JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
        }

        bitmap = JSRx_ClassAlloc()
        IfCondition EqualTo(bitmap, 0) ThenBlock: {
            JSRxCompiler.error = 1
            ReturnValue(0)
        }

        // Initialize bitmap
        i = 0
        WhileLoop LessThan(i, 32) {
            SetByte(bitmap, i, 0)
            i = Add(i, 1)
        }

        WhileLoop 1 {
            IfCondition GreaterEqual(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                JSRxCompiler.error = 1
                ReturnValue(0)
            }

            ch = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)

            IfCondition EqualTo(ch, 93) ThenBlock: {
                JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
                BreakLoop
            }

            // M30e: escapes inside class \d \D \w \W \s \S and \n etc.
            IfCondition EqualTo(ch, 92) ThenBlock: {
                JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
                IfCondition GreaterEqual(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                    BreakLoop
                }
                esc = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)
                JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
                IfCondition EqualTo(esc, 100) ThenBlock: {
                    // \d
                    dj = 48
                    WhileLoop LessEqual(dj, 57) {
                        JSRx_SetBit(bitmap, dj)
                        dj = Add(dj, 1)
                    }
                    ContinueLoop
                }
                IfCondition EqualTo(esc, 68) ThenBlock: {
                    // \D — all non-digits
                    dj = 0
                    WhileLoop LessThan(dj, 256) {
                        IfCondition Or(LessThan(dj, 48), GreaterThan(dj, 57)) ThenBlock: {
                            JSRx_SetBit(bitmap, dj)
                        }
                        dj = Add(dj, 1)
                    }
                    ContinueLoop
                }
                IfCondition EqualTo(esc, 119) ThenBlock: {
                    dj = 65
                    WhileLoop LessEqual(dj, 90) {
                        JSRx_SetBit(bitmap, dj)
                        dj = Add(dj, 1)
                    }
                    dj = 97
                    WhileLoop LessEqual(dj, 122) {
                        JSRx_SetBit(bitmap, dj)
                        dj = Add(dj, 1)
                    }
                    dj = 48
                    WhileLoop LessEqual(dj, 57) {
                        JSRx_SetBit(bitmap, dj)
                        dj = Add(dj, 1)
                    }
                    JSRx_SetBit(bitmap, 95)
                    ContinueLoop
                }
                IfCondition EqualTo(esc, 87) ThenBlock: {
                    dj = 0
                    WhileLoop LessThan(dj, 256) {
                        is_w = 0
                        IfCondition And(GreaterEqual(dj, 48), LessEqual(dj, 57)) ThenBlock: { is_w = 1 }
                        IfCondition And(GreaterEqual(dj, 65), LessEqual(dj, 90)) ThenBlock: { is_w = 1 }
                        IfCondition And(GreaterEqual(dj, 97), LessEqual(dj, 122)) ThenBlock: { is_w = 1 }
                        IfCondition EqualTo(dj, 95) ThenBlock: { is_w = 1 }
                        IfCondition EqualTo(is_w, 0) ThenBlock: {
                            JSRx_SetBit(bitmap, dj)
                        }
                        dj = Add(dj, 1)
                    }
                    ContinueLoop
                }
                IfCondition EqualTo(esc, 115) ThenBlock: {
                    JSRx_SetBit(bitmap, 9)
                    JSRx_SetBit(bitmap, 10)
                    JSRx_SetBit(bitmap, 11)
                    JSRx_SetBit(bitmap, 12)
                    JSRx_SetBit(bitmap, 13)
                    JSRx_SetBit(bitmap, 32)
                    JSRx_SetBit(bitmap, 160)
                    ContinueLoop
                }
                IfCondition EqualTo(esc, 83) ThenBlock: {
                    dj = 0
                    WhileLoop LessThan(dj, 256) {
                        is_s = 0
                        IfCondition EqualTo(dj, 9) ThenBlock: { is_s = 1 }
                        IfCondition EqualTo(dj, 10) ThenBlock: { is_s = 1 }
                        IfCondition EqualTo(dj, 11) ThenBlock: { is_s = 1 }
                        IfCondition EqualTo(dj, 12) ThenBlock: { is_s = 1 }
                        IfCondition EqualTo(dj, 13) ThenBlock: { is_s = 1 }
                        IfCondition EqualTo(dj, 32) ThenBlock: { is_s = 1 }
                        IfCondition EqualTo(dj, 160) ThenBlock: { is_s = 1 }
                        IfCondition EqualTo(is_s, 0) ThenBlock: {
                            JSRx_SetBit(bitmap, dj)
                        }
                        dj = Add(dj, 1)
                    }
                    ContinueLoop
                }
                // single-char escape as literal in class
                IfCondition EqualTo(esc, 110) ThenBlock: { esc = 10 }
                IfCondition EqualTo(esc, 114) ThenBlock: { esc = 13 }
                IfCondition EqualTo(esc, 116) ThenBlock: { esc = 9 }
                ch = esc
                // fall through to range/literal handling with ch set; don't re-advance
            } ElseBlock: {
                JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
            }

            // Peek: is this the start of a range (X-Y)?
            IfCondition LessThan(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                peek = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)
                IfCondition EqualTo(peek, 45) ThenBlock: {
                    IfCondition LessThan(Add(JSRxCompiler.pos, 1), JSRxCompiler.len) ThenBlock: {
                        end_ch = GetByte(JSRxCompiler.pattern, Add(JSRxCompiler.pos, 1))
                        IfCondition NotEqual(end_ch, 93) ThenBlock: {
                            JSRxCompiler.pos = Add(JSRxCompiler.pos, 2)
                            // end may be escape — simple: if end is backslash, take next
                            IfCondition EqualTo(end_ch, 92) ThenBlock: {
                                IfCondition LessThan(JSRxCompiler.pos, JSRxCompiler.len) ThenBlock: {
                                    end_ch = GetByte(JSRxCompiler.pattern, JSRxCompiler.pos)
                                    JSRxCompiler.pos = Add(JSRxCompiler.pos, 1)
                                }
                            }
                            IfCondition LessEqual(ch, end_ch) ThenBlock: {
                                j = ch
                                WhileLoop LessEqual(j, end_ch) {
                                    JSRx_SetBit(bitmap, j)
                                    j = Add(j, 1)
                                }
                            } ElseBlock: {
                                JSRx_SetBit(bitmap, ch)
                                JSRx_SetBit(bitmap, end_ch)
                            }
                            ContinueLoop
                        }
                    }
                }
            }

            // Not a range — literal byte.
            JSRx_SetBit(bitmap, ch)
        }

        state = JSRx_AddState(JSRxStateType.RANGE, bitmap, negated)
        frag = JSRx_FragAlloc()
        IfCondition NotEqual(frag, 0) ThenBlock: {
            StoreValue(frag, state)
            list = JSRx_CreateList(state)
            StoreValue(Add(frag, 8), list)
        }
        ReturnValue(JSRx_ParsePost(frag))
    }
}

// ============================================================================
// STATE MANAGEMENT
// ============================================================================

Function.JSRx_AddState {
    Input: type: Integer
    Input: data1: Integer
    Input: data2: Integer
    Output: Integer
    Body: {
        state_id = JSRxState.num_states

        IfCondition GreaterEqual(state_id, JSRxConstants.MAX_STATES) ThenBlock: {
            JSRxCompiler.error = 1
            ReturnValue(-1)
        }

        IfCondition EqualTo(JSRxState.states, 0) ThenBlock: {
            ReturnValue(-1)
        }

        offset = Multiply(state_id, JSRxConstants.STATE_SIZE)
        base = Add(JSRxState.states, offset)

        StoreValue(base, type)
        StoreValue(Add(base, 8), data1)
        StoreValue(Add(base, 16), data2)
        StoreValue(Add(base, 24), -1)
        StoreValue(Add(base, 32), -1)

        JSRxState.num_states = Add(state_id, 1)
        ReturnValue(state_id)
    }
}

Function.JSRx_GetStateType {
    Input: states: Address
    Input: state_id: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(state_id, 0) ThenBlock: {
            ReturnValue(-1)
        }
        offset = Multiply(state_id, JSRxConstants.STATE_SIZE)
        ReturnValue(Dereference(Add(states, offset)))
    }
}

Function.JSRx_SetStateOut1 {
    Input: state_id: Integer
    Input: target: Integer
    Body: {
        offset = Multiply(state_id, JSRxConstants.STATE_SIZE)
        base = Add(JSRxState.states, offset)
        StoreValue(Add(base, 24), target)
    }
}

Function.JSRx_SetStateOut2 {
    Input: state_id: Integer
    Input: target: Integer
    Body: {
        offset = Multiply(state_id, JSRxConstants.STATE_SIZE)
        base = Add(JSRxState.states, offset)
        StoreValue(Add(base, 32), target)
    }
}

// ============================================================================
// LIST MANAGEMENT
// ============================================================================

Function.JSRx_CreateList {
    Input: state_id: Integer
    Output: Address
    Body: {
        list = JSRx_ListAlloc()
        IfCondition NotEqual(list, 0) ThenBlock: {
            StoreValue(list, state_id)
            StoreValue(Add(list, 8), 0)
            StoreValue(Add(list, 16), 0)
        }
        ReturnValue(list)
    }
}

Function.JSRx_SetListNext {
    Input: list: Address
    Input: is_out2: Integer
    Body: {
        IfCondition NotEqual(list, 0) ThenBlock: {
            StoreValue(Add(list, 16), is_out2)
        }
    }
}

Function.JSRx_MergeLists {
    Input: list1: Address
    Input: list2: Address
    Output: Address
    Body: {
        IfCondition EqualTo(list1, 0) ThenBlock: {
            ReturnValue(list2)
        }
        IfCondition EqualTo(list2, 0) ThenBlock: {
            ReturnValue(list1)
        }

        current = list1
        WhileLoop 1 {
            next = Dereference(Add(current, 8))
            IfCondition EqualTo(next, 0) ThenBlock: {
                StoreValue(Add(current, 8), list2)
                BreakLoop
            }
            current = next
        }

        ReturnValue(list1)
    }
}

Function.JSRx_PatchList {
    Input: list: Address
    Input: target: Integer
    Body: {
        WhileLoop NotEqual(list, 0) {
            state_id = Dereference(list)
            is_out2 = Dereference(Add(list, 16))

            offset = Multiply(state_id, JSRxConstants.STATE_SIZE)
            state = Add(JSRxState.states, offset)

            IfCondition EqualTo(is_out2, 0) ThenBlock: {
                out1 = Dereference(Add(state, 24))
                IfCondition EqualTo(out1, -1) ThenBlock: {
                    StoreValue(Add(state, 24), target)
                }
            } ElseBlock: {
                out2 = Dereference(Add(state, 32))
                IfCondition EqualTo(out2, -1) ThenBlock: {
                    StoreValue(Add(state, 32), target)
                }
            }

            list = Dereference(Add(list, 8))
        }
    }
}

// ============================================================================
// THREAD MANAGEMENT
// ============================================================================

Function.JSRx_AddThread {
    Input: state_id: Integer
    Input: pos: Integer
    Input: captures: Address
    Body: {
        IfCondition GreaterEqual(JSRxMatch.thread_count, JSRxConstants.MAX_THREADS) ThenBlock: {
            ReturnValue(0)
        }

        // Check for duplicate threads
        i = 0
        WhileLoop LessThan(i, JSRxMatch.thread_count) {
            thread = JSRx_GetThread(i)
            IfCondition EqualTo(Dereference(thread), state_id) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }

        thread = JSRx_GetThread(JSRxMatch.thread_count)
        StoreValue(thread, state_id)
        StoreValue(Add(thread, 8), pos)

        JSRxMatch.thread_count = Add(JSRxMatch.thread_count, 1)
        ReturnValue(1)
    }
}

Function.JSRx_GetThread {
    Input: index: Integer
    Output: Address
    Body: {
        offset = Multiply(index, JSRxMatch.thread_size)
        ReturnValue(Add(JSRxMatch.threads, offset))
    }
}

Function.JSRx_ProcessState {
    Input: states: Address
    Input: state_id: Integer
    Input: ch: Integer
    Input: thread: Address
    Output: Integer
    Body: {
        IfCondition LessThan(state_id, 0) ThenBlock: {
            ReturnValue(0)
        }

        offset = Multiply(state_id, JSRxConstants.STATE_SIZE)
        state = Add(states, offset)

        type = Dereference(state)
        data1 = Dereference(Add(state, 8))
        data2 = Dereference(Add(state, 16))
        out1 = Dereference(Add(state, 24))
        out2 = Dereference(Add(state, 32))

        IfCondition EqualTo(type, JSRxStateType.CHAR) ThenBlock: {
            match_c = 0
            IfCondition EqualTo(data1, ch) ThenBlock: { match_c = 1 }
            // case-insensitive
            IfCondition EqualTo(BitwiseAnd(JSRxMatch.flags, JSRxFlags.CASE_INSENSITIVE), JSRxFlags.CASE_INSENSITIVE) ThenBlock: {
                IfCondition EqualTo(JSRx_ToLower(data1), JSRx_ToLower(ch)) ThenBlock: {
                    match_c = 1
                }
            }
            IfCondition EqualTo(match_c, 1) ThenBlock: {
                JSRx_AddNextThread(out1, Add(JSRxMatch.pos, 1), thread)
            }
            ReturnValue(0)
        }

        IfCondition EqualTo(type, JSRxStateType.RANGE) ThenBlock: {
            hit = JSRx_TestBit(data1, ch)
            // case-insensitive: also test folded char
            IfCondition EqualTo(BitwiseAnd(JSRxMatch.flags, JSRxFlags.CASE_INSENSITIVE), JSRxFlags.CASE_INSENSITIVE) ThenBlock: {
                ch2 = JSRx_ToLower(ch)
                IfCondition NotEqual(ch2, ch) ThenBlock: {
                    IfCondition NotEqual(JSRx_TestBit(data1, ch2), 0) ThenBlock: { hit = 1 }
                }
                ch3 = JSRx_ToUpper(ch)
                IfCondition NotEqual(ch3, ch) ThenBlock: {
                    IfCondition NotEqual(JSRx_TestBit(data1, ch3), 0) ThenBlock: { hit = 1 }
                }
            }
            IfCondition EqualTo(data2, 1) ThenBlock: {
                hit = JSRx_Not2(hit)
            }
            IfCondition NotEqual(hit, 0) ThenBlock: {
                JSRx_AddNextThread(out1, Add(JSRxMatch.pos, 1), thread)
            }
            ReturnValue(0)
        }

        IfCondition EqualTo(type, JSRxStateType.DOT) ThenBlock: {
            // DOTALL: match newline; else exclude LF
            ok_dot = 1
            IfCondition EqualTo(ch, 10) ThenBlock: {
                ok_dot = 0
                IfCondition EqualTo(BitwiseAnd(JSRxMatch.flags, JSRxFlags.DOTALL), JSRxFlags.DOTALL) ThenBlock: {
                    ok_dot = 1
                }
            }
            // also exclude CR unless dotAll
            IfCondition EqualTo(ch, 13) ThenBlock: {
                ok_dot = 0
                IfCondition EqualTo(BitwiseAnd(JSRxMatch.flags, JSRxFlags.DOTALL), JSRxFlags.DOTALL) ThenBlock: {
                    ok_dot = 1
                }
            }
            IfCondition EqualTo(ok_dot, 1) ThenBlock: {
                JSRx_AddNextThread(out1, Add(JSRxMatch.pos, 1), thread)
            }
            ReturnValue(0)
        }

        IfCondition EqualTo(type, JSRxStateType.SPLIT) ThenBlock: {
            JSRx_AddThread(out1, JSRxMatch.pos, thread)
            IfCondition NotEqual(out2, -1) ThenBlock: {
                JSRx_AddThread(out2, JSRxMatch.pos, thread)
            }
            ReturnValue(0)
        }

        IfCondition EqualTo(type, JSRxStateType.MATCH) ThenBlock: {
            ReturnValue(1)
        }

        IfCondition EqualTo(type, JSRxStateType.EMPTY) ThenBlock: {
            JSRx_AddThread(out1, JSRxMatch.pos, thread)
            ReturnValue(0)
        }

        // SAVE: epsilon + record capture slot (data1) at current pos into global capture buf
        IfCondition EqualTo(type, JSRxStateType.SAVE) ThenBlock: {
            // Store capture position: slots in JSRxMatch.captures as 8-byte ints
            IfCondition NotEqual(JSRxMatch.captures, 0) ThenBlock: {
                IfCondition And(GreaterEqual(data1, 0), LessThan(data1, 64)) ThenBlock: {
                    StoreValue(Add(JSRxMatch.captures, Multiply(data1, 8)), JSRxMatch.pos)
                }
            }
            JSRx_AddThread(out1, JSRxMatch.pos, thread)
            ReturnValue(0)
        }

        IfCondition EqualTo(type, JSRxStateType.ASSERT_START) ThenBlock: {
            ok_s = 0
            IfCondition EqualTo(JSRxMatch.pos, 0) ThenBlock: { ok_s = 1 }
            // multiline: also after LF
            IfCondition EqualTo(BitwiseAnd(JSRxMatch.flags, JSRxFlags.MULTILINE), JSRxFlags.MULTILINE) ThenBlock: {
                IfCondition GreaterThan(JSRxMatch.pos, 0) ThenBlock: {
                    IfCondition EqualTo(GetByte(JSRxMatch.text, Subtract(JSRxMatch.pos, 1)), 10) ThenBlock: {
                        ok_s = 1
                    }
                }
            }
            IfCondition EqualTo(ok_s, 1) ThenBlock: {
                JSRx_AddThread(out1, JSRxMatch.pos, thread)
            }
            ReturnValue(0)
        }

        IfCondition EqualTo(type, JSRxStateType.ASSERT_END) ThenBlock: {
            ok_e = 0
            IfCondition EqualTo(JSRxMatch.pos, JSRxMatch.text_len) ThenBlock: { ok_e = 1 }
            // multiline: also before LF
            IfCondition EqualTo(BitwiseAnd(JSRxMatch.flags, JSRxFlags.MULTILINE), JSRxFlags.MULTILINE) ThenBlock: {
                IfCondition LessThan(JSRxMatch.pos, JSRxMatch.text_len) ThenBlock: {
                    IfCondition EqualTo(GetByte(JSRxMatch.text, JSRxMatch.pos), 10) ThenBlock: {
                        ok_e = 1
                    }
                }
            }
            IfCondition EqualTo(ok_e, 1) ThenBlock: {
                JSRx_AddThread(out1, JSRxMatch.pos, thread)
            }
            ReturnValue(0)
        }

        // \b / \B word boundary
        IfCondition Or(EqualTo(type, JSRxStateType.WORD_BOUNDARY), EqualTo(type, JSRxStateType.NOT_WORD_BOUNDARY)) ThenBlock: {
            prev_w = 0
            cur_w = 0
            IfCondition GreaterThan(JSRxMatch.pos, 0) ThenBlock: {
                pc = GetByte(JSRxMatch.text, Subtract(JSRxMatch.pos, 1))
                prev_w = JSRx_IsWordChar(pc)
            }
            IfCondition LessThan(JSRxMatch.pos, JSRxMatch.text_len) ThenBlock: {
                cc = GetByte(JSRxMatch.text, JSRxMatch.pos)
                cur_w = JSRx_IsWordChar(cc)
            }
            is_bound = 0
            IfCondition NotEqual(prev_w, cur_w) ThenBlock: { is_bound = 1 }
            ok = is_bound
            IfCondition EqualTo(type, JSRxStateType.NOT_WORD_BOUNDARY) ThenBlock: {
                IfCondition EqualTo(is_bound, 0) ThenBlock: { ok = 1 } ElseBlock: { ok = 0 }
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                JSRx_AddThread(out1, JSRxMatch.pos, thread)
            }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

Function.JSRx_IsWordChar {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 95) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSRx_ToLower {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: {
            ReturnValue(Add(ch, 32))
        }
        ReturnValue(ch)
    }
}

Function.JSRx_ToUpper {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: {
            ReturnValue(Subtract(ch, 32))
        }
        ReturnValue(ch)
    }
}

Function.JSRx_AddNextThread {
    Input: state_id: Integer
    Input: pos: Integer
    Input: captures: Address
    Body: {
        IfCondition GreaterEqual(JSRxMatch.next_count, JSRxConstants.MAX_THREADS) ThenBlock: {
            ReturnValue(0)
        }

        // Check for duplicate threads
        i = 0
        WhileLoop LessThan(i, JSRxMatch.next_count) {
            thread = JSRx_GetNextThread(i)
            IfCondition EqualTo(Dereference(thread), state_id) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }

        thread = JSRx_GetNextThread(JSRxMatch.next_count)
        StoreValue(thread, state_id)
        StoreValue(Add(thread, 8), pos)

        JSRxMatch.next_count = Add(JSRxMatch.next_count, 1)
        ReturnValue(1)
    }
}

Function.JSRx_GetNextThread {
    Input: index: Integer
    Output: Address
    Body: {
        offset = Multiply(index, JSRxMatch.thread_size)
        ReturnValue(Add(JSRxMatch.next_threads, offset))
    }
}

// ============================================================================
// BIT OPERATIONS
// ============================================================================

Function.JSRx_SetBit {
    Input: bitmap: Address
    Input: bit: Integer
    Body: {
        IfCondition GreaterEqual(bit, 256) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(bit, 0) ThenBlock: {
            ReturnValue(0)
        }

        byte_offset = Divide(bit, 8)
        bit_offset = Modulo(bit, 8)
        byte_val = GetByte(bitmap, byte_offset)
        mask = LeftShift(1, bit_offset)
        SetByte(bitmap, byte_offset, BitwiseOr(byte_val, mask))
        ReturnValue(1)
    }
}

Function.JSRx_TestBit {
    Input: bitmap: Address
    Input: bit: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(bit, 256) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(bit, 0) ThenBlock: {
            ReturnValue(0)
        }

        byte_offset = Divide(bit, 8)
        bit_offset = Modulo(bit, 8)
        byte_val = GetByte(bitmap, byte_offset)
        mask = LeftShift(1, bit_offset)
        ReturnValue(BitwiseAnd(byte_val, mask))
    }
}

Function.JSRx_Not2 {
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// ============================================================================
// SEARCH WITH POSITION — wrapper for JS built-in integration
// ============================================================================

FixedPool.JSRxResult {
    "pos":    Initialize=-1
    "len":    Initialize=-1
    "ngroups": Initialize=0
    // captures[i*2]=start, captures[i*2+1]=end for group i+1; main match is pos/len
    "cap_buf": Initialize=0
}

// Search for regex anywhere in text, returning position and length.
// Returns 1 if found (pos/len stored in JSRxResult), 0 if not found.
Function.JSRegex_SearchPosLen {
    Input: regex: Address
    Input: text: Address
    Input: text_len: Integer
    Output: Integer
    Body: {
        ReturnValue(JSRegex_SearchPosLenFrom(regex, text, text_len, 0))
    }
}

// M30c: search from start_from (for lastIndex / sticky-ish)
Function.JSRegex_SearchPosLenFrom {
    Input: regex: Address
    Input: text: Address
    Input: text_len: Integer
    Input: start_from: Integer
    Output: Integer
    Body: {
        save_regex = regex
        save_text = text
        save_len = text_len
        i = start_from
        IfCondition LessThan(i, 0) ThenBlock: { i = 0 }
        IfCondition EqualTo(save_regex, 0) ThenBlock: {
            JSRxResult.pos = -1
            JSRxResult.len = -1
            ReturnValue(0)
        }
        IfCondition EqualTo(save_text, 0) ThenBlock: {
            JSRxResult.pos = -1
            JSRxResult.len = -1
            ReturnValue(0)
        }
        WhileLoop LessEqual(i, save_len) {
            match_len = JSRegex_Match(save_regex, save_text, i)
            IfCondition GreaterEqual(match_len, 0) ThenBlock: {
                JSRxResult.pos = i
                JSRxResult.len = match_len
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        JSRxResult.pos = -1
        JSRxResult.len = -1
        ReturnValue(0)
    }
}

// ============================================================================
// END Library.JSRegex.ailang
// ============================================================================
