        StoreValue(Add(blob, 75800), 42610)
        StoreValue(Add(blob, 75808), 0)
        off = 0
        WhileLoop 1 {
            pid = Dereference(Add(blob, off))
            IfCondition EqualTo(pid, 0) ThenBlock: { BreakLoop }
            off = Add(off, 8)
            nr = Dereference(Add(blob, off))
            off = Add(off, 8)
            mp = 0
            IfCondition And(GreaterThan(pid, 0), LessThan(pid, JSRxPropState.max_id)) ThenBlock: {
                mp = Allocate(JSRxPropState.map_bytes)
                IfCondition NotEqual(mp, 0) ThenBlock: {
                    MemorySet(mp, 0, JSRxPropState.map_bytes)
                    StoreValue(Add(JSRxPropState.maps, Multiply(pid, 8)), mp)
                }
            }
            ri = 0
            WhileLoop LessThan(ri, nr) {
                a = Dereference(Add(blob, off))
                off = Add(off, 8)
                b = Dereference(Add(blob, off))
                off = Add(off, 8)
                IfCondition NotEqual(mp, 0) ThenBlock: {
                    ch = a
                    WhileLoop LessEqual(ch, b) {
                        bo = Divide(ch, 8)
                        bi = Subtract(ch, Multiply(bo, 8))
                        bv = GetByte(mp, bo)
                        SetByte(mp, bo, BitwiseOr(bv, LeftShift(1, bi)))
                        ch = Add(ch, 1)
                    }
                }
                ri = Add(ri, 1)
            }
        }
        JSRxPropState.ready = 1
        ReturnValue(1)
    }
}

Function.JSRx_PropMatch {
    Input: prop_id: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        save_p = prop_id
        save_c = ch
        IfCondition EqualTo(JSRxPropState.ready, 0) ThenBlock: { JSRx_PropInit() }
        IfCondition EqualTo(save_p, JSRxPropId.Any) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(save_c, 65535) ThenBlock: {
            IfCondition EqualTo(save_p, JSRxPropId.Assigned) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition LessThan(save_c, 0) ThenBlock: { ReturnValue(0) }
        IfCondition Or(LessEqual(save_p, 0), GreaterEqual(save_p, JSRxPropState.max_id)) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRxPropState.maps, 0) ThenBlock: { ReturnValue(0) }
        mp = Dereference(Add(JSRxPropState.maps, Multiply(save_p, 8)))
        IfCondition EqualTo(mp, 0) ThenBlock: { ReturnValue(0) }
        bo = Divide(save_c, 8)
        bi = Subtract(save_c, Multiply(bo, 8))
        bv = GetByte(mp, bo)
        IfCondition NotEqual(BitwiseAnd(bv, LeftShift(1, bi)), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.JSRx_PropResolve {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_p = name_ptr
        save_n = name_len
        IfCondition Or(EqualTo(save_p, 0), LessEqual(save_n, 0)) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(save_n, 5) ThenBlock: {
            ok = 1
            IfCondition NotEqual(GetByte(save_p, 0), 65) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 1), 83) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 2), 67) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 3), 73) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 4), 73) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(save_n, 3) ThenBlock: {
            ok = 1
            IfCondition NotEqual(GetByte(save_p, 0), 65) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 1), 110) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 2), 121) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(2) }
        }
        IfCondition EqualTo(save_n, 8) ThenBlock: {
            ok = 1
            IfCondition NotEqual(GetByte(save_p, 0), 65) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 1), 115) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 2), 115) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 3), 105) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 4), 103) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 5), 110) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 6), 101) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 7), 100) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(3) }
        }
        IfCondition EqualTo(save_n, 15) ThenBlock: {
            ok = 1
            IfCondition NotEqual(GetByte(save_p, 0), 65) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 1), 83) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 2), 67) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 3), 73) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 4), 73) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 5), 95) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 6), 72) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 7), 101) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 8), 120) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 9), 95) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 10), 68) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 11), 105) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 12), 103) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 13), 105) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 14), 116) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(4) }
        }
        IfCondition EqualTo(save_n, 4) ThenBlock: {
            ok = 1
            IfCondition NotEqual(GetByte(save_p, 0), 65) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 1), 72) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 2), 101) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 3), 120) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(4) }
        }
        IfCondition EqualTo(save_n, 9) ThenBlock: {
            ok = 1
            IfCondition NotEqual(GetByte(save_p, 0), 72) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 1), 101) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 2), 120) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 3), 95) ThenBlock: { ok = 0 }
            IfCondition NotEqual(GetByte(save_p, 4), 68) ThenBlock: { ok = 0 }
