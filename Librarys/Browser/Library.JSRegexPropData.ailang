        WRMEM_64(blob, 75720, 42966)
        WRMEM_64(blob, 75728, 42968)
        WRMEM_64(blob, 75736, 42968)
        WRMEM_64(blob, 75744, 42970)
        WRMEM_64(blob, 75752, 42970)
        WRMEM_64(blob, 75760, 42972)
        WRMEM_64(blob, 75768, 42972)
        WRMEM_64(blob, 75776, 42997)
        WRMEM_64(blob, 75784, 42997)
        WRMEM_64(blob, 75792, 65313)
        WRMEM_64(blob, 75800, 65338)
        WRMEM_64(blob, 75808, 0)
        off = 0
        WhileLoop 1 {
            pid = RDMEM_64(blob, off)
            IfCondition EqualTo(pid, 0) ThenBlock: { BreakLoop }
            off = Add(off, 8)
            nr = RDMEM_64(blob, off)
            off = Add(off, 8)
            mp = 0
            IfCondition And(GreaterThan(pid, 0), LessThan(pid, JSRxPropState.max_id)) ThenBlock: {
                mp = Allocate(JSRxPropState.map_bytes)
                IfCondition NotEqual(mp, 0) ThenBlock: {
                    MemorySet(mp, 0, JSRxPropState.map_bytes)
                    WRMEM_64(JSRxPropState.maps, Multiply(pid, 8), mp)
                }
            }
            ri = 0
            WhileLoop LessThan(ri, nr) {
                a = RDMEM_64(blob, off)
                off = Add(off, 8)
                b = RDMEM_64(blob, off)
                off = Add(off, 8)
                IfCondition NotEqual(mp, 0) ThenBlock: {
                    ch = a
                    WhileLoop LessEqual(ch, b) {
                        bo = Divide(ch, 8)
                        bi = Subtract(ch, Multiply(bo, 8))
                        bv = RDMEM_8(mp, bo)
                        WRMEM_8(mp, bo, BitwiseOr(bv, LeftShift(1, bi)))
                        ch = Add(ch, 1)
                    }
                }
                ri = Add(ri, 1)
            }
        }
        JSRxPropState.ready = 1
        ReturnValue(1)
    }
}

Function.JSRx_PropMatch {
    Input: prop_id: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        save_p = prop_id
        save_c = ch
        IfCondition EqualTo(JSRxPropState.ready, 0) ThenBlock: { JSRx_PropInit() }
        IfCondition EqualTo(save_p, JSRxPropId.Any) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(save_c, 65535) ThenBlock: {
            IfCondition EqualTo(save_p, JSRxPropId.Assigned) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition LessThan(save_c, 0) ThenBlock: { ReturnValue(0) }
        IfCondition Or(LessEqual(save_p, 0), GreaterEqual(save_p, JSRxPropState.max_id)) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRxPropState.maps, 0) ThenBlock: { ReturnValue(0) }
        mp = RDMEM_64(JSRxPropState.maps, Multiply(save_p, 8))
        IfCondition EqualTo(mp, 0) ThenBlock: { ReturnValue(0) }
        bo = Divide(save_c, 8)
        bi = Subtract(save_c, Multiply(bo, 8))
        bv = RDMEM_8(mp, bo)
        IfCondition NotEqual(BitwiseAnd(bv, LeftShift(1, bi)), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Resolve property name: exact first, then Unicode loose match (strip _- space, lower)
Function.JSRx_PropResolve {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        save_p = name_ptr
        save_n = name_len
        IfCondition Or(EqualTo(save_p, 0), LessEqual(save_n, 0)) ThenBlock: { ReturnValue(0) }
        // Build loose form in str_work_buf
        w = JSRTState.str_work_buf
        IfCondition EqualTo(w, 0) ThenBlock: { ReturnValue(0) }
        oi = 0
        i = 0
        WhileLoop LessThan(i, save_n) {
            c = RDMEM_8(save_p, i)
            // skip space tab _ -
            skip = 0
            IfCondition EqualTo(c, 32) ThenBlock: { skip = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { skip = 1 }
            IfCondition EqualTo(c, 95) ThenBlock: { skip = 1 }
            IfCondition EqualTo(c, 45) ThenBlock: { skip = 1 }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                // lowercase A-Z
                IfCondition And(GreaterEqual(c, 65), LessEqual(c, 90)) ThenBlock: {
                    c = Add(c, 32)
                }
                IfCondition LessThan(oi, 4000) ThenBlock: {
                    WRMEM_8(w, oi, c)
                    oi = Add(oi, 1)
                }
            }
            i = Add(i, 1)
        }
        WRMEM_8(w, oi, 0)
        // Match loose names
        IfCondition EqualTo(oi, 36) ThenBlock: {
            ok = 1
            IfCondition NotEqual(RDMEM_8(w, 0), 103) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 1), 101) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 2), 110) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 3), 101) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 4), 114) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 5), 97) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 6), 108) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 7), 99) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 8), 97) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 9), 116) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 10), 101) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 11), 103) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 12), 111) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 13), 114) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 14), 121) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 15), 61) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 16), 99) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 17), 111) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 18), 110) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 19), 110) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 20), 101) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 21), 99) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 22), 116) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 23), 111) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 24), 114) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 25), 112) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 26), 117) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 27), 110) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 28), 99) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 29), 116) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 30), 117) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 31), 97) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 32), 116) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 33), 105) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 34), 111) ThenBlock: { ok = 0 }
            IfCondition NotEqual(RDMEM_8(w, 35), 110) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(31) }
        }
        IfCondition EqualTo(oi, 34) ThenBlock: {
