// Library.JSRuntime.ailang — JavaScript runtime value system
// Handles: value creation (numbers, strings, booleans, null, undefined, objects,
// arrays, functions), type coercion (ToNumber, ToString, ToBool), comparison
// semantics (strict and abstract equality), built-in object stubs (console, Math),
// native function dispatch table, and timer queue (setTimeout/setInterval).
//
// CLOBBER SAFETY: Every function saves Input params to locals on the FIRST
// line of Body. Complex expressions broken into steps. JSRTTmp fields
// guarded with push/pop across recursive calls.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.Hash

LibraryImport.Browser.JSRuntime.JSRTCoerce
LibraryImport.Browser.JSRuntime.JSRTObject
LibraryImport.Browser.JSRuntime.PropTable
LibraryImport.Browser.JSRegex

// =============================================================================
// VALUE TYPE CONSTANTS
// =============================================================================
FixedPool.JSType {
    "UNDEFINED":  Initialize=0
    "NULL":       Initialize=1
    "BOOLEAN":    Initialize=2
    "NUMBER":     Initialize=3
    "STRING":     Initialize=4
    "OBJECT":     Initialize=5
    "FUNCTION":   Initialize=6
    "ARRAY":      Initialize=7
    "GENERATOR":  Initialize=8
}

// =============================================================================
// RUNTIME CONSTANTS
// =============================================================================
FixedPool.JSRTConst {
    "VAL_SIZE":      Initialize=16
    "MAX_VALUES":    Initialize=2097152
    "MAX_NATIVES":   Initialize=64
    "MAX_TIMERS":    Initialize=32
    "TIMER_SIZE":    Initialize=32
    "NATIVE_SIZE":   Initialize=24
    "FUNC_DESC_SZ":  Initialize=72
    "STR_BUF_CAP":   Initialize=65536
}

// =============================================================================
// RUNTIME STATE
// =============================================================================
FixedPool.JSRTState {
    "val_pool":      Initialize=0
    "val_count":     Initialize=0
    "undef_val":     Initialize=0
    "null_val":      Initialize=0
    "true_val":      Initialize=0
    "false_val":     Initialize=0
    "native_table":  Initialize=0
    "native_count":  Initialize=0
    "timer_pool":    Initialize=0
    "timer_count":   Initialize=0
    "next_timer_id": Initialize=1
    "str_buf":       Initialize=0
    "str_pos":       Initialize=0
    "int_buf":       Initialize=0
    "int_tmp":       Initialize=0
    "float_buf":     Initialize=0
    "str_undefined": Initialize=0
    "str_null":      Initialize=0
    "str_true":      Initialize=0
    "str_false":     Initialize=0
    "str_objobj":    Initialize=0
    "str_function":  Initialize=0
    "str_typeof_undefined": Initialize=0
    "str_typeof_object":    Initialize=0
    "str_typeof_boolean":   Initialize=0
    "str_typeof_number":    Initialize=0
    "str_typeof_string":    Initialize=0
    "str_typeof_function":  Initialize=0
    "str_work_buf":         Initialize=0
    "str_lex_buf":          Initialize=0
    "str_slab":             Initialize=0
    "str_slab_pos":         Initialize=0
    "str_slab_cap":         Initialize=0
    "func_slab":            Initialize=0
    "func_slab_pos":        Initialize=0
    "func_slab_cap":        Initialize=0
    "oom":                  Initialize=0, CanChange=True
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.JSRTTmp {
    "idx":       Initialize=0
    "type":      Initialize=0
    "ptr":       Initialize=0
    "len":       Initialize=0
    "val":       Initialize=0
    "addr":      Initialize=0
    "done":      Initialize=0
    "count":     Initialize=0
    "a_type":    Initialize=0
    "b_type":    Initialize=0
    "a_pay":     Initialize=0
    "b_pay":     Initialize=0
    "result":    Initialize=0
    "buf":       Initialize=0
    "digit":     Initialize=0
    "neg":       Initialize=0
    "pos":       Initialize=0
    "ch":        Initialize=0
}

// =============================================================================
// RUNTIME STACK — push/pop for recursive calls
// =============================================================================
FixedPool.JSRTStack {
    "pool":       Initialize=0
    "sp":         Initialize=0
    "capacity":   Initialize=0
    "tmp_val":    Initialize=0
    "tmp_addr":   Initialize=0
}

// =============================================================================
// STACK PUSH / POP
// =============================================================================
Function.JSRT__Push {
    Input: val: Integer
    Output: Integer
    Body: {
        JSRTStack.tmp_val = val
        JSRTStack.tmp_addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(JSRTStack.tmp_addr, JSRTStack.tmp_val)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        ReturnValue(0)
    }
}

Function.JSRT__Pop {
    Output: Integer
    Body: {
        JSRTStack.sp = Subtract(JSRTStack.sp, 1)
        ReturnValue(Dereference(Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))))
    }
}

// =============================================================================
// VALUE POOL ALLOCATION — allocate a new 16-byte JSValue from pool
// Returns pointer to the new JSValue, or 0 on overflow
// =============================================================================
Function.JSRT__AllocValue {
    Output: Address
    Body: {
        IfCondition GreaterEqual(JSRTState.val_count, JSRTConst.MAX_VALUES) ThenBlock: {
            // Out of value pool — signal OOM instead of wrapping and
            // corrupting live values.  The VM dispatch loop checks
            // JSRTState.oom on every step and aborts cleanly.
            JSRTState.oom = 1
            ReturnValue(0)
        }
        offset = Multiply(JSRTState.val_count, JSRTConst.VAL_SIZE)
        addr = Add(JSRTState.val_pool, offset)
        JSRTState.val_count = Add(JSRTState.val_count, 1)
        ReturnValue(addr)
    }
}


// =============================================================================
// INIT — create singletons, native table, timer queue, stacks
// =============================================================================
Function.JSRT_Init {
    Output: Integer
    Body: {
        // Value pool: 8192 * 16 = 131072 bytes
        pool_sz = Multiply(JSRTConst.MAX_VALUES, JSRTConst.VAL_SIZE)
        JSRTState.val_pool = Allocate(pool_sz)
        MemorySet(JSRTState.val_pool, 0, pool_sz)
        JSRTState.val_count = 0

        // String buffer for ToString conversions
        JSRTState.str_buf = Allocate(JSRTConst.STR_BUF_CAP)
        MemorySet(JSRTState.str_buf, 0, JSRTConst.STR_BUF_CAP)
        JSRTState.str_pos = 0

        // Native function table: 64 * 24 = 1536 bytes
        nat_sz = Multiply(JSRTConst.MAX_NATIVES, JSRTConst.NATIVE_SIZE)
        JSRTState.native_table = Allocate(nat_sz)
        MemorySet(JSRTState.native_table, 0, nat_sz)
        JSRTState.native_count = 0

        // Timer queue: 32 * 32 = 1024 bytes
        tim_sz = Multiply(JSRTConst.MAX_TIMERS, JSRTConst.TIMER_SIZE)
        JSRTState.timer_pool = Allocate(tim_sz)
        MemorySet(JSRTState.timer_pool, 0, tim_sz)
        JSRTState.timer_count = 0
        JSRTState.next_timer_id = 1

        // Runtime frame stack (2048 entries x 8 bytes)
        JSRTStack.pool = Allocate(16384)
        MemorySet(JSRTStack.pool, 0, 16384)
        JSRTStack.capacity = 2048
        JSRTStack.sp = 0

        // Property tables (FixedPool slab + global hash)
        PropTable_Init()

        // ─── Create singleton: undefined ───
        uv = JSRT__AllocValue()
        StoreValue(uv, JSType.UNDEFINED)
        StoreValue(Add(uv, 8), 0)
        JSRTState.undef_val = uv

        // ─── Create singleton: null ───
        nv = JSRT__AllocValue()
        StoreValue(nv, JSType.NULL)
        StoreValue(Add(nv, 8), 0)
        JSRTState.null_val = nv

        // ─── Create singleton: true ───
        tv = JSRT__AllocValue()
        StoreValue(tv, JSType.BOOLEAN)
        StoreValue(Add(tv, 8), 1)
        JSRTState.true_val = tv

        // ─── Create singleton: false ───
        fv = JSRT__AllocValue()
        StoreValue(fv, JSType.BOOLEAN)
        StoreValue(Add(fv, 8), 0)
        JSRTState.false_val = fv

        // ─── String data slab (512KB bump allocator, wraps at capacity) ───
        // MUST be before any JSRT_CreateString calls (cached constants below)
        JSRTState.str_slab_cap = 2097152
        JSRTState.str_slab = Allocate(2097152)
        MemorySet(JSRTState.str_slab, 0, 2097152)
        JSRTState.str_slab_pos = 0

        // ─── Function descriptor slab (64KB = 1024 × 64-byte descriptors) ───
        JSRTState.func_slab_cap = 262144
        JSRTState.func_slab = Allocate(262144)
        MemorySet(JSRTState.func_slab, 0, 262144)
        JSRTState.func_slab_pos = 0

        // ─── Static conversion buffers (no per-call Allocate) ───
        JSRTState.int_buf = Allocate(24)
        MemorySet(JSRTState.int_buf, 0, 24)
        JSRTState.int_tmp = Allocate(24)
        MemorySet(JSRTState.int_tmp, 0, 24)
        JSRTState.float_buf = Allocate(48)
        MemorySet(JSRTState.float_buf, 0, 48)

        // ─── Cached ToString constants (allocated once, never freed) ───
        JSRTState.str_undefined = JSRT_CreateString("undefined")
        JSRTState.str_null = JSRT_CreateString("null")
        JSRTState.str_true = JSRT_CreateString("true")
        JSRTState.str_false = JSRT_CreateString("false")
        JSRTState.str_objobj = JSRT_CreateString("[object Object]")
        JSRTState.str_function = JSRT_CreateString("[function]")

        // ─── Cached typeof result strings (allocated once) ───
        JSRTState.str_typeof_undefined = JSRT_CreateString("undefined")
        JSRTState.str_typeof_object = JSRT_CreateString("object")
        JSRTState.str_typeof_boolean = JSRT_CreateString("boolean")
        JSRTState.str_typeof_number = JSRT_CreateString("number")
        JSRTState.str_typeof_string = JSRT_CreateString("string")
        JSRTState.str_typeof_function = JSRT_CreateString("function")

        // ─── Static work buffer for string methods (4KB, reused) ───
        JSRTState.str_work_buf = Allocate(4096)
        MemorySet(JSRTState.str_work_buf, 0, 4096)

        // ─── Static lexer string buffer (4KB, reused by ScanString/ScanTemplate) ───
        JSRTState.str_lex_buf = Allocate(65536)
        MemorySet(JSRTState.str_lex_buf, 0, 65536)

        // ─── Generator slab (512KB bump allocator) ───
        JSRT__GenSlabInit()

        ReturnValue(1)
    }
}


// =============================================================================
// SLAB BUMP ALLOCATORS
// =============================================================================

// Bump-allocate `sz` bytes from the string data slab. Wraps at capacity.
Function.JSRT__StrSlabAlloc {
    Input: sz: Integer
    Output: Address
    Body: {
        save_sz = sz
        pos = JSRTState.str_slab_pos
        addr = Add(JSRTState.str_slab, pos)
        new_pos = Add(pos, save_sz)
        IfCondition GreaterEqual(new_pos, JSRTState.str_slab_cap) ThenBlock: {
            // Wrap around
            addr = JSRTState.str_slab
            new_pos = save_sz
        }
        JSRTState.str_slab_pos = new_pos
        ReturnValue(addr)
    }
}

// Bump-allocate a 64-byte function descriptor from the func slab. Wraps at capacity.
Function.JSRT__FuncSlabAlloc {
    Output: Address
    Body: {
        pos = JSRTState.func_slab_pos
        addr = Add(JSRTState.func_slab, pos)
        new_pos = Add(pos, JSRTConst.FUNC_DESC_SZ)
        IfCondition GreaterEqual(new_pos, JSRTState.func_slab_cap) ThenBlock: {
            addr = JSRTState.func_slab
            new_pos = JSRTConst.FUNC_DESC_SZ
        }
        JSRTState.func_slab_pos = new_pos
        ReturnValue(addr)
    }
}

// =============================================================================
// VALUE CREATION
// =============================================================================

// Create a NUMBER JSValue from an integer. Converts to IEEE 754 double bits.
Function.JSRT_CreateNumber {
    Input: n: Integer
    Output: Address
    Body: {
        save_n = n
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(val, JSType.NUMBER)
        fbits = Float_FromInt(save_n)
        StoreValue(Add(val, 8), fbits)
        ReturnValue(val)
    }
}

// Create a NUMBER JSValue from raw IEEE 754 double bits (no conversion).
Function.JSRT_CreateFloat {
    Input: bits: Integer
    Output: Address
    Body: {
        save_bits = bits
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(val, JSType.NUMBER)
        StoreValue(Add(val, 8), save_bits)
        ReturnValue(val)
    }
}

// Create a STRING JSValue. Copies the string so the value owns its data.
// ptr must be a null-terminated string. Returns pointer to JSValue.
// Uses str_slab bump allocator — no per-call Allocate.
Function.JSRT_CreateString {
    Input: ptr: Address
    Output: Address
    Body: {
        save_ptr = ptr
        IfCondition EqualTo(save_ptr, 0) ThenBlock: {
            // Null pointer — create empty string
            val = JSRT__AllocValue()
            IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
            empty = JSRT__StrSlabAlloc(1)
            SetByte(empty, 0, 0)
            StoreValue(val, JSType.STRING)
            StoreValue(Add(val, 8), empty)
            ReturnValue(val)
        }
        slen = StringLength(save_ptr)
        buf_sz = Add(slen, 1)
        buf = JSRT__StrSlabAlloc(buf_sz)
        MemoryCopy(buf, save_ptr, slen)
        SetByte(buf, slen, 0)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.STRING)
        StoreValue(Add(val, 8), buf)
        ReturnValue(val)
    }
}

// Create a STRING JSValue from a pointer and length (not necessarily null-terminated).
// Uses str_slab bump allocator — no per-call Allocate.
Function.JSRT_CreateStringLen {
    Input: ptr: Address
    Input: len: Integer
    Output: Address
    Body: {
        save_ptr = ptr
        save_len = len
        buf_sz = Add(save_len, 1)
        buf = JSRT__StrSlabAlloc(buf_sz)
        IfCondition GreaterThan(save_len, 0) ThenBlock: {
            MemoryCopy(buf, save_ptr, save_len)
        }
        SetByte(buf, save_len, 0)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.STRING)
        StoreValue(Add(val, 8), buf)
        ReturnValue(val)
    }
}

// Create a BOOLEAN JSValue. Returns singleton true_val or false_val.
Function.JSRT_CreateBool {
    Input: b: Integer
    Output: Address
    Body: {
        IfCondition NotEqual(b, 0) ThenBlock: {
            ReturnValue(JSRTState.true_val)
        }
        ReturnValue(JSRTState.false_val)
    }
}

// Create an OBJECT JSValue. Uses XSHash for property storage.
// Returns pointer to JSValue.
Function.JSRT_CreateObject {
    Output: Address
    Body: {
        ptable = PropTable_Alloc()
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.OBJECT)
        StoreValue(Add(val, 8), ptable)
        ReturnValue(val)
    }
}

// Create an ARRAY JSValue. Uses XArray for element storage.
// Returns pointer to JSValue.
Function.JSRT_CreateArray {
    Output: Address
    Body: {
        arr = Array.Create(16)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.ARRAY)
        StoreValue(Add(val, 8), arr)
        ReturnValue(val)
    }
}

// Create a FUNCTION JSValue. Allocates a 48-byte function descriptor.
// bc_off = bytecode offset, params = param count, locals = local count,
// name = pointer to name string (null-terminated).
Function.JSRT_CreateFunc {
    Input: bc_off: Integer
    Input: params: Integer
    Input: locals: Integer
    Input: name: Address
    Output: Address
    Body: {
        save_bc = bc_off
        save_params = params
        save_locals = locals
        save_name = name
        // Bump-allocate 64-byte function descriptor from func slab
        desc = JSRT__FuncSlabAlloc()
        MemorySet(desc, 0, JSRTConst.FUNC_DESC_SZ)
        // Offset 0: bytecode_offset
        StoreValue(desc, save_bc)
        // Offset 8: param_count
        StoreValue(Add(desc, 8), save_params)
        // Offset 16: local_count
        StoreValue(Add(desc, 16), save_locals)
        // Offset 24: name_ptr
        StoreValue(Add(desc, 24), save_name)
        // Offset 32: name_len
        IfCondition NotEqual(save_name, 0) ThenBlock: {
            nlen = StringLength(save_name)
            StoreValue(Add(desc, 32), nlen)
        }
        // Offset 40: closure_env (0 for now)
        StoreValue(Add(desc, 40), 0)

        // Offset 48: auto-create .prototype object (ES spec: every function gets one)
        proto_obj = JSRT_CreateObject()
        StoreValue(Add(desc, 48), proto_obj)

        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.FUNCTION)
        StoreValue(Add(val, 8), desc)

        // Set prototype.constructor = this function
        JSRT_ObjSet(proto_obj, "constructor", val)

        ReturnValue(val)
    }
}

// =============================================================================
// VALUE ACCESS
// =============================================================================

// Get the type tag of a JSValue. Returns JSType constant.
Function.JSRT_GetType {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(JSType.UNDEFINED)
        }
        ReturnValue(Dereference(save_val))
    }
}

// Get the payload of a JSValue (raw 8-byte value at offset 8).
Function.JSRT_GetPayload {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Dereference(Add(save_val, 8)))
    }
}

// =============================================================================
// TRUTHINESS — JSRT_IsTruthy
// undefined=false, null=false, false=false, 0=false, ""=false, else=true
// =============================================================================
Function.JSRT_IsTruthy {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(0)
        }
        vtype = Dereference(save_val)
        // undefined -> false
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(0)
        }
        // null -> false
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            ReturnValue(0)
        }
        // boolean -> check payload
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            bval = Dereference(Add(save_val, 8))
            IfCondition EqualTo(bval, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // number -> +0, -0, NaN are false (IEEE 754 double bits)
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            nbits = Dereference(Add(save_val, 8))
            // +0 and -0 are falsy: Float_Eq handles both ±0
            is_zero = Float_Eq(nbits, Float_FromInt(0))
            IfCondition EqualTo(is_zero, 1) ThenBlock: {
                ReturnValue(0)
            }
            // NaN is falsy: NaN != NaN
            is_nan = Float_Ne(nbits, nbits)
            IfCondition EqualTo(is_nan, 1) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // string -> "" is false
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            sptr = Dereference(Add(save_val, 8))
            IfCondition EqualTo(sptr, 0) ThenBlock: {
                ReturnValue(0)
            }
            first_ch = GetByte(sptr, 0)
            IfCondition EqualTo(first_ch, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // object, array, function -> always truthy
        ReturnValue(1)
    }
}
