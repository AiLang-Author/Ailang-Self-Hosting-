// Library.JSRuntime.ailang — JavaScript runtime value system
// Handles: value creation (numbers, strings, booleans, null, undefined, objects,
// arrays, functions), type coercion (ToNumber, ToString, ToBool), comparison
// semantics (strict and abstract equality), built-in object stubs (console, Math),
// native function dispatch table, and timer queue (setTimeout/setInterval).
//
// CLOBBER SAFETY: Every function saves Input params to locals on the FIRST
// line of Body. Complex expressions broken into steps. JSRTTmp fields
// guarded with push/pop across recursive calls.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.Hash

LibraryImport.Browser.JSRuntime.JSRTCoerce
LibraryImport.Browser.JSRuntime.JSRTObject
LibraryImport.Browser.JSRuntime.PropTable
LibraryImport.Browser.JSRegex

// =============================================================================
// VALUE TYPE CONSTANTS
// =============================================================================
FixedPool.JSType {
    "UNDEFINED":  Initialize=0
    "NULL":       Initialize=1
    "BOOLEAN":    Initialize=2
    "NUMBER":     Initialize=3
    "STRING":     Initialize=4
    "OBJECT":     Initialize=5
    "FUNCTION":   Initialize=6
    "ARRAY":      Initialize=7
    "GENERATOR":  Initialize=8
}

// =============================================================================
// RUNTIME CONSTANTS
// =============================================================================
FixedPool.JSRTConst {
    "VAL_SIZE":      Initialize=16
    "MAX_VALUES":    Initialize=4194304
    "MAX_NATIVES":   Initialize=64
    "MAX_TIMERS":    Initialize=32
    "TIMER_SIZE":    Initialize=32
    "NATIVE_SIZE":   Initialize=24
    // 0 bc, 8 params, 16 locals, 24 name, 32 name_len, 40 env,
    // 48 prototype, 56 __super__, 64 prop_table, 72 body_start, 80 es_length
    // +96: M71 body lex-names blob (var vs body let/const)
    // +104: M71 param-names blob (var vs formal during default init)
    // +112: M81 own_code (0 = use global JSVMState.code)
    // +120: M81 own_code_len
    // +128: M81 own_const_pool
    // +136: M81 own_const_count
    "FUNC_DESC_SZ":  Initialize=144
    "STR_BUF_CAP":   Initialize=65536
    // Property values + globals that must outlive function frames (no GC yet)
    "MAX_GVALS":     Initialize=524288
}

// =============================================================================
// RUNTIME STATE
// =============================================================================
FixedPool.JSRTState {
    "val_pool":      Initialize=0
    "val_count":     Initialize=0
    "undef_val":     Initialize=0
    "null_val":      Initialize=0
    "true_val":      Initialize=0
    "false_val":     Initialize=0
    "native_table":  Initialize=0
    "native_count":  Initialize=0
    "timer_pool":    Initialize=0
    "timer_count":   Initialize=0
    "next_timer_id": Initialize=1
    "str_buf":       Initialize=0
    "str_pos":       Initialize=0
    "int_buf":       Initialize=0
    "int_tmp":       Initialize=0
    "float_buf":     Initialize=0
    "str_undefined": Initialize=0
    "str_null":      Initialize=0
    "str_true":      Initialize=0
    "str_false":     Initialize=0
    "str_objobj":    Initialize=0
    "str_function":  Initialize=0
    "str_typeof_undefined": Initialize=0
    "str_typeof_object":    Initialize=0
    "str_typeof_boolean":   Initialize=0
    "str_typeof_number":    Initialize=0
    "str_typeof_string":    Initialize=0
    "str_typeof_function":  Initialize=0
    "str_typeof_symbol":    Initialize=0
    "str_work_buf":         Initialize=0
    "str_lex_buf":          Initialize=0
    "str_slab":             Initialize=0
    "str_slab_pos":         Initialize=0
    "str_slab_cap":         Initialize=0
    "func_slab":            Initialize=0
    "func_slab_pos":        Initialize=0
    "func_slab_cap":        Initialize=0
    "oom":                  Initialize=0, CanChange=True
    "gval_pool":            Initialize=0
    "gval_count":           Initialize=0
    // Intrinsic prototypes for instanceof + default [[Prototype]]
    "object_proto":         Initialize=0
    "array_proto":          Initialize=0
    "function_proto":       Initialize=0
    // M88: GeneratorFunction.prototype + Generator.prototype
    "generator_function_proto": Initialize=0
    "generator_proto":      Initialize=0
    // M92: Promise.prototype for instanceof + async return [[Prototype]]
    "promise_proto":        Initialize=0
    // Shared Array.prototype.values / @@iterator (Mole 16)
    "array_values":         Initialize=0
    // M29c: array hole sentinel (distinct from undef_val)
    "hole_val":             Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.JSRTTmp {
    "idx":       Initialize=0
    "type":      Initialize=0
    "ptr":       Initialize=0
    "len":       Initialize=0
    "val":       Initialize=0
    "addr":      Initialize=0
    "done":      Initialize=0
    "count":     Initialize=0
    "a_type":    Initialize=0
    "b_type":    Initialize=0
    "a_pay":     Initialize=0
    "b_pay":     Initialize=0
    "result":    Initialize=0
    "buf":       Initialize=0
    "digit":     Initialize=0
    "neg":       Initialize=0
    "pos":       Initialize=0
    "ch":        Initialize=0
}

// =============================================================================
// RUNTIME STACK — push/pop for recursive calls
// =============================================================================
FixedPool.JSRTStack {
    "pool":       Initialize=0
    "sp":         Initialize=0
    "capacity":   Initialize=0
    "tmp_val":    Initialize=0
    "tmp_addr":   Initialize=0
}

// =============================================================================
// STACK PUSH / POP
// =============================================================================
Function.JSRT__Push {
    Input: val: Integer
    Output: Integer
    Body: {
        JSRTStack.tmp_val = val
        JSRTStack.tmp_addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(JSRTStack.tmp_addr, JSRTStack.tmp_val)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        ReturnValue(0)
    }
}

Function.JSRT__Pop {
    Output: Integer
    Body: {
        JSRTStack.sp = Subtract(JSRTStack.sp, 1)
        ReturnValue(Dereference(Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))))
    }
}

// =============================================================================
// VALUE POOL ALLOCATION — allocate a new 16-byte JSValue from pool
// Returns pointer to the new JSValue, or 0 on overflow
// =============================================================================
Function.JSRT__AllocValue {
    Output: Address
    Body: {
        IfCondition GreaterEqual(JSRTState.val_count, JSRTConst.MAX_VALUES) ThenBlock: {
            // Out of value pool — signal OOM instead of wrapping and
            // corrupting live values.  The VM dispatch loop checks
            // JSRTState.oom on every step and aborts cleanly.
            JSRTState.oom = 1
            ReturnValue(0)
        }
        offset = Multiply(JSRTState.val_count, JSRTConst.VAL_SIZE)
        addr = Add(JSRTState.val_pool, offset)
        JSRTState.val_count = Add(JSRTState.val_count, 1)
        ReturnValue(addr)
    }
}


// =============================================================================
// GLOBAL VALUE POOL — persistent allocation NOT subject to scope reclamation.
// Used by JSVM__SetGlobal so that values stored in the global hash survive
// function-return watermark rollback.
// =============================================================================
Function.JSRT__AllocGlobalValue {
    Output: Address
    Body: {
        IfCondition GreaterEqual(JSRTState.gval_count, JSRTConst.MAX_GVALS) ThenBlock: {
            JSRTState.oom = 1
            ReturnValue(0)
        }
        offset = Multiply(JSRTState.gval_count, JSRTConst.VAL_SIZE)
        addr = Add(JSRTState.gval_pool, offset)
        JSRTState.gval_count = Add(JSRTState.gval_count, 1)
        ReturnValue(addr)
    }
}

// =============================================================================
// INIT — create singletons, native table, timer queue, stacks
// =============================================================================
Function.JSRT_Init {
    Output: Integer
    Body: {
        // Value pool: 8192 * 16 = 131072 bytes
        pool_sz = Multiply(JSRTConst.MAX_VALUES, JSRTConst.VAL_SIZE)
        JSRTState.val_pool = Allocate(pool_sz)
        MemorySet(JSRTState.val_pool, 0, pool_sz)
        JSRTState.val_count = 0

        // Global value pool: persistent storage for global hash values
        // NOT subject to scope reclamation watermark rollback.
        gpool_sz = Multiply(JSRTConst.MAX_GVALS, JSRTConst.VAL_SIZE)
        JSRTState.gval_pool = Allocate(gpool_sz)
        MemorySet(JSRTState.gval_pool, 0, gpool_sz)
        JSRTState.gval_count = 0

        // String buffer for ToString conversions
        JSRTState.str_buf = Allocate(JSRTConst.STR_BUF_CAP)
        MemorySet(JSRTState.str_buf, 0, JSRTConst.STR_BUF_CAP)
        JSRTState.str_pos = 0

        // Native function table: 64 * 24 = 1536 bytes
        nat_sz = Multiply(JSRTConst.MAX_NATIVES, JSRTConst.NATIVE_SIZE)
        JSRTState.native_table = Allocate(nat_sz)
        MemorySet(JSRTState.native_table, 0, nat_sz)
        JSRTState.native_count = 0

        // Timer queue: 32 * 32 = 1024 bytes
        tim_sz = Multiply(JSRTConst.MAX_TIMERS, JSRTConst.TIMER_SIZE)
        JSRTState.timer_pool = Allocate(tim_sz)
        MemorySet(JSRTState.timer_pool, 0, tim_sz)
        JSRTState.timer_count = 0
        JSRTState.next_timer_id = 1

        // Runtime frame stack (2048 entries x 8 bytes)
        JSRTStack.pool = Allocate(16384)
        MemorySet(JSRTStack.pool, 0, 16384)
        JSRTStack.capacity = 2048
        JSRTStack.sp = 0

        // Property tables (FixedPool slab + global hash)
        PropTable_Init()

        // ─── Create singleton: undefined ───
        uv = JSRT__AllocValue()
        StoreValue(uv, JSType.UNDEFINED)
        StoreValue(Add(uv, 8), 0)
        JSRTState.undef_val = uv

        // M29c: array hole sentinel (type UNDEFINED, distinct pointer)
        hv = JSRT__AllocValue()
        StoreValue(hv, JSType.UNDEFINED)
        StoreValue(Add(hv, 8), 1)
        JSRTState.hole_val = hv

        // ─── Create singleton: null ───
        nv = JSRT__AllocValue()
        StoreValue(nv, JSType.NULL)
        StoreValue(Add(nv, 8), 0)
        JSRTState.null_val = nv

        // ─── Create singleton: true ───
        tv = JSRT__AllocValue()
        StoreValue(tv, JSType.BOOLEAN)
        StoreValue(Add(tv, 8), 1)
        JSRTState.true_val = tv

        // ─── Create singleton: false ───
        fv = JSRT__AllocValue()
        StoreValue(fv, JSType.BOOLEAN)
        StoreValue(Add(fv, 8), 0)
        JSRTState.false_val = fv

        // ─── String data slab (16MB bump allocator, OOM on exhaustion) ───
        // MUST be before any JSRT_CreateString calls (cached constants below)
        JSRTState.str_slab_cap = 16777216
        JSRTState.str_slab = Allocate(16777216)
        MemorySet(JSRTState.str_slab, 0, 16777216)
        JSRTState.str_slab_pos = 0

        // ─── Function descriptor slab (8MB = ~116508 × 72-byte descriptors) ───
        JSRTState.func_slab_cap = 8388608
        JSRTState.func_slab = Allocate(8388608)
        MemorySet(JSRTState.func_slab, 0, 8388608)
        JSRTState.func_slab_pos = 0

        // ─── Static conversion buffers (no per-call Allocate) ───
        JSRTState.int_buf = Allocate(24)
        MemorySet(JSRTState.int_buf, 0, 24)
        JSRTState.int_tmp = Allocate(24)
        MemorySet(JSRTState.int_tmp, 0, 24)
        JSRTState.float_buf = Allocate(96)
        MemorySet(JSRTState.float_buf, 0, 96)

        // ─── Cached ToString constants (allocated once, never freed) ───
        JSRTState.str_undefined = JSRT_CreateString("undefined")
        JSRTState.str_null = JSRT_CreateString("null")
        JSRTState.str_true = JSRT_CreateString("true")
        JSRTState.str_false = JSRT_CreateString("false")
        JSRTState.str_objobj = JSRT_CreateString("[object Object]")
        JSRTState.str_function = JSRT_CreateString("[function]")

        // ─── Cached typeof result strings (allocated once) ───
        JSRTState.str_typeof_undefined = JSRT_CreateString("undefined")
        JSRTState.str_typeof_object = JSRT_CreateString("object")
        JSRTState.str_typeof_boolean = JSRT_CreateString("boolean")
        JSRTState.str_typeof_number = JSRT_CreateString("number")
        JSRTState.str_typeof_string = JSRT_CreateString("string")
        JSRTState.str_typeof_function = JSRT_CreateString("function")
        JSRTState.str_typeof_symbol = JSRT_CreateString("symbol")

        // ─── Static work buffer for string methods (4KB, reused) ───
        JSRTState.str_work_buf = Allocate(4096)
        MemorySet(JSRTState.str_work_buf, 0, 4096)

        // ─── Static lexer string buffer (4KB, reused by ScanString/ScanTemplate) ───
        JSRTState.str_lex_buf = Allocate(65536)
        MemorySet(JSRTState.str_lex_buf, 0, 65536)

        // ─── Generator slab (512KB bump allocator) ───
        JSRT__GenSlabInit()

        ReturnValue(1)
    }
}


// =============================================================================
// SLAB BUMP ALLOCATORS
// =============================================================================

// Bump-allocate `sz` bytes from the string data slab.
// Returns 0 and sets OOM flag on exhaustion instead of wrapping.
Function.JSRT__StrSlabAlloc {
    Input: sz: Integer
    Output: Address
    Body: {
        save_sz = sz
        pos = JSRTState.str_slab_pos
        new_pos = Add(pos, save_sz)
        IfCondition GreaterEqual(new_pos, JSRTState.str_slab_cap) ThenBlock: {
            JSRTState.oom = 1
            ReturnValue(0)
        }
        addr = Add(JSRTState.str_slab, pos)
        JSRTState.str_slab_pos = new_pos
        ReturnValue(addr)
    }
}

// Bump-allocate a 64-byte function descriptor from the func slab.
// Returns 0 and sets OOM flag on exhaustion instead of wrapping.
Function.JSRT__FuncSlabAlloc {
    Output: Address
    Body: {
        pos = JSRTState.func_slab_pos
        new_pos = Add(pos, JSRTConst.FUNC_DESC_SZ)
        IfCondition GreaterEqual(new_pos, JSRTState.func_slab_cap) ThenBlock: {
            JSRTState.oom = 1
            ReturnValue(0)
        }
        addr = Add(JSRTState.func_slab, pos)
        JSRTState.func_slab_pos = new_pos
        ReturnValue(addr)
    }
}

// =============================================================================
// VALUE CREATION
// =============================================================================

// Create a NUMBER JSValue from an integer. Converts to IEEE 754 double bits.
Function.JSRT_CreateNumber {
    Input: n: Integer
    Output: Address
    Body: {
        save_n = n
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(val, JSType.NUMBER)
        fbits = Float_FromInt(save_n)
        StoreValue(Add(val, 8), fbits)
        ReturnValue(val)
    }
}

// Create a NUMBER JSValue from raw IEEE 754 double bits (no conversion).
Function.JSRT_CreateFloat {
    Input: bits: Integer
    Output: Address
    Body: {
        save_bits = bits
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(val, JSType.NUMBER)
        StoreValue(Add(val, 8), save_bits)
        ReturnValue(val)
    }
}

// =============================================================================
// M31a P0: JS strings are magic-headered UTF-16 code units
// Layout at payload:
//   +0  (8)  magic 0x31553616 ("U16\x16") — distinguishes from C keys
//   +8  (8)  length in code units
//   +16 (2*N) UTF-16LE code units
//   +16+2N (2) trailing 0 unit
// Property-table keys remain C strings (no magic).
// =============================================================================

FixedPool.JSRTStr {
    "MAGIC": Initialize=827543574
    // 0x31553616 little-endian-ish unique tag
}

// 1 if payload is a headered JS string
Function.JSRT_StrIsJS {
    Input: p: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Dereference(p), JSRTStr.MAGIC) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Code-unit length of a JS string payload (0 if null). C strings: StringLength.
Function.JSRT_StrLen {
    Input: p: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_StrIsJS(p), 1) ThenBlock: {
            ReturnValue(Dereference(Add(p, 8)))
        }
        // C string fallback (property keys etc.)
        ReturnValue(StringLength(p))
    }
}

// Code unit at index i (0 if OOB).
Function.JSRT_StrUnit {
    Input: p: Address
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_StrIsJS(p), 1) ThenBlock: {
            n = Dereference(Add(p, 8))
            IfCondition GreaterEqual(i, n) ThenBlock: { ReturnValue(0) }
            off = Add(16, Multiply(i, 2))
            lo = GetByte(p, off)
            hi = GetByte(p, Add(off, 1))
            ReturnValue(Add(lo, Multiply(hi, 256)))
        }
        // C string: one byte per unit
        ch = GetByte(p, i)
        ReturnValue(ch)
    }
}

// Total bytes of payload allocation (header + units + trailing 0).
Function.JSRT_StrByteSize {
    Input: p: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_StrIsJS(p), 1) ThenBlock: {
            n = Dereference(Add(p, 8))
            // 16 header + 2*n + 2 null
            ReturnValue(Add(18, Multiply(n, 2)))
        }
        ReturnValue(Add(StringLength(p), 1))
    }
}

// Pointer to raw UTF-16LE unit bytes (past header). C strings: same ptr.
Function.JSRT_StrData {
    Input: p: Address
    Output: Address
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSRT_StrIsJS(p), 1) ThenBlock: {
            ReturnValue(Add(p, 16))
        }
        ReturnValue(p)
    }
}

// Allocate empty headered buffer with `n` code units (uninitialized units).
Function.JSRT_StrAlloc {
    Input: n: Integer
    Output: Address
    Body: {
        save_n = n
        IfCondition LessThan(save_n, 0) ThenBlock: { save_n = 0 }
        buf_sz = Add(18, Multiply(save_n, 2))
        buf = JSRT__StrSlabAlloc(buf_sz)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(buf, JSRTStr.MAGIC)
        StoreValue(Add(buf, 8), save_n)
        // trailing null unit
        SetByte(buf, Add(16, Multiply(save_n, 2)), 0)
        SetByte(buf, Add(17, Multiply(save_n, 2)), 0)
        ReturnValue(buf)
    }
}

// Write code unit at index.
Function.JSRT_StrSetUnit {
    Input: p: Address
    Input: i: Integer
    Input: u: Integer
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        off = Add(16, Multiply(i, 2))
        SetByte(p, off, BitwiseAnd(u, 255))
        SetByte(p, Add(off, 1), BitwiseAnd(Divide(u, 256), 255))
        ReturnValue(1)
    }
}

// Create JS string from a C/byte buffer.
// M37: UTF-8 decode → UTF-16 code units (invalid sequences → Latin-1 byte).
// ASCII and pure Latin-1 high bytes still work; multi-byte UTF-8 (and
// lexer-emitted UTF-8 for \uXXXX) become correct code units.
Function.JSRT_CreateString {
    Input: ptr: Address
    Output: Address
    Body: {
        save_ptr = ptr
        IfCondition EqualTo(save_ptr, 0) ThenBlock: {
            val = JSRT__AllocValue()
            IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
            empty = JSRT_StrAlloc(0)
            IfCondition EqualTo(empty, 0) ThenBlock: { ReturnValue(0) }
            StoreValue(val, JSType.STRING)
            StoreValue(Add(val, 8), empty)
            ReturnValue(val)
        }
        // Already a headered JS string — clone
        IfCondition EqualTo(JSRT_StrIsJS(save_ptr), 1) ThenBlock: {
            ReturnValue(JSRT_CreateStringSlice(save_ptr, 0, JSRT_StrLen(save_ptr)))
        }
        slen = StringLength(save_ptr)
        // upper bound: one unit per byte (or 2 for rare 4-byte → surrogate pair, still ≤ slen? 
        // 4-byte UTF-8 → 2 units, so units ≤ slen always for valid UTF-8; invalid also 1:1)
        // Surrogate pair: 4 bytes → 2 units. Max units = slen.
        buf = JSRT_StrAlloc(slen)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        ui = 0
        WhileLoop LessThan(i, slen) {
            b0 = GetByte(save_ptr, i)
            // ASCII
            IfCondition LessThan(b0, 128) ThenBlock: {
                JSRT_StrSetUnit(buf, ui, b0)
                ui = Add(ui, 1)
                i = Add(i, 1)
            } ElseBlock: {
                // 2-byte UTF-8: 110xxxxx 10xxxxxx
                IfCondition And(EqualTo(BitwiseAnd(b0, 224), 192), LessThan(Add(i, 1), slen)) ThenBlock: {
                    b1 = GetByte(save_ptr, Add(i, 1))
                    IfCondition EqualTo(BitwiseAnd(b1, 192), 128) ThenBlock: {
                        cp = Add(ShiftLeft(BitwiseAnd(b0, 31), 6), BitwiseAnd(b1, 63))
                        // overlong / invalid → Latin-1 fallback
                        IfCondition GreaterEqual(cp, 128) ThenBlock: {
                            JSRT_StrSetUnit(buf, ui, cp)
                            ui = Add(ui, 1)
                            i = Add(i, 2)
                        } ElseBlock: {
                            JSRT_StrSetUnit(buf, ui, b0)
                            ui = Add(ui, 1)
                            i = Add(i, 1)
                        }
                    } ElseBlock: {
                        JSRT_StrSetUnit(buf, ui, b0)
                        ui = Add(ui, 1)
                        i = Add(i, 1)
                    }
                } ElseBlock: {
                    // 3-byte UTF-8: 1110xxxx 10xxxxxx 10xxxxxx
                    IfCondition And(EqualTo(BitwiseAnd(b0, 240), 224), LessThan(Add(i, 2), slen)) ThenBlock: {
                        b1 = GetByte(save_ptr, Add(i, 1))
                        b2 = GetByte(save_ptr, Add(i, 2))
                        IfCondition And(EqualTo(BitwiseAnd(b1, 192), 128), EqualTo(BitwiseAnd(b2, 192), 128)) ThenBlock: {
                            cp = Add(Add(ShiftLeft(BitwiseAnd(b0, 15), 12), ShiftLeft(BitwiseAnd(b1, 63), 6)), BitwiseAnd(b2, 63))
                            IfCondition GreaterEqual(cp, 2048) ThenBlock: {
                                JSRT_StrSetUnit(buf, ui, cp)
                                ui = Add(ui, 1)
                                i = Add(i, 3)
                            } ElseBlock: {
                                JSRT_StrSetUnit(buf, ui, b0)
                                ui = Add(ui, 1)
                                i = Add(i, 1)
                            }
                        } ElseBlock: {
                            JSRT_StrSetUnit(buf, ui, b0)
                            ui = Add(ui, 1)
                            i = Add(i, 1)
                        }
                    } ElseBlock: {
                        // 4-byte UTF-8 → surrogate pair
                        IfCondition And(EqualTo(BitwiseAnd(b0, 248), 240), LessThan(Add(i, 3), slen)) ThenBlock: {
                            b1 = GetByte(save_ptr, Add(i, 1))
                            b2 = GetByte(save_ptr, Add(i, 2))
                            b3 = GetByte(save_ptr, Add(i, 3))
                            IfCondition And(And(EqualTo(BitwiseAnd(b1, 192), 128), EqualTo(BitwiseAnd(b2, 192), 128)), EqualTo(BitwiseAnd(b3, 192), 128)) ThenBlock: {
                                cp = Add(Add(Add(ShiftLeft(BitwiseAnd(b0, 7), 18), ShiftLeft(BitwiseAnd(b1, 63), 12)), ShiftLeft(BitwiseAnd(b2, 63), 6)), BitwiseAnd(b3, 63))
                                IfCondition And(GreaterEqual(cp, 65536), LessThan(cp, 1114112)) ThenBlock: {
                                    adj = Subtract(cp, 65536)
                                    hi = Add(55296, ShiftRight(adj, 10))
                                    lo = Add(56320, BitwiseAnd(adj, 1023))
                                    JSRT_StrSetUnit(buf, ui, hi)
                                    ui = Add(ui, 1)
                                    JSRT_StrSetUnit(buf, ui, lo)
                                    ui = Add(ui, 1)
                                    i = Add(i, 4)
                                } ElseBlock: {
                                    JSRT_StrSetUnit(buf, ui, b0)
                                    ui = Add(ui, 1)
                                    i = Add(i, 1)
                                }
                            } ElseBlock: {
                                JSRT_StrSetUnit(buf, ui, b0)
                                ui = Add(ui, 1)
                                i = Add(i, 1)
                            }
                        } ElseBlock: {
                            // Latin-1 / invalid lead byte
                            JSRT_StrSetUnit(buf, ui, b0)
                            ui = Add(ui, 1)
                            i = Add(i, 1)
                        }
                    }
                }
            }
        }
        // fix unit count (may be < slen after multi-byte decode)
        StoreValue(Add(buf, 8), ui)
        SetByte(buf, Add(16, Multiply(ui, 2)), 0)
        SetByte(buf, Add(17, Multiply(ui, 2)), 0)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.STRING)
        StoreValue(Add(val, 8), buf)
        ReturnValue(val)
    }
}

// Create JS string from raw bytes as Latin-1 units (byte buffer + length).
Function.JSRT_CreateStringLen {
    Input: ptr: Address
    Input: len: Integer
    Output: Address
    Body: {
        save_ptr = ptr
        save_len = len
        IfCondition LessThan(save_len, 0) ThenBlock: { save_len = 0 }
        buf = JSRT_StrAlloc(save_len)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition And(GreaterThan(save_len, 0), NotEqual(save_ptr, 0)) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, save_len) {
                JSRT_StrSetUnit(buf, i, GetByte(save_ptr, i))
                i = Add(i, 1)
            }
        }
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.STRING)
        StoreValue(Add(val, 8), buf)
        ReturnValue(val)
    }
}

// Slice `len` code units starting at `start` from an existing JS string payload.
Function.JSRT_CreateStringSlice {
    Input: src: Address
    Input: start: Integer
    Input: len: Integer
    Output: Address
    Body: {
        save_src = src
        save_start = start
        save_len = len
        IfCondition LessThan(save_start, 0) ThenBlock: { save_start = 0 }
        IfCondition LessThan(save_len, 0) ThenBlock: { save_len = 0 }
        src_n = 0
        IfCondition NotEqual(save_src, 0) ThenBlock: { src_n = JSRT_StrLen(save_src) }
        IfCondition GreaterThan(save_start, src_n) ThenBlock: { save_start = src_n }
        IfCondition GreaterThan(Add(save_start, save_len), src_n) ThenBlock: {
            save_len = Subtract(src_n, save_start)
        }
        buf = JSRT_StrAlloc(save_len)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, save_len) {
            JSRT_StrSetUnit(buf, i, JSRT_StrUnit(save_src, Add(save_start, i)))
            i = Add(i, 1)
        }
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.STRING)
        StoreValue(Add(val, 8), buf)
        ReturnValue(val)
    }
}

// Deep-copy a headered JS string payload into str_slab.
Function.JSRT_StrClone {
    Input: p: Address
    Output: Address
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        n = JSRT_StrLen(p)
        sz = JSRT_StrByteSize(p)
        buf = JSRT__StrSlabAlloc(sz)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        MemoryCopy(buf, p, sz)
        ReturnValue(buf)
    }
}

// Print JS string payload to host (BMP latin-1 only; surrogates as '?').
Function.JSRT_PrintJSString {
    Input: p: Address
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        n = JSRT_StrLen(p)
        // Use work buf as temp C string for PrintString
        w = JSRTState.str_work_buf
        IfCondition EqualTo(w, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        oi = 0
        WhileLoop And(LessThan(i, n), LessThan(oi, 4000)) {
            u = JSRT_StrUnit(p, i)
            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
            SetByte(w, oi, u)
            oi = Add(oi, 1)
            i = Add(i, 1)
        }
        SetByte(w, oi, 0)
        PrintString(w)
        ReturnValue(1)
    }
}

// Copy `len` code units from src[start..] into dest as Latin-1 bytes at dest_off.
// Returns new dest_off + len. Units >255 become '?'.
Function.JSRT_StrEmit {
    Input: dest: Address
    Input: dest_off: Integer
    Input: src: Address
    Input: start: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(dest_off) }
        IfCondition Or(LessThan(len, 1), EqualTo(src, 0)) ThenBlock: { ReturnValue(dest_off) }
        i = 0
        WhileLoop LessThan(i, len) {
            u = JSRT_StrUnit(src, Add(start, i))
            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
            SetByte(dest, Add(dest_off, i), u)
            i = Add(i, 1)
        }
        ReturnValue(Add(dest_off, len))
    }
}

// Flatten JS UTF-16 (or C) payload to a new C/Latin-1 null-terminated buffer
// on str_slab. Used by DOM/regex/eval that still need byte strings.
// Returns pointer (or 0). Length is JSRT_StrLen(p).
Function.JSRT_StrToC {
    Input: p: Address
    Output: Address
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: {
            empty = JSRT__StrSlabAlloc(1)
            IfCondition EqualTo(empty, 0) ThenBlock: { ReturnValue(0) }
            SetByte(empty, 0, 0)
            ReturnValue(empty)
        }
        // Already a C string (no magic header)
        IfCondition EqualTo(JSRT_StrIsJS(p), 0) ThenBlock: {
            ReturnValue(p)
        }
        n = JSRT_StrLen(p)
        buf = JSRT__StrSlabAlloc(Add(n, 1))
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            u = JSRT_StrUnit(p, i)
            IfCondition GreaterThan(u, 255) ThenBlock: { u = 63 }
            SetByte(buf, i, u)
            i = Add(i, 1)
        }
        SetByte(buf, n, 0)
        ReturnValue(buf)
    }
}

// Create a BOOLEAN JSValue. Returns singleton true_val or false_val.
Function.JSRT_CreateBool {
    Input: b: Integer
    Output: Address
    Body: {
        IfCondition NotEqual(b, 0) ThenBlock: {
            ReturnValue(JSRTState.true_val)
        }
        ReturnValue(JSRTState.false_val)
    }
}

// Create an OBJECT JSValue. Uses XSHash for property storage.
// Returns pointer to JSValue.
Function.JSRT_CreateObject {
    Output: Address
    Body: {
        ptable = PropTable_Alloc()
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.OBJECT)
        StoreValue(Add(val, 8), ptable)
        // NOTE: Do NOT auto-set Object.prototype here — Object.prototype itself
        // is created via this function, and many internal objects (descriptors,
        // Error data) must not inherit user-visible Object.prototype props.
        // NEW_OBJECT / CONSTRUCT set [[Prototype]] explicitly.
        ReturnValue(val)
    }
}

// Create an ARRAY JSValue. Uses XArray for element storage.
// Returns pointer to JSValue. Sets [[Prototype]] to Array.prototype when installed.
Function.JSRT_CreateArray {
    Output: Address
    Body: {
        arr = Array.Create(16)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.ARRAY)
        StoreValue(Add(val, 8), arr)
        // Default [[Prototype]] for instanceof Array / method lookup later
        IfCondition NotEqual(JSRTState.array_proto, 0) ThenBlock: {
            JSRT_ObjSet(val, "__proto__", JSRTState.array_proto)
        }
        ReturnValue(val)
    }
}

// Create a FUNCTION JSValue. Allocates a 48-byte function descriptor.
// bc_off = bytecode offset, params = param count, locals = local count,
// name = pointer to name string (null-terminated).
Function.JSRT_CreateFunc {
    Input: bc_off: Integer
    Input: params: Integer
    Input: locals: Integer
    Input: name: Address
    Output: Address
    Body: {
        save_bc = bc_off
        save_params = params
        save_locals = locals
        save_name = name
        // Bump-allocate function descriptor from func slab
        desc = JSRT__FuncSlabAlloc()
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(desc, 0, JSRTConst.FUNC_DESC_SZ)
        // Offset 0: bytecode_offset
        StoreValue(desc, save_bc)
        // Offset 8: param_count
        StoreValue(Add(desc, 8), save_params)
        // Offset 16: local_count
        StoreValue(Add(desc, 16), save_locals)
        // Offset 24: name_ptr
        StoreValue(Add(desc, 24), save_name)
        // Offset 32: name_len
        IfCondition NotEqual(save_name, 0) ThenBlock: {
            nlen = StringLength(save_name)
            StoreValue(Add(desc, 32), nlen)
        }
        // Offset 40: closure_env (0 for now)
        StoreValue(Add(desc, 40), 0)

        // Offset 48: auto-create .prototype object (ES spec: every function gets one)
        proto_obj = JSRT_CreateObject()
        // Link Function.prototype → Object.prototype when available so
        // `new F() instanceof Object` works.
        IfCondition NotEqual(JSRTState.object_proto, 0) ThenBlock: {
            JSRT_ObjSet(proto_obj, "__proto__", JSRTState.object_proto)
        }
        StoreValue(Add(desc, 48), proto_obj)
        // Offset 56: __super__ (class extends) — leave 0
        // Offset 64: prop_table — leave 0 (lazy)
        // Offset 72: body_start (Mole 17 gen FDI) — set via FuncSetBodyStart
        StoreValue(Add(desc, 72), 0)
        // Offset 80: es_length (Function.length); -1 = use formal count
        formal_n = BitwiseAnd(save_params, 268435455)
        StoreValue(Add(desc, 80), formal_n)
        // Offset 88: is_class_ctor (1 = class constructor, bare call TypeError)
        StoreValue(Add(desc, 88), 0)

        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.FUNCTION)
        StoreValue(Add(val, 8), desc)

        // Set prototype.constructor = this function
        JSRT_ObjSet(proto_obj, "constructor", val)

        ReturnValue(val)
    }
}

// Mole 17: body bytecode start (after param init) for generator FDI-at-call
Function.JSRT_FuncSetBodyStart {
    Input: val: Address
    Input: body_pc: Integer
    Output: Integer
    Body: {
        save_val = val
        save_pc = body_pc
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dereference(save_val), JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(desc, 72), save_pc)
        ReturnValue(1)
    }
}

Function.JSRT_FuncGetBodyStart {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dereference(save_val), JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(desc, 72)))
    }
}

// =============================================================================
// VALUE ACCESS
// =============================================================================

// Get the type tag of a JSValue. Returns JSType constant.
Function.JSRT_GetType {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(JSType.UNDEFINED)
        }
        ReturnValue(Dereference(save_val))
    }
}

// Get the payload of a JSValue (raw 8-byte value at offset 8).
Function.JSRT_GetPayload {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Dereference(Add(save_val, 8)))
    }
}

// =============================================================================
// TRUTHINESS — JSRT_IsTruthy
// undefined=false, null=false, false=false, 0=false, ""=false, else=true
// =============================================================================
Function.JSRT_IsTruthy {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(0)
        }
        vtype = Dereference(save_val)
        // undefined -> false
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(0)
        }
        // null -> false
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            ReturnValue(0)
        }
        // boolean -> check payload
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            bval = Dereference(Add(save_val, 8))
            IfCondition EqualTo(bval, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // number -> +0, -0, NaN are false (IEEE 754 double bits)
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            nbits = Dereference(Add(save_val, 8))
            // +0 and -0 are falsy: Float_Eq handles both ±0
            is_zero = Float_Eq(nbits, Float_FromInt(0))
            IfCondition EqualTo(is_zero, 1) ThenBlock: {
                ReturnValue(0)
            }
            // NaN is falsy: NaN != NaN
            is_nan = Float_Ne(nbits, nbits)
            IfCondition EqualTo(is_nan, 1) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // string -> "" is false (M31a: use code-unit length)
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            sptr = Dereference(Add(save_val, 8))
            IfCondition EqualTo(sptr, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(JSRT_StrLen(sptr), 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // object, array, function -> always truthy
        ReturnValue(1)
    }
}
