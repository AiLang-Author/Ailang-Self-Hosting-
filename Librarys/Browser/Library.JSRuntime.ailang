// Library.JSRuntime.ailang — JavaScript runtime value system
// Handles: value creation (numbers, strings, booleans, null, undefined, objects,
// arrays, functions), type coercion (ToNumber, ToString, ToBool), comparison
// semantics (strict and abstract equality), built-in object stubs (console, Math),
// native function dispatch table, and timer queue (setTimeout/setInterval).
//
// CLOBBER SAFETY: Every function saves Input params to locals on the FIRST
// line of Body. Complex expressions broken into steps. JSRTTmp fields
// guarded with push/pop across recursive calls.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.XArrays
LibraryImport.StringUtils
LibraryImport.HashMap

// =============================================================================
// VALUE TYPE CONSTANTS
// =============================================================================
FixedPool.JSType {
    "UNDEFINED":  Initialize=0
    "NULL":       Initialize=1
    "BOOLEAN":    Initialize=2
    "NUMBER":     Initialize=3
    "STRING":     Initialize=4
    "OBJECT":     Initialize=5
    "FUNCTION":   Initialize=6
    "ARRAY":      Initialize=7
}

// =============================================================================
// RUNTIME CONSTANTS
// =============================================================================
FixedPool.JSRTConst {
    "VAL_SIZE":      Initialize=16
    "MAX_VALUES":    Initialize=8192
    "MAX_NATIVES":   Initialize=64
    "MAX_TIMERS":    Initialize=32
    "TIMER_SIZE":    Initialize=32
    "NATIVE_SIZE":   Initialize=24
    "FUNC_DESC_SZ":  Initialize=48
    "STR_BUF_CAP":   Initialize=65536
}

// =============================================================================
// RUNTIME STATE
// =============================================================================
FixedPool.JSRTState {
    "val_pool":      Initialize=0
    "val_count":     Initialize=0
    "undef_val":     Initialize=0
    "null_val":      Initialize=0
    "true_val":      Initialize=0
    "false_val":     Initialize=0
    "native_table":  Initialize=0
    "native_count":  Initialize=0
    "timer_pool":    Initialize=0
    "timer_count":   Initialize=0
    "next_timer_id": Initialize=1
    "str_buf":       Initialize=0
    "str_pos":       Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.JSRTTmp {
    "idx":       Initialize=0
    "type":      Initialize=0
    "ptr":       Initialize=0
    "len":       Initialize=0
    "val":       Initialize=0
    "addr":      Initialize=0
    "done":      Initialize=0
    "count":     Initialize=0
    "a_type":    Initialize=0
    "b_type":    Initialize=0
    "a_pay":     Initialize=0
    "b_pay":     Initialize=0
    "result":    Initialize=0
    "buf":       Initialize=0
    "digit":     Initialize=0
    "neg":       Initialize=0
    "pos":       Initialize=0
    "ch":        Initialize=0
}

// =============================================================================
// RUNTIME STACK — push/pop for recursive calls
// =============================================================================
FixedPool.JSRTStack {
    "pool":       Initialize=0
    "sp":         Initialize=0
    "capacity":   Initialize=0
    "tmp_val":    Initialize=0
    "tmp_addr":   Initialize=0
}

// =============================================================================
// STACK PUSH / POP
// =============================================================================
Function.JSRT__Push {
    Input: val: Integer
    Output: Integer
    Body: {
        JSRTStack.tmp_val = val
        JSRTStack.tmp_addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(JSRTStack.tmp_addr, JSRTStack.tmp_val)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        ReturnValue(0)
    }
}

Function.JSRT__Pop {
    Output: Integer
    Body: {
        JSRTStack.sp = Subtract(JSRTStack.sp, 1)
        ReturnValue(Dereference(Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))))
    }
}

// =============================================================================
// VALUE POOL ALLOCATION — allocate a new 16-byte JSValue from pool
// Returns pointer to the new JSValue, or 0 on overflow
// =============================================================================
Function.JSRT__AllocValue {
    Output: Address
    Body: {
        IfCondition GreaterEqual(JSRTState.val_count, JSRTConst.MAX_VALUES) ThenBlock: {
            ReturnValue(0)
        }
        offset = Multiply(JSRTState.val_count, JSRTConst.VAL_SIZE)
        addr = Add(JSRTState.val_pool, offset)
        JSRTState.val_count = Add(JSRTState.val_count, 1)
        ReturnValue(addr)
    }
}

// =============================================================================
// INIT — create singletons, native table, timer queue, stacks
// =============================================================================
Function.JSRT_Init {
    Output: Integer
    Body: {
        // Value pool: 8192 * 16 = 131072 bytes
        pool_sz = Multiply(JSRTConst.MAX_VALUES, JSRTConst.VAL_SIZE)
        JSRTState.val_pool = Allocate(pool_sz)
        MemorySet(JSRTState.val_pool, 0, pool_sz)
        JSRTState.val_count = 0

        // String buffer for ToString conversions
        JSRTState.str_buf = Allocate(JSRTConst.STR_BUF_CAP)
        MemorySet(JSRTState.str_buf, 0, JSRTConst.STR_BUF_CAP)
        JSRTState.str_pos = 0

        // Native function table: 64 * 24 = 1536 bytes
        nat_sz = Multiply(JSRTConst.MAX_NATIVES, JSRTConst.NATIVE_SIZE)
        JSRTState.native_table = Allocate(nat_sz)
        MemorySet(JSRTState.native_table, 0, nat_sz)
        JSRTState.native_count = 0

        // Timer queue: 32 * 32 = 1024 bytes
        tim_sz = Multiply(JSRTConst.MAX_TIMERS, JSRTConst.TIMER_SIZE)
        JSRTState.timer_pool = Allocate(tim_sz)
        MemorySet(JSRTState.timer_pool, 0, tim_sz)
        JSRTState.timer_count = 0
        JSRTState.next_timer_id = 1

        // Runtime frame stack (2048 entries x 8 bytes)
        JSRTStack.pool = Allocate(16384)
        MemorySet(JSRTStack.pool, 0, 16384)
        JSRTStack.capacity = 2048
        JSRTStack.sp = 0

        // ─── Create singleton: undefined ───
        uv = JSRT__AllocValue()
        StoreValue(uv, JSType.UNDEFINED)
        StoreValue(Add(uv, 8), 0)
        JSRTState.undef_val = uv

        // ─── Create singleton: null ───
        nv = JSRT__AllocValue()
        StoreValue(nv, JSType.NULL)
        StoreValue(Add(nv, 8), 0)
        JSRTState.null_val = nv

        // ─── Create singleton: true ───
        tv = JSRT__AllocValue()
        StoreValue(tv, JSType.BOOLEAN)
        StoreValue(Add(tv, 8), 1)
        JSRTState.true_val = tv

        // ─── Create singleton: false ───
        fv = JSRT__AllocValue()
        StoreValue(fv, JSType.BOOLEAN)
        StoreValue(Add(fv, 8), 0)
        JSRTState.false_val = fv

        ReturnValue(1)
    }
}

// =============================================================================
// VALUE CREATION
// =============================================================================

// Create a NUMBER JSValue. Returns pointer to JSValue.
Function.JSRT_CreateNumber {
    Input: n: Integer
    Output: Address
    Body: {
        save_n = n
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(val, JSType.NUMBER)
        StoreValue(Add(val, 8), save_n)
        ReturnValue(val)
    }
}

// Create a STRING JSValue. Copies the string so the value owns its data.
// ptr must be a null-terminated string. Returns pointer to JSValue.
Function.JSRT_CreateString {
    Input: ptr: Address
    Output: Address
    Body: {
        save_ptr = ptr
        IfCondition EqualTo(save_ptr, 0) ThenBlock: {
            // Null pointer — create empty string
            val = JSRT__AllocValue()
            IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
            empty = Allocate(1)
            SetByte(empty, 0, 0)
            StoreValue(val, JSType.STRING)
            StoreValue(Add(val, 8), empty)
            ReturnValue(val)
        }
        slen = StringLength(save_ptr)
        buf_sz = Add(slen, 1)
        buf = Allocate(buf_sz)
        MemoryCopy(buf, save_ptr, slen)
        SetByte(buf, slen, 0)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.STRING)
        StoreValue(Add(val, 8), buf)
        ReturnValue(val)
    }
}

// Create a STRING JSValue from a pointer and length (not necessarily null-terminated).
Function.JSRT_CreateStringLen {
    Input: ptr: Address
    Input: len: Integer
    Output: Address
    Body: {
        save_ptr = ptr
        save_len = len
        buf_sz = Add(save_len, 1)
        buf = Allocate(buf_sz)
        IfCondition GreaterThan(save_len, 0) ThenBlock: {
            MemoryCopy(buf, save_ptr, save_len)
        }
        SetByte(buf, save_len, 0)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.STRING)
        StoreValue(Add(val, 8), buf)
        ReturnValue(val)
    }
}

// Create a BOOLEAN JSValue. Returns singleton true_val or false_val.
Function.JSRT_CreateBool {
    Input: b: Integer
    Output: Address
    Body: {
        IfCondition NotEqual(b, 0) ThenBlock: {
            ReturnValue(JSRTState.true_val)
        }
        ReturnValue(JSRTState.false_val)
    }
}

// Create an OBJECT JSValue. Uses XSHash for property storage.
// Returns pointer to JSValue.
Function.JSRT_CreateObject {
    Output: Address
    Body: {
        hash = XSHash.XCreate(32)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.OBJECT)
        StoreValue(Add(val, 8), hash)
        ReturnValue(val)
    }
}

// Create an ARRAY JSValue. Uses XArray for element storage.
// Returns pointer to JSValue.
Function.JSRT_CreateArray {
    Output: Address
    Body: {
        arr = XArray.XCreate(16)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.ARRAY)
        StoreValue(Add(val, 8), arr)
        ReturnValue(val)
    }
}

// Create a FUNCTION JSValue. Allocates a 48-byte function descriptor.
// bc_off = bytecode offset, params = param count, locals = local count,
// name = pointer to name string (null-terminated).
Function.JSRT_CreateFunc {
    Input: bc_off: Integer
    Input: params: Integer
    Input: locals: Integer
    Input: name: Address
    Output: Address
    Body: {
        save_bc = bc_off
        save_params = params
        save_locals = locals
        save_name = name
        // Allocate 48-byte function descriptor
        desc = Allocate(JSRTConst.FUNC_DESC_SZ)
        MemorySet(desc, 0, JSRTConst.FUNC_DESC_SZ)
        // Offset 0: bytecode_offset
        StoreValue(desc, save_bc)
        // Offset 8: param_count
        StoreValue(Add(desc, 8), save_params)
        // Offset 16: local_count
        StoreValue(Add(desc, 16), save_locals)
        // Offset 24: name_ptr
        StoreValue(Add(desc, 24), save_name)
        // Offset 32: name_len
        IfCondition NotEqual(save_name, 0) ThenBlock: {
            nlen = StringLength(save_name)
            StoreValue(Add(desc, 32), nlen)
        }
        // Offset 40: closure_env (0 for now)
        StoreValue(Add(desc, 40), 0)

        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.FUNCTION)
        StoreValue(Add(val, 8), desc)
        ReturnValue(val)
    }
}

// =============================================================================
// VALUE ACCESS
// =============================================================================

// Get the type tag of a JSValue. Returns JSType constant.
Function.JSRT_GetType {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(JSType.UNDEFINED)
        }
        ReturnValue(Dereference(save_val))
    }
}

// Get the payload of a JSValue (raw 8-byte value at offset 8).
Function.JSRT_GetPayload {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Dereference(Add(save_val, 8)))
    }
}

// =============================================================================
// TRUTHINESS — JSRT_IsTruthy
// undefined=false, null=false, false=false, 0=false, ""=false, else=true
// =============================================================================
Function.JSRT_IsTruthy {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(0)
        }
        vtype = Dereference(save_val)
        // undefined -> false
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(0)
        }
        // null -> false
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            ReturnValue(0)
        }
        // boolean -> check payload
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            bval = Dereference(Add(save_val, 8))
            IfCondition EqualTo(bval, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // number -> 0 is false
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            nval = Dereference(Add(save_val, 8))
            IfCondition EqualTo(nval, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // string -> "" is false
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            sptr = Dereference(Add(save_val, 8))
            IfCondition EqualTo(sptr, 0) ThenBlock: {
                ReturnValue(0)
            }
            first_ch = GetByte(sptr, 0)
            IfCondition EqualTo(first_ch, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // object, array, function -> always truthy
        ReturnValue(1)
    }
}

// =============================================================================
// TYPE COERCION — ToNumber
// undefined -> 0, null -> 0, boolean -> 0/1, number -> identity,
// string -> parse integer (0 on failure), object/array/func -> 0
// =============================================================================
Function.JSRT_ToNumber {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(0)
        }
        vtype = Dereference(save_val)
        // undefined -> 0
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(0)
        }
        // null -> 0
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            ReturnValue(0)
        }
        // boolean -> 0 or 1
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            ReturnValue(Dereference(Add(save_val, 8)))
        }
        // number -> identity
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            ReturnValue(Dereference(Add(save_val, 8)))
        }
        // string -> parse integer
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            sptr = Dereference(Add(save_val, 8))
            IfCondition EqualTo(sptr, 0) ThenBlock: {
                ReturnValue(0)
            }
            result = StringToInt(sptr)
            ReturnValue(result)
        }
        // object, array, function -> 0
        ReturnValue(0)
    }
}

// =============================================================================
// TYPE COERCION — ToBool
// Returns a JSValue pointer (singleton true_val or false_val)
// =============================================================================
Function.JSRT_ToBool {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        truthy = JSRT_IsTruthy(save_val)
        IfCondition NotEqual(truthy, 0) ThenBlock: {
            ReturnValue(JSRTState.true_val)
        }
        ReturnValue(JSRTState.false_val)
    }
}

// =============================================================================
// INTERNAL: Integer to decimal string
// Builds decimal string from a 64-bit signed integer.
// Uses JSRT str_buf for scratch space. Returns pointer to null-terminated string.
// =============================================================================
Function.JSRT__IntToStr {
    Input: n: Integer
    Output: Address
    Body: {
        save_n = n
        // Allocate a small buffer for digits (max 20 digits + sign + null)
        buf = Allocate(24)
        MemorySet(buf, 0, 24)

        // Handle zero
        IfCondition EqualTo(save_n, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            SetByte(buf, 1, 0)
            ReturnValue(buf)
        }

        // Handle negative
        is_neg = 0
        work_n = save_n
        IfCondition LessThan(save_n, 0) ThenBlock: {
            is_neg = 1
            work_n = Subtract(0, save_n)
        }

        // Build digits in reverse into a temp buffer
        tmp = Allocate(24)
        MemorySet(tmp, 0, 24)
        di = 0
        WhileLoop GreaterThan(work_n, 0) {
            remainder = Modulo(work_n, 10)
            digit_ch = Add(remainder, 48)
            SetByte(tmp, di, digit_ch)
            di = Add(di, 1)
            work_n = Divide(work_n, 10)
        }

        // Now reverse into buf
        out_pos = 0
        IfCondition EqualTo(is_neg, 1) ThenBlock: {
            SetByte(buf, 0, 45)
            out_pos = 1
        }

        // Copy digits in reverse order
        ri = Subtract(di, 1)
        WhileLoop GreaterEqual(ri, 0) {
            ch = GetByte(tmp, ri)
            SetByte(buf, out_pos, ch)
            out_pos = Add(out_pos, 1)
            ri = Subtract(ri, 1)
        }
        SetByte(buf, out_pos, 0)
        ReturnValue(buf)
    }
}

// =============================================================================
// TYPE COERCION — ToString
// Returns a new STRING JSValue.
// undefined -> "undefined", null -> "null", boolean -> "true"/"false",
// number -> decimal string, string -> identity, object -> "[object Object]",
// array -> joined elements, function -> "[function]"
// =============================================================================
Function.JSRT_ToString {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            // Null pointer -> "undefined"
            ubuf = Allocate(10)
            // "undefined" = 117 110 100 101 102 105 110 101 100
            SetByte(ubuf, 0, 117)
            SetByte(ubuf, 1, 110)
            SetByte(ubuf, 2, 100)
            SetByte(ubuf, 3, 101)
            SetByte(ubuf, 4, 102)
            SetByte(ubuf, 5, 105)
            SetByte(ubuf, 6, 110)
            SetByte(ubuf, 7, 101)
            SetByte(ubuf, 8, 100)
            SetByte(ubuf, 9, 0)
            ReturnValue(JSRT_CreateString(ubuf))
        }
        vtype = Dereference(save_val)

        // ─── UNDEFINED ───
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ubuf = Allocate(10)
            SetByte(ubuf, 0, 117)
            SetByte(ubuf, 1, 110)
            SetByte(ubuf, 2, 100)
            SetByte(ubuf, 3, 101)
            SetByte(ubuf, 4, 102)
            SetByte(ubuf, 5, 105)
            SetByte(ubuf, 6, 110)
            SetByte(ubuf, 7, 101)
            SetByte(ubuf, 8, 100)
            SetByte(ubuf, 9, 0)
            ReturnValue(JSRT_CreateString(ubuf))
        }

        // ─── NULL ───
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            nbuf = Allocate(5)
            // "null" = 110 117 108 108
            SetByte(nbuf, 0, 110)
            SetByte(nbuf, 1, 117)
            SetByte(nbuf, 2, 108)
            SetByte(nbuf, 3, 108)
            SetByte(nbuf, 4, 0)
            ReturnValue(JSRT_CreateString(nbuf))
        }

        // ─── BOOLEAN ───
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            bval = Dereference(Add(save_val, 8))
            IfCondition NotEqual(bval, 0) ThenBlock: {
                tbuf = Allocate(5)
                // "true" = 116 114 117 101
                SetByte(tbuf, 0, 116)
                SetByte(tbuf, 1, 114)
                SetByte(tbuf, 2, 117)
                SetByte(tbuf, 3, 101)
                SetByte(tbuf, 4, 0)
                ReturnValue(JSRT_CreateString(tbuf))
            }
            fbuf = Allocate(6)
            // "false" = 102 97 108 115 101
            SetByte(fbuf, 0, 102)
            SetByte(fbuf, 1, 97)
            SetByte(fbuf, 2, 108)
            SetByte(fbuf, 3, 115)
            SetByte(fbuf, 4, 101)
            SetByte(fbuf, 5, 0)
            ReturnValue(JSRT_CreateString(fbuf))
        }

        // ─── NUMBER ───
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            nval = Dereference(Add(save_val, 8))
            str_ptr = JSRT__IntToStr(nval)
            ReturnValue(JSRT_CreateString(str_ptr))
        }

        // ─── STRING ───
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            // Already a string — return a copy
            sptr = Dereference(Add(save_val, 8))
            ReturnValue(JSRT_CreateString(sptr))
        }

        // ─── OBJECT ───
        IfCondition EqualTo(vtype, JSType.OBJECT) ThenBlock: {
            obuf = Allocate(16)
            // "[object Object]" = 91 111 98 106 101 99 116 32 79 98 106 101 99 116 93
            SetByte(obuf, 0, 91)
            SetByte(obuf, 1, 111)
            SetByte(obuf, 2, 98)
            SetByte(obuf, 3, 106)
            SetByte(obuf, 4, 101)
            SetByte(obuf, 5, 99)
            SetByte(obuf, 6, 116)
            SetByte(obuf, 7, 32)
            SetByte(obuf, 8, 79)
            SetByte(obuf, 9, 98)
            SetByte(obuf, 10, 106)
            SetByte(obuf, 11, 101)
            SetByte(obuf, 12, 99)
            SetByte(obuf, 13, 116)
            SetByte(obuf, 14, 93)
            SetByte(obuf, 15, 0)
            ReturnValue(JSRT_CreateString(obuf))
        }

        // ─── ARRAY ───
        IfCondition EqualTo(vtype, JSType.ARRAY) ThenBlock: {
            // Return empty string representation for now
            abuf = Allocate(1)
            SetByte(abuf, 0, 0)
            ReturnValue(JSRT_CreateString(abuf))
        }

        // ─── FUNCTION ───
        IfCondition EqualTo(vtype, JSType.FUNCTION) ThenBlock: {
            ffbuf = Allocate(11)
            // "[function]" = 91 102 117 110 99 116 105 111 110 93
            SetByte(ffbuf, 0, 91)
            SetByte(ffbuf, 1, 102)
            SetByte(ffbuf, 2, 117)
            SetByte(ffbuf, 3, 110)
            SetByte(ffbuf, 4, 99)
            SetByte(ffbuf, 5, 116)
            SetByte(ffbuf, 6, 105)
            SetByte(ffbuf, 7, 111)
            SetByte(ffbuf, 8, 110)
            SetByte(ffbuf, 9, 93)
            SetByte(ffbuf, 10, 0)
            ReturnValue(JSRT_CreateString(ffbuf))
        }

        // Fallback: "undefined"
        ufbuf = Allocate(10)
        SetByte(ufbuf, 0, 117)
        SetByte(ufbuf, 1, 110)
        SetByte(ufbuf, 2, 100)
        SetByte(ufbuf, 3, 101)
        SetByte(ufbuf, 4, 102)
        SetByte(ufbuf, 5, 105)
        SetByte(ufbuf, 6, 110)
        SetByte(ufbuf, 7, 101)
        SetByte(ufbuf, 8, 100)
        SetByte(ufbuf, 9, 0)
        ReturnValue(JSRT_CreateString(ufbuf))
    }
}

// =============================================================================
// STRING CONCATENATION HELPER
// Concatenates two null-terminated strings, returns new JSValue STRING.
// =============================================================================
Function.JSRT__StrConcat {
    Input: a_ptr: Address
    Input: b_ptr: Address
    Output: Address
    Body: {
        save_a = a_ptr
        save_b = b_ptr
        len_a = StringLength(save_a)
        len_b = StringLength(save_b)
        total = Add(len_a, len_b)
        buf_sz = Add(total, 1)
        buf = Allocate(buf_sz)
        // Copy first string
        IfCondition GreaterThan(len_a, 0) ThenBlock: {
            MemoryCopy(buf, save_a, len_a)
        }
        // Copy second string
        IfCondition GreaterThan(len_b, 0) ThenBlock: {
            dest = Add(buf, len_a)
            MemoryCopy(dest, save_b, len_b)
        }
        SetByte(buf, total, 0)
        result = JSRT_CreateString(buf)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Add — + operator
// If either operand is STRING type, concatenate; otherwise numeric add.
// Returns a new JSValue.
// =============================================================================
Function.JSRT_Add {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: {
            save_a = JSRTState.undef_val
        }
        IfCondition EqualTo(save_b, 0) ThenBlock: {
            save_b = JSRTState.undef_val
        }
        a_type = Dereference(save_a)
        b_type = Dereference(save_b)

        // If either is STRING, do string concatenation
        is_str = 0
        IfCondition EqualTo(a_type, JSType.STRING) ThenBlock: {
            is_str = 1
        }
        IfCondition EqualTo(b_type, JSType.STRING) ThenBlock: {
            is_str = 1
        }

        IfCondition EqualTo(is_str, 1) ThenBlock: {
            // Convert both to string and concatenate
            JSRT__Push(save_b)
            str_a = JSRT_ToString(save_a)
            save_b = JSRT__Pop()
            a_sptr = Dereference(Add(str_a, 8))

            JSRT__Push(a_sptr)
            str_b = JSRT_ToString(save_b)
            a_sptr = JSRT__Pop()
            b_sptr = Dereference(Add(str_b, 8))

            result = JSRT__StrConcat(a_sptr, b_sptr)
            ReturnValue(result)
        }

        // Numeric addition
        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        sum = Add(n_a, n_b)
        result = JSRT_CreateNumber(sum)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Sub — - operator (numeric subtraction)
// =============================================================================
Function.JSRT_Sub {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        diff = Subtract(n_a, n_b)
        result = JSRT_CreateNumber(diff)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Mul — * operator (numeric multiplication)
// =============================================================================
Function.JSRT_Mul {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        prod = Multiply(n_a, n_b)
        result = JSRT_CreateNumber(prod)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Div — / operator (integer division, div-by-zero returns 0)
// =============================================================================
Function.JSRT_Div {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        IfCondition EqualTo(n_b, 0) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }
        quot = Divide(n_a, n_b)
        result = JSRT_CreateNumber(quot)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Mod — % operator (modulo, mod-by-zero returns 0)
// =============================================================================
Function.JSRT_Mod {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        IfCondition EqualTo(n_b, 0) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(0))
        }
        rem = Modulo(n_a, n_b)
        result = JSRT_CreateNumber(rem)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_Neg — unary negation
// =============================================================================
Function.JSRT_Neg {
    Input: a: Address
    Output: Address
    Body: {
        save_a = a
        n_a = JSRT_ToNumber(save_a)
        neg_val = Subtract(0, n_a)
        result = JSRT_CreateNumber(neg_val)
        ReturnValue(result)
    }
}

// =============================================================================
// JSRT_BitAnd — & operator
// =============================================================================
Function.JSRT_BitAnd {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        r = BitwiseAnd(n_a, n_b)
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_BitOr — | operator
// =============================================================================
Function.JSRT_BitOr {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        r = BitwiseOr(n_a, n_b)
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_BitXor — ^ operator
// =============================================================================
Function.JSRT_BitXor {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        r = BitwiseXor(n_a, n_b)
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_BitNot — ~ operator
// =============================================================================
Function.JSRT_BitNot {
    Input: a: Address
    Output: Address
    Body: {
        save_a = a
        n_a = JSRT_ToNumber(save_a)
        // Bitwise NOT: ~x = -(x+1) for integers
        r = Subtract(0, Add(n_a, 1))
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_Shl — << operator
// =============================================================================
Function.JSRT_Shl {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        r = ShiftLeft(n_a, n_b)
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_Shr — >> operator
// =============================================================================
Function.JSRT_Shr {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        save_a = a
        save_b = b

        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        r = ShiftRight(n_a, n_b)
        ReturnValue(JSRT_CreateNumber(r))
    }
}

// =============================================================================
// JSRT_Not — ! operator (logical NOT)
// Returns boolean JSValue: true_val or false_val
// =============================================================================
Function.JSRT_Not {
    Input: a: Address
    Output: Address
    Body: {
        save_a = a
        truthy = JSRT_IsTruthy(save_a)
        IfCondition NotEqual(truthy, 0) ThenBlock: {
            ReturnValue(JSRTState.false_val)
        }
        ReturnValue(JSRTState.true_val)
    }
}

// =============================================================================
// COMPARISON — Strict Equality (===)
// Same type AND same value required.
// Returns 1 (equal) or 0 (not equal).
// =============================================================================
Function.JSRT_StrictEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        // Same pointer -> equal
        IfCondition EqualTo(save_a, save_b) ThenBlock: {
            ReturnValue(1)
        }
        // Either null pointer -> not equal (since not same pointer)
        IfCondition EqualTo(save_a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(save_b, 0) ThenBlock: { ReturnValue(0) }

        a_type = Dereference(save_a)
        b_type = Dereference(save_b)

        // Types must match
        IfCondition NotEqual(a_type, b_type) ThenBlock: {
            ReturnValue(0)
        }

        // UNDEFINED === UNDEFINED
        IfCondition EqualTo(a_type, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(1)
        }
        // NULL === NULL
        IfCondition EqualTo(a_type, JSType.NULL) ThenBlock: {
            ReturnValue(1)
        }

        a_pay = Dereference(Add(save_a, 8))
        b_pay = Dereference(Add(save_b, 8))

        // BOOLEAN: compare payload
        IfCondition EqualTo(a_type, JSType.BOOLEAN) ThenBlock: {
            IfCondition EqualTo(a_pay, b_pay) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        // NUMBER: compare payload
        IfCondition EqualTo(a_type, JSType.NUMBER) ThenBlock: {
            IfCondition EqualTo(a_pay, b_pay) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        // STRING: compare string contents
        IfCondition EqualTo(a_type, JSType.STRING) ThenBlock: {
            cmp = StringCompare(a_pay, b_pay)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        // OBJECT, ARRAY, FUNCTION: reference equality (same pointer)
        IfCondition EqualTo(a_pay, b_pay) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// COMPARISON — Abstract Equality (==)
// null == undefined -> true
// If same type, delegate to strict equality
// If one is number and other is string, convert string to number
// If one is boolean, convert to number and retry
// =============================================================================
Function.JSRT_AbstractEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, save_b) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        a_type = Dereference(save_a)
        b_type = Dereference(save_b)

        // Same type -> strict equal
        IfCondition EqualTo(a_type, b_type) ThenBlock: {
            result = JSRT_StrictEqual(save_a, save_b)
            ReturnValue(result)
        }

        // null == undefined and undefined == null
        IfCondition And(EqualTo(a_type, JSType.NULL), EqualTo(b_type, JSType.UNDEFINED)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition And(EqualTo(a_type, JSType.UNDEFINED), EqualTo(b_type, JSType.NULL)) ThenBlock: {
            ReturnValue(1)
        }

        // number vs string: convert string to number
        IfCondition And(EqualTo(a_type, JSType.NUMBER), EqualTo(b_type, JSType.STRING)) ThenBlock: {
            JSRT__Push(save_a)
            n_b = JSRT_ToNumber(save_b)
            save_a = JSRT__Pop()
            a_pay = Dereference(Add(save_a, 8))
            IfCondition EqualTo(a_pay, n_b) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition And(EqualTo(a_type, JSType.STRING), EqualTo(b_type, JSType.NUMBER)) ThenBlock: {
            JSRT__Push(save_b)
            n_a = JSRT_ToNumber(save_a)
            save_b = JSRT__Pop()
            b_pay = Dereference(Add(save_b, 8))
            IfCondition EqualTo(n_a, b_pay) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        // boolean vs anything: convert boolean to number, then compare
        IfCondition EqualTo(a_type, JSType.BOOLEAN) ThenBlock: {
            a_num_val = Dereference(Add(save_a, 8))
            JSRT__Push(save_b)
            a_as_num = JSRT_CreateNumber(a_num_val)
            save_b = JSRT__Pop()
            result = JSRT_AbstractEqual(a_as_num, save_b)
            ReturnValue(result)
        }
        IfCondition EqualTo(b_type, JSType.BOOLEAN) ThenBlock: {
            b_num_val = Dereference(Add(save_b, 8))
            JSRT__Push(save_a)
            b_as_num = JSRT_CreateNumber(b_num_val)
            save_a = JSRT__Pop()
            result = JSRT_AbstractEqual(save_a, b_as_num)
            ReturnValue(result)
        }

        // All other cases: not equal
        ReturnValue(0)
    }
}

// =============================================================================
// COMPARISON — Less Than (<)
// Numeric comparison after coercion. String comparison if both are strings.
// Returns 1 or 0.
// =============================================================================
Function.JSRT_LessThan {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        IfCondition EqualTo(save_a, 0) ThenBlock: { save_a = JSRTState.undef_val }
        IfCondition EqualTo(save_b, 0) ThenBlock: { save_b = JSRTState.undef_val }

        a_type = Dereference(save_a)
        b_type = Dereference(save_b)

        // Both strings: lexicographic comparison
        IfCondition And(EqualTo(a_type, JSType.STRING), EqualTo(b_type, JSType.STRING)) ThenBlock: {
            a_sptr = Dereference(Add(save_a, 8))
            b_sptr = Dereference(Add(save_b, 8))
            cmp = StringCompare(a_sptr, b_sptr)
            IfCondition LessThan(cmp, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        // Numeric comparison
        JSRT__Push(save_b)
        n_a = JSRT_ToNumber(save_a)
        save_b = JSRT__Pop()

        JSRT__Push(n_a)
        n_b = JSRT_ToNumber(save_b)
        n_a = JSRT__Pop()

        IfCondition LessThan(n_a, n_b) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// COMPARISON — Greater Than (>)
// =============================================================================
Function.JSRT_GreaterThan {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        // a > b is equivalent to b < a
        result = JSRT_LessThan(save_b, save_a)
        ReturnValue(result)
    }
}

// =============================================================================
// COMPARISON — Less Than or Equal (<=)
// =============================================================================
Function.JSRT_LessEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        // a <= b means NOT (b < a)
        JSRT__Push(save_a)
        gt = JSRT_LessThan(save_b, save_a)
        save_a = JSRT__Pop()
        IfCondition EqualTo(gt, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// COMPARISON — Greater Than or Equal (>=)
// =============================================================================
Function.JSRT_GreaterEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        save_a = a
        save_b = b
        // a >= b means NOT (a < b)
        lt = JSRT_LessThan(save_a, save_b)
        IfCondition EqualTo(lt, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// TYPEOF — returns a STRING JSValue with the type name
// =============================================================================
Function.JSRT_TypeOf {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            // "undefined"
            ubuf = Allocate(10)
            SetByte(ubuf, 0, 117)
            SetByte(ubuf, 1, 110)
            SetByte(ubuf, 2, 100)
            SetByte(ubuf, 3, 101)
            SetByte(ubuf, 4, 102)
            SetByte(ubuf, 5, 105)
            SetByte(ubuf, 6, 110)
            SetByte(ubuf, 7, 101)
            SetByte(ubuf, 8, 100)
            SetByte(ubuf, 9, 0)
            ReturnValue(JSRT_CreateString(ubuf))
        }
        vtype = Dereference(save_val)

        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ubuf = Allocate(10)
            SetByte(ubuf, 0, 117)
            SetByte(ubuf, 1, 110)
            SetByte(ubuf, 2, 100)
            SetByte(ubuf, 3, 101)
            SetByte(ubuf, 4, 102)
            SetByte(ubuf, 5, 105)
            SetByte(ubuf, 6, 110)
            SetByte(ubuf, 7, 101)
            SetByte(ubuf, 8, 100)
            SetByte(ubuf, 9, 0)
            ReturnValue(JSRT_CreateString(ubuf))
        }

        // typeof null === "object" (JS spec)
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            obuf = Allocate(7)
            // "object" = 111 98 106 101 99 116
            SetByte(obuf, 0, 111)
            SetByte(obuf, 1, 98)
            SetByte(obuf, 2, 106)
            SetByte(obuf, 3, 101)
            SetByte(obuf, 4, 99)
            SetByte(obuf, 5, 116)
            SetByte(obuf, 6, 0)
            ReturnValue(JSRT_CreateString(obuf))
        }

        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            bbuf = Allocate(8)
            // "boolean" = 98 111 111 108 101 97 110
            SetByte(bbuf, 0, 98)
            SetByte(bbuf, 1, 111)
            SetByte(bbuf, 2, 111)
            SetByte(bbuf, 3, 108)
            SetByte(bbuf, 4, 101)
            SetByte(bbuf, 5, 97)
            SetByte(bbuf, 6, 110)
            SetByte(bbuf, 7, 0)
            ReturnValue(JSRT_CreateString(bbuf))
        }

        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            nbuf = Allocate(7)
            // "number" = 110 117 109 98 101 114
            SetByte(nbuf, 0, 110)
            SetByte(nbuf, 1, 117)
            SetByte(nbuf, 2, 109)
            SetByte(nbuf, 3, 98)
            SetByte(nbuf, 4, 101)
            SetByte(nbuf, 5, 114)
            SetByte(nbuf, 6, 0)
            ReturnValue(JSRT_CreateString(nbuf))
        }

        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            sbuf = Allocate(7)
            // "string" = 115 116 114 105 110 103
            SetByte(sbuf, 0, 115)
            SetByte(sbuf, 1, 116)
            SetByte(sbuf, 2, 114)
            SetByte(sbuf, 3, 105)
            SetByte(sbuf, 4, 110)
            SetByte(sbuf, 5, 103)
            SetByte(sbuf, 6, 0)
            ReturnValue(JSRT_CreateString(sbuf))
        }

        IfCondition EqualTo(vtype, JSType.FUNCTION) ThenBlock: {
            fbuf = Allocate(9)
            // "function" = 102 117 110 99 116 105 111 110
            SetByte(fbuf, 0, 102)
            SetByte(fbuf, 1, 117)
            SetByte(fbuf, 2, 110)
            SetByte(fbuf, 3, 99)
            SetByte(fbuf, 4, 116)
            SetByte(fbuf, 5, 105)
            SetByte(fbuf, 6, 111)
            SetByte(fbuf, 7, 110)
            SetByte(fbuf, 8, 0)
            ReturnValue(JSRT_CreateString(fbuf))
        }

        // OBJECT and ARRAY -> "object"
        obuf = Allocate(7)
        SetByte(obuf, 0, 111)
        SetByte(obuf, 1, 98)
        SetByte(obuf, 2, 106)
        SetByte(obuf, 3, 101)
        SetByte(obuf, 4, 99)
        SetByte(obuf, 5, 116)
        SetByte(obuf, 6, 0)
        ReturnValue(JSRT_CreateString(obuf))
    }
}

// =============================================================================
// OBJECT OPERATIONS — property access using XSHash
// =============================================================================

// Get a property from an OBJECT JSValue by key string (null-terminated).
// Returns JSValue pointer, or undef_val if not found or not an object.
Function.JSRT_ObjGet {
    Input: obj: Address
    Input: key: Address
    Output: Address
    Body: {
        save_obj = obj
        save_key = key
        IfCondition EqualTo(save_obj, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        otype = Dereference(save_obj)
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        hash = Dereference(Add(save_obj, 8))
        IfCondition EqualTo(hash, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        result = XSHash.XLookup(hash, save_key)
        IfCondition EqualTo(result, XArrays.XNULL) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(result)
    }
}

// Set a property on an OBJECT JSValue. key is null-terminated string.
// val is a JSValue pointer. Returns 1 on success, 0 on failure.
Function.JSRT_ObjSet {
    Input: obj: Address
    Input: key: Address
    Input: val: Address
    Output: Integer
    Body: {
        save_obj = obj
        save_key = key
        save_val = val
        IfCondition EqualTo(save_obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        otype = Dereference(save_obj)
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        hash = Dereference(Add(save_obj, 8))
        IfCondition EqualTo(hash, 0) ThenBlock: {
            ReturnValue(0)
        }
        XSHash.XInsert(hash, save_key, save_val)
        ReturnValue(1)
    }
}

// Check if an OBJECT has a property. Returns 1 if exists, 0 if not.
Function.JSRT_ObjHas {
    Input: obj: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_obj = obj
        save_key = key
        IfCondition EqualTo(save_obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        otype = Dereference(save_obj)
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        hash = Dereference(Add(save_obj, 8))
        IfCondition EqualTo(hash, 0) ThenBlock: {
            ReturnValue(0)
        }
        result = XSHash.XExists(hash, save_key)
        ReturnValue(result)
    }
}

// Delete a property from an OBJECT. Returns 1 on success, 0 if not an object.
Function.JSRT_ObjDelete {
    Input: obj: Address
    Input: key: Address
    Output: Integer
    Body: {
        save_obj = obj
        save_key = key
        IfCondition EqualTo(save_obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        otype = Dereference(save_obj)
        IfCondition NotEqual(otype, JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        hash = Dereference(Add(save_obj, 8))
        IfCondition EqualTo(hash, 0) ThenBlock: {
            ReturnValue(0)
        }
        XSHash.XDelete(hash, save_key)
        ReturnValue(1)
    }
}

// =============================================================================
// ARRAY OPERATIONS — element access using XArray
// =============================================================================

// Push a value onto an ARRAY JSValue. val is a JSValue pointer.
// Returns new length, or -1 on failure.
Function.JSRT_ArrPush {
    Input: arr: Address
    Input: val: Address
    Output: Integer
    Body: {
        save_arr = arr
        save_val = val
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(-1)
        }
        atype = Dereference(save_arr)
        IfCondition NotEqual(atype, JSType.ARRAY) ThenBlock: {
            ReturnValue(-1)
        }
        xa = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(xa, 0) ThenBlock: {
            ReturnValue(-1)
        }
        XArray.XPush(xa, save_val)
        new_len = XArray.XSize(xa)
        ReturnValue(new_len)
    }
}

// Get an element from an ARRAY JSValue by index.
// Returns JSValue pointer, or undef_val if out of bounds.
Function.JSRT_ArrGet {
    Input: arr: Address
    Input: idx: Integer
    Output: Address
    Body: {
        save_arr = arr
        save_idx = idx
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        atype = Dereference(save_arr)
        IfCondition NotEqual(atype, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        xa = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(xa, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        result = XArray.XGet(xa, save_idx)
        IfCondition EqualTo(result, XArrays.XERROR) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(result)
    }
}

// Set an element in an ARRAY JSValue by index.
// Returns 1 on success, 0 on failure.
Function.JSRT_ArrSet {
    Input: arr: Address
    Input: idx: Integer
    Input: val: Address
    Output: Integer
    Body: {
        save_arr = arr
        save_idx = idx
        save_val = val
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        atype = Dereference(save_arr)
        IfCondition NotEqual(atype, JSType.ARRAY) ThenBlock: {
            ReturnValue(0)
        }
        xa = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(xa, 0) ThenBlock: {
            ReturnValue(0)
        }
        result = XArray.XSet(xa, save_idx, save_val)
        ReturnValue(result)
    }
}

// Get the length of an ARRAY JSValue.
// Returns element count, or 0 if not an array.
Function.JSRT_ArrLen {
    Input: arr: Address
    Output: Integer
    Body: {
        save_arr = arr
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        atype = Dereference(save_arr)
        IfCondition NotEqual(atype, JSType.ARRAY) ThenBlock: {
            ReturnValue(0)
        }
        xa = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(xa, 0) ThenBlock: {
            ReturnValue(0)
        }
        result = XArray.XSize(xa)
        ReturnValue(result)
    }
}

// Pop the last element from an ARRAY JSValue.
// Returns JSValue pointer, or undef_val if empty.
Function.JSRT_ArrPop {
    Input: arr: Address
    Output: Address
    Body: {
        save_arr = arr
        IfCondition EqualTo(save_arr, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        atype = Dereference(save_arr)
        IfCondition NotEqual(atype, JSType.ARRAY) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        xa = Dereference(Add(save_arr, 8))
        IfCondition EqualTo(xa, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        result = XArray.XPop(xa)
        IfCondition EqualTo(result, XArrays.XERROR) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        ReturnValue(result)
    }
}

// =============================================================================
// FUNCTION DESCRIPTOR ACCESS
// =============================================================================

// Get bytecode offset from a FUNCTION JSValue.
Function.JSRT_FuncGetBC {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(desc))
    }
}

// Get param count from a FUNCTION JSValue.
Function.JSRT_FuncGetParams {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(desc, 8)))
    }
}

// Get local count from a FUNCTION JSValue.
Function.JSRT_FuncGetLocals {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(desc, 16)))
    }
}

// Get name pointer from a FUNCTION JSValue.
Function.JSRT_FuncGetName {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(desc, 24)))
    }
}

// Get closure env pointer from a FUNCTION JSValue.
Function.JSRT_FuncGetEnv {
    Input: val: Address
    Output: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(desc, 40)))
    }
}

// Set closure env pointer on a FUNCTION JSValue.
Function.JSRT_FuncSetEnv {
    Input: val: Address
    Input: env: Address
    Output: Integer
    Body: {
        save_val = val
        save_env = env
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(save_val)
        IfCondition NotEqual(vtype, JSType.FUNCTION) ThenBlock: { ReturnValue(0) }
        desc = Dereference(Add(save_val, 8))
        IfCondition EqualTo(desc, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(desc, 40), save_env)
        ReturnValue(1)
    }
}

// =============================================================================
// NATIVE FUNCTION TABLE
// Each entry: { name_ptr(8), name_len(8), handler_id(8) } = 24 bytes
// =============================================================================

// Register a native function by name and handler ID.
// Returns the index in the native table, or -1 on overflow.
Function.JSRT_RegisterNative {
    Input: name: Address
    Input: handler_id: Integer
    Output: Integer
    Body: {
        save_name = name
        save_id = handler_id
        IfCondition GreaterEqual(JSRTState.native_count, JSRTConst.MAX_NATIVES) ThenBlock: {
            ReturnValue(-1)
        }
        idx = JSRTState.native_count
        JSRTState.native_count = Add(idx, 1)
        base = Add(JSRTState.native_table, Multiply(idx, JSRTConst.NATIVE_SIZE))
        // Store name pointer
        StoreValue(base, save_name)
        // Store name length
        nlen = StringLength(save_name)
        StoreValue(Add(base, 8), nlen)
        // Store handler ID
        StoreValue(Add(base, 16), save_id)
        ReturnValue(idx)
    }
}

// Look up a native function by name. Returns handler_id or -1 if not found.
Function.JSRT_FindNative {
    Input: name: Address
    Output: Integer
    Body: {
        save_name = name
        JSRTTmp.idx = 0
        WhileLoop LessThan(JSRTTmp.idx, JSRTState.native_count) {
            base = Add(JSRTState.native_table, Multiply(JSRTTmp.idx, JSRTConst.NATIVE_SIZE))
            entry_name = Dereference(base)
            cmp = StringCompare(entry_name, save_name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(Dereference(Add(base, 16)))
            }
            JSRTTmp.idx = Add(JSRTTmp.idx, 1)
        }
        ReturnValue(-1)
    }
}

// Call a native function by handler ID with args array and arg count.
// For now returns undefined — the bridge (JSVM) will implement actual handlers.
// args is a pointer to an array of JSValue pointers, argc is the count.
Function.JSRT_CallNative {
    Input: id: Integer
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = id
        save_args = args
        save_argc = argc

        // Validate handler ID exists
        IfCondition LessThan(save_id, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }
        IfCondition GreaterEqual(save_id, JSRTState.native_count) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }

        // ─── Built-in handler IDs ───
        // Handler 1: console.log — print args to stdout (stub: just return undefined)
        // Handler 2: Math.abs
        // Handler 3: Math.max
        // Handler 4: Math.min
        // Handler 5: Math.floor (identity for integers)
        // Handler 6: Math.ceil (identity for integers)
        // Handler 7: Math.round (identity for integers)
        // Handler 8: Math.pow

        // Handler 1: console.log — return undefined (actual I/O handled by VM bridge)
        IfCondition EqualTo(save_id, 0) ThenBlock: {
            ReturnValue(JSRTState.undef_val)
        }

        // Handler 2: Math.abs — absolute value
        IfCondition EqualTo(save_id, 1) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                IfCondition LessThan(nval, 0) ThenBlock: {
                    nval = Subtract(0, nval)
                }
                ReturnValue(JSRT_CreateNumber(nval))
            }
            ReturnValue(JSRT_CreateNumber(0))
        }

        // Handler 3: Math.max — return maximum of two args
        IfCondition EqualTo(save_id, 2) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: {
                IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                    arg0 = Dereference(save_args)
                    nval = JSRT_ToNumber(arg0)
                    ReturnValue(JSRT_CreateNumber(nval))
                }
                ReturnValue(JSRT_CreateNumber(0))
            }
            arg0 = Dereference(save_args)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            n0 = JSRT_ToNumber(arg0)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            arg1_addr = Add(save_args, 8)
            arg1 = Dereference(arg1_addr)
            JSRT__Push(n0)
            n1 = JSRT_ToNumber(arg1)
            n0 = JSRT__Pop()
            IfCondition GreaterThan(n0, n1) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(n0))
            }
            ReturnValue(JSRT_CreateNumber(n1))
        }

        // Handler 4: Math.min — return minimum of two args
        IfCondition EqualTo(save_id, 3) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: {
                IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                    arg0 = Dereference(save_args)
                    nval = JSRT_ToNumber(arg0)
                    ReturnValue(JSRT_CreateNumber(nval))
                }
                ReturnValue(JSRT_CreateNumber(0))
            }
            arg0 = Dereference(save_args)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            n0 = JSRT_ToNumber(arg0)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            arg1_addr = Add(save_args, 8)
            arg1 = Dereference(arg1_addr)
            JSRT__Push(n0)
            n1 = JSRT_ToNumber(arg1)
            n0 = JSRT__Pop()
            IfCondition LessThan(n0, n1) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(n0))
            }
            ReturnValue(JSRT_CreateNumber(n1))
        }

        // Handler 5: Math.floor — identity for integers
        IfCondition EqualTo(save_id, 4) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                ReturnValue(JSRT_CreateNumber(nval))
            }
            ReturnValue(JSRT_CreateNumber(0))
        }

        // Handler 6: Math.ceil — identity for integers
        IfCondition EqualTo(save_id, 5) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                ReturnValue(JSRT_CreateNumber(nval))
            }
            ReturnValue(JSRT_CreateNumber(0))
        }

        // Handler 7: Math.round — identity for integers
        IfCondition EqualTo(save_id, 6) ThenBlock: {
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                arg0 = Dereference(save_args)
                nval = JSRT_ToNumber(arg0)
                ReturnValue(JSRT_CreateNumber(nval))
            }
            ReturnValue(JSRT_CreateNumber(0))
        }

        // Handler 8: Math.pow — a^b using repeated multiplication
        IfCondition EqualTo(save_id, 7) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(0))
            }
            arg0 = Dereference(save_args)
            JSRT__Push(save_args)
            JSRT__Push(save_argc)
            base_n = JSRT_ToNumber(arg0)
            save_argc = JSRT__Pop()
            save_args = JSRT__Pop()
            arg1_addr = Add(save_args, 8)
            arg1 = Dereference(arg1_addr)
            JSRT__Push(base_n)
            exp_n = JSRT_ToNumber(arg1)
            base_n = JSRT__Pop()

            // Handle special cases
            IfCondition EqualTo(exp_n, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(1))
            }
            IfCondition LessThan(exp_n, 0) ThenBlock: {
                // Integer division: negative exponent yields 0 (no float)
                ReturnValue(JSRT_CreateNumber(0))
            }
            result = 1
            pow_i = 0
            WhileLoop LessThan(pow_i, exp_n) {
                result = Multiply(result, base_n)
                pow_i = Add(pow_i, 1)
            }
            ReturnValue(JSRT_CreateNumber(result))
        }

        // Unknown handler — return undefined
        ReturnValue(JSRTState.undef_val)
    }
}

// =============================================================================
// BUILT-IN REGISTRATION — register console and Math natives
// Called once during JSRT_Init or by the VM bootstrap.
// =============================================================================
Function.JSRT_RegisterBuiltins {
    Output: Integer
    Body: {
        // ─── console.log (handler_id = 0) ───
        cl_buf = Allocate(12)
        // "console.log" = 99 111 110 115 111 108 101 46 108 111 103
        SetByte(cl_buf, 0, 99)
        SetByte(cl_buf, 1, 111)
        SetByte(cl_buf, 2, 110)
        SetByte(cl_buf, 3, 115)
        SetByte(cl_buf, 4, 111)
        SetByte(cl_buf, 5, 108)
        SetByte(cl_buf, 6, 101)
        SetByte(cl_buf, 7, 46)
        SetByte(cl_buf, 8, 108)
        SetByte(cl_buf, 9, 111)
        SetByte(cl_buf, 10, 103)
        SetByte(cl_buf, 11, 0)
        JSRT_RegisterNative(cl_buf, 0)

        // ─── Math.abs (handler_id = 1) ───
        ma_buf = Allocate(9)
        // "Math.abs" = 77 97 116 104 46 97 98 115
        SetByte(ma_buf, 0, 77)
        SetByte(ma_buf, 1, 97)
        SetByte(ma_buf, 2, 116)
        SetByte(ma_buf, 3, 104)
        SetByte(ma_buf, 4, 46)
        SetByte(ma_buf, 5, 97)
        SetByte(ma_buf, 6, 98)
        SetByte(ma_buf, 7, 115)
        SetByte(ma_buf, 8, 0)
        JSRT_RegisterNative(ma_buf, 1)

        // ─── Math.max (handler_id = 2) ───
        mx_buf = Allocate(9)
        // "Math.max" = 77 97 116 104 46 109 97 120
        SetByte(mx_buf, 0, 77)
        SetByte(mx_buf, 1, 97)
        SetByte(mx_buf, 2, 116)
        SetByte(mx_buf, 3, 104)
        SetByte(mx_buf, 4, 46)
        SetByte(mx_buf, 5, 109)
        SetByte(mx_buf, 6, 97)
        SetByte(mx_buf, 7, 120)
        SetByte(mx_buf, 8, 0)
        JSRT_RegisterNative(mx_buf, 2)

        // ─── Math.min (handler_id = 3) ───
        mn_buf = Allocate(9)
        // "Math.min" = 77 97 116 104 46 109 105 110
        SetByte(mn_buf, 0, 77)
        SetByte(mn_buf, 1, 97)
        SetByte(mn_buf, 2, 116)
        SetByte(mn_buf, 3, 104)
        SetByte(mn_buf, 4, 46)
        SetByte(mn_buf, 5, 109)
        SetByte(mn_buf, 6, 105)
        SetByte(mn_buf, 7, 110)
        SetByte(mn_buf, 8, 0)
        JSRT_RegisterNative(mn_buf, 3)

        // ─── Math.floor (handler_id = 4) ───
        mf_buf = Allocate(11)
        // "Math.floor" = 77 97 116 104 46 102 108 111 111 114
        SetByte(mf_buf, 0, 77)
        SetByte(mf_buf, 1, 97)
        SetByte(mf_buf, 2, 116)
        SetByte(mf_buf, 3, 104)
        SetByte(mf_buf, 4, 46)
        SetByte(mf_buf, 5, 102)
        SetByte(mf_buf, 6, 108)
        SetByte(mf_buf, 7, 111)
        SetByte(mf_buf, 8, 111)
        SetByte(mf_buf, 9, 114)
        SetByte(mf_buf, 10, 0)
        JSRT_RegisterNative(mf_buf, 4)

        // ─── Math.ceil (handler_id = 5) ───
        mc_buf = Allocate(10)
        // "Math.ceil" = 77 97 116 104 46 99 101 105 108
        SetByte(mc_buf, 0, 77)
        SetByte(mc_buf, 1, 97)
        SetByte(mc_buf, 2, 116)
        SetByte(mc_buf, 3, 104)
        SetByte(mc_buf, 4, 46)
        SetByte(mc_buf, 5, 99)
        SetByte(mc_buf, 6, 101)
        SetByte(mc_buf, 7, 105)
        SetByte(mc_buf, 8, 108)
        SetByte(mc_buf, 9, 0)
        JSRT_RegisterNative(mc_buf, 5)

        // ─── Math.round (handler_id = 6) ───
        mr_buf = Allocate(11)
        // "Math.round" = 77 97 116 104 46 114 111 117 110 100
        SetByte(mr_buf, 0, 77)
        SetByte(mr_buf, 1, 97)
        SetByte(mr_buf, 2, 116)
        SetByte(mr_buf, 3, 104)
        SetByte(mr_buf, 4, 46)
        SetByte(mr_buf, 5, 114)
        SetByte(mr_buf, 6, 111)
        SetByte(mr_buf, 7, 117)
        SetByte(mr_buf, 8, 110)
        SetByte(mr_buf, 9, 100)
        SetByte(mr_buf, 10, 0)
        JSRT_RegisterNative(mr_buf, 6)

        // ─── Math.pow (handler_id = 7) ───
        mp_buf = Allocate(9)
        // "Math.pow" = 77 97 116 104 46 112 111 119
        SetByte(mp_buf, 0, 77)
        SetByte(mp_buf, 1, 97)
        SetByte(mp_buf, 2, 116)
        SetByte(mp_buf, 3, 104)
        SetByte(mp_buf, 4, 46)
        SetByte(mp_buf, 5, 112)
        SetByte(mp_buf, 6, 111)
        SetByte(mp_buf, 7, 119)
        SetByte(mp_buf, 8, 0)
        JSRT_RegisterNative(mp_buf, 7)

        ReturnValue(8)
    }
}

// =============================================================================
// BUILT-IN OBJECT CREATION — console and Math objects
// Creates JSValue OBJECTs with native function stubs as properties.
// =============================================================================

// Create the global "console" object with a "log" method stub.
// Returns OBJECT JSValue.
Function.JSRT_CreateConsole {
    Output: Address
    Body: {
        console_obj = JSRT_CreateObject()

        // Create a function for console.log — use handler_id 0
        // "console.log" name
        cl_name = Allocate(12)
        SetByte(cl_name, 0, 99)
        SetByte(cl_name, 1, 111)
        SetByte(cl_name, 2, 110)
        SetByte(cl_name, 3, 115)
        SetByte(cl_name, 4, 111)
        SetByte(cl_name, 5, 108)
        SetByte(cl_name, 6, 101)
        SetByte(cl_name, 7, 46)
        SetByte(cl_name, 8, 108)
        SetByte(cl_name, 9, 111)
        SetByte(cl_name, 10, 103)
        SetByte(cl_name, 11, 0)

        // bytecode_offset = -1 signals native function
        JSRT__Push(console_obj)
        log_func = JSRT_CreateFunc(-1, 0, 0, cl_name)
        console_obj = JSRT__Pop()

        // Set "log" property
        // "log" = 108 111 103
        log_key = Allocate(4)
        SetByte(log_key, 0, 108)
        SetByte(log_key, 1, 111)
        SetByte(log_key, 2, 103)
        SetByte(log_key, 3, 0)

        JSRT_ObjSet(console_obj, log_key, log_func)
        ReturnValue(console_obj)
    }
}

// Create the global "Math" object with method stubs.
// Returns OBJECT JSValue.
Function.JSRT_CreateMath {
    Output: Address
    Body: {
        math_obj = JSRT_CreateObject()

        // ─── Math.abs ───
        abs_name = Allocate(9)
        SetByte(abs_name, 0, 77)
        SetByte(abs_name, 1, 97)
        SetByte(abs_name, 2, 116)
        SetByte(abs_name, 3, 104)
        SetByte(abs_name, 4, 46)
        SetByte(abs_name, 5, 97)
        SetByte(abs_name, 6, 98)
        SetByte(abs_name, 7, 115)
        SetByte(abs_name, 8, 0)
        JSRT__Push(math_obj)
        abs_func = JSRT_CreateFunc(-1, 1, 0, abs_name)
        math_obj = JSRT__Pop()
        abs_key = Allocate(4)
        SetByte(abs_key, 0, 97)
        SetByte(abs_key, 1, 98)
        SetByte(abs_key, 2, 115)
        SetByte(abs_key, 3, 0)
        JSRT_ObjSet(math_obj, abs_key, abs_func)

        // ─── Math.max ───
        max_name = Allocate(9)
        SetByte(max_name, 0, 77)
        SetByte(max_name, 1, 97)
        SetByte(max_name, 2, 116)
        SetByte(max_name, 3, 104)
        SetByte(max_name, 4, 46)
        SetByte(max_name, 5, 109)
        SetByte(max_name, 6, 97)
        SetByte(max_name, 7, 120)
        SetByte(max_name, 8, 0)
        JSRT__Push(math_obj)
        max_func = JSRT_CreateFunc(-1, 2, 0, max_name)
        math_obj = JSRT__Pop()
        max_key = Allocate(4)
        SetByte(max_key, 0, 109)
        SetByte(max_key, 1, 97)
        SetByte(max_key, 2, 120)
        SetByte(max_key, 3, 0)
        JSRT_ObjSet(math_obj, max_key, max_func)

        // ─── Math.min ───
        min_name = Allocate(9)
        SetByte(min_name, 0, 77)
        SetByte(min_name, 1, 97)
        SetByte(min_name, 2, 116)
        SetByte(min_name, 3, 104)
        SetByte(min_name, 4, 46)
        SetByte(min_name, 5, 109)
        SetByte(min_name, 6, 105)
        SetByte(min_name, 7, 110)
        SetByte(min_name, 8, 0)
        JSRT__Push(math_obj)
        min_func = JSRT_CreateFunc(-1, 2, 0, min_name)
        math_obj = JSRT__Pop()
        min_key = Allocate(4)
        SetByte(min_key, 0, 109)
        SetByte(min_key, 1, 105)
        SetByte(min_key, 2, 110)
        SetByte(min_key, 3, 0)
        JSRT_ObjSet(math_obj, min_key, min_func)

        // ─── Math.floor ───
        floor_name = Allocate(11)
        SetByte(floor_name, 0, 77)
        SetByte(floor_name, 1, 97)
        SetByte(floor_name, 2, 116)
        SetByte(floor_name, 3, 104)
        SetByte(floor_name, 4, 46)
        SetByte(floor_name, 5, 102)
        SetByte(floor_name, 6, 108)
        SetByte(floor_name, 7, 111)
        SetByte(floor_name, 8, 111)
        SetByte(floor_name, 9, 114)
        SetByte(floor_name, 10, 0)
        JSRT__Push(math_obj)
        floor_func = JSRT_CreateFunc(-1, 1, 0, floor_name)
        math_obj = JSRT__Pop()
        floor_key = Allocate(6)
        // "floor" = 102 108 111 111 114
        SetByte(floor_key, 0, 102)
        SetByte(floor_key, 1, 108)
        SetByte(floor_key, 2, 111)
        SetByte(floor_key, 3, 111)
        SetByte(floor_key, 4, 114)
        SetByte(floor_key, 5, 0)
        JSRT_ObjSet(math_obj, floor_key, floor_func)

        // ─── Math.ceil ───
        ceil_name = Allocate(10)
        SetByte(ceil_name, 0, 77)
        SetByte(ceil_name, 1, 97)
        SetByte(ceil_name, 2, 116)
        SetByte(ceil_name, 3, 104)
        SetByte(ceil_name, 4, 46)
        SetByte(ceil_name, 5, 99)
        SetByte(ceil_name, 6, 101)
        SetByte(ceil_name, 7, 105)
        SetByte(ceil_name, 8, 108)
        SetByte(ceil_name, 9, 0)
        JSRT__Push(math_obj)
        ceil_func = JSRT_CreateFunc(-1, 1, 0, ceil_name)
        math_obj = JSRT__Pop()
        ceil_key = Allocate(5)
        // "ceil" = 99 101 105 108
        SetByte(ceil_key, 0, 99)
        SetByte(ceil_key, 1, 101)
        SetByte(ceil_key, 2, 105)
        SetByte(ceil_key, 3, 108)
        SetByte(ceil_key, 4, 0)
        JSRT_ObjSet(math_obj, ceil_key, ceil_func)

        // ─── Math.round ───
        round_name = Allocate(11)
        SetByte(round_name, 0, 77)
        SetByte(round_name, 1, 97)
        SetByte(round_name, 2, 116)
        SetByte(round_name, 3, 104)
        SetByte(round_name, 4, 46)
        SetByte(round_name, 5, 114)
        SetByte(round_name, 6, 111)
        SetByte(round_name, 7, 117)
        SetByte(round_name, 8, 110)
        SetByte(round_name, 9, 100)
        SetByte(round_name, 10, 0)
        JSRT__Push(math_obj)
        round_func = JSRT_CreateFunc(-1, 1, 0, round_name)
        math_obj = JSRT__Pop()
        round_key = Allocate(6)
        // "round" = 114 111 117 110 100
        SetByte(round_key, 0, 114)
        SetByte(round_key, 1, 111)
        SetByte(round_key, 2, 117)
        SetByte(round_key, 3, 110)
        SetByte(round_key, 4, 100)
        SetByte(round_key, 5, 0)
        JSRT_ObjSet(math_obj, round_key, round_func)

        // ─── Math.pow ───
        pow_name = Allocate(9)
        SetByte(pow_name, 0, 77)
        SetByte(pow_name, 1, 97)
        SetByte(pow_name, 2, 116)
        SetByte(pow_name, 3, 104)
        SetByte(pow_name, 4, 46)
        SetByte(pow_name, 5, 112)
        SetByte(pow_name, 6, 111)
        SetByte(pow_name, 7, 119)
        SetByte(pow_name, 8, 0)
        JSRT__Push(math_obj)
        pow_func = JSRT_CreateFunc(-1, 2, 0, pow_name)
        math_obj = JSRT__Pop()
        pow_key = Allocate(4)
        // "pow" = 112 111 119
        SetByte(pow_key, 0, 112)
        SetByte(pow_key, 1, 111)
        SetByte(pow_key, 2, 119)
        SetByte(pow_key, 3, 0)
        JSRT_ObjSet(math_obj, pow_key, pow_func)

        ReturnValue(math_obj)
    }
}

// =============================================================================
// TIMER QUEUE
// Each entry: { id(8), callback_val(8), delay_ms(8), is_interval(8) } = 32 bytes
// =============================================================================

// Add a timer to the queue. Returns timer ID.
// callback = JSValue pointer to a FUNCTION
// delay = milliseconds
// is_interval = 1 for setInterval, 0 for setTimeout
Function.JSRT_TimerAdd {
    Input: callback: Address
    Input: delay: Integer
    Input: is_interval: Integer
    Output: Integer
    Body: {
        save_cb = callback
        save_delay = delay
        save_interval = is_interval
        IfCondition GreaterEqual(JSRTState.timer_count, JSRTConst.MAX_TIMERS) ThenBlock: {
            ReturnValue(-1)
        }
        idx = JSRTState.timer_count
        JSRTState.timer_count = Add(idx, 1)
        timer_id = JSRTState.next_timer_id
        JSRTState.next_timer_id = Add(timer_id, 1)

        base = Add(JSRTState.timer_pool, Multiply(idx, JSRTConst.TIMER_SIZE))
        // id
        StoreValue(base, timer_id)
        // callback_val (JSValue pointer)
        StoreValue(Add(base, 8), save_cb)
        // delay_ms
        StoreValue(Add(base, 16), save_delay)
        // is_interval
        StoreValue(Add(base, 24), save_interval)

        ReturnValue(timer_id)
    }
}

// Remove a timer by ID. Returns 1 if found and removed, 0 if not found.
Function.JSRT_TimerRemove {
    Input: timer_id: Integer
    Output: Integer
    Body: {
        save_id = timer_id
        JSRTTmp.idx = 0
        WhileLoop LessThan(JSRTTmp.idx, JSRTState.timer_count) {
            base = Add(JSRTState.timer_pool, Multiply(JSRTTmp.idx, JSRTConst.TIMER_SIZE))
            entry_id = Dereference(base)
            IfCondition EqualTo(entry_id, save_id) ThenBlock: {
                // Found — compact by shifting remaining entries
                last_idx = Subtract(JSRTState.timer_count, 1)
                IfCondition LessThan(JSRTTmp.idx, last_idx) ThenBlock: {
                    // Copy last entry over this one
                    last_base = Add(JSRTState.timer_pool, Multiply(last_idx, JSRTConst.TIMER_SIZE))
                    MemoryCopy(base, last_base, JSRTConst.TIMER_SIZE)
                }
                JSRTState.timer_count = Subtract(JSRTState.timer_count, 1)
                ReturnValue(1)
            }
            JSRTTmp.idx = Add(JSRTTmp.idx, 1)
        }
        ReturnValue(0)
    }
}

// Tick the timer queue. current_ms is the current timestamp in milliseconds.
// Returns count of expired timers. Actual callback invocation is done by the VM.
// For now this is a stub that just returns the count of timers that would fire.
// The VM should call this once per frame and handle the callbacks.
Function.JSRT_TimerTick {
    Input: current_ms: Integer
    Output: Integer
    Body: {
        save_ms = current_ms
        expired = 0
        JSRTTmp.idx = 0
        WhileLoop LessThan(JSRTTmp.idx, JSRTState.timer_count) {
            base = Add(JSRTState.timer_pool, Multiply(JSRTTmp.idx, JSRTConst.TIMER_SIZE))
            delay = Dereference(Add(base, 16))
            // Simple stub: count any timer whose delay <= current_ms
            IfCondition LessEqual(delay, save_ms) ThenBlock: {
                expired = Add(expired, 1)
            }
            JSRTTmp.idx = Add(JSRTTmp.idx, 1)
        }
        ReturnValue(expired)
    }
}

// Get timer callback by index (for VM to invoke).
// Returns JSValue pointer to the FUNCTION, or 0.
Function.JSRT_TimerGetCB {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        IfCondition GreaterEqual(save_idx, JSRTState.timer_count) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSRTState.timer_pool, Multiply(save_idx, JSRTConst.TIMER_SIZE))
        ReturnValue(Dereference(Add(base, 8)))
    }
}

// Get timer count.
Function.JSRT_TimerCount {
    Output: Integer
    Body: {
        ReturnValue(JSRTState.timer_count)
    }
}

// Get timer is_interval flag by index.
Function.JSRT_TimerIsInterval {
    Input: idx: Integer
    Output: Integer
    Body: {
        save_idx = idx
        IfCondition GreaterEqual(save_idx, JSRTState.timer_count) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(JSRTState.timer_pool, Multiply(save_idx, JSRTConst.TIMER_SIZE))
        ReturnValue(Dereference(Add(base, 24)))
    }
}

// Get timer ID by index.
Function.JSRT_TimerGetId {
    Input: idx: Integer
    Output: Integer
    Body: {
        save_idx = idx
        IfCondition GreaterEqual(save_idx, JSRTState.timer_count) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition LessThan(save_idx, 0) ThenBlock: {
            ReturnValue(-1)
        }
        base = Add(JSRTState.timer_pool, Multiply(save_idx, JSRTConst.TIMER_SIZE))
        ReturnValue(Dereference(base))
    }
}

// =============================================================================
// SINGLETON ACCESSORS
// =============================================================================
Function.JSRT_Undefined {
    Output: Address
    Body: {
        ReturnValue(JSRTState.undef_val)
    }
}

Function.JSRT_Null {
    Output: Address
    Body: {
        ReturnValue(JSRTState.null_val)
    }
}

Function.JSRT_True {
    Output: Address
    Body: {
        ReturnValue(JSRTState.true_val)
    }
}

Function.JSRT_False {
    Output: Address
    Body: {
        ReturnValue(JSRTState.false_val)
    }
}

// =============================================================================
// VALUE POOL INFO
// =============================================================================
Function.JSRT_GetValCount {
    Output: Integer
    Body: {
        ReturnValue(JSRTState.val_count)
    }
}

Function.JSRT_GetValPool {
    Output: Address
    Body: {
        ReturnValue(JSRTState.val_pool)
    }
}

// =============================================================================
// RESET — clear runtime state for re-use (keeps allocations)
// =============================================================================
Function.JSRT_Reset {
    Output: Integer
    Body: {
        pool_sz = Multiply(JSRTConst.MAX_VALUES, JSRTConst.VAL_SIZE)
        MemorySet(JSRTState.val_pool, 0, pool_sz)
        JSRTState.val_count = 0

        nat_sz = Multiply(JSRTConst.MAX_NATIVES, JSRTConst.NATIVE_SIZE)
        MemorySet(JSRTState.native_table, 0, nat_sz)
        JSRTState.native_count = 0

        tim_sz = Multiply(JSRTConst.MAX_TIMERS, JSRTConst.TIMER_SIZE)
        MemorySet(JSRTState.timer_pool, 0, tim_sz)
        JSRTState.timer_count = 0
        JSRTState.next_timer_id = 1

        JSRTState.str_pos = 0
        JSRTStack.sp = 0

        // Re-create singletons
        uv = JSRT__AllocValue()
        StoreValue(uv, JSType.UNDEFINED)
        StoreValue(Add(uv, 8), 0)
        JSRTState.undef_val = uv

        nv = JSRT__AllocValue()
        StoreValue(nv, JSType.NULL)
        StoreValue(Add(nv, 8), 0)
        JSRTState.null_val = nv

        tv = JSRT__AllocValue()
        StoreValue(tv, JSType.BOOLEAN)
        StoreValue(Add(tv, 8), 1)
        JSRTState.true_val = tv

        fv = JSRT__AllocValue()
        StoreValue(fv, JSType.BOOLEAN)
        StoreValue(Add(fv, 8), 0)
        JSRTState.false_val = fv

        ReturnValue(1)
    }
}
