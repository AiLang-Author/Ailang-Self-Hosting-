// Library.JSRuntime.ailang — JavaScript runtime value system
// Handles: value creation (numbers, strings, booleans, null, undefined, objects,
// arrays, functions), type coercion (ToNumber, ToString, ToBool), comparison
// semantics (strict and abstract equality), built-in object stubs (console, Math),
// native function dispatch table, and timer queue (setTimeout/setInterval).
//
// CLOBBER SAFETY: Every function saves Input params to locals on the FIRST
// line of Body. Complex expressions broken into steps. JSRTTmp fields
// guarded with push/pop across recursive calls.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.XArrays
LibraryImport.StringUtils
LibraryImport.HashMap

LibraryImport.Browser.JSRuntime.JSRTCoerce
LibraryImport.Browser.JSRuntime.JSRTObject

// =============================================================================
// VALUE TYPE CONSTANTS
// =============================================================================
FixedPool.JSType {
    "UNDEFINED":  Initialize=0
    "NULL":       Initialize=1
    "BOOLEAN":    Initialize=2
    "NUMBER":     Initialize=3
    "STRING":     Initialize=4
    "OBJECT":     Initialize=5
    "FUNCTION":   Initialize=6
    "ARRAY":      Initialize=7
    "GENERATOR":  Initialize=8
}

// =============================================================================
// RUNTIME CONSTANTS
// =============================================================================
FixedPool.JSRTConst {
    "VAL_SIZE":      Initialize=16
    "MAX_VALUES":    Initialize=8192
    "MAX_NATIVES":   Initialize=64
    "MAX_TIMERS":    Initialize=32
    "TIMER_SIZE":    Initialize=32
    "NATIVE_SIZE":   Initialize=24
    "FUNC_DESC_SZ":  Initialize=72
    "STR_BUF_CAP":   Initialize=65536
}

// =============================================================================
// RUNTIME STATE
// =============================================================================
FixedPool.JSRTState {
    "val_pool":      Initialize=0
    "val_count":     Initialize=0
    "undef_val":     Initialize=0
    "null_val":      Initialize=0
    "true_val":      Initialize=0
    "false_val":     Initialize=0
    "native_table":  Initialize=0
    "native_count":  Initialize=0
    "timer_pool":    Initialize=0
    "timer_count":   Initialize=0
    "next_timer_id": Initialize=1
    "str_buf":       Initialize=0
    "str_pos":       Initialize=0
    "val_free_list": Initialize=0
    "val_recycled":  Initialize=0
}

// =============================================================================
// GC SCOPE LOG — tracks allocations per call frame for deferred free
//
// Design ("ping-pong mailbox"):
//   - scope_log: flat array of JSValue ptrs allocated in current scope
//   - scope_mark: stack of watermarks (one per call frame depth)
//   - On function entry: push current log position as watermark
//   - On function return: everything in log above the watermark is candidate
//     for freeing (except the return value). Free the JSValue slot + backing
//     storage (XSHash/XArray). Pop the watermark.
//   - mailbox: ring buffer of deferred-free batches. Each batch holds for
//     MAILBOX_HOLD turns before actual free. This lets return values survive
//     one frame up without explicit escape tracking.
// =============================================================================
FixedPool.JSGCConst {
    "LOG_CAP":       Initialize=16384
    "MARK_CAP":      Initialize=256
    "MAILBOX_SLOTS": Initialize=4
    "MAILBOX_CAP":   Initialize=4096
    "MAILBOX_HOLD":  Initialize=2
}

FixedPool.JSGC {
    "scope_log":     Initialize=0
    "scope_pos":     Initialize=0
    "mark_stack":    Initialize=0
    "mark_sp":       Initialize=0
    "mb_ring":       Initialize=0
    "mb_counts":     Initialize=0
    "mb_ages":       Initialize=0
    "mb_widx":       Initialize=0
    "mb_enabled":    Initialize=0
    "total_freed":   Initialize=0
    "total_swept":   Initialize=0
    "loop_idx":      Initialize=0
    "loop_max":      Initialize=0
    "collecting":    Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.JSRTTmp {
    "idx":       Initialize=0
    "type":      Initialize=0
    "ptr":       Initialize=0
    "len":       Initialize=0
    "val":       Initialize=0
    "addr":      Initialize=0
    "done":      Initialize=0
    "count":     Initialize=0
    "a_type":    Initialize=0
    "b_type":    Initialize=0
    "a_pay":     Initialize=0
    "b_pay":     Initialize=0
    "result":    Initialize=0
    "buf":       Initialize=0
    "digit":     Initialize=0
    "neg":       Initialize=0
    "pos":       Initialize=0
    "ch":        Initialize=0
}

// =============================================================================
// RUNTIME STACK — push/pop for recursive calls
// =============================================================================
FixedPool.JSRTStack {
    "pool":       Initialize=0
    "sp":         Initialize=0
    "capacity":   Initialize=0
    "tmp_val":    Initialize=0
    "tmp_addr":   Initialize=0
}

// =============================================================================
// STACK PUSH / POP
// =============================================================================
Function.JSRT__Push {
    Input: val: Integer
    Output: Integer
    Body: {
        JSRTStack.tmp_val = val
        JSRTStack.tmp_addr = Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))
        StoreValue(JSRTStack.tmp_addr, JSRTStack.tmp_val)
        JSRTStack.sp = Add(JSRTStack.sp, 1)
        ReturnValue(0)
    }
}

Function.JSRT__Pop {
    Output: Integer
    Body: {
        JSRTStack.sp = Subtract(JSRTStack.sp, 1)
        ReturnValue(Dereference(Add(JSRTStack.pool, Multiply(JSRTStack.sp, 8))))
    }
}

// =============================================================================
// VALUE POOL ALLOCATION — allocate a new 16-byte JSValue from pool
// Returns pointer to the new JSValue, or 0 on overflow.
// Checks free list first (recycled slots), then bump-allocates.
// =============================================================================
Function.JSRT__AllocValue {
    Output: Address
    Body: {
        // Try free list first (recycled slots from GC)
        IfCondition NotEqual(JSRTState.val_free_list, 0) ThenBlock: {
            addr = JSRTState.val_free_list
            JSRTState.val_free_list = Dereference(addr)
            StoreValue(addr, 0)
            StoreValue(Add(addr, 8), 0)
            JSRTState.val_recycled = Add(JSRTState.val_recycled, 1)
            ReturnValue(addr)
        }
        // Bump allocate from pool
        IfCondition GreaterEqual(JSRTState.val_count, JSRTConst.MAX_VALUES) ThenBlock: {
            // Pool exhausted — emergency GC
            JSRT_GC_Collect()
            IfCondition NotEqual(JSRTState.val_free_list, 0) ThenBlock: {
                addr = JSRTState.val_free_list
                JSRTState.val_free_list = Dereference(addr)
                StoreValue(addr, 0)
                StoreValue(Add(addr, 8), 0)
                JSRTState.val_recycled = Add(JSRTState.val_recycled, 1)
                ReturnValue(addr)
            }
            ReturnValue(0)
        }
        offset = Multiply(JSRTState.val_count, JSRTConst.VAL_SIZE)
        addr = Add(JSRTState.val_pool, offset)
        JSRTState.val_count = Add(JSRTState.val_count, 1)
        ReturnValue(addr)
    }
}

// =============================================================================
// VALUE FREE — recycle a 16-byte JSValue slot back to the free list.
// Also frees backing storage (XSHash for objects, XArray for arrays).
// Does NOT free singletons (undef, null, true, false).
// =============================================================================
Function.JSRT__FreeValue {
    Input: val: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        // Never free singletons
        IfCondition EqualTo(save_val, JSRTState.undef_val) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(save_val, JSRTState.null_val) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(save_val, JSRTState.true_val) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(save_val, JSRTState.false_val) ThenBlock: { ReturnValue(0) }

        vtype = Dereference(save_val)

        // Free backing storage based on type
        IfCondition EqualTo(vtype, JSType.OBJECT) ThenBlock: {
            hash = Dereference(Add(save_val, 8))
            IfCondition NotEqual(hash, 0) ThenBlock: {
                XSHash.XDestroy(hash)
            }
        }
        IfCondition EqualTo(vtype, JSType.ARRAY) ThenBlock: {
            arr = Dereference(Add(save_val, 8))
            IfCondition NotEqual(arr, 0) ThenBlock: {
                XArray.XDestroy(arr)
            }
        }
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            sptr = Dereference(Add(save_val, 8))
            IfCondition NotEqual(sptr, 0) ThenBlock: {
                slen = StringLength(sptr)
                Deallocate(sptr, Add(slen, 1))
            }
        }

        // Clear the slot and push onto free list
        StoreValue(save_val, JSRTState.val_free_list)
        StoreValue(Add(save_val, 8), 0)
        JSRTState.val_free_list = save_val
        JSGC.total_freed = Add(JSGC.total_freed, 1)
    }
}

// =============================================================================
// INIT — create singletons, native table, timer queue, stacks
// =============================================================================
Function.JSRT_Init {
    Output: Integer
    Body: {
        // Value pool: 8192 * 16 = 131072 bytes
        pool_sz = Multiply(JSRTConst.MAX_VALUES, JSRTConst.VAL_SIZE)
        JSRTState.val_pool = Allocate(pool_sz)
        MemorySet(JSRTState.val_pool, 0, pool_sz)
        JSRTState.val_count = 0

        // String buffer for ToString conversions
        JSRTState.str_buf = Allocate(JSRTConst.STR_BUF_CAP)
        MemorySet(JSRTState.str_buf, 0, JSRTConst.STR_BUF_CAP)
        JSRTState.str_pos = 0

        // Native function table: 64 * 24 = 1536 bytes
        nat_sz = Multiply(JSRTConst.MAX_NATIVES, JSRTConst.NATIVE_SIZE)
        JSRTState.native_table = Allocate(nat_sz)
        MemorySet(JSRTState.native_table, 0, nat_sz)
        JSRTState.native_count = 0

        // Timer queue: 32 * 32 = 1024 bytes
        tim_sz = Multiply(JSRTConst.MAX_TIMERS, JSRTConst.TIMER_SIZE)
        JSRTState.timer_pool = Allocate(tim_sz)
        MemorySet(JSRTState.timer_pool, 0, tim_sz)
        JSRTState.timer_count = 0
        JSRTState.next_timer_id = 1

        // Runtime frame stack (2048 entries x 8 bytes)
        JSRTStack.pool = Allocate(16384)
        MemorySet(JSRTStack.pool, 0, 16384)
        JSRTStack.capacity = 2048
        JSRTStack.sp = 0

        // ─── Create singleton: undefined ───
        uv = JSRT__AllocValue()
        StoreValue(uv, JSType.UNDEFINED)
        StoreValue(Add(uv, 8), 0)
        JSRTState.undef_val = uv

        // ─── Create singleton: null ───
        nv = JSRT__AllocValue()
        StoreValue(nv, JSType.NULL)
        StoreValue(Add(nv, 8), 0)
        JSRTState.null_val = nv

        // ─── Create singleton: true ───
        tv = JSRT__AllocValue()
        StoreValue(tv, JSType.BOOLEAN)
        StoreValue(Add(tv, 8), 1)
        JSRTState.true_val = tv

        // ─── Create singleton: false ───
        fv = JSRT__AllocValue()
        StoreValue(fv, JSType.BOOLEAN)
        StoreValue(Add(fv, 8), 0)
        JSRTState.false_val = fv

        // Initialize GC scope tracking
        JSRT_GC_Init()

        ReturnValue(1)
    }
}

// =============================================================================
// GC SCOPE TRACKING — ping-pong mailbox deferred free
// =============================================================================

// Initialize GC data structures
Function.JSRT_GC_Init {
    Body: {
        // Scope log: flat array of JSValue pointers (16384 entries x 8 bytes)
        log_sz = Multiply(JSGCConst.LOG_CAP, 8)
        JSGC.scope_log = Allocate(log_sz)
        MemorySet(JSGC.scope_log, 0, log_sz)
        JSGC.scope_pos = 0

        // Mark stack: watermarks per call depth (256 entries x 8 bytes)
        mark_sz = Multiply(JSGCConst.MARK_CAP, 8)
        JSGC.mark_stack = Allocate(mark_sz)
        MemorySet(JSGC.mark_stack, 0, mark_sz)
        JSGC.mark_sp = 0

        // Mailbox ring: 4 slots x 4096 entries x 8 bytes each
        mb_sz = Multiply(Multiply(JSGCConst.MAILBOX_SLOTS, JSGCConst.MAILBOX_CAP), 8)
        JSGC.mb_ring = Allocate(mb_sz)
        MemorySet(JSGC.mb_ring, 0, mb_sz)

        // Per-slot counts and ages (4 entries x 8 bytes each)
        JSGC.mb_counts = Allocate(32)
        MemorySet(JSGC.mb_counts, 0, 32)
        JSGC.mb_ages = Allocate(32)
        MemorySet(JSGC.mb_ages, 0, 32)

        JSGC.mb_widx = 0
        JSGC.mb_enabled = 1
        JSGC.total_freed = 0
        JSGC.total_swept = 0
    }
}

// Log a newly allocated JSValue for GC scope tracking.
// Called from JSRT__AllocValue on every allocation.
Function.JSRT_GC_LogAlloc {
    Input: val: Address
    Body: {
        IfCondition EqualTo(JSGC.mb_enabled, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(JSGC.scope_pos, JSGCConst.LOG_CAP) ThenBlock: {
            // Log full — skip tracking (values won't be freed this cycle)
            ReturnValue(0)
        }
        addr = Add(JSGC.scope_log, Multiply(JSGC.scope_pos, 8))
        StoreValue(addr, val)
        JSGC.scope_pos = Add(JSGC.scope_pos, 1)
    }
}

// Push a scope watermark — called when entering a JS function (CALL handler).
Function.JSRT_GC_ScopeBegin {
    Body: {
        IfCondition EqualTo(JSGC.mb_enabled, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(JSGC.mark_sp, JSGCConst.MARK_CAP) ThenBlock: {
            ReturnValue(0)
        }
        addr = Add(JSGC.mark_stack, Multiply(JSGC.mark_sp, 8))
        StoreValue(addr, JSGC.scope_pos)
        JSGC.mark_sp = Add(JSGC.mark_sp, 1)
    }
}

// Pop a scope watermark — called on function RETURN.
// exempt = the return value pointer (protected from future GC).
// Rewinds the scope log but does NOT immediately free anything.
// Actual freeing happens in JSRT_GC_Collect (triggered by pool pressure).
Function.JSRT_GC_ScopeEnd {
    Input: exempt: Address
    Body: {
        IfCondition EqualTo(JSGC.mb_enabled, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(JSGC.mark_sp, 0) ThenBlock: { ReturnValue(0) }

        // Pop watermark
        JSGC.mark_sp = Subtract(JSGC.mark_sp, 1)
        wm_addr = Add(JSGC.mark_stack, Multiply(JSGC.mark_sp, 8))
        watermark = Dereference(wm_addr)

        // Rewind scope log to watermark (drop tracking for this scope)
        JSGC.scope_pos = watermark
    }
}

// =============================================================================
// MARK-SWEEP GC — triggered when value pool approaches capacity.
// Walks VM stack + globals to find live values, frees everything else.
// =============================================================================

// Mark a single JSValue as live (set high bit of type tag).
// Also recursively marks values reachable from objects and arrays.
// CLOBBER SAFETY: Uses JSRTTmp.ptr to save val across recursive calls.
Function.JSRT_GC_Mark {
    Input: val: Address
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: { ReturnValue(0) }
        // Check if within our value pool range
        IfCondition LessThan(save_val, JSRTState.val_pool) ThenBlock: { ReturnValue(0) }
        pool_end = Add(JSRTState.val_pool, Multiply(JSRTState.val_count, JSRTConst.VAL_SIZE))
        IfCondition GreaterEqual(save_val, pool_end) ThenBlock: { ReturnValue(0) }

        // Read type tag
        tag = Dereference(save_val)
        // Already marked? (high bit set = marked)
        IfCondition GreaterEqual(tag, 256) ThenBlock: { ReturnValue(0) }
        // Mark it (set bit 8)
        StoreValue(save_val, Add(tag, 256))

        // Recursively mark values inside objects (XSHash entries)
        IfCondition EqualTo(tag, JSType.OBJECT) ThenBlock: {
            hash = Dereference(Add(save_val, 8))
            IfCondition NotEqual(hash, 0) ThenBlock: {
                JSRT_GC_MarkHash(hash)
            }
            ReturnValue(0)
        }

        // Recursively mark values inside arrays (XArray entries)
        IfCondition EqualTo(tag, JSType.ARRAY) ThenBlock: {
            arr = Dereference(Add(save_val, 8))
            IfCondition NotEqual(arr, 0) ThenBlock: {
                JSRT_GC_MarkArray(arr)
            }
            ReturnValue(0)
        }

        // Mark function descriptor's prototype and props
        IfCondition EqualTo(tag, JSType.FUNCTION) ThenBlock: {
            fdesc = Dereference(Add(save_val, 8))
            IfCondition NotEqual(fdesc, 0) ThenBlock: {
                // Save fdesc in JSRT stack across recursive calls
                JSRT__Push(fdesc)
                // prototype at offset 48
                proto = Dereference(Add(fdesc, 48))
                IfCondition NotEqual(proto, 0) ThenBlock: {
                    JSRT_GC_Mark(proto)
                }
                fdesc = JSRT__Pop()
                JSRT__Push(fdesc)
                // props hash at offset 64
                phash = Dereference(Add(fdesc, 64))
                IfCondition NotEqual(phash, 0) ThenBlock: {
                    JSRT_GC_MarkHash(phash)
                }
                fdesc = JSRT__Pop()
                // closure env at offset 40 — it's a JSValue or env ptr
                cenv = Dereference(Add(fdesc, 40))
                IfCondition NotEqual(cenv, 0) ThenBlock: {
                    JSRT_GC_Mark(cenv)
                }
            }
            ReturnValue(0)
        }
    }
}

// Mark all values stored in an XSHash (object property table).
// CLOBBER SAFETY: Uses JSRT stack to save loop state across Mark calls.
Function.JSRT_GC_MarkHash {
    Input: hash: Address
    Body: {
        save_hash = hash
        IfCondition EqualTo(save_hash, 0) ThenBlock: { ReturnValue(0) }
        bucket_count = Dereference(save_hash)
        buckets = Dereference(Add(save_hash, 16))
        IfCondition EqualTo(buckets, 0) ThenBlock: { ReturnValue(0) }
        bi = 0
        WhileLoop LessThan(bi, bucket_count) {
            node = ArrayGet(buckets, bi)
            WhileLoop NotEqual(node, 0) {
                // XSHash node: [key:8][value:8][next:8] = 24 bytes
                val_in_hash = Dereference(Add(node, 8))
                next_node = Dereference(Add(node, 16))
                IfCondition NotEqual(val_in_hash, 0) ThenBlock: {
                    // Save loop state across Mark call
                    JSRT__Push(bi)
                    JSRT__Push(bucket_count)
                    JSRT__Push(buckets)
                    JSRT__Push(next_node)
                    JSRT_GC_Mark(val_in_hash)
                    next_node = JSRT__Pop()
                    buckets = JSRT__Pop()
                    bucket_count = JSRT__Pop()
                    bi = JSRT__Pop()
                }
                node = next_node
            }
            bi = Add(bi, 1)
        }
    }
}

// Mark all values stored in an XArray (array elements).
// CLOBBER SAFETY: Uses JSRT stack to save loop state across Mark calls.
Function.JSRT_GC_MarkArray {
    Input: arr: Address
    Body: {
        save_arr = arr
        IfCondition EqualTo(save_arr, 0) ThenBlock: { ReturnValue(0) }
        size = Dereference(Add(save_arr, 8))
        data = Dereference(Add(save_arr, 16))
        IfCondition EqualTo(data, 0) ThenBlock: { ReturnValue(0) }
        ai = 0
        WhileLoop LessThan(ai, size) {
            elem = ArrayGet(data, ai)
            IfCondition NotEqual(elem, 0) ThenBlock: {
                // Save loop state across Mark call
                JSRT__Push(ai)
                JSRT__Push(size)
                JSRT__Push(data)
                JSRT_GC_Mark(elem)
                data = JSRT__Pop()
                size = JSRT__Pop()
                ai = JSRT__Pop()
            }
            ai = Add(ai, 1)
        }
    }
}

// Full mark-sweep collection. Called when value pool is under pressure.
// 1. Mark phase: walk all roots (stack, globals, singletons)
// 2. Sweep phase: free all unmarked values, recycle to free list
// 3. Clear marks on surviving values
// CLOBBER SAFETY: Uses JSGC.loop_idx/loop_max for loop state across Mark calls.
Function.JSRT_GC_Collect {
    Body: {
        IfCondition EqualTo(JSGC.mb_enabled, 0) ThenBlock: { ReturnValue(0) }
        // Re-entrancy guard
        IfCondition EqualTo(JSGC.collecting, 1) ThenBlock: { ReturnValue(0) }
        JSGC.collecting = 1

        // ─── MARK PHASE ───

        // Mark singletons (these must never be freed)
        JSRT_GC_Mark(JSRTState.undef_val)
        JSRT_GC_Mark(JSRTState.null_val)
        JSRT_GC_Mark(JSRTState.true_val)
        JSRT_GC_Mark(JSRTState.false_val)

        // Mark VM stack (all values currently on the execution stack)
        JSGC.loop_idx = 0
        JSGC.loop_max = JSVMState.sp
        WhileLoop LessThan(JSGC.loop_idx, JSGC.loop_max) {
            sval = Dereference(Add(JSVMState.stack, Multiply(JSGC.loop_idx, 8)))
            JSRT_GC_Mark(sval)
            JSGC.loop_idx = Add(JSGC.loop_idx, 1)
        }

        // Mark globals (XSHash — walk all buckets)
        IfCondition NotEqual(JSVMState.globals, 0) ThenBlock: {
            JSRT_GC_MarkHash(JSVMState.globals)
        }

        // Mark global value slots (gvals array)
        IfCondition NotEqual(JSVMState.gvals, 0) ThenBlock: {
            JSGC.loop_idx = 0
            JSGC.loop_max = JSVMState.gvar_count
            WhileLoop LessThan(JSGC.loop_idx, JSGC.loop_max) {
                gval = Dereference(Add(JSVMState.gvals, Multiply(JSGC.loop_idx, 8)))
                IfCondition NotEqual(gval, 0) ThenBlock: {
                    JSRT_GC_Mark(gval)
                }
                JSGC.loop_idx = Add(JSGC.loop_idx, 1)
            }
        }

        // ─── SWEEP PHASE ───
        JSGC.loop_idx = 0
        JSGC.loop_max = JSRTState.val_count
        WhileLoop LessThan(JSGC.loop_idx, JSGC.loop_max) {
            vaddr = Add(JSRTState.val_pool, Multiply(JSGC.loop_idx, JSRTConst.VAL_SIZE))
            tag = Dereference(vaddr)

            IfCondition GreaterEqual(tag, 256) ThenBlock: {
                // Marked — unmark (clear bit 8)
                StoreValue(vaddr, Subtract(tag, 256))
            } ElseBlock: {
                // Not marked — check if it's a valid type (0-8) vs. free-list node (pointer)
                IfCondition LessEqual(tag, 8) ThenBlock: {
                    // Skip singletons (they should be marked, but double-check)
                    IfCondition NotEqual(vaddr, JSRTState.undef_val) ThenBlock: {
                    IfCondition NotEqual(vaddr, JSRTState.null_val) ThenBlock: {
                    IfCondition NotEqual(vaddr, JSRTState.true_val) ThenBlock: {
                    IfCondition NotEqual(vaddr, JSRTState.false_val) ThenBlock: {
                        // Unmarked, valid type — free it
                        JSRT__FreeValue(vaddr)
                        JSGC.total_freed = Add(JSGC.total_freed, 1)
                    } } } }
                }
            }
            JSGC.loop_idx = Add(JSGC.loop_idx, 1)
        }

        JSGC.total_swept = Add(JSGC.total_swept, 1)
        JSGC.collecting = 0
    }
}

// Emergency flush — trigger full GC collection.
// Called when value pool is exhausted and we need slots back.
Function.JSRT_GC_FlushMailbox {
    Body: {
        JSRT_GC_Collect()
    }
}

// =============================================================================
// VALUE CREATION
// =============================================================================

// Create a NUMBER JSValue from an integer. Converts to IEEE 754 double bits.
Function.JSRT_CreateNumber {
    Input: n: Integer
    Output: Address
    Body: {
        save_n = n
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(val, JSType.NUMBER)
        fbits = Float_FromInt(save_n)
        StoreValue(Add(val, 8), fbits)
        ReturnValue(val)
    }
}

// Create a NUMBER JSValue from raw IEEE 754 double bits (no conversion).
Function.JSRT_CreateFloat {
    Input: bits: Integer
    Output: Address
    Body: {
        save_bits = bits
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(val, JSType.NUMBER)
        StoreValue(Add(val, 8), save_bits)
        ReturnValue(val)
    }
}

// Create a STRING JSValue. Copies the string so the value owns its data.
// ptr must be a null-terminated string. Returns pointer to JSValue.
Function.JSRT_CreateString {
    Input: ptr: Address
    Output: Address
    Body: {
        save_ptr = ptr
        IfCondition EqualTo(save_ptr, 0) ThenBlock: {
            // Null pointer — create empty string
            val = JSRT__AllocValue()
            IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
            empty = Allocate(1)
            SetByte(empty, 0, 0)
            StoreValue(val, JSType.STRING)
            StoreValue(Add(val, 8), empty)
            ReturnValue(val)
        }
        slen = StringLength(save_ptr)
        buf_sz = Add(slen, 1)
        buf = Allocate(buf_sz)
        MemoryCopy(buf, save_ptr, slen)
        SetByte(buf, slen, 0)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.STRING)
        StoreValue(Add(val, 8), buf)
        ReturnValue(val)
    }
}

// Create a STRING JSValue from a pointer and length (not necessarily null-terminated).
Function.JSRT_CreateStringLen {
    Input: ptr: Address
    Input: len: Integer
    Output: Address
    Body: {
        save_ptr = ptr
        save_len = len
        buf_sz = Add(save_len, 1)
        buf = Allocate(buf_sz)
        IfCondition GreaterThan(save_len, 0) ThenBlock: {
            MemoryCopy(buf, save_ptr, save_len)
        }
        SetByte(buf, save_len, 0)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.STRING)
        StoreValue(Add(val, 8), buf)
        ReturnValue(val)
    }
}

// Create a BOOLEAN JSValue. Returns singleton true_val or false_val.
Function.JSRT_CreateBool {
    Input: b: Integer
    Output: Address
    Body: {
        IfCondition NotEqual(b, 0) ThenBlock: {
            ReturnValue(JSRTState.true_val)
        }
        ReturnValue(JSRTState.false_val)
    }
}

// Create an OBJECT JSValue. Uses XSHash for property storage.
// Returns pointer to JSValue.
Function.JSRT_CreateObject {
    Output: Address
    Body: {
        hash = XSHash.XCreate(32)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.OBJECT)
        StoreValue(Add(val, 8), hash)
        ReturnValue(val)
    }
}

// Create an ARRAY JSValue. Uses XArray for element storage.
// Returns pointer to JSValue.
Function.JSRT_CreateArray {
    Output: Address
    Body: {
        arr = XArray.XCreate(16)
        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.ARRAY)
        StoreValue(Add(val, 8), arr)
        ReturnValue(val)
    }
}

// Create a FUNCTION JSValue. Allocates a 48-byte function descriptor.
// bc_off = bytecode offset, params = param count, locals = local count,
// name = pointer to name string (null-terminated).
Function.JSRT_CreateFunc {
    Input: bc_off: Integer
    Input: params: Integer
    Input: locals: Integer
    Input: name: Address
    Output: Address
    Body: {
        save_bc = bc_off
        save_params = params
        save_locals = locals
        save_name = name
        // Allocate 48-byte function descriptor
        desc = Allocate(JSRTConst.FUNC_DESC_SZ)
        MemorySet(desc, 0, JSRTConst.FUNC_DESC_SZ)
        // Offset 0: bytecode_offset
        StoreValue(desc, save_bc)
        // Offset 8: param_count
        StoreValue(Add(desc, 8), save_params)
        // Offset 16: local_count
        StoreValue(Add(desc, 16), save_locals)
        // Offset 24: name_ptr
        StoreValue(Add(desc, 24), save_name)
        // Offset 32: name_len
        IfCondition NotEqual(save_name, 0) ThenBlock: {
            nlen = StringLength(save_name)
            StoreValue(Add(desc, 32), nlen)
        }
        // Offset 40: closure_env (0 for now)
        StoreValue(Add(desc, 40), 0)
        // Offset 48: prototype JSValue ptr (0 = none)
        // NOTE: Default prototype is created lazily in JSRT_FuncPropGet
        // when "prototype" is first accessed, to avoid cost for non-constructors.

        val = JSRT__AllocValue()
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(val, JSType.FUNCTION)
        StoreValue(Add(val, 8), desc)
        ReturnValue(val)
    }
}

// =============================================================================
// VALUE ACCESS
// =============================================================================

// Get the type tag of a JSValue. Returns JSType constant.
Function.JSRT_GetType {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(JSType.UNDEFINED)
        }
        ReturnValue(Dereference(save_val))
    }
}

// Get the payload of a JSValue (raw 8-byte value at offset 8).
Function.JSRT_GetPayload {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Dereference(Add(save_val, 8)))
    }
}

// =============================================================================
// TRUTHINESS — JSRT_IsTruthy
// undefined=false, null=false, false=false, 0=false, ""=false, else=true
// =============================================================================
Function.JSRT_IsTruthy {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition EqualTo(save_val, 0) ThenBlock: {
            ReturnValue(0)
        }
        vtype = Dereference(save_val)
        // undefined -> false
        IfCondition EqualTo(vtype, JSType.UNDEFINED) ThenBlock: {
            ReturnValue(0)
        }
        // null -> false
        IfCondition EqualTo(vtype, JSType.NULL) ThenBlock: {
            ReturnValue(0)
        }
        // boolean -> check payload
        IfCondition EqualTo(vtype, JSType.BOOLEAN) ThenBlock: {
            bval = Dereference(Add(save_val, 8))
            IfCondition EqualTo(bval, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // number -> +0, -0, NaN are false (IEEE 754 double bits)
        IfCondition EqualTo(vtype, JSType.NUMBER) ThenBlock: {
            nbits = Dereference(Add(save_val, 8))
            // +0 and -0 are falsy: Float_Eq handles both ±0
            is_zero = Float_Eq(nbits, Float_FromInt(0))
            IfCondition EqualTo(is_zero, 1) ThenBlock: {
                ReturnValue(0)
            }
            // NaN is falsy: NaN != NaN
            is_nan = Float_Ne(nbits, nbits)
            IfCondition EqualTo(is_nan, 1) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // string -> "" is false
        IfCondition EqualTo(vtype, JSType.STRING) ThenBlock: {
            sptr = Dereference(Add(save_val, 8))
            IfCondition EqualTo(sptr, 0) ThenBlock: {
                ReturnValue(0)
            }
            first_ch = GetByte(sptr, 0)
            IfCondition EqualTo(first_ch, 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        // object, array, function -> always truthy
        ReturnValue(1)
    }
}
