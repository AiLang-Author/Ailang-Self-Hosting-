// Library.JSVM.ailang — JavaScript bytecode interpreter (virtual machine)
// Branch (switch) dispatch over ~50 opcodes. Maintains a value stack, call frame
// stack, global variable table (XSHash), and executes compiled bytecode from
// JSCompiler. Pattern modeled after CPU6502 (dispatch loop, register state,
// step/run).
//
// Uses JSRuntime for value creation, arithmetic, comparison, type coercion,
// and object/array manipulation. The JSVM only manages execution state:
// program counter, value stack, call frames, globals hash.
//
// CLOBBER SAFETY: Every function saves Input params to locals on the FIRST
// line of Body. Complex expressions broken into steps. JSVMTmp fields
// guarded with push/pop across recursive calls.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Browser.JSRuntime
LibraryImport.Browser.JSCompiler
LibraryImport.Browser.JSBridge
LibraryImport.Browser.JSJIT
LibraryImport.Arena
LibraryImport.XArrays
LibraryImport.StringUtils
LibraryImport.HashMap

// =============================================================================
// VM CONSTANTS
// =============================================================================
FixedPool.JSVMConst {
    "MAX_STACK":     Initialize=4096
    "MAX_FRAMES":    Initialize=256
    "FRAME_SIZE":    Initialize=48
}

// =============================================================================
// VM STATE
// =============================================================================
FixedPool.JSVMState {
    "stack":         Initialize=0
    "sp":            Initialize=0
    "frames":        Initialize=0
    "fp":            Initialize=0
    "code":          Initialize=0
    "code_len":      Initialize=0
    "pc":            Initialize=0
    "const_pool":    Initialize=0
    "const_count":   Initialize=0
    "globals":       Initialize=0
    "halted":        Initialize=0
    "error":         Initialize=0
    "steps":         Initialize=0
    "max_steps":     Initialize=1000000
    "exc_stack":     Initialize=0
    "exc_sp":        Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.JSVMTmp {
    "idx":       Initialize=0
    "type":      Initialize=0
    "ptr":       Initialize=0
    "len":       Initialize=0
    "val":       Initialize=0
    "val2":      Initialize=0
    "addr":      Initialize=0
    "op":        Initialize=0
    "done":      Initialize=0
    "count":     Initialize=0
    "result":    Initialize=0
}

// Generator execution state — tracks which generator is currently running
FixedPool.JSVMGen {
    "active_gs":    Initialize=0
    "active_genval": Initialize=0
    "caller_pc":    Initialize=0
    "caller_sp":    Initialize=0
    "caller_fp":    Initialize=0
    "caller_stack": Initialize=0
    "caller_frames": Initialize=0
    "is_gen_exec":  Initialize=0
}

// =============================================================================
// VM STACK — save/restore values across calls
// =============================================================================
FixedPool.JSVMStack {
    "pool":      Initialize=0
    "sp":        Initialize=0
    "capacity":  Initialize=0
    "tmp_val":   Initialize=0
    "tmp_addr":  Initialize=0
}

// =============================================================================
// STACK PUSH / POP (for saving temporaries across calls)
// =============================================================================
Function.JSVM__Push {
    Input: val: Integer
    Output: Integer
    Body: {
        JSVMStack.tmp_val = val
        JSVMStack.tmp_addr = Add(JSVMStack.pool, Multiply(JSVMStack.sp, 8))
        StoreValue(JSVMStack.tmp_addr, JSVMStack.tmp_val)
        JSVMStack.sp = Add(JSVMStack.sp, 1)
        ReturnValue(0)
    }
}

Function.JSVM__Pop {
    Output: Integer
    Body: {
        JSVMStack.sp = Subtract(JSVMStack.sp, 1)
        ReturnValue(Dereference(Add(JSVMStack.pool, Multiply(JSVMStack.sp, 8))))
    }
}

// =============================================================================
// VALUE STACK OPERATIONS — push/pop JSValue pointers
// =============================================================================

Function.JSVM__StackPush {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition GreaterEqual(JSVMState.sp, JSVMConst.MAX_STACK) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(-1)
        }
        IfCondition LessThan(JSVMState.sp, 0) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(-1)
        }
        saddr = Add(JSVMState.stack, Multiply(JSVMState.sp, 8))
        StoreValue(saddr, save_val)
        JSVMState.sp = Add(JSVMState.sp, 1)
        ReturnValue(0)
    }
}

Function.JSVM__StackPop {
    Output: Address
    Body: {
        IfCondition LessEqual(JSVMState.sp, 0) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(JSRT_Undefined())
        }
        JSVMState.sp = Subtract(JSVMState.sp, 1)
        saddr = Add(JSVMState.stack, Multiply(JSVMState.sp, 8))
        ReturnValue(Dereference(saddr))
    }
}

Function.JSVM__StackPeek {
    Output: Address
    Body: {
        IfCondition LessEqual(JSVMState.sp, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        idx = Subtract(JSVMState.sp, 1)
        saddr = Add(JSVMState.stack, Multiply(idx, 8))
        ReturnValue(Dereference(saddr))
    }
}

// =============================================================================
// BYTECODE READING HELPERS
// =============================================================================

// Read one byte at PC, advance PC
Function.JSVM__ReadByte {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(JSVMState.pc, JSVMState.code_len) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(0)
        }
        b = GetByte(JSVMState.code, JSVMState.pc)
        JSVMState.pc = Add(JSVMState.pc, 1)
        ReturnValue(b)
    }
}

// Read 16-bit big-endian operand (2 bytes), advance PC by 2
Function.JSVM__Read16 {
    Output: Integer
    Body: {
        hi = JSVM__ReadByte()
        lo = JSVM__ReadByte()
        ReturnValue(Add(Multiply(hi, 256), lo))
    }
}

// =============================================================================
// CALL FRAME HELPERS
// Frame layout (40 bytes):
//   Offset 0:  return_pc (8)
//   Offset 8:  return_sp (8)
//   Offset 16: locals_base (8)
//   Offset 24: param_count (8)
//   Offset 32: local_count (8)
// =============================================================================

// Get pointer to current frame
Function.JSVM__CurFrame {
    Output: Address
    Body: {
        IfCondition LessEqual(JSVMState.fp, 0) ThenBlock: {
            ReturnValue(0)
        }
        fidx = Subtract(JSVMState.fp, 1)
        ReturnValue(Add(JSVMState.frames, Multiply(fidx, JSVMConst.FRAME_SIZE)))
    }
}

// Push a new call frame
Function.JSVM__PushFrame {
    Input: ret_pc: Integer
    Input: ret_sp: Integer
    Input: locals_base: Integer
    Input: param_count: Integer
    Input: local_count: Integer
    Output: Integer
    Body: {
        save_rpc = ret_pc
        save_rsp = ret_sp
        save_lb = locals_base
        save_pc = param_count
        save_lc = local_count
        IfCondition GreaterEqual(JSVMState.fp, JSVMConst.MAX_FRAMES) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(-1)
        }
        faddr = Add(JSVMState.frames, Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE))
        StoreValue(faddr, save_rpc)
        StoreValue(Add(faddr, 8), save_rsp)
        StoreValue(Add(faddr, 16), save_lb)
        StoreValue(Add(faddr, 24), save_pc)
        StoreValue(Add(faddr, 32), save_lc)
        StoreValue(Add(faddr, 40), 0)
        JSVMState.fp = Add(JSVMState.fp, 1)
        ReturnValue(0)
    }
}

// Pop call frame, return pointer to it for reading saved values
Function.JSVM__PopFrame {
    Output: Address
    Body: {
        IfCondition LessEqual(JSVMState.fp, 0) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(0)
        }
        JSVMState.fp = Subtract(JSVMState.fp, 1)
        ReturnValue(Add(JSVMState.frames, Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)))
    }
}

// =============================================================================
// CONSTANT POOL ACCESS
// Constant pool entries are 16 bytes: [type:8][payload:8]
// type: 1=NUMBER, 2=STRING, 3=FUNCTION
// =============================================================================

Function.JSVM__GetConstType {
    Input: idx: Integer
    Output: Integer
    Body: {
        save_idx = idx
        base = Add(JSVMState.const_pool, Multiply(save_idx, 16))
        ReturnValue(Dereference(base))
    }
}

Function.JSVM__GetConstPayload {
    Input: idx: Integer
    Output: Integer
    Body: {
        save_idx = idx
        base = Add(JSVMState.const_pool, Multiply(save_idx, 16))
        ReturnValue(Dereference(Add(base, 8)))
    }
}

// Create a JSValue from a constant pool entry
Function.JSVM__LoadConst {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        IfCondition Or(LessThan(save_idx, 0), GreaterEqual(save_idx, JSVMState.const_count)) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ctype = JSVM__GetConstType(save_idx)
        cpay = JSVM__GetConstPayload(save_idx)

        // NUMBER (type=1)
        IfCondition EqualTo(ctype, 1) ThenBlock: {
            ReturnValue(JSRT_CreateNumber(cpay))
        }

        // STRING (type=2) — payload is pointer to null-terminated string
        IfCondition EqualTo(ctype, 2) ThenBlock: {
            ReturnValue(JSRT_CreateString(cpay))
        }

        // FUNCTION (type=3) — payload is pointer to function descriptor
        // The descriptor layout from JSCompiler is:
        //   Offset 0:  bytecode_offset (8)
        //   Offset 8:  param_count (8)
        //   Offset 16: local_count (8)
        //   Offset 24: name_ptr (8)
        //   Offset 32: name_len (8)
        // JSRuntime's JSRT_CreateFunc expects (bc_off, params, locals, name)
        IfCondition EqualTo(ctype, 3) ThenBlock: {
            f_bc = Dereference(cpay)
            f_params = Dereference(Add(cpay, 8))
            f_locals = Dereference(Add(cpay, 16))
            f_name = Dereference(Add(cpay, 24))
            ReturnValue(JSRT_CreateFunc(f_bc, f_params, f_locals, f_name))
        }

        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// LOCAL VARIABLE ACCESS (relative to current frame's locals_base)
// =============================================================================

Function.JSVM__GetLocal {
    Input: slot: Integer
    Output: Address
    Body: {
        save_slot = slot
        frame = JSVM__CurFrame()
        IfCondition EqualTo(frame, 0) ThenBlock: {
            // No frame — use absolute slot (top-level code)
            saddr = Add(JSVMState.stack, Multiply(save_slot, 8))
            ReturnValue(Dereference(saddr))
        }
        lb = Dereference(Add(frame, 16))
        abs_idx = Add(lb, save_slot)
        saddr = Add(JSVMState.stack, Multiply(abs_idx, 8))
        ReturnValue(Dereference(saddr))
    }
}

Function.JSVM__SetLocal {
    Input: slot: Integer
    Input: val: Address
    Output: Integer
    Body: {
        save_slot = slot
        save_val = val
        frame = JSVM__CurFrame()
        IfCondition EqualTo(frame, 0) ThenBlock: {
            saddr = Add(JSVMState.stack, Multiply(save_slot, 8))
            StoreValue(saddr, save_val)
            ReturnValue(0)
        }
        lb = Dereference(Add(frame, 16))
        abs_idx = Add(lb, save_slot)
        saddr = Add(JSVMState.stack, Multiply(abs_idx, 8))
        StoreValue(saddr, save_val)
        ReturnValue(0)
    }
}

// =============================================================================
// GLOBAL VARIABLE ACCESS (via XSHash)
// name must be a null-terminated string pointer
// =============================================================================

Function.JSVM__GetGlobal {
    Input: name: Address
    Output: Address
    Body: {
        save_name = name
        IfCondition EqualTo(JSVMState.globals, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        result = XSHash.XLookup(JSVMState.globals, save_name)
        IfCondition EqualTo(result, XArrays.XNULL) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(result)
    }
}

Function.JSVM__SetGlobal {
    Input: name: Address
    Input: val: Address
    Output: Integer
    Body: {
        save_name = name
        save_val = val
        IfCondition EqualTo(JSVMState.globals, 0) ThenBlock: {
            ReturnValue(0)
        }
        XSHash.XInsert(JSVMState.globals, save_name, save_val)
        ReturnValue(1)
    }
}

// =============================================================================
// INIT — allocate all VM memory structures
// =============================================================================
Function.JSVM_Init {
    Output: Integer
    Body: {
        // Value stack (4096 x 8 bytes = 32768)
        ssz = Multiply(JSVMConst.MAX_STACK, 8)
        JSVMState.stack = Allocate(ssz)
        MemorySet(JSVMState.stack, 0, ssz)

        // Call frame stack (256 x 40 bytes = 10240)
        fsz = Multiply(JSVMConst.MAX_FRAMES, JSVMConst.FRAME_SIZE)
        JSVMState.frames = Allocate(fsz)
        MemorySet(JSVMState.frames, 0, fsz)

        // Global variable hash
        JSVMState.globals = XSHash.XCreate(256)

        // VM temp stack (2048 entries x 8 bytes)
        JSVMStack.pool = Allocate(16384)
        JSVMStack.capacity = 2048
        JSVMStack.sp = 0

        // Exception handler stack (16 entries x 16 bytes = 256)
        // Each entry: [catch_addr (8 bytes), saved_sp (8 bytes)]
        JSVMState.exc_stack = Allocate(256)
        MemorySet(JSVMState.exc_stack, 0, 256)
        JSVMState.exc_sp = 0

        // Reset runtime state
        JSVMState.sp = 0
        JSVMState.fp = 0
        JSVMState.pc = 0
        JSVMState.halted = 0
        JSVMState.error = 0
        JSVMState.steps = 0
        JSVMState.code = 0
        JSVMState.code_len = 0
        JSVMState.const_pool = 0
        JSVMState.const_count = 0

        // Generator state
        JSVMGen.is_gen_exec = 0
        JSVMGen.active_gs = 0

        // Initialize JIT compiler (mmap executable buffers, entry table)
        JIT_Init()

        ReturnValue(1)
    }
}

// =============================================================================
// RESET — clear runtime state for re-execution
// =============================================================================
Function.JSVM_Reset {
    Output: Integer
    Body: {
        ssz = Multiply(JSVMConst.MAX_STACK, 8)
        MemorySet(JSVMState.stack, 0, ssz)
        fsz = Multiply(JSVMConst.MAX_FRAMES, JSVMConst.FRAME_SIZE)
        MemorySet(JSVMState.frames, 0, fsz)
        JSVMState.sp = 0
        JSVMState.fp = 0
        JSVMState.pc = 0
        JSVMState.halted = 0
        JSVMState.error = 0
        JSVMState.steps = 0
        JSVMState.exc_sp = 0
        JSVMStack.sp = 0
        JSVMGen.is_gen_exec = 0
        JSVMGen.active_gs = 0
        ReturnValue(0)
    }
}

// =============================================================================
// LOAD — load compiled bytecode and constant pool into VM
// =============================================================================
Function.JSVM_Load {
    Input: code: Address
    Input: code_len: Integer
    Input: const_pool: Address
    Input: const_count: Integer
    Output: Integer
    Body: {
        save_code = code
        save_len = code_len
        save_cp = const_pool
        save_cc = const_count
        JSVMState.code = save_code
        JSVMState.code_len = save_len
        JSVMState.const_pool = save_cp
        JSVMState.const_count = save_cc
        JSVMState.pc = 0
        JSVMState.sp = 0
        JSVMState.fp = 0
        JSVMState.halted = 0
        JSVMState.error = 0
        JSVMState.steps = 0
        ReturnValue(1)
    }
}

// =============================================================================
// STRING METHOD DISPATCH — execute string methods with receiver
// =============================================================================
Function.JSVM__DispatchStringMethod {
    Input: method_id: Integer
    Input: receiver: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_id = method_id
        save_recv = receiver
        save_args = args
        save_argc = argc

        // Get the raw string pointer from receiver JSValue
        // (may be 0 for static methods like String.fromCharCode)
        str_ptr = 0
        str_len = 0
        IfCondition NotEqual(save_recv, 0) ThenBlock: {
            recv_type = JSRT_GetType(save_recv)
            IfCondition EqualTo(recv_type, JSType.STRING) ThenBlock: {
                str_ptr = JSRT_GetPayload(save_recv)
                str_len = StringLength(str_ptr)
            }
        }

        // ─── charAt (62) ───
        IfCondition EqualTo(save_id, 62) ThenBlock: {
            idx = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                idx = JSRT_ToNumber(a0)
            }
            oob = 0
            IfCondition LessThan(idx, 0) ThenBlock: { oob = 1 }
            IfCondition GreaterEqual(idx, str_len) ThenBlock: { oob = 1 }
            IfCondition EqualTo(oob, 1) ThenBlock: {
                // Out of bounds — return empty string
                ebuf = Allocate(1)
                SetByte(ebuf, 0, 0)
                ReturnValue(JSRT_CreateString(ebuf))
            }
            cbuf = Allocate(2)
            SetByte(cbuf, 0, GetByte(str_ptr, idx))
            SetByte(cbuf, 1, 0)
            ReturnValue(JSRT_CreateString(cbuf))
        }

        // ─── charCodeAt (63) ───
        IfCondition EqualTo(save_id, 63) ThenBlock: {
            idx = 0
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                idx = JSRT_ToNumber(a0)
            }
            oob = 0
            IfCondition LessThan(idx, 0) ThenBlock: { oob = 1 }
            IfCondition GreaterEqual(idx, str_len) ThenBlock: { oob = 1 }
            IfCondition EqualTo(oob, 1) ThenBlock: {
                // NaN → return -1 (integer-only engine, NaN not representable)
                ReturnValue(JSRT_CreateNumber(-1))
            }
            code = GetByte(str_ptr, idx)
            ReturnValue(JSRT_CreateNumber(code))
        }

        // ─── indexOf (64) ───
        IfCondition EqualTo(save_id, 64) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(-1))
            }
            a0 = Dereference(save_args)
            search_ptr = JSRT_GetPayload(a0)
            search_len = StringLength(search_ptr)
            IfCondition EqualTo(search_len, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(0))
            }
            // Linear search
            si = 0
            found = -1
            WhileLoop LessEqual(Add(si, search_len), str_len) {
                IfCondition EqualTo(found, -1) ThenBlock: {
                    match = 1
                    mi = 0
                    WhileLoop LessThan(mi, search_len) {
                        IfCondition NotEqual(GetByte(str_ptr, Add(si, mi)), GetByte(search_ptr, mi)) ThenBlock: {
                            match = 0
                            mi = search_len
                        }
                        mi = Add(mi, 1)
                    }
                    IfCondition EqualTo(match, 1) ThenBlock: {
                        found = si
                    }
                }
                si = Add(si, 1)
            }
            ReturnValue(JSRT_CreateNumber(found))
        }

        // ─── substring (65) ───
        IfCondition EqualTo(save_id, 65) ThenBlock: {
            start = 0
            end_idx = str_len
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                start = JSRT_ToNumber(a0)
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                a1 = Dereference(Add(save_args, 8))
                end_idx = JSRT_ToNumber(a1)
            }
            // Clamp
            IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
            IfCondition GreaterThan(start, str_len) ThenBlock: { start = str_len }
            IfCondition LessThan(end_idx, 0) ThenBlock: { end_idx = 0 }
            IfCondition GreaterThan(end_idx, str_len) ThenBlock: { end_idx = str_len }
            // Swap if start > end
            IfCondition GreaterThan(start, end_idx) ThenBlock: {
                tmp_s = start
                start = end_idx
                end_idx = tmp_s
            }
            sub_len = Subtract(end_idx, start)
            ReturnValue(JSRT_CreateStringLen(Add(str_ptr, start), sub_len))
        }

        // ─── slice (66) ───
        IfCondition EqualTo(save_id, 66) ThenBlock: {
            start = 0
            end_idx = str_len
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                start = JSRT_ToNumber(a0)
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                a1 = Dereference(Add(save_args, 8))
                end_idx = JSRT_ToNumber(a1)
            }
            // Negative indices
            IfCondition LessThan(start, 0) ThenBlock: {
                start = Add(str_len, start)
                IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
            }
            IfCondition LessThan(end_idx, 0) ThenBlock: {
                end_idx = Add(str_len, end_idx)
                IfCondition LessThan(end_idx, 0) ThenBlock: { end_idx = 0 }
            }
            IfCondition GreaterThan(start, str_len) ThenBlock: { start = str_len }
            IfCondition GreaterThan(end_idx, str_len) ThenBlock: { end_idx = str_len }
            IfCondition GreaterEqual(start, end_idx) ThenBlock: {
                ebuf = Allocate(1)
                SetByte(ebuf, 0, 0)
                ReturnValue(JSRT_CreateString(ebuf))
            }
            sub_len = Subtract(end_idx, start)
            ReturnValue(JSRT_CreateStringLen(Add(str_ptr, start), sub_len))
        }

        // ─── replace (67) — simple first-occurrence string replace ───
        IfCondition EqualTo(save_id, 67) ThenBlock: {
            IfCondition LessThan(save_argc, 2) ThenBlock: {
                ReturnValue(save_recv)
            }
            a0 = Dereference(save_args)
            a1 = Dereference(Add(save_args, 8))
            search_ptr = JSRT_GetPayload(a0)
            repl_ptr = JSRT_GetPayload(a1)
            search_len = StringLength(search_ptr)
            repl_len = StringLength(repl_ptr)
            // Find first occurrence
            si = 0
            found = -1
            WhileLoop LessEqual(Add(si, search_len), str_len) {
                IfCondition EqualTo(found, -1) ThenBlock: {
                    match = 1
                    mi = 0
                    WhileLoop LessThan(mi, search_len) {
                        IfCondition NotEqual(GetByte(str_ptr, Add(si, mi)), GetByte(search_ptr, mi)) ThenBlock: {
                            match = 0
                            mi = search_len
                        }
                        mi = Add(mi, 1)
                    }
                    IfCondition EqualTo(match, 1) ThenBlock: { found = si }
                }
                si = Add(si, 1)
            }
            IfCondition EqualTo(found, -1) ThenBlock: {
                ReturnValue(save_recv)
            }
            // Build result: prefix + replacement + suffix
            new_len = Add(Subtract(str_len, search_len), repl_len)
            rbuf = Allocate(Add(new_len, 1))
            IfCondition GreaterThan(found, 0) ThenBlock: {
                MemoryCopy(rbuf, str_ptr, found)
            }
            IfCondition GreaterThan(repl_len, 0) ThenBlock: {
                MemoryCopy(Add(rbuf, found), repl_ptr, repl_len)
            }
            suffix_start = Add(found, search_len)
            suffix_len = Subtract(str_len, suffix_start)
            IfCondition GreaterThan(suffix_len, 0) ThenBlock: {
                MemoryCopy(Add(rbuf, Add(found, repl_len)), Add(str_ptr, suffix_start), suffix_len)
            }
            SetByte(rbuf, new_len, 0)
            ReturnValue(JSRT_CreateString(rbuf))
        }

        // ─── split (68) ───
        IfCondition EqualTo(save_id, 68) ThenBlock: {
            result_arr = JSRT_CreateArray()
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                JSRT_ArrPush(result_arr, save_recv)
                ReturnValue(result_arr)
            }
            a0 = Dereference(save_args)
            sep_ptr = JSRT_GetPayload(a0)
            sep_len = StringLength(sep_ptr)
            IfCondition EqualTo(sep_len, 0) ThenBlock: {
                // Split into chars
                ci = 0
                WhileLoop LessThan(ci, str_len) {
                    ch_val = JSRT_CreateStringLen(Add(str_ptr, ci), 1)
                    JSRT_ArrPush(result_arr, ch_val)
                    ci = Add(ci, 1)
                }
                ReturnValue(result_arr)
            }
            // Split by separator
            pos = 0
            WhileLoop LessEqual(pos, str_len) {
                // Find next separator
                found_at = -1
                si = pos
                WhileLoop LessEqual(Add(si, sep_len), str_len) {
                    IfCondition EqualTo(found_at, -1) ThenBlock: {
                        match = 1
                        mi = 0
                        WhileLoop LessThan(mi, sep_len) {
                            IfCondition NotEqual(GetByte(str_ptr, Add(si, mi)), GetByte(sep_ptr, mi)) ThenBlock: {
                                match = 0
                                mi = sep_len
                            }
                            mi = Add(mi, 1)
                        }
                        IfCondition EqualTo(match, 1) ThenBlock: { found_at = si }
                    }
                    si = Add(si, 1)
                }
                IfCondition EqualTo(found_at, -1) ThenBlock: {
                    // No more separators — push rest
                    part_len = Subtract(str_len, pos)
                    part_val = JSRT_CreateStringLen(Add(str_ptr, pos), part_len)
                    JSRT_ArrPush(result_arr, part_val)
                    pos = Add(str_len, 1)
                } ElseBlock: {
                    part_len = Subtract(found_at, pos)
                    part_val = JSRT_CreateStringLen(Add(str_ptr, pos), part_len)
                    JSRT_ArrPush(result_arr, part_val)
                    pos = Add(found_at, sep_len)
                }
            }
            ReturnValue(result_arr)
        }

        // ─── trim (69) ───
        IfCondition EqualTo(save_id, 69) ThenBlock: {
            // Trim leading whitespace
            ls = 0
            trim_go = 1
            WhileLoop EqualTo(trim_go, 1) {
                IfCondition GreaterEqual(ls, str_len) ThenBlock: {
                    trim_go = 0
                } ElseBlock: {
                    ch = GetByte(str_ptr, ls)
                    is_ws = 0
                    IfCondition EqualTo(ch, 32) ThenBlock: { is_ws = 1 }
                    IfCondition EqualTo(ch, 9) ThenBlock: { is_ws = 1 }
                    IfCondition EqualTo(ch, 10) ThenBlock: { is_ws = 1 }
                    IfCondition EqualTo(ch, 13) ThenBlock: { is_ws = 1 }
                    IfCondition EqualTo(is_ws, 1) ThenBlock: {
                        ls = Add(ls, 1)
                    } ElseBlock: {
                        trim_go = 0
                    }
                }
            }
            // Trim trailing whitespace
            re = str_len
            trim_go = 1
            WhileLoop EqualTo(trim_go, 1) {
                IfCondition LessEqual(re, ls) ThenBlock: {
                    trim_go = 0
                } ElseBlock: {
                    ch = GetByte(str_ptr, Subtract(re, 1))
                    is_ws = 0
                    IfCondition EqualTo(ch, 32) ThenBlock: { is_ws = 1 }
                    IfCondition EqualTo(ch, 9) ThenBlock: { is_ws = 1 }
                    IfCondition EqualTo(ch, 10) ThenBlock: { is_ws = 1 }
                    IfCondition EqualTo(ch, 13) ThenBlock: { is_ws = 1 }
                    IfCondition EqualTo(is_ws, 1) ThenBlock: {
                        re = Subtract(re, 1)
                    } ElseBlock: {
                        trim_go = 0
                    }
                }
            }
            sub_len = Subtract(re, ls)
            ReturnValue(JSRT_CreateStringLen(Add(str_ptr, ls), sub_len))
        }

        // ─── toLowerCase (70) ───
        IfCondition EqualTo(save_id, 70) ThenBlock: {
            lbuf = Allocate(Add(str_len, 1))
            li = 0
            WhileLoop LessThan(li, str_len) {
                ch = GetByte(str_ptr, li)
                SetByte(lbuf, li, ch)
                IfCondition GreaterEqual(ch, 65) ThenBlock: {
                    IfCondition LessEqual(ch, 90) ThenBlock: {
                        SetByte(lbuf, li, Add(ch, 32))
                    }
                }
                li = Add(li, 1)
            }
            SetByte(lbuf, str_len, 0)
            ReturnValue(JSRT_CreateString(lbuf))
        }

        // ─── toUpperCase (71) ───
        IfCondition EqualTo(save_id, 71) ThenBlock: {
            ubuf = Allocate(Add(str_len, 1))
            ui = 0
            WhileLoop LessThan(ui, str_len) {
                ch = GetByte(str_ptr, ui)
                SetByte(ubuf, ui, ch)
                IfCondition GreaterEqual(ch, 97) ThenBlock: {
                    IfCondition LessEqual(ch, 122) ThenBlock: {
                        SetByte(ubuf, ui, Subtract(ch, 32))
                    }
                }
                ui = Add(ui, 1)
            }
            SetByte(ubuf, str_len, 0)
            ReturnValue(JSRT_CreateString(ubuf))
        }

        // ─── String.fromCharCode (72) — static, recv is ignored ───
        IfCondition EqualTo(save_id, 72) ThenBlock: {
            // Build string from char code arguments
            fcbuf = Allocate(Add(save_argc, 1))
            fi = 0
            WhileLoop LessThan(fi, save_argc) {
                a_val = Dereference(Add(save_args, Multiply(fi, 8)))
                code = JSRT_ToNumber(a_val)
                valid_code = 0
                IfCondition GreaterEqual(code, 0) ThenBlock: {
                    IfCondition LessEqual(code, 127) ThenBlock: {
                        valid_code = 1
                    }
                }
                IfCondition EqualTo(valid_code, 1) ThenBlock: {
                    SetByte(fcbuf, fi, code)
                } ElseBlock: {
                    SetByte(fcbuf, fi, 63)
                }
                fi = Add(fi, 1)
            }
            SetByte(fcbuf, save_argc, 0)
            ReturnValue(JSRT_CreateString(fcbuf))
        }

        // ─── substr (73) — substr(start, length) ───
        IfCondition EqualTo(save_id, 73) ThenBlock: {
            start = 0
            sub_count = str_len
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                a0 = Dereference(save_args)
                start = JSRT_ToNumber(a0)
            }
            IfCondition GreaterThan(save_argc, 1) ThenBlock: {
                a1 = Dereference(Add(save_args, 8))
                sub_count = JSRT_ToNumber(a1)
            }
            // Negative start
            IfCondition LessThan(start, 0) ThenBlock: {
                start = Add(str_len, start)
                IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
            }
            IfCondition GreaterThan(start, str_len) ThenBlock: { start = str_len }
            // Clamp length
            IfCondition LessThan(sub_count, 0) ThenBlock: { sub_count = 0 }
            IfCondition GreaterThan(Add(start, sub_count), str_len) ThenBlock: {
                sub_count = Subtract(str_len, start)
            }
            ReturnValue(JSRT_CreateStringLen(Add(str_ptr, start), sub_count))
        }

        // ─── lastIndexOf (74) ───
        IfCondition EqualTo(save_id, 74) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(-1))
            }
            a0 = Dereference(save_args)
            search_ptr = JSRT_GetPayload(a0)
            search_len = StringLength(search_ptr)
            IfCondition EqualTo(search_len, 0) ThenBlock: {
                ReturnValue(JSRT_CreateNumber(str_len))
            }
            // Search from end
            found = -1
            si = Subtract(str_len, search_len)
            WhileLoop GreaterEqual(si, 0) {
                match = 1
                mi = 0
                WhileLoop LessThan(mi, search_len) {
                    IfCondition NotEqual(GetByte(str_ptr, Add(si, mi)), GetByte(search_ptr, mi)) ThenBlock: {
                        match = 0
                        mi = search_len
                    }
                    mi = Add(mi, 1)
                }
                IfCondition EqualTo(match, 1) ThenBlock: {
                    IfCondition EqualTo(found, -1) ThenBlock: {
                        found = si
                    }
                }
                si = Subtract(si, 1)
            }
            ReturnValue(JSRT_CreateNumber(found))
        }

        // ─── concat (75) ───
        IfCondition EqualTo(save_id, 75) ThenBlock: {
            IfCondition EqualTo(save_argc, 0) ThenBlock: {
                ReturnValue(save_recv)
            }
            // Concat all args
            total_len = str_len
            ci = 0
            WhileLoop LessThan(ci, save_argc) {
                a_val = Dereference(Add(save_args, Multiply(ci, 8)))
                a_ptr = JSRT_GetPayload(a_val)
                total_len = Add(total_len, StringLength(a_ptr))
                ci = Add(ci, 1)
            }
            cbuf = Allocate(Add(total_len, 1))
            MemoryCopy(cbuf, str_ptr, str_len)
            cpos = str_len
            ci = 0
            WhileLoop LessThan(ci, save_argc) {
                a_val = Dereference(Add(save_args, Multiply(ci, 8)))
                a_ptr = JSRT_GetPayload(a_val)
                a_len = StringLength(a_ptr)
                IfCondition GreaterThan(a_len, 0) ThenBlock: {
                    MemoryCopy(Add(cbuf, cpos), a_ptr, a_len)
                }
                cpos = Add(cpos, a_len)
                ci = Add(ci, 1)
            }
            SetByte(cbuf, total_len, 0)
            ReturnValue(JSRT_CreateString(cbuf))
        }

        // ─── Array constructor (76) — new Array(n) or Array(a,b,c) ───
        IfCondition EqualTo(save_id, 76) ThenBlock: {
            IfCondition EqualTo(save_argc, 1) ThenBlock: {
                a0 = Dereference(save_args)
                a0_type = JSRT_GetType(a0)
                IfCondition EqualTo(a0_type, JSType.NUMBER) ThenBlock: {
                    // new Array(n) — create array with n empty slots
                    n = JSRT_ToNumber(a0)
                    arr = JSRT_CreateArray()
                    ai = 0
                    WhileLoop LessThan(ai, n) {
                        JSRT_ArrPush(arr, JSRT_Undefined())
                        ai = Add(ai, 1)
                    }
                    ReturnValue(arr)
                }
            }
            // Array(a, b, c) — create array with elements
            arr = JSRT_CreateArray()
            ai = 0
            WhileLoop LessThan(ai, save_argc) {
                a_val = Dereference(Add(save_args, Multiply(ai, 8)))
                JSRT_ArrPush(arr, a_val)
                ai = Add(ai, 1)
            }
            ReturnValue(arr)
        }

        // Unknown method
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// STRING METHOD MATCHING — returns JSNativeID or 0
// =============================================================================
Function.JSVM__MatchStringMethod {
    Input: name: Address
    Output: Integer
    Body: {
        save_name = name
        c0 = GetByte(save_name, 0)
        c1 = GetByte(save_name, 1)

        // charAt (99 104 97 114 65 116 0)
        IfCondition EqualTo(c0, 99) ThenBlock: {
            IfCondition EqualTo(c1, 104) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 97) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 114) ThenBlock: {
                        // charA vs charC
                        c4 = GetByte(save_name, 4)
                        IfCondition EqualTo(c4, 65) ThenBlock: {
                            // charAt (65 116 0)
                            IfCondition EqualTo(GetByte(save_name, 5), 116) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.STR_CHAR_AT)
                                }
                            }
                        }
                        // charCodeAt (67 111 100 101 65 116 0)
                        IfCondition EqualTo(c4, 67) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 111) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 100) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 101) ThenBlock: {
                                        IfCondition EqualTo(GetByte(save_name, 8), 65) ThenBlock: {
                                            IfCondition EqualTo(GetByte(save_name, 9), 116) ThenBlock: {
                                                IfCondition EqualTo(GetByte(save_name, 10), 0) ThenBlock: {
                                                    ReturnValue(JSNativeID.STR_CHAR_CODE_AT)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // concat (99 111 110 99 97 116 0)
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 110) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 99) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 97) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 116) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 0) ThenBlock: {
                                    ReturnValue(JSNativeID.STR_CONCAT)
                                }
                            }
                        }
                    }
                }
            }
        }

        // indexOf (105 110 100 101 120 79 102 0)
        IfCondition EqualTo(c0, 105) ThenBlock: {
            IfCondition EqualTo(c1, 110) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 100) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 101) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 120) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 79) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 102) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 0) ThenBlock: {
                                        ReturnValue(JSNativeID.STR_INDEX_OF)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // substring (115 117 98 115 116 114 105 110 103 0)
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition EqualTo(c1, 117) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 98) ThenBlock: {
                    // substr vs substring
                    c3 = GetByte(save_name, 3)
                    IfCondition EqualTo(c3, 115) ThenBlock: {
                        // substring (115 116 114 105 110 103 0)
                        IfCondition EqualTo(GetByte(save_name, 4), 116) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 114) ThenBlock: {
                                IfCondition EqualTo(GetByte(save_name, 6), 105) ThenBlock: {
                                    IfCondition EqualTo(GetByte(save_name, 7), 110) ThenBlock: {
                                        IfCondition EqualTo(GetByte(save_name, 8), 103) ThenBlock: {
                                            IfCondition EqualTo(GetByte(save_name, 9), 0) ThenBlock: {
                                                ReturnValue(JSNativeID.STR_SUBSTRING)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // substr (114 0)
                    IfCondition EqualTo(c3, 116) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 114) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.STR_SUBSTR)
                            }
                        }
                    }
                }
            }
            // slice (115 108 105 99 101 0)
            IfCondition EqualTo(c1, 108) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 105) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 99) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 101) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.STR_SLICE)
                            }
                        }
                    }
                }
            }
            // split (115 112 108 105 116 0)
            IfCondition EqualTo(c1, 112) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 108) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 105) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 116) ThenBlock: {
                            IfCondition EqualTo(GetByte(save_name, 5), 0) ThenBlock: {
                                ReturnValue(JSNativeID.STR_SPLIT)
                            }
                        }
                    }
                }
            }
        }

        // trim (116 114 105 109 0)
        IfCondition EqualTo(c0, 116) ThenBlock: {
            IfCondition EqualTo(c1, 114) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 105) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 109) ThenBlock: {
                        IfCondition EqualTo(GetByte(save_name, 4), 0) ThenBlock: {
                            ReturnValue(JSNativeID.STR_TRIM)
                        }
                    }
                }
            }
            // toLowerCase (116 111 76 111 ...)
            IfCondition EqualTo(c1, 111) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 76) ThenBlock: {
                    ReturnValue(JSNativeID.STR_TO_LOWER)
                }
                IfCondition EqualTo(GetByte(save_name, 2), 85) ThenBlock: {
                    ReturnValue(JSNativeID.STR_TO_UPPER)
                }
            }
        }

        // replace (114 101 112 108 97 99 101 0)
        IfCondition EqualTo(c0, 114) ThenBlock: {
            IfCondition EqualTo(c1, 101) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 112) ThenBlock: {
                    ReturnValue(JSNativeID.STR_REPLACE)
                }
            }
        }

        // lastIndexOf (108 97 115 116 73 ...)
        IfCondition EqualTo(c0, 108) ThenBlock: {
            IfCondition EqualTo(c1, 97) ThenBlock: {
                IfCondition EqualTo(GetByte(save_name, 2), 115) ThenBlock: {
                    IfCondition EqualTo(GetByte(save_name, 3), 116) ThenBlock: {
                        ReturnValue(JSNativeID.STR_LAST_INDEX_OF)
                    }
                }
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// STEP — execute a single bytecode instruction
// Returns: 1 = still running, 0 = halted, -1 = error
// =============================================================================
Function.JSVM_Step {
    Output: Integer
    Body: {
        // Check halted/error flags
        IfCondition EqualTo(JSVMState.halted, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(JSVMState.error, 1) ThenBlock: { ReturnValue(-1) }

        // Check PC bounds
        IfCondition GreaterEqual(JSVMState.pc, JSVMState.code_len) ThenBlock: {
            JSVMState.halted = 1
            ReturnValue(0)
        }

        // Fetch opcode
        op = JSVM__ReadByte()
        JSVMState.steps = Add(JSVMState.steps, 1)

        // DEBUG TRACE
        PrintMessage("[STEP ")
        PrintNumber(JSVMState.steps)
        PrintMessage(" OP=")
        PrintNumber(op)
        PrintMessage(" SP=")
        PrintNumber(JSVMState.sp)
        PrintMessage("]\n")

        // Check step limit
        IfCondition GreaterEqual(JSVMState.steps, JSVMState.max_steps) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(-1)
        }

        // =====================================================================
        // OPCODE DISPATCH — Branch (switch) for O(1) dispatch
        // =====================================================================
        Branch op {

            // HALT (0)
            Case 0: {
                JSVMState.halted = 1
                ReturnValue(0)
            }

            // PUSH_CONST (1) — 16-bit operand: constant pool index
            Case 1: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // PUSH_UNDEF (2)
            Case 2: {
                JSVM__StackPush(JSRT_Undefined())
                ReturnValue(1)
            }

            // PUSH_NULL (3)
            Case 3: {
                JSVM__StackPush(JSRT_Null())
                ReturnValue(1)
            }

            // PUSH_TRUE (4)
            Case 4: {
                JSVM__StackPush(JSRT_True())
                ReturnValue(1)
            }

            // PUSH_FALSE (5)
            Case 5: {
                JSVM__StackPush(JSRT_False())
                ReturnValue(1)
            }

            // POP (6)
            Case 6: {
                JSVM__StackPop()
                ReturnValue(1)
            }

            // DUP (7) — duplicate top of stack
            Case 7: {
                top = JSVM__StackPeek()
                JSVM__StackPush(top)
                ReturnValue(1)
            }

            // GET_LOCAL (10) — 16-bit operand: local slot index
            Case 10: {
                slot = JSVM__Read16()
                lval = JSVM__GetLocal(slot)
                JSVM__StackPush(lval)
                ReturnValue(1)
            }

            // SET_LOCAL (11) — 16-bit operand: local slot index
            Case 11: {
                slot = JSVM__Read16()
                sval = JSVM__StackPop()
                JSVM__SetLocal(slot, sval)
                ReturnValue(1)
            }

            // GET_GLOBAL (12) — 16-bit operand: constant pool index (string name)
            Case 12: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                gval = JSVM__GetGlobal(cpay)
                JSVM__StackPush(gval)
                ReturnValue(1)
            }

            // SET_GLOBAL (13) — 16-bit operand: constant pool index (string name)
            Case 13: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                sval = JSVM__StackPop()
                JSVM__SetGlobal(cpay, sval)
                ReturnValue(1)
            }

            // GET_PROP (16) — 16-bit operand: constant pool index (property name)
            // Pop object, push object.prop
            // Getter support: if obj has __get_<name>, invoke it.
            Case 16: {
                cidx = JSVM__Read16()
                cpay = JSVM__GetConstPayload(cidx)
                obj = JSVM__StackPop()

                // Handle array.length
                obj_type = JSRT_GetType(obj)
                IfCondition EqualTo(obj_type, JSType.ARRAY) ThenBlock: {
                    // Check if property is "length"
                    // "length" = 108 101 110 103 116 104
                    is_len = 0
                    c0 = GetByte(cpay, 0)
                    IfCondition EqualTo(c0, 108) ThenBlock: {
                        c1 = GetByte(cpay, 1)
                        IfCondition EqualTo(c1, 101) ThenBlock: {
                            c2 = GetByte(cpay, 2)
                            IfCondition EqualTo(c2, 110) ThenBlock: {
                                c3 = GetByte(cpay, 3)
                                IfCondition EqualTo(c3, 103) ThenBlock: {
                                    c4 = GetByte(cpay, 4)
                                    IfCondition EqualTo(c4, 116) ThenBlock: {
                                        c5 = GetByte(cpay, 5)
                                        IfCondition EqualTo(c5, 104) ThenBlock: {
                                            c6 = GetByte(cpay, 6)
                                            IfCondition EqualTo(c6, 0) ThenBlock: {
                                                is_len = 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(is_len, 1) ThenBlock: {
                        alen = JSRT_ArrLen(obj)
                        JSVM__StackPush(JSRT_CreateNumber(alen))
                        ReturnValue(1)
                    }
                }

                // String property/method access
                IfCondition EqualTo(obj_type, JSType.STRING) ThenBlock: {
                    // Check "length" first (108 101 110 103 116 104 0)
                    c0 = GetByte(cpay, 0)
                    IfCondition EqualTo(c0, 108) ThenBlock: {
                        IfCondition EqualTo(GetByte(cpay, 1), 101) ThenBlock: {
                            IfCondition EqualTo(GetByte(cpay, 2), 110) ThenBlock: {
                                IfCondition EqualTo(GetByte(cpay, 3), 103) ThenBlock: {
                                    IfCondition EqualTo(GetByte(cpay, 4), 116) ThenBlock: {
                                        IfCondition EqualTo(GetByte(cpay, 5), 104) ThenBlock: {
                                            IfCondition EqualTo(GetByte(cpay, 6), 0) ThenBlock: {
                                                str_ptr = JSRT_GetPayload(obj)
                                                slen = StringLength(str_ptr)
                                                JSVM__StackPush(JSRT_CreateNumber(slen))
                                                ReturnValue(1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Match string method names and create bound native func
                    str_method_id = JSVM__MatchStringMethod(cpay)
                    IfCondition GreaterThan(str_method_id, 0) ThenBlock: {
                        sm_func = JSBridge__CreateNativeFunc(str_method_id, cpay, 1)
                        JSRT_FuncSetEnv(sm_func, obj)
                        JSVM__StackPush(sm_func)
                        ReturnValue(1)
                    }
                    // Fall through to undefined
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }

                // Check for getter: __get_<name>
                IfCondition EqualTo(obj_type, JSType.OBJECT) ThenBlock: {
                    gk_buf2 = Allocate(128)
                    SetByte(gk_buf2, 0, 95)
                    SetByte(gk_buf2, 1, 95)
                    SetByte(gk_buf2, 2, 103)
                    SetByte(gk_buf2, 3, 101)
                    SetByte(gk_buf2, 4, 116)
                    SetByte(gk_buf2, 5, 95)
                    JSVMTmp.idx = 0
                    JSVMTmp.done = 0
                    WhileLoop EqualTo(JSVMTmp.done, 0) {
                        JSVMTmp.val = GetByte(cpay, JSVMTmp.idx)
                        SetByte(gk_buf2, Add(6, JSVMTmp.idx), JSVMTmp.val)
                        IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                            JSVMTmp.done = 1
                        }
                        JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                    }
                    getter_func = JSRT_ObjGet(obj, gk_buf2)
                    gt = JSRT_GetType(getter_func)
                    IfCondition EqualTo(gt, JSType.FUNCTION) ThenBlock: {
                        // Invoke getter: push func, CALL 0
                        JSVM__StackPush(getter_func)
                        // Simulate CALL with 0 args inline
                        func_bc2 = JSRT_FuncGetBC(getter_func)
                        IfCondition LessThan(func_bc2, 0) ThenBlock: {
                            // Native getter (shouldn't happen, but handle)
                            handler_id2 = Subtract(-1, func_bc2)
                            arg_buf2 = Allocate(8)
                            MemorySet(arg_buf2, 0, 8)
                            native_r = JSRT_CallNative(handler_id2, arg_buf2, 0)
                            JSVM__StackPop()
                            JSVM__StackPush(native_r)
                        } ElseBlock: {
                            func_params2 = JSRT_FuncGetParams(getter_func)
                            func_locals2 = JSRT_FuncGetLocals(getter_func)
                            JSVM__StackPop()
                            save_pc2 = JSVMState.pc
                            save_sp2 = JSVMState.sp
                            locals_base2 = JSVMState.sp
                            JSVM__PushFrame(save_pc2, save_sp2, locals_base2, func_params2, func_locals2)
                            pi2 = 0
                            WhileLoop LessThan(pi2, func_locals2) {
                                JSVM__StackPush(JSRT_Undefined())
                                pi2 = Add(pi2, 1)
                            }
                            JSVMState.pc = func_bc2
                        }
                        ReturnValue(1)
                    }
                }

                pval = JSRT_ObjGet(obj, cpay)
                JSVM__StackPush(pval)
                ReturnValue(1)
            }

            // SET_PROP (17) — 16-bit operand: constant pool index (property name)
            // Stack: [..., object, value]. Pop value, pop object, set prop.
            // DOM interception: if obj has __dom_idx and prop is innerHTML/textContent,
            // JSBridge_SetProp updates the actual DOM tree.
            Case 17: {
                cidx = JSVM__Read16()
                JSVMTmp.ptr = JSVM__GetConstPayload(cidx)
                JSVMTmp.val = JSVM__StackPop()
                JSVMTmp.addr = JSVM__StackPop()
                JSVMTmp.result = JSBridge_SetProp(JSVMTmp.addr, JSVMTmp.ptr, JSVMTmp.val)
                IfCondition EqualTo(JSVMTmp.result, 0) ThenBlock: {
                    JSRT_ObjSet(JSVMTmp.addr, JSVMTmp.ptr, JSVMTmp.val)
                }
                ReturnValue(1)
            }

            // GET_ELEM (18) — pop index, pop array, push array[index]
            Case 18: {
                idx_val = JSVM__StackPop()
                arr_val = JSVM__StackPop()
                idx_num = JSRT_ToNumber(idx_val)
                elem = JSRT_ArrGet(arr_val, idx_num)
                JSVM__StackPush(elem)
                ReturnValue(1)
            }

            // SET_ELEM (19) — pop index, pop array, pop value
            // Stack: [..., value, array, index]
            Case 19: {
                idx_val = JSVM__StackPop()
                arr_val = JSVM__StackPop()
                sval = JSVM__StackPop()
                idx_num = JSRT_ToNumber(idx_val)
                JSRT_ArrSet(arr_val, idx_num, sval)
                ReturnValue(1)
            }

            // ADD (20) — pop b, pop a, push JSRT_Add(a, b)
            Case 20: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Add(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SUB (21)
            Case 21: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Sub(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // MUL (22)
            Case 22: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Mul(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // DIV (23)
            Case 23: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Div(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // MOD (24)
            Case 24: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Mod(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // NEG (25) — negate top of stack
            Case 25: {
                av = JSVM__StackPop()
                result = JSRT_Neg(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // EXP (26) — exponentiation (**)
            Case 26: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Exp(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // EQ (30) — abstract equality
            Case 30: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_AbstractEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // NEQ (31) — abstract inequality
            Case 31: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_AbstractEqual(av, bv)
                IfCondition EqualTo(cmp_int, 0) ThenBlock: {
                    JSVM__StackPush(JSRT_True())
                } ElseBlock: {
                    JSVM__StackPush(JSRT_False())
                }
                ReturnValue(1)
            }

            // LT (32)
            Case 32: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_LessThan(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // GT (33)
            Case 33: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_GreaterThan(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // LTE (34)
            Case 34: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_LessEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // GTE (35)
            Case 35: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_GreaterEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // STRICT_EQ (36)
            Case 36: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_StrictEqual(av, bv)
                result = JSRT_CreateBool(cmp_int)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // STRICT_NEQ (37)
            Case 37: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                cmp_int = JSRT_StrictEqual(av, bv)
                IfCondition EqualTo(cmp_int, 0) ThenBlock: {
                    JSVM__StackPush(JSRT_True())
                } ElseBlock: {
                    JSVM__StackPush(JSRT_False())
                }
                ReturnValue(1)
            }

            // NOT (40) — logical not
            Case 40: {
                av = JSVM__StackPop()
                result = JSRT_Not(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_AND (41)
            Case 41: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_BitAnd(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_OR (42)
            Case 42: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_BitOr(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_XOR (43)
            Case 43: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_BitXor(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // BIT_NOT (44)
            Case 44: {
                av = JSVM__StackPop()
                result = JSRT_BitNot(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SHL (45)
            Case 45: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Shl(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SHR (46)
            Case 46: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Shr(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // USHR (48) — unsigned right shift >>>
            Case 48: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Ushr(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // INSTANCEOF (49)
            Case 49: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                result = JSRT_Instanceof(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // IN (38) — key in obj
            Case 38: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                // av = key (convert to string), bv = object
                key_str = JSRT_ToString(av)
                key_ptr = JSRT_GetPayload(key_str)
                has = JSRT_ObjHas(bv, key_ptr)
                IfCondition EqualTo(has, 1) ThenBlock: {
                    JSVM__StackPush(JSRT_True())
                } ElseBlock: {
                    JSVM__StackPush(JSRT_False())
                }
                ReturnValue(1)
            }

            // TYPEOF (47)
            Case 47: {
                av = JSVM__StackPop()
                result = JSRT_TypeOf(av)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // JMP (50) — unconditional jump, 16-bit target address
            Case 50: {
                target = JSVM__Read16()
                JSVMState.pc = target
                ReturnValue(1)
            }

            // JMP_FALSE (51) — pop value, jump if falsy
            Case 51: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                truth = JSRT_IsTruthy(av)
                IfCondition EqualTo(truth, 0) ThenBlock: {
                    JSVMState.pc = target
                }
                ReturnValue(1)
            }

            // JMP_TRUE (52) — pop value, jump if truthy
            Case 52: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                truth = JSRT_IsTruthy(av)
                IfCondition EqualTo(truth, 1) ThenBlock: {
                    JSVMState.pc = target
                }
                ReturnValue(1)
            }

            // JMP_NULLISH (53) — peek value, jump if NOT null/undefined
            // Used by ?? operator: skip RHS if LHS is not nullish
            Case 53: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                JSVM__StackPush(av)
                IfCondition NotEqual(av, 0) ThenBlock: {
                    vtype = Dereference(av)
                    IfCondition And(NotEqual(vtype, 0), NotEqual(vtype, 1)) ThenBlock: {
                        // Not null (1) and not undefined (0) → jump (keep value)
                        JSVMState.pc = target
                    }
                }
                ReturnValue(1)
            }

            // JMP_IF_NULLISH (54) — peek value, jump if IS null/undefined
            // Used by optional chaining: skip RHS if LHS is nullish
            // If nullish: pop value, push undefined, jump to target
            // If not nullish: leave value on stack, fall through
            Case 54: {
                target = JSVM__Read16()
                av = JSVM__StackPop()
                is_nullish = 0
                IfCondition EqualTo(av, 0) ThenBlock: {
                    is_nullish = 1
                }
                IfCondition NotEqual(av, 0) ThenBlock: {
                    vtype = Dereference(av)
                    IfCondition Or(EqualTo(vtype, 0), EqualTo(vtype, 1)) ThenBlock: {
                        // UNDEFINED(0) or NULL(1)
                        is_nullish = 1
                    }
                }
                IfCondition EqualTo(is_nullish, 1) ThenBlock: {
                    // Push undefined and jump
                    JSVM__StackPush(JSRT_Undefined())
                    JSVMState.pc = target
                }
                IfCondition EqualTo(is_nullish, 0) ThenBlock: {
                    // Not nullish — push value back and fall through
                    JSVM__StackPush(av)
                }
                ReturnValue(1)
            }

            // TRY_PUSH (70) — push exception handler
            // 16-bit operand: catch handler address
            Case 70: {
                catch_addr = JSVM__Read16()
                IfCondition LessThan(JSVMState.exc_sp, 16) ThenBlock: {
                    ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 16))
                    // Store catch address
                    StoreValue(ebase, catch_addr)
                    // Store current stack pointer for unwinding
                    StoreValue(Add(ebase, 8), JSVMState.sp)
                    JSVMState.exc_sp = Add(JSVMState.exc_sp, 1)
                }
                ReturnValue(1)
            }

            // TRY_POP (71) — remove topmost exception handler
            Case 71: {
                IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                    JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                }
                ReturnValue(1)
            }

            // THROW (72) — throw exception
            // Pop thrown value, unwind to catch handler, push value on stack
            Case 72: {
                thrown = JSVM__StackPop()
                IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                    // Pop exception handler
                    JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                    ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 16))
                    catch_addr = Dereference(ebase)
                    saved_sp = Dereference(Add(ebase, 8))
                    // Restore stack pointer and jump to catch
                    IfCondition LessThan(saved_sp, 0) ThenBlock: { saved_sp = 0 }
                    IfCondition GreaterThan(saved_sp, JSVMConst.MAX_STACK) ThenBlock: { saved_sp = JSVMConst.MAX_STACK }
                    JSVMState.sp = saved_sp
                    JSVM__StackPush(thrown)
                    JSVMState.pc = catch_addr
                } ElseBlock: {
                    // No handler — set error and halt
                    JSVMState.error = 1
                    JSVMState.halted = 1
                }
                ReturnValue(1)
            }

            // CALL (55) — 1-byte operand: argc
            // Stack: [..., func, arg0, arg1, ..., argN-1]
            Case 55: {
                argc = JSVM__ReadByte()

                // Pop arguments into temp buffer (top of stack = last arg)
                arg_buf = Allocate(Multiply(Add(argc, 1), 8))
                MemorySet(arg_buf, 0, Multiply(Add(argc, 1), 8))

                ai = Subtract(argc, 1)
                WhileLoop GreaterEqual(ai, 0) {
                    arg_v = JSVM__StackPop()
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Subtract(ai, 1)
                }

                // Pop function value
                func_val = JSVM__StackPop()
                ft = JSRT_GetType(func_val)
                IfCondition NotEqual(ft, JSType.FUNCTION) ThenBlock: {
                    // Not a function — push undefined as result
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }

                // Check if this is a native function
                func_bc = JSRT_FuncGetBC(func_val)
                IfCondition LessThan(func_bc, 0) ThenBlock: {
                    // Native function call — dispatch through JSRuntime or JSBridge
                    handler_id = Subtract(-1, func_bc)

                    // Generator .next() — handler_id = 9998 (bc = -9999)
                    IfCondition EqualTo(handler_id, 9998) ThenBlock: {
                        gen_result = JSVM__GenNext(func_val, arg_buf, argc)
                        Deallocate(arg_buf, Multiply(Add(argc, 1), 8))
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }
                    // Generator .return() — handler_id = 9997 (bc = -9998)
                    IfCondition EqualTo(handler_id, 9997) ThenBlock: {
                        gen_result = JSVM__GenReturn(func_val, arg_buf, argc)
                        Deallocate(arg_buf, Multiply(Add(argc, 1), 8))
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }
                    // Generator .throw() — handler_id = 9996 (bc = -9997)
                    IfCondition EqualTo(handler_id, 9996) ThenBlock: {
                        gen_result = JSVM__GenThrow(func_val, arg_buf, argc)
                        Deallocate(arg_buf, Multiply(Add(argc, 1), 8))
                        JSVM__StackPush(gen_result)
                        ReturnValue(1)
                    }

                    // Handler IDs 62-76: String/Array methods (env = receiver)
                    IfCondition GreaterEqual(handler_id, 62) ThenBlock: {
                        IfCondition LessEqual(handler_id, 76) ThenBlock: {
                            str_recv = JSRT_FuncGetEnv(func_val)
                            native_result = JSVM__DispatchStringMethod(handler_id, str_recv, arg_buf, argc)
                            Deallocate(arg_buf, Multiply(Add(argc, 1), 8))
                            JSVM__StackPush(native_result)
                            ReturnValue(1)
                        }
                    }

                    // Handler IDs 0-21: JSRuntime built-ins (0-14 math/type, 15-21 Error ctors)
                    // Handler IDs 22+: JSBridge DOM/timer natives
                    IfCondition GreaterEqual(handler_id, 22) ThenBlock: {
                        native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                        Deallocate(arg_buf, Multiply(Add(argc, 1), 8))
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }
                    native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                    Deallocate(arg_buf, Multiply(Add(argc, 1), 8))
                    JSVM__StackPush(native_result)
                    ReturnValue(1)
                }

                // Check if this is a generator function (env == 71 magic)
                func_env = JSRT_FuncGetEnv(func_val)
                IfCondition EqualTo(func_env, 71) ThenBlock: {
                    // Generator call — create generator object, don't execute
                    gen_val = JSRT_CreateGenerator(func_val, arg_buf, argc)
                    Deallocate(arg_buf, Multiply(Add(argc, 1), 8))

                    // Attach .next() method — use a native func with bc = -(GEN_NEXT_ID+1)
                    // We use a special native ID: the gen state ptr encoded as negative bc
                    // Instead, create .next as a function whose env points to the generator
                    gen_gs = Dereference(Add(gen_val, 8))
                    next_func = JSRT_CreateFunc(-9999, 1, 0, "next")
                    JSRT_FuncSetEnv(next_func, gen_val)

                    ret_func = JSRT_CreateFunc(-9998, 1, 0, "return")
                    JSRT_FuncSetEnv(ret_func, gen_val)

                    throw_func = JSRT_CreateFunc(-9997, 1, 0, "throw")
                    JSRT_FuncSetEnv(throw_func, gen_val)

                    // Create wrapper object with next/return/throw and push it
                    // The generator JSValue IS the iterator — attach methods to an object wrapper
                    gen_obj = JSRT_CreateObject()
                    JSRT_ObjSet(gen_obj, "next", next_func)
                    JSRT_ObjSet(gen_obj, "return", ret_func)
                    JSRT_ObjSet(gen_obj, "throw", throw_func)
                    // Store gen state ref on the object for the runtime
                    JSRT_ObjSet(gen_obj, "__gen__", gen_val)

                    JSVM__StackPush(gen_obj)
                    ReturnValue(1)
                }

                // Async function (env == 65) — execute normally, AWAIT handles promise unwrapping
                // No special call handling needed; the function runs eagerly
                // and AWAIT opcode unwraps any promises in-flight.

                // Get function descriptor fields
                func_params = JSRT_FuncGetParams(func_val)
                func_locals = JSRT_FuncGetLocals(func_val)

                // Save current state in a call frame
                save_pc = JSVMState.pc
                save_sp = JSVMState.sp
                locals_base = JSVMState.sp

                JSVM__PushFrame(save_pc, save_sp, locals_base, func_params, func_locals)

                // Push locals onto stack (initialize args, rest to undefined)
                pi = 0
                WhileLoop LessThan(pi, func_locals) {
                    IfCondition LessThan(pi, argc) ThenBlock: {
                        pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                        JSVM__StackPush(pval)
                    } ElseBlock: {
                        JSVM__StackPush(JSRT_Undefined())
                    }
                    pi = Add(pi, 1)
                }

                Deallocate(arg_buf, Multiply(Add(argc, 1), 8))

                // === JIT CHECK ===
                // If JIT is enabled, try to execute native code instead of interpreting
                IfCondition EqualTo(JITState.enabled, 1) ThenBlock: {
                    jit_native = JIT_Lookup(func_bc)
                    IfCondition EqualTo(jit_native, 0) ThenBlock: {
                        // Not compiled yet — try to compile
                        // code_len: from func_bc to end of bytecode (or next RETURN)
                        jit_code_len = Subtract(JSVMState.code_len, func_bc)
                        jit_native = JIT_Compile(Add(JSVMState.code, func_bc), jit_code_len, func_bc)
                    }
                    IfCondition NotEqual(jit_native, 0) ThenBlock: {
                        // Execute JIT'd code
                        JIT_Execute(jit_native)
                        // JIT code ran the function body and returned.
                        // The JIT's RETURN opcode popped the return value and wrote sp back.
                        // Now we pop the frame and push the return value.
                        jit_ret = JSVM__StackPop()
                        jit_frame = JSVM__PopFrame()
                        IfCondition EqualTo(jit_frame, 0) ThenBlock: {
                            JSVM__StackPush(jit_ret)
                            JSVMState.halted = 1
                            ReturnValue(0)
                        }
                        JSVMState.pc = Dereference(jit_frame)
                        JSVMState.sp = Dereference(Add(jit_frame, 8))
                        JSVM__StackPush(jit_ret)
                        ReturnValue(1)
                    }
                }

                // Jump to function code (interpreter fallback)
                JSVMState.pc = func_bc
                ReturnValue(1)
            }

            // RETURN (56)
            Case 56: {
                // Pop return value
                ret_val = JSVM__StackPop()

                // Check if we're inside a generator execution
                IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
                    // Pop frame — check if this is the generator's base frame
                    frame = JSVM__PopFrame()
                    IfCondition EqualTo(frame, 0) ThenBlock: {
                        // This is the generator's base return — mark completed
                        gs = JSVMGen.active_gs
                        IfCondition NotEqual(gs, 0) ThenBlock: {
                            StoreValue(gs, JSGenConst.ST_COMPLETED)
                        }

                        // Restore caller state
                        JSVMState.pc = JSVMGen.caller_pc
                        JSVMState.sp = JSVMGen.caller_sp
                        JSVMState.fp = JSVMGen.caller_fp
                        caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                        IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                            MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                        }
                        caller_frm_sz = Multiply(JSVMGen.caller_fp, 40)
                        IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                            MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                        }

                        JSVMGen.active_gs = 0
                        JSVMGen.is_gen_exec = 0

                        // Return {value: ret_val, done: true}
                        iter_result = JSRT_CreateIterResult(ret_val, 1)
                        JSVM__StackPush(iter_result)
                        ReturnValue(1)
                    }

                    // Not the base frame — normal return within generator body
                    JSVMState.pc = Dereference(frame)
                    ret_sp = Dereference(Add(frame, 8))
                    JSVMState.sp = ret_sp
                    JSVM__StackPush(ret_val)
                    ReturnValue(1)
                }

                // Pop frame
                frame = JSVM__PopFrame()
                IfCondition EqualTo(frame, 0) ThenBlock: {
                    // No frame to pop — halt
                    JSVM__StackPush(ret_val)
                    JSVMState.halted = 1
                    ReturnValue(0)
                }

                // Check if this was a constructor frame (offset 40 = this_obj)
                ctor_this = Dereference(Add(frame, 40))
                IfCondition NotEqual(ctor_this, 0) ThenBlock: {
                    // Constructor return: if ret_val is not an object, use this_obj
                    rv_type = JSRT_GetType(ret_val)
                    IfCondition NotEqual(rv_type, JSType.OBJECT) ThenBlock: {
                        ret_val = ctor_this
                    }
                }

                // Restore state
                JSVMState.pc = Dereference(frame)
                ret_sp = Dereference(Add(frame, 8))
                JSVMState.sp = ret_sp

                // Push return value
                JSVM__StackPush(ret_val)
                ReturnValue(1)
            }

            // CLOSURE (57) — 16-bit constant index pointing to function descriptor
            Case 57: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // NEW_OBJECT (60)
            Case 60: {
                obj = JSRT_CreateObject()
                JSVM__StackPush(obj)
                ReturnValue(1)
            }

            // NEW_ARRAY (61) — 16-bit operand: element count
            // Elements are on stack (first element pushed first = deepest)
            Case 61: {
                elem_count = JSVM__Read16()
                arr = JSRT_CreateArray()

                // Pop elements in reverse (top = last element)
                // Store into a temp buffer first, then push in order
                IfCondition GreaterThan(elem_count, 0) ThenBlock: {
                    tbuf = Allocate(Multiply(elem_count, 8))
                    ei = Subtract(elem_count, 1)
                    WhileLoop GreaterEqual(ei, 0) {
                        ev = JSVM__StackPop()
                        StoreValue(Add(tbuf, Multiply(ei, 8)), ev)
                        ei = Subtract(ei, 1)
                    }
                    // Push them into array in order
                    ei = 0
                    WhileLoop LessThan(ei, elem_count) {
                        ev = Dereference(Add(tbuf, Multiply(ei, 8)))
                        JSRT_ArrPush(arr, ev)
                        ei = Add(ei, 1)
                    }
                }

                JSVM__StackPush(arr)
                ReturnValue(1)
            }

            // CONCAT (62) — string concatenation (pop 2, push result)
            Case 62: {
                bv = JSVM__StackPop()
                av = JSVM__StackPop()
                // Use JSRT_Add which handles string concatenation
                result = JSRT_Add(av, bv)
                JSVM__StackPush(result)
                ReturnValue(1)
            }

            // SET_PROP_COMPUTED (63) — pop value, pop key, pop obj; set obj[key]=value
            // Stack: [..., obj, key, value]
            Case 63: {
                sval = JSVM__StackPop()
                key_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                // Convert key to string for property name
                key_str = JSRT_ToString(key_val)
                key_ptr = JSRT_GetPayload(key_str)
                JSRT_ObjSet(obj, key_ptr, sval)
                ReturnValue(1)
            }

            // DEF_GETTER (64) — 16-bit operand: const pool index (prop name)
            // Stack: [..., obj, func]. Pop func, pop obj, define getter.
            // For now, store as __get_<name> property on the object.
            Case 64: {
                cidx = JSVM__Read16()
                JSVMTmp.ptr = JSVM__GetConstPayload(cidx)
                func_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                // Build getter key: "__get_" + name
                // We store the getter function as a hidden property
                // For JS spec compliance, we use a convention that GET_PROP checks
                gk_buf = Allocate(128)
                SetByte(gk_buf, 0, 95)
                SetByte(gk_buf, 1, 95)
                SetByte(gk_buf, 2, 103)
                SetByte(gk_buf, 3, 101)
                SetByte(gk_buf, 4, 116)
                SetByte(gk_buf, 5, 95)
                // Copy property name after "__get_"
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    JSVMTmp.val = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                    SetByte(gk_buf, Add(6, JSVMTmp.idx), JSVMTmp.val)
                    IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                        JSVMTmp.done = 1
                    }
                    JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                }
                JSRT_ObjSet(obj, gk_buf, func_val)
                ReturnValue(1)
            }

            // DEF_SETTER (65) — 16-bit operand: const pool index (prop name)
            // Stack: [..., obj, func]. Pop func, pop obj, define setter.
            Case 65: {
                cidx = JSVM__Read16()
                JSVMTmp.ptr = JSVM__GetConstPayload(cidx)
                func_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                // Build setter key: "__set_" + name
                sk_buf = Allocate(128)
                SetByte(sk_buf, 0, 95)
                SetByte(sk_buf, 1, 95)
                SetByte(sk_buf, 2, 115)
                SetByte(sk_buf, 3, 101)
                SetByte(sk_buf, 4, 116)
                SetByte(sk_buf, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    JSVMTmp.val = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                    SetByte(sk_buf, Add(6, JSVMTmp.idx), JSVMTmp.val)
                    IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                        JSVMTmp.done = 1
                    }
                    JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                }
                JSRT_ObjSet(obj, sk_buf, func_val)
                ReturnValue(1)
            }

            // DEF_GETTER_COMPUTED (76) — Stack: [obj, key, func]
            // Pop func, pop key, pop obj; define getter obj[key] = func
            Case 76: {
                func_val = JSVM__StackPop()
                key_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                key_str = JSRT_ToString(key_val)
                JSVMTmp.ptr = JSRT_GetPayload(key_str)
                // Build getter key: "__get_" + name
                gk_buf = Allocate(128)
                SetByte(gk_buf, 0, 95)
                SetByte(gk_buf, 1, 95)
                SetByte(gk_buf, 2, 103)
                SetByte(gk_buf, 3, 101)
                SetByte(gk_buf, 4, 116)
                SetByte(gk_buf, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    JSVMTmp.val = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                    SetByte(gk_buf, Add(6, JSVMTmp.idx), JSVMTmp.val)
                    IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                        JSVMTmp.done = 1
                    }
                    JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                }
                JSRT_ObjSet(obj, gk_buf, func_val)
                ReturnValue(1)
            }

            // DEF_SETTER_COMPUTED (77) — Stack: [obj, key, func]
            // Pop func, pop key, pop obj; define setter obj[key] = func
            Case 77: {
                func_val = JSVM__StackPop()
                key_val = JSVM__StackPop()
                obj = JSVM__StackPop()
                key_str = JSRT_ToString(key_val)
                JSVMTmp.ptr = JSRT_GetPayload(key_str)
                // Build setter key: "__set_" + name
                sk_buf = Allocate(128)
                SetByte(sk_buf, 0, 95)
                SetByte(sk_buf, 1, 95)
                SetByte(sk_buf, 2, 115)
                SetByte(sk_buf, 3, 101)
                SetByte(sk_buf, 4, 116)
                SetByte(sk_buf, 5, 95)
                JSVMTmp.idx = 0
                JSVMTmp.done = 0
                WhileLoop EqualTo(JSVMTmp.done, 0) {
                    JSVMTmp.val = GetByte(JSVMTmp.ptr, JSVMTmp.idx)
                    SetByte(sk_buf, Add(6, JSVMTmp.idx), JSVMTmp.val)
                    IfCondition EqualTo(JSVMTmp.val, 0) ThenBlock: {
                        JSVMTmp.done = 1
                    }
                    JSVMTmp.idx = Add(JSVMTmp.idx, 1)
                }
                JSRT_ObjSet(obj, sk_buf, func_val)
                ReturnValue(1)
            }

            // THROW_TDZ (78) — ReferenceError: cannot access variable before initialization
            // 2-byte operand: const pool index of variable name string
            Case 78: {
                ci = GetByte(JSVMState.code, JSVMState.pc)
                ci = Add(Multiply(ci, 256), GetByte(JSVMState.code, Add(JSVMState.pc, 1)))
                JSVMState.pc = Add(JSVMState.pc, 2)
                // Create ReferenceError object with message
                tdz_err = JSRT_CreateObject()
                JSRT_ObjSet(tdz_err, "name", JSRT_CreateString("ReferenceError"))
                JSRT_ObjSet(tdz_err, "message", JSRT_CreateString("Cannot access variable before initialization"))
                JSRT_ObjSet(tdz_err, "__class__", JSRT_CreateString("ReferenceError"))
                // Throw it
                IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                    JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                    ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 16))
                    catch_addr = Dereference(ebase)
                    saved_sp = Dereference(Add(ebase, 8))
                    IfCondition LessThan(saved_sp, 0) ThenBlock: { saved_sp = 0 }
                    IfCondition GreaterThan(saved_sp, JSVMConst.MAX_STACK) ThenBlock: { saved_sp = JSVMConst.MAX_STACK }
                    JSVMState.sp = saved_sp
                    JSVM__StackPush(tdz_err)
                    JSVMState.pc = catch_addr
                } ElseBlock: {
                    JSVMState.error = 1
                    JSVMState.halted = 1
                }
                ReturnValue(1)
            }

            // OBJ_KEYS (66) — pop object, push array of key strings
            Case 66: {
                obj = JSVM__StackPop()
                keys_arr = JSRT_ObjKeys(obj)
                JSVM__StackPush(keys_arr)
                ReturnValue(1)
            }

            // ARR_APPEND (67) — Stack: [..., array, value] → append value to array, push array
            Case 67: {
                sval = JSVM__StackPop()
                arr = JSVM__StackPop()
                JSRT_ArrPush(arr, sval)
                JSVM__StackPush(arr)
                ReturnValue(1)
            }

            // ARR_EXTEND (68) — Stack: [..., dest_array, src_array] → extend dest with src elements
            Case 68: {
                src_arr = JSVM__StackPop()
                dest_arr = JSVM__StackPop()
                // Get src array length and copy each element
                src_len = JSRT_ArrLen(src_arr)
                ei = 0
                WhileLoop LessThan(ei, src_len) {
                    ev = JSRT_ArrGet(src_arr, ei)
                    JSRT_ArrPush(dest_arr, ev)
                    ei = Add(ei, 1)
                }
                JSVM__StackPush(dest_arr)
                ReturnValue(1)
            }

            // CALL_SPREAD (69) — Stack: [..., func, args_array] → call func with array elements as args
            Case 69: {
                args_arr = JSVM__StackPop()
                func_val = JSVM__StackPop()

                ft = JSRT_GetType(func_val)
                IfCondition NotEqual(ft, JSType.FUNCTION) ThenBlock: {
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }

                // Build arg_buf from array elements
                argc = JSRT_ArrLen(args_arr)
                arg_buf = Allocate(Multiply(Add(argc, 1), 8))
                MemorySet(arg_buf, 0, Multiply(Add(argc, 1), 8))
                ai = 0
                WhileLoop LessThan(ai, argc) {
                    arg_v = JSRT_ArrGet(args_arr, ai)
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Add(ai, 1)
                }

                // Check if native function
                func_bc = JSRT_FuncGetBC(func_val)
                IfCondition LessThan(func_bc, 0) ThenBlock: {
                    handler_id = Subtract(-1, func_bc)
                    IfCondition GreaterEqual(handler_id, 16) ThenBlock: {
                        native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                        JSVM__StackPush(native_result)
                        ReturnValue(1)
                    }
                    native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                    JSVM__StackPush(native_result)
                    ReturnValue(1)
                }

                // User-defined function call
                func_params = JSRT_FuncGetParams(func_val)
                func_locals = JSRT_FuncGetLocals(func_val)

                save_pc = JSVMState.pc
                save_sp = JSVMState.sp
                locals_base = JSVMState.sp

                JSVM__PushFrame(save_pc, save_sp, locals_base, func_params, func_locals)

                pi = 0
                WhileLoop LessThan(pi, func_locals) {
                    IfCondition LessThan(pi, argc) ThenBlock: {
                        pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                        JSVM__StackPush(pval)
                    } ElseBlock: {
                        JSVM__StackPush(JSRT_Undefined())
                    }
                    pi = Add(pi, 1)
                }

                JSVMState.pc = func_bc
                ReturnValue(1)
            }

            // CONSTRUCT (81) — new Foo(args) constructor call
            // Stack: [..., func, arg0, arg1, ..., argN-1]
            // Creates new object, binds this, calls constructor, returns object
            Case 81: {
                argc = JSVM__ReadByte()

                // Pop arguments into temp buffer
                arg_buf = Allocate(Multiply(Add(argc, 1), 8))
                MemorySet(arg_buf, 0, Multiply(Add(argc, 1), 8))

                ai = Subtract(argc, 1)
                WhileLoop GreaterEqual(ai, 0) {
                    arg_v = JSVM__StackPop()
                    StoreValue(Add(arg_buf, Multiply(ai, 8)), arg_v)
                    ai = Subtract(ai, 1)
                }

                // Pop function (constructor)
                func_val = JSVM__StackPop()
                ft = JSRT_GetType(func_val)
                IfCondition NotEqual(ft, JSType.FUNCTION) ThenBlock: {
                    Deallocate(arg_buf, Multiply(Add(argc, 1), 8))
                    JSVM__StackPush(JSRT_Undefined())
                    ReturnValue(1)
                }

                // Create new object for this
                new_obj = JSRT_CreateObject()

                // Set prototype: new_obj.__proto__ = func.prototype
                proto_val = JSRT_ObjGet(func_val, "prototype")
                proto_type = JSRT_GetType(proto_val)
                IfCondition EqualTo(proto_type, JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(new_obj, "__proto__", proto_val)
                }

                // Check if native constructor
                func_bc = JSRT_FuncGetBC(func_val)
                IfCondition LessThan(func_bc, 0) ThenBlock: {
                    // Native constructor — dispatch and return result or new_obj
                    handler_id = Subtract(-1, func_bc)
                    // String/Array method dispatch (62-76)
                    IfCondition GreaterEqual(handler_id, 62) ThenBlock: {
                        IfCondition LessEqual(handler_id, 76) ThenBlock: {
                            native_result = JSVM__DispatchStringMethod(handler_id, new_obj, arg_buf, argc)
                            Deallocate(arg_buf, Multiply(Add(argc, 1), 8))
                            nr_type = JSRT_GetType(native_result)
                            IfCondition Or(EqualTo(nr_type, JSType.OBJECT), EqualTo(nr_type, JSType.ARRAY)) ThenBlock: {
                                JSVM__StackPush(native_result)
                            } ElseBlock: {
                                JSVM__StackPush(new_obj)
                            }
                            ReturnValue(1)
                        }
                    }
                    IfCondition GreaterEqual(handler_id, 22) ThenBlock: {
                        native_result = JSBridge_Dispatch(handler_id, arg_buf, argc)
                    } ElseBlock: {
                        native_result = JSRT_CallNative(handler_id, arg_buf, argc)
                    }
                    Deallocate(arg_buf, Multiply(Add(argc, 1), 8))
                    // If native returned an object/array, use that; otherwise use new_obj
                    nr_type = JSRT_GetType(native_result)
                    IfCondition Or(EqualTo(nr_type, JSType.OBJECT), EqualTo(nr_type, JSType.ARRAY)) ThenBlock: {
                        JSVM__StackPush(native_result)
                    } ElseBlock: {
                        JSVM__StackPush(new_obj)
                    }
                    ReturnValue(1)
                }

                // Bind this: set global "this" to new_obj
                JSVM__SetGlobal("this", new_obj)

                // Set up call frame (same as CALL)
                func_params = JSRT_FuncGetParams(func_val)
                func_locals = JSRT_FuncGetLocals(func_val)

                save_pc = JSVMState.pc
                save_sp = JSVMState.sp
                locals_base = JSVMState.sp

                JSVM__PushFrame(save_pc, save_sp, locals_base, func_params, func_locals)

                // Mark frame as constructor: store new_obj at frame offset 40
                faddr = Add(JSVMState.frames, Multiply(Subtract(JSVMState.fp, 1), JSVMConst.FRAME_SIZE))
                StoreValue(Add(faddr, 40), new_obj)

                // Push locals onto stack (initialize args, rest to undefined)
                pi = 0
                WhileLoop LessThan(pi, func_locals) {
                    IfCondition LessThan(pi, argc) ThenBlock: {
                        pval = Dereference(Add(arg_buf, Multiply(pi, 8)))
                        JSVM__StackPush(pval)
                    } ElseBlock: {
                        JSVM__StackPush(JSRT_Undefined())
                    }
                    pi = Add(pi, 1)
                }

                Deallocate(arg_buf, Multiply(Add(argc, 1), 8))

                // Jump to constructor code
                JSVMState.pc = func_bc
                ReturnValue(1)
            }

            // YIELD (73) — generator yield
            // Pop value from stack, save VM state to active generator, return {value, done:false}
            Case 73: {
                yield_val = JSVM__StackPop()

                // Get the active generator state block
                gs = JSVMGen.active_gs
                IfCondition EqualTo(gs, 0) ThenBlock: {
                    // Not in a generator — treat as return
                    JSVM__StackPush(yield_val)
                    JSVMState.halted = 1
                    ReturnValue(0)
                }

                // Save current VM state into generator state block
                StoreValue(Add(gs, 32), JSVMState.pc)
                StoreValue(Add(gs, 40), JSVMState.sp)
                StoreValue(Add(gs, 48), JSVMState.fp)

                // Copy stack to generator's private stack
                gen_stk = Dereference(Add(gs, 56))
                copy_sz = Multiply(JSVMState.sp, 8)
                IfCondition GreaterThan(copy_sz, 0) ThenBlock: {
                    MemoryCopy(gen_stk, JSVMState.stack, copy_sz)
                }

                // Copy frames to generator's private frames
                gen_frm = Dereference(Add(gs, 88))
                frm_copy_sz = Multiply(JSVMState.fp, 40)
                IfCondition GreaterThan(frm_copy_sz, 0) ThenBlock: {
                    MemoryCopy(gen_frm, JSVMState.frames, frm_copy_sz)
                }
                StoreValue(Add(gs, 96), JSVMState.fp)

                // Mark as suspended-yield
                StoreValue(gs, JSGenConst.ST_SUSPENDED_YIELD)

                // Restore caller state
                JSVMState.pc = JSVMGen.caller_pc
                JSVMState.sp = JSVMGen.caller_sp
                JSVMState.fp = JSVMGen.caller_fp
                // Restore caller stack
                caller_stk_sz = Multiply(JSVMGen.caller_sp, 8)
                IfCondition GreaterThan(caller_stk_sz, 0) ThenBlock: {
                    MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, caller_stk_sz)
                }
                // Restore caller frames
                caller_frm_sz = Multiply(JSVMGen.caller_fp, 40)
                IfCondition GreaterThan(caller_frm_sz, 0) ThenBlock: {
                    MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, caller_frm_sz)
                }

                // Clear active generator
                JSVMGen.active_gs = 0
                JSVMGen.is_gen_exec = 0

                // Create result: {value: yield_val, done: false}
                iter_result = JSRT_CreateIterResult(yield_val, 0)
                JSVM__StackPush(iter_result)
                ReturnValue(1)
            }

            // GEN_CLOSURE (74) — like CLOSURE but marks function as generator
            Case 74: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                // Mark the function as a generator by setting env to magic value 71 (0x47 = 'G')
                JSRT_FuncSetEnv(cval, 71)
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // TO_ARRAY (75) — pop iterable, push array of its values
            // Array → returns itself (iterate values directly)
            // String → array of single characters
            Case 75: {
                src_val = JSVM__StackPop()
                src_type = JSRT_GetType(src_val)

                // Array: push back as-is (values are the elements)
                IfCondition EqualTo(src_type, JSType.ARRAY) ThenBlock: {
                    JSVM__StackPush(src_val)
                    ReturnValue(1)
                }

                // String: split into array of single characters
                IfCondition EqualTo(src_type, JSType.STRING) ThenBlock: {
                    str_ptr = JSRT_GetPayload(src_val)
                    str_len = StringLength(str_ptr)
                    char_arr = JSRT_CreateArray()
                    ci2 = 0
                    WhileLoop LessThan(ci2, str_len) {
                        char_ptr = Add(str_ptr, ci2)
                        char_val = JSRT_CreateStringLen(char_ptr, 1)
                        JSRT_ArrPush(char_arr, char_val)
                        ci2 = Add(ci2, 1)
                    }
                    JSVM__StackPush(char_arr)
                    ReturnValue(1)
                }

                // Fallback: push empty array
                JSVM__StackPush(JSRT_CreateArray())
                ReturnValue(1)
            }

            // ASYNC_CLOSURE (79) — like CLOSURE but marks function as async
            // Async functions run eagerly to completion (single-threaded cooperative)
            // The return value is wrapped in a resolved Promise
            Case 79: {
                cidx = JSVM__Read16()
                cval = JSVM__LoadConst(cidx)
                // Mark the function as async by setting env to magic value 65 (0x41 = 'A')
                JSRT_FuncSetEnv(cval, 65)
                JSVM__StackPush(cval)
                ReturnValue(1)
            }

            // AWAIT (80) — in eager mode, just unwrap Promises synchronously
            // If TOS is a Promise (object with __state__), extract __value__
            // Otherwise, pass through (non-thenable values resolve immediately)
            Case 80: {
                await_val = JSVM__StackPop()
                await_type = JSRT_GetType(await_val)
                // Check if it's a Promise object
                IfCondition EqualTo(await_type, JSType.OBJECT) ThenBlock: {
                    // Check for __state__ property (our Promise marker)
                    p_state = JSRT_ObjGet(await_val, "__state__")
                    ps_type = JSRT_GetType(p_state)
                    IfCondition EqualTo(ps_type, JSType.NUMBER) ThenBlock: {
                        // It's a Promise — check state
                        ps_val = JSRT_GetPayload(p_state)
                        IfCondition EqualTo(ps_val, 1) ThenBlock: {
                            // Fulfilled: extract value
                            resolved = JSRT_ObjGet(await_val, "__value__")
                            JSVM__StackPush(resolved)
                        } ElseBlock: {
                            IfCondition EqualTo(ps_val, 2) ThenBlock: {
                                // Rejected: throw the rejection reason
                                rej_val = JSRT_ObjGet(await_val, "__value__")
                                IfCondition GreaterThan(JSVMState.exc_sp, 0) ThenBlock: {
                                    JSVMState.exc_sp = Subtract(JSVMState.exc_sp, 1)
                                    ebase = Add(JSVMState.exc_stack, Multiply(JSVMState.exc_sp, 16))
                                    catch_addr = Dereference(ebase)
                                    saved_sp = Dereference(Add(ebase, 8))
                                    IfCondition LessThan(saved_sp, 0) ThenBlock: { saved_sp = 0 }
                                    IfCondition GreaterThan(saved_sp, JSVMConst.MAX_STACK) ThenBlock: { saved_sp = JSVMConst.MAX_STACK }
                                    JSVMState.sp = saved_sp
                                    JSVM__StackPush(rej_val)
                                    JSVMState.pc = catch_addr
                                } ElseBlock: {
                                    JSVMState.error = 1
                                    JSVMState.halted = 1
                                }
                            } ElseBlock: {
                                // Pending: in eager mode, resolve to undefined
                                JSVM__StackPush(JSRT_Undefined())
                            }
                        }
                    } ElseBlock: {
                        // Not a Promise, pass through (thenable check could go here)
                        JSVM__StackPush(await_val)
                    }
                } ElseBlock: {
                    // Non-object: pass through (await 42 === 42)
                    JSVM__StackPush(await_val)
                }
                ReturnValue(1)
            }

            // NOP (99)
            Case 99: {
                ReturnValue(1)
            }

            // UNKNOWN OPCODE — error
            Default: {
                PrintMessage("[JSVM] Unknown opcode: ")
                PrintNumber(op)
                PrintMessage(" at pc=")
                PrintNumber(Subtract(JSVMState.pc, 1))
                PrintMessage("\n")
                JSVMState.error = 1
                ReturnValue(-1)
            }
        }
    }
}

// =============================================================================
// RUN — execute until HALT or error
// Returns top-of-stack value (address to JSValue), or undefined
// =============================================================================
Function.JSVM_Run {
    Output: Address
    Body: {
        WhileLoop And(EqualTo(JSVMState.halted, 0), EqualTo(JSVMState.error, 0)) {
            JSVM_Step()
        }
        // Return top of stack if any
        IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
            ReturnValue(JSVM__StackPop())
        }
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// PUBLIC API — Set/Get Global variables
// =============================================================================

Function.JSVM_SetGlobal {
    Input: name: Address
    Input: jsval: Address
    Output: Integer
    Body: {
        save_name = name
        save_val = jsval
        ReturnValue(JSVM__SetGlobal(save_name, save_val))
    }
}

Function.JSVM_GetGlobal {
    Input: name: Address
    Output: Address
    Body: {
        save_name = name
        ReturnValue(JSVM__GetGlobal(save_name))
    }
}

// =============================================================================
// STATE QUERY
// =============================================================================

Function.JSVM_GetError {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.error)
    }
}

Function.JSVM_IsHalted {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.halted)
    }
}

Function.JSVM_GetSteps {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.steps)
    }
}

Function.JSVM_GetPC {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.pc)
    }
}

Function.JSVM_GetSP {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.sp)
    }
}

// =============================================================================
// DUMP STACK — debug aid, prints top N stack entries
// Returns number of entries printed
// =============================================================================
Function.JSVM_DumpStack {
    Output: Integer
    Body: {
        count = JSVMState.sp
        IfCondition GreaterThan(count, 16) ThenBlock: {
            count = 16
        }
        idx = 0
        WhileLoop LessThan(idx, count) {
            si = Subtract(Subtract(JSVMState.sp, 1), idx)
            saddr = Add(JSVMState.stack, Multiply(si, 8))
            val = Dereference(saddr)
            IfCondition NotEqual(val, 0) ThenBlock: {
                vt = JSRT_GetType(val)
                // NUMBER: print value
                IfCondition EqualTo(vt, JSType.NUMBER) ThenBlock: {
                    nv = JSRT_GetPayload(val)
                    PrintNumber(nv)
                }
                // STRING: print string
                IfCondition EqualTo(vt, JSType.STRING) ThenBlock: {
                    sv = JSRT_GetPayload(val)
                    IfCondition NotEqual(sv, 0) ThenBlock: {
                        PrintString(sv)
                    }
                }
                // BOOLEAN: print true/false
                IfCondition EqualTo(vt, JSType.BOOLEAN) ThenBlock: {
                    bv = JSRT_GetPayload(val)
                    IfCondition NotEqual(bv, 0) ThenBlock: {
                        PrintString("true")
                    } ElseBlock: {
                        PrintString("false")
                    }
                }
                // UNDEFINED
                IfCondition EqualTo(vt, JSType.UNDEFINED) ThenBlock: {
                    PrintString("undefined")
                }
                // NULL
                IfCondition EqualTo(vt, JSType.NULL) ThenBlock: {
                    PrintString("null")
                }
                // OBJECT
                IfCondition EqualTo(vt, JSType.OBJECT) ThenBlock: {
                    PrintString("[object]")
                }
                // ARRAY
                IfCondition EqualTo(vt, JSType.ARRAY) ThenBlock: {
                    PrintString("[array]")
                }
                // FUNCTION
                IfCondition EqualTo(vt, JSType.FUNCTION) ThenBlock: {
                    PrintString("[function]")
                }
                PrintString(" ")
            }
            idx = Add(idx, 1)
        }
        ReturnValue(count)
    }
}

// =============================================================================
// MAX STEPS CONFIGURATION
// =============================================================================

Function.JSVM_SetMaxSteps {
    Input: max: Integer
    Output: Integer
    Body: {
        JSVMState.max_steps = max
        ReturnValue(0)
    }
}

Function.JSVM_GetMaxSteps {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.max_steps)
    }
}

// =============================================================================
// CONVENIENCE: Install built-in globals (console, Math, etc.)
// Delegates to JSRuntime's built-in registration.
// =============================================================================
Function.JSVM_InstallBuiltins {
    Output: Integer
    Body: {
        // Register JSRuntime built-in native functions
        JSRT_RegisterBuiltins()

        // Create console object and install as global
        console_obj = JSRT_CreateConsole()
        JSVM__SetGlobal("console", console_obj)

        // Create Math object and install as global
        math_obj = JSBridge__CreateMathObj()
        JSVM__SetGlobal("Math", math_obj)

        // Install undefined, null, NaN, Infinity as globals
        JSVM__SetGlobal("undefined", JSRT_Undefined())
        JSVM__SetGlobal("null", JSRT_Null())
        JSVM__SetGlobal("NaN", JSRT_CreateNumber(0))
        JSVM__SetGlobal("Infinity", JSRT_CreateNumber(999999999))

        // Install type conversion constructors as global functions
        // Number() = handler 8, String() = handler 9, Boolean() = handler 10
        num_func = JSBridge__CreateNativeFunc(8, "Number", 1)
        JSVM__SetGlobal("Number", num_func)
        str_func = JSBridge__CreateNativeFunc(9, "String", 1)
        JSVM__SetGlobal("String", str_func)
        bool_func = JSBridge__CreateNativeFunc(10, "Boolean", 1)
        JSVM__SetGlobal("Boolean", bool_func)

        // Install global utility functions
        // isNaN() = handler 11, isFinite() = handler 12
        nan_func = JSBridge__CreateNativeFunc(11, "isNaN", 1)
        JSVM__SetGlobal("isNaN", nan_func)
        fin_func = JSBridge__CreateNativeFunc(12, "isFinite", 1)
        JSVM__SetGlobal("isFinite", fin_func)

        // parseInt() = handler 13, parseFloat() = handler 14
        pi_func = JSBridge__CreateNativeFunc(13, "parseInt", 1)
        JSVM__SetGlobal("parseInt", pi_func)
        pf_func = JSBridge__CreateNativeFunc(14, "parseFloat", 1)
        JSVM__SetGlobal("parseFloat", pf_func)

        // Install Error constructors as global functions
        // Error = handler 15, TypeError = 16, RangeError = 17, ReferenceError = 18
        // SyntaxError = 19, URIError = 20, EvalError = 21
        err_func = JSBridge__CreateNativeFunc(15, "Error", 1)
        JSVM__SetGlobal("Error", err_func)
        terr_func = JSBridge__CreateNativeFunc(16, "TypeError", 1)
        JSVM__SetGlobal("TypeError", terr_func)
        rerr_func = JSBridge__CreateNativeFunc(17, "RangeError", 1)
        JSVM__SetGlobal("RangeError", rerr_func)
        rferr_func = JSBridge__CreateNativeFunc(18, "ReferenceError", 1)
        JSVM__SetGlobal("ReferenceError", rferr_func)
        serr_func = JSBridge__CreateNativeFunc(19, "SyntaxError", 1)
        JSVM__SetGlobal("SyntaxError", serr_func)
        uerr_func = JSBridge__CreateNativeFunc(20, "URIError", 1)
        JSVM__SetGlobal("URIError", uerr_func)
        eerr_func = JSBridge__CreateNativeFunc(21, "EvalError", 1)
        JSVM__SetGlobal("EvalError", eerr_func)

        // Install Object global with defineProperty, keys, create, etc.
        // NOTE: Uses JSRT__Push/Pop (not JSBridge__Push/Pop) because JSBridge
        // may not be initialized yet when this is called from JSEngine__Run.
        obj_global = JSRT_CreateObject()
        JSVM__SetGlobal("Object", obj_global)
        JSRT__Push(obj_global)
        dp_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_DEFINE_PROP, "defineProperty", 3)
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "defineProperty", dp_func)
        JSRT__Push(obj_global)
        ok_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_KEYS, "keys", 1)
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "keys", ok_func)
        JSRT__Push(obj_global)
        oc_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_CREATE, "create", 1)
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "create", oc_func)
        JSRT__Push(obj_global)
        oa_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_ASSIGN, "assign", 2)
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "assign", oa_func)
        JSRT__Push(obj_global)
        of_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_FREEZE, "freeze", 1)
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "freeze", of_func)
        JSRT__Push(obj_global)
        ois_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_IS, "is", 2)
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "is", ois_func)
        JSRT__Push(obj_global)
        gpo_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_GET_PROTO_OF, "getPrototypeOf", 1)
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "getPrototypeOf", gpo_func)
        JSRT__Push(obj_global)
        gopd_func = JSBridge__CreateNativeFunc(JSNativeID.OBJ_GET_OWN_PROP_DESC, "getOwnPropertyDescriptor", 2)
        obj_global = JSRT__Pop()
        JSRT_ObjSet(obj_global, "getOwnPropertyDescriptor", gopd_func)

        // Install Array as constructor function with isArray, from
        arr_global = JSBridge__CreateNativeFunc(JSNativeID.ARR_CTOR, "Array", 1)
        JSVM__SetGlobal("Array", arr_global)
        JSRT__Push(arr_global)
        aia_func = JSBridge__CreateNativeFunc(JSNativeID.ARR_IS_ARRAY, "isArray", 1)
        arr_global = JSRT__Pop()
        JSRT_ObjSet(arr_global, "isArray", aia_func)
        JSRT__Push(arr_global)
        af_func = JSBridge__CreateNativeFunc(JSNativeID.ARR_FROM, "from", 1)
        arr_global = JSRT__Pop()
        JSRT_ObjSet(arr_global, "from", af_func)

        // Install String global with fromCharCode
        str_global = JSRT_CreateObject()
        JSVM__SetGlobal("String", str_global)
        JSRT__Push(str_global)
        fcc_func = JSBridge__CreateNativeFunc(JSNativeID.STR_FROM_CHAR_CODE, "fromCharCode", 1)
        str_global = JSRT__Pop()
        JSRT_ObjSet(str_global, "fromCharCode", fcc_func)

        // Install Promise global with resolve, reject
        promise_global = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_CTOR, "Promise", 1)
        JSVM__SetGlobal("Promise", promise_global)
        JSRT__Push(promise_global)
        pr_func = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_RESOLVE, "resolve", 1)
        promise_global = JSRT__Pop()
        JSRT_ObjSet(promise_global, "resolve", pr_func)
        JSRT__Push(promise_global)
        pj_func = JSBridge__CreateNativeFunc(JSNativeID.PROMISE_REJECT, "reject", 1)
        promise_global = JSRT__Pop()
        JSRT_ObjSet(promise_global, "reject", pj_func)

        ReturnValue(1)
    }
}

// =============================================================================
// GENERATOR .next() — resume generator execution
// func_val = the .next() function (env points to generator JSValue)
// args/argc = arguments passed to .next() (value passed in via arg0)
// Returns: {value, done} iterator result object
// =============================================================================
Function.JSVM__GenNext {
    Input: func_val: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_args = args
        save_argc = argc

        // Get generator JSValue from function's env
        gen_val = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(gen_val, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Get generator state block
        gen_type = JSRT_GetType(gen_val)
        IfCondition NotEqual(gen_type, JSType.GENERATOR) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gs = JSRT_GetPayload(gen_val)
        IfCondition EqualTo(gs, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Check state
        gen_state = Dereference(gs)
        // If completed, return {value: undefined, done: true}
        IfCondition EqualTo(gen_state, JSGenConst.ST_COMPLETED) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        // If executing, throw error (re-entrant)
        IfCondition EqualTo(gen_state, JSGenConst.ST_EXECUTING) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Mark as executing
        StoreValue(gs, JSGenConst.ST_EXECUTING)

        // Save caller VM state
        JSVMGen.caller_pc = JSVMState.pc
        JSVMGen.caller_sp = JSVMState.sp
        JSVMGen.caller_fp = JSVMState.fp
        JSVMGen.active_gs = gs
        JSVMGen.active_genval = gen_val
        JSVMGen.is_gen_exec = 1

        // Allocate caller stack/frame backup buffers
        caller_stk_sz = Multiply(JSVMState.sp, 8)
        IfCondition LessThan(caller_stk_sz, 8) ThenBlock: { caller_stk_sz = 8 }
        JSVMGen.caller_stack = Allocate(caller_stk_sz)
        MemoryCopy(JSVMGen.caller_stack, JSVMState.stack, caller_stk_sz)

        caller_frm_sz = Multiply(JSVMState.fp, 40)
        IfCondition LessThan(caller_frm_sz, 40) ThenBlock: { caller_frm_sz = 40 }
        JSVMGen.caller_frames = Allocate(caller_frm_sz)
        MemoryCopy(JSVMGen.caller_frames, JSVMState.frames, caller_frm_sz)

        // Handle suspended-start: initialize generator's stack with locals
        IfCondition EqualTo(gen_state, JSGenConst.ST_SUSPENDED_START) ThenBlock: {
            // Load generator function params
            g_bc = Dereference(Add(gs, 8))
            g_params = Dereference(Add(gs, 16))
            g_locals = Dereference(Add(gs, 24))
            g_args = Dereference(Add(gs, 72))
            g_argc = Dereference(Add(gs, 80))

            // Clear VM state for generator execution
            JSVMState.sp = 0
            JSVMState.fp = 0
            MemorySet(JSVMState.stack, 0, Multiply(JSVMConst.MAX_STACK, 8))
            MemorySet(JSVMState.frames, 0, Multiply(JSVMConst.MAX_FRAMES, 40))

            // Push locals (initialize params from args, rest to undefined)
            pi = 0
            WhileLoop LessThan(pi, g_locals) {
                IfCondition LessThan(pi, g_argc) ThenBlock: {
                    pval = Dereference(Add(g_args, Multiply(pi, 8)))
                    JSVM__StackPush(pval)
                } ElseBlock: {
                    JSVM__StackPush(JSRT_Undefined())
                }
                pi = Add(pi, 1)
            }

            // Set PC to function bytecode
            JSVMState.pc = g_bc
        }

        // Handle suspended-yield: restore generator's saved state
        IfCondition EqualTo(gen_state, JSGenConst.ST_SUSPENDED_YIELD) ThenBlock: {
            g_pc = Dereference(Add(gs, 32))
            g_sp = Dereference(Add(gs, 40))
            g_fp = Dereference(Add(gs, 48))
            g_stk = Dereference(Add(gs, 56))
            g_frm = Dereference(Add(gs, 88))
            g_frm_count = Dereference(Add(gs, 96))

            // Restore stack
            JSVMState.sp = g_sp
            restore_sz = Multiply(g_sp, 8)
            IfCondition GreaterThan(restore_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.stack, g_stk, restore_sz)
            }

            // Restore frames
            JSVMState.fp = g_fp
            frm_restore_sz = Multiply(g_fp, 40)
            IfCondition GreaterThan(frm_restore_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.frames, g_frm, frm_restore_sz)
            }

            // Set PC
            JSVMState.pc = g_pc

            // Push the value passed to .next(value) — this becomes the result of yield
            IfCondition GreaterThan(save_argc, 0) ThenBlock: {
                next_arg = Dereference(save_args)
                JSVM__StackPush(next_arg)
            } ElseBlock: {
                JSVM__StackPush(JSRT_Undefined())
            }
        }

        // Run the generator until YIELD or RETURN (both will restore caller state)
        JSVMState.halted = 0
        JSVMState.error = 0
        gen_done = 0
        WhileLoop EqualTo(gen_done, 0) {
            rc = JSVM_Step()
            // Check if generator execution ended (YIELD or RETURN restored caller)
            IfCondition EqualTo(JSVMGen.is_gen_exec, 0) ThenBlock: {
                gen_done = 1
            }
            IfCondition EqualTo(JSVMState.halted, 1) ThenBlock: {
                gen_done = 1
            }
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                gen_done = 1
            }
        }

        // If halted/error and generator still active, need to clean up
        IfCondition EqualTo(JSVMGen.is_gen_exec, 1) ThenBlock: {
            // Generator hit halt/error without proper YIELD/RETURN
            StoreValue(gs, JSGenConst.ST_COMPLETED)
            JSVMState.pc = JSVMGen.caller_pc
            JSVMState.sp = JSVMGen.caller_sp
            JSVMState.fp = JSVMGen.caller_fp
            c_stk_sz = Multiply(JSVMGen.caller_sp, 8)
            IfCondition GreaterThan(c_stk_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.stack, JSVMGen.caller_stack, c_stk_sz)
            }
            c_frm_sz = Multiply(JSVMGen.caller_fp, 40)
            IfCondition GreaterThan(c_frm_sz, 0) ThenBlock: {
                MemoryCopy(JSVMState.frames, JSVMGen.caller_frames, c_frm_sz)
            }
            JSVMGen.active_gs = 0
            JSVMGen.is_gen_exec = 0
            JSVMState.halted = 0
            JSVMState.error = 0
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // The result is already on the stack (pushed by YIELD or RETURN handler)
        result = JSVM__StackPop()
        ReturnValue(result)
    }
}

// =============================================================================
// GENERATOR .return() — force generator completion with a value
// =============================================================================
Function.JSVM__GenReturn {
    Input: func_val: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_args = args
        save_argc = argc

        gen_val = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(gen_val, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gen_type = JSRT_GetType(gen_val)
        IfCondition NotEqual(gen_type, JSType.GENERATOR) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gs = JSRT_GetPayload(gen_val)
        IfCondition EqualTo(gs, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Mark completed
        StoreValue(gs, JSGenConst.ST_COMPLETED)

        // Get the return value
        ret_v = JSRT_Undefined()
        IfCondition GreaterThan(save_argc, 0) ThenBlock: {
            ret_v = Dereference(save_args)
        }
        ReturnValue(JSRT_CreateIterResult(ret_v, 1))
    }
}

// =============================================================================
// GENERATOR .throw() — throw exception into generator
// =============================================================================
Function.JSVM__GenThrow {
    Input: func_val: Address
    Input: args: Address
    Input: argc: Integer
    Output: Address
    Body: {
        save_fv = func_val
        save_args = args
        save_argc = argc

        gen_val = JSRT_FuncGetEnv(save_fv)
        IfCondition EqualTo(gen_val, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gen_type = JSRT_GetType(gen_val)
        IfCondition NotEqual(gen_type, JSType.GENERATOR) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }
        gs = JSRT_GetPayload(gen_val)
        IfCondition EqualTo(gs, 0) ThenBlock: {
            ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
        }

        // Mark completed (simple impl — throw terminates generator)
        StoreValue(gs, JSGenConst.ST_COMPLETED)
        ReturnValue(JSRT_CreateIterResult(JSRT_Undefined(), 1))
    }
}

// =============================================================================
// FULL PIPELINE: Lex + Parse + Compile + Run
// Takes JS source string and length, returns result JSValue.
// Requires JSLex_Init, JSParse_Init, JSComp_Init, JSVM_Init already called.
// =============================================================================
Function.JSVM_Eval {
    Input: source: Address
    Input: src_len: Integer
    Output: Address
    Body: {
        save_src = source
        save_len = src_len

        // Reset subsystems
        JSLex_Reset()
        JSComp_Reset()
        JSVM_Reset()

        // Tokenize
        tok_count = JSLex_Tokenize(save_src, save_len)
        IfCondition LessEqual(tok_count, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Parse
        root = JSParse_Parse()
        parse_err = JSParse_HasError()
        IfCondition Or(LessThan(root, 0), EqualTo(parse_err, 1)) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Compile
        JSVM__Push(root)
        comp_ok = JSComp_Compile(root)
        root = JSVM__Pop()
        IfCondition EqualTo(comp_ok, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }

        // Load bytecode
        bc = JSComp_GetCode()
        bc_len = JSComp_GetCodeLen()
        cp = JSComp_GetConst(0)
        cc = JSComp_GetConstCount()
        JSVM_Load(bc, bc_len, cp, cc)

        // Run
        result = JSVM_Run()
        ReturnValue(result)
    }
}
