// Library.JSVM.ailang — JavaScript bytecode interpreter (virtual machine)
// Branch (switch) dispatch over ~50 opcodes. Maintains a value stack, call frame
// stack, global variable table (XSHash), and executes compiled bytecode from
// JSCompiler. Pattern modeled after CPU6502 (dispatch loop, register state,
// step/run).
//
// Uses JSRuntime for value creation, arithmetic, comparison, type coercion,
// and object/array manipulation. The JSVM only manages execution state:
// program counter, value stack, call frames, globals hash.
//
// CLOBBER SAFETY: Every function saves Input params to locals on the FIRST
// line of Body. Complex expressions broken into steps. JSVMTmp fields
// guarded with push/pop across recursive calls.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Browser.JSRuntime
LibraryImport.Browser.JSCompiler
LibraryImport.Browser.JSBridge
LibraryImport.Browser.JSJIT
LibraryImport.Arena
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.Hash

LibraryImport.Browser.JSVM.JSVMStringMethods
LibraryImport.Browser.JSVM.JSVMArrayMethods
LibraryImport.Browser.JSVM.JSVMErrors
LibraryImport.Browser.JSVM.JSVMArgs
LibraryImport.Browser.JSVM.JSVMEval
LibraryImport.Browser.JSVM.JSVMDispatch
LibraryImport.Browser.JSVM.JSVMBuiltins

// =============================================================================
// VM CONSTANTS
// =============================================================================
FixedPool.JSVMConst {
    "MAX_STACK":     Initialize=16384
    "MAX_FRAMES":    Initialize=1024
    "FRAME_SIZE":    Initialize=80
    "MAX_CONSTS":    Initialize=65536
    "MAX_GVARS":     Initialize=8192
    "MAX_CALL_ARGS": Initialize=32
}

// =============================================================================
// STATIC CALL BUFFER — pre-allocated arg buffer for CALL opcode (no Allocate)
// =============================================================================
FixedPool.JSVMCallBuf {
    "buf":       Initialize=0
    "getter_buf": Initialize=0
}

// =============================================================================
// VM STATE
// =============================================================================
FixedPool.JSVMState {
    "stack":         Initialize=0
    "sp":            Initialize=0
    "frames":        Initialize=0
    "fp":            Initialize=0
    "code":          Initialize=0
    "code_len":      Initialize=0
    "pc":            Initialize=0
    "const_pool":    Initialize=0
    "const_count":   Initialize=0
    "const_vals":    Initialize=0
    "const_val_pool": Initialize=0
    "const_val_end":  Initialize=0
    "globals":       Initialize=0
    "gvals":         Initialize=0
    "gvar_count":    Initialize=0
    "gslot_cache":   Initialize=0
    "halted":        Initialize=0
    "error":         Initialize=0
    "steps":         Initialize=0
    "max_steps":     Initialize=1000000
    "exc_stack":     Initialize=0
    "exc_sp":        Initialize=0
    "exc_val":       Initialize=0
    "locals_base":   Initialize=0
    "cv_buf":        Initialize=0
    "cvp_buf":       Initialize=0
    "is_strict":     Initialize=0
    // M26e: 1 while derived ctor has not yet SuperCall-bound this
    "this_tdz":      Initialize=0
    // M26k: 1 while running __field_init__ (private field create allowed)
    "private_init":  Initialize=0
    // M26k.9: 1 while running __field_init__ — SET_PROP uses define, not setters
    "field_define":  Initialize=0
}

// =============================================================================
// CLOBBER-SAFE TEMPORARIES
// =============================================================================
FixedPool.JSVMTmp {
    "idx":       Initialize=0
    "type":      Initialize=0
    "ptr":       Initialize=0
    "len":       Initialize=0
    "val":       Initialize=0
    "val2":      Initialize=0
    "addr":      Initialize=0
    "op":        Initialize=0
    "done":      Initialize=0
    "count":     Initialize=0
    "result":    Initialize=0
    "obj":       Initialize=0
}

// Generator execution state — tracks which generator is currently running.
// Mole 17: nest_depth + nest_* allow GenNext re-entry (dstr elision over gens).
FixedPool.JSVMGen {
    "active_gs":    Initialize=0
    "active_genval": Initialize=0
    "caller_pc":    Initialize=0
    "caller_sp":    Initialize=0
    "caller_fp":    Initialize=0
    "caller_stack": Initialize=0
    "caller_frames": Initialize=0
    "is_gen_exec":  Initialize=0
    "stk_buf":      Initialize=0
    "frm_buf":      Initialize=0
    "nest_depth":   Initialize=0
    "nest_meta":    Initialize=0
    "nest_stk":     Initialize=0
    "nest_frm":     Initialize=0
    "nest_envs":    Initialize=0
    "nest_ffuncs":  Initialize=0
    "nest_fargs":   Initialize=0
    "fdi_only":     Initialize=0
    "fdi_limit":    Initialize=0
    "fdi_mode":     Initialize=0
    "nest_fdi_only": Initialize=0
    "nest_fdi_limit": Initialize=0
    "nest_fdi_mode": Initialize=0
    // M56: GeneratorResumeAbrupt return — finally then complete with this value
    "force_return": Initialize=0
    "force_return_val": Initialize=0
}

// Mole 7/8: per-activation closure envs + saved outer `arguments`
// frame_funcs[i] / frame_envs[i] / frame_args[i] parallel to frames[i]
// frame_this_st[i]: 0=n/a, 1=derived this UNINIT, 2=this INIT (M26e)
// Keys: "__cenv" on function objects, "__parent" on env objects
FixedPool.JSVMClosure {
    "frame_funcs":  Initialize=0
    "frame_envs":   Initialize=0
    "frame_args":   Initialize=0
    "frame_this_st": Initialize=0
    // M26g: previous `this` to restore on RETURN from CALL_METHOD
    "frame_saved_this": Initialize=0
    "frame_has_saved_this": Initialize=0
    // M59: top-level (fp==0) lexical env for free-var capture / for-of let
    "script_env":   Initialize=0
    "cenv_key":     Initialize=0
    "parent_key":   Initialize=0
    "args_key":     Initialize=0
    "this_uninit":  Initialize=0
}

// Mole 9: Symbol + iterator keys
// Mole 15: last ITER_NEXT done flag (1 = exhausted)
FixedPool.JSVMIter {
    "done": Initialize=0
}

FixedPool.JSVMSymbol {
    "next_id":      Initialize=1
    "iterator":     Initialize=0
    "species":      Initialize=0
    "match":        Initialize=0
    "replace":      Initialize=0
    "search":       Initialize=0
    "split":        Initialize=0
    "toStringTag":  Initialize=0
    "class_key":    Initialize=0
    "sid_key":      Initialize=0
    "key_buf":      Initialize=0
}

// Re-entrant call state — for JSVM__CallFunc (used by Promise.then, etc.)
FixedPool.JSVMCall {
    "caller_pc":     Initialize=0
    "caller_sp":     Initialize=0
    "caller_fp":     Initialize=0
    "caller_stack":  Initialize=0
    "caller_frames": Initialize=0
    "caller_halted": Initialize=0
    "caller_error":  Initialize=0
    "depth":         Initialize=0
    "stk_buf":       Initialize=0
    "frm_buf":       Initialize=0
    "exc_prop":      Initialize=0
    "thrown_val":    Initialize=0
}

// Nested eval(): backup outer bytecode + VM regs (globals stay shared)
FixedPool.JSVMEvalState {
    "depth":         Initialize=0
    "code_bak":      Initialize=0
    "const_bak":     Initialize=0
    "func_bak":      Initialize=0
    "code_cap":      Initialize=131072
    "const_cap":     Initialize=65536
    "func_cap":      Initialize=0
    "save_code_len": Initialize=0
    "save_const_n":  Initialize=0
    "save_func_n":   Initialize=0
    "save_pc":       Initialize=0
    "save_sp":       Initialize=0
    "save_fp":       Initialize=0
    "save_halted":   Initialize=0
    "save_error":    Initialize=0
    "save_steps":    Initialize=0
    "save_exc_sp":   Initialize=0
    "save_strict":   Initialize=0
    "stk_bak":       Initialize=0
    "frm_bak":       Initialize=0
}

// =============================================================================
// VM STACK — save/restore values across calls
// =============================================================================
FixedPool.JSVMStack {
    "pool":      Initialize=0
    "sp":        Initialize=0
    "capacity":  Initialize=0
    "tmp_val":   Initialize=0
    "tmp_addr":  Initialize=0
}

// =============================================================================
// STACK PUSH / POP (for saving temporaries across calls)
// =============================================================================
Function.JSVM__Push {
    Input: val: Integer
    Output: Integer
    Body: {
        JSVMStack.tmp_val = val
        JSVMStack.tmp_addr = Add(JSVMStack.pool, Multiply(JSVMStack.sp, 8))
        StoreValue(JSVMStack.tmp_addr, JSVMStack.tmp_val)
        JSVMStack.sp = Add(JSVMStack.sp, 1)
        ReturnValue(0)
    }
}

Function.JSVM__Pop {
    Output: Integer
    Body: {
        JSVMStack.sp = Subtract(JSVMStack.sp, 1)
        ReturnValue(Dereference(Add(JSVMStack.pool, Multiply(JSVMStack.sp, 8))))
    }
}

// =============================================================================
// VALUE STACK OPERATIONS — push/pop JSValue pointers
// =============================================================================

Function.JSVM__StackPush {
    Input: val: Address
    Output: Integer
    Body: {
        save_val = val
        IfCondition GreaterEqual(JSVMState.sp, JSVMConst.MAX_STACK) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(-1)
        }
        IfCondition LessThan(JSVMState.sp, 0) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(-1)
        }
        saddr = Add(JSVMState.stack, Multiply(JSVMState.sp, 8))
        StoreValue(saddr, save_val)
        JSVMState.sp = Add(JSVMState.sp, 1)
        ReturnValue(0)
    }
}

Function.JSVM__StackPop {
    Output: Address
    Body: {
        IfCondition LessEqual(JSVMState.sp, 0) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(JSRT_Undefined())
        }
        JSVMState.sp = Subtract(JSVMState.sp, 1)
        saddr = Add(JSVMState.stack, Multiply(JSVMState.sp, 8))
        ReturnValue(Dereference(saddr))
    }
}

Function.JSVM__StackPeek {
    Output: Address
    Body: {
        IfCondition LessEqual(JSVMState.sp, 0) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        idx = Subtract(JSVMState.sp, 1)
        saddr = Add(JSVMState.stack, Multiply(idx, 8))
        ReturnValue(Dereference(saddr))
    }
}

// =============================================================================
// BYTECODE READING HELPERS
// =============================================================================

// Read one byte at PC, advance PC
Function.JSVM__ReadByte {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(JSVMState.pc, JSVMState.code_len) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(0)
        }
        b = GetByte(JSVMState.code, JSVMState.pc)
        JSVMState.pc = Add(JSVMState.pc, 1)
        ReturnValue(b)
    }
}

// Read 16-bit big-endian operand (2 bytes), advance PC by 2
Function.JSVM__Read16 {
    Output: Integer
    Body: {
        b2 = JSVM__ReadByte()
        b1 = JSVM__ReadByte()
        b0 = JSVM__ReadByte()
        ReturnValue(Add(Add(Multiply(b2, 65536), Multiply(b1, 256)), b0))
    }
}

// =============================================================================
// CALL FRAME HELPERS
// Frame layout (40 bytes):
//   Offset 0:  return_pc (8)
//   Offset 8:  return_sp (8)
//   Offset 16: locals_base (8)
//   Offset 24: param_count (8)
//   Offset 32: local_count (8)
// =============================================================================

// Get pointer to current frame
Function.JSVM__CurFrame {
    Output: Address
    Body: {
        IfCondition LessEqual(JSVMState.fp, 0) ThenBlock: {
            ReturnValue(0)
        }
        fidx = Subtract(JSVMState.fp, 1)
        ReturnValue(Add(JSVMState.frames, Multiply(fidx, JSVMConst.FRAME_SIZE)))
    }
}

// Push a new call frame
Function.JSVM__PushFrame {
    Input: ret_pc: Integer
    Input: ret_sp: Integer
    Input: locals_base: Integer
    Input: param_count: Integer
    Input: local_count: Integer
    Output: Integer
    Body: {
        save_rpc = ret_pc
        save_rsp = ret_sp
        save_lb = locals_base
        save_pc = param_count
        save_lc = local_count
        IfCondition GreaterEqual(JSVMState.fp, JSVMConst.MAX_FRAMES) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(-1)
        }
        faddr = Add(JSVMState.frames, Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE))
        StoreValue(faddr, save_rpc)
        StoreValue(Add(faddr, 8), save_rsp)
        StoreValue(Add(faddr, 16), save_lb)
        StoreValue(Add(faddr, 24), save_pc)
        StoreValue(Add(faddr, 32), save_lc)
        StoreValue(Add(faddr, 40), 0)
        // Mole 16: saved outer is_strict (0/1) for restore on RETURN
        StoreValue(Add(faddr, 72), 0)
        // Watermarks for scope-based reclamation (ping-pong head/tail)
        StoreValue(Add(faddr, 48), JSRTState.val_count)
        StoreValue(Add(faddr, 56), JSRTState.str_slab_pos)
        StoreValue(Add(faddr, 64), JSRTState.func_slab_pos)
        JSVMState.fp = Add(JSVMState.fp, 1)
        ReturnValue(0)
    }
}

// Pop call frame, return pointer to it for reading saved values
Function.JSVM__PopFrame {
    Output: Address
    Body: {
        IfCondition LessEqual(JSVMState.fp, 0) ThenBlock: {
            JSVMState.error = 1
            ReturnValue(0)
        }
        JSVMState.fp = Subtract(JSVMState.fp, 1)
        ReturnValue(Add(JSVMState.frames, Multiply(JSVMState.fp, JSVMConst.FRAME_SIZE)))
    }
}

// =============================================================================
// SCOPE RECLAMATION — ping-pong head/tail watermark rollback
// On function return, promotes the return value out of the callee's arena,
// then snaps val_pool/str_slab/func_slab back to the watermarks saved at CALL.
// O(1) — no scanning, no marking, just pointer arithmetic.
// =============================================================================
Function.JSVM__ReclaimScope {
    Input: frame_ptr: Address
    Input: ret_val: Address
    Output: Address
    Body: {
        save_frame = frame_ptr
        save_rv = ret_val
        // Read watermarks saved by PushFrame
        wm_val  = Dereference(Add(save_frame, 48))
        wm_str  = Dereference(Add(save_frame, 56))
        wm_func = Dereference(Add(save_frame, 64))

        // Calculate the byte boundary for val_pool region owned by callee
        wm_val_addr = Add(JSRTState.val_pool, Multiply(wm_val, JSRTConst.VAL_SIZE))

        // Promote return value if it lives in callee's region
        // (i.e., it was allocated after the watermark)
        IfCondition NotEqual(save_rv, 0) ThenBlock: {
            IfCondition GreaterEqual(save_rv, wm_val_addr) ThenBlock: {
                // ret_val is in callee's arena — inline copy to watermark slot
                // (avoids function call overhead of JSRT__AllocValue)
                rv_type = Dereference(save_rv)
                rv_payload = Dereference(Add(save_rv, 8))

                // Write directly to the watermark position
                new_val = wm_val_addr
                StoreValue(new_val, rv_type)

                // If STRING type, also promote the string data (M31a UTF-16 headered)
                IfCondition EqualTo(rv_type, JSType.STRING) ThenBlock: {
                    // Check if string payload is in callee's str_slab region
                    wm_str_addr = Add(JSRTState.str_slab, wm_str)
                    IfCondition GreaterEqual(rv_payload, wm_str_addr) ThenBlock: {
                        // Copy full headered payload into parent slab region
                        buf_sz = JSRT_StrByteSize(rv_payload)
                        new_buf = Add(JSRTState.str_slab, wm_str)
                        new_end = Add(wm_str, buf_sz)
                        IfCondition LessThan(new_end, JSRTState.str_slab_cap) ThenBlock: {
                            MemoryCopy(new_buf, rv_payload, buf_sz)
                            rv_payload = new_buf
                            wm_str = new_end
                        }
                    }
                }

                StoreValue(Add(new_val, 8), rv_payload)
                save_rv = new_val
                // Advance watermark past the promoted value (1 slot)
                wm_val = Add(wm_val, 1)
            }
        }

        // Snap val_pool head back — reclaim ephemeral values the callee allocated.
        // Do NOT rewind str_slab_pos: property keys and ObjSet deep-copied strings
        // live there and must outlive the frame (no GC). Leaks per-call temps;
        // correct over reclaiming live property data.
        // Do NOT rewind func_slab_pos: escaped closures (return / store in global
        // or array) keep descriptors that point into func_slab. Rewinding made
        // multi-call "function(){ return x }" use-after-free (undefined/crash).
        JSRTState.val_count = wm_val
        // JSRTState.str_slab_pos = wm_str  — intentionally not rewound
        // JSRTState.func_slab_pos = wm_func — intentionally not rewound

        ReturnValue(save_rv)
    }
}

// =============================================================================
// CONSTANT POOL ACCESS
// Constant pool entries are 16 bytes: [type:8][payload:8]
// type: 1=NUMBER, 2=STRING, 3=FUNCTION
// =============================================================================

Function.JSVM__GetConstType {
    Input: idx: Integer
    Output: Integer
    Body: {
        save_idx = idx
        base = Add(JSVMState.const_pool, Multiply(save_idx, 16))
        ReturnValue(Dereference(base))
    }
}

Function.JSVM__GetConstPayload {
    Input: idx: Integer
    Output: Integer
    Body: {
        save_idx = idx
        base = Add(JSVMState.const_pool, Multiply(save_idx, 16))
        ReturnValue(Dereference(Add(base, 8)))
    }
}

// Create a JSValue from a constant pool entry.
// NUMBER constants are cached — same idx always returns same JSValue ptr.
Function.JSVM__LoadConst {
    Input: idx: Integer
    Output: Address
    Body: {
        save_idx = idx
        IfCondition Or(LessThan(save_idx, 0), GreaterEqual(save_idx, JSVMState.const_count)) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ctype = JSVM__GetConstType(save_idx)
        cpay = JSVM__GetConstPayload(save_idx)

        // NUMBER (type=1) — cached in separate const_val_pool (immune to FreeValue)
        IfCondition EqualTo(ctype, 1) ThenBlock: {
            // Check cache first
            cv_addr = Add(JSVMState.const_vals, Multiply(save_idx, 8))
            cached = Dereference(cv_addr)
            IfCondition NotEqual(cached, 0) ThenBlock: {
                ReturnValue(cached)
            }
            // First load — allocate from const_val_pool, not val_pool
            nv = Add(JSVMState.const_val_pool, Multiply(save_idx, 16))
            StoreValue(nv, JSType.NUMBER)
            StoreValue(Add(nv, 8), cpay)
            StoreValue(cv_addr, nv)
            ReturnValue(nv)
        }

        // STRING (type=2) — payload is pointer to null-terminated string
        IfCondition EqualTo(ctype, 2) ThenBlock: {
            ReturnValue(JSRT_CreateString(cpay))
        }

        // FUNCTION (type=3) — payload is pointer to function descriptor
        //   Offset 0: bc, 8: params, 16: locals, 24: name, 32: name_len
        //   40: body_start, 48: es_length
        IfCondition EqualTo(ctype, 3) ThenBlock: {
            f_bc = Dereference(cpay)
            f_params = Dereference(Add(cpay, 8))
            f_locals = Dereference(Add(cpay, 16))
            f_name = Dereference(Add(cpay, 24))
            fval = JSRT_CreateFunc(f_bc, f_params, f_locals, f_name)
            // Apply compiler-computed Function.length (defaults/rest)
            elen = Dereference(Add(cpay, 48))
            fdesc = Dereference(Add(fval, 8))
            IfCondition NotEqual(fdesc, 0) ThenBlock: {
                StoreValue(Add(fdesc, 80), elen)
                // Compiler +40: 1=base class, 2=derived class, 4=method (no .prototype)
                cflag = Dereference(Add(cpay, 40))
                IfCondition Or(EqualTo(cflag, 1), EqualTo(cflag, 2)) ThenBlock: {
                    StoreValue(Add(fdesc, 88), cflag)
                }
                IfCondition EqualTo(cflag, 4) ThenBlock: {
                    // MethodDefinition: no .prototype + not constructible (fdesc+88=4)
                    StoreValue(Add(fdesc, 48), 0)
                    StoreValue(Add(fdesc, 88), 4)
                }
            }
            ReturnValue(fval)
        }

        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// LOCAL VARIABLE ACCESS (relative to current frame's locals_base)
// =============================================================================

Function.JSVM__GetLocal {
    Input: slot: Integer
    Output: Address
    Body: {
        save_slot = slot
        frame = JSVM__CurFrame()
        IfCondition EqualTo(frame, 0) ThenBlock: {
            // No frame — use absolute slot (top-level code)
            saddr = Add(JSVMState.stack, Multiply(save_slot, 8))
            ReturnValue(Dereference(saddr))
        }
        lb = Dereference(Add(frame, 16))
        abs_idx = Add(lb, save_slot)
        saddr = Add(JSVMState.stack, Multiply(abs_idx, 8))
        ReturnValue(Dereference(saddr))
    }
}

Function.JSVM__SetLocal {
    Input: slot: Integer
    Input: val: Address
    Output: Integer
    Body: {
        save_slot = slot
        save_val = val
        frame = JSVM__CurFrame()
        IfCondition EqualTo(frame, 0) ThenBlock: {
            saddr = Add(JSVMState.stack, Multiply(save_slot, 8))
            StoreValue(saddr, save_val)
            ReturnValue(0)
        }
        lb = Dereference(Add(frame, 16))
        abs_idx = Add(lb, save_slot)
        saddr = Add(JSVMState.stack, Multiply(abs_idx, 8))
        StoreValue(saddr, save_val)
        ReturnValue(0)
    }
}

// =============================================================================
// GLOBAL VARIABLE ACCESS (via XSHash)
// name must be a null-terminated string pointer
// =============================================================================

Function.JSVM__GetGlobal {
    Input: name: Address
    Output: Address
    Body: {
        save_name = name
        result = GlobalHash_Lookup(save_name)
        IfCondition EqualTo(result, -1) ThenBlock: {
            ReturnValue(JSRT_Undefined())
        }
        ReturnValue(result)
    }
}

Function.JSVM__SetGlobal {
    Input: name: Address
    Input: val: Address
    Output: Integer
    Body: {
        save_name = name
        save_val = val
        // IMPORTANT (Mole 12): NEVER in-place mutate an existing gval slot for
        // object/array/function (or any) binding. Outstanding references
        // (locals, params, arrays) may hold that same gval pointer — e.g.
        //   var m = arguments; nested();
        // SetGlobal("arguments", inner) used to overwrite the slot so `m`
        // silently became the inner arguments object. Then m[0] was the
        // outer args object (typeof object), not the number 1.
        // Always allocate a fresh gval and rebind the hash entry.
        existing = GlobalHash_Lookup(save_name)
        IfCondition NotEqual(existing, -1) ThenBlock: {
            // Refuse to mutate immortal singletons (realm poison)
            is_sing = 0
            IfCondition EqualTo(existing, JSRTState.undef_val) ThenBlock: { is_sing = 1 }
            IfCondition EqualTo(existing, JSRTState.null_val) ThenBlock: { is_sing = 1 }
            IfCondition EqualTo(existing, JSRTState.true_val) ThenBlock: { is_sing = 1 }
            IfCondition EqualTo(existing, JSRTState.false_val) ThenBlock: { is_sing = 1 }
            // (singletons still get a new gval via Insert below)

            g2 = JSRT__AllocGlobalValue()
            IfCondition EqualTo(g2, 0) ThenBlock: {
                ReturnValue(-1)
            }
            StoreValue(g2, Dereference(save_val))
            StoreValue(Add(g2, 8), Dereference(Add(save_val, 8)))
            // For STRING values, deep-copy payload into str_slab so a later
            // slab bump or temp buffer (float_buf) cannot clobber the global.
            IfCondition EqualTo(Dereference(save_val), JSType.STRING) ThenBlock: {
                spay = Dereference(Add(save_val, 8))
                IfCondition NotEqual(spay, 0) ThenBlock: {
                    nbuf = JSRT_StrClone(spay)
                    IfCondition NotEqual(nbuf, 0) ThenBlock: {
                        StoreValue(Add(g2, 8), nbuf)
                    }
                }
            }
            GlobalHash_Insert(save_name, g2)
            ReturnValue(1)
        }
        // Slow path: new global — copy name to stable str_slab memory so it
        // survives compiler resets (JSComp_Reset zeros const_pool).
        nlen = StringLength(save_name)
        stable_name = JSRT__StrSlabAlloc(Add(nlen, 1))
        IfCondition EqualTo(stable_name, 0) ThenBlock: {
            ReturnValue(-1)
        }
        MemoryCopy(stable_name, save_name, nlen)
        SetByte(stable_name, nlen, 0)
        // Allocate a persistent gval slot so the value survives
        // scope-reclamation watermark rollback on function return.
        gslot = JSRT__AllocGlobalValue()
        IfCondition EqualTo(gslot, 0) ThenBlock: {
            ReturnValue(-1)
        }
        StoreValue(gslot, Dereference(save_val))
        StoreValue(Add(gslot, 8), Dereference(Add(save_val, 8)))
        IfCondition EqualTo(Dereference(save_val), JSType.STRING) ThenBlock: {
            spay2 = Dereference(Add(save_val, 8))
            IfCondition NotEqual(spay2, 0) ThenBlock: {
                nbuf2 = JSRT_StrClone(spay2)
                IfCondition NotEqual(nbuf2, 0) ThenBlock: {
                    StoreValue(Add(gslot, 8), nbuf2)
                }
            }
        }
        GlobalHash_Insert(stable_name, gslot)
        ReturnValue(1)
    }
}

// Typed errors / throw / strict: Library.JSVM.JSVMErrors (split for LOC budget)

// =============================================================================
// MOLE 7 — per-activation closure environments
// =============================================================================

// After PushFrame: record callee + create env object (link parent via __cenv).
Function.JSVM__SetupCallEnv {
    Input: func_val: Address
    Output: Integer
    Body: {
        save_f = func_val
        IfCondition LessEqual(JSVMState.fp, 0) ThenBlock: {
            ReturnValue(0)
        }
        fi = Subtract(JSVMState.fp, 1)
        StoreValue(Add(JSVMClosure.frame_funcs, Multiply(fi, 8)), save_f)
        // Env objects must outlive the activation (escaped closures).
        // gval_pool survives ReclaimScope; val_pool does not.
        env = JSRT__AllocGlobalValue()
        IfCondition EqualTo(env, 0) ThenBlock: {
            StoreValue(Add(JSVMClosure.frame_envs, Multiply(fi, 8)), 0)
            ReturnValue(0)
        }
        ptable = PropTable_Alloc()
        StoreValue(env, JSType.OBJECT)
        StoreValue(Add(env, 8), ptable)
        // parent_env = callee.__cenv (env of the activation that created this closure)
        parent_env = JSRT_FuncPropGet(save_f, JSVMClosure.cenv_key)
        IfCondition NotEqual(parent_env, 0) ThenBlock: {
            IfCondition NotEqual(parent_env, JSRTState.undef_val) ThenBlock: {
                pt = JSRT_GetType(parent_env)
                IfCondition EqualTo(pt, JSType.OBJECT) ThenBlock: {
                    JSRT_ObjSet(env, JSVMClosure.parent_key, parent_env)
                }
            }
        }
        StoreValue(Add(JSVMClosure.frame_envs, Multiply(fi, 8)), env)
        ReturnValue(1)
    }
}

// Before installing a new arguments object: snapshot outer arguments for RETURN.
// IMPORTANT: GetGlobal returns the permanent gval *slot*. SetGlobal updates that
// slot in-place, so we must copy type+payload into a fresh gval — not stash the
// slot pointer (that would observe the nested call's overwrite).
Function.JSVM__SaveArguments {
    Output: Integer
    Body: {
        IfCondition LessEqual(JSVMState.fp, 0) ThenBlock: {
            ReturnValue(0)
        }
        fi = Subtract(JSVMState.fp, 1)
        // 0 = no outer arguments (Restore installs a fresh undefined gval).
        // Never store undef_val singleton as a GlobalHash value pointer.
        snap = 0
        IfCondition EqualTo(JSVM__HasGlobal(JSVMClosure.args_key), 1) ThenBlock: {
            slot = JSVM__GetGlobal(JSVMClosure.args_key)
            IfCondition And(NotEqual(slot, 0), NotEqual(slot, JSRTState.undef_val)) ThenBlock: {
                copy = JSRT__AllocGlobalValue()
                IfCondition NotEqual(copy, 0) ThenBlock: {
                    StoreValue(copy, Dereference(slot))
                    StoreValue(Add(copy, 8), Dereference(Add(slot, 8)))
                    snap = copy
                }
            }
        }
        StoreValue(Add(JSVMClosure.frame_args, Multiply(fi, 8)), snap)
        ReturnValue(1)
    }
}

// After PopFrame path: restore outer arguments (fi = frame index we just left).
// Rebind GlobalHash to the snapshot gval — do NOT SetGlobal (in-place mutate of
// the current slot). `return arguments` yields that slot; mutating it would
// corrupt escaped arguments objects (S10.6_A7, S11.2.4_A1.1_T1, …).
//
// CRITICAL: never rebind the global to JSRTState.undef_val / true / false / null
// singletons. SetGlobal's fast path does StoreValue(existing, …) into whatever
// Lookup returns — if that is undef_val, the next CreateArguments clobber of
// "arguments" rewrites the singleton type tag to OBJECT and breaks the realm
// (typeof undefined === "object", every missing prop looks like an object).
Function.JSVM__RestoreArguments {
    Input: frame_idx: Integer
    Output: Integer
    Body: {
        fi = frame_idx
        IfCondition Or(LessThan(fi, 0), GreaterEqual(fi, JSVMConst.MAX_FRAMES)) ThenBlock: {
            ReturnValue(0)
        }
        prev = Dereference(Add(JSVMClosure.frame_args, Multiply(fi, 8)))
        // No outer arguments (or sentinel): install a FRESH gval holding undefined
        use_fresh = 0
        IfCondition EqualTo(prev, 0) ThenBlock: { use_fresh = 1 }
        IfCondition EqualTo(prev, JSRTState.undef_val) ThenBlock: { use_fresh = 1 }
        IfCondition EqualTo(prev, JSRTState.null_val) ThenBlock: { use_fresh = 1 }
        IfCondition EqualTo(prev, JSRTState.true_val) ThenBlock: { use_fresh = 1 }
        IfCondition EqualTo(prev, JSRTState.false_val) ThenBlock: { use_fresh = 1 }
        IfCondition EqualTo(use_fresh, 1) ThenBlock: {
            g = JSRT__AllocGlobalValue()
            IfCondition EqualTo(g, 0) ThenBlock: {
                // OOM — last resort: leave current arguments in place
                StoreValue(Add(JSVMClosure.frame_args, Multiply(fi, 8)), 0)
                ReturnValue(0)
            }
            StoreValue(g, JSType.UNDEFINED)
            StoreValue(Add(g, 8), 0)
            GlobalHash_Insert(JSVMClosure.args_key, g)
        } ElseBlock: {
            GlobalHash_Insert(JSVMClosure.args_key, prev)
        }
        StoreValue(Add(JSVMClosure.frame_args, Multiply(fi, 8)), 0)
        ReturnValue(1)
    }
}

// Current activation env (frame) or script_env when running top-level code.
// Creates script_env on first use so top-level closures can capture free vars.
Function.JSVM__GetCurEnv {
    Output: Address
    Body: {
        IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
            fi = Subtract(JSVMState.fp, 1)
            env = Dereference(Add(JSVMClosure.frame_envs, Multiply(fi, 8)))
            ReturnValue(env)
        }
        // Top-level script: ensure a durable env object exists
        IfCondition Or(EqualTo(JSVMClosure.script_env, 0), EqualTo(JSVMClosure.script_env, JSRTState.undef_val)) ThenBlock: {
            env = JSRT__AllocGlobalValue()
            IfCondition EqualTo(env, 0) ThenBlock: {
                ReturnValue(0)
            }
            ptable = PropTable_Alloc()
            StoreValue(env, JSType.OBJECT)
            StoreValue(Add(env, 8), ptable)
            JSVMClosure.script_env = env
        }
        ReturnValue(JSVMClosure.script_env)
    }
}

// Install env as current activation / script env.
Function.JSVM__SetCurEnv {
    Input: env: Address
    Output: Integer
    Body: {
        save_e = env
        IfCondition GreaterThan(JSVMState.fp, 0) ThenBlock: {
            fi = Subtract(JSVMState.fp, 1)
            StoreValue(Add(JSVMClosure.frame_envs, Multiply(fi, 8)), save_e)
            ReturnValue(1)
        }
        JSVMClosure.script_env = save_e
        ReturnValue(1)
    }
}

// At CLOSURE creation: attach current frame env so free vars resolve per activation.
// M59: also works at top-level via script_env.
Function.JSVM__CaptureClosureEnv {
    Input: func_val: Address
    Output: Integer
    Body: {
        save_f = func_val
        IfCondition EqualTo(save_f, 0) ThenBlock: {
            ReturnValue(0)
        }
        env = JSVM__GetCurEnv()
        IfCondition Or(EqualTo(env, 0), EqualTo(env, JSRTState.undef_val)) ThenBlock: {
            ReturnValue(0)
        }
        JSRT_FuncPropSet(save_f, JSVMClosure.cenv_key, env)
        ReturnValue(1)
    }
}

// Walk env chain (__parent) for a binding. Returns JSValue or undef.
Function.JSVM__EnvLookup {
    Input: start_env: Address
    Input: name: Address
    Output: Address
    Body: {
        env = start_env
        save_name = name
        hops = 0
        WhileLoop And(NotEqual(env, 0), LessThan(hops, 64)) {
            IfCondition EqualTo(env, JSRTState.undef_val) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            et = JSRT_GetType(env)
            IfCondition NotEqual(et, JSType.OBJECT) ThenBlock: {
                ReturnValue(JSRTState.undef_val)
            }
            has = JSRT_ObjHas(env, save_name)
            IfCondition EqualTo(has, 1) ThenBlock: {
                ReturnValue(JSRT_ObjGet(env, save_name))
            }
            env = JSRT_ObjGet(env, JSVMClosure.parent_key)
            hops = Add(hops, 1)
        }
        ReturnValue(JSRTState.undef_val)
    }
}

// Set binding on env chain (first env that has the name, else start env).
Function.JSVM__EnvAssign {
    Input: start_env: Address
    Input: name: Address
    Input: val: Address
    Output: Integer
    Body: {
        env = start_env
        save_name = name
        save_val = val
        start = start_env
        hops = 0
        WhileLoop And(NotEqual(env, 0), LessThan(hops, 64)) {
            IfCondition EqualTo(env, JSRTState.undef_val) ThenBlock: {
                env = 0
            }
            IfCondition NotEqual(env, 0) ThenBlock: {
                et = JSRT_GetType(env)
                IfCondition EqualTo(et, JSType.OBJECT) ThenBlock: {
                    has = JSRT_ObjHas(env, save_name)
                    IfCondition EqualTo(has, 1) ThenBlock: {
                        JSRT_ObjSet(env, save_name, save_val)
                        ReturnValue(1)
                    }
                    env = JSRT_ObjGet(env, JSVMClosure.parent_key)
                } ElseBlock: {
                    env = 0
                }
            }
            hops = Add(hops, 1)
        }
        // Not found — define on start env
        IfCondition And(NotEqual(start, 0), NotEqual(start, JSRTState.undef_val)) ThenBlock: {
            JSRT_ObjSet(start, save_name, save_val)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// MOLE 9 — Symbol + iterator helpers
// =============================================================================

// Create a Symbol object (unique id). desc = optional JS value for .description.
Function.JSVM_CreateSymbol {
    Input: desc: Address
    Output: Address
    Body: {
        save_desc = desc
        sid = JSVMSymbol.next_id
        JSVMSymbol.next_id = Add(sid, 1)
        sym = JSRT_CreateObject()
        IfCondition EqualTo(sym, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Mark as symbol via __class__ / __sid__
        cls = JSRT_CreateString("Symbol")
        JSRT_ObjSet(sym, JSVMSymbol.class_key, cls)
        JSRT_ObjSet(sym, JSVMSymbol.sid_key, JSRT_CreateNumber(sid))
        // M48b: store description (ES Symbol.prototype.description)
        // undefined arg / missing → description is undefined
        IfCondition EqualTo(save_desc, 0) ThenBlock: {
            JSRT_ObjSet(sym, "description", JSRTState.undef_val)
        } ElseBlock: {
            IfCondition EqualTo(save_desc, JSRTState.undef_val) ThenBlock: {
                JSRT_ObjSet(sym, "description", JSRTState.undef_val)
            } ElseBlock: {
                // ToString the description argument
                ds = JSRT_ToString(save_desc)
                IfCondition EqualTo(ds, 0) ThenBlock: {
                    JSRT_ObjSet(sym, "description", JSRTState.undef_val)
                } ElseBlock: {
                    JSRT_ObjSet(sym, "description", ds)
                }
            }
        }
        ReturnValue(sym)
    }
}

// M48b: SetFunctionName(F, nameKey) — nameKey is original property key JS value.
// Symbol → "[" + description + "]" or ""; else ToString(key).
// Only call when F.name is empty (anon).
Function.JSVM_SetFunctionName {
    Input: fn: Address
    Input: name_key: Address
    Output: Integer
    Body: {
        save_fn = fn
        save_key = name_key
        IfCondition EqualTo(save_fn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(save_fn), JSType.FUNCTION) ThenBlock: {
            ReturnValue(0)
        }
        name_str = 0
        IfCondition EqualTo(JSVM_IsSymbol(save_key), 1) ThenBlock: {
            dval = JSRT_ObjGet(save_key, "description")
            IfCondition EqualTo(dval, 0) ThenBlock: {
                name_str = JSRT_CreateString("")
            } ElseBlock: {
                IfCondition EqualTo(dval, JSRTState.undef_val) ThenBlock: {
                    name_str = JSRT_CreateString("")
                } ElseBlock: {
                    // "[" + ToString(desc) + "]"
                    // JSRT__StrConcat returns a STRING value (not a payload ptr).
                    lb = JSRT_CreateString("[")
                    rb = JSRT_CreateString("]")
                    mid = dval
                    IfCondition NotEqual(JSRT_GetType(dval), JSType.STRING) ThenBlock: {
                        mid = JSRT_ToString(dval)
                    }
                    IfCondition EqualTo(mid, 0) ThenBlock: {
                        name_str = JSRT_CreateString("")
                    } ElseBlock: {
                        p1 = JSRT__StrConcat(JSRT_GetPayload(lb), JSRT_GetPayload(mid))
                        IfCondition EqualTo(p1, 0) ThenBlock: {
                            name_str = JSRT_CreateString("")
                        } ElseBlock: {
                            p2 = JSRT__StrConcat(JSRT_GetPayload(p1), JSRT_GetPayload(rb))
                            IfCondition EqualTo(p2, 0) ThenBlock: {
                                name_str = JSRT_CreateString("")
                            } ElseBlock: {
                                name_str = p2
                            }
                        }
                    }
                }
            }
        } ElseBlock: {
            // string / number / other → ToString
            IfCondition EqualTo(JSRT_GetType(save_key), JSType.STRING) ThenBlock: {
                name_str = save_key
            } ElseBlock: {
                name_str = JSRT_ToString(save_key)
            }
            IfCondition EqualTo(name_str, 0) ThenBlock: {
                name_str = JSRT_CreateString("")
            }
        }
        JSRT_FuncPropSet(save_fn, "name", name_str)
        ReturnValue(1)
    }
}

Function.JSVM_IsSymbol {
    Input: val: Address
    Output: Integer
    Body: {
        save_v = val
        IfCondition EqualTo(save_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(save_v), JSType.OBJECT) ThenBlock: {
            ReturnValue(0)
        }
        cls = JSRT_ObjGet(save_v, JSVMSymbol.class_key)
        IfCondition EqualTo(cls, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cls, JSRTState.undef_val) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(JSRT_GetType(cls), JSType.STRING) ThenBlock: {
            ReturnValue(0)
        }
        sp = JSRT_GetPayload(cls)
        // M31a: class is UTF-16 JS string; compare units (C "Symbol" ok via StrUnit)
        IfCondition EqualTo(JSRT_StrEq(sp, "Symbol"), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Symbol → stable property key "@@s<id>" in str_slab
Function.JSVM_SymbolToKey {
    Input: val: Address
    Output: Address
    Body: {
        save_v = val
        sid_v = JSRT_ObjGet(save_v, JSVMSymbol.sid_key)
        sid = 0
        IfCondition EqualTo(JSRT_GetType(sid_v), JSType.NUMBER) ThenBlock: {
            sid = Float_ToInt(JSRT_GetPayload(sid_v))
        }
        // Build "@@s" + decimal sid in key_buf
        buf = JSVMSymbol.key_buf
        SetByte(buf, 0, 64)
        SetByte(buf, 1, 64)
        SetByte(buf, 2, 115)
        pos = 3
        // decimal sid (at least one digit)
        IfCondition LessThan(sid, 0) ThenBlock: { sid = 0 }
        // write digits reversed then flip
        tmp = sid
        digs = 0
        IfCondition EqualTo(tmp, 0) ThenBlock: {
            SetByte(buf, pos, 48)
            pos = Add(pos, 1)
        } ElseBlock: {
            // collect digits
            dbuf = Add(buf, 16)
            WhileLoop GreaterThan(tmp, 0) {
                SetByte(dbuf, digs, Add(48, Subtract(tmp, Multiply(Divide(tmp, 10), 10))))
                digs = Add(digs, 1)
                tmp = Divide(tmp, 10)
            }
            // reverse into buf
            ri = Subtract(digs, 1)
            WhileLoop GreaterEqual(ri, 0) {
                SetByte(buf, pos, GetByte(dbuf, ri))
                pos = Add(pos, 1)
                ri = Subtract(ri, 1)
            }
        }
        SetByte(buf, pos, 0)
        // stable copy
        out = JSRT__StrSlabAlloc(Add(pos, 1))
        IfCondition EqualTo(out, 0) ThenBlock: {
            ReturnValue(buf)
        }
        MemoryCopy(out, buf, Add(pos, 1))
        ReturnValue(out)
    }
}

// ToPropertyKey — Symbol → @@sN, else ToString payload
Function.JSVM_ToPropertyKey {
    Input: val: Address
    Output: Address
    Body: {
        save_v = val
        IfCondition EqualTo(JSVM_IsSymbol(save_v), 1) ThenBlock: {
            ReturnValue(JSVM_SymbolToKey(save_v))
        }
        IfCondition EqualTo(JSRT_GetType(save_v), JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_GetPayload(save_v))
        }
        // M19d: OrdinaryToPrimitive string hint (invoke toString) before ToString fallback
        prim = JSRT_ToPrimitive(save_v, 1)
        IfCondition EqualTo(prim, 0) ThenBlock: {
            // throw already pending from toString/valueOf
            ReturnValue(0)
        }
        IfCondition EqualTo(JSRT_GetType(prim), JSType.STRING) ThenBlock: {
            ReturnValue(JSRT_GetPayload(prim))
        }
        s = JSRT_ToString(prim)
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(JSRT_GetPayload(s))
    }
}

// Native Symbol() — handler 194
Function.JSVM_SymbolNative {
    Input: arg_buf: Address
    Input: argc: Integer
    Output: Address
    Body: {
        desc = 0
        IfCondition GreaterThan(argc, 0) ThenBlock: {
            desc = Dereference(arg_buf)
        }
        ReturnValue(JSVM_CreateSymbol(desc))
    }
}

// Expand iterable to a new array (arrays/strings/objects with @@iterator).
// On failure throws TypeError (or rethrows user throw from factory/next/getters)
// and returns 0. Callers (ARR_EXTEND/TO_ARRAY) treat 0 as "throw already set".
// Mole 21: always re-ThrowValue on exc_prop — GenNext isolates throw and does
// not deliver to outer catch (unlike nested CallFunc of plain JS next()).
Function.JSVM_IterableToArray {
    Input: src: Address
    Output: Address
    Body: {
        save_src = src
        st = JSRT_GetType(save_src)
        empty_buf = JSVMCallBuf.buf

        IfCondition Or(EqualTo(st, JSType.NULL), EqualTo(st, JSType.UNDEFINED)) ThenBlock: {
            terr = JSVM_CreateTypedError("TypeError", "Spread of null/undefined")
            JSVM_ThrowValue(terr)
            ReturnValue(0)
        }

        // Array — shallow copy elements
        IfCondition EqualTo(st, JSType.ARRAY) ThenBlock: {
            out = JSRT_CreateArray()
            n = JSRT_ArrLen(save_src)
            i = 0
            WhileLoop LessThan(i, n) {
                JSRT_ArrPush(out, JSRT_ArrGet(save_src, i))
                i = Add(i, 1)
            }
            ReturnValue(out)
        }

        // String — code units (M31a UTF-16)
        IfCondition EqualTo(st, JSType.STRING) ThenBlock: {
            out2 = JSRT_CreateArray()
            sp = JSRT_GetPayload(save_src)
            sl = JSRT_StrLen(sp)
            ci = 0
            WhileLoop LessThan(ci, sl) {
                JSRT_ArrPush(out2, JSRT_CreateStringSlice(sp, ci, 1))
                ci = Add(ci, 1)
            }
            ReturnValue(out2)
        }

        // Object — GetIterator via Symbol.iterator
        IfCondition NotEqual(st, JSType.OBJECT) ThenBlock: {
            terr2 = JSVM_CreateTypedError("TypeError", "object is not iterable")
            JSVM_ThrowValue(terr2)
            ReturnValue(0)
        }

        iter_key = 0
        IfCondition NotEqual(JSVMSymbol.iterator, 0) ThenBlock: {
            iter_key = JSVM_SymbolToKey(JSVMSymbol.iterator)
        }
        IfCondition EqualTo(iter_key, 0) ThenBlock: {
            terr3 = JSVM_CreateTypedError("TypeError", "object is not iterable")
            JSVM_ThrowValue(terr3)
            ReturnValue(0)
        }

        // Honor accessor on @@iterator (spread-err-*-itr-get-get)
        factory = 0
        gk_buf = JSVMCallBuf.getter_buf
        SetByte(gk_buf, 0, 95)
        SetByte(gk_buf, 1, 95)
        SetByte(gk_buf, 2, 103)
        SetByte(gk_buf, 3, 101)
        SetByte(gk_buf, 4, 116)
        SetByte(gk_buf, 5, 95)
        gki = 0
        gdone = 0
        WhileLoop EqualTo(gdone, 0) {
            gc = GetByte(iter_key, gki)
            SetByte(gk_buf, Add(6, gki), gc)
            IfCondition EqualTo(gc, 0) ThenBlock: {
                gdone = 1
            }
            gki = Add(gki, 1)
        }
        JSRT__Push(save_src)
        getter_it = JSRT_ObjGet(save_src, gk_buf)
        save_src = JSRT__Pop()
        IfCondition EqualTo(JSRT_GetType(getter_it), JSType.FUNCTION) ThenBlock: {
            JSVM__SetGlobal("this", save_src)
            factory = JSVM__CallFunc(getter_it, empty_buf, 0)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                // GenNext sets thrown_val/__pend_exc__; nested CallFunc+THROW-to-catch
                // already delivered — rethrow only when pending is set.
                pend = JSVMCall.thrown_val
                IfCondition EqualTo(pend, 0) ThenBlock: {
                    pend = JSVM__GetGlobal("__pend_exc__")
                }
                JSVMCall.thrown_val = 0
                JSVMCall.exc_prop = 0
                IfCondition NotEqual(pend, 0) ThenBlock: {
                    IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                        JSVMState.exc_val = 0
                        JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                        JSVM_ThrowValue(pend)
                    }
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                ReturnValue(0)
            }
        } ElseBlock: {
            factory = JSRT_ObjGet(save_src, iter_key)
        }

        // Prefer @@iterator; else accept objects that already are iterators
        // (have .next) — generator wrappers lack @@iterator today.
        iterator = 0
        IfCondition EqualTo(JSRT_GetType(factory), JSType.FUNCTION) ThenBlock: {
            JSVM__SetGlobal("this", save_src)
            iterator = JSVM__CallFunc(factory, empty_buf, 0)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                // GenNext sets thrown_val/__pend_exc__; nested CallFunc+THROW-to-catch
                // already delivered — rethrow only when pending is set.
                pend = JSVMCall.thrown_val
                IfCondition EqualTo(pend, 0) ThenBlock: {
                    pend = JSVM__GetGlobal("__pend_exc__")
                }
                JSVMCall.thrown_val = 0
                JSVMCall.exc_prop = 0
                IfCondition NotEqual(pend, 0) ThenBlock: {
                    IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                        JSVMState.exc_val = 0
                        JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                        JSVM_ThrowValue(pend)
                    }
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition NotEqual(JSRT_GetType(iterator), JSType.OBJECT) ThenBlock: {
                terr5 = JSVM_CreateTypedError("TypeError", "iterator result is not an object")
                JSVM_ThrowValue(terr5)
                ReturnValue(0)
            }
        } ElseBlock: {
            nxt_chk = JSRT_ObjGet(save_src, "next")
            IfCondition EqualTo(JSRT_GetType(nxt_chk), JSType.FUNCTION) ThenBlock: {
                iterator = save_src
            } ElseBlock: {
                terr4 = JSVM_CreateTypedError("TypeError", "object is not iterable")
                JSVM_ThrowValue(terr4)
                ReturnValue(0)
            }
        }

        next_fn = JSRT_ObjGet(iterator, "next")
        IfCondition NotEqual(JSRT_GetType(next_fn), JSType.FUNCTION) ThenBlock: {
            terr6 = JSVM_CreateTypedError("TypeError", "iterator.next is not a function")
            JSVM_ThrowValue(terr6)
            ReturnValue(0)
        }

        out3 = JSRT_CreateArray()
        hops = 0
        WhileLoop LessThan(hops, 100000) {
            JSVM__SetGlobal("this", iterator)
            JSRT__Push(iterator)
            JSRT__Push(next_fn)
            JSRT__Push(out3)
            res = JSVM__CallFunc(next_fn, empty_buf, 0)
            out3 = JSRT__Pop()
            next_fn = JSRT__Pop()
            iterator = JSRT__Pop()
            // next() throw — rethrow (GenNext isolates; plain JS may already deliver)
            IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                // GenNext sets thrown_val/__pend_exc__; nested CallFunc+THROW-to-catch
                // already delivered — rethrow only when pending is set.
                pend = JSVMCall.thrown_val
                IfCondition EqualTo(pend, 0) ThenBlock: {
                    pend = JSVM__GetGlobal("__pend_exc__")
                }
                JSVMCall.thrown_val = 0
                JSVMCall.exc_prop = 0
                IfCondition NotEqual(pend, 0) ThenBlock: {
                    IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                        JSVMState.exc_val = 0
                        JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                        JSVM_ThrowValue(pend)
                    }
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition NotEqual(JSRT_GetType(res), JSType.OBJECT) ThenBlock: {
                terr7 = JSVM_CreateTypedError("TypeError", "iterator result is not an object")
                JSVM_ThrowValue(terr7)
                ReturnValue(0)
            }
            // done: honor __get_done
            JSRT__Push(iterator)
            JSRT__Push(next_fn)
            JSRT__Push(out3)
            JSRT__Push(res)
            done_getter = JSRT_ObjGet(res, "__get_done")
            res = JSRT__Pop()
            out3 = JSRT__Pop()
            next_fn = JSRT__Pop()
            iterator = JSRT__Pop()
            IfCondition EqualTo(JSRT_GetType(done_getter), JSType.FUNCTION) ThenBlock: {
                JSVM__SetGlobal("this", res)
                JSRT__Push(iterator)
                JSRT__Push(next_fn)
                JSRT__Push(out3)
                JSRT__Push(res)
                done_v = JSVM__CallFunc(done_getter, empty_buf, 0)
                res = JSRT__Pop()
                out3 = JSRT__Pop()
                next_fn = JSRT__Pop()
                iterator = JSRT__Pop()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    IfCondition NotEqual(pend, 0) ThenBlock: {
                        IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                            JSVMState.exc_val = 0
                            JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                            JSVM_ThrowValue(pend)
                        }
                    }
                    ReturnValue(0)
                }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                    ReturnValue(0)
                }
            } ElseBlock: {
                done_v = JSRT_ObjGet(res, "done")
            }
            IfCondition EqualTo(JSRT_IsTruthy(done_v), 1) ThenBlock: {
                ReturnValue(out3)
            }
            // value: honor __get_value
            JSRT__Push(iterator)
            JSRT__Push(next_fn)
            JSRT__Push(out3)
            JSRT__Push(res)
            val_getter = JSRT_ObjGet(res, "__get_value")
            res = JSRT__Pop()
            out3 = JSRT__Pop()
            next_fn = JSRT__Pop()
            iterator = JSRT__Pop()
            IfCondition EqualTo(JSRT_GetType(val_getter), JSType.FUNCTION) ThenBlock: {
                JSVM__SetGlobal("this", res)
                JSRT__Push(iterator)
                JSRT__Push(next_fn)
                JSRT__Push(out3)
                val_v = JSVM__CallFunc(val_getter, empty_buf, 0)
                out3 = JSRT__Pop()
                next_fn = JSRT__Pop()
                iterator = JSRT__Pop()
                IfCondition EqualTo(JSVMCall.exc_prop, 1) ThenBlock: {
                    pend = JSVMCall.thrown_val
                    IfCondition EqualTo(pend, 0) ThenBlock: {
                        pend = JSVM__GetGlobal("__pend_exc__")
                    }
                    JSVMCall.thrown_val = 0
                    JSVMCall.exc_prop = 0
                    IfCondition NotEqual(pend, 0) ThenBlock: {
                        IfCondition NotEqual(pend, JSRTState.undef_val) ThenBlock: {
                            JSVMState.exc_val = 0
                            JSVM__SetGlobal("__pend_exc__", JSRT_Undefined())
                            JSVM_ThrowValue(pend)
                        }
                    }
                    ReturnValue(0)
                }
                IfCondition EqualTo(JSVMState.error, 1) ThenBlock: {
                    ReturnValue(0)
                }
            } ElseBlock: {
                val_v = JSRT_ObjGet(res, "value")
            }
            JSRT_ArrPush(out3, val_v)
            hops = Add(hops, 1)
        }
        terr8 = JSVM_CreateTypedError("TypeError", "iterator infinite")
        JSVM_ThrowValue(terr8)
        ReturnValue(0)
    }
}

// =============================================================================
// INIT — allocate all VM memory structures
// =============================================================================
Function.JSVM_Init {
    Output: Integer
    Body: {
        // Value stack (4096 x 8 bytes = 32768)
        ssz = Multiply(JSVMConst.MAX_STACK, 8)
        JSVMState.stack = Allocate(ssz)
        MemorySet(JSVMState.stack, 0, ssz)

        // Call frame stack (1024 x 72 bytes = 73728)
        fsz = Multiply(JSVMConst.MAX_FRAMES, JSVMConst.FRAME_SIZE)
        JSVMState.frames = Allocate(fsz)
        MemorySet(JSVMState.frames, 0, fsz)

        // Mole 7: per-frame func + env pointers
        ff_sz = Multiply(JSVMConst.MAX_FRAMES, 8)
        JSVMClosure.frame_funcs = Allocate(ff_sz)
        MemorySet(JSVMClosure.frame_funcs, 0, ff_sz)
        JSVMClosure.frame_envs = Allocate(ff_sz)
        MemorySet(JSVMClosure.frame_envs, 0, ff_sz)
        JSVMClosure.frame_args = Allocate(ff_sz)
        MemorySet(JSVMClosure.frame_args, 0, ff_sz)
        JSVMClosure.frame_this_st = Allocate(ff_sz)
        MemorySet(JSVMClosure.frame_this_st, 0, ff_sz)
        JSVMClosure.frame_saved_this = Allocate(ff_sz)
        MemorySet(JSVMClosure.frame_saved_this, 0, ff_sz)
        JSVMClosure.frame_has_saved_this = Allocate(ff_sz)
        MemorySet(JSVMClosure.frame_has_saved_this, 0, ff_sz)
        // M26e: unique sentinel for uninitialized derived `this`
        JSVMClosure.this_uninit = JSRT_CreateObject()
        // Permanent key strings "__cenv" and "__parent"
        ck = Allocate(8)
        SetByte(ck, 0, 95)
        SetByte(ck, 1, 95)
        SetByte(ck, 2, 99)
        SetByte(ck, 3, 101)
        SetByte(ck, 4, 110)
        SetByte(ck, 5, 118)
        SetByte(ck, 6, 0)
        JSVMClosure.cenv_key = ck
        pk = Allocate(10)
        SetByte(pk, 0, 95)
        SetByte(pk, 1, 95)
        SetByte(pk, 2, 112)
        SetByte(pk, 3, 97)
        SetByte(pk, 4, 114)
        SetByte(pk, 5, 101)
        SetByte(pk, 6, 110)
        SetByte(pk, 7, 116)
        SetByte(pk, 8, 0)
        JSVMClosure.parent_key = pk
        // "arguments" key for save/restore
        ak = Allocate(10)
        SetByte(ak, 0, 97)
        SetByte(ak, 1, 114)
        SetByte(ak, 2, 103)
        SetByte(ak, 3, 117)
        SetByte(ak, 4, 109)
        SetByte(ak, 5, 101)
        SetByte(ak, 6, 110)
        SetByte(ak, 7, 116)
        SetByte(ak, 8, 115)
        SetByte(ak, 9, 0)
        JSVMClosure.args_key = ak

        // Symbol keys: "__class__", "__sid__", key buffer "@@s..." 
        sck = Allocate(10)
        SetByte(sck, 0, 95)
        SetByte(sck, 1, 95)
        SetByte(sck, 2, 99)
        SetByte(sck, 3, 108)
        SetByte(sck, 4, 97)
        SetByte(sck, 5, 115)
        SetByte(sck, 6, 115)
        SetByte(sck, 7, 95)
        SetByte(sck, 8, 95)
        SetByte(sck, 9, 0)
        JSVMSymbol.class_key = sck
        ssk = Allocate(8)
        SetByte(ssk, 0, 95)
        SetByte(ssk, 1, 95)
        SetByte(ssk, 2, 115)
        SetByte(ssk, 3, 105)
        SetByte(ssk, 4, 100)
        SetByte(ssk, 5, 95)
        SetByte(ssk, 6, 95)
        SetByte(ssk, 7, 0)
        JSVMSymbol.sid_key = ssk
        JSVMSymbol.key_buf = Allocate(32)
        MemorySet(JSVMSymbol.key_buf, 0, 32)
        JSVMSymbol.next_id = 1
        JSVMSymbol.iterator = 0
        JSVMSymbol.species = 0
        JSVMSymbol.toStringTag = 0

        // Global variable hash (uses PropState.global_hash from PropTable_Init)
        JSVMState.globals = PropState.global_hash

        // VM temp stack (2048 entries x 8 bytes)
        JSVMStack.pool = Allocate(16384)
        JSVMStack.capacity = 2048
        JSVMStack.sp = 0

        // Exception handler stack (16 entries x 32 bytes = 512)
        // Each entry: [catch_addr, saved_sp, saved_fp, pad]
        JSVMState.exc_stack = Allocate(512)
        MemorySet(JSVMState.exc_stack, 0, 512)
        JSVMState.exc_sp = 0

        // Static call argument buffer (32 args x 8 bytes = 256)
        arg_buf_sz = Multiply(JSVMConst.MAX_CALL_ARGS, 8)
        JSVMCallBuf.buf = Allocate(arg_buf_sz)
        MemorySet(JSVMCallBuf.buf, 0, arg_buf_sz)

        // Static getter key buffer (128 bytes, reused by GET_PROP)
        JSVMCallBuf.getter_buf = Allocate(128)
        MemorySet(JSVMCallBuf.getter_buf, 0, 128)

        // Array method callback arg buffer (4 args x 8 bytes = 32)
        JSArrMethodBuf.arg0 = Allocate(32)
        MemorySet(JSArrMethodBuf.arg0, 0, 32)

        // Reset runtime state
        JSVMState.sp = 0
        JSVMState.fp = 0
        JSVMState.pc = 0
        JSVMState.halted = 0
        JSVMState.error = 0
        JSVMState.steps = 0
        JSVMState.code = 0
        JSVMState.code_len = 0
        JSVMState.const_pool = 0
        JSVMState.const_count = 0

        // Generator state
        JSVMGen.is_gen_exec = 0
        JSVMGen.active_gs = 0
        JSVMGen.nest_depth = 0

        // Static caller backup buffers for generators (MAX_STACK*8 + MAX_FRAMES*FRAME_SIZE)
        JSVMGen.stk_buf = Allocate(ssz)
        MemorySet(JSVMGen.stk_buf, 0, ssz)
        JSVMGen.frm_buf = Allocate(fsz)
        MemorySet(JSVMGen.frm_buf, 0, fsz)
        // Nest stack: 8 levels × (8×8 meta + stack + frames)
        // meta: active_gs, active_genval, caller_pc, caller_sp, caller_fp,
        //       is_gen_exec, fdi_only, fdi_limit
        JSVMGen.nest_meta = Allocate(Multiply(8, 64))
        MemorySet(JSVMGen.nest_meta, 0, Multiply(8, 64))
        JSVMGen.nest_stk = Allocate(Multiply(8, ssz))
        MemorySet(JSVMGen.nest_stk, 0, Multiply(8, ssz))
        JSVMGen.nest_frm = Allocate(Multiply(8, fsz))
        MemorySet(JSVMGen.nest_frm, 0, Multiply(8, fsz))
        // Parallel closure tables (MAX_FRAMES × 8 × 8 nest levels)
        side_all = Multiply(8, Multiply(JSVMConst.MAX_FRAMES, 8))
        JSVMGen.nest_envs = Allocate(side_all)
        MemorySet(JSVMGen.nest_envs, 0, side_all)
        JSVMGen.nest_ffuncs = Allocate(side_all)
        MemorySet(JSVMGen.nest_ffuncs, 0, side_all)
        JSVMGen.nest_fargs = Allocate(side_all)
        MemorySet(JSVMGen.nest_fargs, 0, side_all)

        // Static caller backup buffers for re-entrant calls (same sizes)
        JSVMCall.stk_buf = Allocate(ssz)
        MemorySet(JSVMCall.stk_buf, 0, ssz)
        JSVMCall.frm_buf = Allocate(fsz)
        MemorySet(JSVMCall.frm_buf, 0, fsz)

        // Nested eval backups (outer bytecode + stack/frames + func_pool)
        JSVMEvalState.code_bak = Allocate(JSVMEvalState.code_cap)
        MemorySet(JSVMEvalState.code_bak, 0, JSVMEvalState.code_cap)
        JSVMEvalState.const_bak = Allocate(JSVMEvalState.const_cap)
        MemorySet(JSVMEvalState.const_bak, 0, JSVMEvalState.const_cap)
        // func_pool: MAX_FUNCS * FUNC_SIZE (4096*56) — CLOSURE payloads point here
        JSVMEvalState.func_cap = Multiply(4096, 56)
        JSVMEvalState.func_bak = Allocate(JSVMEvalState.func_cap)
        MemorySet(JSVMEvalState.func_bak, 0, JSVMEvalState.func_cap)
        JSVMEvalState.stk_bak = Allocate(ssz)
        MemorySet(JSVMEvalState.stk_bak, 0, ssz)
        JSVMEvalState.frm_bak = Allocate(fsz)
        MemorySet(JSVMEvalState.frm_bak, 0, fsz)
        JSVMEvalState.depth = 0

        // Static constant value cache buffers (MAX_CONSTS * 8 + MAX_CONSTS * 16)
        cv_buf_sz = Multiply(JSVMConst.MAX_CONSTS, 8)
        JSVMState.cv_buf = Allocate(cv_buf_sz)
        MemorySet(JSVMState.cv_buf, 0, cv_buf_sz)
        cvp_buf_sz = Multiply(JSVMConst.MAX_CONSTS, 16)
        JSVMState.cvp_buf = Allocate(cvp_buf_sz)
        MemorySet(JSVMState.cvp_buf, 0, cvp_buf_sz)

        // Initialize JIT compiler (mmap executable buffers, entry table)
        JIT_Init()

        ReturnValue(1)
    }
}

// =============================================================================
// RESET — clear runtime state for re-execution
// =============================================================================
Function.JSVM_Reset {
    Output: Integer
    Body: {
        ssz = Multiply(JSVMConst.MAX_STACK, 8)
        MemorySet(JSVMState.stack, 0, ssz)
        fsz = Multiply(JSVMConst.MAX_FRAMES, JSVMConst.FRAME_SIZE)
        MemorySet(JSVMState.frames, 0, fsz)
        ff_sz_r = Multiply(JSVMConst.MAX_FRAMES, 8)
        IfCondition NotEqual(JSVMClosure.frame_this_st, 0) ThenBlock: {
            MemorySet(JSVMClosure.frame_this_st, 0, ff_sz_r)
        }
        IfCondition NotEqual(JSVMClosure.frame_saved_this, 0) ThenBlock: {
            MemorySet(JSVMClosure.frame_saved_this, 0, ff_sz_r)
        }
        IfCondition NotEqual(JSVMClosure.frame_has_saved_this, 0) ThenBlock: {
            MemorySet(JSVMClosure.frame_has_saved_this, 0, ff_sz_r)
        }
        JSVMState.sp = 0
        JSVMState.fp = 0
        JSVMState.pc = 0
        JSVMState.halted = 0
        JSVMState.error = 0
        JSVMState.steps = 0
        JSVMState.exc_sp = 0
        JSVMState.is_strict = 0
        JSVMState.this_tdz = 0
        JSVMState.private_init = 0
        JSVMState.field_define = 0
        JSVMStack.sp = 0
        JSVMGen.is_gen_exec = 0
        JSVMGen.active_gs = 0
        JSVMGen.active_genval = 0
        JSVMGen.nest_depth = 0
        JSVMGen.fdi_only = 0
        JSVMGen.fdi_limit = 0
        JSVMGen.fdi_mode = 0
        JSVMGen.nest_fdi_only = 0
        JSVMGen.nest_fdi_limit = 0
        JSVMGen.nest_fdi_mode = 0
        // M59: fresh script env per test/reset (top-level lexical)
        JSVMClosure.script_env = 0
        // Mole 17: reclaim gen slab between tests / engine resets
        // (batch harness runs many gens; wrap was corrupting state)
        JSGenSlab.pos = 0
        // Clear abrupt-completion flags left by prior test
        JSVMCall.exc_prop = 0
        JSVMCall.thrown_val = 0
        ReturnValue(0)
    }
}

// =============================================================================
// LOAD — load compiled bytecode and constant pool into VM
// =============================================================================
Function.JSVM_Load {
    Input: code: Address
    Input: code_len: Integer
    Input: const_pool: Address
    Input: const_count: Integer
    Output: Integer
    Body: {
        save_code = code
        save_len = code_len
        save_cp = const_pool
        save_cc = const_count
        JSVMState.code = save_code
        JSVMState.code_len = save_len
        JSVMState.const_pool = save_cp
        JSVMState.const_count = save_cc
        // Use static constant value cache buffers (pre-allocated in JSVM_Init)
        cv_sz = Multiply(save_cc, 8)
        IfCondition GreaterThan(cv_sz, 0) ThenBlock: {
            IfCondition LessEqual(save_cc, JSVMConst.MAX_CONSTS) ThenBlock: {
                JSVMState.const_vals = JSVMState.cv_buf
            } ElseBlock: {
                JSVMState.const_vals = Allocate(cv_sz)
            }
            MemorySet(JSVMState.const_vals, 0, cv_sz)
        }
        // Separate pool for constant JSValues — immune to FreeValue
        // 16 bytes per constant (same layout as val_pool slots)
        cvp_sz = Multiply(save_cc, 16)
        IfCondition GreaterThan(cvp_sz, 0) ThenBlock: {
            IfCondition LessEqual(save_cc, JSVMConst.MAX_CONSTS) ThenBlock: {
                JSVMState.const_val_pool = JSVMState.cvp_buf
            } ElseBlock: {
                JSVMState.const_val_pool = Allocate(cvp_sz)
            }
            MemorySet(JSVMState.const_val_pool, 0, cvp_sz)
            JSVMState.const_val_end = Add(JSVMState.const_val_pool, cvp_sz)
        }
        JSVMState.pc = 0
        JSVMState.sp = 0
        JSVMState.fp = 0
        JSVMState.halted = 0
        JSVMState.error = 0
        JSVMState.steps = 0
        ReturnValue(1)
    }
}

// =============================================================================
// STRING METHOD DISPATCH — execute string methods with receiver
// =============================================================================

// =============================================================================
// RUN — execute until HALT or error
// Returns top-of-stack value (address to JSValue), or undefined
// =============================================================================
Function.JSVM_Run {
    Output: Address
    Body: {
        WhileLoop And(EqualTo(JSVMState.halted, 0), EqualTo(JSVMState.error, 0)) {
            JSVM_Step()
        }
        // Return top of stack if any
        IfCondition GreaterThan(JSVMState.sp, 0) ThenBlock: {
            ReturnValue(JSVM__StackPop())
        }
        ReturnValue(JSRT_Undefined())
    }
}

// =============================================================================
// PUBLIC API — Set/Get Global variables
// =============================================================================

Function.JSVM_SetGlobal {
    Input: name: Address
    Input: jsval: Address
    Output: Integer
    Body: {
        save_name = name
        save_val = jsval
        ReturnValue(JSVM__SetGlobal(save_name, save_val))
    }
}

Function.JSVM_GetGlobal {
    Input: name: Address
    Output: Address
    Body: {
        save_name = name
        ReturnValue(JSVM__GetGlobal(save_name))
    }
}

// =============================================================================
// STATE QUERY
// =============================================================================

Function.JSVM_GetError {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.error)
    }
}

Function.JSVM_IsHalted {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.halted)
    }
}

Function.JSVM_GetSteps {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.steps)
    }
}

Function.JSVM_GetPC {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.pc)
    }
}

Function.JSVM_GetSP {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.sp)
    }
}

// =============================================================================
// DUMP STACK — debug aid, prints top N stack entries
// Returns number of entries printed
// =============================================================================
Function.JSVM_DumpStack {
    Output: Integer
    Body: {
        count = JSVMState.sp
        IfCondition GreaterThan(count, 16) ThenBlock: {
            count = 16
        }
        idx = 0
        WhileLoop LessThan(idx, count) {
            si = Subtract(Subtract(JSVMState.sp, 1), idx)
            saddr = Add(JSVMState.stack, Multiply(si, 8))
            val = Dereference(saddr)
            IfCondition NotEqual(val, 0) ThenBlock: {
                vt = JSRT_GetType(val)
                // NUMBER: print value
                IfCondition EqualTo(vt, JSType.NUMBER) ThenBlock: {
                    nv = Float_ToInt(JSRT_GetPayload(val))
                    PrintNumber(nv)
                }
                // STRING: print string
                IfCondition EqualTo(vt, JSType.STRING) ThenBlock: {
                    sv = JSRT_GetPayload(val)
                    IfCondition NotEqual(sv, 0) ThenBlock: {
                        JSRT_PrintJSString(sv)
                    }
                }
                // BOOLEAN: print true/false
                IfCondition EqualTo(vt, JSType.BOOLEAN) ThenBlock: {
                    bv = JSRT_GetPayload(val)
                    IfCondition NotEqual(bv, 0) ThenBlock: {
                        PrintString("true")
                    } ElseBlock: {
                        PrintString("false")
                    }
                }
                // UNDEFINED
                IfCondition EqualTo(vt, JSType.UNDEFINED) ThenBlock: {
                    PrintString("undefined")
                }
                // NULL
                IfCondition EqualTo(vt, JSType.NULL) ThenBlock: {
                    PrintString("null")
                }
                // OBJECT
                IfCondition EqualTo(vt, JSType.OBJECT) ThenBlock: {
                    PrintString("[object]")
                }
                // ARRAY
                IfCondition EqualTo(vt, JSType.ARRAY) ThenBlock: {
                    PrintString("[array]")
                }
                // FUNCTION
                IfCondition EqualTo(vt, JSType.FUNCTION) ThenBlock: {
                    PrintString("[function]")
                }
                PrintString(" ")
            }
            idx = Add(idx, 1)
        }
        ReturnValue(count)
    }
}

// =============================================================================
// MAX STEPS CONFIGURATION
// =============================================================================

Function.JSVM_SetMaxSteps {
    Input: max: Integer
    Output: Integer
    Body: {
        JSVMState.max_steps = max
        ReturnValue(0)
    }
}

Function.JSVM_GetMaxSteps {
    Output: Integer
    Body: {
        ReturnValue(JSVMState.max_steps)
    }
}

