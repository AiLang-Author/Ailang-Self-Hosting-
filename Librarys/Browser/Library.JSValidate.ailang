// Library.JSValidate.ailang — Truth-table-driven syntax validation for JS parser
// Runs side-by-side with the parser as a "watcher". Zero-branch O(1) lookup
// via flat tables indexed by token type or AST node type.
//
// Table 1: AssignTarget — which AST node types are valid assignment LHS
// Table 2: PostfixTarget — which AST node types allow postfix ++/--
// Table 3: StmtKeyword — which keywords can begin a statement
// Table 4: ExprStart — which tokens can begin an expression
//
// Each table is a flat byte array indexed by type value.
// Lookup: GetByte(table, type) → 1 = legal, 0 = illegal
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.JSValidConst {
    // Table sizes — must be >= max token/AST type value
    "TOK_TABLE_SIZE":    Initialize=256
    "AST_TABLE_SIZE":    Initialize=64
    // Scope tracking — redeclaration detection
    "MAX_SCOPE_DEPTH":   Initialize=16
    "MAX_SCOPE_NAMES":   Initialize=64
    // Entry size: ptr(8) + len(8) + kind(8) = 24 bytes
    "SCOPE_ENTRY_SIZE":  Initialize=24
    // Scope slab size: 64 names * 24 bytes = 1536 bytes per scope level
    "SCOPE_SLAB_SIZE":   Initialize=1536
    // Kind values: 0=var (allows redecl), 1=let/const/class/function-in-block
    "KIND_VAR":          Initialize=0
    "KIND_LEXICAL":      Initialize=1
}

// =============================================================================
// STATE — table pointers
// =============================================================================
FixedPool.JSValidState {
    "initialized":       Initialize=0
    "assign_target":     Initialize=0
    "postfix_target":    Initialize=0
    "stmt_start":        Initialize=0
    "expr_start":        Initialize=0
    "after_token":       Initialize=0
    // Scope tracking for redeclaration detection
    "scope_depth":       Initialize=0
    "scope_counts":      Initialize=0
    "scope_names":       Initialize=0
}

// Temporaries for scope operations — must be in FixedPool to survive calls
FixedPool.JSValidTmp {
    "i":          Initialize=0
    "addr":       Initialize=0
    "ep":         Initialize=0
    "el":         Initialize=0
    "ek":         Initialize=0
    "match":      Initialize=0
    "j":          Initialize=0
    "base":       Initialize=0
}

// Duplicate params checker state
FixedPool.JSValidDup {
    "names":    Initialize=0    // pointer to buffer: 32 entries × 16 bytes (ptr:8 + len:8)
    "count":    Initialize=0    // number of names stored
    "ptr":      Initialize=0    // temp: current param name ptr
    "len":      Initialize=0    // temp: current param name len
}

// Private names validation state — AllPrivateNamesValid per ES spec
// Supports nested classes: stack of name sets (up to 8 levels)
// Each level has up to 32 entries × 16 bytes (ptr:8 + len:8) = 512 bytes
// Total buffer: 8 levels × 512 bytes = 4096 bytes
FixedPool.JSValidPriv {
    "names":    Initialize=0    // pointer to buffer: 8 levels × 32 entries × 16 bytes
    "counts":   Initialize=0    // pointer to 8-entry array of counts (8 bytes each = 64 bytes)
    "depth":    Initialize=0    // current nesting depth (0 = not in any class)
}

// AST walker state — iterative DFS for static semantic checks
// Uses its own stack (not ASTStack) to avoid interference with parser
FixedPool.JSValidWalk {
    "stack":   Initialize=0    // pointer to 256-entry × 8-byte stack buffer
    "sp":      Initialize=0    // stack pointer (entry count)
    "cur":     Initialize=0    // current node index
    "ntype":   Initialize=0    // type of current node
    "child":   Initialize=0    // temp child node index
    "result":  Initialize=0    // walk result (0=ok, nonzero=error)
}

// =============================================================================
// INIT — allocate and populate all truth tables
// =============================================================================
Function.JSValidate_Init {
    Output: Integer
    Body: {
        // --- Table 1: Valid assignment targets (AST node types) ---
        // These AST types can appear as LHS of = or compound assignment
        JSValidState.assign_target = Arena_Alloc(JSValidConst.AST_TABLE_SIZE)
        MemorySet(JSValidState.assign_target, 0, JSValidConst.AST_TABLE_SIZE)

        // IDENT = 18
        SetByte(JSValidState.assign_target, 18, 1)
        // MEMBER_DOT = 16
        SetByte(JSValidState.assign_target, 16, 1)
        // MEMBER_BRACKET = 17
        SetByte(JSValidState.assign_target, 17, 1)
        // ARRAY_LIT = 25 (cover grammar: converted to ARRAY_PATTERN when = follows)
        SetByte(JSValidState.assign_target, 25, 1)
        // OBJECT_LIT = 24 (cover grammar: converted to OBJECT_PATTERN when = follows)
        SetByte(JSValidState.assign_target, 24, 1)
        // ARRAY_PATTERN = 42 (already a pattern)
        SetByte(JSValidState.assign_target, 42, 1)
        // OBJECT_PATTERN = 43 (already a pattern)
        SetByte(JSValidState.assign_target, 43, 1)

        // --- Table 2: Valid postfix ++/-- targets (same as assign targets) ---
        JSValidState.postfix_target = Arena_Alloc(JSValidConst.AST_TABLE_SIZE)
        MemorySet(JSValidState.postfix_target, 0, JSValidConst.AST_TABLE_SIZE)
        SetByte(JSValidState.postfix_target, 18, 1)
        SetByte(JSValidState.postfix_target, 16, 1)
        SetByte(JSValidState.postfix_target, 17, 1)

        // --- Table 3: Tokens that can start a statement ---
        JSValidState.stmt_start = Arena_Alloc(JSValidConst.TOK_TABLE_SIZE)
        MemorySet(JSValidState.stmt_start, 0, JSValidConst.TOK_TABLE_SIZE)

        // Keywords that begin statements
        SetByte(JSValidState.stmt_start, 70, 1)     // KW_VAR
        SetByte(JSValidState.stmt_start, 71, 1)     // KW_LET
        SetByte(JSValidState.stmt_start, 72, 1)     // KW_CONST
        SetByte(JSValidState.stmt_start, 73, 1)     // KW_FUNCTION
        SetByte(JSValidState.stmt_start, 74, 1)     // KW_RETURN
        SetByte(JSValidState.stmt_start, 75, 1)     // KW_IF
        SetByte(JSValidState.stmt_start, 77, 1)     // KW_WHILE
        SetByte(JSValidState.stmt_start, 78, 1)     // KW_FOR
        SetByte(JSValidState.stmt_start, 79, 1)     // KW_BREAK
        SetByte(JSValidState.stmt_start, 80, 1)     // KW_CONTINUE
        SetByte(JSValidState.stmt_start, 91, 1)     // KW_DO
        SetByte(JSValidState.stmt_start, 92, 1)     // KW_SWITCH
        SetByte(JSValidState.stmt_start, 95, 1)     // KW_TRY
        SetByte(JSValidState.stmt_start, 98, 1)     // KW_THROW
        SetByte(JSValidState.stmt_start, 89, 1)     // KW_DELETE (expr stmt)
        SetByte(JSValidState.stmt_start, 87, 1)     // KW_TYPEOF (expr stmt)
        SetByte(JSValidState.stmt_start, 88, 1)     // KW_VOID (expr stmt)
        SetByte(JSValidState.stmt_start, 85, 1)     // KW_NEW (expr stmt)
        // Punctuation/symbols that begin statements
        SetByte(JSValidState.stmt_start, 12, 1)     // LBRACE (block)
        SetByte(JSValidState.stmt_start, 16, 1)     // SEMI (empty stmt)
        // Expression statement starters
        SetByte(JSValidState.stmt_start, 1, 1)      // IDENT
        SetByte(JSValidState.stmt_start, 2, 1)      // NUMBER
        SetByte(JSValidState.stmt_start, 3, 1)      // STRING
        SetByte(JSValidState.stmt_start, 10, 1)     // LPAREN
        SetByte(JSValidState.stmt_start, 14, 1)     // LBRACKET
        SetByte(JSValidState.stmt_start, 31, 1)     // MINUS (unary)
        SetByte(JSValidState.stmt_start, 30, 1)     // PLUS (unary)
        SetByte(JSValidState.stmt_start, 46, 1)     // NOT
        SetByte(JSValidState.stmt_start, 50, 1)     // TILDE
        SetByte(JSValidState.stmt_start, 57, 1)     // PLUS_PLUS (prefix)
        SetByte(JSValidState.stmt_start, 58, 1)     // MINUS_MINUS (prefix)
        SetByte(JSValidState.stmt_start, 81, 1)     // KW_TRUE
        SetByte(JSValidState.stmt_start, 82, 1)     // KW_FALSE
        SetByte(JSValidState.stmt_start, 83, 1)     // KW_NULL
        SetByte(JSValidState.stmt_start, 84, 1)     // KW_UNDEFINED
        SetByte(JSValidState.stmt_start, 86, 1)     // KW_THIS
        SetByte(JSValidState.stmt_start, 102, 1)    // KW_CLASS
        SetByte(JSValidState.stmt_start, 106, 1)    // KW_ASYNC

        // --- Table 4: Tokens that can start an expression ---
        JSValidState.expr_start = Arena_Alloc(JSValidConst.TOK_TABLE_SIZE)
        MemorySet(JSValidState.expr_start, 0, JSValidConst.TOK_TABLE_SIZE)

        // Atoms
        SetByte(JSValidState.expr_start, 1, 1)      // IDENT
        SetByte(JSValidState.expr_start, 2, 1)      // NUMBER
        SetByte(JSValidState.expr_start, 3, 1)      // STRING
        SetByte(JSValidState.expr_start, 81, 1)     // KW_TRUE
        SetByte(JSValidState.expr_start, 82, 1)     // KW_FALSE
        SetByte(JSValidState.expr_start, 83, 1)     // KW_NULL
        SetByte(JSValidState.expr_start, 84, 1)     // KW_UNDEFINED
        SetByte(JSValidState.expr_start, 86, 1)     // KW_THIS
        // Prefix operators
        SetByte(JSValidState.expr_start, 31, 1)     // MINUS
        SetByte(JSValidState.expr_start, 30, 1)     // PLUS
        SetByte(JSValidState.expr_start, 46, 1)     // NOT
        SetByte(JSValidState.expr_start, 50, 1)     // TILDE
        SetByte(JSValidState.expr_start, 57, 1)     // PLUS_PLUS
        SetByte(JSValidState.expr_start, 58, 1)     // MINUS_MINUS
        SetByte(JSValidState.expr_start, 87, 1)     // KW_TYPEOF
        SetByte(JSValidState.expr_start, 88, 1)     // KW_VOID
        SetByte(JSValidState.expr_start, 89, 1)     // KW_DELETE
        SetByte(JSValidState.expr_start, 85, 1)     // KW_NEW
        // Grouping/Compound
        SetByte(JSValidState.expr_start, 10, 1)     // LPAREN
        SetByte(JSValidState.expr_start, 14, 1)     // LBRACKET (array lit)
        SetByte(JSValidState.expr_start, 12, 1)     // LBRACE (object lit)
        SetByte(JSValidState.expr_start, 73, 1)     // KW_FUNCTION (func expr)
        SetByte(JSValidState.expr_start, 102, 1)    // KW_CLASS (class expr)
        SetByte(JSValidState.expr_start, 104, 1)    // KW_SUPER
        SetByte(JSValidState.expr_start, 125, 1)    // TMPL_FULL
        SetByte(JSValidState.expr_start, 126, 1)    // TMPL_HEAD
        SetByte(JSValidState.expr_start, 106, 1)    // KW_ASYNC
        SetByte(JSValidState.expr_start, 107, 1)    // KW_AWAIT
        SetByte(JSValidState.expr_start, 130, 1)    // REGEX_LIT

        // --- Scope tracking tables for redeclaration detection ---
        // scope_counts: array of 16 integers (8 bytes each) = 128 bytes
        JSValidState.scope_counts = Arena_Alloc(128)
        MemorySet(JSValidState.scope_counts, 0, 128)
        // scope_names: 16 slabs * 1536 bytes = 24576 bytes
        JSValidState.scope_names = Arena_Alloc(24576)
        MemorySet(JSValidState.scope_names, 0, 24576)
        JSValidState.scope_depth = 0

        // --- AST walker stack for static semantic checks ---
        JSValidWalk.stack = Arena_Alloc(2048)
        MemorySet(JSValidWalk.stack, 0, 2048)
        JSValidWalk.sp = 0

        // --- Duplicate params buffer: 32 entries × 16 bytes = 512 bytes ---
        JSValidDup.names = Arena_Alloc(512)
        MemorySet(JSValidDup.names, 0, 512)
        JSValidDup.count = 0

        // --- Private names buffer: 8 levels × 32 entries × 16 bytes = 4096 bytes ---
        JSValidPriv.names = Arena_Alloc(4096)
        MemorySet(JSValidPriv.names, 0, 4096)
        // Counts array: 8 × 8 bytes = 64 bytes
        JSValidPriv.counts = Arena_Alloc(64)
        MemorySet(JSValidPriv.counts, 0, 64)
        JSValidPriv.depth = 0

        JSValidState.initialized = 1
        ReturnValue(1)
    }
}

// =============================================================================
// VALIDATION CHECKS — called from parser at key decision points
// =============================================================================

// Check if an AST node type is a valid assignment target (lvalue)
// Caller passes node type (from JSParse_GetType), not node index
// Returns 1 if valid, 0 if invalid
Function.JSValidate_IsLValue {
    Input: ntype: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(ntype, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ntype, JSValidConst.AST_TABLE_SIZE) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(GetByte(JSValidState.assign_target, ntype))
    }
}

// Check if an AST node type is a valid postfix/prefix ++/-- target
// Caller passes node type (from JSParse_GetType), not node index
// Returns 1 if valid, 0 if invalid
Function.JSValidate_IsPostfixTarget {
    Input: ntype: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(ntype, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ntype, JSValidConst.AST_TABLE_SIZE) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(GetByte(JSValidState.postfix_target, ntype))
    }
}

// Check if a token type can start an expression
Function.JSValidate_CanStartExpr {
    Input: tok_type: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(tok_type, JSValidConst.TOK_TABLE_SIZE) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(GetByte(JSValidState.expr_start, tok_type))
    }
}

// Check if a token type can start a statement
Function.JSValidate_CanStartStmt {
    Input: tok_type: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(tok_type, JSValidConst.TOK_TABLE_SIZE) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(GetByte(JSValidState.stmt_start, tok_type))
    }
}

// =============================================================================
// SCOPE TRACKING — lexical redeclaration detection
// =============================================================================

// String equality check: compare two ptr+len pairs byte-by-byte
// Returns 1 if equal, 0 if not. Uses JSValidTmp fields for loop state.
Function.JSValidate__StrEq {
    Input: p1: Address
    Input: l1: Integer
    Input: p2: Address
    Input: l2: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(l1, l2) ThenBlock: { ReturnValue(0) }
        JSValidTmp.i = 0
        WhileLoop LessThan(JSValidTmp.i, l1) {
            IfCondition NotEqual(GetByte(p1, JSValidTmp.i), GetByte(p2, JSValidTmp.i)) ThenBlock: {
                ReturnValue(0)
            }
            JSValidTmp.i = Add(JSValidTmp.i, 1)
        }
        ReturnValue(1)
    }
}

// Push a new scope level. Called when entering { block } or switch body.
Function.JSValidate_PushScope {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(JSValidState.scope_depth, JSValidConst.MAX_SCOPE_DEPTH) ThenBlock: {
            ReturnValue(0)
        }
        // Zero the count for the new scope level
        StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidState.scope_depth, 8)), 0)
        JSValidState.scope_depth = Add(JSValidState.scope_depth, 1)
        ReturnValue(1)
    }
}

// Pop current scope level. Called when leaving } block or switch body.
Function.JSValidate_PopScope {
    Output: Integer
    Body: {
        IfCondition LessEqual(JSValidState.scope_depth, 0) ThenBlock: {
            ReturnValue(0)
        }
        JSValidState.scope_depth = Subtract(JSValidState.scope_depth, 1)
        // Reset count for the popped scope
        StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidState.scope_depth, 8)), 0)
        ReturnValue(1)
    }
}

// Reset all scope state. Called at start of each compilation unit.
Function.JSValidate_ResetScopes {
    Output: Integer
    Body: {
        JSValidState.scope_depth = 0
        MemorySet(JSValidState.scope_counts, 0, 128)
        ReturnValue(1)
    }
}

// Declare a binding in the current scope. Returns 1 if OK, 0 if redeclaration error.
// kind: 0 = var (allows same-scope redecl with other vars), 1 = lexical (let/const/class/func-in-block)
// Rules:
//   - let/const/class cannot redeclare ANY existing name in same scope
//   - var cannot redeclare a let/const/class in same scope
//   - var CAN redeclare another var in same scope
Function.JSValidate_DeclareBinding {
    Input: name_ptr: Address
    Input: name_len: Integer
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(JSValidState.scope_depth, 0) ThenBlock: {
            // No scope active — allow (top-level var decls outside blocks)
            ReturnValue(1)
        }

        // Get current scope index (depth - 1)
        JSValidTmp.base = Subtract(JSValidState.scope_depth, 1)

        // Get count of names in current scope
        JSValidTmp.i = Dereference(Add(JSValidState.scope_counts, Multiply(JSValidTmp.base, 8)))


        // Search existing names in this scope for a match
        JSValidTmp.addr = Add(JSValidState.scope_names, Multiply(JSValidTmp.base, JSValidConst.SCOPE_SLAB_SIZE))
        JSValidTmp.j = 0
        WhileLoop LessThan(JSValidTmp.j, JSValidTmp.i) {
            JSValidTmp.ep = Dereference(Add(JSValidTmp.addr, Multiply(JSValidTmp.j, JSValidConst.SCOPE_ENTRY_SIZE)))
            JSValidTmp.el = Dereference(Add(Add(JSValidTmp.addr, Multiply(JSValidTmp.j, JSValidConst.SCOPE_ENTRY_SIZE)), 8))
            JSValidTmp.ek = Dereference(Add(Add(JSValidTmp.addr, Multiply(JSValidTmp.j, JSValidConst.SCOPE_ENTRY_SIZE)), 16))

            // Quick length check first
            IfCondition EqualTo(JSValidTmp.el, name_len) ThenBlock: {
                // SSE2-accelerated memory comparison
                JSValidTmp.match = MemCompare(name_ptr, JSValidTmp.ep, name_len)
                IfCondition EqualTo(JSValidTmp.match, 0) ThenBlock: {
                    // Found a matching name! Check redeclaration rules:
                    // - If new binding is lexical (kind=1): ALWAYS error
                    // - If new binding is var (kind=0): error only if existing is lexical
                    IfCondition EqualTo(kind, JSValidConst.KIND_LEXICAL) ThenBlock: {
                        ReturnValue(0)
                    }
                    // kind=0 (var) — error if existing is lexical
                    IfCondition EqualTo(JSValidTmp.ek, JSValidConst.KIND_LEXICAL) ThenBlock: {
                        ReturnValue(0)
                    }
                    // var redeclaring var — allowed, just return OK
                    ReturnValue(1)
                }
            }
            JSValidTmp.j = Add(JSValidTmp.j, 1)
        }

        // No duplicate found — add the binding
        IfCondition GreaterEqual(JSValidTmp.i, JSValidConst.MAX_SCOPE_NAMES) ThenBlock: {
            // Scope full — silently allow (don't crash)
            ReturnValue(1)
        }

        // Store: [ptr, len, kind] at entry index i
        JSValidTmp.addr = Add(JSValidTmp.addr, Multiply(JSValidTmp.i, JSValidConst.SCOPE_ENTRY_SIZE))
        StoreValue(JSValidTmp.addr, name_ptr)
        StoreValue(Add(JSValidTmp.addr, 8), name_len)
        StoreValue(Add(JSValidTmp.addr, 16), kind)

        // Increment count
        StoreValue(Add(JSValidState.scope_counts, Multiply(JSValidTmp.base, 8)), Add(JSValidTmp.i, 1))

        ReturnValue(1)
    }
}

// =============================================================================
// AST WALKER — iterative DFS for class element static semantic checks
// =============================================================================

// Internal: push a node onto the walk stack (skip if <= 0 or stack full)
Function.JSValidWalk__Push {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterThan(node, 0), LessThan(JSValidWalk.sp, 256)) ThenBlock: {
            StoreValue(Add(JSValidWalk.stack, Multiply(JSValidWalk.sp, 8)), node)
            JSValidWalk.sp = Add(JSValidWalk.sp, 1)
        }
        ReturnValue(0)
    }
}

// Internal: pop a node from the walk stack (returns 0 if empty)
Function.JSValidWalk__Pop {
    Output: Integer
    Body: {
        IfCondition LessEqual(JSValidWalk.sp, 0) ThenBlock: { ReturnValue(0) }
        JSValidWalk.sp = Subtract(JSValidWalk.sp, 1)
        ReturnValue(Dereference(Add(JSValidWalk.stack, Multiply(JSValidWalk.sp, 8))))
    }
}

// Internal: push all children of a node (LEFT, RIGHT, BODY, COND, NEXT)
// Uses JSValidWalk.cur to preserve node across calls
Function.JSValidWalk__PushChildren {
    Input: node: Integer
    Output: Integer
    Body: {
        JSValidWalk.cur = node
        JSValidWalk.child = JSParse_GetNext(JSValidWalk.cur)
        JSValidWalk__Push(JSValidWalk.child)
        JSValidWalk.child = JSParse_GetCond(JSValidWalk.cur)
        JSValidWalk__Push(JSValidWalk.child)
        JSValidWalk.child = JSParse_GetBody(JSValidWalk.cur)
        JSValidWalk__Push(JSValidWalk.child)
        JSValidWalk.child = JSParse_GetRight(JSValidWalk.cur)
        JSValidWalk__Push(JSValidWalk.child)
        JSValidWalk.child = JSParse_GetLeft(JSValidWalk.cur)
        JSValidWalk__Push(JSValidWalk.child)
        ReturnValue(0)
    }
}

// Check whether a node type is a function boundary (creates own arguments/super)
// FUNC_EXPR=27, FUNC_DECL=4, GEN_FUNC_EXPR=50, GEN_FUNC_DECL=49,
// ASYNC_FUNC_EXPR=60, ASYNC_FUNC_DECL=59
// Does NOT include ARROW_EXPR=47 (arrows inherit outer arguments/super)
Function.JSValidWalk__IsFuncBoundary {
    Input: ntype: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ntype, 27) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ntype, 4) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ntype, 50) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ntype, 49) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ntype, 60) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ntype, 59) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Check if a field initializer AST subtree contains 'arguments' or super().
// Per ES spec 15.7.1 Static Semantics: Early Errors
//   - ContainsArguments of Initializer → SyntaxError
//   - Initializer Contains SuperCall → SyntaxError
// Stops at function boundaries but NOT arrow functions.
// Returns: 0=OK, 1=contains 'arguments', 2=contains super() call
Function.JSValidate_CheckFieldInit {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(node, 0) ThenBlock: { ReturnValue(0) }

        JSValidWalk.sp = 0
        JSValidWalk__Push(node)
        JSValidWalk.result = 0

        WhileLoop And(GreaterThan(JSValidWalk.sp, 0), EqualTo(JSValidWalk.result, 0)) {
            JSValidWalk.cur = JSValidWalk__Pop()

            IfCondition GreaterThan(JSValidWalk.cur, 0) ThenBlock: {
                JSValidWalk.ntype = JSParse_GetType(JSValidWalk.cur)

                // Skip function boundaries (they create own arguments/super)
                IfCondition EqualTo(JSValidWalk__IsFuncBoundary(JSValidWalk.ntype), 0) ThenBlock: {

                    // Check for IDENT(18) named "arguments"
                    // "arguments" = 97 114 103 117 109 101 110 116 115 (9 bytes)
                    IfCondition EqualTo(JSValidWalk.ntype, 18) ThenBlock: {
                        JSValidWalk.child = JSParse_GetNameLen(JSValidWalk.cur)
                        IfCondition EqualTo(JSValidWalk.child, 9) ThenBlock: {
                            JSValidWalk.child = JSParse_GetNamePtr(JSValidWalk.cur)
                            IfCondition And(EqualTo(GetByte(JSValidWalk.child, 0), 97), EqualTo(GetByte(JSValidWalk.child, 1), 114)) ThenBlock: {
                                IfCondition And(EqualTo(GetByte(JSValidWalk.child, 2), 103), EqualTo(GetByte(JSValidWalk.child, 3), 117)) ThenBlock: {
                                    IfCondition And(EqualTo(GetByte(JSValidWalk.child, 4), 109), EqualTo(GetByte(JSValidWalk.child, 5), 101)) ThenBlock: {
                                        IfCondition And(EqualTo(GetByte(JSValidWalk.child, 6), 110), EqualTo(GetByte(JSValidWalk.child, 7), 116)) ThenBlock: {
                                            IfCondition EqualTo(GetByte(JSValidWalk.child, 8), 115) ThenBlock: {
                                                JSValidWalk.result = 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Check for super() call: CALL(15) with LEFT = SUPER_EXPR(53)
                    IfCondition And(EqualTo(JSValidWalk.ntype, 15), EqualTo(JSValidWalk.result, 0)) ThenBlock: {
                        JSValidWalk.child = JSParse_GetLeft(JSValidWalk.cur)
                        IfCondition GreaterThan(JSValidWalk.child, 0) ThenBlock: {
                            IfCondition EqualTo(JSParse_GetType(JSValidWalk.child), 53) ThenBlock: {
                                JSValidWalk.result = 2
                            }
                        }
                    }

                    // Push children for further traversal
                    IfCondition EqualTo(JSValidWalk.result, 0) ThenBlock: {
                        JSValidWalk__PushChildren(JSValidWalk.cur)
                    }
                }
            }
        }

        JSValidWalk.sp = 0
        ReturnValue(JSValidWalk.result)
    }
}

// Check if a method body AST subtree contains a direct super() call.
// Used for: non-constructor methods where super() is illegal.
// Per ES spec 15.4.1: HasDirectSuper of MethodDefinition.
// Stops at function boundaries but NOT arrow functions.
// Returns: 1 if super() found, 0 otherwise
Function.JSValidate_HasDirectSuper {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(node, 0) ThenBlock: { ReturnValue(0) }

        JSValidWalk.sp = 0
        JSValidWalk__Push(node)
        JSValidWalk.result = 0

        WhileLoop And(GreaterThan(JSValidWalk.sp, 0), EqualTo(JSValidWalk.result, 0)) {
            JSValidWalk.cur = JSValidWalk__Pop()

            IfCondition GreaterThan(JSValidWalk.cur, 0) ThenBlock: {
                JSValidWalk.ntype = JSParse_GetType(JSValidWalk.cur)

                // Skip function boundaries
                IfCondition EqualTo(JSValidWalk__IsFuncBoundary(JSValidWalk.ntype), 0) ThenBlock: {

                    // Check for CALL(15) with SUPER_EXPR(53) callee
                    IfCondition EqualTo(JSValidWalk.ntype, 15) ThenBlock: {
                        JSValidWalk.child = JSParse_GetLeft(JSValidWalk.cur)
                        IfCondition GreaterThan(JSValidWalk.child, 0) ThenBlock: {
                            IfCondition EqualTo(JSParse_GetType(JSValidWalk.child), 53) ThenBlock: {
                                JSValidWalk.result = 1
                            }
                        }
                    }

                    IfCondition EqualTo(JSValidWalk.result, 0) ThenBlock: {
                        JSValidWalk__PushChildren(JSValidWalk.cur)
                    }
                }
            }
        }

        JSValidWalk.sp = 0
        ReturnValue(JSValidWalk.result)
    }
}

// ---------------------------------------------------------------------------
// JSValidate_BodyHasUseStrict — check if a BLOCK node's first statement
// is an expression statement containing string literal "use strict"
// Returns: 1 if "use strict" directive found, 0 otherwise
// ---------------------------------------------------------------------------
Function.JSValidate_BodyHasUseStrict {
    Input: block_node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(block_node, 0) ThenBlock: { ReturnValue(0) }

        // Get first statement in block (N_BODY)
        first_stmt = JSParse_GetBody(block_node)
        IfCondition LessThan(first_stmt, 0) ThenBlock: { ReturnValue(0) }

        // Must be EXPR_STMT (type 11)
        IfCondition NotEqual(JSParse_GetType(first_stmt), 11) ThenBlock: { ReturnValue(0) }

        // Get the expression (N_LEFT)
        expr = JSParse_GetLeft(first_stmt)
        IfCondition LessThan(expr, 0) ThenBlock: { ReturnValue(0) }

        // Must be STRING_LIT (type 20)
        IfCondition NotEqual(JSParse_GetType(expr), 20) ThenBlock: { ReturnValue(0) }

        // Check string content: must be exactly "use strict" (10 bytes)
        us_ptr = JSParse_GetNamePtr(expr)
        us_len = JSParse_GetNameLen(expr)
        IfCondition NotEqual(us_len, 10) ThenBlock: { ReturnValue(0) }

        // Compare bytes: u=117 s=115 e=101 ' '=32 s=115 t=116 r=114 i=105 c=99 t=116
        IfCondition NotEqual(GetByte(us_ptr, 0), 117) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(us_ptr, 1), 115) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(us_ptr, 2), 101) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(us_ptr, 3), 32) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(us_ptr, 4), 115) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(us_ptr, 5), 116) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(us_ptr, 6), 114) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(us_ptr, 7), 105) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(us_ptr, 8), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(us_ptr, 9), 116) ThenBlock: { ReturnValue(0) }

        ReturnValue(1)
    }
}

// ---------------------------------------------------------------------------
// JSValidate_CheckDupParams — check for duplicate parameter names
// Walks param linked list (N_NEXT chain), extracts name from each param
// using Branch on node type, compares against previously seen names.
// Returns: 1 if duplicate found (error), 0 if all unique
// ---------------------------------------------------------------------------
Function.JSValidate_CheckDupParams {
    Input: first_param: Integer
    Output: Integer
    Body: {
        JSValidDup.count = 0
        dup_cur = first_param

        WhileLoop GreaterEqual(dup_cur, 0) {
            JSValidDup.ptr = 0
            JSValidDup.len = 0

            // Extract name based on param node type
            dup_type = JSParse_GetType(dup_cur)
            Branch dup_type {
                // IDENT (18) — name directly on node
                Case 18: {
                    JSValidDup.ptr = JSParse_GetNamePtr(dup_cur)
                    JSValidDup.len = JSParse_GetNameLen(dup_cur)
                }
                // ASSIGN (12) — default param; name on node (FuncDecl path) or in N_RIGHT child
                Case 12: {
                    JSValidDup.ptr = JSParse_GetNamePtr(dup_cur)
                    JSValidDup.len = JSParse_GetNameLen(dup_cur)
                    // If name not on wrapper, check N_RIGHT child (IDENT)
                    IfCondition EqualTo(JSValidDup.len, 0) ThenBlock: {
                        dup_right = JSParse_GetRight(dup_cur)
                        IfCondition GreaterEqual(dup_right, 0) ThenBlock: {
                            IfCondition EqualTo(JSParse_GetType(dup_right), 18) ThenBlock: {
                                JSValidDup.ptr = JSParse_GetNamePtr(dup_right)
                                JSValidDup.len = JSParse_GetNameLen(dup_right)
                            }
                        }
                    }
                }
                // REST_ELEMENT (44) — binding in N_LEFT child
                Case 44: {
                    dup_left = JSParse_GetLeft(dup_cur)
                    IfCondition GreaterEqual(dup_left, 0) ThenBlock: {
                        IfCondition EqualTo(JSParse_GetType(dup_left), 18) ThenBlock: {
                            JSValidDup.ptr = JSParse_GetNamePtr(dup_left)
                            JSValidDup.len = JSParse_GetNameLen(dup_left)
                        }
                    }
                }
            }

            // If we extracted a name, check against all previous names
            IfCondition GreaterThan(JSValidDup.len, 0) ThenBlock: {
                dup_i = 0
                WhileLoop LessThan(dup_i, JSValidDup.count) {
                    dup_base = Add(JSValidDup.names, Multiply(dup_i, 16))
                    dup_prev_ptr = Dereference(dup_base)
                    dup_prev_len = Dereference(Add(dup_base, 8))
                    IfCondition EqualTo(JSValidate__StrEq(JSValidDup.ptr, JSValidDup.len, dup_prev_ptr, dup_prev_len), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                    dup_i = Add(dup_i, 1)
                }

                // Store this name (if room)
                IfCondition LessThan(JSValidDup.count, 32) ThenBlock: {
                    dup_slot = Add(JSValidDup.names, Multiply(JSValidDup.count, 16))
                    StoreValue(dup_slot, JSValidDup.ptr)
                    StoreValue(Add(dup_slot, 8), JSValidDup.len)
                    JSValidDup.count = Add(JSValidDup.count, 1)
                }
            }

            dup_cur = JSParse_GetNext(dup_cur)
        }

        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// Private names scope stack — push/pop for nested classes
// ---------------------------------------------------------------------------

// Push a new private name scope (entering a class body)
Function.JSValidate_PrivPush {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(JSValidPriv.depth, 8) ThenBlock: { ReturnValue(0) }
        // Zero the count for this new level
        StoreValue(Add(JSValidPriv.counts, Multiply(JSValidPriv.depth, 8)), 0)
        JSValidPriv.depth = Add(JSValidPriv.depth, 1)
        ReturnValue(1)
    }
}

// Pop a private name scope (leaving a class body)
Function.JSValidate_PrivPop {
    Output: Integer
    Body: {
        IfCondition GreaterThan(JSValidPriv.depth, 0) ThenBlock: {
            JSValidPriv.depth = Subtract(JSValidPriv.depth, 1)
        }
        ReturnValue(0)
    }
}

// Add a declared private name to the current scope level
// Called during class body parsing when a #name element is encountered
Function.JSValidate_PrivAdd {
    Input: name_ptr: Address
    Input: name_len: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(JSValidPriv.depth, 0) ThenBlock: { ReturnValue(0) }
        pv_level = Subtract(JSValidPriv.depth, 1)
        pv_cnt = Dereference(Add(JSValidPriv.counts, Multiply(pv_level, 8)))
        IfCondition GreaterEqual(pv_cnt, 32) ThenBlock: { ReturnValue(0) }

        // Check not already recorded at this level (get/set pairs)
        pv_base = Add(JSValidPriv.names, Multiply(pv_level, 512))
        pv_ai = 0
        pv_dup = 0
        WhileLoop And(LessThan(pv_ai, pv_cnt), EqualTo(pv_dup, 0)) {
            pv_slot = Add(pv_base, Multiply(pv_ai, 16))
            IfCondition EqualTo(JSValidate__StrEq(name_ptr, name_len, Dereference(pv_slot), Dereference(Add(pv_slot, 8))), 1) ThenBlock: {
                pv_dup = 1
            }
            pv_ai = Add(pv_ai, 1)
        }
        IfCondition EqualTo(pv_dup, 1) ThenBlock: { ReturnValue(1) }

        // Store the name
        pv_slot = Add(pv_base, Multiply(pv_cnt, 16))
        StoreValue(pv_slot, name_ptr)
        StoreValue(Add(pv_slot, 8), name_len)
        StoreValue(Add(JSValidPriv.counts, Multiply(pv_level, 8)), Add(pv_cnt, 1))
        ReturnValue(1)
    }
}

// Check if a #name reference is declared in ANY enclosing class scope
// Returns: 1 if found (valid), 0 if not found (error)
Function.JSValidate_PrivLookup {
    Input: ref_ptr: Address
    Input: ref_len: Integer
    Output: Integer
    Body: {
        pv_li = 0
        WhileLoop LessThan(pv_li, JSValidPriv.depth) {
            pv_cnt = Dereference(Add(JSValidPriv.counts, Multiply(pv_li, 8)))
            pv_base = Add(JSValidPriv.names, Multiply(pv_li, 512))
            pv_si = 0
            WhileLoop LessThan(pv_si, pv_cnt) {
                pv_slot = Add(pv_base, Multiply(pv_si, 16))
                IfCondition EqualTo(JSValidate__StrEq(ref_ptr, ref_len, Dereference(pv_slot), Dereference(Add(pv_slot, 8))), 1) ThenBlock: {
                    ReturnValue(1)
                }
                pv_si = Add(pv_si, 1)
            }
            pv_li = Add(pv_li, 1)
        }
        ReturnValue(0)
    }
}

// ---------------------------------------------------------------------------
// JSValidate_AllPrivateNamesValid — ES spec 15.7.1 Static Semantics
// Validates that every #name reference in the class body refers to a name
// declared in this class OR any enclosing class. Names are already collected
// via JSValidate_PrivAdd during parsing. This function only does the walk.
// Input: first_element — head of class body linked list (methods/fields via N_NEXT)
// Returns: 0 if valid, 1 if invalid (undeclared #name reference found)
// ---------------------------------------------------------------------------
Function.JSValidate_AllPrivateNamesValid {
    Input: first_element: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(first_element, 0) ThenBlock: { ReturnValue(0) }

        // DFS walk all elements (method bodies, field initializers)
        // Stop at: CLASS_DECL(51), CLASS_EXPR(52) — inner classes validate themselves
        // Check: MEMBER_DOT(16), OPT_MEMBER(56) with name starting with '#'
        JSValidWalk.sp = 0
        JSValidWalk.result = 0

        // Push all elements onto the walk stack
        pv_cur = first_element
        WhileLoop GreaterThan(pv_cur, 0) {
            // Push the method body (N_BODY)
            JSValidWalk.child = JSParse_GetBody(pv_cur)
            JSValidWalk__Push(JSValidWalk.child)
            // Push the field initializer (N_LEFT for CLASS_FIELD)
            JSValidWalk.child = JSParse_GetLeft(pv_cur)
            JSValidWalk__Push(JSValidWalk.child)
            // Push params (N_RIGHT)
            JSValidWalk.child = JSParse_GetRight(pv_cur)
            JSValidWalk__Push(JSValidWalk.child)
            pv_cur = JSParse_GetNext(pv_cur)
        }

        // DFS walk
        WhileLoop And(GreaterThan(JSValidWalk.sp, 0), EqualTo(JSValidWalk.result, 0)) {
            JSValidWalk.cur = JSValidWalk__Pop()

            IfCondition GreaterThan(JSValidWalk.cur, 0) ThenBlock: {
                JSValidWalk.ntype = JSParse_GetType(JSValidWalk.cur)

                // Stop at class boundaries (inner classes validate themselves)
                IfCondition And(NotEqual(JSValidWalk.ntype, 51), NotEqual(JSValidWalk.ntype, 52)) ThenBlock: {

                    // Check MEMBER_DOT(16) or OPT_MEMBER(56) with private name
                    IfCondition Or(EqualTo(JSValidWalk.ntype, 16), EqualTo(JSValidWalk.ntype, 56)) ThenBlock: {
                        pv_ref_ptr = JSParse_GetNamePtr(JSValidWalk.cur)
                        pv_ref_len = JSParse_GetNameLen(JSValidWalk.cur)
                        IfCondition And(GreaterThan(pv_ref_ptr, 0), GreaterThan(pv_ref_len, 0)) ThenBlock: {
                            IfCondition EqualTo(GetByte(pv_ref_ptr, 0), 35) ThenBlock: {
                                // Verify declared in any enclosing class scope
                                IfCondition EqualTo(JSValidate_PrivLookup(pv_ref_ptr, pv_ref_len), 0) ThenBlock: {
                                    JSValidWalk.result = 1
                                }
                            }
                        }
                    }

                    // Push children for further traversal
                    IfCondition EqualTo(JSValidWalk.result, 0) ThenBlock: {
                        JSValidWalk__PushChildren(JSValidWalk.cur)
                    }
                }
            }
        }

        JSValidWalk.sp = 0
        ReturnValue(JSValidWalk.result)
    }
}
