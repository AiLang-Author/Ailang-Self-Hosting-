// Library.URL.ailang — URL parser for the Ailang browser engine
// Parses: scheme://[user:pass@]host[:port]/path[?query][#fragment]
// Pool-based: 32 URL slots, zero-copy pointers into interned string table.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils

// ---- Integer to decimal string ----
Function.IntToString {
    Input: val: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: {
            z = Allocate(2)
            SetByte(z, 0, 48)
            SetByte(z, 1, 0)
            ReturnValue(z)
        }
        // Write digits in reverse, then flip
        tmp = Allocate(21)
        ti = 0
        n = val
        IfCondition LessThan(n, 0) ThenBlock: { n = Subtract(0, n) }
        WhileLoop GreaterThan(n, 0) {
            digit = Subtract(n, Multiply(Divide(n, 10), 10))
            SetByte(tmp, ti, Add(48, digit))
            ti = Add(ti, 1)
            n = Divide(n, 10)
        }
        IfCondition LessThan(val, 0) ThenBlock: {
            SetByte(tmp, ti, 45)
            ti = Add(ti, 1)
        }
        buf = Allocate(Add(ti, 1))
        j = 0
        WhileLoop LessThan(j, ti) {
            SetByte(buf, j, GetByte(tmp, Subtract(Subtract(ti, 1), j)))
            j = Add(j, 1)
        }
        SetByte(buf, ti, 0)
        ReturnValue(buf)
    }
}

// URL pool: 32 slots x 7 fields x 8 bytes = 1792 bytes
// Fields per slot: scheme_ptr, host_ptr, port, path_ptr, query_ptr, fragment_ptr, valid
FixedPool.URLConst {
    "MAX_SLOTS":    Initialize=128
    "SLOT_SIZE":    Initialize=56
    "F_SCHEME":     Initialize=0
    "F_HOST":       Initialize=8
    "F_PORT":       Initialize=16
    "F_PATH":       Initialize=24
    "F_QUERY":      Initialize=32
    "F_FRAGMENT":   Initialize=40
    "F_VALID":      Initialize=48
}

// ---- State: pool base + next free slot ----
FixedPool.URLState {
    "pool":     Initialize=0
    "next":     Initialize=0
}

// ---- Init ----
Function.URL_Init {
    Output: Integer
    Body: {
        total = Multiply(URLConst.MAX_SLOTS, URLConst.SLOT_SIZE)
        URLState.pool = Allocate(total)
        MemorySet(URLState.pool, 0, total)
        URLState.next = 0
        ReturnValue(0)
    }
}

// ---- Internal: get slot base address ----
Function.URL__SlotAddr {
    Input: h: Integer
    Output: Address
    Body: {
        ReturnValue(Add(URLState.pool, Multiply(h, URLConst.SLOT_SIZE)))
    }
}

// ---- Internal: copy substring [start..end) from src into new Arena string ----
Function.URL__CopyRange {
    Input: src: Address
    Input: start: Integer
    Input: end: Integer
    Output: Address
    Body: {
        len = Subtract(end, start)
        IfCondition LessEqual(len, 0) ThenBlock: {
            empty = Allocate(1)
            SetByte(empty, 0, 0)
            ReturnValue(empty)
        }
        buf = Allocate(Add(len, 1))
        MemoryCopy(buf, Add(src, start), len)
        SetByte(buf, len, 0)
        ReturnValue(buf)
    }
}

// ---- Parse URL string into pool slot, return handle (0..31) or -1 ----
Function.URL_Parse {
    Input: str: Address
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(URLState.next, URLConst.MAX_SLOTS) ThenBlock: {
            PrintMessage("[URL] pool full\n")
            ReturnValue(-1)
        }
        h = URLState.next
        URLState.next = Add(URLState.next, 1)
        base = URL__SlotAddr(h)

        pos = 0

        // ---- Scheme: scan for "://" ----
        scheme_end = -1
        si = 0
        WhileLoop LessThan(si, len) {
            ch = GetByte(str, si)
            IfCondition EqualTo(ch, 58) ThenBlock: {
                // ':' — check for "//"
                n1 = Add(si, 1)
                n2 = Add(si, 2)
                IfCondition LessThan(n2, len) ThenBlock: {
                    c1 = GetByte(str, n1)
                    c2 = GetByte(str, n2)
                    IfCondition And(EqualTo(c1, 47), EqualTo(c2, 47)) ThenBlock: {
                        scheme_end = si
                        si = len
                    }
                }
            }
            si = Add(si, 1)
        }

        IfCondition GreaterThan(scheme_end, 0) ThenBlock: {
            sptr = URL__CopyRange(str, 0, scheme_end)
            StoreValue(Add(base, URLConst.F_SCHEME), sptr)
            pos = Add(scheme_end, 3)
        } ElseBlock: {
            // Default scheme "http"
            def = Allocate(5)
            SetByte(def, 0, 104)
            SetByte(def, 1, 116)
            SetByte(def, 2, 116)
            SetByte(def, 3, 112)
            SetByte(def, 4, 0)
            StoreValue(Add(base, URLConst.F_SCHEME), def)
        }

        // ---- Authority: host[:port] — scan until '/' or '?' or '#' or end ----
        auth_start = pos
        auth_end = len
        ai = pos
        WhileLoop LessThan(ai, len) {
            ch = GetByte(str, ai)
            is_term = Or(Or(EqualTo(ch, 47), EqualTo(ch, 63)), EqualTo(ch, 35))
            IfCondition EqualTo(is_term, 1) ThenBlock: {
                auth_end = ai
                ai = len
            }
            ai = Add(ai, 1)
        }

        // Split authority on ':' for port
        colon_pos = -1
        ci = auth_start
        WhileLoop LessThan(ci, auth_end) {
            ch = GetByte(str, ci)
            IfCondition EqualTo(ch, 58) ThenBlock: {
                colon_pos = ci
            }
            ci = Add(ci, 1)
        }

        IfCondition GreaterThan(colon_pos, 0) ThenBlock: {
            hptr = URL__CopyRange(str, auth_start, colon_pos)
            StoreValue(Add(base, URLConst.F_HOST), hptr)
            // Parse port number
            port_str = URL__CopyRange(str, Add(colon_pos, 1), auth_end)
            port_num = StringToInt(port_str)
            StoreValue(Add(base, URLConst.F_PORT), port_num)
        } ElseBlock: {
            hptr = URL__CopyRange(str, auth_start, auth_end)
            StoreValue(Add(base, URLConst.F_HOST), hptr)
            // Default port based on scheme
            sc = Dereference(Add(base, URLConst.F_SCHEME))
            sc0 = GetByte(sc, 0)
            IfCondition EqualTo(sc0, 104) ThenBlock: {
                // 'h' — check https vs http
                sc4 = GetByte(sc, 4)
                IfCondition EqualTo(sc4, 115) ThenBlock: {
                    StoreValue(Add(base, URLConst.F_PORT), 443)
                } ElseBlock: {
                    StoreValue(Add(base, URLConst.F_PORT), 80)
                }
            } ElseBlock: {
                StoreValue(Add(base, URLConst.F_PORT), 80)
            }
        }

        pos = auth_end

        // ---- Path: from current pos to '?' or '#' or end ----
        path_start = pos
        path_end = len
        pi = pos
        WhileLoop LessThan(pi, len) {
            ch = GetByte(str, pi)
            IfCondition Or(EqualTo(ch, 63), EqualTo(ch, 35)) ThenBlock: {
                path_end = pi
                pi = len
            }
            pi = Add(pi, 1)
        }

        IfCondition GreaterEqual(path_start, path_end) ThenBlock: {
            // No path — default to "/"
            slash = Allocate(2)
            SetByte(slash, 0, 47)
            SetByte(slash, 1, 0)
            StoreValue(Add(base, URLConst.F_PATH), slash)
        } ElseBlock: {
            pptr = URL__CopyRange(str, path_start, path_end)
            StoreValue(Add(base, URLConst.F_PATH), pptr)
        }
        pos = path_end

        // ---- Query: after '?' until '#' or end ----
        IfCondition LessThan(pos, len) ThenBlock: {
            qch = GetByte(str, pos)
            IfCondition EqualTo(qch, 63) ThenBlock: {
                pos = Add(pos, 1)
                q_start = pos
                q_end = len
                qi = pos
                WhileLoop LessThan(qi, len) {
                    ch = GetByte(str, qi)
                    IfCondition EqualTo(ch, 35) ThenBlock: {
                        q_end = qi
                        qi = len
                    }
                    qi = Add(qi, 1)
                }
                qptr = URL__CopyRange(str, q_start, q_end)
                StoreValue(Add(base, URLConst.F_QUERY), qptr)
                pos = q_end
            }
        }

        // ---- Fragment: after '#' to end ----
        IfCondition LessThan(pos, len) ThenBlock: {
            fch = GetByte(str, pos)
            IfCondition EqualTo(fch, 35) ThenBlock: {
                pos = Add(pos, 1)
                fptr = URL__CopyRange(str, pos, len)
                StoreValue(Add(base, URLConst.F_FRAGMENT), fptr)
            }
        }

        StoreValue(Add(base, URLConst.F_VALID), 1)
        ReturnValue(h)
    }
}

// ---- Accessors ----
Function.URL_GetScheme {
    Input: h: Integer
    Output: Address
    Body: {
        base = URL__SlotAddr(h)
        ReturnValue(Dereference(Add(base, URLConst.F_SCHEME)))
    }
}

Function.URL_GetHost {
    Input: h: Integer
    Output: Address
    Body: {
        base = URL__SlotAddr(h)
        ReturnValue(Dereference(Add(base, URLConst.F_HOST)))
    }
}

Function.URL_GetPort {
    Input: h: Integer
    Output: Integer
    Body: {
        base = URL__SlotAddr(h)
        ReturnValue(Dereference(Add(base, URLConst.F_PORT)))
    }
}

Function.URL_GetPath {
    Input: h: Integer
    Output: Address
    Body: {
        base = URL__SlotAddr(h)
        ReturnValue(Dereference(Add(base, URLConst.F_PATH)))
    }
}

Function.URL_GetQuery {
    Input: h: Integer
    Output: Address
    Body: {
        base = URL__SlotAddr(h)
        ReturnValue(Dereference(Add(base, URLConst.F_QUERY)))
    }
}

Function.URL_GetFragment {
    Input: h: Integer
    Output: Address
    Body: {
        base = URL__SlotAddr(h)
        ReturnValue(Dereference(Add(base, URLConst.F_FRAGMENT)))
    }
}

Function.URL_IsHTTPS {
    Input: h: Integer
    Output: Integer
    Body: {
        sc = URL_GetScheme(h)
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(0) }
        c4 = GetByte(sc, 4)
        IfCondition EqualTo(c4, 115) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// ---- Reset pool for reuse ----
Function.URL_Reset {
    Output: Integer
    Body: {
        total = Multiply(URLConst.MAX_SLOTS, URLConst.SLOT_SIZE)
        MemorySet(URLState.pool, 0, total)
        URLState.next = 0
        ReturnValue(0)
    }
}

// ---- Percent-decode in-place: %XX -> byte. Returns new string. ----
Function.URL_PercentDecode {
    Input: str: Address
    Input: len: Integer
    Output: Address
    Body: {
        buf = Allocate(Add(len, 1))
        si = 0
        di = 0
        WhileLoop LessThan(si, len) {
            ch = GetByte(str, si)
            IfCondition EqualTo(ch, 37) ThenBlock: {
                // '%' — read 2 hex digits
                n1 = Add(si, 1)
                n2 = Add(si, 2)
                IfCondition LessThan(n2, len) ThenBlock: {
                    h1 = URL__HexVal(GetByte(str, n1))
                    h2 = URL__HexVal(GetByte(str, n2))
                    IfCondition And(GreaterEqual(h1, 0), GreaterEqual(h2, 0)) ThenBlock: {
                        decoded = Add(Multiply(h1, 16), h2)
                        SetByte(buf, di, decoded)
                        di = Add(di, 1)
                        si = Add(si, 3)
                    } ElseBlock: {
                        SetByte(buf, di, ch)
                        di = Add(di, 1)
                        si = Add(si, 1)
                    }
                } ElseBlock: {
                    SetByte(buf, di, ch)
                    di = Add(di, 1)
                    si = Add(si, 1)
                }
            } ElseBlock: {
                IfCondition EqualTo(ch, 43) ThenBlock: {
                    // '+' -> space in query strings
                    SetByte(buf, di, 32)
                } ElseBlock: {
                    SetByte(buf, di, ch)
                }
                di = Add(di, 1)
                si = Add(si, 1)
            }
        }
        SetByte(buf, di, 0)
        ReturnValue(buf)
    }
}

// ---- Internal: hex char -> 0-15 or -1 ----
Function.URL__HexVal {
    Input: ch: Integer
    Output: Integer
    Body: {
        // '0'-'9' = 48-57
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
            ReturnValue(Subtract(ch, 48))
        }
        // 'a'-'f' = 97-102
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: {
            ReturnValue(Subtract(ch, 87))
        }
        // 'A'-'F' = 65-70
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: {
            ReturnValue(Subtract(ch, 55))
        }
        ReturnValue(-1)
    }
}

// ---- Build full URL string from handle ----
Function.URL_ToString {
    Input: h: Integer
    Output: Address
    Body: {
        sc = URL_GetScheme(h)
        host = URL_GetHost(h)
        port = URL_GetPort(h)
        path = URL_GetPath(h)
        query = URL_GetQuery(h)
        frag = URL_GetFragment(h)

        // scheme://host[:port]path[?query][#fragment]
        buf = Allocate(2048)
        pos = 0

        // scheme
        sl = StringLength(sc)
        MemoryCopy(Add(buf, pos), sc, sl)
        pos = Add(pos, sl)
        // "://"
        SetByte(buf, pos, 58)
        SetByte(buf, Add(pos, 1), 47)
        SetByte(buf, Add(pos, 2), 47)
        pos = Add(pos, 3)

        // host
        hl = StringLength(host)
        MemoryCopy(Add(buf, pos), host, hl)
        pos = Add(pos, hl)

        // :port (only if non-default)
        is_default = 0
        IfCondition And(EqualTo(port, 80), EqualTo(URL_IsHTTPS(h), 0)) ThenBlock: {
            is_default = 1
        }
        IfCondition And(EqualTo(port, 443), EqualTo(URL_IsHTTPS(h), 1)) ThenBlock: {
            is_default = 1
        }
        IfCondition EqualTo(is_default, 0) ThenBlock: {
            SetByte(buf, pos, 58)
            pos = Add(pos, 1)
            pstr = IntToString(port)
            psl = StringLength(pstr)
            MemoryCopy(Add(buf, pos), pstr, psl)
            pos = Add(pos, psl)
        }

        // path
        pl = StringLength(path)
        MemoryCopy(Add(buf, pos), path, pl)
        pos = Add(pos, pl)

        // ?query
        IfCondition NotEqual(query, 0) ThenBlock: {
            ql = StringLength(query)
            IfCondition GreaterThan(ql, 0) ThenBlock: {
                SetByte(buf, pos, 63)
                pos = Add(pos, 1)
                MemoryCopy(Add(buf, pos), query, ql)
                pos = Add(pos, ql)
            }
        }

        // #fragment
        IfCondition NotEqual(frag, 0) ThenBlock: {
            fl = StringLength(frag)
            IfCondition GreaterThan(fl, 0) ThenBlock: {
                SetByte(buf, pos, 35)
                pos = Add(pos, 1)
                MemoryCopy(Add(buf, pos), frag, fl)
                pos = Add(pos, fl)
            }
        }

        SetByte(buf, pos, 0)
        ReturnValue(buf)
    }
}
