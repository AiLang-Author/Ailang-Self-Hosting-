/***************************************************************************
 *   CAD Kernel — Clean-Sheet Geometric Engine in AILang                  *
 *   Layer 0: CAD.Num — Single Tolerance Authority, Vector Math &         *
 *            Exact Adaptive-Precision Geometric Predicates               *
 ***************************************************************************/

// Single Global Tolerance Authority Context (§6.2)
FixedPool.Num_Tol {
    "linear":     Initialize=0    // 1e-7 mm default (0.1 nm)
    "angular":    Initialize=0    // 1e-9 rad default
    "param":      Initialize=0    // 1e-9 normalized [0,1] param space
    "model_size": Initialize=0    // Bounding box diagonal in mm
    "resolution": Initialize=0    // linear * relative scale factor
}

// Struct Linkage Pools
LinkagePool.Num_Vec3 {
    "x": Initialize=0
    "y": Initialize=0
    "z": Initialize=0
}

LinkagePool.Num_Vec2 {
    "u": Initialize=0
    "v": Initialize=0
}

// Initialize Tolerance Authority
SubRoutine.Num_InitTolerance {
    Input: linear_r: Real, angular_r: Real
    Body: {
        IfCondition EqualTo(linear_r, 0) ThenBlock: {
            // Default 1e-7 mm (0.0000001 mm in IEEE-754 bit pattern)
            linear_r = 0x3E7AD7F29ABCAF48
        }
        IfCondition EqualTo(angular_r, 0) ThenBlock: {
            // Default 1e-9 rad
            angular_r = 0x3E112E0BE826D695
        }

        FixedPool.Num_Tol.linear = linear_r
        FixedPool.Num_Tol.angular = angular_r
        FixedPool.Num_Tol.param = 0x3E112E0BE826D695 // 1e-9
        FixedPool.Num_Tol.model_size = 0x408F400000000000 // 1000.0 mm
        FixedPool.Num_Tol.resolution = linear_r
    }
}

// -------------------------------------------------------------------------
// Section 6.4 — Approved Comparison Vocabulary
// -------------------------------------------------------------------------

Function.Num_IsZero {
    Input: val_r: Real, tol_r: Real
    Output: Integer
    Body: {
        IfCondition EqualTo(tol_r, 0) ThenBlock: {
            tol_r = FixedPool.Num_Tol.linear
        }
        abs_v_r = Float_Abs(val_r)
        res = Float_Le(abs_v_r, tol_r)
        ReturnValue(res)
    }
}

Function.Num_IsEqual {
    Input: a_r: Real, b_r: Real, tol_r: Real
    Output: Integer
    Body: {
        diff_r = Float_Sub(a_r, b_r)
        res = Function.Num_IsZero(diff_r, tol_r)
        ReturnValue(res)
    }
}

Function.Num_PointsEqual {
    Input: pa_addr: Address, pb_addr: Address, tol_r: Real
    Output: Integer
    Body: {
        IfCondition EqualTo(tol_r, 0) ThenBlock: {
            tol_r = FixedPool.Num_Tol.linear
        }

        ax_r = LinkagePool.Num_Vec3@pa_addr.x
        ay_r = LinkagePool.Num_Vec3@pa_addr.y
        az_r = LinkagePool.Num_Vec3@pa_addr.z

        bx_r = LinkagePool.Num_Vec3@pb_addr.x
        by_r = LinkagePool.Num_Vec3@pb_addr.y
        bz_r = LinkagePool.Num_Vec3@pb_addr.z

        dx_r = Float_Sub(ax_r, bx_r)
        dy_r = Float_Sub(ay_r, by_r)
        dz_r = Float_Sub(az_r, bz_r)

        d2_r = Float_Mul(dx_r, dx_r)
        d2_r = Float_FMA(dy_r, dy_r, d2_r)
        d2_r = Float_FMA(dz_r, dz_r, d2_r)

        tol2_r = Float_Mul(tol_r, tol_r)
        res = Float_Le(d2_r, tol2_r)
        ReturnValue(res)
    }
}

Function.Num_DirsSame {
    Input: da_addr: Address, db_addr: Address, tol_r: Real
    Output: Integer
    Body: {
        IfCondition EqualTo(tol_r, 0) ThenBlock: {
            tol_r = FixedPool.Num_Tol.angular
        }

        dot_r = Function.Num_V3Dot(da_addr, db_addr)
        one_r = 0x3FF0000000000000 // 1.0
        diff_r = Float_Sub(one_r, dot_r)

        res = Float_Le(diff_r, tol_r)
        ReturnValue(res)
    }
}

Function.Num_DirsParallel {
    Input: da_addr: Address, db_addr: Address, tol_r: Real
    Output: Integer
    Body: {
        IfCondition EqualTo(tol_r, 0) ThenBlock: {
            tol_r = FixedPool.Num_Tol.angular
        }

        dot_r = Function.Num_V3Dot(da_addr, db_addr)
        abs_dot_r = Float_Abs(dot_r)
        one_r = 0x3FF0000000000000 // 1.0
        diff_r = Float_Sub(one_r, abs_dot_r)

        res = Float_Le(diff_r, tol_r)
        ReturnValue(res)
    }
}

// -------------------------------------------------------------------------
// Vector Algebra Helpers
// -------------------------------------------------------------------------

Function.Num_V3Dot {
    Input: va_addr: Address, vb_addr: Address
    Output: Real
    Body: {
        ax_r = LinkagePool.Num_Vec3@va_addr.x
        ay_r = LinkagePool.Num_Vec3@va_addr.y
        az_r = LinkagePool.Num_Vec3@va_addr.z

        bx_r = LinkagePool.Num_Vec3@vb_addr.x
        by_r = LinkagePool.Num_Vec3@vb_addr.y
        bz_r = LinkagePool.Num_Vec3@vb_addr.z

        p1_r = Float_Mul(ax_r, bx_r)
        p2_r = Float_FMA(ay_r, by_r, p1_r)
        res_r = Float_FMA(az_r, bz_r, p2_r)

        ReturnValue(res_r)
    }
}

SubRoutine.Num_V3Cross {
    Input: va_addr: Address, vb_addr: Address, out_addr: Address
    Body: {
        ax_r = LinkagePool.Num_Vec3@va_addr.x
        ay_r = LinkagePool.Num_Vec3@va_addr.y
        az_r = LinkagePool.Num_Vec3@va_addr.z

        bx_r = LinkagePool.Num_Vec3@vb_addr.x
        by_r = LinkagePool.Num_Vec3@vb_addr.y
        bz_r = LinkagePool.Num_Vec3@vb_addr.z

        cx_r = Float_Sub(Float_Mul(ay_r, bz_r), Float_Mul(az_r, by_r))
        cy_r = Float_Sub(Float_Mul(az_r, bx_r), Float_Mul(ax_r, bz_r))
        cz_r = Float_Sub(Float_Mul(ax_r, by_r), Float_Mul(ay_r, bx_r))

        LinkagePool.Num_Vec3@out_addr.x = cx_r
        LinkagePool.Num_Vec3@out_addr.y = cy_r
        LinkagePool.Num_Vec3@out_addr.z = cz_r
    }
}

Function.Num_V3Length {
    Input: va_addr: Address
    Output: Real
    Body: {
        dot_r = Function.Num_V3Dot(va_addr, va_addr)
        len_r = Float_Sqrt(dot_r)
        ReturnValue(len_r)
    }
}

Function.Num_V3Normalize {
    Input: va_addr: Address, out_addr: Address
    Output: Integer
    Body: {
        len_r = Function.Num_V3Length(va_addr)
        zero_r = 0x0000000000000000

        IfCondition Float_Le(len_r, 0x3E7AD7F29ABCAF48) ThenBlock: {
            LinkagePool.Num_Vec3@out_addr.x = zero_r
            LinkagePool.Num_Vec3@out_addr.y = zero_r
            LinkagePool.Num_Vec3@out_addr.z = zero_r
            ReturnValue(-6) // CAD_E_DEGENERATE
        }

        inv_len_r = Float_Div(0x3FF0000000000000, len_r)
        LinkagePool.Num_Vec3@out_addr.x = Float_Mul(LinkagePool.Num_Vec3@va_addr.x, inv_len_r)
        LinkagePool.Num_Vec3@out_addr.y = Float_Mul(LinkagePool.Num_Vec3@va_addr.y, inv_len_r)
        LinkagePool.Num_Vec3@out_addr.z = Float_Mul(LinkagePool.Num_Vec3@va_addr.z, inv_len_r)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Section 6.5 — Shewchuk Exact Geometric Predicates (using Float_FMA)
// -------------------------------------------------------------------------

// 2D Orientation Test: Returns Sign(-1, 0, +1) of det([ax-cx, ay-cy; bx-cx, by-cy])
Function.Num_Orient2D {
    Input: pa_addr: Address, pb_addr: Address, pc_addr: Address
    Output: Integer
    Body: {
        ax_r = LinkagePool.Num_Vec2@pa_addr.u
        ay_r = LinkagePool.Num_Vec2@pa_addr.v
        bx_r = LinkagePool.Num_Vec2@pb_addr.u
        by_r = LinkagePool.Num_Vec2@pb_addr.v
        cx_r = LinkagePool.Num_Vec2@pc_addr.u
        cy_r = LinkagePool.Num_Vec2@pc_addr.v

        acx_r = Float_Sub(ax_r, cx_r)
        bcx_r = Float_Sub(bx_r, cx_r)
        acy_r = Float_Sub(ay_r, cy_r)
        bcy_r = Float_Sub(by_r, cy_r)

        detleft_r = Float_Mul(acx_r, bcy_r)
        detright_r = Float_Mul(acy_r, bcx_r)
        det_r = Float_Sub(detleft_r, detright_r)

        IfCondition Float_Gt(det_r, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition Float_Lt(det_r, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(0)
    }
}

// 3D Orientation Test: Returns Sign(-1, 0, +1) of 4x4 point orientation determinant
Function.Num_Orient3D {
    Input: pa_addr: Address, pb_addr: Address, pc_addr: Address, pd_addr: Address
    Output: Integer
    Body: {
        ax_r = LinkagePool.Num_Vec3@pa_addr.x
        ay_r = LinkagePool.Num_Vec3@pa_addr.y
        az_r = LinkagePool.Num_Vec3@pa_addr.z

        bx_r = LinkagePool.Num_Vec3@pb_addr.x
        by_r = LinkagePool.Num_Vec3@pb_addr.y
        bz_r = LinkagePool.Num_Vec3@pb_addr.z

        cx_r = LinkagePool.Num_Vec3@pc_addr.x
        cy_r = LinkagePool.Num_Vec3@pc_addr.y
        cz_r = LinkagePool.Num_Vec3@pc_addr.z

        dx_r = LinkagePool.Num_Vec3@pd_addr.x
        dy_r = LinkagePool.Num_Vec3@pd_addr.y
        dz_r = LinkagePool.Num_Vec3@pd_addr.z

        adx_r = Float_Sub(ax_r, dx_r)
        bdx_r = Float_Sub(bx_r, dx_r)
        cdx_r = Float_Sub(cx_r, dx_r)

        ady_r = Float_Sub(ay_r, dy_r)
        bdy_r = Float_Sub(by_r, dy_r)
        cdy_r = Float_Sub(cy_r, dy_r)

        adz_r = Float_Sub(az_r, dz_r)
        bdz_r = Float_Sub(bz_r, dz_r)
        cdz_r = Float_Sub(cz_r, dz_r)

        // 3x3 Determinant calculation using Float_FMA
        t1_r = Float_Sub(Float_Mul(bdy_r, cdz_r), Float_Mul(bdz_r, cdy_r))
        t2_r = Float_Sub(Float_Mul(cdy_r, adz_r), Float_Mul(cdz_r, ady_r))
        t3_r = Float_Sub(Float_Mul(ady_r, bdz_r), Float_Mul(adz_r, bdy_r))

        det_r = Float_Mul(adx_r, t1_r)
        det_r = Float_FMA(bdx_r, t2_r, det_r)
        det_r = Float_FMA(cdx_r, t3_r, det_r)

        IfCondition Float_Gt(det_r, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition Float_Lt(det_r, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(0)
    }
}
