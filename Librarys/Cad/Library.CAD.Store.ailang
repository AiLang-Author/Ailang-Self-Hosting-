// SPDX-License-Identifier: LGPL-2.1-or-later
/***************************************************************************
 *   CAD Kernel — Clean-Sheet Geometric Engine in AILang                  *
 *   Layer 0: CAD.Store — Fixed-Stride Slab Allocator & 64-bit Tagged     *
 *            Generation Handle Tables (§4.2)                             *
 ***************************************************************************/

FixedPool.CAD_Store_State {
    "initialized":      Initialize=0
    "topo_slab_base":   Initialize=0
    "geom_slab_base":   Initialize=0
    "sketch_slab_base": Initialize=0
    "feat_slab_base":   Initialize=0
    "tess_slab_base":   Initialize=0
    
    "next_index":       Initialize=1
    "allocated_count":  Initialize=0
}

// Bit manipulation constants for 64-bit Handle packing:
// bit 63..56 : Type tag (8 bits)
// bit 55..40 : Generation (16 bits)
// bit 39..0  : Slab index (40 bits)

// -------------------------------------------------------------------------
// Handle Encoding and Decoding
// -------------------------------------------------------------------------

Function.Store_MakeHandle {
    Input: tag: Integer, gen: Integer, index: Integer
    Output: Integer
    Body: {
        // Shift tag 56 bits
        tag_shifted = ShiftLeft(BitwiseAnd(tag, 0xFF), 56)
        // Shift generation 40 bits
        gen_shifted = ShiftLeft(BitwiseAnd(gen, 0xFFFF), 40)
        // Index 40 bits mask
        idx_masked = BitwiseAnd(index, 0xFFFFFFFFFF)

        h1 = BitwiseOr(tag_shifted, gen_shifted)
        handle = BitwiseOr(h1, idx_masked)
        ReturnValue(handle)
    }
}

Function.Store_Tag {
    Input: handle: Integer
    Output: Integer
    Body: {
        tag = BitwiseAnd(ShiftRight(handle, 56), 0xFF)
        ReturnValue(tag)
    }
}

Function.Store_Gen {
    Input: handle: Integer
    Output: Integer
    Body: {
        gen = BitwiseAnd(ShiftRight(handle, 40), 0xFFFF)
        ReturnValue(gen)
    }
}

Function.Store_Index {
    Input: handle: Integer
    Output: Integer
    Body: {
        idx = BitwiseAnd(handle, 0xFFFFFFFFFF)
        ReturnValue(idx)
    }
}

Function.Store_IsLive {
    Input: handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: {
            ReturnValue(0)
        }

        idx = Function.Store_Index(handle)
        IfCondition LessThanOrEqual(idx, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Live validity check against slab generation tables
        ReturnValue(1)
    }
}

// -------------------------------------------------------------------------
// Slab Allocation Operations
// -------------------------------------------------------------------------

SubRoutine.Store_Init {
    Input: dummy: Integer
    Body: {
        IfCondition NotEqual(FixedPool.CAD_Store_State.initialized, 0) ThenBlock: {
            ReturnVoid()
        }

        // Pre-allocate fixed-stride entity memory slabs (1,000,000 slots each)
        FixedPool.CAD_Store_State.topo_slab_base   = Allocate(8000000) // 1M words
        FixedPool.CAD_Store_State.geom_slab_base   = Allocate(8000000)
        FixedPool.CAD_Store_State.sketch_slab_base = Allocate(4000000)
        FixedPool.CAD_Store_State.feat_slab_base   = Allocate(4000000)
        FixedPool.CAD_Store_State.tess_slab_base   = Allocate(8000000)

        FixedPool.CAD_Store_State.next_index = 1
        FixedPool.CAD_Store_State.allocated_count = 0
        FixedPool.CAD_Store_State.initialized = 1
    }
}

Function.Store_Alloc {
    Input: tag: Integer, stride_words: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(FixedPool.CAD_Store_State.initialized, 0) ThenBlock: {
            SubRoutine.Store_Init(0)
        }

        idx = FixedPool.CAD_Store_State.next_index
        FixedPool.CAD_Store_State.next_index = Add(idx, 1)
        FixedPool.CAD_Store_State.allocated_count = Add(FixedPool.CAD_Store_State.allocated_count, 1)

        gen = 1
        handle = Function.Store_MakeHandle(tag, gen, idx)
        ReturnValue(handle)
    }
}

Function.Store_Free {
    Input: handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Function.Store_IsLive(handle), 0) ThenBlock: {
            ReturnValue(-3) // CAD_E_STALE
        }

        FixedPool.CAD_Store_State.allocated_count = Subtract(FixedPool.CAD_Store_State.allocated_count, 1)
        ReturnValue(0)
    }
}
