/***************************************************************************
 *   CAD Kernel — Clean-Sheet Geometric Engine in AILang                  *
 *   Layer 0: CAD.Sys — Low-Level Syscalls & Raw File I/O Primitives      *
 ***************************************************************************/

FixedPool.CAD_Sys_State {
    "last_syscall_ret": Initialize=0
}

// Open file (flags: 0=O_RDONLY, 1=O_WRONLY, 2=O_RDWR, 0x40=O_CREAT, 0x200=O_TRUNC)
Function.Sys_Open {
    Input: filename_addr: Address, flags: Integer, mode: Integer
    Output: Integer
    Body: {
        // Linux x86-64 syscall 2: sys_open
        fd = SysCall3(2, filename_addr, flags, mode)
        FixedPool.CAD_Sys_State.last_syscall_ret = fd
        ReturnValue(fd)
    }
}

// Read raw bytes into buffer
Function.Sys_Read {
    Input: fd: Integer, buf_addr: Address, count: Integer
    Output: Integer
    Body: {
        // Linux x86-64 syscall 0: sys_read
        bytes_read = SysCall3(0, fd, buf_addr, count)
        FixedPool.CAD_Sys_State.last_syscall_ret = bytes_read
        ReturnValue(bytes_read)
    }
}

// Write raw bytes from buffer
Function.Sys_Write {
    Input: fd: Integer, buf_addr: Address, count: Integer
    Output: Integer
    Body: {
        // Linux x86-64 syscall 1: sys_write
        bytes_written = SysCall3(1, fd, buf_addr, count)
        FixedPool.CAD_Sys_State.last_syscall_ret = bytes_written
        ReturnValue(bytes_written)
    }
}

// Close file descriptor
Function.Sys_Close {
    Input: fd: Integer
    Output: Integer
    Body: {
        // Linux x86-64 syscall 3: sys_close
        ret = SysCall1(3, fd)
        FixedPool.CAD_Sys_State.last_syscall_ret = ret
        ReturnValue(ret)
    }
}

// Get file size in bytes
Function.Sys_GetFileSize {
    Input: filename_addr: Address
    Output: Integer
    Body: {
        fd = Function.Sys_Open(filename_addr, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-1)
        }
        
        // Seek to end (syscall 8: sys_lseek, SEEK_END=2)
        size = SysCall3(8, fd, 0, 2)
        Function.Sys_Close(fd)
        ReturnValue(size)
    }
}

// Read entire file content into allocated buffer
Function.Sys_ReadEntireFile {
    Input: filename_addr: Address, dest_buf: Address, max_bytes: Integer
    Output: Integer
    Body: {
        fd = Function.Sys_Open(filename_addr, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-1)
        }

        bytes_read = Function.Sys_Read(fd, dest_buf, max_bytes)
        Function.Sys_Close(fd)
        ReturnValue(bytes_read)
    }
}

// Get monotonic timestamp (nanoseconds)
Function.Sys_GetTimeNano {
    Input: dummy: Integer
    Output: Integer
    Body: {
        // Linux x86-64 syscall 228: sys_clock_gettime (CLOCK_MONOTONIC=1)
        // Timespec struct is 16 bytes (sec: int64, nsec: int64)
        ts_buf = Allocate(16)
        ret = SysCall2(228, 1, ts_buf)
        
        IfCondition LessThan(ret, 0) ThenBlock: {
            Deallocate(ts_buf, 16)
            ReturnValue(0)
        }
        
        sec = ArrayGet(ts_buf, 0)
        nsec = ArrayGet(ts_buf, 1)
        Deallocate(ts_buf, 16)
        
        // Return nanoseconds total: (sec * 1,000,000,000) + nsec
        total = Add(Multiply(sec, 1000000000), nsec)
        ReturnValue(total)
    }
}
