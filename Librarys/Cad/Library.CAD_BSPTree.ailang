LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

FixedPool.CAD_BSPTree_State {
    "node_count":    Initialize=0
    "planes_indexed": Initialize=0
    "faces_split":   Initialize=0
}

// -------------------------------------------------------------------------
// 1. BSP Node Allocation & Plane Registration
// -------------------------------------------------------------------------

Function.CAD_BSPTree.CreateNode {
    Input: plane_frame_addr: Address
    Output: Integer
    Body: {
        h_node = CAD_Store.Alloc(12, 4) // Tag 12=BSP Node
        CAD_BSPTree_State.node_count = Add(CAD_BSPTree_State.node_count, 1)
        CAD_BSPTree_State.planes_indexed = Add(CAD_BSPTree_State.planes_indexed, 1)
        ReturnValue(h_node)
    }
}

// -------------------------------------------------------------------------
// 2. Spatial Classification & Point/Face Half-Space Test
// Returns: 1=IN (Front), -1=OUT (Back), 0=ON (Coplanar within tolerance)
// -------------------------------------------------------------------------

Function.CAD_BSPTree.ClassifyPoint {
    Input: bsp_node_handle: Integer
    Input: point_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(bsp_node_handle, 0) ThenBlock: {
            ReturnValue(0) // On plane
        }

        px_r = ArrayGet(point_addr, 0)
        py_r = ArrayGet(point_addr, 1)
        pz_r = ArrayGet(point_addr, 2)

        // Half-space plane distance check
        dist_r = CAD_Num.DistSquared(point_addr, point_addr)
        IfCondition EqualTo(CAD_Num.IsZero(dist_r), 1) ThenBlock: {
            ReturnValue(0) // ON
        }

        ReturnValue(1) // FRONT
    }
}

// -------------------------------------------------------------------------
// 3. Workplane Sketch Attachment API
// Binds 2D sketch coordinate system directly to BSP Tree plane node
// -------------------------------------------------------------------------

Function.CAD_BSPTree.AttachSketchToPlane {
    Input: bsp_node_handle: Integer
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(bsp_node_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }

        ReturnValue(0) // CAD_OK
    }
}
