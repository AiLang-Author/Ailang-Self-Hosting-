// CAD Kernel — CAD.BSpline — de Boor curve evaluation
// SysV ABI: max 6 register args — keep all public APIs at ≤5 Inputs.
//
// Curve descriptor (words at curve_addr):
//   [0] degree
//   [1] n_ctrl
//   [2] ctrl_pts_addr
//   [3] knot_vec_addr
// Ctrl pts: xyz triples (index i → words 3*i..3*i+2)
// Knots: length n_ctrl+degree+1
//
// Surface descriptor (words at surf_addr):
//   [0] deg_u  [1] deg_v
//   [2] n_u    [3] n_v   (ctrl counts)
//   [4] ctrl_net_addr
//   [5] weights_addr (0 = non-rational)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Num

FixedPool.CAD_BSpline_State {
    "curve_evals":   Initialize=0
    "surface_evals": Initialize=0
}

// Find span: knots[i] <= u < knots[i+1]
Function.CAD_BSpline.FindSpan {
    Input: n_ctrl: Integer
    Input: degree: Integer
    Input: u_r: Integer
    Input: knot_vec_addr: Address
    Output: Integer
    Body: {
        n = Subtract(n_ctrl, 1)
        p = degree
        u_max = ArrayGet(knot_vec_addr, Add(Add(n, p), 1))
        at_end = Float_Le(u_max, u_r)
        IfCondition EqualTo(at_end, 1) ThenBlock: {
            ReturnValue(n)
        }

        i = p
        found = Subtract(0, 1)
        WhileLoop LessEqual(i, n) {
            ui = ArrayGet(knot_vec_addr, i)
            ui1 = ArrayGet(knot_vec_addr, Add(i, 1))
            c_lo = Float_Le(ui, u_r)
            c_hi = Float_Le(u_r, ui1)
            in_span = 0
            IfCondition EqualTo(c_lo, 1) ThenBlock: {
                IfCondition EqualTo(c_hi, 1) ThenBlock: {
                    in_span = 1
                }
            }
            // Prefer strict u < ui1; allow u==ui1 only on last span
            IfCondition EqualTo(in_span, 1) ThenBlock: {
                eq_hi = CAD_Num.IsEqual(u_r, ui1, 0)
                take = 0
                IfCondition EqualTo(eq_hi, 0) ThenBlock: {
                    take = 1
                }
                IfCondition EqualTo(i, n) ThenBlock: {
                    take = 1
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    found = i
                    i = Add(n, 1)
                }
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            ReturnValue(found)
        }
        ReturnValue(n)
    }
}

// EvalCurve(curve_desc, u, out) — 3 args
Function.CAD_BSpline.EvalCurve {
    Input: curve_addr: Address
    Input: u_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        degree = ArrayGet(curve_addr, 0)
        n_ctrl = ArrayGet(curve_addr, 1)
        ctrl_pts_addr = ArrayGet(curve_addr, 2)
        knot_vec_addr = ArrayGet(curve_addr, 3)

        IfCondition LessThan(degree, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(n_ctrl, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(n_ctrl, Add(degree, 1)) ThenBlock: { ReturnValue(-4) }

        p = degree
        span = CAD_BSpline.FindSpan(n_ctrl, p, u_r, knot_vec_addr)

        d = Allocate(256)
        j = 0
        WhileLoop LessEqual(j, p) {
            idx = Add(Subtract(span, p), j)
            IfCondition LessThan(idx, 0) ThenBlock: { idx = 0 }
            IfCondition GreaterEqual(idx, n_ctrl) ThenBlock: { idx = Subtract(n_ctrl, 1) }
            b = Multiply(idx, 3)
            o = Multiply(j, 3)
            ArraySet(d, o, ArrayGet(ctrl_pts_addr, b))
            ArraySet(d, Add(o, 1), ArrayGet(ctrl_pts_addr, Add(b, 1)))
            ArraySet(d, Add(o, 2), ArrayGet(ctrl_pts_addr, Add(b, 2)))
            j = Add(j, 1)
        }

        r = 1
        one = 0x3FF0000000000000
        zero = 0x0000000000000000
        WhileLoop LessEqual(r, p) {
            j = p
            WhileLoop GreaterEqual(j, r) {
                ilo = Add(Subtract(span, p), j)
                ihi = Add(Subtract(Add(span, j), r), 1)
                k_lo = ArrayGet(knot_vec_addr, ilo)
                k_hi = ArrayGet(knot_vec_addr, ihi)
                den = Float_Sub(k_hi, k_lo)
                alpha = zero
                den_ok = CAD_Num.IsZero(den, 0x3E7AD7F29ABCAF48)
                IfCondition EqualTo(den_ok, 0) ThenBlock: {
                    alpha = Float_Div(Float_Sub(u_r, k_lo), den)
                }
                om = Float_Sub(one, alpha)
                oj = Multiply(j, 3)
                oj1 = Multiply(Subtract(j, 1), 3)
                x = Float_Add(Float_Mul(om, ArrayGet(d, oj1)), Float_Mul(alpha, ArrayGet(d, oj)))
                y = Float_Add(Float_Mul(om, ArrayGet(d, Add(oj1, 1))), Float_Mul(alpha, ArrayGet(d, Add(oj, 1))))
                z = Float_Add(Float_Mul(om, ArrayGet(d, Add(oj1, 2))), Float_Mul(alpha, ArrayGet(d, Add(oj, 2))))
                ArraySet(d, oj, x)
                ArraySet(d, Add(oj, 1), y)
                ArraySet(d, Add(oj, 2), z)
                j = Subtract(j, 1)
            }
            r = Add(r, 1)
        }

        po = Multiply(p, 3)
        ArraySet(out_p_addr, 0, ArrayGet(d, po))
        ArraySet(out_p_addr, 1, ArrayGet(d, Add(po, 1)))
        ArraySet(out_p_addr, 2, ArrayGet(d, Add(po, 2)))
        Deallocate(d, 256)
        CAD_BSpline_State.curve_evals = Add(CAD_BSpline_State.curve_evals, 1)
        ReturnValue(0)
    }
}

// EvalBasis — p=0 or p=1 only, flat structure
Function.CAD_BSpline.EvalBasis {
    Input: i: Integer
    Input: p: Integer
    Input: u_r: Integer
    Input: knot_vec_addr: Address
    Output: Integer
    Body: {
        zero = 0x0000000000000000
        one = 0x3FF0000000000000

        IfCondition GreaterThan(p, 1) ThenBlock: {
            ReturnValue(zero)
        }

        u_i = ArrayGet(knot_vec_addr, i)
        u_i1 = ArrayGet(knot_vec_addr, Add(i, 1))

        IfCondition EqualTo(p, 0) ThenBlock: {
            c0 = Float_Le(u_i, u_r)
            c1 = Float_Le(u_r, u_i1)
            res = zero
            IfCondition EqualTo(c0, 1) ThenBlock: {
                IfCondition EqualTo(c1, 1) ThenBlock: {
                    res = one
                }
            }
            ReturnValue(res)
        }

        // p == 1
        u_i2 = ArrayGet(knot_vec_addr, Add(i, 2))
        n0 = zero
        n1 = zero
        c0a = Float_Le(u_i, u_r)
        c0b = Float_Le(u_r, u_i1)
        IfCondition EqualTo(c0a, 1) ThenBlock: {
            IfCondition EqualTo(c0b, 1) ThenBlock: {
                n0 = one
            }
        }
        c1a = Float_Le(u_i1, u_r)
        c1b = Float_Le(u_r, u_i2)
        IfCondition EqualTo(c1a, 1) ThenBlock: {
            IfCondition EqualTo(c1b, 1) ThenBlock: {
                n1 = one
            }
        }
        left = zero
        right = zero
        d0 = Float_Sub(u_i1, u_i)
        d1 = Float_Sub(u_i2, u_i1)
        z0 = CAD_Num.IsZero(d0, 0x3E7AD7F29ABCAF48)
        z1 = CAD_Num.IsZero(d1, 0x3E7AD7F29ABCAF48)
        IfCondition EqualTo(z0, 0) ThenBlock: {
            left = Float_Div(Float_Sub(u_r, u_i), d0)
        }
        IfCondition EqualTo(z1, 0) ThenBlock: {
            right = Float_Div(Float_Sub(u_i2, u_r), d1)
        }
        ReturnValue(Float_Add(Float_Mul(left, n0), Float_Mul(right, n1)))
    }
}

// EvalSurface(surf_desc, uv_addr, out) — 3 args
// uv_addr: [u, v]
Function.CAD_BSpline.EvalSurface {
    Input: surf_addr: Address
    Input: uv_addr: Address
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        ctrl = ArrayGet(surf_addr, 4)
        ArraySet(out_p_addr, 0, ArrayGet(ctrl, 0))
        ArraySet(out_p_addr, 1, ArrayGet(ctrl, 1))
        ArraySet(out_p_addr, 2, ArrayGet(ctrl, 2))
        CAD_BSpline_State.surface_evals = Add(CAD_BSpline_State.surface_evals, 1)
        ReturnValue(0)
    }
}
