// CAD Kernel — CAD.BSpline — de Boor curve and NURBS surface
// SysV ABI: max 6 register args — keep all public APIs at ≤5 Inputs.
//
// Curve descriptor (words at curve_addr):
//   [0] degree
//   [1] n_ctrl
//   [2] ctrl_pts_addr
//   [3] knot_vec_addr
//   [4] weights_addr (0 = polynomial). EvalCurve ignores this word.
// Ctrl pts: xyz triples (index i → words 3*i..3*i+2)
// Knots: length n_ctrl+degree+1
//
// Surface descriptor (words at surf_addr):
//   [0] deg_u  [1] deg_v
//   [2] n_u    [3] n_v   (ctrl counts)
//   [4] ctrl_net_addr   row j, col i at (j*n_u+i)*3
//   [5] weights_addr (0 = non-rational), same (j*n_u+i) order
//   [6] knots_u  [7] knots_v
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Num

FixedPool.CAD_BSpline_State {
    "curve_evals":   Initialize=0
    "surface_evals": Initialize=0
    "scratch":       Initialize=0
}

// Find span: knots[i] <= u < knots[i+1]
Function.CAD_BSpline.FindSpan {
    Input: n_ctrl: Integer
    Input: degree: Integer
    Input: u_r: Integer
    Input: knot_vec_addr: Address
    Output: Integer
    Body: {
        n = Subtract(n_ctrl, 1)
        p = degree
        u_max = ArrayGet(knot_vec_addr, Add(Add(n, p), 1))
        at_end = Float_Le(u_max, u_r)
        IfCondition EqualTo(at_end, 1) ThenBlock: {
            ReturnValue(n)
        }

        i = p
        found = Subtract(0, 1)
        WhileLoop LessEqual(i, n) {
            ui = ArrayGet(knot_vec_addr, i)
            ui1 = ArrayGet(knot_vec_addr, Add(i, 1))
            c_lo = Float_Le(ui, u_r)
            c_hi = Float_Le(u_r, ui1)
            in_span = 0
            IfCondition EqualTo(c_lo, 1) ThenBlock: {
                IfCondition EqualTo(c_hi, 1) ThenBlock: {
                    in_span = 1
                }
            }
            // Prefer strict u < ui1; allow u==ui1 only on last span
            IfCondition EqualTo(in_span, 1) ThenBlock: {
                eq_hi = CAD_Num.IsEqual(u_r, ui1, 0)
                take = 0
                IfCondition EqualTo(eq_hi, 0) ThenBlock: {
                    take = 1
                }
                IfCondition EqualTo(i, n) ThenBlock: {
                    take = 1
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    found = i
                    i = Add(n, 1)
                }
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            ReturnValue(found)
        }
        ReturnValue(n)
    }
}

// EvalCurve(curve_desc, u, out) — 3 args
Function.CAD_BSpline.EvalCurve {
    Input: curve_addr: Address
    Input: u_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        degree = ArrayGet(curve_addr, 0)
        n_ctrl = ArrayGet(curve_addr, 1)
        ctrl_pts_addr = ArrayGet(curve_addr, 2)
        knot_vec_addr = ArrayGet(curve_addr, 3)

        IfCondition LessThan(degree, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(n_ctrl, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(n_ctrl, Add(degree, 1)) ThenBlock: { ReturnValue(-4) }

        p = degree
        span = CAD_BSpline.FindSpan(n_ctrl, p, u_r, knot_vec_addr)

        d = Allocate(256)
        j = 0
        WhileLoop LessEqual(j, p) {
            idx = Add(Subtract(span, p), j)
            IfCondition LessThan(idx, 0) ThenBlock: { idx = 0 }
            IfCondition GreaterEqual(idx, n_ctrl) ThenBlock: { idx = Subtract(n_ctrl, 1) }
            b = Multiply(idx, 3)
            o = Multiply(j, 3)
            ArraySet(d, o, ArrayGet(ctrl_pts_addr, b))
            ArraySet(d, Add(o, 1), ArrayGet(ctrl_pts_addr, Add(b, 1)))
            ArraySet(d, Add(o, 2), ArrayGet(ctrl_pts_addr, Add(b, 2)))
            j = Add(j, 1)
        }

        r = 1
        one = 0x3FF0000000000000
        zero = 0x0000000000000000
        WhileLoop LessEqual(r, p) {
            j = p
            WhileLoop GreaterEqual(j, r) {
                ilo = Add(Subtract(span, p), j)
                ihi = Add(Subtract(Add(span, j), r), 1)
                k_lo = ArrayGet(knot_vec_addr, ilo)
                k_hi = ArrayGet(knot_vec_addr, ihi)
                den = Float_Sub(k_hi, k_lo)
                alpha = zero
                den_ok = CAD_Num.IsZero(den, 0x3E7AD7F29ABCAF48)
                IfCondition EqualTo(den_ok, 0) ThenBlock: {
                    alpha = Float_Div(Float_Sub(u_r, k_lo), den)
                }
                om = Float_Sub(one, alpha)
                oj = Multiply(j, 3)
                oj1 = Multiply(Subtract(j, 1), 3)
                x = Float_Add(Float_Mul(om, ArrayGet(d, oj1)), Float_Mul(alpha, ArrayGet(d, oj)))
                y = Float_Add(Float_Mul(om, ArrayGet(d, Add(oj1, 1))), Float_Mul(alpha, ArrayGet(d, Add(oj, 1))))
                z = Float_Add(Float_Mul(om, ArrayGet(d, Add(oj1, 2))), Float_Mul(alpha, ArrayGet(d, Add(oj, 2))))
                ArraySet(d, oj, x)
                ArraySet(d, Add(oj, 1), y)
                ArraySet(d, Add(oj, 2), z)
                j = Subtract(j, 1)
            }
            r = Add(r, 1)
        }

        po = Multiply(p, 3)
        ArraySet(out_p_addr, 0, ArrayGet(d, po))
        ArraySet(out_p_addr, 1, ArrayGet(d, Add(po, 1)))
        ArraySet(out_p_addr, 2, ArrayGet(d, Add(po, 2)))
        Deallocate(d, 256)
        CAD_BSpline_State.curve_evals = Add(CAD_BSpline_State.curve_evals, 1)
        ReturnValue(0)
    }
}

// EvalBasis — p=0 or p=1 only, flat structure
Function.CAD_BSpline.EvalBasis {
    Input: i: Integer
    Input: p: Integer
    Input: u_r: Integer
    Input: knot_vec_addr: Address
    Output: Integer
    Body: {
        zero = 0x0000000000000000
        one = 0x3FF0000000000000

        IfCondition GreaterThan(p, 1) ThenBlock: {
            ReturnValue(zero)
        }

        u_i = ArrayGet(knot_vec_addr, i)
        u_i1 = ArrayGet(knot_vec_addr, Add(i, 1))

        IfCondition EqualTo(p, 0) ThenBlock: {
            c0 = Float_Le(u_i, u_r)
            c1 = Float_Le(u_r, u_i1)
            res = zero
            IfCondition EqualTo(c0, 1) ThenBlock: {
                IfCondition EqualTo(c1, 1) ThenBlock: {
                    res = one
                }
            }
            ReturnValue(res)
        }

        // p == 1
        u_i2 = ArrayGet(knot_vec_addr, Add(i, 2))
        n0 = zero
        n1 = zero
        c0a = Float_Le(u_i, u_r)
        c0b = Float_Le(u_r, u_i1)
        IfCondition EqualTo(c0a, 1) ThenBlock: {
            IfCondition EqualTo(c0b, 1) ThenBlock: {
                n0 = one
            }
        }
        c1a = Float_Le(u_i1, u_r)
        c1b = Float_Le(u_r, u_i2)
        IfCondition EqualTo(c1a, 1) ThenBlock: {
            IfCondition EqualTo(c1b, 1) ThenBlock: {
                n1 = one
            }
        }
        left = zero
        right = zero
        d0 = Float_Sub(u_i1, u_i)
        d1 = Float_Sub(u_i2, u_i1)
        z0 = CAD_Num.IsZero(d0, 0x3E7AD7F29ABCAF48)
        z1 = CAD_Num.IsZero(d1, 0x3E7AD7F29ABCAF48)
        IfCondition EqualTo(z0, 0) ThenBlock: {
            left = Float_Div(Float_Sub(u_r, u_i), d0)
        }
        IfCondition EqualTo(z1, 0) ThenBlock: {
            right = Float_Div(Float_Sub(u_i2, u_r), d1)
        }
        ReturnValue(Float_Add(Float_Mul(left, n0), Float_Mul(right, n1)))
    }
}

// Homogeneous de Boor. desc words:
//   [0] degree [1] n_ctrl [2] ctrl stride 4 (Xw,Yw,Zw,w)
//   [3] knots [4] u [5] out xyzw (not divided)
// Degree is capped at 8. Returns 0, or -4.
Function.CAD_BSpline.EvalHomo {
    Input: desc: Address
    Output: Integer
    Body: {
        degree = ArrayGet(desc, 0)
        n_ctrl = ArrayGet(desc, 1)
        ctrl = ArrayGet(desc, 2)
        knots = ArrayGet(desc, 3)
        u = ArrayGet(desc, 4)
        outp = ArrayGet(desc, 5)
        IfCondition LessThan(degree, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(degree, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(n_ctrl, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(n_ctrl, Add(degree, 1)) ThenBlock: { ReturnValue(-4) }
        p = degree
        span = CAD_BSpline.FindSpan(n_ctrl, p, u, knots)
        degree = ArrayGet(desc, 0)
        n_ctrl = ArrayGet(desc, 1)
        ctrl = ArrayGet(desc, 2)
        knots = ArrayGet(desc, 3)
        u = ArrayGet(desc, 4)
        outp = ArrayGet(desc, 5)
        p = degree
        d = Allocate(512)
        j = 0
        WhileLoop LessEqual(j, p) {
            idx = Add(Subtract(span, p), j)
            IfCondition LessThan(idx, 0) ThenBlock: { idx = 0 }
            IfCondition GreaterEqual(idx, n_ctrl) ThenBlock: { idx = Subtract(n_ctrl, 1) }
            b = Multiply(idx, 4)
            o = Multiply(j, 4)
            ArraySet(d, o, ArrayGet(ctrl, b))
            ArraySet(d, Add(o, 1), ArrayGet(ctrl, Add(b, 1)))
            ArraySet(d, Add(o, 2), ArrayGet(ctrl, Add(b, 2)))
            ArraySet(d, Add(o, 3), ArrayGet(ctrl, Add(b, 3)))
            j = Add(j, 1)
        }
        r = 1
        one = 0x3FF0000000000000
        zero = 0x0000000000000000
        WhileLoop LessEqual(r, p) {
            j = p
            WhileLoop GreaterEqual(j, r) {
                ilo = Add(Subtract(span, p), j)
                ihi = Add(Subtract(Add(span, j), r), 1)
                k_lo = ArrayGet(knots, ilo)
                k_hi = ArrayGet(knots, ihi)
                den = Float_Sub(k_hi, k_lo)
                alpha = zero
                den_ok = CAD_Num.IsZero(den, 0x3E7AD7F29ABCAF48)
                IfCondition EqualTo(den_ok, 0) ThenBlock: {
                    alpha = Float_Div(Float_Sub(u, k_lo), den)
                }
                om = Float_Sub(one, alpha)
                oj = Multiply(j, 4)
                oj1 = Multiply(Subtract(j, 1), 4)
                x = Float_Add(Float_Mul(om, ArrayGet(d, oj1)), Float_Mul(alpha, ArrayGet(d, oj)))
                y = Float_Add(Float_Mul(om, ArrayGet(d, Add(oj1, 1))), Float_Mul(alpha, ArrayGet(d, Add(oj, 1))))
                z = Float_Add(Float_Mul(om, ArrayGet(d, Add(oj1, 2))), Float_Mul(alpha, ArrayGet(d, Add(oj, 2))))
                w = Float_Add(Float_Mul(om, ArrayGet(d, Add(oj1, 3))), Float_Mul(alpha, ArrayGet(d, Add(oj, 3))))
                ArraySet(d, oj, x)
                ArraySet(d, Add(oj, 1), y)
                ArraySet(d, Add(oj, 2), z)
                ArraySet(d, Add(oj, 3), w)
                j = Subtract(j, 1)
            }
            r = Add(r, 1)
        }
        po = Multiply(p, 4)
        ArraySet(outp, 0, ArrayGet(d, po))
        ArraySet(outp, 1, ArrayGet(d, Add(po, 1)))
        ArraySet(outp, 2, ArrayGet(d, Add(po, 2)))
        ArraySet(outp, 3, ArrayGet(d, Add(po, 3)))
        Deallocate(d, 512)
        ReturnValue(0)
    }
}

// EvalSurface(surf_desc, uv_addr, out) — tensor product, rational when weights != 0.
// uv_addr: [u, v]. out: xyz. Returns 0, or -4.
Function.CAD_BSpline.EvalSurface {
    Input: surf_addr: Address
    Input: uv_addr: Address
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        sc = Allocate(128)
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(-4) }
        ArraySet(sc, 0, ArrayGet(surf_addr, 0))
        ArraySet(sc, 1, ArrayGet(surf_addr, 1))
        ArraySet(sc, 2, ArrayGet(surf_addr, 2))
        ArraySet(sc, 3, ArrayGet(surf_addr, 3))
        ArraySet(sc, 4, ArrayGet(surf_addr, 4))
        ArraySet(sc, 5, ArrayGet(surf_addr, 5))
        ArraySet(sc, 6, ArrayGet(surf_addr, 6))
        ArraySet(sc, 7, ArrayGet(surf_addr, 7))
        ArraySet(sc, 8, ArrayGet(uv_addr, 0))
        ArraySet(sc, 9, ArrayGet(uv_addr, 1))
        ArraySet(sc, 10, out_p_addr)
        IfCondition EqualTo(ArrayGet(sc, 6), 0) ThenBlock: {
            Deallocate(sc, 128)
            ReturnValue(-4)
        }
        IfCondition EqualTo(ArrayGet(sc, 7), 0) ThenBlock: {
            Deallocate(sc, 128)
            ReturnValue(-4)
        }
        IfCondition GreaterThan(ArrayGet(sc, 0), 8) ThenBlock: {
            Deallocate(sc, 128)
            ReturnValue(-4)
        }
        IfCondition GreaterThan(ArrayGet(sc, 1), 8) ThenBlock: {
            Deallocate(sc, 128)
            ReturnValue(-4)
        }
        IfCondition GreaterThan(ArrayGet(sc, 2), 64) ThenBlock: {
            Deallocate(sc, 128)
            ReturnValue(-4)
        }
        IfCondition GreaterThan(ArrayGet(sc, 3), 64) ThenBlock: {
            Deallocate(sc, 128)
            ReturnValue(-4)
        }
        row = Allocate(4096)
        col = Allocate(4096)
        desc = Allocate(64)
        hout = Allocate(48)
        IfCondition EqualTo(row, 0) ThenBlock: {
            Deallocate(sc, 128)
            ReturnValue(-4)
        }
        ArraySet(sc, 11, 0)
        one = 0x3FF0000000000000
        WhileLoop LessThan(ArrayGet(sc, 11), ArrayGet(sc, 2)) {
            ArraySet(sc, 12, 0)
            WhileLoop LessThan(ArrayGet(sc, 12), ArrayGet(sc, 3)) {
                base = Add(Multiply(ArrayGet(sc, 12), ArrayGet(sc, 2)), ArrayGet(sc, 11))
                xb = Multiply(base, 3)
                w = one
                IfCondition NotEqual(ArrayGet(sc, 5), 0) ThenBlock: {
                    w = ArrayGet(ArrayGet(sc, 5), base)
                }
                o = Multiply(ArrayGet(sc, 12), 4)
                ArraySet(col, o, Float_Mul(ArrayGet(ArrayGet(sc, 4), xb), w))
                ArraySet(col, Add(o, 1), Float_Mul(ArrayGet(ArrayGet(sc, 4), Add(xb, 1)), w))
                ArraySet(col, Add(o, 2), Float_Mul(ArrayGet(ArrayGet(sc, 4), Add(xb, 2)), w))
                ArraySet(col, Add(o, 3), w)
                ArraySet(sc, 12, Add(ArrayGet(sc, 12), 1))
            }
            ArraySet(desc, 0, ArrayGet(sc, 1))
            ArraySet(desc, 1, ArrayGet(sc, 3))
            ArraySet(desc, 2, col)
            ArraySet(desc, 3, ArrayGet(sc, 7))
            ArraySet(desc, 4, ArrayGet(sc, 9))
            ArraySet(desc, 5, hout)
            CAD_BSpline.EvalHomo(desc)
            o = Multiply(ArrayGet(sc, 11), 4)
            ArraySet(row, o, ArrayGet(hout, 0))
            ArraySet(row, Add(o, 1), ArrayGet(hout, 1))
            ArraySet(row, Add(o, 2), ArrayGet(hout, 2))
            ArraySet(row, Add(o, 3), ArrayGet(hout, 3))
            ArraySet(sc, 11, Add(ArrayGet(sc, 11), 1))
        }
        ArraySet(desc, 0, ArrayGet(sc, 0))
        ArraySet(desc, 1, ArrayGet(sc, 2))
        ArraySet(desc, 2, row)
        ArraySet(desc, 3, ArrayGet(sc, 6))
        ArraySet(desc, 4, ArrayGet(sc, 8))
        ArraySet(desc, 5, hout)
        CAD_BSpline.EvalHomo(desc)
        w = ArrayGet(hout, 3)
        IfCondition EqualTo(CAD_Num.IsZero(w, 0), 1) ThenBlock: {
            Deallocate(hout, 48)
            Deallocate(desc, 64)
            Deallocate(col, 4096)
            Deallocate(row, 4096)
            Deallocate(sc, 128)
            ReturnValue(-4)
        }
        outp = ArrayGet(sc, 10)
        ArraySet(outp, 0, Float_Div(ArrayGet(hout, 0), w))
        ArraySet(outp, 1, Float_Div(ArrayGet(hout, 1), w))
        ArraySet(outp, 2, Float_Div(ArrayGet(hout, 2), w))
        Deallocate(hout, 48)
        Deallocate(desc, 64)
        Deallocate(col, 4096)
        Deallocate(row, 4096)
        Deallocate(sc, 128)
        CAD_BSpline_State.surface_evals = Add(CAD_BSpline_State.surface_evals, 1)
        ReturnValue(0)
    }
}

// Closed degree-1 curve through n xyz triples. Repeats the first control.
// curve words: degree, n_ctrl, ctrl (2048), knots (1024), weights 0.
// Returns 0, or -4.
Function.CAD_BSpline.MakeRing {
    Input: xyz: Address
    Input: n: Integer
    Input: curve_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(n, 60) ThenBlock: { ReturnValue(-4) }
        ctrl = Allocate(2048)
        knots = Allocate(1024)
        IfCondition EqualTo(ctrl, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(knots, 0) ThenBlock: {
            Deallocate(ctrl, 2048)
            ReturnValue(-4)
        }
        i = 0
        WhileLoop LessThan(i, n) {
            ArraySet(ctrl, Multiply(i, 3), ArrayGet(xyz, Multiply(i, 3)))
            ArraySet(ctrl, Add(Multiply(i, 3), 1), ArrayGet(xyz, Add(Multiply(i, 3), 1)))
            ArraySet(ctrl, Add(Multiply(i, 3), 2), ArrayGet(xyz, Add(Multiply(i, 3), 2)))
            i = Add(i, 1)
        }
        ArraySet(ctrl, Multiply(n, 3), ArrayGet(xyz, 0))
        ArraySet(ctrl, Add(Multiply(n, 3), 1), ArrayGet(xyz, 1))
        ArraySet(ctrl, Add(Multiply(n, 3), 2), ArrayGet(xyz, 2))
        fn = Float_FromInt(n)
        i = 0
        WhileLoop LessEqual(i, Add(n, 2)) {
            kv = 0
            IfCondition GreaterEqual(i, Add(n, 1)) ThenBlock: { kv = 0x3FF0000000000000 }
            IfCondition GreaterThan(i, 1) ThenBlock: {
                IfCondition LessThan(i, Add(n, 1)) ThenBlock: {
                    kv = Float_Div(Float_FromInt(Subtract(i, 1)), fn)
                }
            }
            ArraySet(knots, i, kv)
            i = Add(i, 1)
        }
        ArraySet(curve_addr, 0, 1)
        ArraySet(curve_addr, 1, Add(n, 1))
        ArraySet(curve_addr, 2, ctrl)
        ArraySet(curve_addr, 3, knots)
        ArraySet(curve_addr, 4, 0)
        ReturnValue(0)
    }
}

Function.CAD_BSpline.FreeRing {
    Input: curve_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(curve_addr, 0) ThenBlock: { ReturnValue(0) }
        ctrl = ArrayGet(curve_addr, 2)
        knots = ArrayGet(curve_addr, 3)
        IfCondition NotEqual(ctrl, 0) ThenBlock: { Deallocate(ctrl, 2048) }
        IfCondition NotEqual(knots, 0) ThenBlock: { Deallocate(knots, 1024) }
        ArraySet(curve_addr, 2, 0)
        ArraySet(curve_addr, 3, 0)
        ReturnValue(0)
    }
}

// Degree-1 ruled surface between two curves of equal degree and count.
// knots_u aliases curve A. ctrl is a new 4096-byte net. knots_v is 64 bytes.
// Returns 0, or -4.
Function.CAD_BSpline.MakeRuled {
    Input: curve_a: Address
    Input: curve_b: Address
    Input: surf_addr: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(ArrayGet(curve_a, 0), ArrayGet(curve_b, 0)) ThenBlock: { ReturnValue(-4) }
        IfCondition NotEqual(ArrayGet(curve_a, 1), ArrayGet(curve_b, 1)) ThenBlock: { ReturnValue(-4) }
        n = ArrayGet(curve_a, 1)
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(n, 64) ThenBlock: { ReturnValue(-4) }
        ctrl = Allocate(4096)
        kv = Allocate(64)
        IfCondition EqualTo(ctrl, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(kv, 0) ThenBlock: {
            Deallocate(ctrl, 4096)
            ReturnValue(-4)
        }
        ca = ArrayGet(curve_a, 2)
        cb = ArrayGet(curve_b, 2)
        i = 0
        WhileLoop LessThan(i, n) {
            ArraySet(ctrl, Multiply(i, 3), ArrayGet(ca, Multiply(i, 3)))
            ArraySet(ctrl, Add(Multiply(i, 3), 1), ArrayGet(ca, Add(Multiply(i, 3), 1)))
            ArraySet(ctrl, Add(Multiply(i, 3), 2), ArrayGet(ca, Add(Multiply(i, 3), 2)))
            base = Add(n, i)
            ArraySet(ctrl, Multiply(base, 3), ArrayGet(cb, Multiply(i, 3)))
            ArraySet(ctrl, Add(Multiply(base, 3), 1), ArrayGet(cb, Add(Multiply(i, 3), 1)))
            ArraySet(ctrl, Add(Multiply(base, 3), 2), ArrayGet(cb, Add(Multiply(i, 3), 2)))
            i = Add(i, 1)
        }
        ArraySet(kv, 0, 0)
        ArraySet(kv, 1, 0)
        ArraySet(kv, 2, 0x3FF0000000000000)
        ArraySet(kv, 3, 0x3FF0000000000000)
        ArraySet(surf_addr, 0, ArrayGet(curve_a, 0))
        ArraySet(surf_addr, 1, 1)
        ArraySet(surf_addr, 2, n)
        ArraySet(surf_addr, 3, 2)
        ArraySet(surf_addr, 4, ctrl)
        ArraySet(surf_addr, 5, 0)
        ArraySet(surf_addr, 6, ArrayGet(curve_a, 3))
        ArraySet(surf_addr, 7, kv)
        ReturnValue(0)
    }
}

Function.CAD_BSpline.FreeRuled {
    Input: surf_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(surf_addr, 0) ThenBlock: { ReturnValue(0) }
        ctrl = ArrayGet(surf_addr, 4)
        kv = ArrayGet(surf_addr, 7)
        IfCondition NotEqual(ctrl, 0) ThenBlock: { Deallocate(ctrl, 4096) }
        IfCondition NotEqual(kv, 0) ThenBlock: { Deallocate(kv, 64) }
        ArraySet(surf_addr, 4, 0)
        ArraySet(surf_addr, 7, 0)
        ReturnValue(0)
    }
}

// Sample a closed ruled ring at u=i/n, v=0 and v=1. n is the unique corner count.
// Returns 0, or -4.
Function.CAD_BSpline.SampleRuled {
    Input: surf_addr: Address
    Input: n: Integer
    Input: xyz_bot: Address
    Input: xyz_top: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(-4) }
        CAD_BSpline_State.scratch = Allocate(128)
        IfCondition EqualTo(CAD_BSpline_State.scratch, 0) ThenBlock: { ReturnValue(-4) }
        ArraySet(CAD_BSpline_State.scratch, 0, surf_addr)
        ArraySet(CAD_BSpline_State.scratch, 1, n)
        ArraySet(CAD_BSpline_State.scratch, 2, xyz_bot)
        ArraySet(CAD_BSpline_State.scratch, 3, xyz_top)
        ArraySet(CAD_BSpline_State.scratch, 4, 0)
        ArraySet(CAD_BSpline_State.scratch, 5, Float_FromInt(n))
        ArraySet(CAD_BSpline_State.scratch, 6, Allocate(32))
        ArraySet(CAD_BSpline_State.scratch, 7, Allocate(32))
        ArraySet(CAD_BSpline_State.scratch, 8, 0x3FF0000000000000)
        IfCondition EqualTo(ArrayGet(CAD_BSpline_State.scratch, 6), 0) ThenBlock: {
            Deallocate(CAD_BSpline_State.scratch, 128)
            CAD_BSpline_State.scratch = 0
            ReturnValue(-4)
        }
        WhileLoop LessThan(ArrayGet(CAD_BSpline_State.scratch, 4), ArrayGet(CAD_BSpline_State.scratch, 1)) {
            ArraySet(ArrayGet(CAD_BSpline_State.scratch, 6), 0, Float_Div(Float_FromInt(ArrayGet(CAD_BSpline_State.scratch, 4)), ArrayGet(CAD_BSpline_State.scratch, 5)))
            ArraySet(ArrayGet(CAD_BSpline_State.scratch, 6), 1, 0)
            rc = CAD_BSpline.EvalSurface(ArrayGet(CAD_BSpline_State.scratch, 0), ArrayGet(CAD_BSpline_State.scratch, 6), ArrayGet(CAD_BSpline_State.scratch, 7))
            IfCondition NotEqual(rc, 0) ThenBlock: {
                Deallocate(ArrayGet(CAD_BSpline_State.scratch, 6), 32)
                Deallocate(ArrayGet(CAD_BSpline_State.scratch, 7), 32)
                Deallocate(CAD_BSpline_State.scratch, 128)
                CAD_BSpline_State.scratch = 0
                ReturnValue(-4)
            }
            ArraySet(ArrayGet(CAD_BSpline_State.scratch, 2), Multiply(ArrayGet(CAD_BSpline_State.scratch, 4), 3), ArrayGet(ArrayGet(CAD_BSpline_State.scratch, 7), 0))
            ArraySet(ArrayGet(CAD_BSpline_State.scratch, 2), Add(Multiply(ArrayGet(CAD_BSpline_State.scratch, 4), 3), 1), ArrayGet(ArrayGet(CAD_BSpline_State.scratch, 7), 1))
            ArraySet(ArrayGet(CAD_BSpline_State.scratch, 2), Add(Multiply(ArrayGet(CAD_BSpline_State.scratch, 4), 3), 2), ArrayGet(ArrayGet(CAD_BSpline_State.scratch, 7), 2))
            ArraySet(ArrayGet(CAD_BSpline_State.scratch, 6), 1, ArrayGet(CAD_BSpline_State.scratch, 8))
            rc = CAD_BSpline.EvalSurface(ArrayGet(CAD_BSpline_State.scratch, 0), ArrayGet(CAD_BSpline_State.scratch, 6), ArrayGet(CAD_BSpline_State.scratch, 7))
            IfCondition NotEqual(rc, 0) ThenBlock: {
                Deallocate(ArrayGet(CAD_BSpline_State.scratch, 6), 32)
                Deallocate(ArrayGet(CAD_BSpline_State.scratch, 7), 32)
                Deallocate(CAD_BSpline_State.scratch, 128)
                CAD_BSpline_State.scratch = 0
                ReturnValue(-4)
            }
            ArraySet(ArrayGet(CAD_BSpline_State.scratch, 3), Multiply(ArrayGet(CAD_BSpline_State.scratch, 4), 3), ArrayGet(ArrayGet(CAD_BSpline_State.scratch, 7), 0))
            ArraySet(ArrayGet(CAD_BSpline_State.scratch, 3), Add(Multiply(ArrayGet(CAD_BSpline_State.scratch, 4), 3), 1), ArrayGet(ArrayGet(CAD_BSpline_State.scratch, 7), 1))
            ArraySet(ArrayGet(CAD_BSpline_State.scratch, 3), Add(Multiply(ArrayGet(CAD_BSpline_State.scratch, 4), 3), 2), ArrayGet(ArrayGet(CAD_BSpline_State.scratch, 7), 2))
            ArraySet(CAD_BSpline_State.scratch, 4, Add(ArrayGet(CAD_BSpline_State.scratch, 4), 1))
        }
        Deallocate(ArrayGet(CAD_BSpline_State.scratch, 6), 32)
        Deallocate(ArrayGet(CAD_BSpline_State.scratch, 7), 32)
        Deallocate(CAD_BSpline_State.scratch, 128)
        CAD_BSpline_State.scratch = 0
        ReturnValue(0)
    }
}
