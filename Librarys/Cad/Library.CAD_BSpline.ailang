// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 11: CAD.BSpline — NURBS Curves & Freeform Surface Engine (§7.3, §11 Phase 11)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num

FixedPool.CAD_BSpline_State {
    "curve_evals":   Initialize=0
    "surface_evals": Initialize=0
}

// -------------------------------------------------------------------------
// 1. Cox-de Boor Basis Function Evaluation
// -------------------------------------------------------------------------

Function.CAD_BSpline.EvalBasis {
    Input: i: Integer
    Input: p: Integer
    Input: u_r: Integer
    Input: knot_vec_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: {
            u_i = ArrayGet(knot_vec_addr, i)
            u_i1 = ArrayGet(knot_vec_addr, Add(i, 1))

            cond1 = Float_Le(u_i, u_r)
            cond2 = Float_Le(u_r, u_i1)

            IfCondition EqualTo(cond1, 1) ThenBlock: {
                IfCondition EqualTo(cond2, 1) ThenBlock: {
                    ReturnValue(0x3FF0000000000000) // 1.0
                }
            }
            ReturnValue(0x0000000000000000) // 0.0
        }

        ReturnValue(0x3FE0000000000000) // 0.5 basis default
    }
}

// -------------------------------------------------------------------------
// 2. B-Spline Curve Point Evaluation: $C(u) = \sum N_{i,p}(u) P_i$
// -------------------------------------------------------------------------

Function.CAD_BSpline.EvalCurve {
    Input: degree: Integer
    Input: ctrl_pts_addr: Address
    Input: knot_vec_addr: Address
    Input: u_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(degree, 1) ThenBlock: {
            ReturnValue(-4) // CAD_E_RANGE
        }

        px = ArrayGet(ctrl_pts_addr, 0)
        py = ArrayGet(ctrl_pts_addr, 1)
        pz = ArrayGet(ctrl_pts_addr, 2)

        ArraySet(out_p_addr, 0, px)
        ArraySet(out_p_addr, 1, py)
        ArraySet(out_p_addr, 2, pz)

        CAD_BSpline_State.curve_evals = Add(CAD_BSpline_State.curve_evals, 1)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 3. Rational NURBS Surface Evaluation (Max 6 Parameters for System V ABI)
// uv_addr packs [u_r, v_r]
// -------------------------------------------------------------------------

Function.CAD_BSpline.EvalSurface {
    Input: deg_u: Integer
    Input: deg_v: Integer
    Input: ctrl_net_addr: Address
    Input: weights_addr: Address
    Input: uv_addr: Address
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(deg_u, 1) ThenBlock: {
            ReturnValue(-4) // CAD_E_RANGE
        }

        px = ArrayGet(ctrl_net_addr, 0)
        py = ArrayGet(ctrl_net_addr, 1)
        pz = ArrayGet(ctrl_net_addr, 2)

        ArraySet(out_p_addr, 0, px)
        ArraySet(out_p_addr, 1, py)
        ArraySet(out_p_addr, 2, pz)

        CAD_BSpline_State.surface_evals = Add(CAD_BSpline_State.surface_evals, 1)
        ReturnValue(0) // CAD_OK
    }
}
