// CAD Kernel — CAD.Blend — Edge fillet / chamfer
//
// General edge-based blend (NOT shape recipes):
//   FilletEdge(solid, edge, R) → offset supports → spine → blend face → new solid
// Domain: plane–plane edges first (any faceted solid). Else return 0.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Isect
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Offset

FixedPool.CAD_Blend_State {
    "fillets_created":  Initialize=0
    "chamfers_created": Initialize=0
    "blend_surfaces":   Initialize=0
}

// Rolling-ball frame for two planes (outward unit normals in f1/f2 Z slots 9-11).
// out: [cx,cy,cz, dx,dy,dz, R] spine point + unit edge dir + radius.
// Returns 0 ok, -1 fail.
Function.CAD_Blend.ComputeRollingBall {
    Input: f1_addr: Address
    Input: f2_addr: Address
    Input: radius_r: Integer
    Input: out_blend_frame_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(f1_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(f2_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(-1) }
        n1x = ArrayGet(f1_addr, 9)
        n1y = ArrayGet(f1_addr, 10)
        n1z = ArrayGet(f1_addr, 11)
        n2x = ArrayGet(f2_addr, 9)
        n2y = ArrayGet(f2_addr, 10)
        n2z = ArrayGet(f2_addr, 11)
        o1x = ArrayGet(f1_addr, 0)
        o1y = ArrayGet(f1_addr, 1)
        o1z = ArrayGet(f1_addr, 2)
        // edge dir = N1 × N2
        ex = Float_Sub(Float_Mul(n1y, n2z), Float_Mul(n1z, n2y))
        ey = Float_Sub(Float_Mul(n1z, n2x), Float_Mul(n1x, n2z))
        ez = Float_Sub(Float_Mul(n1x, n2y), Float_Mul(n1y, n2x))
        el = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ex, ex), Float_Mul(ey, ey)), Float_Mul(ez, ez)))
        IfCondition EqualTo(CAD_Num.IsZero(el, 0), 1) ThenBlock: { ReturnValue(-1) }
        ex = Float_Div(ex, el)
        ey = Float_Div(ey, el)
        ez = Float_Div(ez, el)
        // spine through O1 - R*N1 - R*N2 (inward offsets of both planes; exact for |N|=1)
        cx = Float_Sub(Float_Sub(o1x, Float_Mul(radius_r, n1x)), Float_Mul(radius_r, n2x))
        cy = Float_Sub(Float_Sub(o1y, Float_Mul(radius_r, n1y)), Float_Mul(radius_r, n2y))
        cz = Float_Sub(Float_Sub(o1z, Float_Mul(radius_r, n1z)), Float_Mul(radius_r, n2z))
        ArraySet(out_blend_frame_addr, 0, cx)
        ArraySet(out_blend_frame_addr, 1, cy)
        ArraySet(out_blend_frame_addr, 2, cz)
        ArraySet(out_blend_frame_addr, 3, ex)
        ArraySet(out_blend_frame_addr, 4, ey)
        ArraySet(out_blend_frame_addr, 5, ez)
        ArraySet(out_blend_frame_addr, 6, radius_r)
        CAD_Blend_State.blend_surfaces = Add(CAD_Blend_State.blend_surfaces, 1)
        ReturnValue(0)
    }
}

// Fillet one edge. Plane–plane (faceted) or plane–cyl top rim of kind-1 cylinder.
// Returns new solid handle or 0 (never empty fake solid).
Function.CAD_Blend.FilletEdge {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FSeq.pack, 0) ThenBlock: { CAD_Topo_FSeq.pack = Allocate(128) }
        IfCondition NotEqual(CAD_Topo_FSeq.pack, 0) ThenBlock: {
            ArraySet(CAD_Topo_FSeq.pack, 0, edge_handle)
            CAD_Topo.FilletCompile(solid_handle, CAD_Topo_FSeq.pack, 1, radius_r)
        }
        CAD_Topo_State.fillet_class = CAD_Topo.ClassifyFilletEdge(solid_handle, edge_handle, radius_r)
        cls = CAD_Topo_State.fillet_class
        PrintMessage("fillet class=")
        PrintNumber(cls)
        PrintMessage(" n=1\n")
        h = 0
        Branch cls {
            Case 1: {
                h = CAD_Topo.FilletPlaneEdgesDigon(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.nH, CAD_Topo_FSeq.r)
            }
            Case 2: {
                h = CAD_Topo.FilletEdgeLocal(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r)
            }
            Case 3: {
                h = CAD_Topo.FilletJoinCoveCycle(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.nH, CAD_Topo_FSeq.r)
            }
            Case 4: {
                h = CAD_Blend.FilletCylTopRim(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r)
            }
            Case 5: {
                h = CAD_Blend.FilletCylBottomRim(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r)
            }
            Case 6: {
                h = CAD_Topo.FilletEmitPlaneCyl(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r)
                IfCondition EqualTo(h, 0) ThenBlock: {
                    h = CAD_Blend.FilletPlaneCylJoin(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r)
                }
            }
            Case 7: {
                h = CAD_Topo.FilletEdgesSequential(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.vert, CAD_Topo_FSeq.nV, CAD_Topo_FSeq.r)
            }
            Case 8: {
                h = CAD_Topo.FilletEmitChain(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.r)
            }
            Case 9: {
                h = CAD_Topo.FilletEmitChain(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.r)
            }
            Default: {
                h = 0
            }
        }
        IfCondition NotEqual(h, 0) ThenBlock: {
            CAD_Blend_State.fillets_created = Add(CAD_Blend_State.fillets_created, 1)
        }
        ReturnValue(h)
    }
}

// Boss-base join: inner CIRCLE on a glued plane (box + cylinder).
// Quarter-torus cove weld. One shell. Not a lathe CompoundAdd.
Function.CAD_Blend.FilletPlaneCylJoin {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Topo.FilletBossBaseCove(solid_handle, edge_handle, radius_r))
    }
}

// Plane–cyl fillet: kind-1 cylinder, top closed circular edge only.
// Rebuild as analytic circles + cylinder + torus. R < r and R < h.
Function.CAD_Blend.FilletCylTopRim {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        // Rebuilds a *lone* cylinder. A pad glued on the cap is extra
        // faces/shells — replacing the solid dropped the rectangle
        // (Screenshot_2026-08-23_12-11-37).
        IfCondition GreaterThan(CAD_Topo.SolidCountShells(solid_handle), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CAD_Topo.SolidCountFaces(solid_handle), 4) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.SolidHasInnerLoop(solid_handle), 1) ThenBlock: { ReturnValue(0) }
        cr = 0
        ch = 0
        ox = 0
        oy = 0
        oz = 0
        ztop = 0
        ok = 0
        // kind 1 exact cylinder (params in slot 1)
        IfCondition EqualTo(CAD_Store.Read(solid_handle, 3), 1) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            IfCondition NotEqual(ph, 0) ThenBlock: {
                cr = CAD_Store.Read(ph, 0)
                ch = CAD_Store.Read(ph, 1)
                ox = CAD_Store.Read(ph, 2)
                oy = CAD_Store.Read(ph, 3)
                oz = CAD_Store.Read(ph, 4)
                ztop = Float_Add(oz, ch)
                ok = 1
            }
        }
        // kind-0 sweep cylinder: closed CIRCLE edge + AABB height
        IfCondition EqualTo(ok, 0) ThenBlock: {
            curv = CAD_Store.Read(edge_handle, 2)
            IfCondition NotEqual(curv, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(curv, 0), 2) ThenBlock: {
                    cr = CAD_Store.Read(curv, 10)
                    ox = CAD_Store.Read(curv, 1)
                    oy = CAD_Store.Read(curv, 2)
                    mn = Allocate(32)
                    mx = Allocate(32)
                    IfCondition EqualTo(CAD_Topo.SolidBounds(solid_handle, mn, mx), 1) ThenBlock: {
                        oz = ArrayGet(mn, 2)
                        ztop = ArrayGet(mx, 2)
                        ch = Float_Sub(ztop, oz)
                        ok = 1
                    }
                    Deallocate(mn, 32)
                    Deallocate(mx, 32)
                }
            }
        }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(cr, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(cr, radius_r), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(ch, radius_r), 1) ThenBlock: { ReturnValue(0) }
        v0 = CAD_Store.Read(edge_handle, 0)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        z0 = CAD_Store.Read(v0, 2)
        IfCondition EqualTo(CAD_Num.IsEqual(z0, ztop, 0), 0) ThenBlock: { ReturnValue(0) }
        v1 = CAD_Store.Read(edge_handle, 1)
        IfCondition NotEqual(v0, v1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v1, 2), ztop, 0), 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        out = Allocate(16)
        h = CAD_Topo.MakeCylinderTopFillet(cr, ch, radius_r, out)
        Deallocate(out, 16)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        need_t = 0
        IfCondition EqualTo(CAD_Num.IsZero(ox, 0), 0) ThenBlock: { need_t = 1 }
        IfCondition EqualTo(CAD_Num.IsZero(oy, 0), 0) ThenBlock: { need_t = 1 }
        IfCondition EqualTo(CAD_Num.IsZero(oz, 0), 0) ThenBlock: { need_t = 1 }
        IfCondition EqualTo(need_t, 1) ThenBlock: {
            dlt = Allocate(32)
            ArraySet(dlt, 0, ox)
            ArraySet(dlt, 1, oy)
            ArraySet(dlt, 2, oz)
            CAD_Topo.TranslateSolid(h, dlt)
            Deallocate(dlt, 32)
        }
        PrintMessage("fillet cyl-top convex torus\n")
        ReturnValue(h)
    }
}

// Plane–cyl: kind-1 cylinder bottom closed circular rim.
Function.CAD_Blend.FilletCylBottomRim {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CAD_Topo.SolidCountShells(solid_handle), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CAD_Topo.SolidCountFaces(solid_handle), 4) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(solid_handle, 3), 1) ThenBlock: { ReturnValue(0) }
        ph = CAD_Store.Read(solid_handle, 1)
        IfCondition EqualTo(ph, 0) ThenBlock: { ReturnValue(0) }
        cr = CAD_Store.Read(ph, 0)
        ch = CAD_Store.Read(ph, 1)
        ox = CAD_Store.Read(ph, 2)
        oy = CAD_Store.Read(ph, 3)
        oz = CAD_Store.Read(ph, 4)
        v0 = CAD_Store.Read(edge_handle, 0)
        v1 = CAD_Store.Read(edge_handle, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        z0 = CAD_Store.Read(v0, 2)
        IfCondition EqualTo(CAD_Num.IsEqual(z0, oz, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(v0, v1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(v1, 2), oz, 0), 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        out = Allocate(16)
        h = CAD_Topo.MakeCylinderBottomFillet(cr, ch, radius_r, out)
        Deallocate(out, 16)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        need_t = 0
        IfCondition EqualTo(CAD_Num.IsZero(ox, 0), 0) ThenBlock: { need_t = 1 }
        IfCondition EqualTo(CAD_Num.IsZero(oy, 0), 0) ThenBlock: { need_t = 1 }
        IfCondition EqualTo(CAD_Num.IsZero(oz, 0), 0) ThenBlock: { need_t = 1 }
        IfCondition EqualTo(need_t, 1) ThenBlock: {
            dlt = Allocate(32)
            ArraySet(dlt, 0, ox)
            ArraySet(dlt, 1, oy)
            ArraySet(dlt, 2, oz)
            CAD_Topo.TranslateSolid(h, dlt)
            Deallocate(dlt, 32)
        }
        ReturnValue(h)
    }
}

// Direct builder: washer top inner (hole) rim fillet — concave plane–cyl.
// Not edge-picked from kind-3 plate yet; call when domain is round plate+hole.
Function.CAD_Blend.FilletWasherHoleTop {
    Input: r_in_r: Integer
    Input: r_out_r: Integer
    Input: height_r: Integer
    Input: fillet_r: Integer
    Output: Integer
    Body: {
        out = Allocate(16)
        h = CAD_Topo.MakeWasherTopInnerFillet(r_in_r, r_out_r, height_r, fillet_r, out)
        Deallocate(out, 16)
        IfCondition NotEqual(h, 0) ThenBlock: {
            CAD_Blend_State.fillets_created = Add(CAD_Blend_State.fillets_created, 1)
        }
        ReturnValue(h)
    }
}

// Fillet several plane–plane edges at equal R (edge set, not a shape recipe).
// Shared vertices (2+ selected edges) classified for corner blend; isolated
// edges use the same path as FilletEdge. Pass edges in any order.
Function.CAD_Blend.FilletEdges {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        h = CAD_Topo.FilletPlaneEdges(solid_handle, edges_addr, n_edges, radius_r)
        IfCondition NotEqual(h, 0) ThenBlock: {
            CAD_Blend_State.fillets_created = Add(CAD_Blend_State.fillets_created, n_edges)
        }
        ReturnValue(h)
    }
}

// AddFillet(solid, edge, R) — same as FilletEdge (edge-based).
Function.CAD_Blend.AddFillet {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Blend.FilletEdge(solid_handle, edge_handle, radius_r))
    }
}

// Variable fillet: not implemented.
Function.CAD_Blend.AddVariableFillet {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: r_start_r: Integer
    Input: r_end_r: Integer
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

// Equal-setback chamfer one edge.
// Vertical full-height → prism base cut (any kind-0 poly).
// Horizontal full-span on AABB box top/bottom → profile extrude + remap.
// Returns new solid or 0.
Function.CAD_Blend.ChamferEdge {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: distance_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(distance_r, 0), 1) ThenBlock: { ReturnValue(0) }
        v0 = CAD_Store.Read(edge_handle, 0)
        v1 = CAD_Store.Read(edge_handle, 1)
        x0 = CAD_Store.Read(v0, 0)
        y0 = CAD_Store.Read(v0, 1)
        z0 = CAD_Store.Read(v0, 2)
        x1 = CAD_Store.Read(v1, 0)
        y1 = CAD_Store.Read(v1, 1)
        z1 = CAD_Store.Read(v1, 2)
        // horizontal? same Z, differ in X or Y
        IfCondition EqualTo(CAD_Num.IsEqual(z0, z1, 0), 1) ThenBlock: {
            same_x = CAD_Num.IsEqual(x0, x1, 0)
            same_y = CAD_Num.IsEqual(y0, y1, 0)
            IfCondition EqualTo(same_x, 0) ThenBlock: {
                IfCondition EqualTo(same_y, 1) ThenBlock: {
                    // along X, fixed Y
                    ReturnValue(CAD_Blend.ChamferHorizBox(solid_handle, edge_handle, distance_r))
                }
            }
            IfCondition EqualTo(same_y, 0) ThenBlock: {
                IfCondition EqualTo(same_x, 1) ThenBlock: {
                    // along Y, fixed X
                    ReturnValue(CAD_Blend.ChamferHorizBox(solid_handle, edge_handle, distance_r))
                }
            }
            ReturnValue(0)
        }
        // vertical path
        edges = Allocate(16)
        ArraySet(edges, 0, edge_handle)
        h = CAD_Blend.ChamferEdges(solid_handle, edges, 1, distance_r)
        Deallocate(edges, 16)
        ReturnValue(h)
    }
}

// Horizontal equal-setback chamfer on an axis-aligned box top/bottom edge.
// Edge must span full width of AABB. D < face extent. Kind-0 box only (rect base).
Function.CAD_Blend.ChamferHorizBox {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: distance_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(solid_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        D = distance_r
        mn = Allocate(32)
        mx = Allocate(32)
        IfCondition NotEqual(CAD_Topo.SolidBounds(solid_handle, mn, mx), 1) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        xmin = ArrayGet(mn, 0)
        ymin = ArrayGet(mn, 1)
        zmin = ArrayGet(mn, 2)
        xmax = ArrayGet(mx, 0)
        ymax = ArrayGet(mx, 1)
        zmax = ArrayGet(mx, 2)
        // must be rectangular prism: 4-vert bottom
        xy = Allocate(256)
        zpack = Allocate(32)
        nbot = CAD_Topo.ExtractBottomLoopXY(solid_handle, xy, zpack)
        Deallocate(xy, 256)
        Deallocate(zpack, 32)
        IfCondition NotEqual(nbot, 4) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        v0 = CAD_Store.Read(edge_handle, 0)
        v1 = CAD_Store.Read(edge_handle, 1)
        ex0 = CAD_Store.Read(v0, 0)
        ey0 = CAD_Store.Read(v0, 1)
        ez0 = CAD_Store.Read(v0, 2)
        ex1 = CAD_Store.Read(v1, 0)
        ey1 = CAD_Store.Read(v1, 1)
        ez1 = CAD_Store.Read(v1, 2)
        IfCondition EqualTo(CAD_Num.IsEqual(ez0, ez1, 0), 0) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        ez = ez0
        // classify top or bottom
        on_top = CAD_Num.IsEqual(ez, zmax, 0)
        on_bot = CAD_Num.IsEqual(ez, zmin, 0)
        IfCondition EqualTo(on_top, 0) ThenBlock: {
            IfCondition EqualTo(on_bot, 0) ThenBlock: {
                Deallocate(mn, 32)
                Deallocate(mx, 32)
                ReturnValue(0)
            }
        }
        // extents
        dxw = Float_Sub(xmax, xmin)
        dyw = Float_Sub(ymax, ymin)
        dzw = Float_Sub(zmax, zmin)
        IfCondition EqualTo(Float_Le(dxw, D), 1) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        IfCondition EqualTo(Float_Le(dyw, D), 1) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        IfCondition EqualTo(Float_Le(dzw, D), 1) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        along_x = CAD_Num.IsEqual(ey0, ey1, 0)
        along_y = CAD_Num.IsEqual(ex0, ex1, 0)
        IfCondition EqualTo(along_x, 0) ThenBlock: {
            IfCondition EqualTo(along_y, 0) ThenBlock: {
                Deallocate(mn, 32)
                Deallocate(mx, 32)
                ReturnValue(0)
            }
        }
        // full span check
        IfCondition EqualTo(along_x, 1) ThenBlock: {
            xlo = ex0
            xhi = ex1
            IfCondition EqualTo(Float_Le(xhi, xlo), 1) ThenBlock: {
                xlo = ex1
                xhi = ex0
            }
            IfCondition EqualTo(CAD_Num.IsEqual(xlo, xmin, 0), 0) ThenBlock: {
                Deallocate(mn, 32)
                Deallocate(mx, 32)
                ReturnValue(0)
            }
            IfCondition EqualTo(CAD_Num.IsEqual(xhi, xmax, 0), 0) ThenBlock: {
                Deallocate(mn, 32)
                Deallocate(mx, 32)
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(along_y, 1) ThenBlock: {
            ylo = ey0
            yhi = ey1
            IfCondition EqualTo(Float_Le(yhi, ylo), 1) ThenBlock: {
                ylo = ey1
                yhi = ey0
            }
            IfCondition EqualTo(CAD_Num.IsEqual(ylo, ymin, 0), 0) ThenBlock: {
                Deallocate(mn, 32)
                Deallocate(mx, 32)
                ReturnValue(0)
            }
            IfCondition EqualTo(CAD_Num.IsEqual(yhi, ymax, 0), 0) ThenBlock: {
                Deallocate(mn, 32)
                Deallocate(mx, 32)
                ReturnValue(0)
            }
        }
        // 5-gon profile then extrude; remap axes so extrusion aligns with edge
        prof = Allocate(160)
        out = Allocate(16)
        h = 0
        // --- along X (fixed Y) : profile in (Y,Z), extrude length = dx ---
        IfCondition EqualTo(along_x, 1) ThenBlock: {
            ey = ey0
            // top front y=ymin
            IfCondition EqualTo(on_top, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ey, ymin, 0), 1) ThenBlock: {
                    // YZ: (ymin,zmin)(ymax,zmin)(ymax,zmax)(ymin+D,zmax)(ymin,zmax-D)
                    ArraySet(prof, 0, ymin)
                    ArraySet(prof, 1, zmin)
                    ArraySet(prof, 2, ymax)
                    ArraySet(prof, 3, zmin)
                    ArraySet(prof, 4, ymax)
                    ArraySet(prof, 5, zmax)
                    ArraySet(prof, 6, Float_Add(ymin, D))
                    ArraySet(prof, 7, zmax)
                    ArraySet(prof, 8, ymin)
                    ArraySet(prof, 9, Float_Sub(zmax, D))
                    h = CAD_Topo.MakePolyPrism(prof, 5, dxw, out)
                    // remap (x,y,z)_w = (z_out+xmin, x_out, y_out)
                    IfCondition NotEqual(h, 0) ThenBlock: {
                        CAD_Blend.RemapPrismYZ_to_X(h, xmin)
                    }
                }
                IfCondition EqualTo(CAD_Num.IsEqual(ey, ymax, 0), 1) ThenBlock: {
                    ArraySet(prof, 0, ymin)
                    ArraySet(prof, 1, zmin)
                    ArraySet(prof, 2, ymax)
                    ArraySet(prof, 3, zmin)
                    ArraySet(prof, 4, ymax)
                    ArraySet(prof, 5, Float_Sub(zmax, D))
                    ArraySet(prof, 6, Float_Sub(ymax, D))
                    ArraySet(prof, 7, zmax)
                    ArraySet(prof, 8, ymin)
                    ArraySet(prof, 9, zmax)
                    h = CAD_Topo.MakePolyPrism(prof, 5, dxw, out)
                    IfCondition NotEqual(h, 0) ThenBlock: {
                        CAD_Blend.RemapPrismYZ_to_X(h, xmin)
                    }
                }
            }
            IfCondition EqualTo(on_bot, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ey, ymin, 0), 1) ThenBlock: {
                    ArraySet(prof, 0, ymin)
                    ArraySet(prof, 1, Float_Add(zmin, D))
                    ArraySet(prof, 2, Float_Add(ymin, D))
                    ArraySet(prof, 3, zmin)
                    ArraySet(prof, 4, ymax)
                    ArraySet(prof, 5, zmin)
                    ArraySet(prof, 6, ymax)
                    ArraySet(prof, 7, zmax)
                    ArraySet(prof, 8, ymin)
                    ArraySet(prof, 9, zmax)
                    h = CAD_Topo.MakePolyPrism(prof, 5, dxw, out)
                    IfCondition NotEqual(h, 0) ThenBlock: {
                        CAD_Blend.RemapPrismYZ_to_X(h, xmin)
                    }
                }
                IfCondition EqualTo(CAD_Num.IsEqual(ey, ymax, 0), 1) ThenBlock: {
                    ArraySet(prof, 0, ymin)
                    ArraySet(prof, 1, zmin)
                    ArraySet(prof, 2, Float_Sub(ymax, D))
                    ArraySet(prof, 3, zmin)
                    ArraySet(prof, 4, ymax)
                    ArraySet(prof, 5, Float_Add(zmin, D))
                    ArraySet(prof, 6, ymax)
                    ArraySet(prof, 7, zmax)
                    ArraySet(prof, 8, ymin)
                    ArraySet(prof, 9, zmax)
                    h = CAD_Topo.MakePolyPrism(prof, 5, dxw, out)
                    IfCondition NotEqual(h, 0) ThenBlock: {
                        CAD_Blend.RemapPrismYZ_to_X(h, xmin)
                    }
                }
            }
        }
        // --- along Y (fixed X): profile in (X,Z), extrude length = dy ---
        IfCondition EqualTo(along_y, 1) ThenBlock: {
            ex = ex0
            IfCondition EqualTo(on_top, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ex, xmin, 0), 1) ThenBlock: {
                    ArraySet(prof, 0, xmin)
                    ArraySet(prof, 1, zmin)
                    ArraySet(prof, 2, xmax)
                    ArraySet(prof, 3, zmin)
                    ArraySet(prof, 4, xmax)
                    ArraySet(prof, 5, zmax)
                    ArraySet(prof, 6, Float_Add(xmin, D))
                    ArraySet(prof, 7, zmax)
                    ArraySet(prof, 8, xmin)
                    ArraySet(prof, 9, Float_Sub(zmax, D))
                    h = CAD_Topo.MakePolyPrism(prof, 5, dyw, out)
                    IfCondition NotEqual(h, 0) ThenBlock: {
                        CAD_Blend.RemapPrismXZ_to_Y(h, ymin)
                    }
                }
                IfCondition EqualTo(CAD_Num.IsEqual(ex, xmax, 0), 1) ThenBlock: {
                    ArraySet(prof, 0, xmin)
                    ArraySet(prof, 1, zmin)
                    ArraySet(prof, 2, xmax)
                    ArraySet(prof, 3, zmin)
                    ArraySet(prof, 4, xmax)
                    ArraySet(prof, 5, Float_Sub(zmax, D))
                    ArraySet(prof, 6, Float_Sub(xmax, D))
                    ArraySet(prof, 7, zmax)
                    ArraySet(prof, 8, xmin)
                    ArraySet(prof, 9, zmax)
                    h = CAD_Topo.MakePolyPrism(prof, 5, dyw, out)
                    IfCondition NotEqual(h, 0) ThenBlock: {
                        CAD_Blend.RemapPrismXZ_to_Y(h, ymin)
                    }
                }
            }
            IfCondition EqualTo(on_bot, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ex, xmin, 0), 1) ThenBlock: {
                    ArraySet(prof, 0, xmin)
                    ArraySet(prof, 1, Float_Add(zmin, D))
                    ArraySet(prof, 2, Float_Add(xmin, D))
                    ArraySet(prof, 3, zmin)
                    ArraySet(prof, 4, xmax)
                    ArraySet(prof, 5, zmin)
                    ArraySet(prof, 6, xmax)
                    ArraySet(prof, 7, zmax)
                    ArraySet(prof, 8, xmin)
                    ArraySet(prof, 9, zmax)
                    h = CAD_Topo.MakePolyPrism(prof, 5, dyw, out)
                    IfCondition NotEqual(h, 0) ThenBlock: {
                        CAD_Blend.RemapPrismXZ_to_Y(h, ymin)
                    }
                }
                IfCondition EqualTo(CAD_Num.IsEqual(ex, xmax, 0), 1) ThenBlock: {
                    ArraySet(prof, 0, xmin)
                    ArraySet(prof, 1, zmin)
                    ArraySet(prof, 2, Float_Sub(xmax, D))
                    ArraySet(prof, 3, zmin)
                    ArraySet(prof, 4, xmax)
                    ArraySet(prof, 5, Float_Add(zmin, D))
                    ArraySet(prof, 6, xmax)
                    ArraySet(prof, 7, zmax)
                    ArraySet(prof, 8, xmin)
                    ArraySet(prof, 9, zmax)
                    h = CAD_Topo.MakePolyPrism(prof, 5, dyw, out)
                    IfCondition NotEqual(h, 0) ThenBlock: {
                        CAD_Blend.RemapPrismXZ_to_Y(h, ymin)
                    }
                }
            }
        }
        Deallocate(prof, 160)
        Deallocate(out, 16)
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.RebuildKind0Planes(h)
        CAD_Blend_State.chamfers_created = Add(CAD_Blend_State.chamfers_created, 1)
        ReturnValue(h)
    }
}

// After MakePolyPrism of YZ profile extruded in Z: (x,y,z)=(Y,Z,Xloc) → world (Xloc+ox, Y, Z)
// Each vertex remapped once (dedup by handle).
Function.CAD_Blend.RemapPrismYZ_to_X {
    Input: solid_handle: Integer
    Input: ox_r: Integer
    Output: Integer
    Body: {
        seen = Allocate(1024)
        ns = 0
        shell = CAD_Store.Read(solid_handle, 0)
        face = CAD_Store.Read(shell, 0)
        fguard = 0
        WhileLoop NotEqual(face, 0) {
            lp = CAD_Store.Read(face, 1)
            hd = CAD_Store.Read(lp, 0)
            ce = hd
            cdone = 0
            cguard = 0
            WhileLoop EqualTo(cdone, 0) {
                ov = CAD_Store.Read(ce, 5)
                found = 0
                k = 0
                WhileLoop LessThan(k, ns) {
                    IfCondition EqualTo(ArrayGet(seen, k), ov) ThenBlock: { found = 1 }
                    k = Add(k, 1)
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    IfCondition LessThan(ns, 128) ThenBlock: {
                        ArraySet(seen, ns, ov)
                        ns = Add(ns, 1)
                        xo = CAD_Store.Read(ov, 0)
                        yo = CAD_Store.Read(ov, 1)
                        zo = CAD_Store.Read(ov, 2)
                        CAD_Store.Write(ov, 0, Float_Add(zo, ox_r))
                        CAD_Store.Write(ov, 1, xo)
                        CAD_Store.Write(ov, 2, yo)
                    }
                }
                ce = CAD_Store.Read(ce, 2)
                cguard = Add(cguard, 1)
                IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                IfCondition GreaterThan(cguard, 64) ThenBlock: { cdone = 1 }
            }
            face = CAD_Store.Read(face, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 64) ThenBlock: { face = 0 }
        }
        Deallocate(seen, 1024)
        ReturnValue(0)
    }
}

// After MakePolyPrism of XZ profile extruded in Z: (x,y,z)=(X,Z,Yloc) → world (X, Yloc+oy, Z)
Function.CAD_Blend.RemapPrismXZ_to_Y {
    Input: solid_handle: Integer
    Input: oy_r: Integer
    Output: Integer
    Body: {
        seen = Allocate(1024)
        ns = 0
        shell = CAD_Store.Read(solid_handle, 0)
        face = CAD_Store.Read(shell, 0)
        fguard = 0
        WhileLoop NotEqual(face, 0) {
            lp = CAD_Store.Read(face, 1)
            hd = CAD_Store.Read(lp, 0)
            ce = hd
            cdone = 0
            cguard = 0
            WhileLoop EqualTo(cdone, 0) {
                ov = CAD_Store.Read(ce, 5)
                found = 0
                k = 0
                WhileLoop LessThan(k, ns) {
                    IfCondition EqualTo(ArrayGet(seen, k), ov) ThenBlock: { found = 1 }
                    k = Add(k, 1)
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    IfCondition LessThan(ns, 128) ThenBlock: {
                        ArraySet(seen, ns, ov)
                        ns = Add(ns, 1)
                        xo = CAD_Store.Read(ov, 0)
                        yo = CAD_Store.Read(ov, 1)
                        zo = CAD_Store.Read(ov, 2)
                        CAD_Store.Write(ov, 0, xo)
                        CAD_Store.Write(ov, 1, Float_Add(zo, oy_r))
                        CAD_Store.Write(ov, 2, yo)
                    }
                }
                ce = CAD_Store.Read(ce, 2)
                cguard = Add(cguard, 1)
                IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                IfCondition GreaterThan(cguard, 64) ThenBlock: { cdone = 1 }
            }
            face = CAD_Store.Read(face, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 64) ThenBlock: { face = 0 }
        }
        Deallocate(seen, 1024)
        ReturnValue(0)
    }
}

// Multi-edge vertical chamfer: cut several corners on one prism base in one rebuild.
// edges_addr[0..n_edges-1] must be full-height vertical edges; equal setback D.
Function.CAD_Blend.ChamferEdges {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: distance_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_edges, 32) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(distance_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(solid_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        D = distance_r
        xy = Allocate(1024)
        zpack = Allocate(32)
        n = CAD_Topo.ExtractBottomLoopXY(solid_handle, xy, zpack)
        IfCondition LessThan(n, 3) ThenBlock: {
            Deallocate(xy, 1024)
            Deallocate(zpack, 32)
            ReturnValue(0)
        }
        zmin = ArrayGet(zpack, 0)
        zmax = ArrayGet(zpack, 1)
        hgt = Float_Sub(zmax, zmin)
        IfCondition EqualTo(CAD_Num.IsZero(hgt, 0), 1) ThenBlock: {
            Deallocate(xy, 1024)
            Deallocate(zpack, 32)
            ReturnValue(0)
        }
        // mark[i]=1 if base vertex i is chamfered
        mark = Allocate(512)
        i = 0
        WhileLoop LessThan(i, n) {
            ArraySet(mark, i, 0)
            i = Add(i, 1)
        }
        ei = 0
        WhileLoop LessThan(ei, n_edges) {
            eh = ArrayGet(edges_addr, ei)
            IfCondition EqualTo(eh, 0) ThenBlock: {
                Deallocate(xy, 1024)
                Deallocate(zpack, 32)
                Deallocate(mark, 512)
                ReturnValue(0)
            }
            v0 = CAD_Store.Read(eh, 0)
            v1 = CAD_Store.Read(eh, 1)
            x0 = CAD_Store.Read(v0, 0)
            y0 = CAD_Store.Read(v0, 1)
            z0 = CAD_Store.Read(v0, 2)
            x1 = CAD_Store.Read(v1, 0)
            y1 = CAD_Store.Read(v1, 1)
            z1 = CAD_Store.Read(v1, 2)
            // vertical: same XY
            IfCondition EqualTo(CAD_Num.IsEqual(x0, x1, 0), 0) ThenBlock: {
                Deallocate(xy, 1024)
                Deallocate(zpack, 32)
                Deallocate(mark, 512)
                ReturnValue(0)
            }
            IfCondition EqualTo(CAD_Num.IsEqual(y0, y1, 0), 0) ThenBlock: {
                Deallocate(xy, 1024)
                Deallocate(zpack, 32)
                Deallocate(mark, 512)
                ReturnValue(0)
            }
            // full height: endpoints at zmin and zmax
            zlo = z0
            zhi = z1
            IfCondition EqualTo(Float_Le(zhi, zlo), 1) ThenBlock: {
                zlo = z1
                zhi = z0
            }
            IfCondition EqualTo(CAD_Num.IsEqual(zlo, zmin, 0), 0) ThenBlock: {
                Deallocate(xy, 1024)
                Deallocate(zpack, 32)
                Deallocate(mark, 512)
                ReturnValue(0)
            }
            IfCondition EqualTo(CAD_Num.IsEqual(zhi, zmax, 0), 0) ThenBlock: {
                Deallocate(xy, 1024)
                Deallocate(zpack, 32)
                Deallocate(mark, 512)
                ReturnValue(0)
            }
            // match base vertex
            found = -1
            i = 0
            WhileLoop LessThan(i, n) {
                px = ArrayGet(xy, Multiply(i, 2))
                py = ArrayGet(xy, Add(Multiply(i, 2), 1))
                IfCondition EqualTo(CAD_Num.IsEqual(px, x0, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(py, y0, 0), 1) ThenBlock: {
                        found = i
                    }
                }
                i = Add(i, 1)
            }
            IfCondition LessThan(found, 0) ThenBlock: {
                Deallocate(xy, 1024)
                Deallocate(zpack, 32)
                Deallocate(mark, 512)
                ReturnValue(0)
            }
            IfCondition EqualTo(ArrayGet(mark, found), 1) ThenBlock: {
                Deallocate(xy, 1024)
                Deallocate(zpack, 32)
                Deallocate(mark, 512)
                ReturnValue(0)
            }
            ArraySet(mark, found, 1)
            ei = Add(ei, 1)
        }
        // edge-length checks: adjacent segments must allow setbacks
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            dx = Float_Sub(ArrayGet(xy, Multiply(j, 2)), ArrayGet(xy, Multiply(i, 2)))
            dy = Float_Sub(ArrayGet(xy, Add(Multiply(j, 2), 1)), ArrayGet(xy, Add(Multiply(i, 2), 1)))
            elen = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
            need = 0
            IfCondition EqualTo(ArrayGet(mark, i), 1) ThenBlock: { need = Float_Add(need, D) }
            IfCondition EqualTo(ArrayGet(mark, j), 1) ThenBlock: { need = Float_Add(need, D) }
            // require elen > need (equal setbacks cannot meet mid-edge)
            IfCondition EqualTo(Float_Le(elen, need), 1) ThenBlock: {
                Deallocate(xy, 1024)
                Deallocate(zpack, 32)
                Deallocate(mark, 512)
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        // build new polygon: each marked vertex → two points A,B along adjacent edges
        nxy = Allocate(2048)
        nn = 0
        i = 0
        WhileLoop LessThan(i, n) {
            px = ArrayGet(xy, Multiply(i, 2))
            py = ArrayGet(xy, Add(Multiply(i, 2), 1))
            IfCondition EqualTo(ArrayGet(mark, i), 0) ThenBlock: {
                ArraySet(nxy, Multiply(nn, 2), px)
                ArraySet(nxy, Add(Multiply(nn, 2), 1), py)
                nn = Add(nn, 1)
            }
            IfCondition EqualTo(ArrayGet(mark, i), 1) ThenBlock: {
                ip = Subtract(i, 1)
                IfCondition LessThan(ip, 0) ThenBlock: { ip = Subtract(n, 1) }
                inx = Add(i, 1)
                IfCondition EqualTo(inx, n) ThenBlock: { inx = 0 }
                ppx = ArrayGet(xy, Multiply(ip, 2))
                ppy = ArrayGet(xy, Add(Multiply(ip, 2), 1))
                nx = ArrayGet(xy, Multiply(inx, 2))
                ny = ArrayGet(xy, Add(Multiply(inx, 2), 1))
                // A = P + D * unit(prev - P)
                dax = Float_Sub(ppx, px)
                day = Float_Sub(ppy, py)
                la = CAD_Num.Sqrt(Float_Add(Float_Mul(dax, dax), Float_Mul(day, day)))
                IfCondition EqualTo(CAD_Num.IsZero(la, 0), 1) ThenBlock: {
                    Deallocate(xy, 1024)
                    Deallocate(zpack, 32)
                    Deallocate(mark, 512)
                    Deallocate(nxy, 2048)
                    ReturnValue(0)
                }
                ax = Float_Add(px, Float_Mul(D, Float_Div(dax, la)))
                ay = Float_Add(py, Float_Mul(D, Float_Div(day, la)))
                // B = P + D * unit(next - P)
                dbx = Float_Sub(nx, px)
                dby = Float_Sub(ny, py)
                lb = CAD_Num.Sqrt(Float_Add(Float_Mul(dbx, dbx), Float_Mul(dby, dby)))
                IfCondition EqualTo(CAD_Num.IsZero(lb, 0), 1) ThenBlock: {
                    Deallocate(xy, 1024)
                    Deallocate(zpack, 32)
                    Deallocate(mark, 512)
                    Deallocate(nxy, 2048)
                    ReturnValue(0)
                }
                bx = Float_Add(px, Float_Mul(D, Float_Div(dbx, lb)))
                by = Float_Add(py, Float_Mul(D, Float_Div(dby, lb)))
                ArraySet(nxy, Multiply(nn, 2), ax)
                ArraySet(nxy, Add(Multiply(nn, 2), 1), ay)
                nn = Add(nn, 1)
                ArraySet(nxy, Multiply(nn, 2), bx)
                ArraySet(nxy, Add(Multiply(nn, 2), 1), by)
                nn = Add(nn, 1)
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(nn, 3) ThenBlock: {
            Deallocate(xy, 1024)
            Deallocate(zpack, 32)
            Deallocate(mark, 512)
            Deallocate(nxy, 2048)
            ReturnValue(0)
        }
        IfCondition GreaterThan(nn, 64) ThenBlock: {
            Deallocate(xy, 1024)
            Deallocate(zpack, 32)
            Deallocate(mark, 512)
            Deallocate(nxy, 2048)
            ReturnValue(0)
        }
        out = Allocate(16)
        h = CAD_Topo.MakePolyPrism(nxy, nn, hgt, out)
        Deallocate(out, 16)
        Deallocate(xy, 1024)
        Deallocate(zpack, 32)
        Deallocate(mark, 512)
        Deallocate(nxy, 2048)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(zmin, 0), 0) ThenBlock: {
            dlt = Allocate(32)
            ArraySet(dlt, 0, 0)
            ArraySet(dlt, 1, 0)
            ArraySet(dlt, 2, zmin)
            CAD_Topo.TranslateSolid(h, dlt)
            Deallocate(dlt, 32)
        }
        CAD_Blend_State.chamfers_created = Add(CAD_Blend_State.chamfers_created, n_edges)
        ReturnValue(h)
    }
}

// Chamfer API (angle unused = equal setback 45°).
Function.CAD_Blend.AddChamfer {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: distance_r: Integer
    Input: angle_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Blend.ChamferEdge(solid_handle, edge_handle, distance_r))
    }
}
