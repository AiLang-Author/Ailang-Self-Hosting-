// CAD Kernel — CAD.Blend — Edge fillet / chamfer (real geometry, no silent fakes)
//
// ARCHITECTURE (locked): general edge blend, NOT shape recipes.
//   FilletEdge(solid, edge, R) — resolve 2 faces → offset → isect spine → blend face
// Domain grows by surface pair: plane–plane → plane–cyl → plane–cone → …
// MakeBoxVerticalFillets / FilletBoxVertical = DEMO DEBT only (delete when FilletEdge covers it).

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Isect
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Offset

FixedPool.CAD_Blend_State {
    "fillets_created":  Initialize=0
    "chamfers_created": Initialize=0
    "blend_surfaces":   Initialize=0
}

// Rolling-ball center frame for two planes meeting at right angle (unit normals).
// f1/f2: plane frames O,X,Y,Z (12 words, Z = unit normal). radius R.
// out: [cx,cy,cz, nx,ny,nz] cylinder axis point + axis dir (edge direction).
// Returns 0 ok, -1 fail. Restricted: |N1·N2|≈0 (orthogonal planes).
Function.CAD_Blend.ComputeRollingBall {
    Input: f1_addr: Address
    Input: f2_addr: Address
    Input: radius_r: Integer
    Input: out_blend_frame_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(f1_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(f2_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(-1) }
        n1x = ArrayGet(f1_addr, 9)
        n1y = ArrayGet(f1_addr, 10)
        n1z = ArrayGet(f1_addr, 11)
        n2x = ArrayGet(f2_addr, 9)
        n2y = ArrayGet(f2_addr, 10)
        n2z = ArrayGet(f2_addr, 11)
        // require roughly orthogonal
        dot = Float_Add(Float_Add(Float_Mul(n1x, n2x), Float_Mul(n1y, n2y)), Float_Mul(n1z, n2z))
        IfCondition EqualTo(CAD_Num.IsZero(dot, 0), 0) ThenBlock: {
            // allow small; if |dot| large fail
            ad = dot
            IfCondition EqualTo(Float_Le(ad, 0), 1) ThenBlock: { ad = Float_Sub(0, ad) }
            // 0.1 rad ~ cos large — fail if |dot| > 0.2
            IfCondition EqualTo(Float_Le(0x3FC999999999999A, ad), 1) ThenBlock: {
                ReturnValue(-1)
            }
        }
        o1x = ArrayGet(f1_addr, 0)
        o1y = ArrayGet(f1_addr, 1)
        o1z = ArrayGet(f1_addr, 2)
        // center = O1 + R*N1 + R*N2 (for planes through O with outward normals into material
        // for convex edge fillet from outside: C = O + R*(N1+N2)/|…| for unit orthogonal N1+N2)
        // orthogonal unit: |N1+N2|=sqrt(2), unit bisector (N1+N2)/sqrt2, C = vertex + R*(N1+N2)
        // For axis-aligned box faces, vertex at O1 projected: use O1 + R*N1 + R*N2
        cx = Float_Add(o1x, Float_Add(Float_Mul(radius_r, n1x), Float_Mul(radius_r, n2x)))
        cy = Float_Add(o1y, Float_Add(Float_Mul(radius_r, n1y), Float_Mul(radius_r, n2y)))
        cz = Float_Add(o1z, Float_Add(Float_Mul(radius_r, n1z), Float_Mul(radius_r, n2z)))
        // edge direction = N1 × N2
        ex = Float_Sub(Float_Mul(n1y, n2z), Float_Mul(n1z, n2y))
        ey = Float_Sub(Float_Mul(n1z, n2x), Float_Mul(n1x, n2z))
        ez = Float_Sub(Float_Mul(n1x, n2y), Float_Mul(n1y, n2x))
        el = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ex, ex), Float_Mul(ey, ey)), Float_Mul(ez, ez)))
        IfCondition EqualTo(CAD_Num.IsZero(el, 0), 1) ThenBlock: { ReturnValue(-1) }
        ArraySet(out_blend_frame_addr, 0, cx)
        ArraySet(out_blend_frame_addr, 1, cy)
        ArraySet(out_blend_frame_addr, 2, cz)
        ArraySet(out_blend_frame_addr, 3, Float_Div(ex, el))
        ArraySet(out_blend_frame_addr, 4, Float_Div(ey, el))
        ArraySet(out_blend_frame_addr, 5, Float_Div(ez, el))
        ArraySet(out_blend_frame_addr, 6, radius_r)
        CAD_Blend_State.blend_surfaces = Add(CAD_Blend_State.blend_surfaces, 1)
        ReturnValue(0)
    }
}

// Constant-R fillet on all vertical edges of a kind-0 box (AABB).
// pack unused edge_handle: pass 0. Rebuilds rounded solid; does not edit in place.
// Returns new solid handle or 0 on fail (never empty fake solid).
Function.CAD_Blend.FilletBoxVertical {
    Input: solid_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(solid_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        mn = Allocate(32)
        mx = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(solid_handle, mn, mx), 1) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        dx = Float_Sub(ArrayGet(mx, 0), ArrayGet(mn, 0))
        dy = Float_Sub(ArrayGet(mx, 1), ArrayGet(mn, 1))
        dz = Float_Sub(ArrayGet(mx, 2), ArrayGet(mn, 2))
        pack = Allocate(64)
        ArraySet(pack, 0, dx)
        ArraySet(pack, 1, dy)
        ArraySet(pack, 2, dz)
        ArraySet(pack, 3, radius_r)
        out = Allocate(16)
        h = CAD_Topo.MakeBoxVerticalFilletsSolid(pack, out)
        Deallocate(pack, 64)
        Deallocate(out, 16)
        IfCondition NotEqual(h, 0) ThenBlock: {
            dlt = Allocate(32)
            ArraySet(dlt, 0, ArrayGet(mn, 0))
            ArraySet(dlt, 1, ArrayGet(mn, 1))
            ArraySet(dlt, 2, ArrayGet(mn, 2))
            CAD_Topo.TranslateSolid(h, dlt)
            Deallocate(dlt, 32)
            CAD_Blend_State.fillets_created = Add(CAD_Blend_State.fillets_created, 1)
        }
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        ReturnValue(h)
    }
}

// AddFillet: restricted — kind-0 box only → FilletBoxVertical (all 4 vertical edges).
// edge_handle ignored for now. Returns 0 if unsupported (no empty solid).
Function.CAD_Blend.AddFillet {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Blend.FilletBoxVertical(solid_handle, radius_r))
    }
}

// Variable fillet: not implemented — refuse (no fake solid).
Function.CAD_Blend.AddVariableFillet {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: r_start_r: Integer
    Input: r_end_r: Integer
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

// Chamfer: not implemented yet — refuse.
Function.CAD_Blend.AddChamfer {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: distance_r: Integer
    Input: angle_r: Integer
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}
