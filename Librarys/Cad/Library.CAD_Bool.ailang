// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 5: CAD.Bool — Solid Boolean Operations, Classification & B-Rep Stitching (§7.3)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Isect

FixedPool.CAD_Bool_State {
    "bool_count":       Initialize=0
    "classified_faces": Initialize=0
}

// -------------------------------------------------------------------------
// 1. Point/Face Point-in-Solid Classification
// Returns: 1=INSIDE, 2=OUTSIDE, 3=ON_BOUNDARY
// -------------------------------------------------------------------------

// Classify point vs solid. 1=INSIDE 2=OUTSIDE 3=ON_BOUNDARY -1=bad.
// Restricted: kind0 AABB; kind1/2 cyl; kind4 sphere; kind3 plate + Z-hole voids.
Function.CAD_Bool.ClassifyPoint {
    Input: p_addr: Address
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(p_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        px = ArrayGet(p_addr, 0)
        py = ArrayGet(p_addr, 1)
        pz = ArrayGet(p_addr, 2)
        kind = CAD_Store.Read(solid_handle, 3)
        CAD_Bool_State.classified_faces = Add(CAD_Bool_State.classified_faces, 1)

        // kind 0: AABB of shell
        IfCondition EqualTo(kind, 0) ThenBlock: {
            mn = Allocate(32)
            mx = Allocate(32)
            IfCondition NotEqual(CAD_Bool.SolidAABB(solid_handle, mn, mx), 1) ThenBlock: {
                Deallocate(mn, 32)
                Deallocate(mx, 32)
                ReturnValue(-1)
            }
            rc = CAD_Bool.ClassifyPointAABB(p_addr, mn, mx)
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(rc)
        }
        // kind 3: plate params AABB, then subtract Z-axis hole cylinders
        IfCondition EqualTo(kind, 3) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            IfCondition EqualTo(ph, 0) ThenBlock: { ReturnValue(-1) }
            dx = CAD_Store.Read(ph, 0)
            dy = CAD_Store.Read(ph, 1)
            dz = CAD_Store.Read(ph, 2)
            ox = CAD_Store.Read(ph, 6)
            oy = CAD_Store.Read(ph, 7)
            oz = CAD_Store.Read(solid_handle, 2)
            mn = Allocate(32)
            mx = Allocate(32)
            ArraySet(mn, 0, ox)
            ArraySet(mn, 1, oy)
            ArraySet(mn, 2, oz)
            ArraySet(mx, 0, Float_Add(ox, dx))
            ArraySet(mx, 1, Float_Add(oy, dy))
            ArraySet(mx, 2, Float_Add(oz, dz))
            rc = CAD_Bool.ClassifyPointAABB(p_addr, mn, mx)
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            IfCondition EqualTo(rc, 2) ThenBlock: { ReturnValue(2) }
            // if outside plate already done; if in/on, check holes (void → outside)
            nh = CAD_Store.Read(ph, 9)
            IfCondition EqualTo(nh, 0) ThenBlock: { nh = 1 }
            hi = 0
            WhileLoop LessThan(hi, nh) {
                IfCondition EqualTo(hi, 0) ThenBlock: {
                    hr = CAD_Store.Read(ph, 3)
                    hcx = CAD_Store.Read(ph, 4)
                    hcy = CAD_Store.Read(ph, 5)
                    hdep = CAD_Store.Read(ph, 8)
                }
                IfCondition GreaterThan(hi, 0) ThenBlock: {
                    base = Add(10, Multiply(Subtract(hi, 1), 4))
                    hr = CAD_Store.Read(ph, base)
                    hcx = CAD_Store.Read(ph, Add(base, 1))
                    hcy = CAD_Store.Read(ph, Add(base, 2))
                    hdep = CAD_Store.Read(ph, Add(base, 3))
                }
                IfCondition EqualTo(CAD_Num.IsZero(hdep, 0), 1) ThenBlock: { hdep = dz }
                IfCondition EqualTo(Float_Le(dz, hdep), 1) ThenBlock: { hdep = dz }
                // hole world center XY; void from z_top-depth to z_top
                wx = Float_Add(ox, hcx)
                wy = Float_Add(oy, hcy)
                z_top = Float_Add(oz, dz)
                z_bot = Float_Sub(z_top, hdep)
                dxp = Float_Sub(px, wx)
                dyp = Float_Sub(py, wy)
                rho2 = Float_Add(Float_Mul(dxp, dxp), Float_Mul(dyp, dyp))
                r2 = Float_Mul(hr, hr)
                // strictly inside hole disk and within hole Z → outside solid
                inz = 1
                IfCondition EqualTo(Float_Le(pz, z_bot), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(pz, z_bot, 0), 0) ThenBlock: { inz = 0 }
                }
                IfCondition EqualTo(Float_Le(z_top, pz), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(pz, z_top, 0), 0) ThenBlock: { inz = 0 }
                }
                IfCondition EqualTo(inz, 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(r2, rho2), 0) ThenBlock: {
                        // rho < r : interior of hole
                        IfCondition EqualTo(CAD_Num.IsEqual(rho2, r2, 0), 0) ThenBlock: {
                            ReturnValue(2)
                        }
                        // on cylindrical wall
                        ReturnValue(3)
                    }
                    IfCondition EqualTo(CAD_Num.IsEqual(rho2, r2, 0), 1) ThenBlock: {
                        ReturnValue(3)
                    }
                }
                hi = Add(hi, 1)
            }
            ReturnValue(rc)
        }
        // kind 1/2: right cylinder // +Z, base (ox,oy,oz), r, h
        IfCondition EqualTo(kind, 1) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            r = CAD_Store.Read(ph, 0)
            h = CAD_Store.Read(ph, 1)
            ox = CAD_Store.Read(ph, 2)
            oy = CAD_Store.Read(ph, 3)
            oz = CAD_Store.Read(ph, 4)
            dzp = Float_Sub(pz, oz)
            IfCondition EqualTo(Float_Le(dzp, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(dzp, 0), 1) ThenBlock: {
                    // on bottom plane — check disk
                }
                IfCondition EqualTo(CAD_Num.IsZero(dzp, 0), 0) ThenBlock: { ReturnValue(2) }
            }
            IfCondition EqualTo(Float_Le(h, dzp), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(dzp, h, 0), 0) ThenBlock: { ReturnValue(2) }
            }
            dxp = Float_Sub(px, ox)
            dyp = Float_Sub(py, oy)
            rho2 = Float_Add(Float_Mul(dxp, dxp), Float_Mul(dyp, dyp))
            r2 = Float_Mul(r, r)
            IfCondition EqualTo(Float_Le(r2, rho2), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(rho2, r2, 0), 1) ThenBlock: { ReturnValue(3) }
                ReturnValue(2)
            }
            // inside radial disk
            IfCondition EqualTo(CAD_Num.IsZero(dzp, 0), 1) ThenBlock: { ReturnValue(3) }
            IfCondition EqualTo(CAD_Num.IsEqual(dzp, h, 0), 1) ThenBlock: { ReturnValue(3) }
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            // same as kind 1
            ph = CAD_Store.Read(solid_handle, 1)
            r = CAD_Store.Read(ph, 0)
            h = CAD_Store.Read(ph, 1)
            ox = CAD_Store.Read(ph, 2)
            oy = CAD_Store.Read(ph, 3)
            oz = CAD_Store.Read(ph, 4)
            dzp = Float_Sub(pz, oz)
            IfCondition EqualTo(Float_Le(dzp, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(dzp, 0), 0) ThenBlock: { ReturnValue(2) }
            }
            IfCondition EqualTo(Float_Le(h, dzp), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(dzp, h, 0), 0) ThenBlock: { ReturnValue(2) }
            }
            dxp = Float_Sub(px, ox)
            dyp = Float_Sub(py, oy)
            rho2 = Float_Add(Float_Mul(dxp, dxp), Float_Mul(dyp, dyp))
            r2 = Float_Mul(r, r)
            IfCondition EqualTo(Float_Le(r2, rho2), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(rho2, r2, 0), 1) ThenBlock: { ReturnValue(3) }
                ReturnValue(2)
            }
            IfCondition EqualTo(CAD_Num.IsZero(dzp, 0), 1) ThenBlock: { ReturnValue(3) }
            IfCondition EqualTo(CAD_Num.IsEqual(dzp, h, 0), 1) ThenBlock: { ReturnValue(3) }
            ReturnValue(1)
        }
        // kind 4 sphere
        IfCondition EqualTo(kind, 4) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            r = CAD_Store.Read(ph, 0)
            cx = CAD_Store.Read(ph, 1)
            cy = CAD_Store.Read(ph, 2)
            cz = CAD_Store.Read(ph, 3)
            dxp = Float_Sub(px, cx)
            dyp = Float_Sub(py, cy)
            dzp = Float_Sub(pz, cz)
            d2 = Float_Add(Float_Add(Float_Mul(dxp, dxp), Float_Mul(dyp, dyp)), Float_Mul(dzp, dzp))
            r2 = Float_Mul(r, r)
            IfCondition EqualTo(CAD_Num.IsEqual(d2, r2, 0), 1) ThenBlock: { ReturnValue(3) }
            IfCondition EqualTo(Float_Le(r2, d2), 1) ThenBlock: { ReturnValue(2) }
            ReturnValue(1)
        }
        ReturnValue(-1)
    }
}

// Point vs AABB. min/max 3-vectors. 1 in 2 out 3 on.
Function.CAD_Bool.ClassifyPointAABB {
    Input: p_addr: Address
    Input: min_addr: Address
    Input: max_addr: Address
    Output: Integer
    Body: {
        px = ArrayGet(p_addr, 0)
        py = ArrayGet(p_addr, 1)
        pz = ArrayGet(p_addr, 2)
        x0 = ArrayGet(min_addr, 0)
        y0 = ArrayGet(min_addr, 1)
        z0 = ArrayGet(min_addr, 2)
        x1 = ArrayGet(max_addr, 0)
        y1 = ArrayGet(max_addr, 1)
        z1 = ArrayGet(max_addr, 2)
        // outside if strictly outside any slab
        IfCondition EqualTo(Float_Le(px, x0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(px, x0, 0), 0) ThenBlock: { ReturnValue(2) }
        }
        IfCondition EqualTo(Float_Le(x1, px), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(px, x1, 0), 0) ThenBlock: { ReturnValue(2) }
        }
        IfCondition EqualTo(Float_Le(py, y0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(py, y0, 0), 0) ThenBlock: { ReturnValue(2) }
        }
        IfCondition EqualTo(Float_Le(y1, py), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(py, y1, 0), 0) ThenBlock: { ReturnValue(2) }
        }
        IfCondition EqualTo(Float_Le(pz, z0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(pz, z0, 0), 0) ThenBlock: { ReturnValue(2) }
        }
        IfCondition EqualTo(Float_Le(z1, pz), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(pz, z1, 0), 0) ThenBlock: { ReturnValue(2) }
        }
        // on any face?
        on = 0
        IfCondition EqualTo(CAD_Num.IsEqual(px, x0, 0), 1) ThenBlock: { on = 1 }
        IfCondition EqualTo(CAD_Num.IsEqual(px, x1, 0), 1) ThenBlock: { on = 1 }
        IfCondition EqualTo(CAD_Num.IsEqual(py, y0, 0), 1) ThenBlock: { on = 1 }
        IfCondition EqualTo(CAD_Num.IsEqual(py, y1, 0), 1) ThenBlock: { on = 1 }
        IfCondition EqualTo(CAD_Num.IsEqual(pz, z0, 0), 1) ThenBlock: { on = 1 }
        IfCondition EqualTo(CAD_Num.IsEqual(pz, z1, 0), 1) ThenBlock: { on = 1 }
        IfCondition EqualTo(on, 1) ThenBlock: { ReturnValue(3) }
        ReturnValue(1)
    }
}

Function.CAD_Bool.ClassifyFace {
    Input: face_handle: Integer
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }

        CAD_Bool_State.classified_faces = Add(CAD_Bool_State.classified_faces, 1)
        ReturnValue(1) // INSIDE
    }
}

// -------------------------------------------------------------------------
// 2. B-Rep Shell Stitching Engine
// -------------------------------------------------------------------------

Function.CAD_Bool.StitchShells {
    Input: faces_arr_addr: Address
    Input: n_faces: Integer
    Input: out_solid_handle_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n_faces, 1) ThenBlock: { ReturnValue(-4) }

        h_solid = CAD_Store.Alloc(7, 4) // Tag 7 = Solid handle
        ArraySet(out_solid_handle_addr, 0, h_solid)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 3. CSG / Boundary Representation Solid Booleans
// -------------------------------------------------------------------------

// Union A∪B. Restricted (honest): both kind-0 boxes whose volume union is a
// single AABB (adjacent fuse, overlap, or containment). Else 0 — no empty solid.
Function.CAD_Bool.Union {
    Input: solid_a_handle: Integer
    Input: solid_b_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_a_handle, 0) ThenBlock: { ReturnValue(solid_b_handle) }
        IfCondition EqualTo(solid_b_handle, 0) ThenBlock: { ReturnValue(solid_a_handle) }
        ka = CAD_Store.Read(solid_a_handle, 3)
        kb = CAD_Store.Read(solid_b_handle, 3)
        IfCondition NotEqual(ka, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(kb, 0) ThenBlock: { ReturnValue(0) }
        mna = Allocate(32)
        mxa = Allocate(32)
        mnb = Allocate(32)
        mxb = Allocate(32)
        oka = CAD_Bool.SolidAABB(solid_a_handle, mna, mxa)
        okb = CAD_Bool.SolidAABB(solid_b_handle, mnb, mxb)
        IfCondition EqualTo(oka, 1) ThenBlock: {
            IfCondition EqualTo(okb, 1) ThenBlock: {
                ax0 = ArrayGet(mna, 0)
                ay0 = ArrayGet(mna, 1)
                az0 = ArrayGet(mna, 2)
                ax1 = ArrayGet(mxa, 0)
                ay1 = ArrayGet(mxa, 1)
                az1 = ArrayGet(mxa, 2)
                bx0 = ArrayGet(mnb, 0)
                by0 = ArrayGet(mnb, 1)
                bz0 = ArrayGet(mnb, 2)
                bx1 = ArrayGet(mxb, 0)
                by1 = ArrayGet(mxb, 1)
                bz1 = ArrayGet(mxb, 2)
                // combined AABB
                ux0 = ax0
                IfCondition EqualTo(Float_Le(bx0, ux0), 1) ThenBlock: { ux0 = bx0 }
                uy0 = ay0
                IfCondition EqualTo(Float_Le(by0, uy0), 1) ThenBlock: { uy0 = by0 }
                uz0 = az0
                IfCondition EqualTo(Float_Le(bz0, uz0), 1) ThenBlock: { uz0 = bz0 }
                ux1 = ax1
                IfCondition EqualTo(Float_Le(ux1, bx1), 1) ThenBlock: { ux1 = bx1 }
                uy1 = ay1
                IfCondition EqualTo(Float_Le(uy1, by1), 1) ThenBlock: { uy1 = by1 }
                uz1 = az1
                IfCondition EqualTo(Float_Le(uz1, bz1), 1) ThenBlock: { uz1 = bz1 }
                // volumes: Va+Vb-Vint must equal Vcombined (union is a solid box)
                dax = Float_Sub(ax1, ax0)
                day = Float_Sub(ay1, ay0)
                daz = Float_Sub(az1, az0)
                dbx = Float_Sub(bx1, bx0)
                dby = Float_Sub(by1, by0)
                dbz = Float_Sub(bz1, bz0)
                va = Float_Mul(Float_Mul(dax, day), daz)
                vb = Float_Mul(Float_Mul(dbx, dby), dbz)
                // intersection: max of mins .. min of maxs per axis
                ix0 = ax0
                IfCondition EqualTo(Float_Le(ax0, bx0), 1) ThenBlock: { ix0 = bx0 }
                iy0 = ay0
                IfCondition EqualTo(Float_Le(ay0, by0), 1) ThenBlock: { iy0 = by0 }
                iz0 = az0
                IfCondition EqualTo(Float_Le(az0, bz0), 1) ThenBlock: { iz0 = bz0 }
                ix1 = ax1
                IfCondition EqualTo(Float_Le(bx1, ax1), 1) ThenBlock: { ix1 = bx1 }
                iy1 = ay1
                IfCondition EqualTo(Float_Le(by1, ay1), 1) ThenBlock: { iy1 = by1 }
                iz1 = az1
                IfCondition EqualTo(Float_Le(bz1, az1), 1) ThenBlock: { iz1 = bz1 }
                dix = Float_Sub(ix1, ix0)
                diy = Float_Sub(iy1, iy0)
                diz = Float_Sub(iz1, iz0)
                vint = 0
                // positive intersection volume only if all axes overlap
                okint = 1
                IfCondition EqualTo(Float_Le(dix, 0), 1) ThenBlock: { okint = 0 }
                IfCondition EqualTo(Float_Le(diy, 0), 1) ThenBlock: { okint = 0 }
                IfCondition EqualTo(Float_Le(diz, 0), 1) ThenBlock: { okint = 0 }
                IfCondition EqualTo(okint, 1) ThenBlock: {
                    vint = Float_Mul(Float_Mul(dix, diy), diz)
                }
                // abutting faces: zero volume intersect but still fill AABB if face-adjacent
                // also allow zero-thickness touch: treat as vint=0, Va+Vb == Vcomb
                vcomb = Float_Mul(Float_Mul(Float_Sub(ux1, ux0), Float_Sub(uy1, uy0)), Float_Sub(uz1, uz0))
                vsum = Float_Sub(Float_Add(va, vb), vint)
                IfCondition EqualTo(CAD_Num.IsEqual(vsum, vcomb, 0), 1) ThenBlock: {
                    out = Allocate(16)
                    ArraySet(mna, 0, ux0)
                    ArraySet(mna, 1, uy0)
                    ArraySet(mna, 2, uz0)
                    ArraySet(mxa, 0, ux1)
                    ArraySet(mxa, 1, uy1)
                    ArraySet(mxa, 2, uz1)
                    h = CAD_Topo.MakeBoxSolid(mna, mxa, out)
                    Deallocate(out, 16)
                    Deallocate(mna, 32)
                    Deallocate(mxa, 32)
                    Deallocate(mnb, 32)
                    Deallocate(mxb, 32)
                    IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
                    CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                    ReturnValue(h)
                }
            }
        }
        Deallocate(mna, 32)
        Deallocate(mxa, 32)
        Deallocate(mnb, 32)
        Deallocate(mxb, 32)
        ReturnValue(0)
    }
}

// Difference A\B. Restricted domain (honest, not general OCCT):
//   A = box (kind 0) , B = cylinder (kind 1|2) → kind-3 plate with 1 hole
//   A = kind-3 plate , B = cylinder → append hole (max 5)
//   A = box (kind 0) , B = box (kind 0) → rect pocket if B cuts from top of A
// General B-Rep bool still TODO (returns 0).
Function.CAD_Bool.Difference {
    Input: solid_a_handle: Integer
    Input: solid_b_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_a_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(solid_b_handle, 0) ThenBlock: { ReturnValue(solid_a_handle) }

        ka = CAD_Store.Read(solid_a_handle, 3)
        kb = CAD_Store.Read(solid_b_handle, 3)
        is_cyl = 0
        IfCondition EqualTo(kb, 1) ThenBlock: { is_cyl = 1 }
        IfCondition EqualTo(kb, 2) ThenBlock: { is_cyl = 1 }

        // plate-with-hole(s) + another cylinder cut → append hole
        IfCondition EqualTo(ka, 3) ThenBlock: {
            IfCondition EqualTo(is_cyl, 1) ThenBlock: {
                pha = CAD_Store.Read(solid_a_handle, 1)
                phb = CAD_Store.Read(solid_b_handle, 1)
                hr = CAD_Store.Read(phb, 0)
                th = CAD_Store.Read(phb, 1)
                tox = CAD_Store.Read(phb, 2)
                toy = CAD_Store.Read(phb, 3)
                ox = CAD_Store.Read(pha, 6)
                oy = CAD_Store.Read(pha, 7)
                hcx = Float_Sub(tox, ox)
                hcy = Float_Sub(toy, oy)
                dx = CAD_Store.Read(pha, 0)
                dy = CAD_Store.Read(pha, 1)
                minxy = dx
                IfCondition EqualTo(Float_Le(dy, dx), 1) ThenBlock: { minxy = dy }
                two_r = Float_Mul(hr, 0x4000000000000000)
                IfCondition EqualTo(Float_Le(two_r, minxy), 1) ThenBlock: {
                    pack = Allocate(64)
                    ArraySet(pack, 0, hr)
                    ArraySet(pack, 1, hcx)
                    ArraySet(pack, 2, hcy)
                    ArraySet(pack, 3, th)
                    out = Allocate(16)
                    h_cut = CAD_Topo.AppendBoxHole(solid_a_handle, pack, out)
                    Deallocate(pack, 64)
                    Deallocate(out, 16)
                    IfCondition NotEqual(h_cut, 0) ThenBlock: {
                        CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                        ReturnValue(h_cut)
                    }
                }
            }
        }

        // box body (kind 0) minus cylinder tool (kind 1 or 2)
        IfCondition EqualTo(ka, 0) ThenBlock: {
            IfCondition EqualTo(is_cyl, 1) ThenBlock: {
                mn = Allocate(32)
                mx = Allocate(32)
                // AABB from topology
                shell = CAD_Store.Read(solid_a_handle, 0)
                ok = 0
                IfCondition NotEqual(shell, 0) ThenBlock: {
                    // reuse SolidAABB via manual first face verts — import IO is heavy;
                    // CreateBox always [0,dx]x[0,dy]x[0,dz]: walk verts for max
                    face = CAD_Store.Read(shell, 0)
                    IfCondition NotEqual(face, 0) ThenBlock: {
                        loop_h = CAD_Store.Read(face, 1)
                        head = CAD_Store.Read(loop_h, 0)
                        ov = CAD_Store.Read(head, 5)
                        ArraySet(mn, 0, CAD_Store.Read(ov, 0))
                        ArraySet(mn, 1, CAD_Store.Read(ov, 1))
                        ArraySet(mn, 2, CAD_Store.Read(ov, 2))
                        ArraySet(mx, 0, CAD_Store.Read(ov, 0))
                        ArraySet(mx, 1, CAD_Store.Read(ov, 1))
                        ArraySet(mx, 2, CAD_Store.Read(ov, 2))
                        // scan all faces for AABB
                        f = face
                        fguard = 0
                        WhileLoop NotEqual(f, 0) {
                            lp = CAD_Store.Read(f, 1)
                            hd = CAD_Store.Read(lp, 0)
                            ce = hd
                            cdone = 0
                            cguard = 0
                            WhileLoop EqualTo(cdone, 0) {
                                o2 = CAD_Store.Read(ce, 5)
                                px = CAD_Store.Read(o2, 0)
                                py = CAD_Store.Read(o2, 1)
                                pz = CAD_Store.Read(o2, 2)
                                IfCondition EqualTo(Float_Le(px, ArrayGet(mn, 0)), 1) ThenBlock: { ArraySet(mn, 0, px) }
                                IfCondition EqualTo(Float_Le(py, ArrayGet(mn, 1)), 1) ThenBlock: { ArraySet(mn, 1, py) }
                                IfCondition EqualTo(Float_Le(pz, ArrayGet(mn, 2)), 1) ThenBlock: { ArraySet(mn, 2, pz) }
                                IfCondition EqualTo(Float_Le(ArrayGet(mx, 0), px), 1) ThenBlock: { ArraySet(mx, 0, px) }
                                IfCondition EqualTo(Float_Le(ArrayGet(mx, 1), py), 1) ThenBlock: { ArraySet(mx, 1, py) }
                                IfCondition EqualTo(Float_Le(ArrayGet(mx, 2), pz), 1) ThenBlock: { ArraySet(mx, 2, pz) }
                                ce = CAD_Store.Read(ce, 2)
                                cguard = Add(cguard, 1)
                                IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                                IfCondition GreaterThan(cguard, 64) ThenBlock: { cdone = 1 }
                            }
                            f = CAD_Store.Read(f, 3)
                            fguard = Add(fguard, 1)
                            IfCondition GreaterThan(fguard, 64) ThenBlock: { f = 0 }
                        }
                        ok = 1
                    }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    dx = Float_Sub(ArrayGet(mx, 0), ArrayGet(mn, 0))
                    dy = Float_Sub(ArrayGet(mx, 1), ArrayGet(mn, 1))
                    dz = Float_Sub(ArrayGet(mx, 2), ArrayGet(mn, 2))
                    phb = CAD_Store.Read(solid_b_handle, 1)
                    hr = CAD_Store.Read(phb, 0)
                    // tool placement (cylinder base origin)
                    tox = CAD_Store.Read(phb, 2)
                    toy = CAD_Store.Read(phb, 3)
                    toz = CAD_Store.Read(phb, 4)
                    // hole center in plate-local coords
                    hcx = Float_Sub(tox, ArrayGet(mn, 0))
                    hcy = Float_Sub(toy, ArrayGet(mn, 1))
                    // require hole diameter < min plate side and center inside margin
                    minxy = dx
                    IfCondition EqualTo(Float_Le(dy, dx), 1) ThenBlock: { minxy = dy }
                    two_r = Float_Mul(hr, 0x4000000000000000)
                    IfCondition EqualTo(Float_Le(two_r, minxy), 1) ThenBlock: {
                        // tool height = pocket depth (through if >= plate dz)
                        th = CAD_Store.Read(phb, 1)
                        pack = Allocate(64)
                        ArraySet(pack, 0, dx)
                        ArraySet(pack, 1, dy)
                        ArraySet(pack, 2, dz)
                        ArraySet(pack, 3, hr)
                        ArraySet(pack, 4, hcx)
                        ArraySet(pack, 5, hcy)
                        ArraySet(pack, 6, th)
                        out = Allocate(16)
                        h_cut = CAD_Topo.MakeBoxHolePack(pack, out)
                        Deallocate(pack, 64)
                        IfCondition NotEqual(h_cut, 0) ThenBlock: {
                            phc = CAD_Store.Read(h_cut, 1)
                            CAD_Store.Write(phc, 6, ArrayGet(mn, 0))
                            CAD_Store.Write(phc, 7, ArrayGet(mn, 1))
                            CAD_Store.Write(h_cut, 2, ArrayGet(mn, 2))
                            // shell was built at ox=oy=0; rebuild with plate origin
                            CAD_Topo.BuildPlateHoleShell(h_cut)
                            Deallocate(out, 16)
                            Deallocate(mn, 32)
                            Deallocate(mx, 32)
                            CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                            ReturnValue(h_cut)
                        }
                        Deallocate(out, 16)
                    }
                }
                Deallocate(mn, 32)
                Deallocate(mx, 32)
            }
        }

        // box − box → rectangular pocket (axis-aligned, cut from top)
        IfCondition EqualTo(ka, 0) ThenBlock: {
            IfCondition EqualTo(kb, 0) ThenBlock: {
                mna = Allocate(32)
                mxa = Allocate(32)
                mnb = Allocate(32)
                mxb = Allocate(32)
                oka = CAD_Bool.SolidAABB(solid_a_handle, mna, mxa)
                okb = CAD_Bool.SolidAABB(solid_b_handle, mnb, mxb)
                IfCondition EqualTo(oka, 1) ThenBlock: {
                    IfCondition EqualTo(okb, 1) ThenBlock: {
                        // tool must sit inside body XY; cut from top (tool max z == body max z)
                        ax0 = ArrayGet(mna, 0)
                        ay0 = ArrayGet(mna, 1)
                        az0 = ArrayGet(mna, 2)
                        ax1 = ArrayGet(mxa, 0)
                        ay1 = ArrayGet(mxa, 1)
                        az1 = ArrayGet(mxa, 2)
                        bx0 = ArrayGet(mnb, 0)
                        by0 = ArrayGet(mnb, 1)
                        bz0 = ArrayGet(mnb, 2)
                        bx1 = ArrayGet(mxb, 0)
                        by1 = ArrayGet(mxb, 1)
                        bz1 = ArrayGet(mxb, 2)
                        // strict XY interior
                        xyok = 1
                        IfCondition EqualTo(Float_Le(bx0, ax0), 1) ThenBlock: { xyok = 0 }
                        IfCondition EqualTo(Float_Le(by0, ay0), 1) ThenBlock: { xyok = 0 }
                        IfCondition EqualTo(Float_Le(ax1, bx1), 1) ThenBlock: { xyok = 0 }
                        IfCondition EqualTo(Float_Le(ay1, by1), 1) ThenBlock: { xyok = 0 }
                        // tops aligned (tool opens on body top)
                        topok = CAD_Num.IsEqual(bz1, az1, 0)
                        IfCondition EqualTo(xyok, 1) ThenBlock: {
                            IfCondition EqualTo(topok, 1) ThenBlock: {
                                // depth from top = body.zmax - tool.zmin (clamped)
                                depth = Float_Sub(az1, bz0)
                                IfCondition EqualTo(Float_Le(depth, 0), 1) ThenBlock: { depth = 0 }
                                IfCondition EqualTo(Float_Le(Float_Sub(az1, az0), depth), 1) ThenBlock: {
                                    depth = Float_Sub(az1, az0)
                                }
                                IfCondition EqualTo(CAD_Num.IsZero(depth, 0), 0) ThenBlock: {
                                    pack = Allocate(64)
                                    ArraySet(pack, 0, Float_Sub(ax1, ax0))
                                    ArraySet(pack, 1, Float_Sub(ay1, ay0))
                                    ArraySet(pack, 2, Float_Sub(az1, az0))
                                    ArraySet(pack, 3, Float_Sub(bx0, ax0))
                                    ArraySet(pack, 4, Float_Sub(by0, ay0))
                                    ArraySet(pack, 5, Float_Sub(bx1, ax0))
                                    ArraySet(pack, 6, Float_Sub(by1, ay0))
                                    ArraySet(pack, 7, depth)
                                    out = Allocate(16)
                                    h_cut = CAD_Topo.MakeBoxRectPocketSolid(pack, out)
                                    Deallocate(pack, 64)
                                    Deallocate(out, 16)
                                    IfCondition NotEqual(h_cut, 0) ThenBlock: {
                                        // pocket shell built at local origin; place at body AABB min
                                        dlt = Allocate(32)
                                        ArraySet(dlt, 0, ax0)
                                        ArraySet(dlt, 1, ay0)
                                        ArraySet(dlt, 2, az0)
                                        CAD_Topo.TranslateSolid(h_cut, dlt)
                                        Deallocate(dlt, 32)
                                        Deallocate(mna, 32)
                                        Deallocate(mxa, 32)
                                        Deallocate(mnb, 32)
                                        Deallocate(mxb, 32)
                                        CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                                        ReturnValue(h_cut)
                                    }
                                }
                            }
                        }
                        // side notch: tool opens on body -X face (xmin aligned)
                        // strict interior in YZ; tool min x == body min x
                        yzok = 1
                        IfCondition EqualTo(Float_Le(by0, ay0), 1) ThenBlock: { yzok = 0 }
                        IfCondition EqualTo(Float_Le(bz0, az0), 1) ThenBlock: { yzok = 0 }
                        IfCondition EqualTo(Float_Le(ay1, by1), 1) ThenBlock: { yzok = 0 }
                        IfCondition EqualTo(Float_Le(az1, bz1), 1) ThenBlock: { yzok = 0 }
                        xface = CAD_Num.IsEqual(bx0, ax0, 0)
                        IfCondition EqualTo(yzok, 1) ThenBlock: {
                            IfCondition EqualTo(xface, 1) ThenBlock: {
                                depthx = Float_Sub(bx1, ax0)
                                IfCondition EqualTo(Float_Le(depthx, 0), 1) ThenBlock: { depthx = 0 }
                                IfCondition EqualTo(Float_Le(Float_Sub(ax1, ax0), depthx), 1) ThenBlock: {
                                    depthx = Float_Sub(ax1, ax0)
                                }
                                IfCondition EqualTo(CAD_Num.IsZero(depthx, 0), 0) ThenBlock: {
                                    pack = Allocate(64)
                                    ArraySet(pack, 0, Float_Sub(ax1, ax0))
                                    ArraySet(pack, 1, Float_Sub(ay1, ay0))
                                    ArraySet(pack, 2, Float_Sub(az1, az0))
                                    ArraySet(pack, 3, Float_Sub(by0, ay0))
                                    ArraySet(pack, 4, Float_Sub(bz0, az0))
                                    ArraySet(pack, 5, Float_Sub(by1, ay0))
                                    ArraySet(pack, 6, Float_Sub(bz1, az0))
                                    ArraySet(pack, 7, depthx)
                                    out = Allocate(16)
                                    h_cut = CAD_Topo.MakeBoxRectNotchXSolid(pack, out)
                                    Deallocate(pack, 64)
                                    Deallocate(out, 16)
                                    IfCondition NotEqual(h_cut, 0) ThenBlock: {
                                        dlt = Allocate(32)
                                        ArraySet(dlt, 0, ax0)
                                        ArraySet(dlt, 1, ay0)
                                        ArraySet(dlt, 2, az0)
                                        CAD_Topo.TranslateSolid(h_cut, dlt)
                                        Deallocate(dlt, 32)
                                        Deallocate(mna, 32)
                                        Deallocate(mxa, 32)
                                        Deallocate(mnb, 32)
                                        Deallocate(mxb, 32)
                                        CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                                        ReturnValue(h_cut)
                                    }
                                }
                            }
                        }
                    }
                }
                Deallocate(mna, 32)
                Deallocate(mxa, 32)
                Deallocate(mnb, 32)
                Deallocate(mxb, 32)
            }
        }

        // unsupported case — do not invent empty solid
        ReturnValue(0)
    }
}

// Walk shell verts → AABB into min_addr/max_addr [3]. Returns 1 ok, 0 fail.
Function.CAD_Bool.SolidAABB {
    Input: solid_handle: Integer
    Input: min_addr: Address
    Input: max_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(shell, 0) ThenBlock: { ReturnValue(0) }
        face = CAD_Store.Read(shell, 0)
        IfCondition EqualTo(face, 0) ThenBlock: { ReturnValue(0) }
        loop_h = CAD_Store.Read(face, 1)
        head = CAD_Store.Read(loop_h, 0)
        ov = CAD_Store.Read(head, 5)
        ArraySet(min_addr, 0, CAD_Store.Read(ov, 0))
        ArraySet(min_addr, 1, CAD_Store.Read(ov, 1))
        ArraySet(min_addr, 2, CAD_Store.Read(ov, 2))
        ArraySet(max_addr, 0, CAD_Store.Read(ov, 0))
        ArraySet(max_addr, 1, CAD_Store.Read(ov, 1))
        ArraySet(max_addr, 2, CAD_Store.Read(ov, 2))
        f = face
        fguard = 0
        WhileLoop NotEqual(f, 0) {
            lp = CAD_Store.Read(f, 1)
            lguard = 0
            WhileLoop NotEqual(lp, 0) {
                hd = CAD_Store.Read(lp, 0)
                ce = hd
                cdone = 0
                cguard = 0
                WhileLoop EqualTo(cdone, 0) {
                    o2 = CAD_Store.Read(ce, 5)
                    px = CAD_Store.Read(o2, 0)
                    py = CAD_Store.Read(o2, 1)
                    pz = CAD_Store.Read(o2, 2)
                    IfCondition EqualTo(Float_Le(px, ArrayGet(min_addr, 0)), 1) ThenBlock: { ArraySet(min_addr, 0, px) }
                    IfCondition EqualTo(Float_Le(py, ArrayGet(min_addr, 1)), 1) ThenBlock: { ArraySet(min_addr, 1, py) }
                    IfCondition EqualTo(Float_Le(pz, ArrayGet(min_addr, 2)), 1) ThenBlock: { ArraySet(min_addr, 2, pz) }
                    IfCondition EqualTo(Float_Le(ArrayGet(max_addr, 0), px), 1) ThenBlock: { ArraySet(max_addr, 0, px) }
                    IfCondition EqualTo(Float_Le(ArrayGet(max_addr, 1), py), 1) ThenBlock: { ArraySet(max_addr, 1, py) }
                    IfCondition EqualTo(Float_Le(ArrayGet(max_addr, 2), pz), 1) ThenBlock: { ArraySet(max_addr, 2, pz) }
                    ce = CAD_Store.Read(ce, 2)
                    cguard = Add(cguard, 1)
                    IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                    IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
                }
                lp = CAD_Store.Read(lp, 2)
                lguard = Add(lguard, 1)
                IfCondition GreaterThan(lguard, 16) ThenBlock: { lp = 0 }
            }
            f = CAD_Store.Read(f, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 512) ThenBlock: { f = 0 }
        }
        ReturnValue(1)
    }
}

// Intersection A∩B. Restricted: both kind-0 boxes → overlap AABB solid, or 0 if empty.
Function.CAD_Bool.Intersection {
    Input: solid_a_handle: Integer
    Input: solid_b_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_a_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(solid_b_handle, 0) ThenBlock: { ReturnValue(0) }
        ka = CAD_Store.Read(solid_a_handle, 3)
        kb = CAD_Store.Read(solid_b_handle, 3)
        IfCondition NotEqual(ka, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(kb, 0) ThenBlock: { ReturnValue(0) }
        mna = Allocate(32)
        mxa = Allocate(32)
        mnb = Allocate(32)
        mxb = Allocate(32)
        oka = CAD_Bool.SolidAABB(solid_a_handle, mna, mxa)
        okb = CAD_Bool.SolidAABB(solid_b_handle, mnb, mxb)
        IfCondition EqualTo(oka, 1) ThenBlock: {
            IfCondition EqualTo(okb, 1) ThenBlock: {
                // ix0 = max(mins), ix1 = min(maxs)
                ix0 = ArrayGet(mna, 0)
                IfCondition EqualTo(Float_Le(ArrayGet(mna, 0), ArrayGet(mnb, 0)), 1) ThenBlock: {
                    ix0 = ArrayGet(mnb, 0)
                }
                iy0 = ArrayGet(mna, 1)
                IfCondition EqualTo(Float_Le(ArrayGet(mna, 1), ArrayGet(mnb, 1)), 1) ThenBlock: {
                    iy0 = ArrayGet(mnb, 1)
                }
                iz0 = ArrayGet(mna, 2)
                IfCondition EqualTo(Float_Le(ArrayGet(mna, 2), ArrayGet(mnb, 2)), 1) ThenBlock: {
                    iz0 = ArrayGet(mnb, 2)
                }
                ix1 = ArrayGet(mxa, 0)
                IfCondition EqualTo(Float_Le(ArrayGet(mxb, 0), ArrayGet(mxa, 0)), 1) ThenBlock: {
                    ix1 = ArrayGet(mxb, 0)
                }
                iy1 = ArrayGet(mxa, 1)
                IfCondition EqualTo(Float_Le(ArrayGet(mxb, 1), ArrayGet(mxa, 1)), 1) ThenBlock: {
                    iy1 = ArrayGet(mxb, 1)
                }
                iz1 = ArrayGet(mxa, 2)
                IfCondition EqualTo(Float_Le(ArrayGet(mxb, 2), ArrayGet(mxa, 2)), 1) ThenBlock: {
                    iz1 = ArrayGet(mxb, 2)
                }
                // empty if any axis has no positive thickness
                okv = 1
                IfCondition EqualTo(Float_Le(Float_Sub(ix1, ix0), 0), 1) ThenBlock: { okv = 0 }
                IfCondition EqualTo(Float_Le(Float_Sub(iy1, iy0), 0), 1) ThenBlock: { okv = 0 }
                IfCondition EqualTo(Float_Le(Float_Sub(iz1, iz0), 0), 1) ThenBlock: { okv = 0 }
                IfCondition EqualTo(okv, 1) ThenBlock: {
                    ArraySet(mna, 0, ix0)
                    ArraySet(mna, 1, iy0)
                    ArraySet(mna, 2, iz0)
                    ArraySet(mxa, 0, ix1)
                    ArraySet(mxa, 1, iy1)
                    ArraySet(mxa, 2, iz1)
                    out = Allocate(16)
                    h = CAD_Topo.MakeBoxSolid(mna, mxa, out)
                    Deallocate(out, 16)
                    Deallocate(mna, 32)
                    Deallocate(mxa, 32)
                    Deallocate(mnb, 32)
                    Deallocate(mxb, 32)
                    IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
                    CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                    ReturnValue(h)
                }
            }
        }
        Deallocate(mna, 32)
        Deallocate(mxa, 32)
        Deallocate(mnb, 32)
        Deallocate(mxb, 32)
        ReturnValue(0)
    }
}
