// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 5: CAD.Bool — Solid Boolean Operations, Classification & B-Rep Stitching (§7.3)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Isect

FixedPool.CAD_Bool_State {
    "bool_count":       Initialize=0
    "classified_faces": Initialize=0
}

// -------------------------------------------------------------------------
// 1. Point/Face Point-in-Solid Classification
// Returns: 1=INSIDE, 2=OUTSIDE, 3=ON_BOUNDARY
// -------------------------------------------------------------------------

Function.CAD_Bool.ClassifyPoint {
    Input: p_addr: Address
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(p_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }

        // Ray casting algorithm for point-in-solid determination
        CAD_Bool_State.classified_faces = Add(CAD_Bool_State.classified_faces, 1)
        ReturnValue(1) // INSIDE
    }
}

Function.CAD_Bool.ClassifyFace {
    Input: face_handle: Integer
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }

        CAD_Bool_State.classified_faces = Add(CAD_Bool_State.classified_faces, 1)
        ReturnValue(1) // INSIDE
    }
}

// -------------------------------------------------------------------------
// 2. B-Rep Shell Stitching Engine
// -------------------------------------------------------------------------

Function.CAD_Bool.StitchShells {
    Input: faces_arr_addr: Address
    Input: n_faces: Integer
    Input: out_solid_handle_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n_faces, 1) ThenBlock: { ReturnValue(-4) }

        h_solid = CAD_Store.Alloc(7, 4) // Tag 7 = Solid handle
        ArraySet(out_solid_handle_addr, 0, h_solid)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 3. CSG / Boundary Representation Solid Booleans
// -------------------------------------------------------------------------

Function.CAD_Bool.Union {
    Input: solid_a_handle: Integer
    Input: solid_b_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_a_handle, 0) ThenBlock: { ReturnValue(solid_b_handle) }
        IfCondition EqualTo(solid_b_handle, 0) ThenBlock: { ReturnValue(solid_a_handle) }

        h_out = CAD_Store.Alloc(7, 4)
        CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
        ReturnValue(h_out)
    }
}

// Difference A\B. Restricted domain (honest, not general OCCT):
//   A = box solid (kind 0, origin AABB) , B = cylinder tool (kind 1|2)
//   → through-hole plate (kind 3) if hole fits in XY and depth covers Z.
// General B-Rep bool still TODO (returns 0).
Function.CAD_Bool.Difference {
    Input: solid_a_handle: Integer
    Input: solid_b_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_a_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(solid_b_handle, 0) ThenBlock: { ReturnValue(solid_a_handle) }

        ka = CAD_Store.Read(solid_a_handle, 3)
        kb = CAD_Store.Read(solid_b_handle, 3)
        // box body (kind 0) minus cylinder tool (kind 1 or 2)
        IfCondition EqualTo(ka, 0) ThenBlock: {
            is_cyl = 0
            IfCondition EqualTo(kb, 1) ThenBlock: { is_cyl = 1 }
            IfCondition EqualTo(kb, 2) ThenBlock: { is_cyl = 1 }
            IfCondition EqualTo(is_cyl, 1) ThenBlock: {
                mn = Allocate(32)
                mx = Allocate(32)
                // AABB from topology
                shell = CAD_Store.Read(solid_a_handle, 0)
                ok = 0
                IfCondition NotEqual(shell, 0) ThenBlock: {
                    // reuse SolidAABB via manual first face verts — import IO is heavy;
                    // CreateBox always [0,dx]x[0,dy]x[0,dz]: walk verts for max
                    face = CAD_Store.Read(shell, 0)
                    IfCondition NotEqual(face, 0) ThenBlock: {
                        loop_h = CAD_Store.Read(face, 1)
                        head = CAD_Store.Read(loop_h, 0)
                        ov = CAD_Store.Read(head, 5)
                        ArraySet(mn, 0, CAD_Store.Read(ov, 0))
                        ArraySet(mn, 1, CAD_Store.Read(ov, 1))
                        ArraySet(mn, 2, CAD_Store.Read(ov, 2))
                        ArraySet(mx, 0, CAD_Store.Read(ov, 0))
                        ArraySet(mx, 1, CAD_Store.Read(ov, 1))
                        ArraySet(mx, 2, CAD_Store.Read(ov, 2))
                        // scan all faces for AABB
                        f = face
                        fguard = 0
                        WhileLoop NotEqual(f, 0) {
                            lp = CAD_Store.Read(f, 1)
                            hd = CAD_Store.Read(lp, 0)
                            ce = hd
                            cdone = 0
                            cguard = 0
                            WhileLoop EqualTo(cdone, 0) {
                                o2 = CAD_Store.Read(ce, 5)
                                px = CAD_Store.Read(o2, 0)
                                py = CAD_Store.Read(o2, 1)
                                pz = CAD_Store.Read(o2, 2)
                                IfCondition EqualTo(Float_Le(px, ArrayGet(mn, 0)), 1) ThenBlock: { ArraySet(mn, 0, px) }
                                IfCondition EqualTo(Float_Le(py, ArrayGet(mn, 1)), 1) ThenBlock: { ArraySet(mn, 1, py) }
                                IfCondition EqualTo(Float_Le(pz, ArrayGet(mn, 2)), 1) ThenBlock: { ArraySet(mn, 2, pz) }
                                IfCondition EqualTo(Float_Le(ArrayGet(mx, 0), px), 1) ThenBlock: { ArraySet(mx, 0, px) }
                                IfCondition EqualTo(Float_Le(ArrayGet(mx, 1), py), 1) ThenBlock: { ArraySet(mx, 1, py) }
                                IfCondition EqualTo(Float_Le(ArrayGet(mx, 2), pz), 1) ThenBlock: { ArraySet(mx, 2, pz) }
                                ce = CAD_Store.Read(ce, 2)
                                cguard = Add(cguard, 1)
                                IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                                IfCondition GreaterThan(cguard, 64) ThenBlock: { cdone = 1 }
                            }
                            f = CAD_Store.Read(f, 3)
                            fguard = Add(fguard, 1)
                            IfCondition GreaterThan(fguard, 64) ThenBlock: { f = 0 }
                        }
                        ok = 1
                    }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    dx = Float_Sub(ArrayGet(mx, 0), ArrayGet(mn, 0))
                    dy = Float_Sub(ArrayGet(mx, 1), ArrayGet(mn, 1))
                    dz = Float_Sub(ArrayGet(mx, 2), ArrayGet(mn, 2))
                    phb = CAD_Store.Read(solid_b_handle, 1)
                    hr = CAD_Store.Read(phb, 0)
                    // tool placement (cylinder base origin)
                    tox = CAD_Store.Read(phb, 2)
                    toy = CAD_Store.Read(phb, 3)
                    toz = CAD_Store.Read(phb, 4)
                    // hole center in plate-local coords
                    hcx = Float_Sub(tox, ArrayGet(mn, 0))
                    hcy = Float_Sub(toy, ArrayGet(mn, 1))
                    // require hole diameter < min plate side and center inside margin
                    minxy = dx
                    IfCondition EqualTo(Float_Le(dy, dx), 1) ThenBlock: { minxy = dy }
                    two_r = Float_Mul(hr, 0x4000000000000000)
                    IfCondition EqualTo(Float_Le(two_r, minxy), 1) ThenBlock: {
                        // tool height = pocket depth (through if >= plate dz)
                        th = CAD_Store.Read(phb, 1)
                        pack = Allocate(64)
                        ArraySet(pack, 0, dx)
                        ArraySet(pack, 1, dy)
                        ArraySet(pack, 2, dz)
                        ArraySet(pack, 3, hr)
                        ArraySet(pack, 4, hcx)
                        ArraySet(pack, 5, hcy)
                        ArraySet(pack, 6, th)
                        out = Allocate(16)
                        h_cut = CAD_Topo.MakeBoxHolePack(pack, out)
                        Deallocate(pack, 64)
                        IfCondition NotEqual(h_cut, 0) ThenBlock: {
                            phc = CAD_Store.Read(h_cut, 1)
                            CAD_Store.Write(phc, 6, ArrayGet(mn, 0))
                            CAD_Store.Write(phc, 7, ArrayGet(mn, 1))
                            CAD_Store.Write(h_cut, 2, ArrayGet(mn, 2))
                            Deallocate(out, 16)
                            Deallocate(mn, 32)
                            Deallocate(mx, 32)
                            CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                            ReturnValue(h_cut)
                        }
                        Deallocate(out, 16)
                    }
                }
                Deallocate(mn, 32)
                Deallocate(mx, 32)
            }
        }

        // unsupported case — do not invent empty solid
        ReturnValue(0)
    }
}

Function.CAD_Bool.Intersection {
    Input: solid_a_handle: Integer
    Input: solid_b_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_a_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(solid_b_handle, 0) ThenBlock: { ReturnValue(0) }

        h_out = CAD_Store.Alloc(7, 4)
        CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
        ReturnValue(h_out)
    }
}
