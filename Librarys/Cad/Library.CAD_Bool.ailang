// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 5: CAD.Bool — Solid Boolean Operations, Classification & B-Rep Stitching (§7.3)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Isect

FixedPool.CAD_Bool_State {
    "bool_count":       Initialize=0
    "classified_faces": Initialize=0
}

// -------------------------------------------------------------------------
// 1. Point/Face Point-in-Solid Classification
// Returns: 1=INSIDE, 2=OUTSIDE, 3=ON_BOUNDARY
// -------------------------------------------------------------------------

// Classify point vs solid. 1=INSIDE 2=OUTSIDE 3=ON_BOUNDARY -1=bad.
// kind0: raycast planar faces (not box bounds); kind1/2 cyl; kind4 sphere;
// kind3: rectangular plate recipe + hole voids.
Function.CAD_Bool.ClassifyPoint {
    Input: p_addr: Address
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(p_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        px = ArrayGet(p_addr, 0)
        py = ArrayGet(p_addr, 1)
        pz = ArrayGet(p_addr, 2)
        kind = CAD_Store.Read(solid_handle, 3)
        CAD_Bool_State.classified_faces = Add(CAD_Bool_State.classified_faces, 1)

        // kind 0: count +Z ray hits on planar faces (even-odd)
        IfCondition EqualTo(kind, 0) ThenBlock: {
            ray = Allocate(64)
            outp = Allocate(64)
            ArraySet(ray, 0, px)
            ArraySet(ray, 1, py)
            ArraySet(ray, 2, pz)
            ArraySet(ray, 3, 0)
            ArraySet(ray, 4, 0)
            ArraySet(ray, 5, 0x3FF0000000000000)
            // multi-hit: walk faces with +Z ray manually
            hits = 0
            pl = Allocate(128)
            hitp = Allocate(32)
            shell = CAD_Store.Read(solid_handle, 0)
            sguard = 0
            WhileLoop NotEqual(shell, 0) {
                face = CAD_Store.Read(shell, 0)
                fguard = 0
                WhileLoop NotEqual(face, 0) {
                    IfCondition EqualTo(CAD_Topo.FaceGetPlane(face, pl), 0) ThenBlock: {
                        nx = ArrayGet(pl, 10)
                        ny = ArrayGet(pl, 11)
                        nz = ArrayGet(pl, 12)
                        ox = ArrayGet(pl, 1)
                        oy = ArrayGet(pl, 2)
                        oz = ArrayGet(pl, 3)
                        // ray p + t(0,0,1); t = N·(O-p) / N·d = N·(O-p)/nz
                        IfCondition EqualTo(CAD_Num.IsZero(nz, 0), 0) ThenBlock: {
                            num = Float_Add(Float_Add(Float_Mul(nx, Float_Sub(ox, px)), Float_Mul(ny, Float_Sub(oy, py))), Float_Mul(nz, Float_Sub(oz, pz)))
                            t = Float_Div(num, nz)
                            IfCondition EqualTo(Float_Le(0x3EB0C6F7A0B5ED8D, t), 1) ThenBlock: {
                                ArraySet(hitp, 0, px)
                                ArraySet(hitp, 1, py)
                                ArraySet(hitp, 2, Float_Add(pz, t))
                                IfCondition EqualTo(CAD_Topo.PointInFaceUV(face, hitp), 1) ThenBlock: {
                                    hits = Add(hits, 1)
                                }
                            }
                        }
                    }
                    face = CAD_Store.Read(face, 3)
                    fguard = Add(fguard, 1)
                    IfCondition GreaterThan(fguard, 512) ThenBlock: { face = 0 }
                }
                shell = CAD_Store.Read(shell, 2)
                sguard = Add(sguard, 1)
                IfCondition GreaterThan(sguard, 64) ThenBlock: { shell = 0 }
            }
            Deallocate(pl, 128)
            Deallocate(hitp, 32)
            Deallocate(ray, 64)
            Deallocate(outp, 64)
            // odd hits → inside
            IfCondition EqualTo(Modulo(hits, 2), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(2)
        }
        // kind 3: plate params (rect recipe), then subtract Z-axis hole cylinders
        IfCondition EqualTo(kind, 3) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            IfCondition EqualTo(ph, 0) ThenBlock: { ReturnValue(-1) }
            dx = CAD_Store.Read(ph, 0)
            dy = CAD_Store.Read(ph, 1)
            dz = CAD_Store.Read(ph, 2)
            ox = CAD_Store.Read(ph, 6)
            oy = CAD_Store.Read(ph, 7)
            oz = CAD_Store.Read(solid_handle, 2)
            // rect plate bounds from recipe (not freeform AABB)
            IfCondition EqualTo(Float_Le(px, ox), 1) ThenBlock: { ReturnValue(2) }
            IfCondition EqualTo(Float_Le(py, oy), 1) ThenBlock: { ReturnValue(2) }
            IfCondition EqualTo(Float_Le(pz, oz), 1) ThenBlock: { ReturnValue(2) }
            IfCondition EqualTo(Float_Le(Float_Add(ox, dx), px), 1) ThenBlock: { ReturnValue(2) }
            IfCondition EqualTo(Float_Le(Float_Add(oy, dy), py), 1) ThenBlock: { ReturnValue(2) }
            IfCondition EqualTo(Float_Le(Float_Add(oz, dz), pz), 1) ThenBlock: { ReturnValue(2) }
            rc = 1
            // if outside plate already done; if in/on, check holes (void → outside)
            nh = CAD_Store.Read(ph, 9)
            IfCondition EqualTo(nh, 0) ThenBlock: { nh = 1 }
            hi = 0
            WhileLoop LessThan(hi, nh) {
                IfCondition EqualTo(hi, 0) ThenBlock: {
                    hr = CAD_Store.Read(ph, 3)
                    hcx = CAD_Store.Read(ph, 4)
                    hcy = CAD_Store.Read(ph, 5)
                    hdep = CAD_Store.Read(ph, 8)
                }
                IfCondition GreaterThan(hi, 0) ThenBlock: {
                    base = Add(10, Multiply(Subtract(hi, 1), 4))
                    hr = CAD_Store.Read(ph, base)
                    hcx = CAD_Store.Read(ph, Add(base, 1))
                    hcy = CAD_Store.Read(ph, Add(base, 2))
                    hdep = CAD_Store.Read(ph, Add(base, 3))
                }
                IfCondition EqualTo(CAD_Num.IsZero(hdep, 0), 1) ThenBlock: { hdep = dz }
                IfCondition EqualTo(Float_Le(dz, hdep), 1) ThenBlock: { hdep = dz }
                // hole world center XY; void from z_top-depth to z_top
                wx = Float_Add(ox, hcx)
                wy = Float_Add(oy, hcy)
                z_top = Float_Add(oz, dz)
                z_bot = Float_Sub(z_top, hdep)
                dxp = Float_Sub(px, wx)
                dyp = Float_Sub(py, wy)
                rho2 = Float_Add(Float_Mul(dxp, dxp), Float_Mul(dyp, dyp))
                r2 = Float_Mul(hr, hr)
                // strictly inside hole disk and within hole Z → outside solid
                inz = 1
                IfCondition EqualTo(Float_Le(pz, z_bot), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(pz, z_bot, 0), 0) ThenBlock: { inz = 0 }
                }
                IfCondition EqualTo(Float_Le(z_top, pz), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(pz, z_top, 0), 0) ThenBlock: { inz = 0 }
                }
                IfCondition EqualTo(inz, 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(r2, rho2), 0) ThenBlock: {
                        // rho < r : interior of hole
                        IfCondition EqualTo(CAD_Num.IsEqual(rho2, r2, 0), 0) ThenBlock: {
                            ReturnValue(2)
                        }
                        // on cylindrical wall
                        ReturnValue(3)
                    }
                    IfCondition EqualTo(CAD_Num.IsEqual(rho2, r2, 0), 1) ThenBlock: {
                        ReturnValue(3)
                    }
                }
                hi = Add(hi, 1)
            }
            ReturnValue(rc)
        }
        // kind 1/2: right cylinder // +Z, base (ox,oy,oz), r, h
        IfCondition EqualTo(kind, 1) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            r = CAD_Store.Read(ph, 0)
            h = CAD_Store.Read(ph, 1)
            ox = CAD_Store.Read(ph, 2)
            oy = CAD_Store.Read(ph, 3)
            oz = CAD_Store.Read(ph, 4)
            dzp = Float_Sub(pz, oz)
            IfCondition EqualTo(Float_Le(dzp, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(dzp, 0), 1) ThenBlock: {
                    // on bottom plane — check disk
                }
                IfCondition EqualTo(CAD_Num.IsZero(dzp, 0), 0) ThenBlock: { ReturnValue(2) }
            }
            IfCondition EqualTo(Float_Le(h, dzp), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(dzp, h, 0), 0) ThenBlock: { ReturnValue(2) }
            }
            dxp = Float_Sub(px, ox)
            dyp = Float_Sub(py, oy)
            rho2 = Float_Add(Float_Mul(dxp, dxp), Float_Mul(dyp, dyp))
            r2 = Float_Mul(r, r)
            IfCondition EqualTo(Float_Le(r2, rho2), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(rho2, r2, 0), 1) ThenBlock: { ReturnValue(3) }
                ReturnValue(2)
            }
            // inside radial disk
            IfCondition EqualTo(CAD_Num.IsZero(dzp, 0), 1) ThenBlock: { ReturnValue(3) }
            IfCondition EqualTo(CAD_Num.IsEqual(dzp, h, 0), 1) ThenBlock: { ReturnValue(3) }
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            // same as kind 1
            ph = CAD_Store.Read(solid_handle, 1)
            r = CAD_Store.Read(ph, 0)
            h = CAD_Store.Read(ph, 1)
            ox = CAD_Store.Read(ph, 2)
            oy = CAD_Store.Read(ph, 3)
            oz = CAD_Store.Read(ph, 4)
            dzp = Float_Sub(pz, oz)
            IfCondition EqualTo(Float_Le(dzp, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(dzp, 0), 0) ThenBlock: { ReturnValue(2) }
            }
            IfCondition EqualTo(Float_Le(h, dzp), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(dzp, h, 0), 0) ThenBlock: { ReturnValue(2) }
            }
            dxp = Float_Sub(px, ox)
            dyp = Float_Sub(py, oy)
            rho2 = Float_Add(Float_Mul(dxp, dxp), Float_Mul(dyp, dyp))
            r2 = Float_Mul(r, r)
            IfCondition EqualTo(Float_Le(r2, rho2), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(rho2, r2, 0), 1) ThenBlock: { ReturnValue(3) }
                ReturnValue(2)
            }
            IfCondition EqualTo(CAD_Num.IsZero(dzp, 0), 1) ThenBlock: { ReturnValue(3) }
            IfCondition EqualTo(CAD_Num.IsEqual(dzp, h, 0), 1) ThenBlock: { ReturnValue(3) }
            ReturnValue(1)
        }
        // kind 4 sphere
        IfCondition EqualTo(kind, 4) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            r = CAD_Store.Read(ph, 0)
            cx = CAD_Store.Read(ph, 1)
            cy = CAD_Store.Read(ph, 2)
            cz = CAD_Store.Read(ph, 3)
            dxp = Float_Sub(px, cx)
            dyp = Float_Sub(py, cy)
            dzp = Float_Sub(pz, cz)
            d2 = Float_Add(Float_Add(Float_Mul(dxp, dxp), Float_Mul(dyp, dyp)), Float_Mul(dzp, dzp))
            r2 = Float_Mul(r, r)
            IfCondition EqualTo(CAD_Num.IsEqual(d2, r2, 0), 1) ThenBlock: { ReturnValue(3) }
            IfCondition EqualTo(Float_Le(r2, d2), 1) ThenBlock: { ReturnValue(2) }
            ReturnValue(1)
        }
        ReturnValue(-1)
    }
}



Function.CAD_Bool.ClassifyFace {
    Input: face_handle: Integer
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }

        CAD_Bool_State.classified_faces = Add(CAD_Bool_State.classified_faces, 1)
        ReturnValue(1) // INSIDE
    }
}

// -------------------------------------------------------------------------
// 2. B-Rep Shell Stitching Engine
// -------------------------------------------------------------------------

Function.CAD_Bool.StitchShells {
    Input: faces_arr_addr: Address
    Input: n_faces: Integer
    Input: out_solid_handle_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n_faces, 1) ThenBlock: { ReturnValue(-4) }

        h_solid = CAD_Store.Alloc(7, 4) // Tag 7 = Solid handle
        ArraySet(out_solid_handle_addr, 0, h_solid)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 3. CSG / Boundary Representation Solid Booleans
// -------------------------------------------------------------------------

// Union A∪B. Honest multi-body: kind-0 shells CompoundAdd (no inventing a box).
// General B-Rep merge still TODO. Coaxial cyl paths elsewhere.
Function.CAD_Bool.Union {
    Input: solid_a_handle: Integer
    Input: solid_b_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_a_handle, 0) ThenBlock: { ReturnValue(solid_b_handle) }
        IfCondition EqualTo(solid_b_handle, 0) ThenBlock: { ReturnValue(solid_a_handle) }
        ka = CAD_Store.Read(solid_a_handle, 3)
        kb = CAD_Store.Read(solid_b_handle, 3)
        // kind-0 multi-body (sketch-driven shells) — not AABB fuse
        IfCondition EqualTo(ka, 0) ThenBlock: {
            IfCondition EqualTo(kb, 0) ThenBlock: {
                h = CAD_Topo.CompoundAdd(solid_a_handle, solid_b_handle)
                IfCondition NotEqual(h, 0) ThenBlock: {
                    CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                    ReturnValue(h)
                }
            }
        }
        ReturnValue(0)
    }
}

// Difference A\B. Restricted domain (honest, not general OCCT):
//   A = box (kind 0) , B = cylinder (kind 1|2) → kind-3 plate with 1 hole
//   A = kind-3 plate , B = cylinder → append hole (max 5)
//   A = box (kind 0) , B = box (kind 0) → rect pocket if B cuts from top of A
// General B-Rep bool still TODO (returns 0).
Function.CAD_Bool.Difference {
    Input: solid_a_handle: Integer
    Input: solid_b_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_a_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(solid_b_handle, 0) ThenBlock: { ReturnValue(solid_a_handle) }

        ka = CAD_Store.Read(solid_a_handle, 3)
        kb = CAD_Store.Read(solid_b_handle, 3)
        is_cyl = 0
        IfCondition EqualTo(kb, 1) ThenBlock: { is_cyl = 1 }
        IfCondition EqualTo(kb, 2) ThenBlock: { is_cyl = 1 }

        // plate-with-hole(s) + another cylinder cut → append hole
        IfCondition EqualTo(ka, 3) ThenBlock: {
            IfCondition EqualTo(is_cyl, 1) ThenBlock: {
                pha = CAD_Store.Read(solid_a_handle, 1)
                phb = CAD_Store.Read(solid_b_handle, 1)
                hr = CAD_Store.Read(phb, 0)
                th = CAD_Store.Read(phb, 1)
                tox = CAD_Store.Read(phb, 2)
                toy = CAD_Store.Read(phb, 3)
                ox = CAD_Store.Read(pha, 6)
                oy = CAD_Store.Read(pha, 7)
                hcx = Float_Sub(tox, ox)
                hcy = Float_Sub(toy, oy)
                dx = CAD_Store.Read(pha, 0)
                dy = CAD_Store.Read(pha, 1)
                minxy = dx
                IfCondition EqualTo(Float_Le(dy, dx), 1) ThenBlock: { minxy = dy }
                two_r = Float_Mul(hr, 0x4000000000000000)
                IfCondition EqualTo(Float_Le(two_r, minxy), 1) ThenBlock: {
                    pack = Allocate(64)
                    ArraySet(pack, 0, hr)
                    ArraySet(pack, 1, hcx)
                    ArraySet(pack, 2, hcy)
                    ArraySet(pack, 3, th)
                    out = Allocate(16)
                    h_cut = CAD_Topo.AppendBoxHole(solid_a_handle, pack, out)
                    Deallocate(pack, 64)
                    Deallocate(out, 16)
                    IfCondition NotEqual(h_cut, 0) ThenBlock: {
                        CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                        ReturnValue(h_cut)
                    }
                }
            }
        }

        // coaxial cylinder − cylinder → tube (annulus prism)
        IfCondition EqualTo(is_cyl, 1) ThenBlock: {
            is_cyl_a = 0
            IfCondition EqualTo(ka, 1) ThenBlock: { is_cyl_a = 1 }
            IfCondition EqualTo(ka, 2) ThenBlock: { is_cyl_a = 1 }
            IfCondition EqualTo(is_cyl_a, 1) ThenBlock: {
                pha = CAD_Store.Read(solid_a_handle, 1)
                phb = CAD_Store.Read(solid_b_handle, 1)
                ra = CAD_Store.Read(pha, 0)
                ha = CAD_Store.Read(pha, 1)
                oax = CAD_Store.Read(pha, 2)
                oay = CAD_Store.Read(pha, 3)
                oaz = CAD_Store.Read(pha, 4)
                rb = CAD_Store.Read(phb, 0)
                hb = CAD_Store.Read(phb, 1)
                obx = CAD_Store.Read(phb, 2)
                oby = CAD_Store.Read(phb, 3)
                obz = CAD_Store.Read(phb, 4)
                // require ra > rb, same height and base (coaxial through)
                IfCondition EqualTo(Float_Le(ra, rb), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(ha, hb, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(oax, obx, 0), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsEqual(oay, oby, 0), 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.IsEqual(oaz, obz, 0), 1) ThenBlock: {
                                    out = Allocate(16)
                                    // closed tube (kind 5) — was 32-seg keyhole prism (gap + facets)
                                    h_tube = CAD_Topo.MakeTubeSolid(rb, ra, ha, out)
                                    Deallocate(out, 16)
                                    IfCondition NotEqual(h_tube, 0) ThenBlock: {
                                        dlt = Allocate(32)
                                        ArraySet(dlt, 0, oax)
                                        ArraySet(dlt, 1, oay)
                                        ArraySet(dlt, 2, oaz)
                                        CAD_Topo.TranslateSolid(h_tube, dlt)
                                        Deallocate(dlt, 32)
                                        CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                                        ReturnValue(h_tube)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // kind-0 body minus cylinder tool → plate/hole recipe using vert bounds for local frame
        IfCondition EqualTo(ka, 0) ThenBlock: {
            IfCondition EqualTo(is_cyl, 1) ThenBlock: {
                mn = Allocate(32)
                mx = Allocate(32)
                ok = CAD_Topo.SolidBounds(solid_a_handle, mn, mx)
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    dx = Float_Sub(ArrayGet(mx, 0), ArrayGet(mn, 0))
                    dy = Float_Sub(ArrayGet(mx, 1), ArrayGet(mn, 1))
                    dz = Float_Sub(ArrayGet(mx, 2), ArrayGet(mn, 2))
                    phb = CAD_Store.Read(solid_b_handle, 1)
                    hr = CAD_Store.Read(phb, 0)
                    // tool placement (cylinder base origin)
                    tox = CAD_Store.Read(phb, 2)
                    toy = CAD_Store.Read(phb, 3)
                    toz = CAD_Store.Read(phb, 4)
                    // hole center in plate-local coords
                    hcx = Float_Sub(tox, ArrayGet(mn, 0))
                    hcy = Float_Sub(toy, ArrayGet(mn, 1))
                    // require hole diameter < min plate side and center inside margin
                    minxy = dx
                    IfCondition EqualTo(Float_Le(dy, dx), 1) ThenBlock: { minxy = dy }
                    two_r = Float_Mul(hr, 0x4000000000000000)
                    IfCondition EqualTo(Float_Le(two_r, minxy), 1) ThenBlock: {
                        // tool height = pocket depth (through if >= plate dz)
                        th = CAD_Store.Read(phb, 1)
                        pack = Allocate(64)
                        ArraySet(pack, 0, dx)
                        ArraySet(pack, 1, dy)
                        ArraySet(pack, 2, dz)
                        ArraySet(pack, 3, hr)
                        ArraySet(pack, 4, hcx)
                        ArraySet(pack, 5, hcy)
                        ArraySet(pack, 6, th)
                        out = Allocate(16)
                        h_cut = CAD_Topo.MakeBoxHolePack(pack, out)
                        Deallocate(pack, 64)
                        IfCondition NotEqual(h_cut, 0) ThenBlock: {
                            phc = CAD_Store.Read(h_cut, 1)
                            CAD_Store.Write(phc, 6, ArrayGet(mn, 0))
                            CAD_Store.Write(phc, 7, ArrayGet(mn, 1))
                            CAD_Store.Write(h_cut, 2, ArrayGet(mn, 2))
                            // shell was built at ox=oy=0; rebuild with plate origin
                            CAD_Topo.BuildPlateHoleShell(h_cut)
                            Deallocate(out, 16)
                            Deallocate(mn, 32)
                            Deallocate(mx, 32)
                            CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                            ReturnValue(h_cut)
                        }
                        Deallocate(out, 16)
                    }
                }
                Deallocate(mn, 32)
                Deallocate(mx, 32)
            }
        }

        // box − box → rectangular pocket (axis-aligned, cut from top)
        IfCondition EqualTo(ka, 0) ThenBlock: {
            IfCondition EqualTo(kb, 0) ThenBlock: {
                mna = Allocate(32)
                mxa = Allocate(32)
                mnb = Allocate(32)
                mxb = Allocate(32)
                oka = CAD_Topo.SolidBounds(solid_a_handle, mna, mxa)
                okb = CAD_Topo.SolidBounds(solid_b_handle, mnb, mxb)
                IfCondition EqualTo(oka, 1) ThenBlock: {
                    IfCondition EqualTo(okb, 1) ThenBlock: {
                        // tool must sit inside body XY; cut from top (tool max z == body max z)
                        ax0 = ArrayGet(mna, 0)
                        ay0 = ArrayGet(mna, 1)
                        az0 = ArrayGet(mna, 2)
                        ax1 = ArrayGet(mxa, 0)
                        ay1 = ArrayGet(mxa, 1)
                        az1 = ArrayGet(mxa, 2)
                        bx0 = ArrayGet(mnb, 0)
                        by0 = ArrayGet(mnb, 1)
                        bz0 = ArrayGet(mnb, 2)
                        bx1 = ArrayGet(mxb, 0)
                        by1 = ArrayGet(mxb, 1)
                        bz1 = ArrayGet(mxb, 2)
                        // strict XY interior
                        xyok = 1
                        IfCondition EqualTo(Float_Le(bx0, ax0), 1) ThenBlock: { xyok = 0 }
                        IfCondition EqualTo(Float_Le(by0, ay0), 1) ThenBlock: { xyok = 0 }
                        IfCondition EqualTo(Float_Le(ax1, bx1), 1) ThenBlock: { xyok = 0 }
                        IfCondition EqualTo(Float_Le(ay1, by1), 1) ThenBlock: { xyok = 0 }
                        // tops aligned (tool opens on body top)
                        topok = CAD_Num.IsEqual(bz1, az1, 0)
                        IfCondition EqualTo(xyok, 1) ThenBlock: {
                            IfCondition EqualTo(topok, 1) ThenBlock: {
                                // depth from top = body.zmax - tool.zmin (clamped)
                                depth = Float_Sub(az1, bz0)
                                IfCondition EqualTo(Float_Le(depth, 0), 1) ThenBlock: { depth = 0 }
                                IfCondition EqualTo(Float_Le(Float_Sub(az1, az0), depth), 1) ThenBlock: {
                                    depth = Float_Sub(az1, az0)
                                }
                                IfCondition EqualTo(CAD_Num.IsZero(depth, 0), 0) ThenBlock: {
                                    pack = Allocate(64)
                                    ArraySet(pack, 0, Float_Sub(ax1, ax0))
                                    ArraySet(pack, 1, Float_Sub(ay1, ay0))
                                    ArraySet(pack, 2, Float_Sub(az1, az0))
                                    ArraySet(pack, 3, Float_Sub(bx0, ax0))
                                    ArraySet(pack, 4, Float_Sub(by0, ay0))
                                    ArraySet(pack, 5, Float_Sub(bx1, ax0))
                                    ArraySet(pack, 6, Float_Sub(by1, ay0))
                                    ArraySet(pack, 7, depth)
                                    out = Allocate(16)
                                    h_cut = CAD_Topo.MakeBoxRectPocketSolid(pack, out)
                                    Deallocate(pack, 64)
                                    Deallocate(out, 16)
                                    IfCondition NotEqual(h_cut, 0) ThenBlock: {
                                        // pocket shell built at local origin; place at body bounds min
                                        dlt = Allocate(32)
                                        ArraySet(dlt, 0, ax0)
                                        ArraySet(dlt, 1, ay0)
                                        ArraySet(dlt, 2, az0)
                                        CAD_Topo.TranslateSolid(h_cut, dlt)
                                        Deallocate(dlt, 32)
                                        Deallocate(mna, 32)
                                        Deallocate(mxa, 32)
                                        Deallocate(mnb, 32)
                                        Deallocate(mxb, 32)
                                        CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                                        ReturnValue(h_cut)
                                    }
                                }
                            }
                        }
                        // side notch: tool opens on body -X face (xmin aligned)
                        // strict interior in YZ; tool min x == body min x
                        yzok = 1
                        IfCondition EqualTo(Float_Le(by0, ay0), 1) ThenBlock: { yzok = 0 }
                        IfCondition EqualTo(Float_Le(bz0, az0), 1) ThenBlock: { yzok = 0 }
                        IfCondition EqualTo(Float_Le(ay1, by1), 1) ThenBlock: { yzok = 0 }
                        IfCondition EqualTo(Float_Le(az1, bz1), 1) ThenBlock: { yzok = 0 }
                        xface = CAD_Num.IsEqual(bx0, ax0, 0)
                        IfCondition EqualTo(yzok, 1) ThenBlock: {
                            IfCondition EqualTo(xface, 1) ThenBlock: {
                                depthx = Float_Sub(bx1, ax0)
                                IfCondition EqualTo(Float_Le(depthx, 0), 1) ThenBlock: { depthx = 0 }
                                IfCondition EqualTo(Float_Le(Float_Sub(ax1, ax0), depthx), 1) ThenBlock: {
                                    depthx = Float_Sub(ax1, ax0)
                                }
                                IfCondition EqualTo(CAD_Num.IsZero(depthx, 0), 0) ThenBlock: {
                                    pack = Allocate(64)
                                    ArraySet(pack, 0, Float_Sub(ax1, ax0))
                                    ArraySet(pack, 1, Float_Sub(ay1, ay0))
                                    ArraySet(pack, 2, Float_Sub(az1, az0))
                                    ArraySet(pack, 3, Float_Sub(by0, ay0))
                                    ArraySet(pack, 4, Float_Sub(bz0, az0))
                                    ArraySet(pack, 5, Float_Sub(by1, ay0))
                                    ArraySet(pack, 6, Float_Sub(bz1, az0))
                                    ArraySet(pack, 7, depthx)
                                    out = Allocate(16)
                                    h_cut = CAD_Topo.MakeBoxRectNotchXSolid(pack, out)
                                    Deallocate(pack, 64)
                                    Deallocate(out, 16)
                                    IfCondition NotEqual(h_cut, 0) ThenBlock: {
                                        dlt = Allocate(32)
                                        ArraySet(dlt, 0, ax0)
                                        ArraySet(dlt, 1, ay0)
                                        ArraySet(dlt, 2, az0)
                                        CAD_Topo.TranslateSolid(h_cut, dlt)
                                        Deallocate(dlt, 32)
                                        Deallocate(mna, 32)
                                        Deallocate(mxa, 32)
                                        Deallocate(mnb, 32)
                                        Deallocate(mxb, 32)
                                        CAD_Bool_State.bool_count = Add(CAD_Bool_State.bool_count, 1)
                                        ReturnValue(h_cut)
                                    }
                                }
                            }
                        }
                    }
                }
                Deallocate(mna, 32)
                Deallocate(mxa, 32)
                Deallocate(mnb, 32)
                Deallocate(mxb, 32)
            }
        }

        // unsupported case — do not invent empty solid
        ReturnValue(0)
    }
}

// Vert extents only (view / pattern center). Not a solid model.
Function.CAD_Bool.SolidBounds {
    Input: solid_handle: Integer
    Input: min_addr: Address
    Input: max_addr: Address
    Output: Integer
    Body: {
        ReturnValue(CAD_Topo.SolidBounds(solid_handle, min_addr, max_addr))
    }
}

// Intersection A∩B. General kind-0 B-Rep bool not implemented (returns 0).
// Do not invent an axis-aligned box from extents.
Function.CAD_Bool.Intersection {
    Input: solid_a_handle: Integer
    Input: solid_b_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_a_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(solid_b_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(0)
    }
}
