// Prism cut: subtract the tool footprint from the host face.
// A profile fully inside the face stays a hole. Fully outside leaves the
// host. A profile that crosses the boundary removes only the overlap.
// Not a shape test. Lines and arcs use the same split.

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_BoolClipCut
LibraryImport.Cad.CAD_BoolClipVoid

FixedPool.CAD_Bool_Clip {
    "host": Initialize=0, CanChange=True
    "tool": Initialize=0, CanChange=True
    "f0": Initialize=0, CanChange=True
    "f1": Initialize=0, CanChange=True
    "hf0": Initialize=0, CanChange=True
    "hf1": Initialize=0, CanChange=True
    "face": Initialize=0, CanChange=True
    "sh": Initialize=0, CanChange=True
    "lp": Initialize=0, CanChange=True
    "ce": Initialize=0, CanChange=True
    "cf": Initialize=0, CanChange=True
    "v": Initialize=0, CanChange=True
    "n": Initialize=0, CanChange=True
    "g": Initialize=0, CanChange=True
    "ok": Initialize=0, CanChange=True
    "fg": Initialize=0, CanChange=True
    "px": Initialize=0, CanChange=True
    "py": Initialize=0, CanChange=True
    "pz": Initialize=0, CanChange=True
    "qx": Initialize=0, CanChange=True
    "qy": Initialize=0, CanChange=True
    "qz": Initialize=0, CanChange=True
    "u0": Initialize=0, CanChange=True
    "v0": Initialize=0, CanChange=True
    "u1": Initialize=0, CanChange=True
    "v1": Initialize=0, CanChange=True
    "ax": Initialize=0, CanChange=True
    "ay": Initialize=0, CanChange=True
    "bx": Initialize=0, CanChange=True
    "by": Initialize=0, CanChange=True
    "cx": Initialize=0, CanChange=True
    "cy": Initialize=0, CanChange=True
    "dx": Initialize=0, CanChange=True
    "dy": Initialize=0, CanChange=True
    "th": Initialize=0, CanChange=True
    "tt": Initialize=0, CanChange=True
    "oa": Initialize=0, CanChange=True
    "ob": Initialize=0, CanChange=True
    "nv": Initialize=0, CanChange=True
    "e2": Initialize=0, CanChange=True
    "c2": Initialize=0, CanChange=True
    "tw": Initialize=0, CanChange=True
    "tw2": Initialize=0, CanChange=True
    "w0": Initialize=0, CanChange=True
    "w1": Initialize=0, CanChange=True
    "sa": Initialize=0, CanChange=True
    "sb": Initialize=0, CanChange=True
    "ea": Initialize=0, CanChange=True
    "eb": Initialize=0, CanChange=True
    "a0": Initialize=0, CanChange=True
    "span": Initialize=0, CanChange=True
    "dist": Initialize=0, CanChange=True
    "dot": Initialize=0, CanChange=True
    "ox": Initialize=0, CanChange=True
    "oy": Initialize=0, CanChange=True
    "oz": Initialize=0, CanChange=True
    "nx": Initialize=0, CanChange=True
    "ny": Initialize=0, CanChange=True
    "nz": Initialize=0, CanChange=True
    "hi": Initialize=0, CanChange=True
    "nh": Initialize=0, CanChange=True
    "nt": Initialize=0, CanChange=True
    "idx": Initialize=0, CanChange=True
    "buf": Initialize=0, CanChange=True
    "pt": Initialize=0, CanChange=True
    "p1": Initialize=0, CanChange=True
    "fr": Initialize=0, CanChange=True
    "pl": Initialize=0, CanChange=True
    "pk": Initialize=0, CanChange=True
    "base": Initialize=0, CanChange=True
    "s0": Initialize=0, CanChange=True
    "s1": Initialize=0, CanChange=True
    "s2": Initialize=0, CanChange=True
    "s3": Initialize=0, CanChange=True
}

// Destination vertex of .ce. Does not write .ce, .nv, .w0, .w1, .idx, .cf.
Function.CAD_BoolClip.Dest {
    Output: Integer
    Body: {
        CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
        CAD_Bool_Clip.oa = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
        CAD_Bool_Clip.t0 = CAD_Store.Read(CAD_Bool_Clip.eb, 1)
        IfCondition EqualTo(CAD_Bool_Clip.oa, CAD_Bool_Clip.t0) ThenBlock: {
            CAD_Bool_Clip.t0 = CAD_Store.Read(CAD_Bool_Clip.eb, 0)
        }
        ReturnValue(CAD_Bool_Clip.t0)
    }
}

Function.CAD_BoolClip.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Bool_Clip.buf, 0) ThenBlock: { CAD_Bool_Clip.buf = Allocate(16384) }
        IfCondition EqualTo(CAD_Bool_Clip.pt, 0) ThenBlock: { CAD_Bool_Clip.pt = Allocate(32) }
        IfCondition EqualTo(CAD_Bool_Clip.p1, 0) ThenBlock: { CAD_Bool_Clip.p1 = Allocate(32) }
        IfCondition EqualTo(CAD_Bool_Clip.fr, 0) ThenBlock: { CAD_Bool_Clip.fr = Allocate(128) }
        IfCondition EqualTo(CAD_Bool_Clip.pl, 0) ThenBlock: { CAD_Bool_Clip.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Bool_Clip.buf, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.hi = 0
        ReturnValue(1)
    }
}

// Squared distance between vertex .v and point (.px,.py,.pz) → .dot
Function.CAD_BoolClip.D2 {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ax = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.v, 0), CAD_Bool_Clip.px)
        CAD_Bool_Clip.ay = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.v, 1), CAD_Bool_Clip.py)
        CAD_Bool_Clip.bx = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.v, 2), CAD_Bool_Clip.pz)
        CAD_Bool_Clip.dot = Float_Add(Float_Mul(CAD_Bool_Clip.ax, CAD_Bool_Clip.ax), Float_Mul(CAD_Bool_Clip.ay, CAD_Bool_Clip.ay))
        CAD_Bool_Clip.dot = Float_Add(CAD_Bool_Clip.dot, Float_Mul(CAD_Bool_Clip.bx, CAD_Bool_Clip.bx))
        ReturnValue(0)
    }
}

// .v vertex → UV (.ax,.ay) on plane .pl
Function.CAD_BoolClip.Proj {
    Output: Integer
    Body: {
        CAD_Bool_Clip.qx = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.v, 0), ArrayGet(CAD_Bool_Clip.pl, 1))
        CAD_Bool_Clip.qy = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.v, 1), ArrayGet(CAD_Bool_Clip.pl, 2))
        CAD_Bool_Clip.qz = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.v, 2), ArrayGet(CAD_Bool_Clip.pl, 3))
        CAD_Bool_Clip.ax = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, ArrayGet(CAD_Bool_Clip.pl, 4)), Float_Mul(CAD_Bool_Clip.qy, ArrayGet(CAD_Bool_Clip.pl, 5))), Float_Mul(CAD_Bool_Clip.qz, ArrayGet(CAD_Bool_Clip.pl, 6)))
        CAD_Bool_Clip.ay = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, ArrayGet(CAD_Bool_Clip.pl, 7)), Float_Mul(CAD_Bool_Clip.qy, ArrayGet(CAD_Bool_Clip.pl, 8))), Float_Mul(CAD_Bool_Clip.qz, ArrayGet(CAD_Bool_Clip.pl, 9)))
        ReturnValue(0)
    }
}

// Record (.px,.py,.pz). .nv is an existing vertex, or 0.
Function.CAD_BoolClip.Push {
    Output: Integer
    Body: {
        CAD_Bool_Clip.g = 0
        CAD_Bool_Clip.n = 0
        WhileLoop LessThan(CAD_Bool_Clip.n, CAD_Bool_Clip.hi) {
            CAD_Bool_Clip.idx = Multiply(CAD_Bool_Clip.n, 8)
            CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.idx, 512)
            CAD_Bool_Clip.ax = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.idx), CAD_Bool_Clip.px)
            CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.idx, 1)
            CAD_Bool_Clip.ay = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.idx), CAD_Bool_Clip.py)
            CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.idx, 1)
            CAD_Bool_Clip.bx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.idx), CAD_Bool_Clip.pz)
            CAD_Bool_Clip.dot = Float_Add(Float_Mul(CAD_Bool_Clip.ax, CAD_Bool_Clip.ax), Float_Mul(CAD_Bool_Clip.ay, CAD_Bool_Clip.ay))
            CAD_Bool_Clip.dot = Float_Add(CAD_Bool_Clip.dot, Float_Mul(CAD_Bool_Clip.bx, CAD_Bool_Clip.bx))
            CAD_Bool_Clip.dist = Float_Mul(0x3FA999999999999A, 0x3FA999999999999A)
            IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, CAD_Bool_Clip.dist), 1) ThenBlock: { CAD_Bool_Clip.g = 1 }
            CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
        }
        IfCondition EqualTo(CAD_Bool_Clip.g, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CAD_Bool_Clip.hi, 30) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.idx = Multiply(CAD_Bool_Clip.hi, 8)
        CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.idx, 512)
        ArraySet(CAD_Bool_Clip.buf, CAD_Bool_Clip.idx, CAD_Bool_Clip.px)
        CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.idx, 1)
        ArraySet(CAD_Bool_Clip.buf, CAD_Bool_Clip.idx, CAD_Bool_Clip.py)
        CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.idx, 1)
        ArraySet(CAD_Bool_Clip.buf, CAD_Bool_Clip.idx, CAD_Bool_Clip.pz)
        CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.idx, 1)
        ArraySet(CAD_Bool_Clip.buf, CAD_Bool_Clip.idx, CAD_Bool_Clip.nv)
        CAD_Bool_Clip.hi = Add(CAD_Bool_Clip.hi, 1)
        ReturnValue(1)
    }
}

// Angle of point (.px,.py,.pz) on circle curve .eb → .a0
Function.CAD_BoolClip.Ang {
    Output: Integer
    Body: {
        CAD_Bool_Clip.qx = Float_Sub(CAD_Bool_Clip.px, CAD_Store.Read(CAD_Bool_Clip.eb, 1))
        CAD_Bool_Clip.qy = Float_Sub(CAD_Bool_Clip.py, CAD_Store.Read(CAD_Bool_Clip.eb, 2))
        CAD_Bool_Clip.qz = Float_Sub(CAD_Bool_Clip.pz, CAD_Store.Read(CAD_Bool_Clip.eb, 3))
        CAD_Bool_Clip.ax = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Store.Read(CAD_Bool_Clip.eb, 4)), Float_Mul(CAD_Bool_Clip.qy, CAD_Store.Read(CAD_Bool_Clip.eb, 5))), Float_Mul(CAD_Bool_Clip.qz, CAD_Store.Read(CAD_Bool_Clip.eb, 6)))
        CAD_Bool_Clip.ay = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Store.Read(CAD_Bool_Clip.eb, 7)), Float_Mul(CAD_Bool_Clip.qy, CAD_Store.Read(CAD_Bool_Clip.eb, 8))), Float_Mul(CAD_Bool_Clip.qz, CAD_Store.Read(CAD_Bool_Clip.eb, 9)))
        CAD_Bool_Clip.a0 = CAD_Geom.Atan2(CAD_Bool_Clip.ay, CAD_Bool_Clip.ax)
        ReturnValue(0)
    }
}

// 1 when angle .a0 lies on circle .eb (a0 + signed span).
Function.CAD_BoolClip.OnArc {
    Output: Integer
    Body: {
        CAD_Bool_Clip.span = CAD_Store.Read(CAD_Bool_Clip.eb, 12)
        CAD_Bool_Clip.ax = CAD_Store.Read(CAD_Bool_Clip.eb, 11)
        CAD_Bool_Clip.bx = Float_Sub(CAD_Bool_Clip.a0, CAD_Bool_Clip.ax)
        CAD_Bool_Clip.ob = 0
        WhileLoop LessThan(CAD_Bool_Clip.ob, 6) {
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.span), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.bx), 1) ThenBlock: {
                    CAD_Bool_Clip.bx = Float_Add(CAD_Bool_Clip.bx, 0x401921FB54442D18)
                }
                IfCondition EqualTo(CAD_Num.Le(0x401921FB54442D18, CAD_Bool_Clip.bx), 1) ThenBlock: {
                    CAD_Bool_Clip.bx = Float_Sub(CAD_Bool_Clip.bx, 0x401921FB54442D18)
                }
            }
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.span), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.bx), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.bx, 0), 0) ThenBlock: {
                        CAD_Bool_Clip.bx = Float_Sub(CAD_Bool_Clip.bx, 0x401921FB54442D18)
                    }
                }
                IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.bx, 0xC01921FB54442D18), 1) ThenBlock: {
                    CAD_Bool_Clip.bx = Float_Add(CAD_Bool_Clip.bx, 0x401921FB54442D18)
                }
            }
            CAD_Bool_Clip.ob = Add(CAD_Bool_Clip.ob, 1)
        }
        CAD_Bool_Clip.ok = 0
        CAD_Bool_Clip.ay = CAD_Num.Abs(CAD_Bool_Clip.span)
        // MakeCircle stores span 0 for a full turn. |span| near 2π is the same.
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Clip.span, 0), 1) ThenBlock: { CAD_Bool_Clip.ok = 1 }
        IfCondition EqualTo(CAD_Num.Le(0x4019000000000000, CAD_Bool_Clip.ay), 1) ThenBlock: { CAD_Bool_Clip.ok = 1 }
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.span), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.bx, Float_Add(CAD_Bool_Clip.span, 0x3F847AE147AE147B)), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(Float_Sub(0, 0x3F847AE147AE147B), CAD_Bool_Clip.bx), 1) ThenBlock: { CAD_Bool_Clip.ok = 1 }
                }
            }
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.span), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(Float_Sub(CAD_Bool_Clip.span, 0x3F847AE147AE147B), CAD_Bool_Clip.bx), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.bx, 0x3F847AE147AE147B), 1) ThenBlock: { CAD_Bool_Clip.ok = 1 }
                }
            }
        }
        ReturnValue(CAD_Bool_Clip.ok)
    }
}

// Line coedge .ce × line coedge .cf. Pushes crossings. Host is .ce.
Function.CAD_BoolClip.LineLine {
    Output: Integer
    Body: {
        CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
        CAD_BoolClip.Proj()
        CAD_Bool_Clip.u0 = CAD_Bool_Clip.ax
        CAD_Bool_Clip.v0 = CAD_Bool_Clip.ay
        CAD_Bool_Clip.w0 = CAD_Bool_Clip.v
        CAD_Bool_Clip.sa = CAD_Bool_Clip.ce
        CAD_Bool_Clip.ce = CAD_Bool_Clip.sa
        CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
        CAD_Bool_Clip.v = CAD_Bool_Clip.t0
        CAD_BoolClip.Proj()
        CAD_Bool_Clip.u1 = CAD_Bool_Clip.ax
        CAD_Bool_Clip.v1 = CAD_Bool_Clip.ay
        CAD_Bool_Clip.w1 = CAD_Bool_Clip.v
        CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.cf, 5)
        CAD_BoolClip.Proj()
        CAD_Bool_Clip.cx = CAD_Bool_Clip.ax
        CAD_Bool_Clip.cy = CAD_Bool_Clip.ay
        CAD_Bool_Clip.ea = CAD_Bool_Clip.v
        CAD_Bool_Clip.ce = CAD_Bool_Clip.cf
        CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
        CAD_Bool_Clip.v = CAD_Bool_Clip.t0
        CAD_BoolClip.Proj()
        CAD_Bool_Clip.dx = CAD_Bool_Clip.ax
        CAD_Bool_Clip.dy = CAD_Bool_Clip.ay
        CAD_Bool_Clip.eb = CAD_Bool_Clip.v
        CAD_Bool_Clip.ax = Float_Sub(CAD_Bool_Clip.u1, CAD_Bool_Clip.u0)
        CAD_Bool_Clip.ay = Float_Sub(CAD_Bool_Clip.v1, CAD_Bool_Clip.v0)
        CAD_Bool_Clip.bx = Float_Sub(CAD_Bool_Clip.dx, CAD_Bool_Clip.cx)
        CAD_Bool_Clip.by = Float_Sub(CAD_Bool_Clip.dy, CAD_Bool_Clip.cy)
        CAD_Bool_Clip.dist = Float_Sub(Float_Mul(CAD_Bool_Clip.ax, CAD_Bool_Clip.by), Float_Mul(CAD_Bool_Clip.ay, CAD_Bool_Clip.bx))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Clip.dist, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.qx = Float_Sub(CAD_Bool_Clip.cx, CAD_Bool_Clip.u0)
        CAD_Bool_Clip.qy = Float_Sub(CAD_Bool_Clip.cy, CAD_Bool_Clip.v0)
        CAD_Bool_Clip.th = Float_Div(Float_Sub(Float_Mul(CAD_Bool_Clip.qx, CAD_Bool_Clip.by), Float_Mul(CAD_Bool_Clip.qy, CAD_Bool_Clip.bx)), CAD_Bool_Clip.dist)
        CAD_Bool_Clip.tt = Float_Div(Float_Sub(Float_Mul(CAD_Bool_Clip.qx, CAD_Bool_Clip.ay), Float_Mul(CAD_Bool_Clip.qy, CAD_Bool_Clip.ax)), CAD_Bool_Clip.dist)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.th, 0xBF647AE147AE147B), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(0x3FF00A3D70A3D70A, CAD_Bool_Clip.th), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.tt, 0xBF647AE147AE147B), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(0x3FF00A3D70A3D70A, CAD_Bool_Clip.tt), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.th), 1) ThenBlock: { CAD_Bool_Clip.th = 0 }
        IfCondition EqualTo(CAD_Num.Le(0x3FF0000000000000, CAD_Bool_Clip.th), 1) ThenBlock: { CAD_Bool_Clip.th = 0x3FF0000000000000 }
        CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.w0, 0)
        CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.w0, 1)
        CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.w0, 2)
        CAD_Bool_Clip.px = Float_Add(CAD_Bool_Clip.px, Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 0), CAD_Bool_Clip.px)))
        CAD_Bool_Clip.py = Float_Add(CAD_Bool_Clip.py, Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 1), CAD_Bool_Clip.py)))
        CAD_Bool_Clip.pz = Float_Add(CAD_Bool_Clip.pz, Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 2), CAD_Bool_Clip.pz)))
        CAD_Bool_Clip.nv = 0
        CAD_Bool_Clip.dot = Float_Mul(0x3FA999999999999A, 0x3FA999999999999A)
        CAD_Bool_Clip.v = CAD_Bool_Clip.ea
        CAD_BoolClip.D2()
        CAD_Bool_Clip.dist = Float_Mul(0x3FA999999999999A, 0x3FA999999999999A)
        CAD_Bool_Clip.v = CAD_Bool_Clip.ea
        CAD_BoolClip.D2()
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, CAD_Bool_Clip.dist), 1) ThenBlock: { CAD_Bool_Clip.nv = CAD_Bool_Clip.ea }
        IfCondition EqualTo(CAD_Bool_Clip.nv, 0) ThenBlock: {
            CAD_Bool_Clip.v = CAD_Bool_Clip.eb
            CAD_BoolClip.D2()
            IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, CAD_Bool_Clip.dist), 1) ThenBlock: { CAD_Bool_Clip.nv = CAD_Bool_Clip.eb }
        }
        IfCondition EqualTo(CAD_Bool_Clip.nv, 0) ThenBlock: {
            CAD_Bool_Clip.v = CAD_Bool_Clip.w0
            CAD_BoolClip.D2()
            IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, CAD_Bool_Clip.dist), 1) ThenBlock: { CAD_Bool_Clip.nv = CAD_Bool_Clip.w0 }
        }
        IfCondition EqualTo(CAD_Bool_Clip.nv, 0) ThenBlock: {
            CAD_Bool_Clip.v = CAD_Bool_Clip.w1
            CAD_BoolClip.D2()
            IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, CAD_Bool_Clip.dist), 1) ThenBlock: { CAD_Bool_Clip.nv = CAD_Bool_Clip.w1 }
        }
        CAD_BoolClip.Push()
        ReturnValue(1)
    }
}

// Put circle point at angle .a0 on curve .eb into .px .py .pz
Function.CAD_BoolClip.CircPt {
    Output: Integer
    Body: {
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 888)
        CAD_Bool_Clip.a0 = ArrayGet(CAD_Bool_Clip.buf, 885)
        CAD_Bool_Clip.qx = CAD_Geom.Cos(CAD_Bool_Clip.a0)
        CAD_Bool_Clip.a0 = ArrayGet(CAD_Bool_Clip.buf, 885)
        CAD_Bool_Clip.qy = CAD_Geom.Sin(CAD_Bool_Clip.a0)
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 888)
        CAD_Bool_Clip.nx = CAD_Store.Read(CAD_Bool_Clip.eb, 10)
        CAD_Bool_Clip.px = Float_Add(CAD_Store.Read(CAD_Bool_Clip.eb, 1), Float_Mul(CAD_Bool_Clip.nx, Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Store.Read(CAD_Bool_Clip.eb, 4)), Float_Mul(CAD_Bool_Clip.qy, CAD_Store.Read(CAD_Bool_Clip.eb, 7)))))
        CAD_Bool_Clip.py = Float_Add(CAD_Store.Read(CAD_Bool_Clip.eb, 2), Float_Mul(CAD_Bool_Clip.nx, Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Store.Read(CAD_Bool_Clip.eb, 5)), Float_Mul(CAD_Bool_Clip.qy, CAD_Store.Read(CAD_Bool_Clip.eb, 8)))))
        CAD_Bool_Clip.pz = Float_Add(CAD_Store.Read(CAD_Bool_Clip.eb, 3), Float_Mul(CAD_Bool_Clip.nx, Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Store.Read(CAD_Bool_Clip.eb, 6)), Float_Mul(CAD_Bool_Clip.qy, CAD_Store.Read(CAD_Bool_Clip.eb, 9)))))
        ReturnValue(0)
    }
}

// Line .ce × circle .cf. Two roots at most.
Function.CAD_BoolClip.LineArc {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.cf, 0)
        CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.ea, 2)
        IfCondition EqualTo(CAD_Bool_Clip.eb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Bool_Clip.eb, 0), 2) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 974, CAD_Bool_Clip.eb)
        CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
        CAD_Bool_Clip.sa = CAD_Bool_Clip.ce
        CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
        CAD_Bool_Clip.w1 = CAD_Bool_Clip.t0
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 974)
        CAD_Bool_Clip.qx = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w0, 0), CAD_Store.Read(CAD_Bool_Clip.eb, 1))
        CAD_Bool_Clip.qy = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w0, 1), CAD_Store.Read(CAD_Bool_Clip.eb, 2))
        CAD_Bool_Clip.qz = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w0, 2), CAD_Store.Read(CAD_Bool_Clip.eb, 3))
        CAD_Bool_Clip.u0 = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Store.Read(CAD_Bool_Clip.eb, 4)), Float_Mul(CAD_Bool_Clip.qy, CAD_Store.Read(CAD_Bool_Clip.eb, 5))), Float_Mul(CAD_Bool_Clip.qz, CAD_Store.Read(CAD_Bool_Clip.eb, 6)))
        CAD_Bool_Clip.v0 = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Store.Read(CAD_Bool_Clip.eb, 7)), Float_Mul(CAD_Bool_Clip.qy, CAD_Store.Read(CAD_Bool_Clip.eb, 8))), Float_Mul(CAD_Bool_Clip.qz, CAD_Store.Read(CAD_Bool_Clip.eb, 9)))
        CAD_Bool_Clip.qx = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 0), CAD_Store.Read(CAD_Bool_Clip.w0, 0))
        CAD_Bool_Clip.qy = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 1), CAD_Store.Read(CAD_Bool_Clip.w0, 1))
        CAD_Bool_Clip.qz = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 2), CAD_Store.Read(CAD_Bool_Clip.w0, 2))
        CAD_Bool_Clip.u1 = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Store.Read(CAD_Bool_Clip.eb, 4)), Float_Mul(CAD_Bool_Clip.qy, CAD_Store.Read(CAD_Bool_Clip.eb, 5))), Float_Mul(CAD_Bool_Clip.qz, CAD_Store.Read(CAD_Bool_Clip.eb, 6)))
        CAD_Bool_Clip.v1 = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Store.Read(CAD_Bool_Clip.eb, 7)), Float_Mul(CAD_Bool_Clip.qy, CAD_Store.Read(CAD_Bool_Clip.eb, 8))), Float_Mul(CAD_Bool_Clip.qz, CAD_Store.Read(CAD_Bool_Clip.eb, 9)))
        CAD_Bool_Clip.ax = Float_Add(Float_Mul(CAD_Bool_Clip.u1, CAD_Bool_Clip.u1), Float_Mul(CAD_Bool_Clip.v1, CAD_Bool_Clip.v1))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Clip.ax, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ay = Float_Add(Float_Mul(CAD_Bool_Clip.u0, CAD_Bool_Clip.u1), Float_Mul(CAD_Bool_Clip.v0, CAD_Bool_Clip.v1))
        CAD_Bool_Clip.nx = CAD_Store.Read(CAD_Bool_Clip.eb, 10)
        CAD_Bool_Clip.bx = Float_Sub(Float_Add(Float_Mul(CAD_Bool_Clip.u0, CAD_Bool_Clip.u0), Float_Mul(CAD_Bool_Clip.v0, CAD_Bool_Clip.v0)), Float_Mul(CAD_Bool_Clip.nx, CAD_Bool_Clip.nx))
        CAD_Bool_Clip.dist = Float_Sub(Float_Mul(CAD_Bool_Clip.ay, CAD_Bool_Clip.ay), Float_Mul(CAD_Bool_Clip.ax, CAD_Bool_Clip.bx))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.dist), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.cy = CAD_Num.Sqrt(CAD_Bool_Clip.dist)
        CAD_Bool_Clip.th = Float_Sub(CAD_Bool_Clip.cy, CAD_Bool_Clip.ay)
        CAD_Bool_Clip.th = Float_Div(CAD_Bool_Clip.th, CAD_Bool_Clip.ax)
        ArraySet(CAD_Bool_Clip.buf, 975, CAD_Bool_Clip.th)
        CAD_Bool_Clip.th = Float_Sub(0, CAD_Bool_Clip.cy)
        CAD_Bool_Clip.th = Float_Sub(CAD_Bool_Clip.th, CAD_Bool_Clip.ay)
        CAD_Bool_Clip.th = Float_Div(CAD_Bool_Clip.th, CAD_Bool_Clip.ax)
        ArraySet(CAD_Bool_Clip.buf, 976, CAD_Bool_Clip.th)
        CAD_Bool_Clip.c2 = 0
        WhileLoop LessThan(CAD_Bool_Clip.c2, 2) {
            CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, Add(975, CAD_Bool_Clip.c2))
            CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 974)
            IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.th, 0xBF647AE147AE147B), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(0x3FF00A3D70A3D70A, CAD_Bool_Clip.th), 0) ThenBlock: {
                    CAD_Bool_Clip.px = Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 0), Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 0), CAD_Store.Read(CAD_Bool_Clip.w0, 0))))
                    CAD_Bool_Clip.py = Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 1), Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 1), CAD_Store.Read(CAD_Bool_Clip.w0, 1))))
                    CAD_Bool_Clip.pz = Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 2), Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 2), CAD_Store.Read(CAD_Bool_Clip.w0, 2))))
                    CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 974)
                    CAD_BoolClip.Ang()
                    CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 974)
                    CAD_Bool_Clip.s0 = CAD_BoolClip.OnArc()
                    IfCondition EqualTo(CAD_Bool_Clip.s0, 1) ThenBlock: {
                        CAD_Bool_Clip.nv = 0
                        CAD_Bool_Clip.dist = Float_Mul(0x3FA999999999999A, 0x3FA999999999999A)
                        CAD_Bool_Clip.v = CAD_Bool_Clip.w0
                        CAD_BoolClip.D2()
                        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, CAD_Bool_Clip.dist), 1) ThenBlock: { CAD_Bool_Clip.nv = CAD_Bool_Clip.w0 }
                        IfCondition EqualTo(CAD_Bool_Clip.nv, 0) ThenBlock: {
                            CAD_Bool_Clip.v = CAD_Bool_Clip.w1
                            CAD_BoolClip.D2()
                            IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, CAD_Bool_Clip.dist), 1) ThenBlock: { CAD_Bool_Clip.nv = CAD_Bool_Clip.w1 }
                        }
                        CAD_BoolClip.Push()
                    }
                }
            }
            CAD_Bool_Clip.c2 = Add(CAD_Bool_Clip.c2, 1)
        }
        ReturnValue(1)
    }
}

// Curve kind of coedge .ce → .ok (0 if none).
Function.CAD_BoolClip.Kind {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ok = 0
        CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
        IfCondition EqualTo(CAD_Bool_Clip.ea, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.ea, 2)
        IfCondition EqualTo(CAD_Bool_Clip.eb, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ok = CAD_Store.Read(CAD_Bool_Clip.eb, 0)
        ReturnValue(CAD_Bool_Clip.ok)
    }
}

// Every host loop × every tool outer coedge. A hole edge is a boundary.
// Walkers live in buf[910..913]. buf[904] is the next host loop.
// buf[908] is the host loop count. Push overwrites .n, .idx, and .g.
Function.CAD_BoolClip.Gather {
    Output: Integer
    Body: {
        CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.hf0, 1)
        IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.f0, 1)
        IfCondition EqualTo(CAD_Bool_Clip.sh, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 913, CAD_Store.Read(CAD_Bool_Clip.sh, 0))
        ArraySet(CAD_Bool_Clip.buf, 908, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 908), 8) {
            IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(CAD_Bool_Clip.hi) }
            ArraySet(CAD_Bool_Clip.buf, 904, CAD_Store.Read(CAD_Bool_Clip.lp, 2))
            ArraySet(CAD_Bool_Clip.buf, 912, CAD_Store.Read(CAD_Bool_Clip.lp, 0))
            ArraySet(CAD_Bool_Clip.buf, 910, ArrayGet(CAD_Bool_Clip.buf, 912))
            CAD_Bool_Clip.nh = 0
            WhileLoop LessThan(CAD_Bool_Clip.nh, 64) {
            ArraySet(CAD_Bool_Clip.buf, 911, ArrayGet(CAD_Bool_Clip.buf, 913))
            CAD_Bool_Clip.nt = 0
            WhileLoop LessThan(CAD_Bool_Clip.nt, 64) {
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 910)
                CAD_Bool_Clip.s1 = CAD_BoolClip.Kind()
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 911)
                CAD_Bool_Clip.s2 = CAD_BoolClip.Kind()
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 910)
                CAD_Bool_Clip.cf = ArrayGet(CAD_Bool_Clip.buf, 911)
                IfCondition NotEqual(CAD_Bool_Clip.s1, 2) ThenBlock: {
                    IfCondition NotEqual(CAD_Bool_Clip.s2, 2) ThenBlock: { CAD_BoolClip.LineLine() }
                    IfCondition EqualTo(CAD_Bool_Clip.s2, 2) ThenBlock: { CAD_BoolClip.LineArc() }
                }
                IfCondition EqualTo(CAD_Bool_Clip.s1, 2) ThenBlock: {
                    IfCondition NotEqual(CAD_Bool_Clip.s2, 2) ThenBlock: {
                        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 911)
                        CAD_Bool_Clip.cf = ArrayGet(CAD_Bool_Clip.buf, 910)
                        CAD_BoolClip.LineArc()
                    }
                }
                CAD_Bool_Clip.ea = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 911), 2)
                ArraySet(CAD_Bool_Clip.buf, 911, CAD_Bool_Clip.ea)
                IfCondition EqualTo(CAD_Bool_Clip.ea, ArrayGet(CAD_Bool_Clip.buf, 913)) ThenBlock: { CAD_Bool_Clip.nt = 64 }
                IfCondition EqualTo(CAD_Bool_Clip.ea, 0) ThenBlock: { CAD_Bool_Clip.nt = 64 }
                CAD_Bool_Clip.nt = Add(CAD_Bool_Clip.nt, 1)
            }
            CAD_Bool_Clip.ea = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 910), 2)
            ArraySet(CAD_Bool_Clip.buf, 910, CAD_Bool_Clip.ea)
            IfCondition EqualTo(CAD_Bool_Clip.ea, ArrayGet(CAD_Bool_Clip.buf, 912)) ThenBlock: { CAD_Bool_Clip.nh = 64 }
            IfCondition EqualTo(CAD_Bool_Clip.ea, 0) ThenBlock: { CAD_Bool_Clip.nh = 64 }
            CAD_Bool_Clip.nh = Add(CAD_Bool_Clip.nh, 1)
            }
            CAD_Bool_Clip.lp = ArrayGet(CAD_Bool_Clip.buf, 904)
            ArraySet(CAD_Bool_Clip.buf, 908, Add(ArrayGet(CAD_Bool_Clip.buf, 908), 1))
        }
        ReturnValue(CAD_Bool_Clip.hi)
    }
}

// Point at fraction .th along coedge .ce → .px .py .pz.
// Kind() drops .ce. The coedge is reloaded from buf[889].
Function.CAD_BoolClip.At {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 889, CAD_Bool_Clip.ce)
        ArraySet(CAD_Bool_Clip.buf, 887, CAD_Bool_Clip.th)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 889)
        CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
        ArraySet(CAD_Bool_Clip.buf, 884, CAD_Bool_Clip.w0)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 889)
        CAD_Bool_Clip.s1 = CAD_BoolClip.Kind()
        IfCondition NotEqual(CAD_Bool_Clip.s1, 2) ThenBlock: {
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 889)
            CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
            CAD_Bool_Clip.w1 = CAD_Bool_Clip.t0
            CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, 884)
            CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 887)
            CAD_Bool_Clip.px = Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 0), Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 0), CAD_Store.Read(CAD_Bool_Clip.w0, 0))))
            CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, 884)
            CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 887)
            CAD_Bool_Clip.py = Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 1), Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 1), CAD_Store.Read(CAD_Bool_Clip.w0, 1))))
            CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, 884)
            CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 887)
            CAD_Bool_Clip.pz = Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 2), Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 2), CAD_Store.Read(CAD_Bool_Clip.w0, 2))))
            ReturnValue(1)
        }
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 889)
        CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
        CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.ea, 2)
        ArraySet(CAD_Bool_Clip.buf, 888, CAD_Bool_Clip.eb)
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 888)
        ArraySet(CAD_Bool_Clip.buf, 886, CAD_Store.Read(CAD_Bool_Clip.eb, 12))
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 888)
        ArraySet(CAD_Bool_Clip.buf, 885, CAD_Store.Read(CAD_Bool_Clip.eb, 11))
        CAD_Bool_Clip.span = ArrayGet(CAD_Bool_Clip.buf, 886)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Clip.span, 0), 1) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 886, 0x401921FB54442D18)
        }
        CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 887)
        CAD_Bool_Clip.span = ArrayGet(CAD_Bool_Clip.buf, 886)
        CAD_Bool_Clip.bx = Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.span)
        CAD_Bool_Clip.ax = ArrayGet(CAD_Bool_Clip.buf, 885)
        ArraySet(CAD_Bool_Clip.buf, 885, Float_Add(CAD_Bool_Clip.ax, CAD_Bool_Clip.bx))
        CAD_BoolClip.CircPt()
        ReturnValue(1)
    }
}

// 1 when .face's outer loop has a circle coedge. Does not write the walkers
// Class, DropHost, Steal, and Rewire keep across Inn (.n .cf .g .fg .nh .nt
// .lp .idx .sa .pk .face).
Function.CAD_BoolClip.HasArc {
    Output: Integer
    Body: {
        CAD_Bool_Clip.s0 = 0
        CAD_Bool_Clip.w1 = CAD_Store.Read(CAD_Bool_Clip.face, 1)
        IfCondition EqualTo(CAD_Bool_Clip.w1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.w1, 0)
        ArraySet(CAD_Bool_Clip.buf, 946, CAD_Bool_Clip.w0)
        CAD_Bool_Clip.ob = 0
        WhileLoop LessThan(CAD_Bool_Clip.ob, 64) {
            IfCondition EqualTo(CAD_Bool_Clip.w0, 0) ThenBlock: { ReturnValue(CAD_Bool_Clip.s0) }
            CAD_Bool_Clip.e2 = CAD_Store.Read(CAD_Bool_Clip.w0, 0)
            IfCondition NotEqual(CAD_Bool_Clip.e2, 0) ThenBlock: {
                CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.e2, 2)
                IfCondition NotEqual(CAD_Bool_Clip.eb, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.eb, 0), 2) ThenBlock: { CAD_Bool_Clip.s0 = 1 }
                }
            }
            CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.w0, 2)
            IfCondition EqualTo(CAD_Bool_Clip.w0, ArrayGet(CAD_Bool_Clip.buf, 946)) ThenBlock: { ReturnValue(CAD_Bool_Clip.s0) }
            CAD_Bool_Clip.ob = Add(CAD_Bool_Clip.ob, 1)
        }
        ReturnValue(CAD_Bool_Clip.s0)
    }
}

// Vertex .v → plane .fr UV in .u0 .v0.
Function.CAD_BoolClip.Uv {
    Output: Integer
    Body: {
        CAD_Bool_Clip.qx = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.v, 0), ArrayGet(CAD_Bool_Clip.fr, 1))
        CAD_Bool_Clip.qy = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.v, 1), ArrayGet(CAD_Bool_Clip.fr, 2))
        CAD_Bool_Clip.qz = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.v, 2), ArrayGet(CAD_Bool_Clip.fr, 3))
        CAD_Bool_Clip.u0 = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, ArrayGet(CAD_Bool_Clip.fr, 4)), Float_Mul(CAD_Bool_Clip.qy, ArrayGet(CAD_Bool_Clip.fr, 5))), Float_Mul(CAD_Bool_Clip.qz, ArrayGet(CAD_Bool_Clip.fr, 6)))
        CAD_Bool_Clip.v0 = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, ArrayGet(CAD_Bool_Clip.fr, 7)), Float_Mul(CAD_Bool_Clip.qy, ArrayGet(CAD_Bool_Clip.fr, 8))), Float_Mul(CAD_Bool_Clip.qz, ArrayGet(CAD_Bool_Clip.fr, 9)))
        ReturnValue(0)
    }
}

// Even-odd of segment (.u0,.v0)→(.u1,.v1) against the ray at buf[936], buf[937].
// Counts an edge when exactly one end is strictly below the ray, so a vertex
// on the ray is counted once. Toggles .s0.
Function.CAD_BoolClip.LineRay {
    Output: Integer
    Body: {
        CAD_Bool_Clip.dx = ArrayGet(CAD_Bool_Clip.buf, 937)
        CAD_Bool_Clip.ok = 0
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dx, CAD_Bool_Clip.v0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dx, CAD_Bool_Clip.v1), 1) ThenBlock: { CAD_Bool_Clip.ok = 1 }
        }
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dx, CAD_Bool_Clip.v1), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dx, CAD_Bool_Clip.v0), 1) ThenBlock: { CAD_Bool_Clip.ok = 1 }
        }
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.v1, CAD_Bool_Clip.v0)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Clip.dy, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.th = Float_Div(Float_Sub(CAD_Bool_Clip.dx, CAD_Bool_Clip.v0), CAD_Bool_Clip.dy)
        CAD_Bool_Clip.cx = Float_Add(CAD_Bool_Clip.u0, Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Bool_Clip.u1, CAD_Bool_Clip.u0)))
        IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 936), CAD_Bool_Clip.cx), 1) ThenBlock: {
            CAD_Bool_Clip.s0 = Subtract(1, CAD_Bool_Clip.s0)
        }
        ReturnValue(CAD_Bool_Clip.s0)
    }
}

// World point of plane UV (.u1, buf[937]) on curve buf[938]. Toggle .s0 when
// that point lies on the arc and is not an endpoint of coedge .w0.
Function.CAD_BoolClip.ArcHit {
    Output: Integer
    Body: {
        CAD_Bool_Clip.dy = ArrayGet(CAD_Bool_Clip.buf, 937)
        CAD_Bool_Clip.px = Float_Add(ArrayGet(CAD_Bool_Clip.fr, 1), Float_Add(Float_Mul(CAD_Bool_Clip.u1, ArrayGet(CAD_Bool_Clip.fr, 4)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.fr, 7))))
        CAD_Bool_Clip.py = Float_Add(ArrayGet(CAD_Bool_Clip.fr, 2), Float_Add(Float_Mul(CAD_Bool_Clip.u1, ArrayGet(CAD_Bool_Clip.fr, 5)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.fr, 8))))
        CAD_Bool_Clip.pz = Float_Add(ArrayGet(CAD_Bool_Clip.fr, 3), Float_Add(Float_Mul(CAD_Bool_Clip.u1, ArrayGet(CAD_Bool_Clip.fr, 6)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.fr, 9))))
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 938)
        CAD_BoolClip.Ang()
        ArraySet(CAD_Bool_Clip.buf, 939, CAD_Bool_Clip.ob)
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 938)
        CAD_Bool_Clip.ok = CAD_BoolClip.OnArc()
        CAD_Bool_Clip.ob = ArrayGet(CAD_Bool_Clip.buf, 939)
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.e2 = CAD_Store.Read(CAD_Bool_Clip.w0, 0)
        CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.e2, 0)
        CAD_BoolClip.D2()
        CAD_Bool_Clip.dx = CAD_Bool_Clip.dot
        CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.e2, 1)
        CAD_BoolClip.D2()
        CAD_Bool_Clip.dist = Float_Mul(0x3FA999999999999A, 0x3FA999999999999A)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dx, CAD_Bool_Clip.dist), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, CAD_Bool_Clip.dist), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.s0 = Subtract(1, CAD_Bool_Clip.s0)
        ReturnValue(1)
    }
}

// Ray at buf[936], buf[937] against circle buf[938]. Two roots. Toggles .s0.
Function.CAD_BoolClip.ArcRay {
    Output: Integer
    Body: {
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 938), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.c2 = 0
        WhileLoop LessThan(CAD_Bool_Clip.c2, 2) {
            CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 938)
            CAD_Bool_Clip.qx = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.eb, 1), ArrayGet(CAD_Bool_Clip.fr, 1))
            CAD_Bool_Clip.qy = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.eb, 2), ArrayGet(CAD_Bool_Clip.fr, 2))
            CAD_Bool_Clip.qz = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.eb, 3), ArrayGet(CAD_Bool_Clip.fr, 3))
            ArraySet(CAD_Bool_Clip.buf, 948, Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, ArrayGet(CAD_Bool_Clip.fr, 4)), Float_Mul(CAD_Bool_Clip.qy, ArrayGet(CAD_Bool_Clip.fr, 5))), Float_Mul(CAD_Bool_Clip.qz, ArrayGet(CAD_Bool_Clip.fr, 6))))
            CAD_Bool_Clip.cy = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, ArrayGet(CAD_Bool_Clip.fr, 7)), Float_Mul(CAD_Bool_Clip.qy, ArrayGet(CAD_Bool_Clip.fr, 8))), Float_Mul(CAD_Bool_Clip.qz, ArrayGet(CAD_Bool_Clip.fr, 9)))
            CAD_Bool_Clip.dx = CAD_Store.Read(CAD_Bool_Clip.eb, 10)
            CAD_Bool_Clip.dy = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 937), CAD_Bool_Clip.cy)
            CAD_Bool_Clip.nx = Float_Sub(Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.dx), Float_Mul(CAD_Bool_Clip.dy, CAD_Bool_Clip.dy))
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.nx), 0) ThenBlock: {
                CAD_Bool_Clip.th = CAD_Num.Sqrt(CAD_Bool_Clip.nx)
                CAD_Bool_Clip.u1 = Float_Add(ArrayGet(CAD_Bool_Clip.buf, 948), CAD_Bool_Clip.th)
                IfCondition EqualTo(CAD_Bool_Clip.c2, 1) ThenBlock: {
                    CAD_Bool_Clip.u1 = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 948), CAD_Bool_Clip.th)
                }
                IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 936), CAD_Bool_Clip.u1), 1) ThenBlock: {
                    CAD_BoolClip.ArcHit()
                }
            }
            CAD_Bool_Clip.c2 = Add(CAD_Bool_Clip.c2, 1)
        }
        ReturnValue(CAD_Bool_Clip.s0)
    }
}

// 1 inside, 0 outside, -1 when the outer loop is not one circle.
// A split circle is still one circle. The radius test does not depend on
// which vertex the +U ray happens to pass through.
Function.CAD_BoolClip.DiskIn {
    Output: Integer
    Body: {
        CAD_Bool_Clip.w1 = CAD_Store.Read(CAD_Bool_Clip.face, 1)
        IfCondition EqualTo(CAD_Bool_Clip.w1, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.w1, 0)
        IfCondition EqualTo(CAD_Bool_Clip.w0, 0) ThenBlock: { ReturnValue(-1) }
        ArraySet(CAD_Bool_Clip.buf, 946, CAD_Bool_Clip.w0)
        ArraySet(CAD_Bool_Clip.buf, 954, 0)
        CAD_Bool_Clip.ob = 0
        WhileLoop LessThan(CAD_Bool_Clip.ob, 64) {
            IfCondition EqualTo(CAD_Bool_Clip.w0, 0) ThenBlock: { ReturnValue(-1) }
            CAD_Bool_Clip.e2 = CAD_Store.Read(CAD_Bool_Clip.w0, 0)
            IfCondition EqualTo(CAD_Bool_Clip.e2, 0) ThenBlock: { ReturnValue(-1) }
            CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.e2, 2)
            IfCondition EqualTo(CAD_Bool_Clip.eb, 0) ThenBlock: { ReturnValue(-1) }
            IfCondition NotEqual(CAD_Store.Read(CAD_Bool_Clip.eb, 0), 2) ThenBlock: { ReturnValue(-1) }
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 954), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 950, CAD_Store.Read(CAD_Bool_Clip.eb, 1))
                ArraySet(CAD_Bool_Clip.buf, 951, CAD_Store.Read(CAD_Bool_Clip.eb, 2))
                ArraySet(CAD_Bool_Clip.buf, 952, CAD_Store.Read(CAD_Bool_Clip.eb, 3))
                ArraySet(CAD_Bool_Clip.buf, 953, CAD_Store.Read(CAD_Bool_Clip.eb, 10))
                ArraySet(CAD_Bool_Clip.buf, 954, 1)
            }
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 954), 1) ThenBlock: {
                CAD_Bool_Clip.dx = CAD_Num.Abs(Float_Sub(CAD_Store.Read(CAD_Bool_Clip.eb, 1), ArrayGet(CAD_Bool_Clip.buf, 950)))
                IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dx, 0x3FA999999999999A), 0) ThenBlock: { ReturnValue(-1) }
                CAD_Bool_Clip.dx = CAD_Num.Abs(Float_Sub(CAD_Store.Read(CAD_Bool_Clip.eb, 2), ArrayGet(CAD_Bool_Clip.buf, 951)))
                IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dx, 0x3FA999999999999A), 0) ThenBlock: { ReturnValue(-1) }
                CAD_Bool_Clip.dx = CAD_Num.Abs(Float_Sub(CAD_Store.Read(CAD_Bool_Clip.eb, 3), ArrayGet(CAD_Bool_Clip.buf, 952)))
                IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dx, 0x3FA999999999999A), 0) ThenBlock: { ReturnValue(-1) }
                CAD_Bool_Clip.dx = CAD_Num.Abs(Float_Sub(CAD_Store.Read(CAD_Bool_Clip.eb, 10), ArrayGet(CAD_Bool_Clip.buf, 953)))
                IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dx, 0x3FA999999999999A), 0) ThenBlock: { ReturnValue(-1) }
            }
            CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.w0, 2)
            IfCondition EqualTo(CAD_Bool_Clip.w0, ArrayGet(CAD_Bool_Clip.buf, 946)) ThenBlock: { CAD_Bool_Clip.ob = 64 }
            CAD_Bool_Clip.ob = Add(CAD_Bool_Clip.ob, 1)
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 954), 0) ThenBlock: { ReturnValue(-1) }
        CAD_Bool_Clip.dx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 921), ArrayGet(CAD_Bool_Clip.buf, 950))
        CAD_Bool_Clip.dy = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 922), ArrayGet(CAD_Bool_Clip.buf, 951))
        CAD_Bool_Clip.qz = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 923), ArrayGet(CAD_Bool_Clip.buf, 952))
        CAD_Bool_Clip.dot = Float_Add(Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.dx), Float_Mul(CAD_Bool_Clip.dy, CAD_Bool_Clip.dy))
        CAD_Bool_Clip.dot = Float_Add(CAD_Bool_Clip.dot, Float_Mul(CAD_Bool_Clip.qz, CAD_Bool_Clip.qz))
        CAD_Bool_Clip.nx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 953), 0x3FA999999999999A)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.nx), 1) ThenBlock: { CAD_Bool_Clip.nx = 0 }
        CAD_Bool_Clip.nx = Float_Mul(CAD_Bool_Clip.nx, CAD_Bool_Clip.nx)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, CAD_Bool_Clip.nx), 1) ThenBlock: { ReturnValue(1) }
        CAD_Bool_Clip.nx = Float_Add(ArrayGet(CAD_Bool_Clip.buf, 953), 0x3FA999999999999A)
        CAD_Bool_Clip.nx = Float_Mul(CAD_Bool_Clip.nx, CAD_Bool_Clip.nx)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.nx, CAD_Bool_Clip.dot), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(-1)
    }
}

// Even-odd on the real curves of every loop of .face. Parity in .s0.
// Point is buf[921..923]. A point in a hole is outside the material.
// buf[944] is the next loop. buf[945] is the loop count. buf[946] is the
// coedge head of the loop being walked.
Function.CAD_BoolClip.ArcEven {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Bool_Clip.face, CAD_Bool_Clip.fr), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ok = CAD_BoolClip.DiskIn()
        IfCondition NotEqual(CAD_Bool_Clip.ok, -1) ThenBlock: {
            CAD_Bool_Clip.w1 = CAD_Store.Read(CAD_Bool_Clip.face, 1)
            IfCondition EqualTo(CAD_Bool_Clip.w1, 0) ThenBlock: { ReturnValue(CAD_Bool_Clip.ok) }
            IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.w1, 2), 0) ThenBlock: { ReturnValue(CAD_Bool_Clip.ok) }
        }
        CAD_Bool_Clip.qx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 921), ArrayGet(CAD_Bool_Clip.fr, 1))
        CAD_Bool_Clip.qy = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 922), ArrayGet(CAD_Bool_Clip.fr, 2))
        CAD_Bool_Clip.qz = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 923), ArrayGet(CAD_Bool_Clip.fr, 3))
        ArraySet(CAD_Bool_Clip.buf, 936, Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, ArrayGet(CAD_Bool_Clip.fr, 4)), Float_Mul(CAD_Bool_Clip.qy, ArrayGet(CAD_Bool_Clip.fr, 5))), Float_Mul(CAD_Bool_Clip.qz, ArrayGet(CAD_Bool_Clip.fr, 6))))
        ArraySet(CAD_Bool_Clip.buf, 937, Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, ArrayGet(CAD_Bool_Clip.fr, 7)), Float_Mul(CAD_Bool_Clip.qy, ArrayGet(CAD_Bool_Clip.fr, 8))), Float_Mul(CAD_Bool_Clip.qz, ArrayGet(CAD_Bool_Clip.fr, 9))))
        CAD_Bool_Clip.s0 = 0
        CAD_Bool_Clip.w1 = CAD_Store.Read(CAD_Bool_Clip.face, 1)
        IfCondition EqualTo(CAD_Bool_Clip.w1, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 945, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 945), 8) {
            IfCondition EqualTo(CAD_Bool_Clip.w1, 0) ThenBlock: { ReturnValue(CAD_Bool_Clip.s0) }
            ArraySet(CAD_Bool_Clip.buf, 944, CAD_Store.Read(CAD_Bool_Clip.w1, 2))
            CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.w1, 0)
            ArraySet(CAD_Bool_Clip.buf, 946, CAD_Bool_Clip.w0)
            CAD_Bool_Clip.ob = 0
            WhileLoop LessThan(CAD_Bool_Clip.ob, 64) {
                IfCondition EqualTo(CAD_Bool_Clip.w0, 0) ThenBlock: { CAD_Bool_Clip.ob = 64 }
                IfCondition NotEqual(CAD_Bool_Clip.ob, 64) ThenBlock: {
                    CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.w0, 5)
                    CAD_BoolClip.Uv()
                    ArraySet(CAD_Bool_Clip.buf, 924, CAD_Bool_Clip.u0)
                    ArraySet(CAD_Bool_Clip.buf, 925, CAD_Bool_Clip.v0)
                    ArraySet(CAD_Bool_Clip.buf, 938, 0)
                    ArraySet(CAD_Bool_Clip.buf, 932, 1)
                    CAD_Bool_Clip.e2 = CAD_Store.Read(CAD_Bool_Clip.w0, 0)
                    IfCondition NotEqual(CAD_Bool_Clip.e2, 0) ThenBlock: {
                        CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.e2, 2)
                        ArraySet(CAD_Bool_Clip.buf, 938, CAD_Bool_Clip.eb)
                        IfCondition NotEqual(CAD_Bool_Clip.eb, 0) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, 932, CAD_Store.Read(CAD_Bool_Clip.eb, 0))
                        }
                    }
                    CAD_Bool_Clip.ce = CAD_Bool_Clip.w0
                    CAD_Bool_Clip.v = CAD_BoolClip.Dest()
                    CAD_BoolClip.Uv()
                    CAD_Bool_Clip.u1 = CAD_Bool_Clip.u0
                    CAD_Bool_Clip.v1 = CAD_Bool_Clip.v0
                    CAD_Bool_Clip.u0 = ArrayGet(CAD_Bool_Clip.buf, 924)
                    CAD_Bool_Clip.v0 = ArrayGet(CAD_Bool_Clip.buf, 925)
                    IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 932), 2) ThenBlock: { CAD_BoolClip.LineRay() }
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 932), 2) ThenBlock: { CAD_BoolClip.ArcRay() }
                    CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.w0, 2)
                    IfCondition EqualTo(CAD_Bool_Clip.w0, ArrayGet(CAD_Bool_Clip.buf, 946)) ThenBlock: { CAD_Bool_Clip.ob = 64 }
                    IfCondition NotEqual(CAD_Bool_Clip.ob, 64) ThenBlock: {
                        CAD_Bool_Clip.ob = Add(CAD_Bool_Clip.ob, 1)
                    }
                }
            }
            CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 944)
            ArraySet(CAD_Bool_Clip.buf, 945, Add(ArrayGet(CAD_Bool_Clip.buf, 945), 1))
        }
        ReturnValue(CAD_Bool_Clip.s0)
    }
}

// 1 when buf[921..923] is within 0.05 mm of a line coedge of any loop.
// Does not write the Class walkers (.n .cf .g .fg .nh .nt .hi .lp .face).
// buf[848] is the next loop. buf[847] is the loop count.
Function.CAD_BoolClip.OnBound {
    Output: Integer
    Body: {
        CAD_Bool_Clip.w1 = CAD_Store.Read(CAD_Bool_Clip.face, 1)
        IfCondition EqualTo(CAD_Bool_Clip.w1, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 847, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 847), 8) {
            IfCondition EqualTo(CAD_Bool_Clip.w1, 0) ThenBlock: { ReturnValue(0) }
            ArraySet(CAD_Bool_Clip.buf, 848, CAD_Store.Read(CAD_Bool_Clip.w1, 2))
            ArraySet(CAD_Bool_Clip.buf, 850, CAD_Store.Read(CAD_Bool_Clip.w1, 0))
            ArraySet(CAD_Bool_Clip.buf, 851, ArrayGet(CAD_Bool_Clip.buf, 850))
            ArraySet(CAD_Bool_Clip.buf, 852, 0)
            WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 852), 64) {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 851), 0) ThenBlock: { ArraySet(CAD_Bool_Clip.buf, 852, 64) }
            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 852), 64) ThenBlock: {
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 851)
            CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
            ArraySet(CAD_Bool_Clip.buf, 853, 0)
            IfCondition NotEqual(CAD_Bool_Clip.ea, 0) ThenBlock: {
                CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.ea, 2)
                IfCondition NotEqual(CAD_Bool_Clip.eb, 0) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 853, CAD_Store.Read(CAD_Bool_Clip.eb, 0))
                }
            }
            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 853), 2) ThenBlock: {
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 851)
                CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
                ArraySet(CAD_Bool_Clip.buf, 854, CAD_Store.Read(CAD_Bool_Clip.v, 0))
                CAD_Bool_Clip.v = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 851), 5)
                ArraySet(CAD_Bool_Clip.buf, 855, CAD_Store.Read(CAD_Bool_Clip.v, 1))
                CAD_Bool_Clip.v = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 851), 5)
                ArraySet(CAD_Bool_Clip.buf, 856, CAD_Store.Read(CAD_Bool_Clip.v, 2))
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 851)
                CAD_Bool_Clip.w0 = CAD_BoolClip.Dest()
                ArraySet(CAD_Bool_Clip.buf, 857, CAD_Bool_Clip.w0)
                ArraySet(CAD_Bool_Clip.buf, 858, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 857), 0))
                ArraySet(CAD_Bool_Clip.buf, 868, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 857), 1))
                ArraySet(CAD_Bool_Clip.buf, 869, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 857), 2))
                ArraySet(CAD_Bool_Clip.buf, 870, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 858), ArrayGet(CAD_Bool_Clip.buf, 854)))
                ArraySet(CAD_Bool_Clip.buf, 871, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 868), ArrayGet(CAD_Bool_Clip.buf, 855)))
                ArraySet(CAD_Bool_Clip.buf, 872, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 869), ArrayGet(CAD_Bool_Clip.buf, 856)))
                ArraySet(CAD_Bool_Clip.buf, 873, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 921), ArrayGet(CAD_Bool_Clip.buf, 854)))
                ArraySet(CAD_Bool_Clip.buf, 874, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 922), ArrayGet(CAD_Bool_Clip.buf, 855)))
                ArraySet(CAD_Bool_Clip.buf, 875, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 923), ArrayGet(CAD_Bool_Clip.buf, 856)))
                ArraySet(CAD_Bool_Clip.buf, 876, Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 870), ArrayGet(CAD_Bool_Clip.buf, 870)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 871), ArrayGet(CAD_Bool_Clip.buf, 871))))
                ArraySet(CAD_Bool_Clip.buf, 876, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 876), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 872), ArrayGet(CAD_Bool_Clip.buf, 872))))
                ArraySet(CAD_Bool_Clip.buf, 877, 0)
                IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(CAD_Bool_Clip.buf, 876), 0), 0) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 878, Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 873), ArrayGet(CAD_Bool_Clip.buf, 870)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 874), ArrayGet(CAD_Bool_Clip.buf, 871))))
                    ArraySet(CAD_Bool_Clip.buf, 878, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 878), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 875), ArrayGet(CAD_Bool_Clip.buf, 872))))
                    ArraySet(CAD_Bool_Clip.buf, 877, Float_Div(ArrayGet(CAD_Bool_Clip.buf, 878), ArrayGet(CAD_Bool_Clip.buf, 876)))
                    IfCondition EqualTo(CAD_Num.IsNeg(ArrayGet(CAD_Bool_Clip.buf, 877)), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 877, 0)
                    }
                    IfCondition EqualTo(CAD_Num.Le(0x3FF0000000000000, ArrayGet(CAD_Bool_Clip.buf, 877)), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 877, 0x3FF0000000000000)
                    }
                }
                ArraySet(CAD_Bool_Clip.buf, 870, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 854), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 877), ArrayGet(CAD_Bool_Clip.buf, 870))))
                ArraySet(CAD_Bool_Clip.buf, 871, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 855), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 877), ArrayGet(CAD_Bool_Clip.buf, 871))))
                ArraySet(CAD_Bool_Clip.buf, 872, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 856), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 877), ArrayGet(CAD_Bool_Clip.buf, 872))))
                ArraySet(CAD_Bool_Clip.buf, 873, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 921), ArrayGet(CAD_Bool_Clip.buf, 870)))
                ArraySet(CAD_Bool_Clip.buf, 874, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 922), ArrayGet(CAD_Bool_Clip.buf, 871)))
                ArraySet(CAD_Bool_Clip.buf, 875, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 923), ArrayGet(CAD_Bool_Clip.buf, 872)))
                ArraySet(CAD_Bool_Clip.buf, 876, Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 873), ArrayGet(CAD_Bool_Clip.buf, 873)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 874), ArrayGet(CAD_Bool_Clip.buf, 874))))
                ArraySet(CAD_Bool_Clip.buf, 876, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 876), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 875), ArrayGet(CAD_Bool_Clip.buf, 875))))
                ArraySet(CAD_Bool_Clip.buf, 878, Float_Mul(0x3FA999999999999A, 0x3FA999999999999A))
                IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 876), ArrayGet(CAD_Bool_Clip.buf, 878)), 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 851)
            ArraySet(CAD_Bool_Clip.buf, 851, CAD_Store.Read(CAD_Bool_Clip.ce, 2))
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 851), ArrayGet(CAD_Bool_Clip.buf, 850)) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 852, 64)
            }
            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 852), 64) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 852, Add(ArrayGet(CAD_Bool_Clip.buf, 852), 1))
            }
            }
            }
            CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 848)
            ArraySet(CAD_Bool_Clip.buf, 847, Add(ArrayGet(CAD_Bool_Clip.buf, 847), 1))
        }
        ReturnValue(0)
    }
}

// 1 inside .face, 0 outside. Point is (.px,.py,.pz).
// Half-open even-odd, so a ray through a vertex counts once. PointInFaceUV
// counts that vertex twice, which drops the edge between two cut points.
// A point on the boundary counts as inside. Even-odd calls it outside.
Function.CAD_BoolClip.Inn {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 921, CAD_Bool_Clip.px)
        ArraySet(CAD_Bool_Clip.buf, 922, CAD_Bool_Clip.py)
        ArraySet(CAD_Bool_Clip.buf, 923, CAD_Bool_Clip.pz)
        ArraySet(CAD_Bool_Clip.buf, 930, CAD_Bool_Clip.ce)
        CAD_Bool_Clip.ok = CAD_BoolClip.ArcEven()
        CAD_Bool_Clip.px = ArrayGet(CAD_Bool_Clip.buf, 921)
        CAD_Bool_Clip.py = ArrayGet(CAD_Bool_Clip.buf, 922)
        CAD_Bool_Clip.pz = ArrayGet(CAD_Bool_Clip.buf, 923)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 930)
        ArraySet(CAD_Bool_Clip.buf, 849, CAD_Bool_Clip.ok)
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 849), 0) ThenBlock: {
            CAD_Bool_Clip.ok = CAD_BoolClip.OnBound()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 849, 1)
            }
        }
        ReturnValue(ArrayGet(CAD_Bool_Clip.buf, 849))
    }
}

// 1 = hole (strictly inside), -1 = no overlap, 2 = crosses the boundary.
Function.CAD_BoolClip.Class {
    Output: Integer
    Body: {
        CAD_Bool_Clip.nh = 0
        CAD_Bool_Clip.nt = 0
        CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.f0, 1)
        IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Bool_Clip.cf = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
        CAD_Bool_Clip.n = CAD_Bool_Clip.cf
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, 64) {
            CAD_Bool_Clip.fg = 0
            WhileLoop LessThan(CAD_Bool_Clip.fg, 4) {
                CAD_Bool_Clip.th = 0
                IfCondition EqualTo(CAD_Bool_Clip.fg, 1) ThenBlock: { CAD_Bool_Clip.th = 0x3FD0000000000000 }
                IfCondition EqualTo(CAD_Bool_Clip.fg, 2) ThenBlock: { CAD_Bool_Clip.th = 0x3FE0000000000000 }
                IfCondition EqualTo(CAD_Bool_Clip.fg, 3) ThenBlock: { CAD_Bool_Clip.th = 0x3FE8000000000000 }
                CAD_Bool_Clip.ce = CAD_Bool_Clip.n
                CAD_BoolClip.At()
                CAD_Bool_Clip.face = CAD_Bool_Clip.hf0
                CAD_Bool_Clip.ok = CAD_BoolClip.Inn()
                IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: { CAD_Bool_Clip.nh = Add(CAD_Bool_Clip.nh, 1) }
                IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { CAD_Bool_Clip.nt = Add(CAD_Bool_Clip.nt, 1) }
                CAD_Bool_Clip.fg = Add(CAD_Bool_Clip.fg, 1)
            }
            CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.n, 2)
            IfCondition EqualTo(CAD_Bool_Clip.ea, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.g = 64 }
            IfCondition EqualTo(CAD_Bool_Clip.ea, 0) ThenBlock: { CAD_Bool_Clip.g = 64 }
            CAD_Bool_Clip.n = CAD_Bool_Clip.ea
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        IfCondition GreaterThan(CAD_Bool_Clip.hi, 0) ThenBlock: {
            // Every sample can sit outside a circle that still covers the
            // face. Two crossings bound that overlap. One hit is a graze.
            IfCondition EqualTo(CAD_Bool_Clip.nh, 0) ThenBlock: {
                IfCondition GreaterThan(CAD_Bool_Clip.hi, 1) ThenBlock: { ReturnValue(2) }
                ReturnValue(-1)
            }
            // A single vertex can sit on the boundary without the profile
            // leaving the face. Two hits open the outline, so the overlap
            // is notched even when every sample is on or inside the face.
            IfCondition EqualTo(CAD_Bool_Clip.nt, 0) ThenBlock: {
                IfCondition GreaterThan(CAD_Bool_Clip.hi, 1) ThenBlock: { ReturnValue(2) }
                ReturnValue(1)
            }
            ReturnValue(2)
        }
        IfCondition GreaterThan(CAD_Bool_Clip.nt, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(CAD_Bool_Clip.nh, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(-1)
    }
}

// Line curve on edge .ea from its current ends.
Function.CAD_BoolClip.FixLine {
    Output: Integer
    Body: {
        CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.ea, 0)
        CAD_Bool_Clip.w1 = CAD_Store.Read(CAD_Bool_Clip.ea, 1)
        ArraySet(CAD_Bool_Clip.pt, 0, CAD_Store.Read(CAD_Bool_Clip.w0, 0))
        ArraySet(CAD_Bool_Clip.pt, 1, CAD_Store.Read(CAD_Bool_Clip.w0, 1))
        ArraySet(CAD_Bool_Clip.pt, 2, CAD_Store.Read(CAD_Bool_Clip.w0, 2))
        ArraySet(CAD_Bool_Clip.p1, 0, CAD_Store.Read(CAD_Bool_Clip.w1, 0))
        ArraySet(CAD_Bool_Clip.p1, 1, CAD_Store.Read(CAD_Bool_Clip.w1, 1))
        ArraySet(CAD_Bool_Clip.p1, 2, CAD_Store.Read(CAD_Bool_Clip.w1, 2))
        CAD_Bool_Clip.ok = CAD_Geom.MakeLine(CAD_Bool_Clip.pt, CAD_Bool_Clip.p1)
        CAD_Store.Write(CAD_Bool_Clip.ea, 2, CAD_Bool_Clip.ok)
        ReturnValue(CAD_Bool_Clip.ok)
    }
}

// Copy circle of .eb onto edge .ea with signed span .span from v0 toward v1.
Function.CAD_BoolClip.FixArc {
    Output: Integer
    Body: {
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, 9) {
            CAD_Bool_Clip.n = Add(CAD_Bool_Clip.g, 1)
            ArraySet(CAD_Bool_Clip.fr, CAD_Bool_Clip.g, CAD_Store.Read(CAD_Bool_Clip.eb, CAD_Bool_Clip.n))
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        CAD_Bool_Clip.nx = CAD_Store.Read(CAD_Bool_Clip.eb, 10)
        CAD_Bool_Clip.ok = CAD_Geom.MakeCircle(CAD_Bool_Clip.fr, CAD_Bool_Clip.nx)
        CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.ea, 0)
        CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.w0, 0)
        CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.w0, 1)
        CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.w0, 2)
        CAD_BoolClip.Ang()
        CAD_Store.Write(CAD_Bool_Clip.ok, 11, CAD_Bool_Clip.a0)
        CAD_Store.Write(CAD_Bool_Clip.ok, 12, CAD_Bool_Clip.span)
        CAD_Store.Write(CAD_Bool_Clip.ea, 2, CAD_Bool_Clip.ok)
        ReturnValue(CAD_Bool_Clip.ok)
    }
}

// LinkTwins(buf[928], buf[955]). Own function so the handles are reloaded.
Function.CAD_BoolClip.TwinLink {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 928)
        CAD_Bool_Clip.c2 = ArrayGet(CAD_Bool_Clip.buf, 955)
        CAD_Topo.LinkTwins(CAD_Bool_Clip.ce, CAD_Bool_Clip.c2)
        ReturnValue(0)
    }
}

// LinkTwins(buf[929], buf[919]).
Function.CAD_BoolClip.TwinLinkB {
    Output: Integer
    Body: {
        CAD_Bool_Clip.c2 = ArrayGet(CAD_Bool_Clip.buf, 929)
        CAD_Bool_Clip.tw = ArrayGet(CAD_Bool_Clip.buf, 919)
        CAD_Topo.LinkTwins(CAD_Bool_Clip.c2, CAD_Bool_Clip.tw)
        ReturnValue(0)
    }
}

// Edge slots from buf. No call between the loads and the writes.
Function.CAD_BoolClip.TwinSlots {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 928)
        CAD_Bool_Clip.tw2 = ArrayGet(CAD_Bool_Clip.buf, 955)
        CAD_Bool_Clip.e2 = ArrayGet(CAD_Bool_Clip.buf, 926)
        CAD_Bool_Clip.c2 = ArrayGet(CAD_Bool_Clip.buf, 929)
        CAD_Bool_Clip.tw = ArrayGet(CAD_Bool_Clip.buf, 919)
        CAD_Bool_Clip.g = 0
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 4), CAD_Bool_Clip.ce) ThenBlock: {
            CAD_Bool_Clip.g = 1
        }
        IfCondition EqualTo(CAD_Bool_Clip.g, 0) ThenBlock: {
            CAD_Store.Write(CAD_Bool_Clip.ea, 3, CAD_Bool_Clip.ce)
            CAD_Store.Write(CAD_Bool_Clip.ea, 4, CAD_Bool_Clip.tw2)
            CAD_Store.Write(CAD_Bool_Clip.e2, 3, CAD_Bool_Clip.c2)
            CAD_Store.Write(CAD_Bool_Clip.e2, 4, CAD_Bool_Clip.tw)
        }
        IfCondition EqualTo(CAD_Bool_Clip.g, 1) ThenBlock: {
            CAD_Store.Write(CAD_Bool_Clip.ea, 4, CAD_Bool_Clip.ce)
            CAD_Store.Write(CAD_Bool_Clip.ea, 3, CAD_Bool_Clip.tw2)
            CAD_Store.Write(CAD_Bool_Clip.e2, 4, CAD_Bool_Clip.c2)
            CAD_Store.Write(CAD_Bool_Clip.e2, 3, CAD_Bool_Clip.tw)
        }
        ReturnValue(0)
    }
}

// Splice buf[955] after buf[919]. Old next is buf[933]. Loop is buf[934].
Function.CAD_BoolClip.TwinNext {
    Output: Integer
    Body: {
        CAD_Bool_Clip.tw = ArrayGet(CAD_Bool_Clip.buf, 919)
        CAD_Bool_Clip.tw2 = ArrayGet(CAD_Bool_Clip.buf, 955)
        CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, 933)
        CAD_Store.Write(CAD_Bool_Clip.tw, 2, CAD_Bool_Clip.tw2)
        CAD_Store.Write(CAD_Bool_Clip.tw2, 3, CAD_Bool_Clip.tw)
        CAD_Store.Write(CAD_Bool_Clip.tw2, 2, CAD_Bool_Clip.n)
        CAD_Store.Write(CAD_Bool_Clip.n, 3, CAD_Bool_Clip.tw2)
        CAD_Store.Write(CAD_Bool_Clip.tw2, 4, ArrayGet(CAD_Bool_Clip.buf, 934))
        ReturnValue(0)
    }
}

// Insert .c2 after .ce. Twin .tw (origin at the old dest) moves onto .e2.
// .tw2 starts at .nv on the shortened edge .ea.
// Handles are reloaded from buf after every call. A call drops pool fields.
Function.CAD_BoolClip.Insert {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 928, CAD_Bool_Clip.ce)
        ArraySet(CAD_Bool_Clip.buf, 929, CAD_Bool_Clip.c2)
        ArraySet(CAD_Bool_Clip.buf, 919, CAD_Bool_Clip.tw)
        ArraySet(CAD_Bool_Clip.buf, 920, CAD_Bool_Clip.w1)
        ArraySet(CAD_Bool_Clip.buf, 926, CAD_Bool_Clip.e2)
        ArraySet(CAD_Bool_Clip.buf, 927, CAD_Bool_Clip.ea)
        ArraySet(CAD_Bool_Clip.buf, 931, CAD_Bool_Clip.nv)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 928)
        CAD_Bool_Clip.c2 = ArrayGet(CAD_Bool_Clip.buf, 929)
        CAD_Bool_Clip.n = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
        CAD_Store.Write(CAD_Bool_Clip.ce, 2, CAD_Bool_Clip.c2)
        CAD_Store.Write(CAD_Bool_Clip.c2, 3, CAD_Bool_Clip.ce)
        CAD_Store.Write(CAD_Bool_Clip.c2, 2, CAD_Bool_Clip.n)
        CAD_Store.Write(CAD_Bool_Clip.n, 3, CAD_Bool_Clip.c2)
        CAD_Store.Write(CAD_Bool_Clip.c2, 4, CAD_Store.Read(CAD_Bool_Clip.ce, 4))
        CAD_Bool_Clip.tw = ArrayGet(CAD_Bool_Clip.buf, 919)
        IfCondition EqualTo(CAD_Bool_Clip.tw, 0) ThenBlock: { ReturnValue(1) }
        ArraySet(CAD_Bool_Clip.buf, 933, CAD_Store.Read(CAD_Bool_Clip.tw, 2))
        ArraySet(CAD_Bool_Clip.buf, 934, CAD_Store.Read(CAD_Bool_Clip.tw, 4))
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 920)
        CAD_Bool_Clip.e2 = ArrayGet(CAD_Bool_Clip.buf, 926)
        CAD_Store.Write(CAD_Bool_Clip.tw, 0, CAD_Bool_Clip.e2)
        CAD_Store.Write(CAD_Bool_Clip.tw, 5, CAD_Bool_Clip.w1)
        CAD_Bool_Clip.g = 0
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.e2, 0), CAD_Bool_Clip.w1) ThenBlock: { CAD_Bool_Clip.g = 1 }
        CAD_Store.Write(CAD_Bool_Clip.tw, 6, CAD_Bool_Clip.g)
        CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
        CAD_Bool_Clip.g = 0
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 0), CAD_Bool_Clip.nv) ThenBlock: { CAD_Bool_Clip.g = 1 }
        CAD_Bool_Clip.tw2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.ea, CAD_Bool_Clip.nv, CAD_Bool_Clip.g)
        ArraySet(CAD_Bool_Clip.buf, 955, CAD_Bool_Clip.tw2)
        CAD_BoolClip.TwinLink()
        CAD_BoolClip.TwinLinkB()
        CAD_BoolClip.TwinSlots()
        CAD_BoolClip.TwinNext()
        ReturnValue(1)
    }
}

// Same splice as Insert, but the caller already stored the handles.
// Does not read pool fields, so a stale register cannot replace them.
Function.CAD_BoolClip.InsertBuf {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 928)
        CAD_Bool_Clip.c2 = ArrayGet(CAD_Bool_Clip.buf, 929)
        CAD_Bool_Clip.n = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
        CAD_Store.Write(CAD_Bool_Clip.ce, 2, CAD_Bool_Clip.c2)
        CAD_Store.Write(CAD_Bool_Clip.c2, 3, CAD_Bool_Clip.ce)
        CAD_Store.Write(CAD_Bool_Clip.c2, 2, CAD_Bool_Clip.n)
        CAD_Store.Write(CAD_Bool_Clip.n, 3, CAD_Bool_Clip.c2)
        CAD_Store.Write(CAD_Bool_Clip.c2, 4, CAD_Store.Read(CAD_Bool_Clip.ce, 4))
        CAD_Bool_Clip.tw = ArrayGet(CAD_Bool_Clip.buf, 919)
        IfCondition EqualTo(CAD_Bool_Clip.tw, 0) ThenBlock: { ReturnValue(1) }
        ArraySet(CAD_Bool_Clip.buf, 933, CAD_Store.Read(CAD_Bool_Clip.tw, 2))
        ArraySet(CAD_Bool_Clip.buf, 934, CAD_Store.Read(CAD_Bool_Clip.tw, 4))
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 920)
        CAD_Bool_Clip.e2 = ArrayGet(CAD_Bool_Clip.buf, 926)
        CAD_Store.Write(CAD_Bool_Clip.tw, 0, CAD_Bool_Clip.e2)
        CAD_Store.Write(CAD_Bool_Clip.tw, 5, CAD_Bool_Clip.w1)
        CAD_Bool_Clip.g = 0
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.e2, 0), CAD_Bool_Clip.w1) ThenBlock: { CAD_Bool_Clip.g = 1 }
        CAD_Store.Write(CAD_Bool_Clip.tw, 6, CAD_Bool_Clip.g)
        CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
        CAD_Bool_Clip.g = 0
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 0), CAD_Bool_Clip.nv) ThenBlock: { CAD_Bool_Clip.g = 1 }
        CAD_Bool_Clip.tw2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.ea, CAD_Bool_Clip.nv, CAD_Bool_Clip.g)
        ArraySet(CAD_Bool_Clip.buf, 955, CAD_Bool_Clip.tw2)
        CAD_BoolClip.TwinLink()
        CAD_BoolClip.TwinLinkB()
        CAD_BoolClip.TwinSlots()
        CAD_BoolClip.TwinNext()
        ReturnValue(1)
    }
}

// .bx is the angle delta. Original span is buf[915]. Direction is buf[918].
// Short span buf[916], remainder buf[917]. 0 when the hit is an endpoint.
Function.CAD_BoolClip.SpanCut {
    Output: Integer
    Body: {
        CAD_Bool_Clip.bx = ArrayGet(CAD_Bool_Clip.buf, 883)
        CAD_Bool_Clip.nx = ArrayGet(CAD_Bool_Clip.buf, 915)
        CAD_Bool_Clip.th = Float_Div(CAD_Bool_Clip.bx, CAD_Bool_Clip.nx)
        ArraySet(CAD_Bool_Clip.buf, 935, CAD_Bool_Clip.th)
        // Same span gate as FindArc. A fraction past this piece belongs to the other arc.
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.th), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(0x3FF0000000000000, CAD_Bool_Clip.th), 1) ThenBlock: { ReturnValue(0) }
        // Same 0.05 mm end test as FindArc. A percent of a full turn hid a crossing.
        ArraySet(CAD_Bool_Clip.buf, 1016, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 907), 10))
        CAD_Bool_Clip.th = Float_Mul(CAD_Num.Abs(CAD_Bool_Clip.bx), ArrayGet(CAD_Bool_Clip.buf, 1016))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.th, 0x3FA999999999999A), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.th = Float_Mul(CAD_Num.Abs(Float_Sub(CAD_Bool_Clip.nx, CAD_Bool_Clip.bx)), ArrayGet(CAD_Bool_Clip.buf, 1016))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.th, 0x3FA999999999999A), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 935)
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 918), 1) ThenBlock: {
            CAD_Bool_Clip.nx = ArrayGet(CAD_Bool_Clip.buf, 915)
            CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 935)
            ArraySet(CAD_Bool_Clip.buf, 916, Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.nx))
            CAD_Bool_Clip.nx = ArrayGet(CAD_Bool_Clip.buf, 915)
            CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 935)
            ArraySet(CAD_Bool_Clip.buf, 917, Float_Mul(Float_Sub(0x3FF0000000000000, CAD_Bool_Clip.th), CAD_Bool_Clip.nx))
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 918), 0) ThenBlock: {
            CAD_Bool_Clip.nx = ArrayGet(CAD_Bool_Clip.buf, 915)
            CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 935)
            ArraySet(CAD_Bool_Clip.buf, 916, Float_Mul(Float_Sub(0x3FF0000000000000, CAD_Bool_Clip.th), CAD_Bool_Clip.nx))
            CAD_Bool_Clip.nx = ArrayGet(CAD_Bool_Clip.buf, 915)
            CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 935)
            ArraySet(CAD_Bool_Clip.buf, 917, Float_Sub(0, Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.nx)))
        }
        ReturnValue(1)
    }
}

// Angle of buf[990..992] on circle buf[907], into .a0.
Function.CAD_BoolClip.AngAt {
    Output: Integer
    Body: {
        CAD_Bool_Clip.px = ArrayGet(CAD_Bool_Clip.buf, 990)
        CAD_Bool_Clip.py = ArrayGet(CAD_Bool_Clip.buf, 991)
        CAD_Bool_Clip.pz = ArrayGet(CAD_Bool_Clip.buf, 992)
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 907)
        CAD_BoolClip.Ang()
        ReturnValue(0)
    }
}

// FixArc of edge buf[927], circle buf[907], span buf[.g].
Function.CAD_BoolClip.FixFrom {
    Output: Integer
    Body: {
        CAD_Bool_Clip.span = ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.g)
        CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 907)
        CAD_BoolClip.FixArc()
        ReturnValue(0)
    }
}

