LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo

// Split circle coedge .ce at .nv. Spans follow the original arc, not the chord.
Function.CAD_BoolClip.SplitArc {
    Output: Integer
    Body: {
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
        IfCondition EqualTo(CAD_Bool_Clip.nv, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 928)
        CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
        IfCondition EqualTo(CAD_Bool_Clip.ea, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 927, CAD_Bool_Clip.ea)
        CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
        CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.ea, 2)
        IfCondition EqualTo(CAD_Bool_Clip.eb, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 907, CAD_Bool_Clip.eb)
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 907)
        ArraySet(CAD_Bool_Clip.buf, 914, CAD_Store.Read(CAD_Bool_Clip.eb, 11))
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 907)
        ArraySet(CAD_Bool_Clip.buf, 915, CAD_Store.Read(CAD_Bool_Clip.eb, 12))
        // Span 0 is a full turn (MakeCircle), same as 2π.
        IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(CAD_Bool_Clip.buf, 915), 0), 1) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 915, 0x401921FB54442D18)
        }
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 928)
        CAD_Bool_Clip.tw = CAD_Store.Read(CAD_Bool_Clip.ce, 1)
        ArraySet(CAD_Bool_Clip.buf, 966, CAD_Bool_Clip.tw)
        ArraySet(CAD_Bool_Clip.buf, 881, 0)
        CAD_Bool_Clip.tw = ArrayGet(CAD_Bool_Clip.buf, 966)
        IfCondition NotEqual(CAD_Bool_Clip.tw, 0) ThenBlock: {
            CAD_Bool_Clip.tw = ArrayGet(CAD_Bool_Clip.buf, 966)
            CAD_Bool_Clip.g = CAD_Store.Read(CAD_Bool_Clip.tw, 6)
            ArraySet(CAD_Bool_Clip.buf, 881, CAD_Bool_Clip.g)
        }
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 928)
        ArraySet(CAD_Bool_Clip.buf, 934, CAD_Store.Read(CAD_Bool_Clip.ce, 5))
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 928)
        ArraySet(CAD_Bool_Clip.buf, 942, CAD_Store.Read(CAD_Bool_Clip.ea, 0))
        ArraySet(CAD_Bool_Clip.buf, 943, CAD_Store.Read(CAD_Bool_Clip.ea, 1))
        CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
        ArraySet(CAD_Bool_Clip.buf, 969, CAD_Bool_Clip.w1)
        CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 969)
        ArraySet(CAD_Bool_Clip.buf, 918, 0)
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 934), ArrayGet(CAD_Bool_Clip.buf, 942)) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 918, 1)
        }
        // Closed edge: both ends are one vertex, so the cap origin matches v0
        // for either sense. Sense 1 follows the curve. Park the hit in v0 and
        // swap the spans so that side stays with the curve. Sense 0 already
        // matches the open-cap path (hit goes into v1).
        ArraySet(CAD_Bool_Clip.buf, 880, 0)
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 881), 1) ThenBlock: {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 942), ArrayGet(CAD_Bool_Clip.buf, 943)) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 942), ArrayGet(CAD_Bool_Clip.buf, 969)) ThenBlock: {
                    CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
                    CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
                    CAD_Store.Write(CAD_Bool_Clip.ea, 0, CAD_Bool_Clip.nv)
                    ArraySet(CAD_Bool_Clip.buf, 880, 1)
                }
            }
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 942), ArrayGet(CAD_Bool_Clip.buf, 969)) ThenBlock: {
            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 943), ArrayGet(CAD_Bool_Clip.buf, 969)) ThenBlock: {
                CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
                CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
                CAD_Store.Write(CAD_Bool_Clip.ea, 0, CAD_Bool_Clip.nv)
            }
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 880), 0) ThenBlock: {
            CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
            CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 969)
            CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
            IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 1), CAD_Bool_Clip.w1) ThenBlock: {
                CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
                CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
                CAD_Store.Write(CAD_Bool_Clip.ea, 1, CAD_Bool_Clip.nv)
            }
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 880), 0) ThenBlock: {
            CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
            CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 969)
            IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 0), CAD_Bool_Clip.w1) ThenBlock: {
                CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
                CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 969)
                CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 1), CAD_Bool_Clip.w1) ThenBlock: {
                    CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 927)
                    CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
                    CAD_Store.Write(CAD_Bool_Clip.ea, 1, CAD_Bool_Clip.nv)
                }
            }
        }
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
        CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.nv, 0)
        ArraySet(CAD_Bool_Clip.buf, 990, CAD_Bool_Clip.px)
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
        CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.nv, 1)
        ArraySet(CAD_Bool_Clip.buf, 991, CAD_Bool_Clip.py)
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
        CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.nv, 2)
        ArraySet(CAD_Bool_Clip.buf, 992, CAD_Bool_Clip.pz)
        CAD_BoolClip.AngAt()
        ArraySet(CAD_Bool_Clip.buf, 939, CAD_Bool_Clip.a0)
        CAD_Bool_Clip.qx = ArrayGet(CAD_Bool_Clip.buf, 914)
        CAD_Bool_Clip.qy = ArrayGet(CAD_Bool_Clip.buf, 939)
        CAD_Bool_Clip.nx = ArrayGet(CAD_Bool_Clip.buf, 915)
        CAD_BoolClip.AngDelta()
        IfCondition EqualTo(CAD_BoolClip.SpanCut(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 880), 1) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 879, ArrayGet(CAD_Bool_Clip.buf, 916))
            ArraySet(CAD_Bool_Clip.buf, 916, ArrayGet(CAD_Bool_Clip.buf, 917))
            ArraySet(CAD_Bool_Clip.buf, 917, ArrayGet(CAD_Bool_Clip.buf, 879))
        }
        CAD_Bool_Clip.g = 916
        CAD_BoolClip.FixFrom()
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 969)
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 880), 1) ThenBlock: {
            CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
            CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 969)
            CAD_Bool_Clip.e2 = CAD_Topo.MakeEdge(CAD_Bool_Clip.w1, CAD_Bool_Clip.nv, 0)
            ArraySet(CAD_Bool_Clip.buf, 926, CAD_Bool_Clip.e2)
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 880), 0) ThenBlock: {
            CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
            CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 969)
            CAD_Bool_Clip.e2 = CAD_Topo.MakeEdge(CAD_Bool_Clip.nv, CAD_Bool_Clip.w1, 0)
            ArraySet(CAD_Bool_Clip.buf, 926, CAD_Bool_Clip.e2)
        }
        CAD_Bool_Clip.e2 = ArrayGet(CAD_Bool_Clip.buf, 926)
        ArraySet(CAD_Bool_Clip.buf, 927, CAD_Bool_Clip.e2)
        CAD_Bool_Clip.g = 917
        CAD_BoolClip.FixFrom()
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 928)
        CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
        ArraySet(CAD_Bool_Clip.buf, 927, CAD_Bool_Clip.ea)
        CAD_Bool_Clip.e2 = ArrayGet(CAD_Bool_Clip.buf, 926)
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
        CAD_Bool_Clip.g = 0
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.e2, 0), CAD_Bool_Clip.nv) ThenBlock: { CAD_Bool_Clip.g = 1 }
        ArraySet(CAD_Bool_Clip.buf, 882, CAD_Bool_Clip.g)
        CAD_Bool_Clip.e2 = ArrayGet(CAD_Bool_Clip.buf, 926)
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
        CAD_Bool_Clip.g = ArrayGet(CAD_Bool_Clip.buf, 882)
        CAD_Bool_Clip.c2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.e2, CAD_Bool_Clip.nv, CAD_Bool_Clip.g)
        ArraySet(CAD_Bool_Clip.buf, 929, CAD_Bool_Clip.c2)
        ArraySet(CAD_Bool_Clip.buf, 919, ArrayGet(CAD_Bool_Clip.buf, 966))
        ArraySet(CAD_Bool_Clip.buf, 920, ArrayGet(CAD_Bool_Clip.buf, 969))
        CAD_BoolClip.InsertBuf()
        ReturnValue(1)
    }
}

// Split coedge .ce at vertex .nv. .ce then ends at .nv, .c2 starts there.
Function.CAD_BoolClip.SplitOpen {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 928)
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 931)
        CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
        IfCondition EqualTo(CAD_Bool_Clip.ea, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.ea, 2)
        CAD_Bool_Clip.fg = 1
        IfCondition NotEqual(CAD_Bool_Clip.eb, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.eb, 0), 2) ThenBlock: { CAD_Bool_Clip.fg = 2 }
        }
        IfCondition EqualTo(CAD_Bool_Clip.fg, 2) ThenBlock: {
            CAD_Bool_Clip.ok = CAD_BoolClip.SplitArc()
            ReturnValue(CAD_Bool_Clip.ok)
        }
        CAD_Bool_Clip.tw = CAD_Store.Read(CAD_Bool_Clip.ce, 1)
        CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
        CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
        ArraySet(CAD_Bool_Clip.buf, 944, CAD_Store.Read(CAD_Bool_Clip.ea, 0))
        ArraySet(CAD_Bool_Clip.buf, 945, CAD_Store.Read(CAD_Bool_Clip.ea, 1))
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 944), CAD_Bool_Clip.w1) ThenBlock: {
            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 945), CAD_Bool_Clip.w1) ThenBlock: {
                CAD_Store.Write(CAD_Bool_Clip.ea, 0, CAD_Bool_Clip.nv)
            }
        }
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 1), CAD_Bool_Clip.w1) ThenBlock: {
            CAD_Store.Write(CAD_Bool_Clip.ea, 1, CAD_Bool_Clip.nv)
        }
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 0), CAD_Bool_Clip.w1) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 1), CAD_Bool_Clip.w1) ThenBlock: {
                CAD_Store.Write(CAD_Bool_Clip.ea, 1, CAD_Bool_Clip.nv)
            }
        }
        ArraySet(CAD_Bool_Clip.buf, 949, CAD_Bool_Clip.w1)
        CAD_BoolClip.FixLine()
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 949)
        ArraySet(CAD_Bool_Clip.pt, 0, CAD_Store.Read(CAD_Bool_Clip.nv, 0))
        ArraySet(CAD_Bool_Clip.pt, 1, CAD_Store.Read(CAD_Bool_Clip.nv, 1))
        ArraySet(CAD_Bool_Clip.pt, 2, CAD_Store.Read(CAD_Bool_Clip.nv, 2))
        ArraySet(CAD_Bool_Clip.p1, 0, CAD_Store.Read(CAD_Bool_Clip.w1, 0))
        ArraySet(CAD_Bool_Clip.p1, 1, CAD_Store.Read(CAD_Bool_Clip.w1, 1))
        ArraySet(CAD_Bool_Clip.p1, 2, CAD_Store.Read(CAD_Bool_Clip.w1, 2))
        CAD_Bool_Clip.ok = CAD_Geom.MakeLine(CAD_Bool_Clip.pt, CAD_Bool_Clip.p1)
        CAD_Bool_Clip.e2 = CAD_Topo.MakeEdge(CAD_Bool_Clip.nv, CAD_Bool_Clip.w1, CAD_Bool_Clip.ok)
        CAD_Bool_Clip.g = 0
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.e2, 0), CAD_Bool_Clip.nv) ThenBlock: { CAD_Bool_Clip.g = 1 }
        CAD_Bool_Clip.c2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.e2, CAD_Bool_Clip.nv, CAD_Bool_Clip.g)
        CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
        CAD_BoolClip.Insert()
        ReturnValue(1)
    }
}

// .face, point (.px,.py,.pz), known vertex .nv or 0.
// On success .v is the vertex, .ce ends at it, .c2 starts at it.
// A vertex on a hole loop counts. buf[1018] loop count, buf[1019] next loop.
Function.CAD_BoolClip.Bind {
    Output: Integer
    Body: {
        CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
        IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ea = 0
        CAD_Bool_Clip.c2 = 0
        ArraySet(CAD_Bool_Clip.buf, 1018, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 1018), 8) {
            IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 1018, 8)
            }
            IfCondition NotEqual(CAD_Bool_Clip.lp, 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 1019, CAD_Store.Read(CAD_Bool_Clip.lp, 2))
                CAD_Bool_Clip.cf = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
                CAD_Bool_Clip.n = CAD_Bool_Clip.cf
                CAD_Bool_Clip.g = 0
                WhileLoop LessThan(CAD_Bool_Clip.g, 80) {
            IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.n, 5), CAD_Bool_Clip.nv) ThenBlock: {
                CAD_Bool_Clip.c2 = CAD_Bool_Clip.n
            }
            CAD_Bool_Clip.w1 = CAD_Bool_Clip.n
            CAD_Bool_Clip.ce = CAD_Bool_Clip.n
            CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
            IfCondition EqualTo(CAD_Bool_Clip.t0, CAD_Bool_Clip.nv) ThenBlock: {
                CAD_Bool_Clip.ea = CAD_Bool_Clip.w1
            }
            CAD_Bool_Clip.n = CAD_Store.Read(CAD_Bool_Clip.w1, 2)
            IfCondition EqualTo(CAD_Bool_Clip.n, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.g = 80 }
            IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: { CAD_Bool_Clip.g = 80 }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
                }
                CAD_Bool_Clip.lp = ArrayGet(CAD_Bool_Clip.buf, 1019)
            }
            ArraySet(CAD_Bool_Clip.buf, 1018, Add(ArrayGet(CAD_Bool_Clip.buf, 1018), 1))
        }
        ArraySet(CAD_Bool_Clip.buf, 898, CAD_Bool_Clip.ea)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 898)
        CAD_Bool_Clip.v = CAD_Bool_Clip.nv
        IfCondition EqualTo(CAD_Bool_Clip.ce, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Signed angle from .qx to .qy, wrapped into the direction of span .nx. Result .bx.
Function.CAD_BoolClip.AngDelta {
    Output: Integer
    Body: {
        CAD_Bool_Clip.bx = Float_Sub(CAD_Bool_Clip.qy, CAD_Bool_Clip.qx)
        CAD_Bool_Clip.ob = 0
        WhileLoop LessThan(CAD_Bool_Clip.ob, 4) {
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.nx), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.bx), 1) ThenBlock: {
                    CAD_Bool_Clip.bx = Float_Add(CAD_Bool_Clip.bx, 0x401921FB54442D18)
                }
                IfCondition EqualTo(CAD_Num.Le(0x401921FB54442D18, CAD_Bool_Clip.bx), 1) ThenBlock: {
                    CAD_Bool_Clip.bx = Float_Sub(CAD_Bool_Clip.bx, 0x401921FB54442D18)
                }
            }
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.nx), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.bx), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.bx, 0), 0) ThenBlock: {
                        CAD_Bool_Clip.bx = Float_Sub(CAD_Bool_Clip.bx, 0x401921FB54442D18)
                    }
                }
                IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.bx, 0xC01921FB54442D18), 1) ThenBlock: {
                    CAD_Bool_Clip.bx = Float_Add(CAD_Bool_Clip.bx, 0x401921FB54442D18)
                }
            }
            CAD_Bool_Clip.ob = Add(CAD_Bool_Clip.ob, 1)
        }
        ArraySet(CAD_Bool_Clip.buf, 883, CAD_Bool_Clip.bx)
        ReturnValue(0)
    }
}

// 1 when (.px,.py,.pz) lies on the circle of coedge .idx, away from its ends.
// Distance squared in .dy. Fraction along the arc in .th.
// Does not write .s0 .s1 .s2 .s3 .ox .oy .oz .ea .e2 .ok .idx.
Function.CAD_BoolClip.FindArc {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 940, CAD_Store.Read(CAD_Bool_Clip.idx, 0))
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 940), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 941, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 940), 2))
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 941), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 941), 0), 2) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 941)
        CAD_Bool_Clip.nx = CAD_Store.Read(CAD_Bool_Clip.eb, 12)
        CAD_Bool_Clip.qx = Float_Sub(CAD_Bool_Clip.px, CAD_Store.Read(CAD_Bool_Clip.eb, 1))
        CAD_Bool_Clip.qy = Float_Sub(CAD_Bool_Clip.py, CAD_Store.Read(CAD_Bool_Clip.eb, 2))
        CAD_Bool_Clip.qz = Float_Sub(CAD_Bool_Clip.pz, CAD_Store.Read(CAD_Bool_Clip.eb, 3))
        CAD_Bool_Clip.cx = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Store.Read(CAD_Bool_Clip.eb, 4)), Float_Mul(CAD_Bool_Clip.qy, CAD_Store.Read(CAD_Bool_Clip.eb, 5))), Float_Mul(CAD_Bool_Clip.qz, CAD_Store.Read(CAD_Bool_Clip.eb, 6)))
        CAD_Bool_Clip.cy = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Store.Read(CAD_Bool_Clip.eb, 7)), Float_Mul(CAD_Bool_Clip.qy, CAD_Store.Read(CAD_Bool_Clip.eb, 8))), Float_Mul(CAD_Bool_Clip.qz, CAD_Store.Read(CAD_Bool_Clip.eb, 9)))
        CAD_Bool_Clip.dx = CAD_Store.Read(CAD_Bool_Clip.eb, 10)
        CAD_Bool_Clip.dy = CAD_Num.Sqrt(Float_Add(Float_Mul(CAD_Bool_Clip.cx, CAD_Bool_Clip.cx), Float_Mul(CAD_Bool_Clip.cy, CAD_Bool_Clip.cy)))
        CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.dy, CAD_Bool_Clip.dx)
        CAD_Bool_Clip.dy = Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.dx)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dy, CAD_Bool_Clip.base), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.eb = ArrayGet(CAD_Bool_Clip.buf, 941)
        CAD_BoolClip.Ang()
        CAD_Bool_Clip.qx = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 941), 11)
        CAD_Bool_Clip.qy = CAD_Bool_Clip.a0
        CAD_Bool_Clip.nx = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 941), 12)
        ArraySet(CAD_Bool_Clip.buf, 942, CAD_Bool_Clip.nx)
        IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(CAD_Bool_Clip.buf, 942), 0), 1) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 942, 0x401921FB54442D18)
        }
        CAD_Bool_Clip.nx = ArrayGet(CAD_Bool_Clip.buf, 942)
        CAD_BoolClip.AngDelta()
        CAD_Bool_Clip.nx = ArrayGet(CAD_Bool_Clip.buf, 942)
        CAD_Bool_Clip.bx = ArrayGet(CAD_Bool_Clip.buf, 883)
        CAD_Bool_Clip.th = Float_Div(CAD_Bool_Clip.bx, CAD_Bool_Clip.nx)
        // This arc only. A point on another piece of the same circle is still
        // at radius R, so the radial test accepts it and the last piece wins.
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.th), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(0x3FF0000000000000, CAD_Bool_Clip.th), 1) ThenBlock: { ReturnValue(0) }
        // End means within 0.05 mm of an endpoint, not a fraction of the span.
        // A full turn's seam is one vertex; a crossing 0.2 mm past it is real.
        ArraySet(CAD_Bool_Clip.buf, 1016, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 941), 10))
        CAD_Bool_Clip.ax = Float_Mul(CAD_Num.Abs(CAD_Bool_Clip.bx), ArrayGet(CAD_Bool_Clip.buf, 1016))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.ax, 0x3FA999999999999A), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ax = Float_Mul(CAD_Num.Abs(Float_Sub(CAD_Bool_Clip.nx, CAD_Bool_Clip.bx)), ArrayGet(CAD_Bool_Clip.buf, 1016))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.ax, 0x3FA999999999999A), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Nearest loop vertex or segment interior on .face to (.px,.py,.pz).
// A hole loop counts. ok 2 = vertex .v, ok 1 = split .ce at .th, ok 0 = miss.
// buf[1018] is the loop count. buf[1019] is the next loop, saved before the walk.
Function.CAD_BoolClip.Find {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ok = 0
        CAD_Bool_Clip.ea = 0
        CAD_Bool_Clip.e2 = 0
        ArraySet(CAD_Bool_Clip.buf, 928, 0)
        CAD_Bool_Clip.dist = 0x412E848000000000
        CAD_Bool_Clip.dot = 0x412E848000000000
        CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
        IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.base = Float_Mul(0x3FA999999999999A, 0x3FA999999999999A)
        ArraySet(CAD_Bool_Clip.buf, 1018, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 1018), 8) {
            IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 1018, 8)
            }
            IfCondition NotEqual(CAD_Bool_Clip.lp, 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 1019, CAD_Store.Read(CAD_Bool_Clip.lp, 2))
                CAD_Bool_Clip.cf = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
                CAD_Bool_Clip.n = CAD_Bool_Clip.cf
                CAD_Bool_Clip.g = 0
                WhileLoop LessThan(CAD_Bool_Clip.g, 80) {
            CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.n, 5)
            CAD_BoolClip.D2()
            IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, CAD_Bool_Clip.base), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, CAD_Bool_Clip.dist), 1) ThenBlock: {
                    CAD_Bool_Clip.dist = CAD_Bool_Clip.dot
                    CAD_Bool_Clip.ea = CAD_Bool_Clip.v
                    CAD_Bool_Clip.ok = 2
                }
            }
            CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.n, 5)
            CAD_Bool_Clip.idx = CAD_Bool_Clip.n
            CAD_Bool_Clip.ce = CAD_Bool_Clip.n
            CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
            CAD_Bool_Clip.ax = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 0), CAD_Store.Read(CAD_Bool_Clip.w0, 0))
            CAD_Bool_Clip.ay = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 1), CAD_Store.Read(CAD_Bool_Clip.w0, 1))
            CAD_Bool_Clip.bx = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 2), CAD_Store.Read(CAD_Bool_Clip.w0, 2))
            CAD_Bool_Clip.by = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.ax, CAD_Bool_Clip.ax), Float_Mul(CAD_Bool_Clip.ay, CAD_Bool_Clip.ay)), Float_Mul(CAD_Bool_Clip.bx, CAD_Bool_Clip.bx))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Clip.by, 0), 0) ThenBlock: {
                CAD_Bool_Clip.cx = Float_Sub(CAD_Bool_Clip.px, CAD_Store.Read(CAD_Bool_Clip.w0, 0))
                CAD_Bool_Clip.cy = Float_Sub(CAD_Bool_Clip.py, CAD_Store.Read(CAD_Bool_Clip.w0, 1))
                CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.pz, CAD_Store.Read(CAD_Bool_Clip.w0, 2))
                CAD_Bool_Clip.th = Float_Div(Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.cx, CAD_Bool_Clip.ax), Float_Mul(CAD_Bool_Clip.cy, CAD_Bool_Clip.ay)), Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.bx)), CAD_Bool_Clip.by)
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.th), 1) ThenBlock: { CAD_Bool_Clip.th = 0 }
                IfCondition EqualTo(CAD_Num.Le(0x3FF0000000000000, CAD_Bool_Clip.th), 1) ThenBlock: { CAD_Bool_Clip.th = 0x3FF0000000000000 }
                CAD_Bool_Clip.qx = Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 0), Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.ax))
                CAD_Bool_Clip.qy = Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 1), Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.ay))
                CAD_Bool_Clip.qz = Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 2), Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.bx))
                CAD_Bool_Clip.qx = Float_Sub(CAD_Bool_Clip.qx, CAD_Bool_Clip.px)
                CAD_Bool_Clip.qy = Float_Sub(CAD_Bool_Clip.qy, CAD_Bool_Clip.py)
                CAD_Bool_Clip.qz = Float_Sub(CAD_Bool_Clip.qz, CAD_Bool_Clip.pz)
                CAD_Bool_Clip.dy = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.qx, CAD_Bool_Clip.qx), Float_Mul(CAD_Bool_Clip.qy, CAD_Bool_Clip.qy)), Float_Mul(CAD_Bool_Clip.qz, CAD_Bool_Clip.qz))
                IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dy, CAD_Bool_Clip.base), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(0x3F847AE147AE147B, CAD_Bool_Clip.th), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.th, 0x3FEEB851EB851EB8), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dy, CAD_Bool_Clip.dot), 1) ThenBlock: {
                                CAD_Bool_Clip.dot = CAD_Bool_Clip.dy
                                CAD_Bool_Clip.e2 = CAD_Bool_Clip.idx
                                ArraySet(CAD_Bool_Clip.buf, 928, CAD_Bool_Clip.e2)
                                CAD_Bool_Clip.tt = CAD_Bool_Clip.th
                                ArraySet(CAD_Bool_Clip.buf, 935, CAD_Bool_Clip.tt)
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(CAD_BoolClip.FindArc(), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dy, CAD_Bool_Clip.base), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dy, CAD_Bool_Clip.dot), 1) ThenBlock: {
                        CAD_Bool_Clip.dot = CAD_Bool_Clip.dy
                        CAD_Bool_Clip.e2 = CAD_Bool_Clip.idx
                        ArraySet(CAD_Bool_Clip.buf, 928, CAD_Bool_Clip.e2)
                        CAD_Bool_Clip.tt = CAD_Bool_Clip.th
                        ArraySet(CAD_Bool_Clip.buf, 935, CAD_Bool_Clip.tt)
                    }
                }
            }
            CAD_Bool_Clip.n = CAD_Store.Read(CAD_Bool_Clip.idx, 2)
            IfCondition EqualTo(CAD_Bool_Clip.n, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.g = 80 }
            IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: { CAD_Bool_Clip.g = 80 }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
                }
                CAD_Bool_Clip.lp = ArrayGet(CAD_Bool_Clip.buf, 1019)
            }
            ArraySet(CAD_Bool_Clip.buf, 1018, Add(ArrayGet(CAD_Bool_Clip.buf, 1018), 1))
        }
        IfCondition EqualTo(CAD_Bool_Clip.ok, 2) ThenBlock: {
            CAD_Bool_Clip.v = CAD_Bool_Clip.ea
            ReturnValue(2)
        }
        IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 928), 0) ThenBlock: {
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 928)
            CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 935)
            CAD_Bool_Clip.ok = 1
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// buf[860] replaces buf[861] on the shell of .face when they are the same point.
// A hit that already has a vertex on the other cap must be that same vertex,
// or the wall walk looks for a pointer the side loop does not contain.
Function.CAD_BoolClip.Adopt {
    Output: Integer
    Body: {
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 860), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 861), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 860), ArrayGet(CAD_Bool_Clip.buf, 861)) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 830, CAD_Bool_Clip.face)
        ArraySet(CAD_Bool_Clip.buf, 840, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 860), 0))
        ArraySet(CAD_Bool_Clip.buf, 841, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 861), 0))
        ArraySet(CAD_Bool_Clip.buf, 840, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 840), ArrayGet(CAD_Bool_Clip.buf, 841)))
        ArraySet(CAD_Bool_Clip.buf, 842, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 860), 1))
        ArraySet(CAD_Bool_Clip.buf, 843, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 861), 1))
        ArraySet(CAD_Bool_Clip.buf, 842, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 842), ArrayGet(CAD_Bool_Clip.buf, 843)))
        ArraySet(CAD_Bool_Clip.buf, 844, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 860), 2))
        ArraySet(CAD_Bool_Clip.buf, 845, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 861), 2))
        ArraySet(CAD_Bool_Clip.buf, 844, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 844), ArrayGet(CAD_Bool_Clip.buf, 845)))
        ArraySet(CAD_Bool_Clip.buf, 846, Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 840), ArrayGet(CAD_Bool_Clip.buf, 840)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 842), ArrayGet(CAD_Bool_Clip.buf, 842))))
        ArraySet(CAD_Bool_Clip.buf, 846, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 846), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 844), ArrayGet(CAD_Bool_Clip.buf, 844))))
        ArraySet(CAD_Bool_Clip.buf, 847, Float_Mul(0x3FA999999999999A, 0x3FA999999999999A))
        IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 846), ArrayGet(CAD_Bool_Clip.buf, 847)), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 831, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 830), 2))
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 831), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 832, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 831), 0))
        ArraySet(CAD_Bool_Clip.buf, 833, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 833), 48) {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 832), 0) ThenBlock: { ArraySet(CAD_Bool_Clip.buf, 833, 48) }
            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 832), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 834, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 832), 1))
                ArraySet(CAD_Bool_Clip.buf, 835, 0)
                WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 835), 8) {
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 834), 0) ThenBlock: { ArraySet(CAD_Bool_Clip.buf, 835, 8) }
                    IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 834), 0) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 836, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 834), 0))
                        ArraySet(CAD_Bool_Clip.buf, 837, ArrayGet(CAD_Bool_Clip.buf, 836))
                        ArraySet(CAD_Bool_Clip.buf, 838, 0)
                        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 838), 64) {
                            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 837), 0) ThenBlock: { ArraySet(CAD_Bool_Clip.buf, 838, 64) }
                            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 837), 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 837), 5), ArrayGet(CAD_Bool_Clip.buf, 861)) ThenBlock: {
                                    CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 837), 5, ArrayGet(CAD_Bool_Clip.buf, 860))
                                }
                                ArraySet(CAD_Bool_Clip.buf, 839, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 837), 0))
                                IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 839), 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 839), 0), ArrayGet(CAD_Bool_Clip.buf, 861)) ThenBlock: {
                                        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 839), 0, ArrayGet(CAD_Bool_Clip.buf, 860))
                                    }
                                    IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 839), 1), ArrayGet(CAD_Bool_Clip.buf, 861)) ThenBlock: {
                                        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 839), 1, ArrayGet(CAD_Bool_Clip.buf, 860))
                                    }
                                }
                                ArraySet(CAD_Bool_Clip.buf, 839, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 837), 2))
                                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 839), ArrayGet(CAD_Bool_Clip.buf, 836)) ThenBlock: { ArraySet(CAD_Bool_Clip.buf, 838, 64) }
                                IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 839), ArrayGet(CAD_Bool_Clip.buf, 836)) ThenBlock: {
                                    ArraySet(CAD_Bool_Clip.buf, 837, ArrayGet(CAD_Bool_Clip.buf, 839))
                                }
                            }
                            ArraySet(CAD_Bool_Clip.buf, 838, Add(ArrayGet(CAD_Bool_Clip.buf, 838), 1))
                        }
                        ArraySet(CAD_Bool_Clip.buf, 834, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 834), 2))
                    }
                    ArraySet(CAD_Bool_Clip.buf, 835, Add(ArrayGet(CAD_Bool_Clip.buf, 835), 1))
                }
                ArraySet(CAD_Bool_Clip.buf, 832, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 832), 3))
            }
            ArraySet(CAD_Bool_Clip.buf, 833, Add(ArrayGet(CAD_Bool_Clip.buf, 833), 1))
        }
        CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 830)
        ReturnValue(1)
    }
}

Function.CAD_BoolClip.SplitFace {
    Output: Integer
    Body: {
        CAD_Bool_Clip.sb = CAD_Bool_Clip.nv
        // FindArc stores the circle span in .nx. The query point stays in buf.
        ArraySet(CAD_Bool_Clip.buf, 993, CAD_Bool_Clip.px)
        ArraySet(CAD_Bool_Clip.buf, 994, CAD_Bool_Clip.py)
        ArraySet(CAD_Bool_Clip.buf, 995, CAD_Bool_Clip.pz)
        ArraySet(CAD_Bool_Clip.buf, 996, CAD_Bool_Clip.sb)
        CAD_Bool_Clip.ok = CAD_BoolClip.Find()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 2) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 860, ArrayGet(CAD_Bool_Clip.buf, 996))
            ArraySet(CAD_Bool_Clip.buf, 861, CAD_Bool_Clip.v)
            ArraySet(CAD_Bool_Clip.buf, 830, CAD_Bool_Clip.face)
            CAD_Bool_Clip.ok = CAD_BoolClip.Adopt()
            CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 830)
            CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 861)
            IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 860)
            }
            CAD_Bool_Clip.ok = CAD_BoolClip.Bind()
            ReturnValue(CAD_Bool_Clip.ok)
        }
        IfCondition NotEqual(CAD_Bool_Clip.ok, 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, 996)
        IfCondition NotEqual(CAD_Bool_Clip.sb, 0) ThenBlock: { CAD_Bool_Clip.nv = CAD_Bool_Clip.sb }
        IfCondition EqualTo(CAD_Bool_Clip.sb, 0) ThenBlock: {
            CAD_Bool_Clip.px = ArrayGet(CAD_Bool_Clip.buf, 993)
            ArraySet(CAD_Bool_Clip.pt, 0, CAD_Bool_Clip.px)
            CAD_Bool_Clip.py = ArrayGet(CAD_Bool_Clip.buf, 994)
            ArraySet(CAD_Bool_Clip.pt, 1, CAD_Bool_Clip.py)
            CAD_Bool_Clip.pz = ArrayGet(CAD_Bool_Clip.buf, 995)
            ArraySet(CAD_Bool_Clip.pt, 2, CAD_Bool_Clip.pz)
            CAD_Bool_Clip.nv = CAD_Topo.MakeVertex(CAD_Bool_Clip.pt)
        }
        IfCondition EqualTo(CAD_Bool_Clip.nv, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 931, CAD_Bool_Clip.nv)
        CAD_BoolClip.SplitOpen()
        ArraySet(CAD_Bool_Clip.buf, 898, ArrayGet(CAD_Bool_Clip.buf, 928))
        CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 931)
        ReturnValue(1)
    }
}

// 1 when the loop of .n reaches vertex .sb within 64 steps.
// buf[1023] is the cursor. buf[1006] is the start. buf[1005] is the count.
Function.CAD_BoolClip.LoopHas {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 1006, CAD_Bool_Clip.n)
        ArraySet(CAD_Bool_Clip.buf, 1023, CAD_Bool_Clip.n)
        ArraySet(CAD_Bool_Clip.buf, 1005, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 1005), 64) {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1023), 0) ThenBlock: { ReturnValue(0) }
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1023)
            CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
            IfCondition EqualTo(CAD_Bool_Clip.t0, CAD_Bool_Clip.sb) ThenBlock: { ReturnValue(1) }
            CAD_Bool_Clip.n = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1023), 2)
            IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Bool_Clip.n, ArrayGet(CAD_Bool_Clip.buf, 1006)) ThenBlock: { ReturnValue(0) }
            ArraySet(CAD_Bool_Clip.buf, 1023, CAD_Bool_Clip.n)
            ArraySet(CAD_Bool_Clip.buf, 1005, Add(ArrayGet(CAD_Bool_Clip.buf, 1005), 1))
        }
        ReturnValue(0)
    }
}

// Twin of the cap coedge can sit on a loop that the other cap vertex left.
// Find one loop that holds both .sa and .sb. buf[1008] and buf[1009] are those coedges.
Function.CAD_BoolClip.WallSeek {
    Output: Integer
    Body: {
        CAD_Bool_Clip.sa = ArrayGet(CAD_Bool_Clip.buf, 1010)
        CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, 1011)
        ArraySet(CAD_Bool_Clip.buf, 1017, 0)
        ArraySet(CAD_Bool_Clip.buf, 1004, 0)
        CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.ce, 4)
        IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.lp, 1)
        IfCondition EqualTo(CAD_Bool_Clip.face, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.face, 2)
        IfCondition EqualTo(CAD_Bool_Clip.sh, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 1012, CAD_Store.Read(CAD_Bool_Clip.sh, 0))
        ArraySet(CAD_Bool_Clip.buf, 1013, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 1013), 48) {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1012), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 1013, 48)
            }
            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 1012), 0) ThenBlock: {
                CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1012), 1)
                ArraySet(CAD_Bool_Clip.buf, 1020, 0)
                WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 1020), 8) {
                    IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 1020, 8)
                    }
                    IfCondition NotEqual(CAD_Bool_Clip.lp, 0) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 1021, CAD_Store.Read(CAD_Bool_Clip.lp, 2))
                        CAD_Bool_Clip.n = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
                        ArraySet(CAD_Bool_Clip.buf, 1022, CAD_Bool_Clip.n)
                        ArraySet(CAD_Bool_Clip.buf, 1014, 0)
                        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 1014), 64) {
                            IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: {
                                ArraySet(CAD_Bool_Clip.buf, 1014, 64)
                            }
                            IfCondition NotEqual(CAD_Bool_Clip.n, 0) ThenBlock: {
                                ArraySet(CAD_Bool_Clip.buf, 1007, CAD_Store.Read(CAD_Bool_Clip.n, 2))
                                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.n, 5), CAD_Bool_Clip.sa) ThenBlock: {
                                    ArraySet(CAD_Bool_Clip.buf, 1017, Add(ArrayGet(CAD_Bool_Clip.buf, 1017), 1))
                                }
                                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.n, 5), CAD_Bool_Clip.sb) ThenBlock: {
                                    ArraySet(CAD_Bool_Clip.buf, 1004, Add(ArrayGet(CAD_Bool_Clip.buf, 1004), 1))
                                }
                                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.n, 5), CAD_Bool_Clip.sa) ThenBlock: {
                                    ArraySet(CAD_Bool_Clip.buf, 1008, CAD_Bool_Clip.n)
                                    CAD_Bool_Clip.ok = CAD_BoolClip.LoopHas()
                                    CAD_Bool_Clip.sa = ArrayGet(CAD_Bool_Clip.buf, 1010)
                                    CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, 1011)
                                    IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                                        CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, 1022)
                                        ArraySet(CAD_Bool_Clip.buf, 1015, 0)
                                        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 1015), 64) {
                                            IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: {
                                                ArraySet(CAD_Bool_Clip.buf, 1015, 64)
                                            }
                                            IfCondition NotEqual(CAD_Bool_Clip.n, 0) ThenBlock: {
                                                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.n, 5), CAD_Bool_Clip.sb) ThenBlock: {
                                                    ArraySet(CAD_Bool_Clip.buf, 1009, CAD_Bool_Clip.n)
                                                    ReturnValue(1)
                                                }
                                                CAD_Bool_Clip.w1 = CAD_Store.Read(CAD_Bool_Clip.n, 2)
                                                IfCondition EqualTo(CAD_Bool_Clip.w1, ArrayGet(CAD_Bool_Clip.buf, 1022)) ThenBlock: {
                                                    ArraySet(CAD_Bool_Clip.buf, 1015, 64)
                                                }
                                                IfCondition NotEqual(CAD_Bool_Clip.w1, ArrayGet(CAD_Bool_Clip.buf, 1022)) ThenBlock: {
                                                    CAD_Bool_Clip.n = CAD_Bool_Clip.w1
                                                }
                                            }
                                            ArraySet(CAD_Bool_Clip.buf, 1015, Add(ArrayGet(CAD_Bool_Clip.buf, 1015), 1))
                                        }
                                    }
                                }
                                CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 1007)
                                IfCondition EqualTo(CAD_Bool_Clip.w1, ArrayGet(CAD_Bool_Clip.buf, 1022)) ThenBlock: {
                                    ArraySet(CAD_Bool_Clip.buf, 1014, 64)
                                }
                                IfCondition NotEqual(CAD_Bool_Clip.w1, ArrayGet(CAD_Bool_Clip.buf, 1022)) ThenBlock: {
                                    CAD_Bool_Clip.n = CAD_Bool_Clip.w1
                                }
                            }
                            ArraySet(CAD_Bool_Clip.buf, 1014, Add(ArrayGet(CAD_Bool_Clip.buf, 1014), 1))
                        }
                        CAD_Bool_Clip.lp = ArrayGet(CAD_Bool_Clip.buf, 1021)
                    }
                    ArraySet(CAD_Bool_Clip.buf, 1020, Add(ArrayGet(CAD_Bool_Clip.buf, 1020), 1))
                }
                CAD_Bool_Clip.face = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1012), 3)
                ArraySet(CAD_Bool_Clip.buf, 1012, CAD_Bool_Clip.face)
            }
            ArraySet(CAD_Bool_Clip.buf, 1013, Add(ArrayGet(CAD_Bool_Clip.buf, 1013), 1))
        }
        ReturnValue(0)
    }
}

// Wall of cap-end coedges .w0 (at Vt=.sa) and .ea (at Vb=.sb).
Function.CAD_BoolClip.Wall {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Bool_Clip.w0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Clip.ea, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Clip.sa, CAD_Bool_Clip.sb) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.w0, 1)
        CAD_Bool_Clip.cf = CAD_Store.Read(CAD_Bool_Clip.ea, 1)
        IfCondition EqualTo(CAD_Bool_Clip.ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Clip.cf, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 1008, CAD_Bool_Clip.ce)
        ArraySet(CAD_Bool_Clip.buf, 1009, CAD_Bool_Clip.cf)
        ArraySet(CAD_Bool_Clip.buf, 1010, CAD_Bool_Clip.sa)
        ArraySet(CAD_Bool_Clip.buf, 1011, CAD_Bool_Clip.sb)
        CAD_Bool_Clip.n = CAD_Bool_Clip.ce
        CAD_Bool_Clip.ok = CAD_BoolClip.LoopHas()
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1008)
        CAD_Bool_Clip.cf = ArrayGet(CAD_Bool_Clip.buf, 1009)
        CAD_Bool_Clip.sa = ArrayGet(CAD_Bool_Clip.buf, 1010)
        CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, 1011)
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: {
            CAD_Bool_Clip.ok = CAD_BoolClip.WallSeek()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1008)
            CAD_Bool_Clip.cf = ArrayGet(CAD_Bool_Clip.buf, 1009)
            CAD_Bool_Clip.sa = ArrayGet(CAD_Bool_Clip.buf, 1010)
            CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, 1011)
        }
        CAD_Bool_Clip.nh = 0
        CAD_Bool_Clip.n = CAD_Bool_Clip.ce
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, 48) {
            CAD_Bool_Clip.idx = Add(256, CAD_Bool_Clip.nh)
            ArraySet(CAD_Bool_Clip.buf, CAD_Bool_Clip.idx, CAD_Bool_Clip.n)
            CAD_Bool_Clip.nh = Add(CAD_Bool_Clip.nh, 1)
            CAD_Bool_Clip.ce = CAD_Bool_Clip.n
            CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
            IfCondition EqualTo(CAD_Bool_Clip.t0, CAD_Bool_Clip.sb) ThenBlock: { CAD_Bool_Clip.g = 48 }
            IfCondition NotEqual(CAD_Bool_Clip.t0, CAD_Bool_Clip.sb) ThenBlock: {
                CAD_Bool_Clip.n = CAD_Store.Read(CAD_Bool_Clip.n, 2)
                IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: { ReturnValue(0) }
            }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(255, CAD_Bool_Clip.nh))
        CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
        IfCondition NotEqual(CAD_Bool_Clip.t0, CAD_Bool_Clip.sb) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.nt = 0
        CAD_Bool_Clip.n = CAD_Bool_Clip.cf
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, 48) {
            CAD_Bool_Clip.idx = Add(320, CAD_Bool_Clip.nt)
            ArraySet(CAD_Bool_Clip.buf, CAD_Bool_Clip.idx, CAD_Bool_Clip.n)
            CAD_Bool_Clip.nt = Add(CAD_Bool_Clip.nt, 1)
            CAD_Bool_Clip.ce = CAD_Bool_Clip.n
            CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
            IfCondition EqualTo(CAD_Bool_Clip.t0, CAD_Bool_Clip.sa) ThenBlock: { CAD_Bool_Clip.g = 48 }
            IfCondition NotEqual(CAD_Bool_Clip.t0, CAD_Bool_Clip.sa) ThenBlock: {
                CAD_Bool_Clip.n = CAD_Store.Read(CAD_Bool_Clip.n, 2)
                IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: { ReturnValue(0) }
            }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        IfCondition LessThan(CAD_Bool_Clip.nt, 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(319, CAD_Bool_Clip.nt))
        CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
        IfCondition NotEqual(CAD_Bool_Clip.t0, CAD_Bool_Clip.sa) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.pt, 0, CAD_Store.Read(CAD_Bool_Clip.sa, 0))
        ArraySet(CAD_Bool_Clip.pt, 1, CAD_Store.Read(CAD_Bool_Clip.sa, 1))
        ArraySet(CAD_Bool_Clip.pt, 2, CAD_Store.Read(CAD_Bool_Clip.sa, 2))
        ArraySet(CAD_Bool_Clip.p1, 0, CAD_Store.Read(CAD_Bool_Clip.sb, 0))
        ArraySet(CAD_Bool_Clip.p1, 1, CAD_Store.Read(CAD_Bool_Clip.sb, 1))
        ArraySet(CAD_Bool_Clip.p1, 2, CAD_Store.Read(CAD_Bool_Clip.sb, 2))
        CAD_Bool_Clip.ok = CAD_Geom.MakeLine(CAD_Bool_Clip.pt, CAD_Bool_Clip.p1)
        CAD_Bool_Clip.e2 = CAD_Topo.MakeEdge(CAD_Bool_Clip.sa, CAD_Bool_Clip.sb, CAD_Bool_Clip.ok)
        CAD_Bool_Clip.c2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.e2, CAD_Bool_Clip.sa, 1)
        CAD_Bool_Clip.tw2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.e2, CAD_Bool_Clip.sb, 0)
        CAD_Topo.LinkTwins(CAD_Bool_Clip.c2, CAD_Bool_Clip.tw2)
        CAD_Store.Write(CAD_Bool_Clip.e2, 3, CAD_Bool_Clip.c2)
        CAD_Store.Write(CAD_Bool_Clip.e2, 4, CAD_Bool_Clip.tw2)
        CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, 256)
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, Add(255, CAD_Bool_Clip.nh))
        CAD_Store.Write(CAD_Bool_Clip.w1, 2, CAD_Bool_Clip.tw2)
        CAD_Store.Write(CAD_Bool_Clip.tw2, 3, CAD_Bool_Clip.w1)
        CAD_Store.Write(CAD_Bool_Clip.tw2, 2, CAD_Bool_Clip.w0)
        CAD_Store.Write(CAD_Bool_Clip.w0, 3, CAD_Bool_Clip.tw2)
        CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.w0, 4)
        CAD_Store.Write(CAD_Bool_Clip.tw2, 4, CAD_Bool_Clip.lp)
        CAD_Store.Write(CAD_Bool_Clip.lp, 0, CAD_Bool_Clip.w0)
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, CAD_Bool_Clip.nh) {
            CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, Add(256, CAD_Bool_Clip.g))
            CAD_Store.Write(CAD_Bool_Clip.n, 4, CAD_Bool_Clip.lp)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.lp, 1)
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.face, 2)
        CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.face, 0)
        CAD_Bool_Clip.sa = ArrayGet(CAD_Bool_Clip.buf, 320)
        CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, Add(319, CAD_Bool_Clip.nt))
        CAD_Store.Write(CAD_Bool_Clip.sb, 2, CAD_Bool_Clip.c2)
        CAD_Store.Write(CAD_Bool_Clip.c2, 3, CAD_Bool_Clip.sb)
        CAD_Store.Write(CAD_Bool_Clip.c2, 2, CAD_Bool_Clip.sa)
        CAD_Store.Write(CAD_Bool_Clip.sa, 3, CAD_Bool_Clip.c2)
        CAD_Bool_Clip.n = CAD_Topo.MakeLoop(CAD_Bool_Clip.sa)
        CAD_Store.Write(CAD_Bool_Clip.c2, 4, CAD_Bool_Clip.n)
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, CAD_Bool_Clip.nt) {
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(320, CAD_Bool_Clip.g))
            CAD_Store.Write(CAD_Bool_Clip.ce, 4, CAD_Bool_Clip.n)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        CAD_Bool_Clip.v = CAD_Topo.MakeFace(CAD_Bool_Clip.eb, CAD_Bool_Clip.n)
        CAD_Topo.ShellAppendFace(CAD_Bool_Clip.sh, CAD_Bool_Clip.v)
        // The chord splits the adjacent face. A hole that sits on one island
        // moves there. A hole the chord crosses is cut into the two islands.
        ArraySet(CAD_Bool_Clip.buf, 990, CAD_Bool_Clip.face)
        ArraySet(CAD_Bool_Clip.buf, 400, CAD_Bool_Clip.face)
        ArraySet(CAD_Bool_Clip.buf, 401, CAD_Bool_Clip.v)
        ArraySet(CAD_Bool_Clip.buf, 387, 1)
        ArraySet(CAD_Bool_Clip.buf, 388, CAD_Store.Read(CAD_Bool_Clip.e2, 0))
        ArraySet(CAD_Bool_Clip.buf, 389, CAD_Store.Read(CAD_Bool_Clip.e2, 1))
        CAD_Bool_Clip.idx = 2
        CAD_Bool_Clip.ok = CAD_BoolClip.KeepHole()
        IfCondition LessThan(CAD_Bool_Clip.ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.CAD_BoolClip.One {
    Output: Integer
    Body: {
        CAD_Bool_Clip.idx = Multiply(CAD_Bool_Clip.g, 8)
        CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.idx, 512)
        CAD_Bool_Clip.px = ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.idx)
        CAD_Bool_Clip.py = ArrayGet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.idx, 1))
        CAD_Bool_Clip.pz = ArrayGet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.idx, 2))
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.idx, 3))
        CAD_Bool_Clip.s0 = CAD_Bool_Clip.px
        CAD_Bool_Clip.s1 = CAD_Bool_Clip.py
        CAD_Bool_Clip.s2 = CAD_Bool_Clip.pz
        CAD_Bool_Clip.face = CAD_Bool_Clip.hf0
        CAD_Bool_Clip.ok = CAD_BoolClip.SplitFace()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 900, ArrayGet(CAD_Bool_Clip.buf, 898))
        ArraySet(CAD_Bool_Clip.buf, 901, CAD_Bool_Clip.v)
        CAD_Bool_Clip.px = CAD_Bool_Clip.s0
        CAD_Bool_Clip.py = CAD_Bool_Clip.s1
        CAD_Bool_Clip.pz = CAD_Bool_Clip.s2
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 901)
        CAD_Bool_Clip.face = CAD_Bool_Clip.f0
        CAD_Bool_Clip.ok = CAD_BoolClip.SplitFace()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 902, ArrayGet(CAD_Bool_Clip.buf, 898))
        CAD_Bool_Clip.px = Float_Add(CAD_Bool_Clip.s0, CAD_Bool_Clip.ox)
        CAD_Bool_Clip.py = Float_Add(CAD_Bool_Clip.s1, CAD_Bool_Clip.oy)
        CAD_Bool_Clip.pz = Float_Add(CAD_Bool_Clip.s2, CAD_Bool_Clip.oz)
        ArraySet(CAD_Bool_Clip.buf, 970, CAD_Bool_Clip.px)
        ArraySet(CAD_Bool_Clip.buf, 971, CAD_Bool_Clip.py)
        ArraySet(CAD_Bool_Clip.buf, 972, CAD_Bool_Clip.pz)
        CAD_Bool_Clip.nv = 0
        CAD_Bool_Clip.face = CAD_Bool_Clip.hf1
        CAD_Bool_Clip.ok = CAD_BoolClip.SplitFace()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 903, ArrayGet(CAD_Bool_Clip.buf, 898))
        ArraySet(CAD_Bool_Clip.buf, 904, CAD_Bool_Clip.v)
        CAD_Bool_Clip.px = ArrayGet(CAD_Bool_Clip.buf, 970)
        CAD_Bool_Clip.py = ArrayGet(CAD_Bool_Clip.buf, 971)
        CAD_Bool_Clip.pz = ArrayGet(CAD_Bool_Clip.buf, 972)
        CAD_Bool_Clip.nv = ArrayGet(CAD_Bool_Clip.buf, 904)
        CAD_Bool_Clip.face = CAD_Bool_Clip.f1
        CAD_Bool_Clip.ok = CAD_BoolClip.SplitFace()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 905, ArrayGet(CAD_Bool_Clip.buf, 898))
        CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, 900)
        CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 903)
        CAD_Bool_Clip.sa = ArrayGet(CAD_Bool_Clip.buf, 901)
        CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, 904)
        CAD_Bool_Clip.ok = CAD_BoolClip.Wall()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, 902)
        CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 905)
        CAD_Bool_Clip.sa = ArrayGet(CAD_Bool_Clip.buf, 901)
        CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, 904)
        CAD_Bool_Clip.ok = CAD_BoolClip.Wall()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Bool_Clip.ok)
    }
}

// 1 when coedge .ce midpoint is inside .face.
Function.CAD_BoolClip.MidIn {
    Output: Integer
    Body: {
        CAD_Bool_Clip.th = 0x3FE0000000000000
        CAD_BoolClip.At()
        CAD_Bool_Clip.ok = CAD_BoolClip.Inn()
        ReturnValue(CAD_Bool_Clip.ok)
    }
}

// 1 when the midpoint is strictly inside .face. A point on the boundary
// is not inside: that coedge is the host edge the tool lies along.
Function.CAD_BoolClip.MidStrict {
    Output: Integer
    Body: {
        CAD_Bool_Clip.th = 0x3FE0000000000000
        CAD_BoolClip.At()
        CAD_Bool_Clip.ok = CAD_BoolClip.Inn()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
            CAD_Bool_Clip.ok = CAD_BoolClip.OnBound()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Drop a host wall fragment whose cap edges all lie inside the tool.
Function.CAD_BoolClip.DropHost {
    Output: Integer
    Body: {
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.host, 0)
        CAD_Bool_Clip.n = 0
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
            IfCondition LessThan(CAD_Bool_Clip.n, 48) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.n), CAD_Bool_Clip.face)
                CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
            }
            CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.face, 3)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 80) ThenBlock: { CAD_Bool_Clip.face = 0 }
        }
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, CAD_Bool_Clip.n) {
            CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.g))
            IfCondition NotEqual(CAD_Bool_Clip.ea, CAD_Bool_Clip.hf0) ThenBlock: {
                IfCondition NotEqual(CAD_Bool_Clip.ea, CAD_Bool_Clip.hf1) ThenBlock: {
                    CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.ea, 1)
                    CAD_Bool_Clip.cf = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
                    CAD_Bool_Clip.ce = CAD_Bool_Clip.cf
                    CAD_Bool_Clip.fg = 0
                    CAD_Bool_Clip.nh = 0
                    CAD_Bool_Clip.nt = 0
                    CAD_Bool_Clip.idx = 0
                    WhileLoop LessThan(CAD_Bool_Clip.idx, 24) {
                        CAD_Bool_Clip.tw = CAD_Store.Read(CAD_Bool_Clip.ce, 1)
                        IfCondition NotEqual(CAD_Bool_Clip.tw, 0) ThenBlock: {
                            CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.tw, 4)
                            CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.v, 1)
                            IfCondition EqualTo(CAD_Bool_Clip.w0, CAD_Bool_Clip.hf0) ThenBlock: { CAD_Bool_Clip.nh = 1 }
                            IfCondition EqualTo(CAD_Bool_Clip.w0, CAD_Bool_Clip.hf1) ThenBlock: { CAD_Bool_Clip.nh = 1 }
                            IfCondition EqualTo(CAD_Bool_Clip.nh, 1) ThenBlock: {
                                CAD_Bool_Clip.fg = Add(CAD_Bool_Clip.fg, 1)
                                CAD_Bool_Clip.sa = CAD_Bool_Clip.ce
                                CAD_Bool_Clip.ce = CAD_Bool_Clip.tw
                                // The far cap is not inside the near disk.
                                CAD_Bool_Clip.face = CAD_Bool_Clip.f0
                                IfCondition EqualTo(CAD_Bool_Clip.w0, CAD_Bool_Clip.hf1) ThenBlock: {
                                    CAD_Bool_Clip.face = CAD_Bool_Clip.f1
                                }
                                CAD_Bool_Clip.ok = CAD_BoolClip.MidIn()
                                IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: { CAD_Bool_Clip.nt = Add(CAD_Bool_Clip.nt, 1) }
                                CAD_Bool_Clip.ce = CAD_Bool_Clip.sa
                                CAD_Bool_Clip.nh = 0
                            }
                        }
                        CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
                        IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.idx = 24 }
                        CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.idx, 1)
                    }
                    IfCondition GreaterThan(CAD_Bool_Clip.fg, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Bool_Clip.fg, CAD_Bool_Clip.nt) ThenBlock: {
                            CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.host, 0)
                            CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.g))
                            CAD_Topo.ShellUnlinkFace(CAD_Bool_Clip.sh, CAD_Bool_Clip.ea)
                        }
                    }
                }
            }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        ReturnValue(1)
    }
}

// Move tool wall fragments whose cap edges lie inside the host onto the host.
Function.CAD_BoolClip.Steal {
    Output: Integer
    Body: {
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.tool, 0)
        CAD_Bool_Clip.n = 0
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
            IfCondition LessThan(CAD_Bool_Clip.n, 48) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.n), CAD_Bool_Clip.face)
                CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
            }
            CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.face, 3)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 80) ThenBlock: { CAD_Bool_Clip.face = 0 }
        }
        CAD_Bool_Clip.s3 = CAD_Store.Read(CAD_Bool_Clip.host, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, CAD_Bool_Clip.n) {
            CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.g))
            IfCondition NotEqual(CAD_Bool_Clip.ea, CAD_Bool_Clip.f0) ThenBlock: {
                IfCondition NotEqual(CAD_Bool_Clip.ea, CAD_Bool_Clip.f1) ThenBlock: {
                    CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.ea, 1)
                    CAD_Bool_Clip.cf = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
                    CAD_Bool_Clip.ce = CAD_Bool_Clip.cf
                    CAD_Bool_Clip.fg = 0
                    CAD_Bool_Clip.nt = 0
                    CAD_Bool_Clip.idx = 0
                    WhileLoop LessThan(CAD_Bool_Clip.idx, 24) {
                        CAD_Bool_Clip.tw = CAD_Store.Read(CAD_Bool_Clip.ce, 1)
                        IfCondition NotEqual(CAD_Bool_Clip.tw, 0) ThenBlock: {
                            CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.tw, 4)
                            CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.v, 1)
                            CAD_Bool_Clip.nh = 0
                            IfCondition EqualTo(CAD_Bool_Clip.w0, CAD_Bool_Clip.f0) ThenBlock: { CAD_Bool_Clip.nh = 1 }
                            IfCondition EqualTo(CAD_Bool_Clip.w0, CAD_Bool_Clip.f1) ThenBlock: { CAD_Bool_Clip.nh = 1 }
                            IfCondition EqualTo(CAD_Bool_Clip.nh, 1) ThenBlock: {
                                CAD_Bool_Clip.fg = Add(CAD_Bool_Clip.fg, 1)
                                CAD_Bool_Clip.sa = CAD_Bool_Clip.ce
                                CAD_Bool_Clip.ce = CAD_Bool_Clip.tw
                                CAD_Bool_Clip.face = CAD_Bool_Clip.hf0
                                IfCondition EqualTo(CAD_Bool_Clip.w0, CAD_Bool_Clip.f1) ThenBlock: {
                                    CAD_Bool_Clip.face = CAD_Bool_Clip.hf1
                                }
                                CAD_Bool_Clip.ok = CAD_BoolClip.MidStrict()
                                IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: { CAD_Bool_Clip.nt = Add(CAD_Bool_Clip.nt, 1) }
                                CAD_Bool_Clip.ce = CAD_Bool_Clip.sa
                            }
                        }
                        CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
                        IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.idx = 24 }
                        CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.idx, 1)
                    }
                    IfCondition GreaterThan(CAD_Bool_Clip.fg, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Bool_Clip.fg, CAD_Bool_Clip.nt) ThenBlock: {
                            CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.g))
                            CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.tool, 0)
                            CAD_Topo.ShellUnlinkFace(CAD_Bool_Clip.sh, CAD_Bool_Clip.ea)
                            CAD_Bool_Clip.s3 = CAD_Store.Read(CAD_Bool_Clip.host, 0)
                            CAD_Topo.ShellAppendFace(CAD_Bool_Clip.s3, CAD_Bool_Clip.ea)
                        }
                    }
                }
            }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        ReturnValue(1)
    }
}

// Chain kept coedges in buf[0..nh). Flags in buf[128+]. 1 on a closed chain.
Function.CAD_BoolClip.Chain {
    Output: Integer
    Body: {
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, CAD_Bool_Clip.nh) {
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.g)
            CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
            CAD_Bool_Clip.ea = 0
            CAD_Bool_Clip.n = 0
            WhileLoop LessThan(CAD_Bool_Clip.n, CAD_Bool_Clip.nh) {
                CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.n)
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.v, 5), CAD_Bool_Clip.t0) ThenBlock: {
                    CAD_Bool_Clip.ea = CAD_Bool_Clip.n
                    CAD_Bool_Clip.n = CAD_Bool_Clip.nh
                }
                CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
            }
            IfCondition EqualTo(CAD_Bool_Clip.ea, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 0), 5), CAD_Bool_Clip.t0) ThenBlock: {
                    ReturnValue(0)
                }
            }
            ArraySet(CAD_Bool_Clip.buf, Add(192, CAD_Bool_Clip.g), CAD_Bool_Clip.ea)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, CAD_Bool_Clip.nh) {
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.g)
            CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, Add(192, CAD_Bool_Clip.g))
            CAD_Bool_Clip.c2 = ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.n)
            CAD_Store.Write(CAD_Bool_Clip.ce, 2, CAD_Bool_Clip.c2)
            CAD_Store.Write(CAD_Bool_Clip.c2, 3, CAD_Bool_Clip.ce)
            ArraySet(CAD_Bool_Clip.buf, Add(256, CAD_Bool_Clip.g), 0)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        // A circle across the short edges leaves two islands. One loop
        // kept the first island and the other side stayed open.
        ArraySet(CAD_Bool_Clip.buf, 990, CAD_Bool_Clip.face)
        ArraySet(CAD_Bool_Clip.buf, 989, CAD_Bool_Clip.nh)
        CAD_Bool_Clip.idx = 0
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, ArrayGet(CAD_Bool_Clip.buf, 989)) {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, Add(256, CAD_Bool_Clip.g)), 0) ThenBlock: {
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.g)
                ArraySet(CAD_Bool_Clip.buf, 991, CAD_Bool_Clip.ce)
                ArraySet(CAD_Bool_Clip.buf, 992, CAD_Bool_Clip.g)
                IfCondition EqualTo(CAD_Bool_Clip.idx, 0) ThenBlock: {
                    CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 990)
                    CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
                    CAD_Store.Write(CAD_Bool_Clip.lp, 0, CAD_Bool_Clip.ce)
                    CAD_Store.Write(CAD_Bool_Clip.lp, 1, CAD_Bool_Clip.face)
                }
                IfCondition NotEqual(CAD_Bool_Clip.idx, 0) ThenBlock: {
                    CAD_Bool_Clip.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Bool_Clip.buf, 991))
                    ArraySet(CAD_Bool_Clip.buf, 993, CAD_Bool_Clip.lp)
                    CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 990)
                    CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.face, 0)
                    CAD_Bool_Clip.v = CAD_Topo.MakeFace(CAD_Bool_Clip.ea, ArrayGet(CAD_Bool_Clip.buf, 993))
                    ArraySet(CAD_Bool_Clip.buf, 994, CAD_Bool_Clip.v)
                    CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 990)
                    CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.face, 2)
                    CAD_Topo.ShellAppendFace(CAD_Bool_Clip.sh, ArrayGet(CAD_Bool_Clip.buf, 994))
                    CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 994), 1)
                }
                ArraySet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.idx), ArrayGet(CAD_Bool_Clip.buf, 990))
                IfCondition NotEqual(CAD_Bool_Clip.idx, 0) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.idx), ArrayGet(CAD_Bool_Clip.buf, 994))
                }
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 991)
                CAD_Bool_Clip.sa = CAD_Bool_Clip.ce
                CAD_Bool_Clip.n = 0
                WhileLoop LessThan(CAD_Bool_Clip.n, ArrayGet(CAD_Bool_Clip.buf, 989)) {
                    CAD_Store.Write(CAD_Bool_Clip.ce, 4, CAD_Bool_Clip.lp)
                    CAD_Bool_Clip.ea = 0
                    CAD_Bool_Clip.c2 = 0
                    WhileLoop LessThan(CAD_Bool_Clip.ea, ArrayGet(CAD_Bool_Clip.buf, 989)) {
                        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.ea), CAD_Bool_Clip.ce) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, Add(256, CAD_Bool_Clip.ea), 1)
                            CAD_Bool_Clip.c2 = 1
                            CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 989)
                        }
                        CAD_Bool_Clip.ea = Add(CAD_Bool_Clip.ea, 1)
                    }
                    CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
                    IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.sa) ThenBlock: {
                        CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, 989)
                    }
                    CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
                }
                CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.idx, 1)
                CAD_Bool_Clip.g = ArrayGet(CAD_Bool_Clip.buf, 992)
            }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        // Inner loops stayed on the first island. The other cap's first
        // island is the other piece, so one cap kept the hole and one filled it.
        // No chord here. A stale Wall chord must not cut these loops.
        IfCondition GreaterThan(CAD_Bool_Clip.idx, 1) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 387, 0)
            CAD_Bool_Clip.ok = CAD_BoolClip.KeepHole()
        }
        ReturnValue(1)
    }
}

// Vertex .v on plane .pl → UV in .u0 .v0.
Function.CAD_BoolClip.VertUV {
    Output: Integer
    Body: {
        CAD_Bool_Clip.qx = CAD_Store.Read(CAD_Bool_Clip.v, 0)
        CAD_Bool_Clip.qy = CAD_Store.Read(CAD_Bool_Clip.v, 1)
        CAD_Bool_Clip.qz = CAD_Store.Read(CAD_Bool_Clip.v, 2)
        CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.qx, ArrayGet(CAD_Bool_Clip.pl, 1))
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.qy, ArrayGet(CAD_Bool_Clip.pl, 2))
        CAD_Bool_Clip.dz = Float_Sub(CAD_Bool_Clip.qz, ArrayGet(CAD_Bool_Clip.pl, 3))
        CAD_Bool_Clip.u0 = Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.pl, 4))
        CAD_Bool_Clip.u0 = Float_Add(CAD_Bool_Clip.u0, Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.pl, 5)))
        CAD_Bool_Clip.u0 = Float_Add(CAD_Bool_Clip.u0, Float_Mul(CAD_Bool_Clip.dz, ArrayGet(CAD_Bool_Clip.pl, 6)))
        CAD_Bool_Clip.v0 = Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.pl, 7))
        CAD_Bool_Clip.v0 = Float_Add(CAD_Bool_Clip.v0, Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.pl, 8)))
        CAD_Bool_Clip.v0 = Float_Add(CAD_Bool_Clip.v0, Float_Mul(CAD_Bool_Clip.dz, ArrayGet(CAD_Bool_Clip.pl, 9)))
        ReturnValue(0)
    }
}

// +U ray from (.px,.py) against segment (.u0,.v0)-(.u1,.v1). 1 = cross.
Function.CAD_BoolClip.RayUV {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ax = 0
        IfCondition NotEqual(CAD_Num.Le(CAD_Bool_Clip.v0, CAD_Bool_Clip.py), 1) ThenBlock: { CAD_Bool_Clip.ax = 1 }
        CAD_Bool_Clip.ay = 0
        IfCondition NotEqual(CAD_Num.Le(CAD_Bool_Clip.v1, CAD_Bool_Clip.py), 1) ThenBlock: { CAD_Bool_Clip.ay = 1 }
        IfCondition EqualTo(CAD_Bool_Clip.ax, CAD_Bool_Clip.ay) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.v1, CAD_Bool_Clip.v0)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Clip.dy, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.tt = Float_Div(Float_Sub(CAD_Bool_Clip.py, CAD_Bool_Clip.v0), CAD_Bool_Clip.dy)
        CAD_Bool_Clip.dist = Float_Add(CAD_Bool_Clip.u0, Float_Mul(CAD_Bool_Clip.tt, Float_Sub(CAD_Bool_Clip.u1, CAD_Bool_Clip.u0)))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dist, CAD_Bool_Clip.px), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Odd-even of one loop against UV (.px,.py). Plane is .pl.
Function.CAD_BoolClip.LoopOdd {
    Output: Integer
    Body: {
        CAD_Bool_Clip.n = 0
        CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
        CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
            CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
            CAD_BoolClip.VertUV()
            CAD_Bool_Clip.s0 = CAD_Bool_Clip.u0
            CAD_Bool_Clip.s1 = CAD_Bool_Clip.v0
            CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
            CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.w0, 5)
            CAD_BoolClip.VertUV()
            CAD_Bool_Clip.u1 = CAD_Bool_Clip.u0
            CAD_Bool_Clip.v1 = CAD_Bool_Clip.v0
            CAD_Bool_Clip.u0 = CAD_Bool_Clip.s0
            CAD_Bool_Clip.v0 = CAD_Bool_Clip.s1
            CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, CAD_BoolClip.RayUV())
            CAD_Bool_Clip.ce = CAD_Bool_Clip.w0
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 80) ThenBlock: { CAD_Bool_Clip.ce = 0 }
        }
        ReturnValue(BitwiseAnd(CAD_Bool_Clip.n, 1))
    }
}

// Coedge .ce against the chord in buf[380..383]. 1 when the segment crosses.
// Point in .px .py .pz. Parameter along the coedge in .th.
Function.CAD_BoolClip.SegCross {
    Output: Integer
    Body: {
        CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
        CAD_BoolClip.VertUV()
        CAD_Bool_Clip.s0 = CAD_Bool_Clip.u0
        CAD_Bool_Clip.s1 = CAD_Bool_Clip.v0
        CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
        CAD_Bool_Clip.v = CAD_Bool_Clip.t0
        CAD_BoolClip.VertUV()
        CAD_Bool_Clip.u1 = CAD_Bool_Clip.u0
        CAD_Bool_Clip.v1 = CAD_Bool_Clip.v0
        CAD_Bool_Clip.u0 = CAD_Bool_Clip.s0
        CAD_Bool_Clip.v0 = CAD_Bool_Clip.s1
        CAD_Bool_Clip.ax = Float_Sub(CAD_Bool_Clip.u1, CAD_Bool_Clip.u0)
        CAD_Bool_Clip.ay = Float_Sub(CAD_Bool_Clip.v1, CAD_Bool_Clip.v0)
        CAD_Bool_Clip.bx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 382), ArrayGet(CAD_Bool_Clip.buf, 380))
        CAD_Bool_Clip.by = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 383), ArrayGet(CAD_Bool_Clip.buf, 381))
        CAD_Bool_Clip.dist = Float_Sub(Float_Mul(CAD_Bool_Clip.ax, CAD_Bool_Clip.by), Float_Mul(CAD_Bool_Clip.ay, CAD_Bool_Clip.bx))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Clip.dist, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.qx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 380), CAD_Bool_Clip.u0)
        CAD_Bool_Clip.qy = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 381), CAD_Bool_Clip.v0)
        CAD_Bool_Clip.th = Float_Div(Float_Sub(Float_Mul(CAD_Bool_Clip.qx, CAD_Bool_Clip.by), Float_Mul(CAD_Bool_Clip.qy, CAD_Bool_Clip.bx)), CAD_Bool_Clip.dist)
        CAD_Bool_Clip.tt = Float_Div(Float_Sub(Float_Mul(CAD_Bool_Clip.qx, CAD_Bool_Clip.ay), Float_Mul(CAD_Bool_Clip.qy, CAD_Bool_Clip.ax)), CAD_Bool_Clip.dist)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.th, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(0x3FF0000000000000, CAD_Bool_Clip.th), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.tt, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(0x3FF0000000000000, CAD_Bool_Clip.tt), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
        CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.w0, 0)
        CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.w0, 1)
        CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.w0, 2)
        CAD_Bool_Clip.px = Float_Add(CAD_Bool_Clip.px, Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.t0, 0), CAD_Bool_Clip.px)))
        CAD_Bool_Clip.py = Float_Add(CAD_Bool_Clip.py, Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.t0, 1), CAD_Bool_Clip.py)))
        CAD_Bool_Clip.pz = Float_Add(CAD_Bool_Clip.pz, Float_Mul(CAD_Bool_Clip.th, Float_Sub(CAD_Store.Read(CAD_Bool_Clip.t0, 2), CAD_Bool_Clip.pz)))
        // A fraction of a long edge is still a real crossing. Only an
        // intersection within 0.05 mm of an end is that end.
        CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.px, CAD_Store.Read(CAD_Bool_Clip.w0, 0))
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.py, CAD_Store.Read(CAD_Bool_Clip.w0, 1))
        CAD_Bool_Clip.s0 = Float_Sub(CAD_Bool_Clip.pz, CAD_Store.Read(CAD_Bool_Clip.w0, 2))
        CAD_Bool_Clip.dot = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.dx), Float_Mul(CAD_Bool_Clip.dy, CAD_Bool_Clip.dy)), Float_Mul(CAD_Bool_Clip.s0, CAD_Bool_Clip.s0))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, 0x3F647AE147AE147B), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.px, CAD_Store.Read(CAD_Bool_Clip.t0, 0))
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.py, CAD_Store.Read(CAD_Bool_Clip.t0, 1))
        CAD_Bool_Clip.s0 = Float_Sub(CAD_Bool_Clip.pz, CAD_Store.Read(CAD_Bool_Clip.t0, 2))
        CAD_Bool_Clip.dot = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.dx), Float_Mul(CAD_Bool_Clip.dy, CAD_Bool_Clip.dy)), Float_Mul(CAD_Bool_Clip.s0, CAD_Bool_Clip.s0))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, 0x3F647AE147AE147B), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, 388)
        CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.px, CAD_Store.Read(CAD_Bool_Clip.w0, 0))
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.py, CAD_Store.Read(CAD_Bool_Clip.w0, 1))
        CAD_Bool_Clip.s0 = Float_Sub(CAD_Bool_Clip.pz, CAD_Store.Read(CAD_Bool_Clip.w0, 2))
        CAD_Bool_Clip.dot = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.dx), Float_Mul(CAD_Bool_Clip.dy, CAD_Bool_Clip.dy)), Float_Mul(CAD_Bool_Clip.s0, CAD_Bool_Clip.s0))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, 0x3F647AE147AE147B), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, 389)
        CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.px, CAD_Store.Read(CAD_Bool_Clip.w0, 0))
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.py, CAD_Store.Read(CAD_Bool_Clip.w0, 1))
        CAD_Bool_Clip.s0 = Float_Sub(CAD_Bool_Clip.pz, CAD_Store.Read(CAD_Bool_Clip.w0, 2))
        CAD_Bool_Clip.dot = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.dx), Float_Mul(CAD_Bool_Clip.dy, CAD_Bool_Clip.dy)), Float_Mul(CAD_Bool_Clip.s0, CAD_Bool_Clip.s0))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, 0x3F647AE147AE147B), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Chord buf[388], buf[389] crosses loop buf[398]. Split it onto the two islands.
// 1 when the loop was cut. 0 when it was left whole.
Function.CAD_BoolClip.CutLoop {
    Output: Integer
    Body: {
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 388), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 389), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 388)
        CAD_BoolClip.VertUV()
        ArraySet(CAD_Bool_Clip.buf, 380, CAD_Bool_Clip.u0)
        ArraySet(CAD_Bool_Clip.buf, 381, CAD_Bool_Clip.v0)
        CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 389)
        CAD_BoolClip.VertUV()
        ArraySet(CAD_Bool_Clip.buf, 382, CAD_Bool_Clip.u0)
        ArraySet(CAD_Bool_Clip.buf, 383, CAD_Bool_Clip.v0)
        CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 398), 0)
        CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
        ArraySet(CAD_Bool_Clip.buf, 376, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
            ArraySet(CAD_Bool_Clip.buf, 378, CAD_Bool_Clip.ce)
            CAD_Bool_Clip.ok = CAD_BoolClip.SegCross()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 376), 2) ThenBlock: {
                    CAD_Bool_Clip.n = Multiply(ArrayGet(CAD_Bool_Clip.buf, 376), 8)
                    CAD_Bool_Clip.n = Add(420, CAD_Bool_Clip.n)
                    ArraySet(CAD_Bool_Clip.buf, CAD_Bool_Clip.n, ArrayGet(CAD_Bool_Clip.buf, 378))
                    ArraySet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.n, 1), CAD_Bool_Clip.px)
                    ArraySet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.n, 2), CAD_Bool_Clip.py)
                    ArraySet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.n, 3), CAD_Bool_Clip.pz)
                    ArraySet(CAD_Bool_Clip.buf, 376, Add(ArrayGet(CAD_Bool_Clip.buf, 376), 1))
                }
            }
            CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 378), 2)
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 40) ThenBlock: { CAD_Bool_Clip.ce = 0 }
        }
        IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 376), 2) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, 2) {
            CAD_Bool_Clip.n = Multiply(CAD_Bool_Clip.g, 8)
            CAD_Bool_Clip.n = Add(420, CAD_Bool_Clip.n)
            ArraySet(CAD_Bool_Clip.pt, 0, ArrayGet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.n, 1)))
            ArraySet(CAD_Bool_Clip.pt, 1, ArrayGet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.n, 2)))
            ArraySet(CAD_Bool_Clip.pt, 2, ArrayGet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.n, 3)))
            CAD_Bool_Clip.nv = CAD_Topo.MakeVertex(CAD_Bool_Clip.pt)
            ArraySet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.n, 4), CAD_Bool_Clip.nv)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        ArraySet(CAD_Bool_Clip.buf, 366, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 366), 2) {
            CAD_Bool_Clip.n = Multiply(ArrayGet(CAD_Bool_Clip.buf, 366), 8)
            CAD_Bool_Clip.n = Add(420, CAD_Bool_Clip.n)
            ArraySet(CAD_Bool_Clip.buf, 367, CAD_Bool_Clip.n)
            ArraySet(CAD_Bool_Clip.buf, 928, ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.n))
            ArraySet(CAD_Bool_Clip.buf, 931, ArrayGet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.n, 4)))
            CAD_Bool_Clip.ok = CAD_BoolClip.SplitOpen()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
            CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, 367)
            ArraySet(CAD_Bool_Clip.buf, Add(CAD_Bool_Clip.n, 5), CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.n), 2))
            ArraySet(CAD_Bool_Clip.buf, 366, Add(ArrayGet(CAD_Bool_Clip.buf, 366), 1))
        }
        ArraySet(CAD_Bool_Clip.buf, 370, ArrayGet(CAD_Bool_Clip.buf, 425))
        ArraySet(CAD_Bool_Clip.buf, 371, ArrayGet(CAD_Bool_Clip.buf, 433))
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 370)
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Store.Read(CAD_Bool_Clip.ce, 2), ArrayGet(CAD_Bool_Clip.buf, 371)) {
            CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 40) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Bool_Clip.ce, 0) ThenBlock: { ReturnValue(0) }
        }
        ArraySet(CAD_Bool_Clip.buf, 374, CAD_Bool_Clip.ce)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 371)
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Store.Read(CAD_Bool_Clip.ce, 2), ArrayGet(CAD_Bool_Clip.buf, 370)) {
            CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 40) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Bool_Clip.ce, 0) ThenBlock: { ReturnValue(0) }
        }
        ArraySet(CAD_Bool_Clip.buf, 375, CAD_Bool_Clip.ce)
        ArraySet(CAD_Bool_Clip.pt, 0, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 424), 0))
        ArraySet(CAD_Bool_Clip.pt, 1, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 424), 1))
        ArraySet(CAD_Bool_Clip.pt, 2, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 424), 2))
        ArraySet(CAD_Bool_Clip.p1, 0, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 0))
        ArraySet(CAD_Bool_Clip.p1, 1, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 1))
        ArraySet(CAD_Bool_Clip.p1, 2, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 2))
        CAD_Bool_Clip.ok = CAD_Geom.MakeLine(CAD_Bool_Clip.pt, CAD_Bool_Clip.p1)
        CAD_Bool_Clip.e2 = CAD_Topo.MakeEdge(ArrayGet(CAD_Bool_Clip.buf, 424), ArrayGet(CAD_Bool_Clip.buf, 432), CAD_Bool_Clip.ok)
        CAD_Bool_Clip.c2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.e2, ArrayGet(CAD_Bool_Clip.buf, 432), 0)
        CAD_Bool_Clip.tw2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.e2, ArrayGet(CAD_Bool_Clip.buf, 424), 1)
        CAD_Topo.LinkTwins(CAD_Bool_Clip.c2, CAD_Bool_Clip.tw2)
        CAD_Store.Write(CAD_Bool_Clip.e2, 3, CAD_Bool_Clip.c2)
        CAD_Store.Write(CAD_Bool_Clip.e2, 4, CAD_Bool_Clip.tw2)
        ArraySet(CAD_Bool_Clip.buf, 368, CAD_Bool_Clip.c2)
        ArraySet(CAD_Bool_Clip.buf, 369, CAD_Bool_Clip.tw2)
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 374), 2, ArrayGet(CAD_Bool_Clip.buf, 368))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 368), 3, ArrayGet(CAD_Bool_Clip.buf, 374))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 368), 2, ArrayGet(CAD_Bool_Clip.buf, 370))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 370), 3, ArrayGet(CAD_Bool_Clip.buf, 368))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 375), 2, ArrayGet(CAD_Bool_Clip.buf, 369))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 369), 3, ArrayGet(CAD_Bool_Clip.buf, 375))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 369), 2, ArrayGet(CAD_Bool_Clip.buf, 371))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 371), 3, ArrayGet(CAD_Bool_Clip.buf, 369))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 398), 0, ArrayGet(CAD_Bool_Clip.buf, 370))
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 370)
        CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
            CAD_Store.Write(CAD_Bool_Clip.ce, 4, ArrayGet(CAD_Bool_Clip.buf, 398))
            CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 40) ThenBlock: { CAD_Bool_Clip.ce = 0 }
        }
        CAD_Bool_Clip.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Bool_Clip.buf, 371))
        ArraySet(CAD_Bool_Clip.buf, 377, CAD_Bool_Clip.lp)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 371)
        CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
            CAD_Store.Write(CAD_Bool_Clip.ce, 4, ArrayGet(CAD_Bool_Clip.buf, 377))
            CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 40) ThenBlock: { CAD_Bool_Clip.ce = 0 }
        }
        ArraySet(CAD_Bool_Clip.buf, 366, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 366), 2) {
            CAD_Bool_Clip.n = 370
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 366), 1) ThenBlock: { CAD_Bool_Clip.n = 371 }
            ArraySet(CAD_Bool_Clip.buf, 367, CAD_Bool_Clip.n)
            // The coedge after the chord can land on the chord itself.
            // Use a vertex that is inside one island and not the split.
            ArraySet(CAD_Bool_Clip.buf, 362, 0)
            ArraySet(CAD_Bool_Clip.buf, 359, ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.n))
            ArraySet(CAD_Bool_Clip.buf, 363, ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.n))
            ArraySet(CAD_Bool_Clip.buf, 358, 0)
            WhileLoop NotEqual(ArrayGet(CAD_Bool_Clip.buf, 363), 0) {
                CAD_Bool_Clip.v = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 363), 5)
                ArraySet(CAD_Bool_Clip.buf, 373, 1)
                IfCondition EqualTo(CAD_Bool_Clip.v, ArrayGet(CAD_Bool_Clip.buf, 424)) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 373, 0)
                }
                IfCondition EqualTo(CAD_Bool_Clip.v, ArrayGet(CAD_Bool_Clip.buf, 432)) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 373, 0)
                }
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 373), 1) ThenBlock: {
                    CAD_BoolClip.VertUV()
                    ArraySet(CAD_Bool_Clip.buf, 360, CAD_Bool_Clip.u0)
                    ArraySet(CAD_Bool_Clip.buf, 361, CAD_Bool_Clip.v0)
                    ArraySet(CAD_Bool_Clip.buf, 372, 0)
                    CAD_Bool_Clip.oa = 0
                    WhileLoop LessThan(CAD_Bool_Clip.oa, 2) {
                        CAD_Bool_Clip.px = ArrayGet(CAD_Bool_Clip.buf, 360)
                        CAD_Bool_Clip.py = ArrayGet(CAD_Bool_Clip.buf, 361)
                        CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.oa))
                        CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
                        CAD_Bool_Clip.ok = CAD_BoolClip.LoopOdd()
                        IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 372), 0) ThenBlock: {
                                ArraySet(CAD_Bool_Clip.buf, 362, CAD_Bool_Clip.face)
                            }
                            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 372), 1) ThenBlock: {
                                ArraySet(CAD_Bool_Clip.buf, 362, 0)
                            }
                            ArraySet(CAD_Bool_Clip.buf, 372, Add(ArrayGet(CAD_Bool_Clip.buf, 372), 1))
                        }
                        CAD_Bool_Clip.oa = Add(CAD_Bool_Clip.oa, 1)
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 372), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 363, 0)
                    }
                }
                IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 363), 0) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 363, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 363), 2))
                }
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 363), ArrayGet(CAD_Bool_Clip.buf, 359)) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 363, 0)
                }
                ArraySet(CAD_Bool_Clip.buf, 358, Add(ArrayGet(CAD_Bool_Clip.buf, 358), 1))
                IfCondition GreaterThan(ArrayGet(CAD_Bool_Clip.buf, 358), 40) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 363, 0)
                }
            }
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 362), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 362, ArrayGet(CAD_Bool_Clip.buf, 392))
            }
            ArraySet(CAD_Bool_Clip.buf, Add(364, ArrayGet(CAD_Bool_Clip.buf, 366)), ArrayGet(CAD_Bool_Clip.buf, 362))
            ArraySet(CAD_Bool_Clip.buf, 366, Add(ArrayGet(CAD_Bool_Clip.buf, 366), 1))
        }
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 396), 2, ArrayGet(CAD_Bool_Clip.buf, 397))
        CAD_Bool_Clip.ok = CAD_Topo.FaceAppendLoop(ArrayGet(CAD_Bool_Clip.buf, 364), ArrayGet(CAD_Bool_Clip.buf, 398))
        CAD_Bool_Clip.ok = CAD_Topo.FaceAppendLoop(ArrayGet(CAD_Bool_Clip.buf, 365), ArrayGet(CAD_Bool_Clip.buf, 377))
        ReturnValue(1)
    }
}

// Point (.px,.py,.pz) within 0.05 mm of segment .w0→.w1. Parameter in .th.
Function.CAD_BoolClip.NearSeg {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ax = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 0), CAD_Store.Read(CAD_Bool_Clip.w0, 0))
        CAD_Bool_Clip.ay = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 1), CAD_Store.Read(CAD_Bool_Clip.w0, 1))
        CAD_Bool_Clip.bx = Float_Sub(CAD_Store.Read(CAD_Bool_Clip.w1, 2), CAD_Store.Read(CAD_Bool_Clip.w0, 2))
        CAD_Bool_Clip.dot = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.ax, CAD_Bool_Clip.ax), Float_Mul(CAD_Bool_Clip.ay, CAD_Bool_Clip.ay)), Float_Mul(CAD_Bool_Clip.bx, CAD_Bool_Clip.bx))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Clip.dot, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.px, CAD_Store.Read(CAD_Bool_Clip.w0, 0))
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.py, CAD_Store.Read(CAD_Bool_Clip.w0, 1))
        CAD_Bool_Clip.s0 = Float_Sub(CAD_Bool_Clip.pz, CAD_Store.Read(CAD_Bool_Clip.w0, 2))
        CAD_Bool_Clip.th = Float_Div(Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.ax), Float_Mul(CAD_Bool_Clip.dy, CAD_Bool_Clip.ay)), Float_Mul(CAD_Bool_Clip.s0, CAD_Bool_Clip.bx)), CAD_Bool_Clip.dot)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.th, 0xBF947AE147AE147B), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(0x3FF051EB851EB852, CAD_Bool_Clip.th), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.dx = Float_Sub(Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 0), Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.ax)), CAD_Bool_Clip.px)
        CAD_Bool_Clip.dy = Float_Sub(Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 1), Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.ay)), CAD_Bool_Clip.py)
        CAD_Bool_Clip.s0 = Float_Sub(Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 2), Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.bx)), CAD_Bool_Clip.pz)
        CAD_Bool_Clip.dot = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.dx), Float_Mul(CAD_Bool_Clip.dy, CAD_Bool_Clip.dy)), Float_Mul(CAD_Bool_Clip.s0, CAD_Bool_Clip.s0))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, 0x3F647AE147AE147B), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// One coedge, opposite origin. Twin moves onto the new coedge.
Function.CAD_BoolClip.RevCe {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
        CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
        CAD_Bool_Clip.n = 0
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 0), CAD_Bool_Clip.w1) ThenBlock: { CAD_Bool_Clip.n = 1 }
        CAD_Bool_Clip.c2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.ea, CAD_Bool_Clip.w1, CAD_Bool_Clip.n)
        CAD_Bool_Clip.tw = CAD_Store.Read(CAD_Bool_Clip.ce, 1)
        IfCondition NotEqual(CAD_Bool_Clip.tw, 0) ThenBlock: {
            CAD_Topo.LinkTwins(CAD_Bool_Clip.c2, CAD_Bool_Clip.tw)
        }
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 3), CAD_Bool_Clip.ce) ThenBlock: {
            CAD_Store.Write(CAD_Bool_Clip.ea, 3, CAD_Bool_Clip.c2)
        }
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 4), CAD_Bool_Clip.ce) ThenBlock: {
            CAD_Store.Write(CAD_Bool_Clip.ea, 4, CAD_Bool_Clip.c2)
        }
        ReturnValue(CAD_Bool_Clip.c2)
    }
}

// Replace outer coedge buf[435] with the chain buf[438]→buf[439].
Function.CAD_BoolClip.SewChain {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 435)
        CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.ce, 3)
        CAD_Bool_Clip.w1 = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
        CAD_Bool_Clip.sa = ArrayGet(CAD_Bool_Clip.buf, 438)
        CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, 439)
        CAD_Store.Write(CAD_Bool_Clip.w0, 2, CAD_Bool_Clip.sa)
        CAD_Store.Write(CAD_Bool_Clip.sa, 3, CAD_Bool_Clip.w0)
        CAD_Store.Write(CAD_Bool_Clip.sb, 2, CAD_Bool_Clip.w1)
        CAD_Store.Write(CAD_Bool_Clip.w1, 3, CAD_Bool_Clip.sb)
        IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 431), 0), CAD_Bool_Clip.ce) ThenBlock: {
            CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 431), 0, CAD_Bool_Clip.sa)
        }
        CAD_Bool_Clip.ce = CAD_Bool_Clip.sa
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.ce, CAD_Bool_Clip.w1) {
            CAD_Store.Write(CAD_Bool_Clip.ce, 4, ArrayGet(CAD_Bool_Clip.buf, 431))
            CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 40) ThenBlock: { CAD_Bool_Clip.ce = CAD_Bool_Clip.w1 }
        }
        ReturnValue(1)
    }
}

// Hole loop buf[430] touches the outer loop along one edge. Open it into that edge.
Function.CAD_BoolClip.SeamOne {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 433, 0)
        CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 430), 0)
        CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
            ArraySet(CAD_Bool_Clip.buf, 446, CAD_Bool_Clip.ce)
            CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
            CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
            ArraySet(CAD_Bool_Clip.buf, 447, CAD_Bool_Clip.w0)
            ArraySet(CAD_Bool_Clip.buf, 448, CAD_Bool_Clip.w1)
            CAD_Bool_Clip.ea = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 431), 0)
            CAD_Bool_Clip.n = 0
            WhileLoop NotEqual(CAD_Bool_Clip.ea, 0) {
                ArraySet(CAD_Bool_Clip.buf, 449, CAD_Bool_Clip.ea)
                CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 447)
                CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.v, 0)
                CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.v, 1)
                CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.v, 2)
                CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.ea, 5)
                CAD_Bool_Clip.ce = CAD_Bool_Clip.ea
                CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
                CAD_Bool_Clip.ok = CAD_BoolClip.NearSeg()
                ArraySet(CAD_Bool_Clip.buf, 450, CAD_Bool_Clip.th)
                CAD_Bool_Clip.s1 = 0
                IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                    CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 448)
                    CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.v, 0)
                    CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.v, 1)
                    CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.v, 2)
                    CAD_Bool_Clip.w0 = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 449), 5)
                    CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 449)
                    CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
                    CAD_Bool_Clip.s1 = CAD_BoolClip.NearSeg()
                }
                IfCondition EqualTo(CAD_Bool_Clip.s1, 1) ThenBlock: {
                    CAD_Bool_Clip.dot = Float_Sub(CAD_Bool_Clip.th, ArrayGet(CAD_Bool_Clip.buf, 450))
                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.dot), 1) ThenBlock: { CAD_Bool_Clip.dot = Float_Sub(0, CAD_Bool_Clip.dot) }
                    IfCondition EqualTo(CAD_Num.Le(0x3F947AE147AE147B, CAD_Bool_Clip.dot), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 433, Add(ArrayGet(CAD_Bool_Clip.buf, 433), 1))
                        ArraySet(CAD_Bool_Clip.buf, 434, ArrayGet(CAD_Bool_Clip.buf, 446))
                        ArraySet(CAD_Bool_Clip.buf, 435, ArrayGet(CAD_Bool_Clip.buf, 449))
                        ArraySet(CAD_Bool_Clip.buf, 436, ArrayGet(CAD_Bool_Clip.buf, 450))
                        ArraySet(CAD_Bool_Clip.buf, 437, CAD_Bool_Clip.th)
                        ArraySet(CAD_Bool_Clip.buf, 441, ArrayGet(CAD_Bool_Clip.buf, 447))
                        ArraySet(CAD_Bool_Clip.buf, 442, ArrayGet(CAD_Bool_Clip.buf, 448))
                    }
                }
                CAD_Bool_Clip.ea = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 449), 2)
                IfCondition EqualTo(CAD_Bool_Clip.ea, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 431), 0)) ThenBlock: { CAD_Bool_Clip.ea = 0 }
                CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
                IfCondition GreaterThan(CAD_Bool_Clip.n, 40) ThenBlock: { CAD_Bool_Clip.ea = 0 }
            }
            CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 446), 2)
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 40) ThenBlock: { CAD_Bool_Clip.ce = 0 }
        }
        IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 433), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 435)
        CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.ea, 5)
        CAD_Bool_Clip.ce = CAD_Bool_Clip.ea
        CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
        CAD_Bool_Clip.sa = ArrayGet(CAD_Bool_Clip.buf, 441)
        CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, 442)
        CAD_Bool_Clip.n = 0
        IfCondition EqualTo(CAD_Bool_Clip.w0, CAD_Bool_Clip.sa) ThenBlock: {
            IfCondition EqualTo(CAD_Bool_Clip.w1, CAD_Bool_Clip.sb) ThenBlock: { CAD_Bool_Clip.n = 1 }
        }
        IfCondition EqualTo(CAD_Bool_Clip.w0, CAD_Bool_Clip.sb) ThenBlock: {
            IfCondition EqualTo(CAD_Bool_Clip.w1, CAD_Bool_Clip.sa) ThenBlock: { CAD_Bool_Clip.n = 1 }
        }
        IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: {
            CAD_Bool_Clip.nv = CAD_Bool_Clip.sb
            CAD_Bool_Clip.v = CAD_Bool_Clip.sa
            IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 437), ArrayGet(CAD_Bool_Clip.buf, 436)), 1) ThenBlock: {
                CAD_Bool_Clip.nv = CAD_Bool_Clip.sa
                CAD_Bool_Clip.v = CAD_Bool_Clip.sb
            }
            ArraySet(CAD_Bool_Clip.buf, 928, ArrayGet(CAD_Bool_Clip.buf, 435))
            ArraySet(CAD_Bool_Clip.buf, 931, CAD_Bool_Clip.nv)
            CAD_Bool_Clip.ok = CAD_BoolClip.SplitOpen()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
            ArraySet(CAD_Bool_Clip.buf, 928, ArrayGet(CAD_Bool_Clip.buf, 435))
            ArraySet(CAD_Bool_Clip.buf, 931, CAD_Bool_Clip.v)
            CAD_Bool_Clip.ok = CAD_BoolClip.SplitOpen()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
            ArraySet(CAD_Bool_Clip.buf, 435, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 435), 2))
        }
        CAD_Bool_Clip.w0 = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 434), 2)
        IfCondition EqualTo(CAD_Bool_Clip.w0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Clip.w0, ArrayGet(CAD_Bool_Clip.buf, 434)) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.w1 = CAD_Bool_Clip.w0
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Store.Read(CAD_Bool_Clip.w1, 2), ArrayGet(CAD_Bool_Clip.buf, 434)) {
            CAD_Bool_Clip.w1 = CAD_Store.Read(CAD_Bool_Clip.w1, 2)
            IfCondition EqualTo(CAD_Bool_Clip.w1, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Bool_Clip.w1, CAD_Bool_Clip.w0) ThenBlock: { ReturnValue(0) }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 40) ThenBlock: { ReturnValue(0) }
        }
        ArraySet(CAD_Bool_Clip.buf, 438, CAD_Bool_Clip.w0)
        ArraySet(CAD_Bool_Clip.buf, 439, CAD_Bool_Clip.w1)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 435)
        CAD_Bool_Clip.nv = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
        ArraySet(CAD_Bool_Clip.buf, 440, CAD_BoolClip.Dest())
        CAD_Bool_Clip.ce = CAD_Bool_Clip.w1
        CAD_Bool_Clip.s2 = CAD_BoolClip.Dest()
        CAD_Bool_Clip.n = 0
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.w0, 5), CAD_Bool_Clip.nv) ThenBlock: {
            IfCondition EqualTo(CAD_Bool_Clip.s2, ArrayGet(CAD_Bool_Clip.buf, 440)) ThenBlock: { CAD_Bool_Clip.n = 1 }
        }
        IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: {
            CAD_Bool_Clip.ce = CAD_Bool_Clip.w0
            CAD_Bool_Clip.g = 0
            WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
                ArraySet(CAD_Bool_Clip.buf, Add(460, CAD_Bool_Clip.g), CAD_Bool_Clip.ce)
                CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
                IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.w1) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                IfCondition NotEqual(CAD_Bool_Clip.ce, 0) ThenBlock: { CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2) }
                IfCondition GreaterThan(CAD_Bool_Clip.g, 16) ThenBlock: { ReturnValue(0) }
            }
            ArraySet(CAD_Bool_Clip.buf, 459, CAD_Bool_Clip.g)
            CAD_Bool_Clip.n = Subtract(CAD_Bool_Clip.g, 1)
            WhileLoop NotEqual(CAD_Num.Le(CAD_Bool_Clip.n, -1), 1) {
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(460, CAD_Bool_Clip.n))
                CAD_Bool_Clip.ok = CAD_BoolClip.RevCe()
                ArraySet(CAD_Bool_Clip.buf, Add(460, CAD_Bool_Clip.n), CAD_Bool_Clip.ok)
                IfCondition NotEqual(CAD_Bool_Clip.n, Subtract(ArrayGet(CAD_Bool_Clip.buf, 459), 1)) ThenBlock: {
                    CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, Add(460, Add(CAD_Bool_Clip.n, 1))), 2, CAD_Bool_Clip.ok)
                    CAD_Store.Write(CAD_Bool_Clip.ok, 3, ArrayGet(CAD_Bool_Clip.buf, Add(460, Add(CAD_Bool_Clip.n, 1))))
                }
                CAD_Bool_Clip.n = Subtract(CAD_Bool_Clip.n, 1)
            }
            ArraySet(CAD_Bool_Clip.buf, 438, ArrayGet(CAD_Bool_Clip.buf, Add(460, Subtract(ArrayGet(CAD_Bool_Clip.buf, 459), 1))))
            ArraySet(CAD_Bool_Clip.buf, 439, ArrayGet(CAD_Bool_Clip.buf, 460))
        }
        CAD_Bool_Clip.ok = CAD_BoolClip.SewChain()
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 443), 2, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 430), 2))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 430), 1, 0)
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 430), 2, 0)
        ReturnValue(1)
    }
}

// A hole that the slot opened is part of the face boundary, not a second loop on that edge.
Function.CAD_BoolClip.OpenLoops {
    Output: Integer
    Body: {
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.host, 0)
        CAD_Bool_Clip.n = 0
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
            IfCondition LessThan(CAD_Bool_Clip.n, 48) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.n), CAD_Bool_Clip.face)
                CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
            }
            CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.face, 3)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 80) ThenBlock: { CAD_Bool_Clip.face = 0 }
        }
        ArraySet(CAD_Bool_Clip.buf, 399, CAD_Bool_Clip.n)
        ArraySet(CAD_Bool_Clip.buf, 398, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 398), ArrayGet(CAD_Bool_Clip.buf, 399)) {
            ArraySet(CAD_Bool_Clip.buf, 432, ArrayGet(CAD_Bool_Clip.buf, Add(400, ArrayGet(CAD_Bool_Clip.buf, 398))))
            CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 1)
            ArraySet(CAD_Bool_Clip.buf, 431, CAD_Bool_Clip.lp)
            IfCondition NotEqual(CAD_Bool_Clip.lp, 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 443, CAD_Bool_Clip.lp)
                ArraySet(CAD_Bool_Clip.buf, 430, CAD_Store.Read(CAD_Bool_Clip.lp, 2))
                ArraySet(CAD_Bool_Clip.buf, 445, 0)
                WhileLoop NotEqual(ArrayGet(CAD_Bool_Clip.buf, 430), 0) {
                    IfCondition GreaterThan(ArrayGet(CAD_Bool_Clip.buf, 445), 8) ThenBlock: { ArraySet(CAD_Bool_Clip.buf, 430, 0) }
                    IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 430), 0) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 444, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 430), 2))
                        CAD_Bool_Clip.ok = CAD_BoolClip.SeamOne()
                        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, 443, ArrayGet(CAD_Bool_Clip.buf, 430))
                        }
                        ArraySet(CAD_Bool_Clip.buf, 430, ArrayGet(CAD_Bool_Clip.buf, 444))
                    }
                    ArraySet(CAD_Bool_Clip.buf, 445, Add(ArrayGet(CAD_Bool_Clip.buf, 445), 1))
                }
            }
            ArraySet(CAD_Bool_Clip.buf, 398, Add(ArrayGet(CAD_Bool_Clip.buf, 398), 1))
        }
        ReturnValue(1)
    }
}

// Tool cylinder into buf[700..712]. 1 when a cylinder side exists.
Function.CAD_BoolClip.LoadCyl {
    Output: Integer
    Body: {
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.tool, 0)
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
            CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.face, 0)
            IfCondition NotEqual(CAD_Bool_Clip.eb, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.eb, 0), 2) ThenBlock: {
                    CAD_Bool_Clip.n = 0
                    WhileLoop LessThan(CAD_Bool_Clip.n, 13) {
                        ArraySet(CAD_Bool_Clip.buf, Add(700, CAD_Bool_Clip.n), CAD_Store.Read(CAD_Bool_Clip.eb, Add(CAD_Bool_Clip.n, 1)))
                        CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
                    }
                    ReturnValue(1)
                }
            }
            CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.face, 3)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 40) ThenBlock: { CAD_Bool_Clip.face = 0 }
        }
        ReturnValue(0)
    }
}

// 1 when (.px,.py,.pz) is strictly inside the cylinder in buf[700..712].
Function.CAD_BoolClip.InCyl {
    Output: Integer
    Body: {
        CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.px, ArrayGet(CAD_Bool_Clip.buf, 700))
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.py, ArrayGet(CAD_Bool_Clip.buf, 701))
        CAD_Bool_Clip.s0 = Float_Sub(CAD_Bool_Clip.pz, ArrayGet(CAD_Bool_Clip.buf, 702))
        CAD_Bool_Clip.ax = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 703)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 704))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 705)))
        CAD_Bool_Clip.ay = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 706)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 707))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 708)))
        CAD_Bool_Clip.s1 = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 712), 0x3FA999999999999A)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.s1), 1) ThenBlock: { CAD_Bool_Clip.s1 = 0 }
        CAD_Bool_Clip.dot = Float_Add(Float_Mul(CAD_Bool_Clip.ax, CAD_Bool_Clip.ax), Float_Mul(CAD_Bool_Clip.ay, CAD_Bool_Clip.ay))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, Float_Mul(CAD_Bool_Clip.s1, CAD_Bool_Clip.s1)), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when (.px,.py,.pz) is strictly outside the cylinder. On the surface is 0.
Function.CAD_BoolClip.EndOut {
    Output: Integer
    Body: {
        CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.px, ArrayGet(CAD_Bool_Clip.buf, 700))
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.py, ArrayGet(CAD_Bool_Clip.buf, 701))
        CAD_Bool_Clip.s0 = Float_Sub(CAD_Bool_Clip.pz, ArrayGet(CAD_Bool_Clip.buf, 702))
        CAD_Bool_Clip.ax = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 703)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 704))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 705)))
        CAD_Bool_Clip.ay = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 706)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 707))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 708)))
        CAD_Bool_Clip.s1 = Float_Add(ArrayGet(CAD_Bool_Clip.buf, 712), 0x3FA999999999999A)
        CAD_Bool_Clip.dot = Float_Add(Float_Mul(CAD_Bool_Clip.ax, CAD_Bool_Clip.ax), Float_Mul(CAD_Bool_Clip.ay, CAD_Bool_Clip.ay))
        CAD_Bool_Clip.fg = 0
        IfCondition EqualTo(CAD_Num.Le(Float_Mul(CAD_Bool_Clip.s1, CAD_Bool_Clip.s1), CAD_Bool_Clip.dot), 1) ThenBlock: { CAD_Bool_Clip.fg = 1 }
        ReturnValue(CAD_Bool_Clip.fg)
    }
}

// Split coedge buf[580] at the cylinder. 1 when the edge was split.
Function.CAD_BoolClip.SplitAt {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 580)
        IfCondition EqualTo(CAD_Bool_Clip.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
        ArraySet(CAD_Bool_Clip.buf, 581, CAD_Store.Read(CAD_Bool_Clip.v, 0))
        ArraySet(CAD_Bool_Clip.buf, 582, CAD_Store.Read(CAD_Bool_Clip.v, 1))
        ArraySet(CAD_Bool_Clip.buf, 583, CAD_Store.Read(CAD_Bool_Clip.v, 2))
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 580)
        CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
        ArraySet(CAD_Bool_Clip.buf, 584, CAD_Bool_Clip.w1)
        ArraySet(CAD_Bool_Clip.buf, 585, CAD_Store.Read(CAD_Bool_Clip.w1, 0))
        ArraySet(CAD_Bool_Clip.buf, 586, CAD_Store.Read(CAD_Bool_Clip.w1, 1))
        ArraySet(CAD_Bool_Clip.buf, 587, CAD_Store.Read(CAD_Bool_Clip.w1, 2))
        CAD_Bool_Clip.dx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 581), ArrayGet(CAD_Bool_Clip.buf, 700))
        CAD_Bool_Clip.dy = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 582), ArrayGet(CAD_Bool_Clip.buf, 701))
        CAD_Bool_Clip.s0 = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 583), ArrayGet(CAD_Bool_Clip.buf, 702))
        CAD_Bool_Clip.ax = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 703)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 704))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 705)))
        CAD_Bool_Clip.ay = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 706)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 707))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 708)))
        ArraySet(CAD_Bool_Clip.buf, 588, CAD_Bool_Clip.ax)
        ArraySet(CAD_Bool_Clip.buf, 589, CAD_Bool_Clip.ay)
        CAD_Bool_Clip.dx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 585), ArrayGet(CAD_Bool_Clip.buf, 700))
        CAD_Bool_Clip.dy = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 586), ArrayGet(CAD_Bool_Clip.buf, 701))
        CAD_Bool_Clip.s0 = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 587), ArrayGet(CAD_Bool_Clip.buf, 702))
        CAD_Bool_Clip.ax = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 703)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 704))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 705)))
        CAD_Bool_Clip.ay = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 706)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 707))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 708)))
        ArraySet(CAD_Bool_Clip.buf, 590, CAD_Bool_Clip.ax)
        ArraySet(CAD_Bool_Clip.buf, 591, CAD_Bool_Clip.ay)
        CAD_Bool_Clip.dx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 590), ArrayGet(CAD_Bool_Clip.buf, 588))
        CAD_Bool_Clip.dy = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 591), ArrayGet(CAD_Bool_Clip.buf, 589))
        CAD_Bool_Clip.s0 = Float_Add(Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.dx), Float_Mul(CAD_Bool_Clip.dy, CAD_Bool_Clip.dy))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Clip.s0, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 592, CAD_Bool_Clip.s0)
        CAD_Bool_Clip.s1 = Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 588), CAD_Bool_Clip.dx), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 589), CAD_Bool_Clip.dy))
        ArraySet(CAD_Bool_Clip.buf, 593, Float_Mul(CAD_Bool_Clip.s1, 0x4000000000000000))
        CAD_Bool_Clip.s1 = Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 588), ArrayGet(CAD_Bool_Clip.buf, 588)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 589), ArrayGet(CAD_Bool_Clip.buf, 589)))
        CAD_Bool_Clip.s2 = Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 712), ArrayGet(CAD_Bool_Clip.buf, 712))
        ArraySet(CAD_Bool_Clip.buf, 594, Float_Sub(CAD_Bool_Clip.s1, CAD_Bool_Clip.s2))
        CAD_Bool_Clip.dot = Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 593), ArrayGet(CAD_Bool_Clip.buf, 593))
        CAD_Bool_Clip.s0 = Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 592), 0x4010000000000000)
        CAD_Bool_Clip.dot = Float_Sub(CAD_Bool_Clip.dot, Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 594)))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.dot), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.s1 = CAD_Num.Sqrt(CAD_Bool_Clip.dot)
        ArraySet(CAD_Bool_Clip.buf, 595, CAD_Bool_Clip.s1)
        CAD_Bool_Clip.s0 = Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 592), 0x4000000000000000)
        CAD_Bool_Clip.th = Float_Div(Float_Add(Float_Sub(0, ArrayGet(CAD_Bool_Clip.buf, 593)), ArrayGet(CAD_Bool_Clip.buf, 595)), CAD_Bool_Clip.s0)
        ArraySet(CAD_Bool_Clip.buf, 596, CAD_Bool_Clip.th)
        CAD_Bool_Clip.s0 = Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 592), 0x4000000000000000)
        CAD_Bool_Clip.tt = Float_Div(Float_Sub(Float_Sub(0, ArrayGet(CAD_Bool_Clip.buf, 593)), ArrayGet(CAD_Bool_Clip.buf, 595)), CAD_Bool_Clip.s0)
        ArraySet(CAD_Bool_Clip.buf, 597, CAD_Bool_Clip.tt)
        ArraySet(CAD_Bool_Clip.buf, 602, 0)
        CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 596)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.th, 0x3F947AE147AE147B), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.Le(0x3FEF5C28F5C28F5C, CAD_Bool_Clip.th), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 602, 1)
            }
        }
        CAD_Bool_Clip.tt = ArrayGet(CAD_Bool_Clip.buf, 597)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.tt, 0x3F947AE147AE147B), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.Le(0x3FEF5C28F5C28F5C, CAD_Bool_Clip.tt), 0) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 602), 0) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 596, CAD_Bool_Clip.tt)
                    ArraySet(CAD_Bool_Clip.buf, 602, 1)
                }
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 602), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Bool_Clip.tt, ArrayGet(CAD_Bool_Clip.buf, 596))), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 596, CAD_Bool_Clip.tt)
                    }
                }
            }
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 602), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.th = ArrayGet(CAD_Bool_Clip.buf, 596)
        CAD_Bool_Clip.px = Float_Add(ArrayGet(CAD_Bool_Clip.buf, 581), Float_Mul(CAD_Bool_Clip.th, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 585), ArrayGet(CAD_Bool_Clip.buf, 581))))
        CAD_Bool_Clip.py = Float_Add(ArrayGet(CAD_Bool_Clip.buf, 582), Float_Mul(CAD_Bool_Clip.th, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 586), ArrayGet(CAD_Bool_Clip.buf, 582))))
        CAD_Bool_Clip.pz = Float_Add(ArrayGet(CAD_Bool_Clip.buf, 583), Float_Mul(CAD_Bool_Clip.th, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 587), ArrayGet(CAD_Bool_Clip.buf, 583))))
        ArraySet(CAD_Bool_Clip.pt, 0, CAD_Bool_Clip.px)
        ArraySet(CAD_Bool_Clip.pt, 1, CAD_Bool_Clip.py)
        ArraySet(CAD_Bool_Clip.pt, 2, CAD_Bool_Clip.pz)
        CAD_Bool_Clip.nv = CAD_Topo.MakeVertex(CAD_Bool_Clip.pt)
        ArraySet(CAD_Bool_Clip.buf, 931, CAD_Bool_Clip.nv)
        ArraySet(CAD_Bool_Clip.buf, 928, ArrayGet(CAD_Bool_Clip.buf, 580))
        CAD_Bool_Clip.ok = CAD_BoolClip.SplitOpen()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Split edges that leave the cylinder so an outside vertex is its own coedge.
// 0 when this face meets the cut caps and must be left alone.
Function.CAD_BoolClip.ClipSplit {
    Output: Integer
    Body: {
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 1)
        CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
        CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
            CAD_Bool_Clip.tw = CAD_Store.Read(CAD_Bool_Clip.ce, 1)
            IfCondition NotEqual(CAD_Bool_Clip.tw, 0) ThenBlock: {
                CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.tw, 4)
                CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ea, 1)
                IfCondition EqualTo(CAD_Bool_Clip.ea, ArrayGet(CAD_Bool_Clip.buf, 536)) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(CAD_Bool_Clip.ea, ArrayGet(CAD_Bool_Clip.buf, 537)) ThenBlock: { ReturnValue(0) }
            }
            CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 24) ThenBlock: { ReturnValue(0) }
        }
        ArraySet(CAD_Bool_Clip.buf, 579, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 579), 8) {
            ArraySet(CAD_Bool_Clip.buf, 604, 0)
            CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 1)
            ArraySet(CAD_Bool_Clip.buf, 578, CAD_Store.Read(CAD_Bool_Clip.lp, 0))
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 578)
            CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
            CAD_Bool_Clip.fg = 0
            CAD_Bool_Clip.ob = 0
            WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
                ArraySet(CAD_Bool_Clip.buf, 580, CAD_Bool_Clip.ce)
                CAD_Bool_Clip.v = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 580), 5)
                CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.v, 0)
                CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.v, 1)
                CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.v, 2)
                ArraySet(CAD_Bool_Clip.buf, 598, CAD_BoolClip.InCyl())
                CAD_Bool_Clip.v = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 580), 5)
                CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.v, 0)
                CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.v, 1)
                CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.v, 2)
                ArraySet(CAD_Bool_Clip.buf, 599, CAD_BoolClip.EndOut())
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 580)
                CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
                ArraySet(CAD_Bool_Clip.buf, 584, CAD_Bool_Clip.w1)
                CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.w1, 0)
                CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.w1, 1)
                CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.w1, 2)
                ArraySet(CAD_Bool_Clip.buf, 600, CAD_BoolClip.InCyl())
                CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 584)
                CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.w1, 0)
                CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.w1, 1)
                CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.w1, 2)
                ArraySet(CAD_Bool_Clip.buf, 601, CAD_BoolClip.EndOut())
                ArraySet(CAD_Bool_Clip.buf, 603, 0)
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 598), 1) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 601), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 603, 1)
                    }
                }
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 599), 1) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 600), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 603, 1)
                    }
                }
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 603), 0) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 605, 0)
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 599), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 605, 1)
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 601), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 605, 1)
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 605), 1) ThenBlock: {
                        CAD_Bool_Clip.v = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 580), 5)
                        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 584)
                        CAD_Bool_Clip.px = Float_Mul(Float_Add(CAD_Store.Read(CAD_Bool_Clip.v, 0), CAD_Store.Read(CAD_Bool_Clip.w1, 0)), 0x3FE0000000000000)
                        CAD_Bool_Clip.py = Float_Mul(Float_Add(CAD_Store.Read(CAD_Bool_Clip.v, 1), CAD_Store.Read(CAD_Bool_Clip.w1, 1)), 0x3FE0000000000000)
                        CAD_Bool_Clip.pz = Float_Mul(Float_Add(CAD_Store.Read(CAD_Bool_Clip.v, 2), CAD_Store.Read(CAD_Bool_Clip.w1, 2)), 0x3FE0000000000000)
                        IfCondition EqualTo(CAD_BoolClip.InCyl(), 1) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, 603, 1)
                        }
                    }
                }
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 603), 1) ThenBlock: {
                    CAD_Bool_Clip.ok = CAD_BoolClip.SplitAt()
                    IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 604, 1)
                    }
                }
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 604), 1) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 604), 0) ThenBlock: {
                    CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 580), 2)
                    IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                    CAD_Bool_Clip.ob = Add(CAD_Bool_Clip.ob, 1)
                    IfCondition GreaterThan(CAD_Bool_Clip.ob, 24) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                }
            }
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 604), 0) ThenBlock: { ArraySet(CAD_Bool_Clip.buf, 579, 8) }
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 604), 1) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 579, Add(ArrayGet(CAD_Bool_Clip.buf, 579), 1))
            }
        }
        ReturnValue(1)
    }
}

// Cylinder point at angle .th, on plane .pl, into .pt. Axial in .s0.
Function.CAD_BoolClip.CylAt {
    Output: Integer
    Body: {
        CAD_Bool_Clip.s2 = CAD_Geom.Cos(CAD_Bool_Clip.th)
        CAD_Bool_Clip.s3 = CAD_Geom.Sin(CAD_Bool_Clip.th)
        CAD_Bool_Clip.nx = ArrayGet(CAD_Bool_Clip.pl, 10)
        CAD_Bool_Clip.ny = ArrayGet(CAD_Bool_Clip.pl, 11)
        CAD_Bool_Clip.nz = ArrayGet(CAD_Bool_Clip.pl, 12)
        CAD_Bool_Clip.dot = Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 709), CAD_Bool_Clip.nx), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 710), CAD_Bool_Clip.ny)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 711), CAD_Bool_Clip.nz))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Clip.dot, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.dx = Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 703), CAD_Bool_Clip.nx), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 704), CAD_Bool_Clip.ny)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 705), CAD_Bool_Clip.nz))
        CAD_Bool_Clip.dy = Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 706), CAD_Bool_Clip.nx), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 707), CAD_Bool_Clip.ny)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 708), CAD_Bool_Clip.nz))
        CAD_Bool_Clip.s0 = Float_Add(Float_Add(Float_Mul(Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 700), ArrayGet(CAD_Bool_Clip.pl, 1)), CAD_Bool_Clip.nx), Float_Mul(Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 701), ArrayGet(CAD_Bool_Clip.pl, 2)), CAD_Bool_Clip.ny)), Float_Mul(Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 702), ArrayGet(CAD_Bool_Clip.pl, 3)), CAD_Bool_Clip.nz))
        CAD_Bool_Clip.s0 = Float_Sub(0, CAD_Bool_Clip.s0)
        CAD_Bool_Clip.s0 = Float_Sub(CAD_Bool_Clip.s0, Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 712), Float_Mul(CAD_Bool_Clip.s2, CAD_Bool_Clip.dx)))
        CAD_Bool_Clip.s0 = Float_Sub(CAD_Bool_Clip.s0, Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 712), Float_Mul(CAD_Bool_Clip.s3, CAD_Bool_Clip.dy)))
        CAD_Bool_Clip.s0 = Float_Div(CAD_Bool_Clip.s0, CAD_Bool_Clip.dot)
        ArraySet(CAD_Bool_Clip.pt, 0, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 700), Float_Add(Float_Mul(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 712), CAD_Bool_Clip.s2), ArrayGet(CAD_Bool_Clip.buf, 703)), Float_Add(Float_Mul(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 712), CAD_Bool_Clip.s3), ArrayGet(CAD_Bool_Clip.buf, 706)), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 709))))))
        ArraySet(CAD_Bool_Clip.pt, 1, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 701), Float_Add(Float_Mul(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 712), CAD_Bool_Clip.s2), ArrayGet(CAD_Bool_Clip.buf, 704)), Float_Add(Float_Mul(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 712), CAD_Bool_Clip.s3), ArrayGet(CAD_Bool_Clip.buf, 707)), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 710))))))
        ArraySet(CAD_Bool_Clip.pt, 2, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 702), Float_Add(Float_Mul(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 712), CAD_Bool_Clip.s2), ArrayGet(CAD_Bool_Clip.buf, 705)), Float_Add(Float_Mul(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 712), CAD_Bool_Clip.s3), ArrayGet(CAD_Bool_Clip.buf, 708)), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 711))))))
        ReturnValue(1)
    }
}

// Inside run buf[560+6*k] on face buf[432]. Close it on the cylinder.
Function.CAD_BoolClip.ArcRun {
    Output: Integer
    Body: {
        CAD_Bool_Clip.idx = Multiply(ArrayGet(CAD_Bool_Clip.buf, 559), 6)
        CAD_Bool_Clip.sa = ArrayGet(CAD_Bool_Clip.buf, Add(560, CAD_Bool_Clip.idx))
        CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, Add(561, CAD_Bool_Clip.idx))
        CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, Add(562, CAD_Bool_Clip.idx))
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, Add(563, CAD_Bool_Clip.idx))
        CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, Add(564, CAD_Bool_Clip.idx))
        CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.v, 0)
        CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.v, 1)
        CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.v, 2)
        IfCondition EqualTo(CAD_BoolClip.EndOut(), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.px, ArrayGet(CAD_Bool_Clip.buf, 700))
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.py, ArrayGet(CAD_Bool_Clip.buf, 701))
        CAD_Bool_Clip.s0 = Float_Sub(CAD_Bool_Clip.pz, ArrayGet(CAD_Bool_Clip.buf, 702))
        CAD_Bool_Clip.ax = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 703)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 704))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 705)))
        CAD_Bool_Clip.ay = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 706)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 707))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 708)))
        CAD_Bool_Clip.a0 = CAD_Geom.Atan2(CAD_Bool_Clip.ay, CAD_Bool_Clip.ax)
        CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, Add(565, CAD_Bool_Clip.idx))
        CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.v, 0)
        CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.v, 1)
        CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.v, 2)
        IfCondition EqualTo(CAD_BoolClip.EndOut(), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.px, ArrayGet(CAD_Bool_Clip.buf, 700))
        CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.py, ArrayGet(CAD_Bool_Clip.buf, 701))
        CAD_Bool_Clip.s0 = Float_Sub(CAD_Bool_Clip.pz, ArrayGet(CAD_Bool_Clip.buf, 702))
        CAD_Bool_Clip.ax = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 703)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 704))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 705)))
        CAD_Bool_Clip.ay = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, ArrayGet(CAD_Bool_Clip.buf, 706)), Float_Mul(CAD_Bool_Clip.dy, ArrayGet(CAD_Bool_Clip.buf, 707))), Float_Mul(CAD_Bool_Clip.s0, ArrayGet(CAD_Bool_Clip.buf, 708)))
        CAD_Bool_Clip.span = Float_Sub(CAD_Geom.Atan2(CAD_Bool_Clip.ay, CAD_Bool_Clip.ax), CAD_Bool_Clip.a0)
        IfCondition EqualTo(CAD_Num.Le(0x400921FB54442D18, CAD_Bool_Clip.span), 1) ThenBlock: {
            CAD_Bool_Clip.span = Float_Sub(CAD_Bool_Clip.span, 0x401921FB54442D18)
        }
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.span, 0xC00921FB54442D18), 1) ThenBlock: {
            CAD_Bool_Clip.span = Float_Add(CAD_Bool_Clip.span, 0x401921FB54442D18)
        }
        ArraySet(CAD_Bool_Clip.buf, 556, CAD_Bool_Clip.a0)
        ArraySet(CAD_Bool_Clip.buf, 557, CAD_Bool_Clip.span)
        CAD_Bool_Clip.th = Float_Add(CAD_Bool_Clip.a0, Float_Mul(CAD_Bool_Clip.span, 0x3FE0000000000000))
        CAD_Bool_Clip.ok = CAD_BoolClip.CylAt()
        CAD_Bool_Clip.nv = CAD_Topo.MakeVertex(CAD_Bool_Clip.pt)
        CAD_Bool_Clip.v = CAD_Bool_Clip.nv
        CAD_BoolClip.VertUV()
        CAD_Bool_Clip.px = CAD_Bool_Clip.u0
        CAD_Bool_Clip.py = CAD_Bool_Clip.v0
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 1)
        CAD_Bool_Clip.fg = CAD_BoolClip.LoopOdd()
        CAD_Bool_Clip.span = ArrayGet(CAD_Bool_Clip.buf, 557)
        CAD_Bool_Clip.s0 = CAD_Bool_Clip.span
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.s0), 1) ThenBlock: {
            CAD_Bool_Clip.span = Float_Add(CAD_Bool_Clip.s0, 0x401921FB54442D18)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.s0), 0) ThenBlock: {
            CAD_Bool_Clip.span = Float_Sub(CAD_Bool_Clip.s0, 0x401921FB54442D18)
        }
        ArraySet(CAD_Bool_Clip.buf, 558, CAD_Bool_Clip.span)
        CAD_Bool_Clip.th = Float_Add(ArrayGet(CAD_Bool_Clip.buf, 556), Float_Mul(CAD_Bool_Clip.span, 0x3FE0000000000000))
        CAD_Bool_Clip.ok = CAD_BoolClip.CylAt()
        CAD_Bool_Clip.nv = CAD_Topo.MakeVertex(CAD_Bool_Clip.pt)
        CAD_Bool_Clip.v = CAD_Bool_Clip.nv
        CAD_BoolClip.VertUV()
        CAD_Bool_Clip.px = CAD_Bool_Clip.u0
        CAD_Bool_Clip.py = CAD_Bool_Clip.v0
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 1)
        CAD_Bool_Clip.n = CAD_BoolClip.LoopOdd()
        IfCondition EqualTo(CAD_Bool_Clip.n, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Bool_Clip.fg, 0) ThenBlock: { ArraySet(CAD_Bool_Clip.buf, 557, ArrayGet(CAD_Bool_Clip.buf, 558)) }
        }
        CAD_Bool_Clip.span = ArrayGet(CAD_Bool_Clip.buf, 557)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Clip.span), 1) ThenBlock: { CAD_Bool_Clip.span = Float_Sub(0, CAD_Bool_Clip.span) }
        CAD_Bool_Clip.nh = Float_ToInt(Float_Div(CAD_Bool_Clip.span, 0x3FA999999999999A))
        IfCondition LessThan(CAD_Bool_Clip.nh, 2) ThenBlock: { CAD_Bool_Clip.nh = 2 }
        IfCondition GreaterThan(CAD_Bool_Clip.nh, 12) ThenBlock: { CAD_Bool_Clip.nh = 12 }
        ArraySet(CAD_Bool_Clip.buf, 553, CAD_Bool_Clip.nh)
        CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, Add(564, CAD_Bool_Clip.idx))
        ArraySet(CAD_Bool_Clip.buf, 540, CAD_Bool_Clip.v)
        CAD_Bool_Clip.g = 1
        WhileLoop LessThan(CAD_Bool_Clip.g, CAD_Bool_Clip.nh) {
            CAD_Bool_Clip.th = Float_Add(ArrayGet(CAD_Bool_Clip.buf, 556), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 557), Float_Div(Float_FromInt(CAD_Bool_Clip.g), Float_FromInt(CAD_Bool_Clip.nh))))
            CAD_Bool_Clip.ok = CAD_BoolClip.CylAt()
            CAD_Bool_Clip.nv = CAD_Topo.MakeVertex(CAD_Bool_Clip.pt)
            ArraySet(CAD_Bool_Clip.buf, Add(540, CAD_Bool_Clip.g), CAD_Bool_Clip.nv)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        ArraySet(CAD_Bool_Clip.buf, Add(540, CAD_Bool_Clip.nh), ArrayGet(CAD_Bool_Clip.buf, Add(565, CAD_Bool_Clip.idx)))
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, CAD_Bool_Clip.nh) {
            ArraySet(CAD_Bool_Clip.pt, 0, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, Add(540, CAD_Bool_Clip.g)), 0))
            ArraySet(CAD_Bool_Clip.pt, 1, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, Add(540, CAD_Bool_Clip.g)), 1))
            ArraySet(CAD_Bool_Clip.pt, 2, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, Add(540, CAD_Bool_Clip.g)), 2))
            ArraySet(CAD_Bool_Clip.p1, 0, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, Add(541, CAD_Bool_Clip.g)), 0))
            ArraySet(CAD_Bool_Clip.p1, 1, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, Add(541, CAD_Bool_Clip.g)), 1))
            ArraySet(CAD_Bool_Clip.p1, 2, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, Add(541, CAD_Bool_Clip.g)), 2))
            CAD_Bool_Clip.ok = CAD_Geom.MakeLine(CAD_Bool_Clip.pt, CAD_Bool_Clip.p1)
            CAD_Bool_Clip.e2 = CAD_Topo.MakeEdge(ArrayGet(CAD_Bool_Clip.buf, Add(540, CAD_Bool_Clip.g)), ArrayGet(CAD_Bool_Clip.buf, Add(541, CAD_Bool_Clip.g)), CAD_Bool_Clip.ok)
            CAD_Bool_Clip.c2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.e2, ArrayGet(CAD_Bool_Clip.buf, Add(540, CAD_Bool_Clip.g)), 1)
            CAD_Bool_Clip.tw2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.e2, ArrayGet(CAD_Bool_Clip.buf, Add(541, CAD_Bool_Clip.g)), 0)
            CAD_Topo.LinkTwins(CAD_Bool_Clip.c2, CAD_Bool_Clip.tw2)
            CAD_Store.Write(CAD_Bool_Clip.e2, 3, CAD_Bool_Clip.c2)
            CAD_Store.Write(CAD_Bool_Clip.e2, 4, CAD_Bool_Clip.tw2)
            ArraySet(CAD_Bool_Clip.buf, Add(520, CAD_Bool_Clip.g), CAD_Bool_Clip.c2)
            ArraySet(CAD_Bool_Clip.buf, Add(660, CAD_Bool_Clip.g), CAD_Bool_Clip.tw2)
            CAD_Store.Write(CAD_Bool_Clip.tw2, 4, 0)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, Subtract(CAD_Bool_Clip.nh, 1)) {
            CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, Add(520, CAD_Bool_Clip.g)), 2, ArrayGet(CAD_Bool_Clip.buf, Add(521, CAD_Bool_Clip.g)))
            CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, Add(521, CAD_Bool_Clip.g)), 3, ArrayGet(CAD_Bool_Clip.buf, Add(520, CAD_Bool_Clip.g)))
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        // Free side of the seam runs back along the cylinder, so the cut
        // end can share these edges instead of a chord across the opening.
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, Subtract(ArrayGet(CAD_Bool_Clip.buf, 553), 1)) {
            CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, Add(661, CAD_Bool_Clip.g)), 2, ArrayGet(CAD_Bool_Clip.buf, Add(660, CAD_Bool_Clip.g)))
            CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, Add(660, CAD_Bool_Clip.g)), 3, ArrayGet(CAD_Bool_Clip.buf, Add(661, CAD_Bool_Clip.g)))
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        CAD_Bool_Clip.idx = Multiply(ArrayGet(CAD_Bool_Clip.buf, 559), 6)
        CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, Add(562, CAD_Bool_Clip.idx))
        CAD_Store.Write(CAD_Bool_Clip.w0, 2, ArrayGet(CAD_Bool_Clip.buf, 520))
        CAD_Bool_Clip.idx = Multiply(ArrayGet(CAD_Bool_Clip.buf, 559), 6)
        CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, Add(562, CAD_Bool_Clip.idx))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 520), 3, CAD_Bool_Clip.w0)
        CAD_Bool_Clip.idx = Multiply(ArrayGet(CAD_Bool_Clip.buf, 559), 6)
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, Add(563, CAD_Bool_Clip.idx))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, Add(519, ArrayGet(CAD_Bool_Clip.buf, 553))), 2, CAD_Bool_Clip.w1)
        CAD_Bool_Clip.idx = Multiply(ArrayGet(CAD_Bool_Clip.buf, 559), 6)
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, Add(563, CAD_Bool_Clip.idx))
        CAD_Store.Write(CAD_Bool_Clip.w1, 3, ArrayGet(CAD_Bool_Clip.buf, Add(519, ArrayGet(CAD_Bool_Clip.buf, 553))))
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 1)
        CAD_Bool_Clip.idx = Multiply(ArrayGet(CAD_Bool_Clip.buf, 559), 6)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(560, CAD_Bool_Clip.idx))
        CAD_Bool_Clip.sb = ArrayGet(CAD_Bool_Clip.buf, Add(561, CAD_Bool_Clip.idx))
        CAD_Bool_Clip.fg = 0
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, 24) {
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Store.Read(CAD_Bool_Clip.lp, 0)) ThenBlock: { CAD_Bool_Clip.fg = 1 }
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.sb) ThenBlock: { CAD_Bool_Clip.g = 24 }
            IfCondition LessThan(CAD_Bool_Clip.g, 24) ThenBlock: {
                CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
                CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            }
        }
        IfCondition EqualTo(CAD_Bool_Clip.fg, 1) ThenBlock: {
            CAD_Store.Write(CAD_Bool_Clip.lp, 0, ArrayGet(CAD_Bool_Clip.buf, 520))
        }
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, CAD_Bool_Clip.nh) {
            CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, Add(520, CAD_Bool_Clip.g)), 4, CAD_Bool_Clip.lp)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        ReturnValue(1)
    }
}

// 1 when the outside ear's centroid is already inside the tool.
// buf[606] count, buf[607..609] coordinate sums, buf[610] has an outside vertex.
Function.CAD_BoolClip.EarIn {
    Output: Integer
    Body: {
        IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 606), 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 610), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.px = Float_Div(ArrayGet(CAD_Bool_Clip.buf, 607), Float_FromInt(ArrayGet(CAD_Bool_Clip.buf, 606)))
        CAD_Bool_Clip.py = Float_Div(ArrayGet(CAD_Bool_Clip.buf, 608), Float_FromInt(ArrayGet(CAD_Bool_Clip.buf, 606)))
        CAD_Bool_Clip.pz = Float_Div(ArrayGet(CAD_Bool_Clip.buf, 609), Float_FromInt(ArrayGet(CAD_Bool_Clip.buf, 606)))
        ReturnValue(CAD_BoolClip.InCyl())
    }
}

// A hole wall that crosses the tool cylinder keeps only the part outside it.
Function.CAD_BoolClip.ClipOne {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(ArrayGet(CAD_Bool_Clip.buf, 432), CAD_Bool_Clip.pl), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 1)
        IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Bool_Clip.lp, 2), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 432), ArrayGet(CAD_Bool_Clip.buf, 536)) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 432), ArrayGet(CAD_Bool_Clip.buf, 537)) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ok = CAD_BoolClip.ClipSplit()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 1)
        IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
        CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
        CAD_Bool_Clip.n = 0
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
            CAD_Bool_Clip.tw = CAD_Store.Read(CAD_Bool_Clip.ce, 1)
            IfCondition NotEqual(CAD_Bool_Clip.tw, 0) ThenBlock: {
                CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.tw, 4)
                CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ea, 1)
                IfCondition EqualTo(CAD_Bool_Clip.ea, ArrayGet(CAD_Bool_Clip.buf, 536)) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(CAD_Bool_Clip.ea, ArrayGet(CAD_Bool_Clip.buf, 537)) ThenBlock: { ReturnValue(0) }
            }
            CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
            ArraySet(CAD_Bool_Clip.buf, Add(480, CAD_Bool_Clip.n), CAD_Bool_Clip.ce)
            CAD_Bool_Clip.w0 = CAD_Bool_Clip.v
            CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
            CAD_Bool_Clip.px = Float_Mul(Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 0), CAD_Store.Read(CAD_Bool_Clip.w1, 0)), 0x3FE0000000000000)
            CAD_Bool_Clip.py = Float_Mul(Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 1), CAD_Store.Read(CAD_Bool_Clip.w1, 1)), 0x3FE0000000000000)
            CAD_Bool_Clip.pz = Float_Mul(Float_Add(CAD_Store.Read(CAD_Bool_Clip.w0, 2), CAD_Store.Read(CAD_Bool_Clip.w1, 2)), 0x3FE0000000000000)
            ArraySet(CAD_Bool_Clip.buf, Add(510, CAD_Bool_Clip.n), 0)
            IfCondition EqualTo(CAD_BoolClip.InCyl(), 1) ThenBlock: {
                CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.w0, 0)
                CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.w0, 1)
                CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.w0, 2)
                IfCondition EqualTo(CAD_BoolClip.EndOut(), 0) ThenBlock: {
                    CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.w1, 0)
                    CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.w1, 1)
                    CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.w1, 2)
                    IfCondition EqualTo(CAD_BoolClip.EndOut(), 0) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, Add(510, CAD_Bool_Clip.n), 1)
                    }
                }
            }
            CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
            CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 24) ThenBlock: { ReturnValue(0) }
        }
        IfCondition LessThan(CAD_Bool_Clip.n, 3) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 555, CAD_Bool_Clip.n)
        CAD_Bool_Clip.nh = 0
        CAD_Bool_Clip.nt = 0
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, ArrayGet(CAD_Bool_Clip.buf, 555)) {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, Add(510, CAD_Bool_Clip.g)), 1) ThenBlock: { CAD_Bool_Clip.nh = Add(CAD_Bool_Clip.nh, 1) }
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, Add(510, CAD_Bool_Clip.g)), 0) ThenBlock: { CAD_Bool_Clip.nt = Add(CAD_Bool_Clip.nt, 1) }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        IfCondition EqualTo(CAD_Bool_Clip.nt, 0) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 605, 0)
            CAD_Bool_Clip.g = 0
            WhileLoop LessThan(CAD_Bool_Clip.g, ArrayGet(CAD_Bool_Clip.buf, 555)) {
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(480, CAD_Bool_Clip.g))
                CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
                CAD_Bool_Clip.px = CAD_Store.Read(CAD_Bool_Clip.v, 0)
                CAD_Bool_Clip.py = CAD_Store.Read(CAD_Bool_Clip.v, 1)
                CAD_Bool_Clip.pz = CAD_Store.Read(CAD_Bool_Clip.v, 2)
                IfCondition EqualTo(CAD_BoolClip.EndOut(), 1) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 605, 1)
                }
                CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            }
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 605), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo.ShellUnlinkFace(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 2), ArrayGet(CAD_Bool_Clip.buf, 432))
            ReturnValue(1)
        }
        IfCondition EqualTo(CAD_Bool_Clip.nh, 0) ThenBlock: { ReturnValue(0) }
        // Outside ear: vertices that are not strictly inside the tool.
        // An ear whose body already lies in the opening is not a wall.
        ArraySet(CAD_Bool_Clip.buf, 606, 0)
        ArraySet(CAD_Bool_Clip.buf, 607, 0)
        ArraySet(CAD_Bool_Clip.buf, 608, 0)
        ArraySet(CAD_Bool_Clip.buf, 609, 0)
        ArraySet(CAD_Bool_Clip.buf, 610, 0)
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 1)
        CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
        CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
            ArraySet(CAD_Bool_Clip.buf, 620, CAD_Bool_Clip.ce)
            CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
            ArraySet(CAD_Bool_Clip.buf, 621, CAD_Store.Read(CAD_Bool_Clip.v, 0))
            ArraySet(CAD_Bool_Clip.buf, 622, CAD_Store.Read(CAD_Bool_Clip.v, 1))
            ArraySet(CAD_Bool_Clip.buf, 623, CAD_Store.Read(CAD_Bool_Clip.v, 2))
            CAD_Bool_Clip.px = ArrayGet(CAD_Bool_Clip.buf, 621)
            CAD_Bool_Clip.py = ArrayGet(CAD_Bool_Clip.buf, 622)
            CAD_Bool_Clip.pz = ArrayGet(CAD_Bool_Clip.buf, 623)
            CAD_Bool_Clip.n = CAD_BoolClip.InCyl()
            IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 606, Add(ArrayGet(CAD_Bool_Clip.buf, 606), 1))
                ArraySet(CAD_Bool_Clip.buf, 607, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 607), ArrayGet(CAD_Bool_Clip.buf, 621)))
                ArraySet(CAD_Bool_Clip.buf, 608, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 608), ArrayGet(CAD_Bool_Clip.buf, 622)))
                ArraySet(CAD_Bool_Clip.buf, 609, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 609), ArrayGet(CAD_Bool_Clip.buf, 623)))
                CAD_Bool_Clip.px = ArrayGet(CAD_Bool_Clip.buf, 621)
                CAD_Bool_Clip.py = ArrayGet(CAD_Bool_Clip.buf, 622)
                CAD_Bool_Clip.pz = ArrayGet(CAD_Bool_Clip.buf, 623)
                IfCondition EqualTo(CAD_BoolClip.EndOut(), 1) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 610, 1)
                }
            }
            CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 620), 2)
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 24) ThenBlock: { CAD_Bool_Clip.ce = 0 }
        }
        CAD_Bool_Clip.ok = CAD_BoolClip.EarIn()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
            CAD_Bool_Clip.ok = CAD_Topo.ShellUnlinkFace(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 432), 2), ArrayGet(CAD_Bool_Clip.buf, 432))
            ReturnValue(CAD_Bool_Clip.ok)
        }
        ArraySet(CAD_Bool_Clip.buf, 554, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, ArrayGet(CAD_Bool_Clip.buf, 555)) {
            CAD_Bool_Clip.n = Subtract(CAD_Bool_Clip.g, 1)
            IfCondition EqualTo(CAD_Bool_Clip.n, -1) ThenBlock: { CAD_Bool_Clip.n = Subtract(ArrayGet(CAD_Bool_Clip.buf, 555), 1) }
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, Add(510, CAD_Bool_Clip.g)), 1) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, Add(510, CAD_Bool_Clip.n)), 0) ThenBlock: {
                    IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 554), 2) ThenBlock: {
                        CAD_Bool_Clip.idx = Multiply(ArrayGet(CAD_Bool_Clip.buf, 554), 6)
                        ArraySet(CAD_Bool_Clip.buf, Add(560, CAD_Bool_Clip.idx), ArrayGet(CAD_Bool_Clip.buf, Add(480, CAD_Bool_Clip.g)))
                        CAD_Bool_Clip.ea = CAD_Bool_Clip.g
                        CAD_Bool_Clip.ob = 0
                        WhileLoop EqualTo(ArrayGet(CAD_Bool_Clip.buf, Add(510, CAD_Bool_Clip.ea)), 1) {
                            ArraySet(CAD_Bool_Clip.buf, Add(561, CAD_Bool_Clip.idx), ArrayGet(CAD_Bool_Clip.buf, Add(480, CAD_Bool_Clip.ea)))
                            CAD_Bool_Clip.ea = Add(CAD_Bool_Clip.ea, 1)
                            IfCondition EqualTo(CAD_Bool_Clip.ea, ArrayGet(CAD_Bool_Clip.buf, 555)) ThenBlock: { CAD_Bool_Clip.ea = 0 }
                            CAD_Bool_Clip.ob = Add(CAD_Bool_Clip.ob, 1)
                            IfCondition GreaterThan(CAD_Bool_Clip.ob, 24) ThenBlock: { CAD_Bool_Clip.ea = CAD_Bool_Clip.g }
                        }
                        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(560, CAD_Bool_Clip.idx))
                        ArraySet(CAD_Bool_Clip.buf, Add(562, CAD_Bool_Clip.idx), CAD_Store.Read(CAD_Bool_Clip.ce, 3))
                        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(561, CAD_Bool_Clip.idx))
                        ArraySet(CAD_Bool_Clip.buf, Add(563, CAD_Bool_Clip.idx), CAD_Store.Read(CAD_Bool_Clip.ce, 2))
                        ArraySet(CAD_Bool_Clip.buf, Add(564, CAD_Bool_Clip.idx), CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, Add(560, CAD_Bool_Clip.idx)), 5))
                        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(561, CAD_Bool_Clip.idx))
                        ArraySet(CAD_Bool_Clip.buf, Add(565, CAD_Bool_Clip.idx), CAD_BoolClip.Dest())
                        ArraySet(CAD_Bool_Clip.buf, 554, Add(ArrayGet(CAD_Bool_Clip.buf, 554), 1))
                    }
                }
            }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, ArrayGet(CAD_Bool_Clip.buf, 554)) {
            ArraySet(CAD_Bool_Clip.buf, 559, CAD_Bool_Clip.g)
            CAD_Bool_Clip.ok = CAD_BoolClip.ArcRun()
            CAD_Bool_Clip.g = Add(ArrayGet(CAD_Bool_Clip.buf, 559), 1)
        }
        ReturnValue(1)
    }
}

// Hole walls that pass through the cutter stop on the cylinder.
Function.CAD_BoolClip.ClipWalls {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_BoolClip.LoadCyl(), 0) ThenBlock: { ReturnValue(1) }
        ArraySet(CAD_Bool_Clip.buf, 536, CAD_Bool_Clip.hf0)
        ArraySet(CAD_Bool_Clip.buf, 537, CAD_Bool_Clip.hf1)
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.host, 0)
        CAD_Bool_Clip.n = 0
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
            IfCondition LessThan(CAD_Bool_Clip.n, 48) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.n), CAD_Bool_Clip.face)
                CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
            }
            CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.face, 3)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 80) ThenBlock: { CAD_Bool_Clip.face = 0 }
        }
        ArraySet(CAD_Bool_Clip.buf, 399, CAD_Bool_Clip.n)
        ArraySet(CAD_Bool_Clip.buf, 398, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 398), ArrayGet(CAD_Bool_Clip.buf, 399)) {
            ArraySet(CAD_Bool_Clip.buf, 432, ArrayGet(CAD_Bool_Clip.buf, Add(400, ArrayGet(CAD_Bool_Clip.buf, 398))))
            CAD_Bool_Clip.ok = CAD_BoolClip.ClipOne()
            ArraySet(CAD_Bool_Clip.buf, 398, Add(ArrayGet(CAD_Bool_Clip.buf, 398), 1))
        }
        ReturnValue(1)
    }
}

// After a split, move each extra loop onto the island that contains it.
// buf[400+c] is that cycle's face. buf[990] is the face that kept cycle 0.
// Walk state lives in buf[390..398] because LoopOdd reuses the pool.
// buf[387] is 1 when buf[388] and buf[389] are the chord that made the split.
Function.CAD_BoolClip.KeepHole {
    Output: Integer
    Body: {
        IfCondition LessThan(CAD_Bool_Clip.idx, 2) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 395, CAD_Bool_Clip.idx)
        ArraySet(CAD_Bool_Clip.buf, 392, ArrayGet(CAD_Bool_Clip.buf, 990))
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(ArrayGet(CAD_Bool_Clip.buf, 392), CAD_Bool_Clip.pl), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 392), 1)
        IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 396, CAD_Bool_Clip.lp)
        ArraySet(CAD_Bool_Clip.buf, 398, CAD_Store.Read(CAD_Bool_Clip.lp, 2))
        CAD_Bool_Clip.ob = 0
        WhileLoop NotEqual(ArrayGet(CAD_Bool_Clip.buf, 398), 0) {
            IfCondition GreaterThan(CAD_Bool_Clip.ob, 8) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 398, 0)
            }
            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 398), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 397, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 398), 2))
                ArraySet(CAD_Bool_Clip.buf, 379, 0)
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 387), 1) ThenBlock: {
                    CAD_Bool_Clip.ok = CAD_BoolClip.CutLoop()
                    ArraySet(CAD_Bool_Clip.buf, 379, CAD_Bool_Clip.ok)
                }
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 379), 0) ThenBlock: {
                CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 398), 0)
                CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
                CAD_BoolClip.VertUV()
                ArraySet(CAD_Bool_Clip.buf, 390, CAD_Bool_Clip.u0)
                ArraySet(CAD_Bool_Clip.buf, 391, CAD_Bool_Clip.v0)
                CAD_Bool_Clip.px = CAD_Bool_Clip.u0
                CAD_Bool_Clip.py = CAD_Bool_Clip.v0
                ArraySet(CAD_Bool_Clip.buf, 393, 0)
                ArraySet(CAD_Bool_Clip.buf, 394, 0)
                WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 394), ArrayGet(CAD_Bool_Clip.buf, 395)) {
                    CAD_Bool_Clip.px = ArrayGet(CAD_Bool_Clip.buf, 390)
                    CAD_Bool_Clip.py = ArrayGet(CAD_Bool_Clip.buf, 391)
                    CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, Add(400, ArrayGet(CAD_Bool_Clip.buf, 394)))
                    CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
                    CAD_Bool_Clip.ok = CAD_BoolClip.LoopOdd()
                    IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 393, ArrayGet(CAD_Bool_Clip.buf, Add(400, ArrayGet(CAD_Bool_Clip.buf, 394))))
                        ArraySet(CAD_Bool_Clip.buf, 394, ArrayGet(CAD_Bool_Clip.buf, 395))
                    }
                    IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 394), ArrayGet(CAD_Bool_Clip.buf, 395)) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 394, Add(ArrayGet(CAD_Bool_Clip.buf, 394), 1))
                    }
                }
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 393), ArrayGet(CAD_Bool_Clip.buf, 392)) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 396, ArrayGet(CAD_Bool_Clip.buf, 398))
                }
                // No remaining island contains this loop. It lies in the
                // opening the cut just made. Leave it on a cap and the
                // mesh bridges that opening.
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 393), 0) ThenBlock: {
                    CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 396), 2, ArrayGet(CAD_Bool_Clip.buf, 397))
                    CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 398), 1, 0)
                    CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 398), 2, 0)
                }
                IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 393), ArrayGet(CAD_Bool_Clip.buf, 392)) ThenBlock: {
                    IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 393), 0) ThenBlock: {
                        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 396), 2, ArrayGet(CAD_Bool_Clip.buf, 397))
                        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 398), 1, ArrayGet(CAD_Bool_Clip.buf, 393))
                        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 398), 2, 0)
                        CAD_Bool_Clip.w0 = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 393), 1)
                        CAD_Bool_Clip.oa = 0
                        WhileLoop NotEqual(CAD_Store.Read(CAD_Bool_Clip.w0, 2), 0) {
                            CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.w0, 2)
                            CAD_Bool_Clip.oa = Add(CAD_Bool_Clip.oa, 1)
                            IfCondition GreaterThan(CAD_Bool_Clip.oa, 8) ThenBlock: {
                                CAD_Store.Write(CAD_Bool_Clip.w0, 2, 0)
                            }
                        }
                        CAD_Store.Write(CAD_Bool_Clip.w0, 2, ArrayGet(CAD_Bool_Clip.buf, 398))
                    }
                }
                }
                ArraySet(CAD_Bool_Clip.buf, 398, ArrayGet(CAD_Bool_Clip.buf, 397))
            }
            CAD_Bool_Clip.ob = Add(CAD_Bool_Clip.ob, 1)
        }
        ReturnValue(1)
    }
}

// Reverse tool coedges so the bite can chain with the host outline.
Function.CAD_BoolClip.Flip {
    Output: Integer
    Body: {
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, CAD_Bool_Clip.nh) {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, Add(128, CAD_Bool_Clip.g)), 1) ThenBlock: {
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, CAD_Bool_Clip.g)
                CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
                CAD_Bool_Clip.tw = CAD_Store.Read(CAD_Bool_Clip.ce, 1)
                CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
                CAD_Bool_Clip.n = 0
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 0), CAD_Bool_Clip.w1) ThenBlock: { CAD_Bool_Clip.n = 1 }
                CAD_Bool_Clip.c2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.ea, CAD_Bool_Clip.w1, CAD_Bool_Clip.n)
                IfCondition NotEqual(CAD_Bool_Clip.tw, 0) ThenBlock: {
                    CAD_Topo.LinkTwins(CAD_Bool_Clip.c2, CAD_Bool_Clip.tw)
                }
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 3), CAD_Bool_Clip.ce) ThenBlock: {
                    CAD_Store.Write(CAD_Bool_Clip.ea, 3, CAD_Bool_Clip.c2)
                }
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 4), CAD_Bool_Clip.ce) ThenBlock: {
                    CAD_Store.Write(CAD_Bool_Clip.ea, 4, CAD_Bool_Clip.c2)
                }
                ArraySet(CAD_Bool_Clip.buf, CAD_Bool_Clip.g, CAD_Bool_Clip.c2)
            }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        ReturnValue(1)
    }
}

// Link buf[256 .. 256+count) onto hole loop buf[983]. Flags are buf[304].
// Next index is buf[352]. 0 when the coedges do not make one cycle.
// Does not write next until that cycle is real.
Function.CAD_BoolClip.HoleLink {
    Output: Integer
    Body: {
        IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 996), 3) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 982, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 982), ArrayGet(CAD_Bool_Clip.buf, 996)) {
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(256, ArrayGet(CAD_Bool_Clip.buf, 982)))
            CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
            ArraySet(CAD_Bool_Clip.buf, 980, 0)
            ArraySet(CAD_Bool_Clip.buf, 981, 0)
            WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 981), ArrayGet(CAD_Bool_Clip.buf, 996)) {
                CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, Add(256, ArrayGet(CAD_Bool_Clip.buf, 981)))
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.v, 5), CAD_Bool_Clip.t0) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 980, 1)
                    ArraySet(CAD_Bool_Clip.buf, Add(352, ArrayGet(CAD_Bool_Clip.buf, 982)), ArrayGet(CAD_Bool_Clip.buf, 981))
                    ArraySet(CAD_Bool_Clip.buf, 981, ArrayGet(CAD_Bool_Clip.buf, 996))
                }
                IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 981), ArrayGet(CAD_Bool_Clip.buf, 996)) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 981, Add(ArrayGet(CAD_Bool_Clip.buf, 981), 1))
                }
            }
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 980), 0) ThenBlock: { ReturnValue(0) }
            ArraySet(CAD_Bool_Clip.buf, 982, Add(ArrayGet(CAD_Bool_Clip.buf, 982), 1))
        }
        ArraySet(CAD_Bool_Clip.buf, 980, 0)
        ArraySet(CAD_Bool_Clip.buf, 981, 0)
        ArraySet(CAD_Bool_Clip.buf, 982, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 982), ArrayGet(CAD_Bool_Clip.buf, 996)) {
            ArraySet(CAD_Bool_Clip.buf, 981, ArrayGet(CAD_Bool_Clip.buf, Add(352, ArrayGet(CAD_Bool_Clip.buf, 981))))
            ArraySet(CAD_Bool_Clip.buf, 982, Add(ArrayGet(CAD_Bool_Clip.buf, 982), 1))
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 981), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 980, ArrayGet(CAD_Bool_Clip.buf, 982))
                ArraySet(CAD_Bool_Clip.buf, 982, ArrayGet(CAD_Bool_Clip.buf, 996))
            }
        }
        IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 980), ArrayGet(CAD_Bool_Clip.buf, 996)) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 982, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 982), ArrayGet(CAD_Bool_Clip.buf, 996)) {
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(256, ArrayGet(CAD_Bool_Clip.buf, 982)))
            CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, Add(352, ArrayGet(CAD_Bool_Clip.buf, 982)))
            CAD_Bool_Clip.c2 = ArrayGet(CAD_Bool_Clip.buf, Add(256, CAD_Bool_Clip.n))
            CAD_Store.Write(CAD_Bool_Clip.ce, 2, CAD_Bool_Clip.c2)
            CAD_Store.Write(CAD_Bool_Clip.c2, 3, CAD_Bool_Clip.ce)
            CAD_Store.Write(CAD_Bool_Clip.ce, 4, ArrayGet(CAD_Bool_Clip.buf, 983))
            ArraySet(CAD_Bool_Clip.buf, 982, Add(ArrayGet(CAD_Bool_Clip.buf, 982), 1))
        }
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 983), 0, ArrayGet(CAD_Bool_Clip.buf, 256))
        ReturnValue(1)
    }
}

// Reverse the tool coedges in the hole list. Host coedges stay.
Function.CAD_BoolClip.HoleFlip {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 982, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 982), ArrayGet(CAD_Bool_Clip.buf, 996)) {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, Add(304, ArrayGet(CAD_Bool_Clip.buf, 982))), 1) ThenBlock: {
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(256, ArrayGet(CAD_Bool_Clip.buf, 982)))
                CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
                CAD_Bool_Clip.tw = CAD_Store.Read(CAD_Bool_Clip.ce, 1)
                CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
                CAD_Bool_Clip.n = 0
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 0), CAD_Bool_Clip.w1) ThenBlock: { CAD_Bool_Clip.n = 1 }
                CAD_Bool_Clip.c2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.ea, CAD_Bool_Clip.w1, CAD_Bool_Clip.n)
                IfCondition NotEqual(CAD_Bool_Clip.tw, 0) ThenBlock: {
                    CAD_Topo.LinkTwins(CAD_Bool_Clip.c2, CAD_Bool_Clip.tw)
                }
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 3), CAD_Bool_Clip.ce) ThenBlock: {
                    CAD_Store.Write(CAD_Bool_Clip.ea, 3, CAD_Bool_Clip.c2)
                }
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 4), CAD_Bool_Clip.ce) ThenBlock: {
                    CAD_Store.Write(CAD_Bool_Clip.ea, 4, CAD_Bool_Clip.c2)
                }
                ArraySet(CAD_Bool_Clip.buf, Add(256, ArrayGet(CAD_Bool_Clip.buf, 982)), CAD_Bool_Clip.c2)
            }
            ArraySet(CAD_Bool_Clip.buf, 982, Add(ArrayGet(CAD_Bool_Clip.buf, 982), 1))
        }
        ReturnValue(1)
    }
}

// Replace one open run on the hole, from the end of .ce to the start of the
// coedge in buf[484], with the tool-loop path between those vertices.
// The path may cross the circle seam. A seam vertex is not a hole vertex,
// so a flat dest-to-origin chain stops there. Walking the tool loop does not.
// Fewer coedges outside the host material wins, then the shorter path.
// 0 when no tool path joins the two vertices.
Function.CAD_BoolClip.BridgeGap {
    Output: Integer
    Body: {
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 483)
        CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
        ArraySet(CAD_Bool_Clip.buf, 460, CAD_Bool_Clip.t0)
        ArraySet(CAD_Bool_Clip.buf, 461, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 484), 5))
        ArraySet(CAD_Bool_Clip.buf, 454, 0)
        ArraySet(CAD_Bool_Clip.buf, 455, 100)
        ArraySet(CAD_Bool_Clip.buf, 456, 0)
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1002), 1)
        IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 462, CAD_Store.Read(CAD_Bool_Clip.lp, 0))
        ArraySet(CAD_Bool_Clip.buf, 463, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 463), 2) {
            ArraySet(CAD_Bool_Clip.buf, 464, ArrayGet(CAD_Bool_Clip.buf, 460))
            ArraySet(CAD_Bool_Clip.buf, 465, ArrayGet(CAD_Bool_Clip.buf, 461))
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 463), 1) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 464, ArrayGet(CAD_Bool_Clip.buf, 461))
                ArraySet(CAD_Bool_Clip.buf, 465, ArrayGet(CAD_Bool_Clip.buf, 460))
            }
            CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, 462)
            ArraySet(CAD_Bool_Clip.buf, 466, 0)
            ArraySet(CAD_Bool_Clip.buf, 467, 0)
            WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 467), 64) {
                IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 467, 64)
                }
                IfCondition NotEqual(CAD_Bool_Clip.n, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.n, 5), ArrayGet(CAD_Bool_Clip.buf, 464)) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 466, CAD_Bool_Clip.n)
                        ArraySet(CAD_Bool_Clip.buf, 467, 64)
                    }
                    IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 467), 64) ThenBlock: {
                        CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.n, 2)
                        IfCondition EqualTo(CAD_Bool_Clip.w0, ArrayGet(CAD_Bool_Clip.buf, 462)) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, 467, 64)
                        }
                        IfCondition NotEqual(CAD_Bool_Clip.w0, ArrayGet(CAD_Bool_Clip.buf, 462)) ThenBlock: {
                            CAD_Bool_Clip.n = CAD_Bool_Clip.w0
                        }
                    }
                }
                ArraySet(CAD_Bool_Clip.buf, 467, Add(ArrayGet(CAD_Bool_Clip.buf, 467), 1))
            }
            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 466), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 424, 0)
                ArraySet(CAD_Bool_Clip.buf, 468, 0)
                ArraySet(CAD_Bool_Clip.buf, 469, 0)
                CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, 466)
                WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 468), 24) {
                    IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 468, 24)
                    }
                    IfCondition NotEqual(CAD_Bool_Clip.n, 0) ThenBlock: {
                        IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 424), 24) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, Add(400, ArrayGet(CAD_Bool_Clip.buf, 424)), CAD_Bool_Clip.n)
                            ArraySet(CAD_Bool_Clip.buf, 424, Add(ArrayGet(CAD_Bool_Clip.buf, 424), 1))
                        }
                        CAD_Bool_Clip.ce = CAD_Bool_Clip.n
                        CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
                        IfCondition EqualTo(CAD_Bool_Clip.t0, ArrayGet(CAD_Bool_Clip.buf, 465)) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, 468, 24)
                            ArraySet(CAD_Bool_Clip.buf, 469, 1)
                        }
                        IfCondition NotEqual(CAD_Bool_Clip.t0, ArrayGet(CAD_Bool_Clip.buf, 465)) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, 469, 0)
                            CAD_Bool_Clip.w0 = CAD_Store.Read(CAD_Bool_Clip.n, 2)
                            IfCondition EqualTo(CAD_Bool_Clip.w0, ArrayGet(CAD_Bool_Clip.buf, 466)) ThenBlock: {
                                ArraySet(CAD_Bool_Clip.buf, 468, 24)
                            }
                            IfCondition NotEqual(CAD_Bool_Clip.w0, ArrayGet(CAD_Bool_Clip.buf, 466)) ThenBlock: {
                                CAD_Bool_Clip.n = CAD_Bool_Clip.w0
                            }
                        }
                    }
                    ArraySet(CAD_Bool_Clip.buf, 468, Add(ArrayGet(CAD_Bool_Clip.buf, 468), 1))
                }
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 469), 1) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 425, 0)
                    ArraySet(CAD_Bool_Clip.buf, 467, 0)
                    WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 467), ArrayGet(CAD_Bool_Clip.buf, 424)) {
                        CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1001)
                        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(400, ArrayGet(CAD_Bool_Clip.buf, 467)))
                        CAD_Bool_Clip.ok = CAD_BoolClip.MidIn()
                        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, 425, Add(ArrayGet(CAD_Bool_Clip.buf, 425), 1))
                        }
                        ArraySet(CAD_Bool_Clip.buf, 467, Add(ArrayGet(CAD_Bool_Clip.buf, 467), 1))
                    }
                    ArraySet(CAD_Bool_Clip.buf, 428, 0)
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 454), 0) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 428, 1)
                    }
                    IfCondition GreaterThan(ArrayGet(CAD_Bool_Clip.buf, 455), ArrayGet(CAD_Bool_Clip.buf, 425)) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 428, 1)
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 455), ArrayGet(CAD_Bool_Clip.buf, 425)) ThenBlock: {
                        IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 424), ArrayGet(CAD_Bool_Clip.buf, 454)) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, 428, 1)
                        }
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 428), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 467, 0)
                        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 467), ArrayGet(CAD_Bool_Clip.buf, 424)) {
                            ArraySet(CAD_Bool_Clip.buf, Add(430, ArrayGet(CAD_Bool_Clip.buf, 467)), ArrayGet(CAD_Bool_Clip.buf, Add(400, ArrayGet(CAD_Bool_Clip.buf, 467))))
                            ArraySet(CAD_Bool_Clip.buf, 467, Add(ArrayGet(CAD_Bool_Clip.buf, 467), 1))
                        }
                        ArraySet(CAD_Bool_Clip.buf, 454, ArrayGet(CAD_Bool_Clip.buf, 424))
                        ArraySet(CAD_Bool_Clip.buf, 455, ArrayGet(CAD_Bool_Clip.buf, 425))
                        ArraySet(CAD_Bool_Clip.buf, 456, ArrayGet(CAD_Bool_Clip.buf, 463))
                    }
                }
            }
            ArraySet(CAD_Bool_Clip.buf, 463, Add(ArrayGet(CAD_Bool_Clip.buf, 463), 1))
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 454), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 457, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 430), 3))
        CAD_Bool_Clip.n = Subtract(ArrayGet(CAD_Bool_Clip.buf, 454), 1)
        ArraySet(CAD_Bool_Clip.buf, 458, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, Add(430, CAD_Bool_Clip.n)), 2))
        IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 457), 0) ThenBlock: {
            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 458), 0) ThenBlock: {
                IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 458), ArrayGet(CAD_Bool_Clip.buf, 430)) ThenBlock: {
                    CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 457), 2, ArrayGet(CAD_Bool_Clip.buf, 458))
                    CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 458), 3, ArrayGet(CAD_Bool_Clip.buf, 457))
                    CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1002), 1)
                    ArraySet(CAD_Bool_Clip.buf, 467, 0)
                    ArraySet(CAD_Bool_Clip.buf, 428, 0)
                    WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 467), ArrayGet(CAD_Bool_Clip.buf, 454)) {
                        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.lp, 0), ArrayGet(CAD_Bool_Clip.buf, Add(430, ArrayGet(CAD_Bool_Clip.buf, 467)))) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, 428, 1)
                        }
                        ArraySet(CAD_Bool_Clip.buf, 467, Add(ArrayGet(CAD_Bool_Clip.buf, 467), 1))
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 428), 1) ThenBlock: {
                        CAD_Store.Write(CAD_Bool_Clip.lp, 0, ArrayGet(CAD_Bool_Clip.buf, 458))
                    }
                }
            }
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 456), 1) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 467, 0)
            WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 467), ArrayGet(CAD_Bool_Clip.buf, 454)) {
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(430, ArrayGet(CAD_Bool_Clip.buf, 467)))
                CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
                CAD_Bool_Clip.tw = CAD_Store.Read(CAD_Bool_Clip.ce, 1)
                CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
                CAD_Bool_Clip.n = 0
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 0), CAD_Bool_Clip.w1) ThenBlock: { CAD_Bool_Clip.n = 1 }
                CAD_Bool_Clip.c2 = CAD_Topo.MakeCoedge(CAD_Bool_Clip.ea, CAD_Bool_Clip.w1, CAD_Bool_Clip.n)
                IfCondition NotEqual(CAD_Bool_Clip.tw, 0) ThenBlock: {
                    CAD_Topo.LinkTwins(CAD_Bool_Clip.c2, CAD_Bool_Clip.tw)
                }
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 3), CAD_Bool_Clip.ce) ThenBlock: {
                    CAD_Store.Write(CAD_Bool_Clip.ea, 3, CAD_Bool_Clip.c2)
                }
                IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.ea, 4), CAD_Bool_Clip.ce) ThenBlock: {
                    CAD_Store.Write(CAD_Bool_Clip.ea, 4, CAD_Bool_Clip.c2)
                }
                ArraySet(CAD_Bool_Clip.buf, Add(400, ArrayGet(CAD_Bool_Clip.buf, 467)), CAD_Bool_Clip.c2)
                ArraySet(CAD_Bool_Clip.buf, 467, Add(ArrayGet(CAD_Bool_Clip.buf, 467), 1))
            }
            ArraySet(CAD_Bool_Clip.buf, 467, 0)
            WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 467), ArrayGet(CAD_Bool_Clip.buf, 454)) {
                CAD_Bool_Clip.n = Subtract(ArrayGet(CAD_Bool_Clip.buf, 454), 1)
                CAD_Bool_Clip.n = Subtract(CAD_Bool_Clip.n, ArrayGet(CAD_Bool_Clip.buf, 467))
                ArraySet(CAD_Bool_Clip.buf, Add(430, ArrayGet(CAD_Bool_Clip.buf, 467)), ArrayGet(CAD_Bool_Clip.buf, Add(400, CAD_Bool_Clip.n)))
                ArraySet(CAD_Bool_Clip.buf, 467, Add(ArrayGet(CAD_Bool_Clip.buf, 467), 1))
            }
        }
        ArraySet(CAD_Bool_Clip.buf, 467, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 467), ArrayGet(CAD_Bool_Clip.buf, 454)) {
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(430, ArrayGet(CAD_Bool_Clip.buf, 467)))
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 467), 0) ThenBlock: {
                CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 483), 2, CAD_Bool_Clip.ce)
                CAD_Store.Write(CAD_Bool_Clip.ce, 3, ArrayGet(CAD_Bool_Clip.buf, 483))
            }
            IfCondition GreaterThan(ArrayGet(CAD_Bool_Clip.buf, 467), 0) ThenBlock: {
                CAD_Bool_Clip.n = Subtract(ArrayGet(CAD_Bool_Clip.buf, 467), 1)
                CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, Add(430, CAD_Bool_Clip.n))
                CAD_Store.Write(CAD_Bool_Clip.w0, 2, CAD_Bool_Clip.ce)
                CAD_Store.Write(CAD_Bool_Clip.ce, 3, CAD_Bool_Clip.w0)
            }
            CAD_Bool_Clip.n = Add(ArrayGet(CAD_Bool_Clip.buf, 467), 1)
            IfCondition EqualTo(CAD_Bool_Clip.n, ArrayGet(CAD_Bool_Clip.buf, 454)) ThenBlock: {
                CAD_Store.Write(CAD_Bool_Clip.ce, 2, ArrayGet(CAD_Bool_Clip.buf, 484))
                CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 484), 3, CAD_Bool_Clip.ce)
            }
            CAD_Store.Write(CAD_Bool_Clip.ce, 4, ArrayGet(CAD_Bool_Clip.buf, 983))
            ArraySet(CAD_Bool_Clip.buf, 467, Add(ArrayGet(CAD_Bool_Clip.buf, 467), 1))
        }
        ReturnValue(1)
    }
}

// Kept host coedges are buf[256 .. 256+buf[996]). Each place the next kept
// coedge does not start where this one ends is a run the tool removed.
// 1 when every such run was bridged.
Function.CAD_BoolClip.HoleBridge {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 985, 0)
        IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 996), 3) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 482, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 482), ArrayGet(CAD_Bool_Clip.buf, 996)) {
            CAD_Bool_Clip.n = Add(ArrayGet(CAD_Bool_Clip.buf, 482), 1)
            IfCondition EqualTo(CAD_Bool_Clip.n, ArrayGet(CAD_Bool_Clip.buf, 996)) ThenBlock: { CAD_Bool_Clip.n = 0 }
            ArraySet(CAD_Bool_Clip.buf, 481, CAD_Bool_Clip.n)
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, Add(256, ArrayGet(CAD_Bool_Clip.buf, 482)))
            CAD_Bool_Clip.t0 = CAD_BoolClip.Dest()
            CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, Add(256, ArrayGet(CAD_Bool_Clip.buf, 481)))
            IfCondition NotEqual(CAD_Bool_Clip.t0, CAD_Store.Read(CAD_Bool_Clip.v, 5)) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 483, CAD_Bool_Clip.ce)
                ArraySet(CAD_Bool_Clip.buf, 484, CAD_Bool_Clip.v)
                CAD_Bool_Clip.ok = CAD_BoolClip.BridgeGap()
                IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
                ArraySet(CAD_Bool_Clip.buf, 985, Add(ArrayGet(CAD_Bool_Clip.buf, 985), 1))
            }
            ArraySet(CAD_Bool_Clip.buf, 482, Add(ArrayGet(CAD_Bool_Clip.buf, 482), 1))
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 985), 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 983), 0, ArrayGet(CAD_Bool_Clip.buf, 256))
        ReturnValue(1)
    }
}

// Outer Chain missed. Sew one hole from the host edges outside the tool
// and the tool path that bridges each run those edges opened.
// 1 when a hole gained a tool arc. buf[0] and buf[128] stay the outer list.
Function.CAD_BoolClip.HoleSew {
    Output: Integer
    Body: {
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1001), 1)
        IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 984, CAD_Store.Read(CAD_Bool_Clip.lp, 2))
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 984), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 979, 0)
        ArraySet(CAD_Bool_Clip.buf, 978, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 978), 8) {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 984), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 978, 8)
            }
            IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 984), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 983, ArrayGet(CAD_Bool_Clip.buf, 984))
                ArraySet(CAD_Bool_Clip.buf, 977, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 983), 2))
                ArraySet(CAD_Bool_Clip.buf, 996, 0)
                ArraySet(CAD_Bool_Clip.buf, 985, 0)
                CAD_Bool_Clip.n = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 983), 0)
                ArraySet(CAD_Bool_Clip.buf, 976, CAD_Bool_Clip.n)
                ArraySet(CAD_Bool_Clip.buf, 982, 0)
                WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 982), 64) {
                    IfCondition EqualTo(CAD_Bool_Clip.n, 0) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 982, 64)
                    }
                    IfCondition NotEqual(CAD_Bool_Clip.n, 0) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 997, CAD_Bool_Clip.n)
                        CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1002)
                        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 997)
                        CAD_Bool_Clip.ok = CAD_BoolClip.MidIn()
                        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: {
                            IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 996), 40) ThenBlock: {
                                ArraySet(CAD_Bool_Clip.buf, Add(256, ArrayGet(CAD_Bool_Clip.buf, 996)), ArrayGet(CAD_Bool_Clip.buf, 997))
                                ArraySet(CAD_Bool_Clip.buf, Add(304, ArrayGet(CAD_Bool_Clip.buf, 996)), 0)
                                ArraySet(CAD_Bool_Clip.buf, 996, Add(ArrayGet(CAD_Bool_Clip.buf, 996), 1))
                            }
                        }
                        CAD_Bool_Clip.n = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 997), 2)
                        IfCondition EqualTo(CAD_Bool_Clip.n, ArrayGet(CAD_Bool_Clip.buf, 976)) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, 982, 64)
                        }
                    }
                    ArraySet(CAD_Bool_Clip.buf, 982, Add(ArrayGet(CAD_Bool_Clip.buf, 982), 1))
                }
                CAD_Bool_Clip.ok = CAD_BoolClip.HoleBridge()
                IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 979, 1)
                }
                ArraySet(CAD_Bool_Clip.buf, 984, ArrayGet(CAD_Bool_Clip.buf, 977))
            }
            ArraySet(CAD_Bool_Clip.buf, 978, Add(ArrayGet(CAD_Bool_Clip.buf, 978), 1))
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 979), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Host face .face loses the part covered by tool face .eb's loop.
// MidIn walks the other face and drops .n .ce .g .nh .cf. Those live in
// buf[997..1002] for the walk: cursor, g, nh, loop start, host face, tool face.
Function.CAD_BoolClip.Rewire {
    Output: Integer
    Body: {
        CAD_Bool_Clip.pk = CAD_Bool_Clip.eb
        CAD_Bool_Clip.sa = CAD_Bool_Clip.face
        ArraySet(CAD_Bool_Clip.buf, 1001, CAD_Bool_Clip.sa)
        ArraySet(CAD_Bool_Clip.buf, 1002, CAD_Bool_Clip.pk)
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1001), 1)
        CAD_Bool_Clip.n = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
        ArraySet(CAD_Bool_Clip.buf, 1000, CAD_Bool_Clip.n)
        ArraySet(CAD_Bool_Clip.buf, 999, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, 64) {
            ArraySet(CAD_Bool_Clip.buf, 997, CAD_Bool_Clip.n)
            ArraySet(CAD_Bool_Clip.buf, 998, CAD_Bool_Clip.g)
            CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1002)
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 997)
            CAD_Bool_Clip.ok = CAD_BoolClip.MidIn()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: {
                CAD_Bool_Clip.nh = ArrayGet(CAD_Bool_Clip.buf, 999)
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 997)
                IfCondition LessThan(CAD_Bool_Clip.nh, 48) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, CAD_Bool_Clip.nh, CAD_Bool_Clip.ce)
                    ArraySet(CAD_Bool_Clip.buf, Add(128, CAD_Bool_Clip.nh), 0)
                    ArraySet(CAD_Bool_Clip.buf, 999, Add(CAD_Bool_Clip.nh, 1))
                }
            }
            CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, 997)
            CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.n, 2)
            CAD_Bool_Clip.cf = ArrayGet(CAD_Bool_Clip.buf, 1000)
            CAD_Bool_Clip.g = ArrayGet(CAD_Bool_Clip.buf, 998)
            IfCondition EqualTo(CAD_Bool_Clip.ea, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.g = 64 }
            CAD_Bool_Clip.n = CAD_Bool_Clip.ea
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1002), 1)
        CAD_Bool_Clip.n = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
        ArraySet(CAD_Bool_Clip.buf, 1000, CAD_Bool_Clip.n)
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, 64) {
            ArraySet(CAD_Bool_Clip.buf, 997, CAD_Bool_Clip.n)
            ArraySet(CAD_Bool_Clip.buf, 998, CAD_Bool_Clip.g)
            CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1001)
            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 997)
            CAD_Bool_Clip.ok = CAD_BoolClip.MidStrict()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                CAD_Bool_Clip.nh = ArrayGet(CAD_Bool_Clip.buf, 999)
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 997)
                IfCondition LessThan(CAD_Bool_Clip.nh, 48) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, CAD_Bool_Clip.nh, CAD_Bool_Clip.ce)
                    ArraySet(CAD_Bool_Clip.buf, Add(128, CAD_Bool_Clip.nh), 1)
                    ArraySet(CAD_Bool_Clip.buf, 999, Add(CAD_Bool_Clip.nh, 1))
                }
            }
            CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, 997)
            CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.n, 2)
            CAD_Bool_Clip.cf = ArrayGet(CAD_Bool_Clip.buf, 1000)
            CAD_Bool_Clip.g = ArrayGet(CAD_Bool_Clip.buf, 998)
            IfCondition EqualTo(CAD_Bool_Clip.ea, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.g = 64 }
            CAD_Bool_Clip.n = CAD_Bool_Clip.ea
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        CAD_Bool_Clip.nh = ArrayGet(CAD_Bool_Clip.buf, 999)
        CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1001)
        CAD_Bool_Clip.sa = CAD_Bool_Clip.face
        IfCondition LessThan(CAD_Bool_Clip.nh, 3) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ok = CAD_BoolClip.Chain()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: {
            CAD_Bool_Clip.nh = ArrayGet(CAD_Bool_Clip.buf, 999)
            CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1001)
            CAD_Bool_Clip.ok = CAD_BoolClip.HoleSew()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: {
                CAD_Bool_Clip.nh = ArrayGet(CAD_Bool_Clip.buf, 999)
                CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1001)
                CAD_BoolClip.Flip()
                CAD_Bool_Clip.nh = ArrayGet(CAD_Bool_Clip.buf, 999)
                CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1001)
                CAD_Bool_Clip.ok = CAD_BoolClip.Chain()
            }
        }
        ReturnValue(CAD_Bool_Clip.ok)
    }
}

// pack[48..53] = host, tool, f0, f1, hf0, hf1.
// Returns host when the overlap was removed, 0 when the tool is a hole,
// -1 when there is nothing to cut.
Function.CAD_BoolClip.Apply {
    Input: pack: Address
    Output: Integer
    Body: {
        CAD_Bool_Clip.pk = pack
        CAD_Bool_Clip.host = ArrayGet(CAD_Bool_Clip.pk, 48)
        CAD_Bool_Clip.tool = ArrayGet(CAD_Bool_Clip.pk, 49)
        CAD_Bool_Clip.f0 = ArrayGet(CAD_Bool_Clip.pk, 50)
        CAD_Bool_Clip.f1 = ArrayGet(CAD_Bool_Clip.pk, 51)
        CAD_Bool_Clip.hf0 = ArrayGet(CAD_Bool_Clip.pk, 52)
        CAD_Bool_Clip.hf1 = ArrayGet(CAD_Bool_Clip.pk, 53)
        IfCondition EqualTo(CAD_Bool_Clip.host, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_BoolClip.Init(), 0) ThenBlock: { ReturnValue(-1) }
        CAD_BoolClip.SnapHoles()
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Bool_Clip.hf0, CAD_Bool_Clip.pl), 0) ThenBlock: { ReturnValue(-1) }
        CAD_BoolClip.Gather()
        CAD_Bool_Clip.fg = CAD_BoolClip.Class()
        IfCondition EqualTo(CAD_Bool_Clip.fg, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Bool_Clip.fg, 2) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Bool_Clip.hf1, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(CAD_Bool_Clip.hi, 2) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Bool_Clip.hf1, CAD_Bool_Clip.fr), 0) ThenBlock: { ReturnValue(-1) }
        // Host plane origins are a corner of each face, so origin1-origin0
        // can slide across the face. The cutter moves along the normal.
        CAD_Bool_Clip.ox = Float_Sub(ArrayGet(CAD_Bool_Clip.fr, 1), ArrayGet(CAD_Bool_Clip.pl, 1))
        CAD_Bool_Clip.oy = Float_Sub(ArrayGet(CAD_Bool_Clip.fr, 2), ArrayGet(CAD_Bool_Clip.pl, 2))
        CAD_Bool_Clip.oz = Float_Sub(ArrayGet(CAD_Bool_Clip.fr, 3), ArrayGet(CAD_Bool_Clip.pl, 3))
        CAD_Bool_Clip.nx = ArrayGet(CAD_Bool_Clip.fr, 10)
        CAD_Bool_Clip.ny = ArrayGet(CAD_Bool_Clip.fr, 11)
        CAD_Bool_Clip.nz = ArrayGet(CAD_Bool_Clip.fr, 12)
        CAD_Bool_Clip.dist = Float_Mul(CAD_Bool_Clip.ox, CAD_Bool_Clip.nx)
        CAD_Bool_Clip.dist = Float_Add(CAD_Bool_Clip.dist, Float_Mul(CAD_Bool_Clip.oy, CAD_Bool_Clip.ny))
        CAD_Bool_Clip.dist = Float_Add(CAD_Bool_Clip.dist, Float_Mul(CAD_Bool_Clip.oz, CAD_Bool_Clip.nz))
        CAD_Bool_Clip.th = Float_Mul(CAD_Bool_Clip.nx, CAD_Bool_Clip.nx)
        CAD_Bool_Clip.th = Float_Add(CAD_Bool_Clip.th, Float_Mul(CAD_Bool_Clip.ny, CAD_Bool_Clip.ny))
        CAD_Bool_Clip.th = Float_Add(CAD_Bool_Clip.th, Float_Mul(CAD_Bool_Clip.nz, CAD_Bool_Clip.nz))
        CAD_Bool_Clip.dist = Float_Div(CAD_Bool_Clip.dist, CAD_Bool_Clip.th)
        CAD_Bool_Clip.ox = Float_Mul(CAD_Bool_Clip.nx, CAD_Bool_Clip.dist)
        CAD_Bool_Clip.oy = Float_Mul(CAD_Bool_Clip.ny, CAD_Bool_Clip.dist)
        CAD_Bool_Clip.oz = Float_Mul(CAD_Bool_Clip.nz, CAD_Bool_Clip.dist)
        ArraySet(CAD_Bool_Clip.buf, 906, 0)
        CAD_Bool_Clip.ob = 0
        WhileLoop LessThan(CAD_Bool_Clip.ob, CAD_Bool_Clip.hi) {
            CAD_Bool_Clip.g = CAD_Bool_Clip.ob
            CAD_Bool_Clip.ok = CAD_BoolClip.One()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(-1) }
            CAD_Bool_Clip.ob = Add(ArrayGet(CAD_Bool_Clip.buf, 906), 1)
            ArraySet(CAD_Bool_Clip.buf, 906, CAD_Bool_Clip.ob)
        }
        CAD_Bool_Clip.ok = CAD_BoolClip.OpenLoops()
        IfCondition LessThan(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Bool_Clip.ok = CAD_BoolClip.ClipWalls()
        IfCondition LessThan(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(-1) }
        CAD_BoolClip.DropHost()
        CAD_BoolClip.Steal()
        CAD_Bool_Clip.face = CAD_Bool_Clip.hf0
        CAD_Bool_Clip.sa = CAD_Bool_Clip.hf0
        CAD_Bool_Clip.eb = CAD_Bool_Clip.f0
        CAD_Bool_Clip.ok = CAD_BoolClip.Rewire()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Bool_Clip.face = CAD_Bool_Clip.hf1
        CAD_Bool_Clip.sa = CAD_Bool_Clip.hf1
        CAD_Bool_Clip.eb = CAD_Bool_Clip.f1
        CAD_Bool_Clip.ok = CAD_BoolClip.Rewire()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(-1) }
        CAD_BoolClip.TrimVoid()
        ReturnValue(CAD_Bool_Clip.host)
    }
}

