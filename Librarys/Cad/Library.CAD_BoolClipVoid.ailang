// A tool wall that crosses an opening already in the host is not a wall.
// The strip whose generators lie in that opening is left off the shell.
// Wings on either side stay. No pool: CAD_Bool_Clip is the parent's.

// One horizontal inner loop, XY, into buf[1180]=1, buf[1181]=count,
// buf[1182 + i*2]=x, +1=y. Eight vertices. The first such loop wins.
Function.CAD_BoolClip.SnapHoles {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 1180, 0)
        ArraySet(CAD_Bool_Clip.buf, 1181, 0)
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.host, 0)
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
            ArraySet(CAD_Bool_Clip.buf, 1178, CAD_Bool_Clip.face)
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1180), 0) ThenBlock: {
                CAD_Bool_Clip.ok = CAD_Topo.FaceGetPlane(ArrayGet(CAD_Bool_Clip.buf, 1178), CAD_Bool_Clip.pl)
                IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 1179, ArrayGet(CAD_Bool_Clip.pl, 12))
                    IfCondition EqualTo(CAD_Num.IsNeg(ArrayGet(CAD_Bool_Clip.buf, 1179)), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 1179, Float_Sub(0, ArrayGet(CAD_Bool_Clip.buf, 1179)))
                    }
                    IfCondition EqualTo(CAD_Num.Le(0x3FECCCCCCCCCCCCD, ArrayGet(CAD_Bool_Clip.buf, 1179)), 1) ThenBlock: {
                        CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1178)
                        CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
                        IfCondition NotEqual(CAD_Bool_Clip.lp, 0) ThenBlock: {
                            CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.lp, 2)
                        }
                        IfCondition NotEqual(CAD_Bool_Clip.lp, 0) ThenBlock: {
                            CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
                            CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
                            CAD_Bool_Clip.n = 0
                            WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
                                IfCondition LessThan(CAD_Bool_Clip.n, 8) ThenBlock: {
                                    CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
                                    ArraySet(CAD_Bool_Clip.buf, Add(1182, Multiply(CAD_Bool_Clip.n, 2)), CAD_Store.Read(CAD_Bool_Clip.v, 0))
                                    ArraySet(CAD_Bool_Clip.buf, Add(1183, Multiply(CAD_Bool_Clip.n, 2)), CAD_Store.Read(CAD_Bool_Clip.v, 1))
                                    CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
                                }
                                CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
                                IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                            }
                            IfCondition GreaterThan(CAD_Bool_Clip.n, 2) ThenBlock: {
                                ArraySet(CAD_Bool_Clip.buf, 1180, 1)
                                ArraySet(CAD_Bool_Clip.buf, 1181, CAD_Bool_Clip.n)
                                ArraySet(CAD_Bool_Clip.buf, 1178, 0)
                            }
                        }
                    }
                }
            }
            CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1178)
            IfCondition NotEqual(CAD_Bool_Clip.face, 0) ThenBlock: {
                CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.face, 3)
            }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 48) ThenBlock: { CAD_Bool_Clip.face = 0 }
        }
        ReturnValue(ArrayGet(CAD_Bool_Clip.buf, 1180))
    }
}

// 1 when (.px,.py) is inside the snapped opening. Boundary is not inside.
Function.CAD_BoolClip.InHole {
    Output: Integer
    Body: {
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1180), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 1160, CAD_Bool_Clip.px)
        ArraySet(CAD_Bool_Clip.buf, 1161, CAD_Bool_Clip.py)
        CAD_Bool_Clip.n = ArrayGet(CAD_Bool_Clip.buf, 1181)
        CAD_Bool_Clip.fg = 0
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, CAD_Bool_Clip.n) {
            CAD_Bool_Clip.ax = ArrayGet(CAD_Bool_Clip.buf, Add(1182, Multiply(CAD_Bool_Clip.g, 2)))
            CAD_Bool_Clip.ay = ArrayGet(CAD_Bool_Clip.buf, Add(1183, Multiply(CAD_Bool_Clip.g, 2)))
            CAD_Bool_Clip.idx = Add(CAD_Bool_Clip.g, 1)
            IfCondition EqualTo(CAD_Bool_Clip.idx, CAD_Bool_Clip.n) ThenBlock: { CAD_Bool_Clip.idx = 0 }
            CAD_Bool_Clip.bx = ArrayGet(CAD_Bool_Clip.buf, Add(1182, Multiply(CAD_Bool_Clip.idx, 2)))
            CAD_Bool_Clip.by = ArrayGet(CAD_Bool_Clip.buf, Add(1183, Multiply(CAD_Bool_Clip.idx, 2)))
            CAD_Bool_Clip.px = ArrayGet(CAD_Bool_Clip.buf, 1160)
            CAD_Bool_Clip.py = ArrayGet(CAD_Bool_Clip.buf, 1161)
            CAD_Bool_Clip.oa = 0
            IfCondition EqualTo(Float_Le(CAD_Bool_Clip.py, CAD_Bool_Clip.ay), 0) ThenBlock: { CAD_Bool_Clip.oa = 1 }
            CAD_Bool_Clip.ob = 0
            IfCondition EqualTo(Float_Le(CAD_Bool_Clip.py, CAD_Bool_Clip.by), 0) ThenBlock: { CAD_Bool_Clip.ob = 1 }
            IfCondition NotEqual(CAD_Bool_Clip.oa, CAD_Bool_Clip.ob) ThenBlock: {
                CAD_Bool_Clip.dx = Float_Sub(CAD_Bool_Clip.bx, CAD_Bool_Clip.ax)
                CAD_Bool_Clip.dy = Float_Sub(CAD_Bool_Clip.by, CAD_Bool_Clip.ay)
                CAD_Bool_Clip.th = Float_Div(Float_Mul(CAD_Bool_Clip.dx, Float_Sub(CAD_Bool_Clip.py, CAD_Bool_Clip.ay)), CAD_Bool_Clip.dy)
                CAD_Bool_Clip.th = Float_Add(CAD_Bool_Clip.th, CAD_Bool_Clip.ax)
                IfCondition EqualTo(Float_Le(CAD_Bool_Clip.th, CAD_Bool_Clip.px), 0) ThenBlock: {
                    CAD_Bool_Clip.oa = CAD_Bool_Clip.fg
                    CAD_Bool_Clip.fg = 1
                    IfCondition EqualTo(CAD_Bool_Clip.oa, 1) ThenBlock: { CAD_Bool_Clip.fg = 0 }
                }
            }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        ReturnValue(CAD_Bool_Clip.fg)
    }
}

// Crossings of coedge buf[1168] with the opening, in XY.
// buf[1270] is 0, 1, 2, or 3 (more than two). Hits are six words at 1271:
// t, x, y, z, sx, sy. t runs from this coedge's origin to its dest.
Function.CAD_BoolClip.CrossGen {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 1270, 0)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1168)
        IfCondition EqualTo(CAD_Bool_Clip.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
        ArraySet(CAD_Bool_Clip.buf, 1340, CAD_Store.Read(CAD_Bool_Clip.v, 0))
        ArraySet(CAD_Bool_Clip.buf, 1341, CAD_Store.Read(CAD_Bool_Clip.v, 1))
        ArraySet(CAD_Bool_Clip.buf, 1342, CAD_Store.Read(CAD_Bool_Clip.v, 2))
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1168)
        CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
        ArraySet(CAD_Bool_Clip.buf, 1343, CAD_Bool_Clip.w1)
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 1343)
        ArraySet(CAD_Bool_Clip.buf, 1344, CAD_Store.Read(CAD_Bool_Clip.w1, 0))
        ArraySet(CAD_Bool_Clip.buf, 1345, CAD_Store.Read(CAD_Bool_Clip.w1, 1))
        ArraySet(CAD_Bool_Clip.buf, 1346, CAD_Store.Read(CAD_Bool_Clip.w1, 2))
        ArraySet(CAD_Bool_Clip.buf, 1347, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1344), ArrayGet(CAD_Bool_Clip.buf, 1340)))
        ArraySet(CAD_Bool_Clip.buf, 1348, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1345), ArrayGet(CAD_Bool_Clip.buf, 1341)))
        ArraySet(CAD_Bool_Clip.buf, 1349, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1346), ArrayGet(CAD_Bool_Clip.buf, 1342)))
        ArraySet(CAD_Bool_Clip.buf, 1293, ArrayGet(CAD_Bool_Clip.buf, 1181))
        ArraySet(CAD_Bool_Clip.buf, 1291, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 1291), ArrayGet(CAD_Bool_Clip.buf, 1293)) {
            CAD_Bool_Clip.idx = Add(ArrayGet(CAD_Bool_Clip.buf, 1291), 1)
            IfCondition EqualTo(CAD_Bool_Clip.idx, ArrayGet(CAD_Bool_Clip.buf, 1293)) ThenBlock: { CAD_Bool_Clip.idx = 0 }
            ArraySet(CAD_Bool_Clip.buf, 1357, ArrayGet(CAD_Bool_Clip.buf, Add(1182, Multiply(ArrayGet(CAD_Bool_Clip.buf, 1291), 2))))
            ArraySet(CAD_Bool_Clip.buf, 1358, ArrayGet(CAD_Bool_Clip.buf, Add(1183, Multiply(ArrayGet(CAD_Bool_Clip.buf, 1291), 2))))
            ArraySet(CAD_Bool_Clip.buf, 1359, ArrayGet(CAD_Bool_Clip.buf, Add(1182, Multiply(CAD_Bool_Clip.idx, 2))))
            ArraySet(CAD_Bool_Clip.buf, 1360, ArrayGet(CAD_Bool_Clip.buf, Add(1183, Multiply(CAD_Bool_Clip.idx, 2))))
            ArraySet(CAD_Bool_Clip.buf, 1363, ArrayGet(CAD_Bool_Clip.buf, 1347))
            ArraySet(CAD_Bool_Clip.buf, 1364, ArrayGet(CAD_Bool_Clip.buf, 1348))
            ArraySet(CAD_Bool_Clip.buf, 1361, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1359), ArrayGet(CAD_Bool_Clip.buf, 1357)))
            ArraySet(CAD_Bool_Clip.buf, 1362, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1360), ArrayGet(CAD_Bool_Clip.buf, 1358)))
            ArraySet(CAD_Bool_Clip.buf, 1350, Float_Sub(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1363), ArrayGet(CAD_Bool_Clip.buf, 1362)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1364), ArrayGet(CAD_Bool_Clip.buf, 1361))))
            ArraySet(CAD_Bool_Clip.buf, 1356, ArrayGet(CAD_Bool_Clip.buf, 1350))
            IfCondition EqualTo(CAD_Num.IsNeg(ArrayGet(CAD_Bool_Clip.buf, 1350)), 1) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 1356, Float_Sub(0, ArrayGet(CAD_Bool_Clip.buf, 1350)))
            }
            IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 1356), 0x3E45798EE2308C3A), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 1365, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1357), ArrayGet(CAD_Bool_Clip.buf, 1340)))
                ArraySet(CAD_Bool_Clip.buf, 1366, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1358), ArrayGet(CAD_Bool_Clip.buf, 1341)))
                ArraySet(CAD_Bool_Clip.buf, 1351, Float_Div(Float_Sub(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1365), ArrayGet(CAD_Bool_Clip.buf, 1362)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1366), ArrayGet(CAD_Bool_Clip.buf, 1361))), ArrayGet(CAD_Bool_Clip.buf, 1350)))
                ArraySet(CAD_Bool_Clip.buf, 1352, Float_Div(Float_Sub(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1365), ArrayGet(CAD_Bool_Clip.buf, 1364)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1366), ArrayGet(CAD_Bool_Clip.buf, 1363))), ArrayGet(CAD_Bool_Clip.buf, 1350)))
                CAD_Bool_Clip.oa = 0
                IfCondition EqualTo(CAD_Num.Le(0x3F947AE147AE147B, ArrayGet(CAD_Bool_Clip.buf, 1351)), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 1351), 0x3FEF5C28F5C28F5C), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.Le(0xBF50624DD2F1A9FC, ArrayGet(CAD_Bool_Clip.buf, 1352)), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 1352), 0x3FF004189374BC6A), 1) ThenBlock: {
                                CAD_Bool_Clip.oa = 1
                            }
                        }
                    }
                }
                IfCondition EqualTo(CAD_Bool_Clip.oa, 1) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 1353, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 1340), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1351), ArrayGet(CAD_Bool_Clip.buf, 1347))))
                    ArraySet(CAD_Bool_Clip.buf, 1354, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 1341), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1351), ArrayGet(CAD_Bool_Clip.buf, 1348))))
                    ArraySet(CAD_Bool_Clip.buf, 1355, Float_Add(ArrayGet(CAD_Bool_Clip.buf, 1342), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1351), ArrayGet(CAD_Bool_Clip.buf, 1349))))
                    ArraySet(CAD_Bool_Clip.buf, 1292, ArrayGet(CAD_Bool_Clip.buf, 1270))
                    CAD_Bool_Clip.ob = 0
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1292), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 1356, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1353), ArrayGet(CAD_Bool_Clip.buf, 1275)))
                        ArraySet(CAD_Bool_Clip.buf, 1365, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1354), ArrayGet(CAD_Bool_Clip.buf, 1276)))
                        ArraySet(CAD_Bool_Clip.buf, 1356, Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1356), ArrayGet(CAD_Bool_Clip.buf, 1356)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1365), ArrayGet(CAD_Bool_Clip.buf, 1365))))
                        IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 1356), 0x3F647AE147AE147B), 1) ThenBlock: { CAD_Bool_Clip.ob = 1 }
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1292), 2) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 1356, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1353), ArrayGet(CAD_Bool_Clip.buf, 1275)))
                        ArraySet(CAD_Bool_Clip.buf, 1365, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1354), ArrayGet(CAD_Bool_Clip.buf, 1276)))
                        ArraySet(CAD_Bool_Clip.buf, 1356, Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1356), ArrayGet(CAD_Bool_Clip.buf, 1356)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1365), ArrayGet(CAD_Bool_Clip.buf, 1365))))
                        IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 1356), 0x3F647AE147AE147B), 1) ThenBlock: { CAD_Bool_Clip.ob = 1 }
                        ArraySet(CAD_Bool_Clip.buf, 1356, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1353), ArrayGet(CAD_Bool_Clip.buf, 1281)))
                        ArraySet(CAD_Bool_Clip.buf, 1365, Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1354), ArrayGet(CAD_Bool_Clip.buf, 1282)))
                        ArraySet(CAD_Bool_Clip.buf, 1356, Float_Add(Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1356), ArrayGet(CAD_Bool_Clip.buf, 1356)), Float_Mul(ArrayGet(CAD_Bool_Clip.buf, 1365), ArrayGet(CAD_Bool_Clip.buf, 1365))))
                        IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 1356), 0x3F647AE147AE147B), 1) ThenBlock: { CAD_Bool_Clip.ob = 1 }
                    }
                    IfCondition EqualTo(CAD_Bool_Clip.ob, 0) ThenBlock: {
                        IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 1292), 2) ThenBlock: {
                            CAD_Bool_Clip.idx = Multiply(ArrayGet(CAD_Bool_Clip.buf, 1292), 6)
                            ArraySet(CAD_Bool_Clip.buf, Add(1271, CAD_Bool_Clip.idx), ArrayGet(CAD_Bool_Clip.buf, 1351))
                            ArraySet(CAD_Bool_Clip.buf, Add(1272, CAD_Bool_Clip.idx), ArrayGet(CAD_Bool_Clip.buf, 1353))
                            ArraySet(CAD_Bool_Clip.buf, Add(1273, CAD_Bool_Clip.idx), ArrayGet(CAD_Bool_Clip.buf, 1354))
                            ArraySet(CAD_Bool_Clip.buf, Add(1274, CAD_Bool_Clip.idx), ArrayGet(CAD_Bool_Clip.buf, 1355))
                            ArraySet(CAD_Bool_Clip.buf, Add(1275, CAD_Bool_Clip.idx), ArrayGet(CAD_Bool_Clip.buf, 1353))
                            ArraySet(CAD_Bool_Clip.buf, Add(1276, CAD_Bool_Clip.idx), ArrayGet(CAD_Bool_Clip.buf, 1354))
                            ArraySet(CAD_Bool_Clip.buf, 1270, Add(ArrayGet(CAD_Bool_Clip.buf, 1292), 1))
                        }
                        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1292), 2) ThenBlock: {
                            ArraySet(CAD_Bool_Clip.buf, 1270, 3)
                        }
                    }
                }
            }
            ArraySet(CAD_Bool_Clip.buf, 1291, Add(ArrayGet(CAD_Bool_Clip.buf, 1291), 1))
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1270), 2) ThenBlock: {
            IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 1277), ArrayGet(CAD_Bool_Clip.buf, 1271)), 1) ThenBlock: {
                CAD_Bool_Clip.g = 0
                WhileLoop LessThan(CAD_Bool_Clip.g, 6) {
                    CAD_Bool_Clip.s0 = ArrayGet(CAD_Bool_Clip.buf, Add(1271, CAD_Bool_Clip.g))
                    ArraySet(CAD_Bool_Clip.buf, Add(1271, CAD_Bool_Clip.g), ArrayGet(CAD_Bool_Clip.buf, Add(1277, CAD_Bool_Clip.g)))
                    ArraySet(CAD_Bool_Clip.buf, Add(1277, CAD_Bool_Clip.g), CAD_Bool_Clip.s0)
                    CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
                }
            }
        }
        ReturnValue(ArrayGet(CAD_Bool_Clip.buf, 1270))
    }
}

// Vertex within 0.25 mm of buf[1370..1372]. Handle in buf[1296], else 0.
Function.CAD_BoolClip.AdoptNear {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 1296, 0)
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.host, 0)
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
            ArraySet(CAD_Bool_Clip.buf, 1373, CAD_Bool_Clip.face)
            CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
            WhileLoop NotEqual(CAD_Bool_Clip.lp, 0) {
                ArraySet(CAD_Bool_Clip.buf, 1374, CAD_Bool_Clip.lp)
                CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
                ArraySet(CAD_Bool_Clip.buf, 1380, CAD_Bool_Clip.ce)
                CAD_Bool_Clip.n = 0
                WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
                    ArraySet(CAD_Bool_Clip.buf, 1375, CAD_Bool_Clip.ce)
                    CAD_Bool_Clip.v = CAD_Store.Read(CAD_Bool_Clip.ce, 5)
                    ArraySet(CAD_Bool_Clip.buf, 1376, CAD_Bool_Clip.v)
                    ArraySet(CAD_Bool_Clip.buf, 1377, CAD_Store.Read(CAD_Bool_Clip.v, 0))
                    CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 1376)
                    ArraySet(CAD_Bool_Clip.buf, 1378, CAD_Store.Read(CAD_Bool_Clip.v, 1))
                    CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 1376)
                    ArraySet(CAD_Bool_Clip.buf, 1379, CAD_Store.Read(CAD_Bool_Clip.v, 2))
                    CAD_Bool_Clip.dx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1377), ArrayGet(CAD_Bool_Clip.buf, 1370))
                    CAD_Bool_Clip.dy = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1378), ArrayGet(CAD_Bool_Clip.buf, 1371))
                    CAD_Bool_Clip.s0 = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1379), ArrayGet(CAD_Bool_Clip.buf, 1372))
                    CAD_Bool_Clip.dot = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.dx), Float_Mul(CAD_Bool_Clip.dy, CAD_Bool_Clip.dy)), Float_Mul(CAD_Bool_Clip.s0, CAD_Bool_Clip.s0))
                    IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Clip.dot, 0x3FB0000000000000), 1) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, 1296, ArrayGet(CAD_Bool_Clip.buf, 1376))
                        ReturnValue(1)
                    }
                    CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1375), 2)
                    IfCondition EqualTo(CAD_Bool_Clip.ce, ArrayGet(CAD_Bool_Clip.buf, 1380)) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                    CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
                    IfCondition GreaterThan(CAD_Bool_Clip.n, 24) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                }
                CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1374), 2)
            }
            CAD_Bool_Clip.face = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1373), 3)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 64) ThenBlock: { CAD_Bool_Clip.face = 0 }
        }
        ReturnValue(0)
    }
}

// Free seam from buf[1530] to buf[1531]. Head buf[1532], tail buf[1533].
Function.CAD_BoolClip.FindSeam {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 1532, 0)
        ArraySet(CAD_Bool_Clip.buf, 1533, 0)
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.host, 0)
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
            ArraySet(CAD_Bool_Clip.buf, 1373, CAD_Bool_Clip.face)
            CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
            WhileLoop NotEqual(CAD_Bool_Clip.lp, 0) {
                ArraySet(CAD_Bool_Clip.buf, 1374, CAD_Bool_Clip.lp)
                CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
                ArraySet(CAD_Bool_Clip.buf, 1380, CAD_Bool_Clip.ce)
                CAD_Bool_Clip.n = 0
                WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
                    ArraySet(CAD_Bool_Clip.buf, 1375, CAD_Bool_Clip.ce)
                    CAD_Bool_Clip.tw = CAD_Store.Read(CAD_Bool_Clip.ce, 1)
                    ArraySet(CAD_Bool_Clip.buf, 1376, CAD_Bool_Clip.tw)
                    IfCondition NotEqual(CAD_Bool_Clip.tw, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.tw, 4), 0) ThenBlock: {
                            CAD_Bool_Clip.tw = ArrayGet(CAD_Bool_Clip.buf, 1376)
                            IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.tw, 5), ArrayGet(CAD_Bool_Clip.buf, 1530)) ThenBlock: {
                                ArraySet(CAD_Bool_Clip.buf, 1532, ArrayGet(CAD_Bool_Clip.buf, 1376))
                                ArraySet(CAD_Bool_Clip.buf, 1378, ArrayGet(CAD_Bool_Clip.buf, 1376))
                                CAD_Bool_Clip.ob = 0
                                WhileLoop LessThan(CAD_Bool_Clip.ob, 16) {
                                    CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1378)
                                    CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
                                    IfCondition EqualTo(CAD_Bool_Clip.w1, ArrayGet(CAD_Bool_Clip.buf, 1531)) ThenBlock: {
                                        ArraySet(CAD_Bool_Clip.buf, 1533, ArrayGet(CAD_Bool_Clip.buf, 1378))
                                        ReturnValue(1)
                                    }
                                    CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1378), 2)
                                    ArraySet(CAD_Bool_Clip.buf, 1378, CAD_Bool_Clip.ce)
                                    IfCondition EqualTo(CAD_Bool_Clip.ce, 0) ThenBlock: { CAD_Bool_Clip.ob = 16 }
                                    CAD_Bool_Clip.ob = Add(CAD_Bool_Clip.ob, 1)
                                }
                            }
                        }
                    }
                    CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1375), 2)
                    IfCondition EqualTo(CAD_Bool_Clip.ce, ArrayGet(CAD_Bool_Clip.buf, 1380)) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                    CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
                    IfCondition GreaterThan(CAD_Bool_Clip.n, 32) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                }
                CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1374), 2)
            }
            CAD_Bool_Clip.face = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1373), 3)
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
            IfCondition GreaterThan(CAD_Bool_Clip.g, 64) ThenBlock: { CAD_Bool_Clip.face = 0 }
        }
        ReturnValue(0)
    }
}

// buf[1540] through buf[1541] take loop buf[1542].
Function.CAD_BoolClip.ChainLoop {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 1378, ArrayGet(CAD_Bool_Clip.buf, 1540))
        CAD_Bool_Clip.ob = 0
        WhileLoop LessThan(CAD_Bool_Clip.ob, 16) {
            CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1378), 4, ArrayGet(CAD_Bool_Clip.buf, 1542))
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1378), ArrayGet(CAD_Bool_Clip.buf, 1541)) ThenBlock: { CAD_Bool_Clip.ob = 16 }
            IfCondition LessThan(CAD_Bool_Clip.ob, 16) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 1378, CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1378), 2))
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1378), 0) ThenBlock: { CAD_Bool_Clip.ob = 16 }
            }
            CAD_Bool_Clip.ob = Add(CAD_Bool_Clip.ob, 1)
        }
        ReturnValue(1)
    }
}

// Split coedge buf[1168] at the two crossings. The middle coedge is buf[1169].
Function.CAD_BoolClip.SplitGen {
    Output: Integer
    Body: {
        IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 1270), 2) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 1370, ArrayGet(CAD_Bool_Clip.buf, 1278))
        ArraySet(CAD_Bool_Clip.buf, 1371, ArrayGet(CAD_Bool_Clip.buf, 1279))
        ArraySet(CAD_Bool_Clip.buf, 1372, ArrayGet(CAD_Bool_Clip.buf, 1280))
        CAD_Bool_Clip.ok = CAD_BoolClip.AdoptNear()
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1296), 0) ThenBlock: {
            ArraySet(CAD_Bool_Clip.pt, 0, ArrayGet(CAD_Bool_Clip.buf, 1278))
            ArraySet(CAD_Bool_Clip.pt, 1, ArrayGet(CAD_Bool_Clip.buf, 1279))
            ArraySet(CAD_Bool_Clip.pt, 2, ArrayGet(CAD_Bool_Clip.buf, 1280))
            CAD_Bool_Clip.nv = CAD_Topo.MakeVertex(CAD_Bool_Clip.pt)
            ArraySet(CAD_Bool_Clip.buf, 1296, CAD_Bool_Clip.nv)
        }
        ArraySet(CAD_Bool_Clip.buf, 1294, ArrayGet(CAD_Bool_Clip.buf, 1296))
        ArraySet(CAD_Bool_Clip.buf, 1370, ArrayGet(CAD_Bool_Clip.buf, 1272))
        ArraySet(CAD_Bool_Clip.buf, 1371, ArrayGet(CAD_Bool_Clip.buf, 1273))
        ArraySet(CAD_Bool_Clip.buf, 1372, ArrayGet(CAD_Bool_Clip.buf, 1274))
        CAD_Bool_Clip.ok = CAD_BoolClip.AdoptNear()
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1296), 0) ThenBlock: {
            ArraySet(CAD_Bool_Clip.pt, 0, ArrayGet(CAD_Bool_Clip.buf, 1272))
            ArraySet(CAD_Bool_Clip.pt, 1, ArrayGet(CAD_Bool_Clip.buf, 1273))
            ArraySet(CAD_Bool_Clip.pt, 2, ArrayGet(CAD_Bool_Clip.buf, 1274))
            CAD_Bool_Clip.nv = CAD_Topo.MakeVertex(CAD_Bool_Clip.pt)
            ArraySet(CAD_Bool_Clip.buf, 1296, CAD_Bool_Clip.nv)
        }
        ArraySet(CAD_Bool_Clip.buf, 1295, ArrayGet(CAD_Bool_Clip.buf, 1296))
        ArraySet(CAD_Bool_Clip.buf, 928, ArrayGet(CAD_Bool_Clip.buf, 1168))
        ArraySet(CAD_Bool_Clip.buf, 931, ArrayGet(CAD_Bool_Clip.buf, 1294))
        CAD_Bool_Clip.ok = CAD_BoolClip.SplitOpen()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 928, ArrayGet(CAD_Bool_Clip.buf, 1168))
        ArraySet(CAD_Bool_Clip.buf, 931, ArrayGet(CAD_Bool_Clip.buf, 1295))
        CAD_Bool_Clip.ok = CAD_BoolClip.SplitOpen()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 1169, ArrayGet(CAD_Bool_Clip.buf, 929))
        ReturnValue(1)
    }
}

// Edge from buf[1530] to buf[1531]. Coedge at 1530 is buf[1532]. Coedge at 1531 is buf[1533].
Function.CAD_BoolClip.Chord {
    Output: Integer
    Body: {
        CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, 1530)
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 1531)
        ArraySet(CAD_Bool_Clip.pt, 0, CAD_Store.Read(CAD_Bool_Clip.w0, 0))
        ArraySet(CAD_Bool_Clip.pt, 1, CAD_Store.Read(CAD_Bool_Clip.w0, 1))
        ArraySet(CAD_Bool_Clip.pt, 2, CAD_Store.Read(CAD_Bool_Clip.w0, 2))
        ArraySet(CAD_Bool_Clip.p1, 0, CAD_Store.Read(CAD_Bool_Clip.w1, 0))
        ArraySet(CAD_Bool_Clip.p1, 1, CAD_Store.Read(CAD_Bool_Clip.w1, 1))
        ArraySet(CAD_Bool_Clip.p1, 2, CAD_Store.Read(CAD_Bool_Clip.w1, 2))
        CAD_Bool_Clip.ok = CAD_Geom.MakeLine(CAD_Bool_Clip.pt, CAD_Bool_Clip.p1)
        ArraySet(CAD_Bool_Clip.buf, 1544, CAD_Bool_Clip.ok)
        CAD_Bool_Clip.w0 = ArrayGet(CAD_Bool_Clip.buf, 1530)
        CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 1531)
        CAD_Bool_Clip.e2 = CAD_Topo.MakeEdge(CAD_Bool_Clip.w0, CAD_Bool_Clip.w1, ArrayGet(CAD_Bool_Clip.buf, 1544))
        ArraySet(CAD_Bool_Clip.buf, 1545, CAD_Bool_Clip.e2)
        CAD_Bool_Clip.g = 0
        IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Clip.e2, 0), ArrayGet(CAD_Bool_Clip.buf, 1530)) ThenBlock: { CAD_Bool_Clip.g = 1 }
        CAD_Bool_Clip.c2 = CAD_Topo.MakeCoedge(ArrayGet(CAD_Bool_Clip.buf, 1545), ArrayGet(CAD_Bool_Clip.buf, 1530), CAD_Bool_Clip.g)
        ArraySet(CAD_Bool_Clip.buf, 1532, CAD_Bool_Clip.c2)
        CAD_Bool_Clip.g = 0
        IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1545), 0), ArrayGet(CAD_Bool_Clip.buf, 1531)) ThenBlock: { CAD_Bool_Clip.g = 1 }
        CAD_Bool_Clip.tw2 = CAD_Topo.MakeCoedge(ArrayGet(CAD_Bool_Clip.buf, 1545), ArrayGet(CAD_Bool_Clip.buf, 1531), CAD_Bool_Clip.g)
        ArraySet(CAD_Bool_Clip.buf, 1533, CAD_Bool_Clip.tw2)
        CAD_Topo.LinkTwins(ArrayGet(CAD_Bool_Clip.buf, 1532), ArrayGet(CAD_Bool_Clip.buf, 1533))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1545), 3, ArrayGet(CAD_Bool_Clip.buf, 1532))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1545), 4, ArrayGet(CAD_Bool_Clip.buf, 1533))
        ReturnValue(1)
    }
}

// buf[1540].next = buf[1541], and the back link.
Function.CAD_BoolClip.LinkCe {
    Output: Integer
    Body: {
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1540), 2, ArrayGet(CAD_Bool_Clip.buf, 1541))
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1541), 3, ArrayGet(CAD_Bool_Clip.buf, 1540))
        ReturnValue(1)
    }
}

// Vertex buf[1575] becomes buf[1557] on every host coedge and line edge.
Function.CAD_BoolClip.Retarget {
    Output: Integer
    Body: {
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.host, 0)
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
        ArraySet(CAD_Bool_Clip.buf, 1379, 0)
        WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
            ArraySet(CAD_Bool_Clip.buf, 1373, CAD_Bool_Clip.face)
            CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
            WhileLoop NotEqual(CAD_Bool_Clip.lp, 0) {
                ArraySet(CAD_Bool_Clip.buf, 1374, CAD_Bool_Clip.lp)
                CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
                ArraySet(CAD_Bool_Clip.buf, 1380, CAD_Bool_Clip.ce)
                ArraySet(CAD_Bool_Clip.buf, 1377, 0)
                WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
                    ArraySet(CAD_Bool_Clip.buf, 1375, CAD_Bool_Clip.ce)
                    IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1375), 5), ArrayGet(CAD_Bool_Clip.buf, 1575)) ThenBlock: {
                        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1375), 5, ArrayGet(CAD_Bool_Clip.buf, 1557))
                    }
                    CAD_Bool_Clip.ea = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1375), 0)
                    ArraySet(CAD_Bool_Clip.buf, 1376, CAD_Bool_Clip.ea)
                    ArraySet(CAD_Bool_Clip.buf, 1378, 0)
                    IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1376), 0), ArrayGet(CAD_Bool_Clip.buf, 1575)) ThenBlock: {
                        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1376), 0, ArrayGet(CAD_Bool_Clip.buf, 1557))
                        ArraySet(CAD_Bool_Clip.buf, 1378, 1)
                    }
                    IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1376), 1), ArrayGet(CAD_Bool_Clip.buf, 1575)) ThenBlock: {
                        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1376), 1, ArrayGet(CAD_Bool_Clip.buf, 1557))
                        ArraySet(CAD_Bool_Clip.buf, 1378, 1)
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1378), 1) ThenBlock: {
                        CAD_Bool_Clip.eb = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1376), 2)
                        ArraySet(CAD_Bool_Clip.buf, 1372, CAD_Bool_Clip.eb)
                        IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 1372), 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1372), 0), 1) ThenBlock: {
                                CAD_Bool_Clip.ea = ArrayGet(CAD_Bool_Clip.buf, 1376)
                                CAD_Bool_Clip.ok = CAD_BoolClip.FixLine()
                            }
                        }
                    }
                    CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1375), 2)
                    IfCondition EqualTo(CAD_Bool_Clip.ce, ArrayGet(CAD_Bool_Clip.buf, 1380)) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                    ArraySet(CAD_Bool_Clip.buf, 1377, Add(ArrayGet(CAD_Bool_Clip.buf, 1377), 1))
                    IfCondition GreaterThan(ArrayGet(CAD_Bool_Clip.buf, 1377), 32) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                }
                CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1374), 2)
            }
            CAD_Bool_Clip.face = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1373), 3)
            ArraySet(CAD_Bool_Clip.buf, 1379, Add(ArrayGet(CAD_Bool_Clip.buf, 1379), 1))
            IfCondition GreaterThan(ArrayGet(CAD_Bool_Clip.buf, 1379), 64) ThenBlock: { CAD_Bool_Clip.face = 0 }
        }
        ReturnValue(1)
    }
}

// buf[1550] onto the free wall seam. A hit within 0.45 mm splits that
// segment and the generator end moves onto the polyline. Already on the
// seam is left alone. A miss leaves the vertex where it is.
Function.CAD_BoolClip.SnapSeam {
    Output: Integer
    Body: {
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1550), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 1550)
        ArraySet(CAD_Bool_Clip.buf, 1551, CAD_Store.Read(CAD_Bool_Clip.v, 0))
        CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 1550)
        ArraySet(CAD_Bool_Clip.buf, 1552, CAD_Store.Read(CAD_Bool_Clip.v, 1))
        CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 1550)
        ArraySet(CAD_Bool_Clip.buf, 1553, CAD_Store.Read(CAD_Bool_Clip.v, 2))
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.host, 0)
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
        ArraySet(CAD_Bool_Clip.buf, 1379, 0)
        WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
            ArraySet(CAD_Bool_Clip.buf, 1373, CAD_Bool_Clip.face)
            CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
            WhileLoop NotEqual(CAD_Bool_Clip.lp, 0) {
                ArraySet(CAD_Bool_Clip.buf, 1374, CAD_Bool_Clip.lp)
                CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
                ArraySet(CAD_Bool_Clip.buf, 1380, CAD_Bool_Clip.ce)
                ArraySet(CAD_Bool_Clip.buf, 1377, 0)
                WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
                    ArraySet(CAD_Bool_Clip.buf, 1375, CAD_Bool_Clip.ce)
                    CAD_Bool_Clip.tw = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1375), 1)
                    ArraySet(CAD_Bool_Clip.buf, 1376, CAD_Bool_Clip.tw)
                    IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 1376), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1376), 4), 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1375), 5), ArrayGet(CAD_Bool_Clip.buf, 1550)) ThenBlock: {
                                ReturnValue(1)
                            }
                            CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1375)
                            CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
                            ArraySet(CAD_Bool_Clip.buf, 1567, CAD_Bool_Clip.w1)
                            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1567), ArrayGet(CAD_Bool_Clip.buf, 1550)) ThenBlock: {
                                ReturnValue(1)
                            }
                        }
                    }
                    CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1375), 2)
                    IfCondition EqualTo(CAD_Bool_Clip.ce, ArrayGet(CAD_Bool_Clip.buf, 1380)) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                    ArraySet(CAD_Bool_Clip.buf, 1377, Add(ArrayGet(CAD_Bool_Clip.buf, 1377), 1))
                    IfCondition GreaterThan(ArrayGet(CAD_Bool_Clip.buf, 1377), 32) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                }
                CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1374), 2)
            }
            CAD_Bool_Clip.face = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1373), 3)
            ArraySet(CAD_Bool_Clip.buf, 1379, Add(ArrayGet(CAD_Bool_Clip.buf, 1379), 1))
            IfCondition GreaterThan(ArrayGet(CAD_Bool_Clip.buf, 1379), 64) ThenBlock: { CAD_Bool_Clip.face = 0 }
        }
        ArraySet(CAD_Bool_Clip.buf, 1554, 0)
        ArraySet(CAD_Bool_Clip.buf, 1555, 0x3FC9EB851EB851EC)
        ArraySet(CAD_Bool_Clip.buf, 1576, 0)
        CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.host, 0)
        CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
        ArraySet(CAD_Bool_Clip.buf, 1379, 0)
        WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
            ArraySet(CAD_Bool_Clip.buf, 1373, CAD_Bool_Clip.face)
            CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
            WhileLoop NotEqual(CAD_Bool_Clip.lp, 0) {
                ArraySet(CAD_Bool_Clip.buf, 1374, CAD_Bool_Clip.lp)
                CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
                ArraySet(CAD_Bool_Clip.buf, 1380, CAD_Bool_Clip.ce)
                ArraySet(CAD_Bool_Clip.buf, 1377, 0)
                WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
                    ArraySet(CAD_Bool_Clip.buf, 1375, CAD_Bool_Clip.ce)
                    CAD_Bool_Clip.tw = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1375), 1)
                    ArraySet(CAD_Bool_Clip.buf, 1376, CAD_Bool_Clip.tw)
                    IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 1376), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1376), 4), 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1376), 2), 0) ThenBlock: {
                                CAD_Bool_Clip.v = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1375), 5)
                                ArraySet(CAD_Bool_Clip.buf, 1564, CAD_Bool_Clip.v)
                                CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 1564)
                                ArraySet(CAD_Bool_Clip.buf, 1558, CAD_Store.Read(CAD_Bool_Clip.v, 0))
                                CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 1564)
                                ArraySet(CAD_Bool_Clip.buf, 1559, CAD_Store.Read(CAD_Bool_Clip.v, 1))
                                CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 1564)
                                ArraySet(CAD_Bool_Clip.buf, 1560, CAD_Store.Read(CAD_Bool_Clip.v, 2))
                                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1375)
                                CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
                                ArraySet(CAD_Bool_Clip.buf, 1567, CAD_Bool_Clip.w1)
                                CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 1567)
                                ArraySet(CAD_Bool_Clip.buf, 1561, CAD_Store.Read(CAD_Bool_Clip.v, 0))
                                CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 1567)
                                ArraySet(CAD_Bool_Clip.buf, 1562, CAD_Store.Read(CAD_Bool_Clip.v, 1))
                                CAD_Bool_Clip.v = ArrayGet(CAD_Bool_Clip.buf, 1567)
                                ArraySet(CAD_Bool_Clip.buf, 1563, CAD_Store.Read(CAD_Bool_Clip.v, 2))
                                CAD_Bool_Clip.ax = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1561), ArrayGet(CAD_Bool_Clip.buf, 1558))
                                CAD_Bool_Clip.ay = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1562), ArrayGet(CAD_Bool_Clip.buf, 1559))
                                CAD_Bool_Clip.bx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1563), ArrayGet(CAD_Bool_Clip.buf, 1560))
                                CAD_Bool_Clip.s0 = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.ax, CAD_Bool_Clip.ax), Float_Mul(CAD_Bool_Clip.ay, CAD_Bool_Clip.ay)), Float_Mul(CAD_Bool_Clip.bx, CAD_Bool_Clip.bx))
                                ArraySet(CAD_Bool_Clip.buf, 1568, CAD_Bool_Clip.s0)
                                ArraySet(CAD_Bool_Clip.buf, 1569, 0)
                                ArraySet(CAD_Bool_Clip.buf, 1593, 0x3FF0000000000000)
                                IfCondition EqualTo(CAD_Num.Le(0x3F50624DD2F1A9FC, ArrayGet(CAD_Bool_Clip.buf, 1568)), 1) ThenBlock: {
                                    CAD_Bool_Clip.ax = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1561), ArrayGet(CAD_Bool_Clip.buf, 1558))
                                    CAD_Bool_Clip.ay = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1562), ArrayGet(CAD_Bool_Clip.buf, 1559))
                                    CAD_Bool_Clip.bx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1563), ArrayGet(CAD_Bool_Clip.buf, 1560))
                                    CAD_Bool_Clip.cx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1551), ArrayGet(CAD_Bool_Clip.buf, 1558))
                                    CAD_Bool_Clip.cy = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1552), ArrayGet(CAD_Bool_Clip.buf, 1559))
                                    CAD_Bool_Clip.dx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1553), ArrayGet(CAD_Bool_Clip.buf, 1560))
                                    CAD_Bool_Clip.s1 = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.cx, CAD_Bool_Clip.ax), Float_Mul(CAD_Bool_Clip.cy, CAD_Bool_Clip.ay)), Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.bx))
                                    ArraySet(CAD_Bool_Clip.buf, 1594, CAD_Bool_Clip.s1)
                                    CAD_Bool_Clip.s1 = ArrayGet(CAD_Bool_Clip.buf, 1594)
                                    CAD_Bool_Clip.s0 = ArrayGet(CAD_Bool_Clip.buf, 1568)
                                    CAD_Bool_Clip.th = Float_Div(CAD_Bool_Clip.s1, CAD_Bool_Clip.s0)
                                    CAD_Bool_Clip.qx = Float_Add(ArrayGet(CAD_Bool_Clip.buf, 1558), Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.ax))
                                    CAD_Bool_Clip.qy = Float_Add(ArrayGet(CAD_Bool_Clip.buf, 1559), Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.ay))
                                    CAD_Bool_Clip.qz = Float_Add(ArrayGet(CAD_Bool_Clip.buf, 1560), Float_Mul(CAD_Bool_Clip.th, CAD_Bool_Clip.bx))
                                    CAD_Bool_Clip.dx = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1551), CAD_Bool_Clip.qx)
                                    CAD_Bool_Clip.dy = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1552), CAD_Bool_Clip.qy)
                                    CAD_Bool_Clip.s2 = Float_Sub(ArrayGet(CAD_Bool_Clip.buf, 1553), CAD_Bool_Clip.qz)
                                    CAD_Bool_Clip.dot = Float_Add(Float_Add(Float_Mul(CAD_Bool_Clip.dx, CAD_Bool_Clip.dx), Float_Mul(CAD_Bool_Clip.dy, CAD_Bool_Clip.dy)), Float_Mul(CAD_Bool_Clip.s2, CAD_Bool_Clip.s2))
                                    ArraySet(CAD_Bool_Clip.buf, 1569, CAD_Bool_Clip.th)
                                    ArraySet(CAD_Bool_Clip.buf, 1590, CAD_Bool_Clip.qx)
                                    ArraySet(CAD_Bool_Clip.buf, 1591, CAD_Bool_Clip.qy)
                                    ArraySet(CAD_Bool_Clip.buf, 1592, CAD_Bool_Clip.qz)
                                    ArraySet(CAD_Bool_Clip.buf, 1593, CAD_Bool_Clip.dot)
                                }
                                IfCondition EqualTo(CAD_Num.Le(0x3F947AE147AE147B, ArrayGet(CAD_Bool_Clip.buf, 1569)), 1) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 1569), 0x3FEF5C28F5C28F5C), 1) ThenBlock: {
                                        IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Clip.buf, 1593), ArrayGet(CAD_Bool_Clip.buf, 1555)), 1) ThenBlock: {
                                            ArraySet(CAD_Bool_Clip.buf, 1555, ArrayGet(CAD_Bool_Clip.buf, 1593))
                                            ArraySet(CAD_Bool_Clip.buf, 1554, ArrayGet(CAD_Bool_Clip.buf, 1375))
                                            ArraySet(CAD_Bool_Clip.buf, 1572, ArrayGet(CAD_Bool_Clip.buf, 1590))
                                            ArraySet(CAD_Bool_Clip.buf, 1573, ArrayGet(CAD_Bool_Clip.buf, 1591))
                                            ArraySet(CAD_Bool_Clip.buf, 1574, ArrayGet(CAD_Bool_Clip.buf, 1592))
                                        }
                                    }
                                }
                            }
                        }
                    }
                    CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1375), 2)
                    IfCondition EqualTo(CAD_Bool_Clip.ce, ArrayGet(CAD_Bool_Clip.buf, 1380)) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                    ArraySet(CAD_Bool_Clip.buf, 1377, Add(ArrayGet(CAD_Bool_Clip.buf, 1377), 1))
                    IfCondition GreaterThan(ArrayGet(CAD_Bool_Clip.buf, 1377), 32) ThenBlock: { CAD_Bool_Clip.ce = 0 }
                }
                CAD_Bool_Clip.lp = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1374), 2)
            }
            CAD_Bool_Clip.face = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1373), 3)
            ArraySet(CAD_Bool_Clip.buf, 1379, Add(ArrayGet(CAD_Bool_Clip.buf, 1379), 1))
            IfCondition GreaterThan(ArrayGet(CAD_Bool_Clip.buf, 1379), 64) ThenBlock: { CAD_Bool_Clip.face = 0 }
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1554), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.pt, 0, ArrayGet(CAD_Bool_Clip.buf, 1572))
        ArraySet(CAD_Bool_Clip.pt, 1, ArrayGet(CAD_Bool_Clip.buf, 1573))
        ArraySet(CAD_Bool_Clip.pt, 2, ArrayGet(CAD_Bool_Clip.buf, 1574))
        CAD_Bool_Clip.nv = CAD_Topo.MakeVertex(CAD_Bool_Clip.pt)
        ArraySet(CAD_Bool_Clip.buf, 1557, CAD_Bool_Clip.nv)
        ArraySet(CAD_Bool_Clip.buf, 928, ArrayGet(CAD_Bool_Clip.buf, 1554))
        ArraySet(CAD_Bool_Clip.buf, 931, ArrayGet(CAD_Bool_Clip.buf, 1557))
        CAD_Bool_Clip.ok = CAD_BoolClip.SplitOpen()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 1575, ArrayGet(CAD_Bool_Clip.buf, 1550))
        CAD_Bool_Clip.ok = CAD_BoolClip.Retarget()
        ArraySet(CAD_Bool_Clip.buf, 1550, ArrayGet(CAD_Bool_Clip.buf, 1557))
        ReturnValue(1)
    }
}

// buf[1524] through buf[1527] share the wall seam when they sit on it.
Function.CAD_BoolClip.SnapFour {
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Clip.buf, 1582, 0)
        WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 1582), 4) {
            ArraySet(CAD_Bool_Clip.buf, 1580, ArrayGet(CAD_Bool_Clip.buf, Add(1524, ArrayGet(CAD_Bool_Clip.buf, 1582))))
            ArraySet(CAD_Bool_Clip.buf, 1550, ArrayGet(CAD_Bool_Clip.buf, 1580))
            CAD_Bool_Clip.ok = CAD_BoolClip.SnapSeam()
            ArraySet(CAD_Bool_Clip.buf, 1581, ArrayGet(CAD_Bool_Clip.buf, 1550))
            ArraySet(CAD_Bool_Clip.buf, 1583, 0)
            WhileLoop LessThan(ArrayGet(CAD_Bool_Clip.buf, 1583), 4) {
                IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, Add(1524, ArrayGet(CAD_Bool_Clip.buf, 1583))), ArrayGet(CAD_Bool_Clip.buf, 1580)) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, Add(1524, ArrayGet(CAD_Bool_Clip.buf, 1583)), ArrayGet(CAD_Bool_Clip.buf, 1581))
                }
                ArraySet(CAD_Bool_Clip.buf, 1583, Add(ArrayGet(CAD_Bool_Clip.buf, 1583), 1))
            }
            ArraySet(CAD_Bool_Clip.buf, 1582, Add(ArrayGet(CAD_Bool_Clip.buf, 1582), 1))
        }
        ReturnValue(1)
    }
}

// Two generator pieces buf[1170] and buf[1171] bound the strip in the opening.
// Each wing keeps the chain between them. The strip is not put on the shell.
Function.CAD_BoolClip.SewStrip {
    Output: Integer
    Body: {
        CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1240)
        ArraySet(CAD_Bool_Clip.buf, 1538, CAD_Store.Read(CAD_Bool_Clip.face, 2))
        ArraySet(CAD_Bool_Clip.buf, 1537, CAD_Store.Read(CAD_Bool_Clip.face, 0))
        CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
        ArraySet(CAD_Bool_Clip.buf, 1536, CAD_Bool_Clip.lp)
        CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
        CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
        CAD_Bool_Clip.n = 0
        WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
            IfCondition LessThan(CAD_Bool_Clip.n, 16) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, Add(1501, CAD_Bool_Clip.n), CAD_Bool_Clip.ce)
                CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
            }
            CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
        }
        ArraySet(CAD_Bool_Clip.buf, 1500, CAD_Bool_Clip.n)
        IfCondition LessThan(CAD_Bool_Clip.n, 4) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 1518, -1)
        ArraySet(CAD_Bool_Clip.buf, 1519, -1)
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, ArrayGet(CAD_Bool_Clip.buf, 1500)) {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, Add(1501, CAD_Bool_Clip.g)), ArrayGet(CAD_Bool_Clip.buf, 1170)) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 1518, CAD_Bool_Clip.g)
            }
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, Add(1501, CAD_Bool_Clip.g)), ArrayGet(CAD_Bool_Clip.buf, 1171)) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 1519, CAD_Bool_Clip.g)
            }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1518), -1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1519), -1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1170)
        ArraySet(CAD_Bool_Clip.buf, 1524, CAD_Store.Read(CAD_Bool_Clip.ce, 5))
        CAD_Bool_Clip.w0 = CAD_BoolClip.Dest()
        ArraySet(CAD_Bool_Clip.buf, 1525, CAD_Bool_Clip.w0)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1171)
        ArraySet(CAD_Bool_Clip.buf, 1526, CAD_Store.Read(CAD_Bool_Clip.ce, 5))
        CAD_Bool_Clip.w0 = CAD_BoolClip.Dest()
        ArraySet(CAD_Bool_Clip.buf, 1527, CAD_Bool_Clip.w0)
        CAD_Bool_Clip.ok = CAD_BoolClip.SnapFour()
        ArraySet(CAD_Bool_Clip.buf, 1528, ArrayGet(CAD_Bool_Clip.buf, Add(1501, Modulo(Add(ArrayGet(CAD_Bool_Clip.buf, 1518), 1), ArrayGet(CAD_Bool_Clip.buf, 1500)))))
        ArraySet(CAD_Bool_Clip.buf, 1529, ArrayGet(CAD_Bool_Clip.buf, Add(1501, Modulo(Add(ArrayGet(CAD_Bool_Clip.buf, 1519), Subtract(ArrayGet(CAD_Bool_Clip.buf, 1500), 1)), ArrayGet(CAD_Bool_Clip.buf, 1500)))))
        ArraySet(CAD_Bool_Clip.buf, 1534, ArrayGet(CAD_Bool_Clip.buf, Add(1501, Modulo(Add(ArrayGet(CAD_Bool_Clip.buf, 1519), 1), ArrayGet(CAD_Bool_Clip.buf, 1500)))))
        ArraySet(CAD_Bool_Clip.buf, 1535, ArrayGet(CAD_Bool_Clip.buf, Add(1501, Modulo(Add(ArrayGet(CAD_Bool_Clip.buf, 1518), Subtract(ArrayGet(CAD_Bool_Clip.buf, 1500), 1)), ArrayGet(CAD_Bool_Clip.buf, 1500)))))
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1528), ArrayGet(CAD_Bool_Clip.buf, 1171)) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1534), ArrayGet(CAD_Bool_Clip.buf, 1170)) ThenBlock: { ReturnValue(0) }
        // Wing A runs 1526 → 1525. That is the free seam back along the
        // wall curve. A miss still gets the straight chord.
        ArraySet(CAD_Bool_Clip.buf, 1546, 0)
        ArraySet(CAD_Bool_Clip.buf, 1547, 0)
        ArraySet(CAD_Bool_Clip.buf, 1530, ArrayGet(CAD_Bool_Clip.buf, 1526))
        ArraySet(CAD_Bool_Clip.buf, 1531, ArrayGet(CAD_Bool_Clip.buf, 1525))
        CAD_Bool_Clip.ok = CAD_BoolClip.FindSeam()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 1521, ArrayGet(CAD_Bool_Clip.buf, 1532))
            ArraySet(CAD_Bool_Clip.buf, 1548, ArrayGet(CAD_Bool_Clip.buf, 1533))
            ArraySet(CAD_Bool_Clip.buf, 1546, 1)
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1546), 0) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 1530, ArrayGet(CAD_Bool_Clip.buf, 1525))
            ArraySet(CAD_Bool_Clip.buf, 1531, ArrayGet(CAD_Bool_Clip.buf, 1526))
            CAD_Bool_Clip.ok = CAD_BoolClip.Chord()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
            ArraySet(CAD_Bool_Clip.buf, 1520, ArrayGet(CAD_Bool_Clip.buf, 1532))
            ArraySet(CAD_Bool_Clip.buf, 1521, ArrayGet(CAD_Bool_Clip.buf, 1533))
            ArraySet(CAD_Bool_Clip.buf, 1548, ArrayGet(CAD_Bool_Clip.buf, 1533))
        }
        // Wing B runs 1524 → 1527.
        ArraySet(CAD_Bool_Clip.buf, 1530, ArrayGet(CAD_Bool_Clip.buf, 1524))
        ArraySet(CAD_Bool_Clip.buf, 1531, ArrayGet(CAD_Bool_Clip.buf, 1527))
        CAD_Bool_Clip.ok = CAD_BoolClip.FindSeam()
        IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 1523, ArrayGet(CAD_Bool_Clip.buf, 1532))
            ArraySet(CAD_Bool_Clip.buf, 1549, ArrayGet(CAD_Bool_Clip.buf, 1533))
            ArraySet(CAD_Bool_Clip.buf, 1547, 1)
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1547), 0) ThenBlock: {
            ArraySet(CAD_Bool_Clip.buf, 1530, ArrayGet(CAD_Bool_Clip.buf, 1527))
            ArraySet(CAD_Bool_Clip.buf, 1531, ArrayGet(CAD_Bool_Clip.buf, 1524))
            CAD_Bool_Clip.ok = CAD_BoolClip.Chord()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 0) ThenBlock: { ReturnValue(0) }
            ArraySet(CAD_Bool_Clip.buf, 1522, ArrayGet(CAD_Bool_Clip.buf, 1532))
            ArraySet(CAD_Bool_Clip.buf, 1523, ArrayGet(CAD_Bool_Clip.buf, 1533))
            ArraySet(CAD_Bool_Clip.buf, 1549, ArrayGet(CAD_Bool_Clip.buf, 1533))
        }
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1528)
        CAD_Bool_Clip.cf = ArrayGet(CAD_Bool_Clip.buf, 1529)
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, 16) {
            CAD_Store.Write(CAD_Bool_Clip.ce, 4, ArrayGet(CAD_Bool_Clip.buf, 1536))
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.g = 16 }
            IfCondition LessThan(CAD_Bool_Clip.g, 16) ThenBlock: { CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2) }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        ArraySet(CAD_Bool_Clip.buf, 1540, ArrayGet(CAD_Bool_Clip.buf, 1529))
        ArraySet(CAD_Bool_Clip.buf, 1541, ArrayGet(CAD_Bool_Clip.buf, 1521))
        CAD_BoolClip.LinkCe()
        ArraySet(CAD_Bool_Clip.buf, 1540, ArrayGet(CAD_Bool_Clip.buf, 1548))
        ArraySet(CAD_Bool_Clip.buf, 1541, ArrayGet(CAD_Bool_Clip.buf, 1528))
        CAD_BoolClip.LinkCe()
        ArraySet(CAD_Bool_Clip.buf, 1540, ArrayGet(CAD_Bool_Clip.buf, 1521))
        ArraySet(CAD_Bool_Clip.buf, 1541, ArrayGet(CAD_Bool_Clip.buf, 1548))
        ArraySet(CAD_Bool_Clip.buf, 1542, ArrayGet(CAD_Bool_Clip.buf, 1536))
        CAD_BoolClip.ChainLoop()
        CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1536), 0, ArrayGet(CAD_Bool_Clip.buf, 1528))
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1534)
        CAD_Bool_Clip.cf = ArrayGet(CAD_Bool_Clip.buf, 1535)
        CAD_Bool_Clip.lp = CAD_Topo.MakeLoop(CAD_Bool_Clip.ce)
        ArraySet(CAD_Bool_Clip.buf, 1539, CAD_Bool_Clip.lp)
        CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1534)
        CAD_Bool_Clip.cf = ArrayGet(CAD_Bool_Clip.buf, 1535)
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, 16) {
            CAD_Store.Write(CAD_Bool_Clip.ce, 4, ArrayGet(CAD_Bool_Clip.buf, 1539))
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.g = 16 }
            IfCondition LessThan(CAD_Bool_Clip.g, 16) ThenBlock: { CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2) }
            CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
        }
        ArraySet(CAD_Bool_Clip.buf, 1540, ArrayGet(CAD_Bool_Clip.buf, 1535))
        ArraySet(CAD_Bool_Clip.buf, 1541, ArrayGet(CAD_Bool_Clip.buf, 1523))
        CAD_BoolClip.LinkCe()
        ArraySet(CAD_Bool_Clip.buf, 1540, ArrayGet(CAD_Bool_Clip.buf, 1549))
        ArraySet(CAD_Bool_Clip.buf, 1541, ArrayGet(CAD_Bool_Clip.buf, 1534))
        CAD_BoolClip.LinkCe()
        ArraySet(CAD_Bool_Clip.buf, 1540, ArrayGet(CAD_Bool_Clip.buf, 1523))
        ArraySet(CAD_Bool_Clip.buf, 1541, ArrayGet(CAD_Bool_Clip.buf, 1549))
        ArraySet(CAD_Bool_Clip.buf, 1542, ArrayGet(CAD_Bool_Clip.buf, 1539))
        CAD_BoolClip.ChainLoop()
        CAD_Bool_Clip.v = CAD_Topo.MakeFace(ArrayGet(CAD_Bool_Clip.buf, 1537), ArrayGet(CAD_Bool_Clip.buf, 1539))
        CAD_Topo.ShellAppendFace(ArrayGet(CAD_Bool_Clip.buf, 1538), CAD_Bool_Clip.v)
        // Both mouths took the wall seam. The straight chords were not built.
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1546), 0) ThenBlock: {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1547), 0) ThenBlock: {
                ArraySet(CAD_Bool_Clip.buf, 1540, ArrayGet(CAD_Bool_Clip.buf, 1170))
                ArraySet(CAD_Bool_Clip.buf, 1541, ArrayGet(CAD_Bool_Clip.buf, 1520))
                CAD_BoolClip.LinkCe()
                ArraySet(CAD_Bool_Clip.buf, 1540, ArrayGet(CAD_Bool_Clip.buf, 1520))
                ArraySet(CAD_Bool_Clip.buf, 1541, ArrayGet(CAD_Bool_Clip.buf, 1171))
                CAD_BoolClip.LinkCe()
                ArraySet(CAD_Bool_Clip.buf, 1540, ArrayGet(CAD_Bool_Clip.buf, 1171))
                ArraySet(CAD_Bool_Clip.buf, 1541, ArrayGet(CAD_Bool_Clip.buf, 1522))
                CAD_BoolClip.LinkCe()
                ArraySet(CAD_Bool_Clip.buf, 1540, ArrayGet(CAD_Bool_Clip.buf, 1522))
                ArraySet(CAD_Bool_Clip.buf, 1541, ArrayGet(CAD_Bool_Clip.buf, 1170))
                CAD_BoolClip.LinkCe()
                CAD_Bool_Clip.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Bool_Clip.buf, 1170))
                CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1170), 4, CAD_Bool_Clip.lp)
                CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1520), 4, CAD_Bool_Clip.lp)
                CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1171), 4, CAD_Bool_Clip.lp)
                CAD_Store.Write(ArrayGet(CAD_Bool_Clip.buf, 1522), 4, CAD_Bool_Clip.lp)
            }
        }
        ReturnValue(1)
    }
}

// Cylinder face buf[1240]. Drop the strip that crosses the snapped opening.
Function.CAD_BoolClip.TrimOne {
    Output: Integer
    Body: {
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1180), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1240)
        IfCondition EqualTo(CAD_Bool_Clip.face, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.face, 0)
        IfCondition EqualTo(CAD_Bool_Clip.eb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Bool_Clip.eb, 0), 2) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
        IfCondition EqualTo(CAD_Bool_Clip.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
        CAD_Bool_Clip.cf = CAD_Bool_Clip.ce
        CAD_Bool_Clip.n = 0
        WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
            CAD_Bool_Clip.ea = CAD_Store.Read(CAD_Bool_Clip.ce, 0)
            CAD_Bool_Clip.fg = 0
            IfCondition NotEqual(CAD_Bool_Clip.ea, 0) ThenBlock: {
                CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.ea, 2)
                IfCondition NotEqual(CAD_Bool_Clip.eb, 0) ThenBlock: {
                    CAD_Bool_Clip.fg = CAD_Store.Read(CAD_Bool_Clip.eb, 0)
                }
            }
            IfCondition EqualTo(CAD_Bool_Clip.fg, 1) ThenBlock: {
                IfCondition LessThan(CAD_Bool_Clip.n, 8) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, Add(1400, CAD_Bool_Clip.n), CAD_Bool_Clip.ce)
                    CAD_Bool_Clip.n = Add(CAD_Bool_Clip.n, 1)
                }
            }
            CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.ce, 2)
            IfCondition EqualTo(CAD_Bool_Clip.ce, CAD_Bool_Clip.cf) ThenBlock: { CAD_Bool_Clip.ce = 0 }
        }
        ArraySet(CAD_Bool_Clip.buf, 1399, CAD_Bool_Clip.n)
        ArraySet(CAD_Bool_Clip.buf, 1398, 0)
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, ArrayGet(CAD_Bool_Clip.buf, 1399)) {
            ArraySet(CAD_Bool_Clip.buf, 1397, CAD_Bool_Clip.g)
            ArraySet(CAD_Bool_Clip.buf, 1168, ArrayGet(CAD_Bool_Clip.buf, Add(1400, CAD_Bool_Clip.g)))
            CAD_Bool_Clip.ok = CAD_BoolClip.CrossGen()
            IfCondition EqualTo(CAD_Bool_Clip.ok, 2) ThenBlock: {
                CAD_Bool_Clip.ok = CAD_BoolClip.SplitGen()
                IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, 1398, 1)
                }
            }
            CAD_Bool_Clip.g = Add(ArrayGet(CAD_Bool_Clip.buf, 1397), 1)
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1398), 0) ThenBlock: {
            IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 1399), 3) ThenBlock: { ReturnValue(0) }
        }
        CAD_Bool_Clip.face = ArrayGet(CAD_Bool_Clip.buf, 1240)
        CAD_Bool_Clip.lp = CAD_Store.Read(CAD_Bool_Clip.face, 1)
        CAD_Bool_Clip.ce = CAD_Store.Read(CAD_Bool_Clip.lp, 0)
        ArraySet(CAD_Bool_Clip.buf, 1395, CAD_Bool_Clip.ce)
        ArraySet(CAD_Bool_Clip.buf, 1394, 0)
        WhileLoop NotEqual(CAD_Bool_Clip.ce, 0) {
            ArraySet(CAD_Bool_Clip.buf, 1396, CAD_Bool_Clip.ce)
            CAD_Bool_Clip.ea = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1396), 0)
            CAD_Bool_Clip.fg = 0
            IfCondition NotEqual(CAD_Bool_Clip.ea, 0) ThenBlock: {
                CAD_Bool_Clip.eb = CAD_Store.Read(CAD_Bool_Clip.ea, 2)
                IfCondition NotEqual(CAD_Bool_Clip.eb, 0) ThenBlock: {
                    CAD_Bool_Clip.fg = CAD_Store.Read(CAD_Bool_Clip.eb, 0)
                }
            }
            IfCondition EqualTo(CAD_Bool_Clip.fg, 1) ThenBlock: {
                CAD_Bool_Clip.v = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1396), 5)
                ArraySet(CAD_Bool_Clip.buf, 1420, CAD_Store.Read(CAD_Bool_Clip.v, 0))
                ArraySet(CAD_Bool_Clip.buf, 1421, CAD_Store.Read(CAD_Bool_Clip.v, 1))
                CAD_Bool_Clip.ce = ArrayGet(CAD_Bool_Clip.buf, 1396)
                CAD_Bool_Clip.w1 = CAD_BoolClip.Dest()
                ArraySet(CAD_Bool_Clip.buf, 1422, CAD_Bool_Clip.w1)
                CAD_Bool_Clip.w1 = ArrayGet(CAD_Bool_Clip.buf, 1422)
                CAD_Bool_Clip.px = Float_Mul(Float_Add(ArrayGet(CAD_Bool_Clip.buf, 1420), CAD_Store.Read(CAD_Bool_Clip.w1, 0)), 0x3FE0000000000000)
                CAD_Bool_Clip.py = Float_Mul(Float_Add(ArrayGet(CAD_Bool_Clip.buf, 1421), CAD_Store.Read(CAD_Bool_Clip.w1, 1)), 0x3FE0000000000000)
                CAD_Bool_Clip.ok = CAD_BoolClip.InHole()
                IfCondition EqualTo(CAD_Bool_Clip.ok, 1) ThenBlock: {
                    IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 1394), 4) ThenBlock: {
                        ArraySet(CAD_Bool_Clip.buf, Add(1410, ArrayGet(CAD_Bool_Clip.buf, 1394)), ArrayGet(CAD_Bool_Clip.buf, 1396))
                        ArraySet(CAD_Bool_Clip.buf, 1394, Add(ArrayGet(CAD_Bool_Clip.buf, 1394), 1))
                    }
                }
            }
            CAD_Bool_Clip.ce = CAD_Store.Read(ArrayGet(CAD_Bool_Clip.buf, 1396), 2)
            IfCondition EqualTo(CAD_Bool_Clip.ce, ArrayGet(CAD_Bool_Clip.buf, 1395)) ThenBlock: { CAD_Bool_Clip.ce = 0 }
        }
        IfCondition NotEqual(ArrayGet(CAD_Bool_Clip.buf, 1394), 2) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 1170, ArrayGet(CAD_Bool_Clip.buf, 1410))
        ArraySet(CAD_Bool_Clip.buf, 1171, ArrayGet(CAD_Bool_Clip.buf, 1411))
        CAD_Bool_Clip.ok = CAD_BoolClip.SewStrip()
        ReturnValue(CAD_Bool_Clip.ok)
    }
}

// Every cylinder face on the host and on the tool.
Function.CAD_BoolClip.TrimVoid {
    Output: Integer
    Body: {
        IfCondition EqualTo(ArrayGet(CAD_Bool_Clip.buf, 1180), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Clip.buf, 1600, 0)
        CAD_Bool_Clip.ob = 0
        WhileLoop LessThan(CAD_Bool_Clip.ob, 2) {
            CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.host, 0)
            IfCondition EqualTo(CAD_Bool_Clip.ob, 1) ThenBlock: {
                CAD_Bool_Clip.sh = CAD_Store.Read(CAD_Bool_Clip.tool, 0)
            }
            CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.sh, 0)
            CAD_Bool_Clip.g = 0
            WhileLoop NotEqual(CAD_Bool_Clip.face, 0) {
                IfCondition LessThan(ArrayGet(CAD_Bool_Clip.buf, 1600), 48) ThenBlock: {
                    ArraySet(CAD_Bool_Clip.buf, Add(1601, ArrayGet(CAD_Bool_Clip.buf, 1600)), CAD_Bool_Clip.face)
                    ArraySet(CAD_Bool_Clip.buf, 1600, Add(ArrayGet(CAD_Bool_Clip.buf, 1600), 1))
                }
                CAD_Bool_Clip.face = CAD_Store.Read(CAD_Bool_Clip.face, 3)
                CAD_Bool_Clip.g = Add(CAD_Bool_Clip.g, 1)
                IfCondition GreaterThan(CAD_Bool_Clip.g, 64) ThenBlock: { CAD_Bool_Clip.face = 0 }
            }
            CAD_Bool_Clip.ob = Add(CAD_Bool_Clip.ob, 1)
        }
        CAD_Bool_Clip.g = 0
        WhileLoop LessThan(CAD_Bool_Clip.g, ArrayGet(CAD_Bool_Clip.buf, 1600)) {
            ArraySet(CAD_Bool_Clip.buf, 1599, CAD_Bool_Clip.g)
            ArraySet(CAD_Bool_Clip.buf, 1240, ArrayGet(CAD_Bool_Clip.buf, Add(1601, CAD_Bool_Clip.g)))
            CAD_BoolClip.TrimOne()
            CAD_Bool_Clip.g = Add(ArrayGet(CAD_Bool_Clip.buf, 1599), 1)
        }
        ReturnValue(1)
    }
}
