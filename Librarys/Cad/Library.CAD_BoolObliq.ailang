// Oblique prism punch. Same Difference path as a face-normal cut.
// When neither cap lies on a host face, a single cylinder tool still
// subtracts: each planar face it meets becomes an elliptical hole, and
// the cylinder wall is sewn from an enter hit to the next exit hit.
// One hit, with the other cap inside the solid, closes on that cap.
// A tool that is not one cylinder still returns 0.
// An ellipse that leaves a face is still skipped.
//
// Hit buffer (arr, 2048 bytes, slots 0..253):
//   0 count
//   1..3 axis point C   4..6 unit axis A
//   7..9 Xc   10..12 Yc   13 radius
//   14 t_lo   15 t_hi
//   hit i at 16+13*i: face, t, Ex,Ey,Ez, Xx,Xy,Xz, Yx,Yy,Yz, rmaj, rmin
//   200..212 candidate    230..245 cos/sin of k*45 deg
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_BoolClip

// Normalize arr[base..base+2]. base is parked in .n. Returns 0 if tiny.
Function.CAD_Bool.PunchObUnit {
    Input: base_i: Integer
    Output: Integer
    Body: {
        CAD_Bool_Punch.fg = base_i
        CAD_Bool_Punch.n = CAD_Bool_Punch.fg
        CAD_Bool_Punch.qx = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        CAD_Bool_Punch.qy = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        CAD_Bool_Punch.qz = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.dist = Float_Mul(CAD_Bool_Punch.qx, CAD_Bool_Punch.qx)
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.qy, CAD_Bool_Punch.qy))
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.qz, CAD_Bool_Punch.qz))
        CAD_Bool_Punch.dot = CAD_Num.Sqrt(CAD_Bool_Punch.dist)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Punch.dot, 0x3F1A36E2EB1C432D), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.qx = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.fg)
        CAD_Bool_Punch.qy = ArrayGet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.fg, 1))
        CAD_Bool_Punch.qz = ArrayGet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.fg, 2))
        CAD_Bool_Punch.qx = Float_Div(CAD_Bool_Punch.qx, CAD_Bool_Punch.dot)
        CAD_Bool_Punch.qy = Float_Div(CAD_Bool_Punch.qy, CAD_Bool_Punch.dot)
        CAD_Bool_Punch.qz = Float_Div(CAD_Bool_Punch.qz, CAD_Bool_Punch.dot)
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.fg, CAD_Bool_Punch.qx)
        ArraySet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.fg, 1), CAD_Bool_Punch.qy)
        ArraySet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.fg, 2), CAD_Bool_Punch.qz)
        ReturnValue(1)
    }
}

// One cylinder side between the two caps. Header filled. 1 = ok.
Function.CAD_Bool.PunchObCyl {
    Output: Integer
    Body: {
        CAD_Bool_Punch.sh = CAD_Store.Read(CAD_Bool_Punch.tool, 0)
        IfCondition EqualTo(CAD_Bool_Punch.sh, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.face = CAD_Store.Read(CAD_Bool_Punch.sh, 0)
        CAD_Bool_Punch.n = 0
        CAD_Bool_Punch.g = 0
        CAD_Bool_Punch.best = 0
        WhileLoop NotEqual(CAD_Bool_Punch.face, 0) {
            IfCondition GreaterThan(CAD_Bool_Punch.g, 16) ThenBlock: { CAD_Bool_Punch.face = 0 }
            IfCondition NotEqual(CAD_Bool_Punch.face, 0) ThenBlock: {
                CAD_Bool_Punch.ok = 1
                IfCondition EqualTo(CAD_Bool_Punch.face, CAD_Bool_Punch.f0) ThenBlock: { CAD_Bool_Punch.ok = 0 }
                IfCondition EqualTo(CAD_Bool_Punch.face, CAD_Bool_Punch.f1) ThenBlock: { CAD_Bool_Punch.ok = 0 }
                IfCondition EqualTo(CAD_Bool_Punch.ok, 1) ThenBlock: {
                    CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
                    CAD_Bool_Punch.best = CAD_Bool_Punch.face
                }
                CAD_Bool_Punch.face = CAD_Store.Read(CAD_Bool_Punch.face, 3)
            }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        IfCondition NotEqual(CAD_Bool_Punch.n, 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.c0 = CAD_Store.Read(CAD_Bool_Punch.best, 0)
        IfCondition EqualTo(CAD_Bool_Punch.c0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Bool_Punch.c0, 0), 2) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.arr, 1, CAD_Store.Read(CAD_Bool_Punch.c0, 1))
        ArraySet(CAD_Bool_Punch.arr, 2, CAD_Store.Read(CAD_Bool_Punch.c0, 2))
        ArraySet(CAD_Bool_Punch.arr, 3, CAD_Store.Read(CAD_Bool_Punch.c0, 3))
        ArraySet(CAD_Bool_Punch.arr, 4, CAD_Store.Read(CAD_Bool_Punch.c0, 10))
        ArraySet(CAD_Bool_Punch.arr, 5, CAD_Store.Read(CAD_Bool_Punch.c0, 11))
        ArraySet(CAD_Bool_Punch.arr, 6, CAD_Store.Read(CAD_Bool_Punch.c0, 12))
        ArraySet(CAD_Bool_Punch.arr, 7, CAD_Store.Read(CAD_Bool_Punch.c0, 4))
        ArraySet(CAD_Bool_Punch.arr, 8, CAD_Store.Read(CAD_Bool_Punch.c0, 5))
        ArraySet(CAD_Bool_Punch.arr, 9, CAD_Store.Read(CAD_Bool_Punch.c0, 6))
        ArraySet(CAD_Bool_Punch.arr, 10, CAD_Store.Read(CAD_Bool_Punch.c0, 7))
        ArraySet(CAD_Bool_Punch.arr, 11, CAD_Store.Read(CAD_Bool_Punch.c0, 8))
        ArraySet(CAD_Bool_Punch.arr, 12, CAD_Store.Read(CAD_Bool_Punch.c0, 9))
        ArraySet(CAD_Bool_Punch.arr, 13, CAD_Store.Read(CAD_Bool_Punch.c0, 13))
        IfCondition EqualTo(CAD_Bool.PunchObUnit(4), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool.PunchObUnit(7), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool.PunchObUnit(10), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Bool_Punch.f0, CAD_Bool_Punch.pl), 0) ThenBlock: {
            CAD_Bool_Punch.ox = ArrayGet(CAD_Bool_Punch.pl, 1)
            CAD_Bool_Punch.oy = ArrayGet(CAD_Bool_Punch.pl, 2)
            CAD_Bool_Punch.oz = ArrayGet(CAD_Bool_Punch.pl, 3)
            CAD_Bool_Punch.ox = Float_Sub(CAD_Bool_Punch.ox, ArrayGet(CAD_Bool_Punch.arr, 1))
            CAD_Bool_Punch.oy = Float_Sub(CAD_Bool_Punch.oy, ArrayGet(CAD_Bool_Punch.arr, 2))
            CAD_Bool_Punch.oz = Float_Sub(CAD_Bool_Punch.oz, ArrayGet(CAD_Bool_Punch.arr, 3))
            CAD_Bool_Punch.dist = Float_Mul(CAD_Bool_Punch.ox, ArrayGet(CAD_Bool_Punch.arr, 4))
            CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.oy, ArrayGet(CAD_Bool_Punch.arr, 5)))
            CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.oz, ArrayGet(CAD_Bool_Punch.arr, 6)))
            ArraySet(CAD_Bool_Punch.arr, 14, CAD_Bool_Punch.dist)
        }
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Bool_Punch.f0, CAD_Bool_Punch.pl), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Bool_Punch.f1, CAD_Bool_Punch.pl), 0) ThenBlock: {
            CAD_Bool_Punch.ox = ArrayGet(CAD_Bool_Punch.pl, 1)
            CAD_Bool_Punch.oy = ArrayGet(CAD_Bool_Punch.pl, 2)
            CAD_Bool_Punch.oz = ArrayGet(CAD_Bool_Punch.pl, 3)
            CAD_Bool_Punch.ox = Float_Sub(CAD_Bool_Punch.ox, ArrayGet(CAD_Bool_Punch.arr, 1))
            CAD_Bool_Punch.oy = Float_Sub(CAD_Bool_Punch.oy, ArrayGet(CAD_Bool_Punch.arr, 2))
            CAD_Bool_Punch.oz = Float_Sub(CAD_Bool_Punch.oz, ArrayGet(CAD_Bool_Punch.arr, 3))
            CAD_Bool_Punch.dist = Float_Mul(CAD_Bool_Punch.ox, ArrayGet(CAD_Bool_Punch.arr, 4))
            CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.oy, ArrayGet(CAD_Bool_Punch.arr, 5)))
            CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.oz, ArrayGet(CAD_Bool_Punch.arr, 6)))
            ArraySet(CAD_Bool_Punch.arr, 15, CAD_Bool_Punch.dist)
        }
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Bool_Punch.f1, CAD_Bool_Punch.pl), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Punch.arr, 15), ArrayGet(CAD_Bool_Punch.arr, 14)), 1) ThenBlock: {
            CAD_Bool_Punch.dist = ArrayGet(CAD_Bool_Punch.arr, 14)
            ArraySet(CAD_Bool_Punch.arr, 14, ArrayGet(CAD_Bool_Punch.arr, 15))
            ArraySet(CAD_Bool_Punch.arr, 15, CAD_Bool_Punch.dist)
        }
        ArraySet(CAD_Bool_Punch.arr, 0, 0)
        ReturnValue(1)
    }
}

// 1 when all 8 samples of the candidate at 200 lie on .face and inside the caps.
Function.CAD_Bool.PunchObSamples {
    Output: Integer
    Body: {
        CAD_Bool_Punch.g = 0
        WhileLoop LessThan(CAD_Bool_Punch.g, 8) {
            CAD_Bool_Punch.n = Add(230, Multiply(CAD_Bool_Punch.g, 2))
            CAD_Bool_Punch.qx = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
            CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
            CAD_Bool_Punch.qy = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
            CAD_Bool_Punch.px = ArrayGet(CAD_Bool_Punch.arr, 200)
            CAD_Bool_Punch.py = ArrayGet(CAD_Bool_Punch.arr, 201)
            CAD_Bool_Punch.pz = ArrayGet(CAD_Bool_Punch.arr, 202)
            CAD_Bool_Punch.px = Float_Add(CAD_Bool_Punch.px, Float_Mul(CAD_Bool_Punch.qx, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 209), ArrayGet(CAD_Bool_Punch.arr, 203))))
            CAD_Bool_Punch.py = Float_Add(CAD_Bool_Punch.py, Float_Mul(CAD_Bool_Punch.qx, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 209), ArrayGet(CAD_Bool_Punch.arr, 204))))
            CAD_Bool_Punch.pz = Float_Add(CAD_Bool_Punch.pz, Float_Mul(CAD_Bool_Punch.qx, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 209), ArrayGet(CAD_Bool_Punch.arr, 205))))
            CAD_Bool_Punch.px = Float_Add(CAD_Bool_Punch.px, Float_Mul(CAD_Bool_Punch.qy, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 210), ArrayGet(CAD_Bool_Punch.arr, 206))))
            CAD_Bool_Punch.py = Float_Add(CAD_Bool_Punch.py, Float_Mul(CAD_Bool_Punch.qy, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 210), ArrayGet(CAD_Bool_Punch.arr, 207))))
            CAD_Bool_Punch.pz = Float_Add(CAD_Bool_Punch.pz, Float_Mul(CAD_Bool_Punch.qy, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 210), ArrayGet(CAD_Bool_Punch.arr, 208))))
            CAD_Bool_Punch.ox = Float_Sub(CAD_Bool_Punch.px, ArrayGet(CAD_Bool_Punch.arr, 1))
            CAD_Bool_Punch.oy = Float_Sub(CAD_Bool_Punch.py, ArrayGet(CAD_Bool_Punch.arr, 2))
            CAD_Bool_Punch.oz = Float_Sub(CAD_Bool_Punch.pz, ArrayGet(CAD_Bool_Punch.arr, 3))
            CAD_Bool_Punch.dist = Float_Mul(CAD_Bool_Punch.ox, ArrayGet(CAD_Bool_Punch.arr, 4))
            CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.oy, ArrayGet(CAD_Bool_Punch.arr, 5)))
            CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.oz, ArrayGet(CAD_Bool_Punch.arr, 6)))
            CAD_Bool_Punch.dot = Float_Sub(ArrayGet(CAD_Bool_Punch.arr, 14), 0x3FE0000000000000)
            CAD_Bool_Punch.mx = Float_Sub(CAD_Bool_Punch.dist, CAD_Bool_Punch.dot)
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Punch.mx), 1) ThenBlock: { ReturnValue(0) }
            CAD_Bool_Punch.dot = Float_Add(ArrayGet(CAD_Bool_Punch.arr, 15), 0x3FE0000000000000)
            CAD_Bool_Punch.mx = Float_Sub(CAD_Bool_Punch.dot, CAD_Bool_Punch.dist)
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Punch.mx), 1) ThenBlock: { ReturnValue(0) }
            CAD_Bool_Clip.face = CAD_Bool_Punch.face
            CAD_Bool_Clip.px = CAD_Bool_Punch.px
            CAD_Bool_Clip.py = CAD_Bool_Punch.py
            CAD_Bool_Clip.pz = CAD_Bool_Punch.pz
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
            IfCondition NotEqual(CAD_BoolClip.Inn(), 1) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

// Intersect one host plane with the cylinder. Stores a hit when the
// whole ellipse sits on that face, between the caps.
Function.CAD_Bool.PunchObFace {
    Input: face_h: Integer
    Output: Integer
    Body: {
        CAD_Bool_Punch.face = face_h
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Bool_Punch.face, CAD_Bool_Punch.pl), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.nx = ArrayGet(CAD_Bool_Punch.pl, 10)
        CAD_Bool_Punch.ny = ArrayGet(CAD_Bool_Punch.pl, 11)
        CAD_Bool_Punch.nz = ArrayGet(CAD_Bool_Punch.pl, 12)
        CAD_Bool_Punch.ox = ArrayGet(CAD_Bool_Punch.pl, 1)
        CAD_Bool_Punch.oy = ArrayGet(CAD_Bool_Punch.pl, 2)
        CAD_Bool_Punch.oz = ArrayGet(CAD_Bool_Punch.pl, 3)
        CAD_Bool_Punch.dist = Float_Mul(CAD_Bool_Punch.nx, ArrayGet(CAD_Bool_Punch.arr, 4))
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.ny, ArrayGet(CAD_Bool_Punch.arr, 5)))
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.nz, ArrayGet(CAD_Bool_Punch.arr, 6)))
        CAD_Bool_Punch.dot = CAD_Bool_Punch.dist
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Punch.dot), 1) ThenBlock: { CAD_Bool_Punch.dot = Float_Sub(0, CAD_Bool_Punch.dot) }
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Punch.dot, 0x3FA999999999999A), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.qx = Float_Sub(ArrayGet(CAD_Bool_Punch.arr, 1), CAD_Bool_Punch.ox)
        CAD_Bool_Punch.qy = Float_Sub(ArrayGet(CAD_Bool_Punch.arr, 2), CAD_Bool_Punch.oy)
        CAD_Bool_Punch.qz = Float_Sub(ArrayGet(CAD_Bool_Punch.arr, 3), CAD_Bool_Punch.oz)
        CAD_Bool_Punch.mx = Float_Mul(CAD_Bool_Punch.nx, CAD_Bool_Punch.qx)
        CAD_Bool_Punch.mx = Float_Add(CAD_Bool_Punch.mx, Float_Mul(CAD_Bool_Punch.ny, CAD_Bool_Punch.qy))
        CAD_Bool_Punch.mx = Float_Add(CAD_Bool_Punch.mx, Float_Mul(CAD_Bool_Punch.nz, CAD_Bool_Punch.qz))
        CAD_Bool_Punch.mx = Float_Div(Float_Sub(0, CAD_Bool_Punch.mx), CAD_Bool_Punch.dist)
        CAD_Bool_Punch.px = Float_Add(ArrayGet(CAD_Bool_Punch.arr, 1), Float_Mul(CAD_Bool_Punch.mx, ArrayGet(CAD_Bool_Punch.arr, 4)))
        CAD_Bool_Punch.py = Float_Add(ArrayGet(CAD_Bool_Punch.arr, 2), Float_Mul(CAD_Bool_Punch.mx, ArrayGet(CAD_Bool_Punch.arr, 5)))
        CAD_Bool_Punch.pz = Float_Add(ArrayGet(CAD_Bool_Punch.arr, 3), Float_Mul(CAD_Bool_Punch.mx, ArrayGet(CAD_Bool_Punch.arr, 6)))
        CAD_Bool_Punch.qx = Float_Mul(CAD_Bool_Punch.nx, ArrayGet(CAD_Bool_Punch.arr, 7))
        CAD_Bool_Punch.qx = Float_Add(CAD_Bool_Punch.qx, Float_Mul(CAD_Bool_Punch.ny, ArrayGet(CAD_Bool_Punch.arr, 8)))
        CAD_Bool_Punch.qx = Float_Add(CAD_Bool_Punch.qx, Float_Mul(CAD_Bool_Punch.nz, ArrayGet(CAD_Bool_Punch.arr, 9)))
        CAD_Bool_Punch.qx = Float_Div(CAD_Bool_Punch.qx, CAD_Bool_Punch.dist)
        CAD_Bool_Punch.qy = Float_Mul(CAD_Bool_Punch.nx, ArrayGet(CAD_Bool_Punch.arr, 10))
        CAD_Bool_Punch.qy = Float_Add(CAD_Bool_Punch.qy, Float_Mul(CAD_Bool_Punch.ny, ArrayGet(CAD_Bool_Punch.arr, 11)))
        CAD_Bool_Punch.qy = Float_Add(CAD_Bool_Punch.qy, Float_Mul(CAD_Bool_Punch.nz, ArrayGet(CAD_Bool_Punch.arr, 12)))
        CAD_Bool_Punch.qy = Float_Div(CAD_Bool_Punch.qy, CAD_Bool_Punch.dist)
        ArraySet(CAD_Bool_Punch.arr, 203, Float_Sub(ArrayGet(CAD_Bool_Punch.arr, 7), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 4), CAD_Bool_Punch.qx)))
        ArraySet(CAD_Bool_Punch.arr, 204, Float_Sub(ArrayGet(CAD_Bool_Punch.arr, 8), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 5), CAD_Bool_Punch.qx)))
        ArraySet(CAD_Bool_Punch.arr, 205, Float_Sub(ArrayGet(CAD_Bool_Punch.arr, 9), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 6), CAD_Bool_Punch.qx)))
        ArraySet(CAD_Bool_Punch.arr, 206, Float_Sub(ArrayGet(CAD_Bool_Punch.arr, 10), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 4), CAD_Bool_Punch.qy)))
        ArraySet(CAD_Bool_Punch.arr, 207, Float_Sub(ArrayGet(CAD_Bool_Punch.arr, 11), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 5), CAD_Bool_Punch.qy)))
        ArraySet(CAD_Bool_Punch.arr, 208, Float_Sub(ArrayGet(CAD_Bool_Punch.arr, 12), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 6), CAD_Bool_Punch.qy)))
        CAD_Bool_Punch.qx = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 203), ArrayGet(CAD_Bool_Punch.arr, 203))
        CAD_Bool_Punch.qx = Float_Add(CAD_Bool_Punch.qx, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 204), ArrayGet(CAD_Bool_Punch.arr, 204)))
        CAD_Bool_Punch.qx = Float_Add(CAD_Bool_Punch.qx, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 205), ArrayGet(CAD_Bool_Punch.arr, 205)))
        CAD_Bool_Punch.qy = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 206), ArrayGet(CAD_Bool_Punch.arr, 206))
        CAD_Bool_Punch.qy = Float_Add(CAD_Bool_Punch.qy, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 207), ArrayGet(CAD_Bool_Punch.arr, 207)))
        CAD_Bool_Punch.qy = Float_Add(CAD_Bool_Punch.qy, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 208), ArrayGet(CAD_Bool_Punch.arr, 208)))
        CAD_Bool_Punch.n = 203
        CAD_Bool_Punch.qx = CAD_Num.Sqrt(CAD_Bool_Punch.qx)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Punch.qx, 0x3F1A36E2EB1C432D), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.n = 206
        CAD_Bool_Punch.qy = CAD_Num.Sqrt(CAD_Bool_Punch.qy)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Punch.qy, 0x3F1A36E2EB1C432D), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.arr, 203, Float_Div(ArrayGet(CAD_Bool_Punch.arr, 203), CAD_Bool_Punch.qx))
        ArraySet(CAD_Bool_Punch.arr, 204, Float_Div(ArrayGet(CAD_Bool_Punch.arr, 204), CAD_Bool_Punch.qx))
        ArraySet(CAD_Bool_Punch.arr, 205, Float_Div(ArrayGet(CAD_Bool_Punch.arr, 205), CAD_Bool_Punch.qx))
        ArraySet(CAD_Bool_Punch.arr, 206, Float_Div(ArrayGet(CAD_Bool_Punch.arr, 206), CAD_Bool_Punch.qy))
        ArraySet(CAD_Bool_Punch.arr, 207, Float_Div(ArrayGet(CAD_Bool_Punch.arr, 207), CAD_Bool_Punch.qy))
        ArraySet(CAD_Bool_Punch.arr, 208, Float_Div(ArrayGet(CAD_Bool_Punch.arr, 208), CAD_Bool_Punch.qy))
        ArraySet(CAD_Bool_Punch.arr, 209, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 13), CAD_Bool_Punch.qx))
        ArraySet(CAD_Bool_Punch.arr, 210, Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 13), CAD_Bool_Punch.qy))
        ArraySet(CAD_Bool_Punch.arr, 200, CAD_Bool_Punch.px)
        ArraySet(CAD_Bool_Punch.arr, 201, CAD_Bool_Punch.py)
        ArraySet(CAD_Bool_Punch.arr, 202, CAD_Bool_Punch.pz)
        ArraySet(CAD_Bool_Punch.arr, 211, CAD_Bool_Punch.mx)
        IfCondition EqualTo(CAD_Bool.PunchObSamples(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(ArrayGet(CAD_Bool_Punch.arr, 0), 7) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.n = 0
        WhileLoop LessThan(CAD_Bool_Punch.n, ArrayGet(CAD_Bool_Punch.arr, 0)) {
            CAD_Bool_Punch.g = Add(16, Multiply(CAD_Bool_Punch.n, 13))
            IfCondition EqualTo(ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.g), CAD_Bool_Punch.face) ThenBlock: { ReturnValue(0) }
            CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        }
        CAD_Bool_Punch.g = Add(16, Multiply(ArrayGet(CAD_Bool_Punch.arr, 0), 13))
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.g, CAD_Bool_Punch.face)
        ArraySet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.g, 1), ArrayGet(CAD_Bool_Punch.arr, 211))
        CAD_Bool_Punch.n = 0
        WhileLoop LessThan(CAD_Bool_Punch.n, 11) {
            ArraySet(CAD_Bool_Punch.arr, Add(Add(CAD_Bool_Punch.g, 2), CAD_Bool_Punch.n), ArrayGet(CAD_Bool_Punch.arr, Add(200, CAD_Bool_Punch.n)))
            CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        }
        ArraySet(CAD_Bool_Punch.arr, 0, Add(ArrayGet(CAD_Bool_Punch.arr, 0), 1))
        ReturnValue(1)
    }
}

Function.CAD_Bool.PunchObSort {
    Output: Integer
    Body: {
        CAD_Bool_Punch.n = 1
        WhileLoop LessThan(CAD_Bool_Punch.n, ArrayGet(CAD_Bool_Punch.arr, 0)) {
            CAD_Bool_Punch.g = Add(16, Multiply(CAD_Bool_Punch.n, 13))
            CAD_Bool_Punch.dist = ArrayGet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.g, 1))
            CAD_Bool_Punch.ok = 0
            WhileLoop LessThan(CAD_Bool_Punch.ok, 13) {
                ArraySet(CAD_Bool_Punch.arr, Add(180, CAD_Bool_Punch.ok), ArrayGet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.g, CAD_Bool_Punch.ok)))
                CAD_Bool_Punch.ok = Add(CAD_Bool_Punch.ok, 1)
            }
            CAD_Bool_Punch.fg = CAD_Bool_Punch.n
            CAD_Bool_Punch.c1 = 0
            WhileLoop EqualTo(CAD_Bool_Punch.c1, 0) {
                IfCondition GreaterThan(CAD_Bool_Punch.fg, 0) ThenBlock: {
                    CAD_Bool_Punch.g = Add(16, Multiply(Subtract(CAD_Bool_Punch.fg, 1), 13))
                    CAD_Bool_Punch.dot = ArrayGet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.g, 1))
                    IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Punch.dot, CAD_Bool_Punch.dist), 1) ThenBlock: { CAD_Bool_Punch.c1 = 1 }
                    IfCondition EqualTo(CAD_Bool_Punch.c1, 0) ThenBlock: {
                        CAD_Bool_Punch.ok = 0
                        WhileLoop LessThan(CAD_Bool_Punch.ok, 13) {
                            CAD_Bool_Punch.best = Add(16, Multiply(CAD_Bool_Punch.fg, 13))
                            ArraySet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.best, CAD_Bool_Punch.ok), ArrayGet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.g, CAD_Bool_Punch.ok)))
                            CAD_Bool_Punch.ok = Add(CAD_Bool_Punch.ok, 1)
                        }
                        CAD_Bool_Punch.fg = Subtract(CAD_Bool_Punch.fg, 1)
                    }
                }
                IfCondition EqualTo(CAD_Bool_Punch.fg, 0) ThenBlock: { CAD_Bool_Punch.c1 = 1 }
            }
            CAD_Bool_Punch.g = Add(16, Multiply(CAD_Bool_Punch.fg, 13))
            CAD_Bool_Punch.ok = 0
            WhileLoop LessThan(CAD_Bool_Punch.ok, 13) {
                ArraySet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.g, CAD_Bool_Punch.ok), ArrayGet(CAD_Bool_Punch.arr, Add(180, CAD_Bool_Punch.ok)))
                CAD_Bool_Punch.ok = Add(CAD_Bool_Punch.ok, 1)
            }
            CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        }
        ReturnValue(0)
    }
}

// Ellipse hole on hit ia and hit ib, cylinder wall between them.
// ia must be the enter (N.A < 0). Hits stay in arr.
Function.CAD_Bool.PunchObSew {
    Input: ia_i: Integer
    Input: ib_i: Integer
    Output: Integer
    Body: {
        CAD_Bool_Punch.n = Add(16, Multiply(ia_i, 13))
        CAD_Bool_Punch.ok = 0
        WhileLoop LessThan(CAD_Bool_Punch.ok, 13) {
            ArraySet(CAD_Bool_Punch.arr, Add(180, CAD_Bool_Punch.ok), ArrayGet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.n, CAD_Bool_Punch.ok)))
            CAD_Bool_Punch.ok = Add(CAD_Bool_Punch.ok, 1)
        }
        CAD_Bool_Punch.n = Add(16, Multiply(ib_i, 13))
        CAD_Bool_Punch.ok = 0
        WhileLoop LessThan(CAD_Bool_Punch.ok, 13) {
            ArraySet(CAD_Bool_Punch.arr, Add(200, CAD_Bool_Punch.ok), ArrayGet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.n, CAD_Bool_Punch.ok)))
            CAD_Bool_Punch.ok = Add(CAD_Bool_Punch.ok, 1)
        }
        ArraySet(CAD_Bool_Punch.u0, 0, ArrayGet(CAD_Bool_Punch.arr, 182))
        ArraySet(CAD_Bool_Punch.u0, 1, ArrayGet(CAD_Bool_Punch.arr, 183))
        ArraySet(CAD_Bool_Punch.u0, 2, ArrayGet(CAD_Bool_Punch.arr, 184))
        ArraySet(CAD_Bool_Punch.u0, 3, ArrayGet(CAD_Bool_Punch.arr, 185))
        ArraySet(CAD_Bool_Punch.u0, 4, ArrayGet(CAD_Bool_Punch.arr, 186))
        ArraySet(CAD_Bool_Punch.u0, 5, ArrayGet(CAD_Bool_Punch.arr, 187))
        ArraySet(CAD_Bool_Punch.u0, 6, ArrayGet(CAD_Bool_Punch.arr, 188))
        ArraySet(CAD_Bool_Punch.u0, 7, ArrayGet(CAD_Bool_Punch.arr, 189))
        ArraySet(CAD_Bool_Punch.u0, 8, ArrayGet(CAD_Bool_Punch.arr, 190))
        CAD_Bool_Punch.ea = CAD_Geom.MakeEllipse(CAD_Bool_Punch.u0, ArrayGet(CAD_Bool_Punch.arr, 191), ArrayGet(CAD_Bool_Punch.arr, 192))
        IfCondition EqualTo(CAD_Bool_Punch.ea, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.p0, 0, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 182), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 191), ArrayGet(CAD_Bool_Punch.arr, 185))))
        ArraySet(CAD_Bool_Punch.p0, 1, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 183), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 191), ArrayGet(CAD_Bool_Punch.arr, 186))))
        ArraySet(CAD_Bool_Punch.p0, 2, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 184), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 191), ArrayGet(CAD_Bool_Punch.arr, 187))))
        CAD_Bool_Punch.w0 = CAD_Topo.MakeVertex(CAD_Bool_Punch.p0)
        IfCondition EqualTo(CAD_Bool_Punch.w0, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ha = CAD_Topo.MakeEdge(CAD_Bool_Punch.w0, CAD_Bool_Punch.w0, CAD_Bool_Punch.ea)
        IfCondition EqualTo(CAD_Bool_Punch.ha, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.u0, 0, ArrayGet(CAD_Bool_Punch.arr, 202))
        ArraySet(CAD_Bool_Punch.u0, 1, ArrayGet(CAD_Bool_Punch.arr, 203))
        ArraySet(CAD_Bool_Punch.u0, 2, ArrayGet(CAD_Bool_Punch.arr, 204))
        ArraySet(CAD_Bool_Punch.u0, 3, ArrayGet(CAD_Bool_Punch.arr, 205))
        ArraySet(CAD_Bool_Punch.u0, 4, ArrayGet(CAD_Bool_Punch.arr, 206))
        ArraySet(CAD_Bool_Punch.u0, 5, ArrayGet(CAD_Bool_Punch.arr, 207))
        ArraySet(CAD_Bool_Punch.u0, 6, ArrayGet(CAD_Bool_Punch.arr, 208))
        ArraySet(CAD_Bool_Punch.u0, 7, ArrayGet(CAD_Bool_Punch.arr, 209))
        ArraySet(CAD_Bool_Punch.u0, 8, ArrayGet(CAD_Bool_Punch.arr, 210))
        CAD_Bool_Punch.eb = CAD_Geom.MakeEllipse(CAD_Bool_Punch.u0, ArrayGet(CAD_Bool_Punch.arr, 211), ArrayGet(CAD_Bool_Punch.arr, 212))
        IfCondition EqualTo(CAD_Bool_Punch.eb, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.p1, 0, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 202), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 211), ArrayGet(CAD_Bool_Punch.arr, 205))))
        ArraySet(CAD_Bool_Punch.p1, 1, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 203), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 211), ArrayGet(CAD_Bool_Punch.arr, 206))))
        ArraySet(CAD_Bool_Punch.p1, 2, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 204), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 211), ArrayGet(CAD_Bool_Punch.arr, 207))))
        CAD_Bool_Punch.w1 = CAD_Topo.MakeVertex(CAD_Bool_Punch.p1)
        IfCondition EqualTo(CAD_Bool_Punch.w1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.hb = CAD_Topo.MakeEdge(CAD_Bool_Punch.w1, CAD_Bool_Punch.w1, CAD_Bool_Punch.eb)
        IfCondition EqualTo(CAD_Bool_Punch.hb, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.sa = CAD_Geom.MakeLine(CAD_Bool_Punch.p0, CAD_Bool_Punch.p1)
        IfCondition EqualTo(CAD_Bool_Punch.sa, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.sb = CAD_Topo.MakeEdge(CAD_Bool_Punch.w0, CAD_Bool_Punch.w1, CAD_Bool_Punch.sa)
        IfCondition EqualTo(CAD_Bool_Punch.sb, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.c2 = CAD_Topo.MakeCoedge(CAD_Bool_Punch.ha, CAD_Bool_Punch.w0, 1)
        CAD_Bool_Punch.c3 = CAD_Topo.MakeCoedge(CAD_Bool_Punch.ha, CAD_Bool_Punch.w0, 0)
        CAD_Topo.LinkTwins(CAD_Bool_Punch.c2, CAD_Bool_Punch.c3)
        CAD_Store.Write(CAD_Bool_Punch.ha, 3, CAD_Bool_Punch.c2)
        CAD_Store.Write(CAD_Bool_Punch.ha, 4, CAD_Bool_Punch.c3)
        CAD_Bool_Punch.ea = CAD_Topo.MakeCoedge(CAD_Bool_Punch.hb, CAD_Bool_Punch.w1, 0)
        CAD_Bool_Punch.eb = CAD_Topo.MakeCoedge(CAD_Bool_Punch.hb, CAD_Bool_Punch.w1, 1)
        CAD_Topo.LinkTwins(CAD_Bool_Punch.ea, CAD_Bool_Punch.eb)
        CAD_Store.Write(CAD_Bool_Punch.hb, 3, CAD_Bool_Punch.ea)
        CAD_Store.Write(CAD_Bool_Punch.hb, 4, CAD_Bool_Punch.eb)
        CAD_Bool_Punch.fg = CAD_Topo.MakeCoedge(CAD_Bool_Punch.sb, CAD_Bool_Punch.w0, 1)
        CAD_Bool_Punch.best = CAD_Topo.MakeCoedge(CAD_Bool_Punch.sb, CAD_Bool_Punch.w1, 0)
        CAD_Topo.LinkTwins(CAD_Bool_Punch.fg, CAD_Bool_Punch.best)
        CAD_Store.Write(CAD_Bool_Punch.sb, 3, CAD_Bool_Punch.fg)
        CAD_Store.Write(CAD_Bool_Punch.sb, 4, CAD_Bool_Punch.best)
        CAD_Bool_Punch.lp = CAD_Topo.MakeLoop(CAD_Bool_Punch.c3)
        ArraySet(CAD_Bool_Punch.u1, 0, CAD_Bool_Punch.c3)
        CAD_Topo.LinkLoopRing(CAD_Bool_Punch.u1, 1, CAD_Bool_Punch.lp)
        CAD_Topo.FaceAppendLoop(ArrayGet(CAD_Bool_Punch.arr, 180), CAD_Bool_Punch.lp)
        CAD_Bool_Punch.lp = CAD_Topo.MakeLoop(CAD_Bool_Punch.eb)
        ArraySet(CAD_Bool_Punch.u1, 0, CAD_Bool_Punch.eb)
        CAD_Topo.LinkLoopRing(CAD_Bool_Punch.u1, 1, CAD_Bool_Punch.lp)
        CAD_Topo.FaceAppendLoop(ArrayGet(CAD_Bool_Punch.arr, 200), CAD_Bool_Punch.lp)
        CAD_Bool_Punch.lp = CAD_Topo.MakeLoop(CAD_Bool_Punch.c2)
        ArraySet(CAD_Bool_Punch.u1, 0, CAD_Bool_Punch.c2)
        ArraySet(CAD_Bool_Punch.u1, 1, CAD_Bool_Punch.fg)
        ArraySet(CAD_Bool_Punch.u1, 2, CAD_Bool_Punch.ea)
        ArraySet(CAD_Bool_Punch.u1, 3, CAD_Bool_Punch.best)
        CAD_Topo.LinkLoopRing(CAD_Bool_Punch.u1, 4, CAD_Bool_Punch.lp)
        CAD_Bool_Punch.face = CAD_Topo.MakeFace(CAD_Bool_Punch.c0, CAD_Bool_Punch.lp)
        IfCondition EqualTo(CAD_Bool_Punch.face, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.sh = CAD_Store.Read(CAD_Bool_Punch.host, 0)
        CAD_Topo.ShellAppendFace(CAD_Bool_Punch.sh, CAD_Bool_Punch.face)
        ReturnValue(1)
    }
}

// 1 when the cap circle at arr[213] (axial t) lies inside the host.
Function.CAD_Bool.PunchObCapIn {
    Output: Integer
    Body: {
        CAD_Bool_Punch.px = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 213), ArrayGet(CAD_Bool_Punch.arr, 4))
        CAD_Bool_Punch.py = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 213), ArrayGet(CAD_Bool_Punch.arr, 5))
        CAD_Bool_Punch.pz = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 213), ArrayGet(CAD_Bool_Punch.arr, 6))
        ArraySet(CAD_Bool_Punch.p0, 0, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 1), CAD_Bool_Punch.px))
        ArraySet(CAD_Bool_Punch.p0, 1, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 2), CAD_Bool_Punch.py))
        ArraySet(CAD_Bool_Punch.p0, 2, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 3), CAD_Bool_Punch.pz))
        IfCondition NotEqual(CAD_Topo.PointInSolid(CAD_Bool_Punch.host, CAD_Bool_Punch.p0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.g = 0
        WhileLoop LessThan(CAD_Bool_Punch.g, 4) {
            CAD_Bool_Punch.n = Add(230, Multiply(CAD_Bool_Punch.g, 4))
            CAD_Bool_Punch.qx = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
            CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
            CAD_Bool_Punch.qy = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
            CAD_Bool_Punch.px = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 213), ArrayGet(CAD_Bool_Punch.arr, 4))
            CAD_Bool_Punch.py = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 213), ArrayGet(CAD_Bool_Punch.arr, 5))
            CAD_Bool_Punch.pz = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 213), ArrayGet(CAD_Bool_Punch.arr, 6))
            CAD_Bool_Punch.px = Float_Add(ArrayGet(CAD_Bool_Punch.arr, 1), CAD_Bool_Punch.px)
            CAD_Bool_Punch.py = Float_Add(ArrayGet(CAD_Bool_Punch.arr, 2), CAD_Bool_Punch.py)
            CAD_Bool_Punch.pz = Float_Add(ArrayGet(CAD_Bool_Punch.arr, 3), CAD_Bool_Punch.pz)
            CAD_Bool_Punch.ox = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 13), ArrayGet(CAD_Bool_Punch.arr, 7))
            CAD_Bool_Punch.ox = Float_Mul(CAD_Bool_Punch.qx, CAD_Bool_Punch.ox)
            CAD_Bool_Punch.oy = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 13), ArrayGet(CAD_Bool_Punch.arr, 8))
            CAD_Bool_Punch.oy = Float_Mul(CAD_Bool_Punch.qx, CAD_Bool_Punch.oy)
            CAD_Bool_Punch.oz = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 13), ArrayGet(CAD_Bool_Punch.arr, 9))
            CAD_Bool_Punch.oz = Float_Mul(CAD_Bool_Punch.qx, CAD_Bool_Punch.oz)
            CAD_Bool_Punch.mx = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 13), ArrayGet(CAD_Bool_Punch.arr, 10))
            CAD_Bool_Punch.mx = Float_Mul(CAD_Bool_Punch.qy, CAD_Bool_Punch.mx)
            CAD_Bool_Punch.my = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 13), ArrayGet(CAD_Bool_Punch.arr, 11))
            CAD_Bool_Punch.my = Float_Mul(CAD_Bool_Punch.qy, CAD_Bool_Punch.my)
            CAD_Bool_Punch.mz = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 13), ArrayGet(CAD_Bool_Punch.arr, 12))
            CAD_Bool_Punch.mz = Float_Mul(CAD_Bool_Punch.qy, CAD_Bool_Punch.mz)
            CAD_Bool_Punch.ox = Float_Add(CAD_Bool_Punch.ox, CAD_Bool_Punch.mx)
            CAD_Bool_Punch.oy = Float_Add(CAD_Bool_Punch.oy, CAD_Bool_Punch.my)
            CAD_Bool_Punch.oz = Float_Add(CAD_Bool_Punch.oz, CAD_Bool_Punch.mz)
            ArraySet(CAD_Bool_Punch.p0, 0, Float_Add(CAD_Bool_Punch.px, CAD_Bool_Punch.ox))
            ArraySet(CAD_Bool_Punch.p0, 1, Float_Add(CAD_Bool_Punch.py, CAD_Bool_Punch.oy))
            ArraySet(CAD_Bool_Punch.p0, 2, Float_Add(CAD_Bool_Punch.pz, CAD_Bool_Punch.oz))
            IfCondition NotEqual(CAD_Topo.PointInSolid(CAD_Bool_Punch.host, CAD_Bool_Punch.p0), 1) ThenBlock: { ReturnValue(0) }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        ReturnValue(1)
    }
}

// One planar hit. far_i 1: hit is the enter and the floor is the far cap.
// far_i 0: hit is the exit and the floor is the near cap.
// Host is unchanged until both new faces are appended.
Function.CAD_Bool.PunchObBlind {
    Input: hit_i: Integer
    Input: far_i: Integer
    Output: Integer
    Body: {
        ArraySet(CAD_Bool_Punch.arr, 214, far_i)
        CAD_Bool_Punch.n = Add(16, Multiply(hit_i, 13))
        CAD_Bool_Punch.ok = 0
        WhileLoop LessThan(CAD_Bool_Punch.ok, 13) {
            ArraySet(CAD_Bool_Punch.arr, Add(180, CAD_Bool_Punch.ok), ArrayGet(CAD_Bool_Punch.arr, Add(CAD_Bool_Punch.n, CAD_Bool_Punch.ok)))
            CAD_Bool_Punch.ok = Add(CAD_Bool_Punch.ok, 1)
        }
        CAD_Bool_Punch.px = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 213), ArrayGet(CAD_Bool_Punch.arr, 4))
        CAD_Bool_Punch.py = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 213), ArrayGet(CAD_Bool_Punch.arr, 5))
        CAD_Bool_Punch.pz = Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 213), ArrayGet(CAD_Bool_Punch.arr, 6))
        ArraySet(CAD_Bool_Punch.arr, 200, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 1), CAD_Bool_Punch.px))
        ArraySet(CAD_Bool_Punch.arr, 201, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 2), CAD_Bool_Punch.py))
        ArraySet(CAD_Bool_Punch.arr, 202, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 3), CAD_Bool_Punch.pz))
        ArraySet(CAD_Bool_Punch.u0, 0, ArrayGet(CAD_Bool_Punch.arr, 182))
        ArraySet(CAD_Bool_Punch.u0, 1, ArrayGet(CAD_Bool_Punch.arr, 183))
        ArraySet(CAD_Bool_Punch.u0, 2, ArrayGet(CAD_Bool_Punch.arr, 184))
        ArraySet(CAD_Bool_Punch.u0, 3, ArrayGet(CAD_Bool_Punch.arr, 185))
        ArraySet(CAD_Bool_Punch.u0, 4, ArrayGet(CAD_Bool_Punch.arr, 186))
        ArraySet(CAD_Bool_Punch.u0, 5, ArrayGet(CAD_Bool_Punch.arr, 187))
        ArraySet(CAD_Bool_Punch.u0, 6, ArrayGet(CAD_Bool_Punch.arr, 188))
        ArraySet(CAD_Bool_Punch.u0, 7, ArrayGet(CAD_Bool_Punch.arr, 189))
        ArraySet(CAD_Bool_Punch.u0, 8, ArrayGet(CAD_Bool_Punch.arr, 190))
        CAD_Bool_Punch.sa = CAD_Geom.MakeEllipse(CAD_Bool_Punch.u0, ArrayGet(CAD_Bool_Punch.arr, 191), ArrayGet(CAD_Bool_Punch.arr, 192))
        IfCondition EqualTo(CAD_Bool_Punch.sa, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.p0, 0, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 182), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 191), ArrayGet(CAD_Bool_Punch.arr, 185))))
        ArraySet(CAD_Bool_Punch.p0, 1, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 183), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 191), ArrayGet(CAD_Bool_Punch.arr, 186))))
        ArraySet(CAD_Bool_Punch.p0, 2, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 184), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 191), ArrayGet(CAD_Bool_Punch.arr, 187))))
        ArraySet(CAD_Bool_Punch.u0, 0, ArrayGet(CAD_Bool_Punch.arr, 200))
        ArraySet(CAD_Bool_Punch.u0, 1, ArrayGet(CAD_Bool_Punch.arr, 201))
        ArraySet(CAD_Bool_Punch.u0, 2, ArrayGet(CAD_Bool_Punch.arr, 202))
        ArraySet(CAD_Bool_Punch.u0, 3, ArrayGet(CAD_Bool_Punch.arr, 7))
        ArraySet(CAD_Bool_Punch.u0, 4, ArrayGet(CAD_Bool_Punch.arr, 8))
        ArraySet(CAD_Bool_Punch.u0, 5, ArrayGet(CAD_Bool_Punch.arr, 9))
        ArraySet(CAD_Bool_Punch.u0, 6, ArrayGet(CAD_Bool_Punch.arr, 10))
        ArraySet(CAD_Bool_Punch.u0, 7, ArrayGet(CAD_Bool_Punch.arr, 11))
        ArraySet(CAD_Bool_Punch.u0, 8, ArrayGet(CAD_Bool_Punch.arr, 12))
        CAD_Bool_Punch.sb = CAD_Geom.MakeEllipse(CAD_Bool_Punch.u0, ArrayGet(CAD_Bool_Punch.arr, 13), ArrayGet(CAD_Bool_Punch.arr, 13))
        IfCondition EqualTo(CAD_Bool_Punch.sb, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.p1, 0, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 200), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 13), ArrayGet(CAD_Bool_Punch.arr, 7))))
        ArraySet(CAD_Bool_Punch.p1, 1, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 201), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 13), ArrayGet(CAD_Bool_Punch.arr, 8))))
        ArraySet(CAD_Bool_Punch.p1, 2, Float_Add(ArrayGet(CAD_Bool_Punch.arr, 202), Float_Mul(ArrayGet(CAD_Bool_Punch.arr, 13), ArrayGet(CAD_Bool_Punch.arr, 9))))
        IfCondition EqualTo(ArrayGet(CAD_Bool_Punch.arr, 214), 1) ThenBlock: {
            CAD_Bool_Punch.w0 = CAD_Topo.MakeVertex(CAD_Bool_Punch.p0)
            CAD_Bool_Punch.w1 = CAD_Topo.MakeVertex(CAD_Bool_Punch.p1)
            CAD_Bool_Punch.ha = CAD_Topo.MakeEdge(CAD_Bool_Punch.w0, CAD_Bool_Punch.w0, CAD_Bool_Punch.sa)
            CAD_Bool_Punch.hb = CAD_Topo.MakeEdge(CAD_Bool_Punch.w1, CAD_Bool_Punch.w1, CAD_Bool_Punch.sb)
            CAD_Bool_Punch.sa = CAD_Geom.MakeLine(CAD_Bool_Punch.p0, CAD_Bool_Punch.p1)
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Punch.arr, 214), 0) ThenBlock: {
            CAD_Bool_Punch.w0 = CAD_Topo.MakeVertex(CAD_Bool_Punch.p1)
            CAD_Bool_Punch.w1 = CAD_Topo.MakeVertex(CAD_Bool_Punch.p0)
            CAD_Bool_Punch.ha = CAD_Topo.MakeEdge(CAD_Bool_Punch.w0, CAD_Bool_Punch.w0, CAD_Bool_Punch.sb)
            CAD_Bool_Punch.hb = CAD_Topo.MakeEdge(CAD_Bool_Punch.w1, CAD_Bool_Punch.w1, CAD_Bool_Punch.sa)
            CAD_Bool_Punch.sa = CAD_Geom.MakeLine(CAD_Bool_Punch.p1, CAD_Bool_Punch.p0)
        }
        IfCondition EqualTo(CAD_Bool_Punch.w0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.ha, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.hb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.sa, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.sb = CAD_Topo.MakeEdge(CAD_Bool_Punch.w0, CAD_Bool_Punch.w1, CAD_Bool_Punch.sa)
        IfCondition EqualTo(CAD_Bool_Punch.sb, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.c2 = CAD_Topo.MakeCoedge(CAD_Bool_Punch.ha, CAD_Bool_Punch.w0, 1)
        CAD_Bool_Punch.c3 = CAD_Topo.MakeCoedge(CAD_Bool_Punch.ha, CAD_Bool_Punch.w0, 0)
        CAD_Topo.LinkTwins(CAD_Bool_Punch.c2, CAD_Bool_Punch.c3)
        CAD_Store.Write(CAD_Bool_Punch.ha, 3, CAD_Bool_Punch.c2)
        CAD_Store.Write(CAD_Bool_Punch.ha, 4, CAD_Bool_Punch.c3)
        CAD_Bool_Punch.ea = CAD_Topo.MakeCoedge(CAD_Bool_Punch.hb, CAD_Bool_Punch.w1, 0)
        CAD_Bool_Punch.eb = CAD_Topo.MakeCoedge(CAD_Bool_Punch.hb, CAD_Bool_Punch.w1, 1)
        CAD_Topo.LinkTwins(CAD_Bool_Punch.ea, CAD_Bool_Punch.eb)
        CAD_Store.Write(CAD_Bool_Punch.hb, 3, CAD_Bool_Punch.ea)
        CAD_Store.Write(CAD_Bool_Punch.hb, 4, CAD_Bool_Punch.eb)
        CAD_Bool_Punch.fg = CAD_Topo.MakeCoedge(CAD_Bool_Punch.sb, CAD_Bool_Punch.w0, 1)
        CAD_Bool_Punch.best = CAD_Topo.MakeCoedge(CAD_Bool_Punch.sb, CAD_Bool_Punch.w1, 0)
        CAD_Topo.LinkTwins(CAD_Bool_Punch.fg, CAD_Bool_Punch.best)
        CAD_Store.Write(CAD_Bool_Punch.sb, 3, CAD_Bool_Punch.fg)
        CAD_Store.Write(CAD_Bool_Punch.sb, 4, CAD_Bool_Punch.best)
        ArraySet(CAD_Bool_Punch.u1, 0, ArrayGet(CAD_Bool_Punch.arr, 7))
        ArraySet(CAD_Bool_Punch.u1, 1, ArrayGet(CAD_Bool_Punch.arr, 8))
        ArraySet(CAD_Bool_Punch.u1, 2, ArrayGet(CAD_Bool_Punch.arr, 9))
        ArraySet(CAD_Bool_Punch.u1, 3, ArrayGet(CAD_Bool_Punch.arr, 10))
        ArraySet(CAD_Bool_Punch.u1, 4, ArrayGet(CAD_Bool_Punch.arr, 11))
        ArraySet(CAD_Bool_Punch.u1, 5, ArrayGet(CAD_Bool_Punch.arr, 12))
        // Void is on the opening side of the floor, so the normal points
        // back at the opening: -A when the floor is the far cap.
        IfCondition EqualTo(ArrayGet(CAD_Bool_Punch.arr, 214), 1) ThenBlock: {
            ArraySet(CAD_Bool_Punch.u1, 3, Float_Sub(0, ArrayGet(CAD_Bool_Punch.arr, 10)))
            ArraySet(CAD_Bool_Punch.u1, 4, Float_Sub(0, ArrayGet(CAD_Bool_Punch.arr, 11)))
            ArraySet(CAD_Bool_Punch.u1, 5, Float_Sub(0, ArrayGet(CAD_Bool_Punch.arr, 12)))
        }
        ArraySet(CAD_Bool_Punch.p0, 0, ArrayGet(CAD_Bool_Punch.arr, 200))
        ArraySet(CAD_Bool_Punch.p0, 1, ArrayGet(CAD_Bool_Punch.arr, 201))
        ArraySet(CAD_Bool_Punch.p0, 2, ArrayGet(CAD_Bool_Punch.arr, 202))
        CAD_Bool_Punch.sa = CAD_Geom.MakePlaneAxes(CAD_Bool_Punch.p0, CAD_Bool_Punch.u1, Add(CAD_Bool_Punch.u1, 24))
        IfCondition EqualTo(CAD_Bool_Punch.sa, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Punch.arr, 214), 1) ThenBlock: {
            CAD_Bool_Punch.lp = CAD_Topo.MakeLoop(CAD_Bool_Punch.c3)
            ArraySet(CAD_Bool_Punch.u0, 0, CAD_Bool_Punch.c3)
            CAD_Topo.LinkLoopRing(CAD_Bool_Punch.u0, 1, CAD_Bool_Punch.lp)
            CAD_Topo.FaceAppendLoop(ArrayGet(CAD_Bool_Punch.arr, 180), CAD_Bool_Punch.lp)
            CAD_Bool_Punch.lp = CAD_Topo.MakeLoop(CAD_Bool_Punch.eb)
            ArraySet(CAD_Bool_Punch.u0, 0, CAD_Bool_Punch.eb)
            CAD_Topo.LinkLoopRing(CAD_Bool_Punch.u0, 1, CAD_Bool_Punch.lp)
        }
        IfCondition EqualTo(ArrayGet(CAD_Bool_Punch.arr, 214), 0) ThenBlock: {
            CAD_Bool_Punch.lp = CAD_Topo.MakeLoop(CAD_Bool_Punch.eb)
            ArraySet(CAD_Bool_Punch.u0, 0, CAD_Bool_Punch.eb)
            CAD_Topo.LinkLoopRing(CAD_Bool_Punch.u0, 1, CAD_Bool_Punch.lp)
            CAD_Topo.FaceAppendLoop(ArrayGet(CAD_Bool_Punch.arr, 180), CAD_Bool_Punch.lp)
            CAD_Bool_Punch.lp = CAD_Topo.MakeLoop(CAD_Bool_Punch.c3)
            ArraySet(CAD_Bool_Punch.u0, 0, CAD_Bool_Punch.c3)
            CAD_Topo.LinkLoopRing(CAD_Bool_Punch.u0, 1, CAD_Bool_Punch.lp)
        }
        CAD_Bool_Punch.face = CAD_Topo.MakeFace(CAD_Bool_Punch.sa, CAD_Bool_Punch.lp)
        IfCondition EqualTo(CAD_Bool_Punch.face, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.sh = CAD_Store.Read(CAD_Bool_Punch.host, 0)
        CAD_Topo.ShellAppendFace(CAD_Bool_Punch.sh, CAD_Bool_Punch.face)
        CAD_Bool_Punch.lp = CAD_Topo.MakeLoop(CAD_Bool_Punch.c2)
        ArraySet(CAD_Bool_Punch.u0, 0, CAD_Bool_Punch.c2)
        ArraySet(CAD_Bool_Punch.u0, 1, CAD_Bool_Punch.fg)
        ArraySet(CAD_Bool_Punch.u0, 2, CAD_Bool_Punch.ea)
        ArraySet(CAD_Bool_Punch.u0, 3, CAD_Bool_Punch.best)
        CAD_Topo.LinkLoopRing(CAD_Bool_Punch.u0, 4, CAD_Bool_Punch.lp)
        CAD_Bool_Punch.face = CAD_Topo.MakeFace(CAD_Bool_Punch.c0, CAD_Bool_Punch.lp)
        IfCondition EqualTo(CAD_Bool_Punch.face, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Bool_Punch.sh, CAD_Bool_Punch.face)
        ReturnValue(1)
    }
}

// 1 when hit i is an enter (outward normal against +A).
Function.CAD_Bool.PunchObEnter {
    Input: hit_i: Integer
    Output: Integer
    Body: {
        CAD_Bool_Punch.n = Add(16, Multiply(hit_i, 13))
        CAD_Bool_Punch.face = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Bool_Punch.face, CAD_Bool_Punch.pl), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.dist = Float_Mul(ArrayGet(CAD_Bool_Punch.pl, 10), ArrayGet(CAD_Bool_Punch.arr, 4))
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(ArrayGet(CAD_Bool_Punch.pl, 11), ArrayGet(CAD_Bool_Punch.arr, 5)))
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(ArrayGet(CAD_Bool_Punch.pl, 12), ArrayGet(CAD_Bool_Punch.arr, 6)))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Punch.dist), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.CAD_Bool.PunchOblique {
    Output: Integer
    Body: {
        CAD_Bool_Punch.arr = Allocate(2048)
        IfCondition EqualTo(CAD_Bool_Punch.arr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.pl, 0) ThenBlock: { CAD_Bool_Punch.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Bool_Punch.pl, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.p0 = Allocate(32)
        CAD_Bool_Punch.p1 = Allocate(32)
        CAD_Bool_Punch.u0 = Allocate(128)
        CAD_Bool_Punch.u1 = Allocate(64)
        IfCondition EqualTo(CAD_Bool_Punch.p0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.u0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.u1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_BoolClip.Init(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.qx = 0x3FE6A09E667F3BCD
        ArraySet(CAD_Bool_Punch.arr, 230, 0x3FF0000000000000)
        ArraySet(CAD_Bool_Punch.arr, 231, 0)
        ArraySet(CAD_Bool_Punch.arr, 232, CAD_Bool_Punch.qx)
        ArraySet(CAD_Bool_Punch.arr, 233, CAD_Bool_Punch.qx)
        ArraySet(CAD_Bool_Punch.arr, 234, 0)
        ArraySet(CAD_Bool_Punch.arr, 235, 0x3FF0000000000000)
        ArraySet(CAD_Bool_Punch.arr, 236, Float_Sub(0, CAD_Bool_Punch.qx))
        ArraySet(CAD_Bool_Punch.arr, 237, CAD_Bool_Punch.qx)
        ArraySet(CAD_Bool_Punch.arr, 238, 0xBFF0000000000000)
        ArraySet(CAD_Bool_Punch.arr, 239, 0)
        ArraySet(CAD_Bool_Punch.arr, 240, Float_Sub(0, CAD_Bool_Punch.qx))
        ArraySet(CAD_Bool_Punch.arr, 241, Float_Sub(0, CAD_Bool_Punch.qx))
        ArraySet(CAD_Bool_Punch.arr, 242, 0)
        ArraySet(CAD_Bool_Punch.arr, 243, 0xBFF0000000000000)
        ArraySet(CAD_Bool_Punch.arr, 244, CAD_Bool_Punch.qx)
        ArraySet(CAD_Bool_Punch.arr, 245, Float_Sub(0, CAD_Bool_Punch.qx))
        IfCondition EqualTo(CAD_Bool.PunchObCyl(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.sh = CAD_Store.Read(CAD_Bool_Punch.host, 0)
        CAD_Bool_Punch.face = CAD_Store.Read(CAD_Bool_Punch.sh, 0)
        CAD_Bool_Punch.g = 0
        WhileLoop NotEqual(CAD_Bool_Punch.face, 0) {
            IfCondition GreaterThan(CAD_Bool_Punch.g, 512) ThenBlock: { CAD_Bool_Punch.face = 0 }
            IfCondition NotEqual(CAD_Bool_Punch.face, 0) ThenBlock: {
                CAD_Bool_Punch.best = CAD_Store.Read(CAD_Bool_Punch.face, 3)
                CAD_Bool.PunchObFace(CAD_Bool_Punch.face)
                CAD_Bool_Punch.face = CAD_Bool_Punch.best
            }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        IfCondition LessThan(ArrayGet(CAD_Bool_Punch.arr, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool.PunchObSort()
        ArraySet(CAD_Bool_Punch.arr, 252, 0)
        ArraySet(CAD_Bool_Punch.arr, 253, 0)
        IfCondition GreaterThan(ArrayGet(CAD_Bool_Punch.arr, 0), 1) ThenBlock: {
            WhileLoop LessThan(ArrayGet(CAD_Bool_Punch.arr, 252), Subtract(ArrayGet(CAD_Bool_Punch.arr, 0), 1)) {
                CAD_Bool_Punch.ok = CAD_Bool.PunchObEnter(ArrayGet(CAD_Bool_Punch.arr, 252))
                IfCondition EqualTo(CAD_Bool_Punch.ok, 1) ThenBlock: {
                    CAD_Bool_Punch.g = Add(ArrayGet(CAD_Bool_Punch.arr, 252), 1)
                    CAD_Bool_Punch.ok = CAD_Bool.PunchObEnter(CAD_Bool_Punch.g)
                    IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: {
                        CAD_Bool_Punch.n = ArrayGet(CAD_Bool_Punch.arr, 252)
                        IfCondition EqualTo(CAD_Bool.PunchObSew(CAD_Bool_Punch.n, CAD_Bool_Punch.g), 1) ThenBlock: {
                            ArraySet(CAD_Bool_Punch.arr, 253, Add(ArrayGet(CAD_Bool_Punch.arr, 253), 1))
                            ArraySet(CAD_Bool_Punch.arr, 252, CAD_Bool_Punch.g)
                        }
                    }
                }
                ArraySet(CAD_Bool_Punch.arr, 252, Add(ArrayGet(CAD_Bool_Punch.arr, 252), 1))
            }
        }
        IfCondition LessThan(ArrayGet(CAD_Bool_Punch.arr, 253), 1) ThenBlock: {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Punch.arr, 0), 1) ThenBlock: {
                CAD_Bool_Punch.ok = CAD_Bool.PunchObEnter(0)
                IfCondition EqualTo(CAD_Bool_Punch.ok, 1) ThenBlock: {
                    CAD_Bool_Punch.dist = Float_Add(ArrayGet(CAD_Bool_Punch.arr, 17), 0x3FE0000000000000)
                    IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Punch.arr, 15), CAD_Bool_Punch.dist), 0) ThenBlock: {
                        ArraySet(CAD_Bool_Punch.arr, 213, ArrayGet(CAD_Bool_Punch.arr, 15))
                        IfCondition EqualTo(CAD_Bool.PunchObCapIn(), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Bool.PunchObBlind(0, 1), 1) ThenBlock: {
                                ArraySet(CAD_Bool_Punch.arr, 253, 1)
                            }
                        }
                    }
                }
                IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: {
                    CAD_Bool_Punch.dist = Float_Add(ArrayGet(CAD_Bool_Punch.arr, 14), 0x3FE0000000000000)
                    IfCondition EqualTo(CAD_Num.Le(ArrayGet(CAD_Bool_Punch.arr, 17), CAD_Bool_Punch.dist), 0) ThenBlock: {
                        ArraySet(CAD_Bool_Punch.arr, 213, ArrayGet(CAD_Bool_Punch.arr, 14))
                        IfCondition EqualTo(CAD_Bool.PunchObCapIn(), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Bool.PunchObBlind(0, 0), 1) ThenBlock: {
                                ArraySet(CAD_Bool_Punch.arr, 253, 1)
                            }
                        }
                    }
                }
            }
        }
        IfCondition LessThan(ArrayGet(CAD_Bool_Punch.arr, 253), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Bool_Punch.host)
    }
}
