LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Isect
LibraryImport.Cad.CAD_BoolClip

// Average of one loop's coedge origins. Result in px,py,pz.
Function.CAD_Bool.PunchAvg {
    Input: face_h: Integer
    Output: Integer
    Body: {
        CAD_Bool_Punch.px = 0
        CAD_Bool_Punch.py = 0
        CAD_Bool_Punch.pz = 0
        CAD_Bool_Punch.n = 0
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.lp = CAD_Store.Read(face_h, 1)
        IfCondition EqualTo(CAD_Bool_Punch.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ce = CAD_Store.Read(CAD_Bool_Punch.lp, 0)
        CAD_Bool_Punch.ok = CAD_Bool_Punch.ce
        CAD_Bool_Punch.g = 0
        WhileLoop EqualTo(CAD_Bool_Punch.g, 0) {
            IfCondition EqualTo(CAD_Bool_Punch.ce, 0) ThenBlock: { CAD_Bool_Punch.g = 1 }
            IfCondition EqualTo(CAD_Bool_Punch.g, 0) ThenBlock: {
                CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.ce, 5)
                IfCondition NotEqual(CAD_Bool_Punch.v, 0) ThenBlock: {
                    CAD_Bool_Punch.px = Float_Add(CAD_Bool_Punch.px, CAD_Store.Read(CAD_Bool_Punch.v, 0))
                    CAD_Bool_Punch.py = Float_Add(CAD_Bool_Punch.py, CAD_Store.Read(CAD_Bool_Punch.v, 1))
                    CAD_Bool_Punch.pz = Float_Add(CAD_Bool_Punch.pz, CAD_Store.Read(CAD_Bool_Punch.v, 2))
                    CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
                }
                CAD_Bool_Punch.ce = CAD_Store.Read(CAD_Bool_Punch.ce, 2)
                IfCondition EqualTo(CAD_Bool_Punch.ce, CAD_Bool_Punch.ok) ThenBlock: { CAD_Bool_Punch.g = 1 }
                IfCondition EqualTo(CAD_Bool_Punch.ce, 0) ThenBlock: { CAD_Bool_Punch.g = 1 }
                IfCondition GreaterThan(CAD_Bool_Punch.n, 256) ThenBlock: { CAD_Bool_Punch.g = 1 }
            }
        }
        IfCondition LessThan(CAD_Bool_Punch.n, 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.dist = Float_FromInt(CAD_Bool_Punch.n)
        CAD_Bool_Punch.px = Float_Div(CAD_Bool_Punch.px, CAD_Bool_Punch.dist)
        CAD_Bool_Punch.py = Float_Div(CAD_Bool_Punch.py, CAD_Bool_Punch.dist)
        CAD_Bool_Punch.pz = Float_Div(CAD_Bool_Punch.pz, CAD_Bool_Punch.dist)
        ReturnValue(CAD_Bool_Punch.n)
    }
}

// Host face coplanar with (px,py,pz) and most parallel to (nx,ny,nz).
Function.CAD_Bool.PunchMatch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Bool_Punch.pl, 0) ThenBlock: { CAD_Bool_Punch.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Bool_Punch.pl, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.best = 0
        CAD_Bool_Punch.dot = 0
        CAD_Bool_Punch.sh = CAD_Store.Read(CAD_Bool_Punch.host, 0)
        CAD_Bool_Punch.g = 0
        WhileLoop NotEqual(CAD_Bool_Punch.sh, 0) {
            IfCondition GreaterThan(CAD_Bool_Punch.g, 64) ThenBlock: { CAD_Bool_Punch.sh = 0 }
            IfCondition NotEqual(CAD_Bool_Punch.sh, 0) ThenBlock: {
                CAD_Bool_Punch.face = CAD_Store.Read(CAD_Bool_Punch.sh, 0)
                CAD_Bool_Punch.n = 0
                WhileLoop NotEqual(CAD_Bool_Punch.face, 0) {
                    IfCondition GreaterThan(CAD_Bool_Punch.n, 512) ThenBlock: { CAD_Bool_Punch.face = 0 }
                    IfCondition NotEqual(CAD_Bool_Punch.face, 0) ThenBlock: {
                        CAD_Bool_Punch.v = CAD_Topo.FaceGetPlane(CAD_Bool_Punch.face, CAD_Bool_Punch.pl)
                        IfCondition EqualTo(CAD_Bool_Punch.v, 0) ThenBlock: {
                            CAD_Bool_Punch.ox = ArrayGet(CAD_Bool_Punch.pl, 1)
                            CAD_Bool_Punch.oy = ArrayGet(CAD_Bool_Punch.pl, 2)
                            CAD_Bool_Punch.oz = ArrayGet(CAD_Bool_Punch.pl, 3)
                            CAD_Bool_Punch.dist = Float_Mul(ArrayGet(CAD_Bool_Punch.pl, 10), Float_Sub(CAD_Bool_Punch.px, CAD_Bool_Punch.ox))
                            CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(ArrayGet(CAD_Bool_Punch.pl, 11), Float_Sub(CAD_Bool_Punch.py, CAD_Bool_Punch.oy)))
                            CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(ArrayGet(CAD_Bool_Punch.pl, 12), Float_Sub(CAD_Bool_Punch.pz, CAD_Bool_Punch.oz)))
                            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Punch.dist), 1) ThenBlock: {
                                CAD_Bool_Punch.dist = Float_Sub(0, CAD_Bool_Punch.dist)
                            }
                            IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Punch.dist, 0x3FA999999999999A), 1) ThenBlock: {
                                CAD_Bool_Punch.qx = Float_Mul(ArrayGet(CAD_Bool_Punch.pl, 10), CAD_Bool_Punch.nx)
                                CAD_Bool_Punch.qx = Float_Add(CAD_Bool_Punch.qx, Float_Mul(ArrayGet(CAD_Bool_Punch.pl, 11), CAD_Bool_Punch.ny))
                                CAD_Bool_Punch.qx = Float_Add(CAD_Bool_Punch.qx, Float_Mul(ArrayGet(CAD_Bool_Punch.pl, 12), CAD_Bool_Punch.nz))
                                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Punch.qx), 1) ThenBlock: {
                                    CAD_Bool_Punch.qx = Float_Sub(0, CAD_Bool_Punch.qx)
                                }
                                IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Punch.dot, CAD_Bool_Punch.qx), 1) ThenBlock: {
                                    CAD_Bool_Punch.dot = CAD_Bool_Punch.qx
                                    CAD_Bool_Punch.best = CAD_Bool_Punch.face
                                }
                            }
                        }
                        CAD_Bool_Punch.face = CAD_Store.Read(CAD_Bool_Punch.face, 3)
                    }
                    CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
                }
                CAD_Bool_Punch.sh = CAD_Store.Read(CAD_Bool_Punch.sh, 2)
            }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        IfCondition EqualTo(CAD_Num.Le(0x3FE0000000000000, CAD_Bool_Punch.dot), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Bool_Punch.best)
    }
}

// Destination vertex of coedge .ce. Result in .t0.
Function.CAD_Bool.PunchDest {
    Output: Integer
    Body: {
        CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.ce, 0)
        CAD_Bool_Punch.n = CAD_Store.Read(CAD_Bool_Punch.ce, 5)
        CAD_Bool_Punch.t0 = CAD_Store.Read(CAD_Bool_Punch.v, 1)
        IfCondition EqualTo(CAD_Bool_Punch.n, CAD_Bool_Punch.t0) ThenBlock: {
            CAD_Bool_Punch.t0 = CAD_Store.Read(CAD_Bool_Punch.v, 0)
        }
        ReturnValue(CAD_Bool_Punch.t0)
    }
}

// Coedge on .v starting at .n. Sense follows the edge endpoints.
Function.CAD_Bool.PunchMkCe {
    Output: Integer
    Body: {
        CAD_Bool_Punch.g = 0
        CAD_Bool_Punch.ok = CAD_Store.Read(CAD_Bool_Punch.v, 0)
        IfCondition EqualTo(CAD_Bool_Punch.ok, CAD_Bool_Punch.n) ThenBlock: { CAD_Bool_Punch.g = 1 }
        CAD_Bool_Punch.ce = CAD_Topo.MakeCoedge(CAD_Bool_Punch.v, CAD_Bool_Punch.n, CAD_Bool_Punch.g)
        ReturnValue(CAD_Bool_Punch.ce)
    }
}

// Copy vertex .v into point buffer .n.
Function.CAD_Bool.PunchPut {
    Output: Integer
    Body: {
        CAD_Bool_Punch.px = CAD_Store.Read(CAD_Bool_Punch.v, 0)
        CAD_Bool_Punch.py = CAD_Store.Read(CAD_Bool_Punch.v, 1)
        CAD_Bool_Punch.pz = CAD_Store.Read(CAD_Bool_Punch.v, 2)
        ArraySet(CAD_Bool_Punch.n, 0, CAD_Bool_Punch.px)
        ArraySet(CAD_Bool_Punch.n, 1, CAD_Bool_Punch.py)
        ArraySet(CAD_Bool_Punch.n, 2, CAD_Bool_Punch.pz)
        ReturnValue(0)
    }
}

// 1 when .u0 and .t0 are more than 0.05 mm apart.
Function.CAD_Bool.PunchSep {
    Output: Integer
    Body: {
        CAD_Bool_Punch.px = CAD_Store.Read(CAD_Bool_Punch.u0, 0)
        CAD_Bool_Punch.py = CAD_Store.Read(CAD_Bool_Punch.u0, 1)
        CAD_Bool_Punch.pz = CAD_Store.Read(CAD_Bool_Punch.u0, 2)
        CAD_Bool_Punch.qx = CAD_Store.Read(CAD_Bool_Punch.t0, 0)
        CAD_Bool_Punch.qy = CAD_Store.Read(CAD_Bool_Punch.t0, 1)
        CAD_Bool_Punch.qz = CAD_Store.Read(CAD_Bool_Punch.t0, 2)
        CAD_Bool_Punch.px = Float_Sub(CAD_Bool_Punch.px, CAD_Bool_Punch.qx)
        CAD_Bool_Punch.py = Float_Sub(CAD_Bool_Punch.py, CAD_Bool_Punch.qy)
        CAD_Bool_Punch.pz = Float_Sub(CAD_Bool_Punch.pz, CAD_Bool_Punch.qz)
        CAD_Bool_Punch.dist = Float_Mul(CAD_Bool_Punch.px, CAD_Bool_Punch.px)
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.py, CAD_Bool_Punch.py))
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.pz, CAD_Bool_Punch.pz))
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Punch.dist, 0x3F50624DD2F1A9FC), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Cap .face is a line+circle digon. Sets .ea arc edge, .ce arc coedge, .w0 .w1 ends.
Function.CAD_Bool.PunchDigon {
    Output: Integer
    Body: {
        CAD_Bool_Punch.lp = CAD_Store.Read(CAD_Bool_Punch.face, 1)
        IfCondition EqualTo(CAD_Bool_Punch.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ha = CAD_Store.Read(CAD_Bool_Punch.lp, 0)
        IfCondition EqualTo(CAD_Bool_Punch.ha, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.hb = CAD_Store.Read(CAD_Bool_Punch.ha, 2)
        IfCondition EqualTo(CAD_Bool_Punch.hb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.hb, CAD_Bool_Punch.ha) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ce = CAD_Store.Read(CAD_Bool_Punch.hb, 2)
        IfCondition NotEqual(CAD_Bool_Punch.ce, CAD_Bool_Punch.ha) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ea = 0
        CAD_Bool_Punch.eb = 0
        CAD_Bool_Punch.c0 = 0
        CAD_Bool_Punch.g = 0
        WhileLoop LessThan(CAD_Bool_Punch.g, 2) {
            IfCondition EqualTo(CAD_Bool_Punch.g, 0) ThenBlock: { CAD_Bool_Punch.ce = CAD_Bool_Punch.ha }
            IfCondition EqualTo(CAD_Bool_Punch.g, 1) ThenBlock: { CAD_Bool_Punch.ce = CAD_Bool_Punch.hb }
            CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.ce, 0)
            CAD_Bool_Punch.n = CAD_Store.Read(CAD_Bool_Punch.v, 2)
            CAD_Bool_Punch.ok = 0
            IfCondition NotEqual(CAD_Bool_Punch.n, 0) ThenBlock: {
                CAD_Bool_Punch.ok = CAD_Store.Read(CAD_Bool_Punch.n, 0)
            }
            IfCondition EqualTo(CAD_Bool_Punch.ok, 2) ThenBlock: {
                CAD_Bool_Punch.ea = CAD_Bool_Punch.v
                CAD_Bool_Punch.c0 = CAD_Bool_Punch.ce
            }
            IfCondition EqualTo(CAD_Bool_Punch.ok, 1) ThenBlock: {
                CAD_Bool_Punch.eb = CAD_Bool_Punch.v
            }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        IfCondition EqualTo(CAD_Bool_Punch.ea, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.eb, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.w0 = CAD_Store.Read(CAD_Bool_Punch.ea, 0)
        CAD_Bool_Punch.w1 = CAD_Store.Read(CAD_Bool_Punch.ea, 1)
        CAD_Bool_Punch.ce = CAD_Bool_Punch.c0
        ReturnValue(1)
    }
}

// Outer-loop coedge of .face that contains both .w0 and .w1. Sets .ha .u0 .u1.
Function.CAD_Bool.PunchHostCe {
    Output: Integer
    Body: {
        CAD_Bool_Punch.lp = CAD_Store.Read(CAD_Bool_Punch.face, 1)
        IfCondition EqualTo(CAD_Bool_Punch.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ha = CAD_Store.Read(CAD_Bool_Punch.lp, 0)
        CAD_Bool_Punch.ce = CAD_Bool_Punch.ha
        CAD_Bool_Punch.g = 0
        CAD_Bool_Punch.ok = 0
        WhileLoop LessThan(CAD_Bool_Punch.g, 16) {
            IfCondition EqualTo(CAD_Bool_Punch.ce, 0) ThenBlock: { CAD_Bool_Punch.g = 16 }
            IfCondition NotEqual(CAD_Bool_Punch.ce, 0) ThenBlock: {
                CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.ce, 0)
                CAD_Bool_Punch.n = CAD_Topo.VertOnEdgeLine(CAD_Bool_Punch.v, CAD_Bool_Punch.w0)
                CAD_Bool_Punch.eb = 0
                IfCondition EqualTo(CAD_Bool_Punch.n, 1) ThenBlock: {
                    CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.ce, 0)
                    CAD_Bool_Punch.eb = CAD_Topo.VertOnEdgeLine(CAD_Bool_Punch.v, CAD_Bool_Punch.w1)
                }
                IfCondition EqualTo(CAD_Bool_Punch.eb, 1) ThenBlock: {
                    CAD_Bool_Punch.ok = CAD_Bool_Punch.ce
                    CAD_Bool_Punch.g = 16
                }
                IfCondition NotEqual(CAD_Bool_Punch.g, 16) ThenBlock: {
                    CAD_Bool_Punch.ce = CAD_Store.Read(CAD_Bool_Punch.ce, 2)
                    IfCondition EqualTo(CAD_Bool_Punch.ce, CAD_Bool_Punch.ha) ThenBlock: { CAD_Bool_Punch.g = 16 }
                }
            }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ha = CAD_Bool_Punch.ok
        CAD_Bool_Punch.u0 = CAD_Store.Read(CAD_Bool_Punch.ha, 5)
        CAD_Bool_Punch.ce = CAD_Bool_Punch.ha
        CAD_Bool_Punch.u1 = CAD_Bool.PunchDest()
        ReturnValue(CAD_Bool_Punch.ha)
    }
}

// 1 when both arc ends lie strictly inside the host edge (not on a corner).
Function.CAD_Bool.PunchEndsIn {
    Output: Integer
    Body: {
        CAD_Bool_Punch.sa = CAD_Bool_Punch.u0
        CAD_Bool_Punch.t0 = CAD_Bool_Punch.w0
        CAD_Bool_Punch.ok = CAD_Bool.PunchSep()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.u0 = CAD_Bool_Punch.u1
        CAD_Bool_Punch.t0 = CAD_Bool_Punch.w0
        CAD_Bool_Punch.ok = CAD_Bool.PunchSep()
        CAD_Bool_Punch.u0 = CAD_Bool_Punch.sa
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.t0 = CAD_Bool_Punch.w1
        CAD_Bool_Punch.ok = CAD_Bool.PunchSep()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.u0 = CAD_Bool_Punch.u1
        CAD_Bool_Punch.t0 = CAD_Bool_Punch.w1
        CAD_Bool_Punch.ok = CAD_Bool.PunchSep()
        CAD_Bool_Punch.u0 = CAD_Bool_Punch.sa
        ReturnValue(CAD_Bool_Punch.ok)
    }
}

// 1 when the arc midpoint is on the interior side of host coedge .ha.
Function.CAD_Bool.PunchArcIn {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Bool_Punch.pl, 0) ThenBlock: { CAD_Bool_Punch.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Bool_Punch.pl, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.v = CAD_Topo.FaceGetPlane(CAD_Bool_Punch.face, CAD_Bool_Punch.pl)
        IfCondition NotEqual(CAD_Bool_Punch.v, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.nx = ArrayGet(CAD_Bool_Punch.pl, 10)
        CAD_Bool_Punch.ny = ArrayGet(CAD_Bool_Punch.pl, 11)
        CAD_Bool_Punch.nz = ArrayGet(CAD_Bool_Punch.pl, 12)
        CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.ea, 2)
        IfCondition EqualTo(CAD_Bool_Punch.v, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ox = CAD_Store.Read(CAD_Bool_Punch.v, 1)
        CAD_Bool_Punch.oy = CAD_Store.Read(CAD_Bool_Punch.v, 2)
        CAD_Bool_Punch.oz = CAD_Store.Read(CAD_Bool_Punch.v, 3)
        CAD_Bool_Punch.mx = CAD_Store.Read(CAD_Bool_Punch.v, 4)
        CAD_Bool_Punch.my = CAD_Store.Read(CAD_Bool_Punch.v, 5)
        CAD_Bool_Punch.mz = CAD_Store.Read(CAD_Bool_Punch.v, 6)
        CAD_Bool_Punch.qx = CAD_Store.Read(CAD_Bool_Punch.v, 7)
        CAD_Bool_Punch.qy = CAD_Store.Read(CAD_Bool_Punch.v, 8)
        CAD_Bool_Punch.qz = CAD_Store.Read(CAD_Bool_Punch.v, 9)
        CAD_Bool_Punch.dist = CAD_Store.Read(CAD_Bool_Punch.v, 10)
        CAD_Bool_Punch.px = CAD_Store.Read(CAD_Bool_Punch.v, 11)
        CAD_Bool_Punch.py = CAD_Store.Read(CAD_Bool_Punch.v, 12)
        CAD_Bool_Punch.py = Float_Mul(CAD_Bool_Punch.py, 0x3FE0000000000000)
        CAD_Bool_Punch.px = Float_Add(CAD_Bool_Punch.px, CAD_Bool_Punch.py)
        CAD_Bool_Punch.py = CAD_Geom.Cos(CAD_Bool_Punch.px)
        CAD_Bool_Punch.pz = CAD_Geom.Sin(CAD_Bool_Punch.px)
        CAD_Bool_Punch.px = Float_Mul(CAD_Bool_Punch.dist, CAD_Bool_Punch.py)
        CAD_Bool_Punch.dot = Float_Mul(CAD_Bool_Punch.dist, CAD_Bool_Punch.pz)
        CAD_Bool_Punch.py = Float_Mul(CAD_Bool_Punch.px, CAD_Bool_Punch.mx)
        CAD_Bool_Punch.ox = Float_Add(CAD_Bool_Punch.ox, CAD_Bool_Punch.py)
        CAD_Bool_Punch.py = Float_Mul(CAD_Bool_Punch.dot, CAD_Bool_Punch.qx)
        CAD_Bool_Punch.ox = Float_Add(CAD_Bool_Punch.ox, CAD_Bool_Punch.py)
        CAD_Bool_Punch.py = Float_Mul(CAD_Bool_Punch.px, CAD_Bool_Punch.my)
        CAD_Bool_Punch.oy = Float_Add(CAD_Bool_Punch.oy, CAD_Bool_Punch.py)
        CAD_Bool_Punch.py = Float_Mul(CAD_Bool_Punch.dot, CAD_Bool_Punch.qy)
        CAD_Bool_Punch.oy = Float_Add(CAD_Bool_Punch.oy, CAD_Bool_Punch.py)
        CAD_Bool_Punch.py = Float_Mul(CAD_Bool_Punch.px, CAD_Bool_Punch.mz)
        CAD_Bool_Punch.oz = Float_Add(CAD_Bool_Punch.oz, CAD_Bool_Punch.py)
        CAD_Bool_Punch.py = Float_Mul(CAD_Bool_Punch.dot, CAD_Bool_Punch.qz)
        CAD_Bool_Punch.oz = Float_Add(CAD_Bool_Punch.oz, CAD_Bool_Punch.py)
        CAD_Bool_Punch.mx = CAD_Store.Read(CAD_Bool_Punch.u0, 0)
        CAD_Bool_Punch.my = CAD_Store.Read(CAD_Bool_Punch.u0, 1)
        CAD_Bool_Punch.mz = CAD_Store.Read(CAD_Bool_Punch.u0, 2)
        CAD_Bool_Punch.qx = CAD_Store.Read(CAD_Bool_Punch.u1, 0)
        CAD_Bool_Punch.qy = CAD_Store.Read(CAD_Bool_Punch.u1, 1)
        CAD_Bool_Punch.qz = CAD_Store.Read(CAD_Bool_Punch.u1, 2)
        CAD_Bool_Punch.qx = Float_Sub(CAD_Bool_Punch.qx, CAD_Bool_Punch.mx)
        CAD_Bool_Punch.qy = Float_Sub(CAD_Bool_Punch.qy, CAD_Bool_Punch.my)
        CAD_Bool_Punch.qz = Float_Sub(CAD_Bool_Punch.qz, CAD_Bool_Punch.mz)
        CAD_Bool_Punch.px = Float_Mul(CAD_Bool_Punch.ny, CAD_Bool_Punch.qz)
        CAD_Bool_Punch.py = Float_Mul(CAD_Bool_Punch.nz, CAD_Bool_Punch.qy)
        CAD_Bool_Punch.px = Float_Sub(CAD_Bool_Punch.px, CAD_Bool_Punch.py)
        CAD_Bool_Punch.py = Float_Mul(CAD_Bool_Punch.nz, CAD_Bool_Punch.qx)
        CAD_Bool_Punch.pz = Float_Mul(CAD_Bool_Punch.nx, CAD_Bool_Punch.qz)
        CAD_Bool_Punch.py = Float_Sub(CAD_Bool_Punch.py, CAD_Bool_Punch.pz)
        CAD_Bool_Punch.pz = Float_Mul(CAD_Bool_Punch.nx, CAD_Bool_Punch.qy)
        CAD_Bool_Punch.dot = Float_Mul(CAD_Bool_Punch.ny, CAD_Bool_Punch.qx)
        CAD_Bool_Punch.pz = Float_Sub(CAD_Bool_Punch.pz, CAD_Bool_Punch.dot)
        CAD_Bool_Punch.ox = Float_Sub(CAD_Bool_Punch.ox, CAD_Bool_Punch.mx)
        CAD_Bool_Punch.oy = Float_Sub(CAD_Bool_Punch.oy, CAD_Bool_Punch.my)
        CAD_Bool_Punch.oz = Float_Sub(CAD_Bool_Punch.oz, CAD_Bool_Punch.mz)
        CAD_Bool_Punch.dot = Float_Mul(CAD_Bool_Punch.ox, CAD_Bool_Punch.px)
        CAD_Bool_Punch.dist = Float_Mul(CAD_Bool_Punch.oy, CAD_Bool_Punch.py)
        CAD_Bool_Punch.dot = Float_Add(CAD_Bool_Punch.dot, CAD_Bool_Punch.dist)
        CAD_Bool_Punch.dist = Float_Mul(CAD_Bool_Punch.oz, CAD_Bool_Punch.pz)
        CAD_Bool_Punch.dot = Float_Add(CAD_Bool_Punch.dot, CAD_Bool_Punch.dist)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Punch.dot), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Bool_Punch.dot, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.dist = Float_Mul(CAD_Bool_Punch.qx, CAD_Bool_Punch.qx)
        CAD_Bool_Punch.px = Float_Mul(CAD_Bool_Punch.qy, CAD_Bool_Punch.qy)
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, CAD_Bool_Punch.px)
        CAD_Bool_Punch.px = Float_Mul(CAD_Bool_Punch.qz, CAD_Bool_Punch.qz)
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, CAD_Bool_Punch.px)
        CAD_Bool_Punch.px = Float_Mul(CAD_Bool_Punch.dot, CAD_Bool_Punch.dot)
        CAD_Bool_Punch.py = Float_Mul(CAD_Bool_Punch.dist, CAD_Bool_Punch.dist)
        CAD_Bool_Punch.py = Float_Mul(CAD_Bool_Punch.py, 0x3F50624DD2F1A9FC)
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Punch.px, CAD_Bool_Punch.py), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Replace host coedge .ha with S→A, arc A→B, B→T. Arc ends are .w0 .w1 on .ea.
// Side pieces: .sb walks A→S, .c1 walks T→B, .c2 is the host arc coedge.
Function.CAD_Bool.PunchSpliceCap {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Bool_Punch.p0, 0) ThenBlock: { CAD_Bool_Punch.p0 = Allocate(32) }
        IfCondition EqualTo(CAD_Bool_Punch.p1, 0) ThenBlock: { CAD_Bool_Punch.p1 = Allocate(32) }
        IfCondition EqualTo(CAD_Bool_Punch.p0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.p1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.u0 = CAD_Store.Read(CAD_Bool_Punch.ha, 5)
        CAD_Bool_Punch.ce = CAD_Bool_Punch.ha
        CAD_Bool_Punch.u1 = CAD_Bool.PunchDest()
        CAD_Bool_Punch.px = CAD_Store.Read(CAD_Bool_Punch.u0, 0)
        CAD_Bool_Punch.py = CAD_Store.Read(CAD_Bool_Punch.u0, 1)
        CAD_Bool_Punch.pz = CAD_Store.Read(CAD_Bool_Punch.u0, 2)
        CAD_Bool_Punch.qx = CAD_Store.Read(CAD_Bool_Punch.u1, 0)
        CAD_Bool_Punch.qy = CAD_Store.Read(CAD_Bool_Punch.u1, 1)
        CAD_Bool_Punch.qz = CAD_Store.Read(CAD_Bool_Punch.u1, 2)
        CAD_Bool_Punch.nx = Float_Sub(CAD_Bool_Punch.qx, CAD_Bool_Punch.px)
        CAD_Bool_Punch.ny = Float_Sub(CAD_Bool_Punch.qy, CAD_Bool_Punch.py)
        CAD_Bool_Punch.nz = Float_Sub(CAD_Bool_Punch.qz, CAD_Bool_Punch.pz)
        CAD_Bool_Punch.ox = CAD_Store.Read(CAD_Bool_Punch.w0, 0)
        CAD_Bool_Punch.oy = CAD_Store.Read(CAD_Bool_Punch.w0, 1)
        CAD_Bool_Punch.oz = CAD_Store.Read(CAD_Bool_Punch.w0, 2)
        CAD_Bool_Punch.ox = Float_Sub(CAD_Bool_Punch.ox, CAD_Bool_Punch.px)
        CAD_Bool_Punch.oy = Float_Sub(CAD_Bool_Punch.oy, CAD_Bool_Punch.py)
        CAD_Bool_Punch.oz = Float_Sub(CAD_Bool_Punch.oz, CAD_Bool_Punch.pz)
        CAD_Bool_Punch.dist = Float_Mul(CAD_Bool_Punch.ox, CAD_Bool_Punch.nx)
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.oy, CAD_Bool_Punch.ny))
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.oz, CAD_Bool_Punch.nz))
        CAD_Bool_Punch.ox = CAD_Store.Read(CAD_Bool_Punch.w1, 0)
        CAD_Bool_Punch.oy = CAD_Store.Read(CAD_Bool_Punch.w1, 1)
        CAD_Bool_Punch.oz = CAD_Store.Read(CAD_Bool_Punch.w1, 2)
        CAD_Bool_Punch.ox = Float_Sub(CAD_Bool_Punch.ox, CAD_Bool_Punch.px)
        CAD_Bool_Punch.oy = Float_Sub(CAD_Bool_Punch.oy, CAD_Bool_Punch.py)
        CAD_Bool_Punch.oz = Float_Sub(CAD_Bool_Punch.oz, CAD_Bool_Punch.pz)
        CAD_Bool_Punch.dot = Float_Mul(CAD_Bool_Punch.ox, CAD_Bool_Punch.nx)
        CAD_Bool_Punch.dot = Float_Add(CAD_Bool_Punch.dot, Float_Mul(CAD_Bool_Punch.oy, CAD_Bool_Punch.ny))
        CAD_Bool_Punch.dot = Float_Add(CAD_Bool_Punch.dot, Float_Mul(CAD_Bool_Punch.oz, CAD_Bool_Punch.nz))
        CAD_Bool_Punch.t0 = CAD_Bool_Punch.w0
        CAD_Bool_Punch.t1 = CAD_Bool_Punch.w1
        IfCondition EqualTo(CAD_Num.Le(CAD_Bool_Punch.dist, CAD_Bool_Punch.dot), 0) ThenBlock: {
            CAD_Bool_Punch.t0 = CAD_Bool_Punch.w1
            CAD_Bool_Punch.t1 = CAD_Bool_Punch.w0
        }
        CAD_Bool_Punch.v = CAD_Bool_Punch.u0
        CAD_Bool_Punch.n = CAD_Bool_Punch.p0
        CAD_Bool.PunchPut()
        CAD_Bool_Punch.v = CAD_Bool_Punch.t0
        CAD_Bool_Punch.n = CAD_Bool_Punch.p1
        CAD_Bool.PunchPut()
        CAD_Bool_Punch.fg = CAD_Geom.MakeLine(CAD_Bool_Punch.p0, CAD_Bool_Punch.p1)
        CAD_Bool_Punch.eb = CAD_Topo.MakeEdge(CAD_Bool_Punch.u0, CAD_Bool_Punch.t0, CAD_Bool_Punch.fg)
        IfCondition EqualTo(CAD_Bool_Punch.eb, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.v = CAD_Bool_Punch.eb
        CAD_Bool_Punch.n = CAD_Bool_Punch.u0
        CAD_Bool_Punch.sa = CAD_Bool.PunchMkCe()
        CAD_Bool_Punch.v = CAD_Bool_Punch.eb
        CAD_Bool_Punch.n = CAD_Bool_Punch.t0
        CAD_Bool_Punch.sb = CAD_Bool.PunchMkCe()
        CAD_Topo.LinkTwins(CAD_Bool_Punch.sa, CAD_Bool_Punch.sb)
        CAD_Store.Write(CAD_Bool_Punch.eb, 3, CAD_Bool_Punch.sa)
        CAD_Store.Write(CAD_Bool_Punch.eb, 4, CAD_Bool_Punch.sb)
        CAD_Bool_Punch.v = CAD_Bool_Punch.t1
        CAD_Bool_Punch.n = CAD_Bool_Punch.p0
        CAD_Bool.PunchPut()
        CAD_Bool_Punch.v = CAD_Bool_Punch.u1
        CAD_Bool_Punch.n = CAD_Bool_Punch.p1
        CAD_Bool.PunchPut()
        CAD_Bool_Punch.fg = CAD_Geom.MakeLine(CAD_Bool_Punch.p0, CAD_Bool_Punch.p1)
        CAD_Bool_Punch.eb = CAD_Topo.MakeEdge(CAD_Bool_Punch.t1, CAD_Bool_Punch.u1, CAD_Bool_Punch.fg)
        IfCondition EqualTo(CAD_Bool_Punch.eb, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.v = CAD_Bool_Punch.eb
        CAD_Bool_Punch.n = CAD_Bool_Punch.t1
        CAD_Bool_Punch.c0 = CAD_Bool.PunchMkCe()
        CAD_Bool_Punch.v = CAD_Bool_Punch.eb
        CAD_Bool_Punch.n = CAD_Bool_Punch.u1
        CAD_Bool_Punch.c1 = CAD_Bool.PunchMkCe()
        CAD_Topo.LinkTwins(CAD_Bool_Punch.c0, CAD_Bool_Punch.c1)
        CAD_Store.Write(CAD_Bool_Punch.eb, 3, CAD_Bool_Punch.c0)
        CAD_Store.Write(CAD_Bool_Punch.eb, 4, CAD_Bool_Punch.c1)
        CAD_Bool_Punch.v = CAD_Bool_Punch.ea
        CAD_Bool_Punch.n = CAD_Bool_Punch.t0
        CAD_Bool_Punch.c2 = CAD_Bool.PunchMkCe()
        IfCondition EqualTo(CAD_Bool_Punch.c2, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Bool_Punch.ea, 3, CAD_Bool_Punch.c2)
        CAD_Bool_Punch.c3 = CAD_Store.Read(CAD_Bool_Punch.ha, 4)
        CAD_Bool_Punch.fg = CAD_Store.Read(CAD_Bool_Punch.ha, 3)
        CAD_Bool_Punch.ok = CAD_Store.Read(CAD_Bool_Punch.ha, 2)
        CAD_Store.Write(CAD_Bool_Punch.sa, 3, CAD_Bool_Punch.fg)
        CAD_Store.Write(CAD_Bool_Punch.sa, 2, CAD_Bool_Punch.c2)
        CAD_Store.Write(CAD_Bool_Punch.c2, 3, CAD_Bool_Punch.sa)
        CAD_Store.Write(CAD_Bool_Punch.c2, 2, CAD_Bool_Punch.c0)
        CAD_Store.Write(CAD_Bool_Punch.c0, 3, CAD_Bool_Punch.c2)
        CAD_Store.Write(CAD_Bool_Punch.c0, 2, CAD_Bool_Punch.ok)
        IfCondition NotEqual(CAD_Bool_Punch.fg, 0) ThenBlock: {
            CAD_Store.Write(CAD_Bool_Punch.fg, 2, CAD_Bool_Punch.sa)
        }
        IfCondition NotEqual(CAD_Bool_Punch.ok, 0) ThenBlock: {
            CAD_Store.Write(CAD_Bool_Punch.ok, 3, CAD_Bool_Punch.c0)
        }
        CAD_Store.Write(CAD_Bool_Punch.sa, 4, CAD_Bool_Punch.c3)
        CAD_Store.Write(CAD_Bool_Punch.c2, 4, CAD_Bool_Punch.c3)
        CAD_Store.Write(CAD_Bool_Punch.c0, 4, CAD_Bool_Punch.c3)
        IfCondition NotEqual(CAD_Bool_Punch.c3, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Bool_Punch.c3, 0), CAD_Bool_Punch.ha) ThenBlock: {
                CAD_Store.Write(CAD_Bool_Punch.c3, 0, CAD_Bool_Punch.sa)
            }
        }
        ReturnValue(1)
    }
}

// Face on the arc edge that is not a tool cap.
Function.CAD_Bool.PunchCylFace {
    Output: Integer
    Body: {
        CAD_Bool_Punch.c0 = CAD_Store.Read(CAD_Bool_Punch.ea, 3)
        CAD_Bool_Punch.c1 = CAD_Store.Read(CAD_Bool_Punch.ea, 4)
        CAD_Bool_Punch.face = 0
        CAD_Bool_Punch.g = 0
        WhileLoop LessThan(CAD_Bool_Punch.g, 2) {
            IfCondition EqualTo(CAD_Bool_Punch.g, 0) ThenBlock: { CAD_Bool_Punch.ce = CAD_Bool_Punch.c0 }
            IfCondition EqualTo(CAD_Bool_Punch.g, 1) ThenBlock: { CAD_Bool_Punch.ce = CAD_Bool_Punch.c1 }
            CAD_Bool_Punch.lp = 0
            IfCondition NotEqual(CAD_Bool_Punch.ce, 0) ThenBlock: {
                CAD_Bool_Punch.lp = CAD_Store.Read(CAD_Bool_Punch.ce, 4)
            }
            CAD_Bool_Punch.v = 0
            IfCondition NotEqual(CAD_Bool_Punch.lp, 0) ThenBlock: {
                CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.lp, 1)
            }
            CAD_Bool_Punch.ok = 1
            IfCondition EqualTo(CAD_Bool_Punch.v, 0) ThenBlock: { CAD_Bool_Punch.ok = 0 }
            IfCondition EqualTo(CAD_Bool_Punch.v, CAD_Bool_Punch.f0) ThenBlock: { CAD_Bool_Punch.ok = 0 }
            IfCondition EqualTo(CAD_Bool_Punch.v, CAD_Bool_Punch.f1) ThenBlock: { CAD_Bool_Punch.ok = 0 }
            IfCondition EqualTo(CAD_Bool_Punch.ok, 1) ThenBlock: { CAD_Bool_Punch.face = CAD_Bool_Punch.v }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        ReturnValue(CAD_Bool_Punch.face)
    }
}

// Line edges of cylinder .face → arr[11], arr[12]. Returns the count.
Function.CAD_Bool.PunchVertEdges {
    Output: Integer
    Body: {
        CAD_Bool_Punch.lp = CAD_Store.Read(CAD_Bool_Punch.face, 1)
        IfCondition EqualTo(CAD_Bool_Punch.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ha = CAD_Store.Read(CAD_Bool_Punch.lp, 0)
        CAD_Bool_Punch.ce = CAD_Bool_Punch.ha
        CAD_Bool_Punch.n = 0
        CAD_Bool_Punch.g = 0
        WhileLoop LessThan(CAD_Bool_Punch.g, 8) {
            IfCondition EqualTo(CAD_Bool_Punch.ce, 0) ThenBlock: { CAD_Bool_Punch.g = 8 }
            IfCondition NotEqual(CAD_Bool_Punch.ce, 0) ThenBlock: {
                CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.ce, 0)
                CAD_Bool_Punch.ok = 0
                CAD_Bool_Punch.eb = CAD_Store.Read(CAD_Bool_Punch.v, 2)
                IfCondition NotEqual(CAD_Bool_Punch.eb, 0) ThenBlock: {
                    CAD_Bool_Punch.ok = CAD_Store.Read(CAD_Bool_Punch.eb, 0)
                }
                IfCondition EqualTo(CAD_Bool_Punch.ok, 1) ThenBlock: {
                    IfCondition LessThan(CAD_Bool_Punch.n, 2) ThenBlock: {
                        CAD_Bool_Punch.fg = Add(11, CAD_Bool_Punch.n)
                        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.fg, CAD_Bool_Punch.v)
                        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
                    }
                }
                CAD_Bool_Punch.ce = CAD_Store.Read(CAD_Bool_Punch.ce, 2)
                IfCondition EqualTo(CAD_Bool_Punch.ce, CAD_Bool_Punch.ha) ThenBlock: { CAD_Bool_Punch.g = 8 }
            }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        ReturnValue(CAD_Bool_Punch.n)
    }
}

// Coedges strictly after .c0 until .c1. Sets .c2 first, .c3 last.
Function.CAD_Bool.PunchChain {
    Output: Integer
    Body: {
        CAD_Bool_Punch.c2 = CAD_Store.Read(CAD_Bool_Punch.c0, 2)
        IfCondition EqualTo(CAD_Bool_Punch.c2, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.c2, CAD_Bool_Punch.c1) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.c3 = CAD_Bool_Punch.c2
        CAD_Bool_Punch.g = 0
        WhileLoop LessThan(CAD_Bool_Punch.g, 16) {
            CAD_Bool_Punch.ce = CAD_Store.Read(CAD_Bool_Punch.c3, 2)
            IfCondition EqualTo(CAD_Bool_Punch.ce, CAD_Bool_Punch.c1) ThenBlock: { CAD_Bool_Punch.g = 16 }
            IfCondition NotEqual(CAD_Bool_Punch.ce, CAD_Bool_Punch.c1) ThenBlock: {
                IfCondition EqualTo(CAD_Bool_Punch.ce, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(CAD_Bool_Punch.ce, CAD_Bool_Punch.c0) ThenBlock: { ReturnValue(0) }
                CAD_Bool_Punch.c3 = CAD_Bool_Punch.ce
            }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        ReturnValue(1)
    }
}

// Split the host side wall and keep the cylinder. Chord wall stays off the host.
// arr: 8/9 side coedges, 10 cyl, 11/12 verts, 14-20 top splice, 24-30 bottom splice.
Function.CAD_Bool.PunchRemnants {
    Output: Integer
    Body: {
        CAD_Bool_Punch.c0 = ArrayGet(CAD_Bool_Punch.arr, 8)
        CAD_Bool_Punch.c1 = ArrayGet(CAD_Bool_Punch.arr, 9)
        CAD_Bool_Punch.ok = CAD_Bool.PunchChain()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.arr, 34, CAD_Bool_Punch.c2)
        ArraySet(CAD_Bool_Punch.arr, 35, CAD_Bool_Punch.c3)
        CAD_Bool_Punch.c0 = ArrayGet(CAD_Bool_Punch.arr, 9)
        CAD_Bool_Punch.c1 = ArrayGet(CAD_Bool_Punch.arr, 8)
        CAD_Bool_Punch.ok = CAD_Bool.PunchChain()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.arr, 36, CAD_Bool_Punch.c2)
        ArraySet(CAD_Bool_Punch.arr, 37, CAD_Bool_Punch.c3)
        CAD_Bool_Punch.ce = ArrayGet(CAD_Bool_Punch.arr, 35)
        CAD_Bool_Punch.fg = CAD_Bool.PunchDest()
        CAD_Bool_Punch.sa = ArrayGet(CAD_Bool_Punch.arr, 28)
        CAD_Bool_Punch.sb = ArrayGet(CAD_Bool_Punch.arr, 29)
        CAD_Bool_Punch.hb = 0
        CAD_Bool_Punch.n = CAD_Store.Read(CAD_Bool_Punch.sa, 5)
        IfCondition EqualTo(CAD_Bool_Punch.n, CAD_Bool_Punch.fg) ThenBlock: { CAD_Bool_Punch.hb = CAD_Bool_Punch.sa }
        CAD_Bool_Punch.n = CAD_Store.Read(CAD_Bool_Punch.sb, 5)
        IfCondition EqualTo(CAD_Bool_Punch.n, CAD_Bool_Punch.fg) ThenBlock: { CAD_Bool_Punch.hb = CAD_Bool_Punch.sb }
        IfCondition EqualTo(CAD_Bool_Punch.hb, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.t0 = ArrayGet(CAD_Bool_Punch.arr, 14)
        CAD_Bool_Punch.v = ArrayGet(CAD_Bool_Punch.arr, 11)
        CAD_Bool_Punch.ok = CAD_Store.Read(CAD_Bool_Punch.v, 0)
        CAD_Bool_Punch.n = CAD_Store.Read(CAD_Bool_Punch.v, 1)
        CAD_Bool_Punch.fg = 0
        IfCondition EqualTo(CAD_Bool_Punch.ok, CAD_Bool_Punch.t0) ThenBlock: { CAD_Bool_Punch.fg = 1 }
        IfCondition EqualTo(CAD_Bool_Punch.n, CAD_Bool_Punch.t0) ThenBlock: { CAD_Bool_Punch.fg = 1 }
        IfCondition EqualTo(CAD_Bool_Punch.fg, 0) ThenBlock: {
            CAD_Bool_Punch.v = ArrayGet(CAD_Bool_Punch.arr, 12)
        }
        CAD_Bool_Punch.eb = CAD_Bool_Punch.v
        CAD_Bool_Punch.w0 = CAD_Store.Read(CAD_Bool_Punch.eb, 0)
        IfCondition EqualTo(CAD_Bool_Punch.w0, CAD_Bool_Punch.t0) ThenBlock: {
            CAD_Bool_Punch.w0 = CAD_Store.Read(CAD_Bool_Punch.eb, 1)
        }
        CAD_Bool_Punch.ce = CAD_Bool_Punch.hb
        CAD_Bool_Punch.w1 = CAD_Bool.PunchDest()
        IfCondition NotEqual(CAD_Bool_Punch.w1, CAD_Bool_Punch.w0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.v = CAD_Bool_Punch.eb
        CAD_Bool_Punch.n = CAD_Bool_Punch.w0
        CAD_Bool_Punch.c0 = CAD_Bool.PunchMkCe()
        CAD_Bool_Punch.v = CAD_Bool_Punch.eb
        CAD_Bool_Punch.n = CAD_Bool_Punch.t0
        CAD_Bool_Punch.c1 = CAD_Bool.PunchMkCe()
        CAD_Topo.LinkTwins(CAD_Bool_Punch.c0, CAD_Bool_Punch.c1)
        CAD_Store.Write(CAD_Bool_Punch.eb, 3, CAD_Bool_Punch.c0)
        CAD_Store.Write(CAD_Bool_Punch.eb, 4, CAD_Bool_Punch.c1)
        ArraySet(CAD_Bool_Punch.arr, 32, CAD_Bool_Punch.c1)
        CAD_Bool_Punch.sa = ArrayGet(CAD_Bool_Punch.arr, 18)
        CAD_Bool_Punch.c2 = ArrayGet(CAD_Bool_Punch.arr, 34)
        CAD_Bool_Punch.c3 = ArrayGet(CAD_Bool_Punch.arr, 35)
        CAD_Store.Write(CAD_Bool_Punch.sa, 2, CAD_Bool_Punch.c2)
        CAD_Store.Write(CAD_Bool_Punch.c2, 3, CAD_Bool_Punch.sa)
        CAD_Store.Write(CAD_Bool_Punch.c3, 2, CAD_Bool_Punch.hb)
        CAD_Store.Write(CAD_Bool_Punch.hb, 3, CAD_Bool_Punch.c3)
        CAD_Store.Write(CAD_Bool_Punch.hb, 2, CAD_Bool_Punch.c0)
        CAD_Store.Write(CAD_Bool_Punch.c0, 3, CAD_Bool_Punch.hb)
        CAD_Store.Write(CAD_Bool_Punch.c0, 2, CAD_Bool_Punch.sa)
        CAD_Store.Write(CAD_Bool_Punch.sa, 3, CAD_Bool_Punch.c0)
        CAD_Bool_Punch.lp = CAD_Topo.MakeLoop(CAD_Bool_Punch.sa)
        IfCondition EqualTo(CAD_Bool_Punch.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Bool_Punch.sa, 4, CAD_Bool_Punch.lp)
        CAD_Store.Write(CAD_Bool_Punch.hb, 4, CAD_Bool_Punch.lp)
        CAD_Store.Write(CAD_Bool_Punch.c0, 4, CAD_Bool_Punch.lp)
        CAD_Bool_Punch.ce = CAD_Bool_Punch.c2
        CAD_Bool_Punch.g = 0
        WhileLoop LessThan(CAD_Bool_Punch.g, 16) {
            CAD_Store.Write(CAD_Bool_Punch.ce, 4, CAD_Bool_Punch.lp)
            IfCondition EqualTo(CAD_Bool_Punch.ce, CAD_Bool_Punch.c3) ThenBlock: { CAD_Bool_Punch.g = 16 }
            IfCondition NotEqual(CAD_Bool_Punch.ce, CAD_Bool_Punch.c3) ThenBlock: {
                CAD_Bool_Punch.ce = CAD_Store.Read(CAD_Bool_Punch.ce, 2)
            }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        CAD_Bool_Punch.face = ArrayGet(CAD_Bool_Punch.arr, 8)
        CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.face, 4)
        CAD_Bool_Punch.face = CAD_Store.Read(CAD_Bool_Punch.v, 1)
        CAD_Bool_Punch.sb = CAD_Store.Read(CAD_Bool_Punch.face, 0)
        ArraySet(CAD_Bool_Punch.arr, 13, CAD_Bool_Punch.sb)
        CAD_Store.Write(CAD_Bool_Punch.face, 1, CAD_Bool_Punch.lp)
        CAD_Store.Write(CAD_Bool_Punch.lp, 1, CAD_Bool_Punch.face)
        CAD_Bool_Punch.ce = ArrayGet(CAD_Bool_Punch.arr, 37)
        CAD_Bool_Punch.fg = CAD_Bool.PunchDest()
        CAD_Bool_Punch.t1 = ArrayGet(CAD_Bool_Punch.arr, 15)
        CAD_Bool_Punch.v = ArrayGet(CAD_Bool_Punch.arr, 11)
        CAD_Bool_Punch.ok = CAD_Store.Read(CAD_Bool_Punch.v, 0)
        CAD_Bool_Punch.n = CAD_Store.Read(CAD_Bool_Punch.v, 1)
        CAD_Bool_Punch.w0 = 0
        IfCondition EqualTo(CAD_Bool_Punch.ok, CAD_Bool_Punch.t1) ThenBlock: { CAD_Bool_Punch.w0 = 1 }
        IfCondition EqualTo(CAD_Bool_Punch.n, CAD_Bool_Punch.t1) ThenBlock: { CAD_Bool_Punch.w0 = 1 }
        IfCondition EqualTo(CAD_Bool_Punch.w0, 0) ThenBlock: {
            CAD_Bool_Punch.v = ArrayGet(CAD_Bool_Punch.arr, 12)
        }
        CAD_Bool_Punch.eb = CAD_Bool_Punch.v
        CAD_Bool_Punch.w1 = CAD_Store.Read(CAD_Bool_Punch.eb, 0)
        IfCondition EqualTo(CAD_Bool_Punch.w1, CAD_Bool_Punch.t1) ThenBlock: {
            CAD_Bool_Punch.w1 = CAD_Store.Read(CAD_Bool_Punch.eb, 1)
        }
        CAD_Bool_Punch.sa = ArrayGet(CAD_Bool_Punch.arr, 28)
        CAD_Bool_Punch.sb = ArrayGet(CAD_Bool_Punch.arr, 29)
        CAD_Bool_Punch.hb = 0
        CAD_Bool_Punch.n = CAD_Store.Read(CAD_Bool_Punch.sa, 5)
        IfCondition EqualTo(CAD_Bool_Punch.n, CAD_Bool_Punch.w1) ThenBlock: { CAD_Bool_Punch.hb = CAD_Bool_Punch.sa }
        CAD_Bool_Punch.n = CAD_Store.Read(CAD_Bool_Punch.sb, 5)
        IfCondition EqualTo(CAD_Bool_Punch.n, CAD_Bool_Punch.w1) ThenBlock: { CAD_Bool_Punch.hb = CAD_Bool_Punch.sb }
        IfCondition EqualTo(CAD_Bool_Punch.hb, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ce = CAD_Bool_Punch.hb
        CAD_Bool_Punch.ok = CAD_Bool.PunchDest()
        CAD_Bool_Punch.c2 = ArrayGet(CAD_Bool_Punch.arr, 36)
        CAD_Bool_Punch.n = CAD_Store.Read(CAD_Bool_Punch.c2, 5)
        IfCondition NotEqual(CAD_Bool_Punch.ok, CAD_Bool_Punch.n) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Bool_Punch.fg, ArrayGet(CAD_Bool_Punch.arr, 17)) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.v = CAD_Bool_Punch.eb
        CAD_Bool_Punch.n = CAD_Bool_Punch.t1
        CAD_Bool_Punch.c0 = CAD_Bool.PunchMkCe()
        CAD_Bool_Punch.v = CAD_Bool_Punch.eb
        CAD_Bool_Punch.n = CAD_Bool_Punch.w1
        CAD_Bool_Punch.c1 = CAD_Bool.PunchMkCe()
        CAD_Topo.LinkTwins(CAD_Bool_Punch.c0, CAD_Bool_Punch.c1)
        CAD_Store.Write(CAD_Bool_Punch.eb, 3, CAD_Bool_Punch.c0)
        CAD_Store.Write(CAD_Bool_Punch.eb, 4, CAD_Bool_Punch.c1)
        ArraySet(CAD_Bool_Punch.arr, 33, CAD_Bool_Punch.c1)
        CAD_Bool_Punch.sa = ArrayGet(CAD_Bool_Punch.arr, 19)
        CAD_Bool_Punch.c2 = ArrayGet(CAD_Bool_Punch.arr, 36)
        CAD_Bool_Punch.c3 = ArrayGet(CAD_Bool_Punch.arr, 37)
        CAD_Store.Write(CAD_Bool_Punch.c3, 2, CAD_Bool_Punch.sa)
        CAD_Store.Write(CAD_Bool_Punch.sa, 3, CAD_Bool_Punch.c3)
        CAD_Store.Write(CAD_Bool_Punch.sa, 2, CAD_Bool_Punch.c0)
        CAD_Store.Write(CAD_Bool_Punch.c0, 3, CAD_Bool_Punch.sa)
        CAD_Store.Write(CAD_Bool_Punch.c0, 2, CAD_Bool_Punch.hb)
        CAD_Store.Write(CAD_Bool_Punch.hb, 3, CAD_Bool_Punch.c0)
        CAD_Store.Write(CAD_Bool_Punch.hb, 2, CAD_Bool_Punch.c2)
        CAD_Store.Write(CAD_Bool_Punch.c2, 3, CAD_Bool_Punch.hb)
        CAD_Bool_Punch.lp = CAD_Topo.MakeLoop(CAD_Bool_Punch.c2)
        IfCondition EqualTo(CAD_Bool_Punch.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Bool_Punch.sa, 4, CAD_Bool_Punch.lp)
        CAD_Store.Write(CAD_Bool_Punch.hb, 4, CAD_Bool_Punch.lp)
        CAD_Store.Write(CAD_Bool_Punch.c0, 4, CAD_Bool_Punch.lp)
        CAD_Bool_Punch.ce = CAD_Bool_Punch.c2
        CAD_Bool_Punch.g = 0
        WhileLoop LessThan(CAD_Bool_Punch.g, 16) {
            CAD_Store.Write(CAD_Bool_Punch.ce, 4, CAD_Bool_Punch.lp)
            IfCondition EqualTo(CAD_Bool_Punch.ce, CAD_Bool_Punch.c3) ThenBlock: { CAD_Bool_Punch.g = 16 }
            IfCondition NotEqual(CAD_Bool_Punch.ce, CAD_Bool_Punch.c3) ThenBlock: {
                CAD_Bool_Punch.ce = CAD_Store.Read(CAD_Bool_Punch.ce, 2)
            }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        CAD_Bool_Punch.sb = ArrayGet(CAD_Bool_Punch.arr, 13)
        CAD_Bool_Punch.face = CAD_Topo.MakeFace(CAD_Bool_Punch.sb, CAD_Bool_Punch.lp)
        IfCondition EqualTo(CAD_Bool_Punch.face, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.sh = CAD_Store.Read(CAD_Bool_Punch.host, 0)
        CAD_Topo.ShellAppendFace(CAD_Bool_Punch.sh, CAD_Bool_Punch.face)
        CAD_Bool_Punch.t0 = ArrayGet(CAD_Bool_Punch.arr, 14)
        CAD_Bool_Punch.t1 = ArrayGet(CAD_Bool_Punch.arr, 15)
        CAD_Bool_Punch.c2 = ArrayGet(CAD_Bool_Punch.arr, 20)
        CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.c2, 0)
        CAD_Bool_Punch.n = CAD_Bool_Punch.t1
        CAD_Bool_Punch.sa = CAD_Bool.PunchMkCe()
        CAD_Topo.LinkTwins(CAD_Bool_Punch.c2, CAD_Bool_Punch.sa)
        CAD_Store.Write(CAD_Bool_Punch.v, 3, CAD_Bool_Punch.c2)
        CAD_Store.Write(CAD_Bool_Punch.v, 4, CAD_Bool_Punch.sa)
        CAD_Bool_Punch.c0 = ArrayGet(CAD_Bool_Punch.arr, 30)
        CAD_Bool_Punch.ce = CAD_Bool_Punch.c0
        CAD_Bool_Punch.w0 = CAD_Bool.PunchDest()
        CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.c0, 0)
        CAD_Bool_Punch.n = CAD_Bool_Punch.w0
        CAD_Bool_Punch.sb = CAD_Bool.PunchMkCe()
        CAD_Topo.LinkTwins(CAD_Bool_Punch.c0, CAD_Bool_Punch.sb)
        CAD_Store.Write(CAD_Bool_Punch.v, 3, CAD_Bool_Punch.c0)
        CAD_Store.Write(CAD_Bool_Punch.v, 4, CAD_Bool_Punch.sb)
        CAD_Bool_Punch.c1 = ArrayGet(CAD_Bool_Punch.arr, 32)
        CAD_Bool_Punch.c3 = ArrayGet(CAD_Bool_Punch.arr, 33)
        CAD_Store.Write(CAD_Bool_Punch.sa, 2, CAD_Bool_Punch.c1)
        CAD_Store.Write(CAD_Bool_Punch.c1, 3, CAD_Bool_Punch.sa)
        CAD_Store.Write(CAD_Bool_Punch.c1, 2, CAD_Bool_Punch.sb)
        CAD_Store.Write(CAD_Bool_Punch.sb, 3, CAD_Bool_Punch.c1)
        CAD_Store.Write(CAD_Bool_Punch.sb, 2, CAD_Bool_Punch.c3)
        CAD_Store.Write(CAD_Bool_Punch.c3, 3, CAD_Bool_Punch.sb)
        CAD_Store.Write(CAD_Bool_Punch.c3, 2, CAD_Bool_Punch.sa)
        CAD_Store.Write(CAD_Bool_Punch.sa, 3, CAD_Bool_Punch.c3)
        CAD_Bool_Punch.lp = CAD_Topo.MakeLoop(CAD_Bool_Punch.sa)
        CAD_Store.Write(CAD_Bool_Punch.sa, 4, CAD_Bool_Punch.lp)
        CAD_Store.Write(CAD_Bool_Punch.c1, 4, CAD_Bool_Punch.lp)
        CAD_Store.Write(CAD_Bool_Punch.sb, 4, CAD_Bool_Punch.lp)
        CAD_Store.Write(CAD_Bool_Punch.c3, 4, CAD_Bool_Punch.lp)
        CAD_Bool_Punch.face = ArrayGet(CAD_Bool_Punch.arr, 10)
        CAD_Store.Write(CAD_Bool_Punch.face, 1, CAD_Bool_Punch.lp)
        CAD_Store.Write(CAD_Bool_Punch.lp, 1, CAD_Bool_Punch.face)
        CAD_Bool_Punch.sh = CAD_Store.Read(CAD_Bool_Punch.tool, 0)
        CAD_Topo.ShellUnlinkFace(CAD_Bool_Punch.sh, CAD_Bool_Punch.face)
        CAD_Bool_Punch.sh = CAD_Store.Read(CAD_Bool_Punch.host, 0)
        CAD_Topo.ShellAppendFace(CAD_Bool_Punch.sh, CAD_Bool_Punch.face)
        ReturnValue(1)
    }
}

// Cap .face is two circle arcs on the same two vertices (a whole circle).
// .ea and .eb are the arcs. The second arc handle is left in arr[32].
Function.CAD_Bool.PunchTwoArc {
    Output: Integer
    Body: {
        CAD_Bool_Punch.lp = CAD_Store.Read(CAD_Bool_Punch.face, 1)
        IfCondition EqualTo(CAD_Bool_Punch.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ha = CAD_Store.Read(CAD_Bool_Punch.lp, 0)
        IfCondition EqualTo(CAD_Bool_Punch.ha, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.hb = CAD_Store.Read(CAD_Bool_Punch.ha, 2)
        IfCondition EqualTo(CAD_Bool_Punch.hb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.hb, CAD_Bool_Punch.ha) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ce = CAD_Store.Read(CAD_Bool_Punch.hb, 2)
        IfCondition NotEqual(CAD_Bool_Punch.ce, CAD_Bool_Punch.ha) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.ha, 0)
        CAD_Bool_Punch.n = CAD_Store.Read(CAD_Bool_Punch.v, 2)
        IfCondition EqualTo(CAD_Bool_Punch.n, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ok = CAD_Store.Read(CAD_Bool_Punch.n, 0)
        IfCondition NotEqual(CAD_Bool_Punch.ok, 2) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ea = CAD_Bool_Punch.v
        CAD_Bool_Punch.v = CAD_Store.Read(CAD_Bool_Punch.hb, 0)
        CAD_Bool_Punch.n = CAD_Store.Read(CAD_Bool_Punch.v, 2)
        IfCondition EqualTo(CAD_Bool_Punch.n, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ok = CAD_Store.Read(CAD_Bool_Punch.n, 0)
        IfCondition NotEqual(CAD_Bool_Punch.ok, 2) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.eb = CAD_Bool_Punch.v
        CAD_Bool_Punch.w0 = CAD_Store.Read(CAD_Bool_Punch.ea, 0)
        CAD_Bool_Punch.w1 = CAD_Store.Read(CAD_Bool_Punch.ea, 1)
        CAD_Bool_Punch.u0 = CAD_Store.Read(CAD_Bool_Punch.eb, 0)
        CAD_Bool_Punch.u1 = CAD_Store.Read(CAD_Bool_Punch.eb, 1)
        CAD_Bool_Punch.ok = 0
        IfCondition EqualTo(CAD_Bool_Punch.u0, CAD_Bool_Punch.w0) ThenBlock: {
            IfCondition EqualTo(CAD_Bool_Punch.u1, CAD_Bool_Punch.w1) ThenBlock: { CAD_Bool_Punch.ok = 1 }
        }
        IfCondition EqualTo(CAD_Bool_Punch.u0, CAD_Bool_Punch.w1) ThenBlock: {
            IfCondition EqualTo(CAD_Bool_Punch.u1, CAD_Bool_Punch.w0) ThenBlock: { CAD_Bool_Punch.ok = 1 }
        }
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.arr, 32, CAD_Bool_Punch.eb)
        ReturnValue(1)
    }
}

// One digon cap, or a whole circle whose chord is one host edge.
// .fg 0 = tool f0 on host hf0. .fg 1 = f1 on hf1.
// Saves the interior arc edge, its ends, the host coedge, and that coedge's twin.
Function.CAD_Bool.PunchOneCap {
    Output: Integer
    Body: {
        CAD_Bool_Punch.face = CAD_Bool_Punch.f0
        IfCondition EqualTo(CAD_Bool_Punch.fg, 1) ThenBlock: { CAD_Bool_Punch.face = CAD_Bool_Punch.f1 }
        ArraySet(CAD_Bool_Punch.arr, 32, 0)
        CAD_Bool_Punch.ok = CAD_Bool.PunchDigon()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: {
            CAD_Bool_Punch.ok = CAD_Bool.PunchTwoArc()
        }
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.n = 0
        IfCondition EqualTo(CAD_Bool_Punch.fg, 1) ThenBlock: { CAD_Bool_Punch.n = 4 }
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.ea)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.w0)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.w1)
        CAD_Bool_Punch.face = CAD_Bool_Punch.hf0
        IfCondition EqualTo(CAD_Bool_Punch.fg, 1) ThenBlock: { CAD_Bool_Punch.face = CAD_Bool_Punch.hf1 }
        CAD_Bool_Punch.n = 0
        IfCondition EqualTo(CAD_Bool_Punch.fg, 1) ThenBlock: { CAD_Bool_Punch.n = 4 }
        CAD_Bool_Punch.ea = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        CAD_Bool_Punch.w0 = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        CAD_Bool_Punch.w1 = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.ok = CAD_Bool.PunchHostCe()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.n = 1
        IfCondition EqualTo(CAD_Bool_Punch.fg, 1) ThenBlock: { CAD_Bool_Punch.n = 5 }
        CAD_Bool_Punch.w0 = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        CAD_Bool_Punch.w1 = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.ok = CAD_Bool.PunchEndsIn()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.face = CAD_Bool_Punch.hf0
        IfCondition EqualTo(CAD_Bool_Punch.fg, 1) ThenBlock: { CAD_Bool_Punch.face = CAD_Bool_Punch.hf1 }
        CAD_Bool_Punch.n = 0
        IfCondition EqualTo(CAD_Bool_Punch.fg, 1) ThenBlock: { CAD_Bool_Punch.n = 4 }
        CAD_Bool_Punch.ea = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.ok = CAD_Bool.PunchArcIn()
        ArraySet(CAD_Bool_Punch.arr, 31, CAD_Bool_Punch.ok)
        CAD_Bool_Punch.eb = ArrayGet(CAD_Bool_Punch.arr, 32)
        IfCondition NotEqual(CAD_Bool_Punch.eb, 0) ThenBlock: {
            ArraySet(CAD_Bool_Punch.arr, 29, CAD_Bool_Punch.ea)
            CAD_Bool_Punch.ea = CAD_Bool_Punch.eb
            CAD_Bool_Punch.ok = CAD_Bool.PunchArcIn()
            CAD_Bool_Punch.n = ArrayGet(CAD_Bool_Punch.arr, 31)
            CAD_Bool_Punch.g = 0
            IfCondition EqualTo(CAD_Bool_Punch.n, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: {
                    CAD_Bool_Punch.ea = ArrayGet(CAD_Bool_Punch.arr, 29)
                    CAD_Bool_Punch.g = 1
                }
            }
            IfCondition EqualTo(CAD_Bool_Punch.ok, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Bool_Punch.n, 0) ThenBlock: { CAD_Bool_Punch.g = 1 }
            }
            IfCondition EqualTo(CAD_Bool_Punch.g, 0) ThenBlock: { ReturnValue(2) }
        }
        IfCondition EqualTo(CAD_Bool_Punch.eb, 0) ThenBlock: {
            IfCondition EqualTo(ArrayGet(CAD_Bool_Punch.arr, 31), 0) ThenBlock: { ReturnValue(2) }
        }
        CAD_Bool_Punch.n = 0
        IfCondition EqualTo(CAD_Bool_Punch.fg, 1) ThenBlock: { CAD_Bool_Punch.n = 4 }
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.ea)
        CAD_Bool_Punch.n = 3
        CAD_Bool_Punch.g = 8
        IfCondition EqualTo(CAD_Bool_Punch.fg, 1) ThenBlock: {
            CAD_Bool_Punch.n = 7
            CAD_Bool_Punch.g = 9
        }
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.ha)
        CAD_Bool_Punch.ce = CAD_Store.Read(CAD_Bool_Punch.ha, 1)
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.g, CAD_Bool_Punch.ce)
        ReturnValue(1)
    }
}

// Twins of the two host edges share one side face, and the arc has two verticals.
Function.CAD_Bool.PunchNotchSide {
    Output: Integer
    Body: {
        CAD_Bool_Punch.c0 = ArrayGet(CAD_Bool_Punch.arr, 8)
        CAD_Bool_Punch.c1 = ArrayGet(CAD_Bool_Punch.arr, 9)
        IfCondition EqualTo(CAD_Bool_Punch.c0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.c1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ok = CAD_Bool.PunchChain()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ea = ArrayGet(CAD_Bool_Punch.arr, 0)
        CAD_Bool_Punch.face = CAD_Bool.PunchCylFace()
        IfCondition EqualTo(CAD_Bool_Punch.face, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.arr, 10, CAD_Bool_Punch.face)
        CAD_Bool_Punch.n = CAD_Bool.PunchVertEdges()
        IfCondition NotEqual(CAD_Bool_Punch.n, 2) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Splice the cap saved at arr[base .. base+3] and store the pieces at arr[dst].
Function.CAD_Bool.PunchSpliceSaved {
    Input: base_i: Integer
    Input: dst_i: Integer
    Output: Integer
    Body: {
        CAD_Bool_Punch.n = base_i
        CAD_Bool_Punch.g = dst_i
        ArraySet(CAD_Bool_Punch.arr, 38, CAD_Bool_Punch.n)
        ArraySet(CAD_Bool_Punch.arr, 39, CAD_Bool_Punch.g)
        CAD_Bool_Punch.n = ArrayGet(CAD_Bool_Punch.arr, 38)
        CAD_Bool_Punch.ha = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.n = 0
        CAD_Bool_Punch.g = ArrayGet(CAD_Bool_Punch.arr, 38)
        IfCondition EqualTo(CAD_Bool_Punch.g, 7) ThenBlock: { CAD_Bool_Punch.n = 4 }
        CAD_Bool_Punch.ea = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        CAD_Bool_Punch.w0 = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        CAD_Bool_Punch.w1 = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n)
        CAD_Bool_Punch.ok = CAD_Bool.PunchSpliceCap()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.n = ArrayGet(CAD_Bool_Punch.arr, 39)
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.t0)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.t1)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.u0)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.u1)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.sb)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.c1)
        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.c2)
        ReturnValue(1)
    }
}

// Boundary digon: notch the host outer loop, do not keep the chord wall.
// Returns the host, or 0 to leave PunchPrism on the interior-hole path.
Function.CAD_Bool.PunchNotch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Bool_Punch.hf1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.arr, 0) ThenBlock: { CAD_Bool_Punch.arr = Allocate(512) }
        IfCondition EqualTo(CAD_Bool_Punch.arr, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.fg = 0
        CAD_Bool_Punch.ok = CAD_Bool.PunchOneCap()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.arr, 36, CAD_Bool_Punch.ok)
        CAD_Bool_Punch.fg = 1
        CAD_Bool_Punch.ok = CAD_Bool.PunchOneCap()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.n = ArrayGet(CAD_Bool_Punch.arr, 36)
        CAD_Bool_Punch.fg = 0
        IfCondition EqualTo(CAD_Bool_Punch.n, 2) ThenBlock: { CAD_Bool_Punch.fg = 1 }
        IfCondition EqualTo(CAD_Bool_Punch.ok, 2) ThenBlock: { CAD_Bool_Punch.fg = 1 }
        // Outside arc: do not notch outward and do not fall through to the sew.
        IfCondition EqualTo(CAD_Bool_Punch.fg, 1) ThenBlock: { ReturnValue(-1) }
        CAD_Bool_Punch.ok = CAD_Bool.PunchNotchSide()
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ok = CAD_Bool.PunchSpliceSaved(3, 14)
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.ok = CAD_Bool.PunchSpliceSaved(7, 24)
        IfCondition EqualTo(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(CAD_Bool_Punch.host) }
        CAD_Bool.PunchRemnants()
        ReturnValue(CAD_Bool_Punch.host)
    }
}

// Tool prism (plex wire swept along the face) becomes a hole in the host.
// Caps that land on host faces turn into inner loops. The side faces are
// the hole wall. A cap that stops inside the solid is the blind floor.
// A digon whose chord lies on the host boundary is a notch: the arc
// replaces that edge and the chord wall is not kept.
// Returns the host, or 0 when the tool is not that kind of prism.
Function.CAD_Bool.PunchPrism {
    Input: host_h: Integer
    Input: tool_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(host_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tool_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.host = host_h
        CAD_Bool_Punch.tool = tool_h
        CAD_Bool_Punch.sh = CAD_Store.Read(CAD_Bool_Punch.tool, 0)
        IfCondition EqualTo(CAD_Bool_Punch.sh, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.f0 = CAD_Store.Read(CAD_Bool_Punch.sh, 0)
        IfCondition EqualTo(CAD_Bool_Punch.f0, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.f1 = CAD_Store.Read(CAD_Bool_Punch.f0, 3)
        IfCondition EqualTo(CAD_Bool_Punch.f1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.pl, 0) ThenBlock: { CAD_Bool_Punch.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Bool_Punch.pl, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.v = CAD_Topo.FaceGetPlane(CAD_Bool_Punch.f0, CAD_Bool_Punch.pl)
        IfCondition NotEqual(CAD_Bool_Punch.v, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.nx = ArrayGet(CAD_Bool_Punch.pl, 10)
        CAD_Bool_Punch.ny = ArrayGet(CAD_Bool_Punch.pl, 11)
        CAD_Bool_Punch.nz = ArrayGet(CAD_Bool_Punch.pl, 12)
        CAD_Bool_Punch.v = CAD_Topo.FaceGetPlane(CAD_Bool_Punch.f1, CAD_Bool_Punch.pl)
        IfCondition NotEqual(CAD_Bool_Punch.v, 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.mx = ArrayGet(CAD_Bool_Punch.pl, 10)
        CAD_Bool_Punch.my = ArrayGet(CAD_Bool_Punch.pl, 11)
        CAD_Bool_Punch.mz = ArrayGet(CAD_Bool_Punch.pl, 12)
        CAD_Bool_Punch.dist = Float_Mul(CAD_Bool_Punch.nx, CAD_Bool_Punch.mx)
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.ny, CAD_Bool_Punch.my))
        CAD_Bool_Punch.dist = Float_Add(CAD_Bool_Punch.dist, Float_Mul(CAD_Bool_Punch.nz, CAD_Bool_Punch.mz))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Bool_Punch.dist), 1) ThenBlock: {
            CAD_Bool_Punch.dist = Float_Sub(0, CAD_Bool_Punch.dist)
        }
        IfCondition EqualTo(CAD_Num.Le(0x3FE0000000000000, CAD_Bool_Punch.dist), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool.PunchAvg(CAD_Bool_Punch.f0), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.hf0 = CAD_Bool.PunchMatch()
        CAD_Bool_Punch.nx = CAD_Bool_Punch.mx
        CAD_Bool_Punch.ny = CAD_Bool_Punch.my
        CAD_Bool_Punch.nz = CAD_Bool_Punch.mz
        IfCondition EqualTo(CAD_Bool.PunchAvg(CAD_Bool_Punch.f1), 0) ThenBlock: { ReturnValue(0) }
        CAD_Bool_Punch.hf1 = CAD_Bool.PunchMatch()
        IfCondition EqualTo(CAD_Bool_Punch.hf0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Bool_Punch.hf0, CAD_Bool_Punch.hf1) ThenBlock: { ReturnValue(0) }
        // Chord on one host edge: notch that edge.
        // -1: the arc is outside the face. Sewing it would add solid. Refuse.
        CAD_Bool_Punch.ok = CAD_Bool.PunchNotch()
        IfCondition EqualTo(CAD_Bool_Punch.ok, -1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(CAD_Bool_Punch.ok) }
        // Any other profile: subtract only the overlap. A tool that lies
        // fully inside the face is still a hole. Fully outside leaves the host.
        IfCondition EqualTo(CAD_Bool_Punch.arr, 0) ThenBlock: { CAD_Bool_Punch.arr = Allocate(512) }
        IfCondition EqualTo(CAD_Bool_Punch.arr, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Bool_Punch.arr, 48, CAD_Bool_Punch.host)
        ArraySet(CAD_Bool_Punch.arr, 49, CAD_Bool_Punch.tool)
        ArraySet(CAD_Bool_Punch.arr, 50, CAD_Bool_Punch.f0)
        ArraySet(CAD_Bool_Punch.arr, 51, CAD_Bool_Punch.f1)
        ArraySet(CAD_Bool_Punch.arr, 52, CAD_Bool_Punch.hf0)
        ArraySet(CAD_Bool_Punch.arr, 53, CAD_Bool_Punch.hf1)
        CAD_Bool_Punch.ok = CAD_BoolClip.Apply(CAD_Bool_Punch.arr)
        IfCondition EqualTo(CAD_Bool_Punch.ok, -1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Bool_Punch.ok, 0) ThenBlock: { ReturnValue(CAD_Bool_Punch.ok) }
        CAD_Bool_Punch.lp = CAD_Store.Read(CAD_Bool_Punch.f0, 1)
        IfCondition EqualTo(CAD_Bool_Punch.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FaceAppendLoop(CAD_Bool_Punch.hf0, CAD_Bool_Punch.lp)
        CAD_Store.Write(CAD_Bool_Punch.f0, 1, 0)
        IfCondition NotEqual(CAD_Bool_Punch.hf1, 0) ThenBlock: {
            CAD_Bool_Punch.lp = CAD_Store.Read(CAD_Bool_Punch.f1, 1)
            IfCondition NotEqual(CAD_Bool_Punch.lp, 0) ThenBlock: {
                CAD_Topo.FaceAppendLoop(CAD_Bool_Punch.hf1, CAD_Bool_Punch.lp)
                CAD_Store.Write(CAD_Bool_Punch.f1, 1, 0)
            }
        }
        IfCondition EqualTo(CAD_Bool_Punch.arr, 0) ThenBlock: { CAD_Bool_Punch.arr = Allocate(512) }
        IfCondition EqualTo(CAD_Bool_Punch.arr, 0) ThenBlock: { ReturnValue(0) }
        // PunchMatch walks the host and leaves sh at 0. The walls are
        // still on the tool shell.
        CAD_Bool_Punch.sh = CAD_Store.Read(CAD_Bool_Punch.tool, 0)
        CAD_Bool_Punch.n = 0
        CAD_Bool_Punch.face = CAD_Store.Read(CAD_Bool_Punch.sh, 0)
        CAD_Bool_Punch.g = 0
        WhileLoop NotEqual(CAD_Bool_Punch.face, 0) {
            IfCondition GreaterThan(CAD_Bool_Punch.g, 64) ThenBlock: { CAD_Bool_Punch.face = 0 }
            IfCondition NotEqual(CAD_Bool_Punch.face, 0) ThenBlock: {
                CAD_Bool_Punch.v = 1
                IfCondition EqualTo(CAD_Bool_Punch.face, CAD_Bool_Punch.f0) ThenBlock: { CAD_Bool_Punch.v = 0 }
                IfCondition NotEqual(CAD_Bool_Punch.hf1, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Bool_Punch.face, CAD_Bool_Punch.f1) ThenBlock: { CAD_Bool_Punch.v = 0 }
                }
                IfCondition EqualTo(CAD_Bool_Punch.v, 1) ThenBlock: {
                    IfCondition LessThan(CAD_Bool_Punch.n, 64) ThenBlock: {
                        ArraySet(CAD_Bool_Punch.arr, CAD_Bool_Punch.n, CAD_Bool_Punch.face)
                        CAD_Bool_Punch.n = Add(CAD_Bool_Punch.n, 1)
                    }
                }
                CAD_Bool_Punch.ce = CAD_Store.Read(CAD_Bool_Punch.face, 3)
                CAD_Bool_Punch.face = CAD_Bool_Punch.ce
            }
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        CAD_Bool_Punch.g = 0
        WhileLoop LessThan(CAD_Bool_Punch.g, CAD_Bool_Punch.n) {
            CAD_Bool_Punch.face = ArrayGet(CAD_Bool_Punch.arr, CAD_Bool_Punch.g)
            CAD_Topo.ShellUnlinkFace(CAD_Bool_Punch.sh, CAD_Bool_Punch.face)
            CAD_Topo.ShellAppendFace(CAD_Store.Read(CAD_Bool_Punch.host, 0), CAD_Bool_Punch.face)
            CAD_Bool_Punch.g = Add(CAD_Bool_Punch.g, 1)
        }
        ReturnValue(CAD_Bool_Punch.host)
    }
}

