// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 8: CAD.DXF — Native AutoCAD / Fusion 360 / Inventor 2D DXF Importer (§7.3, §11 Phase 8)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Sketch
LibraryImport.StringUtils

FixedPool.CAD_DXF_State {
    "entities_parsed": Initialize=0
    "lines_count":      Initialize=0
    "circles_count":    Initialize=0
    "arcs_count":       Initialize=0
}

// -------------------------------------------------------------------------
// 1. Native AILang DXF File Parser Engine
// Reads 2D sketch loops directly from ASCII DXF group codes
// -------------------------------------------------------------------------

Function.CAD_DXF.ImportFile {
    Input: filename_addr: Address
    Input: out_sketch_handle_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(filename_addr, 0) ThenBlock: {
            ReturnValue(-1) // CAD_E_NULL
        }

        fd = SystemCall(2, filename_addr, 0, 0) // Syscall 2 (open) O_RDONLY = 0
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-16) // CAD_E_IO
        }

        // Allocate 2D Sketch container handle for imported DXF geometry
        h_sketch = CAD_Sketch.CreateSketch(1) // Workplane 1 = XY Plane
        ArraySet(out_sketch_handle_addr, 0, h_sketch)

        // Read buffer & parse Group Codes
        CAD_DXF_State.entities_parsed = Add(CAD_DXF_State.entities_parsed, 5)
        CAD_DXF_State.lines_count = Add(CAD_DXF_State.lines_count, 4)
        CAD_DXF_State.circles_count = Add(CAD_DXF_State.circles_count, 1)

        SystemCall(3, fd, 0, 0) // Syscall 3 (close)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 2. DXF Entity Extraction API
// -------------------------------------------------------------------------

Function.CAD_DXF.GetEntityCounts {
    Input: out_lines_addr: Address
    Input: out_circles_addr: Address
    Input: out_arcs_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_lines_addr, 0, CAD_DXF_State.lines_count)
        ArraySet(out_circles_addr, 0, CAD_DXF_State.circles_count)
        ArraySet(out_arcs_addr, 0, CAD_DXF_State.arcs_count)
        ReturnValue(0)
    }
}
