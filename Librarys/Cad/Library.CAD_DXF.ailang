// CAD.DXF — ASCII DXF import for 2D profiles (LINE / CIRCLE / ARC).
// Pipeline: ImportFile → sketch → tess arcs/circles → closed loop → ExtrudeProfile.
// Real read/parse; z≈0 entities only (2D sketch).

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Sketch
LibraryImport.StringUtils

FixedPool.CAD_DXF_State {
    "entities_parsed": Initialize=0
    "lines_count":      Initialize=0
    "circles_count":    Initialize=0
    "arcs_count":       Initialize=0
    "lwpoly_count":     Initialize=0
    "last_error":       Initialize=0
    "buf":              Initialize=0, CanChange=True
    "buf_len":          Initialize=0, CanChange=True
    "pos":              Initialize=0, CanChange=True
    "line_buf":         Initialize=0, CanChange=True
    "lw_xy":            Initialize=0, CanChange=True
    "lw_bulge":         Initialize=0, CanChange=True
    "lw_n":             Initialize=0, CanChange=True
    "lw_closed":        Initialize=0, CanChange=True
    "lw_expect":        Initialize=0, CanChange=True
}

// Skip spaces/tabs/CR; stop at NL or NUL. Return first non-ws byte or 0.
Function.CAD_DXF.SkipWS {
    Input: ignored: Integer
    Output: Integer
    Body: {
        buf = CAD_DXF_State.buf
        pos = CAD_DXF_State.pos
        len = CAD_DXF_State.buf_len
        WhileLoop LessThan(pos, len) {
            ch = GetByte(buf, pos)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                CAD_DXF_State.pos = pos
                ReturnValue(0)
            }
            IfCondition EqualTo(ch, 10) ThenBlock: {
                CAD_DXF_State.pos = pos
                ReturnValue(10)
            }
            IfCondition EqualTo(ch, 13) ThenBlock: {
                pos = Add(pos, 1)
            }
            IfCondition EqualTo(ch, 32) ThenBlock: {
                pos = Add(pos, 1)
            }
            IfCondition EqualTo(ch, 9) ThenBlock: {
                pos = Add(pos, 1)
            }
            // non-ws
            IfCondition NotEqual(ch, 32) ThenBlock: {
                IfCondition NotEqual(ch, 9) ThenBlock: {
                    IfCondition NotEqual(ch, 13) ThenBlock: {
                        IfCondition NotEqual(ch, 10) ThenBlock: {
                            CAD_DXF_State.pos = pos
                            ReturnValue(ch)
                        }
                    }
                }
            }
        }
        CAD_DXF_State.pos = pos
        ReturnValue(0)
    }
}

// Copy next line (to NL) into line_buf, NUL-terminate. Advances pos past NL.
// Returns length (0 if EOF).
Function.CAD_DXF.ReadLine {
    Input: ignored: Integer
    Output: Integer
    Body: {
        buf = CAD_DXF_State.buf
        pos = CAD_DXF_State.pos
        len = CAD_DXF_State.buf_len
        lb = CAD_DXF_State.line_buf
        i = 0
        WhileLoop LessThan(pos, len) {
            ch = GetByte(buf, pos)
            pos = Add(pos, 1)
            IfCondition EqualTo(ch, 10) ThenBlock: {
                // done
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    // strip trailing CR
                    IfCondition EqualTo(GetByte(lb, Subtract(i, 1)), 13) ThenBlock: {
                        i = Subtract(i, 1)
                    }
                }
                SetByte(lb, i, 0)
                CAD_DXF_State.pos = pos
                ReturnValue(i)
            }
            IfCondition LessThan(i, 250) ThenBlock: {
                IfCondition NotEqual(ch, 13) ThenBlock: {
                    SetByte(lb, i, ch)
                    i = Add(i, 1)
                }
            }
        }
        SetByte(lb, i, 0)
        CAD_DXF_State.pos = pos
        ReturnValue(i)
    }
}

// Parse line_buf as [+/-]digits[.digits][E+/-digits] → IEEE double bits.
Function.CAD_DXF.ParseFloatLineCore {
    Input: ignored: Integer
    Output: Integer
    Body: {
        lb = CAD_DXF_State.line_buf
        i = 0
        WhileLoop EqualTo(GetByte(lb, i), 32) {
            i = Add(i, 1)
        }
        sign = 1
        IfCondition EqualTo(GetByte(lb, i), 45) ThenBlock: {
            sign = 0
            i = Add(i, 1)
        }
        IfCondition EqualTo(GetByte(lb, i), 43) ThenBlock: {
            i = Add(i, 1)
        }
        ipart = 0
        dig = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(lb, i)
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                ipart = Add(Multiply(ipart, 10), Subtract(ch, 48))
                dig = Add(dig, 1)
                i = Add(i, 1)
            }
        }
        fpart = 0
        fdiv = 1
        IfCondition EqualTo(GetByte(lb, i), 46) ThenBlock: {
            i = Add(i, 1)
            done = 0
            WhileLoop EqualTo(done, 0) {
                ch = GetByte(lb, i)
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition EqualTo(done, 0) ThenBlock: {
                    fpart = Add(Multiply(fpart, 10), Subtract(ch, 48))
                    fdiv = Multiply(fdiv, 10)
                    i = Add(i, 1)
                }
            }
        }
        // scientific E+nn / E-nn (common in DXF)
        expv = 0
        exps = 1
        ch = GetByte(lb, i)
        IfCondition EqualTo(ch, 69) ThenBlock: {
            i = Add(i, 1)
            ch = GetByte(lb, i)
            IfCondition EqualTo(ch, 101) ThenBlock: { i = i }
        }
        ch = GetByte(lb, i)
        ise = 0
        IfCondition EqualTo(ch, 69) ThenBlock: { ise = 1 }
        IfCondition EqualTo(ch, 101) ThenBlock: { ise = 1 }
        // re-check after possible already advanced — handle E
        // rewind: scan for E
        // simpler: if current is E/e
        IfCondition EqualTo(ise, 0) ThenBlock: {
            // also if we already consumed nothing for E
            ch = GetByte(lb, i)
            IfCondition EqualTo(ch, 69) ThenBlock: { ise = 1 }
            IfCondition EqualTo(ch, 101) ThenBlock: { ise = 1 }
        }
        IfCondition EqualTo(ise, 1) ThenBlock: {
            i = Add(i, 1)
            IfCondition EqualTo(GetByte(lb, i), 45) ThenBlock: {
                exps = 0
                i = Add(i, 1)
            }
            IfCondition EqualTo(GetByte(lb, i), 43) ThenBlock: {
                i = Add(i, 1)
            }
            done = 0
            WhileLoop EqualTo(done, 0) {
                ch = GetByte(lb, i)
                IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
                IfCondition EqualTo(done, 0) ThenBlock: {
                    expv = Add(Multiply(expv, 10), Subtract(ch, 48))
                    i = Add(i, 1)
                }
            }
        }
        // value = sign * (ipart + fpart/fdiv) * 10^exp
        one = 0x3FF0000000000000
        ten = 0x4024000000000000
        r = Float_FromInt(ipart)
        IfCondition GreaterThan(fdiv, 1) ThenBlock: {
            r = Float_Add(r, Float_Div(Float_FromInt(fpart), Float_FromInt(fdiv)))
        }
        // apply exponent
        e = 0
        WhileLoop LessThan(e, expv) {
            IfCondition EqualTo(exps, 1) ThenBlock: {
                r = Float_Mul(r, ten)
            }
            IfCondition EqualTo(exps, 0) ThenBlock: {
                r = Float_Div(r, ten)
            }
            e = Add(e, 1)
        }
        IfCondition EqualTo(sign, 0) ThenBlock: {
            r = Float_Sub(0, r)
        }
        // no digits → 0
        IfCondition EqualTo(dig, 0) ThenBlock: {
            IfCondition EqualTo(fdiv, 1) ThenBlock: {
                r = 0
            }
        }
        ReturnValue(r)
    }
}

// Read entire fd into 256 KiB buffer (loops until EOF — pipe-safe).
// Writes buf ptr / length; caller frees buf with Deallocate(buf, 262144).
// Returns nread (>=0) or -1 on alloc/empty failure.
Function.CAD_DXF.ReadAllFd {
    Input: fd: Integer
    Input: out_buf_addr: Address
    Input: out_len_addr: Address
    Output: Integer
    Body: {
        buf = Allocate(262144)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            ArraySet(out_buf_addr, 0, 0)
            ArraySet(out_len_addr, 0, 0)
            ReturnValue(-1)
        }
        total = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition GreaterEqual(total, 262143) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                n = CAD_Sys.Read(fd, Add(buf, total), Subtract(262143, total))
                IfCondition LessEqual(n, 0) ThenBlock: { done = 1 }
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    total = Add(total, n)
                }
            }
        }
        IfCondition LessThan(total, 8) ThenBlock: {
            Deallocate(buf, 262144)
            ArraySet(out_buf_addr, 0, 0)
            ArraySet(out_len_addr, 0, 0)
            ReturnValue(-1)
        }
        SetByte(buf, total, 0)
        ArraySet(out_buf_addr, 0, buf)
        ArraySet(out_len_addr, 0, total)
        ReturnValue(total)
    }
}

// Parse already-loaded DXF bytes → sketch (LINE + CIRCLE + closed loop).
// Takes ownership of buf (frees 262144). Returns 0 ok, negative error.
Function.CAD_DXF.ImportBuffer {
    Input: buf_addr: Address
    Input: nread: Integer
    Input: out_sketch_handle_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(buf_addr, 0) ThenBlock: {
            CAD_DXF_State.last_error = -1
            ReturnValue(-1)
        }
        IfCondition LessThan(nread, 8) ThenBlock: {
            Deallocate(buf_addr, 262144)
            CAD_DXF_State.last_error = -16
            ReturnValue(-16)
        }
        CAD_DXF_State.buf = buf_addr
        CAD_DXF_State.buf_len = nread
        CAD_DXF_State.pos = 0
        lb = Allocate(256)
        CAD_DXF_State.line_buf = lb

        h_sk = CAD_Sketch.CreateSketch(1)
        ArraySet(out_sketch_handle_addr, 0, h_sk)

        CAD_DXF_State.lines_count = 0
        CAD_DXF_State.circles_count = 0
        CAD_DXF_State.arcs_count = 0
        CAD_DXF_State.lwpoly_count = 0
        CAD_DXF_State.entities_parsed = 0
        CAD_DXF_State.lw_xy = Allocate(4096)
        CAD_DXF_State.lw_bulge = Allocate(2048)
        CAD_DXF_State.lw_n = 0
        CAD_DXF_State.lw_closed = 0
        CAD_DXF_State.lw_expect = 0

        // parse state for LINE / CIRCLE / ARC / LWPOLYLINE
        in_ents = 0
        in_line = 0
        in_circle = 0
        in_arc = 0
        in_lwp = 0
        x1 = 0
        y1 = 0
        x2 = 0
        y2 = 0
        z1 = 0
        z2 = 0
        cx = 0
        cy = 0
        cz = 0
        rad = 0
        a0deg = 0
        a1deg = 0
        have10 = 0
        have11 = 0
        have10c = 0
        have40 = 0
        have50 = 0
        have51 = 0

        // scan group pairs
        guard = 0
        WhileLoop LessThan(guard, 100000) {
            guard = Add(guard, 1)
            n1 = CAD_DXF.ReadLine(0)
            IfCondition EqualTo(n1, 0) ThenBlock: {
                // eof if pos at end
                IfCondition GreaterEqual(CAD_DXF_State.pos, CAD_DXF_State.buf_len) ThenBlock: {
                    guard = 100000
                }
            }
            IfCondition LessThan(guard, 100000) ThenBlock: {
                // parse group code integer from line_buf
                gcode = 0
                li = 0
                lb2 = CAD_DXF_State.line_buf
                WhileLoop EqualTo(GetByte(lb2, li), 32) {
                    li = Add(li, 1)
                }
                doneg = 0
                WhileLoop EqualTo(doneg, 0) {
                    ch = GetByte(lb2, li)
                    IfCondition LessThan(ch, 48) ThenBlock: { doneg = 1 }
                    IfCondition GreaterThan(ch, 57) ThenBlock: { doneg = 1 }
                    IfCondition EqualTo(doneg, 0) ThenBlock: {
                        gcode = Add(Multiply(gcode, 10), Subtract(ch, 48))
                        li = Add(li, 1)
                    }
                }
                n2 = CAD_DXF.ReadLine(0)
                // value in line_buf
                // SECTION / ENTITIES tracking
                IfCondition EqualTo(gcode, 0) ThenBlock: {
                    // flush previous LINE if complete
                    IfCondition EqualTo(in_line, 1) ThenBlock: {
                        IfCondition EqualTo(have10, 1) ThenBlock: {
                            IfCondition EqualTo(have11, 1) ThenBlock: {
                                okz = 1
                                IfCondition EqualTo(CAD_Num.IsEqual(z1, 0, 0), 0) ThenBlock: { okz = 0 }
                                IfCondition EqualTo(CAD_Num.IsEqual(z2, 0, 0), 0) ThenBlock: { okz = 0 }
                                IfCondition EqualTo(okz, 1) ThenBlock: {
                                    CAD_Sketch.AddLine(h_sk, x1, y1, x2, y2)
                                    CAD_DXF_State.lines_count = Add(CAD_DXF_State.lines_count, 1)
                                    CAD_DXF_State.entities_parsed = Add(CAD_DXF_State.entities_parsed, 1)
                                }
                            }
                        }
                    }
                    // flush previous CIRCLE
                    IfCondition EqualTo(in_circle, 1) ThenBlock: {
                        IfCondition EqualTo(have10c, 1) ThenBlock: {
                            IfCondition EqualTo(have40, 1) ThenBlock: {
                                okz = 1
                                IfCondition EqualTo(CAD_Num.IsEqual(cz, 0, 0), 0) ThenBlock: { okz = 0 }
                                IfCondition EqualTo(okz, 1) ThenBlock: {
                                    CAD_Sketch.AddCircle(h_sk, cx, cy, rad)
                                    CAD_DXF_State.circles_count = Add(CAD_DXF_State.circles_count, 1)
                                    CAD_DXF_State.entities_parsed = Add(CAD_DXF_State.entities_parsed, 1)
                                }
                            }
                        }
                    }
                    // flush previous ARC (angles degrees → radians)
                    IfCondition EqualTo(in_arc, 1) ThenBlock: {
                        IfCondition EqualTo(have10c, 1) ThenBlock: {
                            IfCondition EqualTo(have40, 1) ThenBlock: {
                                IfCondition EqualTo(have50, 1) ThenBlock: {
                                    IfCondition EqualTo(have51, 1) ThenBlock: {
                                        okz = 1
                                        IfCondition EqualTo(CAD_Num.IsEqual(cz, 0, 0), 0) ThenBlock: { okz = 0 }
                                        IfCondition EqualTo(okz, 1) ThenBlock: {
                                            d2r = 0x3F91DF46A2529D39
                                            ar0 = Float_Mul(a0deg, d2r)
                                            ar1 = Float_Mul(a1deg, d2r)
                                            CAD_Sketch.AddArc(h_sk, cx, cy, rad, ar0, ar1)
                                            CAD_DXF_State.arcs_count = Add(CAD_DXF_State.arcs_count, 1)
                                            CAD_DXF_State.entities_parsed = Add(CAD_DXF_State.entities_parsed, 1)
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // flush LWPOLYLINE → lines/arcs via bulge
                    IfCondition EqualTo(in_lwp, 1) ThenBlock: {
                        CAD_DXF.FlushLWPolyline(h_sk)
                    }
                    in_line = 0
                    in_circle = 0
                    in_arc = 0
                    in_lwp = 0
                    have10 = 0
                    have11 = 0
                    have10c = 0
                    have40 = 0
                    have50 = 0
                    have51 = 0
                    // LINE
                    IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 0), 76) ThenBlock: {
                        IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 1), 73) ThenBlock: {
                            IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 2), 78) ThenBlock: {
                                IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 3), 69) ThenBlock: {
                                    in_line = 1
                                    x1 = 0
                                    y1 = 0
                                    x2 = 0
                                    y2 = 0
                                    z1 = 0
                                    z2 = 0
                                }
                            }
                        }
                    }
                    // CIRCLE
                    IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 0), 67) ThenBlock: {
                        IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 1), 73) ThenBlock: {
                            IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 2), 82) ThenBlock: {
                                IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 3), 67) ThenBlock: {
                                    in_circle = 1
                                    cx = 0
                                    cy = 0
                                    cz = 0
                                    rad = 0
                                }
                            }
                        }
                    }
                    // ARC
                    IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 0), 65) ThenBlock: {
                        IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 1), 82) ThenBlock: {
                            IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 2), 67) ThenBlock: {
                                in_arc = 1
                                cx = 0
                                cy = 0
                                cz = 0
                                rad = 0
                                a0deg = 0
                                a1deg = 0
                            }
                        }
                    }
                    // LWPOLYLINE
                    IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 0), 76) ThenBlock: {
                        IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 1), 87) ThenBlock: {
                            IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 2), 80) ThenBlock: {
                                in_lwp = 1
                                CAD_DXF_State.lw_n = 0
                                CAD_DXF_State.lw_closed = 0
                                CAD_DXF_State.lw_expect = 0
                            }
                        }
                    }
                    // ENDSEC
                    IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 0), 69) ThenBlock: {
                        IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 1), 78) ThenBlock: {
                            IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 2), 68) ThenBlock: {
                                IfCondition EqualTo(in_ents, 1) ThenBlock: {
                                    in_ents = 0
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(gcode, 2) ThenBlock: {
                    // section name
                    IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 0), 69) ThenBlock: {
                        IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 1), 78) ThenBlock: {
                            IfCondition EqualTo(GetByte(CAD_DXF_State.line_buf, 2), 84) ThenBlock: {
                                in_ents = 1
                            }
                        }
                    }
                }
                IfCondition EqualTo(in_line, 1) ThenBlock: {
                    IfCondition EqualTo(gcode, 10) ThenBlock: {
                        x1 = CAD_DXF.ParseFloatLineCore(0)
                        have10 = 1
                    }
                    IfCondition EqualTo(gcode, 20) ThenBlock: {
                        y1 = CAD_DXF.ParseFloatLineCore(0)
                    }
                    IfCondition EqualTo(gcode, 30) ThenBlock: {
                        z1 = CAD_DXF.ParseFloatLineCore(0)
                    }
                    IfCondition EqualTo(gcode, 11) ThenBlock: {
                        x2 = CAD_DXF.ParseFloatLineCore(0)
                        have11 = 1
                    }
                    IfCondition EqualTo(gcode, 21) ThenBlock: {
                        y2 = CAD_DXF.ParseFloatLineCore(0)
                    }
                    IfCondition EqualTo(gcode, 31) ThenBlock: {
                        z2 = CAD_DXF.ParseFloatLineCore(0)
                    }
                }
                IfCondition EqualTo(in_circle, 1) ThenBlock: {
                    IfCondition EqualTo(gcode, 10) ThenBlock: {
                        cx = CAD_DXF.ParseFloatLineCore(0)
                        have10c = 1
                    }
                    IfCondition EqualTo(gcode, 20) ThenBlock: {
                        cy = CAD_DXF.ParseFloatLineCore(0)
                    }
                    IfCondition EqualTo(gcode, 30) ThenBlock: {
                        cz = CAD_DXF.ParseFloatLineCore(0)
                    }
                    IfCondition EqualTo(gcode, 40) ThenBlock: {
                        rad = CAD_DXF.ParseFloatLineCore(0)
                        have40 = 1
                    }
                }
                IfCondition EqualTo(in_arc, 1) ThenBlock: {
                    IfCondition EqualTo(gcode, 10) ThenBlock: {
                        cx = CAD_DXF.ParseFloatLineCore(0)
                        have10c = 1
                    }
                    IfCondition EqualTo(gcode, 20) ThenBlock: {
                        cy = CAD_DXF.ParseFloatLineCore(0)
                    }
                    IfCondition EqualTo(gcode, 30) ThenBlock: {
                        cz = CAD_DXF.ParseFloatLineCore(0)
                    }
                    IfCondition EqualTo(gcode, 40) ThenBlock: {
                        rad = CAD_DXF.ParseFloatLineCore(0)
                        have40 = 1
                    }
                    IfCondition EqualTo(gcode, 50) ThenBlock: {
                        a0deg = CAD_DXF.ParseFloatLineCore(0)
                        have50 = 1
                    }
                    IfCondition EqualTo(gcode, 51) ThenBlock: {
                        a1deg = CAD_DXF.ParseFloatLineCore(0)
                        have51 = 1
                    }
                }
                IfCondition EqualTo(in_lwp, 1) ThenBlock: {
                    IfCondition EqualTo(gcode, 90) ThenBlock: {
                        CAD_DXF_State.lw_expect = CAD_DXF.ParseIntLineCore(0)
                    }
                    IfCondition EqualTo(gcode, 70) ThenBlock: {
                        fl = CAD_DXF.ParseIntLineCore(0)
                        CAD_DXF_State.lw_closed = BitwiseAnd(fl, 1)
                    }
                    IfCondition EqualTo(gcode, 10) ThenBlock: {
                        // new vertex x; bulge defaults 0
                        n = CAD_DXF_State.lw_n
                        IfCondition LessThan(n, 256) ThenBlock: {
                            ArraySet(CAD_DXF_State.lw_xy, Multiply(n, 2), CAD_DXF.ParseFloatLineCore(0))
                            ArraySet(CAD_DXF_State.lw_bulge, n, 0)
                            CAD_DXF_State.lw_n = Add(n, 1)
                        }
                    }
                    IfCondition EqualTo(gcode, 20) ThenBlock: {
                        n = CAD_DXF_State.lw_n
                        IfCondition GreaterThan(n, 0) ThenBlock: {
                            ArraySet(CAD_DXF_State.lw_xy, Add(Multiply(Subtract(n, 1), 2), 1), CAD_DXF.ParseFloatLineCore(0))
                        }
                    }
                    IfCondition EqualTo(gcode, 42) ThenBlock: {
                        n = CAD_DXF_State.lw_n
                        IfCondition GreaterThan(n, 0) ThenBlock: {
                            ArraySet(CAD_DXF_State.lw_bulge, Subtract(n, 1), CAD_DXF.ParseFloatLineCore(0))
                        }
                    }
                }
            }
        }
        // flush last LINE
        IfCondition EqualTo(in_line, 1) ThenBlock: {
            IfCondition EqualTo(have10, 1) ThenBlock: {
                IfCondition EqualTo(have11, 1) ThenBlock: {
                    okz = 1
                    IfCondition EqualTo(CAD_Num.IsEqual(z1, 0, 0), 0) ThenBlock: { okz = 0 }
                    IfCondition EqualTo(CAD_Num.IsEqual(z2, 0, 0), 0) ThenBlock: { okz = 0 }
                    IfCondition EqualTo(okz, 1) ThenBlock: {
                        CAD_Sketch.AddLine(h_sk, x1, y1, x2, y2)
                        CAD_DXF_State.lines_count = Add(CAD_DXF_State.lines_count, 1)
                    }
                }
            }
        }
        // flush last CIRCLE
        IfCondition EqualTo(in_circle, 1) ThenBlock: {
            IfCondition EqualTo(have10c, 1) ThenBlock: {
                IfCondition EqualTo(have40, 1) ThenBlock: {
                    okz = 1
                    IfCondition EqualTo(CAD_Num.IsEqual(cz, 0, 0), 0) ThenBlock: { okz = 0 }
                    IfCondition EqualTo(okz, 1) ThenBlock: {
                        CAD_Sketch.AddCircle(h_sk, cx, cy, rad)
                        CAD_DXF_State.circles_count = Add(CAD_DXF_State.circles_count, 1)
                    }
                }
            }
        }
        // flush last ARC
        IfCondition EqualTo(in_arc, 1) ThenBlock: {
            IfCondition EqualTo(have10c, 1) ThenBlock: {
                IfCondition EqualTo(have40, 1) ThenBlock: {
                    IfCondition EqualTo(have50, 1) ThenBlock: {
                        IfCondition EqualTo(have51, 1) ThenBlock: {
                            okz = 1
                            IfCondition EqualTo(CAD_Num.IsEqual(cz, 0, 0), 0) ThenBlock: { okz = 0 }
                            IfCondition EqualTo(okz, 1) ThenBlock: {
                                d2r = 0x3F91DF46A2529D39
                                ar0 = Float_Mul(a0deg, d2r)
                                ar1 = Float_Mul(a1deg, d2r)
                                CAD_Sketch.AddArc(h_sk, cx, cy, rad, ar0, ar1)
                                CAD_DXF_State.arcs_count = Add(CAD_DXF_State.arcs_count, 1)
                            }
                        }
                    }
                }
            }
        }

        // flush trailing LWPOLYLINE
        IfCondition EqualTo(in_lwp, 1) ThenBlock: {
            CAD_DXF.FlushLWPolyline(h_sk)
        }

        // Tessellate arcs/circles → LINEs, then all closed loops (multi-profile)
        na = CAD_DXF_State.arcs_count
        nc = CAD_DXF_State.circles_count
        IfCondition GreaterThan(na, 0) ThenBlock: {
            CAD_Sketch.TessellateArcs(h_sk, 32)
        }
        IfCondition GreaterThan(nc, 0) ThenBlock: {
            nl2 = CAD_Sketch.GetLineCount(h_sk)
            IfCondition GreaterThan(nl2, 0) ThenBlock: {
                CAD_Sketch.TessellateCircles(h_sk, 32)
            }
        }
        npf = CAD_Sketch.BuildAllClosedLoops(h_sk)
        Deallocate(CAD_DXF_State.line_buf, 256)
        Deallocate(CAD_DXF_State.buf, 262144)
        Deallocate(CAD_DXF_State.lw_xy, 4096)
        Deallocate(CAD_DXF_State.lw_bulge, 2048)
        CAD_DXF_State.buf = 0
        CAD_DXF_State.line_buf = 0
        CAD_DXF_State.lw_xy = 0
        CAD_DXF_State.lw_bulge = 0
        // success: closed loop OR pure circle solid path
        np = CAD_Sketch.GetLoopCount(h_sk)
        IfCondition LessThan(np, 3) ThenBlock: {
            IfCondition LessThan(nc, 1) ThenBlock: {
                CAD_DXF_State.last_error = -2
                ReturnValue(-2)
            }
        }
        ReturnValue(0)
    }
}

// Integer from line_buf (group 70/90)
Function.CAD_DXF.ParseIntLineCore {
    Input: ignored: Integer
    Output: Integer
    Body: {
        lb = CAD_DXF_State.line_buf
        i = 0
        WhileLoop EqualTo(GetByte(lb, i), 32) {
            i = Add(i, 1)
        }
        sign = 1
        IfCondition EqualTo(GetByte(lb, i), 45) ThenBlock: {
            sign = -1
            i = Add(i, 1)
        }
        v = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(lb, i)
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
            IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                v = Add(Multiply(v, 10), Subtract(ch, 48))
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(sign, -1) ThenBlock: { v = Subtract(0, v) }
        ReturnValue(v)
    }
}

// Emit LWPOLYLINE verts as sketch lines/arcs (bulge).
Function.CAD_DXF.FlushLWPolyline {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        n = CAD_DXF_State.lw_n
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(0) }
        closed = CAD_DXF_State.lw_closed
        xy = CAD_DXF_State.lw_xy
        bg = CAD_DXF_State.lw_bulge
        pack = Allocate(64)
        nseg = n
        IfCondition EqualTo(closed, 0) ThenBlock: { nseg = Subtract(n, 1) }
        i = 0
        WhileLoop LessThan(i, nseg) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            ArraySet(pack, 0, ArrayGet(xy, Multiply(i, 2)))
            ArraySet(pack, 1, ArrayGet(xy, Add(Multiply(i, 2), 1)))
            ArraySet(pack, 2, ArrayGet(xy, Multiply(j, 2)))
            ArraySet(pack, 3, ArrayGet(xy, Add(Multiply(j, 2), 1)))
            ArraySet(pack, 4, ArrayGet(bg, i))
            CAD_Sketch.AddBulgeSegment(sketch_handle, pack)
            CAD_DXF_State.lines_count = Add(CAD_DXF_State.lines_count, 1)
            i = Add(i, 1)
        }
        CAD_DXF_State.lwpoly_count = Add(CAD_DXF_State.lwpoly_count, 1)
        CAD_DXF_State.entities_parsed = Add(CAD_DXF_State.entities_parsed, 1)
        Deallocate(pack, 64)
        ReturnValue(0)
    }
}

// Export sketch as ASCII DXF (LINE + CIRCLE + ARC entities). Returns 0 ok.
Function.CAD_DXF.ExportSketch {
    Input: sketch_handle: Integer
    Input: filename_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(filename_addr, 0) ThenBlock: { ReturnValue(-1) }
        fd = CAD_Sys.Open(filename_addr, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-16) }
        CAD_DXF.WriteStr(fd, "  0\nSECTION\n  2\nENTITIES\n")
        // lines
        nl = CAD_Store.Read(sketch_handle, 0)
        lines = CAD_Store.Read(sketch_handle, 1)
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            CAD_DXF.WriteStr(fd, "  0\nLINE\n  8\n0\n")
            CAD_DXF.WriteGroupFloat(fd, 10, ArrayGet(lines, b))
            CAD_DXF.WriteGroupFloat(fd, 20, ArrayGet(lines, Add(b, 1)))
            CAD_DXF.WriteStr(fd, "  30\n0.0\n")
            CAD_DXF.WriteGroupFloat(fd, 11, ArrayGet(lines, Add(b, 2)))
            CAD_DXF.WriteGroupFloat(fd, 21, ArrayGet(lines, Add(b, 3)))
            CAD_DXF.WriteStr(fd, "  31\n0.0\n")
            i = Add(i, 1)
        }
        // circles
        nc = CAD_Store.Read(sketch_handle, 7)
        circs = CAD_Store.Read(sketch_handle, 8)
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 3)
            CAD_DXF.WriteStr(fd, "  0\nCIRCLE\n  8\n0\n")
            CAD_DXF.WriteGroupFloat(fd, 10, ArrayGet(circs, b))
            CAD_DXF.WriteGroupFloat(fd, 20, ArrayGet(circs, Add(b, 1)))
            CAD_DXF.WriteStr(fd, "  30\n0.0\n")
            CAD_DXF.WriteGroupFloat(fd, 40, ArrayGet(circs, Add(b, 2)))
            i = Add(i, 1)
        }
        // arcs (rad → deg)
        na = CAD_Store.Read(sketch_handle, 10)
        arcs = CAD_Store.Read(sketch_handle, 11)
        r2d = 0x404CA5DC1A63C1F8
        i = 0
        WhileLoop LessThan(i, na) {
            b = Multiply(i, 5)
            CAD_DXF.WriteStr(fd, "  0\nARC\n  8\n0\n")
            CAD_DXF.WriteGroupFloat(fd, 10, ArrayGet(arcs, b))
            CAD_DXF.WriteGroupFloat(fd, 20, ArrayGet(arcs, Add(b, 1)))
            CAD_DXF.WriteStr(fd, "  30\n0.0\n")
            CAD_DXF.WriteGroupFloat(fd, 40, ArrayGet(arcs, Add(b, 2)))
            CAD_DXF.WriteGroupFloat(fd, 50, Float_Mul(ArrayGet(arcs, Add(b, 3)), r2d))
            CAD_DXF.WriteGroupFloat(fd, 51, Float_Mul(ArrayGet(arcs, Add(b, 4)), r2d))
            i = Add(i, 1)
        }
        CAD_DXF.WriteStr(fd, "  0\nENDSEC\n  0\nEOF\n")
        CAD_Sys.Close(fd)
        ReturnValue(0)
    }
}

Function.CAD_DXF.WriteStr {
    Input: fd: Integer
    Input: s: Address
    Output: Integer
    Body: {
        ReturnValue(CAD_Sys.Write(fd, s, StringLength(s)))
    }
}

Function.CAD_DXF.WriteGroupFloat {
    Input: fd: Integer
    Input: code: Integer
    Input: val_r: Integer
    Output: Integer
    Body: {
        // "  code\n" then float via crude NumberToString on int part only + fixed
        // Use CAD_IO-like: write code as decimal
        buf = Allocate(64)
        // group code line
        SetByte(buf, 0, 32)
        SetByte(buf, 1, 32)
        // write code digits
        c = code
        // assume code < 100
        IfCondition GreaterEqual(c, 10) ThenBlock: {
            SetByte(buf, 2, Add(48, Divide(c, 10)))
            SetByte(buf, 3, Add(48, Modulo(c, 10)))
            SetByte(buf, 4, 10)
            CAD_Sys.Write(fd, buf, 5)
        }
        IfCondition LessThan(c, 10) ThenBlock: {
            SetByte(buf, 2, Add(48, c))
            SetByte(buf, 3, 10)
            CAD_Sys.Write(fd, buf, 4)
        }
        // value: Integer part . 6 decimals via Float_ToInt tricks
        iv = Float_ToInt(val_r)
        neg = 0
        IfCondition LessThan(iv, 0) ThenBlock: {
            neg = 1
            iv = Subtract(0, iv)
        }
        // fractional * 1e6
        whole_r = Float_FromInt(Float_ToInt(val_r))
        // handle negative float
        sign_f = 0
        vr = val_r
        IfCondition NotEqual(BitwiseAnd(val_r, 0x8000000000000000), 0) ThenBlock: {
            sign_f = 1
            vr = BitwiseAnd(val_r, 0x7FFFFFFFFFFFFFFF)
            iv = Float_ToInt(vr)
        }
        frac_r = Float_Sub(vr, Float_FromInt(iv))
        milli = Float_ToInt(Float_Mul(frac_r, 0x412E848000000000))
        IfCondition EqualTo(sign_f, 1) ThenBlock: {
            CAD_Sys.Write(fd, "-", 1)
        }
        s = NumberToString(iv)
        CAD_Sys.Write(fd, s, StringLength(s))
        CAD_Sys.Write(fd, ".", 1)
        // pad milli to 6 digits roughly use NumberToString
        IfCondition LessThan(milli, 0) ThenBlock: { milli = 0 }
        sm = NumberToString(milli)
        // crude pad
        ln = StringLength(sm)
        WhileLoop LessThan(ln, 6) {
            CAD_Sys.Write(fd, "0", 1)
            ln = Add(ln, 1)
        }
        CAD_Sys.Write(fd, sm, StringLength(sm))
        CAD_Sys.Write(fd, "\n", 1)
        Deallocate(buf, 64)
        ReturnValue(0)
    }
}

// Import DXF from open fd (does not close fd). Pipe/stdin safe.
Function.CAD_DXF.ImportFd {
    Input: fd: Integer
    Input: out_sketch_handle_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(fd, 0) ThenBlock: {
            CAD_DXF_State.last_error = -16
            ReturnValue(-16)
        }
        slot_b = Allocate(8)
        slot_n = Allocate(8)
        nread = CAD_DXF.ReadAllFd(fd, slot_b, slot_n)
        buf = ArrayGet(slot_b, 0)
        Deallocate(slot_b, 8)
        Deallocate(slot_n, 8)
        IfCondition LessThan(nread, 8) ThenBlock: {
            CAD_DXF_State.last_error = -16
            ReturnValue(-16)
        }
        ReturnValue(CAD_DXF.ImportBuffer(buf, nread, out_sketch_handle_addr))
    }
}

// Import ASCII DXF path → sketch handle with LINEs + closed loop.
// Returns 0 ok, negative error. Writes sketch handle to out_addr.
Function.CAD_DXF.ImportFile {
    Input: filename_addr: Address
    Input: out_sketch_handle_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(filename_addr, 0) ThenBlock: {
            CAD_DXF_State.last_error = -1
            ReturnValue(-1)
        }
        fd = CAD_Sys.Open(filename_addr, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            CAD_DXF_State.last_error = -16
            ReturnValue(-16)
        }
        rc = CAD_DXF.ImportFd(fd, out_sketch_handle_addr)
        CAD_Sys.Close(fd)
        ReturnValue(rc)
    }
}

Function.CAD_DXF.GetEntityCounts {
    Input: out_lines_addr: Address
    Input: out_circles_addr: Address
    Input: out_arcs_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_lines_addr, 0, CAD_DXF_State.lines_count)
        ArraySet(out_circles_addr, 0, CAD_DXF_State.circles_count)
        ArraySet(out_arcs_addr, 0, CAD_DXF_State.arcs_count)
        ReturnValue(0)
    }
}
