// CAD.Err — kernel error record + IPC drop for the Gtk host.
// Host already polls /tmp/cad_app/notice.txt (status bar). Do not change gtk.
// Raise from the failing function. Add sources one family at a time.
//
//   LibraryImport.Cad.CAD_Err
//   CAD_Err.Fillet(reason)     // first family
//   CAD_Err.RaiseS(code, src, msg)
//   CAD_Err.Clear()
//
// src: 1=fillet  (pad/glue/sketch later)
// code 0 = none after Clear; Fillet(0) is still a refuse.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Sys

FixedPool.CAD_Err_State {
    "code":  Initialize=0, CanChange=True
    "src":   Initialize=0, CanChange=True
    "n":     Initialize=0, CanChange=True
    "seq":   Initialize=0, CanChange=True
    "msg":   Initialize=0, CanChange=True
}

Function.CAD_Err.Ensure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Err_State.msg, 0) ThenBlock: {
            CAD_Err_State.msg = Allocate(256)
        }
        IfCondition EqualTo(CAD_Err_State.msg, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Err.Len {
    Input: msg: Address
    Output: Integer
    Body: {
        n = 0
        IfCondition EqualTo(msg, 0) ThenBlock: { ReturnValue(0) }
        WhileLoop LessThan(n, 240) {
            IfCondition EqualTo(GetByte(msg, n), 0) ThenBlock: { ReturnValue(n) }
            n = Add(n, 1)
        }
        ReturnValue(n)
    }
}

Function.CAD_Err.Publish {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Err.Ensure(), 0) ThenBlock: { ReturnValue(-1) }
        fd = CAD_Sys.Open("/tmp/cad_app/notice.txt", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(CAD_Err_State.n, 0) ThenBlock: {
            CAD_Sys.Write(fd, CAD_Err_State.msg, CAD_Err_State.n)
        }
        CAD_Sys.Close(fd)
        ReturnValue(0)
    }
}

Function.CAD_Err.Clear {
    Output: Integer
    Body: {
        CAD_Err_State.code = 0
        CAD_Err_State.src = 0
        CAD_Err_State.n = 0
        IfCondition NotEqual(CAD_Err_State.msg, 0) ThenBlock: {
            SetByte(CAD_Err_State.msg, 0, 0)
        }
        CAD_Err.Publish()
        ReturnValue(0)
    }
}

Function.CAD_Err.Raise {
    Input: code: Integer
    Input: src: Integer
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Err.Ensure(), 0) ThenBlock: { ReturnValue(-1) }
        CAD_Err_State.code = code
        CAD_Err_State.src = src
        nn = n
        IfCondition GreaterThan(nn, 240) ThenBlock: { nn = 240 }
        IfCondition LessThan(nn, 0) ThenBlock: { nn = 0 }
        i = 0
        WhileLoop LessThan(i, nn) {
            SetByte(CAD_Err_State.msg, i, GetByte(msg, i))
            i = Add(i, 1)
        }
        SetByte(CAD_Err_State.msg, nn, 0)
        CAD_Err_State.n = nn
        CAD_Err_State.seq = Add(CAD_Err_State.seq, 1)
        IfCondition GreaterThan(nn, 0) ThenBlock: {
            CAD_Sys.Write(2, CAD_Err_State.msg, nn)
        }
        CAD_Err.Publish()
        ReturnValue(code)
    }
}

Function.CAD_Err.RaiseS {
    Input: code: Integer
    Input: src: Integer
    Input: msg: Address
    Output: Integer
    Body: {
        ReturnValue(CAD_Err.Raise(code, src, msg, CAD_Err.Len(msg)))
    }
}

// Fillet fail-closed codes (classifier / CA_FilletSolid).
// 1 need-cycle  2 need-horizontal  3 need-upright  4 need-glue
// 5 incident-collar  6 r-too-big  7 not-applied  8 need-solid  9 need-edges
// 11 traces miss >R at a vertex
Function.CAD_Err.Fillet {
    Input: reason: Integer
    Output: Integer
    Body: {
        Branch reason {
            Case 1: {
                ReturnValue(CAD_Err.RaiseS(1, 1, "fillet: pick the whole join loop\n"))
            }
            Case 2: {
                ReturnValue(CAD_Err.RaiseS(2, 1, "fillet: join must be Z-up\n"))
            }
            Case 3: {
                ReturnValue(CAD_Err.RaiseS(3, 1, "fillet: vertex needs a wall upright\n"))
            }
            Case 4: {
                ReturnValue(CAD_Err.RaiseS(4, 1, "fillet: glue the pad first\n"))
            }
            Case 5: {
                ReturnValue(CAD_Err.RaiseS(5, 1, "fillet: cannot fillet those verticals yet\n"))
            }
            Case 6: {
                ReturnValue(CAD_Err.RaiseS(6, 1, "fillet: R must be smaller than the 2D corner radius\n"))
            }
            Case 7: {
                ReturnValue(CAD_Err.RaiseS(7, 1, "fillet FAIL\n"))
            }
            Case 8: {
                ReturnValue(CAD_Err.RaiseS(8, 1, "fillet: needs an active 3D solid\n"))
            }
            Case 9: {
                ReturnValue(CAD_Err.RaiseS(9, 1, "fillet: click edges first\n"))
            }
            Case 10: {
                ReturnValue(CAD_Err.RaiseS(10, 1, "fillet: sharp and rounded corners on one rim — pick one kind\n"))
            }
            Case 11: {
                ReturnValue(CAD_Err.RaiseS(11, 1, "fillet: canal traces miss at the vertex — constant R cannot join them\n"))
            }
            Case 22: {
                ReturnValue(CAD_Err.RaiseS(22, 1, "fillet: those edges are not one chain — apply separately\n"))
            }
            Default: {
                ReturnValue(CAD_Err.RaiseS(0, 1, "fillet: no recipe for this edge set\n"))
            }
        }
    }
}
