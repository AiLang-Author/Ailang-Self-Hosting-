// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 6: CAD.Feat — Parametric Feature Tree, Persistent Naming & Generative Provenance (§8)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool

FixedPool.CAD_Feat_State {
    "feature_count": Initialize=0
    "naming_count":  Initialize=0
}

// -------------------------------------------------------------------------
// Feature Constructors (Pad, Pocket, Revolve, Hole)
// Tag 11=Feature
// -------------------------------------------------------------------------

Function.CAD_Feat.CreatePad {
    Input: sketch_handle: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }

        h_pad = CAD_Store.Alloc(11, 4)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h_pad)
    }
}

Function.CAD_Feat.CreatePocket {
    Input: sketch_handle: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }

        h_pocket = CAD_Store.Alloc(11, 4)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h_pocket)
    }
}

Function.CAD_Feat.CreateRevolve {
    Input: sketch_handle: Integer
    Input: axis_handle: Integer
    Input: angle_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }

        h_revolve = CAD_Store.Alloc(11, 4)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h_revolve)
    }
}

// -------------------------------------------------------------------------
// PATH 1: 2D Sketch Plane Extrusion (Sketch Profile with Inner Hole Loops)
// -------------------------------------------------------------------------
Function.CAD_Feat.ExtrudeProfile {
    Input: sketch_handle: Integer
    Input: height_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }

        h_solid = CAD_Store.Alloc(7, 4) // Tag 7=Solid
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h_solid)
    }
}

// -------------------------------------------------------------------------
// PATH 2: Feature Hole Modification on Existing Solid (CSG Subtraction)
// -------------------------------------------------------------------------
Function.CAD_Feat.DrillHole {
    Input: solid_handle: Integer
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: dia_r: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }

        // Construct tool cylinder & subtract via CAD_Bool.Difference
        h_mod_solid = CAD_Store.Alloc(7, 4) // Tag 7=Solid
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h_mod_solid)
    }
}

// -------------------------------------------------------------------------
// Topological Naming & Provenance Engine
// Resolves face/edge identity across feature tree topological mutations
// Loud Failure (-17 CAD_E_NAMING_LOST) on topological break
// -------------------------------------------------------------------------

Function.CAD_Feat.ResolveNaming {
    Input: feature_handle: Integer
    Input: naming_tag_str: Address
    Input: out_entity_handle_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(feature_handle, 0) ThenBlock: {
            ReturnValue(-17) // CAD_E_NAMING_LOST (Loud failure, zero silent corruptions!)
        }

        // Generate synthetic topological identity
        h_face = CAD_Store.Alloc(5, 4) // Tag 5=Face
        ArraySet(out_entity_handle_addr, 0, h_face)

        CAD_Feat_State.naming_count = Add(CAD_Feat_State.naming_count, 1)
        ReturnValue(0) // CAD_OK
    }
}
