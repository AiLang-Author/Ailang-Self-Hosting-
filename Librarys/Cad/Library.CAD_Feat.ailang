// CAD Kernel — L6 CAD.Feat — Parametric features (Fusion-shaped)
//
// Mission: pad / pocket / revolve / hole are *recipes* over Geom+Topo+Bool.
//   Pad     = extrude profile  → solid  (+ union later)
//   Pocket  = extrude profile  → tool   → Difference(body, tool)
//   Revolve = revolve profile  → solid or tool → union/difference
//   Hole    = circle on face   → tool cylinder → Difference  (not a third kernel)
//
// Honesty: no silent success. Until Bool is real, CreateHole returns tool path
// status and does not claim a cut solid.
// SysV: ≤5 Inputs. Flat control flow.

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool

FixedPool.CAD_Feat_State {
    "feature_count": Initialize=0
    "naming_count":  Initialize=0
    "holes_made":    Initialize=0
    "pads_made":     Initialize=0
}

// Feature record (tag 0x30 design / 11 interim): kind, body_or_sketch, p0, p1
// kind: 1=Pad 2=Pocket 3=Revolve 4=Hole
FixedPool.CAD_Feat_Kind {
    "PAD":     Initialize=1
    "POCKET":  Initialize=2
    "REVOLVE": Initialize=3
    "HOLE":    Initialize=4
}

// -------------------------------------------------------------------------
// Cut tool: circle (dia) + depth → exact cylinder solid (hole/pocket tool)
// Placement: axis +Z from z=0 for now; face transform later (plane recipe).
// -------------------------------------------------------------------------
Function.CAD_Feat.MakeCutToolCylinder {
    Input: radius_r: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(depth_r, 0), 1) ThenBlock: { ReturnValue(0) }
        out = Allocate(16)
        h = CAD_Topo.MakeCylinderSolid(radius_r, depth_r, out)
        Deallocate(out, 16)
        ReturnValue(h)
    }
}

// -------------------------------------------------------------------------
// Hole = Difference(body, tool_cyl). Fusion: circle on face + extrude cut.
// Returns cut solid when Bool works; else 0 and caller must not green-lie.
// out_tool_addr[0] always receives tool handle when non-null out_tool_addr.
// Inputs packed: body, dia, depth, out_tool_addr (cx,cy placement later).
// -------------------------------------------------------------------------
Function.CAD_Feat.CreateHole {
    Input: body_handle: Integer
    Input: dia_r: Integer
    Input: depth_r: Integer
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        half = Float_Div(dia_r, 0x4000000000000000)
        tool = CAD_Feat.MakeCutToolCylinder(half, depth_r)
        IfCondition EqualTo(tool, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(out_tool_addr, 0) ThenBlock: {
            ArraySet(out_tool_addr, 0, tool)
        }
        // Real cut when Difference implemented; stub must not invent geometry
        cut = CAD_Bool.Difference(body_handle, tool)
        CAD_Feat_State.holes_made = Add(CAD_Feat_State.holes_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        // If Bool is stub (returns 0 or body unchanged), still expose tool
        ReturnValue(cut)
    }
}

// Alias — shop slang; prefer CreateHole
Function.CAD_Feat.DrillHole {
    Input: body_handle: Integer
    Input: dia_r: Integer
    Input: depth_r: Integer
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        ReturnValue(CAD_Feat.CreateHole(body_handle, dia_r, depth_r, out_tool_addr))
    }
}

// -------------------------------------------------------------------------
// Pad / Pocket / Revolve — feature records only until extrude is real.
// Pad: will call profile→solid. Pocket: profile→tool→Difference.
// -------------------------------------------------------------------------
Function.CAD_Feat.CreatePad {
    Input: sketch_handle: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        h = CAD_Store.Alloc(11, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Feat_Kind.PAD)
        CAD_Store.Write(h, 1, sketch_handle)
        CAD_Store.Write(h, 2, depth_r)
        CAD_Store.Write(h, 3, 0)
        CAD_Feat_State.pads_made = Add(CAD_Feat_State.pads_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Feat.CreatePocket {
    Input: sketch_handle: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        h = CAD_Store.Alloc(11, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Feat_Kind.POCKET)
        CAD_Store.Write(h, 1, sketch_handle)
        CAD_Store.Write(h, 2, depth_r)
        CAD_Store.Write(h, 3, 0)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Feat.CreateRevolve {
    Input: sketch_handle: Integer
    Input: axis_handle: Integer
    Input: angle_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        h = CAD_Store.Alloc(11, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Feat_Kind.REVOLVE)
        CAD_Store.Write(h, 1, sketch_handle)
        CAD_Store.Write(h, 2, axis_handle)
        CAD_Store.Write(h, 3, angle_r)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

// Legacy name → pad record (no solid yet)
Function.CAD_Feat.ExtrudeProfile {
    Input: sketch_handle: Integer
    Input: height_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Feat.CreatePad(sketch_handle, height_r))
    }
}

// -------------------------------------------------------------------------
// Naming — loud failure until provenance is real (design Feat_Pid)
// -------------------------------------------------------------------------
Function.CAD_Feat.ResolveNaming {
    Input: feature_handle: Integer
    Input: naming_tag_str: Address
    Input: out_entity_handle_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(feature_handle, 0) ThenBlock: {
            ReturnValue(-17)
        }
        // Not implemented: refuse to invent a face
        ArraySet(out_entity_handle_addr, 0, 0)
        ReturnValue(-17)
    }
}
