// CAD Kernel — L6 CAD.Feat — Parametric features (Fusion-shaped)
//
// Mission: pad / pocket / revolve / hole are *recipes* over Geom+Topo+Bool.
//   Pad     = extrude profile  → solid  (+ union later)
//   Pocket  = extrude profile  → tool   → Difference(body, tool)
//   Revolve = revolve profile  → solid or tool → union/difference
//   Hole    = circle on face   → tool cylinder → Difference  (not a third kernel)
//
// Honesty: no silent success. Until Bool is real, CreateHole returns tool path
// status and does not claim a cut solid.
// SysV: ≤5 Inputs. Flat control flow.

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool

FixedPool.CAD_Feat_State {
    "feature_count": Initialize=0
    "naming_count":  Initialize=0
    "holes_made":    Initialize=0
    "pads_made":     Initialize=0
}

// Feature record (tag 0x30 design / 11 interim): kind, body_or_sketch, p0, p1
// kind: 1=Pad 2=Pocket 3=Revolve 4=Hole
FixedPool.CAD_Feat_Kind {
    "PAD":     Initialize=1
    "POCKET":  Initialize=2
    "REVOLVE": Initialize=3
    "HOLE":    Initialize=4
}

// -------------------------------------------------------------------------
// Cut tool: circle (dia) + depth → exact cylinder solid (hole/pocket tool)
// Placement: axis +Z from z=0 for now; face transform later (plane recipe).
// -------------------------------------------------------------------------
Function.CAD_Feat.MakeCutToolCylinder {
    Input: radius_r: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(depth_r, 0), 1) ThenBlock: { ReturnValue(0) }
        out = Allocate(16)
        h = CAD_Topo.MakeCylinderSolid(radius_r, depth_r, out)
        Deallocate(out, 16)
        ReturnValue(h)
    }
}

// -------------------------------------------------------------------------
// Hole = tool cyl at (cx,cy) + Difference. pack: [dia, depth, cx, cy]
// Fusion: circle on face (cx,cy in body XY) + extrude cut depth.
// -------------------------------------------------------------------------
Function.CAD_Feat.CreateHole {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(0) }
        dia_r = ArrayGet(pack_addr, 0)
        depth_r = ArrayGet(pack_addr, 1)
        cx_r = ArrayGet(pack_addr, 2)
        cy_r = ArrayGet(pack_addr, 3)
        half = Float_Div(dia_r, 0x4000000000000000)
        tool = CAD_Feat.MakeCutToolCylinder(half, depth_r)
        IfCondition EqualTo(tool, 0) ThenBlock: { ReturnValue(0) }
        // place tool axis at (cx,cy,0) in body space
        dlt = Allocate(32)
        ArraySet(dlt, 0, cx_r)
        ArraySet(dlt, 1, cy_r)
        ArraySet(dlt, 2, 0)
        CAD_Topo.TranslateSolid(tool, dlt)
        Deallocate(dlt, 32)
        IfCondition NotEqual(out_tool_addr, 0) ThenBlock: {
            ArraySet(out_tool_addr, 0, tool)
        }
        cut = CAD_Bool.Difference(body_handle, tool)
        CAD_Feat_State.holes_made = Add(CAD_Feat_State.holes_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(cut)
    }
}

// Alias — shop slang; prefer CreateHole
Function.CAD_Feat.DrillHole {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        ReturnValue(CAD_Feat.CreateHole(body_handle, pack_addr, out_tool_addr))
    }
}

// Side hole axis +X: pack [dia, depth, cy, cz] in body YZ (kind-0 box).
// depth along +X from body xmin; depth>=body dx ⇒ through.
Function.CAD_Feat.CreateSideHoleX {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        dia_r = ArrayGet(pack_addr, 0)
        depth_r = ArrayGet(pack_addr, 1)
        cy_r = ArrayGet(pack_addr, 2)
        cz_r = ArrayGet(pack_addr, 3)
        IfCondition EqualTo(CAD_Num.IsZero(dia_r, 0), 1) ThenBlock: { ReturnValue(0) }
        mna = Allocate(32)
        mxa = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mna, mxa), 1) ThenBlock: {
            Deallocate(mna, 32)
            Deallocate(mxa, 32)
            ReturnValue(0)
        }
        ax0 = ArrayGet(mna, 0)
        ay0 = ArrayGet(mna, 1)
        az0 = ArrayGet(mna, 2)
        bdx = Float_Sub(ArrayGet(mxa, 0), ax0)
        bdy = Float_Sub(ArrayGet(mxa, 1), ay0)
        bdz = Float_Sub(ArrayGet(mxa, 2), az0)
        hr = Float_Div(dia_r, 0x4000000000000000)
        // local cy,cz relative to body min
        lcy = Float_Sub(cy_r, ay0)
        lcz = Float_Sub(cz_r, az0)
        IfCondition EqualTo(CAD_Num.IsZero(depth_r, 0), 1) ThenBlock: { depth_r = bdx }
        pack2 = Allocate(64)
        ArraySet(pack2, 0, bdx)
        ArraySet(pack2, 1, bdy)
        ArraySet(pack2, 2, bdz)
        ArraySet(pack2, 3, hr)
        ArraySet(pack2, 4, lcy)
        ArraySet(pack2, 5, lcz)
        ArraySet(pack2, 6, depth_r)
        out = Allocate(16)
        h = CAD_Topo.MakeBoxSideHoleXSolid(pack2, out)
        Deallocate(pack2, 64)
        Deallocate(out, 16)
        IfCondition NotEqual(h, 0) ThenBlock: {
            dlt = Allocate(32)
            ArraySet(dlt, 0, ax0)
            ArraySet(dlt, 1, ay0)
            ArraySet(dlt, 2, az0)
            CAD_Topo.TranslateSolid(h, dlt)
            Deallocate(dlt, 32)
        }
        Deallocate(mna, 32)
        Deallocate(mxa, 32)
        IfCondition NotEqual(out_tool_addr, 0) ThenBlock: {
            ArraySet(out_tool_addr, 0, 0)
        }
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Feat_State.holes_made = Add(CAD_Feat_State.holes_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

// Side hole axis +Y: pack [dia, depth, cx, cz] in body XZ (kind-0 box).
// depth along +Y from body ymin; depth>=body dy ⇒ through.
Function.CAD_Feat.CreateSideHoleY {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        dia_r = ArrayGet(pack_addr, 0)
        depth_r = ArrayGet(pack_addr, 1)
        cx_r = ArrayGet(pack_addr, 2)
        cz_r = ArrayGet(pack_addr, 3)
        IfCondition EqualTo(CAD_Num.IsZero(dia_r, 0), 1) ThenBlock: { ReturnValue(0) }
        mna = Allocate(32)
        mxa = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mna, mxa), 1) ThenBlock: {
            Deallocate(mna, 32)
            Deallocate(mxa, 32)
            ReturnValue(0)
        }
        ax0 = ArrayGet(mna, 0)
        ay0 = ArrayGet(mna, 1)
        az0 = ArrayGet(mna, 2)
        bdx = Float_Sub(ArrayGet(mxa, 0), ax0)
        bdy = Float_Sub(ArrayGet(mxa, 1), ay0)
        bdz = Float_Sub(ArrayGet(mxa, 2), az0)
        hr = Float_Div(dia_r, 0x4000000000000000)
        lcx = Float_Sub(cx_r, ax0)
        lcz = Float_Sub(cz_r, az0)
        IfCondition EqualTo(CAD_Num.IsZero(depth_r, 0), 1) ThenBlock: { depth_r = bdy }
        pack2 = Allocate(64)
        ArraySet(pack2, 0, bdx)
        ArraySet(pack2, 1, bdy)
        ArraySet(pack2, 2, bdz)
        ArraySet(pack2, 3, hr)
        ArraySet(pack2, 4, lcx)
        ArraySet(pack2, 5, lcz)
        ArraySet(pack2, 6, depth_r)
        out = Allocate(16)
        h = CAD_Topo.MakeBoxSideHoleYSolid(pack2, out)
        Deallocate(pack2, 64)
        Deallocate(out, 16)
        IfCondition NotEqual(h, 0) ThenBlock: {
            dlt = Allocate(32)
            ArraySet(dlt, 0, ax0)
            ArraySet(dlt, 1, ay0)
            ArraySet(dlt, 2, az0)
            CAD_Topo.TranslateSolid(h, dlt)
            Deallocate(dlt, 32)
        }
        Deallocate(mna, 32)
        Deallocate(mxa, 32)
        IfCondition NotEqual(out_tool_addr, 0) ThenBlock: {
            ArraySet(out_tool_addr, 0, 0)
        }
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Feat_State.holes_made = Add(CAD_Feat_State.holes_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

// Rectangular pocket from top: pack [x0,y0,x1,y1,depth] in body XY (kind-0 box at origin).
// Builds tool box + Difference → walkable rect-pocket shell.
Function.CAD_Feat.CreateRectPocket {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        x0 = ArrayGet(pack_addr, 0)
        y0 = ArrayGet(pack_addr, 1)
        x1 = ArrayGet(pack_addr, 2)
        y1 = ArrayGet(pack_addr, 3)
        depth = ArrayGet(pack_addr, 4)
        IfCondition EqualTo(Float_Le(x1, x0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(y1, y0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(depth, 0), 1) ThenBlock: { ReturnValue(0) }
        // body AABB for top Z
        mna = Allocate(32)
        mxa = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mna, mxa), 1) ThenBlock: {
            Deallocate(mna, 32)
            Deallocate(mxa, 32)
            ReturnValue(0)
        }
        az1 = ArrayGet(mxa, 2)
        z_bot = Float_Sub(az1, depth)
        // tool box [x0,y0,z_bot]→[x1,y1,az1]
        mn = Allocate(32)
        mx = Allocate(32)
        out = Allocate(16)
        ArraySet(mn, 0, x0)
        ArraySet(mn, 1, y0)
        ArraySet(mn, 2, z_bot)
        ArraySet(mx, 0, x1)
        ArraySet(mx, 1, y1)
        ArraySet(mx, 2, az1)
        tool = CAD_Topo.MakeBoxSolid(mn, mx, out)
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        Deallocate(out, 16)
        Deallocate(mna, 32)
        Deallocate(mxa, 32)
        IfCondition EqualTo(tool, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(out_tool_addr, 0) ThenBlock: {
            ArraySet(out_tool_addr, 0, tool)
        }
        cut = CAD_Bool.Difference(body_handle, tool)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(cut)
    }
}

// -------------------------------------------------------------------------
// Pad / Pocket / Revolve — feature records only until extrude is real.
// Pad: will call profile→solid. Pocket: profile→tool→Difference.
// -------------------------------------------------------------------------
Function.CAD_Feat.CreatePad {
    Input: sketch_handle: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        h = CAD_Store.Alloc(11, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Feat_Kind.PAD)
        CAD_Store.Write(h, 1, sketch_handle)
        CAD_Store.Write(h, 2, depth_r)
        CAD_Store.Write(h, 3, 0)
        CAD_Feat_State.pads_made = Add(CAD_Feat_State.pads_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Feat.CreatePocket {
    Input: sketch_handle: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        h = CAD_Store.Alloc(11, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Feat_Kind.POCKET)
        CAD_Store.Write(h, 1, sketch_handle)
        CAD_Store.Write(h, 2, depth_r)
        CAD_Store.Write(h, 3, 0)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Feat.CreateRevolve {
    Input: sketch_handle: Integer
    Input: axis_handle: Integer
    Input: angle_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        h = CAD_Store.Alloc(11, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Feat_Kind.REVOLVE)
        CAD_Store.Write(h, 1, sketch_handle)
        CAD_Store.Write(h, 2, axis_handle)
        CAD_Store.Write(h, 3, angle_r)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

// Legacy name → pad record (no solid yet)
Function.CAD_Feat.ExtrudeProfile {
    Input: sketch_handle: Integer
    Input: height_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Feat.CreatePad(sketch_handle, height_r))
    }
}

// -------------------------------------------------------------------------
// Naming — loud failure until provenance is real (design Feat_Pid)
// -------------------------------------------------------------------------
Function.CAD_Feat.ResolveNaming {
    Input: feature_handle: Integer
    Input: naming_tag_str: Address
    Input: out_entity_handle_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(feature_handle, 0) ThenBlock: {
            ReturnValue(-17)
        }
        // Not implemented: refuse to invent a face
        ArraySet(out_entity_handle_addr, 0, 0)
        ReturnValue(-17)
    }
}
