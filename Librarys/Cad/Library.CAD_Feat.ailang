// CAD Kernel — L6 CAD.Feat — Parametric features (Fusion-shaped)
//
// Mission: pad / pocket / revolve / hole are *recipes* over Geom+Topo+Bool.
//   Pad     = extrude profile  → solid  (+ union later)
//   Pocket  = extrude profile  → tool   → Difference(body, tool)
//   Revolve = revolve profile  → solid or tool → union/difference
//   Hole    = circle on face   → tool cylinder → Difference  (not a third kernel)
//
// Honesty: no silent success. Until Bool is real, CreateHole returns tool path
// status and does not claim a cut solid.
// SysV: ≤5 Inputs. Flat control flow.

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Sketch

FixedPool.CAD_Feat_State {
    "feature_count": Initialize=0
    "naming_count":  Initialize=0
    "holes_made":    Initialize=0
    "pads_made":     Initialize=0
}

// Feature record (tag 0x30 design / 11 interim): kind, body_or_sketch, p0, p1
// kind: 1=Pad 2=Pocket 3=Revolve 4=Hole
FixedPool.CAD_Feat_Kind {
    "PAD":     Initialize=1
    "POCKET":  Initialize=2
    "REVOLVE": Initialize=3
    "HOLE":    Initialize=4
}

// -------------------------------------------------------------------------
// Cut tool: circle (dia) + depth → exact cylinder solid (hole/pocket tool)
// Placement: axis +Z from z=0 for now; face transform later (plane recipe).
// -------------------------------------------------------------------------
Function.CAD_Feat.MakeCutToolCylinder {
    Input: radius_r: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(depth_r, 0), 1) ThenBlock: { ReturnValue(0) }
        out = Allocate(16)
        h = CAD_Topo.MakeCylinderSolid(radius_r, depth_r, out)
        Deallocate(out, 16)
        ReturnValue(h)
    }
}

// -------------------------------------------------------------------------
// Hole = tool cyl at (cx,cy) + Difference. pack: [dia, depth, cx, cy]
// Fusion: circle on face (cx,cy in body XY) + extrude cut depth.
// -------------------------------------------------------------------------
Function.CAD_Feat.CreateHole {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(0) }
        dia_r = ArrayGet(pack_addr, 0)
        depth_r = ArrayGet(pack_addr, 1)
        cx_r = ArrayGet(pack_addr, 2)
        cy_r = ArrayGet(pack_addr, 3)
        half = Float_Div(dia_r, 0x4000000000000000)
        tool = CAD_Feat.MakeCutToolCylinder(half, depth_r)
        IfCondition EqualTo(tool, 0) ThenBlock: { ReturnValue(0) }
        // place tool axis at (cx,cy,0) in body space
        dlt = Allocate(32)
        ArraySet(dlt, 0, cx_r)
        ArraySet(dlt, 1, cy_r)
        ArraySet(dlt, 2, 0)
        CAD_Topo.TranslateSolid(tool, dlt)
        Deallocate(dlt, 32)
        IfCondition NotEqual(out_tool_addr, 0) ThenBlock: {
            ArraySet(out_tool_addr, 0, tool)
        }
        cut = CAD_Bool.Difference(body_handle, tool)
        CAD_Feat_State.holes_made = Add(CAD_Feat_State.holes_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(cut)
    }
}

// Alias — shop slang; prefer CreateHole
Function.CAD_Feat.DrillHole {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        ReturnValue(CAD_Feat.CreateHole(body_handle, pack_addr, out_tool_addr))
    }
}

// Side hole axis +X: pack [dia, depth, cy, cz] in body YZ (kind-0 box).
// depth along +X from body xmin; depth>=body dx ⇒ through.
Function.CAD_Feat.CreateSideHoleX {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        dia_r = ArrayGet(pack_addr, 0)
        depth_r = ArrayGet(pack_addr, 1)
        cy_r = ArrayGet(pack_addr, 2)
        cz_r = ArrayGet(pack_addr, 3)
        IfCondition EqualTo(CAD_Num.IsZero(dia_r, 0), 1) ThenBlock: { ReturnValue(0) }
        mna = Allocate(32)
        mxa = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mna, mxa), 1) ThenBlock: {
            Deallocate(mna, 32)
            Deallocate(mxa, 32)
            ReturnValue(0)
        }
        ax0 = ArrayGet(mna, 0)
        ay0 = ArrayGet(mna, 1)
        az0 = ArrayGet(mna, 2)
        bdx = Float_Sub(ArrayGet(mxa, 0), ax0)
        bdy = Float_Sub(ArrayGet(mxa, 1), ay0)
        bdz = Float_Sub(ArrayGet(mxa, 2), az0)
        hr = Float_Div(dia_r, 0x4000000000000000)
        // local cy,cz relative to body min
        lcy = Float_Sub(cy_r, ay0)
        lcz = Float_Sub(cz_r, az0)
        IfCondition EqualTo(CAD_Num.IsZero(depth_r, 0), 1) ThenBlock: { depth_r = bdx }
        pack2 = Allocate(64)
        ArraySet(pack2, 0, bdx)
        ArraySet(pack2, 1, bdy)
        ArraySet(pack2, 2, bdz)
        ArraySet(pack2, 3, hr)
        ArraySet(pack2, 4, lcy)
        ArraySet(pack2, 5, lcz)
        ArraySet(pack2, 6, depth_r)
        out = Allocate(16)
        h = CAD_Topo.MakeBoxSideHoleXSolid(pack2, out)
        Deallocate(pack2, 64)
        Deallocate(out, 16)
        IfCondition NotEqual(h, 0) ThenBlock: {
            dlt = Allocate(32)
            ArraySet(dlt, 0, ax0)
            ArraySet(dlt, 1, ay0)
            ArraySet(dlt, 2, az0)
            CAD_Topo.TranslateSolid(h, dlt)
            Deallocate(dlt, 32)
        }
        Deallocate(mna, 32)
        Deallocate(mxa, 32)
        IfCondition NotEqual(out_tool_addr, 0) ThenBlock: {
            ArraySet(out_tool_addr, 0, 0)
        }
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Feat_State.holes_made = Add(CAD_Feat_State.holes_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

// Side hole axis +Y: pack [dia, depth, cx, cz] in body XZ (kind-0 box).
// depth along +Y from body ymin; depth>=body dy ⇒ through.
Function.CAD_Feat.CreateSideHoleY {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        dia_r = ArrayGet(pack_addr, 0)
        depth_r = ArrayGet(pack_addr, 1)
        cx_r = ArrayGet(pack_addr, 2)
        cz_r = ArrayGet(pack_addr, 3)
        IfCondition EqualTo(CAD_Num.IsZero(dia_r, 0), 1) ThenBlock: { ReturnValue(0) }
        mna = Allocate(32)
        mxa = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mna, mxa), 1) ThenBlock: {
            Deallocate(mna, 32)
            Deallocate(mxa, 32)
            ReturnValue(0)
        }
        ax0 = ArrayGet(mna, 0)
        ay0 = ArrayGet(mna, 1)
        az0 = ArrayGet(mna, 2)
        bdx = Float_Sub(ArrayGet(mxa, 0), ax0)
        bdy = Float_Sub(ArrayGet(mxa, 1), ay0)
        bdz = Float_Sub(ArrayGet(mxa, 2), az0)
        hr = Float_Div(dia_r, 0x4000000000000000)
        lcx = Float_Sub(cx_r, ax0)
        lcz = Float_Sub(cz_r, az0)
        IfCondition EqualTo(CAD_Num.IsZero(depth_r, 0), 1) ThenBlock: { depth_r = bdy }
        pack2 = Allocate(64)
        ArraySet(pack2, 0, bdx)
        ArraySet(pack2, 1, bdy)
        ArraySet(pack2, 2, bdz)
        ArraySet(pack2, 3, hr)
        ArraySet(pack2, 4, lcx)
        ArraySet(pack2, 5, lcz)
        ArraySet(pack2, 6, depth_r)
        out = Allocate(16)
        h = CAD_Topo.MakeBoxSideHoleYSolid(pack2, out)
        Deallocate(pack2, 64)
        Deallocate(out, 16)
        IfCondition NotEqual(h, 0) ThenBlock: {
            dlt = Allocate(32)
            ArraySet(dlt, 0, ax0)
            ArraySet(dlt, 1, ay0)
            ArraySet(dlt, 2, az0)
            CAD_Topo.TranslateSolid(h, dlt)
            Deallocate(dlt, 32)
        }
        Deallocate(mna, 32)
        Deallocate(mxa, 32)
        IfCondition NotEqual(out_tool_addr, 0) ThenBlock: {
            ArraySet(out_tool_addr, 0, 0)
        }
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Feat_State.holes_made = Add(CAD_Feat_State.holes_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

// Rectangular notch from -X face: pack [y0,z0,y1,z1,depth] in body YZ.
// depth along +X from body xmin; through if depth >= body dx.
Function.CAD_Feat.CreateRectNotchX {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        y0 = ArrayGet(pack_addr, 0)
        z0 = ArrayGet(pack_addr, 1)
        y1 = ArrayGet(pack_addr, 2)
        z1 = ArrayGet(pack_addr, 3)
        depth = ArrayGet(pack_addr, 4)
        IfCondition EqualTo(Float_Le(y1, y0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(z1, z0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(depth, 0), 1) ThenBlock: { ReturnValue(0) }
        mna = Allocate(32)
        mxa = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mna, mxa), 1) ThenBlock: {
            Deallocate(mna, 32)
            Deallocate(mxa, 32)
            ReturnValue(0)
        }
        ax0 = ArrayGet(mna, 0)
        ay0 = ArrayGet(mna, 1)
        az0 = ArrayGet(mna, 2)
        bdx = Float_Sub(ArrayGet(mxa, 0), ax0)
        bdy = Float_Sub(ArrayGet(mxa, 1), ay0)
        bdz = Float_Sub(ArrayGet(mxa, 2), az0)
        pack2 = Allocate(64)
        ArraySet(pack2, 0, bdx)
        ArraySet(pack2, 1, bdy)
        ArraySet(pack2, 2, bdz)
        ArraySet(pack2, 3, Float_Sub(y0, ay0))
        ArraySet(pack2, 4, Float_Sub(z0, az0))
        ArraySet(pack2, 5, Float_Sub(y1, ay0))
        ArraySet(pack2, 6, Float_Sub(z1, az0))
        ArraySet(pack2, 7, depth)
        out = Allocate(16)
        h = CAD_Topo.MakeBoxRectNotchXSolid(pack2, out)
        Deallocate(pack2, 64)
        Deallocate(out, 16)
        IfCondition NotEqual(h, 0) ThenBlock: {
            dlt = Allocate(32)
            ArraySet(dlt, 0, ax0)
            ArraySet(dlt, 1, ay0)
            ArraySet(dlt, 2, az0)
            CAD_Topo.TranslateSolid(h, dlt)
            Deallocate(dlt, 32)
        }
        Deallocate(mna, 32)
        Deallocate(mxa, 32)
        IfCondition NotEqual(out_tool_addr, 0) ThenBlock: {
            ArraySet(out_tool_addr, 0, 0)
        }
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

// Pad (join): rectangular boss on plate top. pack [x0,y0,x1,y1,height] in body XY.
// Body must be kind-0 box. Builds stepped B-Rep (not Union — smaller pad ≠ AABB fill).
Function.CAD_Feat.CreatePadBox {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_pad_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        x0 = ArrayGet(pack_addr, 0)
        y0 = ArrayGet(pack_addr, 1)
        x1 = ArrayGet(pack_addr, 2)
        y1 = ArrayGet(pack_addr, 3)
        hgt = ArrayGet(pack_addr, 4)
        IfCondition EqualTo(Float_Le(x1, x0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(y1, y0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(hgt, 0), 1) ThenBlock: { ReturnValue(0) }
        mna = Allocate(32)
        mxa = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mna, mxa), 1) ThenBlock: {
            Deallocate(mna, 32)
            Deallocate(mxa, 32)
            ReturnValue(0)
        }
        ax0 = ArrayGet(mna, 0)
        ay0 = ArrayGet(mna, 1)
        az0 = ArrayGet(mna, 2)
        bdx = Float_Sub(ArrayGet(mxa, 0), ax0)
        bdy = Float_Sub(ArrayGet(mxa, 1), ay0)
        bdz = Float_Sub(ArrayGet(mxa, 2), az0)
        pack2 = Allocate(64)
        ArraySet(pack2, 0, bdx)
        ArraySet(pack2, 1, bdy)
        ArraySet(pack2, 2, bdz)
        ArraySet(pack2, 3, Float_Sub(x0, ax0))
        ArraySet(pack2, 4, Float_Sub(y0, ay0))
        ArraySet(pack2, 5, Float_Sub(x1, ax0))
        ArraySet(pack2, 6, Float_Sub(y1, ay0))
        ArraySet(pack2, 7, hgt)
        out = Allocate(16)
        h = CAD_Topo.MakeBoxBossSolid(pack2, out)
        Deallocate(pack2, 64)
        Deallocate(out, 16)
        IfCondition NotEqual(h, 0) ThenBlock: {
            dlt = Allocate(32)
            ArraySet(dlt, 0, ax0)
            ArraySet(dlt, 1, ay0)
            ArraySet(dlt, 2, az0)
            CAD_Topo.TranslateSolid(h, dlt)
            Deallocate(dlt, 32)
        }
        Deallocate(mna, 32)
        Deallocate(mxa, 32)
        IfCondition NotEqual(out_pad_addr, 0) ThenBlock: {
            ArraySet(out_pad_addr, 0, 0)
        }
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Feat_State.pads_made = Add(CAD_Feat_State.pads_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

// Rectangular pocket from top: pack [x0,y0,x1,y1,depth] in body XY (kind-0 box at origin).
// Builds tool box + Difference → walkable rect-pocket shell.
Function.CAD_Feat.CreateRectPocket {
    Input: body_handle: Integer
    Input: pack_addr: Address
    Input: out_tool_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        x0 = ArrayGet(pack_addr, 0)
        y0 = ArrayGet(pack_addr, 1)
        x1 = ArrayGet(pack_addr, 2)
        y1 = ArrayGet(pack_addr, 3)
        depth = ArrayGet(pack_addr, 4)
        IfCondition EqualTo(Float_Le(x1, x0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(y1, y0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(depth, 0), 1) ThenBlock: { ReturnValue(0) }
        // body AABB for top Z
        mna = Allocate(32)
        mxa = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mna, mxa), 1) ThenBlock: {
            Deallocate(mna, 32)
            Deallocate(mxa, 32)
            ReturnValue(0)
        }
        az1 = ArrayGet(mxa, 2)
        z_bot = Float_Sub(az1, depth)
        // tool box [x0,y0,z_bot]→[x1,y1,az1]
        mn = Allocate(32)
        mx = Allocate(32)
        out = Allocate(16)
        ArraySet(mn, 0, x0)
        ArraySet(mn, 1, y0)
        ArraySet(mn, 2, z_bot)
        ArraySet(mx, 0, x1)
        ArraySet(mx, 1, y1)
        ArraySet(mx, 2, az1)
        tool = CAD_Topo.MakeBoxSolid(mn, mx, out)
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        Deallocate(out, 16)
        Deallocate(mna, 32)
        Deallocate(mxa, 32)
        IfCondition EqualTo(tool, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(out_tool_addr, 0) ThenBlock: {
            ArraySet(out_tool_addr, 0, tool)
        }
        cut = CAD_Bool.Difference(body_handle, tool)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(cut)
    }
}

// -------------------------------------------------------------------------
// Pad / Pocket / Revolve — feature records only until extrude is real.
// Pad: will call profile→solid. Pocket: profile→tool→Difference.
// -------------------------------------------------------------------------
// CreatePad: real extrude solid (feature record optional later).
Function.CAD_Feat.CreatePad {
    Input: sketch_handle: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Feat.ExtrudeProfile(sketch_handle, depth_r))
    }
}

// CreatePocket needs a body — use ExtrudeCut. This form only stores intent if no body.
// Prefer ExtrudeCut(body, sketch, depth).
Function.CAD_Feat.CreatePocket {
    Input: sketch_handle: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        // Cannot cut without body; return 0 (loud). Use ExtrudeCut.
        ReturnValue(0)
    }
}

// CreateRevolve: real lathe solid (axis_handle ignored v1 = +Z; angle 0 → full turn).
Function.CAD_Feat.CreateRevolve {
    Input: sketch_handle: Integer
    Input: axis_handle: Integer
    Input: angle_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Feat.RevolveProfile(sketch_handle, angle_r))
    }
}

// -------------------------------------------------------------------------
// Phase B — ExtrudeCut / RevolveProfile (recipes over Topo+Bool)
// -------------------------------------------------------------------------

// Extrude sketch as cut from body top (depth down). Recipe over pocket/hole/plate shells.
// Domains: box body + rect sketch → CreateRectPocket; + circle → CreateHole;
// through poly → MakePlateThroughPolyHole. Else tool extrude + Difference.
Function.CAD_Feat.ExtrudeCut {
    Input: body_handle: Integer
    Input: sketch_handle: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(depth_r, 0), 1) ThenBlock: { ReturnValue(0) }
        // lower sketch
        nprof = CAD_Store.Read(sketch_handle, 12)
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            IfCondition GreaterThan(CAD_Store.Read(sketch_handle, 10), 0) ThenBlock: {
                CAD_Sketch.TessellateArcs(sketch_handle, 32)
            }
            IfCondition GreaterThan(CAD_Store.Read(sketch_handle, 7), 0) ThenBlock: {
                CAD_Sketch.TessellateCircles(sketch_handle, 32)
            }
            CAD_Sketch.BuildAllClosedLoops(sketch_handle)
        }
        n = CAD_Store.Read(sketch_handle, 2)
        IfCondition LessThan(n, 3) ThenBlock: {
            // pure circle cut → hole tool
            nc = CAD_Store.Read(sketch_handle, 7)
            IfCondition GreaterThan(nc, 0) ThenBlock: {
                circs = CAD_Store.Read(sketch_handle, 8)
                pack = Allocate(64)
                ArraySet(pack, 0, Float_Mul(ArrayGet(circs, 2), 0x4000000000000000))
                ArraySet(pack, 1, depth_r)
                ArraySet(pack, 2, ArrayGet(circs, 0))
                ArraySet(pack, 3, ArrayGet(circs, 1))
                outt = Allocate(16)
                h = CAD_Feat.CreateHole(body_handle, pack, outt)
                Deallocate(pack, 64)
                Deallocate(outt, 16)
                ReturnValue(h)
            }
            ReturnValue(0)
        }
        loop = CAD_Store.Read(sketch_handle, 3)
        xmin = ArrayGet(loop, 0)
        ymin = ArrayGet(loop, 1)
        xmax = xmin
        ymax = ymin
        i = 1
        WhileLoop LessThan(i, n) {
            x = ArrayGet(loop, Multiply(i, 2))
            y = ArrayGet(loop, Add(Multiply(i, 2), 1))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            i = Add(i, 1)
        }
        is_rect = 0
        IfCondition EqualTo(n, 4) ThenBlock: {
            is_rect = 1
            i = 0
            WhileLoop LessThan(i, 4) {
                x = ArrayGet(loop, Multiply(i, 2))
                y = ArrayGet(loop, Add(Multiply(i, 2), 1))
                ox = 0
                oy = 0
                IfCondition EqualTo(CAD_Num.IsEqual(x, xmin, 0), 1) ThenBlock: { ox = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(x, xmax, 0), 1) ThenBlock: { ox = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(y, ymin, 0), 1) ThenBlock: { oy = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(y, ymax, 0), 1) ThenBlock: { oy = 1 }
                IfCondition EqualTo(ox, 0) ThenBlock: { is_rect = 0 }
                IfCondition EqualTo(oy, 0) ThenBlock: { is_rect = 0 }
                i = Add(i, 1)
            }
        }
        // rect pocket on kind-0 box
        IfCondition EqualTo(is_rect, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(body_handle, 3), 0) ThenBlock: {
                pack = Allocate(64)
                ArraySet(pack, 0, xmin)
                ArraySet(pack, 1, ymin)
                ArraySet(pack, 2, xmax)
                ArraySet(pack, 3, ymax)
                ArraySet(pack, 4, depth_r)
                outt = Allocate(16)
                h = CAD_Feat.CreateRectPocket(body_handle, pack, outt)
                Deallocate(pack, 64)
                Deallocate(outt, 16)
                IfCondition NotEqual(h, 0) ThenBlock: { ReturnValue(h) }
            }
        }
        mna = Allocate(32)
        mxa = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mna, mxa), 1) ThenBlock: {
            Deallocate(mna, 32)
            Deallocate(mxa, 32)
            ReturnValue(0)
        }
        az0 = ArrayGet(mna, 2)
        az1 = ArrayGet(mxa, 2)
        bh = Float_Sub(az1, az0)
        // through poly cut on box → plate shell
        IfCondition EqualTo(Float_Le(bh, depth_r), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(body_handle, 3), 0) ThenBlock: {
                pack = Allocate(64)
                ArraySet(pack, 0, ArrayGet(mna, 0))
                ArraySet(pack, 1, ArrayGet(mna, 1))
                ArraySet(pack, 2, ArrayGet(mxa, 0))
                ArraySet(pack, 3, ArrayGet(mxa, 1))
                ArraySet(pack, 4, bh)
                out = Allocate(16)
                h = CAD_Topo.MakePlateThroughPolyHole(pack, loop, n, out)
                Deallocate(out, 16)
                Deallocate(pack, 64)
                IfCondition NotEqual(h, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsZero(az0, 0), 0) ThenBlock: {
                        dlt = Allocate(32)
                        ArraySet(dlt, 0, 0)
                        ArraySet(dlt, 1, 0)
                        ArraySet(dlt, 2, az0)
                        CAD_Topo.TranslateSolid(h, dlt)
                        Deallocate(dlt, 32)
                    }
                    Deallocate(mna, 32)
                    Deallocate(mxa, 32)
                    CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
                    ReturnValue(h)
                }
            }
        }
        // generic: tool solid + Difference
        tool = CAD_Feat.ExtrudeProfile(sketch_handle, depth_r)
        IfCondition EqualTo(tool, 0) ThenBlock: {
            Deallocate(mna, 32)
            Deallocate(mxa, 32)
            ReturnValue(0)
        }
        tz = Float_Sub(az1, depth_r)
        dlt = Allocate(32)
        ArraySet(dlt, 0, 0)
        ArraySet(dlt, 1, 0)
        ArraySet(dlt, 2, tz)
        CAD_Topo.TranslateSolid(tool, dlt)
        Deallocate(dlt, 32)
        Deallocate(mna, 32)
        Deallocate(mxa, 32)
        cut = CAD_Bool.Difference(body_handle, tool)
        IfCondition NotEqual(cut, 0) ThenBlock: {
            CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        }
        ReturnValue(cut)
    }
}

// Revolve sketch full 360° around +Z.
// Sketch XY: X = radius (≥0), Y = height (maps to solid Z).
// Supported v1: axis-aligned rectangular profile → cylinder or tube.
// Returns solid or 0.
Function.CAD_Feat.RevolveProfile {
    Input: sketch_handle: Integer
    Input: angle_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        // full turn only for v1 (angle unused except zero check)
        IfCondition EqualTo(CAD_Num.IsZero(angle_r, 0), 1) ThenBlock: {
            // default 2π
            angle_r = 0x401921FB54442D18
        }
        nprof = CAD_Store.Read(sketch_handle, 12)
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            CAD_Sketch.BuildAllClosedLoops(sketch_handle)
        }
        n = CAD_Store.Read(sketch_handle, 2)
        IfCondition LessThan(n, 3) ThenBlock: {
            IfCondition GreaterThan(CAD_Store.Read(sketch_handle, 7), 0) ThenBlock: {
                CAD_Sketch.TessellateCircles(sketch_handle, 32)
            }
            IfCondition GreaterThan(CAD_Store.Read(sketch_handle, 10), 0) ThenBlock: {
                CAD_Sketch.TessellateArcs(sketch_handle, 32)
            }
            CAD_Sketch.BuildAllClosedLoops(sketch_handle)
            n = CAD_Store.Read(sketch_handle, 2)
        }
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        loop = CAD_Store.Read(sketch_handle, 3)
        // AABB in sketch XY (X=radius, Y=height)
        xmin = ArrayGet(loop, 0)
        ymin = ArrayGet(loop, 1)
        xmax = xmin
        ymax = ymin
        i = 0
        WhileLoop LessThan(i, n) {
            x = ArrayGet(loop, Multiply(i, 2))
            y = ArrayGet(loop, Add(Multiply(i, 2), 1))
            IfCondition EqualTo(Float_Le(x, 0), 1) ThenBlock: {
                // allow tiny negative
                IfCondition EqualTo(Float_Le(x, 0xBEE4F8B588E368F1), 1) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            i = Add(i, 1)
        }
        // require rectangle-like profile (all verts on AABB corners)
        is_rect = 0
        IfCondition EqualTo(n, 4) ThenBlock: {
            is_rect = 1
            i = 0
            WhileLoop LessThan(i, 4) {
                x = ArrayGet(loop, Multiply(i, 2))
                y = ArrayGet(loop, Add(Multiply(i, 2), 1))
                ox = 0
                oy = 0
                IfCondition EqualTo(CAD_Num.IsEqual(x, xmin, 0), 1) ThenBlock: { ox = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(x, xmax, 0), 1) ThenBlock: { ox = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(y, ymin, 0), 1) ThenBlock: { oy = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(y, ymax, 0), 1) ThenBlock: { oy = 1 }
                IfCondition EqualTo(ox, 0) ThenBlock: { is_rect = 0 }
                IfCondition EqualTo(oy, 0) ThenBlock: { is_rect = 0 }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(is_rect, 0) ThenBlock: { ReturnValue(0) }
        hgt = Float_Sub(ymax, ymin)
        IfCondition EqualTo(CAD_Num.IsZero(hgt, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(xmax, 0), 1) ThenBlock: { ReturnValue(0) }
        out = Allocate(16)
        h = 0
        // on-axis: solid cylinder radius xmax
        IfCondition EqualTo(CAD_Num.IsZero(xmin, 0), 1) ThenBlock: {
            h = CAD_Topo.MakeCylinderSolid(xmax, hgt, out)
        }
        // washer: outer cyl − inner cyl (Bool coaxial path → annulus)
        IfCondition EqualTo(CAD_Num.IsZero(xmin, 0), 0) ThenBlock: {
            outer = CAD_Topo.MakeCylinderSolid(xmax, hgt, out)
            inner = CAD_Topo.MakeCylinderSolid(xmin, hgt, out)
            IfCondition EqualTo(outer, 0) ThenBlock: {
                Deallocate(out, 16)
                ReturnValue(0)
            }
            IfCondition EqualTo(inner, 0) ThenBlock: {
                Deallocate(out, 16)
                ReturnValue(0)
            }
            h = CAD_Bool.Difference(outer, inner)
        }
        Deallocate(out, 16)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        // place bottom at sketch ymin → solid Z
        IfCondition EqualTo(CAD_Num.IsZero(ymin, 0), 0) ThenBlock: {
            dlt = Allocate(32)
            ArraySet(dlt, 0, 0)
            ArraySet(dlt, 1, 0)
            ArraySet(dlt, 2, ymin)
            CAD_Topo.TranslateSolid(h, dlt)
            Deallocate(dlt, 32)
        }
        CAD_Feat_State.pads_made = Add(CAD_Feat_State.pads_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

// Draft pad (Fusion-like): rect sketch, height, draft angle (rad), outward=1 expands top.
// inset = h * tan(|draft|). Inward shrinks top (must stay positive size).
// pack-free: sketch + height + draft + outward flag.
Function.CAD_Feat.ExtrudeDraft {
    Input: sketch_handle: Integer
    Input: height_r: Integer
    Input: draft_r: Integer
    Input: outward: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        nprof = CAD_Store.Read(sketch_handle, 12)
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            CAD_Sketch.BuildAllClosedLoops(sketch_handle)
        }
        n = CAD_Store.Read(sketch_handle, 2)
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        loop = CAD_Store.Read(sketch_handle, 3)
        xmin = ArrayGet(loop, 0)
        ymin = ArrayGet(loop, 1)
        xmax = xmin
        ymax = ymin
        i = 1
        WhileLoop LessThan(i, n) {
            x = ArrayGet(loop, Multiply(i, 2))
            y = ArrayGet(loop, Add(Multiply(i, 2), 1))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            i = Add(i, 1)
        }
        is_rect = 0
        IfCondition EqualTo(n, 4) ThenBlock: {
            is_rect = 1
            i = 0
            WhileLoop LessThan(i, 4) {
                x = ArrayGet(loop, Multiply(i, 2))
                y = ArrayGet(loop, Add(Multiply(i, 2), 1))
                ox = 0
                oy = 0
                IfCondition EqualTo(CAD_Num.IsEqual(x, xmin, 0), 1) ThenBlock: { ox = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(x, xmax, 0), 1) ThenBlock: { ox = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(y, ymin, 0), 1) ThenBlock: { oy = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(y, ymax, 0), 1) ThenBlock: { oy = 1 }
                IfCondition EqualTo(ox, 0) ThenBlock: { is_rect = 0 }
                IfCondition EqualTo(oy, 0) ThenBlock: { is_rect = 0 }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(is_rect, 0) ThenBlock: { ReturnValue(0) }
        // zero draft → normal extrude
        IfCondition EqualTo(CAD_Num.IsZero(draft_r, 0), 1) ThenBlock: {
            ReturnValue(CAD_Feat.ExtrudeProfile(sketch_handle, height_r))
        }
        // offset = h * |tan(draft)| = h * |sin|/|cos|
        ad = draft_r
        IfCondition EqualTo(Float_Le(ad, 0), 1) ThenBlock: { ad = Float_Sub(0, ad) }
        sn = CAD_Geom.Sin(ad)
        cs = CAD_Geom.Cos(ad)
        IfCondition EqualTo(CAD_Num.IsZero(cs, 0), 1) ThenBlock: { ReturnValue(0) }
        off = Float_Mul(height_r, Float_Div(sn, cs))
        tx0 = xmin
        ty0 = ymin
        tx1 = xmax
        ty1 = ymax
        IfCondition EqualTo(outward, 1) ThenBlock: {
            tx0 = Float_Sub(xmin, off)
            ty0 = Float_Sub(ymin, off)
            tx1 = Float_Add(xmax, off)
            ty1 = Float_Add(ymax, off)
        }
        IfCondition EqualTo(outward, 0) ThenBlock: {
            tx0 = Float_Add(xmin, off)
            ty0 = Float_Add(ymin, off)
            tx1 = Float_Sub(xmax, off)
            ty1 = Float_Sub(ymax, off)
            IfCondition EqualTo(Float_Le(tx1, tx0), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Float_Le(ty1, ty0), 1) ThenBlock: { ReturnValue(0) }
        }
        pack = Allocate(80)
        ArraySet(pack, 0, xmin)
        ArraySet(pack, 1, ymin)
        ArraySet(pack, 2, xmax)
        ArraySet(pack, 3, ymax)
        ArraySet(pack, 4, tx0)
        ArraySet(pack, 5, ty0)
        ArraySet(pack, 6, tx1)
        ArraySet(pack, 7, ty1)
        ArraySet(pack, 8, height_r)
        out = Allocate(16)
        h = CAD_Topo.MakeRectFrustum(pack, out)
        Deallocate(out, 16)
        Deallocate(pack, 80)
        IfCondition NotEqual(h, 0) ThenBlock: {
            CAD_Feat_State.pads_made = Add(CAD_Feat_State.pads_made, 1)
            CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        }
        ReturnValue(h)
    }
}

// -------------------------------------------------------------------------
// Part Design: pattern / mirror / shell (kind-0 clone + transform; compound)
// -------------------------------------------------------------------------

// Linear pattern: count clones of kind-0 solid spaced by (dx,dy,dz).
// count includes the original. Non-box solids keep true shape (CloneKind0).
Function.CAD_Feat.LinearPattern {
    Input: body_handle: Integer
    Input: dx_r: Integer
    Input: dy_r: Integer
    Input: dz_r: Integer
    Input: count: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(count, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(count, 1) ThenBlock: { ReturnValue(body_handle) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        result = body_handle
        dlt = Allocate(32)
        i = 1
        WhileLoop LessThan(i, count) {
            fi = Float_FromInt(i)
            copy = CAD_Topo.CloneKind0(body_handle)
            IfCondition EqualTo(copy, 0) ThenBlock: {
                Deallocate(dlt, 32)
                ReturnValue(0)
            }
            ArraySet(dlt, 0, Float_Mul(dx_r, fi))
            ArraySet(dlt, 1, Float_Mul(dy_r, fi))
            ArraySet(dlt, 2, Float_Mul(dz_r, fi))
            CAD_Topo.TranslateSolid(copy, dlt)
            result = CAD_Topo.CompoundAdd(result, copy)
            i = Add(i, 1)
        }
        Deallocate(dlt, 32)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(result)
    }
}

// Mirror kind-0 solid across mid of AABB: axis 0=YZ, 1=XZ, 2=XY.
// Clone + ReflectSolid; compound original + mirrored.
Function.CAD_Feat.Mirror {
    Input: body_handle: Integer
    Input: axis: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        mn = Allocate(32)
        mx = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mn, mx), 1) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        half = 0x4000000000000000
        ArraySet(mn, 0, Float_Div(Float_Add(ArrayGet(mn, 0), ArrayGet(mx, 0)), half))
        ArraySet(mn, 1, Float_Div(Float_Add(ArrayGet(mn, 1), ArrayGet(mx, 1)), half))
        ArraySet(mn, 2, Float_Div(Float_Add(ArrayGet(mn, 2), ArrayGet(mx, 2)), half))
        mir = CAD_Topo.CloneKind0(body_handle)
        IfCondition EqualTo(mir, 0) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        CAD_Topo.ReflectSolid(mir, axis, mn)
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        h = CAD_Topo.CompoundAdd(body_handle, mir)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(h)
    }
}

// Circular pattern about +Z through body AABB center. True rotation of clones.
// count includes original. Kind-0 any poly (not just AABB boxes).
Function.CAD_Feat.CircularPattern {
    Input: body_handle: Integer
    Input: count: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(count, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(count, 1) ThenBlock: { ReturnValue(body_handle) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        mn = Allocate(32)
        mx = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mn, mx), 1) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        half = 0x4000000000000000
        cx = Float_Div(Float_Add(ArrayGet(mn, 0), ArrayGet(mx, 0)), half)
        cy = Float_Div(Float_Add(ArrayGet(mn, 1), ArrayGet(mx, 1)), half)
        two_pi = 0x401921FB54442D18
        result = body_handle
        dlt = Allocate(32)
        i = 1
        WhileLoop LessThan(i, count) {
            ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(count)))
            copy = CAD_Topo.CloneKind0(body_handle)
            IfCondition EqualTo(copy, 0) ThenBlock: {
                Deallocate(dlt, 32)
                Deallocate(mn, 32)
                Deallocate(mx, 32)
                ReturnValue(0)
            }
            // rotate about (cx,cy): T(-c) · Rz · T(+c)
            ArraySet(dlt, 0, Float_Sub(0, cx))
            ArraySet(dlt, 1, Float_Sub(0, cy))
            ArraySet(dlt, 2, 0)
            CAD_Topo.TranslateSolid(copy, dlt)
            CAD_Topo.RotateSolidZ(copy, ang)
            ArraySet(dlt, 0, cx)
            ArraySet(dlt, 1, cy)
            ArraySet(dlt, 2, 0)
            CAD_Topo.TranslateSolid(copy, dlt)
            result = CAD_Topo.CompoundAdd(result, copy)
            i = Add(i, 1)
        }
        Deallocate(dlt, 32)
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        ReturnValue(result)
    }
}

// Shell open-top pocket: hollow a kind-0 box with wall thickness t (floor + 4 walls).
// Fusion-like "shell" simplified: blind rect pocket inset by t, depth = H - t.
Function.CAD_Feat.Shell {
    Input: body_handle: Integer
    Input: thickness_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(thickness_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(body_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        mn = Allocate(32)
        mx = Allocate(32)
        IfCondition NotEqual(CAD_Bool.SolidAABB(body_handle, mn, mx), 1) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        x0 = ArrayGet(mn, 0)
        y0 = ArrayGet(mn, 1)
        z0 = ArrayGet(mn, 2)
        x1 = ArrayGet(mx, 0)
        y1 = ArrayGet(mx, 1)
        z1 = ArrayGet(mx, 2)
        t = thickness_r
        // pocket interior
        px0 = Float_Add(x0, t)
        py0 = Float_Add(y0, t)
        px1 = Float_Sub(x1, t)
        py1 = Float_Sub(y1, t)
        IfCondition EqualTo(Float_Le(px1, px0), 1) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        IfCondition EqualTo(Float_Le(py1, py0), 1) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        hgt = Float_Sub(z1, z0)
        depth = Float_Sub(hgt, t)
        IfCondition EqualTo(Float_Le(depth, 0), 1) ThenBlock: {
            Deallocate(mn, 32)
            Deallocate(mx, 32)
            ReturnValue(0)
        }
        pack = Allocate(64)
        ArraySet(pack, 0, px0)
        ArraySet(pack, 1, py0)
        ArraySet(pack, 2, px1)
        ArraySet(pack, 3, py1)
        ArraySet(pack, 4, depth)
        outt = Allocate(16)
        h = CAD_Feat.CreateRectPocket(body_handle, pack, outt)
        Deallocate(pack, 64)
        Deallocate(outt, 16)
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        ReturnValue(h)
    }
}

// -------------------------------------------------------------------------
// Loft / Sweep (ruled between sections; path sweep = parallel transport)
// -------------------------------------------------------------------------

// Loft two closed sketches at z_bot and z_top (same vertex count after BuildClosedLoop).
// zpack: [z_bot, z_top]. Returns kind-0 ruled solid or 0.
Function.CAD_Feat.LoftProfiles {
    Input: sketch_bot: Integer
    Input: sketch_top: Integer
    Input: zpack_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_bot, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(sketch_top, 0) ThenBlock: { ReturnValue(0) }
        nb = CAD_Store.Read(sketch_bot, 2)
        IfCondition LessThan(nb, 3) ThenBlock: {
            nb = CAD_Sketch.BuildClosedLoop(sketch_bot)
        }
        nt = CAD_Store.Read(sketch_top, 2)
        IfCondition LessThan(nt, 3) ThenBlock: {
            nt = CAD_Sketch.BuildClosedLoop(sketch_top)
        }
        IfCondition LessThan(nb, 3) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(nb, nt) ThenBlock: { ReturnValue(0) }
        bot = CAD_Store.Read(sketch_bot, 3)
        top = CAD_Store.Read(sketch_top, 3)
        IfCondition EqualTo(bot, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(top, 0) ThenBlock: { ReturnValue(0) }
        out = Allocate(16)
        h = CAD_Topo.MakeRuledSolid(bot, top, nb, zpack_addr, out)
        Deallocate(out, 16)
        IfCondition NotEqual(h, 0) ThenBlock: {
            CAD_Feat_State.pads_made = Add(CAD_Feat_State.pads_made, 1)
            CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        }
        ReturnValue(h)
    }
}

// Sweep closed sketch along polyline path (parallel transport of XY profile).
// path_xyz: [x,y,z]*npath, npath 2..32. Path must change Z between consecutive points.
// Returns kind-0 solid (or compound of segments) or 0.
Function.CAD_Feat.SweepProfile {
    Input: sketch_handle: Integer
    Input: path_xyz: Address
    Input: npath: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(npath, 2) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(sketch_handle, 2)
        IfCondition LessThan(n, 3) ThenBlock: {
            n = CAD_Sketch.BuildClosedLoop(sketch_handle)
        }
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        // tessellate arcs/circles into loop if needed
        CAD_Sketch.TessellateArcs(sketch_handle, 16)
        CAD_Sketch.TessellateCircles(sketch_handle, 24)
        n = CAD_Store.Read(sketch_handle, 2)
        IfCondition LessThan(n, 3) ThenBlock: {
            n = CAD_Sketch.BuildClosedLoop(sketch_handle)
        }
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        loop = CAD_Store.Read(sketch_handle, 3)
        IfCondition EqualTo(loop, 0) ThenBlock: { ReturnValue(0) }
        out = Allocate(16)
        h = CAD_Topo.MakePathSweepSolid(loop, n, path_xyz, npath, out)
        Deallocate(out, 16)
        IfCondition NotEqual(h, 0) ThenBlock: {
            CAD_Feat_State.pads_made = Add(CAD_Feat_State.pads_made, 1)
            CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        }
        ReturnValue(h)
    }
}

// Midplane pad (Fusion "symmetric"): extrude height total, centered on sketch plane z=0.
// Result spans z = -h/2 .. +h/2.
Function.CAD_Feat.ExtrudeSymmetric {
    Input: sketch_handle: Integer
    Input: height_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        h = CAD_Feat.ExtrudeProfile(sketch_handle, height_r)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        half = Float_Div(height_r, 0x4000000000000000)
        dlt = Allocate(32)
        ArraySet(dlt, 0, 0)
        ArraySet(dlt, 1, 0)
        ArraySet(dlt, 2, Float_Sub(0, half))
        CAD_Topo.TranslateSolid(h, dlt)
        Deallocate(dlt, 32)
        ReturnValue(h)
    }
}

// Revolve sketch as cut tool into body (full turn). Recipe: RevolveProfile + Difference.
// Strong domain: body box (kind 0) − revolved on-axis cylinder (kind 1) → plate hole shell.
// Tube/annulus tool vs box: not general (returns 0 if Difference refuses).
Function.CAD_Feat.RevolveCut {
    Input: body_handle: Integer
    Input: sketch_handle: Integer
    Input: angle_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(body_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        tool = CAD_Feat.RevolveProfile(sketch_handle, angle_r)
        IfCondition EqualTo(tool, 0) ThenBlock: { ReturnValue(0) }
        // Prefer hole recipe when tool is pure cylinder and body is box
        kt = CAD_Store.Read(tool, 3)
        kb = CAD_Store.Read(body_handle, 3)
        IfCondition EqualTo(kb, 0) ThenBlock: {
            IfCondition EqualTo(kt, 1) ThenBlock: {
                ph = CAD_Store.Read(tool, 1)
                r = CAD_Store.Read(ph, 0)
                th = CAD_Store.Read(ph, 1)
                ox = CAD_Store.Read(ph, 2)
                oy = CAD_Store.Read(ph, 3)
                oz = CAD_Store.Read(ph, 4)
                // hole pack: dia, depth, cx, cy — CreateHole assumes top of body
                pack = Allocate(64)
                ArraySet(pack, 0, Float_Mul(r, 0x4000000000000000))
                ArraySet(pack, 1, th)
                ArraySet(pack, 2, ox)
                ArraySet(pack, 3, oy)
                // if tool not at z=0, still use body top cut depth = th
                outt = Allocate(16)
                h = CAD_Feat.CreateHole(body_handle, pack, outt)
                Deallocate(pack, 64)
                Deallocate(outt, 16)
                IfCondition NotEqual(h, 0) ThenBlock: { ReturnValue(h) }
            }
        }
        cut = CAD_Bool.Difference(body_handle, tool)
        IfCondition NotEqual(cut, 0) ThenBlock: {
            CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        }
        ReturnValue(cut)
    }
}

// Extrude closed sketch profile(s) along +Z by height_r → solid.
// Phase A: pure CIRCLE → cyl; 1 loop → box/poly prism; 2+ loops → outer+holes plate.
Function.CAD_Feat.ExtrudeProfile {
    Input: sketch_handle: Integer
    Input: height_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        nl = CAD_Store.Read(sketch_handle, 0)
        nc = CAD_Store.Read(sketch_handle, 7)
        na = CAD_Store.Read(sketch_handle, 10)
        // pure circle(s), no lines/arcs yet: analytic cylinder
        IfCondition EqualTo(nl, 0) ThenBlock: {
            IfCondition EqualTo(na, 0) ThenBlock: {
                IfCondition GreaterThan(nc, 0) ThenBlock: {
                    circs = CAD_Store.Read(sketch_handle, 8)
                    cx = ArrayGet(circs, 0)
                    cy = ArrayGet(circs, 1)
                    rad = ArrayGet(circs, 2)
                    out = Allocate(16)
                    h = CAD_Topo.MakeCylinderSolid(rad, height_r, out)
                    Deallocate(out, 16)
                    IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
                    dlt = Allocate(32)
                    ArraySet(dlt, 0, cx)
                    ArraySet(dlt, 1, cy)
                    ArraySet(dlt, 2, 0)
                    CAD_Topo.TranslateSolid(h, dlt)
                    Deallocate(dlt, 32)
                    CAD_Feat_State.pads_made = Add(CAD_Feat_State.pads_made, 1)
                    CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
                    ReturnValue(h)
                }
            }
        }
        // merge open line chains onto circles (clip arc), then closed profiles
        nprof = CAD_Store.Read(sketch_handle, 12)
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            nprof = CAD_Sketch.PrepareExtrude(sketch_handle)
        }
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            n = CAD_Sketch.BuildClosedLoop(sketch_handle)
            IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
            nprof = 1
        }
        n = CAD_Store.Read(sketch_handle, 2)
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        loop = CAD_Store.Read(sketch_handle, 3)

        // Safety net only: MakePolyPrism allows 2048 verts. Decimate if somehow denser.
        // Always keep first point; sample remaining target-1 slots.
        prism_xy = loop
        prism_n = n
        decim = 0
        IfCondition GreaterThan(n, 2048) ThenBlock: {
            // 2048 pts × 2 floats × 8 bytes = 32768
            decim = Allocate(32768)
            target = 2048
            ArraySet(decim, 0, ArrayGet(loop, 0))
            ArraySet(decim, 1, ArrayGet(loop, 1))
            k = 1
            WhileLoop LessThan(k, target) {
                // src = floor(k * n / target) — avoid last==first duplicate
                src = Divide(Multiply(k, n), target)
                IfCondition GreaterEqual(src, n) ThenBlock: { src = Subtract(n, 1) }
                ArraySet(decim, Multiply(k, 2), ArrayGet(loop, Multiply(src, 2)))
                ArraySet(decim, Add(Multiply(k, 2), 1), ArrayGet(loop, Add(Multiply(src, 2), 1)))
                k = Add(k, 1)
            }
            prism_xy = decim
            prism_n = target
        }

        // Outer pad (profile 0 / primary). Extra closed loops → through holes.
        xmin = ArrayGet(prism_xy, 0)
        ymin = ArrayGet(prism_xy, 1)
        xmax = xmin
        ymax = ymin
        i = 1
        WhileLoop LessThan(i, prism_n) {
            x = ArrayGet(prism_xy, Multiply(i, 2))
            y = ArrayGet(prism_xy, Add(Multiply(i, 2), 1))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            i = Add(i, 1)
        }
        is_rect = 0
        IfCondition EqualTo(prism_n, 4) ThenBlock: {
            is_rect = 1
            i = 0
            WhileLoop LessThan(i, 4) {
                x = ArrayGet(prism_xy, Multiply(i, 2))
                y = ArrayGet(prism_xy, Add(Multiply(i, 2), 1))
                ox = 0
                oy = 0
                IfCondition EqualTo(CAD_Num.IsEqual(x, xmin, 0), 1) ThenBlock: { ox = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(x, xmax, 0), 1) ThenBlock: { ox = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(y, ymin, 0), 1) ThenBlock: { oy = 1 }
                IfCondition EqualTo(CAD_Num.IsEqual(y, ymax, 0), 1) ThenBlock: { oy = 1 }
                IfCondition EqualTo(ox, 0) ThenBlock: { is_rect = 0 }
                IfCondition EqualTo(oy, 0) ThenBlock: { is_rect = 0 }
                i = Add(i, 1)
            }
        }
        out = Allocate(16)
        h = 0
        IfCondition EqualTo(is_rect, 1) ThenBlock: {
            mn = Allocate(32)
            mx = Allocate(32)
            ArraySet(mn, 0, xmin)
            ArraySet(mn, 1, ymin)
            ArraySet(mn, 2, 0)
            ArraySet(mx, 0, xmax)
            ArraySet(mx, 1, ymax)
            ArraySet(mx, 2, height_r)
            h = CAD_Topo.MakeBoxSolid(mn, mx, out)
            Deallocate(mn, 32)
            Deallocate(mx, 32)
        }
        IfCondition EqualTo(is_rect, 0) ThenBlock: {
            h = CAD_Topo.MakePolyPrism(prism_xy, prism_n, height_r, out)
        }
        IfCondition NotEqual(decim, 0) ThenBlock: {
            Deallocate(decim, 32768)
        }
        Deallocate(out, 16)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Feat_State.pads_made = Add(CAD_Feat_State.pads_made, 1)
        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)

        // Additional profiles = through cuts (any count)
        IfCondition GreaterThan(nprof, 1) ThenBlock: {
            hole_xy = Allocate(4096)
            pi = 1
            WhileLoop LessThan(pi, nprof) {
                nh = CAD_Sketch.GetProfileXY(sketch_handle, pi, hole_xy)
                IfCondition GreaterEqual(nh, 3) ThenBlock: {
                    cut = 0
                    // Fast path: first cut on kind-0 box → plate shell
                    IfCondition EqualTo(is_rect, 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(h, 3), 0) ThenBlock: {
                            pack = Allocate(64)
                            ArraySet(pack, 0, xmin)
                            ArraySet(pack, 1, ymin)
                            ArraySet(pack, 2, xmax)
                            ArraySet(pack, 3, ymax)
                            ArraySet(pack, 4, height_r)
                            out2 = Allocate(16)
                            cut = CAD_Topo.MakePlateThroughPolyHole(pack, hole_xy, nh, out2)
                            Deallocate(out2, 16)
                            Deallocate(pack, 64)
                        }
                    }
                    IfCondition EqualTo(cut, 0) ThenBlock: {
                        hsk = CAD_Sketch.FromClosedXY(hole_xy, nh)
                        IfCondition NotEqual(hsk, 0) ThenBlock: {
                            cut = CAD_Feat.ExtrudeCut(h, hsk, height_r)
                        }
                    }
                    IfCondition NotEqual(cut, 0) ThenBlock: {
                        h = cut
                        CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
                    }
                }
                pi = Add(pi, 1)
            }
            Deallocate(hole_xy, 4096)
        }
        ReturnValue(h)
    }
}

// Door-escutcheon: outer plate sketch (rect) + hole sketch (poly) → through cut.
// Outer AABB from outer sketch loop; hole loop extruded as through poly hole.
// height_r = plate thickness. Returns solid or 0.
Function.CAD_Feat.ExtrudePlateThroughHole {
    Input: outer_sketch: Integer
    Input: hole_sketch: Integer
    Input: height_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(outer_sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(hole_sketch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        no = CAD_Store.Read(outer_sketch, 2)
        IfCondition LessThan(no, 3) ThenBlock: {
            no = CAD_Sketch.BuildClosedLoop(outer_sketch)
        }
        IfCondition LessThan(no, 3) ThenBlock: { ReturnValue(0) }
        oloop = CAD_Store.Read(outer_sketch, 3)
        xmin = ArrayGet(oloop, 0)
        ymin = ArrayGet(oloop, 1)
        xmax = xmin
        ymax = ymin
        i = 1
        WhileLoop LessThan(i, no) {
            x = ArrayGet(oloop, Multiply(i, 2))
            y = ArrayGet(oloop, Add(Multiply(i, 2), 1))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            i = Add(i, 1)
        }
        nh = CAD_Store.Read(hole_sketch, 2)
        IfCondition LessThan(nh, 3) ThenBlock: {
            nh = CAD_Sketch.BuildClosedLoop(hole_sketch)
        }
        IfCondition LessThan(nh, 3) ThenBlock: { ReturnValue(0) }
        hloop = CAD_Store.Read(hole_sketch, 3)
        pack = Allocate(64)
        ArraySet(pack, 0, xmin)
        ArraySet(pack, 1, ymin)
        ArraySet(pack, 2, xmax)
        ArraySet(pack, 3, ymax)
        ArraySet(pack, 4, height_r)
        out = Allocate(16)
        h = CAD_Topo.MakePlateThroughPolyHole(pack, hloop, nh, out)
        Deallocate(out, 16)
        Deallocate(pack, 64)
        IfCondition NotEqual(h, 0) ThenBlock: {
            CAD_Feat_State.pads_made = Add(CAD_Feat_State.pads_made, 1)
            CAD_Feat_State.feature_count = Add(CAD_Feat_State.feature_count, 1)
        }
        ReturnValue(h)
    }
}

// -------------------------------------------------------------------------
// Naming — loud failure until provenance is real (design Feat_Pid)
// -------------------------------------------------------------------------
Function.CAD_Feat.ResolveNaming {
    Input: feature_handle: Integer
    Input: naming_tag_str: Address
    Input: out_entity_handle_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(feature_handle, 0) ThenBlock: {
            ReturnValue(-17)
        }
        // Not implemented: refuse to invent a face
        ArraySet(out_entity_handle_addr, 0, 0)
        ReturnValue(-17)
    }
}
