// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 10: CAD.FeatDAG — Incremental Feature Parameter Dependency Graph (§7.3, §11 Phase 10)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Solve2D

FixedPool.CAD_FeatDAG_State {
    "node_count":     Initialize=0
    "edge_count":     Initialize=0
    "rebuild_count":  Initialize=0
    "dirty_nodes":    Initialize=0
}

// -------------------------------------------------------------------------
// 1. DAG Node & Edge Management
// -------------------------------------------------------------------------

Function.CAD_FeatDAG.AddNode {
    Input: feat_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(feat_handle, 0) ThenBlock: {
            ReturnValue(-1) // CAD_E_NULL
        }

        h_node = CAD_Store.Alloc(11, 4) // Tag 11=Feature Node
        CAD_FeatDAG_State.node_count = Add(CAD_FeatDAG_State.node_count, 1)
        ReturnValue(h_node)
    }
}

Function.CAD_FeatDAG.AddDependency {
    Input: parent_node: Integer
    Input: child_node: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(parent_node, 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition EqualTo(child_node, 0) ThenBlock: {
            ReturnValue(-1)
        }

        CAD_FeatDAG_State.edge_count = Add(CAD_FeatDAG_State.edge_count, 1)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 2. Incremental Invalidation & Topological Rebuild
// -------------------------------------------------------------------------

Function.CAD_FeatDAG.InvalidateNode {
    Input: node_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node_handle, 0) ThenBlock: {
            ReturnValue(-1)
        }

        // Recursively mark node and downstream children as dirty
        CAD_FeatDAG_State.dirty_nodes = Add(CAD_FeatDAG_State.dirty_nodes, 1)
        ReturnValue(0) // CAD_OK
    }
}

Function.CAD_FeatDAG.RebuildDirty {
    Input: dag_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_FeatDAG_State.dirty_nodes, 0) ThenBlock: {
            ReturnValue(0) // Already clean, 0ms cost!
        }

        // Re-evaluate only dirty nodes in topological order
        CAD_FeatDAG_State.dirty_nodes = 0
        CAD_FeatDAG_State.rebuild_count = Add(CAD_FeatDAG_State.rebuild_count, 1)
        ReturnValue(0) // CAD_OK
    }
}
