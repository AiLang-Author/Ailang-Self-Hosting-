// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 1: CAD.Geom — Analytic curves/surfaces, range-reduced trig, derivatives, project
// Import: LibraryImport.Cad.CAD_Geom

LibraryImport.Cad.CAD_Num

FixedPool.CAD_Geom_State {
    "curve_count": Initialize=0
    "surf_count":  Initialize=0
}

// IEEE bit patterns
// 0.0, 1.0, -1.0, 0.5, pi, pi/2, 2*pi

// -------------------------------------------------------------------------
// Range reduction: fold x into [-pi, pi], then Taylor on [-pi/2, pi/2]
// Float_Sin/Cos not yet emitted by compiler — pure AILang poly is required.
// -------------------------------------------------------------------------

Function.CAD_Geom.ReducePi {
    Input: x_r: Integer
    Output: Integer
    Body: {
        pi_r = 0x400921FB54442D18
        two_pi_r = 0x401921FB54442D18
        // Clamp iterations for pathological inputs
        guard = 0
        WhileLoop LessThan(guard, 64) {
            mag = BitwiseAnd(x_r, 0x7FFFFFFFFFFFFFFF)
            IfCondition EqualTo(Float_Le(mag, pi_r), 1) ThenBlock: {
                ReturnValue(x_r)
            }
            // x > pi or x < -pi
            sign_neg = BitwiseAnd(x_r, 0x8000000000000000)
            IfCondition NotEqual(sign_neg, 0) ThenBlock: {
                x_r = Float_Add(x_r, two_pi_r)
            } ElseBlock: {
                x_r = Float_Sub(x_r, two_pi_r)
            }
            guard = Add(guard, 1)
        }
        ReturnValue(x_r)
    }
}

// Taylor cos on reduced angle in roughly [-pi, pi] via fold to [-pi/2, pi/2]
Function.CAD_Geom.Cos {
    Input: x_r: Integer
    Output: Integer
    Body: {
        mag_r = BitwiseAnd(x_r, 0x7FFFFFFFFFFFFFFF)
        IfCondition EqualTo(mag_r, 0) ThenBlock: {
            ReturnValue(0x3FF0000000000000)
        }

        x_r = CAD_Geom.ReducePi(x_r)
        pi_r = 0x400921FB54442D18
        pi_half_r = 0x3FF921FB54442D18
        one_r = 0x3FF0000000000000
        zero_r = 0x0000000000000000
        sign_cos = one_r

        // Fold to [0, pi] using evenness: cos(-x)=cos(x)
        x_r = BitwiseAnd(x_r, 0x7FFFFFFFFFFFFFFF)

        // If x > pi/2: cos(x) = -cos(pi - x), with (pi-x) in [0, pi/2]
        IfCondition EqualTo(Float_Le(x_r, pi_half_r), 0) ThenBlock: {
            x_r = Float_Sub(pi_r, x_r)
            sign_cos = 0xBFF0000000000000
        }

        // Exact zeros
        IfCondition EqualTo(CAD_Num.IsZero(x_r, 0x3E7AD7F29ABCAF48), 1) ThenBlock: {
            ReturnValue(sign_cos)
        }
        diff_pi2 = Float_Sub(x_r, pi_half_r)
        IfCondition EqualTo(CAD_Num.IsZero(diff_pi2, 0x3E7AD7F29ABCAF48), 1) ThenBlock: {
            ReturnValue(zero_r)
        }

        // cos(x) = 1 - x^2/2! + x^4/4! - x^6/6! + x^8/8! - x^10/10!
        x2 = Float_Mul(x_r, x_r)
        x4 = Float_Mul(x2, x2)
        x6 = Float_Mul(x4, x2)
        x8 = Float_Mul(x4, x4)
        x10 = Float_Mul(x8, x2)

        t2 = Float_Div(x2, 0x4000000000000000)
        t4 = Float_Div(x4, 0x4038000000000000)
        t6 = Float_Div(x6, 0x4086800000000000)
        t8 = Float_Div(x8, 0x40D3B00000000000)
        t10 = Float_Div(x10, 0x412E240000000000)

        res = Float_Sub(one_r, t2)
        res = Float_Add(res, t4)
        res = Float_Sub(res, t6)
        res = Float_Add(res, t8)
        res = Float_Sub(res, t10)
        res = Float_Mul(res, sign_cos)
        ReturnValue(res)
    }
}

Function.CAD_Geom.Sin {
    Input: x_r: Integer
    Output: Integer
    Body: {
        mag_r = BitwiseAnd(x_r, 0x7FFFFFFFFFFFFFFF)
        IfCondition EqualTo(mag_r, 0) ThenBlock: {
            ReturnValue(0x0000000000000000)
        }

        sign_in = BitwiseAnd(x_r, 0x8000000000000000)
        x_r = CAD_Geom.ReducePi(x_r)
        // preserve oddness from reduced value
        sign_in = BitwiseAnd(x_r, 0x8000000000000000)
        x_abs = BitwiseAnd(x_r, 0x7FFFFFFFFFFFFFFF)

        pi_r = 0x400921FB54442D18
        pi_half_r = 0x3FF921FB54442D18
        one_r = 0x3FF0000000000000
        sign_sin = one_r
        IfCondition NotEqual(sign_in, 0) ThenBlock: {
            sign_sin = 0xBFF0000000000000
        }

        // If x_abs > pi/2: sin(x) = sin(pi - x) for x in (pi/2, pi]
        IfCondition EqualTo(Float_Le(x_abs, pi_half_r), 0) ThenBlock: {
            x_abs = Float_Sub(pi_r, x_abs)
        }

        IfCondition EqualTo(CAD_Num.IsZero(x_abs, 0x3E7AD7F29ABCAF48), 1) ThenBlock: {
            ReturnValue(0x0000000000000000)
        }
        diff_pi2 = Float_Sub(x_abs, pi_half_r)
        IfCondition EqualTo(CAD_Num.IsZero(diff_pi2, 0x3E7AD7F29ABCAF48), 1) ThenBlock: {
            ReturnValue(sign_sin)
        }

        // sin(x) = x - x^3/3! + x^5/5! - x^7/7! + x^9/9! - x^11/11!
        x2 = Float_Mul(x_abs, x_abs)
        x3 = Float_Mul(x2, x_abs)
        x5 = Float_Mul(x3, x2)
        x7 = Float_Mul(x5, x2)
        x9 = Float_Mul(x7, x2)
        x11 = Float_Mul(x9, x2)

        t3 = Float_Div(x3, 0x4018000000000000)
        t5 = Float_Div(x5, 0x405E000000000000)
        t7 = Float_Div(x7, 0x40B3B00000000000)
        t9 = Float_Div(x9, 0x4116260000000000)
        t11 = Float_Div(x11, 0x4181A80000000000)

        res = Float_Sub(x_abs, t3)
        res = Float_Add(res, t5)
        res = Float_Sub(res, t7)
        res = Float_Add(res, t9)
        res = Float_Sub(res, t11)
        res = Float_Mul(res, sign_sin)
        ReturnValue(res)
    }
}

// -------------------------------------------------------------------------
// Analytic curve evaluation
// -------------------------------------------------------------------------

// Line: P(t) = P0 + t * Dir
Function.CAD_Geom.EvalLine {
    Input: p0_addr: Address
    Input: dir_addr: Address
    Input: t_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        x0_r = ArrayGet(p0_addr, 0)
        y0_r = ArrayGet(p0_addr, 1)
        z0_r = ArrayGet(p0_addr, 2)
        dx_r = ArrayGet(dir_addr, 0)
        dy_r = ArrayGet(dir_addr, 1)
        dz_r = ArrayGet(dir_addr, 2)

        ArraySet(out_p_addr, 0, Float_Add(x0_r, Float_Mul(t_r, dx_r)))
        ArraySet(out_p_addr, 1, Float_Add(y0_r, Float_Mul(t_r, dy_r)))
        ArraySet(out_p_addr, 2, Float_Add(z0_r, Float_Mul(t_r, dz_r)))
        CAD_Geom_State.curve_count = Add(CAD_Geom_State.curve_count, 1)
        ReturnValue(0)
    }
}

// dP/dt = Dir
Function.CAD_Geom.DerivLine {
    Input: dir_addr: Address
    Input: out_d_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_d_addr, 0, ArrayGet(dir_addr, 0))
        ArraySet(out_d_addr, 1, ArrayGet(dir_addr, 1))
        ArraySet(out_d_addr, 2, ArrayGet(dir_addr, 2))
        ReturnValue(0)
    }
}

// Circle: P(u) = C + R*cos(u)*X + R*sin(u)*Y
// frame_addr: [0..2]=C [3..5]=X [6..8]=Y  (same layout as EvalCylinder)
// ≤5 Inputs for SysV ABI
Function.CAD_Geom.EvalCircle {
    Input: frame_addr: Address
    Input: radius_r: Integer
    Input: u_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        cos_u_r = CAD_Geom.Cos(u_r)
        sin_u_r = CAD_Geom.Sin(u_r)
        rcos_r = Float_Mul(radius_r, cos_u_r)
        rsin_r = Float_Mul(radius_r, sin_u_r)

        cx_r = ArrayGet(frame_addr, 0)
        cy_r = ArrayGet(frame_addr, 1)
        cz_r = ArrayGet(frame_addr, 2)
        xx_r = ArrayGet(frame_addr, 3)
        xy_r = ArrayGet(frame_addr, 4)
        xz_r = ArrayGet(frame_addr, 5)
        yx_r = ArrayGet(frame_addr, 6)
        yy_r = ArrayGet(frame_addr, 7)
        yz_r = ArrayGet(frame_addr, 8)

        px_r = Float_Add(cx_r, Float_Mul(rcos_r, xx_r))
        px_r = Float_Add(px_r, Float_Mul(rsin_r, yx_r))
        py_r = Float_Add(cy_r, Float_Mul(rcos_r, xy_r))
        py_r = Float_Add(py_r, Float_Mul(rsin_r, yy_r))
        pz_r = Float_Add(cz_r, Float_Mul(rcos_r, xz_r))
        pz_r = Float_Add(pz_r, Float_Mul(rsin_r, yz_r))

        ArraySet(out_p_addr, 0, px_r)
        ArraySet(out_p_addr, 1, py_r)
        ArraySet(out_p_addr, 2, pz_r)
        CAD_Geom_State.curve_count = Add(CAD_Geom_State.curve_count, 1)
        ReturnValue(0)
    }
}

// dP/du = -R*sin(u)*X + R*cos(u)*Y
Function.CAD_Geom.DerivCircle {
    Input: xaxis_addr: Address
    Input: yaxis_addr: Address
    Input: radius_r: Integer
    Input: u_r: Integer
    Input: out_d_addr: Address
    Output: Integer
    Body: {
        cos_u_r = CAD_Geom.Cos(u_r)
        sin_u_r = CAD_Geom.Sin(u_r)
        rcos_r = Float_Mul(radius_r, cos_u_r)
        rsin_r = Float_Mul(radius_r, sin_u_r)
        // -R sin
        neg_rsin = Float_Sub(0x0000000000000000, rsin_r)

        dx = Float_Add(Float_Mul(neg_rsin, ArrayGet(xaxis_addr, 0)), Float_Mul(rcos_r, ArrayGet(yaxis_addr, 0)))
        dy = Float_Add(Float_Mul(neg_rsin, ArrayGet(xaxis_addr, 1)), Float_Mul(rcos_r, ArrayGet(yaxis_addr, 1)))
        dz = Float_Add(Float_Mul(neg_rsin, ArrayGet(xaxis_addr, 2)), Float_Mul(rcos_r, ArrayGet(yaxis_addr, 2)))
        ArraySet(out_d_addr, 0, dx)
        ArraySet(out_d_addr, 1, dy)
        ArraySet(out_d_addr, 2, dz)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Surfaces — frame: [0..2] origin, [3..5] X, [6..8] Y, [9..11] Z
// -------------------------------------------------------------------------

Function.CAD_Geom.EvalPlane {
    Input: frame_addr: Address
    Input: u_r: Integer
    Input: v_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        ox = ArrayGet(frame_addr, 0)
        oy = ArrayGet(frame_addr, 1)
        oz = ArrayGet(frame_addr, 2)
        xx = ArrayGet(frame_addr, 3)
        xy = ArrayGet(frame_addr, 4)
        xz = ArrayGet(frame_addr, 5)
        yx = ArrayGet(frame_addr, 6)
        yy = ArrayGet(frame_addr, 7)
        yz = ArrayGet(frame_addr, 8)

        ArraySet(out_p_addr, 0, Float_Add(ox, Float_Add(Float_Mul(u_r, xx), Float_Mul(v_r, yx))))
        ArraySet(out_p_addr, 1, Float_Add(oy, Float_Add(Float_Mul(u_r, xy), Float_Mul(v_r, yy))))
        ArraySet(out_p_addr, 2, Float_Add(oz, Float_Add(Float_Mul(u_r, xz), Float_Mul(v_r, yz))))
        CAD_Geom_State.surf_count = Add(CAD_Geom_State.surf_count, 1)
        ReturnValue(0)
    }
}

// Cylinder: P(u,v) = Base + R cos u X + R sin u Y + v Z
Function.CAD_Geom.EvalCylinder {
    Input: frame_addr: Address
    Input: radius_r: Integer
    Input: u_r: Integer
    Input: v_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        cos_u_r = CAD_Geom.Cos(u_r)
        sin_u_r = CAD_Geom.Sin(u_r)
        rcos_r = Float_Mul(radius_r, cos_u_r)
        rsin_r = Float_Mul(radius_r, sin_u_r)

        bx = ArrayGet(frame_addr, 0)
        by = ArrayGet(frame_addr, 1)
        bz = ArrayGet(frame_addr, 2)
        xx = ArrayGet(frame_addr, 3)
        xy = ArrayGet(frame_addr, 4)
        xz = ArrayGet(frame_addr, 5)
        yx = ArrayGet(frame_addr, 6)
        yy = ArrayGet(frame_addr, 7)
        yz = ArrayGet(frame_addr, 8)
        zx = ArrayGet(frame_addr, 9)
        zy = ArrayGet(frame_addr, 10)
        zz = ArrayGet(frame_addr, 11)

        px = Float_Add(bx, Float_Mul(rcos_r, xx))
        px = Float_Add(px, Float_Mul(rsin_r, yx))
        px = Float_Add(px, Float_Mul(v_r, zx))
        py = Float_Add(by, Float_Mul(rcos_r, xy))
        py = Float_Add(py, Float_Mul(rsin_r, yy))
        py = Float_Add(py, Float_Mul(v_r, zy))
        pz = Float_Add(bz, Float_Mul(rcos_r, xz))
        pz = Float_Add(pz, Float_Mul(rsin_r, yz))
        pz = Float_Add(pz, Float_Mul(v_r, zz))

        ArraySet(out_p_addr, 0, px)
        ArraySet(out_p_addr, 1, py)
        ArraySet(out_p_addr, 2, pz)
        CAD_Geom_State.surf_count = Add(CAD_Geom_State.surf_count, 1)
        ReturnValue(0)
    }
}

// Sphere: P(u,v) = C + R cos(v) cos(u) X + R cos(v) sin(u) Y + R sin(v) Z
Function.CAD_Geom.EvalSphere {
    Input: frame_addr: Address
    Input: radius_r: Integer
    Input: u_r: Integer
    Input: v_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        cos_u_r = CAD_Geom.Cos(u_r)
        sin_u_r = CAD_Geom.Sin(u_r)
        cos_v_r = CAD_Geom.Cos(v_r)
        sin_v_r = CAD_Geom.Sin(v_r)

        rcv = Float_Mul(radius_r, cos_v_r)
        rcu = Float_Mul(rcv, cos_u_r)
        rsu = Float_Mul(rcv, sin_u_r)
        rsv = Float_Mul(radius_r, sin_v_r)

        cx = ArrayGet(frame_addr, 0)
        cy = ArrayGet(frame_addr, 1)
        cz = ArrayGet(frame_addr, 2)
        xx = ArrayGet(frame_addr, 3)
        xy = ArrayGet(frame_addr, 4)
        xz = ArrayGet(frame_addr, 5)
        yx = ArrayGet(frame_addr, 6)
        yy = ArrayGet(frame_addr, 7)
        yz = ArrayGet(frame_addr, 8)
        zx = ArrayGet(frame_addr, 9)
        zy = ArrayGet(frame_addr, 10)
        zz = ArrayGet(frame_addr, 11)

        px = Float_Add(cx, Float_Mul(rcu, xx))
        px = Float_Add(px, Float_Mul(rsu, yx))
        px = Float_Add(px, Float_Mul(rsv, zx))
        py = Float_Add(cy, Float_Mul(rcu, xy))
        py = Float_Add(py, Float_Mul(rsu, yy))
        py = Float_Add(py, Float_Mul(rsv, zy))
        pz = Float_Add(cz, Float_Mul(rcu, xz))
        pz = Float_Add(pz, Float_Mul(rsu, yz))
        pz = Float_Add(pz, Float_Mul(rsv, zz))

        ArraySet(out_p_addr, 0, px)
        ArraySet(out_p_addr, 1, py)
        ArraySet(out_p_addr, 2, pz)
        CAD_Geom_State.surf_count = Add(CAD_Geom_State.surf_count, 1)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Projections (orthonormal axes assumed for plane)
// -------------------------------------------------------------------------

// Closest point on infinite line; writes Q and returns t via out_t_addr[0]
Function.CAD_Geom.ProjectPointLine {
    Input: p_addr: Address
    Input: p0_addr: Address
    Input: dir_addr: Address
    Input: out_q_addr: Address
    Input: out_t_addr: Address
    Output: Integer
    Body: {
        // w = P - P0
        wx = Float_Sub(ArrayGet(p_addr, 0), ArrayGet(p0_addr, 0))
        wy = Float_Sub(ArrayGet(p_addr, 1), ArrayGet(p0_addr, 1))
        wz = Float_Sub(ArrayGet(p_addr, 2), ArrayGet(p0_addr, 2))
        dx = ArrayGet(dir_addr, 0)
        dy = ArrayGet(dir_addr, 1)
        dz = ArrayGet(dir_addr, 2)
        // t = dot(w,d) / dot(d,d)
        num = Float_Add(Float_Mul(wx, dx), Float_Add(Float_Mul(wy, dy), Float_Mul(wz, dz)))
        den = Float_Add(Float_Mul(dx, dx), Float_Add(Float_Mul(dy, dy), Float_Mul(dz, dz)))
        IfCondition EqualTo(CAD_Num.IsZero(den, 0x3E7AD7F29ABCAF48), 1) ThenBlock: {
            ReturnValue(-6)
        }
        t_r = Float_Div(num, den)
        ArraySet(out_t_addr, 0, t_r)
        CAD_Geom.EvalLine(p0_addr, dir_addr, t_r, out_q_addr)
        ReturnValue(0)
    }
}

// Closest point on plane (orthonormal X,Y). out_uv: [u,v]
Function.CAD_Geom.ProjectPointPlane {
    Input: p_addr: Address
    Input: frame_addr: Address
    Input: out_q_addr: Address
    Input: out_uv_addr: Address
    Output: Integer
    Body: {
        ox = ArrayGet(frame_addr, 0)
        oy = ArrayGet(frame_addr, 1)
        oz = ArrayGet(frame_addr, 2)
        xx = ArrayGet(frame_addr, 3)
        xy = ArrayGet(frame_addr, 4)
        xz = ArrayGet(frame_addr, 5)
        yx = ArrayGet(frame_addr, 6)
        yy = ArrayGet(frame_addr, 7)
        yz = ArrayGet(frame_addr, 8)

        wx = Float_Sub(ArrayGet(p_addr, 0), ox)
        wy = Float_Sub(ArrayGet(p_addr, 1), oy)
        wz = Float_Sub(ArrayGet(p_addr, 2), oz)

        u_r = Float_Add(Float_Mul(wx, xx), Float_Add(Float_Mul(wy, xy), Float_Mul(wz, xz)))
        v_r = Float_Add(Float_Mul(wx, yx), Float_Add(Float_Mul(wy, yy), Float_Mul(wz, yz)))
        ArraySet(out_uv_addr, 0, u_r)
        ArraySet(out_uv_addr, 1, v_r)
        CAD_Geom.EvalPlane(frame_addr, u_r, v_r, out_q_addr)
        ReturnValue(0)
    }
}
