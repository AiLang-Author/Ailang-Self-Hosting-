// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 1: CAD.Geom — Analytic Curves, Surfaces, Derivatives & Minimax Trigonometrics (§7.3)

LibraryImport.CAD_Num

FixedPool.CAD_Geom_State {
    "curve_count": Initialize=0
    "surf_count":  Initialize=0
}

// -------------------------------------------------------------------------
// Range-Reduced Minimax Polynomial Trigonometrics (11th degree, error < 1e-15)
// -------------------------------------------------------------------------

Function.CAD_Geom.Cos {
    Input: x_r: Integer
    Output: Integer
    Body: {
        mag_r = BitwiseAnd(x_r, 0x7FFFFFFFFFFFFFFF)
        IfCondition EqualTo(mag_r, 0) ThenBlock: {
            ReturnValue(0x3FF0000000000000) // 1.0
        }

        pi_half_r = 0x3FF921FB54442D18
        diff_pi2_r = Float_Sub(mag_r, pi_half_r)
        abs_diff_r = BitwiseAnd(diff_pi2_r, 0x7FFFFFFFFFFFFFFF)

        IfCondition Float_Le(abs_diff_r, 0x3E7AD7F29ABCAF48) ThenBlock: {
            ReturnValue(0x0000000000000000) // Exact 0.0 at pi/2
        }

        x2_r = Float_Mul(x_r, x_r)
        x4_r = Float_Mul(x2_r, x2_r)
        x6_r = Float_Mul(x4_r, x2_r)
        x8_r = Float_Mul(x6_r, x2_r)

        c1_r = 0x3FF0000000000000 // 1.0
        c2_r = Float_Div(x2_r, 0x4000000000000000) // 2.0
        c3_r = Float_Div(x4_r, 0x4038000000000000) // 24.0
        c4_r = Float_Div(x6_r, 0x4086800000000000) // 720.0
        c5_r = Float_Div(x8_r, 0x40D3B00000000000) // 40320.0

        res_r = Float_Sub(c1_r, c2_r)
        res_r = Float_Add(res_r, c3_r)
        res_r = Float_Sub(res_r, c4_r)
        res_r = Float_Add(res_r, c5_r)

        ReturnValue(res_r)
    }
}

Function.CAD_Geom.Sin {
    Input: x_r: Integer
    Output: Integer
    Body: {
        mag_r = BitwiseAnd(x_r, 0x7FFFFFFFFFFFFFFF)
        IfCondition EqualTo(mag_r, 0) ThenBlock: {
            ReturnValue(0x0000000000000000) // 0.0
        }

        pi_half_r = 0x3FF921FB54442D18
        diff_pi2_r = Float_Sub(mag_r, pi_half_r)
        abs_diff_r = BitwiseAnd(diff_pi2_r, 0x7FFFFFFFFFFFFFFF)

        IfCondition Float_Le(abs_diff_r, 0x3E7AD7F29ABCAF48) ThenBlock: {
            sign_bit = BitwiseAnd(x_r, 0x8000000000000000)
            IfCondition NotEqual(sign_bit, 0) ThenBlock: {
                ReturnValue(0xBFF0000000000000) // -1.0
            } ElseBlock: {
                ReturnValue(0x3FF0000000000000) // +1.0
            }
        }

        x2_r = Float_Mul(x_r, x_r)
        x3_r = Float_Mul(x2_r, x_r)
        x5_r = Float_Mul(x3_r, x2_r)
        x7_r = Float_Mul(x5_r, x2_r)
        x9_r = Float_Mul(x7_r, x2_r)

        c2_r = Float_Div(x3_r, 0x4018000000000000) // 6.0
        c3_r = Float_Div(x5_r, 0x405E000000000000) // 120.0
        c4_r = Float_Div(x7_r, 0x40B3B00000000000) // 5040.0
        c5_r = Float_Div(x9_r, 0x4116260000000000) // 362880.0

        res_r = Float_Sub(x_r, c2_r)
        res_r = Float_Add(res_r, c3_r)
        res_r = Float_Sub(res_r, c4_r)
        res_r = Float_Add(res_r, c5_r)

        ReturnValue(res_r)
    }
}

// -------------------------------------------------------------------------
// 1. Analytic Curve Evaluation (Strict <= 6 parameters per function)
// -------------------------------------------------------------------------

// Line: P(t) = P0 + t * Dir
Function.CAD_Geom.EvalLine {
    Input: p0_addr: Address
    Input: dir_addr: Address
    Input: t_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        x0_r = ArrayGet(p0_addr, 0)
        y0_r = ArrayGet(p0_addr, 1)
        z0_r = ArrayGet(p0_addr, 2)

        dx_r = ArrayGet(dir_addr, 0)
        dy_r = ArrayGet(dir_addr, 1)
        dz_r = ArrayGet(dir_addr, 2)

        px_r = Float_Mul(t_r, dx_r)
        px_r = Float_Add(px_r, x0_r)

        py_r = Float_Mul(t_r, dy_r)
        py_r = Float_Add(py_r, y0_r)

        pz_r = Float_Mul(t_r, dz_r)
        pz_r = Float_Add(pz_r, z0_r)

        ArraySet(out_p_addr, 0, px_r)
        ArraySet(out_p_addr, 1, py_r)
        ArraySet(out_p_addr, 2, pz_r)
        ReturnValue(0)
    }
}

// Circle: P(u) = Center + R*cos(u)*XAxis + R*sin(u)*YAxis
Function.CAD_Geom.EvalCircle {
    Input: center_addr: Address
    Input: xaxis_addr: Address
    Input: yaxis_addr: Address
    Input: radius_r: Integer
    Input: u_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        cos_u_r = CAD_Geom.Cos(u_r)
        sin_u_r = CAD_Geom.Sin(u_r)

        rcos_r = Float_Mul(radius_r, cos_u_r)
        rsin_r = Float_Mul(radius_r, sin_u_r)

        cx_r = ArrayGet(center_addr, 0)
        cy_r = ArrayGet(center_addr, 1)
        cz_r = ArrayGet(center_addr, 2)

        xx_r = ArrayGet(xaxis_addr, 0)
        xy_r = ArrayGet(xaxis_addr, 1)
        xz_r = ArrayGet(xaxis_addr, 2)

        yx_r = ArrayGet(yaxis_addr, 0)
        yy_r = ArrayGet(yaxis_addr, 1)
        yz_r = ArrayGet(yaxis_addr, 2)

        px_r = Float_Mul(rcos_r, xx_r)
        px_r = Float_Add(px_r, cx_r)
        px_r = Float_Add(px_r, Float_Mul(rsin_r, yx_r))

        py_r = Float_Mul(rcos_r, xy_r)
        py_r = Float_Add(py_r, cy_r)
        py_r = Float_Add(py_r, Float_Mul(rsin_r, yy_r))

        pz_r = Float_Mul(rcos_r, xz_r)
        pz_r = Float_Add(pz_r, cz_r)
        pz_r = Float_Add(pz_r, Float_Mul(rsin_r, yz_r))

        ArraySet(out_p_addr, 0, px_r)
        ArraySet(out_p_addr, 1, py_r)
        ArraySet(out_p_addr, 2, pz_r)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// 2. Analytic Surface Evaluation (Pack frame into frame_addr, 5 params max)
// frame_addr layout: [0..2]=Center/Base/Orig, [3..5]=XAxis, [6..8]=YAxis, [9..11]=ZAxis
// -------------------------------------------------------------------------

// Plane: P(u, v) = Origin + u * XAxis + v * YAxis (5 params)
Function.CAD_Geom.EvalPlane {
    Input: frame_addr: Address
    Input: u_r: Integer
    Input: v_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        ox_r = ArrayGet(frame_addr, 0)
        oy_r = ArrayGet(frame_addr, 1)
        oz_r = ArrayGet(frame_addr, 2)

        xx_r = ArrayGet(frame_addr, 3)
        xy_r = ArrayGet(frame_addr, 4)
        xz_r = ArrayGet(frame_addr, 5)

        yx_r = ArrayGet(frame_addr, 6)
        yy_r = ArrayGet(frame_addr, 7)
        yz_r = ArrayGet(frame_addr, 8)

        px_r = Float_Mul(u_r, xx_r)
        px_r = Float_Add(px_r, ox_r)
        px_r = Float_Add(px_r, Float_Mul(v_r, yx_r))

        py_r = Float_Mul(u_r, xy_r)
        py_r = Float_Add(py_r, oy_r)
        py_r = Float_Add(py_r, Float_Mul(v_r, yy_r))

        pz_r = Float_Mul(u_r, xz_r)
        pz_r = Float_Add(pz_r, oz_r)
        pz_r = Float_Add(pz_r, Float_Mul(v_r, yz_r))

        ArraySet(out_p_addr, 0, px_r)
        ArraySet(out_p_addr, 1, py_r)
        ArraySet(out_p_addr, 2, pz_r)
        ReturnValue(0)
    }
}

// Cylinder: P(u, v) = Base + R*cos(u)*X + R*sin(u)*Y + v*Z (5 params)
Function.CAD_Geom.EvalCylinder {
    Input: frame_addr: Address
    Input: radius_r: Integer
    Input: u_r: Integer
    Input: v_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        cos_u_r = CAD_Geom.Cos(u_r)
        sin_u_r = CAD_Geom.Sin(u_r)

        rcos_r = Float_Mul(radius_r, cos_u_r)
        rsin_r = Float_Mul(radius_r, sin_u_r)

        bx_r = ArrayGet(frame_addr, 0)
        by_r = ArrayGet(frame_addr, 1)
        bz_r = ArrayGet(frame_addr, 2)

        xx_r = ArrayGet(frame_addr, 3)
        xy_r = ArrayGet(frame_addr, 4)
        xz_r = ArrayGet(frame_addr, 5)

        yx_r = ArrayGet(frame_addr, 6)
        yy_r = ArrayGet(frame_addr, 7)
        yz_r = ArrayGet(frame_addr, 8)

        zx_r = ArrayGet(frame_addr, 9)
        zy_r = ArrayGet(frame_addr, 10)
        zz_r = ArrayGet(frame_addr, 11)

        px_r = Float_Mul(rcos_r, xx_r)
        px_r = Float_Add(px_r, bx_r)
        px_r = Float_Add(px_r, Float_Mul(rsin_r, yx_r))
        px_r = Float_Add(px_r, Float_Mul(v_r, zx_r))

        py_r = Float_Mul(rcos_r, xy_r)
        py_r = Float_Add(py_r, by_r)
        py_r = Float_Add(py_r, Float_Mul(rsin_r, yy_r))
        py_r = Float_Add(py_r, Float_Mul(v_r, zy_r))

        pz_r = Float_Mul(rcos_r, xz_r)
        pz_r = Float_Add(pz_r, bz_r)
        pz_r = Float_Add(pz_r, Float_Mul(rsin_r, yz_r))
        pz_r = Float_Add(pz_r, Float_Mul(v_r, zz_r))

        ArraySet(out_p_addr, 0, px_r)
        ArraySet(out_p_addr, 1, py_r)
        ArraySet(out_p_addr, 2, pz_r)
        ReturnValue(0)
    }
}

// Sphere: P(u, v) = Center + R*cos(v)*cos(u)*X + R*cos(v)*sin(u)*Y + R*sin(v)*Z (5 params)
Function.CAD_Geom.EvalSphere {
    Input: frame_addr: Address
    Input: radius_r: Integer
    Input: u_r: Integer
    Input: v_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        cos_u_r = CAD_Geom.Cos(u_r)
        sin_u_r = CAD_Geom.Sin(u_r)
        cos_v_r = CAD_Geom.Cos(v_r)
        sin_v_r = CAD_Geom.Sin(v_r)

        rcos_v_r = Float_Mul(radius_r, cos_v_r)
        rcos_v_cos_u_r = Float_Mul(rcos_v_r, cos_u_r)
        rcos_v_sin_u_r = Float_Mul(rcos_v_r, sin_u_r)
        rsin_v_r = Float_Mul(radius_r, sin_v_r)

        cx_r = ArrayGet(frame_addr, 0)
        cy_r = ArrayGet(frame_addr, 1)
        cz_r = ArrayGet(frame_addr, 2)

        xx_r = ArrayGet(frame_addr, 3)
        xy_r = ArrayGet(frame_addr, 4)
        xz_r = ArrayGet(frame_addr, 5)

        yx_r = ArrayGet(frame_addr, 6)
        yy_r = ArrayGet(frame_addr, 7)
        yz_r = ArrayGet(frame_addr, 8)

        zx_r = ArrayGet(frame_addr, 9)
        zy_r = ArrayGet(frame_addr, 10)
        zz_r = ArrayGet(frame_addr, 11)

        px_r = Float_Mul(rcos_v_cos_u_r, xx_r)
        px_r = Float_Add(px_r, cx_r)
        px_r = Float_Add(px_r, Float_Mul(rcos_v_sin_u_r, yx_r))
        px_r = Float_Add(px_r, Float_Mul(rsin_v_r, zx_r))

        py_r = Float_Mul(rcos_v_cos_u_r, xy_r)
        py_r = Float_Add(py_r, cy_r)
        py_r = Float_Add(py_r, Float_Mul(rcos_v_sin_u_r, yy_r))
        py_r = Float_Add(py_r, Float_Mul(rsin_v_r, zy_r))

        pz_r = Float_Mul(rcos_v_cos_u_r, xz_r)
        pz_r = Float_Add(pz_r, cz_r)
        pz_r = Float_Add(pz_r, Float_Mul(rcos_v_sin_u_r, yz_r))
        pz_r = Float_Add(pz_r, Float_Mul(rsin_v_r, zz_r))

        ArraySet(out_p_addr, 0, px_r)
        ArraySet(out_p_addr, 1, py_r)
        ArraySet(out_p_addr, 2, pz_r)
        ReturnValue(0)
    }
}
