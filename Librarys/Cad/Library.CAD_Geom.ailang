// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 1: CAD.Geom — Analytic curves/surfaces, range-reduced trig, derivatives, project
// Store-backed records: tag 0x10=Curve, 0x11=Surface (design §4.2)
// Curve LINE stride 8: kind=1, p0x,p0y,p0z, dx,dy,dz, unused
// Curve CIRCLE stride 12: kind=2, Cx,Cy,Cz, Xx,Xy,Xz, Yx,Yy,Yz, R, unused
// Curve ELLIPSE stride 13: kind=3, Cx,Cy,Cz, Xx.. (major), Yx.. (minor), Rmaj, Rmin, unused
// Surface PLANE stride 14: kind=1, Ox,Oy,Oz, Xx.., Yx.., Zx.., unused
// Surface CYLINDER stride 15: kind=2, Ox..Z.., R
// Surface SPHERE stride 5: kind=3, Cx,Cy,Cz, R
// Import: LibraryImport.Cad.CAD_Geom

LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store

FixedPool.CAD_Geom_State {
    "curve_count": Initialize=0
    "surf_count":  Initialize=0
}

FixedPool.CAD_Geom_Kind {
    "LINE":      Initialize=1
    "CIRCLE":    Initialize=2
    "ELLIPSE":   Initialize=3
    "PLANE":     Initialize=1
    "CYLINDER":  Initialize=2
    "SPHERE":    Initialize=3
}

// -------------------------------------------------------------------------
// Constructors — Store slabs (handles for Topo edge.curve / face.surface)
// -------------------------------------------------------------------------

// Infinite line through p0 toward p1 (dir = p1 - p0, not required unit)
Function.CAD_Geom.MakeLine {
    Input: p0_addr: Address
    Input: p1_addr: Address
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(16, 8)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        dx = Float_Sub(ArrayGet(p1_addr, 0), ArrayGet(p0_addr, 0))
        dy = Float_Sub(ArrayGet(p1_addr, 1), ArrayGet(p0_addr, 1))
        dz = Float_Sub(ArrayGet(p1_addr, 2), ArrayGet(p0_addr, 2))
        CAD_Store.Write(h, 0, CAD_Geom_Kind.LINE)
        CAD_Store.Write(h, 1, ArrayGet(p0_addr, 0))
        CAD_Store.Write(h, 2, ArrayGet(p0_addr, 1))
        CAD_Store.Write(h, 3, ArrayGet(p0_addr, 2))
        CAD_Store.Write(h, 4, dx)
        CAD_Store.Write(h, 5, dy)
        CAD_Store.Write(h, 6, dz)
        CAD_Store.Write(h, 7, 0)
        CAD_Geom_State.curve_count = Add(CAD_Geom_State.curve_count, 1)
        ReturnValue(h)
    }
}

// Line from p0 + dir (dir_addr is 3-vector)
Function.CAD_Geom.MakeLineDir {
    Input: p0_addr: Address
    Input: dir_addr: Address
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(16, 8)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Geom_Kind.LINE)
        CAD_Store.Write(h, 1, ArrayGet(p0_addr, 0))
        CAD_Store.Write(h, 2, ArrayGet(p0_addr, 1))
        CAD_Store.Write(h, 3, ArrayGet(p0_addr, 2))
        CAD_Store.Write(h, 4, ArrayGet(dir_addr, 0))
        CAD_Store.Write(h, 5, ArrayGet(dir_addr, 1))
        CAD_Store.Write(h, 6, ArrayGet(dir_addr, 2))
        CAD_Store.Write(h, 7, 0)
        CAD_Geom_State.curve_count = Add(CAD_Geom_State.curve_count, 1)
        ReturnValue(h)
    }
}

// Plane from origin + X axis + Y axis; Z = X × Y (caller should pass unit axes)
Function.CAD_Geom.MakePlaneAxes {
    Input: origin_addr: Address
    Input: x_addr: Address
    Input: y_addr: Address
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(17, 14)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        xx = ArrayGet(x_addr, 0)
        xy = ArrayGet(x_addr, 1)
        xz = ArrayGet(x_addr, 2)
        yx = ArrayGet(y_addr, 0)
        yy = ArrayGet(y_addr, 1)
        yz = ArrayGet(y_addr, 2)
        // Z = X × Y
        zx = Float_Sub(Float_Mul(xy, yz), Float_Mul(xz, yy))
        zy = Float_Sub(Float_Mul(xz, yx), Float_Mul(xx, yz))
        zz = Float_Sub(Float_Mul(xx, yy), Float_Mul(xy, yx))
        CAD_Store.Write(h, 0, CAD_Geom_Kind.PLANE)
        CAD_Store.Write(h, 1, ArrayGet(origin_addr, 0))
        CAD_Store.Write(h, 2, ArrayGet(origin_addr, 1))
        CAD_Store.Write(h, 3, ArrayGet(origin_addr, 2))
        CAD_Store.Write(h, 4, xx)
        CAD_Store.Write(h, 5, xy)
        CAD_Store.Write(h, 6, xz)
        CAD_Store.Write(h, 7, yx)
        CAD_Store.Write(h, 8, yy)
        CAD_Store.Write(h, 9, yz)
        CAD_Store.Write(h, 10, zx)
        CAD_Store.Write(h, 11, zy)
        CAD_Store.Write(h, 12, zz)
        CAD_Store.Write(h, 13, 0)
        CAD_Geom_State.surf_count = Add(CAD_Geom_State.surf_count, 1)
        ReturnValue(h)
    }
}

// Circle: frame [C X Y] (9 words) + radius. Param u in [0,2pi)
Function.CAD_Geom.MakeCircle {
    Input: frame_addr: Address
    Input: radius_r: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(16, 14)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Geom_Kind.CIRCLE)
        CAD_Store.Write(h, 1, ArrayGet(frame_addr, 0))
        CAD_Store.Write(h, 2, ArrayGet(frame_addr, 1))
        CAD_Store.Write(h, 3, ArrayGet(frame_addr, 2))
        CAD_Store.Write(h, 4, ArrayGet(frame_addr, 3))
        CAD_Store.Write(h, 5, ArrayGet(frame_addr, 4))
        CAD_Store.Write(h, 6, ArrayGet(frame_addr, 5))
        CAD_Store.Write(h, 7, ArrayGet(frame_addr, 6))
        CAD_Store.Write(h, 8, ArrayGet(frame_addr, 7))
        CAD_Store.Write(h, 9, ArrayGet(frame_addr, 8))
        CAD_Store.Write(h, 10, radius_r)
        CAD_Store.Write(h, 11, 0)
        CAD_Store.Write(h, 12, 0)
        CAD_Geom_State.curve_count = Add(CAD_Geom_State.curve_count, 1)
        ReturnValue(h)
    }
}

// Ellipse: frame [C Xmaj Ymin] (9) + Rmaj + Rmin. Point = C + Rmaj cos t X + Rmin sin t Y.
// OCC-proven digon corners for equal-R cylinder–cylinder (Steinmetz) use this.
Function.CAD_Geom.MakeEllipse {
    Input: frame_addr: Address
    Input: rmaj_r: Integer
    Input: rmin_r: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(16, 13)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Geom_Kind.ELLIPSE)
        CAD_Store.Write(h, 1, ArrayGet(frame_addr, 0))
        CAD_Store.Write(h, 2, ArrayGet(frame_addr, 1))
        CAD_Store.Write(h, 3, ArrayGet(frame_addr, 2))
        CAD_Store.Write(h, 4, ArrayGet(frame_addr, 3))
        CAD_Store.Write(h, 5, ArrayGet(frame_addr, 4))
        CAD_Store.Write(h, 6, ArrayGet(frame_addr, 5))
        CAD_Store.Write(h, 7, ArrayGet(frame_addr, 6))
        CAD_Store.Write(h, 8, ArrayGet(frame_addr, 7))
        CAD_Store.Write(h, 9, ArrayGet(frame_addr, 8))
        CAD_Store.Write(h, 10, rmaj_r)
        CAD_Store.Write(h, 11, rmin_r)
        CAD_Store.Write(h, 12, 0)
        CAD_Geom_State.curve_count = Add(CAD_Geom_State.curve_count, 1)
        ReturnValue(h)
    }
}

// Spherical surface: center + radius. stride 5: kind=3, cx,cy,cz, R
Function.CAD_Geom.MakeSphereSurf {
    Input: center_addr: Address
    Input: radius_r: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(17, 5)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Geom_Kind.SPHERE)
        CAD_Store.Write(h, 1, ArrayGet(center_addr, 0))
        CAD_Store.Write(h, 2, ArrayGet(center_addr, 1))
        CAD_Store.Write(h, 3, ArrayGet(center_addr, 2))
        CAD_Store.Write(h, 4, radius_r)
        CAD_Geom_State.surf_count = Add(CAD_Geom_State.surf_count, 1)
        ReturnValue(h)
    }
}

// Infinite cylinder surface: frame [O X Y Z] (12) + radius. Axis = Z.
Function.CAD_Geom.MakeCylinderSurf {
    Input: frame_addr: Address
    Input: radius_r: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(17, 15)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Geom_Kind.CYLINDER)
        CAD_Store.Write(h, 1, ArrayGet(frame_addr, 0))
        CAD_Store.Write(h, 2, ArrayGet(frame_addr, 1))
        CAD_Store.Write(h, 3, ArrayGet(frame_addr, 2))
        CAD_Store.Write(h, 4, ArrayGet(frame_addr, 3))
        CAD_Store.Write(h, 5, ArrayGet(frame_addr, 4))
        CAD_Store.Write(h, 6, ArrayGet(frame_addr, 5))
        CAD_Store.Write(h, 7, ArrayGet(frame_addr, 6))
        CAD_Store.Write(h, 8, ArrayGet(frame_addr, 7))
        CAD_Store.Write(h, 9, ArrayGet(frame_addr, 8))
        CAD_Store.Write(h, 10, ArrayGet(frame_addr, 9))
        CAD_Store.Write(h, 11, ArrayGet(frame_addr, 10))
        CAD_Store.Write(h, 12, ArrayGet(frame_addr, 11))
        CAD_Store.Write(h, 13, radius_r)
        CAD_Store.Write(h, 14, 0)
        CAD_Geom_State.surf_count = Add(CAD_Geom_State.surf_count, 1)
        ReturnValue(h)
    }
}

// Copy 12-word frame [O X Y Z] into a plane surface record
Function.CAD_Geom.MakePlaneFrame {
    Input: frame_addr: Address
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(17, 14)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, CAD_Geom_Kind.PLANE)
        CAD_Store.Write(h, 1, ArrayGet(frame_addr, 0))
        CAD_Store.Write(h, 2, ArrayGet(frame_addr, 1))
        CAD_Store.Write(h, 3, ArrayGet(frame_addr, 2))
        CAD_Store.Write(h, 4, ArrayGet(frame_addr, 3))
        CAD_Store.Write(h, 5, ArrayGet(frame_addr, 4))
        CAD_Store.Write(h, 6, ArrayGet(frame_addr, 5))
        CAD_Store.Write(h, 7, ArrayGet(frame_addr, 6))
        CAD_Store.Write(h, 8, ArrayGet(frame_addr, 7))
        CAD_Store.Write(h, 9, ArrayGet(frame_addr, 8))
        CAD_Store.Write(h, 10, ArrayGet(frame_addr, 9))
        CAD_Store.Write(h, 11, ArrayGet(frame_addr, 10))
        CAD_Store.Write(h, 12, ArrayGet(frame_addr, 11))
        CAD_Store.Write(h, 13, 0)
        CAD_Geom_State.surf_count = Add(CAD_Geom_State.surf_count, 1)
        ReturnValue(h)
    }
}

// Read line p0+dir into two 3-vectors (out_p0, out_dir)
Function.CAD_Geom.LineGet {
    Input: line_h: Integer
    Input: out_p0_addr: Address
    Input: out_dir_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store.IsLive(line_h), 0) ThenBlock: { ReturnValue(-3) }
        ArraySet(out_p0_addr, 0, CAD_Store.Read(line_h, 1))
        ArraySet(out_p0_addr, 1, CAD_Store.Read(line_h, 2))
        ArraySet(out_p0_addr, 2, CAD_Store.Read(line_h, 3))
        ArraySet(out_dir_addr, 0, CAD_Store.Read(line_h, 4))
        ArraySet(out_dir_addr, 1, CAD_Store.Read(line_h, 5))
        ArraySet(out_dir_addr, 2, CAD_Store.Read(line_h, 6))
        ReturnValue(0)
    }
}

// Write plane frame words 0..11 (O X Y Z) for EvalPlane / ProjectPointPlane
Function.CAD_Geom.PlaneGetFrame {
    Input: plane_h: Integer
    Input: out_frame_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store.IsLive(plane_h), 0) ThenBlock: { ReturnValue(-3) }
        ArraySet(out_frame_addr, 0, CAD_Store.Read(plane_h, 1))
        ArraySet(out_frame_addr, 1, CAD_Store.Read(plane_h, 2))
        ArraySet(out_frame_addr, 2, CAD_Store.Read(plane_h, 3))
        ArraySet(out_frame_addr, 3, CAD_Store.Read(plane_h, 4))
        ArraySet(out_frame_addr, 4, CAD_Store.Read(plane_h, 5))
        ArraySet(out_frame_addr, 5, CAD_Store.Read(plane_h, 6))
        ArraySet(out_frame_addr, 6, CAD_Store.Read(plane_h, 7))
        ArraySet(out_frame_addr, 7, CAD_Store.Read(plane_h, 8))
        ArraySet(out_frame_addr, 8, CAD_Store.Read(plane_h, 9))
        ArraySet(out_frame_addr, 9, CAD_Store.Read(plane_h, 10))
        ArraySet(out_frame_addr, 10, CAD_Store.Read(plane_h, 11))
        ArraySet(out_frame_addr, 11, CAD_Store.Read(plane_h, 12))
        ReturnValue(0)
    }
}

// Eval stored line at parameter t
Function.CAD_Geom.EvalLineH {
    Input: line_h: Integer
    Input: t_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store.IsLive(line_h), 0) ThenBlock: { ReturnValue(-3) }
        p0x = CAD_Store.Read(line_h, 1)
        p0y = CAD_Store.Read(line_h, 2)
        p0z = CAD_Store.Read(line_h, 3)
        dx = CAD_Store.Read(line_h, 4)
        dy = CAD_Store.Read(line_h, 5)
        dz = CAD_Store.Read(line_h, 6)
        ArraySet(out_p_addr, 0, Float_Add(p0x, Float_Mul(t_r, dx)))
        ArraySet(out_p_addr, 1, Float_Add(p0y, Float_Mul(t_r, dy)))
        ArraySet(out_p_addr, 2, Float_Add(p0z, Float_Mul(t_r, dz)))
        ReturnValue(0)
    }
}

// Eval stored plane at (u,v)
Function.CAD_Geom.EvalPlaneH {
    Input: plane_h: Integer
    Input: u_r: Integer
    Input: v_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store.IsLive(plane_h), 0) ThenBlock: { ReturnValue(-3) }
        ox = CAD_Store.Read(plane_h, 1)
        oy = CAD_Store.Read(plane_h, 2)
        oz = CAD_Store.Read(plane_h, 3)
        xx = CAD_Store.Read(plane_h, 4)
        xy = CAD_Store.Read(plane_h, 5)
        xz = CAD_Store.Read(plane_h, 6)
        yx = CAD_Store.Read(plane_h, 7)
        yy = CAD_Store.Read(plane_h, 8)
        yz = CAD_Store.Read(plane_h, 9)
        ArraySet(out_p_addr, 0, Float_Add(ox, Float_Add(Float_Mul(u_r, xx), Float_Mul(v_r, yx))))
        ArraySet(out_p_addr, 1, Float_Add(oy, Float_Add(Float_Mul(u_r, xy), Float_Mul(v_r, yy))))
        ArraySet(out_p_addr, 2, Float_Add(oz, Float_Add(Float_Mul(u_r, xz), Float_Mul(v_r, yz))))
        ReturnValue(0)
    }
}

// IEEE bit patterns
// 0.0, 1.0, -1.0, 0.5, pi, pi/2, 2*pi

// -------------------------------------------------------------------------
// Range reduction: fold x into [-pi, pi], then Taylor on [-pi/2, pi/2]
// Float_Sin/Cos not yet emitted by compiler — pure AILang poly is required.
// -------------------------------------------------------------------------

Function.CAD_Geom.ReducePi {
    Input: x_r: Integer
    Output: Integer
    Body: {
        pi_r = 0x400921FB54442D18
        two_pi_r = 0x401921FB54442D18
        // 0x8000… immediates are broken in ailang.x — IsNeg / Abs only.
        guard = 0
        WhileLoop LessThan(guard, 64) {
            ax = CAD_Num.Abs(x_r)
            IfCondition EqualTo(Float_Le(ax, pi_r), 1) ThenBlock: {
                ReturnValue(x_r)
            }
            IfCondition EqualTo(CAD_Num.IsNeg(x_r), 1) ThenBlock: {
                x_r = Float_Add(x_r, two_pi_r)
            }
            IfCondition EqualTo(CAD_Num.IsNeg(x_r), 0) ThenBlock: {
                IfCondition EqualTo(Float_Le(CAD_Num.Abs(x_r), pi_r), 0) ThenBlock: {
                    x_r = Float_Sub(x_r, two_pi_r)
                }
            }
            guard = Add(guard, 1)
        }
        ReturnValue(x_r)
    }
}

// Taylor cos on reduced angle. cos is even; fold with CAD_Num.Abs.
Function.CAD_Geom.Cos {
    Input: x_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(x_r, 0), 1) ThenBlock: {
            ReturnValue(0x3FF0000000000000)
        }

        x_r = CAD_Geom.ReducePi(x_r)
        pi_r = 0x400921FB54442D18
        pi_half_r = 0x3FF921FB54442D18
        one_r = 0x3FF0000000000000
        zero_r = 0x0000000000000000
        sign_cos = one_r

        // Fold to [0, pi]: cos(-x)=cos(x)
        x_r = CAD_Num.Abs(x_r)

        // If x > pi/2: cos(x) = -cos(pi - x)
        IfCondition EqualTo(Float_Le(x_r, pi_half_r), 0) ThenBlock: {
            x_r = Float_Sub(pi_r, x_r)
            sign_cos = Float_Sub(0, one_r)
        }

        IfCondition EqualTo(CAD_Num.IsZero(x_r, 0x3E7AD7F29ABCAF48), 1) ThenBlock: {
            ReturnValue(sign_cos)
        }
        diff_pi2 = Float_Sub(x_r, pi_half_r)
        IfCondition EqualTo(CAD_Num.IsZero(diff_pi2, 0x3E7AD7F29ABCAF48), 1) ThenBlock: {
            ReturnValue(zero_r)
        }

        x2 = CAD_Num.Sq(x_r)
        x4 = Float_Mul(x2, x2)
        x6 = Float_Mul(x4, x2)
        x8 = Float_Mul(x4, x4)
        x10 = Float_Mul(x8, x2)

        t2 = Float_Div(x2, 0x4000000000000000)
        t4 = Float_Div(x4, 0x4038000000000000)
        t6 = Float_Div(x6, 0x4086800000000000)
        t8 = Float_Div(x8, 0x40D3B00000000000)
        t10 = Float_Div(x10, 0x412E240000000000)

        res = Float_Sub(one_r, t2)
        res = Float_Add(res, t4)
        res = Float_Sub(res, t6)
        res = Float_Add(res, t8)
        res = Float_Sub(res, t10)
        res = Float_Mul(res, sign_cos)
        ReturnValue(res)
    }
}

// Taylor sin — MUST preserve sign via CAD_Num.IsNeg (hex 0x8000… mask is broken).
Function.CAD_Geom.Sin {
    Input: x_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(x_r, 0), 1) ThenBlock: {
            ReturnValue(0x0000000000000000)
        }

        // capture sign before reduce
        neg = CAD_Num.IsNeg(x_r)
        x_r = CAD_Geom.ReducePi(x_r)
        // re-capture after reduce (odd function)
        neg = CAD_Num.IsNeg(x_r)
        x_abs = CAD_Num.Abs(x_r)

        pi_r = 0x400921FB54442D18
        pi_half_r = 0x3FF921FB54442D18
        one_r = 0x3FF0000000000000
        sign_sin = one_r
        IfCondition EqualTo(neg, 1) ThenBlock: {
            sign_sin = Float_Sub(0, one_r)
        }

        // If x_abs > pi/2: sin(x) = sin(pi - x)
        IfCondition EqualTo(Float_Le(x_abs, pi_half_r), 0) ThenBlock: {
            x_abs = Float_Sub(pi_r, x_abs)
        }

        IfCondition EqualTo(CAD_Num.IsZero(x_abs, 0x3E7AD7F29ABCAF48), 1) ThenBlock: {
            ReturnValue(0x0000000000000000)
        }
        diff_pi2 = Float_Sub(x_abs, pi_half_r)
        IfCondition EqualTo(CAD_Num.IsZero(diff_pi2, 0x3E7AD7F29ABCAF48), 1) ThenBlock: {
            ReturnValue(sign_sin)
        }

        x2 = CAD_Num.Sq(x_abs)
        x3 = Float_Mul(x2, x_abs)
        x5 = Float_Mul(x3, x2)
        x7 = Float_Mul(x5, x2)
        x9 = Float_Mul(x7, x2)
        x11 = Float_Mul(x9, x2)

        t3 = Float_Div(x3, 0x4018000000000000)
        t5 = Float_Div(x5, 0x405E000000000000)
        t7 = Float_Div(x7, 0x40B3B00000000000)
        t9 = Float_Div(x9, 0x4116260000000000)
        t11 = Float_Div(x11, 0x4181A80000000000)

        res = Float_Sub(x_abs, t3)
        res = Float_Add(res, t5)
        res = Float_Sub(res, t7)
        res = Float_Add(res, t9)
        res = Float_Sub(res, t11)
        res = Float_Mul(res, sign_sin)
        ReturnValue(res)
    }
}

// arctan(x) for all real x.
// Taylor is slow near |x|=1 (~0.04 err with 6 terms) → range-reduce:
//   x>1:  atan(x)=π/2 - atan(1/x)
//   x≈1:  atan(x)=π/4 + atan((x-1)/(x+1))  so series arg is near 0
// Sign via CAD_Num.IsNeg (not hex 0x8000… immediates).
Function.CAD_Geom.Atan {
    Input: x_r: Integer
    Output: Integer
    Body: {
        zero = 0
        one = 0x3FF0000000000000
        pi_half = 0x3FF921FB54442D18
        pi_quart = 0x3FE921FB54442D18
        sign = 0
        ax = x_r
        IfCondition EqualTo(CAD_Num.IsNeg(x_r), 1) ThenBlock: {
            sign = 1
            ax = CAD_Num.Abs(x_r)
        }
        IfCondition EqualTo(CAD_Num.IsZero(ax, 0), 1) ThenBlock: { ReturnValue(zero) }
        // |x| > 1 → π/2 - atan(1/x)
        flip = 0
        IfCondition EqualTo(Float_Le(ax, one), 0) ThenBlock: {
            flip = 1
            ax = Float_Div(one, ax)
        }
        // |x| > 0.5 → π/4 + atan((x-1)/(x+1)) so |u| ≤ ~1/3
        use_q = 0
        half = 0x3FE0000000000000
        IfCondition EqualTo(Float_Le(ax, half), 0) ThenBlock: {
            use_q = 1
            ax = Float_Div(Float_Sub(ax, one), Float_Add(ax, one))
            // may be negative; series needs signed ax here
        }
        // atan(u) = u - u^3/3 + … + u^15/15 (more terms; |u| small after reduce)
        x2 = Float_Mul(ax, ax)
        x3 = Float_Mul(x2, ax)
        x5 = Float_Mul(x3, x2)
        x7 = Float_Mul(x5, x2)
        x9 = Float_Mul(x7, x2)
        x11 = Float_Mul(x9, x2)
        x13 = Float_Mul(x11, x2)
        x15 = Float_Mul(x13, x2)
        res = ax
        res = Float_Sub(res, Float_Div(x3, 0x4008000000000000))
        res = Float_Add(res, Float_Div(x5, 0x4014000000000000))
        res = Float_Sub(res, Float_Div(x7, 0x401C000000000000))
        res = Float_Add(res, Float_Div(x9, 0x4022000000000000))
        res = Float_Sub(res, Float_Div(x11, 0x4026000000000000))
        res = Float_Add(res, Float_Div(x13, 0x402A000000000000))
        res = Float_Sub(res, Float_Div(x15, 0x402E000000000000))
        IfCondition EqualTo(use_q, 1) ThenBlock: {
            res = Float_Add(pi_quart, res)
        }
        IfCondition EqualTo(flip, 1) ThenBlock: {
            res = Float_Sub(pi_half, res)
        }
        IfCondition EqualTo(sign, 1) ThenBlock: {
            res = Float_Sub(zero, res)
        }
        ReturnValue(res)
    }
}

// atan2(y,x) — angle of point (x,y) in (-π, π]
// CRITICAL: Float_Le(neg, 0) is broken in ailang.x — always use CAD_Num.IsNeg
// for sign tests. Wrong Q2/Q3 angles killed left-side line×arc joins (trim miss).
Function.CAD_Geom.Atan2 {
    Input: y_r: Integer
    Input: x_r: Integer
    Output: Integer
    Body: {
        zero = 0
        pi = 0x400921FB54442D18
        pi_half = 0x3FF921FB54442D18
        IfCondition EqualTo(CAD_Num.IsZero(x_r, 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(y_r, 0), 1) ThenBlock: { ReturnValue(zero) }
            IfCondition EqualTo(CAD_Num.IsNeg(y_r), 1) ThenBlock: {
                ReturnValue(Float_Sub(zero, pi_half))
            }
            ReturnValue(pi_half)
        }
        a = CAD_Geom.Atan(Float_Div(y_r, x_r))
        // x < 0 → adjust quadrant (IsNeg — NOT Float_Le)
        IfCondition EqualTo(CAD_Num.IsNeg(x_r), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(y_r), 1) ThenBlock: {
                // Q3: atan(y/x) > 0 → a - π
                ReturnValue(Float_Sub(a, pi))
            }
            // Q2 or negative-X axis: a + π
            ReturnValue(Float_Add(a, pi))
        }
        ReturnValue(a)
    }
}

// -------------------------------------------------------------------------
// Analytic curve evaluation
// -------------------------------------------------------------------------

// Line: P(t) = P0 + t * Dir
Function.CAD_Geom.EvalLine {
    Input: p0_addr: Address
    Input: dir_addr: Address
    Input: t_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        x0_r = ArrayGet(p0_addr, 0)
        y0_r = ArrayGet(p0_addr, 1)
        z0_r = ArrayGet(p0_addr, 2)
        dx_r = ArrayGet(dir_addr, 0)
        dy_r = ArrayGet(dir_addr, 1)
        dz_r = ArrayGet(dir_addr, 2)

        ArraySet(out_p_addr, 0, Float_Add(x0_r, Float_Mul(t_r, dx_r)))
        ArraySet(out_p_addr, 1, Float_Add(y0_r, Float_Mul(t_r, dy_r)))
        ArraySet(out_p_addr, 2, Float_Add(z0_r, Float_Mul(t_r, dz_r)))
        CAD_Geom_State.curve_count = Add(CAD_Geom_State.curve_count, 1)
        ReturnValue(0)
    }
}

// dP/dt = Dir
Function.CAD_Geom.DerivLine {
    Input: dir_addr: Address
    Input: out_d_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_d_addr, 0, ArrayGet(dir_addr, 0))
        ArraySet(out_d_addr, 1, ArrayGet(dir_addr, 1))
        ArraySet(out_d_addr, 2, ArrayGet(dir_addr, 2))
        ReturnValue(0)
    }
}

// Circle: P(u) = C + R*cos(u)*X + R*sin(u)*Y
// frame_addr: [0..2]=C [3..5]=X [6..8]=Y  (same layout as EvalCylinder)
// ≤5 Inputs for SysV ABI
Function.CAD_Geom.EvalCircle {
    Input: frame_addr: Address
    Input: radius_r: Integer
    Input: u_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        cos_u_r = CAD_Geom.Cos(u_r)
        sin_u_r = CAD_Geom.Sin(u_r)
        rcos_r = Float_Mul(radius_r, cos_u_r)
        rsin_r = Float_Mul(radius_r, sin_u_r)

        cx_r = ArrayGet(frame_addr, 0)
        cy_r = ArrayGet(frame_addr, 1)
        cz_r = ArrayGet(frame_addr, 2)
        xx_r = ArrayGet(frame_addr, 3)
        xy_r = ArrayGet(frame_addr, 4)
        xz_r = ArrayGet(frame_addr, 5)
        yx_r = ArrayGet(frame_addr, 6)
        yy_r = ArrayGet(frame_addr, 7)
        yz_r = ArrayGet(frame_addr, 8)

        px_r = Float_Add(cx_r, Float_Mul(rcos_r, xx_r))
        px_r = Float_Add(px_r, Float_Mul(rsin_r, yx_r))
        py_r = Float_Add(cy_r, Float_Mul(rcos_r, xy_r))
        py_r = Float_Add(py_r, Float_Mul(rsin_r, yy_r))
        pz_r = Float_Add(cz_r, Float_Mul(rcos_r, xz_r))
        pz_r = Float_Add(pz_r, Float_Mul(rsin_r, yz_r))

        ArraySet(out_p_addr, 0, px_r)
        ArraySet(out_p_addr, 1, py_r)
        ArraySet(out_p_addr, 2, pz_r)
        CAD_Geom_State.curve_count = Add(CAD_Geom_State.curve_count, 1)
        ReturnValue(0)
    }
}

// dP/du = -R*sin(u)*X + R*cos(u)*Y
Function.CAD_Geom.DerivCircle {
    Input: xaxis_addr: Address
    Input: yaxis_addr: Address
    Input: radius_r: Integer
    Input: u_r: Integer
    Input: out_d_addr: Address
    Output: Integer
    Body: {
        cos_u_r = CAD_Geom.Cos(u_r)
        sin_u_r = CAD_Geom.Sin(u_r)
        rcos_r = Float_Mul(radius_r, cos_u_r)
        rsin_r = Float_Mul(radius_r, sin_u_r)
        // -R sin
        neg_rsin = Float_Sub(0x0000000000000000, rsin_r)

        dx = Float_Add(Float_Mul(neg_rsin, ArrayGet(xaxis_addr, 0)), Float_Mul(rcos_r, ArrayGet(yaxis_addr, 0)))
        dy = Float_Add(Float_Mul(neg_rsin, ArrayGet(xaxis_addr, 1)), Float_Mul(rcos_r, ArrayGet(yaxis_addr, 1)))
        dz = Float_Add(Float_Mul(neg_rsin, ArrayGet(xaxis_addr, 2)), Float_Mul(rcos_r, ArrayGet(yaxis_addr, 2)))
        ArraySet(out_d_addr, 0, dx)
        ArraySet(out_d_addr, 1, dy)
        ArraySet(out_d_addr, 2, dz)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Surfaces — frame: [0..2] origin, [3..5] X, [6..8] Y, [9..11] Z
// -------------------------------------------------------------------------

Function.CAD_Geom.EvalPlane {
    Input: frame_addr: Address
    Input: u_r: Integer
    Input: v_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        ox = ArrayGet(frame_addr, 0)
        oy = ArrayGet(frame_addr, 1)
        oz = ArrayGet(frame_addr, 2)
        xx = ArrayGet(frame_addr, 3)
        xy = ArrayGet(frame_addr, 4)
        xz = ArrayGet(frame_addr, 5)
        yx = ArrayGet(frame_addr, 6)
        yy = ArrayGet(frame_addr, 7)
        yz = ArrayGet(frame_addr, 8)

        ArraySet(out_p_addr, 0, Float_Add(ox, Float_Add(Float_Mul(u_r, xx), Float_Mul(v_r, yx))))
        ArraySet(out_p_addr, 1, Float_Add(oy, Float_Add(Float_Mul(u_r, xy), Float_Mul(v_r, yy))))
        ArraySet(out_p_addr, 2, Float_Add(oz, Float_Add(Float_Mul(u_r, xz), Float_Mul(v_r, yz))))
        CAD_Geom_State.surf_count = Add(CAD_Geom_State.surf_count, 1)
        ReturnValue(0)
    }
}

// Cylinder: P(u,v) = Base + R cos u X + R sin u Y + v Z
Function.CAD_Geom.EvalCylinder {
    Input: frame_addr: Address
    Input: radius_r: Integer
    Input: u_r: Integer
    Input: v_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        cos_u_r = CAD_Geom.Cos(u_r)
        sin_u_r = CAD_Geom.Sin(u_r)
        rcos_r = Float_Mul(radius_r, cos_u_r)
        rsin_r = Float_Mul(radius_r, sin_u_r)

        bx = ArrayGet(frame_addr, 0)
        by = ArrayGet(frame_addr, 1)
        bz = ArrayGet(frame_addr, 2)
        xx = ArrayGet(frame_addr, 3)
        xy = ArrayGet(frame_addr, 4)
        xz = ArrayGet(frame_addr, 5)
        yx = ArrayGet(frame_addr, 6)
        yy = ArrayGet(frame_addr, 7)
        yz = ArrayGet(frame_addr, 8)
        zx = ArrayGet(frame_addr, 9)
        zy = ArrayGet(frame_addr, 10)
        zz = ArrayGet(frame_addr, 11)

        px = Float_Add(bx, Float_Mul(rcos_r, xx))
        px = Float_Add(px, Float_Mul(rsin_r, yx))
        px = Float_Add(px, Float_Mul(v_r, zx))
        py = Float_Add(by, Float_Mul(rcos_r, xy))
        py = Float_Add(py, Float_Mul(rsin_r, yy))
        py = Float_Add(py, Float_Mul(v_r, zy))
        pz = Float_Add(bz, Float_Mul(rcos_r, xz))
        pz = Float_Add(pz, Float_Mul(rsin_r, yz))
        pz = Float_Add(pz, Float_Mul(v_r, zz))

        ArraySet(out_p_addr, 0, px)
        ArraySet(out_p_addr, 1, py)
        ArraySet(out_p_addr, 2, pz)
        CAD_Geom_State.surf_count = Add(CAD_Geom_State.surf_count, 1)
        ReturnValue(0)
    }
}

// Sphere: P(u,v) = C + R cos(v) cos(u) X + R cos(v) sin(u) Y + R sin(v) Z
Function.CAD_Geom.EvalSphere {
    Input: frame_addr: Address
    Input: radius_r: Integer
    Input: u_r: Integer
    Input: v_r: Integer
    Input: out_p_addr: Address
    Output: Integer
    Body: {
        cos_u_r = CAD_Geom.Cos(u_r)
        sin_u_r = CAD_Geom.Sin(u_r)
        cos_v_r = CAD_Geom.Cos(v_r)
        sin_v_r = CAD_Geom.Sin(v_r)

        rcv = Float_Mul(radius_r, cos_v_r)
        rcu = Float_Mul(rcv, cos_u_r)
        rsu = Float_Mul(rcv, sin_u_r)
        rsv = Float_Mul(radius_r, sin_v_r)

        cx = ArrayGet(frame_addr, 0)
        cy = ArrayGet(frame_addr, 1)
        cz = ArrayGet(frame_addr, 2)
        xx = ArrayGet(frame_addr, 3)
        xy = ArrayGet(frame_addr, 4)
        xz = ArrayGet(frame_addr, 5)
        yx = ArrayGet(frame_addr, 6)
        yy = ArrayGet(frame_addr, 7)
        yz = ArrayGet(frame_addr, 8)
        zx = ArrayGet(frame_addr, 9)
        zy = ArrayGet(frame_addr, 10)
        zz = ArrayGet(frame_addr, 11)

        px = Float_Add(cx, Float_Mul(rcu, xx))
        px = Float_Add(px, Float_Mul(rsu, yx))
        px = Float_Add(px, Float_Mul(rsv, zx))
        py = Float_Add(cy, Float_Mul(rcu, xy))
        py = Float_Add(py, Float_Mul(rsu, yy))
        py = Float_Add(py, Float_Mul(rsv, zy))
        pz = Float_Add(cz, Float_Mul(rcu, xz))
        pz = Float_Add(pz, Float_Mul(rsu, yz))
        pz = Float_Add(pz, Float_Mul(rsv, zz))

        ArraySet(out_p_addr, 0, px)
        ArraySet(out_p_addr, 1, py)
        ArraySet(out_p_addr, 2, pz)
        CAD_Geom_State.surf_count = Add(CAD_Geom_State.surf_count, 1)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Projections (orthonormal axes assumed for plane)
// -------------------------------------------------------------------------

// Closest point on infinite line; writes Q and returns t via out_t_addr[0]
Function.CAD_Geom.ProjectPointLine {
    Input: p_addr: Address
    Input: p0_addr: Address
    Input: dir_addr: Address
    Input: out_q_addr: Address
    Input: out_t_addr: Address
    Output: Integer
    Body: {
        // w = P - P0
        wx = Float_Sub(ArrayGet(p_addr, 0), ArrayGet(p0_addr, 0))
        wy = Float_Sub(ArrayGet(p_addr, 1), ArrayGet(p0_addr, 1))
        wz = Float_Sub(ArrayGet(p_addr, 2), ArrayGet(p0_addr, 2))
        dx = ArrayGet(dir_addr, 0)
        dy = ArrayGet(dir_addr, 1)
        dz = ArrayGet(dir_addr, 2)
        // t = dot(w,d) / dot(d,d)
        num = Float_Add(Float_Mul(wx, dx), Float_Add(Float_Mul(wy, dy), Float_Mul(wz, dz)))
        den = Float_Add(Float_Mul(dx, dx), Float_Add(Float_Mul(dy, dy), Float_Mul(dz, dz)))
        IfCondition EqualTo(CAD_Num.IsZero(den, 0x3E7AD7F29ABCAF48), 1) ThenBlock: {
            ReturnValue(-6)
        }
        t_r = Float_Div(num, den)
        ArraySet(out_t_addr, 0, t_r)
        CAD_Geom.EvalLine(p0_addr, dir_addr, t_r, out_q_addr)
        ReturnValue(0)
    }
}

// Closest point on plane (orthonormal X,Y). out_uv: [u,v]
Function.CAD_Geom.ProjectPointPlane {
    Input: p_addr: Address
    Input: frame_addr: Address
    Input: out_q_addr: Address
    Input: out_uv_addr: Address
    Output: Integer
    Body: {
        ox = ArrayGet(frame_addr, 0)
        oy = ArrayGet(frame_addr, 1)
        oz = ArrayGet(frame_addr, 2)
        xx = ArrayGet(frame_addr, 3)
        xy = ArrayGet(frame_addr, 4)
        xz = ArrayGet(frame_addr, 5)
        yx = ArrayGet(frame_addr, 6)
        yy = ArrayGet(frame_addr, 7)
        yz = ArrayGet(frame_addr, 8)

        wx = Float_Sub(ArrayGet(p_addr, 0), ox)
        wy = Float_Sub(ArrayGet(p_addr, 1), oy)
        wz = Float_Sub(ArrayGet(p_addr, 2), oz)

        u_r = Float_Add(Float_Mul(wx, xx), Float_Add(Float_Mul(wy, xy), Float_Mul(wz, xz)))
        v_r = Float_Add(Float_Mul(wx, yx), Float_Add(Float_Mul(wy, yy), Float_Mul(wz, yz)))
        ArraySet(out_uv_addr, 0, u_r)
        ArraySet(out_uv_addr, 1, v_r)
        CAD_Geom.EvalPlane(frame_addr, u_r, v_r, out_q_addr)
        ReturnValue(0)
    }
}
