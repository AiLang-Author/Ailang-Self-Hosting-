// CAD Kernel — CAD.IO — STEP AP214 export
// SysV: ≤5 Inputs. Flat control flow.
// ExportSTEP: walk solid shell only (no kind/recipe pattern matchers).
// Solids must carry B-Rep topology (shell). Geom curves/surfaces on edges/faces.

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Cad.CAD_DXF
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Sketch
LibraryImport.StringUtils

FixedPool.CAD_IO_State {
    "import_count":  Initialize=0
    "export_count":  Initialize=0
    "bytes_written": Initialize=0
    "next_id":       Initialize=0
}

Function.CAD_IO.WriteStr {
    Input: fd: Integer
    Input: str: Address
    Output: Integer
    Body: {
        len = StringLength(str)
        CAD_Sys.Write(fd, str, len)
        ReturnValue(0)
    }
}

// Double with 3 decimal places (cylinder chords / free measure)
Function.CAD_IO.WriteFloat {
    Input: fd: Integer
    Input: val_r: Integer
    Output: Integer
    Body: {
        signb = BitwiseAnd(val_r, 0x8000000000000000)
        IfCondition NotEqual(signb, 0) ThenBlock: {
            CAD_IO.WriteStr(fd, "-")
            val_r = BitwiseAnd(val_r, 0x7FFFFFFFFFFFFFFF)
        }
        iv = Float_ToInt(val_r)
        s = NumberToString(iv)
        CAD_IO.WriteStr(fd, s)
        CAD_IO.WriteStr(fd, ".")
        whole_r = Float_FromInt(iv)
        frac_r = Float_Sub(val_r, whole_r)
        scaled = Float_Mul(frac_r, 0x408F400000000000)
        scaled = Float_Add(scaled, 0x3FE0000000000000)
        milli = Float_ToInt(scaled)
        IfCondition GreaterThan(milli, 999) ThenBlock: { milli = 999 }
        IfCondition LessThan(milli, 0) ThenBlock: { milli = 0 }
        IfCondition LessThan(milli, 100) ThenBlock: { CAD_IO.WriteStr(fd, "0") }
        IfCondition LessThan(milli, 10) ThenBlock: { CAD_IO.WriteStr(fd, "0") }
        sm = NumberToString(milli)
        CAD_IO.WriteStr(fd, sm)
        ReturnValue(0)
    }
}

Function.CAD_IO.WriteId {
    Input: fd: Integer
    Input: id: Integer
    Output: Integer
    Body: {
        CAD_IO.WriteStr(fd, "#")
        s = NumberToString(id)
        CAD_IO.WriteStr(fd, s)
        ReturnValue(0)
    }
}

// CARTESIAN_POINT #id
Function.CAD_IO.WritePoint {
    Input: fd: Integer
    Input: id: Integer
    Input: xyz_addr: Address
    Output: Integer
    Body: {
        CAD_IO.WriteId(fd, id)
        CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, ArrayGet(xyz_addr, 0))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, ArrayGet(xyz_addr, 1))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, ArrayGet(xyz_addr, 2))
        CAD_IO.WriteStr(fd, "));\n")
        ReturnValue(0)
    }
}

// Vert extents (view/export helpers). Not geometry. Returns 0 ok, -1 fail.
Function.CAD_IO.SolidBounds {
    Input: solid_handle: Integer
    Input: min_addr: Address
    Input: max_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo.SolidBounds(solid_handle, min_addr, max_addr), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(-1)
    }
}
Function.CAD_IO.WritePolySolidSTEP {
    Input: fd: Integer
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(shell, 0) ThenBlock: { ReturnValue(-1) }

        // tables: vertex handles, edge handles, face handles (max 512)
        vh = Allocate(4096)
        eh = Allocate(8192)
        fh = Allocate(4096)
        nv = 0
        ne = 0
        nf = 0
        pt = Allocate(32)
        dvec = Allocate(32)

        // --- collect verts/edges/faces from all shells (compound solids) ---
        sh = shell
        sguard = 0
        WhileLoop NotEqual(sh, 0) {
            face = CAD_Store.Read(sh, 0)
            fguard = 0
            WhileLoop NotEqual(face, 0) {
                IfCondition LessThan(nf, 512) ThenBlock: {
                    ArraySet(fh, nf, face)
                    nf = Add(nf, 1)
                }
                loop_h = CAD_Store.Read(face, 1)
                lguard = 0
                WhileLoop NotEqual(loop_h, 0) {
                    head = CAD_Store.Read(loop_h, 0)
                    ce = head
                    cguard = 0
                    done = 0
                    WhileLoop EqualTo(done, 0) {
                        ov = CAD_Store.Read(ce, 5)
                        found = 0
                        i = 0
                        WhileLoop LessThan(i, nv) {
                            IfCondition EqualTo(ArrayGet(vh, i), ov) ThenBlock: { found = 1 }
                            i = Add(i, 1)
                        }
                        IfCondition EqualTo(found, 0) ThenBlock: {
                            IfCondition LessThan(nv, 512) ThenBlock: {
                                ArraySet(vh, nv, ov)
                                nv = Add(nv, 1)
                            }
                        }
                        ed = CAD_Store.Read(ce, 0)
                        found = 0
                        i = 0
                        WhileLoop LessThan(i, ne) {
                            IfCondition EqualTo(ArrayGet(eh, i), ed) ThenBlock: { found = 1 }
                            i = Add(i, 1)
                        }
                        IfCondition EqualTo(found, 0) ThenBlock: {
                            IfCondition LessThan(ne, 1024) ThenBlock: {
                                ArraySet(eh, ne, ed)
                                ne = Add(ne, 1)
                            }
                        }
                        ce = CAD_Store.Read(ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(ce, head) ThenBlock: { done = 1 }
                        IfCondition GreaterThan(cguard, 256) ThenBlock: { done = 1 }
                    }
                    loop_h = CAD_Store.Read(loop_h, 2)
                    lguard = Add(lguard, 1)
                    IfCondition GreaterThan(lguard, 16) ThenBlock: { loop_h = 0 }
                }
                face = CAD_Store.Read(face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { face = 0 }
            }
            sh = CAD_Store.Read(sh, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { sh = 0 }
        }

        // Exact cyl: 2 seam verts; exact sphere: 1 equator seam vert — allow nv>=1
        IfCondition LessThan(nv, 1) ThenBlock: {
            Deallocate(vh, 4096)
            Deallocate(eh, 8192)
            Deallocate(fh, 4096)
            Deallocate(pt, 32)
            Deallocate(dvec, 32)
            ReturnValue(-1)
        }
        IfCondition LessThan(nf, 1) ThenBlock: {
            Deallocate(vh, 4096)
            Deallocate(eh, 8192)
            Deallocate(fh, 4096)
            Deallocate(pt, 32)
            Deallocate(dvec, 32)
            ReturnValue(-1)
        }

        // --- HEADER ---
        CAD_IO.WriteStr(fd, "ISO-10303-21;\n")
        CAD_IO.WriteStr(fd, "HEADER;\n")
        CAD_IO.WriteStr(fd, "FILE_DESCRIPTION(('AILang CAD Solid'),'2;1');\n")
        CAD_IO.WriteStr(fd, "FILE_NAME('ailang_solid.stp','2026-08-05T00:00:00',('AILang'),('2 Paws Machine'),'AILang CAD Engine','AILang CAD Engine','');\n")
        CAD_IO.WriteStr(fd, "FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\n")
        CAD_IO.WriteStr(fd, "DATA;\n")
        CAD_IO.WriteStr(fd, "#100 = APPLICATION_CONTEXT('automotive design');\n")
        CAD_IO.WriteStr(fd, "#101 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#100);\n")
        CAD_IO.WriteStr(fd, "#102 = PRODUCT('ailang_solid','ailang_solid','',(#103));\n")
        CAD_IO.WriteStr(fd, "#103 = PRODUCT_CONTEXT('',#100,'mechanical');\n")
        CAD_IO.WriteStr(fd, "#104 = PRODUCT_DEFINITION_FORMATION('','',#102);\n")
        CAD_IO.WriteStr(fd, "#105 = PRODUCT_DEFINITION('design','',#104,#106);\n")
        CAD_IO.WriteStr(fd, "#106 = PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');\n")
        CAD_IO.WriteStr(fd, "#107 = PRODUCT_DEFINITION_SHAPE('','',#105);\n")
        CAD_IO.WriteStr(fd, "#108 = SHAPE_DEFINITION_REPRESENTATION(#107,#109);\n")
        CAD_IO.WriteStr(fd, "#109 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#110),#111);\n")
        CAD_IO.WriteStr(fd, "#110 = MANIFOLD_SOLID_BREP('Solid',#120);\n")
        CAD_IO.WriteStr(fd, "#111 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#112)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#113,#114,#115)) REPRESENTATION_CONTEXT('Context3D','3D Context') );\n")
        CAD_IO.WriteStr(fd, "#112 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#113,'distance_accuracy_value','confusion accuracy');\n")
        CAD_IO.WriteStr(fd, "#113 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );\n")
        CAD_IO.WriteStr(fd, "#114 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT(*,.RADIAN.) );\n")
        CAD_IO.WriteStr(fd, "#115 = ( NAMED_UNIT(*) SI_UNIT(*,.STERADIAN.) SOLID_ANGLE_UNIT() );\n")

        // Geometry IDs start at 10000+ so they never collide with product #100–#120
        // (cylinder has 180+ points — old scheme #1..#nv overwrote product graph).
        // point 10001+i  vp 20001+i  dirE 30001+e  vec 31001+e  line 32001+e
        // ec 33001+e  oe 40000+  loop 50001+f  fob 51001+f  zdir 52001+f
        // xdir 53001+f  axis 54001+f  plane 55001+f  face 56001+f  shell #120

        // --- CARTESIAN_POINT + VERTEX_POINT ---
        i = 0
        WhileLoop LessThan(i, nv) {
            hv = ArrayGet(vh, i)
            ArraySet(pt, 0, CAD_Store.Read(hv, 0))
            ArraySet(pt, 1, CAD_Store.Read(hv, 1))
            ArraySet(pt, 2, CAD_Store.Read(hv, 2))
            pid = Add(10001, i)
            CAD_IO.WritePoint(fd, pid, pt)
            CAD_IO.WriteId(fd, Add(20001, i))
            CAD_IO.WriteStr(fd, " = VERTEX_POINT('',#")
            s = NumberToString(pid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            i = Add(i, 1)
        }

        // --- edges ---
        i = 0
        WhileLoop LessThan(i, ne) {
            ed = ArrayGet(eh, i)
            v0h = CAD_Store.Read(ed, 0)
            v1h = CAD_Store.Read(ed, 1)
            // 0-based index into vh
            i0 = 0
            i1 = 0
            j = 0
            WhileLoop LessThan(j, nv) {
                IfCondition EqualTo(ArrayGet(vh, j), v0h) ThenBlock: { i0 = j }
                IfCondition EqualTo(ArrayGet(vh, j), v1h) ThenBlock: { i1 = j }
                j = Add(j, 1)
            }
            p0 = Add(10001, i0)
            p1 = Add(10001, i1)
            vp0 = Add(20001, i0)
            vp1 = Add(20001, i1)
            curv = CAD_Store.Read(ed, 2)
            ckind = 0
            IfCondition NotEqual(curv, 0) ThenBlock: {
                ckind = CAD_Store.Read(curv, 0)
            }
            did = Add(30001, i)
            vid = Add(31001, i)
            lid = Add(32001, i)
            ecid = Add(33001, i)
            // CIRCLE kind=2 / ELLIPSE kind=3 (OCC digon corners): not LINE
            is_conic = 0
            IfCondition EqualTo(ckind, 2) ThenBlock: { is_conic = 1 }
            IfCondition EqualTo(ckind, 3) ThenBlock: { is_conic = 1 }
            IfCondition EqualTo(is_conic, 1) ThenBlock: {
                // circle/ellipse: center 1..3, X 4..6, Y 7..9, R or Rmaj at 10
                ArraySet(pt, 0, CAD_Store.Read(curv, 1))
                ArraySet(pt, 1, CAD_Store.Read(curv, 2))
                ArraySet(pt, 2, CAD_Store.Read(curv, 3))
                ArraySet(dvec, 0, CAD_Store.Read(curv, 4))
                ArraySet(dvec, 1, CAD_Store.Read(curv, 5))
                ArraySet(dvec, 2, CAD_Store.Read(curv, 6))
                CAD_Num.V3Normalize(dvec, dvec)
                yx = CAD_Store.Read(curv, 7)
                yy = CAD_Store.Read(curv, 8)
                yz = CAD_Store.Read(curv, 9)
                zx = Float_Sub(Float_Mul(ArrayGet(dvec, 1), yz), Float_Mul(ArrayGet(dvec, 2), yy))
                zy = Float_Sub(Float_Mul(ArrayGet(dvec, 2), yx), Float_Mul(ArrayGet(dvec, 0), yz))
                zz = Float_Sub(Float_Mul(ArrayGet(dvec, 0), yy), Float_Mul(ArrayGet(dvec, 1), yx))
                cid = Add(60001, i)
                CAD_IO.WriteId(fd, cid)
                CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
                CAD_IO.WriteFloat(fd, ArrayGet(pt, 0))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, ArrayGet(pt, 1))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, ArrayGet(pt, 2))
                CAD_IO.WriteStr(fd, "));\n")
                zidc = Add(61001, i)
                xidc = Add(62001, i)
                CAD_IO.WriteId(fd, zidc)
                CAD_IO.WriteStr(fd, " = DIRECTION('',(")
                CAD_IO.WriteFloat(fd, zx)
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, zy)
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, zz)
                CAD_IO.WriteStr(fd, "));\n")
                CAD_IO.WriteId(fd, xidc)
                CAD_IO.WriteStr(fd, " = DIRECTION('',(")
                CAD_IO.WriteFloat(fd, ArrayGet(dvec, 0))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, ArrayGet(dvec, 1))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, ArrayGet(dvec, 2))
                CAD_IO.WriteStr(fd, "));\n")
                aidc = Add(63001, i)
                CAD_IO.WriteId(fd, aidc)
                CAD_IO.WriteStr(fd, " = AXIS2_PLACEMENT_3D('',#")
                s = NumberToString(cid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#")
                s = NumberToString(zidc)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#")
                s = NumberToString(xidc)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ");\n")
                CAD_IO.WriteId(fd, lid)
                IfCondition EqualTo(ckind, 2) ThenBlock: {
                    CAD_IO.WriteStr(fd, " = CIRCLE('',#")
                    s = NumberToString(aidc)
                    CAD_IO.WriteStr(fd, s)
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, CAD_Store.Read(curv, 10))
                    CAD_IO.WriteStr(fd, ");\n")
                }
                IfCondition EqualTo(ckind, 3) ThenBlock: {
                    CAD_IO.WriteStr(fd, " = ELLIPSE('',#")
                    s = NumberToString(aidc)
                    CAD_IO.WriteStr(fd, s)
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, CAD_Store.Read(curv, 10))
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, CAD_Store.Read(curv, 11))
                    CAD_IO.WriteStr(fd, ");\n")
                }
            }
            IfCondition EqualTo(is_conic, 0) ThenBlock: {
                dx = Float_Sub(CAD_Store.Read(v1h, 0), CAD_Store.Read(v0h, 0))
                dy = Float_Sub(CAD_Store.Read(v1h, 1), CAD_Store.Read(v0h, 1))
                dz = Float_Sub(CAD_Store.Read(v1h, 2), CAD_Store.Read(v0h, 2))
                ArraySet(dvec, 0, dx)
                ArraySet(dvec, 1, dy)
                ArraySet(dvec, 2, dz)
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Num.V3Length(dvec), 0), 1) ThenBlock: {
                    ArraySet(dvec, 0, 0x3FF0000000000000)
                    ArraySet(dvec, 1, 0)
                    ArraySet(dvec, 2, 0)
                }
                CAD_Num.V3Normalize(dvec, dvec)
                CAD_IO.WriteId(fd, did)
                CAD_IO.WriteStr(fd, " = DIRECTION('',(")
                CAD_IO.WriteFloat(fd, ArrayGet(dvec, 0))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, ArrayGet(dvec, 1))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, ArrayGet(dvec, 2))
                CAD_IO.WriteStr(fd, "));\n")
                CAD_IO.WriteId(fd, vid)
                CAD_IO.WriteStr(fd, " = VECTOR('',#")
                s = NumberToString(did)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",1.);\n")
                CAD_IO.WriteId(fd, lid)
                CAD_IO.WriteStr(fd, " = LINE('',#")
                s = NumberToString(p0)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#")
                s = NumberToString(vid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ");\n")
            }
            CAD_IO.WriteId(fd, ecid)
            CAD_IO.WriteStr(fd, " = EDGE_CURVE('',#")
            s = NumberToString(vp0)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(vp1)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(lid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            i = Add(i, 1)
        }

        // --- faces: all loops (outer + next_loop inners); surface from face geom if present ---
        oe_next = 40000
        i = 0
        WhileLoop LessThan(i, nf) {
            face = ArrayGet(fh, i)
            bounds = Allocate(256)
            nbounds = 0
            loop_h = CAD_Store.Read(face, 1)
            head0 = 0
            px0 = 0
            py0 = 0
            pz0 = 0
            px1 = 0
            py1 = 0
            pz1 = 0
            px2 = 0
            py2 = 0
            pz2 = 0
            lguard = 0
            WhileLoop NotEqual(loop_h, 0) {
                head = CAD_Store.Read(loop_h, 0)
                IfCondition EqualTo(lguard, 0) ThenBlock: { head0 = head }
                ring = Allocate(2048)
                nce = 0
                ce = head
                cguard = 0
                done = 0
                WhileLoop EqualTo(done, 0) {
                    ed = CAD_Store.Read(ce, 0)
                    sense = CAD_Store.Read(ce, 6)
                    eidx = 0
                    j = 0
                    WhileLoop LessThan(j, ne) {
                        IfCondition EqualTo(ArrayGet(eh, j), ed) ThenBlock: { eidx = j }
                        j = Add(j, 1)
                    }
                    oe = oe_next
                    oe_next = Add(oe_next, 1)
                    ArraySet(ring, nce, oe)
                    nce = Add(nce, 1)
                    CAD_IO.WriteId(fd, oe)
                    CAD_IO.WriteStr(fd, " = ORIENTED_EDGE('',*,*,#")
                    s = NumberToString(Add(33001, eidx))
                    CAD_IO.WriteStr(fd, s)
                    IfCondition EqualTo(sense, 0) ThenBlock: {
                        CAD_IO.WriteStr(fd, ",.F.);\n")
                    }
                    IfCondition NotEqual(sense, 0) ThenBlock: {
                        CAD_IO.WriteStr(fd, ",.T.);\n")
                    }
                    ov = CAD_Store.Read(ce, 5)
                    IfCondition EqualTo(lguard, 0) ThenBlock: {
                        IfCondition EqualTo(nce, 1) ThenBlock: {
                            px0 = CAD_Store.Read(ov, 0)
                            py0 = CAD_Store.Read(ov, 1)
                            pz0 = CAD_Store.Read(ov, 2)
                        }
                        IfCondition EqualTo(nce, 2) ThenBlock: {
                            px1 = CAD_Store.Read(ov, 0)
                            py1 = CAD_Store.Read(ov, 1)
                            pz1 = CAD_Store.Read(ov, 2)
                        }
                        IfCondition EqualTo(nce, 3) ThenBlock: {
                            px2 = CAD_Store.Read(ov, 0)
                            py2 = CAD_Store.Read(ov, 1)
                            pz2 = CAD_Store.Read(ov, 2)
                        }
                    }
                    ce = CAD_Store.Read(ce, 2)
                    cguard = Add(cguard, 1)
                    IfCondition EqualTo(ce, head) ThenBlock: { done = 1 }
                    IfCondition GreaterThan(cguard, 256) ThenBlock: { done = 1 }
                }
                loop_id = Add(50001, Add(Multiply(i, 16), lguard))
                CAD_IO.WriteId(fd, loop_id)
                CAD_IO.WriteStr(fd, " = EDGE_LOOP('',(")
                j = 0
                WhileLoop LessThan(j, nce) {
                    IfCondition GreaterThan(j, 0) ThenBlock: { CAD_IO.WriteStr(fd, ",") }
                    CAD_IO.WriteStr(fd, "#")
                    s = NumberToString(ArrayGet(ring, j))
                    CAD_IO.WriteStr(fd, s)
                    j = Add(j, 1)
                }
                CAD_IO.WriteStr(fd, "));\n")
                bid = Add(51001, Add(Multiply(i, 16), lguard))
                CAD_IO.WriteId(fd, bid)
                IfCondition EqualTo(lguard, 0) ThenBlock: {
                    CAD_IO.WriteStr(fd, " = FACE_OUTER_BOUND('',#")
                }
                IfCondition GreaterThan(lguard, 0) ThenBlock: {
                    CAD_IO.WriteStr(fd, " = FACE_BOUND('',#")
                }
                s = NumberToString(loop_id)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",.T.);\n")
                ArraySet(bounds, nbounds, bid)
                nbounds = Add(nbounds, 1)
                Deallocate(ring, 2048)
                loop_h = CAD_Store.Read(loop_h, 2)
                lguard = Add(lguard, 1)
                IfCondition GreaterThan(lguard, 16) ThenBlock: { loop_h = 0 }
            }

            // surface from face geom if present (PLANE=1, CYLINDER=2, SPHERE=3)
            surf = CAD_Store.Read(face, 0)
            skind = 0
            IfCondition NotEqual(surf, 0) ThenBlock: {
                skind = CAD_Store.Read(surf, 0)
            }
            zid = Add(52001, i)
            xid = Add(53001, i)
            aid = Add(54001, i)
            plid = Add(55001, i)
            IfCondition EqualTo(skind, 2) ThenBlock: {
                // CYLINDER surface: O 1-3, Z 10-12, R 13
                ArraySet(pt, 0, CAD_Store.Read(surf, 1))
                ArraySet(pt, 1, CAD_Store.Read(surf, 2))
                ArraySet(pt, 2, CAD_Store.Read(surf, 3))
                cid = Add(64001, i)
                CAD_IO.WriteId(fd, cid)
                CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
                CAD_IO.WriteFloat(fd, ArrayGet(pt, 0))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, ArrayGet(pt, 1))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, ArrayGet(pt, 2))
                CAD_IO.WriteStr(fd, "));\n")
                CAD_IO.WriteId(fd, zid)
                CAD_IO.WriteStr(fd, " = DIRECTION('',(")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 10))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 11))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 12))
                CAD_IO.WriteStr(fd, "));\n")
                CAD_IO.WriteId(fd, xid)
                CAD_IO.WriteStr(fd, " = DIRECTION('',(")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 4))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 5))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 6))
                CAD_IO.WriteStr(fd, "));\n")
                CAD_IO.WriteId(fd, aid)
                CAD_IO.WriteStr(fd, " = AXIS2_PLACEMENT_3D('',#")
                s = NumberToString(cid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#")
                s = NumberToString(zid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#")
                s = NumberToString(xid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ");\n")
                CAD_IO.WriteId(fd, plid)
                CAD_IO.WriteStr(fd, " = CYLINDRICAL_SURFACE('',#")
                s = NumberToString(aid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 13))
                CAD_IO.WriteStr(fd, ");\n")
            }
            IfCondition EqualTo(skind, 3) ThenBlock: {
                // SPHERE: center 1-3, R 4 — axis Z+X arbitrary but orthonormal
                cid = Add(64001, i)
                CAD_IO.WriteId(fd, cid)
                CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 1))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 2))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 3))
                CAD_IO.WriteStr(fd, "));\n")
                CAD_IO.WriteId(fd, zid)
                CAD_IO.WriteStr(fd, " = DIRECTION('',(0.,0.,1.));\n")
                CAD_IO.WriteId(fd, xid)
                CAD_IO.WriteStr(fd, " = DIRECTION('',(1.,0.,0.));\n")
                CAD_IO.WriteId(fd, aid)
                CAD_IO.WriteStr(fd, " = AXIS2_PLACEMENT_3D('',#")
                s = NumberToString(cid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#")
                s = NumberToString(zid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#")
                s = NumberToString(xid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ");\n")
                CAD_IO.WriteId(fd, plid)
                CAD_IO.WriteStr(fd, " = SPHERICAL_SURFACE('',#")
                s = NumberToString(aid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 4))
                CAD_IO.WriteStr(fd, ");\n")
            }
            IfCondition EqualTo(skind, 4) ThenBlock: {
                cid = Add(64001, i)
                CAD_IO.WriteId(fd, cid)
                CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 1))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 2))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 3))
                CAD_IO.WriteStr(fd, "));\n")
                CAD_IO.WriteId(fd, zid)
                CAD_IO.WriteStr(fd, " = DIRECTION('',(")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 10))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 11))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 12))
                CAD_IO.WriteStr(fd, "));\n")
                CAD_IO.WriteId(fd, xid)
                CAD_IO.WriteStr(fd, " = DIRECTION('',(")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 4))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 5))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 6))
                CAD_IO.WriteStr(fd, "));\n")
                CAD_IO.WriteId(fd, aid)
                CAD_IO.WriteStr(fd, " = AXIS2_PLACEMENT_3D('',#")
                s = NumberToString(cid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#")
                s = NumberToString(zid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#")
                s = NumberToString(xid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ");\n")
                CAD_IO.WriteId(fd, plid)
                CAD_IO.WriteStr(fd, " = TOROIDAL_SURFACE('',#")
                s = NumberToString(aid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 13))
                CAD_IO.WriteStr(fd, ",")
                CAD_IO.WriteFloat(fd, CAD_Store.Read(surf, 14))
                CAD_IO.WriteStr(fd, ");\n")
            }
            // PLANE path for planar faces only (not cyl/sphere/torus)
            is_plane_path = 0
            IfCondition EqualTo(skind, 1) ThenBlock: { is_plane_path = 1 }
            IfCondition EqualTo(skind, 0) ThenBlock: { is_plane_path = 1 }
            IfCondition EqualTo(is_plane_path, 1) ThenBlock: {
                // PLANE: from surface O/Z/X if kind=1, else estimate from 3 verts
                IfCondition EqualTo(skind, 1) ThenBlock: {
                    ArraySet(pt, 0, CAD_Store.Read(surf, 10))
                    ArraySet(pt, 1, CAD_Store.Read(surf, 11))
                    ArraySet(pt, 2, CAD_Store.Read(surf, 12))
                    ArraySet(dvec, 0, CAD_Store.Read(surf, 4))
                    ArraySet(dvec, 1, CAD_Store.Read(surf, 5))
                    ArraySet(dvec, 2, CAD_Store.Read(surf, 6))
                    ArraySet(pt, 0, CAD_Store.Read(surf, 1))
                    // rewrite: Z axis of plane at indices after O X Y - MakePlaneAxes stores O,X,Y,Z
                    // Plane stride: kind, Ox,Oy,Oz, Xx,Xy,Xz, Yx,Yy,Yz, Zx,Zy,Zz
                    ArraySet(dvec, 0, CAD_Store.Read(surf, 4))
                    ArraySet(dvec, 1, CAD_Store.Read(surf, 5))
                    ArraySet(dvec, 2, CAD_Store.Read(surf, 6))
                    nzx = CAD_Store.Read(surf, 10)
                    nzy = CAD_Store.Read(surf, 11)
                    nzz = CAD_Store.Read(surf, 12)
                    oxp = CAD_Store.Read(surf, 1)
                    oyp = CAD_Store.Read(surf, 2)
                    ozp = CAD_Store.Read(surf, 3)
                    cid = Add(64001, i)
                    CAD_IO.WriteId(fd, cid)
                    CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
                    CAD_IO.WriteFloat(fd, oxp)
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, oyp)
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, ozp)
                    CAD_IO.WriteStr(fd, "));\n")
                    CAD_IO.WriteId(fd, zid)
                    CAD_IO.WriteStr(fd, " = DIRECTION('',(")
                    CAD_IO.WriteFloat(fd, nzx)
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, nzy)
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, nzz)
                    CAD_IO.WriteStr(fd, "));\n")
                    CAD_IO.WriteId(fd, xid)
                    CAD_IO.WriteStr(fd, " = DIRECTION('',(")
                    CAD_IO.WriteFloat(fd, ArrayGet(dvec, 0))
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, ArrayGet(dvec, 1))
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, ArrayGet(dvec, 2))
                    CAD_IO.WriteStr(fd, "));\n")
                    p_origin = cid
                }
                IfCondition NotEqual(skind, 1) ThenBlock: {
                    ArraySet(dvec, 0, Float_Sub(px1, px0))
                    ArraySet(dvec, 1, Float_Sub(py1, py0))
                    ArraySet(dvec, 2, Float_Sub(pz1, pz0))
                    yx = Float_Sub(px2, px0)
                    yy = Float_Sub(py2, py0)
                    yz = Float_Sub(pz2, pz0)
                    zx = Float_Sub(Float_Mul(ArrayGet(dvec, 1), yz), Float_Mul(ArrayGet(dvec, 2), yy))
                    zy = Float_Sub(Float_Mul(ArrayGet(dvec, 2), yx), Float_Mul(ArrayGet(dvec, 0), yz))
                    zz = Float_Sub(Float_Mul(ArrayGet(dvec, 0), yy), Float_Mul(ArrayGet(dvec, 1), yx))
                    ArraySet(pt, 0, zx)
                    ArraySet(pt, 1, zy)
                    ArraySet(pt, 2, zz)
                    IfCondition EqualTo(CAD_Num.IsZero(CAD_Num.V3Length(pt), 0), 1) ThenBlock: {
                        ArraySet(pt, 0, 0)
                        ArraySet(pt, 1, 0)
                        ArraySet(pt, 2, 0x3FF0000000000000)
                    }
                    CAD_Num.V3Normalize(pt, pt)
                    CAD_Num.V3Normalize(dvec, dvec)
                    CAD_IO.WriteId(fd, zid)
                    CAD_IO.WriteStr(fd, " = DIRECTION('',(")
                    CAD_IO.WriteFloat(fd, ArrayGet(pt, 0))
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, ArrayGet(pt, 1))
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, ArrayGet(pt, 2))
                    CAD_IO.WriteStr(fd, "));\n")
                    CAD_IO.WriteId(fd, xid)
                    CAD_IO.WriteStr(fd, " = DIRECTION('',(")
                    CAD_IO.WriteFloat(fd, ArrayGet(dvec, 0))
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, ArrayGet(dvec, 1))
                    CAD_IO.WriteStr(fd, ",")
                    CAD_IO.WriteFloat(fd, ArrayGet(dvec, 2))
                    CAD_IO.WriteStr(fd, "));\n")
                    ov0 = CAD_Store.Read(head0, 5)
                    i_origin = 0
                    j = 0
                    WhileLoop LessThan(j, nv) {
                        IfCondition EqualTo(ArrayGet(vh, j), ov0) ThenBlock: { i_origin = j }
                        j = Add(j, 1)
                    }
                    p_origin = Add(10001, i_origin)
                }
                IfCondition EqualTo(skind, 1) ThenBlock: {
                    // zid/xid already written above for plane from surf
                    // need zid written - I wrote them in skind==1 block
                }
                IfCondition NotEqual(skind, 1) ThenBlock: {
                    // already wrote zid xid
                }
                // if skind==1 wrote zid xid; if not wrote in estimate - good
                // For skind==1 p_origin is cid; for else p_origin is vertex
                CAD_IO.WriteId(fd, aid)
                CAD_IO.WriteStr(fd, " = AXIS2_PLACEMENT_3D('',#")
                s = NumberToString(p_origin)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#")
                s = NumberToString(zid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#")
                s = NumberToString(xid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ");\n")
                CAD_IO.WriteId(fd, plid)
                CAD_IO.WriteStr(fd, " = PLANE('',#")
                s = NumberToString(aid)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ");\n")
            }
            afid = Add(56001, i)
            CAD_IO.WriteId(fd, afid)
            CAD_IO.WriteStr(fd, " = ADVANCED_FACE('',(")
            j = 0
            WhileLoop LessThan(j, nbounds) {
                IfCondition GreaterThan(j, 0) ThenBlock: { CAD_IO.WriteStr(fd, ",") }
                CAD_IO.WriteStr(fd, "#")
                s = NumberToString(ArrayGet(bounds, j))
                CAD_IO.WriteStr(fd, s)
                j = Add(j, 1)
            }
            CAD_IO.WriteStr(fd, "),#")
            s = NumberToString(plid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            Deallocate(bounds, 256)
            i = Add(i, 1)
        }

        // CLOSED_SHELL #120 (referenced by MANIFOLD #110)
        CAD_IO.WriteStr(fd, "#120 = CLOSED_SHELL('',(")
        i = 0
        WhileLoop LessThan(i, nf) {
            IfCondition GreaterThan(i, 0) ThenBlock: { CAD_IO.WriteStr(fd, ",") }
            CAD_IO.WriteStr(fd, "#")
            s = NumberToString(Add(56001, i))
            CAD_IO.WriteStr(fd, s)
            i = Add(i, 1)
        }
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\n")
        CAD_IO.WriteStr(fd, "END-ISO-10303-21;\n")

        Deallocate(vh, 4096)
        Deallocate(eh, 8192)
        Deallocate(fh, 4096)
        Deallocate(pt, 32)
        Deallocate(dvec, 32)
        ReturnValue(0)
    }
}

// Export STEP to an open fd (does not close fd). stdout = 1 for pipes.
// B-Rep walk only. Solid must have shell (solid[0]).
Function.CAD_IO.ExportSTEPFd {
    Input: solid_handle: Integer
    Input: fd: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-16)
        }
        IfCondition EqualTo(CAD_Store.Read(solid_handle, 0), 0) ThenBlock: {
            ReturnValue(-1)
        }
        rc = CAD_IO.WritePolySolidSTEP(fd, solid_handle)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            CAD_IO_State.export_count = Add(CAD_IO_State.export_count, 1)
        }
        ReturnValue(rc)
    }
}

// ExportSTEP: B-Rep walk only. No kind/recipe matchers.
// Solid must have a shell (solid[0]). Callers build topology in Topo/Bool.
Function.CAD_IO.ExportSTEP {
    Input: solid_handle: Integer
    Input: filename_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: {
            ReturnValue(-1)
        }
        // refuse empty shell — no param recipes, no AABB fake
        IfCondition EqualTo(CAD_Store.Read(solid_handle, 0), 0) ThenBlock: {
            ReturnValue(-1)
        }
        fd = SystemCall(2, filename_addr, 577, 438)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-16)
        }
        rc = CAD_IO.ExportSTEPFd(solid_handle, fd)
        SystemCall(3, fd, 0, 0)
        ReturnValue(rc)
    }
}

Function.CAD_IO.ImportDXF {
    Input: filename_addr: Address
    Input: out_sketch_handle_addr: Address
    Output: Integer
    Body: {
        // Delegate to real CAD_DXF parser (LINE → sketch loop)
        rc = CAD_DXF.ImportFile(filename_addr, out_sketch_handle_addr)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            CAD_IO_State.import_count = Add(CAD_IO_State.import_count, 1)
        }
        ReturnValue(rc)
    }
}

// Sketch → extrude solid. Shared by path and fd loaders.
Function.CAD_IO.ExtrudeSketchSolid {
    Input: sketch_handle: Integer
    Input: height_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(sketch_handle, 2)
        IfCondition LessThan(n, 3) ThenBlock: {
            n = CAD_Sketch.BuildClosedLoop(sketch_handle)
        }
        h = CAD_Feat.ExtrudeProfile(sketch_handle, height_r)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(out_solid_addr, 0) ThenBlock: {
            ArraySet(out_solid_addr, 0, h)
        }
        CAD_IO_State.import_count = Add(CAD_IO_State.import_count, 1)
        ReturnValue(h)
    }
}

// Path → solid: import DXF profile, extrude +Z by height_r (IEEE double mm).
// Writes solid handle to out_solid_addr. Returns solid handle or 0.
// Arbitrary path (no hardcoded fixtures). Closed LINE/CIRCLE profile required.
Function.CAD_IO.LoadDXFExtrude {
    Input: filename_addr: Address
    Input: height_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(filename_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        out_sk = Allocate(8)
        rc = CAD_DXF.ImportFile(filename_addr, out_sk)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(out_sk, 8)
            ReturnValue(0)
        }
        h_sk = ArrayGet(out_sk, 0)
        Deallocate(out_sk, 8)
        ReturnValue(CAD_IO.ExtrudeSketchSolid(h_sk, height_r, out_solid_addr))
    }
}

// fd → solid (stdin = 0). Full pipe: DXF bytes in → B-Rep solid out.
Function.CAD_IO.LoadDXFExtrudeFd {
    Input: fd: Integer
    Input: height_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        out_sk = Allocate(8)
        rc = CAD_DXF.ImportFd(fd, out_sk)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(out_sk, 8)
            ReturnValue(0)
        }
        h_sk = ArrayGet(out_sk, 0)
        Deallocate(out_sk, 8)
        ReturnValue(CAD_IO.ExtrudeSketchSolid(h_sk, height_r, out_solid_addr))
    }
}

// 1 if path is "-" (stdin/stdout convention).
Function.CAD_IO.IsDashPath {
    Input: path_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(path_addr, "-"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Path pair → plate with through poly hole (door-escutcheon style).
// outer_path = rectangular (or AABB) plate profile DXF;
// hole_path  = closed poly hole DXF (must lie inside plate).
// height_r = plate thickness (IEEE double). Returns solid or 0.
Function.CAD_IO.LoadDXFPlateHole {
    Input: outer_path: Address
    Input: hole_path: Address
    Input: height_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(outer_path, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(hole_path, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        out_pl = Allocate(8)
        out_kh = Allocate(8)
        rc = CAD_DXF.ImportFile(outer_path, out_pl)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(out_pl, 8)
            Deallocate(out_kh, 8)
            ReturnValue(0)
        }
        rc = CAD_DXF.ImportFile(hole_path, out_kh)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(out_pl, 8)
            Deallocate(out_kh, 8)
            ReturnValue(0)
        }
        h_pl = ArrayGet(out_pl, 0)
        h_kh = ArrayGet(out_kh, 0)
        Deallocate(out_pl, 8)
        Deallocate(out_kh, 8)
        h = CAD_Feat.ExtrudePlateThroughHole(h_pl, h_kh, height_r)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(out_solid_addr, 0) ThenBlock: {
            ArraySet(out_solid_addr, 0, h)
        }
        CAD_IO_State.import_count = Add(CAD_IO_State.import_count, 1)
        ReturnValue(h)
    }
}

// True if path ends with suffix (case-sensitive). For .dxf / .DXF call twice.
Function.CAD_IO.PathEndsWith {
    Input: path_addr: Address
    Input: suffix_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(suffix_addr, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(StringEndsWith(path_addr, suffix_addr))
    }
}

// 1 if path looks like DXF (.dxf / .DXF), else 0.
Function.CAD_IO.IsDXFPath {
    Input: path_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringEndsWith(path_addr, ".dxf"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringEndsWith(path_addr, ".DXF"), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Export sketch IR → ASCII DXF (LINE/CIRCLE/ARC).
Function.CAD_IO.ExportDXF {
    Input: sketch_handle: Integer
    Input: filename_addr: Address
    Output: Integer
    Body: {
        ReturnValue(CAD_DXF.ExportSketch(sketch_handle, filename_addr))
    }
}

Function.CAD_IO.ImportSTEP {
    Input: filename_addr: Address
    Input: out_solid_handle_addr: Address
    Output: Integer
    Body: {
        // Honest stub: STEP import not implemented (export only).
        // Refuse to invent an empty solid from a path.
        ArraySet(out_solid_handle_addr, 0, 0)
        ReturnValue(-17)
    }
}
