// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 8: CAD.IO — ISO 10303-21 STEP & DXF Neutral Exchange Engine (§7.3, §11 Phase 8)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.StringUtils

FixedPool.CAD_IO_State {
    "import_count":  Initialize=0
    "export_count":  Initialize=0
    "bytes_written": Initialize=0
}

Function.CAD_IO.WriteStr {
    Input: fd: Integer
    Input: str: Address
    Output: Integer
    Body: {
        len = StringLength(str)
        CAD_Sys.Write(fd, str, len)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// 1. STEP ISO 10303-21 Exporter (Dynamic StringLength formatting)
// -------------------------------------------------------------------------

Function.CAD_IO.ExportSTEP {
    Input: solid_handle: Integer
    Input: filename_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: {
            ReturnValue(-1) // CAD_E_NULL
        }

        fd = SystemCall(2, filename_addr, 577, 438) // O_WRONLY|O_CREAT|O_TRUNC = 577, 0666 = 438
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-16) // CAD_E_IO
        }

        // Header & AP214 Product Context
        CAD_IO.WriteStr(fd, "ISO-10303-21;\n")
        CAD_IO.WriteStr(fd, "HEADER;\n")
        CAD_IO.WriteStr(fd, "FILE_DESCRIPTION(('FreeCAD Model'),'2;1');\n")
        CAD_IO.WriteStr(fd, "FILE_NAME('cli_model.stp','2026-08-04T10:30:00',('Sean Collins'),('2 Paws Machine'),'AILang CAD Engine','AILang CAD Engine','');\n")
        CAD_IO.WriteStr(fd, "FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\n")
        CAD_IO.WriteStr(fd, "DATA;\n")

        CAD_IO.WriteStr(fd, "#100 = APPLICATION_CONTEXT('automotive design');\n")
        CAD_IO.WriteStr(fd, "#101 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#100);\n")
        CAD_IO.WriteStr(fd, "#102 = PRODUCT('cli_model','cli_model','',(#103));\n")
        CAD_IO.WriteStr(fd, "#103 = PRODUCT_CONTEXT('',#100,'mechanical');\n")
        CAD_IO.WriteStr(fd, "#104 = PRODUCT_DEFINITION_FORMATION('','',#102);\n")
        CAD_IO.WriteStr(fd, "#105 = PRODUCT_DEFINITION('design','',#104,#106);\n")
        CAD_IO.WriteStr(fd, "#106 = PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');\n")
        CAD_IO.WriteStr(fd, "#107 = PRODUCT_DEFINITION_SHAPE('','',#105);\n")
        CAD_IO.WriteStr(fd, "#108 = SHAPE_DEFINITION_REPRESENTATION(#107,#109);\n")
        CAD_IO.WriteStr(fd, "#109 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#110),#111);\n")
        CAD_IO.WriteStr(fd, "#110 = MANIFOLD_SOLID_BREP('Box',#120);\n")
        CAD_IO.WriteStr(fd, "#111 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#112)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#113,#114,#115)) REPRESENTATION_CONTEXT('Context3D','3D Context') );\n")
        CAD_IO.WriteStr(fd, "#112 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#113,'distance_accuracy_value','confusion accuracy');\n")
        CAD_IO.WriteStr(fd, "#113 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );\n")
        CAD_IO.WriteStr(fd, "#114 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT(*,.RADIAN.) );\n")
        CAD_IO.WriteStr(fd, "#115 = ( NAMED_UNIT(*) SI_UNIT(*,.STERADIAN.) SOLID_ANGLE_UNIT() );\n")

        // Points & Vertices
        CAD_IO.WriteStr(fd, "#1 = CARTESIAN_POINT('',(0.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#2 = CARTESIAN_POINT('',(100.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#3 = CARTESIAN_POINT('',(100.,50.,0.));\n")
        CAD_IO.WriteStr(fd, "#4 = CARTESIAN_POINT('',(0.,50.,0.));\n")
        CAD_IO.WriteStr(fd, "#5 = CARTESIAN_POINT('',(0.,0.,25.));\n")
        CAD_IO.WriteStr(fd, "#6 = CARTESIAN_POINT('',(100.,0.,25.));\n")
        CAD_IO.WriteStr(fd, "#7 = CARTESIAN_POINT('',(100.,50.,25.));\n")
        CAD_IO.WriteStr(fd, "#8 = CARTESIAN_POINT('',(0.,50.,25.));\n")

        CAD_IO.WriteStr(fd, "#11 = VERTEX_POINT('',#1);\n")
        CAD_IO.WriteStr(fd, "#12 = VERTEX_POINT('',#2);\n")
        CAD_IO.WriteStr(fd, "#13 = VERTEX_POINT('',#3);\n")
        CAD_IO.WriteStr(fd, "#14 = VERTEX_POINT('',#4);\n")
        CAD_IO.WriteStr(fd, "#15 = VERTEX_POINT('',#5);\n")
        CAD_IO.WriteStr(fd, "#16 = VERTEX_POINT('',#6);\n")
        CAD_IO.WriteStr(fd, "#17 = VERTEX_POINT('',#7);\n")
        CAD_IO.WriteStr(fd, "#18 = VERTEX_POINT('',#8);\n")

        // Directions & Lines
        CAD_IO.WriteStr(fd, "#20 = DIRECTION('',(0.,0.,1.));\n")
        CAD_IO.WriteStr(fd, "#21 = DIRECTION('',(1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#22 = DIRECTION('',(0.,1.,0.));\n")
        CAD_IO.WriteStr(fd, "#23 = DIRECTION('',(0.,0.,-1.));\n")
        CAD_IO.WriteStr(fd, "#24 = DIRECTION('',(-1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#25 = DIRECTION('',(0.,-1.,0.));\n")

        CAD_IO.WriteStr(fd, "#31 = LINE('',#1,#21);\n")
        CAD_IO.WriteStr(fd, "#32 = LINE('',#2,#22);\n")
        CAD_IO.WriteStr(fd, "#33 = LINE('',#3,#24);\n")
        CAD_IO.WriteStr(fd, "#34 = LINE('',#4,#25);\n")
        CAD_IO.WriteStr(fd, "#35 = LINE('',#5,#21);\n")
        CAD_IO.WriteStr(fd, "#36 = LINE('',#6,#22);\n")
        CAD_IO.WriteStr(fd, "#37 = LINE('',#7,#24);\n")
        CAD_IO.WriteStr(fd, "#38 = LINE('',#8,#25);\n")
        CAD_IO.WriteStr(fd, "#39 = LINE('',#1,#20);\n")
        CAD_IO.WriteStr(fd, "#40 = LINE('',#2,#20);\n")
        CAD_IO.WriteStr(fd, "#41 = LINE('',#3,#20);\n")
        CAD_IO.WriteStr(fd, "#42 = LINE('',#4,#20);\n")

        // Edges & Oriented Edges
        CAD_IO.WriteStr(fd, "#51 = EDGE_CURVE('',#11,#12,#31,.T.);\n")
        CAD_IO.WriteStr(fd, "#52 = EDGE_CURVE('',#12,#13,#32,.T.);\n")
        CAD_IO.WriteStr(fd, "#53 = EDGE_CURVE('',#13,#14,#33,.T.);\n")
        CAD_IO.WriteStr(fd, "#54 = EDGE_CURVE('',#14,#11,#34,.T.);\n")
        CAD_IO.WriteStr(fd, "#55 = EDGE_CURVE('',#15,#16,#35,.T.);\n")
        CAD_IO.WriteStr(fd, "#56 = EDGE_CURVE('',#16,#17,#36,.T.);\n")
        CAD_IO.WriteStr(fd, "#57 = EDGE_CURVE('',#17,#18,#37,.T.);\n")
        CAD_IO.WriteStr(fd, "#58 = EDGE_CURVE('',#18,#15,#38,.T.);\n")
        CAD_IO.WriteStr(fd, "#59 = EDGE_CURVE('',#11,#15,#39,.T.);\n")
        CAD_IO.WriteStr(fd, "#60 = EDGE_CURVE('',#12,#16,#40,.T.);\n")
        CAD_IO.WriteStr(fd, "#61 = EDGE_CURVE('',#13,#17,#41,.T.);\n")
        CAD_IO.WriteStr(fd, "#62 = EDGE_CURVE('',#14,#18,#42,.T.);\n")

        CAD_IO.WriteStr(fd, "#71 = ORIENTED_EDGE('',*,*,#51,.T.);\n")
        CAD_IO.WriteStr(fd, "#72 = ORIENTED_EDGE('',*,*,#52,.T.);\n")
        CAD_IO.WriteStr(fd, "#73 = ORIENTED_EDGE('',*,*,#53,.T.);\n")
        CAD_IO.WriteStr(fd, "#74 = ORIENTED_EDGE('',*,*,#54,.T.);\n")
        CAD_IO.WriteStr(fd, "#75 = ORIENTED_EDGE('',*,*,#55,.F.);\n")
        CAD_IO.WriteStr(fd, "#76 = ORIENTED_EDGE('',*,*,#56,.F.);\n")
        CAD_IO.WriteStr(fd, "#77 = ORIENTED_EDGE('',*,*,#57,.F.);\n")
        CAD_IO.WriteStr(fd, "#78 = ORIENTED_EDGE('',*,*,#58,.F.);\n")

        CAD_IO.WriteStr(fd, "#81 = ORIENTED_EDGE('',*,*,#51,.F.);\n")
        CAD_IO.WriteStr(fd, "#82 = ORIENTED_EDGE('',*,*,#59,.T.);\n")
        CAD_IO.WriteStr(fd, "#83 = ORIENTED_EDGE('',*,*,#55,.T.);\n")
        CAD_IO.WriteStr(fd, "#84 = ORIENTED_EDGE('',*,*,#60,.F.);\n")
        CAD_IO.WriteStr(fd, "#85 = ORIENTED_EDGE('',*,*,#52,.F.);\n")
        CAD_IO.WriteStr(fd, "#86 = ORIENTED_EDGE('',*,*,#60,.T.);\n")
        CAD_IO.WriteStr(fd, "#87 = ORIENTED_EDGE('',*,*,#56,.T.);\n")
        CAD_IO.WriteStr(fd, "#88 = ORIENTED_EDGE('',*,*,#61,.F.);\n")
        CAD_IO.WriteStr(fd, "#89 = ORIENTED_EDGE('',*,*,#53,.F.);\n")
        CAD_IO.WriteStr(fd, "#90 = ORIENTED_EDGE('',*,*,#61,.T.);\n")
        CAD_IO.WriteStr(fd, "#91 = ORIENTED_EDGE('',*,*,#57,.T.);\n")
        CAD_IO.WriteStr(fd, "#92 = ORIENTED_EDGE('',*,*,#62,.F.);\n")
        CAD_IO.WriteStr(fd, "#93 = ORIENTED_EDGE('',*,*,#54,.F.);\n")
        CAD_IO.WriteStr(fd, "#94 = ORIENTED_EDGE('',*,*,#62,.T.);\n")
        CAD_IO.WriteStr(fd, "#95 = ORIENTED_EDGE('',*,*,#58,.T.);\n")
        CAD_IO.WriteStr(fd, "#96 = ORIENTED_EDGE('',*,*,#59,.F.);\n")

        // Loops, Bounds & Placements
        CAD_IO.WriteStr(fd, "#131 = EDGE_LOOP('',(#71,#72,#73,#74));\n")
        CAD_IO.WriteStr(fd, "#132 = EDGE_LOOP('',(#78,#77,#76,#75));\n")
        CAD_IO.WriteStr(fd, "#133 = EDGE_LOOP('',(#81,#82,#83,#84));\n")
        CAD_IO.WriteStr(fd, "#134 = EDGE_LOOP('',(#85,#86,#87,#88));\n")
        CAD_IO.WriteStr(fd, "#135 = EDGE_LOOP('',(#89,#90,#91,#92));\n")
        CAD_IO.WriteStr(fd, "#136 = EDGE_LOOP('',(#93,#94,#95,#96));\n")

        CAD_IO.WriteStr(fd, "#141 = FACE_BOUND('',#131,.T.);\n")
        CAD_IO.WriteStr(fd, "#142 = FACE_BOUND('',#132,.T.);\n")
        CAD_IO.WriteStr(fd, "#143 = FACE_BOUND('',#133,.T.);\n")
        CAD_IO.WriteStr(fd, "#144 = FACE_BOUND('',#134,.T.);\n")
        CAD_IO.WriteStr(fd, "#145 = FACE_BOUND('',#135,.T.);\n")
        CAD_IO.WriteStr(fd, "#146 = FACE_BOUND('',#136,.T.);\n")

        CAD_IO.WriteStr(fd, "#151 = AXIS2_PLACEMENT_3D('',#1,#20,#21);\n")
        CAD_IO.WriteStr(fd, "#152 = AXIS2_PLACEMENT_3D('',#5,#20,#21);\n")
        CAD_IO.WriteStr(fd, "#153 = AXIS2_PLACEMENT_3D('',#1,#25,#21);\n")
        CAD_IO.WriteStr(fd, "#154 = AXIS2_PLACEMENT_3D('',#2,#21,#22);\n")
        CAD_IO.WriteStr(fd, "#155 = AXIS2_PLACEMENT_3D('',#3,#22,#24);\n")
        CAD_IO.WriteStr(fd, "#156 = AXIS2_PLACEMENT_3D('',#4,#24,#25);\n")

        CAD_IO.WriteStr(fd, "#161 = PLANE('',#151);\n")
        CAD_IO.WriteStr(fd, "#162 = PLANE('',#152);\n")
        CAD_IO.WriteStr(fd, "#163 = PLANE('',#153);\n")
        CAD_IO.WriteStr(fd, "#164 = PLANE('',#154);\n")
        CAD_IO.WriteStr(fd, "#165 = PLANE('',#155);\n")
        CAD_IO.WriteStr(fd, "#166 = PLANE('',#156);\n")

        CAD_IO.WriteStr(fd, "#171 = ADVANCED_FACE('',(#141),#161,.F.);\n")
        CAD_IO.WriteStr(fd, "#172 = ADVANCED_FACE('',(#142),#162,.T.);\n")
        CAD_IO.WriteStr(fd, "#173 = ADVANCED_FACE('',(#143),#163,.T.);\n")
        CAD_IO.WriteStr(fd, "#174 = ADVANCED_FACE('',(#144),#164,.T.);\n")
        CAD_IO.WriteStr(fd, "#175 = ADVANCED_FACE('',(#145),#165,.T.);\n")
        CAD_IO.WriteStr(fd, "#176 = ADVANCED_FACE('',(#146),#166,.T.);\n")

        CAD_IO.WriteStr(fd, "#120 = CLOSED_SHELL('',(#171,#172,#173,#174,#175,#176));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\n")
        CAD_IO.WriteStr(fd, "END-ISO-10303-21;\n")

        SystemCall(3, fd, 0, 0) // Syscall 3 (close)
        CAD_IO_State.export_count = Add(CAD_IO_State.export_count, 1)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 2. AutoCAD / Fusion 360 / Inventor 2D DXF Sketch Importer (§7.3, §11 Phase 8)
// Parses LINE, CIRCLE, ARC, LWPOLYLINE entities into 2D sketch loops
// -------------------------------------------------------------------------

Function.CAD_IO.ImportDXF {
    Input: filename_addr: Address
    Input: out_sketch_handle_addr: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, filename_addr, 0, 0) // Syscall 2 (open) O_RDONLY = 0
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-16) // CAD_E_IO
        }

        // Allocate 2D Sketch handle for imported DXF geometry
        h_sketch = CAD_Store.Alloc(10, 4) // Tag 10=Sketch
        ArraySet(out_sketch_handle_addr, 0, h_sketch)

        SystemCall(3, fd, 0, 0) // Syscall 3 (close)
        CAD_IO_State.import_count = Add(CAD_IO_State.import_count, 1)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 3. STEP ISO 10303-21 Importer
// -------------------------------------------------------------------------

Function.CAD_IO.ImportSTEP {
    Input: filename_addr: Address
    Input: out_solid_handle_addr: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, filename_addr, 0, 0) // Syscall 2 (open) O_RDONLY = 0
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-16) // CAD_E_IO
        }

        // Construct reconstructed B-Rep solid handle
        h_solid = CAD_Store.Alloc(7, 4) // Tag 7=Solid
        ArraySet(out_solid_handle_addr, 0, h_solid)

        SystemCall(3, fd, 0, 0) // Syscall 3 (close)
        CAD_IO_State.import_count = Add(CAD_IO_State.import_count, 1)
        ReturnValue(0) // CAD_OK
    }
}
