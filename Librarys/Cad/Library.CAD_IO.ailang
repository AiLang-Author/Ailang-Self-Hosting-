// CAD Kernel — CAD.IO — STEP AP214 export
// SysV: ≤5 Inputs. Flat control flow.
// ExportSTEP: walk polyhedral B-Rep (box, n-gon cylinder, …) → MANIFOLD_SOLID_BREP.
// AABB box template only if walk fails.

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.StringUtils

FixedPool.CAD_IO_State {
    "import_count":  Initialize=0
    "export_count":  Initialize=0
    "bytes_written": Initialize=0
    "next_id":       Initialize=0
}

Function.CAD_IO.WriteStr {
    Input: fd: Integer
    Input: str: Address
    Output: Integer
    Body: {
        len = StringLength(str)
        CAD_Sys.Write(fd, str, len)
        ReturnValue(0)
    }
}

// Double with 3 decimal places (cylinder chords / free measure)
Function.CAD_IO.WriteFloat {
    Input: fd: Integer
    Input: val_r: Integer
    Output: Integer
    Body: {
        signb = BitwiseAnd(val_r, 0x8000000000000000)
        IfCondition NotEqual(signb, 0) ThenBlock: {
            CAD_IO.WriteStr(fd, "-")
            val_r = BitwiseAnd(val_r, 0x7FFFFFFFFFFFFFFF)
        }
        iv = Float_ToInt(val_r)
        s = NumberToString(iv)
        CAD_IO.WriteStr(fd, s)
        CAD_IO.WriteStr(fd, ".")
        whole_r = Float_FromInt(iv)
        frac_r = Float_Sub(val_r, whole_r)
        scaled = Float_Mul(frac_r, 0x408F400000000000)
        scaled = Float_Add(scaled, 0x3FE0000000000000)
        milli = Float_ToInt(scaled)
        IfCondition GreaterThan(milli, 999) ThenBlock: { milli = 999 }
        IfCondition LessThan(milli, 0) ThenBlock: { milli = 0 }
        IfCondition LessThan(milli, 100) ThenBlock: { CAD_IO.WriteStr(fd, "0") }
        IfCondition LessThan(milli, 10) ThenBlock: { CAD_IO.WriteStr(fd, "0") }
        sm = NumberToString(milli)
        CAD_IO.WriteStr(fd, sm)
        ReturnValue(0)
    }
}

Function.CAD_IO.WriteId {
    Input: fd: Integer
    Input: id: Integer
    Output: Integer
    Body: {
        CAD_IO.WriteStr(fd, "#")
        s = NumberToString(id)
        CAD_IO.WriteStr(fd, s)
        ReturnValue(0)
    }
}

// CARTESIAN_POINT #id
Function.CAD_IO.WritePoint {
    Input: fd: Integer
    Input: id: Integer
    Input: xyz_addr: Address
    Output: Integer
    Body: {
        CAD_IO.WriteId(fd, id)
        CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, ArrayGet(xyz_addr, 0))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, ArrayGet(xyz_addr, 1))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, ArrayGet(xyz_addr, 2))
        CAD_IO.WriteStr(fd, "));\n")
        ReturnValue(0)
    }
}

// Scan solid face rings → AABB (min_addr / max_addr xyz)
Function.CAD_IO.SolidAABB {
    Input: solid_handle: Integer
    Input: min_addr: Address
    Input: max_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        shell = CAD_Store.Read(solid_handle, 0)
        face = CAD_Store.Read(shell, 0)
        IfCondition EqualTo(face, 0) ThenBlock: { ReturnValue(-1) }

        first = 1
        fguard = 0
        WhileLoop NotEqual(face, 0) {
            loop_h = CAD_Store.Read(face, 1)
            head = CAD_Store.Read(loop_h, 0)
            ce = head
            cguard = 0
            done_ring = 0
            WhileLoop EqualTo(done_ring, 0) {
                origin = CAD_Store.Read(ce, 5)
                px = CAD_Store.Read(origin, 0)
                py = CAD_Store.Read(origin, 1)
                pz = CAD_Store.Read(origin, 2)
                IfCondition EqualTo(first, 1) ThenBlock: {
                    ArraySet(min_addr, 0, px)
                    ArraySet(min_addr, 1, py)
                    ArraySet(min_addr, 2, pz)
                    ArraySet(max_addr, 0, px)
                    ArraySet(max_addr, 1, py)
                    ArraySet(max_addr, 2, pz)
                    first = 0
                }
                IfCondition EqualTo(Float_Le(px, ArrayGet(min_addr, 0)), 1) ThenBlock: {
                    ArraySet(min_addr, 0, px)
                }
                IfCondition EqualTo(Float_Le(py, ArrayGet(min_addr, 1)), 1) ThenBlock: {
                    ArraySet(min_addr, 1, py)
                }
                IfCondition EqualTo(Float_Le(pz, ArrayGet(min_addr, 2)), 1) ThenBlock: {
                    ArraySet(min_addr, 2, pz)
                }
                IfCondition EqualTo(Float_Le(ArrayGet(max_addr, 0), px), 1) ThenBlock: {
                    ArraySet(max_addr, 0, px)
                }
                IfCondition EqualTo(Float_Le(ArrayGet(max_addr, 1), py), 1) ThenBlock: {
                    ArraySet(max_addr, 1, py)
                }
                IfCondition EqualTo(Float_Le(ArrayGet(max_addr, 2), pz), 1) ThenBlock: {
                    ArraySet(max_addr, 2, pz)
                }
                ce = CAD_Store.Read(ce, 2)
                cguard = Add(cguard, 1)
                IfCondition EqualTo(ce, head) ThenBlock: {
                    done_ring = 1
                }
                IfCondition GreaterThan(cguard, 64) ThenBlock: {
                    done_ring = 1
                }
            }
            face = CAD_Store.Read(face, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 64) ThenBlock: {
                face = 0
            }
        }
        ReturnValue(0)
    }
}

// Write full AP214 box B-Rep for AABB (same topology as known-good cli_model.stp)
Function.CAD_IO.WriteBoxSTEP {
    Input: fd: Integer
    Input: min_addr: Address
    Input: max_addr: Address
    Output: Integer
    Body: {
        x0 = ArrayGet(min_addr, 0)
        y0 = ArrayGet(min_addr, 1)
        z0 = ArrayGet(min_addr, 2)
        x1 = ArrayGet(max_addr, 0)
        y1 = ArrayGet(max_addr, 1)
        z1 = ArrayGet(max_addr, 2)

        p = Allocate(32)

        CAD_IO.WriteStr(fd, "ISO-10303-21;\n")
        CAD_IO.WriteStr(fd, "HEADER;\n")
        CAD_IO.WriteStr(fd, "FILE_DESCRIPTION(('AILang CAD Box'),'2;1');\n")
        CAD_IO.WriteStr(fd, "FILE_NAME('ailang_box.stp','2026-08-05T00:00:00',('AILang'),('2 Paws Machine'),'AILang CAD Engine','AILang CAD Engine','');\n")
        CAD_IO.WriteStr(fd, "FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\n")
        CAD_IO.WriteStr(fd, "DATA;\n")

        CAD_IO.WriteStr(fd, "#100 = APPLICATION_CONTEXT('automotive design');\n")
        CAD_IO.WriteStr(fd, "#101 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#100);\n")
        CAD_IO.WriteStr(fd, "#102 = PRODUCT('ailang_box','ailang_box','',(#103));\n")
        CAD_IO.WriteStr(fd, "#103 = PRODUCT_CONTEXT('',#100,'mechanical');\n")
        CAD_IO.WriteStr(fd, "#104 = PRODUCT_DEFINITION_FORMATION('','',#102);\n")
        CAD_IO.WriteStr(fd, "#105 = PRODUCT_DEFINITION('design','',#104,#106);\n")
        CAD_IO.WriteStr(fd, "#106 = PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');\n")
        CAD_IO.WriteStr(fd, "#107 = PRODUCT_DEFINITION_SHAPE('','',#105);\n")
        CAD_IO.WriteStr(fd, "#108 = SHAPE_DEFINITION_REPRESENTATION(#107,#109);\n")
        CAD_IO.WriteStr(fd, "#109 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#110),#111);\n")
        CAD_IO.WriteStr(fd, "#110 = MANIFOLD_SOLID_BREP('Box',#120);\n")
        CAD_IO.WriteStr(fd, "#111 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#112)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#113,#114,#115)) REPRESENTATION_CONTEXT('Context3D','3D Context') );\n")
        CAD_IO.WriteStr(fd, "#112 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#113,'distance_accuracy_value','confusion accuracy');\n")
        CAD_IO.WriteStr(fd, "#113 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );\n")
        CAD_IO.WriteStr(fd, "#114 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT(*,.RADIAN.) );\n")
        CAD_IO.WriteStr(fd, "#115 = ( NAMED_UNIT(*) SI_UNIT(*,.STERADIAN.) SOLID_ANGLE_UNIT() );\n")

        // 8 corners
        ArraySet(p, 0, x0)
        ArraySet(p, 1, y0)
        ArraySet(p, 2, z0)
        CAD_IO.WritePoint(fd, 1, p)
        ArraySet(p, 0, x1)
        CAD_IO.WritePoint(fd, 2, p)
        ArraySet(p, 1, y1)
        CAD_IO.WritePoint(fd, 3, p)
        ArraySet(p, 0, x0)
        CAD_IO.WritePoint(fd, 4, p)
        ArraySet(p, 1, y0)
        ArraySet(p, 2, z1)
        CAD_IO.WritePoint(fd, 5, p)
        ArraySet(p, 0, x1)
        CAD_IO.WritePoint(fd, 6, p)
        ArraySet(p, 1, y1)
        CAD_IO.WritePoint(fd, 7, p)
        ArraySet(p, 0, x0)
        CAD_IO.WritePoint(fd, 8, p)

        CAD_IO.WriteStr(fd, "#11 = VERTEX_POINT('',#1);\n")
        CAD_IO.WriteStr(fd, "#12 = VERTEX_POINT('',#2);\n")
        CAD_IO.WriteStr(fd, "#13 = VERTEX_POINT('',#3);\n")
        CAD_IO.WriteStr(fd, "#14 = VERTEX_POINT('',#4);\n")
        CAD_IO.WriteStr(fd, "#15 = VERTEX_POINT('',#5);\n")
        CAD_IO.WriteStr(fd, "#16 = VERTEX_POINT('',#6);\n")
        CAD_IO.WriteStr(fd, "#17 = VERTEX_POINT('',#7);\n")
        CAD_IO.WriteStr(fd, "#18 = VERTEX_POINT('',#8);\n")

        CAD_IO.WriteStr(fd, "#20 = DIRECTION('',(0.,0.,1.));\n")
        CAD_IO.WriteStr(fd, "#21 = DIRECTION('',(1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#22 = DIRECTION('',(0.,1.,0.));\n")
        CAD_IO.WriteStr(fd, "#23 = DIRECTION('',(0.,0.,-1.));\n")
        CAD_IO.WriteStr(fd, "#24 = DIRECTION('',(-1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#25 = DIRECTION('',(0.,-1.,0.));\n")

        // VECTOR for line directions (STEP LINE needs VECTOR not raw DIRECTION in some readers)
        CAD_IO.WriteStr(fd, "#26 = VECTOR('',#21,1.);\n")
        CAD_IO.WriteStr(fd, "#27 = VECTOR('',#22,1.);\n")
        CAD_IO.WriteStr(fd, "#28 = VECTOR('',#24,1.);\n")
        CAD_IO.WriteStr(fd, "#29 = VECTOR('',#25,1.);\n")
        CAD_IO.WriteStr(fd, "#30 = VECTOR('',#20,1.);\n")

        CAD_IO.WriteStr(fd, "#31 = LINE('',#1,#26);\n")
        CAD_IO.WriteStr(fd, "#32 = LINE('',#2,#27);\n")
        CAD_IO.WriteStr(fd, "#33 = LINE('',#3,#28);\n")
        CAD_IO.WriteStr(fd, "#34 = LINE('',#4,#29);\n")
        CAD_IO.WriteStr(fd, "#35 = LINE('',#5,#26);\n")
        CAD_IO.WriteStr(fd, "#36 = LINE('',#6,#27);\n")
        CAD_IO.WriteStr(fd, "#37 = LINE('',#7,#28);\n")
        CAD_IO.WriteStr(fd, "#38 = LINE('',#8,#29);\n")
        CAD_IO.WriteStr(fd, "#39 = LINE('',#1,#30);\n")
        CAD_IO.WriteStr(fd, "#40 = LINE('',#2,#30);\n")
        CAD_IO.WriteStr(fd, "#41 = LINE('',#3,#30);\n")
        CAD_IO.WriteStr(fd, "#42 = LINE('',#4,#30);\n")

        CAD_IO.WriteStr(fd, "#51 = EDGE_CURVE('',#11,#12,#31,.T.);\n")
        CAD_IO.WriteStr(fd, "#52 = EDGE_CURVE('',#12,#13,#32,.T.);\n")
        CAD_IO.WriteStr(fd, "#53 = EDGE_CURVE('',#13,#14,#33,.T.);\n")
        CAD_IO.WriteStr(fd, "#54 = EDGE_CURVE('',#14,#11,#34,.T.);\n")
        CAD_IO.WriteStr(fd, "#55 = EDGE_CURVE('',#15,#16,#35,.T.);\n")
        CAD_IO.WriteStr(fd, "#56 = EDGE_CURVE('',#16,#17,#36,.T.);\n")
        CAD_IO.WriteStr(fd, "#57 = EDGE_CURVE('',#17,#18,#37,.T.);\n")
        CAD_IO.WriteStr(fd, "#58 = EDGE_CURVE('',#18,#15,#38,.T.);\n")
        CAD_IO.WriteStr(fd, "#59 = EDGE_CURVE('',#11,#15,#39,.T.);\n")
        CAD_IO.WriteStr(fd, "#60 = EDGE_CURVE('',#12,#16,#40,.T.);\n")
        CAD_IO.WriteStr(fd, "#61 = EDGE_CURVE('',#13,#17,#41,.T.);\n")
        CAD_IO.WriteStr(fd, "#62 = EDGE_CURVE('',#14,#18,#42,.T.);\n")

        // Oriented edges + loops (same connectivity as cli_model.stp)
        CAD_IO.WriteStr(fd, "#71 = ORIENTED_EDGE('',*,*,#51,.T.);\n")
        CAD_IO.WriteStr(fd, "#72 = ORIENTED_EDGE('',*,*,#52,.T.);\n")
        CAD_IO.WriteStr(fd, "#73 = ORIENTED_EDGE('',*,*,#53,.T.);\n")
        CAD_IO.WriteStr(fd, "#74 = ORIENTED_EDGE('',*,*,#54,.T.);\n")
        CAD_IO.WriteStr(fd, "#75 = ORIENTED_EDGE('',*,*,#55,.F.);\n")
        CAD_IO.WriteStr(fd, "#76 = ORIENTED_EDGE('',*,*,#56,.F.);\n")
        CAD_IO.WriteStr(fd, "#77 = ORIENTED_EDGE('',*,*,#57,.F.);\n")
        CAD_IO.WriteStr(fd, "#78 = ORIENTED_EDGE('',*,*,#58,.F.);\n")
        CAD_IO.WriteStr(fd, "#81 = ORIENTED_EDGE('',*,*,#51,.F.);\n")
        CAD_IO.WriteStr(fd, "#82 = ORIENTED_EDGE('',*,*,#59,.T.);\n")
        CAD_IO.WriteStr(fd, "#83 = ORIENTED_EDGE('',*,*,#55,.T.);\n")
        CAD_IO.WriteStr(fd, "#84 = ORIENTED_EDGE('',*,*,#60,.F.);\n")
        CAD_IO.WriteStr(fd, "#85 = ORIENTED_EDGE('',*,*,#52,.F.);\n")
        CAD_IO.WriteStr(fd, "#86 = ORIENTED_EDGE('',*,*,#60,.T.);\n")
        CAD_IO.WriteStr(fd, "#87 = ORIENTED_EDGE('',*,*,#56,.T.);\n")
        CAD_IO.WriteStr(fd, "#88 = ORIENTED_EDGE('',*,*,#61,.F.);\n")
        CAD_IO.WriteStr(fd, "#89 = ORIENTED_EDGE('',*,*,#53,.F.);\n")
        CAD_IO.WriteStr(fd, "#90 = ORIENTED_EDGE('',*,*,#61,.T.);\n")
        CAD_IO.WriteStr(fd, "#91 = ORIENTED_EDGE('',*,*,#57,.T.);\n")
        CAD_IO.WriteStr(fd, "#92 = ORIENTED_EDGE('',*,*,#62,.F.);\n")
        CAD_IO.WriteStr(fd, "#93 = ORIENTED_EDGE('',*,*,#54,.F.);\n")
        CAD_IO.WriteStr(fd, "#94 = ORIENTED_EDGE('',*,*,#62,.T.);\n")
        CAD_IO.WriteStr(fd, "#95 = ORIENTED_EDGE('',*,*,#58,.T.);\n")
        CAD_IO.WriteStr(fd, "#96 = ORIENTED_EDGE('',*,*,#59,.F.);\n")

        CAD_IO.WriteStr(fd, "#131 = EDGE_LOOP('',(#71,#72,#73,#74));\n")
        CAD_IO.WriteStr(fd, "#132 = EDGE_LOOP('',(#78,#77,#76,#75));\n")
        CAD_IO.WriteStr(fd, "#133 = EDGE_LOOP('',(#81,#82,#83,#84));\n")
        CAD_IO.WriteStr(fd, "#134 = EDGE_LOOP('',(#85,#86,#87,#88));\n")
        CAD_IO.WriteStr(fd, "#135 = EDGE_LOOP('',(#89,#90,#91,#92));\n")
        CAD_IO.WriteStr(fd, "#136 = EDGE_LOOP('',(#93,#94,#95,#96));\n")

        CAD_IO.WriteStr(fd, "#141 = FACE_OUTER_BOUND('',#131,.T.);\n")
        CAD_IO.WriteStr(fd, "#142 = FACE_OUTER_BOUND('',#132,.T.);\n")
        CAD_IO.WriteStr(fd, "#143 = FACE_OUTER_BOUND('',#133,.T.);\n")
        CAD_IO.WriteStr(fd, "#144 = FACE_OUTER_BOUND('',#134,.T.);\n")
        CAD_IO.WriteStr(fd, "#145 = FACE_OUTER_BOUND('',#135,.T.);\n")
        CAD_IO.WriteStr(fd, "#146 = FACE_OUTER_BOUND('',#136,.T.);\n")

        CAD_IO.WriteStr(fd, "#151 = AXIS2_PLACEMENT_3D('',#1,#23,#21);\n")
        CAD_IO.WriteStr(fd, "#152 = AXIS2_PLACEMENT_3D('',#5,#20,#21);\n")
        CAD_IO.WriteStr(fd, "#153 = AXIS2_PLACEMENT_3D('',#1,#25,#21);\n")
        CAD_IO.WriteStr(fd, "#154 = AXIS2_PLACEMENT_3D('',#2,#21,#22);\n")
        CAD_IO.WriteStr(fd, "#155 = AXIS2_PLACEMENT_3D('',#3,#22,#24);\n")
        CAD_IO.WriteStr(fd, "#156 = AXIS2_PLACEMENT_3D('',#4,#24,#25);\n")

        CAD_IO.WriteStr(fd, "#161 = PLANE('',#151);\n")
        CAD_IO.WriteStr(fd, "#162 = PLANE('',#152);\n")
        CAD_IO.WriteStr(fd, "#163 = PLANE('',#153);\n")
        CAD_IO.WriteStr(fd, "#164 = PLANE('',#154);\n")
        CAD_IO.WriteStr(fd, "#165 = PLANE('',#155);\n")
        CAD_IO.WriteStr(fd, "#166 = PLANE('',#156);\n")

        CAD_IO.WriteStr(fd, "#171 = ADVANCED_FACE('',(#141),#161,.T.);\n")
        CAD_IO.WriteStr(fd, "#172 = ADVANCED_FACE('',(#142),#162,.T.);\n")
        CAD_IO.WriteStr(fd, "#173 = ADVANCED_FACE('',(#143),#163,.T.);\n")
        CAD_IO.WriteStr(fd, "#174 = ADVANCED_FACE('',(#144),#164,.T.);\n")
        CAD_IO.WriteStr(fd, "#175 = ADVANCED_FACE('',(#145),#165,.T.);\n")
        CAD_IO.WriteStr(fd, "#176 = ADVANCED_FACE('',(#146),#166,.T.);\n")

        CAD_IO.WriteStr(fd, "#120 = CLOSED_SHELL('',(#171,#172,#173,#174,#175,#176));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\n")
        CAD_IO.WriteStr(fd, "END-ISO-10303-21;\n")

        Deallocate(p, 32)
        ReturnValue(0)
    }
}

// Walk solid topology → polyhedral AP214 MANIFOLD_SOLID_BREP.
// Works for box and n-gon cylinder (all faces planar polygons + line edges).
// Returns 0 ok, -1 if empty/unsupported.
Function.CAD_IO.WritePolySolidSTEP {
    Input: fd: Integer
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(shell, 0) ThenBlock: { ReturnValue(-1) }

        // tables: vertex handles, edge handles, face handles (max 512)
        vh = Allocate(4096)
        eh = Allocate(8192)
        fh = Allocate(4096)
        nv = 0
        ne = 0
        nf = 0
        pt = Allocate(32)
        dvec = Allocate(32)

        // --- collect unique verts, edges, faces ---
        face = CAD_Store.Read(shell, 0)
        fguard = 0
        WhileLoop NotEqual(face, 0) {
            IfCondition LessThan(nf, 512) ThenBlock: {
                ArraySet(fh, nf, face)
                nf = Add(nf, 1)
            }
            loop_h = CAD_Store.Read(face, 1)
            head = CAD_Store.Read(loop_h, 0)
            ce = head
            cguard = 0
            done = 0
            WhileLoop EqualTo(done, 0) {
                // vertex
                ov = CAD_Store.Read(ce, 5)
                found = 0
                i = 0
                WhileLoop LessThan(i, nv) {
                    IfCondition EqualTo(ArrayGet(vh, i), ov) ThenBlock: { found = 1 }
                    i = Add(i, 1)
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    IfCondition LessThan(nv, 512) ThenBlock: {
                        ArraySet(vh, nv, ov)
                        nv = Add(nv, 1)
                    }
                }
                // edge
                ed = CAD_Store.Read(ce, 0)
                found = 0
                i = 0
                WhileLoop LessThan(i, ne) {
                    IfCondition EqualTo(ArrayGet(eh, i), ed) ThenBlock: { found = 1 }
                    i = Add(i, 1)
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    IfCondition LessThan(ne, 1024) ThenBlock: {
                        ArraySet(eh, ne, ed)
                        ne = Add(ne, 1)
                    }
                }
                ce = CAD_Store.Read(ce, 2)
                cguard = Add(cguard, 1)
                IfCondition EqualTo(ce, head) ThenBlock: { done = 1 }
                IfCondition GreaterThan(cguard, 256) ThenBlock: { done = 1 }
            }
            face = CAD_Store.Read(face, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 512) ThenBlock: { face = 0 }
        }

        IfCondition LessThan(nv, 4) ThenBlock: {
            Deallocate(vh, 4096)
            Deallocate(eh, 8192)
            Deallocate(fh, 4096)
            Deallocate(pt, 32)
            Deallocate(dvec, 32)
            ReturnValue(-1)
        }
        IfCondition LessThan(nf, 1) ThenBlock: {
            Deallocate(vh, 4096)
            Deallocate(eh, 8192)
            Deallocate(fh, 4096)
            Deallocate(pt, 32)
            Deallocate(dvec, 32)
            ReturnValue(-1)
        }

        // --- HEADER ---
        CAD_IO.WriteStr(fd, "ISO-10303-21;\n")
        CAD_IO.WriteStr(fd, "HEADER;\n")
        CAD_IO.WriteStr(fd, "FILE_DESCRIPTION(('AILang CAD Solid'),'2;1');\n")
        CAD_IO.WriteStr(fd, "FILE_NAME('ailang_solid.stp','2026-08-05T00:00:00',('AILang'),('2 Paws Machine'),'AILang CAD Engine','AILang CAD Engine','');\n")
        CAD_IO.WriteStr(fd, "FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\n")
        CAD_IO.WriteStr(fd, "DATA;\n")
        CAD_IO.WriteStr(fd, "#100 = APPLICATION_CONTEXT('automotive design');\n")
        CAD_IO.WriteStr(fd, "#101 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#100);\n")
        CAD_IO.WriteStr(fd, "#102 = PRODUCT('ailang_solid','ailang_solid','',(#103));\n")
        CAD_IO.WriteStr(fd, "#103 = PRODUCT_CONTEXT('',#100,'mechanical');\n")
        CAD_IO.WriteStr(fd, "#104 = PRODUCT_DEFINITION_FORMATION('','',#102);\n")
        CAD_IO.WriteStr(fd, "#105 = PRODUCT_DEFINITION('design','',#104,#106);\n")
        CAD_IO.WriteStr(fd, "#106 = PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');\n")
        CAD_IO.WriteStr(fd, "#107 = PRODUCT_DEFINITION_SHAPE('','',#105);\n")
        CAD_IO.WriteStr(fd, "#108 = SHAPE_DEFINITION_REPRESENTATION(#107,#109);\n")
        CAD_IO.WriteStr(fd, "#109 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#110),#111);\n")
        CAD_IO.WriteStr(fd, "#110 = MANIFOLD_SOLID_BREP('Solid',#120);\n")
        CAD_IO.WriteStr(fd, "#111 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#112)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#113,#114,#115)) REPRESENTATION_CONTEXT('Context3D','3D Context') );\n")
        CAD_IO.WriteStr(fd, "#112 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#113,'distance_accuracy_value','confusion accuracy');\n")
        CAD_IO.WriteStr(fd, "#113 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );\n")
        CAD_IO.WriteStr(fd, "#114 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT(*,.RADIAN.) );\n")
        CAD_IO.WriteStr(fd, "#115 = ( NAMED_UNIT(*) SI_UNIT(*,.STERADIAN.) SOLID_ANGLE_UNIT() );\n")

        // Geometry IDs start at 10000+ so they never collide with product #100–#120
        // (cylinder has 180+ points — old scheme #1..#nv overwrote product graph).
        // point 10001+i  vp 20001+i  dirE 30001+e  vec 31001+e  line 32001+e
        // ec 33001+e  oe 40000+  loop 50001+f  fob 51001+f  zdir 52001+f
        // xdir 53001+f  axis 54001+f  plane 55001+f  face 56001+f  shell #120

        // --- CARTESIAN_POINT + VERTEX_POINT ---
        i = 0
        WhileLoop LessThan(i, nv) {
            hv = ArrayGet(vh, i)
            ArraySet(pt, 0, CAD_Store.Read(hv, 0))
            ArraySet(pt, 1, CAD_Store.Read(hv, 1))
            ArraySet(pt, 2, CAD_Store.Read(hv, 2))
            pid = Add(10001, i)
            CAD_IO.WritePoint(fd, pid, pt)
            CAD_IO.WriteId(fd, Add(20001, i))
            CAD_IO.WriteStr(fd, " = VERTEX_POINT('',#")
            s = NumberToString(pid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            i = Add(i, 1)
        }

        // --- edges ---
        i = 0
        WhileLoop LessThan(i, ne) {
            ed = ArrayGet(eh, i)
            v0h = CAD_Store.Read(ed, 0)
            v1h = CAD_Store.Read(ed, 1)
            // 0-based index into vh
            i0 = 0
            i1 = 0
            j = 0
            WhileLoop LessThan(j, nv) {
                IfCondition EqualTo(ArrayGet(vh, j), v0h) ThenBlock: { i0 = j }
                IfCondition EqualTo(ArrayGet(vh, j), v1h) ThenBlock: { i1 = j }
                j = Add(j, 1)
            }
            p0 = Add(10001, i0)
            p1 = Add(10001, i1)
            vp0 = Add(20001, i0)
            vp1 = Add(20001, i1)
            dx = Float_Sub(CAD_Store.Read(v1h, 0), CAD_Store.Read(v0h, 0))
            dy = Float_Sub(CAD_Store.Read(v1h, 1), CAD_Store.Read(v0h, 1))
            dz = Float_Sub(CAD_Store.Read(v1h, 2), CAD_Store.Read(v0h, 2))
            ArraySet(dvec, 0, dx)
            ArraySet(dvec, 1, dy)
            ArraySet(dvec, 2, dz)
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Num.V3Length(dvec), 0), 1) ThenBlock: {
                ArraySet(dvec, 0, 0x3FF0000000000000)
                ArraySet(dvec, 1, 0)
                ArraySet(dvec, 2, 0)
            }
            // normalize direction for STEP AXIS/DIRECTION readers
            CAD_Num.V3Normalize(dvec, dvec)
            did = Add(30001, i)
            vid = Add(31001, i)
            lid = Add(32001, i)
            ecid = Add(33001, i)
            CAD_IO.WriteId(fd, did)
            CAD_IO.WriteStr(fd, " = DIRECTION('',(")
            CAD_IO.WriteFloat(fd, ArrayGet(dvec, 0))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, ArrayGet(dvec, 1))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, ArrayGet(dvec, 2))
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, vid)
            CAD_IO.WriteStr(fd, " = VECTOR('',#")
            s = NumberToString(did)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",1.);\n")
            CAD_IO.WriteId(fd, lid)
            CAD_IO.WriteStr(fd, " = LINE('',#")
            s = NumberToString(p0)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(vid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            CAD_IO.WriteId(fd, ecid)
            CAD_IO.WriteStr(fd, " = EDGE_CURVE('',#")
            s = NumberToString(vp0)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(vp1)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(lid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            i = Add(i, 1)
        }

        // --- faces ---
        oe_next = 40000
        i = 0
        WhileLoop LessThan(i, nf) {
            face = ArrayGet(fh, i)
            loop_h = CAD_Store.Read(face, 1)
            head = CAD_Store.Read(loop_h, 0)
            ring = Allocate(2048)
            nce = 0
            ce = head
            cguard = 0
            done = 0
            px0 = 0
            py0 = 0
            pz0 = 0
            px1 = 0
            py1 = 0
            pz1 = 0
            px2 = 0
            py2 = 0
            pz2 = 0
            WhileLoop EqualTo(done, 0) {
                ed = CAD_Store.Read(ce, 0)
                sense = CAD_Store.Read(ce, 6)
                eidx = 0
                j = 0
                WhileLoop LessThan(j, ne) {
                    IfCondition EqualTo(ArrayGet(eh, j), ed) ThenBlock: { eidx = j }
                    j = Add(j, 1)
                }
                oe = oe_next
                oe_next = Add(oe_next, 1)
                ArraySet(ring, nce, oe)
                nce = Add(nce, 1)
                CAD_IO.WriteId(fd, oe)
                CAD_IO.WriteStr(fd, " = ORIENTED_EDGE('',*,*,#")
                s = NumberToString(Add(33001, eidx))
                CAD_IO.WriteStr(fd, s)
                IfCondition EqualTo(sense, 0) ThenBlock: {
                    CAD_IO.WriteStr(fd, ",.F.);\n")
                } ElseBlock: {
                    CAD_IO.WriteStr(fd, ",.T.);\n")
                }
                ov = CAD_Store.Read(ce, 5)
                IfCondition EqualTo(nce, 1) ThenBlock: {
                    px0 = CAD_Store.Read(ov, 0)
                    py0 = CAD_Store.Read(ov, 1)
                    pz0 = CAD_Store.Read(ov, 2)
                }
                IfCondition EqualTo(nce, 2) ThenBlock: {
                    px1 = CAD_Store.Read(ov, 0)
                    py1 = CAD_Store.Read(ov, 1)
                    pz1 = CAD_Store.Read(ov, 2)
                }
                IfCondition EqualTo(nce, 3) ThenBlock: {
                    px2 = CAD_Store.Read(ov, 0)
                    py2 = CAD_Store.Read(ov, 1)
                    pz2 = CAD_Store.Read(ov, 2)
                }
                ce = CAD_Store.Read(ce, 2)
                cguard = Add(cguard, 1)
                IfCondition EqualTo(ce, head) ThenBlock: { done = 1 }
                IfCondition GreaterThan(cguard, 256) ThenBlock: { done = 1 }
            }

            loop_id = Add(50001, i)
            CAD_IO.WriteId(fd, loop_id)
            CAD_IO.WriteStr(fd, " = EDGE_LOOP('',(")
            j = 0
            WhileLoop LessThan(j, nce) {
                IfCondition GreaterThan(j, 0) ThenBlock: { CAD_IO.WriteStr(fd, ",") }
                CAD_IO.WriteStr(fd, "#")
                s = NumberToString(ArrayGet(ring, j))
                CAD_IO.WriteStr(fd, s)
                j = Add(j, 1)
            }
            CAD_IO.WriteStr(fd, "));\n")

            bid = Add(51001, i)
            CAD_IO.WriteId(fd, bid)
            CAD_IO.WriteStr(fd, " = FACE_OUTER_BOUND('',#")
            s = NumberToString(loop_id)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")

            ArraySet(dvec, 0, Float_Sub(px1, px0))
            ArraySet(dvec, 1, Float_Sub(py1, py0))
            ArraySet(dvec, 2, Float_Sub(pz1, pz0))
            yx = Float_Sub(px2, px0)
            yy = Float_Sub(py2, py0)
            yz = Float_Sub(pz2, pz0)
            zx = Float_Sub(Float_Mul(ArrayGet(dvec, 1), yz), Float_Mul(ArrayGet(dvec, 2), yy))
            zy = Float_Sub(Float_Mul(ArrayGet(dvec, 2), yx), Float_Mul(ArrayGet(dvec, 0), yz))
            zz = Float_Sub(Float_Mul(ArrayGet(dvec, 0), yy), Float_Mul(ArrayGet(dvec, 1), yx))
            ArraySet(pt, 0, zx)
            ArraySet(pt, 1, zy)
            ArraySet(pt, 2, zz)
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Num.V3Length(pt), 0), 1) ThenBlock: {
                ArraySet(pt, 0, 0)
                ArraySet(pt, 1, 0)
                ArraySet(pt, 2, 0x3FF0000000000000)
            }
            CAD_Num.V3Normalize(pt, pt)
            CAD_Num.V3Normalize(dvec, dvec)
            zid = Add(52001, i)
            xid = Add(53001, i)
            CAD_IO.WriteId(fd, zid)
            CAD_IO.WriteStr(fd, " = DIRECTION('',(")
            CAD_IO.WriteFloat(fd, ArrayGet(pt, 0))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, ArrayGet(pt, 1))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, ArrayGet(pt, 2))
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, xid)
            CAD_IO.WriteStr(fd, " = DIRECTION('',(")
            CAD_IO.WriteFloat(fd, ArrayGet(dvec, 0))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, ArrayGet(dvec, 1))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, ArrayGet(dvec, 2))
            CAD_IO.WriteStr(fd, "));\n")
            ov0 = CAD_Store.Read(head, 5)
            i_origin = 0
            j = 0
            WhileLoop LessThan(j, nv) {
                IfCondition EqualTo(ArrayGet(vh, j), ov0) ThenBlock: { i_origin = j }
                j = Add(j, 1)
            }
            p_origin = Add(10001, i_origin)
            aid = Add(54001, i)
            CAD_IO.WriteId(fd, aid)
            CAD_IO.WriteStr(fd, " = AXIS2_PLACEMENT_3D('',#")
            s = NumberToString(p_origin)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(zid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(xid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            plid = Add(55001, i)
            CAD_IO.WriteId(fd, plid)
            CAD_IO.WriteStr(fd, " = PLANE('',#")
            s = NumberToString(aid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            afid = Add(56001, i)
            CAD_IO.WriteId(fd, afid)
            CAD_IO.WriteStr(fd, " = ADVANCED_FACE('',(#")
            s = NumberToString(bid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, "),#")
            s = NumberToString(plid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")

            Deallocate(ring, 2048)
            i = Add(i, 1)
        }

        // CLOSED_SHELL #120 (referenced by MANIFOLD #110)
        CAD_IO.WriteStr(fd, "#120 = CLOSED_SHELL('',(")
        i = 0
        WhileLoop LessThan(i, nf) {
            IfCondition GreaterThan(i, 0) ThenBlock: { CAD_IO.WriteStr(fd, ",") }
            CAD_IO.WriteStr(fd, "#")
            s = NumberToString(Add(56001, i))
            CAD_IO.WriteStr(fd, s)
            i = Add(i, 1)
        }
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\n")
        CAD_IO.WriteStr(fd, "END-ISO-10303-21;\n")

        Deallocate(vh, 4096)
        Deallocate(eh, 8192)
        Deallocate(fh, 4096)
        Deallocate(pt, 32)
        Deallocate(dvec, 32)
        ReturnValue(0)
    }
}

// Coaxial counterbore STEP: larger shallow + smaller deeper (or through).
// Topology (no phantom wall between bores):
//   top face: outer + large-R hole only
//   floor at z_floor: annulus large-R outer, small-r inner
//   pilot wall: small-r from z=0 to z_floor only (not up through the pocket)
//   c'bore wall: large-R from z_floor to top
//   bottom: outer + small-r through
// Returns 0 ok, -1 if not a 2-hole nested counterbore pattern.
Function.CAD_IO.WriteBoxCounterboreSTEP {
    Input: fd: Integer
    Input: params_h: Integer
    Output: Integer
    Body: {
        nh = CAD_Store.Read(params_h, 9)
        IfCondition NotEqual(nh, 2) ThenBlock: { ReturnValue(-1) }
        dx = CAD_Store.Read(params_h, 0)
        dy = CAD_Store.Read(params_h, 1)
        dz = CAD_Store.Read(params_h, 2)
        ox = CAD_Store.Read(params_h, 6)
        oy = CAD_Store.Read(params_h, 7)
        r0 = CAD_Store.Read(params_h, 3)
        cx0 = CAD_Store.Read(params_h, 4)
        cy0 = CAD_Store.Read(params_h, 5)
        d0 = CAD_Store.Read(params_h, 8)
        r1 = CAD_Store.Read(params_h, 10)
        cx1 = CAD_Store.Read(params_h, 11)
        cy1 = CAD_Store.Read(params_h, 12)
        d1 = CAD_Store.Read(params_h, 13)
        IfCondition EqualTo(CAD_Num.IsZero(d0, 0), 1) ThenBlock: { d0 = dz }
        IfCondition EqualTo(CAD_Num.IsZero(d1, 0), 1) ThenBlock: { d1 = dz }
        IfCondition EqualTo(Float_Le(dz, d0), 1) ThenBlock: { d0 = dz }
        IfCondition EqualTo(Float_Le(dz, d1), 1) ThenBlock: { d1 = dz }
        IfCondition EqualTo(CAD_Num.IsEqual(cx0, cx1, 0), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Num.IsEqual(cy0, cy1, 0), 0) ThenBlock: { ReturnValue(-1) }
        rs = r0
        rl = r1
        ds = d0
        dl = d1
        IfCondition EqualTo(Float_Le(r1, r0), 1) ThenBlock: {
            rs = r1
            rl = r0
            ds = d1
            dl = d0
        }
        IfCondition EqualTo(CAD_Num.IsEqual(rs, rl, 0), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Float_Le(rl, rs), 1) ThenBlock: { ReturnValue(-1) }
        // large shallower than pilot (or pilot through)
        IfCondition EqualTo(Float_Le(ds, dl), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(ds, dl, 0), 0) ThenBlock: { ReturnValue(-1) }
        }
        zf = Float_Sub(dz, dl)
        hx = Float_Add(ox, cx0)
        hy = Float_Add(oy, cy0)
        x0 = ox
        y0 = oy
        x1 = Float_Add(ox, dx)
        y1 = Float_Add(oy, dy)

        CAD_IO.WriteStr(fd, "ISO-10303-21;\nHEADER;\n")
        CAD_IO.WriteStr(fd, "FILE_DESCRIPTION(('AILang counterbore'),'2;1');\n")
        CAD_IO.WriteStr(fd, "FILE_NAME('ailang_counterbore.stp','2026-08-05T00:00:00',('AILang'),('2 Paws Machine'),'AILang CAD Engine','AILang CAD Engine','');\n")
        CAD_IO.WriteStr(fd, "FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\nDATA;\n")
        CAD_IO.WriteStr(fd, "#100 = APPLICATION_CONTEXT('automotive design');\n")
        CAD_IO.WriteStr(fd, "#101 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#100);\n")
        CAD_IO.WriteStr(fd, "#102 = PRODUCT('counterbore','counterbore','',(#103));\n")
        CAD_IO.WriteStr(fd, "#103 = PRODUCT_CONTEXT('',#100,'mechanical');\n")
        CAD_IO.WriteStr(fd, "#104 = PRODUCT_DEFINITION_FORMATION('','',#102);\n")
        CAD_IO.WriteStr(fd, "#105 = PRODUCT_DEFINITION('design','',#104,#106);\n")
        CAD_IO.WriteStr(fd, "#106 = PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');\n")
        CAD_IO.WriteStr(fd, "#107 = PRODUCT_DEFINITION_SHAPE('','',#105);\n")
        CAD_IO.WriteStr(fd, "#108 = SHAPE_DEFINITION_REPRESENTATION(#107,#109);\n")
        CAD_IO.WriteStr(fd, "#109 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#110),#111);\n")
        CAD_IO.WriteStr(fd, "#110 = MANIFOLD_SOLID_BREP('Counterbore',#120);\n")
        CAD_IO.WriteStr(fd, "#111 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#112)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#113,#114,#115)) REPRESENTATION_CONTEXT('Context3D','3D Context') );\n")
        CAD_IO.WriteStr(fd, "#112 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#113,'distance_accuracy_value','confusion accuracy');\n")
        CAD_IO.WriteStr(fd, "#113 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );\n")
        CAD_IO.WriteStr(fd, "#114 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT(*,.RADIAN.) );\n")
        CAD_IO.WriteStr(fd, "#115 = ( NAMED_UNIT(*) SI_UNIT(*,.STERADIAN.) SOLID_ANGLE_UNIT() );\n")

        // box #1-8
        CAD_IO.WriteStr(fd, "#1 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#2 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#3 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#4 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#5 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#6 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#7 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#8 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")

        // axis pts: #9 bot, #10 floor, #11 top; seams #12 sbot #13 smid #14 lfloor #15 ltop
        CAD_IO.WriteStr(fd, "#9 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, hx)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, hy)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#10 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, hx)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, hy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, zf)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#11 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, hx)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, hy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#12 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, Float_Add(hx, rs))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, hy)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#13 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, Float_Add(hx, rs))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, hy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, zf)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#14 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, Float_Add(hx, rl))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, hy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, zf)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#15 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, Float_Add(hx, rl))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, hy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")

        CAD_IO.WriteStr(fd, "#21 = VERTEX_POINT('',#1);\n")
        CAD_IO.WriteStr(fd, "#22 = VERTEX_POINT('',#2);\n")
        CAD_IO.WriteStr(fd, "#23 = VERTEX_POINT('',#3);\n")
        CAD_IO.WriteStr(fd, "#24 = VERTEX_POINT('',#4);\n")
        CAD_IO.WriteStr(fd, "#25 = VERTEX_POINT('',#5);\n")
        CAD_IO.WriteStr(fd, "#26 = VERTEX_POINT('',#6);\n")
        CAD_IO.WriteStr(fd, "#27 = VERTEX_POINT('',#7);\n")
        CAD_IO.WriteStr(fd, "#28 = VERTEX_POINT('',#8);\n")
        CAD_IO.WriteStr(fd, "#29 = VERTEX_POINT('',#12);\n")
        CAD_IO.WriteStr(fd, "#30 = VERTEX_POINT('',#13);\n")
        CAD_IO.WriteStr(fd, "#31 = VERTEX_POINT('',#14);\n")
        CAD_IO.WriteStr(fd, "#32 = VERTEX_POINT('',#15);\n")

        CAD_IO.WriteStr(fd, "#40 = DIRECTION('',(1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#41 = DIRECTION('',(0.,1.,0.));\n")
        CAD_IO.WriteStr(fd, "#42 = DIRECTION('',(0.,0.,1.));\n")
        CAD_IO.WriteStr(fd, "#43 = DIRECTION('',(0.,0.,-1.));\n")
        CAD_IO.WriteStr(fd, "#44 = DIRECTION('',(-1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#45 = DIRECTION('',(0.,-1.,0.));\n")
        CAD_IO.WriteStr(fd, "#50 = VECTOR('',#40,1.);\n")
        CAD_IO.WriteStr(fd, "#51 = VECTOR('',#41,1.);\n")
        CAD_IO.WriteStr(fd, "#52 = VECTOR('',#42,1.);\n")
        CAD_IO.WriteStr(fd, "#53 = VECTOR('',#44,1.);\n")
        CAD_IO.WriteStr(fd, "#54 = VECTOR('',#45,1.);\n")

        CAD_IO.WriteStr(fd, "#60 = LINE('',#1,#50);\n")
        CAD_IO.WriteStr(fd, "#61 = LINE('',#2,#51);\n")
        CAD_IO.WriteStr(fd, "#62 = LINE('',#3,#53);\n")
        CAD_IO.WriteStr(fd, "#63 = LINE('',#4,#54);\n")
        CAD_IO.WriteStr(fd, "#64 = LINE('',#5,#50);\n")
        CAD_IO.WriteStr(fd, "#65 = LINE('',#6,#51);\n")
        CAD_IO.WriteStr(fd, "#66 = LINE('',#7,#53);\n")
        CAD_IO.WriteStr(fd, "#67 = LINE('',#8,#54);\n")
        CAD_IO.WriteStr(fd, "#68 = LINE('',#1,#52);\n")
        CAD_IO.WriteStr(fd, "#69 = LINE('',#2,#52);\n")
        CAD_IO.WriteStr(fd, "#70 = LINE('',#3,#52);\n")
        CAD_IO.WriteStr(fd, "#71 = LINE('',#4,#52);\n")
        CAD_IO.WriteStr(fd, "#72 = LINE('',#12,#52);\n")
        CAD_IO.WriteStr(fd, "#73 = LINE('',#14,#52);\n")

        CAD_IO.WriteStr(fd, "#80 = EDGE_CURVE('',#21,#22,#60,.T.);\n")
        CAD_IO.WriteStr(fd, "#81 = EDGE_CURVE('',#22,#23,#61,.T.);\n")
        CAD_IO.WriteStr(fd, "#82 = EDGE_CURVE('',#23,#24,#62,.T.);\n")
        CAD_IO.WriteStr(fd, "#83 = EDGE_CURVE('',#24,#21,#63,.T.);\n")
        CAD_IO.WriteStr(fd, "#84 = EDGE_CURVE('',#25,#26,#64,.T.);\n")
        CAD_IO.WriteStr(fd, "#85 = EDGE_CURVE('',#26,#27,#65,.T.);\n")
        CAD_IO.WriteStr(fd, "#86 = EDGE_CURVE('',#27,#28,#66,.T.);\n")
        CAD_IO.WriteStr(fd, "#87 = EDGE_CURVE('',#28,#25,#67,.T.);\n")
        CAD_IO.WriteStr(fd, "#88 = EDGE_CURVE('',#21,#25,#68,.T.);\n")
        CAD_IO.WriteStr(fd, "#89 = EDGE_CURVE('',#22,#26,#69,.T.);\n")
        CAD_IO.WriteStr(fd, "#90 = EDGE_CURVE('',#23,#27,#70,.T.);\n")
        CAD_IO.WriteStr(fd, "#91 = EDGE_CURVE('',#24,#28,#71,.T.);\n")

        // axes: bot, floor, top
        CAD_IO.WriteStr(fd, "#200 = AXIS2_PLACEMENT_3D('',#9,#42,#40);\n")
        CAD_IO.WriteStr(fd, "#201 = AXIS2_PLACEMENT_3D('',#10,#42,#40);\n")
        CAD_IO.WriteStr(fd, "#202 = AXIS2_PLACEMENT_3D('',#11,#42,#40);\n")
        CAD_IO.WriteStr(fd, "#210 = CIRCLE('',#200,")
        CAD_IO.WriteFloat(fd, rs)
        CAD_IO.WriteStr(fd, ");\n")
        CAD_IO.WriteStr(fd, "#211 = CIRCLE('',#201,")
        CAD_IO.WriteFloat(fd, rs)
        CAD_IO.WriteStr(fd, ");\n")
        CAD_IO.WriteStr(fd, "#212 = CIRCLE('',#201,")
        CAD_IO.WriteFloat(fd, rl)
        CAD_IO.WriteStr(fd, ");\n")
        CAD_IO.WriteStr(fd, "#213 = CIRCLE('',#202,")
        CAD_IO.WriteFloat(fd, rl)
        CAD_IO.WriteStr(fd, ");\n")
        CAD_IO.WriteStr(fd, "#214 = CYLINDRICAL_SURFACE('',#200,")
        CAD_IO.WriteFloat(fd, rs)
        CAD_IO.WriteStr(fd, ");\n")
        CAD_IO.WriteStr(fd, "#215 = CYLINDRICAL_SURFACE('',#201,")
        CAD_IO.WriteFloat(fd, rl)
        CAD_IO.WriteStr(fd, ");\n")

        // edges: small bot/mid, large floor/top, pilot seam, c'bore seam
        CAD_IO.WriteStr(fd, "#220 = EDGE_CURVE('',#29,#29,#210,.T.);\n")
        CAD_IO.WriteStr(fd, "#221 = EDGE_CURVE('',#30,#30,#211,.T.);\n")
        CAD_IO.WriteStr(fd, "#222 = EDGE_CURVE('',#31,#31,#212,.T.);\n")
        CAD_IO.WriteStr(fd, "#223 = EDGE_CURVE('',#32,#32,#213,.T.);\n")
        CAD_IO.WriteStr(fd, "#224 = EDGE_CURVE('',#29,#30,#72,.T.);\n")
        CAD_IO.WriteStr(fd, "#225 = EDGE_CURVE('',#31,#32,#73,.T.);\n")

        // box OEs
        CAD_IO.WriteStr(fd, "#300 = ORIENTED_EDGE('',*,*,#80,.T.);\n")
        CAD_IO.WriteStr(fd, "#301 = ORIENTED_EDGE('',*,*,#81,.T.);\n")
        CAD_IO.WriteStr(fd, "#302 = ORIENTED_EDGE('',*,*,#82,.T.);\n")
        CAD_IO.WriteStr(fd, "#303 = ORIENTED_EDGE('',*,*,#83,.T.);\n")
        CAD_IO.WriteStr(fd, "#304 = ORIENTED_EDGE('',*,*,#84,.T.);\n")
        CAD_IO.WriteStr(fd, "#305 = ORIENTED_EDGE('',*,*,#85,.T.);\n")
        CAD_IO.WriteStr(fd, "#306 = ORIENTED_EDGE('',*,*,#86,.T.);\n")
        CAD_IO.WriteStr(fd, "#307 = ORIENTED_EDGE('',*,*,#87,.T.);\n")
        CAD_IO.WriteStr(fd, "#308 = ORIENTED_EDGE('',*,*,#80,.F.);\n")
        CAD_IO.WriteStr(fd, "#309 = ORIENTED_EDGE('',*,*,#89,.T.);\n")
        CAD_IO.WriteStr(fd, "#310 = ORIENTED_EDGE('',*,*,#84,.F.);\n")
        CAD_IO.WriteStr(fd, "#311 = ORIENTED_EDGE('',*,*,#88,.F.);\n")
        CAD_IO.WriteStr(fd, "#312 = ORIENTED_EDGE('',*,*,#81,.F.);\n")
        CAD_IO.WriteStr(fd, "#313 = ORIENTED_EDGE('',*,*,#90,.T.);\n")
        CAD_IO.WriteStr(fd, "#314 = ORIENTED_EDGE('',*,*,#85,.F.);\n")
        CAD_IO.WriteStr(fd, "#315 = ORIENTED_EDGE('',*,*,#89,.F.);\n")
        CAD_IO.WriteStr(fd, "#316 = ORIENTED_EDGE('',*,*,#82,.F.);\n")
        CAD_IO.WriteStr(fd, "#317 = ORIENTED_EDGE('',*,*,#91,.T.);\n")
        CAD_IO.WriteStr(fd, "#318 = ORIENTED_EDGE('',*,*,#86,.F.);\n")
        CAD_IO.WriteStr(fd, "#319 = ORIENTED_EDGE('',*,*,#90,.F.);\n")
        CAD_IO.WriteStr(fd, "#320 = ORIENTED_EDGE('',*,*,#83,.F.);\n")
        CAD_IO.WriteStr(fd, "#321 = ORIENTED_EDGE('',*,*,#88,.T.);\n")
        CAD_IO.WriteStr(fd, "#322 = ORIENTED_EDGE('',*,*,#87,.F.);\n")
        CAD_IO.WriteStr(fd, "#323 = ORIENTED_EDGE('',*,*,#91,.F.);\n")
        // hole OEs
        CAD_IO.WriteStr(fd, "#330 = ORIENTED_EDGE('',*,*,#220,.T.);\n")
        CAD_IO.WriteStr(fd, "#331 = ORIENTED_EDGE('',*,*,#220,.F.);\n")
        CAD_IO.WriteStr(fd, "#332 = ORIENTED_EDGE('',*,*,#221,.T.);\n")
        CAD_IO.WriteStr(fd, "#333 = ORIENTED_EDGE('',*,*,#221,.F.);\n")
        CAD_IO.WriteStr(fd, "#334 = ORIENTED_EDGE('',*,*,#222,.T.);\n")
        CAD_IO.WriteStr(fd, "#335 = ORIENTED_EDGE('',*,*,#222,.F.);\n")
        CAD_IO.WriteStr(fd, "#336 = ORIENTED_EDGE('',*,*,#223,.T.);\n")
        CAD_IO.WriteStr(fd, "#337 = ORIENTED_EDGE('',*,*,#223,.F.);\n")
        CAD_IO.WriteStr(fd, "#338 = ORIENTED_EDGE('',*,*,#224,.T.);\n")
        CAD_IO.WriteStr(fd, "#339 = ORIENTED_EDGE('',*,*,#224,.F.);\n")
        CAD_IO.WriteStr(fd, "#340 = ORIENTED_EDGE('',*,*,#225,.T.);\n")
        CAD_IO.WriteStr(fd, "#341 = ORIENTED_EDGE('',*,*,#225,.F.);\n")

        // loops
        CAD_IO.WriteStr(fd, "#400 = EDGE_LOOP('',(#300,#301,#302,#303));\n")
        CAD_IO.WriteStr(fd, "#401 = EDGE_LOOP('',(#307,#306,#305,#304));\n")
        CAD_IO.WriteStr(fd, "#402 = EDGE_LOOP('',(#308,#309,#310,#311));\n")
        CAD_IO.WriteStr(fd, "#403 = EDGE_LOOP('',(#312,#313,#314,#315));\n")
        CAD_IO.WriteStr(fd, "#404 = EDGE_LOOP('',(#316,#317,#318,#319));\n")
        CAD_IO.WriteStr(fd, "#405 = EDGE_LOOP('',(#320,#321,#322,#323));\n")
        // bottom hole = pilot (reverse)
        CAD_IO.WriteStr(fd, "#406 = EDGE_LOOP('',(#331));\n")
        // top hole = large only
        CAD_IO.WriteStr(fd, "#407 = EDGE_LOOP('',(#336));\n")
        // floor annulus outer=large floor, inner=pilot mid reverse
        CAD_IO.WriteStr(fd, "#408 = EDGE_LOOP('',(#334));\n")
        CAD_IO.WriteStr(fd, "#409 = EDGE_LOOP('',(#333));\n")
        // pilot wall 0..zf: bot .T., seam, mid .F., seam rev
        CAD_IO.WriteStr(fd, "#410 = EDGE_LOOP('',(#330,#338,#333,#339));\n")
        // large wall zf..dz: floor .T., seam, top .F., seam rev
        CAD_IO.WriteStr(fd, "#411 = EDGE_LOOP('',(#334,#340,#337,#341));\n")

        CAD_IO.WriteStr(fd, "#420 = FACE_OUTER_BOUND('',#400,.T.);\n")
        CAD_IO.WriteStr(fd, "#421 = FACE_BOUND('',#406,.T.);\n")
        CAD_IO.WriteStr(fd, "#422 = FACE_OUTER_BOUND('',#401,.T.);\n")
        CAD_IO.WriteStr(fd, "#423 = FACE_BOUND('',#407,.T.);\n")
        CAD_IO.WriteStr(fd, "#424 = FACE_OUTER_BOUND('',#402,.T.);\n")
        CAD_IO.WriteStr(fd, "#425 = FACE_OUTER_BOUND('',#403,.T.);\n")
        CAD_IO.WriteStr(fd, "#426 = FACE_OUTER_BOUND('',#404,.T.);\n")
        CAD_IO.WriteStr(fd, "#427 = FACE_OUTER_BOUND('',#405,.T.);\n")
        CAD_IO.WriteStr(fd, "#428 = FACE_OUTER_BOUND('',#408,.T.);\n")
        CAD_IO.WriteStr(fd, "#429 = FACE_BOUND('',#409,.T.);\n")
        CAD_IO.WriteStr(fd, "#430 = FACE_OUTER_BOUND('',#410,.T.);\n")
        CAD_IO.WriteStr(fd, "#431 = FACE_OUTER_BOUND('',#411,.T.);\n")

        CAD_IO.WriteStr(fd, "#440 = AXIS2_PLACEMENT_3D('',#1,#43,#40);\n")
        CAD_IO.WriteStr(fd, "#441 = AXIS2_PLACEMENT_3D('',#5,#42,#40);\n")
        CAD_IO.WriteStr(fd, "#442 = AXIS2_PLACEMENT_3D('',#1,#45,#40);\n")
        CAD_IO.WriteStr(fd, "#443 = AXIS2_PLACEMENT_3D('',#2,#40,#41);\n")
        CAD_IO.WriteStr(fd, "#444 = AXIS2_PLACEMENT_3D('',#3,#41,#44);\n")
        CAD_IO.WriteStr(fd, "#445 = AXIS2_PLACEMENT_3D('',#4,#44,#45);\n")
        CAD_IO.WriteStr(fd, "#446 = AXIS2_PLACEMENT_3D('',#10,#42,#40);\n")
        CAD_IO.WriteStr(fd, "#450 = PLANE('',#440);\n")
        CAD_IO.WriteStr(fd, "#451 = PLANE('',#441);\n")
        CAD_IO.WriteStr(fd, "#452 = PLANE('',#442);\n")
        CAD_IO.WriteStr(fd, "#453 = PLANE('',#443);\n")
        CAD_IO.WriteStr(fd, "#454 = PLANE('',#444);\n")
        CAD_IO.WriteStr(fd, "#455 = PLANE('',#445);\n")
        CAD_IO.WriteStr(fd, "#456 = PLANE('',#446);\n")

        // 4 sides + bottom + top + floor annulus + pilot wall + c'bore wall = 9 faces
        CAD_IO.WriteStr(fd, "#500 = ADVANCED_FACE('',(#420,#421),#450,.T.);\n")
        CAD_IO.WriteStr(fd, "#501 = ADVANCED_FACE('',(#422,#423),#451,.T.);\n")
        CAD_IO.WriteStr(fd, "#502 = ADVANCED_FACE('',(#424),#452,.T.);\n")
        CAD_IO.WriteStr(fd, "#503 = ADVANCED_FACE('',(#425),#453,.T.);\n")
        CAD_IO.WriteStr(fd, "#504 = ADVANCED_FACE('',(#426),#454,.T.);\n")
        CAD_IO.WriteStr(fd, "#505 = ADVANCED_FACE('',(#427),#455,.T.);\n")
        CAD_IO.WriteStr(fd, "#506 = ADVANCED_FACE('',(#428,#429),#456,.T.);\n")
        CAD_IO.WriteStr(fd, "#507 = ADVANCED_FACE('',(#430),#214,.T.);\n")
        CAD_IO.WriteStr(fd, "#508 = ADVANCED_FACE('',(#431),#215,.T.);\n")

        CAD_IO.WriteStr(fd, "#120 = CLOSED_SHELL('',(#500,#501,#502,#503,#504,#505,#506,#507,#508));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\nEND-ISO-10303-21;\n")
        ReturnValue(0)
    }
}

// Multi-hole plate analytic STEP (CIRCLE + CYL per hole). Max 5 holes.
// Entity blocks: hole h at base 1000+h*80.
// If 2 coaxial holes form a counterbore, use WriteBoxCounterboreSTEP.
Function.CAD_IO.WriteBoxMultiHoleSTEP {
    Input: fd: Integer
    Input: params_h: Integer
    Output: Integer
    Body: {
        dx = CAD_Store.Read(params_h, 0)
        dy = CAD_Store.Read(params_h, 1)
        dz = CAD_Store.Read(params_h, 2)
        ox = CAD_Store.Read(params_h, 6)
        oy = CAD_Store.Read(params_h, 7)
        nh = CAD_Store.Read(params_h, 9)
        IfCondition EqualTo(nh, 0) ThenBlock: { nh = 1 }
        IfCondition GreaterThan(nh, 5) ThenBlock: { nh = 5 }
        // nested coaxial counterbore → correct B-Rep (no thin phantom wall)
        IfCondition EqualTo(nh, 2) ThenBlock: {
            rc = CAD_IO.WriteBoxCounterboreSTEP(fd, params_h)
            IfCondition EqualTo(rc, 0) ThenBlock: { ReturnValue(0) }
        }
        x0 = ox
        y0 = oy
        x1 = Float_Add(ox, dx)
        y1 = Float_Add(oy, dy)

        CAD_IO.WriteStr(fd, "ISO-10303-21;\nHEADER;\n")
        CAD_IO.WriteStr(fd, "FILE_DESCRIPTION(('AILang multi-hole plate'),'2;1');\n")
        CAD_IO.WriteStr(fd, "FILE_NAME('ailang_multi_hole.stp','2026-08-05T00:00:00',('AILang'),('2 Paws Machine'),'AILang CAD Engine','AILang CAD Engine','');\n")
        CAD_IO.WriteStr(fd, "FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\nDATA;\n")
        CAD_IO.WriteStr(fd, "#100 = APPLICATION_CONTEXT('automotive design');\n")
        CAD_IO.WriteStr(fd, "#101 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#100);\n")
        CAD_IO.WriteStr(fd, "#102 = PRODUCT('multi_hole','multi_hole','',(#103));\n")
        CAD_IO.WriteStr(fd, "#103 = PRODUCT_CONTEXT('',#100,'mechanical');\n")
        CAD_IO.WriteStr(fd, "#104 = PRODUCT_DEFINITION_FORMATION('','',#102);\n")
        CAD_IO.WriteStr(fd, "#105 = PRODUCT_DEFINITION('design','',#104,#106);\n")
        CAD_IO.WriteStr(fd, "#106 = PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');\n")
        CAD_IO.WriteStr(fd, "#107 = PRODUCT_DEFINITION_SHAPE('','',#105);\n")
        CAD_IO.WriteStr(fd, "#108 = SHAPE_DEFINITION_REPRESENTATION(#107,#109);\n")
        CAD_IO.WriteStr(fd, "#109 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#110),#111);\n")
        CAD_IO.WriteStr(fd, "#110 = MANIFOLD_SOLID_BREP('MultiHole',#120);\n")
        CAD_IO.WriteStr(fd, "#111 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#112)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#113,#114,#115)) REPRESENTATION_CONTEXT('Context3D','3D Context') );\n")
        CAD_IO.WriteStr(fd, "#112 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#113,'distance_accuracy_value','confusion accuracy');\n")
        CAD_IO.WriteStr(fd, "#113 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );\n")
        CAD_IO.WriteStr(fd, "#114 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT(*,.RADIAN.) );\n")
        CAD_IO.WriteStr(fd, "#115 = ( NAMED_UNIT(*) SI_UNIT(*,.STERADIAN.) SOLID_ANGLE_UNIT() );\n")

        // box corners (world)
        CAD_IO.WriteStr(fd, "#1 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#2 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#3 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#4 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#5 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#6 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#7 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#8 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")

        CAD_IO.WriteStr(fd, "#21 = VERTEX_POINT('',#1);\n")
        CAD_IO.WriteStr(fd, "#22 = VERTEX_POINT('',#2);\n")
        CAD_IO.WriteStr(fd, "#23 = VERTEX_POINT('',#3);\n")
        CAD_IO.WriteStr(fd, "#24 = VERTEX_POINT('',#4);\n")
        CAD_IO.WriteStr(fd, "#25 = VERTEX_POINT('',#5);\n")
        CAD_IO.WriteStr(fd, "#26 = VERTEX_POINT('',#6);\n")
        CAD_IO.WriteStr(fd, "#27 = VERTEX_POINT('',#7);\n")
        CAD_IO.WriteStr(fd, "#28 = VERTEX_POINT('',#8);\n")

        CAD_IO.WriteStr(fd, "#40 = DIRECTION('',(1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#41 = DIRECTION('',(0.,1.,0.));\n")
        CAD_IO.WriteStr(fd, "#42 = DIRECTION('',(0.,0.,1.));\n")
        CAD_IO.WriteStr(fd, "#43 = DIRECTION('',(0.,0.,-1.));\n")
        CAD_IO.WriteStr(fd, "#44 = DIRECTION('',(-1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#45 = DIRECTION('',(0.,-1.,0.));\n")
        CAD_IO.WriteStr(fd, "#50 = VECTOR('',#40,1.);\n")
        CAD_IO.WriteStr(fd, "#51 = VECTOR('',#41,1.);\n")
        CAD_IO.WriteStr(fd, "#52 = VECTOR('',#42,1.);\n")
        CAD_IO.WriteStr(fd, "#53 = VECTOR('',#44,1.);\n")
        CAD_IO.WriteStr(fd, "#54 = VECTOR('',#45,1.);\n")

        CAD_IO.WriteStr(fd, "#60 = LINE('',#1,#50);\n")
        CAD_IO.WriteStr(fd, "#61 = LINE('',#2,#51);\n")
        CAD_IO.WriteStr(fd, "#62 = LINE('',#3,#53);\n")
        CAD_IO.WriteStr(fd, "#63 = LINE('',#4,#54);\n")
        CAD_IO.WriteStr(fd, "#64 = LINE('',#5,#50);\n")
        CAD_IO.WriteStr(fd, "#65 = LINE('',#6,#51);\n")
        CAD_IO.WriteStr(fd, "#66 = LINE('',#7,#53);\n")
        CAD_IO.WriteStr(fd, "#67 = LINE('',#8,#54);\n")
        CAD_IO.WriteStr(fd, "#68 = LINE('',#1,#52);\n")
        CAD_IO.WriteStr(fd, "#69 = LINE('',#2,#52);\n")
        CAD_IO.WriteStr(fd, "#70 = LINE('',#3,#52);\n")
        CAD_IO.WriteStr(fd, "#71 = LINE('',#4,#52);\n")

        CAD_IO.WriteStr(fd, "#80 = EDGE_CURVE('',#21,#22,#60,.T.);\n")
        CAD_IO.WriteStr(fd, "#81 = EDGE_CURVE('',#22,#23,#61,.T.);\n")
        CAD_IO.WriteStr(fd, "#82 = EDGE_CURVE('',#23,#24,#62,.T.);\n")
        CAD_IO.WriteStr(fd, "#83 = EDGE_CURVE('',#24,#21,#63,.T.);\n")
        CAD_IO.WriteStr(fd, "#84 = EDGE_CURVE('',#25,#26,#64,.T.);\n")
        CAD_IO.WriteStr(fd, "#85 = EDGE_CURVE('',#26,#27,#65,.T.);\n")
        CAD_IO.WriteStr(fd, "#86 = EDGE_CURVE('',#27,#28,#66,.T.);\n")
        CAD_IO.WriteStr(fd, "#87 = EDGE_CURVE('',#28,#25,#67,.T.);\n")
        CAD_IO.WriteStr(fd, "#88 = EDGE_CURVE('',#21,#25,#68,.T.);\n")
        CAD_IO.WriteStr(fd, "#89 = EDGE_CURVE('',#22,#26,#69,.T.);\n")
        CAD_IO.WriteStr(fd, "#90 = EDGE_CURVE('',#23,#27,#70,.T.);\n")
        CAD_IO.WriteStr(fd, "#91 = EDGE_CURVE('',#24,#28,#71,.T.);\n")

        CAD_IO.WriteStr(fd, "#200 = ORIENTED_EDGE('',*,*,#80,.T.);\n")
        CAD_IO.WriteStr(fd, "#201 = ORIENTED_EDGE('',*,*,#81,.T.);\n")
        CAD_IO.WriteStr(fd, "#202 = ORIENTED_EDGE('',*,*,#82,.T.);\n")
        CAD_IO.WriteStr(fd, "#203 = ORIENTED_EDGE('',*,*,#83,.T.);\n")
        CAD_IO.WriteStr(fd, "#204 = ORIENTED_EDGE('',*,*,#84,.T.);\n")
        CAD_IO.WriteStr(fd, "#205 = ORIENTED_EDGE('',*,*,#85,.T.);\n")
        CAD_IO.WriteStr(fd, "#206 = ORIENTED_EDGE('',*,*,#86,.T.);\n")
        CAD_IO.WriteStr(fd, "#207 = ORIENTED_EDGE('',*,*,#87,.T.);\n")
        CAD_IO.WriteStr(fd, "#208 = ORIENTED_EDGE('',*,*,#80,.F.);\n")
        CAD_IO.WriteStr(fd, "#209 = ORIENTED_EDGE('',*,*,#89,.T.);\n")
        CAD_IO.WriteStr(fd, "#210 = ORIENTED_EDGE('',*,*,#84,.F.);\n")
        CAD_IO.WriteStr(fd, "#211 = ORIENTED_EDGE('',*,*,#88,.F.);\n")
        CAD_IO.WriteStr(fd, "#212 = ORIENTED_EDGE('',*,*,#81,.F.);\n")
        CAD_IO.WriteStr(fd, "#213 = ORIENTED_EDGE('',*,*,#90,.T.);\n")
        CAD_IO.WriteStr(fd, "#214 = ORIENTED_EDGE('',*,*,#85,.F.);\n")
        CAD_IO.WriteStr(fd, "#215 = ORIENTED_EDGE('',*,*,#89,.F.);\n")
        CAD_IO.WriteStr(fd, "#216 = ORIENTED_EDGE('',*,*,#82,.F.);\n")
        CAD_IO.WriteStr(fd, "#217 = ORIENTED_EDGE('',*,*,#91,.T.);\n")
        CAD_IO.WriteStr(fd, "#218 = ORIENTED_EDGE('',*,*,#86,.F.);\n")
        CAD_IO.WriteStr(fd, "#219 = ORIENTED_EDGE('',*,*,#90,.F.);\n")
        CAD_IO.WriteStr(fd, "#220 = ORIENTED_EDGE('',*,*,#83,.F.);\n")
        CAD_IO.WriteStr(fd, "#221 = ORIENTED_EDGE('',*,*,#88,.T.);\n")
        CAD_IO.WriteStr(fd, "#222 = ORIENTED_EDGE('',*,*,#87,.F.);\n")
        CAD_IO.WriteStr(fd, "#223 = ORIENTED_EDGE('',*,*,#91,.F.);\n")

        CAD_IO.WriteStr(fd, "#300 = EDGE_LOOP('',(#200,#201,#202,#203));\n")
        CAD_IO.WriteStr(fd, "#301 = EDGE_LOOP('',(#207,#206,#205,#204));\n")
        CAD_IO.WriteStr(fd, "#302 = EDGE_LOOP('',(#208,#209,#210,#211));\n")
        CAD_IO.WriteStr(fd, "#303 = EDGE_LOOP('',(#212,#213,#214,#215));\n")
        CAD_IO.WriteStr(fd, "#304 = EDGE_LOOP('',(#216,#217,#218,#219));\n")
        CAD_IO.WriteStr(fd, "#305 = EDGE_LOOP('',(#220,#221,#222,#223));\n")
        CAD_IO.WriteStr(fd, "#310 = FACE_OUTER_BOUND('',#300,.T.);\n")
        CAD_IO.WriteStr(fd, "#312 = FACE_OUTER_BOUND('',#301,.T.);\n")
        CAD_IO.WriteStr(fd, "#314 = FACE_OUTER_BOUND('',#302,.T.);\n")
        CAD_IO.WriteStr(fd, "#315 = FACE_OUTER_BOUND('',#303,.T.);\n")
        CAD_IO.WriteStr(fd, "#316 = FACE_OUTER_BOUND('',#304,.T.);\n")
        CAD_IO.WriteStr(fd, "#317 = FACE_OUTER_BOUND('',#305,.T.);\n")

        CAD_IO.WriteStr(fd, "#320 = AXIS2_PLACEMENT_3D('',#1,#43,#40);\n")
        CAD_IO.WriteStr(fd, "#321 = AXIS2_PLACEMENT_3D('',#5,#42,#40);\n")
        CAD_IO.WriteStr(fd, "#322 = AXIS2_PLACEMENT_3D('',#1,#45,#40);\n")
        CAD_IO.WriteStr(fd, "#323 = AXIS2_PLACEMENT_3D('',#2,#40,#41);\n")
        CAD_IO.WriteStr(fd, "#324 = AXIS2_PLACEMENT_3D('',#3,#41,#44);\n")
        CAD_IO.WriteStr(fd, "#325 = AXIS2_PLACEMENT_3D('',#4,#44,#45);\n")
        CAD_IO.WriteStr(fd, "#330 = PLANE('',#320);\n")
        CAD_IO.WriteStr(fd, "#331 = PLANE('',#321);\n")
        CAD_IO.WriteStr(fd, "#332 = PLANE('',#322);\n")
        CAD_IO.WriteStr(fd, "#333 = PLANE('',#323);\n")
        CAD_IO.WriteStr(fd, "#334 = PLANE('',#324);\n")
        CAD_IO.WriteStr(fd, "#335 = PLANE('',#325);\n")

        // face id lists for shell: sides always, top, bottom, walls, floors
        // shell_ids packed: store face entity ids, nfaces
        sids = Allocate(256)
        ns = 0
        // sides
        CAD_IO.WriteStr(fd, "#342 = ADVANCED_FACE('',(#314),#332,.T.);\n")
        CAD_IO.WriteStr(fd, "#343 = ADVANCED_FACE('',(#315),#333,.T.);\n")
        CAD_IO.WriteStr(fd, "#344 = ADVANCED_FACE('',(#316),#334,.T.);\n")
        CAD_IO.WriteStr(fd, "#345 = ADVANCED_FACE('',(#317),#335,.T.);\n")
        ArraySet(sids, 0, 342)
        ArraySet(sids, 1, 343)
        ArraySet(sids, 2, 344)
        ArraySet(sids, 3, 345)
        ns = 4

        // per-hole geometry; top bounds list and bottom bounds list
        top_bounds = Allocate(128)
        bot_bounds = Allocate(128)
        ntopb = 0
        nbotb = 0
        // outer bounds always first for faces
        ArraySet(top_bounds, 0, 312)
        ntopb = 1
        ArraySet(bot_bounds, 0, 310)
        nbotb = 1

        hi = 0
        WhileLoop LessThan(hi, nh) {
            IfCondition EqualTo(hi, 0) ThenBlock: {
                hr = CAD_Store.Read(params_h, 3)
                cx = CAD_Store.Read(params_h, 4)
                cy = CAD_Store.Read(params_h, 5)
                hdep = CAD_Store.Read(params_h, 8)
            }
            IfCondition GreaterThan(hi, 0) ThenBlock: {
                pb = Add(10, Multiply(Subtract(hi, 1), 4))
                hr = CAD_Store.Read(params_h, pb)
                cx = CAD_Store.Read(params_h, Add(pb, 1))
                cy = CAD_Store.Read(params_h, Add(pb, 2))
                hdep = CAD_Store.Read(params_h, Add(pb, 3))
            }
            IfCondition EqualTo(CAD_Num.IsZero(hdep, 0), 1) ThenBlock: { hdep = dz }
            IfCondition EqualTo(Float_Le(dz, hdep), 1) ThenBlock: { hdep = dz }
            z_floor = Float_Sub(dz, hdep)
            through = 0
            IfCondition EqualTo(CAD_Num.IsEqual(hdep, dz, 0), 1) ThenBlock: { through = 1 }
            cx = Float_Add(ox, cx)
            cy = Float_Add(oy, cy)
            B = Add(1000, Multiply(hi, 80))
            // points B+0 floor ctr, B+1 top ctr, B+2 seam fl, B+3 seam top
            CAD_IO.WriteId(fd, B)
            CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
            CAD_IO.WriteFloat(fd, cx)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, cy)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, z_floor)
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(B, 1))
            CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
            CAD_IO.WriteFloat(fd, cx)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, cy)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, dz)
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(B, 2))
            CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
            CAD_IO.WriteFloat(fd, Float_Add(cx, hr))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, cy)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, z_floor)
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(B, 3))
            CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
            CAD_IO.WriteFloat(fd, Float_Add(cx, hr))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, cy)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, dz)
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(B, 4))
            CAD_IO.WriteStr(fd, " = VERTEX_POINT('',#")
            s = NumberToString(Add(B, 2))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            CAD_IO.WriteId(fd, Add(B, 5))
            CAD_IO.WriteStr(fd, " = VERTEX_POINT('',#")
            s = NumberToString(Add(B, 3))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            CAD_IO.WriteId(fd, Add(B, 6))
            CAD_IO.WriteStr(fd, " = AXIS2_PLACEMENT_3D('',#")
            s = NumberToString(B)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#42,#40);\n")
            CAD_IO.WriteId(fd, Add(B, 7))
            CAD_IO.WriteStr(fd, " = AXIS2_PLACEMENT_3D('',#")
            s = NumberToString(Add(B, 1))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#42,#40);\n")
            CAD_IO.WriteId(fd, Add(B, 8))
            CAD_IO.WriteStr(fd, " = CIRCLE('',#")
            s = NumberToString(Add(B, 6))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, hr)
            CAD_IO.WriteStr(fd, ");\n")
            CAD_IO.WriteId(fd, Add(B, 9))
            CAD_IO.WriteStr(fd, " = CIRCLE('',#")
            s = NumberToString(Add(B, 7))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, hr)
            CAD_IO.WriteStr(fd, ");\n")
            CAD_IO.WriteId(fd, Add(B, 10))
            CAD_IO.WriteStr(fd, " = LINE('',#")
            s = NumberToString(Add(B, 2))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#52);\n")
            CAD_IO.WriteId(fd, Add(B, 11))
            CAD_IO.WriteStr(fd, " = CYLINDRICAL_SURFACE('',#")
            s = NumberToString(Add(B, 6))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, hr)
            CAD_IO.WriteStr(fd, ");\n")
            // edges
            CAD_IO.WriteId(fd, Add(B, 12))
            CAD_IO.WriteStr(fd, " = EDGE_CURVE('',#")
            s = NumberToString(Add(B, 4))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(B, 8))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            CAD_IO.WriteId(fd, Add(B, 13))
            CAD_IO.WriteStr(fd, " = EDGE_CURVE('',#")
            s = NumberToString(Add(B, 5))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(B, 9))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            CAD_IO.WriteId(fd, Add(B, 14))
            CAD_IO.WriteStr(fd, " = EDGE_CURVE('',#")
            s = NumberToString(Add(B, 4))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(B, 5))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(B, 10))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            // OE
            CAD_IO.WriteId(fd, Add(B, 15))
            CAD_IO.WriteStr(fd, " = ORIENTED_EDGE('',*,*,#")
            s = NumberToString(Add(B, 12))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            CAD_IO.WriteId(fd, Add(B, 16))
            CAD_IO.WriteStr(fd, " = ORIENTED_EDGE('',*,*,#")
            s = NumberToString(Add(B, 12))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.F.);\n")
            CAD_IO.WriteId(fd, Add(B, 17))
            CAD_IO.WriteStr(fd, " = ORIENTED_EDGE('',*,*,#")
            s = NumberToString(Add(B, 13))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            CAD_IO.WriteId(fd, Add(B, 18))
            CAD_IO.WriteStr(fd, " = ORIENTED_EDGE('',*,*,#")
            s = NumberToString(Add(B, 13))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.F.);\n")
            CAD_IO.WriteId(fd, Add(B, 19))
            CAD_IO.WriteStr(fd, " = ORIENTED_EDGE('',*,*,#")
            s = NumberToString(Add(B, 14))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            CAD_IO.WriteId(fd, Add(B, 20))
            CAD_IO.WriteStr(fd, " = ORIENTED_EDGE('',*,*,#")
            s = NumberToString(Add(B, 14))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.F.);\n")
            // wall loop
            CAD_IO.WriteId(fd, Add(B, 21))
            CAD_IO.WriteStr(fd, " = EDGE_LOOP('',(#")
            s = NumberToString(Add(B, 15))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(B, 19))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(B, 18))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(B, 20))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(B, 22))
            CAD_IO.WriteStr(fd, " = FACE_OUTER_BOUND('',#")
            s = NumberToString(Add(B, 21))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            CAD_IO.WriteId(fd, Add(B, 23))
            CAD_IO.WriteStr(fd, " = ADVANCED_FACE('',(#")
            s = NumberToString(Add(B, 22))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, "),#")
            s = NumberToString(Add(B, 11))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            ArraySet(sids, ns, Add(B, 23))
            ns = Add(ns, 1)
            // top hole bound (inner)
            CAD_IO.WriteId(fd, Add(B, 24))
            CAD_IO.WriteStr(fd, " = EDGE_LOOP('',(#")
            s = NumberToString(Add(B, 17))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(B, 25))
            CAD_IO.WriteStr(fd, " = FACE_BOUND('',#")
            s = NumberToString(Add(B, 24))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            ArraySet(top_bounds, ntopb, Add(B, 25))
            ntopb = Add(ntopb, 1)
            // bottom: through → hole bound; blind → floor face
            IfCondition EqualTo(through, 1) ThenBlock: {
                CAD_IO.WriteId(fd, Add(B, 26))
                CAD_IO.WriteStr(fd, " = EDGE_LOOP('',(#")
                s = NumberToString(Add(B, 16))
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, "));\n")
                CAD_IO.WriteId(fd, Add(B, 27))
                CAD_IO.WriteStr(fd, " = FACE_BOUND('',#")
                s = NumberToString(Add(B, 26))
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",.T.);\n")
                ArraySet(bot_bounds, nbotb, Add(B, 27))
                nbotb = Add(nbotb, 1)
            }
            IfCondition EqualTo(through, 0) ThenBlock: {
                // floor disk
                CAD_IO.WriteId(fd, Add(B, 28))
                CAD_IO.WriteStr(fd, " = AXIS2_PLACEMENT_3D('',#")
                s = NumberToString(B)
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",#42,#40);\n")
                CAD_IO.WriteId(fd, Add(B, 29))
                CAD_IO.WriteStr(fd, " = PLANE('',#")
                s = NumberToString(Add(B, 28))
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ");\n")
                CAD_IO.WriteId(fd, Add(B, 30))
                CAD_IO.WriteStr(fd, " = EDGE_LOOP('',(#")
                s = NumberToString(Add(B, 16))
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, "));\n")
                CAD_IO.WriteId(fd, Add(B, 31))
                CAD_IO.WriteStr(fd, " = FACE_OUTER_BOUND('',#")
                s = NumberToString(Add(B, 30))
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",.T.);\n")
                CAD_IO.WriteId(fd, Add(B, 32))
                CAD_IO.WriteStr(fd, " = ADVANCED_FACE('',(#")
                s = NumberToString(Add(B, 31))
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, "),#")
                s = NumberToString(Add(B, 29))
                CAD_IO.WriteStr(fd, s)
                CAD_IO.WriteStr(fd, ",.T.);\n")
                ArraySet(sids, ns, Add(B, 32))
                ns = Add(ns, 1)
            }
            hi = Add(hi, 1)
        }

        // top face #341
        CAD_IO.WriteStr(fd, "#341 = ADVANCED_FACE('',(")
        i = 0
        WhileLoop LessThan(i, ntopb) {
            IfCondition GreaterThan(i, 0) ThenBlock: { CAD_IO.WriteStr(fd, ",") }
            CAD_IO.WriteStr(fd, "#")
            s = NumberToString(ArrayGet(top_bounds, i))
            CAD_IO.WriteStr(fd, s)
            i = Add(i, 1)
        }
        CAD_IO.WriteStr(fd, "),#331,.T.);\n")
        ArraySet(sids, ns, 341)
        ns = Add(ns, 1)

        // bottom face #340
        CAD_IO.WriteStr(fd, "#340 = ADVANCED_FACE('',(")
        i = 0
        WhileLoop LessThan(i, nbotb) {
            IfCondition GreaterThan(i, 0) ThenBlock: { CAD_IO.WriteStr(fd, ",") }
            CAD_IO.WriteStr(fd, "#")
            s = NumberToString(ArrayGet(bot_bounds, i))
            CAD_IO.WriteStr(fd, s)
            i = Add(i, 1)
        }
        CAD_IO.WriteStr(fd, "),#330,.T.);\n")
        ArraySet(sids, ns, 340)
        ns = Add(ns, 1)

        // shell
        CAD_IO.WriteStr(fd, "#120 = CLOSED_SHELL('',(")
        i = 0
        WhileLoop LessThan(i, ns) {
            IfCondition GreaterThan(i, 0) ThenBlock: { CAD_IO.WriteStr(fd, ",") }
            CAD_IO.WriteStr(fd, "#")
            s = NumberToString(ArrayGet(sids, i))
            CAD_IO.WriteStr(fd, s)
            i = Add(i, 1)
        }
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\nEND-ISO-10303-21;\n")
        Deallocate(sids, 256)
        Deallocate(top_bounds, 128)
        Deallocate(bot_bounds, 128)
        ReturnValue(0)
    }
}

// Faceted STEP from mesh buffer (legacy / optional). Each tri → plane face.
Function.CAD_IO.WriteMeshSTEP {
    Input: fd: Integer
    Input: mesh_addr: Address
    Output: Integer
    Body: {
        nv = ArrayGet(mesh_addr, 0)
        nt = ArrayGet(mesh_addr, 1)
        vb = ArrayGet(mesh_addr, 2)
        ib = ArrayGet(mesh_addr, 3)
        IfCondition LessThan(nv, 3) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(nt, 1) ThenBlock: { ReturnValue(-1) }
        // cap entity count for safety
        IfCondition GreaterThan(nt, 8000) ThenBlock: { nt = 8000 }

        CAD_IO.WriteStr(fd, "ISO-10303-21;\nHEADER;\n")
        CAD_IO.WriteStr(fd, "FILE_DESCRIPTION(('AILang mesh solid'),'2;1');\n")
        CAD_IO.WriteStr(fd, "FILE_NAME('ailang_mesh.stp','2026-08-05T00:00:00',('AILang'),('2 Paws Machine'),'AILang CAD Engine','AILang CAD Engine','');\n")
        CAD_IO.WriteStr(fd, "FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\nDATA;\n")
        CAD_IO.WriteStr(fd, "#100 = APPLICATION_CONTEXT('automotive design');\n")
        CAD_IO.WriteStr(fd, "#101 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#100);\n")
        CAD_IO.WriteStr(fd, "#102 = PRODUCT('mesh_solid','mesh_solid','',(#103));\n")
        CAD_IO.WriteStr(fd, "#103 = PRODUCT_CONTEXT('',#100,'mechanical');\n")
        CAD_IO.WriteStr(fd, "#104 = PRODUCT_DEFINITION_FORMATION('','',#102);\n")
        CAD_IO.WriteStr(fd, "#105 = PRODUCT_DEFINITION('design','',#104,#106);\n")
        CAD_IO.WriteStr(fd, "#106 = PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');\n")
        CAD_IO.WriteStr(fd, "#107 = PRODUCT_DEFINITION_SHAPE('','',#105);\n")
        CAD_IO.WriteStr(fd, "#108 = SHAPE_DEFINITION_REPRESENTATION(#107,#109);\n")
        CAD_IO.WriteStr(fd, "#109 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#110),#111);\n")
        CAD_IO.WriteStr(fd, "#110 = MANIFOLD_SOLID_BREP('MeshSolid',#120);\n")
        CAD_IO.WriteStr(fd, "#111 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#112)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#113,#114,#115)) REPRESENTATION_CONTEXT('Context3D','3D Context') );\n")
        CAD_IO.WriteStr(fd, "#112 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#113,'distance_accuracy_value','confusion accuracy');\n")
        CAD_IO.WriteStr(fd, "#113 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );\n")
        CAD_IO.WriteStr(fd, "#114 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT(*,.RADIAN.) );\n")
        CAD_IO.WriteStr(fd, "#115 = ( NAMED_UNIT(*) SI_UNIT(*,.STERADIAN.) SOLID_ANGLE_UNIT() );\n")

        // points #10001+i, verts #20001+i
        i = 0
        WhileLoop LessThan(i, nv) {
            pid = Add(10001, i)
            CAD_IO.WriteId(fd, pid)
            CAD_IO.WriteStr(fd, " = CARTESIAN_POINT('',(")
            CAD_IO.WriteFloat(fd, ArrayGet(vb, Multiply(i, 3)))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, ArrayGet(vb, Add(Multiply(i, 3), 1)))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, ArrayGet(vb, Add(Multiply(i, 3), 2)))
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(20001, i))
            CAD_IO.WriteStr(fd, " = VERTEX_POINT('',#")
            s = NumberToString(pid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            i = Add(i, 1)
        }

        // each tri: full local graph, bid = 30000 + ti*30, face at bid+21
        shell_list = Allocate(131072)
        ti = 0
        WhileLoop LessThan(ti, nt) {
            i0 = ArrayGet(ib, Multiply(ti, 3))
            i1 = ArrayGet(ib, Add(Multiply(ti, 3), 1))
            i2 = ArrayGet(ib, Add(Multiply(ti, 3), 2))
            bid = Add(30000, Multiply(ti, 30))
            // directions from edges for plane normal
            x0 = ArrayGet(vb, Multiply(i0, 3))
            y0 = ArrayGet(vb, Add(Multiply(i0, 3), 1))
            z0 = ArrayGet(vb, Add(Multiply(i0, 3), 2))
            x1 = ArrayGet(vb, Multiply(i1, 3))
            y1 = ArrayGet(vb, Add(Multiply(i1, 3), 1))
            z1 = ArrayGet(vb, Add(Multiply(i1, 3), 2))
            x2 = ArrayGet(vb, Multiply(i2, 3))
            y2 = ArrayGet(vb, Add(Multiply(i2, 3), 1))
            z2 = ArrayGet(vb, Add(Multiply(i2, 3), 2))
            e1x = Float_Sub(x1, x0)
            e1y = Float_Sub(y1, y0)
            e1z = Float_Sub(z1, z0)
            e2x = Float_Sub(x2, x0)
            e2y = Float_Sub(y2, y0)
            e2z = Float_Sub(z2, z0)
            // n = e1 × e2
            nx = Float_Sub(Float_Mul(e1y, e2z), Float_Mul(e1z, e2y))
            ny = Float_Sub(Float_Mul(e1z, e2x), Float_Mul(e1x, e2z))
            nz = Float_Sub(Float_Mul(e1x, e2y), Float_Mul(e1y, e2x))
            // normalize roughly for STEP (not required exact)
            // line dirs + vectors + lines for 3 edges
            // bid+0 dir e1, bid+1 vec, bid+2 line
            CAD_IO.WriteId(fd, bid)
            CAD_IO.WriteStr(fd, " = DIRECTION('',(")
            CAD_IO.WriteFloat(fd, e1x)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, e1y)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, e1z)
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(bid, 1))
            CAD_IO.WriteStr(fd, " = VECTOR('',#")
            s = NumberToString(bid)
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",1.);\n")
            CAD_IO.WriteId(fd, Add(bid, 2))
            CAD_IO.WriteStr(fd, " = LINE('',#")
            s = NumberToString(Add(10001, i0))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(bid, 1))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            // e2 for edge 1
            CAD_IO.WriteId(fd, Add(bid, 3))
            CAD_IO.WriteStr(fd, " = DIRECTION('',(")
            CAD_IO.WriteFloat(fd, Float_Sub(x2, x1))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, Float_Sub(y2, y1))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, Float_Sub(z2, z1))
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(bid, 4))
            CAD_IO.WriteStr(fd, " = VECTOR('',#")
            s = NumberToString(Add(bid, 3))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",1.);\n")
            CAD_IO.WriteId(fd, Add(bid, 5))
            CAD_IO.WriteStr(fd, " = LINE('',#")
            s = NumberToString(Add(10001, i1))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(bid, 4))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            // edge 2: i2→i0
            CAD_IO.WriteId(fd, Add(bid, 6))
            CAD_IO.WriteStr(fd, " = DIRECTION('',(")
            CAD_IO.WriteFloat(fd, Float_Sub(x0, x2))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, Float_Sub(y0, y2))
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, Float_Sub(z0, z2))
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(bid, 7))
            CAD_IO.WriteStr(fd, " = VECTOR('',#")
            s = NumberToString(Add(bid, 6))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",1.);\n")
            CAD_IO.WriteId(fd, Add(bid, 8))
            CAD_IO.WriteStr(fd, " = LINE('',#")
            s = NumberToString(Add(10001, i2))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(bid, 7))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            // EDGE_CURVEs
            CAD_IO.WriteId(fd, Add(bid, 9))
            CAD_IO.WriteStr(fd, " = EDGE_CURVE('',#")
            s = NumberToString(Add(20001, i0))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(20001, i1))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(bid, 2))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            CAD_IO.WriteId(fd, Add(bid, 10))
            CAD_IO.WriteStr(fd, " = EDGE_CURVE('',#")
            s = NumberToString(Add(20001, i1))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(20001, i2))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(bid, 5))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            CAD_IO.WriteId(fd, Add(bid, 11))
            CAD_IO.WriteStr(fd, " = EDGE_CURVE('',#")
            s = NumberToString(Add(20001, i2))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(20001, i0))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(bid, 8))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            // ORIENTED_EDGE
            CAD_IO.WriteId(fd, Add(bid, 12))
            CAD_IO.WriteStr(fd, " = ORIENTED_EDGE('',*,*,#")
            s = NumberToString(Add(bid, 9))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            CAD_IO.WriteId(fd, Add(bid, 13))
            CAD_IO.WriteStr(fd, " = ORIENTED_EDGE('',*,*,#")
            s = NumberToString(Add(bid, 10))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            CAD_IO.WriteId(fd, Add(bid, 14))
            CAD_IO.WriteStr(fd, " = ORIENTED_EDGE('',*,*,#")
            s = NumberToString(Add(bid, 11))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            CAD_IO.WriteId(fd, Add(bid, 15))
            CAD_IO.WriteStr(fd, " = EDGE_LOOP('',(#")
            s = NumberToString(Add(bid, 12))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(bid, 13))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(bid, 14))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(bid, 16))
            CAD_IO.WriteStr(fd, " = FACE_OUTER_BOUND('',#")
            s = NumberToString(Add(bid, 15))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            // plane normal
            CAD_IO.WriteId(fd, Add(bid, 17))
            CAD_IO.WriteStr(fd, " = DIRECTION('',(")
            CAD_IO.WriteFloat(fd, nx)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, ny)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, nz)
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(bid, 18))
            CAD_IO.WriteStr(fd, " = DIRECTION('',(")
            CAD_IO.WriteFloat(fd, e1x)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, e1y)
            CAD_IO.WriteStr(fd, ",")
            CAD_IO.WriteFloat(fd, e1z)
            CAD_IO.WriteStr(fd, "));\n")
            CAD_IO.WriteId(fd, Add(bid, 19))
            CAD_IO.WriteStr(fd, " = AXIS2_PLACEMENT_3D('',#")
            s = NumberToString(Add(10001, i0))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(bid, 17))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",#")
            s = NumberToString(Add(bid, 18))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            CAD_IO.WriteId(fd, Add(bid, 20))
            CAD_IO.WriteStr(fd, " = PLANE('',#")
            s = NumberToString(Add(bid, 19))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ");\n")
            fid = Add(bid, 21)
            CAD_IO.WriteId(fd, fid)
            CAD_IO.WriteStr(fd, " = ADVANCED_FACE('',(#")
            s = NumberToString(Add(bid, 16))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, "),#")
            s = NumberToString(Add(bid, 20))
            CAD_IO.WriteStr(fd, s)
            CAD_IO.WriteStr(fd, ",.T.);\n")
            ArraySet(shell_list, ti, fid)
            ti = Add(ti, 1)
        }
        // CLOSED_SHELL with all faces
        CAD_IO.WriteStr(fd, "#120 = CLOSED_SHELL('',(")
        ti = 0
        WhileLoop LessThan(ti, nt) {
            IfCondition GreaterThan(ti, 0) ThenBlock: { CAD_IO.WriteStr(fd, ",") }
            CAD_IO.WriteStr(fd, "#")
            s = NumberToString(ArrayGet(shell_list, ti))
            CAD_IO.WriteStr(fd, s)
            ti = Add(ti, 1)
        }
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\nEND-ISO-10303-21;\n")
        Deallocate(shell_list, 131072)
        ReturnValue(0)
    }
}

// Plate [0,dx]×[0,dy]×[0,dz] with cylindrical hole (params slab).
// params[8]=hole_depth: ≈dz → through; else blind pocket from top (z=dz down to z_floor).
// params[9]=n_holes: >1 → faceted multi-hole STEP from mesh.
// Through: top+bottom annulus + full-height CYLINDRICAL_SURFACE.
// Blind: solid bottom, top annulus, cyl z_floor→dz, floor disk PLANE at z_floor.
Function.CAD_IO.WriteBoxThroughHoleSTEP {
    Input: fd: Integer
    Input: params_h: Integer
    Output: Integer
    Body: {
        nh = CAD_Store.Read(params_h, 9)
        IfCondition GreaterThan(nh, 1) ThenBlock: {
            ReturnValue(CAD_IO.WriteBoxMultiHoleSTEP(fd, params_h))
        }
        dx = CAD_Store.Read(params_h, 0)
        dy = CAD_Store.Read(params_h, 1)
        dz = CAD_Store.Read(params_h, 2)
        hr = CAD_Store.Read(params_h, 3)
        cx = CAD_Store.Read(params_h, 4)
        cy = CAD_Store.Read(params_h, 5)
        ox = CAD_Store.Read(params_h, 6)
        oy = CAD_Store.Read(params_h, 7)
        hdep = CAD_Store.Read(params_h, 8)
        IfCondition EqualTo(CAD_Num.IsZero(hdep, 0), 1) ThenBlock: { hdep = dz }
        IfCondition EqualTo(Float_Le(dz, hdep), 1) ThenBlock: { hdep = dz }
        z_floor = Float_Sub(dz, hdep)
        through = 0
        IfCondition EqualTo(CAD_Num.IsEqual(hdep, dz, 0), 1) ThenBlock: { through = 1 }
        // world plate: [ox,ox+dx]×[oy,oy+dy]; hole at (ox+cx, oy+cy)
        x0 = ox
        y0 = oy
        x1 = Float_Add(ox, dx)
        y1 = Float_Add(oy, dy)
        hx = Float_Add(ox, cx)
        hy = Float_Add(oy, cy)

        CAD_IO.WriteStr(fd, "ISO-10303-21;\nHEADER;\n")
        CAD_IO.WriteStr(fd, "FILE_DESCRIPTION(('AILang plate with hole'),'2;1');\n")
        CAD_IO.WriteStr(fd, "FILE_NAME('ailang_plate_hole.stp','2026-08-05T00:00:00',('AILang'),('2 Paws Machine'),'AILang CAD Engine','AILang CAD Engine','');\n")
        CAD_IO.WriteStr(fd, "FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\nDATA;\n")
        CAD_IO.WriteStr(fd, "#100 = APPLICATION_CONTEXT('automotive design');\n")
        CAD_IO.WriteStr(fd, "#101 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#100);\n")
        CAD_IO.WriteStr(fd, "#102 = PRODUCT('plate_hole','plate_hole','',(#103));\n")
        CAD_IO.WriteStr(fd, "#103 = PRODUCT_CONTEXT('',#100,'mechanical');\n")
        CAD_IO.WriteStr(fd, "#104 = PRODUCT_DEFINITION_FORMATION('','',#102);\n")
        CAD_IO.WriteStr(fd, "#105 = PRODUCT_DEFINITION('design','',#104,#106);\n")
        CAD_IO.WriteStr(fd, "#106 = PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');\n")
        CAD_IO.WriteStr(fd, "#107 = PRODUCT_DEFINITION_SHAPE('','',#105);\n")
        CAD_IO.WriteStr(fd, "#108 = SHAPE_DEFINITION_REPRESENTATION(#107,#109);\n")
        CAD_IO.WriteStr(fd, "#109 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#110),#111);\n")
        CAD_IO.WriteStr(fd, "#110 = MANIFOLD_SOLID_BREP('PlateHole',#120);\n")
        CAD_IO.WriteStr(fd, "#111 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#112)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#113,#114,#115)) REPRESENTATION_CONTEXT('Context3D','3D Context') );\n")
        CAD_IO.WriteStr(fd, "#112 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#113,'distance_accuracy_value','confusion accuracy');\n")
        CAD_IO.WriteStr(fd, "#113 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );\n")
        CAD_IO.WriteStr(fd, "#114 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT(*,.RADIAN.) );\n")
        CAD_IO.WriteStr(fd, "#115 = ( NAMED_UNIT(*) SI_UNIT(*,.STERADIAN.) SOLID_ANGLE_UNIT() );\n")

        // Box corners #1..#8; hole floor/top centers #9/#10; seam #11/#12 at z_floor and dz
        CAD_IO.WriteStr(fd, "#1 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#2 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#3 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#4 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",0.));\n")
        CAD_IO.WriteStr(fd, "#5 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#6 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#7 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#8 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, x0)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, y1)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        // hole axis floor (z_floor) + top (dz); seam on +X of circle
        CAD_IO.WriteStr(fd, "#9 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, hx)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, hy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, z_floor)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#10 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, hx)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, hy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#11 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, Float_Add(hx, hr))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, hy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, z_floor)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#12 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, Float_Add(hx, hr))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, hy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, dz)
        CAD_IO.WriteStr(fd, "));\n")

        CAD_IO.WriteStr(fd, "#21 = VERTEX_POINT('',#1);\n")
        CAD_IO.WriteStr(fd, "#22 = VERTEX_POINT('',#2);\n")
        CAD_IO.WriteStr(fd, "#23 = VERTEX_POINT('',#3);\n")
        CAD_IO.WriteStr(fd, "#24 = VERTEX_POINT('',#4);\n")
        CAD_IO.WriteStr(fd, "#25 = VERTEX_POINT('',#5);\n")
        CAD_IO.WriteStr(fd, "#26 = VERTEX_POINT('',#6);\n")
        CAD_IO.WriteStr(fd, "#27 = VERTEX_POINT('',#7);\n")
        CAD_IO.WriteStr(fd, "#28 = VERTEX_POINT('',#8);\n")
        CAD_IO.WriteStr(fd, "#29 = VERTEX_POINT('',#11);\n")
        CAD_IO.WriteStr(fd, "#30 = VERTEX_POINT('',#12);\n")

        CAD_IO.WriteStr(fd, "#40 = DIRECTION('',(1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#41 = DIRECTION('',(0.,1.,0.));\n")
        CAD_IO.WriteStr(fd, "#42 = DIRECTION('',(0.,0.,1.));\n")
        CAD_IO.WriteStr(fd, "#43 = DIRECTION('',(0.,0.,-1.));\n")
        CAD_IO.WriteStr(fd, "#44 = DIRECTION('',(-1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#45 = DIRECTION('',(0.,-1.,0.));\n")

        CAD_IO.WriteStr(fd, "#50 = VECTOR('',#40,1.);\n")
        CAD_IO.WriteStr(fd, "#51 = VECTOR('',#41,1.);\n")
        CAD_IO.WriteStr(fd, "#52 = VECTOR('',#42,1.);\n")
        CAD_IO.WriteStr(fd, "#53 = VECTOR('',#44,1.);\n")
        CAD_IO.WriteStr(fd, "#54 = VECTOR('',#45,1.);\n")

        // outer bottom edges
        CAD_IO.WriteStr(fd, "#60 = LINE('',#1,#50);\n")
        CAD_IO.WriteStr(fd, "#61 = LINE('',#2,#51);\n")
        CAD_IO.WriteStr(fd, "#62 = LINE('',#3,#53);\n")
        CAD_IO.WriteStr(fd, "#63 = LINE('',#4,#54);\n")
        // outer top
        CAD_IO.WriteStr(fd, "#64 = LINE('',#5,#50);\n")
        CAD_IO.WriteStr(fd, "#65 = LINE('',#6,#51);\n")
        CAD_IO.WriteStr(fd, "#66 = LINE('',#7,#53);\n")
        CAD_IO.WriteStr(fd, "#67 = LINE('',#8,#54);\n")
        // verticals
        CAD_IO.WriteStr(fd, "#68 = LINE('',#1,#52);\n")
        CAD_IO.WriteStr(fd, "#69 = LINE('',#2,#52);\n")
        CAD_IO.WriteStr(fd, "#70 = LINE('',#3,#52);\n")
        CAD_IO.WriteStr(fd, "#71 = LINE('',#4,#52);\n")
        // hole: floor circle at z_floor, top circle at dz, seam, cylinder
        CAD_IO.WriteStr(fd, "#72 = AXIS2_PLACEMENT_3D('',#9,#42,#40);\n")
        CAD_IO.WriteStr(fd, "#73 = AXIS2_PLACEMENT_3D('',#10,#42,#40);\n")
        CAD_IO.WriteStr(fd, "#74 = CIRCLE('',#72,")
        CAD_IO.WriteFloat(fd, hr)
        CAD_IO.WriteStr(fd, ");\n")
        CAD_IO.WriteStr(fd, "#75 = CIRCLE('',#73,")
        CAD_IO.WriteFloat(fd, hr)
        CAD_IO.WriteStr(fd, ");\n")
        CAD_IO.WriteStr(fd, "#76 = LINE('',#11,#52);\n")
        CAD_IO.WriteStr(fd, "#77 = CYLINDRICAL_SURFACE('',#72,")
        CAD_IO.WriteFloat(fd, hr)
        CAD_IO.WriteStr(fd, ");\n")

        // EDGE_CURVEs outer bottom 80-83, top 84-87, verts 88-91, hole circles 92-93, seam 94
        CAD_IO.WriteStr(fd, "#80 = EDGE_CURVE('',#21,#22,#60,.T.);\n")
        CAD_IO.WriteStr(fd, "#81 = EDGE_CURVE('',#22,#23,#61,.T.);\n")
        CAD_IO.WriteStr(fd, "#82 = EDGE_CURVE('',#23,#24,#62,.T.);\n")
        CAD_IO.WriteStr(fd, "#83 = EDGE_CURVE('',#24,#21,#63,.T.);\n")
        CAD_IO.WriteStr(fd, "#84 = EDGE_CURVE('',#25,#26,#64,.T.);\n")
        CAD_IO.WriteStr(fd, "#85 = EDGE_CURVE('',#26,#27,#65,.T.);\n")
        CAD_IO.WriteStr(fd, "#86 = EDGE_CURVE('',#27,#28,#66,.T.);\n")
        CAD_IO.WriteStr(fd, "#87 = EDGE_CURVE('',#28,#25,#67,.T.);\n")
        CAD_IO.WriteStr(fd, "#88 = EDGE_CURVE('',#21,#25,#68,.T.);\n")
        CAD_IO.WriteStr(fd, "#89 = EDGE_CURVE('',#22,#26,#69,.T.);\n")
        CAD_IO.WriteStr(fd, "#90 = EDGE_CURVE('',#23,#27,#70,.T.);\n")
        CAD_IO.WriteStr(fd, "#91 = EDGE_CURVE('',#24,#28,#71,.T.);\n")
        CAD_IO.WriteStr(fd, "#92 = EDGE_CURVE('',#29,#29,#74,.T.);\n")
        CAD_IO.WriteStr(fd, "#93 = EDGE_CURVE('',#30,#30,#75,.T.);\n")
        CAD_IO.WriteStr(fd, "#94 = EDGE_CURVE('',#29,#30,#76,.T.);\n")

        // oriented edges
        CAD_IO.WriteStr(fd, "#200 = ORIENTED_EDGE('',*,*,#80,.T.);\n")
        CAD_IO.WriteStr(fd, "#201 = ORIENTED_EDGE('',*,*,#81,.T.);\n")
        CAD_IO.WriteStr(fd, "#202 = ORIENTED_EDGE('',*,*,#82,.T.);\n")
        CAD_IO.WriteStr(fd, "#203 = ORIENTED_EDGE('',*,*,#83,.T.);\n")
        CAD_IO.WriteStr(fd, "#204 = ORIENTED_EDGE('',*,*,#84,.T.);\n")
        CAD_IO.WriteStr(fd, "#205 = ORIENTED_EDGE('',*,*,#85,.T.);\n")
        CAD_IO.WriteStr(fd, "#206 = ORIENTED_EDGE('',*,*,#86,.T.);\n")
        CAD_IO.WriteStr(fd, "#207 = ORIENTED_EDGE('',*,*,#87,.T.);\n")
        CAD_IO.WriteStr(fd, "#208 = ORIENTED_EDGE('',*,*,#80,.F.);\n")
        CAD_IO.WriteStr(fd, "#209 = ORIENTED_EDGE('',*,*,#89,.T.);\n")
        CAD_IO.WriteStr(fd, "#210 = ORIENTED_EDGE('',*,*,#84,.F.);\n")
        CAD_IO.WriteStr(fd, "#211 = ORIENTED_EDGE('',*,*,#88,.F.);\n")
        CAD_IO.WriteStr(fd, "#212 = ORIENTED_EDGE('',*,*,#81,.F.);\n")
        CAD_IO.WriteStr(fd, "#213 = ORIENTED_EDGE('',*,*,#90,.T.);\n")
        CAD_IO.WriteStr(fd, "#214 = ORIENTED_EDGE('',*,*,#85,.F.);\n")
        CAD_IO.WriteStr(fd, "#215 = ORIENTED_EDGE('',*,*,#89,.F.);\n")
        CAD_IO.WriteStr(fd, "#216 = ORIENTED_EDGE('',*,*,#82,.F.);\n")
        CAD_IO.WriteStr(fd, "#217 = ORIENTED_EDGE('',*,*,#91,.T.);\n")
        CAD_IO.WriteStr(fd, "#218 = ORIENTED_EDGE('',*,*,#86,.F.);\n")
        CAD_IO.WriteStr(fd, "#219 = ORIENTED_EDGE('',*,*,#90,.F.);\n")
        CAD_IO.WriteStr(fd, "#220 = ORIENTED_EDGE('',*,*,#83,.F.);\n")
        CAD_IO.WriteStr(fd, "#221 = ORIENTED_EDGE('',*,*,#88,.T.);\n")
        CAD_IO.WriteStr(fd, "#222 = ORIENTED_EDGE('',*,*,#87,.F.);\n")
        CAD_IO.WriteStr(fd, "#223 = ORIENTED_EDGE('',*,*,#91,.F.);\n")
        CAD_IO.WriteStr(fd, "#224 = ORIENTED_EDGE('',*,*,#92,.T.);\n")
        CAD_IO.WriteStr(fd, "#225 = ORIENTED_EDGE('',*,*,#92,.F.);\n")
        CAD_IO.WriteStr(fd, "#226 = ORIENTED_EDGE('',*,*,#93,.T.);\n")
        CAD_IO.WriteStr(fd, "#227 = ORIENTED_EDGE('',*,*,#93,.F.);\n")
        CAD_IO.WriteStr(fd, "#228 = ORIENTED_EDGE('',*,*,#94,.T.);\n")
        CAD_IO.WriteStr(fd, "#229 = ORIENTED_EDGE('',*,*,#94,.F.);\n")

        // loops (shared)
        CAD_IO.WriteStr(fd, "#300 = EDGE_LOOP('',(#200,#201,#202,#203));\n")
        CAD_IO.WriteStr(fd, "#301 = EDGE_LOOP('',(#207,#206,#205,#204));\n")
        CAD_IO.WriteStr(fd, "#302 = EDGE_LOOP('',(#208,#209,#210,#211));\n")
        CAD_IO.WriteStr(fd, "#303 = EDGE_LOOP('',(#212,#213,#214,#215));\n")
        CAD_IO.WriteStr(fd, "#304 = EDGE_LOOP('',(#216,#217,#218,#219));\n")
        CAD_IO.WriteStr(fd, "#305 = EDGE_LOOP('',(#220,#221,#222,#223));\n")
        CAD_IO.WriteStr(fd, "#306 = EDGE_LOOP('',(#225));\n")
        CAD_IO.WriteStr(fd, "#307 = EDGE_LOOP('',(#226));\n")
        CAD_IO.WriteStr(fd, "#308 = EDGE_LOOP('',(#224,#228,#227,#229));\n")
        // blind floor outer: reverse circle sense vs wall bottom (#224)
        CAD_IO.WriteStr(fd, "#309 = EDGE_LOOP('',(#225));\n")

        CAD_IO.WriteStr(fd, "#310 = FACE_OUTER_BOUND('',#300,.T.);\n")
        CAD_IO.WriteStr(fd, "#311 = FACE_BOUND('',#306,.T.);\n")
        CAD_IO.WriteStr(fd, "#312 = FACE_OUTER_BOUND('',#301,.T.);\n")
        CAD_IO.WriteStr(fd, "#313 = FACE_BOUND('',#307,.T.);\n")
        CAD_IO.WriteStr(fd, "#314 = FACE_OUTER_BOUND('',#302,.T.);\n")
        CAD_IO.WriteStr(fd, "#315 = FACE_OUTER_BOUND('',#303,.T.);\n")
        CAD_IO.WriteStr(fd, "#316 = FACE_OUTER_BOUND('',#304,.T.);\n")
        CAD_IO.WriteStr(fd, "#317 = FACE_OUTER_BOUND('',#305,.T.);\n")
        CAD_IO.WriteStr(fd, "#318 = FACE_OUTER_BOUND('',#308,.T.);\n")
        CAD_IO.WriteStr(fd, "#319 = FACE_OUTER_BOUND('',#309,.T.);\n")

        CAD_IO.WriteStr(fd, "#320 = AXIS2_PLACEMENT_3D('',#1,#43,#40);\n")
        CAD_IO.WriteStr(fd, "#321 = AXIS2_PLACEMENT_3D('',#5,#42,#40);\n")
        CAD_IO.WriteStr(fd, "#322 = AXIS2_PLACEMENT_3D('',#1,#45,#40);\n")
        CAD_IO.WriteStr(fd, "#323 = AXIS2_PLACEMENT_3D('',#2,#40,#41);\n")
        CAD_IO.WriteStr(fd, "#324 = AXIS2_PLACEMENT_3D('',#3,#41,#44);\n")
        CAD_IO.WriteStr(fd, "#325 = AXIS2_PLACEMENT_3D('',#4,#44,#45);\n")
        // floor plane of pocket: +Z outward into cavity
        CAD_IO.WriteStr(fd, "#326 = AXIS2_PLACEMENT_3D('',#9,#42,#40);\n")

        CAD_IO.WriteStr(fd, "#330 = PLANE('',#320);\n")
        CAD_IO.WriteStr(fd, "#331 = PLANE('',#321);\n")
        CAD_IO.WriteStr(fd, "#332 = PLANE('',#322);\n")
        CAD_IO.WriteStr(fd, "#333 = PLANE('',#323);\n")
        CAD_IO.WriteStr(fd, "#334 = PLANE('',#324);\n")
        CAD_IO.WriteStr(fd, "#335 = PLANE('',#325);\n")
        CAD_IO.WriteStr(fd, "#336 = PLANE('',#326);\n")

        // sides + top annulus + hole wall always
        CAD_IO.WriteStr(fd, "#341 = ADVANCED_FACE('',(#312,#313),#331,.T.);\n")
        CAD_IO.WriteStr(fd, "#342 = ADVANCED_FACE('',(#314),#332,.T.);\n")
        CAD_IO.WriteStr(fd, "#343 = ADVANCED_FACE('',(#315),#333,.T.);\n")
        CAD_IO.WriteStr(fd, "#344 = ADVANCED_FACE('',(#316),#334,.T.);\n")
        CAD_IO.WriteStr(fd, "#345 = ADVANCED_FACE('',(#317),#335,.T.);\n")
        CAD_IO.WriteStr(fd, "#346 = ADVANCED_FACE('',(#318),#77,.T.);\n")

        IfCondition EqualTo(through, 1) ThenBlock: {
            // through: bottom annulus (outer + hole) — hole rim at z=0
            CAD_IO.WriteStr(fd, "#340 = ADVANCED_FACE('',(#310,#311),#330,.T.);\n")
            CAD_IO.WriteStr(fd, "#120 = CLOSED_SHELL('',(#340,#341,#342,#343,#344,#345,#346));\n")
        }
        IfCondition EqualTo(through, 0) ThenBlock: {
            // blind: solid bottom; floor disk at z_floor shares circle #92 with wall
            CAD_IO.WriteStr(fd, "#340 = ADVANCED_FACE('',(#310),#330,.T.);\n")
            CAD_IO.WriteStr(fd, "#347 = ADVANCED_FACE('',(#319),#336,.T.);\n")
            CAD_IO.WriteStr(fd, "#120 = CLOSED_SHELL('',(#340,#341,#342,#343,#344,#345,#346,#347));\n")
        }

        CAD_IO.WriteStr(fd, "ENDSEC;\nEND-ISO-10303-21;\n")
        ReturnValue(0)
    }
}

// Analytic cylinder STEP. origin_addr [ox,oy,oz] base center; +Z height.
Function.CAD_IO.WriteCylinderAnalyticSTEP {
    Input: fd: Integer
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: origin_addr: Address
    Output: Integer
    Body: {
        ox = ArrayGet(origin_addr, 0)
        oy = ArrayGet(origin_addr, 1)
        oz = ArrayGet(origin_addr, 2)
        CAD_IO.WriteStr(fd, "ISO-10303-21;\n")
        CAD_IO.WriteStr(fd, "HEADER;\n")
        CAD_IO.WriteStr(fd, "FILE_DESCRIPTION(('AILang CAD Cylinder'),'2;1');\n")
        CAD_IO.WriteStr(fd, "FILE_NAME('ailang_cyl.stp','2026-08-05T00:00:00',('AILang'),('2 Paws Machine'),'AILang CAD Engine','AILang CAD Engine','');\n")
        CAD_IO.WriteStr(fd, "FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\n")
        CAD_IO.WriteStr(fd, "DATA;\n")
        CAD_IO.WriteStr(fd, "#100 = APPLICATION_CONTEXT('automotive design');\n")
        CAD_IO.WriteStr(fd, "#101 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#100);\n")
        CAD_IO.WriteStr(fd, "#102 = PRODUCT('ailang_cyl','ailang_cyl','',(#103));\n")
        CAD_IO.WriteStr(fd, "#103 = PRODUCT_CONTEXT('',#100,'mechanical');\n")
        CAD_IO.WriteStr(fd, "#104 = PRODUCT_DEFINITION_FORMATION('','',#102);\n")
        CAD_IO.WriteStr(fd, "#105 = PRODUCT_DEFINITION('design','',#104,#106);\n")
        CAD_IO.WriteStr(fd, "#106 = PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');\n")
        CAD_IO.WriteStr(fd, "#107 = PRODUCT_DEFINITION_SHAPE('','',#105);\n")
        CAD_IO.WriteStr(fd, "#108 = SHAPE_DEFINITION_REPRESENTATION(#107,#109);\n")
        CAD_IO.WriteStr(fd, "#109 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#110),#111);\n")
        CAD_IO.WriteStr(fd, "#110 = MANIFOLD_SOLID_BREP('Cylinder',#120);\n")
        CAD_IO.WriteStr(fd, "#111 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#112)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#113,#114,#115)) REPRESENTATION_CONTEXT('Context3D','3D Context') );\n")
        CAD_IO.WriteStr(fd, "#112 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#113,'distance_accuracy_value','confusion accuracy');\n")
        CAD_IO.WriteStr(fd, "#113 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );\n")
        CAD_IO.WriteStr(fd, "#114 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT(*,.RADIAN.) );\n")
        CAD_IO.WriteStr(fd, "#115 = ( NAMED_UNIT(*) SI_UNIT(*,.STERADIAN.) SOLID_ANGLE_UNIT() );\n")

        // #1 base center, #2 top center, #3 seam bot, #4 seam top
        CAD_IO.WriteStr(fd, "#1 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, ox)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, oy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, oz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#2 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, ox)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, oy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, Float_Add(oz, height_r))
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#3 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, Float_Add(ox, radius_r))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, oy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, oz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#4 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, Float_Add(ox, radius_r))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, oy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, Float_Add(oz, height_r))
        CAD_IO.WriteStr(fd, "));\n")

        CAD_IO.WriteStr(fd, "#11 = VERTEX_POINT('',#3);\n")
        CAD_IO.WriteStr(fd, "#12 = VERTEX_POINT('',#4);\n")

        CAD_IO.WriteStr(fd, "#20 = DIRECTION('',(0.,0.,1.));\n")
        CAD_IO.WriteStr(fd, "#21 = DIRECTION('',(1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#22 = DIRECTION('',(0.,1.,0.));\n")
        CAD_IO.WriteStr(fd, "#23 = DIRECTION('',(0.,0.,-1.));\n")

        CAD_IO.WriteStr(fd, "#30 = AXIS2_PLACEMENT_3D('',#1,#20,#21);\n")
        CAD_IO.WriteStr(fd, "#31 = AXIS2_PLACEMENT_3D('',#2,#20,#21);\n")
        CAD_IO.WriteStr(fd, "#32 = AXIS2_PLACEMENT_3D('',#1,#23,#21);\n")

        CAD_IO.WriteStr(fd, "#40 = CIRCLE('',#30,")
        CAD_IO.WriteFloat(fd, radius_r)
        CAD_IO.WriteStr(fd, ");\n")
        CAD_IO.WriteStr(fd, "#41 = CIRCLE('',#31,")
        CAD_IO.WriteFloat(fd, radius_r)
        CAD_IO.WriteStr(fd, ");\n")

        CAD_IO.WriteStr(fd, "#42 = VECTOR('',#20,1.);\n")
        CAD_IO.WriteStr(fd, "#43 = LINE('',#3,#42);\n")

        CAD_IO.WriteStr(fd, "#50 = EDGE_CURVE('',#11,#11,#40,.T.);\n")
        CAD_IO.WriteStr(fd, "#51 = EDGE_CURVE('',#12,#12,#41,.T.);\n")
        CAD_IO.WriteStr(fd, "#52 = EDGE_CURVE('',#11,#12,#43,.T.);\n")

        CAD_IO.WriteStr(fd, "#60 = ORIENTED_EDGE('',*,*,#50,.T.);\n")
        CAD_IO.WriteStr(fd, "#61 = ORIENTED_EDGE('',*,*,#50,.F.);\n")
        CAD_IO.WriteStr(fd, "#62 = ORIENTED_EDGE('',*,*,#51,.T.);\n")
        CAD_IO.WriteStr(fd, "#63 = ORIENTED_EDGE('',*,*,#51,.F.);\n")
        CAD_IO.WriteStr(fd, "#64 = ORIENTED_EDGE('',*,*,#52,.T.);\n")
        CAD_IO.WriteStr(fd, "#65 = ORIENTED_EDGE('',*,*,#52,.F.);\n")

        // bottom outer: reverse circle (outward -Z plane uses bound)
        CAD_IO.WriteStr(fd, "#70 = EDGE_LOOP('',(#61));\n")
        CAD_IO.WriteStr(fd, "#71 = EDGE_LOOP('',(#62));\n")
        // side: bottom circle + seam up + top reverse + seam down — classic 4-edge
        // With single closed circle edges, side often uses: bottom, generator, top rev, gen rev
        CAD_IO.WriteStr(fd, "#72 = EDGE_LOOP('',(#60,#64,#63,#65));\n")

        CAD_IO.WriteStr(fd, "#80 = FACE_OUTER_BOUND('',#70,.T.);\n")
        CAD_IO.WriteStr(fd, "#81 = FACE_OUTER_BOUND('',#71,.T.);\n")
        CAD_IO.WriteStr(fd, "#82 = FACE_OUTER_BOUND('',#72,.T.);\n")

        CAD_IO.WriteStr(fd, "#90 = PLANE('',#32);\n")
        CAD_IO.WriteStr(fd, "#91 = PLANE('',#31);\n")
        CAD_IO.WriteStr(fd, "#92 = CYLINDRICAL_SURFACE('',#30,")
        CAD_IO.WriteFloat(fd, radius_r)
        CAD_IO.WriteStr(fd, ");\n")

        CAD_IO.WriteStr(fd, "#93 = ADVANCED_FACE('',(#80),#90,.T.);\n")
        CAD_IO.WriteStr(fd, "#94 = ADVANCED_FACE('',(#81),#91,.T.);\n")
        CAD_IO.WriteStr(fd, "#95 = ADVANCED_FACE('',(#82),#92,.T.);\n")

        CAD_IO.WriteStr(fd, "#120 = CLOSED_SHELL('',(#93,#94,#95));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\n")
        CAD_IO.WriteStr(fd, "END-ISO-10303-21;\n")
        ReturnValue(0)
    }
}

// FreeCAD-proof analytic sphere solid: 8 spherical octants on one SPHERICAL_SURFACE.
// 6 poles (±X,±Y,±Z), 12 great-circle quarter edges, 8 ADVANCED_FACE.
// Tessellated poly STEP is avoided — smooth solid in FreeCAD / other kernels.
Function.CAD_IO.WriteSphereAnalyticSTEP {
    Input: fd: Integer
    Input: params_h: Integer
    Output: Integer
    Body: {
        r = CAD_Store.Read(params_h, 0)
        cx = CAD_Store.Read(params_h, 1)
        cy = CAD_Store.Read(params_h, 2)
        cz = CAD_Store.Read(params_h, 3)

        CAD_IO.WriteStr(fd, "ISO-10303-21;\nHEADER;\n")
        CAD_IO.WriteStr(fd, "FILE_DESCRIPTION(('AILang analytic sphere solid'),'2;1');\n")
        CAD_IO.WriteStr(fd, "FILE_NAME('ailang_sphere.stp','2026-08-05T00:00:00',('AILang'),('2 Paws Machine'),'AILang CAD Engine','AILang CAD Engine','');\n")
        CAD_IO.WriteStr(fd, "FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\nDATA;\n")
        CAD_IO.WriteStr(fd, "#100 = APPLICATION_CONTEXT('automotive design');\n")
        CAD_IO.WriteStr(fd, "#101 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#100);\n")
        CAD_IO.WriteStr(fd, "#102 = PRODUCT('ailang_sphere','ailang_sphere','',(#103));\n")
        CAD_IO.WriteStr(fd, "#103 = PRODUCT_CONTEXT('',#100,'mechanical');\n")
        CAD_IO.WriteStr(fd, "#104 = PRODUCT_DEFINITION_FORMATION('','',#102);\n")
        CAD_IO.WriteStr(fd, "#105 = PRODUCT_DEFINITION('design','',#104,#106);\n")
        CAD_IO.WriteStr(fd, "#106 = PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');\n")
        CAD_IO.WriteStr(fd, "#107 = PRODUCT_DEFINITION_SHAPE('','',#105);\n")
        CAD_IO.WriteStr(fd, "#108 = SHAPE_DEFINITION_REPRESENTATION(#107,#109);\n")
        CAD_IO.WriteStr(fd, "#109 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#110),#111);\n")
        CAD_IO.WriteStr(fd, "#110 = MANIFOLD_SOLID_BREP('Sphere',#120);\n")
        CAD_IO.WriteStr(fd, "#111 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#112)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#113,#114,#115)) REPRESENTATION_CONTEXT('Context3D','3D Context') );\n")
        CAD_IO.WriteStr(fd, "#112 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#113,'distance_accuracy_value','confusion accuracy');\n")
        CAD_IO.WriteStr(fd, "#113 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );\n")
        CAD_IO.WriteStr(fd, "#114 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT(*,.RADIAN.) );\n")
        CAD_IO.WriteStr(fd, "#115 = ( NAMED_UNIT(*) SI_UNIT(*,.STERADIAN.) SOLID_ANGLE_UNIT() );\n")

        // #1 center; poles on axes: +X #2 -X #3 +Y #4 -Y #5 +Z #6 -Z
        CAD_IO.WriteStr(fd, "#1 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, cx)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, cy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, cz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#2 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, Float_Add(cx, r))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, cy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, cz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#3 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, Float_Sub(cx, r))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, cy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, cz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#4 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, cx)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, Float_Add(cy, r))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, cz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#5 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, cx)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, Float_Sub(cy, r))
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, cz)
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#6 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, cx)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, cy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, Float_Add(cz, r))
        CAD_IO.WriteStr(fd, "));\n")
        CAD_IO.WriteStr(fd, "#7 = CARTESIAN_POINT('',(")
        CAD_IO.WriteFloat(fd, cx)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, cy)
        CAD_IO.WriteStr(fd, ",")
        CAD_IO.WriteFloat(fd, Float_Sub(cz, r))
        CAD_IO.WriteStr(fd, "));\n")

        CAD_IO.WriteStr(fd, "#12 = VERTEX_POINT('',#2);\n")
        CAD_IO.WriteStr(fd, "#13 = VERTEX_POINT('',#3);\n")
        CAD_IO.WriteStr(fd, "#14 = VERTEX_POINT('',#4);\n")
        CAD_IO.WriteStr(fd, "#15 = VERTEX_POINT('',#5);\n")
        CAD_IO.WriteStr(fd, "#16 = VERTEX_POINT('',#6);\n")
        CAD_IO.WriteStr(fd, "#17 = VERTEX_POINT('',#7);\n")

        CAD_IO.WriteStr(fd, "#20 = DIRECTION('',(1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#21 = DIRECTION('',(0.,1.,0.));\n")
        CAD_IO.WriteStr(fd, "#22 = DIRECTION('',(0.,0.,1.));\n")
        CAD_IO.WriteStr(fd, "#23 = DIRECTION('',(-1.,0.,0.));\n")
        CAD_IO.WriteStr(fd, "#24 = DIRECTION('',(0.,-1.,0.));\n")
        CAD_IO.WriteStr(fd, "#25 = DIRECTION('',(0.,0.,-1.));\n")

        // sphere + three great-circle frames (axis = plane normal)
        CAD_IO.WriteStr(fd, "#30 = AXIS2_PLACEMENT_3D('',#1,#22,#20);\n")
        CAD_IO.WriteStr(fd, "#31 = SPHERICAL_SURFACE('',#30,")
        CAD_IO.WriteFloat(fd, r)
        CAD_IO.WriteStr(fd, ");\n")
        // Cxy equator (Z axis)
        CAD_IO.WriteStr(fd, "#32 = CIRCLE('',#30,")
        CAD_IO.WriteFloat(fd, r)
        CAD_IO.WriteStr(fd, ");\n")
        // Cxz meridian (Y axis)
        CAD_IO.WriteStr(fd, "#33 = AXIS2_PLACEMENT_3D('',#1,#21,#20);\n")
        CAD_IO.WriteStr(fd, "#34 = CIRCLE('',#33,")
        CAD_IO.WriteFloat(fd, r)
        CAD_IO.WriteStr(fd, ");\n")
        // Cyz meridian (X axis)
        CAD_IO.WriteStr(fd, "#35 = AXIS2_PLACEMENT_3D('',#1,#20,#21);\n")
        CAD_IO.WriteStr(fd, "#36 = CIRCLE('',#35,")
        CAD_IO.WriteFloat(fd, r)
        CAD_IO.WriteStr(fd, ");\n")

        // 12 quarter EDGE_CURVEs (short arcs between orthogonal poles)
        // equator Cxy: +X→+Y→-X→-Y→+X
        CAD_IO.WriteStr(fd, "#40 = EDGE_CURVE('',#12,#14,#32,.T.);\n")
        CAD_IO.WriteStr(fd, "#41 = EDGE_CURVE('',#14,#13,#32,.T.);\n")
        CAD_IO.WriteStr(fd, "#42 = EDGE_CURVE('',#13,#15,#32,.T.);\n")
        CAD_IO.WriteStr(fd, "#43 = EDGE_CURVE('',#15,#12,#32,.T.);\n")
        // Cxz: +X→+Z→-X→-Z→+X
        CAD_IO.WriteStr(fd, "#44 = EDGE_CURVE('',#12,#16,#34,.T.);\n")
        CAD_IO.WriteStr(fd, "#45 = EDGE_CURVE('',#16,#13,#34,.T.);\n")
        CAD_IO.WriteStr(fd, "#46 = EDGE_CURVE('',#13,#17,#34,.T.);\n")
        CAD_IO.WriteStr(fd, "#47 = EDGE_CURVE('',#17,#12,#34,.T.);\n")
        // Cyz: +Y→+Z→-Y→-Z→+Y
        CAD_IO.WriteStr(fd, "#48 = EDGE_CURVE('',#14,#16,#36,.T.);\n")
        CAD_IO.WriteStr(fd, "#49 = EDGE_CURVE('',#16,#15,#36,.T.);\n")
        CAD_IO.WriteStr(fd, "#50 = EDGE_CURVE('',#15,#17,#36,.T.);\n")
        CAD_IO.WriteStr(fd, "#51 = EDGE_CURVE('',#17,#14,#36,.T.);\n")

        // 8 octants — ids ≥1000 never clash with product #100–#115
        // +++ : +X→+Y→+Z→+X
        CAD_IO.WriteStr(fd, "#1000 = ORIENTED_EDGE('',*,*,#40,.T.);\n")
        CAD_IO.WriteStr(fd, "#1001 = ORIENTED_EDGE('',*,*,#48,.T.);\n")
        CAD_IO.WriteStr(fd, "#1002 = ORIENTED_EDGE('',*,*,#44,.F.);\n")
        CAD_IO.WriteStr(fd, "#1003 = EDGE_LOOP('',(#1000,#1001,#1002));\n")
        CAD_IO.WriteStr(fd, "#1004 = FACE_OUTER_BOUND('',#1003,.T.);\n")
        CAD_IO.WriteStr(fd, "#1005 = ADVANCED_FACE('+++',(#1004),#31,.T.);\n")

        // -++ : +Y→-X→+Z→+Y
        CAD_IO.WriteStr(fd, "#1010 = ORIENTED_EDGE('',*,*,#41,.T.);\n")
        CAD_IO.WriteStr(fd, "#1011 = ORIENTED_EDGE('',*,*,#45,.F.);\n")
        CAD_IO.WriteStr(fd, "#1012 = ORIENTED_EDGE('',*,*,#48,.F.);\n")
        CAD_IO.WriteStr(fd, "#1013 = EDGE_LOOP('',(#1010,#1011,#1012));\n")
        CAD_IO.WriteStr(fd, "#1014 = FACE_OUTER_BOUND('',#1013,.T.);\n")
        CAD_IO.WriteStr(fd, "#1015 = ADVANCED_FACE('-++',(#1014),#31,.T.);\n")

        // --+ : -X→-Y→+Z→-X
        CAD_IO.WriteStr(fd, "#1020 = ORIENTED_EDGE('',*,*,#42,.T.);\n")
        CAD_IO.WriteStr(fd, "#1021 = ORIENTED_EDGE('',*,*,#49,.F.);\n")
        CAD_IO.WriteStr(fd, "#1022 = ORIENTED_EDGE('',*,*,#45,.T.);\n")
        CAD_IO.WriteStr(fd, "#1023 = EDGE_LOOP('',(#1020,#1021,#1022));\n")
        CAD_IO.WriteStr(fd, "#1024 = FACE_OUTER_BOUND('',#1023,.T.);\n")
        CAD_IO.WriteStr(fd, "#1025 = ADVANCED_FACE('--+',(#1024),#31,.T.);\n")

        // +-+ : +X→+Z→-Y→+X
        CAD_IO.WriteStr(fd, "#1030 = ORIENTED_EDGE('',*,*,#44,.T.);\n")
        CAD_IO.WriteStr(fd, "#1031 = ORIENTED_EDGE('',*,*,#49,.T.);\n")
        CAD_IO.WriteStr(fd, "#1032 = ORIENTED_EDGE('',*,*,#43,.F.);\n")
        CAD_IO.WriteStr(fd, "#1033 = EDGE_LOOP('',(#1030,#1031,#1032));\n")
        CAD_IO.WriteStr(fd, "#1034 = FACE_OUTER_BOUND('',#1033,.T.);\n")
        CAD_IO.WriteStr(fd, "#1035 = ADVANCED_FACE('+-+',(#1034),#31,.T.);\n")

        // ++- : +X→-Z→+Y→+X
        CAD_IO.WriteStr(fd, "#1040 = ORIENTED_EDGE('',*,*,#47,.F.);\n")
        CAD_IO.WriteStr(fd, "#1041 = ORIENTED_EDGE('',*,*,#51,.T.);\n")
        CAD_IO.WriteStr(fd, "#1042 = ORIENTED_EDGE('',*,*,#40,.F.);\n")
        CAD_IO.WriteStr(fd, "#1043 = EDGE_LOOP('',(#1040,#1041,#1042));\n")
        CAD_IO.WriteStr(fd, "#1044 = FACE_OUTER_BOUND('',#1043,.T.);\n")
        CAD_IO.WriteStr(fd, "#1045 = ADVANCED_FACE('++-',(#1044),#31,.T.);\n")

        // -+- : -X→+Y→-Z→-X
        CAD_IO.WriteStr(fd, "#1050 = ORIENTED_EDGE('',*,*,#41,.F.);\n")
        CAD_IO.WriteStr(fd, "#1051 = ORIENTED_EDGE('',*,*,#51,.F.);\n")
        CAD_IO.WriteStr(fd, "#1052 = ORIENTED_EDGE('',*,*,#46,.F.);\n")
        CAD_IO.WriteStr(fd, "#1053 = EDGE_LOOP('',(#1050,#1051,#1052));\n")
        CAD_IO.WriteStr(fd, "#1054 = FACE_OUTER_BOUND('',#1053,.T.);\n")
        CAD_IO.WriteStr(fd, "#1055 = ADVANCED_FACE('-+-',(#1054),#31,.T.);\n")

        // --- : -X→-Z→-Y→-X
        CAD_IO.WriteStr(fd, "#1060 = ORIENTED_EDGE('',*,*,#46,.T.);\n")
        CAD_IO.WriteStr(fd, "#1061 = ORIENTED_EDGE('',*,*,#50,.F.);\n")
        CAD_IO.WriteStr(fd, "#1062 = ORIENTED_EDGE('',*,*,#42,.F.);\n")
        CAD_IO.WriteStr(fd, "#1063 = EDGE_LOOP('',(#1060,#1061,#1062));\n")
        CAD_IO.WriteStr(fd, "#1064 = FACE_OUTER_BOUND('',#1063,.T.);\n")
        CAD_IO.WriteStr(fd, "#1065 = ADVANCED_FACE('---',(#1064),#31,.T.);\n")

        // +-- : +X→-Y→-Z→+X
        CAD_IO.WriteStr(fd, "#1070 = ORIENTED_EDGE('',*,*,#43,.F.);\n")
        CAD_IO.WriteStr(fd, "#1071 = ORIENTED_EDGE('',*,*,#50,.T.);\n")
        CAD_IO.WriteStr(fd, "#1072 = ORIENTED_EDGE('',*,*,#47,.T.);\n")
        CAD_IO.WriteStr(fd, "#1073 = EDGE_LOOP('',(#1070,#1071,#1072));\n")
        CAD_IO.WriteStr(fd, "#1074 = FACE_OUTER_BOUND('',#1073,.T.);\n")
        CAD_IO.WriteStr(fd, "#1075 = ADVANCED_FACE('+--',(#1074),#31,.T.);\n")

        CAD_IO.WriteStr(fd, "#120 = CLOSED_SHELL('',(#1005,#1015,#1025,#1035,#1045,#1055,#1065,#1075));\n")
        CAD_IO.WriteStr(fd, "ENDSEC;\nEND-ISO-10303-21;\n")
        ReturnValue(0)
    }
}

// ExportSTEP: kind-specific analytic; else walk poly; else AABB box
Function.CAD_IO.ExportSTEP {
    Input: solid_handle: Integer
    Input: filename_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: {
            ReturnValue(-1)
        }
        fd = SystemCall(2, filename_addr, 577, 438)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-16)
        }

        kind = CAD_Store.Read(solid_handle, 3)
        rc = -1
        IfCondition EqualTo(kind, 1) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            r = CAD_Store.Read(ph, 0)
            h = CAD_Store.Read(ph, 1)
            org = Allocate(32)
            ArraySet(org, 0, CAD_Store.Read(ph, 2))
            ArraySet(org, 1, CAD_Store.Read(ph, 3))
            ArraySet(org, 2, CAD_Store.Read(ph, 4))
            rc = CAD_IO.WriteCylinderAnalyticSTEP(fd, r, h, org)
            Deallocate(org, 32)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            r = CAD_Store.Read(ph, 0)
            h = CAD_Store.Read(ph, 1)
            org = Allocate(32)
            ArraySet(org, 0, CAD_Store.Read(ph, 2))
            ArraySet(org, 1, CAD_Store.Read(ph, 3))
            ArraySet(org, 2, CAD_Store.Read(ph, 4))
            rc = CAD_IO.WriteCylinderAnalyticSTEP(fd, r, h, org)
            Deallocate(org, 32)
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            rc = CAD_IO.WriteBoxThroughHoleSTEP(fd, ph)
        }
        IfCondition EqualTo(kind, 4) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            rc = CAD_IO.WriteSphereAnalyticSTEP(fd, ph)
        }
        IfCondition NotEqual(rc, 0) ThenBlock: {
            rc = CAD_IO.WritePolySolidSTEP(fd, solid_handle)
        }
        IfCondition NotEqual(rc, 0) ThenBlock: {
            mn = Allocate(32)
            mx = Allocate(32)
            rc2 = CAD_IO.SolidAABB(solid_handle, mn, mx)
            IfCondition NotEqual(rc2, 0) ThenBlock: {
                ArraySet(mn, 0, 0)
                ArraySet(mn, 1, 0)
                ArraySet(mn, 2, 0)
                ArraySet(mx, 0, 0x3FF0000000000000)
                ArraySet(mx, 1, 0x3FF0000000000000)
                ArraySet(mx, 2, 0x3FF0000000000000)
            }
            CAD_IO.WriteBoxSTEP(fd, mn, mx)
            Deallocate(mn, 32)
            Deallocate(mx, 32)
        }

        SystemCall(3, fd, 0, 0)
        CAD_IO_State.export_count = Add(CAD_IO_State.export_count, 1)
        ReturnValue(0)
    }
}

Function.CAD_IO.ImportDXF {
    Input: filename_addr: Address
    Input: out_sketch_handle_addr: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, filename_addr, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-16)
        }
        h_sketch = CAD_Store.Alloc(10, 4)
        ArraySet(out_sketch_handle_addr, 0, h_sketch)
        SystemCall(3, fd, 0, 0)
        CAD_IO_State.import_count = Add(CAD_IO_State.import_count, 1)
        ReturnValue(0)
    }
}

Function.CAD_IO.ImportSTEP {
    Input: filename_addr: Address
    Input: out_solid_handle_addr: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, filename_addr, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-16)
        }
        h_solid = CAD_Store.Alloc(7, 4)
        ArraySet(out_solid_handle_addr, 0, h_solid)
        SystemCall(3, fd, 0, 0)
        CAD_IO_State.import_count = Add(CAD_IO_State.import_count, 1)
        ReturnValue(0)
    }
}
