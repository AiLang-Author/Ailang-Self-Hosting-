// CAD Kernel — L3 CAD.Isect — Analytic intersections (dependency before general Bool)
// SysV: ≤5 Inputs. Flat control flow.
// Frame layout (plane): [0..2] O, [3..5] X, [6..8] Y, [9..11] Z=normal

LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

FixedPool.CAD_Isect_State {
    "isect_count":    Initialize=0
    "marching_steps": Initialize=0
}

// -------------------------------------------------------------------------
// Line–Line closest approach (3D). Writes nearest point on L1 to out_pt.
// Returns 0 ok, -6 parallel/degenerate. Optional: out_pt is on L1.
// -------------------------------------------------------------------------
Function.CAD_Isect.LineLine {
    Input: p1_addr: Address
    Input: d1_addr: Address
    Input: p2_addr: Address
    Input: d2_addr: Address
    Input: out_pt_addr: Address
    Output: Integer
    Body: {
        // w0 = P1 - P2
        w0x = Float_Sub(ArrayGet(p1_addr, 0), ArrayGet(p2_addr, 0))
        w0y = Float_Sub(ArrayGet(p1_addr, 1), ArrayGet(p2_addr, 1))
        w0z = Float_Sub(ArrayGet(p1_addr, 2), ArrayGet(p2_addr, 2))
        a = CAD_Num.V3Dot(d1_addr, d1_addr)
        // b = D1·D2, c = D2·D2, d = D1·w0, e = D2·w0
        b = CAD_Num.V3Dot(d1_addr, d2_addr)
        c = CAD_Num.V3Dot(d2_addr, d2_addr)
        d = Float_Add(Float_Add(Float_Mul(ArrayGet(d1_addr, 0), w0x), Float_Mul(ArrayGet(d1_addr, 1), w0y)), Float_Mul(ArrayGet(d1_addr, 2), w0z))
        e = Float_Add(Float_Add(Float_Mul(ArrayGet(d2_addr, 0), w0x), Float_Mul(ArrayGet(d2_addr, 1), w0y)), Float_Mul(ArrayGet(d2_addr, 2), w0z))
        // denom = ac - b^2
        denom = Float_Sub(Float_Mul(a, c), Float_Mul(b, b))
        IfCondition EqualTo(CAD_Num.IsZero(denom, 0), 1) ThenBlock: {
            ReturnValue(-6)
        }
        // t = (be - cd) / denom? standard: sc = (be - c*d)/(ac-b^2) for L1 param
        // sc = (b*e - c*d) / denom
        num = Float_Sub(Float_Mul(b, e), Float_Mul(c, d))
        t = Float_Div(num, denom)
        ArraySet(out_pt_addr, 0, Float_Add(ArrayGet(p1_addr, 0), Float_Mul(t, ArrayGet(d1_addr, 0))))
        ArraySet(out_pt_addr, 1, Float_Add(ArrayGet(p1_addr, 1), Float_Mul(t, ArrayGet(d1_addr, 1))))
        ArraySet(out_pt_addr, 2, Float_Add(ArrayGet(p1_addr, 2), Float_Mul(t, ArrayGet(d1_addr, 2))))
        CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Line–Plane: P(t)=P0+t*D, plane O + N. Writes hit point. 0 ok, -6 parallel.
// plane_frame: O[0..2], N uses Z axis [9..11]
// -------------------------------------------------------------------------
Function.CAD_Isect.LinePlane {
    Input: p0_addr: Address
    Input: dir_addr: Address
    Input: plane_frame_addr: Address
    Input: out_pt_addr: Address
    Output: Integer
    Body: {
        nx = ArrayGet(plane_frame_addr, 9)
        ny = ArrayGet(plane_frame_addr, 10)
        nz = ArrayGet(plane_frame_addr, 11)
        ox = ArrayGet(plane_frame_addr, 0)
        oy = ArrayGet(plane_frame_addr, 1)
        oz = ArrayGet(plane_frame_addr, 2)
        // denom = N·D
        den = Float_Add(Float_Add(Float_Mul(nx, ArrayGet(dir_addr, 0)), Float_Mul(ny, ArrayGet(dir_addr, 1))), Float_Mul(nz, ArrayGet(dir_addr, 2)))
        IfCondition EqualTo(CAD_Num.IsZero(den, 0), 1) ThenBlock: {
            ReturnValue(-6)
        }
        // t = N·(O - P0) / (N·D)
        wx = Float_Sub(ox, ArrayGet(p0_addr, 0))
        wy = Float_Sub(oy, ArrayGet(p0_addr, 1))
        wz = Float_Sub(oz, ArrayGet(p0_addr, 2))
        num = Float_Add(Float_Add(Float_Mul(nx, wx), Float_Mul(ny, wy)), Float_Mul(nz, wz))
        t = Float_Div(num, den)
        ArraySet(out_pt_addr, 0, Float_Add(ArrayGet(p0_addr, 0), Float_Mul(t, ArrayGet(dir_addr, 0))))
        ArraySet(out_pt_addr, 1, Float_Add(ArrayGet(p0_addr, 1), Float_Mul(t, ArrayGet(dir_addr, 1))))
        ArraySet(out_pt_addr, 2, Float_Add(ArrayGet(p0_addr, 2), Float_Mul(t, ArrayGet(dir_addr, 2))))
        CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Plane–Plane → line. Frames as above. D = N1×N2; point on both planes.
// -------------------------------------------------------------------------
Function.CAD_Isect.PlanePlane {
    Input: f1_addr: Address
    Input: f2_addr: Address
    Input: out_line_p_addr: Address
    Input: out_line_d_addr: Address
    Output: Integer
    Body: {
        n1x = ArrayGet(f1_addr, 9)
        n1y = ArrayGet(f1_addr, 10)
        n1z = ArrayGet(f1_addr, 11)
        n2x = ArrayGet(f2_addr, 9)
        n2y = ArrayGet(f2_addr, 10)
        n2z = ArrayGet(f2_addr, 11)
        // D = N1 × N2
        dx = Float_Sub(Float_Mul(n1y, n2z), Float_Mul(n1z, n2y))
        dy = Float_Sub(Float_Mul(n1z, n2x), Float_Mul(n1x, n2z))
        dz = Float_Sub(Float_Mul(n1x, n2y), Float_Mul(n1y, n2x))
        dlen2 = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
        IfCondition EqualTo(CAD_Num.IsZero(dlen2, 0), 1) ThenBlock: {
            ReturnValue(-6)
        }
        ArraySet(out_line_d_addr, 0, dx)
        ArraySet(out_line_d_addr, 1, dy)
        ArraySet(out_line_d_addr, 2, dz)
        // Point: solve using cross products
        // P = ( (N1·O1)(N2×D) + (N2·O2)(D×N1) ) / (D·D)
        // N2×D
        c2x = Float_Sub(Float_Mul(n2y, dz), Float_Mul(n2z, dy))
        c2y = Float_Sub(Float_Mul(n2z, dx), Float_Mul(n2x, dz))
        c2z = Float_Sub(Float_Mul(n2x, dy), Float_Mul(n2y, dx))
        // D×N1
        c1x = Float_Sub(Float_Mul(dy, n1z), Float_Mul(dz, n1y))
        c1y = Float_Sub(Float_Mul(dz, n1x), Float_Mul(dx, n1z))
        c1z = Float_Sub(Float_Mul(dx, n1y), Float_Mul(dy, n1x))
        d1 = Float_Add(Float_Add(Float_Mul(n1x, ArrayGet(f1_addr, 0)), Float_Mul(n1y, ArrayGet(f1_addr, 1))), Float_Mul(n1z, ArrayGet(f1_addr, 2)))
        d2 = Float_Add(Float_Add(Float_Mul(n2x, ArrayGet(f2_addr, 0)), Float_Mul(n2y, ArrayGet(f2_addr, 1))), Float_Mul(n2z, ArrayGet(f2_addr, 2)))
        px = Float_Div(Float_Add(Float_Mul(d1, c2x), Float_Mul(d2, c1x)), dlen2)
        py = Float_Div(Float_Add(Float_Mul(d1, c2y), Float_Mul(d2, c1y)), dlen2)
        pz = Float_Div(Float_Add(Float_Mul(d1, c2z), Float_Mul(d2, c1z)), dlen2)
        ArraySet(out_line_p_addr, 0, px)
        ArraySet(out_line_p_addr, 1, py)
        ArraySet(out_line_p_addr, 2, pz)
        CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Line–Cylinder (infinite axis +Z). cyl_pack: [ox,oy,oz, r]
// Writes up to 2 hit points in out_pts (6 words). Returns 0,1,2 or -6.
// -------------------------------------------------------------------------
Function.CAD_Isect.LineCylinder {
    Input: p0_addr: Address
    Input: dir_addr: Address
    Input: cyl_pack_addr: Address
    Input: out_pts_addr: Address
    Output: Integer
    Body: {
        ox = ArrayGet(cyl_pack_addr, 0)
        oy = ArrayGet(cyl_pack_addr, 1)
        r = ArrayGet(cyl_pack_addr, 3)
        // work in XY relative to axis
        px = Float_Sub(ArrayGet(p0_addr, 0), ox)
        py = Float_Sub(ArrayGet(p0_addr, 1), oy)
        pz = ArrayGet(p0_addr, 2)
        dx = ArrayGet(dir_addr, 0)
        dy = ArrayGet(dir_addr, 1)
        dz = ArrayGet(dir_addr, 2)
        // (Pxy + t Dxy)^2 = r^2 → a t^2 + 2h t + c = 0
        a = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        // if a~0 line parallel to axis
        IfCondition EqualTo(CAD_Num.IsZero(a, 0), 1) ThenBlock: {
            // distance from axis
            d2 = Float_Add(Float_Mul(px, px), Float_Mul(py, py))
            r2 = Float_Mul(r, r)
            IfCondition EqualTo(CAD_Num.IsEqual(d2, r2, 0), 1) ThenBlock: {
                // line on surface — pick p0
                ArraySet(out_pts_addr, 0, ArrayGet(p0_addr, 0))
                ArraySet(out_pts_addr, 1, ArrayGet(p0_addr, 1))
                ArraySet(out_pts_addr, 2, ArrayGet(p0_addr, 2))
                CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        // h = Dxy·Pxy, c = Pxy·Pxy - r^2
        h = Float_Add(Float_Mul(dx, px), Float_Mul(dy, py))
        c = Float_Sub(Float_Add(Float_Mul(px, px), Float_Mul(py, py)), Float_Mul(r, r))
        // disc = h^2 - a*c
        disc = Float_Sub(Float_Mul(h, h), Float_Mul(a, c))
        IfCondition EqualTo(Float_Le(disc, 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(disc, 0), 1) ThenBlock: {
                t = Float_Div(Float_Sub(0, h), a)
                ArraySet(out_pts_addr, 0, Float_Add(ArrayGet(p0_addr, 0), Float_Mul(t, dx)))
                ArraySet(out_pts_addr, 1, Float_Add(ArrayGet(p0_addr, 1), Float_Mul(t, dy)))
                ArraySet(out_pts_addr, 2, Float_Add(ArrayGet(p0_addr, 2), Float_Mul(t, dz)))
                CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        sdisc = CAD_Num.Sqrt(disc)
        t0 = Float_Div(Float_Sub(Float_Sub(0, h), sdisc), a)
        t1 = Float_Div(Float_Sub(Float_Sub(0, h), Float_Sub(0, sdisc)), a)
        // t1 = (-h + sdisc)/a
        t1 = Float_Div(Float_Add(Float_Sub(0, h), sdisc), a)
        ArraySet(out_pts_addr, 0, Float_Add(ArrayGet(p0_addr, 0), Float_Mul(t0, dx)))
        ArraySet(out_pts_addr, 1, Float_Add(ArrayGet(p0_addr, 1), Float_Mul(t0, dy)))
        ArraySet(out_pts_addr, 2, Float_Add(ArrayGet(p0_addr, 2), Float_Mul(t0, dz)))
        ArraySet(out_pts_addr, 3, Float_Add(ArrayGet(p0_addr, 0), Float_Mul(t1, dx)))
        ArraySet(out_pts_addr, 4, Float_Add(ArrayGet(p0_addr, 1), Float_Mul(t1, dy)))
        ArraySet(out_pts_addr, 5, Float_Add(ArrayGet(p0_addr, 2), Float_Mul(t1, dz)))
        CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
        ReturnValue(2)
    }
}

// -------------------------------------------------------------------------
// Plane–Cylinder. Restricted: plane horizontal (N ‖ Z) → circle at z.
// cyl_pack [ox,oy,oz,r], plane_frame O+N. out_circle [cx,cy,cz,r]
// Returns 1 if circle, 0 none, -6 unsupported orientation (for now).
// -------------------------------------------------------------------------
Function.CAD_Isect.PlaneCylinder {
    Input: plane_frame_addr: Address
    Input: cyl_pack_addr: Address
    Input: out_circle_addr: Address
    Output: Integer
    Body: {
        nx = ArrayGet(plane_frame_addr, 9)
        ny = ArrayGet(plane_frame_addr, 10)
        nz = ArrayGet(plane_frame_addr, 11)
        // require N parallel ±Z
        IfCondition EqualTo(CAD_Num.IsZero(nx, 0), 0) ThenBlock: { ReturnValue(-6) }
        IfCondition EqualTo(CAD_Num.IsZero(ny, 0), 0) ThenBlock: { ReturnValue(-6) }
        IfCondition EqualTo(CAD_Num.IsZero(nz, 0), 1) ThenBlock: { ReturnValue(-6) }
        // plane z = O_z (for horizontal plane with origin on plane)
        // general: N·(X-O)=0 → z = Oz if N=(0,0,1)
        zhit = ArrayGet(plane_frame_addr, 2)
        ArraySet(out_circle_addr, 0, ArrayGet(cyl_pack_addr, 0))
        ArraySet(out_circle_addr, 1, ArrayGet(cyl_pack_addr, 1))
        ArraySet(out_circle_addr, 2, zhit)
        ArraySet(out_circle_addr, 3, ArrayGet(cyl_pack_addr, 3))
        CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
        ReturnValue(1)
    }
}

// -------------------------------------------------------------------------
// Circle–Circle in shared XY (2D). Centers+radii in c1r/c2r [cx,cy,cz,r].
// Writes up to 2 points in out_pts [6 words]. Returns 0,1,2 or -6.
// -------------------------------------------------------------------------
Function.CAD_Isect.CircleCircle {
    Input: c1r_addr: Address
    Input: c2r_addr: Address
    Input: out_pts_addr: Address
    Output: Integer
    Body: {
        x1 = ArrayGet(c1r_addr, 0)
        y1 = ArrayGet(c1r_addr, 1)
        r1 = ArrayGet(c1r_addr, 3)
        x2 = ArrayGet(c2r_addr, 0)
        y2 = ArrayGet(c2r_addr, 1)
        r2 = ArrayGet(c2r_addr, 3)
        dx = Float_Sub(x2, x1)
        dy = Float_Sub(y2, y1)
        d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(d2, 0), 1) ThenBlock: {
            ReturnValue(-6)
        }
        d = CAD_Num.Sqrt(d2)
        // no intersection if d > r1+r2 or d < |r1-r2|
        sum = Float_Add(r1, r2)
        // if d > sum
        IfCondition EqualTo(Float_Le(sum, d), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(d, sum, 0), 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        // a = (r1^2 - r2^2 + d^2) / (2d)
        a = Float_Div(Float_Add(Float_Sub(Float_Mul(r1, r1), Float_Mul(r2, r2)), d2), Float_Mul(0x4000000000000000, d))
        // h^2 = r1^2 - a^2
        h2 = Float_Sub(Float_Mul(r1, r1), Float_Mul(a, a))
        IfCondition EqualTo(Float_Le(h2, 0), 1) ThenBlock: {
            // one point
            px = Float_Add(x1, Float_Mul(a, Float_Div(dx, d)))
            py = Float_Add(y1, Float_Mul(a, Float_Div(dy, d)))
            ArraySet(out_pts_addr, 0, px)
            ArraySet(out_pts_addr, 1, py)
            ArraySet(out_pts_addr, 2, ArrayGet(c1r_addr, 2))
            CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
            ReturnValue(1)
        }
        h = CAD_Num.Sqrt(h2)
        // pm = midpoint of chord
        mx = Float_Add(x1, Float_Mul(a, Float_Div(dx, d)))
        my = Float_Add(y1, Float_Mul(a, Float_Div(dy, d)))
        // offset perpendicular
        rx = Float_Mul(h, Float_Div(dy, d))
        ry = Float_Mul(h, Float_Div(Float_Sub(0, dx), d))
        ArraySet(out_pts_addr, 0, Float_Add(mx, rx))
        ArraySet(out_pts_addr, 1, Float_Add(my, ry))
        ArraySet(out_pts_addr, 2, ArrayGet(c1r_addr, 2))
        ArraySet(out_pts_addr, 3, Float_Sub(mx, rx))
        ArraySet(out_pts_addr, 4, Float_Sub(my, ry))
        ArraySet(out_pts_addr, 5, ArrayGet(c1r_addr, 2))
        CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
        ReturnValue(2)
    }
}
