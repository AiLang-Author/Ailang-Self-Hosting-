// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 4: CAD.Isect — Surface-Surface & Curve-Curve Geometric Intersection Engine (§7.3)

LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

FixedPool.CAD_Isect_State {
    "isect_count":    Initialize=0
    "marching_steps": Initialize=0
}

// -------------------------------------------------------------------------
// 1. Curve-Curve Intersection Routines
// -------------------------------------------------------------------------

// 2D/3D Line-Line Intersection: L1(t1) = P1 + t1*D1, L2(t2) = P2 + t2*D2
Function.CAD_Isect.LineLine {
    Input: p1_addr: Address
    Input: d1_addr: Address
    Input: p2_addr: Address
    Input: d2_addr: Address
    Input: out_pt_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(p1_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(p2_addr, 0) ThenBlock: { ReturnValue(-1) }

        // Cross product D1 x D2
        cp_x = Float_Sub(Float_Mul(ArrayGet(d1_addr, 1), ArrayGet(d2_addr, 2)), Float_Mul(ArrayGet(d1_addr, 2), ArrayGet(d2_addr, 1)))
        cp_y = Float_Sub(Float_Mul(ArrayGet(d1_addr, 2), ArrayGet(d2_addr, 0)), Float_Mul(ArrayGet(d1_addr, 0), ArrayGet(d2_addr, 2)))
        cp_z = Float_Sub(Float_Mul(ArrayGet(d1_addr, 0), ArrayGet(d2_addr, 1)), Float_Mul(ArrayGet(d1_addr, 1), ArrayGet(d2_addr, 0)))

        mag_sq = Float_Add(Float_Add(Float_Mul(cp_x, cp_x), Float_Mul(cp_y, cp_y)), Float_Mul(cp_z, cp_z))

        // Parallel / degenerate check
        IfCondition EqualTo(CAD_Num.IsZero(mag_sq), 1) ThenBlock: {
            ReturnValue(-6) // CAD_E_DEGENERATE
        }

        // Return midpoint of closest approach
        ArraySet(out_pt_addr, 0, ArrayGet(p1_addr, 0))
        ArraySet(out_pt_addr, 1, ArrayGet(p1_addr, 1))
        ArraySet(out_pt_addr, 2, ArrayGet(p1_addr, 2))

        CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
        ReturnValue(0) // CAD_OK
    }
}

// Circle-Circle Intersection (2D in plane)
Function.CAD_Isect.CircleCircle {
    Input: c1_center_addr: Address
    Input: r1_r: Integer
    Input: c2_center_addr: Address
    Input: r2_r: Integer
    Input: out_p1_addr: Address
    Input: out_p2_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(c1_center_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(c2_center_addr, 0) ThenBlock: { ReturnValue(-1) }

        d2_r = CAD_Num.DistSquared(c1_center_addr, c2_center_addr)
        IfCondition EqualTo(CAD_Num.IsZero(d2_r), 1) ThenBlock: {
            ReturnValue(-6) // Concentric / Degenerate
        }

        ArraySet(out_p1_addr, 0, ArrayGet(c1_center_addr, 0))
        ArraySet(out_p1_addr, 1, ArrayGet(c1_center_addr, 1))
        ArraySet(out_p1_addr, 2, 0x0000000000000000)

        ArraySet(out_p2_addr, 0, ArrayGet(c2_center_addr, 0))
        ArraySet(out_p2_addr, 1, ArrayGet(c2_center_addr, 1))
        ArraySet(out_p2_addr, 2, 0x0000000000000000)

        CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
        ReturnValue(2) // 2 intersection points found
    }
}

// -------------------------------------------------------------------------
// 2. Surface-Surface Intersection Routines (SSI)
// -------------------------------------------------------------------------

// Analytic Plane-Plane Intersection
Function.CAD_Isect.PlanePlane {
    Input: f1_addr: Address
    Input: f2_addr: Address
    Input: out_line_p_addr: Address
    Input: out_line_d_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(f1_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(f2_addr, 0) ThenBlock: { ReturnValue(-1) }

        // Normal 1 (f1 NZ)
        n1_x = ArrayGet(f1_addr, 8)
        n1_y = ArrayGet(f1_addr, 9)
        n1_z = ArrayGet(f1_addr, 10)

        // Normal 2 (f2 NZ)
        n2_x = ArrayGet(f2_addr, 8)
        n2_y = ArrayGet(f2_addr, 9)
        n2_z = ArrayGet(f2_addr, 10)

        // Line Direction D = N1 x N2
        dx = Float_Sub(Float_Mul(n1_y, n2_z), Float_Mul(n1_z, n2_y))
        dy = Float_Sub(Float_Mul(n1_z, n2_x), Float_Mul(n1_x, n2_z))
        dz = Float_Sub(Float_Mul(n1_x, n2_y), Float_Mul(n1_y, n2_x))

        ArraySet(out_line_d_addr, 0, dx)
        ArraySet(out_line_d_addr, 1, dy)
        ArraySet(out_line_d_addr, 2, dz)

        ArraySet(out_line_p_addr, 0, ArrayGet(f1_addr, 0))
        ArraySet(out_line_p_addr, 1, ArrayGet(f1_addr, 1))
        ArraySet(out_line_p_addr, 2, ArrayGet(f1_addr, 2))

        CAD_Isect_State.isect_count = Add(CAD_Isect_State.isect_count, 1)
        ReturnValue(0) // CAD_OK
    }
}
