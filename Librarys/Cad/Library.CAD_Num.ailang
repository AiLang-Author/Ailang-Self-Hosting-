// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 0: CAD.Num — Single Tolerance Authority, Vector Math & Exact Geometric Predicates

FixedPool.Num_Tol {
    "linear":     Initialize=0
    "angular":    Initialize=0
    "param":      Initialize=0
    "model_size": Initialize=0
    "resolution": Initialize=0
}

Function.CAD_Num.InitTolerance {
    Input: linear_r: Integer
    Input: angular_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(linear_r, 0) ThenBlock: {
            linear_r = 0x3E7AD7F29ABCAF48
        }
        IfCondition EqualTo(angular_r, 0) ThenBlock: {
            angular_r = 0x3E112E0BE826D695
        }

        Num_Tol.linear = linear_r
        Num_Tol.angular = angular_r
        Num_Tol.param = 0x3E112E0BE826D695
        Num_Tol.model_size = 0x408F400000000000
        Num_Tol.resolution = linear_r
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Square root — hardware Float_Sqrt (SSE2 SQRTSD, double precision).
// Compiler path: MOVQ xmm0,rax ; SQRTSD xmm0,xmm0 ; MOVQ rax,xmm0
// (Must NOT use SQRTSS/RSQRTSS — single-precision mantissa drift broke CAD tol.)
// Negative inputs: IEEE NaN bits returned as-is from SQRTSD.
// -------------------------------------------------------------------------
Function.CAD_Num.Sqrt {
    Input: val_r: Integer
    Output: Integer
    Body: {
        mag_r = BitwiseAnd(val_r, 0x7FFFFFFFFFFFFFFF)
        IfCondition EqualTo(mag_r, 0) ThenBlock: {
            ReturnValue(0x0000000000000000)
        }
        ReturnValue(Float_Sqrt(val_r))
    }
}

Function.CAD_Num.IsZero {
    Input: val_r: Integer
    Input: tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(tol_r, 0) ThenBlock: {
            tol_r = Num_Tol.linear
        }
        abs_v_r = BitwiseAnd(val_r, 0x7FFFFFFFFFFFFFFF)
        res = Float_Le(abs_v_r, tol_r)
        ReturnValue(res)
    }
}

Function.CAD_Num.IsEqual {
    Input: a_r: Integer
    Input: b_r: Integer
    Input: tol_r: Integer
    Output: Integer
    Body: {
        diff_r = Float_Sub(a_r, b_r)
        res = CAD_Num.IsZero(diff_r, tol_r)
        ReturnValue(res)
    }
}

Function.CAD_Num.PointsEqual {
    Input: pa_addr: Address
    Input: pb_addr: Address
    Input: tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(tol_r, 0) ThenBlock: {
            tol_r = Num_Tol.linear
        }

        ax_r = ArrayGet(pa_addr, 0)
        ay_r = ArrayGet(pa_addr, 1)
        az_r = ArrayGet(pa_addr, 2)

        bx_r = ArrayGet(pb_addr, 0)
        by_r = ArrayGet(pb_addr, 1)
        bz_r = ArrayGet(pb_addr, 2)

        dx_r = Float_Sub(ax_r, bx_r)
        dy_r = Float_Sub(ay_r, by_r)
        dz_r = Float_Sub(az_r, bz_r)

        d2_r = Float_Mul(dx_r, dx_r)
        d2_r = Float_Add(d2_r, Float_Mul(dy_r, dy_r))
        d2_r = Float_Add(d2_r, Float_Mul(dz_r, dz_r))

        tol2_r = Float_Mul(tol_r, tol_r)
        res = Float_Le(d2_r, tol2_r)
        ReturnValue(res)
    }
}

Function.CAD_Num.DistSquared {
    Input: pa_addr: Address
    Input: pb_addr: Address
    Output: Integer
    Body: {
        ax_r = ArrayGet(pa_addr, 0)
        ay_r = ArrayGet(pa_addr, 1)
        az_r = ArrayGet(pa_addr, 2)

        bx_r = ArrayGet(pb_addr, 0)
        by_r = ArrayGet(pb_addr, 1)
        bz_r = ArrayGet(pb_addr, 2)

        dx_r = Float_Sub(ax_r, bx_r)
        dy_r = Float_Sub(ay_r, by_r)
        dz_r = Float_Sub(az_r, bz_r)

        d2_r = Float_Mul(dx_r, dx_r)
        d2_r = Float_Add(d2_r, Float_Mul(dy_r, dy_r))
        d2_r = Float_Add(d2_r, Float_Mul(dz_r, dz_r))

        ReturnValue(d2_r)
    }
}

Function.CAD_Num.V3Dot {
    Input: va_addr: Address
    Input: vb_addr: Address
    Output: Integer
    Body: {
        ax_r = ArrayGet(va_addr, 0)
        ay_r = ArrayGet(va_addr, 1)
        az_r = ArrayGet(va_addr, 2)

        bx_r = ArrayGet(vb_addr, 0)
        by_r = ArrayGet(vb_addr, 1)
        bz_r = ArrayGet(vb_addr, 2)

        p1_r = Float_Mul(ax_r, bx_r)
        p2_r = Float_Add(p1_r, Float_Mul(ay_r, by_r))
        res_r = Float_Add(p2_r, Float_Mul(az_r, bz_r))

        ReturnValue(res_r)
    }
}

Function.CAD_Num.V3Cross {
    Input: va_addr: Address
    Input: vb_addr: Address
    Input: out_addr: Address
    Output: Integer
    Body: {
        ax_r = ArrayGet(va_addr, 0)
        ay_r = ArrayGet(va_addr, 1)
        az_r = ArrayGet(va_addr, 2)

        bx_r = ArrayGet(vb_addr, 0)
        by_r = ArrayGet(vb_addr, 1)
        bz_r = ArrayGet(vb_addr, 2)

        cx_r = Float_Sub(Float_Mul(ay_r, bz_r), Float_Mul(az_r, by_r))
        cy_r = Float_Sub(Float_Mul(az_r, bx_r), Float_Mul(ax_r, bz_r))
        cz_r = Float_Sub(Float_Mul(ax_r, by_r), Float_Mul(ay_r, bx_r))

        ArraySet(out_addr, 0, cx_r)
        ArraySet(out_addr, 1, cy_r)
        ArraySet(out_addr, 2, cz_r)
        ReturnValue(0)
    }
}

Function.CAD_Num.V3Length {
    Input: va_addr: Address
    Output: Integer
    Body: {
        dot_r = CAD_Num.V3Dot(va_addr, va_addr)
        len_r = CAD_Num.Sqrt(dot_r)
        ReturnValue(len_r)
    }
}

Function.CAD_Num.V3Normalize {
    Input: va_addr: Address
    Input: out_addr: Address
    Output: Integer
    Body: {
        len_r = CAD_Num.V3Length(va_addr)
        zero_r = 0x0000000000000000

        IfCondition Float_Le(len_r, 0x3E7AD7F29ABCAF48) ThenBlock: {
            ArraySet(out_addr, 0, zero_r)
            ArraySet(out_addr, 1, zero_r)
            ArraySet(out_addr, 2, zero_r)
            ReturnValue(-6)
        }

        inv_len_r = Float_Div(0x3FF0000000000000, len_r)
        ArraySet(out_addr, 0, Float_Mul(ArrayGet(va_addr, 0), inv_len_r))
        ArraySet(out_addr, 1, Float_Mul(ArrayGet(va_addr, 1), inv_len_r))
        ArraySet(out_addr, 2, Float_Mul(ArrayGet(va_addr, 2), inv_len_r))
        ReturnValue(0)
    }
}

Function.CAD_Num.Orient2D {
    Input: pa_addr: Address
    Input: pb_addr: Address
    Input: pc_addr: Address
    Output: Integer
    Body: {
        ax_r = ArrayGet(pa_addr, 0)
        ay_r = ArrayGet(pa_addr, 1)

        bx_r = ArrayGet(pb_addr, 0)
        by_r = ArrayGet(pb_addr, 1)

        cx_r = ArrayGet(pc_addr, 0)
        cy_r = ArrayGet(pc_addr, 1)

        acx_r = Float_Sub(ax_r, cx_r)
        bcx_r = Float_Sub(bx_r, cx_r)
        acy_r = Float_Sub(ay_r, cy_r)
        bcy_r = Float_Sub(by_r, cy_r)

        detleft_r = Float_Mul(acx_r, bcy_r)
        detright_r = Float_Mul(acy_r, bcx_r)
        det_r = Float_Sub(detleft_r, detright_r)

        mag_r = BitwiseAnd(det_r, 0x7FFFFFFFFFFFFFFF)
        IfCondition EqualTo(mag_r, 0) ThenBlock: {
            ReturnValue(0)
        }

        sign_mask = BitwiseAnd(det_r, 0x8000000000000000)
        IfCondition NotEqual(sign_mask, 0) ThenBlock: {
            minus_one = Subtract(0, 1)
            ReturnValue(minus_one)
        }

        ReturnValue(1)
    }
}

Function.CAD_Num.Orient3D {
    Input: pa_addr: Address
    Input: pb_addr: Address
    Input: pc_addr: Address
    Input: pd_addr: Address
    Output: Integer
    Body: {
        ax_r = ArrayGet(pa_addr, 0)
        ay_r = ArrayGet(pa_addr, 1)
        az_r = ArrayGet(pa_addr, 2)

        bx_r = ArrayGet(pb_addr, 0)
        by_r = ArrayGet(pb_addr, 1)
        bz_r = ArrayGet(pb_addr, 2)

        cx_r = ArrayGet(pc_addr, 0)
        cy_r = ArrayGet(pc_addr, 1)
        cz_r = ArrayGet(pc_addr, 2)

        dx_r = ArrayGet(pd_addr, 0)
        dy_r = ArrayGet(pd_addr, 1)
        dz_r = ArrayGet(pd_addr, 2)

        // Shewchuk Orient3D: det | a-d ; b-d ; c-d |  (rows)
        // +1 if d is above plane of CCW triangle (a,b,c)
        adx_r = Float_Sub(ax_r, dx_r)
        bdx_r = Float_Sub(bx_r, dx_r)
        cdx_r = Float_Sub(cx_r, dx_r)

        ady_r = Float_Sub(ay_r, dy_r)
        bdy_r = Float_Sub(by_r, dy_r)
        cdy_r = Float_Sub(cy_r, dy_r)

        adz_r = Float_Sub(az_r, dz_r)
        bdz_r = Float_Sub(bz_r, dz_r)
        cdz_r = Float_Sub(cz_r, dz_r)

        // det = adx(bdy*cdz - bdz*cdy) - ady(bdx*cdz - bdz*cdx) + adz(bdx*cdy - bdy*cdx)
        bc_yz = Float_Sub(Float_Mul(bdy_r, cdz_r), Float_Mul(bdz_r, cdy_r))
        bc_xz = Float_Sub(Float_Mul(bdx_r, cdz_r), Float_Mul(bdz_r, cdx_r))
        bc_xy = Float_Sub(Float_Mul(bdx_r, cdy_r), Float_Mul(bdy_r, cdx_r))

        det_r = Float_Mul(adx_r, bc_yz)
        det_r = Float_Sub(det_r, Float_Mul(ady_r, bc_xz))
        det_r = Float_Add(det_r, Float_Mul(adz_r, bc_xy))

        mag_r = BitwiseAnd(det_r, 0x7FFFFFFFFFFFFFFF)
        IfCondition EqualTo(mag_r, 0) ThenBlock: {
            ReturnValue(0)
        }

        sign_mask = BitwiseAnd(det_r, 0x8000000000000000)
        IfCondition NotEqual(sign_mask, 0) ThenBlock: {
            minus_one = Subtract(0, 1)
            ReturnValue(minus_one)
        }

        ReturnValue(1)
    }
}

// -------------------------------------------------------------------------
// Dense linear algebra — shared by Solve2D, curve/surface Newton, fitting
// Matrices are row-major IEEE doubles (Integer bit patterns) at Address.
// Max n = 16 for early kernel.
// -------------------------------------------------------------------------

Function.CAD_Num.MatGet {
    Input: a_addr: Address
    Input: n: Integer
    Input: row: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        ReturnValue(ArrayGet(a_addr, Add(Multiply(row, n), col)))
    }
}

Function.CAD_Num.MatSet {
    Input: a_addr: Address
    Input: n: Integer
    Input: row: Integer
    Input: col: Integer
    Input: val_r: Integer
    Output: Integer
    Body: {
        ArraySet(a_addr, Add(Multiply(row, n), col), val_r)
        ReturnValue(0)
    }
}

// In-place LU with partial pivoting. A is n×n row-major (destroyed).
// piv_addr[i] = pivot row index for stage i.
// Returns 0 on success, -7 singular, -4 range, -1 null.
Function.CAD_Num.LUDecompose {
    Input: a_addr: Address
    Input: n: Integer
    Input: piv_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n, 1) ThenBlock: {
            ReturnValue(-4)
        }
        IfCondition GreaterThan(n, 16) ThenBlock: {
            ReturnValue(-4)
        }
        IfCondition EqualTo(a_addr, 0) ThenBlock: {
            ReturnValue(-1)
        }

        k = 0
        WhileLoop LessThan(k, n) {
            piv = k
            piv_mag = BitwiseAnd(CAD_Num.MatGet(a_addr, n, k, k), 0x7FFFFFFFFFFFFFFF)
            i = Add(k, 1)
            WhileLoop LessThan(i, n) {
                mag = BitwiseAnd(CAD_Num.MatGet(a_addr, n, i, k), 0x7FFFFFFFFFFFFFFF)
                IfCondition EqualTo(Float_Le(piv_mag, mag), 1) ThenBlock: {
                    IfCondition NotEqual(mag, piv_mag) ThenBlock: {
                        piv = i
                        piv_mag = mag
                    }
                }
                i = Add(i, 1)
            }

            ArraySet(piv_addr, k, piv)

            // ~1e-15 absolute pivot floor
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Num.MatGet(a_addr, n, piv, k), 0x3CB0000000000000), 1) ThenBlock: {
                ReturnValue(-7)
            }

            IfCondition NotEqual(piv, k) ThenBlock: {
                j = 0
                WhileLoop LessThan(j, n) {
                    tmp = CAD_Num.MatGet(a_addr, n, k, j)
                    CAD_Num.MatSet(a_addr, n, k, j, CAD_Num.MatGet(a_addr, n, piv, j))
                    CAD_Num.MatSet(a_addr, n, piv, j, tmp)
                    j = Add(j, 1)
                }
            }

            akk = CAD_Num.MatGet(a_addr, n, k, k)
            i2 = Add(k, 1)
            WhileLoop LessThan(i2, n) {
                factor = Float_Div(CAD_Num.MatGet(a_addr, n, i2, k), akk)
                CAD_Num.MatSet(a_addr, n, i2, k, factor)
                j2 = Add(k, 1)
                WhileLoop LessThan(j2, n) {
                    aij = CAD_Num.MatGet(a_addr, n, i2, j2)
                    akj = CAD_Num.MatGet(a_addr, n, k, j2)
                    aij = Float_Sub(aij, Float_Mul(factor, akj))
                    CAD_Num.MatSet(a_addr, n, i2, j2, aij)
                    j2 = Add(j2, 1)
                }
                i2 = Add(i2, 1)
            }

            k = Add(k, 1)
        }

        ReturnValue(0)
    }
}

Function.CAD_Num.LUSolve {
    Input: a_addr: Address
    Input: n: Integer
    Input: piv_addr: Address
    Input: b_addr: Address
    Input: x_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n, 1) ThenBlock: {
            ReturnValue(-4)
        }
        IfCondition GreaterThan(n, 16) ThenBlock: {
            ReturnValue(-4)
        }

        i = 0
        WhileLoop LessThan(i, n) {
            ArraySet(x_addr, i, ArrayGet(b_addr, i))
            i = Add(i, 1)
        }

        k = 0
        WhileLoop LessThan(k, n) {
            piv = ArrayGet(piv_addr, k)
            IfCondition NotEqual(piv, k) ThenBlock: {
                tmp = ArrayGet(x_addr, k)
                ArraySet(x_addr, k, ArrayGet(x_addr, piv))
                ArraySet(x_addr, piv, tmp)
            }
            k = Add(k, 1)
        }

        i = 0
        WhileLoop LessThan(i, n) {
            sum = ArrayGet(x_addr, i)
            j = 0
            WhileLoop LessThan(j, i) {
                lij = CAD_Num.MatGet(a_addr, n, i, j)
                sum = Float_Sub(sum, Float_Mul(lij, ArrayGet(x_addr, j)))
                j = Add(j, 1)
            }
            ArraySet(x_addr, i, sum)
            i = Add(i, 1)
        }

        i = Subtract(n, 1)
        done = 0
        WhileLoop EqualTo(done, 0) {
            sum = ArrayGet(x_addr, i)
            j = Add(i, 1)
            WhileLoop LessThan(j, n) {
                uij = CAD_Num.MatGet(a_addr, n, i, j)
                sum = Float_Sub(sum, Float_Mul(uij, ArrayGet(x_addr, j)))
                j = Add(j, 1)
            }
            uii = CAD_Num.MatGet(a_addr, n, i, i)
            ArraySet(x_addr, i, Float_Div(sum, uii))
            IfCondition EqualTo(i, 0) ThenBlock: {
                done = 1
            } ElseBlock: {
                i = Subtract(i, 1)
            }
        }

        ReturnValue(0)
    }
}

Function.CAD_Num.LinSolve {
    Input: a_addr: Address
    Input: n: Integer
    Input: b_addr: Address
    Input: x_addr: Address
    Output: Integer
    Body: {
        piv = Allocate(Multiply(n, 8))
        IfCondition EqualTo(piv, 0) ThenBlock: {
            ReturnValue(-16)
        }
        rc = CAD_Num.LUDecompose(a_addr, n, piv)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(piv, Multiply(n, 8))
            ReturnValue(rc)
        }
        rc = CAD_Num.LUSolve(a_addr, n, piv, b_addr, x_addr)
        Deallocate(piv, Multiply(n, 8))
        ReturnValue(rc)
    }
}

Function.CAD_Num.V3Add {
    Input: va_addr: Address
    Input: vb_addr: Address
    Input: out_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_addr, 0, Float_Add(ArrayGet(va_addr, 0), ArrayGet(vb_addr, 0)))
        ArraySet(out_addr, 1, Float_Add(ArrayGet(va_addr, 1), ArrayGet(vb_addr, 1)))
        ArraySet(out_addr, 2, Float_Add(ArrayGet(va_addr, 2), ArrayGet(vb_addr, 2)))
        ReturnValue(0)
    }
}

Function.CAD_Num.V3Sub {
    Input: va_addr: Address
    Input: vb_addr: Address
    Input: out_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_addr, 0, Float_Sub(ArrayGet(va_addr, 0), ArrayGet(vb_addr, 0)))
        ArraySet(out_addr, 1, Float_Sub(ArrayGet(va_addr, 1), ArrayGet(vb_addr, 1)))
        ArraySet(out_addr, 2, Float_Sub(ArrayGet(va_addr, 2), ArrayGet(vb_addr, 2)))
        ReturnValue(0)
    }
}

Function.CAD_Num.V3Scale {
    Input: va_addr: Address
    Input: s_r: Integer
    Input: out_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_addr, 0, Float_Mul(ArrayGet(va_addr, 0), s_r))
        ArraySet(out_addr, 1, Float_Mul(ArrayGet(va_addr, 1), s_r))
        ArraySet(out_addr, 2, Float_Mul(ArrayGet(va_addr, 2), s_r))
        ReturnValue(0)
    }
}

