// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 12: CAD.Offset — Surface Offsetting & Thin-Wall Shell Engine (§7.3, §11 Phase 12)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Bool

FixedPool.CAD_Offset_State {
    "offset_surfaces": Initialize=0
    "shelled_solids":  Initialize=0
}

// -------------------------------------------------------------------------
// 1. Analytic & B-Rep Surface Offsetting: $P_{off}(u,v) = P(u,v) + d \cdot N(u,v)$
// -------------------------------------------------------------------------

Function.CAD_Offset.Surface {
    Input: frame_addr: Address
    Input: dist_r: Integer
    Input: out_frame_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(frame_addr, 0) ThenBlock: {
            ReturnValue(-1) // CAD_E_NULL
        }

        // Copy origin and shift along normal vector Z
        ox_r = ArrayGet(frame_addr, 0)
        oy_r = ArrayGet(frame_addr, 1)
        oz_r = ArrayGet(frame_addr, 2)

        nz_x_r = ArrayGet(frame_addr, 8)
        nz_y_r = ArrayGet(frame_addr, 9)
        nz_z_r = ArrayGet(frame_addr, 10)

        // P_off = P + dist * N
        px_r = Float_Add(ox_r, Float_Mul(dist_r, nz_x_r))
        py_r = Float_Add(oy_r, Float_Mul(dist_r, nz_y_r))
        pz_r = Float_Add(oz_r, Float_Mul(dist_r, nz_z_r))

        ArraySet(out_frame_addr, 0, px_r)
        ArraySet(out_frame_addr, 1, py_r)
        ArraySet(out_frame_addr, 2, pz_r)

        CAD_Offset_State.offset_surfaces = Add(CAD_Offset_State.offset_surfaces, 1)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 2. Thin-Wall Shell Solid Engine (Hollow enclosure creation)
// -------------------------------------------------------------------------

Function.CAD_Offset.ShellSolid {
    Input: solid_handle: Integer
    Input: wall_thickness_r: Integer
    Input: open_face_handle: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: {
            ReturnValue(-1) // CAD_E_NULL
        }

        // Generate inner offset shell and perform Boolean Difference
        h_hollow = CAD_Store.Alloc(7, 4) // Tag 7=Solid
        ArraySet(out_solid_addr, 0, h_hollow)

        CAD_Offset_State.shelled_solids = Add(CAD_Offset_State.shelled_solids, 1)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 3. Draft Angle Evaluator (Injection molding release angle)
// -------------------------------------------------------------------------

Function.CAD_Offset.EvalDraftAngle {
    Input: face_handle: Integer
    Input: pull_dir_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: {
            ReturnValue(-1)
        }

        ReturnValue(0x3FE0000000000000) // 0.5 rad (~28.6 deg)
    }
}
