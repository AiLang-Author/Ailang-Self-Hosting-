// CAD.OrbitCube — 3D nav cube drawn in the framebuffer.
// Face click snaps a view. Drag orbits. CAD and ECU both use this.
// Cube is ±1 about the origin; yaw/pitch match ECU_View. No camera-right,
// no Sqrt — roll-up cannot gimbal. All verts live in the pool (call clobber).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Cad.CAD_Num
LibraryImport.Display.Render.Framebuffer

FixedPool.CAD_OrbitCube_State {
    "yaw": Initialize=0, CanChange=True
    "pitch": Initialize=0, CanChange=True
    "cx": Initialize=0, CanChange=True
    "cy": Initialize=0, CanChange=True
    "sc": Initialize=36, CanChange=True
    "rx": Initialize=0, CanChange=True
    "ry": Initialize=0, CanChange=True
    "ux": Initialize=0, CanChange=True
    "uy": Initialize=0, CanChange=True
    "vdx": Initialize=0, CanChange=True
    "vdy": Initialize=0, CanChange=True
    "vdz": Initialize=0, CanChange=True
    "dx": Initialize=0, CanChange=True
    "dy": Initialize=0, CanChange=True
    "dz": Initialize=0, CanChange=True
    "x1": Initialize=0, CanChange=True
    "y1": Initialize=0, CanChange=True
    "z2": Initialize=0, CanChange=True
    "tmp": Initialize=0, CanChange=True
    "sx": Initialize=0, CanChange=True
    "sy": Initialize=0, CanChange=True
    "drag": Initialize=0, CanChange=True
    "moved": Initialize=0, CanChange=True
    "lx": Initialize=0, CanChange=True
    "ly": Initialize=0, CanChange=True
    "tx0": Initialize=0, CanChange=True
    "ty0": Initialize=0, CanChange=True
    "tx1": Initialize=0, CanChange=True
    "ty1": Initialize=0, CanChange=True
    "tx2": Initialize=0, CanChange=True
    "ty2": Initialize=0, CanChange=True
    "tx3": Initialize=0, CanChange=True
    "ty3": Initialize=0, CanChange=True
    "qleft": Initialize=0, CanChange=True
    "qright": Initialize=0, CanChange=True
    "col": Initialize=0, CanChange=True
    "ia": Initialize=0, CanChange=True
    "ib": Initialize=0, CanChange=True
    "best": Initialize=0, CanChange=True
    "bd": Initialize=0, CanChange=True
    "used": Initialize=0, CanChange=True
    "pass": Initialize=0, CanChange=True
    "hx": Initialize=0, CanChange=True
    "hy": Initialize=0, CanChange=True
    "fi": Initialize=0, CanChange=True
    "ci": Initialize=0, CanChange=True
    "offx": Initialize=0, CanChange=True
    "offy": Initialize=0, CanChange=True
    "step": Initialize=0x3F947AE147AE147B, CanChange=True
}

Function.CAD_OrbitCube.Sin {
    Input: x: Integer
    Output: Integer
    Body: {
        pi = 0x400921FB54442D18
        twopi = 0x401921FB54442D18
        n = 0
        WhileLoop LessThan(n, 32) {
            IfCondition EqualTo(Float_Le(pi, x), 1) ThenBlock: {
                x = Float_Sub(x, twopi)
            }
            n = Add(n, 1)
        }
        n = 0
        WhileLoop LessThan(n, 32) {
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(x, pi)), 1) ThenBlock: {
                x = Float_Add(x, twopi)
            }
            n = Add(n, 1)
        }
        x2 = Float_Mul(x, x)
        t = x
        s = x
        t = Float_Div(Float_Mul(t, x2), 0x4018000000000000)
        s = Float_Sub(s, t)
        t = Float_Div(Float_Mul(t, x2), 0x4034000000000000)
        s = Float_Add(s, t)
        t = Float_Div(Float_Mul(t, x2), 0x4045000000000000)
        s = Float_Sub(s, t)
        ReturnValue(s)
    }
}

Function.CAD_OrbitCube.Cos {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_OrbitCube.Sin(Float_Add(x, 0x3FF921FB54442D18)))
    }
}

Function.CAD_OrbitCube.Wrap {
    Input: a: Integer
    Output: Integer
    Body: {
        pi = 0x400921FB54442D18
        twopi = 0x401921FB54442D18
        n = 0
        WhileLoop LessThan(n, 32) {
            IfCondition EqualTo(Float_Le(pi, a), 1) ThenBlock: {
                a = Float_Sub(a, twopi)
            }
            n = Add(n, 1)
        }
        n = 0
        WhileLoop LessThan(n, 32) {
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(a, pi)), 1) ThenBlock: {
                a = Float_Add(a, twopi)
            }
            n = Add(n, 1)
        }
        ReturnValue(a)
    }
}

Function.CAD_OrbitCube.SetCam {
    Input: yaw: Integer
    Input: pitch: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube_State.yaw = yaw
        CAD_OrbitCube_State.pitch = pitch
        CAD_OrbitCube_State.yaw = CAD_OrbitCube.Wrap(CAD_OrbitCube_State.yaw)
        CAD_OrbitCube_State.pitch = CAD_OrbitCube.Wrap(CAD_OrbitCube_State.pitch)
        CAD_OrbitCube_State.rx = CAD_OrbitCube.Cos(CAD_OrbitCube_State.yaw)
        CAD_OrbitCube_State.ry = CAD_OrbitCube.Sin(CAD_OrbitCube_State.yaw)
        CAD_OrbitCube_State.ux = CAD_OrbitCube.Cos(CAD_OrbitCube_State.pitch)
        CAD_OrbitCube_State.uy = CAD_OrbitCube.Sin(CAD_OrbitCube_State.pitch)
        CAD_OrbitCube_State.vdx = CAD_Num.Mul(CAD_OrbitCube_State.ry, CAD_OrbitCube_State.ux)
        CAD_OrbitCube_State.tmp = CAD_Num.Mul(CAD_OrbitCube_State.rx, CAD_OrbitCube_State.ux)
        CAD_OrbitCube_State.vdy = Float_Sub(0, CAD_OrbitCube_State.tmp)
        CAD_OrbitCube_State.vdz = Float_Sub(0, CAD_OrbitCube_State.uy)
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.Place {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube_State.cx = Subtract(Add(x, w), 70)
        CAD_OrbitCube_State.cy = Add(y, 88)
        CAD_OrbitCube_State.sc = 28
        ReturnValue(h)
    }
}

Function.CAD_OrbitCube.SetStep {
    Input: s: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(s, 0), 1) ThenBlock: {
            s = 0x3F947AE147AE147B
        }
        CAD_OrbitCube_State.step = s
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.Corner {
    Input: i: Integer
    Input: axis: Integer
    Output: Integer
    Body: {
        p = 0
        IfCondition EqualTo(axis, 0) ThenBlock: {
            IfCondition EqualTo(i, 1) ThenBlock: { p = 1 }
            IfCondition EqualTo(i, 2) ThenBlock: { p = 1 }
            IfCondition EqualTo(i, 5) ThenBlock: { p = 1 }
            IfCondition EqualTo(i, 6) ThenBlock: { p = 1 }
        }
        IfCondition EqualTo(axis, 1) ThenBlock: {
            IfCondition EqualTo(i, 2) ThenBlock: { p = 1 }
            IfCondition EqualTo(i, 3) ThenBlock: { p = 1 }
            IfCondition EqualTo(i, 6) ThenBlock: { p = 1 }
            IfCondition EqualTo(i, 7) ThenBlock: { p = 1 }
        }
        IfCondition EqualTo(axis, 2) ThenBlock: {
            IfCondition GreaterEqual(i, 4) ThenBlock: { p = 1 }
        }
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0xBFF0000000000000) }
        ReturnValue(0x3FF0000000000000)
    }
}

Function.CAD_OrbitCube.FaceCorner {
    Input: face: Integer
    Input: k: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face, 0) ThenBlock: {
            IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(k, 1) ThenBlock: { ReturnValue(2) }
            IfCondition EqualTo(k, 2) ThenBlock: { ReturnValue(6) }
            ReturnValue(5)
        }
        IfCondition EqualTo(face, 1) ThenBlock: {
            IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(3) }
            IfCondition EqualTo(k, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(k, 2) ThenBlock: { ReturnValue(4) }
            ReturnValue(7)
        }
        IfCondition EqualTo(face, 2) ThenBlock: {
            IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(2) }
            IfCondition EqualTo(k, 1) ThenBlock: { ReturnValue(3) }
            IfCondition EqualTo(k, 2) ThenBlock: { ReturnValue(7) }
            ReturnValue(6)
        }
        IfCondition EqualTo(face, 3) ThenBlock: {
            IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(k, 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(k, 2) ThenBlock: { ReturnValue(5) }
            ReturnValue(4)
        }
        IfCondition EqualTo(face, 4) ThenBlock: {
            IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(4) }
            IfCondition EqualTo(k, 1) ThenBlock: { ReturnValue(5) }
            IfCondition EqualTo(k, 2) ThenBlock: { ReturnValue(6) }
            ReturnValue(7)
        }
        IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(k, 1) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(k, 2) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.PutCorner {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube_State.ci = i
        CAD_OrbitCube_State.dx = 0xBFF0000000000000
        CAD_OrbitCube_State.dy = 0xBFF0000000000000
        CAD_OrbitCube_State.dz = 0xBFF0000000000000
        IfCondition EqualTo(CAD_OrbitCube_State.ci, 1) ThenBlock: { CAD_OrbitCube_State.dx = 0x3FF0000000000000 }
        IfCondition EqualTo(CAD_OrbitCube_State.ci, 2) ThenBlock: { CAD_OrbitCube_State.dx = 0x3FF0000000000000 }
        IfCondition EqualTo(CAD_OrbitCube_State.ci, 5) ThenBlock: { CAD_OrbitCube_State.dx = 0x3FF0000000000000 }
        IfCondition EqualTo(CAD_OrbitCube_State.ci, 6) ThenBlock: { CAD_OrbitCube_State.dx = 0x3FF0000000000000 }
        IfCondition EqualTo(CAD_OrbitCube_State.ci, 2) ThenBlock: { CAD_OrbitCube_State.dy = 0x3FF0000000000000 }
        IfCondition EqualTo(CAD_OrbitCube_State.ci, 3) ThenBlock: { CAD_OrbitCube_State.dy = 0x3FF0000000000000 }
        IfCondition EqualTo(CAD_OrbitCube_State.ci, 6) ThenBlock: { CAD_OrbitCube_State.dy = 0x3FF0000000000000 }
        IfCondition EqualTo(CAD_OrbitCube_State.ci, 7) ThenBlock: { CAD_OrbitCube_State.dy = 0x3FF0000000000000 }
        IfCondition GreaterEqual(CAD_OrbitCube_State.ci, 4) ThenBlock: { CAD_OrbitCube_State.dz = 0x3FF0000000000000 }
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.Rot {
    Output: Integer
    Body: {
        CAD_OrbitCube_State.tmp = Float_Mul(CAD_OrbitCube_State.dx, CAD_OrbitCube_State.rx)
        CAD_OrbitCube_State.y1 = Float_Mul(CAD_OrbitCube_State.dy, CAD_OrbitCube_State.ry)
        CAD_OrbitCube_State.x1 = Float_Sub(CAD_OrbitCube_State.tmp, CAD_OrbitCube_State.y1)
        CAD_OrbitCube_State.tmp = Float_Mul(CAD_OrbitCube_State.dx, CAD_OrbitCube_State.ry)
        CAD_OrbitCube_State.y1 = Float_Mul(CAD_OrbitCube_State.dy, CAD_OrbitCube_State.rx)
        CAD_OrbitCube_State.y1 = Float_Add(CAD_OrbitCube_State.tmp, CAD_OrbitCube_State.y1)
        CAD_OrbitCube_State.tmp = Float_Mul(CAD_OrbitCube_State.y1, CAD_OrbitCube_State.uy)
        CAD_OrbitCube_State.z2 = Float_Mul(CAD_OrbitCube_State.dz, CAD_OrbitCube_State.ux)
        CAD_OrbitCube_State.z2 = Float_Add(CAD_OrbitCube_State.tmp, CAD_OrbitCube_State.z2)
        CAD_OrbitCube_State.z2 = Float_Sub(0, CAD_OrbitCube_State.z2)
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.QuadArea {
    Output: Integer
    Body: {
        a = Subtract(Multiply(CAD_OrbitCube_State.tx0, CAD_OrbitCube_State.ty1), Multiply(CAD_OrbitCube_State.tx1, CAD_OrbitCube_State.ty0))
        a = Add(a, Subtract(Multiply(CAD_OrbitCube_State.tx1, CAD_OrbitCube_State.ty2), Multiply(CAD_OrbitCube_State.tx2, CAD_OrbitCube_State.ty1)))
        a = Add(a, Subtract(Multiply(CAD_OrbitCube_State.tx2, CAD_OrbitCube_State.ty3), Multiply(CAD_OrbitCube_State.tx3, CAD_OrbitCube_State.ty2)))
        a = Add(a, Subtract(Multiply(CAD_OrbitCube_State.tx3, CAD_OrbitCube_State.ty0), Multiply(CAD_OrbitCube_State.tx0, CAD_OrbitCube_State.ty3)))
        ReturnValue(a)
    }
}

Function.CAD_OrbitCube.ToScreen {
    Output: Integer
    Body: {
        CAD_OrbitCube.Rot()
        CAD_OrbitCube_State.tmp = Float_FromInt(CAD_OrbitCube_State.sc)
        CAD_OrbitCube_State.tmp = Float_Mul(CAD_OrbitCube_State.x1, CAD_OrbitCube_State.tmp)
        CAD_OrbitCube_State.sx = Subtract(Add(CAD_OrbitCube_State.cx, Float_ToInt(CAD_OrbitCube_State.tmp)), CAD_OrbitCube_State.offx)
        CAD_OrbitCube_State.tmp = Float_FromInt(CAD_OrbitCube_State.sc)
        CAD_OrbitCube_State.tmp = Float_Mul(CAD_OrbitCube_State.z2, CAD_OrbitCube_State.tmp)
        CAD_OrbitCube_State.sy = Subtract(Subtract(CAD_OrbitCube_State.cy, Float_ToInt(CAD_OrbitCube_State.tmp)), CAD_OrbitCube_State.offy)
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.Recenter {
    Output: Integer
    Body: {
        CAD_OrbitCube_State.offx = 0
        CAD_OrbitCube_State.offy = 0
        CAD_OrbitCube_State.qleft = 0
        CAD_OrbitCube_State.qright = 0
        CAD_OrbitCube_State.pass = 0
        WhileLoop LessThan(CAD_OrbitCube_State.pass, 8) {
            CAD_OrbitCube.PutCorner(CAD_OrbitCube_State.pass)
            CAD_OrbitCube.ToScreen()
            CAD_OrbitCube_State.qleft = Add(CAD_OrbitCube_State.qleft, CAD_OrbitCube_State.sx)
            CAD_OrbitCube_State.qright = Add(CAD_OrbitCube_State.qright, CAD_OrbitCube_State.sy)
            CAD_OrbitCube_State.pass = Add(CAD_OrbitCube_State.pass, 1)
        }
        CAD_OrbitCube_State.offx = Subtract(Divide(CAD_OrbitCube_State.qleft, 8), CAD_OrbitCube_State.cx)
        CAD_OrbitCube_State.offy = Subtract(Divide(CAD_OrbitCube_State.qright, 8), CAD_OrbitCube_State.cy)
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.Park {
    Input: k: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(k, 0) ThenBlock: {
            CAD_OrbitCube_State.tx0 = CAD_OrbitCube_State.sx
            CAD_OrbitCube_State.ty0 = CAD_OrbitCube_State.sy
        }
        IfCondition EqualTo(k, 1) ThenBlock: {
            CAD_OrbitCube_State.tx1 = CAD_OrbitCube_State.sx
            CAD_OrbitCube_State.ty1 = CAD_OrbitCube_State.sy
        }
        IfCondition EqualTo(k, 2) ThenBlock: {
            CAD_OrbitCube_State.tx2 = CAD_OrbitCube_State.sx
            CAD_OrbitCube_State.ty2 = CAD_OrbitCube_State.sy
        }
        IfCondition EqualTo(k, 3) ThenBlock: {
            CAD_OrbitCube_State.tx3 = CAD_OrbitCube_State.sx
            CAD_OrbitCube_State.ty3 = CAD_OrbitCube_State.sy
        }
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.LoadFace {
    Input: face: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube_State.fi = face
        CAD_OrbitCube_State.ia = 0
        WhileLoop LessThan(CAD_OrbitCube_State.ia, 4) {
            CAD_OrbitCube_State.ib = CAD_OrbitCube.FaceCorner(CAD_OrbitCube_State.fi, CAD_OrbitCube_State.ia)
            CAD_OrbitCube.PutCorner(CAD_OrbitCube_State.ib)
            CAD_OrbitCube.ToScreen()
            CAD_OrbitCube.Park(CAD_OrbitCube_State.ia)
            CAD_OrbitCube_State.ia = Add(CAD_OrbitCube_State.ia, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.FaceNorm {
    Input: face: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube_State.dx = 0
        CAD_OrbitCube_State.dy = 0
        CAD_OrbitCube_State.dz = 0
        IfCondition EqualTo(face, 0) ThenBlock: { CAD_OrbitCube_State.dx = 0x3FF0000000000000 }
        IfCondition EqualTo(face, 1) ThenBlock: { CAD_OrbitCube_State.dx = 0xBFF0000000000000 }
        IfCondition EqualTo(face, 2) ThenBlock: { CAD_OrbitCube_State.dy = 0x3FF0000000000000 }
        IfCondition EqualTo(face, 3) ThenBlock: { CAD_OrbitCube_State.dy = 0xBFF0000000000000 }
        IfCondition EqualTo(face, 4) ThenBlock: { CAD_OrbitCube_State.dz = 0x3FF0000000000000 }
        IfCondition EqualTo(face, 5) ThenBlock: { CAD_OrbitCube_State.dz = 0xBFF0000000000000 }
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.FaceDepth {
    Input: face: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube.FaceNorm(face)
        CAD_OrbitCube_State.tmp = CAD_Num.Mul(CAD_OrbitCube_State.dx, CAD_OrbitCube_State.vdx)
        CAD_OrbitCube_State.y1 = CAD_Num.Mul(CAD_OrbitCube_State.dy, CAD_OrbitCube_State.vdy)
        CAD_OrbitCube_State.tmp = Float_Add(CAD_OrbitCube_State.tmp, CAD_OrbitCube_State.y1)
        CAD_OrbitCube_State.y1 = CAD_Num.Mul(CAD_OrbitCube_State.dz, CAD_OrbitCube_State.vdz)
        ReturnValue(Float_Add(CAD_OrbitCube_State.tmp, CAD_OrbitCube_State.y1))
    }
}

Function.CAD_OrbitCube.FaceVis {
    Input: face: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube_State.tmp = CAD_OrbitCube.FaceDepth(face)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_OrbitCube_State.tmp), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.FillSpan {
    Input: x0: Integer
    Input: x1: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(x0, x1) ThenBlock: {
            t = x0
            x0 = x1
            x1 = t
        }
        FB_HLine(x0, x1, y, CAD_OrbitCube_State.col)
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.AccumEdge {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(y0, y1) ThenBlock: {
            IfCondition EqualTo(y, y0) ThenBlock: {
                IfCondition LessThan(x0, CAD_OrbitCube_State.qleft) ThenBlock: { CAD_OrbitCube_State.qleft = x0 }
                IfCondition GreaterThan(x0, CAD_OrbitCube_State.qright) ThenBlock: { CAD_OrbitCube_State.qright = x0 }
                IfCondition LessThan(x1, CAD_OrbitCube_State.qleft) ThenBlock: { CAD_OrbitCube_State.qleft = x1 }
                IfCondition GreaterThan(x1, CAD_OrbitCube_State.qright) ThenBlock: { CAD_OrbitCube_State.qright = x1 }
            }
            ReturnValue(0)
        }
        lo = y0
        hi = y1
        IfCondition GreaterThan(lo, hi) ThenBlock: {
            lo = y1
            hi = y0
        }
        IfCondition LessThan(y, lo) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(y, hi) ThenBlock: { ReturnValue(0) }
        x = Add(x0, Divide(Multiply(Subtract(x1, x0), Subtract(y, y0)), Subtract(y1, y0)))
        IfCondition LessThan(x, CAD_OrbitCube_State.qleft) ThenBlock: { CAD_OrbitCube_State.qleft = x }
        IfCondition GreaterThan(x, CAD_OrbitCube_State.qright) ThenBlock: { CAD_OrbitCube_State.qright = x }
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.FillQuad {
    Output: Integer
    Body: {
        CAD_OrbitCube_State.ia = CAD_OrbitCube_State.ty0
        IfCondition LessThan(CAD_OrbitCube_State.ty1, CAD_OrbitCube_State.ia) ThenBlock: { CAD_OrbitCube_State.ia = CAD_OrbitCube_State.ty1 }
        IfCondition LessThan(CAD_OrbitCube_State.ty2, CAD_OrbitCube_State.ia) ThenBlock: { CAD_OrbitCube_State.ia = CAD_OrbitCube_State.ty2 }
        IfCondition LessThan(CAD_OrbitCube_State.ty3, CAD_OrbitCube_State.ia) ThenBlock: { CAD_OrbitCube_State.ia = CAD_OrbitCube_State.ty3 }
        CAD_OrbitCube_State.ib = CAD_OrbitCube_State.ty0
        IfCondition GreaterThan(CAD_OrbitCube_State.ty1, CAD_OrbitCube_State.ib) ThenBlock: { CAD_OrbitCube_State.ib = CAD_OrbitCube_State.ty1 }
        IfCondition GreaterThan(CAD_OrbitCube_State.ty2, CAD_OrbitCube_State.ib) ThenBlock: { CAD_OrbitCube_State.ib = CAD_OrbitCube_State.ty2 }
        IfCondition GreaterThan(CAD_OrbitCube_State.ty3, CAD_OrbitCube_State.ib) ThenBlock: { CAD_OrbitCube_State.ib = CAD_OrbitCube_State.ty3 }
        IfCondition LessThan(CAD_OrbitCube_State.ia, 0) ThenBlock: { CAD_OrbitCube_State.ia = 0 }
        IfCondition GreaterThan(CAD_OrbitCube_State.ib, 800) ThenBlock: { CAD_OrbitCube_State.ib = 800 }
        IfCondition GreaterThan(Subtract(CAD_OrbitCube_State.ib, CAD_OrbitCube_State.ia), 200) ThenBlock: { ReturnValue(0) }
        WhileLoop LessEqual(CAD_OrbitCube_State.ia, CAD_OrbitCube_State.ib) {
            CAD_OrbitCube_State.qleft = 100000
            CAD_OrbitCube_State.qright = Subtract(0, 100000)
            CAD_OrbitCube.AccumEdge(CAD_OrbitCube_State.tx0, CAD_OrbitCube_State.ty0, CAD_OrbitCube_State.tx1, CAD_OrbitCube_State.ty1, CAD_OrbitCube_State.ia)
            CAD_OrbitCube.AccumEdge(CAD_OrbitCube_State.tx1, CAD_OrbitCube_State.ty1, CAD_OrbitCube_State.tx2, CAD_OrbitCube_State.ty2, CAD_OrbitCube_State.ia)
            CAD_OrbitCube.AccumEdge(CAD_OrbitCube_State.tx2, CAD_OrbitCube_State.ty2, CAD_OrbitCube_State.tx3, CAD_OrbitCube_State.ty3, CAD_OrbitCube_State.ia)
            CAD_OrbitCube.AccumEdge(CAD_OrbitCube_State.tx3, CAD_OrbitCube_State.ty3, CAD_OrbitCube_State.tx0, CAD_OrbitCube_State.ty0, CAD_OrbitCube_State.ia)
            IfCondition LessEqual(CAD_OrbitCube_State.qleft, CAD_OrbitCube_State.qright) ThenBlock: {
                CAD_OrbitCube.FillSpan(CAD_OrbitCube_State.qleft, CAD_OrbitCube_State.qright, CAD_OrbitCube_State.ia)
            }
            CAD_OrbitCube_State.ia = Add(CAD_OrbitCube_State.ia, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.DrawFace {
    Input: face: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube_State.fi = face
        CAD_OrbitCube.LoadFace(CAD_OrbitCube_State.fi)
        IfCondition LessEqual(CAD_OrbitCube.QuadArea(), 0) ThenBlock: { ReturnValue(0) }
        col = FB_RGB(74, 140, 255)
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 0) ThenBlock: { col = FB_RGB(40, 210, 255) }
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 1) ThenBlock: { col = FB_RGB(40, 210, 255) }
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 2) ThenBlock: { col = FB_RGB(74, 140, 255) }
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 3) ThenBlock: { col = FB_RGB(74, 140, 255) }
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 4) ThenBlock: { col = FB_RGB(24, 34, 64) }
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 5) ThenBlock: { col = FB_RGB(226, 92, 216) }
        CAD_OrbitCube_State.col = col
        CAD_OrbitCube.FillQuad()
        blk = FB_RGB(255, 255, 255)
        FB_Line(CAD_OrbitCube_State.tx0, CAD_OrbitCube_State.ty0, CAD_OrbitCube_State.tx1, CAD_OrbitCube_State.ty1, blk)
        FB_Line(CAD_OrbitCube_State.tx1, CAD_OrbitCube_State.ty1, CAD_OrbitCube_State.tx2, CAD_OrbitCube_State.ty2, blk)
        FB_Line(CAD_OrbitCube_State.tx2, CAD_OrbitCube_State.ty2, CAD_OrbitCube_State.tx3, CAD_OrbitCube_State.ty3, blk)
        FB_Line(CAD_OrbitCube_State.tx3, CAD_OrbitCube_State.ty3, CAD_OrbitCube_State.tx0, CAD_OrbitCube_State.ty0, blk)
        CAD_OrbitCube_State.sx = Divide(Add(Add(Add(CAD_OrbitCube_State.tx0, CAD_OrbitCube_State.tx1), CAD_OrbitCube_State.tx2), CAD_OrbitCube_State.tx3), 4)
        CAD_OrbitCube_State.sy = Divide(Add(Add(Add(CAD_OrbitCube_State.ty0, CAD_OrbitCube_State.ty1), CAD_OrbitCube_State.ty2), CAD_OrbitCube_State.ty3), 4)
        lab = "RIGHT"
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 1) ThenBlock: { lab = "LEFT" }
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 2) ThenBlock: { lab = "FRONT" }
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 3) ThenBlock: { lab = "BACK" }
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 4) ThenBlock: { lab = "TOP" }
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 5) ThenBlock: { lab = "BOTTOM" }
        tc = FB_RGB(255, 255, 255)
        IfCondition EqualTo(CAD_OrbitCube_State.fi, 5) ThenBlock: { tc = FB_RGB(0, 0, 0) }
        FB_DrawString(Subtract(CAD_OrbitCube_State.sx, 14), Subtract(CAD_OrbitCube_State.sy, 4), lab, tc, -1)
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.DrawEdge {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube_State.ia = a
        CAD_OrbitCube_State.ib = b
        CAD_OrbitCube.PutCorner(CAD_OrbitCube_State.ia)
        CAD_OrbitCube.ToScreen()
        CAD_OrbitCube_State.tx0 = CAD_OrbitCube_State.sx
        CAD_OrbitCube_State.ty0 = CAD_OrbitCube_State.sy
        CAD_OrbitCube.PutCorner(CAD_OrbitCube_State.ib)
        CAD_OrbitCube.ToScreen()
        FB_Line(CAD_OrbitCube_State.tx0, CAD_OrbitCube_State.ty0, CAD_OrbitCube_State.sx, CAD_OrbitCube_State.sy, FB_RGB(0, 0, 0))
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.Draw {
    Output: Integer
    Body: {
        CAD_OrbitCube.Recenter()
        CAD_OrbitCube_State.pass = 0
        WhileLoop LessThan(CAD_OrbitCube_State.pass, 6) {
            CAD_OrbitCube.DrawFace(CAD_OrbitCube_State.pass)
            CAD_OrbitCube_State.pass = Add(CAD_OrbitCube_State.pass, 1)
        }
        CAD_OrbitCube.DrawEdge(0, 1)
        CAD_OrbitCube.DrawEdge(1, 2)
        CAD_OrbitCube.DrawEdge(2, 3)
        CAD_OrbitCube.DrawEdge(3, 0)
        CAD_OrbitCube.DrawEdge(4, 5)
        CAD_OrbitCube.DrawEdge(5, 6)
        CAD_OrbitCube.DrawEdge(6, 7)
        CAD_OrbitCube.DrawEdge(7, 4)
        CAD_OrbitCube.DrawEdge(0, 4)
        CAD_OrbitCube.DrawEdge(1, 5)
        CAD_OrbitCube.DrawEdge(2, 6)
        CAD_OrbitCube.DrawEdge(3, 7)
        CAD_OrbitCube_State.sx = Subtract(CAD_OrbitCube_State.cx, 16)
        CAD_OrbitCube_State.sy = Add(CAD_OrbitCube_State.cy, 68)
        FB_FillRect(CAD_OrbitCube_State.sx, CAD_OrbitCube_State.sy, 32, 14, FB_RGB(0, 0, 0))
        FB_DrawString(Add(CAD_OrbitCube_State.sx, 6), Add(CAD_OrbitCube_State.sy, 2), "ISO", FB_RGB(255, 255, 255), -1)
        ReturnValue(0)
    }
}

Function.CAD_OrbitCube.InQuad {
    Input: face: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube.LoadFace(face)
        c = 0
        CAD_OrbitCube_State.ia = 0
        WhileLoop LessThan(CAD_OrbitCube_State.ia, 4) {
            IfCondition EqualTo(CAD_OrbitCube_State.ia, 0) ThenBlock: {
                CAD_OrbitCube_State.dx = CAD_OrbitCube_State.tx0
                CAD_OrbitCube_State.dy = CAD_OrbitCube_State.ty0
                CAD_OrbitCube_State.sx = CAD_OrbitCube_State.tx1
                CAD_OrbitCube_State.sy = CAD_OrbitCube_State.ty1
            }
            IfCondition EqualTo(CAD_OrbitCube_State.ia, 1) ThenBlock: {
                CAD_OrbitCube_State.dx = CAD_OrbitCube_State.tx1
                CAD_OrbitCube_State.dy = CAD_OrbitCube_State.ty1
                CAD_OrbitCube_State.sx = CAD_OrbitCube_State.tx2
                CAD_OrbitCube_State.sy = CAD_OrbitCube_State.ty2
            }
            IfCondition EqualTo(CAD_OrbitCube_State.ia, 2) ThenBlock: {
                CAD_OrbitCube_State.dx = CAD_OrbitCube_State.tx2
                CAD_OrbitCube_State.dy = CAD_OrbitCube_State.ty2
                CAD_OrbitCube_State.sx = CAD_OrbitCube_State.tx3
                CAD_OrbitCube_State.sy = CAD_OrbitCube_State.ty3
            }
            IfCondition EqualTo(CAD_OrbitCube_State.ia, 3) ThenBlock: {
                CAD_OrbitCube_State.dx = CAD_OrbitCube_State.tx3
                CAD_OrbitCube_State.dy = CAD_OrbitCube_State.ty3
                CAD_OrbitCube_State.sx = CAD_OrbitCube_State.tx0
                CAD_OrbitCube_State.sy = CAD_OrbitCube_State.ty0
            }
            a = 0
            IfCondition GreaterThan(CAD_OrbitCube_State.dy, CAD_OrbitCube_State.hy) ThenBlock: { a = 1 }
            b = 0
            IfCondition GreaterThan(CAD_OrbitCube_State.sy, CAD_OrbitCube_State.hy) ThenBlock: { b = 1 }
            IfCondition NotEqual(a, b) ThenBlock: {
                tden = Subtract(CAD_OrbitCube_State.sy, CAD_OrbitCube_State.dy)
                IfCondition NotEqual(tden, 0) ThenBlock: {
                    xt = Add(CAD_OrbitCube_State.dx, Divide(Multiply(Subtract(CAD_OrbitCube_State.hy, CAD_OrbitCube_State.dy), Subtract(CAD_OrbitCube_State.sx, CAD_OrbitCube_State.dx)), tden))
                    IfCondition LessThan(CAD_OrbitCube_State.hx, xt) ThenBlock: { c = Subtract(1, c) }
                }
            }
            CAD_OrbitCube_State.ia = Add(CAD_OrbitCube_State.ia, 1)
        }
        ReturnValue(c)
    }
}

Function.CAD_OrbitCube.Hit {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube_State.hx = px
        CAD_OrbitCube_State.hy = py
        CAD_OrbitCube.Recenter()
        CAD_OrbitCube_State.sx = Subtract(CAD_OrbitCube_State.cx, 16)
        CAD_OrbitCube_State.sy = Add(CAD_OrbitCube_State.cy, 68)
        IfCondition GreaterEqual(CAD_OrbitCube_State.hx, CAD_OrbitCube_State.sx) ThenBlock: {
            IfCondition LessThan(CAD_OrbitCube_State.hx, Add(CAD_OrbitCube_State.sx, 32)) ThenBlock: {
                IfCondition GreaterEqual(CAD_OrbitCube_State.hy, CAD_OrbitCube_State.sy) ThenBlock: {
                    IfCondition LessThan(CAD_OrbitCube_State.hy, Add(CAD_OrbitCube_State.sy, 14)) ThenBlock: { ReturnValue(0) }
                }
            }
        }
        CAD_OrbitCube_State.best = -1
        CAD_OrbitCube_State.bd = 0x4059000000000000
        CAD_OrbitCube_State.pass = 0
        WhileLoop LessThan(CAD_OrbitCube_State.pass, 6) {
            IfCondition EqualTo(CAD_OrbitCube.InQuad(CAD_OrbitCube_State.pass), 1) ThenBlock: {
                IfCondition GreaterThan(CAD_OrbitCube.QuadArea(), 0) ThenBlock: {
                    CAD_OrbitCube_State.tmp = CAD_OrbitCube.FaceDepth(CAD_OrbitCube_State.pass)
                    IfCondition EqualTo(CAD_Num.Le(CAD_OrbitCube_State.tmp, CAD_OrbitCube_State.bd), 1) ThenBlock: {
                        CAD_OrbitCube_State.best = CAD_OrbitCube_State.pass
                        CAD_OrbitCube_State.bd = CAD_OrbitCube_State.tmp
                    }
                }
            }
            CAD_OrbitCube_State.pass = Add(CAD_OrbitCube_State.pass, 1)
        }
        IfCondition EqualTo(CAD_OrbitCube_State.best, 0) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(CAD_OrbitCube_State.best, 1) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(CAD_OrbitCube_State.best, 2) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(CAD_OrbitCube_State.best, 3) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(CAD_OrbitCube_State.best, 4) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_OrbitCube_State.best, 5) ThenBlock: { ReturnValue(7) }
        ReturnValue(-1)
    }
}

Function.CAD_OrbitCube.Dragging {
    Output: Integer
    Body: {
        ReturnValue(CAD_OrbitCube_State.drag)
    }
}

Function.CAD_OrbitCube.Down {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        CAD_OrbitCube_State.lx = px
        CAD_OrbitCube_State.ly = py
        h = CAD_OrbitCube.Hit(CAD_OrbitCube_State.lx, CAD_OrbitCube_State.ly)
        IfCondition LessThan(h, 0) ThenBlock: { ReturnValue(-1) }
        CAD_OrbitCube_State.drag = 1
        CAD_OrbitCube_State.moved = 0
        ReturnValue(h)
    }
}

Function.CAD_OrbitCube.Move {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_OrbitCube_State.drag, 0) ThenBlock: { ReturnValue(0) }
        CAD_OrbitCube_State.ia = Subtract(px, CAD_OrbitCube_State.lx)
        CAD_OrbitCube_State.ib = Subtract(py, CAD_OrbitCube_State.ly)
        IfCondition GreaterThan(Add(Multiply(CAD_OrbitCube_State.ia, CAD_OrbitCube_State.ia), Multiply(CAD_OrbitCube_State.ib, CAD_OrbitCube_State.ib)), 4) ThenBlock: {
            CAD_OrbitCube_State.moved = 1
        }
        CAD_OrbitCube_State.lx = px
        CAD_OrbitCube_State.ly = py
        IfCondition EqualTo(CAD_Num.IsZero(CAD_OrbitCube_State.step, 0), 1) ThenBlock: {
            CAD_OrbitCube_State.step = 0x3F947AE147AE147B
        }
        CAD_OrbitCube_State.tmp = Float_Mul(Float_FromInt(CAD_OrbitCube_State.ia), CAD_OrbitCube_State.step)
        CAD_OrbitCube_State.yaw = Float_Add(CAD_OrbitCube_State.yaw, CAD_OrbitCube_State.tmp)
        CAD_OrbitCube_State.tmp = Float_Mul(Float_FromInt(CAD_OrbitCube_State.ib), CAD_OrbitCube_State.step)
        CAD_OrbitCube_State.pitch = Float_Add(CAD_OrbitCube_State.pitch, CAD_OrbitCube_State.tmp)
        ReturnValue(CAD_OrbitCube.SetCam(CAD_OrbitCube_State.yaw, CAD_OrbitCube_State.pitch))
    }
}

Function.CAD_OrbitCube.Up {
    Output: Integer
    Body: {
        CAD_OrbitCube_State.drag = 0
        IfCondition EqualTo(CAD_OrbitCube_State.moved, 0) ThenBlock: {
            ReturnValue(CAD_OrbitCube.Hit(CAD_OrbitCube_State.lx, CAD_OrbitCube_State.ly))
        }
        ReturnValue(-2)
    }
}
