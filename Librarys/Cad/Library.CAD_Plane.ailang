// CAD Kernel — CAD.Plane — PlaneFeature recipes (sketch-on-face)
//
// Planes are recipes, not raw face indices. Mode FACE stores:
//   - live face handle (may go stale after rebuild)
//   - owner solid handle
//   - face signature (centroid + normal) for ResolveFaceBySignature
// EvalFrame rebinds face via signature when the live handle is dead.
// Loud miss: returns -1 (does not invent a face).
//
// Modes:
//   0 WORLD_XY  1 OFFSET_Z  2 FRAME  3 FACE (signature rebind)
// SysV: ≤5 Inputs. Flat control flow.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom

// Plane handle layout (Alloc tag 0x21 stride 32):
//  0 mode
//  1-3  ox oy oz   (cache origin)
//  4-6  xx xy xz
//  7-9  yx yy yz
// 10-12 zx zy zz
// 13 d (offset distance bits)
// 14 flip
// 15 face_handle (live; may stale)
// 16 solid_handle (owner for rebind)
// 17 parent_plane (handle at runtime; pid in persist text)
// 18 flags  bit0=sig_valid  bit1=last_eval_failed
// 19 pid (stable id when registered; 0 = none)
// 20-22 sig centroid cx,cy,cz
// 23-25 sig normal nx,ny,nz
// 26 recipe  0 baked  1 offset  2 angleX  3 angleY  4 face
// 27 recipe_ang (radians bits)
// 28-31 reserved

FixedPool.CAD_Plane_State {
    "plane_count": Initialize=0, CanChange=True
    "next_pid":    Initialize=1, CanChange=True
    "rebind_ok":   Initialize=0, CanChange=True
    "rebind_fail": Initialize=0, CanChange=True
}

FixedPool.CAD_Plane_Mode {
    "WORLD_XY":  Initialize=0
    "OFFSET_Z":  Initialize=1
    "FRAME":     Initialize=2
    "FACE":      Initialize=3
}

FixedPool.CAD_Plane_Recipe {
    "NONE":    Initialize=0
    "OFFSET":  Initialize=1
    "ANGLEX":  Initialize=2
    "ANGLEY":  Initialize=3
    "FACE":    Initialize=4
}

Function.CAD_Plane.WriteIdentityFrame {
    Input: out_frame: Address
    Output: Integer
    Body: {
        one = 0x3FF0000000000000
        zro = 0
        ArraySet(out_frame, 0, zro)
        ArraySet(out_frame, 1, zro)
        ArraySet(out_frame, 2, zro)
        ArraySet(out_frame, 3, one)
        ArraySet(out_frame, 4, zro)
        ArraySet(out_frame, 5, zro)
        ArraySet(out_frame, 6, zro)
        ArraySet(out_frame, 7, one)
        ArraySet(out_frame, 8, zro)
        ArraySet(out_frame, 9, zro)
        ArraySet(out_frame, 10, zro)
        ArraySet(out_frame, 11, one)
        ReturnValue(0)
    }
}

Function.CAD_Plane.CopyCacheToFrame {
    Input: plane_h: Integer
    Input: out_frame: Address
    Output: Integer
    Body: {
        ArraySet(out_frame, 0, CAD_Store.Read(plane_h, 1))
        ArraySet(out_frame, 1, CAD_Store.Read(plane_h, 2))
        ArraySet(out_frame, 2, CAD_Store.Read(plane_h, 3))
        ArraySet(out_frame, 3, CAD_Store.Read(plane_h, 4))
        ArraySet(out_frame, 4, CAD_Store.Read(plane_h, 5))
        ArraySet(out_frame, 5, CAD_Store.Read(plane_h, 6))
        ArraySet(out_frame, 6, CAD_Store.Read(plane_h, 7))
        ArraySet(out_frame, 7, CAD_Store.Read(plane_h, 8))
        ArraySet(out_frame, 8, CAD_Store.Read(plane_h, 9))
        ArraySet(out_frame, 9, CAD_Store.Read(plane_h, 10))
        ArraySet(out_frame, 10, CAD_Store.Read(plane_h, 11))
        ArraySet(out_frame, 11, CAD_Store.Read(plane_h, 12))
        ReturnValue(0)
    }
}

Function.CAD_Plane.WriteCacheFromFrame {
    Input: plane_h: Integer
    Input: frame: Address
    Output: Integer
    Body: {
        CAD_Store.Write(plane_h, 1, ArrayGet(frame, 0))
        CAD_Store.Write(plane_h, 2, ArrayGet(frame, 1))
        CAD_Store.Write(plane_h, 3, ArrayGet(frame, 2))
        CAD_Store.Write(plane_h, 4, ArrayGet(frame, 3))
        CAD_Store.Write(plane_h, 5, ArrayGet(frame, 4))
        CAD_Store.Write(plane_h, 6, ArrayGet(frame, 5))
        CAD_Store.Write(plane_h, 7, ArrayGet(frame, 6))
        CAD_Store.Write(plane_h, 8, ArrayGet(frame, 7))
        CAD_Store.Write(plane_h, 9, ArrayGet(frame, 8))
        CAD_Store.Write(plane_h, 10, ArrayGet(frame, 9))
        CAD_Store.Write(plane_h, 11, ArrayGet(frame, 10))
        CAD_Store.Write(plane_h, 12, ArrayGet(frame, 11))
        ReturnValue(0)
    }
}

Function.CAD_Plane.OrthonormalizeFrame {
    Input: fr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(fr, 0) ThenBlock: { ReturnValue(-1) }
        xx = ArrayGet(fr, 3)
        xy = ArrayGet(fr, 4)
        xz = ArrayGet(fr, 5)
        yx = ArrayGet(fr, 6)
        yy = ArrayGet(fr, 7)
        yz = ArrayGet(fr, 8)
        nx = Float_Sub(Float_Mul(xy, yz), Float_Mul(xz, yy))
        ny = Float_Sub(Float_Mul(xz, yx), Float_Mul(xx, yz))
        nz = Float_Sub(Float_Mul(xx, yy), Float_Mul(xy, yx))
        ArraySet(fr, 9, nx)
        ArraySet(fr, 10, ny)
        ArraySet(fr, 11, nz)
        n2 = Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz))
        IfCondition EqualTo(CAD_Num.IsZero(n2, 0), 1) ThenBlock: { ReturnValue(-1) }
        nl = CAD_Num.Sqrt(n2)
        nx = ArrayGet(fr, 9)
        ny = ArrayGet(fr, 10)
        nz = ArrayGet(fr, 11)
        ArraySet(fr, 9, Float_Div(nx, nl))
        ArraySet(fr, 10, Float_Div(ny, nl))
        ArraySet(fr, 11, Float_Div(nz, nl))
        xx = ArrayGet(fr, 3)
        xy = ArrayGet(fr, 4)
        xz = ArrayGet(fr, 5)
        x2 = Float_Add(Float_Add(Float_Mul(xx, xx), Float_Mul(xy, xy)), Float_Mul(xz, xz))
        IfCondition EqualTo(CAD_Num.IsZero(x2, 0), 1) ThenBlock: { ReturnValue(-1) }
        xl = CAD_Num.Sqrt(x2)
        xx = ArrayGet(fr, 3)
        xy = ArrayGet(fr, 4)
        xz = ArrayGet(fr, 5)
        ArraySet(fr, 3, Float_Div(xx, xl))
        ArraySet(fr, 4, Float_Div(xy, xl))
        ArraySet(fr, 5, Float_Div(xz, xl))
        nx = ArrayGet(fr, 9)
        ny = ArrayGet(fr, 10)
        nz = ArrayGet(fr, 11)
        xx = ArrayGet(fr, 3)
        xy = ArrayGet(fr, 4)
        xz = ArrayGet(fr, 5)
        // Y = N × X (unit, right-handed)
        ArraySet(fr, 6, Float_Sub(Float_Mul(ny, xz), Float_Mul(nz, xy)))
        ArraySet(fr, 7, Float_Sub(Float_Mul(nz, xx), Float_Mul(nx, xz)))
        ArraySet(fr, 8, Float_Sub(Float_Mul(nx, xy), Float_Mul(ny, xx)))
        ReturnValue(0)
    }
}

Function.CAD_Plane.FrameFromFacePlane {
    Input: face_pl: Address
    Input: out_frame: Address
    Output: Integer
    Body: {
        ArraySet(out_frame, 0, ArrayGet(face_pl, 1))
        ArraySet(out_frame, 1, ArrayGet(face_pl, 2))
        ArraySet(out_frame, 2, ArrayGet(face_pl, 3))
        ArraySet(out_frame, 3, ArrayGet(face_pl, 4))
        ArraySet(out_frame, 4, ArrayGet(face_pl, 5))
        ArraySet(out_frame, 5, ArrayGet(face_pl, 6))
        ArraySet(out_frame, 6, ArrayGet(face_pl, 7))
        ArraySet(out_frame, 7, ArrayGet(face_pl, 8))
        ArraySet(out_frame, 8, ArrayGet(face_pl, 9))
        ArraySet(out_frame, 9, ArrayGet(face_pl, 10))
        ArraySet(out_frame, 10, ArrayGet(face_pl, 11))
        ArraySet(out_frame, 11, ArrayGet(face_pl, 12))
        CAD_Plane.OrthonormalizeFrame(out_frame)
        ReturnValue(0)
    }
}

// Capture centroid+normal from face into plane slots 20-25; set flags bit0.
Function.CAD_Plane.CaptureFaceSignature {
    Input: plane_h: Integer
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(-1) }
        c = Allocate(32)
        n = Allocate(32)
        IfCondition EqualTo(CAD_Topo.FaceCentroid(face_handle, c), 0) ThenBlock: {
            Deallocate(c, 32)
            Deallocate(n, 32)
            ReturnValue(-1)
        }
        IfCondition EqualTo(CAD_Topo.FaceNormal(face_handle, n), 0) ThenBlock: {
            Deallocate(c, 32)
            Deallocate(n, 32)
            ReturnValue(-1)
        }
        CAD_Store.Write(plane_h, 20, ArrayGet(c, 0))
        CAD_Store.Write(plane_h, 21, ArrayGet(c, 1))
        CAD_Store.Write(plane_h, 22, ArrayGet(c, 2))
        CAD_Store.Write(plane_h, 23, ArrayGet(n, 0))
        CAD_Store.Write(plane_h, 24, ArrayGet(n, 1))
        CAD_Store.Write(plane_h, 25, ArrayGet(n, 2))
        fl = CAD_Store.Read(plane_h, 18)
        CAD_Store.Write(plane_h, 18, BitwiseOr(fl, 1))
        Deallocate(c, 32)
        Deallocate(n, 32)
        ReturnValue(0)
    }
}

// Bind owner solid + assign stable pid if none.
Function.CAD_Plane.BindSolid {
    Input: plane_h: Integer
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Store.Write(plane_h, 16, solid_handle)
        IfCondition EqualTo(CAD_Store.Read(plane_h, 19), 0) ThenBlock: {
            pid = CAD_Plane_State.next_pid
            CAD_Store.Write(plane_h, 19, pid)
            CAD_Plane_State.next_pid = Add(pid, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Plane.CreateWorldXY {
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(33, 32)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, 0)
        fr = Allocate(128)
        CAD_Plane.WriteIdentityFrame(fr)
        CAD_Plane.WriteCacheFromFrame(h, fr)
        Deallocate(fr, 128)
        i = 13
        WhileLoop LessThan(i, 32) {
            CAD_Store.Write(h, i, 0)
            i = Add(i, 1)
        }
        CAD_Plane_State.plane_count = Add(CAD_Plane_State.plane_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Plane.CreateOffsetZ {
    Input: d_r: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(33, 32)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, 1)
        fr = Allocate(128)
        CAD_Plane.WriteIdentityFrame(fr)
        ArraySet(fr, 2, d_r)
        CAD_Plane.WriteCacheFromFrame(h, fr)
        Deallocate(fr, 128)
        i = 13
        WhileLoop LessThan(i, 32) {
            CAD_Store.Write(h, i, 0)
            i = Add(i, 1)
        }
        CAD_Store.Write(h, 13, d_r)
        CAD_Plane_State.plane_count = Add(CAD_Plane_State.plane_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Plane.CreateFromFrame {
    Input: frame_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(frame_addr, 0) ThenBlock: { ReturnValue(0) }
        h = CAD_Store.Alloc(33, 32)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, 2)
        CAD_Plane.WriteCacheFromFrame(h, frame_addr)
        i = 13
        WhileLoop LessThan(i, 32) {
            CAD_Store.Write(h, i, 0)
            i = Add(i, 1)
        }
        CAD_Plane_State.plane_count = Add(CAD_Plane_State.plane_count, 1)
        ReturnValue(h)
    }
}

// Plane from planar face + owner solid (signature + pid for rebind).
Function.CAD_Plane.CreateFromFace {
    Input: face_handle: Integer
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(0) }
        pl = Allocate(128)
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(face_handle, pl), 0) ThenBlock: {
            Deallocate(pl, 128)
            ReturnValue(0)
        }
        fr = Allocate(128)
        CAD_Plane.FrameFromFacePlane(pl, fr)
        h = CAD_Store.Alloc(33, 32)
        IfCondition EqualTo(h, 0) ThenBlock: {
            Deallocate(pl, 128)
            Deallocate(fr, 128)
            ReturnValue(0)
        }
        CAD_Store.Write(h, 0, 3)
        CAD_Plane.WriteCacheFromFrame(h, fr)
        Deallocate(pl, 128)
        Deallocate(fr, 128)
        i = 13
        WhileLoop LessThan(i, 32) {
            CAD_Store.Write(h, i, 0)
            i = Add(i, 1)
        }
        CAD_Store.Write(h, 15, face_handle)
        CAD_Store.Write(h, 26, 4)
        CAD_Plane.BindSolid(h, solid_handle)
        CAD_Plane.CaptureFaceSignature(h, face_handle)
        CAD_Plane_State.plane_count = Add(CAD_Plane_State.plane_count, 1)
        ReturnValue(h)
    }
}

// Rebind live face from signature on solid. Returns 0 ok, -1 miss (loud).
Function.CAD_Plane.RebindFace {
    Input: plane_h: Integer
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        fl = CAD_Store.Read(plane_h, 18)
        IfCondition EqualTo(BitwiseAnd(fl, 1), 0) ThenBlock: { ReturnValue(-1) }
        sig = Allocate(64)
        ArraySet(sig, 0, CAD_Store.Read(plane_h, 20))
        ArraySet(sig, 1, CAD_Store.Read(plane_h, 21))
        ArraySet(sig, 2, CAD_Store.Read(plane_h, 22))
        ArraySet(sig, 3, CAD_Store.Read(plane_h, 23))
        ArraySet(sig, 4, CAD_Store.Read(plane_h, 24))
        ArraySet(sig, 5, CAD_Store.Read(plane_h, 25))
        fh = CAD_Topo.ResolveFaceBySignature(solid_handle, sig)
        Deallocate(sig, 64)
        IfCondition EqualTo(fh, 0) ThenBlock: {
            CAD_Plane_State.rebind_fail = Add(CAD_Plane_State.rebind_fail, 1)
            CAD_Store.Write(plane_h, 18, BitwiseOr(fl, 2))
            ReturnValue(-1)
        }
        CAD_Store.Write(plane_h, 15, fh)
        CAD_Store.Write(plane_h, 16, solid_handle)
        // keep sig_valid only; clear fail bit
        CAD_Store.Write(plane_h, 18, BitwiseOr(BitwiseAnd(fl, 1), 1))
        CAD_Plane.CaptureFaceSignature(plane_h, fh)
        pl = Allocate(128)
        IfCondition EqualTo(CAD_Topo.FaceGetPlane(fh, pl), 0) ThenBlock: {
            fr = Allocate(128)
            CAD_Plane.FrameFromFacePlane(pl, fr)
            CAD_Plane.WriteCacheFromFrame(plane_h, fr)
            Deallocate(fr, 128)
        }
        Deallocate(pl, 128)
        CAD_Plane_State.rebind_ok = Add(CAD_Plane_State.rebind_ok, 1)
        ReturnValue(0)
    }
}

// Eval → out_frame. Returns 0 ok, -1 FACE rebind failed (cache still written as last-known).
Function.CAD_Plane.EvalFrame {
    Input: plane_h: Integer
    Input: out_frame: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: {
            CAD_Plane.WriteIdentityFrame(out_frame)
            ReturnValue(0)
        }
        mode = CAD_Store.Read(plane_h, 0)
        rc = 0
        IfCondition EqualTo(mode, 3) ThenBlock: {
            // bit2 = frame locked at pick (vert-fit + Sketch_0 origin).
            // FaceGetPlane / signature rebind was swapping +Z caps and
            // putting the sketch on a different face than the yellow outline.
            fl0 = CAD_Store.Read(plane_h, 18)
            IfCondition NotEqual(BitwiseAnd(fl0, 4), 0) ThenBlock: {
                // Locked: keep face UV origin. Do not slide O to Sketch_0
                // (that put a side-face sketch at part x=0 / z=0).
                CAD_Plane.CopyCacheToFrame(plane_h, out_frame)
            }
            IfCondition EqualTo(BitwiseAnd(fl0, 4), 0) ThenBlock: {
            fh = CAD_Store.Read(plane_h, 15)
            pl = Allocate(128)
            live = CAD_Topo.FaceGetPlane(fh, pl)
            IfCondition EqualTo(live, 0) ThenBlock: {
                CAD_Plane.FrameFromFacePlane(pl, out_frame)
                CAD_Plane.WriteCacheFromFrame(plane_h, out_frame)
                // refresh signature while face is live
                CAD_Plane.CaptureFaceSignature(plane_h, fh)
            }
            IfCondition NotEqual(live, 0) ThenBlock: {
                // face handle stale — resolve by signature on owner solid
                sh = CAD_Store.Read(plane_h, 16)
                rb = CAD_Plane.RebindFace(plane_h, sh)
                IfCondition EqualTo(rb, 0) ThenBlock: {
                    fh2 = CAD_Store.Read(plane_h, 15)
                    IfCondition EqualTo(CAD_Topo.FaceGetPlane(fh2, pl), 0) ThenBlock: {
                        CAD_Plane.FrameFromFacePlane(pl, out_frame)
                        CAD_Plane.WriteCacheFromFrame(plane_h, out_frame)
                    }
                }
                IfCondition NotEqual(rb, 0) ThenBlock: {
                    // LOUD fail: keep last cache, report -1
                    CAD_Plane.CopyCacheToFrame(plane_h, out_frame)
                    rc = -1
                }
            }
            Deallocate(pl, 128)
            // Unlocked only: slide O to parent origin on this plane.
            par = CAD_Store.Read(plane_h, 17)
            IfCondition NotEqual(par, 0) ThenBlock: {
                IfCondition NotEqual(par, plane_h) ThenBlock: {
                    pfr = Allocate(128)
                    CAD_Plane.EvalFrame(par, pfr)
                    CAD_Plane.ProjectOriginInFrame(pfr, out_frame)
                    CAD_Plane.WriteCacheFromFrame(plane_h, out_frame)
                    Deallocate(pfr, 128)
                }
            }
            }
        }
        IfCondition NotEqual(mode, 3) ThenBlock: {
            rec = CAD_Store.Read(plane_h, 26)
            IfCondition GreaterThan(rec, 0) ThenBlock: {
                IfCondition LessThan(rec, 4) ThenBlock: {
                    CAD_Plane.ApplyRecipe(plane_h)
                }
            }
            CAD_Plane.CopyCacheToFrame(plane_h, out_frame)
            IfCondition EqualTo(mode, 1) ThenBlock: {
                ArraySet(out_frame, 2, CAD_Store.Read(plane_h, 13))
            }
        }
        IfCondition EqualTo(CAD_Store.Read(plane_h, 14), 1) ThenBlock: {
            ArraySet(out_frame, 6, Float_Sub(0, ArrayGet(out_frame, 6)))
            ArraySet(out_frame, 7, Float_Sub(0, ArrayGet(out_frame, 7)))
            ArraySet(out_frame, 8, Float_Sub(0, ArrayGet(out_frame, 8)))
            ArraySet(out_frame, 9, Float_Sub(0, ArrayGet(out_frame, 9)))
            ArraySet(out_frame, 10, Float_Sub(0, ArrayGet(out_frame, 10)))
            ArraySet(out_frame, 11, Float_Sub(0, ArrayGet(out_frame, 11)))
        }
        CAD_Plane.OrthonormalizeFrame(out_frame)
        ReturnValue(rc)
    }
}

Function.CAD_Plane.MapLocal {
    Input: plane_h: Integer
    Input: u_r: Integer
    Input: v_r: Integer
    Input: w_r: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        fr = Allocate(128)
        CAD_Plane.EvalFrame(plane_h, fr)
        ox = ArrayGet(fr, 0)
        oy = ArrayGet(fr, 1)
        oz = ArrayGet(fr, 2)
        ArraySet(out_xyz, 0, Float_Add(ox, Float_Add(Float_Mul(u_r, ArrayGet(fr, 3)), Float_Add(Float_Mul(v_r, ArrayGet(fr, 6)), Float_Mul(w_r, ArrayGet(fr, 9))))))
        ArraySet(out_xyz, 1, Float_Add(oy, Float_Add(Float_Mul(u_r, ArrayGet(fr, 4)), Float_Add(Float_Mul(v_r, ArrayGet(fr, 7)), Float_Mul(w_r, ArrayGet(fr, 10))))))
        ArraySet(out_xyz, 2, Float_Add(oz, Float_Add(Float_Mul(u_r, ArrayGet(fr, 5)), Float_Add(Float_Mul(v_r, ArrayGet(fr, 8)), Float_Mul(w_r, ArrayGet(fr, 11))))))
        Deallocate(fr, 128)
        ReturnValue(0)
    }
}

Function.CAD_Plane.OriginZ {
    Input: plane_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(0) }
        fr = Allocate(128)
        CAD_Plane.EvalFrame(plane_h, fr)
        z = ArrayGet(fr, 2)
        Deallocate(fr, 128)
        ReturnValue(z)
    }
}

Function.CAD_Plane.GetPid {
    Input: plane_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(plane_h, 19))
    }
}

// Lineage: every plane except Sketch_0 names its parent (slot 17).
Function.CAD_Plane.GetParent {
    Input: plane_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(plane_h, 17))
    }
}

Function.CAD_Plane.SetParent {
    Input: plane_h: Integer
    Input: parent_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Store.Write(plane_h, 17, parent_h)
        ReturnValue(0)
    }
}

// Assign pid if missing (bare planes).
Function.CAD_Plane.EnsurePid {
    Input: plane_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Store.Read(plane_h, 19), 0) ThenBlock: {
            pid = CAD_Plane_State.next_pid
            CAD_Store.Write(plane_h, 19, pid)
            CAD_Plane_State.next_pid = Add(pid, 1)
        }
        ReturnValue(CAD_Store.Read(plane_h, 19))
    }
}

// -------------------------------------------------------------------------
// Bare construction planes (loft / draft setup — no solid face required)
// -------------------------------------------------------------------------

// Zero-init slots 13..31 then set mode FRAME (2).
Function.CAD_Plane.AllocFramePlane {
    Input: frame_addr: Address
    Output: Integer
    Body: {
        h = CAD_Plane.CreateFromFrame(frame_addr)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Plane.EnsurePid(h)
        ReturnValue(h)
    }
}

// Datum XZ: O=0, X=+X, Y=+Z, N=+Y (right-handed).
Function.CAD_Plane.CreateDatumXZ {
    Output: Integer
    Body: {
        fr = Allocate(128)
        one = 0x3FF0000000000000
        zro = 0
        ArraySet(fr, 0, zro)
        ArraySet(fr, 1, zro)
        ArraySet(fr, 2, zro)
        ArraySet(fr, 3, one)
        ArraySet(fr, 4, zro)
        ArraySet(fr, 5, zro)
        ArraySet(fr, 6, zro)
        ArraySet(fr, 7, zro)
        ArraySet(fr, 8, one)
        ArraySet(fr, 9, zro)
        ArraySet(fr, 10, one)
        ArraySet(fr, 11, zro)
        h = CAD_Plane.AllocFramePlane(fr)
        Deallocate(fr, 128)
        ReturnValue(h)
    }
}

// Datum YZ: O=0, X=+Y, Y=+Z, N=+X.
Function.CAD_Plane.CreateDatumYZ {
    Output: Integer
    Body: {
        fr = Allocate(128)
        one = 0x3FF0000000000000
        zro = 0
        ArraySet(fr, 0, zro)
        ArraySet(fr, 1, zro)
        ArraySet(fr, 2, zro)
        ArraySet(fr, 3, zro)
        ArraySet(fr, 4, one)
        ArraySet(fr, 5, zro)
        ArraySet(fr, 6, zro)
        ArraySet(fr, 7, zro)
        ArraySet(fr, 8, one)
        ArraySet(fr, 9, one)
        ArraySet(fr, 10, zro)
        ArraySet(fr, 11, zro)
        h = CAD_Plane.AllocFramePlane(fr)
        Deallocate(fr, 128)
        ReturnValue(h)
    }
}

// Offset parent plane along its normal by dist_r (can be negative).
// Baked FRAME; parent stored in slot 17, dist in 13 for recipe audit.
Function.CAD_Plane.CreateOffset {
    Input: parent_h: Integer
    Input: dist_r: Integer
    Output: Integer
    Body: {
        fr = Allocate(128)
        IfCondition EqualTo(parent_h, 0) ThenBlock: {
            CAD_Plane.WriteIdentityFrame(fr)
        }
        IfCondition NotEqual(parent_h, 0) ThenBlock: {
            CAD_Plane.EvalFrame(parent_h, fr)
        }
        // O' = O + d * N
        ox = Float_Add(ArrayGet(fr, 0), Float_Mul(dist_r, ArrayGet(fr, 9)))
        oy = Float_Add(ArrayGet(fr, 1), Float_Mul(dist_r, ArrayGet(fr, 10)))
        oz = Float_Add(ArrayGet(fr, 2), Float_Mul(dist_r, ArrayGet(fr, 11)))
        ArraySet(fr, 0, ox)
        ArraySet(fr, 1, oy)
        ArraySet(fr, 2, oz)
        h = CAD_Plane.AllocFramePlane(fr)
        Deallocate(fr, 128)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 13, dist_r)
        CAD_Store.Write(h, 17, parent_h)
        CAD_Store.Write(h, 26, 1)
        ReturnValue(h)
    }
}

// Rotate parent frame about local X by ang_r (radians). Y,Z revolve; X fixed.
// Facing pair: offset then angle π about local X (or Flip).
Function.CAD_Plane.CreateAngleX {
    Input: parent_h: Integer
    Input: ang_r: Integer
    Output: Integer
    Body: {
        fr = Allocate(128)
        IfCondition EqualTo(parent_h, 0) ThenBlock: {
            CAD_Plane.WriteIdentityFrame(fr)
        }
        IfCondition NotEqual(parent_h, 0) ThenBlock: {
            CAD_Plane.EvalFrame(parent_h, fr)
        }
        c = CAD_Geom.Cos(ang_r)
        s = CAD_Geom.Sin(ang_r)
        yx = ArrayGet(fr, 6)
        yy = ArrayGet(fr, 7)
        yz = ArrayGet(fr, 8)
        zx = ArrayGet(fr, 9)
        zy = ArrayGet(fr, 10)
        zz = ArrayGet(fr, 11)
        // Y' = Y c + Z s    (Rodrigues about X in local: Y→Yc+Zs, Z→-Ys+Zc)
        // For RH rotate about +X by θ: Y' = Y cosθ + Z sinθ, Z' = -Y sinθ + Z cosθ
        ArraySet(fr, 6, Float_Add(Float_Mul(yx, c), Float_Mul(zx, s)))
        ArraySet(fr, 7, Float_Add(Float_Mul(yy, c), Float_Mul(zy, s)))
        ArraySet(fr, 8, Float_Add(Float_Mul(yz, c), Float_Mul(zz, s)))
        ArraySet(fr, 9, Float_Sub(Float_Mul(zx, c), Float_Mul(yx, s)))
        ArraySet(fr, 10, Float_Sub(Float_Mul(zy, c), Float_Mul(yy, s)))
        ArraySet(fr, 11, Float_Sub(Float_Mul(zz, c), Float_Mul(yz, s)))
        h = CAD_Plane.AllocFramePlane(fr)
        Deallocate(fr, 128)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 17, parent_h)
        CAD_Store.Write(h, 26, 2)
        CAD_Store.Write(h, 27, ang_r)
        ReturnValue(h)
    }
}

// Rotate about local Y by ang_r.
Function.CAD_Plane.CreateAngleY {
    Input: parent_h: Integer
    Input: ang_r: Integer
    Output: Integer
    Body: {
        fr = Allocate(128)
        IfCondition EqualTo(parent_h, 0) ThenBlock: {
            CAD_Plane.WriteIdentityFrame(fr)
        }
        IfCondition NotEqual(parent_h, 0) ThenBlock: {
            CAD_Plane.EvalFrame(parent_h, fr)
        }
        c = CAD_Geom.Cos(ang_r)
        s = CAD_Geom.Sin(ang_r)
        xx = ArrayGet(fr, 3)
        xy = ArrayGet(fr, 4)
        xz = ArrayGet(fr, 5)
        zx = ArrayGet(fr, 9)
        zy = ArrayGet(fr, 10)
        zz = ArrayGet(fr, 11)
        // X' = X cos - Z sin; Z' = X sin + Z cos
        ArraySet(fr, 3, Float_Sub(Float_Mul(xx, c), Float_Mul(zx, s)))
        ArraySet(fr, 4, Float_Sub(Float_Mul(xy, c), Float_Mul(zy, s)))
        ArraySet(fr, 5, Float_Sub(Float_Mul(xz, c), Float_Mul(zz, s)))
        ArraySet(fr, 9, Float_Add(Float_Mul(xx, s), Float_Mul(zx, c)))
        ArraySet(fr, 10, Float_Add(Float_Mul(xy, s), Float_Mul(zy, c)))
        ArraySet(fr, 11, Float_Add(Float_Mul(xz, s), Float_Mul(zz, c)))
        h = CAD_Plane.AllocFramePlane(fr)
        Deallocate(fr, 128)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 17, parent_h)
        CAD_Store.Write(h, 26, 3)
        CAD_Store.Write(h, 27, ang_r)
        ReturnValue(h)
    }
}

// Flip is a recipe flag (slot 14). Cache stays unflipped; EvalFrame applies it.
// Does not change mode — FACE / OFFSET recipes stay recipes.
Function.CAD_Plane.Flip {
    Input: plane_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(-1) }
        fl = CAD_Store.Read(plane_h, 14)
        CAD_Store.Write(plane_h, 14, Subtract(1, fl))
        ReturnValue(0)
    }
}

// Translate origin in plane UV: O' = O + du*X + dv*Y (+ dw*N).
Function.CAD_Plane.TranslateLocal {
    Input: plane_h: Integer
    Input: du_r: Integer
    Input: dv_r: Integer
    Input: dw_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(-1) }
        fr = Allocate(128)
        CAD_Plane.EvalFrame(plane_h, fr)
        ox = ArrayGet(fr, 0)
        oy = ArrayGet(fr, 1)
        oz = ArrayGet(fr, 2)
        ArraySet(fr, 0, Float_Add(ox, Float_Add(Float_Mul(du_r, ArrayGet(fr, 3)), Float_Add(Float_Mul(dv_r, ArrayGet(fr, 6)), Float_Mul(dw_r, ArrayGet(fr, 9))))))
        ArraySet(fr, 1, Float_Add(oy, Float_Add(Float_Mul(du_r, ArrayGet(fr, 4)), Float_Add(Float_Mul(dv_r, ArrayGet(fr, 7)), Float_Mul(dw_r, ArrayGet(fr, 10))))))
        ArraySet(fr, 2, Float_Add(oz, Float_Add(Float_Mul(du_r, ArrayGet(fr, 5)), Float_Add(Float_Mul(dv_r, ArrayGet(fr, 8)), Float_Mul(dw_r, ArrayGet(fr, 11))))))
        CAD_Plane.WriteCacheFromFrame(plane_h, fr)
        CAD_Store.Write(plane_h, 0, 2)
        Deallocate(fr, 128)
        ReturnValue(0)
    }
}

// Put fr's origin at the projection of pfr's origin onto fr's plane (N = fr Z).
Function.CAD_Plane.ProjectOriginInFrame {
    Input: pfr: Address
    Input: fr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(pfr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(fr, 0) ThenBlock: { ReturnValue(-1) }
        px = ArrayGet(pfr, 0)
        py = ArrayGet(pfr, 1)
        pz = ArrayGet(pfr, 2)
        ox = ArrayGet(fr, 0)
        oy = ArrayGet(fr, 1)
        oz = ArrayGet(fr, 2)
        nx = ArrayGet(fr, 9)
        ny = ArrayGet(fr, 10)
        nz = ArrayGet(fr, 11)
        dn = Float_Add(Float_Add(Float_Mul(Float_Sub(px, ox), nx), Float_Mul(Float_Sub(py, oy), ny)), Float_Mul(Float_Sub(pz, oz), nz))
        ArraySet(fr, 0, Float_Sub(px, Float_Mul(dn, nx)))
        ArraySet(fr, 1, Float_Sub(py, Float_Mul(dn, ny)))
        ArraySet(fr, 2, Float_Sub(pz, Float_Mul(dn, nz)))
        ReturnValue(0)
    }
}

Function.CAD_Plane.GetMode {
    Input: plane_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(CAD_Store.Read(plane_h, 0))
    }
}

Function.CAD_Plane.GetRecipe {
    Input: plane_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(plane_h, 26))
    }
}

Function.CAD_Plane.GetFaceHandle {
    Input: plane_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(plane_h, 15))
    }
}

Function.CAD_Plane.GetFlip {
    Input: plane_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(plane_h, 14))
    }
}

Function.CAD_Plane.SetPid {
    Input: plane_h: Integer
    Input: pid: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(plane_h, 19, pid)
        IfCondition GreaterEqual(pid, CAD_Plane_State.next_pid) ThenBlock: {
            CAD_Plane_State.next_pid = Add(pid, 1)
        }
        ReturnValue(pid)
    }
}

// Recompute cache from parent + recipe (offset / angle). FACE is EvalFrame's job.
// Does not apply flip — EvalFrame does that after copy.
Function.CAD_Plane.ApplyRecipe {
    Input: plane_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(-1) }
        rec = CAD_Store.Read(plane_h, 26)
        IfCondition EqualTo(rec, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(rec, 4) ThenBlock: { ReturnValue(0) }
        parent = CAD_Store.Read(plane_h, 17)
        IfCondition EqualTo(parent, plane_h) ThenBlock: { ReturnValue(-1) }
        fr = Allocate(128)
        IfCondition EqualTo(parent, 0) ThenBlock: {
            CAD_Plane.WriteIdentityFrame(fr)
        }
        IfCondition NotEqual(parent, 0) ThenBlock: {
            CAD_Plane.EvalFrame(parent, fr)
        }
        IfCondition EqualTo(rec, 1) ThenBlock: {
            d = CAD_Store.Read(plane_h, 13)
            ArraySet(fr, 0, Float_Add(ArrayGet(fr, 0), Float_Mul(d, ArrayGet(fr, 9))))
            ArraySet(fr, 1, Float_Add(ArrayGet(fr, 1), Float_Mul(d, ArrayGet(fr, 10))))
            ArraySet(fr, 2, Float_Add(ArrayGet(fr, 2), Float_Mul(d, ArrayGet(fr, 11))))
        }
        IfCondition EqualTo(rec, 2) ThenBlock: {
            ang = CAD_Store.Read(plane_h, 27)
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            yx = ArrayGet(fr, 6)
            yy = ArrayGet(fr, 7)
            yz = ArrayGet(fr, 8)
            zx = ArrayGet(fr, 9)
            zy = ArrayGet(fr, 10)
            zz = ArrayGet(fr, 11)
            ArraySet(fr, 6, Float_Add(Float_Mul(yx, c), Float_Mul(zx, s)))
            ArraySet(fr, 7, Float_Add(Float_Mul(yy, c), Float_Mul(zy, s)))
            ArraySet(fr, 8, Float_Add(Float_Mul(yz, c), Float_Mul(zz, s)))
            ArraySet(fr, 9, Float_Sub(Float_Mul(zx, c), Float_Mul(yx, s)))
            ArraySet(fr, 10, Float_Sub(Float_Mul(zy, c), Float_Mul(yy, s)))
            ArraySet(fr, 11, Float_Sub(Float_Mul(zz, c), Float_Mul(yz, s)))
        }
        IfCondition EqualTo(rec, 3) ThenBlock: {
            ang = CAD_Store.Read(plane_h, 27)
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            xx = ArrayGet(fr, 3)
            xy = ArrayGet(fr, 4)
            xz = ArrayGet(fr, 5)
            zx = ArrayGet(fr, 9)
            zy = ArrayGet(fr, 10)
            zz = ArrayGet(fr, 11)
            ArraySet(fr, 3, Float_Sub(Float_Mul(xx, c), Float_Mul(zx, s)))
            ArraySet(fr, 4, Float_Sub(Float_Mul(xy, c), Float_Mul(zy, s)))
            ArraySet(fr, 5, Float_Sub(Float_Mul(xz, c), Float_Mul(zz, s)))
            ArraySet(fr, 9, Float_Add(Float_Mul(xx, s), Float_Mul(zx, c)))
            ArraySet(fr, 10, Float_Add(Float_Mul(xy, s), Float_Mul(zy, c)))
            ArraySet(fr, 11, Float_Add(Float_Mul(xz, s), Float_Mul(zz, c)))
        }
        CAD_Plane.WriteCacheFromFrame(plane_h, fr)
        Deallocate(fr, 128)
        ReturnValue(0)
    }
}

Function.CAD_Plane.AppendDec {
    Input: dst: Address
    Input: pos: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(val, 0) ThenBlock: {
            SetByte(dst, pos, 45)
            pos = Add(pos, 1)
            val = Subtract(0, val)
        }
        IfCondition EqualTo(val, 0) ThenBlock: {
            SetByte(dst, pos, 48)
            ReturnValue(Add(pos, 1))
        }
        tmp = Allocate(24)
        n = 0
        WhileLoop GreaterThan(val, 0) {
            SetByte(tmp, n, Add(48, Modulo(val, 10)))
            val = Divide(val, 10)
            n = Add(n, 1)
        }
        i = Subtract(n, 1)
        WhileLoop GreaterEqual(i, 0) {
            SetByte(dst, pos, GetByte(tmp, i))
            pos = Add(pos, 1)
            i = Subtract(i, 1)
        }
        Deallocate(tmp, 24)
        ReturnValue(pos)
    }
}

Function.CAD_Plane.AppendHex64 {
    Input: dst: Address
    Input: pos: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 16) {
            sh = Multiply(4, Subtract(15, i))
            nib = BitwiseAnd(RightShift(val, sh), 15)
            ch = Add(48, nib)
            IfCondition GreaterThan(nib, 9) ThenBlock: {
                ch = Add(87, nib)
            }
            SetByte(dst, pos, ch)
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        ReturnValue(pos)
    }
}

Function.CAD_Plane.SkipSp {
    Input: buf: Address
    Input: i: Integer
    Output: Integer
    Body: {
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                ok = 0
                IfCondition EqualTo(ch, 32) ThenBlock: { ok = 1 }
                IfCondition EqualTo(ch, 9) ThenBlock: { ok = 1 }
                IfCondition EqualTo(ch, 10) ThenBlock: { ok = 1 }
                IfCondition EqualTo(ch, 13) ThenBlock: { ok = 1 }
                IfCondition EqualTo(ok, 0) ThenBlock: { done = 1 }
                IfCondition EqualTo(ok, 1) ThenBlock: { i = Add(i, 1) }
            }
        }
        ReturnValue(i)
    }
}

Function.CAD_Plane.ParseDec {
    Input: buf: Address
    Input: i: Integer
    Input: out_addr: Address
    Output: Integer
    Body: {
        i = CAD_Plane.SkipSp(buf, i)
        neg = 0
        IfCondition EqualTo(GetByte(buf, i), 45) ThenBlock: {
            neg = 1
            i = Add(i, 1)
        }
        val = 0
        got = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: {
                    val = Add(Multiply(val, 10), Subtract(ch, 48))
                    got = 1
                    i = Add(i, 1)
                }
                IfCondition GreaterThan(ch, 57) ThenBlock: { done = 1 }
            }
            IfCondition LessThan(ch, 48) ThenBlock: { done = 1 }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(neg, 1) ThenBlock: { val = Subtract(0, val) }
        ArraySet(out_addr, 0, val)
        ReturnValue(i)
    }
}

Function.CAD_Plane.ParseHex {
    Input: buf: Address
    Input: i: Integer
    Input: out_addr: Address
    Output: Integer
    Body: {
        i = CAD_Plane.SkipSp(buf, i)
        val = 0
        n = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ch = GetByte(buf, i)
            nib = -1
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: { nib = Subtract(ch, 48) }
            }
            IfCondition GreaterEqual(ch, 97) ThenBlock: {
                IfCondition LessEqual(ch, 102) ThenBlock: { nib = Subtract(ch, 87) }
            }
            IfCondition GreaterEqual(ch, 65) ThenBlock: {
                IfCondition LessEqual(ch, 70) ThenBlock: { nib = Subtract(ch, 55) }
            }
            IfCondition EqualTo(nib, -1) ThenBlock: { done = 1 }
            IfCondition GreaterThan(n, 15) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                val = BitwiseOr(LeftShift(val, 4), nib)
                n = Add(n, 1)
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(-1) }
        ArraySet(out_addr, 0, val)
        ReturnValue(i)
    }
}

// One persist line. Parent stored as pid (not handle).
Function.CAD_Plane.ExportLine {
    Input: plane_h: Integer
    Input: buf: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(plane_h, 0) ThenBlock: { ReturnValue(pos) }
        SetByte(buf, pos, 80)
        pos = Add(pos, 1)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = CAD_Plane.AppendDec(buf, pos, CAD_Store.Read(plane_h, 19))
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = CAD_Plane.AppendDec(buf, pos, CAD_Store.Read(plane_h, 0))
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pp = 0
        par = CAD_Store.Read(plane_h, 17)
        IfCondition NotEqual(par, 0) ThenBlock: {
            pp = CAD_Store.Read(par, 19)
        }
        pos = CAD_Plane.AppendDec(buf, pos, pp)
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = CAD_Plane.AppendDec(buf, pos, CAD_Store.Read(plane_h, 26))
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = CAD_Plane.AppendDec(buf, pos, CAD_Store.Read(plane_h, 14))
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = CAD_Plane.AppendDec(buf, pos, CAD_Store.Read(plane_h, 18))
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = CAD_Plane.AppendHex64(buf, pos, CAD_Store.Read(plane_h, 13))
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)
        pos = CAD_Plane.AppendHex64(buf, pos, CAD_Store.Read(plane_h, 27))
        sl = 1
        WhileLoop LessEqual(sl, 12) {
            SetByte(buf, pos, 32)
            pos = Add(pos, 1)
            pos = CAD_Plane.AppendHex64(buf, pos, CAD_Store.Read(plane_h, sl))
            sl = Add(sl, 1)
        }
        sl = 20
        WhileLoop LessEqual(sl, 25) {
            SetByte(buf, pos, 32)
            pos = Add(pos, 1)
            pos = CAD_Plane.AppendHex64(buf, pos, CAD_Store.Read(plane_h, sl))
            sl = Add(sl, 1)
        }
        SetByte(buf, pos, 10)
        pos = Add(pos, 1)
        ReturnValue(pos)
    }
}

// Parse one P-line → new plane handle (parent slot still a pid). Writes handle to out_h[0].
Function.CAD_Plane.ParseLine {
    Input: buf: Address
    Input: i: Integer
    Input: out_h: Address
    Output: Integer
    Body: {
        i = CAD_Plane.SkipSp(buf, i)
        IfCondition NotEqual(GetByte(buf, i), 80) ThenBlock: { ReturnValue(-1) }
        i = Add(i, 1)
        tmp = Allocate(16)
        i = CAD_Plane.ParseDec(buf, i, tmp)
        IfCondition LessThan(i, 0) ThenBlock: {
            Deallocate(tmp, 16)
            ReturnValue(-1)
        }
        pid = ArrayGet(tmp, 0)
        i = CAD_Plane.ParseDec(buf, i, tmp)
        mode = ArrayGet(tmp, 0)
        i = CAD_Plane.ParseDec(buf, i, tmp)
        ppid = ArrayGet(tmp, 0)
        i = CAD_Plane.ParseDec(buf, i, tmp)
        rec = ArrayGet(tmp, 0)
        i = CAD_Plane.ParseDec(buf, i, tmp)
        flip = ArrayGet(tmp, 0)
        i = CAD_Plane.ParseDec(buf, i, tmp)
        flags = ArrayGet(tmp, 0)
        i = CAD_Plane.ParseHex(buf, i, tmp)
        dhex = ArrayGet(tmp, 0)
        i = CAD_Plane.ParseHex(buf, i, tmp)
        ahex = ArrayGet(tmp, 0)
        h = CAD_Plane.CreateWorldXY()
        IfCondition EqualTo(h, 0) ThenBlock: {
            Deallocate(tmp, 16)
            ReturnValue(-1)
        }
        CAD_Store.Write(h, 0, mode)
        CAD_Store.Write(h, 13, dhex)
        CAD_Store.Write(h, 14, flip)
        CAD_Store.Write(h, 17, ppid)
        CAD_Store.Write(h, 18, flags)
        CAD_Store.Write(h, 26, rec)
        CAD_Store.Write(h, 27, ahex)
        CAD_Plane.SetPid(h, pid)
        sl = 1
        WhileLoop LessEqual(sl, 12) {
            i = CAD_Plane.ParseHex(buf, i, tmp)
            CAD_Store.Write(h, sl, ArrayGet(tmp, 0))
            sl = Add(sl, 1)
        }
        sl = 20
        WhileLoop LessEqual(sl, 25) {
            i = CAD_Plane.ParseHex(buf, i, tmp)
            CAD_Store.Write(h, sl, ArrayGet(tmp, 0))
            sl = Add(sl, 1)
        }
        Deallocate(tmp, 16)
        ArraySet(out_h, 0, h)
        ReturnValue(i)
    }
}

