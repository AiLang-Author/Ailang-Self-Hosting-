// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 7: CAD.Repo — Master PostgreSQL Application Substrate (§11)

LibraryImport.PostgreSQL_Complete
LibraryImport.CAD_Sys
LibraryImport.CAD_Store

FixedPool.CAD_Repo_State {
    "db_connected": Initialize=0
    "part_count":   Initialize=0
    "feat_count":   Initialize=0
    "rev_count":    Initialize=0
    "plugin_count": Initialize=0
    "wb_count":     Initialize=0
    "last_conn_fd": Initialize=0
}

// -------------------------------------------------------------------------
// 1. Connection Engine (Unix Domain Socket & TCP Support)
// -------------------------------------------------------------------------

Function.CAD_Repo.Connect {
    Input: host_addr: Address
    Input: port: Integer
    Input: db_name_addr: Address
    Input: user_addr: Address
    Input: pass_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(port, 0) ThenBlock: {
            port = 5432
        }

        // Try Unix domain socket connection first (/var/run/postgresql or /tmp)
        conn = PG_ConnectUnix("/var/run/postgresql", port, db_name_addr, user_addr, pass_addr)
        IfCondition EqualTo(conn, 0) ThenBlock: {
            conn = PG_ConnectUnix("/tmp", port, db_name_addr, user_addr, pass_addr)
        }

        IfCondition LessEqual(conn, 0) ThenBlock: {
            ReturnValue(-16) // CAD_E_IO
        }

        CAD_Repo_State.last_conn_fd = conn
        CAD_Repo_State.db_connected = 1
        ReturnValue(0) // CAD_OK
    }
}

Function.CAD_Repo.InitSchema {
    Input: conn_fd: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(conn_fd, 0) ThenBlock: {
            conn_fd = CAD_Repo_State.last_conn_fd
        }
        IfCondition EqualTo(conn_fd, 0) ThenBlock: {
            ReturnValue(0)
        }

        ReturnValue(0) // CAD_OK
    }
}

Function.CAD_Repo.CreateWorkbench {
    Input: name_addr: Address
    Input: icon_addr: Address
    Output: Integer
    Body: {
        CAD_Repo_State.wb_count = Add(CAD_Repo_State.wb_count, 1)
        ReturnValue(0)
    }
}

Function.CAD_Repo.AddToolbarItem {
    Input: toolbar_id: Integer
    Input: label_addr: Address
    Input: command_addr: Address
    Input: order_idx: Integer
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

Function.CAD_Repo.SaveRevision {
    Input: part_id_addr: Address
    Input: rev_id_addr: Address
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        CAD_Repo_State.rev_count = Add(CAD_Repo_State.rev_count, 1)
        ReturnValue(0)
    }
}

Function.CAD_Repo.FetchRevision {
    Input: part_id_addr: Address
    Input: rev_num: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        h_solid = CAD_Store.Alloc(7, 4)
        ArraySet(out_solid_addr, 0, h_solid)
        ReturnValue(0)
    }
}
