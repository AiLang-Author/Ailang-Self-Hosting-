}

Function.CAD_Repo.FetchRevision {
    Input: part_id_addr: Address
    Input: rev_num: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(out_solid_addr, 0) ThenBlock: {
            ArraySet(out_solid_addr, 0, 0)
        }
        ReturnValue(-1)
    }
}
