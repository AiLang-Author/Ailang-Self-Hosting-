// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 10: CAD.Script — Procedural Scripting API & High-Level Modeling Harness

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Repo
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Tess

FixedPool.CAD_Script_State {
    "parts_created":  Initialize=0
    "holes_drilled":  Initialize=0
    "exports_done":   Initialize=0
}

// -------------------------------------------------------------------------
// 1. Procedural Solid Primitives
// -------------------------------------------------------------------------

// Create axis-aligned box [0,0,0]→[dx,dy,dz] via real Topo.MakeBoxSolid
Function.CAD_Script.CreateBox {
    Input: dx_r: Integer
    Input: dy_r: Integer
    Input: dz_r: Integer
    Output: Integer
    Body: {
        mn = Allocate(32)
        mx = Allocate(32)
        out = Allocate(16)
        ArraySet(mn, 0, 0)
        ArraySet(mn, 1, 0)
        ArraySet(mn, 2, 0)
        ArraySet(mx, 0, dx_r)
        ArraySet(mx, 1, dy_r)
        ArraySet(mx, 2, dz_r)
        h = CAD_Topo.MakeBoxSolid(mn, mx, out)
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        Deallocate(out, 16)
        CAD_Script_State.parts_created = Add(CAD_Script_State.parts_created, 1)
        ReturnValue(h)
    }
}

Function.CAD_Script.CreateCylinder {
    Input: radius_r: Integer
    Input: height_r: Integer
    Output: Integer
    Body: {
        sk = CAD_Store.Alloc(9, 4)
        h_cyl = CAD_Feat.CreateRevolve(sk, 1, 0x400921FB54442D18) // 2*pi
        CAD_Script_State.parts_created = Add(CAD_Script_State.parts_created, 1)
        ReturnValue(h_cyl)
    }
}

// -------------------------------------------------------------------------
// 2. High-Level Operations (Hole Drilling)
// -------------------------------------------------------------------------

Function.CAD_Script.DrillHole {
    Input: solid_handle: Integer
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: dia_r: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: {
            ReturnValue(0)
        }

        sk = CAD_Store.Alloc(9, 4)
        h_hole = CAD_Feat.CreatePocket(sk, depth_r)
        h_out = CAD_Bool.Difference(solid_handle, h_hole)
        CAD_Script_State.holes_drilled = Add(CAD_Script_State.holes_drilled, 1)
        ReturnValue(h_out)
    }
}

// -------------------------------------------------------------------------
// 3. Batch STEP & STL Export
// -------------------------------------------------------------------------

// ExportAll: STL from real mesh; STEP still stub until IO is real
Function.CAD_Script.ExportAll {
    Input: solid_handle: Integer
    Input: step_filename_addr: Address
    Input: stl_filename_addr: Address
    Output: Integer
    Body: {
        CAD_IO.ExportSTEP(solid_handle, step_filename_addr)
        CAD_Tess.ExportSTL(solid_handle, stl_filename_addr)
        CAD_Script_State.exports_done = Add(CAD_Script_State.exports_done, 1)
        ReturnValue(0)
    }
}
