// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 10: CAD.Script — Procedural Scripting API & High-Level Modeling Harness

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_Bool
LibraryImport.Cad.CAD_Feat
LibraryImport.Cad.CAD_Repo
LibraryImport.Cad.CAD_IO
LibraryImport.Cad.CAD_Tess
// Feat provides CreateHole / MakeCutToolCylinder (Fusion cut path)

FixedPool.CAD_Script_State {
    "parts_created":  Initialize=0
    "holes_drilled":  Initialize=0
    "exports_done":   Initialize=0
}

// -------------------------------------------------------------------------
// 1. Procedural Solid Primitives
// -------------------------------------------------------------------------

// Create axis-aligned box [0,0,0]→[dx,dy,dz] via real Topo.MakeBoxSolid
Function.CAD_Script.CreateBox {
    Input: dx_r: Integer
    Input: dy_r: Integer
    Input: dz_r: Integer
    Output: Integer
    Body: {
        mn = Allocate(32)
        mx = Allocate(32)
        out = Allocate(16)
        ArraySet(mn, 0, 0)
        ArraySet(mn, 1, 0)
        ArraySet(mn, 2, 0)
        ArraySet(mx, 0, dx_r)
        ArraySet(mx, 1, dy_r)
        ArraySet(mx, 2, dz_r)
        h = CAD_Topo.MakeBoxSolid(mn, mx, out)
        Deallocate(mn, 32)
        Deallocate(mx, 32)
        Deallocate(out, 16)
        CAD_Script_State.parts_created = Add(CAD_Script_State.parts_created, 1)
        ReturnValue(h)
    }
}

// Right circular cylinder: exact B-Rep (CIRCLE+CYL). Tess samples by deflection.
Function.CAD_Script.CreateCylinder {
    Input: radius_r: Integer
    Input: height_r: Integer
    Output: Integer
    Body: {
        out = Allocate(16)
        h = CAD_Topo.MakeCylinderSolid(radius_r, height_r, out)
        Deallocate(out, 16)
        CAD_Script_State.parts_created = Add(CAD_Script_State.parts_created, 1)
        ReturnValue(h)
    }
}

// N-gon prism only (debug). Prefer CreateCylinder.
Function.CAD_Script.CreateCylinderN {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: n_seg: Integer
    Output: Integer
    Body: {
        out = Allocate(16)
        h = CAD_Topo.MakeCylinderPrismSolid(radius_r, height_r, n_seg, out)
        Deallocate(out, 16)
        CAD_Script_State.parts_created = Add(CAD_Script_State.parts_created, 1)
        ReturnValue(h)
    }
}

// Exact solid; deflection only affects mesh sampling (not topology).
Function.CAD_Script.CreateCylinderDefl {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: defl_r: Integer
    Output: Integer
    Body: {
        // defl reserved for future per-solid tess cache; solid is exact
        out = Allocate(16)
        h = CAD_Topo.MakeCylinderSolid(radius_r, height_r, out)
        Deallocate(out, 16)
        CAD_Script_State.parts_created = Add(CAD_Script_State.parts_created, 1)
        ReturnValue(h)
    }
}

// -------------------------------------------------------------------------
// 2. High-Level Operations — Hole = subtractive boolean (cut), not a separate
//    primitive. Fillet/chamfer = blend on edges (CAD_Blend). Full kernel path:
//    tool solid (cylinder) → CAD_Bool.Difference(body, tool).
// -------------------------------------------------------------------------

// CreateHole: Fusion path = circle tool + cut. cx,cy reserved (face UV later).
// Returns Difference result when Bool is real; 0 if cut not produced (honest).
// Does NOT silently return the uncut body.
Function.CAD_Script.CreateHole {
    Input: solid_handle: Integer
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: dia_r: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        // cx_r, cy_r reserved for plane-local placement
        tool_slot = Allocate(16)
        cut = CAD_Feat.CreateHole(solid_handle, dia_r, depth_r, tool_slot)
        Deallocate(tool_slot, 16)
        CAD_Script_State.holes_drilled = Add(CAD_Script_State.holes_drilled, 1)
        ReturnValue(cut)
    }
}

// Alias — prefer CreateHole
Function.CAD_Script.DrillHole {
    Input: solid_handle: Integer
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: dia_r: Integer
    Input: depth_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Script.CreateHole(solid_handle, cx_r, cy_r, dia_r, depth_r))
    }
}

// -------------------------------------------------------------------------
// 3. Batch STEP & STL Export
// -------------------------------------------------------------------------

// ExportAll: STL from real mesh; STEP still stub until IO is real
Function.CAD_Script.ExportAll {
    Input: solid_handle: Integer
    Input: step_filename_addr: Address
    Input: stl_filename_addr: Address
    Output: Integer
    Body: {
        CAD_IO.ExportSTEP(solid_handle, step_filename_addr)
        CAD_Tess.ExportSTL(solid_handle, stl_filename_addr)
        CAD_Script_State.exports_done = Add(CAD_Script_State.exports_done, 1)
        ReturnValue(0)
    }
}
