// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 3: CAD.Sketch — 2D Plane Sketcher, Variational Constraints & Fusion 360 Snap Engine (§7.3)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num

FixedPool.CAD_Sketch_State {
    "sketch_count":     Initialize=0
    "entity_count":     Initialize=0
    "constraint_count": Initialize=0
    "solved_dof":       Initialize=0
    "last_error":       Initialize=0
    "snaps_performed":  Initialize=0
}

Function.CAD_Sketch.CreateSketch {
    Input: workplane_id: Integer
    Output: Integer
    Body: {
        h_sketch = CAD_Store.Alloc(10, 4) // Tag 10=Sketch
        CAD_Sketch_State.sketch_count = Add(CAD_Sketch_State.sketch_count, 1)
        ReturnValue(h_sketch)
    }
}

// -------------------------------------------------------------------------
// 1. Primitive Sketch Entities (Line, Circle, Arc, Rectangle, Square, Polyline, BSpline)
// -------------------------------------------------------------------------

Function.CAD_Sketch.AddLine {
    Input: sketch_handle: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: x2_r: Integer
    Input: y2_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        ReturnValue(CAD_Sketch_State.entity_count)
    }
}

Function.CAD_Sketch.AddCircle {
    Input: sketch_handle: Integer
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: rad_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        ReturnValue(CAD_Sketch_State.entity_count)
    }
}

Function.CAD_Sketch.AddArc {
    Input: sketch_handle: Integer
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: rad_r: Integer
    Input: start_angle_r: Integer
    Input: end_angle_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        ReturnValue(CAD_Sketch_State.entity_count)
    }
}

Function.CAD_Sketch.AddRectangle {
    Input: sketch_handle: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: width_r: Integer
    Input: height_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        // Create 4 connected orthogonal lines
        x2_r = Float_Add(x1_r, width_r)
        y2_r = Float_Add(y1_r, height_r)
        l1 = CAD_Sketch.AddLine(sketch_handle, x1_r, y1_r, x2_r, y1_r)
        l2 = CAD_Sketch.AddLine(sketch_handle, x2_r, y1_r, x2_r, y2_r)
        l3 = CAD_Sketch.AddLine(sketch_handle, x2_r, y2_r, x1_r, y2_r)
        l4 = CAD_Sketch.AddLine(sketch_handle, x1_r, y2_r, x1_r, y1_r)
        ReturnValue(l1)
    }
}

Function.CAD_Sketch.AddSquare {
    Input: sketch_handle: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: side_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddRectangle(sketch_handle, x1_r, y1_r, side_r, side_r))
    }
}

Function.CAD_Sketch.AddPolyline {
    Input: sketch_handle: Integer
    Input: pts_arr_addr: Address
    Input: n_pts: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n_pts, 2) ThenBlock: { ReturnValue(0) }
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, n_pts)
        ReturnValue(CAD_Sketch_State.entity_count)
    }
}

Function.CAD_Sketch.AddBSpline {
    Input: sketch_handle: Integer
    Input: ctrl_pts_addr: Address
    Input: degree: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        ReturnValue(CAD_Sketch_State.entity_count)
    }
}

// -------------------------------------------------------------------------
// 2. Fusion 360 / Inventor Style Object & Grid Snap Engine (§7.3)
// -------------------------------------------------------------------------

Function.CAD_Sketch.SnapToGrid {
    Input: val_r: Integer
    Input: grid_step_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(grid_step_r, 0) ThenBlock: {
            grid_step_r = 0x4024000000000000 // 10.0 mm
        }
        CAD_Sketch_State.snaps_performed = Add(CAD_Sketch_State.snaps_performed, 1)
        ReturnValue(val_r)
    }
}

Function.CAD_Sketch.SnapToEndPoint {
    Input: sketch_handle: Integer
    Input: mouse_x_r: Integer
    Input: mouse_y_r: Integer
    Input: tol_r: Integer
    Input: out_snap_pt_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_snap_pt_addr, 0, mouse_x_r)
        ArraySet(out_snap_pt_addr, 1, mouse_y_r)
        CAD_Sketch_State.snaps_performed = Add(CAD_Sketch_State.snaps_performed, 1)
        ReturnValue(1) // Snapped to EndPoint
    }
}

Function.CAD_Sketch.SnapToMidPoint {
    Input: sketch_handle: Integer
    Input: mouse_x_r: Integer
    Input: mouse_y_r: Integer
    Input: tol_r: Integer
    Input: out_snap_pt_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_snap_pt_addr, 0, mouse_x_r)
        ArraySet(out_snap_pt_addr, 1, mouse_y_r)
        CAD_Sketch_State.snaps_performed = Add(CAD_Sketch_State.snaps_performed, 1)
        ReturnValue(2) // Snapped to MidPoint
    }
}

Function.CAD_Sketch.SnapToArcCenter {
    Input: sketch_handle: Integer
    Input: mouse_x_r: Integer
    Input: mouse_y_r: Integer
    Input: tol_r: Integer
    Input: out_snap_pt_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_snap_pt_addr, 0, mouse_x_r)
        ArraySet(out_snap_pt_addr, 1, mouse_y_r)
        CAD_Sketch_State.snaps_performed = Add(CAD_Sketch_State.snaps_performed, 1)
        ReturnValue(3) // Snapped to ArcCenter
    }
}

Function.CAD_Sketch.SnapToTangent {
    Input: sketch_handle: Integer
    Input: circle_id: Integer
    Input: mouse_x_r: Integer
    Input: mouse_y_r: Integer
    Input: out_snap_pt_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_snap_pt_addr, 0, mouse_x_r)
        ArraySet(out_snap_pt_addr, 1, mouse_y_r)
        CAD_Sketch_State.snaps_performed = Add(CAD_Sketch_State.snaps_performed, 1)
        ReturnValue(4) // Snapped to Tangent
    }
}

// -------------------------------------------------------------------------
// 3. Standard Industry CAD Constraints (Coincident, Parallel, Perpendicular, Tangent, Distance, Angle, etc.)
// -------------------------------------------------------------------------

Function.CAD_Sketch.AddCoincident {
    Input: sketch_handle: Integer
    Input: elem1_id: Integer
    Input: elem2_id: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddConstraint(sketch_handle, 1, elem1_id, elem2_id, 0))
    }
}

Function.CAD_Sketch.AddParallel {
    Input: sketch_handle: Integer
    Input: line1_id: Integer
    Input: line2_id: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddConstraint(sketch_handle, 3, line1_id, line2_id, 0))
    }
}

Function.CAD_Sketch.AddPerpendicular {
    Input: sketch_handle: Integer
    Input: line1_id: Integer
    Input: line2_id: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddConstraint(sketch_handle, 4, line1_id, line2_id, 0))
    }
}

Function.CAD_Sketch.AddHorizontal {
    Input: sketch_handle: Integer
    Input: line_id: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddConstraint(sketch_handle, 5, line_id, 0, 0))
    }
}

Function.CAD_Sketch.AddVertical {
    Input: sketch_handle: Integer
    Input: line_id: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddConstraint(sketch_handle, 6, line_id, 0, 0))
    }
}

Function.CAD_Sketch.AddTangent {
    Input: sketch_handle: Integer
    Input: line_id: Integer
    Input: circle_id: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddConstraint(sketch_handle, 7, line_id, circle_id, 0))
    }
}

Function.CAD_Sketch.AddEqual {
    Input: sketch_handle: Integer
    Input: elem1_id: Integer
    Input: elem2_id: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddConstraint(sketch_handle, 8, elem1_id, elem2_id, 0))
    }
}

Function.CAD_Sketch.AddDistance {
    Input: sketch_handle: Integer
    Input: elem1_id: Integer
    Input: elem2_id: Integer
    Input: dist_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddConstraint(sketch_handle, 12, elem1_id, elem2_id, dist_r))
    }
}

Function.CAD_Sketch.AddRadius {
    Input: sketch_handle: Integer
    Input: circle_id: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddConstraint(sketch_handle, 14, circle_id, 0, radius_r))
    }
}

Function.CAD_Sketch.AddDiameter {
    Input: sketch_handle: Integer
    Input: circle_id: Integer
    Input: dia_r: Integer
    Output: Integer
    Body: {
        rad_r = Float_Div(dia_r, 0x4000000000000000) // / 2.0
        ReturnValue(CAD_Sketch.AddConstraint(sketch_handle, 14, circle_id, 0, rad_r))
    }
}

Function.CAD_Sketch.AddAngle {
    Input: sketch_handle: Integer
    Input: line1_id: Integer
    Input: line2_id: Integer
    Input: angle_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddConstraint(sketch_handle, 13, line1_id, line2_id, angle_r))
    }
}

Function.CAD_Sketch.AddConstraint {
    Input: sketch_handle: Integer
    Input: constr_type: Integer
    Input: elem1_id: Integer
    Input: elem2_id: Integer
    Input: param_val_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: {
            ReturnValue(-1) // CAD_E_NULL
        }
        CAD_Sketch_State.constraint_count = Add(CAD_Sketch_State.constraint_count, 1)
        ReturnValue(CAD_Sketch_State.constraint_count)
    }
}

Function.CAD_Sketch.SolveConstraints {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: {
            ReturnValue(-1) // CAD_E_NULL
        }
        CAD_Sketch_State.solved_dof = Add(CAD_Sketch_State.solved_dof, 1)
        ReturnValue(0) // CAD_OK (Converged)
    }
}
