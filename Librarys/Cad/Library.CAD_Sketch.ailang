// CAD.Sketch — 2D UV profile IR (core CRUD + constraints + datum).
// Tag 10, stride 28 — see Docs/CAD/CAD_PHASE_A_SKETCH.md + CAD_SKETCHER_IMPL.md
//
// Geometry engine policy (NOT convenience tools):
//   • Exact plane isects from stored coords (line/arc/circle/…).
//   • Absolute numerical coincidence eps — NEVER % of sketch AABB diagonal.
//   • Rect/poly tools are UI sugar; the kernel must not assume “pre-shapes”.
//   • Path to a Jacobian constraint solver (residuals on points/params), not
//     freehand join heuristics scaled by bounding-box size (breaks on splines).
//
// Split modules (import via this facade — one LibraryImport.Cad.CAD_Sketch loads all):
//   CAD_SketchJoin    RebuildAnchors, Split*
//   CAD_SketchTrim    TrimAt, PruneOpenStubs
//   CAD_SketchProfile loops / tess / PrepareExtrude
//   CAD_SketchEdit    FilletLines, Arc3*
//
// Sketch store slots:
//   0 n_lines  1 lines  2 n_loop(primary)  3 loop_addr(primary)
//   4 workplane  5 cap_lines  6 cap_loop_pts
//   7 n_circles  8 circs  9 cap_circles
//  10 n_arcs  11 arcs
//  12 n_profiles  13 profile_meta [n,start]×  14 loop_pool  15 cap_profiles
//  16 n_pts  17 pts_addr (x,y anchors)  18 cap_pts
//  19 plane_id (0 = world / Sketch_0)
//  20 n_constraints  21 constraints_addr  22 cap_constraints  23 datum_flags
//  24 n_upts  25 upts_addr (user Points x,y)  26 cap_upts  27 n_face_ref (frozen host-face verts)
// Constraint record (8 words):
//   type, kind_a, id_a, value, flags, kind_b, id_b, reserved
// User Points are first-class (not wiped by RebuildAnchors). Anchors = derived ends/crosses.

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_SketchJoin
LibraryImport.Cad.CAD_SketchTrim
LibraryImport.Cad.CAD_SketchProfile
LibraryImport.Cad.CAD_SketchEdit

FixedPool.CAD_Sketch_State {
    "sketch_count":     Initialize=0
    "entity_count":     Initialize=0
    "constraint_count": Initialize=0
    "solved_dof":       Initialize=0
    "last_error":       Initialize=0
    "snaps_performed":  Initialize=0
    // pending value for AddConstraint2 (AILang multi-arg clobber workaround)
    "pend_value":       Initialize=0
    "work_sk":          Initialize=0, CanChange=True
}

// Last Arc3Fit result (preview + commit share this — WYSIWYG).
// Also holds pending 3-point inputs: AILang 7-arg calls (handle+6 floats)
// clobber, so Arc3Point(handle) reads x0..y2 from here after Arc3Pend.
FixedPool.CAD_Sketch_Arc3 {
    "cx":  Initialize=0
    "cy":  Initialize=0
    "rad": Initialize=0
    "a0":  Initialize=0
    "a1":  Initialize=0
    "ok":  Initialize=0
    "x0":  Initialize=0
    "y0":  Initialize=0
    "x1":  Initialize=0
    "y1":  Initialize=0
    "x2":  Initialize=0
    "y2":  Initialize=0
}


Function.CAD_Sketch.CreateSketch {
    Input: workplane_id: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(10, 28)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        // lines: 4096 segs × 4 doubles × 8 = 131072 (was 512 — trim/split starved)
        lines = Allocate(131072)
        // primary loop: up to 4096 verts (dense tessellated outer envelopes)
        loop = Allocate(65536)
        circs = Allocate(2048)
        // arcs: up to 512 × 5 doubles (trim/fillet/arc3 can spawn many pieces)
        arcs = Allocate(20480)
        // [n,off] × 64 profiles
        pmeta = Allocate(1024)
        // multi-profile pool: ~8192 verts total across faces
        pool = Allocate(131072)
        pts = Allocate(16384)
        // constraints: 128 × 8 words × 8 = 8192
        cstr = Allocate(8192)
        // user Points: 512 × (x,y) — first-class, not wiped by RebuildAnchors
        upts = Allocate(8192)
        CAD_Store.Write(h, 0, 0)
        CAD_Store.Write(h, 1, lines)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, loop)
        CAD_Store.Write(h, 4, workplane_id)
        CAD_Store.Write(h, 5, 4096)
        CAD_Store.Write(h, 6, 4096)
        CAD_Store.Write(h, 7, 0)
        CAD_Store.Write(h, 8, circs)
        CAD_Store.Write(h, 9, 64)
        CAD_Store.Write(h, 10, 0)
        CAD_Store.Write(h, 11, arcs)
        CAD_Store.Write(h, 12, 0)
        CAD_Store.Write(h, 13, pmeta)
        CAD_Store.Write(h, 14, pool)
        // multi-circle clover can produce many lens faces before outer envelope
        CAD_Store.Write(h, 15, 64)
        CAD_Store.Write(h, 16, 0)
        CAD_Store.Write(h, 17, pts)
        CAD_Store.Write(h, 18, 1024)
        // plane_id 0 = world Sketch_0 frame
        CAD_Store.Write(h, 19, 0)
        CAD_Store.Write(h, 20, 0)
        CAD_Store.Write(h, 21, cstr)
        CAD_Store.Write(h, 22, 128)
        CAD_Store.Write(h, 23, 0)
        CAD_Store.Write(h, 24, 0)
        CAD_Store.Write(h, 25, upts)
        CAD_Store.Write(h, 26, 512)
        CAD_Store.Write(h, 27, 0)
        CAD_Sketch_State.sketch_count = Add(CAD_Sketch_State.sketch_count, 1)
        // immutable datum always present (O / +X / +Y logical — no fake geometry)
        CAD_Sketch.EnsureDatum(h)
        ReturnValue(h)
    }
}

// -------------------------------------------------------------------------
// CS-0 — Sketch_0 datum + absolute origin solver (direct projection)
// -------------------------------------------------------------------------

// Ensure plane_id + datum flag. Idempotent. Returns 0 ok, -1 null.


// -------------------------------------------------------------------------
// CS-0 — Sketch_0 datum + absolute origin solver (direct projection)
// -------------------------------------------------------------------------

// Ensure plane_id + datum flag. Idempotent. Returns 0 ok, -1 null.
Function.CAD_Sketch.EnsureDatum {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        // plane_id stays 0 (world) unless SetPlaneId later
        fl = CAD_Store.Read(sketch_handle, 23)
        // bit0 = datum ensured (O/+X/+Y are logical; drawn by app, not fake lines)
        IfCondition EqualTo(BitwiseAnd(fl, 1), 0) ThenBlock: {
            CAD_Store.Write(sketch_handle, 23, BitwiseOr(fl, 1))
        }
        ReturnValue(0)
    }
}


Function.CAD_Sketch.GetPlaneId {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(CAD_Store.Read(sketch_handle, 19))
    }
}


Function.CAD_Sketch.SetPlaneId {
    Input: sketch_handle: Integer
    Input: plane_id: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Store.Write(sketch_handle, 19, plane_id)
        ReturnValue(0)
    }
}


Function.CAD_Sketch.GetConstraintCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 20))
    }
}

// Read line endpoint. end=0 start, end=1 tip. Writes out[0]=x out[1]=y. Returns 0 ok.


// Read line endpoint. end=0 start, end=1 tip. Writes out[0]=x out[1]=y. Returns 0 ok.
Function.CAD_Sketch.GetLineEnd {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: end: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition GreaterEqual(line_i, nl) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(sketch_handle, 1)
        b = Multiply(line_i, 4)
        IfCondition EqualTo(end, 0) ThenBlock: {
            ArraySet(out_xy, 0, ArrayGet(lines, b))
            ArraySet(out_xy, 1, ArrayGet(lines, Add(b, 1)))
        }
        IfCondition NotEqual(end, 0) ThenBlock: {
            ArraySet(out_xy, 0, ArrayGet(lines, Add(b, 2)))
            ArraySet(out_xy, 1, ArrayGet(lines, Add(b, 3)))
        }
        ReturnValue(0)
    }
}


Function.CAD_Sketch.SetLineEnd {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: end: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition GreaterEqual(line_i, nl) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(sketch_handle, 1)
        b = Multiply(line_i, 4)
        IfCondition EqualTo(end, 0) ThenBlock: {
            ArraySet(lines, b, x_r)
            ArraySet(lines, Add(b, 1), y_r)
        }
        IfCondition NotEqual(end, 0) ThenBlock: {
            ArraySet(lines, Add(b, 2), x_r)
            ArraySet(lines, Add(b, 3), y_r)
        }
        ReturnValue(0)
    }
}

// Set line i from start + (len, ang radians). HUD edit.
Function.CAD_Sketch.SetLinePolar {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: len_r: Integer
    Input: ang_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition GreaterEqual(line_i, nl) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Num.IsZero(len_r, 0), 1) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(sketch_handle, 1)
        b = Multiply(line_i, 4)
        x0 = ArrayGet(lines, b)
        y0 = ArrayGet(lines, Add(b, 1))
        x1 = Float_Add(x0, Float_Mul(len_r, CAD_Geom.Cos(ang_r)))
        y1 = Float_Add(y0, Float_Mul(len_r, CAD_Geom.Sin(ang_r)))
        ArraySet(lines, Add(b, 2), x1)
        ArraySet(lines, Add(b, 3), y1)
        CAD_Sketch.RebuildAnchors(sketch_handle)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// User Points — first-class geometry (pattern anchors, known distances)
// -------------------------------------------------------------------------

// Place a Point in UV. merge_tol_r=0 → no merge (always new). Returns index or -1.


// -------------------------------------------------------------------------
// User Points — first-class geometry (pattern anchors, known distances)
// -------------------------------------------------------------------------

// Place a Point in UV. merge_tol_r=0 → no merge (always new). Returns index or -1.
Function.CAD_Sketch.AddUserPoint {
    Input: sketch_handle: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Input: merge_tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 24)
        cap = CAD_Store.Read(sketch_handle, 26)
        up = CAD_Store.Read(sketch_handle, 25)
        IfCondition EqualTo(up, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(merge_tol_r, 0) ThenBlock: {
            tol2 = Float_Mul(merge_tol_r, merge_tol_r)
            i = 0
            WhileLoop LessThan(i, n) {
                px = ArrayGet(up, Multiply(i, 2))
                py = ArrayGet(up, Add(Multiply(i, 2), 1))
                dx = Float_Sub(px, x_r)
                dy = Float_Sub(py, y_r)
                IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), tol2), 1) ThenBlock: {
                    ReturnValue(i)
                }
                i = Add(i, 1)
            }
        }
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(-1) }
        ArraySet(up, Multiply(n, 2), x_r)
        ArraySet(up, Add(Multiply(n, 2), 1), y_r)
        CAD_Store.Write(sketch_handle, 24, Add(n, 1))
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        ReturnValue(n)
    }
}


Function.CAD_Sketch.GetUserPointCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 24))
    }
}


Function.CAD_Sketch.GetUserPoint {
    Input: sketch_handle: Integer
    Input: pi: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 24)
        IfCondition GreaterEqual(pi, n) ThenBlock: { ReturnValue(-1) }
        up = CAD_Store.Read(sketch_handle, 25)
        ArraySet(out_xy, 0, ArrayGet(up, Multiply(pi, 2)))
        ArraySet(out_xy, 1, ArrayGet(up, Add(Multiply(pi, 2), 1)))
        ReturnValue(0)
    }
}


Function.CAD_Sketch.SetUserPoint {
    Input: sketch_handle: Integer
    Input: pi: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 24)
        IfCondition GreaterEqual(pi, n) ThenBlock: { ReturnValue(-1) }
        up = CAD_Store.Read(sketch_handle, 25)
        ArraySet(up, Multiply(pi, 2), x_r)
        ArraySet(up, Add(Multiply(pi, 2), 1), y_r)
        ReturnValue(0)
    }
}

// Circle radius get/set (entity stays circle)


// Circle radius get/set (entity stays circle)
Function.CAD_Sketch.GetCircleRadius {
    Input: sketch_handle: Integer
    Input: ci: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        nc = CAD_Store.Read(sketch_handle, 7)
        IfCondition GreaterEqual(ci, nc) ThenBlock: { ReturnValue(0) }
        circs = CAD_Store.Read(sketch_handle, 8)
        ReturnValue(ArrayGet(circs, Add(Multiply(ci, 3), 2)))
    }
}


Function.CAD_Sketch.SetCircleRadius {
    Input: sketch_handle: Integer
    Input: ci: Integer
    Input: r_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        nc = CAD_Store.Read(sketch_handle, 7)
        IfCondition GreaterEqual(ci, nc) ThenBlock: { ReturnValue(-1) }
        circs = CAD_Store.Read(sketch_handle, 8)
        ArraySet(circs, Add(Multiply(ci, 3), 2), r_r)
        ReturnValue(0)
    }
}

// Get target UV. kind 0 line-end; 1/4 circle center; 3 user Point


// Get target UV. kind 0 line-end; 1/4 circle center; 3 user Point
Function.CAD_Sketch.GetTargetXY {
    Input: sketch_handle: Integer
    Input: target_kind: Integer
    Input: target_id: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(target_kind, 0) ThenBlock: {
            li = Divide(target_id, 2)
            en = Modulo(target_id, 2)
            ReturnValue(CAD_Sketch.GetLineEnd(sketch_handle, li, en, out_xy))
        }
        IfCondition EqualTo(target_kind, 1) ThenBlock: {
            nc = CAD_Store.Read(sketch_handle, 7)
            IfCondition GreaterEqual(target_id, nc) ThenBlock: { ReturnValue(-1) }
            circs = CAD_Store.Read(sketch_handle, 8)
            base = Multiply(target_id, 3)
            ArraySet(out_xy, 0, ArrayGet(circs, base))
            ArraySet(out_xy, 1, ArrayGet(circs, Add(base, 1)))
            ReturnValue(0)
        }
        IfCondition EqualTo(target_kind, 4) ThenBlock: {
            nc = CAD_Store.Read(sketch_handle, 7)
            IfCondition GreaterEqual(target_id, nc) ThenBlock: { ReturnValue(-1) }
            circs = CAD_Store.Read(sketch_handle, 8)
            base = Multiply(target_id, 3)
            ArraySet(out_xy, 0, ArrayGet(circs, base))
            ArraySet(out_xy, 1, ArrayGet(circs, Add(base, 1)))
            ReturnValue(0)
        }
        IfCondition EqualTo(target_kind, 3) ThenBlock: {
            ReturnValue(CAD_Sketch.GetUserPoint(sketch_handle, target_id, out_xy))
        }
        ReturnValue(-1)
    }
}


Function.CAD_Sketch.SetTargetXY {
    Input: sketch_handle: Integer
    Input: target_kind: Integer
    Input: target_id: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(target_kind, 0) ThenBlock: {
            li = Divide(target_id, 2)
            en = Modulo(target_id, 2)
            ReturnValue(CAD_Sketch.SetLineEnd(sketch_handle, li, en, x_r, y_r))
        }
        IfCondition EqualTo(target_kind, 1) ThenBlock: {
            nc = CAD_Store.Read(sketch_handle, 7)
            IfCondition GreaterEqual(target_id, nc) ThenBlock: { ReturnValue(-1) }
            circs = CAD_Store.Read(sketch_handle, 8)
            base = Multiply(target_id, 3)
            ArraySet(circs, base, x_r)
            ArraySet(circs, Add(base, 1), y_r)
            ReturnValue(0)
        }
        IfCondition EqualTo(target_kind, 4) ThenBlock: {
            nc = CAD_Store.Read(sketch_handle, 7)
            IfCondition GreaterEqual(target_id, nc) ThenBlock: { ReturnValue(-1) }
            circs = CAD_Store.Read(sketch_handle, 8)
            base = Multiply(target_id, 3)
            ArraySet(circs, base, x_r)
            ArraySet(circs, Add(base, 1), y_r)
            ReturnValue(0)
        }
        IfCondition EqualTo(target_kind, 3) ThenBlock: {
            ReturnValue(CAD_Sketch.SetUserPoint(sketch_handle, target_id, x_r, y_r))
        }
        ReturnValue(-1)
    }
}

// Single-target constraint (absolute / H/V / radius). Returns index or -1.
// NOTE: body inlined (not call AddConstraint2) — AILang nested multi-arg can clobber value.


// Single-target constraint (absolute / H/V / radius). Returns index or -1.
// NOTE: body inlined (not call AddConstraint2) — AILang nested multi-arg can clobber value.
Function.CAD_Sketch.AddConstraint {
    Input: sketch_handle: Integer
    Input: ctype: Integer
    Input: target_kind: Integer
    Input: target_id: Integer
    Input: value_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        n = CAD_Store.Read(sketch_handle, 20)
        cap = CAD_Store.Read(sketch_handle, 22)
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(-1) }
        base = Multiply(n, 8)
        ArraySet(cstr, base, ctype)
        ArraySet(cstr, Add(base, 1), target_kind)
        ArraySet(cstr, Add(base, 2), target_id)
        ArraySet(cstr, Add(base, 3), value_r)
        ArraySet(cstr, Add(base, 4), 0)
        ArraySet(cstr, Add(base, 5), 0)
        ArraySet(cstr, Add(base, 6), 0)
        ArraySet(cstr, Add(base, 7), 0)
        CAD_Store.Write(sketch_handle, 20, Add(n, 1))
        CAD_Sketch_State.constraint_count = Add(CAD_Sketch_State.constraint_count, 1)
        ReturnValue(n)
    }
}

// Set float value for constraint index (dims, DistPoints, Radius via pair API).


// Set float value for constraint index (dims, DistPoints, Radius via pair API).
Function.CAD_Sketch.SetConstraintValue {
    Input: sketch_handle: Integer
    Input: cid: Integer
    Input: value_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 20)
        IfCondition GreaterEqual(cid, n) ThenBlock: { ReturnValue(-1) }
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(-1) }
        ArraySet(cstr, Add(Multiply(cid, 8), 3), value_r)
        ReturnValue(0)
    }
}

// Stage value for next AddConstraint2 (prefer SetConstraintValue after add for dims).


// Stage value for next AddConstraint2 (prefer SetConstraintValue after add for dims).
Function.CAD_Sketch.PendConstraintValue {
    Input: value_r: Integer
    Output: Integer
    Body: {
        CAD_Sketch_State.pend_value = value_r
        ReturnValue(0)
    }
}

// Dual-target constraint (coincident, tangent, dist, …).
// Value: uses pend_value then clears it (set via PendConstraintValue first),
// or call SetConstraintValue(cid, v) after. Avoids 7-arg clobber.


// Dual-target constraint (coincident, tangent, dist, …).
// Value: uses pend_value then clears it (set via PendConstraintValue first),
// or call SetConstraintValue(cid, v) after. Avoids 7-arg clobber.
Function.CAD_Sketch.AddConstraint2 {
    Input: sketch_handle: Integer
    Input: ctype: Integer
    Input: kind_a: Integer
    Input: id_a: Integer
    Input: kind_b: Integer
    Input: id_b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        n = CAD_Store.Read(sketch_handle, 20)
        cap = CAD_Store.Read(sketch_handle, 22)
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(-1) }
        ct = ctype
        ka = kind_a
        ia = id_a
        kb = kind_b
        ib = id_b
        vv = CAD_Sketch_State.pend_value
        CAD_Sketch_State.pend_value = 0
        base = Multiply(n, 8)
        ArraySet(cstr, base, ct)
        ArraySet(cstr, Add(base, 1), ka)
        ArraySet(cstr, Add(base, 2), ia)
        ArraySet(cstr, Add(base, 3), vv)
        ArraySet(cstr, Add(base, 4), 0)
        ArraySet(cstr, Add(base, 5), kb)
        ArraySet(cstr, Add(base, 6), ib)
        ArraySet(cstr, Add(base, 7), 0)
        CAD_Store.Write(sketch_handle, 20, Add(n, 1))
        CAD_Sketch_State.constraint_count = Add(CAD_Sketch_State.constraint_count, 1)
        ReturnValue(n)
    }
}

// Snap (wx,wy) to sketch datum. Priority: origin > +X axis > +Y axis.
// Writes out_xy. Returns 0=none 1=origin 2=axisX 3=axisY.
// tol_r = world distance; if 0 uses 0.5 mm default.


// Snap (wx,wy) to sketch datum. Priority: origin > +X axis > +Y axis.
// Writes out_xy. Returns 0=none 1=origin 2=axisX 3=axisY.
// tol_r = world distance; if 0 uses 0.5 mm default.
Function.CAD_Sketch.SnapToDatum {
    Input: sketch_handle: Integer
    Input: wx: Integer
    Input: wy: Integer
    Input: tol_r: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        ArraySet(out_xy, 0, wx)
        ArraySet(out_xy, 1, wy)
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        tol = tol_r
        IfCondition EqualTo(tol, 0) ThenBlock: {
            // 0.5 mm default
            tol = 0x3FE0000000000000
        }
        // 1) origin
        d2o = Float_Add(Float_Mul(wx, wx), Float_Mul(wy, wy))
        tol2 = Float_Mul(tol, tol)
        IfCondition EqualTo(Float_Le(d2o, tol2), 1) ThenBlock: {
            ArraySet(out_xy, 0, 0)
            ArraySet(out_xy, 1, 0)
            ReturnValue(1)
        }
        // 2) axis X (y → 0), keep x
        ay = wy
        IfCondition EqualTo(Float_Le(ay, 0), 1) ThenBlock: { ay = Float_Sub(0, ay) }
        IfCondition EqualTo(Float_Le(ay, tol), 1) ThenBlock: {
            ArraySet(out_xy, 0, wx)
            ArraySet(out_xy, 1, 0)
            ReturnValue(2)
        }
        // 3) axis Y (x → 0), keep y
        ax = wx
        IfCondition EqualTo(Float_Le(ax, 0), 1) ThenBlock: { ax = Float_Sub(0, ax) }
        IfCondition EqualTo(Float_Le(ax, tol), 1) ThenBlock: {
            ArraySet(out_xy, 0, 0)
            ArraySet(out_xy, 1, wy)
            ReturnValue(3)
        }
        ReturnValue(0)
    }
}

// Multi-pass direct-projection constraint solver (absolute + relational).
// No full Jacobian yet — good enough for origin/H/V/coincident/radius/tangent.
// Returns total apply-hits across passes, or -1 on null.


// Multi-pass direct-projection constraint solver (absolute + relational).
// No full Jacobian yet — good enough for origin/H/V/coincident/radius/tangent.
// Returns total apply-hits across passes, or -1 on null.
Function.CAD_Sketch.SolveDatum {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        n = CAD_Store.Read(sketch_handle, 20)
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(0) }
        xy = Allocate(32)
        xy2 = Allocate(32)
        applied = 0
        pass = 0
        WhileLoop LessThan(pass, 10) {
            i = 0
            WhileLoop LessThan(i, n) {
                base = Multiply(i, 8)
                ctype = ArrayGet(cstr, base)
                ka = ArrayGet(cstr, Add(base, 1))
                ia = ArrayGet(cstr, Add(base, 2))
                val = ArrayGet(cstr, Add(base, 3))
                kb = ArrayGet(cstr, Add(base, 5))
                ib = ArrayGet(cstr, Add(base, 6))
                // --- H / V on whole line ---
                IfCondition EqualTo(ctype, 7) ThenBlock: {
                    IfCondition EqualTo(ka, 2) ThenBlock: {
                        lines = CAD_Store.Read(sketch_handle, 1)
                        nl = CAD_Store.Read(sketch_handle, 0)
                        IfCondition LessThan(ia, nl) ThenBlock: {
                            b = Multiply(ia, 4)
                            y0 = ArrayGet(lines, Add(b, 1))
                            ArraySet(lines, Add(b, 3), y0)
                            applied = Add(applied, 1)
                        }
                    }
                }
                IfCondition EqualTo(ctype, 8) ThenBlock: {
                    IfCondition EqualTo(ka, 2) ThenBlock: {
                        lines = CAD_Store.Read(sketch_handle, 1)
                        nl = CAD_Store.Read(sketch_handle, 0)
                        IfCondition LessThan(ia, nl) ThenBlock: {
                            b = Multiply(ia, 4)
                            x0 = ArrayGet(lines, b)
                            ArraySet(lines, Add(b, 2), x0)
                            applied = Add(applied, 1)
                        }
                    }
                }
                // --- Absolute on point (kinds 0/1/3/4 as center) ---
                IfCondition LessThan(ctype, 7) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        px = ArrayGet(xy, 0)
                        py = ArrayGet(xy, 1)
                        nx = px
                        ny = py
                        IfCondition EqualTo(ctype, 1) ThenBlock: {
                            nx = 0
                            ny = 0
                        }
                        IfCondition EqualTo(ctype, 2) ThenBlock: { nx = val }
                        IfCondition EqualTo(ctype, 3) ThenBlock: { ny = val }
                        IfCondition EqualTo(ctype, 4) ThenBlock: { ny = 0 }
                        IfCondition EqualTo(ctype, 5) ThenBlock: { nx = 0 }
                        IfCondition EqualTo(ctype, 6) ThenBlock: {
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(px, px), Float_Mul(py, py)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                nx = val
                                ny = 0
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(val, d)
                                nx = Float_Mul(px, s)
                                ny = Float_Mul(py, s)
                            }
                        }
                        CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, nx, ny)
                        applied = Add(applied, 1)
                    }
                }
                // --- 9 Coincident: B ← A ---
                IfCondition EqualTo(ctype, 9) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, ArrayGet(xy, 0), ArrayGet(xy, 1)), 0) ThenBlock: {
                            applied = Add(applied, 1)
                        }
                    }
                }
                // --- 10 PointOnLine: A on infinite line B (kind 2 = line_i) ---
                IfCondition EqualTo(ctype, 10) ThenBlock: {
                    IfCondition EqualTo(kb, 2) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                            lines = CAD_Store.Read(sketch_handle, 1)
                            nl = CAD_Store.Read(sketch_handle, 0)
                            IfCondition LessThan(ib, nl) ThenBlock: {
                                b = Multiply(ib, 4)
                                x0 = ArrayGet(lines, b)
                                y0 = ArrayGet(lines, Add(b, 1))
                                x1 = ArrayGet(lines, Add(b, 2))
                                y1 = ArrayGet(lines, Add(b, 3))
                                dx = Float_Sub(x1, x0)
                                dy = Float_Sub(y1, y0)
                                aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                                    ax = ArrayGet(xy, 0)
                                    ay = ArrayGet(xy, 1)
                                    t = Float_Div(Float_Add(Float_Mul(Float_Sub(ax, x0), dx), Float_Mul(Float_Sub(ay, y0), dy)), aa)
                                    nx = Float_Add(x0, Float_Mul(t, dx))
                                    ny = Float_Add(y0, Float_Mul(t, dy))
                                    CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, nx, ny)
                                    applied = Add(applied, 1)
                                }
                            }
                        }
                    }
                }
                // --- 11 Radius: set circle radius (kind 1 or 4) ---
                IfCondition EqualTo(ctype, 11) ThenBlock: {
                    ci = ia
                    CAD_Sketch.SetCircleRadius(sketch_handle, ci, val)
                    applied = Add(applied, 1)
                }
                // --- 12 EqualRadius: r(B) = r(A) ---
                IfCondition EqualTo(ctype, 12) ThenBlock: {
                    ra = CAD_Sketch.GetCircleRadius(sketch_handle, ia)
                    CAD_Sketch.SetCircleRadius(sketch_handle, ib, ra)
                    applied = Add(applied, 1)
                }
                // --- 13 Tangent line–circle: move circle center so dist(line)=r ---
                IfCondition EqualTo(ctype, 13) ThenBlock: {
                    // A = line (kind 2), B = circle (1 or 4)
                    IfCondition EqualTo(ka, 2) ThenBlock: {
                        lines = CAD_Store.Read(sketch_handle, 1)
                        nl = CAD_Store.Read(sketch_handle, 0)
                        IfCondition LessThan(ia, nl) ThenBlock: {
                            IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy), 0) ThenBlock: {
                                b = Multiply(ia, 4)
                                x0 = ArrayGet(lines, b)
                                y0 = ArrayGet(lines, Add(b, 1))
                                x1 = ArrayGet(lines, Add(b, 2))
                                y1 = ArrayGet(lines, Add(b, 3))
                                dx = Float_Sub(x1, x0)
                                dy = Float_Sub(y1, y0)
                                llen = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                                IfCondition EqualTo(CAD_Num.IsZero(llen, 0), 0) ThenBlock: {
                                    // unit normal
                                    nxn = Float_Div(Float_Sub(0, dy), llen)
                                    nyn = Float_Div(dx, llen)
                                    cx = ArrayGet(xy, 0)
                                    cy = ArrayGet(xy, 1)
                                    ci = ib
                                    rad = CAD_Sketch.GetCircleRadius(sketch_handle, ci)
                                    sd = Float_Add(Float_Mul(Float_Sub(cx, x0), nxn), Float_Mul(Float_Sub(cy, y0), nyn))
                                    // target signed dist = +r or -r matching side
                                    tgt = rad
                                    IfCondition EqualTo(Float_Le(sd, 0), 1) ThenBlock: {
                                        tgt = Float_Sub(0, rad)
                                    }
                                    delta = Float_Sub(sd, tgt)
                                    ncx = Float_Sub(cx, Float_Mul(delta, nxn))
                                    ncy = Float_Sub(cy, Float_Mul(delta, nyn))
                                    CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, ncx, ncy)
                                    applied = Add(applied, 1)
                                }
                            }
                        }
                    }
                }
                // --- 14 Tangent circle–circle (external): |c2-c1| = r1+r2 ---
                IfCondition EqualTo(ctype, 14) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy2), 0) ThenBlock: {
                            cx1 = ArrayGet(xy, 0)
                            cy1 = ArrayGet(xy, 1)
                            cx2 = ArrayGet(xy2, 0)
                            cy2 = ArrayGet(xy2, 1)
                            r1 = CAD_Sketch.GetCircleRadius(sketch_handle, ia)
                            r2 = CAD_Sketch.GetCircleRadius(sketch_handle, ib)
                            want = Float_Add(r1, r2)
                            dx = Float_Sub(cx2, cx1)
                            dy = Float_Sub(cy2, cy1)
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                // coincident centers — push B on +X
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, Float_Add(cx1, want), cy1)
                                applied = Add(applied, 1)
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(want, d)
                                ncx = Float_Add(cx1, Float_Mul(dx, s))
                                ncy = Float_Add(cy1, Float_Mul(dy, s))
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, ncx, ncy)
                                applied = Add(applied, 1)
                            }
                        }
                    }
                }
                // --- 15 DistPoints: |B-A| = val, move B ---
                IfCondition EqualTo(ctype, 15) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy2), 0) ThenBlock: {
                            ax = ArrayGet(xy, 0)
                            ay = ArrayGet(xy, 1)
                            bx = ArrayGet(xy2, 0)
                            by = ArrayGet(xy2, 1)
                            dx = Float_Sub(bx, ax)
                            dy = Float_Sub(by, ay)
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, Float_Add(ax, val), ay)
                                applied = Add(applied, 1)
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(val, d)
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, Float_Add(ax, Float_Mul(dx, s)), Float_Add(ay, Float_Mul(dy, s)))
                                applied = Add(applied, 1)
                            }
                        }
                    }
                }
                // --- 16 PointOnCircle: A on rim of B ---
                IfCondition EqualTo(ctype, 16) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy2), 0) ThenBlock: {
                            ax = ArrayGet(xy, 0)
                            ay = ArrayGet(xy, 1)
                            cx = ArrayGet(xy2, 0)
                            cy = ArrayGet(xy2, 1)
                            rad = CAD_Sketch.GetCircleRadius(sketch_handle, ib)
                            dx = Float_Sub(ax, cx)
                            dy = Float_Sub(ay, cy)
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, Float_Add(cx, rad), cy)
                                applied = Add(applied, 1)
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(rad, d)
                                CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, Float_Add(cx, Float_Mul(dx, s)), Float_Add(cy, Float_Mul(dy, s)))
                                applied = Add(applied, 1)
                            }
                        }
                    }
                }
                i = Add(i, 1)
            }
            pass = Add(pass, 1)
        }
        Deallocate(xy, 32)
        Deallocate(xy2, 32)
        CAD_Sketch.RebuildAnchors(sketch_handle)
        CAD_Sketch_State.solved_dof = applied
        ReturnValue(applied)
    }
}

// Alias — full constraint solve (same multipass engine)


// Alias — full constraint solve (same multipass engine)
Function.CAD_Sketch.SolveConstraints {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.SolveDatum(sketch_handle))
    }
}

// Add or merge an anchor point. Does not move lines — only the point cloud.
// Returns point index (0-based) or -1.


// Add or merge an anchor point. Does not move lines — only the point cloud.
// Returns point index (0-based) or -1.
Function.CAD_Sketch.AddPoint {
    Input: sketch_handle: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Input: merge_tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 16)
        cap = CAD_Store.Read(sketch_handle, 18)
        pts = CAD_Store.Read(sketch_handle, 17)
        IfCondition EqualTo(pts, 0) ThenBlock: { ReturnValue(-1) }
        tol = merge_tol_r
        IfCondition EqualTo(tol, 0) ThenBlock: { tol = 0x3F50624DD2F1A9FC }
        tol2 = Float_Mul(tol, tol)
        i = 0
        WhileLoop LessThan(i, n) {
            px = ArrayGet(pts, Multiply(i, 2))
            py = ArrayGet(pts, Add(Multiply(i, 2), 1))
            dx = Float_Sub(px, x_r)
            dy = Float_Sub(py, y_r)
            IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), tol2), 1) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(-1) }
        ArraySet(pts, Multiply(n, 2), x_r)
        ArraySet(pts, Add(Multiply(n, 2), 1), y_r)
        CAD_Store.Write(sketch_handle, 16, Add(n, 1))
        ReturnValue(n)
    }
}


Function.CAD_Sketch.GetPointCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 16))
    }
}

// Clear and rebuild anchors: every line end + every crossing + every T-touch.
// Does NOT alter line coordinates — only the anchor point list.
// Returns n_pts.


Function.CAD_Sketch.AddLine {
    Input: sketch_handle: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: x2_r: Integer
    Input: y2_r: Integer
    Output: Integer
    Body: {
        CAD_Sketch_State.work_sk = sketch_handle
        IfCondition EqualTo(CAD_Sketch_State.work_sk, 0) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(CAD_Sketch_State.work_sk, 0)
        cap = CAD_Store.Read(CAD_Sketch_State.work_sk, 5)
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(CAD_Sketch_State.work_sk, 1)
        IfCondition EqualTo(lines, 0) ThenBlock: { ReturnValue(0) }
        base = Multiply(n, 4)
        ArraySet(lines, base, x1_r)
        ArraySet(lines, Add(base, 1), y1_r)
        ArraySet(lines, Add(base, 2), x2_r)
        ArraySet(lines, Add(base, 3), y2_r)
        CAD_Store.Write(CAD_Sketch_State.work_sk, 0, Add(n, 1))
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        // every line end is an anchor (merge if near existing)
        CAD_Sketch.AddPoint(CAD_Sketch_State.work_sk, x1_r, y1_r, 0)
        CAD_Sketch.AddPoint(CAD_Sketch_State.work_sk, x2_r, y2_r, 0)
        ReturnValue(Add(n, 1))
    }
}


Function.CAD_Sketch.GetLineCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 0))
    }
}

// Delete line i (swap with last). Clears profile cache. Returns new count or -1.


// Delete line i (swap with last). Clears profile cache. Returns new count or -1.
Function.CAD_Sketch.DeleteLine {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 0)
        IfCondition LessThan(line_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(line_i, n) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(sketch_handle, 1)
        last = Subtract(n, 1)
        IfCondition NotEqual(line_i, last) ThenBlock: {
            b = Multiply(line_i, 4)
            lb = Multiply(last, 4)
            ArraySet(lines, b, ArrayGet(lines, lb))
            ArraySet(lines, Add(b, 1), ArrayGet(lines, Add(lb, 1)))
            ArraySet(lines, Add(b, 2), ArrayGet(lines, Add(lb, 2)))
            ArraySet(lines, Add(b, 3), ArrayGet(lines, Add(lb, 3)))
        }
        CAD_Store.Write(sketch_handle, 0, last)
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        ReturnValue(last)
    }
}

// Rewrite endpoints of line i. Returns 1 ok, 0 fail.


// Rewrite endpoints of line i. Returns 1 ok, 0 fail.
Function.CAD_Sketch.SetLine {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: x2_r: Integer
    Input: y2_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(sketch_handle, 0)
        IfCondition LessThan(line_i, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(line_i, n) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(sketch_handle, 1)
        b = Multiply(line_i, 4)
        ArraySet(lines, b, x1_r)
        ArraySet(lines, Add(b, 1), y1_r)
        ArraySet(lines, Add(b, 2), x2_r)
        ArraySet(lines, Add(b, 3), y2_r)
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        ReturnValue(1)
    }
}

// Delete circle i (swap with last). Returns new count or -1.


// Delete circle i (swap with last). Returns new count or -1.
Function.CAD_Sketch.DeleteCircle {
    Input: sketch_handle: Integer
    Input: circ_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 7)
        IfCondition LessThan(circ_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(circ_i, n) ThenBlock: { ReturnValue(-1) }
        circs = CAD_Store.Read(sketch_handle, 8)
        last = Subtract(n, 1)
        IfCondition NotEqual(circ_i, last) ThenBlock: {
            b = Multiply(circ_i, 3)
            lb = Multiply(last, 3)
            ArraySet(circs, b, ArrayGet(circs, lb))
            ArraySet(circs, Add(b, 1), ArrayGet(circs, Add(lb, 1)))
            ArraySet(circs, Add(b, 2), ArrayGet(circs, Add(lb, 2)))
        }
        CAD_Store.Write(sketch_handle, 7, last)
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        ReturnValue(last)
    }
}

// Delete arc i (swap with last). Clears profile cache. Returns new count or -1.


// Delete arc i (swap with last). Clears profile cache. Returns new count or -1.
Function.CAD_Sketch.DeleteArc {
    Input: sketch_handle: Integer
    Input: arc_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 10)
        IfCondition LessThan(arc_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(arc_i, n) ThenBlock: { ReturnValue(-1) }
        arcs = CAD_Store.Read(sketch_handle, 11)
        last = Subtract(n, 1)
        IfCondition NotEqual(arc_i, last) ThenBlock: {
            b = Multiply(arc_i, 5)
            lb = Multiply(last, 5)
            ArraySet(arcs, b, ArrayGet(arcs, lb))
            ArraySet(arcs, Add(b, 1), ArrayGet(arcs, Add(lb, 1)))
            ArraySet(arcs, Add(b, 2), ArrayGet(arcs, Add(lb, 2)))
            ArraySet(arcs, Add(b, 3), ArrayGet(arcs, Add(lb, 3)))
            ArraySet(arcs, Add(b, 4), ArrayGet(arcs, Add(lb, 4)))
        }
        CAD_Store.Write(sketch_handle, 10, last)
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        ReturnValue(last)
    }
}


Function.CAD_Sketch.GetLoopCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 2))
    }
}

// Chain LINEs into ordered closed loop (xy pairs in loop_addr).
// Returns n_loop or 0 on failure.


Function.CAD_Sketch.AddCircle {
    Input: sketch_handle: Integer
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: rad_r: Integer
    Output: Integer
    Body: {
        CAD_Sketch_State.work_sk = sketch_handle
        IfCondition EqualTo(CAD_Sketch_State.work_sk, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(rad_r, 0), 1) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(CAD_Sketch_State.work_sk, 7)
        cap = CAD_Store.Read(CAD_Sketch_State.work_sk, 9)
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(0) }
        circs = CAD_Store.Read(CAD_Sketch_State.work_sk, 8)
        IfCondition EqualTo(circs, 0) ThenBlock: { ReturnValue(0) }
        base = Multiply(n, 3)
        ArraySet(circs, base, cx_r)
        ArraySet(circs, Add(base, 1), cy_r)
        ArraySet(circs, Add(base, 2), rad_r)
        CAD_Store.Write(CAD_Sketch_State.work_sk, 7, Add(n, 1))
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        // pin across Rebuild/Split — never pass a live handle after hex-pad heap
        CAD_Sketch.RebuildAnchors(CAD_Sketch_State.work_sk)
        CAD_Sketch.SplitAtIntersections(CAD_Sketch_State.work_sk)
        CAD_Sketch.RebuildAnchors(CAD_Sketch_State.work_sk)
        ReturnValue(Add(n, 1))
    }
}


Function.CAD_Sketch.GetCircleCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 7))
    }
}

// Expand each circle into LINE segs. FORCES vertices at:
//   • uniform samples
//   • every line×circle hit
//   • every circle×circle hit  (3-circle overlap / dogbone / Venn — THE bug)
// so polylines meet at real T/X junctions after SplitAtIntersections.
// Does NOT clear circle count — caller may zero slot 7.


// Arc: center (cx,cy), radius, start/end angles in radians (CCW from +X).
// DXF degrees → rad before call. a1 may be < a0 (crosses 0); span = a1-a0 + 2π if needed.
Function.CAD_Sketch.AddArc {
    Input: sketch_handle: Integer
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: rad_r: Integer
    Input: a0_r: Integer
    Input: a1_r: Integer
    Output: Integer
    Body: {
        // pin all 6 args first (6-float ABI can clobber later reads)
        h = sketch_handle
        pcx = cx_r
        pcy = cy_r
        prad = rad_r
        pa0 = a0_r
        pa1 = a1_r
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(prad, 0), 1) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(h, 10)
        // was 128 — aggressive trim/fillet sessions need headroom
        IfCondition GreaterEqual(n, 512) ThenBlock: { ReturnValue(0) }
        arcs = CAD_Store.Read(h, 11)
        IfCondition EqualTo(arcs, 0) ThenBlock: { ReturnValue(0) }
        base = Multiply(n, 5)
        ArraySet(arcs, base, pcx)
        ArraySet(arcs, Add(base, 1), pcy)
        ArraySet(arcs, Add(base, 2), prad)
        ArraySet(arcs, Add(base, 3), pa0)
        ArraySet(arcs, Add(base, 4), pa1)
        CAD_Store.Write(h, 10, Add(n, 1))
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        CAD_Sketch_State.work_sk = h
        CAD_Sketch.RebuildAnchors(CAD_Sketch_State.work_sk)
        ReturnValue(Add(n, 1))
    }
}


Function.CAD_Sketch.GetArcCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 10))
    }
}

// 2D cross az*bz component: ax*by - ay*bx
// Sketch fillet: two lines + radius R → truncate lines, insert tangent arc.
// Returns 0 ok; -1 null; -2 bad index; -3 parallel/degenerate; -4 R too large / no room.


Function.CAD_Sketch.AddRectangle {
    Input: sketch_handle: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: width_r: Integer
    Input: height_r: Integer
    Output: Integer
    Body: {
        x2_r = Float_Add(x1_r, width_r)
        y2_r = Float_Add(y1_r, height_r)
        CAD_Sketch.AddLine(sketch_handle, x1_r, y1_r, x2_r, y1_r)
        CAD_Sketch.AddLine(sketch_handle, x2_r, y1_r, x2_r, y2_r)
        CAD_Sketch.AddLine(sketch_handle, x2_r, y2_r, x1_r, y2_r)
        CAD_Sketch.AddLine(sketch_handle, x1_r, y2_r, x1_r, y1_r)
        ReturnValue(CAD_Sketch.BuildClosedLoop(sketch_handle))
    }
}


Function.CAD_Sketch.AddSquare {
    Input: sketch_handle: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: side_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddRectangle(sketch_handle, x1_r, y1_r, side_r, side_r))
    }
}

// Polyline through pts (xy pairs). closed=1 connects last→first.


// Polyline through pts (xy pairs). closed=1 connects last→first.
Function.CAD_Sketch.AddPolyline {
    Input: sketch_handle: Integer
    Input: pts_arr_addr: Address
    Input: n_pts: Integer
    Input: closed: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(n_pts, 2) ThenBlock: { ReturnValue(-2) }
        i = 0
        WhileLoop LessThan(i, Subtract(n_pts, 1)) {
            x0 = ArrayGet(pts_arr_addr, Multiply(i, 2))
            y0 = ArrayGet(pts_arr_addr, Add(Multiply(i, 2), 1))
            x1 = ArrayGet(pts_arr_addr, Multiply(Add(i, 1), 2))
            y1 = ArrayGet(pts_arr_addr, Add(Multiply(Add(i, 1), 2), 1))
            CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
            i = Add(i, 1)
        }
        IfCondition EqualTo(closed, 1) ThenBlock: {
            x0 = ArrayGet(pts_arr_addr, Multiply(Subtract(n_pts, 1), 2))
            y0 = ArrayGet(pts_arr_addr, Add(Multiply(Subtract(n_pts, 1), 2), 1))
            x1 = ArrayGet(pts_arr_addr, 0)
            y1 = ArrayGet(pts_arr_addr, 1)
            CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
        }
        ReturnValue(0)
    }
}

// DXF bulge on segment p0→p1: bulge = tan(included/4). |b|≈0 → line; else arc.
// pack: [x0,y0,x1,y1,bulge]


// DXF bulge on segment p0→p1: bulge = tan(included/4). |b|≈0 → line; else arc.
// pack: [x0,y0,x1,y1,bulge]
Function.CAD_Sketch.AddBulgeSegment {
    Input: sketch_handle: Integer
    Input: pack_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        x0 = ArrayGet(pack_addr, 0)
        y0 = ArrayGet(pack_addr, 1)
        x1 = ArrayGet(pack_addr, 2)
        y1 = ArrayGet(pack_addr, 3)
        b = ArrayGet(pack_addr, 4)
        ab = b
        IfCondition EqualTo(Float_Le(ab, 0), 1) ThenBlock: { ab = Float_Sub(0, ab) }
        // |bulge| < 1e-9 → line
        IfCondition EqualTo(Float_Le(ab, 0x3E112E0BE826D695), 1) ThenBlock: {
            ReturnValue(CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1))
        }
        // θ = 4 atan(b)  (signed)
        ang = Float_Mul(CAD_Geom.Atan(b), 0x4010000000000000)
        aabs = ang
        IfCondition EqualTo(Float_Le(aabs, 0), 1) ThenBlock: { aabs = Float_Sub(0, aabs) }
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        chord = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(chord, 0), 1) ThenBlock: { ReturnValue(-4) }
        half = 0x4000000000000000
        // r = (chord/2) / sin(|θ|/2)
        half_a = Float_Div(aabs, half)
        s = CAD_Geom.Sin(half_a)
        IfCondition EqualTo(CAD_Num.IsZero(s, 0), 1) ThenBlock: {
            ReturnValue(CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1))
        }
        r = Float_Div(Float_Div(chord, half), s)
        // mid
        mx = Float_Div(Float_Add(x0, x1), half)
        my = Float_Div(Float_Add(y0, y1), half)
        // unit chord
        ux = Float_Div(dx, chord)
        uy = Float_Div(dy, chord)
        // left perp (-uy, ux)
        px = Float_Sub(0, uy)
        py = ux
        // dist mid→center = r cos(|θ|/2)
        c = CAD_Geom.Cos(half_a)
        d = Float_Mul(r, c)
        // bulge>0: center on left of directed chord
        IfCondition EqualTo(Float_Le(b, 0), 1) ThenBlock: {
            d = Float_Sub(0, d)
        }
        cx = Float_Add(mx, Float_Mul(px, d))
        cy = Float_Add(my, Float_Mul(py, d))
        a0 = CAD_Geom.Atan2(Float_Sub(y0, cy), Float_Sub(x0, cx))
        a1 = CAD_Geom.Atan2(Float_Sub(y1, cy), Float_Sub(x1, cx))
        // Ensure CCW span matches bulge sign
        two_pi = 0x401921FB54442D18
        IfCondition EqualTo(Float_Le(0, b), 1) ThenBlock: {
            // CCW: a1 should be CCW from a0
            span = Float_Sub(a1, a0)
            IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                a1 = Float_Add(a1, two_pi)
            }
        }
        IfCondition EqualTo(Float_Le(b, 0), 1) ThenBlock: {
            // CW arc: store as CCW from a1 to a0 by swapping? AddArc is CCW a0→a1
            // For CW bulge, go a0 CW to a1 = CCW a1 to a0+2π
            // Use a0' = a1, a1' = a0; if a1'<=a0' add 2π to a1'
            ta = a0
            a0 = a1
            a1 = ta
            span = Float_Sub(a1, a0)
            IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                a1 = Float_Add(a1, two_pi)
            }
        }
        ReturnValue(CAD_Sketch.AddArc(sketch_handle, cx, cy, r, a0, a1))
    }
}


Function.CAD_Sketch.GetProfileCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 12))
    }
}

// Signed area of primary loop (or profile 0). 0 if empty.


// Copy profile i verts into out_xy (caller buffer). Returns n or 0.
// Copy profile i into out_xy as interleaved x,y.
// Caller must provide ≥2048 points (32768 bytes). Hard cap prevents heap smash
// (cad_app used 4096-byte buffers = 256 pts → multi-circle pad SEGV after "pad OK").
Function.CAD_Sketch.GetProfileXY {
    Input: sketch_handle: Integer
    Input: profile_i: Integer
    Input: out_xy_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        np = CAD_Store.Read(sketch_handle, 12)
        IfCondition GreaterEqual(profile_i, np) ThenBlock: { ReturnValue(0) }
        pmeta = CAD_Store.Read(sketch_handle, 13)
        pool = CAD_Store.Read(sketch_handle, 14)
        nn = ArrayGet(pmeta, Multiply(profile_i, 2))
        off = ArrayGet(pmeta, Add(Multiply(profile_i, 2), 1))
        // hard cap: 2048 verts
        IfCondition GreaterThan(nn, 2048) ThenBlock: { nn = 2048 }
        k = 0
        WhileLoop LessThan(k, nn) {
            ArraySet(out_xy_addr, Multiply(k, 2), ArrayGet(pool, Multiply(Add(off, k), 2)))
            ArraySet(out_xy_addr, Add(Multiply(k, 2), 1), ArrayGet(pool, Add(Multiply(Add(off, k), 2), 1)))
            k = Add(k, 1)
        }
        ReturnValue(nn)
    }
}

// Build a new sketch whose only closed loop is the given XY ring (n_pts ≥ 3).
// Used for hole/cut tools from multi-profile DXF loops.


// Build a new sketch whose only closed loop is the given XY ring (n_pts ≥ 3).
// Used for hole/cut tools from multi-profile DXF loops.
Function.CAD_Sketch.FromClosedXY {
    Input: xy_addr: Address
    Input: n_pts: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(xy_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_pts, 3) ThenBlock: { ReturnValue(0) }
        h = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n_pts) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n_pts) ThenBlock: { j = 0 }
            x0 = ArrayGet(xy_addr, Multiply(i, 2))
            y0 = ArrayGet(xy_addr, Add(Multiply(i, 2), 1))
            x1 = ArrayGet(xy_addr, Multiply(j, 2))
            y1 = ArrayGet(xy_addr, Add(Multiply(j, 2), 1))
            CAD_Sketch.AddLine(h, x0, y0, x1, y1)
            i = Add(i, 1)
        }
        CAD_Sketch.BuildClosedLoop(h)
        ReturnValue(h)
    }
}

// Append a closed XY ring as the next multi-profile on an existing sketch.
// First call should start from CreateSketch; profile 0 is also mirrored to primary loop.
// Returns new n_profiles or 0 on fail.


// Append a closed XY ring as the next multi-profile on an existing sketch.
// First call should start from CreateSketch; profile 0 is also mirrored to primary loop.
// Returns new n_profiles or 0 on fail.
Function.CAD_Sketch.AddProfileXY {
    Input: sketch_handle: Integer
    Input: xy_addr: Address
    Input: n_pts: Integer
    Output: Integer
    Body: {
        // pin all 3 args first (ABI clobber → n_pts=4 → pad becomes a cube box)
        h = sketch_handle
        addr = xy_addr
        npt = n_pts
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(npt, 3) ThenBlock: { ReturnValue(0) }
        // drop closing duplicate (first==last) — zero-length edge kills earclip caps
        IfCondition GreaterThan(npt, 3) ThenBlock: {
            lx = ArrayGet(addr, Multiply(Subtract(npt, 1), 2))
            ly = ArrayGet(addr, Add(Multiply(Subtract(npt, 1), 2), 1))
            fx = ArrayGet(addr, 0)
            fy = ArrayGet(addr, 1)
            IfCondition EqualTo(CAD_Num.IsEqual(lx, fx, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ly, fy, 0), 1) ThenBlock: {
                    npt = Subtract(npt, 1)
                }
            }
        }
        IfCondition LessThan(npt, 3) ThenBlock: { ReturnValue(0) }
        nprof = CAD_Store.Read(h, 12)
        cap_p = CAD_Store.Read(h, 15)
        IfCondition GreaterEqual(nprof, cap_p) ThenBlock: { ReturnValue(0) }
        pmeta = CAD_Store.Read(h, 13)
        pool = CAD_Store.Read(h, 14)
        // compute current pool_n from last profile
        pool_n = 0
        IfCondition GreaterThan(nprof, 0) ThenBlock: {
            li = Subtract(nprof, 1)
            pool_n = Add(ArrayGet(pmeta, Add(Multiply(li, 2), 1)), ArrayGet(pmeta, Multiply(li, 2)))
        }
        ArraySet(pmeta, Multiply(nprof, 2), npt)
        ArraySet(pmeta, Add(Multiply(nprof, 2), 1), pool_n)
        k = 0
        WhileLoop LessThan(k, npt) {
            ArraySet(pool, Multiply(Add(pool_n, k), 2), ArrayGet(addr, Multiply(k, 2)))
            ArraySet(pool, Add(Multiply(Add(pool_n, k), 2), 1), ArrayGet(addr, Add(Multiply(k, 2), 1)))
            k = Add(k, 1)
        }
        nprof = Add(nprof, 1)
        CAD_Store.Write(h, 12, nprof)
        // first profile → primary loop + lines for ExtrudeProfile
        IfCondition EqualTo(nprof, 1) ThenBlock: {
            ploop = CAD_Store.Read(h, 3)
            k = 0
            WhileLoop LessThan(k, npt) {
                ArraySet(ploop, Multiply(k, 2), ArrayGet(addr, Multiply(k, 2)))
                ArraySet(ploop, Add(Multiply(k, 2), 1), ArrayGet(addr, Add(Multiply(k, 2), 1)))
                k = Add(k, 1)
            }
            CAD_Store.Write(h, 2, npt)
            // also add lines so Extrude has geometry
            i = 0
            WhileLoop LessThan(i, npt) {
                j = Add(i, 1)
                IfCondition EqualTo(j, npt) ThenBlock: { j = 0 }
                x0 = ArrayGet(addr, Multiply(i, 2))
                y0 = ArrayGet(addr, Add(Multiply(i, 2), 1))
                x1 = ArrayGet(addr, Multiply(j, 2))
                y1 = ArrayGet(addr, Add(Multiply(j, 2), 1))
                CAD_Sketch.AddLine(h, x0, y0, x1, y1)
                i = Add(i, 1)
            }
        }
        ReturnValue(nprof)
    }
}

// Validate primary loop: n≥3, |area|>0. Returns 0 ok, negative error.


// Validate primary loop: n≥3, |area|>0. Returns 0 ok, negative error.
Function.CAD_Sketch.ValidateProfile {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: {
            CAD_Sketch_State.last_error = -1
            ReturnValue(-1)
        }
        n = CAD_Store.Read(sketch_handle, 2)
        IfCondition LessThan(n, 3) ThenBlock: {
            n = CAD_Sketch.BuildAllClosedLoops(sketch_handle)
            n = CAD_Store.Read(sketch_handle, 2)
        }
        IfCondition LessThan(n, 3) ThenBlock: {
            CAD_Sketch_State.last_error = -2
            ReturnValue(-2)
        }
        loop = CAD_Store.Read(sketch_handle, 3)
        a = CAD_Sketch.LoopSignedArea(loop, n)
        IfCondition EqualTo(CAD_Num.IsZero(a, 0), 1) ThenBlock: {
            CAD_Sketch_State.last_error = -4
            ReturnValue(-4)
        }
        CAD_Sketch_State.last_error = 0
        ReturnValue(0)
    }
}


Function.CAD_Sketch.AddBSpline {
    Input: sketch_handle: Integer
    Input: ctrl_pts_addr: Address
    Input: degree: Integer
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}


Function.CAD_Sketch.SnapToGrid {
    Input: val_r: Integer
    Input: grid_step_r: Integer
    Output: Integer
    Body: {
        ReturnValue(val_r)
    }
}


Function.CAD_Sketch.SnapToEndPoint {
    Input: sketch_handle: Integer
    Input: mouse_x_r: Integer
    Input: mouse_y_r: Integer
    Input: tol_r: Integer
    Input: out_snap_pt_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_snap_pt_addr, 0, mouse_x_r)
        ArraySet(out_snap_pt_addr, 1, mouse_y_r)
        ReturnValue(0)
    }
}

// Interactive sketch trim: pick nearest entity at (wx,wy) within hit_lim (world),
// split at stored junctions / exact isects, drop piece under click.
// Returns:
//   0 miss
//   1 trimmed line stub
//   2 deleted full circle
//   3 circle → arcs
//   4 trimmed arc (kept residual pieces)
//   5 deleted whole arc tip-to-tip
//   6 trimmed line stub near arc tip
//   7 miss after line split
//   8 arc trim restore (no piece kept — should be rare)


// Promote profile index to primary loop (for pad selection). Returns n pts or 0.
// Mirror profile i into primary loop slots 2/3 for display/export.
// Does NOT call BuildAllClosedLoops — that would mutate live lines and
// replace the multi-profile pool (broke Pick/Next when nprof≥2).
Function.CAD_Sketch.SelectProfile {
    Input: sketch_handle: Integer
    Input: profile_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        nprof = CAD_Store.Read(sketch_handle, 12)
        IfCondition EqualTo(nprof, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(profile_i, nprof) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(profile_i, 0) ThenBlock: { ReturnValue(0) }
        xy = Allocate(4096)
        nn = CAD_Sketch.GetProfileXY(sketch_handle, profile_i, xy)
        IfCondition LessThan(nn, 3) ThenBlock: {
            Deallocate(xy, 4096)
            ReturnValue(0)
        }
        loop = CAD_Store.Read(sketch_handle, 3)
        k = 0
        WhileLoop LessThan(k, nn) {
            ArraySet(loop, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
            ArraySet(loop, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
            k = Add(k, 1)
        }
        CAD_Store.Write(sketch_handle, 2, nn)
        // keep multi-profile count intact
        CAD_Store.Write(sketch_handle, 12, nprof)
        Deallocate(xy, 4096)
        ReturnValue(nn)
    }
}

// Arc: center (cx,cy), radius, start/end angles in radians (CCW from +X).
// DXF degrees → rad before call. a1 may be < a0 (crosses 0); span = a1-a0 + 2π if needed.

