// CAD.Sketch — 2D UV profile IR (Phase A + CS-0 + constraints P0/P1/P3 core).
// Tag 10, stride 28 — see Docs/CAD/CAD_PHASE_A_SKETCH.md + CAD_SKETCHER_IMPL.md
//   0 n_lines  1 lines  2 n_loop(primary)  3 loop_addr(primary)
//   4 workplane  5 cap_lines  6 cap_loop_pts
//   7 n_circles  8 circs  9 cap_circles
//  10 n_arcs  11 arcs
//  12 n_profiles  13 profile_meta [n,start]×  14 loop_pool  15 cap_profiles
//  16 n_pts  17 pts_addr (x,y anchors)  18 cap_pts
//  19 plane_id (0 = world / Sketch_0)
//  20 n_constraints  21 constraints_addr  22 cap_constraints  23 datum_flags
//  24 n_upts  25 upts_addr (user Points x,y)  26 cap_upts  27 reserved
// Constraint record (8 words):
//   type, kind_a, id_a, value, flags, kind_b, id_b, reserved
// type: 1 FixOrigin 2 FixX 3 FixY 4 OnAxisX 5 OnAxisY 6 DistToOrigin
//       7 Horiz 8 Vert 9 Coincident 10 PointOnLine 11 Radius 12 EqualRadius
//       13 TangentLC 14 TangentCC 15 DistPoints 16 PointOnCircle
// target_kind: 0 line-end (id=line*2+end)  1 circle-center  2 whole-line
//              3 user Point  4 circle entity (radius / tangent)
// User Points are first-class (not wiped by RebuildAnchors). Anchors = derived ends/crosses.

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

FixedPool.CAD_Sketch_State {
    "sketch_count":     Initialize=0
    "entity_count":     Initialize=0
    "constraint_count": Initialize=0
    "solved_dof":       Initialize=0
    "last_error":       Initialize=0
    "snaps_performed":  Initialize=0
    // pending value for AddConstraint2 (AILang multi-arg clobber workaround)
    "pend_value":       Initialize=0
}

// Last Arc3Fit result (preview + commit share this — WYSIWYG).
// Also holds pending 3-point inputs: AILang 7-arg calls (handle+6 floats)
// clobber, so Arc3Point(handle) reads x0..y2 from here after Arc3Pend.
FixedPool.CAD_Sketch_Arc3 {
    "cx":  Initialize=0
    "cy":  Initialize=0
    "rad": Initialize=0
    "a0":  Initialize=0
    "a1":  Initialize=0
    "ok":  Initialize=0
    "x0":  Initialize=0
    "y0":  Initialize=0
    "x1":  Initialize=0
    "y1":  Initialize=0
    "x2":  Initialize=0
    "y2":  Initialize=0
}

Function.CAD_Sketch.CreateSketch {
    Input: workplane_id: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(10, 28)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        // lines: 4096 segs × 4 doubles × 8 = 131072 (was 512 — trim/split starved)
        lines = Allocate(131072)
        // primary loop: up to 4096 verts (dense tessellated outer envelopes)
        loop = Allocate(65536)
        circs = Allocate(2048)
        // arcs: up to 512 × 5 doubles (trim/fillet/arc3 can spawn many pieces)
        arcs = Allocate(20480)
        // [n,off] × 64 profiles
        pmeta = Allocate(1024)
        // multi-profile pool: ~8192 verts total across faces
        pool = Allocate(131072)
        pts = Allocate(16384)
        // constraints: 128 × 8 words × 8 = 8192
        cstr = Allocate(8192)
        // user Points: 512 × (x,y) — first-class, not wiped by RebuildAnchors
        upts = Allocate(8192)
        CAD_Store.Write(h, 0, 0)
        CAD_Store.Write(h, 1, lines)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, loop)
        CAD_Store.Write(h, 4, workplane_id)
        CAD_Store.Write(h, 5, 4096)
        CAD_Store.Write(h, 6, 4096)
        CAD_Store.Write(h, 7, 0)
        CAD_Store.Write(h, 8, circs)
        CAD_Store.Write(h, 9, 64)
        CAD_Store.Write(h, 10, 0)
        CAD_Store.Write(h, 11, arcs)
        CAD_Store.Write(h, 12, 0)
        CAD_Store.Write(h, 13, pmeta)
        CAD_Store.Write(h, 14, pool)
        // multi-circle clover can produce many lens faces before outer envelope
        CAD_Store.Write(h, 15, 64)
        CAD_Store.Write(h, 16, 0)
        CAD_Store.Write(h, 17, pts)
        CAD_Store.Write(h, 18, 1024)
        // plane_id 0 = world Sketch_0 frame
        CAD_Store.Write(h, 19, 0)
        CAD_Store.Write(h, 20, 0)
        CAD_Store.Write(h, 21, cstr)
        CAD_Store.Write(h, 22, 128)
        CAD_Store.Write(h, 23, 0)
        CAD_Store.Write(h, 24, 0)
        CAD_Store.Write(h, 25, upts)
        CAD_Store.Write(h, 26, 512)
        CAD_Store.Write(h, 27, 0)
        CAD_Sketch_State.sketch_count = Add(CAD_Sketch_State.sketch_count, 1)
        // immutable datum always present (O / +X / +Y logical — no fake geometry)
        CAD_Sketch.EnsureDatum(h)
        ReturnValue(h)
    }
}

// -------------------------------------------------------------------------
// CS-0 — Sketch_0 datum + absolute origin solver (direct projection)
// -------------------------------------------------------------------------

// Ensure plane_id + datum flag. Idempotent. Returns 0 ok, -1 null.
Function.CAD_Sketch.EnsureDatum {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        // plane_id stays 0 (world) unless SetPlaneId later
        fl = CAD_Store.Read(sketch_handle, 23)
        // bit0 = datum ensured (O/+X/+Y are logical; drawn by app, not fake lines)
        IfCondition EqualTo(BitwiseAnd(fl, 1), 0) ThenBlock: {
            CAD_Store.Write(sketch_handle, 23, BitwiseOr(fl, 1))
        }
        ReturnValue(0)
    }
}

Function.CAD_Sketch.GetPlaneId {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(CAD_Store.Read(sketch_handle, 19))
    }
}

Function.CAD_Sketch.SetPlaneId {
    Input: sketch_handle: Integer
    Input: plane_id: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Store.Write(sketch_handle, 19, plane_id)
        ReturnValue(0)
    }
}

Function.CAD_Sketch.GetConstraintCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 20))
    }
}

// Read line endpoint. end=0 start, end=1 tip. Writes out[0]=x out[1]=y. Returns 0 ok.
Function.CAD_Sketch.GetLineEnd {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: end: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition GreaterEqual(line_i, nl) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(sketch_handle, 1)
        b = Multiply(line_i, 4)
        IfCondition EqualTo(end, 0) ThenBlock: {
            ArraySet(out_xy, 0, ArrayGet(lines, b))
            ArraySet(out_xy, 1, ArrayGet(lines, Add(b, 1)))
        }
        IfCondition NotEqual(end, 0) ThenBlock: {
            ArraySet(out_xy, 0, ArrayGet(lines, Add(b, 2)))
            ArraySet(out_xy, 1, ArrayGet(lines, Add(b, 3)))
        }
        ReturnValue(0)
    }
}

Function.CAD_Sketch.SetLineEnd {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: end: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition GreaterEqual(line_i, nl) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(sketch_handle, 1)
        b = Multiply(line_i, 4)
        IfCondition EqualTo(end, 0) ThenBlock: {
            ArraySet(lines, b, x_r)
            ArraySet(lines, Add(b, 1), y_r)
        }
        IfCondition NotEqual(end, 0) ThenBlock: {
            ArraySet(lines, Add(b, 2), x_r)
            ArraySet(lines, Add(b, 3), y_r)
        }
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// User Points — first-class geometry (pattern anchors, known distances)
// -------------------------------------------------------------------------

// Place a Point in UV. merge_tol_r=0 → no merge (always new). Returns index or -1.
Function.CAD_Sketch.AddUserPoint {
    Input: sketch_handle: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Input: merge_tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 24)
        cap = CAD_Store.Read(sketch_handle, 26)
        up = CAD_Store.Read(sketch_handle, 25)
        IfCondition EqualTo(up, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(merge_tol_r, 0) ThenBlock: {
            tol2 = Float_Mul(merge_tol_r, merge_tol_r)
            i = 0
            WhileLoop LessThan(i, n) {
                px = ArrayGet(up, Multiply(i, 2))
                py = ArrayGet(up, Add(Multiply(i, 2), 1))
                dx = Float_Sub(px, x_r)
                dy = Float_Sub(py, y_r)
                IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), tol2), 1) ThenBlock: {
                    ReturnValue(i)
                }
                i = Add(i, 1)
            }
        }
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(-1) }
        ArraySet(up, Multiply(n, 2), x_r)
        ArraySet(up, Add(Multiply(n, 2), 1), y_r)
        CAD_Store.Write(sketch_handle, 24, Add(n, 1))
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        ReturnValue(n)
    }
}

Function.CAD_Sketch.GetUserPointCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 24))
    }
}

Function.CAD_Sketch.GetUserPoint {
    Input: sketch_handle: Integer
    Input: pi: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 24)
        IfCondition GreaterEqual(pi, n) ThenBlock: { ReturnValue(-1) }
        up = CAD_Store.Read(sketch_handle, 25)
        ArraySet(out_xy, 0, ArrayGet(up, Multiply(pi, 2)))
        ArraySet(out_xy, 1, ArrayGet(up, Add(Multiply(pi, 2), 1)))
        ReturnValue(0)
    }
}

Function.CAD_Sketch.SetUserPoint {
    Input: sketch_handle: Integer
    Input: pi: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 24)
        IfCondition GreaterEqual(pi, n) ThenBlock: { ReturnValue(-1) }
        up = CAD_Store.Read(sketch_handle, 25)
        ArraySet(up, Multiply(pi, 2), x_r)
        ArraySet(up, Add(Multiply(pi, 2), 1), y_r)
        ReturnValue(0)
    }
}

// Circle radius get/set (entity stays circle)
Function.CAD_Sketch.GetCircleRadius {
    Input: sketch_handle: Integer
    Input: ci: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        nc = CAD_Store.Read(sketch_handle, 7)
        IfCondition GreaterEqual(ci, nc) ThenBlock: { ReturnValue(0) }
        circs = CAD_Store.Read(sketch_handle, 8)
        ReturnValue(ArrayGet(circs, Add(Multiply(ci, 3), 2)))
    }
}

Function.CAD_Sketch.SetCircleRadius {
    Input: sketch_handle: Integer
    Input: ci: Integer
    Input: r_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        nc = CAD_Store.Read(sketch_handle, 7)
        IfCondition GreaterEqual(ci, nc) ThenBlock: { ReturnValue(-1) }
        circs = CAD_Store.Read(sketch_handle, 8)
        ArraySet(circs, Add(Multiply(ci, 3), 2), r_r)
        ReturnValue(0)
    }
}

// Get target UV. kind 0 line-end; 1/4 circle center; 3 user Point
Function.CAD_Sketch.GetTargetXY {
    Input: sketch_handle: Integer
    Input: target_kind: Integer
    Input: target_id: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(target_kind, 0) ThenBlock: {
            li = Divide(target_id, 2)
            en = Modulo(target_id, 2)
            ReturnValue(CAD_Sketch.GetLineEnd(sketch_handle, li, en, out_xy))
        }
        IfCondition EqualTo(target_kind, 1) ThenBlock: {
            nc = CAD_Store.Read(sketch_handle, 7)
            IfCondition GreaterEqual(target_id, nc) ThenBlock: { ReturnValue(-1) }
            circs = CAD_Store.Read(sketch_handle, 8)
            base = Multiply(target_id, 3)
            ArraySet(out_xy, 0, ArrayGet(circs, base))
            ArraySet(out_xy, 1, ArrayGet(circs, Add(base, 1)))
            ReturnValue(0)
        }
        IfCondition EqualTo(target_kind, 4) ThenBlock: {
            nc = CAD_Store.Read(sketch_handle, 7)
            IfCondition GreaterEqual(target_id, nc) ThenBlock: { ReturnValue(-1) }
            circs = CAD_Store.Read(sketch_handle, 8)
            base = Multiply(target_id, 3)
            ArraySet(out_xy, 0, ArrayGet(circs, base))
            ArraySet(out_xy, 1, ArrayGet(circs, Add(base, 1)))
            ReturnValue(0)
        }
        IfCondition EqualTo(target_kind, 3) ThenBlock: {
            ReturnValue(CAD_Sketch.GetUserPoint(sketch_handle, target_id, out_xy))
        }
        ReturnValue(-1)
    }
}

Function.CAD_Sketch.SetTargetXY {
    Input: sketch_handle: Integer
    Input: target_kind: Integer
    Input: target_id: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(target_kind, 0) ThenBlock: {
            li = Divide(target_id, 2)
            en = Modulo(target_id, 2)
            ReturnValue(CAD_Sketch.SetLineEnd(sketch_handle, li, en, x_r, y_r))
        }
        IfCondition EqualTo(target_kind, 1) ThenBlock: {
            nc = CAD_Store.Read(sketch_handle, 7)
            IfCondition GreaterEqual(target_id, nc) ThenBlock: { ReturnValue(-1) }
            circs = CAD_Store.Read(sketch_handle, 8)
            base = Multiply(target_id, 3)
            ArraySet(circs, base, x_r)
            ArraySet(circs, Add(base, 1), y_r)
            ReturnValue(0)
        }
        IfCondition EqualTo(target_kind, 4) ThenBlock: {
            nc = CAD_Store.Read(sketch_handle, 7)
            IfCondition GreaterEqual(target_id, nc) ThenBlock: { ReturnValue(-1) }
            circs = CAD_Store.Read(sketch_handle, 8)
            base = Multiply(target_id, 3)
            ArraySet(circs, base, x_r)
            ArraySet(circs, Add(base, 1), y_r)
            ReturnValue(0)
        }
        IfCondition EqualTo(target_kind, 3) ThenBlock: {
            ReturnValue(CAD_Sketch.SetUserPoint(sketch_handle, target_id, x_r, y_r))
        }
        ReturnValue(-1)
    }
}

// Single-target constraint (absolute / H/V / radius). Returns index or -1.
// NOTE: body inlined (not call AddConstraint2) — AILang nested multi-arg can clobber value.
Function.CAD_Sketch.AddConstraint {
    Input: sketch_handle: Integer
    Input: ctype: Integer
    Input: target_kind: Integer
    Input: target_id: Integer
    Input: value_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        n = CAD_Store.Read(sketch_handle, 20)
        cap = CAD_Store.Read(sketch_handle, 22)
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(-1) }
        base = Multiply(n, 8)
        ArraySet(cstr, base, ctype)
        ArraySet(cstr, Add(base, 1), target_kind)
        ArraySet(cstr, Add(base, 2), target_id)
        ArraySet(cstr, Add(base, 3), value_r)
        ArraySet(cstr, Add(base, 4), 0)
        ArraySet(cstr, Add(base, 5), 0)
        ArraySet(cstr, Add(base, 6), 0)
        ArraySet(cstr, Add(base, 7), 0)
        CAD_Store.Write(sketch_handle, 20, Add(n, 1))
        CAD_Sketch_State.constraint_count = Add(CAD_Sketch_State.constraint_count, 1)
        ReturnValue(n)
    }
}

// Set float value for constraint index (dims, DistPoints, Radius via pair API).
Function.CAD_Sketch.SetConstraintValue {
    Input: sketch_handle: Integer
    Input: cid: Integer
    Input: value_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 20)
        IfCondition GreaterEqual(cid, n) ThenBlock: { ReturnValue(-1) }
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(-1) }
        ArraySet(cstr, Add(Multiply(cid, 8), 3), value_r)
        ReturnValue(0)
    }
}

// Stage value for next AddConstraint2 (prefer SetConstraintValue after add for dims).
Function.CAD_Sketch.PendConstraintValue {
    Input: value_r: Integer
    Output: Integer
    Body: {
        CAD_Sketch_State.pend_value = value_r
        ReturnValue(0)
    }
}

// Dual-target constraint (coincident, tangent, dist, …).
// Value: uses pend_value then clears it (set via PendConstraintValue first),
// or call SetConstraintValue(cid, v) after. Avoids 7-arg clobber.
Function.CAD_Sketch.AddConstraint2 {
    Input: sketch_handle: Integer
    Input: ctype: Integer
    Input: kind_a: Integer
    Input: id_a: Integer
    Input: kind_b: Integer
    Input: id_b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        n = CAD_Store.Read(sketch_handle, 20)
        cap = CAD_Store.Read(sketch_handle, 22)
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(-1) }
        ct = ctype
        ka = kind_a
        ia = id_a
        kb = kind_b
        ib = id_b
        vv = CAD_Sketch_State.pend_value
        CAD_Sketch_State.pend_value = 0
        base = Multiply(n, 8)
        ArraySet(cstr, base, ct)
        ArraySet(cstr, Add(base, 1), ka)
        ArraySet(cstr, Add(base, 2), ia)
        ArraySet(cstr, Add(base, 3), vv)
        ArraySet(cstr, Add(base, 4), 0)
        ArraySet(cstr, Add(base, 5), kb)
        ArraySet(cstr, Add(base, 6), ib)
        ArraySet(cstr, Add(base, 7), 0)
        CAD_Store.Write(sketch_handle, 20, Add(n, 1))
        CAD_Sketch_State.constraint_count = Add(CAD_Sketch_State.constraint_count, 1)
        ReturnValue(n)
    }
}

// Snap (wx,wy) to sketch datum. Priority: origin > +X axis > +Y axis.
// Writes out_xy. Returns 0=none 1=origin 2=axisX 3=axisY.
// tol_r = world distance; if 0 uses 0.5 mm default.
Function.CAD_Sketch.SnapToDatum {
    Input: sketch_handle: Integer
    Input: wx: Integer
    Input: wy: Integer
    Input: tol_r: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        ArraySet(out_xy, 0, wx)
        ArraySet(out_xy, 1, wy)
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        tol = tol_r
        IfCondition EqualTo(tol, 0) ThenBlock: {
            // 0.5 mm default
            tol = 0x3FE0000000000000
        }
        // 1) origin
        d2o = Float_Add(Float_Mul(wx, wx), Float_Mul(wy, wy))
        tol2 = Float_Mul(tol, tol)
        IfCondition EqualTo(Float_Le(d2o, tol2), 1) ThenBlock: {
            ArraySet(out_xy, 0, 0)
            ArraySet(out_xy, 1, 0)
            ReturnValue(1)
        }
        // 2) axis X (y → 0), keep x
        ay = wy
        IfCondition EqualTo(Float_Le(ay, 0), 1) ThenBlock: { ay = Float_Sub(0, ay) }
        IfCondition EqualTo(Float_Le(ay, tol), 1) ThenBlock: {
            ArraySet(out_xy, 0, wx)
            ArraySet(out_xy, 1, 0)
            ReturnValue(2)
        }
        // 3) axis Y (x → 0), keep y
        ax = wx
        IfCondition EqualTo(Float_Le(ax, 0), 1) ThenBlock: { ax = Float_Sub(0, ax) }
        IfCondition EqualTo(Float_Le(ax, tol), 1) ThenBlock: {
            ArraySet(out_xy, 0, 0)
            ArraySet(out_xy, 1, wy)
            ReturnValue(3)
        }
        ReturnValue(0)
    }
}

// Multi-pass direct-projection constraint solver (absolute + relational).
// No full Jacobian yet — good enough for origin/H/V/coincident/radius/tangent.
// Returns total apply-hits across passes, or -1 on null.
Function.CAD_Sketch.SolveDatum {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        n = CAD_Store.Read(sketch_handle, 20)
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(0) }
        xy = Allocate(32)
        xy2 = Allocate(32)
        applied = 0
        pass = 0
        WhileLoop LessThan(pass, 10) {
            i = 0
            WhileLoop LessThan(i, n) {
                base = Multiply(i, 8)
                ctype = ArrayGet(cstr, base)
                ka = ArrayGet(cstr, Add(base, 1))
                ia = ArrayGet(cstr, Add(base, 2))
                val = ArrayGet(cstr, Add(base, 3))
                kb = ArrayGet(cstr, Add(base, 5))
                ib = ArrayGet(cstr, Add(base, 6))
                // --- H / V on whole line ---
                IfCondition EqualTo(ctype, 7) ThenBlock: {
                    IfCondition EqualTo(ka, 2) ThenBlock: {
                        lines = CAD_Store.Read(sketch_handle, 1)
                        nl = CAD_Store.Read(sketch_handle, 0)
                        IfCondition LessThan(ia, nl) ThenBlock: {
                            b = Multiply(ia, 4)
                            y0 = ArrayGet(lines, Add(b, 1))
                            ArraySet(lines, Add(b, 3), y0)
                            applied = Add(applied, 1)
                        }
                    }
                }
                IfCondition EqualTo(ctype, 8) ThenBlock: {
                    IfCondition EqualTo(ka, 2) ThenBlock: {
                        lines = CAD_Store.Read(sketch_handle, 1)
                        nl = CAD_Store.Read(sketch_handle, 0)
                        IfCondition LessThan(ia, nl) ThenBlock: {
                            b = Multiply(ia, 4)
                            x0 = ArrayGet(lines, b)
                            ArraySet(lines, Add(b, 2), x0)
                            applied = Add(applied, 1)
                        }
                    }
                }
                // --- Absolute on point (kinds 0/1/3/4 as center) ---
                IfCondition LessThan(ctype, 7) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        px = ArrayGet(xy, 0)
                        py = ArrayGet(xy, 1)
                        nx = px
                        ny = py
                        IfCondition EqualTo(ctype, 1) ThenBlock: {
                            nx = 0
                            ny = 0
                        }
                        IfCondition EqualTo(ctype, 2) ThenBlock: { nx = val }
                        IfCondition EqualTo(ctype, 3) ThenBlock: { ny = val }
                        IfCondition EqualTo(ctype, 4) ThenBlock: { ny = 0 }
                        IfCondition EqualTo(ctype, 5) ThenBlock: { nx = 0 }
                        IfCondition EqualTo(ctype, 6) ThenBlock: {
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(px, px), Float_Mul(py, py)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                nx = val
                                ny = 0
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(val, d)
                                nx = Float_Mul(px, s)
                                ny = Float_Mul(py, s)
                            }
                        }
                        CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, nx, ny)
                        applied = Add(applied, 1)
                    }
                }
                // --- 9 Coincident: B ← A ---
                IfCondition EqualTo(ctype, 9) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, ArrayGet(xy, 0), ArrayGet(xy, 1)), 0) ThenBlock: {
                            applied = Add(applied, 1)
                        }
                    }
                }
                // --- 10 PointOnLine: A on infinite line B (kind 2 = line_i) ---
                IfCondition EqualTo(ctype, 10) ThenBlock: {
                    IfCondition EqualTo(kb, 2) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                            lines = CAD_Store.Read(sketch_handle, 1)
                            nl = CAD_Store.Read(sketch_handle, 0)
                            IfCondition LessThan(ib, nl) ThenBlock: {
                                b = Multiply(ib, 4)
                                x0 = ArrayGet(lines, b)
                                y0 = ArrayGet(lines, Add(b, 1))
                                x1 = ArrayGet(lines, Add(b, 2))
                                y1 = ArrayGet(lines, Add(b, 3))
                                dx = Float_Sub(x1, x0)
                                dy = Float_Sub(y1, y0)
                                aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                                    ax = ArrayGet(xy, 0)
                                    ay = ArrayGet(xy, 1)
                                    t = Float_Div(Float_Add(Float_Mul(Float_Sub(ax, x0), dx), Float_Mul(Float_Sub(ay, y0), dy)), aa)
                                    nx = Float_Add(x0, Float_Mul(t, dx))
                                    ny = Float_Add(y0, Float_Mul(t, dy))
                                    CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, nx, ny)
                                    applied = Add(applied, 1)
                                }
                            }
                        }
                    }
                }
                // --- 11 Radius: set circle radius (kind 1 or 4) ---
                IfCondition EqualTo(ctype, 11) ThenBlock: {
                    ci = ia
                    CAD_Sketch.SetCircleRadius(sketch_handle, ci, val)
                    applied = Add(applied, 1)
                }
                // --- 12 EqualRadius: r(B) = r(A) ---
                IfCondition EqualTo(ctype, 12) ThenBlock: {
                    ra = CAD_Sketch.GetCircleRadius(sketch_handle, ia)
                    CAD_Sketch.SetCircleRadius(sketch_handle, ib, ra)
                    applied = Add(applied, 1)
                }
                // --- 13 Tangent line–circle: move circle center so dist(line)=r ---
                IfCondition EqualTo(ctype, 13) ThenBlock: {
                    // A = line (kind 2), B = circle (1 or 4)
                    IfCondition EqualTo(ka, 2) ThenBlock: {
                        lines = CAD_Store.Read(sketch_handle, 1)
                        nl = CAD_Store.Read(sketch_handle, 0)
                        IfCondition LessThan(ia, nl) ThenBlock: {
                            IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy), 0) ThenBlock: {
                                b = Multiply(ia, 4)
                                x0 = ArrayGet(lines, b)
                                y0 = ArrayGet(lines, Add(b, 1))
                                x1 = ArrayGet(lines, Add(b, 2))
                                y1 = ArrayGet(lines, Add(b, 3))
                                dx = Float_Sub(x1, x0)
                                dy = Float_Sub(y1, y0)
                                llen = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                                IfCondition EqualTo(CAD_Num.IsZero(llen, 0), 0) ThenBlock: {
                                    // unit normal
                                    nxn = Float_Div(Float_Sub(0, dy), llen)
                                    nyn = Float_Div(dx, llen)
                                    cx = ArrayGet(xy, 0)
                                    cy = ArrayGet(xy, 1)
                                    ci = ib
                                    rad = CAD_Sketch.GetCircleRadius(sketch_handle, ci)
                                    sd = Float_Add(Float_Mul(Float_Sub(cx, x0), nxn), Float_Mul(Float_Sub(cy, y0), nyn))
                                    // target signed dist = +r or -r matching side
                                    tgt = rad
                                    IfCondition EqualTo(Float_Le(sd, 0), 1) ThenBlock: {
                                        tgt = Float_Sub(0, rad)
                                    }
                                    delta = Float_Sub(sd, tgt)
                                    ncx = Float_Sub(cx, Float_Mul(delta, nxn))
                                    ncy = Float_Sub(cy, Float_Mul(delta, nyn))
                                    CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, ncx, ncy)
                                    applied = Add(applied, 1)
                                }
                            }
                        }
                    }
                }
                // --- 14 Tangent circle–circle (external): |c2-c1| = r1+r2 ---
                IfCondition EqualTo(ctype, 14) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy2), 0) ThenBlock: {
                            cx1 = ArrayGet(xy, 0)
                            cy1 = ArrayGet(xy, 1)
                            cx2 = ArrayGet(xy2, 0)
                            cy2 = ArrayGet(xy2, 1)
                            r1 = CAD_Sketch.GetCircleRadius(sketch_handle, ia)
                            r2 = CAD_Sketch.GetCircleRadius(sketch_handle, ib)
                            want = Float_Add(r1, r2)
                            dx = Float_Sub(cx2, cx1)
                            dy = Float_Sub(cy2, cy1)
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                // coincident centers — push B on +X
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, Float_Add(cx1, want), cy1)
                                applied = Add(applied, 1)
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(want, d)
                                ncx = Float_Add(cx1, Float_Mul(dx, s))
                                ncy = Float_Add(cy1, Float_Mul(dy, s))
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, ncx, ncy)
                                applied = Add(applied, 1)
                            }
                        }
                    }
                }
                // --- 15 DistPoints: |B-A| = val, move B ---
                IfCondition EqualTo(ctype, 15) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy2), 0) ThenBlock: {
                            ax = ArrayGet(xy, 0)
                            ay = ArrayGet(xy, 1)
                            bx = ArrayGet(xy2, 0)
                            by = ArrayGet(xy2, 1)
                            dx = Float_Sub(bx, ax)
                            dy = Float_Sub(by, ay)
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, Float_Add(ax, val), ay)
                                applied = Add(applied, 1)
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(val, d)
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, Float_Add(ax, Float_Mul(dx, s)), Float_Add(ay, Float_Mul(dy, s)))
                                applied = Add(applied, 1)
                            }
                        }
                    }
                }
                // --- 16 PointOnCircle: A on rim of B ---
                IfCondition EqualTo(ctype, 16) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy2), 0) ThenBlock: {
                            ax = ArrayGet(xy, 0)
                            ay = ArrayGet(xy, 1)
                            cx = ArrayGet(xy2, 0)
                            cy = ArrayGet(xy2, 1)
                            rad = CAD_Sketch.GetCircleRadius(sketch_handle, ib)
                            dx = Float_Sub(ax, cx)
                            dy = Float_Sub(ay, cy)
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, Float_Add(cx, rad), cy)
                                applied = Add(applied, 1)
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(rad, d)
                                CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, Float_Add(cx, Float_Mul(dx, s)), Float_Add(cy, Float_Mul(dy, s)))
                                applied = Add(applied, 1)
                            }
                        }
                    }
                }
                i = Add(i, 1)
            }
            pass = Add(pass, 1)
        }
        Deallocate(xy, 32)
        Deallocate(xy2, 32)
        CAD_Sketch.RebuildAnchors(sketch_handle)
        CAD_Sketch_State.solved_dof = applied
        ReturnValue(applied)
    }
}

// Alias — full constraint solve (same multipass engine)
Function.CAD_Sketch.SolveConstraints {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.SolveDatum(sketch_handle))
    }
}

// Add or merge an anchor point. Does not move lines — only the point cloud.
// Returns point index (0-based) or -1.
Function.CAD_Sketch.AddPoint {
    Input: sketch_handle: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Input: merge_tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 16)
        cap = CAD_Store.Read(sketch_handle, 18)
        pts = CAD_Store.Read(sketch_handle, 17)
        IfCondition EqualTo(pts, 0) ThenBlock: { ReturnValue(-1) }
        tol = merge_tol_r
        IfCondition EqualTo(tol, 0) ThenBlock: { tol = 0x3F50624DD2F1A9FC }
        tol2 = Float_Mul(tol, tol)
        i = 0
        WhileLoop LessThan(i, n) {
            px = ArrayGet(pts, Multiply(i, 2))
            py = ArrayGet(pts, Add(Multiply(i, 2), 1))
            dx = Float_Sub(px, x_r)
            dy = Float_Sub(py, y_r)
            IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), tol2), 1) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(-1) }
        ArraySet(pts, Multiply(n, 2), x_r)
        ArraySet(pts, Add(Multiply(n, 2), 1), y_r)
        CAD_Store.Write(sketch_handle, 16, Add(n, 1))
        ReturnValue(n)
    }
}

Function.CAD_Sketch.GetPointCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 16))
    }
}

// Clear and rebuild anchors: every line end + every crossing + every T-touch.
// Does NOT alter line coordinates — only the anchor point list.
// Returns n_pts.
Function.CAD_Sketch.RebuildAnchors {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(sketch_handle, 16, 0)
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition EqualTo(nl, 0) ThenBlock: {
            // still process arcs/circles (circle×circle anchors need no lines)
            na = CAD_Store.Read(sketch_handle, 10)
            nc0 = CAD_Store.Read(sketch_handle, 7)
            IfCondition EqualTo(na, 0) ThenBlock: {
                IfCondition EqualTo(nc0, 0) ThenBlock: { ReturnValue(0) }
            }
        }
        lines = CAD_Store.Read(sketch_handle, 1)
        // join/merge tol from sketch AABB (lines + arc/circle extents)
        xmin = 0
        ymin = 0
        xmax = 0
        ymax = 0
        first = 1
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            x = ArrayGet(lines, b)
            y = ArrayGet(lines, Add(b, 1))
            IfCondition EqualTo(first, 1) ThenBlock: {
                xmin = x
                ymin = y
                xmax = x
                ymax = y
                first = 0
            }
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            x = ArrayGet(lines, Add(b, 2))
            y = ArrayGet(lines, Add(b, 3))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            i = Add(i, 1)
        }
        // expand AABB by circles/arcs so mtol is sensible when arcs dominate
        na_pre = CAD_Store.Read(sketch_handle, 10)
        arcs_pre = CAD_Store.Read(sketch_handle, 11)
        i = 0
        WhileLoop LessThan(i, na_pre) {
            base = Multiply(i, 5)
            cx = ArrayGet(arcs_pre, base)
            cy = ArrayGet(arcs_pre, Add(base, 1))
            rad = ArrayGet(arcs_pre, Add(base, 2))
            IfCondition EqualTo(first, 1) ThenBlock: {
                xmin = Float_Sub(cx, rad)
                ymin = Float_Sub(cy, rad)
                xmax = Float_Add(cx, rad)
                ymax = Float_Add(cy, rad)
                first = 0
            }
            IfCondition EqualTo(Float_Le(Float_Sub(cx, rad), xmin), 1) ThenBlock: { xmin = Float_Sub(cx, rad) }
            IfCondition EqualTo(Float_Le(xmax, Float_Add(cx, rad)), 1) ThenBlock: { xmax = Float_Add(cx, rad) }
            IfCondition EqualTo(Float_Le(Float_Sub(cy, rad), ymin), 1) ThenBlock: { ymin = Float_Sub(cy, rad) }
            IfCondition EqualTo(Float_Le(ymax, Float_Add(cy, rad)), 1) ThenBlock: { ymax = Float_Add(cy, rad) }
            i = Add(i, 1)
        }
        nc_pre = CAD_Store.Read(sketch_handle, 7)
        circs_pre = CAD_Store.Read(sketch_handle, 8)
        i = 0
        WhileLoop LessThan(i, nc_pre) {
            base = Multiply(i, 3)
            cx = ArrayGet(circs_pre, base)
            cy = ArrayGet(circs_pre, Add(base, 1))
            rad = ArrayGet(circs_pre, Add(base, 2))
            IfCondition EqualTo(first, 1) ThenBlock: {
                xmin = Float_Sub(cx, rad)
                ymin = Float_Sub(cy, rad)
                xmax = Float_Add(cx, rad)
                ymax = Float_Add(cy, rad)
                first = 0
            }
            IfCondition EqualTo(Float_Le(Float_Sub(cx, rad), xmin), 1) ThenBlock: { xmin = Float_Sub(cx, rad) }
            IfCondition EqualTo(Float_Le(xmax, Float_Add(cx, rad)), 1) ThenBlock: { xmax = Float_Add(cx, rad) }
            IfCondition EqualTo(Float_Le(Float_Sub(cy, rad), ymin), 1) ThenBlock: { ymin = Float_Sub(cy, rad) }
            IfCondition EqualTo(Float_Le(ymax, Float_Add(cy, rad)), 1) ThenBlock: { ymax = Float_Add(cy, rad) }
            i = Add(i, 1)
        }
        dxb = Float_Sub(xmax, xmin)
        dyb = Float_Sub(ymax, ymin)
        diag = CAD_Num.Sqrt(Float_Add(Float_Mul(dxb, dxb), Float_Mul(dyb, dyb)))
        // mtol = merge-only (collapse duplicate anchors). Joins themselves are EXACT
        // plane isects from stored coords — no freehand invent / jfree floor.
        mtol = Float_Mul(diag, 0x3F847AE147AE147B)
        floort = 0x3F50624DD2F1A9FC
        IfCondition EqualTo(Float_Le(mtol, floort), 1) ThenBlock: { mtol = floort }
        mtol2 = Float_Mul(mtol, mtol)
        // 1) every line endpoint is an anchor
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            CAD_Sketch.AddPoint(sketch_handle, ArrayGet(lines, b), ArrayGet(lines, Add(b, 1)), mtol)
            CAD_Sketch.AddPoint(sketch_handle, ArrayGet(lines, Add(b, 2)), ArrayGet(lines, Add(b, 3)), mtol)
            i = Add(i, 1)
        }
        // 2) arc endpoints
        na = CAD_Store.Read(sketch_handle, 10)
        arcs = CAD_Store.Read(sketch_handle, 11)
        i = 0
        WhileLoop LessThan(i, na) {
            base = Multiply(i, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            CAD_Sketch.AddPoint(sketch_handle, Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0))), mtol)
            CAD_Sketch.AddPoint(sketch_handle, Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1))), mtol)
            i = Add(i, 1)
        }
        // 3) proper crossings + T-touches between every pair of lines
        i = 0
        WhileLoop LessThan(i, nl) {
            bi = Multiply(i, 4)
            ax0 = ArrayGet(lines, bi)
            ay0 = ArrayGet(lines, Add(bi, 1))
            ax1 = ArrayGet(lines, Add(bi, 2))
            ay1 = ArrayGet(lines, Add(bi, 3))
            adx = Float_Sub(ax1, ax0)
            ady = Float_Sub(ay1, ay0)
            alen2 = Float_Add(Float_Mul(adx, adx), Float_Mul(ady, ady))
            j = Add(i, 1)
            WhileLoop LessThan(j, nl) {
                bj = Multiply(j, 4)
                bx0 = ArrayGet(lines, bj)
                by0 = ArrayGet(lines, Add(bj, 1))
                bx1 = ArrayGet(lines, Add(bj, 2))
                by1 = ArrayGet(lines, Add(bj, 3))
                bdx = Float_Sub(bx1, bx0)
                bdy = Float_Sub(by1, by0)
                den = Float_Sub(Float_Mul(adx, bdy), Float_Mul(ady, bdx))
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    t = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), bdy), Float_Mul(Float_Sub(by0, ay0), bdx)), den)
                    u = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), ady), Float_Mul(Float_Sub(by0, ay0), adx)), den)
                    one = 0x3FF0000000000000
                    ok_t = 1
                    ok_u = 1
                    IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(0, t), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok_t = 0 }
                    }
                    IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(t, one), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok_t = 0 }
                    }
                    IfCondition EqualTo(Float_Le(u, 0), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(0, u), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok_u = 0 }
                    }
                    IfCondition EqualTo(Float_Le(one, u), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(u, one), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok_u = 0 }
                    }
                    IfCondition EqualTo(ok_t, 1) ThenBlock: {
                        IfCondition EqualTo(ok_u, 1) ThenBlock: {
                            px = Float_Add(ax0, Float_Mul(t, adx))
                            py = Float_Add(ay0, Float_Mul(t, ady))
                            CAD_Sketch.AddPoint(sketch_handle, px, py, mtol)
                        }
                    }
                }
                // T: endpoints of j near line i
                IfCondition EqualTo(CAD_Num.IsZero(alen2, 0), 0) ThenBlock: {
                    t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx0, ax0), adx), Float_Mul(Float_Sub(by0, ay0), ady)), alen2)
                    IfCondition EqualTo(Float_Le(t, 0), 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 0) ThenBlock: {
                            px = Float_Add(ax0, Float_Mul(t, adx))
                            py = Float_Add(ay0, Float_Mul(t, ady))
                            ddx = Float_Sub(px, bx0)
                            ddy = Float_Sub(py, by0)
                            IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                                CAD_Sketch.AddPoint(sketch_handle, px, py, mtol)
                            }
                        }
                    }
                    t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx1, ax0), adx), Float_Mul(Float_Sub(by1, ay0), ady)), alen2)
                    IfCondition EqualTo(Float_Le(t, 0), 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 0) ThenBlock: {
                            px = Float_Add(ax0, Float_Mul(t, adx))
                            py = Float_Add(ay0, Float_Mul(t, ady))
                            ddx = Float_Sub(px, bx1)
                            ddy = Float_Sub(py, by1)
                            IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                                CAD_Sketch.AddPoint(sketch_handle, px, py, mtol)
                            }
                        }
                    }
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        // 4) EXACT line × arc crossings from stored plane coords.
        // |P + t D - C|^2 = r^2 → quadratic in t. Accept t ∈ [0,1], angle on arc.
        // No freehand disc invent, no tip slack, no mid-chord near-miss, no rim-project.
        two_pi = 0x401921FB54442D18
        one = 0x3FF0000000000000
        epsa = 0x3F50624DD2F1A9FC
        ai = 0
        WhileLoop LessThan(ai, na) {
            base = Multiply(ai, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, dx, dy))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    // numerical tangent only (not freehand invent)
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, epsa)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            ok = 1
                            // strict segment: t ∈ [0,1] (±eps)
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(t, Float_Sub(0, epsa))), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Add(one, epsa), t)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, CAD_Num.Mul(t, dx))
                                py = Float_Add(y0, CAD_Num.Mul(t, dy))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                                IfCondition EqualTo(Float_Le(dang, Float_Add(span, epsa)), 1) ThenBlock: {
                                    CAD_Sketch.AddPoint(sketch_handle, px, py, mtol)
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                    // exact tip-on-arc: endpoint lies on the circle within mtol
                    ei = 0
                    WhileLoop LessThan(ei, 2) {
                        IfCondition EqualTo(ei, 0) ThenBlock: {
                            px = x0
                            py = y0
                        }
                        IfCondition EqualTo(ei, 1) ThenBlock: {
                            px = x1
                            py = y1
                        }
                        dnear = CAD_Num.Hypot2(Float_Sub(px, cx), Float_Sub(py, cy))
                        dd = CAD_Num.Abs(Float_Sub(dnear, rad))
                        IfCondition EqualTo(Float_Le(dd, mtol), 1) ThenBlock: {
                            ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                            dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                            IfCondition EqualTo(Float_Le(dang, Float_Add(span, epsa)), 1) ThenBlock: {
                                CAD_Sketch.AddPoint(sketch_handle, px, py, mtol)
                            }
                        }
                        ei = Add(ei, 1)
                    }
                }
                li = Add(li, 1)
            }
            ai = Add(ai, 1)
        }
        // 4b) arc × arc crossings (anchors where freehand arcs meet)
        one = 0x3FF0000000000000
        ai = 0
        WhileLoop LessThan(ai, na) {
            base = Multiply(ai, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            aj = Add(ai, 1)
            WhileLoop LessThan(aj, na) {
                bj = Multiply(aj, 5)
                ocx = ArrayGet(arcs, bj)
                ocy = ArrayGet(arcs, Add(bj, 1))
                orad = ArrayGet(arcs, Add(bj, 2))
                oa0 = ArrayGet(arcs, Add(bj, 3))
                oa1 = ArrayGet(arcs, Add(bj, 4))
                ospan = CAD_Num.PosMod2Pi(Float_Sub(oa1, oa0))
                dccx = Float_Sub(ocx, cx)
                dccy = Float_Sub(ocy, cy)
                dcc = CAD_Num.Hypot2(dccx, dccy)
                IfCondition EqualTo(CAD_Num.IsZero(dcc, 0), 0) ThenBlock: {
                    rsum = Float_Add(rad, orad)
                    rdiff = CAD_Num.Abs(Float_Sub(rad, orad))
                    okcc = 1
                    IfCondition EqualTo(Float_Le(dcc, rdiff), 1) ThenBlock: { okcc = 0 }
                    IfCondition EqualTo(Float_Le(rsum, dcc), 1) ThenBlock: { okcc = 0 }
                    IfCondition EqualTo(okcc, 1) ThenBlock: {
                        a = Float_Div(Float_Add(Float_Sub(CAD_Num.Sq(rad), CAD_Num.Sq(orad)), CAD_Num.Sq(dcc)), Float_Mul(0x4000000000000000, dcc))
                        h2 = Float_Sub(CAD_Num.Sq(rad), CAD_Num.Sq(a))
                        IfCondition EqualTo(CAD_Num.IsNeg(h2), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(CAD_Num.Abs(h2), 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                                h2 = 0
                            }
                        }
                        IfCondition EqualTo(CAD_Num.IsNeg(h2), 0) ThenBlock: {
                            h = CAD_Num.Sqrt(h2)
                            mx = Float_Add(cx, CAD_Num.Mul(a, Float_Div(dccx, dcc)))
                            my = Float_Add(cy, CAD_Num.Mul(a, Float_Div(dccy, dcc)))
                            pxu = Float_Div(Float_Sub(0, dccy), dcc)
                            pyu = Float_Div(dccx, dcc)
                            pi = 0
                            WhileLoop LessThan(pi, 2) {
                                sg = one
                                IfCondition EqualTo(pi, 1) ThenBlock: { sg = Float_Sub(0, one) }
                                ix = Float_Add(mx, CAD_Num.Mul(CAD_Num.Mul(sg, h), pxu))
                                iy = Float_Add(my, CAD_Num.Mul(CAD_Num.Mul(sg, h), pyu))
                                ang = CAD_Geom.Atan2(Float_Sub(iy, cy), Float_Sub(ix, cx))
                                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                                on1 = 0
                                IfCondition EqualTo(Float_Le(dang, Float_Add(span, 0x3F50624DD2F1A9FC)), 1) ThenBlock: { on1 = 1 }
                                oang = CAD_Geom.Atan2(Float_Sub(iy, ocy), Float_Sub(ix, ocx))
                                odang = CAD_Num.PosMod2Pi(Float_Sub(oang, oa0))
                                on2 = 0
                                IfCondition EqualTo(Float_Le(odang, Float_Add(ospan, 0x3F50624DD2F1A9FC)), 1) ThenBlock: { on2 = 1 }
                                IfCondition EqualTo(on1, 1) ThenBlock: {
                                    IfCondition EqualTo(on2, 1) ThenBlock: {
                                        CAD_Sketch.AddPoint(sketch_handle, ix, iy, mtol)
                                    }
                                }
                                pi = Add(pi, 1)
                            }
                        }
                    }
                }
                aj = Add(aj, 1)
            }
            ai = Add(ai, 1)
        }
        // 5) EXACT line × full circle crossings (same quadratic; no freehand)
        nc = CAD_Store.Read(sketch_handle, 7)
        circs = CAD_Store.Read(sketch_handle, 8)
        one = 0x3FF0000000000000
        epsa = 0x3F50624DD2F1A9FC
        ci = 0
        WhileLoop LessThan(ci, nc) {
            base = Multiply(ci, 3)
            cx = ArrayGet(circs, base)
            cy = ArrayGet(circs, Add(base, 1))
            rad = ArrayGet(circs, Add(base, 2))
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, dx, dy))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, epsa)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            ok = 1
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(t, Float_Sub(0, epsa))), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Add(one, epsa), t)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, CAD_Num.Mul(t, dx))
                                py = Float_Add(y0, CAD_Num.Mul(t, dy))
                                CAD_Sketch.AddPoint(sketch_handle, px, py, mtol)
                            }
                            hi = Add(hi, 1)
                        }
                    }
                    // exact tip-on-circle
                    ei = 0
                    WhileLoop LessThan(ei, 2) {
                        IfCondition EqualTo(ei, 0) ThenBlock: {
                            px = x0
                            py = y0
                        }
                        IfCondition EqualTo(ei, 1) ThenBlock: {
                            px = x1
                            py = y1
                        }
                        dnear = CAD_Num.Hypot2(Float_Sub(px, cx), Float_Sub(py, cy))
                        dd = CAD_Num.Abs(Float_Sub(dnear, rad))
                        IfCondition EqualTo(Float_Le(dd, mtol), 1) ThenBlock: {
                            CAD_Sketch.AddPoint(sketch_handle, px, py, mtol)
                        }
                        ei = Add(ei, 1)
                    }
                }
                li = Add(li, 1)
            }
            ci = Add(ci, 1)
        }
        // 6) circle × circle crossings (anchors at real T/X of multi-circle sketches)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            base = Multiply(ci, 3)
            cx = ArrayGet(circs, base)
            cy = ArrayGet(circs, Add(base, 1))
            rad = ArrayGet(circs, Add(base, 2))
            cj = Add(ci, 1)
            WhileLoop LessThan(cj, nc) {
                bj = Multiply(cj, 3)
                ox = ArrayGet(circs, bj)
                oy = ArrayGet(circs, Add(bj, 1))
                orad = ArrayGet(circs, Add(bj, 2))
                dx = Float_Sub(ox, cx)
                dy = Float_Sub(oy, cy)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                d = CAD_Num.Sqrt(d2)
                okc = 1
                IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: { okc = 0 }
                IfCondition EqualTo(Float_Le(Float_Add(rad, orad), d), 1) ThenBlock: { okc = 0 }
                dr = Float_Sub(rad, orad)
                IfCondition EqualTo(Float_Le(dr, 0), 1) ThenBlock: { dr = Float_Sub(0, dr) }
                IfCondition EqualTo(Float_Le(d, dr), 1) ThenBlock: { okc = 0 }
                IfCondition EqualTo(okc, 1) ThenBlock: {
                    a = Float_Div(Float_Add(Float_Sub(Float_Mul(rad, rad), Float_Mul(orad, orad)), d2), Float_Mul(0x4000000000000000, d))
                    h2 = Float_Sub(Float_Mul(rad, rad), Float_Mul(a, a))
                    IfCondition EqualTo(Float_Le(h2, 0), 0) ThenBlock: {
                        h = CAD_Num.Sqrt(h2)
                        mx = Float_Add(cx, Float_Mul(a, Float_Div(dx, d)))
                        my = Float_Add(cy, Float_Mul(a, Float_Div(dy, d)))
                        rx = Float_Mul(h, Float_Div(dy, d))
                        ry = Float_Mul(h, Float_Div(dx, d))
                        CAD_Sketch.AddPoint(sketch_handle, Float_Add(mx, rx), Float_Sub(my, ry), mtol)
                        CAD_Sketch.AddPoint(sketch_handle, Float_Sub(mx, rx), Float_Add(my, ry), mtol)
                    }
                }
                cj = Add(cj, 1)
            }
            ci = Add(ci, 1)
        }
        ReturnValue(CAD_Store.Read(sketch_handle, 16))
    }
}

Function.CAD_Sketch.AddLine {
    Input: sketch_handle: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: x2_r: Integer
    Input: y2_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(sketch_handle, 0)
        cap = CAD_Store.Read(sketch_handle, 5)
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(sketch_handle, 1)
        base = Multiply(n, 4)
        ArraySet(lines, base, x1_r)
        ArraySet(lines, Add(base, 1), y1_r)
        ArraySet(lines, Add(base, 2), x2_r)
        ArraySet(lines, Add(base, 3), y2_r)
        CAD_Store.Write(sketch_handle, 0, Add(n, 1))
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        // every line end is an anchor (merge if near existing)
        CAD_Sketch.AddPoint(sketch_handle, x1_r, y1_r, 0)
        CAD_Sketch.AddPoint(sketch_handle, x2_r, y2_r, 0)
        ReturnValue(Add(n, 1))
    }
}

Function.CAD_Sketch.GetLineCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 0))
    }
}

// Delete line i (swap with last). Clears profile cache. Returns new count or -1.
Function.CAD_Sketch.DeleteLine {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 0)
        IfCondition LessThan(line_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(line_i, n) ThenBlock: { ReturnValue(-1) }
        lines = CAD_Store.Read(sketch_handle, 1)
        last = Subtract(n, 1)
        IfCondition NotEqual(line_i, last) ThenBlock: {
            b = Multiply(line_i, 4)
            lb = Multiply(last, 4)
            ArraySet(lines, b, ArrayGet(lines, lb))
            ArraySet(lines, Add(b, 1), ArrayGet(lines, Add(lb, 1)))
            ArraySet(lines, Add(b, 2), ArrayGet(lines, Add(lb, 2)))
            ArraySet(lines, Add(b, 3), ArrayGet(lines, Add(lb, 3)))
        }
        CAD_Store.Write(sketch_handle, 0, last)
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        ReturnValue(last)
    }
}

// Rewrite endpoints of line i. Returns 1 ok, 0 fail.
Function.CAD_Sketch.SetLine {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: x2_r: Integer
    Input: y2_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(sketch_handle, 0)
        IfCondition LessThan(line_i, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(line_i, n) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(sketch_handle, 1)
        b = Multiply(line_i, 4)
        ArraySet(lines, b, x1_r)
        ArraySet(lines, Add(b, 1), y1_r)
        ArraySet(lines, Add(b, 2), x2_r)
        ArraySet(lines, Add(b, 3), y2_r)
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        ReturnValue(1)
    }
}

// Delete circle i (swap with last). Returns new count or -1.
Function.CAD_Sketch.DeleteCircle {
    Input: sketch_handle: Integer
    Input: circ_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 7)
        IfCondition LessThan(circ_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(circ_i, n) ThenBlock: { ReturnValue(-1) }
        circs = CAD_Store.Read(sketch_handle, 8)
        last = Subtract(n, 1)
        IfCondition NotEqual(circ_i, last) ThenBlock: {
            b = Multiply(circ_i, 3)
            lb = Multiply(last, 3)
            ArraySet(circs, b, ArrayGet(circs, lb))
            ArraySet(circs, Add(b, 1), ArrayGet(circs, Add(lb, 1)))
            ArraySet(circs, Add(b, 2), ArrayGet(circs, Add(lb, 2)))
        }
        CAD_Store.Write(sketch_handle, 7, last)
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        ReturnValue(last)
    }
}

// Delete arc i (swap with last). Clears profile cache. Returns new count or -1.
Function.CAD_Sketch.DeleteArc {
    Input: sketch_handle: Integer
    Input: arc_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 10)
        IfCondition LessThan(arc_i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(arc_i, n) ThenBlock: { ReturnValue(-1) }
        arcs = CAD_Store.Read(sketch_handle, 11)
        last = Subtract(n, 1)
        IfCondition NotEqual(arc_i, last) ThenBlock: {
            b = Multiply(arc_i, 5)
            lb = Multiply(last, 5)
            ArraySet(arcs, b, ArrayGet(arcs, lb))
            ArraySet(arcs, Add(b, 1), ArrayGet(arcs, Add(lb, 1)))
            ArraySet(arcs, Add(b, 2), ArrayGet(arcs, Add(lb, 2)))
            ArraySet(arcs, Add(b, 3), ArrayGet(arcs, Add(lb, 3)))
            ArraySet(arcs, Add(b, 4), ArrayGet(arcs, Add(lb, 4)))
        }
        CAD_Store.Write(sketch_handle, 10, last)
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        ReturnValue(last)
    }
}

Function.CAD_Sketch.GetLoopCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 2))
    }
}

// Chain LINEs into ordered closed loop (xy pairs in loop_addr).
// Returns n_loop or 0 on failure.
Function.CAD_Sketch.BuildClosedLoop {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(sketch_handle, 0)
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(sketch_handle, 1)
        loop = CAD_Store.Read(sketch_handle, 3)
        // used flags (one word per line)
        used = Allocate(1024)
        ui = 0
        WhileLoop LessThan(ui, n) {
            ArraySet(used, ui, 0)
            ui = Add(ui, 1)
        }
        // start with line 0: x1,y1 then walk
        ArraySet(loop, 0, ArrayGet(lines, 0))
        ArraySet(loop, 1, ArrayGet(lines, 1))
        tipx = ArrayGet(lines, 2)
        tipy = ArrayGet(lines, 3)
        ArraySet(loop, 2, tipx)
        ArraySet(loop, 3, tipy)
        ArraySet(used, 0, 1)
        nn = 2
        startx = ArrayGet(lines, 0)
        starty = ArrayGet(lines, 1)
        guard = 0
        WhileLoop LessThan(guard, 256) {
            guard = Add(guard, 1)
            // closed?
            IfCondition EqualTo(CAD_Num.IsEqual(tipx, startx, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(tipy, starty, 0), 1) ThenBlock: {
                    // drop duplicate closing point
                    nn = Subtract(nn, 1)
                    guard = 256
                }
            }
            IfCondition LessThan(guard, 256) ThenBlock: {
                found = -1
                rev = 0
                j = 0
                WhileLoop LessThan(j, n) {
                    IfCondition EqualTo(ArrayGet(used, j), 0) ThenBlock: {
                        base = Multiply(j, 4)
                        ax = ArrayGet(lines, base)
                        ay = ArrayGet(lines, Add(base, 1))
                        bx = ArrayGet(lines, Add(base, 2))
                        by = ArrayGet(lines, Add(base, 3))
                        IfCondition EqualTo(CAD_Num.IsEqual(ax, tipx, 0), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsEqual(ay, tipy, 0), 1) ThenBlock: {
                                found = j
                                rev = 0
                                j = n
                            }
                        }
                        IfCondition EqualTo(found, -1) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsEqual(bx, tipx, 0), 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.IsEqual(by, tipy, 0), 1) ThenBlock: {
                                    found = j
                                    rev = 1
                                    j = n
                                }
                            }
                        }
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(found, -1) ThenBlock: {
                    // open chain fail
                    Deallocate(used, 1024)
                    CAD_Store.Write(sketch_handle, 2, 0)
                    ReturnValue(0)
                }
                ArraySet(used, found, 1)
                base = Multiply(found, 4)
                IfCondition EqualTo(rev, 0) ThenBlock: {
                    tipx = ArrayGet(lines, Add(base, 2))
                    tipy = ArrayGet(lines, Add(base, 3))
                }
                IfCondition EqualTo(rev, 1) ThenBlock: {
                    tipx = ArrayGet(lines, base)
                    tipy = ArrayGet(lines, Add(base, 1))
                }
                ArraySet(loop, Multiply(nn, 2), tipx)
                ArraySet(loop, Add(Multiply(nn, 2), 1), tipy)
                nn = Add(nn, 1)
            }
        }
        Deallocate(used, 1024)
        // only succeed if tip returned to start (open chains must not become "profiles")
        closed_ok = 0
        IfCondition GreaterEqual(nn, 3) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(tipx, startx, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(tipy, starty, 0), 1) ThenBlock: {
                    closed_ok = 1
                }
            }
        }
        IfCondition EqualTo(closed_ok, 0) ThenBlock: {
            CAD_Store.Write(sketch_handle, 2, 0)
            ReturnValue(0)
        }
        CAD_Store.Write(sketch_handle, 2, nn)
        ReturnValue(nn)
    }
}

Function.CAD_Sketch.AddCircle {
    Input: sketch_handle: Integer
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: rad_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(rad_r, 0), 1) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(sketch_handle, 7)
        cap = CAD_Store.Read(sketch_handle, 9)
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(0) }
        circs = CAD_Store.Read(sketch_handle, 8)
        base = Multiply(n, 3)
        ArraySet(circs, base, cx_r)
        ArraySet(circs, Add(base, 1), cy_r)
        ArraySet(circs, Add(base, 2), rad_r)
        CAD_Store.Write(sketch_handle, 7, Add(n, 1))
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        // anchors only here — split lines once at end of user gesture (app / Arc3)
        CAD_Sketch.RebuildAnchors(sketch_handle)
        ReturnValue(Add(n, 1))
    }
}

Function.CAD_Sketch.GetCircleCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 7))
    }
}

// Expand each circle into LINE segs. FORCES vertices at:
//   • uniform samples
//   • every line×circle hit
//   • every circle×circle hit  (3-circle overlap / dogbone / Venn — THE bug)
// so polylines meet at real T/X junctions after SplitAtIntersections.
// Does NOT clear circle count — caller may zero slot 7.
Function.CAD_Sketch.TessellateCircles {
    Input: sketch_handle: Integer
    Input: nseg: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg, 8) ThenBlock: { nseg = 32 }
        nc = CAD_Store.Read(sketch_handle, 7)
        IfCondition EqualTo(nc, 0) ThenBlock: { ReturnValue(0) }
        circs = CAD_Store.Read(sketch_handle, 8)
        lines = CAD_Store.Read(sketch_handle, 1)
        nl = CAD_Store.Read(sketch_handle, 0)
        two_pi = 0x401921FB54442D18
        // relative angles in [0, 2π); optional exact (px,py) for line hits
        // (Cos/Sin of Atan2(hit) ≠ hit — that micro-gap broke circle-notch profiles)
        angs = Allocate(512)
        hitx = Allocate(4096)
        hity = Allocate(4096)
        hath = Allocate(512)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            base = Multiply(ci, 3)
            cx = ArrayGet(circs, base)
            cy = ArrayGet(circs, Add(base, 1))
            rad = ArrayGet(circs, Add(base, 2))
            // seed uniform samples (no exact hit)
            nang = 0
            i = 0
            WhileLoop LessThan(i, nseg) {
                ArraySet(angs, nang, Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(nseg))))
                ArraySet(hath, nang, 0)
                nang = Add(nang, 1)
                i = Add(i, 1)
            }
            // line × circle hits — store EXACT line point, not Cos(Atan2)
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, dx, dy))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, 0x3F50624DD2F1A9FC)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            one = 0x3FF0000000000000
                            ok = 1
                            IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(0, t), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok = 0 }
                            }
                            IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(t, one), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok = 0 }
                            }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, Float_Mul(t, dx))
                                py = Float_Add(y0, Float_Mul(t, dy))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                // normalize to [0, 2π)
                                IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, ang), 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                                        ang = Float_Add(ang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(two_pi, ang), 1) ThenBlock: {
                                    ang = Float_Sub(ang, two_pi)
                                }
                                IfCondition LessThan(nang, 500) ThenBlock: {
                                    ArraySet(angs, nang, ang)
                                    ArraySet(hitx, nang, px)
                                    ArraySet(hity, nang, py)
                                    ArraySet(hath, nang, 1)
                                    nang = Add(nang, 1)
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                li = Add(li, 1)
            }
            // circle × circle hits (critical for multi-circle T-junctions)
            cj = 0
            WhileLoop LessThan(cj, nc) {
                IfCondition NotEqual(cj, ci) ThenBlock: {
                    bj = Multiply(cj, 3)
                    ox = ArrayGet(circs, bj)
                    oy = ArrayGet(circs, Add(bj, 1))
                    orad = ArrayGet(circs, Add(bj, 2))
                    dx = Float_Sub(ox, cx)
                    dy = Float_Sub(oy, cy)
                    d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    d = CAD_Num.Sqrt(d2)
                    // valid intersection: |r1-r2| < d < r1+r2 and d > 0
                    okc = 1
                    IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: { okc = 0 }
                    IfCondition EqualTo(Float_Le(Float_Add(rad, orad), d), 1) ThenBlock: { okc = 0 }
                    dr = Float_Sub(rad, orad)
                    IfCondition EqualTo(Float_Le(dr, 0), 1) ThenBlock: { dr = Float_Sub(0, dr) }
                    IfCondition EqualTo(Float_Le(d, dr), 1) ThenBlock: { okc = 0 }
                    IfCondition EqualTo(okc, 1) ThenBlock: {
                        // a = (r1^2 - r2^2 + d^2) / (2d)
                        a = Float_Div(Float_Add(Float_Sub(Float_Mul(rad, rad), Float_Mul(orad, orad)), d2), Float_Mul(0x4000000000000000, d))
                        h2 = Float_Sub(Float_Mul(rad, rad), Float_Mul(a, a))
                        IfCondition EqualTo(Float_Le(h2, 0), 0) ThenBlock: {
                            h = CAD_Num.Sqrt(h2)
                            // midpoint along centers: C + a*(O-C)/d
                            mx = Float_Add(cx, Float_Mul(a, Float_Div(dx, d)))
                            my = Float_Add(cy, Float_Mul(a, Float_Div(dy, d)))
                            // perpendicular offset
                            rx = Float_Mul(h, Float_Div(dy, d))
                            ry = Float_Mul(h, Float_Div(dx, d))
                            // two points
                            hi = 0
                            WhileLoop LessThan(hi, 2) {
                                IfCondition EqualTo(hi, 0) ThenBlock: {
                                    px = Float_Add(mx, rx)
                                    py = Float_Sub(my, ry)
                                }
                                IfCondition EqualTo(hi, 1) ThenBlock: {
                                    px = Float_Sub(mx, rx)
                                    py = Float_Add(my, ry)
                                }
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, ang), 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                                        ang = Float_Add(ang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(two_pi, ang), 1) ThenBlock: {
                                    ang = Float_Sub(ang, two_pi)
                                }
                                IfCondition LessThan(nang, 500) ThenBlock: {
                                    ArraySet(angs, nang, ang)
                                    ArraySet(hath, nang, 0)
                                    nang = Add(nang, 1)
                                }
                                hi = Add(hi, 1)
                            }
                        }
                    }
                }
                cj = Add(cj, 1)
            }
            // bubble-sort angles (+ exact hit coords)
            a = 0
            WhileLoop LessThan(a, nang) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nang) {
                    va = ArrayGet(angs, a)
                    vb = ArrayGet(angs, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(angs, a, vb)
                        ArraySet(angs, bb, va)
                        tx = ArrayGet(hitx, a)
                        ArraySet(hitx, a, ArrayGet(hitx, bb))
                        ArraySet(hitx, bb, tx)
                        ty = ArrayGet(hity, a)
                        ArraySet(hity, a, ArrayGet(hity, bb))
                        ArraySet(hity, bb, ty)
                        th = ArrayGet(hath, a)
                        ArraySet(hath, a, ArrayGet(hath, bb))
                        ArraySet(hath, bb, th)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // prefer exact-hit sample when two angles nearly equal (line tip wins over Cos)
            IfCondition GreaterThan(nang, 1) ThenBlock: {
                w = 0
                r = 0
                WhileLoop LessThan(r, nang) {
                    IfCondition EqualTo(w, 0) ThenBlock: {
                        ArraySet(angs, 0, ArrayGet(angs, r))
                        ArraySet(hitx, 0, ArrayGet(hitx, r))
                        ArraySet(hity, 0, ArrayGet(hity, r))
                        ArraySet(hath, 0, ArrayGet(hath, r))
                        w = 1
                    }
                    IfCondition GreaterThan(r, 0) ThenBlock: {
                        dt = Float_Sub(ArrayGet(angs, r), ArrayGet(angs, Subtract(w, 1)))
                        IfCondition EqualTo(Float_Le(dt, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                            // merge: keep exact hit if either has one
                            IfCondition EqualTo(ArrayGet(hath, r), 1) ThenBlock: {
                                ArraySet(angs, Subtract(w, 1), ArrayGet(angs, r))
                                ArraySet(hitx, Subtract(w, 1), ArrayGet(hitx, r))
                                ArraySet(hity, Subtract(w, 1), ArrayGet(hity, r))
                                ArraySet(hath, Subtract(w, 1), 1)
                            }
                        }
                        IfCondition EqualTo(Float_Le(dt, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                            ArraySet(angs, w, ArrayGet(angs, r))
                            ArraySet(hitx, w, ArrayGet(hitx, r))
                            ArraySet(hity, w, ArrayGet(hity, r))
                            ArraySet(hath, w, ArrayGet(hath, r))
                            w = Add(w, 1)
                        }
                    }
                    r = Add(r, 1)
                }
                nang = w
            }
            // emit unique consecutive + wrap last→first
            IfCondition GreaterThan(nang, 0) ThenBlock: {
                pi_prev = 0
                k = 1
                WhileLoop LessThan(k, nang) {
                    // point at index pi_prev and k
                    IfCondition EqualTo(ArrayGet(hath, pi_prev), 1) ThenBlock: {
                        x0 = ArrayGet(hitx, pi_prev)
                        y0 = ArrayGet(hity, pi_prev)
                    }
                    IfCondition EqualTo(ArrayGet(hath, pi_prev), 0) ThenBlock: {
                        x0 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ArrayGet(angs, pi_prev))))
                        y0 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ArrayGet(angs, pi_prev))))
                    }
                    IfCondition EqualTo(ArrayGet(hath, k), 1) ThenBlock: {
                        x1 = ArrayGet(hitx, k)
                        y1 = ArrayGet(hity, k)
                    }
                    IfCondition EqualTo(ArrayGet(hath, k), 0) ThenBlock: {
                        x1 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ArrayGet(angs, k))))
                        y1 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ArrayGet(angs, k))))
                    }
                    CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
                    pi_prev = k
                    k = Add(k, 1)
                }
                // wrap last → first
                IfCondition EqualTo(ArrayGet(hath, pi_prev), 1) ThenBlock: {
                    x0 = ArrayGet(hitx, pi_prev)
                    y0 = ArrayGet(hity, pi_prev)
                }
                IfCondition EqualTo(ArrayGet(hath, pi_prev), 0) ThenBlock: {
                    x0 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ArrayGet(angs, pi_prev))))
                    y0 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ArrayGet(angs, pi_prev))))
                }
                IfCondition EqualTo(ArrayGet(hath, 0), 1) ThenBlock: {
                    x1 = ArrayGet(hitx, 0)
                    y1 = ArrayGet(hity, 0)
                }
                IfCondition EqualTo(ArrayGet(hath, 0), 0) ThenBlock: {
                    x1 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ArrayGet(angs, 0))))
                    y1 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ArrayGet(angs, 0))))
                }
                CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
            }
            ci = Add(ci, 1)
        }
        Deallocate(angs, 512)
        Deallocate(hitx, 4096)
        Deallocate(hity, 4096)
        Deallocate(hath, 512)
        ReturnValue(CAD_Store.Read(sketch_handle, 0))
    }
}

// Prepare sketch for extrude: merge open line-chains onto circles (clip arc),
// then tessellate remaining full circles. FreeCAD-like "box on circle" pad.
// Mutates sketch (adds LINE segs). Clears profile cache.
// Returns n_profiles after BuildAllClosedLoops, or 0.
// IMPORTANT: never promote a pure-circle pad when the sketch still has user
// lines that did not join any closed loop (that was the "circle always wins" bug).
Function.CAD_Sketch.PrepareExtrude {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        // clear cached loops
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        IfCondition GreaterThan(CAD_Store.Read(sketch_handle, 10), 0) ThenBlock: {
            CAD_Sketch.TessellateArcs(sketch_handle, 32)
        }
        nl0 = CAD_Store.Read(sketch_handle, 0)
        nc = CAD_Store.Read(sketch_handle, 7)
        // pure circles only
        IfCondition EqualTo(nl0, 0) ThenBlock: {
            IfCondition GreaterThan(nc, 0) ThenBlock: {
                CAD_Sketch.TessellateCircles(sketch_handle, 32)
            }
            ReturnValue(CAD_Sketch.BuildAllClosedLoops(sketch_handle))
        }
        IfCondition EqualTo(nc, 0) ThenBlock: {
            ReturnValue(CAD_Sketch.BuildAllClosedLoops(sketch_handle))
        }
        circs = CAD_Store.Read(sketch_handle, 8)
        lines = CAD_Store.Read(sketch_handle, 1)
        two_pi = 0x401921FB54442D18
        // freehand chain join tol (world units) — looser than Num_Tol.linear
        chain_tol = 0x3F50624DD2F1A9FC
        chain_tol2 = Float_Mul(chain_tol, chain_tol)
        // Pre-project only FREE tips (valence 1) onto circle rim.
        // Projecting ALL near-rim points destroyed closed rects near circles.
        li = 0
        WhileLoop LessThan(li, nl0) {
            b = Multiply(li, 4)
            ei = 0
            WhileLoop LessThan(ei, 2) {
                IfCondition EqualTo(ei, 0) ThenBlock: {
                    px = ArrayGet(lines, b)
                    py = ArrayGet(lines, Add(b, 1))
                }
                IfCondition EqualTo(ei, 1) ThenBlock: {
                    px = ArrayGet(lines, Add(b, 2))
                    py = ArrayGet(lines, Add(b, 3))
                }
                // valence = how many other endpoints coincide with this tip
                valence = 0
                lj = 0
                WhileLoop LessThan(lj, nl0) {
                    bj = Multiply(lj, 4)
                    ej = 0
                    WhileLoop LessThan(ej, 2) {
                        skip = 0
                        IfCondition EqualTo(lj, li) ThenBlock: {
                            IfCondition EqualTo(ej, ei) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(skip, 0) ThenBlock: {
                            IfCondition EqualTo(ej, 0) ThenBlock: {
                                qx = ArrayGet(lines, bj)
                                qy = ArrayGet(lines, Add(bj, 1))
                            }
                            IfCondition EqualTo(ej, 1) ThenBlock: {
                                qx = ArrayGet(lines, Add(bj, 2))
                                qy = ArrayGet(lines, Add(bj, 3))
                            }
                            dx = Float_Sub(px, qx)
                            dy = Float_Sub(py, qy)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, chain_tol2), 1) ThenBlock: {
                                valence = Add(valence, 1)
                            }
                        }
                        ej = Add(ej, 1)
                    }
                    lj = Add(lj, 1)
                }
                // only free chain tips
                IfCondition EqualTo(valence, 0) ThenBlock: {
                    best_dd = 0
                    best_ok = 0
                    bcx = 0
                    bcy = 0
                    brad = 0
                    ci = 0
                    WhileLoop LessThan(ci, nc) {
                        base = Multiply(ci, 3)
                        cx = ArrayGet(circs, base)
                        cy = ArrayGet(circs, Add(base, 1))
                        rad = ArrayGet(circs, Add(base, 2))
                        d = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(px, cx), Float_Sub(px, cx)), Float_Mul(Float_Sub(py, cy), Float_Sub(py, cy))))
                        dd = Float_Sub(d, rad)
                        IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                        // |d-rad| <= 40% of radius
                        tol = Float_Mul(rad, 0x3FD999999999999A)
                        IfCondition EqualTo(Float_Le(dd, tol), 1) ThenBlock: {
                            IfCondition EqualTo(best_ok, 0) ThenBlock: {
                                best_ok = 1
                                best_dd = dd
                                bcx = cx
                                bcy = cy
                                brad = rad
                            }
                            IfCondition EqualTo(best_ok, 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(dd, best_dd), 1) ThenBlock: {
                                    best_dd = dd
                                    bcx = cx
                                    bcy = cy
                                    brad = rad
                                }
                            }
                        }
                        ci = Add(ci, 1)
                    }
                    IfCondition EqualTo(best_ok, 1) ThenBlock: {
                        d = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(px, bcx), Float_Sub(px, bcx)), Float_Mul(Float_Sub(py, bcy), Float_Sub(py, bcy))))
                        IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                            px = Float_Add(bcx, Float_Mul(brad, Float_Div(Float_Sub(px, bcx), d)))
                            py = Float_Add(bcy, Float_Mul(brad, Float_Div(Float_Sub(py, bcy), d)))
                            IfCondition EqualTo(ei, 0) ThenBlock: {
                                ArraySet(lines, b, px)
                                ArraySet(lines, Add(b, 1), py)
                            }
                            IfCondition EqualTo(ei, 1) ThenBlock: {
                                ArraySet(lines, Add(b, 2), px)
                                ArraySet(lines, Add(b, 3), py)
                            }
                        }
                    }
                }
                ei = Add(ei, 1)
            }
            li = Add(li, 1)
        }
        // consumed circles
        usedc = Allocate(64)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            ArraySet(usedc, ci, 0)
            ci = Add(ci, 1)
        }
        n_attached = 0
        // line-used flags for chain walk (only original lines 0..nl0-1)
        usedl = Allocate(1024)
        li = 0
        WhileLoop LessThan(li, nl0) {
            ArraySet(usedl, li, 0)
            li = Add(li, 1)
        }
        // grow chains from each unused line
        seed = 0
        WhileLoop LessThan(seed, nl0) {
            IfCondition EqualTo(ArrayGet(usedl, seed), 0) ThenBlock: {
                // start chain at seed: tip = end of seed, start = begin
                ArraySet(usedl, seed, 1)
                // ordered points buffer
                pts = Allocate(4096)
                np = 0
                sx = ArrayGet(lines, Multiply(seed, 4))
                sy = ArrayGet(lines, Add(Multiply(seed, 4), 1))
                ex = ArrayGet(lines, Add(Multiply(seed, 4), 2))
                ey = ArrayGet(lines, Add(Multiply(seed, 4), 3))
                ArraySet(pts, 0, sx)
                ArraySet(pts, 1, sy)
                ArraySet(pts, 2, ex)
                ArraySet(pts, 3, ey)
                np = 2
                tipx = ex
                tipy = ey
                // extend forward (distance join, not only exact IsEqual)
                guard = 0
                WhileLoop LessThan(guard, 256) {
                    guard = Add(guard, 1)
                    found = -1
                    rev = 0
                    best_d2 = chain_tol2
                    j = 0
                    WhileLoop LessThan(j, nl0) {
                        IfCondition EqualTo(ArrayGet(usedl, j), 0) ThenBlock: {
                            b = Multiply(j, 4)
                            ax = ArrayGet(lines, b)
                            ay = ArrayGet(lines, Add(b, 1))
                            bx = ArrayGet(lines, Add(b, 2))
                            by = ArrayGet(lines, Add(b, 3))
                            dx = Float_Sub(ax, tipx)
                            dy = Float_Sub(ay, tipy)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                                best_d2 = d2
                                found = j
                                rev = 0
                            }
                            dx = Float_Sub(bx, tipx)
                            dy = Float_Sub(by, tipy)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                                best_d2 = d2
                                found = j
                                rev = 1
                            }
                        }
                        j = Add(j, 1)
                    }
                    IfCondition EqualTo(found, -1) ThenBlock: {
                        guard = 256
                    }
                    IfCondition GreaterEqual(found, 0) ThenBlock: {
                        ArraySet(usedl, found, 1)
                        b = Multiply(found, 4)
                        IfCondition EqualTo(rev, 0) ThenBlock: {
                            // snap join point so later BuildAllClosedLoops chains cleanly
                            ArraySet(lines, b, tipx)
                            ArraySet(lines, Add(b, 1), tipy)
                            tipx = ArrayGet(lines, Add(b, 2))
                            tipy = ArrayGet(lines, Add(b, 3))
                        }
                        IfCondition EqualTo(rev, 1) ThenBlock: {
                            ArraySet(lines, Add(b, 2), tipx)
                            ArraySet(lines, Add(b, 3), tipy)
                            tipx = ArrayGet(lines, b)
                            tipy = ArrayGet(lines, Add(b, 1))
                        }
                        ArraySet(pts, Multiply(np, 2), tipx)
                        ArraySet(pts, Add(Multiply(np, 2), 1), tipy)
                        np = Add(np, 1)
                    }
                }
                // also extend backward from sx,sy
                tipx = sx
                tipy = sy
                guard = 0
                WhileLoop LessThan(guard, 256) {
                    guard = Add(guard, 1)
                    found = -1
                    rev = 0
                    best_d2 = chain_tol2
                    j = 0
                    WhileLoop LessThan(j, nl0) {
                        IfCondition EqualTo(ArrayGet(usedl, j), 0) ThenBlock: {
                            b = Multiply(j, 4)
                            ax = ArrayGet(lines, b)
                            ay = ArrayGet(lines, Add(b, 1))
                            bx = ArrayGet(lines, Add(b, 2))
                            by = ArrayGet(lines, Add(b, 3))
                            dx = Float_Sub(ax, tipx)
                            dy = Float_Sub(ay, tipy)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                                best_d2 = d2
                                found = j
                                rev = 0
                            }
                            dx = Float_Sub(bx, tipx)
                            dy = Float_Sub(by, tipy)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                                best_d2 = d2
                                found = j
                                rev = 1
                            }
                        }
                        j = Add(j, 1)
                    }
                    IfCondition EqualTo(found, -1) ThenBlock: {
                        guard = 256
                    }
                    IfCondition GreaterEqual(found, 0) ThenBlock: {
                        ArraySet(usedl, found, 1)
                        b = Multiply(found, 4)
                        IfCondition EqualTo(rev, 0) ThenBlock: {
                            ArraySet(lines, b, tipx)
                            ArraySet(lines, Add(b, 1), tipy)
                            tipx = ArrayGet(lines, Add(b, 2))
                            tipy = ArrayGet(lines, Add(b, 3))
                        }
                        IfCondition EqualTo(rev, 1) ThenBlock: {
                            ArraySet(lines, Add(b, 2), tipx)
                            ArraySet(lines, Add(b, 3), tipy)
                            tipx = ArrayGet(lines, b)
                            tipy = ArrayGet(lines, Add(b, 1))
                        }
                        // prepend: shift pts
                        k = np
                        WhileLoop GreaterThan(k, 0) {
                            ArraySet(pts, Multiply(k, 2), ArrayGet(pts, Multiply(Subtract(k, 1), 2)))
                            ArraySet(pts, Add(Multiply(k, 2), 1), ArrayGet(pts, Add(Multiply(Subtract(k, 1), 2), 1)))
                            k = Subtract(k, 1)
                        }
                        ArraySet(pts, 0, tipx)
                        ArraySet(pts, 1, tipy)
                        np = Add(np, 1)
                    }
                }
                // chain ends: pts[0] and pts[np-1]
                IfCondition GreaterEqual(np, 2) ThenBlock: {
                    e0x = ArrayGet(pts, 0)
                    e0y = ArrayGet(pts, 1)
                    e1x = ArrayGet(pts, Multiply(Subtract(np, 1), 2))
                    e1y = ArrayGet(pts, Add(Multiply(Subtract(np, 1), 2), 1))
                    // chain centroid for arc choice
                    cxsum = 0
                    cysum = 0
                    k = 0
                    WhileLoop LessThan(k, np) {
                        cxsum = Float_Add(cxsum, ArrayGet(pts, Multiply(k, 2)))
                        cysum = Float_Add(cysum, ArrayGet(pts, Add(Multiply(k, 2), 1)))
                        k = Add(k, 1)
                    }
                    cnx = Float_Div(cxsum, Float_FromInt(np))
                    cny = Float_Div(cysum, Float_FromInt(np))
                    // which circle?
                    ci = 0
                    WhileLoop LessThan(ci, nc) {
                        IfCondition EqualTo(ArrayGet(usedc, ci), 0) ThenBlock: {
                            base = Multiply(ci, 3)
                            cx = ArrayGet(circs, base)
                            cy = ArrayGet(circs, Add(base, 1))
                            rad = ArrayGet(circs, Add(base, 2))
                            // ends on circle?
                            d0 = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(e0x, cx), Float_Sub(e0x, cx)), Float_Mul(Float_Sub(e0y, cy), Float_Sub(e0y, cy))))
                            d1 = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(e1x, cx), Float_Sub(e1x, cx)), Float_Mul(Float_Sub(e1y, cy), Float_Sub(e1y, cy))))
                            // |d-rad| <= 40% rad (after pre-project, ends should be exact)
                            tol = Float_Mul(rad, 0x3FD999999999999A)
                            dd0 = Float_Sub(d0, rad)
                            IfCondition EqualTo(Float_Le(dd0, 0), 1) ThenBlock: { dd0 = Float_Sub(0, dd0) }
                            dd1 = Float_Sub(d1, rad)
                            IfCondition EqualTo(Float_Le(dd1, 0), 1) ThenBlock: { dd1 = Float_Sub(0, dd1) }
                            ok0 = 0
                            ok1 = 0
                            IfCondition EqualTo(Float_Le(dd0, tol), 1) ThenBlock: { ok0 = 1 }
                            IfCondition EqualTo(Float_Le(dd1, tol), 1) ThenBlock: { ok1 = 1 }
                            // also refuse degenerate: both ends nearly the same point on rim
                            IfCondition EqualTo(ok0, 1) ThenBlock: {
                                IfCondition EqualTo(ok1, 1) ThenBlock: {
                                    ed = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(e0x, e1x), Float_Sub(e0x, e1x)), Float_Mul(Float_Sub(e0y, e1y), Float_Sub(e0y, e1y))))
                                    min_span = Float_Mul(rad, 0x3F847AE147AE147B)
                                    IfCondition EqualTo(Float_Le(ed, min_span), 1) ThenBlock: {
                                        ok0 = 0
                                        ok1 = 0
                                    }
                                }
                            }
                            IfCondition EqualTo(ok0, 1) ThenBlock: {
                                IfCondition EqualTo(ok1, 1) ThenBlock: {
                                    // project ends onto circle exactly
                                    d0 = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(e0x, cx), Float_Sub(e0x, cx)), Float_Mul(Float_Sub(e0y, cy), Float_Sub(e0y, cy))))
                                    d1 = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(e1x, cx), Float_Sub(e1x, cx)), Float_Mul(Float_Sub(e1y, cy), Float_Sub(e1y, cy))))
                                    IfCondition EqualTo(CAD_Num.IsZero(d0, 0), 0) ThenBlock: {
                                        e0x = Float_Add(cx, Float_Mul(rad, Float_Div(Float_Sub(e0x, cx), d0)))
                                        e0y = Float_Add(cy, Float_Mul(rad, Float_Div(Float_Sub(e0y, cy), d0)))
                                    }
                                    IfCondition EqualTo(CAD_Num.IsZero(d1, 0), 0) ThenBlock: {
                                        e1x = Float_Add(cx, Float_Mul(rad, Float_Div(Float_Sub(e1x, cx), d1)))
                                        e1y = Float_Add(cy, Float_Mul(rad, Float_Div(Float_Sub(e1y, cy), d1)))
                                    }
                                    // angles at ends
                                    a0 = CAD_Geom.Atan2(Float_Sub(e0y, cy), Float_Sub(e0x, cx))
                                    a1 = CAD_Geom.Atan2(Float_Sub(e1y, cy), Float_Sub(e1x, cx))
                                    // two possible remaining arcs: CCW a0→a1 and a1→a0
                                    // pick remaining arc mid farther from chain centroid
                                    span01 = Float_Sub(a1, a0)
                                    IfCondition EqualTo(Float_Le(span01, 0), 1) ThenBlock: {
                                        span01 = Float_Add(span01, two_pi)
                                    }
                                    mid01 = Float_Add(a0, Float_Mul(span01, 0x3FE0000000000000))
                                    mx01 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(mid01)))
                                    my01 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(mid01)))
                                    d01 = Float_Add(Float_Mul(Float_Sub(mx01, cnx), Float_Sub(mx01, cnx)), Float_Mul(Float_Sub(my01, cny), Float_Sub(my01, cny)))
                                    span10 = Float_Sub(a0, a1)
                                    IfCondition EqualTo(Float_Le(span10, 0), 1) ThenBlock: {
                                        span10 = Float_Add(span10, two_pi)
                                    }
                                    mid10 = Float_Add(a1, Float_Mul(span10, 0x3FE0000000000000))
                                    mx10 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(mid10)))
                                    my10 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(mid10)))
                                    d10 = Float_Add(Float_Mul(Float_Sub(mx10, cnx), Float_Sub(mx10, cnx)), Float_Mul(Float_Sub(my10, cny), Float_Sub(my10, cny)))
                                    // remaining arc = farther mid from chain
                                    ra0 = a0
                                    ra1 = a1
                                    IfCondition EqualTo(Float_Le(d01, d10), 1) ThenBlock: {
                                        // d10 farther → remaining a1→a0
                                        ra0 = a1
                                        ra1 = a0
                                    }
                                    // tessellate remaining arc into lines
                                    span = Float_Sub(ra1, ra0)
                                    IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                                        span = Float_Add(span, two_pi)
                                    }
                                    nseg = Float_ToInt(Float_Div(Float_Mul(Float_FromInt(32), span), two_pi))
                                    IfCondition LessThan(nseg, 4) ThenBlock: { nseg = 4 }
                                    IfCondition GreaterThan(nseg, 64) ThenBlock: { nseg = 64 }
                                    // remaining arc connectivity: force ends onto chain tips
                                    esx = e0x
                                    esy = e0y
                                    eex = e1x
                                    eey = e1y
                                    IfCondition EqualTo(CAD_Num.IsEqual(ra0, a1, 0), 1) ThenBlock: {
                                        esx = e1x
                                        esy = e1y
                                        eex = e0x
                                        eey = e0y
                                    }
                                    // snap chain tips onto exact rim in the line buffer too
                                    // (pts[0]/pts[last] may have been pre-projected already)
                                    i = 0
                                    WhileLoop LessThan(i, nseg) {
                                        t0 = Float_Div(Float_FromInt(i), Float_FromInt(nseg))
                                        t1 = Float_Div(Float_FromInt(Add(i, 1)), Float_FromInt(nseg))
                                        ang0 = Float_Add(ra0, Float_Mul(span, t0))
                                        ang1 = Float_Add(ra0, Float_Mul(span, t1))
                                        x0 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang0)))
                                        y0 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang0)))
                                        x1 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang1)))
                                        y1 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang1)))
                                        IfCondition EqualTo(i, 0) ThenBlock: {
                                            x0 = esx
                                            y0 = esy
                                        }
                                        IfCondition EqualTo(Add(i, 1), nseg) ThenBlock: {
                                            x1 = eex
                                            y1 = eey
                                        }
                                        CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
                                        i = Add(i, 1)
                                    }
                                    // also force original chain tip verts onto exact projected ends
                                    // so BuildAllClosedLoops joins chain ↔ arc segs
                                    // rewrite line endpoints that match pre-project tips
                                    li2 = 0
                                    WhileLoop LessThan(li2, nl0) {
                                        b2 = Multiply(li2, 4)
                                        ax = ArrayGet(lines, b2)
                                        ay = ArrayGet(lines, Add(b2, 1))
                                        bx = ArrayGet(lines, Add(b2, 2))
                                        by = ArrayGet(lines, Add(b2, 3))
                                        IfCondition EqualTo(CAD_Num.IsEqual(ax, ArrayGet(pts, 0), 0), 1) ThenBlock: {
                                            IfCondition EqualTo(CAD_Num.IsEqual(ay, ArrayGet(pts, 1), 0), 1) ThenBlock: {
                                                ArraySet(lines, b2, e0x)
                                                ArraySet(lines, Add(b2, 1), e0y)
                                            }
                                        }
                                        IfCondition EqualTo(CAD_Num.IsEqual(bx, ArrayGet(pts, 0), 0), 1) ThenBlock: {
                                            IfCondition EqualTo(CAD_Num.IsEqual(by, ArrayGet(pts, 1), 0), 1) ThenBlock: {
                                                ArraySet(lines, Add(b2, 2), e0x)
                                                ArraySet(lines, Add(b2, 3), e0y)
                                            }
                                        }
                                        IfCondition EqualTo(CAD_Num.IsEqual(ax, ArrayGet(pts, Multiply(Subtract(np, 1), 2)), 0), 1) ThenBlock: {
                                            IfCondition EqualTo(CAD_Num.IsEqual(ay, ArrayGet(pts, Add(Multiply(Subtract(np, 1), 2), 1)), 0), 1) ThenBlock: {
                                                ArraySet(lines, b2, e1x)
                                                ArraySet(lines, Add(b2, 1), e1y)
                                            }
                                        }
                                        IfCondition EqualTo(CAD_Num.IsEqual(bx, ArrayGet(pts, Multiply(Subtract(np, 1), 2)), 0), 1) ThenBlock: {
                                            IfCondition EqualTo(CAD_Num.IsEqual(by, ArrayGet(pts, Add(Multiply(Subtract(np, 1), 2), 1)), 0), 1) ThenBlock: {
                                                ArraySet(lines, Add(b2, 2), e1x)
                                                ArraySet(lines, Add(b2, 3), e1y)
                                            }
                                        }
                                        li2 = Add(li2, 1)
                                    }
                                    ArraySet(usedc, ci, 1)
                                    n_attached = Add(n_attached, 1)
                                    ci = nc
                                }
                            }
                        }
                        ci = Add(ci, 1)
                    }
                }
                Deallocate(pts, 4096)
            }
            seed = Add(seed, 1)
        }
        // remaining full circles → closed 32-gons (always; pad selects which profile)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            IfCondition EqualTo(ArrayGet(usedc, ci), 0) ThenBlock: {
                base = Multiply(ci, 3)
                cx = ArrayGet(circs, base)
                cy = ArrayGet(circs, Add(base, 1))
                rad = ArrayGet(circs, Add(base, 2))
                i = 0
                WhileLoop LessThan(i, 32) {
                    a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(32)))
                    a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(i, 1)), Float_FromInt(32)))
                    x0 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0)))
                    y0 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0)))
                    x1 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1)))
                    y1 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1)))
                    CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
                    i = Add(i, 1)
                }
            }
            ci = Add(ci, 1)
        }
        Deallocate(usedc, 64)
        Deallocate(usedl, 1024)
        // circles/arcs now represented as lines
        CAD_Store.Write(sketch_handle, 7, 0)
        CAD_Store.Write(sketch_handle, 10, 0)
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        // stash attach count in last_error for app diagnostics (optional)
        CAD_Sketch_State.last_error = n_attached
        ReturnValue(CAD_Sketch.BuildAllClosedLoops(sketch_handle))
    }
}

// Promote profile index to primary loop (for pad selection). Returns n pts or 0.
// Mirror profile i into primary loop slots 2/3 for display/export.
// Does NOT call BuildAllClosedLoops — that would mutate live lines and
// replace the multi-profile pool (broke Pick/Next when nprof≥2).
Function.CAD_Sketch.SelectProfile {
    Input: sketch_handle: Integer
    Input: profile_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        nprof = CAD_Store.Read(sketch_handle, 12)
        IfCondition EqualTo(nprof, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(profile_i, nprof) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(profile_i, 0) ThenBlock: { ReturnValue(0) }
        xy = Allocate(4096)
        nn = CAD_Sketch.GetProfileXY(sketch_handle, profile_i, xy)
        IfCondition LessThan(nn, 3) ThenBlock: {
            Deallocate(xy, 4096)
            ReturnValue(0)
        }
        loop = CAD_Store.Read(sketch_handle, 3)
        k = 0
        WhileLoop LessThan(k, nn) {
            ArraySet(loop, Multiply(k, 2), ArrayGet(xy, Multiply(k, 2)))
            ArraySet(loop, Add(Multiply(k, 2), 1), ArrayGet(xy, Add(Multiply(k, 2), 1)))
            k = Add(k, 1)
        }
        CAD_Store.Write(sketch_handle, 2, nn)
        // keep multi-profile count intact
        CAD_Store.Write(sketch_handle, 12, nprof)
        Deallocate(xy, 4096)
        ReturnValue(nn)
    }
}

// Arc: center (cx,cy), radius, start/end angles in radians (CCW from +X).
// DXF degrees → rad before call. a1 may be < a0 (crosses 0); span = a1-a0 + 2π if needed.
Function.CAD_Sketch.AddArc {
    Input: sketch_handle: Integer
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: rad_r: Integer
    Input: a0_r: Integer
    Input: a1_r: Integer
    Output: Integer
    Body: {
        // pin all 6 args first (6-float ABI can clobber later reads)
        h = sketch_handle
        pcx = cx_r
        pcy = cy_r
        prad = rad_r
        pa0 = a0_r
        pa1 = a1_r
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(prad, 0), 1) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(h, 10)
        // was 128 — aggressive trim/fillet sessions need headroom
        IfCondition GreaterEqual(n, 512) ThenBlock: { ReturnValue(0) }
        arcs = CAD_Store.Read(h, 11)
        IfCondition EqualTo(arcs, 0) ThenBlock: { ReturnValue(0) }
        base = Multiply(n, 5)
        ArraySet(arcs, base, pcx)
        ArraySet(arcs, Add(base, 1), pcy)
        ArraySet(arcs, Add(base, 2), prad)
        ArraySet(arcs, Add(base, 3), pa0)
        ArraySet(arcs, Add(base, 4), pa1)
        CAD_Store.Write(h, 10, Add(n, 1))
        CAD_Sketch_State.entity_count = Add(CAD_Sketch_State.entity_count, 1)
        // anchors only — do NOT split here (TrimAt emits many AddArcs).
        // Callers that finish a user curve (Arc3Commit / center-arc tool) split once.
        CAD_Sketch.RebuildAnchors(h)
        ReturnValue(Add(n, 1))
    }
}

Function.CAD_Sketch.GetArcCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 10))
    }
}

// 2D cross az*bz component: ax*by - ay*bx
// Sketch fillet: two lines + radius R → truncate lines, insert tangent arc.
// Returns 0 ok; -1 null; -2 bad index; -3 parallel/degenerate; -4 R too large / no room.
Function.CAD_Sketch.FilletLines {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: line_j: Integer
    Input: r_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Num.IsZero(r_r, 0), 1) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(Float_Le(r_r, 0), 1) ThenBlock: { ReturnValue(-4) }
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition LessThan(line_i, 0) ThenBlock: { ReturnValue(-2) }
        IfCondition LessThan(line_j, 0) ThenBlock: { ReturnValue(-2) }
        IfCondition GreaterEqual(line_i, nl) ThenBlock: { ReturnValue(-2) }
        IfCondition GreaterEqual(line_j, nl) ThenBlock: { ReturnValue(-2) }
        IfCondition EqualTo(line_i, line_j) ThenBlock: { ReturnValue(-2) }
        lines = CAD_Store.Read(sketch_handle, 1)
        bi = Multiply(line_i, 4)
        bj = Multiply(line_j, 4)
        ax0 = ArrayGet(lines, bi)
        ay0 = ArrayGet(lines, Add(bi, 1))
        ax1 = ArrayGet(lines, Add(bi, 2))
        ay1 = ArrayGet(lines, Add(bi, 3))
        bx0 = ArrayGet(lines, bj)
        by0 = ArrayGet(lines, Add(bj, 1))
        bx1 = ArrayGet(lines, Add(bj, 2))
        by1 = ArrayGet(lines, Add(bj, 3))
        // directions
        d1x = Float_Sub(ax1, ax0)
        d1y = Float_Sub(ay1, ay0)
        d2x = Float_Sub(bx1, bx0)
        d2y = Float_Sub(by1, by0)
        len1 = CAD_Num.Sqrt(Float_Add(Float_Mul(d1x, d1x), Float_Mul(d1y, d1y)))
        len2 = CAD_Num.Sqrt(Float_Add(Float_Mul(d2x, d2x), Float_Mul(d2y, d2y)))
        IfCondition EqualTo(CAD_Num.IsZero(len1, 0), 1) ThenBlock: { ReturnValue(-3) }
        IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 1) ThenBlock: { ReturnValue(-3) }
        // infinite line intersection I: a0 + t d1 = b0 + s d2
        // cross = d1x d2y - d1y d2x
        cr = Float_Sub(Float_Mul(d1x, d2y), Float_Mul(d1y, d2x))
        acr = cr
        IfCondition EqualTo(Float_Le(acr, 0), 1) ThenBlock: { acr = Float_Sub(0, acr) }
        // |cross| < 1e-12 * |d1||d2| ~ parallel
        IfCondition EqualTo(Float_Le(acr, 0x3D719799812DEA11), 1) ThenBlock: { ReturnValue(-3) }
        // t = cross(b0-a0, d2) / cross(d1,d2)
        ex = Float_Sub(bx0, ax0)
        ey = Float_Sub(by0, ay0)
        t = Float_Div(Float_Sub(Float_Mul(ex, d2y), Float_Mul(ey, d2x)), cr)
        ix = Float_Add(ax0, Float_Mul(t, d1x))
        iy = Float_Add(ay0, Float_Mul(t, d1y))
        // unit directions from I into each segment (toward segment midpoint)
        m1x = Float_Mul(Float_Add(ax0, ax1), 0x3FE0000000000000)
        m1y = Float_Mul(Float_Add(ay0, ay1), 0x3FE0000000000000)
        m2x = Float_Mul(Float_Add(bx0, bx1), 0x3FE0000000000000)
        m2y = Float_Mul(Float_Add(by0, by1), 0x3FE0000000000000)
        u1x = Float_Sub(m1x, ix)
        u1y = Float_Sub(m1y, iy)
        u2x = Float_Sub(m2x, ix)
        u2y = Float_Sub(m2y, iy)
        lu1 = CAD_Num.Sqrt(Float_Add(Float_Mul(u1x, u1x), Float_Mul(u1y, u1y)))
        lu2 = CAD_Num.Sqrt(Float_Add(Float_Mul(u2x, u2x), Float_Mul(u2y, u2y)))
        IfCondition EqualTo(CAD_Num.IsZero(lu1, 0), 1) ThenBlock: { ReturnValue(-3) }
        IfCondition EqualTo(CAD_Num.IsZero(lu2, 0), 1) ThenBlock: { ReturnValue(-3) }
        u1x = Float_Div(u1x, lu1)
        u1y = Float_Div(u1y, lu1)
        u2x = Float_Div(u2x, lu2)
        u2y = Float_Div(u2y, lu2)
        // far endpoints (kept ends)
        // line1: pick endpoint in +u1 direction from I
        da0 = Float_Add(Float_Mul(Float_Sub(ax0, ix), u1x), Float_Mul(Float_Sub(ay0, iy), u1y))
        da1 = Float_Add(Float_Mul(Float_Sub(ax1, ix), u1x), Float_Mul(Float_Sub(ay1, iy), u1y))
        f1x = ax0
        f1y = ay0
        IfCondition EqualTo(Float_Le(da0, da1), 1) ThenBlock: {
            f1x = ax1
            f1y = ay1
        }
        db0 = Float_Add(Float_Mul(Float_Sub(bx0, ix), u2x), Float_Mul(Float_Sub(by0, iy), u2y))
        db1 = Float_Add(Float_Mul(Float_Sub(bx1, ix), u2x), Float_Mul(Float_Sub(by1, iy), u2y))
        f2x = bx0
        f2y = by0
        IfCondition EqualTo(Float_Le(db0, db1), 1) ThenBlock: {
            f2x = bx1
            f2y = by1
        }
        // inward normals into wedge (u1,u2)
        n1x = Float_Sub(0, u1y)
        n1y = u1x
        // if n1 · u2 < 0 flip
        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(n1x, u2x), Float_Mul(n1y, u2y)), 0), 1) ThenBlock: {
            n1x = Float_Sub(0, n1x)
            n1y = Float_Sub(0, n1y)
        }
        n2x = Float_Sub(0, u2y)
        n2y = u2x
        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(n2x, u1x), Float_Mul(n2y, u1y)), 0), 1) ThenBlock: {
            n2x = Float_Sub(0, n2x)
            n2y = Float_Sub(0, n2y)
        }
        // offset lines: (I + R n) + t u ; solve C
        // t u1 - s u2 = R (n2 - n1)
        rx = Float_Mul(r_r, Float_Sub(n2x, n1x))
        ry = Float_Mul(r_r, Float_Sub(n2y, n1y))
        // t u1 + (-u2) s = r
        cr2 = Float_Sub(Float_Mul(u1x, Float_Sub(0, u2y)), Float_Mul(u1y, Float_Sub(0, u2x)))
        // = -(u1x u2y - u1y u2x) = -cross(u1,u2)
        acu = cr2
        IfCondition EqualTo(Float_Le(acu, 0), 1) ThenBlock: { acu = Float_Sub(0, acu) }
        IfCondition EqualTo(Float_Le(acu, 0x3D719799812DEA11), 1) ThenBlock: { ReturnValue(-3) }
        // t = cross(r, -u2) / cross(u1, -u2)
        tt = Float_Div(Float_Sub(Float_Mul(rx, Float_Sub(0, u2y)), Float_Mul(ry, Float_Sub(0, u2x))), cr2)
        cx = Float_Add(Float_Add(ix, Float_Mul(r_r, n1x)), Float_Mul(tt, u1x))
        cy = Float_Add(Float_Add(iy, Float_Mul(r_r, n1y)), Float_Mul(tt, u1y))
        // tangent points
        t1x = Float_Sub(cx, Float_Mul(r_r, n1x))
        t1y = Float_Sub(cy, Float_Mul(r_r, n1y))
        t2x = Float_Sub(cx, Float_Mul(r_r, n2x))
        t2y = Float_Sub(cy, Float_Mul(r_r, n2y))
        // room check: T must lie between I and far end on each leg
        // dist I→T and I→F along u
        g1 = Float_Add(Float_Mul(Float_Sub(t1x, ix), u1x), Float_Mul(Float_Sub(t1y, iy), u1y))
        g2 = Float_Add(Float_Mul(Float_Sub(t2x, ix), u2x), Float_Mul(Float_Sub(t2y, iy), u2y))
        h1 = Float_Add(Float_Mul(Float_Sub(f1x, ix), u1x), Float_Mul(Float_Sub(f1y, iy), u1y))
        h2 = Float_Add(Float_Mul(Float_Sub(f2x, ix), u2x), Float_Mul(Float_Sub(f2y, iy), u2y))
        IfCondition EqualTo(Float_Le(g1, 0), 1) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(Float_Le(g2, 0), 1) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(Float_Le(h1, g1), 1) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(Float_Le(h2, g2), 1) ThenBlock: { ReturnValue(-4) }
        // rewrite lines: far end -- tangent point
        CAD_Sketch.SetLine(sketch_handle, line_i, f1x, f1y, t1x, t1y)
        CAD_Sketch.SetLine(sketch_handle, line_j, f2x, f2y, t2x, t2y)
        // arc angles CCW from T1 to T2 (pick span whose midpoint is closer to I)
        a1 = CAD_Geom.Atan2(Float_Sub(t1y, cy), Float_Sub(t1x, cx))
        a2 = CAD_Geom.Atan2(Float_Sub(t2y, cy), Float_Sub(t2x, cx))
        two_pi = 0x401921FB54442D18
        // span CCW a1 → a2
        s12 = Float_Sub(a2, a1)
        IfCondition EqualTo(Float_Le(s12, 0), 1) ThenBlock: {
            s12 = Float_Add(s12, two_pi)
        }
        mid12 = Float_Add(a1, Float_Mul(s12, 0x3FE0000000000000))
        mx = Float_Add(cx, Float_Mul(r_r, CAD_Geom.Cos(mid12)))
        my = Float_Add(cy, Float_Mul(r_r, CAD_Geom.Sin(mid12)))
        d12 = Float_Add(Float_Mul(Float_Sub(mx, ix), Float_Sub(mx, ix)), Float_Mul(Float_Sub(my, iy), Float_Sub(my, iy)))
        // span CCW a2 → a1
        s21 = Float_Sub(a1, a2)
        IfCondition EqualTo(Float_Le(s21, 0), 1) ThenBlock: {
            s21 = Float_Add(s21, two_pi)
        }
        mid21 = Float_Add(a2, Float_Mul(s21, 0x3FE0000000000000))
        mx2 = Float_Add(cx, Float_Mul(r_r, CAD_Geom.Cos(mid21)))
        my2 = Float_Add(cy, Float_Mul(r_r, CAD_Geom.Sin(mid21)))
        d21 = Float_Add(Float_Mul(Float_Sub(mx2, ix), Float_Sub(mx2, ix)), Float_Mul(Float_Sub(my2, iy), Float_Sub(my2, iy)))
        aa0 = a1
        aa1 = a2
        // prefer mid closer to corner I
        IfCondition EqualTo(Float_Le(d21, d12), 1) ThenBlock: {
            aa0 = a2
            aa1 = a1
        }
        ar = CAD_Sketch.AddArc(sketch_handle, cx, cy, r_r, aa0, aa1)
        IfCondition EqualTo(ar, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Sketch.SnapArcEndsToSketch(sketch_handle, 0)
        CAD_Sketch.RebuildAnchors(sketch_handle)
        ReturnValue(0)
    }
}

// Fit using ONLY CAD_Sketch_Arc3.x0..y2 (set by Arc3Pend).
// All math here — never pass 6 floats across a call (ABI clobber).
// Returns 0 ok, -3 collinear/degenerate.
Function.CAD_Sketch.Arc3FitPend {
    Output: Integer
    Body: {
        CAD_Sketch_Arc3.ok = 0
        ax = CAD_Sketch_Arc3.x0
        ay = CAD_Sketch_Arc3.y0
        bx = CAD_Sketch_Arc3.x1
        by = CAD_Sketch_Arc3.y1
        cxp = CAD_Sketch_Arc3.x2
        cyp = CAD_Sketch_Arc3.y2
        // D = 2(ax(by-cyp)+bx(cyp-ay)+cxp(ay-by)) — CAD_Num.Mul for signed reliability
        t1 = CAD_Num.Mul(ax, Float_Sub(by, cyp))
        t2 = CAD_Num.Mul(bx, Float_Sub(cyp, ay))
        t3 = CAD_Num.Mul(cxp, Float_Sub(ay, by))
        D = CAD_Num.Mul(Float_Add(Float_Add(t1, t2), t3), 0x4000000000000000)
        aD = CAD_Num.Abs(D)
        IfCondition EqualTo(Float_Le(aD, 0x3D719799812DEA11), 1) ThenBlock: {
            ReturnValue(-3)
        }
        a2 = Float_Add(CAD_Num.Sq(ax), CAD_Num.Sq(ay))
        b2 = Float_Add(CAD_Num.Sq(bx), CAD_Num.Sq(by))
        c2 = Float_Add(CAD_Num.Sq(cxp), CAD_Num.Sq(cyp))
        ux = Float_Add(CAD_Num.Mul(a2, Float_Sub(by, cyp)), CAD_Num.Mul(b2, Float_Sub(cyp, ay)))
        ux = Float_Add(ux, CAD_Num.Mul(c2, Float_Sub(ay, by)))
        ux = Float_Div(ux, D)
        uy = Float_Add(CAD_Num.Mul(a2, Float_Sub(cxp, bx)), CAD_Num.Mul(b2, Float_Sub(ax, cxp)))
        uy = Float_Add(uy, CAD_Num.Mul(c2, Float_Sub(bx, ax)))
        uy = Float_Div(uy, D)
        rad = CAD_Num.Hypot2(Float_Sub(ax, ux), Float_Sub(ay, uy))
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 1) ThenBlock: {
            ReturnValue(-3)
        }
        ang0 = CAD_Geom.Atan2(Float_Sub(ay, uy), Float_Sub(ax, ux))
        angT = CAD_Geom.Atan2(Float_Sub(by, uy), Float_Sub(bx, ux))
        ang2 = CAD_Geom.Atan2(Float_Sub(cyp, uy), Float_Sub(cxp, ux))
        sA = CAD_Num.PosMod2Pi(Float_Sub(ang2, ang0))
        sT = CAD_Num.PosMod2Pi(Float_Sub(angT, ang0))
        aa0 = ang0
        aa1 = ang2
        // through not on CCW a0→a2 → reverse
        IfCondition EqualTo(Float_Le(sT, Float_Add(sA, 0x3F50624DD2F1A9FC)), 0) ThenBlock: {
            aa0 = ang2
            aa1 = ang0
        }
        CAD_Sketch_Arc3.cx = ux
        CAD_Sketch_Arc3.cy = uy
        CAD_Sketch_Arc3.rad = rad
        CAD_Sketch_Arc3.a0 = aa0
        CAD_Sketch_Arc3.a1 = aa1
        CAD_Sketch_Arc3.ok = 1
        ReturnValue(0)
    }
}

// Convenience: stage 6 points then fit. Prefer Arc3Pend + Arc3FitPend at call sites.
Function.CAD_Sketch.Arc3Fit {
    Input: x0_r: Integer
    Input: y0_r: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: x2_r: Integer
    Input: y2_r: Integer
    Output: Integer
    Body: {
        CAD_Sketch.Arc3Pend(x0_r, y0_r, x1_r, y1_r, x2_r, y2_r)
        ReturnValue(CAD_Sketch.Arc3FitPend())
    }
}

// Stage 3-point arc inputs (6 floats OK). Never pass handle+6 in one call —
// AILang 7-arg clobber corrupts Fit (wrong center → profile stops under arc).
Function.CAD_Sketch.Arc3Pend {
    Input: x0_r: Integer
    Input: y0_r: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: x2_r: Integer
    Input: y2_r: Integer
    Output: Integer
    Body: {
        // pin all 6 before any FixedPool write
        px0 = x0_r
        py0 = y0_r
        px1 = x1_r
        py1 = y1_r
        px2 = x2_r
        py2 = y2_r
        CAD_Sketch_Arc3.x0 = px0
        CAD_Sketch_Arc3.y0 = py0
        CAD_Sketch_Arc3.x1 = px1
        CAD_Sketch_Arc3.y1 = py1
        CAD_Sketch_Arc3.x2 = px2
        CAD_Sketch_Arc3.y2 = py2
        CAD_Sketch_Arc3.ok = 0
        ReturnValue(0)
    }
}

// Arc through pending 3 points (Arc3Pend) then Fit+Commit from pool only.
// Handle-only API — 7-arg (handle+6 floats) was corrupting the circle fit.
Function.CAD_Sketch.Arc3Point {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        // pin pending points out of pool before Fit (Fit rewrites cx..a1/ok)
        px0 = CAD_Sketch_Arc3.x0
        py0 = CAD_Sketch_Arc3.y0
        px1 = CAD_Sketch_Arc3.x1
        py1 = CAD_Sketch_Arc3.y1
        px2 = CAD_Sketch_Arc3.x2
        py2 = CAD_Sketch_Arc3.y2
        fr = CAD_Sketch.Arc3FitPend()
        IfCondition NotEqual(fr, 0) ThenBlock: { ReturnValue(fr) }
        ReturnValue(CAD_Sketch.Arc3CommitLast(h))
    }
}

// Commit last successful Arc3Fit (preview params) — WYSIWYG with UI preview.
Function.CAD_Sketch.Arc3CommitLast {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Sketch_Arc3.ok, 0) ThenBlock: { ReturnValue(-3) }
        // pin pool fields before AddArc (nested calls must not re-read pool mid-call)
        cx = CAD_Sketch_Arc3.cx
        cy = CAD_Sketch_Arc3.cy
        rad = CAD_Sketch_Arc3.rad
        aa0 = CAD_Sketch_Arc3.a0
        aa1 = CAD_Sketch_Arc3.a1
        ar = CAD_Sketch.AddArc(h, cx, cy, rad, aa0, aa1)
        IfCondition EqualTo(ar, 0) ThenBlock: { ReturnValue(-1) }
        // weld tips + rebuild junction anchors
        CAD_Sketch.SnapArcEndsToSketch(h, 0)
        CAD_Sketch.RebuildAnchors(h)
        // one pass over lines present at commit (split may append pieces at end)
        nl_s = CAD_Store.Read(h, 0)
        si = 0
        WhileLoop LessThan(si, nl_s) {
            CAD_Sketch.SplitLineAtHits(h, si)
            si = Add(si, 1)
        }
        CAD_Sketch.RebuildAnchors(h)
        ReturnValue(0)
    }
}

// Split line_i at (x,y) if that point lies in the open segment. Returns 1 if split.
Function.CAD_Sketch.SplitLineAtXY {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition GreaterEqual(line_i, nl) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(sketch_handle, 1)
        b = Multiply(line_i, 4)
        x0 = ArrayGet(lines, b)
        y0 = ArrayGet(lines, Add(b, 1))
        x1 = ArrayGet(lines, Add(b, 2))
        y1 = ArrayGet(lines, Add(b, 3))
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 1) ThenBlock: { ReturnValue(0) }
        t = Float_Div(Float_Add(Float_Mul(Float_Sub(x_r, x0), dx), Float_Mul(Float_Sub(y_r, y0), dy)), aa)
        eps = 0x3F50624DD2F1A9FC
        one = 0x3FF0000000000000
        IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(Float_Sub(one, t), eps), 1) ThenBlock: { ReturnValue(0) }
        // first piece overwrites line_i; second appended
        CAD_Sketch.SetLine(sketch_handle, line_i, x0, y0, x_r, y_r)
        CAD_Sketch.AddLine(sketch_handle, x_r, y_r, x1, y1)
        ReturnValue(1)
    }
}

// Pull nearby line ends (and mid-line body) onto arc endpoints so face-walk
// and trim share exact UV. Also splits long V-legs when Arc3 hits mid-side.
// tol_r=0 → 1.0 mm default. Returns n welds/splits.
Function.CAD_Sketch.SnapArcEndsToSketch {
    Input: sketch_handle: Integer
    Input: tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        na = CAD_Store.Read(sketch_handle, 10)
        IfCondition EqualTo(na, 0) ThenBlock: { ReturnValue(0) }
        arcs = CAD_Store.Read(sketch_handle, 11)
        nl = CAD_Store.Read(sketch_handle, 0)
        lines = CAD_Store.Read(sketch_handle, 1)
        tol = tol_r
        IfCondition EqualTo(tol, 0) ThenBlock: {
            // auto from sketch AABB diagonal (~2% , floor 0.5, cap 5%)
            // fixed 2.0 was random: too tight on large sketches, too loose on small
            nl0 = CAD_Store.Read(sketch_handle, 0)
            lines0 = CAD_Store.Read(sketch_handle, 1)
            na0 = CAD_Store.Read(sketch_handle, 10)
            arcs0 = CAD_Store.Read(sketch_handle, 11)
            xmin = 0
            ymin = 0
            xmax = 0
            ymax = 0
            first = 1
            bi = 0
            WhileLoop LessThan(bi, nl0) {
                b0 = Multiply(bi, 4)
                x = ArrayGet(lines0, b0)
                y = ArrayGet(lines0, Add(b0, 1))
                IfCondition EqualTo(first, 1) ThenBlock: {
                    xmin = x
                    ymin = y
                    xmax = x
                    ymax = y
                    first = 0
                }
                IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
                IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
                IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
                IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
                x = ArrayGet(lines0, Add(b0, 2))
                y = ArrayGet(lines0, Add(b0, 3))
                IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
                IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
                IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
                IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
                bi = Add(bi, 1)
            }
            bi = 0
            WhileLoop LessThan(bi, na0) {
                b0 = Multiply(bi, 5)
                cx0 = ArrayGet(arcs0, b0)
                cy0 = ArrayGet(arcs0, Add(b0, 1))
                r0 = ArrayGet(arcs0, Add(b0, 2))
                IfCondition EqualTo(first, 1) ThenBlock: {
                    xmin = Float_Sub(cx0, r0)
                    ymin = Float_Sub(cy0, r0)
                    xmax = Float_Add(cx0, r0)
                    ymax = Float_Add(cy0, r0)
                    first = 0
                }
                IfCondition EqualTo(Float_Le(Float_Sub(cx0, r0), xmin), 1) ThenBlock: { xmin = Float_Sub(cx0, r0) }
                IfCondition EqualTo(Float_Le(xmax, Float_Add(cx0, r0)), 1) ThenBlock: { xmax = Float_Add(cx0, r0) }
                IfCondition EqualTo(Float_Le(Float_Sub(cy0, r0), ymin), 1) ThenBlock: { ymin = Float_Sub(cy0, r0) }
                IfCondition EqualTo(Float_Le(ymax, Float_Add(cy0, r0)), 1) ThenBlock: { ymax = Float_Add(cy0, r0) }
                bi = Add(bi, 1)
            }
            dxb = Float_Sub(xmax, xmin)
            dyb = Float_Sub(ymax, ymin)
            diag = CAD_Num.Sqrt(Float_Add(CAD_Num.Sq(dxb), CAD_Num.Sq(dyb)))
            tol = Float_Mul(diag, 0x3F847AE147AE147B)
            // 1% diag
            floort = 0x3FE0000000000000
            // 0.5
            capt = Float_Mul(diag, 0x3F9EB851EB851EB8)
            // 3% cap
            IfCondition EqualTo(Float_Le(tol, floort), 1) ThenBlock: { tol = floort }
            IfCondition EqualTo(Float_Le(capt, tol), 1) ThenBlock: { tol = capt }
            IfCondition EqualTo(CAD_Num.IsZero(diag, 0), 1) ThenBlock: {
                tol = 0x3FF0000000000000
            }
        }
        tol2 = Float_Mul(tol, tol)
        nweld = 0
        ai = 0
        WhileLoop LessThan(ai, na) {
            // re-read nl each arc (splits grow the list)
            nl = CAD_Store.Read(sketch_handle, 0)
            lines = CAD_Store.Read(sketch_handle, 1)
            base = Multiply(ai, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            e = 0
            WhileLoop LessThan(e, 2) {
                ang = a0
                IfCondition EqualTo(e, 1) ThenBlock: { ang = a1 }
                ex = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang)))
                ey = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang)))
                // 1) nearest line END within tol → pull tip to arc tip
                best = tol2
                bli = -1
                ben = 0
                li = 0
                WhileLoop LessThan(li, nl) {
                    b = Multiply(li, 4)
                    en = 0
                    WhileLoop LessThan(en, 2) {
                        IfCondition EqualTo(en, 0) ThenBlock: {
                            lx = ArrayGet(lines, b)
                            ly = ArrayGet(lines, Add(b, 1))
                        }
                        IfCondition EqualTo(en, 1) ThenBlock: {
                            lx = ArrayGet(lines, Add(b, 2))
                            ly = ArrayGet(lines, Add(b, 3))
                        }
                        dx = Float_Sub(lx, ex)
                        dy = Float_Sub(ly, ey)
                        d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                            best = d2
                            bli = li
                            ben = en
                        }
                        en = Add(en, 1)
                    }
                    li = Add(li, 1)
                }
                IfCondition GreaterEqual(bli, 0) ThenBlock: {
                    CAD_Sketch.SetLineEnd(sketch_handle, bli, ben, ex, ey)
                    nweld = Add(nweld, 1)
                }
                // 2) if tip near a LINE BODY (not only ends), split the line there
                //    so V-legs gain a vertex at the arc tip (mid-side Arc3 / scoop)
                bestb = tol2
                bli2 = -1
                li = 0
                nl = CAD_Store.Read(sketch_handle, 0)
                lines = CAD_Store.Read(sketch_handle, 1)
                WhileLoop LessThan(li, nl) {
                    b = Multiply(li, 4)
                    x0 = ArrayGet(lines, b)
                    y0 = ArrayGet(lines, Add(b, 1))
                    x1 = ArrayGet(lines, Add(b, 2))
                    y1 = ArrayGet(lines, Add(b, 3))
                    dx = Float_Sub(x1, x0)
                    dy = Float_Sub(y1, y0)
                    aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(ex, x0), dx), Float_Mul(Float_Sub(ey, y0), dy)), aa)
                        eps = 0x3F50624DD2F1A9FC
                        one = 0x3FF0000000000000
                        IfCondition EqualTo(Float_Le(t, eps), 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(one, t), eps), 0) ThenBlock: {
                                qx = Float_Add(x0, Float_Mul(t, dx))
                                qy = Float_Add(y0, Float_Mul(t, dy))
                                ddx = Float_Sub(qx, ex)
                                ddy = Float_Sub(qy, ey)
                                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                                IfCondition EqualTo(Float_Le(d2, bestb), 1) ThenBlock: {
                                    bestb = d2
                                    bli2 = li
                                }
                            }
                        }
                    }
                    li = Add(li, 1)
                }
                IfCondition GreaterEqual(bli2, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.SplitLineAtXY(sketch_handle, bli2, ex, ey), 1) ThenBlock: {
                        nweld = Add(nweld, 1)
                    }
                }
                // other arc endpoints near this tip → snap their angle to this tip
                // (share exact point by rewriting other arc's a0/a1 from this tip)
                aj = 0
                WhileLoop LessThan(aj, na) {
                    IfCondition NotEqual(aj, ai) ThenBlock: {
                        bj = Multiply(aj, 5)
                        ocx = ArrayGet(arcs, bj)
                        ocy = ArrayGet(arcs, Add(bj, 1))
                        orad = ArrayGet(arcs, Add(bj, 2))
                        oa0 = ArrayGet(arcs, Add(bj, 3))
                        oa1 = ArrayGet(arcs, Add(bj, 4))
                        ee = 0
                        WhileLoop LessThan(ee, 2) {
                            oang = oa0
                            IfCondition EqualTo(ee, 1) ThenBlock: { oang = oa1 }
                            ox = Float_Add(ocx, Float_Mul(orad, CAD_Geom.Cos(oang)))
                            oy = Float_Add(ocy, Float_Mul(orad, CAD_Geom.Sin(oang)))
                            dx = Float_Sub(ox, ex)
                            dy = Float_Sub(oy, ey)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, tol2), 1) ThenBlock: {
                                // project this tip onto other circle → new angle
                                // only if tip is near other rim
                                dcr = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(ex, ocx), Float_Sub(ex, ocx)), Float_Mul(Float_Sub(ey, ocy), Float_Sub(ey, ocy))))
                                dd = Float_Sub(dcr, orad)
                                IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                                IfCondition EqualTo(Float_Le(dd, tol), 1) ThenBlock: {
                                    nang = CAD_Geom.Atan2(Float_Sub(ey, ocy), Float_Sub(ex, ocx))
                                    IfCondition EqualTo(ee, 0) ThenBlock: {
                                        ArraySet(arcs, Add(bj, 3), nang)
                                    }
                                    IfCondition EqualTo(ee, 1) ThenBlock: {
                                        ArraySet(arcs, Add(bj, 4), nang)
                                    }
                                    nweld = Add(nweld, 1)
                                }
                            }
                            ee = Add(ee, 1)
                        }
                    }
                    aj = Add(aj, 1)
                }
                e = Add(e, 1)
            }
            ai = Add(ai, 1)
        }
        ReturnValue(nweld)
    }
}

// Expand arcs into LINE segs. FORCES vertices at every line×arc hit so a
// line drawn through the true arc also meets the polyline (anchors alone
// are not enough — inscribed n-gon chords can miss the real crossings).
// Clears n_arcs after.
Function.CAD_Sketch.TessellateArcs {
    Input: sketch_handle: Integer
    Input: nseg_max: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg_max, 8) ThenBlock: { nseg_max = 32 }
        na = CAD_Store.Read(sketch_handle, 10)
        IfCondition EqualTo(na, 0) ThenBlock: { ReturnValue(0) }
        arcs = CAD_Store.Read(sketch_handle, 11)
        lines = CAD_Store.Read(sketch_handle, 1)
        nl = CAD_Store.Read(sketch_handle, 0)
        two_pi = 0x401921FB54442D18
        // store parameter t in [0,1] along arc span (0=a0, 1=a1)
        ts = Allocate(512)
        ai = 0
        WhileLoop LessThan(ai, na) {
            base = Multiply(ai, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            // Density: enough verts that profile fill matches display arc (shallow
            // scoops used to get nseg=4 and the red pad stopped under the purple curve).
            nseg = Float_ToInt(Float_Div(Float_Mul(Float_FromInt(nseg_max), span), 0x400921FB54442D18))
            // nseg_max * span / pi  (was / 2pi → half as many)
            IfCondition LessThan(nseg, 24) ThenBlock: { nseg = 24 }
            IfCondition GreaterThan(nseg, 256) ThenBlock: { nseg = 256 }
            nt = 0
            // uniform samples as t in [0,1]
            i = 0
            WhileLoop LessThan(i, Add(nseg, 1)) {
                ArraySet(ts, nt, Float_Div(Float_FromInt(i), Float_FromInt(nseg)))
                nt = Add(nt, 1)
                i = Add(i, 1)
            }
            // line × arc hits → t along span (PosMod2Pi / IsNeg — Float_Le(neg,0) broken)
            one = 0x3FF0000000000000
            epsa = 0x3F50624DD2F1A9FC
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, dx, dy))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, epsa)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        ht0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        ht1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            tline = ht0
                            IfCondition EqualTo(hi, 1) ThenBlock: { tline = ht1 }
                            ok = 1
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(tline, epsa)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Add(one, epsa), tline)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, Float_Mul(tline, dx))
                                py = Float_Add(y0, Float_Mul(tline, dy))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                                IfCondition EqualTo(Float_Le(dang, Float_Add(span, epsa)), 1) ThenBlock: {
                                    tt = 0
                                    IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                        tt = Float_Div(dang, span)
                                    }
                                    IfCondition EqualTo(CAD_Num.IsNeg(tt), 1) ThenBlock: { tt = 0 }
                                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(one, tt)), 1) ThenBlock: { tt = one }
                                    IfCondition LessThan(nt, 500) ThenBlock: {
                                        ArraySet(ts, nt, tt)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                // line tips near rim → force tess sample (junction after SnapArcEnds)
                ei = 0
                WhileLoop LessThan(ei, 2) {
                    IfCondition EqualTo(ei, 0) ThenBlock: {
                        px = x0
                        py = y0
                    }
                    IfCondition EqualTo(ei, 1) ThenBlock: {
                        px = x1
                        py = y1
                    }
                    d = CAD_Num.Hypot2(Float_Sub(px, cx), Float_Sub(py, cy))
                    dd = CAD_Num.Abs(Float_Sub(d, rad))
                    IfCondition EqualTo(Float_Le(dd, Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                        dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                        IfCondition EqualTo(Float_Le(dang, Float_Add(span, epsa)), 1) ThenBlock: {
                            tt = 0
                            IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                tt = Float_Div(dang, span)
                            }
                            IfCondition EqualTo(CAD_Num.IsNeg(tt), 1) ThenBlock: { tt = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(one, tt)), 1) ThenBlock: { tt = one }
                            IfCondition LessThan(nt, 500) ThenBlock: {
                                ArraySet(ts, nt, tt)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                    ei = Add(ei, 1)
                }
                li = Add(li, 1)
            }
            // sort t ascending
            a = 0
            WhileLoop LessThan(a, nt) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nt) {
                    va = ArrayGet(ts, a)
                    vb = ArrayGet(ts, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(ts, a, vb)
                        ArraySet(ts, bb, va)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // emit unique segments
            IfCondition GreaterThan(nt, 1) ThenBlock: {
                prev = ArrayGet(ts, 0)
                k = 1
                WhileLoop LessThan(k, nt) {
                    cur = ArrayGet(ts, k)
                    dt = Float_Sub(cur, prev)
                    IfCondition EqualTo(Float_Le(dt, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
                        ang0 = Float_Add(a0, Float_Mul(span, prev))
                        ang1 = Float_Add(a0, Float_Mul(span, cur))
                        x0 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang0)))
                        y0 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang0)))
                        x1 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang1)))
                        y1 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang1)))
                        CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
                        prev = cur
                    }
                    k = Add(k, 1)
                }
            }
            ai = Add(ai, 1)
        }
        Deallocate(ts, 512)
        CAD_Store.Write(sketch_handle, 10, 0)
        ReturnValue(CAD_Store.Read(sketch_handle, 0))
    }
}

// Split every LINE at crossings + T-junctions + circle/arc rim hits.
// Works with a single line against circles (nl==1) — critical for trim-to-point.
// Does NOT tessellate circles/arcs; live entities stay clean.
// Returns new line count.
Function.CAD_Sketch.SplitAtIntersections {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        nl = CAD_Store.Read(sketch_handle, 0)
        // allow 1 line: still split at circle/arc hits
        IfCondition LessThan(nl, 1) ThenBlock: { ReturnValue(nl) }
        lines = CAD_Store.Read(sketch_handle, 1)
        cap = CAD_Store.Read(sketch_handle, 5)
        // freehand meet tol from AABB (lines + circles + arcs)
        xmin = ArrayGet(lines, 0)
        ymin = ArrayGet(lines, 1)
        xmax = xmin
        ymax = ymin
        bi0 = 0
        WhileLoop LessThan(bi0, nl) {
            b0 = Multiply(bi0, 4)
            x = ArrayGet(lines, b0)
            y = ArrayGet(lines, Add(b0, 1))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            x = ArrayGet(lines, Add(b0, 2))
            y = ArrayGet(lines, Add(b0, 3))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            bi0 = Add(bi0, 1)
        }
        nc_bb = CAD_Store.Read(sketch_handle, 7)
        circs_bb = CAD_Store.Read(sketch_handle, 8)
        bi0 = 0
        WhileLoop LessThan(bi0, nc_bb) {
            b0 = Multiply(bi0, 3)
            cx = ArrayGet(circs_bb, b0)
            cy = ArrayGet(circs_bb, Add(b0, 1))
            rad = ArrayGet(circs_bb, Add(b0, 2))
            IfCondition EqualTo(Float_Le(Float_Sub(cx, rad), xmin), 1) ThenBlock: { xmin = Float_Sub(cx, rad) }
            IfCondition EqualTo(Float_Le(xmax, Float_Add(cx, rad)), 1) ThenBlock: { xmax = Float_Add(cx, rad) }
            IfCondition EqualTo(Float_Le(Float_Sub(cy, rad), ymin), 1) ThenBlock: { ymin = Float_Sub(cy, rad) }
            IfCondition EqualTo(Float_Le(ymax, Float_Add(cy, rad)), 1) ThenBlock: { ymax = Float_Add(cy, rad) }
            bi0 = Add(bi0, 1)
        }
        na_bb = CAD_Store.Read(sketch_handle, 10)
        arcs_bb = CAD_Store.Read(sketch_handle, 11)
        bi0 = 0
        WhileLoop LessThan(bi0, na_bb) {
            b0 = Multiply(bi0, 5)
            cx = ArrayGet(arcs_bb, b0)
            cy = ArrayGet(arcs_bb, Add(b0, 1))
            rad = ArrayGet(arcs_bb, Add(b0, 2))
            IfCondition EqualTo(Float_Le(Float_Sub(cx, rad), xmin), 1) ThenBlock: { xmin = Float_Sub(cx, rad) }
            IfCondition EqualTo(Float_Le(xmax, Float_Add(cx, rad)), 1) ThenBlock: { xmax = Float_Add(cx, rad) }
            IfCondition EqualTo(Float_Le(Float_Sub(cy, rad), ymin), 1) ThenBlock: { ymin = Float_Sub(cy, rad) }
            IfCondition EqualTo(Float_Le(ymax, Float_Add(cy, rad)), 1) ThenBlock: { ymax = Float_Add(cy, rad) }
            bi0 = Add(bi0, 1)
        }
        dxb = Float_Sub(xmax, xmin)
        dyb = Float_Sub(ymax, ymin)
        diag = CAD_Num.Sqrt(Float_Add(Float_Mul(dxb, dxb), Float_Mul(dyb, dyb)))
        mtol = Float_Mul(diag, 0x3F847AE147AE147B)
        floort = 0x3F50624DD2F1A9FC
        IfCondition EqualTo(Float_Le(mtol, floort), 1) ThenBlock: { mtol = floort }
        mtol2 = Float_Mul(mtol, mtol)
        // out: up to 4096 segs × 4 doubles
        out = Allocate(131072)
        on = 0
        // ts: up to 256 split params per segment (was 60 — long rects lost cuts)
        ts = Allocate(4096)
        nc = CAD_Store.Read(sketch_handle, 7)
        circs = CAD_Store.Read(sketch_handle, 8)
        na = CAD_Store.Read(sketch_handle, 10)
        arcs = CAD_Store.Read(sketch_handle, 11)
        two_pi = 0x401921FB54442D18
        i = 0
        WhileLoop LessThan(i, nl) {
            bi = Multiply(i, 4)
            ax0 = ArrayGet(lines, bi)
            ay0 = ArrayGet(lines, Add(bi, 1))
            ax1 = ArrayGet(lines, Add(bi, 2))
            ay1 = ArrayGet(lines, Add(bi, 3))
            adx = Float_Sub(ax1, ax0)
            ady = Float_Sub(ay1, ay0)
            alen2 = Float_Add(Float_Mul(adx, adx), Float_Mul(ady, ady))
            eps = 0x3F50624DD2F1A9FC
            ArraySet(ts, 0, 0)
            ArraySet(ts, 1, 0x3FF0000000000000)
            nt = 2
            // also split at every existing anchor that lies on this segment
            npt = CAD_Store.Read(sketch_handle, 16)
            pts = CAD_Store.Read(sketch_handle, 17)
            IfCondition NotEqual(pts, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(alen2, 0), 0) ThenBlock: {
                    pi = 0
                    WhileLoop LessThan(pi, npt) {
                        px = ArrayGet(pts, Multiply(pi, 2))
                        py = ArrayGet(pts, Add(Multiply(pi, 2), 1))
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(px, ax0), adx), Float_Mul(Float_Sub(py, ay0), ady)), alen2)
                        IfCondition EqualTo(Float_Le(t, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0x3FF0000000000000, t), 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                                qx = Float_Add(ax0, Float_Mul(t, adx))
                                qy = Float_Add(ay0, Float_Mul(t, ady))
                                ddx = Float_Sub(qx, px)
                                ddy = Float_Sub(qy, py)
                                IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                                    IfCondition LessThan(nt, 256) ThenBlock: {
                                        ArraySet(ts, nt, t)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                        }
                        pi = Add(pi, 1)
                    }
                }
            }
            j = 0
            WhileLoop LessThan(j, nl) {
                IfCondition NotEqual(j, i) ThenBlock: {
                    bj = Multiply(j, 4)
                    bx0 = ArrayGet(lines, bj)
                    by0 = ArrayGet(lines, Add(bj, 1))
                    bx1 = ArrayGet(lines, Add(bj, 2))
                    by1 = ArrayGet(lines, Add(bj, 3))
                    bdx = Float_Sub(bx1, bx0)
                    bdy = Float_Sub(by1, by0)
                    den = Float_Sub(Float_Mul(adx, bdy), Float_Mul(ady, bdx))
                    IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                        t = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), bdy), Float_Mul(Float_Sub(by0, ay0), bdx)), den)
                        u = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), ady), Float_Mul(Float_Sub(by0, ay0), adx)), den)
                        one = 0x3FF0000000000000
                        ok = 1
                        IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ok = 0 }
                        IfCondition EqualTo(Float_Le(Float_Sub(one, eps), t), 1) ThenBlock: { ok = 0 }
                        IfCondition EqualTo(Float_Le(u, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, u), eps), 0) ThenBlock: { ok = 0 }
                        }
                        IfCondition EqualTo(Float_Le(one, u), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(u, one), eps), 0) ThenBlock: { ok = 0 }
                        }
                        IfCondition EqualTo(ok, 1) ThenBlock: {
                            IfCondition LessThan(nt, 256) ThenBlock: {
                                ArraySet(ts, nt, t)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                    // T-junction: endpoints of j on interior of i (loose freehand)
                    IfCondition EqualTo(CAD_Num.IsZero(alen2, 0), 0) ThenBlock: {
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx0, ax0), adx), Float_Mul(Float_Sub(by0, ay0), ady)), alen2)
                        IfCondition EqualTo(Float_Le(t, eps), 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0x3FF0000000000000, t), eps), 0) ThenBlock: {
                                px = Float_Add(ax0, Float_Mul(t, adx))
                                py = Float_Add(ay0, Float_Mul(t, ady))
                                ddx = Float_Sub(px, bx0)
                                ddy = Float_Sub(py, by0)
                                IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                                    IfCondition LessThan(nt, 256) ThenBlock: {
                                        ArraySet(ts, nt, t)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                        }
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx1, ax0), adx), Float_Mul(Float_Sub(by1, ay0), ady)), alen2)
                        IfCondition EqualTo(Float_Le(t, eps), 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0x3FF0000000000000, t), eps), 0) ThenBlock: {
                                px = Float_Add(ax0, Float_Mul(t, adx))
                                py = Float_Add(ay0, Float_Mul(t, ady))
                                ddx = Float_Sub(px, bx1)
                                ddy = Float_Sub(py, by1)
                                IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                                    IfCondition LessThan(nt, 256) ThenBlock: {
                                        ArraySet(ts, nt, t)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                        }
                    }
                }
                j = Add(j, 1)
            }
            // line × full circle: EXACT quadratic, interior t ∈ (0,1)
            ci = 0
            WhileLoop LessThan(ci, nc) {
                cbase = Multiply(ci, 3)
                cx = ArrayGet(circs, cbase)
                cy = ArrayGet(circs, Add(cbase, 1))
                rad = ArrayGet(circs, Add(cbase, 2))
                fx = Float_Sub(ax0, cx)
                fy = Float_Sub(ay0, cy)
                aa = alen2
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, adx, ady))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, eps)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        one = 0x3FF0000000000000
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            ok = 1
                            IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Sub(one, eps), t)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                IfCondition LessThan(nt, 256) ThenBlock: {
                                    ArraySet(ts, nt, t)
                                    nt = Add(nt, 1)
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                ci = Add(ci, 1)
            }
            // line × arc: only if hit angle is on the open arc span
            // Float_Le(neg,0) broken — PosMod2Pi + IsNeg for t/disc
            ai = 0
            WhileLoop LessThan(ai, na) {
                abase = Multiply(ai, 5)
                cx = ArrayGet(arcs, abase)
                cy = ArrayGet(arcs, Add(abase, 1))
                rad = ArrayGet(arcs, Add(abase, 2))
                a0 = ArrayGet(arcs, Add(abase, 3))
                a1 = ArrayGet(arcs, Add(abase, 4))
                span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
                fx = Float_Sub(ax0, cx)
                fy = Float_Sub(ay0, cy)
                aa = alen2
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, adx, ady))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, eps)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            one = 0x3FF0000000000000
                            ok = 1
                            // reject t <= eps or t >= 1-eps (open interior hits for line split)
                            IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Sub(one, eps), t)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(ax0, Float_Mul(t, adx))
                                py = Float_Add(ay0, Float_Mul(t, ady))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                                IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                                    IfCondition LessThan(nt, 256) ThenBlock: {
                                        ArraySet(ts, nt, t)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                ai = Add(ai, 1)
            }
            // bubble sort ts ascending
            a = 0
            WhileLoop LessThan(a, nt) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nt) {
                    va = ArrayGet(ts, a)
                    vb = ArrayGet(ts, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(ts, a, vb)
                        ArraySet(ts, bb, va)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // emit unique consecutive pieces
            prev_t = ArrayGet(ts, 0)
            k = 1
            WhileLoop LessThan(k, nt) {
                t1 = ArrayGet(ts, k)
                // skip near-duplicate t
                dt = Float_Sub(t1, prev_t)
                IfCondition EqualTo(Float_Le(dt, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
                    // min length: skip degenerate
                    x0 = Float_Add(ax0, Float_Mul(prev_t, adx))
                    y0 = Float_Add(ay0, Float_Mul(prev_t, ady))
                    x1 = Float_Add(ax0, Float_Mul(t1, adx))
                    y1 = Float_Add(ay0, Float_Mul(t1, ady))
                    IfCondition LessThan(on, cap) ThenBlock: {
                        ob = Multiply(on, 4)
                        ArraySet(out, ob, x0)
                        ArraySet(out, Add(ob, 1), y0)
                        ArraySet(out, Add(ob, 2), x1)
                        ArraySet(out, Add(ob, 3), y1)
                        on = Add(on, 1)
                    }
                    prev_t = t1
                }
                k = Add(k, 1)
            }
            i = Add(i, 1)
        }
        // rewrite sketch lines
        IfCondition GreaterThan(on, 0) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, on) {
                b = Multiply(i, 4)
                ArraySet(lines, b, ArrayGet(out, b))
                ArraySet(lines, Add(b, 1), ArrayGet(out, Add(b, 1)))
                ArraySet(lines, Add(b, 2), ArrayGet(out, Add(b, 2)))
                ArraySet(lines, Add(b, 3), ArrayGet(out, Add(b, 3)))
                i = Add(i, 1)
            }
            CAD_Store.Write(sketch_handle, 0, on)
            CAD_Store.Write(sketch_handle, 2, 0)
            CAD_Store.Write(sketch_handle, 12, 0)
        }
        Deallocate(out, 131072)
        Deallocate(ts, 4096)
        ReturnValue(CAD_Store.Read(sketch_handle, 0))
    }
}

// Split ONE line at all crossings (other lines / circles / arcs / anchors).
// Used by interactive trim so each cut does not re-fragment the whole sketch.
// Returns new line count. line_i pieces: first overwrites line_i, rest AddLine.
Function.CAD_Sketch.SplitLineAtHits {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition LessThan(line_i, 0) ThenBlock: { ReturnValue(nl) }
        IfCondition GreaterEqual(line_i, nl) ThenBlock: { ReturnValue(nl) }
        lines = CAD_Store.Read(sketch_handle, 1)
        bi = Multiply(line_i, 4)
        ax0 = ArrayGet(lines, bi)
        ay0 = ArrayGet(lines, Add(bi, 1))
        ax1 = ArrayGet(lines, Add(bi, 2))
        ay1 = ArrayGet(lines, Add(bi, 3))
        adx = Float_Sub(ax1, ax0)
        ady = Float_Sub(ay1, ay0)
        alen2 = Float_Add(Float_Mul(adx, adx), Float_Mul(ady, ady))
        IfCondition EqualTo(CAD_Num.IsZero(alen2, 0), 1) ThenBlock: { ReturnValue(nl) }
        // AABB for mtol
        xmin = ax0
        ymin = ay0
        xmax = ax1
        ymax = ay1
        IfCondition EqualTo(Float_Le(ax1, ax0), 1) ThenBlock: { xmin = ax1 }
        IfCondition EqualTo(Float_Le(ax0, ax1), 1) ThenBlock: { xmax = ax1 }
        IfCondition EqualTo(Float_Le(ay1, ay0), 1) ThenBlock: { ymin = ay1 }
        IfCondition EqualTo(Float_Le(ay0, ay1), 1) ThenBlock: { ymax = ay1 }
        // expand by other geometry extent lightly via diag of whole sketch
        gi = 0
        WhileLoop LessThan(gi, nl) {
            gb = Multiply(gi, 4)
            x = ArrayGet(lines, gb)
            y = ArrayGet(lines, Add(gb, 1))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            x = ArrayGet(lines, Add(gb, 2))
            y = ArrayGet(lines, Add(gb, 3))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            gi = Add(gi, 1)
        }
        dxb = Float_Sub(xmax, xmin)
        dyb = Float_Sub(ymax, ymin)
        diag = CAD_Num.Sqrt(Float_Add(Float_Mul(dxb, dxb), Float_Mul(dyb, dyb)))
        mtol = Float_Mul(diag, 0x3F847AE147AE147B)
        floort = 0x3F50624DD2F1A9FC
        IfCondition EqualTo(Float_Le(mtol, floort), 1) ThenBlock: { mtol = floort }
        mtol2 = Float_Mul(mtol, mtol)
        eps = 0x3F50624DD2F1A9FC
        one = 0x3FF0000000000000
        two_pi = 0x401921FB54442D18
        ts = Allocate(4096)
        ArraySet(ts, 0, 0)
        ArraySet(ts, 1, one)
        nt = 2
        // other lines
        j = 0
        WhileLoop LessThan(j, nl) {
            IfCondition NotEqual(j, line_i) ThenBlock: {
                bj = Multiply(j, 4)
                bx0 = ArrayGet(lines, bj)
                by0 = ArrayGet(lines, Add(bj, 1))
                bx1 = ArrayGet(lines, Add(bj, 2))
                by1 = ArrayGet(lines, Add(bj, 3))
                bdx = Float_Sub(bx1, bx0)
                bdy = Float_Sub(by1, by0)
                den = Float_Sub(Float_Mul(adx, bdy), Float_Mul(ady, bdx))
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    t = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), bdy), Float_Mul(Float_Sub(by0, ay0), bdx)), den)
                    u = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), ady), Float_Mul(Float_Sub(by0, ay0), adx)), den)
                    ok = 1
                    IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(Float_Le(Float_Sub(one, eps), t), 1) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(Float_Le(u, 0), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(0, u), eps), 0) ThenBlock: { ok = 0 }
                    }
                    IfCondition EqualTo(Float_Le(one, u), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(u, one), eps), 0) ThenBlock: { ok = 0 }
                    }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        IfCondition LessThan(nt, 256) ThenBlock: {
                            ArraySet(ts, nt, t)
                            nt = Add(nt, 1)
                        }
                    }
                }
                // T: j endpoints on i
                t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx0, ax0), adx), Float_Mul(Float_Sub(by0, ay0), ady)), alen2)
                IfCondition EqualTo(Float_Le(t, eps), 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(one, t), eps), 0) ThenBlock: {
                        px = Float_Add(ax0, Float_Mul(t, adx))
                        py = Float_Add(ay0, Float_Mul(t, ady))
                        ddx = Float_Sub(px, bx0)
                        ddy = Float_Sub(py, by0)
                        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                            IfCondition LessThan(nt, 256) ThenBlock: {
                                ArraySet(ts, nt, t)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                }
                t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx1, ax0), adx), Float_Mul(Float_Sub(by1, ay0), ady)), alen2)
                IfCondition EqualTo(Float_Le(t, eps), 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(one, t), eps), 0) ThenBlock: {
                        px = Float_Add(ax0, Float_Mul(t, adx))
                        py = Float_Add(ay0, Float_Mul(t, ady))
                        ddx = Float_Sub(px, bx1)
                        ddy = Float_Sub(py, by1)
                        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                            IfCondition LessThan(nt, 256) ThenBlock: {
                                ArraySet(ts, nt, t)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                }
            }
            j = Add(j, 1)
        }
        // circles — EXACT quadratic isect, t ∈ (0,1)
        nc = CAD_Store.Read(sketch_handle, 7)
        circs = CAD_Store.Read(sketch_handle, 8)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            cbase = Multiply(ci, 3)
            cx = ArrayGet(circs, cbase)
            cy = ArrayGet(circs, Add(cbase, 1))
            rad = ArrayGet(circs, Add(cbase, 2))
            fx = Float_Sub(ax0, cx)
            fy = Float_Sub(ay0, cy)
            bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, adx, ady))
            cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
            disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, alen2), cc))
            IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(alen2, eps)), 1) ThenBlock: {
                    disc = 0
                }
            }
            IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                s = CAD_Num.Sqrt(disc)
                two_a = Float_Mul(0x4000000000000000, alen2)
                t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                hi = 0
                WhileLoop LessThan(hi, 2) {
                    t = t0
                    IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                    ok = 1
                    IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Sub(one, eps), t)), 1) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        IfCondition LessThan(nt, 256) ThenBlock: {
                            ArraySet(ts, nt, t)
                            nt = Add(nt, 1)
                        }
                    }
                    hi = Add(hi, 1)
                }
            }
            ci = Add(ci, 1)
        }
        // arcs — PosMod2Pi for span/dang (Float_Le(neg,0) broken)
        na = CAD_Store.Read(sketch_handle, 10)
        arcs = CAD_Store.Read(sketch_handle, 11)
        ai = 0
        WhileLoop LessThan(ai, na) {
            abase = Multiply(ai, 5)
            cx = ArrayGet(arcs, abase)
            cy = ArrayGet(arcs, Add(abase, 1))
            rad = ArrayGet(arcs, Add(abase, 2))
            a0 = ArrayGet(arcs, Add(abase, 3))
            a1 = ArrayGet(arcs, Add(abase, 4))
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            fx = Float_Sub(ax0, cx)
            fy = Float_Sub(ay0, cy)
            bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, adx, ady))
            cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
            disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, alen2), cc))
            IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(alen2, eps)), 1) ThenBlock: {
                    disc = 0
                }
            }
            IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                s = CAD_Num.Sqrt(disc)
                two_a = Float_Mul(0x4000000000000000, alen2)
                t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                hi = 0
                WhileLoop LessThan(hi, 2) {
                    t = t0
                    IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                    ok = 1
                    IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Sub(one, eps), t)), 1) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        px = Float_Add(ax0, Float_Mul(t, adx))
                        py = Float_Add(ay0, Float_Mul(t, ady))
                        ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                        dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                        IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                            IfCondition LessThan(nt, 256) ThenBlock: {
                                ArraySet(ts, nt, t)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                    hi = Add(hi, 1)
                }
            }
            ai = Add(ai, 1)
        }
        // sort t
        a = 0
        WhileLoop LessThan(a, nt) {
            bb = Add(a, 1)
            WhileLoop LessThan(bb, nt) {
                va = ArrayGet(ts, a)
                vb = ArrayGet(ts, bb)
                IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                    ArraySet(ts, a, vb)
                    ArraySet(ts, bb, va)
                }
                bb = Add(bb, 1)
            }
            a = Add(a, 1)
        }
        // emit pieces: first → SetLine(line_i), rest → AddLine
        prev_t = ArrayGet(ts, 0)
        npiece = 0
        k = 1
        WhileLoop LessThan(k, nt) {
            t1 = ArrayGet(ts, k)
            dt = Float_Sub(t1, prev_t)
            IfCondition EqualTo(Float_Le(dt, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
                x0 = Float_Add(ax0, Float_Mul(prev_t, adx))
                y0 = Float_Add(ay0, Float_Mul(prev_t, ady))
                x1 = Float_Add(ax0, Float_Mul(t1, adx))
                y1 = Float_Add(ay0, Float_Mul(t1, ady))
                IfCondition EqualTo(npiece, 0) ThenBlock: {
                    CAD_Sketch.SetLine(sketch_handle, line_i, x0, y0, x1, y1)
                }
                IfCondition GreaterThan(npiece, 0) ThenBlock: {
                    CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
                }
                npiece = Add(npiece, 1)
                prev_t = t1
            }
            k = Add(k, 1)
        }
        Deallocate(ts, 4096)
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        ReturnValue(CAD_Store.Read(sketch_handle, 0))
    }
}

// Remove TRUE overshoot stubs only (after SplitAtIntersections).
// A stub = free tip (valence 0) AND multi-way joint at the other end (valence ≥ 2).
//
// IMPORTANT (noclosedprofile): do NOT kill pure freehand chains where both tips
// are free / chain-connected (val 0–1). Those are almost-closed loops with a
// small gap — face-walk must still see them. Old code deleted any free tip and
// ate the entire open ring before Profiles could close it.
// join_tol_r = 0 → auto ~1% of sketch diagonal.
Function.CAD_Sketch.PruneOpenStubs {
    Input: sketch_handle: Integer
    Input: join_tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        pass = 0
        WhileLoop LessThan(pass, 128) {
            nl = CAD_Store.Read(sketch_handle, 0)
            IfCondition LessThan(nl, 1) ThenBlock: { ReturnValue(0) }
            lines = CAD_Store.Read(sketch_handle, 1)
            jtol = join_tol_r
            IfCondition EqualTo(jtol, 0) ThenBlock: {
                xmin = ArrayGet(lines, 0)
                ymin = ArrayGet(lines, 1)
                xmax = xmin
                ymax = ymin
                bi = 0
                WhileLoop LessThan(bi, nl) {
                    b = Multiply(bi, 4)
                    x = ArrayGet(lines, b)
                    y = ArrayGet(lines, Add(b, 1))
                    IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
                    IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
                    IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
                    IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
                    x = ArrayGet(lines, Add(b, 2))
                    y = ArrayGet(lines, Add(b, 3))
                    IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
                    IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
                    IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
                    IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
                    bi = Add(bi, 1)
                }
                dxb = Float_Sub(xmax, xmin)
                dyb = Float_Sub(ymax, ymin)
                diag = CAD_Num.Sqrt(Float_Add(Float_Mul(dxb, dxb), Float_Mul(dyb, dyb)))
                // 1% diag — freehand overshoots still join at split verts
                jtol = Float_Mul(diag, 0x3F847AE147AE147B)
                floort = 0x3F1A36E2EB1C432D
                IfCondition EqualTo(Float_Le(jtol, floort), 1) ThenBlock: { jtol = floort }
            }
            jtol2 = Float_Mul(jtol, jtol)
            val = Allocate(2048)
            i = 0
            WhileLoop LessThan(i, nl) {
                bi = Multiply(i, 4)
                ax = ArrayGet(lines, bi)
                ay = ArrayGet(lines, Add(bi, 1))
                bx = ArrayGet(lines, Add(bi, 2))
                by = ArrayGet(lines, Add(bi, 3))
                va = 0
                vb = 0
                j = 0
                WhileLoop LessThan(j, nl) {
                    IfCondition NotEqual(j, i) ThenBlock: {
                        bj = Multiply(j, 4)
                        jx0 = ArrayGet(lines, bj)
                        jy0 = ArrayGet(lines, Add(bj, 1))
                        jx1 = ArrayGet(lines, Add(bj, 2))
                        jy1 = ArrayGet(lines, Add(bj, 3))
                        ddx = Float_Sub(ax, jx0)
                        ddy = Float_Sub(ay, jy0)
                        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), jtol2), 1) ThenBlock: {
                            va = Add(va, 1)
                        }
                        ddx = Float_Sub(ax, jx1)
                        ddy = Float_Sub(ay, jy1)
                        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), jtol2), 1) ThenBlock: {
                            va = Add(va, 1)
                        }
                        ddx = Float_Sub(bx, jx0)
                        ddy = Float_Sub(by, jy0)
                        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), jtol2), 1) ThenBlock: {
                            vb = Add(vb, 1)
                        }
                        ddx = Float_Sub(bx, jx1)
                        ddy = Float_Sub(by, jy1)
                        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), jtol2), 1) ThenBlock: {
                            vb = Add(vb, 1)
                        }
                    }
                    j = Add(j, 1)
                }
                ArraySet(val, Multiply(i, 2), va)
                ArraySet(val, Add(Multiply(i, 2), 1), vb)
                i = Add(i, 1)
            }
            // mark ONLY true overshoot stubs + zero-length debris
            killf = Allocate(2048)
            nk = 0
            i = 0
            WhileLoop LessThan(i, nl) {
                ArraySet(killf, i, 0)
                va = ArrayGet(val, Multiply(i, 2))
                vb = ArrayGet(val, Add(Multiply(i, 2), 1))
                bi = Multiply(i, 4)
                dx = Float_Sub(ArrayGet(lines, Add(bi, 2)), ArrayGet(lines, bi))
                dy = Float_Sub(ArrayGet(lines, Add(bi, 3)), ArrayGet(lines, Add(bi, 1)))
                len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                // true stub: free tip + multi-joint other end (T/X after split)
                IfCondition EqualTo(va, 0) ThenBlock: {
                    IfCondition GreaterEqual(vb, 2) ThenBlock: {
                        ArraySet(killf, i, 1)
                        nk = Add(nk, 1)
                    }
                }
                IfCondition EqualTo(vb, 0) ThenBlock: {
                    IfCondition GreaterEqual(va, 2) ThenBlock: {
                        ArraySet(killf, i, 1)
                        nk = Add(nk, 1)
                    }
                }
                // tiny debris
                IfCondition EqualTo(Float_Le(len2, 0x3E7AD7F29ABCAF48), 1) ThenBlock: {
                    ArraySet(killf, i, 1)
                    nk = Add(nk, 1)
                }
                i = Add(i, 1)
            }
            Deallocate(val, 2048)
            IfCondition EqualTo(nk, 0) ThenBlock: {
                Deallocate(killf, 2048)
                pass = 128
            }
            IfCondition GreaterThan(nk, 0) ThenBlock: {
                // delete high indices first so lower indices stay valid
                i = Subtract(nl, 1)
                WhileLoop GreaterEqual(i, 0) {
                    IfCondition EqualTo(ArrayGet(killf, i), 1) ThenBlock: {
                        CAD_Sketch.DeleteLine(sketch_handle, i)
                    }
                    i = Subtract(i, 1)
                }
                Deallocate(killf, 2048)
            }
            pass = Add(pass, 1)
        }
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        ReturnValue(CAD_Store.Read(sketch_handle, 0))
    }
}

Function.CAD_Sketch.AddRectangle {
    Input: sketch_handle: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: width_r: Integer
    Input: height_r: Integer
    Output: Integer
    Body: {
        x2_r = Float_Add(x1_r, width_r)
        y2_r = Float_Add(y1_r, height_r)
        CAD_Sketch.AddLine(sketch_handle, x1_r, y1_r, x2_r, y1_r)
        CAD_Sketch.AddLine(sketch_handle, x2_r, y1_r, x2_r, y2_r)
        CAD_Sketch.AddLine(sketch_handle, x2_r, y2_r, x1_r, y2_r)
        CAD_Sketch.AddLine(sketch_handle, x1_r, y2_r, x1_r, y1_r)
        ReturnValue(CAD_Sketch.BuildClosedLoop(sketch_handle))
    }
}

Function.CAD_Sketch.AddSquare {
    Input: sketch_handle: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: side_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.AddRectangle(sketch_handle, x1_r, y1_r, side_r, side_r))
    }
}

// Polyline through pts (xy pairs). closed=1 connects last→first.
Function.CAD_Sketch.AddPolyline {
    Input: sketch_handle: Integer
    Input: pts_arr_addr: Address
    Input: n_pts: Integer
    Input: closed: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(n_pts, 2) ThenBlock: { ReturnValue(-2) }
        i = 0
        WhileLoop LessThan(i, Subtract(n_pts, 1)) {
            x0 = ArrayGet(pts_arr_addr, Multiply(i, 2))
            y0 = ArrayGet(pts_arr_addr, Add(Multiply(i, 2), 1))
            x1 = ArrayGet(pts_arr_addr, Multiply(Add(i, 1), 2))
            y1 = ArrayGet(pts_arr_addr, Add(Multiply(Add(i, 1), 2), 1))
            CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
            i = Add(i, 1)
        }
        IfCondition EqualTo(closed, 1) ThenBlock: {
            x0 = ArrayGet(pts_arr_addr, Multiply(Subtract(n_pts, 1), 2))
            y0 = ArrayGet(pts_arr_addr, Add(Multiply(Subtract(n_pts, 1), 2), 1))
            x1 = ArrayGet(pts_arr_addr, 0)
            y1 = ArrayGet(pts_arr_addr, 1)
            CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
        }
        ReturnValue(0)
    }
}

// DXF bulge on segment p0→p1: bulge = tan(included/4). |b|≈0 → line; else arc.
// pack: [x0,y0,x1,y1,bulge]
Function.CAD_Sketch.AddBulgeSegment {
    Input: sketch_handle: Integer
    Input: pack_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        x0 = ArrayGet(pack_addr, 0)
        y0 = ArrayGet(pack_addr, 1)
        x1 = ArrayGet(pack_addr, 2)
        y1 = ArrayGet(pack_addr, 3)
        b = ArrayGet(pack_addr, 4)
        ab = b
        IfCondition EqualTo(Float_Le(ab, 0), 1) ThenBlock: { ab = Float_Sub(0, ab) }
        // |bulge| < 1e-9 → line
        IfCondition EqualTo(Float_Le(ab, 0x3E112E0BE826D695), 1) ThenBlock: {
            ReturnValue(CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1))
        }
        // θ = 4 atan(b)  (signed)
        ang = Float_Mul(CAD_Geom.Atan(b), 0x4010000000000000)
        aabs = ang
        IfCondition EqualTo(Float_Le(aabs, 0), 1) ThenBlock: { aabs = Float_Sub(0, aabs) }
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        chord = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(chord, 0), 1) ThenBlock: { ReturnValue(-4) }
        half = 0x4000000000000000
        // r = (chord/2) / sin(|θ|/2)
        half_a = Float_Div(aabs, half)
        s = CAD_Geom.Sin(half_a)
        IfCondition EqualTo(CAD_Num.IsZero(s, 0), 1) ThenBlock: {
            ReturnValue(CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1))
        }
        r = Float_Div(Float_Div(chord, half), s)
        // mid
        mx = Float_Div(Float_Add(x0, x1), half)
        my = Float_Div(Float_Add(y0, y1), half)
        // unit chord
        ux = Float_Div(dx, chord)
        uy = Float_Div(dy, chord)
        // left perp (-uy, ux)
        px = Float_Sub(0, uy)
        py = ux
        // dist mid→center = r cos(|θ|/2)
        c = CAD_Geom.Cos(half_a)
        d = Float_Mul(r, c)
        // bulge>0: center on left of directed chord
        IfCondition EqualTo(Float_Le(b, 0), 1) ThenBlock: {
            d = Float_Sub(0, d)
        }
        cx = Float_Add(mx, Float_Mul(px, d))
        cy = Float_Add(my, Float_Mul(py, d))
        a0 = CAD_Geom.Atan2(Float_Sub(y0, cy), Float_Sub(x0, cx))
        a1 = CAD_Geom.Atan2(Float_Sub(y1, cy), Float_Sub(x1, cx))
        // Ensure CCW span matches bulge sign
        two_pi = 0x401921FB54442D18
        IfCondition EqualTo(Float_Le(0, b), 1) ThenBlock: {
            // CCW: a1 should be CCW from a0
            span = Float_Sub(a1, a0)
            IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                a1 = Float_Add(a1, two_pi)
            }
        }
        IfCondition EqualTo(Float_Le(b, 0), 1) ThenBlock: {
            // CW arc: store as CCW from a1 to a0 by swapping? AddArc is CCW a0→a1
            // For CW bulge, go a0 CW to a1 = CCW a1 to a0+2π
            // Use a0' = a1, a1' = a0; if a1'<=a0' add 2π to a1'
            ta = a0
            a0 = a1
            a1 = ta
            span = Float_Sub(a1, a0)
            IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                a1 = Float_Add(a1, two_pi)
            }
        }
        ReturnValue(CAD_Sketch.AddArc(sketch_handle, cx, cy, r, a0, a1))
    }
}

Function.CAD_Sketch.GetProfileCount {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(sketch_handle, 12))
    }
}

// Signed area of primary loop (or profile 0). 0 if empty.
Function.CAD_Sketch.LoopSignedArea {
    Input: xy_addr: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        area = 0
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            xi = ArrayGet(xy_addr, Multiply(i, 2))
            yi = ArrayGet(xy_addr, Add(Multiply(i, 2), 1))
            xj = ArrayGet(xy_addr, Multiply(j, 2))
            yj = ArrayGet(xy_addr, Add(Multiply(j, 2), 1))
            area = Float_Add(area, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
            i = Add(i, 1)
        }
        ReturnValue(Float_Div(area, 0x4000000000000000))
    }
}

// Snap any two line endpoints that lie within tol onto their midpoint.
// Closes freehand gaps between arc tessellation ends and nearby chords.
// Returns number of snaps performed.
// Snap dangling (valence-1) line endpoints onto the nearest other endpoint
// within tol. Closes freehand gaps between arc tess ends and chords WITHOUT
// collapsing dense tessellation vertices (those have valence ≥ 1 each side).
//
// CRITICAL (geometeryfail): never weld across open air using full sketch
// diagonal alone — that invented long "phantom" edges Profiles filled red.
// Cap snap by min(global_tol, 20% of this segment length).
// tol_r=0 → auto ~0.35% of diagonal (floor 1e-4). Only dangling ends.
Function.CAD_Sketch.SnapNearEndpoints {
    Input: sketch_handle: Integer
    Input: tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition LessThan(nl, 1) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(sketch_handle, 1)
        tol = tol_r
        IfCondition EqualTo(tol, 0) ThenBlock: {
            xmin = ArrayGet(lines, 0)
            ymin = ArrayGet(lines, 1)
            xmax = xmin
            ymax = ymin
            bi = 0
            WhileLoop LessThan(bi, nl) {
                b = Multiply(bi, 4)
                x = ArrayGet(lines, b)
                y = ArrayGet(lines, Add(b, 1))
                IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
                IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
                IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
                IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
                x = ArrayGet(lines, Add(b, 2))
                y = ArrayGet(lines, Add(b, 3))
                IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
                IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
                IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
                IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
                bi = Add(bi, 1)
            }
            dxb = Float_Sub(xmax, xmin)
            dyb = Float_Sub(ymax, ymin)
            diag = CAD_Num.Sqrt(Float_Add(Float_Mul(dxb, dxb), Float_Mul(dyb, dyb)))
            // 0.75% of diagonal freehand (was 0.35% + min-edge cap which blocked
            // Arc3/V tip joins while dense tess was present — upper band only).
            // Still only snaps dangling ends (val==0); dense mid-chain stays put.
            tol = Float_Mul(diag, 0x3F86A7EF9DB22D0E)
            // Floor 0.05 — Cos/Sin vs freehand near-miss
            floort = 0x3FA999999999999A
            IfCondition EqualTo(Float_Le(tol, floort), 1) ThenBlock: { tol = floort }
            // Absolute ceiling 2.0 so huge sketches do not phantom-weld
            ceil_t = 0x4000000000000000
            IfCondition EqualTo(Float_Le(ceil_t, tol), 1) ThenBlock: { tol = ceil_t }
        }
        tol2 = Float_Mul(tol, tol)
        // valence of each endpoint
        npts = Multiply(nl, 2)
        val = Allocate(2048)
        i = 0
        WhileLoop LessThan(i, npts) {
            ArraySet(val, i, 0)
            i = Add(i, 1)
        }
        // meet radius for "already joined" — tighter than snap
        meet2 = Float_Mul(tol2, 0x3F847AE147AE147B)
        i = 0
        WhileLoop LessThan(i, npts) {
            li = Divide(i, 2)
            ei = Subtract(i, Multiply(li, 2))
            bi = Multiply(li, 4)
            IfCondition EqualTo(ei, 0) ThenBlock: {
                ix = ArrayGet(lines, bi)
                iy = ArrayGet(lines, Add(bi, 1))
            }
            IfCondition EqualTo(ei, 1) ThenBlock: {
                ix = ArrayGet(lines, Add(bi, 2))
                iy = ArrayGet(lines, Add(bi, 3))
            }
            j = 0
            WhileLoop LessThan(j, npts) {
                IfCondition NotEqual(j, i) ThenBlock: {
                    lj = Divide(j, 2)
                    ej = Subtract(j, Multiply(lj, 2))
                    bj = Multiply(lj, 4)
                    IfCondition EqualTo(ej, 0) ThenBlock: {
                        jx = ArrayGet(lines, bj)
                        jy = ArrayGet(lines, Add(bj, 1))
                    }
                    IfCondition EqualTo(ej, 1) ThenBlock: {
                        jx = ArrayGet(lines, Add(bj, 2))
                        jy = ArrayGet(lines, Add(bj, 3))
                    }
                    ddx = Float_Sub(ix, jx)
                    ddy = Float_Sub(iy, jy)
                    d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                    IfCondition EqualTo(Float_Le(d2, meet2), 1) ThenBlock: {
                        ArraySet(val, i, Add(ArrayGet(val, i), 1))
                    }
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        nsnap = 0
        // only snap dangling endpoints (val==0 means no neighbor at meet tol)
        i = 0
        WhileLoop LessThan(i, npts) {
            IfCondition EqualTo(ArrayGet(val, i), 0) ThenBlock: {
                li = Divide(i, 2)
                ei = Subtract(i, Multiply(li, 2))
                bi = Multiply(li, 4)
                ax0 = ArrayGet(lines, bi)
                ay0 = ArrayGet(lines, Add(bi, 1))
                ax1 = ArrayGet(lines, Add(bi, 2))
                ay1 = ArrayGet(lines, Add(bi, 3))
                IfCondition EqualTo(ei, 0) ThenBlock: {
                    ix = ax0
                    iy = ay0
                }
                IfCondition EqualTo(ei, 1) ThenBlock: {
                    ix = ax1
                    iy = ay1
                }
                // own segment length — snap distance must stay << this
                slen = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(ax1, ax0), Float_Sub(ax1, ax0)), Float_Mul(Float_Sub(ay1, ay0), Float_Sub(ay1, ay0))))
                // max snap = min(global tol, 50% of segment length)
                // blocks open-air long welds; still closes freehand near-miss tips
                // 0.5 = 0x3FE0000000000000
                seglim = Float_Mul(slen, 0x3FE0000000000000)
                lim = tol
                IfCondition EqualTo(Float_Le(seglim, tol), 1) ThenBlock: { lim = seglim }
                // tiny segs: still allow a floor so arc/line near-miss can join
                limfloor = 0x3F1A36E2EB1C432D
                IfCondition EqualTo(Float_Le(lim, limfloor), 1) ThenBlock: { lim = limfloor }
                lim2 = Float_Mul(lim, lim)
                best_j = -1
                best_d2 = lim2
                // prefer other dangling tip (freehand end-to-end) over mid-joint
                best_dang = 0
                j = 0
                WhileLoop LessThan(j, npts) {
                    IfCondition NotEqual(j, i) ThenBlock: {
                        lj = Divide(j, 2)
                        // do not snap the other end of the same segment
                        IfCondition NotEqual(lj, li) ThenBlock: {
                            ej = Subtract(j, Multiply(lj, 2))
                            bj = Multiply(lj, 4)
                            IfCondition EqualTo(ej, 0) ThenBlock: {
                                jx = ArrayGet(lines, bj)
                                jy = ArrayGet(lines, Add(bj, 1))
                            }
                            IfCondition EqualTo(ej, 1) ThenBlock: {
                                jx = ArrayGet(lines, Add(bj, 2))
                                jy = ArrayGet(lines, Add(bj, 3))
                            }
                            ddx = Float_Sub(ix, jx)
                            ddy = Float_Sub(iy, jy)
                            d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                            IfCondition EqualTo(Float_Le(d2, lim2), 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.IsZero(d2, 0), 0) ThenBlock: {
                                    jdang = 0
                                    IfCondition EqualTo(ArrayGet(val, j), 0) ThenBlock: { jdang = 1 }
                                    take = 0
                                    IfCondition EqualTo(best_j, -1) ThenBlock: { take = 1 }
                                    // prefer dangling partner
                                    IfCondition EqualTo(jdang, 1) ThenBlock: {
                                        IfCondition EqualTo(best_dang, 0) ThenBlock: { take = 1 }
                                        IfCondition EqualTo(best_dang, 1) ThenBlock: {
                                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: { take = 1 }
                                        }
                                    }
                                    IfCondition EqualTo(jdang, 0) ThenBlock: {
                                        IfCondition EqualTo(best_dang, 0) ThenBlock: {
                                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: { take = 1 }
                                        }
                                    }
                                    IfCondition EqualTo(take, 1) ThenBlock: {
                                        best_d2 = d2
                                        best_j = j
                                        best_dang = jdang
                                    }
                                }
                            }
                        }
                    }
                    j = Add(j, 1)
                }
                IfCondition NotEqual(best_j, -1) ThenBlock: {
                    lj = Divide(best_j, 2)
                    ej = Subtract(best_j, Multiply(lj, 2))
                    bj = Multiply(lj, 4)
                    IfCondition EqualTo(ej, 0) ThenBlock: {
                        tx = ArrayGet(lines, bj)
                        ty = ArrayGet(lines, Add(bj, 1))
                    }
                    IfCondition EqualTo(ej, 1) ThenBlock: {
                        tx = ArrayGet(lines, Add(bj, 2))
                        ty = ArrayGet(lines, Add(bj, 3))
                    }
                    // free→joint: snap free onto joint. free→free: midpoint (fair)
                    IfCondition EqualTo(best_dang, 1) ThenBlock: {
                        tx = Float_Mul(0x3FE0000000000000, Float_Add(ix, tx))
                        ty = Float_Mul(0x3FE0000000000000, Float_Add(iy, ty))
                        // also pull partner tip to midpoint
                        IfCondition EqualTo(ej, 0) ThenBlock: {
                            ArraySet(lines, bj, tx)
                            ArraySet(lines, Add(bj, 1), ty)
                        }
                        IfCondition EqualTo(ej, 1) ThenBlock: {
                            ArraySet(lines, Add(bj, 2), tx)
                            ArraySet(lines, Add(bj, 3), ty)
                        }
                        ArraySet(val, best_j, 1)
                    }
                    IfCondition EqualTo(ei, 0) ThenBlock: {
                        ArraySet(lines, bi, tx)
                        ArraySet(lines, Add(bi, 1), ty)
                    }
                    IfCondition EqualTo(ei, 1) ThenBlock: {
                        ArraySet(lines, Add(bi, 2), tx)
                        ArraySet(lines, Add(bi, 3), ty)
                    }
                    ArraySet(val, i, 1)
                    nsnap = Add(nsnap, 1)
                }
            }
            i = Add(i, 1)
        }
        Deallocate(val, 2048)
        ReturnValue(nsnap)
    }
}

// Build every closed face in the planar line graph.
// Uses directed half-edges (each segment used once per direction) and
// "next CCW from reverse" turns so shared chords (circle×diameters) yield
// multiple faces — not a single greedy Euler path.
Function.CAD_Sketch.BuildAllClosedLoops {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        // lower ALL curves into the line graph (arcs and full circles)
        na = CAD_Store.Read(sketch_handle, 10)
        IfCondition GreaterThan(na, 0) ThenBlock: {
            CAD_Sketch.TessellateArcs(sketch_handle, 32)
        }
        nc = CAD_Store.Read(sketch_handle, 7)
        IfCondition GreaterThan(nc, 0) ThenBlock: {
            CAD_Sketch.TessellateCircles(sketch_handle, 32)
            CAD_Store.Write(sketch_handle, 7, 0)
        }
        // weld freehand / arc-end near-misses so prune does not eat the rim
        CAD_Sketch.SnapNearEndpoints(sketch_handle, 0)
        // split at crossings, drop dangling stubs
        CAD_Sketch.SplitAtIntersections(sketch_handle)
        CAD_Sketch.SnapNearEndpoints(sketch_handle, 0)
        CAD_Sketch.PruneOpenStubs(sketch_handle, 0)
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition LessThan(nl, 3) ThenBlock: {
            CAD_Store.Write(sketch_handle, 12, 0)
            ReturnValue(0)
        }
        lines = CAD_Store.Read(sketch_handle, 1)
        pool = CAD_Store.Read(sketch_handle, 14)
        pmeta = CAD_Store.Read(sketch_handle, 13)
        cap_p = CAD_Store.Read(sketch_handle, 15)
        // join tol from sketch size
        xmin = ArrayGet(lines, 0)
        ymin = ArrayGet(lines, 1)
        xmax = xmin
        ymax = ymin
        bi = 0
        WhileLoop LessThan(bi, nl) {
            b = Multiply(bi, 4)
            x = ArrayGet(lines, b)
            y = ArrayGet(lines, Add(b, 1))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            x = ArrayGet(lines, Add(b, 2))
            y = ArrayGet(lines, Add(b, 3))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            bi = Add(bi, 1)
        }
        dxb = Float_Sub(xmax, xmin)
        dyb = Float_Sub(ymax, ymin)
        diag = CAD_Num.Sqrt(Float_Add(Float_Mul(dxb, dxb), Float_Mul(dyb, dyb)))
        // Dual join tol (profilefail1: single min-edge cap closed upper band only):
        //   tight  — prefer true tess junctions (0.35*min_edge, floor 0.01)
        //   free   — freehand / Arc3 tip near-miss (0.75% diag, floor 0.05)
        // Walk prefers tight candidates; freehand only if none in tight range.
        floort = 0x3F847AE147AE147B
        floor_free = 0x3FA999999999999A
        join_free = Float_Mul(diag, 0x3F86A7EF9DB22D0E)
        IfCondition EqualTo(Float_Le(join_free, floor_free), 1) ThenBlock: { join_free = floor_free }
        mel = 0
        bi = 0
        WhileLoop LessThan(bi, nl) {
            b = Multiply(bi, 4)
            edx = Float_Sub(ArrayGet(lines, Add(b, 2)), ArrayGet(lines, b))
            edy = Float_Sub(ArrayGet(lines, Add(b, 3)), ArrayGet(lines, Add(b, 1)))
            el = CAD_Num.Sqrt(Float_Add(Float_Mul(edx, edx), Float_Mul(edy, edy)))
            IfCondition EqualTo(Float_Le(el, floort), 0) ThenBlock: {
                IfCondition EqualTo(mel, 0) ThenBlock: { mel = el }
                IfCondition EqualTo(Float_Le(el, mel), 1) ThenBlock: { mel = el }
            }
            bi = Add(bi, 1)
        }
        join_tight = floort
        IfCondition EqualTo(Float_Le(mel, 0), 0) ThenBlock: {
            join_tight = Float_Mul(mel, 0x3FD6666666666666)
            IfCondition EqualTo(Float_Le(join_tight, floort), 1) ThenBlock: { join_tight = floort }
        }
        // tight must not exceed free
        IfCondition EqualTo(Float_Le(join_free, join_tight), 1) ThenBlock: { join_tight = join_free }
        join_tol = join_free
        join_tol2 = Float_Mul(join_free, join_free)
        join_tight2 = Float_Mul(join_tight, join_tight)
        two_pi = 0x401921FB54442D18
        // half-edge use flags: index 2*e+d (d=0 A→B, d=1 B→A)
        // sized for 4096 lines * 2 = 8192 flags
        used = Allocate(65536)
        ui = 0
        WhileLoop LessThan(ui, Multiply(nl, 2)) {
            ArraySet(used, ui, 0)
            ui = Add(ui, 1)
        }
        nprof = 0
        pool_n = 0
        tloop = Allocate(32768)
        was_cw = Allocate(512)
        start_he = 0
        WhileLoop LessThan(start_he, Multiply(nl, 2)) {
            IfCondition EqualTo(ArrayGet(used, start_he), 0) ThenBlock: {
                se = Divide(start_he, 2)
                sd = Subtract(start_he, Multiply(se, 2))
                base = Multiply(se, 4)
                IfCondition EqualTo(sd, 0) ThenBlock: {
                    sx = ArrayGet(lines, base)
                    sy = ArrayGet(lines, Add(base, 1))
                    tipx = ArrayGet(lines, Add(base, 2))
                    tipy = ArrayGet(lines, Add(base, 3))
                }
                IfCondition EqualTo(sd, 1) ThenBlock: {
                    sx = ArrayGet(lines, Add(base, 2))
                    sy = ArrayGet(lines, Add(base, 3))
                    tipx = ArrayGet(lines, base)
                    tipy = ArrayGet(lines, Add(base, 1))
                }
                // temporary mark; rollback if face not saved
                ArraySet(used, start_he, 1)
                ArraySet(tloop, 0, sx)
                ArraySet(tloop, 1, sy)
                ArraySet(tloop, 2, tipx)
                ArraySet(tloop, 3, tipy)
                // path half-edge ids — dense multi-circle faces need >> 256
                path_he = Allocate(16384)
                ArraySet(path_he, 0, start_he)
                nhe = 1
                nn = 2
                prevx = sx
                prevy = sy
                // path length of edges walked (reject "close" if gap is large vs path)
                plen = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(tipx, sx), Float_Sub(tipx, sx)), Float_Mul(Float_Sub(tipy, sy), Float_Sub(tipy, sy))))
                closed = 0
                guard = 0
                // Freehand close gate: 2.5% of diag (candidate only).
                // Real filter is path-relative: gap << path so open-C cannot seal
                // across open air, but almost-closed rings work (noclosedprofile).
                // 0x3F9999999999999A ≈ 0.025
                close_gate = Float_Mul(diag, 0x3F9999999999999A)
                IfCondition EqualTo(Float_Le(close_gate, floort), 1) ThenBlock: { close_gate = floort }
                close_gate2 = Float_Mul(close_gate, close_gate)
                WhileLoop LessThan(guard, 4096) {
                    guard = Add(guard, 1)
                    // closed when tip returns to start: need ≥4 verts (3 real edges)
                    ddx = Float_Sub(tipx, sx)
                    ddy = Float_Sub(tipy, sy)
                    d2c = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                    IfCondition GreaterEqual(nn, 4) ThenBlock: {
                        IfCondition EqualTo(Float_Le(d2c, close_gate2), 1) ThenBlock: {
                            gap = CAD_Num.Sqrt(d2c)
                            okclose = 0
                            // gap < 2% of path length
                            IfCondition EqualTo(Float_Le(Float_Mul(0x3FA47AE147AE147B, plen), gap), 0) ThenBlock: {
                                // path must be >> gap (not a tiny digon)
                                IfCondition EqualTo(Float_Le(plen, Float_Mul(gap, 0x4034000000000000)), 0) ThenBlock: {
                                    // at least 4 real steps worth of geometry
                                    IfCondition EqualTo(Float_Le(plen, Float_Mul(close_gate, 0x4010000000000000)), 0) ThenBlock: {
                                        okclose = 1
                                    }
                                }
                            }
                            IfCondition EqualTo(okclose, 1) ThenBlock: {
                                ArraySet(tloop, Multiply(Subtract(nn, 1), 2), sx)
                                ArraySet(tloop, Add(Multiply(Subtract(nn, 1), 2), 1), sy)
                                nn = Subtract(nn, 1)
                                closed = 1
                                guard = 99999
                            }
                        }
                    }
                    IfCondition EqualTo(closed, 0) ThenBlock: {
                        IfCondition LessThan(guard, 4096) ThenBlock: {
                            // arrival heading into tip
                            idx = Float_Sub(tipx, prevx)
                            idy = Float_Sub(tipy, prevy)
                            // reverse leave angle (back along arrival)
                            rev_ang = CAD_Geom.Atan2(Float_Sub(0, idy), Float_Sub(0, idx))
                            found_ok = 0
                            found = 0
                            rev = 0
                            // best CCW turn; reverse (δ≈0) is fallback only
                            // tight pass first (tess junctions), freehand pass if none
                            best_delta = two_pi
                            best_d2 = join_tol2
                            fb_ok = 0
                            fb_found = 0
                            fb_rev = 0
                            tight_ok = 0
                            tight_found = 0
                            tight_rev = 0
                            tight_delta = two_pi
                            epsd = 0x3F50624DD2F1A9FC
                            j = 0
                            WhileLoop LessThan(j, nl) {
                                base = Multiply(j, 4)
                                ax = ArrayGet(lines, base)
                                ay = ArrayGet(lines, Add(base, 1))
                                bx = ArrayGet(lines, Add(base, 2))
                                by = ArrayGet(lines, Add(base, 3))
                                // end A at tip → leave toward B (dir 0)
                                ddx = Float_Sub(ax, tipx)
                                ddy = Float_Sub(ay, tipy)
                                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                                IfCondition EqualTo(Float_Le(d2, join_tol2), 1) ThenBlock: {
                                    he = Multiply(j, 2)
                                    IfCondition EqualTo(ArrayGet(used, he), 0) ThenBlock: {
                                        ox = Float_Sub(bx, tipx)
                                        oy = Float_Sub(by, tipy)
                                        oang = CAD_Geom.Atan2(oy, ox)
                                        delta = Float_Sub(oang, rev_ang)
                                        IfCondition EqualTo(Float_Le(delta, 0), 1) ThenBlock: {
                                            delta = Float_Add(delta, two_pi)
                                        }
                                        IfCondition EqualTo(Float_Le(two_pi, delta), 1) ThenBlock: {
                                            delta = Float_Sub(delta, two_pi)
                                        }
                                        IfCondition EqualTo(Float_Le(delta, epsd), 1) ThenBlock: {
                                            IfCondition EqualTo(fb_ok, 0) ThenBlock: {
                                                fb_ok = 1
                                                fb_found = j
                                                fb_rev = 0
                                            }
                                        }
                                        IfCondition EqualTo(Float_Le(delta, epsd), 0) ThenBlock: {
                                            // freehand candidate (best CCW among free range)
                                            IfCondition EqualTo(Float_Le(delta, best_delta), 1) ThenBlock: {
                                                best_delta = delta
                                                found = j
                                                rev = 0
                                                found_ok = 1
                                                best_d2 = d2
                                            }
                                            // tight candidate (prefer exact tess junctions)
                                            IfCondition EqualTo(Float_Le(d2, join_tight2), 1) ThenBlock: {
                                                IfCondition EqualTo(Float_Le(delta, tight_delta), 1) ThenBlock: {
                                                    tight_delta = delta
                                                    tight_found = j
                                                    tight_rev = 0
                                                    tight_ok = 1
                                                }
                                            }
                                        }
                                    }
                                }
                                // end B at tip → leave toward A (dir 1)
                                ddx = Float_Sub(bx, tipx)
                                ddy = Float_Sub(by, tipy)
                                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                                IfCondition EqualTo(Float_Le(d2, join_tol2), 1) ThenBlock: {
                                    he = Add(Multiply(j, 2), 1)
                                    IfCondition EqualTo(ArrayGet(used, he), 0) ThenBlock: {
                                        ox = Float_Sub(ax, tipx)
                                        oy = Float_Sub(ay, tipy)
                                        oang = CAD_Geom.Atan2(oy, ox)
                                        delta = Float_Sub(oang, rev_ang)
                                        IfCondition EqualTo(Float_Le(delta, 0), 1) ThenBlock: {
                                            delta = Float_Add(delta, two_pi)
                                        }
                                        IfCondition EqualTo(Float_Le(two_pi, delta), 1) ThenBlock: {
                                            delta = Float_Sub(delta, two_pi)
                                        }
                                        IfCondition EqualTo(Float_Le(delta, epsd), 1) ThenBlock: {
                                            IfCondition EqualTo(fb_ok, 0) ThenBlock: {
                                                fb_ok = 1
                                                fb_found = j
                                                fb_rev = 1
                                            }
                                        }
                                        IfCondition EqualTo(Float_Le(delta, epsd), 0) ThenBlock: {
                                            IfCondition EqualTo(Float_Le(delta, best_delta), 1) ThenBlock: {
                                                best_delta = delta
                                                found = j
                                                rev = 1
                                                found_ok = 1
                                                best_d2 = d2
                                            }
                                            IfCondition EqualTo(Float_Le(d2, join_tight2), 1) ThenBlock: {
                                                IfCondition EqualTo(Float_Le(delta, tight_delta), 1) ThenBlock: {
                                                    tight_delta = delta
                                                    tight_found = j
                                                    tight_rev = 1
                                                    tight_ok = 1
                                                }
                                            }
                                        }
                                    }
                                }
                                j = Add(j, 1)
                            }
                            // prefer tight tess junction over freehand near-miss
                            IfCondition EqualTo(tight_ok, 1) ThenBlock: {
                                found_ok = 1
                                found = tight_found
                                rev = tight_rev
                            }
                            // only reverse available
                            IfCondition EqualTo(found_ok, 0) ThenBlock: {
                                IfCondition EqualTo(fb_ok, 1) ThenBlock: {
                                    found_ok = 1
                                    found = fb_found
                                    rev = fb_rev
                                }
                            }
                            IfCondition EqualTo(found_ok, 0) ThenBlock: {
                                // open path — stop this walk
                                guard = 99999
                            }
                            IfCondition EqualTo(found_ok, 1) ThenBlock: {
                                he = Multiply(found, 2)
                                IfCondition EqualTo(rev, 1) ThenBlock: {
                                    he = Add(he, 1)
                                }
                                // temporarily mark so this walk does not re-use
                                ArraySet(used, he, 1)
                                // path_he holds 2048 slots (16384/8)
                                IfCondition LessThan(nhe, 2048) ThenBlock: {
                                    ArraySet(path_he, nhe, he)
                                    nhe = Add(nhe, 1)
                                }
                                base = Multiply(found, 4)
                                prevx = tipx
                                prevy = tipy
                                IfCondition EqualTo(rev, 0) ThenBlock: {
                                    tipx = ArrayGet(lines, Add(base, 2))
                                    tipy = ArrayGet(lines, Add(base, 3))
                                }
                                IfCondition EqualTo(rev, 1) ThenBlock: {
                                    tipx = ArrayGet(lines, base)
                                    tipy = ArrayGet(lines, Add(base, 1))
                                }
                                // tloop holds 2048 xy pairs
                                IfCondition LessThan(nn, 2048) ThenBlock: {
                                    // accumulate path length for close check
                                    plen = Float_Add(plen, CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(tipx, prevx), Float_Sub(tipx, prevx)), Float_Mul(Float_Sub(tipy, prevy), Float_Sub(tipy, prevy)))))
                                    ArraySet(tloop, Multiply(nn, 2), tipx)
                                    ArraySet(tloop, Add(Multiply(nn, 2), 1), tipy)
                                    nn = Add(nn, 1)
                                }
                            }
                        }
                    }
                }
                saved = 0
                IfCondition EqualTo(closed, 1) ThenBlock: {
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        // signed area — keep CCW faces only (drop exterior CW)
                        ar = 0
                        i = 0
                        WhileLoop LessThan(i, nn) {
                            j = Add(i, 1)
                            IfCondition EqualTo(j, nn) ThenBlock: { j = 0 }
                            xi = ArrayGet(tloop, Multiply(i, 2))
                            yi = ArrayGet(tloop, Add(Multiply(i, 2), 1))
                            xj = ArrayGet(tloop, Multiply(j, 2))
                            yj = ArrayGet(tloop, Add(Multiply(j, 2), 1))
                            ar = Float_Add(ar, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
                            i = Add(i, 1)
                        }
                        // Keep every non-zero face for now; post-filter drops exterior.
                        // flip=1 if original winding was CW (ar<0) → reverse to store CCW.
                        keep = 0
                        flip = 0
                        // min area ~ 0.05% of diag^2 (reject phantom thin red strips)
                        amin = Float_Mul(Float_Mul(diag, diag), 0x3F50624DD2F1A9FC)
                        arn = ar
                        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { arn = Float_Sub(0, ar) }
                        // perimeter for sliver test
                        peri = 0
                        i = 0
                        WhileLoop LessThan(i, nn) {
                            j = Add(i, 1)
                            IfCondition EqualTo(j, nn) ThenBlock: { j = 0 }
                            xi = ArrayGet(tloop, Multiply(i, 2))
                            yi = ArrayGet(tloop, Add(Multiply(i, 2), 1))
                            xj = ArrayGet(tloop, Multiply(j, 2))
                            yj = ArrayGet(tloop, Add(Multiply(j, 2), 1))
                            peri = Float_Add(peri, CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(xj, xi), Float_Sub(xj, xi)), Float_Mul(Float_Sub(yj, yi), Float_Sub(yj, yi)))))
                            i = Add(i, 1)
                        }
                        // isoperimetric: peri^2 / area huge ⇒ needle/sliver (no real face)
                        // reject if peri^2 > 120 * |ar|  (was 400 — still allowed padfail spikes)
                        // arn = |2*signed_area| from shoelace sum
                        sliver = 0
                        IfCondition EqualTo(Float_Le(arn, amin), 1) ThenBlock: { sliver = 1 }
                        IfCondition EqualTo(sliver, 0) ThenBlock: {
                            // 0x405E000000000000 = 120.0
                            IfCondition EqualTo(Float_Le(Float_Mul(0x405E000000000000, arn), Float_Mul(peri, peri)), 1) ThenBlock: {
                                sliver = 1
                            }
                        }
                        // thin faces with few verts are almost always junction junk
                        IfCondition EqualTo(sliver, 0) ThenBlock: {
                            IfCondition LessThan(nn, 10) ThenBlock: {
                                // peri^2 > 80 * arn
                                IfCondition EqualTo(Float_Le(Float_Mul(0x4054000000000000, arn), Float_Mul(peri, peri)), 1) ThenBlock: {
                                    sliver = 1
                                }
                            }
                        }
                        // long-chord reject: one edge dominates perimeter → phantom weld
                        // (geometeryfail: free ends snapped across open air)
                        IfCondition EqualTo(sliver, 0) ThenBlock: {
                            maxe = 0
                            i = 0
                            WhileLoop LessThan(i, nn) {
                                j = Add(i, 1)
                                IfCondition EqualTo(j, nn) ThenBlock: { j = 0 }
                                xi = ArrayGet(tloop, Multiply(i, 2))
                                yi = ArrayGet(tloop, Add(Multiply(i, 2), 1))
                                xj = ArrayGet(tloop, Multiply(j, 2))
                                yj = ArrayGet(tloop, Add(Multiply(j, 2), 1))
                                el = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(xj, xi), Float_Sub(xj, xi)), Float_Mul(Float_Sub(yj, yi), Float_Sub(yj, yi))))
                                IfCondition EqualTo(Float_Le(maxe, el), 1) ThenBlock: { maxe = el }
                                i = Add(i, 1)
                            }
                            // max edge > 48% of peri ⇒ digon-ish / phantom chord face
                            IfCondition EqualTo(Float_Le(Float_Mul(0x3FEF5C28F5C28F5C, peri), maxe), 1) ThenBlock: {
                                sliver = 1
                            }
                        }
                        IfCondition EqualTo(sliver, 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: {
                                keep = 1
                                flip = 1
                            }
                            IfCondition EqualTo(Float_Le(ar, 0), 0) ThenBlock: {
                                keep = 1
                                flip = 0
                            }
                        }
                        IfCondition EqualTo(keep, 1) ThenBlock: {
                            IfCondition LessThan(nprof, cap_p) ThenBlock: {
                                ArraySet(pmeta, Multiply(nprof, 2), nn)
                                ArraySet(pmeta, Add(Multiply(nprof, 2), 1), pool_n)
                                k = 0
                                WhileLoop LessThan(k, nn) {
                                    src = k
                                    IfCondition EqualTo(flip, 1) ThenBlock: {
                                        src = Subtract(Subtract(nn, 1), k)
                                    }
                                    ArraySet(pool, Multiply(Add(pool_n, k), 2), ArrayGet(tloop, Multiply(src, 2)))
                                    ArraySet(pool, Add(Multiply(Add(pool_n, k), 2), 1), ArrayGet(tloop, Add(Multiply(src, 2), 1)))
                                    k = Add(k, 1)
                                }
                                ArraySet(pmeta, Multiply(nprof, 2), nn)
                                ArraySet(pmeta, Add(Multiply(nprof, 2), 1), pool_n)
                                ArraySet(was_cw, nprof, flip)
                                pool_n = Add(pool_n, nn)
                                nprof = Add(nprof, 1)
                                saved = 1
                            }
                        }
                    }
                }
                // rollback temporary marks if face not saved
                IfCondition EqualTo(saved, 0) ThenBlock: {
                    pi = 0
                    WhileLoop LessThan(pi, nhe) {
                        ArraySet(used, ArrayGet(path_he, pi), 0)
                        pi = Add(pi, 1)
                    }
                }
                Deallocate(path_he, 16384)
            }
            start_he = Add(start_he, 1)
        }
        Deallocate(used, 65536)
        Deallocate(tloop, 32768)
                // Keep CW interiors always. Also keep ONE exterior envelope (was_cw=0)
        // with the most verts when any interiors exist — outer multi-circle silhouette.
        // padfail: n_cw==1 junk triangle dropped outer when use_env required n_cw>1.
        n_cw = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            IfCondition EqualTo(ArrayGet(was_cw, pi), 1) ThenBlock: {
                n_cw = Add(n_cw, 1)
            }
            pi = Add(pi, 1)
        }
        // find best exterior envelope candidate
        env_i = -1
        env_nn = 0
        env_ar = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            IfCondition EqualTo(ArrayGet(was_cw, pi), 0) ThenBlock: {
                pn = ArrayGet(pmeta, Multiply(pi, 2))
                po = ArrayGet(pmeta, Add(Multiply(pi, 2), 1))
                ar = 0
                i = 0
                WhileLoop LessThan(i, pn) {
                    j = Add(i, 1)
                    IfCondition EqualTo(j, pn) ThenBlock: { j = 0 }
                    xi = ArrayGet(pool, Multiply(Add(po, i), 2))
                    yi = ArrayGet(pool, Add(Multiply(Add(po, i), 2), 1))
                    xj = ArrayGet(pool, Multiply(Add(po, j), 2))
                    yj = ArrayGet(pool, Add(Multiply(Add(po, j), 2), 1))
                    ar = Float_Add(ar, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
                    i = Add(i, 1)
                }
                IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                // prefer more verts (outer slot uses many rim segs), then area
                take = 0
                IfCondition GreaterEqual(pn, 8) ThenBlock: {
                    IfCondition EqualTo(env_i, -1) ThenBlock: { take = 1 }
                    IfCondition GreaterThan(pn, env_nn) ThenBlock: { take = 1 }
                    IfCondition EqualTo(pn, env_nn) ThenBlock: {
                        IfCondition EqualTo(Float_Le(env_ar, ar), 1) ThenBlock: { take = 1 }
                    }
                }
                // also allow high-area exterior with fewer verts (smoothed)
                IfCondition EqualTo(take, 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(env_ar, ar), 1) ThenBlock: {
                        IfCondition GreaterEqual(pn, 6) ThenBlock: { take = 1 }
                    }
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    env_i = pi
                    env_nn = pn
                    env_ar = ar
                }
            }
            pi = Add(pi, 1)
        }
        // attach outer envelope whenever we have any interior (incl. single junk CW)
        use_env = 0
        IfCondition GreaterThan(n_cw, 0) ThenBlock: {
            IfCondition GreaterEqual(env_i, 0) ThenBlock: { use_env = 1 }
        }
        // if NO interiors, keep exteriors (fallback)
        prefer_ext = 0
        IfCondition EqualTo(n_cw, 0) ThenBlock: {
            use_env = 0
            prefer_ext = 1
        }
        IfCondition GreaterThan(nprof, 0) ThenBlock: {
            new_n = 0
            new_pool_n = 0
            pi = 0
            WhileLoop LessThan(pi, nprof) {
                keep_i = 0
                IfCondition EqualTo(prefer_ext, 1) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(was_cw, pi), 0) ThenBlock: { keep_i = 1 }
                }
                IfCondition EqualTo(prefer_ext, 0) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(was_cw, pi), 1) ThenBlock: { keep_i = 1 }
                    IfCondition EqualTo(use_env, 1) ThenBlock: {
                        IfCondition EqualTo(pi, env_i) ThenBlock: { keep_i = 1 }
                    }
                }
                IfCondition EqualTo(keep_i, 1) ThenBlock: {
                    pn = ArrayGet(pmeta, Multiply(pi, 2))
                    po = ArrayGet(pmeta, Add(Multiply(pi, 2), 1))
                    ArraySet(pmeta, Multiply(new_n, 2), pn)
                    ArraySet(pmeta, Add(Multiply(new_n, 2), 1), new_pool_n)
                    k = 0
                    WhileLoop LessThan(k, pn) {
                        ArraySet(pool, Multiply(Add(new_pool_n, k), 2), ArrayGet(pool, Multiply(Add(po, k), 2)))
                        ArraySet(pool, Add(Multiply(Add(new_pool_n, k), 2), 1), ArrayGet(pool, Add(Multiply(Add(po, k), 2), 1)))
                        k = Add(k, 1)
                    }
                    new_pool_n = Add(new_pool_n, pn)
                    new_n = Add(new_n, 1)
                }
                pi = Add(pi, 1)
            }
            nprof = new_n
        }
        // Dedupe CW+CCW of the SAME cycle (both stored CCW with equal |area|).
        // padfail: outer+duplicate "hole" → ExtrudeCut self → triangle void / garbage solid.
        IfCondition GreaterThan(nprof, 1) ThenBlock: {
            new_n = 0
            new_pool_n = 0
            pi = 0
            WhileLoop LessThan(pi, nprof) {
                pn = ArrayGet(pmeta, Multiply(pi, 2))
                po = ArrayGet(pmeta, Add(Multiply(pi, 2), 1))
                ar = 0
                i = 0
                WhileLoop LessThan(i, pn) {
                    j = Add(i, 1)
                    IfCondition EqualTo(j, pn) ThenBlock: { j = 0 }
                    xi = ArrayGet(pool, Multiply(Add(po, i), 2))
                    yi = ArrayGet(pool, Add(Multiply(Add(po, i), 2), 1))
                    xj = ArrayGet(pool, Multiply(Add(po, j), 2))
                    yj = ArrayGet(pool, Add(Multiply(Add(po, j), 2), 1))
                    ar = Float_Add(ar, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
                    i = Add(i, 1)
                }
                IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                // drop if a kept profile already has ~same area (within 2%)
                dup = 0
                qi = 0
                WhileLoop LessThan(qi, new_n) {
                    qn = ArrayGet(pmeta, Multiply(qi, 2))
                    qo = ArrayGet(pmeta, Add(Multiply(qi, 2), 1))
                    aq = 0
                    i = 0
                    WhileLoop LessThan(i, qn) {
                        j = Add(i, 1)
                        IfCondition EqualTo(j, qn) ThenBlock: { j = 0 }
                        xi = ArrayGet(pool, Multiply(Add(qo, i), 2))
                        yi = ArrayGet(pool, Add(Multiply(Add(qo, i), 2), 1))
                        xj = ArrayGet(pool, Multiply(Add(qo, j), 2))
                        yj = ArrayGet(pool, Add(Multiply(Add(qo, j), 2), 1))
                        aq = Float_Add(aq, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
                        i = Add(i, 1)
                    }
                    IfCondition EqualTo(Float_Le(aq, 0), 1) ThenBlock: { aq = Float_Sub(0, aq) }
                    // |ar-aq| <= 0.02 * max(ar,aq)
                    mx = ar
                    IfCondition EqualTo(Float_Le(mx, aq), 1) ThenBlock: { mx = aq }
                    dlt = Float_Sub(ar, aq)
                    IfCondition EqualTo(Float_Le(dlt, 0), 1) ThenBlock: { dlt = Float_Sub(0, dlt) }
                    // 0.02 = 0x3F947AE147AE147B
                    IfCondition EqualTo(Float_Le(dlt, Float_Mul(mx, 0x3F947AE147AE147B)), 1) ThenBlock: {
                        // also require similar vert count (not a real nested hole)
                        dn = Subtract(pn, qn)
                        IfCondition LessThan(dn, 0) ThenBlock: { dn = Subtract(0, dn) }
                        // |nn diff| <= max(4, 10% of larger nn)
                        lim = 4
                        mxn = pn
                        IfCondition GreaterThan(qn, mxn) ThenBlock: { mxn = qn }
                        t10 = Divide(mxn, 10)
                        IfCondition GreaterThan(t10, lim) ThenBlock: { lim = t10 }
                        IfCondition LessThan(Add(dn, 1), Add(lim, 2)) ThenBlock: { dup = 1 }
                    }
                    qi = Add(qi, 1)
                }
                IfCondition EqualTo(dup, 0) ThenBlock: {
                    ArraySet(pmeta, Multiply(new_n, 2), pn)
                    ArraySet(pmeta, Add(Multiply(new_n, 2), 1), new_pool_n)
                    k = 0
                    WhileLoop LessThan(k, pn) {
                        ArraySet(pool, Multiply(Add(new_pool_n, k), 2), ArrayGet(pool, Multiply(Add(po, k), 2)))
                        ArraySet(pool, Add(Multiply(Add(new_pool_n, k), 2), 1), ArrayGet(pool, Add(Multiply(Add(po, k), 2), 1)))
                        k = Add(k, 1)
                    }
                    new_pool_n = Add(new_pool_n, pn)
                    new_n = Add(new_n, 1)
                }
                pi = Add(pi, 1)
            }
            nprof = new_n
        }
        Deallocate(was_cw, 512)
        CAD_Store.Write(sketch_handle, 12, nprof)
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            ReturnValue(CAD_Sketch.BuildClosedLoop(sketch_handle))
        }
        // pick largest |area| as profile 0 (outer pad default)
        best = 0
        best_a = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            pn = ArrayGet(pmeta, Multiply(pi, 2))
            po = ArrayGet(pmeta, Add(Multiply(pi, 2), 1))
            ar = 0
            i = 0
            WhileLoop LessThan(i, pn) {
                j = Add(i, 1)
                IfCondition EqualTo(j, pn) ThenBlock: { j = 0 }
                xi = ArrayGet(pool, Multiply(Add(po, i), 2))
                yi = ArrayGet(pool, Add(Multiply(Add(po, i), 2), 1))
                xj = ArrayGet(pool, Multiply(Add(po, j), 2))
                yj = ArrayGet(pool, Add(Multiply(Add(po, j), 2), 1))
                ar = Float_Add(ar, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
                i = Add(i, 1)
            }
            IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
            IfCondition EqualTo(Float_Le(best_a, ar), 1) ThenBlock: {
                best_a = ar
                best = pi
            }
            pi = Add(pi, 1)
        }
        IfCondition NotEqual(best, 0) ThenBlock: {
            n0 = ArrayGet(pmeta, 0)
            o0 = ArrayGet(pmeta, 1)
            ArraySet(pmeta, 0, ArrayGet(pmeta, Multiply(best, 2)))
            ArraySet(pmeta, 1, ArrayGet(pmeta, Add(Multiply(best, 2), 1)))
            ArraySet(pmeta, Multiply(best, 2), n0)
            ArraySet(pmeta, Add(Multiply(best, 2), 1), o0)
        }
        pn0 = ArrayGet(pmeta, 0)
        po0 = ArrayGet(pmeta, 1)
        ploop = CAD_Store.Read(sketch_handle, 3)
        k = 0
        WhileLoop LessThan(k, pn0) {
            ArraySet(ploop, Multiply(k, 2), ArrayGet(pool, Multiply(Add(po0, k), 2)))
            ArraySet(ploop, Add(Multiply(k, 2), 1), ArrayGet(pool, Add(Multiply(Add(po0, k), 2), 1)))
            k = Add(k, 1)
        }
        CAD_Store.Write(sketch_handle, 2, pn0)
        ReturnValue(nprof)
    }
}

// Copy profile i verts into out_xy (caller buffer). Returns n or 0.
// Copy profile i into out_xy as interleaved x,y.
// Caller must provide ≥2048 points (32768 bytes). Hard cap prevents heap smash
// (cad_app used 4096-byte buffers = 256 pts → multi-circle pad SEGV after "pad OK").
Function.CAD_Sketch.GetProfileXY {
    Input: sketch_handle: Integer
    Input: profile_i: Integer
    Input: out_xy_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        np = CAD_Store.Read(sketch_handle, 12)
        IfCondition GreaterEqual(profile_i, np) ThenBlock: { ReturnValue(0) }
        pmeta = CAD_Store.Read(sketch_handle, 13)
        pool = CAD_Store.Read(sketch_handle, 14)
        nn = ArrayGet(pmeta, Multiply(profile_i, 2))
        off = ArrayGet(pmeta, Add(Multiply(profile_i, 2), 1))
        // hard cap: 2048 verts
        IfCondition GreaterThan(nn, 2048) ThenBlock: { nn = 2048 }
        k = 0
        WhileLoop LessThan(k, nn) {
            ArraySet(out_xy_addr, Multiply(k, 2), ArrayGet(pool, Multiply(Add(off, k), 2)))
            ArraySet(out_xy_addr, Add(Multiply(k, 2), 1), ArrayGet(pool, Add(Multiply(Add(off, k), 2), 1)))
            k = Add(k, 1)
        }
        ReturnValue(nn)
    }
}

// Build a new sketch whose only closed loop is the given XY ring (n_pts ≥ 3).
// Used for hole/cut tools from multi-profile DXF loops.
Function.CAD_Sketch.FromClosedXY {
    Input: xy_addr: Address
    Input: n_pts: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(xy_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_pts, 3) ThenBlock: { ReturnValue(0) }
        h = CAD_Sketch.CreateSketch(1)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n_pts) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n_pts) ThenBlock: { j = 0 }
            x0 = ArrayGet(xy_addr, Multiply(i, 2))
            y0 = ArrayGet(xy_addr, Add(Multiply(i, 2), 1))
            x1 = ArrayGet(xy_addr, Multiply(j, 2))
            y1 = ArrayGet(xy_addr, Add(Multiply(j, 2), 1))
            CAD_Sketch.AddLine(h, x0, y0, x1, y1)
            i = Add(i, 1)
        }
        CAD_Sketch.BuildClosedLoop(h)
        ReturnValue(h)
    }
}

// Append a closed XY ring as the next multi-profile on an existing sketch.
// First call should start from CreateSketch; profile 0 is also mirrored to primary loop.
// Returns new n_profiles or 0 on fail.
Function.CAD_Sketch.AddProfileXY {
    Input: sketch_handle: Integer
    Input: xy_addr: Address
    Input: n_pts: Integer
    Output: Integer
    Body: {
        // pin all 3 args first (ABI clobber → n_pts=4 → pad becomes a cube box)
        h = sketch_handle
        addr = xy_addr
        npt = n_pts
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(npt, 3) ThenBlock: { ReturnValue(0) }
        nprof = CAD_Store.Read(h, 12)
        cap_p = CAD_Store.Read(h, 15)
        IfCondition GreaterEqual(nprof, cap_p) ThenBlock: { ReturnValue(0) }
        pmeta = CAD_Store.Read(h, 13)
        pool = CAD_Store.Read(h, 14)
        // compute current pool_n from last profile
        pool_n = 0
        IfCondition GreaterThan(nprof, 0) ThenBlock: {
            li = Subtract(nprof, 1)
            pool_n = Add(ArrayGet(pmeta, Add(Multiply(li, 2), 1)), ArrayGet(pmeta, Multiply(li, 2)))
        }
        ArraySet(pmeta, Multiply(nprof, 2), npt)
        ArraySet(pmeta, Add(Multiply(nprof, 2), 1), pool_n)
        k = 0
        WhileLoop LessThan(k, npt) {
            ArraySet(pool, Multiply(Add(pool_n, k), 2), ArrayGet(addr, Multiply(k, 2)))
            ArraySet(pool, Add(Multiply(Add(pool_n, k), 2), 1), ArrayGet(addr, Add(Multiply(k, 2), 1)))
            k = Add(k, 1)
        }
        nprof = Add(nprof, 1)
        CAD_Store.Write(h, 12, nprof)
        // first profile → primary loop + lines for ExtrudeProfile
        IfCondition EqualTo(nprof, 1) ThenBlock: {
            ploop = CAD_Store.Read(h, 3)
            k = 0
            WhileLoop LessThan(k, npt) {
                ArraySet(ploop, Multiply(k, 2), ArrayGet(addr, Multiply(k, 2)))
                ArraySet(ploop, Add(Multiply(k, 2), 1), ArrayGet(addr, Add(Multiply(k, 2), 1)))
                k = Add(k, 1)
            }
            CAD_Store.Write(h, 2, npt)
            // also add lines so Extrude has geometry
            i = 0
            WhileLoop LessThan(i, npt) {
                j = Add(i, 1)
                IfCondition EqualTo(j, npt) ThenBlock: { j = 0 }
                x0 = ArrayGet(addr, Multiply(i, 2))
                y0 = ArrayGet(addr, Add(Multiply(i, 2), 1))
                x1 = ArrayGet(addr, Multiply(j, 2))
                y1 = ArrayGet(addr, Add(Multiply(j, 2), 1))
                CAD_Sketch.AddLine(h, x0, y0, x1, y1)
                i = Add(i, 1)
            }
        }
        ReturnValue(nprof)
    }
}

// Validate primary loop: n≥3, |area|>0. Returns 0 ok, negative error.
Function.CAD_Sketch.ValidateProfile {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: {
            CAD_Sketch_State.last_error = -1
            ReturnValue(-1)
        }
        n = CAD_Store.Read(sketch_handle, 2)
        IfCondition LessThan(n, 3) ThenBlock: {
            n = CAD_Sketch.BuildAllClosedLoops(sketch_handle)
            n = CAD_Store.Read(sketch_handle, 2)
        }
        IfCondition LessThan(n, 3) ThenBlock: {
            CAD_Sketch_State.last_error = -2
            ReturnValue(-2)
        }
        loop = CAD_Store.Read(sketch_handle, 3)
        a = CAD_Sketch.LoopSignedArea(loop, n)
        IfCondition EqualTo(CAD_Num.IsZero(a, 0), 1) ThenBlock: {
            CAD_Sketch_State.last_error = -4
            ReturnValue(-4)
        }
        CAD_Sketch_State.last_error = 0
        ReturnValue(0)
    }
}

Function.CAD_Sketch.AddBSpline {
    Input: sketch_handle: Integer
    Input: ctrl_pts_addr: Address
    Input: degree: Integer
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

Function.CAD_Sketch.SnapToGrid {
    Input: val_r: Integer
    Input: grid_step_r: Integer
    Output: Integer
    Body: {
        ReturnValue(val_r)
    }
}

Function.CAD_Sketch.SnapToEndPoint {
    Input: sketch_handle: Integer
    Input: mouse_x_r: Integer
    Input: mouse_y_r: Integer
    Input: tol_r: Integer
    Input: out_snap_pt_addr: Address
    Output: Integer
    Body: {
        ArraySet(out_snap_pt_addr, 0, mouse_x_r)
        ArraySet(out_snap_pt_addr, 1, mouse_y_r)
        ReturnValue(0)
    }
}

// Interactive sketch trim: pick nearest entity at (wx,wy) within hit_lim (world),
// split at stored junctions / exact isects, drop piece under click.
// Returns:
//   0 miss
//   1 trimmed line stub
//   2 deleted full circle
//   3 circle → arcs
//   4 trimmed arc (kept residual pieces)
//   5 deleted whole arc tip-to-tip
//   6 trimmed line stub near arc tip
//   7 miss after line split
//   8 arc trim restore (no piece kept — should be rare)
Function.CAD_Sketch.TrimAt {
    Input: sketch_handle: Integer
    Input: wx: Integer
    Input: wy: Integer
    Input: hit_lim: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: {
            ReturnValue(0)
        }
        hit_lim2 = Float_Mul(hit_lim, hit_lim)
        IfCondition EqualTo(CAD_Num.IsZero(hit_lim, 0), 1) ThenBlock: {
            hit_lim = 0x3F50624DD2F1A9FC
            hit_lim2 = Float_Mul(hit_lim, hit_lim)
        }
        two_pi = 0x401921FB54442D18
        eps = 0x3F50624DD2F1A9FC
        one = 0x3FF0000000000000

        // --- pick nearest entity: line / circle rim / arc rim ---
        best_kind = 0
        best_idx = 0
        best_d2 = hit_lim2
        hit_ok = 0

        // lines — slightly de-prefer vs curves so mid-arc trim wins near crossings
        nl = CAD_Sketch.GetLineCount(sketch_handle)
        lines = CAD_Store.Read(sketch_handle, 1)
        i = 0
        WhileLoop LessThan(i, nl) {
            b = Multiply(i, 4)
            x0 = ArrayGet(lines, b)
            y0 = ArrayGet(lines, Add(b, 1))
            x1 = ArrayGet(lines, Add(b, 2))
            y1 = ArrayGet(lines, Add(b, 3))
            dx = Float_Sub(x1, x0)
            dy = Float_Sub(y1, y0)
            len2 = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
            t = 0
            IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
                t = Float_Div(CAD_Num.Dot2(Float_Sub(wx, x0), Float_Sub(wy, y0), dx, dy), len2)
                IfCondition EqualTo(CAD_Num.IsNeg(t), 1) ThenBlock: { t = 0 }
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(one, t)), 1) ThenBlock: { t = one }
            }
            px = Float_Add(x0, CAD_Num.Mul(t, dx))
            py = Float_Add(y0, CAD_Num.Mul(t, dy))
            ddx = Float_Sub(wx, px)
            ddy = Float_Sub(wy, py)
            d2 = Float_Add(CAD_Num.Sq(ddx), CAD_Num.Sq(ddy))
            // inflate line distance so arc/circle rim wins when similar
            d2 = Float_Mul(d2, 0x3FF8000000000000)
            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                best_d2 = d2
                best_idx = i
                best_kind = 1
                hit_ok = 1
            }
            i = Add(i, 1)
        }

        // circles (distance to rim)
        nc = CAD_Sketch.GetCircleCount(sketch_handle)
        circs = CAD_Store.Read(sketch_handle, 8)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            base = Multiply(ci, 3)
            cx = ArrayGet(circs, base)
            cy = ArrayGet(circs, Add(base, 1))
            rad = ArrayGet(circs, Add(base, 2))
            d = CAD_Num.Hypot2(Float_Sub(wx, cx), Float_Sub(wy, cy))
            dd = CAD_Num.Abs(Float_Sub(d, rad))
            d2 = Float_Mul(dd, dd)
            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                best_d2 = d2
                best_idx = ci
                best_kind = 2
                hit_ok = 1
            }
            ci = Add(ci, 1)
        }

        // arcs (distance to arc curve, only if angle on span)
        // Float_Le(neg,0) is broken in ailang.x — use PosMod2Pi / Abs / IsNeg.
        na = CAD_Sketch.GetArcCount(sketch_handle)
        arcs = CAD_Store.Read(sketch_handle, 11)
        ai = 0
        WhileLoop LessThan(ai, na) {
            base = Multiply(ai, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            ang = CAD_Geom.Atan2(Float_Sub(wy, cy), Float_Sub(wx, cx))
            dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
            on = 0
            IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: { on = 1 }
            IfCondition EqualTo(on, 1) ThenBlock: {
                d = CAD_Num.Hypot2(Float_Sub(wx, cx), Float_Sub(wy, cy))
                dd = CAD_Num.Abs(Float_Sub(d, rad))
                d2 = Float_Mul(dd, dd)
                IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                    best_d2 = d2
                    best_idx = ai
                    best_kind = 3
                    hit_ok = 1
                }
            }
            ai = Add(ai, 1)
        }

        IfCondition EqualTo(hit_ok, 0) ThenBlock: {
            ReturnValue(0)
        }

        // ========== LINE: split ONLY the hit segment at joins, delete piece ==========
        // Do NOT re-split the whole sketch every click (was exploding segs + hitting
        // silent 512-cap drops under cat-head + offset-rect trim sessions).
        IfCondition EqualTo(best_kind, 1) ThenBlock: {
            CAD_Sketch.RebuildAnchors(sketch_handle)
            // split only the line under the cursor
            CAD_Sketch.SplitLineAtHits(sketch_handle, best_idx)
            // re-pick nearest LINE piece after that one line was subdivided
            nl = CAD_Sketch.GetLineCount(sketch_handle)
            lines = CAD_Store.Read(sketch_handle, 1)
            best_line = 0
            best_d2 = hit_lim2
            line_ok = 0
            i = 0
            WhileLoop LessThan(i, nl) {
                b = Multiply(i, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                t = 0
                IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 0) ThenBlock: {
                    t = Float_Div(Float_Add(Float_Mul(Float_Sub(wx, x0), dx), Float_Mul(Float_Sub(wy, y0), dy)), len2)
                    IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: { t = 0 }
                    IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: { t = one }
                }
                px = Float_Add(x0, Float_Mul(t, dx))
                py = Float_Add(y0, Float_Mul(t, dy))
                ddx = Float_Sub(wx, px)
                ddy = Float_Sub(wy, py)
                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                    best_d2 = d2
                    best_line = i
                    line_ok = 1
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(line_ok, 0) ThenBlock: {
                ReturnValue(7)
            }
            CAD_Sketch.DeleteLine(sketch_handle, best_line)
            CAD_Sketch.RebuildAnchors(sketch_handle)
            ReturnValue(1)
        }

        // ========== CIRCLE: keep as arcs, remove sector under click ==========
        IfCondition EqualTo(best_kind, 2) ThenBlock: {
            circs = CAD_Store.Read(sketch_handle, 8)
            base = Multiply(best_idx, 3)
            cx = ArrayGet(circs, base)
            cy = ArrayGet(circs, Add(base, 1))
            rad = ArrayGet(circs, Add(base, 2))
            // refresh junction tree before collecting cuts
            CAD_Sketch.RebuildAnchors(sketch_handle)
            // merge tol only — cuts from EXACT plane isects
            jtol = Float_Mul(rad, 0x3F847AE147AE147B)
            IfCondition EqualTo(Float_Le(jtol, eps), 1) ThenBlock: { jtol = eps }
            click_ang = CAD_Num.PosMod2Pi(CAD_Geom.Atan2(Float_Sub(wy, cy), Float_Sub(wx, cx)))
            angs = Allocate(512)
            nang = 0
            // stored anchors on this rim
            npt = CAD_Sketch.GetPointCount(sketch_handle)
            pts = CAD_Store.Read(sketch_handle, 17)
            IfCondition Notequal(pts, 0) ThenBlock: {
                pi = 0
                WhileLoop LessThan(pi, npt) {
                    px = ArrayGet(pts, Multiply(pi, 2))
                    py = ArrayGet(pts, Add(Multiply(pi, 2), 1))
                    d = CAD_Num.Hypot2(Float_Sub(px, cx), Float_Sub(py, cy))
                    dd = CAD_Num.Abs(Float_Sub(d, rad))
                    IfCondition EqualTo(Float_Le(dd, jtol), 1) ThenBlock: {
                        ang = CAD_Num.PosMod2Pi(CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx)))
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                    pi = Add(pi, 1)
                }
            }
            // EXACT line x this circle: |P+tD-C|^2=r^2, t in [0,1]
            nl = CAD_Sketch.GetLineCount(sketch_handle)
            lines = CAD_Store.Read(sketch_handle, 1)
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, dx, dy))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, eps)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            ok = 1
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(t, Float_Sub(0, eps))), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Add(one, eps), t)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, CAD_Num.Mul(t, dx))
                                py = Float_Add(y0, CAD_Num.Mul(t, dy))
                                ang = CAD_Num.PosMod2Pi(CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx)))
                                IfCondition LessThan(nang, 500) ThenBlock: {
                                    ArraySet(angs, nang, ang)
                                    nang = Add(nang, 1)
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                    // exact tip-on-circle
                    ei = 0
                    WhileLoop LessThan(ei, 2) {
                        IfCondition EqualTo(ei, 0) ThenBlock: {
                            px = x0
                            py = y0
                        }
                        IfCondition EqualTo(ei, 1) ThenBlock: {
                            px = x1
                            py = y1
                        }
                        d = CAD_Num.Hypot2(Float_Sub(px, cx), Float_Sub(py, cy))
                        dd = CAD_Num.Abs(Float_Sub(d, rad))
                        IfCondition EqualTo(Float_Le(dd, jtol), 1) ThenBlock: {
                            ang = CAD_Num.PosMod2Pi(CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx)))
                            IfCondition LessThan(nang, 500) ThenBlock: {
                                ArraySet(angs, nang, ang)
                                nang = Add(nang, 1)
                            }
                        }
                        ei = Add(ei, 1)
                    }
                }
                li = Add(li, 1)
            }
            // other circles × this circle
            nc2 = CAD_Sketch.GetCircleCount(sketch_handle)
            cj = 0
            WhileLoop LessThan(cj, nc2) {
                IfCondition NotEqual(cj, best_idx) ThenBlock: {
                    bj = Multiply(cj, 3)
                    ox = ArrayGet(circs, bj)
                    oy = ArrayGet(circs, Add(bj, 1))
                    orad = ArrayGet(circs, Add(bj, 2))
                    dx = Float_Sub(ox, cx)
                    dy = Float_Sub(oy, cy)
                    d2c = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    d = CAD_Num.Sqrt(d2c)
                    okc = 1
                    IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: { okc = 0 }
                    IfCondition EqualTo(Float_Le(Float_Add(rad, orad), d), 1) ThenBlock: { okc = 0 }
                    dr = Float_Sub(rad, orad)
                    IfCondition EqualTo(Float_Le(dr, 0), 1) ThenBlock: { dr = Float_Sub(0, dr) }
                    IfCondition EqualTo(Float_Le(d, dr), 1) ThenBlock: { okc = 0 }
                    IfCondition EqualTo(okc, 1) ThenBlock: {
                        a = Float_Div(Float_Add(Float_Sub(Float_Mul(rad, rad), Float_Mul(orad, orad)), d2c), Float_Mul(0x4000000000000000, d))
                        h2 = Float_Sub(Float_Mul(rad, rad), Float_Mul(a, a))
                        IfCondition EqualTo(Float_Le(h2, 0), 0) ThenBlock: {
                            h = CAD_Num.Sqrt(h2)
                            mx = Float_Add(cx, Float_Mul(a, Float_Div(dx, d)))
                            my = Float_Add(cy, Float_Mul(a, Float_Div(dy, d)))
                            rx = Float_Mul(h, Float_Div(dy, d))
                            ry = Float_Mul(h, Float_Div(dx, d))
                            hi = 0
                            WhileLoop LessThan(hi, 2) {
                                IfCondition EqualTo(hi, 0) ThenBlock: {
                                    px = Float_Add(mx, rx)
                                    py = Float_Sub(my, ry)
                                }
                                IfCondition EqualTo(hi, 1) ThenBlock: {
                                    px = Float_Sub(mx, rx)
                                    py = Float_Add(my, ry)
                                }
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                        ang = Float_Add(ang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(two_pi, ang), 1) ThenBlock: {
                                    ang = Float_Sub(ang, two_pi)
                                }
                                IfCondition LessThan(nang, 500) ThenBlock: {
                                    ArraySet(angs, nang, ang)
                                    nang = Add(nang, 1)
                                }
                                hi = Add(hi, 1)
                            }
                        }
                    }
                }
                cj = Add(cj, 1)
            }
            // arc endpoints that lie on this circle rim (join tips)
            na2 = CAD_Sketch.GetArcCount(sketch_handle)
            arcs = CAD_Store.Read(sketch_handle, 11)
            aj = 0
            WhileLoop LessThan(aj, na2) {
                ab = Multiply(aj, 5)
                acx = ArrayGet(arcs, ab)
                acy = ArrayGet(arcs, Add(ab, 1))
                ar = ArrayGet(arcs, Add(ab, 2))
                aa0 = ArrayGet(arcs, Add(ab, 3))
                aa1 = ArrayGet(arcs, Add(ab, 4))
                // endpoint 0
                px = Float_Add(acx, Float_Mul(ar, CAD_Geom.Cos(aa0)))
                py = Float_Add(acy, Float_Mul(ar, CAD_Geom.Sin(aa0)))
                ddx = Float_Sub(px, cx)
                ddy = Float_Sub(py, cy)
                dist = CAD_Num.Sqrt(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)))
                IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), 0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(0, Float_Sub(dist, rad)), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                IfCondition EqualTo(Float_Le(rad, dist), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                // endpoint 1
                px = Float_Add(acx, Float_Mul(ar, CAD_Geom.Cos(aa1)))
                py = Float_Add(acy, Float_Mul(ar, CAD_Geom.Sin(aa1)))
                ddx = Float_Sub(px, cx)
                ddy = Float_Sub(py, cy)
                dist = CAD_Num.Sqrt(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)))
                IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), 0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(0, Float_Sub(dist, rad)), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                IfCondition EqualTo(Float_Le(rad, dist), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(dist, rad), Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(ddy, ddx)
                        IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, ang), eps), 0) ThenBlock: {
                                ang = Float_Add(ang, two_pi)
                            }
                        }
                        IfCondition LessThan(nang, 500) ThenBlock: {
                            ArraySet(angs, nang, ang)
                            nang = Add(nang, 1)
                        }
                    }
                }
                aj = Add(aj, 1)
            }
            // no intersections → delete whole circle (nothing to cut back to)
            IfCondition LessThan(nang, 2) ThenBlock: {
                Deallocate(angs, 512)
                CAD_Sketch.DeleteCircle(sketch_handle, best_idx)
                CAD_Sketch.RebuildAnchors(sketch_handle)
                ReturnValue(2)
            }
            // sort angles
            a = 0
            WhileLoop LessThan(a, nang) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nang) {
                    va = ArrayGet(angs, a)
                    vb = ArrayGet(angs, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(angs, a, vb)
                        ArraySet(angs, bb, va)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // unique angles into work list (compact in place)
            uangs = Allocate(512)
            nu = 0
            prev = ArrayGet(angs, 0)
            ArraySet(uangs, 0, prev)
            nu = 1
            k = 1
            WhileLoop LessThan(k, nang) {
                cur = ArrayGet(angs, k)
                dt = Float_Sub(cur, prev)
                IfCondition EqualTo(Float_Le(dt, eps), 0) ThenBlock: {
                    ArraySet(uangs, nu, cur)
                    nu = Add(nu, 1)
                    prev = cur
                }
                k = Add(k, 1)
            }
            // wrap: if first≈last+2π gap ok; need ≥2 unique
            IfCondition LessThan(nu, 2) ThenBlock: {
                Deallocate(angs, 512)
                Deallocate(uangs, 512)
                CAD_Sketch.DeleteCircle(sketch_handle, best_idx)
                CAD_Sketch.RebuildAnchors(sketch_handle)
                ReturnValue(2)
            }
            // emit arcs for every sector EXCEPT the one containing click
            // sector k is CCW [uangs[k] → uangs[k+1]] (last wraps to first)
            k = 0
            WhileLoop LessThan(k, nu) {
                sa0 = ArrayGet(uangs, k)
                sa1 = ArrayGet(uangs, 0)
                IfCondition LessThan(Add(k, 1), nu) ThenBlock: {
                    sa1 = ArrayGet(uangs, Add(k, 1))
                }
                // sector span CCW sa0→sa1
                sspan = Float_Sub(sa1, sa0)
                IfCondition EqualTo(Float_Le(sspan, 0), 1) ThenBlock: {
                    sspan = Float_Add(sspan, two_pi)
                }
                // is click in this sector?  dang in [0, sspan)
                dang = Float_Sub(click_ang, sa0)
                IfCondition EqualTo(Float_Le(dang, 0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 0) ThenBlock: {
                        dang = Float_Add(dang, two_pi)
                    }
                }
                in_sec = 0
                // dang ≈ 0 counts as start of this sector
                IfCondition EqualTo(Float_Le(Float_Sub(0, dang), eps), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(dang, eps), 1) ThenBlock: { in_sec = 1 }
                }
                // 0 < dang < sspan
                IfCondition EqualTo(Float_Le(dang, 0), 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(sspan, dang), 0) ThenBlock: { in_sec = 1 }
                }
                IfCondition EqualTo(in_sec, 0) ThenBlock: {
                    // keep this arc (true curve entity — not polyline)
                    CAD_Sketch.AddArc(sketch_handle, cx, cy, rad, sa0, sa1)
                }
                k = Add(k, 1)
            }
            CAD_Sketch.DeleteCircle(sketch_handle, best_idx)
            Deallocate(angs, 512)
            Deallocate(uangs, 512)
            // rebuild exact joins; caller/tool may split lines on next line-trim
            CAD_Sketch.RebuildAnchors(sketch_handle)
            ReturnValue(3)
        }

        // ========== ARC: split at joins, drop sub-arc under click ==========
        // Critical: Float_Le(neg,0) is broken — never use it for span/dang/disc.
        // Use CAD_Num.PosMod2Pi / IsNeg / Abs / Hypot2 so line×arc T-joins register.
        IfCondition EqualTo(best_kind, 3) ThenBlock: {
            arcs = CAD_Store.Read(sketch_handle, 11)
            base = Multiply(best_idx, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            click_ang = CAD_Geom.Atan2(Float_Sub(wy, cy), Float_Sub(wx, cx))
            // merge tol only; cuts are EXACT line/arc isects from stored coords
            jtol = Float_Mul(rad, 0x3F847AE147AE147B)
            IfCondition EqualTo(Float_Le(jtol, eps), 1) ThenBlock: { jtol = eps }
            // exclude near-tip (2% of span) — only true mid cuts for trim pieces
            teps = 0x3F947AE147AE147B
            ts = Allocate(512)
            ArraySet(ts, 0, 0)
            ArraySet(ts, 1, one)
            nt = 2
            // --- 0) stored anchors on this arc rim ---
            CAD_Sketch.RebuildAnchors(sketch_handle)
            npt = CAD_Sketch.GetPointCount(sketch_handle)
            pts = CAD_Store.Read(sketch_handle, 17)
            IfCondition Notequal(pts, 0) ThenBlock: {
                pi = 0
                WhileLoop LessThan(pi, npt) {
                    px = ArrayGet(pts, Multiply(pi, 2))
                    py = ArrayGet(pts, Add(Multiply(pi, 2), 1))
                    d = CAD_Num.Hypot2(Float_Sub(px, cx), Float_Sub(py, cy))
                    dd = CAD_Num.Abs(Float_Sub(d, rad))
                    IfCondition EqualTo(Float_Le(dd, jtol), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                        dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                        IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                            tt = 0
                            IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                tt = Float_Div(dang, span)
                            }
                            IfCondition EqualTo(Float_Le(tt, teps), 0) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(one, tt), teps), 0) ThenBlock: {
                                    IfCondition LessThan(nt, 500) ThenBlock: {
                                        ArraySet(ts, nt, tt)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                        }
                    }
                    pi = Add(pi, 1)
                }
            }
            // --- 1) EXACT lines x this arc ---
            nl = CAD_Sketch.GetLineCount(sketch_handle)
            lines = CAD_Store.Read(sketch_handle, 1)
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, dx, dy))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, eps)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        ht0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        ht1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            tline = ht0
                            IfCondition EqualTo(hi, 1) ThenBlock: { tline = ht1 }
                            ok = 1
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tline, Float_Sub(0, eps))), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Add(one, eps), tline)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, CAD_Num.Mul(tline, dx))
                                py = Float_Add(y0, CAD_Num.Mul(tline, dy))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                                IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                                    tt = 0
                                    IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                        tt = Float_Div(dang, span)
                                    }
                                    IfCondition EqualTo(Float_Le(tt, teps), 0) ThenBlock: {
                                        IfCondition EqualTo(Float_Le(Float_Sub(one, tt), teps), 0) ThenBlock: {
                                            IfCondition LessThan(nt, 500) ThenBlock: {
                                                ArraySet(ts, nt, tt)
                                                nt = Add(nt, 1)
                                            }
                                        }
                                    }
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                // exact tip-on-arc (endpoint on rim within merge tol)
                ei = 0
                WhileLoop LessThan(ei, 2) {
                    IfCondition EqualTo(ei, 0) ThenBlock: {
                        px = x0
                        py = y0
                    }
                    IfCondition EqualTo(ei, 1) ThenBlock: {
                        px = x1
                        py = y1
                    }
                    d = CAD_Num.Hypot2(Float_Sub(px, cx), Float_Sub(py, cy))
                    dd = CAD_Num.Abs(Float_Sub(d, rad))
                    IfCondition EqualTo(Float_Le(dd, jtol), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                        dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                        IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                            tt = 0
                            IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                tt = Float_Div(dang, span)
                            }
                            IfCondition EqualTo(Float_Le(tt, teps), 0) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(one, tt), teps), 0) ThenBlock: {
                                    IfCondition LessThan(nt, 500) ThenBlock: {
                                        ArraySet(ts, nt, tt)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                        }
                    }
                    ei = Add(ei, 1)
                }
                li = Add(li, 1)
            }
            // --- other arcs × this arc (circle-circle isect) ---
            na2 = CAD_Sketch.GetArcCount(sketch_handle)
            aj = 0
            WhileLoop LessThan(aj, na2) {
                IfCondition NotEqual(aj, best_idx) ThenBlock: {
                    ab = Multiply(aj, 5)
                    ocx = ArrayGet(arcs, ab)
                    ocy = ArrayGet(arcs, Add(ab, 1))
                    orad = ArrayGet(arcs, Add(ab, 2))
                    oa0 = ArrayGet(arcs, Add(ab, 3))
                    oa1 = ArrayGet(arcs, Add(ab, 4))
                    ospan = CAD_Num.PosMod2Pi(Float_Sub(oa1, oa0))
                    dcc = CAD_Num.Hypot2(Float_Sub(ocx, cx), Float_Sub(ocy, cy))
                    dccx = Float_Sub(ocx, cx)
                    dccy = Float_Sub(ocy, cy)
                    IfCondition EqualTo(CAD_Num.IsZero(dcc, 0), 1) ThenBlock: {
                        ek = 0
                        WhileLoop LessThan(ek, 2) {
                            oang = oa0
                            IfCondition EqualTo(ek, 1) ThenBlock: { oang = oa1 }
                            dang = CAD_Num.PosMod2Pi(Float_Sub(oang, a0))
                            IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                                tt = 0
                                IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                    tt = Float_Div(dang, span)
                                }
                                IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                                        IfCondition LessThan(nt, 500) ThenBlock: {
                                            ArraySet(ts, nt, tt)
                                            nt = Add(nt, 1)
                                        }
                                    }
                                }
                            }
                            ek = Add(ek, 1)
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsZero(dcc, 0), 0) ThenBlock: {
                        rsum = Float_Add(rad, orad)
                        rdiff = CAD_Num.Abs(Float_Sub(rad, orad))
                        okcc = 1
                        IfCondition EqualTo(Float_Le(dcc, rdiff), 1) ThenBlock: { okcc = 0 }
                        IfCondition EqualTo(Float_Le(rsum, dcc), 1) ThenBlock: { okcc = 0 }
                        IfCondition EqualTo(okcc, 1) ThenBlock: {
                            a = Float_Div(Float_Add(Float_Sub(CAD_Num.Sq(rad), CAD_Num.Sq(orad)), CAD_Num.Sq(dcc)), Float_Mul(0x4000000000000000, dcc))
                            h2 = Float_Sub(CAD_Num.Sq(rad), CAD_Num.Sq(a))
                            IfCondition EqualTo(CAD_Num.IsNeg(h2), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(CAD_Num.Abs(h2), 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                                    h2 = 0
                                }
                            }
                            IfCondition EqualTo(CAD_Num.IsNeg(h2), 0) ThenBlock: {
                                h = CAD_Num.Sqrt(h2)
                                mx = Float_Add(cx, Float_Mul(a, Float_Div(dccx, dcc)))
                                my = Float_Add(cy, Float_Mul(a, Float_Div(dccy, dcc)))
                                pxu = Float_Div(Float_Sub(0, dccy), dcc)
                                pyu = Float_Div(dccx, dcc)
                                pi = 0
                                WhileLoop LessThan(pi, 2) {
                                    sg = one
                                    IfCondition EqualTo(pi, 1) ThenBlock: { sg = Float_Sub(0, one) }
                                    ix = Float_Add(mx, Float_Mul(Float_Mul(sg, h), pxu))
                                    iy = Float_Add(my, Float_Mul(Float_Mul(sg, h), pyu))
                                    ang = CAD_Geom.Atan2(Float_Sub(iy, cy), Float_Sub(ix, cx))
                                    dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                                    on1 = 0
                                    IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: { on1 = 1 }
                                    oang = CAD_Geom.Atan2(Float_Sub(iy, ocy), Float_Sub(ix, ocx))
                                    odang = CAD_Num.PosMod2Pi(Float_Sub(oang, oa0))
                                    on2 = 0
                                    IfCondition EqualTo(Float_Le(odang, Float_Add(ospan, eps)), 1) ThenBlock: { on2 = 1 }
                                    IfCondition EqualTo(on1, 1) ThenBlock: {
                                        IfCondition EqualTo(on2, 1) ThenBlock: {
                                            tt = 0
                                            IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                                tt = Float_Div(dang, span)
                                            }
                                            IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                                                IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                                                    IfCondition LessThan(nt, 500) ThenBlock: {
                                                        ArraySet(ts, nt, tt)
                                                        nt = Add(nt, 1)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    pi = Add(pi, 1)
                                }
                            }
                        }
                    }
                }
                aj = Add(aj, 1)
            }
            // --- full circles × this arc ---
            nc = CAD_Sketch.GetCircleCount(sketch_handle)
            circs = CAD_Store.Read(sketch_handle, 8)
            ci = 0
            WhileLoop LessThan(ci, nc) {
                cb = Multiply(ci, 3)
                ocx = ArrayGet(circs, cb)
                ocy = ArrayGet(circs, Add(cb, 1))
                orad = ArrayGet(circs, Add(cb, 2))
                dccx = Float_Sub(ocx, cx)
                dccy = Float_Sub(ocy, cy)
                dcc = CAD_Num.Hypot2(dccx, dccy)
                IfCondition EqualTo(CAD_Num.IsZero(dcc, 0), 0) ThenBlock: {
                    rsum = Float_Add(rad, orad)
                    rdiff = CAD_Num.Abs(Float_Sub(rad, orad))
                    okcc = 1
                    IfCondition EqualTo(Float_Le(dcc, rdiff), 1) ThenBlock: { okcc = 0 }
                    IfCondition EqualTo(Float_Le(rsum, dcc), 1) ThenBlock: { okcc = 0 }
                    IfCondition EqualTo(okcc, 1) ThenBlock: {
                        a = Float_Div(Float_Add(Float_Sub(CAD_Num.Sq(rad), CAD_Num.Sq(orad)), CAD_Num.Sq(dcc)), Float_Mul(0x4000000000000000, dcc))
                        h2 = Float_Sub(CAD_Num.Sq(rad), CAD_Num.Sq(a))
                        IfCondition EqualTo(CAD_Num.IsNeg(h2), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(CAD_Num.Abs(h2), 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                                h2 = 0
                            }
                        }
                        IfCondition EqualTo(CAD_Num.IsNeg(h2), 0) ThenBlock: {
                            h = CAD_Num.Sqrt(h2)
                            mx = Float_Add(cx, Float_Mul(a, Float_Div(dccx, dcc)))
                            my = Float_Add(cy, Float_Mul(a, Float_Div(dccy, dcc)))
                            pxu = Float_Div(Float_Sub(0, dccy), dcc)
                            pyu = Float_Div(dccx, dcc)
                            pi = 0
                            WhileLoop LessThan(pi, 2) {
                                sg = one
                                IfCondition EqualTo(pi, 1) ThenBlock: { sg = Float_Sub(0, one) }
                                ix = Float_Add(mx, Float_Mul(Float_Mul(sg, h), pxu))
                                iy = Float_Add(my, Float_Mul(Float_Mul(sg, h), pyu))
                                ang = CAD_Geom.Atan2(Float_Sub(iy, cy), Float_Sub(ix, cx))
                                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                                IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                                    tt = 0
                                    IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                        tt = Float_Div(dang, span)
                                    }
                                    IfCondition EqualTo(Float_Le(tt, eps), 0) ThenBlock: {
                                        IfCondition EqualTo(Float_Le(Float_Sub(one, tt), eps), 0) ThenBlock: {
                                            IfCondition LessThan(nt, 500) ThenBlock: {
                                                ArraySet(ts, nt, tt)
                                                nt = Add(nt, 1)
                                            }
                                        }
                                    }
                                }
                                pi = Add(pi, 1)
                            }
                        }
                    }
                }
                ci = Add(ci, 1)
            }
            // sort t
            a = 0
            WhileLoop LessThan(a, nt) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nt) {
                    va = ArrayGet(ts, a)
                    vb = ArrayGet(ts, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(ts, a, vb)
                        ArraySet(ts, bb, va)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // merge near-duplicate t (false freehand doubles → tiny pieces / overcut)
            IfCondition GreaterThan(nt, 2) ThenBlock: {
                w = 1
                r = 1
                WhileLoop LessThan(r, nt) {
                    va = ArrayGet(ts, Subtract(w, 1))
                    vb = ArrayGet(ts, r)
                    dtm = Float_Sub(vb, va)
                    IfCondition EqualTo(CAD_Num.IsNeg(dtm), 1) ThenBlock: {
                        dtm = Float_Sub(0, dtm)
                    }
                    IfCondition EqualTo(Float_Le(dtm, 0x3F847AE147AE147B), 0) ThenBlock: {
                        ArraySet(ts, w, vb)
                        w = Add(w, 1)
                    }
                    r = Add(r, 1)
                }
                nt = w
            }
            // no interior mid-joins: do NOT delete nearby lines (that was the
            // random trim-cut regression). Only tip-to-tip delete if click is
            // near an arc endpoint; otherwise miss so geometry stays intact.
            IfCondition LessThan(nt, 3) ThenBlock: {
                Deallocate(ts, 512)
                ex0 = Float_Add(cx, CAD_Num.Mul(rad, CAD_Geom.Cos(a0)))
                ey0 = Float_Add(cy, CAD_Num.Mul(rad, CAD_Geom.Sin(a0)))
                ex1 = Float_Add(cx, CAD_Num.Mul(rad, CAD_Geom.Cos(a1)))
                ey1 = Float_Add(cy, CAD_Num.Mul(rad, CAD_Geom.Sin(a1)))
                dtip0 = CAD_Num.Hypot2(Float_Sub(wx, ex0), Float_Sub(wy, ey0))
                dtip1 = CAD_Num.Hypot2(Float_Sub(wx, ex1), Float_Sub(wy, ey1))
                near_tip = 0
                IfCondition EqualTo(Float_Le(dtip0, hit_lim), 1) ThenBlock: { near_tip = 1 }
                IfCondition EqualTo(Float_Le(dtip1, hit_lim), 1) ThenBlock: { near_tip = 1 }
                IfCondition EqualTo(near_tip, 1) ThenBlock: {
                    CAD_Sketch.DeleteArc(sketch_handle, best_idx)
                    CAD_Sketch.RebuildAnchors(sketch_handle)
                    ReturnValue(5)
                }
                ReturnValue(0)
            }
            // click param on arc (PosMod2Pi — Float_Le(neg,0) broken)
            dang = CAD_Num.PosMod2Pi(Float_Sub(click_ang, a0))
            click_t = 0
            IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                click_t = Float_Div(dang, span)
            }
            // emit kept sub-arcs, delete original
            CAD_Sketch.DeleteArc(sketch_handle, best_idx)
            prev = ArrayGet(ts, 0)
            k = 1
            nkeep = 0
            WhileLoop LessThan(k, nt) {
                cur = ArrayGet(ts, k)
                dt = Float_Sub(cur, prev)
                IfCondition EqualTo(Float_Le(dt, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
                    keep = 1
                    IfCondition EqualTo(Float_Le(prev, click_t), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(click_t, cur), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(click_t, prev), eps), 0) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(cur, click_t), eps), 0) ThenBlock: {
                                    keep = 0
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(keep, 1) ThenBlock: {
                        ang0 = Float_Add(a0, Float_Mul(span, prev))
                        ang1 = Float_Add(a0, Float_Mul(span, cur))
                        CAD_Sketch.AddArc(sketch_handle, cx, cy, rad, ang0, ang1)
                        nkeep = Add(nkeep, 1)
                    }
                    prev = cur
                }
                k = Add(k, 1)
            }
            Deallocate(ts, 512)
            // safety: if nothing kept (bug), restore original
            IfCondition EqualTo(nkeep, 0) ThenBlock: {
                CAD_Sketch.AddArc(sketch_handle, cx, cy, rad, a0, a1)
                // status 8: restored original arc
            }
            // exact joins already in anchors; split only lines that need it later
            CAD_Sketch.RebuildAnchors(sketch_handle)
            IfCondition EqualTo(nkeep, 0) ThenBlock: { ReturnValue(8) }
            ReturnValue(4)
        }

        ReturnValue(0)
    }
}

