LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Sketch.AddConstraint {
    Input: sketch_handle: Integer
    Input: ctype: Integer
    Input: target_kind: Integer
    Input: target_id: Integer
    Input: value_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        n = CAD_Store.Read(sketch_handle, 20)
        cap = CAD_Store.Read(sketch_handle, 22)
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(-1) }
        base = Multiply(n, 8)
        ArraySet(cstr, base, ctype)
        ArraySet(cstr, Add(base, 1), target_kind)
        ArraySet(cstr, Add(base, 2), target_id)
        ArraySet(cstr, Add(base, 3), value_r)
        ArraySet(cstr, Add(base, 4), 0)
        ArraySet(cstr, Add(base, 5), 0)
        ArraySet(cstr, Add(base, 6), 0)
        ArraySet(cstr, Add(base, 7), 0)
        CAD_Store.Write(sketch_handle, 20, Add(n, 1))
        CAD_Sketch_State.constraint_count = Add(CAD_Sketch_State.constraint_count, 1)
        ReturnValue(n)
    }
}

// Set float value for constraint index (dims, DistPoints, Radius via pair API).


// Set float value for constraint index (dims, DistPoints, Radius via pair API).
Function.CAD_Sketch.SetConstraintValue {
    Input: sketch_handle: Integer
    Input: cid: Integer
    Input: value_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_Store.Read(sketch_handle, 20)
        IfCondition GreaterEqual(cid, n) ThenBlock: { ReturnValue(-1) }
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(-1) }
        ArraySet(cstr, Add(Multiply(cid, 8), 3), value_r)
        ReturnValue(0)
    }
}

// Stage value for next AddConstraint2 (prefer SetConstraintValue after add for dims).


// Stage value for next AddConstraint2 (prefer SetConstraintValue after add for dims).
Function.CAD_Sketch.PendConstraintValue {
    Input: value_r: Integer
    Output: Integer
    Body: {
        CAD_Sketch_State.pend_value = value_r
        ReturnValue(0)
    }
}

// Dual-target constraint (coincident, tangent, dist, …).
// Value: uses pend_value then clears it (set via PendConstraintValue first),
// or call SetConstraintValue(cid, v) after. Avoids 7-arg clobber.


// Dual-target constraint (coincident, tangent, dist, …).
// Value: uses pend_value then clears it (set via PendConstraintValue first),
// or call SetConstraintValue(cid, v) after. Avoids 7-arg clobber.
Function.CAD_Sketch.AddConstraint2 {
    Input: sketch_handle: Integer
    Input: ctype: Integer
    Input: kind_a: Integer
    Input: id_a: Integer
    Input: kind_b: Integer
    Input: id_b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        n = CAD_Store.Read(sketch_handle, 20)
        cap = CAD_Store.Read(sketch_handle, 22)
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(n, cap) ThenBlock: { ReturnValue(-1) }
        ct = ctype
        ka = kind_a
        ia = id_a
        kb = kind_b
        ib = id_b
        vv = CAD_Sketch_State.pend_value
        CAD_Sketch_State.pend_value = 0
        base = Multiply(n, 8)
        ArraySet(cstr, base, ct)
        ArraySet(cstr, Add(base, 1), ka)
        ArraySet(cstr, Add(base, 2), ia)
        ArraySet(cstr, Add(base, 3), vv)
        ArraySet(cstr, Add(base, 4), 0)
        ArraySet(cstr, Add(base, 5), kb)
        ArraySet(cstr, Add(base, 6), ib)
        ArraySet(cstr, Add(base, 7), 0)
        CAD_Store.Write(sketch_handle, 20, Add(n, 1))
        CAD_Sketch_State.constraint_count = Add(CAD_Sketch_State.constraint_count, 1)
        ReturnValue(n)
    }
}

// Snap (wx,wy) to sketch datum. Priority: origin > +X axis > +Y axis.
// Writes out_xy. Returns 0=none 1=origin 2=axisX 3=axisY.
// tol_r = world distance; if 0 uses 0.5 mm default.


// Snap (wx,wy) to sketch datum. Priority: origin > +X axis > +Y axis.
// Writes out_xy. Returns 0=none 1=origin 2=axisX 3=axisY.
// tol_r = world distance; if 0 uses 0.5 mm default.
Function.CAD_Sketch.SnapToDatum {
    Input: sketch_handle: Integer
    Input: wx: Integer
    Input: wy: Integer
    Input: tol_r: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        ArraySet(out_xy, 0, wx)
        ArraySet(out_xy, 1, wy)
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        tol = tol_r
        IfCondition EqualTo(tol, 0) ThenBlock: {
            // 0.5 mm default
            tol = 0x3FE0000000000000
        }
        // 1) origin
        d2o = Float_Add(Float_Mul(wx, wx), Float_Mul(wy, wy))
        tol2 = Float_Mul(tol, tol)
        IfCondition EqualTo(Float_Le(d2o, tol2), 1) ThenBlock: {
            ArraySet(out_xy, 0, 0)
            ArraySet(out_xy, 1, 0)
            ReturnValue(1)
        }
        // 2) axis X (y → 0), keep x
        ay = wy
        IfCondition EqualTo(Float_Le(ay, 0), 1) ThenBlock: { ay = Float_Sub(0, ay) }
        IfCondition EqualTo(Float_Le(ay, tol), 1) ThenBlock: {
            ArraySet(out_xy, 0, wx)
            ArraySet(out_xy, 1, 0)
            ReturnValue(2)
        }
        // 3) axis Y (x → 0), keep y
        ax = wx
        IfCondition EqualTo(Float_Le(ax, 0), 1) ThenBlock: { ax = Float_Sub(0, ax) }
        IfCondition EqualTo(Float_Le(ax, tol), 1) ThenBlock: {
            ArraySet(out_xy, 0, 0)
            ArraySet(out_xy, 1, wy)
            ReturnValue(3)
        }
        ReturnValue(0)
    }
}

// Move the nearer line end onto (tx, ty) when that end is strictly closer
// and within 2*rad. A mid-span touch (ends equidistant) stays put.
Function.CAD_Sketch.JoinNearEnd {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: tx: Integer
    Input: ty: Integer
    Input: rad: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        li = line_i
        px = tx
        py = ty
        rr = rad
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        nl = CAD_Store.Read(h, 0)
        IfCondition GreaterEqual(li, nl) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(h, 1)
        b = Multiply(li, 4)
        x0 = ArrayGet(lines, b)
        y0 = ArrayGet(lines, Add(b, 1))
        x1 = ArrayGet(lines, Add(b, 2))
        y1 = ArrayGet(lines, Add(b, 3))
        d0 = Float_Add(Float_Mul(Float_Sub(px, x0), Float_Sub(px, x0)), Float_Mul(Float_Sub(py, y0), Float_Sub(py, y0)))
        d1 = Float_Add(Float_Mul(Float_Sub(px, x1), Float_Sub(px, x1)), Float_Mul(Float_Sub(py, y1), Float_Sub(py, y1)))
        lim = Float_Mul(Float_Mul(rr, rr), 0x4010000000000000)
        near = -1
        IfCondition EqualTo(Float_Le(d0, d1), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(d1, d0), 0) ThenBlock: { near = 0 }
        }
        IfCondition EqualTo(Float_Le(d1, d0), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(d0, d1), 0) ThenBlock: { near = 1 }
        }
        IfCondition LessThan(near, 0) ThenBlock: { ReturnValue(0) }
        dn = d0
        IfCondition EqualTo(near, 1) ThenBlock: { dn = d1 }
        IfCondition EqualTo(Float_Le(dn, lim), 0) ThenBlock: { ReturnValue(0) }
        tiny = 0x3F50624DD2F1A9FC
        tiny2 = Float_Mul(tiny, tiny)
        IfCondition EqualTo(Float_Le(dn, tiny2), 1) ThenBlock: { ReturnValue(0) }
        CAD_Sketch.SetLineEnd(h, li, near, px, py)
        ReturnValue(1)
    }
}

// One line + arc: seat the nearer arc end on the line, perpendicular.
// Radius changes so the other end stays where it is.
Function.CAD_Sketch.SeatArcEnd {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: arc_i: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        li = line_i
        ai = arc_i
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        nl = CAD_Store.Read(h, 0)
        IfCondition GreaterEqual(li, nl) ThenBlock: { ReturnValue(0) }
        na = CAD_Store.Read(h, 10)
        IfCondition GreaterEqual(ai, na) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(h, 1)
        b = Multiply(li, 4)
        x0 = ArrayGet(lines, b)
        y0 = ArrayGet(lines, Add(b, 1))
        x1 = ArrayGet(lines, Add(b, 2))
        y1 = ArrayGet(lines, Add(b, 3))
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        len2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(len2, 0), 1) ThenBlock: { ReturnValue(0) }
        llen = CAD_Num.Sqrt(len2)
        arcs = CAD_Store.Read(h, 11)
        ab = Multiply(ai, 5)
        cx = ArrayGet(arcs, ab)
        cy = ArrayGet(arcs, Add(ab, 1))
        rad = ArrayGet(arcs, Add(ab, 2))
        a0 = ArrayGet(arcs, Add(ab, 3))
        a1 = ArrayGet(arcs, Add(ab, 4))
        e0x = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0)))
        e0y = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0)))
        e1x = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1)))
        e1y = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1)))
        c0 = Float_Sub(Float_Mul(Float_Sub(e0x, x0), dy), Float_Mul(Float_Sub(e0y, y0), dx))
        c1 = Float_Sub(Float_Mul(Float_Sub(e1x, x0), dy), Float_Mul(Float_Sub(e1y, y0), dx))
        d0 = Float_Mul(c0, c0)
        d1 = Float_Mul(c1, c1)
        use0 = 1
        IfCondition EqualTo(Float_Le(d1, d0), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(d0, d1), 0) ThenBlock: { use0 = 0 }
        }
        ex = e0x
        ey = e0y
        fx = e1x
        fy = e1y
        IfCondition EqualTo(use0, 0) ThenBlock: {
            ex = e1x
            ey = e1y
            fx = e0x
            fy = e0y
        }
        t = Float_Div(Float_Add(Float_Mul(Float_Sub(ex, x0), dx), Float_Mul(Float_Sub(ey, y0), dy)), len2)
        tx = Float_Add(x0, Float_Mul(t, dx))
        ty = Float_Add(y0, Float_Mul(t, dy))
        nx = Float_Div(Float_Sub(0, dy), llen)
        ny = Float_Div(dx, llen)
        sd = Float_Add(Float_Mul(Float_Sub(fx, tx), nx), Float_Mul(Float_Sub(fy, ty), ny))
        IfCondition EqualTo(Float_Le(sd, 0), 1) ThenBlock: {
            nx = Float_Sub(0, nx)
            ny = Float_Sub(0, ny)
            sd = Float_Sub(0, sd)
        }
        rmin = 0x3FA999999999999A
        ok = 0
        IfCondition EqualTo(CAD_Num.IsZero(sd, 0), 0) ThenBlock: {
            ft2 = Float_Add(Float_Mul(Float_Sub(fx, tx), Float_Sub(fx, tx)), Float_Mul(Float_Sub(fy, ty), Float_Sub(fy, ty)))
            rr = Float_Div(ft2, Float_Mul(sd, 0x4000000000000000))
            IfCondition EqualTo(Float_Le(rr, rmin), 0) ThenBlock: {
                ncx = Float_Add(tx, Float_Mul(rr, nx))
                ncy = Float_Add(ty, Float_Mul(rr, ny))
                angT = CAD_Geom.Atan2(Float_Sub(ty, ncy), Float_Sub(tx, ncx))
                angF = CAD_Geom.Atan2(Float_Sub(fy, ncy), Float_Sub(fx, ncx))
                span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
                dang = CAD_Num.PosMod2Pi(Float_Sub(angF, angT))
                pi = 0x400921FB54442D18
                two = 0x401921FB54442D18
                maj_s = 0
                maj_d = 0
                IfCondition EqualTo(Float_Le(pi, span), 1) ThenBlock: { maj_s = 1 }
                IfCondition EqualTo(Float_Le(pi, dang), 1) ThenBlock: { maj_d = 1 }
                na0 = angT
                na1 = Float_Add(angT, dang)
                IfCondition NotEqual(maj_s, maj_d) ThenBlock: {
                    na0 = angF
                    na1 = Float_Add(angF, Float_Sub(two, dang))
                }
                ArraySet(arcs, ab, ncx)
                ArraySet(arcs, Add(ab, 1), ncy)
                ArraySet(arcs, Add(ab, 2), rr)
                ArraySet(arcs, Add(ab, 3), na0)
                ArraySet(arcs, Add(ab, 4), na1)
                CAD_Sketch.JoinNearEnd(h, li, tx, ty, rr)
                ok = 1
            }
        }
        IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(1) }
        nxn = Float_Div(Float_Sub(0, dy), llen)
        nyn = Float_Div(dx, llen)
        sdc = Float_Add(Float_Mul(Float_Sub(cx, x0), nxn), Float_Mul(Float_Sub(cy, y0), nyn))
        tgt = rad
        IfCondition EqualTo(Float_Le(sdc, 0), 1) ThenBlock: { tgt = Float_Sub(0, rad) }
        delta = Float_Sub(sdc, tgt)
        ncx = Float_Sub(cx, Float_Mul(delta, nxn))
        ncy = Float_Sub(cy, Float_Mul(delta, nyn))
        footx = Float_Sub(ncx, Float_Mul(tgt, nxn))
        footy = Float_Sub(ncy, Float_Mul(tgt, nyn))
        angT = CAD_Geom.Atan2(Float_Sub(footy, ncy), Float_Sub(footx, ncx))
        span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
        na0 = angT
        na1 = Float_Add(angT, span)
        IfCondition EqualTo(use0, 0) ThenBlock: {
            na0 = a0
            na1 = Float_Add(a0, span)
            na1 = angT
            na0 = Float_Sub(angT, span)
        }
        ArraySet(arcs, ab, ncx)
        ArraySet(arcs, Add(ab, 1), ncy)
        ArraySet(arcs, Add(ab, 2), rad)
        ArraySet(arcs, Add(ab, 3), na0)
        ArraySet(arcs, Add(ab, 4), na1)
        CAD_Sketch.JoinNearEnd(h, li, footx, footy, rad)
        ReturnValue(1)
    }
}

// Two lines + one arc: fillet. Radius is solved so the arc still passes
// through its current midpoint. Both ends land on the lines, square to them.
Function.CAD_Sketch.FilletArcLines {
    Input: sketch_handle: Integer
    Input: line_a: Integer
    Input: line_b: Integer
    Input: arc_i: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        la = line_a
        lb = line_b
        ai = arc_i
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        nl = CAD_Store.Read(h, 0)
        IfCondition GreaterEqual(la, nl) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(lb, nl) ThenBlock: { ReturnValue(0) }
        na = CAD_Store.Read(h, 10)
        IfCondition GreaterEqual(ai, na) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(h, 1)
        ba = Multiply(la, 4)
        ax0 = ArrayGet(lines, ba)
        ay0 = ArrayGet(lines, Add(ba, 1))
        ax1 = ArrayGet(lines, Add(ba, 2))
        ay1 = ArrayGet(lines, Add(ba, 3))
        bb = Multiply(lb, 4)
        bx0 = ArrayGet(lines, bb)
        by0 = ArrayGet(lines, Add(bb, 1))
        bx1 = ArrayGet(lines, Add(bb, 2))
        by1 = ArrayGet(lines, Add(bb, 3))
        adx = Float_Sub(ax1, ax0)
        ady = Float_Sub(ay1, ay0)
        bdx = Float_Sub(bx1, bx0)
        bdy = Float_Sub(by1, by0)
        al2 = Float_Add(Float_Mul(adx, adx), Float_Mul(ady, ady))
        bl2 = Float_Add(Float_Mul(bdx, bdx), Float_Mul(bdy, bdy))
        IfCondition EqualTo(CAD_Num.IsZero(al2, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(bl2, 0), 1) ThenBlock: { ReturnValue(0) }
        alen = CAD_Num.Sqrt(al2)
        blen = CAD_Num.Sqrt(bl2)
        arcs = CAD_Store.Read(h, 11)
        ab = Multiply(ai, 5)
        cx = ArrayGet(arcs, ab)
        cy = ArrayGet(arcs, Add(ab, 1))
        rad = ArrayGet(arcs, Add(ab, 2))
        a0 = ArrayGet(arcs, Add(ab, 3))
        a1 = ArrayGet(arcs, Add(ab, 4))
        span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
        half = Float_Mul(span, 0x3FE0000000000000)
        mid = Float_Add(a0, half)
        mx = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(mid)))
        my = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(mid)))
        nax = Float_Div(Float_Sub(0, ady), alen)
        nay = Float_Div(adx, alen)
        sda = Float_Add(Float_Mul(Float_Sub(cx, ax0), nax), Float_Mul(Float_Sub(cy, ay0), nay))
        IfCondition EqualTo(Float_Le(sda, 0), 1) ThenBlock: {
            nax = Float_Sub(0, nax)
            nay = Float_Sub(0, nay)
        }
        nbx = Float_Div(Float_Sub(0, bdy), blen)
        nby = Float_Div(bdx, blen)
        sdb = Float_Add(Float_Mul(Float_Sub(cx, bx0), nbx), Float_Mul(Float_Sub(cy, by0), nby))
        IfCondition EqualTo(Float_Le(sdb, 0), 1) ThenBlock: {
            nbx = Float_Sub(0, nbx)
            nby = Float_Sub(0, nby)
        }
        det = Float_Sub(Float_Mul(nax, nby), Float_Mul(nay, nbx))
        IfCondition EqualTo(CAD_Num.IsZero(det, 0), 1) ThenBlock: {
            CAD_Sketch.SeatArcEnd(h, la, ai)
            CAD_Sketch.SeatArcEnd(h, lb, ai)
            ReturnValue(1)
        }
        rhsa = Float_Add(Float_Mul(ax0, nax), Float_Mul(ay0, nay))
        rhsb = Float_Add(Float_Mul(bx0, nbx), Float_Mul(by0, nby))
        vx = Float_Div(Float_Sub(nby, nay), det)
        vy = Float_Div(Float_Sub(nax, nbx), det)
        ox = Float_Div(Float_Sub(Float_Mul(rhsa, nby), Float_Mul(nay, rhsb)), det)
        oy = Float_Div(Float_Sub(Float_Mul(nax, rhsb), Float_Mul(rhsa, nbx)), det)
        wx = Float_Sub(mx, ox)
        wy = Float_Sub(my, oy)
        qa = Float_Sub(Float_Add(Float_Mul(vx, vx), Float_Mul(vy, vy)), 0x3FF0000000000000)
        qb = Float_Mul(Float_Sub(0, 0x4000000000000000), Float_Add(Float_Mul(wx, vx), Float_Mul(wy, vy)))
        qc = Float_Add(Float_Mul(wx, wx), Float_Mul(wy, wy))
        rr = rad
        IfCondition EqualTo(CAD_Num.IsZero(qa, 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(qb, 0), 0) ThenBlock: {
                rr = Float_Div(Float_Sub(0, qc), qb)
            }
        }
        IfCondition EqualTo(CAD_Num.IsZero(qa, 0), 0) ThenBlock: {
        disc = Float_Sub(Float_Mul(qb, qb), Float_Mul(Float_Mul(qa, qc), 0x4010000000000000))
        IfCondition EqualTo(Float_Le(0, disc), 1) ThenBlock: {
            sdsc = CAD_Num.Sqrt(disc)
            r1 = Float_Div(Float_Add(Float_Sub(0, qb), sdsc), Float_Mul(qa, 0x4000000000000000))
            r2 = Float_Div(Float_Sub(Float_Sub(0, qb), sdsc), Float_Mul(qa, 0x4000000000000000))
            rmin = 0x3FA999999999999A
            take = 0
            IfCondition EqualTo(Float_Le(r1, rmin), 0) ThenBlock: { take = 1 }
            IfCondition EqualTo(Float_Le(r2, rmin), 0) ThenBlock: {
                IfCondition EqualTo(take, 0) ThenBlock: { take = 2 }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    d1 = Float_Sub(r1, rad)
                    IfCondition EqualTo(Float_Le(d1, 0), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
                    d2 = Float_Sub(r2, rad)
                    IfCondition EqualTo(Float_Le(d2, 0), 1) ThenBlock: { d2 = Float_Sub(0, d2) }
                    IfCondition EqualTo(Float_Le(d2, d1), 1) ThenBlock: { take = 2 }
                }
            }
            IfCondition EqualTo(take, 1) ThenBlock: { rr = r1 }
            IfCondition EqualTo(take, 2) ThenBlock: { rr = r2 }
        }
        }
        IfCondition EqualTo(Float_Le(rr, 0x3FA999999999999A), 1) ThenBlock: { rr = rad }
        ncx = Float_Add(ox, Float_Mul(rr, vx))
        ncy = Float_Add(oy, Float_Mul(rr, vy))
        tax = Float_Sub(ncx, Float_Mul(rr, nax))
        tay = Float_Sub(ncy, Float_Mul(rr, nay))
        tbx = Float_Sub(ncx, Float_Mul(rr, nbx))
        tby = Float_Sub(ncy, Float_Mul(rr, nby))
        angA = CAD_Geom.Atan2(Float_Sub(tay, ncy), Float_Sub(tax, ncx))
        angB = CAD_Geom.Atan2(Float_Sub(tby, ncy), Float_Sub(tbx, ncx))
        dang = CAD_Num.PosMod2Pi(Float_Sub(angB, angA))
        mid = Float_Add(angA, Float_Mul(dang, 0x3FE0000000000000))
        p1x = Float_Add(ncx, Float_Mul(rr, CAD_Geom.Cos(mid)))
        p1y = Float_Add(ncy, Float_Mul(rr, CAD_Geom.Sin(mid)))
        p2x = Float_Sub(ncx, Float_Mul(rr, CAD_Geom.Cos(mid)))
        p2y = Float_Sub(ncy, Float_Mul(rr, CAD_Geom.Sin(mid)))
        dd1 = Float_Add(Float_Mul(Float_Sub(p1x, mx), Float_Sub(p1x, mx)), Float_Mul(Float_Sub(p1y, my), Float_Sub(p1y, my)))
        dd2 = Float_Add(Float_Mul(Float_Sub(p2x, mx), Float_Sub(p2x, mx)), Float_Mul(Float_Sub(p2y, my), Float_Sub(p2y, my)))
        two = 0x401921FB54442D18
        na0 = angA
        na1 = Float_Add(angA, dang)
        IfCondition EqualTo(Float_Le(dd2, dd1), 1) ThenBlock: {
            na0 = angB
            na1 = Float_Add(angB, Float_Sub(two, dang))
        }
        ArraySet(arcs, ab, ncx)
        ArraySet(arcs, Add(ab, 1), ncy)
        ArraySet(arcs, Add(ab, 2), rr)
        ArraySet(arcs, Add(ab, 3), na0)
        ArraySet(arcs, Add(ab, 4), na1)
        CAD_Sketch.JoinNearEnd(h, la, tax, tay, rr)
        CAD_Sketch.JoinNearEnd(h, lb, tbx, tby, rr)
        ReturnValue(1)
    }
}

// Arc tangency is endpoint tangency. Circles stay on the center slide.
Function.CAD_Sketch.SolveArcEnds {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        na = CAD_Store.Read(h, 10)
        IfCondition LessThan(na, 1) ThenBlock: { ReturnValue(0) }
        n = CAD_Store.Read(h, 20)
        cstr = CAD_Store.Read(h, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(0) }
        hits = 0
        ai = 0
        WhileLoop LessThan(ai, na) {
            l0 = -1
            l1 = -1
            ci = 0
            WhileLoop LessThan(ci, n) {
                base = Multiply(ci, 8)
                ctype = ArrayGet(cstr, base)
                IfCondition EqualTo(ctype, 13) ThenBlock: {
                    ka = ArrayGet(cstr, Add(base, 1))
                    kb = ArrayGet(cstr, Add(base, 5))
                    ib = ArrayGet(cstr, Add(base, 6))
                    IfCondition EqualTo(ka, 2) ThenBlock: {
                        IfCondition EqualTo(kb, 5) ThenBlock: {
                            IfCondition EqualTo(ib, ai) ThenBlock: {
                                ia = ArrayGet(cstr, Add(base, 2))
                                IfCondition LessThan(l0, 0) ThenBlock: { l0 = ia }
                                IfCondition GreaterEqual(l0, 0) ThenBlock: {
                                    IfCondition NotEqual(ia, l0) ThenBlock: {
                                        IfCondition LessThan(l1, 0) ThenBlock: { l1 = ia }
                                    }
                                }
                            }
                        }
                    }
                }
                ci = Add(ci, 1)
            }
            IfCondition GreaterEqual(l1, 0) ThenBlock: {
                hits = Add(hits, CAD_Sketch.FilletArcLines(h, l0, l1, ai))
            }
            IfCondition LessThan(l1, 0) ThenBlock: {
                IfCondition GreaterEqual(l0, 0) ThenBlock: {
                    hits = Add(hits, CAD_Sketch.SeatArcEnd(h, l0, ai))
                }
            }
            ai = Add(ai, 1)
        }
        ReturnValue(hits)
    }
}

// Multi-pass direct-projection constraint solver (absolute + relational).
// No full Jacobian yet — good enough for origin/H/V/coincident/radius/tangent.
// Returns total apply-hits across passes, or -1 on null.


// Multi-pass direct-projection constraint solver (absolute + relational).
// No full Jacobian yet — good enough for origin/H/V/coincident/radius/tangent.
// Returns total apply-hits across passes, or -1 on null.
Function.CAD_Sketch.SolveDatum {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Sketch.EnsureDatum(sketch_handle)
        n = CAD_Store.Read(sketch_handle, 20)
        cstr = CAD_Store.Read(sketch_handle, 21)
        IfCondition EqualTo(cstr, 0) ThenBlock: { ReturnValue(0) }
        xy = Allocate(32)
        xy2 = Allocate(32)
        applied = 0
        pass = 0
        WhileLoop LessThan(pass, 10) {
            applied = Add(applied, CAD_Sketch.SolveArcEnds(sketch_handle))
            i = 0
            WhileLoop LessThan(i, n) {
                base = Multiply(i, 8)
                ctype = ArrayGet(cstr, base)
                ka = ArrayGet(cstr, Add(base, 1))
                ia = ArrayGet(cstr, Add(base, 2))
                val = ArrayGet(cstr, Add(base, 3))
                kb = ArrayGet(cstr, Add(base, 5))
                ib = ArrayGet(cstr, Add(base, 6))
                // --- H / V on whole line ---
                IfCondition EqualTo(ctype, 7) ThenBlock: {
                    IfCondition EqualTo(ka, 2) ThenBlock: {
                        lines = CAD_Store.Read(sketch_handle, 1)
                        nl = CAD_Store.Read(sketch_handle, 0)
                        IfCondition LessThan(ia, nl) ThenBlock: {
                            b = Multiply(ia, 4)
                            y0 = ArrayGet(lines, Add(b, 1))
                            ArraySet(lines, Add(b, 3), y0)
                            applied = Add(applied, 1)
                        }
                    }
                }
                IfCondition EqualTo(ctype, 8) ThenBlock: {
                    IfCondition EqualTo(ka, 2) ThenBlock: {
                        lines = CAD_Store.Read(sketch_handle, 1)
                        nl = CAD_Store.Read(sketch_handle, 0)
                        IfCondition LessThan(ia, nl) ThenBlock: {
                            b = Multiply(ia, 4)
                            x0 = ArrayGet(lines, b)
                            ArraySet(lines, Add(b, 2), x0)
                            applied = Add(applied, 1)
                        }
                    }
                }
                // --- Absolute on point (kinds 0/1/3/4 as center) ---
                IfCondition LessThan(ctype, 7) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        px = ArrayGet(xy, 0)
                        py = ArrayGet(xy, 1)
                        nx = px
                        ny = py
                        IfCondition EqualTo(ctype, 1) ThenBlock: {
                            nx = 0
                            ny = 0
                        }
                        IfCondition EqualTo(ctype, 2) ThenBlock: { nx = val }
                        IfCondition EqualTo(ctype, 3) ThenBlock: { ny = val }
                        IfCondition EqualTo(ctype, 4) ThenBlock: { ny = 0 }
                        IfCondition EqualTo(ctype, 5) ThenBlock: { nx = 0 }
                        IfCondition EqualTo(ctype, 6) ThenBlock: {
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(px, px), Float_Mul(py, py)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                nx = val
                                ny = 0
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(val, d)
                                nx = Float_Mul(px, s)
                                ny = Float_Mul(py, s)
                            }
                        }
                        CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, nx, ny)
                        applied = Add(applied, 1)
                    }
                }
                // --- 9 Coincident: B ← A ---
                IfCondition EqualTo(ctype, 9) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, ArrayGet(xy, 0), ArrayGet(xy, 1)), 0) ThenBlock: {
                            applied = Add(applied, 1)
                        }
                    }
                }
                // --- 10 PointOnLine: A on infinite line B (kind 2 = line_i) ---
                IfCondition EqualTo(ctype, 10) ThenBlock: {
                    IfCondition EqualTo(kb, 2) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                            lines = CAD_Store.Read(sketch_handle, 1)
                            nl = CAD_Store.Read(sketch_handle, 0)
                            IfCondition LessThan(ib, nl) ThenBlock: {
                                b = Multiply(ib, 4)
                                x0 = ArrayGet(lines, b)
                                y0 = ArrayGet(lines, Add(b, 1))
                                x1 = ArrayGet(lines, Add(b, 2))
                                y1 = ArrayGet(lines, Add(b, 3))
                                dx = Float_Sub(x1, x0)
                                dy = Float_Sub(y1, y0)
                                aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                                    ax = ArrayGet(xy, 0)
                                    ay = ArrayGet(xy, 1)
                                    t = Float_Div(Float_Add(Float_Mul(Float_Sub(ax, x0), dx), Float_Mul(Float_Sub(ay, y0), dy)), aa)
                                    nx = Float_Add(x0, Float_Mul(t, dx))
                                    ny = Float_Add(y0, Float_Mul(t, dy))
                                    CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, nx, ny)
                                    applied = Add(applied, 1)
                                }
                            }
                        }
                    }
                }
                // --- 11 Radius: set circle radius (kind 1 or 4) ---
                IfCondition EqualTo(ctype, 11) ThenBlock: {
                    ci = ia
                    CAD_Sketch.SetCircleRadius(sketch_handle, ci, val)
                    applied = Add(applied, 1)
                }
                // --- 12 EqualRadius: r(B) = r(A) ---
                IfCondition EqualTo(ctype, 12) ThenBlock: {
                    ra = CAD_Sketch.GetCircleRadius(sketch_handle, ia)
                    CAD_Sketch.SetCircleRadius(sketch_handle, ib, ra)
                    applied = Add(applied, 1)
                }
                // --- 13 Tangent line–circle. Arcs are seated in SolveArcEnds. ---
                IfCondition EqualTo(ctype, 13) ThenBlock: {
                    // A = line (kind 2), B = circle (1 or 4). Kind 5 is an arc.
                    IfCondition EqualTo(ka, 2) ThenBlock: {
                        IfCondition NotEqual(kb, 5) ThenBlock: {
                        lines = CAD_Store.Read(sketch_handle, 1)
                        nl = CAD_Store.Read(sketch_handle, 0)
                        IfCondition LessThan(ia, nl) ThenBlock: {
                            IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy), 0) ThenBlock: {
                                b = Multiply(ia, 4)
                                x0 = ArrayGet(lines, b)
                                y0 = ArrayGet(lines, Add(b, 1))
                                x1 = ArrayGet(lines, Add(b, 2))
                                y1 = ArrayGet(lines, Add(b, 3))
                                dx = Float_Sub(x1, x0)
                                dy = Float_Sub(y1, y0)
                                llen = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                                IfCondition EqualTo(CAD_Num.IsZero(llen, 0), 0) ThenBlock: {
                                    // unit normal
                                    nxn = Float_Div(Float_Sub(0, dy), llen)
                                    nyn = Float_Div(dx, llen)
                                    cx = ArrayGet(xy, 0)
                                    cy = ArrayGet(xy, 1)
                                    ci = ib
                                    rad = CAD_Sketch.CurveRadius(sketch_handle, kb, ib)
                                    sd = Float_Add(Float_Mul(Float_Sub(cx, x0), nxn), Float_Mul(Float_Sub(cy, y0), nyn))
                                    // target signed dist = +r or -r matching side
                                    tgt = rad
                                    IfCondition EqualTo(Float_Le(sd, 0), 1) ThenBlock: {
                                        tgt = Float_Sub(0, rad)
                                    }
                                    delta = Float_Sub(sd, tgt)
                                    ncx = Float_Sub(cx, Float_Mul(delta, nxn))
                                    ncy = Float_Sub(cy, Float_Mul(delta, nyn))
                                    CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, ncx, ncy)
                                    applied = Add(applied, 1)
                                }
                            }
                        }
                        }
                    }
                }
                // --- 14 Tangent circle–circle (external): |c2-c1| = r1+r2 ---
                IfCondition EqualTo(ctype, 14) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy2), 0) ThenBlock: {
                            cx1 = ArrayGet(xy, 0)
                            cy1 = ArrayGet(xy, 1)
                            cx2 = ArrayGet(xy2, 0)
                            cy2 = ArrayGet(xy2, 1)
                            r1 = CAD_Sketch.CurveRadius(sketch_handle, ka, ia)
                            r2 = CAD_Sketch.CurveRadius(sketch_handle, kb, ib)
                            want = Float_Add(r1, r2)
                            dx = Float_Sub(cx2, cx1)
                            dy = Float_Sub(cy2, cy1)
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                // coincident centers — push B on +X
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, Float_Add(cx1, want), cy1)
                                applied = Add(applied, 1)
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(want, d)
                                ncx = Float_Add(cx1, Float_Mul(dx, s))
                                ncy = Float_Add(cy1, Float_Mul(dy, s))
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, ncx, ncy)
                                applied = Add(applied, 1)
                            }
                        }
                    }
                }
                // --- 15 DistPoints: |B-A| = val, move B ---
                IfCondition EqualTo(ctype, 15) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy2), 0) ThenBlock: {
                            ax = ArrayGet(xy, 0)
                            ay = ArrayGet(xy, 1)
                            bx = ArrayGet(xy2, 0)
                            by = ArrayGet(xy2, 1)
                            dx = Float_Sub(bx, ax)
                            dy = Float_Sub(by, ay)
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, Float_Add(ax, val), ay)
                                applied = Add(applied, 1)
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(val, d)
                                CAD_Sketch.SetTargetXY(sketch_handle, kb, ib, Float_Add(ax, Float_Mul(dx, s)), Float_Add(ay, Float_Mul(dy, s)))
                                applied = Add(applied, 1)
                            }
                        }
                    }
                }
                // --- 16 PointOnCircle: A on rim of B ---
                IfCondition EqualTo(ctype, 16) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, ka, ia, xy), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Sketch.GetTargetXY(sketch_handle, kb, ib, xy2), 0) ThenBlock: {
                            ax = ArrayGet(xy, 0)
                            ay = ArrayGet(xy, 1)
                            cx = ArrayGet(xy2, 0)
                            cy = ArrayGet(xy2, 1)
                            rad = CAD_Sketch.GetCircleRadius(sketch_handle, ib)
                            dx = Float_Sub(ax, cx)
                            dy = Float_Sub(ay, cy)
                            d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
                                CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, Float_Add(cx, rad), cy)
                                applied = Add(applied, 1)
                            }
                            IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                                s = Float_Div(rad, d)
                                CAD_Sketch.SetTargetXY(sketch_handle, ka, ia, Float_Add(cx, Float_Mul(dx, s)), Float_Add(cy, Float_Mul(dy, s)))
                                applied = Add(applied, 1)
                            }
                        }
                    }
                }
                i = Add(i, 1)
            }
            pass = Add(pass, 1)
        }
        Deallocate(xy, 32)
        Deallocate(xy2, 32)
        CAD_Sketch.RebuildAnchors(sketch_handle)
        CAD_Sketch_State.solved_dof = applied
        ReturnValue(applied)
    }
}

// Alias — full constraint solve (same multipass engine)


// Alias — full constraint solve (same multipass engine)
Function.CAD_Sketch.SolveConstraints {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.SolveDatum(sketch_handle))
    }
}

// Add or merge an anchor point. Does not move lines — only the point cloud.
// Returns point index (0-based) or -1.


// Add or merge an anchor point. Does not move lines — only the point cloud.
// Returns point index (0-based) or -1.
