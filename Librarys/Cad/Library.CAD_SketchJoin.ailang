LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

FixedPool.CAD_Sketch_Join {
    "sk":    Initialize=0, CanChange=True
    "lines": Initialize=0, CanChange=True
    "arcs":  Initialize=0, CanChange=True
    "circs": Initialize=0, CanChange=True
    "nl":    Initialize=0, CanChange=True
    "na":    Initialize=0, CanChange=True
    "nc":    Initialize=0, CanChange=True
    "i":     Initialize=0, CanChange=True
    "j":     Initialize=0, CanChange=True
    "mtol":  Initialize=0, CanChange=True
    // IsectLineCirc — Cos/Sin/Sqrt smash Integer locals; all hits live here.
    "x0": Initialize=0, CanChange=True
    "y0": Initialize=0, CanChange=True
    "x1": Initialize=0, CanChange=True
    "y1": Initialize=0, CanChange=True
    "cx": Initialize=0, CanChange=True
    "cy": Initialize=0, CanChange=True
    "r": Initialize=0, CanChange=True
    "dx": Initialize=0, CanChange=True
    "dy": Initialize=0, CanChange=True
    "aa": Initialize=0, CanChange=True
    "bb": Initialize=0, CanChange=True
    "cc": Initialize=0, CanChange=True
    "disc": Initialize=0, CanChange=True
    "s": Initialize=0, CanChange=True
    "t": Initialize=0, CanChange=True
    "t0": Initialize=0, CanChange=True
    "t1": Initialize=0, CanChange=True
    "px": Initialize=0, CanChange=True
    "py": Initialize=0, CanChange=True
    "ang": Initialize=0, CanChange=True
    "a0": Initialize=0, CanChange=True
    "a1": Initialize=0, CanChange=True
    "span": Initialize=0, CanChange=True
    "dang": Initialize=0, CanChange=True
    "nh": Initialize=0, CanChange=True
    "hi": Initialize=0, CanChange=True
    "ok": Initialize=0, CanChange=True
    "ht0": Initialize=0, CanChange=True
    "hx0": Initialize=0, CanChange=True
    "hy0": Initialize=0, CanChange=True
    "ha0": Initialize=0, CanChange=True
    "ht1": Initialize=0, CanChange=True
    "hx1": Initialize=0, CanChange=True
    "hy1": Initialize=0, CanChange=True
    "ha1": Initialize=0, CanChange=True
}

// Reload array pointers from the pinned sketch. Call after any nested fn.
Function.CAD_Sketch.JoinReload {
    Output: Integer
    Body: {
        CAD_Sketch_Join.lines = CAD_Store.Read(CAD_Sketch_Join.sk, 1)
        CAD_Sketch_Join.arcs = CAD_Store.Read(CAD_Sketch_Join.sk, 11)
        CAD_Sketch_Join.circs = CAD_Store.Read(CAD_Sketch_Join.sk, 8)
        ReturnValue(0)
    }
}

// AddPoint + reload pointers. 3rd arg ignored (mtol lives on the Join pool).
// Never pass a live sketch_handle across AddPoint.
Function.CAD_Sketch.JoinAddPt {
    Input: x_r: Integer
    Input: y_r: Integer
    Input: _tol: Integer
    Output: Integer
    Body: {
        CAD_Sketch.AddPoint(CAD_Sketch_Join.sk, x_r, y_r, CAD_Sketch_Join.mtol)
        CAD_Sketch.JoinReload()
        ReturnValue(0)
    }
}

// Line (x0,y0)-(x1,y1) × circle (cx,cy,r). Hits in ht/hx/hy/ha. t in [-0.02, 1.02].
// Vertex xy is the quadratic point (on the line AND the circle), not Cos(Atan2).
Function.CAD_Sketch.IsectLineCirc {
    Output: Integer
    Body: {
        CAD_Sketch_Join.nh = 0
        CAD_Sketch_Join.dx = Float_Sub(CAD_Sketch_Join.x1, CAD_Sketch_Join.x0)
        CAD_Sketch_Join.dy = Float_Sub(CAD_Sketch_Join.y1, CAD_Sketch_Join.y0)
        CAD_Sketch_Join.aa = Float_Add(CAD_Num.Sq(CAD_Sketch_Join.dx), CAD_Num.Sq(CAD_Sketch_Join.dy))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Sketch_Join.aa, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Sketch_Join.px = Float_Sub(CAD_Sketch_Join.x0, CAD_Sketch_Join.cx)
        CAD_Sketch_Join.py = Float_Sub(CAD_Sketch_Join.y0, CAD_Sketch_Join.cy)
        CAD_Sketch_Join.bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(CAD_Sketch_Join.px, CAD_Sketch_Join.py, CAD_Sketch_Join.dx, CAD_Sketch_Join.dy))
        CAD_Sketch_Join.cc = Float_Sub(Float_Add(CAD_Num.Sq(CAD_Sketch_Join.px), CAD_Num.Sq(CAD_Sketch_Join.py)), CAD_Num.Sq(CAD_Sketch_Join.r))
        CAD_Sketch_Join.disc = Float_Sub(CAD_Num.Sq(CAD_Sketch_Join.bb), CAD_Num.Mul(CAD_Num.Mul(0x4010000000000000, CAD_Sketch_Join.aa), CAD_Sketch_Join.cc))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Sketch_Join.disc), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(CAD_Num.Abs(CAD_Sketch_Join.disc), CAD_Num.Mul(CAD_Sketch_Join.aa, 0x3F50624DD2F1A9FC)), 1) ThenBlock: {
                CAD_Sketch_Join.disc = 0
            }
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Sketch_Join.disc), 1) ThenBlock: { ReturnValue(0) }
        CAD_Sketch_Join.s = CAD_Num.Sqrt(CAD_Sketch_Join.disc)
        CAD_Sketch_Join.t0 = Float_Div(Float_Sub(Float_Sub(0, CAD_Sketch_Join.bb), CAD_Sketch_Join.s), CAD_Num.Mul(0x4000000000000000, CAD_Sketch_Join.aa))
        CAD_Sketch_Join.t1 = Float_Div(Float_Add(Float_Sub(0, CAD_Sketch_Join.bb), CAD_Sketch_Join.s), CAD_Num.Mul(0x4000000000000000, CAD_Sketch_Join.aa))
        CAD_Sketch_Join.hi = 0
        WhileLoop LessThan(CAD_Sketch_Join.hi, 2) {
            CAD_Sketch_Join.t = CAD_Sketch_Join.t0
            IfCondition EqualTo(CAD_Sketch_Join.hi, 1) ThenBlock: { CAD_Sketch_Join.t = CAD_Sketch_Join.t1 }
            CAD_Sketch_Join.ok = 1
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(CAD_Sketch_Join.t, 0x3F947AE147AE147B)), 1) ThenBlock: { CAD_Sketch_Join.ok = 0 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0x3FF051EB851EB852, CAD_Sketch_Join.t)), 1) ThenBlock: { CAD_Sketch_Join.ok = 0 }
            IfCondition EqualTo(CAD_Sketch_Join.ok, 1) ThenBlock: {
                CAD_Sketch_Join.px = Float_Add(CAD_Sketch_Join.x0, CAD_Num.Mul(CAD_Sketch_Join.t, CAD_Sketch_Join.dx))
                CAD_Sketch_Join.py = Float_Add(CAD_Sketch_Join.y0, CAD_Num.Mul(CAD_Sketch_Join.t, CAD_Sketch_Join.dy))
                CAD_Sketch_Join.ang = CAD_Geom.Atan2(Float_Sub(CAD_Sketch_Join.py, CAD_Sketch_Join.cy), Float_Sub(CAD_Sketch_Join.px, CAD_Sketch_Join.cx))
                IfCondition EqualTo(CAD_Sketch_Join.nh, 0) ThenBlock: {
                    CAD_Sketch_Join.ht0 = CAD_Sketch_Join.t
                    CAD_Sketch_Join.hx0 = CAD_Sketch_Join.px
                    CAD_Sketch_Join.hy0 = CAD_Sketch_Join.py
                    CAD_Sketch_Join.ha0 = CAD_Sketch_Join.ang
                }
                IfCondition EqualTo(CAD_Sketch_Join.nh, 1) ThenBlock: {
                    CAD_Sketch_Join.ht1 = CAD_Sketch_Join.t
                    CAD_Sketch_Join.hx1 = CAD_Sketch_Join.px
                    CAD_Sketch_Join.hy1 = CAD_Sketch_Join.py
                    CAD_Sketch_Join.ha1 = CAD_Sketch_Join.ang
                }
                CAD_Sketch_Join.nh = Add(CAD_Sketch_Join.nh, 1)
            }
            CAD_Sketch_Join.hi = Add(CAD_Sketch_Join.hi, 1)
        }
        ReturnValue(CAD_Sketch_Join.nh)
    }
}

// 1 if Join.ang is on CCW arc [a0,a1] (or a full circle).
Function.CAD_Sketch.IsectOnArc {
    Output: Integer
    Body: {
        CAD_Sketch_Join.span = CAD_Num.PosMod2Pi(Float_Sub(CAD_Sketch_Join.a1, CAD_Sketch_Join.a0))
        CAD_Sketch_Join.dang = CAD_Num.PosMod2Pi(Float_Sub(CAD_Sketch_Join.ang, CAD_Sketch_Join.a0))
        IfCondition EqualTo(Float_Le(CAD_Sketch_Join.dang, Float_Add(CAD_Sketch_Join.span, 0x3FA999999999999A)), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Float_Le(Float_Sub(0x401921FB54442D18, CAD_Sketch_Join.dang), 0x3FA999999999999A), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Clear and rebuild anchors: every line end + every crossing + every T-touch.
// Does NOT alter line coordinates — only the anchor point list.
// Returns n_pts.
Function.CAD_Sketch.RebuildAnchors {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch_Join.sk = sketch_handle
        CAD_Store.Write(CAD_Sketch_Join.sk, 16, 0)
        CAD_Sketch_Join.nl = CAD_Store.Read(CAD_Sketch_Join.sk, 0)
        CAD_Sketch_Join.na = CAD_Store.Read(CAD_Sketch_Join.sk, 10)
        CAD_Sketch_Join.nc = CAD_Store.Read(CAD_Sketch_Join.sk, 7)
        // empty + 0/1 circle: no join anchors (do not reread clobbered sketch_handle)
        IfCondition EqualTo(CAD_Sketch_Join.nl, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Sketch_Join.na, 0) ThenBlock: {
                IfCondition LessThan(CAD_Sketch_Join.nc, 2) ThenBlock: {
                    ReturnValue(0)
                }
            }
        }
        CAD_Sketch.JoinReload()
        // fixed merge/coincidence eps (NOT sketch AABB % — killed)
        CAD_Sketch_Join.mtol = 0x3F50624DD2F1A9FC
        mtol = CAD_Sketch_Join.mtol
        mtol2 = Float_Mul(mtol, mtol)
        // 1) every line endpoint is an anchor
        CAD_Sketch_Join.i = 0
        WhileLoop LessThan(CAD_Sketch_Join.i, CAD_Sketch_Join.nl) {
            lines = CAD_Store.Read(CAD_Sketch_Join.sk, 1)
            b = Multiply(CAD_Sketch_Join.i, 4)
            CAD_Sketch.JoinAddPt(ArrayGet(lines, b), ArrayGet(lines, Add(b, 1)), 0)
            lines = CAD_Sketch_Join.lines
            b = Multiply(CAD_Sketch_Join.i, 4)
            CAD_Sketch.JoinAddPt(ArrayGet(lines, Add(b, 2)), ArrayGet(lines, Add(b, 3)), 0)
            CAD_Sketch_Join.i = Add(CAD_Sketch_Join.i, 1)
        }
        CAD_Sketch.JoinReload()
        lines = CAD_Sketch_Join.lines
        nl = CAD_Sketch_Join.nl
        // 2) arc endpoints
        na = CAD_Sketch_Join.na
        arcs = CAD_Sketch_Join.arcs
        CAD_Sketch_Join.i = 0
        WhileLoop LessThan(CAD_Sketch_Join.i, CAD_Sketch_Join.na) {
            arcs = CAD_Store.Read(CAD_Sketch_Join.sk, 11)
            base = Multiply(CAD_Sketch_Join.i, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            CAD_Sketch.JoinAddPt( Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0))), mtol)
            arcs = CAD_Sketch_Join.arcs
            base = Multiply(CAD_Sketch_Join.i, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            CAD_Sketch.JoinAddPt( Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1))), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1))), mtol)
            CAD_Sketch_Join.i = Add(CAD_Sketch_Join.i, 1)
        }
        // 3) proper crossings + T-touches between every pair of lines
        CAD_Sketch_Join.i = 0
        WhileLoop LessThan(CAD_Sketch_Join.i, CAD_Sketch_Join.nl) {
            lines = CAD_Store.Read(CAD_Sketch_Join.sk, 1)
            bi = Multiply(CAD_Sketch_Join.i, 4)
            ax0 = ArrayGet(lines, bi)
            ay0 = ArrayGet(lines, Add(bi, 1))
            ax1 = ArrayGet(lines, Add(bi, 2))
            ay1 = ArrayGet(lines, Add(bi, 3))
            adx = Float_Sub(ax1, ax0)
            ady = Float_Sub(ay1, ay0)
            alen2 = Float_Add(Float_Mul(adx, adx), Float_Mul(ady, ady))
            CAD_Sketch_Join.j = Add(CAD_Sketch_Join.i, 1)
            WhileLoop LessThan(CAD_Sketch_Join.j, CAD_Sketch_Join.nl) {
                lines = CAD_Store.Read(CAD_Sketch_Join.sk, 1)
                bj = Multiply(CAD_Sketch_Join.j, 4)
                bx0 = ArrayGet(lines, bj)
                by0 = ArrayGet(lines, Add(bj, 1))
                bx1 = ArrayGet(lines, Add(bj, 2))
                by1 = ArrayGet(lines, Add(bj, 3))
                bdx = Float_Sub(bx1, bx0)
                bdy = Float_Sub(by1, by0)
                den = Float_Sub(Float_Mul(adx, bdy), Float_Mul(ady, bdx))
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    t = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), bdy), Float_Mul(Float_Sub(by0, ay0), bdx)), den)
                    u = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), ady), Float_Mul(Float_Sub(by0, ay0), adx)), den)
                    one = 0x3FF0000000000000
                    ok_t = 1
                    ok_u = 1
                    IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(0, t), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok_t = 0 }
                    }
                    IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(t, one), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok_t = 0 }
                    }
                    IfCondition EqualTo(Float_Le(u, 0), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(0, u), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok_u = 0 }
                    }
                    IfCondition EqualTo(Float_Le(one, u), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(u, one), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok_u = 0 }
                    }
                    IfCondition EqualTo(ok_t, 1) ThenBlock: {
                        IfCondition EqualTo(ok_u, 1) ThenBlock: {
                            px = Float_Add(ax0, Float_Mul(t, adx))
                            py = Float_Add(ay0, Float_Mul(t, ady))
                            CAD_Sketch.JoinAddPt( px, py, mtol)
                        }
                    }
                }
                // T: endpoints of j near line i
                IfCondition EqualTo(CAD_Num.IsZero(alen2, 0), 0) ThenBlock: {
                    t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx0, ax0), adx), Float_Mul(Float_Sub(by0, ay0), ady)), alen2)
                    IfCondition EqualTo(Float_Le(t, 0), 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 0) ThenBlock: {
                            px = Float_Add(ax0, Float_Mul(t, adx))
                            py = Float_Add(ay0, Float_Mul(t, ady))
                            ddx = Float_Sub(px, bx0)
                            ddy = Float_Sub(py, by0)
                            IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                                CAD_Sketch.JoinAddPt( px, py, mtol)
                            }
                        }
                    }
                    t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx1, ax0), adx), Float_Mul(Float_Sub(by1, ay0), ady)), alen2)
                    IfCondition EqualTo(Float_Le(t, 0), 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(0x3FF0000000000000, t), 0) ThenBlock: {
                            px = Float_Add(ax0, Float_Mul(t, adx))
                            py = Float_Add(ay0, Float_Mul(t, ady))
                            ddx = Float_Sub(px, bx1)
                            ddy = Float_Sub(py, by1)
                            IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                                CAD_Sketch.JoinAddPt( px, py, mtol)
                            }
                        }
                    }
                }
                CAD_Sketch_Join.j = Add(CAD_Sketch_Join.j, 1)
            }
            CAD_Sketch_Join.i = Add(CAD_Sketch_Join.i, 1)
        }
        CAD_Sketch.JoinReload()
        lines = CAD_Sketch_Join.lines
        arcs = CAD_Sketch_Join.arcs
        circs = CAD_Sketch_Join.circs
        nl = CAD_Sketch_Join.nl
        na = CAD_Sketch_Join.na
        // 4) EXACT line × arc crossings from stored plane coords.
        // |P + t D - C|^2 = r^2 → quadratic in t. Accept t ∈ [0,1], angle on arc.
        // No freehand disc invent, no tip slack, no mid-chord near-miss, no rim-project.
        two_pi = 0x401921FB54442D18
        one = 0x3FF0000000000000
        epsa = 0x3F50624DD2F1A9FC
        ai = 0
        WhileLoop LessThan(ai, na) {
            arcs = CAD_Store.Read(CAD_Sketch_Join.sk, 11)
            base = Multiply(ai, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            li = 0
            WhileLoop LessThan(li, nl) {
                lines = CAD_Store.Read(CAD_Sketch_Join.sk, 1)
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, dx, dy))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    // numerical tangent only (not freehand invent)
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, epsa)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            ok = 1
                            // strict segment: t ∈ [0,1] (±eps)
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(t, Float_Sub(0, epsa))), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Add(one, epsa), t)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, CAD_Num.Mul(t, dx))
                                py = Float_Add(y0, CAD_Num.Mul(t, dy))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                                IfCondition EqualTo(Float_Le(dang, Float_Add(span, epsa)), 1) ThenBlock: {
                                    CAD_Sketch.JoinAddPt( px, py, mtol)
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                    // exact tip-on-arc: endpoint lies on the circle within mtol
                    ei = 0
                    WhileLoop LessThan(ei, 2) {
                        IfCondition EqualTo(ei, 0) ThenBlock: {
                            px = x0
                            py = y0
                        }
                        IfCondition EqualTo(ei, 1) ThenBlock: {
                            px = x1
                            py = y1
                        }
                        dnear = CAD_Num.Hypot2(Float_Sub(px, cx), Float_Sub(py, cy))
                        dd = CAD_Num.Abs(Float_Sub(dnear, rad))
                        IfCondition EqualTo(Float_Le(dd, mtol), 1) ThenBlock: {
                            ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                            dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                            IfCondition EqualTo(Float_Le(dang, Float_Add(span, epsa)), 1) ThenBlock: {
                                CAD_Sketch.JoinAddPt( px, py, mtol)
                            }
                        }
                        ei = Add(ei, 1)
                    }
                }
                li = Add(li, 1)
            }
            ai = Add(ai, 1)
        }
        // 4b) arc × arc crossings (anchors where freehand arcs meet)
        one = 0x3FF0000000000000
        ai = 0
        WhileLoop LessThan(ai, na) {
            base = Multiply(ai, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            aj = Add(ai, 1)
            WhileLoop LessThan(aj, na) {
                bj = Multiply(aj, 5)
                ocx = ArrayGet(arcs, bj)
                ocy = ArrayGet(arcs, Add(bj, 1))
                orad = ArrayGet(arcs, Add(bj, 2))
                oa0 = ArrayGet(arcs, Add(bj, 3))
                oa1 = ArrayGet(arcs, Add(bj, 4))
                ospan = CAD_Num.PosMod2Pi(Float_Sub(oa1, oa0))
                dccx = Float_Sub(ocx, cx)
                dccy = Float_Sub(ocy, cy)
                dcc = CAD_Num.Hypot2(dccx, dccy)
                IfCondition EqualTo(CAD_Num.IsZero(dcc, 0), 0) ThenBlock: {
                    rsum = Float_Add(rad, orad)
                    rdiff = CAD_Num.Abs(Float_Sub(rad, orad))
                    okcc = 1
                    IfCondition EqualTo(Float_Le(dcc, rdiff), 1) ThenBlock: { okcc = 0 }
                    IfCondition EqualTo(Float_Le(rsum, dcc), 1) ThenBlock: { okcc = 0 }
                    IfCondition EqualTo(okcc, 1) ThenBlock: {
                        a = Float_Div(Float_Add(Float_Sub(CAD_Num.Sq(rad), CAD_Num.Sq(orad)), CAD_Num.Sq(dcc)), Float_Mul(0x4000000000000000, dcc))
                        h2 = Float_Sub(CAD_Num.Sq(rad), CAD_Num.Sq(a))
                        IfCondition EqualTo(CAD_Num.IsNeg(h2), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(CAD_Num.Abs(h2), 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                                h2 = 0
                            }
                        }
                        IfCondition EqualTo(CAD_Num.IsNeg(h2), 0) ThenBlock: {
                            h = CAD_Num.Sqrt(h2)
                            mx = Float_Add(cx, CAD_Num.Mul(a, Float_Div(dccx, dcc)))
                            my = Float_Add(cy, CAD_Num.Mul(a, Float_Div(dccy, dcc)))
                            pxu = Float_Div(Float_Sub(0, dccy), dcc)
                            pyu = Float_Div(dccx, dcc)
                            pi = 0
                            WhileLoop LessThan(pi, 2) {
                                sg = one
                                IfCondition EqualTo(pi, 1) ThenBlock: { sg = Float_Sub(0, one) }
                                ix = Float_Add(mx, CAD_Num.Mul(CAD_Num.Mul(sg, h), pxu))
                                iy = Float_Add(my, CAD_Num.Mul(CAD_Num.Mul(sg, h), pyu))
                                ang = CAD_Geom.Atan2(Float_Sub(iy, cy), Float_Sub(ix, cx))
                                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                                on1 = 0
                                IfCondition EqualTo(Float_Le(dang, Float_Add(span, 0x3F50624DD2F1A9FC)), 1) ThenBlock: { on1 = 1 }
                                oang = CAD_Geom.Atan2(Float_Sub(iy, ocy), Float_Sub(ix, ocx))
                                odang = CAD_Num.PosMod2Pi(Float_Sub(oang, oa0))
                                on2 = 0
                                IfCondition EqualTo(Float_Le(odang, Float_Add(ospan, 0x3F50624DD2F1A9FC)), 1) ThenBlock: { on2 = 1 }
                                IfCondition EqualTo(on1, 1) ThenBlock: {
                                    IfCondition EqualTo(on2, 1) ThenBlock: {
                                        CAD_Sketch.JoinAddPt( ix, iy, mtol)
                                    }
                                }
                                pi = Add(pi, 1)
                            }
                        }
                    }
                }
                aj = Add(aj, 1)
            }
            ai = Add(ai, 1)
        }
        // 5) line × full circle — pool isect (Sqrt in Trim/Join locals was the miss)
        CAD_Sketch_Join.nc = CAD_Store.Read(CAD_Sketch_Join.sk, 7)
        CAD_Sketch_Join.nl = CAD_Store.Read(CAD_Sketch_Join.sk, 0)
        CAD_Sketch_Join.i = 0
        WhileLoop LessThan(CAD_Sketch_Join.i, CAD_Sketch_Join.nc) {
            CAD_Sketch_Join.circs = CAD_Store.Read(CAD_Sketch_Join.sk, 8)
            CAD_Sketch_Join.ok = Multiply(CAD_Sketch_Join.i, 3)
            CAD_Sketch_Join.cx = ArrayGet(CAD_Sketch_Join.circs, CAD_Sketch_Join.ok)
            CAD_Sketch_Join.cy = ArrayGet(CAD_Sketch_Join.circs, Add(CAD_Sketch_Join.ok, 1))
            CAD_Sketch_Join.r = ArrayGet(CAD_Sketch_Join.circs, Add(CAD_Sketch_Join.ok, 2))
            CAD_Sketch_Join.j = 0
            WhileLoop LessThan(CAD_Sketch_Join.j, CAD_Sketch_Join.nl) {
                CAD_Sketch_Join.lines = CAD_Store.Read(CAD_Sketch_Join.sk, 1)
                CAD_Sketch_Join.ok = Multiply(CAD_Sketch_Join.j, 4)
                CAD_Sketch_Join.x0 = ArrayGet(CAD_Sketch_Join.lines, CAD_Sketch_Join.ok)
                CAD_Sketch_Join.y0 = ArrayGet(CAD_Sketch_Join.lines, Add(CAD_Sketch_Join.ok, 1))
                CAD_Sketch_Join.x1 = ArrayGet(CAD_Sketch_Join.lines, Add(CAD_Sketch_Join.ok, 2))
                CAD_Sketch_Join.y1 = ArrayGet(CAD_Sketch_Join.lines, Add(CAD_Sketch_Join.ok, 3))
                CAD_Sketch.IsectLineCirc()
                IfCondition GreaterThan(CAD_Sketch_Join.nh, 0) ThenBlock: {
                    CAD_Sketch.JoinAddPt(CAD_Sketch_Join.hx0, CAD_Sketch_Join.hy0, 0)
                }
                IfCondition GreaterThan(CAD_Sketch_Join.nh, 1) ThenBlock: {
                    CAD_Sketch.JoinAddPt(CAD_Sketch_Join.hx1, CAD_Sketch_Join.hy1, 0)
                }
                CAD_Sketch_Join.j = Add(CAD_Sketch_Join.j, 1)
            }
            CAD_Sketch_Join.i = Add(CAD_Sketch_Join.i, 1)
        }
        // 6) circle × circle crossings (anchors at real T/X of multi-circle sketches)
        nc = CAD_Store.Read(CAD_Sketch_Join.sk, 7)
        circs = CAD_Store.Read(CAD_Sketch_Join.sk, 8)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            base = Multiply(ci, 3)
            cx = ArrayGet(circs, base)
            cy = ArrayGet(circs, Add(base, 1))
            rad = ArrayGet(circs, Add(base, 2))
            cj = Add(ci, 1)
            WhileLoop LessThan(cj, nc) {
                bj = Multiply(cj, 3)
                ox = ArrayGet(circs, bj)
                oy = ArrayGet(circs, Add(bj, 1))
                orad = ArrayGet(circs, Add(bj, 2))
                dx = Float_Sub(ox, cx)
                dy = Float_Sub(oy, cy)
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                d = CAD_Num.Sqrt(d2)
                okc = 1
                IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: { okc = 0 }
                IfCondition EqualTo(Float_Le(Float_Add(rad, orad), d), 1) ThenBlock: { okc = 0 }
                dr = Float_Sub(rad, orad)
                IfCondition EqualTo(Float_Le(dr, 0), 1) ThenBlock: { dr = Float_Sub(0, dr) }
                IfCondition EqualTo(Float_Le(d, dr), 1) ThenBlock: { okc = 0 }
                IfCondition EqualTo(okc, 1) ThenBlock: {
                    a = Float_Div(Float_Add(Float_Sub(Float_Mul(rad, rad), Float_Mul(orad, orad)), d2), Float_Mul(0x4000000000000000, d))
                    h2 = Float_Sub(Float_Mul(rad, rad), Float_Mul(a, a))
                    IfCondition EqualTo(Float_Le(h2, 0), 0) ThenBlock: {
                        h = CAD_Num.Sqrt(h2)
                        mx = Float_Add(cx, Float_Mul(a, Float_Div(dx, d)))
                        my = Float_Add(cy, Float_Mul(a, Float_Div(dy, d)))
                        rx = Float_Mul(h, Float_Div(dy, d))
                        ry = Float_Mul(h, Float_Div(dx, d))
                        CAD_Sketch.JoinAddPt( Float_Add(mx, rx), Float_Sub(my, ry), mtol)
                        CAD_Sketch.JoinAddPt( Float_Sub(mx, rx), Float_Add(my, ry), mtol)
                    }
                }
                cj = Add(cj, 1)
            }
            ci = Add(ci, 1)
        }
        ReturnValue(CAD_Store.Read(CAD_Sketch_Join.sk, 16))
    }
}


// Split every LINE at crossings + T-junctions + circle/arc rim hits.
// Works with a single line against circles (nl==1) — critical for trim-to-point.
// Does NOT tessellate circles/arcs; live entities stay clean.
// Returns new line count.
Function.CAD_Sketch.SplitAtIntersections {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch_Join.sk = sketch_handle
        nl = CAD_Store.Read(CAD_Sketch_Join.sk, 0)
        // allow 1 line: still split at circle/arc hits
        IfCondition LessThan(nl, 1) ThenBlock: { ReturnValue(nl) }
        lines = CAD_Store.Read(CAD_Sketch_Join.sk, 1)
        cap = CAD_Store.Read(CAD_Sketch_Join.sk, 5)
        // fixed merge eps (no AABB)
        mtol = 0x3F50624DD2F1A9FC
        mtol2 = Float_Mul(mtol, mtol)
        // out: up to 4096 segs × 4 doubles
        out = Allocate(131072)
        on = 0
        // ts: up to 256 split params per segment (was 60 — long rects lost cuts)
        ts = Allocate(4096)
        nc = CAD_Store.Read(CAD_Sketch_Join.sk, 7)
        circs = CAD_Store.Read(CAD_Sketch_Join.sk, 8)
        na = CAD_Store.Read(CAD_Sketch_Join.sk, 10)
        arcs = CAD_Store.Read(CAD_Sketch_Join.sk, 11)
        two_pi = 0x401921FB54442D18
        i = 0
        WhileLoop LessThan(i, nl) {
            bi = Multiply(i, 4)
            ax0 = ArrayGet(lines, bi)
            ay0 = ArrayGet(lines, Add(bi, 1))
            ax1 = ArrayGet(lines, Add(bi, 2))
            ay1 = ArrayGet(lines, Add(bi, 3))
            adx = Float_Sub(ax1, ax0)
            ady = Float_Sub(ay1, ay0)
            alen2 = Float_Add(Float_Mul(adx, adx), Float_Mul(ady, ady))
            eps = 0x3F50624DD2F1A9FC
            ArraySet(ts, 0, 0)
            ArraySet(ts, 1, 0x3FF0000000000000)
            nt = 2
            // also split at every existing anchor that lies on this segment
            npt = CAD_Store.Read(CAD_Sketch_Join.sk, 16)
            pts = CAD_Store.Read(CAD_Sketch_Join.sk, 17)
            IfCondition NotEqual(pts, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(alen2, 0), 0) ThenBlock: {
                    pi = 0
                    WhileLoop LessThan(pi, npt) {
                        px = ArrayGet(pts, Multiply(pi, 2))
                        py = ArrayGet(pts, Add(Multiply(pi, 2), 1))
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(px, ax0), adx), Float_Mul(Float_Sub(py, ay0), ady)), alen2)
                        IfCondition EqualTo(Float_Le(t, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0x3FF0000000000000, t), 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                                qx = Float_Add(ax0, Float_Mul(t, adx))
                                qy = Float_Add(ay0, Float_Mul(t, ady))
                                ddx = Float_Sub(qx, px)
                                ddy = Float_Sub(qy, py)
                                IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                                    IfCondition LessThan(nt, 256) ThenBlock: {
                                        ArraySet(ts, nt, t)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                        }
                        pi = Add(pi, 1)
                    }
                }
            }
            j = 0
            WhileLoop LessThan(j, nl) {
                IfCondition NotEqual(j, i) ThenBlock: {
                    bj = Multiply(j, 4)
                    bx0 = ArrayGet(lines, bj)
                    by0 = ArrayGet(lines, Add(bj, 1))
                    bx1 = ArrayGet(lines, Add(bj, 2))
                    by1 = ArrayGet(lines, Add(bj, 3))
                    bdx = Float_Sub(bx1, bx0)
                    bdy = Float_Sub(by1, by0)
                    den = Float_Sub(Float_Mul(adx, bdy), Float_Mul(ady, bdx))
                    IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                        t = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), bdy), Float_Mul(Float_Sub(by0, ay0), bdx)), den)
                        u = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), ady), Float_Mul(Float_Sub(by0, ay0), adx)), den)
                        one = 0x3FF0000000000000
                        ok = 1
                        IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ok = 0 }
                        IfCondition EqualTo(Float_Le(Float_Sub(one, eps), t), 1) ThenBlock: { ok = 0 }
                        IfCondition EqualTo(Float_Le(u, 0), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0, u), eps), 0) ThenBlock: { ok = 0 }
                        }
                        IfCondition EqualTo(Float_Le(one, u), 1) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(u, one), eps), 0) ThenBlock: { ok = 0 }
                        }
                        IfCondition EqualTo(ok, 1) ThenBlock: {
                            IfCondition LessThan(nt, 256) ThenBlock: {
                                ArraySet(ts, nt, t)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                    // T-junction: endpoints of j on interior of i (loose freehand)
                    IfCondition EqualTo(CAD_Num.IsZero(alen2, 0), 0) ThenBlock: {
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx0, ax0), adx), Float_Mul(Float_Sub(by0, ay0), ady)), alen2)
                        IfCondition EqualTo(Float_Le(t, eps), 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0x3FF0000000000000, t), eps), 0) ThenBlock: {
                                px = Float_Add(ax0, Float_Mul(t, adx))
                                py = Float_Add(ay0, Float_Mul(t, ady))
                                ddx = Float_Sub(px, bx0)
                                ddy = Float_Sub(py, by0)
                                IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                                    IfCondition LessThan(nt, 256) ThenBlock: {
                                        ArraySet(ts, nt, t)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                        }
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx1, ax0), adx), Float_Mul(Float_Sub(by1, ay0), ady)), alen2)
                        IfCondition EqualTo(Float_Le(t, eps), 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(0x3FF0000000000000, t), eps), 0) ThenBlock: {
                                px = Float_Add(ax0, Float_Mul(t, adx))
                                py = Float_Add(ay0, Float_Mul(t, ady))
                                ddx = Float_Sub(px, bx1)
                                ddy = Float_Sub(py, by1)
                                IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                                    IfCondition LessThan(nt, 256) ThenBlock: {
                                        ArraySet(ts, nt, t)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                        }
                    }
                }
                j = Add(j, 1)
            }
            // line × full circle: EXACT quadratic, interior t ∈ (0,1)
            ci = 0
            WhileLoop LessThan(ci, nc) {
                cbase = Multiply(ci, 3)
                cx = ArrayGet(circs, cbase)
                cy = ArrayGet(circs, Add(cbase, 1))
                rad = ArrayGet(circs, Add(cbase, 2))
                fx = Float_Sub(ax0, cx)
                fy = Float_Sub(ay0, cy)
                aa = alen2
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, adx, ady))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, eps)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        one = 0x3FF0000000000000
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            ok = 1
                            IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Sub(one, eps), t)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                IfCondition LessThan(nt, 256) ThenBlock: {
                                    ArraySet(ts, nt, t)
                                    nt = Add(nt, 1)
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                ci = Add(ci, 1)
            }
            // line × arc: only if hit angle is on the open arc span
            // Float_Le(neg,0) broken — PosMod2Pi + IsNeg for t/disc
            ai = 0
            WhileLoop LessThan(ai, na) {
                abase = Multiply(ai, 5)
                cx = ArrayGet(arcs, abase)
                cy = ArrayGet(arcs, Add(abase, 1))
                rad = ArrayGet(arcs, Add(abase, 2))
                a0 = ArrayGet(arcs, Add(abase, 3))
                a1 = ArrayGet(arcs, Add(abase, 4))
                span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
                fx = Float_Sub(ax0, cx)
                fy = Float_Sub(ay0, cy)
                aa = alen2
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, adx, ady))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, eps)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            one = 0x3FF0000000000000
                            ok = 1
                            // reject t <= eps or t >= 1-eps (open interior hits for line split)
                            IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Sub(one, eps), t)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(ax0, Float_Mul(t, adx))
                                py = Float_Add(ay0, Float_Mul(t, ady))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                                IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                                    IfCondition LessThan(nt, 256) ThenBlock: {
                                        ArraySet(ts, nt, t)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                ai = Add(ai, 1)
            }
            // bubble sort ts ascending
            a = 0
            WhileLoop LessThan(a, nt) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nt) {
                    va = ArrayGet(ts, a)
                    vb = ArrayGet(ts, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(ts, a, vb)
                        ArraySet(ts, bb, va)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // emit unique consecutive pieces
            prev_t = ArrayGet(ts, 0)
            k = 1
            WhileLoop LessThan(k, nt) {
                t1 = ArrayGet(ts, k)
                // skip near-duplicate t
                dt = Float_Sub(t1, prev_t)
                IfCondition EqualTo(Float_Le(dt, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
                    // min length: skip degenerate
                    x0 = Float_Add(ax0, Float_Mul(prev_t, adx))
                    y0 = Float_Add(ay0, Float_Mul(prev_t, ady))
                    x1 = Float_Add(ax0, Float_Mul(t1, adx))
                    y1 = Float_Add(ay0, Float_Mul(t1, ady))
                    IfCondition LessThan(on, cap) ThenBlock: {
                        ob = Multiply(on, 4)
                        ArraySet(out, ob, x0)
                        ArraySet(out, Add(ob, 1), y0)
                        ArraySet(out, Add(ob, 2), x1)
                        ArraySet(out, Add(ob, 3), y1)
                        on = Add(on, 1)
                    }
                    prev_t = t1
                }
                k = Add(k, 1)
            }
            i = Add(i, 1)
        }
        // rewrite sketch lines
        IfCondition GreaterThan(on, 0) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, on) {
                b = Multiply(i, 4)
                ArraySet(lines, b, ArrayGet(out, b))
                ArraySet(lines, Add(b, 1), ArrayGet(out, Add(b, 1)))
                ArraySet(lines, Add(b, 2), ArrayGet(out, Add(b, 2)))
                ArraySet(lines, Add(b, 3), ArrayGet(out, Add(b, 3)))
                i = Add(i, 1)
            }
            CAD_Store.Write(CAD_Sketch_Join.sk, 0, on)
            CAD_Store.Write(CAD_Sketch_Join.sk, 2, 0)
            CAD_Store.Write(CAD_Sketch_Join.sk, 12, 0)
        }
        Deallocate(out, 131072)
        Deallocate(ts, 4096)
        ReturnValue(CAD_Store.Read(CAD_Sketch_Join.sk, 0))
    }
}

// Split ONE line at all crossings (other lines / circles / arcs / anchors).
// Used by interactive trim so each cut does not re-fragment the whole sketch.
// Returns new line count. line_i pieces: first overwrites line_i, rest AddLine.


// Split ONE line at all crossings (other lines / circles / arcs / anchors).
// Used by interactive trim so each cut does not re-fragment the whole sketch.
// Returns new line count. line_i pieces: first overwrites line_i, rest AddLine.
Function.CAD_Sketch.SplitLineAtHits {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch_Join.sk = sketch_handle
        nl = CAD_Store.Read(CAD_Sketch_Join.sk, 0)
        IfCondition LessThan(line_i, 0) ThenBlock: { ReturnValue(nl) }
        IfCondition GreaterEqual(line_i, nl) ThenBlock: { ReturnValue(nl) }
        lines = CAD_Store.Read(CAD_Sketch_Join.sk, 1)
        bi = Multiply(line_i, 4)
        ax0 = ArrayGet(lines, bi)
        ay0 = ArrayGet(lines, Add(bi, 1))
        ax1 = ArrayGet(lines, Add(bi, 2))
        ay1 = ArrayGet(lines, Add(bi, 3))
        adx = Float_Sub(ax1, ax0)
        ady = Float_Sub(ay1, ay0)
        alen2 = Float_Add(Float_Mul(adx, adx), Float_Mul(ady, ady))
        IfCondition EqualTo(CAD_Num.IsZero(alen2, 0), 1) ThenBlock: { ReturnValue(nl) }
        // absolute coincidence eps — not sketch AABB %
        mtol = 0x3F50624DD2F1A9FC
        mtol2 = Float_Mul(mtol, mtol)
        eps = 0x3F50624DD2F1A9FC
        one = 0x3FF0000000000000
        two_pi = 0x401921FB54442D18
        ts = Allocate(4096)
        ArraySet(ts, 0, 0)
        ArraySet(ts, 1, one)
        nt = 2
        // other lines
        j = 0
        WhileLoop LessThan(j, nl) {
            IfCondition NotEqual(j, line_i) ThenBlock: {
                bj = Multiply(j, 4)
                bx0 = ArrayGet(lines, bj)
                by0 = ArrayGet(lines, Add(bj, 1))
                bx1 = ArrayGet(lines, Add(bj, 2))
                by1 = ArrayGet(lines, Add(bj, 3))
                bdx = Float_Sub(bx1, bx0)
                bdy = Float_Sub(by1, by0)
                den = Float_Sub(Float_Mul(adx, bdy), Float_Mul(ady, bdx))
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    t = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), bdy), Float_Mul(Float_Sub(by0, ay0), bdx)), den)
                    u = Float_Div(Float_Sub(Float_Mul(Float_Sub(bx0, ax0), ady), Float_Mul(Float_Sub(by0, ay0), adx)), den)
                    ok = 1
                    IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(Float_Le(Float_Sub(one, eps), t), 1) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(Float_Le(u, 0), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(0, u), eps), 0) ThenBlock: { ok = 0 }
                    }
                    IfCondition EqualTo(Float_Le(one, u), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(Float_Sub(u, one), eps), 0) ThenBlock: { ok = 0 }
                    }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        IfCondition LessThan(nt, 256) ThenBlock: {
                            ArraySet(ts, nt, t)
                            nt = Add(nt, 1)
                        }
                    }
                }
                // T: j endpoints on i
                t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx0, ax0), adx), Float_Mul(Float_Sub(by0, ay0), ady)), alen2)
                IfCondition EqualTo(Float_Le(t, eps), 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(one, t), eps), 0) ThenBlock: {
                        px = Float_Add(ax0, Float_Mul(t, adx))
                        py = Float_Add(ay0, Float_Mul(t, ady))
                        ddx = Float_Sub(px, bx0)
                        ddy = Float_Sub(py, by0)
                        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                            IfCondition LessThan(nt, 256) ThenBlock: {
                                ArraySet(ts, nt, t)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                }
                t = Float_Div(Float_Add(Float_Mul(Float_Sub(bx1, ax0), adx), Float_Mul(Float_Sub(by1, ay0), ady)), alen2)
                IfCondition EqualTo(Float_Le(t, eps), 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(Float_Sub(one, t), eps), 0) ThenBlock: {
                        px = Float_Add(ax0, Float_Mul(t, adx))
                        py = Float_Add(ay0, Float_Mul(t, ady))
                        ddx = Float_Sub(px, bx1)
                        ddy = Float_Sub(py, by1)
                        IfCondition EqualTo(Float_Le(Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy)), mtol2), 1) ThenBlock: {
                            IfCondition LessThan(nt, 256) ThenBlock: {
                                ArraySet(ts, nt, t)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                }
            }
            j = Add(j, 1)
        }
        // circles — pool isect (Sqrt in this function smashed t/nt)
        CAD_Sketch_Join.x0 = ax0
        CAD_Sketch_Join.y0 = ay0
        CAD_Sketch_Join.x1 = ax1
        CAD_Sketch_Join.y1 = ay1
        CAD_Sketch_Join.j = nt
        CAD_Sketch_Join.nc = CAD_Store.Read(CAD_Sketch_Join.sk, 7)
        CAD_Sketch_Join.i = 0
        WhileLoop LessThan(CAD_Sketch_Join.i, CAD_Sketch_Join.nc) {
            CAD_Sketch_Join.circs = CAD_Store.Read(CAD_Sketch_Join.sk, 8)
            CAD_Sketch_Join.ok = Multiply(CAD_Sketch_Join.i, 3)
            CAD_Sketch_Join.cx = ArrayGet(CAD_Sketch_Join.circs, CAD_Sketch_Join.ok)
            CAD_Sketch_Join.cy = ArrayGet(CAD_Sketch_Join.circs, Add(CAD_Sketch_Join.ok, 1))
            CAD_Sketch_Join.r = ArrayGet(CAD_Sketch_Join.circs, Add(CAD_Sketch_Join.ok, 2))
            CAD_Sketch.IsectLineCirc()
            IfCondition GreaterThan(CAD_Sketch_Join.nh, 0) ThenBlock: {
                IfCondition EqualTo(Float_Le(CAD_Sketch_Join.ht0, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0x3FEFF7CED916872B, CAD_Sketch_Join.ht0)), 0) ThenBlock: {
                        IfCondition LessThan(CAD_Sketch_Join.j, 256) ThenBlock: {
                            ArraySet(ts, CAD_Sketch_Join.j, CAD_Sketch_Join.ht0)
                            CAD_Sketch_Join.j = Add(CAD_Sketch_Join.j, 1)
                        }
                    }
                }
            }
            IfCondition GreaterThan(CAD_Sketch_Join.nh, 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(CAD_Sketch_Join.ht1, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0x3FEFF7CED916872B, CAD_Sketch_Join.ht1)), 0) ThenBlock: {
                        IfCondition LessThan(CAD_Sketch_Join.j, 256) ThenBlock: {
                            ArraySet(ts, CAD_Sketch_Join.j, CAD_Sketch_Join.ht1)
                            CAD_Sketch_Join.j = Add(CAD_Sketch_Join.j, 1)
                        }
                    }
                }
            }
            CAD_Sketch_Join.i = Add(CAD_Sketch_Join.i, 1)
        }
        nt = CAD_Sketch_Join.j
        // arcs — PosMod2Pi for span/dang (Float_Le(neg,0) broken)
        na = CAD_Store.Read(CAD_Sketch_Join.sk, 10)
        arcs = CAD_Store.Read(CAD_Sketch_Join.sk, 11)
        ai = 0
        WhileLoop LessThan(ai, na) {
            abase = Multiply(ai, 5)
            cx = ArrayGet(arcs, abase)
            cy = ArrayGet(arcs, Add(abase, 1))
            rad = ArrayGet(arcs, Add(abase, 2))
            a0 = ArrayGet(arcs, Add(abase, 3))
            a1 = ArrayGet(arcs, Add(abase, 4))
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            fx = Float_Sub(ax0, cx)
            fy = Float_Sub(ay0, cy)
            bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, adx, ady))
            cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
            disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, alen2), cc))
            IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(alen2, eps)), 1) ThenBlock: {
                    disc = 0
                }
            }
            IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                s = CAD_Num.Sqrt(disc)
                two_a = Float_Mul(0x4000000000000000, alen2)
                t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                hi = 0
                WhileLoop LessThan(hi, 2) {
                    t = t0
                    IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                    ok = 1
                    IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Sub(one, eps), t)), 1) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        px = Float_Add(ax0, Float_Mul(t, adx))
                        py = Float_Add(ay0, Float_Mul(t, ady))
                        ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                        dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                        IfCondition EqualTo(Float_Le(dang, Float_Add(span, eps)), 1) ThenBlock: {
                            IfCondition LessThan(nt, 256) ThenBlock: {
                                ArraySet(ts, nt, t)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                    hi = Add(hi, 1)
                }
            }
            ai = Add(ai, 1)
        }
        // sort t
        a = 0
        WhileLoop LessThan(a, nt) {
            bb = Add(a, 1)
            WhileLoop LessThan(bb, nt) {
                va = ArrayGet(ts, a)
                vb = ArrayGet(ts, bb)
                IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                    ArraySet(ts, a, vb)
                    ArraySet(ts, bb, va)
                }
                bb = Add(bb, 1)
            }
            a = Add(a, 1)
        }
        // emit pieces: first → SetLine(line_i), rest → AddLine
        prev_t = ArrayGet(ts, 0)
        npiece = 0
        k = 1
        WhileLoop LessThan(k, nt) {
            t1 = ArrayGet(ts, k)
            dt = Float_Sub(t1, prev_t)
            IfCondition EqualTo(Float_Le(dt, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
                x0 = Float_Add(ax0, Float_Mul(prev_t, adx))
                y0 = Float_Add(ay0, Float_Mul(prev_t, ady))
                x1 = Float_Add(ax0, Float_Mul(t1, adx))
                y1 = Float_Add(ay0, Float_Mul(t1, ady))
                IfCondition EqualTo(npiece, 0) ThenBlock: {
                    CAD_Sketch.SetLine(CAD_Sketch_Join.sk, line_i, x0, y0, x1, y1)
                }
                IfCondition GreaterThan(npiece, 0) ThenBlock: {
                    CAD_Sketch.AddLine(CAD_Sketch_Join.sk, x0, y0, x1, y1)
                }
                npiece = Add(npiece, 1)
                prev_t = t1
            }
            k = Add(k, 1)
        }
        Deallocate(ts, 4096)
        CAD_Store.Write(CAD_Sketch_Join.sk, 2, 0)
        CAD_Store.Write(CAD_Sketch_Join.sk, 12, 0)
        ReturnValue(CAD_Store.Read(CAD_Sketch_Join.sk, 0))
    }
}

// Split line_i at (x,y) if that point lies in the open segment. Returns 1 if split.
Function.CAD_Sketch.SplitLineAtXY {
    Input: sketch_handle: Integer
    Input: line_i: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch_Join.sk = sketch_handle
        nl = CAD_Store.Read(CAD_Sketch_Join.sk, 0)
        IfCondition GreaterEqual(line_i, nl) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(CAD_Sketch_Join.sk, 1)
        b = Multiply(line_i, 4)
        x0 = ArrayGet(lines, b)
        y0 = ArrayGet(lines, Add(b, 1))
        x1 = ArrayGet(lines, Add(b, 2))
        y1 = ArrayGet(lines, Add(b, 3))
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 1) ThenBlock: { ReturnValue(0) }
        t = Float_Div(Float_Add(Float_Mul(Float_Sub(x_r, x0), dx), Float_Mul(Float_Sub(y_r, y0), dy)), aa)
        eps = 0x3F50624DD2F1A9FC
        one = 0x3FF0000000000000
        IfCondition EqualTo(Float_Le(t, eps), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(Float_Sub(one, t), eps), 1) ThenBlock: { ReturnValue(0) }
        // first piece overwrites line_i; second appended
        CAD_Sketch.SetLine(CAD_Sketch_Join.sk, line_i, x0, y0, x_r, y_r)
        CAD_Sketch.AddLine(CAD_Sketch_Join.sk, x_r, y_r, x1, y1)
        ReturnValue(1)
    }
}

// Pull nearby line ends (and mid-line body) onto arc endpoints so face-walk
// and trim share exact UV. Also splits long V-legs when Arc3 hits mid-side.
// tol_r=0 → 1.0 mm default. Returns n welds/splits.


