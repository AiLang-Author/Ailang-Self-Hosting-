// CAD.Solve2D — constraint Jacobian, damped least squares, public LU.
// Names stay LUDecompose, LUSolve, AssembleJacobian, SolveNewtonRaphson.
//
// Tolerances come from CAD_Num. InitTolerance(0,0) fills Num_Tol.
// A zero tol_r means CAD_Num.IsZero uses Num_Tol.linear.
// Rank pivots use Num_Tol.param. Length rows are divided by Num_Tol.model_size.
// Finite-difference step is Num_Tol.linear. No private cutoff.
//
// λ starts at 0.01 and is multiplied by 1/2 or by 4. Those are step controls.
// The drag row weight 0.25 is a step control. The 1e6 cap is a step control.
//
// Public LUDecompose(a, n, L, U) factors a copy. Pivots stay in this pool
// because this signature has no pivot argument. The 2×2 test matrix swaps
// rows, so L and U factor PA. LUSolve ignores the L and U buffers and uses
// that stored packed factorization.
//
// SolveNewtonRaphson seeds with SolveDatum, then Levenberg–Marquardt.
// solved_dof is the hard Jacobian rank, written after SolveDatum returns.
// n_vars is a cap (0 uses the internal 16). Past 16 variables or 32
// equations returns -4. Returns 0, -1 null, -4 range, -8 not converged.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Plex
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Sketch

FixedPool.CAD_Solve2D_State {
    "solves_run":       Initialize=0
    "jacobian_size":    Initialize=0
    "lu_decomps":       Initialize=0
    "converged_solves": Initialize=0
    "nvar":             Initialize=0
    "neq":              Initialize=0
    "ntot":             Initialize=0
    "rank":             Initialize=0
    "nn":               Initialize=0
    "ring_n":           Initialize=0
    "var_head":         Initialize=0
    "cstr_head":        Initialize=0
    "sk":               Initialize=0
    "lam":              Initialize=0
    "resid":            Initialize=0
    "tol":              Initialize=0
    "capv":             Initialize=0
    "cape":             Initialize=0
    "ovf":              Initialize=0
    "mode":             Initialize=0
    "ok":               Initialize=0
    "rc":               Initialize=0
    "drag_on":          Initialize=0
    "drag_kind":        Initialize=0
    "drag_id":          Initialize=0
    "drag_x":           Initialize=0
    "drag_y":           Initialize=0
    "lu_n":             Initialize=0
    "ready":            Initialize=0
    "iters":            Initialize=0
    "iter":             Initialize=0
    "trial":            Initialize=0
    "acc":              Initialize=0
    "xv":               Initialize=0
    "rhs":              Initialize=0
    "dxv":              Initialize=0
    "xsave":            Initialize=0
    "piv":              Initialize=0
    "res":              Initialize=0
    "res2":             Initialize=0
    "jj":               Initialize=0
    "jw":               Initialize=0
    "aa":               Initialize=0
    "lua":              Initialize=0
    "nodes":            Initialize=0
    "xy":               Initialize=0
    "vk":               Initialize=0
    "vi":               Initialize=0
    "vc":               Initialize=0
    "vnode":            Initialize=0
    "cstr":             Initialize=0
    "ctype":            Initialize=0
    "ka":               Initialize=0
    "ia":               Initialize=0
    "kb":               Initialize=0
    "ib":               Initialize=0
    "cval":             Initialize=0
    "dual":             Initialize=0
    "row":              Initialize=0
    "cur":              Initialize=0
    "cur2":             Initialize=0
    "col":              Initialize=0
    "w":                Initialize=0
    "i0":               Initialize=0
    "j0":               Initialize=0
    "k0":               Initialize=0
    "lead":             Initialize=0
    "best":             Initialize=0
    "tk":               Initialize=0
    "ti":               Initialize=0
    "slot":             Initialize=0
    "li":               Initialize=0
    "e0":               Initialize=0
    "e1":               Initialize=0
    "saved":            Initialize=0
    "done":             Initialize=0
    "ax":               Initialize=0
    "ay":               Initialize=0
    "bx":               Initialize=0
    "by":               Initialize=0
    "px":               Initialize=0
    "py":               Initialize=0
    "rr":               Initialize=0
    "sd":               Initialize=0
    "rad":              Initialize=0
    "mag":              Initialize=0
    "fac":              Initialize=0
    "step":             Initialize=0
    "ss0":              Initialize=0
    "ss1":              Initialize=0
    "rv":               Initialize=0
    "lx0":              Initialize=0
    "ly0":              Initialize=0
    "lx1":              Initialize=0
    "ly1":              Initialize=0
    "p0":               Initialize=0
    "p1":               Initialize=0
    "p2":               Initialize=0
}

Function.CAD_Solve2D.EnsureTol {
    Output: Integer
    Body: {
        IfCondition EqualTo(Num_Tol.linear, 0) ThenBlock: {
            CAD_Num.InitTolerance(0, 0)
        }
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.EnsureWork {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Solve2D_State.ready, 1) ThenBlock: { ReturnValue(0) }
        CAD_Solve2D_State.xv = Allocate(256)
        CAD_Solve2D_State.rhs = Allocate(256)
        CAD_Solve2D_State.dxv = Allocate(256)
        CAD_Solve2D_State.xsave = Allocate(256)
        CAD_Solve2D_State.piv = Allocate(256)
        CAD_Solve2D_State.vk = Allocate(256)
        CAD_Solve2D_State.vi = Allocate(256)
        CAD_Solve2D_State.vc = Allocate(256)
        CAD_Solve2D_State.vnode = Allocate(256)
        CAD_Solve2D_State.res = Allocate(512)
        CAD_Solve2D_State.res2 = Allocate(512)
        CAD_Solve2D_State.jj = Allocate(8192)
        CAD_Solve2D_State.jw = Allocate(8192)
        CAD_Solve2D_State.aa = Allocate(4096)
        CAD_Solve2D_State.lua = Allocate(4096)
        CAD_Solve2D_State.nodes = Allocate(4096)
        CAD_Solve2D_State.xy = Allocate(32)
        IfCondition EqualTo(CAD_Solve2D_State.xv, 0) ThenBlock: { ReturnValue(-16) }
        IfCondition EqualTo(CAD_Solve2D_State.jj, 0) ThenBlock: { ReturnValue(-16) }
        IfCondition EqualTo(CAD_Solve2D_State.nodes, 0) ThenBlock: { ReturnValue(-16) }
        CAD_Solve2D_State.nn = 0
        CAD_Solve2D_State.ready = 1
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.NoteVar {
    Input: kind: Integer
    Input: id: Integer
    Input: comp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
        CAD_Solve2D_State.w = 0
        WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.nvar) {
            CAD_Solve2D_State.slot = 0
            IfCondition EqualTo(ArrayGet(CAD_Solve2D_State.vk, CAD_Solve2D_State.w), kind) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CAD_Solve2D_State.vi, CAD_Solve2D_State.w), id) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(CAD_Solve2D_State.vc, CAD_Solve2D_State.w), comp) ThenBlock: {
                        CAD_Solve2D_State.slot = 1
                    }
                }
            }
            IfCondition EqualTo(CAD_Solve2D_State.slot, 1) ThenBlock: {
                ReturnValue(CAD_Solve2D_State.w)
            }
            CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
        }
        IfCondition GreaterEqual(CAD_Solve2D_State.nvar, CAD_Solve2D_State.capv) ThenBlock: {
            CAD_Solve2D_State.ovf = 1
            ReturnValue(-4)
        }
        IfCondition GreaterEqual(CAD_Solve2D_State.nvar, 16) ThenBlock: {
            CAD_Solve2D_State.ovf = 1
            ReturnValue(-4)
        }
        ArraySet(CAD_Solve2D_State.vk, CAD_Solve2D_State.nvar, kind)
        ArraySet(CAD_Solve2D_State.vi, CAD_Solve2D_State.nvar, id)
        ArraySet(CAD_Solve2D_State.vc, CAD_Solve2D_State.nvar, comp)
        CAD_Solve2D_State.col = CAD_Solve2D_State.nvar
        CAD_Solve2D_State.nvar = Add(CAD_Solve2D_State.nvar, 1)
        ReturnValue(CAD_Solve2D_State.col)
    }
}

Function.CAD_Solve2D.NoteXY {
    Input: kind: Integer
    Input: id: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.tk = kind
        CAD_Solve2D_State.ti = id
        CAD_Solve2D.NoteVar(CAD_Solve2D_State.tk, CAD_Solve2D_State.ti, 0)
        IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
        CAD_Solve2D.NoteVar(CAD_Solve2D_State.tk, CAD_Solve2D_State.ti, 1)
        ReturnValue(0)
    }
}

// comp 0 = x only, 1 = y only, 2 = both. Line index, not an endpoint id.
Function.CAD_Solve2D.NoteEnds {
    Input: li: Integer
    Input: comp: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.li = li
        CAD_Solve2D_State.slot = comp
        IfCondition NotEqual(CAD_Solve2D_State.slot, 0) ThenBlock: {
            CAD_Solve2D_State.e0 = Multiply(CAD_Solve2D_State.li, 2)
            CAD_Solve2D.NoteVar(0, CAD_Solve2D_State.e0, 1)
            CAD_Solve2D_State.e0 = Multiply(CAD_Solve2D_State.li, 2)
            CAD_Solve2D_State.e0 = Add(CAD_Solve2D_State.e0, 1)
            CAD_Solve2D.NoteVar(0, CAD_Solve2D_State.e0, 1)
        }
        IfCondition NotEqual(CAD_Solve2D_State.slot, 1) ThenBlock: {
            CAD_Solve2D_State.e0 = Multiply(CAD_Solve2D_State.li, 2)
            CAD_Solve2D.NoteVar(0, CAD_Solve2D_State.e0, 0)
            CAD_Solve2D_State.e0 = Multiply(CAD_Solve2D_State.li, 2)
            CAD_Solve2D_State.e0 = Add(CAD_Solve2D_State.e0, 1)
            CAD_Solve2D.NoteVar(0, CAD_Solve2D_State.e0, 0)
        }
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.NewNode {
    Input: typ: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.saved = Plex.Alloc(typ)
        IfCondition EqualTo(CAD_Solve2D_State.saved, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CAD_Solve2D_State.nn, 500) ThenBlock: {
            Plex.Free(CAD_Solve2D_State.saved)
            ReturnValue(0)
        }
        ArraySet(CAD_Solve2D_State.nodes, CAD_Solve2D_State.nn, CAD_Solve2D_State.saved)
        CAD_Solve2D_State.nn = Add(CAD_Solve2D_State.nn, 1)
        ReturnValue(CAD_Solve2D_State.saved)
    }
}

Function.CAD_Solve2D.FreeGraph {
    Output: Integer
    Body: {
        CAD_Solve2D_State.w = 0
        WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.nn) {
            CAD_Solve2D_State.saved = ArrayGet(CAD_Solve2D_State.nodes, CAD_Solve2D_State.w)
            Plex.Free(CAD_Solve2D_State.saved)
            CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
        }
        CAD_Solve2D_State.nn = 0
        CAD_Solve2D_State.var_head = 0
        CAD_Solve2D_State.cstr_head = 0
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.SelfLink {
    Input: node: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.tk = node
        CAD_Solve2D_State.slot = ring
        Plex._RingSetNext(CAD_Solve2D_State.tk, CAD_Solve2D_State.slot, CAD_Solve2D_State.tk)
        Plex._RingSetPrev(CAD_Solve2D_State.tk, CAD_Solve2D_State.slot, CAD_Solve2D_State.tk)
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.ColHits {
    Input: col: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.tk = ArrayGet(CAD_Solve2D_State.vk, col)
        CAD_Solve2D_State.ti = ArrayGet(CAD_Solve2D_State.vi, col)
        IfCondition EqualTo(CAD_Solve2D_State.tk, CAD_Solve2D_State.ka) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.ti, CAD_Solve2D_State.ia) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(CAD_Solve2D_State.dual, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.tk, CAD_Solve2D_State.kb) ThenBlock: {
                IfCondition EqualTo(CAD_Solve2D_State.ti, CAD_Solve2D_State.ib) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(CAD_Solve2D_State.ka, 2) ThenBlock: {
            CAD_Solve2D_State.e0 = Multiply(CAD_Solve2D_State.ia, 2)
            CAD_Solve2D_State.e1 = Add(CAD_Solve2D_State.e0, 1)
            IfCondition EqualTo(CAD_Solve2D_State.tk, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Solve2D_State.ti, CAD_Solve2D_State.e0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(CAD_Solve2D_State.ti, CAD_Solve2D_State.e1) ThenBlock: { ReturnValue(1) }
            }
        }
        IfCondition EqualTo(CAD_Solve2D_State.dual, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.kb, 2) ThenBlock: {
                CAD_Solve2D_State.e0 = Multiply(CAD_Solve2D_State.ib, 2)
                CAD_Solve2D_State.e1 = Add(CAD_Solve2D_State.e0, 1)
                IfCondition EqualTo(CAD_Solve2D_State.tk, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Solve2D_State.ti, CAD_Solve2D_State.e0) ThenBlock: { ReturnValue(1) }
                    IfCondition EqualTo(CAD_Solve2D_State.ti, CAD_Solve2D_State.e1) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.CountRing {
    Output: Integer
    Body: {
        CAD_Solve2D_State.ring_n = 0
        IfCondition EqualTo(CAD_Solve2D_State.var_head, 0) ThenBlock: { ReturnValue(0) }
        CAD_Solve2D_State.saved = CAD_Solve2D_State.var_head
        CAD_Solve2D_State.done = 0
        CAD_Solve2D_State.k0 = 0
        WhileLoop EqualTo(CAD_Solve2D_State.done, 0) {
            CAD_Solve2D_State.ring_n = Add(CAD_Solve2D_State.ring_n, 1)
            CAD_Solve2D_State.e1 = Plex.RingNext(CAD_Solve2D_State.saved, 5)
            IfCondition EqualTo(CAD_Solve2D_State.e1, CAD_Solve2D_State.var_head) ThenBlock: {
                CAD_Solve2D_State.done = 1
            }
            IfCondition EqualTo(CAD_Solve2D_State.e1, 0) ThenBlock: {
                CAD_Solve2D_State.done = 1
            }
            IfCondition EqualTo(CAD_Solve2D_State.done, 0) ThenBlock: {
                CAD_Solve2D_State.saved = CAD_Solve2D_State.e1
            }
            CAD_Solve2D_State.k0 = Add(CAD_Solve2D_State.k0, 1)
            IfCondition GreaterThan(CAD_Solve2D_State.k0, 40) ThenBlock: {
                CAD_Solve2D_State.done = 1
            }
        }
        ReturnValue(CAD_Solve2D_State.ring_n)
    }
}

Function.CAD_Solve2D.BuildGraph {
    Output: Integer
    Body: {
        CAD_Solve2D.FreeGraph()
        Plex.Init()
        CAD_Solve2D_State.cur = 0
        WhileLoop LessThan(CAD_Solve2D_State.cur, CAD_Solve2D_State.nvar) {
            CAD_Solve2D.NewNode(20)
            IfCondition EqualTo(CAD_Solve2D_State.saved, 0) ThenBlock: { ReturnValue(-16) }
            Plex.Set(CAD_Solve2D_State.saved, 0, CAD_Solve2D_State.cur)
            CAD_Solve2D_State.e0 = ArrayGet(CAD_Solve2D_State.vk, CAD_Solve2D_State.cur)
            Plex.Set(CAD_Solve2D_State.saved, 1, CAD_Solve2D_State.e0)
            CAD_Solve2D_State.e0 = ArrayGet(CAD_Solve2D_State.vi, CAD_Solve2D_State.cur)
            Plex.Set(CAD_Solve2D_State.saved, 2, CAD_Solve2D_State.e0)
            CAD_Solve2D_State.e0 = ArrayGet(CAD_Solve2D_State.vc, CAD_Solve2D_State.cur)
            Plex.Set(CAD_Solve2D_State.saved, 3, CAD_Solve2D_State.e0)
            ArraySet(CAD_Solve2D_State.vnode, CAD_Solve2D_State.cur, CAD_Solve2D_State.saved)
            IfCondition EqualTo(CAD_Solve2D_State.var_head, 0) ThenBlock: {
                CAD_Solve2D.SelfLink(CAD_Solve2D_State.saved, 5)
                CAD_Solve2D.SelfLink(CAD_Solve2D_State.saved, 6)
                CAD_Solve2D_State.var_head = CAD_Solve2D_State.saved
            }
            IfCondition NotEqual(CAD_Solve2D_State.var_head, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Solve2D_State.var_head, CAD_Solve2D_State.saved) ThenBlock: {
                    Plex.RingInsertAfter(CAD_Solve2D_State.var_head, CAD_Solve2D_State.saved, 5)
                    CAD_Solve2D.SelfLink(CAD_Solve2D_State.saved, 6)
                }
            }
            CAD_Solve2D_State.cur = Add(CAD_Solve2D_State.cur, 1)
        }
        CAD_Solve2D_State.cstr = CAD_Store.Read(CAD_Solve2D_State.sk, 21)
        CAD_Solve2D_State.k0 = CAD_Store.Read(CAD_Solve2D_State.sk, 20)
        CAD_Solve2D_State.cur = 0
        WhileLoop LessThan(CAD_Solve2D_State.cur, CAD_Solve2D_State.k0) {
            CAD_Solve2D.LoadCstr(CAD_Solve2D_State.cur)
            CAD_Solve2D.NewNode(21)
            IfCondition EqualTo(CAD_Solve2D_State.saved, 0) ThenBlock: { ReturnValue(-16) }
            Plex.Set(CAD_Solve2D_State.saved, 0, CAD_Solve2D_State.cur)
            Plex.Set(CAD_Solve2D_State.saved, 1, CAD_Solve2D_State.ctype)
            IfCondition EqualTo(CAD_Solve2D_State.cstr_head, 0) ThenBlock: {
                CAD_Solve2D.SelfLink(CAD_Solve2D_State.saved, 4)
                CAD_Solve2D.SelfLink(CAD_Solve2D_State.saved, 7)
                CAD_Solve2D_State.cstr_head = CAD_Solve2D_State.saved
            }
            IfCondition NotEqual(CAD_Solve2D_State.cstr_head, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Solve2D_State.cstr_head, CAD_Solve2D_State.saved) ThenBlock: {
                    Plex.RingInsertAfter(CAD_Solve2D_State.cstr_head, CAD_Solve2D_State.saved, 4)
                    CAD_Solve2D.SelfLink(CAD_Solve2D_State.saved, 7)
                }
            }
            CAD_Solve2D_State.p0 = CAD_Solve2D_State.saved
            CAD_Solve2D_State.cur2 = 0
            WhileLoop LessThan(CAD_Solve2D_State.cur2, CAD_Solve2D_State.nvar) {
                CAD_Solve2D_State.e0 = CAD_Solve2D.ColHits(CAD_Solve2D_State.cur2)
                IfCondition EqualTo(CAD_Solve2D_State.e0, 1) ThenBlock: {
                    CAD_Solve2D.NewNode(22)
                    IfCondition EqualTo(CAD_Solve2D_State.saved, 0) ThenBlock: { ReturnValue(-16) }
                    Plex.Set(CAD_Solve2D_State.saved, 0, CAD_Solve2D_State.cur2)
                    Plex.Set(CAD_Solve2D_State.saved, 1, CAD_Solve2D_State.p0)
                    CAD_Solve2D_State.e1 = ArrayGet(CAD_Solve2D_State.vnode, CAD_Solve2D_State.cur2)
                    Plex.RingInsertAfter(CAD_Solve2D_State.e1, CAD_Solve2D_State.saved, 6)
                    Plex.RingInsertAfter(CAD_Solve2D_State.p0, CAD_Solve2D_State.saved, 7)
                }
                CAD_Solve2D_State.cur2 = Add(CAD_Solve2D_State.cur2, 1)
            }
            CAD_Solve2D_State.cur = Add(CAD_Solve2D_State.cur, 1)
        }
        IfCondition EqualTo(CAD_Solve2D_State.drag_on, 1) ThenBlock: {
            CAD_Solve2D.NewNode(21)
            IfCondition EqualTo(CAD_Solve2D_State.saved, 0) ThenBlock: { ReturnValue(-16) }
            Plex.Set(CAD_Solve2D_State.saved, 0, 0)
            Plex.Set(CAD_Solve2D_State.saved, 1, 0)
            IfCondition EqualTo(CAD_Solve2D_State.cstr_head, 0) ThenBlock: {
                CAD_Solve2D.SelfLink(CAD_Solve2D_State.saved, 4)
                CAD_Solve2D.SelfLink(CAD_Solve2D_State.saved, 7)
                CAD_Solve2D_State.cstr_head = CAD_Solve2D_State.saved
            }
            IfCondition NotEqual(CAD_Solve2D_State.cstr_head, CAD_Solve2D_State.saved) ThenBlock: {
                Plex.RingInsertAfter(CAD_Solve2D_State.cstr_head, CAD_Solve2D_State.saved, 4)
                CAD_Solve2D.SelfLink(CAD_Solve2D_State.saved, 7)
            }
            CAD_Solve2D_State.p0 = CAD_Solve2D_State.saved
            CAD_Solve2D_State.cur2 = 0
            WhileLoop LessThan(CAD_Solve2D_State.cur2, CAD_Solve2D_State.nvar) {
                CAD_Solve2D_State.tk = ArrayGet(CAD_Solve2D_State.vk, CAD_Solve2D_State.cur2)
                CAD_Solve2D_State.ti = ArrayGet(CAD_Solve2D_State.vi, CAD_Solve2D_State.cur2)
                CAD_Solve2D_State.e0 = 0
                IfCondition EqualTo(CAD_Solve2D_State.tk, CAD_Solve2D_State.drag_kind) ThenBlock: {
                    IfCondition EqualTo(CAD_Solve2D_State.ti, CAD_Solve2D_State.drag_id) ThenBlock: {
                        CAD_Solve2D_State.e0 = 1
                    }
                }
                IfCondition EqualTo(CAD_Solve2D_State.e0, 1) ThenBlock: {
                    CAD_Solve2D.NewNode(22)
                    Plex.Set(CAD_Solve2D_State.saved, 0, CAD_Solve2D_State.cur2)
                    Plex.Set(CAD_Solve2D_State.saved, 1, CAD_Solve2D_State.p0)
                    CAD_Solve2D_State.e1 = ArrayGet(CAD_Solve2D_State.vnode, CAD_Solve2D_State.cur2)
                    Plex.RingInsertAfter(CAD_Solve2D_State.e1, CAD_Solve2D_State.saved, 6)
                    Plex.RingInsertAfter(CAD_Solve2D_State.p0, CAD_Solve2D_State.saved, 7)
                }
                CAD_Solve2D_State.cur2 = Add(CAD_Solve2D_State.cur2, 1)
            }
        }
        CAD_Solve2D.CountRing()
        ReturnValue(0)
    }
}

// ×4, cap 1e6. Step control, not a length tolerance.
Function.CAD_Solve2D.GrowLam {
    Output: Integer
    Body: {
        CAD_Solve2D_State.mag = Float_Mul(CAD_Solve2D_State.lam, 0x4010000000000000)
        IfCondition EqualTo(Float_Le(0x412E848000000000, CAD_Solve2D_State.mag), 1) ThenBlock: {
            CAD_Solve2D_State.mag = 0x412E848000000000
        }
        CAD_Solve2D_State.lam = CAD_Solve2D_State.mag
        ReturnValue(0)
    }
}

// ×1/2, floor Num_Tol.param. Step control, not a new epsilon.
Function.CAD_Solve2D.ShrinkLam {
    Output: Integer
    Body: {
        CAD_Solve2D_State.mag = Float_Mul(CAD_Solve2D_State.lam, 0x3FE0000000000000)
        IfCondition EqualTo(Float_Le(CAD_Solve2D_State.mag, Num_Tol.param), 1) ThenBlock: {
            CAD_Solve2D_State.mag = Num_Tol.param
        }
        CAD_Solve2D_State.lam = CAD_Solve2D_State.mag
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.SaveX {
    Output: Integer
    Body: {
        CAD_Solve2D_State.w = 0
        WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.nvar) {
            ArraySet(CAD_Solve2D_State.xsave, CAD_Solve2D_State.w, ArrayGet(CAD_Solve2D_State.xv, CAD_Solve2D_State.w))
            CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.RestoreX {
    Output: Integer
    Body: {
        CAD_Solve2D_State.w = 0
        WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.nvar) {
            ArraySet(CAD_Solve2D_State.xv, CAD_Solve2D_State.w, ArrayGet(CAD_Solve2D_State.xsave, CAD_Solve2D_State.w))
            CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
        }
        CAD_Solve2D.WriteAll()
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.AddDx {
    Output: Integer
    Body: {
        CAD_Solve2D_State.w = 0
        WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.nvar) {
            CAD_Solve2D_State.px = ArrayGet(CAD_Solve2D_State.xv, CAD_Solve2D_State.w)
            CAD_Solve2D_State.py = ArrayGet(CAD_Solve2D_State.dxv, CAD_Solve2D_State.w)
            ArraySet(CAD_Solve2D_State.xv, CAD_Solve2D_State.w, Float_Add(CAD_Solve2D_State.px, CAD_Solve2D_State.py))
            CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
        }
        CAD_Solve2D.WriteAll()
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.Settled {
    Output: Integer
    Body: {
        CAD_Solve2D_State.e0 = CAD_Solve2D.HardOk()
        IfCondition EqualTo(CAD_Solve2D_State.e0, 0) ThenBlock: { ReturnValue(0) }
        CAD_Solve2D_State.e0 = CAD_Solve2D.DragOk()
        ReturnValue(CAD_Solve2D_State.e0)
    }
}

Function.CAD_Solve2D.Finish {
    Input: code: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.rc = code
        CAD_Sketch_State.solved_dof = CAD_Solve2D_State.rank
        CAD_Solve2D_State.jacobian_size = Multiply(CAD_Solve2D_State.neq, CAD_Solve2D_State.nvar)
        CAD_Solve2D.MaxAbs()
        CAD_Sketch.RebuildAnchors(CAD_Solve2D_State.sk)
        CAD_Solve2D.FreeGraph()
        IfCondition EqualTo(CAD_Solve2D_State.rc, 0) ThenBlock: {
            CAD_Solve2D_State.converged_solves = Add(CAD_Solve2D_State.converged_solves, 1)
        }
        ReturnValue(CAD_Solve2D_State.rc)
    }
}

Function.CAD_Solve2D.LUDecompose {
    Input: a_matrix_addr: Address
    Input: n: Integer
    Input: out_l_addr: Address
    Input: out_u_addr: Address
    Output: Integer
    Body: {
        CAD_Solve2D_State.k0 = n
        CAD_Solve2D_State.p0 = a_matrix_addr
        CAD_Solve2D_State.p1 = out_l_addr
        CAD_Solve2D_State.p2 = out_u_addr
        IfCondition LessThan(CAD_Solve2D_State.k0, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_Solve2D_State.k0, 16) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_Solve2D_State.p0, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Solve2D.EnsureTol()
        CAD_Solve2D_State.rc = CAD_Solve2D.EnsureWork()
        IfCondition NotEqual(CAD_Solve2D_State.rc, 0) ThenBlock: { ReturnValue(-16) }
        CAD_Solve2D_State.e0 = Multiply(CAD_Solve2D_State.k0, CAD_Solve2D_State.k0)
        CAD_Solve2D_State.w = 0
        WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.e0) {
            ArraySet(CAD_Solve2D_State.lua, CAD_Solve2D_State.w, ArrayGet(CAD_Solve2D_State.p0, CAD_Solve2D_State.w))
            CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
        }
        CAD_Solve2D_State.rc = CAD_Num.LUDecompose(CAD_Solve2D_State.lua, CAD_Solve2D_State.k0, CAD_Solve2D_State.piv)
        CAD_Solve2D_State.lu_decomps = Add(CAD_Solve2D_State.lu_decomps, 1)
        IfCondition NotEqual(CAD_Solve2D_State.rc, 0) ThenBlock: {
            CAD_Solve2D_State.lu_n = 0
            ReturnValue(CAD_Solve2D_State.rc)
        }
        CAD_Solve2D_State.lu_n = CAD_Solve2D_State.k0
        CAD_Solve2D_State.i0 = 0
        WhileLoop LessThan(CAD_Solve2D_State.i0, CAD_Solve2D_State.k0) {
            CAD_Solve2D_State.j0 = 0
            WhileLoop LessThan(CAD_Solve2D_State.j0, CAD_Solve2D_State.k0) {
                CAD_Solve2D_State.px = CAD_Num.MatGet(CAD_Solve2D_State.lua, CAD_Solve2D_State.k0, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0)
                IfCondition LessThan(CAD_Solve2D_State.j0, CAD_Solve2D_State.i0) ThenBlock: {
                    CAD_Num.MatSet(CAD_Solve2D_State.p1, CAD_Solve2D_State.k0, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0, CAD_Solve2D_State.px)
                    CAD_Num.MatSet(CAD_Solve2D_State.p2, CAD_Solve2D_State.k0, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0, 0)
                }
                IfCondition EqualTo(CAD_Solve2D_State.j0, CAD_Solve2D_State.i0) ThenBlock: {
                    CAD_Num.MatSet(CAD_Solve2D_State.p1, CAD_Solve2D_State.k0, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0, 0x3FF0000000000000)
                    CAD_Num.MatSet(CAD_Solve2D_State.p2, CAD_Solve2D_State.k0, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0, CAD_Solve2D_State.px)
                }
                IfCondition GreaterThan(CAD_Solve2D_State.j0, CAD_Solve2D_State.i0) ThenBlock: {
                    CAD_Num.MatSet(CAD_Solve2D_State.p1, CAD_Solve2D_State.k0, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0, 0)
                    CAD_Num.MatSet(CAD_Solve2D_State.p2, CAD_Solve2D_State.k0, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0, CAD_Solve2D_State.px)
                }
                CAD_Solve2D_State.j0 = Add(CAD_Solve2D_State.j0, 1)
            }
            CAD_Solve2D_State.i0 = Add(CAD_Solve2D_State.i0, 1)
        }
        ReturnValue(0)
    }
}

// L and U are ignored. The factors and pivots are the ones LUDecompose stored.
Function.CAD_Solve2D.LUSolve {
    Input: l_addr: Address
    Input: u_addr: Address
    Input: b_vec_addr: Address
    Input: n: Integer
    Input: out_x_addr: Address
    Output: Integer
    Body: {
        CAD_Solve2D_State.k0 = n
        CAD_Solve2D_State.p0 = b_vec_addr
        CAD_Solve2D_State.p1 = out_x_addr
        IfCondition LessThan(CAD_Solve2D_State.k0, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_Solve2D_State.k0, 16) ThenBlock: { ReturnValue(-4) }
        IfCondition NotEqual(CAD_Solve2D_State.k0, CAD_Solve2D_State.lu_n) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_Solve2D_State.lua, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Solve2D_State.rc = CAD_Num.LUSolve(CAD_Solve2D_State.lua, CAD_Solve2D_State.k0, CAD_Solve2D_State.piv, CAD_Solve2D_State.p0, CAD_Solve2D_State.p1)
        ReturnValue(CAD_Solve2D_State.rc)
    }
}

Function.CAD_Solve2D.AssembleJacobian {
    Input: sketch_handle: Integer
    Input: n_constraints: Integer
    Input: m_variables: Integer
    Input: out_j_matrix_addr: Address
    Input: out_c_vec_addr: Address
    Output: Integer
    Body: {
        CAD_Solve2D_State.sk = sketch_handle
        CAD_Solve2D_State.p1 = out_j_matrix_addr
        CAD_Solve2D_State.p2 = out_c_vec_addr
        CAD_Solve2D_State.tol = 0
        CAD_Solve2D_State.capv = 16
        CAD_Solve2D_State.cape = 32
        IfCondition GreaterThan(m_variables, 0) ThenBlock: {
            IfCondition LessThan(m_variables, 16) ThenBlock: {
                CAD_Solve2D_State.capv = m_variables
            }
        }
        IfCondition GreaterThan(n_constraints, 0) ThenBlock: {
            IfCondition LessThan(n_constraints, 32) ThenBlock: {
                CAD_Solve2D_State.cape = n_constraints
            }
        }
        IfCondition EqualTo(CAD_Solve2D_State.sk, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Solve2D.EnsureTol()
        CAD_Solve2D_State.rc = CAD_Solve2D.EnsureWork()
        IfCondition NotEqual(CAD_Solve2D_State.rc, 0) ThenBlock: { ReturnValue(-16) }
        CAD_Solve2D_State.cstr = CAD_Store.Read(CAD_Solve2D_State.sk, 21)
        IfCondition EqualTo(CAD_Solve2D_State.cstr, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Solve2D_State.rc = CAD_Solve2D.Walk(0)
        IfCondition NotEqual(CAD_Solve2D_State.rc, 0) ThenBlock: { ReturnValue(CAD_Solve2D_State.rc) }
        CAD_Solve2D_State.rc = CAD_Solve2D.BuildGraph()
        IfCondition NotEqual(CAD_Solve2D_State.rc, 0) ThenBlock: {
            CAD_Solve2D.FreeGraph()
            ReturnValue(CAD_Solve2D_State.rc)
        }
        CAD_Solve2D.ReadAll()
        CAD_Solve2D.Walk(1)
        CAD_Solve2D.FillJ()
        IfCondition NotEqual(CAD_Solve2D_State.p2, 0) ThenBlock: {
            CAD_Solve2D_State.w = 0
            WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.neq) {
                ArraySet(CAD_Solve2D_State.p2, CAD_Solve2D_State.w, ArrayGet(CAD_Solve2D_State.res, CAD_Solve2D_State.w))
                CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
            }
        }
        CAD_Solve2D_State.e0 = Multiply(CAD_Solve2D_State.neq, CAD_Solve2D_State.nvar)
        CAD_Solve2D_State.jacobian_size = CAD_Solve2D_State.e0
        IfCondition NotEqual(CAD_Solve2D_State.p1, 0) ThenBlock: {
            CAD_Solve2D_State.w = 0
            WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.e0) {
                ArraySet(CAD_Solve2D_State.p1, CAD_Solve2D_State.w, ArrayGet(CAD_Solve2D_State.jj, CAD_Solve2D_State.w))
                CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
            }
        }
        CAD_Solve2D.FreeGraph()
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.SolveNewtonRaphson {
    Input: sketch_handle: Integer
    Input: n_vars: Integer
    Input: max_iter: Integer
    Input: tol_r: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.sk = sketch_handle
        CAD_Solve2D_State.tol = tol_r
        CAD_Solve2D_State.capv = 16
        CAD_Solve2D_State.cape = 32
        CAD_Solve2D_State.iters = max_iter
        IfCondition GreaterThan(n_vars, 0) ThenBlock: {
            IfCondition LessThan(n_vars, 16) ThenBlock: {
                CAD_Solve2D_State.capv = n_vars
            }
        }
        IfCondition LessThan(CAD_Solve2D_State.iters, 1) ThenBlock: {
            CAD_Solve2D_State.iters = 40
        }
        IfCondition GreaterThan(CAD_Solve2D_State.iters, 80) ThenBlock: {
            CAD_Solve2D_State.iters = 80
        }
        IfCondition EqualTo(CAD_Solve2D_State.sk, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Solve2D.EnsureTol()
        CAD_Solve2D_State.rc = CAD_Solve2D.EnsureWork()
        IfCondition NotEqual(CAD_Solve2D_State.rc, 0) ThenBlock: { ReturnValue(-16) }
        CAD_Solve2D_State.solves_run = Add(CAD_Solve2D_State.solves_run, 1)
        CAD_Sketch.SolveDatum(CAD_Solve2D_State.sk)
        CAD_Solve2D_State.rc = CAD_Solve2D.Walk(0)
        IfCondition NotEqual(CAD_Solve2D_State.rc, 0) ThenBlock: {
            ReturnValue(CAD_Solve2D_State.rc)
        }
        IfCondition EqualTo(CAD_Solve2D_State.nvar, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.neq, 0) ThenBlock: {
                CAD_Solve2D_State.rank = 0
                CAD_Sketch_State.solved_dof = 0
                CAD_Solve2D_State.jacobian_size = 0
                CAD_Solve2D_State.ring_n = 0
                CAD_Solve2D_State.converged_solves = Add(CAD_Solve2D_State.converged_solves, 1)
                ReturnValue(0)
            }
            ReturnValue(-8)
        }
        CAD_Solve2D.ReadAll()
        CAD_Solve2D.Walk(1)
        CAD_Solve2D.BuildGraph()
        CAD_Solve2D_State.e0 = CAD_Solve2D.Settled()
        IfCondition EqualTo(CAD_Solve2D_State.e0, 0) ThenBlock: {
            CAD_Solve2D_State.lam = 0x3F847AE147AE147B
            CAD_Solve2D_State.iter = 0
            CAD_Solve2D_State.ok = 0
            WhileLoop EqualTo(CAD_Solve2D_State.ok, 0) {
                IfCondition GreaterEqual(CAD_Solve2D_State.iter, CAD_Solve2D_State.iters) ThenBlock: {
                    CAD_Solve2D_State.ok = 2
                }
                IfCondition EqualTo(CAD_Solve2D_State.ok, 0) ThenBlock: {
                    CAD_Solve2D.ReadAll()
                    CAD_Solve2D.Walk(1)
                    CAD_Solve2D.Ss()
                    CAD_Solve2D_State.ss0 = CAD_Solve2D_State.ss1
                    CAD_Solve2D.FillJ()
                    CAD_Solve2D.BuildGraph()
                    CAD_Solve2D_State.acc = 0
                    CAD_Solve2D_State.trial = 0
                    WhileLoop LessThan(CAD_Solve2D_State.trial, 6) {
                        IfCondition EqualTo(CAD_Solve2D_State.acc, 0) ThenBlock: {
                            CAD_Solve2D.BuildNormal()
                            CAD_Solve2D_State.rc = CAD_Num.LUDecompose(CAD_Solve2D_State.aa, CAD_Solve2D_State.nvar, CAD_Solve2D_State.piv)
                            IfCondition NotEqual(CAD_Solve2D_State.rc, 0) ThenBlock: {
                                CAD_Solve2D.GrowLam()
                            }
                            IfCondition EqualTo(CAD_Solve2D_State.rc, 0) ThenBlock: {
                                CAD_Num.LUSolve(CAD_Solve2D_State.aa, CAD_Solve2D_State.nvar, CAD_Solve2D_State.piv, CAD_Solve2D_State.rhs, CAD_Solve2D_State.dxv)
                                CAD_Solve2D.SaveX()
                                CAD_Solve2D.AddDx()
                                CAD_Solve2D.Walk(1)
                                CAD_Solve2D.Ss()
                                IfCondition EqualTo(Float_Le(CAD_Solve2D_State.ss1, CAD_Solve2D_State.ss0), 1) ThenBlock: {
                                    CAD_Solve2D_State.acc = 1
                                    CAD_Solve2D_State.ss0 = CAD_Solve2D_State.ss1
                                    CAD_Solve2D.ShrinkLam()
                                }
                                IfCondition EqualTo(Float_Le(CAD_Solve2D_State.ss1, CAD_Solve2D_State.ss0), 0) ThenBlock: {
                                    CAD_Solve2D.RestoreX()
                                    CAD_Solve2D.Walk(1)
                                    CAD_Solve2D.GrowLam()
                                }
                            }
                        }
                        CAD_Solve2D_State.trial = Add(CAD_Solve2D_State.trial, 1)
                    }
                    CAD_Solve2D.Walk(1)
                    CAD_Solve2D_State.e0 = CAD_Solve2D.Settled()
                    IfCondition EqualTo(CAD_Solve2D_State.e0, 1) ThenBlock: {
                        CAD_Solve2D_State.ok = 1
                    }
                    CAD_Solve2D_State.iter = Add(CAD_Solve2D_State.iter, 1)
                }
            }
        }
        CAD_Solve2D.ReadAll()
        CAD_Solve2D.Walk(1)
        CAD_Solve2D.FillJ()
        CAD_Solve2D.RankJ()
        CAD_Solve2D_State.e0 = CAD_Solve2D.HardOk()
        IfCondition EqualTo(CAD_Solve2D_State.e0, 1) ThenBlock: {
            ReturnValue(CAD_Solve2D.Finish(0))
        }
        ReturnValue(CAD_Solve2D.Finish(-8))
    }
}

Function.CAD_Solve2D.SetDrag {
    Input: kind: Integer
    Input: id: Integer
    Input: x_r: Integer
    Input: y_r: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.drag_on = 1
        CAD_Solve2D_State.drag_kind = kind
        CAD_Solve2D_State.drag_id = id
        CAD_Solve2D_State.drag_x = x_r
        CAD_Solve2D_State.drag_y = y_r
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.ClearDrag {
    Output: Integer
    Body: {
        CAD_Solve2D_State.drag_on = 0
        ReturnValue(0)
    }
}

// Translate one point by (dx, dy) as a weak row, then resolve.
Function.CAD_Solve2D.MovePoint {
    Input: sketch_handle: Integer
    Input: kind: Integer
    Input: id: Integer
    Input: dx_r: Integer
    Input: dy_r: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.sk = sketch_handle
        CAD_Solve2D_State.ka = kind
        CAD_Solve2D_State.ia = id
        CAD_Solve2D_State.px = dx_r
        CAD_Solve2D_State.py = dy_r
        IfCondition EqualTo(CAD_Solve2D_State.sk, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Solve2D.EnsureTol()
        CAD_Solve2D_State.rc = CAD_Solve2D.EnsureWork()
        IfCondition NotEqual(CAD_Solve2D_State.rc, 0) ThenBlock: { ReturnValue(-16) }
        CAD_Sketch.GetTargetXY(CAD_Solve2D_State.sk, CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, CAD_Solve2D_State.xy)
        CAD_Solve2D_State.ax = ArrayGet(CAD_Solve2D_State.xy, 0)
        CAD_Solve2D_State.ay = ArrayGet(CAD_Solve2D_State.xy, 1)
        CAD_Solve2D_State.ax = Float_Add(CAD_Solve2D_State.ax, CAD_Solve2D_State.px)
        CAD_Solve2D_State.ay = Float_Add(CAD_Solve2D_State.ay, CAD_Solve2D_State.py)
        CAD_Solve2D.SetDrag(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, CAD_Solve2D_State.ax, CAD_Solve2D_State.ay)
        CAD_Solve2D_State.rc = CAD_Solve2D.SolveNewtonRaphson(CAD_Solve2D_State.sk, 0, 80, 0)
        CAD_Solve2D.ClearDrag()
        ReturnValue(CAD_Solve2D_State.rc)
    }
}

LibraryImport.Cad.Solve2D.CAD_Solve2DJac
