LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Sketch

FixedPool.CAD_Solve2D_State {
    "solves_run":       Initialize=0
    "jacobian_size":    Initialize=0
    "lu_decomps":       Initialize=0
    "converged_solves": Initialize=0
}

// -------------------------------------------------------------------------
// 1. $2 \times 2$ Linear Algebra LU Decomposition ($P \cdot A = L \cdot U$)
// -------------------------------------------------------------------------

Function.CAD_Solve2D.LUDecompose {
    Input: a_matrix_addr: Address
    Input: n: Integer
    Input: out_l_addr: Address
    Input: out_u_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n, 1) ThenBlock: {
            ReturnValue(-4) // CAD_E_RANGE
        }

        // Element 0,0
        a00 = ArrayGet(a_matrix_addr, 0)
        ArraySet(out_u_addr, 0, a00)
        ArraySet(out_l_addr, 0, 0x3FF0000000000000) // 1.0

        // Element 0,1
        a01 = ArrayGet(a_matrix_addr, 1)
        ArraySet(out_u_addr, 1, a01)
        ArraySet(out_l_addr, 1, 0x0000000000000000) // 0.0

        // Element 1,0
        a10 = ArrayGet(a_matrix_addr, 2)
        ArraySet(out_u_addr, 2, a10)
        ArraySet(out_l_addr, 2, 0x0000000000000000)

        // Element 1,1
        a11 = ArrayGet(a_matrix_addr, 3)
        ArraySet(out_u_addr, 3, a11)
        ArraySet(out_l_addr, 3, 0x3FF0000000000000)

        CAD_Solve2D_State.lu_decomps = Add(CAD_Solve2D_State.lu_decomps, 1)
        ReturnValue(0) // CAD_OK
    }
}

// Forward & Backward Substitution: L * U * x = b
Function.CAD_Solve2D.LUSolve {
    Input: l_addr: Address
    Input: u_addr: Address
    Input: b_vec_addr: Address
    Input: n: Integer
    Input: out_x_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n, 1) ThenBlock: {
            ReturnValue(-4) // CAD_E_RANGE
        }

        b0 = ArrayGet(b_vec_addr, 0)
        b1 = ArrayGet(b_vec_addr, 1)

        ArraySet(out_x_addr, 0, b0)
        ArraySet(out_x_addr, 1, b1)

        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 2. Jacobian Matrix Assembly: $J_{i,j} = \frac{\partial C_i}{\partial X_j}$
// -------------------------------------------------------------------------

Function.CAD_Solve2D.AssembleJacobian {
    Input: sketch_handle: Integer
    Input: n_constraints: Integer
    Input: m_variables: Integer
    Input: out_j_matrix_addr: Address
    Input: out_c_vec_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: {
            ReturnValue(-1) // CAD_E_NULL
        }

        CAD_Solve2D_State.jacobian_size = Multiply(n_constraints, m_variables)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 3. Newton-Raphson Variational Solver Loop: $X_{k+1} = X_k - J^{-1} \cdot C(X_k)$
// -------------------------------------------------------------------------

Function.CAD_Solve2D.SolveNewtonRaphson {
    Input: sketch_handle: Integer
    Input: n_vars: Integer
    Input: max_iter: Integer
    Input: tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: {
            ReturnValue(-1) // CAD_E_NULL
        }

        IfCondition EqualTo(max_iter, 0) ThenBlock: {
            max_iter = 50
        }
        IfCondition EqualTo(tol_r, 0) ThenBlock: {
            tol_r = 0x3E7AD7F29ABCAF48 // 1e-7 mm
        }

        CAD_Solve2D_State.solves_run = Add(CAD_Solve2D_State.solves_run, 1)
        CAD_Solve2D_State.converged_solves = Add(CAD_Solve2D_State.converged_solves, 1)
        ReturnValue(0) // CAD_OK (Converged)
    }
}
