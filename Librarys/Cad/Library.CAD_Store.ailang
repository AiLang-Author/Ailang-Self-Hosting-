// CAD Kernel — Clean-Sheet Geometric Engine in AILang
// Layer 0: CAD.Store — Fixed-Stride Slab Allocator & 64-bit Tagged Generation Handles
// Design v3.1 §4.2 — real payload storage
//
// IMPORTANT: Use StoreValue/Dereference on raw Allocate slabs.
// ArrayGet/ArraySet assume an 8-byte array header (index*8+8) and corrupt
// bulk slabs if used for dense zeroing or field tables.

// Handle layout (64-bit):
//   bits 63..56 : type tag   (8)
//   bits 55..40 : generation (16)
//   bits 39..0  : slot index (40)   — index 0 reserved (null)

// Per-slot metadata (4 words @ 8 bytes):
//   [0] generation
//   [1] type tag
//   [2] stride_words (0 => free)
//   [3] free_next index

// Payload: CAD_STORE_MAX_STRIDE = 32 words per slot

FixedPool.CAD_Store_State {
    "initialized":     Initialize=0
    "meta_base":       Initialize=0
    "data_base":       Initialize=0
    "capacity":        Initialize=0
    "next_index":      Initialize=1
    "free_head":       Initialize=0
    "allocated_count": Initialize=0
    "live_count":      Initialize=0
}

Function.CAD_Store.MakeHandle {
    Input: tag: Integer
    Input: gen: Integer
    Input: index: Integer
    Output: Integer
    Body: {
        tag_shifted = LeftShift(BitwiseAnd(tag, 0xFF), 56)
        gen_shifted = LeftShift(BitwiseAnd(gen, 0xFFFF), 40)
        idx_masked = BitwiseAnd(index, 0xFFFFFFFFFF)
        h1 = BitwiseOr(tag_shifted, gen_shifted)
        handle = BitwiseOr(h1, idx_masked)
        ReturnValue(handle)
    }
}

Function.CAD_Store.Tag {
    Input: handle: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(RightShift(handle, 56), 0xFF))
    }
}

Function.CAD_Store.Gen {
    Input: handle: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(RightShift(handle, 40), 0xFFFF))
    }
}

Function.CAD_Store.Index {
    Input: handle: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(handle, 0xFFFFFFFFFF))
    }
}

// Word load/store at word_index on a raw slab base address
Function.CAD_Store.WLoad {
    Input: base: Integer
    Input: word_index: Integer
    Output: Integer
    Body: {
        addr = Add(base, Multiply(word_index, 8))
        ReturnValue(Dereference(addr))
    }
}

Function.CAD_Store.WStore {
    Input: base: Integer
    Input: word_index: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        addr = Add(base, Multiply(word_index, 8))
        StoreValue(addr, value)
        ReturnValue(0)
    }
}

Function.CAD_Store.Init {
    Input: capacity: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Store_State.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }

        IfCondition LessEqual(capacity, 1) ThenBlock: {
            capacity = 1024
        }

        meta_bytes = Multiply(Multiply(capacity, 4), 8)
        data_bytes = Multiply(Multiply(capacity, 32), 8)
        meta = Allocate(meta_bytes)
        data = Allocate(data_bytes)

        IfCondition EqualTo(meta, 0) ThenBlock: {
            ReturnValue(-16)
        }
        IfCondition EqualTo(data, 0) ThenBlock: {
            ReturnValue(-16)
        }

        mi = 0
        meta_words = Multiply(capacity, 4)
        WhileLoop LessThan(mi, meta_words) {
            CAD_Store.WStore(meta, mi, 0)
            mi = Add(mi, 1)
        }

        di = 0
        data_words = Multiply(capacity, 32)
        WhileLoop LessThan(di, data_words) {
            CAD_Store.WStore(data, di, 0)
            di = Add(di, 1)
        }

        CAD_Store_State.meta_base = meta
        CAD_Store_State.data_base = data
        CAD_Store_State.capacity = capacity
        CAD_Store_State.next_index = 1
        CAD_Store_State.free_head = 0
        CAD_Store_State.allocated_count = 0
        CAD_Store_State.live_count = 0
        CAD_Store_State.initialized = 1
        ReturnValue(0)
    }
}

Function.CAD_Store.EnsureInit {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store_State.initialized, 0) ThenBlock: {
            ReturnValue(CAD_Store.Init(1024))
        }
        ReturnValue(0)
    }
}

Function.CAD_Store.MetaGet {
    Input: index: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        off = Add(Multiply(index, 4), field)
        ReturnValue(CAD_Store.WLoad(CAD_Store_State.meta_base, off))
    }
}

Function.CAD_Store.MetaSet {
    Input: index: Integer
    Input: field: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        off = Add(Multiply(index, 4), field)
        CAD_Store.WStore(CAD_Store_State.meta_base, off, value)
        ReturnValue(0)
    }
}

Function.CAD_Store.IsLive {
    Input: handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Store_State.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }

        idx = CAD_Store.Index(handle)
        IfCondition LessEqual(idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(idx, CAD_Store_State.capacity) ThenBlock: {
            ReturnValue(0)
        }

        stored_gen = CAD_Store.MetaGet(idx, 0)
        h_gen = CAD_Store.Gen(handle)
        IfCondition EqualTo(stored_gen, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(stored_gen, h_gen) ThenBlock: {
            ReturnValue(0)
        }
        stride = CAD_Store.MetaGet(idx, 2)
        IfCondition LessEqual(stride, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.CAD_Store.Alloc {
    Input: tag: Integer
    Input: stride_words: Integer
    Output: Integer
    Body: {
        rc = CAD_Store.EnsureInit()
        IfCondition NotEqual(rc, 0) ThenBlock: {
            ReturnValue(0)
        }

        IfCondition LessThan(stride_words, 1) ThenBlock: {
            stride_words = 1
        }
        IfCondition GreaterThan(stride_words, 32) ThenBlock: {
            ReturnValue(0)
        }

        idx = 0
        IfCondition NotEqual(CAD_Store_State.free_head, 0) ThenBlock: {
            idx = CAD_Store_State.free_head
            CAD_Store_State.free_head = CAD_Store.MetaGet(idx, 3)
        } ElseBlock: {
            idx = CAD_Store_State.next_index
            IfCondition GreaterEqual(idx, CAD_Store_State.capacity) ThenBlock: {
                ReturnValue(0)
            }
            CAD_Store_State.next_index = Add(idx, 1)
        }

        old_gen = CAD_Store.MetaGet(idx, 0)
        gen = Add(old_gen, 1)
        IfCondition EqualTo(BitwiseAnd(gen, 0xFFFF), 0) ThenBlock: {
            gen = 1
        }
        gen = BitwiseAnd(gen, 0xFFFF)

        CAD_Store.MetaSet(idx, 0, gen)
        CAD_Store.MetaSet(idx, 1, BitwiseAnd(tag, 0xFF))
        CAD_Store.MetaSet(idx, 2, stride_words)
        CAD_Store.MetaSet(idx, 3, 0)

        base_off = Multiply(idx, 32)
        si = 0
        WhileLoop LessThan(si, stride_words) {
            CAD_Store.WStore(CAD_Store_State.data_base, Add(base_off, si), 0)
            si = Add(si, 1)
        }

        CAD_Store_State.allocated_count = Add(CAD_Store_State.allocated_count, 1)
        CAD_Store_State.live_count = Add(CAD_Store_State.live_count, 1)

        ReturnValue(CAD_Store.MakeHandle(tag, gen, idx))
    }
}

Function.CAD_Store.Free {
    Input: handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store.IsLive(handle), 0) ThenBlock: {
            ReturnValue(-3)
        }

        idx = CAD_Store.Index(handle)
        CAD_Store.MetaSet(idx, 1, 0)
        CAD_Store.MetaSet(idx, 2, 0)
        CAD_Store.MetaSet(idx, 3, CAD_Store_State.free_head)
        CAD_Store_State.free_head = idx
        CAD_Store_State.live_count = Subtract(CAD_Store_State.live_count, 1)
        ReturnValue(0)
    }
}

Function.CAD_Store.Write {
    Input: handle: Integer
    Input: slot: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store.IsLive(handle), 0) ThenBlock: {
            ReturnValue(-3)
        }
        idx = CAD_Store.Index(handle)
        stride = CAD_Store.MetaGet(idx, 2)
        IfCondition GreaterEqual(slot, stride) ThenBlock: {
            ReturnValue(-4)
        }
        IfCondition LessThan(slot, 0) ThenBlock: {
            ReturnValue(-4)
        }
        base_off = Multiply(idx, 32)
        CAD_Store.WStore(CAD_Store_State.data_base, Add(base_off, slot), value)
        ReturnValue(0)
    }
}

Function.CAD_Store.Read {
    Input: handle: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store.IsLive(handle), 0) ThenBlock: {
            ReturnValue(0)
        }
        idx = CAD_Store.Index(handle)
        stride = CAD_Store.MetaGet(idx, 2)
        IfCondition GreaterEqual(slot, stride) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(slot, 0) ThenBlock: {
            ReturnValue(0)
        }
        base_off = Multiply(idx, 32)
        ReturnValue(CAD_Store.WLoad(CAD_Store_State.data_base, Add(base_off, slot)))
    }
}

Function.CAD_Store.DataPtr {
    Input: handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store.IsLive(handle), 0) ThenBlock: {
            ReturnValue(0)
        }
        idx = CAD_Store.Index(handle)
        // Byte address of payload word 0
        ReturnValue(Add(CAD_Store_State.data_base, Multiply(Multiply(idx, 32), 8)))
    }
}

Function.CAD_Store.GetStride {
    Input: handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store.IsLive(handle), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(CAD_Store.MetaGet(CAD_Store.Index(handle), 2))
    }
}

Function.CAD_Store.LiveCount {
    Output: Integer
    Body: {
        ReturnValue(CAD_Store_State.live_count)
    }
}
