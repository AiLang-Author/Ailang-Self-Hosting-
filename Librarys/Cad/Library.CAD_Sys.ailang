FixedPool.CAD_Sys_State {
    "last_syscall_ret": Initialize=0
}

Function.CAD_Sys.Open {
    Input: filename_addr: Address
    Input: flags: Integer
    Input: mode: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, filename_addr, flags, mode)
        CAD_Sys_State.last_syscall_ret = fd
        ReturnValue(fd)
    }
}

Function.CAD_Sys.Read {
    Input: fd: Integer
    Input: buf_addr: Address
    Input: count: Integer
    Output: Integer
    Body: {
        bytes_read = SystemCall(0, fd, buf_addr, count)
        CAD_Sys_State.last_syscall_ret = bytes_read
        ReturnValue(bytes_read)
    }
}

Function.CAD_Sys.Write {
    Input: fd: Integer
    Input: buf_addr: Address
    Input: count: Integer
    Output: Integer
    Body: {
        bytes_written = SystemCall(1, fd, buf_addr, count)
        CAD_Sys_State.last_syscall_ret = bytes_written
        ReturnValue(bytes_written)
    }
}

Function.CAD_Sys.Close {
    Input: fd: Integer
    Output: Integer
    Body: {
        ret = SystemCall(3, fd)
        CAD_Sys_State.last_syscall_ret = ret
        ReturnValue(ret)
    }
}
