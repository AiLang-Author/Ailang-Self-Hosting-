// CAD Kernel — CAD.Tess — Mesh generation + ASCII STL export
// SysV: ≤5 Inputs. Flat control flow.
// Mesh buffer layout (out_mesh_addr words):
//   [0] n_verts
//   [1] n_tris
//   [2] v_base   — Address of n_verts*3 doubles (xyz…)
//   [3] i_base   — Address of n_tris*3 integers (i0 i1 i2…)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.StringUtils

FixedPool.CAD_Tess_State {
    "tess_count":     Initialize=0
    "triangle_count": Initialize=0
    "vertex_count":   Initialize=0
    "punch_q":        Initialize=0
    "punch_s":        Initialize=0
    "v_base":         Initialize=0, CanChange=True
    "i_base":         Initialize=0, CanChange=True
    "pack":           Initialize=0, CanChange=True
    "oidx":           Initialize=0, CanChange=True
    "hidx":           Initialize=0, CanChange=True
    "bridged":        Initialize=0, CanChange=True
    "samp":           Initialize=0, CanChange=True
    "clean":          Initialize=0, CanChange=True
    "ep":             Initialize=0, CanChange=True
    "merge_hc":       Initialize=0, CanChange=True
    "nout":           Initialize=0, CanChange=True
    "nh":             Initialize=0, CanChange=True
    "nring":          Initialize=0, CanChange=True
    "inner":          Initialize=0, CanChange=True
    "flip":           Initialize=0, CanChange=True
    "want_h":         Initialize=0, CanChange=True
    "holes_ok":       Initialize=0, CanChange=True
    "use_zip":        Initialize=0, CanChange=True
    "nn":             Initialize=0, CanChange=True
    "pi":             Initialize=0, CanChange=True
    "tess_face":      Initialize=0, CanChange=True
    "tess_sh":        Initialize=0, CanChange=True
    "tess_loop":      Initialize=0, CanChange=True
}

Function.CAD_Tess.SolidBufs {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Tess_State.v_base, 0) ThenBlock: { CAD_Tess_State.v_base = Allocate(2097152) }
        IfCondition EqualTo(CAD_Tess_State.i_base, 0) ThenBlock: { CAD_Tess_State.i_base = Allocate(1048576) }
        IfCondition EqualTo(CAD_Tess_State.pack, 0) ThenBlock: { CAD_Tess_State.pack = Allocate(16) }
        IfCondition EqualTo(CAD_Tess_State.v_base, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Tess_State.i_base, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.CAD_Tess.FaceBufs {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Tess_State.oidx, 0) ThenBlock: { CAD_Tess_State.oidx = Allocate(16384) }
        IfCondition EqualTo(CAD_Tess_State.hidx, 0) ThenBlock: { CAD_Tess_State.hidx = Allocate(16384) }
        IfCondition EqualTo(CAD_Tess_State.bridged, 0) ThenBlock: { CAD_Tess_State.bridged = Allocate(32768) }
        IfCondition EqualTo(CAD_Tess_State.clean, 0) ThenBlock: { CAD_Tess_State.clean = Allocate(16384) }
        IfCondition EqualTo(CAD_Tess_State.ep, 0) ThenBlock: { CAD_Tess_State.ep = Allocate(16) }
        IfCondition EqualTo(CAD_Tess_State.merge_hc, 0) ThenBlock: { CAD_Tess_State.merge_hc = Allocate(16384) }
        IfCondition EqualTo(CAD_Tess_State.oidx, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Tess_State.merge_hc, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.CAD_Tess.WriteStr {
    Input: fd: Integer
    Input: str: Address
    Output: Integer
    Body: {
        len = StringLength(str)
        CAD_Sys.Write(fd, str, len)
        ReturnValue(0)
    }
}

// Segments for a circle of radius r so chordal deviation ≤ defl.
// n ≈ π * sqrt(r / (2δ)) from δ = r(1-cos(π/n)) ≈ r·(π/n)²/2
// Hard fixed-n is wrong at large diameter — derive from (r, defl), then apply
// a visual floor (angular step ≤ ~4° → n≥90) so small parts don't look 1978.
// Clamped [n_min, 256]. Cap hit → need analytic surface tess later.
Function.CAD_Tess.CircleSegCount {
    Input: radius_r: Integer
    Input: defl_r: Integer
    Output: Integer
    Body: {
        // visual floor: ~4° max step (360/4 = 90) — FreeCAD flat-shade shows chords
        n_min = 90
        r = BitwiseAnd(radius_r, 0x7FFFFFFFFFFFFFFF)
        IfCondition EqualTo(CAD_Num.IsZero(r, 0), 1) ThenBlock: {
            ReturnValue(n_min)
        }
        d = BitwiseAnd(defl_r, 0x7FFFFFFFFFFFFFFF)
        // default display deflection 0.02 mm if unset (0.1mm only gave ~23 segs at r=10)
        IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
            d = 0x3F947AE147AE147B
        }
        // if defl >= r, still keep visual floor
        IfCondition EqualTo(Float_Le(r, d), 1) ThenBlock: {
            ReturnValue(n_min)
        }
        // n = pi * sqrt(r / (2*d))
        two_d = Float_Mul(0x4000000000000000, d)
        ratio = Float_Div(r, two_d)
        root = CAD_Num.Sqrt(ratio)
        pi_r = 0x400921FB54442D18
        nf = Float_Mul(pi_r, root)
        nf = Float_Add(nf, 0x3FEFFF2E48E8A7E4)
        n = Float_ToInt(nf)
        IfCondition LessThan(n, n_min) ThenBlock: { n = n_min }
        IfCondition GreaterThan(n, 256) ThenBlock: { n = 256 }
        ReturnValue(n)
    }
}

// Write double with 3 decimal places (cylinder chords need sub-mm digits)
Function.CAD_Tess.WriteFloat {
    Input: fd: Integer
    Input: val_r: Integer
    Output: Integer
    Body: {
        // sign
        signb = BitwiseAnd(val_r, 0x8000000000000000)
        IfCondition NotEqual(signb, 0) ThenBlock: {
            CAD_Tess.WriteStr(fd, "-")
            val_r = BitwiseAnd(val_r, 0x7FFFFFFFFFFFFFFF)
        }
        // integer part
        iv = Float_ToInt(val_r)
        s = NumberToString(iv)
        CAD_Tess.WriteStr(fd, s)
        CAD_Tess.WriteStr(fd, ".")
        // fractional * 1000, rounded
        whole_r = Float_FromInt(iv)
        frac_r = Float_Sub(val_r, whole_r)
        scaled = Float_Mul(frac_r, 0x408F400000000000)
        // 0x408F400000000000 = 1000.0
        half = 0x3FE0000000000000
        scaled = Float_Add(scaled, half)
        milli = Float_ToInt(scaled)
        IfCondition GreaterThan(milli, 999) ThenBlock: {
            milli = 999
        }
        IfCondition LessThan(milli, 0) ThenBlock: {
            milli = 0
        }
        // zero-pad to 3 digits
        IfCondition LessThan(milli, 100) ThenBlock: {
            CAD_Tess.WriteStr(fd, "0")
        }
        IfCondition LessThan(milli, 10) ThenBlock: {
            CAD_Tess.WriteStr(fd, "0")
        }
        sm = NumberToString(milli)
        CAD_Tess.WriteStr(fd, sm)
        ReturnValue(0)
    }
}

Function.CAD_Tess.WriteFacet {
    Input: fd: Integer
    Input: nx: Integer
    Input: ny: Integer
    Input: nz: Integer
    Input: tri_addr: Address
    Output: Integer
    Body: {
        // tri_addr: 9 doubles v0x v0y v0z v1x… v2z
        CAD_Tess.WriteStr(fd, "  facet normal ")
        CAD_Tess.WriteFloat(fd, nx)
        CAD_Tess.WriteStr(fd, " ")
        CAD_Tess.WriteFloat(fd, ny)
        CAD_Tess.WriteStr(fd, " ")
        CAD_Tess.WriteFloat(fd, nz)
        CAD_Tess.WriteStr(fd, "\n    outer loop\n")
        k = 0
        WhileLoop LessThan(k, 3) {
            CAD_Tess.WriteStr(fd, "      vertex ")
            o = Multiply(k, 3)
            CAD_Tess.WriteFloat(fd, ArrayGet(tri_addr, o))
            CAD_Tess.WriteStr(fd, " ")
            CAD_Tess.WriteFloat(fd, ArrayGet(tri_addr, Add(o, 1)))
            CAD_Tess.WriteStr(fd, " ")
            CAD_Tess.WriteFloat(fd, ArrayGet(tri_addr, Add(o, 2)))
            CAD_Tess.WriteStr(fd, "\n")
            k = Add(k, 1)
        }
        CAD_Tess.WriteStr(fd, "    endloop\n  endfacet\n")
        ReturnValue(0)
    }
}

// Emit 2 triangles for a 4-coedge loop into mesh buffers
// Returns updated tri count
Function.CAD_Tess.FanQuad {
    Input: loop_h: Integer
    Input: v_base: Address
    Input: i_base: Address
    Input: vert_count: Integer
    Input: tri_count: Integer
    Output: Integer
    Body: {
        // Collect 4 vertex handles from loop
        head = CAD_Store.Read(loop_h, 0)
        ce = head
        // Store up to 4 origin vertex handles then resolve points
        // We append unique verts by always pushing 4 corners (may duplicate verts — OK for STL)
        // Map: get origin from coedge slot 5, read point into next free verts
        base_v = vert_count
        k = 0
        WhileLoop LessThan(k, 4) {
            origin = CAD_Store.Read(ce, 5)
            px = CAD_Store.Read(origin, 0)
            py = CAD_Store.Read(origin, 1)
            pz = CAD_Store.Read(origin, 2)
            vo = Multiply(Add(base_v, k), 3)
            ArraySet(v_base, vo, px)
            ArraySet(v_base, Add(vo, 1), py)
            ArraySet(v_base, Add(vo, 2), pz)
            ce = CAD_Store.Read(ce, 2)
            k = Add(k, 1)
        }
        // tris: (0,1,2) (0,2,3) relative to base_v
        t0 = Multiply(tri_count, 3)
        ArraySet(i_base, t0, base_v)
        ArraySet(i_base, Add(t0, 1), Add(base_v, 1))
        ArraySet(i_base, Add(t0, 2), Add(base_v, 2))
        t1 = Multiply(Add(tri_count, 1), 3)
        ArraySet(i_base, t1, base_v)
        ArraySet(i_base, Add(t1, 1), Add(base_v, 2))
        ArraySet(i_base, Add(t1, 2), Add(base_v, 3))
        ReturnValue(Add(tri_count, 2))
    }
}

// Triangle-fan any n-gon loop (n>=3). Returns new tri_count.
// Also updates verts starting at vert_count (caller advances verts by n).
Function.CAD_Tess.FanNGon {
    Input: loop_h: Integer
    Input: n: Integer
    Input: v_base: Address
    Input: i_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        // pack_addr[0]=vert_count in, [1]=tri_count in; out return tri_count
        vert_count = ArrayGet(pack_addr, 0)
        tri_count = ArrayGet(pack_addr, 1)
        head = CAD_Store.Read(loop_h, 0)
        ce = head
        k = 0
        base_v = vert_count
        WhileLoop LessThan(k, n) {
            origin = CAD_Store.Read(ce, 5)
            vo = Multiply(Add(base_v, k), 3)
            ArraySet(v_base, vo, CAD_Store.Read(origin, 0))
            ArraySet(v_base, Add(vo, 1), CAD_Store.Read(origin, 1))
            ArraySet(v_base, Add(vo, 2), CAD_Store.Read(origin, 2))
            ce = CAD_Store.Read(ce, 2)
            k = Add(k, 1)
        }
        // fan: (0, i, i+1) for i=1..n-2
        i = 1
        WhileLoop LessThan(i, Subtract(n, 1)) {
            t0 = Multiply(tri_count, 3)
            ArraySet(i_base, t0, base_v)
            ArraySet(i_base, Add(t0, 1), Add(base_v, i))
            ArraySet(i_base, Add(t0, 2), Add(base_v, Add(i, 1)))
            tri_count = Add(tri_count, 1)
            i = Add(i, 1)
        }
        ArraySet(pack_addr, 0, Add(vert_count, n))
        ArraySet(pack_addr, 1, tri_count)
        ReturnValue(tri_count)
    }
}

// Fan a loop, tessellating circle/ellipse coedges (fillet end walls).
// Straight FanNGon on those walls used a CHORD and left the cylinder open.
Function.CAD_Tess.MeshLoopFanTess {
    Input: loop_h: Integer
    Input: v_base: Address
    Input: i_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(loop_h, 0) ThenBlock: { ReturnValue(ArrayGet(pack_addr, 1)) }
        vert_count = ArrayGet(pack_addr, 0)
        tri_count = ArrayGet(pack_addr, 1)
        base_v = vert_count
        nn = 0
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(512) }
        samp = CAD_Tess_State.samp
        IfCondition EqualTo(samp, 0) ThenBlock: { ReturnValue(tri_count) }
        head = CAD_Store.Read(loop_h, 0)
        ce = head
        cg = 0
        dn = 0
        WhileLoop EqualTo(dn, 0) {
            orig = CAD_Store.Read(ce, 5)
            IfCondition NotEqual(orig, 0) ThenBlock: {
                IfCondition LessThan(nn, 2048) ThenBlock: {
                    vo = Multiply(Add(base_v, nn), 3)
                    ArraySet(v_base, vo, CAD_Store.Read(orig, 0))
                    ArraySet(v_base, Add(vo, 1), CAD_Store.Read(orig, 1))
                    ArraySet(v_base, Add(vo, 2), CAD_Store.Read(orig, 2))
                    nn = Add(nn, 1)
                }
            }
            ed = CAD_Store.Read(ce, 0)
            IfCondition NotEqual(ed, 0) ThenBlock: {
                crv = CAD_Store.Read(ed, 2)
                IfCondition NotEqual(crv, 0) ThenBlock: {
                    ck = CAD_Store.Read(crv, 0)
                    ns = 0
                    IfCondition EqualTo(ck, 3) ThenBlock: {
                        ns = CAD_Tess.SampleEllipseByEnds(ed, 12, samp)
                    }
                    IfCondition EqualTo(ck, 2) ThenBlock: {
                        ns = CAD_Tess.SampleCircleEdge(ed, 12, samp)
                    }
                    IfCondition GreaterThan(ns, 2) ThenBlock: {
                        si = 1
                        WhileLoop LessThan(si, Subtract(ns, 1)) {
                            IfCondition LessThan(nn, 2048) ThenBlock: {
                                vo = Multiply(Add(base_v, nn), 3)
                                so = Multiply(si, 3)
                                ArraySet(v_base, vo, ArrayGet(samp, so))
                                ArraySet(v_base, Add(vo, 1), ArrayGet(samp, Add(so, 1)))
                                ArraySet(v_base, Add(vo, 2), ArrayGet(samp, Add(so, 2)))
                                nn = Add(nn, 1)
                            }
                            si = Add(si, 1)
                        }
                    }
                }
            }
            ce = CAD_Store.Read(ce, 2)
            cg = Add(cg, 1)
            IfCondition EqualTo(ce, head) ThenBlock: { dn = 1 }
            IfCondition GreaterThan(cg, 4096) ThenBlock: { dn = 1 }
        }
        // samp pinned
        IfCondition LessThan(nn, 3) ThenBlock: { ReturnValue(tri_count) }
        i = 1
        WhileLoop LessThan(i, Subtract(nn, 1)) {
            t0 = Multiply(tri_count, 3)
            ArraySet(i_base, t0, base_v)
            ArraySet(i_base, Add(t0, 1), Add(base_v, i))
            ArraySet(i_base, Add(t0, 2), Add(base_v, Add(i, 1)))
            tri_count = Add(tri_count, 1)
            i = Add(i, 1)
        }
        ArraySet(pack_addr, 0, Add(base_v, nn))
        ArraySet(pack_addr, 1, tri_count)
        ReturnValue(tri_count)
    }
}

// MeshSolid: walk shell faces; 3/4-gons or general n-gon fan
// out_mesh: [n_verts, n_tris, v_base, i_base] filled
// Mesh cylinder by surface sample. origin_addr: [ox,oy,oz] base center.
Function.CAD_Tess.MeshCylinderAnalytic {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: defl_r: Integer
    Input: origin_addr: Address
    Input: out_mesh_addr: Address
    Output: Integer
    Body: {
        n = CAD_Tess.CircleSegCount(radius_r, defl_r)
        ox = ArrayGet(origin_addr, 0)
        oy = ArrayGet(origin_addr, 1)
        oz = ArrayGet(origin_addr, 2)
        v_base = Allocate(262144)
        i_base = Allocate(131072)
        two_pi = 0x401921FB54442D18
        nf = Float_FromInt(n)
        i = 0
        WhileLoop LessThan(i, n) {
            ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), nf))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            x = Float_Add(ox, Float_Mul(radius_r, c))
            y = Float_Add(oy, Float_Mul(radius_r, s))
            vo = Multiply(i, 3)
            ArraySet(v_base, vo, x)
            ArraySet(v_base, Add(vo, 1), y)
            ArraySet(v_base, Add(vo, 2), oz)
            vo2 = Multiply(Add(i, n), 3)
            ArraySet(v_base, vo2, x)
            ArraySet(v_base, Add(vo2, 1), y)
            ArraySet(v_base, Add(vo2, 2), Float_Add(oz, height_r))
            i = Add(i, 1)
        }
        tri = 0
        // side quads: (i, i+1, i+1+n) (i, i+1+n, i+n)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            ib = Add(i, n)
            jb = Add(j, n)
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, i)
            ArraySet(i_base, Add(t0, 1), j)
            ArraySet(i_base, Add(t0, 2), jb)
            tri = Add(tri, 1)
            t1 = Multiply(tri, 3)
            ArraySet(i_base, t1, i)
            ArraySet(i_base, Add(t1, 1), jb)
            ArraySet(i_base, Add(t1, 2), ib)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        // bottom cap fan from vertex 0 (approx center fan: use tris (0,i+1,i) for i=1..n-2)
        // better: introduce center? without center fan from 0 on ring
        i = 1
        WhileLoop LessThan(i, Subtract(n, 1)) {
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, 0)
            ArraySet(i_base, Add(t0, 1), Add(i, 1))
            ArraySet(i_base, Add(t0, 2), i)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        // top cap: fan from n, indices n..2n-1, outward so (n, n+i, n+i+1)
        i = 1
        WhileLoop LessThan(i, Subtract(n, 1)) {
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, n)
            ArraySet(i_base, Add(t0, 1), Add(n, i))
            ArraySet(i_base, Add(t0, 2), Add(n, Add(i, 1)))
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        ArraySet(out_mesh_addr, 0, Multiply(n, 2))
        ArraySet(out_mesh_addr, 1, tri)
        ArraySet(out_mesh_addr, 2, v_base)
        ArraySet(out_mesh_addr, 3, i_base)
        ArraySet(out_mesh_addr, 4, 262144)
        ArraySet(out_mesh_addr, 5, 131072)
        CAD_Tess_State.tess_count = Add(CAD_Tess_State.tess_count, 1)
        CAD_Tess_State.triangle_count = tri
        CAD_Tess_State.vertex_count = Multiply(n, 2)
        ReturnValue(tri)
    }
}

// Analytic tube mesh (kind 5): outer + inner cylinders + annular caps.
// Full closed 360 — no keyhole gap. n from CircleSegCount(r_out).
// pack: Store/params [0]=r_in [1]=r_out [2]=h [3]=ox [4]=oy [5]=oz
Function.CAD_Tess.MeshTubeAnalytic {
    Input: pack_addr: Address
    Input: defl_r: Integer
    Input: out_mesh_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(out_mesh_addr, 0) ThenBlock: { ReturnValue(-1) }
        r_in_r = CAD_Store.Read(pack_addr, 0)
        r_out_r = CAD_Store.Read(pack_addr, 1)
        height_r = CAD_Store.Read(pack_addr, 2)
        ox = CAD_Store.Read(pack_addr, 3)
        oy = CAD_Store.Read(pack_addr, 4)
        oz = CAD_Store.Read(pack_addr, 5)
        IfCondition EqualTo(Float_Le(r_out_r, r_in_r), 1) ThenBlock: { ReturnValue(-1) }
        n = CAD_Tess.CircleSegCount(r_out_r, defl_r)
        // verts: outer_bot 0..n-1, outer_top n..2n-1, inner_bot 2n..3n-1, inner_top 3n..4n-1
        v_base = Allocate(1048576)
        i_base = Allocate(524288)
        two_pi = 0x401921FB54442D18
        nf = Float_FromInt(n)
        i = 0
        WhileLoop LessThan(i, n) {
            ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), nf))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            xo = Float_Add(ox, Float_Mul(r_out_r, c))
            yo = Float_Add(oy, Float_Mul(r_out_r, s))
            xi = Float_Add(ox, Float_Mul(r_in_r, c))
            yi = Float_Add(oy, Float_Mul(r_in_r, s))
            zt = Float_Add(oz, height_r)
            // outer bot / top
            vo = Multiply(i, 3)
            ArraySet(v_base, vo, xo)
            ArraySet(v_base, Add(vo, 1), yo)
            ArraySet(v_base, Add(vo, 2), oz)
            vo = Multiply(Add(i, n), 3)
            ArraySet(v_base, vo, xo)
            ArraySet(v_base, Add(vo, 1), yo)
            ArraySet(v_base, Add(vo, 2), zt)
            // inner bot / top
            vo = Multiply(Add(i, Multiply(n, 2)), 3)
            ArraySet(v_base, vo, xi)
            ArraySet(v_base, Add(vo, 1), yi)
            ArraySet(v_base, Add(vo, 2), oz)
            vo = Multiply(Add(i, Multiply(n, 3)), 3)
            ArraySet(v_base, vo, xi)
            ArraySet(v_base, Add(vo, 1), yi)
            ArraySet(v_base, Add(vo, 2), zt)
            i = Add(i, 1)
        }
        tri = 0
        // outer side quads (outward)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            ib = Add(i, n)
            jb = Add(j, n)
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, i)
            ArraySet(i_base, Add(t0, 1), j)
            ArraySet(i_base, Add(t0, 2), jb)
            tri = Add(tri, 1)
            t1 = Multiply(tri, 3)
            ArraySet(i_base, t1, i)
            ArraySet(i_base, Add(t1, 1), jb)
            ArraySet(i_base, Add(t1, 2), ib)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        // inner side quads (inward: reverse winding)
        ob = Multiply(n, 2)
        ot = Multiply(n, 3)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            i0 = Add(ob, i)
            j0 = Add(ob, j)
            i1 = Add(ot, i)
            j1 = Add(ot, j)
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, i0)
            ArraySet(i_base, Add(t0, 1), i1)
            ArraySet(i_base, Add(t0, 2), j1)
            tri = Add(tri, 1)
            t1 = Multiply(tri, 3)
            ArraySet(i_base, t1, i0)
            ArraySet(i_base, Add(t1, 1), j1)
            ArraySet(i_base, Add(t1, 2), j0)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        // top annulus (outer_top → inner_top): (n+i, n+j, ot+j) (n+i, ot+j, ot+i)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            oi = Add(n, i)
            oj = Add(n, j)
            ii = Add(ot, i)
            ij = Add(ot, j)
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, oi)
            ArraySet(i_base, Add(t0, 1), oj)
            ArraySet(i_base, Add(t0, 2), ij)
            tri = Add(tri, 1)
            t1 = Multiply(tri, 3)
            ArraySet(i_base, t1, oi)
            ArraySet(i_base, Add(t1, 1), ij)
            ArraySet(i_base, Add(t1, 2), ii)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        // bottom annulus (outward -Z: reverse of top)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            oi = i
            oj = j
            ii = Add(ob, i)
            ij = Add(ob, j)
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, oi)
            ArraySet(i_base, Add(t0, 1), ii)
            ArraySet(i_base, Add(t0, 2), ij)
            tri = Add(tri, 1)
            t1 = Multiply(tri, 3)
            ArraySet(i_base, t1, oi)
            ArraySet(i_base, Add(t1, 1), ij)
            ArraySet(i_base, Add(t1, 2), oj)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        ArraySet(out_mesh_addr, 0, Multiply(n, 4))
        ArraySet(out_mesh_addr, 1, tri)
        ArraySet(out_mesh_addr, 2, v_base)
        ArraySet(out_mesh_addr, 3, i_base)
        ArraySet(out_mesh_addr, 4, 1048576)
        ArraySet(out_mesh_addr, 5, 524288)
        CAD_Tess_State.tess_count = Add(CAD_Tess_State.tess_count, 1)
        CAD_Tess_State.triangle_count = tri
        CAD_Tess_State.vertex_count = Multiply(n, 4)
        ReturnValue(tri)
    }
}

// Class A surface of revolution. pack: n, rmax, O(3), u(3), n(3), rz_ptr.
// Each RZ segment is a belt of CircleSegCount samples — cylinders/tori stay round.
Function.CAD_Tess.MeshLatheAnalytic {
    Input: pack_addr: Address
    Input: defl_r: Integer
    Input: out_mesh_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(out_mesh_addr, 0) ThenBlock: { ReturnValue(-1) }
        np = CAD_Store.Read(pack_addr, 0)
        rmax = CAD_Store.Read(pack_addr, 1)
        ox = CAD_Store.Read(pack_addr, 2)
        oy = CAD_Store.Read(pack_addr, 3)
        oz = CAD_Store.Read(pack_addr, 4)
        ux = CAD_Store.Read(pack_addr, 5)
        uy = CAD_Store.Read(pack_addr, 6)
        uz = CAD_Store.Read(pack_addr, 7)
        nx = CAD_Store.Read(pack_addr, 8)
        ny = CAD_Store.Read(pack_addr, 9)
        nz = CAD_Store.Read(pack_addr, 10)
        rz = CAD_Store.Read(pack_addr, 11)
        IfCondition EqualTo(rz, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(np, 3) ThenBlock: { ReturnValue(-1) }
        ul = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ux, ux), Float_Mul(uy, uy)), Float_Mul(uz, uz)))
        IfCondition EqualTo(CAD_Num.IsZero(ul, 0), 1) ThenBlock: {
            ux = 0
            uy = 0
            uz = 0x3FF0000000000000
            ul = 0x3FF0000000000000
        }
        ux = Float_Div(ux, ul)
        uy = Float_Div(uy, ul)
        uz = Float_Div(uz, ul)
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 1) ThenBlock: {
            nx = 0x3FF0000000000000
            ny = 0
            nz = 0
            nl = 0x3FF0000000000000
        }
        nx = Float_Div(nx, nl)
        ny = Float_Div(ny, nl)
        nz = Float_Div(nz, nl)
        // k = u × n  (out of sketch plane)
        kx = Float_Sub(Float_Mul(uy, nz), Float_Mul(uz, ny))
        ky = Float_Sub(Float_Mul(uz, nx), Float_Mul(ux, nz))
        kz = Float_Sub(Float_Mul(ux, ny), Float_Mul(uy, nx))
        kl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(kx, kx), Float_Mul(ky, ky)), Float_Mul(kz, kz)))
        IfCondition EqualTo(CAD_Num.IsZero(kl, 0), 0) ThenBlock: {
            kx = Float_Div(kx, kl)
            ky = Float_Div(ky, kl)
            kz = Float_Div(kz, kl)
        }
        nseg = CAD_Tess.CircleSegCount(rmax, defl_r)
        IfCondition LessThan(nseg, 90) ThenBlock: { nseg = 90 }
        IfCondition GreaterThan(nseg, 180) ThenBlock: { nseg = 180 }
        sweep_i = CAD_Store.Read(pack_addr, 12)
        IfCondition LessThan(sweep_i, 1) ThenBlock: { sweep_i = 360 }
        IfCondition GreaterThan(sweep_i, 360) ThenBlock: { sweep_i = 360 }
        IfCondition LessThan(sweep_i, 360) ThenBlock: {
            nseg = Divide(Multiply(nseg, sweep_i), 360)
            IfCondition LessThan(nseg, 8) ThenBlock: { nseg = 8 }
        }
        nv = Multiply(np, nseg)
        // 2 belts per profile step × nseg; indices = tris * 3
        ntri = Multiply(Multiply(np, nseg), 2)
        nidx = Multiply(ntri, 3)
        vbytes = Multiply(Multiply(nv, 3), 8)
        ibytes = Multiply(nidx, 8)
        IfCondition LessThan(vbytes, 64) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(ibytes, 64) ThenBlock: { ReturnValue(-1) }
        v_base = Allocate(vbytes)
        i_base = Allocate(ibytes)
        IfCondition EqualTo(v_base, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(i_base, 0) ThenBlock: {
            Deallocate(v_base, vbytes)
            ReturnValue(-1)
        }
        ArraySet(out_mesh_addr, 4, vbytes)
        ArraySet(out_mesh_addr, 5, ibytes)
        two_pi = 0x401921FB54442D18
        span = two_pi
        IfCondition LessThan(sweep_i, 360) ThenBlock: {
            span = Float_Mul(two_pi, Float_Div(Float_FromInt(sweep_i), Float_FromInt(360)))
        }
        ns = 0
        WhileLoop LessThan(ns, np) {
            rho = ArrayGet(rz, Multiply(ns, 2))
            zz = ArrayGet(rz, Add(Multiply(ns, 2), 1))
            j = 0
            WhileLoop LessThan(j, nseg) {
                den = nseg
                IfCondition LessThan(sweep_i, 360) ThenBlock: { den = Subtract(nseg, 1) }
                IfCondition LessThan(den, 1) ThenBlock: { den = 1 }
                ang = Float_Mul(span, Float_Div(Float_FromInt(j), Float_FromInt(den)))
                c = CAD_Geom.Cos(ang)
                s = CAD_Geom.Sin(ang)
                // P = O + z u + rho (c n + s k)
                px = Float_Add(ox, Float_Add(Float_Mul(zz, ux), Float_Mul(rho, Float_Add(Float_Mul(c, nx), Float_Mul(s, kx)))))
                py = Float_Add(oy, Float_Add(Float_Mul(zz, uy), Float_Mul(rho, Float_Add(Float_Mul(c, ny), Float_Mul(s, ky)))))
                pz = Float_Add(oz, Float_Add(Float_Mul(zz, uz), Float_Mul(rho, Float_Add(Float_Mul(c, nz), Float_Mul(s, kz)))))
                vo = Multiply(Add(Multiply(ns, nseg), j), 3)
                ArraySet(v_base, vo, px)
                ArraySet(v_base, Add(vo, 1), py)
                ArraySet(v_base, Add(vo, 2), pz)
                j = Add(j, 1)
            }
            ns = Add(ns, 1)
        }
        tri = 0
        ns = 0
        WhileLoop LessThan(ns, np) {
            n2 = Add(ns, 1)
            IfCondition EqualTo(n2, np) ThenBlock: { n2 = 0 }
            j = 0
            jmax = nseg
            IfCondition LessThan(sweep_i, 360) ThenBlock: { jmax = Subtract(nseg, 1) }
            WhileLoop LessThan(j, jmax) {
                jn = Add(j, 1)
                IfCondition EqualTo(jn, nseg) ThenBlock: { jn = 0 }
                a = Add(Multiply(ns, nseg), j)
                b = Add(Multiply(ns, nseg), jn)
                c = Add(Multiply(n2, nseg), jn)
                d = Add(Multiply(n2, nseg), j)
                t0 = Multiply(tri, 3)
                ArraySet(i_base, t0, a)
                ArraySet(i_base, Add(t0, 1), b)
                ArraySet(i_base, Add(t0, 2), c)
                tri = Add(tri, 1)
                t1 = Multiply(tri, 3)
                ArraySet(i_base, t1, a)
                ArraySet(i_base, Add(t1, 1), c)
                ArraySet(i_base, Add(t1, 2), d)
                tri = Add(tri, 1)
                j = Add(j, 1)
            }
            ns = Add(ns, 1)
        }
        // Open sweep: fan end caps at j=0 and j=last
        IfCondition LessThan(sweep_i, 360) ThenBlock: {
            IfCondition GreaterThan(np, 2) ThenBlock: {
                jlast = Subtract(nseg, 1)
                capj = 0
                WhileLoop LessThan(capj, 2) {
                    jj = 0
                    IfCondition EqualTo(capj, 1) ThenBlock: { jj = jlast }
                    i = 1
                    WhileLoop LessThan(i, Subtract(np, 1)) {
                        a = jj
                        b = Add(Multiply(i, nseg), jj)
                        c = Add(Multiply(Add(i, 1), nseg), jj)
                        t0 = Multiply(tri, 3)
                        IfCondition EqualTo(capj, 0) ThenBlock: {
                            ArraySet(i_base, t0, a)
                            ArraySet(i_base, Add(t0, 1), b)
                            ArraySet(i_base, Add(t0, 2), c)
                        }
                        IfCondition EqualTo(capj, 1) ThenBlock: {
                            ArraySet(i_base, t0, a)
                            ArraySet(i_base, Add(t0, 1), c)
                            ArraySet(i_base, Add(t0, 2), b)
                        }
                        tri = Add(tri, 1)
                        i = Add(i, 1)
                    }
                    capj = Add(capj, 1)
                }
            }
        }
        ArraySet(out_mesh_addr, 0, nv)
        ArraySet(out_mesh_addr, 1, tri)
        ArraySet(out_mesh_addr, 2, v_base)
        ArraySet(out_mesh_addr, 3, i_base)
        CAD_Tess_State.tess_count = Add(CAD_Tess_State.tess_count, 1)
        CAD_Tess_State.triangle_count = tri
        CAD_Tess_State.vertex_count = nv
        ReturnValue(tri)
    }
}

// Ray from (cx,cy) at angle hits axis-aligned rect [0,dx]x[0,dy] — outer rim point.
// out_xy: [x,y]
Function.CAD_Tess.RayHitRect2D {
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: ang_r: Integer
    Input: pack_addr: Address
    Output: Integer
    Body: {
        // pack: [0]=dx [1]=dy [2]=out_x [3]=out_y
        dx = ArrayGet(pack_addr, 0)
        dy = ArrayGet(pack_addr, 1)
        c = CAD_Geom.Cos(ang_r)
        s = CAD_Geom.Sin(ang_r)
        // large t candidates for each side
        big = 0x412E848000000000
        t_best = big
        // vertical sides x=0, x=dx
        IfCondition NotEqual(CAD_Num.IsZero(c, 0), 1) ThenBlock: {
            t0 = Float_Div(Float_Sub(0, cx_r), c)
            IfCondition EqualTo(Float_Le(0, t0), 1) ThenBlock: {
                y0 = Float_Add(cy_r, Float_Mul(t0, s))
                IfCondition EqualTo(Float_Le(0, y0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(y0, dy), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(t0, t_best), 1) ThenBlock: { t_best = t0 }
                    }
                }
            }
            t1 = Float_Div(Float_Sub(dx, cx_r), c)
            IfCondition EqualTo(Float_Le(0, t1), 1) ThenBlock: {
                y1 = Float_Add(cy_r, Float_Mul(t1, s))
                IfCondition EqualTo(Float_Le(0, y1), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(y1, dy), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(t1, t_best), 1) ThenBlock: { t_best = t1 }
                    }
                }
            }
        }
        IfCondition NotEqual(CAD_Num.IsZero(s, 0), 1) ThenBlock: {
            t2 = Float_Div(Float_Sub(0, cy_r), s)
            IfCondition EqualTo(Float_Le(0, t2), 1) ThenBlock: {
                x2 = Float_Add(cx_r, Float_Mul(t2, c))
                IfCondition EqualTo(Float_Le(0, x2), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(x2, dx), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(t2, t_best), 1) ThenBlock: { t_best = t2 }
                    }
                }
            }
            t3 = Float_Div(Float_Sub(dy, cy_r), s)
            IfCondition EqualTo(Float_Le(0, t3), 1) ThenBlock: {
                x3 = Float_Add(cx_r, Float_Mul(t3, c))
                IfCondition EqualTo(Float_Le(0, x3), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(x3, dx), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(t3, t_best), 1) ThenBlock: { t_best = t3 }
                    }
                }
            }
        }
        ArraySet(pack_addr, 2, Float_Add(cx_r, Float_Mul(t_best, c)))
        ArraySet(pack_addr, 3, Float_Add(cy_r, Float_Mul(t_best, s)))
        ReturnValue(0)
    }
}

// Which rect edge a boundary point lies on: 0=y0 1=x=dx 2=y=dy 3=x=0
// pack_addr: [0]=dx [1]=dy [2]=x [3]=y → returns edge id in pack[4]
Function.CAD_Tess.RectEdgeId {
    Input: pack_addr: Address
    Output: Integer
    Body: {
        dx = ArrayGet(pack_addr, 0)
        dy = ArrayGet(pack_addr, 1)
        x = ArrayGet(pack_addr, 2)
        y = ArrayGet(pack_addr, 3)
        tol = 0x3F50624DD2F1A9FC
        // 1e-3
        d0 = y
        IfCondition EqualTo(Float_Le(d0, 0), 1) ThenBlock: { d0 = Float_Sub(0, d0) }
        d1 = Float_Sub(dx, x)
        IfCondition EqualTo(Float_Le(d1, 0), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
        d2 = Float_Sub(dy, y)
        IfCondition EqualTo(Float_Le(d2, 0), 1) ThenBlock: { d2 = Float_Sub(0, d2) }
        d3 = x
        IfCondition EqualTo(Float_Le(d3, 0), 1) ThenBlock: { d3 = Float_Sub(0, d3) }
        eid = 0
        best = d0
        IfCondition EqualTo(Float_Le(d1, best), 1) ThenBlock: {
            best = d1
            eid = 1
        }
        IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
            best = d2
            eid = 2
        }
        IfCondition EqualTo(Float_Le(d3, best), 1) ThenBlock: {
            eid = 3
        }
        ArraySet(pack_addr, 4, eid)
        ReturnValue(eid)
    }
}

// Ear-clip a simple 2D polygon (vertex indices into v_base xyz).
// pack: [0]=npoly, [1]=tri_count in/out, [2]=flip (1 → reverse winding for bottom).
// Sign of (B-A)×(C-A) in XY. No heap.
Function.CAD_Tess.OrientXY {
    Input: v_base: Address
    Input: ia: Integer
    Input: ib: Integer
    Input: ic: Integer
    Output: Integer
    Body: {
        ax = ArrayGet(v_base, Multiply(ia, 3))
        ay = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
        bx = ArrayGet(v_base, Multiply(ib, 3))
        by = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
        cx = ArrayGet(v_base, Multiply(ic, 3))
        cy = ArrayGet(v_base, Add(Multiply(ic, 3), 1))
        det = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(cy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(cx, ax)))
        IfCondition EqualTo(CAD_Num.IsZero(det, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsNeg(det), 1) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        ReturnValue(1)
    }
}

// Caller CCW-normalizes with IsNeg(area). Clip o==1 ears; drop o==0 collinear tips.
// One reverse retry. Partial tris on fail — MeshSolid must NOT FanNGon concave.
Function.CAD_Tess.EarClipPoly {
    Input: poly_addr: Address
    Input: v_base: Address
    Input: i_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        npoly = ArrayGet(pack_addr, 0)
        tri = ArrayGet(pack_addr, 1)
        flip = ArrayGet(pack_addr, 2)
        guard = 0
        rev_used = 0
        maxg = Multiply(Add(npoly, 2), Add(npoly, 2))
        IfCondition GreaterThan(maxg, 200000) ThenBlock: { maxg = 200000 }
        WhileLoop GreaterEqual(npoly, 3) {
            IfCondition EqualTo(npoly, 3) ThenBlock: {
                i0 = ArrayGet(poly_addr, 0)
                i1 = ArrayGet(poly_addr, 1)
                i2 = ArrayGet(poly_addr, 2)
                tt = Multiply(tri, 3)
                IfCondition EqualTo(flip, 0) ThenBlock: {
                    ArraySet(i_base, tt, i0)
                    ArraySet(i_base, Add(tt, 1), i1)
                    ArraySet(i_base, Add(tt, 2), i2)
                }
                IfCondition EqualTo(flip, 1) ThenBlock: {
                    ArraySet(i_base, tt, i0)
                    ArraySet(i_base, Add(tt, 1), i2)
                    ArraySet(i_base, Add(tt, 2), i1)
                }
                tri = Add(tri, 1)
                npoly = 0
            }
            IfCondition GreaterThan(npoly, 3) ThenBlock: {
                found = 0
                ei = 0
                WhileLoop LessThan(ei, npoly) {
                    IfCondition EqualTo(found, 0) ThenBlock: {
                        im = Subtract(ei, 1)
                        IfCondition LessThan(im, 0) ThenBlock: { im = Subtract(npoly, 1) }
                        ip = Add(ei, 1)
                        IfCondition GreaterEqual(ip, npoly) ThenBlock: { ip = 0 }
                        ia = ArrayGet(poly_addr, im)
                        ibv = ArrayGet(poly_addr, ei)
                        ic = ArrayGet(poly_addr, ip)
                        o = CAD_Tess.OrientXY(v_base, ia, ibv, ic)
                        IfCondition EqualTo(o, 0) ThenBlock: {
                            k = ei
                            WhileLoop LessThan(k, Subtract(npoly, 1)) {
                                ArraySet(poly_addr, k, ArrayGet(poly_addr, Add(k, 1)))
                                k = Add(k, 1)
                            }
                            npoly = Subtract(npoly, 1)
                            found = 1
                        }
                        IfCondition EqualTo(found, 0) ThenBlock: {
                            // CCW-only convex ear (caller IsNeg-normalized)
                            is_ear = 0
                            IfCondition EqualTo(o, 1) ThenBlock: {
                                is_ear = 1
                                k = 0
                                WhileLoop LessThan(k, npoly) {
                                    IfCondition EqualTo(is_ear, 1) ThenBlock: {
                                        skip = 0
                                        IfCondition EqualTo(k, im) ThenBlock: { skip = 1 }
                                        IfCondition EqualTo(k, ei) ThenBlock: { skip = 1 }
                                        IfCondition EqualTo(k, ip) ThenBlock: { skip = 1 }
                                        IfCondition EqualTo(skip, 0) ThenBlock: {
                                            id = ArrayGet(poly_addr, k)
                                            o1 = CAD_Tess.OrientXY(v_base, ia, ibv, id)
                                            o2 = CAD_Tess.OrientXY(v_base, ibv, ic, id)
                                            o3 = CAD_Tess.OrientXY(v_base, ic, ia, id)
                                            IfCondition EqualTo(o1, 1) ThenBlock: {
                                                IfCondition EqualTo(o2, 1) ThenBlock: {
                                                    IfCondition EqualTo(o3, 1) ThenBlock: {
                                                        is_ear = 0
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    k = Add(k, 1)
                                }
                            }
                            IfCondition EqualTo(is_ear, 1) ThenBlock: {
                                tt = Multiply(tri, 3)
                                IfCondition EqualTo(flip, 0) ThenBlock: {
                                    ArraySet(i_base, tt, ia)
                                    ArraySet(i_base, Add(tt, 1), ibv)
                                    ArraySet(i_base, Add(tt, 2), ic)
                                }
                                IfCondition EqualTo(flip, 1) ThenBlock: {
                                    ArraySet(i_base, tt, ia)
                                    ArraySet(i_base, Add(tt, 1), ic)
                                    ArraySet(i_base, Add(tt, 2), ibv)
                                }
                                tri = Add(tri, 1)
                                k = ei
                                WhileLoop LessThan(k, Subtract(npoly, 1)) {
                                    ArraySet(poly_addr, k, ArrayGet(poly_addr, Add(k, 1)))
                                    k = Add(k, 1)
                                }
                                npoly = Subtract(npoly, 1)
                                found = 1
                            }
                        }
                    }
                    ei = Add(ei, 1)
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    IfCondition EqualTo(rev_used, 0) ThenBlock: {
                        lo = 0
                        hi = Subtract(npoly, 1)
                        WhileLoop LessThan(lo, hi) {
                            tmpi = ArrayGet(poly_addr, lo)
                            ArraySet(poly_addr, lo, ArrayGet(poly_addr, hi))
                            ArraySet(poly_addr, hi, tmpi)
                            lo = Add(lo, 1)
                            hi = Subtract(hi, 1)
                        }
                        flip = Subtract(1, flip)
                        ArraySet(pack_addr, 2, flip)
                        rev_used = 1
                        found = 1
                    }
                }
                IfCondition EqualTo(found, 0) ThenBlock: { npoly = 0 }
            }
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, maxg) ThenBlock: { npoly = 0 }
        }
        ArraySet(pack_addr, 1, tri)
        ReturnValue(tri)
    }
}

// Multi-hole plate mesh: per-hole single-hole-quality annulus (RayHitRect2D +
// sharp corners), keep a tri only if its centroid is outside every hole and
// nearest hole is the owner. Outer walls once; walls + blind floors per hole.
Function.CAD_Tess.NearestHoleXY {
    Input: x_r: Integer
    Input: y_r: Integer
    Input: holes_addr: Address
    Output: Integer
    Body: {
        nh = ArrayGet(holes_addr, 0)
        best = 0
        best_d = 0x7FF0000000000000
        hi = 0
        WhileLoop LessThan(hi, nh) {
            base = Add(1, Multiply(hi, 4))
            hcx = ArrayGet(holes_addr, Add(base, 1))
            hcy = ArrayGet(holes_addr, Add(base, 2))
            ddx = Float_Sub(x_r, hcx)
            ddy = Float_Sub(y_r, hcy)
            d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
            IfCondition EqualTo(Float_Le(d2, best_d), 1) ThenBlock: {
                best_d = d2
                best = hi
            }
            hi = Add(hi, 1)
        }
        ReturnValue(best)
    }
}

// 1 if (x,y) strictly inside any hole disk (plate-local)
Function.CAD_Tess.InAnyHoleXY {
    Input: x_r: Integer
    Input: y_r: Integer
    Input: holes_addr: Address
    Output: Integer
    Body: {
        nh = ArrayGet(holes_addr, 0)
        hi = 0
        WhileLoop LessThan(hi, nh) {
            base = Add(1, Multiply(hi, 4))
            hr = ArrayGet(holes_addr, base)
            hcx = ArrayGet(holes_addr, Add(base, 1))
            hcy = ArrayGet(holes_addr, Add(base, 2))
            ddx = Float_Sub(x_r, hcx)
            ddy = Float_Sub(y_r, hcy)
            d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
            r2 = Float_Mul(hr, hr)
            IfCondition EqualTo(Float_Le(d2, r2), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(d2, r2, 0), 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
            hi = Add(hi, 1)
        }
        ReturnValue(0)
    }
}

// Keep tri if centroid outside forbidden disks and nearest eligible hole == owner.
// pack: [0]=owner, [1]=holes_addr, [2]=oxx, [3]=oyy, [4]=mode (0=top all holes, 1=bottom through-only), [5]=dz
Function.CAD_Tess.KeepAnnulusTri {
    Input: v_base: Address
    Input: i0: Integer
    Input: i1: Integer
    Input: i2: Integer
    Input: pack_addr: Address
    Output: Integer
    Body: {
        owner = ArrayGet(pack_addr, 0)
        holes = ArrayGet(pack_addr, 1)
        oxx = ArrayGet(pack_addr, 2)
        oyy = ArrayGet(pack_addr, 3)
        mode = ArrayGet(pack_addr, 4)
        dz = ArrayGet(pack_addr, 5)
        x0 = ArrayGet(v_base, Multiply(i0, 3))
        y0 = ArrayGet(v_base, Add(Multiply(i0, 3), 1))
        x1 = ArrayGet(v_base, Multiply(i1, 3))
        y1 = ArrayGet(v_base, Add(Multiply(i1, 3), 1))
        x2 = ArrayGet(v_base, Multiply(i2, 3))
        y2 = ArrayGet(v_base, Add(Multiply(i2, 3), 1))
        three = 0x4008000000000000
        mx = Float_Div(Float_Add(Float_Add(x0, x1), x2), three)
        my = Float_Div(Float_Add(Float_Add(y0, y1), y2), three)
        lx = Float_Sub(mx, oxx)
        ly = Float_Sub(my, oyy)
        // inside any relevant hole disk?
        nholes = ArrayGet(holes, 0)
        hi = 0
        WhileLoop LessThan(hi, nholes) {
            base = Add(1, Multiply(hi, 4))
            hr = ArrayGet(holes, base)
            hcx = ArrayGet(holes, Add(base, 1))
            hcy = ArrayGet(holes, Add(base, 2))
            hdep = ArrayGet(holes, Add(base, 3))
            use = 1
            IfCondition EqualTo(mode, 1) ThenBlock: {
                use = 0
                IfCondition EqualTo(CAD_Num.IsEqual(hdep, dz, 0), 1) ThenBlock: { use = 1 }
            }
            IfCondition EqualTo(use, 1) ThenBlock: {
                ddx = Float_Sub(lx, hcx)
                ddy = Float_Sub(ly, hcy)
                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                r2 = Float_Mul(hr, hr)
                IfCondition EqualTo(Float_Le(d2, r2), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(d2, r2, 0), 0) ThenBlock: {
                        ReturnValue(0)
                    }
                }
            }
            hi = Add(hi, 1)
        }
        // Reject if any relevant hole center lies inside this triangle (large
        // sectors from hole A can cover hole B's opening even when centroid is out).
        pa = Allocate(32)
        pb = Allocate(32)
        pc = Allocate(32)
        pd = Allocate(32)
        ArraySet(pa, 0, lx)
        // reuse world? Orient in plate-local: use vertex local xy
        ArraySet(pa, 0, Float_Sub(x0, oxx))
        ArraySet(pa, 1, Float_Sub(y0, oyy))
        ArraySet(pb, 0, Float_Sub(x1, oxx))
        ArraySet(pb, 1, Float_Sub(y1, oyy))
        ArraySet(pc, 0, Float_Sub(x2, oxx))
        ArraySet(pc, 1, Float_Sub(y2, oyy))
        hi = 0
        WhileLoop LessThan(hi, nholes) {
            base = Add(1, Multiply(hi, 4))
            hcx = ArrayGet(holes, Add(base, 1))
            hcy = ArrayGet(holes, Add(base, 2))
            hdep = ArrayGet(holes, Add(base, 3))
            use = 1
            IfCondition EqualTo(mode, 1) ThenBlock: {
                use = 0
                IfCondition EqualTo(CAD_Num.IsEqual(hdep, dz, 0), 1) ThenBlock: { use = 1 }
            }
            IfCondition EqualTo(use, 1) ThenBlock: {
                ArraySet(pd, 0, hcx)
                ArraySet(pd, 1, hcy)
                o1 = CAD_Num.Orient2D(pa, pb, pd)
                o2 = CAD_Num.Orient2D(pb, pc, pd)
                o3 = CAD_Num.Orient2D(pc, pa, pd)
                // same half-plane signs → inside or on boundary
                neg = 0
                IfCondition EqualTo(o1, -1) ThenBlock: { neg = 1 }
                IfCondition EqualTo(o2, -1) ThenBlock: { neg = 1 }
                IfCondition EqualTo(o3, -1) ThenBlock: { neg = 1 }
                pos = 0
                IfCondition EqualTo(o1, 1) ThenBlock: { pos = 1 }
                IfCondition EqualTo(o2, 1) ThenBlock: { pos = 1 }
                IfCondition EqualTo(o3, 1) ThenBlock: { pos = 1 }
                // inside if not (has neg and has pos) i.e. all non-neg or all non-pos
                IfCondition EqualTo(neg, 0) ThenBlock: {
                    // all >= 0
                    Deallocate(pa, 32)
                    Deallocate(pb, 32)
                    Deallocate(pc, 32)
                    Deallocate(pd, 32)
                    ReturnValue(0)
                }
                IfCondition EqualTo(pos, 0) ThenBlock: {
                    Deallocate(pa, 32)
                    Deallocate(pb, 32)
                    Deallocate(pc, 32)
                    Deallocate(pd, 32)
                    ReturnValue(0)
                }
            }
            hi = Add(hi, 1)
        }
        Deallocate(pa, 32)
        Deallocate(pb, 32)
        Deallocate(pc, 32)
        Deallocate(pd, 32)
        ReturnValue(1)
    }
}

Function.CAD_Tess.MeshBoxMultiHole {
    Input: params_h: Integer
    Input: defl_r: Integer
    Input: out_mesh_addr: Address
    Output: Integer
    Body: {
        dx = CAD_Store.Read(params_h, 0)
        dy = CAD_Store.Read(params_h, 1)
        dz = CAD_Store.Read(params_h, 2)
        oxx = CAD_Store.Read(params_h, 6)
        oyy = CAD_Store.Read(params_h, 7)
        nh = CAD_Store.Read(params_h, 9)
        IfCondition EqualTo(nh, 0) ThenBlock: { nh = 1 }
        IfCondition GreaterThan(nh, 5) ThenBlock: { nh = 5 }
        holes = Allocate(128)
        ArraySet(holes, 0, nh)
        hi = 0
        WhileLoop LessThan(hi, nh) {
            base = Add(1, Multiply(hi, 4))
            IfCondition EqualTo(hi, 0) ThenBlock: {
                ArraySet(holes, base, CAD_Store.Read(params_h, 3))
                ArraySet(holes, Add(base, 1), CAD_Store.Read(params_h, 4))
                ArraySet(holes, Add(base, 2), CAD_Store.Read(params_h, 5))
                hdep = CAD_Store.Read(params_h, 8)
            }
            IfCondition GreaterThan(hi, 0) ThenBlock: {
                pb = Add(10, Multiply(Subtract(hi, 1), 4))
                ArraySet(holes, base, CAD_Store.Read(params_h, pb))
                ArraySet(holes, Add(base, 1), CAD_Store.Read(params_h, Add(pb, 1)))
                ArraySet(holes, Add(base, 2), CAD_Store.Read(params_h, Add(pb, 2)))
                hdep = CAD_Store.Read(params_h, Add(pb, 3))
            }
            IfCondition EqualTo(CAD_Num.IsZero(hdep, 0), 1) ThenBlock: { hdep = dz }
            IfCondition EqualTo(Float_Le(dz, hdep), 1) ThenBlock: { hdep = dz }
            ArraySet(holes, Add(base, 3), hdep)
            hi = Add(hi, 1)
        }
        v_base = Allocate(262144)
        i_base = Allocate(131072)
        hbase = Allocate(32)
        hn = Allocate(32)
        pack = Allocate(64)
        kpack = Allocate(64)
        ArraySet(pack, 0, dx)
        ArraySet(pack, 1, dy)
        ArraySet(kpack, 1, holes)
        ArraySet(kpack, 2, oxx)
        ArraySet(kpack, 3, oyy)
        ArraySet(kpack, 4, 0)
        ArraySet(kpack, 5, dz)
        two_pi = 0x401921FB54442D18
        zro = 0
        // shared outer corners: 0..3 top, 4..7 bottom
        ArraySet(v_base, 0, oxx)
        ArraySet(v_base, 1, oyy)
        ArraySet(v_base, 2, dz)
        ArraySet(v_base, 3, Float_Add(oxx, dx))
        ArraySet(v_base, 4, oyy)
        ArraySet(v_base, 5, dz)
        ArraySet(v_base, 6, Float_Add(oxx, dx))
        ArraySet(v_base, 7, Float_Add(oyy, dy))
        ArraySet(v_base, 8, dz)
        ArraySet(v_base, 9, oxx)
        ArraySet(v_base, 10, Float_Add(oyy, dy))
        ArraySet(v_base, 11, dz)
        ArraySet(v_base, 12, oxx)
        ArraySet(v_base, 13, oyy)
        ArraySet(v_base, 14, zro)
        ArraySet(v_base, 15, Float_Add(oxx, dx))
        ArraySet(v_base, 16, oyy)
        ArraySet(v_base, 17, zro)
        ArraySet(v_base, 18, Float_Add(oxx, dx))
        ArraySet(v_base, 19, Float_Add(oyy, dy))
        ArraySet(v_base, 20, zro)
        ArraySet(v_base, 21, oxx)
        ArraySet(v_base, 22, Float_Add(oyy, dy))
        ArraySet(v_base, 23, zro)
        nv = 8
        tri = 0
        // outer walls
        ArraySet(i_base, 0, 4)
        ArraySet(i_base, 1, 5)
        ArraySet(i_base, 2, 1)
        ArraySet(i_base, 3, 4)
        ArraySet(i_base, 4, 1)
        ArraySet(i_base, 5, 0)
        ArraySet(i_base, 6, 5)
        ArraySet(i_base, 7, 6)
        ArraySet(i_base, 8, 2)
        ArraySet(i_base, 9, 5)
        ArraySet(i_base, 10, 2)
        ArraySet(i_base, 11, 1)
        ArraySet(i_base, 12, 6)
        ArraySet(i_base, 13, 7)
        ArraySet(i_base, 14, 3)
        ArraySet(i_base, 15, 6)
        ArraySet(i_base, 16, 3)
        ArraySet(i_base, 17, 2)
        ArraySet(i_base, 18, 7)
        ArraySet(i_base, 19, 4)
        ArraySet(i_base, 20, 0)
        ArraySet(i_base, 21, 7)
        ArraySet(i_base, 22, 0)
        ArraySet(i_base, 23, 3)
        tri = 8
        // per-hole rings: Hb, Ht, Ot, Ob (same layout as single-hole local)
        hi = 0
        WhileLoop LessThan(hi, nh) {
            base = Add(1, Multiply(hi, 4))
            hr = ArrayGet(holes, base)
            hcx = ArrayGet(holes, Add(base, 1))
            hcy = ArrayGet(holes, Add(base, 2))
            hdep = ArrayGet(holes, Add(base, 3))
            z_floor = Float_Sub(dz, hdep)
            n = CAD_Tess.CircleSegCount(hr, defl_r)
            IfCondition LessThan(n, 24) ThenBlock: { n = 24 }
            ArraySet(hbase, hi, nv)
            ArraySet(hn, hi, n)
            i = 0
            WhileLoop LessThan(i, n) {
                ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(n)))
                c = CAD_Geom.Cos(ang)
                s = CAD_Geom.Sin(ang)
                hx = Float_Add(Float_Add(oxx, hcx), Float_Mul(hr, c))
                hy = Float_Add(Float_Add(oyy, hcy), Float_Mul(hr, s))
                CAD_Tess.RayHitRect2D(hcx, hcy, ang, pack)
                rx = Float_Add(oxx, ArrayGet(pack, 2))
                ry = Float_Add(oyy, ArrayGet(pack, 3))
                // Hb
                ArraySet(v_base, Multiply(nv, 3), hx)
                ArraySet(v_base, Add(Multiply(nv, 3), 1), hy)
                ArraySet(v_base, Add(Multiply(nv, 3), 2), z_floor)
                nv = Add(nv, 1)
                i = Add(i, 1)
            }
            // Ht
            i = 0
            WhileLoop LessThan(i, n) {
                ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(n)))
                c = CAD_Geom.Cos(ang)
                s = CAD_Geom.Sin(ang)
                hx = Float_Add(Float_Add(oxx, hcx), Float_Mul(hr, c))
                hy = Float_Add(Float_Add(oyy, hcy), Float_Mul(hr, s))
                ArraySet(v_base, Multiply(nv, 3), hx)
                ArraySet(v_base, Add(Multiply(nv, 3), 1), hy)
                ArraySet(v_base, Add(Multiply(nv, 3), 2), dz)
                nv = Add(nv, 1)
                i = Add(i, 1)
            }
            // Ot
            i = 0
            WhileLoop LessThan(i, n) {
                ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(n)))
                CAD_Tess.RayHitRect2D(hcx, hcy, ang, pack)
                rx = Float_Add(oxx, ArrayGet(pack, 2))
                ry = Float_Add(oyy, ArrayGet(pack, 3))
                ArraySet(v_base, Multiply(nv, 3), rx)
                ArraySet(v_base, Add(Multiply(nv, 3), 1), ry)
                ArraySet(v_base, Add(Multiply(nv, 3), 2), dz)
                nv = Add(nv, 1)
                i = Add(i, 1)
            }
            // Ob
            i = 0
            WhileLoop LessThan(i, n) {
                ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(n)))
                CAD_Tess.RayHitRect2D(hcx, hcy, ang, pack)
                rx = Float_Add(oxx, ArrayGet(pack, 2))
                ry = Float_Add(oyy, ArrayGet(pack, 3))
                ArraySet(v_base, Multiply(nv, 3), rx)
                ArraySet(v_base, Add(Multiply(nv, 3), 1), ry)
                ArraySet(v_base, Add(Multiply(nv, 3), 2), zro)
                nv = Add(nv, 1)
                i = Add(i, 1)
            }
            hi = Add(hi, 1)
        }
        // top annulus per hole with ownership filter
        hi = 0
        WhileLoop LessThan(hi, nh) {
            n = ArrayGet(hn, hi)
            b = ArrayGet(hbase, hi)
            // Hb=b, Ht=b+n, Ot=b+2n, Ob=b+3n; corners 0..3
            ArraySet(kpack, 0, hi)
            i = 0
            WhileLoop LessThan(i, n) {
                j = Add(i, 1)
                IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
                oi = Add(b, Add(Multiply(n, 2), i))
                oj = Add(b, Add(Multiply(n, 2), j))
                thi = Add(b, Add(n, i))
                thj = Add(b, Add(n, j))
                // RectEdgeId needs local xy
                ArraySet(pack, 2, Float_Sub(ArrayGet(v_base, Multiply(oi, 3)), oxx))
                ArraySet(pack, 3, Float_Sub(ArrayGet(v_base, Add(Multiply(oi, 3), 1)), oyy))
                ei = CAD_Tess.RectEdgeId(pack)
                ArraySet(pack, 2, Float_Sub(ArrayGet(v_base, Multiply(oj, 3)), oxx))
                ArraySet(pack, 3, Float_Sub(ArrayGet(v_base, Add(Multiply(oj, 3), 1)), oyy))
                ej = CAD_Tess.RectEdgeId(pack)
                IfCondition EqualTo(ei, ej) ThenBlock: {
                    IfCondition EqualTo(CAD_Tess.KeepAnnulusTri(v_base, oi, oj, thj, kpack), 1) ThenBlock: {
                        tt = Multiply(tri, 3)
                        ArraySet(i_base, tt, oi)
                        ArraySet(i_base, Add(tt, 1), oj)
                        ArraySet(i_base, Add(tt, 2), thj)
                        tri = Add(tri, 1)
                    }
                    IfCondition EqualTo(CAD_Tess.KeepAnnulusTri(v_base, oi, thj, thi, kpack), 1) ThenBlock: {
                        tt = Multiply(tri, 3)
                        ArraySet(i_base, tt, oi)
                        ArraySet(i_base, Add(tt, 1), thj)
                        ArraySet(i_base, Add(tt, 2), thi)
                        tri = Add(tri, 1)
                    }
                }
                IfCondition NotEqual(ei, ej) ThenBlock: {
                    cn = ej
                    IfCondition EqualTo(CAD_Tess.KeepAnnulusTri(v_base, oi, cn, thi, kpack), 1) ThenBlock: {
                        tt = Multiply(tri, 3)
                        ArraySet(i_base, tt, oi)
                        ArraySet(i_base, Add(tt, 1), cn)
                        ArraySet(i_base, Add(tt, 2), thi)
                        tri = Add(tri, 1)
                    }
                    IfCondition EqualTo(CAD_Tess.KeepAnnulusTri(v_base, cn, oj, thj, kpack), 1) ThenBlock: {
                        tt = Multiply(tri, 3)
                        ArraySet(i_base, tt, cn)
                        ArraySet(i_base, Add(tt, 1), oj)
                        ArraySet(i_base, Add(tt, 2), thj)
                        tri = Add(tri, 1)
                    }
                    IfCondition EqualTo(CAD_Tess.KeepAnnulusTri(v_base, cn, thj, thi, kpack), 1) ThenBlock: {
                        tt = Multiply(tri, 3)
                        ArraySet(i_base, tt, cn)
                        ArraySet(i_base, Add(tt, 1), thj)
                        ArraySet(i_base, Add(tt, 2), thi)
                        tri = Add(tri, 1)
                    }
                }
                i = Add(i, 1)
            }
            hi = Add(hi, 1)
        }
        // bottom: through-hole annuli with filter; if no through, solid
        n_thru = 0
        hi = 0
        WhileLoop LessThan(hi, nh) {
            hdep = ArrayGet(holes, Add(Add(1, Multiply(hi, 4)), 3))
            IfCondition EqualTo(CAD_Num.IsEqual(hdep, dz, 0), 1) ThenBlock: { n_thru = Add(n_thru, 1) }
            hi = Add(hi, 1)
        }
        IfCondition EqualTo(n_thru, 0) ThenBlock: {
            tt = Multiply(tri, 3)
            ArraySet(i_base, tt, 4)
            ArraySet(i_base, Add(tt, 1), 6)
            ArraySet(i_base, Add(tt, 2), 5)
            tri = Add(tri, 1)
            tt = Multiply(tri, 3)
            ArraySet(i_base, tt, 4)
            ArraySet(i_base, Add(tt, 1), 7)
            ArraySet(i_base, Add(tt, 2), 6)
            tri = Add(tri, 1)
        }
        IfCondition GreaterThan(n_thru, 0) ThenBlock: {
            ArraySet(kpack, 4, 1)
            hi = 0
            WhileLoop LessThan(hi, nh) {
                hdep = ArrayGet(holes, Add(Add(1, Multiply(hi, 4)), 3))
                IfCondition EqualTo(CAD_Num.IsEqual(hdep, dz, 0), 1) ThenBlock: {
                    n = ArrayGet(hn, hi)
                    b = ArrayGet(hbase, hi)
                    ArraySet(kpack, 0, hi)
                    i = 0
                    WhileLoop LessThan(i, n) {
                        j = Add(i, 1)
                        IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
                        oi = Add(b, Add(Multiply(n, 3), i))
                        oj = Add(b, Add(Multiply(n, 3), j))
                        bi = Add(b, i)
                        bj = Add(b, j)
                        ArraySet(pack, 2, Float_Sub(ArrayGet(v_base, Multiply(oi, 3)), oxx))
                        ArraySet(pack, 3, Float_Sub(ArrayGet(v_base, Add(Multiply(oi, 3), 1)), oyy))
                        ei = CAD_Tess.RectEdgeId(pack)
                        ArraySet(pack, 2, Float_Sub(ArrayGet(v_base, Multiply(oj, 3)), oxx))
                        ArraySet(pack, 3, Float_Sub(ArrayGet(v_base, Add(Multiply(oj, 3), 1)), oyy))
                        ej = CAD_Tess.RectEdgeId(pack)
                        IfCondition EqualTo(ei, ej) ThenBlock: {
                            IfCondition EqualTo(CAD_Tess.KeepAnnulusTri(v_base, oi, bi, bj, kpack), 1) ThenBlock: {
                                tt = Multiply(tri, 3)
                                ArraySet(i_base, tt, oi)
                                ArraySet(i_base, Add(tt, 1), bi)
                                ArraySet(i_base, Add(tt, 2), bj)
                                tri = Add(tri, 1)
                            }
                            IfCondition EqualTo(CAD_Tess.KeepAnnulusTri(v_base, oi, bj, oj, kpack), 1) ThenBlock: {
                                tt = Multiply(tri, 3)
                                ArraySet(i_base, tt, oi)
                                ArraySet(i_base, Add(tt, 1), bj)
                                ArraySet(i_base, Add(tt, 2), oj)
                                tri = Add(tri, 1)
                            }
                        }
                        IfCondition NotEqual(ei, ej) ThenBlock: {
                            cn = Add(4, ej)
                            IfCondition EqualTo(CAD_Tess.KeepAnnulusTri(v_base, oi, bi, cn, kpack), 1) ThenBlock: {
                                tt = Multiply(tri, 3)
                                ArraySet(i_base, tt, oi)
                                ArraySet(i_base, Add(tt, 1), bi)
                                ArraySet(i_base, Add(tt, 2), cn)
                                tri = Add(tri, 1)
                            }
                            IfCondition EqualTo(CAD_Tess.KeepAnnulusTri(v_base, cn, bj, oj, kpack), 1) ThenBlock: {
                                tt = Multiply(tri, 3)
                                ArraySet(i_base, tt, cn)
                                ArraySet(i_base, Add(tt, 1), bj)
                                ArraySet(i_base, Add(tt, 2), oj)
                                tri = Add(tri, 1)
                            }
                            IfCondition EqualTo(CAD_Tess.KeepAnnulusTri(v_base, cn, bi, bj, kpack), 1) ThenBlock: {
                                tt = Multiply(tri, 3)
                                ArraySet(i_base, tt, cn)
                                ArraySet(i_base, Add(tt, 1), bi)
                                ArraySet(i_base, Add(tt, 2), bj)
                                tri = Add(tri, 1)
                            }
                        }
                        i = Add(i, 1)
                    }
                }
                hi = Add(hi, 1)
            }
        }
        // walls + blind floors
        hi = 0
        WhileLoop LessThan(hi, nh) {
            base = Add(1, Multiply(hi, 4))
            hdep = ArrayGet(holes, Add(base, 3))
            through = 0
            IfCondition EqualTo(CAD_Num.IsEqual(hdep, dz, 0), 1) ThenBlock: { through = 1 }
            n = ArrayGet(hn, hi)
            b = ArrayGet(hbase, hi)
            i = 0
            WhileLoop LessThan(i, n) {
                j = Add(i, 1)
                IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
                bi = Add(b, i)
                bj = Add(b, j)
                ti = Add(b, Add(n, i))
                tj = Add(b, Add(n, j))
                tt = Multiply(tri, 3)
                ArraySet(i_base, tt, bi)
                ArraySet(i_base, Add(tt, 1), ti)
                ArraySet(i_base, Add(tt, 2), tj)
                tri = Add(tri, 1)
                tt = Multiply(tri, 3)
                ArraySet(i_base, tt, bi)
                ArraySet(i_base, Add(tt, 1), tj)
                ArraySet(i_base, Add(tt, 2), bj)
                tri = Add(tri, 1)
                i = Add(i, 1)
            }
            IfCondition EqualTo(through, 0) ThenBlock: {
                i = 1
                WhileLoop LessThan(i, Subtract(n, 1)) {
                    tt = Multiply(tri, 3)
                    ArraySet(i_base, tt, b)
                    ArraySet(i_base, Add(tt, 1), Add(b, i))
                    ArraySet(i_base, Add(tt, 2), Add(b, Add(i, 1)))
                    tri = Add(tri, 1)
                    i = Add(i, 1)
                }
            }
            hi = Add(hi, 1)
        }
        ArraySet(out_mesh_addr, 0, nv)
        ArraySet(out_mesh_addr, 1, tri)
        ArraySet(out_mesh_addr, 2, v_base)
        ArraySet(out_mesh_addr, 3, i_base)
        ArraySet(out_mesh_addr, 4, 262144)
        ArraySet(out_mesh_addr, 5, 131072)
        CAD_Tess_State.tess_count = Add(CAD_Tess_State.tess_count, 1)
        CAD_Tess_State.triangle_count = tri
        CAD_Tess_State.vertex_count = nv
        Deallocate(holes, 128)
        Deallocate(hbase, 32)
        Deallocate(hn, 32)
        Deallocate(pack, 64)
        Deallocate(kpack, 64)
        ReturnValue(tri)
    }
}

// Plate + circular hole(s). Sharp outer corners for single-hole path.
// Verts: Hb[0..n) Ht[n..2n) Ot[2n..3n) Ob[3n..4n) Ct[4n..4n+3] Cb[4n+4..4n+7]
Function.CAD_Tess.MeshBoxThroughHole {
    Input: params_h: Integer
    Input: defl_r: Integer
    Input: out_mesh_addr: Address
    Output: Integer
    Body: {
        nh = CAD_Store.Read(params_h, 9)
        IfCondition GreaterThan(nh, 1) ThenBlock: {
            ReturnValue(CAD_Tess.MeshBoxMultiHole(params_h, defl_r, out_mesh_addr))
        }
        dx = CAD_Store.Read(params_h, 0)
        dy = CAD_Store.Read(params_h, 1)
        dz = CAD_Store.Read(params_h, 2)
        hr = CAD_Store.Read(params_h, 3)
        cx = CAD_Store.Read(params_h, 4)
        cy = CAD_Store.Read(params_h, 5)
        oxx = CAD_Store.Read(params_h, 6)
        oyy = CAD_Store.Read(params_h, 7)
        hdep = CAD_Store.Read(params_h, 8)
        IfCondition EqualTo(CAD_Num.IsZero(hdep, 0), 1) ThenBlock: { hdep = dz }
        IfCondition EqualTo(Float_Le(dz, hdep), 1) ThenBlock: { hdep = dz }
        // z of hole floor (top is always dz); through ⇒ floor at 0
        z_floor = Float_Sub(dz, hdep)
        through = 0
        IfCondition EqualTo(CAD_Num.IsEqual(hdep, dz, 0), 1) ThenBlock: { through = 1 }
        n = CAD_Tess.CircleSegCount(hr, defl_r)
        v_base = Allocate(262144)
        i_base = Allocate(131072)
        pack = Allocate(64)
        ArraySet(pack, 0, dx)
        ArraySet(pack, 1, dy)
        two_pi = 0x401921FB54442D18
        nf = Float_FromInt(n)
        zro = 0
        lcx = cx
        lcy = cy
        i = 0
        WhileLoop LessThan(i, n) {
            ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), nf))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            hx = Float_Add(Float_Add(oxx, lcx), Float_Mul(hr, c))
            hy = Float_Add(Float_Add(oyy, lcy), Float_Mul(hr, s))
            CAD_Tess.RayHitRect2D(lcx, lcy, ang, pack)
            rx = Float_Add(oxx, ArrayGet(pack, 2))
            ry = Float_Add(oyy, ArrayGet(pack, 3))
            // Hb = hole lower rim (z_floor), Ht = hole upper rim (dz)
            vo = Multiply(i, 3)
            ArraySet(v_base, vo, hx)
            ArraySet(v_base, Add(vo, 1), hy)
            ArraySet(v_base, Add(vo, 2), z_floor)
            vo = Multiply(Add(i, n), 3)
            ArraySet(v_base, vo, hx)
            ArraySet(v_base, Add(vo, 1), hy)
            ArraySet(v_base, Add(vo, 2), dz)
            vo = Multiply(Add(i, Multiply(n, 2)), 3)
            ArraySet(v_base, vo, rx)
            ArraySet(v_base, Add(vo, 1), ry)
            ArraySet(v_base, Add(vo, 2), dz)
            vo = Multiply(Add(i, Multiply(n, 3)), 3)
            ArraySet(v_base, vo, rx)
            ArraySet(v_base, Add(vo, 1), ry)
            ArraySet(v_base, Add(vo, 2), zro)
            i = Add(i, 1)
        }
        // sharp corners top/bot in world (oxx,oyy)+local corners
        ct = Multiply(n, 4)
        ArraySet(v_base, Multiply(ct, 3), oxx)
        ArraySet(v_base, Add(Multiply(ct, 3), 1), oyy)
        ArraySet(v_base, Add(Multiply(ct, 3), 2), dz)
        ArraySet(v_base, Multiply(Add(ct, 1), 3), Float_Add(oxx, dx))
        ArraySet(v_base, Add(Multiply(Add(ct, 1), 3), 1), oyy)
        ArraySet(v_base, Add(Multiply(Add(ct, 1), 3), 2), dz)
        ArraySet(v_base, Multiply(Add(ct, 2), 3), Float_Add(oxx, dx))
        ArraySet(v_base, Add(Multiply(Add(ct, 2), 3), 1), Float_Add(oyy, dy))
        ArraySet(v_base, Add(Multiply(Add(ct, 2), 3), 2), dz)
        ArraySet(v_base, Multiply(Add(ct, 3), 3), oxx)
        ArraySet(v_base, Add(Multiply(Add(ct, 3), 3), 1), Float_Add(oyy, dy))
        ArraySet(v_base, Add(Multiply(Add(ct, 3), 3), 2), dz)
        cb = Add(ct, 4)
        ArraySet(v_base, Multiply(cb, 3), oxx)
        ArraySet(v_base, Add(Multiply(cb, 3), 1), oyy)
        ArraySet(v_base, Add(Multiply(cb, 3), 2), zro)
        ArraySet(v_base, Multiply(Add(cb, 1), 3), Float_Add(oxx, dx))
        ArraySet(v_base, Add(Multiply(Add(cb, 1), 3), 1), oyy)
        ArraySet(v_base, Add(Multiply(Add(cb, 1), 3), 2), zro)
        ArraySet(v_base, Multiply(Add(cb, 2), 3), Float_Add(oxx, dx))
        ArraySet(v_base, Add(Multiply(Add(cb, 2), 3), 1), Float_Add(oyy, dy))
        ArraySet(v_base, Add(Multiply(Add(cb, 2), 3), 2), zro)
        ArraySet(v_base, Multiply(Add(cb, 3), 3), oxx)
        ArraySet(v_base, Add(Multiply(Add(cb, 3), 3), 1), Float_Add(oyy, dy))
        ArraySet(v_base, Add(Multiply(Add(cb, 3), 3), 2), zro)

        tri = 0
        // top annulus: follow rect perimeter (insert corner when edge changes)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            oi = Add(i, Multiply(n, 2))
            oj = Add(j, Multiply(n, 2))
            hi = Add(i, n)
            hj = Add(j, n)
            // edge ids for Ot[i], Ot[j]
            ArraySet(pack, 2, ArrayGet(v_base, Multiply(oi, 3)))
            ArraySet(pack, 3, ArrayGet(v_base, Add(Multiply(oi, 3), 1)))
            ei = CAD_Tess.RectEdgeId(pack)
            ArraySet(pack, 2, ArrayGet(v_base, Multiply(oj, 3)))
            ArraySet(pack, 3, ArrayGet(v_base, Add(Multiply(oj, 3), 1)))
            ej = CAD_Tess.RectEdgeId(pack)
            IfCondition EqualTo(ei, ej) ThenBlock: {
                // same edge: chord is on boundary — OK
                tt = Multiply(tri, 3)
                ArraySet(i_base, tt, oi)
                ArraySet(i_base, Add(tt, 1), oj)
                ArraySet(i_base, Add(tt, 2), hj)
                tri = Add(tri, 1)
                tt = Multiply(tri, 3)
                ArraySet(i_base, tt, oi)
                ArraySet(i_base, Add(tt, 1), hj)
                ArraySet(i_base, Add(tt, 2), hi)
                tri = Add(tri, 1)
            }
            IfCondition NotEqual(ei, ej) ThenBlock: {
                // corner between ei and ej (CCW outer: next corner is ej's start)
                // edge 0→1 corner (dx,0)=ct+1; 1→2 (dx,dy)=ct+2; 2→3 (0,dy)=ct+3; 3→0 (0,0)=ct+0
                cn = Add(ct, ej)
                // Oi → corner → Oj along perimeter; tris with hole
                tt = Multiply(tri, 3)
                ArraySet(i_base, tt, oi)
                ArraySet(i_base, Add(tt, 1), cn)
                ArraySet(i_base, Add(tt, 2), hi)
                tri = Add(tri, 1)
                tt = Multiply(tri, 3)
                ArraySet(i_base, tt, cn)
                ArraySet(i_base, Add(tt, 1), oj)
                ArraySet(i_base, Add(tt, 2), hj)
                tri = Add(tri, 1)
                tt = Multiply(tri, 3)
                ArraySet(i_base, tt, cn)
                ArraySet(i_base, Add(tt, 1), hj)
                ArraySet(i_base, Add(tt, 2), hi)
                tri = Add(tri, 1)
            }
            i = Add(i, 1)
        }
        // through: bottom annulus at z=0; blind: solid bottom + hole floor disk
        IfCondition EqualTo(through, 1) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, n) {
                j = Add(i, 1)
                IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
                oi = Add(i, Multiply(n, 3))
                oj = Add(j, Multiply(n, 3))
                hi = i
                hj = j
                ArraySet(pack, 2, ArrayGet(v_base, Multiply(oi, 3)))
                ArraySet(pack, 3, ArrayGet(v_base, Add(Multiply(oi, 3), 1)))
                ei = CAD_Tess.RectEdgeId(pack)
                ArraySet(pack, 2, ArrayGet(v_base, Multiply(oj, 3)))
                ArraySet(pack, 3, ArrayGet(v_base, Add(Multiply(oj, 3), 1)))
                ej = CAD_Tess.RectEdgeId(pack)
                IfCondition EqualTo(ei, ej) ThenBlock: {
                    tt = Multiply(tri, 3)
                    ArraySet(i_base, tt, oi)
                    ArraySet(i_base, Add(tt, 1), hi)
                    ArraySet(i_base, Add(tt, 2), hj)
                    tri = Add(tri, 1)
                    tt = Multiply(tri, 3)
                    ArraySet(i_base, tt, oi)
                    ArraySet(i_base, Add(tt, 1), hj)
                    ArraySet(i_base, Add(tt, 2), oj)
                    tri = Add(tri, 1)
                }
                IfCondition NotEqual(ei, ej) ThenBlock: {
                    cn = Add(cb, ej)
                    tt = Multiply(tri, 3)
                    ArraySet(i_base, tt, oi)
                    ArraySet(i_base, Add(tt, 1), hi)
                    ArraySet(i_base, Add(tt, 2), cn)
                    tri = Add(tri, 1)
                    tt = Multiply(tri, 3)
                    ArraySet(i_base, tt, cn)
                    ArraySet(i_base, Add(tt, 1), hj)
                    ArraySet(i_base, Add(tt, 2), oj)
                    tri = Add(tri, 1)
                    tt = Multiply(tri, 3)
                    ArraySet(i_base, tt, cn)
                    ArraySet(i_base, Add(tt, 1), hi)
                    ArraySet(i_base, Add(tt, 2), hj)
                    tri = Add(tri, 1)
                }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(through, 0) ThenBlock: {
            // full bottom plate z=0: two tris on corners cb
            tt = Multiply(tri, 3)
            ArraySet(i_base, tt, cb)
            ArraySet(i_base, Add(tt, 1), Add(cb, 2))
            ArraySet(i_base, Add(tt, 2), Add(cb, 1))
            tri = Add(tri, 1)
            tt = Multiply(tri, 3)
            ArraySet(i_base, tt, cb)
            ArraySet(i_base, Add(tt, 1), Add(cb, 3))
            ArraySet(i_base, Add(tt, 2), Add(cb, 2))
            tri = Add(tri, 1)
            // hole floor disk at z_floor: fan from Hb[0]
            i = 1
            WhileLoop LessThan(i, Subtract(n, 1)) {
                tt = Multiply(tri, 3)
                ArraySet(i_base, tt, 0)
                ArraySet(i_base, Add(tt, 1), i)
                ArraySet(i_base, Add(tt, 2), Add(i, 1))
                tri = Add(tri, 1)
                i = Add(i, 1)
            }
        }
        // hole wall Hb–Ht
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            bi = i
            bj = j
            ti = Add(i, n)
            tj = Add(j, n)
            tt = Multiply(tri, 3)
            ArraySet(i_base, tt, bi)
            ArraySet(i_base, Add(tt, 1), ti)
            ArraySet(i_base, Add(tt, 2), tj)
            tri = Add(tri, 1)
            tt = Multiply(tri, 3)
            ArraySet(i_base, tt, bi)
            ArraySet(i_base, Add(tt, 1), tj)
            ArraySet(i_base, Add(tt, 2), bj)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        // outer vertical walls: sharp corner verts cb/ct
        // sides: cb0-cb1-ct1-ct0, etc.
        // side 0 y=0
        tt = Multiply(tri, 3)
        ArraySet(i_base, tt, cb)
        ArraySet(i_base, Add(tt, 1), Add(cb, 1))
        ArraySet(i_base, Add(tt, 2), Add(ct, 1))
        tri = Add(tri, 1)
        tt = Multiply(tri, 3)
        ArraySet(i_base, tt, cb)
        ArraySet(i_base, Add(tt, 1), Add(ct, 1))
        ArraySet(i_base, Add(tt, 2), ct)
        tri = Add(tri, 1)
        // side 1 x=dx
        tt = Multiply(tri, 3)
        ArraySet(i_base, tt, Add(cb, 1))
        ArraySet(i_base, Add(tt, 1), Add(cb, 2))
        ArraySet(i_base, Add(tt, 2), Add(ct, 2))
        tri = Add(tri, 1)
        tt = Multiply(tri, 3)
        ArraySet(i_base, tt, Add(cb, 1))
        ArraySet(i_base, Add(tt, 1), Add(ct, 2))
        ArraySet(i_base, Add(tt, 2), Add(ct, 1))
        tri = Add(tri, 1)
        // side 2 y=dy
        tt = Multiply(tri, 3)
        ArraySet(i_base, tt, Add(cb, 2))
        ArraySet(i_base, Add(tt, 1), Add(cb, 3))
        ArraySet(i_base, Add(tt, 2), Add(ct, 3))
        tri = Add(tri, 1)
        tt = Multiply(tri, 3)
        ArraySet(i_base, tt, Add(cb, 2))
        ArraySet(i_base, Add(tt, 1), Add(ct, 3))
        ArraySet(i_base, Add(tt, 2), Add(ct, 2))
        tri = Add(tri, 1)
        // side 3 x=0
        tt = Multiply(tri, 3)
        ArraySet(i_base, tt, Add(cb, 3))
        ArraySet(i_base, Add(tt, 1), cb)
        ArraySet(i_base, Add(tt, 2), ct)
        tri = Add(tri, 1)
        tt = Multiply(tri, 3)
        ArraySet(i_base, tt, Add(cb, 3))
        ArraySet(i_base, Add(tt, 1), ct)
        ArraySet(i_base, Add(tt, 2), Add(ct, 3))
        tri = Add(tri, 1)

        nv = Add(Multiply(n, 4), 8)
        ArraySet(out_mesh_addr, 0, nv)
        ArraySet(out_mesh_addr, 1, tri)
        ArraySet(out_mesh_addr, 2, v_base)
        ArraySet(out_mesh_addr, 3, i_base)
        ArraySet(out_mesh_addr, 4, 262144)
        ArraySet(out_mesh_addr, 5, 131072)
        CAD_Tess_State.tess_count = Add(CAD_Tess_State.tess_count, 1)
        CAD_Tess_State.triangle_count = tri
        CAD_Tess_State.vertex_count = nv
        Deallocate(pack, 64)
        ReturnValue(tri)
    }
}

// Watertight UV sphere: 1 N-pole + 1 S-pole + rings (no pole seams).
// params: r, cx, cy, cz. Closed solid mesh (every edge used twice).
Function.CAD_Tess.MeshSphereAnalytic {
    Input: params_h: Integer
    Input: defl_r: Integer
    Input: out_mesh_addr: Address
    Output: Integer
    Body: {
        r = CAD_Store.Read(params_h, 0)
        cx = CAD_Store.Read(params_h, 1)
        cy = CAD_Store.Read(params_h, 2)
        cz = CAD_Store.Read(params_h, 3)
        // rings between poles; slices around
        rings = 12
        slices = 24
        v_base = Allocate(262144)
        i_base = Allocate(131072)
        pi_r = 0x400921FB54442D18
        two_pi = 0x401921FB54442D18
        // vert 0 = north pole, 1 = south pole
        // then ring i=0..rings-1, j=0..slices-1 at index 2 + i*slices + j
        ArraySet(v_base, 0, cx)
        ArraySet(v_base, 1, cy)
        ArraySet(v_base, 2, Float_Add(cz, r))
        ArraySet(v_base, 3, cx)
        ArraySet(v_base, 4, cy)
        ArraySet(v_base, 5, Float_Sub(cz, r))
        nv = 2
        i = 0
        WhileLoop LessThan(i, rings) {
            // phi in (0,pi) exclusive poles: (i+1)/(rings+1)*pi
            phi = Float_Mul(pi_r, Float_Div(Float_FromInt(Add(i, 1)), Float_FromInt(Add(rings, 1))))
            sp = CAD_Geom.Sin(phi)
            cp = CAD_Geom.Cos(phi)
            j = 0
            WhileLoop LessThan(j, slices) {
                th = Float_Mul(two_pi, Float_Div(Float_FromInt(j), Float_FromInt(slices)))
                ct = CAD_Geom.Cos(th)
                st = CAD_Geom.Sin(th)
                x = Float_Add(cx, Float_Mul(r, Float_Mul(sp, ct)))
                y = Float_Add(cy, Float_Mul(r, Float_Mul(sp, st)))
                z = Float_Add(cz, Float_Mul(r, cp))
                vo = Multiply(nv, 3)
                ArraySet(v_base, vo, x)
                ArraySet(v_base, Add(vo, 1), y)
                ArraySet(v_base, Add(vo, 2), z)
                nv = Add(nv, 1)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        tri = 0
        // north pole fan to ring 0
        j = 0
        WhileLoop LessThan(j, slices) {
            jn = Add(j, 1)
            IfCondition GreaterEqual(jn, slices) ThenBlock: { jn = 0 }
            a = 0
            b = Add(2, j)
            c0 = Add(2, jn)
            tt = Multiply(tri, 3)
            ArraySet(i_base, tt, a)
            ArraySet(i_base, Add(tt, 1), b)
            ArraySet(i_base, Add(tt, 2), c0)
            tri = Add(tri, 1)
            j = Add(j, 1)
        }
        // quads between rings
        i = 0
        WhileLoop LessThan(i, Subtract(rings, 1)) {
            j = 0
            WhileLoop LessThan(j, slices) {
                jn = Add(j, 1)
                IfCondition GreaterEqual(jn, slices) ThenBlock: { jn = 0 }
                a = Add(2, Add(Multiply(i, slices), j))
                b = Add(2, Add(Multiply(i, slices), jn))
                c0 = Add(2, Add(Multiply(Add(i, 1), slices), j))
                d = Add(2, Add(Multiply(Add(i, 1), slices), jn))
                tt = Multiply(tri, 3)
                ArraySet(i_base, tt, a)
                ArraySet(i_base, Add(tt, 1), c0)
                ArraySet(i_base, Add(tt, 2), b)
                tri = Add(tri, 1)
                tt = Multiply(tri, 3)
                ArraySet(i_base, tt, b)
                ArraySet(i_base, Add(tt, 1), c0)
                ArraySet(i_base, Add(tt, 2), d)
                tri = Add(tri, 1)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        // south pole fan from last ring
        base = Add(2, Multiply(Subtract(rings, 1), slices))
        j = 0
        WhileLoop LessThan(j, slices) {
            jn = Add(j, 1)
            IfCondition GreaterEqual(jn, slices) ThenBlock: { jn = 0 }
            a = 1
            b = Add(base, jn)
            c0 = Add(base, j)
            tt = Multiply(tri, 3)
            ArraySet(i_base, tt, a)
            ArraySet(i_base, Add(tt, 1), b)
            ArraySet(i_base, Add(tt, 2), c0)
            tri = Add(tri, 1)
            j = Add(j, 1)
        }
        ArraySet(out_mesh_addr, 0, nv)
        ArraySet(out_mesh_addr, 1, tri)
        ArraySet(out_mesh_addr, 2, v_base)
        ArraySet(out_mesh_addr, 3, i_base)
        ArraySet(out_mesh_addr, 4, 262144)
        ArraySet(out_mesh_addr, 5, 131072)
        CAD_Tess_State.tess_count = Add(CAD_Tess_State.tess_count, 1)
        CAD_Tess_State.triangle_count = tri
        CAD_Tess_State.vertex_count = nv
        ReturnValue(tri)
    }
}

// Append loop verts to v_base; write mesh vert indices into idx_addr[0..n).
// pack: [0]=vert_count in/out. Returns n or 0.
Function.CAD_Tess.CollectLoopVerts {
    Input: loop_h: Integer
    Input: v_base: Address
    Input: idx_addr: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(loop_h, 0) ThenBlock: { ReturnValue(0) }
        n = CAD_Topo.LoopCountCoedges(loop_h)
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        // was 256 — multi-circle pads need denser caps (aligned with prism 2048)
        IfCondition GreaterThan(n, 2048) ThenBlock: { ReturnValue(0) }
        vc = ArrayGet(pack_addr, 0)
        head = CAD_Store.Read(loop_h, 0)
        ce = head
        k = 0
        wrote = 0
        WhileLoop LessThan(k, n) {
            did_c = 0
            ed = CAD_Store.Read(ce, 0)
            IfCondition NotEqual(ed, 0) ThenBlock: {
                crv = CAD_Store.Read(ed, 2)
                IfCondition NotEqual(crv, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                        rad = CAD_Store.Read(crv, 10)
                        nseg = CAD_Tess.CircleSegCount(rad, 0)
                        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: {
                            CAD_Tess_State.samp = Allocate(8192)
                        }
                        ns = CAD_Tess.SampleCircleEdge(ed, nseg, CAD_Tess_State.samp)
                        samp = CAD_Tess_State.samp
                        // closed ring: drop the duplicate last sample
                        IfCondition GreaterThan(ns, 1) ThenBlock: {
                            ev0 = CAD_Store.Read(ed, 0)
                            ev1 = CAD_Store.Read(ed, 1)
                            IfCondition EqualTo(ev0, ev1) ThenBlock: { ns = Subtract(ns, 1) }
                        }
                        si = 0
                        WhileLoop LessThan(si, ns) {
                            vo = Multiply(Add(vc, wrote), 3)
                            ArraySet(v_base, vo, ArrayGet(samp, Multiply(si, 3)))
                            ArraySet(v_base, Add(vo, 1), ArrayGet(samp, Add(Multiply(si, 3), 1)))
                            ArraySet(v_base, Add(vo, 2), ArrayGet(samp, Add(Multiply(si, 3), 2)))
                            ArraySet(idx_addr, wrote, Add(vc, wrote))
                            wrote = Add(wrote, 1)
                            si = Add(si, 1)
                        }
                        did_c = 1
                    }
                }
            }
            IfCondition EqualTo(did_c, 0) ThenBlock: {
                origin = CAD_Store.Read(ce, 5)
                IfCondition NotEqual(origin, 0) ThenBlock: {
                    vo = Multiply(Add(vc, wrote), 3)
                    ArraySet(v_base, vo, CAD_Store.Read(origin, 0))
                    ArraySet(v_base, Add(vo, 1), CAD_Store.Read(origin, 1))
                    ArraySet(v_base, Add(vo, 2), CAD_Store.Read(origin, 2))
                    ArraySet(idx_addr, wrote, Add(vc, wrote))
                    wrote = Add(wrote, 1)
                }
            }
            ce = CAD_Store.Read(ce, 2)
            k = Add(k, 1)
        }
        ArraySet(pack_addr, 0, Add(vc, wrote))
        ReturnValue(wrote)
    }
}

// Sample minor arc of a CIRCLE edge into out_xyz (nseg+1 points, xyz triples).
// Returns nseg+1 or 0.
Function.CAD_Tess.SampleCircleEdge {
    Input: edge_h: Integer
    Input: nseg: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg, 2) ThenBlock: { nseg = 8 }
        crv = CAD_Store.Read(edge_h, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        ck = CAD_Store.Read(crv, 0)
        // 2=circle  3=ellipse (digon fillet ends)
        IfCondition EqualTo(ck, 2) ThenBlock: { ck = 2 }
        IfCondition NotEqual(ck, 2) ThenBlock: {
            IfCondition NotEqual(ck, 3) ThenBlock: { ReturnValue(0) }
        }
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(crv, 1)
        cy = CAD_Store.Read(crv, 2)
        cz = CAD_Store.Read(crv, 3)
        xx = CAD_Store.Read(crv, 4)
        xy = CAD_Store.Read(crv, 5)
        xz = CAD_Store.Read(crv, 6)
        yx = CAD_Store.Read(crv, 7)
        yy = CAD_Store.Read(crv, 8)
        yz = CAD_Store.Read(crv, 9)
        rad = CAD_Store.Read(crv, 10)
        rmin = rad
        IfCondition EqualTo(ck, 3) ThenBlock: {
            rmin = CAD_Store.Read(crv, 11)
        }
        // θ from atan2(dot(P-C,Y), dot(P-C,X))
        p0x = Float_Sub(CAD_Store.Read(v0, 0), cx)
        p0y = Float_Sub(CAD_Store.Read(v0, 1), cy)
        p0z = Float_Sub(CAD_Store.Read(v0, 2), cz)
        p1x = Float_Sub(CAD_Store.Read(v1, 0), cx)
        p1y = Float_Sub(CAD_Store.Read(v1, 1), cy)
        p1z = Float_Sub(CAD_Store.Read(v1, 2), cz)
        d0x = Float_Add(Float_Add(Float_Mul(p0x, xx), Float_Mul(p0y, xy)), Float_Mul(p0z, xz))
        d0y = Float_Add(Float_Add(Float_Mul(p0x, yx), Float_Mul(p0y, yy)), Float_Mul(p0z, yz))
        d1x = Float_Add(Float_Add(Float_Mul(p1x, xx), Float_Mul(p1y, xy)), Float_Mul(p1z, xz))
        d1y = Float_Add(Float_Add(Float_Mul(p1x, yx), Float_Mul(p1y, yy)), Float_Mul(p1z, yz))
        // ellipse parameter uses (dotX/Rmaj, dotY/Rmin)
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 0) ThenBlock: {
            d0x = Float_Div(d0x, rad)
            d1x = Float_Div(d1x, rad)
        }
        IfCondition EqualTo(CAD_Num.IsZero(rmin, 0), 0) ThenBlock: {
            d0y = Float_Div(d0y, rmin)
            d1y = Float_Div(d1y, rmin)
        }
        a0 = CAD_Geom.Atan2(d0y, d0x)
        a1 = CAD_Geom.Atan2(d1y, d1x)
        two_pi = 0x401921FB54442D18
        span = Float_Sub(a1, a0)
        // Closed circle (v0==v1): full turn. Atan2 span would be 0.
        IfCondition EqualTo(v0, v1) ThenBlock: {
            span = two_pi
        }
        IfCondition NotEqual(v0, v1) ThenBlock: {
            // wrap to (-π, π]
            pi = 0x400921FB54442D18
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(span, Float_Sub(0, pi))), 1) ThenBlock: {
                span = Float_Add(span, two_pi)
            }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, span)), 1) ThenBlock: {
                span = Float_Sub(span, two_pi)
            }
        }
        np = Add(nseg, 1)
        i = 0
        WhileLoop LessThan(i, np) {
            t = Float_Div(Float_FromInt(i), Float_FromInt(nseg))
            ang = Float_Add(a0, Float_Mul(span, t))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            // circle: R*(c X + s Y)   ellipse: Rmaj*c X + Rmin*s Y
            px = Float_Add(cx, Float_Add(Float_Mul(Float_Mul(rad, c), xx), Float_Mul(Float_Mul(rmin, s), yx)))
            py = Float_Add(cy, Float_Add(Float_Mul(Float_Mul(rad, c), xy), Float_Mul(Float_Mul(rmin, s), yy)))
            pz = Float_Add(cz, Float_Add(Float_Mul(Float_Mul(rad, c), xz), Float_Mul(Float_Mul(rmin, s), yz)))
            vo = Multiply(i, 3)
            ArraySet(out_xyz, vo, px)
            ArraySet(out_xyz, Add(vo, 1), py)
            ArraySet(out_xyz, Add(vo, 2), pz)
            i = Add(i, 1)
        }
        ReturnValue(np)
    }
}

// Quarter-ellipse from v0 to v1 about the curve origin: P(t)=C+A cos + B sin.
// Digon corners are exactly this (P_ww → P_cap). Avoids Atan2 frame mismatch
// that made SampleCircleEdge return a sliver and MeshCylBlendFace FanNGon
// (flat chamfer, open corner — noendclosure.png).
Function.CAD_Tess.SampleEllipseByEnds {
    Input: edge_h: Integer
    Input: nseg: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg, 2) ThenBlock: { nseg = 8 }
        crv = CAD_Store.Read(edge_h, 2)
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(crv, 1)
        cy = CAD_Store.Read(crv, 2)
        cz = CAD_Store.Read(crv, 3)
        ax = Float_Sub(CAD_Store.Read(v0, 0), cx)
        ay = Float_Sub(CAD_Store.Read(v0, 1), cy)
        az = Float_Sub(CAD_Store.Read(v0, 2), cz)
        bx = Float_Sub(CAD_Store.Read(v1, 0), cx)
        by = Float_Sub(CAD_Store.Read(v1, 1), cy)
        bz = Float_Sub(CAD_Store.Read(v1, 2), cz)
        half_pi = 0x3FF921FB54442D18
        np = Add(nseg, 1)
        i = 0
        WhileLoop LessThan(i, np) {
            t = Float_Div(Float_FromInt(i), Float_FromInt(nseg))
            ang = Float_Mul(half_pi, t)
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            vo = Multiply(i, 3)
            ArraySet(out_xyz, vo, Float_Add(cx, Float_Add(Float_Mul(ax, c), Float_Mul(bx, s))))
            ArraySet(out_xyz, Add(vo, 1), Float_Add(cy, Float_Add(Float_Mul(ay, c), Float_Mul(by, s))))
            ArraySet(out_xyz, Add(vo, 2), Float_Add(cz, Float_Add(Float_Mul(az, c), Float_Mul(bz, s))))
            i = Add(i, 1)
        }
        ReturnValue(np)
    }
}

// Mesh a cylindrical fillet face: two end-arcs → triangle strip (rolled, not chamfer).
Function.CAD_Tess.MeshCylBlendFace {
    Input: face_h: Integer
    Input: v_base: Address
    Input: i_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        loop_h = CAD_Store.Read(face_h, 1)
        IfCondition EqualTo(loop_h, 0) ThenBlock: { ReturnValue(ArrayGet(pack_addr, 1)) }
        e0 = 0
        e1 = 0
        head = CAD_Store.Read(loop_h, 0)
        ce = head
        cg = 0
        dn = 0
        WhileLoop EqualTo(dn, 0) {
            ed = CAD_Store.Read(ce, 0)
            IfCondition NotEqual(ed, 0) ThenBlock: {
                crv = CAD_Store.Read(ed, 2)
                IfCondition NotEqual(crv, 0) ThenBlock: {
                    ck = CAD_Store.Read(crv, 0)
                    is_arc = 0
                    IfCondition EqualTo(ck, 2) ThenBlock: { is_arc = 1 }
                    IfCondition EqualTo(ck, 3) ThenBlock: { is_arc = 1 }
                    IfCondition EqualTo(is_arc, 1) ThenBlock: {
                        IfCondition EqualTo(e0, 0) ThenBlock: { e0 = ed }
                        IfCondition NotEqual(e0, ed) ThenBlock: {
                            IfCondition EqualTo(e1, 0) ThenBlock: { e1 = ed }
                        }
                    }
                }
            }
            ce = CAD_Store.Read(ce, 2)
            cg = Add(cg, 1)
            IfCondition EqualTo(ce, head) ThenBlock: { dn = 1 }
            IfCondition GreaterThan(cg, 32) ThenBlock: { dn = 1 }
        }
        IfCondition EqualTo(e0, 0) ThenBlock: {
            ReturnValue(CAD_Tess.FanNGon(loop_h, CAD_Topo.LoopCountCoedges(loop_h), v_base, i_base, pack_addr))
        }
        IfCondition EqualTo(e1, 0) ThenBlock: {
            ReturnValue(CAD_Tess.FanNGon(loop_h, CAD_Topo.LoopCountCoedges(loop_h), v_base, i_base, pack_addr))
        }
        nseg = 90
        IfCondition NotEqual(CAD_Store.Read(e0, 2), 0) ThenBlock: {
            nseg = CAD_Tess.CircleSegCount(CAD_Store.Read(CAD_Store.Read(e0, 2), 10), 0)
        }
        IfCondition LessThan(nseg, 90) ThenBlock: { nseg = 90 }
        IfCondition GreaterThan(nseg, 256) ThenBlock: { nseg = 256 }
        axyz = Allocate(8192)
        bxyz = Allocate(8192)
        ck0 = 0
        ck1 = 0
        IfCondition NotEqual(CAD_Store.Read(e0, 2), 0) ThenBlock: {
            ck0 = CAD_Store.Read(CAD_Store.Read(e0, 2), 0)
        }
        IfCondition NotEqual(CAD_Store.Read(e1, 2), 0) ThenBlock: {
            ck1 = CAD_Store.Read(CAD_Store.Read(e1, 2), 0)
        }
        na = 0
        nb = 0
        IfCondition EqualTo(ck0, 3) ThenBlock: {
            na = CAD_Tess.SampleEllipseByEnds(e0, nseg, axyz)
        }
        IfCondition EqualTo(na, 0) ThenBlock: {
            na = CAD_Tess.SampleCircleEdge(e0, nseg, axyz)
        }
        IfCondition EqualTo(ck1, 3) ThenBlock: {
            nb = CAD_Tess.SampleEllipseByEnds(e1, nseg, bxyz)
        }
        IfCondition EqualTo(nb, 0) ThenBlock: {
            nb = CAD_Tess.SampleCircleEdge(e1, nseg, bxyz)
        }
        IfCondition LessThan(na, 3) ThenBlock: {
            Deallocate(axyz, 8192)
            Deallocate(bxyz, 8192)
            ReturnValue(CAD_Tess.FanNGon(loop_h, CAD_Topo.LoopCountCoedges(loop_h), v_base, i_base, pack_addr))
        }
        IfCondition LessThan(nb, 3) ThenBlock: {
            Deallocate(axyz, 8192)
            Deallocate(bxyz, 8192)
            ReturnValue(CAD_Tess.FanNGon(loop_h, CAD_Topo.LoopCountCoedges(loop_h), v_base, i_base, pack_addr))
        }
        IfCondition GreaterThan(nb, na) ThenBlock: { nb = na }
        IfCondition GreaterThan(na, nb) ThenBlock: { na = nb }
        vc = ArrayGet(pack_addr, 0)
        tc = ArrayGet(pack_addr, 1)
        // dump rail A then rail B
        i = 0
        WhileLoop LessThan(i, na) {
            vo = Multiply(Add(vc, i), 3)
            ArraySet(v_base, vo, ArrayGet(axyz, Multiply(i, 3)))
            ArraySet(v_base, Add(vo, 1), ArrayGet(axyz, Add(Multiply(i, 3), 1)))
            ArraySet(v_base, Add(vo, 2), ArrayGet(axyz, Add(Multiply(i, 3), 2)))
            vo2 = Multiply(Add(Add(vc, na), i), 3)
            ArraySet(v_base, vo2, ArrayGet(bxyz, Multiply(i, 3)))
            ArraySet(v_base, Add(vo2, 1), ArrayGet(bxyz, Add(Multiply(i, 3), 1)))
            ArraySet(v_base, Add(vo2, 2), ArrayGet(bxyz, Add(Multiply(i, 3), 2)))
            i = Add(i, 1)
        }
        // Match Pww↔Pww / Pcap↔Pcap by Z, not 3D distance. On a long
        // rectangle side, dist(Pww_j, Pcap_i) < edge length, so nearest-
        // endpoint reversed the strip and left 16 open rails (4-rim fillet).
        lb = Multiply(Subtract(na, 1), 3)
        az0 = ArrayGet(axyz, 2)
        bz0 = ArrayGet(bxyz, 2)
        bz1 = ArrayGet(bxyz, Add(lb, 2))
        dz0 = Float_Sub(az0, bz0)
        IfCondition EqualTo(CAD_Num.IsNeg(dz0), 1) ThenBlock: { dz0 = Float_Sub(0, dz0) }
        dz1 = Float_Sub(az0, bz1)
        IfCondition EqualTo(CAD_Num.IsNeg(dz1), 1) ThenBlock: { dz1 = Float_Sub(0, dz1) }
        // if A[0].z closer to B[last].z than B[0].z, reverse B
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(dz1, dz0)), 1) ThenBlock: {
            lo = 0
            hi = Subtract(na, 1)
            WhileLoop LessThan(lo, hi) {
                ia = Multiply(Add(Add(vc, na), lo), 3)
                ib = Multiply(Add(Add(vc, na), hi), 3)
                tx = ArrayGet(v_base, ia)
                ty = ArrayGet(v_base, Add(ia, 1))
                tz = ArrayGet(v_base, Add(ia, 2))
                ArraySet(v_base, ia, ArrayGet(v_base, ib))
                ArraySet(v_base, Add(ia, 1), ArrayGet(v_base, Add(ib, 1)))
                ArraySet(v_base, Add(ia, 2), ArrayGet(v_base, Add(ib, 2)))
                ArraySet(v_base, ib, tx)
                ArraySet(v_base, Add(ib, 1), ty)
                ArraySet(v_base, Add(ib, 2), tz)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        ba = vc
        bb = Add(vc, na)
        i = 0
        WhileLoop LessThan(i, Subtract(na, 1)) {
            i0 = Add(ba, i)
            i1 = Add(ba, Add(i, 1))
            j0 = Add(bb, i)
            j1 = Add(bb, Add(i, 1))
            t0 = Multiply(tc, 3)
            ArraySet(i_base, t0, i0)
            ArraySet(i_base, Add(t0, 1), i1)
            ArraySet(i_base, Add(t0, 2), j1)
            tc = Add(tc, 1)
            t1 = Multiply(tc, 3)
            ArraySet(i_base, t1, i0)
            ArraySet(i_base, Add(t1, 1), j1)
            ArraySet(i_base, Add(t1, 2), j0)
            tc = Add(tc, 1)
            i = Add(i, 1)
        }
        ArraySet(pack_addr, 0, Add(vc, Multiply(na, 2)))
        ArraySet(pack_addr, 1, tc)
        Deallocate(axyz, 8192)
        Deallocate(bxyz, 8192)
        ReturnValue(tc)
    }
}

// Even-odd point-in-polygon. idx[] indexes xyz triples in v_base.
Function.CAD_Tess.PointInIdxPoly {
    Input: wx: Integer
    Input: wy: Integer
    Input: v_base: Address
    Input: idx_addr: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        inside = 0
        i = 0
        j = Subtract(n, 1)
        WhileLoop LessThan(i, n) {
            ia = ArrayGet(idx_addr, i)
            ib = ArrayGet(idx_addr, j)
            xi = ArrayGet(v_base, Multiply(ia, 3))
            yi = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
            xj = ArrayGet(v_base, Multiply(ib, 3))
            yj = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
            a = 0
            b = 0
            // yi > wy  /  yj > wy — IsNeg, not Float_Le (broken for negatives)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wy, yi)), 1) ThenBlock: { a = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wy, yj)), 1) ThenBlock: { b = 1 }
            IfCondition NotEqual(a, b) ThenBlock: {
                den = Float_Sub(yj, yi)
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    xint = Float_Add(xi, Float_Mul(Float_Sub(xj, xi), Float_Div(Float_Sub(wy, yi), den)))
                    // wx < xint
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wx, xint)), 1) ThenBlock: {
                        inside = Subtract(1, inside)
                    }
                }
            }
            j = i
            i = Add(i, 1)
        }
        ReturnValue(inside)
    }
}

// 1 if (wx,wy) is inside or on triangle i0-i1-i2 (no opposing Orient2D signs).
Function.CAD_Tess.PointInTriXY {
    Input: wx: Integer
    Input: wy: Integer
    Input: v_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        i0 = ArrayGet(pack_addr, 0)
        i1 = ArrayGet(pack_addr, 1)
        i2 = ArrayGet(pack_addr, 2)
        ax = ArrayGet(v_base, Multiply(i0, 3))
        ay = ArrayGet(v_base, Add(Multiply(i0, 3), 1))
        bx = ArrayGet(v_base, Multiply(i1, 3))
        by = ArrayGet(v_base, Add(Multiply(i1, 3), 1))
        cx = ArrayGet(v_base, Multiply(i2, 3))
        cy = ArrayGet(v_base, Add(Multiply(i2, 3), 1))
        // sign of (B-A)×(P-A), (C-B)×(P-B), (A-C)×(P-C)
        d1 = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(wy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(wx, ax)))
        d2 = Float_Sub(Float_Mul(Float_Sub(cx, bx), Float_Sub(wy, by)), Float_Mul(Float_Sub(cy, by), Float_Sub(wx, bx)))
        d3 = Float_Sub(Float_Mul(Float_Sub(ax, cx), Float_Sub(wy, cy)), Float_Mul(Float_Sub(ay, cy), Float_Sub(wx, cx)))
        has_pos = 0
        has_neg = 0
        IfCondition EqualTo(CAD_Num.IsZero(d1, 0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { has_neg = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 0) ThenBlock: { has_pos = 1 }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d2, 0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { has_neg = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 0) ThenBlock: { has_pos = 1 }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d3, 0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(d3), 1) ThenBlock: { has_neg = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(d3), 0) ThenBlock: { has_pos = 1 }
        }
        IfCondition EqualTo(has_pos, 1) ThenBlock: {
            IfCondition EqualTo(has_neg, 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(has_pos, 0) ThenBlock: {
            IfCondition EqualTo(has_neg, 0) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

// Proper segment intersection (shared endpoints do not count).
Function.CAD_Tess.SegsCrossXY {
    Input: v_base: Address
    Input: ia: Integer
    Input: ib: Integer
    Input: ic: Integer
    Input: id: Integer
    Output: Integer
    Body: {
        ax = ArrayGet(v_base, Multiply(ia, 3))
        ay = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
        bx = ArrayGet(v_base, Multiply(ib, 3))
        by = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
        cx = ArrayGet(v_base, Multiply(ic, 3))
        cy = ArrayGet(v_base, Add(Multiply(ic, 3), 1))
        dx = ArrayGet(v_base, Multiply(id, 3))
        dy = ArrayGet(v_base, Add(Multiply(id, 3), 1))
        // Orient(A,B,C), (A,B,D), (C,D,A), (C,D,B)
        d1 = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(cy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(cx, ax)))
        d2 = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(dy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(dx, ax)))
        d3 = Float_Sub(Float_Mul(Float_Sub(dx, cx), Float_Sub(ay, cy)), Float_Mul(Float_Sub(dy, cy), Float_Sub(ax, cx)))
        d4 = Float_Sub(Float_Mul(Float_Sub(dx, cx), Float_Sub(by, cy)), Float_Mul(Float_Sub(dy, cy), Float_Sub(bx, cx)))
        o1 = 0
        o2 = 0
        o3 = 0
        o4 = 0
        IfCondition EqualTo(CAD_Num.IsZero(d1, 0), 0) ThenBlock: {
            o1 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { o1 = Subtract(0, 1) }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d2, 0), 0) ThenBlock: {
            o2 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { o2 = Subtract(0, 1) }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d3, 0), 0) ThenBlock: {
            o3 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d3), 1) ThenBlock: { o3 = Subtract(0, 1) }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d4, 0), 0) ThenBlock: {
            o4 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d4), 1) ThenBlock: { o4 = Subtract(0, 1) }
        }
        r = 0
        IfCondition NotEqual(o1, o2) ThenBlock: {
            IfCondition NotEqual(o1, 0) ThenBlock: {
                IfCondition NotEqual(o2, 0) ThenBlock: {
                    IfCondition NotEqual(o3, o4) ThenBlock: {
                        IfCondition NotEqual(o3, 0) ThenBlock: {
                            IfCondition NotEqual(o4, 0) ThenBlock: { r = 1 }
                        }
                    }
                }
            }
        }
        ReturnValue(r)
    }
}

// 1 if segment outer[oi]→hole[hj] is a proper visible diagonal:
// no proper crossing of outer or hole edges, midpoint in the annulus.
// pack: [oi, hj, nout, nh]
Function.CAD_Tess.BridgeVisible {
    Input: v_base: Address
    Input: oidx: Address
    Input: hidx: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        oi = ArrayGet(pack_addr, 0)
        hj = ArrayGet(pack_addr, 1)
        nout = ArrayGet(pack_addr, 2)
        nh = ArrayGet(pack_addr, 3)
        ia = ArrayGet(oidx, oi)
        ib = ArrayGet(hidx, hj)
        e = 0
        WhileLoop LessThan(e, nout) {
            e1 = Add(e, 1)
            IfCondition EqualTo(e1, nout) ThenBlock: { e1 = 0 }
            skip = 0
            IfCondition EqualTo(e, oi) ThenBlock: { skip = 1 }
            IfCondition EqualTo(e1, oi) ThenBlock: { skip = 1 }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, ia, ib, ArrayGet(oidx, e), ArrayGet(oidx, e1)), 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
            e = Add(e, 1)
        }
        e = 0
        WhileLoop LessThan(e, nh) {
            e1 = Add(e, 1)
            IfCondition EqualTo(e1, nh) ThenBlock: { e1 = 0 }
            skip = 0
            IfCondition EqualTo(e, hj) ThenBlock: { skip = 1 }
            IfCondition EqualTo(e1, hj) ThenBlock: { skip = 1 }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, ia, ib, ArrayGet(hidx, e), ArrayGet(hidx, e1)), 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
            e = Add(e, 1)
        }
        half = 0x3FE0000000000000
        mx = Float_Mul(Float_Add(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3))), half)
        my = Float_Mul(Float_Add(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), half)
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, oidx, nout), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, hidx, nh), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Insert a hole into an outer ring along a non-crossing spoke.
// Geometry: hole centroid C, farthest outer vertex O, hole vertex H
// most aligned with (O−C). For nested circles that spoke is radial.
// Then Held visible, then shortest annulus midpoint. Address-pinned
// (Allocate locals die across BridgeVisible — rect-in-rect hit first
// pair; a 32-gon circle did not and crashed). pack: [nout, nh]
Function.CAD_Tess.MergeHoleRing {
    Input: v_base: Address
    Input: oidx: Address
    Input: hidx: Address
    Input: out_idx: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        nout = ArrayGet(pack_addr, 0)
        nh = ArrayGet(pack_addr, 1)
        IfCondition LessThan(nout, 3) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nh, 3) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Tess.FaceBufs(), 0) ThenBlock: { ReturnValue(0) }
        v_base = CAD_Tess_State.v_base
        oidx = CAD_Tess_State.oidx
        hidx = CAD_Tess_State.hidx
        hc = CAD_Tess_State.merge_hc
        out_idx = CAD_Tess_State.bridged
        j = 0
        WhileLoop LessThan(j, nh) {
            ArraySet(hc, j, ArrayGet(hidx, j))
            j = Add(j, 1)
        }
        harea = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            jn = Add(j, 1)
            IfCondition EqualTo(jn, nh) ThenBlock: { jn = 0 }
            ia = ArrayGet(hc, j)
            ib = ArrayGet(hc, jn)
            harea = Float_Add(harea, Float_Sub(Float_Mul(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), Float_Mul(ArrayGet(v_base, Multiply(ib, 3)), ArrayGet(v_base, Add(Multiply(ia, 3), 1)))))
            j = Add(j, 1)
        }
        // hole opposite outer: CW (negative area)
        IfCondition EqualTo(CAD_Num.IsNeg(harea), 0) ThenBlock: {
            hc = CAD_Tess_State.merge_hc
            lo = 0
            hi = Subtract(nh, 1)
            WhileLoop LessThan(lo, hi) {
                tmpi = ArrayGet(hc, lo)
                ArraySet(hc, lo, ArrayGet(hc, hi))
                ArraySet(hc, hi, tmpi)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        v_base = CAD_Tess_State.v_base
        oidx = CAD_Tess_State.oidx
        hc = CAD_Tess_State.merge_hc
        // hole centroid — radial spoke is the known nested-circle diagonal
        hcx = 0
        hcy = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            ia = ArrayGet(hc, j)
            hcx = Float_Add(hcx, ArrayGet(v_base, Multiply(ia, 3)))
            hcy = Float_Add(hcy, ArrayGet(v_base, Add(Multiply(ia, 3), 1)))
            j = Add(j, 1)
        }
        nf = Float_FromInt(nh)
        hcx = Float_Div(hcx, nf)
        hcy = Float_Div(hcy, nf)
        v_base = CAD_Tess_State.v_base
        oidx = CAD_Tess_State.oidx
        hc = CAD_Tess_State.merge_hc
        bi = 0
        best_d2 = 0
        i = 0
        WhileLoop LessThan(i, nout) {
            ia = ArrayGet(oidx, i)
            dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), hcx)
            dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), hcy)
            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
            IfCondition EqualTo(Float_Le(d2, best_d2), 0) ThenBlock: {
                best_d2 = d2
                bi = i
            }
            i = Add(i, 1)
        }
        ia = ArrayGet(oidx, bi)
        ox = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), hcx)
        oy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), hcy)
        bj = 0
        best_dot = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            ib = ArrayGet(hc, j)
            hx = Float_Sub(ArrayGet(v_base, Multiply(ib, 3)), hcx)
            hy = Float_Sub(ArrayGet(v_base, Add(Multiply(ib, 3), 1)), hcy)
            dt = Float_Add(Float_Mul(hx, ox), Float_Mul(hy, oy))
            IfCondition EqualTo(j, 0) ThenBlock: {
                best_dot = dt
                bj = 0
            }
            IfCondition GreaterThan(j, 0) ThenBlock: {
                IfCondition EqualTo(Float_Le(dt, best_dot), 0) ThenBlock: {
                    best_dot = dt
                    bj = j
                }
            }
            j = Add(j, 1)
        }
        bp = CAD_Tess_State.ep
        ArraySet(bp, 0, bi)
        ArraySet(bp, 1, bj)
        ArraySet(bp, 2, nout)
        ArraySet(bp, 3, nh)
        found = 0
        IfCondition EqualTo(CAD_Tess.BridgeVisible(CAD_Tess_State.v_base, CAD_Tess_State.oidx, CAD_Tess_State.merge_hc, CAD_Tess_State.ep), 1) ThenBlock: {
            found = 1
        }
        // Held: first remaining visible diagonal
        i = 0
        WhileLoop LessThan(i, nout) {
            IfCondition EqualTo(found, 0) ThenBlock: {
                j = 0
                WhileLoop LessThan(j, nh) {
                    IfCondition EqualTo(found, 0) ThenBlock: {
                        bp = CAD_Tess_State.ep
                        ArraySet(bp, 0, i)
                        ArraySet(bp, 1, j)
                        ArraySet(bp, 2, nout)
                        ArraySet(bp, 3, nh)
                        IfCondition EqualTo(CAD_Tess.BridgeVisible(CAD_Tess_State.v_base, CAD_Tess_State.oidx, CAD_Tess_State.merge_hc, CAD_Tess_State.ep), 1) ThenBlock: {
                            bi = i
                            bj = j
                            found = 1
                        }
                    }
                    j = Add(j, 1)
                }
            }
            i = Add(i, 1)
        }
        // shortest pair whose midpoint sits in the annulus (inside outer, outside hole)
        IfCondition EqualTo(found, 0) ThenBlock: {
            best_d2 = 0x7FF0000000000000
            i = 0
            WhileLoop LessThan(i, nout) {
                j = 0
                WhileLoop LessThan(j, nh) {
                    v_base = CAD_Tess_State.v_base
                    oidx = CAD_Tess_State.oidx
                    hc = CAD_Tess_State.merge_hc
                    ia = ArrayGet(oidx, i)
                    ib = ArrayGet(hc, j)
                    dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                    dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                    d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    half = 0x3FE0000000000000
                    mx = Float_Mul(Float_Add(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3))), half)
                    my = Float_Mul(Float_Add(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), half)
                    pin_o = CAD_Tess.PointInIdxPoly(mx, my, CAD_Tess_State.v_base, CAD_Tess_State.oidx, nout)
                    pin_h = CAD_Tess.PointInIdxPoly(mx, my, CAD_Tess_State.v_base, CAD_Tess_State.merge_hc, nh)
                    IfCondition EqualTo(pin_o, 1) ThenBlock: {
                        IfCondition EqualTo(pin_h, 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                                best_d2 = d2
                                bi = i
                                bj = j
                                found = 1
                            }
                        }
                    }
                    j = Add(j, 1)
                }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(found, 0) ThenBlock: { ReturnValue(0) }
        // [0..bi] + hole cycle from bj + hole[bj] + outer[bi] + [bi+1..]
        oidx = CAD_Tess_State.oidx
        hc = CAD_Tess_State.merge_hc
        out_idx = CAD_Tess_State.bridged
        ti = 0
        k = 0
        WhileLoop LessEqual(k, bi) {
            ArraySet(out_idx, ti, ArrayGet(oidx, k))
            ti = Add(ti, 1)
            k = Add(k, 1)
        }
        k = 0
        WhileLoop LessThan(k, nh) {
            kk = Add(bj, k)
            IfCondition GreaterEqual(kk, nh) ThenBlock: { kk = Subtract(kk, nh) }
            ArraySet(out_idx, ti, ArrayGet(hc, kk))
            ti = Add(ti, 1)
            k = Add(k, 1)
        }
        ArraySet(out_idx, ti, ArrayGet(hc, bj))
        ti = Add(ti, 1)
        ArraySet(out_idx, ti, ArrayGet(oidx, bi))
        ti = Add(ti, 1)
        k = Add(bi, 1)
        WhileLoop LessThan(k, nout) {
            ArraySet(out_idx, ti, ArrayGet(oidx, k))
            ti = Add(ti, 1)
            k = Add(k, 1)
        }
        ReturnValue(ti)
    }
}

// 1 if triangle i0-i1-i2 overlaps indexed loop (hole).
// pack: [i0, i1, i2, n]
Function.CAD_Tess.TriOverlapsIdxPoly {
    Input: v_base: Address
    Input: idx_addr: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        i0 = ArrayGet(pack_addr, 0)
        i1 = ArrayGet(pack_addr, 1)
        i2 = ArrayGet(pack_addr, 2)
        n = ArrayGet(pack_addr, 3)
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        three = 0x4008000000000000
        x0 = ArrayGet(v_base, Multiply(i0, 3))
        y0 = ArrayGet(v_base, Add(Multiply(i0, 3), 1))
        x1 = ArrayGet(v_base, Multiply(i1, 3))
        y1 = ArrayGet(v_base, Add(Multiply(i1, 3), 1))
        x2 = ArrayGet(v_base, Multiply(i2, 3))
        y2 = ArrayGet(v_base, Add(Multiply(i2, 3), 1))
        mx = Float_Div(Float_Add(Float_Add(x0, x1), x2), three)
        my = Float_Div(Float_Add(Float_Add(y0, y1), y2), three)
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(x0, y0, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(x1, y1, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(x2, y2, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        tp = Allocate(16)
        ArraySet(tp, 0, i0)
        ArraySet(tp, 1, i1)
        ArraySet(tp, 2, i2)
        k = 0
        hit = 0
        WhileLoop LessThan(k, n) {
            IfCondition EqualTo(hit, 0) ThenBlock: {
                hk = ArrayGet(idx_addr, k)
                hx = ArrayGet(v_base, Multiply(hk, 3))
                hy = ArrayGet(v_base, Add(Multiply(hk, 3), 1))
                IfCondition EqualTo(CAD_Tess.PointInTriXY(hx, hy, v_base, tp), 1) ThenBlock: { hit = 1 }
            }
            k = Add(k, 1)
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            Deallocate(tp, 16)
            ReturnValue(1)
        }
        k = 0
        WhileLoop LessThan(k, n) {
            IfCondition EqualTo(hit, 0) ThenBlock: {
                kn = Add(k, 1)
                IfCondition EqualTo(kn, n) ThenBlock: { kn = 0 }
                ha = ArrayGet(idx_addr, k)
                hb = ArrayGet(idx_addr, kn)
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, i0, i1, ha, hb), 1) ThenBlock: { hit = 1 }
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, i1, i2, ha, hb), 1) ThenBlock: { hit = 1 }
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, i2, i0, ha, hb), 1) ThenBlock: { hit = 1 }
            }
            k = Add(k, 1)
        }
        Deallocate(tp, 16)
        ReturnValue(hit)
    }
}

// Zipper a CCW triangle to a hole loop. Writes tris into i_base.
// tpack: [i0, i1, i2]   opack: [nh, flip, tri_count]
// Returns updated tri_count. Interior spokes — not a degenerate keyhole slit.
Function.CAD_Tess.ZipperTriHole {
    Input: v_base: Address
    Input: i_base: Address
    Input: tpack: Address
    Input: hidx: Address
    Input: opack: Address
    Output: Integer
    Body: {
        nh = ArrayGet(opack, 0)
        flip = ArrayGet(opack, 1)
        tri = ArrayGet(opack, 2)
        IfCondition LessThan(nh, 3) ThenBlock: { ReturnValue(tri) }
        oa = Allocate(32)
        ArraySet(oa, 0, ArrayGet(tpack, 0))
        ArraySet(oa, 1, ArrayGet(tpack, 1))
        ArraySet(oa, 2, ArrayGet(tpack, 2))
        area = 0
        j = 0
        WhileLoop LessThan(j, 3) {
            jn = Add(j, 1)
            IfCondition EqualTo(jn, 3) ThenBlock: { jn = 0 }
            ia = ArrayGet(oa, j)
            ib = ArrayGet(oa, jn)
            xa = ArrayGet(v_base, Multiply(ia, 3))
            ya = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
            xb = ArrayGet(v_base, Multiply(ib, 3))
            yb = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
            area = Float_Add(area, Float_Sub(Float_Mul(xa, yb), Float_Mul(xb, ya)))
            j = Add(j, 1)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(area), 1) ThenBlock: {
            tmpi = ArrayGet(oa, 1)
            ArraySet(oa, 1, ArrayGet(oa, 2))
            ArraySet(oa, 2, tmpi)
        }
        hc = Allocate(16384)
        j = 0
        WhileLoop LessThan(j, nh) {
            ArraySet(hc, j, ArrayGet(hidx, j))
            j = Add(j, 1)
        }
        harea = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            jn = Add(j, 1)
            IfCondition EqualTo(jn, nh) ThenBlock: { jn = 0 }
            ia = ArrayGet(hc, j)
            ib = ArrayGet(hc, jn)
            xa = ArrayGet(v_base, Multiply(ia, 3))
            ya = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
            xb = ArrayGet(v_base, Multiply(ib, 3))
            yb = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
            harea = Float_Add(harea, Float_Sub(Float_Mul(xa, yb), Float_Mul(xb, ya)))
            j = Add(j, 1)
        }
        // hole must be CW (negative) so zipper stays in the annulus
        IfCondition EqualTo(CAD_Num.IsNeg(harea), 0) ThenBlock: {
            lo = 0
            hi = Subtract(nh, 1)
            WhileLoop LessThan(lo, hi) {
                tmpi = ArrayGet(hc, lo)
                ArraySet(hc, lo, ArrayGet(hc, hi))
                ArraySet(hc, hi, tmpi)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        bi = 0
        bj = 0
        best = 0x7FF0000000000000
        i = 0
        WhileLoop LessThan(i, 3) {
            j = 0
            WhileLoop LessThan(j, nh) {
                ia = ArrayGet(oa, i)
                ib = ArrayGet(hc, j)
                dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bi = i
                    bj = j
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        pa = Allocate(32)
        pb = Allocate(32)
        pc = Allocate(32)
        i = bi
        j = bj
        ao = 0
        ah = 0
        guard = 0
        maxg = Add(Add(3, nh), 4)
        WhileLoop LessThan(guard, maxg) {
            done = 0
            IfCondition EqualTo(ao, 3) ThenBlock: {
                IfCondition EqualTo(ah, nh) ThenBlock: { done = 1 }
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
                i1 = Add(i, 1)
                IfCondition EqualTo(i1, 3) ThenBlock: { i1 = 0 }
                j1 = Add(j, 1)
                IfCondition EqualTo(j1, nh) ThenBlock: { j1 = 0 }
                take_o = 0
                IfCondition EqualTo(ah, nh) ThenBlock: { take_o = 1 }
                IfCondition EqualTo(ao, 3) ThenBlock: { take_o = 0 }
                IfCondition LessThan(ao, 3) ThenBlock: {
                    IfCondition LessThan(ah, nh) ThenBlock: {
                        ia = ArrayGet(oa, i1)
                        ib = ArrayGet(hc, j)
                        dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                        dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                        d_o = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        ia = ArrayGet(oa, i)
                        ib = ArrayGet(hc, j1)
                        dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                        dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                        d_h = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        take_o = 0
                        IfCondition EqualTo(Float_Le(d_o, d_h), 1) ThenBlock: { take_o = 1 }
                    }
                }
                a = 0
                b = 0
                c = 0
                IfCondition EqualTo(take_o, 1) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(oa, i1)
                    c = ArrayGet(hc, j)
                    i = i1
                    ao = Add(ao, 1)
                }
                IfCondition EqualTo(take_o, 0) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(hc, j)
                    c = ArrayGet(hc, j1)
                    j = j1
                    ah = Add(ah, 1)
                }
                IfCondition NotEqual(a, b) ThenBlock: {
                    IfCondition NotEqual(b, c) ThenBlock: {
                        IfCondition NotEqual(a, c) ThenBlock: {
                            ArraySet(pa, 0, ArrayGet(v_base, Multiply(a, 3)))
                            ArraySet(pa, 1, ArrayGet(v_base, Add(Multiply(a, 3), 1)))
                            ArraySet(pb, 0, ArrayGet(v_base, Multiply(b, 3)))
                            ArraySet(pb, 1, ArrayGet(v_base, Add(Multiply(b, 3), 1)))
                            ArraySet(pc, 0, ArrayGet(v_base, Multiply(c, 3)))
                            ArraySet(pc, 1, ArrayGet(v_base, Add(Multiply(c, 3), 1)))
                            o = CAD_Num.Orient2D(pa, pb, pc)
                            IfCondition EqualTo(o, Subtract(0, 1)) ThenBlock: {
                                tmpi = b
                                b = c
                                c = tmpi
                                o = 1
                            }
                            IfCondition EqualTo(o, 1) ThenBlock: {
                                tt = Multiply(tri, 3)
                                IfCondition EqualTo(flip, 0) ThenBlock: {
                                    ArraySet(i_base, tt, a)
                                    ArraySet(i_base, Add(tt, 1), b)
                                    ArraySet(i_base, Add(tt, 2), c)
                                }
                                IfCondition EqualTo(flip, 1) ThenBlock: {
                                    ArraySet(i_base, tt, a)
                                    ArraySet(i_base, Add(tt, 1), c)
                                    ArraySet(i_base, Add(tt, 2), b)
                                }
                                tri = Add(tri, 1)
                            }
                        }
                    }
                }
            }
            guard = Add(guard, 1)
        }
        ArraySet(opack, 2, tri)
        Deallocate(pa, 32)
        Deallocate(pb, 32)
        Deallocate(pc, 32)
        Deallocate(oa, 32)
        Deallocate(hc, 16384)
        ReturnValue(tri)
    }
}

// Zipper an outer ring (CCW) to a hole ring. Real spokes — not a
// degenerate keyhole. Each emit must sit in the annulus (centroid
// inside outer, outside hole) so a concave notch stays empty.
// pack: [nout, nh, flip, tri_count]  writes into i_base from tri_count.
Function.CAD_Tess.ZipperLoopsXY {
    Input: v_base: Address
    Input: i_base: Address
    Input: oidx: Address
    Input: hidx: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        nout = ArrayGet(pack_addr, 0)
        nh = ArrayGet(pack_addr, 1)
        flip = ArrayGet(pack_addr, 2)
        tri = ArrayGet(pack_addr, 3)
        IfCondition LessThan(nout, 3) ThenBlock: { ReturnValue(tri) }
        IfCondition LessThan(nh, 3) ThenBlock: { ReturnValue(tri) }
        oa = Allocate(16384)
        hc = Allocate(16384)
        j = 0
        WhileLoop LessThan(j, nout) {
            ArraySet(oa, j, ArrayGet(oidx, j))
            j = Add(j, 1)
        }
        j = 0
        WhileLoop LessThan(j, nh) {
            ArraySet(hc, j, ArrayGet(hidx, j))
            j = Add(j, 1)
        }
        // outer → CCW
        area = 0
        j = 0
        WhileLoop LessThan(j, nout) {
            jn = Add(j, 1)
            IfCondition EqualTo(jn, nout) ThenBlock: { jn = 0 }
            ia = ArrayGet(oa, j)
            ib = ArrayGet(oa, jn)
            area = Float_Add(area, Float_Sub(Float_Mul(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), Float_Mul(ArrayGet(v_base, Multiply(ib, 3)), ArrayGet(v_base, Add(Multiply(ia, 3), 1)))))
            j = Add(j, 1)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(area), 1) ThenBlock: {
            lo = 0
            hi = Subtract(nout, 1)
            WhileLoop LessThan(lo, hi) {
                tmpi = ArrayGet(oa, lo)
                ArraySet(oa, lo, ArrayGet(oa, hi))
                ArraySet(oa, hi, tmpi)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        // hole → CW
        harea = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            jn = Add(j, 1)
            IfCondition EqualTo(jn, nh) ThenBlock: { jn = 0 }
            ia = ArrayGet(hc, j)
            ib = ArrayGet(hc, jn)
            harea = Float_Add(harea, Float_Sub(Float_Mul(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), Float_Mul(ArrayGet(v_base, Multiply(ib, 3)), ArrayGet(v_base, Add(Multiply(ia, 3), 1)))))
            j = Add(j, 1)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(harea), 0) ThenBlock: {
            lo = 0
            hi = Subtract(nh, 1)
            WhileLoop LessThan(lo, hi) {
                tmpi = ArrayGet(hc, lo)
                ArraySet(hc, lo, ArrayGet(hc, hi))
                ArraySet(hc, hi, tmpi)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        bi = 0
        bj = 0
        best = 0x7FF0000000000000
        i = 0
        WhileLoop LessThan(i, nout) {
            j = 0
            WhileLoop LessThan(j, nh) {
                ia = ArrayGet(oa, i)
                ib = ArrayGet(hc, j)
                dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bi = i
                    bj = j
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        three = 0x4008000000000000
        // hole centroid — a candidate that contains it spans the opening
        hcx = 0
        hcy = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            ia = ArrayGet(hc, j)
            hcx = Float_Add(hcx, ArrayGet(v_base, Multiply(ia, 3)))
            hcy = Float_Add(hcy, ArrayGet(v_base, Add(Multiply(ia, 3), 1)))
            j = Add(j, 1)
        }
        hcx = Float_Div(hcx, Float_FromInt(nh))
        hcy = Float_Div(hcy, Float_FromInt(nh))
        pa = Allocate(32)
        pb = Allocate(32)
        pc = Allocate(32)
        tpack = Allocate(16)
        i = bi
        j = bj
        ao = 0
        ah = 0
        guard = 0
        maxg = Add(Multiply(Add(nout, nh), 2), 8)
        IfCondition GreaterThan(maxg, 4096) ThenBlock: { maxg = 4096 }
        WhileLoop LessThan(guard, maxg) {
            done = 0
            IfCondition EqualTo(ao, nout) ThenBlock: {
                IfCondition EqualTo(ah, nh) ThenBlock: { done = 1 }
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
                i1 = Add(i, 1)
                IfCondition EqualTo(i1, nout) ThenBlock: { i1 = 0 }
                j1 = Add(j, 1)
                IfCondition EqualTo(j1, nh) ThenBlock: { j1 = 0 }
                // score both candidates: 2=valid annulus, 1=not-in-hole, 0=bad
                vo = 0
                vh = 0
                IfCondition LessThan(ao, nout) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(oa, i1)
                    c = ArrayGet(hc, j)
                    ArraySet(tpack, 0, a)
                    ArraySet(tpack, 1, b)
                    ArraySet(tpack, 2, c)
                    IfCondition EqualTo(CAD_Tess.PointInTriXY(hcx, hcy, v_base, tpack), 0) ThenBlock: {
                    mx = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Multiply(a, 3)), ArrayGet(v_base, Multiply(b, 3))), ArrayGet(v_base, Multiply(c, 3))), three)
                    my = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Add(Multiply(a, 3), 1)), ArrayGet(v_base, Add(Multiply(b, 3), 1))), ArrayGet(v_base, Add(Multiply(c, 3), 1))), three)
                    IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, hc, nh), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, oa, nout), 1) ThenBlock: { vo = 2 }
                        IfCondition EqualTo(vo, 0) ThenBlock: { vo = 1 }
                    }
                    }
                }
                wo = 0
                wh = 0
                IfCondition LessThan(ah, nh) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(hc, j)
                    c = ArrayGet(hc, j1)
                    ArraySet(tpack, 0, a)
                    ArraySet(tpack, 1, b)
                    ArraySet(tpack, 2, c)
                    IfCondition EqualTo(CAD_Tess.PointInTriXY(hcx, hcy, v_base, tpack), 0) ThenBlock: {
                    mx = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Multiply(a, 3)), ArrayGet(v_base, Multiply(b, 3))), ArrayGet(v_base, Multiply(c, 3))), three)
                    my = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Add(Multiply(a, 3), 1)), ArrayGet(v_base, Add(Multiply(b, 3), 1))), ArrayGet(v_base, Add(Multiply(c, 3), 1))), three)
                    IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, hc, nh), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, oa, nout), 1) ThenBlock: { wo = 2 }
                        IfCondition EqualTo(wo, 0) ThenBlock: { wo = 1 }
                    }
                    }
                }
                take_o = 0
                IfCondition EqualTo(ah, nh) ThenBlock: { take_o = 1 }
                IfCondition EqualTo(ao, nout) ThenBlock: { take_o = 0 }
                IfCondition LessThan(ao, nout) ThenBlock: {
                    IfCondition LessThan(ah, nh) ThenBlock: {
                        take_o = 0
                        IfCondition GreaterThan(vo, wo) ThenBlock: { take_o = 1 }
                        IfCondition EqualTo(vo, wo) ThenBlock: {
                            ia = ArrayGet(oa, i1)
                            ib = ArrayGet(hc, j)
                            dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                            dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                            d_o = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            ia = ArrayGet(oa, i)
                            ib = ArrayGet(hc, j1)
                            dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                            dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                            d_h = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d_o, d_h), 1) ThenBlock: { take_o = 1 }
                        }
                    }
                }
                a = 0
                b = 0
                c = 0
                IfCondition EqualTo(take_o, 1) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(oa, i1)
                    c = ArrayGet(hc, j)
                    i = i1
                    ao = Add(ao, 1)
                }
                IfCondition EqualTo(take_o, 0) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(hc, j)
                    c = ArrayGet(hc, j1)
                    j = j1
                    ah = Add(ah, 1)
                }
                keep = 0
                IfCondition EqualTo(take_o, 1) ThenBlock: {
                    IfCondition GreaterThan(vo, 1) ThenBlock: { keep = 1 }
                }
                IfCondition EqualTo(take_o, 0) ThenBlock: {
                    IfCondition GreaterThan(wo, 1) ThenBlock: { keep = 1 }
                }
                IfCondition EqualTo(keep, 1) ThenBlock: {
                    IfCondition NotEqual(a, b) ThenBlock: {
                        IfCondition NotEqual(b, c) ThenBlock: {
                            IfCondition NotEqual(a, c) ThenBlock: {
                                ArraySet(pa, 0, ArrayGet(v_base, Multiply(a, 3)))
                                ArraySet(pa, 1, ArrayGet(v_base, Add(Multiply(a, 3), 1)))
                                ArraySet(pb, 0, ArrayGet(v_base, Multiply(b, 3)))
                                ArraySet(pb, 1, ArrayGet(v_base, Add(Multiply(b, 3), 1)))
                                ArraySet(pc, 0, ArrayGet(v_base, Multiply(c, 3)))
                                ArraySet(pc, 1, ArrayGet(v_base, Add(Multiply(c, 3), 1)))
                                o = CAD_Num.Orient2D(pa, pb, pc)
                                IfCondition EqualTo(o, Subtract(0, 1)) ThenBlock: {
                                    tmpi = b
                                    b = c
                                    c = tmpi
                                    o = 1
                                }
                                IfCondition EqualTo(o, 1) ThenBlock: {
                                    tt = Multiply(tri, 3)
                                    IfCondition EqualTo(flip, 0) ThenBlock: {
                                        ArraySet(i_base, tt, a)
                                        ArraySet(i_base, Add(tt, 1), b)
                                        ArraySet(i_base, Add(tt, 2), c)
                                    }
                                    IfCondition EqualTo(flip, 1) ThenBlock: {
                                        ArraySet(i_base, tt, a)
                                        ArraySet(i_base, Add(tt, 1), c)
                                        ArraySet(i_base, Add(tt, 2), b)
                                    }
                                    tri = Add(tri, 1)
                                }
                            }
                        }
                    }
                }
            }
            guard = Add(guard, 1)
        }
        ArraySet(pack_addr, 3, tri)
        Deallocate(tpack, 16)
        Deallocate(pa, 32)
        Deallocate(pb, 32)
        Deallocate(pc, 32)
        Deallocate(oa, 16384)
        Deallocate(hc, 16384)
        ReturnValue(tri)
    }
}

// Fill triangle minus a hole by fanning each polar sector
// (triangle vertex → next) onto the hole verts in that sector.
// Only keeps tris whose centroid lies in the original triangle
// (so a partition of ears does not overlap). pack: [nh, flip, ns]
Function.CAD_Tess.FanTriToHole {
    Input: v_base: Address
    Input: i_base: Address
    Input: tpack: Address
    Input: hidx: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        nh = ArrayGet(pack_addr, 0)
        flip = ArrayGet(pack_addr, 1)
        ns = ArrayGet(pack_addr, 2)
        IfCondition LessThan(nh, 3) ThenBlock: { ReturnValue(ns) }
        t0 = ArrayGet(tpack, 0)
        t1 = ArrayGet(tpack, 1)
        t2 = ArrayGet(tpack, 2)
        hcx = 0
        hcy = 0
        k = 0
        WhileLoop LessThan(k, nh) {
            ia = ArrayGet(hidx, k)
            hcx = Float_Add(hcx, ArrayGet(v_base, Multiply(ia, 3)))
            hcy = Float_Add(hcy, ArrayGet(v_base, Add(Multiply(ia, 3), 1)))
            k = Add(k, 1)
        }
        hcx = Float_Div(hcx, Float_FromInt(nh))
        hcy = Float_Div(hcy, Float_FromInt(nh))
        ta = Allocate(32)
        aa = Allocate(32)
        ArraySet(ta, 0, t0)
        ArraySet(ta, 1, t1)
        ArraySet(ta, 2, t2)
        s = 0
        WhileLoop LessThan(s, 3) {
            ia = ArrayGet(ta, s)
            ArraySet(aa, s, CAD_Geom.Atan2(Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), hcy), Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), hcx)))
            s = Add(s, 1)
        }
        // sort triangle verts by angle
        s = 0
        WhileLoop LessThan(s, 2) {
            u = 0
            WhileLoop LessThan(u, 2) {
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(ArrayGet(aa, Add(u, 1)), ArrayGet(aa, u))), 1) ThenBlock: {
                    tmpi = ArrayGet(ta, u)
                    ArraySet(ta, u, ArrayGet(ta, Add(u, 1)))
                    ArraySet(ta, Add(u, 1), tmpi)
                    tmpi = ArrayGet(aa, u)
                    ArraySet(aa, u, ArrayGet(aa, Add(u, 1)))
                    ArraySet(aa, Add(u, 1), tmpi)
                }
                u = Add(u, 1)
            }
            s = Add(s, 1)
        }
        ha = Allocate(16384)
        ho = Allocate(16384)
        k = 0
        WhileLoop LessThan(k, nh) {
            ia = ArrayGet(hidx, k)
            ArraySet(ho, k, ia)
            ArraySet(ha, k, CAD_Geom.Atan2(Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), hcy), Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), hcx)))
            k = Add(k, 1)
        }
        // bubble-sort hole verts by angle
        changed = 1
        guard = 0
        WhileLoop EqualTo(changed, 1) {
            changed = 0
            IfCondition LessThan(guard, nh) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, Subtract(nh, 1)) {
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(ArrayGet(ha, Add(k, 1)), ArrayGet(ha, k))), 1) ThenBlock: {
                        tmpi = ArrayGet(ha, k)
                        ArraySet(ha, k, ArrayGet(ha, Add(k, 1)))
                        ArraySet(ha, Add(k, 1), tmpi)
                        tmpi = ArrayGet(ho, k)
                        ArraySet(ho, k, ArrayGet(ho, Add(k, 1)))
                        ArraySet(ho, Add(k, 1), tmpi)
                        changed = 1
                    }
                    k = Add(k, 1)
                }
            }
            guard = Add(guard, 1)
        }
        three = 0x4008000000000000
        orig = Allocate(16)
        ArraySet(orig, 0, t0)
        ArraySet(orig, 1, t1)
        ArraySet(orig, 2, t2)
        sec = 0
        WhileLoop LessThan(sec, 3) {
            i0 = ArrayGet(ta, sec)
            i1 = ArrayGet(ta, 0)
            IfCondition LessThan(sec, 2) ThenBlock: { i1 = ArrayGet(ta, Add(sec, 1)) }
            a0 = ArrayGet(aa, sec)
            a1 = ArrayGet(aa, 0)
            IfCondition LessThan(sec, 2) ThenBlock: { a1 = ArrayGet(aa, Add(sec, 1)) }
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            // sector hole verts, high angle first (CW along hole)
            secn = 0
            secv = Allocate(16384)
            k = Subtract(nh, 1)
            WhileLoop GreaterEqual(k, 0) {
                dh = CAD_Num.PosMod2Pi(Float_Sub(ArrayGet(ha, k), a0))
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(dh, span)), 1) ThenBlock: {
                    ArraySet(secv, secn, ArrayGet(ho, k))
                    secn = Add(secn, 1)
                }
                k = Subtract(k, 1)
            }
            IfCondition EqualTo(secn, 0) ThenBlock: {
                // no hole vert in sector — skip (adjacent sectors own the rim)
            }
            IfCondition GreaterThan(secn, 0) ThenBlock: {
                // (i0, i1, secv[0]) then (i0, secv[p], secv[p+1])
                a = i0
                b = i1
                c = ArrayGet(secv, 0)
                mx = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Multiply(a, 3)), ArrayGet(v_base, Multiply(b, 3))), ArrayGet(v_base, Multiply(c, 3))), three)
                my = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Add(Multiply(a, 3), 1)), ArrayGet(v_base, Add(Multiply(b, 3), 1))), ArrayGet(v_base, Add(Multiply(c, 3), 1))), three)
                IfCondition EqualTo(CAD_Tess.PointInTriXY(mx, my, v_base, orig), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, hidx, nh), 0) ThenBlock: {
                        tt = Multiply(ns, 3)
                        IfCondition EqualTo(flip, 0) ThenBlock: {
                            ArraySet(i_base, tt, a)
                            ArraySet(i_base, Add(tt, 1), b)
                            ArraySet(i_base, Add(tt, 2), c)
                        }
                        IfCondition EqualTo(flip, 1) ThenBlock: {
                            ArraySet(i_base, tt, a)
                            ArraySet(i_base, Add(tt, 1), c)
                            ArraySet(i_base, Add(tt, 2), b)
                        }
                        ns = Add(ns, 1)
                    }
                }
                p = 0
                WhileLoop LessThan(p, Subtract(secn, 1)) {
                    a = i0
                    b = ArrayGet(secv, p)
                    c = ArrayGet(secv, Add(p, 1))
                    mx = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Multiply(a, 3)), ArrayGet(v_base, Multiply(b, 3))), ArrayGet(v_base, Multiply(c, 3))), three)
                    my = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Add(Multiply(a, 3), 1)), ArrayGet(v_base, Add(Multiply(b, 3), 1))), ArrayGet(v_base, Add(Multiply(c, 3), 1))), three)
                    IfCondition EqualTo(CAD_Tess.PointInTriXY(mx, my, v_base, orig), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, hidx, nh), 0) ThenBlock: {
                            tt = Multiply(ns, 3)
                            IfCondition EqualTo(flip, 0) ThenBlock: {
                                ArraySet(i_base, tt, a)
                                ArraySet(i_base, Add(tt, 1), b)
                                ArraySet(i_base, Add(tt, 2), c)
                            }
                            IfCondition EqualTo(flip, 1) ThenBlock: {
                                ArraySet(i_base, tt, a)
                                ArraySet(i_base, Add(tt, 1), c)
                                ArraySet(i_base, Add(tt, 2), b)
                            }
                            ns = Add(ns, 1)
                        }
                    }
                    p = Add(p, 1)
                }
            }
            Deallocate(secv, 16384)
            sec = Add(sec, 1)
        }
        ArraySet(pack_addr, 2, ns)
        Deallocate(orig, 16)
        Deallocate(ha, 16384)
        Deallocate(ho, 16384)
        Deallocate(ta, 32)
        Deallocate(aa, 32)
        ReturnValue(ns)
    }
}

// Subdivide a triangle against a hole until each child is clearly
// inside (drop) or outside (keep). Adds Steiner midpoints to v_base.
// tpack: [i0,i1,i2]   opack: [nh, ns, vcount, unused]
// Writes kept tris to scratch[ns...] and returns new ns.
Function.CAD_Tess.SubdivPunchTri {
    Input: v_base: Address
    Input: hidx: Address
    Input: scratch: Address
    Input: tpack: Address
    Input: opack: Address
    Output: Integer
    Body: {
        nh = ArrayGet(opack, 0)
        ns = ArrayGet(opack, 1)
        vc = ArrayGet(opack, 2)
        q = ArrayGet(opack, 3)
        i0 = ArrayGet(tpack, 0)
        i1 = ArrayGet(tpack, 1)
        i2 = ArrayGet(tpack, 2)
        ArraySet(q, 0, i0)
        ArraySet(q, 1, i1)
        ArraySet(q, 2, i2)
        ArraySet(q, 3, 0)
        qn = 1
        qi = 0
        // hole AABB from first vert, then expand
        hk0 = ArrayGet(hidx, 0)
        hminx = ArrayGet(v_base, Multiply(hk0, 3))
        hminy = ArrayGet(v_base, Add(Multiply(hk0, 3), 1))
        hmaxx = hminx
        hmaxy = hminy
        k = 1
        WhileLoop LessThan(k, nh) {
            hk = ArrayGet(hidx, k)
            hx = ArrayGet(v_base, Multiply(hk, 3))
            hy = ArrayGet(v_base, Add(Multiply(hk, 3), 1))
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hx, hminx)), 1) ThenBlock: { hminx = hx }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hy, hminy)), 1) ThenBlock: { hminy = hy }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hmaxx, hx)), 1) ThenBlock: { hmaxx = hx }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hmaxy, hy)), 1) ThenBlock: { hmaxy = hy }
            k = Add(k, 1)
        }
        nsep = 0
        half = 0x3FE0000000000000
        three = 0x4008000000000000
        maxq = 400
        WhileLoop LessThan(qi, qn) {
            qb = Multiply(qi, 4)
            a = ArrayGet(q, qb)
            b = ArrayGet(q, Add(qb, 1))
            c = ArrayGet(q, Add(qb, 2))
            depth = ArrayGet(q, Add(qb, 3))
            xa = ArrayGet(v_base, Multiply(a, 3))
            ya = ArrayGet(v_base, Add(Multiply(a, 3), 1))
            xb = ArrayGet(v_base, Multiply(b, 3))
            yb = ArrayGet(v_base, Add(Multiply(b, 3), 1))
            xc = ArrayGet(v_base, Multiply(c, 3))
            yc = ArrayGet(v_base, Add(Multiply(c, 3), 1))
            // tri AABB vs hole AABB — far plate corners must stay
            tminx = xa
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(xb, tminx)), 1) ThenBlock: { tminx = xb }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(xc, tminx)), 1) ThenBlock: { tminx = xc }
            tmaxx = xa
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxx, xb)), 1) ThenBlock: { tmaxx = xb }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxx, xc)), 1) ThenBlock: { tmaxx = xc }
            tminy = ya
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(yb, tminy)), 1) ThenBlock: { tminy = yb }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(yc, tminy)), 1) ThenBlock: { tminy = yc }
            tmaxy = ya
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxy, yb)), 1) ThenBlock: { tmaxy = yb }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxy, yc)), 1) ThenBlock: { tmaxy = yc }
            sep = 0
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxx, hminx)), 1) ThenBlock: { sep = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hmaxx, tminx)), 1) ThenBlock: { sep = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxy, hminy)), 1) ThenBlock: { sep = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hmaxy, tminy)), 1) ThenBlock: { sep = 1 }
            IfCondition EqualTo(sep, 1) ThenBlock: {
                nsep = Add(nsep, 1)
                ArraySet(scratch, Multiply(ns, 3), a)
                ArraySet(scratch, Add(Multiply(ns, 3), 1), b)
                ArraySet(scratch, Add(Multiply(ns, 3), 2), c)
                ns = Add(ns, 1)
            }
            IfCondition EqualTo(sep, 0) ThenBlock: {
            ina = CAD_Tess.PointInIdxPoly(xa, ya, v_base, hidx, nh)
            inb = CAD_Tess.PointInIdxPoly(xb, yb, v_base, hidx, nh)
            inc = CAD_Tess.PointInIdxPoly(xc, yc, v_base, hidx, nh)
            allin = 0
            IfCondition EqualTo(ina, 1) ThenBlock: {
                IfCondition EqualTo(inb, 1) ThenBlock: {
                    IfCondition EqualTo(inc, 1) ThenBlock: { allin = 1 }
                }
            }
            mx = Float_Div(Float_Add(Float_Add(xa, xb), xc), three)
            my = Float_Div(Float_Add(Float_Add(ya, yb), yc), three)
            cin = CAD_Tess.PointInIdxPoly(mx, my, v_base, hidx, nh)
            // hole vertex inside this tri?
            ArraySet(tpack, 0, a)
            ArraySet(tpack, 1, b)
            ArraySet(tpack, 2, c)
            hin = 0
            k = 0
            step = 1
            IfCondition GreaterThan(nh, 8) ThenBlock: { step = Divide(nh, 8) }
            WhileLoop LessThan(k, nh) {
                IfCondition EqualTo(hin, 0) ThenBlock: {
                    hk = ArrayGet(hidx, k)
                    IfCondition EqualTo(CAD_Tess.PointInTriXY(ArrayGet(v_base, Multiply(hk, 3)), ArrayGet(v_base, Add(Multiply(hk, 3), 1)), v_base, tpack), 1) ThenBlock: {
                        hin = 1
                    }
                }
                k = Add(k, step)
            }
            ov = cin
            IfCondition EqualTo(ina, 1) ThenBlock: { ov = 1 }
            IfCondition EqualTo(inb, 1) ThenBlock: { ov = 1 }
            IfCondition EqualTo(inc, 1) ThenBlock: { ov = 1 }
            IfCondition EqualTo(hin, 1) ThenBlock: { ov = 1 }
            IfCondition EqualTo(allin, 1) ThenBlock: { ov = 2 }
            IfCondition EqualTo(ov, 0) ThenBlock: {
                ArraySet(scratch, Multiply(ns, 3), a)
                ArraySet(scratch, Add(Multiply(ns, 3), 1), b)
                ArraySet(scratch, Add(Multiply(ns, 3), 2), c)
                ns = Add(ns, 1)
            }
            IfCondition EqualTo(ov, 1) ThenBlock: {
                split = 1
                IfCondition GreaterThan(depth, 4) ThenBlock: { split = 0 }
                IfCondition GreaterThan(Add(qn, 4), maxq) ThenBlock: { split = 0 }
                IfCondition EqualTo(split, 0) ThenBlock: {
                    // drop leftover overlap — those slivers poke into the hole
                }
                IfCondition EqualTo(split, 1) ThenBlock: {
                    za = ArrayGet(v_base, Add(Multiply(a, 3), 2))
                    m01 = vc
                    ArraySet(v_base, Multiply(m01, 3), Float_Mul(Float_Add(xa, xb), half))
                    ArraySet(v_base, Add(Multiply(m01, 3), 1), Float_Mul(Float_Add(ya, yb), half))
                    ArraySet(v_base, Add(Multiply(m01, 3), 2), za)
                    vc = Add(vc, 1)
                    m12 = vc
                    ArraySet(v_base, Multiply(m12, 3), Float_Mul(Float_Add(xb, xc), half))
                    ArraySet(v_base, Add(Multiply(m12, 3), 1), Float_Mul(Float_Add(yb, yc), half))
                    ArraySet(v_base, Add(Multiply(m12, 3), 2), za)
                    vc = Add(vc, 1)
                    m20 = vc
                    ArraySet(v_base, Multiply(m20, 3), Float_Mul(Float_Add(xc, xa), half))
                    ArraySet(v_base, Add(Multiply(m20, 3), 1), Float_Mul(Float_Add(yc, ya), half))
                    ArraySet(v_base, Add(Multiply(m20, 3), 2), za)
                    vc = Add(vc, 1)
                    nd = Add(depth, 1)
                    qb2 = Multiply(qn, 4)
                    ArraySet(q, qb2, a)
                    ArraySet(q, Add(qb2, 1), m01)
                    ArraySet(q, Add(qb2, 2), m20)
                    ArraySet(q, Add(qb2, 3), nd)
                    qn = Add(qn, 1)
                    qb2 = Multiply(qn, 4)
                    ArraySet(q, qb2, b)
                    ArraySet(q, Add(qb2, 1), m12)
                    ArraySet(q, Add(qb2, 2), m01)
                    ArraySet(q, Add(qb2, 3), nd)
                    qn = Add(qn, 1)
                    qb2 = Multiply(qn, 4)
                    ArraySet(q, qb2, c)
                    ArraySet(q, Add(qb2, 1), m20)
                    ArraySet(q, Add(qb2, 2), m12)
                    ArraySet(q, Add(qb2, 3), nd)
                    qn = Add(qn, 1)
                    qb2 = Multiply(qn, 4)
                    ArraySet(q, qb2, m01)
                    ArraySet(q, Add(qb2, 1), m12)
                    ArraySet(q, Add(qb2, 2), m20)
                    ArraySet(q, Add(qb2, 3), nd)
                    qn = Add(qn, 1)
                }
            }
            }
            qi = Add(qi, 1)
        }
        ArraySet(opack, 1, ns)
        ArraySet(opack, 2, vc)
        ReturnValue(ns)
    }
}

// Valid inner (hole) loop on this outer, or 0. Topology, not a vert-count guess.
Function.CAD_Tess.ValidInnerLoop {
    Input: outer: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(outer, 0) ThenBlock: { ReturnValue(0) }
        inner = CAD_Store.Read(outer, 2)
        IfCondition EqualTo(inner, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(inner, outer) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Store.Read(inner, 0), 0) ThenBlock: { ReturnValue(0) }
        ni = CAD_Topo.LoopCountCoedges(inner)
        IfCondition LessThan(ni, 3) ThenBlock: {
            hd0 = CAD_Store.Read(inner, 0)
            IfCondition EqualTo(hd0, 0) ThenBlock: { ReturnValue(0) }
            ed0 = CAD_Store.Read(hd0, 0)
            IfCondition EqualTo(ed0, 0) ThenBlock: { ReturnValue(0) }
            cr0 = CAD_Store.Read(ed0, 2)
            IfCondition EqualTo(cr0, 0) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(CAD_Store.Read(cr0, 0), 2) ThenBlock: { ReturnValue(0) }
        }
        IfCondition GreaterThan(ni, 2048) ThenBlock: { ReturnValue(0) }
        ReturnValue(inner)
    }
}

// |nz| of the unit Newell normal from every live loop vert.
// First-three-verts cross is ~0 on a tessellated circle (near-collinear).
Function.CAD_Tess.LoopNewellAbsNz {
    Input: loop_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(loop_h, 0) ThenBlock: { ReturnValue(0) }
        head = CAD_Store.Read(loop_h, 0)
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(0) }
        nx = 0
        ny = 0
        nz = 0
        nv = 0
        ce = head
        guard = 0
        WhileLoop LessThan(guard, 4096) {
            ov = CAD_Store.Read(ce, 5)
            nxt = CAD_Store.Read(ce, 2)
            IfCondition NotEqual(ov, 0) ThenBlock: {
                IfCondition NotEqual(nxt, 0) ThenBlock: {
                    ov2 = CAD_Store.Read(nxt, 5)
                    IfCondition NotEqual(ov2, 0) ThenBlock: {
                        x0 = CAD_Store.Read(ov, 0)
                        y0 = CAD_Store.Read(ov, 1)
                        z0 = CAD_Store.Read(ov, 2)
                        x1 = CAD_Store.Read(ov2, 0)
                        y1 = CAD_Store.Read(ov2, 1)
                        z1 = CAD_Store.Read(ov2, 2)
                        nx = Float_Add(nx, Float_Mul(Float_Sub(y0, y1), Float_Add(z0, z1)))
                        ny = Float_Add(ny, Float_Mul(Float_Sub(z0, z1), Float_Add(x0, x1)))
                        nz = Float_Add(nz, Float_Mul(Float_Sub(x0, x1), Float_Add(y0, y1)))
                        nv = Add(nv, 1)
                    }
                }
            }
            IfCondition EqualTo(nxt, 0) ThenBlock: { guard = 4096 }
            IfCondition NotEqual(nxt, 0) ThenBlock: { ce = nxt }
            guard = Add(guard, 1)
            IfCondition EqualTo(ce, head) ThenBlock: { guard = 4096 }
        }
        IfCondition LessThan(nv, 3) ThenBlock: { ReturnValue(0) }
        nz_s = nz
        gl2 = Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz_s, nz_s))
        gl = CAD_Num.Sqrt(gl2)
        IfCondition EqualTo(CAD_Num.IsZero(gl, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsNeg(nz_s), 1) ThenBlock: { nz_s = Float_Sub(0, nz_s) }
        ReturnValue(Float_Div(nz_s, gl))
    }
}

// Planar face with outer + optional hole loops.
// Holes: radial spoke from hole centroid, then Held, then annulus
// midpoint. EarClipPoly of the simple ring. No fan. No n-count cutoff.
// pack: [vert_count, tri_count]. Returns tri_count.
// Zip a planar outer loop to an inner hole as a short-edge annulus.
// Avoids keyhole earclip (long corner-to-circle "strains" on the cap).
Function.CAD_Tess.MeshAnnulusZip {
    Input: nout: Integer
    Input: nh: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(nout, 3) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nh, 3) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Tess.FaceBufs(), 0) ThenBlock: { ReturnValue(0) }
        v_base = CAD_Tess_State.v_base
        oidx = CAD_Tess_State.oidx
        hidx = CAD_Tess_State.hidx
        i_base = CAD_Tess_State.i_base
        pack = CAD_Tess_State.pack
        osub = CAD_Tess_State.bridged
        hsub = CAD_Tess_State.merge_hc
        target = nh
        IfCondition LessThan(target, nout) ThenBlock: { target = nout }
        IfCondition LessThan(target, 8) ThenBlock: { target = 8 }
        IfCondition GreaterThan(target, 256) ThenBlock: { target = 256 }
        vc = ArrayGet(pack, 0)
        k = 0
        WhileLoop LessThan(k, target) {
            un = Multiply(k, nout)
            i0 = Divide(un, target)
            rem = Subtract(un, Multiply(i0, target))
            i0 = Modulo(i0, nout)
            i1 = Add(i0, 1)
            IfCondition GreaterEqual(i1, nout) ThenBlock: { i1 = 0 }
            ia = ArrayGet(oidx, i0)
            IfCondition EqualTo(rem, 0) ThenBlock: {
                ArraySet(osub, k, ia)
            }
            IfCondition NotEqual(rem, 0) ThenBlock: {
                ib = ArrayGet(oidx, i1)
                t = Float_Div(Float_FromInt(rem), Float_FromInt(target))
                o = Multiply(vc, 3)
                ax = ArrayGet(v_base, Multiply(ia, 3))
                ay = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
                az = ArrayGet(v_base, Add(Multiply(ia, 3), 2))
                bx = ArrayGet(v_base, Multiply(ib, 3))
                by = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
                bz = ArrayGet(v_base, Add(Multiply(ib, 3), 2))
                ArraySet(v_base, o, Float_Add(ax, Float_Mul(Float_Sub(bx, ax), t)))
                ArraySet(v_base, Add(o, 1), Float_Add(ay, Float_Mul(Float_Sub(by, ay), t)))
                ArraySet(v_base, Add(o, 2), Float_Add(az, Float_Mul(Float_Sub(bz, az), t)))
                ArraySet(osub, k, vc)
                vc = Add(vc, 1)
            }
            k = Add(k, 1)
        }
        ArraySet(pack, 0, vc)
        // align hole start to first outer sample
        best = 0
        best_d2 = 0
        ia = ArrayGet(osub, 0)
        ox = ArrayGet(v_base, Multiply(ia, 3))
        oy = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
        j = 0
        WhileLoop LessThan(j, nh) {
            ib = ArrayGet(hidx, j)
            dx = Float_Sub(ArrayGet(v_base, Multiply(ib, 3)), ox)
            dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ib, 3), 1)), oy)
            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
            IfCondition EqualTo(j, 0) ThenBlock: { best_d2 = d2 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d2, best_d2)), 1) ThenBlock: {
                best_d2 = d2
                best = j
            }
            j = Add(j, 1)
        }
        // Annulus wants opposite windings (outer CCW, hole CW from +Z).
        // Same sign → walk the hole backward.
        oarea = 0
        k = 0
        WhileLoop LessThan(k, nout) {
            kn = Add(k, 1)
            IfCondition EqualTo(kn, nout) ThenBlock: { kn = 0 }
            ia = ArrayGet(oidx, k)
            ib = ArrayGet(oidx, kn)
            oarea = Float_Add(oarea, Float_Sub(Float_Mul(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), Float_Mul(ArrayGet(v_base, Multiply(ib, 3)), ArrayGet(v_base, Add(Multiply(ia, 3), 1)))))
            k = Add(k, 1)
        }
        harea = 0
        k = 0
        WhileLoop LessThan(k, nh) {
            kn = Add(k, 1)
            IfCondition EqualTo(kn, nh) ThenBlock: { kn = 0 }
            ia = ArrayGet(hidx, k)
            ib = ArrayGet(hidx, kn)
            harea = Float_Add(harea, Float_Sub(Float_Mul(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), Float_Mul(ArrayGet(v_base, Multiply(ib, 3)), ArrayGet(v_base, Add(Multiply(ia, 3), 1)))))
            k = Add(k, 1)
        }
        back = 0
        IfCondition EqualTo(CAD_Num.IsNeg(oarea), CAD_Num.IsNeg(harea)) ThenBlock: { back = 1 }
        vc = ArrayGet(pack, 0)
        k = 0
        WhileLoop LessThan(k, target) {
            un = Multiply(k, nh)
            jstep = Divide(un, target)
            rem = Subtract(un, Multiply(jstep, target))
            IfCondition EqualTo(back, 1) ThenBlock: {
                j0 = Subtract(best, jstep)
                IfCondition LessThan(j0, 0) ThenBlock: { j0 = Add(j0, nh) }
                j1 = Subtract(j0, 1)
                IfCondition LessThan(j1, 0) ThenBlock: { j1 = Subtract(nh, 1) }
            }
            IfCondition EqualTo(back, 0) ThenBlock: {
                j0 = Add(best, jstep)
                j0 = Modulo(j0, nh)
                j1 = Add(j0, 1)
                IfCondition GreaterEqual(j1, nh) ThenBlock: { j1 = 0 }
            }
            ia = ArrayGet(hidx, j0)
            IfCondition EqualTo(rem, 0) ThenBlock: {
                ArraySet(hsub, k, ia)
            }
            IfCondition NotEqual(rem, 0) ThenBlock: {
                ib = ArrayGet(hidx, j1)
                t = Float_Div(Float_FromInt(rem), Float_FromInt(target))
                o = Multiply(vc, 3)
                ax = ArrayGet(v_base, Multiply(ia, 3))
                ay = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
                az = ArrayGet(v_base, Add(Multiply(ia, 3), 2))
                bx = ArrayGet(v_base, Multiply(ib, 3))
                by = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
                bz = ArrayGet(v_base, Add(Multiply(ib, 3), 2))
                ArraySet(v_base, o, Float_Add(ax, Float_Mul(Float_Sub(bx, ax), t)))
                ArraySet(v_base, Add(o, 1), Float_Add(ay, Float_Mul(Float_Sub(by, ay), t)))
                ArraySet(v_base, Add(o, 2), Float_Add(az, Float_Mul(Float_Sub(bz, az), t)))
                ArraySet(hsub, k, vc)
                vc = Add(vc, 1)
            }
            k = Add(k, 1)
        }
        ArraySet(pack, 0, vc)
        nt = ArrayGet(pack, 1)
        k = 0
        WhileLoop LessThan(k, target) {
            kn = Add(k, 1)
            IfCondition EqualTo(kn, target) ThenBlock: { kn = 0 }
            oa = ArrayGet(osub, k)
            ob = ArrayGet(osub, kn)
            ha = ArrayGet(hsub, k)
            hb = ArrayGet(hsub, kn)
            IfCondition NotEqual(oa, ob) ThenBlock: {
                IfCondition NotEqual(ha, hb) ThenBlock: {
                    t0 = Multiply(nt, 3)
                    ArraySet(i_base, t0, oa)
                    ArraySet(i_base, Add(t0, 1), ob)
                    ArraySet(i_base, Add(t0, 2), ha)
                    nt = Add(nt, 1)
                    t0 = Multiply(nt, 3)
                    ArraySet(i_base, t0, ha)
                    ArraySet(i_base, Add(t0, 1), ob)
                    ArraySet(i_base, Add(t0, 2), hb)
                    nt = Add(nt, 1)
                }
            }
            k = Add(k, 1)
        }
        ArraySet(pack, 1, nt)
        ReturnValue(nt)
    }
}

Function.CAD_Tess.MeshFaceLoopsXY {
    Input: face_h: Integer
    Input: v_base: Address
    Input: i_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        CAD_Tess_State.tess_loop = CAD_Store.Read(face_h, 1)
        IfCondition EqualTo(CAD_Tess_State.tess_loop, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition NotEqual(CAD_Tess.FaceBufs(), 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.nout = CAD_Tess.CollectLoopVerts(CAD_Tess_State.tess_loop, CAD_Tess_State.v_base, CAD_Tess_State.oidx, CAD_Tess_State.pack)
        IfCondition LessThan(CAD_Tess_State.nout, 3) ThenBlock: {
            ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
        }
        CAD_Tess_State.inner = CAD_Tess.ValidInnerLoop(CAD_Tess_State.tess_loop)
        CAD_Tess_State.nh = 0
        CAD_Tess_State.use_zip = 0
        IfCondition NotEqual(CAD_Tess_State.inner, 0) ThenBlock: {
            CAD_Tess_State.nh = CAD_Tess.CollectLoopVerts(CAD_Tess_State.inner, CAD_Tess_State.v_base, CAD_Tess_State.hidx, CAD_Tess_State.pack)
            IfCondition GreaterEqual(CAD_Tess_State.nh, 3) ThenBlock: {
                IfCondition GreaterEqual(CAD_Tess_State.nout, 16) ThenBlock: {
                    IfCondition GreaterEqual(CAD_Tess_State.nh, 16) ThenBlock: { CAD_Tess_State.use_zip = 1 }
                }
                IfCondition EqualTo(CAD_Tess_State.use_zip, 1) ThenBlock: {
                    na = CAD_Tess.MeshAnnulusZip(CAD_Tess_State.nout, CAD_Tess_State.nh)
                    IfCondition GreaterThan(na, 0) ThenBlock: {
                        ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
                    }
                }
            }
        }
        CAD_Tess_State.pi = 0
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nout) {
            ArraySet(CAD_Tess_State.bridged, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.pi))
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        eps2 = 0x3C9CD2B297D889BC
        CAD_Tess_State.nn = CAD_Tess_State.nout
        changed = 1
        WhileLoop EqualTo(changed, 1) {
            changed = 0
            IfCondition GreaterThan(CAD_Tess_State.nn, 3) ThenBlock: {
                j = 0
                WhileLoop LessThan(j, CAD_Tess_State.nn) {
                    jn = Add(j, 1)
                    IfCondition EqualTo(jn, CAD_Tess_State.nn) ThenBlock: { jn = 0 }
                    ia = ArrayGet(CAD_Tess_State.bridged, j)
                    ib = ArrayGet(CAD_Tess_State.bridged, jn)
                    dx = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(ia, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(ib, 3)))
                    dy = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ia, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ib, 3), 1)))
                    d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    IfCondition EqualTo(Float_Le(d2, eps2), 1) ThenBlock: {
                        rm = jn
                        IfCondition EqualTo(jn, 0) ThenBlock: { rm = j }
                        k = rm
                        WhileLoop LessThan(k, Subtract(CAD_Tess_State.nn, 1)) {
                            ArraySet(CAD_Tess_State.bridged, k, ArrayGet(CAD_Tess_State.bridged, Add(k, 1)))
                            k = Add(k, 1)
                        }
                        CAD_Tess_State.nn = Subtract(CAD_Tess_State.nn, 1)
                        changed = 1
                        j = CAD_Tess_State.nn
                    }
                    j = Add(j, 1)
                }
            }
        }
        CAD_Tess_State.nout = CAD_Tess_State.nn
        area = 0
        j = 0
        WhileLoop LessThan(j, CAD_Tess_State.nout) {
            jn = Add(j, 1)
            IfCondition EqualTo(jn, CAD_Tess_State.nout) ThenBlock: { jn = 0 }
            ia = ArrayGet(CAD_Tess_State.bridged, j)
            ib = ArrayGet(CAD_Tess_State.bridged, jn)
            xa = ArrayGet(CAD_Tess_State.v_base, Multiply(ia, 3))
            ya = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ia, 3), 1))
            xb = ArrayGet(CAD_Tess_State.v_base, Multiply(ib, 3))
            yb = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ib, 3), 1))
            area = Float_Add(area, Float_Sub(Float_Mul(xa, yb), Float_Mul(xb, ya)))
            j = Add(j, 1)
        }
        IfCondition EqualTo(CAD_Num.IsZero(area, 0), 1) ThenBlock: {
            ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
        }
        CAD_Tess_State.flip = 0
        IfCondition EqualTo(CAD_Num.IsNeg(area), 1) ThenBlock: {
            lo = 0
            hi = Subtract(CAD_Tess_State.nout, 1)
            WhileLoop LessThan(lo, hi) {
                tmpi = ArrayGet(CAD_Tess_State.bridged, lo)
                ArraySet(CAD_Tess_State.bridged, lo, ArrayGet(CAD_Tess_State.bridged, hi))
                ArraySet(CAD_Tess_State.bridged, hi, tmpi)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
            CAD_Tess_State.flip = 1
        }
        CAD_Tess_State.pi = 0
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nout) {
            ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.bridged, CAD_Tess_State.pi))
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        CAD_Tess_State.want_h = 0
        IfCondition NotEqual(CAD_Tess_State.inner, 0) ThenBlock: { CAD_Tess_State.want_h = 1 }
        CAD_Tess_State.holes_ok = 0
        IfCondition NotEqual(CAD_Tess_State.inner, 0) ThenBlock: {
            hguard = 0
            WhileLoop NotEqual(CAD_Tess_State.inner, 0) {
                IfCondition GreaterThan(hguard, 8) ThenBlock: { CAD_Tess_State.inner = 0 }
                IfCondition NotEqual(CAD_Tess_State.inner, 0) ThenBlock: {
                    CAD_Tess_State.nh = CAD_Tess.CollectLoopVerts(CAD_Tess_State.inner, CAD_Tess_State.v_base, CAD_Tess_State.hidx, CAD_Tess_State.pack)
                    IfCondition GreaterEqual(CAD_Tess_State.nh, 3) ThenBlock: {
                        ArraySet(CAD_Tess_State.ep, 0, CAD_Tess_State.nout)
                        ArraySet(CAD_Tess_State.ep, 1, CAD_Tess_State.nh)
                        nm = CAD_Tess.MergeHoleRing(CAD_Tess_State.v_base, CAD_Tess_State.oidx, CAD_Tess_State.hidx, CAD_Tess_State.bridged, CAD_Tess_State.ep)
                        IfCondition GreaterEqual(nm, 3) ThenBlock: {
                            CAD_Tess_State.nout = nm
                            CAD_Tess_State.holes_ok = 1
                            CAD_Tess_State.pi = 0
                            WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nout) {
                                ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.bridged, CAD_Tess_State.pi))
                                CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
                            }
                        }
                    }
                    CAD_Tess_State.inner = CAD_Store.Read(CAD_Tess_State.inner, 2)
                }
                hguard = Add(hguard, 1)
            }
        }
        IfCondition EqualTo(CAD_Tess_State.want_h, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Tess_State.holes_ok, 0) ThenBlock: {
                ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
            }
        }
        CAD_Tess_State.nring = CAD_Tess_State.nout
        IfCondition EqualTo(CAD_Tess_State.clean, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.pi = 0
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nring) {
            ArraySet(CAD_Tess_State.clean, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.bridged, CAD_Tess_State.pi))
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        tb_before = ArrayGet(CAD_Tess_State.pack, 1)
        IfCondition EqualTo(CAD_Tess_State.ep, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        ArraySet(CAD_Tess_State.ep, 0, CAD_Tess_State.nring)
        ArraySet(CAD_Tess_State.ep, 1, tb_before)
        ArraySet(CAD_Tess_State.ep, 2, CAD_Tess_State.flip)
        CAD_Tess.EarClipPoly(CAD_Tess_State.bridged, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.ep)
        IfCondition EqualTo(ArrayGet(CAD_Tess_State.ep, 1), tb_before) ThenBlock: {
            CAD_Tess_State.pi = 0
            WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nring) {
                ArraySet(CAD_Tess_State.bridged, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.clean, Subtract(Subtract(CAD_Tess_State.nring, 1), CAD_Tess_State.pi)))
                CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            }
            ArraySet(CAD_Tess_State.ep, 0, CAD_Tess_State.nring)
            ArraySet(CAD_Tess_State.ep, 1, tb_before)
            ArraySet(CAD_Tess_State.ep, 2, Subtract(1, CAD_Tess_State.flip))
            CAD_Tess.EarClipPoly(CAD_Tess_State.bridged, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.ep)
        }
        ArraySet(CAD_Tess_State.pack, 1, ArrayGet(CAD_Tess_State.ep, 1))
        IfCondition EqualTo(CAD_Tess_State.want_h, 1) ThenBlock: {
            PrintMessage("tess hole nout=")
            PrintNumber(CAD_Tess_State.nring)
            PrintMessage(" nh=")
            PrintNumber(CAD_Tess_State.nh)
            PrintMessage(" nt=")
            PrintNumber(ArrayGet(CAD_Tess_State.pack, 1))
            PrintMessage("\n")
        }
        ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
    }
}

// MeshSolid: kind 1/2 cyl; 3 plate+hole; 4 sphere; else face walk
// Holed face (inner loop) or XY cap (Newell |nz|) → MeshFaceLoopsXY.
// Walls → fan. Never nce cutoff. Never 0-tris→fan (that fills holes).
Function.CAD_Tess.MeshSolid {
    Input: solid_handle: Integer
    Input: deflection_r: Integer
    Input: out_mesh_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: {
            ReturnValue(-1)
        }
        kind = CAD_Store.Read(solid_handle, 3)
        defl = deflection_r
        IfCondition EqualTo(CAD_Num.IsZero(defl, 0), 1) ThenBlock: {
            defl = 0x3F947AE147AE147B
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            r = CAD_Store.Read(ph, 0)
            h = CAD_Store.Read(ph, 1)
            org = Allocate(32)
            ArraySet(org, 0, CAD_Store.Read(ph, 2))
            ArraySet(org, 1, CAD_Store.Read(ph, 3))
            ArraySet(org, 2, CAD_Store.Read(ph, 4))
            nt = CAD_Tess.MeshCylinderAnalytic(r, h, defl, org, out_mesh_addr)
            Deallocate(org, 32)
            ReturnValue(nt)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            r = CAD_Store.Read(ph, 0)
            h = CAD_Store.Read(ph, 1)
            org = Allocate(32)
            ArraySet(org, 0, CAD_Store.Read(ph, 2))
            ArraySet(org, 1, CAD_Store.Read(ph, 3))
            ArraySet(org, 2, CAD_Store.Read(ph, 4))
            nt = CAD_Tess.MeshCylinderAnalytic(r, h, defl, org, out_mesh_addr)
            Deallocate(org, 32)
            ReturnValue(nt)
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            nt = CAD_Tess.MeshBoxThroughHole(ph, defl, out_mesh_addr)
            oz = CAD_Store.Read(solid_handle, 2)
            IfCondition NotEqual(CAD_Num.IsZero(oz, 0), 1) ThenBlock: {
                nv = ArrayGet(out_mesh_addr, 0)
                vb = ArrayGet(out_mesh_addr, 2)
                ii = 0
                WhileLoop LessThan(ii, nv) {
                    zi = Add(Multiply(ii, 3), 2)
                    ArraySet(vb, zi, Float_Add(ArrayGet(vb, zi), oz))
                    ii = Add(ii, 1)
                }
            }
            ReturnValue(nt)
        }
        IfCondition EqualTo(kind, 4) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            ReturnValue(CAD_Tess.MeshSphereAnalytic(ph, defl, out_mesh_addr))
        }
        // kind 5 tube/annulus — analytic full 360 (no keyhole, smooth)
        IfCondition EqualTo(kind, 5) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            IfCondition EqualTo(ph, 0) ThenBlock: { ReturnValue(-1) }
            ReturnValue(CAD_Tess.MeshTubeAnalytic(ph, defl, out_mesh_addr))
        }
        // kind 6 surface of revolution — Class A, CircleSegCount (≥90)
        IfCondition EqualTo(kind, 6) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            IfCondition EqualTo(ph, 0) ThenBlock: { ReturnValue(-1) }
            ReturnValue(CAD_Tess.MeshLatheAnalytic(ph, defl, out_mesh_addr))
        }
        // dense multi-circle prisms need large slabs (steiner punch verts)
        IfCondition NotEqual(CAD_Tess.SolidBufs(), 0) ThenBlock: { ReturnValue(-1) }
        v_base = CAD_Tess_State.v_base
        i_base = CAD_Tess_State.i_base
        pack = CAD_Tess_State.pack
        CAD_Tess_State.tess_sh = CAD_Store.Read(solid_handle, 0)
        ArraySet(pack, 0, 0)
        ArraySet(pack, 1, 0)
        sguard = 0
        WhileLoop NotEqual(CAD_Tess_State.tess_sh, 0) {
            CAD_Tess_State.tess_face = CAD_Store.Read(CAD_Tess_State.tess_sh, 0)
            guard = 0
            WhileLoop NotEqual(CAD_Tess_State.tess_face, 0) {
                CAD_Tess_State.tess_loop = CAD_Store.Read(CAD_Tess_State.tess_face, 1)
                IfCondition NotEqual(CAD_Tess_State.tess_loop, 0) ThenBlock: {
                    CAD_Tess_State.nring = CAD_Topo.LoopCountCoedges(CAD_Tess_State.tess_loop)
                    circ_ok = 0
                    IfCondition LessThan(CAD_Tess_State.nring, 3) ThenBlock: {
                        hd0 = CAD_Store.Read(CAD_Tess_State.tess_loop, 0)
                        IfCondition NotEqual(hd0, 0) ThenBlock: {
                            ed0 = CAD_Store.Read(hd0, 0)
                            IfCondition NotEqual(ed0, 0) ThenBlock: {
                                cr0 = CAD_Store.Read(ed0, 2)
                                IfCondition NotEqual(cr0, 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Store.Read(cr0, 0), 2) ThenBlock: { circ_ok = 1 }
                                }
                            }
                        }
                    }
                    IfCondition GreaterEqual(CAD_Tess_State.nring, 3) ThenBlock: { circ_ok = 1 }
                    IfCondition EqualTo(circ_ok, 1) ThenBlock: {
                        did_cyl = 0
                        surf = CAD_Store.Read(CAD_Tess_State.tess_face, 0)
                        IfCondition NotEqual(surf, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(surf, 0), 2) ThenBlock: {
                                CAD_Tess.MeshCylBlendFace(CAD_Tess_State.tess_face, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.pack)
                                did_cyl = 1
                            }
                        }
                        IfCondition EqualTo(did_cyl, 0) ThenBlock: {
                        use_xy = 0
                        anz = CAD_Tess.LoopNewellAbsNz(CAD_Tess_State.tess_loop)
                        IfCondition EqualTo(Float_Le(anz, 0x3FEC000000000000), 0) ThenBlock: { use_xy = 1 }
                        IfCondition LessThan(CAD_Tess_State.nring, 3) ThenBlock: { use_xy = 1 }
                        has_inner = 0
                        IfCondition NotEqual(CAD_Tess.ValidInnerLoop(CAD_Tess_State.tess_loop), 0) ThenBlock: { has_inner = 1 }
                        IfCondition EqualTo(has_inner, 1) ThenBlock: {
                            IfCondition LessEqual(CAD_Tess_State.nring, 2048) ThenBlock: {
                                CAD_Tess.MeshFaceLoopsXY(CAD_Tess_State.tess_face, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.pack)
                            }
                        }
                        IfCondition EqualTo(has_inner, 0) ThenBlock: {
                            IfCondition EqualTo(use_xy, 1) ThenBlock: {
                                IfCondition LessEqual(CAD_Tess_State.nring, 2048) ThenBlock: {
                                    CAD_Tess.MeshFaceLoopsXY(CAD_Tess_State.tess_face, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.pack)
                                }
                            }
                            IfCondition EqualTo(use_xy, 0) ThenBlock: {
                                IfCondition LessEqual(CAD_Tess_State.nring, 2048) ThenBlock: {
                                    CAD_Tess.MeshLoopFanTess(CAD_Tess_State.tess_loop, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.pack)
                                }
                            }
                        }
                        }
                    }
                }
                CAD_Tess_State.tess_face = CAD_Store.Read(CAD_Tess_State.tess_face, 3)
                guard = Add(guard, 1)
                IfCondition GreaterThan(guard, 4096) ThenBlock: {
                    CAD_Tess_State.tess_face = 0
                }
            }
            CAD_Tess_State.tess_sh = CAD_Store.Read(CAD_Tess_State.tess_sh, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CAD_Tess_State.tess_sh = 0 }
        }
        pack = CAD_Tess_State.pack
        v_base = CAD_Tess_State.v_base
        i_base = CAD_Tess_State.i_base
        vert_count = ArrayGet(pack, 0)
        tri_count = ArrayGet(pack, 1)
        // Each face copied its own verts (CollectLoopVerts / cyl sample).
        // Digon 4-rim fillet then showed open seams: coincident xyz, different
        // indices. Weld by position so shared edges exist twice.
        IfCondition GreaterThan(vert_count, 0) ThenBlock: {
            CAD_Tess.WeldMesh(CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.pack)
            pack = CAD_Tess_State.pack
            vert_count = ArrayGet(pack, 0)
            tri_count = ArrayGet(pack, 1)
        }
        ArraySet(out_mesh_addr, 0, vert_count)
        ArraySet(out_mesh_addr, 1, tri_count)
        ArraySet(out_mesh_addr, 2, CAD_Tess_State.v_base)
        ArraySet(out_mesh_addr, 3, CAD_Tess_State.i_base)
        ArraySet(out_mesh_addr, 4, 2097152)
        ArraySet(out_mesh_addr, 5, 1048576)
        CAD_Tess_State.tess_count = Add(CAD_Tess_State.tess_count, 1)
        CAD_Tess_State.triangle_count = tri_count
        CAD_Tess_State.vertex_count = vert_count
        ReturnValue(tri_count)
    }
}

// Collapse verts with the same xyz so adjacent faces share indices.
// pack: [nv, nt] in/out. Leaves unused verts in the slab.
Function.CAD_Tess.WeldMesh {
    Input: v_base: Address
    Input: i_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        nv = ArrayGet(pack_addr, 0)
        nt = ArrayGet(pack_addr, 1)
        IfCondition LessThan(nv, 2) ThenBlock: { ReturnValue(nt) }
        IfCondition GreaterThan(nv, 8192) ThenBlock: { ReturnValue(nt) }
        // (0.02 mm)² — tighter than tess step, looser than noise
        eps2 = 0x3F147AE147AE147B
        map = Allocate(65536)
        i = 0
        WhileLoop LessThan(i, nv) {
            ArraySet(map, i, i)
            xi = ArrayGet(v_base, Multiply(i, 3))
            yi = ArrayGet(v_base, Add(Multiply(i, 3), 1))
            zi = ArrayGet(v_base, Add(Multiply(i, 3), 2))
            j = 0
            WhileLoop LessThan(j, i) {
                IfCondition EqualTo(ArrayGet(map, j), j) ThenBlock: {
                    dx = Float_Sub(xi, ArrayGet(v_base, Multiply(j, 3)))
                    dy = Float_Sub(yi, ArrayGet(v_base, Add(Multiply(j, 3), 1)))
                    dz = Float_Sub(zi, ArrayGet(v_base, Add(Multiply(j, 3), 2)))
                    d2 = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d2, eps2)), 1) ThenBlock: {
                        ArraySet(map, i, j)
                        j = i
                    }
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        t = 0
        w = 0
        WhileLoop LessThan(t, nt) {
            a = ArrayGet(map, ArrayGet(i_base, Multiply(t, 3)))
            b = ArrayGet(map, ArrayGet(i_base, Add(Multiply(t, 3), 1)))
            c = ArrayGet(map, ArrayGet(i_base, Add(Multiply(t, 3), 2)))
            ok = 1
            IfCondition EqualTo(a, b) ThenBlock: { ok = 0 }
            IfCondition EqualTo(b, c) ThenBlock: { ok = 0 }
            IfCondition EqualTo(c, a) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                ArraySet(i_base, Multiply(w, 3), a)
                ArraySet(i_base, Add(Multiply(w, 3), 1), b)
                ArraySet(i_base, Add(Multiply(w, 3), 2), c)
                w = Add(w, 1)
            }
            t = Add(t, 1)
        }
        ArraySet(pack_addr, 1, w)
        nw = 0
        i = 0
        WhileLoop LessThan(i, nv) {
            IfCondition NotEqual(ArrayGet(map, i), i) ThenBlock: { nw = Add(nw, 1) }
            i = Add(i, 1)
        }
        ArraySet(pack_addr, 2, nw)
        IfCondition LessThan(nv, 400) ThenBlock: {
            PrintMessage("weld n=")
            PrintNumber(nw)
            PrintMessage(" nt=")
            PrintNumber(w)
            PrintMessage("\n")
        }
        Deallocate(map, 65536)
        ReturnValue(w)
    }
}

// Watertight check: every undirected edge appears exactly twice.
// FreeCAD has no easy UI for this — use this gate / demo print.
// Returns 1 closed, 0 open/non-manifold. O(n_tris^2) simple scan (fine for CAD demos).
Function.CAD_Tess.VerifyWatertight {
    Input: mesh_addr: Address
    Output: Integer
    Body: {
        n_tris = ArrayGet(mesh_addr, 1)
        i_base = ArrayGet(mesh_addr, 3)
        IfCondition LessThan(n_tris, 4) ThenBlock: { ReturnValue(0) }
        // pack edges as min*65536+max into a buffer, count
        // max edges 3*n_tris
        ebuf = Allocate(65536)
        ecnt = Allocate(65536)
        ne = 0
        t = 0
        WhileLoop LessThan(t, n_tris) {
            io = Multiply(t, 3)
            a = ArrayGet(i_base, io)
            b = ArrayGet(i_base, Add(io, 1))
            c = ArrayGet(i_base, Add(io, 2))
            // three edges
            k = 0
            WhileLoop LessThan(k, 3) {
                IfCondition EqualTo(k, 0) ThenBlock: {
                    u = a
                    v = b
                }
                IfCondition EqualTo(k, 1) ThenBlock: {
                    u = b
                    v = c
                }
                IfCondition EqualTo(k, 2) ThenBlock: {
                    u = c
                    v = a
                }
                IfCondition GreaterThan(u, v) ThenBlock: {
                    tmp = u
                    u = v
                    v = tmp
                }
                key = Add(Multiply(u, 65536), v)
                found = 0
                j = 0
                WhileLoop LessThan(j, ne) {
                    IfCondition EqualTo(ArrayGet(ebuf, j), key) ThenBlock: {
                        ArraySet(ecnt, j, Add(ArrayGet(ecnt, j), 1))
                        found = 1
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    ArraySet(ebuf, ne, key)
                    ArraySet(ecnt, ne, 1)
                    ne = Add(ne, 1)
                }
                k = Add(k, 1)
            }
            t = Add(t, 1)
        }
        ok = 1
        j = 0
        WhileLoop LessThan(j, ne) {
            IfCondition NotEqual(ArrayGet(ecnt, j), 2) ThenBlock: { ok = 0 }
            j = Add(j, 1)
        }
        Deallocate(ebuf, 65536)
        Deallocate(ecnt, 65536)
        ReturnValue(ok)
    }
}

// Export ASCII STL from mesh buffer
Function.CAD_Tess.ExportMeshSTL {
    Input: mesh_addr: Address
    Input: filename_addr: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, filename_addr, 577, 438)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-16)
        }
        n_tris = ArrayGet(mesh_addr, 1)
        v_base = ArrayGet(mesh_addr, 2)
        i_base = ArrayGet(mesh_addr, 3)
        CAD_Tess.WriteStr(fd, "solid AILang_CAD\n")
        tri = Allocate(96)
        t = 0
        zero = 0x0000000000000000
        WhileLoop LessThan(t, n_tris) {
            io = Multiply(t, 3)
            i0 = ArrayGet(i_base, io)
            i1 = ArrayGet(i_base, Add(io, 1))
            i2 = ArrayGet(i_base, Add(io, 2))
            // copy verts
            b0 = Multiply(i0, 3)
            b1 = Multiply(i1, 3)
            b2 = Multiply(i2, 3)
            ArraySet(tri, 0, ArrayGet(v_base, b0))
            ArraySet(tri, 1, ArrayGet(v_base, Add(b0, 1)))
            ArraySet(tri, 2, ArrayGet(v_base, Add(b0, 2)))
            ArraySet(tri, 3, ArrayGet(v_base, b1))
            ArraySet(tri, 4, ArrayGet(v_base, Add(b1, 1)))
            ArraySet(tri, 5, ArrayGet(v_base, Add(b1, 2)))
            ArraySet(tri, 6, ArrayGet(v_base, b2))
            ArraySet(tri, 7, ArrayGet(v_base, Add(b2, 1)))
            ArraySet(tri, 8, ArrayGet(v_base, Add(b2, 2)))
            // normal = (v1-v0) × (v2-v0) simplified: write 0 0 0 and let FreeCAD recompute
            CAD_Tess.WriteFacet(fd, zero, zero, zero, tri)
            t = Add(t, 1)
        }
        CAD_Tess.WriteStr(fd, "endsolid AILang_CAD\n")
        Deallocate(tri, 96)
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }
}

// Legacy signature: mesh then write (still ≤3 args if we drop deflection default)
Function.CAD_Tess.ExportSTL {
    Input: solid_handle: Integer
    Input: filename_addr: Address
    Output: Integer
    Body: {
        mesh = Allocate(48)
        n = CAD_Tess.MeshSolid(solid_handle, 0, mesh)
        IfCondition LessThan(n, 1) ThenBlock: {
            Deallocate(mesh, 48)
            ReturnValue(-1)
        }
        rc = CAD_Tess.ExportMeshSTL(mesh, filename_addr)
        Deallocate(mesh, 48)
        ReturnValue(rc)
    }
}
