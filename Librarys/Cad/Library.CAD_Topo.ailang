// CAD Kernel — Layer 2: CAD.Topo — Radial-edge / half-edge B-Rep over CAD_Store
// Tags: 1=Vertex 2=Edge 3=Coedge 4=Loop 5=Face 6=Shell 7=Solid
// Import: LibraryImport.Cad.CAD_Topo

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

// Vertex stride 4:  x y z edge_use
// Edge   stride 6:  v0 v1 curve coedge_a coedge_b unused
// Coedge stride 8:  edge twin next prev loop origin sense unused
// Loop   stride 4:  coedge_head face next_loop unused
// Face   stride 6:  surface outer_loop shell next_face unused unused
// Shell  stride 4:  face_head solid next_shell unused
// Solid  stride 4:  shell_head  params_or0  oz_or0  kind
//   kind 0 = general poly (shell topology; translate walks verts)
//   kind 1 = exact cylinder: [1]=params (r,h,ox,oy,oz,0,0,0)
//   kind 2 = cylinder prism: same params layout
//   kind 3 = box with hole: [1]=params stride 10
//     0 dx,1 dy,2 dz,3 hole_r,4 cx,5 cy,6 ox,7 oy,8 hole_depth,9 unused
//     (+ plate oz in solid[2]). hole_depth >= dz ⇒ through; else blind from top.
//   kind 4 = sphere: [1]=params (r, cx, cy, cz, 0,0,0,0)
// curve/surface = CAD_Geom handles (tag 0x10 / 0x11), not null

FixedPool.CAD_Topo_State {
    "vertex_count": Initialize=0
    "edge_count":   Initialize=0
    "coedge_count": Initialize=0
    "loop_count":   Initialize=0
    "face_count":   Initialize=0
    "shell_count":  Initialize=0
    "solid_count":  Initialize=0
}

// -------------------------------------------------------------------------
// Constructors — allocate + write fields
// -------------------------------------------------------------------------

Function.CAD_Topo.MakeVertex {
    Input: point_addr: Address
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(1, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, ArrayGet(point_addr, 0))
        CAD_Store.Write(h, 1, ArrayGet(point_addr, 1))
        CAD_Store.Write(h, 2, ArrayGet(point_addr, 2))
        CAD_Store.Write(h, 3, 0)
        CAD_Topo_State.vertex_count = Add(CAD_Topo_State.vertex_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeEdge {
    Input: v0_handle: Integer
    Input: v1_handle: Integer
    Input: curve_handle: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(2, 6)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, v0_handle)
        CAD_Store.Write(h, 1, v1_handle)
        CAD_Store.Write(h, 2, curve_handle)
        CAD_Store.Write(h, 3, 0)
        CAD_Store.Write(h, 4, 0)
        CAD_Store.Write(h, 5, 0)
        CAD_Topo_State.edge_count = Add(CAD_Topo_State.edge_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeCoedge {
    Input: edge_handle: Integer
    Input: origin_v: Integer
    Input: sense: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(3, 8)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, edge_handle)
        CAD_Store.Write(h, 1, 0)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, 0)
        CAD_Store.Write(h, 4, 0)
        CAD_Store.Write(h, 5, origin_v)
        CAD_Store.Write(h, 6, sense)
        CAD_Store.Write(h, 7, 0)
        CAD_Topo_State.coedge_count = Add(CAD_Topo_State.coedge_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeLoop {
    Input: coedge_head: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(4, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, coedge_head)
        CAD_Store.Write(h, 1, 0)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, 0)
        CAD_Topo_State.loop_count = Add(CAD_Topo_State.loop_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeFace {
    Input: surface_handle: Integer
    Input: loop_handle: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(5, 6)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, surface_handle)
        CAD_Store.Write(h, 1, loop_handle)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, 0)
        CAD_Store.Write(h, 4, 0)
        CAD_Store.Write(h, 5, 0)
        IfCondition NotEqual(loop_handle, 0) ThenBlock: {
            CAD_Store.Write(loop_handle, 1, h)
        }
        CAD_Topo_State.face_count = Add(CAD_Topo_State.face_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeShell {
    Input: initial_face: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(6, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, initial_face)
        CAD_Store.Write(h, 1, 0)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, 0)
        IfCondition NotEqual(initial_face, 0) ThenBlock: {
            CAD_Store.Write(initial_face, 2, h)
        }
        CAD_Topo_State.shell_count = Add(CAD_Topo_State.shell_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeSolid {
    Input: shell_handle: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(7, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, shell_handle)
        CAD_Store.Write(h, 1, 0)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, 0)
        IfCondition NotEqual(shell_handle, 0) ThenBlock: {
            CAD_Store.Write(shell_handle, 1, h)
        }
        CAD_Topo_State.solid_count = Add(CAD_Topo_State.solid_count, 1)
        ReturnValue(h)
    }
}

// -------------------------------------------------------------------------
// Accessors
// -------------------------------------------------------------------------

Function.CAD_Topo.VertexGetPoint {
    Input: v_handle: Integer
    Input: out_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store.IsLive(v_handle), 0) ThenBlock: { ReturnValue(-3) }
        ArraySet(out_addr, 0, CAD_Store.Read(v_handle, 0))
        ArraySet(out_addr, 1, CAD_Store.Read(v_handle, 1))
        ArraySet(out_addr, 2, CAD_Store.Read(v_handle, 2))
        ReturnValue(0)
    }
}

Function.CAD_Topo.EdgeGetV0 {
    Input: e_handle: Integer
    Output: Integer
    Body: { ReturnValue(CAD_Store.Read(e_handle, 0)) }
}

Function.CAD_Topo.EdgeGetV1 {
    Input: e_handle: Integer
    Output: Integer
    Body: { ReturnValue(CAD_Store.Read(e_handle, 1)) }
}

Function.CAD_Topo.CoedgeNext {
    Input: ce: Integer
    Output: Integer
    Body: { ReturnValue(CAD_Store.Read(ce, 2)) }
}

Function.CAD_Topo.CoedgeTwin {
    Input: ce: Integer
    Output: Integer
    Body: { ReturnValue(CAD_Store.Read(ce, 1)) }
}

// Wire two coedges as twins
Function.CAD_Topo.LinkTwins {
    Input: ce_a: Integer
    Input: ce_b: Integer
    Output: Integer
    Body: {
        CAD_Store.Write(ce_a, 1, ce_b)
        CAD_Store.Write(ce_b, 1, ce_a)
        ReturnValue(0)
    }
}

// Circular next/prev for a ring of n coedges in array ce_arr[0..n-1]
Function.CAD_Topo.LinkLoopRing {
    Input: ce_arr: Address
    Input: n: Integer
    Input: loop_h: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(-4) }
        i = 0
        WhileLoop LessThan(i, n) {
            ce = ArrayGet(ce_arr, i)
            nxt = ArrayGet(ce_arr, Modulo(Add(i, 1), n))
            prv = ArrayGet(ce_arr, Modulo(Add(i, Subtract(n, 1)), n))
            CAD_Store.Write(ce, 2, nxt)
            CAD_Store.Write(ce, 3, prv)
            CAD_Store.Write(ce, 4, loop_h)
            i = Add(i, 1)
        }
        CAD_Store.Write(loop_h, 0, ArrayGet(ce_arr, 0))
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Euler operators
// -------------------------------------------------------------------------

// MVFS: empty solid = 1 vertex, 1 face (empty loop), 1 shell, 1 solid
// Returns solid handle; writes v,f,s to out addresses
Function.CAD_Topo.MVFS {
    Input: point_addr: Address
    Input: out_v_addr: Address
    Input: out_f_addr: Address
    Input: out_s_addr: Address
    Output: Integer
    Body: {
        h_v = CAD_Topo.MakeVertex(point_addr)
        h_l = CAD_Topo.MakeLoop(0)
        h_f = CAD_Topo.MakeFace(0, h_l)
        h_sh = CAD_Topo.MakeShell(h_f)
        h_so = CAD_Topo.MakeSolid(h_sh)
        ArraySet(out_v_addr, 0, h_v)
        ArraySet(out_f_addr, 0, h_f)
        ArraySet(out_s_addr, 0, h_so)
        ReturnValue(h_so)
    }
}

// MEV: split from v_start — new vertex + edge + two coedges (not yet in face loop)
Function.CAD_Topo.MEV {
    Input: v_start: Integer
    Input: new_point_addr: Address
    Input: out_v_addr: Address
    Input: out_e_addr: Address
    Output: Integer
    Body: {
        h_v = CAD_Topo.MakeVertex(new_point_addr)
        h_e = CAD_Topo.MakeEdge(v_start, h_v, 0)
        ce0 = CAD_Topo.MakeCoedge(h_e, v_start, 1)
        ce1 = CAD_Topo.MakeCoedge(h_e, h_v, 0)
        CAD_Topo.LinkTwins(ce0, ce1)
        CAD_Store.Write(h_e, 3, ce0)
        CAD_Store.Write(h_e, 4, ce1)
        ArraySet(out_v_addr, 0, h_v)
        ArraySet(out_e_addr, 0, h_e)
        ReturnValue(0)
    }
}

// MEF: connect v1..v2 with edge, create new face (caller supplies existing face for context)
Function.CAD_Topo.MEF {
    Input: v1_handle: Integer
    Input: v2_handle: Integer
    Input: in_face: Integer
    Input: out_e_addr: Address
    Input: out_f_addr: Address
    Output: Integer
    Body: {
        h_e = CAD_Topo.MakeEdge(v1_handle, v2_handle, 0)
        ce0 = CAD_Topo.MakeCoedge(h_e, v1_handle, 1)
        ce1 = CAD_Topo.MakeCoedge(h_e, v2_handle, 0)
        CAD_Topo.LinkTwins(ce0, ce1)
        CAD_Store.Write(h_e, 3, ce0)
        CAD_Store.Write(h_e, 4, ce1)

        h_l = CAD_Topo.MakeLoop(ce0)
        CAD_Store.Write(ce0, 2, ce0)
        CAD_Store.Write(ce0, 3, ce0)
        CAD_Store.Write(ce0, 4, h_l)
        CAD_Store.Write(ce1, 2, ce1)
        CAD_Store.Write(ce1, 3, ce1)

        h_f = CAD_Topo.MakeFace(0, h_l)
        // chain face after in_face if present
        IfCondition NotEqual(in_face, 0) ThenBlock: {
            nxt = CAD_Store.Read(in_face, 3)
            CAD_Store.Write(h_f, 3, nxt)
            CAD_Store.Write(in_face, 3, h_f)
            sh = CAD_Store.Read(in_face, 2)
            CAD_Store.Write(h_f, 2, sh)
        }

        ArraySet(out_e_addr, 0, h_e)
        ArraySet(out_f_addr, 0, h_f)
        ReturnValue(0)
    }
}

// Build a unit triangle solid: 3 verts, 3 edges, 1 outer loop, 1 face, shell, solid
// pts: 3 consecutive xyz (9 doubles) at pts_addr
Function.CAD_Topo.MakeTriangleSolid {
    Input: pts_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        p0 = Allocate(32)
        p1 = Allocate(32)
        p2 = Allocate(32)
        ArraySet(p0, 0, ArrayGet(pts_addr, 0))
        ArraySet(p0, 1, ArrayGet(pts_addr, 1))
        ArraySet(p0, 2, ArrayGet(pts_addr, 2))
        ArraySet(p1, 0, ArrayGet(pts_addr, 3))
        ArraySet(p1, 1, ArrayGet(pts_addr, 4))
        ArraySet(p1, 2, ArrayGet(pts_addr, 5))
        ArraySet(p2, 0, ArrayGet(pts_addr, 6))
        ArraySet(p2, 1, ArrayGet(pts_addr, 7))
        ArraySet(p2, 2, ArrayGet(pts_addr, 8))

        v0 = CAD_Topo.MakeVertex(p0)
        v1 = CAD_Topo.MakeVertex(p1)
        v2 = CAD_Topo.MakeVertex(p2)

        e01 = CAD_Topo.MakeEdge(v0, v1, 0)
        e12 = CAD_Topo.MakeEdge(v1, v2, 0)
        e20 = CAD_Topo.MakeEdge(v2, v0, 0)

        // outer coedges around face (CCW): 0->1->2->0
        c01 = CAD_Topo.MakeCoedge(e01, v0, 1)
        c12 = CAD_Topo.MakeCoedge(e12, v1, 1)
        c20 = CAD_Topo.MakeCoedge(e20, v2, 1)
        // mates (opposite sense)
        c10 = CAD_Topo.MakeCoedge(e01, v1, 0)
        c21 = CAD_Topo.MakeCoedge(e12, v2, 0)
        c02 = CAD_Topo.MakeCoedge(e20, v0, 0)
        CAD_Topo.LinkTwins(c01, c10)
        CAD_Topo.LinkTwins(c12, c21)
        CAD_Topo.LinkTwins(c20, c02)

        CAD_Store.Write(e01, 3, c01)
        CAD_Store.Write(e01, 4, c10)
        CAD_Store.Write(e12, 3, c12)
        CAD_Store.Write(e12, 4, c21)
        CAD_Store.Write(e20, 3, c20)
        CAD_Store.Write(e20, 4, c02)

        ring = Allocate(32)
        ArraySet(ring, 0, c01)
        ArraySet(ring, 1, c12)
        ArraySet(ring, 2, c20)
        h_l = CAD_Topo.MakeLoop(c01)
        CAD_Topo.LinkLoopRing(ring, 3, h_l)

        h_f = CAD_Topo.MakeFace(0, h_l)
        h_sh = CAD_Topo.MakeShell(h_f)
        h_so = CAD_Topo.MakeSolid(h_sh)

        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(p0, 32)
        Deallocate(p1, 32)
        Deallocate(p2, 32)
        Deallocate(ring, 32)
        ReturnValue(h_so)
    }
}

// Axis-aligned box [min,max]. Closed: V=8 E=12 F=6 → Euler 2.
// Outward face loops; each coedge used exactly once.
Function.CAD_Topo.MakeBoxSolid {
    Input: min_addr: Address
    Input: max_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        x0 = ArrayGet(min_addr, 0)
        y0 = ArrayGet(min_addr, 1)
        z0 = ArrayGet(min_addr, 2)
        x1 = ArrayGet(max_addr, 0)
        y1 = ArrayGet(max_addr, 1)
        z1 = ArrayGet(max_addr, 2)

        pt = Allocate(32)
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        v0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v3 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z1)
        v4 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v5 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v6 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v7 = CAD_Topo.MakeVertex(pt)

        // Line curves between box corners (p0, p1 scratch in pt / p1b)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)

        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z0)
        ln01 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        ln12 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        ln23 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        ln30 = CAD_Geom.MakeLine(pt, p1b)

        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z1)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z1)
        ln45 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        ln56 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        ln67 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        ln74 = CAD_Geom.MakeLine(pt, p1b)

        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(p1b, 0, x0)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z1)
        ln04 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 0, x1)
        ln15 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 1, y1)
        ln26 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 0, x0)
        ln37 = CAD_Geom.MakeLine(pt, p1b)

        e01 = CAD_Topo.MakeEdge(v0, v1, ln01)
        e12 = CAD_Topo.MakeEdge(v1, v2, ln12)
        e23 = CAD_Topo.MakeEdge(v2, v3, ln23)
        e30 = CAD_Topo.MakeEdge(v3, v0, ln30)
        e45 = CAD_Topo.MakeEdge(v4, v5, ln45)
        e56 = CAD_Topo.MakeEdge(v5, v6, ln56)
        e67 = CAD_Topo.MakeEdge(v6, v7, ln67)
        e74 = CAD_Topo.MakeEdge(v7, v4, ln74)
        e04 = CAD_Topo.MakeEdge(v0, v4, ln04)
        e15 = CAD_Topo.MakeEdge(v1, v5, ln15)
        e26 = CAD_Topo.MakeEdge(v2, v6, ln26)
        e37 = CAD_Topo.MakeEdge(v3, v7, ln37)

        c01 = CAD_Topo.MakeCoedge(e01, v0, 1)
        c10 = CAD_Topo.MakeCoedge(e01, v1, 0)
        CAD_Topo.LinkTwins(c01, c10)
        CAD_Store.Write(e01, 3, c01)
        CAD_Store.Write(e01, 4, c10)
        c12 = CAD_Topo.MakeCoedge(e12, v1, 1)
        c21 = CAD_Topo.MakeCoedge(e12, v2, 0)
        CAD_Topo.LinkTwins(c12, c21)
        CAD_Store.Write(e12, 3, c12)
        CAD_Store.Write(e12, 4, c21)
        c23 = CAD_Topo.MakeCoedge(e23, v2, 1)
        c32 = CAD_Topo.MakeCoedge(e23, v3, 0)
        CAD_Topo.LinkTwins(c23, c32)
        CAD_Store.Write(e23, 3, c23)
        CAD_Store.Write(e23, 4, c32)
        c30 = CAD_Topo.MakeCoedge(e30, v3, 1)
        c03 = CAD_Topo.MakeCoedge(e30, v0, 0)
        CAD_Topo.LinkTwins(c30, c03)
        CAD_Store.Write(e30, 3, c30)
        CAD_Store.Write(e30, 4, c03)
        c45 = CAD_Topo.MakeCoedge(e45, v4, 1)
        c54 = CAD_Topo.MakeCoedge(e45, v5, 0)
        CAD_Topo.LinkTwins(c45, c54)
        CAD_Store.Write(e45, 3, c45)
        CAD_Store.Write(e45, 4, c54)
        c56 = CAD_Topo.MakeCoedge(e56, v5, 1)
        c65 = CAD_Topo.MakeCoedge(e56, v6, 0)
        CAD_Topo.LinkTwins(c56, c65)
        CAD_Store.Write(e56, 3, c56)
        CAD_Store.Write(e56, 4, c65)
        c67 = CAD_Topo.MakeCoedge(e67, v6, 1)
        c76 = CAD_Topo.MakeCoedge(e67, v7, 0)
        CAD_Topo.LinkTwins(c67, c76)
        CAD_Store.Write(e67, 3, c67)
        CAD_Store.Write(e67, 4, c76)
        c74 = CAD_Topo.MakeCoedge(e74, v7, 1)
        c47 = CAD_Topo.MakeCoedge(e74, v4, 0)
        CAD_Topo.LinkTwins(c74, c47)
        CAD_Store.Write(e74, 3, c74)
        CAD_Store.Write(e74, 4, c47)
        c04 = CAD_Topo.MakeCoedge(e04, v0, 1)
        c40 = CAD_Topo.MakeCoedge(e04, v4, 0)
        CAD_Topo.LinkTwins(c04, c40)
        CAD_Store.Write(e04, 3, c04)
        CAD_Store.Write(e04, 4, c40)
        c15 = CAD_Topo.MakeCoedge(e15, v1, 1)
        c51 = CAD_Topo.MakeCoedge(e15, v5, 0)
        CAD_Topo.LinkTwins(c15, c51)
        CAD_Store.Write(e15, 3, c15)
        CAD_Store.Write(e15, 4, c51)
        c26 = CAD_Topo.MakeCoedge(e26, v2, 1)
        c62 = CAD_Topo.MakeCoedge(e26, v6, 0)
        CAD_Topo.LinkTwins(c26, c62)
        CAD_Store.Write(e26, 3, c26)
        CAD_Store.Write(e26, 4, c62)
        c37 = CAD_Topo.MakeCoedge(e37, v3, 1)
        c73 = CAD_Topo.MakeCoedge(e37, v7, 0)
        CAD_Topo.LinkTwins(c37, c73)
        CAD_Store.Write(e37, 3, c37)
        CAD_Store.Write(e37, 4, c73)

        ring = Allocate(64)
        one = 0x3FF0000000000000
        neg1 = 0xBFF0000000000000
        zro = 0x0000000000000000

        // bot -Z outward: O=(x0,y0,z0) X=+X Y=-Y → N=-Z
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        s0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c03)
        ArraySet(ring, 1, c32)
        ArraySet(ring, 2, c21)
        ArraySet(ring, 3, c10)
        l0 = CAD_Topo.MakeLoop(c03)
        CAD_Topo.LinkLoopRing(ring, 4, l0)
        f0 = CAD_Topo.MakeFace(s0, l0)

        // top +Z: O=(x0,y0,z1) X=+X Y=+Y → N=+Z
        ArraySet(pt, 2, z1)
        ArraySet(ay, 1, one)
        s1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c45)
        ArraySet(ring, 1, c56)
        ArraySet(ring, 2, c67)
        ArraySet(ring, 3, c74)
        l1 = CAD_Topo.MakeLoop(c45)
        CAD_Topo.LinkLoopRing(ring, 4, l1)
        f1 = CAD_Topo.MakeFace(s1, l1)

        // front -Y: O=(x0,y0,z0) X=+X Y=+Z → N=-Y
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        s2 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c01)
        ArraySet(ring, 1, c15)
        ArraySet(ring, 2, c54)
        ArraySet(ring, 3, c40)
        l2 = CAD_Topo.MakeLoop(c01)
        CAD_Topo.LinkLoopRing(ring, 4, l2)
        f2 = CAD_Topo.MakeFace(s2, l2)

        // back +Y: O=(x0,y1,z0) X=-X Y=+Z → N=+Y
        ArraySet(pt, 1, y1)
        ArraySet(ax, 0, neg1)
        s3 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c37)
        ArraySet(ring, 1, c76)
        ArraySet(ring, 2, c62)
        ArraySet(ring, 3, c23)
        l3 = CAD_Topo.MakeLoop(c37)
        CAD_Topo.LinkLoopRing(ring, 4, l3)
        f3 = CAD_Topo.MakeFace(s3, l3)

        // left -X: O=(x0,y0,z0) X=-Y Y=+Z → N=-X
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(ax, 0, zro)
        ArraySet(ax, 1, neg1)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        s4 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c04)
        ArraySet(ring, 1, c47)
        ArraySet(ring, 2, c73)
        ArraySet(ring, 3, c30)
        l4 = CAD_Topo.MakeLoop(c04)
        CAD_Topo.LinkLoopRing(ring, 4, l4)
        f4 = CAD_Topo.MakeFace(s4, l4)

        // right +X: O=(x1,y0,z0) X=+Y Y=+Z → N=+X
        ArraySet(pt, 0, x1)
        ArraySet(ax, 1, one)
        s5 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c12)
        ArraySet(ring, 1, c26)
        ArraySet(ring, 2, c65)
        ArraySet(ring, 3, c51)
        l5 = CAD_Topo.MakeLoop(c12)
        CAD_Topo.LinkLoopRing(ring, 4, l5)
        f5 = CAD_Topo.MakeFace(s5, l5)

        CAD_Store.Write(f0, 3, f1)
        CAD_Store.Write(f1, 3, f2)
        CAD_Store.Write(f2, 3, f3)
        CAD_Store.Write(f3, 3, f4)
        CAD_Store.Write(f4, 3, f5)
        CAD_Store.Write(f5, 3, 0)

        h_sh = CAD_Topo.MakeShell(f0)
        CAD_Store.Write(f1, 2, h_sh)
        CAD_Store.Write(f2, 2, h_sh)
        CAD_Store.Write(f3, 2, h_sh)
        CAD_Store.Write(f4, 2, h_sh)
        CAD_Store.Write(f5, 2, h_sh)

        h_so = CAD_Topo.MakeSolid(h_sh)
        // kind 0 = general poly (walk STEP)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 64)
        ReturnValue(h_so)
    }
}

// Exact right cylinder B-Rep (honest kernel solid):
// V=2 seam verts, E=3 (CIRCLE bot/top + LINE generator), F=3 (planes + cyl).
// Euler 2-3+3=2. Tess samples surfaces; STEP uses analytic path (kind=1).
// Axis +Z, bottom center origin, radius/height doubles.
Function.CAD_Topo.MakeCylinderSolid {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        one = 0x3FF0000000000000
        zro = 0x0000000000000000
        neg1 = 0xBFF0000000000000
        pt = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        frame = Allocate(128)
        ring = Allocate(64)

        // Seam verts on +X
        ArraySet(pt, 0, radius_r)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        vb = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 2, height_r)
        vt = CAD_Topo.MakeVertex(pt)

        // Geom: circles, cylinder, planes
        ArraySet(frame, 0, zro)
        ArraySet(frame, 1, zro)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 3, one)
        ArraySet(frame, 4, zro)
        ArraySet(frame, 5, zro)
        ArraySet(frame, 6, zro)
        ArraySet(frame, 7, one)
        ArraySet(frame, 8, zro)
        circ_bot = CAD_Geom.MakeCircle(frame, radius_r)
        ArraySet(frame, 2, height_r)
        circ_top = CAD_Geom.MakeCircle(frame, radius_r)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 9, zro)
        ArraySet(frame, 10, zro)
        ArraySet(frame, 11, one)
        cyl_s = CAD_Geom.MakeCylinderSurf(frame, radius_r)

        ArraySet(pt, 0, zro)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, height_r)
        ArraySet(ay, 1, one)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)

        // Edges: closed circles (v0==v1) + generator
        eb = CAD_Topo.MakeEdge(vb, vb, circ_bot)
        et = CAD_Topo.MakeEdge(vt, vt, circ_top)
        ArraySet(pt, 0, radius_r)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, radius_r)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, height_r)
        ln = CAD_Geom.MakeLine(pt, ax)
        es = CAD_Topo.MakeEdge(vb, vt, ln)

        // Coedges: each edge → face pair (side vs cap)
        cb_side = CAD_Topo.MakeCoedge(eb, vb, 1)
        cb_bot = CAD_Topo.MakeCoedge(eb, vb, 0)
        CAD_Topo.LinkTwins(cb_side, cb_bot)
        CAD_Store.Write(eb, 3, cb_side)
        CAD_Store.Write(eb, 4, cb_bot)

        ct_top = CAD_Topo.MakeCoedge(et, vt, 1)
        ct_side = CAD_Topo.MakeCoedge(et, vt, 0)
        CAD_Topo.LinkTwins(ct_top, ct_side)
        CAD_Store.Write(et, 3, ct_top)
        CAD_Store.Write(et, 4, ct_side)

        cs_up = CAD_Topo.MakeCoedge(es, vb, 1)
        cs_dn = CAD_Topo.MakeCoedge(es, vt, 0)
        CAD_Topo.LinkTwins(cs_up, cs_dn)
        CAD_Store.Write(es, 3, cs_up)
        CAD_Store.Write(es, 4, cs_dn)

        // Bottom cap: single reverse circle (outward -Z)
        ArraySet(ring, 0, cb_bot)
        lp_bot = CAD_Topo.MakeLoop(cb_bot)
        CAD_Topo.LinkLoopRing(ring, 1, lp_bot)
        f_bot = CAD_Topo.MakeFace(pl_bot, lp_bot)

        // Top cap: single forward circle
        ArraySet(ring, 0, ct_top)
        lp_top = CAD_Topo.MakeLoop(ct_top)
        CAD_Topo.LinkLoopRing(ring, 1, lp_top)
        f_top = CAD_Topo.MakeFace(pl_top, lp_top)

        // Side: bottom fwd, seam up, top rev, seam down
        ArraySet(ring, 0, cb_side)
        ArraySet(ring, 1, cs_up)
        ArraySet(ring, 2, ct_side)
        ArraySet(ring, 3, cs_dn)
        lp_side = CAD_Topo.MakeLoop(cb_side)
        CAD_Topo.LinkLoopRing(ring, 4, lp_side)
        f_side = CAD_Topo.MakeFace(cyl_s, lp_side)

        CAD_Store.Write(f_bot, 3, f_top)
        CAD_Store.Write(f_top, 3, f_side)
        CAD_Store.Write(f_side, 3, 0)
        CAD_Store.Write(f_bot, 4, circ_bot)
        CAD_Store.Write(f_top, 4, circ_top)

        h_sh = CAD_Topo.MakeShell(f_bot)
        CAD_Store.Write(f_top, 2, h_sh)
        CAD_Store.Write(f_side, 2, h_sh)
        h_so = CAD_Topo.MakeSolid(h_sh)
        // params: r, h, ox, oy, oz
        ph = CAD_Store.Alloc(13, 8)
        CAD_Store.Write(ph, 0, radius_r)
        CAD_Store.Write(ph, 1, height_r)
        CAD_Store.Write(ph, 2, zro)
        CAD_Store.Write(ph, 3, zro)
        CAD_Store.Write(ph, 4, zro)
        CAD_Store.Write(ph, 5, 0)
        CAD_Store.Write(ph, 6, 0)
        CAD_Store.Write(ph, 7, 0)
        CAD_Store.Write(h_so, 1, ph)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 1)
        ArraySet(out_solid_addr, 0, h_so)

        Deallocate(pt, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(frame, 128)
        Deallocate(ring, 64)
        ReturnValue(h_so)
    }
}

// N-gon prism approximation (debug / stress). Prefer MakeCylinderSolid.
// n_seg 4..256. Chord edges; kind still 1 so STEP stays analytic.
Function.CAD_Topo.MakeCylinderPrismSolid {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: n_seg: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        n = n_seg
        IfCondition LessThan(n, 4) ThenBlock: { n = 4 }
        IfCondition GreaterThan(n, 256) ThenBlock: { n = 256 }

        // handle tables: 256 * 8 bytes = 2048
        vb = Allocate(2048)
        vt = Allocate(2048)
        eb = Allocate(2048)
        et = Allocate(2048)
        ev = Allocate(2048)
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        frame = Allocate(128)
        ring = Allocate(2048)

        two_pi = 0x401921FB54442D18
        one = 0x3FF0000000000000
        zro = 0x0000000000000000
        neg1 = 0xBFF0000000000000
        nf = Float_FromInt(n)

        // circle + cylinder analytic surfaces (shared)
        ArraySet(frame, 0, zro)
        ArraySet(frame, 1, zro)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 3, one)
        ArraySet(frame, 4, zro)
        ArraySet(frame, 5, zro)
        ArraySet(frame, 6, zro)
        ArraySet(frame, 7, one)
        ArraySet(frame, 8, zro)
        circ_bot = CAD_Geom.MakeCircle(frame, radius_r)
        ArraySet(frame, 2, height_r)
        circ_top = CAD_Geom.MakeCircle(frame, radius_r)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 9, zro)
        ArraySet(frame, 10, zro)
        ArraySet(frame, 11, one)
        cyl_s = CAD_Geom.MakeCylinderSurf(frame, radius_r)

        // bottom plane -Z, top +Z
        ArraySet(pt, 0, zro)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, height_r)
        ArraySet(ay, 1, one)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)

        // vertices
        i = 0
        WhileLoop LessThan(i, n) {
            ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), nf))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            x = Float_Mul(radius_r, c)
            y = Float_Mul(radius_r, s)
            ArraySet(pt, 0, x)
            ArraySet(pt, 1, y)
            ArraySet(pt, 2, zro)
            ArraySet(vb, i, CAD_Topo.MakeVertex(pt))
            ArraySet(pt, 2, height_r)
            ArraySet(vt, i, CAD_Topo.MakeVertex(pt))
            i = Add(i, 1)
        }

        // edges: bottom, top, vertical (+ line curves)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }

            // bottom chord
            ArraySet(pt, 0, CAD_Store.Read(ArrayGet(vb, i), 0))
            ArraySet(pt, 1, CAD_Store.Read(ArrayGet(vb, i), 1))
            ArraySet(pt, 2, CAD_Store.Read(ArrayGet(vb, i), 2))
            ArraySet(p1b, 0, CAD_Store.Read(ArrayGet(vb, j), 0))
            ArraySet(p1b, 1, CAD_Store.Read(ArrayGet(vb, j), 1))
            ArraySet(p1b, 2, CAD_Store.Read(ArrayGet(vb, j), 2))
            ln = CAD_Geom.MakeLine(pt, p1b)
            ArraySet(eb, i, CAD_Topo.MakeEdge(ArrayGet(vb, i), ArrayGet(vb, j), ln))

            // top chord
            ArraySet(pt, 0, CAD_Store.Read(ArrayGet(vt, i), 0))
            ArraySet(pt, 1, CAD_Store.Read(ArrayGet(vt, i), 1))
            ArraySet(pt, 2, CAD_Store.Read(ArrayGet(vt, i), 2))
            ArraySet(p1b, 0, CAD_Store.Read(ArrayGet(vt, j), 0))
            ArraySet(p1b, 1, CAD_Store.Read(ArrayGet(vt, j), 1))
            ArraySet(p1b, 2, CAD_Store.Read(ArrayGet(vt, j), 2))
            ln = CAD_Geom.MakeLine(pt, p1b)
            ArraySet(et, i, CAD_Topo.MakeEdge(ArrayGet(vt, i), ArrayGet(vt, j), ln))

            // vertical
            ArraySet(pt, 0, CAD_Store.Read(ArrayGet(vb, i), 0))
            ArraySet(pt, 1, CAD_Store.Read(ArrayGet(vb, i), 1))
            ArraySet(pt, 2, zro)
            ArraySet(p1b, 0, ArrayGet(pt, 0))
            ArraySet(p1b, 1, ArrayGet(pt, 1))
            ArraySet(p1b, 2, height_r)
            ln = CAD_Geom.MakeLine(pt, p1b)
            ArraySet(ev, i, CAD_Topo.MakeEdge(ArrayGet(vb, i), ArrayGet(vt, i), ln))
            i = Add(i, 1)
        }

        // Side faces (quads) + coedges. Outward: bot i→j, vert j, top j→i, vert i down
        // coedge scratch tables: we create twins when both sides known
        // For each edge store first coedge in edge slots 3/4 as we go
        first_side = 0
        prev_face = 0
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }

            ebi = ArrayGet(eb, i)
            eti = ArrayGet(et, i)
            evi = ArrayGet(ev, i)
            evj = ArrayGet(ev, j)

            // side coedges (primary sense for this face)
            cb = CAD_Topo.MakeCoedge(ebi, ArrayGet(vb, i), 1)
            cvj = CAD_Topo.MakeCoedge(evj, ArrayGet(vb, j), 1)
            ct = CAD_Topo.MakeCoedge(eti, ArrayGet(vt, j), 0)
            cvi = CAD_Topo.MakeCoedge(evi, ArrayGet(vt, i), 0)

            // mate coedges for radial (will be used by caps / other side)
            // bottom mate used by bottom cap: reverse
            cbm = CAD_Topo.MakeCoedge(ebi, ArrayGet(vb, j), 0)
            CAD_Topo.LinkTwins(cb, cbm)
            CAD_Store.Write(ebi, 3, cb)
            CAD_Store.Write(ebi, 4, cbm)

            ctm = CAD_Topo.MakeCoedge(eti, ArrayGet(vt, i), 1)
            CAD_Topo.LinkTwins(ct, ctm)
            CAD_Store.Write(eti, 3, ct)
            CAD_Store.Write(eti, 4, ctm)

            // vertical: side uses reverse (down); mate is up for... only one side face uses each vertical twice? 
            // Each vertical shared by two side faces only — NOT by caps.
            // Face i uses evi reverse (top→bot); face (i-1) uses evi forward (bot→top)
            // So twins are the two side coedges. Create mate only once — on first creation.
            // When i uses evi reverse, previous face j-1 already created forward on evi as "cvj" of that face.
            // Simpler: create both coedges for verticals in a pre-pass.

            ArraySet(ring, 0, cb)
            ArraySet(ring, 1, cvj)
            ArraySet(ring, 2, ct)
            ArraySet(ring, 3, cvi)
            // vertical twins: deferred — LinkTwins later via stored

            lp = CAD_Topo.MakeLoop(cb)
            CAD_Topo.LinkLoopRing(ring, 4, lp)
            fc = CAD_Topo.MakeFace(cyl_s, lp)
            IfCondition EqualTo(i, 0) ThenBlock: {
                first_side = fc
            }
            IfCondition NotEqual(prev_face, 0) ThenBlock: {
                CAD_Store.Write(prev_face, 3, fc)
            }
            prev_face = fc

            // stash side coedges for vertical twin linking: use edge slot temporarily
            // store forward coedge for vertical i in edge.unused field 5 if free
            // Edge stride 6: 0 v0 1 v1 2 curve 3 coa 4 cob 5 unused
            // For vertical edge: we need both coedges. Face i creates cvi (rev).
            // Face (i-1) creates cvj when j=i which is forward on evi.
            // After all sides, walk and LinkTwins if both set.

            // Save reverse coedge on evi field 4, forward on field 3 when created
            CAD_Store.Write(evi, 4, cvi)
            CAD_Store.Write(evj, 3, cvj)

            i = Add(i, 1)
        }

        // Link vertical twins
        i = 0
        WhileLoop LessThan(i, n) {
            evi = ArrayGet(ev, i)
            ca = CAD_Store.Read(evi, 3)
            cb2 = CAD_Store.Read(evi, 4)
            IfCondition NotEqual(ca, 0) ThenBlock: {
                IfCondition NotEqual(cb2, 0) ThenBlock: {
                    CAD_Topo.LinkTwins(ca, cb2)
                }
            }
            i = Add(i, 1)
        }

        // Bottom cap: outward -Z. Loop uses bottom edge mates (cbm), reverse around
        // For i = 0..n-1: walk edges reverse: edge (n-1-i) mate = from vb[j] to vb[i] when edge i is i→j
        // CCW from below = decreasing index: start at 0, go to n-1, n-2, ...
        // Edge k from k→(k+1)%n. Mate coedge origin is (k+1), sense 0.
        // Chain: ... for k = n-1, n-2, ..., 0: use mate of edge k
        i = 0
        WhileLoop LessThan(i, n) {
            // index of edge in reverse walk: e = n-1-i
            eidx = Subtract(n, Add(i, 1))
            ebi = ArrayGet(eb, eidx)
            // mate is coedge_b (slot 4)
            ArraySet(ring, i, CAD_Store.Read(ebi, 4))
            i = Add(i, 1)
        }
        lp_bot = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n, lp_bot)
        f_bot = CAD_Topo.MakeFace(pl_bot, lp_bot)
        CAD_Store.Write(prev_face, 3, f_bot)
        prev_face = f_bot

        // Top cap: outward +Z, edges forward i=0..n-1 use mate? 
        // Side used ct = reverse on top edge (origin vt[j], sense 0). Mate ctm sense 1 origin vt[i].
        // Top walk CCW from +Z: i → i+1 uses forward on et[i] which is ctm (slot 4)
        i = 0
        WhileLoop LessThan(i, n) {
            eti = ArrayGet(et, i)
            ArraySet(ring, i, CAD_Store.Read(eti, 4))
            i = Add(i, 1)
        }
        lp_top = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n, lp_top)
        f_top = CAD_Topo.MakeFace(pl_top, lp_top)
        CAD_Store.Write(prev_face, 3, f_top)
        CAD_Store.Write(f_top, 3, 0)

        // Attach circle curves as metadata on first bottom/top edge curve field already line;
        // store circle handles on face unused slots 4,5 for export later
        CAD_Store.Write(f_bot, 4, circ_bot)
        CAD_Store.Write(f_top, 4, circ_top)

        h_sh = CAD_Topo.MakeShell(first_side)
        // set shell on all faces
        fx = first_side
        guard = 0
        WhileLoop NotEqual(fx, 0) {
            CAD_Store.Write(fx, 2, h_sh)
            fx = CAD_Store.Read(fx, 3)
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 256) ThenBlock: { fx = 0 }
        }

        h_so = CAD_Topo.MakeSolid(h_sh)
        // kind 2 prism; params r,h,ox,oy,oz for tess/STEP/translate
        ph2 = CAD_Store.Alloc(13, 8)
        CAD_Store.Write(ph2, 0, radius_r)
        CAD_Store.Write(ph2, 1, height_r)
        CAD_Store.Write(ph2, 2, 0)
        CAD_Store.Write(ph2, 3, 0)
        CAD_Store.Write(ph2, 4, 0)
        CAD_Store.Write(ph2, 5, 0)
        CAD_Store.Write(ph2, 6, 0)
        CAD_Store.Write(ph2, 7, 0)
        CAD_Store.Write(h_so, 1, ph2)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 2)
        ArraySet(out_solid_addr, 0, h_so)

        Deallocate(vb, 2048)
        Deallocate(vt, 2048)
        Deallocate(eb, 2048)
        Deallocate(et, 2048)
        Deallocate(ev, 2048)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(frame, 128)
        Deallocate(ring, 2048)
        ReturnValue(h_so)
    }
}

// Box hole solid. pack_addr: [dx,dy,dz, hole_r, cx, cy, hole_depth]
// hole_depth >= dz → through; else blind pocket from top (z=dz down).
Function.CAD_Topo.MakeBoxThroughHole {
    Input: dx_r: Integer
    Input: dy_r: Integer
    Input: dz_r: Integer
    Input: hole_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        // default center + through (depth=dz)
        half = 0x4000000000000000
        cx = Float_Div(dx_r, half)
        cy = Float_Div(dy_r, half)
        pack = Allocate(64)
        ArraySet(pack, 0, dx_r)
        ArraySet(pack, 1, dy_r)
        ArraySet(pack, 2, dz_r)
        ArraySet(pack, 3, hole_r)
        ArraySet(pack, 4, cx)
        ArraySet(pack, 5, cy)
        ArraySet(pack, 6, dz_r)
        h = CAD_Topo.MakeBoxHolePack(pack, out_solid_addr)
        Deallocate(pack, 64)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeBoxHolePack {
    Input: pack_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        dx_r = ArrayGet(pack_addr, 0)
        dy_r = ArrayGet(pack_addr, 1)
        dz_r = ArrayGet(pack_addr, 2)
        hole_r = ArrayGet(pack_addr, 3)
        cx = ArrayGet(pack_addr, 4)
        cy = ArrayGet(pack_addr, 5)
        hdep = ArrayGet(pack_addr, 6)
        IfCondition EqualTo(CAD_Num.IsZero(dx_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(hole_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(hdep, 0), 1) ThenBlock: { hdep = dz_r }
        // clamp depth to plate
        IfCondition EqualTo(Float_Le(dz_r, hdep), 1) ThenBlock: { hdep = dz_r }
        ph = CAD_Store.Alloc(13, 10)
        IfCondition EqualTo(ph, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(ph, 0, dx_r)
        CAD_Store.Write(ph, 1, dy_r)
        CAD_Store.Write(ph, 2, dz_r)
        CAD_Store.Write(ph, 3, hole_r)
        CAD_Store.Write(ph, 4, cx)
        CAD_Store.Write(ph, 5, cy)
        CAD_Store.Write(ph, 6, 0)
        CAD_Store.Write(ph, 7, 0)
        CAD_Store.Write(ph, 8, hdep)
        CAD_Store.Write(ph, 9, 0)
        h_so = CAD_Store.Alloc(7, 4)
        IfCondition EqualTo(h_so, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h_so, 0, 0)
        CAD_Store.Write(h_so, 1, ph)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 3)
        CAD_Topo_State.solid_count = Add(CAD_Topo_State.solid_count, 1)
        ArraySet(out_solid_addr, 0, h_so)
        ReturnValue(h_so)
    }
}

// Sphere radius r at origin (center in params). kind=4. Closed surface sample for tess/STEP.
Function.CAD_Topo.MakeSphereSolid {
    Input: radius_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        ph = CAD_Store.Alloc(13, 8)
        IfCondition EqualTo(ph, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(ph, 0, radius_r)
        CAD_Store.Write(ph, 1, 0)
        CAD_Store.Write(ph, 2, 0)
        CAD_Store.Write(ph, 3, 0)
        CAD_Store.Write(ph, 4, 0)
        CAD_Store.Write(ph, 5, 0)
        CAD_Store.Write(ph, 6, 0)
        CAD_Store.Write(ph, 7, 0)
        h_so = CAD_Store.Alloc(7, 4)
        IfCondition EqualTo(h_so, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h_so, 0, 0)
        CAD_Store.Write(h_so, 1, ph)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 4)
        CAD_Topo_State.solid_count = Add(CAD_Topo_State.solid_count, 1)
        ArraySet(out_solid_addr, 0, h_so)
        ReturnValue(h_so)
    }
}

// Translate solid in place. dxyz_addr: [dx,dy,dz]. Returns 0 ok, -1 fail.
Function.CAD_Topo.TranslateSolid {
    Input: solid_handle: Integer
    Input: dxyz_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        dx = ArrayGet(dxyz_addr, 0)
        dy = ArrayGet(dxyz_addr, 1)
        dz = ArrayGet(dxyz_addr, 2)
        kind = CAD_Store.Read(solid_handle, 3)
        // kind 0: walk all vertices
        IfCondition EqualTo(kind, 0) ThenBlock: {
            shell = CAD_Store.Read(solid_handle, 0)
            IfCondition EqualTo(shell, 0) ThenBlock: { ReturnValue(-1) }
            face = CAD_Store.Read(shell, 0)
            fguard = 0
            WhileLoop NotEqual(face, 0) {
                lp = CAD_Store.Read(face, 1)
                hd = CAD_Store.Read(lp, 0)
                ce = hd
                cdone = 0
                cguard = 0
                WhileLoop EqualTo(cdone, 0) {
                    ov = CAD_Store.Read(ce, 5)
                    CAD_Store.Write(ov, 0, Float_Add(CAD_Store.Read(ov, 0), dx))
                    CAD_Store.Write(ov, 1, Float_Add(CAD_Store.Read(ov, 1), dy))
                    CAD_Store.Write(ov, 2, Float_Add(CAD_Store.Read(ov, 2), dz))
                    ce = CAD_Store.Read(ce, 2)
                    cguard = Add(cguard, 1)
                    IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                    IfCondition GreaterThan(cguard, 64) ThenBlock: { cdone = 1 }
                }
                face = CAD_Store.Read(face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 64) ThenBlock: { face = 0 }
            }
            ReturnValue(0)
        }
        // kind 1/2 cylinder params: ox,oy,oz at 2,3,4
        IfCondition EqualTo(kind, 1) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            CAD_Store.Write(ph, 2, Float_Add(CAD_Store.Read(ph, 2), dx))
            CAD_Store.Write(ph, 3, Float_Add(CAD_Store.Read(ph, 3), dy))
            CAD_Store.Write(ph, 4, Float_Add(CAD_Store.Read(ph, 4), dz))
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            CAD_Store.Write(ph, 2, Float_Add(CAD_Store.Read(ph, 2), dx))
            CAD_Store.Write(ph, 3, Float_Add(CAD_Store.Read(ph, 3), dy))
            CAD_Store.Write(ph, 4, Float_Add(CAD_Store.Read(ph, 4), dz))
            ReturnValue(0)
        }
        // kind 3 plate: ox,oy in params 6,7; oz in solid[2]; hole cx,cy also shift
        IfCondition EqualTo(kind, 3) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            CAD_Store.Write(ph, 4, Float_Add(CAD_Store.Read(ph, 4), dx))
            CAD_Store.Write(ph, 5, Float_Add(CAD_Store.Read(ph, 5), dy))
            CAD_Store.Write(ph, 6, Float_Add(CAD_Store.Read(ph, 6), dx))
            CAD_Store.Write(ph, 7, Float_Add(CAD_Store.Read(ph, 7), dy))
            CAD_Store.Write(solid_handle, 2, Float_Add(CAD_Store.Read(solid_handle, 2), dz))
            ReturnValue(0)
        }
        // kind 4 sphere: center cx,cy,cz at 1,2,3
        IfCondition EqualTo(kind, 4) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            CAD_Store.Write(ph, 1, Float_Add(CAD_Store.Read(ph, 1), dx))
            CAD_Store.Write(ph, 2, Float_Add(CAD_Store.Read(ph, 2), dy))
            CAD_Store.Write(ph, 3, Float_Add(CAD_Store.Read(ph, 3), dz))
            ReturnValue(0)
        }
        ReturnValue(-1)
    }
}

// Count coedges walking next around a loop (guard max 1024)
Function.CAD_Topo.LoopCountCoedges {
    Input: loop_h: Integer
    Output: Integer
    Body: {
        head = CAD_Store.Read(loop_h, 0)
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(0) }
        n = 1
        ce = CAD_Store.Read(head, 2)
        guard = 0
        WhileLoop NotEqual(ce, head) {
            IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(-1) }
            n = Add(n, 1)
            ce = CAD_Store.Read(ce, 2)
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 1024) ThenBlock: { ReturnValue(-1) }
        }
        ReturnValue(n)
    }
}

// Euler-Poincaré: V - E + F == 2*(S - G) + H
// counts_addr: [V, E, F, S, G, H] — 1 Input (SysV-safe)
Function.CAD_Topo.VerifyEulerInvariants {
    Input: counts_addr: Address
    Output: Integer
    Body: {
        num_v = ArrayGet(counts_addr, 0)
        num_e = ArrayGet(counts_addr, 1)
        num_f = ArrayGet(counts_addr, 2)
        num_s = ArrayGet(counts_addr, 3)
        num_g = ArrayGet(counts_addr, 4)
        num_h = ArrayGet(counts_addr, 5)
        lhs = Add(Subtract(num_v, num_e), num_f)
        s_g = Subtract(num_s, num_g)
        rhs = Add(Multiply(2, s_g), num_h)
        IfCondition EqualTo(lhs, rhs) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.Counts {
    Input: out_addr: Address
    Output: Integer
    Body: {
        // out: V E F S solid coedge loop
        ArraySet(out_addr, 0, CAD_Topo_State.vertex_count)
        ArraySet(out_addr, 1, CAD_Topo_State.edge_count)
        ArraySet(out_addr, 2, CAD_Topo_State.face_count)
        ArraySet(out_addr, 3, CAD_Topo_State.shell_count)
        ArraySet(out_addr, 4, CAD_Topo_State.solid_count)
        ArraySet(out_addr, 5, CAD_Topo_State.coedge_count)
        ArraySet(out_addr, 6, CAD_Topo_State.loop_count)
        ReturnValue(0)
    }
}
