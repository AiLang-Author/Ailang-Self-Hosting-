// CAD Kernel — Layer 2: CAD.Topo — Radial-edge / half-edge B-Rep over CAD_Store
// Tags: 1=Vertex 2=Edge 3=Coedge 4=Loop 5=Face 6=Shell 7=Solid
// Import: LibraryImport.Cad.CAD_Topo

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num

// Vertex stride 4:  x y z edge_use
// Edge   stride 6:  v0 v1 curve coedge_a coedge_b unused
// Coedge stride 8:  edge twin next prev loop origin sense unused
// Loop   stride 4:  coedge_head face next_loop unused
// Face   stride 6:  surface outer_loop shell next_face unused unused
// Shell  stride 4:  face_head solid next_shell unused
// Solid  stride 4:  shell_head unused unused unused

FixedPool.CAD_Topo_State {
    "vertex_count": Initialize=0
    "edge_count":   Initialize=0
    "coedge_count": Initialize=0
    "loop_count":   Initialize=0
    "face_count":   Initialize=0
    "shell_count":  Initialize=0
    "solid_count":  Initialize=0
}

// -------------------------------------------------------------------------
// Constructors — allocate + write fields
// -------------------------------------------------------------------------

Function.CAD_Topo.MakeVertex {
    Input: point_addr: Address
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(1, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, ArrayGet(point_addr, 0))
        CAD_Store.Write(h, 1, ArrayGet(point_addr, 1))
        CAD_Store.Write(h, 2, ArrayGet(point_addr, 2))
        CAD_Store.Write(h, 3, 0)
        CAD_Topo_State.vertex_count = Add(CAD_Topo_State.vertex_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeEdge {
    Input: v0_handle: Integer
    Input: v1_handle: Integer
    Input: curve_handle: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(2, 6)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, v0_handle)
        CAD_Store.Write(h, 1, v1_handle)
        CAD_Store.Write(h, 2, curve_handle)
        CAD_Store.Write(h, 3, 0)
        CAD_Store.Write(h, 4, 0)
        CAD_Store.Write(h, 5, 0)
        CAD_Topo_State.edge_count = Add(CAD_Topo_State.edge_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeCoedge {
    Input: edge_handle: Integer
    Input: origin_v: Integer
    Input: sense: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(3, 8)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, edge_handle)
        CAD_Store.Write(h, 1, 0)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, 0)
        CAD_Store.Write(h, 4, 0)
        CAD_Store.Write(h, 5, origin_v)
        CAD_Store.Write(h, 6, sense)
        CAD_Store.Write(h, 7, 0)
        CAD_Topo_State.coedge_count = Add(CAD_Topo_State.coedge_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeLoop {
    Input: coedge_head: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(4, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, coedge_head)
        CAD_Store.Write(h, 1, 0)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, 0)
        CAD_Topo_State.loop_count = Add(CAD_Topo_State.loop_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeFace {
    Input: surface_handle: Integer
    Input: loop_handle: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(5, 6)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, surface_handle)
        CAD_Store.Write(h, 1, loop_handle)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, 0)
        CAD_Store.Write(h, 4, 0)
        CAD_Store.Write(h, 5, 0)
        IfCondition NotEqual(loop_handle, 0) ThenBlock: {
            CAD_Store.Write(loop_handle, 1, h)
        }
        CAD_Topo_State.face_count = Add(CAD_Topo_State.face_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeShell {
    Input: initial_face: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(6, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, initial_face)
        CAD_Store.Write(h, 1, 0)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, 0)
        IfCondition NotEqual(initial_face, 0) ThenBlock: {
            CAD_Store.Write(initial_face, 2, h)
        }
        CAD_Topo_State.shell_count = Add(CAD_Topo_State.shell_count, 1)
        ReturnValue(h)
    }
}

Function.CAD_Topo.MakeSolid {
    Input: shell_handle: Integer
    Output: Integer
    Body: {
        h = CAD_Store.Alloc(7, 4)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h, 0, shell_handle)
        CAD_Store.Write(h, 1, 0)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, 0)
        IfCondition NotEqual(shell_handle, 0) ThenBlock: {
            CAD_Store.Write(shell_handle, 1, h)
        }
        CAD_Topo_State.solid_count = Add(CAD_Topo_State.solid_count, 1)
        ReturnValue(h)
    }
}

// -------------------------------------------------------------------------
// Accessors
// -------------------------------------------------------------------------

Function.CAD_Topo.VertexGetPoint {
    Input: v_handle: Integer
    Input: out_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Store.IsLive(v_handle), 0) ThenBlock: { ReturnValue(-3) }
        ArraySet(out_addr, 0, CAD_Store.Read(v_handle, 0))
        ArraySet(out_addr, 1, CAD_Store.Read(v_handle, 1))
        ArraySet(out_addr, 2, CAD_Store.Read(v_handle, 2))
        ReturnValue(0)
    }
}

Function.CAD_Topo.EdgeGetV0 {
    Input: e_handle: Integer
    Output: Integer
    Body: { ReturnValue(CAD_Store.Read(e_handle, 0)) }
}

Function.CAD_Topo.EdgeGetV1 {
    Input: e_handle: Integer
    Output: Integer
    Body: { ReturnValue(CAD_Store.Read(e_handle, 1)) }
}

Function.CAD_Topo.CoedgeNext {
    Input: ce: Integer
    Output: Integer
    Body: { ReturnValue(CAD_Store.Read(ce, 2)) }
}

Function.CAD_Topo.CoedgeTwin {
    Input: ce: Integer
    Output: Integer
    Body: { ReturnValue(CAD_Store.Read(ce, 1)) }
}

// Wire two coedges as twins
Function.CAD_Topo.LinkTwins {
    Input: ce_a: Integer
    Input: ce_b: Integer
    Output: Integer
    Body: {
        CAD_Store.Write(ce_a, 1, ce_b)
        CAD_Store.Write(ce_b, 1, ce_a)
        ReturnValue(0)
    }
}

// Circular next/prev for a ring of n coedges in array ce_arr[0..n-1]
Function.CAD_Topo.LinkLoopRing {
    Input: ce_arr: Address
    Input: n: Integer
    Input: loop_h: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(-4) }
        i = 0
        WhileLoop LessThan(i, n) {
            ce = ArrayGet(ce_arr, i)
            nxt = ArrayGet(ce_arr, Modulo(Add(i, 1), n))
            prv = ArrayGet(ce_arr, Modulo(Add(i, Subtract(n, 1)), n))
            CAD_Store.Write(ce, 2, nxt)
            CAD_Store.Write(ce, 3, prv)
            CAD_Store.Write(ce, 4, loop_h)
            i = Add(i, 1)
        }
        CAD_Store.Write(loop_h, 0, ArrayGet(ce_arr, 0))
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Euler operators
// -------------------------------------------------------------------------

// MVFS: empty solid = 1 vertex, 1 face (empty loop), 1 shell, 1 solid
// Returns solid handle; writes v,f,s to out addresses
Function.CAD_Topo.MVFS {
    Input: point_addr: Address
    Input: out_v_addr: Address
    Input: out_f_addr: Address
    Input: out_s_addr: Address
    Output: Integer
    Body: {
        h_v = CAD_Topo.MakeVertex(point_addr)
        h_l = CAD_Topo.MakeLoop(0)
        h_f = CAD_Topo.MakeFace(0, h_l)
        h_sh = CAD_Topo.MakeShell(h_f)
        h_so = CAD_Topo.MakeSolid(h_sh)
        ArraySet(out_v_addr, 0, h_v)
        ArraySet(out_f_addr, 0, h_f)
        ArraySet(out_s_addr, 0, h_so)
        ReturnValue(h_so)
    }
}

// MEV: split from v_start — new vertex + edge + two coedges (not yet in face loop)
Function.CAD_Topo.MEV {
    Input: v_start: Integer
    Input: new_point_addr: Address
    Input: out_v_addr: Address
    Input: out_e_addr: Address
    Output: Integer
    Body: {
        h_v = CAD_Topo.MakeVertex(new_point_addr)
        h_e = CAD_Topo.MakeEdge(v_start, h_v, 0)
        ce0 = CAD_Topo.MakeCoedge(h_e, v_start, 1)
        ce1 = CAD_Topo.MakeCoedge(h_e, h_v, 0)
        CAD_Topo.LinkTwins(ce0, ce1)
        CAD_Store.Write(h_e, 3, ce0)
        CAD_Store.Write(h_e, 4, ce1)
        ArraySet(out_v_addr, 0, h_v)
        ArraySet(out_e_addr, 0, h_e)
        ReturnValue(0)
    }
}

// MEF: connect v1..v2 with edge, create new face (caller supplies existing face for context)
Function.CAD_Topo.MEF {
    Input: v1_handle: Integer
    Input: v2_handle: Integer
    Input: in_face: Integer
    Input: out_e_addr: Address
    Input: out_f_addr: Address
    Output: Integer
    Body: {
        h_e = CAD_Topo.MakeEdge(v1_handle, v2_handle, 0)
        ce0 = CAD_Topo.MakeCoedge(h_e, v1_handle, 1)
        ce1 = CAD_Topo.MakeCoedge(h_e, v2_handle, 0)
        CAD_Topo.LinkTwins(ce0, ce1)
        CAD_Store.Write(h_e, 3, ce0)
        CAD_Store.Write(h_e, 4, ce1)

        h_l = CAD_Topo.MakeLoop(ce0)
        CAD_Store.Write(ce0, 2, ce0)
        CAD_Store.Write(ce0, 3, ce0)
        CAD_Store.Write(ce0, 4, h_l)
        CAD_Store.Write(ce1, 2, ce1)
        CAD_Store.Write(ce1, 3, ce1)

        h_f = CAD_Topo.MakeFace(0, h_l)
        // chain face after in_face if present
        IfCondition NotEqual(in_face, 0) ThenBlock: {
            nxt = CAD_Store.Read(in_face, 3)
            CAD_Store.Write(h_f, 3, nxt)
            CAD_Store.Write(in_face, 3, h_f)
            sh = CAD_Store.Read(in_face, 2)
            CAD_Store.Write(h_f, 2, sh)
        }

        ArraySet(out_e_addr, 0, h_e)
        ArraySet(out_f_addr, 0, h_f)
        ReturnValue(0)
    }
}

// Build a unit triangle solid: 3 verts, 3 edges, 1 outer loop, 1 face, shell, solid
// pts: 3 consecutive xyz (9 doubles) at pts_addr
Function.CAD_Topo.MakeTriangleSolid {
    Input: pts_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        p0 = Allocate(32)
        p1 = Allocate(32)
        p2 = Allocate(32)
        ArraySet(p0, 0, ArrayGet(pts_addr, 0))
        ArraySet(p0, 1, ArrayGet(pts_addr, 1))
        ArraySet(p0, 2, ArrayGet(pts_addr, 2))
        ArraySet(p1, 0, ArrayGet(pts_addr, 3))
        ArraySet(p1, 1, ArrayGet(pts_addr, 4))
        ArraySet(p1, 2, ArrayGet(pts_addr, 5))
        ArraySet(p2, 0, ArrayGet(pts_addr, 6))
        ArraySet(p2, 1, ArrayGet(pts_addr, 7))
        ArraySet(p2, 2, ArrayGet(pts_addr, 8))

        v0 = CAD_Topo.MakeVertex(p0)
        v1 = CAD_Topo.MakeVertex(p1)
        v2 = CAD_Topo.MakeVertex(p2)

        e01 = CAD_Topo.MakeEdge(v0, v1, 0)
        e12 = CAD_Topo.MakeEdge(v1, v2, 0)
        e20 = CAD_Topo.MakeEdge(v2, v0, 0)

        // outer coedges around face (CCW): 0->1->2->0
        c01 = CAD_Topo.MakeCoedge(e01, v0, 1)
        c12 = CAD_Topo.MakeCoedge(e12, v1, 1)
        c20 = CAD_Topo.MakeCoedge(e20, v2, 1)
        // mates (opposite sense)
        c10 = CAD_Topo.MakeCoedge(e01, v1, 0)
        c21 = CAD_Topo.MakeCoedge(e12, v2, 0)
        c02 = CAD_Topo.MakeCoedge(e20, v0, 0)
        CAD_Topo.LinkTwins(c01, c10)
        CAD_Topo.LinkTwins(c12, c21)
        CAD_Topo.LinkTwins(c20, c02)

        CAD_Store.Write(e01, 3, c01)
        CAD_Store.Write(e01, 4, c10)
        CAD_Store.Write(e12, 3, c12)
        CAD_Store.Write(e12, 4, c21)
        CAD_Store.Write(e20, 3, c20)
        CAD_Store.Write(e20, 4, c02)

        ring = Allocate(32)
        ArraySet(ring, 0, c01)
        ArraySet(ring, 1, c12)
        ArraySet(ring, 2, c20)
        h_l = CAD_Topo.MakeLoop(c01)
        CAD_Topo.LinkLoopRing(ring, 3, h_l)

        h_f = CAD_Topo.MakeFace(0, h_l)
        h_sh = CAD_Topo.MakeShell(h_f)
        h_so = CAD_Topo.MakeSolid(h_sh)

        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(p0, 32)
        Deallocate(p1, 32)
        Deallocate(p2, 32)
        Deallocate(ring, 32)
        ReturnValue(h_so)
    }
}

// Axis-aligned box [min,max]. Closed: V=8 E=12 F=6 → Euler 2.
// Outward face loops; each coedge used exactly once.
Function.CAD_Topo.MakeBoxSolid {
    Input: min_addr: Address
    Input: max_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        x0 = ArrayGet(min_addr, 0)
        y0 = ArrayGet(min_addr, 1)
        z0 = ArrayGet(min_addr, 2)
        x1 = ArrayGet(max_addr, 0)
        y1 = ArrayGet(max_addr, 1)
        z1 = ArrayGet(max_addr, 2)

        pt = Allocate(32)
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        v0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v3 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z1)
        v4 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v5 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v6 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v7 = CAD_Topo.MakeVertex(pt)

        e01 = CAD_Topo.MakeEdge(v0, v1, 0)
        e12 = CAD_Topo.MakeEdge(v1, v2, 0)
        e23 = CAD_Topo.MakeEdge(v2, v3, 0)
        e30 = CAD_Topo.MakeEdge(v3, v0, 0)
        e45 = CAD_Topo.MakeEdge(v4, v5, 0)
        e56 = CAD_Topo.MakeEdge(v5, v6, 0)
        e67 = CAD_Topo.MakeEdge(v6, v7, 0)
        e74 = CAD_Topo.MakeEdge(v7, v4, 0)
        e04 = CAD_Topo.MakeEdge(v0, v4, 0)
        e15 = CAD_Topo.MakeEdge(v1, v5, 0)
        e26 = CAD_Topo.MakeEdge(v2, v6, 0)
        e37 = CAD_Topo.MakeEdge(v3, v7, 0)

        c01 = CAD_Topo.MakeCoedge(e01, v0, 1)
        c10 = CAD_Topo.MakeCoedge(e01, v1, 0)
        CAD_Topo.LinkTwins(c01, c10)
        CAD_Store.Write(e01, 3, c01)
        CAD_Store.Write(e01, 4, c10)
        c12 = CAD_Topo.MakeCoedge(e12, v1, 1)
        c21 = CAD_Topo.MakeCoedge(e12, v2, 0)
        CAD_Topo.LinkTwins(c12, c21)
        CAD_Store.Write(e12, 3, c12)
        CAD_Store.Write(e12, 4, c21)
        c23 = CAD_Topo.MakeCoedge(e23, v2, 1)
        c32 = CAD_Topo.MakeCoedge(e23, v3, 0)
        CAD_Topo.LinkTwins(c23, c32)
        CAD_Store.Write(e23, 3, c23)
        CAD_Store.Write(e23, 4, c32)
        c30 = CAD_Topo.MakeCoedge(e30, v3, 1)
        c03 = CAD_Topo.MakeCoedge(e30, v0, 0)
        CAD_Topo.LinkTwins(c30, c03)
        CAD_Store.Write(e30, 3, c30)
        CAD_Store.Write(e30, 4, c03)
        c45 = CAD_Topo.MakeCoedge(e45, v4, 1)
        c54 = CAD_Topo.MakeCoedge(e45, v5, 0)
        CAD_Topo.LinkTwins(c45, c54)
        CAD_Store.Write(e45, 3, c45)
        CAD_Store.Write(e45, 4, c54)
        c56 = CAD_Topo.MakeCoedge(e56, v5, 1)
        c65 = CAD_Topo.MakeCoedge(e56, v6, 0)
        CAD_Topo.LinkTwins(c56, c65)
        CAD_Store.Write(e56, 3, c56)
        CAD_Store.Write(e56, 4, c65)
        c67 = CAD_Topo.MakeCoedge(e67, v6, 1)
        c76 = CAD_Topo.MakeCoedge(e67, v7, 0)
        CAD_Topo.LinkTwins(c67, c76)
        CAD_Store.Write(e67, 3, c67)
        CAD_Store.Write(e67, 4, c76)
        c74 = CAD_Topo.MakeCoedge(e74, v7, 1)
        c47 = CAD_Topo.MakeCoedge(e74, v4, 0)
        CAD_Topo.LinkTwins(c74, c47)
        CAD_Store.Write(e74, 3, c74)
        CAD_Store.Write(e74, 4, c47)
        c04 = CAD_Topo.MakeCoedge(e04, v0, 1)
        c40 = CAD_Topo.MakeCoedge(e04, v4, 0)
        CAD_Topo.LinkTwins(c04, c40)
        CAD_Store.Write(e04, 3, c04)
        CAD_Store.Write(e04, 4, c40)
        c15 = CAD_Topo.MakeCoedge(e15, v1, 1)
        c51 = CAD_Topo.MakeCoedge(e15, v5, 0)
        CAD_Topo.LinkTwins(c15, c51)
        CAD_Store.Write(e15, 3, c15)
        CAD_Store.Write(e15, 4, c51)
        c26 = CAD_Topo.MakeCoedge(e26, v2, 1)
        c62 = CAD_Topo.MakeCoedge(e26, v6, 0)
        CAD_Topo.LinkTwins(c26, c62)
        CAD_Store.Write(e26, 3, c26)
        CAD_Store.Write(e26, 4, c62)
        c37 = CAD_Topo.MakeCoedge(e37, v3, 1)
        c73 = CAD_Topo.MakeCoedge(e37, v7, 0)
        CAD_Topo.LinkTwins(c37, c73)
        CAD_Store.Write(e37, 3, c37)
        CAD_Store.Write(e37, 4, c73)

        ring = Allocate(64)

        // bot -Z: 0→3→2→1
        ArraySet(ring, 0, c03)
        ArraySet(ring, 1, c32)
        ArraySet(ring, 2, c21)
        ArraySet(ring, 3, c10)
        l0 = CAD_Topo.MakeLoop(c03)
        CAD_Topo.LinkLoopRing(ring, 4, l0)
        f0 = CAD_Topo.MakeFace(0, l0)

        // top +Z: 4→5→6→7
        ArraySet(ring, 0, c45)
        ArraySet(ring, 1, c56)
        ArraySet(ring, 2, c67)
        ArraySet(ring, 3, c74)
        l1 = CAD_Topo.MakeLoop(c45)
        CAD_Topo.LinkLoopRing(ring, 4, l1)
        f1 = CAD_Topo.MakeFace(0, l1)

        // front -Y: 0→1→5→4
        ArraySet(ring, 0, c01)
        ArraySet(ring, 1, c15)
        ArraySet(ring, 2, c54)
        ArraySet(ring, 3, c40)
        l2 = CAD_Topo.MakeLoop(c01)
        CAD_Topo.LinkLoopRing(ring, 4, l2)
        f2 = CAD_Topo.MakeFace(0, l2)

        // back +Y: 3→7→6→2
        ArraySet(ring, 0, c37)
        ArraySet(ring, 1, c76)
        ArraySet(ring, 2, c62)
        ArraySet(ring, 3, c23)
        l3 = CAD_Topo.MakeLoop(c37)
        CAD_Topo.LinkLoopRing(ring, 4, l3)
        f3 = CAD_Topo.MakeFace(0, l3)

        // left -X: 0→4→7→3
        ArraySet(ring, 0, c04)
        ArraySet(ring, 1, c47)
        ArraySet(ring, 2, c73)
        ArraySet(ring, 3, c30)
        l4 = CAD_Topo.MakeLoop(c04)
        CAD_Topo.LinkLoopRing(ring, 4, l4)
        f4 = CAD_Topo.MakeFace(0, l4)

        // right +X: 1→2→6→5
        ArraySet(ring, 0, c12)
        ArraySet(ring, 1, c26)
        ArraySet(ring, 2, c65)
        ArraySet(ring, 3, c51)
        l5 = CAD_Topo.MakeLoop(c12)
        CAD_Topo.LinkLoopRing(ring, 4, l5)
        f5 = CAD_Topo.MakeFace(0, l5)

        CAD_Store.Write(f0, 3, f1)
        CAD_Store.Write(f1, 3, f2)
        CAD_Store.Write(f2, 3, f3)
        CAD_Store.Write(f3, 3, f4)
        CAD_Store.Write(f4, 3, f5)
        CAD_Store.Write(f5, 3, 0)

        h_sh = CAD_Topo.MakeShell(f0)
        CAD_Store.Write(f1, 2, h_sh)
        CAD_Store.Write(f2, 2, h_sh)
        CAD_Store.Write(f3, 2, h_sh)
        CAD_Store.Write(f4, 2, h_sh)
        CAD_Store.Write(f5, 2, h_sh)

        h_so = CAD_Topo.MakeSolid(h_sh)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(pt, 32)
        Deallocate(ring, 64)
        ReturnValue(h_so)
    }
}

// Count coedges walking next around a loop (guard max 1024)
Function.CAD_Topo.LoopCountCoedges {
    Input: loop_h: Integer
    Output: Integer
    Body: {
        head = CAD_Store.Read(loop_h, 0)
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(0) }
        n = 1
        ce = CAD_Store.Read(head, 2)
        guard = 0
        WhileLoop NotEqual(ce, head) {
            IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(-1) }
            n = Add(n, 1)
            ce = CAD_Store.Read(ce, 2)
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 1024) ThenBlock: { ReturnValue(-1) }
        }
        ReturnValue(n)
    }
}

// Euler-Poincaré: V - E + F == 2*(S - G) + H
// counts_addr: [V, E, F, S, G, H] — 1 Input (SysV-safe)
Function.CAD_Topo.VerifyEulerInvariants {
    Input: counts_addr: Address
    Output: Integer
    Body: {
        num_v = ArrayGet(counts_addr, 0)
        num_e = ArrayGet(counts_addr, 1)
        num_f = ArrayGet(counts_addr, 2)
        num_s = ArrayGet(counts_addr, 3)
        num_g = ArrayGet(counts_addr, 4)
        num_h = ArrayGet(counts_addr, 5)
        lhs = Add(Subtract(num_v, num_e), num_f)
        s_g = Subtract(num_s, num_g)
        rhs = Add(Multiply(2, s_g), num_h)
        IfCondition EqualTo(lhs, rhs) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.Counts {
    Input: out_addr: Address
    Output: Integer
    Body: {
        // out: V E F S solid coedge loop
        ArraySet(out_addr, 0, CAD_Topo_State.vertex_count)
        ArraySet(out_addr, 1, CAD_Topo_State.edge_count)
        ArraySet(out_addr, 2, CAD_Topo_State.face_count)
        ArraySet(out_addr, 3, CAD_Topo_State.shell_count)
        ArraySet(out_addr, 4, CAD_Topo_State.solid_count)
        ArraySet(out_addr, 5, CAD_Topo_State.coedge_count)
        ArraySet(out_addr, 6, CAD_Topo_State.loop_count)
        ReturnValue(0)
    }
}
