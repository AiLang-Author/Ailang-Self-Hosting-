// CAD.UI — core application chrome + sketch construction tools.
// Hosts only blit pixels and send cmd strings. This library owns:
//   • tool ids / cmd parse (tool_line, tool_arc3, tool_circ2, …)
//   • default tools.json catalog
//   • 2-pt/3-pt/center constructions (arc, circle, rect, n-gon, slot, spline)
//
// Tool ids (CadApp.tool):
//   0 line  1 rect2  2 circ-cr  3 arc-center  4 pick  5 trim  6 point
//   7 cstr  8 fillet  9 arc3  10 chamfer  11 revolve-axis
//  12 arc2  13 circ2  14 circ3  15 rect-center  16 rect3  17 poly  18 spline

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Sketch
LibraryImport.Cad.CAD_BSpline

FixedPool.CAD_UI_State {
    "tool":    Initialize=0, CanChange=True
    "nsides":  Initialize=6, CanChange=True
    "is2d":    Initialize=0, CanChange=True
    "ok":      Initialize=0, CanChange=True
    "x0":      Initialize=0, CanChange=True
    "y0":      Initialize=0, CanChange=True
    "x1":      Initialize=0, CanChange=True
    "y1":      Initialize=0, CanChange=True
    "x2":      Initialize=0, CanChange=True
    "y2":      Initialize=0, CanChange=True
}

Function.CAD_UI.AppendStr {
    Input: dst: Address
    Input: pos: Integer
    Input: src: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(pos) }
        i = 0
        WhileLoop NotEqual(GetByte(src, i), 0) {
            SetByte(dst, pos, GetByte(src, i))
            pos = Add(pos, 1)
            i = Add(i, 1)
        }
        ReturnValue(pos)
    }
}

// Parse "tool_*" cmd. Returns tool id, or -1 if not a tool_ command.
// Also fills CAD_UI_State.tool / nsides / is2d.
Function.CAD_UI.ParseTool {
    Input: buf: Address
    Output: Integer
    Body: {
        CAD_UI_State.ok = 0
        CAD_UI_State.is2d = 0
        CAD_UI_State.nsides = 6
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(GetByte(buf, 0), 116) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(GetByte(buf, 1), 111) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(GetByte(buf, 2), 111) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(GetByte(buf, 3), 108) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(GetByte(buf, 4), 95) ThenBlock: { ReturnValue(-1) }
        t = GetByte(buf, 5)
        tid = -1
        // tool_line
        IfCondition EqualTo(t, 108) ThenBlock: { tid = 0 }
        // tool_rect / tool_rectc / tool_rect3
        IfCondition EqualTo(t, 114) ThenBlock: {
            tid = 1
            b9 = GetByte(buf, 9)
            IfCondition EqualTo(b9, 99) ThenBlock: { tid = 15 }
            IfCondition EqualTo(b9, 51) ThenBlock: { tid = 16 }
        }
        // tool_chamfer vs tool_circ / tool_circ2 / tool_circ3
        IfCondition EqualTo(t, 99) ThenBlock: {
            IfCondition EqualTo(GetByte(buf, 6), 104) ThenBlock: {
                tid = 10
            }
            IfCondition NotEqual(GetByte(buf, 6), 104) ThenBlock: {
                tid = 2
                b9 = GetByte(buf, 9)
                IfCondition EqualTo(b9, 50) ThenBlock: { tid = 13 }
                IfCondition EqualTo(b9, 51) ThenBlock: { tid = 14 }
            }
        }
        // tool_3pt
        IfCondition EqualTo(t, 51) ThenBlock: { tid = 9 }
        // tool_arc / tool_arc2 / tool_arc3
        IfCondition EqualTo(t, 97) ThenBlock: {
            tid = 3
            b8 = GetByte(buf, 8)
            IfCondition EqualTo(b8, 50) ThenBlock: { tid = 12 }
            IfCondition EqualTo(b8, 51) ThenBlock: { tid = 9 }
        }
        // tool_pick / tool_point / tool_polyN
        IfCondition EqualTo(t, 112) ThenBlock: {
            t6 = GetByte(buf, 6)
            IfCondition EqualTo(t6, 105) ThenBlock: { tid = 4 }
            IfCondition EqualTo(t6, 111) ThenBlock: {
                t7 = GetByte(buf, 7)
                IfCondition EqualTo(t7, 105) ThenBlock: { tid = 6 }
                IfCondition EqualTo(t7, 108) ThenBlock: {
                    tid = 17
                    ns = 0
                    i = 9
                    WhileLoop LessThan(i, 14) {
                        d = GetByte(buf, i)
                        IfCondition GreaterEqual(d, 48) ThenBlock: {
                            IfCondition LessEqual(d, 57) ThenBlock: {
                                ns = Add(Multiply(ns, 10), Subtract(d, 48))
                                i = Add(i, 1)
                            }
                            IfCondition GreaterThan(d, 57) ThenBlock: { i = 14 }
                            IfCondition LessThan(d, 48) ThenBlock: { i = 14 }
                        }
                        IfCondition LessThan(d, 48) ThenBlock: { i = 14 }
                        IfCondition GreaterThan(d, 57) ThenBlock: { i = 14 }
                    }
                    IfCondition GreaterEqual(ns, 2) ThenBlock: {
                        IfCondition LessThan(ns, 65) ThenBlock: {
                            CAD_UI_State.nsides = ns
                        }
                    }
                }
            }
        }
        // tool_trim
        IfCondition EqualTo(t, 116) ThenBlock: { tid = 5 }
        // tool_fillet / tool_fillet2d / tool_fillet3d
        IfCondition EqualTo(t, 102) ThenBlock: {
            tid = 8
            IfCondition EqualTo(GetByte(buf, 11), 50) ThenBlock: {
                CAD_UI_State.is2d = 1
            }
        }
        // tool_spline
        IfCondition EqualTo(t, 115) ThenBlock: { tid = 18 }
        CAD_UI_State.tool = tid
        IfCondition GreaterEqual(tid, 0) ThenBlock: { CAD_UI_State.ok = 1 }
        ReturnValue(tid)
    }
}

Function.CAD_UI.ToolName {
    Input: tool: Integer
    Output: Address
    Body: {
        n = "line"
        IfCondition EqualTo(tool, 1) ThenBlock: { n = "rect" }
        IfCondition EqualTo(tool, 2) ThenBlock: { n = "circ" }
        IfCondition EqualTo(tool, 3) ThenBlock: { n = "arc" }
        IfCondition EqualTo(tool, 4) ThenBlock: { n = "pick" }
        IfCondition EqualTo(tool, 5) ThenBlock: { n = "trim" }
        IfCondition EqualTo(tool, 6) ThenBlock: { n = "point" }
        IfCondition EqualTo(tool, 7) ThenBlock: { n = "cstr" }
        IfCondition EqualTo(tool, 8) ThenBlock: { n = "fillet" }
        IfCondition EqualTo(tool, 9) ThenBlock: { n = "arc3" }
        IfCondition EqualTo(tool, 10) ThenBlock: { n = "chamfer" }
        IfCondition EqualTo(tool, 11) ThenBlock: { n = "CLICK-AXIS" }
        IfCondition EqualTo(tool, 12) ThenBlock: { n = "arc2" }
        IfCondition EqualTo(tool, 13) ThenBlock: { n = "circ2" }
        IfCondition EqualTo(tool, 14) ThenBlock: { n = "circ3" }
        IfCondition EqualTo(tool, 15) ThenBlock: { n = "rectC" }
        IfCondition EqualTo(tool, 16) ThenBlock: { n = "rect3" }
        IfCondition EqualTo(tool, 17) ThenBlock: { n = "poly" }
        IfCondition EqualTo(tool, 18) ThenBlock: { n = "spline" }
        ReturnValue(n)
    }
}

Function.CAD_UI.Pend2 {
    Input: x0_r: Integer
    Input: y0_r: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Output: Integer
    Body: {
        px0 = x0_r
        py0 = y0_r
        px1 = x1_r
        py1 = y1_r
        CAD_UI_State.x0 = px0
        CAD_UI_State.y0 = py0
        CAD_UI_State.x1 = px1
        CAD_UI_State.y1 = py1
        ReturnValue(0)
    }
}

Function.CAD_UI.Pend3 {
    Input: x0_r: Integer
    Input: y0_r: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: x2_r: Integer
    Input: y2_r: Integer
    Output: Integer
    Body: {
        px0 = x0_r
        py0 = y0_r
        px1 = x1_r
        py1 = y1_r
        px2 = x2_r
        py2 = y2_r
        CAD_UI_State.x0 = px0
        CAD_UI_State.y0 = py0
        CAD_UI_State.x1 = px1
        CAD_UI_State.y1 = py1
        CAD_UI_State.x2 = px2
        CAD_UI_State.y2 = py2
        ReturnValue(0)
    }
}

// Split every line at stored hits (after user curve commit).
Function.CAD_UI.SplitAllLines {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch.RebuildAnchors(h)
        nls = CAD_Sketch.GetLineCount(h)
        si = 0
        WhileLoop LessThan(si, nls) {
            CAD_Sketch.SplitLineAtHits(h, si)
            si = Add(si, 1)
        }
        CAD_Sketch.RebuildAnchors(h)
        ReturnValue(0)
    }
}

// 2-point circle: diameter P0-P1.
Function.CAD_UI.AddCircleDiam {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        x0 = CAD_UI_State.x0
        y0 = CAD_UI_State.y0
        x1 = CAD_UI_State.x1
        y1 = CAD_UI_State.y1
        half = 0x4000000000000000
        mx = Float_Div(Float_Add(x0, x1), half)
        my = Float_Div(Float_Add(y0, y1), half)
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        rad = Float_Div(CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))), half)
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 1) ThenBlock: { ReturnValue(-3) }
        rc = CAD_Sketch.AddCircle(h, mx, my, rad)
        IfCondition EqualTo(rc, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

// 2-point arc: semicircle on diameter P0→P1 (CCW left of chord).
Function.CAD_UI.AddArc2 {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        x0 = CAD_UI_State.x0
        y0 = CAD_UI_State.y0
        x1 = CAD_UI_State.x1
        y1 = CAD_UI_State.y1
        half = 0x4000000000000000
        mx = Float_Div(Float_Add(x0, x1), half)
        my = Float_Div(Float_Add(y0, y1), half)
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        rad = Float_Div(CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))), half)
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 1) ThenBlock: { ReturnValue(-3) }
        a0 = CAD_Geom.Atan2(Float_Sub(y0, my), Float_Sub(x0, mx))
        pi = 0x400921FB54442D18
        a1 = Float_Add(a0, pi)
        rc = CAD_Sketch.AddArc(h, mx, my, rad, a0, a1)
        IfCondition EqualTo(rc, 0) ThenBlock: { ReturnValue(-1) }
        CAD_UI.SplitAllLines(h)
        ReturnValue(0)
    }
}

// 3-point circle: reuse Arc3Fit, commit as full circle.
Function.CAD_UI.AddCircle3 {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        px0 = CAD_UI_State.x0
        py0 = CAD_UI_State.y0
        px1 = CAD_UI_State.x1
        py1 = CAD_UI_State.y1
        px2 = CAD_UI_State.x2
        py2 = CAD_UI_State.y2
        CAD_Sketch.Arc3Pend(px0, py0, px1, py1, px2, py2)
        fr = CAD_Sketch.Arc3FitPend()
        IfCondition NotEqual(fr, 0) ThenBlock: { ReturnValue(fr) }
        cx = CAD_Sketch_Arc3.cx
        cy = CAD_Sketch_Arc3.cy
        rad = CAD_Sketch_Arc3.rad
        rc = CAD_Sketch.AddCircle(h, cx, cy, rad)
        IfCondition EqualTo(rc, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

// Center rectangle: P0 = center, P1 = corner.
Function.CAD_UI.AddRectCenter {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        cx = CAD_UI_State.x0
        cy = CAD_UI_State.y0
        px = CAD_UI_State.x1
        py = CAD_UI_State.y1
        hw = Float_Sub(px, cx)
        hh = Float_Sub(py, cy)
        IfCondition EqualTo(Float_Le(hw, 0), 1) ThenBlock: { hw = Float_Sub(0, hw) }
        IfCondition EqualTo(Float_Le(hh, 0), 1) ThenBlock: { hh = Float_Sub(0, hh) }
        IfCondition EqualTo(CAD_Num.IsZero(hw, 0), 1) ThenBlock: { ReturnValue(-3) }
        IfCondition EqualTo(CAD_Num.IsZero(hh, 0), 1) ThenBlock: { ReturnValue(-3) }
        x0 = Float_Sub(cx, hw)
        y0 = Float_Sub(cy, hh)
        x1 = Float_Add(cx, hw)
        y1 = Float_Add(cy, hh)
        CAD_Sketch.AddLine(h, x0, y0, x1, y0)
        CAD_Sketch.AddLine(h, x1, y0, x1, y1)
        CAD_Sketch.AddLine(h, x1, y1, x0, y1)
        CAD_Sketch.AddLine(h, x0, y1, x0, y0)
        CAD_Sketch.RebuildAnchors(h)
        ReturnValue(0)
    }
}

// 3-point rectangle: P0-P1 first edge, P2 sets height along left-normal.
Function.CAD_UI.AddRect3 {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        x0 = CAD_UI_State.x0
        y0 = CAD_UI_State.y0
        x1 = CAD_UI_State.x1
        y1 = CAD_UI_State.y1
        x2 = CAD_UI_State.x2
        y2 = CAD_UI_State.y2
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        elen = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(elen, 0), 1) ThenBlock: { ReturnValue(-3) }
        ux = Float_Div(dx, elen)
        uy = Float_Div(dy, elen)
        nx = Float_Sub(0, uy)
        ny = ux
        ht = Float_Add(Float_Mul(Float_Sub(x2, x0), nx), Float_Mul(Float_Sub(y2, y0), ny))
        IfCondition EqualTo(CAD_Num.IsZero(ht, 0), 1) ThenBlock: { ReturnValue(-3) }
        qx = Float_Mul(nx, ht)
        qy = Float_Mul(ny, ht)
        xa = Float_Add(x0, qx)
        ya = Float_Add(y0, qy)
        xb = Float_Add(x1, qx)
        yb = Float_Add(y1, qy)
        CAD_Sketch.AddLine(h, x0, y0, x1, y1)
        CAD_Sketch.AddLine(h, x1, y1, xb, yb)
        CAD_Sketch.AddLine(h, xb, yb, xa, ya)
        CAD_Sketch.AddLine(h, xa, ya, x0, y0)
        CAD_Sketch.RebuildAnchors(h)
        ReturnValue(0)
    }
}

// Regular n-gon: center P0, first vertex P1, CAD_UI_State.nsides sides (n>=3).
Function.CAD_UI.AddNGon {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_UI_State.nsides
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(-2) }
        IfCondition GreaterThan(n, 64) ThenBlock: { n = 64 }
        cx = CAD_UI_State.x0
        cy = CAD_UI_State.y0
        vx = CAD_UI_State.x1
        vy = CAD_UI_State.y1
        dx = Float_Sub(vx, cx)
        dy = Float_Sub(vy, cy)
        rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 1) ThenBlock: { ReturnValue(-3) }
        a0 = CAD_Geom.Atan2(dy, dx)
        two_pi = 0x401921FB54442D18
        step = Float_Div(two_pi, Float_FromInt(n))
        pts = Allocate(512)
        i = 0
        WhileLoop LessThan(i, n) {
            ang = Float_Add(a0, Float_Mul(step, Float_FromInt(i)))
            ArraySet(pts, Multiply(i, 2), Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang))))
            ArraySet(pts, Add(Multiply(i, 2), 1), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang))))
            i = Add(i, 1)
        }
        CAD_Sketch.AddPolyline(h, pts, n, 1)
        Deallocate(pts, 512)
        CAD_Sketch.RebuildAnchors(h)
        ReturnValue(0)
    }
}

// Regular n-gon from first edge P0→P1 (2-point). Left-normal is inward.
Function.CAD_UI.AddNGonEdge {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_UI_State.nsides
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(-2) }
        IfCondition GreaterThan(n, 64) ThenBlock: { n = 64 }
        x0 = CAD_UI_State.x0
        y0 = CAD_UI_State.y0
        x1 = CAD_UI_State.x1
        y1 = CAD_UI_State.y1
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        elen = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(elen, 0), 1) ThenBlock: { ReturnValue(-3) }
        half = Float_Div(elen, 0x4000000000000000)
        pi = 0x400921FB54442D18
        pin = Float_Div(pi, Float_FromInt(n))
        s = CAD_Geom.Sin(pin)
        IfCondition EqualTo(CAD_Num.IsZero(s, 0), 1) ThenBlock: { ReturnValue(-3) }
        rad = Float_Div(half, s)
        c = CAD_Geom.Cos(pin)
        dist = Float_Mul(rad, c)
        inv = Float_Div(0x3FF0000000000000, elen)
        nx = Float_Mul(Float_Sub(0, dy), inv)
        ny = Float_Mul(dx, inv)
        mx = Float_Div(Float_Add(x0, x1), 0x4000000000000000)
        my = Float_Div(Float_Add(y0, y1), 0x4000000000000000)
        CAD_UI_State.x0 = Float_Add(mx, Float_Mul(nx, dist))
        CAD_UI_State.y0 = Float_Add(my, Float_Mul(ny, dist))
        CAD_UI_State.x1 = x0
        CAD_UI_State.y1 = y0
        rc = CAD_UI.AddNGon(h)
        ReturnValue(rc)
    }
}

// Center + first vertex + third point (winding). P0=center, P1=vertex, P2=side.
Function.CAD_UI.AddNGonCenter3 {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        n = CAD_UI_State.nsides
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(-2) }
        cx = CAD_UI_State.x0
        cy = CAD_UI_State.y0
        vx = CAD_UI_State.x1
        vy = CAD_UI_State.y1
        px = CAD_UI_State.x2
        py = CAD_UI_State.y2
        dx = Float_Sub(vx, cx)
        dy = Float_Sub(vy, cy)
        rad = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 1) ThenBlock: { ReturnValue(-3) }
        a0 = CAD_Geom.Atan2(dy, dx)
        a2 = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
        two_pi = 0x401921FB54442D18
        step = Float_Div(two_pi, Float_FromInt(n))
        // clockwise if P2 is to the right of C→P1
        cross = Float_Sub(Float_Mul(dx, Float_Sub(py, cy)), Float_Mul(dy, Float_Sub(px, cx)))
        IfCondition EqualTo(Float_Le(cross, 0), 1) ThenBlock: {
            step = Float_Sub(0, step)
        }
        pts = Allocate(512)
        i = 0
        WhileLoop LessThan(i, n) {
            ang = Float_Add(a0, Float_Mul(step, Float_FromInt(i)))
            ArraySet(pts, Multiply(i, 2), Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang))))
            ArraySet(pts, Add(Multiply(i, 2), 1), Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang))))
            i = Add(i, 1)
        }
        CAD_Sketch.AddPolyline(h, pts, n, 1)
        Deallocate(pts, 512)
        CAD_Sketch.RebuildAnchors(h)
        ReturnValue(0)
    }
}

// Slot / obround (polygon "2 sides"): P0 and P1 are the outer tips.
// Radius = |P1-P0|/4 so the body is a capsule with two semicaps.
Function.CAD_UI.AddSlot {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        x0 = CAD_UI_State.x0
        y0 = CAD_UI_State.y0
        x1 = CAD_UI_State.x1
        y1 = CAD_UI_State.y1
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        elen = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(elen, 0), 1) ThenBlock: { ReturnValue(-3) }
        four = 0x4010000000000000
        rad = Float_Div(elen, four)
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 1) ThenBlock: { ReturnValue(-3) }
        ux = Float_Div(dx, elen)
        uy = Float_Div(dy, elen)
        nx = Float_Sub(0, uy)
        ny = ux
        c0x = Float_Add(x0, Float_Mul(ux, rad))
        c0y = Float_Add(y0, Float_Mul(uy, rad))
        c1x = Float_Sub(x1, Float_Mul(ux, rad))
        c1y = Float_Sub(y1, Float_Mul(uy, rad))
        ax = Float_Add(c0x, Float_Mul(nx, rad))
        ay = Float_Add(c0y, Float_Mul(ny, rad))
        bx = Float_Add(c1x, Float_Mul(nx, rad))
        by = Float_Add(c1y, Float_Mul(ny, rad))
        dx2 = Float_Sub(c0x, Float_Mul(nx, rad))
        dy2 = Float_Sub(c0y, Float_Mul(ny, rad))
        ex = Float_Sub(c1x, Float_Mul(nx, rad))
        ey = Float_Sub(c1y, Float_Mul(ny, rad))
        CAD_Sketch.AddLine(h, ax, ay, bx, by)
        CAD_Sketch.AddLine(h, dx2, dy2, ex, ey)
        a_pos = CAD_Geom.Atan2(ny, nx)
        a_neg = CAD_Geom.Atan2(Float_Sub(0, ny), Float_Sub(0, nx))
        two_pi = 0x401921FB54442D18
        a1f = a_pos
        IfCondition EqualTo(Float_Le(a1f, a_neg), 1) ThenBlock: {
            a1f = Float_Add(a1f, two_pi)
        }
        a1b = a_neg
        IfCondition EqualTo(Float_Le(a1b, a_pos), 1) ThenBlock: {
            a1b = Float_Add(a1b, two_pi)
        }
        CAD_Sketch.AddArc(h, c1x, c1y, rad, a_neg, a1f)
        CAD_Sketch.AddArc(h, c0x, c0y, rad, a_pos, a1b)
        CAD_UI.SplitAllLines(h)
        ReturnValue(0)
    }
}

// Sample open clamped B-spline through xy control points into out_xy.
// Returns sample count (xy pairs).
Function.CAD_UI.SampleSplineXY {
    Input: pts_xy: Address
    Input: n_pts: Integer
    Input: out_xy: Address
    Input: cap: Integer
    Output: Integer
    Body: {
        n = n_pts
        IfCondition EqualTo(pts_xy, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(out_xy, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(cap, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(n, 2) ThenBlock: {
            ArraySet(out_xy, 0, ArrayGet(pts_xy, 0))
            ArraySet(out_xy, 1, ArrayGet(pts_xy, 1))
            ArraySet(out_xy, 2, ArrayGet(pts_xy, 2))
            ArraySet(out_xy, 3, ArrayGet(pts_xy, 3))
            ReturnValue(2)
        }
        p = 3
        IfCondition LessThan(n, 4) ThenBlock: { p = Subtract(n, 1) }
        ctrl = Allocate(2048)
        i = 0
        WhileLoop LessThan(i, n) {
            b = Multiply(i, 3)
            ArraySet(ctrl, b, ArrayGet(pts_xy, Multiply(i, 2)))
            ArraySet(ctrl, Add(b, 1), ArrayGet(pts_xy, Add(Multiply(i, 2), 1)))
            ArraySet(ctrl, Add(b, 2), 0)
            i = Add(i, 1)
        }
        nknots = Add(Add(n, p), 1)
        knots = Allocate(1024)
        i = 0
        WhileLoop LessThan(i, nknots) {
            ArraySet(knots, i, 0)
            i = Add(i, 1)
        }
        one = 0x3FF0000000000000
        i = 0
        WhileLoop LessEqual(i, p) {
            ArraySet(knots, i, 0)
            ArraySet(knots, Subtract(Subtract(nknots, 1), i), one)
            i = Add(i, 1)
        }
        nint = Subtract(Subtract(n, p), 1)
        IfCondition GreaterThan(nint, 0) ThenBlock: {
            k = 0
            den = Float_FromInt(Add(nint, 1))
            WhileLoop LessThan(k, nint) {
                ArraySet(knots, Add(Add(p, 1), k), Float_Div(Float_FromInt(Add(k, 1)), den))
                k = Add(k, 1)
            }
        }
        desc = Allocate(64)
        ArraySet(desc, 0, p)
        ArraySet(desc, 1, n)
        ArraySet(desc, 2, ctrl)
        ArraySet(desc, 3, knots)
        ns = Add(Multiply(12, Subtract(n, 1)), 1)
        IfCondition GreaterThan(ns, cap) ThenBlock: { ns = cap }
        IfCondition LessThan(ns, 2) ThenBlock: { ns = 2 }
        outp = Allocate(32)
        s = 0
        WhileLoop LessThan(s, ns) {
            u = 0
            IfCondition GreaterThan(s, 0) ThenBlock: {
                u = Float_Div(Float_FromInt(s), Float_FromInt(Subtract(ns, 1)))
            }
            CAD_BSpline.EvalCurve(desc, u, outp)
            ArraySet(out_xy, Multiply(s, 2), ArrayGet(outp, 0))
            ArraySet(out_xy, Add(Multiply(s, 2), 1), ArrayGet(outp, 1))
            s = Add(s, 1)
        }
        Deallocate(outp, 32)
        Deallocate(desc, 64)
        Deallocate(knots, 1024)
        Deallocate(ctrl, 2048)
        ReturnValue(ns)
    }
}

Function.CAD_UI.AddSplineXY {
    Input: sketch_handle: Integer
    Input: pts_xy: Address
    Input: n_pts: Integer
    Output: Integer
    Body: {
        h = sketch_handle
        n = n_pts
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(-2) }
        samp = Allocate(8192)
        ns = CAD_UI.SampleSplineXY(pts_xy, n, samp, 256)
        IfCondition LessThan(ns, 2) ThenBlock: {
            Deallocate(samp, 8192)
            ReturnValue(-3)
        }
        CAD_Sketch.AddPolyline(h, samp, ns, 0)
        Deallocate(samp, 8192)
        CAD_Sketch.RebuildAnchors(h)
        ReturnValue(0)
    }
}

// Kernel-owned tools.json (hosts must not invent cmds).
Function.CAD_UI.WriteToolsJson {
    Input: path_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path_addr, 0) ThenBlock: { ReturnValue(-2) }
        buf = Allocate(8192)
        pos = 0
        pos = CAD_UI.AppendStr(buf, pos, "{\"schema\":1,\"app\":\"cad\",\"role\":\"default\",")
        pos = CAD_UI.AppendStr(buf, pos, "\"defaults\":{\"pad_h\":20,\"shade\":\"solid\",\"wire\":0,\"fillet_r\":2,\"chamfer_d\":2},")
        pos = CAD_UI.AppendStr(buf, pos, "\"toolbars\":[")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"sketch\",\"label\":\"Sketch\",\"tools\":[")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"line\",\"label\":\"Line\",\"cmd\":\"tool_line\",\"group\":\"draw\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"rect\",\"label\":\"Rect\",\"cmd\":\"tool_rect\",\"group\":\"draw\",")
        pos = CAD_UI.AppendStr(buf, pos, "\"variants\":[{\"label\":\"2-Point Rect\",\"cmd\":\"tool_rect\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"Center Rect\",\"cmd\":\"tool_rectc\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"3-Point Rect\",\"cmd\":\"tool_rect3\"}]},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"circ\",\"label\":\"Circle\",\"cmd\":\"tool_circ\",\"group\":\"draw\",")
        pos = CAD_UI.AppendStr(buf, pos, "\"variants\":[{\"label\":\"Center Radius\",\"cmd\":\"tool_circ\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"2-Point Circle\",\"cmd\":\"tool_circ2\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"3-Point Circle\",\"cmd\":\"tool_circ3\"}]},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"arc\",\"label\":\"Arc\",\"cmd\":\"tool_arc3\",\"group\":\"draw\",")
        pos = CAD_UI.AppendStr(buf, pos, "\"variants\":[{\"label\":\"3-Point Arc\",\"cmd\":\"tool_arc3\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"2-Point Arc\",\"cmd\":\"tool_arc2\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"Center Arc\",\"cmd\":\"tool_arc\"}]},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"poly\",\"label\":\"Polygon\",\"cmd\":\"tool_poly6\",\"group\":\"draw\",")
        pos = CAD_UI.AppendStr(buf, pos, "\"variants\":[{\"label\":\"Center\",\"cmd\":\"pmode 0\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"2-Point\",\"cmd\":\"pmode 1\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"3-Point\",\"cmd\":\"pmode 2\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"Triangle\",\"cmd\":\"tool_poly3\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"Square\",\"cmd\":\"tool_poly4\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"Pentagon\",\"cmd\":\"tool_poly5\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"Hexagon\",\"cmd\":\"tool_poly6\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"Octagon\",\"cmd\":\"tool_poly8\"}]},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"spline\",\"label\":\"Spline\",\"cmd\":\"tool_spline\",\"group\":\"draw\",")
        pos = CAD_UI.AppendStr(buf, pos, "\"variants\":[{\"label\":\"Control Points\",\"cmd\":\"tool_spline\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"label\":\"Finish Spline\",\"cmd\":\"done\"}]},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"point\",\"label\":\"Point\",\"cmd\":\"tool_point\",\"group\":\"draw\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"trim\",\"label\":\"Trim\",\"cmd\":\"tool_trim\",\"group\":\"edit\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"fillet2d\",\"label\":\"Fillet 2D\",\"cmd\":\"tool_fillet2d\",\"group\":\"edit\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"pick\",\"label\":\"Pick\",\"cmd\":\"tool_pick\",\"group\":\"sel\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"profiles\",\"label\":\"Profiles\",\"cmd\":\"profiles\",\"group\":\"sel\"}")
        pos = CAD_UI.AppendStr(buf, pos, "]},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"constraint\",\"label\":\"Constrain\",\"tools\":[")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"fixo\",\"label\":\"Fix to O\",\"cmd\":\"cstr_fixo\",\"group\":\"origin\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"disto\",\"label\":\"Dist to O\",\"cmd\":\"cstr_disto\",\"group\":\"origin\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"h\",\"label\":\"Horizontal\",\"cmd\":\"cstr_h\",\"group\":\"unary\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"v\",\"label\":\"Vertical\",\"cmd\":\"cstr_v\",\"group\":\"unary\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"rad\",\"label\":\"Radius\",\"cmd\":\"cstr_rad\",\"group\":\"unary\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"coinc\",\"label\":\"Coincident\",\"cmd\":\"cstr_coinc\",\"group\":\"rel\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"pon\",\"label\":\"On Line\",\"cmd\":\"cstr_pon\",\"group\":\"rel\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"tang\",\"label\":\"Tangent\",\"cmd\":\"cstr_tang\",\"group\":\"rel\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"eqr\",\"label\":\"Equal R\",\"cmd\":\"cstr_eqr\",\"group\":\"rel\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"dist\",\"label\":\"Distance\",\"cmd\":\"cstr_dist\",\"group\":\"rel\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"solve\",\"label\":\"Solve\",\"cmd\":\"solve\",\"group\":\"cstr\"}")
        pos = CAD_UI.AppendStr(buf, pos, "]},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"feature\",\"label\":\"Feature\",\"tools\":[")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"pad\",\"label\":\"Extrude\",\"cmd\":\"repad\",\"group\":\"feat\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"revolve\",\"label\":\"Revolve\",\"cmd\":\"revolve\",\"group\":\"feat\"}")
        pos = CAD_UI.AppendStr(buf, pos, "]},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"solid\",\"label\":\"Solid\",\"tools\":[")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"fillet3d\",\"label\":\"Fillet\",\"cmd\":\"tool_fillet3d\",\"group\":\"modify\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"chamfer3d\",\"label\":\"Chamfer Body\",\"cmd\":\"tool_chamfer\",\"group\":\"modify\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"wire\",\"label\":\"Wireframe\",\"cmd\":\"wire\",\"group\":\"display\"}")
        pos = CAD_UI.AppendStr(buf, pos, "]},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"construct\",\"label\":\"Construct\",\"tools\":[")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"plane_xy\",\"label\":\"XY Plane\",\"cmd\":\"plane_xy\",\"group\":\"planes\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"plane_top\",\"label\":\"Sketch on Face\",\"cmd\":\"plane_top\",\"group\":\"planes\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"plane_off\",\"label\":\"Offset Plane\",\"cmd\":\"plane_off 20\",\"group\":\"planes\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"plane_ang\",\"label\":\"Angle Plane\",\"cmd\":\"plane_ang 45\",\"group\":\"planes\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"plane_flip\",\"label\":\"Flip Normal\",\"cmd\":\"plane_flip\",\"group\":\"planes\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"undo\",\"label\":\"Undo\",\"cmd\":\"undo\",\"group\":\"edit\"}")
        pos = CAD_UI.AppendStr(buf, pos, "]},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"view\",\"label\":\"View\",\"tools\":[")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"mode\",\"label\":\"2D/3D\",\"cmd\":\"mode\",\"group\":\"view\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"grid\",\"label\":\"Grid\",\"cmd\":\"grid\",\"group\":\"view\"}")
        pos = CAD_UI.AppendStr(buf, pos, "]},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"file\",\"label\":\"File\",\"tools\":[")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"new\",\"label\":\"New\",\"cmd\":\"newdoc\",\"group\":\"file\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"list\",\"label\":\"List Docs\",\"cmd\":\"files\",\"group\":\"file\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"import\",\"label\":\"Import DXF\",\"cmd\":\"import\",\"group\":\"file\"},")
        pos = CAD_UI.AppendStr(buf, pos, "{\"id\":\"refresh\",\"label\":\"Refresh Tools\",\"cmd\":\"tools\",\"group\":\"file\"}")
        pos = CAD_UI.AppendStr(buf, pos, "]}]}")
        SetByte(buf, pos, 0)
        fd = SystemCall(2, path_addr, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(-7)
        }
        SystemCall(1, fd, buf, pos)
        SystemCall(3, fd, 0, 0)
        Deallocate(buf, 8192)
        ReturnValue(pos)
    }
}
