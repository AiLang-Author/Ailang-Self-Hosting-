// CAD.View — software viewport: solid → Tess mesh → headless FB → BMP
// Host (Gtk) is a handle only: it sends orbit/pan/zoom/click. This library
// owns yaw/pitch/zoom/pan. Sketch-on-face reuses this camera — no second view.
// Host OS: no AOS required. Screenshot path for agent look-ats.
// Optional: OpenHostViewer forks eog/xdg-open on the BMP (isolated window).
//
// Mesh layout (CAD_Tess): [n_verts, n_tris, v_base xyz…, i_base i0i1i2…]
// Projection: orthographic isometric-ish (view dir ~ +X+Y+Z).
// Raster: barycentric fill + integer Z-buffer + N·L shade.
//
// SysV: ≤5 Inputs. Flat control flow.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

// view_mode: 0=iso preset 1=top 2=front 3=free orbit (yaw/pitch)
// wire: 1 draw tri edges, 0 shaded only
// defl: IEEE double mesh deflection (0 = Tess default)
// yaw/pitch: free orbit radians; zoom: scale multiplier (1.0 default)
FixedPool.CAD_View_State {
    "shots":      Initialize=0
    "tris_draw":  Initialize=0
    "last_nv":    Initialize=0
    "last_nt":    Initialize=0
    "wire":       Initialize=0, CanChange=True
    "view_mode":  Initialize=0, CanChange=True
    "defl_r":     Initialize=0, CanChange=True
    "yaw_r":      Initialize=0, CanChange=True
    "pitch_r":    Initialize=0, CanChange=True
    "zoom_r":     Initialize=0, CanChange=True
    "pan_u":      Initialize=0, CanChange=True
    "pan_v":      Initialize=0, CanChange=True
    "cache_solid": Initialize=0, CanChange=True
    "cache_hdr":   Initialize=0, CanChange=True
    "cache_zoom":  Initialize=0, CanChange=True
    // last DrawMesh projection — overlay must reuse this, not invent a second camera
    "fr_ok": Initialize=0, CanChange=True
    "fr_cx": Initialize=0, CanChange=True
    "fr_cy": Initialize=0, CanChange=True
    "fr_cz": Initialize=0, CanChange=True
    "fr_sc": Initialize=0, CanChange=True
    "fr_fit": Initialize=0, CanChange=True
    "fr_hw": Initialize=0, CanChange=True
    "fr_hh": Initialize=0, CanChange=True
    "raw_w": Initialize=0, CanChange=True
    "raw_h": Initialize=0, CanChange=True
    "raw_pitch": Initialize=0, CanChange=True
    "raw_buf": Initialize=0, CanChange=True
    "raw_hdr": Initialize=0, CanChange=True
    // solid fill 20..100 (percent). 100 = opaque Z. Lower = dither see-through.
    "opac": Initialize=100, CanChange=True
    "zb": Initialize=0, CanChange=True
    "zb_w": Initialize=0, CanChange=True
    "zb_h": Initialize=0, CanChange=True
    "zb_bytes": Initialize=0, CanChange=True
    "ol_occlude": Initialize=1, CanChange=True
    // leftover pool slot; orbit is C-axis wrap, mouse sign never flips
    "pitch_sign": Initialize=1, CanChange=True
    // camera basis (unit right / up / cam-dir). Built once per frame.
    "b_ok": Initialize=0, CanChange=True
    "b_rx": Initialize=0, CanChange=True
    "b_ry": Initialize=0, CanChange=True
    "b_rz": Initialize=0, CanChange=True
    "b_ux": Initialize=0, CanChange=True
    "b_uy": Initialize=0, CanChange=True
    "b_uz": Initialize=0, CanChange=True
    "b_dx": Initialize=0, CanChange=True
    "b_dy": Initialize=0, CanChange=True
    "b_dz": Initialize=0, CanChange=True
    "pr_x": Initialize=0, CanChange=True
    "pr_y": Initialize=0, CanChange=True
    "pr_z": Initialize=0, CanChange=True
    "b_tmp": Initialize=0, CanChange=True
}

// Drop cached tess mesh (pad / fillet / chamfer / cut).
Function.CAD_View.InvalidateMesh {
    Output: Integer
    Body: {
        hdr = CAD_View_State.cache_hdr
        IfCondition NotEqual(hdr, 0) ThenBlock: {
            vb = ArrayGet(hdr, 2)
            ib = ArrayGet(hdr, 3)
            vsz = ArrayGet(hdr, 4)
            isz = ArrayGet(hdr, 5)
            IfCondition EqualTo(vsz, 0) ThenBlock: { vsz = 1048576 }
            IfCondition EqualTo(isz, 0) ThenBlock: { isz = 524288 }
            IfCondition NotEqual(vb, 0) ThenBlock: {
                IfCondition NotEqual(vb, CAD_Tess_State.v_base) ThenBlock: { Deallocate(vb, vsz) }
            }
            IfCondition NotEqual(ib, 0) ThenBlock: {
                IfCondition NotEqual(ib, CAD_Tess_State.i_base) ThenBlock: { Deallocate(ib, isz) }
            }
            Deallocate(hdr, 48)
        }
        CAD_View_State.cache_hdr = 0
        CAD_View_State.cache_solid = 0
        CAD_View_State.cache_zoom = 0
        CAD_View_State.fr_ok = 0
        IfCondition NotEqual(CAD_View_State.zb, 0) ThenBlock: {
            Deallocate(CAD_View_State.zb, CAD_View_State.zb_bytes)
            CAD_View_State.zb = 0
            CAD_View_State.zb_bytes = 0
        }
        ReturnValue(0)
    }
}

Function.CAD_View.SetWire {
    Input: on: Integer
    Output: Integer
    Body: {
        CAD_View_State.wire = on
        ReturnValue(0)
    }
}

// Preset views also seed free-orbit angles so LMB orbit continues smoothly.
Function.CAD_View.SetViewMode {
    Input: mode: Integer
    Output: Integer
    Body: {
        CAD_View_State.view_mode = mode
        // defaults: yaw≈45° pitch≈35° iso; top pitch=89°; front pitch=0 yaw=0
        pi = 0x400921FB54442D18
        half_pi = 0x3FF921FB54442D18
        IfCondition EqualTo(mode, 0) ThenBlock: {
            CAD_View_State.yaw_r = 0x3FE921FB54442D18
            CAD_View_State.pitch_r = 0x3FDDE9E64DF543EE
            CAD_View_State.view_mode = 3
        }
        IfCondition EqualTo(mode, 1) ThenBlock: {
            CAD_View_State.yaw_r = 0
            CAD_View_State.pitch_r = 0x3FF9000000000000
            CAD_View_State.view_mode = 3
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            CAD_View_State.yaw_r = 0
            CAD_View_State.pitch_r = 0
            CAD_View_State.view_mode = 3
        }
        IfCondition EqualTo(mode, 3) ThenBlock: {
            CAD_View_State.view_mode = 3
        }
        // right / left / back presets: mode 4=right 5=left 6=back 7=bottom
        IfCondition EqualTo(mode, 4) ThenBlock: {
            CAD_View_State.yaw_r = half_pi
            CAD_View_State.pitch_r = 0
            CAD_View_State.view_mode = 3
        }
        IfCondition EqualTo(mode, 5) ThenBlock: {
            CAD_View_State.yaw_r = Float_Sub(0, half_pi)
            CAD_View_State.pitch_r = 0
            CAD_View_State.view_mode = 3
        }
        IfCondition EqualTo(mode, 6) ThenBlock: {
            CAD_View_State.yaw_r = pi
            CAD_View_State.pitch_r = 0
            CAD_View_State.view_mode = 3
        }
        IfCondition EqualTo(mode, 7) ThenBlock: {
            CAD_View_State.yaw_r = 0
            CAD_View_State.pitch_r = Float_Sub(0, 0x3FF9000000000000)
            CAD_View_State.view_mode = 3
        }
        CAD_View_State.pitch_sign = 1
        CAD_View_State.b_ok = 0
        ReturnValue(0)
    }
}

// Fold yaw and pitch into (-π, π]. C-axis wrap: 0 at center, ±360 → 0.
Function.CAD_View.WrapYaw {
    Output: Integer
    Body: {
        pi = 0x400921FB54442D18
        two_pi = 0x401921FB54442D18
        y = CAD_View_State.yaw_r
        i = 0
        WhileLoop LessThan(i, 32) {
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, y)), 1) ThenBlock: {
                y = Float_Sub(y, two_pi)
            }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(y, pi)), 1) ThenBlock: {
                y = Float_Add(y, two_pi)
            }
            i = Add(i, 1)
        }
        CAD_View_State.yaw_r = y
        p = CAD_View_State.pitch_r
        i = 0
        WhileLoop LessThan(i, 32) {
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, p)), 1) ThenBlock: {
                p = Float_Sub(p, two_pi)
            }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(p, pi)), 1) ThenBlock: {
                p = Float_Add(p, two_pi)
            }
            i = Add(i, 1)
        }
        CAD_View_State.pitch_r = p
        ReturnValue(0)
    }
}

// Unit right / up / camera-dir from yaw+pitch. Pin every Cos/Sin/Sqrt result
// into CAD_View_State — Integer locals after those calls are garbage.
Function.CAD_View.BuildBasis {
    Output: Integer
    Body: {
        CAD_View.EnsureCamDefaults()
        // Cos/Sin clobber Integer locals — pass FixedPool fields, stash results.
        CAD_View_State.b_dx = CAD_Geom.Sin(CAD_View_State.yaw_r)
        CAD_View_State.b_dy = CAD_Geom.Cos(CAD_View_State.yaw_r)
        CAD_View_State.b_dz = CAD_Geom.Sin(CAD_View_State.pitch_r)
        CAD_View_State.b_ux = CAD_Geom.Cos(CAD_View_State.pitch_r)
        syaw = CAD_View_State.b_dx
        cyaw = CAD_View_State.b_dy
        sp = CAD_View_State.b_dz
        cp = CAD_View_State.b_ux
        CAD_View_State.b_dx = Float_Mul(cp, syaw)
        CAD_View_State.b_dy = Float_Mul(cp, cyaw)
        CAD_View_State.b_dz = sp
        // right = normalize(Z × cam) = (-cdy, cdx, 0)
        CAD_View_State.b_rx = Float_Sub(0, CAD_View_State.b_dy)
        CAD_View_State.b_ry = CAD_View_State.b_dx
        rl2 = Float_Add(Float_Mul(CAD_View_State.b_rx, CAD_View_State.b_rx), Float_Mul(CAD_View_State.b_ry, CAD_View_State.b_ry))
        CAD_View_State.b_rz = CAD_Num.Sqrt(rl2)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_View_State.b_rz, 0), 1) ThenBlock: {
            CAD_View_State.b_rx = 0x3FF0000000000000
            CAD_View_State.b_ry = 0
            CAD_View_State.b_rz = 0
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_View_State.b_rz, 0), 0) ThenBlock: {
            CAD_View_State.b_rx = Float_Div(CAD_View_State.b_rx, CAD_View_State.b_rz)
            CAD_View_State.b_ry = Float_Div(CAD_View_State.b_ry, CAD_View_State.b_rz)
            CAD_View_State.b_rz = 0
        }
        // up = cam × right
        cdx = CAD_View_State.b_dx
        cdy = CAD_View_State.b_dy
        cdz = CAD_View_State.b_dz
        rx = CAD_View_State.b_rx
        ry = CAD_View_State.b_ry
        rz = CAD_View_State.b_rz
        CAD_View_State.b_ux = Float_Sub(Float_Mul(cdy, rz), Float_Mul(cdz, ry))
        CAD_View_State.b_uy = Float_Sub(Float_Mul(cdz, rx), Float_Mul(cdx, rz))
        CAD_View_State.b_uz = Float_Sub(Float_Mul(cdx, ry), Float_Mul(cdy, rx))
        ul2 = Float_Add(Float_Add(Float_Mul(CAD_View_State.b_ux, CAD_View_State.b_ux), Float_Mul(CAD_View_State.b_uy, CAD_View_State.b_uy)), Float_Mul(CAD_View_State.b_uz, CAD_View_State.b_uz))
        CAD_View_State.b_tmp = CAD_Num.Sqrt(ul2)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_View_State.b_tmp, 0), 0) ThenBlock: {
            CAD_View_State.b_ux = Float_Div(CAD_View_State.b_ux, CAD_View_State.b_tmp)
            CAD_View_State.b_uy = Float_Div(CAD_View_State.b_uy, CAD_View_State.b_tmp)
            CAD_View_State.b_uz = Float_Div(CAD_View_State.b_uz, CAD_View_State.b_tmp)
        }
        CAD_View_State.b_ok = 1
        ReturnValue(0)
    }
}

Function.CAD_View.SetDefl {
    Input: defl_r: Integer
    Output: Integer
    Body: {
        CAD_View_State.defl_r = defl_r
        ReturnValue(0)
    }
}

// World-space chord sag so a ½-pixel error is the Class A display budget.
// δ = 0.5 / (px per mm). n = π √(r / 2δ) then follows the live zoom/size.
Function.CAD_View.PixelSagDefl {
    Input: solid_handle: Integer
    Input: width: Integer
    Input: height: Integer
    Output: Integer
    Body: {
        half_px = 0x3FE0000000000000
        defl = 0x3F947AE147AE147B
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(defl) }
        sc = CAD_View_State.fr_sc
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            mn = Allocate(32)
            mx = Allocate(32)
            IfCondition EqualTo(CAD_Topo.SolidBounds(solid_handle, mn, mx), 1) ThenBlock: {
                aabb = Allocate(64)
                ArraySet(aabb, 0, ArrayGet(mn, 0))
                ArraySet(aabb, 1, ArrayGet(mn, 1))
                ArraySet(aabb, 2, ArrayGet(mn, 2))
                ArraySet(aabb, 3, ArrayGet(mx, 0))
                ArraySet(aabb, 4, ArrayGet(mx, 1))
                ArraySet(aabb, 5, ArrayGet(mx, 2))
                frame = Allocate(64)
                CAD_View.BuildFrame(aabb, width, height, frame)
                sc = ArrayGet(frame, 3)
                Deallocate(frame, 64)
                Deallocate(aabb, 64)
            }
            Deallocate(mn, 32)
            Deallocate(mx, 32)
        }
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 0) ThenBlock: {
            defl = Float_Div(half_px, sc)
        }
        floor_d = 0x3F947AE147AE147B
        IfCondition EqualTo(Float_Le(defl, floor_d), 1) ThenBlock: { defl = floor_d }
        ReturnValue(defl)
    }
}

// Ensure zoom default 1.0
Function.CAD_View.EnsureCamDefaults {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(CAD_View_State.zoom_r, 0), 1) ThenBlock: {
            CAD_View_State.zoom_r = 0x3FF0000000000000
        }
        // first-time iso seed if yaw/pitch zero and mode 0-ish
        IfCondition EqualTo(CAD_Num.IsZero(CAD_View_State.yaw_r, 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_View_State.pitch_r, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_View_State.view_mode, 0) ThenBlock: {
                    CAD_View.SetViewMode(0)
                }
            }
        }
        ReturnValue(0)
    }
}

// Orbit by pixel deltas (LMB drag). sensitivity ~0.01 rad/px
Function.CAD_View.OrbitPixels {
    Input: dx_i: Integer
    Input: dy_i: Integer
    Output: Integer
    Body: {
        CAD_View.EnsureCamDefaults()
        CAD_View_State.view_mode = 3
        CAD_View_State.pitch_sign = 1
        sens = 0x3F847AE147AE147B
        dyaw = Float_Mul(Float_FromInt(dx_i), sens)
        // C-axis: drag down always +pitch, drag up always −pitch. Wrap at ±360.
        // No pole flip — that inverted the mouse after TOP/BOTTOM.
        dpitch = Float_Mul(Float_FromInt(dy_i), sens)
        CAD_View_State.yaw_r = Float_Add(CAD_View_State.yaw_r, dyaw)
        CAD_View_State.pitch_r = Float_Add(CAD_View_State.pitch_r, dpitch)
        CAD_View.WrapYaw()
        CAD_View_State.b_ok = 0
        ReturnValue(0)
    }
}

// Zoom: steps >0 zoom in. factor 1.1^steps
Function.CAD_View.ZoomSteps {
    Input: steps_i: Integer
    Output: Integer
    Body: {
        CAD_View.EnsureCamDefaults()
        fac = 0x3FF199999999999A
        IfCondition LessThan(steps_i, 0) ThenBlock: {
            fac = 0x3FEB851EB851EB85
            steps_i = Subtract(0, steps_i)
        }
        i = 0
        WhileLoop LessThan(i, steps_i) {
            CAD_View_State.zoom_r = Float_Mul(CAD_View_State.zoom_r, fac)
            i = Add(i, 1)
        }
        // clamp zoom
        IfCondition EqualTo(Float_Le(CAD_View_State.zoom_r, 0x3F847AE147AE147B), 1) ThenBlock: {
            CAD_View_State.zoom_r = 0x3F847AE147AE147B
        }
        IfCondition EqualTo(Float_Le(0x4034000000000000, CAD_View_State.zoom_r), 1) ThenBlock: {
            CAD_View_State.zoom_r = 0x4034000000000000
        }
        ReturnValue(0)
    }
}

// Pan by pixel deltas (MMB / host "pan"). Screen-space: drag right → content follows.
// Uses last DrawMesh scale so overlay and pick stay on the same camera.
Function.CAD_View.PanPixels {
    Input: dx_i: Integer
    Input: dy_i: Integer
    Output: Integer
    Body: {
        CAD_View.EnsureCamDefaults()
        sc = CAD_View_State.fr_sc
        IfCondition EqualTo(CAD_Num.IsZero(sc, 0), 1) ThenBlock: {
            sc = 0x3FF0000000000000
        }
        CAD_View_State.pan_u = Float_Add(CAD_View_State.pan_u, Float_Div(Float_FromInt(dx_i), sc))
        CAD_View_State.pan_v = Float_Sub(CAD_View_State.pan_v, Float_Div(Float_FromInt(dy_i), sc))
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// BMP helpers (24-bit BGR, bottom-up) — path-arg screenshot, no ffmpeg
// -------------------------------------------------------------------------
Function.CAD_View.WriteLE16 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(val, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
        ReturnValue(0)
    }
}

Function.CAD_View.WriteLE32 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(val, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
        SetByte(buf, Add(off, 2), BitwiseAnd(ShiftRight(val, 16), 255))
        SetByte(buf, Add(off, 3), BitwiseAnd(ShiftRight(val, 24), 255))
        ReturnValue(0)
    }
}

// Save current headless/draw FB to path as 24-bit BMP. Returns 0 ok, negative fail.
Function.CAD_View.SaveFBToBMP {
    Input: path_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path_addr, 0) ThenBlock: { ReturnValue(-1) }
        w = FB_GetWidth()
        h = FB_GetHeight()
        fb_buf = FB_GetDrawBuffer()
        fb_pitch = FB.pitch
        IfCondition EqualTo(fb_buf, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(w, 1) ThenBlock: { ReturnValue(-1) }
        row_bytes = Multiply(w, 3)
        rem = Modulo(row_bytes, 4)
        pad = 0
        IfCondition NotEqual(rem, 0) ThenBlock: { pad = Subtract(4, rem) }
        bmp_stride = Add(row_bytes, pad)
        pix_size = Multiply(bmp_stride, h)
        file_size = Add(54, pix_size)
        fd = SystemCall(2, path_addr, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-16) }
        hdr = Allocate(64)
        zi = 0
        WhileLoop LessThan(zi, 54) {
            SetByte(hdr, zi, 0)
            zi = Add(zi, 1)
        }
        SetByte(hdr, 0, 66)
        SetByte(hdr, 1, 77)
        CAD_View.WriteLE32(hdr, 2, file_size)
        CAD_View.WriteLE32(hdr, 10, 54)
        CAD_View.WriteLE32(hdr, 14, 40)
        CAD_View.WriteLE32(hdr, 18, w)
        CAD_View.WriteLE32(hdr, 22, h)
        CAD_View.WriteLE16(hdr, 26, 1)
        CAD_View.WriteLE16(hdr, 28, 24)
        CAD_View.WriteLE32(hdr, 34, pix_size)
        SystemCall(1, fd, hdr, 54)
        Deallocate(hdr, 64)
        row_buf = Allocate(Add(bmp_stride, 8))
        y = Subtract(h, 1)
        WhileLoop GreaterEqual(y, 0) {
            src = Add(fb_buf, Multiply(y, fb_pitch))
            x = 0
            WhileLoop LessThan(x, w) {
                si = Multiply(x, 4)
                di = Multiply(x, 3)
                SetByte(row_buf, di, GetByte(src, si))
                SetByte(row_buf, Add(di, 1), GetByte(src, Add(si, 1)))
                SetByte(row_buf, Add(di, 2), GetByte(src, Add(si, 2)))
                x = Add(x, 1)
            }
            pi = 0
            WhileLoop LessThan(pi, pad) {
                SetByte(row_buf, Add(row_bytes, pi), 0)
                pi = Add(pi, 1)
            }
            SystemCall(1, fd, row_buf, bmp_stride)
            y = Subtract(y, 1)
        }
        Deallocate(row_buf, Add(bmp_stride, 8))
        SystemCall(3, fd, 0, 0)
        CAD_View_State.shots = Add(CAD_View_State.shots, 1)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Mesh bounds (vert extents) → out_addr [xmin,ymin,zmin,xmax,ymax,zmax]
// -------------------------------------------------------------------------
Function.CAD_View.MeshBounds {
    Input: mesh_addr: Address
    Input: out_addr: Address
    Output: Integer
    Body: {
        nv = ArrayGet(mesh_addr, 0)
        vb = ArrayGet(mesh_addr, 2)
        IfCondition LessThan(nv, 1) ThenBlock: { ReturnValue(-1) }
        xmin = ArrayGet(vb, 0)
        ymin = ArrayGet(vb, 1)
        zmin = ArrayGet(vb, 2)
        xmax = xmin
        ymax = ymin
        zmax = zmin
        i = 1
        WhileLoop LessThan(i, nv) {
            o = Multiply(i, 3)
            x = ArrayGet(vb, o)
            y = ArrayGet(vb, Add(o, 1))
            z = ArrayGet(vb, Add(o, 2))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            IfCondition EqualTo(Float_Le(z, zmin), 1) ThenBlock: { zmin = z }
            IfCondition EqualTo(Float_Le(zmax, z), 1) ThenBlock: { zmax = z }
            i = Add(i, 1)
        }
        ArraySet(out_addr, 0, xmin)
        ArraySet(out_addr, 1, ymin)
        ArraySet(out_addr, 2, zmin)
        ArraySet(out_addr, 3, xmax)
        ArraySet(out_addr, 4, ymax)
        ArraySet(out_addr, 5, zmax)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Project mesh verts → screen pack:
//   sx_base[i], sy_base[i] as Float (pixel coords)
//   sz_base[i] as Float depth (smaller = closer)
// frame pack: [cx,cy,cz, scale, half_w, half_h] floats
// -------------------------------------------------------------------------
Function.CAD_View.BuildFrame {
    Input: aabb_addr: Address
    Input: width: Integer
    Input: height: Integer
    Input: frame_addr: Address
    Output: Integer
    Body: {
        half = 0x4000000000000000
        xmin = ArrayGet(aabb_addr, 0)
        ymin = ArrayGet(aabb_addr, 1)
        zmin = ArrayGet(aabb_addr, 2)
        xmax = ArrayGet(aabb_addr, 3)
        ymax = ArrayGet(aabb_addr, 4)
        zmax = ArrayGet(aabb_addr, 5)
        cx = Float_Div(Float_Add(xmin, xmax), half)
        cy = Float_Div(Float_Add(ymin, ymax), half)
        cz = Float_Div(Float_Add(zmin, zmax), half)
        dx = Float_Sub(xmax, xmin)
        dy = Float_Sub(ymax, ymin)
        dz = Float_Sub(zmax, zmin)
        // extent
        ext = dx
        IfCondition EqualTo(Float_Le(ext, dy), 1) ThenBlock: { ext = dy }
        IfCondition EqualTo(Float_Le(ext, dz), 1) ThenBlock: { ext = dz }
        IfCondition EqualTo(CAD_Num.IsZero(ext, 0), 1) ThenBlock: {
            ext = 0x3FF0000000000000
        }
        // fit in ~0.8 of min(w,h)
        mw = width
        IfCondition GreaterThan(height, 0) ThenBlock: {
            IfCondition LessThan(height, mw) ThenBlock: { mw = height }
        }
        // scale = 0.8 * mw / ext * zoom
        mw_r = Float_FromInt(mw)
        eight = 0x3FE999999999999A
        scale = Float_Div(Float_Mul(eight, mw_r), ext)
        CAD_View_State.fr_fit = scale
        CAD_View.EnsureCamDefaults()
        scale = Float_Mul(scale, CAD_View_State.zoom_r)
        ArraySet(frame_addr, 0, cx)
        ArraySet(frame_addr, 1, cy)
        ArraySet(frame_addr, 2, cz)
        ArraySet(frame_addr, 3, scale)
        ArraySet(frame_addr, 4, Float_FromInt(Divide(width, 2)))
        ArraySet(frame_addr, 5, Float_FromInt(Divide(height, 2)))
        CAD_View.BuildBasis()
        ReturnValue(0)
    }
}

// Project one world point → out [sx,sy,sz].
// Free orbit (view_mode 3): yaw about Z, pitch elevation; orthographic.
// Legacy 0/1/2 still handled; SetViewMode maps presets → free orbit angles.
Function.CAD_View.ProjectPoint {
    Input: x_r: Integer
    Input: y_r: Integer
    Input: z_r: Integer
    Input: frame_addr: Address
    Input: out_addr: Address
    Output: Integer
    Body: {
        CAD_View_State.pr_x = x_r
        CAD_View_State.pr_y = y_r
        CAD_View_State.pr_z = z_r
        cx = ArrayGet(frame_addr, 0)
        cy = ArrayGet(frame_addr, 1)
        cz = ArrayGet(frame_addr, 2)
        scale = ArrayGet(frame_addr, 3)
        hw = ArrayGet(frame_addr, 4)
        hh = ArrayGet(frame_addr, 5)
        px = Float_Sub(CAD_View_State.pr_x, cx)
        py = Float_Sub(CAD_View_State.pr_y, cy)
        pz = Float_Sub(CAD_View_State.pr_z, cz)
        mode = CAD_View_State.view_mode
        uu = 0
        vv = 0
        dd = 0
        // free orbit / all modes after SetViewMode seed
        IfCondition EqualTo(mode, 3) ThenBlock: {
            IfCondition EqualTo(CAD_View_State.b_ok, 0) ThenBlock: {
                CAD_View.BuildBasis()
            }
            // re-read after BuildBasis (nested Cos/Sin/Sqrt clobber locals)
            px = Float_Sub(CAD_View_State.pr_x, ArrayGet(frame_addr, 0))
            py = Float_Sub(CAD_View_State.pr_y, ArrayGet(frame_addr, 1))
            pz = Float_Sub(CAD_View_State.pr_z, ArrayGet(frame_addr, 2))
            scale = ArrayGet(frame_addr, 3)
            hw = ArrayGet(frame_addr, 4)
            hh = ArrayGet(frame_addr, 5)
            uu = Float_Add(Float_Add(Float_Mul(px, CAD_View_State.b_rx), Float_Mul(py, CAD_View_State.b_ry)), Float_Mul(pz, CAD_View_State.b_rz))
            vv = Float_Add(Float_Add(Float_Mul(px, CAD_View_State.b_ux), Float_Mul(py, CAD_View_State.b_uy)), Float_Mul(pz, CAD_View_State.b_uz))
            dd = Float_Add(Float_Add(Float_Mul(px, CAD_View_State.b_dx), Float_Mul(py, CAD_View_State.b_dy)), Float_Mul(pz, CAD_View_State.b_dz))
            uu = Float_Add(uu, CAD_View_State.pan_u)
            vv = Float_Add(vv, CAD_View_State.pan_v)
        }
        // legacy fallbacks if mode not 3
        IfCondition EqualTo(mode, 1) ThenBlock: {
            uu = px
            vv = py
            dd = pz
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            uu = px
            vv = pz
            dd = py
        }
        IfCondition EqualTo(mode, 0) ThenBlock: {
            is2 = 0x3FE6A09E667F3BCD
            is3 = 0x3FE279A74590331C
            is6 = 0x3FDA1E377A48DB31
            two = 0x4000000000000000
            uu = Float_Add(Float_Mul(Float_Sub(0, is2), px), Float_Mul(is2, py))
            vv = Float_Add(Float_Add(Float_Mul(Float_Sub(0, is6), px), Float_Mul(Float_Sub(0, is6), py)), Float_Mul(Float_Mul(two, is6), pz))
            dd = Float_Mul(is3, Float_Add(Float_Add(px, py), pz))
        }
        ArraySet(out_addr, 0, Float_Add(hw, Float_Mul(uu, scale)))
        ArraySet(out_addr, 1, Float_Sub(hh, Float_Mul(vv, scale)))
        ArraySet(out_addr, 2, dd)
        ReturnValue(0)
    }
}

// Legacy 2D net. Host draws the real cube. Kept as no-op so old callers are safe.
Function.CAD_View.DrawNavCube {
    Input: width: Integer
    Input: height: Integer
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

// Hit test nav cube. px,py in frame pixels. Returns view preset mode code:
// 0=iso 1=top 2=front 4=right 5=left 6=back 7=bottom, or -1 miss.
Function.CAD_View.HitNavCube {
    Input: px: Integer
    Input: py: Integer
    Input: width: Integer
    Input: height: Integer
    Output: Integer
    Body: {
        sz = 90
        mx = Subtract(width, 12)
        x0 = Subtract(mx, sz)
        y0 = 12
        s3 = Divide(sz, 3)
        IfCondition LessThan(px, x0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(px, Add(x0, sz)) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(py, y0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(py, Add(y0, Add(sz, Divide(s3, 2)))) ThenBlock: { ReturnValue(-1) }
        lx = Subtract(px, x0)
        ly = Subtract(py, y0)
        col = Divide(lx, s3)
        row = Divide(ly, s3)
        // row 0 top center
        IfCondition EqualTo(row, 0) ThenBlock: {
            IfCondition EqualTo(col, 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        // row 1 mid: L F R
        IfCondition EqualTo(row, 1) ThenBlock: {
            IfCondition EqualTo(col, 0) ThenBlock: { ReturnValue(5) }
            IfCondition EqualTo(col, 1) ThenBlock: { ReturnValue(2) }
            IfCondition EqualTo(col, 2) ThenBlock: { ReturnValue(4) }
        }
        // row 2 bottom
        IfCondition EqualTo(row, 2) ThenBlock: {
            IfCondition EqualTo(col, 1) ThenBlock: { ReturnValue(7) }
            ReturnValue(0)
        }
        // below: back
        IfCondition GreaterEqual(ly, sz) ThenBlock: { ReturnValue(6) }
        ReturnValue(0)
    }
}

// Project all verts → sx,sy,sz arrays (n floats each, parallel to verts)
Function.CAD_View.ProjectMesh {
    Input: mesh_addr: Address
    Input: frame_addr: Address
    Input: sx_addr: Address
    Input: sy_addr: Address
    Input: sz_addr: Address
    Output: Integer
    Body: {
        nv = ArrayGet(mesh_addr, 0)
        vb = ArrayGet(mesh_addr, 2)
        pt = Allocate(32)
        i = 0
        WhileLoop LessThan(i, nv) {
            o = Multiply(i, 3)
            CAD_View.ProjectPoint(ArrayGet(vb, o), ArrayGet(vb, Add(o, 1)), ArrayGet(vb, Add(o, 2)), frame_addr, pt)
            ArraySet(sx_addr, i, ArrayGet(pt, 0))
            ArraySet(sy_addr, i, ArrayGet(pt, 1))
            ArraySet(sz_addr, i, ArrayGet(pt, 2))
            i = Add(i, 1)
        }
        Deallocate(pt, 32)
        ReturnValue(nv)
    }
}

// Fill one triangle into FB with Z-buffer.
// Integer edge functions (two-sided). Float barycentric was not filling
// (edges still drew) — winding/Float_Le path rejected all interior pixels.
// pack: sx0,sy0,sz0, sx1,sy1,sz1, sx2,sy2,sz2, color, zbuf_addr, w, h
Function.CAD_View.FillTri {
    Input: pack_addr: Address
    Output: Integer
    Body: {
        sx0 = ArrayGet(pack_addr, 0)
        sy0 = ArrayGet(pack_addr, 1)
        sz0 = ArrayGet(pack_addr, 2)
        sx1 = ArrayGet(pack_addr, 3)
        sy1 = ArrayGet(pack_addr, 4)
        sz1 = ArrayGet(pack_addr, 5)
        sx2 = ArrayGet(pack_addr, 6)
        sy2 = ArrayGet(pack_addr, 7)
        sz2 = ArrayGet(pack_addr, 8)
        color = ArrayGet(pack_addr, 9)
        zbuf = ArrayGet(pack_addr, 10)
        w = ArrayGet(pack_addr, 11)
        h = ArrayGet(pack_addr, 12)
        ix0 = Float_ToInt(sx0)
        iy0 = Float_ToInt(sy0)
        ix1 = Float_ToInt(sx1)
        iy1 = Float_ToInt(sy1)
        ix2 = Float_ToInt(sx2)
        iy2 = Float_ToInt(sy2)
        minx = ix0
        IfCondition LessThan(ix1, minx) ThenBlock: { minx = ix1 }
        IfCondition LessThan(ix2, minx) ThenBlock: { minx = ix2 }
        maxx = ix0
        IfCondition GreaterThan(ix1, maxx) ThenBlock: { maxx = ix1 }
        IfCondition GreaterThan(ix2, maxx) ThenBlock: { maxx = ix2 }
        miny = iy0
        IfCondition LessThan(iy1, miny) ThenBlock: { miny = iy1 }
        IfCondition LessThan(iy2, miny) ThenBlock: { miny = iy2 }
        maxy = iy0
        IfCondition GreaterThan(iy1, maxy) ThenBlock: { maxy = iy1 }
        IfCondition GreaterThan(iy2, maxy) ThenBlock: { maxy = iy2 }
        IfCondition LessThan(minx, 0) ThenBlock: { minx = 0 }
        IfCondition LessThan(miny, 0) ThenBlock: { miny = 0 }
        IfCondition GreaterEqual(maxx, w) ThenBlock: { maxx = Subtract(w, 1) }
        IfCondition GreaterEqual(maxy, h) ThenBlock: { maxy = Subtract(h, 1) }
        IfCondition GreaterThan(minx, maxx) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(miny, maxy) ThenBlock: { ReturnValue(0) }
        // area2 = (x1-x0)*(y2-y0) - (y1-y0)*(x2-x0)
        area2 = Subtract(Multiply(Subtract(ix1, ix0), Subtract(iy2, iy0)), Multiply(Subtract(iy1, iy0), Subtract(ix2, ix0)))
        IfCondition EqualTo(area2, 0) ThenBlock: { ReturnValue(0) }
        y = miny
        WhileLoop LessEqual(y, maxy) {
            x = minx
            WhileLoop LessEqual(x, maxx) {
                e01 = Subtract(Multiply(Subtract(x, ix0), Subtract(iy1, iy0)), Multiply(Subtract(y, iy0), Subtract(ix1, ix0)))
                e12 = Subtract(Multiply(Subtract(x, ix1), Subtract(iy2, iy1)), Multiply(Subtract(y, iy1), Subtract(ix2, ix1)))
                e20 = Subtract(Multiply(Subtract(x, ix2), Subtract(iy0, iy2)), Multiply(Subtract(y, iy2), Subtract(ix0, ix2)))
                // y-down screen: interior has opposite sign to area2 from edge()
                ok = 0
                IfCondition GreaterThan(area2, 0) ThenBlock: {
                    IfCondition LessEqual(e01, 0) ThenBlock: {
                        IfCondition LessEqual(e12, 0) ThenBlock: {
                            IfCondition LessEqual(e20, 0) ThenBlock: { ok = 1 }
                        }
                    }
                }
                IfCondition LessThan(area2, 0) ThenBlock: {
                    IfCondition GreaterEqual(e01, 0) ThenBlock: {
                        IfCondition GreaterEqual(e12, 0) ThenBlock: {
                            IfCondition GreaterEqual(e20, 0) ThenBlock: { ok = 1 }
                        }
                    }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    // Interpolate view-depth (sz) with screen float barycentric.
                    // Larger sz = closer (ProjectPoint free-orbit dd).
                    px = Float_FromInt(x)
                    py = Float_FromInt(y)
                    den = Float_Add(Float_Mul(Float_Sub(sy1, sy2), Float_Sub(sx0, sx2)), Float_Mul(Float_Sub(sx2, sx1), Float_Sub(sy0, sy2)))
                    zz = sz0
                    IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                        a = Float_Div(Float_Add(Float_Mul(Float_Sub(sy1, sy2), Float_Sub(px, sx2)), Float_Mul(Float_Sub(sx2, sx1), Float_Sub(py, sy2))), den)
                        b = Float_Div(Float_Add(Float_Mul(Float_Sub(sy2, sy0), Float_Sub(px, sx2)), Float_Mul(Float_Sub(sx0, sx2), Float_Sub(py, sy2))), den)
                        c = Float_Sub(0x3FF0000000000000, Float_Add(a, b))
                        zz = Float_Add(Float_Add(Float_Mul(a, sz0), Float_Mul(b, sz1)), Float_Mul(c, sz2))
                    }
                    // mm-scale int key; bias so far negative depths still compare
                    zkey = Add(Float_ToInt(Float_Mul(zz, 0x40C3880000000000)), 1000000000)
                    zi = Add(Multiply(y, w), x)
                    zold = ArrayGet(zbuf, zi)
                    // closer (larger key) wins. opac<100: skip some pixels
                    // (no Z write) so the grid / rear faces show through.
                    IfCondition GreaterThan(zkey, zold) ThenBlock: {
                        op = CAD_View_State.opac
                        skip = 0
                        IfCondition LessThan(op, 100) ThenBlock: {
                            IfCondition LessThan(op, 20) ThenBlock: { op = 20 }
                            hv = Modulo(Add(Multiply(x, 13), Multiply(y, 7)), 100)
                            IfCondition GreaterEqual(hv, op) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(skip, 0) ThenBlock: {
                            ArraySet(zbuf, zi, zkey)
                            FB_SetPixel(x, y, color)
                        }
                    }
                }
                x = Add(x, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// Shade from a unit (or any) world normal · light. Same palette as ShadeColor.
Function.CAD_View.ShadeNormal {
    Input: nx: Integer
    Input: ny: Integer
    Input: nz: Integer
    Output: Integer
    Body: {
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 0) ThenBlock: {
            nx = Float_Div(nx, nl)
            ny = Float_Div(ny, nl)
            nz = Float_Div(nz, nl)
        }
        is3 = 0x3FE279A74590331C
        ndotl = Float_Add(Float_Add(Float_Mul(nx, is3), Float_Mul(ny, is3)), Float_Mul(nz, is3))
        // Two-sided. Tess winding is not reliable after blends; dimming
        // back faces made the whole body unreadable.
        IfCondition EqualTo(Float_Le(ndotl, 0), 1) ThenBlock: {
            ndotl = Float_Sub(0, ndotl)
        }
        amb = 0x3FD999999999999A
        dif = 0x3FE4CCCCCCCCCCCD
        sh = Float_Add(amb, Float_Mul(dif, ndotl))
        anx = nx
        IfCondition EqualTo(Float_Le(anx, 0), 1) ThenBlock: { anx = Float_Sub(0, anx) }
        any = ny
        IfCondition EqualTo(Float_Le(any, 0), 1) ThenBlock: { any = Float_Sub(0, any) }
        anz = nz
        IfCondition EqualTo(Float_Le(anz, 0), 1) ThenBlock: { anz = Float_Sub(0, anz) }
        br = 92
        bg = 172
        bb = 214
        maxc = anz
        IfCondition EqualTo(Float_Le(maxc, anx), 1) ThenBlock: { maxc = anx }
        IfCondition EqualTo(Float_Le(maxc, any), 1) ThenBlock: { maxc = any }
        IfCondition EqualTo(Float_Le(maxc, 0x3FED70A3D70A3D71), 0) ThenBlock: {
            IfCondition EqualTo(Float_Le(any, anz), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(anx, anz), 1) ThenBlock: {
                    br = 118
                    bg = 186
                    bb = 232
                }
            }
            IfCondition EqualTo(Float_Le(anz, anx), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(any, anx), 1) ThenBlock: {
                    br = 55
                    bg = 155
                    bb = 175
                }
            }
            IfCondition EqualTo(Float_Le(anz, any), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(anx, any), 1) ThenBlock: {
                    br = 110
                    bg = 135
                    bb = 190
                }
            }
        }
        rr = Float_ToInt(Float_Mul(Float_FromInt(br), sh))
        gg = Float_ToInt(Float_Mul(Float_FromInt(bg), sh))
        bb2 = Float_ToInt(Float_Mul(Float_FromInt(bb), sh))
        IfCondition LessThan(rr, 0) ThenBlock: { rr = 0 }
        IfCondition LessThan(gg, 0) ThenBlock: { gg = 0 }
        IfCondition LessThan(bb2, 0) ThenBlock: { bb2 = 0 }
        IfCondition GreaterThan(rr, 255) ThenBlock: { rr = 255 }
        IfCondition GreaterThan(gg, 255) ThenBlock: { gg = 255 }
        IfCondition GreaterThan(bb2, 255) ThenBlock: { bb2 = 255 }
        op = CAD_View_State.opac
        IfCondition LessThan(op, 20) ThenBlock: { op = 20 }
        IfCondition GreaterThan(op, 100) ThenBlock: { op = 100 }
        IfCondition GreaterThan(op, 70) ThenBlock: {
            boost = Divide(Subtract(op, 70), 30)
            rr = Add(rr, Multiply(boost, 20))
            gg = Add(gg, Multiply(boost, 12))
            bb2 = Add(bb2, Multiply(boost, 8))
        }
        IfCondition GreaterThan(rr, 255) ThenBlock: { rr = 255 }
        IfCondition GreaterThan(gg, 255) ThenBlock: { gg = 255 }
        IfCondition GreaterThan(bb2, 255) ThenBlock: { bb2 = 255 }
        ReturnValue(FB_RGB(rr, gg, bb2))
    }
}

// Shade color from world triangle normal · light. base teal.
Function.CAD_View.ShadeColor {
    Input: vb: Address
    Input: i0: Integer
    Input: i1: Integer
    Input: i2: Integer
    Output: Integer
    Body: {
        o0 = Multiply(i0, 3)
        o1 = Multiply(i1, 3)
        o2 = Multiply(i2, 3)
        e1x = Float_Sub(ArrayGet(vb, o1), ArrayGet(vb, o0))
        e1y = Float_Sub(ArrayGet(vb, Add(o1, 1)), ArrayGet(vb, Add(o0, 1)))
        e1z = Float_Sub(ArrayGet(vb, Add(o1, 2)), ArrayGet(vb, Add(o0, 2)))
        e2x = Float_Sub(ArrayGet(vb, o2), ArrayGet(vb, o0))
        e2y = Float_Sub(ArrayGet(vb, Add(o2, 1)), ArrayGet(vb, Add(o0, 1)))
        e2z = Float_Sub(ArrayGet(vb, Add(o2, 2)), ArrayGet(vb, Add(o0, 2)))
        // n = e1 × e2
        nx = Float_Sub(Float_Mul(e1y, e2z), Float_Mul(e1z, e2y))
        ny = Float_Sub(Float_Mul(e1z, e2x), Float_Mul(e1x, e2z))
        nz = Float_Sub(Float_Mul(e1x, e2y), Float_Mul(e1y, e2x))
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 0) ThenBlock: {
            nx = Float_Div(nx, nl)
            ny = Float_Div(ny, nl)
            nz = Float_Div(nz, nl)
        }
        ReturnValue(CAD_View.ShadeNormal(nx, ny, nz))
        is3 = 0x3FE279A74590331C
        ndotl = Float_Add(Float_Add(Float_Mul(nx, is3), Float_Mul(ny, is3)), Float_Mul(nz, is3))
        // abs for two-sided
        IfCondition EqualTo(Float_Le(ndotl, 0), 1) ThenBlock: {
            ndotl = Float_Sub(0, ndotl)
        }
        // shade = 0.55 + 0.45 * ndotl (more opaque body, less see-through)
        amb = 0x3FE199999999999A
        dif = 0x3FDCCCCCCCCCCCCD
        sh = Float_Add(amb, Float_Mul(dif, ndotl))
        // base RGB varies by dominant normal axis (face contrast)
        anx = nx
        IfCondition EqualTo(Float_Le(anx, 0), 1) ThenBlock: { anx = Float_Sub(0, anx) }
        any = ny
        IfCondition EqualTo(Float_Le(any, 0), 1) ThenBlock: { any = Float_Sub(0, any) }
        anz = nz
        IfCondition EqualTo(Float_Le(anz, 0), 1) ThenBlock: { anz = Float_Sub(0, anz) }
        br = 70
        bg = 150
        bb = 210
        // Axis tint only on nearly-planar faces (|n| along one axis).
        // A torus/cylinder has mixed normals — tinting those triangles
        // by dominant axis painted the fillet as an n-gon (stillngonglooking.png).
        maxc = anz
        IfCondition EqualTo(Float_Le(maxc, anx), 1) ThenBlock: { maxc = anx }
        IfCondition EqualTo(Float_Le(maxc, any), 1) ThenBlock: { maxc = any }
        IfCondition EqualTo(Float_Le(maxc, 0x3FED70A3D70A3D71), 0) ThenBlock: {
            // top-ish (Z): cooler; side X: teal; side Y: warmer
            IfCondition EqualTo(Float_Le(any, anz), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(anx, anz), 1) ThenBlock: {
                    br = 100
                    bg = 175
                    bb = 230
                }
            }
            IfCondition EqualTo(Float_Le(anz, anx), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(any, anx), 1) ThenBlock: {
                    br = 55
                    bg = 155
                    bb = 175
                }
            }
            IfCondition EqualTo(Float_Le(anz, any), 1) ThenBlock: {
                IfCondition EqualTo(Float_Le(anx, any), 1) ThenBlock: {
                    br = 110
                    bg = 135
                    bb = 190
                }
            }
        }
        rr = Float_ToInt(Float_Mul(Float_FromInt(br), sh))
        gg = Float_ToInt(Float_Mul(Float_FromInt(bg), sh))
        bb2 = Float_ToInt(Float_Mul(Float_FromInt(bb), sh))
        IfCondition LessThan(rr, 0) ThenBlock: { rr = 0 }
        IfCondition LessThan(gg, 0) ThenBlock: { gg = 0 }
        IfCondition LessThan(bb2, 0) ThenBlock: { bb2 = 0 }
        IfCondition GreaterThan(rr, 255) ThenBlock: { rr = 255 }
        IfCondition GreaterThan(gg, 255) ThenBlock: { gg = 255 }
        IfCondition GreaterThan(bb2, 255) ThenBlock: { bb2 = 255 }
        // High opac: punchier fill so stacked bosses read. Low: keep washed teal.
        op = CAD_View_State.opac
        IfCondition LessThan(op, 20) ThenBlock: { op = 20 }
        IfCondition GreaterThan(op, 100) ThenBlock: { op = 100 }
        IfCondition GreaterThan(op, 70) ThenBlock: {
            boost = Divide(Subtract(op, 70), 30)
            rr = Add(rr, Multiply(boost, 20))
            gg = Add(gg, Multiply(boost, 12))
            bb2 = Add(bb2, Multiply(boost, 8))
        }
        IfCondition GreaterThan(rr, 255) ThenBlock: { rr = 255 }
        IfCondition GreaterThan(gg, 255) ThenBlock: { gg = 255 }
        IfCondition GreaterThan(bb2, 255) ThenBlock: { bb2 = 255 }
        ReturnValue(FB_RGB(rr, gg, bb2))
    }
}

Function.CAD_View.SetOcclude {
    Input: on: Integer
    Output: Integer
    Body: {
        CAD_View_State.ol_occlude = on
        ReturnValue(on)
    }
}

Function.CAD_View.SetOpacity {
    Input: pct: Integer
    Output: Integer
    Body: {
        p = pct
        IfCondition LessThan(p, 20) ThenBlock: { p = 20 }
        IfCondition GreaterThan(p, 100) ThenBlock: { p = 100 }
        CAD_View_State.opac = p
        ReturnValue(p)
    }
}

// Draw mesh into already-inited FB. Returns tris drawn or -1.
Function.CAD_View.DrawMesh {
    Input: mesh_addr: Address
    Input: width: Integer
    Input: height: Integer
    Output: Integer
    Body: {
        // promote legacy iso/top/front to free orbit once
        IfCondition LessThan(CAD_View_State.view_mode, 3) ThenBlock: {
            CAD_View.SetViewMode(CAD_View_State.view_mode)
        }
        CAD_View.EnsureCamDefaults()
        nv = ArrayGet(mesh_addr, 0)
        nt = ArrayGet(mesh_addr, 1)
        vb = ArrayGet(mesh_addr, 2)
        ib = ArrayGet(mesh_addr, 3)
        IfCondition LessThan(nt, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(nv, 3) ThenBlock: { ReturnValue(-1) }
        aabb = Allocate(64)
        frame = Allocate(64)
        CAD_View.MeshBounds(mesh_addr, aabb)
        CAD_View.BuildFrame(aabb, width, height, frame)
        CAD_View_State.fr_cx = ArrayGet(frame, 0)
        CAD_View_State.fr_cy = ArrayGet(frame, 1)
        CAD_View_State.fr_cz = ArrayGet(frame, 2)
        CAD_View_State.fr_sc = ArrayGet(frame, 3)
        CAD_View_State.fr_hw = ArrayGet(frame, 4)
        CAD_View_State.fr_hh = ArrayGet(frame, 5)
        CAD_View_State.fr_ok = 1
        sx = Allocate(262144)
        sy = Allocate(262144)
        sz = Allocate(262144)
        CAD_View.ProjectMesh(mesh_addr, frame, sx, sy, sz)
        // z-buffer: larger key = closer to camera (view-space dd).
        // Init to INT_MIN so any real depth wins first write.
        npix = Multiply(width, height)
        zbytes = Multiply(npix, 8)
        zbuf = Allocate(zbytes)
        zinit = -2147483647
        ArraySet(zbuf, 0, zinit)
        zn = 8
        WhileLoop LessThan(zn, zbytes) {
            cpy = zn
            left = Subtract(zbytes, zn)
            IfCondition GreaterThan(cpy, left) ThenBlock: { cpy = left }
            MemoryCopy(Add(zbuf, zn), zbuf, cpy)
            zn = Add(zn, cpy)
        }
        // clear FB dark gray
        FB_Clear(FB_RGB(32, 32, 40))
        pack = Allocate(128)
        ArraySet(pack, 10, zbuf)
        ArraySet(pack, 11, width)
        ArraySet(pack, 12, height)
        t = 0
        WhileLoop LessThan(t, nt) {
            io = Multiply(t, 3)
            i0 = ArrayGet(ib, io)
            i1 = ArrayGet(ib, Add(io, 1))
            i2 = ArrayGet(ib, Add(io, 2))
            col = CAD_View.ShadeColor(vb, i0, i1, i2)
            ArraySet(pack, 0, ArrayGet(sx, i0))
            ArraySet(pack, 1, ArrayGet(sy, i0))
            ArraySet(pack, 2, ArrayGet(sz, i0))
            ArraySet(pack, 3, ArrayGet(sx, i1))
            ArraySet(pack, 4, ArrayGet(sy, i1))
            ArraySet(pack, 5, ArrayGet(sz, i1))
            ArraySet(pack, 6, ArrayGet(sx, i2))
            ArraySet(pack, 7, ArrayGet(sy, i2))
            ArraySet(pack, 8, ArrayGet(sz, i2))
            ArraySet(pack, 9, col)
            CAD_View.FillTri(pack)
            t = Add(t, 1)
        }
        IfCondition NotEqual(CAD_View_State.zb, 0) ThenBlock: {
            Deallocate(CAD_View_State.zb, CAD_View_State.zb_bytes)
        }
        CAD_View_State.zb = zbuf
        CAD_View_State.zb_w = width
        CAD_View_State.zb_h = height
        CAD_View_State.zb_bytes = zbytes
        // optional edge overlay (dark crease lines when wire on)
        IfCondition NotEqual(CAD_View_State.wire, 0) ThenBlock: {
            ecol = FB_RGB(20, 24, 32)
            t = 0
            WhileLoop LessThan(t, nt) {
                io = Multiply(t, 3)
                i0 = ArrayGet(ib, io)
                i1 = ArrayGet(ib, Add(io, 1))
                i2 = ArrayGet(ib, Add(io, 2))
                CAD_View.DrawEdge2D(ArrayGet(sx, i0), ArrayGet(sy, i0), ArrayGet(sx, i1), ArrayGet(sy, i1), ecol)
                CAD_View.DrawEdge2D(ArrayGet(sx, i1), ArrayGet(sy, i1), ArrayGet(sx, i2), ArrayGet(sy, i2), ecol)
                CAD_View.DrawEdge2D(ArrayGet(sx, i2), ArrayGet(sy, i2), ArrayGet(sx, i0), ArrayGet(sy, i0), ecol)
                t = Add(t, 1)
            }
        }
        CAD_View_State.tris_draw = nt
        CAD_View_State.last_nv = nv
        CAD_View_State.last_nt = nt
        Deallocate(pack, 128)
        Deallocate(sx, 262144)
        Deallocate(sy, 262144)
        Deallocate(sz, 262144)
        Deallocate(frame, 64)
        Deallocate(aabb, 64)
        ReturnValue(nt)
    }
}

// Screen-space edge (integer Bresenham via FB_Line)
Function.CAD_View.DrawEdge2D {
    Input: x0_r: Integer
    Input: y0_r: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        x0 = Float_ToInt(x0_r)
        y0 = Float_ToInt(y0_r)
        x1 = Float_ToInt(x1_r)
        y1 = Float_ToInt(y1_r)
        FB_Line(x0, y0, x1, y1, color)
        ReturnValue(0)
    }
}

// 1 if this screen pixel already has the solid (z-buffer hit).
Function.CAD_View.Covered {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_View_State.zb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(x, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(y, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(x, CAD_View_State.zb_w) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(y, CAD_View_State.zb_h) ThenBlock: { ReturnValue(0) }
        zold = ArrayGet(CAD_View_State.zb, Add(Multiply(y, CAD_View_State.zb_w), x))
        IfCondition LessEqual(zold, -2147483646) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Plot a construction-plane pixel only where the solid does not cover it.
Function.CAD_View.PlotOpen {
    Input: x: Integer
    Input: y: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_View_State.ol_occlude, 1) ThenBlock: {
            IfCondition EqualTo(CAD_View.Covered(x, y), 1) ThenBlock: { ReturnValue(0) }
        }
        FB_SetPixel(x, y, col)
        ReturnValue(1)
    }
}

// Solid → mesh → headless FB (in-memory). Reuses FB if size matches. Returns 0 ok.
// Does not write BMP. Call SaveFBToBMP / WriteFBRaw after.
Function.CAD_View.RenderSolidToFB {
    Input: solid_handle: Integer
    Input: width: Integer
    Input: height: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(width, 16) ThenBlock: { width = 640 }
        IfCondition LessThan(height, 16) ThenBlock: { height = 480 }
        mesh = CAD_View_State.cache_hdr
        reuse = 0
        IfCondition NotEqual(mesh, 0) ThenBlock: {
            IfCondition EqualTo(CAD_View_State.cache_solid, solid_handle) ThenBlock: {
                IfCondition GreaterThan(ArrayGet(mesh, 1), 0) ThenBlock: { reuse = 1 }
            }
        }
        IfCondition EqualTo(reuse, 0) ThenBlock: {
            IfCondition EqualTo(CAD_View_State.cache_hdr, 0) ThenBlock: {
                CAD_View_State.cache_hdr = Allocate(48)
            }
            mesh = CAD_View_State.cache_hdr
            IfCondition EqualTo(mesh, 0) ThenBlock: { ReturnValue(-2) }
            defl = CAD_View.PixelSagDefl(solid_handle, width, height)
            nt = CAD_Tess.MeshSolid(solid_handle, defl, mesh)
            IfCondition LessThan(nt, 1) ThenBlock: {
                nt = CAD_Tess.MeshSolid(solid_handle, 0x3F947AE147AE147B, mesh)
            }
            IfCondition LessThan(nt, 1) ThenBlock: {
                ReturnValue(-2)
            }
            CAD_View_State.cache_solid = solid_handle
        }
        // init headless once or on resize
        need = 0
        IfCondition EqualTo(FB.initialized, 0) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.width, width) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.height, height) ThenBlock: { need = 1 }
        IfCondition EqualTo(need, 1) ThenBlock: {
            IfCondition EqualTo(FB_InitHeadless(width, height), 0) ThenBlock: {
                CAD_View.InvalidateMesh()
                ReturnValue(-3)
            }
        }
        FB_Clear(FB_RGB(28, 32, 40))
        nd = CAD_View.DrawMesh(mesh, width, height)
        IfCondition LessThan(nd, 1) ThenBlock: { ReturnValue(-4) }
        ReturnValue(0)
    }
}

// Dump current FB as raw ARGB32 top-down for host presenters.
// meta.bin: 3× int32 LE = width, height, pitch (NOT 64-bit ArraySet words).
// frame.raw: pitch*height bytes BGRA (little-endian as stored by FB_SetPixel).
Function.CAD_View.WriteFBRaw {
    Input: meta_path: Address
    Input: raw_path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(meta_path, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(raw_path, 0) ThenBlock: { ReturnValue(-1) }
        // Read FB pool directly — FB_Get* clobber after hex-pad + AddCircle.
        CAD_View_State.raw_w = FB.width
        CAD_View_State.raw_h = FB.height
        CAD_View_State.raw_pitch = FB.pitch
        CAD_View_State.raw_buf = FB.fb_ptr
        IfCondition EqualTo(FB.double_buffered, 1) ThenBlock: {
            CAD_View_State.raw_buf = FB.back_buffer
        }
        IfCondition EqualTo(CAD_View_State.raw_buf, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(CAD_View_State.raw_w, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(CAD_View_State.raw_h, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(CAD_View_State.raw_h, 4096) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(CAD_View_State.raw_pitch, 32768) ThenBlock: { ReturnValue(-1) }
        fd = SystemCall(2, meta_path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-2) }
        // persistent 16-byte header — Allocate after hex-pad+circle SEGVd
        IfCondition EqualTo(CAD_View_State.raw_hdr, 0) ThenBlock: {
            CAD_View_State.raw_hdr = Allocate(16)
        }
        IfCondition EqualTo(CAD_View_State.raw_hdr, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(-4)
        }
        CAD_View.WriteLE32(CAD_View_State.raw_hdr, 0, CAD_View_State.raw_w)
        CAD_View.WriteLE32(CAD_View_State.raw_hdr, 4, CAD_View_State.raw_h)
        CAD_View.WriteLE32(CAD_View_State.raw_hdr, 8, CAD_View_State.raw_pitch)
        SystemCall(1, fd, CAD_View_State.raw_hdr, 12)
        SystemCall(3, fd, 0, 0)
        fd = SystemCall(2, raw_path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-3) }
        nbytes = Multiply(CAD_View_State.raw_pitch, CAD_View_State.raw_h)
        SystemCall(1, fd, CAD_View_State.raw_buf, nbytes)
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }
}

// Solid → mesh → headless FB → BMP path. Returns 0 ok.
Function.CAD_View.RenderSolidToBMP {
    Input: solid_handle: Integer
    Input: width: Integer
    Input: height: Integer
    Input: path_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path_addr, 0) ThenBlock: { ReturnValue(-1) }
        rc = CAD_View.RenderSolidToFB(solid_handle, width, height)
        IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
        ReturnValue(CAD_View.SaveFBToBMP(path_addr))
    }
}

// Fork host image viewer (eog preferred) on BMP path — isolated OS window, not AOS.
// Returns child pid >0, or -1. Does not wait (CLI can exit; window stays).
Function.CAD_View.OpenHostViewer {
    Input: path_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path_addr, 0) ThenBlock: { ReturnValue(-1) }
        pid = SystemCall(57)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            // child
            argv = Allocate(32)
            // try eog first
            StoreValue(argv, "/usr/bin/eog")
            StoreValue(Add(argv, 8), path_addr)
            StoreValue(Add(argv, 16), 0)
            envp = Allocate(8)
            StoreValue(envp, 0)
            SystemCall(59, "/usr/bin/eog", argv, envp)
            // fallback xdg-open
            StoreValue(argv, "/usr/bin/xdg-open")
            StoreValue(Add(argv, 8), path_addr)
            StoreValue(Add(argv, 16), 0)
            SystemCall(59, "/usr/bin/xdg-open", argv, envp)
            SystemCall(60, 1, 0, 0)
        }
        ReturnValue(pid)
    }
}
