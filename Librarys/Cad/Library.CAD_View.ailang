// CAD.View — software viewport: solid → Tess mesh → headless FB → BMP
// Host OS: no AOS required. Screenshot path for agent look-ats.
// Optional: OpenHostViewer forks eog/xdg-open on the BMP (isolated window).
//
// Mesh layout (CAD_Tess): [n_verts, n_tris, v_base xyz…, i_base i0i1i2…]
// Projection: orthographic isometric-ish (view dir ~ +X+Y+Z).
// Raster: barycentric fill + integer Z-buffer + N·L shade.
//
// SysV: ≤5 Inputs. Flat control flow.

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Tess
LibraryImport.Display.Render.Framebuffer
LibraryImport.StringUtils

// view_mode: 0=iso 1=top(+Z) 2=front(+Y looking -Y → XZ)
// wire: 1 draw tri edges, 0 shaded only
// defl: IEEE double mesh deflection (0 = Tess default)
FixedPool.CAD_View_State {
    "shots":      Initialize=0
    "tris_draw":  Initialize=0
    "last_nv":    Initialize=0
    "last_nt":    Initialize=0
    "wire":       Initialize=1, CanChange=True
    "view_mode":  Initialize=0, CanChange=True
    "defl_r":     Initialize=0, CanChange=True
}

Function.CAD_View.SetWire {
    Input: on: Integer
    Output: Integer
    Body: {
        CAD_View_State.wire = on
        ReturnValue(0)
    }
}

Function.CAD_View.SetViewMode {
    Input: mode: Integer
    Output: Integer
    Body: {
        CAD_View_State.view_mode = mode
        ReturnValue(0)
    }
}

Function.CAD_View.SetDefl {
    Input: defl_r: Integer
    Output: Integer
    Body: {
        CAD_View_State.defl_r = defl_r
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// BMP helpers (24-bit BGR, bottom-up) — path-arg screenshot, no ffmpeg
// -------------------------------------------------------------------------
Function.CAD_View.WriteLE16 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(val, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
        ReturnValue(0)
    }
}

Function.CAD_View.WriteLE32 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(val, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
        SetByte(buf, Add(off, 2), BitwiseAnd(ShiftRight(val, 16), 255))
        SetByte(buf, Add(off, 3), BitwiseAnd(ShiftRight(val, 24), 255))
        ReturnValue(0)
    }
}

// Save current headless/draw FB to path as 24-bit BMP. Returns 0 ok, negative fail.
Function.CAD_View.SaveFBToBMP {
    Input: path_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path_addr, 0) ThenBlock: { ReturnValue(-1) }
        w = FB_GetWidth()
        h = FB_GetHeight()
        fb_buf = FB_GetDrawBuffer()
        fb_pitch = FB.pitch
        IfCondition EqualTo(fb_buf, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(w, 1) ThenBlock: { ReturnValue(-1) }
        row_bytes = Multiply(w, 3)
        rem = Modulo(row_bytes, 4)
        pad = 0
        IfCondition NotEqual(rem, 0) ThenBlock: { pad = Subtract(4, rem) }
        bmp_stride = Add(row_bytes, pad)
        pix_size = Multiply(bmp_stride, h)
        file_size = Add(54, pix_size)
        fd = SystemCall(2, path_addr, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-16) }
        hdr = Allocate(64)
        zi = 0
        WhileLoop LessThan(zi, 54) {
            SetByte(hdr, zi, 0)
            zi = Add(zi, 1)
        }
        SetByte(hdr, 0, 66)
        SetByte(hdr, 1, 77)
        CAD_View.WriteLE32(hdr, 2, file_size)
        CAD_View.WriteLE32(hdr, 10, 54)
        CAD_View.WriteLE32(hdr, 14, 40)
        CAD_View.WriteLE32(hdr, 18, w)
        CAD_View.WriteLE32(hdr, 22, h)
        CAD_View.WriteLE16(hdr, 26, 1)
        CAD_View.WriteLE16(hdr, 28, 24)
        CAD_View.WriteLE32(hdr, 34, pix_size)
        SystemCall(1, fd, hdr, 54)
        Deallocate(hdr, 64)
        row_buf = Allocate(Add(bmp_stride, 8))
        y = Subtract(h, 1)
        WhileLoop GreaterEqual(y, 0) {
            src = Add(fb_buf, Multiply(y, fb_pitch))
            x = 0
            WhileLoop LessThan(x, w) {
                si = Multiply(x, 4)
                di = Multiply(x, 3)
                SetByte(row_buf, di, GetByte(src, si))
                SetByte(row_buf, Add(di, 1), GetByte(src, Add(si, 1)))
                SetByte(row_buf, Add(di, 2), GetByte(src, Add(si, 2)))
                x = Add(x, 1)
            }
            pi = 0
            WhileLoop LessThan(pi, pad) {
                SetByte(row_buf, Add(row_bytes, pi), 0)
                pi = Add(pi, 1)
            }
            SystemCall(1, fd, row_buf, bmp_stride)
            y = Subtract(y, 1)
        }
        Deallocate(row_buf, Add(bmp_stride, 8))
        SystemCall(3, fd, 0, 0)
        CAD_View_State.shots = Add(CAD_View_State.shots, 1)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Mesh AABB → out_addr [xmin,ymin,zmin,xmax,ymax,zmax]
// -------------------------------------------------------------------------
Function.CAD_View.MeshAABB {
    Input: mesh_addr: Address
    Input: out_addr: Address
    Output: Integer
    Body: {
        nv = ArrayGet(mesh_addr, 0)
        vb = ArrayGet(mesh_addr, 2)
        IfCondition LessThan(nv, 1) ThenBlock: { ReturnValue(-1) }
        xmin = ArrayGet(vb, 0)
        ymin = ArrayGet(vb, 1)
        zmin = ArrayGet(vb, 2)
        xmax = xmin
        ymax = ymin
        zmax = zmin
        i = 1
        WhileLoop LessThan(i, nv) {
            o = Multiply(i, 3)
            x = ArrayGet(vb, o)
            y = ArrayGet(vb, Add(o, 1))
            z = ArrayGet(vb, Add(o, 2))
            IfCondition EqualTo(Float_Le(x, xmin), 1) ThenBlock: { xmin = x }
            IfCondition EqualTo(Float_Le(xmax, x), 1) ThenBlock: { xmax = x }
            IfCondition EqualTo(Float_Le(y, ymin), 1) ThenBlock: { ymin = y }
            IfCondition EqualTo(Float_Le(ymax, y), 1) ThenBlock: { ymax = y }
            IfCondition EqualTo(Float_Le(z, zmin), 1) ThenBlock: { zmin = z }
            IfCondition EqualTo(Float_Le(zmax, z), 1) ThenBlock: { zmax = z }
            i = Add(i, 1)
        }
        ArraySet(out_addr, 0, xmin)
        ArraySet(out_addr, 1, ymin)
        ArraySet(out_addr, 2, zmin)
        ArraySet(out_addr, 3, xmax)
        ArraySet(out_addr, 4, ymax)
        ArraySet(out_addr, 5, zmax)
        ReturnValue(0)
    }
}

// -------------------------------------------------------------------------
// Project mesh verts → screen pack:
//   sx_base[i], sy_base[i] as Float (pixel coords)
//   sz_base[i] as Float depth (smaller = closer)
// frame pack: [cx,cy,cz, scale, half_w, half_h] floats
// -------------------------------------------------------------------------
Function.CAD_View.BuildFrame {
    Input: aabb_addr: Address
    Input: width: Integer
    Input: height: Integer
    Input: frame_addr: Address
    Output: Integer
    Body: {
        half = 0x4000000000000000
        xmin = ArrayGet(aabb_addr, 0)
        ymin = ArrayGet(aabb_addr, 1)
        zmin = ArrayGet(aabb_addr, 2)
        xmax = ArrayGet(aabb_addr, 3)
        ymax = ArrayGet(aabb_addr, 4)
        zmax = ArrayGet(aabb_addr, 5)
        cx = Float_Div(Float_Add(xmin, xmax), half)
        cy = Float_Div(Float_Add(ymin, ymax), half)
        cz = Float_Div(Float_Add(zmin, zmax), half)
        dx = Float_Sub(xmax, xmin)
        dy = Float_Sub(ymax, ymin)
        dz = Float_Sub(zmax, zmin)
        // extent
        ext = dx
        IfCondition EqualTo(Float_Le(ext, dy), 1) ThenBlock: { ext = dy }
        IfCondition EqualTo(Float_Le(ext, dz), 1) ThenBlock: { ext = dz }
        IfCondition EqualTo(CAD_Num.IsZero(ext, 0), 1) ThenBlock: {
            ext = 0x3FF0000000000000
        }
        // fit in ~0.8 of min(w,h)
        mw = width
        IfCondition GreaterThan(height, 0) ThenBlock: {
            IfCondition LessThan(height, mw) ThenBlock: { mw = height }
        }
        // scale = 0.8 * mw / ext
        mw_r = Float_FromInt(mw)
        eight = 0x3FE999999999999A
        scale = Float_Div(Float_Mul(eight, mw_r), ext)
        ArraySet(frame_addr, 0, cx)
        ArraySet(frame_addr, 1, cy)
        ArraySet(frame_addr, 2, cz)
        ArraySet(frame_addr, 3, scale)
        ArraySet(frame_addr, 4, Float_FromInt(Divide(width, 2)))
        ArraySet(frame_addr, 5, Float_FromInt(Divide(height, 2)))
        ReturnValue(0)
    }
}

// Project one world point → out [sx,sy,sz].
// view_mode 0 iso: u=(-1/√2,1/√2,0) v=(-1/√6,-1/√6,2/√6) view=(1,1,1)/√3
// view_mode 1 top:  screen X=x Y=y depth=z
// view_mode 2 front: screen X=x Y=z depth=y
Function.CAD_View.ProjectPoint {
    Input: x_r: Integer
    Input: y_r: Integer
    Input: z_r: Integer
    Input: frame_addr: Address
    Input: out_addr: Address
    Output: Integer
    Body: {
        cx = ArrayGet(frame_addr, 0)
        cy = ArrayGet(frame_addr, 1)
        cz = ArrayGet(frame_addr, 2)
        scale = ArrayGet(frame_addr, 3)
        hw = ArrayGet(frame_addr, 4)
        hh = ArrayGet(frame_addr, 5)
        px = Float_Sub(x_r, cx)
        py = Float_Sub(y_r, cy)
        pz = Float_Sub(z_r, cz)
        mode = CAD_View_State.view_mode
        uu = 0
        vv = 0
        dd = 0
        IfCondition EqualTo(mode, 1) ThenBlock: {
            uu = px
            vv = py
            dd = pz
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            uu = px
            vv = pz
            dd = py
        }
        IfCondition EqualTo(mode, 0) ThenBlock: {
            is2 = 0x3FE6A09E667F3BCD
            is3 = 0x3FE279A74590331C
            is6 = 0x3FDA1E377A48DB31
            two = 0x4000000000000000
            uu = Float_Add(Float_Mul(Float_Sub(0, is2), px), Float_Mul(is2, py))
            vv = Float_Add(Float_Add(Float_Mul(Float_Sub(0, is6), px), Float_Mul(Float_Sub(0, is6), py)), Float_Mul(Float_Mul(two, is6), pz))
            dd = Float_Mul(is3, Float_Add(Float_Add(px, py), pz))
        }
        IfCondition GreaterThan(mode, 2) ThenBlock: {
            is2 = 0x3FE6A09E667F3BCD
            is3 = 0x3FE279A74590331C
            is6 = 0x3FDA1E377A48DB31
            two = 0x4000000000000000
            uu = Float_Add(Float_Mul(Float_Sub(0, is2), px), Float_Mul(is2, py))
            vv = Float_Add(Float_Add(Float_Mul(Float_Sub(0, is6), px), Float_Mul(Float_Sub(0, is6), py)), Float_Mul(Float_Mul(two, is6), pz))
            dd = Float_Mul(is3, Float_Add(Float_Add(px, py), pz))
        }
        ArraySet(out_addr, 0, Float_Add(hw, Float_Mul(uu, scale)))
        ArraySet(out_addr, 1, Float_Sub(hh, Float_Mul(vv, scale)))
        ArraySet(out_addr, 2, dd)
        ReturnValue(0)
    }
}

// Project all verts → sx,sy,sz arrays (n floats each, parallel to verts)
Function.CAD_View.ProjectMesh {
    Input: mesh_addr: Address
    Input: frame_addr: Address
    Input: sx_addr: Address
    Input: sy_addr: Address
    Input: sz_addr: Address
    Output: Integer
    Body: {
        nv = ArrayGet(mesh_addr, 0)
        vb = ArrayGet(mesh_addr, 2)
        pt = Allocate(32)
        i = 0
        WhileLoop LessThan(i, nv) {
            o = Multiply(i, 3)
            CAD_View.ProjectPoint(ArrayGet(vb, o), ArrayGet(vb, Add(o, 1)), ArrayGet(vb, Add(o, 2)), frame_addr, pt)
            ArraySet(sx_addr, i, ArrayGet(pt, 0))
            ArraySet(sy_addr, i, ArrayGet(pt, 1))
            ArraySet(sz_addr, i, ArrayGet(pt, 2))
            i = Add(i, 1)
        }
        Deallocate(pt, 32)
        ReturnValue(nv)
    }
}

// Fill one triangle (indices i0,i1,i2) into FB with Z-buffer (sz float, closer = smaller dd from view).
// zbuf: integer array w*h, stores scaled depth (higher = closer for comparison after negate).
// Use: store Float_ToInt(sz * 1e6); closer has smaller sz if camera looks along +view from -inf...
// Our dd = view·(p-c); camera sits at +view direction looking toward center, so larger dd = closer to camera.
// z-test: draw if new_dd > zbuf (farther in +view = nearer camera). Init zbuf to very negative.
Function.CAD_View.FillTri {
    Input: pack_addr: Address
    Output: Integer
    Body: {
        // pack: sx0,sy0,sz0, sx1,sy1,sz1, sx2,sy2,sz2, color, zbuf_addr, w, h  (13 slots)
        sx0 = ArrayGet(pack_addr, 0)
        sy0 = ArrayGet(pack_addr, 1)
        sz0 = ArrayGet(pack_addr, 2)
        sx1 = ArrayGet(pack_addr, 3)
        sy1 = ArrayGet(pack_addr, 4)
        sz1 = ArrayGet(pack_addr, 5)
        sx2 = ArrayGet(pack_addr, 6)
        sy2 = ArrayGet(pack_addr, 7)
        sz2 = ArrayGet(pack_addr, 8)
        color = ArrayGet(pack_addr, 9)
        zbuf = ArrayGet(pack_addr, 10)
        w = ArrayGet(pack_addr, 11)
        h = ArrayGet(pack_addr, 12)
        // integer bbox
        ix0 = Float_ToInt(sx0)
        iy0 = Float_ToInt(sy0)
        ix1 = Float_ToInt(sx1)
        iy1 = Float_ToInt(sy1)
        ix2 = Float_ToInt(sx2)
        iy2 = Float_ToInt(sy2)
        minx = ix0
        IfCondition LessThan(ix1, minx) ThenBlock: { minx = ix1 }
        IfCondition LessThan(ix2, minx) ThenBlock: { minx = ix2 }
        maxx = ix0
        IfCondition GreaterThan(ix1, maxx) ThenBlock: { maxx = ix1 }
        IfCondition GreaterThan(ix2, maxx) ThenBlock: { maxx = ix2 }
        miny = iy0
        IfCondition LessThan(iy1, miny) ThenBlock: { miny = iy1 }
        IfCondition LessThan(iy2, miny) ThenBlock: { miny = iy2 }
        maxy = iy0
        IfCondition GreaterThan(iy1, maxy) ThenBlock: { maxy = iy1 }
        IfCondition GreaterThan(iy2, maxy) ThenBlock: { maxy = iy2 }
        IfCondition LessThan(minx, 0) ThenBlock: { minx = 0 }
        IfCondition LessThan(miny, 0) ThenBlock: { miny = 0 }
        IfCondition GreaterEqual(maxx, w) ThenBlock: { maxx = Subtract(w, 1) }
        IfCondition GreaterEqual(maxy, h) ThenBlock: { maxy = Subtract(h, 1) }
        // denom = (y1-y2)*(x0-x2)+(x2-x1)*(y0-y2)
        den = Float_Add(Float_Mul(Float_Sub(sy1, sy2), Float_Sub(sx0, sx2)), Float_Mul(Float_Sub(sx2, sx1), Float_Sub(sy0, sy2)))
        IfCondition EqualTo(CAD_Num.IsZero(den, 0), 1) ThenBlock: { ReturnValue(0) }
        // million scale for depth int
        mil = 0x412E848000000000
        y = miny
        WhileLoop LessEqual(y, maxy) {
            x = minx
            WhileLoop LessEqual(x, maxx) {
                px = Float_FromInt(x)
                py = Float_FromInt(y)
                // a,b,c barycentric
                a = Float_Div(Float_Add(Float_Mul(Float_Sub(sy1, sy2), Float_Sub(px, sx2)), Float_Mul(Float_Sub(sx2, sx1), Float_Sub(py, sy2))), den)
                b = Float_Div(Float_Add(Float_Mul(Float_Sub(sy2, sy0), Float_Sub(px, sx2)), Float_Mul(Float_Sub(sx0, sx2), Float_Sub(py, sy2))), den)
                c = Float_Sub(0x3FF0000000000000, Float_Add(a, b))
                // inside if a,b,c >= -eps
                eps = 0xBF50624DD2F1A9FC
                ok = 1
                IfCondition EqualTo(Float_Le(a, eps), 1) ThenBlock: { ok = 0 }
                IfCondition EqualTo(Float_Le(b, eps), 1) ThenBlock: { ok = 0 }
                IfCondition EqualTo(Float_Le(c, eps), 1) ThenBlock: { ok = 0 }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    zz = Float_Add(Float_Add(Float_Mul(a, sz0), Float_Mul(b, sz1)), Float_Mul(c, sz2))
                    zkey = Float_ToInt(Float_Mul(zz, mil))
                    zi = Add(Multiply(y, w), x)
                    zold = ArrayGet(zbuf, zi)
                    // larger dd = closer; init zbuf to 0x8000000000000000 min signed? use very small
                    // init with -2e9; draw if zkey > zold
                    IfCondition GreaterThan(zkey, zold) ThenBlock: {
                        ArraySet(zbuf, zi, zkey)
                        FB_SetPixel(x, y, color)
                    }
                }
                x = Add(x, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// Shade color from world triangle normal · light. base teal.
Function.CAD_View.ShadeColor {
    Input: vb: Address
    Input: i0: Integer
    Input: i1: Integer
    Input: i2: Integer
    Output: Integer
    Body: {
        o0 = Multiply(i0, 3)
        o1 = Multiply(i1, 3)
        o2 = Multiply(i2, 3)
        e1x = Float_Sub(ArrayGet(vb, o1), ArrayGet(vb, o0))
        e1y = Float_Sub(ArrayGet(vb, Add(o1, 1)), ArrayGet(vb, Add(o0, 1)))
        e1z = Float_Sub(ArrayGet(vb, Add(o1, 2)), ArrayGet(vb, Add(o0, 2)))
        e2x = Float_Sub(ArrayGet(vb, o2), ArrayGet(vb, o0))
        e2y = Float_Sub(ArrayGet(vb, Add(o2, 1)), ArrayGet(vb, Add(o0, 1)))
        e2z = Float_Sub(ArrayGet(vb, Add(o2, 2)), ArrayGet(vb, Add(o0, 2)))
        // n = e1 × e2
        nx = Float_Sub(Float_Mul(e1y, e2z), Float_Mul(e1z, e2y))
        ny = Float_Sub(Float_Mul(e1z, e2x), Float_Mul(e1x, e2z))
        nz = Float_Sub(Float_Mul(e1x, e2y), Float_Mul(e1y, e2x))
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 0) ThenBlock: {
            nx = Float_Div(nx, nl)
            ny = Float_Div(ny, nl)
            nz = Float_Div(nz, nl)
        }
        // L = normalize(1,1,1)
        is3 = 0x3FE279A74590331C
        ndotl = Float_Add(Float_Add(Float_Mul(nx, is3), Float_Mul(ny, is3)), Float_Mul(nz, is3))
        // abs for two-sided
        IfCondition EqualTo(Float_Le(ndotl, 0), 1) ThenBlock: {
            ndotl = Float_Sub(0, ndotl)
        }
        // shade = 0.22 + 0.78 * ndotl
        amb = 0x3FCC28F5C28F5C29
        dif = 0x3FE8F5C28F5C28F6
        sh = Float_Add(amb, Float_Mul(dif, ndotl))
        // base RGB varies by dominant normal axis (face contrast)
        anx = nx
        IfCondition EqualTo(Float_Le(anx, 0), 1) ThenBlock: { anx = Float_Sub(0, anx) }
        any = ny
        IfCondition EqualTo(Float_Le(any, 0), 1) ThenBlock: { any = Float_Sub(0, any) }
        anz = nz
        IfCondition EqualTo(Float_Le(anz, 0), 1) ThenBlock: { anz = Float_Sub(0, anz) }
        br = 55
        bg = 120
        bb = 190
        // top-ish (Z): cooler; side X: teal; side Y: warmer
        IfCondition EqualTo(Float_Le(any, anz), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(anx, anz), 1) ThenBlock: {
                br = 80
                bg = 150
                bb = 210
            }
        }
        IfCondition EqualTo(Float_Le(anz, anx), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(any, anx), 1) ThenBlock: {
                br = 40
                bg = 130
                bb = 160
            }
        }
        IfCondition EqualTo(Float_Le(anz, any), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(anx, any), 1) ThenBlock: {
                br = 90
                bg = 110
                bb = 170
            }
        }
        rr = Float_ToInt(Float_Mul(Float_FromInt(br), sh))
        gg = Float_ToInt(Float_Mul(Float_FromInt(bg), sh))
        bb2 = Float_ToInt(Float_Mul(Float_FromInt(bb), sh))
        IfCondition LessThan(rr, 0) ThenBlock: { rr = 0 }
        IfCondition LessThan(gg, 0) ThenBlock: { gg = 0 }
        IfCondition LessThan(bb2, 0) ThenBlock: { bb2 = 0 }
        IfCondition GreaterThan(rr, 255) ThenBlock: { rr = 255 }
        IfCondition GreaterThan(gg, 255) ThenBlock: { gg = 255 }
        IfCondition GreaterThan(bb2, 255) ThenBlock: { bb2 = 255 }
        ReturnValue(FB_RGB(rr, gg, bb2))
    }
}

// Draw mesh into already-inited FB. Returns tris drawn or -1.
Function.CAD_View.DrawMesh {
    Input: mesh_addr: Address
    Input: width: Integer
    Input: height: Integer
    Output: Integer
    Body: {
        nv = ArrayGet(mesh_addr, 0)
        nt = ArrayGet(mesh_addr, 1)
        vb = ArrayGet(mesh_addr, 2)
        ib = ArrayGet(mesh_addr, 3)
        IfCondition LessThan(nt, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(nv, 3) ThenBlock: { ReturnValue(-1) }
        aabb = Allocate(64)
        CAD_View.MeshAABB(mesh_addr, aabb)
        frame = Allocate(64)
        CAD_View.BuildFrame(aabb, width, height, frame)
        sx = Allocate(262144)
        sy = Allocate(262144)
        sz = Allocate(262144)
        CAD_View.ProjectMesh(mesh_addr, frame, sx, sy, sz)
        // zbuffer init to very negative int
        npix = Multiply(width, height)
        zbuf = Allocate(Multiply(npix, 8))
        zi = 0
        zinit = -2000000000
        WhileLoop LessThan(zi, npix) {
            ArraySet(zbuf, zi, zinit)
            zi = Add(zi, 1)
        }
        // clear FB dark gray
        FB_Clear(FB_RGB(32, 32, 40))
        pack = Allocate(128)
        ArraySet(pack, 10, zbuf)
        ArraySet(pack, 11, width)
        ArraySet(pack, 12, height)
        t = 0
        WhileLoop LessThan(t, nt) {
            io = Multiply(t, 3)
            i0 = ArrayGet(ib, io)
            i1 = ArrayGet(ib, Add(io, 1))
            i2 = ArrayGet(ib, Add(io, 2))
            col = CAD_View.ShadeColor(vb, i0, i1, i2)
            ArraySet(pack, 0, ArrayGet(sx, i0))
            ArraySet(pack, 1, ArrayGet(sy, i0))
            ArraySet(pack, 2, ArrayGet(sz, i0))
            ArraySet(pack, 3, ArrayGet(sx, i1))
            ArraySet(pack, 4, ArrayGet(sy, i1))
            ArraySet(pack, 5, ArrayGet(sz, i1))
            ArraySet(pack, 6, ArrayGet(sx, i2))
            ArraySet(pack, 7, ArrayGet(sy, i2))
            ArraySet(pack, 8, ArrayGet(sz, i2))
            ArraySet(pack, 9, col)
            CAD_View.FillTri(pack)
            t = Add(t, 1)
        }
        // optional edge overlay
        IfCondition NotEqual(CAD_View_State.wire, 0) ThenBlock: {
            ecol = FB_RGB(12, 14, 22)
            t = 0
            WhileLoop LessThan(t, nt) {
                io = Multiply(t, 3)
                i0 = ArrayGet(ib, io)
                i1 = ArrayGet(ib, Add(io, 1))
                i2 = ArrayGet(ib, Add(io, 2))
                CAD_View.DrawEdge2D(ArrayGet(sx, i0), ArrayGet(sy, i0), ArrayGet(sx, i1), ArrayGet(sy, i1), ecol)
                CAD_View.DrawEdge2D(ArrayGet(sx, i1), ArrayGet(sy, i1), ArrayGet(sx, i2), ArrayGet(sy, i2), ecol)
                CAD_View.DrawEdge2D(ArrayGet(sx, i2), ArrayGet(sy, i2), ArrayGet(sx, i0), ArrayGet(sy, i0), ecol)
                t = Add(t, 1)
            }
        }
        CAD_View_State.tris_draw = nt
        CAD_View_State.last_nv = nv
        CAD_View_State.last_nt = nt
        Deallocate(pack, 128)
        Deallocate(zbuf, Multiply(npix, 8))
        Deallocate(sx, 262144)
        Deallocate(sy, 262144)
        Deallocate(sz, 262144)
        Deallocate(frame, 64)
        Deallocate(aabb, 64)
        ReturnValue(nt)
    }
}

// Screen-space edge (integer Bresenham via FB_Line)
Function.CAD_View.DrawEdge2D {
    Input: x0_r: Integer
    Input: y0_r: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        x0 = Float_ToInt(x0_r)
        y0 = Float_ToInt(y0_r)
        x1 = Float_ToInt(x1_r)
        y1 = Float_ToInt(y1_r)
        FB_Line(x0, y0, x1, y1, color)
        ReturnValue(0)
    }
}

// Solid → mesh → headless FB (in-memory). Reuses FB if size matches. Returns 0 ok.
// Does not write BMP. Call SaveFBToBMP / WriteFBRaw after.
Function.CAD_View.RenderSolidToFB {
    Input: solid_handle: Integer
    Input: width: Integer
    Input: height: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(width, 16) ThenBlock: { width = 640 }
        IfCondition LessThan(height, 16) ThenBlock: { height = 480 }
        mesh = Allocate(48)
        defl = CAD_View_State.defl_r
        nt = CAD_Tess.MeshSolid(solid_handle, defl, mesh)
        IfCondition LessThan(nt, 1) ThenBlock: {
            Deallocate(mesh, 48)
            ReturnValue(-2)
        }
        // init headless once or on resize
        need = 0
        IfCondition EqualTo(FB.initialized, 0) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.width, width) ThenBlock: { need = 1 }
        IfCondition NotEqual(FB.height, height) ThenBlock: { need = 1 }
        IfCondition EqualTo(need, 1) ThenBlock: {
            IfCondition EqualTo(FB_InitHeadless(width, height), 0) ThenBlock: {
                Deallocate(mesh, 48)
                ReturnValue(-3)
            }
        }
        FB_Clear(FB_RGB(28, 32, 40))
        nd = CAD_View.DrawMesh(mesh, width, height)
        Deallocate(mesh, 48)
        IfCondition LessThan(nd, 1) ThenBlock: { ReturnValue(-4) }
        ReturnValue(0)
    }
}

// Dump current FB as raw ARGB32 top-down for host presenters.
// Writes meta path first line "W H PITCH\n" then raw path with W*H*4 bytes.
// meta_path and raw_path are C strings. Returns 0 ok.
Function.CAD_View.WriteFBRaw {
    Input: meta_path: Address
    Input: raw_path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(meta_path, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(raw_path, 0) ThenBlock: { ReturnValue(-1) }
        w = FB_GetWidth()
        h = FB_GetHeight()
        buf = FB_GetDrawBuffer()
        pitch = FB.pitch
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(-1) }
        // meta
        fd = SystemCall(2, meta_path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-2) }
        // write simple ASCII meta via stack strings is hard — write binary header 3×i32 LE
        hdr = Allocate(16)
        ArraySet(hdr, 0, w)
        ArraySet(hdr, 1, h)
        ArraySet(hdr, 2, pitch)
        SystemCall(1, fd, hdr, 12)
        SystemCall(3, fd, 0, 0)
        Deallocate(hdr, 16)
        // raw pixels
        fd = SystemCall(2, raw_path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-3) }
        SystemCall(1, fd, buf, Multiply(pitch, h))
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }
}

// Solid → mesh → headless FB → BMP path. Returns 0 ok.
Function.CAD_View.RenderSolidToBMP {
    Input: solid_handle: Integer
    Input: width: Integer
    Input: height: Integer
    Input: path_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path_addr, 0) ThenBlock: { ReturnValue(-1) }
        rc = CAD_View.RenderSolidToFB(solid_handle, width, height)
        IfCondition NotEqual(rc, 0) ThenBlock: { ReturnValue(rc) }
        ReturnValue(CAD_View.SaveFBToBMP(path_addr))
    }
}

// Fork host image viewer (eog preferred) on BMP path — isolated OS window, not AOS.
// Returns child pid >0, or -1. Does not wait (CLI can exit; window stays).
Function.CAD_View.OpenHostViewer {
    Input: path_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path_addr, 0) ThenBlock: { ReturnValue(-1) }
        pid = SystemCall(57)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            // child
            argv = Allocate(32)
            // try eog first
            StoreValue(argv, "/usr/bin/eog")
            StoreValue(Add(argv, 8), path_addr)
            StoreValue(Add(argv, 16), 0)
            envp = Allocate(8)
            StoreValue(envp, 0)
            SystemCall(59, "/usr/bin/eog", argv, envp)
            // fallback xdg-open
            StoreValue(argv, "/usr/bin/xdg-open")
            StoreValue(Add(argv, 8), path_addr)
            StoreValue(Add(argv, 16), 0)
            SystemCall(59, "/usr/bin/xdg-open", argv, envp)
            SystemCall(60, 1, 0, 0)
        }
        ReturnValue(pid)
    }
}
