// CAD.Nurbs.NurbsBasis — span, basis, curve point, first derivative.
// Knot count is n_ctrl+degree+1. Degree cap 8. Control cap 64.
// Curve words: [0] degree [1] n_ctrl [2] ctrl xyz [3] knots [4] weights or 0.
// Hold.p0-p3 stay with CurvePoint/CurveDeriv. Hold.r0-r1 stay with BasisD1.
// Hold.q0-q2 are scratch for FindSpan and Basis only.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Sys

FixedPool.CAD_Nurbs_Hold {
    "span": Initialize=0, CanChange=True
    "rc":   Initialize=0, CanChange=True
    "p0":   Initialize=0, CanChange=True
    "p1":   Initialize=0, CanChange=True
    "p2":   Initialize=0, CanChange=True
    "p3":   Initialize=0, CanChange=True
    "r0":   Initialize=0, CanChange=True
    "r1":   Initialize=0, CanChange=True
    "q0":   Initialize=0, CanChange=True
    "q1":   Initialize=0, CanChange=True
    "q2":   Initialize=0, CanChange=True
}

// Copy curve words into cs[0..4]. 0, or -4.
Function.CAD_Nurbs.CheckDesc {
    Input: curve: Address
    Input: cs: Address
    Output: Integer
    Body: {
        ArraySet(cs, 0, ArrayGet(curve, 0))
        ArraySet(cs, 1, ArrayGet(curve, 1))
        ArraySet(cs, 2, ArrayGet(curve, 2))
        ArraySet(cs, 3, ArrayGet(curve, 3))
        ArraySet(cs, 4, ArrayGet(curve, 4))
        deg = ArrayGet(cs, 0)
        n = ArrayGet(cs, 1)
        IfCondition LessThan(deg, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(deg, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(n, 64) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(n, Add(deg, 1)) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(ArrayGet(cs, 2), 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(ArrayGet(cs, 3), 0) ThenBlock: { ReturnValue(-4) }
        ReturnValue(0)
    }
}

// Span i with knots[i] <= u < knots[i+1]. At the end knot, n_ctrl-1.
Function.CAD_Nurbs.FindSpan {
    Input: n_ctrl: Integer
    Input: degree: Integer
    Input: u_r: Integer
    Input: knots: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n_ctrl, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(n_ctrl, 64) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(degree, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(degree, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(n_ctrl, Add(degree, 1)) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(knots, 0) ThenBlock: { ReturnValue(-4) }

        box = Allocate(128)
        CAD_Nurbs_Hold.q0 = box
        ArraySet(box, 0, n_ctrl)
        ArraySet(box, 1, degree)
        ArraySet(box, 2, u_r)
        ArraySet(box, 3, knots)
        n = Subtract(n_ctrl, 1)
        ArraySet(box, 4, n)
        end_u = ArrayGet(knots, n_ctrl)
        ArraySet(box, 5, end_u)

        u0 = ArrayGet(box, 2)
        e0 = ArrayGet(box, 5)
        same = CAD_Num.IsEqual(u0, e0, 0)
        ArraySet(CAD_Nurbs_Hold.q0, 6, same)
        IfCondition EqualTo(ArrayGet(CAD_Nurbs_Hold.q0, 6), 1) ThenBlock: {
            CAD_Nurbs_Hold.span = ArrayGet(CAD_Nurbs_Hold.q0, 4)
            Deallocate(CAD_Nurbs_Hold.q0, 128)
            ReturnValue(CAD_Nurbs_Hold.span)
        }

        u0 = ArrayGet(CAD_Nurbs_Hold.q0, 2)
        e0 = ArrayGet(CAD_Nurbs_Hold.q0, 5)
        past = Float_Le(e0, u0)
        IfCondition EqualTo(past, 1) ThenBlock: {
            CAD_Nurbs_Hold.span = ArrayGet(CAD_Nurbs_Hold.q0, 4)
            Deallocate(CAD_Nurbs_Hold.q0, 128)
            ReturnValue(CAD_Nurbs_Hold.span)
        }

        kv = ArrayGet(CAD_Nurbs_Hold.q0, 3)
        p = ArrayGet(CAD_Nurbs_Hold.q0, 1)
        u_dom = ArrayGet(kv, p)
        u0 = ArrayGet(CAD_Nurbs_Hold.q0, 2)
        in_dom = Float_Le(u_dom, u0)
        IfCondition EqualTo(in_dom, 0) ThenBlock: {
            CAD_Nurbs_Hold.span = ArrayGet(CAD_Nurbs_Hold.q0, 1)
            Deallocate(CAD_Nurbs_Hold.q0, 128)
            ReturnValue(CAD_Nurbs_Hold.span)
        }

        low = ArrayGet(CAD_Nurbs_Hold.q0, 1)
        high = Add(ArrayGet(CAD_Nurbs_Hold.q0, 4), 1)
        mid = Divide(Add(low, high), 2)
        ArraySet(CAD_Nurbs_Hold.q0, 7, low)
        ArraySet(CAD_Nurbs_Hold.q0, 8, high)
        ArraySet(CAD_Nurbs_Hold.q0, 9, mid)
        ArraySet(CAD_Nurbs_Hold.q0, 10, 0)

        WhileLoop LessThan(ArrayGet(CAD_Nurbs_Hold.q0, 10), 16) {
            mid = ArrayGet(CAD_Nurbs_Hold.q0, 9)
            kv = ArrayGet(CAD_Nurbs_Hold.q0, 3)
            u0 = ArrayGet(CAD_Nurbs_Hold.q0, 2)
            k0 = ArrayGet(kv, mid)
            k1 = ArrayGet(kv, Add(mid, 1))
            ge_lo = Float_Le(k0, u0)
            ge_hi = Float_Le(k1, u0)
            IfCondition EqualTo(ge_lo, 1) ThenBlock: {
                IfCondition EqualTo(ge_hi, 0) ThenBlock: {
                    ArraySet(CAD_Nurbs_Hold.q0, 10, 16)
                }
            }
            still = ArrayGet(CAD_Nurbs_Hold.q0, 10)
            IfCondition LessThan(still, 16) ThenBlock: {
                IfCondition EqualTo(ge_lo, 0) ThenBlock: {
                    ArraySet(CAD_Nurbs_Hold.q0, 8, mid)
                }
                IfCondition EqualTo(ge_lo, 1) ThenBlock: {
                    ArraySet(CAD_Nurbs_Hold.q0, 7, mid)
                }
                low = ArrayGet(CAD_Nurbs_Hold.q0, 7)
                high = ArrayGet(CAD_Nurbs_Hold.q0, 8)
                mid = Divide(Add(low, high), 2)
                ArraySet(CAD_Nurbs_Hold.q0, 9, mid)
            }
            ArraySet(CAD_Nurbs_Hold.q0, 10, Add(ArrayGet(CAD_Nurbs_Hold.q0, 10), 1))
        }

        CAD_Nurbs_Hold.span = ArrayGet(CAD_Nurbs_Hold.q0, 9)
        Deallocate(CAD_Nurbs_Hold.q0, 128)
        ReturnValue(CAD_Nurbs_Hold.span)
    }
}

// Nonzero basis N[0..degree] on this span. 0, or -4.
Function.CAD_Nurbs.Basis {
    Input: span: Integer
    Input: degree: Integer
    Input: u_r: Integer
    Input: knots: Address
    Input: out_n: Address
    Output: Integer
    Body: {
        IfCondition LessThan(degree, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(degree, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(knots, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(out_n, 0) ThenBlock: { ReturnValue(-4) }

        st = Allocate(256)
        left = Allocate(128)
        right = Allocate(128)
        CAD_Nurbs_Hold.q0 = st
        CAD_Nurbs_Hold.q1 = left
        CAD_Nurbs_Hold.q2 = right
        one = 0x3FF0000000000000
        ArraySet(st, 0, span)
        ArraySet(st, 1, degree)
        ArraySet(st, 2, u_r)
        ArraySet(st, 3, knots)
        ArraySet(st, 4, out_n)
        ArraySet(st, 8, left)
        ArraySet(st, 9, right)
        ArraySet(st, 10, one)
        ArraySet(st, 11, 0)
        ArraySet(out_n, 0, one)
        ArraySet(st, 5, 1)

        WhileLoop LessEqual(ArrayGet(CAD_Nurbs_Hold.q0, 5), ArrayGet(CAD_Nurbs_Hold.q0, 1)) {
            j = ArrayGet(CAD_Nurbs_Hold.q0, 5)
            span_v = ArrayGet(CAD_Nurbs_Hold.q0, 0)
            u = ArrayGet(CAD_Nurbs_Hold.q0, 2)
            kv = ArrayGet(CAD_Nurbs_Hold.q0, 3)
            li = Subtract(Add(span_v, 1), j)
            kL = ArrayGet(kv, li)
            lv = Float_Sub(u, kL)
            ArraySet(CAD_Nurbs_Hold.q1, j, lv)
            ri = Add(span_v, j)
            kR = ArrayGet(kv, ri)
            rv = Float_Sub(kR, u)
            ArraySet(CAD_Nurbs_Hold.q2, j, rv)
            ArraySet(CAD_Nurbs_Hold.q0, 7, 0)
            ArraySet(CAD_Nurbs_Hold.q0, 6, 0)

            WhileLoop LessThan(ArrayGet(CAD_Nurbs_Hold.q0, 6), ArrayGet(CAD_Nurbs_Hold.q0, 5)) {
                r = ArrayGet(CAD_Nurbs_Hold.q0, 6)
                j = ArrayGet(CAD_Nurbs_Hold.q0, 5)
                rp1 = Add(r, 1)
                jmr = Subtract(j, r)
                rr = ArrayGet(CAD_Nurbs_Hold.q2, rp1)
                ll = ArrayGet(CAD_Nurbs_Hold.q1, jmr)
                den = Float_Add(rr, ll)
                ArraySet(CAD_Nurbs_Hold.q0, 12, den)
                ArraySet(CAD_Nurbs_Hold.q0, 14, rr)
                ArraySet(CAD_Nurbs_Hold.q0, 15, ll)
                nr = ArrayGet(ArrayGet(CAD_Nurbs_Hold.q0, 4), r)
                ArraySet(CAD_Nurbs_Hold.q0, 16, nr)
                ArraySet(CAD_Nurbs_Hold.q0, 13, 0)
                den = ArrayGet(CAD_Nurbs_Hold.q0, 12)
                z = CAD_Num.IsZero(den, 0)
                ArraySet(CAD_Nurbs_Hold.q0, 17, z)
                IfCondition EqualTo(ArrayGet(CAD_Nurbs_Hold.q0, 17), 0) ThenBlock: {
                    nr = ArrayGet(CAD_Nurbs_Hold.q0, 16)
                    den = ArrayGet(CAD_Nurbs_Hold.q0, 12)
                    tmp = Float_Div(nr, den)
                    ArraySet(CAD_Nurbs_Hold.q0, 13, tmp)
                }
                saved = ArrayGet(CAD_Nurbs_Hold.q0, 7)
                rr = ArrayGet(CAD_Nurbs_Hold.q0, 14)
                tmp = ArrayGet(CAD_Nurbs_Hold.q0, 13)
                prod = Float_Mul(rr, tmp)
                nnew = Float_Add(saved, prod)
                r = ArrayGet(CAD_Nurbs_Hold.q0, 6)
                ArraySet(ArrayGet(CAD_Nurbs_Hold.q0, 4), r, nnew)
                ll = ArrayGet(CAD_Nurbs_Hold.q0, 15)
                tmp = ArrayGet(CAD_Nurbs_Hold.q0, 13)
                saved = Float_Mul(ll, tmp)
                ArraySet(CAD_Nurbs_Hold.q0, 7, saved)
                ArraySet(CAD_Nurbs_Hold.q0, 6, Add(r, 1))
            }

            j = ArrayGet(CAD_Nurbs_Hold.q0, 5)
            ArraySet(ArrayGet(CAD_Nurbs_Hold.q0, 4), j, ArrayGet(CAD_Nurbs_Hold.q0, 7))
            ArraySet(CAD_Nurbs_Hold.q0, 5, Add(j, 1))
        }

        Deallocate(CAD_Nurbs_Hold.q1, 128)
        Deallocate(CAD_Nurbs_Hold.q2, 128)
        Deallocate(CAD_Nurbs_Hold.q0, 256)
        ReturnValue(0)
    }
}

// Basis in out_n and first derivatives in out_d. Order-1 derivative only.
Function.CAD_Nurbs.BasisD1 {
    Input: span: Integer
    Input: degree: Integer
    Input: u_r: Integer
    Input: knots: Address
    Input: out_n: Address
    Input: out_d: Address
    Output: Integer
    Body: {
        IfCondition LessThan(degree, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(degree, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(knots, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(out_n, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(out_d, 0) ThenBlock: { ReturnValue(-4) }

        st = Allocate(256)
        CAD_Nurbs_Hold.r0 = st
        one = 0x3FF0000000000000
        ArraySet(st, 0, span)
        ArraySet(st, 1, degree)
        ArraySet(st, 2, u_r)
        ArraySet(st, 3, knots)
        ArraySet(st, 4, out_n)
        ArraySet(st, 5, out_d)
        IfCondition EqualTo(degree, 0) ThenBlock: {
            ArraySet(out_n, 0, one)
            ArraySet(out_d, 0, 0)
            Deallocate(CAD_Nurbs_Hold.r0, 256)
            ReturnValue(0)
        }

        sp = ArrayGet(CAD_Nurbs_Hold.r0, 0)
        deg = ArrayGet(CAD_Nurbs_Hold.r0, 1)
        uu = ArrayGet(CAD_Nurbs_Hold.r0, 2)
        kv = ArrayGet(CAD_Nurbs_Hold.r0, 3)
        on = ArrayGet(CAD_Nurbs_Hold.r0, 4)
        rc = CAD_Nurbs.Basis(sp, deg, uu, kv, on)
        ArraySet(CAD_Nurbs_Hold.r0, 6, rc)
        IfCondition NotEqual(ArrayGet(CAD_Nurbs_Hold.r0, 6), 0) ThenBlock: {
            CAD_Nurbs_Hold.rc = ArrayGet(CAD_Nurbs_Hold.r0, 6)
            Deallocate(CAD_Nurbs_Hold.r0, 256)
            ReturnValue(CAD_Nurbs_Hold.rc)
        }

        low = Allocate(128)
        CAD_Nurbs_Hold.r1 = low
        pm1 = Subtract(ArrayGet(CAD_Nurbs_Hold.r0, 1), 1)
        sp = ArrayGet(CAD_Nurbs_Hold.r0, 0)
        uu = ArrayGet(CAD_Nurbs_Hold.r0, 2)
        kv = ArrayGet(CAD_Nurbs_Hold.r0, 3)
        rc = CAD_Nurbs.Basis(sp, pm1, uu, kv, low)
        ArraySet(CAD_Nurbs_Hold.r0, 6, rc)
        IfCondition NotEqual(ArrayGet(CAD_Nurbs_Hold.r0, 6), 0) ThenBlock: {
            CAD_Nurbs_Hold.rc = ArrayGet(CAD_Nurbs_Hold.r0, 6)
            Deallocate(CAD_Nurbs_Hold.r1, 128)
            Deallocate(CAD_Nurbs_Hold.r0, 256)
            ReturnValue(CAD_Nurbs_Hold.rc)
        }

        pf = Float_FromInt(ArrayGet(CAD_Nurbs_Hold.r0, 1))
        ArraySet(CAD_Nurbs_Hold.r0, 7, pf)
        ArraySet(CAD_Nurbs_Hold.r0, 8, 0)
        WhileLoop LessEqual(ArrayGet(CAD_Nurbs_Hold.r0, 8), ArrayGet(CAD_Nurbs_Hold.r0, 1)) {
            j = ArrayGet(CAD_Nurbs_Hold.r0, 8)
            p = ArrayGet(CAD_Nurbs_Hold.r0, 1)
            span_v = ArrayGet(CAD_Nurbs_Hold.r0, 0)
            ArraySet(CAD_Nurbs_Hold.r0, 9, 0)
            IfCondition GreaterEqual(j, 1) ThenBlock: {
                jm1 = Subtract(j, 1)
                hi_i = Add(span_v, j)
                lo_i = Add(Subtract(span_v, p), j)
                kv = ArrayGet(CAD_Nurbs_Hold.r0, 3)
                hi = ArrayGet(kv, hi_i)
                lo = ArrayGet(kv, lo_i)
                den = Float_Sub(hi, lo)
                num = ArrayGet(CAD_Nurbs_Hold.r1, jm1)
                ArraySet(CAD_Nurbs_Hold.r0, 10, den)
                ArraySet(CAD_Nurbs_Hold.r0, 11, num)
                den = ArrayGet(CAD_Nurbs_Hold.r0, 10)
                z = CAD_Num.IsZero(den, 0)
                ArraySet(CAD_Nurbs_Hold.r0, 12, z)
                IfCondition EqualTo(ArrayGet(CAD_Nurbs_Hold.r0, 12), 0) ThenBlock: {
                    num = ArrayGet(CAD_Nurbs_Hold.r0, 11)
                    den = ArrayGet(CAD_Nurbs_Hold.r0, 10)
                    term = Float_Div(num, den)
                    ArraySet(CAD_Nurbs_Hold.r0, 9, term)
                }
            }
            j = ArrayGet(CAD_Nurbs_Hold.r0, 8)
            p = ArrayGet(CAD_Nurbs_Hold.r0, 1)
            span_v = ArrayGet(CAD_Nurbs_Hold.r0, 0)
            pm1 = Subtract(p, 1)
            IfCondition LessEqual(j, pm1) ThenBlock: {
                hi_i = Add(Add(span_v, j), 1)
                lo_i = Add(Add(Subtract(span_v, p), j), 1)
                kv = ArrayGet(CAD_Nurbs_Hold.r0, 3)
                hi = ArrayGet(kv, hi_i)
                lo = ArrayGet(kv, lo_i)
                den = Float_Sub(hi, lo)
                num = ArrayGet(CAD_Nurbs_Hold.r1, j)
                ArraySet(CAD_Nurbs_Hold.r0, 10, den)
                ArraySet(CAD_Nurbs_Hold.r0, 11, num)
                den = ArrayGet(CAD_Nurbs_Hold.r0, 10)
                z = CAD_Num.IsZero(den, 0)
                ArraySet(CAD_Nurbs_Hold.r0, 12, z)
                IfCondition EqualTo(ArrayGet(CAD_Nurbs_Hold.r0, 12), 0) ThenBlock: {
                    num = ArrayGet(CAD_Nurbs_Hold.r0, 11)
                    den = ArrayGet(CAD_Nurbs_Hold.r0, 10)
                    term = Float_Div(num, den)
                    dacc = ArrayGet(CAD_Nurbs_Hold.r0, 9)
                    dacc = Float_Sub(dacc, term)
                    ArraySet(CAD_Nurbs_Hold.r0, 9, dacc)
                }
            }
            dacc = ArrayGet(CAD_Nurbs_Hold.r0, 9)
            pf = ArrayGet(CAD_Nurbs_Hold.r0, 7)
            dacc = Float_Mul(dacc, pf)
            j = ArrayGet(CAD_Nurbs_Hold.r0, 8)
            ArraySet(ArrayGet(CAD_Nurbs_Hold.r0, 5), j, dacc)
            ArraySet(CAD_Nurbs_Hold.r0, 8, Add(j, 1))
        }

        Deallocate(CAD_Nurbs_Hold.r1, 128)
        Deallocate(CAD_Nurbs_Hold.r0, 256)
        ReturnValue(0)
    }
}

// Polynomial or rational point. Weights word 0 means every weight is 1.
Function.CAD_Nurbs.CurvePoint {
    Input: curve: Address
    Input: u_r: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(curve, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(out_xyz, 0) ThenBlock: { ReturnValue(-4) }
        cs = Allocate(256)
        nb = Allocate(128)
        CAD_Nurbs_Hold.p0 = cs
        CAD_Nurbs_Hold.p1 = nb
        ArraySet(cs, 5, u_r)
        ArraySet(cs, 6, out_xyz)
        rc = CAD_Nurbs.CheckDesc(curve, cs)
        CAD_Nurbs_Hold.rc = rc
        IfCondition NotEqual(CAD_Nurbs_Hold.rc, 0) ThenBlock: {
            Deallocate(CAD_Nurbs_Hold.p1, 128)
            Deallocate(CAD_Nurbs_Hold.p0, 256)
            ReturnValue(-4)
        }

        cs = CAD_Nurbs_Hold.p0
        n = ArrayGet(cs, 1)
        deg = ArrayGet(cs, 0)
        uu = ArrayGet(cs, 5)
        kv = ArrayGet(cs, 3)
        sp = CAD_Nurbs.FindSpan(n, deg, uu, kv)
        ArraySet(CAD_Nurbs_Hold.p0, 16, sp)
        IfCondition LessThan(ArrayGet(CAD_Nurbs_Hold.p0, 16), 0) ThenBlock: {
            Deallocate(CAD_Nurbs_Hold.p1, 128)
            Deallocate(CAD_Nurbs_Hold.p0, 256)
            ReturnValue(-4)
        }

        cs = CAD_Nurbs_Hold.p0
        sp = ArrayGet(cs, 16)
        deg = ArrayGet(cs, 0)
        uu = ArrayGet(cs, 5)
        kv = ArrayGet(cs, 3)
        nb = CAD_Nurbs_Hold.p1
        rc = CAD_Nurbs.Basis(sp, deg, uu, kv, nb)
        CAD_Nurbs_Hold.rc = rc
        IfCondition NotEqual(CAD_Nurbs_Hold.rc, 0) ThenBlock: {
            Deallocate(CAD_Nurbs_Hold.p1, 128)
            Deallocate(CAD_Nurbs_Hold.p0, 256)
            ReturnValue(CAD_Nurbs_Hold.rc)
        }

        ArraySet(CAD_Nurbs_Hold.p0, 10, 0)
        ArraySet(CAD_Nurbs_Hold.p0, 11, 0)
        ArraySet(CAD_Nurbs_Hold.p0, 12, 0)
        ArraySet(CAD_Nurbs_Hold.p0, 13, 0)
        ArraySet(CAD_Nurbs_Hold.p0, 14, 0)
        one = 0x3FF0000000000000
        ArraySet(CAD_Nurbs_Hold.p0, 15, one)
        WhileLoop LessEqual(ArrayGet(CAD_Nurbs_Hold.p0, 14), ArrayGet(CAD_Nurbs_Hold.p0, 0)) {
            j = ArrayGet(CAD_Nurbs_Hold.p0, 14)
            span_v = ArrayGet(CAD_Nurbs_Hold.p0, 16)
            deg = ArrayGet(CAD_Nurbs_Hold.p0, 0)
            idx = Subtract(Add(span_v, j), deg)
            nctl = ArrayGet(CAD_Nurbs_Hold.p0, 1)
            last = Subtract(nctl, 1)
            IfCondition LessThan(idx, 0) ThenBlock: { idx = 0 }
            IfCondition GreaterThan(idx, last) ThenBlock: { idx = last }
            nj = ArrayGet(CAD_Nurbs_Hold.p1, j)
            w = ArrayGet(CAD_Nurbs_Hold.p0, 15)
            waddr = ArrayGet(CAD_Nurbs_Hold.p0, 4)
            IfCondition NotEqual(waddr, 0) ThenBlock: {
                w = ArrayGet(waddr, idx)
            }
            ctrl = ArrayGet(CAD_Nurbs_Hold.p0, 2)
            b = Multiply(idx, 3)
            px = ArrayGet(ctrl, b)
            py = ArrayGet(ctrl, Add(b, 1))
            pz = ArrayGet(ctrl, Add(b, 2))
            xw = Float_Mul(nj, w)
            sx = Float_Mul(xw, px)
            sy = Float_Mul(xw, py)
            sz = Float_Mul(xw, pz)
            ArraySet(CAD_Nurbs_Hold.p0, 10, Float_Add(ArrayGet(CAD_Nurbs_Hold.p0, 10), sx))
            ArraySet(CAD_Nurbs_Hold.p0, 11, Float_Add(ArrayGet(CAD_Nurbs_Hold.p0, 11), sy))
            ArraySet(CAD_Nurbs_Hold.p0, 12, Float_Add(ArrayGet(CAD_Nurbs_Hold.p0, 12), sz))
            ArraySet(CAD_Nurbs_Hold.p0, 13, Float_Add(ArrayGet(CAD_Nurbs_Hold.p0, 13), xw))
            ArraySet(CAD_Nurbs_Hold.p0, 14, Add(j, 1))
        }

        wsum = ArrayGet(CAD_Nurbs_Hold.p0, 13)
        z = CAD_Num.IsZero(wsum, 0)
        ArraySet(CAD_Nurbs_Hold.p0, 17, z)
        IfCondition EqualTo(ArrayGet(CAD_Nurbs_Hold.p0, 17), 1) ThenBlock: {
            Deallocate(CAD_Nurbs_Hold.p1, 128)
            Deallocate(CAD_Nurbs_Hold.p0, 256)
            ReturnValue(-4)
        }
        wsum = ArrayGet(CAD_Nurbs_Hold.p0, 13)
        ox = Float_Div(ArrayGet(CAD_Nurbs_Hold.p0, 10), wsum)
        oy = Float_Div(ArrayGet(CAD_Nurbs_Hold.p0, 11), wsum)
        oz = Float_Div(ArrayGet(CAD_Nurbs_Hold.p0, 12), wsum)
        outp = ArrayGet(CAD_Nurbs_Hold.p0, 6)
        ArraySet(outp, 0, ox)
        ArraySet(outp, 1, oy)
        ArraySet(outp, 2, oz)
        Deallocate(CAD_Nurbs_Hold.p1, 128)
        Deallocate(CAD_Nurbs_Hold.p0, 256)
        ReturnValue(0)
    }
}

// First derivative. Rational curves use the quotient of the homogeneous point.
Function.CAD_Nurbs.CurveDeriv {
    Input: curve: Address
    Input: u_r: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(curve, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(out_xyz, 0) ThenBlock: { ReturnValue(-4) }
        cs = Allocate(256)
        nb = Allocate(128)
        nd = Allocate(128)
        acc = Allocate(128)
        CAD_Nurbs_Hold.p0 = cs
        CAD_Nurbs_Hold.p1 = nb
        CAD_Nurbs_Hold.p2 = nd
        CAD_Nurbs_Hold.p3 = acc
        ArraySet(cs, 5, u_r)
        ArraySet(cs, 6, out_xyz)
        rc = CAD_Nurbs.CheckDesc(curve, cs)
        CAD_Nurbs_Hold.rc = rc
        IfCondition NotEqual(CAD_Nurbs_Hold.rc, 0) ThenBlock: {
            Deallocate(CAD_Nurbs_Hold.p3, 128)
            Deallocate(CAD_Nurbs_Hold.p2, 128)
            Deallocate(CAD_Nurbs_Hold.p1, 128)
            Deallocate(CAD_Nurbs_Hold.p0, 256)
            ReturnValue(-4)
        }

        cs = CAD_Nurbs_Hold.p0
        n = ArrayGet(cs, 1)
        deg = ArrayGet(cs, 0)
        uu = ArrayGet(cs, 5)
        kv = ArrayGet(cs, 3)
        sp = CAD_Nurbs.FindSpan(n, deg, uu, kv)
        ArraySet(CAD_Nurbs_Hold.p0, 16, sp)
        IfCondition LessThan(ArrayGet(CAD_Nurbs_Hold.p0, 16), 0) ThenBlock: {
            Deallocate(CAD_Nurbs_Hold.p3, 128)
            Deallocate(CAD_Nurbs_Hold.p2, 128)
            Deallocate(CAD_Nurbs_Hold.p1, 128)
            Deallocate(CAD_Nurbs_Hold.p0, 256)
            ReturnValue(-4)
        }

        cs = CAD_Nurbs_Hold.p0
        sp = ArrayGet(cs, 16)
        deg = ArrayGet(cs, 0)
        uu = ArrayGet(cs, 5)
        kv = ArrayGet(cs, 3)
        nb = CAD_Nurbs_Hold.p1
        nd = CAD_Nurbs_Hold.p2
        rc = CAD_Nurbs.BasisD1(sp, deg, uu, kv, nb, nd)
        CAD_Nurbs_Hold.rc = rc
        IfCondition NotEqual(CAD_Nurbs_Hold.rc, 0) ThenBlock: {
            Deallocate(CAD_Nurbs_Hold.p3, 128)
            Deallocate(CAD_Nurbs_Hold.p2, 128)
            Deallocate(CAD_Nurbs_Hold.p1, 128)
            Deallocate(CAD_Nurbs_Hold.p0, 256)
            ReturnValue(CAD_Nurbs_Hold.rc)
        }

        ArraySet(CAD_Nurbs_Hold.p3, 0, 0)
        ArraySet(CAD_Nurbs_Hold.p3, 1, 0)
        ArraySet(CAD_Nurbs_Hold.p3, 2, 0)
        ArraySet(CAD_Nurbs_Hold.p3, 3, 0)
        ArraySet(CAD_Nurbs_Hold.p3, 4, 0)
        ArraySet(CAD_Nurbs_Hold.p3, 5, 0)
        ArraySet(CAD_Nurbs_Hold.p3, 6, 0)
        ArraySet(CAD_Nurbs_Hold.p3, 7, 0)
        ArraySet(CAD_Nurbs_Hold.p0, 14, 0)
        one = 0x3FF0000000000000
        ArraySet(CAD_Nurbs_Hold.p0, 15, one)
        WhileLoop LessEqual(ArrayGet(CAD_Nurbs_Hold.p0, 14), ArrayGet(CAD_Nurbs_Hold.p0, 0)) {
            j = ArrayGet(CAD_Nurbs_Hold.p0, 14)
            span_v = ArrayGet(CAD_Nurbs_Hold.p0, 16)
            deg = ArrayGet(CAD_Nurbs_Hold.p0, 0)
            idx = Subtract(Add(span_v, j), deg)
            nctl = ArrayGet(CAD_Nurbs_Hold.p0, 1)
            last = Subtract(nctl, 1)
            IfCondition LessThan(idx, 0) ThenBlock: { idx = 0 }
            IfCondition GreaterThan(idx, last) ThenBlock: { idx = last }
            nj = ArrayGet(CAD_Nurbs_Hold.p1, j)
            dj = ArrayGet(CAD_Nurbs_Hold.p2, j)
            w = ArrayGet(CAD_Nurbs_Hold.p0, 15)
            waddr = ArrayGet(CAD_Nurbs_Hold.p0, 4)
            IfCondition NotEqual(waddr, 0) ThenBlock: {
                w = ArrayGet(waddr, idx)
            }
            ctrl = ArrayGet(CAD_Nurbs_Hold.p0, 2)
            b = Multiply(idx, 3)
            px = ArrayGet(ctrl, b)
            py = ArrayGet(ctrl, Add(b, 1))
            pz = ArrayGet(ctrl, Add(b, 2))
            xw = Float_Mul(nj, w)
            dxw = Float_Mul(dj, w)
            ArraySet(CAD_Nurbs_Hold.p3, 0, Float_Add(ArrayGet(CAD_Nurbs_Hold.p3, 0), Float_Mul(xw, px)))
            ArraySet(CAD_Nurbs_Hold.p3, 1, Float_Add(ArrayGet(CAD_Nurbs_Hold.p3, 1), Float_Mul(xw, py)))
            ArraySet(CAD_Nurbs_Hold.p3, 2, Float_Add(ArrayGet(CAD_Nurbs_Hold.p3, 2), Float_Mul(xw, pz)))
            ArraySet(CAD_Nurbs_Hold.p3, 3, Float_Add(ArrayGet(CAD_Nurbs_Hold.p3, 3), xw))
            ArraySet(CAD_Nurbs_Hold.p3, 4, Float_Add(ArrayGet(CAD_Nurbs_Hold.p3, 4), Float_Mul(dxw, px)))
            ArraySet(CAD_Nurbs_Hold.p3, 5, Float_Add(ArrayGet(CAD_Nurbs_Hold.p3, 5), Float_Mul(dxw, py)))
            ArraySet(CAD_Nurbs_Hold.p3, 6, Float_Add(ArrayGet(CAD_Nurbs_Hold.p3, 6), Float_Mul(dxw, pz)))
            ArraySet(CAD_Nurbs_Hold.p3, 7, Float_Add(ArrayGet(CAD_Nurbs_Hold.p3, 7), dxw))
            ArraySet(CAD_Nurbs_Hold.p0, 14, Add(j, 1))
        }

        wsum = ArrayGet(CAD_Nurbs_Hold.p3, 3)
        z = CAD_Num.IsZero(wsum, 0)
        ArraySet(CAD_Nurbs_Hold.p0, 17, z)
        IfCondition EqualTo(ArrayGet(CAD_Nurbs_Hold.p0, 17), 1) ThenBlock: {
            Deallocate(CAD_Nurbs_Hold.p3, 128)
            Deallocate(CAD_Nurbs_Hold.p2, 128)
            Deallocate(CAD_Nurbs_Hold.p1, 128)
            Deallocate(CAD_Nurbs_Hold.p0, 256)
            ReturnValue(-4)
        }
        wsum = ArrayGet(CAD_Nurbs_Hold.p3, 3)
        w2 = Float_Mul(wsum, wsum)
        ArraySet(CAD_Nurbs_Hold.p0, 18, w2)
        ax = ArrayGet(CAD_Nurbs_Hold.p3, 0)
        ay = ArrayGet(CAD_Nurbs_Hold.p3, 1)
        az = ArrayGet(CAD_Nurbs_Hold.p3, 2)
        dax = ArrayGet(CAD_Nurbs_Hold.p3, 4)
        day = ArrayGet(CAD_Nurbs_Hold.p3, 5)
        daz = ArrayGet(CAD_Nurbs_Hold.p3, 6)
        dw = ArrayGet(CAD_Nurbs_Hold.p3, 7)
        wsum = ArrayGet(CAD_Nurbs_Hold.p3, 3)
        w2 = ArrayGet(CAD_Nurbs_Hold.p0, 18)
        ox = Float_Div(Float_Sub(Float_Mul(dax, wsum), Float_Mul(ax, dw)), w2)
        oy = Float_Div(Float_Sub(Float_Mul(day, wsum), Float_Mul(ay, dw)), w2)
        oz = Float_Div(Float_Sub(Float_Mul(daz, wsum), Float_Mul(az, dw)), w2)
        outp = ArrayGet(CAD_Nurbs_Hold.p0, 6)
        ArraySet(outp, 0, ox)
        ArraySet(outp, 1, oy)
        ArraySet(outp, 2, oz)
        Deallocate(CAD_Nurbs_Hold.p3, 128)
        Deallocate(CAD_Nurbs_Hold.p2, 128)
        Deallocate(CAD_Nurbs_Hold.p1, 128)
        Deallocate(CAD_Nurbs_Hold.p0, 256)
        ReturnValue(0)
    }
}
