// CAD Kernel — CAD.NurbsCurve — clamped polynomial curves
//
// Descriptor words at curve:
//   [0] degree
//   [1] n_ctrl
//   [2] ctrl xyz, stride 3
//   [3] knots, length n_ctrl+degree+1
//   [4] weights, or 0 when the curve is polynomial
//
// Degree is at most 8. Control count is at most 64.
// Owned ctrl buffers are Allocate(2048). Owned knot buffers are Allocate(1024).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Sys

// Live pointers and scalars. Calls clobber locals; these slots do not.
FixedPool.CAD_NurbsCurve_Hold {
    "curve": Initialize=0
    "u": Initialize=0
    "outp": Initialize=0
    "ctrl": Initialize=0
    "knots": Initialize=0
    "wts": Initialize=0
    "dbuf": Initialize=0
    "degree": Initialize=0
    "nctrl": Initialize=0
    "span": Initialize=0
    "idx": Initialize=0
    "jdx": Initialize=0
    "rdx": Initialize=0
    "alpha": Initialize=0
    "om": Initialize=0
    "tmp": Initialize=0
    "tmp2": Initialize=0
    "dst": Initialize=0
    "dstc": Initialize=0
    "dstk": Initialize=0
    "mul": Initialize=0
    "hi": Initialize=0
    "stride": Initialize=0
}

// Uniform clamped knots on [0,1]. Interior knots are (i-degree)/(n_ctrl-degree).
Function.CAD_NurbsCurve.MakeClamped {
    Input: degree: Integer
    Input: n_ctrl: Integer
    Input: knots_out: Address
    Output: Integer
    Body: {
        IfCondition LessThan(degree, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(degree, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(n_ctrl, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(n_ctrl, 64) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(n_ctrl, Add(degree, 1)) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(knots_out, 0) ThenBlock: { ReturnValue(-4) }

        one = 0x3FF0000000000000
        n_knots = Add(n_ctrl, Add(degree, 1))
        i = 0
        WhileLoop LessThan(i, n_knots) {
            IfCondition LessEqual(i, degree) ThenBlock: {
                ArraySet(knots_out, i, 0)
            }
            IfCondition GreaterThan(i, degree) ThenBlock: {
                IfCondition GreaterEqual(i, n_ctrl) ThenBlock: {
                    ArraySet(knots_out, i, one)
                }
                IfCondition LessThan(i, n_ctrl) ThenBlock: {
                    num = Subtract(i, degree)
                    den = Subtract(n_ctrl, degree)
                    nf = Float_FromInt(num)
                    df = Float_FromInt(den)
                    kv = Float_Div(nf, df)
                    ArraySet(knots_out, i, kv)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Degree-1 closed ring. n unique points, n_ctrl = n+1, last control repeats the first.
Function.CAD_NurbsCurve.MakeRing {
    Input: xyz: Address
    Input: n: Integer
    Input: curve_out: Address
    Output: Integer
    Body: {
        CAD_NurbsCurve_Hold.curve = xyz
        CAD_NurbsCurve_Hold.nctrl = n
        CAD_NurbsCurve_Hold.dst = curve_out
        IfCondition EqualTo(CAD_NurbsCurve_Hold.curve, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.dst, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsCurve_Hold.nctrl, 3) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsCurve_Hold.nctrl, 60) ThenBlock: { ReturnValue(-4) }

        CAD_NurbsCurve_Hold.ctrl = Allocate(2048)
        CAD_NurbsCurve_Hold.knots = Allocate(1024)
        IfCondition EqualTo(CAD_NurbsCurve_Hold.ctrl, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.knots, 0) ThenBlock: {
            Deallocate(CAD_NurbsCurve_Hold.ctrl, 2048)
            ReturnValue(-4)
        }

        CAD_NurbsCurve_Hold.idx = 0
        WhileLoop LessThan(CAD_NurbsCurve_Hold.idx, CAD_NurbsCurve_Hold.nctrl) {
            i = CAD_NurbsCurve_Hold.idx
            b = Multiply(i, 3)
            src = CAD_NurbsCurve_Hold.curve
            dst = CAD_NurbsCurve_Hold.ctrl
            ArraySet(dst, b, ArrayGet(src, b))
            ArraySet(dst, Add(b, 1), ArrayGet(src, Add(b, 1)))
            ArraySet(dst, Add(b, 2), ArrayGet(src, Add(b, 2)))
            CAD_NurbsCurve_Hold.idx = Add(i, 1)
        }
        n = CAD_NurbsCurve_Hold.nctrl
        b = Multiply(n, 3)
        src = CAD_NurbsCurve_Hold.curve
        dst = CAD_NurbsCurve_Hold.ctrl
        ArraySet(dst, b, ArrayGet(src, 0))
        ArraySet(dst, Add(b, 1), ArrayGet(src, 1))
        ArraySet(dst, Add(b, 2), ArrayGet(src, 2))

        nc = Add(CAD_NurbsCurve_Hold.nctrl, 1)
        rc = CAD_NurbsCurve.MakeClamped(1, nc, CAD_NurbsCurve_Hold.knots)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            Deallocate(CAD_NurbsCurve_Hold.ctrl, 2048)
            Deallocate(CAD_NurbsCurve_Hold.knots, 1024)
            ReturnValue(-4)
        }

        ArraySet(CAD_NurbsCurve_Hold.dst, 0, 1)
        ArraySet(CAD_NurbsCurve_Hold.dst, 1, Add(CAD_NurbsCurve_Hold.nctrl, 1))
        ArraySet(CAD_NurbsCurve_Hold.dst, 2, CAD_NurbsCurve_Hold.ctrl)
        ArraySet(CAD_NurbsCurve_Hold.dst, 3, CAD_NurbsCurve_Hold.knots)
        ArraySet(CAD_NurbsCurve_Hold.dst, 4, 0)
        ReturnValue(0)
    }
}

Function.CAD_NurbsCurve.FreeRing {
    Input: curve: Address
    Output: Integer
    Body: {
        CAD_NurbsCurve_Hold.curve = curve
        IfCondition EqualTo(CAD_NurbsCurve_Hold.curve, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsCurve_Hold.ctrl = ArrayGet(CAD_NurbsCurve_Hold.curve, 2)
        CAD_NurbsCurve_Hold.knots = ArrayGet(CAD_NurbsCurve_Hold.curve, 3)
        Deallocate(CAD_NurbsCurve_Hold.ctrl, 2048)
        Deallocate(CAD_NurbsCurve_Hold.knots, 1024)
        ArraySet(CAD_NurbsCurve_Hold.curve, 2, 0)
        ArraySet(CAD_NurbsCurve_Hold.curve, 3, 0)
        ReturnValue(0)
    }
}

// Span i with knots[i] <= u < knots[i+1]. At the last knot, return n_ctrl-1.
Function.CAD_NurbsCurve.FindSpan {
    Input: n_ctrl: Integer
    Input: degree: Integer
    Input: u: Integer
    Input: knots: Address
    Output: Integer
    Body: {
        n = Subtract(n_ctrl, 1)
        u_end = ArrayGet(knots, n_ctrl)
        at_end = Float_Le(u_end, u)
        IfCondition EqualTo(at_end, 1) ThenBlock: {
            ReturnValue(n)
        }
        i = degree
        WhileLoop LessEqual(i, n) {
            ui = ArrayGet(knots, i)
            ui1 = ArrayGet(knots, Add(i, 1))
            c_lo = Float_Le(ui, u)
            c_hi = Float_Le(ui1, u)
            IfCondition EqualTo(c_lo, 1) ThenBlock: {
                IfCondition EqualTo(c_hi, 0) ThenBlock: {
                    ReturnValue(i)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// de Boor on Hold.dbuf. stride is 3 (xyz) or 4 (xyzw). Result lands at point [degree].
Function.CAD_NurbsCurve.Refine {
    Output: Integer
    Body: {
        CAD_NurbsCurve_Hold.rdx = 1
        WhileLoop LessEqual(CAD_NurbsCurve_Hold.rdx, CAD_NurbsCurve_Hold.degree) {
            CAD_NurbsCurve_Hold.jdx = CAD_NurbsCurve_Hold.degree
            WhileLoop GreaterEqual(CAD_NurbsCurve_Hold.jdx, CAD_NurbsCurve_Hold.rdx) {
                j = CAD_NurbsCurve_Hold.jdx
                r = CAD_NurbsCurve_Hold.rdx
                span = CAD_NurbsCurve_Hold.span
                p = CAD_NurbsCurve_Hold.degree
                ilo = Add(Subtract(span, p), j)
                ihi = Add(Subtract(Add(span, j), r), 1)
                k_lo = ArrayGet(CAD_NurbsCurve_Hold.knots, ilo)
                k_hi = ArrayGet(CAD_NurbsCurve_Hold.knots, ihi)
                den = Float_Sub(k_hi, k_lo)
                CAD_NurbsCurve_Hold.tmp = den
                CAD_NurbsCurve_Hold.tmp2 = k_lo
                z = CAD_Num.IsZero(den, 0)
                alpha = 0
                IfCondition EqualTo(z, 0) ThenBlock: {
                    diff = Float_Sub(CAD_NurbsCurve_Hold.u, CAD_NurbsCurve_Hold.tmp2)
                    alpha = Float_Div(diff, CAD_NurbsCurve_Hold.tmp)
                }
                CAD_NurbsCurve_Hold.alpha = alpha
                CAD_NurbsCurve_Hold.om = Float_Sub(0x3FF0000000000000, alpha)

                j = CAD_NurbsCurve_Hold.jdx
                stride = CAD_NurbsCurve_Hold.stride
                alpha = CAD_NurbsCurve_Hold.alpha
                om = CAD_NurbsCurve_Hold.om
                dbuf = CAD_NurbsCurve_Hold.dbuf
                base_j = Multiply(j, stride)
                base_jm = Multiply(Subtract(j, 1), stride)
                c = 0
                WhileLoop LessThan(c, stride) {
                    v0 = ArrayGet(dbuf, Add(base_jm, c))
                    v1 = ArrayGet(dbuf, Add(base_j, c))
                    o_part = Float_Mul(om, v0)
                    a_part = Float_Mul(alpha, v1)
                    sum = Float_Add(o_part, a_part)
                    ArraySet(dbuf, Add(base_j, c), sum)
                    c = Add(c, 1)
                }
                CAD_NurbsCurve_Hold.jdx = Subtract(CAD_NurbsCurve_Hold.jdx, 1)
            }
            CAD_NurbsCurve_Hold.rdx = Add(CAD_NurbsCurve_Hold.rdx, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_NurbsCurve.CurvePoint {
    Input: curve: Address
    Input: u: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        CAD_NurbsCurve_Hold.curve = curve
        CAD_NurbsCurve_Hold.u = u
        CAD_NurbsCurve_Hold.outp = out_xyz
        IfCondition EqualTo(CAD_NurbsCurve_Hold.curve, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.outp, 0) ThenBlock: { ReturnValue(-4) }

        CAD_NurbsCurve_Hold.degree = ArrayGet(CAD_NurbsCurve_Hold.curve, 0)
        CAD_NurbsCurve_Hold.nctrl = ArrayGet(CAD_NurbsCurve_Hold.curve, 1)
        CAD_NurbsCurve_Hold.ctrl = ArrayGet(CAD_NurbsCurve_Hold.curve, 2)
        CAD_NurbsCurve_Hold.knots = ArrayGet(CAD_NurbsCurve_Hold.curve, 3)
        CAD_NurbsCurve_Hold.wts = ArrayGet(CAD_NurbsCurve_Hold.curve, 4)

        IfCondition LessThan(CAD_NurbsCurve_Hold.degree, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsCurve_Hold.degree, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsCurve_Hold.nctrl, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsCurve_Hold.nctrl, 64) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsCurve_Hold.nctrl, Add(CAD_NurbsCurve_Hold.degree, 1)) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.ctrl, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.knots, 0) ThenBlock: { ReturnValue(-4) }

        k0 = ArrayGet(CAD_NurbsCurve_Hold.knots, CAD_NurbsCurve_Hold.degree)
        CAD_NurbsCurve_Hold.tmp = k0
        eq = CAD_Num.IsEqual(CAD_NurbsCurve_Hold.u, CAD_NurbsCurve_Hold.tmp, 0)
        IfCondition EqualTo(eq, 1) ThenBlock: {
            ArraySet(CAD_NurbsCurve_Hold.outp, 0, ArrayGet(CAD_NurbsCurve_Hold.ctrl, 0))
            ArraySet(CAD_NurbsCurve_Hold.outp, 1, ArrayGet(CAD_NurbsCurve_Hold.ctrl, 1))
            ArraySet(CAD_NurbsCurve_Hold.outp, 2, ArrayGet(CAD_NurbsCurve_Hold.ctrl, 2))
            ReturnValue(0)
        }

        kend = ArrayGet(CAD_NurbsCurve_Hold.knots, CAD_NurbsCurve_Hold.nctrl)
        CAD_NurbsCurve_Hold.tmp = kend
        eq = CAD_Num.IsEqual(CAD_NurbsCurve_Hold.u, CAD_NurbsCurve_Hold.tmp, 0)
        IfCondition EqualTo(eq, 1) ThenBlock: {
            last = Subtract(CAD_NurbsCurve_Hold.nctrl, 1)
            b = Multiply(last, 3)
            ctrl = CAD_NurbsCurve_Hold.ctrl
            outp = CAD_NurbsCurve_Hold.outp
            ArraySet(outp, 0, ArrayGet(ctrl, b))
            ArraySet(outp, 1, ArrayGet(ctrl, Add(b, 1)))
            ArraySet(outp, 2, ArrayGet(ctrl, Add(b, 2)))
            ReturnValue(0)
        }

        span = CAD_NurbsCurve.FindSpan(CAD_NurbsCurve_Hold.nctrl, CAD_NurbsCurve_Hold.degree, CAD_NurbsCurve_Hold.u, CAD_NurbsCurve_Hold.knots)
        CAD_NurbsCurve_Hold.span = span
        CAD_NurbsCurve_Hold.dbuf = Allocate(1024)
        IfCondition EqualTo(CAD_NurbsCurve_Hold.dbuf, 0) ThenBlock: { ReturnValue(-4) }

        IfCondition EqualTo(CAD_NurbsCurve_Hold.wts, 0) ThenBlock: {
            CAD_NurbsCurve_Hold.stride = 3
        }
        IfCondition NotEqual(CAD_NurbsCurve_Hold.wts, 0) ThenBlock: {
            CAD_NurbsCurve_Hold.stride = 4
        }

        CAD_NurbsCurve_Hold.jdx = 0
        WhileLoop LessEqual(CAD_NurbsCurve_Hold.jdx, CAD_NurbsCurve_Hold.degree) {
            j = CAD_NurbsCurve_Hold.jdx
            span = CAD_NurbsCurve_Hold.span
            p = CAD_NurbsCurve_Hold.degree
            idx = Add(Subtract(span, p), j)
            IfCondition LessThan(idx, 0) ThenBlock: { idx = 0 }
            IfCondition GreaterEqual(idx, CAD_NurbsCurve_Hold.nctrl) ThenBlock: {
                idx = Subtract(CAD_NurbsCurve_Hold.nctrl, 1)
            }
            sb = Multiply(idx, 3)
            ctrl = CAD_NurbsCurve_Hold.ctrl
            dbuf = CAD_NurbsCurve_Hold.dbuf
            IfCondition EqualTo(CAD_NurbsCurve_Hold.stride, 3) ThenBlock: {
                db = Multiply(j, 3)
                ArraySet(dbuf, db, ArrayGet(ctrl, sb))
                ArraySet(dbuf, Add(db, 1), ArrayGet(ctrl, Add(sb, 1)))
                ArraySet(dbuf, Add(db, 2), ArrayGet(ctrl, Add(sb, 2)))
            }
            IfCondition EqualTo(CAD_NurbsCurve_Hold.stride, 4) ThenBlock: {
                w = ArrayGet(CAD_NurbsCurve_Hold.wts, idx)
                xw = Float_Mul(ArrayGet(ctrl, sb), w)
                yw = Float_Mul(ArrayGet(ctrl, Add(sb, 1)), w)
                zw = Float_Mul(ArrayGet(ctrl, Add(sb, 2)), w)
                db = Multiply(j, 4)
                ArraySet(dbuf, db, xw)
                ArraySet(dbuf, Add(db, 1), yw)
                ArraySet(dbuf, Add(db, 2), zw)
                ArraySet(dbuf, Add(db, 3), w)
            }
            CAD_NurbsCurve_Hold.jdx = Add(j, 1)
        }

        CAD_NurbsCurve.Refine()

        IfCondition EqualTo(CAD_NurbsCurve_Hold.stride, 3) ThenBlock: {
            base = Multiply(CAD_NurbsCurve_Hold.degree, 3)
            c = 0
            WhileLoop LessThan(c, 3) {
                ArraySet(CAD_NurbsCurve_Hold.outp, c, ArrayGet(CAD_NurbsCurve_Hold.dbuf, Add(base, c)))
                c = Add(c, 1)
            }
        }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.stride, 4) ThenBlock: {
            base = Multiply(CAD_NurbsCurve_Hold.degree, 4)
            w = ArrayGet(CAD_NurbsCurve_Hold.dbuf, Add(base, 3))
            CAD_NurbsCurve_Hold.tmp = w
            z = CAD_Num.IsZero(CAD_NurbsCurve_Hold.tmp, 0)
            IfCondition EqualTo(z, 1) ThenBlock: {
                Deallocate(CAD_NurbsCurve_Hold.dbuf, 1024)
                ReturnValue(-4)
            }
            inv = Float_Div(0x3FF0000000000000, CAD_NurbsCurve_Hold.tmp)
            CAD_NurbsCurve_Hold.tmp2 = inv
            base = Multiply(CAD_NurbsCurve_Hold.degree, 4)
            c = 0
            WhileLoop LessThan(c, 3) {
                v = ArrayGet(CAD_NurbsCurve_Hold.dbuf, Add(base, c))
                ArraySet(CAD_NurbsCurve_Hold.outp, c, Float_Mul(v, CAD_NurbsCurve_Hold.tmp2))
                c = Add(c, 1)
            }
        }

        Deallocate(CAD_NurbsCurve_Hold.dbuf, 1024)
        ReturnValue(0)
    }
}

// One polynomial knot insertion. New ctrl and knots are allocated for curve_out.
Function.CAD_NurbsCurve.InsertKnot {
    Input: curve: Address
    Input: u: Integer
    Input: curve_out: Address
    Output: Integer
    Body: {
        CAD_NurbsCurve_Hold.curve = curve
        CAD_NurbsCurve_Hold.u = u
        CAD_NurbsCurve_Hold.dst = curve_out
        IfCondition EqualTo(CAD_NurbsCurve_Hold.curve, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.dst, 0) ThenBlock: { ReturnValue(-4) }

        CAD_NurbsCurve_Hold.degree = ArrayGet(CAD_NurbsCurve_Hold.curve, 0)
        CAD_NurbsCurve_Hold.nctrl = ArrayGet(CAD_NurbsCurve_Hold.curve, 1)
        CAD_NurbsCurve_Hold.ctrl = ArrayGet(CAD_NurbsCurve_Hold.curve, 2)
        CAD_NurbsCurve_Hold.knots = ArrayGet(CAD_NurbsCurve_Hold.curve, 3)
        CAD_NurbsCurve_Hold.wts = ArrayGet(CAD_NurbsCurve_Hold.curve, 4)

        IfCondition NotEqual(CAD_NurbsCurve_Hold.wts, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsCurve_Hold.degree, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsCurve_Hold.degree, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsCurve_Hold.nctrl, Add(CAD_NurbsCurve_Hold.degree, 1)) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsCurve_Hold.nctrl, 63) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.ctrl, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.knots, 0) ThenBlock: { ReturnValue(-4) }

        lo = ArrayGet(CAD_NurbsCurve_Hold.knots, CAD_NurbsCurve_Hold.degree)
        hi = ArrayGet(CAD_NurbsCurve_Hold.knots, CAD_NurbsCurve_Hold.nctrl)
        ok_lo = Float_Le(lo, CAD_NurbsCurve_Hold.u)
        ok_hi = Float_Le(CAD_NurbsCurve_Hold.u, hi)
        IfCondition EqualTo(ok_lo, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(ok_hi, 0) ThenBlock: { ReturnValue(-4) }

        span = CAD_NurbsCurve.FindSpan(CAD_NurbsCurve_Hold.nctrl, CAD_NurbsCurve_Hold.degree, CAD_NurbsCurve_Hold.u, CAD_NurbsCurve_Hold.knots)
        CAD_NurbsCurve_Hold.span = span

        CAD_NurbsCurve_Hold.mul = 0
        CAD_NurbsCurve_Hold.idx = CAD_NurbsCurve_Hold.span
        CAD_NurbsCurve_Hold.tmp = 1
        WhileLoop EqualTo(CAD_NurbsCurve_Hold.tmp, 1) {
            IfCondition LessThan(CAD_NurbsCurve_Hold.idx, 0) ThenBlock: {
                CAD_NurbsCurve_Hold.tmp = 0
            }
            IfCondition EqualTo(CAD_NurbsCurve_Hold.tmp, 1) ThenBlock: {
                kv = ArrayGet(CAD_NurbsCurve_Hold.knots, CAD_NurbsCurve_Hold.idx)
                CAD_NurbsCurve_Hold.tmp2 = kv
                eq = CAD_Num.IsEqual(CAD_NurbsCurve_Hold.tmp2, CAD_NurbsCurve_Hold.u, 0)
                IfCondition EqualTo(eq, 1) ThenBlock: {
                    CAD_NurbsCurve_Hold.mul = Add(CAD_NurbsCurve_Hold.mul, 1)
                    CAD_NurbsCurve_Hold.idx = Subtract(CAD_NurbsCurve_Hold.idx, 1)
                }
                IfCondition EqualTo(eq, 0) ThenBlock: {
                    CAD_NurbsCurve_Hold.tmp = 0
                }
            }
        }
        IfCondition GreaterEqual(CAD_NurbsCurve_Hold.mul, CAD_NurbsCurve_Hold.degree) ThenBlock: {
            ReturnValue(-4)
        }

        CAD_NurbsCurve_Hold.dstc = Allocate(2048)
        CAD_NurbsCurve_Hold.dstk = Allocate(1024)
        IfCondition EqualTo(CAD_NurbsCurve_Hold.dstc, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.dstk, 0) ThenBlock: {
            Deallocate(CAD_NurbsCurve_Hold.dstc, 2048)
            ReturnValue(-4)
        }

        mp = Add(CAD_NurbsCurve_Hold.nctrl, CAD_NurbsCurve_Hold.degree)
        CAD_NurbsCurve_Hold.hi = mp
        CAD_NurbsCurve_Hold.idx = 0
        WhileLoop LessEqual(CAD_NurbsCurve_Hold.idx, CAD_NurbsCurve_Hold.span) {
            i = CAD_NurbsCurve_Hold.idx
            ArraySet(CAD_NurbsCurve_Hold.dstk, i, ArrayGet(CAD_NurbsCurve_Hold.knots, i))
            CAD_NurbsCurve_Hold.idx = Add(i, 1)
        }
        ArraySet(CAD_NurbsCurve_Hold.dstk, Add(CAD_NurbsCurve_Hold.span, 1), CAD_NurbsCurve_Hold.u)
        CAD_NurbsCurve_Hold.idx = Add(CAD_NurbsCurve_Hold.span, 1)
        WhileLoop LessEqual(CAD_NurbsCurve_Hold.idx, CAD_NurbsCurve_Hold.hi) {
            i = CAD_NurbsCurve_Hold.idx
            ArraySet(CAD_NurbsCurve_Hold.dstk, Add(i, 1), ArrayGet(CAD_NurbsCurve_Hold.knots, i))
            CAD_NurbsCurve_Hold.idx = Add(i, 1)
        }

        kp = Subtract(CAD_NurbsCurve_Hold.span, CAD_NurbsCurve_Hold.degree)
        CAD_NurbsCurve_Hold.hi = kp
        CAD_NurbsCurve_Hold.idx = 0
        WhileLoop LessEqual(CAD_NurbsCurve_Hold.idx, CAD_NurbsCurve_Hold.hi) {
            i = CAD_NurbsCurve_Hold.idx
            b = Multiply(i, 3)
            src = CAD_NurbsCurve_Hold.ctrl
            dst = CAD_NurbsCurve_Hold.dstc
            ArraySet(dst, b, ArrayGet(src, b))
            ArraySet(dst, Add(b, 1), ArrayGet(src, Add(b, 1)))
            ArraySet(dst, Add(b, 2), ArrayGet(src, Add(b, 2)))
            CAD_NurbsCurve_Hold.idx = Add(i, 1)
        }

        CAD_NurbsCurve_Hold.hi = CAD_NurbsCurve_Hold.nctrl
        CAD_NurbsCurve_Hold.idx = Add(Subtract(CAD_NurbsCurve_Hold.span, CAD_NurbsCurve_Hold.mul), 1)
        WhileLoop LessEqual(CAD_NurbsCurve_Hold.idx, CAD_NurbsCurve_Hold.hi) {
            i = CAD_NurbsCurve_Hold.idx
            src_i = Subtract(i, 1)
            sb = Multiply(src_i, 3)
            db = Multiply(i, 3)
            src = CAD_NurbsCurve_Hold.ctrl
            dst = CAD_NurbsCurve_Hold.dstc
            ArraySet(dst, db, ArrayGet(src, sb))
            ArraySet(dst, Add(db, 1), ArrayGet(src, Add(sb, 1)))
            ArraySet(dst, Add(db, 2), ArrayGet(src, Add(sb, 2)))
            CAD_NurbsCurve_Hold.idx = Add(i, 1)
        }

        CAD_NurbsCurve_Hold.tmp = Add(Subtract(CAD_NurbsCurve_Hold.span, CAD_NurbsCurve_Hold.degree), 1)
        CAD_NurbsCurve_Hold.hi = Subtract(CAD_NurbsCurve_Hold.span, CAD_NurbsCurve_Hold.mul)
        CAD_NurbsCurve_Hold.idx = CAD_NurbsCurve_Hold.tmp
        WhileLoop LessEqual(CAD_NurbsCurve_Hold.idx, CAD_NurbsCurve_Hold.hi) {
            i = CAD_NurbsCurve_Hold.idx
            CAD_NurbsCurve_Hold.jdx = i
            p = CAD_NurbsCurve_Hold.degree
            k_lo = ArrayGet(CAD_NurbsCurve_Hold.knots, i)
            k_hi = ArrayGet(CAD_NurbsCurve_Hold.knots, Add(i, p))
            den = Float_Sub(k_hi, k_lo)
            CAD_NurbsCurve_Hold.tmp2 = den
            CAD_NurbsCurve_Hold.alpha = k_lo
            z = CAD_Num.IsZero(den, 0)
            alpha = 0
            IfCondition EqualTo(z, 0) ThenBlock: {
                diff = Float_Sub(CAD_NurbsCurve_Hold.u, CAD_NurbsCurve_Hold.alpha)
                alpha = Float_Div(diff, CAD_NurbsCurve_Hold.tmp2)
            }
            CAD_NurbsCurve_Hold.om = Float_Sub(0x3FF0000000000000, alpha)
            CAD_NurbsCurve_Hold.alpha = alpha

            i = CAD_NurbsCurve_Hold.jdx
            alpha = CAD_NurbsCurve_Hold.alpha
            om = CAD_NurbsCurve_Hold.om
            src0 = Subtract(i, 1)
            sb0 = Multiply(src0, 3)
            sb1 = Multiply(i, 3)
            src = CAD_NurbsCurve_Hold.ctrl
            dst = CAD_NurbsCurve_Hold.dstc
            c = 0
            WhileLoop LessThan(c, 3) {
                v0 = ArrayGet(src, Add(sb0, c))
                v1 = ArrayGet(src, Add(sb1, c))
                o_part = Float_Mul(om, v0)
                a_part = Float_Mul(alpha, v1)
                sum = Float_Add(o_part, a_part)
                ArraySet(dst, Add(sb1, c), sum)
                c = Add(c, 1)
            }
            CAD_NurbsCurve_Hold.idx = Add(CAD_NurbsCurve_Hold.jdx, 1)
        }

        ArraySet(CAD_NurbsCurve_Hold.dst, 0, CAD_NurbsCurve_Hold.degree)
        ArraySet(CAD_NurbsCurve_Hold.dst, 1, Add(CAD_NurbsCurve_Hold.nctrl, 1))
        ArraySet(CAD_NurbsCurve_Hold.dst, 2, CAD_NurbsCurve_Hold.dstc)
        ArraySet(CAD_NurbsCurve_Hold.dst, 3, CAD_NurbsCurve_Hold.dstk)
        ArraySet(CAD_NurbsCurve_Hold.dst, 4, 0)
        ReturnValue(0)
    }
}

// Reversed controls. knots[i] = 1 - old[n_knots-1-i]. Polynomial only.
Function.CAD_NurbsCurve.Reverse {
    Input: curve: Address
    Input: curve_out: Address
    Output: Integer
    Body: {
        CAD_NurbsCurve_Hold.curve = curve
        CAD_NurbsCurve_Hold.dst = curve_out
        IfCondition EqualTo(CAD_NurbsCurve_Hold.curve, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.dst, 0) ThenBlock: { ReturnValue(-4) }

        CAD_NurbsCurve_Hold.degree = ArrayGet(CAD_NurbsCurve_Hold.curve, 0)
        CAD_NurbsCurve_Hold.nctrl = ArrayGet(CAD_NurbsCurve_Hold.curve, 1)
        CAD_NurbsCurve_Hold.ctrl = ArrayGet(CAD_NurbsCurve_Hold.curve, 2)
        CAD_NurbsCurve_Hold.knots = ArrayGet(CAD_NurbsCurve_Hold.curve, 3)
        CAD_NurbsCurve_Hold.wts = ArrayGet(CAD_NurbsCurve_Hold.curve, 4)

        IfCondition NotEqual(CAD_NurbsCurve_Hold.wts, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsCurve_Hold.degree, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsCurve_Hold.degree, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsCurve_Hold.nctrl, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsCurve_Hold.nctrl, 64) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsCurve_Hold.nctrl, Add(CAD_NurbsCurve_Hold.degree, 1)) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.ctrl, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.knots, 0) ThenBlock: { ReturnValue(-4) }

        CAD_NurbsCurve_Hold.dstc = Allocate(2048)
        CAD_NurbsCurve_Hold.dstk = Allocate(1024)
        IfCondition EqualTo(CAD_NurbsCurve_Hold.dstc, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsCurve_Hold.dstk, 0) ThenBlock: {
            Deallocate(CAD_NurbsCurve_Hold.dstc, 2048)
            ReturnValue(-4)
        }

        CAD_NurbsCurve_Hold.idx = 0
        WhileLoop LessThan(CAD_NurbsCurve_Hold.idx, CAD_NurbsCurve_Hold.nctrl) {
            i = CAD_NurbsCurve_Hold.idx
            src_i = Subtract(Subtract(CAD_NurbsCurve_Hold.nctrl, 1), i)
            sb = Multiply(src_i, 3)
            db = Multiply(i, 3)
            src = CAD_NurbsCurve_Hold.ctrl
            dst = CAD_NurbsCurve_Hold.dstc
            ArraySet(dst, db, ArrayGet(src, sb))
            ArraySet(dst, Add(db, 1), ArrayGet(src, Add(sb, 1)))
            ArraySet(dst, Add(db, 2), ArrayGet(src, Add(sb, 2)))
            CAD_NurbsCurve_Hold.idx = Add(i, 1)
        }

        one = 0x3FF0000000000000
        n_knots = Add(CAD_NurbsCurve_Hold.nctrl, Add(CAD_NurbsCurve_Hold.degree, 1))
        CAD_NurbsCurve_Hold.hi = n_knots
        CAD_NurbsCurve_Hold.idx = 0
        WhileLoop LessThan(CAD_NurbsCurve_Hold.idx, CAD_NurbsCurve_Hold.hi) {
            i = CAD_NurbsCurve_Hold.idx
            src_i = Subtract(Subtract(CAD_NurbsCurve_Hold.hi, 1), i)
            old = ArrayGet(CAD_NurbsCurve_Hold.knots, src_i)
            neu = Float_Sub(one, old)
            ArraySet(CAD_NurbsCurve_Hold.dstk, i, neu)
            CAD_NurbsCurve_Hold.idx = Add(i, 1)
        }

        ArraySet(CAD_NurbsCurve_Hold.dst, 0, CAD_NurbsCurve_Hold.degree)
        ArraySet(CAD_NurbsCurve_Hold.dst, 1, CAD_NurbsCurve_Hold.nctrl)
        ArraySet(CAD_NurbsCurve_Hold.dst, 2, CAD_NurbsCurve_Hold.dstc)
        ArraySet(CAD_NurbsCurve_Hold.dst, 3, CAD_NurbsCurve_Hold.dstk)
        ArraySet(CAD_NurbsCurve_Hold.dst, 4, 0)
        ReturnValue(0)
    }
}
