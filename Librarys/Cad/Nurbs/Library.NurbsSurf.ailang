// Last control index is n = n_ctrl-1. Domain end is knots[n+1] (Piegl A2.1).
Function.CAD_NurbsSurf.FindSpan {
    Input: n_ctrl: Integer
    Input: degree: Integer
    Input: u_r: Integer
    Input: knots: Address
    Output: Integer
    Body: {
        CAD_NurbsSurf_Span.n = Subtract(n_ctrl, 1)
        CAD_NurbsSurf_Span.p = degree
        CAD_NurbsSurf_Span.u = u_r
        CAD_NurbsSurf_Span.knots = knots
        CAD_NurbsSurf_Span.k = Add(CAD_NurbsSurf_Span.n, 1)
        CAD_NurbsSurf_Span.ui = ArrayGet(CAD_NurbsSurf_Span.knots, CAD_NurbsSurf_Span.k)
        CAD_NurbsSurf_Span.lo = Float_Le(CAD_NurbsSurf_Span.ui, CAD_NurbsSurf_Span.u)
        IfCondition EqualTo(CAD_NurbsSurf_Span.lo, 1) ThenBlock: {
            ReturnValue(CAD_NurbsSurf_Span.n)
        }
        CAD_NurbsSurf_Span.ui = ArrayGet(CAD_NurbsSurf_Span.knots, CAD_NurbsSurf_Span.p)
        CAD_NurbsSurf_Span.lo = Float_Le(CAD_NurbsSurf_Span.u, CAD_NurbsSurf_Span.ui)
        IfCondition EqualTo(CAD_NurbsSurf_Span.lo, 1) ThenBlock: {
            ReturnValue(CAD_NurbsSurf_Span.p)
        }
        CAD_NurbsSurf_Span.i = CAD_NurbsSurf_Span.p
        CAD_NurbsSurf_Span.found = Subtract(0, 1)
        WhileLoop LessEqual(CAD_NurbsSurf_Span.i, CAD_NurbsSurf_Span.n) {
            CAD_NurbsSurf_Span.ui = ArrayGet(CAD_NurbsSurf_Span.knots, CAD_NurbsSurf_Span.i)
            CAD_NurbsSurf_Span.k = Add(CAD_NurbsSurf_Span.i, 1)
            CAD_NurbsSurf_Span.ui1 = ArrayGet(CAD_NurbsSurf_Span.knots, CAD_NurbsSurf_Span.k)
            CAD_NurbsSurf_Span.lo = Float_Le(CAD_NurbsSurf_Span.ui, CAD_NurbsSurf_Span.u)
            CAD_NurbsSurf_Span.hi = Float_Le(CAD_NurbsSurf_Span.ui1, CAD_NurbsSurf_Span.u)
            CAD_NurbsSurf_Span.take = 0
            IfCondition EqualTo(CAD_NurbsSurf_Span.lo, 1) ThenBlock: {
                IfCondition EqualTo(CAD_NurbsSurf_Span.hi, 0) ThenBlock: {
                    CAD_NurbsSurf_Span.take = 1
                }
            }
            IfCondition EqualTo(CAD_NurbsSurf_Span.take, 1) ThenBlock: {
                CAD_NurbsSurf_Span.found = CAD_NurbsSurf_Span.i
                CAD_NurbsSurf_Span.i = Add(CAD_NurbsSurf_Span.n, 2)
            }
            IfCondition EqualTo(CAD_NurbsSurf_Span.take, 0) ThenBlock: {
                CAD_NurbsSurf_Span.i = Add(CAD_NurbsSurf_Span.i, 1)
            }
        }
        IfCondition GreaterEqual(CAD_NurbsSurf_Span.found, 0) ThenBlock: {
            ReturnValue(CAD_NurbsSurf_Span.found)
        }
        ReturnValue(CAD_NurbsSurf_Span.n)
    }
}

// Homogeneous de Boor. ctrl is stride-4 (xw,yw,zw,w). outp is xyzw, not divided.
Function.CAD_NurbsSurf.EvalHomo {
    Input: degree: Integer
    Input: n_ctrl: Integer
    Input: ctrl: Address
    Input: knots: Address
    Input: u_r: Integer
    Input: out_xyzw: Address
    Output: Integer
    Body: {
        CAD_NurbsSurf_Homo.p = degree
        CAD_NurbsSurf_Homo.n = n_ctrl
        CAD_NurbsSurf_Homo.ctrl = ctrl
        CAD_NurbsSurf_Homo.knots = knots
        CAD_NurbsSurf_Homo.u = u_r
        CAD_NurbsSurf_Homo.outp = out_xyzw
        CAD_NurbsSurf_Homo.d = 0
        IfCondition LessThan(CAD_NurbsSurf_Homo.p, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsSurf_Homo.p, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsSurf_Homo.n, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsSurf_Homo.n, 64) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Homo.t = Add(CAD_NurbsSurf_Homo.p, 1)
        IfCondition LessThan(CAD_NurbsSurf_Homo.n, CAD_NurbsSurf_Homo.t) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsSurf_Homo.knots, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsSurf_Homo.ctrl, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsSurf_Homo.outp, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Homo.span = CAD_NurbsSurf.FindSpan(CAD_NurbsSurf_Homo.n, CAD_NurbsSurf_Homo.p, CAD_NurbsSurf_Homo.u, CAD_NurbsSurf_Homo.knots)
        CAD_NurbsSurf_Homo.d = Allocate(512)
        IfCondition EqualTo(CAD_NurbsSurf_Homo.d, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Homo.j = 0
        WhileLoop LessEqual(CAD_NurbsSurf_Homo.j, CAD_NurbsSurf_Homo.p) {
            CAD_NurbsSurf_Homo.idx = Subtract(CAD_NurbsSurf_Homo.span, CAD_NurbsSurf_Homo.p)
            CAD_NurbsSurf_Homo.idx = Add(CAD_NurbsSurf_Homo.idx, CAD_NurbsSurf_Homo.j)
            IfCondition LessThan(CAD_NurbsSurf_Homo.idx, 0) ThenBlock: {
                CAD_NurbsSurf_Homo.idx = 0
            }
            IfCondition GreaterEqual(CAD_NurbsSurf_Homo.idx, CAD_NurbsSurf_Homo.n) ThenBlock: {
                CAD_NurbsSurf_Homo.idx = Subtract(CAD_NurbsSurf_Homo.n, 1)
            }
            CAD_NurbsSurf_Homo.ilo = Multiply(CAD_NurbsSurf_Homo.idx, 4)
            CAD_NurbsSurf_Homo.oj = Multiply(CAD_NurbsSurf_Homo.j, 4)
            CAD_NurbsSurf_Homo.nx = ArrayGet(CAD_NurbsSurf_Homo.ctrl, CAD_NurbsSurf_Homo.ilo)
            ArraySet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.oj, CAD_NurbsSurf_Homo.nx)
            CAD_NurbsSurf_Homo.ilo = Add(CAD_NurbsSurf_Homo.ilo, 1)
            CAD_NurbsSurf_Homo.oj = Add(CAD_NurbsSurf_Homo.oj, 1)
            CAD_NurbsSurf_Homo.ny = ArrayGet(CAD_NurbsSurf_Homo.ctrl, CAD_NurbsSurf_Homo.ilo)
            ArraySet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.oj, CAD_NurbsSurf_Homo.ny)
            CAD_NurbsSurf_Homo.ilo = Add(CAD_NurbsSurf_Homo.ilo, 1)
            CAD_NurbsSurf_Homo.oj = Add(CAD_NurbsSurf_Homo.oj, 1)
            CAD_NurbsSurf_Homo.nz = ArrayGet(CAD_NurbsSurf_Homo.ctrl, CAD_NurbsSurf_Homo.ilo)
            ArraySet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.oj, CAD_NurbsSurf_Homo.nz)
            CAD_NurbsSurf_Homo.ilo = Add(CAD_NurbsSurf_Homo.ilo, 1)
            CAD_NurbsSurf_Homo.oj = Add(CAD_NurbsSurf_Homo.oj, 1)
            CAD_NurbsSurf_Homo.nw = ArrayGet(CAD_NurbsSurf_Homo.ctrl, CAD_NurbsSurf_Homo.ilo)
            ArraySet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.oj, CAD_NurbsSurf_Homo.nw)
            CAD_NurbsSurf_Homo.j = Add(CAD_NurbsSurf_Homo.j, 1)
        }
        CAD_NurbsSurf_Homo.r = 1
        WhileLoop LessEqual(CAD_NurbsSurf_Homo.r, CAD_NurbsSurf_Homo.p) {
            CAD_NurbsSurf_Homo.j = CAD_NurbsSurf_Homo.p
            WhileLoop GreaterEqual(CAD_NurbsSurf_Homo.j, CAD_NurbsSurf_Homo.r) {
                CAD_NurbsSurf_Homo.ilo = Subtract(CAD_NurbsSurf_Homo.span, CAD_NurbsSurf_Homo.p)
                CAD_NurbsSurf_Homo.ilo = Add(CAD_NurbsSurf_Homo.ilo, CAD_NurbsSurf_Homo.j)
                CAD_NurbsSurf_Homo.ihi = Add(CAD_NurbsSurf_Homo.span, CAD_NurbsSurf_Homo.j)
                CAD_NurbsSurf_Homo.ihi = Subtract(CAD_NurbsSurf_Homo.ihi, CAD_NurbsSurf_Homo.r)
                CAD_NurbsSurf_Homo.ihi = Add(CAD_NurbsSurf_Homo.ihi, 1)
                CAD_NurbsSurf_Homo.klo = ArrayGet(CAD_NurbsSurf_Homo.knots, CAD_NurbsSurf_Homo.ilo)
                CAD_NurbsSurf_Homo.khi = ArrayGet(CAD_NurbsSurf_Homo.knots, CAD_NurbsSurf_Homo.ihi)
                CAD_NurbsSurf_Homo.den = Float_Sub(CAD_NurbsSurf_Homo.khi, CAD_NurbsSurf_Homo.klo)
                CAD_NurbsSurf_Homo.alpha = 0
                CAD_NurbsSurf_Homo.zden = CAD_Num.IsZero(CAD_NurbsSurf_Homo.den, 0)
                IfCondition EqualTo(CAD_NurbsSurf_Homo.zden, 0) ThenBlock: {
                    CAD_NurbsSurf_Homo.nx = Float_Sub(CAD_NurbsSurf_Homo.u, CAD_NurbsSurf_Homo.klo)
                    CAD_NurbsSurf_Homo.alpha = Float_Div(CAD_NurbsSurf_Homo.nx, CAD_NurbsSurf_Homo.den)
                }
                CAD_NurbsSurf_Homo.om = Float_Sub(0x3FF0000000000000, CAD_NurbsSurf_Homo.alpha)
                CAD_NurbsSurf_Homo.oj = Multiply(CAD_NurbsSurf_Homo.j, 4)
                CAD_NurbsSurf_Homo.oj1 = Subtract(CAD_NurbsSurf_Homo.j, 1)
                CAD_NurbsSurf_Homo.oj1 = Multiply(CAD_NurbsSurf_Homo.oj1, 4)
                CAD_NurbsSurf_Homo.a0 = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.oj1)
                CAD_NurbsSurf_Homo.a0 = Float_Mul(CAD_NurbsSurf_Homo.om, CAD_NurbsSurf_Homo.a0)
                CAD_NurbsSurf_Homo.b0 = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.oj)
                CAD_NurbsSurf_Homo.b0 = Float_Mul(CAD_NurbsSurf_Homo.alpha, CAD_NurbsSurf_Homo.b0)
                CAD_NurbsSurf_Homo.nx = Float_Add(CAD_NurbsSurf_Homo.a0, CAD_NurbsSurf_Homo.b0)
                CAD_NurbsSurf_Homo.t = Add(CAD_NurbsSurf_Homo.oj1, 1)
                CAD_NurbsSurf_Homo.a0 = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.t)
                CAD_NurbsSurf_Homo.a0 = Float_Mul(CAD_NurbsSurf_Homo.om, CAD_NurbsSurf_Homo.a0)
                CAD_NurbsSurf_Homo.t = Add(CAD_NurbsSurf_Homo.oj, 1)
                CAD_NurbsSurf_Homo.b0 = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.t)
                CAD_NurbsSurf_Homo.b0 = Float_Mul(CAD_NurbsSurf_Homo.alpha, CAD_NurbsSurf_Homo.b0)
                CAD_NurbsSurf_Homo.ny = Float_Add(CAD_NurbsSurf_Homo.a0, CAD_NurbsSurf_Homo.b0)
                CAD_NurbsSurf_Homo.t = Add(CAD_NurbsSurf_Homo.oj1, 2)
                CAD_NurbsSurf_Homo.a0 = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.t)
                CAD_NurbsSurf_Homo.a0 = Float_Mul(CAD_NurbsSurf_Homo.om, CAD_NurbsSurf_Homo.a0)
                CAD_NurbsSurf_Homo.t = Add(CAD_NurbsSurf_Homo.oj, 2)
                CAD_NurbsSurf_Homo.b0 = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.t)
                CAD_NurbsSurf_Homo.b0 = Float_Mul(CAD_NurbsSurf_Homo.alpha, CAD_NurbsSurf_Homo.b0)
                CAD_NurbsSurf_Homo.nz = Float_Add(CAD_NurbsSurf_Homo.a0, CAD_NurbsSurf_Homo.b0)
                CAD_NurbsSurf_Homo.t = Add(CAD_NurbsSurf_Homo.oj1, 3)
                CAD_NurbsSurf_Homo.a0 = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.t)
                CAD_NurbsSurf_Homo.a0 = Float_Mul(CAD_NurbsSurf_Homo.om, CAD_NurbsSurf_Homo.a0)
                CAD_NurbsSurf_Homo.t = Add(CAD_NurbsSurf_Homo.oj, 3)
                CAD_NurbsSurf_Homo.b0 = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.t)
                CAD_NurbsSurf_Homo.b0 = Float_Mul(CAD_NurbsSurf_Homo.alpha, CAD_NurbsSurf_Homo.b0)
                CAD_NurbsSurf_Homo.nw = Float_Add(CAD_NurbsSurf_Homo.a0, CAD_NurbsSurf_Homo.b0)
                ArraySet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.oj, CAD_NurbsSurf_Homo.nx)
                CAD_NurbsSurf_Homo.t = Add(CAD_NurbsSurf_Homo.oj, 1)
                ArraySet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.t, CAD_NurbsSurf_Homo.ny)
                CAD_NurbsSurf_Homo.t = Add(CAD_NurbsSurf_Homo.oj, 2)
                ArraySet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.t, CAD_NurbsSurf_Homo.nz)
                CAD_NurbsSurf_Homo.t = Add(CAD_NurbsSurf_Homo.oj, 3)
                ArraySet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.t, CAD_NurbsSurf_Homo.nw)
                CAD_NurbsSurf_Homo.j = Subtract(CAD_NurbsSurf_Homo.j, 1)
            }
            CAD_NurbsSurf_Homo.r = Add(CAD_NurbsSurf_Homo.r, 1)
        }
        CAD_NurbsSurf_Homo.oj = Multiply(CAD_NurbsSurf_Homo.p, 4)
        CAD_NurbsSurf_Homo.nx = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.oj)
        CAD_NurbsSurf_Homo.oj = Add(CAD_NurbsSurf_Homo.oj, 1)
        CAD_NurbsSurf_Homo.ny = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.oj)
        CAD_NurbsSurf_Homo.oj = Add(CAD_NurbsSurf_Homo.oj, 1)
        CAD_NurbsSurf_Homo.nz = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.oj)
        CAD_NurbsSurf_Homo.oj = Add(CAD_NurbsSurf_Homo.oj, 1)
        CAD_NurbsSurf_Homo.nw = ArrayGet(CAD_NurbsSurf_Homo.d, CAD_NurbsSurf_Homo.oj)
        ArraySet(CAD_NurbsSurf_Homo.outp, 0, CAD_NurbsSurf_Homo.nx)
        ArraySet(CAD_NurbsSurf_Homo.outp, 1, CAD_NurbsSurf_Homo.ny)
        ArraySet(CAD_NurbsSurf_Homo.outp, 2, CAD_NurbsSurf_Homo.nz)
        ArraySet(CAD_NurbsSurf_Homo.outp, 3, CAD_NurbsSurf_Homo.nw)
        Deallocate(CAD_NurbsSurf_Homo.d, 512)
        CAD_NurbsSurf_Homo.d = 0
        ReturnValue(0)
    }
}

Function.CAD_NurbsSurf.ReleaseEval {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_NurbsSurf_Eval.hout, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Eval.hout, 48)
            CAD_NurbsSurf_Eval.hout = 0
        }
        IfCondition NotEqual(CAD_NurbsSurf_Eval.col, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Eval.col, 4096)
            CAD_NurbsSurf_Eval.col = 0
        }
        IfCondition NotEqual(CAD_NurbsSurf_Eval.row, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Eval.row, 4096)
            CAD_NurbsSurf_Eval.row = 0
        }
        ReturnValue(0)
    }
}

// Eval(surf, uv, out_xyz). uv is two floats. w = 1 when weights is 0.
Function.CAD_NurbsSurf.Eval {
    Input: surf_addr: Address
    Input: uv_addr: Address
    Input: out_xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(surf_addr, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(uv_addr, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(out_xyz, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Eval.du = ArrayGet(surf_addr, 0)
        CAD_NurbsSurf_Eval.dv = ArrayGet(surf_addr, 1)
        CAD_NurbsSurf_Eval.nu = ArrayGet(surf_addr, 2)
        CAD_NurbsSurf_Eval.nv = ArrayGet(surf_addr, 3)
        CAD_NurbsSurf_Eval.ctrl = ArrayGet(surf_addr, 4)
        CAD_NurbsSurf_Eval.wts = ArrayGet(surf_addr, 5)
        CAD_NurbsSurf_Eval.ku = ArrayGet(surf_addr, 6)
        CAD_NurbsSurf_Eval.kv = ArrayGet(surf_addr, 7)
        CAD_NurbsSurf_Eval.u = ArrayGet(uv_addr, 0)
        CAD_NurbsSurf_Eval.v = ArrayGet(uv_addr, 1)
        CAD_NurbsSurf_Eval.outp = out_xyz
        CAD_NurbsSurf_Eval.row = 0
        CAD_NurbsSurf_Eval.col = 0
        CAD_NurbsSurf_Eval.hout = 0
        IfCondition EqualTo(CAD_NurbsSurf_Eval.ku, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsSurf_Eval.kv, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsSurf_Eval.ctrl, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsSurf_Eval.du, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsSurf_Eval.du, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsSurf_Eval.dv, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsSurf_Eval.dv, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsSurf_Eval.nu, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsSurf_Eval.nu, 64) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsSurf_Eval.nv, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsSurf_Eval.nv, 64) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Eval.t = Add(CAD_NurbsSurf_Eval.du, 1)
        IfCondition LessThan(CAD_NurbsSurf_Eval.nu, CAD_NurbsSurf_Eval.t) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Eval.t = Add(CAD_NurbsSurf_Eval.dv, 1)
        IfCondition LessThan(CAD_NurbsSurf_Eval.nv, CAD_NurbsSurf_Eval.t) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Eval.row = Allocate(4096)
        IfCondition EqualTo(CAD_NurbsSurf_Eval.row, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Eval.col = Allocate(4096)
        IfCondition EqualTo(CAD_NurbsSurf_Eval.col, 0) ThenBlock: {
            CAD_NurbsSurf.ReleaseEval()
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Eval.hout = Allocate(48)
        IfCondition EqualTo(CAD_NurbsSurf_Eval.hout, 0) ThenBlock: {
            CAD_NurbsSurf.ReleaseEval()
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Eval.i = 0
        WhileLoop LessThan(CAD_NurbsSurf_Eval.i, CAD_NurbsSurf_Eval.nu) {
            CAD_NurbsSurf_Eval.j = 0
            WhileLoop LessThan(CAD_NurbsSurf_Eval.j, CAD_NurbsSurf_Eval.nv) {
                CAD_NurbsSurf_Eval.base = Multiply(CAD_NurbsSurf_Eval.j, CAD_NurbsSurf_Eval.nu)
                CAD_NurbsSurf_Eval.base = Add(CAD_NurbsSurf_Eval.base, CAD_NurbsSurf_Eval.i)
                CAD_NurbsSurf_Eval.xb = Multiply(CAD_NurbsSurf_Eval.base, 3)
                CAD_NurbsSurf_Eval.w = 0x3FF0000000000000
                IfCondition NotEqual(CAD_NurbsSurf_Eval.wts, 0) ThenBlock: {
                    CAD_NurbsSurf_Eval.w = ArrayGet(CAD_NurbsSurf_Eval.wts, CAD_NurbsSurf_Eval.base)
                }
                CAD_NurbsSurf_Eval.x = ArrayGet(CAD_NurbsSurf_Eval.ctrl, CAD_NurbsSurf_Eval.xb)
                CAD_NurbsSurf_Eval.x = Float_Mul(CAD_NurbsSurf_Eval.x, CAD_NurbsSurf_Eval.w)
                CAD_NurbsSurf_Eval.o = Multiply(CAD_NurbsSurf_Eval.j, 4)
                ArraySet(CAD_NurbsSurf_Eval.col, CAD_NurbsSurf_Eval.o, CAD_NurbsSurf_Eval.x)
                CAD_NurbsSurf_Eval.xb = Add(CAD_NurbsSurf_Eval.xb, 1)
                CAD_NurbsSurf_Eval.y = ArrayGet(CAD_NurbsSurf_Eval.ctrl, CAD_NurbsSurf_Eval.xb)
                CAD_NurbsSurf_Eval.y = Float_Mul(CAD_NurbsSurf_Eval.y, CAD_NurbsSurf_Eval.w)
                CAD_NurbsSurf_Eval.o = Add(CAD_NurbsSurf_Eval.o, 1)
                ArraySet(CAD_NurbsSurf_Eval.col, CAD_NurbsSurf_Eval.o, CAD_NurbsSurf_Eval.y)
                CAD_NurbsSurf_Eval.xb = Add(CAD_NurbsSurf_Eval.xb, 1)
                CAD_NurbsSurf_Eval.z = ArrayGet(CAD_NurbsSurf_Eval.ctrl, CAD_NurbsSurf_Eval.xb)
                CAD_NurbsSurf_Eval.z = Float_Mul(CAD_NurbsSurf_Eval.z, CAD_NurbsSurf_Eval.w)
                CAD_NurbsSurf_Eval.o = Add(CAD_NurbsSurf_Eval.o, 1)
                ArraySet(CAD_NurbsSurf_Eval.col, CAD_NurbsSurf_Eval.o, CAD_NurbsSurf_Eval.z)
                CAD_NurbsSurf_Eval.o = Add(CAD_NurbsSurf_Eval.o, 1)
                ArraySet(CAD_NurbsSurf_Eval.col, CAD_NurbsSurf_Eval.o, CAD_NurbsSurf_Eval.w)
                CAD_NurbsSurf_Eval.j = Add(CAD_NurbsSurf_Eval.j, 1)
            }
            CAD_NurbsSurf_Eval.rc = CAD_NurbsSurf.EvalHomo(CAD_NurbsSurf_Eval.dv, CAD_NurbsSurf_Eval.nv, CAD_NurbsSurf_Eval.col, CAD_NurbsSurf_Eval.kv, CAD_NurbsSurf_Eval.v, CAD_NurbsSurf_Eval.hout)
            IfCondition NotEqual(CAD_NurbsSurf_Eval.rc, 0) ThenBlock: {
                CAD_NurbsSurf.ReleaseEval()
                ReturnValue(-4)
            }
            CAD_NurbsSurf_Eval.o = Multiply(CAD_NurbsSurf_Eval.i, 4)
            CAD_NurbsSurf_Eval.x = ArrayGet(CAD_NurbsSurf_Eval.hout, 0)
            ArraySet(CAD_NurbsSurf_Eval.row, CAD_NurbsSurf_Eval.o, CAD_NurbsSurf_Eval.x)
            CAD_NurbsSurf_Eval.o = Add(CAD_NurbsSurf_Eval.o, 1)
            CAD_NurbsSurf_Eval.y = ArrayGet(CAD_NurbsSurf_Eval.hout, 1)
            ArraySet(CAD_NurbsSurf_Eval.row, CAD_NurbsSurf_Eval.o, CAD_NurbsSurf_Eval.y)
            CAD_NurbsSurf_Eval.o = Add(CAD_NurbsSurf_Eval.o, 1)
            CAD_NurbsSurf_Eval.z = ArrayGet(CAD_NurbsSurf_Eval.hout, 2)
            ArraySet(CAD_NurbsSurf_Eval.row, CAD_NurbsSurf_Eval.o, CAD_NurbsSurf_Eval.z)
            CAD_NurbsSurf_Eval.o = Add(CAD_NurbsSurf_Eval.o, 1)
            CAD_NurbsSurf_Eval.w = ArrayGet(CAD_NurbsSurf_Eval.hout, 3)
            ArraySet(CAD_NurbsSurf_Eval.row, CAD_NurbsSurf_Eval.o, CAD_NurbsSurf_Eval.w)
            CAD_NurbsSurf_Eval.i = Add(CAD_NurbsSurf_Eval.i, 1)
        }
        CAD_NurbsSurf_Eval.rc = CAD_NurbsSurf.EvalHomo(CAD_NurbsSurf_Eval.du, CAD_NurbsSurf_Eval.nu, CAD_NurbsSurf_Eval.row, CAD_NurbsSurf_Eval.ku, CAD_NurbsSurf_Eval.u, CAD_NurbsSurf_Eval.hout)
        IfCondition NotEqual(CAD_NurbsSurf_Eval.rc, 0) ThenBlock: {
            CAD_NurbsSurf.ReleaseEval()
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Eval.x = ArrayGet(CAD_NurbsSurf_Eval.hout, 0)
        CAD_NurbsSurf_Eval.y = ArrayGet(CAD_NurbsSurf_Eval.hout, 1)
        CAD_NurbsSurf_Eval.z = ArrayGet(CAD_NurbsSurf_Eval.hout, 2)
        CAD_NurbsSurf_Eval.w = ArrayGet(CAD_NurbsSurf_Eval.hout, 3)
        CAD_NurbsSurf_Eval.rc = CAD_Num.IsZero(CAD_NurbsSurf_Eval.w, 0)
        IfCondition EqualTo(CAD_NurbsSurf_Eval.rc, 1) ThenBlock: {
            CAD_NurbsSurf.ReleaseEval()
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Eval.x = Float_Div(CAD_NurbsSurf_Eval.x, CAD_NurbsSurf_Eval.w)
        CAD_NurbsSurf_Eval.y = Float_Div(CAD_NurbsSurf_Eval.y, CAD_NurbsSurf_Eval.w)
        CAD_NurbsSurf_Eval.z = Float_Div(CAD_NurbsSurf_Eval.z, CAD_NurbsSurf_Eval.w)
        ArraySet(CAD_NurbsSurf_Eval.outp, 0, CAD_NurbsSurf_Eval.x)
        ArraySet(CAD_NurbsSurf_Eval.outp, 1, CAD_NurbsSurf_Eval.y)
        ArraySet(CAD_NurbsSurf_Eval.outp, 2, CAD_NurbsSurf_Eval.z)
        CAD_NurbsSurf.ReleaseEval()
        ReturnValue(0)
    }
}

// Degree-1 in v between two equal polynomial curves. knots_u aliases curve A.
Function.CAD_NurbsSurf.MakeRuled {
    Input: curve_a: Address
    Input: curve_b: Address
    Input: surf_out: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(curve_a, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(curve_b, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(surf_out, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Ruled.a = curve_a
        CAD_NurbsSurf_Ruled.b = curve_b
        CAD_NurbsSurf_Ruled.surf = surf_out
        CAD_NurbsSurf_Ruled.da = ArrayGet(CAD_NurbsSurf_Ruled.a, 0)
        CAD_NurbsSurf_Ruled.db = ArrayGet(CAD_NurbsSurf_Ruled.b, 0)
        CAD_NurbsSurf_Ruled.na = ArrayGet(CAD_NurbsSurf_Ruled.a, 1)
        CAD_NurbsSurf_Ruled.nb = ArrayGet(CAD_NurbsSurf_Ruled.b, 1)
        CAD_NurbsSurf_Ruled.cta = ArrayGet(CAD_NurbsSurf_Ruled.a, 2)
        CAD_NurbsSurf_Ruled.ctb = ArrayGet(CAD_NurbsSurf_Ruled.b, 2)
        CAD_NurbsSurf_Ruled.knots = ArrayGet(CAD_NurbsSurf_Ruled.a, 3)
        CAD_NurbsSurf_Ruled.wa = ArrayGet(CAD_NurbsSurf_Ruled.a, 4)
        CAD_NurbsSurf_Ruled.wb = ArrayGet(CAD_NurbsSurf_Ruled.b, 4)
        IfCondition NotEqual(CAD_NurbsSurf_Ruled.da, CAD_NurbsSurf_Ruled.db) ThenBlock: { ReturnValue(-4) }
        IfCondition NotEqual(CAD_NurbsSurf_Ruled.na, CAD_NurbsSurf_Ruled.nb) ThenBlock: { ReturnValue(-4) }
        IfCondition NotEqual(CAD_NurbsSurf_Ruled.wa, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition NotEqual(CAD_NurbsSurf_Ruled.wb, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsSurf_Ruled.da, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsSurf_Ruled.da, 8) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(CAD_NurbsSurf_Ruled.na, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(CAD_NurbsSurf_Ruled.na, 64) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Ruled.need = Add(CAD_NurbsSurf_Ruled.da, 1)
        IfCondition LessThan(CAD_NurbsSurf_Ruled.na, CAD_NurbsSurf_Ruled.need) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsSurf_Ruled.cta, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsSurf_Ruled.ctb, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_NurbsSurf_Ruled.knots, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Ruled.ctrl = Allocate(4096)
        IfCondition EqualTo(CAD_NurbsSurf_Ruled.ctrl, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Ruled.kv = Allocate(64)
        IfCondition EqualTo(CAD_NurbsSurf_Ruled.kv, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Ruled.ctrl, 4096)
            CAD_NurbsSurf_Ruled.ctrl = 0
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Ruled.i = 0
        WhileLoop LessThan(CAD_NurbsSurf_Ruled.i, CAD_NurbsSurf_Ruled.na) {
            CAD_NurbsSurf_Ruled.s = Multiply(CAD_NurbsSurf_Ruled.i, 3)
            CAD_NurbsSurf_Ruled.x = ArrayGet(CAD_NurbsSurf_Ruled.cta, CAD_NurbsSurf_Ruled.s)
            ArraySet(CAD_NurbsSurf_Ruled.ctrl, CAD_NurbsSurf_Ruled.s, CAD_NurbsSurf_Ruled.x)
            CAD_NurbsSurf_Ruled.s = Add(CAD_NurbsSurf_Ruled.s, 1)
            CAD_NurbsSurf_Ruled.y = ArrayGet(CAD_NurbsSurf_Ruled.cta, CAD_NurbsSurf_Ruled.s)
            ArraySet(CAD_NurbsSurf_Ruled.ctrl, CAD_NurbsSurf_Ruled.s, CAD_NurbsSurf_Ruled.y)
            CAD_NurbsSurf_Ruled.s = Add(CAD_NurbsSurf_Ruled.s, 1)
            CAD_NurbsSurf_Ruled.z = ArrayGet(CAD_NurbsSurf_Ruled.cta, CAD_NurbsSurf_Ruled.s)
            ArraySet(CAD_NurbsSurf_Ruled.ctrl, CAD_NurbsSurf_Ruled.s, CAD_NurbsSurf_Ruled.z)
            CAD_NurbsSurf_Ruled.d = Add(CAD_NurbsSurf_Ruled.na, CAD_NurbsSurf_Ruled.i)
            CAD_NurbsSurf_Ruled.d = Multiply(CAD_NurbsSurf_Ruled.d, 3)
            CAD_NurbsSurf_Ruled.s = Multiply(CAD_NurbsSurf_Ruled.i, 3)
            CAD_NurbsSurf_Ruled.x = ArrayGet(CAD_NurbsSurf_Ruled.ctb, CAD_NurbsSurf_Ruled.s)
            ArraySet(CAD_NurbsSurf_Ruled.ctrl, CAD_NurbsSurf_Ruled.d, CAD_NurbsSurf_Ruled.x)
            CAD_NurbsSurf_Ruled.s = Add(CAD_NurbsSurf_Ruled.s, 1)
            CAD_NurbsSurf_Ruled.d = Add(CAD_NurbsSurf_Ruled.d, 1)
            CAD_NurbsSurf_Ruled.y = ArrayGet(CAD_NurbsSurf_Ruled.ctb, CAD_NurbsSurf_Ruled.s)
            ArraySet(CAD_NurbsSurf_Ruled.ctrl, CAD_NurbsSurf_Ruled.d, CAD_NurbsSurf_Ruled.y)
            CAD_NurbsSurf_Ruled.s = Add(CAD_NurbsSurf_Ruled.s, 1)
            CAD_NurbsSurf_Ruled.d = Add(CAD_NurbsSurf_Ruled.d, 1)
            CAD_NurbsSurf_Ruled.z = ArrayGet(CAD_NurbsSurf_Ruled.ctb, CAD_NurbsSurf_Ruled.s)
            ArraySet(CAD_NurbsSurf_Ruled.ctrl, CAD_NurbsSurf_Ruled.d, CAD_NurbsSurf_Ruled.z)
            CAD_NurbsSurf_Ruled.i = Add(CAD_NurbsSurf_Ruled.i, 1)
        }
        ArraySet(CAD_NurbsSurf_Ruled.kv, 0, 0)
        ArraySet(CAD_NurbsSurf_Ruled.kv, 1, 0)
        ArraySet(CAD_NurbsSurf_Ruled.kv, 2, 0x3FF0000000000000)
        ArraySet(CAD_NurbsSurf_Ruled.kv, 3, 0x3FF0000000000000)
        ArraySet(CAD_NurbsSurf_Ruled.surf, 0, CAD_NurbsSurf_Ruled.da)
        ArraySet(CAD_NurbsSurf_Ruled.surf, 1, 1)
        ArraySet(CAD_NurbsSurf_Ruled.surf, 2, CAD_NurbsSurf_Ruled.na)
        ArraySet(CAD_NurbsSurf_Ruled.surf, 3, 2)
        ArraySet(CAD_NurbsSurf_Ruled.surf, 4, CAD_NurbsSurf_Ruled.ctrl)
        ArraySet(CAD_NurbsSurf_Ruled.surf, 5, 0)
        ArraySet(CAD_NurbsSurf_Ruled.surf, 6, CAD_NurbsSurf_Ruled.knots)
        ArraySet(CAD_NurbsSurf_Ruled.surf, 7, CAD_NurbsSurf_Ruled.kv)
        ReturnValue(0)
    }
}

// Frees the ruled ctrl net and knots_v. Does not free knots_u.
Function.CAD_NurbsSurf.FreeRuled {
    Input: surf_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(surf_addr, 0) ThenBlock: { ReturnValue(0) }
        CAD_NurbsSurf_Ruled.surf = surf_addr
        CAD_NurbsSurf_Ruled.ctrl = ArrayGet(CAD_NurbsSurf_Ruled.surf, 4)
        CAD_NurbsSurf_Ruled.kv = ArrayGet(CAD_NurbsSurf_Ruled.surf, 7)
        IfCondition NotEqual(CAD_NurbsSurf_Ruled.ctrl, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Ruled.ctrl, 4096)
        }
        IfCondition NotEqual(CAD_NurbsSurf_Ruled.kv, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Ruled.kv, 64)
        }
        ArraySet(CAD_NurbsSurf_Ruled.surf, 4, 0)
        ArraySet(CAD_NurbsSurf_Ruled.surf, 7, 0)
        CAD_NurbsSurf_Ruled.ctrl = 0
        CAD_NurbsSurf_Ruled.kv = 0
        ReturnValue(0)
    }
}

// u = i/n at v = 0 and v = 1. n is the unique corner count, 3..60.
Function.CAD_NurbsSurf.SampleEnds {
    Input: surf_addr: Address
    Input: n: Integer
    Input: xyz_bot: Address
    Input: xyz_top: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(n, 60) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(surf_addr, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(xyz_bot, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(xyz_top, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Samp.surf = surf_addr
        CAD_NurbsSurf_Samp.n = n
        CAD_NurbsSurf_Samp.bot = xyz_bot
        CAD_NurbsSurf_Samp.top = xyz_top
        CAD_NurbsSurf_Samp.one = 0x3FF0000000000000
        CAD_NurbsSurf_Samp.fn = Float_FromInt(CAD_NurbsSurf_Samp.n)
        CAD_NurbsSurf_Samp.uv = Allocate(48)
        IfCondition EqualTo(CAD_NurbsSurf_Samp.uv, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Samp.outp = Allocate(48)
        IfCondition EqualTo(CAD_NurbsSurf_Samp.outp, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Samp.uv, 48)
            CAD_NurbsSurf_Samp.uv = 0
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Samp.i = 0
        WhileLoop LessThan(CAD_NurbsSurf_Samp.i, CAD_NurbsSurf_Samp.n) {
            CAD_NurbsSurf_Samp.fi = Float_FromInt(CAD_NurbsSurf_Samp.i)
            CAD_NurbsSurf_Samp.u = Float_Div(CAD_NurbsSurf_Samp.fi, CAD_NurbsSurf_Samp.fn)
            ArraySet(CAD_NurbsSurf_Samp.uv, 0, CAD_NurbsSurf_Samp.u)
            ArraySet(CAD_NurbsSurf_Samp.uv, 1, 0)
            CAD_NurbsSurf_Samp.rc = CAD_NurbsSurf.Eval(CAD_NurbsSurf_Samp.surf, CAD_NurbsSurf_Samp.uv, CAD_NurbsSurf_Samp.outp)
            IfCondition NotEqual(CAD_NurbsSurf_Samp.rc, 0) ThenBlock: {
                Deallocate(CAD_NurbsSurf_Samp.uv, 48)
                Deallocate(CAD_NurbsSurf_Samp.outp, 48)
                CAD_NurbsSurf_Samp.uv = 0
                CAD_NurbsSurf_Samp.outp = 0
                ReturnValue(-4)
            }
            CAD_NurbsSurf_Samp.o = Multiply(CAD_NurbsSurf_Samp.i, 3)
            CAD_NurbsSurf_Samp.x = ArrayGet(CAD_NurbsSurf_Samp.outp, 0)
            ArraySet(CAD_NurbsSurf_Samp.bot, CAD_NurbsSurf_Samp.o, CAD_NurbsSurf_Samp.x)
            CAD_NurbsSurf_Samp.o = Add(CAD_NurbsSurf_Samp.o, 1)
            CAD_NurbsSurf_Samp.y = ArrayGet(CAD_NurbsSurf_Samp.outp, 1)
            ArraySet(CAD_NurbsSurf_Samp.bot, CAD_NurbsSurf_Samp.o, CAD_NurbsSurf_Samp.y)
            CAD_NurbsSurf_Samp.o = Add(CAD_NurbsSurf_Samp.o, 1)
            CAD_NurbsSurf_Samp.z = ArrayGet(CAD_NurbsSurf_Samp.outp, 2)
            ArraySet(CAD_NurbsSurf_Samp.bot, CAD_NurbsSurf_Samp.o, CAD_NurbsSurf_Samp.z)
            ArraySet(CAD_NurbsSurf_Samp.uv, 0, CAD_NurbsSurf_Samp.u)
            ArraySet(CAD_NurbsSurf_Samp.uv, 1, CAD_NurbsSurf_Samp.one)
            CAD_NurbsSurf_Samp.rc = CAD_NurbsSurf.Eval(CAD_NurbsSurf_Samp.surf, CAD_NurbsSurf_Samp.uv, CAD_NurbsSurf_Samp.outp)
            IfCondition NotEqual(CAD_NurbsSurf_Samp.rc, 0) ThenBlock: {
                Deallocate(CAD_NurbsSurf_Samp.uv, 48)
                Deallocate(CAD_NurbsSurf_Samp.outp, 48)
                CAD_NurbsSurf_Samp.uv = 0
                CAD_NurbsSurf_Samp.outp = 0
                ReturnValue(-4)
            }
            CAD_NurbsSurf_Samp.o = Multiply(CAD_NurbsSurf_Samp.i, 3)
            CAD_NurbsSurf_Samp.x = ArrayGet(CAD_NurbsSurf_Samp.outp, 0)
            ArraySet(CAD_NurbsSurf_Samp.top, CAD_NurbsSurf_Samp.o, CAD_NurbsSurf_Samp.x)
            CAD_NurbsSurf_Samp.o = Add(CAD_NurbsSurf_Samp.o, 1)
            CAD_NurbsSurf_Samp.y = ArrayGet(CAD_NurbsSurf_Samp.outp, 1)
            ArraySet(CAD_NurbsSurf_Samp.top, CAD_NurbsSurf_Samp.o, CAD_NurbsSurf_Samp.y)
            CAD_NurbsSurf_Samp.o = Add(CAD_NurbsSurf_Samp.o, 1)
            CAD_NurbsSurf_Samp.z = ArrayGet(CAD_NurbsSurf_Samp.outp, 2)
            ArraySet(CAD_NurbsSurf_Samp.top, CAD_NurbsSurf_Samp.o, CAD_NurbsSurf_Samp.z)
            CAD_NurbsSurf_Samp.i = Add(CAD_NurbsSurf_Samp.i, 1)
        }
        Deallocate(CAD_NurbsSurf_Samp.uv, 48)
        Deallocate(CAD_NurbsSurf_Samp.outp, 48)
        CAD_NurbsSurf_Samp.uv = 0
        CAD_NurbsSurf_Samp.outp = 0
        ReturnValue(0)
    }
}

// Drop the scratch BindWall owns. The kind-6 record stays with the solid.
Function.CAD_NurbsSurf.ReleaseWall {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_NurbsSurf_Wall.ctrl, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Wall.ctrl, 256)
        }
        IfCondition NotEqual(CAD_NurbsSurf_Wall.wts, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Wall.wts, 64)
        }
        IfCondition NotEqual(CAD_NurbsSurf_Wall.ku, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Wall.ku, 64)
        }
        IfCondition NotEqual(CAD_NurbsSurf_Wall.kv, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Wall.kv, 64)
        }
        IfCondition NotEqual(CAD_NurbsSurf_Wall.surf, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Wall.surf, 128)
        }
        IfCondition NotEqual(CAD_NurbsSurf_Wall.uv, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Wall.uv, 48)
        }
        IfCondition NotEqual(CAD_NurbsSurf_Wall.outp, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Wall.outp, 48)
        }
        IfCondition NotEqual(CAD_NurbsSurf_Wall.pts, 0) ThenBlock: {
            Deallocate(CAD_NurbsSurf_Wall.pts, 128)
        }
        CAD_NurbsSurf_Wall.ctrl = 0
        CAD_NurbsSurf_Wall.wts = 0
        CAD_NurbsSurf_Wall.ku = 0
        CAD_NurbsSurf_Wall.kv = 0
        CAD_NurbsSurf_Wall.surf = 0
        CAD_NurbsSurf_Wall.uv = 0
        CAD_NurbsSurf_Wall.outp = 0
        CAD_NurbsSurf_Wall.pts = 0
        ReturnValue(0)
    }
}

// Wall.h is the kind-6 record. Fills the descriptor Eval already uses.
Function.CAD_NurbsSurf.BindWall {
    Output: Integer
    Body: {
        CAD_NurbsSurf.ReleaseWall()
        IfCondition EqualTo(CAD_NurbsSurf_Wall.h, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Wall.rc = CAD_Store.Read(CAD_NurbsSurf_Wall.h, 0)
        IfCondition NotEqual(CAD_NurbsSurf_Wall.rc, 6) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Wall.one = 0x3FF0000000000000
        CAD_NurbsSurf_Wall.ctrl = Allocate(256)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.ctrl, 0) ThenBlock: { ReturnValue(-4) }
        CAD_NurbsSurf_Wall.wts = Allocate(64)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.wts, 0) ThenBlock: {
            CAD_NurbsSurf.ReleaseWall()
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Wall.ku = Allocate(64)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.ku, 0) ThenBlock: {
            CAD_NurbsSurf.ReleaseWall()
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Wall.kv = Allocate(64)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.kv, 0) ThenBlock: {
            CAD_NurbsSurf.ReleaseWall()
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Wall.surf = Allocate(128)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.surf, 0) ThenBlock: {
            CAD_NurbsSurf.ReleaseWall()
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Wall.uv = Allocate(48)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.uv, 0) ThenBlock: {
            CAD_NurbsSurf.ReleaseWall()
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Wall.outp = Allocate(48)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.outp, 0) ThenBlock: {
            CAD_NurbsSurf.ReleaseWall()
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Wall.pts = Allocate(128)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.pts, 0) ThenBlock: {
            CAD_NurbsSurf.ReleaseWall()
            ReturnValue(-4)
        }
        CAD_NurbsSurf_Wall.i = 0
        WhileLoop LessThan(CAD_NurbsSurf_Wall.i, 18) {
            CAD_NurbsSurf_Wall.s = Add(CAD_NurbsSurf_Wall.i, 5)
            CAD_NurbsSurf_Wall.v = CAD_Store.Read(CAD_NurbsSurf_Wall.h, CAD_NurbsSurf_Wall.s)
            ArraySet(CAD_NurbsSurf_Wall.ctrl, CAD_NurbsSurf_Wall.i, CAD_NurbsSurf_Wall.v)
            CAD_NurbsSurf_Wall.i = Add(CAD_NurbsSurf_Wall.i, 1)
        }
        CAD_NurbsSurf_Wall.i = 0
        WhileLoop LessThan(CAD_NurbsSurf_Wall.i, 6) {
            CAD_NurbsSurf_Wall.s = Add(CAD_NurbsSurf_Wall.i, 23)
            CAD_NurbsSurf_Wall.v = CAD_Store.Read(CAD_NurbsSurf_Wall.h, CAD_NurbsSurf_Wall.s)
            ArraySet(CAD_NurbsSurf_Wall.wts, CAD_NurbsSurf_Wall.i, CAD_NurbsSurf_Wall.v)
            CAD_NurbsSurf_Wall.i = Add(CAD_NurbsSurf_Wall.i, 1)
        }
        ArraySet(CAD_NurbsSurf_Wall.ku, 0, 0)
        ArraySet(CAD_NurbsSurf_Wall.ku, 1, 0)
        ArraySet(CAD_NurbsSurf_Wall.ku, 2, 0)
        ArraySet(CAD_NurbsSurf_Wall.ku, 3, CAD_NurbsSurf_Wall.one)
        ArraySet(CAD_NurbsSurf_Wall.ku, 4, CAD_NurbsSurf_Wall.one)
        ArraySet(CAD_NurbsSurf_Wall.ku, 5, CAD_NurbsSurf_Wall.one)
        ArraySet(CAD_NurbsSurf_Wall.kv, 0, 0)
        ArraySet(CAD_NurbsSurf_Wall.kv, 1, 0)
        ArraySet(CAD_NurbsSurf_Wall.kv, 2, CAD_NurbsSurf_Wall.one)
        ArraySet(CAD_NurbsSurf_Wall.kv, 3, CAD_NurbsSurf_Wall.one)
        ArraySet(CAD_NurbsSurf_Wall.surf, 0, 2)
        ArraySet(CAD_NurbsSurf_Wall.surf, 1, 1)
        ArraySet(CAD_NurbsSurf_Wall.surf, 2, 3)
        ArraySet(CAD_NurbsSurf_Wall.surf, 3, 2)
        ArraySet(CAD_NurbsSurf_Wall.surf, 4, CAD_NurbsSurf_Wall.ctrl)
        ArraySet(CAD_NurbsSurf_Wall.surf, 5, CAD_NurbsSurf_Wall.wts)
        ArraySet(CAD_NurbsSurf_Wall.surf, 6, CAD_NurbsSurf_Wall.ku)
        ArraySet(CAD_NurbsSurf_Wall.surf, 7, CAD_NurbsSurf_Wall.kv)
        ReturnValue(0)
    }
}

// Point at (pu, pv). Does not write u0 or u1. xyz lands in x, y, z.
Function.CAD_NurbsSurf.EvalWall {
    Input: pu: Integer
    Input: pv: Integer
    Output: Integer
    Body: {
        CAD_NurbsSurf_Wall.fi = pu
        CAD_NurbsSurf_Wall.fn = pv
        ArraySet(CAD_NurbsSurf_Wall.uv, 0, CAD_NurbsSurf_Wall.fi)
        ArraySet(CAD_NurbsSurf_Wall.uv, 1, CAD_NurbsSurf_Wall.fn)
        CAD_NurbsSurf_Wall.rc = CAD_NurbsSurf.Eval(CAD_NurbsSurf_Wall.surf, CAD_NurbsSurf_Wall.uv, CAD_NurbsSurf_Wall.outp)
        IfCondition NotEqual(CAD_NurbsSurf_Wall.rc, 0) ThenBlock: {
            ReturnValue(CAD_NurbsSurf_Wall.rc)
        }
        CAD_NurbsSurf_Wall.x = ArrayGet(CAD_NurbsSurf_Wall.outp, 0)
        CAD_NurbsSurf_Wall.y = ArrayGet(CAD_NurbsSurf_Wall.outp, 1)
        CAD_NurbsSurf_Wall.z = ArrayGet(CAD_NurbsSurf_Wall.outp, 2)
        ReturnValue(0)
    }
}

// Store the last EvalWall point at pts[ix].
Function.CAD_NurbsSurf.PutPt {
    Input: ix: Integer
    Output: Integer
    Body: {
        CAD_NurbsSurf_Wall.i = ix
        CAD_NurbsSurf_Wall.s = Multiply(CAD_NurbsSurf_Wall.i, 3)
        ArraySet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s, CAD_NurbsSurf_Wall.x)
        CAD_NurbsSurf_Wall.s = Add(CAD_NurbsSurf_Wall.s, 1)
        ArraySet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s, CAD_NurbsSurf_Wall.y)
        CAD_NurbsSurf_Wall.s = Add(CAD_NurbsSurf_Wall.s, 1)
        ArraySet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s, CAD_NurbsSurf_Wall.z)
        ReturnValue(0)
    }
}

// 1 when the ray ox+t*d, t>0, hits triangle pts[i0], pts[i1], pts[i2].
// Either winding counts. An edge is inside the triangle.
Function.CAD_NurbsSurf.TriAt {
    Input: i0: Integer
    Input: i1: Integer
    Input: i2: Integer
    Output: Integer
    Body: {
        CAD_NurbsSurf_Wall.b0 = i0
        CAD_NurbsSurf_Wall.b1 = i1
        CAD_NurbsSurf_Wall.b2 = i2
        CAD_NurbsSurf_Wall.s = Multiply(CAD_NurbsSurf_Wall.b0, 3)
        CAD_NurbsSurf_Wall.ax = ArrayGet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s)
        CAD_NurbsSurf_Wall.s = Add(CAD_NurbsSurf_Wall.s, 1)
        CAD_NurbsSurf_Wall.ay = ArrayGet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s)
        CAD_NurbsSurf_Wall.s = Add(CAD_NurbsSurf_Wall.s, 1)
        CAD_NurbsSurf_Wall.az = ArrayGet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s)
        CAD_NurbsSurf_Wall.s = Multiply(CAD_NurbsSurf_Wall.b1, 3)
        CAD_NurbsSurf_Wall.bx = ArrayGet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s)
        CAD_NurbsSurf_Wall.s = Add(CAD_NurbsSurf_Wall.s, 1)
        CAD_NurbsSurf_Wall.by = ArrayGet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s)
        CAD_NurbsSurf_Wall.s = Add(CAD_NurbsSurf_Wall.s, 1)
        CAD_NurbsSurf_Wall.bz = ArrayGet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s)
        CAD_NurbsSurf_Wall.s = Multiply(CAD_NurbsSurf_Wall.b2, 3)
        CAD_NurbsSurf_Wall.cx = ArrayGet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s)
        CAD_NurbsSurf_Wall.s = Add(CAD_NurbsSurf_Wall.s, 1)
        CAD_NurbsSurf_Wall.cy = ArrayGet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s)
        CAD_NurbsSurf_Wall.s = Add(CAD_NurbsSurf_Wall.s, 1)
        CAD_NurbsSurf_Wall.cz = ArrayGet(CAD_NurbsSurf_Wall.pts, CAD_NurbsSurf_Wall.s)
        CAD_NurbsSurf_Wall.e1x = Float_Sub(CAD_NurbsSurf_Wall.bx, CAD_NurbsSurf_Wall.ax)
        CAD_NurbsSurf_Wall.e1y = Float_Sub(CAD_NurbsSurf_Wall.by, CAD_NurbsSurf_Wall.ay)
        CAD_NurbsSurf_Wall.e1z = Float_Sub(CAD_NurbsSurf_Wall.bz, CAD_NurbsSurf_Wall.az)
        CAD_NurbsSurf_Wall.e2x = Float_Sub(CAD_NurbsSurf_Wall.cx, CAD_NurbsSurf_Wall.ax)
        CAD_NurbsSurf_Wall.e2y = Float_Sub(CAD_NurbsSurf_Wall.cy, CAD_NurbsSurf_Wall.ay)
        CAD_NurbsSurf_Wall.e2z = Float_Sub(CAD_NurbsSurf_Wall.cz, CAD_NurbsSurf_Wall.az)
        CAD_NurbsSurf_Wall.px = Float_Mul(CAD_NurbsSurf_Wall.dy, CAD_NurbsSurf_Wall.e2z)
        CAD_NurbsSurf_Wall.u = Float_Mul(CAD_NurbsSurf_Wall.dz, CAD_NurbsSurf_Wall.e2y)
        CAD_NurbsSurf_Wall.px = Float_Sub(CAD_NurbsSurf_Wall.px, CAD_NurbsSurf_Wall.u)
        CAD_NurbsSurf_Wall.py = Float_Mul(CAD_NurbsSurf_Wall.dz, CAD_NurbsSurf_Wall.e2x)
        CAD_NurbsSurf_Wall.u = Float_Mul(CAD_NurbsSurf_Wall.dx, CAD_NurbsSurf_Wall.e2z)
        CAD_NurbsSurf_Wall.py = Float_Sub(CAD_NurbsSurf_Wall.py, CAD_NurbsSurf_Wall.u)
        CAD_NurbsSurf_Wall.pz = Float_Mul(CAD_NurbsSurf_Wall.dx, CAD_NurbsSurf_Wall.e2y)
        CAD_NurbsSurf_Wall.u = Float_Mul(CAD_NurbsSurf_Wall.dy, CAD_NurbsSurf_Wall.e2x)
        CAD_NurbsSurf_Wall.pz = Float_Sub(CAD_NurbsSurf_Wall.pz, CAD_NurbsSurf_Wall.u)
        CAD_NurbsSurf_Wall.det = Float_Mul(CAD_NurbsSurf_Wall.e1x, CAD_NurbsSurf_Wall.px)
        CAD_NurbsSurf_Wall.u = Float_Mul(CAD_NurbsSurf_Wall.e1y, CAD_NurbsSurf_Wall.py)
        CAD_NurbsSurf_Wall.det = Float_Add(CAD_NurbsSurf_Wall.det, CAD_NurbsSurf_Wall.u)
        CAD_NurbsSurf_Wall.u = Float_Mul(CAD_NurbsSurf_Wall.e1z, CAD_NurbsSurf_Wall.pz)
        CAD_NurbsSurf_Wall.det = Float_Add(CAD_NurbsSurf_Wall.det, CAD_NurbsSurf_Wall.u)
        CAD_NurbsSurf_Wall.rc = CAD_Num.IsZero(CAD_NurbsSurf_Wall.det, 0)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.rc, 1) ThenBlock: { ReturnValue(0) }
        CAD_NurbsSurf_Wall.inv = Float_Div(CAD_NurbsSurf_Wall.one, CAD_NurbsSurf_Wall.det)
        CAD_NurbsSurf_Wall.qx = Float_Sub(CAD_NurbsSurf_Wall.ox, CAD_NurbsSurf_Wall.ax)
        CAD_NurbsSurf_Wall.qy = Float_Sub(CAD_NurbsSurf_Wall.oy, CAD_NurbsSurf_Wall.ay)
        CAD_NurbsSurf_Wall.qz = Float_Sub(CAD_NurbsSurf_Wall.oz, CAD_NurbsSurf_Wall.az)
        CAD_NurbsSurf_Wall.u = Float_Mul(CAD_NurbsSurf_Wall.qx, CAD_NurbsSurf_Wall.px)
        CAD_NurbsSurf_Wall.vv = Float_Mul(CAD_NurbsSurf_Wall.qy, CAD_NurbsSurf_Wall.py)
        CAD_NurbsSurf_Wall.u = Float_Add(CAD_NurbsSurf_Wall.u, CAD_NurbsSurf_Wall.vv)
        CAD_NurbsSurf_Wall.vv = Float_Mul(CAD_NurbsSurf_Wall.qz, CAD_NurbsSurf_Wall.pz)
        CAD_NurbsSurf_Wall.u = Float_Add(CAD_NurbsSurf_Wall.u, CAD_NurbsSurf_Wall.vv)
        CAD_NurbsSurf_Wall.u = Float_Mul(CAD_NurbsSurf_Wall.u, CAD_NurbsSurf_Wall.inv)
        CAD_NurbsSurf_Wall.rc = CAD_Num.IsNeg(CAD_NurbsSurf_Wall.u)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.rc, 1) ThenBlock: { ReturnValue(0) }
        CAD_NurbsSurf_Wall.vv = Float_Sub(CAD_NurbsSurf_Wall.one, CAD_NurbsSurf_Wall.u)
        CAD_NurbsSurf_Wall.rc = CAD_Num.IsNeg(CAD_NurbsSurf_Wall.vv)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.rc, 1) ThenBlock: { ReturnValue(0) }
        CAD_NurbsSurf_Wall.px = Float_Mul(CAD_NurbsSurf_Wall.qy, CAD_NurbsSurf_Wall.e1z)
        CAD_NurbsSurf_Wall.vv = Float_Mul(CAD_NurbsSurf_Wall.qz, CAD_NurbsSurf_Wall.e1y)
        CAD_NurbsSurf_Wall.px = Float_Sub(CAD_NurbsSurf_Wall.px, CAD_NurbsSurf_Wall.vv)
        CAD_NurbsSurf_Wall.py = Float_Mul(CAD_NurbsSurf_Wall.qz, CAD_NurbsSurf_Wall.e1x)
        CAD_NurbsSurf_Wall.vv = Float_Mul(CAD_NurbsSurf_Wall.qx, CAD_NurbsSurf_Wall.e1z)
        CAD_NurbsSurf_Wall.py = Float_Sub(CAD_NurbsSurf_Wall.py, CAD_NurbsSurf_Wall.vv)
        CAD_NurbsSurf_Wall.pz = Float_Mul(CAD_NurbsSurf_Wall.qx, CAD_NurbsSurf_Wall.e1y)
        CAD_NurbsSurf_Wall.vv = Float_Mul(CAD_NurbsSurf_Wall.qy, CAD_NurbsSurf_Wall.e1x)
        CAD_NurbsSurf_Wall.pz = Float_Sub(CAD_NurbsSurf_Wall.pz, CAD_NurbsSurf_Wall.vv)
        CAD_NurbsSurf_Wall.vv = Float_Mul(CAD_NurbsSurf_Wall.dx, CAD_NurbsSurf_Wall.px)
        CAD_NurbsSurf_Wall.t = Float_Mul(CAD_NurbsSurf_Wall.dy, CAD_NurbsSurf_Wall.py)
        CAD_NurbsSurf_Wall.vv = Float_Add(CAD_NurbsSurf_Wall.vv, CAD_NurbsSurf_Wall.t)
        CAD_NurbsSurf_Wall.t = Float_Mul(CAD_NurbsSurf_Wall.dz, CAD_NurbsSurf_Wall.pz)
        CAD_NurbsSurf_Wall.vv = Float_Add(CAD_NurbsSurf_Wall.vv, CAD_NurbsSurf_Wall.t)
        CAD_NurbsSurf_Wall.vv = Float_Mul(CAD_NurbsSurf_Wall.vv, CAD_NurbsSurf_Wall.inv)
        CAD_NurbsSurf_Wall.rc = CAD_Num.IsNeg(CAD_NurbsSurf_Wall.vv)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.rc, 1) ThenBlock: { ReturnValue(0) }
        CAD_NurbsSurf_Wall.t = Float_Add(CAD_NurbsSurf_Wall.u, CAD_NurbsSurf_Wall.vv)
        CAD_NurbsSurf_Wall.t = Float_Sub(CAD_NurbsSurf_Wall.one, CAD_NurbsSurf_Wall.t)
        CAD_NurbsSurf_Wall.rc = CAD_Num.IsNeg(CAD_NurbsSurf_Wall.t)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.rc, 1) ThenBlock: { ReturnValue(0) }
        CAD_NurbsSurf_Wall.t = Float_Mul(CAD_NurbsSurf_Wall.e2x, CAD_NurbsSurf_Wall.px)
        CAD_NurbsSurf_Wall.rc = 0
        CAD_NurbsSurf_Wall.b0 = Float_Mul(CAD_NurbsSurf_Wall.e2y, CAD_NurbsSurf_Wall.py)
        CAD_NurbsSurf_Wall.t = Float_Add(CAD_NurbsSurf_Wall.t, CAD_NurbsSurf_Wall.b0)
        CAD_NurbsSurf_Wall.b0 = Float_Mul(CAD_NurbsSurf_Wall.e2z, CAD_NurbsSurf_Wall.pz)
        CAD_NurbsSurf_Wall.t = Float_Add(CAD_NurbsSurf_Wall.t, CAD_NurbsSurf_Wall.b0)
        CAD_NurbsSurf_Wall.t = Float_Mul(CAD_NurbsSurf_Wall.t, CAD_NurbsSurf_Wall.inv)
        CAD_NurbsSurf_Wall.rc = CAD_Num.IsNeg(CAD_NurbsSurf_Wall.t)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.rc, 1) ThenBlock: { ReturnValue(0) }
        CAD_NurbsSurf_Wall.rc = CAD_Num.IsZero(CAD_NurbsSurf_Wall.t, 0)
        IfCondition EqualTo(CAD_NurbsSurf_Wall.rc, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// 1 when the ray hits this kind-6 wall. One hit per face, so a shared
// triangle edge counts once. Eight steps across the quarter.
Function.CAD_NurbsSurf.RayHit {
    Input: surf_h: Integer
    Input: ray_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(surf_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ray_addr, 0) ThenBlock: { ReturnValue(0) }
        CAD_NurbsSurf_Wall.h = surf_h
        CAD_NurbsSurf_Wall.ray = ray_addr
        CAD_NurbsSurf_Wall.ox = ArrayGet(CAD_NurbsSurf_Wall.ray, 0)
        CAD_NurbsSurf_Wall.oy = ArrayGet(CAD_NurbsSurf_Wall.ray, 1)
        CAD_NurbsSurf_Wall.oz = ArrayGet(CAD_NurbsSurf_Wall.ray, 2)
        CAD_NurbsSurf_Wall.dx = ArrayGet(CAD_NurbsSurf_Wall.ray, 3)
        CAD_NurbsSurf_Wall.dy = ArrayGet(CAD_NurbsSurf_Wall.ray, 4)
        CAD_NurbsSurf_Wall.dz = ArrayGet(CAD_NurbsSurf_Wall.ray, 5)
        CAD_NurbsSurf_Wall.rc = CAD_NurbsSurf.BindWall()
        IfCondition NotEqual(CAD_NurbsSurf_Wall.rc, 0) ThenBlock: { ReturnValue(0) }
        CAD_NurbsSurf_Wall.one = 0x3FF0000000000000
        CAD_NurbsSurf_Wall.v = Float_FromInt(8)
        CAD_NurbsSurf_Wall.iu = 0
        WhileLoop LessThan(CAD_NurbsSurf_Wall.iu, 8) {
            CAD_NurbsSurf_Wall.i = CAD_NurbsSurf_Wall.iu
            CAD_NurbsSurf_Wall.u0 = Float_FromInt(CAD_NurbsSurf_Wall.i)
            CAD_NurbsSurf_Wall.u0 = Float_Div(CAD_NurbsSurf_Wall.u0, CAD_NurbsSurf_Wall.v)
            CAD_NurbsSurf_Wall.i = Add(CAD_NurbsSurf_Wall.iu, 1)
            CAD_NurbsSurf_Wall.u1 = Float_FromInt(CAD_NurbsSurf_Wall.i)
            CAD_NurbsSurf_Wall.u1 = Float_Div(CAD_NurbsSurf_Wall.u1, CAD_NurbsSurf_Wall.v)
            CAD_NurbsSurf_Wall.rc = CAD_NurbsSurf.EvalWall(CAD_NurbsSurf_Wall.u0, 0)
            IfCondition NotEqual(CAD_NurbsSurf_Wall.rc, 0) ThenBlock: {
                CAD_NurbsSurf.ReleaseWall()
                ReturnValue(0)
            }
            CAD_NurbsSurf.PutPt(0)
            CAD_NurbsSurf_Wall.rc = CAD_NurbsSurf.EvalWall(CAD_NurbsSurf_Wall.u1, 0)
            IfCondition NotEqual(CAD_NurbsSurf_Wall.rc, 0) ThenBlock: {
                CAD_NurbsSurf.ReleaseWall()
                ReturnValue(0)
            }
            CAD_NurbsSurf.PutPt(1)
            CAD_NurbsSurf_Wall.rc = CAD_NurbsSurf.EvalWall(CAD_NurbsSurf_Wall.u0, CAD_NurbsSurf_Wall.one)
            IfCondition NotEqual(CAD_NurbsSurf_Wall.rc, 0) ThenBlock: {
                CAD_NurbsSurf.ReleaseWall()
                ReturnValue(0)
            }
            CAD_NurbsSurf.PutPt(2)
            CAD_NurbsSurf_Wall.rc = CAD_NurbsSurf.EvalWall(CAD_NurbsSurf_Wall.u1, CAD_NurbsSurf_Wall.one)
            IfCondition NotEqual(CAD_NurbsSurf_Wall.rc, 0) ThenBlock: {
                CAD_NurbsSurf.ReleaseWall()
                ReturnValue(0)
            }
            CAD_NurbsSurf.PutPt(3)
            CAD_NurbsSurf_Wall.hit = CAD_NurbsSurf.TriAt(0, 1, 3)
            IfCondition EqualTo(CAD_NurbsSurf_Wall.hit, 1) ThenBlock: {
                CAD_NurbsSurf.ReleaseWall()
                ReturnValue(1)
            }
            CAD_NurbsSurf_Wall.hit = CAD_NurbsSurf.TriAt(0, 3, 2)
            IfCondition EqualTo(CAD_NurbsSurf_Wall.hit, 1) ThenBlock: {
                CAD_NurbsSurf.ReleaseWall()
                ReturnValue(1)
            }
            CAD_NurbsSurf_Wall.iu = Add(CAD_NurbsSurf_Wall.iu, 1)
        }
        CAD_NurbsSurf.ReleaseWall()
        ReturnValue(0)
    }
}
