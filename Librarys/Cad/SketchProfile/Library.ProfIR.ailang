// CAD.SketchProfile.ProfIR — profile compiler PARSE/ANALYZE/CHAIN/SOLVE/EMIT.
// Vertex identity is an intersection, not Cos(a) vs a stored line tip.
// API Function.CAD_Sketch.*  (facade: LibraryImport.Cad.CAD_SketchProfile)
//
// Entity stride 12, cap 64:
//  0 kind(0 LINE/1 CIRCLE/2 ARC)  1 live_i
//  2-3 LINE p0 / CIRCLE,ARC center
//  4-5 LINE p1 / r, unused
//  6-7 ARC a0,a1 (span only)
//  8 nhits  9 reserved
// HE: twins. k=0 line k=2 arc. he_sp = signed arc span (0 on lines).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

FixedPool.CAD_Prof {
    "sk": Initialize=0, CanChange=True
    "nent": Initialize=0, CanChange=True
    "nv": Initialize=0, CanChange=True
    "nhit": Initialize=0, CanChange=True
    "nhe": Initialize=0, CanChange=True
    "npath": Initialize=0, CanChange=True
    "nprof": Initialize=0, CanChange=True
    "slab": Initialize=0, CanChange=True
    "vx": Initialize=0, CanChange=True
    "vy": Initialize=0, CanChange=True
    "hit_e": Initialize=0, CanChange=True
    "hit_t": Initialize=0, CanChange=True
    "hit_v": Initialize=0, CanChange=True
    "he_a": Initialize=0, CanChange=True
    "he_b": Initialize=0, CanChange=True
    "he_k": Initialize=0, CanChange=True
    "he_e": Initialize=0, CanChange=True
    "he_r": Initialize=0, CanChange=True
    "he_ang": Initialize=0, CanChange=True
    "he_twin": Initialize=0, CanChange=True
    "he_used": Initialize=0, CanChange=True
    "he_sp": Initialize=0, CanChange=True
    "path_s": Initialize=0, CanChange=True
    "work_t": Initialize=0, CanChange=True
    "work_v": Initialize=0, CanChange=True
    "samp": Initialize=0, CanChange=True
    "i": Initialize=0, CanChange=True
    "j": Initialize=0, CanChange=True
    "k": Initialize=0, CanChange=True
    "e": Initialize=0, CanChange=True
    "a": Initialize=0, CanChange=True
    "b": Initialize=0, CanChange=True
    "t": Initialize=0, CanChange=True
    "u": Initialize=0, CanChange=True
    "x": Initialize=0, CanChange=True
    "y": Initialize=0, CanChange=True
    "x0": Initialize=0, CanChange=True
    "y0": Initialize=0, CanChange=True
    "x1": Initialize=0, CanChange=True
    "y1": Initialize=0, CanChange=True
    "cx": Initialize=0, CanChange=True
    "cy": Initialize=0, CanChange=True
    "r": Initialize=0, CanChange=True
    "a0": Initialize=0, CanChange=True
    "a1": Initialize=0, CanChange=True
    "span": Initialize=0, CanChange=True
    "ang": Initialize=0, CanChange=True
    "px": Initialize=0, CanChange=True
    "py": Initialize=0, CanChange=True
    "dx": Initialize=0, CanChange=True
    "dy": Initialize=0, CanChange=True
    "aa": Initialize=0, CanChange=True
    "bb": Initialize=0, CanChange=True
    "cc": Initialize=0, CanChange=True
    "disc": Initialize=0, CanChange=True
    "s": Initialize=0, CanChange=True
    "ok": Initialize=0, CanChange=True
    "vi": Initialize=0, CanChange=True
    "v0": Initialize=0, CanChange=True
    "v1": Initialize=0, CanChange=True
    "cur": Initialize=0, CanChange=True
    "nxt": Initialize=0, CanChange=True
    "best": Initialize=0, CanChange=True
    "dang": Initialize=0, CanChange=True
    "rev": Initialize=0, CanChange=True
    "area": Initialize=0, CanChange=True
    "nn": Initialize=0, CanChange=True
    "kind": Initialize=0, CanChange=True
    "hi": Initialize=0, CanChange=True
    "nw": Initialize=0, CanChange=True
    "cs": Initialize=0, CanChange=True
    "sn": Initialize=0, CanChange=True
    "off": Initialize=0, CanChange=True
}

Function.CAD_Sketch.ProfIREnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Prof.slab, 0) ThenBlock: { CAD_Prof.slab = Allocate(3072) }
        IfCondition EqualTo(CAD_Prof.vx, 0) ThenBlock: { CAD_Prof.vx = Allocate(2048) }
        IfCondition EqualTo(CAD_Prof.vy, 0) ThenBlock: { CAD_Prof.vy = Allocate(2048) }
        IfCondition EqualTo(CAD_Prof.hit_e, 0) ThenBlock: { CAD_Prof.hit_e = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.hit_t, 0) ThenBlock: { CAD_Prof.hit_t = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.hit_v, 0) ThenBlock: { CAD_Prof.hit_v = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.he_a, 0) ThenBlock: { CAD_Prof.he_a = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.he_b, 0) ThenBlock: { CAD_Prof.he_b = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.he_k, 0) ThenBlock: { CAD_Prof.he_k = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.he_e, 0) ThenBlock: { CAD_Prof.he_e = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.he_r, 0) ThenBlock: { CAD_Prof.he_r = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.he_ang, 0) ThenBlock: { CAD_Prof.he_ang = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.he_twin, 0) ThenBlock: { CAD_Prof.he_twin = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.he_used, 0) ThenBlock: { CAD_Prof.he_used = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.he_sp, 0) ThenBlock: { CAD_Prof.he_sp = Allocate(4096) }
        IfCondition EqualTo(CAD_Prof.path_s, 0) ThenBlock: { CAD_Prof.path_s = Allocate(512) }
        IfCondition EqualTo(CAD_Prof.work_t, 0) ThenBlock: { CAD_Prof.work_t = Allocate(256) }
        IfCondition EqualTo(CAD_Prof.work_v, 0) ThenBlock: { CAD_Prof.work_v = Allocate(256) }
        IfCondition EqualTo(CAD_Prof.samp, 0) ThenBlock: { CAD_Prof.samp = Allocate(8192) }
        IfCondition EqualTo(CAD_Prof.slab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Prof.he_a, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Sketch.ProfIRPut {
    Input: idx: Integer
    Input: slot: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        ArraySet(CAD_Prof.slab, Add(Multiply(idx, 12), slot), val)
        ReturnValue(val)
    }
}

Function.CAD_Sketch.ProfIRGet {
    Input: idx: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        ReturnValue(ArrayGet(CAD_Prof.slab, Add(Multiply(idx, 12), slot)))
    }
}

// Merge if already within (0.001 mm)^2. Intersections share a vertex; Cos≠hit does not.
Function.CAD_Sketch.ProfIRAddVert {
    Output: Integer
    Body: {
        CAD_Prof.k = 0
        WhileLoop LessThan(CAD_Prof.k, CAD_Prof.nv) {
            CAD_Prof.dx = Float_Sub(ArrayGet(CAD_Prof.vx, CAD_Prof.k), CAD_Prof.px)
            CAD_Prof.dy = Float_Sub(ArrayGet(CAD_Prof.vy, CAD_Prof.k), CAD_Prof.py)
            CAD_Prof.aa = Float_Add(CAD_Num.Sq(CAD_Prof.dx), CAD_Num.Sq(CAD_Prof.dy))
            IfCondition EqualTo(Float_Le(CAD_Prof.aa, 0x3EB0C6F7A0B5ED8D), 1) ThenBlock: {
                ReturnValue(CAD_Prof.k)
            }
            CAD_Prof.k = Add(CAD_Prof.k, 1)
        }
        IfCondition GreaterEqual(CAD_Prof.nv, 256) ThenBlock: { ReturnValue(Subtract(CAD_Prof.nv, 1)) }
        ArraySet(CAD_Prof.vx, CAD_Prof.nv, CAD_Prof.px)
        ArraySet(CAD_Prof.vy, CAD_Prof.nv, CAD_Prof.py)
        CAD_Prof.ok = CAD_Prof.nv
        CAD_Prof.nv = Add(CAD_Prof.nv, 1)
        ReturnValue(CAD_Prof.ok)
    }
}

Function.CAD_Sketch.ProfIRAddHit {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(CAD_Prof.nhit, 512) ThenBlock: { ReturnValue(-1) }
        ArraySet(CAD_Prof.hit_e, CAD_Prof.nhit, CAD_Prof.e)
        ArraySet(CAD_Prof.hit_t, CAD_Prof.nhit, CAD_Prof.t)
        ArraySet(CAD_Prof.hit_v, CAD_Prof.nhit, CAD_Prof.vi)
        CAD_Prof.nhit = Add(CAD_Prof.nhit, 1)
        CAD_Prof.k = CAD_Sketch.ProfIRGet(CAD_Prof.e, 8)
        CAD_Sketch.ProfIRPut(CAD_Prof.e, 8, Add(CAD_Prof.k, 1))
        ReturnValue(0)
    }
}

Function.CAD_Sketch.ProfParse {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Sketch.ProfIREnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Prof.sk = sketch_handle
        CAD_Prof.nent = 0
        CAD_Prof.nv = 0
        CAD_Prof.nhit = 0
        CAD_Prof.nhe = 0
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Prof.a = CAD_Store.Read(sketch_handle, 0)
        CAD_Prof.b = CAD_Store.Read(sketch_handle, 1)
        CAD_Prof.i = 0
        WhileLoop LessThan(CAD_Prof.i, CAD_Prof.a) {
            IfCondition LessThan(CAD_Prof.nent, 64) ThenBlock: {
                CAD_Prof.k = Multiply(CAD_Prof.i, 4)
                CAD_Prof.off = Multiply(CAD_Prof.nent, 12)
                ArraySet(CAD_Prof.slab, CAD_Prof.off, 0)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 1), CAD_Prof.i)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 2), ArrayGet(CAD_Prof.b, CAD_Prof.k))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 3), ArrayGet(CAD_Prof.b, Add(CAD_Prof.k, 1)))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 4), ArrayGet(CAD_Prof.b, Add(CAD_Prof.k, 2)))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 5), ArrayGet(CAD_Prof.b, Add(CAD_Prof.k, 3)))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 6), 0)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 7), 0)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 8), 0)
                CAD_Prof.nent = Add(CAD_Prof.nent, 1)
            }
            CAD_Prof.i = Add(CAD_Prof.i, 1)
        }
        CAD_Prof.a = CAD_Store.Read(sketch_handle, 7)
        CAD_Prof.b = CAD_Store.Read(sketch_handle, 8)
        CAD_Prof.i = 0
        WhileLoop LessThan(CAD_Prof.i, CAD_Prof.a) {
            IfCondition LessThan(CAD_Prof.nent, 64) ThenBlock: {
                CAD_Prof.k = Multiply(CAD_Prof.i, 3)
                CAD_Prof.off = Multiply(CAD_Prof.nent, 12)
                ArraySet(CAD_Prof.slab, CAD_Prof.off, 1)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 1), CAD_Prof.i)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 2), ArrayGet(CAD_Prof.b, CAD_Prof.k))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 3), ArrayGet(CAD_Prof.b, Add(CAD_Prof.k, 1)))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 4), ArrayGet(CAD_Prof.b, Add(CAD_Prof.k, 2)))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 5), 0)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 6), 0)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 7), 0x401921FB54442D18)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 8), 0)
                CAD_Prof.nent = Add(CAD_Prof.nent, 1)
            }
            CAD_Prof.i = Add(CAD_Prof.i, 1)
        }
        CAD_Prof.a = CAD_Store.Read(sketch_handle, 10)
        CAD_Prof.b = CAD_Store.Read(sketch_handle, 11)
        CAD_Prof.i = 0
        WhileLoop LessThan(CAD_Prof.i, CAD_Prof.a) {
            IfCondition LessThan(CAD_Prof.nent, 64) ThenBlock: {
                CAD_Prof.k = Multiply(CAD_Prof.i, 5)
                CAD_Prof.off = Multiply(CAD_Prof.nent, 12)
                ArraySet(CAD_Prof.slab, CAD_Prof.off, 2)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 1), CAD_Prof.i)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 2), ArrayGet(CAD_Prof.b, CAD_Prof.k))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 3), ArrayGet(CAD_Prof.b, Add(CAD_Prof.k, 1)))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 4), ArrayGet(CAD_Prof.b, Add(CAD_Prof.k, 2)))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 5), 0)
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 6), ArrayGet(CAD_Prof.b, Add(CAD_Prof.k, 3)))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 7), ArrayGet(CAD_Prof.b, Add(CAD_Prof.k, 4)))
                ArraySet(CAD_Prof.slab, Add(CAD_Prof.off, 8), 0)
                CAD_Prof.nent = Add(CAD_Prof.nent, 1)
            }
            CAD_Prof.i = Add(CAD_Prof.i, 1)
        }
        ReturnValue(CAD_Prof.nent)
    }
}

// 1 if angle is on CCW span [a0, a1] (or full circle).
Function.CAD_Sketch.ProfIROnSpan {
    Output: Integer
    Body: {
        CAD_Prof.kind = ArrayGet(CAD_Prof.slab, Multiply(CAD_Prof.j, 12))
        IfCondition EqualTo(CAD_Prof.kind, 1) ThenBlock: { ReturnValue(1) }
        CAD_Prof.a0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.j, 12), 6))
        CAD_Prof.a1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.j, 12), 7))
        CAD_Prof.span = CAD_Num.PosMod2Pi(Float_Sub(CAD_Prof.a1, CAD_Prof.a0))
        CAD_Prof.dang = CAD_Num.PosMod2Pi(Float_Sub(CAD_Prof.ang, CAD_Prof.a0))
        IfCondition EqualTo(Float_Le(CAD_Prof.dang, Float_Add(CAD_Prof.span, 0x3FA999999999999A)), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Float_Le(Float_Sub(0x401921FB54442D18, CAD_Prof.dang), 0x3FA999999999999A), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Pair i,j both LINE. t,u in [-0.25, 1.25]. xy from line i.
Function.CAD_Sketch.ProfIRHitLineLine {
    Output: Integer
    Body: {
        CAD_Prof.x0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 2))
        CAD_Prof.y0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 3))
        CAD_Prof.x1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 4))
        CAD_Prof.y1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 5))
        CAD_Prof.dx = Float_Sub(CAD_Prof.x1, CAD_Prof.x0)
        CAD_Prof.dy = Float_Sub(CAD_Prof.y1, CAD_Prof.y0)
        CAD_Prof.px = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.j, 12), 2))
        CAD_Prof.py = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.j, 12), 3))
        CAD_Prof.x = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.j, 12), 4))
        CAD_Prof.y = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.j, 12), 5))
        CAD_Prof.aa = Float_Sub(CAD_Prof.x, CAD_Prof.px)
        CAD_Prof.bb = Float_Sub(CAD_Prof.y, CAD_Prof.py)
        CAD_Prof.disc = Float_Sub(CAD_Num.Mul(CAD_Prof.dx, CAD_Prof.bb), CAD_Num.Mul(CAD_Prof.dy, CAD_Prof.aa))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Prof.disc, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Prof.t = Float_Div(Float_Sub(CAD_Num.Mul(Float_Sub(CAD_Prof.px, CAD_Prof.x0), CAD_Prof.bb), CAD_Num.Mul(Float_Sub(CAD_Prof.py, CAD_Prof.y0), CAD_Prof.aa)), CAD_Prof.disc)
        CAD_Prof.u = Float_Div(Float_Sub(CAD_Num.Mul(Float_Sub(CAD_Prof.px, CAD_Prof.x0), CAD_Prof.dy), CAD_Num.Mul(Float_Sub(CAD_Prof.py, CAD_Prof.y0), CAD_Prof.dx)), CAD_Prof.disc)
        CAD_Prof.ok = 1
        // line×line: on-segment including ends. ±0.25 was 25 mm past a 100 mm edge.
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(CAD_Prof.t, 0x3F50624DD2F1A9FC)), 1) ThenBlock: { CAD_Prof.ok = 0 }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0x3FF004189374BC6A, CAD_Prof.t)), 1) ThenBlock: { CAD_Prof.ok = 0 }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(CAD_Prof.u, 0x3F50624DD2F1A9FC)), 1) ThenBlock: { CAD_Prof.ok = 0 }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0x3FF004189374BC6A, CAD_Prof.u)), 1) ThenBlock: { CAD_Prof.ok = 0 }
        IfCondition EqualTo(CAD_Prof.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Prof.px = Float_Add(CAD_Prof.x0, CAD_Num.Mul(CAD_Prof.t, CAD_Prof.dx))
        CAD_Prof.py = Float_Add(CAD_Prof.y0, CAD_Num.Mul(CAD_Prof.t, CAD_Prof.dy))
        CAD_Prof.vi = CAD_Sketch.ProfIRAddVert()
        CAD_Prof.e = CAD_Prof.i
        CAD_Sketch.ProfIRAddHit()
        CAD_Prof.e = CAD_Prof.j
        CAD_Prof.t = CAD_Prof.u
        CAD_Sketch.ProfIRAddHit()
        ReturnValue(1)
    }
}

// Line i vs CIRCLE/ARC j. Quadratic. Accept t in [-0.25, 1.25]. xy is the hit (on the circle).
Function.CAD_Sketch.ProfIRHitLineCirc {
    Output: Integer
    Body: {
        CAD_Prof.x0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 2))
        CAD_Prof.y0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 3))
        CAD_Prof.x1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 4))
        CAD_Prof.y1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 5))
        CAD_Prof.dx = Float_Sub(CAD_Prof.x1, CAD_Prof.x0)
        CAD_Prof.dy = Float_Sub(CAD_Prof.y1, CAD_Prof.y0)
        CAD_Prof.aa = Float_Add(CAD_Num.Sq(CAD_Prof.dx), CAD_Num.Sq(CAD_Prof.dy))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Prof.aa, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Prof.cx = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.j, 12), 2))
        CAD_Prof.cy = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.j, 12), 3))
        CAD_Prof.r = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.j, 12), 4))
        CAD_Prof.x = Float_Sub(CAD_Prof.x0, CAD_Prof.cx)
        CAD_Prof.y = Float_Sub(CAD_Prof.y0, CAD_Prof.cy)
        CAD_Prof.bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(CAD_Prof.x, CAD_Prof.y, CAD_Prof.dx, CAD_Prof.dy))
        CAD_Prof.cc = Float_Sub(Float_Add(CAD_Num.Sq(CAD_Prof.x), CAD_Num.Sq(CAD_Prof.y)), CAD_Num.Sq(CAD_Prof.r))
        CAD_Prof.disc = Float_Sub(CAD_Num.Sq(CAD_Prof.bb), CAD_Num.Mul(CAD_Num.Mul(0x4010000000000000, CAD_Prof.aa), CAD_Prof.cc))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Prof.disc), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(CAD_Num.Abs(CAD_Prof.disc), CAD_Num.Mul(CAD_Prof.aa, 0x3F50624DD2F1A9FC)), 1) ThenBlock: {
                CAD_Prof.disc = 0
            }
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Prof.disc), 1) ThenBlock: { ReturnValue(0) }
        CAD_Prof.s = CAD_Num.Sqrt(CAD_Prof.disc)
        CAD_Prof.hi = 0
        WhileLoop LessThan(CAD_Prof.hi, 2) {
            CAD_Prof.t = Float_Div(Float_Sub(Float_Sub(0, CAD_Prof.bb), CAD_Prof.s), CAD_Num.Mul(0x4000000000000000, CAD_Prof.aa))
            IfCondition EqualTo(CAD_Prof.hi, 1) ThenBlock: {
                CAD_Prof.t = Float_Div(Float_Add(Float_Sub(0, CAD_Prof.bb), CAD_Prof.s), CAD_Num.Mul(0x4000000000000000, CAD_Prof.aa))
            }
            CAD_Prof.ok = 1
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(CAD_Prof.t, 0x3FD0000000000000)), 1) ThenBlock: { CAD_Prof.ok = 0 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0x3FF4000000000000, CAD_Prof.t)), 1) ThenBlock: { CAD_Prof.ok = 0 }
            IfCondition EqualTo(CAD_Prof.ok, 1) ThenBlock: {
                CAD_Prof.px = Float_Add(CAD_Prof.x0, CAD_Num.Mul(CAD_Prof.t, CAD_Prof.dx))
                CAD_Prof.py = Float_Add(CAD_Prof.y0, CAD_Num.Mul(CAD_Prof.t, CAD_Prof.dy))
                CAD_Prof.ang = CAD_Geom.Atan2(Float_Sub(CAD_Prof.py, CAD_Prof.cy), Float_Sub(CAD_Prof.px, CAD_Prof.cx))
                IfCondition EqualTo(CAD_Sketch.ProfIROnSpan(), 1) ThenBlock: {
                    CAD_Prof.vi = CAD_Sketch.ProfIRAddVert()
                    CAD_Prof.e = CAD_Prof.i
                    CAD_Sketch.ProfIRAddHit()
                    CAD_Prof.e = CAD_Prof.j
                    CAD_Prof.t = CAD_Prof.ang
                    CAD_Sketch.ProfIRAddHit()
                }
            }
            CAD_Prof.hi = Add(CAD_Prof.hi, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Sketch.ProfAnalyze {
    Output: Integer
    Body: {
        CAD_Prof.i = 0
        WhileLoop LessThan(CAD_Prof.i, CAD_Prof.nent) {
            CAD_Prof.j = Add(CAD_Prof.i, 1)
            WhileLoop LessThan(CAD_Prof.j, CAD_Prof.nent) {
                CAD_Prof.a = CAD_Sketch.ProfIRGet(CAD_Prof.i, 0)
                CAD_Prof.b = CAD_Sketch.ProfIRGet(CAD_Prof.j, 0)
                IfCondition EqualTo(CAD_Prof.a, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Prof.b, 0) ThenBlock: {
                        CAD_Sketch.ProfIRHitLineLine()
                    }
                    IfCondition NotEqual(CAD_Prof.b, 0) ThenBlock: {
                        CAD_Sketch.ProfIRHitLineCirc()
                    }
                }
                IfCondition NotEqual(CAD_Prof.a, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Prof.b, 0) ThenBlock: {
                        CAD_Prof.k = CAD_Prof.i
                        CAD_Prof.i = CAD_Prof.j
                        CAD_Prof.j = CAD_Prof.k
                        CAD_Sketch.ProfIRHitLineCirc()
                        CAD_Prof.j = CAD_Prof.i
                        CAD_Prof.i = CAD_Prof.k
                    }
                }
                CAD_Prof.j = Add(CAD_Prof.j, 1)
            }
            CAD_Prof.i = Add(CAD_Prof.i, 1)
        }
        CAD_Sketch.ProfIRSeedEnds()
        ReturnValue(CAD_Prof.nv)
    }
}

// LINE ends that are not already an intersection on that line (t near 0 or 1).
// ARC/CIRCLE Cos ends are NOT vertices — that was the Pac-Man gap.
Function.CAD_Sketch.ProfIRSeedEnds {
    Output: Integer
    Body: {
        CAD_Prof.i = 0
        WhileLoop LessThan(CAD_Prof.i, CAD_Prof.nent) {
            IfCondition EqualTo(CAD_Sketch.ProfIRGet(CAD_Prof.i, 0), 0) ThenBlock: {
                CAD_Prof.ok = 0
                CAD_Prof.rev = 0
                CAD_Prof.k = 0
                WhileLoop LessThan(CAD_Prof.k, CAD_Prof.nhit) {
                    IfCondition EqualTo(ArrayGet(CAD_Prof.hit_e, CAD_Prof.k), CAD_Prof.i) ThenBlock: {
                        CAD_Prof.t = ArrayGet(CAD_Prof.hit_t, CAD_Prof.k)
                        CAD_Prof.aa = CAD_Num.Abs(CAD_Prof.t)
                        IfCondition EqualTo(Float_Le(CAD_Prof.aa, 0x3FD0000000000000), 1) ThenBlock: { CAD_Prof.ok = 1 }
                        CAD_Prof.aa = CAD_Num.Abs(Float_Sub(CAD_Prof.t, 0x3FF0000000000000))
                        IfCondition EqualTo(Float_Le(CAD_Prof.aa, 0x3FD0000000000000), 1) ThenBlock: { CAD_Prof.rev = 1 }
                    }
                    CAD_Prof.k = Add(CAD_Prof.k, 1)
                }
                IfCondition EqualTo(CAD_Prof.ok, 0) ThenBlock: {
                    CAD_Prof.px = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 2))
                    CAD_Prof.py = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 3))
                    CAD_Prof.vi = CAD_Sketch.ProfIRAddVert()
                    CAD_Prof.e = CAD_Prof.i
                    CAD_Prof.t = 0
                    CAD_Sketch.ProfIRAddHit()
                }
                IfCondition EqualTo(CAD_Prof.rev, 0) ThenBlock: {
                    CAD_Prof.px = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 4))
                    CAD_Prof.py = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.i, 12), 5))
                    CAD_Prof.vi = CAD_Sketch.ProfIRAddVert()
                    CAD_Prof.e = CAD_Prof.i
                    CAD_Prof.t = 0x3FF0000000000000
                    CAD_Sketch.ProfIRAddHit()
                }
            }
            CAD_Prof.i = Add(CAD_Prof.i, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Sketch.ProfIRAddHEPair {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Prof.v0, CAD_Prof.v1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CAD_Prof.nhe, 510) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Prof.he_a, CAD_Prof.nhe, CAD_Prof.v0)
        ArraySet(CAD_Prof.he_b, CAD_Prof.nhe, CAD_Prof.v1)
        ArraySet(CAD_Prof.he_k, CAD_Prof.nhe, CAD_Prof.kind)
        ArraySet(CAD_Prof.he_e, CAD_Prof.nhe, CAD_Prof.e)
        ArraySet(CAD_Prof.he_r, CAD_Prof.nhe, 0)
        ArraySet(CAD_Prof.he_ang, CAD_Prof.nhe, CAD_Prof.ang)
        ArraySet(CAD_Prof.he_sp, CAD_Prof.nhe, CAD_Prof.span)
        ArraySet(CAD_Prof.he_used, CAD_Prof.nhe, 0)
        CAD_Prof.nhe = Add(CAD_Prof.nhe, 1)
        ArraySet(CAD_Prof.he_a, CAD_Prof.nhe, CAD_Prof.v1)
        ArraySet(CAD_Prof.he_b, CAD_Prof.nhe, CAD_Prof.v0)
        ArraySet(CAD_Prof.he_k, CAD_Prof.nhe, CAD_Prof.kind)
        ArraySet(CAD_Prof.he_e, CAD_Prof.nhe, CAD_Prof.e)
        ArraySet(CAD_Prof.he_r, CAD_Prof.nhe, 1)
        ArraySet(CAD_Prof.he_ang, CAD_Prof.nhe, CAD_Prof.dang)
        ArraySet(CAD_Prof.he_sp, CAD_Prof.nhe, Float_Sub(0, CAD_Prof.span))
        ArraySet(CAD_Prof.he_used, CAD_Prof.nhe, 0)
        ArraySet(CAD_Prof.he_twin, Subtract(CAD_Prof.nhe, 1), CAD_Prof.nhe)
        ArraySet(CAD_Prof.he_twin, CAD_Prof.nhe, Subtract(CAD_Prof.nhe, 1))
        CAD_Prof.nhe = Add(CAD_Prof.nhe, 1)
        ReturnValue(1)
    }
}

Function.CAD_Sketch.ProfIRGather {
    Output: Integer
    Body: {
        CAD_Prof.nw = 0
        CAD_Prof.k = 0
        WhileLoop LessThan(CAD_Prof.k, CAD_Prof.nhit) {
            IfCondition EqualTo(ArrayGet(CAD_Prof.hit_e, CAD_Prof.k), CAD_Prof.e) ThenBlock: {
                IfCondition LessThan(CAD_Prof.nw, 32) ThenBlock: {
                    ArraySet(CAD_Prof.work_t, CAD_Prof.nw, ArrayGet(CAD_Prof.hit_t, CAD_Prof.k))
                    ArraySet(CAD_Prof.work_v, CAD_Prof.nw, ArrayGet(CAD_Prof.hit_v, CAD_Prof.k))
                    CAD_Prof.nw = Add(CAD_Prof.nw, 1)
                }
            }
            CAD_Prof.k = Add(CAD_Prof.k, 1)
        }
        CAD_Prof.a = 0
        WhileLoop LessThan(CAD_Prof.a, CAD_Prof.nw) {
            CAD_Prof.b = Add(CAD_Prof.a, 1)
            WhileLoop LessThan(CAD_Prof.b, CAD_Prof.nw) {
                IfCondition EqualTo(Float_Le(ArrayGet(CAD_Prof.work_t, CAD_Prof.b), ArrayGet(CAD_Prof.work_t, CAD_Prof.a)), 1) ThenBlock: {
                    CAD_Prof.t = ArrayGet(CAD_Prof.work_t, CAD_Prof.a)
                    CAD_Prof.vi = ArrayGet(CAD_Prof.work_v, CAD_Prof.a)
                    ArraySet(CAD_Prof.work_t, CAD_Prof.a, ArrayGet(CAD_Prof.work_t, CAD_Prof.b))
                    ArraySet(CAD_Prof.work_v, CAD_Prof.a, ArrayGet(CAD_Prof.work_v, CAD_Prof.b))
                    ArraySet(CAD_Prof.work_t, CAD_Prof.b, CAD_Prof.t)
                    ArraySet(CAD_Prof.work_v, CAD_Prof.b, CAD_Prof.vi)
                }
                CAD_Prof.b = Add(CAD_Prof.b, 1)
            }
            CAD_Prof.a = Add(CAD_Prof.a, 1)
        }
        ReturnValue(CAD_Prof.nw)
    }
}

Function.CAD_Sketch.ProfIRChainLine {
    Output: Integer
    Body: {
        CAD_Sketch.ProfIRGather()
        CAD_Prof.kind = 0
        CAD_Prof.span = 0
        CAD_Prof.k = 0
        WhileLoop LessThan(CAD_Prof.k, Subtract(CAD_Prof.nw, 1)) {
            CAD_Prof.v0 = ArrayGet(CAD_Prof.work_v, CAD_Prof.k)
            CAD_Prof.v1 = ArrayGet(CAD_Prof.work_v, Add(CAD_Prof.k, 1))
            CAD_Prof.ang = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_Prof.v1), ArrayGet(CAD_Prof.vy, CAD_Prof.v0)), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_Prof.v1), ArrayGet(CAD_Prof.vx, CAD_Prof.v0)))
            CAD_Prof.dang = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_Prof.v0), ArrayGet(CAD_Prof.vy, CAD_Prof.v1)), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_Prof.v0), ArrayGet(CAD_Prof.vx, CAD_Prof.v1)))
            CAD_Sketch.ProfIRAddHEPair()
            CAD_Prof.k = Add(CAD_Prof.k, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Sketch.ProfIRChainArc {
    Output: Integer
    Body: {
        CAD_Prof.cx = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 2))
        CAD_Prof.cy = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 3))
        CAD_Prof.kind = ArrayGet(CAD_Prof.slab, Multiply(CAD_Prof.e, 12))
        CAD_Prof.a0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 6))
        IfCondition EqualTo(CAD_Prof.kind, 1) ThenBlock: { CAD_Prof.a0 = 0 }
        CAD_Prof.k = 0
        WhileLoop LessThan(CAD_Prof.k, CAD_Prof.nhit) {
            IfCondition EqualTo(ArrayGet(CAD_Prof.hit_e, CAD_Prof.k), CAD_Prof.e) ThenBlock: {
                CAD_Prof.ang = ArrayGet(CAD_Prof.hit_t, CAD_Prof.k)
                CAD_Prof.t = CAD_Num.PosMod2Pi(Float_Sub(CAD_Prof.ang, CAD_Prof.a0))
                ArraySet(CAD_Prof.hit_t, CAD_Prof.k, CAD_Prof.t)
            }
            CAD_Prof.k = Add(CAD_Prof.k, 1)
        }
        CAD_Sketch.ProfIRGather()
        CAD_Prof.kind = 2
        CAD_Prof.k = 0
        WhileLoop LessThan(CAD_Prof.k, Subtract(CAD_Prof.nw, 1)) {
            CAD_Prof.v0 = ArrayGet(CAD_Prof.work_v, CAD_Prof.k)
            CAD_Prof.v1 = ArrayGet(CAD_Prof.work_v, Add(CAD_Prof.k, 1))
            CAD_Prof.span = Float_Sub(ArrayGet(CAD_Prof.work_t, Add(CAD_Prof.k, 1)), ArrayGet(CAD_Prof.work_t, CAD_Prof.k))
            CAD_Prof.a0 = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_Prof.v0), CAD_Prof.cy), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_Prof.v0), CAD_Prof.cx))
            CAD_Prof.cs = CAD_Geom.Cos(CAD_Prof.a0)
            CAD_Prof.sn = CAD_Geom.Sin(CAD_Prof.a0)
            CAD_Prof.ang = CAD_Geom.Atan2(CAD_Prof.cs, Float_Sub(0, CAD_Prof.sn))
            CAD_Prof.a1 = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_Prof.v1), CAD_Prof.cy), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_Prof.v1), CAD_Prof.cx))
            CAD_Prof.cs = CAD_Geom.Cos(CAD_Prof.a1)
            CAD_Prof.sn = CAD_Geom.Sin(CAD_Prof.a1)
            CAD_Prof.dang = CAD_Geom.Atan2(Float_Sub(0, CAD_Prof.cs), CAD_Prof.sn)
            CAD_Sketch.ProfIRAddHEPair()
            CAD_Prof.k = Add(CAD_Prof.k, 1)
        }
        IfCondition EqualTo(CAD_Sketch.ProfIRGet(CAD_Prof.e, 0), 1) ThenBlock: {
            IfCondition GreaterThan(CAD_Prof.nw, 1) ThenBlock: {
                CAD_Prof.v0 = ArrayGet(CAD_Prof.work_v, Subtract(CAD_Prof.nw, 1))
                CAD_Prof.v1 = ArrayGet(CAD_Prof.work_v, 0)
                CAD_Prof.span = Float_Add(Float_Sub(0x401921FB54442D18, ArrayGet(CAD_Prof.work_t, Subtract(CAD_Prof.nw, 1))), ArrayGet(CAD_Prof.work_t, 0))
                CAD_Prof.a0 = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_Prof.v0), CAD_Prof.cy), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_Prof.v0), CAD_Prof.cx))
                CAD_Prof.cs = CAD_Geom.Cos(CAD_Prof.a0)
                CAD_Prof.sn = CAD_Geom.Sin(CAD_Prof.a0)
                CAD_Prof.ang = CAD_Geom.Atan2(CAD_Prof.cs, Float_Sub(0, CAD_Prof.sn))
                CAD_Prof.a1 = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_Prof.v1), CAD_Prof.cy), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_Prof.v1), CAD_Prof.cx))
                CAD_Prof.cs = CAD_Geom.Cos(CAD_Prof.a1)
                CAD_Prof.sn = CAD_Geom.Sin(CAD_Prof.a1)
                CAD_Prof.dang = CAD_Geom.Atan2(Float_Sub(0, CAD_Prof.cs), CAD_Prof.sn)
                CAD_Sketch.ProfIRAddHEPair()
            }
        }
        ReturnValue(0)
    }
}

Function.CAD_Sketch.ProfChain {
    Output: Integer
    Body: {
        CAD_Prof.nhe = 0
        CAD_Prof.e = 0
        WhileLoop LessThan(CAD_Prof.e, CAD_Prof.nent) {
            IfCondition EqualTo(CAD_Sketch.ProfIRGet(CAD_Prof.e, 0), 0) ThenBlock: {
                CAD_Sketch.ProfIRChainLine()
            }
            IfCondition NotEqual(CAD_Sketch.ProfIRGet(CAD_Prof.e, 0), 0) ThenBlock: {
                CAD_Sketch.ProfIRChainArc()
            }
            CAD_Prof.e = Add(CAD_Prof.e, 1)
        }
        ReturnValue(CAD_Prof.nhe)
    }
}

Function.CAD_Sketch.ProfIRNextHE {
    Output: Integer
    Body: {
        CAD_Prof.v0 = ArrayGet(CAD_Prof.he_b, CAD_Prof.cur)
        CAD_Prof.v1 = ArrayGet(CAD_Prof.he_twin, CAD_Prof.cur)
        CAD_Prof.a0 = ArrayGet(CAD_Prof.he_ang, CAD_Prof.v1)
        CAD_Prof.nxt = Subtract(0, 1)
        CAD_Prof.best = 0x401921FB54442D18
        CAD_Prof.k = 0
        WhileLoop LessThan(CAD_Prof.k, CAD_Prof.nhe) {
            IfCondition EqualTo(ArrayGet(CAD_Prof.he_a, CAD_Prof.k), CAD_Prof.v0) ThenBlock: {
                IfCondition NotEqual(CAD_Prof.k, CAD_Prof.v1) ThenBlock: {
                    CAD_Prof.dang = Float_Sub(ArrayGet(CAD_Prof.he_ang, CAD_Prof.k), CAD_Prof.a0)
                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_Prof.dang), 1) ThenBlock: {
                        CAD_Prof.dang = Float_Add(CAD_Prof.dang, 0x401921FB54442D18)
                    }
                    IfCondition EqualTo(CAD_Num.IsZero(CAD_Prof.dang, 0), 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Prof.dang, CAD_Prof.best), 1) ThenBlock: {
                            CAD_Prof.best = CAD_Prof.dang
                            CAD_Prof.nxt = CAD_Prof.k
                        }
                    }
                }
            }
            CAD_Prof.k = Add(CAD_Prof.k, 1)
        }
        ReturnValue(CAD_Prof.nxt)
    }
}

Function.CAD_Sketch.ProfIRSamplePath {
    Output: Integer
    Body: {
        CAD_Prof.nn = 0
        CAD_Prof.k = 0
        WhileLoop LessThan(CAD_Prof.k, CAD_Prof.npath) {
            CAD_Prof.cur = ArrayGet(CAD_Prof.path_s, CAD_Prof.k)
            CAD_Prof.v0 = ArrayGet(CAD_Prof.he_a, CAD_Prof.cur)
            CAD_Prof.v1 = ArrayGet(CAD_Prof.he_b, CAD_Prof.cur)
            IfCondition EqualTo(ArrayGet(CAD_Prof.he_k, CAD_Prof.cur), 0) ThenBlock: {
                IfCondition LessThan(CAD_Prof.nn, 1000) ThenBlock: {
                    ArraySet(CAD_Prof.samp, Multiply(CAD_Prof.nn, 2), ArrayGet(CAD_Prof.vx, CAD_Prof.v0))
                    ArraySet(CAD_Prof.samp, Add(Multiply(CAD_Prof.nn, 2), 1), ArrayGet(CAD_Prof.vy, CAD_Prof.v0))
                    CAD_Prof.nn = Add(CAD_Prof.nn, 1)
                }
            }
            IfCondition EqualTo(ArrayGet(CAD_Prof.he_k, CAD_Prof.cur), 2) ThenBlock: {
                CAD_Prof.e = ArrayGet(CAD_Prof.he_e, CAD_Prof.cur)
                CAD_Prof.cx = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 2))
                CAD_Prof.cy = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 3))
                CAD_Prof.r = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 4))
                CAD_Prof.span = ArrayGet(CAD_Prof.he_sp, CAD_Prof.cur)
                CAD_Prof.a0 = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_Prof.v0), CAD_Prof.cy), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_Prof.v0), CAD_Prof.cx))
                CAD_Prof.hi = 0
                WhileLoop LessThan(CAD_Prof.hi, 16) {
                    IfCondition LessThan(CAD_Prof.nn, 1000) ThenBlock: {
                        CAD_Prof.t = Float_Div(Float_FromInt(CAD_Prof.hi), 0x4030000000000000)
                        CAD_Prof.ang = Float_Add(CAD_Prof.a0, CAD_Num.Mul(CAD_Prof.span, CAD_Prof.t))
                        CAD_Prof.cs = CAD_Geom.Cos(CAD_Prof.ang)
                        CAD_Prof.sn = CAD_Geom.Sin(CAD_Prof.ang)
                        ArraySet(CAD_Prof.samp, Multiply(CAD_Prof.nn, 2), Float_Add(CAD_Prof.cx, CAD_Num.Mul(CAD_Prof.r, CAD_Prof.cs)))
                        ArraySet(CAD_Prof.samp, Add(Multiply(CAD_Prof.nn, 2), 1), Float_Add(CAD_Prof.cy, CAD_Num.Mul(CAD_Prof.r, CAD_Prof.sn)))
                        CAD_Prof.nn = Add(CAD_Prof.nn, 1)
                    }
                    CAD_Prof.hi = Add(CAD_Prof.hi, 1)
                }
            }
            CAD_Prof.k = Add(CAD_Prof.k, 1)
        }
        ReturnValue(CAD_Prof.nn)
    }
}

Function.CAD_Sketch.ProfIRRingArea {
    Output: Integer
    Body: {
        CAD_Prof.area = 0
        CAD_Prof.k = 0
        WhileLoop LessThan(CAD_Prof.k, CAD_Prof.nn) {
            CAD_Prof.j = Add(CAD_Prof.k, 1)
            IfCondition EqualTo(CAD_Prof.j, CAD_Prof.nn) ThenBlock: { CAD_Prof.j = 0 }
            CAD_Prof.x0 = ArrayGet(CAD_Prof.samp, Multiply(CAD_Prof.k, 2))
            CAD_Prof.y0 = ArrayGet(CAD_Prof.samp, Add(Multiply(CAD_Prof.k, 2), 1))
            CAD_Prof.x1 = ArrayGet(CAD_Prof.samp, Multiply(CAD_Prof.j, 2))
            CAD_Prof.y1 = ArrayGet(CAD_Prof.samp, Add(Multiply(CAD_Prof.j, 2), 1))
            CAD_Prof.area = Float_Add(CAD_Prof.area, Float_Sub(CAD_Num.Mul(CAD_Prof.x0, CAD_Prof.y1), CAD_Num.Mul(CAD_Prof.x1, CAD_Prof.y0)))
            CAD_Prof.k = Add(CAD_Prof.k, 1)
        }
        CAD_Prof.area = Float_Div(CAD_Prof.area, 0x4000000000000000)
        ReturnValue(CAD_Prof.area)
    }
}

Function.CAD_Sketch.ProfIRReverseSamp {
    Output: Integer
    Body: {
        CAD_Prof.k = 0
        CAD_Prof.j = Subtract(CAD_Prof.nn, 1)
        WhileLoop LessThan(CAD_Prof.k, CAD_Prof.j) {
            CAD_Prof.x0 = ArrayGet(CAD_Prof.samp, Multiply(CAD_Prof.k, 2))
            CAD_Prof.y0 = ArrayGet(CAD_Prof.samp, Add(Multiply(CAD_Prof.k, 2), 1))
            ArraySet(CAD_Prof.samp, Multiply(CAD_Prof.k, 2), ArrayGet(CAD_Prof.samp, Multiply(CAD_Prof.j, 2)))
            ArraySet(CAD_Prof.samp, Add(Multiply(CAD_Prof.k, 2), 1), ArrayGet(CAD_Prof.samp, Add(Multiply(CAD_Prof.j, 2), 1)))
            ArraySet(CAD_Prof.samp, Multiply(CAD_Prof.j, 2), CAD_Prof.x0)
            ArraySet(CAD_Prof.samp, Add(Multiply(CAD_Prof.j, 2), 1), CAD_Prof.y0)
            CAD_Prof.k = Add(CAD_Prof.k, 1)
            CAD_Prof.j = Subtract(CAD_Prof.j, 1)
        }
        ReturnValue(0)
    }
}

// Overlay only — do not AddLine (that mutates live sketch).
Function.CAD_Sketch.ProfIREmitRing {
    Output: Integer
    Body: {
        IfCondition LessThan(CAD_Prof.nn, 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Prof.sk, 0) ThenBlock: { ReturnValue(0) }
        CAD_Prof.a = CAD_Store.Read(CAD_Prof.sk, 12)
        CAD_Prof.b = CAD_Store.Read(CAD_Prof.sk, 15)
        IfCondition GreaterEqual(CAD_Prof.a, CAD_Prof.b) ThenBlock: { ReturnValue(CAD_Prof.a) }
        CAD_Prof.x = CAD_Store.Read(CAD_Prof.sk, 13)
        CAD_Prof.y = CAD_Store.Read(CAD_Prof.sk, 14)
        IfCondition EqualTo(CAD_Prof.x, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Prof.y, 0) ThenBlock: { ReturnValue(0) }
        CAD_Prof.cc = 0
        IfCondition GreaterThan(CAD_Prof.a, 0) ThenBlock: {
            CAD_Prof.cc = Add(ArrayGet(CAD_Prof.x, Add(Multiply(Subtract(CAD_Prof.a, 1), 2), 1)), ArrayGet(CAD_Prof.x, Multiply(Subtract(CAD_Prof.a, 1), 2)))
        }
        ArraySet(CAD_Prof.x, Multiply(CAD_Prof.a, 2), CAD_Prof.nn)
        ArraySet(CAD_Prof.x, Add(Multiply(CAD_Prof.a, 2), 1), CAD_Prof.cc)
        CAD_Prof.k = 0
        WhileLoop LessThan(CAD_Prof.k, CAD_Prof.nn) {
            ArraySet(CAD_Prof.y, Multiply(Add(CAD_Prof.cc, CAD_Prof.k), 2), ArrayGet(CAD_Prof.samp, Multiply(CAD_Prof.k, 2)))
            ArraySet(CAD_Prof.y, Add(Multiply(Add(CAD_Prof.cc, CAD_Prof.k), 2), 1), ArrayGet(CAD_Prof.samp, Add(Multiply(CAD_Prof.k, 2), 1)))
            CAD_Prof.k = Add(CAD_Prof.k, 1)
        }
        CAD_Prof.a = Add(CAD_Prof.a, 1)
        CAD_Store.Write(CAD_Prof.sk, 12, CAD_Prof.a)
        IfCondition EqualTo(CAD_Prof.a, 1) ThenBlock: {
            CAD_Prof.ok = CAD_Store.Read(CAD_Prof.sk, 3)
            CAD_Prof.k = 0
            WhileLoop LessThan(CAD_Prof.k, CAD_Prof.nn) {
                ArraySet(CAD_Prof.ok, Multiply(CAD_Prof.k, 2), ArrayGet(CAD_Prof.samp, Multiply(CAD_Prof.k, 2)))
                ArraySet(CAD_Prof.ok, Add(Multiply(CAD_Prof.k, 2), 1), ArrayGet(CAD_Prof.samp, Add(Multiply(CAD_Prof.k, 2), 1)))
                CAD_Prof.k = Add(CAD_Prof.k, 1)
            }
            CAD_Store.Write(CAD_Prof.sk, 2, CAD_Prof.nn)
        }
        CAD_Prof.nprof = CAD_Prof.a
        ReturnValue(CAD_Prof.a)
    }
}

Function.CAD_Sketch.ProfIREmitCircle {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Sketch.ProfIRGet(CAD_Prof.e, 8), 0) ThenBlock: { ReturnValue(0) }
        CAD_Prof.cx = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 2))
        CAD_Prof.cy = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 3))
        CAD_Prof.r = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 4))
        CAD_Prof.nn = 0
        CAD_Prof.hi = 0
        WhileLoop LessThan(CAD_Prof.hi, 32) {
            CAD_Prof.ang = Float_Div(CAD_Num.Mul(Float_FromInt(CAD_Prof.hi), 0x401921FB54442D18), 0x4040000000000000)
            CAD_Prof.cs = CAD_Geom.Cos(CAD_Prof.ang)
            CAD_Prof.sn = CAD_Geom.Sin(CAD_Prof.ang)
            ArraySet(CAD_Prof.samp, Multiply(CAD_Prof.nn, 2), Float_Add(CAD_Prof.cx, CAD_Num.Mul(CAD_Prof.r, CAD_Prof.cs)))
            ArraySet(CAD_Prof.samp, Add(Multiply(CAD_Prof.nn, 2), 1), Float_Add(CAD_Prof.cy, CAD_Num.Mul(CAD_Prof.r, CAD_Prof.sn)))
            CAD_Prof.nn = Add(CAD_Prof.nn, 1)
            CAD_Prof.hi = Add(CAD_Prof.hi, 1)
        }
        ReturnValue(CAD_Sketch.ProfIREmitRing())
    }
}

Function.CAD_Sketch.ProfSolve {
    Output: Integer
    Body: {
        CAD_Prof.nprof = 0
        CAD_Store.Write(CAD_Prof.sk, 12, 0)
        CAD_Prof.i = 0
        WhileLoop LessThan(CAD_Prof.i, CAD_Prof.nhe) {
            IfCondition EqualTo(ArrayGet(CAD_Prof.he_used, CAD_Prof.i), 0) ThenBlock: {
                CAD_Prof.npath = 0
                CAD_Prof.cur = CAD_Prof.i
                CAD_Prof.ok = 0
                CAD_Prof.j = 0
                WhileLoop LessThan(CAD_Prof.j, 64) {
                    ArraySet(CAD_Prof.he_used, CAD_Prof.cur, 1)
                    ArraySet(CAD_Prof.path_s, CAD_Prof.npath, CAD_Prof.cur)
                    CAD_Prof.npath = Add(CAD_Prof.npath, 1)
                    CAD_Sketch.ProfIRNextHE()
                    IfCondition EqualTo(CAD_Prof.nxt, CAD_Prof.i) ThenBlock: {
                        CAD_Prof.ok = 1
                        CAD_Prof.j = 64
                    }
                    IfCondition EqualTo(CAD_Prof.ok, 0) ThenBlock: {
                        IfCondition LessThan(CAD_Prof.nxt, 0) ThenBlock: { CAD_Prof.j = 64 }
                        IfCondition GreaterEqual(CAD_Prof.nxt, 0) ThenBlock: {
                            IfCondition EqualTo(ArrayGet(CAD_Prof.he_used, CAD_Prof.nxt), 1) ThenBlock: { CAD_Prof.j = 64 }
                            IfCondition NotEqual(ArrayGet(CAD_Prof.he_used, CAD_Prof.nxt), 1) ThenBlock: {
                                CAD_Prof.cur = CAD_Prof.nxt
                            }
                        }
                    }
                    CAD_Prof.j = Add(CAD_Prof.j, 1)
                }
                IfCondition EqualTo(CAD_Prof.ok, 0) ThenBlock: {
                    CAD_Prof.k = 1
                    WhileLoop LessThan(CAD_Prof.k, CAD_Prof.npath) {
                        ArraySet(CAD_Prof.he_used, ArrayGet(CAD_Prof.path_s, CAD_Prof.k), 0)
                        CAD_Prof.k = Add(CAD_Prof.k, 1)
                    }
                }
                IfCondition EqualTo(CAD_Prof.ok, 1) ThenBlock: {
                    IfCondition GreaterEqual(CAD_Prof.npath, 1) ThenBlock: {
                        CAD_Sketch.ProfIRSamplePath()
                        CAD_Sketch.ProfIRRingArea()
                        IfCondition EqualTo(CAD_Num.IsZero(CAD_Prof.area, 0), 1) ThenBlock: {
                            CAD_Prof.k = 1
                            WhileLoop LessThan(CAD_Prof.k, CAD_Prof.npath) {
                                ArraySet(CAD_Prof.he_used, ArrayGet(CAD_Prof.path_s, CAD_Prof.k), 0)
                                CAD_Prof.k = Add(CAD_Prof.k, 1)
                            }
                        }
                        IfCondition EqualTo(CAD_Num.IsZero(CAD_Prof.area, 0), 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Prof.area), 1) ThenBlock: {
                                CAD_Sketch.ProfIRReverseSamp()
                            }
                            CAD_Sketch.ProfIREmitRing()
                            CAD_Prof.k = 0
                            WhileLoop LessThan(CAD_Prof.k, CAD_Prof.npath) {
                                CAD_Prof.cur = ArrayGet(CAD_Prof.path_s, CAD_Prof.k)
                                ArraySet(CAD_Prof.he_used, CAD_Prof.cur, 1)
                                ArraySet(CAD_Prof.he_used, ArrayGet(CAD_Prof.he_twin, CAD_Prof.cur), 1)
                                CAD_Prof.k = Add(CAD_Prof.k, 1)
                            }
                        }
                    }
                }
            }
            CAD_Prof.i = Add(CAD_Prof.i, 1)
        }
        CAD_Prof.e = 0
        WhileLoop LessThan(CAD_Prof.e, CAD_Prof.nent) {
            IfCondition EqualTo(CAD_Sketch.ProfIRGet(CAD_Prof.e, 0), 1) ThenBlock: {
                CAD_Sketch.ProfIREmitCircle()
            }
            CAD_Prof.e = Add(CAD_Prof.e, 1)
        }
        ReturnValue(CAD_Store.Read(CAD_Prof.sk, 12))
    }
}

Function.CAD_Sketch.ProfCompile {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Sketch.ProfParse(sketch_handle), 0) ThenBlock: { ReturnValue(0) }
        CAD_Sketch.ProfAnalyze()
        CAD_Sketch.ProfChain()
        ReturnValue(CAD_Sketch.ProfSolve())
    }
}
