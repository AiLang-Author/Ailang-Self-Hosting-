// CAD.SketchProfile.SketchPlex — profile compiler as a Sketchpad plex walk.
// One plex node per LINE/ARC/CIRCLE *segment* (split only at real joins).
// Join is endpoint coincidence (~0.2 mm), not a tessellated line soup.
// Arcs stay a0→a1 (no complementary leftover wrap). Full CIRCLE entities
// emit their own ring; mixed sketches do not invent a disk or a chord triangle.
// API Function.CAD_Sketch.*  (facade: LibraryImport.Cad.CAD_SketchProfile)
//
// Plex type = kind+1 (1 LINE, 2 CIRCLE-sector stored as ARC, 3 ARC).
// Slots: 0 kind  1 live_i  2-5 x0 y0 x1 y1  6-8 cx cy rad
//        9 a0  10 span  11 used(bit0 fwd, bit1 rev)  12 v0  13 v1
//        14 ang_fwd  15 ang_rev
// Ring 0 = all segments.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Plex
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

FixedPool.CAD_SPlex {
    "init": Initialize=0, CanChange=True
    "head": Initialize=0, CanChange=True
    "nseg": Initialize=0, CanChange=True
    "nodes": Initialize=0, CanChange=True
    "path_nd": Initialize=0, CanChange=True
    "path_rev": Initialize=0, CanChange=True
    "circ_used": Initialize=0, CanChange=True
    "emit_nn": Initialize=0, CanChange=True
    "emit_ar": Initialize=0, CanChange=True
    "nemit": Initialize=0, CanChange=True
    "pack_nd": Initialize=0, CanChange=True
    "pack_rev": Initialize=0, CanChange=True
    "pack_n": Initialize=0, CanChange=True
    "prof_off": Initialize=0, CanChange=True
    "prof_len": Initialize=0, CanChange=True
    "eps2": Initialize=0, CanChange=True
    "i": Initialize=0, CanChange=True
    "j": Initialize=0, CanChange=True
    "k": Initialize=0, CanChange=True
    "n": Initialize=0, CanChange=True
    "nd": Initialize=0, CanChange=True
    "v0": Initialize=0, CanChange=True
    "v1": Initialize=0, CanChange=True
    "kind": Initialize=0, CanChange=True
    "x0": Initialize=0, CanChange=True
    "y0": Initialize=0, CanChange=True
    "x1": Initialize=0, CanChange=True
    "y1": Initialize=0, CanChange=True
    "cx": Initialize=0, CanChange=True
    "cy": Initialize=0, CanChange=True
    "r": Initialize=0, CanChange=True
    "a0": Initialize=0, CanChange=True
    "a1": Initialize=0, CanChange=True
    "span": Initialize=0, CanChange=True
    "ang": Initialize=0, CanChange=True
    "dang": Initialize=0, CanChange=True
    "px": Initialize=0, CanChange=True
    "py": Initialize=0, CanChange=True
    "t": Initialize=0, CanChange=True
    "u": Initialize=0, CanChange=True
    "dx": Initialize=0, CanChange=True
    "dy": Initialize=0, CanChange=True
    "aa": Initialize=0, CanChange=True
    "bb": Initialize=0, CanChange=True
    "cc": Initialize=0, CanChange=True
    "disc": Initialize=0, CanChange=True
    "s": Initialize=0, CanChange=True
    "ok": Initialize=0, CanChange=True
    "cur": Initialize=0, CanChange=True
    "crev": Initialize=0, CanChange=True
    "nxt": Initialize=0, CanChange=True
    "nrev": Initialize=0, CanChange=True
    "best": Initialize=0, CanChange=True
    "used": Initialize=0, CanChange=True
    "hi": Initialize=0, CanChange=True
    "dup": Initialize=0, CanChange=True
    "start_nd": Initialize=0, CanChange=True
    "start_rev": Initialize=0, CanChange=True
    "npath": Initialize=0, CanChange=True
    "dest": Initialize=0, CanChange=True
    "twin_ang": Initialize=0, CanChange=True
    "cand_ang": Initialize=0, CanChange=True
    "cs": Initialize=0, CanChange=True
    "sn": Initialize=0, CanChange=True
}

Function.CAD_Sketch.SketchPlexInit {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_SPlex.init, 0) ThenBlock: {
            Plex.Init()
            CAD_SPlex.nodes = Allocate(256)
            CAD_SPlex.path_nd = Allocate(256)
            CAD_SPlex.path_rev = Allocate(256)
            CAD_SPlex.circ_used = Allocate(64)
            CAD_SPlex.emit_nn = Allocate(64)
            CAD_SPlex.emit_ar = Allocate(64)
            CAD_SPlex.pack_nd = Allocate(2048)
            CAD_SPlex.pack_rev = Allocate(2048)
            CAD_SPlex.prof_off = Allocate(64)
            CAD_SPlex.prof_len = Allocate(64)
            CAD_SPlex.init = 1
        }
        IfCondition EqualTo(CAD_SPlex.nodes, 0) ThenBlock: { ReturnValue(0) }
        CAD_SPlex.eps2 = 0x3FA47AE147AE147B
        ReturnValue(1)
    }
}

Function.CAD_Sketch.SketchPlexReset {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Sketch.SketchPlexInit(), 0) ThenBlock: { ReturnValue(0) }
        CAD_SPlex.i = 0
        WhileLoop LessThan(CAD_SPlex.i, CAD_SPlex.nseg) {
            Plex.Free(ArrayGet(CAD_SPlex.nodes, CAD_SPlex.i))
            CAD_SPlex.i = Add(CAD_SPlex.i, 1)
        }
        CAD_SPlex.nseg = 0
        CAD_SPlex.head = 0
        CAD_SPlex.nemit = 0
        CAD_SPlex.pack_n = 0
        CAD_SPlex.i = 0
        WhileLoop LessThan(CAD_SPlex.i, 64) {
            ArraySet(CAD_SPlex.circ_used, CAD_SPlex.i, 0)
            ArraySet(CAD_SPlex.prof_len, CAD_SPlex.i, 0)
            ArraySet(CAD_SPlex.prof_off, CAD_SPlex.i, 0)
            CAD_SPlex.i = Add(CAD_SPlex.i, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Sketch.SketchPlexNear {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Output: Integer
    Body: {
        ndx = Float_Sub(x0, x1)
        ndy = Float_Sub(y0, y1)
        nd2 = Float_Add(CAD_Num.Sq(ndx), CAD_Num.Sq(ndy))
        IfCondition EqualTo(Float_Le(nd2, CAD_SPlex.eps2), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Merge within (0.2 mm)^2 — Cos(a) vs a trimmed line tip is a join, not a new vertex.
Function.CAD_Sketch.SketchPlexAddVert {
    Output: Integer
    Body: {
        CAD_SPlex.k = 0
        WhileLoop LessThan(CAD_SPlex.k, CAD_Prof.nv) {
            adx = Float_Sub(ArrayGet(CAD_Prof.vx, CAD_SPlex.k), CAD_Prof.px)
            ady = Float_Sub(ArrayGet(CAD_Prof.vy, CAD_SPlex.k), CAD_Prof.py)
            d2 = Float_Add(CAD_Num.Sq(adx), CAD_Num.Sq(ady))
            IfCondition EqualTo(Float_Le(d2, CAD_SPlex.eps2), 1) ThenBlock: {
                ReturnValue(CAD_SPlex.k)
            }
            CAD_SPlex.k = Add(CAD_SPlex.k, 1)
        }
        IfCondition GreaterEqual(CAD_Prof.nv, 256) ThenBlock: { ReturnValue(Subtract(CAD_Prof.nv, 1)) }
        ArraySet(CAD_Prof.vx, CAD_Prof.nv, CAD_Prof.px)
        ArraySet(CAD_Prof.vy, CAD_Prof.nv, CAD_Prof.py)
        CAD_SPlex.ok = CAD_Prof.nv
        CAD_Prof.nv = Add(CAD_Prof.nv, 1)
        ReturnValue(CAD_SPlex.ok)
    }
}

Function.CAD_Sketch.SketchPlexSeedEnds {
    Output: Integer
    Body: {
        CAD_SPlex.i = 0
        WhileLoop LessThan(CAD_SPlex.i, CAD_Prof.nent) {
            CAD_SPlex.kind = CAD_Sketch.ProfIRGet(CAD_SPlex.i, 0)
            IfCondition EqualTo(CAD_SPlex.kind, 0) ThenBlock: {
                CAD_Prof.px = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 2))
                CAD_Prof.py = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 3))
                CAD_Sketch.SketchPlexAddVert()
                CAD_Prof.px = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 4))
                CAD_Prof.py = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 5))
                CAD_Sketch.SketchPlexAddVert()
            }
            IfCondition EqualTo(CAD_SPlex.kind, 2) ThenBlock: {
                CAD_SPlex.cx = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 2))
                CAD_SPlex.cy = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 3))
                CAD_SPlex.r = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 4))
                CAD_SPlex.a0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 6))
                CAD_SPlex.a1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 7))
                CAD_SPlex.cs = CAD_Geom.Cos(CAD_SPlex.a0)
                CAD_SPlex.sn = CAD_Geom.Sin(CAD_SPlex.a0)
                CAD_Prof.px = Float_Add(CAD_SPlex.cx, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.cs))
                CAD_Prof.py = Float_Add(CAD_SPlex.cy, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.sn))
                CAD_Sketch.SketchPlexAddVert()
                CAD_SPlex.cs = CAD_Geom.Cos(CAD_SPlex.a1)
                CAD_SPlex.sn = CAD_Geom.Sin(CAD_SPlex.a1)
                CAD_Prof.px = Float_Add(CAD_SPlex.cx, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.cs))
                CAD_Prof.py = Float_Add(CAD_SPlex.cy, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.sn))
                CAD_Sketch.SketchPlexAddVert()
            }
            CAD_SPlex.i = Add(CAD_SPlex.i, 1)
        }
        ReturnValue(CAD_Prof.nv)
    }
}

// Line×line. t,u on the segments (not ±25% past the tips — that invented the triangle apex).
Function.CAD_Sketch.SketchPlexHitLineLine {
    Output: Integer
    Body: {
        CAD_SPlex.x0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 2))
        CAD_SPlex.y0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 3))
        CAD_SPlex.x1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 4))
        CAD_SPlex.y1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 5))
        CAD_SPlex.dx = Float_Sub(CAD_SPlex.x1, CAD_SPlex.x0)
        CAD_SPlex.dy = Float_Sub(CAD_SPlex.y1, CAD_SPlex.y0)
        CAD_SPlex.px = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.j, 12), 2))
        CAD_SPlex.py = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.j, 12), 3))
        CAD_SPlex.aa = Float_Sub(ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.j, 12), 4)), CAD_SPlex.px)
        CAD_SPlex.bb = Float_Sub(ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.j, 12), 5)), CAD_SPlex.py)
        CAD_SPlex.disc = Float_Sub(CAD_Num.Mul(CAD_SPlex.dx, CAD_SPlex.bb), CAD_Num.Mul(CAD_SPlex.dy, CAD_SPlex.aa))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_SPlex.disc, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_SPlex.t = Float_Div(Float_Sub(CAD_Num.Mul(Float_Sub(CAD_SPlex.px, CAD_SPlex.x0), CAD_SPlex.bb), CAD_Num.Mul(Float_Sub(CAD_SPlex.py, CAD_SPlex.y0), CAD_SPlex.aa)), CAD_SPlex.disc)
        CAD_SPlex.u = Float_Div(Float_Sub(CAD_Num.Mul(Float_Sub(CAD_SPlex.px, CAD_SPlex.x0), CAD_SPlex.dy), CAD_Num.Mul(Float_Sub(CAD_SPlex.py, CAD_SPlex.y0), CAD_SPlex.dx)), CAD_SPlex.disc)
        CAD_SPlex.ok = 1
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(CAD_SPlex.t, 0x3F50624DD2F1A9FC)), 1) ThenBlock: { CAD_SPlex.ok = 0 }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0x3FF004189374BC6A, CAD_SPlex.t)), 1) ThenBlock: { CAD_SPlex.ok = 0 }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(CAD_SPlex.u, 0x3F50624DD2F1A9FC)), 1) ThenBlock: { CAD_SPlex.ok = 0 }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0x3FF004189374BC6A, CAD_SPlex.u)), 1) ThenBlock: { CAD_SPlex.ok = 0 }
        IfCondition EqualTo(CAD_SPlex.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Prof.px = Float_Add(CAD_SPlex.x0, CAD_Num.Mul(CAD_SPlex.t, CAD_SPlex.dx))
        CAD_Prof.py = Float_Add(CAD_SPlex.y0, CAD_Num.Mul(CAD_SPlex.t, CAD_SPlex.dy))
        CAD_Sketch.SketchPlexAddVert()
        ReturnValue(1)
    }
}

// Line i vs CIRCLE/ARC j. t on the segment, angle on the stored span only.
Function.CAD_Sketch.SketchPlexHitLineCirc {
    Output: Integer
    Body: {
        CAD_SPlex.x0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 2))
        CAD_SPlex.y0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 3))
        CAD_SPlex.x1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 4))
        CAD_SPlex.y1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.i, 12), 5))
        CAD_SPlex.dx = Float_Sub(CAD_SPlex.x1, CAD_SPlex.x0)
        CAD_SPlex.dy = Float_Sub(CAD_SPlex.y1, CAD_SPlex.y0)
        CAD_SPlex.aa = Float_Add(CAD_Num.Sq(CAD_SPlex.dx), CAD_Num.Sq(CAD_SPlex.dy))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_SPlex.aa, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_SPlex.cx = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.j, 12), 2))
        CAD_SPlex.cy = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.j, 12), 3))
        CAD_SPlex.r = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_SPlex.j, 12), 4))
        CAD_SPlex.px = Float_Sub(CAD_SPlex.x0, CAD_SPlex.cx)
        CAD_SPlex.py = Float_Sub(CAD_SPlex.y0, CAD_SPlex.cy)
        CAD_SPlex.bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(CAD_SPlex.px, CAD_SPlex.py, CAD_SPlex.dx, CAD_SPlex.dy))
        CAD_SPlex.cc = Float_Sub(Float_Add(CAD_Num.Sq(CAD_SPlex.px), CAD_Num.Sq(CAD_SPlex.py)), CAD_Num.Sq(CAD_SPlex.r))
        CAD_SPlex.disc = Float_Sub(CAD_Num.Sq(CAD_SPlex.bb), CAD_Num.Mul(CAD_Num.Mul(0x4010000000000000, CAD_SPlex.aa), CAD_SPlex.cc))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_SPlex.disc), 1) ThenBlock: {
            IfCondition EqualTo(Float_Le(CAD_Num.Abs(CAD_SPlex.disc), CAD_Num.Mul(CAD_SPlex.aa, 0x3F50624DD2F1A9FC)), 1) ThenBlock: {
                CAD_SPlex.disc = 0
            }
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_SPlex.disc), 1) ThenBlock: { ReturnValue(0) }
        CAD_SPlex.s = CAD_Num.Sqrt(CAD_SPlex.disc)
        CAD_SPlex.hi = 0
        WhileLoop LessThan(CAD_SPlex.hi, 2) {
            CAD_SPlex.t = Float_Div(Float_Sub(Float_Sub(0, CAD_SPlex.bb), CAD_SPlex.s), CAD_Num.Mul(0x4000000000000000, CAD_SPlex.aa))
            IfCondition EqualTo(CAD_SPlex.hi, 1) ThenBlock: {
                CAD_SPlex.t = Float_Div(Float_Add(Float_Sub(0, CAD_SPlex.bb), CAD_SPlex.s), CAD_Num.Mul(0x4000000000000000, CAD_SPlex.aa))
            }
            CAD_SPlex.ok = 1
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(CAD_SPlex.t, 0x3F50624DD2F1A9FC)), 1) ThenBlock: { CAD_SPlex.ok = 0 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0x3FF004189374BC6A, CAD_SPlex.t)), 1) ThenBlock: { CAD_SPlex.ok = 0 }
            IfCondition EqualTo(CAD_SPlex.ok, 1) ThenBlock: {
                CAD_Prof.px = Float_Add(CAD_SPlex.x0, CAD_Num.Mul(CAD_SPlex.t, CAD_SPlex.dx))
                CAD_Prof.py = Float_Add(CAD_SPlex.y0, CAD_Num.Mul(CAD_SPlex.t, CAD_SPlex.dy))
                CAD_Prof.ang = CAD_Geom.Atan2(Float_Sub(CAD_Prof.py, CAD_SPlex.cy), Float_Sub(CAD_Prof.px, CAD_SPlex.cx))
                CAD_Prof.j = CAD_SPlex.j
                IfCondition EqualTo(CAD_Sketch.ProfIROnSpan(), 1) ThenBlock: {
                    CAD_Sketch.SketchPlexAddVert()
                }
            }
            CAD_SPlex.hi = Add(CAD_SPlex.hi, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Sketch.SketchPlexHits {
    Output: Integer
    Body: {
        CAD_SPlex.i = 0
        WhileLoop LessThan(CAD_SPlex.i, CAD_Prof.nent) {
            CAD_SPlex.j = Add(CAD_SPlex.i, 1)
            WhileLoop LessThan(CAD_SPlex.j, CAD_Prof.nent) {
                CAD_SPlex.x0 = CAD_Sketch.ProfIRGet(CAD_SPlex.i, 0)
                CAD_SPlex.y0 = CAD_Sketch.ProfIRGet(CAD_SPlex.j, 0)
                IfCondition EqualTo(CAD_SPlex.x0, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_SPlex.y0, 0) ThenBlock: {
                        CAD_Sketch.SketchPlexHitLineLine()
                    }
                    IfCondition NotEqual(CAD_SPlex.y0, 0) ThenBlock: {
                        CAD_Sketch.SketchPlexHitLineCirc()
                    }
                }
                IfCondition NotEqual(CAD_SPlex.x0, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_SPlex.y0, 0) ThenBlock: {
                        CAD_SPlex.k = CAD_SPlex.i
                        CAD_SPlex.i = CAD_SPlex.j
                        CAD_SPlex.j = CAD_SPlex.k
                        CAD_Sketch.SketchPlexHitLineCirc()
                        CAD_SPlex.j = CAD_SPlex.i
                        CAD_SPlex.i = CAD_SPlex.k
                    }
                }
                CAD_SPlex.j = Add(CAD_SPlex.j, 1)
            }
            CAD_SPlex.i = Add(CAD_SPlex.i, 1)
        }
        ReturnValue(CAD_Prof.nv)
    }
}

Function.CAD_Sketch.SketchPlexGatherPush {
    Output: Integer
    Body: {
        CAD_SPlex.dup = 0
        CAD_SPlex.n = 0
        WhileLoop LessThan(CAD_SPlex.n, CAD_Prof.nw) {
            IfCondition EqualTo(ArrayGet(CAD_Prof.work_v, CAD_SPlex.n), CAD_SPlex.k) ThenBlock: {
                CAD_SPlex.dup = 1
            }
            CAD_SPlex.n = Add(CAD_SPlex.n, 1)
        }
        IfCondition EqualTo(CAD_SPlex.dup, 0) ThenBlock: {
            IfCondition LessThan(CAD_Prof.nw, 32) ThenBlock: {
                ArraySet(CAD_Prof.work_t, CAD_Prof.nw, CAD_SPlex.t)
                ArraySet(CAD_Prof.work_v, CAD_Prof.nw, CAD_SPlex.k)
                CAD_Prof.nw = Add(CAD_Prof.nw, 1)
            }
        }
        ReturnValue(CAD_Prof.nw)
    }
}

Function.CAD_Sketch.SketchPlexGatherSort {
    Output: Integer
    Body: {
        CAD_SPlex.n = 0
        WhileLoop LessThan(CAD_SPlex.n, CAD_Prof.nw) {
            CAD_SPlex.hi = Add(CAD_SPlex.n, 1)
            WhileLoop LessThan(CAD_SPlex.hi, CAD_Prof.nw) {
                IfCondition EqualTo(Float_Le(ArrayGet(CAD_Prof.work_t, CAD_SPlex.hi), ArrayGet(CAD_Prof.work_t, CAD_SPlex.n)), 1) ThenBlock: {
                    CAD_SPlex.t = ArrayGet(CAD_Prof.work_t, CAD_SPlex.n)
                    CAD_SPlex.v0 = ArrayGet(CAD_Prof.work_v, CAD_SPlex.n)
                    ArraySet(CAD_Prof.work_t, CAD_SPlex.n, ArrayGet(CAD_Prof.work_t, CAD_SPlex.hi))
                    ArraySet(CAD_Prof.work_v, CAD_SPlex.n, ArrayGet(CAD_Prof.work_v, CAD_SPlex.hi))
                    ArraySet(CAD_Prof.work_t, CAD_SPlex.hi, CAD_SPlex.t)
                    ArraySet(CAD_Prof.work_v, CAD_SPlex.hi, CAD_SPlex.v0)
                }
                CAD_SPlex.hi = Add(CAD_SPlex.hi, 1)
            }
            CAD_SPlex.n = Add(CAD_SPlex.n, 1)
        }
        ReturnValue(CAD_Prof.nw)
    }
}

Function.CAD_Sketch.SketchPlexGatherLine {
    Output: Integer
    Body: {
        CAD_Prof.nw = 0
        CAD_SPlex.x0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 2))
        CAD_SPlex.y0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 3))
        CAD_SPlex.x1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 4))
        CAD_SPlex.y1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 5))
        CAD_SPlex.dx = Float_Sub(CAD_SPlex.x1, CAD_SPlex.x0)
        CAD_SPlex.dy = Float_Sub(CAD_SPlex.y1, CAD_SPlex.y0)
        CAD_SPlex.aa = Float_Add(CAD_Num.Sq(CAD_SPlex.dx), CAD_Num.Sq(CAD_SPlex.dy))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_SPlex.aa, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_SPlex.k = 0
        WhileLoop LessThan(CAD_SPlex.k, CAD_Prof.nv) {
            CAD_SPlex.px = ArrayGet(CAD_Prof.vx, CAD_SPlex.k)
            CAD_SPlex.py = ArrayGet(CAD_Prof.vy, CAD_SPlex.k)
            CAD_SPlex.t = Float_Div(CAD_Num.Dot2(Float_Sub(CAD_SPlex.px, CAD_SPlex.x0), Float_Sub(CAD_SPlex.py, CAD_SPlex.y0), CAD_SPlex.dx, CAD_SPlex.dy), CAD_SPlex.aa)
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_SPlex.t), 1) ThenBlock: { CAD_SPlex.t = 0 }
            IfCondition EqualTo(Float_Le(0x3FF0000000000000, CAD_SPlex.t), 1) ThenBlock: { CAD_SPlex.t = 0x3FF0000000000000 }
            CAD_SPlex.bb = Float_Add(CAD_SPlex.x0, CAD_Num.Mul(CAD_SPlex.t, CAD_SPlex.dx))
            CAD_SPlex.cc = Float_Add(CAD_SPlex.y0, CAD_Num.Mul(CAD_SPlex.t, CAD_SPlex.dy))
            IfCondition EqualTo(CAD_Sketch.SketchPlexNear(CAD_SPlex.px, CAD_SPlex.py, CAD_SPlex.bb, CAD_SPlex.cc), 1) ThenBlock: {
                CAD_Sketch.SketchPlexGatherPush()
            }
            CAD_SPlex.k = Add(CAD_SPlex.k, 1)
        }
        CAD_Sketch.SketchPlexGatherSort()
        ReturnValue(CAD_Prof.nw)
    }
}

Function.CAD_Sketch.SketchPlexGatherArc {
    Output: Integer
    Body: {
        CAD_Prof.nw = 0
        CAD_SPlex.cx = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 2))
        CAD_SPlex.cy = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 3))
        CAD_SPlex.r = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 4))
        CAD_SPlex.kind = CAD_Sketch.ProfIRGet(CAD_Prof.e, 0)
        CAD_SPlex.a0 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 6))
        CAD_SPlex.a1 = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 7))
        IfCondition EqualTo(CAD_SPlex.kind, 1) ThenBlock: {
            CAD_SPlex.a0 = 0
            CAD_SPlex.a1 = 0x401921FB54442D18
        }
        CAD_SPlex.span = CAD_Num.PosMod2Pi(Float_Sub(CAD_SPlex.a1, CAD_SPlex.a0))
        IfCondition EqualTo(CAD_SPlex.kind, 2) ThenBlock: {
            CAD_SPlex.cs = CAD_Geom.Cos(CAD_SPlex.a0)
            CAD_SPlex.sn = CAD_Geom.Sin(CAD_SPlex.a0)
            CAD_Prof.px = Float_Add(CAD_SPlex.cx, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.cs))
            CAD_Prof.py = Float_Add(CAD_SPlex.cy, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.sn))
            CAD_SPlex.k = CAD_Sketch.SketchPlexAddVert()
            CAD_SPlex.t = 0
            CAD_Sketch.SketchPlexGatherPush()
            CAD_SPlex.cs = CAD_Geom.Cos(CAD_SPlex.a1)
            CAD_SPlex.sn = CAD_Geom.Sin(CAD_SPlex.a1)
            CAD_Prof.px = Float_Add(CAD_SPlex.cx, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.cs))
            CAD_Prof.py = Float_Add(CAD_SPlex.cy, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.sn))
            CAD_SPlex.k = CAD_Sketch.SketchPlexAddVert()
            CAD_SPlex.t = CAD_SPlex.span
            CAD_Sketch.SketchPlexGatherPush()
        }
        CAD_SPlex.k = 0
        WhileLoop LessThan(CAD_SPlex.k, CAD_Prof.nv) {
            CAD_SPlex.px = ArrayGet(CAD_Prof.vx, CAD_SPlex.k)
            CAD_SPlex.py = ArrayGet(CAD_Prof.vy, CAD_SPlex.k)
            CAD_SPlex.aa = CAD_Num.Abs(Float_Sub(CAD_Num.Hypot2(Float_Sub(CAD_SPlex.px, CAD_SPlex.cx), Float_Sub(CAD_SPlex.py, CAD_SPlex.cy)), CAD_SPlex.r))
            IfCondition EqualTo(Float_Le(CAD_SPlex.aa, 0x3FF0000000000000), 1) ThenBlock: {
                CAD_SPlex.ang = CAD_Geom.Atan2(Float_Sub(CAD_SPlex.py, CAD_SPlex.cy), Float_Sub(CAD_SPlex.px, CAD_SPlex.cx))
                CAD_SPlex.dang = CAD_Num.PosMod2Pi(Float_Sub(CAD_SPlex.ang, CAD_SPlex.a0))
                CAD_SPlex.ok = 0
                IfCondition EqualTo(CAD_SPlex.kind, 1) ThenBlock: { CAD_SPlex.ok = 1 }
                IfCondition EqualTo(CAD_SPlex.kind, 2) ThenBlock: {
                    IfCondition EqualTo(Float_Le(CAD_SPlex.dang, Float_Add(CAD_SPlex.span, 0x3FA999999999999A)), 1) ThenBlock: {
                        CAD_SPlex.ok = 1
                    }
                }
                IfCondition EqualTo(CAD_SPlex.ok, 1) ThenBlock: {
                    CAD_SPlex.t = CAD_SPlex.dang
                    CAD_Sketch.SketchPlexGatherPush()
                }
            }
            CAD_SPlex.k = Add(CAD_SPlex.k, 1)
        }
        CAD_Sketch.SketchPlexGatherSort()
        ReturnValue(CAD_Prof.nw)
    }
}

Function.CAD_Sketch.SketchPlexAllocSeg {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(CAD_SPlex.nseg, 250) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_SPlex.v0, CAD_SPlex.v1) ThenBlock: { ReturnValue(0) }
        CAD_SPlex.nd = Plex.Alloc(Add(CAD_SPlex.kind, 1))
        IfCondition EqualTo(CAD_SPlex.nd, 0) ThenBlock: { ReturnValue(0) }
        CAD_SPlex.x0 = ArrayGet(CAD_Prof.vx, CAD_SPlex.v0)
        CAD_SPlex.y0 = ArrayGet(CAD_Prof.vy, CAD_SPlex.v0)
        CAD_SPlex.x1 = ArrayGet(CAD_Prof.vx, CAD_SPlex.v1)
        CAD_SPlex.y1 = ArrayGet(CAD_Prof.vy, CAD_SPlex.v1)
        Plex.Set(CAD_SPlex.nd, 0, CAD_SPlex.kind)
        Plex.Set(CAD_SPlex.nd, 1, CAD_Prof.e)
        Plex.Set(CAD_SPlex.nd, 2, CAD_SPlex.x0)
        Plex.Set(CAD_SPlex.nd, 3, CAD_SPlex.y0)
        Plex.Set(CAD_SPlex.nd, 4, CAD_SPlex.x1)
        Plex.Set(CAD_SPlex.nd, 5, CAD_SPlex.y1)
        Plex.Set(CAD_SPlex.nd, 6, CAD_SPlex.cx)
        Plex.Set(CAD_SPlex.nd, 7, CAD_SPlex.cy)
        Plex.Set(CAD_SPlex.nd, 8, CAD_SPlex.r)
        Plex.Set(CAD_SPlex.nd, 9, CAD_SPlex.a0)
        Plex.Set(CAD_SPlex.nd, 10, CAD_SPlex.span)
        Plex.Set(CAD_SPlex.nd, 11, 0)
        Plex.Set(CAD_SPlex.nd, 12, CAD_SPlex.v0)
        Plex.Set(CAD_SPlex.nd, 13, CAD_SPlex.v1)
        Plex.Set(CAD_SPlex.nd, 14, CAD_SPlex.ang)
        Plex.Set(CAD_SPlex.nd, 15, CAD_SPlex.dang)
        Plex.RingSingleton(CAD_SPlex.nd, 0)
        IfCondition EqualTo(CAD_SPlex.head, 0) ThenBlock: {
            CAD_SPlex.head = CAD_SPlex.nd
        }
        IfCondition NotEqual(CAD_SPlex.head, 0) ThenBlock: {
            IfCondition NotEqual(CAD_SPlex.head, CAD_SPlex.nd) ThenBlock: {
                Plex.RingInsertAfter(CAD_SPlex.head, CAD_SPlex.nd, 0)
            }
        }
        ArraySet(CAD_SPlex.nodes, CAD_SPlex.nseg, CAD_SPlex.nd)
        CAD_SPlex.nseg = Add(CAD_SPlex.nseg, 1)
        ReturnValue(CAD_SPlex.nd)
    }
}

Function.CAD_Sketch.SketchPlexEmitPair {
    Output: Integer
    Body: {
        CAD_SPlex.v0 = ArrayGet(CAD_Prof.work_v, CAD_SPlex.k)
        CAD_SPlex.v1 = ArrayGet(CAD_Prof.work_v, Add(CAD_SPlex.k, 1))
        IfCondition EqualTo(CAD_SPlex.kind, 0) ThenBlock: {
            CAD_SPlex.cx = 0
            CAD_SPlex.cy = 0
            CAD_SPlex.r = 0
            CAD_SPlex.a0 = 0
            CAD_SPlex.span = 0
            CAD_SPlex.ang = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_SPlex.v1), ArrayGet(CAD_Prof.vy, CAD_SPlex.v0)), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_SPlex.v1), ArrayGet(CAD_Prof.vx, CAD_SPlex.v0)))
            CAD_SPlex.dang = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_SPlex.v0), ArrayGet(CAD_Prof.vy, CAD_SPlex.v1)), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_SPlex.v0), ArrayGet(CAD_Prof.vx, CAD_SPlex.v1)))
        }
        IfCondition EqualTo(CAD_SPlex.kind, 2) ThenBlock: {
            CAD_SPlex.a0 = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_SPlex.v0), CAD_SPlex.cy), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_SPlex.v0), CAD_SPlex.cx))
            CAD_SPlex.span = Float_Sub(ArrayGet(CAD_Prof.work_t, Add(CAD_SPlex.k, 1)), ArrayGet(CAD_Prof.work_t, CAD_SPlex.k))
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_SPlex.span), 1) ThenBlock: {
                CAD_SPlex.span = CAD_Num.PosMod2Pi(CAD_SPlex.span)
            }
            CAD_SPlex.a1 = Float_Add(CAD_SPlex.a0, CAD_SPlex.span)
            CAD_SPlex.cs = CAD_Geom.Cos(CAD_SPlex.a0)
            CAD_SPlex.sn = CAD_Geom.Sin(CAD_SPlex.a0)
            CAD_SPlex.ang = CAD_Geom.Atan2(CAD_SPlex.cs, Float_Sub(0, CAD_SPlex.sn))
            CAD_SPlex.cs = CAD_Geom.Cos(CAD_SPlex.a1)
            CAD_SPlex.sn = CAD_Geom.Sin(CAD_SPlex.a1)
            CAD_SPlex.dang = CAD_Geom.Atan2(Float_Sub(0, CAD_SPlex.cs), CAD_SPlex.sn)
        }
        ReturnValue(CAD_Sketch.SketchPlexAllocSeg())
    }
}

Function.CAD_Sketch.SketchPlexChain {
    Output: Integer
    Body: {
        CAD_Prof.e = 0
        WhileLoop LessThan(CAD_Prof.e, CAD_Prof.nent) {
            CAD_SPlex.kind = CAD_Sketch.ProfIRGet(CAD_Prof.e, 0)
            IfCondition EqualTo(CAD_SPlex.kind, 0) ThenBlock: {
                CAD_Sketch.SketchPlexGatherLine()
                CAD_SPlex.k = 0
                WhileLoop LessThan(CAD_SPlex.k, Subtract(CAD_Prof.nw, 1)) {
                    CAD_Sketch.SketchPlexEmitPair()
                    CAD_SPlex.k = Add(CAD_SPlex.k, 1)
                }
            }
            IfCondition EqualTo(CAD_SPlex.kind, 2) ThenBlock: {
                CAD_SPlex.cx = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 2))
                CAD_SPlex.cy = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 3))
                CAD_SPlex.r = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 4))
                CAD_Sketch.SketchPlexGatherArc()
                CAD_SPlex.kind = 2
                CAD_SPlex.k = 0
                WhileLoop LessThan(CAD_SPlex.k, Subtract(CAD_Prof.nw, 1)) {
                    CAD_Sketch.SketchPlexEmitPair()
                    CAD_SPlex.k = Add(CAD_SPlex.k, 1)
                }
            }
            IfCondition EqualTo(CAD_SPlex.kind, 1) ThenBlock: {
                CAD_SPlex.cx = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 2))
                CAD_SPlex.cy = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 3))
                CAD_SPlex.r = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 4))
                CAD_Sketch.SketchPlexGatherArc()
                IfCondition GreaterThan(CAD_Prof.nw, 1) ThenBlock: {
                    ArraySet(CAD_SPlex.circ_used, CAD_Prof.e, 1)
                    CAD_SPlex.kind = 2
                    CAD_SPlex.k = 0
                    WhileLoop LessThan(CAD_SPlex.k, Subtract(CAD_Prof.nw, 1)) {
                        CAD_Sketch.SketchPlexEmitPair()
                        CAD_SPlex.k = Add(CAD_SPlex.k, 1)
                    }
                    // wrap last→first only for a true CIRCLE (both ways around the rim)
                    CAD_SPlex.k = Subtract(CAD_Prof.nw, 1)
                    CAD_SPlex.v0 = ArrayGet(CAD_Prof.work_v, CAD_SPlex.k)
                    CAD_SPlex.v1 = ArrayGet(CAD_Prof.work_v, 0)
                    CAD_SPlex.a0 = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_SPlex.v0), CAD_SPlex.cy), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_SPlex.v0), CAD_SPlex.cx))
                    CAD_SPlex.a1 = CAD_Geom.Atan2(Float_Sub(ArrayGet(CAD_Prof.vy, CAD_SPlex.v1), CAD_SPlex.cy), Float_Sub(ArrayGet(CAD_Prof.vx, CAD_SPlex.v1), CAD_SPlex.cx))
                    CAD_SPlex.span = CAD_Num.PosMod2Pi(Float_Sub(CAD_SPlex.a1, CAD_SPlex.a0))
                    CAD_SPlex.cs = CAD_Geom.Cos(CAD_SPlex.a0)
                    CAD_SPlex.sn = CAD_Geom.Sin(CAD_SPlex.a0)
                    CAD_SPlex.ang = CAD_Geom.Atan2(CAD_SPlex.cs, Float_Sub(0, CAD_SPlex.sn))
                    CAD_SPlex.cs = CAD_Geom.Cos(CAD_SPlex.a1)
                    CAD_SPlex.sn = CAD_Geom.Sin(CAD_SPlex.a1)
                    CAD_SPlex.dang = CAD_Geom.Atan2(Float_Sub(0, CAD_SPlex.cs), CAD_SPlex.sn)
                    CAD_Sketch.SketchPlexAllocSeg()
                }
            }
            CAD_Prof.e = Add(CAD_Prof.e, 1)
        }
        ReturnValue(CAD_SPlex.nseg)
    }
}

// Left-face next: at dest, smallest positive CCW from the reverse incoming.
Function.CAD_Sketch.SketchPlexNext {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_SPlex.crev, 0) ThenBlock: {
            CAD_SPlex.dest = Plex.Get(CAD_SPlex.cur, 13)
            CAD_SPlex.twin_ang = Plex.Get(CAD_SPlex.cur, 15)
        }
        IfCondition NotEqual(CAD_SPlex.crev, 0) ThenBlock: {
            CAD_SPlex.dest = Plex.Get(CAD_SPlex.cur, 12)
            CAD_SPlex.twin_ang = Plex.Get(CAD_SPlex.cur, 14)
        }
        CAD_SPlex.nxt = 0
        CAD_SPlex.nrev = 0
        CAD_SPlex.best = 0x401921FB54442D18
        CAD_SPlex.i = 0
        WhileLoop LessThan(CAD_SPlex.i, CAD_SPlex.nseg) {
            CAD_SPlex.nd = ArrayGet(CAD_SPlex.nodes, CAD_SPlex.i)
            IfCondition EqualTo(Plex.Get(CAD_SPlex.nd, 12), CAD_SPlex.dest) ThenBlock: {
                CAD_SPlex.hi = 1
                IfCondition EqualTo(CAD_SPlex.nd, CAD_SPlex.cur) ThenBlock: {
                    IfCondition EqualTo(CAD_SPlex.crev, 1) ThenBlock: { CAD_SPlex.hi = 0 }
                }
                IfCondition EqualTo(CAD_SPlex.hi, 1) ThenBlock: {
                    CAD_SPlex.cand_ang = Plex.Get(CAD_SPlex.nd, 14)
                    CAD_SPlex.dang = Float_Sub(CAD_SPlex.cand_ang, CAD_SPlex.twin_ang)
                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_SPlex.dang), 1) ThenBlock: {
                        CAD_SPlex.dang = Float_Add(CAD_SPlex.dang, 0x401921FB54442D18)
                    }
                    IfCondition EqualTo(CAD_Num.IsZero(CAD_SPlex.dang, 0), 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_SPlex.dang, CAD_SPlex.best), 1) ThenBlock: {
                            CAD_SPlex.best = CAD_SPlex.dang
                            CAD_SPlex.nxt = CAD_SPlex.nd
                            CAD_SPlex.nrev = 0
                        }
                    }
                }
            }
            IfCondition EqualTo(Plex.Get(CAD_SPlex.nd, 13), CAD_SPlex.dest) ThenBlock: {
                CAD_SPlex.hi = 1
                IfCondition EqualTo(CAD_SPlex.nd, CAD_SPlex.cur) ThenBlock: {
                    IfCondition EqualTo(CAD_SPlex.crev, 0) ThenBlock: { CAD_SPlex.hi = 0 }
                }
                IfCondition EqualTo(CAD_SPlex.hi, 1) ThenBlock: {
                    CAD_SPlex.cand_ang = Plex.Get(CAD_SPlex.nd, 15)
                    CAD_SPlex.dang = Float_Sub(CAD_SPlex.cand_ang, CAD_SPlex.twin_ang)
                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_SPlex.dang), 1) ThenBlock: {
                        CAD_SPlex.dang = Float_Add(CAD_SPlex.dang, 0x401921FB54442D18)
                    }
                    IfCondition EqualTo(CAD_Num.IsZero(CAD_SPlex.dang, 0), 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_SPlex.dang, CAD_SPlex.best), 1) ThenBlock: {
                            CAD_SPlex.best = CAD_SPlex.dang
                            CAD_SPlex.nxt = CAD_SPlex.nd
                            CAD_SPlex.nrev = 1
                        }
                    }
                }
            }
            CAD_SPlex.i = Add(CAD_SPlex.i, 1)
        }
        ReturnValue(CAD_SPlex.nxt)
    }
}

Function.CAD_Sketch.SketchPlexMarkDir {
    Input: nd: Integer
    Input: rev: Integer
    Input: on: Integer
    Output: Integer
    Body: {
        CAD_SPlex.used = Plex.Get(nd, 11)
        IfCondition EqualTo(on, 1) ThenBlock: {
            IfCondition EqualTo(rev, 0) ThenBlock: {
                Plex.Set(nd, 11, BitwiseOr(CAD_SPlex.used, 1))
            }
            IfCondition NotEqual(rev, 0) ThenBlock: {
                Plex.Set(nd, 11, BitwiseOr(CAD_SPlex.used, 2))
            }
        }
        IfCondition EqualTo(on, 0) ThenBlock: {
            IfCondition EqualTo(rev, 0) ThenBlock: {
                Plex.Set(nd, 11, BitwiseAnd(CAD_SPlex.used, 2))
            }
            IfCondition NotEqual(rev, 0) ThenBlock: {
                Plex.Set(nd, 11, BitwiseAnd(CAD_SPlex.used, 1))
            }
        }
        ReturnValue(1)
    }
}

Function.CAD_Sketch.SketchPlexSample {
    Output: Integer
    Body: {
        CAD_Prof.nn = 0
        CAD_SPlex.k = 0
        WhileLoop LessThan(CAD_SPlex.k, CAD_SPlex.npath) {
            CAD_SPlex.nd = ArrayGet(CAD_SPlex.path_nd, CAD_SPlex.k)
            CAD_SPlex.crev = ArrayGet(CAD_SPlex.path_rev, CAD_SPlex.k)
            CAD_SPlex.kind = Plex.Get(CAD_SPlex.nd, 0)
            IfCondition EqualTo(CAD_SPlex.kind, 0) ThenBlock: {
                IfCondition LessThan(CAD_Prof.nn, 1000) ThenBlock: {
                    IfCondition EqualTo(CAD_SPlex.crev, 0) ThenBlock: {
                        ArraySet(CAD_Prof.samp, Multiply(CAD_Prof.nn, 2), Plex.Get(CAD_SPlex.nd, 2))
                        ArraySet(CAD_Prof.samp, Add(Multiply(CAD_Prof.nn, 2), 1), Plex.Get(CAD_SPlex.nd, 3))
                    }
                    IfCondition NotEqual(CAD_SPlex.crev, 0) ThenBlock: {
                        ArraySet(CAD_Prof.samp, Multiply(CAD_Prof.nn, 2), Plex.Get(CAD_SPlex.nd, 4))
                        ArraySet(CAD_Prof.samp, Add(Multiply(CAD_Prof.nn, 2), 1), Plex.Get(CAD_SPlex.nd, 5))
                    }
                    CAD_Prof.nn = Add(CAD_Prof.nn, 1)
                }
            }
            IfCondition EqualTo(CAD_SPlex.kind, 2) ThenBlock: {
                CAD_SPlex.cx = Plex.Get(CAD_SPlex.nd, 6)
                CAD_SPlex.cy = Plex.Get(CAD_SPlex.nd, 7)
                CAD_SPlex.r = Plex.Get(CAD_SPlex.nd, 8)
                CAD_SPlex.a0 = Plex.Get(CAD_SPlex.nd, 9)
                CAD_SPlex.span = Plex.Get(CAD_SPlex.nd, 10)
                IfCondition NotEqual(CAD_SPlex.crev, 0) ThenBlock: {
                    CAD_SPlex.a0 = Float_Add(CAD_SPlex.a0, CAD_SPlex.span)
                    CAD_SPlex.span = Float_Sub(0, CAD_SPlex.span)
                }
                CAD_SPlex.hi = 0
                WhileLoop LessThan(CAD_SPlex.hi, 16) {
                    IfCondition LessThan(CAD_Prof.nn, 1000) ThenBlock: {
                        CAD_SPlex.t = Float_Div(Float_FromInt(CAD_SPlex.hi), 0x4030000000000000)
                        CAD_SPlex.ang = Float_Add(CAD_SPlex.a0, CAD_Num.Mul(CAD_SPlex.span, CAD_SPlex.t))
                        CAD_SPlex.cs = CAD_Geom.Cos(CAD_SPlex.ang)
                        CAD_SPlex.sn = CAD_Geom.Sin(CAD_SPlex.ang)
                        ArraySet(CAD_Prof.samp, Multiply(CAD_Prof.nn, 2), Float_Add(CAD_SPlex.cx, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.cs)))
                        ArraySet(CAD_Prof.samp, Add(Multiply(CAD_Prof.nn, 2), 1), Float_Add(CAD_SPlex.cy, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.sn)))
                        CAD_Prof.nn = Add(CAD_Prof.nn, 1)
                    }
                    CAD_SPlex.hi = Add(CAD_SPlex.hi, 1)
                }
            }
            CAD_SPlex.k = Add(CAD_SPlex.k, 1)
        }
        ReturnValue(CAD_Prof.nn)
    }
}

Function.CAD_Sketch.SketchPlexWalkOne {
    Output: Integer
    Body: {
        CAD_SPlex.npath = 0
        CAD_SPlex.start_nd = CAD_SPlex.cur
        CAD_SPlex.start_rev = CAD_SPlex.crev
        CAD_SPlex.ok = 0
        CAD_SPlex.j = 0
        WhileLoop LessThan(CAD_SPlex.j, 128) {
            CAD_Sketch.SketchPlexMarkDir(CAD_SPlex.cur, CAD_SPlex.crev, 1)
            ArraySet(CAD_SPlex.path_nd, CAD_SPlex.npath, CAD_SPlex.cur)
            ArraySet(CAD_SPlex.path_rev, CAD_SPlex.npath, CAD_SPlex.crev)
            CAD_SPlex.npath = Add(CAD_SPlex.npath, 1)
            CAD_Sketch.SketchPlexNext()
            CAD_SPlex.ok = 0
            IfCondition EqualTo(CAD_SPlex.nxt, CAD_SPlex.start_nd) ThenBlock: {
                IfCondition EqualTo(CAD_SPlex.nrev, CAD_SPlex.start_rev) ThenBlock: {
                    CAD_SPlex.ok = 1
                    CAD_SPlex.j = 128
                }
            }
            IfCondition EqualTo(CAD_SPlex.ok, 0) ThenBlock: {
                IfCondition EqualTo(CAD_SPlex.nxt, 0) ThenBlock: { CAD_SPlex.j = 128 }
                IfCondition NotEqual(CAD_SPlex.nxt, 0) ThenBlock: {
                    CAD_SPlex.used = Plex.Get(CAD_SPlex.nxt, 11)
                    CAD_SPlex.hi = 0
                    IfCondition EqualTo(CAD_SPlex.nrev, 0) ThenBlock: {
                        IfCondition NotEqual(BitwiseAnd(CAD_SPlex.used, 1), 0) ThenBlock: { CAD_SPlex.hi = 1 }
                    }
                    IfCondition NotEqual(CAD_SPlex.nrev, 0) ThenBlock: {
                        IfCondition NotEqual(BitwiseAnd(CAD_SPlex.used, 2), 0) ThenBlock: { CAD_SPlex.hi = 1 }
                    }
                    IfCondition EqualTo(CAD_SPlex.hi, 1) ThenBlock: { CAD_SPlex.j = 128 }
                    IfCondition EqualTo(CAD_SPlex.hi, 0) ThenBlock: {
                        CAD_SPlex.cur = CAD_SPlex.nxt
                        CAD_SPlex.crev = CAD_SPlex.nrev
                    }
                }
            }
            CAD_SPlex.j = Add(CAD_SPlex.j, 1)
        }
        IfCondition EqualTo(CAD_SPlex.ok, 0) ThenBlock: {
            IfCondition GreaterEqual(CAD_SPlex.npath, 2) ThenBlock: {
                CAD_SPlex.nd = ArrayGet(CAD_SPlex.path_nd, Subtract(CAD_SPlex.npath, 1))
                CAD_SPlex.crev = ArrayGet(CAD_SPlex.path_rev, Subtract(CAD_SPlex.npath, 1))
                IfCondition EqualTo(CAD_SPlex.crev, 0) ThenBlock: { CAD_SPlex.dest = Plex.Get(CAD_SPlex.nd, 13) }
                IfCondition NotEqual(CAD_SPlex.crev, 0) ThenBlock: { CAD_SPlex.dest = Plex.Get(CAD_SPlex.nd, 12) }
                CAD_SPlex.nd = ArrayGet(CAD_SPlex.path_nd, 0)
                CAD_SPlex.crev = ArrayGet(CAD_SPlex.path_rev, 0)
                IfCondition EqualTo(CAD_SPlex.crev, 0) ThenBlock: { CAD_SPlex.v0 = Plex.Get(CAD_SPlex.nd, 12) }
                IfCondition NotEqual(CAD_SPlex.crev, 0) ThenBlock: { CAD_SPlex.v0 = Plex.Get(CAD_SPlex.nd, 13) }
                IfCondition EqualTo(CAD_SPlex.dest, CAD_SPlex.v0) ThenBlock: { CAD_SPlex.ok = 1 }
            }
        }
        IfCondition EqualTo(CAD_SPlex.ok, 0) ThenBlock: {
            CAD_SPlex.k = 1
            WhileLoop LessThan(CAD_SPlex.k, CAD_SPlex.npath) {
                CAD_Sketch.SketchPlexMarkDir(ArrayGet(CAD_SPlex.path_nd, CAD_SPlex.k), ArrayGet(CAD_SPlex.path_rev, CAD_SPlex.k), 0)
                CAD_SPlex.k = Add(CAD_SPlex.k, 1)
            }
            ReturnValue(0)
        }
        IfCondition LessThan(CAD_SPlex.npath, 1) ThenBlock: { ReturnValue(0) }
        // 2-edge lunette (arc+chord) paints a 16-gon disk. Major-arc glued
        // onto a polygon is the same blob. Pacman is npath=3 + major: keep.
        CAD_SPlex.span = 0
        CAD_SPlex.k = 0
        WhileLoop LessThan(CAD_SPlex.k, CAD_SPlex.npath) {
            CAD_SPlex.nd = ArrayGet(CAD_SPlex.path_nd, CAD_SPlex.k)
            IfCondition EqualTo(Plex.Get(CAD_SPlex.nd, 0), 2) ThenBlock: {
                CAD_SPlex.aa = CAD_Num.PosMod2Pi(Plex.Get(CAD_SPlex.nd, 10))
                IfCondition EqualTo(Float_Le(CAD_SPlex.aa, CAD_SPlex.span), 0) ThenBlock: {
                    CAD_SPlex.span = CAD_SPlex.aa
                }
            }
            CAD_SPlex.k = Add(CAD_SPlex.k, 1)
        }
        CAD_SPlex.dup = 0
        IfCondition LessThan(CAD_SPlex.npath, 3) ThenBlock: { CAD_SPlex.dup = 1 }
        IfCondition GreaterThan(CAD_SPlex.npath, 3) ThenBlock: {
            IfCondition EqualTo(Float_Le(CAD_SPlex.span, 0x400921FB54442D18), 0) ThenBlock: {
                CAD_SPlex.dup = 1
            }
        }
        IfCondition EqualTo(CAD_SPlex.dup, 1) ThenBlock: {
            CAD_SPlex.k = 0
            WhileLoop LessThan(CAD_SPlex.k, CAD_SPlex.npath) {
                CAD_Sketch.SketchPlexMarkDir(ArrayGet(CAD_SPlex.path_nd, CAD_SPlex.k), ArrayGet(CAD_SPlex.path_rev, CAD_SPlex.k), 0)
                CAD_SPlex.k = Add(CAD_SPlex.k, 1)
            }
            ReturnValue(0)
        }
        CAD_Sketch.SketchPlexSample()
        CAD_Sketch.ProfIRRingArea()
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Prof.area, 0), 1) ThenBlock: {
            CAD_SPlex.k = 1
            WhileLoop LessThan(CAD_SPlex.k, CAD_SPlex.npath) {
                CAD_Sketch.SketchPlexMarkDir(ArrayGet(CAD_SPlex.path_nd, CAD_SPlex.k), ArrayGet(CAD_SPlex.path_rev, CAD_SPlex.k), 0)
                CAD_SPlex.k = Add(CAD_SPlex.k, 1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Prof.area), 1) ThenBlock: {
            CAD_Sketch.ProfIRReverseSamp()
            CAD_Sketch.ProfIRRingArea()
            CAD_SPlex.k = 0
            CAD_SPlex.j = Subtract(CAD_SPlex.npath, 1)
            WhileLoop LessThan(CAD_SPlex.k, CAD_SPlex.j) {
                CAD_SPlex.nd = ArrayGet(CAD_SPlex.path_nd, CAD_SPlex.k)
                CAD_SPlex.crev = ArrayGet(CAD_SPlex.path_rev, CAD_SPlex.k)
                ArraySet(CAD_SPlex.path_nd, CAD_SPlex.k, ArrayGet(CAD_SPlex.path_nd, CAD_SPlex.j))
                ArraySet(CAD_SPlex.path_rev, CAD_SPlex.k, ArrayGet(CAD_SPlex.path_rev, CAD_SPlex.j))
                ArraySet(CAD_SPlex.path_nd, CAD_SPlex.j, CAD_SPlex.nd)
                ArraySet(CAD_SPlex.path_rev, CAD_SPlex.j, CAD_SPlex.crev)
                CAD_SPlex.k = Add(CAD_SPlex.k, 1)
                CAD_SPlex.j = Subtract(CAD_SPlex.j, 1)
            }
            CAD_SPlex.k = 0
            WhileLoop LessThan(CAD_SPlex.k, CAD_SPlex.npath) {
                CAD_SPlex.crev = ArrayGet(CAD_SPlex.path_rev, CAD_SPlex.k)
                IfCondition EqualTo(CAD_SPlex.crev, 0) ThenBlock: {
                    ArraySet(CAD_SPlex.path_rev, CAD_SPlex.k, 1)
                }
                IfCondition NotEqual(CAD_SPlex.crev, 0) ThenBlock: {
                    ArraySet(CAD_SPlex.path_rev, CAD_SPlex.k, 0)
                }
                CAD_SPlex.k = Add(CAD_SPlex.k, 1)
            }
        }
        CAD_SPlex.dup = 0
        CAD_SPlex.k = 0
        WhileLoop LessThan(CAD_SPlex.k, CAD_SPlex.nemit) {
            IfCondition EqualTo(ArrayGet(CAD_SPlex.emit_nn, CAD_SPlex.k), CAD_Prof.nn) ThenBlock: {
                CAD_SPlex.aa = CAD_Num.Abs(Float_Sub(ArrayGet(CAD_SPlex.emit_ar, CAD_SPlex.k), CAD_Prof.area))
                IfCondition EqualTo(Float_Le(CAD_SPlex.aa, 0x3FF0000000000000), 1) ThenBlock: { CAD_SPlex.dup = 1 }
            }
            CAD_SPlex.k = Add(CAD_SPlex.k, 1)
        }
        IfCondition EqualTo(CAD_SPlex.dup, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CAD_SPlex.nemit, 64) ThenBlock: {
            ArraySet(CAD_SPlex.emit_nn, CAD_SPlex.nemit, CAD_Prof.nn)
            ArraySet(CAD_SPlex.emit_ar, CAD_SPlex.nemit, CAD_Prof.area)
            CAD_SPlex.nemit = Add(CAD_SPlex.nemit, 1)
        }
        CAD_Sketch.ProfIREmitRing()
        CAD_SPlex.n = Subtract(CAD_Store.Read(CAD_Prof.sk, 12), 1)
        IfCondition GreaterEqual(CAD_SPlex.n, 0) ThenBlock: {
            IfCondition LessThan(CAD_SPlex.n, 64) ThenBlock: {
                ArraySet(CAD_SPlex.prof_off, CAD_SPlex.n, CAD_SPlex.pack_n)
                ArraySet(CAD_SPlex.prof_len, CAD_SPlex.n, CAD_SPlex.npath)
                CAD_SPlex.k = 0
                WhileLoop LessThan(CAD_SPlex.k, CAD_SPlex.npath) {
                    IfCondition LessThan(CAD_SPlex.pack_n, 2048) ThenBlock: {
                        ArraySet(CAD_SPlex.pack_nd, CAD_SPlex.pack_n, ArrayGet(CAD_SPlex.path_nd, CAD_SPlex.k))
                        ArraySet(CAD_SPlex.pack_rev, CAD_SPlex.pack_n, ArrayGet(CAD_SPlex.path_rev, CAD_SPlex.k))
                        CAD_SPlex.pack_n = Add(CAD_SPlex.pack_n, 1)
                    }
                    CAD_SPlex.k = Add(CAD_SPlex.k, 1)
                }
            }
        }
        ReturnValue(1)
    }
}

Function.CAD_Sketch.SketchPlexPathCount {
    Input: prof_i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_SPlex.init, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(prof_i, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(prof_i, 64) ThenBlock: { ReturnValue(0) }
        ReturnValue(ArrayGet(CAD_SPlex.prof_len, prof_i))
    }
}

// Load segment k of profile pi into CAD_SPlex x0..a1. Returns kind 0/2, or -1.
Function.CAD_Sketch.SketchPlexPathSeg {
    Input: prof_i: Integer
    Input: k: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_SPlex.init, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        IfCondition LessThan(prof_i, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        IfCondition GreaterEqual(prof_i, 64) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        CAD_SPlex.n = ArrayGet(CAD_SPlex.prof_len, prof_i)
        IfCondition GreaterEqual(k, CAD_SPlex.n) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        CAD_SPlex.nd = ArrayGet(CAD_SPlex.pack_nd, Add(ArrayGet(CAD_SPlex.prof_off, prof_i), k))
        CAD_SPlex.crev = ArrayGet(CAD_SPlex.pack_rev, Add(ArrayGet(CAD_SPlex.prof_off, prof_i), k))
        CAD_SPlex.kind = Plex.Get(CAD_SPlex.nd, 0)
        CAD_SPlex.cx = Plex.Get(CAD_SPlex.nd, 6)
        CAD_SPlex.cy = Plex.Get(CAD_SPlex.nd, 7)
        CAD_SPlex.r = Plex.Get(CAD_SPlex.nd, 8)
        CAD_SPlex.a0 = Plex.Get(CAD_SPlex.nd, 9)
        CAD_SPlex.span = Plex.Get(CAD_SPlex.nd, 10)
        IfCondition EqualTo(CAD_SPlex.crev, 0) ThenBlock: {
            CAD_SPlex.x0 = Plex.Get(CAD_SPlex.nd, 2)
            CAD_SPlex.y0 = Plex.Get(CAD_SPlex.nd, 3)
            CAD_SPlex.x1 = Plex.Get(CAD_SPlex.nd, 4)
            CAD_SPlex.y1 = Plex.Get(CAD_SPlex.nd, 5)
            CAD_SPlex.a1 = Float_Add(CAD_SPlex.a0, CAD_SPlex.span)
        }
        IfCondition NotEqual(CAD_SPlex.crev, 0) ThenBlock: {
            CAD_SPlex.x0 = Plex.Get(CAD_SPlex.nd, 4)
            CAD_SPlex.y0 = Plex.Get(CAD_SPlex.nd, 5)
            CAD_SPlex.x1 = Plex.Get(CAD_SPlex.nd, 2)
            CAD_SPlex.y1 = Plex.Get(CAD_SPlex.nd, 3)
            CAD_SPlex.a1 = CAD_SPlex.a0
            CAD_SPlex.a0 = Float_Add(CAD_SPlex.a0, CAD_SPlex.span)
        }
        ReturnValue(CAD_SPlex.kind)
    }
}

Function.CAD_Sketch.SketchPlexWalk {
    Output: Integer
    Body: {
        CAD_Store.Write(CAD_Prof.sk, 12, 0)
        CAD_Prof.nprof = 0
        CAD_SPlex.n = 0
        WhileLoop LessThan(CAD_SPlex.n, CAD_SPlex.nseg) {
            CAD_SPlex.nd = ArrayGet(CAD_SPlex.nodes, CAD_SPlex.n)
            CAD_SPlex.used = Plex.Get(CAD_SPlex.nd, 11)
            IfCondition EqualTo(BitwiseAnd(CAD_SPlex.used, 1), 0) ThenBlock: {
                CAD_SPlex.cur = CAD_SPlex.nd
                CAD_SPlex.crev = 0
                CAD_Sketch.SketchPlexWalkOne()
            }
            CAD_SPlex.used = Plex.Get(CAD_SPlex.nd, 11)
            IfCondition EqualTo(BitwiseAnd(CAD_SPlex.used, 2), 0) ThenBlock: {
                CAD_SPlex.cur = CAD_SPlex.nd
                CAD_SPlex.crev = 1
                CAD_Sketch.SketchPlexWalkOne()
            }
            CAD_SPlex.n = Add(CAD_SPlex.n, 1)
        }
        ReturnValue(CAD_Store.Read(CAD_Prof.sk, 12))
    }
}

Function.CAD_Sketch.SketchPlexEmitCircle {
    Output: Integer
    Body: {
        CAD_SPlex.cx = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 2))
        CAD_SPlex.cy = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 3))
        CAD_SPlex.r = ArrayGet(CAD_Prof.slab, Add(Multiply(CAD_Prof.e, 12), 4))
        CAD_Prof.nn = 0
        CAD_SPlex.hi = 0
        WhileLoop LessThan(CAD_SPlex.hi, 32) {
            CAD_SPlex.ang = Float_Div(CAD_Num.Mul(Float_FromInt(CAD_SPlex.hi), 0x401921FB54442D18), 0x4040000000000000)
            CAD_SPlex.cs = CAD_Geom.Cos(CAD_SPlex.ang)
            CAD_SPlex.sn = CAD_Geom.Sin(CAD_SPlex.ang)
            ArraySet(CAD_Prof.samp, Multiply(CAD_Prof.nn, 2), Float_Add(CAD_SPlex.cx, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.cs)))
            ArraySet(CAD_Prof.samp, Add(Multiply(CAD_Prof.nn, 2), 1), Float_Add(CAD_SPlex.cy, CAD_Num.Mul(CAD_SPlex.r, CAD_SPlex.sn)))
            CAD_Prof.nn = Add(CAD_Prof.nn, 1)
            CAD_SPlex.hi = Add(CAD_SPlex.hi, 1)
        }
        ReturnValue(CAD_Sketch.ProfIREmitRing())
    }
}

Function.CAD_Sketch.SketchPlexSolve {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Sketch.SketchPlexReset(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Sketch.ProfParse(sketch_handle), 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Prof.sk, 12, 0)
        CAD_Prof.nprof = 0
        CAD_Sketch.SketchPlexSeedEnds()
        CAD_Sketch.SketchPlexHits()
        CAD_Sketch.SketchPlexChain()
        CAD_Sketch.SketchPlexWalk()
        CAD_Prof.e = 0
        WhileLoop LessThan(CAD_Prof.e, CAD_Prof.nent) {
            IfCondition EqualTo(CAD_Sketch.ProfIRGet(CAD_Prof.e, 0), 1) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CAD_SPlex.circ_used, CAD_Prof.e), 0) ThenBlock: {
                    CAD_Sketch.SketchPlexEmitCircle()
                }
            }
            CAD_Prof.e = Add(CAD_Prof.e, 1)
        }
        ReturnValue(CAD_Store.Read(CAD_Prof.sk, 12))
    }
}

Function.CAD_Sketch.ProfCompile {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Sketch.SketchPlexSolve(sketch_handle))
    }
}
