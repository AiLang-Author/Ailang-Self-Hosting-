LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Sketch.SnapNearEndpoints {
    Input: sketch_handle: Integer
    Input: tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition LessThan(nl, 1) ThenBlock: { ReturnValue(0) }
        lines = CAD_Store.Read(sketch_handle, 1)
        // absolute tip weld when tol_r=0 — NOT % of sketch box
        tol = tol_r
        IfCondition EqualTo(tol, 0) ThenBlock: {
            tol = 0x3FA999999999999A
        }
        tol2 = Float_Mul(tol, tol)
        // valence of each endpoint
        npts = Multiply(nl, 2)
        val = Allocate(2048)
        i = 0
        WhileLoop LessThan(i, npts) {
            ArraySet(val, i, 0)
            i = Add(i, 1)
        }
        // meet radius for "already joined" — tighter than snap
        meet2 = Float_Mul(tol2, 0x3F847AE147AE147B)
        i = 0
        WhileLoop LessThan(i, npts) {
            li = Divide(i, 2)
            ei = Subtract(i, Multiply(li, 2))
            bi = Multiply(li, 4)
            IfCondition EqualTo(ei, 0) ThenBlock: {
                ix = ArrayGet(lines, bi)
                iy = ArrayGet(lines, Add(bi, 1))
            }
            IfCondition EqualTo(ei, 1) ThenBlock: {
                ix = ArrayGet(lines, Add(bi, 2))
                iy = ArrayGet(lines, Add(bi, 3))
            }
            j = 0
            WhileLoop LessThan(j, npts) {
                IfCondition NotEqual(j, i) ThenBlock: {
                    lj = Divide(j, 2)
                    ej = Subtract(j, Multiply(lj, 2))
                    bj = Multiply(lj, 4)
                    IfCondition EqualTo(ej, 0) ThenBlock: {
                        jx = ArrayGet(lines, bj)
                        jy = ArrayGet(lines, Add(bj, 1))
                    }
                    IfCondition EqualTo(ej, 1) ThenBlock: {
                        jx = ArrayGet(lines, Add(bj, 2))
                        jy = ArrayGet(lines, Add(bj, 3))
                    }
                    ddx = Float_Sub(ix, jx)
                    ddy = Float_Sub(iy, jy)
                    d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                    IfCondition EqualTo(Float_Le(d2, meet2), 1) ThenBlock: {
                        ArraySet(val, i, Add(ArrayGet(val, i), 1))
                    }
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        nsnap = 0
        // only snap dangling endpoints (val==0 means no neighbor at meet tol)
        i = 0
        WhileLoop LessThan(i, npts) {
            IfCondition EqualTo(ArrayGet(val, i), 0) ThenBlock: {
                li = Divide(i, 2)
                ei = Subtract(i, Multiply(li, 2))
                bi = Multiply(li, 4)
                ax0 = ArrayGet(lines, bi)
                ay0 = ArrayGet(lines, Add(bi, 1))
                ax1 = ArrayGet(lines, Add(bi, 2))
                ay1 = ArrayGet(lines, Add(bi, 3))
                IfCondition EqualTo(ei, 0) ThenBlock: {
                    ix = ax0
                    iy = ay0
                }
                IfCondition EqualTo(ei, 1) ThenBlock: {
                    ix = ax1
                    iy = ay1
                }
                // own segment length — snap distance must stay << this
                slen = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(ax1, ax0), Float_Sub(ax1, ax0)), Float_Mul(Float_Sub(ay1, ay0), Float_Sub(ay1, ay0))))
                // max snap = min(global tol, 50% of segment length)
                // blocks open-air long welds; still closes freehand near-miss tips
                // 0.5 = 0x3FE0000000000000
                seglim = Float_Mul(slen, 0x3FE0000000000000)
                lim = tol
                IfCondition EqualTo(Float_Le(seglim, tol), 1) ThenBlock: { lim = seglim }
                // tiny segs: still allow a floor so arc/line near-miss can join
                limfloor = 0x3F1A36E2EB1C432D
                IfCondition EqualTo(Float_Le(lim, limfloor), 1) ThenBlock: { lim = limfloor }
                lim2 = Float_Mul(lim, lim)
                best_j = -1
                best_d2 = lim2
                // prefer other dangling tip (freehand end-to-end) over mid-joint
                best_dang = 0
                j = 0
                WhileLoop LessThan(j, npts) {
                    IfCondition NotEqual(j, i) ThenBlock: {
                        lj = Divide(j, 2)
                        // do not snap the other end of the same segment
                        IfCondition NotEqual(lj, li) ThenBlock: {
                            ej = Subtract(j, Multiply(lj, 2))
                            bj = Multiply(lj, 4)
                            IfCondition EqualTo(ej, 0) ThenBlock: {
                                jx = ArrayGet(lines, bj)
                                jy = ArrayGet(lines, Add(bj, 1))
                            }
                            IfCondition EqualTo(ej, 1) ThenBlock: {
                                jx = ArrayGet(lines, Add(bj, 2))
                                jy = ArrayGet(lines, Add(bj, 3))
                            }
                            ddx = Float_Sub(ix, jx)
                            ddy = Float_Sub(iy, jy)
                            d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                            IfCondition EqualTo(Float_Le(d2, lim2), 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.IsZero(d2, 0), 0) ThenBlock: {
                                    jdang = 0
                                    IfCondition EqualTo(ArrayGet(val, j), 0) ThenBlock: { jdang = 1 }
                                    take = 0
                                    IfCondition EqualTo(best_j, -1) ThenBlock: { take = 1 }
                                    // prefer dangling partner
                                    IfCondition EqualTo(jdang, 1) ThenBlock: {
                                        IfCondition EqualTo(best_dang, 0) ThenBlock: { take = 1 }
                                        IfCondition EqualTo(best_dang, 1) ThenBlock: {
                                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: { take = 1 }
                                        }
                                    }
                                    IfCondition EqualTo(jdang, 0) ThenBlock: {
                                        IfCondition EqualTo(best_dang, 0) ThenBlock: {
                                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: { take = 1 }
                                        }
                                    }
                                    IfCondition EqualTo(take, 1) ThenBlock: {
                                        best_d2 = d2
                                        best_j = j
                                        best_dang = jdang
                                    }
                                }
                            }
                        }
                    }
                    j = Add(j, 1)
                }
                IfCondition NotEqual(best_j, -1) ThenBlock: {
                    lj = Divide(best_j, 2)
                    ej = Subtract(best_j, Multiply(lj, 2))
                    bj = Multiply(lj, 4)
                    IfCondition EqualTo(ej, 0) ThenBlock: {
                        tx = ArrayGet(lines, bj)
                        ty = ArrayGet(lines, Add(bj, 1))
                    }
                    IfCondition EqualTo(ej, 1) ThenBlock: {
                        tx = ArrayGet(lines, Add(bj, 2))
                        ty = ArrayGet(lines, Add(bj, 3))
                    }
                    // free→joint: snap free onto joint. free→free: midpoint (fair)
                    IfCondition EqualTo(best_dang, 1) ThenBlock: {
                        tx = Float_Mul(0x3FE0000000000000, Float_Add(ix, tx))
                        ty = Float_Mul(0x3FE0000000000000, Float_Add(iy, ty))
                        // also pull partner tip to midpoint
                        IfCondition EqualTo(ej, 0) ThenBlock: {
                            ArraySet(lines, bj, tx)
                            ArraySet(lines, Add(bj, 1), ty)
                        }
                        IfCondition EqualTo(ej, 1) ThenBlock: {
                            ArraySet(lines, Add(bj, 2), tx)
                            ArraySet(lines, Add(bj, 3), ty)
                        }
                        ArraySet(val, best_j, 1)
                    }
                    IfCondition EqualTo(ei, 0) ThenBlock: {
                        ArraySet(lines, bi, tx)
                        ArraySet(lines, Add(bi, 1), ty)
                    }
                    IfCondition EqualTo(ei, 1) ThenBlock: {
                        ArraySet(lines, Add(bi, 2), tx)
                        ArraySet(lines, Add(bi, 3), ty)
                    }
                    ArraySet(val, i, 1)
                    nsnap = Add(nsnap, 1)
                }
            }
            i = Add(i, 1)
        }
        Deallocate(val, 2048)
        ReturnValue(nsnap)
    }
}

// Build every closed face in the planar line graph.
// Uses directed half-edges (each segment used once per direction) and
// "next CCW from reverse" turns so shared chords (circle×diameters) yield
// multiple faces — not a single greedy Euler path.


// Pull nearby line ends (and mid-line body) onto arc endpoints so face-walk
// and trim share exact UV. Also splits long V-legs when Arc3 hits mid-side.
// tol_r=0 → 1.0 mm default. Returns n welds/splits.
Function.CAD_Sketch.SnapArcEndsToSketch {
    Input: sketch_handle: Integer
    Input: tol_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        na = CAD_Store.Read(sketch_handle, 10)
        IfCondition EqualTo(na, 0) ThenBlock: { ReturnValue(0) }
        arcs = CAD_Store.Read(sketch_handle, 11)
        nl = CAD_Store.Read(sketch_handle, 0)
        lines = CAD_Store.Read(sketch_handle, 1)
        tol = tol_r
        // tol_r=0 → tight default 0.05 (absolute tip weld; was AABB % which
        // yanked random line ends onto arc tips and killed true crossings)
        IfCondition EqualTo(tol, 0) ThenBlock: {
            tol = 0x3FA999999999999A
        }
        tol2 = Float_Mul(tol, tol)
        nweld = 0
        ai = 0
        WhileLoop LessThan(ai, na) {
            // re-read nl each arc (splits grow the list)
            nl = CAD_Store.Read(sketch_handle, 0)
            lines = CAD_Store.Read(sketch_handle, 1)
            base = Multiply(ai, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            e = 0
            WhileLoop LessThan(e, 2) {
                ang = a0
                IfCondition EqualTo(e, 1) ThenBlock: { ang = a1 }
                ex = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang)))
                ey = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang)))
                // 1) nearest line END within tol → pull tip to arc tip
                // sentinel > tol2 so "no end in range" leaves bli unset effectively
                best = Float_Mul(tol2, 0x4010000000000000)
                bli = -1
                ben = 0
                li = 0
                WhileLoop LessThan(li, nl) {
                    b = Multiply(li, 4)
                    en = 0
                    WhileLoop LessThan(en, 2) {
                        IfCondition EqualTo(en, 0) ThenBlock: {
                            lx = ArrayGet(lines, b)
                            ly = ArrayGet(lines, Add(b, 1))
                        }
                        IfCondition EqualTo(en, 1) ThenBlock: {
                            lx = ArrayGet(lines, Add(b, 2))
                            ly = ArrayGet(lines, Add(b, 3))
                        }
                        dx = Float_Sub(lx, ex)
                        dy = Float_Sub(ly, ey)
                        d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                            best = d2
                            bli = li
                            ben = en
                        }
                        en = Add(en, 1)
                    }
                    li = Add(li, 1)
                }
                // only weld if nearest end is inside tol
                IfCondition GreaterEqual(bli, 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(best, tol2), 1) ThenBlock: {
                        CAD_Sketch.SetLineEnd(sketch_handle, bli, ben, ex, ey)
                        nweld = Add(nweld, 1)
                    }
                }
                // 2) if tip near a LINE BODY (not only ends), split the line there
                //    so V-legs gain a vertex at the arc tip (mid-side Arc3 / scoop)
                bestb = tol2
                bli2 = -1
                li = 0
                nl = CAD_Store.Read(sketch_handle, 0)
                lines = CAD_Store.Read(sketch_handle, 1)
                WhileLoop LessThan(li, nl) {
                    b = Multiply(li, 4)
                    x0 = ArrayGet(lines, b)
                    y0 = ArrayGet(lines, Add(b, 1))
                    x1 = ArrayGet(lines, Add(b, 2))
                    y1 = ArrayGet(lines, Add(b, 3))
                    dx = Float_Sub(x1, x0)
                    dy = Float_Sub(y1, y0)
                    aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                        t = Float_Div(Float_Add(Float_Mul(Float_Sub(ex, x0), dx), Float_Mul(Float_Sub(ey, y0), dy)), aa)
                        eps = 0x3F50624DD2F1A9FC
                        one = 0x3FF0000000000000
                        IfCondition EqualTo(Float_Le(t, eps), 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(Float_Sub(one, t), eps), 0) ThenBlock: {
                                qx = Float_Add(x0, Float_Mul(t, dx))
                                qy = Float_Add(y0, Float_Mul(t, dy))
                                ddx = Float_Sub(qx, ex)
                                ddy = Float_Sub(qy, ey)
                                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                                IfCondition EqualTo(Float_Le(d2, bestb), 1) ThenBlock: {
                                    bestb = d2
                                    bli2 = li
                                }
                            }
                        }
                    }
                    li = Add(li, 1)
                }
                IfCondition GreaterEqual(bli2, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Sketch.SplitLineAtXY(sketch_handle, bli2, ex, ey), 1) ThenBlock: {
                        nweld = Add(nweld, 1)
                    }
                }
                // other arc endpoints near this tip → snap their angle to this tip
                // (share exact point by rewriting other arc's a0/a1 from this tip)
                aj = 0
                WhileLoop LessThan(aj, na) {
                    IfCondition NotEqual(aj, ai) ThenBlock: {
                        bj = Multiply(aj, 5)
                        ocx = ArrayGet(arcs, bj)
                        ocy = ArrayGet(arcs, Add(bj, 1))
                        orad = ArrayGet(arcs, Add(bj, 2))
                        oa0 = ArrayGet(arcs, Add(bj, 3))
                        oa1 = ArrayGet(arcs, Add(bj, 4))
                        ee = 0
                        WhileLoop LessThan(ee, 2) {
                            oang = oa0
                            IfCondition EqualTo(ee, 1) ThenBlock: { oang = oa1 }
                            ox = Float_Add(ocx, Float_Mul(orad, CAD_Geom.Cos(oang)))
                            oy = Float_Add(ocy, Float_Mul(orad, CAD_Geom.Sin(oang)))
                            dx = Float_Sub(ox, ex)
                            dy = Float_Sub(oy, ey)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, tol2), 1) ThenBlock: {
                                // project this tip onto other circle → new angle
                                // only if tip is near other rim
                                dcr = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(ex, ocx), Float_Sub(ex, ocx)), Float_Mul(Float_Sub(ey, ocy), Float_Sub(ey, ocy))))
                                dd = Float_Sub(dcr, orad)
                                IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                                IfCondition EqualTo(Float_Le(dd, tol), 1) ThenBlock: {
                                    nang = CAD_Geom.Atan2(Float_Sub(ey, ocy), Float_Sub(ex, ocx))
                                    IfCondition EqualTo(ee, 0) ThenBlock: {
                                        ArraySet(arcs, Add(bj, 3), nang)
                                    }
                                    IfCondition EqualTo(ee, 1) ThenBlock: {
                                        ArraySet(arcs, Add(bj, 4), nang)
                                    }
                                    nweld = Add(nweld, 1)
                                }
                            }
                            ee = Add(ee, 1)
                        }
                    }
                    aj = Add(aj, 1)
                }
                e = Add(e, 1)
            }
            ai = Add(ai, 1)
        }
        ReturnValue(nweld)
    }
}

// Expand arcs into LINE segs. FORCES vertices at every line×arc hit so a
// line drawn through the true arc also meets the polyline (anchors alone
// are not enough — inscribed n-gon chords can miss the real crossings).
// Clears n_arcs after.


// Build every closed face in the planar line graph.
// Uses directed half-edges (each segment used once per direction) and
// "next CCW from reverse" turns so shared chords (circle×diameters) yield
// multiple faces — not a single greedy Euler path.
Function.CAD_Sketch.BuildAllClosedLoops {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        // lower ALL curves into the line graph (arcs and full circles)
        na = CAD_Store.Read(sketch_handle, 10)
        IfCondition GreaterThan(na, 0) ThenBlock: {
            CAD_Sketch.TessellateArcs(sketch_handle, 32)
        }
        nc = CAD_Store.Read(sketch_handle, 7)
        IfCondition GreaterThan(nc, 0) ThenBlock: {
            CAD_Sketch.TessellateCircles(sketch_handle, 32)
            CAD_Store.Write(sketch_handle, 7, 0)
        }
        // weld freehand / arc-end near-misses so prune does not eat the rim
        CAD_Sketch.SnapNearEndpoints(sketch_handle, 0)
        // split at crossings, drop dangling stubs
        CAD_Sketch.SplitAtIntersections(sketch_handle)
        CAD_Sketch.SnapNearEndpoints(sketch_handle, 0)
        CAD_Sketch.PruneOpenStubs(sketch_handle, 0)
        nl = CAD_Store.Read(sketch_handle, 0)
        IfCondition LessThan(nl, 3) ThenBlock: {
            CAD_Store.Write(sketch_handle, 12, 0)
            ReturnValue(0)
        }
        lines = CAD_Store.Read(sketch_handle, 1)
        pool = CAD_Store.Read(sketch_handle, 14)
        pmeta = CAD_Store.Read(sketch_handle, 13)
        cap_p = CAD_Store.Read(sketch_handle, 15)
        // absolute join eps — Jacobian/coincidence path, NOT sketch AABB %
        // tight: numerical merge; free: tip near-miss only (fixed, not box-scaled)
        join_tight = 0x3F50624DD2F1A9FC
        // 0.2 mm — same as live pad; 0.05 dropped a 90° trim Pac-Man
        join_free = 0x3FC999999999999A
        join_tol = join_free
        join_tol2 = Float_Mul(join_free, join_free)
        join_tight2 = Float_Mul(join_tight, join_tight)
        two_pi = 0x401921FB54442D18
        // half-edge use flags: index 2*e+d (d=0 A→B, d=1 B→A)
        // sized for 4096 lines * 2 = 8192 flags
        used = Allocate(65536)
        ui = 0
        WhileLoop LessThan(ui, Multiply(nl, 2)) {
            ArraySet(used, ui, 0)
            ui = Add(ui, 1)
        }
        nprof = 0
        pool_n = 0
        tloop = Allocate(32768)
        was_cw = Allocate(512)
        start_he = 0
        WhileLoop LessThan(start_he, Multiply(nl, 2)) {
            IfCondition EqualTo(ArrayGet(used, start_he), 0) ThenBlock: {
                se = Divide(start_he, 2)
                sd = Subtract(start_he, Multiply(se, 2))
                base = Multiply(se, 4)
                IfCondition EqualTo(sd, 0) ThenBlock: {
                    sx = ArrayGet(lines, base)
                    sy = ArrayGet(lines, Add(base, 1))
                    tipx = ArrayGet(lines, Add(base, 2))
                    tipy = ArrayGet(lines, Add(base, 3))
                }
                IfCondition EqualTo(sd, 1) ThenBlock: {
                    sx = ArrayGet(lines, Add(base, 2))
                    sy = ArrayGet(lines, Add(base, 3))
                    tipx = ArrayGet(lines, base)
                    tipy = ArrayGet(lines, Add(base, 1))
                }
                // temporary mark; rollback if face not saved
                ArraySet(used, start_he, 1)
                ArraySet(tloop, 0, sx)
                ArraySet(tloop, 1, sy)
                ArraySet(tloop, 2, tipx)
                ArraySet(tloop, 3, tipy)
                // path half-edge ids — dense multi-circle faces need >> 256
                path_he = Allocate(16384)
                ArraySet(path_he, 0, start_he)
                nhe = 1
                nn = 2
                prevx = sx
                prevy = sy
                // path length of edges walked (reject "close" if gap is large vs path)
                plen = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(tipx, sx), Float_Sub(tipx, sx)), Float_Mul(Float_Sub(tipy, sy), Float_Sub(tipy, sy))))
                closed = 0
                guard = 0
                // close candidate: absolute tip eps (path-relative checks below)
                close_gate = join_free
                close_gate2 = join_tol2
                WhileLoop LessThan(guard, 4096) {
                    guard = Add(guard, 1)
                    // closed when tip returns to start: need ≥4 verts (3 real edges)
                    ddx = Float_Sub(tipx, sx)
                    ddy = Float_Sub(tipy, sy)
                    d2c = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        IfCondition EqualTo(Float_Le(d2c, close_gate2), 1) ThenBlock: {
                            gap = CAD_Num.Sqrt(d2c)
                            okclose = 0
                            // gap < 2% of path length
                            IfCondition EqualTo(Float_Le(Float_Mul(0x3FA47AE147AE147B, plen), gap), 0) ThenBlock: {
                                // path must be >> gap (not a tiny digon)
                                IfCondition EqualTo(Float_Le(plen, Float_Mul(gap, 0x4034000000000000)), 0) ThenBlock: {
                                    // at least 4 real steps worth of geometry
                                    IfCondition EqualTo(Float_Le(plen, Float_Mul(close_gate, 0x4010000000000000)), 0) ThenBlock: {
                                        okclose = 1
                                    }
                                }
                            }
                            IfCondition EqualTo(okclose, 1) ThenBlock: {
                                ArraySet(tloop, Multiply(Subtract(nn, 1), 2), sx)
                                ArraySet(tloop, Add(Multiply(Subtract(nn, 1), 2), 1), sy)
                                nn = Subtract(nn, 1)
                                closed = 1
                                guard = 99999
                            }
                        }
                    }
                    IfCondition EqualTo(closed, 0) ThenBlock: {
                        IfCondition LessThan(guard, 4096) ThenBlock: {
                            // arrival heading into tip
                            idx = Float_Sub(tipx, prevx)
                            idy = Float_Sub(tipy, prevy)
                            // reverse leave angle (back along arrival)
                            rev_ang = CAD_Geom.Atan2(Float_Sub(0, idy), Float_Sub(0, idx))
                            found_ok = 0
                            found = 0
                            rev = 0
                            // best CCW turn; reverse (δ≈0) is fallback only
                            // tight pass first (tess junctions), freehand pass if none
                            best_delta = two_pi
                            best_d2 = join_tol2
                            fb_ok = 0
                            fb_found = 0
                            fb_rev = 0
                            tight_ok = 0
                            tight_found = 0
                            tight_rev = 0
                            tight_delta = two_pi
                            epsd = 0x3F50624DD2F1A9FC
                            j = 0
                            WhileLoop LessThan(j, nl) {
                                base = Multiply(j, 4)
                                ax = ArrayGet(lines, base)
                                ay = ArrayGet(lines, Add(base, 1))
                                bx = ArrayGet(lines, Add(base, 2))
                                by = ArrayGet(lines, Add(base, 3))
                                // end A at tip → leave toward B (dir 0)
                                ddx = Float_Sub(ax, tipx)
                                ddy = Float_Sub(ay, tipy)
                                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                                IfCondition EqualTo(Float_Le(d2, join_tol2), 1) ThenBlock: {
                                    he = Multiply(j, 2)
                                    IfCondition EqualTo(ArrayGet(used, he), 0) ThenBlock: {
                                        ox = Float_Sub(bx, tipx)
                                        oy = Float_Sub(by, tipy)
                                        oang = CAD_Geom.Atan2(oy, ox)
                                        delta = Float_Sub(oang, rev_ang)
                                        IfCondition EqualTo(Float_Le(delta, 0), 1) ThenBlock: {
                                            delta = Float_Add(delta, two_pi)
                                        }
                                        IfCondition EqualTo(Float_Le(two_pi, delta), 1) ThenBlock: {
                                            delta = Float_Sub(delta, two_pi)
                                        }
                                        IfCondition EqualTo(Float_Le(delta, epsd), 1) ThenBlock: {
                                            IfCondition EqualTo(fb_ok, 0) ThenBlock: {
                                                fb_ok = 1
                                                fb_found = j
                                                fb_rev = 0
                                            }
                                        }
                                        IfCondition EqualTo(Float_Le(delta, epsd), 0) ThenBlock: {
                                            // freehand candidate (best CCW among free range)
                                            IfCondition EqualTo(Float_Le(delta, best_delta), 1) ThenBlock: {
                                                best_delta = delta
                                                found = j
                                                rev = 0
                                                found_ok = 1
                                                best_d2 = d2
                                            }
                                            // tight candidate (prefer exact tess junctions)
                                            IfCondition EqualTo(Float_Le(d2, join_tight2), 1) ThenBlock: {
                                                IfCondition EqualTo(Float_Le(delta, tight_delta), 1) ThenBlock: {
                                                    tight_delta = delta
                                                    tight_found = j
                                                    tight_rev = 0
                                                    tight_ok = 1
                                                }
                                            }
                                        }
                                    }
                                }
                                // end B at tip → leave toward A (dir 1)
                                ddx = Float_Sub(bx, tipx)
                                ddy = Float_Sub(by, tipy)
                                d2 = Float_Add(Float_Mul(ddx, ddx), Float_Mul(ddy, ddy))
                                IfCondition EqualTo(Float_Le(d2, join_tol2), 1) ThenBlock: {
                                    he = Add(Multiply(j, 2), 1)
                                    IfCondition EqualTo(ArrayGet(used, he), 0) ThenBlock: {
                                        ox = Float_Sub(ax, tipx)
                                        oy = Float_Sub(ay, tipy)
                                        oang = CAD_Geom.Atan2(oy, ox)
                                        delta = Float_Sub(oang, rev_ang)
                                        IfCondition EqualTo(Float_Le(delta, 0), 1) ThenBlock: {
                                            delta = Float_Add(delta, two_pi)
                                        }
                                        IfCondition EqualTo(Float_Le(two_pi, delta), 1) ThenBlock: {
                                            delta = Float_Sub(delta, two_pi)
                                        }
                                        IfCondition EqualTo(Float_Le(delta, epsd), 1) ThenBlock: {
                                            IfCondition EqualTo(fb_ok, 0) ThenBlock: {
                                                fb_ok = 1
                                                fb_found = j
                                                fb_rev = 1
                                            }
                                        }
                                        IfCondition EqualTo(Float_Le(delta, epsd), 0) ThenBlock: {
                                            IfCondition EqualTo(Float_Le(delta, best_delta), 1) ThenBlock: {
                                                best_delta = delta
                                                found = j
                                                rev = 1
                                                found_ok = 1
                                                best_d2 = d2
                                            }
                                            IfCondition EqualTo(Float_Le(d2, join_tight2), 1) ThenBlock: {
                                                IfCondition EqualTo(Float_Le(delta, tight_delta), 1) ThenBlock: {
                                                    tight_delta = delta
                                                    tight_found = j
                                                    tight_rev = 1
                                                    tight_ok = 1
                                                }
                                            }
                                        }
                                    }
                                }
                                j = Add(j, 1)
                            }
                            // prefer tight tess junction over freehand near-miss
                            IfCondition EqualTo(tight_ok, 1) ThenBlock: {
                                found_ok = 1
                                found = tight_found
                                rev = tight_rev
                            }
                            // only reverse available
                            IfCondition EqualTo(found_ok, 0) ThenBlock: {
                                IfCondition EqualTo(fb_ok, 1) ThenBlock: {
                                    found_ok = 1
                                    found = fb_found
                                    rev = fb_rev
                                }
                            }
                            IfCondition EqualTo(found_ok, 0) ThenBlock: {
                                // open path — stop this walk
                                guard = 99999
                            }
                            IfCondition EqualTo(found_ok, 1) ThenBlock: {
                                he = Multiply(found, 2)
                                IfCondition EqualTo(rev, 1) ThenBlock: {
                                    he = Add(he, 1)
                                }
                                // temporarily mark so this walk does not re-use
                                ArraySet(used, he, 1)
                                // path_he holds 2048 slots (16384/8)
                                IfCondition LessThan(nhe, 2048) ThenBlock: {
                                    ArraySet(path_he, nhe, he)
                                    nhe = Add(nhe, 1)
                                }
                                base = Multiply(found, 4)
                                prevx = tipx
                                prevy = tipy
                                IfCondition EqualTo(rev, 0) ThenBlock: {
                                    tipx = ArrayGet(lines, Add(base, 2))
                                    tipy = ArrayGet(lines, Add(base, 3))
                                }
                                IfCondition EqualTo(rev, 1) ThenBlock: {
                                    tipx = ArrayGet(lines, base)
                                    tipy = ArrayGet(lines, Add(base, 1))
                                }
                                // tloop holds 2048 xy pairs
                                IfCondition LessThan(nn, 2048) ThenBlock: {
                                    // accumulate path length for close check
                                    plen = Float_Add(plen, CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(tipx, prevx), Float_Sub(tipx, prevx)), Float_Mul(Float_Sub(tipy, prevy), Float_Sub(tipy, prevy)))))
                                    ArraySet(tloop, Multiply(nn, 2), tipx)
                                    ArraySet(tloop, Add(Multiply(nn, 2), 1), tipy)
                                    nn = Add(nn, 1)
                                }
                            }
                        }
                    }
                }
                saved = 0
                IfCondition EqualTo(closed, 1) ThenBlock: {
                    IfCondition GreaterEqual(nn, 3) ThenBlock: {
                        // signed area — keep CCW faces only (drop exterior CW)
                        ar = 0
                        i = 0
                        WhileLoop LessThan(i, nn) {
                            j = Add(i, 1)
                            IfCondition EqualTo(j, nn) ThenBlock: { j = 0 }
                            xi = ArrayGet(tloop, Multiply(i, 2))
                            yi = ArrayGet(tloop, Add(Multiply(i, 2), 1))
                            xj = ArrayGet(tloop, Multiply(j, 2))
                            yj = ArrayGet(tloop, Add(Multiply(j, 2), 1))
                            ar = Float_Add(ar, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
                            i = Add(i, 1)
                        }
                        // Keep every non-zero face for now; post-filter drops exterior.
                        // flip=1 if original winding was CW (ar<0) → reverse to store CCW.
                        keep = 0
                        flip = 0
                        // min area absolute floor (reject zero-area phantom strips)
                        amin = 0x3F50624DD2F1A9FC
                        arn = ar
                        IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { arn = Float_Sub(0, ar) }
                        // perimeter for sliver test
                        peri = 0
                        i = 0
                        WhileLoop LessThan(i, nn) {
                            j = Add(i, 1)
                            IfCondition EqualTo(j, nn) ThenBlock: { j = 0 }
                            xi = ArrayGet(tloop, Multiply(i, 2))
                            yi = ArrayGet(tloop, Add(Multiply(i, 2), 1))
                            xj = ArrayGet(tloop, Multiply(j, 2))
                            yj = ArrayGet(tloop, Add(Multiply(j, 2), 1))
                            peri = Float_Add(peri, CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(xj, xi), Float_Sub(xj, xi)), Float_Mul(Float_Sub(yj, yi), Float_Sub(yj, yi)))))
                            i = Add(i, 1)
                        }
                        // isoperimetric: peri^2 / area huge ⇒ needle/sliver (no real face)
                        // reject if peri^2 > 120 * |ar|  (was 400 — still allowed padfail spikes)
                        // arn = |2*signed_area| from shoelace sum
                        sliver = 0
                        IfCondition EqualTo(Float_Le(arn, amin), 1) ThenBlock: { sliver = 1 }
                        IfCondition EqualTo(sliver, 0) ThenBlock: {
                            // 0x405E000000000000 = 120.0
                            IfCondition EqualTo(Float_Le(Float_Mul(0x405E000000000000, arn), Float_Mul(peri, peri)), 1) ThenBlock: {
                                sliver = 1
                            }
                        }
                        // thin faces with few verts are almost always junction junk
                        IfCondition EqualTo(sliver, 0) ThenBlock: {
                            IfCondition LessThan(nn, 10) ThenBlock: {
                                // peri^2 > 80 * arn
                                IfCondition EqualTo(Float_Le(Float_Mul(0x4054000000000000, arn), Float_Mul(peri, peri)), 1) ThenBlock: {
                                    sliver = 1
                                }
                            }
                        }
                        // long-chord reject only on tiny walks (junction junk).
                        // A sampled half-moon has many verts + a long diameter — that
                        // is a real face, not a phantom weld.
                        IfCondition EqualTo(sliver, 0) ThenBlock: {
                            IfCondition LessThan(nn, 8) ThenBlock: {
                            maxe = 0
                            i = 0
                            WhileLoop LessThan(i, nn) {
                                j = Add(i, 1)
                                IfCondition EqualTo(j, nn) ThenBlock: { j = 0 }
                                xi = ArrayGet(tloop, Multiply(i, 2))
                                yi = ArrayGet(tloop, Add(Multiply(i, 2), 1))
                                xj = ArrayGet(tloop, Multiply(j, 2))
                                yj = ArrayGet(tloop, Add(Multiply(j, 2), 1))
                                el = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(xj, xi), Float_Sub(xj, xi)), Float_Mul(Float_Sub(yj, yi), Float_Sub(yj, yi))))
                                IfCondition EqualTo(Float_Le(maxe, el), 1) ThenBlock: { maxe = el }
                                i = Add(i, 1)
                            }
                            IfCondition EqualTo(Float_Le(Float_Mul(0x3FEF5C28F5C28F5C, peri), maxe), 1) ThenBlock: {
                                sliver = 1
                            }
                            }
                        }
                        IfCondition EqualTo(sliver, 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: {
                                keep = 1
                                flip = 1
                            }
                            IfCondition EqualTo(Float_Le(ar, 0), 0) ThenBlock: {
                                keep = 1
                                flip = 0
                            }
                        }
                        IfCondition EqualTo(keep, 1) ThenBlock: {
                            IfCondition LessThan(nprof, cap_p) ThenBlock: {
                                ArraySet(pmeta, Multiply(nprof, 2), nn)
                                ArraySet(pmeta, Add(Multiply(nprof, 2), 1), pool_n)
                                k = 0
                                WhileLoop LessThan(k, nn) {
                                    src = k
                                    IfCondition EqualTo(flip, 1) ThenBlock: {
                                        src = Subtract(Subtract(nn, 1), k)
                                    }
                                    ArraySet(pool, Multiply(Add(pool_n, k), 2), ArrayGet(tloop, Multiply(src, 2)))
                                    ArraySet(pool, Add(Multiply(Add(pool_n, k), 2), 1), ArrayGet(tloop, Add(Multiply(src, 2), 1)))
                                    k = Add(k, 1)
                                }
                                ArraySet(pmeta, Multiply(nprof, 2), nn)
                                ArraySet(pmeta, Add(Multiply(nprof, 2), 1), pool_n)
                                ArraySet(was_cw, nprof, flip)
                                pool_n = Add(pool_n, nn)
                                nprof = Add(nprof, 1)
                                saved = 1
                            }
                        }
                    }
                }
                // rollback temporary marks if face not saved
                IfCondition EqualTo(saved, 0) ThenBlock: {
                    pi = 0
                    WhileLoop LessThan(pi, nhe) {
                        ArraySet(used, ArrayGet(path_he, pi), 0)
                        pi = Add(pi, 1)
                    }
                }
                Deallocate(path_he, 16384)
            }
            start_he = Add(start_he, 1)
        }
        Deallocate(used, 65536)
        Deallocate(tloop, 32768)
                // Keep CW interiors always. Also keep ONE exterior envelope (was_cw=0)
        // with the most verts when any interiors exist — outer multi-circle silhouette.
        // padfail: n_cw==1 junk triangle dropped outer when use_env required n_cw>1.
        n_cw = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            IfCondition EqualTo(ArrayGet(was_cw, pi), 1) ThenBlock: {
                n_cw = Add(n_cw, 1)
            }
            pi = Add(pi, 1)
        }
        // find best exterior envelope candidate
        env_i = -1
        env_nn = 0
        env_ar = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            IfCondition EqualTo(ArrayGet(was_cw, pi), 0) ThenBlock: {
                pn = ArrayGet(pmeta, Multiply(pi, 2))
                po = ArrayGet(pmeta, Add(Multiply(pi, 2), 1))
                ar = 0
                i = 0
                WhileLoop LessThan(i, pn) {
                    j = Add(i, 1)
                    IfCondition EqualTo(j, pn) ThenBlock: { j = 0 }
                    xi = ArrayGet(pool, Multiply(Add(po, i), 2))
                    yi = ArrayGet(pool, Add(Multiply(Add(po, i), 2), 1))
                    xj = ArrayGet(pool, Multiply(Add(po, j), 2))
                    yj = ArrayGet(pool, Add(Multiply(Add(po, j), 2), 1))
                    ar = Float_Add(ar, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
                    i = Add(i, 1)
                }
                IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                // prefer more verts (outer slot uses many rim segs), then area
                take = 0
                IfCondition GreaterEqual(pn, 8) ThenBlock: {
                    IfCondition EqualTo(env_i, -1) ThenBlock: { take = 1 }
                    IfCondition GreaterThan(pn, env_nn) ThenBlock: { take = 1 }
                    IfCondition EqualTo(pn, env_nn) ThenBlock: {
                        IfCondition EqualTo(Float_Le(env_ar, ar), 1) ThenBlock: { take = 1 }
                    }
                }
                // also allow high-area exterior with fewer verts (smoothed)
                IfCondition EqualTo(take, 0) ThenBlock: {
                    IfCondition EqualTo(Float_Le(env_ar, ar), 1) ThenBlock: {
                        IfCondition GreaterEqual(pn, 6) ThenBlock: { take = 1 }
                    }
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    env_i = pi
                    env_nn = pn
                    env_ar = ar
                }
            }
            pi = Add(pi, 1)
        }
        // attach outer envelope whenever we have any interior (incl. single junk CW)
        use_env = 0
        IfCondition GreaterThan(n_cw, 0) ThenBlock: {
            IfCondition GreaterEqual(env_i, 0) ThenBlock: { use_env = 1 }
        }
        // if NO interiors, keep exteriors (fallback)
        prefer_ext = 0
        IfCondition EqualTo(n_cw, 0) ThenBlock: {
            use_env = 0
            prefer_ext = 1
        }
        IfCondition GreaterThan(nprof, 0) ThenBlock: {
            new_n = 0
            new_pool_n = 0
            pi = 0
            WhileLoop LessThan(pi, nprof) {
                keep_i = 0
                IfCondition EqualTo(prefer_ext, 1) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(was_cw, pi), 0) ThenBlock: { keep_i = 1 }
                }
                IfCondition EqualTo(prefer_ext, 0) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(was_cw, pi), 1) ThenBlock: { keep_i = 1 }
                    IfCondition EqualTo(use_env, 1) ThenBlock: {
                        IfCondition EqualTo(pi, env_i) ThenBlock: { keep_i = 1 }
                    }
                }
                IfCondition EqualTo(keep_i, 1) ThenBlock: {
                    pn = ArrayGet(pmeta, Multiply(pi, 2))
                    po = ArrayGet(pmeta, Add(Multiply(pi, 2), 1))
                    ArraySet(pmeta, Multiply(new_n, 2), pn)
                    ArraySet(pmeta, Add(Multiply(new_n, 2), 1), new_pool_n)
                    k = 0
                    WhileLoop LessThan(k, pn) {
                        ArraySet(pool, Multiply(Add(new_pool_n, k), 2), ArrayGet(pool, Multiply(Add(po, k), 2)))
                        ArraySet(pool, Add(Multiply(Add(new_pool_n, k), 2), 1), ArrayGet(pool, Add(Multiply(Add(po, k), 2), 1)))
                        k = Add(k, 1)
                    }
                    new_pool_n = Add(new_pool_n, pn)
                    new_n = Add(new_n, 1)
                }
                pi = Add(pi, 1)
            }
            nprof = new_n
        }
        // Dedupe CW+CCW of the SAME cycle (both stored CCW with equal |area|).
        // padfail: outer+duplicate "hole" → ExtrudeCut self → triangle void / garbage solid.
        IfCondition GreaterThan(nprof, 1) ThenBlock: {
            new_n = 0
            new_pool_n = 0
            pi = 0
            WhileLoop LessThan(pi, nprof) {
                pn = ArrayGet(pmeta, Multiply(pi, 2))
                po = ArrayGet(pmeta, Add(Multiply(pi, 2), 1))
                ar = 0
                i = 0
                WhileLoop LessThan(i, pn) {
                    j = Add(i, 1)
                    IfCondition EqualTo(j, pn) ThenBlock: { j = 0 }
                    xi = ArrayGet(pool, Multiply(Add(po, i), 2))
                    yi = ArrayGet(pool, Add(Multiply(Add(po, i), 2), 1))
                    xj = ArrayGet(pool, Multiply(Add(po, j), 2))
                    yj = ArrayGet(pool, Add(Multiply(Add(po, j), 2), 1))
                    ar = Float_Add(ar, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
                    i = Add(i, 1)
                }
                IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
                // drop if a kept profile already has ~same area (within 2%)
                dup = 0
                qi = 0
                WhileLoop LessThan(qi, new_n) {
                    qn = ArrayGet(pmeta, Multiply(qi, 2))
                    qo = ArrayGet(pmeta, Add(Multiply(qi, 2), 1))
                    aq = 0
                    i = 0
                    WhileLoop LessThan(i, qn) {
                        j = Add(i, 1)
                        IfCondition EqualTo(j, qn) ThenBlock: { j = 0 }
                        xi = ArrayGet(pool, Multiply(Add(qo, i), 2))
                        yi = ArrayGet(pool, Add(Multiply(Add(qo, i), 2), 1))
                        xj = ArrayGet(pool, Multiply(Add(qo, j), 2))
                        yj = ArrayGet(pool, Add(Multiply(Add(qo, j), 2), 1))
                        aq = Float_Add(aq, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
                        i = Add(i, 1)
                    }
                    IfCondition EqualTo(Float_Le(aq, 0), 1) ThenBlock: { aq = Float_Sub(0, aq) }
                    // |ar-aq| <= 0.02 * max(ar,aq)
                    mx = ar
                    IfCondition EqualTo(Float_Le(mx, aq), 1) ThenBlock: { mx = aq }
                    dlt = Float_Sub(ar, aq)
                    IfCondition EqualTo(Float_Le(dlt, 0), 1) ThenBlock: { dlt = Float_Sub(0, dlt) }
                    // 0.02 = 0x3F947AE147AE147B
                    IfCondition EqualTo(Float_Le(dlt, Float_Mul(mx, 0x3F947AE147AE147B)), 1) ThenBlock: {
                        // also require similar vert count (not a real nested hole)
                        dn = Subtract(pn, qn)
                        IfCondition LessThan(dn, 0) ThenBlock: { dn = Subtract(0, dn) }
                        // |nn diff| <= max(4, 10% of larger nn)
                        lim = 4
                        mxn = pn
                        IfCondition GreaterThan(qn, mxn) ThenBlock: { mxn = qn }
                        t10 = Divide(mxn, 10)
                        IfCondition GreaterThan(t10, lim) ThenBlock: { lim = t10 }
                        IfCondition LessThan(Add(dn, 1), Add(lim, 2)) ThenBlock: { dup = 1 }
                    }
                    qi = Add(qi, 1)
                }
                IfCondition EqualTo(dup, 0) ThenBlock: {
                    ArraySet(pmeta, Multiply(new_n, 2), pn)
                    ArraySet(pmeta, Add(Multiply(new_n, 2), 1), new_pool_n)
                    k = 0
                    WhileLoop LessThan(k, pn) {
                        ArraySet(pool, Multiply(Add(new_pool_n, k), 2), ArrayGet(pool, Multiply(Add(po, k), 2)))
                        ArraySet(pool, Add(Multiply(Add(new_pool_n, k), 2), 1), ArrayGet(pool, Add(Multiply(Add(po, k), 2), 1)))
                        k = Add(k, 1)
                    }
                    new_pool_n = Add(new_pool_n, pn)
                    new_n = Add(new_n, 1)
                }
                pi = Add(pi, 1)
            }
            nprof = new_n
        }
        Deallocate(was_cw, 512)
        CAD_Store.Write(sketch_handle, 12, nprof)
        IfCondition EqualTo(nprof, 0) ThenBlock: {
            ReturnValue(CAD_Sketch.BuildClosedLoop(sketch_handle))
        }
        // pick largest |area| as profile 0 (outer pad default)
        best = 0
        best_a = 0
        pi = 0
        WhileLoop LessThan(pi, nprof) {
            pn = ArrayGet(pmeta, Multiply(pi, 2))
            po = ArrayGet(pmeta, Add(Multiply(pi, 2), 1))
            ar = 0
            i = 0
            WhileLoop LessThan(i, pn) {
                j = Add(i, 1)
                IfCondition EqualTo(j, pn) ThenBlock: { j = 0 }
                xi = ArrayGet(pool, Multiply(Add(po, i), 2))
                yi = ArrayGet(pool, Add(Multiply(Add(po, i), 2), 1))
                xj = ArrayGet(pool, Multiply(Add(po, j), 2))
                yj = ArrayGet(pool, Add(Multiply(Add(po, j), 2), 1))
                ar = Float_Add(ar, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
                i = Add(i, 1)
            }
            IfCondition EqualTo(Float_Le(ar, 0), 1) ThenBlock: { ar = Float_Sub(0, ar) }
            IfCondition EqualTo(Float_Le(best_a, ar), 1) ThenBlock: {
                best_a = ar
                best = pi
            }
            pi = Add(pi, 1)
        }
        IfCondition NotEqual(best, 0) ThenBlock: {
            n0 = ArrayGet(pmeta, 0)
            o0 = ArrayGet(pmeta, 1)
            ArraySet(pmeta, 0, ArrayGet(pmeta, Multiply(best, 2)))
            ArraySet(pmeta, 1, ArrayGet(pmeta, Add(Multiply(best, 2), 1)))
            ArraySet(pmeta, Multiply(best, 2), n0)
            ArraySet(pmeta, Add(Multiply(best, 2), 1), o0)
        }
        pn0 = ArrayGet(pmeta, 0)
        po0 = ArrayGet(pmeta, 1)
        ploop = CAD_Store.Read(sketch_handle, 3)
        k = 0
        WhileLoop LessThan(k, pn0) {
            ArraySet(ploop, Multiply(k, 2), ArrayGet(pool, Multiply(Add(po0, k), 2)))
            ArraySet(ploop, Add(Multiply(k, 2), 1), ArrayGet(pool, Add(Multiply(Add(po0, k), 2), 1)))
            k = Add(k, 1)
        }
        CAD_Store.Write(sketch_handle, 2, pn0)
        ReturnValue(nprof)
    }
}

// Copy profile i verts into out_xy (caller buffer). Returns n or 0.
// Copy profile i into out_xy as interleaved x,y.
// Caller must provide ≥2048 points (32768 bytes). Hard cap prevents heap smash
// (cad_app used 4096-byte buffers = 256 pts → multi-circle pad SEGV after "pad OK").
