LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Sketch.TessellateCircles {
    Input: sketch_handle: Integer
    Input: nseg: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg, 8) ThenBlock: { nseg = 32 }
        nc = CAD_Store.Read(sketch_handle, 7)
        IfCondition EqualTo(nc, 0) ThenBlock: { ReturnValue(0) }
        circs = CAD_Store.Read(sketch_handle, 8)
        lines = CAD_Store.Read(sketch_handle, 1)
        nl = CAD_Store.Read(sketch_handle, 0)
        two_pi = 0x401921FB54442D18
        // relative angles in [0, 2π); optional exact (px,py) for line hits
        // (Cos/Sin of Atan2(hit) ≠ hit — that micro-gap broke circle-notch profiles)
        angs = Allocate(512)
        hitx = Allocate(4096)
        hity = Allocate(4096)
        hath = Allocate(512)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            base = Multiply(ci, 3)
            cx = ArrayGet(circs, base)
            cy = ArrayGet(circs, Add(base, 1))
            rad = ArrayGet(circs, Add(base, 2))
            // seed uniform samples (no exact hit)
            nang = 0
            i = 0
            WhileLoop LessThan(i, nseg) {
                ArraySet(angs, nang, Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(nseg))))
                ArraySet(hath, nang, 0)
                nang = Add(nang, 1)
                i = Add(i, 1)
            }
            // line × circle hits — store EXACT line point, not Cos(Atan2)
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, dx, dy))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, 0x3F50624DD2F1A9FC)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        t0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        t1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            t = t0
                            IfCondition EqualTo(hi, 1) ThenBlock: { t = t1 }
                            one = 0x3FF0000000000000
                            ok = 1
                            IfCondition EqualTo(Float_Le(t, 0), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(0, t), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok = 0 }
                            }
                            IfCondition EqualTo(Float_Le(one, t), 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(Float_Sub(t, one), 0x3F50624DD2F1A9FC), 0) ThenBlock: { ok = 0 }
                            }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, Float_Mul(t, dx))
                                py = Float_Add(y0, Float_Mul(t, dy))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                // normalize to [0, 2π)
                                IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, ang), 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                                        ang = Float_Add(ang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(two_pi, ang), 1) ThenBlock: {
                                    ang = Float_Sub(ang, two_pi)
                                }
                                IfCondition LessThan(nang, 500) ThenBlock: {
                                    ArraySet(angs, nang, ang)
                                    ArraySet(hitx, nang, px)
                                    ArraySet(hity, nang, py)
                                    ArraySet(hath, nang, 1)
                                    nang = Add(nang, 1)
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                li = Add(li, 1)
            }
            // circle × circle hits (critical for multi-circle T-junctions)
            cj = 0
            WhileLoop LessThan(cj, nc) {
                IfCondition NotEqual(cj, ci) ThenBlock: {
                    bj = Multiply(cj, 3)
                    ox = ArrayGet(circs, bj)
                    oy = ArrayGet(circs, Add(bj, 1))
                    orad = ArrayGet(circs, Add(bj, 2))
                    dx = Float_Sub(ox, cx)
                    dy = Float_Sub(oy, cy)
                    d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    d = CAD_Num.Sqrt(d2)
                    // valid intersection: |r1-r2| < d < r1+r2 and d > 0
                    okc = 1
                    IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: { okc = 0 }
                    IfCondition EqualTo(Float_Le(Float_Add(rad, orad), d), 1) ThenBlock: { okc = 0 }
                    dr = Float_Sub(rad, orad)
                    IfCondition EqualTo(Float_Le(dr, 0), 1) ThenBlock: { dr = Float_Sub(0, dr) }
                    IfCondition EqualTo(Float_Le(d, dr), 1) ThenBlock: { okc = 0 }
                    IfCondition EqualTo(okc, 1) ThenBlock: {
                        // a = (r1^2 - r2^2 + d^2) / (2d)
                        a = Float_Div(Float_Add(Float_Sub(Float_Mul(rad, rad), Float_Mul(orad, orad)), d2), Float_Mul(0x4000000000000000, d))
                        h2 = Float_Sub(Float_Mul(rad, rad), Float_Mul(a, a))
                        IfCondition EqualTo(Float_Le(h2, 0), 0) ThenBlock: {
                            h = CAD_Num.Sqrt(h2)
                            // midpoint along centers: C + a*(O-C)/d
                            mx = Float_Add(cx, Float_Mul(a, Float_Div(dx, d)))
                            my = Float_Add(cy, Float_Mul(a, Float_Div(dy, d)))
                            // perpendicular offset
                            rx = Float_Mul(h, Float_Div(dy, d))
                            ry = Float_Mul(h, Float_Div(dx, d))
                            // two points
                            hi = 0
                            WhileLoop LessThan(hi, 2) {
                                IfCondition EqualTo(hi, 0) ThenBlock: {
                                    px = Float_Add(mx, rx)
                                    py = Float_Sub(my, ry)
                                }
                                IfCondition EqualTo(hi, 1) ThenBlock: {
                                    px = Float_Sub(mx, rx)
                                    py = Float_Add(my, ry)
                                }
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                IfCondition EqualTo(Float_Le(ang, 0), 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(Float_Sub(0, ang), 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                                        ang = Float_Add(ang, two_pi)
                                    }
                                }
                                IfCondition EqualTo(Float_Le(two_pi, ang), 1) ThenBlock: {
                                    ang = Float_Sub(ang, two_pi)
                                }
                                IfCondition LessThan(nang, 500) ThenBlock: {
                                    ArraySet(angs, nang, ang)
                                    ArraySet(hath, nang, 0)
                                    nang = Add(nang, 1)
                                }
                                hi = Add(hi, 1)
                            }
                        }
                    }
                }
                cj = Add(cj, 1)
            }
            // bubble-sort angles (+ exact hit coords)
            a = 0
            WhileLoop LessThan(a, nang) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nang) {
                    va = ArrayGet(angs, a)
                    vb = ArrayGet(angs, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(angs, a, vb)
                        ArraySet(angs, bb, va)
                        tx = ArrayGet(hitx, a)
                        ArraySet(hitx, a, ArrayGet(hitx, bb))
                        ArraySet(hitx, bb, tx)
                        ty = ArrayGet(hity, a)
                        ArraySet(hity, a, ArrayGet(hity, bb))
                        ArraySet(hity, bb, ty)
                        th = ArrayGet(hath, a)
                        ArraySet(hath, a, ArrayGet(hath, bb))
                        ArraySet(hath, bb, th)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // prefer exact-hit sample when two angles nearly equal (line tip wins over Cos)
            IfCondition GreaterThan(nang, 1) ThenBlock: {
                w = 0
                r = 0
                WhileLoop LessThan(r, nang) {
                    IfCondition EqualTo(w, 0) ThenBlock: {
                        ArraySet(angs, 0, ArrayGet(angs, r))
                        ArraySet(hitx, 0, ArrayGet(hitx, r))
                        ArraySet(hity, 0, ArrayGet(hity, r))
                        ArraySet(hath, 0, ArrayGet(hath, r))
                        w = 1
                    }
                    IfCondition GreaterThan(r, 0) ThenBlock: {
                        dt = Float_Sub(ArrayGet(angs, r), ArrayGet(angs, Subtract(w, 1)))
                        IfCondition EqualTo(Float_Le(dt, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                            // merge: keep exact hit if either has one
                            IfCondition EqualTo(ArrayGet(hath, r), 1) ThenBlock: {
                                ArraySet(angs, Subtract(w, 1), ArrayGet(angs, r))
                                ArraySet(hitx, Subtract(w, 1), ArrayGet(hitx, r))
                                ArraySet(hity, Subtract(w, 1), ArrayGet(hity, r))
                                ArraySet(hath, Subtract(w, 1), 1)
                            }
                        }
                        IfCondition EqualTo(Float_Le(dt, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                            ArraySet(angs, w, ArrayGet(angs, r))
                            ArraySet(hitx, w, ArrayGet(hitx, r))
                            ArraySet(hity, w, ArrayGet(hity, r))
                            ArraySet(hath, w, ArrayGet(hath, r))
                            w = Add(w, 1)
                        }
                    }
                    r = Add(r, 1)
                }
                nang = w
            }
            // emit unique consecutive + wrap last→first
            IfCondition GreaterThan(nang, 0) ThenBlock: {
                pi_prev = 0
                k = 1
                WhileLoop LessThan(k, nang) {
                    // point at index pi_prev and k
                    IfCondition EqualTo(ArrayGet(hath, pi_prev), 1) ThenBlock: {
                        x0 = ArrayGet(hitx, pi_prev)
                        y0 = ArrayGet(hity, pi_prev)
                    }
                    IfCondition EqualTo(ArrayGet(hath, pi_prev), 0) ThenBlock: {
                        x0 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ArrayGet(angs, pi_prev))))
                        y0 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ArrayGet(angs, pi_prev))))
                    }
                    IfCondition EqualTo(ArrayGet(hath, k), 1) ThenBlock: {
                        x1 = ArrayGet(hitx, k)
                        y1 = ArrayGet(hity, k)
                    }
                    IfCondition EqualTo(ArrayGet(hath, k), 0) ThenBlock: {
                        x1 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ArrayGet(angs, k))))
                        y1 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ArrayGet(angs, k))))
                    }
                    CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
                    pi_prev = k
                    k = Add(k, 1)
                }
                // wrap last → first
                IfCondition EqualTo(ArrayGet(hath, pi_prev), 1) ThenBlock: {
                    x0 = ArrayGet(hitx, pi_prev)
                    y0 = ArrayGet(hity, pi_prev)
                }
                IfCondition EqualTo(ArrayGet(hath, pi_prev), 0) ThenBlock: {
                    x0 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ArrayGet(angs, pi_prev))))
                    y0 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ArrayGet(angs, pi_prev))))
                }
                IfCondition EqualTo(ArrayGet(hath, 0), 1) ThenBlock: {
                    x1 = ArrayGet(hitx, 0)
                    y1 = ArrayGet(hity, 0)
                }
                IfCondition EqualTo(ArrayGet(hath, 0), 0) ThenBlock: {
                    x1 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ArrayGet(angs, 0))))
                    y1 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ArrayGet(angs, 0))))
                }
                CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
            }
            ci = Add(ci, 1)
        }
        Deallocate(angs, 512)
        Deallocate(hitx, 4096)
        Deallocate(hity, 4096)
        Deallocate(hath, 512)
        ReturnValue(CAD_Store.Read(sketch_handle, 0))
    }
}

// Prepare sketch for extrude: merge open line-chains onto circles (clip arc),
// then tessellate remaining full circles. FreeCAD-like "box on circle" pad.
// Mutates sketch (adds LINE segs). Clears profile cache.
// Returns n_profiles after BuildAllClosedLoops, or 0.
// IMPORTANT: never promote a pure-circle pad when the sketch still has user
// lines that did not join any closed loop (that was the "circle always wins" bug).


// Prepare sketch for extrude: merge open line-chains onto circles (clip arc),
// then tessellate remaining full circles. FreeCAD-like "box on circle" pad.
// Mutates sketch (adds LINE segs). Clears profile cache.
// Returns n_profiles after BuildAllClosedLoops, or 0.
// IMPORTANT: never promote a pure-circle pad when the sketch still has user
// lines that did not join any closed loop (that was the "circle always wins" bug).
Function.CAD_Sketch.PrepareExtrude {
    Input: sketch_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        // clear cached loops
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        IfCondition GreaterThan(CAD_Store.Read(sketch_handle, 10), 0) ThenBlock: {
            CAD_Sketch.TessellateArcs(sketch_handle, 32)
        }
        nl0 = CAD_Store.Read(sketch_handle, 0)
        nc = CAD_Store.Read(sketch_handle, 7)
        // pure circles only
        IfCondition EqualTo(nl0, 0) ThenBlock: {
            IfCondition GreaterThan(nc, 0) ThenBlock: {
                CAD_Sketch.TessellateCircles(sketch_handle, 32)
            }
            ReturnValue(CAD_Sketch.BuildAllClosedLoops(sketch_handle))
        }
        IfCondition EqualTo(nc, 0) ThenBlock: {
            ReturnValue(CAD_Sketch.BuildAllClosedLoops(sketch_handle))
        }
        circs = CAD_Store.Read(sketch_handle, 8)
        lines = CAD_Store.Read(sketch_handle, 1)
        two_pi = 0x401921FB54442D18
        // freehand chain join tol (world units) — looser than Num_Tol.linear
        chain_tol = 0x3F50624DD2F1A9FC
        chain_tol2 = Float_Mul(chain_tol, chain_tol)
        // Pre-project only FREE tips (valence 1) onto circle rim.
        // Projecting ALL near-rim points destroyed closed rects near circles.
        li = 0
        WhileLoop LessThan(li, nl0) {
            b = Multiply(li, 4)
            ei = 0
            WhileLoop LessThan(ei, 2) {
                IfCondition EqualTo(ei, 0) ThenBlock: {
                    px = ArrayGet(lines, b)
                    py = ArrayGet(lines, Add(b, 1))
                }
                IfCondition EqualTo(ei, 1) ThenBlock: {
                    px = ArrayGet(lines, Add(b, 2))
                    py = ArrayGet(lines, Add(b, 3))
                }
                // valence = how many other endpoints coincide with this tip
                valence = 0
                lj = 0
                WhileLoop LessThan(lj, nl0) {
                    bj = Multiply(lj, 4)
                    ej = 0
                    WhileLoop LessThan(ej, 2) {
                        skip = 0
                        IfCondition EqualTo(lj, li) ThenBlock: {
                            IfCondition EqualTo(ej, ei) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(skip, 0) ThenBlock: {
                            IfCondition EqualTo(ej, 0) ThenBlock: {
                                qx = ArrayGet(lines, bj)
                                qy = ArrayGet(lines, Add(bj, 1))
                            }
                            IfCondition EqualTo(ej, 1) ThenBlock: {
                                qx = ArrayGet(lines, Add(bj, 2))
                                qy = ArrayGet(lines, Add(bj, 3))
                            }
                            dx = Float_Sub(px, qx)
                            dy = Float_Sub(py, qy)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, chain_tol2), 1) ThenBlock: {
                                valence = Add(valence, 1)
                            }
                        }
                        ej = Add(ej, 1)
                    }
                    lj = Add(lj, 1)
                }
                // only free chain tips
                IfCondition EqualTo(valence, 0) ThenBlock: {
                    best_dd = 0
                    best_ok = 0
                    bcx = 0
                    bcy = 0
                    brad = 0
                    ci = 0
                    WhileLoop LessThan(ci, nc) {
                        base = Multiply(ci, 3)
                        cx = ArrayGet(circs, base)
                        cy = ArrayGet(circs, Add(base, 1))
                        rad = ArrayGet(circs, Add(base, 2))
                        d = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(px, cx), Float_Sub(px, cx)), Float_Mul(Float_Sub(py, cy), Float_Sub(py, cy))))
                        dd = Float_Sub(d, rad)
                        IfCondition EqualTo(Float_Le(dd, 0), 1) ThenBlock: { dd = Float_Sub(0, dd) }
                        // |d-rad| <= 40% of radius
                        tol = Float_Mul(rad, 0x3FD999999999999A)
                        IfCondition EqualTo(Float_Le(dd, tol), 1) ThenBlock: {
                            IfCondition EqualTo(best_ok, 0) ThenBlock: {
                                best_ok = 1
                                best_dd = dd
                                bcx = cx
                                bcy = cy
                                brad = rad
                            }
                            IfCondition EqualTo(best_ok, 1) ThenBlock: {
                                IfCondition EqualTo(Float_Le(dd, best_dd), 1) ThenBlock: {
                                    best_dd = dd
                                    bcx = cx
                                    bcy = cy
                                    brad = rad
                                }
                            }
                        }
                        ci = Add(ci, 1)
                    }
                    IfCondition EqualTo(best_ok, 1) ThenBlock: {
                        d = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(px, bcx), Float_Sub(px, bcx)), Float_Mul(Float_Sub(py, bcy), Float_Sub(py, bcy))))
                        IfCondition EqualTo(CAD_Num.IsZero(d, 0), 0) ThenBlock: {
                            px = Float_Add(bcx, Float_Mul(brad, Float_Div(Float_Sub(px, bcx), d)))
                            py = Float_Add(bcy, Float_Mul(brad, Float_Div(Float_Sub(py, bcy), d)))
                            IfCondition EqualTo(ei, 0) ThenBlock: {
                                ArraySet(lines, b, px)
                                ArraySet(lines, Add(b, 1), py)
                            }
                            IfCondition EqualTo(ei, 1) ThenBlock: {
                                ArraySet(lines, Add(b, 2), px)
                                ArraySet(lines, Add(b, 3), py)
                            }
                        }
                    }
                }
                ei = Add(ei, 1)
            }
            li = Add(li, 1)
        }
        // consumed circles
        usedc = Allocate(64)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            ArraySet(usedc, ci, 0)
            ci = Add(ci, 1)
        }
        n_attached = 0
        // line-used flags for chain walk (only original lines 0..nl0-1)
        usedl = Allocate(1024)
        li = 0
        WhileLoop LessThan(li, nl0) {
            ArraySet(usedl, li, 0)
            li = Add(li, 1)
        }
        // grow chains from each unused line
        seed = 0
        WhileLoop LessThan(seed, nl0) {
            IfCondition EqualTo(ArrayGet(usedl, seed), 0) ThenBlock: {
                // start chain at seed: tip = end of seed, start = begin
                ArraySet(usedl, seed, 1)
                // ordered points buffer
                pts = Allocate(4096)
                np = 0
                sx = ArrayGet(lines, Multiply(seed, 4))
                sy = ArrayGet(lines, Add(Multiply(seed, 4), 1))
                ex = ArrayGet(lines, Add(Multiply(seed, 4), 2))
                ey = ArrayGet(lines, Add(Multiply(seed, 4), 3))
                ArraySet(pts, 0, sx)
                ArraySet(pts, 1, sy)
                ArraySet(pts, 2, ex)
                ArraySet(pts, 3, ey)
                np = 2
                tipx = ex
                tipy = ey
                // extend forward (distance join, not only exact IsEqual)
                guard = 0
                WhileLoop LessThan(guard, 256) {
                    guard = Add(guard, 1)
                    found = -1
                    rev = 0
                    best_d2 = chain_tol2
                    j = 0
                    WhileLoop LessThan(j, nl0) {
                        IfCondition EqualTo(ArrayGet(usedl, j), 0) ThenBlock: {
                            b = Multiply(j, 4)
                            ax = ArrayGet(lines, b)
                            ay = ArrayGet(lines, Add(b, 1))
                            bx = ArrayGet(lines, Add(b, 2))
                            by = ArrayGet(lines, Add(b, 3))
                            dx = Float_Sub(ax, tipx)
                            dy = Float_Sub(ay, tipy)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                                best_d2 = d2
                                found = j
                                rev = 0
                            }
                            dx = Float_Sub(bx, tipx)
                            dy = Float_Sub(by, tipy)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                                best_d2 = d2
                                found = j
                                rev = 1
                            }
                        }
                        j = Add(j, 1)
                    }
                    IfCondition EqualTo(found, -1) ThenBlock: {
                        guard = 256
                    }
                    IfCondition GreaterEqual(found, 0) ThenBlock: {
                        ArraySet(usedl, found, 1)
                        b = Multiply(found, 4)
                        IfCondition EqualTo(rev, 0) ThenBlock: {
                            // snap join point so later BuildAllClosedLoops chains cleanly
                            ArraySet(lines, b, tipx)
                            ArraySet(lines, Add(b, 1), tipy)
                            tipx = ArrayGet(lines, Add(b, 2))
                            tipy = ArrayGet(lines, Add(b, 3))
                        }
                        IfCondition EqualTo(rev, 1) ThenBlock: {
                            ArraySet(lines, Add(b, 2), tipx)
                            ArraySet(lines, Add(b, 3), tipy)
                            tipx = ArrayGet(lines, b)
                            tipy = ArrayGet(lines, Add(b, 1))
                        }
                        ArraySet(pts, Multiply(np, 2), tipx)
                        ArraySet(pts, Add(Multiply(np, 2), 1), tipy)
                        np = Add(np, 1)
                    }
                }
                // also extend backward from sx,sy
                tipx = sx
                tipy = sy
                guard = 0
                WhileLoop LessThan(guard, 256) {
                    guard = Add(guard, 1)
                    found = -1
                    rev = 0
                    best_d2 = chain_tol2
                    j = 0
                    WhileLoop LessThan(j, nl0) {
                        IfCondition EqualTo(ArrayGet(usedl, j), 0) ThenBlock: {
                            b = Multiply(j, 4)
                            ax = ArrayGet(lines, b)
                            ay = ArrayGet(lines, Add(b, 1))
                            bx = ArrayGet(lines, Add(b, 2))
                            by = ArrayGet(lines, Add(b, 3))
                            dx = Float_Sub(ax, tipx)
                            dy = Float_Sub(ay, tipy)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                                best_d2 = d2
                                found = j
                                rev = 0
                            }
                            dx = Float_Sub(bx, tipx)
                            dy = Float_Sub(by, tipy)
                            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                                best_d2 = d2
                                found = j
                                rev = 1
                            }
                        }
                        j = Add(j, 1)
                    }
                    IfCondition EqualTo(found, -1) ThenBlock: {
                        guard = 256
                    }
                    IfCondition GreaterEqual(found, 0) ThenBlock: {
                        ArraySet(usedl, found, 1)
                        b = Multiply(found, 4)
                        IfCondition EqualTo(rev, 0) ThenBlock: {
                            ArraySet(lines, b, tipx)
                            ArraySet(lines, Add(b, 1), tipy)
                            tipx = ArrayGet(lines, Add(b, 2))
                            tipy = ArrayGet(lines, Add(b, 3))
                        }
                        IfCondition EqualTo(rev, 1) ThenBlock: {
                            ArraySet(lines, Add(b, 2), tipx)
                            ArraySet(lines, Add(b, 3), tipy)
                            tipx = ArrayGet(lines, b)
                            tipy = ArrayGet(lines, Add(b, 1))
                        }
                        // prepend: shift pts
                        k = np
                        WhileLoop GreaterThan(k, 0) {
                            ArraySet(pts, Multiply(k, 2), ArrayGet(pts, Multiply(Subtract(k, 1), 2)))
                            ArraySet(pts, Add(Multiply(k, 2), 1), ArrayGet(pts, Add(Multiply(Subtract(k, 1), 2), 1)))
                            k = Subtract(k, 1)
                        }
                        ArraySet(pts, 0, tipx)
                        ArraySet(pts, 1, tipy)
                        np = Add(np, 1)
                    }
                }
                // chain ends: pts[0] and pts[np-1]
                IfCondition GreaterEqual(np, 2) ThenBlock: {
                    e0x = ArrayGet(pts, 0)
                    e0y = ArrayGet(pts, 1)
                    e1x = ArrayGet(pts, Multiply(Subtract(np, 1), 2))
                    e1y = ArrayGet(pts, Add(Multiply(Subtract(np, 1), 2), 1))
                    // chain centroid for arc choice
                    cxsum = 0
                    cysum = 0
                    k = 0
                    WhileLoop LessThan(k, np) {
                        cxsum = Float_Add(cxsum, ArrayGet(pts, Multiply(k, 2)))
                        cysum = Float_Add(cysum, ArrayGet(pts, Add(Multiply(k, 2), 1)))
                        k = Add(k, 1)
                    }
                    cnx = Float_Div(cxsum, Float_FromInt(np))
                    cny = Float_Div(cysum, Float_FromInt(np))
                    // which circle?
                    ci = 0
                    WhileLoop LessThan(ci, nc) {
                        IfCondition EqualTo(ArrayGet(usedc, ci), 0) ThenBlock: {
                            base = Multiply(ci, 3)
                            cx = ArrayGet(circs, base)
                            cy = ArrayGet(circs, Add(base, 1))
                            rad = ArrayGet(circs, Add(base, 2))
                            // ends on circle?
                            d0 = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(e0x, cx), Float_Sub(e0x, cx)), Float_Mul(Float_Sub(e0y, cy), Float_Sub(e0y, cy))))
                            d1 = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(e1x, cx), Float_Sub(e1x, cx)), Float_Mul(Float_Sub(e1y, cy), Float_Sub(e1y, cy))))
                            // |d-rad| <= 40% rad (after pre-project, ends should be exact)
                            tol = Float_Mul(rad, 0x3FD999999999999A)
                            dd0 = Float_Sub(d0, rad)
                            IfCondition EqualTo(Float_Le(dd0, 0), 1) ThenBlock: { dd0 = Float_Sub(0, dd0) }
                            dd1 = Float_Sub(d1, rad)
                            IfCondition EqualTo(Float_Le(dd1, 0), 1) ThenBlock: { dd1 = Float_Sub(0, dd1) }
                            ok0 = 0
                            ok1 = 0
                            IfCondition EqualTo(Float_Le(dd0, tol), 1) ThenBlock: { ok0 = 1 }
                            IfCondition EqualTo(Float_Le(dd1, tol), 1) ThenBlock: { ok1 = 1 }
                            // also refuse degenerate: both ends nearly the same point on rim
                            IfCondition EqualTo(ok0, 1) ThenBlock: {
                                IfCondition EqualTo(ok1, 1) ThenBlock: {
                                    ed = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(e0x, e1x), Float_Sub(e0x, e1x)), Float_Mul(Float_Sub(e0y, e1y), Float_Sub(e0y, e1y))))
                                    min_span = Float_Mul(rad, 0x3F847AE147AE147B)
                                    IfCondition EqualTo(Float_Le(ed, min_span), 1) ThenBlock: {
                                        ok0 = 0
                                        ok1 = 0
                                    }
                                }
                            }
                            IfCondition EqualTo(ok0, 1) ThenBlock: {
                                IfCondition EqualTo(ok1, 1) ThenBlock: {
                                    // project ends onto circle exactly
                                    d0 = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(e0x, cx), Float_Sub(e0x, cx)), Float_Mul(Float_Sub(e0y, cy), Float_Sub(e0y, cy))))
                                    d1 = CAD_Num.Sqrt(Float_Add(Float_Mul(Float_Sub(e1x, cx), Float_Sub(e1x, cx)), Float_Mul(Float_Sub(e1y, cy), Float_Sub(e1y, cy))))
                                    IfCondition EqualTo(CAD_Num.IsZero(d0, 0), 0) ThenBlock: {
                                        e0x = Float_Add(cx, Float_Mul(rad, Float_Div(Float_Sub(e0x, cx), d0)))
                                        e0y = Float_Add(cy, Float_Mul(rad, Float_Div(Float_Sub(e0y, cy), d0)))
                                    }
                                    IfCondition EqualTo(CAD_Num.IsZero(d1, 0), 0) ThenBlock: {
                                        e1x = Float_Add(cx, Float_Mul(rad, Float_Div(Float_Sub(e1x, cx), d1)))
                                        e1y = Float_Add(cy, Float_Mul(rad, Float_Div(Float_Sub(e1y, cy), d1)))
                                    }
                                    // angles at ends
                                    a0 = CAD_Geom.Atan2(Float_Sub(e0y, cy), Float_Sub(e0x, cx))
                                    a1 = CAD_Geom.Atan2(Float_Sub(e1y, cy), Float_Sub(e1x, cx))
                                    // two possible remaining arcs: CCW a0→a1 and a1→a0
                                    // pick remaining arc mid farther from chain centroid
                                    span01 = Float_Sub(a1, a0)
                                    IfCondition EqualTo(Float_Le(span01, 0), 1) ThenBlock: {
                                        span01 = Float_Add(span01, two_pi)
                                    }
                                    mid01 = Float_Add(a0, Float_Mul(span01, 0x3FE0000000000000))
                                    mx01 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(mid01)))
                                    my01 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(mid01)))
                                    d01 = Float_Add(Float_Mul(Float_Sub(mx01, cnx), Float_Sub(mx01, cnx)), Float_Mul(Float_Sub(my01, cny), Float_Sub(my01, cny)))
                                    span10 = Float_Sub(a0, a1)
                                    IfCondition EqualTo(Float_Le(span10, 0), 1) ThenBlock: {
                                        span10 = Float_Add(span10, two_pi)
                                    }
                                    mid10 = Float_Add(a1, Float_Mul(span10, 0x3FE0000000000000))
                                    mx10 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(mid10)))
                                    my10 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(mid10)))
                                    d10 = Float_Add(Float_Mul(Float_Sub(mx10, cnx), Float_Sub(mx10, cnx)), Float_Mul(Float_Sub(my10, cny), Float_Sub(my10, cny)))
                                    // remaining arc = farther mid from chain
                                    ra0 = a0
                                    ra1 = a1
                                    IfCondition EqualTo(Float_Le(d01, d10), 1) ThenBlock: {
                                        // d10 farther → remaining a1→a0
                                        ra0 = a1
                                        ra1 = a0
                                    }
                                    // tessellate remaining arc into lines
                                    span = Float_Sub(ra1, ra0)
                                    IfCondition EqualTo(Float_Le(span, 0), 1) ThenBlock: {
                                        span = Float_Add(span, two_pi)
                                    }
                                    nseg = Float_ToInt(Float_Div(Float_Mul(Float_FromInt(32), span), two_pi))
                                    IfCondition LessThan(nseg, 4) ThenBlock: { nseg = 4 }
                                    IfCondition GreaterThan(nseg, 64) ThenBlock: { nseg = 64 }
                                    // remaining arc connectivity: force ends onto chain tips
                                    esx = e0x
                                    esy = e0y
                                    eex = e1x
                                    eey = e1y
                                    IfCondition EqualTo(CAD_Num.IsEqual(ra0, a1, 0), 1) ThenBlock: {
                                        esx = e1x
                                        esy = e1y
                                        eex = e0x
                                        eey = e0y
                                    }
                                    // snap chain tips onto exact rim in the line buffer too
                                    // (pts[0]/pts[last] may have been pre-projected already)
                                    i = 0
                                    WhileLoop LessThan(i, nseg) {
                                        t0 = Float_Div(Float_FromInt(i), Float_FromInt(nseg))
                                        t1 = Float_Div(Float_FromInt(Add(i, 1)), Float_FromInt(nseg))
                                        ang0 = Float_Add(ra0, Float_Mul(span, t0))
                                        ang1 = Float_Add(ra0, Float_Mul(span, t1))
                                        x0 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang0)))
                                        y0 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang0)))
                                        x1 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang1)))
                                        y1 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang1)))
                                        IfCondition EqualTo(i, 0) ThenBlock: {
                                            x0 = esx
                                            y0 = esy
                                        }
                                        IfCondition EqualTo(Add(i, 1), nseg) ThenBlock: {
                                            x1 = eex
                                            y1 = eey
                                        }
                                        CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
                                        i = Add(i, 1)
                                    }
                                    // also force original chain tip verts onto exact projected ends
                                    // so BuildAllClosedLoops joins chain ↔ arc segs
                                    // rewrite line endpoints that match pre-project tips
                                    li2 = 0
                                    WhileLoop LessThan(li2, nl0) {
                                        b2 = Multiply(li2, 4)
                                        ax = ArrayGet(lines, b2)
                                        ay = ArrayGet(lines, Add(b2, 1))
                                        bx = ArrayGet(lines, Add(b2, 2))
                                        by = ArrayGet(lines, Add(b2, 3))
                                        IfCondition EqualTo(CAD_Num.IsEqual(ax, ArrayGet(pts, 0), 0), 1) ThenBlock: {
                                            IfCondition EqualTo(CAD_Num.IsEqual(ay, ArrayGet(pts, 1), 0), 1) ThenBlock: {
                                                ArraySet(lines, b2, e0x)
                                                ArraySet(lines, Add(b2, 1), e0y)
                                            }
                                        }
                                        IfCondition EqualTo(CAD_Num.IsEqual(bx, ArrayGet(pts, 0), 0), 1) ThenBlock: {
                                            IfCondition EqualTo(CAD_Num.IsEqual(by, ArrayGet(pts, 1), 0), 1) ThenBlock: {
                                                ArraySet(lines, Add(b2, 2), e0x)
                                                ArraySet(lines, Add(b2, 3), e0y)
                                            }
                                        }
                                        IfCondition EqualTo(CAD_Num.IsEqual(ax, ArrayGet(pts, Multiply(Subtract(np, 1), 2)), 0), 1) ThenBlock: {
                                            IfCondition EqualTo(CAD_Num.IsEqual(ay, ArrayGet(pts, Add(Multiply(Subtract(np, 1), 2), 1)), 0), 1) ThenBlock: {
                                                ArraySet(lines, b2, e1x)
                                                ArraySet(lines, Add(b2, 1), e1y)
                                            }
                                        }
                                        IfCondition EqualTo(CAD_Num.IsEqual(bx, ArrayGet(pts, Multiply(Subtract(np, 1), 2)), 0), 1) ThenBlock: {
                                            IfCondition EqualTo(CAD_Num.IsEqual(by, ArrayGet(pts, Add(Multiply(Subtract(np, 1), 2), 1)), 0), 1) ThenBlock: {
                                                ArraySet(lines, Add(b2, 2), e1x)
                                                ArraySet(lines, Add(b2, 3), e1y)
                                            }
                                        }
                                        li2 = Add(li2, 1)
                                    }
                                    ArraySet(usedc, ci, 1)
                                    n_attached = Add(n_attached, 1)
                                    ci = nc
                                }
                            }
                        }
                        ci = Add(ci, 1)
                    }
                }
                Deallocate(pts, 4096)
            }
            seed = Add(seed, 1)
        }
        // remaining full circles → closed 32-gons (always; pad selects which profile)
        ci = 0
        WhileLoop LessThan(ci, nc) {
            IfCondition EqualTo(ArrayGet(usedc, ci), 0) ThenBlock: {
                base = Multiply(ci, 3)
                cx = ArrayGet(circs, base)
                cy = ArrayGet(circs, Add(base, 1))
                rad = ArrayGet(circs, Add(base, 2))
                i = 0
                WhileLoop LessThan(i, 32) {
                    a0 = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(32)))
                    a1 = Float_Mul(two_pi, Float_Div(Float_FromInt(Add(i, 1)), Float_FromInt(32)))
                    x0 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a0)))
                    y0 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a0)))
                    x1 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(a1)))
                    y1 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(a1)))
                    CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
                    i = Add(i, 1)
                }
            }
            ci = Add(ci, 1)
        }
        Deallocate(usedc, 64)
        Deallocate(usedl, 1024)
        // circles/arcs now represented as lines
        CAD_Store.Write(sketch_handle, 7, 0)
        CAD_Store.Write(sketch_handle, 10, 0)
        CAD_Store.Write(sketch_handle, 2, 0)
        CAD_Store.Write(sketch_handle, 12, 0)
        // stash attach count in last_error for app diagnostics (optional)
        CAD_Sketch_State.last_error = n_attached
        ReturnValue(CAD_Sketch.BuildAllClosedLoops(sketch_handle))
    }
}

// Promote profile index to primary loop (for pad selection). Returns n pts or 0.
// Mirror profile i into primary loop slots 2/3 for display/export.
// Does NOT call BuildAllClosedLoops — that would mutate live lines and
// replace the multi-profile pool (broke Pick/Next when nprof≥2).


// Expand arcs into LINE segs. FORCES vertices at every line×arc hit so a
// line drawn through the true arc also meets the polyline (anchors alone
// are not enough — inscribed n-gon chords can miss the real crossings).
// Clears n_arcs after.
Function.CAD_Sketch.TessellateArcs {
    Input: sketch_handle: Integer
    Input: nseg_max: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sketch_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg_max, 8) ThenBlock: { nseg_max = 32 }
        na = CAD_Store.Read(sketch_handle, 10)
        IfCondition EqualTo(na, 0) ThenBlock: { ReturnValue(0) }
        arcs = CAD_Store.Read(sketch_handle, 11)
        lines = CAD_Store.Read(sketch_handle, 1)
        nl = CAD_Store.Read(sketch_handle, 0)
        two_pi = 0x401921FB54442D18
        // store parameter t in [0,1] along arc span (0=a0, 1=a1)
        ts = Allocate(512)
        ai = 0
        WhileLoop LessThan(ai, na) {
            base = Multiply(ai, 5)
            cx = ArrayGet(arcs, base)
            cy = ArrayGet(arcs, Add(base, 1))
            rad = ArrayGet(arcs, Add(base, 2))
            a0 = ArrayGet(arcs, Add(base, 3))
            a1 = ArrayGet(arcs, Add(base, 4))
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            // Density: enough verts that profile fill matches display arc (shallow
            // scoops used to get nseg=4 and the red pad stopped under the purple curve).
            nseg = Float_ToInt(Float_Div(Float_Mul(Float_FromInt(nseg_max), span), 0x400921FB54442D18))
            // nseg_max * span / pi  (was / 2pi → half as many)
            IfCondition LessThan(nseg, 24) ThenBlock: { nseg = 24 }
            IfCondition GreaterThan(nseg, 256) ThenBlock: { nseg = 256 }
            nt = 0
            // uniform samples as t in [0,1]
            i = 0
            WhileLoop LessThan(i, Add(nseg, 1)) {
                ArraySet(ts, nt, Float_Div(Float_FromInt(i), Float_FromInt(nseg)))
                nt = Add(nt, 1)
                i = Add(i, 1)
            }
            // line × arc hits → t along span (PosMod2Pi / IsNeg — Float_Le(neg,0) broken)
            one = 0x3FF0000000000000
            epsa = 0x3F50624DD2F1A9FC
            li = 0
            WhileLoop LessThan(li, nl) {
                b = Multiply(li, 4)
                x0 = ArrayGet(lines, b)
                y0 = ArrayGet(lines, Add(b, 1))
                x1 = ArrayGet(lines, Add(b, 2))
                y1 = ArrayGet(lines, Add(b, 3))
                dx = Float_Sub(x1, x0)
                dy = Float_Sub(y1, y0)
                fx = Float_Sub(x0, cx)
                fy = Float_Sub(y0, cy)
                aa = Float_Add(CAD_Num.Sq(dx), CAD_Num.Sq(dy))
                IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 0) ThenBlock: {
                    bb = CAD_Num.Mul(0x4000000000000000, CAD_Num.Dot2(fx, fy, dx, dy))
                    cc = Float_Sub(Float_Add(CAD_Num.Sq(fx), CAD_Num.Sq(fy)), CAD_Num.Sq(rad))
                    disc = Float_Sub(CAD_Num.Sq(bb), CAD_Num.Mul(Float_Mul(0x4010000000000000, aa), cc))
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(CAD_Num.Abs(disc), Float_Mul(aa, epsa)), 1) ThenBlock: {
                            disc = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(disc), 0) ThenBlock: {
                        s = CAD_Num.Sqrt(disc)
                        two_a = Float_Mul(0x4000000000000000, aa)
                        ht0 = Float_Div(Float_Sub(Float_Sub(0, bb), s), two_a)
                        ht1 = Float_Div(Float_Add(Float_Sub(0, bb), s), two_a)
                        hi = 0
                        WhileLoop LessThan(hi, 2) {
                            tline = ht0
                            IfCondition EqualTo(hi, 1) ThenBlock: { tline = ht1 }
                            ok = 1
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(tline, epsa)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Add(one, epsa), tline)), 1) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                px = Float_Add(x0, Float_Mul(tline, dx))
                                py = Float_Add(y0, Float_Mul(tline, dy))
                                ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                                dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                                IfCondition EqualTo(Float_Le(dang, Float_Add(span, epsa)), 1) ThenBlock: {
                                    tt = 0
                                    IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                        tt = Float_Div(dang, span)
                                    }
                                    IfCondition EqualTo(CAD_Num.IsNeg(tt), 1) ThenBlock: { tt = 0 }
                                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(one, tt)), 1) ThenBlock: { tt = one }
                                    IfCondition LessThan(nt, 500) ThenBlock: {
                                        ArraySet(ts, nt, tt)
                                        nt = Add(nt, 1)
                                    }
                                }
                            }
                            hi = Add(hi, 1)
                        }
                    }
                }
                // line tips near rim → force tess sample (junction after SnapArcEnds)
                ei = 0
                WhileLoop LessThan(ei, 2) {
                    IfCondition EqualTo(ei, 0) ThenBlock: {
                        px = x0
                        py = y0
                    }
                    IfCondition EqualTo(ei, 1) ThenBlock: {
                        px = x1
                        py = y1
                    }
                    d = CAD_Num.Hypot2(Float_Sub(px, cx), Float_Sub(py, cy))
                    dd = CAD_Num.Abs(Float_Sub(d, rad))
                    IfCondition EqualTo(Float_Le(dd, Float_Mul(rad, 0x3F847AE147AE147B)), 1) ThenBlock: {
                        ang = CAD_Geom.Atan2(Float_Sub(py, cy), Float_Sub(px, cx))
                        dang = CAD_Num.PosMod2Pi(Float_Sub(ang, a0))
                        IfCondition EqualTo(Float_Le(dang, Float_Add(span, epsa)), 1) ThenBlock: {
                            tt = 0
                            IfCondition EqualTo(CAD_Num.IsZero(span, 0), 0) ThenBlock: {
                                tt = Float_Div(dang, span)
                            }
                            IfCondition EqualTo(CAD_Num.IsNeg(tt), 1) ThenBlock: { tt = 0 }
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(one, tt)), 1) ThenBlock: { tt = one }
                            IfCondition LessThan(nt, 500) ThenBlock: {
                                ArraySet(ts, nt, tt)
                                nt = Add(nt, 1)
                            }
                        }
                    }
                    ei = Add(ei, 1)
                }
                li = Add(li, 1)
            }
            // sort t ascending
            a = 0
            WhileLoop LessThan(a, nt) {
                bb = Add(a, 1)
                WhileLoop LessThan(bb, nt) {
                    va = ArrayGet(ts, a)
                    vb = ArrayGet(ts, bb)
                    IfCondition EqualTo(Float_Le(vb, va), 1) ThenBlock: {
                        ArraySet(ts, a, vb)
                        ArraySet(ts, bb, va)
                    }
                    bb = Add(bb, 1)
                }
                a = Add(a, 1)
            }
            // emit unique segments
            IfCondition GreaterThan(nt, 1) ThenBlock: {
                prev = ArrayGet(ts, 0)
                k = 1
                WhileLoop LessThan(k, nt) {
                    cur = ArrayGet(ts, k)
                    dt = Float_Sub(cur, prev)
                    IfCondition EqualTo(Float_Le(dt, 0x3F1A36E2EB1C432D), 0) ThenBlock: {
                        ang0 = Float_Add(a0, Float_Mul(span, prev))
                        ang1 = Float_Add(a0, Float_Mul(span, cur))
                        x0 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang0)))
                        y0 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang0)))
                        x1 = Float_Add(cx, Float_Mul(rad, CAD_Geom.Cos(ang1)))
                        y1 = Float_Add(cy, Float_Mul(rad, CAD_Geom.Sin(ang1)))
                        CAD_Sketch.AddLine(sketch_handle, x0, y0, x1, y1)
                        prev = cur
                    }
                    k = Add(k, 1)
                }
            }
            ai = Add(ai, 1)
        }
        Deallocate(ts, 512)
        CAD_Store.Write(sketch_handle, 10, 0)
        ReturnValue(CAD_Store.Read(sketch_handle, 0))
    }
}

// Split every LINE at crossings + T-junctions + circle/arc rim hits.
// Works with a single line against circles (nl==1) — critical for trim-to-point.
// Does NOT tessellate circles/arcs; live entities stay clean.
// Returns new line count.


// Signed area of primary loop (or profile 0). 0 if empty.
Function.CAD_Sketch.LoopSignedArea {
    Input: xy_addr: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        area = 0
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            xi = ArrayGet(xy_addr, Multiply(i, 2))
            yi = ArrayGet(xy_addr, Add(Multiply(i, 2), 1))
            xj = ArrayGet(xy_addr, Multiply(j, 2))
            yj = ArrayGet(xy_addr, Add(Multiply(j, 2), 1))
            area = Float_Add(area, Float_Sub(Float_Mul(xi, yj), Float_Mul(xj, yi)))
            i = Add(i, 1)
        }
        ReturnValue(Float_Div(area, 0x4000000000000000))
    }
}

// Snap any two line endpoints that lie within tol onto their midpoint.
// Closes freehand gaps between arc tessellation ends and nearby chords.
// Returns number of snaps performed.
// Snap dangling (valence-1) line endpoints onto the nearest other endpoint
// within tol. Closes freehand gaps between arc tess ends and chords WITHOUT
// collapsing dense tessellation vertices (those have valence ≥ 1 each side).
//
// CRITICAL (geometeryfail): never weld across open air using full sketch
// diagonal alone — that invented long "phantom" edges Profiles filled red.
// Cap snap by min(global_tol, 20% of this segment length).
// tol_r=0 → absolute tip eps. Only dangling ends.


// Snap any two line endpoints that lie within tol onto their midpoint.
// Closes freehand gaps between arc tessellation ends and nearby chords.
// Returns number of snaps performed.
// Snap dangling (valence-1) line endpoints onto the nearest other endpoint
// within tol. Closes freehand gaps between arc tess ends and chords WITHOUT
// collapsing dense tessellation vertices (those have valence ≥ 1 each side).
//
// CRITICAL (geometeryfail): never weld across open air using full sketch
// diagonal alone — that invented long "phantom" edges Profiles filled red.
// Cap snap by min(global_tol, 20% of this segment length).
// tol_r=0 → absolute tip eps. Only dangling ends.
