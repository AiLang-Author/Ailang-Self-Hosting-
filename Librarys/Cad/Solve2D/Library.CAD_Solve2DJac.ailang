// CAD.Solve2D Jacobian, residuals, and rank.
// API stays Function.CAD_Solve2D.*  (facade: Library.CAD_Solve2D).
// No pool here. Convergence uses CAD_Num / Num_Tol only.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Plex
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Sketch

// Push one residual. Mode 0 counts, 1 writes res, 2 writes res2.
Function.CAD_Solve2D.AddEq {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(CAD_Solve2D_State.row, 32) ThenBlock: {
            CAD_Solve2D_State.ovf = 1
            ReturnValue(-4)
        }
        IfCondition GreaterEqual(CAD_Solve2D_State.row, CAD_Solve2D_State.cape) ThenBlock: {
            CAD_Solve2D_State.ovf = 1
            ReturnValue(-4)
        }
        IfCondition EqualTo(CAD_Solve2D_State.mode, 1) ThenBlock: {
            ArraySet(CAD_Solve2D_State.res, CAD_Solve2D_State.row, CAD_Solve2D_State.rv)
        }
        IfCondition EqualTo(CAD_Solve2D_State.mode, 2) ThenBlock: {
            ArraySet(CAD_Solve2D_State.res2, CAD_Solve2D_State.row, CAD_Solve2D_State.rv)
        }
        CAD_Solve2D_State.row = Add(CAD_Solve2D_State.row, 1)
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.LoadCstr {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.e0 = Multiply(i, 8)
        CAD_Solve2D_State.ctype = ArrayGet(CAD_Solve2D_State.cstr, CAD_Solve2D_State.e0)
        CAD_Solve2D_State.e1 = Add(CAD_Solve2D_State.e0, 1)
        CAD_Solve2D_State.ka = ArrayGet(CAD_Solve2D_State.cstr, CAD_Solve2D_State.e1)
        CAD_Solve2D_State.e1 = Add(CAD_Solve2D_State.e0, 2)
        CAD_Solve2D_State.ia = ArrayGet(CAD_Solve2D_State.cstr, CAD_Solve2D_State.e1)
        CAD_Solve2D_State.e1 = Add(CAD_Solve2D_State.e0, 3)
        CAD_Solve2D_State.cval = ArrayGet(CAD_Solve2D_State.cstr, CAD_Solve2D_State.e1)
        CAD_Solve2D_State.e1 = Add(CAD_Solve2D_State.e0, 5)
        CAD_Solve2D_State.kb = ArrayGet(CAD_Solve2D_State.cstr, CAD_Solve2D_State.e1)
        CAD_Solve2D_State.e1 = Add(CAD_Solve2D_State.e0, 6)
        CAD_Solve2D_State.ib = ArrayGet(CAD_Solve2D_State.cstr, CAD_Solve2D_State.e1)
        CAD_Solve2D_State.dual = 0
        IfCondition GreaterEqual(CAD_Solve2D_State.ctype, 9) ThenBlock: {
            IfCondition NotEqual(CAD_Solve2D_State.ctype, 11) ThenBlock: {
                CAD_Solve2D_State.dual = 1
            }
        }
        ReturnValue(0)
    }
}

// slot 0 writes ax,ay. slot 1 writes bx,by. Does not touch ka/ia.
Function.CAD_Solve2D.GetPt {
    Input: kind: Integer
    Input: id: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.tk = kind
        CAD_Solve2D_State.ti = id
        CAD_Solve2D_State.slot = slot
        CAD_Sketch.GetTargetXY(CAD_Solve2D_State.sk, CAD_Solve2D_State.tk, CAD_Solve2D_State.ti, CAD_Solve2D_State.xy)
        CAD_Solve2D_State.px = ArrayGet(CAD_Solve2D_State.xy, 0)
        CAD_Solve2D_State.py = ArrayGet(CAD_Solve2D_State.xy, 1)
        IfCondition EqualTo(CAD_Solve2D_State.slot, 0) ThenBlock: {
            CAD_Solve2D_State.ax = CAD_Solve2D_State.px
            CAD_Solve2D_State.ay = CAD_Solve2D_State.py
        }
        IfCondition NotEqual(CAD_Solve2D_State.slot, 0) ThenBlock: {
            CAD_Solve2D_State.bx = CAD_Solve2D_State.px
            CAD_Solve2D_State.by = CAD_Solve2D_State.py
        }
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.DistAB {
    Output: Integer
    Body: {
        CAD_Solve2D_State.px = Float_Sub(CAD_Solve2D_State.bx, CAD_Solve2D_State.ax)
        CAD_Solve2D_State.py = Float_Sub(CAD_Solve2D_State.by, CAD_Solve2D_State.ay)
        CAD_Solve2D_State.rr = CAD_Num.Hypot2(CAD_Solve2D_State.px, CAD_Solve2D_State.py)
        ReturnValue(CAD_Solve2D_State.rr)
    }
}

Function.CAD_Solve2D.LineAt {
    Input: li: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.li = li
        CAD_Solve2D_State.p0 = CAD_Store.Read(CAD_Solve2D_State.sk, 1)
        CAD_Solve2D_State.k0 = CAD_Store.Read(CAD_Solve2D_State.sk, 0)
        IfCondition GreaterEqual(CAD_Solve2D_State.li, CAD_Solve2D_State.k0) ThenBlock: {
            ReturnValue(-1)
        }
        CAD_Solve2D_State.e0 = Multiply(CAD_Solve2D_State.li, 4)
        CAD_Solve2D_State.lx0 = ArrayGet(CAD_Solve2D_State.p0, CAD_Solve2D_State.e0)
        CAD_Solve2D_State.e1 = Add(CAD_Solve2D_State.e0, 1)
        CAD_Solve2D_State.ly0 = ArrayGet(CAD_Solve2D_State.p0, CAD_Solve2D_State.e1)
        CAD_Solve2D_State.e1 = Add(CAD_Solve2D_State.e0, 2)
        CAD_Solve2D_State.lx1 = ArrayGet(CAD_Solve2D_State.p0, CAD_Solve2D_State.e1)
        CAD_Solve2D_State.e1 = Add(CAD_Solve2D_State.e0, 3)
        CAD_Solve2D_State.ly1 = ArrayGet(CAD_Solve2D_State.p0, CAD_Solve2D_State.e1)
        ReturnValue(0)
    }
}

// Signed distance of (ax,ay) to the loaded line. Zero-length line: distance to the end.
Function.CAD_Solve2D.Signed {
    Output: Integer
    Body: {
        CAD_Solve2D_State.px = Float_Sub(CAD_Solve2D_State.lx1, CAD_Solve2D_State.lx0)
        CAD_Solve2D_State.py = Float_Sub(CAD_Solve2D_State.ly1, CAD_Solve2D_State.ly0)
        CAD_Solve2D_State.rr = CAD_Num.Hypot2(CAD_Solve2D_State.px, CAD_Solve2D_State.py)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Solve2D_State.rr, 0), 1) ThenBlock: {
            CAD_Solve2D_State.bx = CAD_Solve2D_State.lx0
            CAD_Solve2D_State.by = CAD_Solve2D_State.ly0
            CAD_Solve2D.DistAB()
            CAD_Solve2D_State.sd = CAD_Solve2D_State.rr
            ReturnValue(0)
        }
        CAD_Solve2D_State.mag = Float_Div(CAD_Solve2D_State.px, CAD_Solve2D_State.rr)
        CAD_Solve2D_State.rad = Float_Div(CAD_Solve2D_State.py, CAD_Solve2D_State.rr)
        CAD_Solve2D_State.px = Float_Sub(0, CAD_Solve2D_State.rad)
        CAD_Solve2D_State.py = CAD_Solve2D_State.mag
        CAD_Solve2D_State.ax = Float_Sub(CAD_Solve2D_State.ax, CAD_Solve2D_State.lx0)
        CAD_Solve2D_State.ay = Float_Sub(CAD_Solve2D_State.ay, CAD_Solve2D_State.ly0)
        CAD_Solve2D_State.sd = Float_Mul(CAD_Solve2D_State.ax, CAD_Solve2D_State.px)
        CAD_Solve2D_State.mag = Float_Mul(CAD_Solve2D_State.ay, CAD_Solve2D_State.py)
        CAD_Solve2D_State.sd = Float_Add(CAD_Solve2D_State.sd, CAD_Solve2D_State.mag)
        ReturnValue(0)
    }
}

// Mode 0 notes variables and counts equations. Mode 1/2 writes residuals.
Function.CAD_Solve2D.ApplyC {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.GetPt(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
            CAD_Solve2D_State.rv = CAD_Solve2D_State.ax
            CAD_Solve2D.AddEq()
            CAD_Solve2D_State.rv = CAD_Solve2D_State.ay
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteVar(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.GetPt(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.ax, CAD_Solve2D_State.cval)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 3) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteVar(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 1)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.GetPt(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.ay, CAD_Solve2D_State.cval)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 4) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteVar(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 1)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.GetPt(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
            CAD_Solve2D_State.rv = CAD_Solve2D_State.ay
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 5) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteVar(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.GetPt(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
            CAD_Solve2D_State.rv = CAD_Solve2D_State.ax
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 6) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.GetPt(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
            CAD_Solve2D_State.rr = CAD_Num.Hypot2(CAD_Solve2D_State.ax, CAD_Solve2D_State.ay)
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.rr, CAD_Solve2D_State.cval)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 7) ThenBlock: {
            IfCondition NotEqual(CAD_Solve2D_State.ka, 2) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteEnds(CAD_Solve2D_State.ia, 1)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.LineAt(CAD_Solve2D_State.ia)
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.ly1, CAD_Solve2D_State.ly0)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 8) ThenBlock: {
            IfCondition NotEqual(CAD_Solve2D_State.ka, 2) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteEnds(CAD_Solve2D_State.ia, 0)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.LineAt(CAD_Solve2D_State.ia)
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.lx1, CAD_Solve2D_State.lx0)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 9) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia)
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.kb, CAD_Solve2D_State.ib)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.GetPt(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
            CAD_Solve2D.GetPt(CAD_Solve2D_State.kb, CAD_Solve2D_State.ib, 1)
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.bx, CAD_Solve2D_State.ax)
            CAD_Solve2D.AddEq()
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.by, CAD_Solve2D_State.ay)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 10) ThenBlock: {
            IfCondition NotEqual(CAD_Solve2D_State.kb, 2) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia)
                CAD_Solve2D.NoteEnds(CAD_Solve2D_State.ib, 2)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.GetPt(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
            CAD_Solve2D.LineAt(CAD_Solve2D_State.ib)
            CAD_Solve2D.Signed()
            CAD_Solve2D_State.rv = CAD_Solve2D_State.sd
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 11) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteVar(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 2)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D_State.rad = CAD_Sketch.GetCircleRadius(CAD_Solve2D_State.sk, CAD_Solve2D_State.ia)
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.rad, CAD_Solve2D_State.cval)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 12) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteVar(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 2)
                CAD_Solve2D.NoteVar(CAD_Solve2D_State.kb, CAD_Solve2D_State.ib, 2)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D_State.rad = CAD_Sketch.GetCircleRadius(CAD_Solve2D_State.sk, CAD_Solve2D_State.ia)
            CAD_Solve2D_State.mag = CAD_Sketch.GetCircleRadius(CAD_Solve2D_State.sk, CAD_Solve2D_State.ib)
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.mag, CAD_Solve2D_State.rad)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 13) ThenBlock: {
            IfCondition NotEqual(CAD_Solve2D_State.ka, 2) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Solve2D_State.kb, 5) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteEnds(CAD_Solve2D_State.ia, 2)
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.kb, CAD_Solve2D_State.ib)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.LineAt(CAD_Solve2D_State.ia)
            CAD_Solve2D.GetPt(CAD_Solve2D_State.kb, CAD_Solve2D_State.ib, 0)
            CAD_Solve2D.Signed()
            CAD_Solve2D_State.rad = CAD_Sketch.CurveRadius(CAD_Solve2D_State.sk, CAD_Solve2D_State.kb, CAD_Solve2D_State.ib)
            CAD_Solve2D_State.mag = CAD_Solve2D_State.rad
            IfCondition EqualTo(Float_Le(CAD_Solve2D_State.sd, 0), 1) ThenBlock: {
                CAD_Solve2D_State.mag = Float_Sub(0, CAD_Solve2D_State.rad)
            }
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.sd, CAD_Solve2D_State.mag)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 14) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia)
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.kb, CAD_Solve2D_State.ib)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.GetPt(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
            CAD_Solve2D.GetPt(CAD_Solve2D_State.kb, CAD_Solve2D_State.ib, 1)
            CAD_Solve2D.DistAB()
            CAD_Solve2D_State.mag = CAD_Solve2D_State.rr
            CAD_Solve2D_State.rad = CAD_Sketch.CurveRadius(CAD_Solve2D_State.sk, CAD_Solve2D_State.ka, CAD_Solve2D_State.ia)
            CAD_Solve2D_State.px = CAD_Sketch.CurveRadius(CAD_Solve2D_State.sk, CAD_Solve2D_State.kb, CAD_Solve2D_State.ib)
            CAD_Solve2D_State.py = Float_Add(CAD_Solve2D_State.rad, CAD_Solve2D_State.px)
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.mag, CAD_Solve2D_State.py)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 15) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia)
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.kb, CAD_Solve2D_State.ib)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.GetPt(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
            CAD_Solve2D.GetPt(CAD_Solve2D_State.kb, CAD_Solve2D_State.ib, 1)
            CAD_Solve2D.DistAB()
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.rr, CAD_Solve2D_State.cval)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.ctype, 16) ThenBlock: {
            IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia)
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.kb, CAD_Solve2D_State.ib)
                IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
                CAD_Solve2D.AddEq()
                ReturnValue(0)
            }
            CAD_Solve2D.GetPt(CAD_Solve2D_State.ka, CAD_Solve2D_State.ia, 0)
            CAD_Solve2D.GetPt(CAD_Solve2D_State.kb, CAD_Solve2D_State.ib, 1)
            CAD_Solve2D.DistAB()
            CAD_Solve2D_State.mag = CAD_Solve2D_State.rr
            CAD_Solve2D_State.rad = CAD_Sketch.GetCircleRadius(CAD_Solve2D_State.sk, CAD_Solve2D_State.ib)
            CAD_Solve2D_State.rv = Float_Sub(CAD_Solve2D_State.mag, CAD_Solve2D_State.rad)
            CAD_Solve2D.AddEq()
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

// mode 0 packs. mode 1 fills res. mode 2 fills res2. Hard count stays neq.
Function.CAD_Solve2D.Walk {
    Input: mode: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.mode = mode
        CAD_Solve2D_State.row = 0
        IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
            CAD_Solve2D_State.nvar = 0
            CAD_Solve2D_State.ovf = 0
        }
        CAD_Solve2D_State.cstr = CAD_Store.Read(CAD_Solve2D_State.sk, 21)
        IfCondition EqualTo(CAD_Solve2D_State.cstr, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Solve2D_State.k0 = CAD_Store.Read(CAD_Solve2D_State.sk, 20)
        CAD_Solve2D_State.cur = 0
        CAD_Solve2D_State.done = 0
        WhileLoop EqualTo(CAD_Solve2D_State.done, 0) {
            IfCondition GreaterEqual(CAD_Solve2D_State.cur, CAD_Solve2D_State.k0) ThenBlock: {
                CAD_Solve2D_State.done = 1
            }
            IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: {
                CAD_Solve2D_State.done = 1
            }
            IfCondition EqualTo(CAD_Solve2D_State.done, 0) ThenBlock: {
                CAD_Solve2D.LoadCstr(CAD_Solve2D_State.cur)
                CAD_Solve2D.ApplyC()
                CAD_Solve2D_State.cur = Add(CAD_Solve2D_State.cur, 1)
            }
        }
        IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition EqualTo(CAD_Solve2D_State.mode, 0) ThenBlock: {
            CAD_Solve2D_State.neq = CAD_Solve2D_State.row
            IfCondition EqualTo(CAD_Solve2D_State.drag_on, 1) ThenBlock: {
                CAD_Solve2D.NoteXY(CAD_Solve2D_State.drag_kind, CAD_Solve2D_State.drag_id)
            }
            IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Solve2D_State.drag_on, 1) ThenBlock: {
            CAD_Solve2D.GetPt(CAD_Solve2D_State.drag_kind, CAD_Solve2D_State.drag_id, 0)
            CAD_Solve2D_State.px = Float_Sub(CAD_Solve2D_State.ax, CAD_Solve2D_State.drag_x)
            CAD_Solve2D_State.rv = Float_Mul(0x3FD0000000000000, CAD_Solve2D_State.px)
            CAD_Solve2D.AddEq()
            CAD_Solve2D.GetPt(CAD_Solve2D_State.drag_kind, CAD_Solve2D_State.drag_id, 0)
            CAD_Solve2D_State.py = Float_Sub(CAD_Solve2D_State.ay, CAD_Solve2D_State.drag_y)
            CAD_Solve2D_State.rv = Float_Mul(0x3FD0000000000000, CAD_Solve2D_State.py)
            CAD_Solve2D.AddEq()
        }
        CAD_Solve2D_State.ntot = CAD_Solve2D_State.row
        IfCondition EqualTo(CAD_Solve2D_State.ovf, 1) ThenBlock: { ReturnValue(-4) }
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.ReadAll {
    Output: Integer
    Body: {
        CAD_Solve2D_State.w = 0
        WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.nvar) {
            CAD_Solve2D_State.col = ArrayGet(CAD_Solve2D_State.vc, CAD_Solve2D_State.w)
            CAD_Solve2D_State.tk = ArrayGet(CAD_Solve2D_State.vk, CAD_Solve2D_State.w)
            CAD_Solve2D_State.ti = ArrayGet(CAD_Solve2D_State.vi, CAD_Solve2D_State.w)
            IfCondition EqualTo(CAD_Solve2D_State.col, 2) ThenBlock: {
                CAD_Solve2D_State.rad = CAD_Sketch.GetCircleRadius(CAD_Solve2D_State.sk, CAD_Solve2D_State.ti)
                ArraySet(CAD_Solve2D_State.xv, CAD_Solve2D_State.w, CAD_Solve2D_State.rad)
            }
            IfCondition NotEqual(CAD_Solve2D_State.col, 2) ThenBlock: {
                CAD_Sketch.GetTargetXY(CAD_Solve2D_State.sk, CAD_Solve2D_State.tk, CAD_Solve2D_State.ti, CAD_Solve2D_State.xy)
                CAD_Solve2D_State.col = ArrayGet(CAD_Solve2D_State.vc, CAD_Solve2D_State.w)
                CAD_Solve2D_State.px = ArrayGet(CAD_Solve2D_State.xy, CAD_Solve2D_State.col)
                ArraySet(CAD_Solve2D_State.xv, CAD_Solve2D_State.w, CAD_Solve2D_State.px)
            }
            CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.WriteOne {
    Input: col: Integer
    Output: Integer
    Body: {
        CAD_Solve2D_State.col = col
        CAD_Solve2D_State.slot = ArrayGet(CAD_Solve2D_State.vc, CAD_Solve2D_State.col)
        CAD_Solve2D_State.tk = ArrayGet(CAD_Solve2D_State.vk, CAD_Solve2D_State.col)
        CAD_Solve2D_State.ti = ArrayGet(CAD_Solve2D_State.vi, CAD_Solve2D_State.col)
        IfCondition EqualTo(CAD_Solve2D_State.slot, 2) ThenBlock: {
            CAD_Solve2D_State.rad = ArrayGet(CAD_Solve2D_State.xv, CAD_Solve2D_State.col)
            CAD_Sketch.SetCircleRadius(CAD_Solve2D_State.sk, CAD_Solve2D_State.ti, CAD_Solve2D_State.rad)
            ReturnValue(0)
        }
        CAD_Sketch.GetTargetXY(CAD_Solve2D_State.sk, CAD_Solve2D_State.tk, CAD_Solve2D_State.ti, CAD_Solve2D_State.xy)
        CAD_Solve2D_State.slot = ArrayGet(CAD_Solve2D_State.vc, CAD_Solve2D_State.col)
        IfCondition EqualTo(CAD_Solve2D_State.slot, 0) ThenBlock: {
            CAD_Solve2D_State.px = ArrayGet(CAD_Solve2D_State.xv, CAD_Solve2D_State.col)
            CAD_Solve2D_State.py = ArrayGet(CAD_Solve2D_State.xy, 1)
        }
        IfCondition EqualTo(CAD_Solve2D_State.slot, 1) ThenBlock: {
            CAD_Solve2D_State.px = ArrayGet(CAD_Solve2D_State.xy, 0)
            CAD_Solve2D_State.py = ArrayGet(CAD_Solve2D_State.xv, CAD_Solve2D_State.col)
        }
        CAD_Sketch.SetTargetXY(CAD_Solve2D_State.sk, CAD_Solve2D_State.tk, CAD_Solve2D_State.ti, CAD_Solve2D_State.px, CAD_Solve2D_State.py)
        ReturnValue(0)
    }
}

Function.CAD_Solve2D.WriteAll {
    Output: Integer
    Body: {
        CAD_Solve2D_State.w = 0
        WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.nvar) {
            CAD_Solve2D.WriteOne(CAD_Solve2D_State.w)
            CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
        }
        ReturnValue(0)
    }
}

// Sum of squares of residuals divided by Num_Tol.model_size. Result in ss1.
Function.CAD_Solve2D.Ss {
    Output: Integer
    Body: {
        CAD_Solve2D_State.ss1 = 0
        CAD_Solve2D_State.w = 0
        WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.ntot) {
            CAD_Solve2D_State.px = ArrayGet(CAD_Solve2D_State.res, CAD_Solve2D_State.w)
            CAD_Solve2D_State.px = Float_Div(CAD_Solve2D_State.px, Num_Tol.model_size)
            CAD_Solve2D_State.mag = Float_Mul(CAD_Solve2D_State.px, CAD_Solve2D_State.px)
            CAD_Solve2D_State.ss1 = Float_Add(CAD_Solve2D_State.ss1, CAD_Solve2D_State.mag)
            CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
        }
        ReturnValue(CAD_Solve2D_State.ss1)
    }
}

Function.CAD_Solve2D.HardOk {
    Output: Integer
    Body: {
        CAD_Solve2D_State.w = 0
        WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.neq) {
            CAD_Solve2D_State.px = ArrayGet(CAD_Solve2D_State.res, CAD_Solve2D_State.w)
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Solve2D_State.px, CAD_Solve2D_State.tol), 0) ThenBlock: {
                ReturnValue(0)
            }
            CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
        }
        ReturnValue(1)
    }
}

// Unweighted millimetres. The row itself is scaled by the drag weight.
Function.CAD_Solve2D.DragOk {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Solve2D_State.drag_on, 0) ThenBlock: { ReturnValue(1) }
        CAD_Solve2D.GetPt(CAD_Solve2D_State.drag_kind, CAD_Solve2D_State.drag_id, 0)
        CAD_Solve2D_State.px = Float_Sub(CAD_Solve2D_State.ax, CAD_Solve2D_State.drag_x)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Solve2D_State.px, CAD_Solve2D_State.tol), 0) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Solve2D_State.py = Float_Sub(CAD_Solve2D_State.ay, CAD_Solve2D_State.drag_y)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Solve2D_State.py, CAD_Solve2D_State.tol), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.CAD_Solve2D.MaxAbs {
    Output: Integer
    Body: {
        CAD_Solve2D_State.resid = 0
        CAD_Solve2D_State.w = 0
        WhileLoop LessThan(CAD_Solve2D_State.w, CAD_Solve2D_State.neq) {
            CAD_Solve2D_State.px = ArrayGet(CAD_Solve2D_State.res, CAD_Solve2D_State.w)
            CAD_Solve2D_State.mag = CAD_Num.Abs(CAD_Solve2D_State.px)
            IfCondition EqualTo(Float_Le(CAD_Solve2D_State.resid, CAD_Solve2D_State.mag), 1) ThenBlock: {
                CAD_Solve2D_State.resid = CAD_Solve2D_State.mag
            }
            CAD_Solve2D_State.w = Add(CAD_Solve2D_State.w, 1)
        }
        ReturnValue(CAD_Solve2D_State.resid)
    }
}

// Finite-difference J. Step is Num_Tol.linear. Column scale is Num_Tol.model_size.
// Does not use i0/j0 names that Rank owns across the call — uses j0 as the column
// and restores it only after Walk returns. Walk must not write j0, fac, or step.
Function.CAD_Solve2D.FillJ {
    Output: Integer
    Body: {
        CAD_Solve2D_State.step = Num_Tol.linear
        CAD_Solve2D_State.j0 = 0
        WhileLoop LessThan(CAD_Solve2D_State.j0, CAD_Solve2D_State.nvar) {
            CAD_Solve2D_State.fac = ArrayGet(CAD_Solve2D_State.xv, CAD_Solve2D_State.j0)
            CAD_Solve2D_State.px = Float_Add(CAD_Solve2D_State.fac, CAD_Solve2D_State.step)
            ArraySet(CAD_Solve2D_State.xv, CAD_Solve2D_State.j0, CAD_Solve2D_State.px)
            CAD_Solve2D.WriteOne(CAD_Solve2D_State.j0)
            CAD_Solve2D.Walk(2)
            ArraySet(CAD_Solve2D_State.xv, CAD_Solve2D_State.j0, CAD_Solve2D_State.fac)
            CAD_Solve2D.WriteOne(CAD_Solve2D_State.j0)
            CAD_Solve2D_State.i0 = 0
            WhileLoop LessThan(CAD_Solve2D_State.i0, CAD_Solve2D_State.ntot) {
                CAD_Solve2D_State.px = ArrayGet(CAD_Solve2D_State.res, CAD_Solve2D_State.i0)
                CAD_Solve2D_State.py = ArrayGet(CAD_Solve2D_State.res2, CAD_Solve2D_State.i0)
                CAD_Solve2D_State.px = Float_Sub(CAD_Solve2D_State.py, CAD_Solve2D_State.px)
                CAD_Solve2D_State.py = Float_Mul(CAD_Solve2D_State.step, Num_Tol.model_size)
                CAD_Solve2D_State.px = Float_Div(CAD_Solve2D_State.px, CAD_Solve2D_State.py)
                CAD_Num.MatSet(CAD_Solve2D_State.jj, CAD_Solve2D_State.nvar, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0, CAD_Solve2D_State.px)
                CAD_Solve2D_State.i0 = Add(CAD_Solve2D_State.i0, 1)
            }
            CAD_Solve2D_State.j0 = Add(CAD_Solve2D_State.j0, 1)
        }
        ReturnValue(0)
    }
}

// (J^T J + λ I) dx = -J^T r_hat. J and r_hat are already / model_size.
Function.CAD_Solve2D.BuildNormal {
    Output: Integer
    Body: {
        CAD_Solve2D_State.i0 = 0
        WhileLoop LessThan(CAD_Solve2D_State.i0, CAD_Solve2D_State.nvar) {
            CAD_Solve2D_State.j0 = 0
            WhileLoop LessThan(CAD_Solve2D_State.j0, CAD_Solve2D_State.nvar) {
                CAD_Solve2D_State.mag = 0
                IfCondition EqualTo(CAD_Solve2D_State.i0, CAD_Solve2D_State.j0) ThenBlock: {
                    CAD_Solve2D_State.mag = CAD_Solve2D_State.lam
                }
                CAD_Solve2D_State.k0 = 0
                WhileLoop LessThan(CAD_Solve2D_State.k0, CAD_Solve2D_State.ntot) {
                    CAD_Solve2D_State.px = CAD_Num.MatGet(CAD_Solve2D_State.jj, CAD_Solve2D_State.nvar, CAD_Solve2D_State.k0, CAD_Solve2D_State.i0)
                    CAD_Solve2D_State.py = CAD_Num.MatGet(CAD_Solve2D_State.jj, CAD_Solve2D_State.nvar, CAD_Solve2D_State.k0, CAD_Solve2D_State.j0)
                    CAD_Solve2D_State.rr = Float_Mul(CAD_Solve2D_State.px, CAD_Solve2D_State.py)
                    CAD_Solve2D_State.mag = Float_Add(CAD_Solve2D_State.mag, CAD_Solve2D_State.rr)
                    CAD_Solve2D_State.k0 = Add(CAD_Solve2D_State.k0, 1)
                }
                CAD_Num.MatSet(CAD_Solve2D_State.aa, CAD_Solve2D_State.nvar, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0, CAD_Solve2D_State.mag)
                CAD_Solve2D_State.j0 = Add(CAD_Solve2D_State.j0, 1)
            }
            CAD_Solve2D_State.rv = 0
            CAD_Solve2D_State.k0 = 0
            WhileLoop LessThan(CAD_Solve2D_State.k0, CAD_Solve2D_State.ntot) {
                CAD_Solve2D_State.px = ArrayGet(CAD_Solve2D_State.res, CAD_Solve2D_State.k0)
                CAD_Solve2D_State.px = Float_Div(CAD_Solve2D_State.px, Num_Tol.model_size)
                CAD_Solve2D_State.py = CAD_Num.MatGet(CAD_Solve2D_State.jj, CAD_Solve2D_State.nvar, CAD_Solve2D_State.k0, CAD_Solve2D_State.i0)
                CAD_Solve2D_State.rr = Float_Mul(CAD_Solve2D_State.py, CAD_Solve2D_State.px)
                CAD_Solve2D_State.rv = Float_Add(CAD_Solve2D_State.rv, CAD_Solve2D_State.rr)
                CAD_Solve2D_State.k0 = Add(CAD_Solve2D_State.k0, 1)
            }
            CAD_Solve2D_State.rv = Float_Sub(0, CAD_Solve2D_State.rv)
            ArraySet(CAD_Solve2D_State.rhs, CAD_Solve2D_State.i0, CAD_Solve2D_State.rv)
            CAD_Solve2D_State.i0 = Add(CAD_Solve2D_State.i0, 1)
        }
        ReturnValue(0)
    }
}

// Numerical rank of the hard rows. Pivot test is CAD_Num.IsZero(..., Num_Tol.param).
// Works on a copy so jj stays intact. CAD_Num.LU cannot count rank: it aborts on a small pivot.
Function.CAD_Solve2D.RankJ {
    Output: Integer
    Body: {
        CAD_Solve2D_State.rank = 0
        IfCondition EqualTo(CAD_Solve2D_State.neq, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Solve2D_State.nvar, 0) ThenBlock: { ReturnValue(0) }
        CAD_Solve2D_State.i0 = 0
        WhileLoop LessThan(CAD_Solve2D_State.i0, CAD_Solve2D_State.neq) {
            CAD_Solve2D_State.j0 = 0
            WhileLoop LessThan(CAD_Solve2D_State.j0, CAD_Solve2D_State.nvar) {
                CAD_Solve2D_State.px = CAD_Num.MatGet(CAD_Solve2D_State.jj, CAD_Solve2D_State.nvar, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0)
                CAD_Num.MatSet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0, CAD_Solve2D_State.px)
                CAD_Solve2D_State.j0 = Add(CAD_Solve2D_State.j0, 1)
            }
            CAD_Solve2D_State.i0 = Add(CAD_Solve2D_State.i0, 1)
        }
        CAD_Solve2D_State.lead = 0
        CAD_Solve2D_State.j0 = 0
        WhileLoop LessThan(CAD_Solve2D_State.j0, CAD_Solve2D_State.nvar) {
            IfCondition LessThan(CAD_Solve2D_State.lead, CAD_Solve2D_State.neq) ThenBlock: {
                CAD_Solve2D_State.best = CAD_Solve2D_State.lead
                CAD_Solve2D_State.px = CAD_Num.MatGet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.lead, CAD_Solve2D_State.j0)
                CAD_Solve2D_State.mag = CAD_Num.Abs(CAD_Solve2D_State.px)
                CAD_Solve2D_State.i0 = Add(CAD_Solve2D_State.lead, 1)
                WhileLoop LessThan(CAD_Solve2D_State.i0, CAD_Solve2D_State.neq) {
                    CAD_Solve2D_State.px = CAD_Num.MatGet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0)
                    CAD_Solve2D_State.py = CAD_Num.Abs(CAD_Solve2D_State.px)
                    CAD_Solve2D_State.e0 = Float_Le(CAD_Solve2D_State.mag, CAD_Solve2D_State.py)
                    CAD_Solve2D_State.e1 = NotEqual(CAD_Solve2D_State.py, CAD_Solve2D_State.mag)
                    CAD_Solve2D_State.slot = 0
                    IfCondition EqualTo(CAD_Solve2D_State.e0, 1) ThenBlock: {
                        CAD_Solve2D_State.slot = CAD_Solve2D_State.e1
                    }
                    IfCondition EqualTo(CAD_Solve2D_State.slot, 1) ThenBlock: {
                        CAD_Solve2D_State.best = CAD_Solve2D_State.i0
                        CAD_Solve2D_State.mag = CAD_Solve2D_State.py
                    }
                    CAD_Solve2D_State.i0 = Add(CAD_Solve2D_State.i0, 1)
                }
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Solve2D_State.mag, Num_Tol.param), 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Solve2D_State.best, CAD_Solve2D_State.lead) ThenBlock: {
                        CAD_Solve2D_State.k0 = 0
                        WhileLoop LessThan(CAD_Solve2D_State.k0, CAD_Solve2D_State.nvar) {
                            CAD_Solve2D_State.px = CAD_Num.MatGet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.lead, CAD_Solve2D_State.k0)
                            CAD_Solve2D_State.py = CAD_Num.MatGet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.best, CAD_Solve2D_State.k0)
                            CAD_Num.MatSet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.lead, CAD_Solve2D_State.k0, CAD_Solve2D_State.py)
                            CAD_Num.MatSet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.best, CAD_Solve2D_State.k0, CAD_Solve2D_State.px)
                            CAD_Solve2D_State.k0 = Add(CAD_Solve2D_State.k0, 1)
                        }
                    }
                    CAD_Solve2D_State.px = CAD_Num.MatGet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.lead, CAD_Solve2D_State.j0)
                    CAD_Solve2D_State.i0 = Add(CAD_Solve2D_State.lead, 1)
                    WhileLoop LessThan(CAD_Solve2D_State.i0, CAD_Solve2D_State.neq) {
                        CAD_Solve2D_State.py = CAD_Num.MatGet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.i0, CAD_Solve2D_State.j0)
                        CAD_Solve2D_State.fac = Float_Div(CAD_Solve2D_State.py, CAD_Solve2D_State.px)
                        CAD_Solve2D_State.k0 = CAD_Solve2D_State.j0
                        WhileLoop LessThan(CAD_Solve2D_State.k0, CAD_Solve2D_State.nvar) {
                            CAD_Solve2D_State.ax = CAD_Num.MatGet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.i0, CAD_Solve2D_State.k0)
                            CAD_Solve2D_State.ay = CAD_Num.MatGet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.lead, CAD_Solve2D_State.k0)
                            CAD_Solve2D_State.bx = Float_Mul(CAD_Solve2D_State.fac, CAD_Solve2D_State.ay)
                            CAD_Solve2D_State.ax = Float_Sub(CAD_Solve2D_State.ax, CAD_Solve2D_State.bx)
                            CAD_Num.MatSet(CAD_Solve2D_State.jw, CAD_Solve2D_State.nvar, CAD_Solve2D_State.i0, CAD_Solve2D_State.k0, CAD_Solve2D_State.ax)
                            CAD_Solve2D_State.k0 = Add(CAD_Solve2D_State.k0, 1)
                        }
                        CAD_Solve2D_State.i0 = Add(CAD_Solve2D_State.i0, 1)
                    }
                    CAD_Solve2D_State.rank = Add(CAD_Solve2D_State.rank, 1)
                    CAD_Solve2D_State.lead = Add(CAD_Solve2D_State.lead, 1)
                }
            }
            CAD_Solve2D_State.j0 = Add(CAD_Solve2D_State.j0, 1)
        }
        ReturnValue(CAD_Solve2D_State.rank)
    }
}
