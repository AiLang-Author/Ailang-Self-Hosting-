LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.StringUtils

Function.CAD_Tess.MeshCylinderAnalytic {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: defl_r: Integer
    Input: origin_addr: Address
    Input: out_mesh_addr: Address
    Output: Integer
    Body: {
        n = CAD_Tess.CircleSegCount(radius_r, defl_r)
        ox = ArrayGet(origin_addr, 0)
        oy = ArrayGet(origin_addr, 1)
        oz = ArrayGet(origin_addr, 2)
        v_base = Allocate(262144)
        i_base = Allocate(131072)
        two_pi = 0x401921FB54442D18
        nf = Float_FromInt(n)
        i = 0
        WhileLoop LessThan(i, n) {
            ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), nf))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            x = Float_Add(ox, Float_Mul(radius_r, c))
            y = Float_Add(oy, Float_Mul(radius_r, s))
            vo = Multiply(i, 3)
            ArraySet(v_base, vo, x)
            ArraySet(v_base, Add(vo, 1), y)
            ArraySet(v_base, Add(vo, 2), oz)
            vo2 = Multiply(Add(i, n), 3)
            ArraySet(v_base, vo2, x)
            ArraySet(v_base, Add(vo2, 1), y)
            ArraySet(v_base, Add(vo2, 2), Float_Add(oz, height_r))
            i = Add(i, 1)
        }
        tri = 0
        // side quads: (i, i+1, i+1+n) (i, i+1+n, i+n)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            ib = Add(i, n)
            jb = Add(j, n)
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, i)
            ArraySet(i_base, Add(t0, 1), j)
            ArraySet(i_base, Add(t0, 2), jb)
            tri = Add(tri, 1)
            t1 = Multiply(tri, 3)
            ArraySet(i_base, t1, i)
            ArraySet(i_base, Add(t1, 1), jb)
            ArraySet(i_base, Add(t1, 2), ib)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        // bottom cap fan from vertex 0 (approx center fan: use tris (0,i+1,i) for i=1..n-2)
        // better: introduce center? without center fan from 0 on ring
        i = 1
        WhileLoop LessThan(i, Subtract(n, 1)) {
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, 0)
            ArraySet(i_base, Add(t0, 1), Add(i, 1))
            ArraySet(i_base, Add(t0, 2), i)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        // top cap: fan from n, indices n..2n-1, outward so (n, n+i, n+i+1)
        i = 1
        WhileLoop LessThan(i, Subtract(n, 1)) {
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, n)
            ArraySet(i_base, Add(t0, 1), Add(n, i))
            ArraySet(i_base, Add(t0, 2), Add(n, Add(i, 1)))
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        ArraySet(out_mesh_addr, 0, Multiply(n, 2))
        ArraySet(out_mesh_addr, 1, tri)
        ArraySet(out_mesh_addr, 2, v_base)
        ArraySet(out_mesh_addr, 3, i_base)
        ArraySet(out_mesh_addr, 4, 262144)
        ArraySet(out_mesh_addr, 5, 131072)
        CAD_Tess_State.tess_count = Add(CAD_Tess_State.tess_count, 1)
        CAD_Tess_State.triangle_count = tri
        CAD_Tess_State.vertex_count = Multiply(n, 2)
        ReturnValue(tri)
    }
}

// Analytic tube mesh (kind 5): outer + inner cylinders + annular caps.
// Full closed 360 — no keyhole gap. n from CircleSegCount(r_out).
// pack: Store/params [0]=r_in [1]=r_out [2]=h [3]=ox [4]=oy [5]=oz
Function.CAD_Tess.MeshTubeAnalytic {
    Input: pack_addr: Address
    Input: defl_r: Integer
    Input: out_mesh_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(out_mesh_addr, 0) ThenBlock: { ReturnValue(-1) }
        r_in_r = CAD_Store.Read(pack_addr, 0)
        r_out_r = CAD_Store.Read(pack_addr, 1)
        height_r = CAD_Store.Read(pack_addr, 2)
        ox = CAD_Store.Read(pack_addr, 3)
        oy = CAD_Store.Read(pack_addr, 4)
        oz = CAD_Store.Read(pack_addr, 5)
        IfCondition EqualTo(Float_Le(r_out_r, r_in_r), 1) ThenBlock: { ReturnValue(-1) }
        n = CAD_Tess.CircleSegCount(r_out_r, defl_r)
        // verts: outer_bot 0..n-1, outer_top n..2n-1, inner_bot 2n..3n-1, inner_top 3n..4n-1
        v_base = Allocate(1048576)
        i_base = Allocate(524288)
        two_pi = 0x401921FB54442D18
        nf = Float_FromInt(n)
        i = 0
        WhileLoop LessThan(i, n) {
            ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), nf))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            xo = Float_Add(ox, Float_Mul(r_out_r, c))
            yo = Float_Add(oy, Float_Mul(r_out_r, s))
            xi = Float_Add(ox, Float_Mul(r_in_r, c))
            yi = Float_Add(oy, Float_Mul(r_in_r, s))
            zt = Float_Add(oz, height_r)
            // outer bot / top
            vo = Multiply(i, 3)
            ArraySet(v_base, vo, xo)
            ArraySet(v_base, Add(vo, 1), yo)
            ArraySet(v_base, Add(vo, 2), oz)
            vo = Multiply(Add(i, n), 3)
            ArraySet(v_base, vo, xo)
            ArraySet(v_base, Add(vo, 1), yo)
            ArraySet(v_base, Add(vo, 2), zt)
            // inner bot / top
            vo = Multiply(Add(i, Multiply(n, 2)), 3)
            ArraySet(v_base, vo, xi)
            ArraySet(v_base, Add(vo, 1), yi)
            ArraySet(v_base, Add(vo, 2), oz)
            vo = Multiply(Add(i, Multiply(n, 3)), 3)
            ArraySet(v_base, vo, xi)
            ArraySet(v_base, Add(vo, 1), yi)
            ArraySet(v_base, Add(vo, 2), zt)
            i = Add(i, 1)
        }
        tri = 0
        // outer side quads (outward)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            ib = Add(i, n)
            jb = Add(j, n)
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, i)
            ArraySet(i_base, Add(t0, 1), j)
            ArraySet(i_base, Add(t0, 2), jb)
            tri = Add(tri, 1)
            t1 = Multiply(tri, 3)
            ArraySet(i_base, t1, i)
            ArraySet(i_base, Add(t1, 1), jb)
            ArraySet(i_base, Add(t1, 2), ib)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        // inner side quads (inward: reverse winding)
        ob = Multiply(n, 2)
        ot = Multiply(n, 3)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            i0 = Add(ob, i)
            j0 = Add(ob, j)
            i1 = Add(ot, i)
            j1 = Add(ot, j)
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, i0)
            ArraySet(i_base, Add(t0, 1), i1)
            ArraySet(i_base, Add(t0, 2), j1)
            tri = Add(tri, 1)
            t1 = Multiply(tri, 3)
            ArraySet(i_base, t1, i0)
            ArraySet(i_base, Add(t1, 1), j1)
            ArraySet(i_base, Add(t1, 2), j0)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        // top annulus (outer_top → inner_top): (n+i, n+j, ot+j) (n+i, ot+j, ot+i)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            oi = Add(n, i)
            oj = Add(n, j)
            ii = Add(ot, i)
            ij = Add(ot, j)
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, oi)
            ArraySet(i_base, Add(t0, 1), oj)
            ArraySet(i_base, Add(t0, 2), ij)
            tri = Add(tri, 1)
            t1 = Multiply(tri, 3)
            ArraySet(i_base, t1, oi)
            ArraySet(i_base, Add(t1, 1), ij)
            ArraySet(i_base, Add(t1, 2), ii)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        // bottom annulus (outward -Z: reverse of top)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }
            oi = i
            oj = j
            ii = Add(ob, i)
            ij = Add(ob, j)
            t0 = Multiply(tri, 3)
            ArraySet(i_base, t0, oi)
            ArraySet(i_base, Add(t0, 1), ii)
            ArraySet(i_base, Add(t0, 2), ij)
            tri = Add(tri, 1)
            t1 = Multiply(tri, 3)
            ArraySet(i_base, t1, oi)
            ArraySet(i_base, Add(t1, 1), ij)
            ArraySet(i_base, Add(t1, 2), oj)
            tri = Add(tri, 1)
            i = Add(i, 1)
        }
        ArraySet(out_mesh_addr, 0, Multiply(n, 4))
        ArraySet(out_mesh_addr, 1, tri)
        ArraySet(out_mesh_addr, 2, v_base)
        ArraySet(out_mesh_addr, 3, i_base)
        ArraySet(out_mesh_addr, 4, 1048576)
        ArraySet(out_mesh_addr, 5, 524288)
        CAD_Tess_State.tess_count = Add(CAD_Tess_State.tess_count, 1)
        CAD_Tess_State.triangle_count = tri
        CAD_Tess_State.vertex_count = Multiply(n, 4)
        ReturnValue(tri)
    }
}

// Class A surface of revolution. pack: n, rmax, O(3), u(3), n(3), rz_ptr.
// Each RZ segment is a belt of CircleSegCount samples — cylinders/tori stay round.
Function.CAD_Tess.MeshLatheAnalytic {
    Input: pack_addr: Address
    Input: defl_r: Integer
    Input: out_mesh_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(out_mesh_addr, 0) ThenBlock: { ReturnValue(-1) }
        np = CAD_Store.Read(pack_addr, 0)
        rmax = CAD_Store.Read(pack_addr, 1)
        ox = CAD_Store.Read(pack_addr, 2)
        oy = CAD_Store.Read(pack_addr, 3)
        oz = CAD_Store.Read(pack_addr, 4)
        ux = CAD_Store.Read(pack_addr, 5)
        uy = CAD_Store.Read(pack_addr, 6)
        uz = CAD_Store.Read(pack_addr, 7)
        nx = CAD_Store.Read(pack_addr, 8)
        ny = CAD_Store.Read(pack_addr, 9)
        nz = CAD_Store.Read(pack_addr, 10)
        rz = CAD_Store.Read(pack_addr, 11)
        IfCondition EqualTo(rz, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(np, 3) ThenBlock: { ReturnValue(-1) }
        ul = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ux, ux), Float_Mul(uy, uy)), Float_Mul(uz, uz)))
        IfCondition EqualTo(CAD_Num.IsZero(ul, 0), 1) ThenBlock: {
            ux = 0
            uy = 0
            uz = 0x3FF0000000000000
            ul = 0x3FF0000000000000
        }
        ux = Float_Div(ux, ul)
        uy = Float_Div(uy, ul)
        uz = Float_Div(uz, ul)
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 1) ThenBlock: {
            nx = 0x3FF0000000000000
            ny = 0
            nz = 0
            nl = 0x3FF0000000000000
        }
        nx = Float_Div(nx, nl)
        ny = Float_Div(ny, nl)
        nz = Float_Div(nz, nl)
        // k = u × n  (out of sketch plane)
        kx = Float_Sub(Float_Mul(uy, nz), Float_Mul(uz, ny))
        ky = Float_Sub(Float_Mul(uz, nx), Float_Mul(ux, nz))
        kz = Float_Sub(Float_Mul(ux, ny), Float_Mul(uy, nx))
        kl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(kx, kx), Float_Mul(ky, ky)), Float_Mul(kz, kz)))
        IfCondition EqualTo(CAD_Num.IsZero(kl, 0), 0) ThenBlock: {
            kx = Float_Div(kx, kl)
            ky = Float_Div(ky, kl)
            kz = Float_Div(kz, kl)
        }
        nseg = CAD_Tess.CircleSegCount(rmax, defl_r)
        sweep_i = CAD_Store.Read(pack_addr, 12)
        IfCondition LessThan(sweep_i, 1) ThenBlock: { sweep_i = 360 }
        IfCondition GreaterThan(sweep_i, 360) ThenBlock: { sweep_i = 360 }
        IfCondition LessThan(sweep_i, 360) ThenBlock: {
            nseg = Divide(Multiply(nseg, sweep_i), 360)
            IfCondition LessThan(nseg, 8) ThenBlock: { nseg = 8 }
        }
        nv = Multiply(np, nseg)
        // 2 belts per profile step × nseg; indices = tris * 3
        ntri = Multiply(Multiply(np, nseg), 2)
        nidx = Multiply(ntri, 3)
        vbytes = Multiply(Multiply(nv, 3), 8)
        ibytes = Multiply(nidx, 8)
        IfCondition LessThan(vbytes, 64) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(ibytes, 64) ThenBlock: { ReturnValue(-1) }
        v_base = Allocate(vbytes)
        i_base = Allocate(ibytes)
        IfCondition EqualTo(v_base, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(i_base, 0) ThenBlock: {
            Deallocate(v_base, vbytes)
            ReturnValue(-1)
        }
        ArraySet(out_mesh_addr, 4, vbytes)
        ArraySet(out_mesh_addr, 5, ibytes)
        two_pi = 0x401921FB54442D18
        span = two_pi
        IfCondition LessThan(sweep_i, 360) ThenBlock: {
            span = Float_Mul(two_pi, Float_Div(Float_FromInt(sweep_i), Float_FromInt(360)))
        }
        ns = 0
        WhileLoop LessThan(ns, np) {
            rho = ArrayGet(rz, Multiply(ns, 2))
            zz = ArrayGet(rz, Add(Multiply(ns, 2), 1))
            j = 0
            WhileLoop LessThan(j, nseg) {
                den = nseg
                IfCondition LessThan(sweep_i, 360) ThenBlock: { den = Subtract(nseg, 1) }
                IfCondition LessThan(den, 1) ThenBlock: { den = 1 }
                ang = Float_Mul(span, Float_Div(Float_FromInt(j), Float_FromInt(den)))
                c = CAD_Geom.Cos(ang)
                s = CAD_Geom.Sin(ang)
                // P = O + z u + rho (c n + s k)
                px = Float_Add(ox, Float_Add(Float_Mul(zz, ux), Float_Mul(rho, Float_Add(Float_Mul(c, nx), Float_Mul(s, kx)))))
                py = Float_Add(oy, Float_Add(Float_Mul(zz, uy), Float_Mul(rho, Float_Add(Float_Mul(c, ny), Float_Mul(s, ky)))))
                pz = Float_Add(oz, Float_Add(Float_Mul(zz, uz), Float_Mul(rho, Float_Add(Float_Mul(c, nz), Float_Mul(s, kz)))))
                vo = Multiply(Add(Multiply(ns, nseg), j), 3)
                ArraySet(v_base, vo, px)
                ArraySet(v_base, Add(vo, 1), py)
                ArraySet(v_base, Add(vo, 2), pz)
                j = Add(j, 1)
            }
            ns = Add(ns, 1)
        }
        tri = 0
        ns = 0
        WhileLoop LessThan(ns, np) {
            n2 = Add(ns, 1)
            IfCondition EqualTo(n2, np) ThenBlock: { n2 = 0 }
            j = 0
            jmax = nseg
            IfCondition LessThan(sweep_i, 360) ThenBlock: { jmax = Subtract(nseg, 1) }
            WhileLoop LessThan(j, jmax) {
                jn = Add(j, 1)
                IfCondition EqualTo(jn, nseg) ThenBlock: { jn = 0 }
                a = Add(Multiply(ns, nseg), j)
                b = Add(Multiply(ns, nseg), jn)
                c = Add(Multiply(n2, nseg), jn)
                d = Add(Multiply(n2, nseg), j)
                t0 = Multiply(tri, 3)
                ArraySet(i_base, t0, a)
                ArraySet(i_base, Add(t0, 1), b)
                ArraySet(i_base, Add(t0, 2), c)
                tri = Add(tri, 1)
                t1 = Multiply(tri, 3)
                ArraySet(i_base, t1, a)
                ArraySet(i_base, Add(t1, 1), c)
                ArraySet(i_base, Add(t1, 2), d)
                tri = Add(tri, 1)
                j = Add(j, 1)
            }
            ns = Add(ns, 1)
        }
        // Open sweep: fan end caps at j=0 and j=last
        IfCondition LessThan(sweep_i, 360) ThenBlock: {
            IfCondition GreaterThan(np, 2) ThenBlock: {
                jlast = Subtract(nseg, 1)
                capj = 0
                WhileLoop LessThan(capj, 2) {
                    jj = 0
                    IfCondition EqualTo(capj, 1) ThenBlock: { jj = jlast }
                    i = 1
                    WhileLoop LessThan(i, Subtract(np, 1)) {
                        a = jj
                        b = Add(Multiply(i, nseg), jj)
                        c = Add(Multiply(Add(i, 1), nseg), jj)
                        t0 = Multiply(tri, 3)
                        IfCondition EqualTo(capj, 0) ThenBlock: {
                            ArraySet(i_base, t0, a)
                            ArraySet(i_base, Add(t0, 1), b)
                            ArraySet(i_base, Add(t0, 2), c)
                        }
                        IfCondition EqualTo(capj, 1) ThenBlock: {
                            ArraySet(i_base, t0, a)
                            ArraySet(i_base, Add(t0, 1), c)
                            ArraySet(i_base, Add(t0, 2), b)
                        }
                        tri = Add(tri, 1)
                        i = Add(i, 1)
                    }
                    capj = Add(capj, 1)
                }
            }
        }
        ArraySet(out_mesh_addr, 0, nv)
        ArraySet(out_mesh_addr, 1, tri)
        ArraySet(out_mesh_addr, 2, v_base)
        ArraySet(out_mesh_addr, 3, i_base)
        CAD_Tess_State.tess_count = Add(CAD_Tess_State.tess_count, 1)
        CAD_Tess_State.triangle_count = tri
        CAD_Tess_State.vertex_count = nv
        ReturnValue(tri)
    }
}

// Ray from (cx,cy) at angle hits axis-aligned rect [0,dx]x[0,dy] — outer rim point.
// out_xy: [x,y]
Function.CAD_Tess.RayHitRect2D {
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: ang_r: Integer
    Input: pack_addr: Address
    Output: Integer
    Body: {
        // pack: [0]=dx [1]=dy [2]=out_x [3]=out_y
        dx = ArrayGet(pack_addr, 0)
        dy = ArrayGet(pack_addr, 1)
        c = CAD_Geom.Cos(ang_r)
        s = CAD_Geom.Sin(ang_r)
        // large t candidates for each side
        big = 0x412E848000000000
        t_best = big
        // vertical sides x=0, x=dx
        IfCondition NotEqual(CAD_Num.IsZero(c, 0), 1) ThenBlock: {
            t0 = Float_Div(Float_Sub(0, cx_r), c)
            IfCondition EqualTo(Float_Le(0, t0), 1) ThenBlock: {
                y0 = Float_Add(cy_r, Float_Mul(t0, s))
                IfCondition EqualTo(Float_Le(0, y0), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(y0, dy), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(t0, t_best), 1) ThenBlock: { t_best = t0 }
                    }
                }
            }
            t1 = Float_Div(Float_Sub(dx, cx_r), c)
            IfCondition EqualTo(Float_Le(0, t1), 1) ThenBlock: {
                y1 = Float_Add(cy_r, Float_Mul(t1, s))
                IfCondition EqualTo(Float_Le(0, y1), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(y1, dy), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(t1, t_best), 1) ThenBlock: { t_best = t1 }
                    }
                }
            }
        }
        IfCondition NotEqual(CAD_Num.IsZero(s, 0), 1) ThenBlock: {
            t2 = Float_Div(Float_Sub(0, cy_r), s)
            IfCondition EqualTo(Float_Le(0, t2), 1) ThenBlock: {
                x2 = Float_Add(cx_r, Float_Mul(t2, c))
                IfCondition EqualTo(Float_Le(0, x2), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(x2, dx), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(t2, t_best), 1) ThenBlock: { t_best = t2 }
                    }
                }
            }
            t3 = Float_Div(Float_Sub(dy, cy_r), s)
            IfCondition EqualTo(Float_Le(0, t3), 1) ThenBlock: {
                x3 = Float_Add(cx_r, Float_Mul(t3, c))
                IfCondition EqualTo(Float_Le(0, x3), 1) ThenBlock: {
                    IfCondition EqualTo(Float_Le(x3, dx), 1) ThenBlock: {
                        IfCondition EqualTo(Float_Le(t3, t_best), 1) ThenBlock: { t_best = t3 }
                    }
                }
            }
        }
        ArraySet(pack_addr, 2, Float_Add(cx_r, Float_Mul(t_best, c)))
        ArraySet(pack_addr, 3, Float_Add(cy_r, Float_Mul(t_best, s)))
        ReturnValue(0)
    }
}

// Which rect edge a boundary point lies on: 0=y0 1=x=dx 2=y=dy 3=x=0
// pack_addr: [0]=dx [1]=dy [2]=x [3]=y → returns edge id in pack[4]
Function.CAD_Tess.RectEdgeId {
    Input: pack_addr: Address
    Output: Integer
    Body: {
        dx = ArrayGet(pack_addr, 0)
        dy = ArrayGet(pack_addr, 1)
        x = ArrayGet(pack_addr, 2)
        y = ArrayGet(pack_addr, 3)
        tol = 0x3F50624DD2F1A9FC
        // 1e-3
        d0 = y
        IfCondition EqualTo(Float_Le(d0, 0), 1) ThenBlock: { d0 = Float_Sub(0, d0) }
        d1 = Float_Sub(dx, x)
        IfCondition EqualTo(Float_Le(d1, 0), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
        d2 = Float_Sub(dy, y)
        IfCondition EqualTo(Float_Le(d2, 0), 1) ThenBlock: { d2 = Float_Sub(0, d2) }
        d3 = x
        IfCondition EqualTo(Float_Le(d3, 0), 1) ThenBlock: { d3 = Float_Sub(0, d3) }
        eid = 0
        best = d0
        IfCondition EqualTo(Float_Le(d1, best), 1) ThenBlock: {
            best = d1
            eid = 1
        }
        IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
            best = d2
            eid = 2
        }
        IfCondition EqualTo(Float_Le(d3, best), 1) ThenBlock: {
            eid = 3
        }
        ArraySet(pack_addr, 4, eid)
        ReturnValue(eid)
    }
}

// Ear-clip a simple 2D polygon (vertex indices into v_base xyz).
// pack: [0]=npoly, [1]=tri_count in/out, [2]=flip (1 → reverse winding for bottom).
// Sign of (B-A)×(C-A) in XY. No heap.
Function.CAD_Tess.OrientXY {
    Input: v_base: Address
    Input: ia: Integer
    Input: ib: Integer
    Input: ic: Integer
    Output: Integer
    Body: {
        ax = ArrayGet(v_base, Multiply(ia, 3))
        ay = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
        bx = ArrayGet(v_base, Multiply(ib, 3))
        by = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
        cx = ArrayGet(v_base, Multiply(ic, 3))
        cy = ArrayGet(v_base, Add(Multiply(ic, 3), 1))
        det = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(cy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(cx, ax)))
        IfCondition EqualTo(CAD_Num.IsZero(det, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsNeg(det), 1) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        ReturnValue(1)
    }
}

// Point on an open meridian circle at this row's z, if that angle sits on
// the minor arc. Writes vb[vi] and returns 1. Locals only: the torus grid
// still owns Tess_State across the call. 0 leaves the analytic point.
Function.CAD_Tess.MerPointAtZ {
    Input: edge: Integer
    Input: vb: Address
    Input: vi: Integer
    Input: abuf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(abuf, 0) ThenBlock: { ReturnValue(0) }
        crv = CAD_Store.Read(edge, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        ck = CAD_Store.Read(crv, 0)
        IfCondition EqualTo(ck, 5) ThenBlock: {
            ReturnValue(CAD_Tess.CopePointAtZ(edge, vb, vi, abuf))
        }
        IfCondition EqualTo(ck, 6) ThenBlock: {
            ReturnValue(CAD_Tess.ArcArcPointAtZ(edge, vb, vi, abuf))
        }
        IfCondition NotEqual(ck, 2) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(crv, 1)
        cy = CAD_Store.Read(crv, 2)
        cz = CAD_Store.Read(crv, 3)
        xx = CAD_Store.Read(crv, 4)
        xy = CAD_Store.Read(crv, 5)
        xz = CAD_Store.Read(crv, 6)
        yx = CAD_Store.Read(crv, 7)
        yy = CAD_Store.Read(crv, 8)
        yz = CAD_Store.Read(crv, 9)
        rr = CAD_Store.Read(crv, 10)
        sp = CAD_Store.Read(crv, 12)
        IfCondition EqualTo(CAD_Num.IsZero(rr, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(sp, 0), 1) ThenBlock: { ReturnValue(0) }
        ev0 = CAD_Store.Read(edge, 0)
        IfCondition EqualTo(ev0, 0) ThenBlock: { ReturnValue(0) }
        dx = Float_Sub(CAD_Store.Read(ev0, 0), cx)
        dy = Float_Sub(CAD_Store.Read(ev0, 1), cy)
        dz = Float_Sub(CAD_Store.Read(ev0, 2), cz)
        ax = Float_Add(Float_Add(Float_Mul(dx, xx), Float_Mul(dy, xy)), Float_Mul(dz, xz))
        ay = Float_Add(Float_Add(Float_Mul(dx, yx), Float_Mul(dy, yy)), Float_Mul(dz, yz))
        a0 = CAD_Geom.Atan2(ay, ax)
        zz = ArrayGet(vb, Add(Multiply(vi, 3), 2))
        aa = Float_Mul(rr, xz)
        bb = Float_Mul(rr, yz)
        dd = Float_Sub(zz, cz)
        IfCondition NotEqual(CAD_Topo.FilletSolveAng(aa, bb, dd, abuf), 2) ThenBlock: { ReturnValue(0) }
        gx = ArrayGet(vb, Multiply(vi, 3))
        gy = ArrayGet(vb, Add(Multiply(vi, 3), 1))
        gz = zz
        pi = 0x400921FB54442D18
        two = 0x401921FB54442D18
        slack = 0x3FB47AE147AE147B
        got = 0
        best = 0
        bx = 0
        by = 0
        bz = 0
        i = 0
        WhileLoop LessThan(i, 2) {
            ang = ArrayGet(abuf, i)
            rel = Float_Sub(ang, a0)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, rel)), 1) ThenBlock: { rel = Float_Sub(rel, two) }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(rel, Float_Sub(0, pi))), 1) ThenBlock: { rel = Float_Add(rel, two) }
            on = 0
            IfCondition EqualTo(CAD_Num.Le(Float_Sub(0, slack), rel), 1) ThenBlock: { on = 1 }
            IfCondition EqualTo(CAD_Num.Le(rel, Float_Add(sp, slack)), 0) ThenBlock: { on = 0 }
            IfCondition EqualTo(on, 1) ThenBlock: {
                ct = CAD_Geom.Cos(ang)
                st = CAD_Geom.Sin(ang)
                px = Float_Add(cx, Float_Add(Float_Mul(Float_Mul(rr, ct), xx), Float_Mul(Float_Mul(rr, st), yx)))
                py = Float_Add(cy, Float_Add(Float_Mul(Float_Mul(rr, ct), xy), Float_Mul(Float_Mul(rr, st), yy)))
                pz = Float_Add(cz, Float_Add(Float_Mul(Float_Mul(rr, ct), xz), Float_Mul(Float_Mul(rr, st), yz)))
                d2 = Float_Add(Float_Add(CAD_Num.Sq(Float_Sub(px, gx)), CAD_Num.Sq(Float_Sub(py, gy))), CAD_Num.Sq(Float_Sub(pz, gz)))
                use = 0
                IfCondition EqualTo(got, 0) ThenBlock: { use = 1 }
                IfCondition EqualTo(CAD_Num.Le(d2, best), 1) ThenBlock: { use = 1 }
                IfCondition EqualTo(use, 1) ThenBlock: {
                    got = 1
                    best = d2
                    bx = px
                    by = py
                    bz = pz
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(vb, Multiply(vi, 3), bx)
        ArraySet(vb, Add(Multiply(vi, 3), 1), by)
        ArraySet(vb, Add(Multiply(vi, 3), 2), bz)
        ReturnValue(1)
    }
}

// Open torus whose end column was snapped onto a kind-5 cope. The lid
// rail and the wall rail do not share a major angle, so a constant-u
// grid shears the last column into a round step. Interior columns
// take the major angle between the two snapped ends at that row.
// Quarter-circle ends (kind 2) are not passed here.
Function.CAD_Tess.TorusCopeBlend {
    Input: vb: Address
    Input: surf: Integer
    Input: spec: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(spec, 0) ThenBlock: { ReturnValue(0) }
        base_i = ArrayGet(spec, 0)
        nu = ArrayGet(spec, 1)
        nv = ArrayGet(spec, 2)
        a0 = ArrayGet(spec, 3)
        span = ArrayGet(spec, 4)
        rmaj = ArrayGet(spec, 5)
        rmin = ArrayGet(spec, 6)
        IfCondition LessThan(nu, 3) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nv, 1) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(surf, 1)
        cy = CAD_Store.Read(surf, 2)
        cz = CAD_Store.Read(surf, 3)
        xx = CAD_Store.Read(surf, 4)
        xy = CAD_Store.Read(surf, 5)
        xz = CAD_Store.Read(surf, 6)
        yx = CAD_Store.Read(surf, 7)
        yy = CAD_Store.Read(surf, 8)
        yz = CAD_Store.Read(surf, 9)
        zx = CAD_Store.Read(surf, 10)
        zy = CAD_Store.Read(surf, 11)
        zz = CAD_Store.Read(surf, 12)
        pi = 0x400921FB54442D18
        two = 0x401921FB54442D18
        stride = Add(nv, 1)
        last = Subtract(nu, 1)
        sj = 0
        WhileLoop LessEqual(sj, nv) {
            i0 = Add(base_i, sj)
            i1 = Add(base_i, Add(Multiply(last, stride), sj))
            p0x = ArrayGet(vb, Multiply(i0, 3))
            p0y = ArrayGet(vb, Add(Multiply(i0, 3), 1))
            p0z = ArrayGet(vb, Add(Multiply(i0, 3), 2))
            p1x = ArrayGet(vb, Multiply(i1, 3))
            p1y = ArrayGet(vb, Add(Multiply(i1, 3), 1))
            p1z = ArrayGet(vb, Add(Multiply(i1, 3), 2))
            d0x = Float_Sub(p0x, cx)
            d0y = Float_Sub(p0y, cy)
            d0z = Float_Sub(p0z, cz)
            d1x = Float_Sub(p1x, cx)
            d1y = Float_Sub(p1y, cy)
            d1z = Float_Sub(p1z, cz)
            u0s = Float_Add(Float_Add(Float_Mul(d0x, yx), Float_Mul(d0y, yy)), Float_Mul(d0z, yz))
            u0c = Float_Add(Float_Add(Float_Mul(d0x, xx), Float_Mul(d0y, xy)), Float_Mul(d0z, xz))
            u1s = Float_Add(Float_Add(Float_Mul(d1x, yx), Float_Mul(d1y, yy)), Float_Mul(d1z, yz))
            u1c = Float_Add(Float_Add(Float_Mul(d1x, xx), Float_Mul(d1y, xy)), Float_Mul(d1z, xz))
            u0 = CAD_Geom.Atan2(u0s, u0c)
            u1 = CAD_Geom.Atan2(u1s, u1c)
            du = Float_Sub(u1, u0)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, du)), 1) ThenBlock: { du = Float_Sub(du, two) }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(du, Float_Sub(0, pi))), 1) ThenBlock: { du = Float_Add(du, two) }
            vv = Float_Add(a0, Float_Mul(span, Float_Div(Float_FromInt(sj), Float_FromInt(nv))))
            cv = CAD_Geom.Cos(vv)
            svs = CAD_Geom.Sin(vv)
            rho = Float_Add(rmaj, Float_Mul(rmin, cv))
            rad = Float_Mul(rmin, svs)
            si = 1
            WhileLoop LessThan(si, last) {
                tt = Float_Div(Float_FromInt(si), Float_FromInt(last))
                uu = Float_Add(u0, Float_Mul(tt, du))
                cu = CAD_Geom.Cos(uu)
                su = CAD_Geom.Sin(uu)
                px = Float_Add(cx, Float_Add(Float_Mul(rho, Float_Add(Float_Mul(cu, xx), Float_Mul(su, yx))), Float_Mul(rad, zx)))
                py = Float_Add(cy, Float_Add(Float_Mul(rho, Float_Add(Float_Mul(cu, xy), Float_Mul(su, yy))), Float_Mul(rad, zy)))
                pz = Float_Add(cz, Float_Add(Float_Mul(rho, Float_Add(Float_Mul(cu, xz), Float_Mul(su, yz))), Float_Mul(rad, zz)))
                vi = Add(base_i, Add(Multiply(si, stride), sj))
                ArraySet(vb, Multiply(vi, 3), px)
                ArraySet(vb, Add(Multiply(vi, 3), 1), py)
                ArraySet(vb, Add(Multiply(vi, 3), 2), pz)
                si = Add(si, 1)
            }
            sj = Add(sj, 1)
        }
        ReturnValue(1)
    }
}

// 1 if vertex v is farther than 0.05 mm from fr[i0..i0+2] on any axis.
Function.CAD_Tess.PosFar {
    Input: v: Integer
    Input: fr: Address
    Input: i0: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(1) }
        dx = CAD_Num.Abs(Float_Sub(CAD_Store.Read(v, 0), ArrayGet(fr, i0)))
        IfCondition EqualTo(CAD_Num.Le(0x3FA999999999999A, dx), 1) ThenBlock: { ReturnValue(1) }
        dy = CAD_Num.Abs(Float_Sub(CAD_Store.Read(v, 1), ArrayGet(fr, Add(i0, 1))))
        IfCondition EqualTo(CAD_Num.Le(0x3FA999999999999A, dy), 1) ThenBlock: { ReturnValue(1) }
        dz = CAD_Num.Abs(Float_Sub(CAD_Store.Read(v, 2), ArrayGet(fr, Add(i0, 2))))
        IfCondition EqualTo(CAD_Num.Le(0x3FA999999999999A, dz), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 if either endpoint of edge lies on fr[i0].
Function.CAD_Tess.EdgeNear {
    Input: edge: Integer
    Input: fr: Address
    Input: i0: Integer
    Output: Integer
    Body: {
        hit = 0
        v = 0
        IfCondition NotEqual(edge, 0) ThenBlock: { v = CAD_Store.Read(edge, 0) }
        IfCondition EqualTo(CAD_Tess.PosFar(v, fr, i0), 0) ThenBlock: { hit = 1 }
        v = 0
        IfCondition NotEqual(edge, 0) ThenBlock: { v = CAD_Store.Read(edge, 1) }
        IfCondition EqualTo(CAD_Tess.PosFar(v, fr, i0), 0) ThenBlock: { hit = 1 }
        ReturnValue(hit)
    }
}

// Unit fr[src..+2] into fr[dst]. 0 if the length is zero. Sqrt stays here.
Function.CAD_Tess.VecUnitAt {
    Input: fr: Address
    Input: src: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        ArraySet(CAD_Tess_State.pack, 23, fr)
        CAD_Tess_State.zip_ao = src
        CAD_Tess_State.zip_ah = dst
        x = ArrayGet(fr, src)
        y = ArrayGet(fr, Add(src, 1))
        z = ArrayGet(fr, Add(src, 2))
        len = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(x, x), Float_Mul(y, y)), Float_Mul(z, z)))
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        src = CAD_Tess_State.zip_ao
        dst = CAD_Tess_State.zip_ah
        ArraySet(fr, 39, len)
        x = ArrayGet(fr, src)
        y = ArrayGet(fr, Add(src, 1))
        z = ArrayGet(fr, Add(src, 2))
        IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(fr, 39), 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(fr, dst, Float_Div(x, ArrayGet(fr, 39)))
        ArraySet(fr, Add(dst, 1), Float_Div(y, ArrayGet(fr, 39)))
        ArraySet(fr, Add(dst, 2), Float_Div(z, ArrayGet(fr, 39)))
        ReturnValue(1)
    }
}

// Unit of (fr[src] - fr[c0]) with the fr[n0] component removed, written at dst.
Function.CAD_Tess.VecRejectUnit {
    Input: fr: Address
    Input: src: Integer
    Input: c0: Integer
    Input: n0: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        ArraySet(fr, 34, Float_Sub(ArrayGet(fr, src), ArrayGet(fr, c0)))
        ArraySet(fr, 35, Float_Sub(ArrayGet(fr, Add(src, 1)), ArrayGet(fr, Add(c0, 1))))
        ArraySet(fr, 36, Float_Sub(ArrayGet(fr, Add(src, 2)), ArrayGet(fr, Add(c0, 2))))
        ArraySet(fr, 39, Float_Add(Float_Add(Float_Mul(ArrayGet(fr, 34), ArrayGet(fr, n0)), Float_Mul(ArrayGet(fr, 35), ArrayGet(fr, Add(n0, 1)))), Float_Mul(ArrayGet(fr, 36), ArrayGet(fr, Add(n0, 2)))))
        ArraySet(fr, 34, Float_Sub(ArrayGet(fr, 34), Float_Mul(ArrayGet(fr, 39), ArrayGet(fr, n0))))
        ArraySet(fr, 35, Float_Sub(ArrayGet(fr, 35), Float_Mul(ArrayGet(fr, 39), ArrayGet(fr, Add(n0, 1)))))
        ArraySet(fr, 36, Float_Sub(ArrayGet(fr, 36), Float_Mul(ArrayGet(fr, 39), ArrayGet(fr, Add(n0, 2)))))
        ReturnValue(CAD_Tess.VecUnitAt(fr, 34, dst))
    }
}

// Unit of fr[a0] cross fr[b0], written at dst.
Function.CAD_Tess.VecCrossUnit {
    Input: fr: Address
    Input: a0: Integer
    Input: b0: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        ArraySet(fr, 34, Float_Sub(Float_Mul(ArrayGet(fr, Add(a0, 1)), ArrayGet(fr, Add(b0, 2))), Float_Mul(ArrayGet(fr, Add(a0, 2)), ArrayGet(fr, Add(b0, 1)))))
        ArraySet(fr, 35, Float_Sub(Float_Mul(ArrayGet(fr, Add(a0, 2)), ArrayGet(fr, b0)), Float_Mul(ArrayGet(fr, a0), ArrayGet(fr, Add(b0, 2)))))
        ArraySet(fr, 36, Float_Sub(Float_Mul(ArrayGet(fr, a0), ArrayGet(fr, Add(b0, 1))), Float_Mul(ArrayGet(fr, Add(a0, 1)), ArrayGet(fr, b0))))
        ReturnValue(CAD_Tess.VecUnitAt(fr, 34, dst))
    }
}

Function.CAD_Tess.SphereSwapEnds {
    Input: fr: Address
    Output: Integer
    Body: {
        ArraySet(fr, 39, ArrayGet(fr, 22))
        ArraySet(fr, 22, ArrayGet(fr, 25))
        ArraySet(fr, 25, ArrayGet(fr, 39))
        ArraySet(fr, 39, ArrayGet(fr, 23))
        ArraySet(fr, 23, ArrayGet(fr, 26))
        ArraySet(fr, 26, ArrayGet(fr, 39))
        ArraySet(fr, 39, ArrayGet(fr, 24))
        ArraySet(fr, 24, ArrayGet(fr, 27))
        ArraySet(fr, 27, ArrayGet(fr, 39))
        ReturnValue(0)
    }
}

// Signed angle of E1 around N, from A toward B. Atan2 stays in this function.
Function.CAD_Tess.SphereEndAng {
    Input: fr: Address
    Output: Integer
    Body: {
        ArraySet(fr, 34, Float_Sub(ArrayGet(fr, 25), ArrayGet(fr, 0)))
        ArraySet(fr, 35, Float_Sub(ArrayGet(fr, 26), ArrayGet(fr, 1)))
        ArraySet(fr, 36, Float_Sub(ArrayGet(fr, 27), ArrayGet(fr, 2)))
        ArraySet(fr, 28, Float_Add(Float_Add(Float_Mul(ArrayGet(fr, 34), ArrayGet(fr, 4)), Float_Mul(ArrayGet(fr, 35), ArrayGet(fr, 5))), Float_Mul(ArrayGet(fr, 36), ArrayGet(fr, 6))))
        ArraySet(fr, 29, Float_Add(Float_Add(Float_Mul(ArrayGet(fr, 34), ArrayGet(fr, 7)), Float_Mul(ArrayGet(fr, 35), ArrayGet(fr, 8))), Float_Mul(ArrayGet(fr, 36), ArrayGet(fr, 9))))
        ReturnValue(CAD_Geom.Atan2(ArrayGet(fr, 29), ArrayGet(fr, 28)))
    }
}

// Frame: C,R at 0..3, A 4, B 7, N 10, uspan 14, vspan 15. Pole 19, E0 22, E1 25.
Function.CAD_Tess.SphereBasis {
    Input: fr: Address
    Output: Integer
    Body: {
        ArraySet(CAD_Tess_State.pack, 23, fr)
        ArraySet(fr, 34, Float_Sub(ArrayGet(fr, 19), ArrayGet(fr, 0)))
        ArraySet(fr, 35, Float_Sub(ArrayGet(fr, 20), ArrayGet(fr, 1)))
        ArraySet(fr, 36, Float_Sub(ArrayGet(fr, 21), ArrayGet(fr, 2)))
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        IfCondition EqualTo(CAD_Tess.VecUnitAt(fr, 34, 10), 0) ThenBlock: { ReturnValue(0) }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        IfCondition EqualTo(CAD_Tess.VecRejectUnit(fr, 22, 0, 10, 4), 0) ThenBlock: { ReturnValue(0) }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        IfCondition EqualTo(CAD_Tess.VecCrossUnit(fr, 10, 4, 7), 0) ThenBlock: { ReturnValue(0) }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        ArraySet(fr, 14, CAD_Tess.SphereEndAng(fr))
        IfCondition EqualTo(CAD_Num.IsNeg(ArrayGet(fr, 14)), 1) ThenBlock: {
            fr = ArrayGet(CAD_Tess_State.pack, 23)
            CAD_Tess.SphereSwapEnds(fr)
            fr = ArrayGet(CAD_Tess_State.pack, 23)
            IfCondition EqualTo(CAD_Tess.VecRejectUnit(fr, 22, 0, 10, 4), 0) ThenBlock: { ReturnValue(0) }
            fr = ArrayGet(CAD_Tess_State.pack, 23)
            IfCondition EqualTo(CAD_Tess.VecCrossUnit(fr, 10, 4, 7), 0) ThenBlock: { ReturnValue(0) }
            fr = ArrayGet(CAD_Tess_State.pack, 23)
            ArraySet(fr, 14, CAD_Tess.SphereEndAng(fr))
        }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        IfCondition EqualTo(CAD_Num.IsNeg(ArrayGet(fr, 14)), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(fr, 14), 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(fr, 15, 0x3FF921FB54442D18)
        ReturnValue(1)
    }
}

// P = C + R cos v (cos u A + sin u B) + R sin v N. Trig stays in this function.
Function.CAD_Tess.SphereRollPoint {
    Input: fr: Address
    Input: u: Integer
    Input: v: Integer
    Input: vb: Address
    Input: vi: Integer
    Output: Integer
    Body: {
        ArraySet(fr, 28, u)
        ArraySet(fr, 29, v)
        ArraySet(fr, 37, vi)
        ArraySet(fr, 30, CAD_Geom.Cos(ArrayGet(fr, 28)))
        ArraySet(fr, 31, CAD_Geom.Sin(ArrayGet(fr, 28)))
        ArraySet(fr, 32, CAD_Geom.Cos(ArrayGet(fr, 29)))
        ArraySet(fr, 33, CAD_Geom.Sin(ArrayGet(fr, 29)))
        ArraySet(fr, 38, Float_Mul(ArrayGet(fr, 3), ArrayGet(fr, 32)))
        ArraySet(fr, 39, Float_Mul(ArrayGet(fr, 3), ArrayGet(fr, 33)))
        ArraySet(fr, 34, Float_Add(ArrayGet(fr, 0), Float_Add(Float_Mul(ArrayGet(fr, 38), Float_Add(Float_Mul(ArrayGet(fr, 30), ArrayGet(fr, 4)), Float_Mul(ArrayGet(fr, 31), ArrayGet(fr, 7)))), Float_Mul(ArrayGet(fr, 39), ArrayGet(fr, 10)))))
        ArraySet(fr, 35, Float_Add(ArrayGet(fr, 1), Float_Add(Float_Mul(ArrayGet(fr, 38), Float_Add(Float_Mul(ArrayGet(fr, 30), ArrayGet(fr, 5)), Float_Mul(ArrayGet(fr, 31), ArrayGet(fr, 8)))), Float_Mul(ArrayGet(fr, 39), ArrayGet(fr, 11)))))
        ArraySet(fr, 36, Float_Add(ArrayGet(fr, 2), Float_Add(Float_Mul(ArrayGet(fr, 38), Float_Add(Float_Mul(ArrayGet(fr, 30), ArrayGet(fr, 6)), Float_Mul(ArrayGet(fr, 31), ArrayGet(fr, 9)))), Float_Mul(ArrayGet(fr, 39), ArrayGet(fr, 12)))))
        vi = ArrayGet(fr, 37)
        ArraySet(vb, Multiply(vi, 3), ArrayGet(fr, 34))
        ArraySet(vb, Add(Multiply(vi, 3), 1), ArrayGet(fr, 35))
        ArraySet(vb, Add(Multiply(vi, 3), 2), ArrayGet(fr, 36))
        ReturnValue(0)
    }
}

Function.CAD_Tess.WriteFrameXYZ {
    Input: fr: Address
    Input: i0: Integer
    Input: vb: Address
    Input: vi: Integer
    Output: Integer
    Body: {
        ArraySet(vb, Multiply(vi, 3), ArrayGet(fr, i0))
        ArraySet(vb, Add(Multiply(vi, 3), 1), ArrayGet(fr, Add(i0, 1)))
        ArraySet(vb, Add(Multiply(vi, 3), 2), ArrayGet(fr, Add(i0, 2)))
        ReturnValue(0)
    }
}

Function.CAD_Tess.EmitTri {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Output: Integer
    Body: {
        t = CAD_Tess_State.holes_ok
        ArraySet(CAD_Tess_State.i_base, Multiply(t, 3), a)
        ArraySet(CAD_Tess_State.i_base, Add(Multiply(t, 3), 1), b)
        ArraySet(CAD_Tess_State.i_base, Add(Multiply(t, 3), 2), c)
        CAD_Tess_State.holes_ok = Add(t, 1)
        ReturnValue(0)
    }
}

// Copy one meridian sample onto column si so the seam matches the shared arc.
Function.CAD_Tess.SphereSnapCol {
    Input: slot: Integer
    Output: Integer
    Body: {
        ArraySet(CAD_Tess_State.pack, 26, slot)
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(65536) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(0) }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        edge = ArrayGet(fr, ArrayGet(CAD_Tess_State.pack, 26))
        IfCondition EqualTo(edge, 0) ThenBlock: { ReturnValue(0) }
        n = CAD_Tess.SampleCircleEdge(edge, CAD_Tess_State.nh, CAD_Tess_State.samp)
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(0) }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        edge = ArrayGet(fr, ArrayGet(CAD_Tess_State.pack, 26))
        v0 = CAD_Store.Read(edge, 0)
        ArraySet(CAD_Tess_State.pack, 25, CAD_Tess.PosFar(v0, fr, 19))
        CAD_Tess_State.merge_sj = 0
        WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.nh) {
            CAD_Tess_State.zip_cx = CAD_Tess_State.merge_sj
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 25), 0) ThenBlock: {
                CAD_Tess_State.zip_cx = Subtract(CAD_Tess_State.nh, CAD_Tess_State.merge_sj)
            }
            CAD_Tess_State.merge_si = 0
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 26), 18) ThenBlock: {
                CAD_Tess_State.merge_si = Subtract(CAD_Tess_State.nout, 1)
            }
            CAD_Tess_State.zip_i = Add(CAD_Tess_State.merge_bi, Add(Multiply(CAD_Tess_State.merge_si, CAD_Tess_State.nh), CAD_Tess_State.merge_sj))
            CAD_Tess_State.zip_nt = Multiply(CAD_Tess_State.zip_cx, 3)
            ArraySet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3), ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.zip_nt))
            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1), ArrayGet(CAD_Tess_State.samp, Add(CAD_Tess_State.zip_nt, 1)))
            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 2), ArrayGet(CAD_Tess_State.samp, Add(CAD_Tess_State.zip_nt, 2)))
            CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
        }
        ReturnValue(1)
    }
}

// Equator row from the wall circle, same segment count the neighbor uses.
Function.CAD_Tess.SphereSnapRail {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(65536) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(0) }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        edge = ArrayGet(fr, 16)
        IfCondition EqualTo(edge, 0) ThenBlock: { ReturnValue(0) }
        n = CAD_Tess.SampleCircleEdge(edge, Subtract(CAD_Tess_State.nout, 1), CAD_Tess_State.samp)
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(0) }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        edge = ArrayGet(fr, 16)
        v0 = CAD_Store.Read(edge, 0)
        ArraySet(CAD_Tess_State.pack, 25, CAD_Tess.PosFar(v0, fr, 22))
        CAD_Tess_State.merge_si = 0
        WhileLoop LessThan(CAD_Tess_State.merge_si, CAD_Tess_State.nout) {
            CAD_Tess_State.zip_cx = CAD_Tess_State.merge_si
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 25), 0) ThenBlock: {
                CAD_Tess_State.zip_cx = CAD_Tess_State.merge_si
            }
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 25), 1) ThenBlock: {
                CAD_Tess_State.zip_cx = Subtract(Subtract(CAD_Tess_State.nout, 1), CAD_Tess_State.merge_si)
            }
            CAD_Tess_State.zip_i = Add(CAD_Tess_State.merge_bi, Multiply(CAD_Tess_State.merge_si, CAD_Tess_State.nh))
            CAD_Tess_State.zip_nt = Multiply(CAD_Tess_State.zip_cx, 3)
            ArraySet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3), ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.zip_nt))
            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1), ArrayGet(CAD_Tess_State.samp, Add(CAD_Tess_State.zip_nt, 1)))
            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 2), ArrayGet(CAD_Tess_State.samp, Add(CAD_Tess_State.zip_nt, 2)))
            CAD_Tess_State.merge_si = Add(CAD_Tess_State.merge_si, 1)
        }
        ReturnValue(1)
    }
}

// Kind-3 4-cycle: one zero host line plus three quarter-circles. 0 if not that face.
Function.CAD_Tess.SphereRollFrame {
    Input: fr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Tess_State.tess_face, 0) ThenBlock: { ReturnValue(0) }
        surf = CAD_Store.Read(CAD_Tess_State.tess_face, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        k = CAD_Store.Read(surf, 0)
        IfCondition NotEqual(k, 3) ThenBlock: { ReturnValue(0) }
        ArraySet(fr, 0, CAD_Store.Read(surf, 1))
        ArraySet(fr, 1, CAD_Store.Read(surf, 2))
        ArraySet(fr, 2, CAD_Store.Read(surf, 3))
        ArraySet(fr, 3, CAD_Store.Read(surf, 4))
        IfCondition EqualTo(CAD_Num.IsZero(ArrayGet(fr, 3), 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Tess_State.tess_loop, 0) ThenBlock: { ReturnValue(0) }
        co0 = CAD_Store.Read(CAD_Tess_State.tess_loop, 0)
        IfCondition EqualTo(co0, 0) ThenBlock: { ReturnValue(0) }
        edges = Allocate(32)
        IfCondition EqualTo(edges, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(fr, 13, edges)
        ncirc = 0
        nline = 0
        co = co0
        i = 0
        WhileLoop LessThan(i, 8) {
            edge = CAD_Store.Read(co, 0)
            crv = 0
            IfCondition NotEqual(edge, 0) ThenBlock: { crv = CAD_Store.Read(edge, 2) }
            k = 0
            IfCondition NotEqual(crv, 0) ThenBlock: { k = CAD_Store.Read(crv, 0) }
            IfCondition EqualTo(k, 1) ThenBlock: {
                nline = Add(nline, 1)
                v = CAD_Store.Read(edge, 0)
                IfCondition EqualTo(v, 0) ThenBlock: { v = CAD_Store.Read(edge, 1) }
                IfCondition NotEqual(v, 0) ThenBlock: {
                    ArraySet(fr, 19, CAD_Store.Read(v, 0))
                    ArraySet(fr, 20, CAD_Store.Read(v, 1))
                    ArraySet(fr, 21, CAD_Store.Read(v, 2))
                }
            }
            IfCondition EqualTo(k, 2) ThenBlock: {
                IfCondition LessThan(ncirc, 3) ThenBlock: { ArraySet(edges, ncirc, edge) }
                ncirc = Add(ncirc, 1)
            }
            co = CAD_Store.Read(co, 2)
            IfCondition EqualTo(co, co0) ThenBlock: { i = 8 }
            IfCondition EqualTo(co, 0) ThenBlock: { i = 8 }
            i = Add(i, 1)
        }
        ArraySet(fr, 30, 0)
        IfCondition EqualTo(nline, 0) ThenBlock: {
            IfCondition EqualTo(ncirc, 3) ThenBlock: {
                fr = ArrayGet(CAD_Tess_State.pack, 23)
                ep = ArrayGet(fr, 13)
                edge = ArrayGet(ep, 0)
                v = 0
                IfCondition NotEqual(edge, 0) ThenBlock: { v = CAD_Store.Read(edge, 0) }
                IfCondition EqualTo(v, 0) ThenBlock: {
                    IfCondition NotEqual(edge, 0) ThenBlock: { v = CAD_Store.Read(edge, 1) }
                }
                IfCondition NotEqual(v, 0) ThenBlock: {
                    fr = ArrayGet(CAD_Tess_State.pack, 23)
                    ArraySet(fr, 19, CAD_Store.Read(v, 0))
                    ArraySet(fr, 20, CAD_Store.Read(v, 1))
                    ArraySet(fr, 21, CAD_Store.Read(v, 2))
                    ArraySet(fr, 30, 1)
                    nline = 1
                }
            }
        }
        IfCondition NotEqual(nline, 1) ThenBlock: {
            ep = ArrayGet(fr, 13)
            Deallocate(ep, 32)
            ReturnValue(0)
        }
        IfCondition NotEqual(ncirc, 3) ThenBlock: {
            ep = ArrayGet(fr, 13)
            Deallocate(ep, 32)
            ReturnValue(0)
        }
        wall = 0
        i = 0
        WhileLoop LessThan(i, 3) {
            ep = ArrayGet(fr, 13)
            edge = ArrayGet(ep, i)
            far0 = CAD_Tess.PosFar(CAD_Store.Read(edge, 0), fr, 19)
            far1 = CAD_Tess.PosFar(CAD_Store.Read(edge, 1), fr, 19)
            IfCondition EqualTo(far0, 1) ThenBlock: {
                IfCondition EqualTo(far1, 1) ThenBlock: { wall = edge }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(wall, 0) ThenBlock: {
            ep = ArrayGet(fr, 13)
            Deallocate(ep, 32)
            ReturnValue(0)
        }
        v = CAD_Store.Read(wall, 0)
        ArraySet(fr, 22, CAD_Store.Read(v, 0))
        ArraySet(fr, 23, CAD_Store.Read(v, 1))
        ArraySet(fr, 24, CAD_Store.Read(v, 2))
        v = CAD_Store.Read(wall, 1)
        ArraySet(fr, 25, CAD_Store.Read(v, 0))
        ArraySet(fr, 26, CAD_Store.Read(v, 1))
        ArraySet(fr, 27, CAD_Store.Read(v, 2))
        ArraySet(fr, 16, wall)
        ArraySet(CAD_Tess_State.pack, 23, fr)
        IfCondition EqualTo(ArrayGet(fr, 30), 1) ThenBlock: {
            fr = ArrayGet(CAD_Tess_State.pack, 23)
            ArraySet(fr, 34, Float_Sub(ArrayGet(fr, 19), ArrayGet(fr, 0)))
            ArraySet(fr, 35, Float_Sub(ArrayGet(fr, 20), ArrayGet(fr, 1)))
            ArraySet(fr, 36, Float_Sub(ArrayGet(fr, 21), ArrayGet(fr, 2)))
            ArraySet(fr, 28, Float_Add(Float_Add(Float_Mul(ArrayGet(fr, 34), Float_Sub(ArrayGet(fr, 22), ArrayGet(fr, 0))), Float_Mul(ArrayGet(fr, 35), Float_Sub(ArrayGet(fr, 23), ArrayGet(fr, 1)))), Float_Mul(ArrayGet(fr, 36), Float_Sub(ArrayGet(fr, 24), ArrayGet(fr, 2)))))
            ArraySet(fr, 29, Float_Add(Float_Add(Float_Mul(ArrayGet(fr, 34), Float_Sub(ArrayGet(fr, 25), ArrayGet(fr, 0))), Float_Mul(ArrayGet(fr, 35), Float_Sub(ArrayGet(fr, 26), ArrayGet(fr, 1)))), Float_Mul(ArrayGet(fr, 36), Float_Sub(ArrayGet(fr, 27), ArrayGet(fr, 2)))))
            ArraySet(fr, 39, Float_Mul(0x3FA999999999999A, Float_Mul(ArrayGet(fr, 3), ArrayGet(fr, 3))))
            IfCondition EqualTo(CAD_Num.IsNeg(ArrayGet(fr, 28)), 1) ThenBlock: { ArraySet(fr, 28, Float_Sub(0, ArrayGet(fr, 28))) }
            IfCondition EqualTo(CAD_Num.IsNeg(ArrayGet(fr, 29)), 1) ThenBlock: { ArraySet(fr, 29, Float_Sub(0, ArrayGet(fr, 29))) }
            IfCondition EqualTo(CAD_Num.Le(ArrayGet(fr, 39), ArrayGet(fr, 28)), 1) ThenBlock: {
                ep = ArrayGet(fr, 13)
                Deallocate(ep, 32)
                ReturnValue(0)
            }
            IfCondition EqualTo(CAD_Num.Le(ArrayGet(fr, 39), ArrayGet(fr, 29)), 1) ThenBlock: {
                ep = ArrayGet(fr, 13)
                Deallocate(ep, 32)
                ReturnValue(0)
            }
            fr = ArrayGet(CAD_Tess_State.pack, 23)
        }
        IfCondition EqualTo(CAD_Tess.SphereBasis(fr), 0) ThenBlock: {
            ep = ArrayGet(CAD_Tess_State.pack, 23)
            ep = ArrayGet(ep, 13)
            Deallocate(ep, 32)
            ReturnValue(0)
        }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        mer0 = 0
        mer1 = 0
        i = 0
        WhileLoop LessThan(i, 3) {
            ep = ArrayGet(fr, 13)
            edge = ArrayGet(ep, i)
            IfCondition NotEqual(edge, ArrayGet(fr, 16)) ThenBlock: {
                IfCondition EqualTo(CAD_Tess.EdgeNear(edge, fr, 22), 1) ThenBlock: { mer0 = edge }
                IfCondition EqualTo(CAD_Tess.EdgeNear(edge, fr, 22), 0) ThenBlock: { mer1 = edge }
            }
            i = Add(i, 1)
        }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        ArraySet(fr, 17, mer0)
        ArraySet(fr, 18, mer1)
        ep = ArrayGet(fr, 13)
        IfCondition EqualTo(mer0, 0) ThenBlock: {
            Deallocate(ep, 32)
            ReturnValue(0)
        }
        IfCondition EqualTo(mer1, 0) ThenBlock: {
            Deallocate(ep, 32)
            ReturnValue(0)
        }
        Deallocate(ep, 32)
        ReturnValue(1)
    }
}

// Rolling-ball strips for the R==r sphere octant. Last band meets at the pole.
// A frame miss falls back to the fan so a different sphere face still meshes.
Function.CAD_Tess.MeshSphereRoll {
    Output: Integer
    Body: {
        fr = Allocate(320)
        IfCondition EqualTo(fr, 0) ThenBlock: {
            CAD_Tess.MeshLoopFanTess(CAD_Tess_State.tess_loop, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.pack)
            ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
        }
        ArraySet(CAD_Tess_State.pack, 23, fr)
        IfCondition EqualTo(CAD_Tess.SphereRollFrame(fr), 0) ThenBlock: {
            fr = ArrayGet(CAD_Tess_State.pack, 23)
            Deallocate(fr, 320)
            ArraySet(CAD_Tess_State.pack, 23, 0)
            PrintMessage("sphere roll miss\n")
            CAD_Tess.MeshLoopFanTess(CAD_Tess_State.tess_loop, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.pack)
            ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
        }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        CAD_Tess_State.nout = CAD_Tess.ArcSegCount(ArrayGet(fr, 3), ArrayGet(fr, 14))
        IfCondition LessThan(CAD_Tess_State.nout, 8) ThenBlock: { CAD_Tess_State.nout = 8 }
        IfCondition GreaterThan(CAD_Tess_State.nout, 32) ThenBlock: { CAD_Tess_State.nout = 32 }
        CAD_Tess_State.nout = Add(CAD_Tess_State.nout, 1)
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        CAD_Tess_State.nh = CAD_Tess.ArcSegCount(ArrayGet(fr, 3), ArrayGet(fr, 15))
        IfCondition LessThan(CAD_Tess_State.nh, 8) ThenBlock: { CAD_Tess_State.nh = 8 }
        IfCondition GreaterThan(CAD_Tess_State.nh, 16) ThenBlock: { CAD_Tess_State.nh = 16 }
        CAD_Tess_State.merge_bi = ArrayGet(CAD_Tess_State.pack, 0)
        CAD_Tess_State.merge_si = 0
        WhileLoop LessThan(CAD_Tess_State.merge_si, CAD_Tess_State.nout) {
            CAD_Tess_State.merge_sj = 0
            WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.nh) {
                fr = ArrayGet(CAD_Tess_State.pack, 23)
                u = Float_Mul(ArrayGet(fr, 14), Float_Div(Float_FromInt(CAD_Tess_State.merge_si), Float_FromInt(Subtract(CAD_Tess_State.nout, 1))))
                v = Float_Mul(ArrayGet(fr, 15), Float_Div(Float_FromInt(CAD_Tess_State.merge_sj), Float_FromInt(CAD_Tess_State.nh)))
                vi = Add(CAD_Tess_State.merge_bi, Add(Multiply(CAD_Tess_State.merge_si, CAD_Tess_State.nh), CAD_Tess_State.merge_sj))
                CAD_Tess.SphereRollPoint(fr, u, v, CAD_Tess_State.v_base, vi)
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
            CAD_Tess_State.merge_si = Add(CAD_Tess_State.merge_si, 1)
        }
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        CAD_Tess.WriteFrameXYZ(fr, 19, CAD_Tess_State.v_base, Add(CAD_Tess_State.merge_bi, Multiply(CAD_Tess_State.nout, CAD_Tess_State.nh)))
        CAD_Tess.SphereSnapRail()
        CAD_Tess.SphereSnapCol(17)
        CAD_Tess.SphereSnapCol(18)
        CAD_Tess_State.holes_ok = ArrayGet(CAD_Tess_State.pack, 1)
        CAD_Tess_State.merge_si = 0
        WhileLoop LessThan(CAD_Tess_State.merge_si, Subtract(CAD_Tess_State.nout, 1)) {
            CAD_Tess_State.merge_sj = 0
            WhileLoop LessThan(CAD_Tess_State.merge_sj, Subtract(CAD_Tess_State.nh, 1)) {
                ao = Add(CAD_Tess_State.merge_bi, Add(Multiply(CAD_Tess_State.merge_si, CAD_Tess_State.nh), CAD_Tess_State.merge_sj))
                ah = Add(CAD_Tess_State.merge_bi, Add(Multiply(Add(CAD_Tess_State.merge_si, 1), CAD_Tess_State.nh), CAD_Tess_State.merge_sj))
                CAD_Tess.EmitTri(ao, ah, Add(ah, 1))
                CAD_Tess.EmitTri(ao, Add(ah, 1), Add(ao, 1))
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
            ao = Add(CAD_Tess_State.merge_bi, Add(Multiply(CAD_Tess_State.merge_si, CAD_Tess_State.nh), Subtract(CAD_Tess_State.nh, 1)))
            ah = Add(CAD_Tess_State.merge_bi, Add(Multiply(Add(CAD_Tess_State.merge_si, 1), CAD_Tess_State.nh), Subtract(CAD_Tess_State.nh, 1)))
            CAD_Tess.EmitTri(ao, ah, Add(CAD_Tess_State.merge_bi, Multiply(CAD_Tess_State.nout, CAD_Tess_State.nh)))
            CAD_Tess_State.merge_si = Add(CAD_Tess_State.merge_si, 1)
        }
        ArraySet(CAD_Tess_State.pack, 0, Add(Add(CAD_Tess_State.merge_bi, Multiply(CAD_Tess_State.nout, CAD_Tess_State.nh)), 1))
        ArraySet(CAD_Tess_State.pack, 1, CAD_Tess_State.holes_ok)
        PrintMessage("sphere roll nu=")
        PrintNumber(CAD_Tess_State.nout)
        PrintMessage(" nv=")
        PrintNumber(CAD_Tess_State.nh)
        PrintMessage(" nt=")
        PrintNumber(CAD_Tess_State.holes_ok)
        PrintMessage("\n")
        fr = ArrayGet(CAD_Tess_State.pack, 23)
        Deallocate(fr, 320)
        ArraySet(CAD_Tess_State.pack, 23, 0)
        ArraySet(CAD_Tess_State.pack, 25, 0)
        ArraySet(CAD_Tess_State.pack, 26, 0)
        ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
    }
}

// Quarter-torus cove/fillet: sample the analytic surface, not a ruled cone.
Function.CAD_Tess.MeshTorusFace {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Tess_State.tess_face, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.tess_face, 0)
        IfCondition EqualTo(CAD_Tess_State.zip_ao, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Tess_State.zip_ao, 0), 4) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.merge_hi = CAD_Store.Read(CAD_Tess_State.zip_ao, 13)
        CAD_Tess_State.merge_hoff = CAD_Store.Read(CAD_Tess_State.zip_ao, 14)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.merge_hi, 0), 1) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.merge_hoff, 0), 1) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.zip_i = CAD_Store.Read(CAD_Tess_State.tess_loop, 0)
        IfCondition EqualTo(CAD_Tess_State.zip_i, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.zip_j = CAD_Tess_State.zip_i
        CAD_Tess_State.merge_sj = 0
        CAD_Tess_State.nn = 0
        CAD_Tess_State.sc_a0 = 0
        CAD_Tess_State.sc_span = 0
        ArraySet(CAD_Tess_State.pack, 15, 1)
        ArraySet(CAD_Tess_State.pack, 16, 0)
        ArraySet(CAD_Tess_State.pack, 17, 0x401921FB54442D18)
        ArraySet(CAD_Tess_State.pack, 18, 0)
        ArraySet(CAD_Tess_State.pack, 19, 0)
        ArraySet(CAD_Tess_State.pack, 20, 0)
        ArraySet(CAD_Tess_State.pack, 21, 0)
        ArraySet(CAD_Tess_State.pack, 22, 0)
        CAD_Tess_State.pi = 0
        WhileLoop LessThan(CAD_Tess_State.pi, 8) {
            CAD_Tess_State.zip_ah = CAD_Store.Read(CAD_Tess_State.zip_j, 0)
            IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                CAD_Tess_State.zip_nt = CAD_Store.Read(CAD_Tess_State.zip_ah, 2)
                IfCondition NotEqual(CAD_Tess_State.zip_nt, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_nt, 0), 2) ThenBlock: {
                        CAD_Tess_State.zip_best = CAD_Store.Read(CAD_Tess_State.zip_ah, 0)
                        CAD_Tess_State.zip_cx = CAD_Store.Read(CAD_Tess_State.zip_ah, 1)
                        IfCondition NotEqual(CAD_Tess_State.zip_best, 0) ThenBlock: {
                            CAD_Tess_State.merge_bi = Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 0), CAD_Store.Read(CAD_Tess_State.zip_ao, 1))
                            CAD_Tess_State.merge_bj = Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 1), CAD_Store.Read(CAD_Tess_State.zip_ao, 2))
                            CAD_Tess_State.merge_best = Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 2), CAD_Store.Read(CAD_Tess_State.zip_ao, 3))
                            CAD_Tess_State.merge_obase = Float_Add(Float_Add(Float_Mul(CAD_Tess_State.merge_bi, CAD_Store.Read(CAD_Tess_State.zip_ao, 10)), Float_Mul(CAD_Tess_State.merge_bj, CAD_Store.Read(CAD_Tess_State.zip_ao, 11))), Float_Mul(CAD_Tess_State.merge_best, CAD_Store.Read(CAD_Tess_State.zip_ao, 12)))
                            CAD_Tess_State.sc_crv = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Tess_State.merge_bi, Float_Mul(CAD_Tess_State.merge_obase, CAD_Store.Read(CAD_Tess_State.zip_ao, 10))), Float_Sub(CAD_Tess_State.merge_bi, Float_Mul(CAD_Tess_State.merge_obase, CAD_Store.Read(CAD_Tess_State.zip_ao, 10)))), Float_Mul(Float_Sub(CAD_Tess_State.merge_bj, Float_Mul(CAD_Tess_State.merge_obase, CAD_Store.Read(CAD_Tess_State.zip_ao, 11))), Float_Sub(CAD_Tess_State.merge_bj, Float_Mul(CAD_Tess_State.merge_obase, CAD_Store.Read(CAD_Tess_State.zip_ao, 11))))), Float_Mul(Float_Sub(CAD_Tess_State.merge_best, Float_Mul(CAD_Tess_State.merge_obase, CAD_Store.Read(CAD_Tess_State.zip_ao, 12))), Float_Sub(CAD_Tess_State.merge_best, Float_Mul(CAD_Tess_State.merge_obase, CAD_Store.Read(CAD_Tess_State.zip_ao, 12))))))
                            CAD_Tess_State.ruled_sag = CAD_Geom.Atan2(Float_Div(CAD_Tess_State.merge_obase, CAD_Tess_State.merge_hoff), Float_Div(Float_Sub(CAD_Tess_State.sc_crv, CAD_Tess_State.merge_hi), CAD_Tess_State.merge_hoff))
                            IfCondition EqualTo(CAD_Tess_State.zip_best, CAD_Tess_State.zip_cx) ThenBlock: {
                                IfCondition EqualTo(CAD_Tess_State.merge_sj, 0) ThenBlock: { CAD_Tess_State.sc_a0 = CAD_Tess_State.ruled_sag }
                                IfCondition EqualTo(CAD_Tess_State.merge_sj, 1) ThenBlock: { CAD_Tess_State.sc_span = CAD_Tess_State.ruled_sag }
                                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
                            }
                            IfCondition NotEqual(CAD_Tess_State.zip_best, CAD_Tess_State.zip_cx) ThenBlock: {
                                // A rail is constant along the torus axis.
                                // World Z is that test only when the axis is
                                // vertical. The same fillet stood up, arc in
                                // a plane that contains Z, has a horizontal axis.
                                CAD_Tess_State.sc_crv = 0
                                IfCondition NotEqual(CAD_Tess_State.zip_cx, 0) ThenBlock: {
                                    CAD_Tess_State.merge_bi = Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 0), CAD_Store.Read(CAD_Tess_State.zip_cx, 0))
                                    CAD_Tess_State.merge_bj = Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 1), CAD_Store.Read(CAD_Tess_State.zip_cx, 1))
                                    CAD_Tess_State.merge_best = Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 2), CAD_Store.Read(CAD_Tess_State.zip_cx, 2))
                                    CAD_Tess_State.sc_crv = Float_Add(Float_Add(Float_Mul(CAD_Tess_State.merge_bi, CAD_Store.Read(CAD_Tess_State.zip_ao, 10)), Float_Mul(CAD_Tess_State.merge_bj, CAD_Store.Read(CAD_Tess_State.zip_ao, 11))), Float_Mul(CAD_Tess_State.merge_best, CAD_Store.Read(CAD_Tess_State.zip_ao, 12)))
                                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_Tess_State.sc_crv), 1) ThenBlock: { CAD_Tess_State.sc_crv = Float_Sub(0, CAD_Tess_State.sc_crv) }
                                }
                                IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.sc_crv, 0), 1) ThenBlock: {
                                    CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
                                    IfCondition EqualTo(CAD_Tess_State.nn, 1) ThenBlock: {
                                        // First rail is one contact circle.
                                        // Minor sweep must start there, not at
                                        // v=0 (the outside equator).
                                        CAD_Tess_State.sc_a0 = CAD_Tess_State.ruled_sag
                                    }
                                    IfCondition EqualTo(CAD_Tess_State.nn, 2) ThenBlock: { CAD_Tess_State.sc_span = CAD_Tess_State.ruled_sag }
                                    // u comes from the larger-radius rail so a
                                    // convex open fillet stays inside the side
                                    // planes. A later rail must not reset sc_a0.
                                    take = 0
                                    IfCondition EqualTo(CAD_Tess_State.nn, 1) ThenBlock: { take = 1 }
                                    IfCondition GreaterThan(CAD_Tess_State.nn, 1) ThenBlock: {
                                        prev = ArrayGet(CAD_Tess_State.pack, 22)
                                        IfCondition NotEqual(prev, 0) ThenBlock: {
                                            rad = CAD_Store.Read(CAD_Tess_State.zip_nt, 10)
                                            IfCondition EqualTo(CAD_Num.Le(rad, prev), 0) ThenBlock: { take = 1 }
                                        }
                                    }
                                    IfCondition EqualTo(take, 1) ThenBlock: {
                                        CAD_Tess_State.merge_bi = Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 0), CAD_Store.Read(CAD_Tess_State.zip_ao, 1)), CAD_Store.Read(CAD_Tess_State.zip_ao, 4)), Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 1), CAD_Store.Read(CAD_Tess_State.zip_ao, 2)), CAD_Store.Read(CAD_Tess_State.zip_ao, 5))), Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 2), CAD_Store.Read(CAD_Tess_State.zip_ao, 3)), CAD_Store.Read(CAD_Tess_State.zip_ao, 6)))
                                        CAD_Tess_State.merge_bj = Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 0), CAD_Store.Read(CAD_Tess_State.zip_ao, 1)), CAD_Store.Read(CAD_Tess_State.zip_ao, 7)), Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 1), CAD_Store.Read(CAD_Tess_State.zip_ao, 2)), CAD_Store.Read(CAD_Tess_State.zip_ao, 8))), Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 2), CAD_Store.Read(CAD_Tess_State.zip_ao, 3)), CAD_Store.Read(CAD_Tess_State.zip_ao, 9)))
                                        ArraySet(CAD_Tess_State.pack, 16, CAD_Geom.Atan2(CAD_Tess_State.merge_bj, CAD_Tess_State.merge_bi))
                                        // Stadium 180°: Atan2(v1)−Atan2(v0) wraps to the minor
                                        // half (interior). Use the rail's signed span.
                                        CAD_Tess_State.merge_best = 0
                                        IfCondition NotEqual(CAD_Tess_State.zip_nt, 0) ThenBlock: {
                                            CAD_Tess_State.merge_best = CAD_Store.Read(CAD_Tess_State.zip_nt, 12)
                                        }
                                        IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.merge_best, 0), 0) ThenBlock: {
                                            ArraySet(CAD_Tess_State.pack, 17, Float_Add(ArrayGet(CAD_Tess_State.pack, 16), CAD_Tess_State.merge_best))
                                        }
                                        IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.merge_best, 0), 1) ThenBlock: {
                                            IfCondition NotEqual(CAD_Tess_State.zip_cx, 0) ThenBlock: {
                                                CAD_Tess_State.merge_bi = Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_cx, 0), CAD_Store.Read(CAD_Tess_State.zip_ao, 1)), CAD_Store.Read(CAD_Tess_State.zip_ao, 4)), Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_cx, 1), CAD_Store.Read(CAD_Tess_State.zip_ao, 2)), CAD_Store.Read(CAD_Tess_State.zip_ao, 5))), Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_cx, 2), CAD_Store.Read(CAD_Tess_State.zip_ao, 3)), CAD_Store.Read(CAD_Tess_State.zip_ao, 6)))
                                                CAD_Tess_State.merge_bj = Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_cx, 0), CAD_Store.Read(CAD_Tess_State.zip_ao, 1)), CAD_Store.Read(CAD_Tess_State.zip_ao, 7)), Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_cx, 1), CAD_Store.Read(CAD_Tess_State.zip_ao, 2)), CAD_Store.Read(CAD_Tess_State.zip_ao, 8))), Float_Mul(Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_cx, 2), CAD_Store.Read(CAD_Tess_State.zip_ao, 3)), CAD_Store.Read(CAD_Tess_State.zip_ao, 9)))
                                                ArraySet(CAD_Tess_State.pack, 17, CAD_Geom.Atan2(CAD_Tess_State.merge_bj, CAD_Tess_State.merge_bi))
                                            }
                                        }
                                        ArraySet(CAD_Tess_State.pack, 22, CAD_Store.Read(CAD_Tess_State.zip_nt, 10))
                                        ArraySet(CAD_Tess_State.pack, 20, CAD_Tess_State.zip_best)
                                        ArraySet(CAD_Tess_State.pack, 21, CAD_Tess_State.zip_cx)
                                    }
                                }
                                IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.sc_crv, 0), 0) ThenBlock: {
                                    IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 18), 0) ThenBlock: {
                                        ArraySet(CAD_Tess_State.pack, 18, CAD_Tess_State.zip_ah)
                                    }
                                    IfCondition NotEqual(ArrayGet(CAD_Tess_State.pack, 18), 0) ThenBlock: {
                                        IfCondition NotEqual(ArrayGet(CAD_Tess_State.pack, 18), CAD_Tess_State.zip_ah) ThenBlock: {
                                            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 19), 0) ThenBlock: {
                                                ArraySet(CAD_Tess_State.pack, 19, CAD_Tess_State.zip_ah)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Cope spans Z the way an open meridian did. Record the
                    // edge so the end column snaps onto it by row z.
                    ck = CAD_Store.Read(CAD_Tess_State.zip_nt, 0)
                    cope_k = 0
                    IfCondition EqualTo(ck, 5) ThenBlock: { cope_k = 1 }
                    IfCondition EqualTo(ck, 6) ThenBlock: { cope_k = 1 }
                    IfCondition EqualTo(cope_k, 1) ThenBlock: {
                        CAD_Tess_State.zip_best = CAD_Store.Read(CAD_Tess_State.zip_ah, 0)
                        CAD_Tess_State.zip_cx = CAD_Store.Read(CAD_Tess_State.zip_ah, 1)
                        IfCondition NotEqual(CAD_Tess_State.zip_best, 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Tess_State.zip_cx, 0) ThenBlock: {
                                CAD_Tess_State.sc_crv = Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_best, 2), CAD_Store.Read(CAD_Tess_State.zip_cx, 2))
                                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Tess_State.sc_crv), 1) ThenBlock: {
                                    CAD_Tess_State.sc_crv = Float_Sub(0, CAD_Tess_State.sc_crv)
                                }
                                IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.sc_crv, 0), 0) ThenBlock: {
                                    IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 18), 0) ThenBlock: {
                                        ArraySet(CAD_Tess_State.pack, 18, CAD_Tess_State.zip_ah)
                                    }
                                    IfCondition NotEqual(ArrayGet(CAD_Tess_State.pack, 18), 0) ThenBlock: {
                                        IfCondition NotEqual(ArrayGet(CAD_Tess_State.pack, 18), CAD_Tess_State.zip_ah) ThenBlock: {
                                            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 19), 0) ThenBlock: {
                                                ArraySet(CAD_Tess_State.pack, 19, CAD_Tess_State.zip_ah)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            CAD_Tess_State.zip_j = CAD_Store.Read(CAD_Tess_State.zip_j, 2)
            IfCondition EqualTo(CAD_Tess_State.zip_j, CAD_Tess_State.zip_i) ThenBlock: { CAD_Tess_State.pi = 8 }
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        pk = CAD_Tess_State.pack
        m0 = ArrayGet(pk, 18)
        m1 = ArrayGet(pk, 19)
        rv0 = ArrayGet(pk, 20)
        rv1 = ArrayGet(pk, 21)
        ArraySet(pk, 18, 0)
        ArraySet(pk, 19, 0)
        // Position, not handle. The cope is built on the contact vertex
        // the seam found; the lid rail can hold a different record there.
        IfCondition NotEqual(m0, 0) ThenBlock: {
            ev0 = CAD_Store.Read(m0, 0)
            ev1 = CAD_Store.Read(m0, 1)
            IfCondition NotEqual(rv0, 0) ThenBlock: {
                hit = CAD_Topo.VertSamePos(ev0, rv0)
                IfCondition EqualTo(hit, 1) ThenBlock: { ArraySet(pk, 18, m0) }
                hit = CAD_Topo.VertSamePos(ev1, rv0)
                IfCondition EqualTo(hit, 1) ThenBlock: { ArraySet(pk, 18, m0) }
            }
            IfCondition NotEqual(rv1, 0) ThenBlock: {
                hit = CAD_Topo.VertSamePos(ev0, rv1)
                IfCondition EqualTo(hit, 1) ThenBlock: { ArraySet(pk, 19, m0) }
                hit = CAD_Topo.VertSamePos(ev1, rv1)
                IfCondition EqualTo(hit, 1) ThenBlock: { ArraySet(pk, 19, m0) }
            }
        }
        IfCondition NotEqual(m1, 0) ThenBlock: {
            ev0 = CAD_Store.Read(m1, 0)
            ev1 = CAD_Store.Read(m1, 1)
            IfCondition NotEqual(rv0, 0) ThenBlock: {
                hit = CAD_Topo.VertSamePos(ev0, rv0)
                IfCondition EqualTo(hit, 1) ThenBlock: { ArraySet(pk, 18, m1) }
                hit = CAD_Topo.VertSamePos(ev1, rv0)
                IfCondition EqualTo(hit, 1) ThenBlock: { ArraySet(pk, 18, m1) }
            }
            IfCondition NotEqual(rv1, 0) ThenBlock: {
                hit = CAD_Topo.VertSamePos(ev0, rv1)
                IfCondition EqualTo(hit, 1) ThenBlock: { ArraySet(pk, 19, m1) }
                hit = CAD_Topo.VertSamePos(ev1, rv1)
                IfCondition EqualTo(hit, 1) ThenBlock: { ArraySet(pk, 19, m1) }
            }
        }
        CAD_Tess_State.pack = pk
        IfCondition LessThan(CAD_Tess_State.merge_sj, 2) ThenBlock: {
            IfCondition LessThan(CAD_Tess_State.nn, 2) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
            ArraySet(CAD_Tess_State.pack, 15, 0)
            CAD_Tess_State.merge_bi = ArrayGet(CAD_Tess_State.pack, 16)
            CAD_Tess_State.merge_bj = ArrayGet(CAD_Tess_State.pack, 17)
            CAD_Tess_State.merge_bj = Float_Sub(CAD_Tess_State.merge_bj, CAD_Tess_State.merge_bi)
            // Rail slot-12 already stored a0+span in pack[17]. Folding that
            // into (-π, π] turned a span ≥π into a short patch.
            CAD_Tess_State.merge_best = CAD_Tess_State.merge_bj
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Tess_State.merge_best), 1) ThenBlock: {
                CAD_Tess_State.merge_best = Float_Sub(0, CAD_Tess_State.merge_best)
            }
            IfCondition EqualTo(CAD_Num.Le(0x400921FB54442D18, CAD_Tess_State.merge_best), 0) ThenBlock: {
                CAD_Tess_State.merge_best = 0x400921FB54442D18
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Tess_State.merge_bj, Float_Sub(0, CAD_Tess_State.merge_best))), 1) ThenBlock: {
                    CAD_Tess_State.merge_bj = Float_Add(CAD_Tess_State.merge_bj, Float_Add(CAD_Tess_State.merge_best, CAD_Tess_State.merge_best))
                }
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Tess_State.merge_best, CAD_Tess_State.merge_bj)), 1) ThenBlock: {
                    CAD_Tess_State.merge_bj = Float_Sub(CAD_Tess_State.merge_bj, Float_Add(CAD_Tess_State.merge_best, CAD_Tess_State.merge_best))
                }
            }
            ArraySet(CAD_Tess_State.pack, 17, CAD_Tess_State.merge_bj)
        }
        CAD_Tess_State.sc_span = Float_Sub(CAD_Tess_State.sc_span, CAD_Tess_State.sc_a0)
        CAD_Tess_State.merge_best = 0x400921FB54442D18
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Tess_State.sc_span, Float_Sub(0, CAD_Tess_State.merge_best))), 1) ThenBlock: {
            CAD_Tess_State.sc_span = Float_Add(CAD_Tess_State.sc_span, Float_Add(CAD_Tess_State.merge_best, CAD_Tess_State.merge_best))
        }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Tess_State.merge_best, CAD_Tess_State.sc_span)), 1) ThenBlock: {
            CAD_Tess_State.sc_span = Float_Sub(CAD_Tess_State.sc_span, Float_Add(CAD_Tess_State.merge_best, CAD_Tess_State.merge_best))
        }
        IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 15), 1) ThenBlock: {
            CAD_Tess_State.nout = CAD_Tess.CircleSegCount(CAD_Tess_State.merge_hi, CAD_Tess_State.defl_r)
            IfCondition LessThan(CAD_Tess_State.nout, 24) ThenBlock: { CAD_Tess_State.nout = 24 }
            IfCondition GreaterThan(CAD_Tess_State.nout, 64) ThenBlock: { CAD_Tess_State.nout = 64 }
        }
        IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 15), 0) ThenBlock: {
            CAD_Tess_State.nout = CAD_Tess.ArcSegCount(CAD_Tess_State.merge_hi, ArrayGet(CAD_Tess_State.pack, 17))
            IfCondition LessThan(CAD_Tess_State.nout, 8) ThenBlock: { CAD_Tess_State.nout = 8 }
            IfCondition GreaterThan(CAD_Tess_State.nout, 32) ThenBlock: { CAD_Tess_State.nout = 32 }
            CAD_Tess_State.nout = Add(CAD_Tess_State.nout, 1)
        }
        CAD_Tess_State.nh = CAD_Tess.ArcSegCount(CAD_Tess_State.merge_hoff, CAD_Tess_State.sc_span)
        IfCondition LessThan(CAD_Tess_State.nh, 8) ThenBlock: { CAD_Tess_State.nh = 8 }
        IfCondition GreaterThan(CAD_Tess_State.nh, 16) ThenBlock: { CAD_Tess_State.nh = 16 }
        CAD_Tess_State.merge_bi = ArrayGet(CAD_Tess_State.pack, 0)
        abuf = Allocate(16)
        CAD_Tess_State.merge_si = 0
        WhileLoop LessThan(CAD_Tess_State.merge_si, CAD_Tess_State.nout) {
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 15), 1) ThenBlock: {
                CAD_Tess_State.zip_cx = Float_Mul(Float_Div(Float_FromInt(CAD_Tess_State.merge_si), Float_FromInt(CAD_Tess_State.nout)), 0x401921FB54442D18)
            }
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 15), 0) ThenBlock: {
                CAD_Tess_State.zip_cx = Float_Add(ArrayGet(CAD_Tess_State.pack, 16), Float_Mul(ArrayGet(CAD_Tess_State.pack, 17), Float_Div(Float_FromInt(CAD_Tess_State.merge_si), Float_FromInt(Subtract(CAD_Tess_State.nout, 1)))))
            }
            CAD_Tess_State.merge_sj = 0
            WhileLoop LessEqual(CAD_Tess_State.merge_sj, CAD_Tess_State.nh) {
                CAD_Tess_State.zip_cy = Float_Add(CAD_Tess_State.sc_a0, Float_Mul(CAD_Tess_State.sc_span, Float_Div(Float_FromInt(CAD_Tess_State.merge_sj), Float_FromInt(CAD_Tess_State.nh))))
                CAD_Tess_State.zip_best = CAD_Geom.Cos(CAD_Tess_State.zip_cx)
                CAD_Tess_State.zip_nt = CAD_Geom.Sin(CAD_Tess_State.zip_cx)
                CAD_Tess_State.merge_bj = CAD_Geom.Cos(CAD_Tess_State.zip_cy)
                CAD_Tess_State.merge_best = CAD_Geom.Sin(CAD_Tess_State.zip_cy)
                CAD_Tess_State.nn = Float_Add(CAD_Tess_State.merge_hi, Float_Mul(CAD_Tess_State.merge_hoff, CAD_Tess_State.merge_bj))
                CAD_Tess_State.zip_i = Add(CAD_Tess_State.merge_bi, Add(Multiply(CAD_Tess_State.merge_si, Add(CAD_Tess_State.nh, 1)), CAD_Tess_State.merge_sj))
                ArraySet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3), Float_Add(CAD_Store.Read(CAD_Tess_State.zip_ao, 1), Float_Add(Float_Mul(CAD_Tess_State.nn, Float_Add(Float_Mul(CAD_Tess_State.zip_best, CAD_Store.Read(CAD_Tess_State.zip_ao, 4)), Float_Mul(CAD_Tess_State.zip_nt, CAD_Store.Read(CAD_Tess_State.zip_ao, 7)))), Float_Mul(Float_Mul(CAD_Tess_State.merge_hoff, CAD_Tess_State.merge_best), CAD_Store.Read(CAD_Tess_State.zip_ao, 10)))))
                ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1), Float_Add(CAD_Store.Read(CAD_Tess_State.zip_ao, 2), Float_Add(Float_Mul(CAD_Tess_State.nn, Float_Add(Float_Mul(CAD_Tess_State.zip_best, CAD_Store.Read(CAD_Tess_State.zip_ao, 5)), Float_Mul(CAD_Tess_State.zip_nt, CAD_Store.Read(CAD_Tess_State.zip_ao, 8)))), Float_Mul(Float_Mul(CAD_Tess_State.merge_hoff, CAD_Tess_State.merge_best), CAD_Store.Read(CAD_Tess_State.zip_ao, 11)))))
                ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 2), Float_Add(CAD_Store.Read(CAD_Tess_State.zip_ao, 3), Float_Add(Float_Mul(CAD_Tess_State.nn, Float_Add(Float_Mul(CAD_Tess_State.zip_best, CAD_Store.Read(CAD_Tess_State.zip_ao, 6)), Float_Mul(CAD_Tess_State.zip_nt, CAD_Store.Read(CAD_Tess_State.zip_ao, 9)))), Float_Mul(Float_Mul(CAD_Tess_State.merge_hoff, CAD_Tess_State.merge_best), CAD_Store.Read(CAD_Tess_State.zip_ao, 12)))))
                IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 15), 0) ThenBlock: {
                    endc = 0
                    IfCondition EqualTo(CAD_Tess_State.merge_si, 0) ThenBlock: { endc = 1 }
                    IfCondition EqualTo(CAD_Tess_State.merge_si, Subtract(CAD_Tess_State.nout, 1)) ThenBlock: { endc = 1 }
                    IfCondition EqualTo(endc, 1) ThenBlock: {
                        edg = ArrayGet(CAD_Tess_State.pack, 18)
                        IfCondition EqualTo(CAD_Tess_State.merge_si, Subtract(CAD_Tess_State.nout, 1)) ThenBlock: {
                            edg = ArrayGet(CAD_Tess_State.pack, 19)
                        }
                        sj = CAD_Tess_State.merge_sj
                        si = CAD_Tess_State.merge_si
                        nu = CAD_Tess_State.nout
                        nv = CAD_Tess_State.nh
                        vi = CAD_Tess_State.zip_i
                        ao = CAD_Tess_State.zip_ao
                        bi = CAD_Tess_State.merge_bi
                        a0s = CAD_Tess_State.sc_a0
                        spn = CAD_Tess_State.sc_span
                        rma = CAD_Tess_State.merge_hi
                        rh = CAD_Tess_State.merge_hoff
                        vb = CAD_Tess_State.v_base
                        pk = CAD_Tess_State.pack
                        CAD_Tess.MerPointAtZ(edg, vb, vi, abuf)
                        CAD_Tess_State.merge_sj = sj
                        CAD_Tess_State.merge_si = si
                        CAD_Tess_State.nout = nu
                        CAD_Tess_State.nh = nv
                        CAD_Tess_State.zip_i = vi
                        CAD_Tess_State.zip_ao = ao
                        CAD_Tess_State.merge_bi = bi
                        CAD_Tess_State.sc_a0 = a0s
                        CAD_Tess_State.sc_span = spn
                        CAD_Tess_State.merge_hi = rma
                        CAD_Tess_State.merge_hoff = rh
                        CAD_Tess_State.v_base = vb
                        CAD_Tess_State.pack = pk
                    }
                }
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
            CAD_Tess_State.merge_si = Add(CAD_Tess_State.merge_si, 1)
        }
        // Kind-5 cope ends only. A constant-u column between a lid hit
        // and a wall corner is the round step. Quarter-circle caps stay.
        IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 15), 0) ThenBlock: {
            nu = CAD_Tess_State.nout
            nv = CAD_Tess_State.nh
            ao = CAD_Tess_State.zip_ao
            bi = CAD_Tess_State.merge_bi
            a0v = CAD_Tess_State.sc_a0
            spv = CAD_Tess_State.sc_span
            rmj = CAD_Tess_State.merge_hi
            rmn = CAD_Tess_State.merge_hoff
            vbb = CAD_Tess_State.v_base
            pk = CAD_Tess_State.pack
            cope = 0
            k18 = 0
            k19 = 0
            edg = ArrayGet(pk, 18)
            IfCondition NotEqual(edg, 0) ThenBlock: {
                crv = CAD_Store.Read(edg, 2)
                IfCondition NotEqual(crv, 0) ThenBlock: { k18 = CAD_Store.Read(crv, 0) }
            }
            edg = ArrayGet(pk, 19)
            IfCondition NotEqual(edg, 0) ThenBlock: {
                crv = CAD_Store.Read(edg, 2)
                IfCondition NotEqual(crv, 0) ThenBlock: { k19 = CAD_Store.Read(crv, 0) }
            }
            IfCondition EqualTo(k18, 5) ThenBlock: { cope = 1 }
            IfCondition EqualTo(k18, 6) ThenBlock: { cope = 1 }
            IfCondition EqualTo(k19, 5) ThenBlock: { cope = 1 }
            IfCondition EqualTo(k19, 6) ThenBlock: { cope = 1 }
            IfCondition EqualTo(cope, 1) ThenBlock: {
                spec = Allocate(64)
                ArraySet(spec, 0, bi)
                ArraySet(spec, 1, nu)
                ArraySet(spec, 2, nv)
                ArraySet(spec, 3, a0v)
                ArraySet(spec, 4, spv)
                ArraySet(spec, 5, rmj)
                ArraySet(spec, 6, rmn)
                CAD_Tess.TorusCopeBlend(vbb, ao, spec)
                Deallocate(spec, 64)
                PrintMessage("torus cope blend\n")
            }
            CAD_Tess_State.nout = nu
            CAD_Tess_State.nh = nv
            CAD_Tess_State.zip_ao = ao
            CAD_Tess_State.merge_bi = bi
            CAD_Tess_State.sc_a0 = a0v
            CAD_Tess_State.sc_span = spv
            CAD_Tess_State.merge_hi = rmj
            CAD_Tess_State.merge_hoff = rmn
            CAD_Tess_State.v_base = vbb
            CAD_Tess_State.pack = pk
        }
        CAD_Tess_State.holes_ok = ArrayGet(CAD_Tess_State.pack, 1)
        CAD_Tess_State.merge_si = 0
        WhileLoop LessThan(CAD_Tess_State.merge_si, CAD_Tess_State.nout) {
            CAD_Tess_State.merge_sj = 0
            CAD_Tess_State.nring = Add(CAD_Tess_State.merge_si, 1)
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 15), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Tess_State.nring, CAD_Tess_State.nout) ThenBlock: { CAD_Tess_State.nring = 0 }
            }
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 15), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Tess_State.nring, CAD_Tess_State.nout) ThenBlock: { CAD_Tess_State.merge_sj = CAD_Tess_State.nh }
            }
            WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.nh) {
                CAD_Tess_State.zip_ao = Add(CAD_Tess_State.merge_bi, Add(Multiply(CAD_Tess_State.merge_si, Add(CAD_Tess_State.nh, 1)), CAD_Tess_State.merge_sj))
                CAD_Tess_State.zip_ah = Add(CAD_Tess_State.merge_bi, Add(Multiply(CAD_Tess_State.nring, Add(CAD_Tess_State.nh, 1)), CAD_Tess_State.merge_sj))
                CAD_Tess_State.zip_i = Add(CAD_Tess_State.zip_ah, 1)
                CAD_Tess_State.zip_j = Add(CAD_Tess_State.zip_ao, 1)
                CAD_Tess_State.nn = CAD_Tess_State.holes_ok
                ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_ah)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_i)
                CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
                ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_i)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_j)
                CAD_Tess_State.holes_ok = Add(CAD_Tess_State.nn, 1)
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
            CAD_Tess_State.merge_si = Add(CAD_Tess_State.merge_si, 1)
        }
        ArraySet(CAD_Tess_State.pack, 0, Add(CAD_Tess_State.merge_bi, Multiply(CAD_Tess_State.nout, Add(CAD_Tess_State.nh, 1))))
        ArraySet(CAD_Tess_State.pack, 1, CAD_Tess_State.holes_ok)
        PrintMessage("torus uv wrap=")
        PrintNumber(ArrayGet(CAD_Tess_State.pack, 15))
        PrintMessage(" nu=")
        PrintNumber(CAD_Tess_State.nout)
        PrintMessage(" nv=")
        PrintNumber(CAD_Tess_State.nh)
        PrintMessage(" nt=")
        PrintNumber(CAD_Tess_State.holes_ok)
        PrintMessage(" span=")
        PrintNumber(Float_ToInt(Float_Mul(ArrayGet(CAD_Tess_State.pack, 17), 0x404CA5DC1A63C1F8)))
        PrintMessage("\n")
        ReturnValue(CAD_Tess_State.holes_ok)
    }
}

// Caller CCW-normalizes with IsNeg(area). Clip o==1 ears; drop o==0 collinear tips.
// One reverse retry. Partial tris on fail — MeshSolid must NOT FanNGon concave.
