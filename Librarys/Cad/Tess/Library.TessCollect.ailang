LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.StringUtils

// 1 when samples (stored v0→v1) must be flipped to start at the coedge
// origin. Open arcs follow the origin: the notch arc's sense bit does
// not match its origin, and reversing it walks the far end first so the
// wall and lid loops jump. A closed circle (v0==v1) still uses sense.
Function.CAD_Tess.CoedgeRev {
    Input: ce: Integer
    Input: edge: Integer
    Output: Integer
    Body: {
        rev = 0
        org = CAD_Store.Read(ce, 5)
        ev0 = CAD_Store.Read(edge, 0)
        ev1 = CAD_Store.Read(edge, 1)
        IfCondition EqualTo(ev0, ev1) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(ce, 6), 0) ThenBlock: { rev = 1 }
        }
        IfCondition NotEqual(ev0, ev1) ThenBlock: {
            IfCondition EqualTo(org, ev1) ThenBlock: { rev = 1 }
            IfCondition NotEqual(org, ev0) ThenBlock: {
                IfCondition NotEqual(org, ev1) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(ce, 6), 0) ThenBlock: { rev = 1 }
                }
            }
        }
        ReturnValue(rev)
    }
}

Function.CAD_Tess.CollectLoopVerts {
    Input: loop_h: Integer
    Input: v_base: Address
    Input: idx_addr: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        CAD_Tess_State.zip_ah = loop_h
        IfCondition EqualTo(CAD_Tess_State.zip_ah, 0) ThenBlock: { ReturnValue(0) }
        CAD_Tess_State.nn = CAD_Topo.LoopCountCoedges(CAD_Tess_State.zip_ah)
        IfCondition LessThan(CAD_Tess_State.nn, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CAD_Tess_State.nn, 2048) ThenBlock: { ReturnValue(0) }
        CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.pack, 0)
        CAD_Tess_State.zip_i = CAD_Store.Read(CAD_Tess_State.zip_ah, 0)
        CAD_Tess_State.pi = 0
        CAD_Tess_State.zip_nt = 0
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nn) {
            CAD_Tess_State.use_zip = 0
            CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.zip_i, 0)
            IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                CAD_Tess_State.zip_best = CAD_Store.Read(CAD_Tess_State.zip_ao, 2)
                IfCondition NotEqual(CAD_Tess_State.zip_best, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_best, 0), 2) ThenBlock: {
                        CAD_Tess_State.nring = CAD_Tess.ArcSegCount(CAD_Store.Read(CAD_Tess_State.zip_best, 10), CAD_Store.Read(CAD_Tess_State.zip_best, 12))
                        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(65536) }
                        CAD_Tess_State.nring = CAD_Tess.SampleCircleEdge(CAD_Tess_State.zip_ao, CAD_Tess_State.nring, CAD_Tess_State.samp)
                        IfCondition GreaterThan(CAD_Tess_State.nring, 257) ThenBlock: { CAD_Tess_State.nring = 0 }
                        IfCondition LessThan(CAD_Tess_State.nring, 0) ThenBlock: { CAD_Tess_State.nring = 0 }
                        // SampleCircleEdge is v0→v1 along the stored span.
                        // Open arcs start at the coedge origin, not the sense bit.
                        CAD_Tess.PipeI("pipe collect i=", 15, CAD_Tess_State.pi)
                        CAD_Tess.PipeI(" nring=", 7, CAD_Tess_State.nring)
                        CAD_Tess.PipeI(" sense=", 7, CAD_Store.Read(CAD_Tess_State.zip_i, 6))
                        CAD_Tess.PipeI(" hole=", 6, CAD_Tess_State.want_h)
                        rev = CAD_Tess.CoedgeRev(CAD_Tess_State.zip_i, CAD_Tess_State.zip_ao)
                        IfCondition EqualTo(rev, 1) ThenBlock: {
                            CAD_Tess.ReverseSamp(CAD_Tess_State.nring)
                            CAD_Tess.Pipe("pipe collect REVSAMP\n", 21)
                        }
                        IfCondition GreaterThan(CAD_Tess_State.nring, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_ao, 0), CAD_Store.Read(CAD_Tess_State.zip_ao, 1)) ThenBlock: {
                                CAD_Tess_State.nring = Subtract(CAD_Tess_State.nring, 1)
                            }
                        }
                        CAD_Tess_State.zip_cx = 0
                        WhileLoop LessThan(CAD_Tess_State.zip_cx, CAD_Tess_State.nring) {
                            ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), ArrayGet(CAD_Tess_State.samp, Multiply(CAD_Tess_State.zip_cx, 3)))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 1), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.zip_cx, 3), 1)))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 2), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.zip_cx, 3), 2)))
                            IfCondition EqualTo(CAD_Tess_State.want_h, 0) ThenBlock: {
                                ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                            }
                            IfCondition EqualTo(CAD_Tess_State.want_h, 1) ThenBlock: {
                                ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                            }
                            CAD_Tess_State.zip_nt = Add(CAD_Tess_State.zip_nt, 1)
                            CAD_Tess_State.zip_cx = Add(CAD_Tess_State.zip_cx, 1)
                        }
                        CAD_Tess_State.use_zip = 1
                    }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_best, 0), 3) ThenBlock: {
                        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(65536) }
                        CAD_Tess_State.nring = CAD_Tess.SampleEllipseByEnds(CAD_Tess_State.zip_ao, 48, CAD_Tess_State.samp)
                        rev = CAD_Tess.CoedgeRev(CAD_Tess_State.zip_i, CAD_Tess_State.zip_ao)
                        IfCondition EqualTo(rev, 1) ThenBlock: {
                            CAD_Tess.ReverseSamp(CAD_Tess_State.nring)
                        }
                        CAD_Tess_State.zip_cx = 0
                        WhileLoop LessThan(CAD_Tess_State.zip_cx, CAD_Tess_State.nring) {
                            ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), ArrayGet(CAD_Tess_State.samp, Multiply(CAD_Tess_State.zip_cx, 3)))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 1), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.zip_cx, 3), 1)))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 2), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.zip_cx, 3), 2)))
                            IfCondition EqualTo(CAD_Tess_State.want_h, 0) ThenBlock: {
                                ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                            }
                            IfCondition EqualTo(CAD_Tess_State.want_h, 1) ThenBlock: {
                                ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                            }
                            CAD_Tess_State.zip_nt = Add(CAD_Tess_State.zip_nt, 1)
                            CAD_Tess_State.zip_cx = Add(CAD_Tess_State.zip_cx, 1)
                        }
                        IfCondition GreaterThan(CAD_Tess_State.nring, 1) ThenBlock: { CAD_Tess_State.use_zip = 1 }
                    }
                }
            }
            IfCondition EqualTo(CAD_Tess_State.use_zip, 0) ThenBlock: {
                CAD_Tess_State.zip_best = CAD_Store.Read(CAD_Tess_State.zip_i, 5)
                IfCondition NotEqual(CAD_Tess_State.zip_best, 0) ThenBlock: {
                    ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), CAD_Store.Read(CAD_Tess_State.zip_best, 0))
                    ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 1), CAD_Store.Read(CAD_Tess_State.zip_best, 1))
                    ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 2), CAD_Store.Read(CAD_Tess_State.zip_best, 2))
                    IfCondition EqualTo(CAD_Tess_State.want_h, 0) ThenBlock: {
                        ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                    }
                    IfCondition EqualTo(CAD_Tess_State.want_h, 1) ThenBlock: {
                        ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                    }
                    CAD_Tess_State.zip_nt = Add(CAD_Tess_State.zip_nt, 1)
                }
            }
            CAD_Tess_State.zip_i = CAD_Store.Read(CAD_Tess_State.zip_i, 2)
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        ArraySet(CAD_Tess_State.pack, 0, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
        ReturnValue(CAD_Tess_State.zip_nt)
    }
}

Function.CAD_Tess.LoopHasCircle {
    Input: loop_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(loop_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Tess_State.zip_i = CAD_Store.Read(loop_h, 0)
        CAD_Tess_State.zip_j = CAD_Tess_State.zip_i
        CAD_Tess_State.pi = 0
        WhileLoop LessThan(CAD_Tess_State.pi, 16) {
            IfCondition EqualTo(CAD_Tess_State.zip_i, 0) ThenBlock: { ReturnValue(0) }
            CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.zip_i, 0)
            IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                CAD_Tess_State.zip_best = CAD_Store.Read(CAD_Tess_State.zip_ao, 2)
                IfCondition NotEqual(CAD_Tess_State.zip_best, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_best, 0), 2) ThenBlock: { ReturnValue(1) }
                }
            }
            CAD_Tess_State.zip_i = CAD_Store.Read(CAD_Tess_State.zip_i, 2)
            IfCondition EqualTo(CAD_Tess_State.zip_i, CAD_Tess_State.zip_j) ThenBlock: { CAD_Tess_State.pi = 16 }
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        ReturnValue(0)
    }
}

// Reverse samp[0..n) xyz triples. Used when a loop walks an edge backward.
Function.CAD_Tess.ReverseSamp {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(n) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(n) }
        lo = 0
        hi = Subtract(n, 1)
        WhileLoop LessThan(lo, hi) {
            ox = Multiply(lo, 3)
            hx = Multiply(hi, 3)
            tx = ArrayGet(CAD_Tess_State.samp, ox)
            ty = ArrayGet(CAD_Tess_State.samp, Add(ox, 1))
            tz = ArrayGet(CAD_Tess_State.samp, Add(ox, 2))
            ArraySet(CAD_Tess_State.samp, ox, ArrayGet(CAD_Tess_State.samp, hx))
            ArraySet(CAD_Tess_State.samp, Add(ox, 1), ArrayGet(CAD_Tess_State.samp, Add(hx, 1)))
            ArraySet(CAD_Tess_State.samp, Add(ox, 2), ArrayGet(CAD_Tess_State.samp, Add(hx, 2)))
            ArraySet(CAD_Tess_State.samp, hx, tx)
            ArraySet(CAD_Tess_State.samp, Add(hx, 1), ty)
            ArraySet(CAD_Tess_State.samp, Add(hx, 2), tz)
            lo = Add(lo, 1)
            hi = Subtract(hi, 1)
        }
        ReturnValue(n)
    }
}

// Sample a CIRCLE edge into out_xyz (nseg+1 points, xyz triples).
// If the curve stores a signed span in slot 11 (extrude arc), use that —
// Atan2 wrap to (-π,π] is the short way and flips any arc > 180°.
// Returns nseg+1 or 0.
Function.CAD_Tess.SampleCircleEdge {
    Input: edge_h: Integer
    Input: nseg: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(out_xyz, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = out_xyz }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg, 2) ThenBlock: { nseg = 8 }
        IfCondition GreaterThan(nseg, 256) ThenBlock: { nseg = 256 }
        CAD_Tess_State.sc_n = Add(nseg, 1)
        CAD_Tess_State.sc_crv = CAD_Store.Read(edge_h, 2)
        IfCondition EqualTo(CAD_Tess_State.sc_crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Store.IsLive(CAD_Tess_State.sc_crv), 0) ThenBlock: { ReturnValue(0) }
        // slot12 = signed span (survives). slot11 a0 is clobbered to 0.
        // Start at Atan2(edge v0) so we walk the stored span from the real end.
        CAD_Tess_State.sc_span = CAD_Store.Read(CAD_Tess_State.sc_crv, 12)
        CAD_Tess_State.sc_closed = CAD_Store.Read(CAD_Tess_State.sc_crv, 0)
        CAD_Tess_State.sc_i = CAD_Store.Read(edge_h, 0)
        IfCondition EqualTo(CAD_Tess_State.sc_closed, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.sc_span, 0), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Tess_State.sc_i, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(CAD_Store.IsLive(CAD_Tess_State.sc_i), 0) ThenBlock: { ReturnValue(0) }
                p0x = Float_Sub(CAD_Store.Read(CAD_Tess_State.sc_i, 0), CAD_Store.Read(CAD_Tess_State.sc_crv, 1))
                p0y = Float_Sub(CAD_Store.Read(CAD_Tess_State.sc_i, 1), CAD_Store.Read(CAD_Tess_State.sc_crv, 2))
                p0z = Float_Sub(CAD_Store.Read(CAD_Tess_State.sc_i, 2), CAD_Store.Read(CAD_Tess_State.sc_crv, 3))
                IfCondition NotEqual(CAD_Tess_State.pack, 0) ThenBlock: {
                    ArraySet(CAD_Tess_State.pack, 30, CAD_Tess_State.sc_i)
                    ArraySet(CAD_Tess_State.pack, 31, CAD_Store.Read(edge_h, 1))
                }
                CAD_Tess_State.sc_a0 = CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(p0x, CAD_Store.Read(CAD_Tess_State.sc_crv, 7)), Float_Mul(p0y, CAD_Store.Read(CAD_Tess_State.sc_crv, 8))), Float_Mul(p0z, CAD_Store.Read(CAD_Tess_State.sc_crv, 9))), Float_Add(Float_Add(Float_Mul(p0x, CAD_Store.Read(CAD_Tess_State.sc_crv, 4)), Float_Mul(p0y, CAD_Store.Read(CAD_Tess_State.sc_crv, 5))), Float_Mul(p0z, CAD_Store.Read(CAD_Tess_State.sc_crv, 6))))
                CAD_Tess.Pipe("pipe sample PATH=PARAM\n", 23)
                CAD_Tess_State.sc_closed = Subtract(CAD_Tess_State.sc_n, 1)
                CAD_Tess_State.sc_i = 0
                WhileLoop LessThan(CAD_Tess_State.sc_i, CAD_Tess_State.sc_n) {
                    CAD_Tess_State.sc_ang = Float_Add(CAD_Tess_State.sc_a0, Float_Mul(CAD_Tess_State.sc_span, Float_Div(Float_FromInt(CAD_Tess_State.sc_i), Float_FromInt(CAD_Tess_State.sc_closed))))
                    CAD_Tess_State.sc_cos = CAD_Geom.Cos(CAD_Tess_State.sc_ang)
                    CAD_Tess_State.sc_sin = CAD_Geom.Sin(CAD_Tess_State.sc_ang)
                    cx = CAD_Store.Read(CAD_Tess_State.sc_crv, 1)
                    cy = CAD_Store.Read(CAD_Tess_State.sc_crv, 2)
                    cz = CAD_Store.Read(CAD_Tess_State.sc_crv, 3)
                    xx = CAD_Store.Read(CAD_Tess_State.sc_crv, 4)
                    xy = CAD_Store.Read(CAD_Tess_State.sc_crv, 5)
                    xz = CAD_Store.Read(CAD_Tess_State.sc_crv, 6)
                    yx = CAD_Store.Read(CAD_Tess_State.sc_crv, 7)
                    yy = CAD_Store.Read(CAD_Tess_State.sc_crv, 8)
                    yz = CAD_Store.Read(CAD_Tess_State.sc_crv, 9)
                    rad = CAD_Store.Read(CAD_Tess_State.sc_crv, 10)
                    px = Float_Add(cx, Float_Add(Float_Mul(Float_Mul(rad, CAD_Tess_State.sc_cos), xx), Float_Mul(Float_Mul(rad, CAD_Tess_State.sc_sin), yx)))
                    py = Float_Add(cy, Float_Add(Float_Mul(Float_Mul(rad, CAD_Tess_State.sc_cos), xy), Float_Mul(Float_Mul(rad, CAD_Tess_State.sc_sin), yy)))
                    pz = Float_Add(cz, Float_Add(Float_Mul(Float_Mul(rad, CAD_Tess_State.sc_cos), xz), Float_Mul(Float_Mul(rad, CAD_Tess_State.sc_sin), yz)))
                    vo = Multiply(CAD_Tess_State.sc_i, 3)
                    ArraySet(CAD_Tess_State.samp, vo, px)
                    ArraySet(CAD_Tess_State.samp, Add(vo, 1), py)
                    ArraySet(CAD_Tess_State.samp, Add(vo, 2), pz)
                    CAD_Tess_State.sc_i = Add(CAD_Tess_State.sc_i, 1)
                }
                // Pin ends to the edge verts (pack 30/31 saved before Cos).
                IfCondition NotEqual(CAD_Tess_State.pack, 0) ThenBlock: {
                    CAD_Tess_State.sc_i = ArrayGet(CAD_Tess_State.pack, 30)
                    IfCondition NotEqual(CAD_Tess_State.sc_i, 0) ThenBlock: {
                        ArraySet(CAD_Tess_State.samp, 0, CAD_Store.Read(CAD_Tess_State.sc_i, 0))
                        ArraySet(CAD_Tess_State.samp, 1, CAD_Store.Read(CAD_Tess_State.sc_i, 1))
                        ArraySet(CAD_Tess_State.samp, 2, CAD_Store.Read(CAD_Tess_State.sc_i, 2))
                    }
                    CAD_Tess_State.sc_i = ArrayGet(CAD_Tess_State.pack, 31)
                    IfCondition NotEqual(CAD_Tess_State.sc_i, 0) ThenBlock: {
                        CAD_Tess_State.sc_closed = Multiply(Subtract(CAD_Tess_State.sc_n, 1), 3)
                        ArraySet(CAD_Tess_State.samp, CAD_Tess_State.sc_closed, CAD_Store.Read(CAD_Tess_State.sc_i, 0))
                        ArraySet(CAD_Tess_State.samp, Add(CAD_Tess_State.sc_closed, 1), CAD_Store.Read(CAD_Tess_State.sc_i, 1))
                        ArraySet(CAD_Tess_State.samp, Add(CAD_Tess_State.sc_closed, 2), CAD_Store.Read(CAD_Tess_State.sc_i, 2))
                    }
                }
                CAD_Tess.PipeI(" n=", 3, CAD_Tess_State.sc_n)
                ReturnValue(CAD_Tess_State.sc_n)
            }
        }
        CAD_Tess.Pipe("pipe sample PATH=ATAN2\n", 23)
        IfCondition NotEqual(CAD_Tess_State.sc_closed, 2) ThenBlock: {
            CAD_Tess_State.sc_span = 0
        }
        IfCondition EqualTo(CAD_Tess_State.sc_closed, 2) ThenBlock: { CAD_Tess_State.sc_closed = 2 }
        IfCondition NotEqual(CAD_Tess_State.sc_closed, 2) ThenBlock: {
            IfCondition NotEqual(CAD_Tess_State.sc_closed, 3) ThenBlock: { ReturnValue(0) }
        }
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Store.IsLive(v0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Store.IsLive(v1), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, v1) ThenBlock: { CAD_Tess_State.sc_span = 0 }
        CAD_Tess_State.sc_i = 0
        IfCondition EqualTo(v0, v1) ThenBlock: { CAD_Tess_State.sc_i = 1 }
        cx = CAD_Store.Read(CAD_Tess_State.sc_crv, 1)
        cy = CAD_Store.Read(CAD_Tess_State.sc_crv, 2)
        cz = CAD_Store.Read(CAD_Tess_State.sc_crv, 3)
        xx = CAD_Store.Read(CAD_Tess_State.sc_crv, 4)
        xy = CAD_Store.Read(CAD_Tess_State.sc_crv, 5)
        xz = CAD_Store.Read(CAD_Tess_State.sc_crv, 6)
        yx = CAD_Store.Read(CAD_Tess_State.sc_crv, 7)
        yy = CAD_Store.Read(CAD_Tess_State.sc_crv, 8)
        yz = CAD_Store.Read(CAD_Tess_State.sc_crv, 9)
        rad = CAD_Store.Read(CAD_Tess_State.sc_crv, 10)
        rmin = rad
        IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.sc_crv, 0), 3) ThenBlock: {
            rmin = CAD_Store.Read(CAD_Tess_State.sc_crv, 11)
        }
        // θ from atan2(dot(P-C,Y), dot(P-C,X))
        p0x = Float_Sub(CAD_Store.Read(v0, 0), cx)
        p0y = Float_Sub(CAD_Store.Read(v0, 1), cy)
        p0z = Float_Sub(CAD_Store.Read(v0, 2), cz)
        p1x = Float_Sub(CAD_Store.Read(v1, 0), cx)
        p1y = Float_Sub(CAD_Store.Read(v1, 1), cy)
        p1z = Float_Sub(CAD_Store.Read(v1, 2), cz)
        d0x = Float_Add(Float_Add(Float_Mul(p0x, xx), Float_Mul(p0y, xy)), Float_Mul(p0z, xz))
        d0y = Float_Add(Float_Add(Float_Mul(p0x, yx), Float_Mul(p0y, yy)), Float_Mul(p0z, yz))
        d1x = Float_Add(Float_Add(Float_Mul(p1x, xx), Float_Mul(p1y, xy)), Float_Mul(p1z, xz))
        d1y = Float_Add(Float_Add(Float_Mul(p1x, yx), Float_Mul(p1y, yy)), Float_Mul(p1z, yz))
        // ellipse parameter uses (dotX/Rmaj, dotY/Rmin)
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 0) ThenBlock: {
            d0x = Float_Div(d0x, rad)
            d1x = Float_Div(d1x, rad)
        }
        IfCondition EqualTo(CAD_Num.IsZero(rmin, 0), 0) ThenBlock: {
            d0y = Float_Div(d0y, rmin)
            d1y = Float_Div(d1y, rmin)
        }
        CAD_Tess_State.zip_cx = d0x
        CAD_Tess_State.zip_cy = d0y
        CAD_Tess_State.merge_hoff = d1x
        CAD_Tess_State.merge_hi = d1y
        CAD_Tess_State.sc_a0 = CAD_Geom.Atan2(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cx)
        CAD_Tess_State.zip_best = CAD_Geom.Atan2(CAD_Tess_State.merge_hi, CAD_Tess_State.merge_hoff)
        two_pi = 0x401921FB54442D18
        span = Float_Sub(CAD_Tess_State.zip_best, CAD_Tess_State.sc_a0)
        // Pin (start+stored-end) before IsZero kills a1. Keep sc_crv as the curve.
        CAD_Tess_State.zip_cy = Float_Sub(Float_Add(CAD_Tess_State.sc_a0, CAD_Tess_State.sc_span), CAD_Tess_State.zip_best)
        CAD_Tess_State.sc_closed = CAD_Tess_State.sc_i
        IfCondition EqualTo(CAD_Tess_State.sc_closed, 1) ThenBlock: {
            span = two_pi
        }
        IfCondition EqualTo(CAD_Tess_State.sc_closed, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.sc_span, 0), 0) ThenBlock: {
                // Keep stored span only if it lands on v1 (else another curve's bits).
                ok = 0
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.zip_cy, 0), 1) ThenBlock: { ok = 1 }
                IfCondition EqualTo(CAD_Num.IsZero(Float_Sub(CAD_Tess_State.zip_cy, two_pi), 0), 1) ThenBlock: { ok = 1 }
                IfCondition EqualTo(CAD_Num.IsZero(Float_Add(CAD_Tess_State.zip_cy, two_pi), 0), 1) ThenBlock: { ok = 1 }
                IfCondition EqualTo(ok, 1) ThenBlock: { span = CAD_Tess_State.sc_span }
                IfCondition EqualTo(ok, 0) ThenBlock: { CAD_Tess_State.sc_span = 0 }
            }
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.sc_span, 0), 1) ThenBlock: {
                // no stored span: short-way wrap (legacy edges)
                pi = 0x400921FB54442D18
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(span, Float_Sub(0, pi))), 1) ThenBlock: {
                    span = Float_Add(span, two_pi)
                }
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, span)), 1) ThenBlock: {
                    span = Float_Sub(span, two_pi)
                }
            }
        }
        CAD_Tess_State.sc_span = span
        CAD_Tess_State.sc_closed = Subtract(CAD_Tess_State.sc_n, 1)
        CAD_Tess_State.sc_i = 0
        WhileLoop LessThan(CAD_Tess_State.sc_i, CAD_Tess_State.sc_n) {
            CAD_Tess_State.sc_ang = Float_Add(CAD_Tess_State.sc_a0, Float_Mul(CAD_Tess_State.sc_span, Float_Div(Float_FromInt(CAD_Tess_State.sc_i), Float_FromInt(CAD_Tess_State.sc_closed))))
            CAD_Tess_State.sc_cos = CAD_Geom.Cos(CAD_Tess_State.sc_ang)
            CAD_Tess_State.sc_sin = CAD_Geom.Sin(CAD_Tess_State.sc_ang)
            cx = CAD_Store.Read(CAD_Tess_State.sc_crv, 1)
            cy = CAD_Store.Read(CAD_Tess_State.sc_crv, 2)
            cz = CAD_Store.Read(CAD_Tess_State.sc_crv, 3)
            xx = CAD_Store.Read(CAD_Tess_State.sc_crv, 4)
            xy = CAD_Store.Read(CAD_Tess_State.sc_crv, 5)
            xz = CAD_Store.Read(CAD_Tess_State.sc_crv, 6)
            yx = CAD_Store.Read(CAD_Tess_State.sc_crv, 7)
            yy = CAD_Store.Read(CAD_Tess_State.sc_crv, 8)
            yz = CAD_Store.Read(CAD_Tess_State.sc_crv, 9)
            rad = CAD_Store.Read(CAD_Tess_State.sc_crv, 10)
            rmin = rad
            IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.sc_crv, 0), 3) ThenBlock: {
                rmin = CAD_Store.Read(CAD_Tess_State.sc_crv, 11)
            }
            px = Float_Add(cx, Float_Add(Float_Mul(Float_Mul(rad, CAD_Tess_State.sc_cos), xx), Float_Mul(Float_Mul(rmin, CAD_Tess_State.sc_sin), yx)))
            py = Float_Add(cy, Float_Add(Float_Mul(Float_Mul(rad, CAD_Tess_State.sc_cos), xy), Float_Mul(Float_Mul(rmin, CAD_Tess_State.sc_sin), yy)))
            pz = Float_Add(cz, Float_Add(Float_Mul(Float_Mul(rad, CAD_Tess_State.sc_cos), xz), Float_Mul(Float_Mul(rmin, CAD_Tess_State.sc_sin), yz)))
            vo = Multiply(CAD_Tess_State.sc_i, 3)
            ArraySet(CAD_Tess_State.samp, vo, px)
            ArraySet(CAD_Tess_State.samp, Add(vo, 1), py)
            ArraySet(CAD_Tess_State.samp, Add(vo, 2), pz)
            CAD_Tess_State.sc_i = Add(CAD_Tess_State.sc_i, 1)
        }
        ReturnValue(CAD_Tess_State.sc_n)
    }
}

// Quarter-ellipse from v0 to v1 about the curve origin: P(t)=C+A cos + B sin.
// Digon corners are exactly this (P_ww → P_cap). Avoids Atan2 frame mismatch
// that made SampleCircleEdge return a sliver and MeshCylBlendFace FanNGon
// (flat chamfer, open corner — noendclosure.png).
Function.CAD_Tess.SampleEllipseByEnds {
    Input: edge_h: Integer
    Input: nseg: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg, 2) ThenBlock: { nseg = 8 }
        crv = CAD_Store.Read(edge_h, 2)
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = out_xyz }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(nseg, 256) ThenBlock: { nseg = 256 }
        cx = CAD_Store.Read(crv, 1)
        cy = CAD_Store.Read(crv, 2)
        cz = CAD_Store.Read(crv, 3)
        xx = CAD_Store.Read(crv, 4)
        xy = CAD_Store.Read(crv, 5)
        xz = CAD_Store.Read(crv, 6)
        yx = CAD_Store.Read(crv, 7)
        yy = CAD_Store.Read(crv, 8)
        yz = CAD_Store.Read(crv, 9)
        rmaj = CAD_Store.Read(crv, 10)
        rmin = CAD_Store.Read(crv, 11)
        use_phi = 1
        IfCondition EqualTo(CAD_Num.IsZero(rmaj, 0), 1) ThenBlock: { use_phi = 0 }
        IfCondition EqualTo(CAD_Num.IsZero(rmin, 0), 1) ThenBlock: { use_phi = 0 }
        CAD_Tess_State.sc_n = Add(nseg, 1)
        CAD_Tess_State.sc_closed = nseg
        CAD_Tess_State.sc_crv = crv
        CAD_Tess_State.sc_span = v0
        CAD_Tess_State.sc_a0 = v1
        IfCondition EqualTo(use_phi, 1) ThenBlock: {
            p0x = Float_Sub(CAD_Store.Read(v0, 0), cx)
            p0y = Float_Sub(CAD_Store.Read(v0, 1), cy)
            p0z = Float_Sub(CAD_Store.Read(v0, 2), cz)
            p1x = Float_Sub(CAD_Store.Read(v1, 0), cx)
            p1y = Float_Sub(CAD_Store.Read(v1, 1), cy)
            p1z = Float_Sub(CAD_Store.Read(v1, 2), cz)
            u0 = Float_Add(Float_Add(Float_Mul(p0x, xx), Float_Mul(p0y, xy)), Float_Mul(p0z, xz))
            v0p = Float_Add(Float_Add(Float_Mul(p0x, yx), Float_Mul(p0y, yy)), Float_Mul(p0z, yz))
            u1 = Float_Add(Float_Add(Float_Mul(p1x, xx), Float_Mul(p1y, xy)), Float_Mul(p1z, xz))
            v1p = Float_Add(Float_Add(Float_Mul(p1x, yx), Float_Mul(p1y, yy)), Float_Mul(p1z, yz))
            a0y = Float_Div(v0p, rmin)
            a0x = Float_Div(u0, rmaj)
            a1y = Float_Div(v1p, rmin)
            a1x = Float_Div(u1, rmaj)
            phi0 = CAD_Geom.Atan2(a0y, a0x)
            phi1 = CAD_Geom.Atan2(a1y, a1x)
            span = Float_Sub(phi1, phi0)
            two_pi = 0x401921FB54442D18
            pi = 0x400921FB54442D18
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(span, Float_Sub(0, pi))), 1) ThenBlock: {
                span = Float_Add(span, two_pi)
            }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, span)), 1) ThenBlock: {
                span = Float_Sub(span, two_pi)
            }
            CAD_Tess_State.sc_i = 0
            WhileLoop LessThan(CAD_Tess_State.sc_i, CAD_Tess_State.sc_n) {
                vo = Multiply(CAD_Tess_State.sc_i, 3)
                IfCondition EqualTo(CAD_Tess_State.sc_i, 0) ThenBlock: {
                    ArraySet(CAD_Tess_State.samp, vo, CAD_Store.Read(v0, 0))
                    ArraySet(CAD_Tess_State.samp, Add(vo, 1), CAD_Store.Read(v0, 1))
                    ArraySet(CAD_Tess_State.samp, Add(vo, 2), CAD_Store.Read(v0, 2))
                }
                IfCondition EqualTo(CAD_Tess_State.sc_i, nseg) ThenBlock: {
                    ArraySet(CAD_Tess_State.samp, vo, CAD_Store.Read(v1, 0))
                    ArraySet(CAD_Tess_State.samp, Add(vo, 1), CAD_Store.Read(v1, 1))
                    ArraySet(CAD_Tess_State.samp, Add(vo, 2), CAD_Store.Read(v1, 2))
                }
                IfCondition GreaterThan(CAD_Tess_State.sc_i, 0) ThenBlock: {
                    IfCondition LessThan(CAD_Tess_State.sc_i, nseg) ThenBlock: {
                        CAD_Tess_State.sc_ang = Float_Add(phi0, Float_Mul(span, Float_Div(Float_FromInt(CAD_Tess_State.sc_i), Float_FromInt(nseg))))
                        CAD_Tess_State.sc_cos = CAD_Geom.Cos(CAD_Tess_State.sc_ang)
                        CAD_Tess_State.sc_sin = CAD_Geom.Sin(CAD_Tess_State.sc_ang)
                        ArraySet(CAD_Tess_State.samp, vo, Float_Add(cx, Float_Add(Float_Mul(rmaj, Float_Mul(CAD_Tess_State.sc_cos, xx)), Float_Mul(rmin, Float_Mul(CAD_Tess_State.sc_sin, yx)))))
                        ArraySet(CAD_Tess_State.samp, Add(vo, 1), Float_Add(cy, Float_Add(Float_Mul(rmaj, Float_Mul(CAD_Tess_State.sc_cos, xy)), Float_Mul(rmin, Float_Mul(CAD_Tess_State.sc_sin, yy)))))
                        ArraySet(CAD_Tess_State.samp, Add(vo, 2), Float_Add(cz, Float_Add(Float_Mul(rmaj, Float_Mul(CAD_Tess_State.sc_cos, xz)), Float_Mul(rmin, Float_Mul(CAD_Tess_State.sc_sin, yz)))))
                    }
                }
                CAD_Tess_State.sc_i = Add(CAD_Tess_State.sc_i, 1)
            }
        }
        IfCondition EqualTo(use_phi, 0) ThenBlock: {
            CAD_Tess_State.sc_i = 0
            WhileLoop LessThan(CAD_Tess_State.sc_i, CAD_Tess_State.sc_n) {
                CAD_Tess_State.sc_ang = Float_Mul(0x3FF921FB54442D18, Float_Div(Float_FromInt(CAD_Tess_State.sc_i), Float_FromInt(CAD_Tess_State.sc_closed)))
                CAD_Tess_State.sc_cos = CAD_Geom.Cos(CAD_Tess_State.sc_ang)
                CAD_Tess_State.sc_sin = CAD_Geom.Sin(CAD_Tess_State.sc_ang)
                ax = Float_Sub(CAD_Store.Read(v0, 0), cx)
                ay = Float_Sub(CAD_Store.Read(v0, 1), cy)
                az = Float_Sub(CAD_Store.Read(v0, 2), cz)
                bx = Float_Sub(CAD_Store.Read(v1, 0), cx)
                by = Float_Sub(CAD_Store.Read(v1, 1), cy)
                bz = Float_Sub(CAD_Store.Read(v1, 2), cz)
                vo = Multiply(CAD_Tess_State.sc_i, 3)
                ArraySet(CAD_Tess_State.samp, vo, Float_Add(cx, Float_Add(Float_Mul(ax, CAD_Tess_State.sc_cos), Float_Mul(bx, CAD_Tess_State.sc_sin))))
                ArraySet(CAD_Tess_State.samp, Add(vo, 1), Float_Add(cy, Float_Add(Float_Mul(ay, CAD_Tess_State.sc_cos), Float_Mul(by, CAD_Tess_State.sc_sin))))
                ArraySet(CAD_Tess_State.samp, Add(vo, 2), Float_Add(cz, Float_Add(Float_Mul(az, CAD_Tess_State.sc_cos), Float_Mul(bz, CAD_Tess_State.sc_sin))))
                CAD_Tess_State.sc_i = Add(CAD_Tess_State.sc_i, 1)
            }
        }
        ReturnValue(CAD_Tess_State.sc_n)
    }
}

// Cylinder∩torus cope. Slots: M 1..3, W 4..6, N 7..9, D 10..12,
// R 13, Rmaj 14, Rh 15, spine C 16..18 (C.z = M.z). φ=0 is the lid,
// φ=π/2 is the wall. Upper branch only. Locals only: the torus grid
// owns Tess_State across MerPointAtZ.
Function.CAD_Tess.CopePhi {
    Input: crv: Integer
    Input: phi: Integer
    Input: out3: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(out3, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 5) ThenBlock: { ReturnValue(0) }
        mx = CAD_Store.Read(crv, 1)
        my = CAD_Store.Read(crv, 2)
        mz = CAD_Store.Read(crv, 3)
        wx = CAD_Store.Read(crv, 4)
        wy = CAD_Store.Read(crv, 5)
        wz = CAD_Store.Read(crv, 6)
        nx = CAD_Store.Read(crv, 7)
        ny = CAD_Store.Read(crv, 8)
        nz = CAD_Store.Read(crv, 9)
        dx = CAD_Store.Read(crv, 10)
        dy = CAD_Store.Read(crv, 11)
        dz = CAD_Store.Read(crv, 12)
        rr = CAD_Store.Read(crv, 13)
        rj = CAD_Store.Read(crv, 14)
        rh = CAD_Store.Read(crv, 15)
        cx = CAD_Store.Read(crv, 16)
        cy = CAD_Store.Read(crv, 17)
        sn = CAD_Geom.Sin(phi)
        cs = CAD_Geom.Cos(phi)
        rho = Float_Add(rj, Float_Mul(sn, Float_Sub(rh, rj)))
        u = Float_Add(Float_Mul(Float_Sub(mx, cx), dx), Float_Mul(Float_Sub(my, cy), dy))
        v = Float_Add(Float_Mul(Float_Sub(mx, cx), wx), Float_Mul(Float_Sub(my, cy), wy))
        rs = Float_Mul(rr, sn)
        q = Float_Add(Float_Mul(u, u), Float_Mul(rho, rho))
        q = Float_Sub(q, Float_Mul(rj, rj))
        q = Float_Sub(q, Float_Mul(rs, rs))
        q = Float_Sub(q, Float_Mul(0x4000000000000000, Float_Mul(rs, v)))
        IfCondition EqualTo(CAD_Num.IsNeg(q), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(q, 0x3F1A36E2EB1C432D), 1) ThenBlock: { q = 0 }
        }
        IfCondition EqualTo(CAD_Num.IsNeg(q), 1) ThenBlock: { ReturnValue(0) }
        s = CAD_Num.Sqrt(q)
        IfCondition EqualTo(CAD_Num.IsNeg(u), 1) ThenBlock: { s = Float_Sub(0, s) }
        s = Float_Sub(s, u)
        rc = Float_Mul(rr, cs)
        px = Float_Add(mx, Float_Add(Float_Mul(rs, wx), Float_Add(Float_Mul(rc, nx), Float_Mul(s, dx))))
        py = Float_Add(my, Float_Add(Float_Mul(rs, wy), Float_Add(Float_Mul(rc, ny), Float_Mul(s, dy))))
        pz = Float_Add(mz, Float_Add(Float_Mul(rs, wz), Float_Add(Float_Mul(rc, nz), Float_Mul(s, dz))))
        ArraySet(out3, 0, px)
        ArraySet(out3, 1, py)
        ArraySet(out3, 2, pz)
        ReturnValue(1)
    }
}

// Snap one torus-grid column point onto the cope at this row's z.
// Vertical extrusion only: W and D stay horizontal. Locals only.
Function.CAD_Tess.CopePointAtZ {
    Input: edge: Integer
    Input: vb: Address
    Input: vi: Integer
    Input: abuf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(abuf, 0) ThenBlock: { ReturnValue(0) }
        crv = CAD_Store.Read(edge, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 5) ThenBlock: { ReturnValue(0) }
        tol = 0x3F1A36E2EB1C432D
        wz = CAD_Store.Read(crv, 6)
        dz = CAD_Store.Read(crv, 12)
        IfCondition EqualTo(CAD_Num.IsZero(wz, tol), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(dz, tol), 0) ThenBlock: { ReturnValue(0) }
        rr = CAD_Store.Read(crv, 13)
        nz = CAD_Store.Read(crv, 9)
        mz = CAD_Store.Read(crv, 3)
        IfCondition EqualTo(CAD_Num.IsZero(rr, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(nz, tol), 1) ThenBlock: { ReturnValue(0) }
        zz = ArrayGet(vb, Add(Multiply(vi, 3), 2))
        c = Float_Div(Float_Sub(zz, mz), Float_Mul(rr, nz))
        one = 0x3FF0000000000000
        IfCondition EqualTo(CAD_Num.Le(one, c), 1) ThenBlock: { c = one }
        IfCondition EqualTo(CAD_Num.Le(c, Float_Sub(0, one)), 1) ThenBlock: { c = Float_Sub(0, one) }
        phi = CAD_Geom.Atan2(CAD_Num.Sqrt(Float_Sub(one, Float_Mul(c, c))), c)
        IfCondition EqualTo(CAD_Tess.CopePhi(crv, phi, abuf), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(vb, Multiply(vi, 3), ArrayGet(abuf, 0))
        ArraySet(vb, Add(Multiply(vi, 3), 1), ArrayGet(abuf, 1))
        ArraySet(vb, Add(Multiply(vi, 3), 2), ArrayGet(abuf, 2))
        ReturnValue(1)
    }
}

// Sample the cope from edge v0 to v1. φ runs from the lid end (larger
// (v−M)·N) to the wall end. Ends are pinned to the vertices.
Function.CAD_Tess.SampleCopeEdge {
    Input: edge_h: Integer
    Input: nseg: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg, 2) ThenBlock: { nseg = 8 }
        IfCondition GreaterThan(nseg, 256) ThenBlock: { nseg = 256 }
        crv = CAD_Store.Read(edge_h, 2)
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 5) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = out_xyz }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(0) }
        mx = CAD_Store.Read(crv, 1)
        my = CAD_Store.Read(crv, 2)
        mz = CAD_Store.Read(crv, 3)
        nx = CAD_Store.Read(crv, 7)
        ny = CAD_Store.Read(crv, 8)
        nz = CAD_Store.Read(crv, 9)
        ax = Float_Sub(CAD_Store.Read(v0, 0), mx)
        ay = Float_Sub(CAD_Store.Read(v0, 1), my)
        az = Float_Sub(CAD_Store.Read(v0, 2), mz)
        bx = Float_Sub(CAD_Store.Read(v1, 0), mx)
        by = Float_Sub(CAD_Store.Read(v1, 1), my)
        bz = Float_Sub(CAD_Store.Read(v1, 2), mz)
        d0 = Float_Add(Float_Add(Float_Mul(ax, nx), Float_Mul(ay, ny)), Float_Mul(az, nz))
        d1 = Float_Add(Float_Add(Float_Mul(bx, nx), Float_Mul(by, ny)), Float_Mul(bz, nz))
        half = 0x3FF921FB54442D18
        p0 = 0
        p1 = half
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d0, d1)), 1) ThenBlock: {
            p0 = half
            p1 = 0
        }
        buf = Allocate(32)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        n = Add(nseg, 1)
        i = 0
        WhileLoop LessThan(i, n) {
            vo = Multiply(i, 3)
            IfCondition EqualTo(i, 0) ThenBlock: {
                ArraySet(CAD_Tess_State.samp, vo, CAD_Store.Read(v0, 0))
                ArraySet(CAD_Tess_State.samp, Add(vo, 1), CAD_Store.Read(v0, 1))
                ArraySet(CAD_Tess_State.samp, Add(vo, 2), CAD_Store.Read(v0, 2))
            }
            IfCondition EqualTo(i, nseg) ThenBlock: {
                ArraySet(CAD_Tess_State.samp, vo, CAD_Store.Read(v1, 0))
                ArraySet(CAD_Tess_State.samp, Add(vo, 1), CAD_Store.Read(v1, 1))
                ArraySet(CAD_Tess_State.samp, Add(vo, 2), CAD_Store.Read(v1, 2))
            }
            IfCondition GreaterThan(i, 0) ThenBlock: {
                IfCondition LessThan(i, nseg) ThenBlock: {
                    phi = Float_Add(p0, Float_Mul(Float_Sub(p1, p0), Float_Div(Float_FromInt(i), Float_FromInt(nseg))))
                    ok = CAD_Tess.CopePhi(crv, phi, buf)
                    IfCondition EqualTo(ok, 0) ThenBlock: {
                        Deallocate(buf, 32)
                        ReturnValue(0)
                    }
                    ArraySet(CAD_Tess_State.samp, vo, ArrayGet(buf, 0))
                    ArraySet(CAD_Tess_State.samp, Add(vo, 1), ArrayGet(buf, 1))
                    ArraySet(CAD_Tess_State.samp, Add(vo, 2), ArrayGet(buf, 2))
                }
            }
            i = Add(i, 1)
        }
        Deallocate(buf, 32)
        ReturnValue(n)
    }
}

// Torus∩torus. Slots: 1 cx1, 2 cy1, 3 zspine, 4 Rmaj1, 5 Rh1,
// 6 cx2, 7 cy2, 8 Rmaj2, 9 Rh2, 10 R, 11 corner x, 12 corner y.
// φ=0 is the lid pinch. φ=π/2 is the profile corner at zspine.
// The branch nearer the corner. Locals only.
Function.CAD_Tess.ArcArcPhi {
    Input: crv: Integer
    Input: phi: Integer
    Input: out3: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(out3, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 6) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(crv, 1)
        cy = CAD_Store.Read(crv, 2)
        zs = CAD_Store.Read(crv, 3)
        r1 = CAD_Store.Read(crv, 4)
        h1 = CAD_Store.Read(crv, 5)
        cx2 = CAD_Store.Read(crv, 6)
        cy2 = CAD_Store.Read(crv, 7)
        r2 = CAD_Store.Read(crv, 8)
        h2r = CAD_Store.Read(crv, 9)
        rr = CAD_Store.Read(crv, 10)
        vx = CAD_Store.Read(crv, 11)
        vy = CAD_Store.Read(crv, 12)
        IfCondition EqualTo(CAD_Num.IsZero(rr, 0), 1) ThenBlock: { ReturnValue(0) }
        sn = CAD_Geom.Sin(phi)
        cs = CAD_Geom.Cos(phi)
        rho1 = Float_Add(r1, Float_Mul(sn, Float_Sub(h1, r1)))
        rho2 = Float_Add(r2, Float_Mul(sn, Float_Sub(h2r, r2)))
        dx = Float_Sub(cx2, cx)
        dy = Float_Sub(cy2, cy)
        d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: { ReturnValue(0) }
        two = 0x4000000000000000
        a = Float_Div(Float_Add(Float_Sub(Float_Mul(rho1, rho1), Float_Mul(rho2, rho2)), Float_Mul(d, d)), Float_Mul(two, d))
        hh = Float_Sub(Float_Mul(rho1, rho1), Float_Mul(a, a))
        IfCondition EqualTo(CAD_Num.IsNeg(hh), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(hh, 0x3F1A36E2EB1C432D), 1) ThenBlock: { hh = 0 }
        }
        IfCondition EqualTo(CAD_Num.IsNeg(hh), 1) ThenBlock: { ReturnValue(0) }
        h = CAD_Num.Sqrt(hh)
        ux = Float_Div(dx, d)
        uy = Float_Div(dy, d)
        px = Float_Sub(0, uy)
        py = ux
        mx = Float_Add(cx, Float_Mul(a, ux))
        my = Float_Add(cy, Float_Mul(a, uy))
        p1x = Float_Add(mx, Float_Mul(h, px))
        p1y = Float_Add(my, Float_Mul(h, py))
        p2x = Float_Sub(mx, Float_Mul(h, px))
        p2y = Float_Sub(my, Float_Mul(h, py))
        d1 = Float_Add(CAD_Num.Sq(Float_Sub(p1x, vx)), CAD_Num.Sq(Float_Sub(p1y, vy)))
        d2 = Float_Add(CAD_Num.Sq(Float_Sub(p2x, vx)), CAD_Num.Sq(Float_Sub(p2y, vy)))
        qx = p1x
        qy = p1y
        IfCondition EqualTo(CAD_Num.Le(d2, d1), 1) ThenBlock: {
            qx = p2x
            qy = p2y
        }
        ArraySet(out3, 0, qx)
        ArraySet(out3, 1, qy)
        ArraySet(out3, 2, Float_Add(zs, Float_Mul(rr, cs)))
        ReturnValue(1)
    }
}

// Snap one torus-grid column point onto the arc-arc curve at this z.
Function.CAD_Tess.ArcArcPointAtZ {
    Input: edge: Integer
    Input: vb: Address
    Input: vi: Integer
    Input: abuf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(abuf, 0) ThenBlock: { ReturnValue(0) }
        crv = CAD_Store.Read(edge, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 6) ThenBlock: { ReturnValue(0) }
        rr = CAD_Store.Read(crv, 10)
        zs = CAD_Store.Read(crv, 3)
        IfCondition EqualTo(CAD_Num.IsZero(rr, 0), 1) ThenBlock: { ReturnValue(0) }
        zz = ArrayGet(vb, Add(Multiply(vi, 3), 2))
        c = Float_Div(Float_Sub(zz, zs), rr)
        one = 0x3FF0000000000000
        IfCondition EqualTo(CAD_Num.Le(one, c), 1) ThenBlock: { c = one }
        IfCondition EqualTo(CAD_Num.Le(c, Float_Sub(0, one)), 1) ThenBlock: { c = Float_Sub(0, one) }
        phi = CAD_Geom.Atan2(CAD_Num.Sqrt(Float_Sub(one, Float_Mul(c, c))), c)
        IfCondition EqualTo(CAD_Tess.ArcArcPhi(crv, phi, abuf), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(vb, Multiply(vi, 3), ArrayGet(abuf, 0))
        ArraySet(vb, Add(Multiply(vi, 3), 1), ArrayGet(abuf, 1))
        ArraySet(vb, Add(Multiply(vi, 3), 2), ArrayGet(abuf, 2))
        ReturnValue(1)
    }
}

// Sample the arc-arc curve from edge v0 to v1. Ends stay on the vertices.
Function.CAD_Tess.SampleArcArcEdge {
    Input: edge_h: Integer
    Input: nseg: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg, 2) ThenBlock: { nseg = 8 }
        IfCondition GreaterThan(nseg, 256) ThenBlock: { nseg = 256 }
        crv = CAD_Store.Read(edge_h, 2)
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 6) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = out_xyz }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(0) }
        half = 0x3FF921FB54442D18
        z0 = CAD_Store.Read(v0, 2)
        z1 = CAD_Store.Read(v1, 2)
        p0 = 0
        p1 = half
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(z0, z1)), 1) ThenBlock: {
            p0 = half
            p1 = 0
        }
        buf = Allocate(32)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        n = Add(nseg, 1)
        i = 0
        WhileLoop LessThan(i, n) {
            vo = Multiply(i, 3)
            IfCondition EqualTo(i, 0) ThenBlock: {
                ArraySet(CAD_Tess_State.samp, vo, CAD_Store.Read(v0, 0))
                ArraySet(CAD_Tess_State.samp, Add(vo, 1), CAD_Store.Read(v0, 1))
                ArraySet(CAD_Tess_State.samp, Add(vo, 2), CAD_Store.Read(v0, 2))
            }
            IfCondition EqualTo(i, nseg) ThenBlock: {
                ArraySet(CAD_Tess_State.samp, vo, CAD_Store.Read(v1, 0))
                ArraySet(CAD_Tess_State.samp, Add(vo, 1), CAD_Store.Read(v1, 1))
                ArraySet(CAD_Tess_State.samp, Add(vo, 2), CAD_Store.Read(v1, 2))
            }
            IfCondition GreaterThan(i, 0) ThenBlock: {
                IfCondition LessThan(i, nseg) ThenBlock: {
                    phi = Float_Add(p0, Float_Mul(Float_Sub(p1, p0), Float_Div(Float_FromInt(i), Float_FromInt(nseg))))
                    ok = CAD_Tess.ArcArcPhi(crv, phi, buf)
                    IfCondition EqualTo(ok, 0) ThenBlock: {
                        Deallocate(buf, 32)
                        ReturnValue(0)
                    }
                    ArraySet(CAD_Tess_State.samp, vo, ArrayGet(buf, 0))
                    ArraySet(CAD_Tess_State.samp, Add(vo, 1), ArrayGet(buf, 1))
                    ArraySet(CAD_Tess_State.samp, Add(vo, 2), ArrayGet(buf, 2))
                }
            }
            i = Add(i, 1)
        }
        Deallocate(buf, 32)
        ReturnValue(n)
    }
}

// 4-edge loop → zip opposite edges (0 with 2). Line, arc, or circle —
// whatever curve is on the edge. Not a cylinder recipe.
Function.CAD_Tess.MeshRuledLoop {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Tess.FaceBufs(), 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition GreaterThan(ArrayGet(CAD_Tess_State.pack, 0), 60000) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition EqualTo(CAD_Tess_State.tess_loop, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(65536) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.zip_i = CAD_Store.Read(CAD_Tess_State.tess_loop, 0)
        IfCondition EqualTo(CAD_Tess_State.zip_i, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        // 4-cycle is line/arc/line/arc on a fillet cylinder. Zip 0↔2 is the
        // two generators → a flat chamfer. Zip the opposite pair that is
        // actually curved (kind 2/3). Rect walls stay 0↔2 (all lines).
        // Closed circles beat open arcs: a torus face is circle/arc/circle/arc
        // and zipping meridians (last kind-2) is a sliver, not the rim.
        CAD_Tess_State.merge_si = 0
        CAD_Tess_State.zip_b = 2
        CAD_Tess_State.merge_sj = 0
        ArraySet(CAD_Tess_State.pack, 9, 0)
        ArraySet(CAD_Tess_State.pack, 10, 0)
        ArraySet(CAD_Tess_State.pack, 13, 0)
        ArraySet(CAD_Tess_State.pack, 14, 0)
        // Two largest-R circles: a cyl wall with fillet mers must zip
        // the rims (R_arc), not mer↔rim (R_fillet vs R_arc) — that fan
        // is the open-arc face. Same for any extra stitches on a cylinder.
        r_hi = 0
        i_hi = 0
        r_lo = 0
        i_lo = 0
        CAD_Tess_State.zip_j = CAD_Tess_State.zip_i
        CAD_Tess_State.pi = 0
        CAD_Tess_State.want_h = 0
        WhileLoop EqualTo(CAD_Tess_State.want_h, 0) {
            CAD_Tess_State.zip_ah = CAD_Store.Read(CAD_Tess_State.zip_j, 0)
            CAD_Tess_State.use_zip = 0
            IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.zip_ah, 2)
                IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                    CAD_Tess_State.use_zip = CAD_Store.Read(CAD_Tess_State.zip_ao, 0)
                }
            }
            // Zip the curved opposite pair, wherever it sits in the 4-cycle.
            // Only checking pi=1/3 missed line/ell/line/ell vs ell/line/ell/line
            // and left generator-zip (nA=2) = a flat chamfer.
            CAD_Tess_State.zip_best = 0
            IfCondition EqualTo(CAD_Tess_State.use_zip, 2) ThenBlock: {
                IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_ah, 0), CAD_Store.Read(CAD_Tess_State.zip_ah, 1)) ThenBlock: {
                        CAD_Tess_State.zip_best = 1
                    }
                }
            }
            IfCondition EqualTo(CAD_Tess_State.use_zip, 2) ThenBlock: {
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 0) ThenBlock: {
                    CAD_Tess_State.merge_si = CAD_Tess_State.pi
                }
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 1) ThenBlock: {
                    CAD_Tess_State.zip_b = CAD_Tess_State.pi
                }
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
                IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                    CAD_Tess_State.zip_nt = CAD_Store.Read(CAD_Tess_State.zip_ao, 10)
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(r_hi, CAD_Tess_State.zip_nt)), 1) ThenBlock: {
                        r_lo = r_hi
                        i_lo = i_hi
                        r_hi = CAD_Tess_State.zip_nt
                        i_hi = CAD_Tess_State.pi
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(r_hi, CAD_Tess_State.zip_nt)), 0) ThenBlock: {
                        IfCondition NotEqual(i_hi, CAD_Tess_State.pi) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(r_lo, CAD_Tess_State.zip_nt)), 1) ThenBlock: {
                                r_lo = CAD_Tess_State.zip_nt
                                i_lo = CAD_Tess_State.pi
                            }
                        }
                    }
                }
                IfCondition EqualTo(CAD_Tess_State.zip_best, 1) ThenBlock: {
                    ArraySet(CAD_Tess_State.pack, 9, 1)
                    IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 13), 0) ThenBlock: {
                        ArraySet(CAD_Tess_State.pack, 13, Add(CAD_Tess_State.pi, 1))
                    }
                    IfCondition NotEqual(ArrayGet(CAD_Tess_State.pack, 13), 0) ThenBlock: {
                        IfCondition NotEqual(ArrayGet(CAD_Tess_State.pack, 13), Add(CAD_Tess_State.pi, 1)) ThenBlock: {
                            ArraySet(CAD_Tess_State.pack, 14, Add(CAD_Tess_State.pi, 1))
                        }
                    }
                }
            }
            IfCondition EqualTo(CAD_Tess_State.use_zip, 3) ThenBlock: {
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 0) ThenBlock: {
                    CAD_Tess_State.merge_si = CAD_Tess_State.pi
                }
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 1) ThenBlock: {
                    CAD_Tess_State.zip_b = CAD_Tess_State.pi
                }
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
            // Cope (kind 5) zips like an ellipse. Do not set pack[10]:
            // the ruling is linear in φ, and that stays on the cylinder.
            IfCondition EqualTo(CAD_Tess_State.use_zip, 5) ThenBlock: {
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 0) ThenBlock: {
                    CAD_Tess_State.merge_si = CAD_Tess_State.pi
                }
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 1) ThenBlock: {
                    CAD_Tess_State.zip_b = CAD_Tess_State.pi
                }
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
            // Torus∩torus (kind 6) zips like the cope. Do not set pack[10].
            IfCondition EqualTo(CAD_Tess_State.use_zip, 6) ThenBlock: {
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 0) ThenBlock: {
                    CAD_Tess_State.merge_si = CAD_Tess_State.pi
                }
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 1) ThenBlock: {
                    CAD_Tess_State.zip_b = CAD_Tess_State.pi
                }
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
            CAD_Tess_State.zip_j = CAD_Store.Read(CAD_Tess_State.zip_j, 2)
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            IfCondition EqualTo(CAD_Tess_State.zip_j, CAD_Tess_State.zip_i) ThenBlock: { CAD_Tess_State.want_h = 1 }
            IfCondition GreaterThan(CAD_Tess_State.pi, 16) ThenBlock: { CAD_Tess_State.want_h = 1 }
        }
        IfCondition LessThan(CAD_Tess_State.merge_sj, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Tess_State.merge_sj, 0) ThenBlock: {
                CAD_Tess_State.merge_si = 0
                CAD_Tess_State.zip_b = 2
            }
            IfCondition EqualTo(CAD_Tess_State.merge_sj, 1) ThenBlock: {
                CAD_Tess_State.zip_b = Modulo(Add(CAD_Tess_State.merge_si, 2), 4)
            }
        }
        IfCondition NotEqual(ArrayGet(CAD_Tess_State.pack, 13), 0) ThenBlock: {
            IfCondition NotEqual(ArrayGet(CAD_Tess_State.pack, 14), 0) ThenBlock: {
                CAD_Tess_State.merge_si = Subtract(ArrayGet(CAD_Tess_State.pack, 13), 1)
                CAD_Tess_State.zip_b = Subtract(ArrayGet(CAD_Tess_State.pack, 14), 1)
            }
        }
        IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 13), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(r_hi, 0), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(r_lo, 0), 0) ThenBlock: {
                    IfCondition NotEqual(i_hi, i_lo) ThenBlock: {
                        CAD_Tess_State.merge_si = i_hi
                        CAD_Tess_State.zip_b = i_lo
                    }
                }
            }
        }
        ArraySet(CAD_Tess_State.pack, 8, CAD_Tess_State.merge_si)
        CAD_Tess_State.zip_j = CAD_Tess_State.zip_i
        CAD_Tess_State.pi = 0
        CAD_Tess_State.nout = 0
        CAD_Tess_State.nh = 0
        CAD_Tess_State.want_h = 0
        WhileLoop EqualTo(CAD_Tess_State.want_h, 0) {
            CAD_Tess_State.zip_ah = CAD_Store.Read(CAD_Tess_State.zip_j, 0)
            CAD_Tess_State.zip_nt = 0
            CAD_Tess_State.use_zip = 0
            IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.zip_ah, 2)
                IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                    CAD_Tess_State.use_zip = CAD_Store.Read(CAD_Tess_State.zip_ao, 0)
                }
                IfCondition EqualTo(CAD_Tess_State.use_zip, 3) ThenBlock: {
                    CAD_Tess_State.nn = 48
                    IfCondition EqualTo(CAD_Tess_State.pi, CAD_Tess_State.zip_b) ThenBlock: {
                        IfCondition GreaterThan(CAD_Tess_State.nout, 2) ThenBlock: {
                            CAD_Tess_State.nn = Subtract(CAD_Tess_State.nout, 1)
                        }
                    }
                    CAD_Tess_State.zip_nt = CAD_Tess.SampleEllipseByEnds(CAD_Tess_State.zip_ah, CAD_Tess_State.nn, CAD_Tess_State.samp)
                }
                IfCondition EqualTo(CAD_Tess_State.use_zip, 5) ThenBlock: {
                    CAD_Tess_State.nn = 48
                    IfCondition EqualTo(CAD_Tess_State.pi, CAD_Tess_State.zip_b) ThenBlock: {
                        IfCondition GreaterThan(CAD_Tess_State.nout, 2) ThenBlock: {
                            CAD_Tess_State.nn = Subtract(CAD_Tess_State.nout, 1)
                        }
                    }
                    CAD_Tess_State.zip_nt = CAD_Tess.SampleCopeEdge(CAD_Tess_State.zip_ah, CAD_Tess_State.nn, CAD_Tess_State.samp)
                }
                IfCondition EqualTo(CAD_Tess_State.use_zip, 6) ThenBlock: {
                    CAD_Tess_State.nn = 48
                    IfCondition EqualTo(CAD_Tess_State.pi, CAD_Tess_State.zip_b) ThenBlock: {
                        IfCondition GreaterThan(CAD_Tess_State.nout, 2) ThenBlock: {
                            CAD_Tess_State.nn = Subtract(CAD_Tess_State.nout, 1)
                        }
                    }
                    CAD_Tess_State.zip_nt = CAD_Tess.SampleArcArcEdge(CAD_Tess_State.zip_ah, CAD_Tess_State.nn, CAD_Tess_State.samp)
                }
                IfCondition EqualTo(CAD_Tess_State.use_zip, 2) ThenBlock: {
                    CAD_Tess_State.nn = 16
                    IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                        CAD_Tess_State.nn = CAD_Tess.ArcSegCount(CAD_Store.Read(CAD_Tess_State.zip_ao, 10), CAD_Store.Read(CAD_Tess_State.zip_ao, 12))
                    }
                    IfCondition EqualTo(CAD_Tess_State.pi, CAD_Tess_State.zip_b) ThenBlock: {
                        IfCondition GreaterThan(CAD_Tess_State.nout, 2) ThenBlock: {
                            CAD_Tess_State.nn = Subtract(CAD_Tess_State.nout, 1)
                        }
                    }
                    CAD_Tess_State.zip_nt = CAD_Tess.SampleCircleEdge(CAD_Tess_State.zip_ah, CAD_Tess_State.nn, CAD_Tess_State.samp)
                    IfCondition GreaterThan(CAD_Tess_State.zip_nt, 257) ThenBlock: { CAD_Tess_State.zip_nt = 0 }
                    IfCondition LessThan(CAD_Tess_State.zip_nt, 0) ThenBlock: { CAD_Tess_State.zip_nt = 0 }
                }
            }
            IfCondition LessThan(CAD_Tess_State.zip_nt, 2) ThenBlock: {
                IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                    CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.zip_ah, 0)
                    CAD_Tess_State.zip_best = CAD_Store.Read(CAD_Tess_State.zip_ah, 1)
                    IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                        IfCondition NotEqual(CAD_Tess_State.zip_best, 0) ThenBlock: {
                            ArraySet(CAD_Tess_State.samp, 0, CAD_Store.Read(CAD_Tess_State.zip_ao, 0))
                            ArraySet(CAD_Tess_State.samp, 1, CAD_Store.Read(CAD_Tess_State.zip_ao, 1))
                            ArraySet(CAD_Tess_State.samp, 2, CAD_Store.Read(CAD_Tess_State.zip_ao, 2))
                            ArraySet(CAD_Tess_State.samp, 3, CAD_Store.Read(CAD_Tess_State.zip_best, 0))
                            ArraySet(CAD_Tess_State.samp, 4, CAD_Store.Read(CAD_Tess_State.zip_best, 1))
                            ArraySet(CAD_Tess_State.samp, 5, CAD_Store.Read(CAD_Tess_State.zip_best, 2))
                            CAD_Tess_State.zip_nt = 2
                        }
                    }
                }
            }
            // Open-arc generators (not the zipped rails) → torus meridian.
            IfCondition NotEqual(CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.pack, 8)) ThenBlock: {
                IfCondition NotEqual(CAD_Tess_State.pi, CAD_Tess_State.zip_b) ThenBlock: {
                    IfCondition EqualTo(CAD_Tess_State.use_zip, 2) ThenBlock: {
                        IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Store.Read(CAD_Tess_State.zip_ah, 0), CAD_Store.Read(CAD_Tess_State.zip_ah, 1)) ThenBlock: {
                                ArraySet(CAD_Tess_State.pack, 10, 1)
                            }
                        }
                    }
                }
            }
            // Sample is stored v0→v1. Open arcs follow the coedge origin.
            // CoedgeSwapEdge keeps the old sense, so a rail can be sense 0
            // and still start at v0; reversing on that bit walks it backward
            // and the later rail-B flip crosses the wall. Closed circles
            // (v0==v1) still use sense. Ellipse rails whose origin matches
            // the edge are unchanged.
            IfCondition GreaterEqual(CAD_Tess_State.zip_nt, 2) ThenBlock: {
                IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                    rev = CAD_Tess.CoedgeRev(CAD_Tess_State.zip_j, CAD_Tess_State.zip_ah)
                    IfCondition EqualTo(rev, 1) ThenBlock: {
                        CAD_Tess.ReverseSamp(CAD_Tess_State.zip_nt)
                    }
                }
            }
            IfCondition GreaterEqual(CAD_Tess_State.zip_nt, 2) ThenBlock: {
                CAD_Tess_State.nn = ArrayGet(CAD_Tess_State.pack, 0)
                IfCondition EqualTo(CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.pack, 8)) ThenBlock: {
                    CAD_Tess_State.nring = 0
                    WhileLoop LessThan(CAD_Tess_State.nring, CAD_Tess_State.zip_nt) {
                        ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), ArrayGet(CAD_Tess_State.samp, Multiply(CAD_Tess_State.nring, 3)))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), 1), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.nring, 3), 1)))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), 2), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.nring, 3), 2)))
                        ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.nring, Add(CAD_Tess_State.nn, CAD_Tess_State.nring))
                        CAD_Tess_State.nring = Add(CAD_Tess_State.nring, 1)
                    }
                    CAD_Tess_State.nout = CAD_Tess_State.zip_nt
                    ArraySet(CAD_Tess_State.pack, 0, Add(CAD_Tess_State.nn, CAD_Tess_State.zip_nt))
                }
                IfCondition EqualTo(CAD_Tess_State.pi, CAD_Tess_State.zip_b) ThenBlock: {
                    CAD_Tess_State.nring = 0
                    WhileLoop LessThan(CAD_Tess_State.nring, CAD_Tess_State.zip_nt) {
                        ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), ArrayGet(CAD_Tess_State.samp, Multiply(CAD_Tess_State.nring, 3)))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), 1), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.nring, 3), 1)))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), 2), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.nring, 3), 2)))
                        ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.nring, Add(CAD_Tess_State.nn, CAD_Tess_State.nring))
                        CAD_Tess_State.nring = Add(CAD_Tess_State.nring, 1)
                    }
                    CAD_Tess_State.nh = CAD_Tess_State.zip_nt
                    ArraySet(CAD_Tess_State.pack, 0, Add(CAD_Tess_State.nn, CAD_Tess_State.zip_nt))
                }
            }
            CAD_Tess_State.zip_j = CAD_Store.Read(CAD_Tess_State.zip_j, 2)
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            IfCondition EqualTo(CAD_Tess_State.zip_j, CAD_Tess_State.zip_i) ThenBlock: { CAD_Tess_State.want_h = 1 }
            IfCondition GreaterThan(CAD_Tess_State.pi, 16) ThenBlock: { CAD_Tess_State.want_h = 1 }
        }
        IfCondition LessThan(CAD_Tess_State.nout, 2) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition LessThan(CAD_Tess_State.nh, 2) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition GreaterThan(CAD_Tess_State.nh, CAD_Tess_State.nout) ThenBlock: { CAD_Tess_State.nh = CAD_Tess_State.nout }
        IfCondition GreaterThan(CAD_Tess_State.nout, CAD_Tess_State.nh) ThenBlock: { CAD_Tess_State.nout = CAD_Tess_State.nh }
        // Sagitta of rail A (mid sample vs chord). 0 = colinear = chamfer.
        IfCondition GreaterThan(CAD_Tess_State.nout, 2) ThenBlock: {
            CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.oidx, 0)
            CAD_Tess_State.zip_ah = ArrayGet(CAD_Tess_State.oidx, Subtract(CAD_Tess_State.nout, 1))
            CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.oidx, Divide(CAD_Tess_State.nout, 2))
            CAD_Tess_State.zip_cx = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ah, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ao, 3)))
            CAD_Tess_State.zip_cy = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 1)))
            CAD_Tess_State.zip_nt = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 2)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 2)))
            CAD_Tess_State.zip_best = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ao, 3)))
            CAD_Tess_State.merge_sj = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 1)))
            CAD_Tess_State.merge_bi = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 2)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 2)))
            // |p × c|
            CAD_Tess_State.merge_bj = Float_Sub(Float_Mul(CAD_Tess_State.merge_sj, CAD_Tess_State.zip_nt), Float_Mul(CAD_Tess_State.merge_bi, CAD_Tess_State.zip_cy))
            CAD_Tess_State.merge_best = Float_Sub(Float_Mul(CAD_Tess_State.merge_bi, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_best, CAD_Tess_State.zip_nt))
            CAD_Tess_State.merge_obase = Float_Sub(Float_Mul(CAD_Tess_State.zip_best, CAD_Tess_State.zip_cy), Float_Mul(CAD_Tess_State.merge_sj, CAD_Tess_State.zip_cx))
            CAD_Tess_State.merge_hoff = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Tess_State.merge_bj, CAD_Tess_State.merge_bj), Float_Mul(CAD_Tess_State.merge_best, CAD_Tess_State.merge_best)), Float_Mul(CAD_Tess_State.merge_obase, CAD_Tess_State.merge_obase)))
            CAD_Tess_State.merge_hi = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cy)), Float_Mul(CAD_Tess_State.zip_nt, CAD_Tess_State.zip_nt)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.merge_hi, 0), 0) ThenBlock: {
                CAD_Tess_State.merge_hoff = Float_Div(CAD_Tess_State.merge_hoff, CAD_Tess_State.merge_hi)
            }
            PrintMessage("rail sag_um=")
            PrintNumber(Float_ToInt(Float_Mul(CAD_Tess_State.merge_hoff, 0x408F400000000000)))
            PrintMessage("\n")
            IfCondition GreaterThan(CAD_Tess_State.nout, CAD_Tess_State.ruled_na) ThenBlock: {
                CAD_Tess_State.ruled_na = CAD_Tess_State.nout
            }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Tess_State.merge_hoff, CAD_Tess_State.ruled_sag)), 0) ThenBlock: {
                CAD_Tess_State.ruled_sag = CAD_Tess_State.merge_hoff
            }
        }
        // Opposite edges of a 4-cycle run opposite along the loop.
        // After coedge-sense sampling, reverse rail B so generators
        // join matching profile ends (P_cap↔P_cap, P_ww↔P_ww) instead
        // of the nearer 3D end (which is the other corner's P_cap).
        CAD_Tess_State.pi = 0
        CAD_Tess_State.nn = Subtract(CAD_Tess_State.nh, 1)
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nn) {
            CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.pi)
            ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.nn))
            ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.nn, CAD_Tess_State.zip_ao)
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            CAD_Tess_State.nn = Subtract(CAD_Tess_State.nn, 1)
        }
        CAD_Tess_State.holes_ok = ArrayGet(CAD_Tess_State.pack, 1)
        // Meridian must be a quarter-circle: |A-C| ≈ |B-C| with C at (inner_xy, outer_z).
        IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
            CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.oidx, 0)
            CAD_Tess_State.zip_ah = ArrayGet(CAD_Tess_State.hidx, 0)
            CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ao, 3))
            CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 1))
            CAD_Tess_State.zip_nt = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 2))
            CAD_Tess_State.merge_bj = ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ah, 3))
            CAD_Tess_State.merge_best = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 1))
            CAD_Tess_State.merge_obase = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 2))
            CAD_Tess_State.merge_hi = Float_Add(Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cy))
            CAD_Tess_State.merge_hoff = Float_Add(Float_Mul(CAD_Tess_State.merge_bj, CAD_Tess_State.merge_bj), Float_Mul(CAD_Tess_State.merge_best, CAD_Tess_State.merge_best))
            ArraySet(CAD_Tess_State.pack, 11, 0)
            IfCondition EqualTo(Float_Le(CAD_Tess_State.merge_hi, CAD_Tess_State.merge_hoff), 1) ThenBlock: {
                ArraySet(CAD_Tess_State.pack, 11, 1)
                CAD_Tess_State.zip_best = CAD_Tess_State.zip_cx
                CAD_Tess_State.merge_sj = CAD_Tess_State.zip_cy
                CAD_Tess_State.merge_bi = CAD_Tess_State.merge_obase
            }
            IfCondition EqualTo(Float_Le(CAD_Tess_State.merge_hi, CAD_Tess_State.merge_hoff), 0) ThenBlock: {
                CAD_Tess_State.zip_best = CAD_Tess_State.merge_bj
                CAD_Tess_State.merge_sj = CAD_Tess_State.merge_best
                CAD_Tess_State.merge_bi = CAD_Tess_State.zip_nt
            }
            CAD_Tess_State.merge_hi = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_best), Float_Sub(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_best)), Float_Mul(Float_Sub(CAD_Tess_State.zip_cy, CAD_Tess_State.merge_sj), Float_Sub(CAD_Tess_State.zip_cy, CAD_Tess_State.merge_sj))), Float_Mul(Float_Sub(CAD_Tess_State.zip_nt, CAD_Tess_State.merge_bi), Float_Sub(CAD_Tess_State.zip_nt, CAD_Tess_State.merge_bi))))
            CAD_Tess_State.merge_hoff = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Tess_State.merge_bj, CAD_Tess_State.zip_best), Float_Sub(CAD_Tess_State.merge_bj, CAD_Tess_State.zip_best)), Float_Mul(Float_Sub(CAD_Tess_State.merge_best, CAD_Tess_State.merge_sj), Float_Sub(CAD_Tess_State.merge_best, CAD_Tess_State.merge_sj))), Float_Mul(Float_Sub(CAD_Tess_State.merge_obase, CAD_Tess_State.merge_bi), Float_Sub(CAD_Tess_State.merge_obase, CAD_Tess_State.merge_bi))))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.merge_hi, 0), 1) ThenBlock: { ArraySet(CAD_Tess_State.pack, 10, 0) }
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.merge_hoff, 0), 1) ThenBlock: { ArraySet(CAD_Tess_State.pack, 10, 0) }
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
                CAD_Tess_State.zip_best = Float_Div(CAD_Tess_State.merge_hi, CAD_Tess_State.merge_hoff)
                IfCondition EqualTo(Float_Le(CAD_Tess_State.zip_best, 0x3FECCCC000000000), 1) ThenBlock: { ArraySet(CAD_Tess_State.pack, 10, 0) }
                IfCondition EqualTo(Float_Le(0x3FF199999999999A, CAD_Tess_State.zip_best), 1) ThenBlock: { ArraySet(CAD_Tess_State.pack, 10, 0) }
            }
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
                ArraySet(CAD_Tess_State.pack, 12, CAD_Tess_State.merge_hi)
                PrintMessage("ruled meridian arc\n")
            }
        }
        // 2-point rails = planar wall: one zip along the generators.
        // Curved rails (fillet cylinder): 49×1 sliver tris snap to area2=0
        // in FillTri (integer pixels) → only the two generators draw = chamfer.
        // Subdivide along the ruling so tris have area on screen.
        IfCondition LessThan(CAD_Tess_State.nout, 3) ThenBlock: {
            CAD_Tess_State.pi = 0
            WhileLoop LessThan(CAD_Tess_State.pi, Subtract(CAD_Tess_State.nout, 1)) {
                CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.pi)
                CAD_Tess_State.zip_ah = ArrayGet(CAD_Tess_State.oidx, Add(CAD_Tess_State.pi, 1))
                CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.pi)
                CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.hidx, Add(CAD_Tess_State.pi, 1))
                CAD_Tess_State.nn = CAD_Tess_State.holes_ok
                ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_ah)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_j)
                CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
                ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_j)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_i)
                CAD_Tess_State.holes_ok = Add(CAD_Tess_State.nn, 1)
                CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            }
        }
        IfCondition GreaterThan(CAD_Tess_State.nout, 2) ThenBlock: {
            CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.oidx, 0)
            CAD_Tess_State.zip_ah = ArrayGet(CAD_Tess_State.hidx, 0)
            CAD_Tess_State.zip_cx = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ah, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ao, 3)))
            CAD_Tess_State.zip_cy = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 1)))
            CAD_Tess_State.zip_nt = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 2)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 2)))
            CAD_Tess_State.merge_hi = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cy)), Float_Mul(CAD_Tess_State.zip_nt, CAD_Tess_State.zip_nt)))
            CAD_Tess_State.merge_si = Float_ToInt(Float_Div(CAD_Tess_State.merge_hi, 0x4010000000000000))
            IfCondition LessThan(CAD_Tess_State.merge_si, 4) ThenBlock: { CAD_Tess_State.merge_si = 4 }
            IfCondition GreaterThan(CAD_Tess_State.merge_si, 16) ThenBlock: { CAD_Tess_State.merge_si = 16 }
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
                CAD_Tess_State.merge_si = CAD_Tess.ArcSegCount(ArrayGet(CAD_Tess_State.pack, 12), 0x3FF921FB54442D18)
                IfCondition LessThan(CAD_Tess_State.merge_si, 12) ThenBlock: { CAD_Tess_State.merge_si = 12 }
                IfCondition GreaterThan(CAD_Tess_State.merge_si, 48) ThenBlock: { CAD_Tess_State.merge_si = 48 }
            }
            CAD_Tess_State.merge_bi = ArrayGet(CAD_Tess_State.pack, 0)
            CAD_Tess_State.merge_sj = 0
            WhileLoop LessEqual(CAD_Tess_State.merge_sj, CAD_Tess_State.merge_si) {
                CAD_Tess_State.zip_best = Float_Div(Float_FromInt(CAD_Tess_State.merge_sj), Float_FromInt(CAD_Tess_State.merge_si))
                CAD_Tess_State.merge_hi = CAD_Tess_State.zip_best
                CAD_Tess_State.merge_hoff = CAD_Tess_State.zip_best
                IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
                    CAD_Tess_State.merge_hi = CAD_Geom.Cos(Float_Mul(CAD_Tess_State.zip_best, 0x3FF921FB54442D18))
                    CAD_Tess_State.merge_hoff = CAD_Geom.Sin(Float_Mul(CAD_Tess_State.zip_best, 0x3FF921FB54442D18))
                }
                CAD_Tess_State.pi = 0
                WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nout) {
                    CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.pi)
                    CAD_Tess_State.zip_ah = ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.pi)
                    CAD_Tess_State.nn = CAD_Tess_State.merge_bi
                    CAD_Tess_State.nn = Add(CAD_Tess_State.nn, Multiply(CAD_Tess_State.merge_sj, CAD_Tess_State.nout))
                    CAD_Tess_State.nn = Add(CAD_Tess_State.nn, CAD_Tess_State.pi)
                    CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ao, 3))
                    CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 1))
                    CAD_Tess_State.zip_nt = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 2))
                    CAD_Tess_State.merge_bj = ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ah, 3))
                    CAD_Tess_State.merge_best = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 1))
                    CAD_Tess_State.merge_obase = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 2))
                    IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 0) ThenBlock: {
                        ArraySet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.nn, 3), Float_Add(CAD_Tess_State.zip_cx, Float_Mul(CAD_Tess_State.zip_best, Float_Sub(CAD_Tess_State.merge_bj, CAD_Tess_State.zip_cx))))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), Float_Add(CAD_Tess_State.zip_cy, Float_Mul(CAD_Tess_State.zip_best, Float_Sub(CAD_Tess_State.merge_best, CAD_Tess_State.zip_cy))))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), Float_Add(CAD_Tess_State.zip_nt, Float_Mul(CAD_Tess_State.zip_best, Float_Sub(CAD_Tess_State.merge_obase, CAD_Tess_State.zip_nt))))
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
                        IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 11), 1) ThenBlock: {
                            ArraySet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.nn, 3), Float_Add(CAD_Tess_State.zip_cx, Float_Mul(CAD_Tess_State.merge_hoff, Float_Sub(CAD_Tess_State.merge_bj, CAD_Tess_State.zip_cx))))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), Float_Add(CAD_Tess_State.zip_cy, Float_Mul(CAD_Tess_State.merge_hoff, Float_Sub(CAD_Tess_State.merge_best, CAD_Tess_State.zip_cy))))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), Float_Add(CAD_Tess_State.merge_obase, Float_Mul(CAD_Tess_State.merge_hi, Float_Sub(CAD_Tess_State.zip_nt, CAD_Tess_State.merge_obase))))
                        }
                        IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 11), 0) ThenBlock: {
                            ArraySet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.nn, 3), Float_Add(CAD_Tess_State.merge_bj, Float_Mul(CAD_Tess_State.merge_hi, Float_Sub(CAD_Tess_State.zip_cx, CAD_Tess_State.merge_bj))))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), Float_Add(CAD_Tess_State.merge_best, Float_Mul(CAD_Tess_State.merge_hi, Float_Sub(CAD_Tess_State.zip_cy, CAD_Tess_State.merge_best))))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), Float_Add(CAD_Tess_State.zip_nt, Float_Mul(CAD_Tess_State.merge_hoff, Float_Sub(CAD_Tess_State.merge_obase, CAD_Tess_State.zip_nt))))
                        }
                    }
                    CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
                }
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
            ArraySet(CAD_Tess_State.pack, 0, Add(CAD_Tess_State.merge_bi, Multiply(Add(CAD_Tess_State.merge_si, 1), CAD_Tess_State.nout)))
            CAD_Tess_State.merge_sj = 0
            WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.merge_si) {
                CAD_Tess_State.pi = 0
                WhileLoop LessThan(CAD_Tess_State.pi, Subtract(CAD_Tess_State.nout, 1)) {
                    CAD_Tess_State.zip_ao = Add(CAD_Tess_State.merge_bi, Add(Multiply(CAD_Tess_State.merge_sj, CAD_Tess_State.nout), CAD_Tess_State.pi))
                    CAD_Tess_State.zip_ah = Add(CAD_Tess_State.zip_ao, 1)
                    CAD_Tess_State.zip_i = Add(CAD_Tess_State.zip_ao, CAD_Tess_State.nout)
                    CAD_Tess_State.zip_j = Add(CAD_Tess_State.zip_i, 1)
                    CAD_Tess_State.nn = CAD_Tess_State.holes_ok
                    ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
                    ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_ah)
                    ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_j)
                    CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
                    ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
                    ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_j)
                    ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_i)
                    CAD_Tess_State.holes_ok = Add(CAD_Tess_State.nn, 1)
                    CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
                }
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
        }
        ArraySet(CAD_Tess_State.pack, 1, CAD_Tess_State.holes_ok)
        PrintMessage("ruled nA=")
        PrintNumber(CAD_Tess_State.nout)
        PrintMessage(" nB=")
        PrintNumber(CAD_Tess_State.nh)
        PrintMessage(" nt=")
        PrintNumber(CAD_Tess_State.holes_ok)
        PrintMessage("\n")
        ReturnValue(CAD_Tess_State.holes_ok)
    }
}

// Earclip in (Rθ, z) is a valid fill of the unroll, but a stalled clip
// fans from the notch corner to the far bottom arc. Those diagonals are
// inside the parameter polygon and off the cylinder in XYZ. Split any
// triangle whose centroid leaves the surface, projecting the longest
// edge's midpoint back onto the cylinder, until the chord error is small.
// Only the triangles this face just emitted (t0 .. pack[1]).
Function.CAD_Tess.CylChordRefine {
    Input: surf_h: Integer
    Input: t0: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(surf_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(surf_h, 0), 2) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(surf_h, 1)
        cy = CAD_Store.Read(surf_h, 2)
        cz = CAD_Store.Read(surf_h, 3)
        ax = CAD_Store.Read(surf_h, 10)
        ay = CAD_Store.Read(surf_h, 11)
        az = CAD_Store.Read(surf_h, 12)
        rr = CAD_Store.Read(surf_h, 13)
        al = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ax, ax), Float_Mul(ay, ay)), Float_Mul(az, az)))
        IfCondition EqualTo(CAD_Num.IsZero(al, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(rr, 0), 1) ThenBlock: { ReturnValue(0) }
        ax = Float_Div(ax, al)
        ay = Float_Div(ay, al)
        az = Float_Div(az, al)
        tol = 0x3FC999999999999A
        three = 0x4008000000000000
        t = t0
        nadd = 0
        guard = 0
        WhileLoop LessThan(guard, 8000) {
            nt = ArrayGet(CAD_Tess_State.pack, 1)
            live = 0
            IfCondition LessThan(t, nt) ThenBlock: { live = 1 }
            IfCondition EqualTo(live, 0) ThenBlock: { guard = 8000 }
            IfCondition EqualTo(live, 1) ThenBlock: {
                advanced = 1
                ia = ArrayGet(CAD_Tess_State.i_base, Multiply(t, 3))
                ib = ArrayGet(CAD_Tess_State.i_base, Add(Multiply(t, 3), 1))
                ic = ArrayGet(CAD_Tess_State.i_base, Add(Multiply(t, 3), 2))
                x0 = ArrayGet(CAD_Tess_State.v_base, Multiply(ia, 3))
                y0 = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ia, 3), 1))
                z0 = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ia, 3), 2))
                x1 = ArrayGet(CAD_Tess_State.v_base, Multiply(ib, 3))
                y1 = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ib, 3), 1))
                z1 = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ib, 3), 2))
                x2 = ArrayGet(CAD_Tess_State.v_base, Multiply(ic, 3))
                y2 = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ic, 3), 1))
                z2 = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ic, 3), 2))
                gx = Float_Div(Float_Add(Float_Add(x0, x1), x2), three)
                gy = Float_Div(Float_Add(Float_Add(y0, y1), y2), three)
                gz = Float_Div(Float_Add(Float_Add(z0, z1), z2), three)
                dx = Float_Sub(gx, cx)
                dy = Float_Sub(gy, cy)
                dz = Float_Sub(gz, cz)
                axial = Float_Add(Float_Add(Float_Mul(dx, ax), Float_Mul(dy, ay)), Float_Mul(dz, az))
                rx = Float_Sub(dx, Float_Mul(axial, ax))
                ry = Float_Sub(dy, Float_Mul(axial, ay))
                rz = Float_Sub(dz, Float_Mul(axial, az))
                rad = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(rx, rx), Float_Mul(ry, ry)), Float_Mul(rz, rz)))
                err = Float_Sub(rad, rr)
                IfCondition EqualTo(CAD_Num.IsNeg(err), 1) ThenBlock: { err = Float_Sub(0, err) }
                IfCondition EqualTo(CAD_Num.Le(tol, err), 1) ThenBlock: {
                    IfCondition LessThan(nadd, 2500) ThenBlock: {
                        d01 = Float_Add(Float_Add(Float_Mul(Float_Sub(x1, x0), Float_Sub(x1, x0)), Float_Mul(Float_Sub(y1, y0), Float_Sub(y1, y0))), Float_Mul(Float_Sub(z1, z0), Float_Sub(z1, z0)))
                        d12 = Float_Add(Float_Add(Float_Mul(Float_Sub(x2, x1), Float_Sub(x2, x1)), Float_Mul(Float_Sub(y2, y1), Float_Sub(y2, y1))), Float_Mul(Float_Sub(z2, z1), Float_Sub(z2, z1)))
                        d20 = Float_Add(Float_Add(Float_Mul(Float_Sub(x0, x2), Float_Sub(x0, x2)), Float_Mul(Float_Sub(y0, y2), Float_Sub(y0, y2))), Float_Mul(Float_Sub(z0, z2), Float_Sub(z0, z2)))
                        e = 0
                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d01, d12)), 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d01, d20)), 0) ThenBlock: { e = 0 }
                        }
                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d12, d01)), 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d12, d20)), 0) ThenBlock: { e = 1 }
                        }
                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d20, d01)), 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d20, d12)), 0) ThenBlock: { e = 2 }
                        }
                        mx = Float_Div(Float_Add(x0, x1), 0x4000000000000000)
                        my = Float_Div(Float_Add(y0, y1), 0x4000000000000000)
                        mz = Float_Div(Float_Add(z0, z1), 0x4000000000000000)
                        IfCondition EqualTo(e, 1) ThenBlock: {
                            mx = Float_Div(Float_Add(x1, x2), 0x4000000000000000)
                            my = Float_Div(Float_Add(y1, y2), 0x4000000000000000)
                            mz = Float_Div(Float_Add(z1, z2), 0x4000000000000000)
                        }
                        IfCondition EqualTo(e, 2) ThenBlock: {
                            mx = Float_Div(Float_Add(x2, x0), 0x4000000000000000)
                            my = Float_Div(Float_Add(y2, y0), 0x4000000000000000)
                            mz = Float_Div(Float_Add(z2, z0), 0x4000000000000000)
                        }
                        mdx = Float_Sub(mx, cx)
                        mdy = Float_Sub(my, cy)
                        mdz = Float_Sub(mz, cz)
                        ma = Float_Add(Float_Add(Float_Mul(mdx, ax), Float_Mul(mdy, ay)), Float_Mul(mdz, az))
                        mrx = Float_Sub(mdx, Float_Mul(ma, ax))
                        mry = Float_Sub(mdy, Float_Mul(ma, ay))
                        mrz = Float_Sub(mdz, Float_Mul(ma, az))
                        rl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(mrx, mrx), Float_Mul(mry, mry)), Float_Mul(mrz, mrz)))
                        IfCondition EqualTo(CAD_Num.IsZero(rl, 0), 0) ThenBlock: {
                            sc = Float_Div(rr, rl)
                            nv = ArrayGet(CAD_Tess_State.pack, 0)
                            ArraySet(CAD_Tess_State.v_base, Multiply(nv, 3), Float_Add(cx, Float_Add(Float_Mul(ma, ax), Float_Mul(mrx, sc))))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(nv, 3), 1), Float_Add(cy, Float_Add(Float_Mul(ma, ay), Float_Mul(mry, sc))))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(nv, 3), 2), Float_Add(cz, Float_Add(Float_Mul(ma, az), Float_Mul(mrz, sc))))
                            ArraySet(CAD_Tess_State.pack, 0, Add(nv, 1))
                            IfCondition EqualTo(e, 0) ThenBlock: {
                                ArraySet(CAD_Tess_State.i_base, Multiply(t, 3), ia)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(t, 3), 1), nv)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(t, 3), 2), ic)
                                ArraySet(CAD_Tess_State.i_base, Multiply(nt, 3), nv)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(nt, 3), 1), ib)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(nt, 3), 2), ic)
                            }
                            IfCondition EqualTo(e, 1) ThenBlock: {
                                ArraySet(CAD_Tess_State.i_base, Multiply(t, 3), ia)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(t, 3), 1), ib)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(t, 3), 2), nv)
                                ArraySet(CAD_Tess_State.i_base, Multiply(nt, 3), ia)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(nt, 3), 1), nv)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(nt, 3), 2), ic)
                            }
                            IfCondition EqualTo(e, 2) ThenBlock: {
                                ArraySet(CAD_Tess_State.i_base, Multiply(t, 3), ia)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(t, 3), 1), ib)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(t, 3), 2), nv)
                                ArraySet(CAD_Tess_State.i_base, Multiply(nt, 3), nv)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(nt, 3), 1), ib)
                                ArraySet(CAD_Tess_State.i_base, Add(Multiply(nt, 3), 2), ic)
                            }
                            ArraySet(CAD_Tess_State.pack, 1, Add(nt, 1))
                            nadd = Add(nadd, 1)
                            advanced = 0
                        }
                    }
                }
                IfCondition EqualTo(advanced, 1) ThenBlock: { t = Add(t, 1) }
            }
            guard = Add(guard, 1)
        }
        PrintMessage("cyl refine n=")
        PrintNumber(nadd)
        PrintMessage("\n")
        ReturnValue(nadd)
    }
}

// Lawson flips on triangles [t0, pack[1]). XY of v_base. wind=1 means the
// caller stored CW triangles (EarClipPoly flip flag); they are swapped to
// CCW for the test and swapped back. A stalled ear fans from one vertex.
// Flips turn that fan into a local triangulation of the same polygon.
// Does not add vertices. Coverage is unchanged: a flip stays inside the quad.
Function.CAD_Tess.FlipDelaunay {
    Input: t0: Integer
    Input: v_base: Address
    Input: i_base: Address
    Input: pack_addr: Address
    Input: wind: Integer
    Output: Integer
    Body: {
        nt = ArrayGet(pack_addr, 1)
        IfCondition LessThan(nt, Add(t0, 2)) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(wind, 1) ThenBlock: {
            t = t0
            WhileLoop LessThan(t, nt) {
                b = ArrayGet(i_base, Add(Multiply(t, 3), 1))
                ArraySet(i_base, Add(Multiply(t, 3), 1), ArrayGet(i_base, Add(Multiply(t, 3), 2)))
                ArraySet(i_base, Add(Multiply(t, 3), 2), b)
                t = Add(t, 1)
            }
        }
        nflip = 0
        pass = 0
        progressed = 1
        one = 0x3FF0000000000000
        WhileLoop EqualTo(progressed, 1) {
            IfCondition GreaterThan(pass, 63) ThenBlock: { progressed = 0 }
            IfCondition EqualTo(progressed, 1) ThenBlock: {
                progressed = 0
                t = t0
                WhileLoop LessThan(t, nt) {
                    e = 0
                    did = 0
                    WhileLoop LessThan(e, 3) {
                        IfCondition EqualTo(did, 0) ThenBlock: {
                            e1 = Add(e, 1)
                            IfCondition GreaterEqual(e1, 3) ThenBlock: { e1 = Subtract(e1, 3) }
                            e2 = Add(e, 2)
                            IfCondition GreaterEqual(e2, 3) ThenBlock: { e2 = Subtract(e2, 3) }
                            ia = ArrayGet(i_base, Add(Multiply(t, 3), e))
                            ib = ArrayGet(i_base, Add(Multiply(t, 3), e1))
                            ic = ArrayGet(i_base, Add(Multiply(t, 3), e2))
                            IfCondition NotEqual(ia, ib) ThenBlock: {
                                u = t0
                                found = 0
                                uj = t
                                id = ia
                                WhileLoop LessThan(u, nt) {
                                    IfCondition EqualTo(found, 0) ThenBlock: {
                                        IfCondition NotEqual(u, t) ThenBlock: {
                                            ua = ArrayGet(i_base, Multiply(u, 3))
                                            ub = ArrayGet(i_base, Add(Multiply(u, 3), 1))
                                            uc = ArrayGet(i_base, Add(Multiply(u, 3), 2))
                                            IfCondition EqualTo(ua, ib) ThenBlock: {
                                                IfCondition EqualTo(ub, ia) ThenBlock: {
                                                    id = uc
                                                    uj = u
                                                    found = 1
                                                }
                                            }
                                            IfCondition EqualTo(found, 0) ThenBlock: {
                                                IfCondition EqualTo(ub, ib) ThenBlock: {
                                                    IfCondition EqualTo(uc, ia) ThenBlock: {
                                                        id = ua
                                                        uj = u
                                                        found = 1
                                                    }
                                                }
                                            }
                                            IfCondition EqualTo(found, 0) ThenBlock: {
                                                IfCondition EqualTo(uc, ib) ThenBlock: {
                                                    IfCondition EqualTo(ua, ia) ThenBlock: {
                                                        id = ub
                                                        uj = u
                                                        found = 1
                                                    }
                                                }
                                            }
                                        }
                                        IfCondition EqualTo(found, 0) ThenBlock: { u = Add(u, 1) }
                                        IfCondition EqualTo(found, 1) ThenBlock: { u = nt }
                                    }
                                }
                                IfCondition EqualTo(found, 1) ThenBlock: {
                                    IfCondition NotEqual(id, ia) ThenBlock: {
                                        IfCondition NotEqual(id, ib) ThenBlock: {
                                            IfCondition NotEqual(id, ic) ThenBlock: {
                                                ax = ArrayGet(v_base, Multiply(ia, 3))
                                                ay = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
                                                bx = ArrayGet(v_base, Multiply(ib, 3))
                                                by = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
                                                cx = ArrayGet(v_base, Multiply(ic, 3))
                                                cy = ArrayGet(v_base, Add(Multiply(ic, 3), 1))
                                                dx = ArrayGet(v_base, Multiply(id, 3))
                                                dy = ArrayGet(v_base, Add(Multiply(id, 3), 1))
                                                o0 = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(cy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(cx, ax)))
                                                o1 = Float_Sub(Float_Mul(Float_Sub(cx, bx), Float_Sub(dy, by)), Float_Mul(Float_Sub(cy, by), Float_Sub(dx, bx)))
                                                o2 = Float_Sub(Float_Mul(Float_Sub(ax, cx), Float_Sub(dy, cy)), Float_Mul(Float_Sub(ay, cy), Float_Sub(dx, cx)))
                                                ok = 0
                                                IfCondition EqualTo(CAD_Num.IsNeg(o0), 0) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Num.IsZero(o0, 0), 0) ThenBlock: {
                                                        IfCondition EqualTo(CAD_Num.IsNeg(o1), 0) ThenBlock: {
                                                            IfCondition EqualTo(CAD_Num.IsZero(o1, 0), 0) ThenBlock: {
                                                                IfCondition EqualTo(CAD_Num.IsNeg(o2), 0) ThenBlock: {
                                                                    IfCondition EqualTo(CAD_Num.IsZero(o2, 0), 0) ThenBlock: { ok = 1 }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                IfCondition EqualTo(ok, 1) ThenBlock: {
                                                    ax = Float_Sub(ax, dx)
                                                    ay = Float_Sub(ay, dy)
                                                    bx = Float_Sub(bx, dx)
                                                    by = Float_Sub(by, dy)
                                                    cx = Float_Sub(cx, dx)
                                                    cy = Float_Sub(cy, dy)
                                                    a2 = Float_Add(Float_Mul(ax, ax), Float_Mul(ay, ay))
                                                    b2 = Float_Add(Float_Mul(bx, bx), Float_Mul(by, by))
                                                    c2 = Float_Add(Float_Mul(cx, cx), Float_Mul(cy, cy))
                                                    det = Float_Mul(a2, Float_Sub(Float_Mul(bx, cy), Float_Mul(cx, by)))
                                                    det = Float_Sub(det, Float_Mul(b2, Float_Sub(Float_Mul(ax, cy), Float_Mul(cx, ay))))
                                                    det = Float_Add(det, Float_Mul(c2, Float_Sub(Float_Mul(ax, by), Float_Mul(bx, ay))))
                                                    IfCondition EqualTo(CAD_Num.Le(one, det), 1) ThenBlock: {
                                                        ArraySet(i_base, Multiply(t, 3), ib)
                                                        ArraySet(i_base, Add(Multiply(t, 3), 1), ic)
                                                        ArraySet(i_base, Add(Multiply(t, 3), 2), id)
                                                        ArraySet(i_base, Multiply(uj, 3), ic)
                                                        ArraySet(i_base, Add(Multiply(uj, 3), 1), ia)
                                                        ArraySet(i_base, Add(Multiply(uj, 3), 2), id)
                                                        did = 1
                                                        progressed = 1
                                                        nflip = Add(nflip, 1)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        e = Add(e, 1)
                    }
                    t = Add(t, 1)
                }
            }
            pass = Add(pass, 1)
        }
        nt = ArrayGet(pack_addr, 1)
        IfCondition EqualTo(wind, 1) ThenBlock: {
            t = t0
            WhileLoop LessThan(t, nt) {
                b = ArrayGet(i_base, Add(Multiply(t, 3), 1))
                ArraySet(i_base, Add(Multiply(t, 3), 1), ArrayGet(i_base, Add(Multiply(t, 3), 2)))
                ArraySet(i_base, Add(Multiply(t, 3), 2), b)
                t = Add(t, 1)
            }
        }
        PrintMessage("delaunay n=")
        PrintNumber(nflip)
        PrintMessage("\n")
        ReturnValue(nflip)
    }
}

// x of ring position a is strictly left of b by more than eps (mm).
Function.CAD_Tess.MonoXBefore {
    Input: ring_a: Integer
    Input: ring_b: Integer
    Input: eps: Integer
    Output: Integer
    Body: {
        va = ArrayGet(CAD_Tess_State.oidx, ring_a)
        vb = ArrayGet(CAD_Tess_State.oidx, ring_b)
        xa = ArrayGet(CAD_Tess_State.v_base, Multiply(va, 3))
        xb = ArrayGet(CAD_Tess_State.v_base, Multiply(vb, 3))
        d = Float_Add(Float_Sub(xa, xb), eps)
        ReturnValue(CAD_Num.IsNeg(d))
    }
}

// v_base index for a merged-sequence slot. base_s is the seq offset in clean.
Function.CAD_Tess.MonoVert {
    Input: seq_i: Integer
    Input: base_s: Integer
    Output: Integer
    Body: {
        ring = ArrayGet(CAD_Tess_State.clean, Add(base_s, seq_i))
        v = ArrayGet(CAD_Tess_State.oidx, ring)
        ReturnValue(v)
    }
}

// Track the widest UV edge in x (Rθ). zip_best holds the running max.
Function.CAD_Tess.MonoDx {
    Input: ia: Integer
    Input: ib: Integer
    Output: Integer
    Body: {
        xa = ArrayGet(CAD_Tess_State.v_base, Multiply(ia, 3))
        xb = ArrayGet(CAD_Tess_State.v_base, Multiply(ib, 3))
        d = Float_Sub(xa, xb)
        IfCondition EqualTo(CAD_Num.IsNeg(d), 1) ThenBlock: { d = Float_Sub(0, d) }
        IfCondition EqualTo(CAD_Num.Le(CAD_Tess_State.zip_best, d), 1) ThenBlock: {
            CAD_Tess_State.zip_best = d
        }
        ReturnValue(0)
    }
}

// Append one triangle. Orient to CCW in the unrolled XY, then apply the
// face flip so the winding matches EarClipPoly. Returns 1 if stored.
Function.CAD_Tess.MonoEmit {
    Input: ia: Integer
    Input: ib: Integer
    Input: ic: Integer
    Output: Integer
    Body: {
        o = CAD_Tess.OrientXY(CAD_Tess_State.v_base, ia, ib, ic)
        IfCondition EqualTo(o, 0) ThenBlock: { ReturnValue(0) }
        b = ib
        c = ic
        IfCondition EqualTo(o, Subtract(0, 1)) ThenBlock: {
            b = ic
            c = ib
        }
        IfCondition EqualTo(CAD_Tess_State.flip, 1) ThenBlock: {
            sw = b
            b = c
            c = sw
        }
        nt = ArrayGet(CAD_Tess_State.pack, 1)
        tt = Multiply(nt, 3)
        ArraySet(CAD_Tess_State.i_base, tt, ia)
        ArraySet(CAD_Tess_State.i_base, Add(tt, 1), b)
        ArraySet(CAD_Tess_State.i_base, Add(tt, 2), c)
        ArraySet(CAD_Tess_State.pack, 1, Add(nt, 1))
        CAD_Tess.MonoDx(ia, b)
        CAD_Tess.MonoDx(b, c)
        CAD_Tess.MonoDx(c, ia)
        ReturnValue(1)
    }
}

// Triangulate the CCW ring in oidx as an x-monotone polygon in v_base XY.
// clean holds the lower chain, upper chain, merged sequence, chain id,
// and stack (five blocks of nout). Returns the triangle count, or -1
// when the ring is not x-monotone or the stitch count is wrong. On -1
// the triangle cursor is unchanged.
Function.CAD_Tess.MonoStrip {
    Output: Integer
    Body: {
        n = CAD_Tess_State.nout
        t0 = ArrayGet(CAD_Tess_State.pack, 1)
        IfCondition LessThan(n, 4) ThenBlock: {
            PrintMessage("mono miss\n")
            ReturnValue(Subtract(0, 1))
        }
        IfCondition GreaterThan(n, 3000) ThenBlock: {
            PrintMessage("mono miss\n")
            ReturnValue(Subtract(0, 1))
        }
        IfCondition EqualTo(CAD_Tess_State.clean, 0) ThenBlock: {
            PrintMessage("mono miss\n")
            ReturnValue(Subtract(0, 1))
        }
        eps = 0x3EB0C6F7A0B5ED8D
        L = 0
        R = 0
        i = 1
        WhileLoop LessThan(i, n) {
            left = CAD_Tess.MonoXBefore(i, L, eps)
            IfCondition EqualTo(left, 1) ThenBlock: { L = i }
            IfCondition EqualTo(left, 0) ThenBlock: {
                back = CAD_Tess.MonoXBefore(L, i, eps)
                IfCondition EqualTo(back, 0) ThenBlock: {
                    vi = ArrayGet(CAD_Tess_State.oidx, i)
                    vL = ArrayGet(CAD_Tess_State.oidx, L)
                    yi = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(vi, 3), 1))
                    yL = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(vL, 3), 1))
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(yi, yL)), 1) ThenBlock: { L = i }
                }
            }
            right = CAD_Tess.MonoXBefore(R, i, eps)
            IfCondition EqualTo(right, 1) ThenBlock: { R = i }
            IfCondition EqualTo(right, 0) ThenBlock: {
                backr = CAD_Tess.MonoXBefore(i, R, eps)
                IfCondition EqualTo(backr, 0) ThenBlock: {
                    vi = ArrayGet(CAD_Tess_State.oidx, i)
                    vR = ArrayGet(CAD_Tess_State.oidx, R)
                    yi = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(vi, 3), 1))
                    yR = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(vR, 3), 1))
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(yi, yR)), 1) ThenBlock: { R = i }
                }
            }
            i = Add(i, 1)
        }
        nL = 0
        i = L
        guard = 0
        hit = 0
        WhileLoop LessThan(guard, Add(n, 1)) {
            IfCondition EqualTo(hit, 0) ThenBlock: {
                ArraySet(CAD_Tess_State.clean, nL, i)
                nL = Add(nL, 1)
                IfCondition EqualTo(i, R) ThenBlock: { hit = 1 }
                IfCondition EqualTo(hit, 0) ThenBlock: {
                    i = Add(i, 1)
                    IfCondition GreaterEqual(i, n) ThenBlock: { i = 0 }
                }
            }
            guard = Add(guard, 1)
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            PrintMessage("mono miss lo\n")
            ReturnValue(Subtract(0, 1))
        }
        nU = 0
        i = L
        guard = 0
        hit = 0
        WhileLoop LessThan(guard, Add(n, 1)) {
            IfCondition EqualTo(hit, 0) ThenBlock: {
                ArraySet(CAD_Tess_State.clean, Add(n, nU), i)
                nU = Add(nU, 1)
                IfCondition EqualTo(i, R) ThenBlock: { hit = 1 }
                IfCondition EqualTo(hit, 0) ThenBlock: {
                    i = Subtract(i, 1)
                    IfCondition LessThan(i, 0) ThenBlock: { i = Subtract(n, 1) }
                }
            }
            guard = Add(guard, 1)
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            PrintMessage("mono miss up\n")
            ReturnValue(Subtract(0, 1))
        }
        IfCondition NotEqual(Add(nL, nU), Add(n, 2)) ThenBlock: {
            PrintMessage("mono miss len ")
            PrintNumber(nL)
            PrintMessage(" ")
            PrintNumber(nU)
            PrintMessage(" ")
            PrintNumber(n)
            PrintMessage("\n")
            ReturnValue(Subtract(0, 1))
        }
        k = 0
        bad = 0
        drop = 0
        WhileLoop LessThan(k, Subtract(nL, 1)) {
            a = ArrayGet(CAD_Tess_State.clean, k)
            b = ArrayGet(CAD_Tess_State.clean, Add(k, 1))
            dec = CAD_Tess.MonoXBefore(b, a, eps)
            IfCondition EqualTo(dec, 1) ThenBlock: {
                bad = 1
                va = ArrayGet(CAD_Tess_State.oidx, a)
                vb = ArrayGet(CAD_Tess_State.oidx, b)
                d = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(vb, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(va, 3)))
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d, drop)), 1) ThenBlock: { drop = d }
            }
            k = Add(k, 1)
        }
        k = 0
        WhileLoop LessThan(k, Subtract(nU, 1)) {
            a = ArrayGet(CAD_Tess_State.clean, Add(n, k))
            b = ArrayGet(CAD_Tess_State.clean, Add(n, Add(k, 1)))
            dec = CAD_Tess.MonoXBefore(b, a, eps)
            IfCondition EqualTo(dec, 1) ThenBlock: {
                bad = 2
                va = ArrayGet(CAD_Tess_State.oidx, a)
                vb = ArrayGet(CAD_Tess_State.oidx, b)
                d = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(vb, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(va, 3)))
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d, drop)), 1) ThenBlock: { drop = d }
            }
            k = Add(k, 1)
        }
        IfCondition GreaterThan(bad, 0) ThenBlock: {
            PrintMessage("mono mono ch=")
            PrintNumber(bad)
            PrintMessage(" drop=")
            PrintNumber(Float_ToInt(Float_Mul(drop, 0x408F400000000000)))
            PrintMessage(" nL=")
            PrintNumber(nL)
            PrintMessage(" nU=")
            PrintNumber(nU)
            PrintMessage("\n")
            ReturnValue(Subtract(0, 1))
        }
        baseS = Multiply(n, 2)
        baseC = Multiply(n, 3)
        baseK = Multiply(n, 4)
        ArraySet(CAD_Tess_State.clean, baseS, L)
        ArraySet(CAD_Tess_State.clean, baseC, 0)
        ns = 1
        i = 1
        j = 1
        more = 0
        IfCondition LessThan(i, Subtract(nL, 1)) ThenBlock: { more = 1 }
        IfCondition LessThan(j, Subtract(nU, 1)) ThenBlock: { more = 1 }
        WhileLoop EqualTo(more, 1) {
            take = 0
            IfCondition LessThan(j, Subtract(nU, 1)) ThenBlock: {
                IfCondition GreaterEqual(i, Subtract(nL, 1)) ThenBlock: { take = 1 }
                IfCondition LessThan(i, Subtract(nL, 1)) ThenBlock: {
                    ra = ArrayGet(CAD_Tess_State.clean, i)
                    rb = ArrayGet(CAD_Tess_State.clean, Add(n, j))
                    ubef = CAD_Tess.MonoXBefore(rb, ra, eps)
                    IfCondition EqualTo(ubef, 1) ThenBlock: { take = 1 }
                    IfCondition EqualTo(ubef, 0) ThenBlock: {
                        lbef = CAD_Tess.MonoXBefore(ra, rb, eps)
                        IfCondition EqualTo(lbef, 0) ThenBlock: {
                            va = ArrayGet(CAD_Tess_State.oidx, ra)
                            vb = ArrayGet(CAD_Tess_State.oidx, rb)
                            ya = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(va, 3), 1))
                            yb = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(vb, 3), 1))
                            IfCondition EqualTo(CAD_Num.Le(ya, yb), 0) ThenBlock: { take = 1 }
                        }
                    }
                }
            }
            IfCondition EqualTo(take, 0) ThenBlock: {
                ArraySet(CAD_Tess_State.clean, Add(baseS, ns), ArrayGet(CAD_Tess_State.clean, i))
                ArraySet(CAD_Tess_State.clean, Add(baseC, ns), 0)
                i = Add(i, 1)
            }
            IfCondition EqualTo(take, 1) ThenBlock: {
                ArraySet(CAD_Tess_State.clean, Add(baseS, ns), ArrayGet(CAD_Tess_State.clean, Add(n, j)))
                ArraySet(CAD_Tess_State.clean, Add(baseC, ns), 1)
                j = Add(j, 1)
            }
            ns = Add(ns, 1)
            more = 0
            IfCondition LessThan(i, Subtract(nL, 1)) ThenBlock: { more = 1 }
            IfCondition LessThan(j, Subtract(nU, 1)) ThenBlock: { more = 1 }
        }
        ArraySet(CAD_Tess_State.clean, Add(baseS, ns), R)
        ArraySet(CAD_Tess_State.clean, Add(baseC, ns), 0)
        ns = Add(ns, 1)
        IfCondition NotEqual(ns, n) ThenBlock: {
            PrintMessage("mono miss seq ")
            PrintNumber(ns)
            PrintMessage(" ")
            PrintNumber(n)
            PrintMessage("\n")
            ReturnValue(Subtract(0, 1))
        }
        CAD_Tess_State.zip_best = 0
        ArraySet(CAD_Tess_State.clean, baseK, 0)
        ArraySet(CAD_Tess_State.clean, Add(baseK, 1), 1)
        sp = 2
        k = 2
        lim = Subtract(n, 1)
        WhileLoop LessThan(k, lim) {
            IfCondition LessThan(sp, 2) ThenBlock: { bad = 1 }
            IfCondition EqualTo(bad, 0) ThenBlock: {
                top = ArrayGet(CAD_Tess_State.clean, Add(baseK, Subtract(sp, 1)))
                chK = ArrayGet(CAD_Tess_State.clean, Add(baseC, k))
                chT = ArrayGet(CAD_Tess_State.clean, Add(baseC, top))
                IfCondition NotEqual(chK, chT) ThenBlock: {
                    WhileLoop GreaterThan(sp, 1) {
                        sp = Subtract(sp, 1)
                        a = ArrayGet(CAD_Tess_State.clean, Add(baseK, sp))
                        b = ArrayGet(CAD_Tess_State.clean, Add(baseK, Subtract(sp, 1)))
                        va = CAD_Tess.MonoVert(k, baseS)
                        vb = CAD_Tess.MonoVert(a, baseS)
                        vc = CAD_Tess.MonoVert(b, baseS)
                        CAD_Tess.MonoEmit(va, vb, vc)
                    }
                    ArraySet(CAD_Tess_State.clean, baseK, Subtract(k, 1))
                    ArraySet(CAD_Tess_State.clean, Add(baseK, 1), k)
                    sp = 2
                }
                IfCondition EqualTo(chK, chT) ThenBlock: {
                    sp = Subtract(sp, 1)
                    last = ArrayGet(CAD_Tess_State.clean, Add(baseK, sp))
                    go = 1
                    WhileLoop EqualTo(go, 1) {
                        IfCondition LessThan(sp, 1) ThenBlock: { go = 0 }
                        IfCondition GreaterEqual(sp, 1) ThenBlock: {
                            older = ArrayGet(CAD_Tess_State.clean, Add(baseK, Subtract(sp, 1)))
                            vo = CAD_Tess.MonoVert(older, baseS)
                            vl = CAD_Tess.MonoVert(last, baseS)
                            vk = CAD_Tess.MonoVert(k, baseS)
                            o = CAD_Tess.OrientXY(CAD_Tess_State.v_base, vo, vl, vk)
                            inn = 0
                            IfCondition EqualTo(chK, 0) ThenBlock: {
                                IfCondition EqualTo(o, 1) ThenBlock: { inn = 1 }
                            }
                            IfCondition EqualTo(chK, 1) ThenBlock: {
                                IfCondition EqualTo(o, Subtract(0, 1)) ThenBlock: { inn = 1 }
                            }
                            IfCondition EqualTo(inn, 1) ThenBlock: {
                                CAD_Tess.MonoEmit(vo, vl, vk)
                                sp = Subtract(sp, 1)
                                last = ArrayGet(CAD_Tess_State.clean, Add(baseK, sp))
                            }
                            IfCondition EqualTo(inn, 0) ThenBlock: { go = 0 }
                        }
                    }
                    ArraySet(CAD_Tess_State.clean, Add(baseK, sp), last)
                    sp = Add(sp, 1)
                    ArraySet(CAD_Tess_State.clean, Add(baseK, sp), k)
                    sp = Add(sp, 1)
                }
            }
            k = Add(k, 1)
        }
        IfCondition EqualTo(bad, 1) ThenBlock: {
            ArraySet(CAD_Tess_State.pack, 1, t0)
            PrintMessage("mono miss stack\n")
            ReturnValue(Subtract(0, 1))
        }
        s = 0
        WhileLoop LessThan(s, Subtract(sp, 1)) {
            a = ArrayGet(CAD_Tess_State.clean, Add(baseK, s))
            b = ArrayGet(CAD_Tess_State.clean, Add(baseK, Add(s, 1)))
            va = CAD_Tess.MonoVert(k, baseS)
            vb = CAD_Tess.MonoVert(a, baseS)
            vc = CAD_Tess.MonoVert(b, baseS)
            CAD_Tess.MonoEmit(va, vb, vc)
            s = Add(s, 1)
        }
        got = Subtract(ArrayGet(CAD_Tess_State.pack, 1), t0)
        IfCondition NotEqual(got, Subtract(n, 2)) ThenBlock: {
            ArraySet(CAD_Tess_State.pack, 1, t0)
            PrintMessage("mono miss nt ")
            PrintNumber(got)
            PrintMessage(" ")
            PrintNumber(n)
            PrintMessage("\n")
            ReturnValue(Subtract(0, 1))
        }
        PrintMessage("mono nt=")
        PrintNumber(got)
        PrintMessage(" dx=")
        PrintNumber(Float_ToInt(Float_Mul(CAD_Tess_State.zip_best, 0x408F400000000000)))
        PrintMessage("\n")
        ReturnValue(got)
    }
}

// Cylinder wall (one-Th 5-cycle or two-Th 6-cycle): triangulate the
// unroll (Rθ, z) as an x-monotone strip so each triangle spans one
// sample in θ. EarClipPoly fans from the notch corner, and splitting
// the longest edge keeps that apex. A non-monotone loop falls back to
// EarClipPoly + FlipDelaunay. XYZ is restored after, then CylChordRefine
// splits any chord that still leaves the cylinder. 4-edge walls stay
// on MeshRuledLoop.
Function.CAD_Tess.MeshCylLoopUV {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Tess_State.tess_face, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.tess_face, 0)
        IfCondition EqualTo(CAD_Tess_State.zip_ao, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Tess_State.zip_ao, 0), 2) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition NotEqual(CAD_Tess.FaceBufs(), 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(65536) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.tess_loop = CAD_Store.Read(CAD_Tess_State.tess_face, 1)
        IfCondition EqualTo(CAD_Tess_State.tess_loop, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.want_h = 0
        CAD_Tess_State.nout = CAD_Tess.CollectLoopVerts(CAD_Tess_State.tess_loop, CAD_Tess_State.v_base, CAD_Tess_State.oidx, CAD_Tess_State.pack)
        CAD_Tess.PipeI("pipe cyl-uv nout=", 17, CAD_Tess_State.nout)
        IfCondition LessThan(CAD_Tess_State.nout, 3) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess.RingDedup()
        IfCondition LessThan(CAD_Tess_State.nout, 3) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.tess_face, 0)
        IfCondition EqualTo(CAD_Tess_State.zip_ao, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.zip_cx = CAD_Store.Read(CAD_Tess_State.zip_ao, 1)
        CAD_Tess_State.zip_cy = CAD_Store.Read(CAD_Tess_State.zip_ao, 2)
        CAD_Tess_State.zip_nt = CAD_Store.Read(CAD_Tess_State.zip_ao, 3)
        CAD_Tess_State.merge_si = 0
        CAD_Tess_State.merge_hoff = 0
        WhileLoop LessThan(CAD_Tess_State.merge_si, CAD_Tess_State.nout) {
            CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.merge_si)
            ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.merge_si, CAD_Tess_State.zip_i)
            ArraySet(CAD_Tess_State.samp, Multiply(CAD_Tess_State.merge_si, 3), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)))
            ArraySet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.merge_si, 3), 1), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)))
            ArraySet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.merge_si, 3), 2), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 2)))
            CAD_Tess_State.merge_bj = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)), CAD_Tess_State.zip_cx)
            CAD_Tess_State.merge_best = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)), CAD_Tess_State.zip_cy)
            CAD_Tess_State.merge_obase = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 2)), CAD_Tess_State.zip_nt)
            CAD_Tess_State.merge_hi = Float_Add(Float_Add(Float_Mul(CAD_Tess_State.merge_bj, CAD_Store.Read(CAD_Tess_State.zip_ao, 4)), Float_Mul(CAD_Tess_State.merge_best, CAD_Store.Read(CAD_Tess_State.zip_ao, 5))), Float_Mul(CAD_Tess_State.merge_obase, CAD_Store.Read(CAD_Tess_State.zip_ao, 6)))
            CAD_Tess_State.merge_sj = Float_Add(Float_Add(Float_Mul(CAD_Tess_State.merge_bj, CAD_Store.Read(CAD_Tess_State.zip_ao, 7)), Float_Mul(CAD_Tess_State.merge_best, CAD_Store.Read(CAD_Tess_State.zip_ao, 8))), Float_Mul(CAD_Tess_State.merge_obase, CAD_Store.Read(CAD_Tess_State.zip_ao, 9)))
            CAD_Tess_State.merge_bi = Float_Add(Float_Add(Float_Mul(CAD_Tess_State.merge_bj, CAD_Store.Read(CAD_Tess_State.zip_ao, 10)), Float_Mul(CAD_Tess_State.merge_best, CAD_Store.Read(CAD_Tess_State.zip_ao, 11))), Float_Mul(CAD_Tess_State.merge_obase, CAD_Store.Read(CAD_Tess_State.zip_ao, 12)))
            CAD_Tess_State.zip_best = CAD_Geom.Atan2(CAD_Tess_State.merge_sj, CAD_Tess_State.merge_hi)
            IfCondition GreaterThan(CAD_Tess_State.merge_si, 0) ThenBlock: {
                CAD_Tess_State.merge_bj = Float_Sub(CAD_Tess_State.zip_best, CAD_Tess_State.merge_hoff)
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Tess_State.merge_bj, 0x400921FB54442D18)), 0) ThenBlock: {
                    CAD_Tess_State.zip_best = Float_Sub(CAD_Tess_State.zip_best, 0x401921FB54442D18)
                }
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Add(CAD_Tess_State.merge_bj, 0x400921FB54442D18)), 1) ThenBlock: {
                    CAD_Tess_State.zip_best = Float_Add(CAD_Tess_State.zip_best, 0x401921FB54442D18)
                }
            }
            CAD_Tess_State.merge_hoff = CAD_Tess_State.zip_best
            ArraySet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3), Float_Mul(CAD_Store.Read(CAD_Tess_State.zip_ao, 13), CAD_Tess_State.zip_best))
            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1), CAD_Tess_State.merge_bi)
            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 2), 0)
            CAD_Tess_State.merge_si = Add(CAD_Tess_State.merge_si, 1)
        }
        CAD_Tess.RingOrientCCW()
        CAD_Tess_State.merge_sj = 0
        WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.nout) {
            ArraySet(CAD_Tess_State.bridged, CAD_Tess_State.merge_sj, ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.merge_sj))
            CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
        }
        IfCondition EqualTo(CAD_Tess_State.ep, 0) ThenBlock: { CAD_Tess_State.ep = Allocate(64) }
        t0 = ArrayGet(CAD_Tess_State.pack, 1)
        ArraySet(CAD_Tess_State.ep, 0, CAD_Tess_State.nout)
        ArraySet(CAD_Tess_State.ep, 1, t0)
        ArraySet(CAD_Tess_State.ep, 2, CAD_Tess_State.flip)
        got = CAD_Tess.MonoStrip()
        IfCondition LessThan(got, 0) ThenBlock: {
            ArraySet(CAD_Tess_State.ep, 1, t0)
            CAD_Tess.EarClipPoly(CAD_Tess_State.bridged, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.ep)
            ArraySet(CAD_Tess_State.pack, 1, ArrayGet(CAD_Tess_State.ep, 1))
            CAD_Tess.FlipDelaunay(t0, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.pack, ArrayGet(CAD_Tess_State.ep, 2))
        }
        CAD_Tess_State.merge_si = 0
        WhileLoop LessThan(CAD_Tess_State.merge_si, CAD_Tess_State.nout) {
            CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.merge_si)
            ArraySet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3), ArrayGet(CAD_Tess_State.samp, Multiply(CAD_Tess_State.merge_si, 3)))
            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.merge_si, 3), 1)))
            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 2), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.merge_si, 3), 2)))
            CAD_Tess_State.merge_si = Add(CAD_Tess_State.merge_si, 1)
        }
        sh = CAD_Store.Read(CAD_Tess_State.tess_face, 0)
        CAD_Tess.CylChordRefine(sh, t0)
        CAD_Tess.PipeI("pipe cyl-uv nt=", 15, ArrayGet(CAD_Tess_State.pack, 1))
        ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
    }
}


// Even-odd point-in-polygon. idx[] indexes xyz triples in v_base.
