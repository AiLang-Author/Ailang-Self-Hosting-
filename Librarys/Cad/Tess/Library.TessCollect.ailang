// CAD.Tess — mesh generation + STL (facade). part Collect
// API stays Function.CAD_Tess.*  (facade: LibraryImport.Cad.CAD_Tess)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.StringUtils

Function.CAD_Tess.CollectLoopVerts {
    Input: loop_h: Integer
    Input: v_base: Address
    Input: idx_addr: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        CAD_Tess_State.zip_ah = loop_h
        IfCondition EqualTo(CAD_Tess_State.zip_ah, 0) ThenBlock: { ReturnValue(0) }
        CAD_Tess_State.nn = CAD_Topo.LoopCountCoedges(CAD_Tess_State.zip_ah)
        IfCondition LessThan(CAD_Tess_State.nn, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CAD_Tess_State.nn, 2048) ThenBlock: { ReturnValue(0) }
        CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.pack, 0)
        CAD_Tess_State.zip_i = CAD_Store.Read(CAD_Tess_State.zip_ah, 0)
        CAD_Tess_State.pi = 0
        CAD_Tess_State.zip_nt = 0
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nn) {
            CAD_Tess_State.use_zip = 0
            CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.zip_i, 0)
            IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                CAD_Tess_State.zip_best = CAD_Store.Read(CAD_Tess_State.zip_ao, 2)
                IfCondition NotEqual(CAD_Tess_State.zip_best, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_best, 0), 2) ThenBlock: {
                        CAD_Tess_State.nring = CAD_Tess.ArcSegCount(CAD_Store.Read(CAD_Tess_State.zip_best, 10), CAD_Store.Read(CAD_Tess_State.zip_best, 12))
                        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(65536) }
                        CAD_Tess_State.nring = CAD_Tess.SampleCircleEdge(CAD_Tess_State.zip_ao, CAD_Tess_State.nring, CAD_Tess_State.samp)
                        // SampleCircleEdge is v0→v1 along the stored span.
                        // A reverse coedge walks v1→v0 — same image, opposite order.
                        CAD_Tess.PipeI("pipe collect i=", 15, CAD_Tess_State.pi)
                        CAD_Tess.PipeI(" nring=", 7, CAD_Tess_State.nring)
                        CAD_Tess.PipeI(" sense=", 7, CAD_Store.Read(CAD_Tess_State.zip_i, 6))
                        CAD_Tess.PipeI(" hole=", 6, CAD_Tess_State.want_h)
                        IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_i, 6), 0) ThenBlock: {
                            CAD_Tess.ReverseSamp(CAD_Tess_State.nring)
                            CAD_Tess.Pipe("pipe collect REVSAMP\n", 21)
                        }
                        IfCondition GreaterThan(CAD_Tess_State.nring, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_ao, 0), CAD_Store.Read(CAD_Tess_State.zip_ao, 1)) ThenBlock: {
                                CAD_Tess_State.nring = Subtract(CAD_Tess_State.nring, 1)
                            }
                        }
                        CAD_Tess_State.zip_cx = 0
                        WhileLoop LessThan(CAD_Tess_State.zip_cx, CAD_Tess_State.nring) {
                            ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), ArrayGet(CAD_Tess_State.samp, Multiply(CAD_Tess_State.zip_cx, 3)))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 1), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.zip_cx, 3), 1)))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 2), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.zip_cx, 3), 2)))
                            IfCondition EqualTo(CAD_Tess_State.want_h, 0) ThenBlock: {
                                ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                            }
                            IfCondition EqualTo(CAD_Tess_State.want_h, 1) ThenBlock: {
                                ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                            }
                            CAD_Tess_State.zip_nt = Add(CAD_Tess_State.zip_nt, 1)
                            CAD_Tess_State.zip_cx = Add(CAD_Tess_State.zip_cx, 1)
                        }
                        CAD_Tess_State.use_zip = 1
                    }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_best, 0), 3) ThenBlock: {
                        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(65536) }
                        CAD_Tess_State.nring = CAD_Tess.SampleEllipseByEnds(CAD_Tess_State.zip_ao, 48, CAD_Tess_State.samp)
                        IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_i, 6), 0) ThenBlock: {
                            CAD_Tess.ReverseSamp(CAD_Tess_State.nring)
                        }
                        CAD_Tess_State.zip_cx = 0
                        WhileLoop LessThan(CAD_Tess_State.zip_cx, CAD_Tess_State.nring) {
                            ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), ArrayGet(CAD_Tess_State.samp, Multiply(CAD_Tess_State.zip_cx, 3)))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 1), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.zip_cx, 3), 1)))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 2), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.zip_cx, 3), 2)))
                            IfCondition EqualTo(CAD_Tess_State.want_h, 0) ThenBlock: {
                                ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                            }
                            IfCondition EqualTo(CAD_Tess_State.want_h, 1) ThenBlock: {
                                ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                            }
                            CAD_Tess_State.zip_nt = Add(CAD_Tess_State.zip_nt, 1)
                            CAD_Tess_State.zip_cx = Add(CAD_Tess_State.zip_cx, 1)
                        }
                        IfCondition GreaterThan(CAD_Tess_State.nring, 1) ThenBlock: { CAD_Tess_State.use_zip = 1 }
                    }
                }
            }
            IfCondition EqualTo(CAD_Tess_State.use_zip, 0) ThenBlock: {
                CAD_Tess_State.zip_best = CAD_Store.Read(CAD_Tess_State.zip_i, 5)
                IfCondition NotEqual(CAD_Tess_State.zip_best, 0) ThenBlock: {
                    ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), CAD_Store.Read(CAD_Tess_State.zip_best, 0))
                    ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 1), CAD_Store.Read(CAD_Tess_State.zip_best, 1))
                    ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt), 3), 2), CAD_Store.Read(CAD_Tess_State.zip_best, 2))
                    IfCondition EqualTo(CAD_Tess_State.want_h, 0) ThenBlock: {
                        ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                    }
                    IfCondition EqualTo(CAD_Tess_State.want_h, 1) ThenBlock: {
                        ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.zip_nt, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
                    }
                    CAD_Tess_State.zip_nt = Add(CAD_Tess_State.zip_nt, 1)
                }
            }
            CAD_Tess_State.zip_i = CAD_Store.Read(CAD_Tess_State.zip_i, 2)
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        ArraySet(CAD_Tess_State.pack, 0, Add(CAD_Tess_State.zip_j, CAD_Tess_State.zip_nt))
        ReturnValue(CAD_Tess_State.zip_nt)
    }
}

// Reverse samp[0..n) xyz triples. Used when a loop walks an edge backward.
Function.CAD_Tess.ReverseSamp {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(n) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(n) }
        lo = 0
        hi = Subtract(n, 1)
        WhileLoop LessThan(lo, hi) {
            ox = Multiply(lo, 3)
            hx = Multiply(hi, 3)
            tx = ArrayGet(CAD_Tess_State.samp, ox)
            ty = ArrayGet(CAD_Tess_State.samp, Add(ox, 1))
            tz = ArrayGet(CAD_Tess_State.samp, Add(ox, 2))
            ArraySet(CAD_Tess_State.samp, ox, ArrayGet(CAD_Tess_State.samp, hx))
            ArraySet(CAD_Tess_State.samp, Add(ox, 1), ArrayGet(CAD_Tess_State.samp, Add(hx, 1)))
            ArraySet(CAD_Tess_State.samp, Add(ox, 2), ArrayGet(CAD_Tess_State.samp, Add(hx, 2)))
            ArraySet(CAD_Tess_State.samp, hx, tx)
            ArraySet(CAD_Tess_State.samp, Add(hx, 1), ty)
            ArraySet(CAD_Tess_State.samp, Add(hx, 2), tz)
            lo = Add(lo, 1)
            hi = Subtract(hi, 1)
        }
        ReturnValue(n)
    }
}

// Sample a CIRCLE edge into out_xyz (nseg+1 points, xyz triples).
// If the curve stores a signed span in slot 11 (extrude arc), use that —
// Atan2 wrap to (-π,π] is the short way and flips any arc > 180°.
// Returns nseg+1 or 0.
Function.CAD_Tess.SampleCircleEdge {
    Input: edge_h: Integer
    Input: nseg: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg, 2) ThenBlock: { nseg = 8 }
        CAD_Tess_State.sc_crv = CAD_Store.Read(edge_h, 2)
        IfCondition EqualTo(CAD_Tess_State.sc_crv, 0) ThenBlock: { ReturnValue(0) }
        // slot12 = signed span (survives). slot11 a0 is clobbered to 0.
        // Start at Atan2(edge v0) so we walk the stored span from the real end.
        CAD_Tess_State.sc_span = CAD_Store.Read(CAD_Tess_State.sc_crv, 12)
        CAD_Tess_State.sc_closed = CAD_Store.Read(CAD_Tess_State.sc_crv, 0)
        IfCondition EqualTo(CAD_Tess_State.sc_closed, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.sc_span, 0), 0) ThenBlock: {
                CAD_Tess_State.zip_ao = CAD_Store.Read(edge_h, 0)
                cx = CAD_Store.Read(CAD_Tess_State.sc_crv, 1)
                cy = CAD_Store.Read(CAD_Tess_State.sc_crv, 2)
                cz = CAD_Store.Read(CAD_Tess_State.sc_crv, 3)
                xx = CAD_Store.Read(CAD_Tess_State.sc_crv, 4)
                xy = CAD_Store.Read(CAD_Tess_State.sc_crv, 5)
                xz = CAD_Store.Read(CAD_Tess_State.sc_crv, 6)
                yx = CAD_Store.Read(CAD_Tess_State.sc_crv, 7)
                yy = CAD_Store.Read(CAD_Tess_State.sc_crv, 8)
                yz = CAD_Store.Read(CAD_Tess_State.sc_crv, 9)
                p0x = Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_ao, 0), cx)
                p0y = Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_ao, 1), cy)
                p0z = Float_Sub(CAD_Store.Read(CAD_Tess_State.zip_ao, 2), cz)
                CAD_Tess_State.sc_a0 = CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(p0x, yx), Float_Mul(p0y, yy)), Float_Mul(p0z, yz)), Float_Add(Float_Add(Float_Mul(p0x, xx), Float_Mul(p0y, xy)), Float_Mul(p0z, xz)))
                CAD_Tess.Pipe("pipe sample PATH=PARAM\n", 23)
                cz = CAD_Store.Read(CAD_Tess_State.sc_crv, 3)
                xx = CAD_Store.Read(CAD_Tess_State.sc_crv, 4)
                xy = CAD_Store.Read(CAD_Tess_State.sc_crv, 5)
                xz = CAD_Store.Read(CAD_Tess_State.sc_crv, 6)
                yx = CAD_Store.Read(CAD_Tess_State.sc_crv, 7)
                yy = CAD_Store.Read(CAD_Tess_State.sc_crv, 8)
                yz = CAD_Store.Read(CAD_Tess_State.sc_crv, 9)
                rad = CAD_Store.Read(CAD_Tess_State.sc_crv, 10)
                CAD_Tess_State.sc_closed = nseg
                np = Add(nseg, 1)
                i = 0
                WhileLoop LessThan(i, np) {
                    t = Float_Div(Float_FromInt(i), Float_FromInt(CAD_Tess_State.sc_closed))
                    ang = Float_Add(CAD_Tess_State.sc_a0, Float_Mul(CAD_Tess_State.sc_span, t))
                    c = CAD_Geom.Cos(ang)
                    s = CAD_Geom.Sin(ang)
                    px = Float_Add(cx, Float_Add(Float_Mul(Float_Mul(rad, c), xx), Float_Mul(Float_Mul(rad, s), yx)))
                    py = Float_Add(cy, Float_Add(Float_Mul(Float_Mul(rad, c), xy), Float_Mul(Float_Mul(rad, s), yy)))
                    pz = Float_Add(cz, Float_Add(Float_Mul(Float_Mul(rad, c), xz), Float_Mul(Float_Mul(rad, s), yz)))
                    vo = Multiply(i, 3)
                    ArraySet(CAD_Tess_State.samp, vo, px)
                    ArraySet(CAD_Tess_State.samp, Add(vo, 1), py)
                    ArraySet(CAD_Tess_State.samp, Add(vo, 2), pz)
                    i = Add(i, 1)
                }
                CAD_Tess_State.zip_cx = Divide(CAD_Tess_State.sc_closed, 2)
                CAD_Tess.PipeI(" n=", 3, np)
                CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.zip_i, 0)
                ReturnValue(np)
            }
        }
        CAD_Tess.Pipe("pipe sample PATH=ATAN2\n", 23)
        IfCondition NotEqual(CAD_Tess_State.sc_closed, 2) ThenBlock: {
            CAD_Tess_State.sc_span = 0
        }
        IfCondition EqualTo(CAD_Tess_State.sc_closed, 2) ThenBlock: { CAD_Tess_State.sc_closed = 2 }
        IfCondition NotEqual(CAD_Tess_State.sc_closed, 2) ThenBlock: {
            IfCondition NotEqual(CAD_Tess_State.sc_closed, 3) ThenBlock: { ReturnValue(0) }
        }
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, v1) ThenBlock: { CAD_Tess_State.sc_span = 0 }
        ck = CAD_Tess_State.sc_closed
        CAD_Tess_State.sc_closed = 0
        IfCondition EqualTo(v0, v1) ThenBlock: { CAD_Tess_State.sc_closed = 1 }
        cx = CAD_Store.Read(CAD_Tess_State.sc_crv, 1)
        cy = CAD_Store.Read(CAD_Tess_State.sc_crv, 2)
        cz = CAD_Store.Read(CAD_Tess_State.sc_crv, 3)
        xx = CAD_Store.Read(CAD_Tess_State.sc_crv, 4)
        xy = CAD_Store.Read(CAD_Tess_State.sc_crv, 5)
        xz = CAD_Store.Read(CAD_Tess_State.sc_crv, 6)
        yx = CAD_Store.Read(CAD_Tess_State.sc_crv, 7)
        yy = CAD_Store.Read(CAD_Tess_State.sc_crv, 8)
        yz = CAD_Store.Read(CAD_Tess_State.sc_crv, 9)
        rad = CAD_Store.Read(CAD_Tess_State.sc_crv, 10)
        rmin = rad
        IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.sc_crv, 0), 3) ThenBlock: {
            rmin = CAD_Store.Read(CAD_Tess_State.sc_crv, 11)
        }
        // θ from atan2(dot(P-C,Y), dot(P-C,X))
        p0x = Float_Sub(CAD_Store.Read(v0, 0), cx)
        p0y = Float_Sub(CAD_Store.Read(v0, 1), cy)
        p0z = Float_Sub(CAD_Store.Read(v0, 2), cz)
        p1x = Float_Sub(CAD_Store.Read(v1, 0), cx)
        p1y = Float_Sub(CAD_Store.Read(v1, 1), cy)
        p1z = Float_Sub(CAD_Store.Read(v1, 2), cz)
        d0x = Float_Add(Float_Add(Float_Mul(p0x, xx), Float_Mul(p0y, xy)), Float_Mul(p0z, xz))
        d0y = Float_Add(Float_Add(Float_Mul(p0x, yx), Float_Mul(p0y, yy)), Float_Mul(p0z, yz))
        d1x = Float_Add(Float_Add(Float_Mul(p1x, xx), Float_Mul(p1y, xy)), Float_Mul(p1z, xz))
        d1y = Float_Add(Float_Add(Float_Mul(p1x, yx), Float_Mul(p1y, yy)), Float_Mul(p1z, yz))
        // ellipse parameter uses (dotX/Rmaj, dotY/Rmin)
        IfCondition EqualTo(CAD_Num.IsZero(rad, 0), 0) ThenBlock: {
            d0x = Float_Div(d0x, rad)
            d1x = Float_Div(d1x, rad)
        }
        IfCondition EqualTo(CAD_Num.IsZero(rmin, 0), 0) ThenBlock: {
            d0y = Float_Div(d0y, rmin)
            d1y = Float_Div(d1y, rmin)
        }
        CAD_Tess_State.sc_a0 = CAD_Geom.Atan2(d0y, d0x)
        a1 = CAD_Geom.Atan2(d1y, d1x)
        two_pi = 0x401921FB54442D18
        span = Float_Sub(a1, CAD_Tess_State.sc_a0)
        // Pin (start+stored-end) before IsZero kills a1.
        CAD_Tess_State.sc_crv = Float_Sub(Float_Add(CAD_Tess_State.sc_a0, CAD_Tess_State.sc_span), a1)
        IfCondition EqualTo(CAD_Tess_State.sc_closed, 1) ThenBlock: {
            span = two_pi
        }
        IfCondition EqualTo(CAD_Tess_State.sc_closed, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.sc_span, 0), 0) ThenBlock: {
                // Keep stored span only if it lands on v1 (else another curve's bits).
                ok = 0
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.sc_crv, 0), 1) ThenBlock: { ok = 1 }
                IfCondition EqualTo(CAD_Num.IsZero(Float_Sub(CAD_Tess_State.sc_crv, two_pi), 0), 1) ThenBlock: { ok = 1 }
                IfCondition EqualTo(CAD_Num.IsZero(Float_Add(CAD_Tess_State.sc_crv, two_pi), 0), 1) ThenBlock: { ok = 1 }
                IfCondition EqualTo(ok, 1) ThenBlock: { span = CAD_Tess_State.sc_span }
                IfCondition EqualTo(ok, 0) ThenBlock: { CAD_Tess_State.sc_span = 0 }
            }
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.sc_span, 0), 1) ThenBlock: {
                // no stored span: short-way wrap (legacy edges)
                pi = 0x400921FB54442D18
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(span, Float_Sub(0, pi))), 1) ThenBlock: {
                    span = Float_Add(span, two_pi)
                }
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, span)), 1) ThenBlock: {
                    span = Float_Sub(span, two_pi)
                }
            }
        }
        CAD_Tess_State.sc_span = span
        np = Add(nseg, 1)
        i = 0
        WhileLoop LessThan(i, np) {
            t = Float_Div(Float_FromInt(i), Float_FromInt(nseg))
            ang = Float_Add(CAD_Tess_State.sc_a0, Float_Mul(CAD_Tess_State.sc_span, t))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            // circle: R*(c X + s Y)   ellipse: Rmaj*c X + Rmin*s Y
            px = Float_Add(cx, Float_Add(Float_Mul(Float_Mul(rad, c), xx), Float_Mul(Float_Mul(rmin, s), yx)))
            py = Float_Add(cy, Float_Add(Float_Mul(Float_Mul(rad, c), xy), Float_Mul(Float_Mul(rmin, s), yy)))
            pz = Float_Add(cz, Float_Add(Float_Mul(Float_Mul(rad, c), xz), Float_Mul(Float_Mul(rmin, s), yz)))
            vo = Multiply(i, 3)
            ArraySet(out_xyz, vo, px)
            ArraySet(out_xyz, Add(vo, 1), py)
            ArraySet(out_xyz, Add(vo, 2), pz)
            i = Add(i, 1)
        }
        ReturnValue(np)
    }
}

// Quarter-ellipse from v0 to v1 about the curve origin: P(t)=C+A cos + B sin.
// Digon corners are exactly this (P_ww → P_cap). Avoids Atan2 frame mismatch
// that made SampleCircleEdge return a sliver and MeshCylBlendFace FanNGon
// (flat chamfer, open corner — noendclosure.png).
Function.CAD_Tess.SampleEllipseByEnds {
    Input: edge_h: Integer
    Input: nseg: Integer
    Input: out_xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nseg, 2) ThenBlock: { nseg = 8 }
        crv = CAD_Store.Read(edge_h, 2)
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(crv, 1)
        cy = CAD_Store.Read(crv, 2)
        cz = CAD_Store.Read(crv, 3)
        ax = Float_Sub(CAD_Store.Read(v0, 0), cx)
        ay = Float_Sub(CAD_Store.Read(v0, 1), cy)
        az = Float_Sub(CAD_Store.Read(v0, 2), cz)
        bx = Float_Sub(CAD_Store.Read(v1, 0), cx)
        by = Float_Sub(CAD_Store.Read(v1, 1), cy)
        bz = Float_Sub(CAD_Store.Read(v1, 2), cz)
        half_pi = 0x3FF921FB54442D18
        np = Add(nseg, 1)
        i = 0
        WhileLoop LessThan(i, np) {
            t = Float_Div(Float_FromInt(i), Float_FromInt(nseg))
            ang = Float_Mul(half_pi, t)
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            vo = Multiply(i, 3)
            ArraySet(out_xyz, vo, Float_Add(cx, Float_Add(Float_Mul(ax, c), Float_Mul(bx, s))))
            ArraySet(out_xyz, Add(vo, 1), Float_Add(cy, Float_Add(Float_Mul(ay, c), Float_Mul(by, s))))
            ArraySet(out_xyz, Add(vo, 2), Float_Add(cz, Float_Add(Float_Mul(az, c), Float_Mul(bz, s))))
            i = Add(i, 1)
        }
        ReturnValue(np)
    }
}

// 4-edge loop → zip opposite edges (0 with 2). Line, arc, or circle —
// whatever curve is on the edge. Not a cylinder recipe.
Function.CAD_Tess.MeshRuledLoop {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Tess.FaceBufs(), 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition GreaterThan(ArrayGet(CAD_Tess_State.pack, 0), 60000) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition EqualTo(CAD_Tess_State.tess_loop, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(65536) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.zip_i = CAD_Store.Read(CAD_Tess_State.tess_loop, 0)
        IfCondition EqualTo(CAD_Tess_State.zip_i, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        // 4-cycle is line/arc/line/arc on a fillet cylinder. Zip 0↔2 is the
        // two generators → a flat chamfer. Zip the opposite pair that is
        // actually curved (kind 2/3). Rect walls stay 0↔2 (all lines).
        // Closed circles beat open arcs: a torus face is circle/arc/circle/arc
        // and zipping meridians (last kind-2) is a sliver, not the rim.
        CAD_Tess_State.merge_si = 0
        CAD_Tess_State.zip_b = 2
        CAD_Tess_State.merge_sj = 0
        ArraySet(CAD_Tess_State.pack, 9, 0)
        ArraySet(CAD_Tess_State.pack, 10, 0)
        CAD_Tess_State.zip_j = CAD_Tess_State.zip_i
        CAD_Tess_State.pi = 0
        CAD_Tess_State.want_h = 0
        WhileLoop EqualTo(CAD_Tess_State.want_h, 0) {
            CAD_Tess_State.zip_ah = CAD_Store.Read(CAD_Tess_State.zip_j, 0)
            CAD_Tess_State.use_zip = 0
            IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.zip_ah, 2)
                IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                    CAD_Tess_State.use_zip = CAD_Store.Read(CAD_Tess_State.zip_ao, 0)
                }
            }
            // Zip the curved opposite pair, wherever it sits in the 4-cycle.
            // Only checking pi=1/3 missed line/ell/line/ell vs ell/line/ell/line
            // and left generator-zip (nA=2) = a flat chamfer.
            CAD_Tess_State.zip_best = 0
            IfCondition EqualTo(CAD_Tess_State.use_zip, 2) ThenBlock: {
                IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_ah, 0), CAD_Store.Read(CAD_Tess_State.zip_ah, 1)) ThenBlock: {
                        CAD_Tess_State.zip_best = 1
                    }
                }
            }
            IfCondition EqualTo(CAD_Tess_State.use_zip, 2) ThenBlock: {
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 0) ThenBlock: {
                    CAD_Tess_State.merge_si = CAD_Tess_State.pi
                }
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 1) ThenBlock: {
                    CAD_Tess_State.zip_b = CAD_Tess_State.pi
                }
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
                IfCondition EqualTo(CAD_Tess_State.zip_best, 1) ThenBlock: {
                    ArraySet(CAD_Tess_State.pack, 9, 1)
                }
            }
            IfCondition EqualTo(CAD_Tess_State.use_zip, 3) ThenBlock: {
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 0) ThenBlock: {
                    CAD_Tess_State.merge_si = CAD_Tess_State.pi
                }
                IfCondition EqualTo(CAD_Tess_State.merge_sj, 1) ThenBlock: {
                    CAD_Tess_State.zip_b = CAD_Tess_State.pi
                }
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
            CAD_Tess_State.zip_j = CAD_Store.Read(CAD_Tess_State.zip_j, 2)
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            IfCondition EqualTo(CAD_Tess_State.zip_j, CAD_Tess_State.zip_i) ThenBlock: { CAD_Tess_State.want_h = 1 }
            IfCondition GreaterThan(CAD_Tess_State.pi, 16) ThenBlock: { CAD_Tess_State.want_h = 1 }
        }
        IfCondition LessThan(CAD_Tess_State.merge_sj, 2) ThenBlock: {
            CAD_Tess_State.merge_si = 0
            CAD_Tess_State.zip_b = 2
        }
        ArraySet(CAD_Tess_State.pack, 8, CAD_Tess_State.merge_si)
        CAD_Tess_State.zip_j = CAD_Tess_State.zip_i
        CAD_Tess_State.pi = 0
        CAD_Tess_State.nout = 0
        CAD_Tess_State.nh = 0
        CAD_Tess_State.want_h = 0
        WhileLoop EqualTo(CAD_Tess_State.want_h, 0) {
            CAD_Tess_State.zip_ah = CAD_Store.Read(CAD_Tess_State.zip_j, 0)
            CAD_Tess_State.zip_nt = 0
            CAD_Tess_State.use_zip = 0
            IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.zip_ah, 2)
                IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                    CAD_Tess_State.use_zip = CAD_Store.Read(CAD_Tess_State.zip_ao, 0)
                }
                IfCondition EqualTo(CAD_Tess_State.use_zip, 3) ThenBlock: {
                    CAD_Tess_State.zip_nt = CAD_Tess.SampleEllipseByEnds(CAD_Tess_State.zip_ah, 48, CAD_Tess_State.samp)
                }
                IfCondition EqualTo(CAD_Tess_State.use_zip, 2) ThenBlock: {
                    CAD_Tess_State.nn = 16
                    IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                        CAD_Tess_State.nn = CAD_Tess.ArcSegCount(CAD_Store.Read(CAD_Tess_State.zip_ao, 10), CAD_Store.Read(CAD_Tess_State.zip_ao, 12))
                    }
                    IfCondition EqualTo(CAD_Tess_State.pi, CAD_Tess_State.zip_b) ThenBlock: {
                        IfCondition GreaterThan(CAD_Tess_State.nout, 2) ThenBlock: {
                            CAD_Tess_State.nn = Subtract(CAD_Tess_State.nout, 1)
                        }
                    }
                    CAD_Tess_State.zip_nt = CAD_Tess.SampleCircleEdge(CAD_Tess_State.zip_ah, CAD_Tess_State.nn, CAD_Tess_State.samp)
                }
            }
            IfCondition LessThan(CAD_Tess_State.zip_nt, 2) ThenBlock: {
                IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                    CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.zip_ah, 0)
                    CAD_Tess_State.zip_best = CAD_Store.Read(CAD_Tess_State.zip_ah, 1)
                    IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                        IfCondition NotEqual(CAD_Tess_State.zip_best, 0) ThenBlock: {
                            ArraySet(CAD_Tess_State.samp, 0, CAD_Store.Read(CAD_Tess_State.zip_ao, 0))
                            ArraySet(CAD_Tess_State.samp, 1, CAD_Store.Read(CAD_Tess_State.zip_ao, 1))
                            ArraySet(CAD_Tess_State.samp, 2, CAD_Store.Read(CAD_Tess_State.zip_ao, 2))
                            ArraySet(CAD_Tess_State.samp, 3, CAD_Store.Read(CAD_Tess_State.zip_best, 0))
                            ArraySet(CAD_Tess_State.samp, 4, CAD_Store.Read(CAD_Tess_State.zip_best, 1))
                            ArraySet(CAD_Tess_State.samp, 5, CAD_Store.Read(CAD_Tess_State.zip_best, 2))
                            CAD_Tess_State.zip_nt = 2
                        }
                    }
                }
            }
            // Open-arc generators (not the zipped rails) → torus meridian.
            IfCondition NotEqual(CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.pack, 8)) ThenBlock: {
                IfCondition NotEqual(CAD_Tess_State.pi, CAD_Tess_State.zip_b) ThenBlock: {
                    IfCondition EqualTo(CAD_Tess_State.use_zip, 2) ThenBlock: {
                        IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Store.Read(CAD_Tess_State.zip_ah, 0), CAD_Store.Read(CAD_Tess_State.zip_ah, 1)) ThenBlock: {
                                ArraySet(CAD_Tess_State.pack, 10, 1)
                            }
                        }
                    }
                }
            }
            // Edge sample is v0→v1. Reverse coedges walk the loop the
            // other way — without this the two ellipse rails of a fillet
            // cylinder are both P_ww→P_cap, and the nearer-end zip
            // pairs P_ww of one corner to P_cap of the other (R < 2L/3).
            IfCondition GreaterEqual(CAD_Tess_State.zip_nt, 2) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_j, 6), 0) ThenBlock: {
                    CAD_Tess.ReverseSamp(CAD_Tess_State.zip_nt)
                }
            }
            IfCondition GreaterEqual(CAD_Tess_State.zip_nt, 2) ThenBlock: {
                CAD_Tess_State.nn = ArrayGet(CAD_Tess_State.pack, 0)
                IfCondition EqualTo(CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.pack, 8)) ThenBlock: {
                    CAD_Tess_State.nring = 0
                    WhileLoop LessThan(CAD_Tess_State.nring, CAD_Tess_State.zip_nt) {
                        ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), ArrayGet(CAD_Tess_State.samp, Multiply(CAD_Tess_State.nring, 3)))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), 1), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.nring, 3), 1)))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), 2), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.nring, 3), 2)))
                        ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.nring, Add(CAD_Tess_State.nn, CAD_Tess_State.nring))
                        CAD_Tess_State.nring = Add(CAD_Tess_State.nring, 1)
                    }
                    CAD_Tess_State.nout = CAD_Tess_State.zip_nt
                    ArraySet(CAD_Tess_State.pack, 0, Add(CAD_Tess_State.nn, CAD_Tess_State.zip_nt))
                }
                IfCondition EqualTo(CAD_Tess_State.pi, CAD_Tess_State.zip_b) ThenBlock: {
                    CAD_Tess_State.nring = 0
                    WhileLoop LessThan(CAD_Tess_State.nring, CAD_Tess_State.zip_nt) {
                        ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), ArrayGet(CAD_Tess_State.samp, Multiply(CAD_Tess_State.nring, 3)))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), 1), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.nring, 3), 1)))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.nn, CAD_Tess_State.nring), 3), 2), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.nring, 3), 2)))
                        ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.nring, Add(CAD_Tess_State.nn, CAD_Tess_State.nring))
                        CAD_Tess_State.nring = Add(CAD_Tess_State.nring, 1)
                    }
                    CAD_Tess_State.nh = CAD_Tess_State.zip_nt
                    ArraySet(CAD_Tess_State.pack, 0, Add(CAD_Tess_State.nn, CAD_Tess_State.zip_nt))
                }
            }
            CAD_Tess_State.zip_j = CAD_Store.Read(CAD_Tess_State.zip_j, 2)
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            IfCondition EqualTo(CAD_Tess_State.zip_j, CAD_Tess_State.zip_i) ThenBlock: { CAD_Tess_State.want_h = 1 }
            IfCondition GreaterThan(CAD_Tess_State.pi, 16) ThenBlock: { CAD_Tess_State.want_h = 1 }
        }
        IfCondition LessThan(CAD_Tess_State.nout, 2) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition LessThan(CAD_Tess_State.nh, 2) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition GreaterThan(CAD_Tess_State.nh, CAD_Tess_State.nout) ThenBlock: { CAD_Tess_State.nh = CAD_Tess_State.nout }
        IfCondition GreaterThan(CAD_Tess_State.nout, CAD_Tess_State.nh) ThenBlock: { CAD_Tess_State.nout = CAD_Tess_State.nh }
        // Sagitta of rail A (mid sample vs chord). 0 = colinear = chamfer.
        IfCondition GreaterThan(CAD_Tess_State.nout, 2) ThenBlock: {
            CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.oidx, 0)
            CAD_Tess_State.zip_ah = ArrayGet(CAD_Tess_State.oidx, Subtract(CAD_Tess_State.nout, 1))
            CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.oidx, Divide(CAD_Tess_State.nout, 2))
            CAD_Tess_State.zip_cx = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ah, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ao, 3)))
            CAD_Tess_State.zip_cy = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 1)))
            CAD_Tess_State.zip_nt = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 2)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 2)))
            CAD_Tess_State.zip_best = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ao, 3)))
            CAD_Tess_State.merge_sj = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 1)))
            CAD_Tess_State.merge_bi = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 2)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 2)))
            // |p × c|
            CAD_Tess_State.merge_bj = Float_Sub(Float_Mul(CAD_Tess_State.merge_sj, CAD_Tess_State.zip_nt), Float_Mul(CAD_Tess_State.merge_bi, CAD_Tess_State.zip_cy))
            CAD_Tess_State.merge_best = Float_Sub(Float_Mul(CAD_Tess_State.merge_bi, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_best, CAD_Tess_State.zip_nt))
            CAD_Tess_State.merge_obase = Float_Sub(Float_Mul(CAD_Tess_State.zip_best, CAD_Tess_State.zip_cy), Float_Mul(CAD_Tess_State.merge_sj, CAD_Tess_State.zip_cx))
            CAD_Tess_State.merge_hoff = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Tess_State.merge_bj, CAD_Tess_State.merge_bj), Float_Mul(CAD_Tess_State.merge_best, CAD_Tess_State.merge_best)), Float_Mul(CAD_Tess_State.merge_obase, CAD_Tess_State.merge_obase)))
            CAD_Tess_State.merge_hi = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cy)), Float_Mul(CAD_Tess_State.zip_nt, CAD_Tess_State.zip_nt)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.merge_hi, 0), 0) ThenBlock: {
                CAD_Tess_State.merge_hoff = Float_Div(CAD_Tess_State.merge_hoff, CAD_Tess_State.merge_hi)
            }
            PrintMessage("rail sag_um=")
            PrintNumber(Float_ToInt(Float_Mul(CAD_Tess_State.merge_hoff, 0x408F400000000000)))
            PrintMessage("\n")
            IfCondition GreaterThan(CAD_Tess_State.nout, CAD_Tess_State.ruled_na) ThenBlock: {
                CAD_Tess_State.ruled_na = CAD_Tess_State.nout
            }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Tess_State.merge_hoff, CAD_Tess_State.ruled_sag)), 0) ThenBlock: {
                CAD_Tess_State.ruled_sag = CAD_Tess_State.merge_hoff
            }
        }
        // Opposite edges of a 4-cycle run opposite along the loop.
        // After coedge-sense sampling, reverse rail B so generators
        // join matching profile ends (P_cap↔P_cap, P_ww↔P_ww) instead
        // of the nearer 3D end (which is the other corner's P_cap).
        CAD_Tess_State.pi = 0
        CAD_Tess_State.nn = Subtract(CAD_Tess_State.nh, 1)
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nn) {
            CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.pi)
            ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.nn))
            ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.nn, CAD_Tess_State.zip_ao)
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            CAD_Tess_State.nn = Subtract(CAD_Tess_State.nn, 1)
        }
        CAD_Tess_State.holes_ok = ArrayGet(CAD_Tess_State.pack, 1)
        // Meridian must be a quarter-circle: |A-C| ≈ |B-C| with C at (inner_xy, outer_z).
        IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
            CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.oidx, 0)
            CAD_Tess_State.zip_ah = ArrayGet(CAD_Tess_State.hidx, 0)
            CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ao, 3))
            CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 1))
            CAD_Tess_State.zip_nt = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 2))
            CAD_Tess_State.merge_bj = ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ah, 3))
            CAD_Tess_State.merge_best = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 1))
            CAD_Tess_State.merge_obase = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 2))
            CAD_Tess_State.merge_hi = Float_Add(Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cy))
            CAD_Tess_State.merge_hoff = Float_Add(Float_Mul(CAD_Tess_State.merge_bj, CAD_Tess_State.merge_bj), Float_Mul(CAD_Tess_State.merge_best, CAD_Tess_State.merge_best))
            ArraySet(CAD_Tess_State.pack, 11, 0)
            IfCondition EqualTo(Float_Le(CAD_Tess_State.merge_hi, CAD_Tess_State.merge_hoff), 1) ThenBlock: {
                ArraySet(CAD_Tess_State.pack, 11, 1)
                CAD_Tess_State.zip_best = CAD_Tess_State.zip_cx
                CAD_Tess_State.merge_sj = CAD_Tess_State.zip_cy
                CAD_Tess_State.merge_bi = CAD_Tess_State.merge_obase
            }
            IfCondition EqualTo(Float_Le(CAD_Tess_State.merge_hi, CAD_Tess_State.merge_hoff), 0) ThenBlock: {
                CAD_Tess_State.zip_best = CAD_Tess_State.merge_bj
                CAD_Tess_State.merge_sj = CAD_Tess_State.merge_best
                CAD_Tess_State.merge_bi = CAD_Tess_State.zip_nt
            }
            CAD_Tess_State.merge_hi = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_best), Float_Sub(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_best)), Float_Mul(Float_Sub(CAD_Tess_State.zip_cy, CAD_Tess_State.merge_sj), Float_Sub(CAD_Tess_State.zip_cy, CAD_Tess_State.merge_sj))), Float_Mul(Float_Sub(CAD_Tess_State.zip_nt, CAD_Tess_State.merge_bi), Float_Sub(CAD_Tess_State.zip_nt, CAD_Tess_State.merge_bi))))
            CAD_Tess_State.merge_hoff = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Tess_State.merge_bj, CAD_Tess_State.zip_best), Float_Sub(CAD_Tess_State.merge_bj, CAD_Tess_State.zip_best)), Float_Mul(Float_Sub(CAD_Tess_State.merge_best, CAD_Tess_State.merge_sj), Float_Sub(CAD_Tess_State.merge_best, CAD_Tess_State.merge_sj))), Float_Mul(Float_Sub(CAD_Tess_State.merge_obase, CAD_Tess_State.merge_bi), Float_Sub(CAD_Tess_State.merge_obase, CAD_Tess_State.merge_bi))))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.merge_hi, 0), 1) ThenBlock: { ArraySet(CAD_Tess_State.pack, 10, 0) }
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.merge_hoff, 0), 1) ThenBlock: { ArraySet(CAD_Tess_State.pack, 10, 0) }
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
                CAD_Tess_State.zip_best = Float_Div(CAD_Tess_State.merge_hi, CAD_Tess_State.merge_hoff)
                IfCondition EqualTo(Float_Le(CAD_Tess_State.zip_best, 0x3FECCCC000000000), 1) ThenBlock: { ArraySet(CAD_Tess_State.pack, 10, 0) }
                IfCondition EqualTo(Float_Le(0x3FF199999999999A, CAD_Tess_State.zip_best), 1) ThenBlock: { ArraySet(CAD_Tess_State.pack, 10, 0) }
            }
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
                ArraySet(CAD_Tess_State.pack, 12, CAD_Tess_State.merge_hi)
                PrintMessage("ruled meridian arc\n")
            }
        }
        // 2-point rails = planar wall: one zip along the generators.
        // Curved rails (fillet cylinder): 49×1 sliver tris snap to area2=0
        // in FillTri (integer pixels) → only the two generators draw = chamfer.
        // Subdivide along the ruling so tris have area on screen.
        IfCondition LessThan(CAD_Tess_State.nout, 3) ThenBlock: {
            CAD_Tess_State.pi = 0
            WhileLoop LessThan(CAD_Tess_State.pi, Subtract(CAD_Tess_State.nout, 1)) {
                CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.pi)
                CAD_Tess_State.zip_ah = ArrayGet(CAD_Tess_State.oidx, Add(CAD_Tess_State.pi, 1))
                CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.pi)
                CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.hidx, Add(CAD_Tess_State.pi, 1))
                CAD_Tess_State.nn = CAD_Tess_State.holes_ok
                ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_ah)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_j)
                CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
                ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_j)
                ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_i)
                CAD_Tess_State.holes_ok = Add(CAD_Tess_State.nn, 1)
                CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            }
        }
        IfCondition GreaterThan(CAD_Tess_State.nout, 2) ThenBlock: {
            CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.oidx, 0)
            CAD_Tess_State.zip_ah = ArrayGet(CAD_Tess_State.hidx, 0)
            CAD_Tess_State.zip_cx = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ah, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ao, 3)))
            CAD_Tess_State.zip_cy = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 1)))
            CAD_Tess_State.zip_nt = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 2)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 2)))
            CAD_Tess_State.merge_hi = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cy)), Float_Mul(CAD_Tess_State.zip_nt, CAD_Tess_State.zip_nt)))
            CAD_Tess_State.merge_si = Float_ToInt(Float_Div(CAD_Tess_State.merge_hi, 0x4010000000000000))
            IfCondition LessThan(CAD_Tess_State.merge_si, 4) ThenBlock: { CAD_Tess_State.merge_si = 4 }
            IfCondition GreaterThan(CAD_Tess_State.merge_si, 16) ThenBlock: { CAD_Tess_State.merge_si = 16 }
            IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
                CAD_Tess_State.merge_si = CAD_Tess.ArcSegCount(ArrayGet(CAD_Tess_State.pack, 12), 0x3FF921FB54442D18)
                IfCondition LessThan(CAD_Tess_State.merge_si, 12) ThenBlock: { CAD_Tess_State.merge_si = 12 }
                IfCondition GreaterThan(CAD_Tess_State.merge_si, 48) ThenBlock: { CAD_Tess_State.merge_si = 48 }
            }
            CAD_Tess_State.merge_bi = ArrayGet(CAD_Tess_State.pack, 0)
            CAD_Tess_State.merge_sj = 0
            WhileLoop LessEqual(CAD_Tess_State.merge_sj, CAD_Tess_State.merge_si) {
                CAD_Tess_State.zip_best = Float_Div(Float_FromInt(CAD_Tess_State.merge_sj), Float_FromInt(CAD_Tess_State.merge_si))
                CAD_Tess_State.merge_hi = CAD_Tess_State.zip_best
                CAD_Tess_State.merge_hoff = CAD_Tess_State.zip_best
                IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
                    CAD_Tess_State.merge_hi = CAD_Geom.Cos(Float_Mul(CAD_Tess_State.zip_best, 0x3FF921FB54442D18))
                    CAD_Tess_State.merge_hoff = CAD_Geom.Sin(Float_Mul(CAD_Tess_State.zip_best, 0x3FF921FB54442D18))
                }
                CAD_Tess_State.pi = 0
                WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nout) {
                    CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.pi)
                    CAD_Tess_State.zip_ah = ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.pi)
                    CAD_Tess_State.nn = CAD_Tess_State.merge_bi
                    CAD_Tess_State.nn = Add(CAD_Tess_State.nn, Multiply(CAD_Tess_State.merge_sj, CAD_Tess_State.nout))
                    CAD_Tess_State.nn = Add(CAD_Tess_State.nn, CAD_Tess_State.pi)
                    CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ao, 3))
                    CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 1))
                    CAD_Tess_State.zip_nt = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ao, 3), 2))
                    CAD_Tess_State.merge_bj = ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_ah, 3))
                    CAD_Tess_State.merge_best = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 1))
                    CAD_Tess_State.merge_obase = ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_ah, 3), 2))
                    IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 0) ThenBlock: {
                        ArraySet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.nn, 3), Float_Add(CAD_Tess_State.zip_cx, Float_Mul(CAD_Tess_State.zip_best, Float_Sub(CAD_Tess_State.merge_bj, CAD_Tess_State.zip_cx))))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), Float_Add(CAD_Tess_State.zip_cy, Float_Mul(CAD_Tess_State.zip_best, Float_Sub(CAD_Tess_State.merge_best, CAD_Tess_State.zip_cy))))
                        ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), Float_Add(CAD_Tess_State.zip_nt, Float_Mul(CAD_Tess_State.zip_best, Float_Sub(CAD_Tess_State.merge_obase, CAD_Tess_State.zip_nt))))
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 10), 1) ThenBlock: {
                        IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 11), 1) ThenBlock: {
                            ArraySet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.nn, 3), Float_Add(CAD_Tess_State.zip_cx, Float_Mul(CAD_Tess_State.merge_hoff, Float_Sub(CAD_Tess_State.merge_bj, CAD_Tess_State.zip_cx))))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), Float_Add(CAD_Tess_State.zip_cy, Float_Mul(CAD_Tess_State.merge_hoff, Float_Sub(CAD_Tess_State.merge_best, CAD_Tess_State.zip_cy))))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), Float_Add(CAD_Tess_State.merge_obase, Float_Mul(CAD_Tess_State.merge_hi, Float_Sub(CAD_Tess_State.zip_nt, CAD_Tess_State.merge_obase))))
                        }
                        IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 11), 0) ThenBlock: {
                            ArraySet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.nn, 3), Float_Add(CAD_Tess_State.merge_bj, Float_Mul(CAD_Tess_State.merge_hi, Float_Sub(CAD_Tess_State.zip_cx, CAD_Tess_State.merge_bj))))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), Float_Add(CAD_Tess_State.merge_best, Float_Mul(CAD_Tess_State.merge_hi, Float_Sub(CAD_Tess_State.zip_cy, CAD_Tess_State.merge_best))))
                            ArraySet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), Float_Add(CAD_Tess_State.zip_nt, Float_Mul(CAD_Tess_State.merge_hoff, Float_Sub(CAD_Tess_State.merge_obase, CAD_Tess_State.zip_nt))))
                        }
                    }
                    CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
                }
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
            ArraySet(CAD_Tess_State.pack, 0, Add(CAD_Tess_State.merge_bi, Multiply(Add(CAD_Tess_State.merge_si, 1), CAD_Tess_State.nout)))
            CAD_Tess_State.merge_sj = 0
            WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.merge_si) {
                CAD_Tess_State.pi = 0
                WhileLoop LessThan(CAD_Tess_State.pi, Subtract(CAD_Tess_State.nout, 1)) {
                    CAD_Tess_State.zip_ao = Add(CAD_Tess_State.merge_bi, Add(Multiply(CAD_Tess_State.merge_sj, CAD_Tess_State.nout), CAD_Tess_State.pi))
                    CAD_Tess_State.zip_ah = Add(CAD_Tess_State.zip_ao, 1)
                    CAD_Tess_State.zip_i = Add(CAD_Tess_State.zip_ao, CAD_Tess_State.nout)
                    CAD_Tess_State.zip_j = Add(CAD_Tess_State.zip_i, 1)
                    CAD_Tess_State.nn = CAD_Tess_State.holes_ok
                    ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
                    ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_ah)
                    ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_j)
                    CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
                    ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
                    ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_j)
                    ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_i)
                    CAD_Tess_State.holes_ok = Add(CAD_Tess_State.nn, 1)
                    CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
                }
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
        }
        ArraySet(CAD_Tess_State.pack, 1, CAD_Tess_State.holes_ok)
        PrintMessage("ruled nA=")
        PrintNumber(CAD_Tess_State.nout)
        PrintMessage(" nB=")
        PrintNumber(CAD_Tess_State.nh)
        PrintMessage(" nt=")
        PrintNumber(CAD_Tess_State.holes_ok)
        PrintMessage("\n")
        ReturnValue(CAD_Tess_State.holes_ok)
    }
}


// Even-odd point-in-polygon. idx[] indexes xyz triples in v_base.
