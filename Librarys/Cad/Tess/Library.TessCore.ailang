// CAD.Tess — mesh generation + STL (facade). part Core
// API stays Function.CAD_Tess.*  (facade: LibraryImport.Cad.CAD_Tess)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.StringUtils

FixedPool.CAD_Tess_State {
    "tess_count":     Initialize=0
    "triangle_count": Initialize=0
    "vertex_count":   Initialize=0
    "punch_q":        Initialize=0
    "punch_s":        Initialize=0
    "v_base":         Initialize=0, CanChange=True
    "i_base":         Initialize=0, CanChange=True
    "pack":           Initialize=0, CanChange=True
    "oidx":           Initialize=0, CanChange=True
    "hidx":           Initialize=0, CanChange=True
    "bridged":        Initialize=0, CanChange=True
    "samp":           Initialize=0, CanChange=True
    "clean":          Initialize=0, CanChange=True
    "ep":             Initialize=0, CanChange=True
    "merge_hc":       Initialize=0, CanChange=True
    "nout":           Initialize=0, CanChange=True
    "nh":             Initialize=0, CanChange=True
    "nring":          Initialize=0, CanChange=True
    "inner":          Initialize=0, CanChange=True
    "flip":           Initialize=0, CanChange=True
    "want_h":         Initialize=0, CanChange=True
    "holes_ok":       Initialize=0, CanChange=True
    "use_zip":        Initialize=0, CanChange=True
    "nn":             Initialize=0, CanChange=True
    "pi":             Initialize=0, CanChange=True
    "tess_face":      Initialize=0, CanChange=True
    "tess_sh":        Initialize=0, CanChange=True
    "tess_loop":      Initialize=0, CanChange=True
    "zip_i":          Initialize=0, CanChange=True
    "zip_j":          Initialize=0, CanChange=True
    "zip_ao":         Initialize=0, CanChange=True
    "zip_ah":         Initialize=0, CanChange=True
    "zip_nt":         Initialize=0, CanChange=True
    "zip_best":       Initialize=0, CanChange=True
    "zip_cx":         Initialize=0, CanChange=True
    "zip_cy":         Initialize=0, CanChange=True
    "walk_next":      Initialize=0, CanChange=True
    "walk_i":         Initialize=0, CanChange=True
    "merge_orig":     Initialize=0, CanChange=True
    "merge_norig":    Initialize=0, CanChange=True
    "sc_span":        Initialize=0, CanChange=True
    "sc_a0":          Initialize=0, CanChange=True
    "sc_closed":      Initialize=0, CanChange=True
    "sc_crv":         Initialize=0, CanChange=True
    "next_sh":        Initialize=0, CanChange=True
    "shell_n":        Initialize=0, CanChange=True
}

Function.CAD_Tess.SolidBufs {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Tess_State.v_base, 0) ThenBlock: { CAD_Tess_State.v_base = Allocate(2097152) }
        IfCondition EqualTo(CAD_Tess_State.i_base, 0) ThenBlock: { CAD_Tess_State.i_base = Allocate(1048576) }
        IfCondition EqualTo(CAD_Tess_State.pack, 0) ThenBlock: { CAD_Tess_State.pack = Allocate(256) }
        IfCondition EqualTo(CAD_Tess_State.v_base, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Tess_State.i_base, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.CAD_Tess.FaceBufs {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Tess_State.oidx, 0) ThenBlock: { CAD_Tess_State.oidx = Allocate(16384) }
        IfCondition EqualTo(CAD_Tess_State.hidx, 0) ThenBlock: { CAD_Tess_State.hidx = Allocate(16384) }
        IfCondition EqualTo(CAD_Tess_State.bridged, 0) ThenBlock: { CAD_Tess_State.bridged = Allocate(32768) }
        IfCondition EqualTo(CAD_Tess_State.clean, 0) ThenBlock: { CAD_Tess_State.clean = Allocate(16384) }
        IfCondition EqualTo(CAD_Tess_State.ep, 0) ThenBlock: { CAD_Tess_State.ep = Allocate(64) }
        IfCondition EqualTo(CAD_Tess_State.merge_hc, 0) ThenBlock: { CAD_Tess_State.merge_hc = Allocate(16384) }
        IfCondition EqualTo(CAD_Tess_State.merge_orig, 0) ThenBlock: { CAD_Tess_State.merge_orig = Allocate(16384) }
        IfCondition EqualTo(CAD_Tess_State.oidx, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Tess_State.merge_hc, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.CAD_Tess.WriteStr {
    Input: fd: Integer
    Input: str: Address
    Output: Integer
    Body: {
        len = StringLength(str)
        CAD_Sys.Write(fd, str, len)
        ReturnValue(0)
    }
}

// Append to session.log (PrintMessage is stdout-only and never lands there).
Function.CAD_Tess.Pipe {
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        CAD_Sys.Write(2, msg, n)
        fd = SystemCall(2, "/tmp/cad_app/session.log", 1089, 420)
        IfCondition GreaterThan(fd, 0) ThenBlock: {
            SystemCall(1, fd, msg, n)
            SystemCall(3, fd, 0, 0)
        }
        ReturnValue(0)
    }
}

Function.CAD_Tess.PipeI {
    Input: msg: Address
    Input: nmsg: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        CAD_Tess.Pipe(msg, nmsg)
        buf = Allocate(32)
        out = Allocate(32)
        g = val
        neg = 0
        IfCondition LessThan(g, 0) ThenBlock: {
            neg = 1
            g = Subtract(0, g)
        }
        n = 0
        IfCondition EqualTo(g, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            n = 1
        }
        WhileLoop GreaterThan(g, 0) {
            SetByte(buf, n, Add(48, Modulo(g, 10)))
            n = Add(n, 1)
            g = Divide(g, 10)
        }
        p = 0
        IfCondition EqualTo(neg, 1) ThenBlock: {
            SetByte(out, 0, 45)
            p = 1
        }
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(out, Add(p, i), GetByte(buf, Subtract(Subtract(n, 1), i)))
            i = Add(i, 1)
        }
        SetByte(out, Add(p, n), 10)
        CAD_Tess.Pipe(out, Add(Add(p, n), 1))
        Deallocate(buf, 32)
        Deallocate(out, 32)
        ReturnValue(0)
    }
}

Function.CAD_Tess.PipeF {
    Input: msg: Address
    Input: nmsg: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        CAD_Tess.PipeI(msg, nmsg, Float_ToInt(val))
        CAD_Tess.PipeI(" bits=", 6, val)
        ReturnValue(0)
    }
}

// Segments for a circle of radius r so chordal deviation ≤ defl.
// n ≈ π * sqrt(r / (2δ)) from δ = r(1-cos(π/n)) ≈ r·(π/n)²/2
// Hard fixed-n is wrong at large diameter — derive from (r, defl), then apply
// a visual floor (angular step ≤ ~4° → n≥90) so small parts don't look 1978.
// Clamped [n_min, 256]. Cap hit → need analytic surface tess later.
Function.CAD_Tess.CircleSegCount {
    Input: radius_r: Integer
    Input: defl_r: Integer
    Output: Integer
    Body: {
        // Full-circle floor. Quarter-arcs scale this in ArcSegCount —
        // 90-on-every-arc made a 4-fillet plate ~400-gon and froze earclip.
        n_min = 24
        r = BitwiseAnd(radius_r, 0x7FFFFFFFFFFFFFFF)
        IfCondition EqualTo(CAD_Num.IsZero(r, 0), 1) ThenBlock: {
            ReturnValue(n_min)
        }
        d = BitwiseAnd(defl_r, 0x7FFFFFFFFFFFFFFF)
        // default display deflection 0.02 mm if unset (0.1mm only gave ~23 segs at r=10)
        IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: {
            d = 0x3F947AE147AE147B
        }
        // if defl >= r, still keep visual floor
        IfCondition EqualTo(Float_Le(r, d), 1) ThenBlock: {
            ReturnValue(n_min)
        }
        // n = pi * sqrt(r / (2*d))
        two_d = Float_Mul(0x4000000000000000, d)
        ratio = Float_Div(r, two_d)
        root = CAD_Num.Sqrt(ratio)
        pi_r = 0x400921FB54442D18
        nf = Float_Mul(pi_r, root)
        nf = Float_Add(nf, 0x3FEFFF2E48E8A7E4)
        n = Float_ToInt(nf)
        IfCondition LessThan(n, n_min) ThenBlock: { n = n_min }
        IfCondition GreaterThan(n, 96) ThenBlock: { n = 96 }
        ReturnValue(n)
    }
}

// Segments for an arc of signed span (slot12). Same deflection as a
// full circle, times |span|/(2π). Floor 8 so a fillet still looks round.
Function.CAD_Tess.ArcSegCount {
    Input: radius_r: Integer
    Input: span_r: Integer
    Output: Integer
    Body: {
        CAD_Tess_State.sc_closed = CAD_Tess.CircleSegCount(radius_r, 0)
        IfCondition EqualTo(CAD_Num.IsZero(span_r, 0), 1) ThenBlock: { ReturnValue(CAD_Tess_State.sc_closed) }
        asp = span_r
        IfCondition EqualTo(CAD_Num.IsNeg(asp), 1) ThenBlock: { asp = Float_Sub(0, asp) }
        two_pi = 0x401921FB54442D18
        IfCondition EqualTo(Float_Le(asp, two_pi), 0) ThenBlock: { ReturnValue(CAD_Tess_State.sc_closed) }
        nf = Float_Mul(Float_FromInt(CAD_Tess_State.sc_closed), Float_Div(asp, two_pi))
        n2 = Float_ToInt(Float_Add(nf, 0x3FE0000000000000))
        IfCondition LessThan(n2, 8) ThenBlock: { n2 = 8 }
        IfCondition GreaterThan(n2, CAD_Tess_State.sc_closed) ThenBlock: { n2 = CAD_Tess_State.sc_closed }
        ReturnValue(n2)
    }
}

// Write double with 3 decimal places (cylinder chords need sub-mm digits)
Function.CAD_Tess.WriteFloat {
    Input: fd: Integer
    Input: val_r: Integer
    Output: Integer
    Body: {
        // sign
        signb = BitwiseAnd(val_r, 0x8000000000000000)
        IfCondition NotEqual(signb, 0) ThenBlock: {
            CAD_Tess.WriteStr(fd, "-")
            val_r = BitwiseAnd(val_r, 0x7FFFFFFFFFFFFFFF)
        }
        // integer part
        iv = Float_ToInt(val_r)
        s = NumberToString(iv)
        CAD_Tess.WriteStr(fd, s)
        CAD_Tess.WriteStr(fd, ".")
        // fractional * 1000, rounded
        whole_r = Float_FromInt(iv)
        frac_r = Float_Sub(val_r, whole_r)
        scaled = Float_Mul(frac_r, 0x408F400000000000)
        // 0x408F400000000000 = 1000.0
        half = 0x3FE0000000000000
        scaled = Float_Add(scaled, half)
        milli = Float_ToInt(scaled)
        IfCondition GreaterThan(milli, 999) ThenBlock: {
            milli = 999
        }
        IfCondition LessThan(milli, 0) ThenBlock: {
            milli = 0
        }
        // zero-pad to 3 digits
        IfCondition LessThan(milli, 100) ThenBlock: {
            CAD_Tess.WriteStr(fd, "0")
        }
        IfCondition LessThan(milli, 10) ThenBlock: {
            CAD_Tess.WriteStr(fd, "0")
        }
        sm = NumberToString(milli)
        CAD_Tess.WriteStr(fd, sm)
        ReturnValue(0)
    }
}

Function.CAD_Tess.WriteFacet {
    Input: fd: Integer
    Input: nx: Integer
    Input: ny: Integer
    Input: nz: Integer
    Input: tri_addr: Address
    Output: Integer
    Body: {
        // tri_addr: 9 doubles v0x v0y v0z v1x… v2z
        CAD_Tess.WriteStr(fd, "  facet normal ")
        CAD_Tess.WriteFloat(fd, nx)
        CAD_Tess.WriteStr(fd, " ")
        CAD_Tess.WriteFloat(fd, ny)
        CAD_Tess.WriteStr(fd, " ")
        CAD_Tess.WriteFloat(fd, nz)
        CAD_Tess.WriteStr(fd, "\n    outer loop\n")
        k = 0
        WhileLoop LessThan(k, 3) {
            CAD_Tess.WriteStr(fd, "      vertex ")
            o = Multiply(k, 3)
            CAD_Tess.WriteFloat(fd, ArrayGet(tri_addr, o))
            CAD_Tess.WriteStr(fd, " ")
            CAD_Tess.WriteFloat(fd, ArrayGet(tri_addr, Add(o, 1)))
            CAD_Tess.WriteStr(fd, " ")
            CAD_Tess.WriteFloat(fd, ArrayGet(tri_addr, Add(o, 2)))
            CAD_Tess.WriteStr(fd, "\n")
            k = Add(k, 1)
        }
        CAD_Tess.WriteStr(fd, "    endloop\n  endfacet\n")
        ReturnValue(0)
    }
}

// Emit 2 triangles for a 4-coedge loop into mesh buffers
// Returns updated tri count
Function.CAD_Tess.FanQuad {
    Input: loop_h: Integer
    Input: v_base: Address
    Input: i_base: Address
    Input: vert_count: Integer
    Input: tri_count: Integer
    Output: Integer
    Body: {
        // Collect 4 vertex handles from loop
        head = CAD_Store.Read(loop_h, 0)
        ce = head
        // Store up to 4 origin vertex handles then resolve points
        // We append unique verts by always pushing 4 corners (may duplicate verts — OK for STL)
        // Map: get origin from coedge slot 5, read point into next free verts
        base_v = vert_count
        k = 0
        WhileLoop LessThan(k, 4) {
            origin = CAD_Store.Read(ce, 5)
            px = CAD_Store.Read(origin, 0)
            py = CAD_Store.Read(origin, 1)
            pz = CAD_Store.Read(origin, 2)
            vo = Multiply(Add(base_v, k), 3)
            ArraySet(v_base, vo, px)
            ArraySet(v_base, Add(vo, 1), py)
            ArraySet(v_base, Add(vo, 2), pz)
            ce = CAD_Store.Read(ce, 2)
            k = Add(k, 1)
        }
        // tris: (0,1,2) (0,2,3) relative to base_v
        t0 = Multiply(tri_count, 3)
        ArraySet(i_base, t0, base_v)
        ArraySet(i_base, Add(t0, 1), Add(base_v, 1))
        ArraySet(i_base, Add(t0, 2), Add(base_v, 2))
        t1 = Multiply(Add(tri_count, 1), 3)
        ArraySet(i_base, t1, base_v)
        ArraySet(i_base, Add(t1, 1), Add(base_v, 2))
        ArraySet(i_base, Add(t1, 2), Add(base_v, 3))
        ReturnValue(Add(tri_count, 2))
    }
}

// Triangle-fan any n-gon loop (n>=3). Returns new tri_count.
// Also updates verts starting at vert_count (caller advances verts by n).
Function.CAD_Tess.FanNGon {
    Input: loop_h: Integer
    Input: n: Integer
    Input: v_base: Address
    Input: i_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        // pack_addr[0]=vert_count in, [1]=tri_count in; out return tri_count
        vert_count = ArrayGet(pack_addr, 0)
        tri_count = ArrayGet(pack_addr, 1)
        head = CAD_Store.Read(loop_h, 0)
        ce = head
        k = 0
        base_v = vert_count
        WhileLoop LessThan(k, n) {
            origin = CAD_Store.Read(ce, 5)
            vo = Multiply(Add(base_v, k), 3)
            ArraySet(v_base, vo, CAD_Store.Read(origin, 0))
            ArraySet(v_base, Add(vo, 1), CAD_Store.Read(origin, 1))
            ArraySet(v_base, Add(vo, 2), CAD_Store.Read(origin, 2))
            ce = CAD_Store.Read(ce, 2)
            k = Add(k, 1)
        }
        // fan: (0, i, i+1) for i=1..n-2
        i = 1
        WhileLoop LessThan(i, Subtract(n, 1)) {
            t0 = Multiply(tri_count, 3)
            ArraySet(i_base, t0, base_v)
            ArraySet(i_base, Add(t0, 1), Add(base_v, i))
            ArraySet(i_base, Add(t0, 2), Add(base_v, Add(i, 1)))
            tri_count = Add(tri_count, 1)
            i = Add(i, 1)
        }
        ArraySet(pack_addr, 0, Add(vert_count, n))
        ArraySet(pack_addr, 1, tri_count)
        ReturnValue(tri_count)
    }
}

// Fan a loop, tessellating circle/ellipse coedges (fillet end walls).
// Straight FanNGon on those walls used a CHORD and left the cylinder open.
Function.CAD_Tess.MeshLoopFanTess {
    Input: loop_h: Integer
    Input: v_base: Address
    Input: i_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(loop_h, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.pi = ArrayGet(CAD_Tess_State.pack, 0)
        CAD_Tess_State.nn = 0
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { CAD_Tess_State.samp = Allocate(8192) }
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.zip_i = CAD_Store.Read(loop_h, 0)
        IfCondition EqualTo(CAD_Tess_State.zip_i, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.zip_j = CAD_Tess_State.zip_i
        CAD_Tess_State.nring = 0
        CAD_Tess_State.want_h = 0
        WhileLoop EqualTo(CAD_Tess_State.want_h, 0) {
            CAD_Tess_State.zip_ao = CAD_Store.Read(CAD_Tess_State.zip_j, 5)
            IfCondition NotEqual(CAD_Tess_State.zip_ao, 0) ThenBlock: {
                IfCondition LessThan(CAD_Tess_State.nn, 2048) ThenBlock: {
                    CAD_Tess_State.zip_best = CAD_Store.Read(CAD_Tess_State.zip_ao, 0)
                    CAD_Tess_State.zip_cx = CAD_Store.Read(CAD_Tess_State.zip_ao, 1)
                    CAD_Tess_State.zip_cy = CAD_Store.Read(CAD_Tess_State.zip_ao, 2)
                    ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.pi, CAD_Tess_State.nn), 3), CAD_Tess_State.zip_best)
                    ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.pi, CAD_Tess_State.nn), 3), 1), CAD_Tess_State.zip_cx)
                    ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.pi, CAD_Tess_State.nn), 3), 2), CAD_Tess_State.zip_cy)
                    CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
                }
            }
            CAD_Tess_State.zip_ah = CAD_Store.Read(CAD_Tess_State.zip_j, 0)
            IfCondition NotEqual(CAD_Tess_State.zip_ah, 0) ThenBlock: {
                CAD_Tess_State.zip_nt = CAD_Store.Read(CAD_Tess_State.zip_ah, 2)
                IfCondition NotEqual(CAD_Tess_State.zip_nt, 0) ThenBlock: {
                    CAD_Tess_State.use_zip = CAD_Store.Read(CAD_Tess_State.zip_nt, 0)
                    CAD_Tess_State.zip_nt = 0
                    IfCondition EqualTo(CAD_Tess_State.use_zip, 3) ThenBlock: {
                        CAD_Tess_State.zip_nt = CAD_Tess.SampleEllipseByEnds(CAD_Tess_State.zip_ah, 12, CAD_Tess_State.samp)
                    }
                    IfCondition EqualTo(CAD_Tess_State.use_zip, 2) ThenBlock: {
                        CAD_Tess_State.zip_nt = CAD_Tess.SampleCircleEdge(CAD_Tess_State.zip_ah, 12, CAD_Tess_State.samp)
                    }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Tess_State.zip_j, 6), 0) ThenBlock: {
                        CAD_Tess.ReverseSamp(CAD_Tess_State.zip_nt)
                    }
                    IfCondition GreaterThan(CAD_Tess_State.zip_nt, 2) ThenBlock: {
                        CAD_Tess_State.zip_ao = 1
                        WhileLoop LessThan(CAD_Tess_State.zip_ao, Subtract(CAD_Tess_State.zip_nt, 1)) {
                            IfCondition LessThan(CAD_Tess_State.nn, 2048) ThenBlock: {
                                ArraySet(CAD_Tess_State.v_base, Multiply(Add(CAD_Tess_State.pi, CAD_Tess_State.nn), 3), ArrayGet(CAD_Tess_State.samp, Multiply(CAD_Tess_State.zip_ao, 3)))
                                ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.pi, CAD_Tess_State.nn), 3), 1), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.zip_ao, 3), 1)))
                                ArraySet(CAD_Tess_State.v_base, Add(Multiply(Add(CAD_Tess_State.pi, CAD_Tess_State.nn), 3), 2), ArrayGet(CAD_Tess_State.samp, Add(Multiply(CAD_Tess_State.zip_ao, 3), 2)))
                                CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
                            }
                            CAD_Tess_State.zip_ao = Add(CAD_Tess_State.zip_ao, 1)
                        }
                    }
                }
            }
            CAD_Tess_State.zip_j = CAD_Store.Read(CAD_Tess_State.zip_j, 2)
            CAD_Tess_State.nring = Add(CAD_Tess_State.nring, 1)
            IfCondition EqualTo(CAD_Tess_State.zip_j, CAD_Tess_State.zip_i) ThenBlock: { CAD_Tess_State.want_h = 1 }
            IfCondition GreaterThan(CAD_Tess_State.nring, 4096) ThenBlock: { CAD_Tess_State.want_h = 1 }
        }
        IfCondition LessThan(CAD_Tess_State.nn, 3) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.holes_ok = ArrayGet(CAD_Tess_State.pack, 1)
        CAD_Tess_State.use_zip = 1
        WhileLoop LessThan(CAD_Tess_State.use_zip, Subtract(CAD_Tess_State.nn, 1)) {
            ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.holes_ok, 3), CAD_Tess_State.pi)
            ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.holes_ok, 3), 1), Add(CAD_Tess_State.pi, CAD_Tess_State.use_zip))
            ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.holes_ok, 3), 2), Add(CAD_Tess_State.pi, Add(CAD_Tess_State.use_zip, 1)))
            CAD_Tess_State.holes_ok = Add(CAD_Tess_State.holes_ok, 1)
            CAD_Tess_State.use_zip = Add(CAD_Tess_State.use_zip, 1)
        }
        ArraySet(CAD_Tess_State.pack, 0, Add(CAD_Tess_State.pi, CAD_Tess_State.nn))
        ArraySet(CAD_Tess_State.pack, 1, CAD_Tess_State.holes_ok)
        IfCondition LessThan(CAD_Tess_State.nn, 8) ThenBlock: {
            PrintMessage("fan nn=")
            PrintNumber(CAD_Tess_State.nn)
            PrintMessage(" nt=")
            PrintNumber(CAD_Tess_State.holes_ok)
            PrintMessage("\n")
        }
        ReturnValue(CAD_Tess_State.holes_ok)
    }
}

// MeshSolid: walk shell faces; 3/4-gons or general n-gon fan
// out_mesh: [n_verts, n_tris, v_base, i_base] filled
// Mesh cylinder by surface sample. origin_addr: [ox,oy,oz] base center.
