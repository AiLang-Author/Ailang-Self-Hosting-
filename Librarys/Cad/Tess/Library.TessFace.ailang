// CAD.Tess — mesh generation + STL (facade). part Face
// API stays Function.CAD_Tess.*  (facade: LibraryImport.Cad.CAD_Tess)
//
// Planar caps: sample loops → visible keyhole each hole → one EarClipPoly.
// Walls stay analytic (ruled 4-edge or fan). This file does not invent
// topology and does not switch on shape kind.

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.StringUtils

Function.CAD_Tess.ValidInnerLoop {
    Input: outer: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(outer, 0) ThenBlock: { ReturnValue(0) }
        inner = CAD_Store.Read(outer, 2)
        IfCondition EqualTo(inner, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(inner, outer) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Store.Read(inner, 0), 0) ThenBlock: { ReturnValue(0) }
        ni = CAD_Topo.LoopCountCoedges(inner)
        IfCondition LessThan(ni, 3) ThenBlock: {
            hd0 = CAD_Store.Read(inner, 0)
            IfCondition EqualTo(hd0, 0) ThenBlock: { ReturnValue(0) }
            ed0 = CAD_Store.Read(hd0, 0)
            IfCondition EqualTo(ed0, 0) ThenBlock: { ReturnValue(0) }
            cr0 = CAD_Store.Read(ed0, 2)
            IfCondition EqualTo(cr0, 0) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(CAD_Store.Read(cr0, 0), 2) ThenBlock: { ReturnValue(0) }
        }
        IfCondition GreaterThan(ni, 2048) ThenBlock: { ReturnValue(0) }
        ReturnValue(inner)
    }
}

// |nz| of the unit Newell normal from every live loop vert.
// First-three-verts cross is ~0 on a tessellated circle (near-collinear).
Function.CAD_Tess.LoopNewellAbsNz {
    Input: loop_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(loop_h, 0) ThenBlock: { ReturnValue(0) }
        head = CAD_Store.Read(loop_h, 0)
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(0) }
        nx = 0
        ny = 0
        nz = 0
        nv = 0
        ce = head
        guard = 0
        WhileLoop LessThan(guard, 4096) {
            ov = CAD_Store.Read(ce, 5)
            nxt = CAD_Store.Read(ce, 2)
            IfCondition NotEqual(ov, 0) ThenBlock: {
                IfCondition NotEqual(nxt, 0) ThenBlock: {
                    ov2 = CAD_Store.Read(nxt, 5)
                    IfCondition NotEqual(ov2, 0) ThenBlock: {
                        x0 = CAD_Store.Read(ov, 0)
                        y0 = CAD_Store.Read(ov, 1)
                        z0 = CAD_Store.Read(ov, 2)
                        x1 = CAD_Store.Read(ov2, 0)
                        y1 = CAD_Store.Read(ov2, 1)
                        z1 = CAD_Store.Read(ov2, 2)
                        nx = Float_Add(nx, Float_Mul(Float_Sub(y0, y1), Float_Add(z0, z1)))
                        ny = Float_Add(ny, Float_Mul(Float_Sub(z0, z1), Float_Add(x0, x1)))
                        nz = Float_Add(nz, Float_Mul(Float_Sub(x0, x1), Float_Add(y0, y1)))
                        nv = Add(nv, 1)
                    }
                }
            }
            IfCondition EqualTo(nxt, 0) ThenBlock: { guard = 4096 }
            IfCondition NotEqual(nxt, 0) ThenBlock: { ce = nxt }
            guard = Add(guard, 1)
            IfCondition EqualTo(ce, head) ThenBlock: { guard = 4096 }
        }
        IfCondition LessThan(nv, 3) ThenBlock: { ReturnValue(0) }
        nz_s = nz
        gl2 = Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz_s, nz_s))
        gl = CAD_Num.Sqrt(gl2)
        IfCondition EqualTo(CAD_Num.IsZero(gl, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsNeg(nz_s), 1) ThenBlock: { nz_s = Float_Sub(0, nz_s) }
        ReturnValue(Float_Div(nz_s, gl))
    }
}

// Collapse coincident samples on oidx[0..nout). Numerical, not a shape test.
Function.CAD_Tess.RingDedup {
    Output: Integer
    Body: {
        CAD_Tess_State.zip_best = 0x3C9CD2B297D889BC
        CAD_Tess_State.use_zip = 1
        WhileLoop EqualTo(CAD_Tess_State.use_zip, 1) {
            CAD_Tess_State.use_zip = 0
            IfCondition GreaterThan(CAD_Tess_State.nout, 3) ThenBlock: {
                CAD_Tess_State.pi = 0
                WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nout) {
                    CAD_Tess_State.nn = Add(CAD_Tess_State.pi, 1)
                    IfCondition EqualTo(CAD_Tess_State.nn, CAD_Tess_State.nout) ThenBlock: { CAD_Tess_State.nn = 0 }
                    CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.pi)
                    CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.nn)
                    CAD_Tess_State.zip_cx = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_j, 3)))
                    CAD_Tess_State.zip_cy = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_j, 3), 1)))
                    CAD_Tess_State.zip_cx = Float_Add(Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cy))
                    IfCondition EqualTo(Float_Le(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_best), 1) ThenBlock: {
                        CAD_Tess_State.zip_ao = CAD_Tess_State.nn
                        IfCondition EqualTo(CAD_Tess_State.nn, 0) ThenBlock: { CAD_Tess_State.zip_ao = CAD_Tess_State.pi }
                        CAD_Tess_State.zip_ah = CAD_Tess_State.zip_ao
                        WhileLoop LessThan(CAD_Tess_State.zip_ah, Subtract(CAD_Tess_State.nout, 1)) {
                            ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.zip_ah, ArrayGet(CAD_Tess_State.oidx, Add(CAD_Tess_State.zip_ah, 1)))
                            CAD_Tess_State.zip_ah = Add(CAD_Tess_State.zip_ah, 1)
                        }
                        CAD_Tess_State.nout = Subtract(CAD_Tess_State.nout, 1)
                        CAD_Tess_State.use_zip = 1
                        CAD_Tess_State.pi = CAD_Tess_State.nout
                    }
                    CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
                }
            }
        }
        ReturnValue(CAD_Tess_State.nout)
    }
}

// Shoelace oidx. Reverse to CCW. flip=1 if the stored winding was CW.
Function.CAD_Tess.RingOrientCCW {
    Output: Integer
    Body: {
        CAD_Tess_State.zip_best = 0
        CAD_Tess_State.pi = 0
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nout) {
            CAD_Tess_State.nn = Add(CAD_Tess_State.pi, 1)
            IfCondition EqualTo(CAD_Tess_State.nn, CAD_Tess_State.nout) ThenBlock: { CAD_Tess_State.nn = 0 }
            CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.pi)
            CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.nn)
            CAD_Tess_State.zip_best = Float_Add(CAD_Tess_State.zip_best, Float_Sub(Float_Mul(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_j, 3), 1))), Float_Mul(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_j, 3)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)))))
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.zip_best, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Tess_State.flip = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Tess_State.zip_best), 1) ThenBlock: {
            CAD_Tess_State.pi = 0
            CAD_Tess_State.nn = Subtract(CAD_Tess_State.nout, 1)
            WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nn) {
                CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.pi)
                ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.nn))
                ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.nn, CAD_Tess_State.zip_i)
                CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
                CAD_Tess_State.nn = Subtract(CAD_Tess_State.nn, 1)
            }
            CAD_Tess_State.flip = 1
        }
        ReturnValue(1)
    }
}

// Same as RingDedup on the hole index buffer.
Function.CAD_Tess.HoleDedup {
    Output: Integer
    Body: {
        CAD_Tess_State.zip_best = 0x3C9CD2B297D889BC
        CAD_Tess_State.use_zip = 1
        WhileLoop EqualTo(CAD_Tess_State.use_zip, 1) {
            CAD_Tess_State.use_zip = 0
            IfCondition GreaterThan(CAD_Tess_State.nh, 3) ThenBlock: {
                CAD_Tess_State.pi = 0
                WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nh) {
                    CAD_Tess_State.nn = Add(CAD_Tess_State.pi, 1)
                    IfCondition EqualTo(CAD_Tess_State.nn, CAD_Tess_State.nh) ThenBlock: { CAD_Tess_State.nn = 0 }
                    CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.pi)
                    CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.nn)
                    CAD_Tess_State.zip_cx = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_j, 3)))
                    CAD_Tess_State.zip_cy = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_j, 3), 1)))
                    CAD_Tess_State.zip_cx = Float_Add(Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cy))
                    IfCondition EqualTo(Float_Le(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_best), 1) ThenBlock: {
                        CAD_Tess_State.zip_ao = CAD_Tess_State.nn
                        IfCondition EqualTo(CAD_Tess_State.nn, 0) ThenBlock: { CAD_Tess_State.zip_ao = CAD_Tess_State.pi }
                        CAD_Tess_State.zip_ah = CAD_Tess_State.zip_ao
                        WhileLoop LessThan(CAD_Tess_State.zip_ah, Subtract(CAD_Tess_State.nh, 1)) {
                            ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.zip_ah, ArrayGet(CAD_Tess_State.hidx, Add(CAD_Tess_State.zip_ah, 1)))
                            CAD_Tess_State.zip_ah = Add(CAD_Tess_State.zip_ah, 1)
                        }
                        CAD_Tess_State.nh = Subtract(CAD_Tess_State.nh, 1)
                        CAD_Tess_State.use_zip = 1
                        CAD_Tess_State.pi = CAD_Tess_State.nh
                    }
                    CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
                }
            }
        }
        ReturnValue(CAD_Tess_State.nh)
    }
}

// Planar face = sampled outer + holes → one simple ring → EarClipPoly.
// A hole joins on any spoke that does not cross the current ring or any
// still-unmerged hole and whose midpoint sits in the face. Shortest of
// those is a quality pick, not a geometric assumption.
Function.CAD_Tess.MeshFaceLoopsXY {
    Input: face_h: Integer
    Input: v_base: Address
    Input: i_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        CAD_Tess_State.tess_loop = CAD_Store.Read(face_h, 1)
        IfCondition EqualTo(CAD_Tess_State.tess_loop, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        IfCondition NotEqual(CAD_Tess.FaceBufs(), 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.want_h = 0
        CAD_Tess_State.nout = CAD_Tess.CollectLoopVerts(CAD_Tess_State.tess_loop, CAD_Tess_State.v_base, CAD_Tess_State.oidx, CAD_Tess_State.pack)
        IfCondition LessThan(CAD_Tess_State.nout, 3) ThenBlock: {
            ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
        }
        CAD_Tess.RingDedup()
        CAD_Tess_State.merge_obase = ArrayGet(CAD_Tess_State.pack, 0)
        IfCondition LessThan(CAD_Tess_State.nout, 3) ThenBlock: {
            ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
        }
        IfCondition EqualTo(CAD_Tess.RingOrientCCW(), 0) ThenBlock: {
            ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
        }
        CAD_Tess_State.inner = CAD_Tess.ValidInnerLoop(CAD_Tess_State.tess_loop)
        CAD_Tess_State.holes_ok = 0
        CAD_Tess_State.merge_norig = 0
        CAD_Tess_State.merge_si = 0
        WhileLoop NotEqual(CAD_Tess_State.inner, 0) {
            IfCondition GreaterThan(CAD_Tess_State.merge_si, 64) ThenBlock: { CAD_Tess_State.inner = 0 }
            IfCondition NotEqual(CAD_Tess_State.inner, 0) ThenBlock: {
                CAD_Tess_State.want_h = 1
                CAD_Tess_State.nh = CAD_Tess.CollectLoopVerts(CAD_Tess_State.inner, CAD_Tess_State.v_base, CAD_Tess_State.hidx, CAD_Tess_State.pack)
                IfCondition GreaterEqual(CAD_Tess_State.nh, 3) ThenBlock: {
                    CAD_Tess.HoleDedup()
                    CAD_Tess_State.merge_sj = 0
                    WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.nh) {
                        ArraySet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.merge_norig, CAD_Tess_State.merge_sj), ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.merge_sj))
                        CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
                    }
                    ArraySet(CAD_Tess_State.clean, Add(CAD_Tess_State.holes_ok, 1), CAD_Tess_State.nh)
                    CAD_Tess_State.merge_norig = Add(CAD_Tess_State.merge_norig, CAD_Tess_State.nh)
                    CAD_Tess_State.holes_ok = Add(CAD_Tess_State.holes_ok, 1)
                    CAD_Tess.PipeI("pipe hole-pack n=", 16, CAD_Tess_State.nh)
                }
                CAD_Tess_State.inner = CAD_Store.Read(CAD_Tess_State.inner, 2)
            }
            CAD_Tess_State.merge_si = Add(CAD_Tess_State.merge_si, 1)
        }
        ArraySet(CAD_Tess_State.clean, 0, CAD_Tess_State.holes_ok)
        CAD_Tess_State.merge_hoff = 0
        CAD_Tess_State.merge_hi = 0
        WhileLoop LessThan(CAD_Tess_State.merge_hi, CAD_Tess_State.holes_ok) {
            CAD_Tess_State.nh = ArrayGet(CAD_Tess_State.clean, Add(CAD_Tess_State.merge_hi, 1))
            CAD_Tess_State.merge_sj = 0
            WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.nh) {
                ArraySet(CAD_Tess_State.hidx, CAD_Tess_State.merge_sj, ArrayGet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.merge_hoff, CAD_Tess_State.merge_sj)))
                CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
            }
            CAD_Tess_State.nring = CAD_Tess.MergeHoleRing(CAD_Tess_State.v_base, CAD_Tess_State.oidx, CAD_Tess_State.hidx, CAD_Tess_State.bridged, CAD_Tess_State.ep)
            IfCondition GreaterEqual(CAD_Tess_State.nring, 3) ThenBlock: {
                CAD_Tess_State.nout = CAD_Tess_State.nring
                CAD_Tess_State.merge_sj = 0
                WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.nout) {
                    ArraySet(CAD_Tess_State.oidx, CAD_Tess_State.merge_sj, ArrayGet(CAD_Tess_State.bridged, CAD_Tess_State.merge_sj))
                    CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
                }
                CAD_Tess.PipeI("pipe keyhole ok n=", 18, CAD_Tess_State.nout)
            }
            IfCondition LessThan(CAD_Tess_State.nring, 3) ThenBlock: {
                CAD_Tess.PipeI("pipe keyhole FAIL h=", 20, CAD_Tess_State.merge_hi)
            }
            CAD_Tess_State.merge_hoff = Add(CAD_Tess_State.merge_hoff, CAD_Tess_State.nh)
            CAD_Tess_State.merge_hi = Add(CAD_Tess_State.merge_hi, 1)
        }
        IfCondition EqualTo(CAD_Tess_State.ep, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Tess_State.pack, 1)) }
        CAD_Tess_State.merge_sj = 0
        WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.nout) {
            ArraySet(CAD_Tess_State.bridged, CAD_Tess_State.merge_sj, ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.merge_sj))
            CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
        }
        ArraySet(CAD_Tess_State.ep, 0, CAD_Tess_State.nout)
        ArraySet(CAD_Tess_State.ep, 1, ArrayGet(CAD_Tess_State.pack, 1))
        ArraySet(CAD_Tess_State.ep, 2, CAD_Tess_State.flip)
        CAD_Tess.EarClipPoly(CAD_Tess_State.bridged, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.ep)
        ArraySet(CAD_Tess_State.pack, 1, ArrayGet(CAD_Tess_State.ep, 1))
        CAD_Tess.PipeI("pipe face PATH=KEYHOLE nholes=", 30, CAD_Tess_State.holes_ok)
        CAD_Tess.PipeI(" nt=", 4, ArrayGet(CAD_Tess_State.pack, 1))
        ReturnValue(ArrayGet(CAD_Tess_State.pack, 1))
    }
}

// MeshSolid: walk every face. No kind/surface recipe.
// Hole or planar loop → MeshFaceLoopsXY. 4-edge wall → opposite-rail zip.
// Else sample-and-fan.
Function.CAD_Tess.MeshSolid {
    Input: solid_handle: Integer
    Input: deflection_r: Integer
    Input: out_mesh_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: {
            ReturnValue(-1)
        }
        CAD_Tess_State.defl_r = deflection_r
        // No shell: Class A revolution pack (MakeLatheRevolution). Not a shape recipe —
        // there is no B-Rep to walk.
        CAD_Tess_State.tess_sh = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Tess_State.tess_sh, 0) ThenBlock: {
            CAD_Tess_State.zip_ao = CAD_Store.Read(solid_handle, 1)
            IfCondition EqualTo(CAD_Tess_State.zip_ao, 0) ThenBlock: { ReturnValue(-1) }
            IfCondition LessThan(CAD_Store.Read(CAD_Tess_State.zip_ao, 0), 3) ThenBlock: { ReturnValue(-1) }
            ReturnValue(CAD_Tess.MeshLatheAnalytic(CAD_Tess_State.zip_ao, deflection_r, out_mesh_addr))
        }
        IfCondition NotEqual(CAD_Tess.SolidBufs(), 0) ThenBlock: { ReturnValue(-1) }
        ArraySet(CAD_Tess_State.pack, 0, 0)
        ArraySet(CAD_Tess_State.pack, 1, 0)
        CAD_Tess_State.ruled_na = 0
        CAD_Tess_State.ruled_sag = 0
        CAD_Tess_State.shell_n = 0
        WhileLoop NotEqual(CAD_Tess_State.tess_sh, 0) {
            CAD_Tess_State.next_sh = CAD_Store.Read(CAD_Tess_State.tess_sh, 2)
            CAD_Tess_State.tess_face = CAD_Store.Read(CAD_Tess_State.tess_sh, 0)
            CAD_Tess_State.walk_i = 0
            CAD_Tess_State.zip_ao = 0
            WhileLoop NotEqual(CAD_Tess_State.tess_face, 0) {
                CAD_Tess_State.tess_loop = CAD_Store.Read(CAD_Tess_State.tess_face, 1)
                IfCondition NotEqual(CAD_Tess_State.tess_loop, 0) ThenBlock: {
                    CAD_Tess_State.nring = CAD_Topo.LoopCountCoedges(CAD_Tess_State.tess_loop)
                    CAD_Tess_State.inner = CAD_Tess.ValidInnerLoop(CAD_Tess_State.tess_loop)
                    CAD_Tess_State.use_zip = 0
                    IfCondition NotEqual(CAD_Tess_State.inner, 0) ThenBlock: { CAD_Tess_State.use_zip = 1 }
                    IfCondition LessThan(CAD_Tess_State.nring, 3) ThenBlock: { CAD_Tess_State.use_zip = 1 }
                    ArraySet(CAD_Tess_State.pack, 6, CAD_Tess_State.nring)
                    ArraySet(CAD_Tess_State.pack, 7, CAD_Tess_State.use_zip)
                    CAD_Tess_State.walk_next = CAD_Store.Read(CAD_Tess_State.tess_face, 3)
                    IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 7), 1) ThenBlock: {
                        CAD_Tess.MeshFaceLoopsXY(CAD_Tess_State.tess_face, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.pack)
                    }
                    IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 7), 0) ThenBlock: {
                        IfCondition EqualTo(ArrayGet(CAD_Tess_State.pack, 6), 4) ThenBlock: {
                            CAD_Tess.MeshRuledLoop()
                        }
                        IfCondition NotEqual(ArrayGet(CAD_Tess_State.pack, 6), 4) ThenBlock: {
                            CAD_Tess.MeshLoopFanTess(CAD_Tess_State.tess_loop, CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.pack)
                        }
                    }
                }
                CAD_Tess_State.tess_face = CAD_Tess_State.walk_next
                CAD_Tess_State.walk_i = Add(CAD_Tess_State.walk_i, 1)
                IfCondition GreaterThan(CAD_Tess_State.walk_i, 4096) ThenBlock: {
                    CAD_Tess_State.tess_face = 0
                }
            }
            CAD_Tess_State.tess_sh = CAD_Tess_State.next_sh
            CAD_Tess_State.shell_n = Add(CAD_Tess_State.shell_n, 1)
            IfCondition GreaterThan(CAD_Tess_State.shell_n, 64) ThenBlock: { CAD_Tess_State.tess_sh = 0 }
        }
        pack = CAD_Tess_State.pack
        v_base = CAD_Tess_State.v_base
        i_base = CAD_Tess_State.i_base
        vert_count = ArrayGet(pack, 0)
        tri_count = ArrayGet(pack, 1)
        // Each face copied its own verts (CollectLoopVerts / cyl sample).
        // Digon 4-rim fillet then showed open seams: coincident xyz, different
        // indices. Weld by position so shared edges exist twice.
        IfCondition GreaterThan(vert_count, 0) ThenBlock: {
            CAD_Tess.WeldMesh(CAD_Tess_State.v_base, CAD_Tess_State.i_base, CAD_Tess_State.pack)
            pack = CAD_Tess_State.pack
            vert_count = ArrayGet(pack, 0)
            tri_count = ArrayGet(pack, 1)
        }
        ArraySet(out_mesh_addr, 0, vert_count)
        ArraySet(out_mesh_addr, 1, tri_count)
        ArraySet(out_mesh_addr, 2, CAD_Tess_State.v_base)
        ArraySet(out_mesh_addr, 3, CAD_Tess_State.i_base)
        ArraySet(out_mesh_addr, 4, 2097152)
        ArraySet(out_mesh_addr, 5, 1048576)
        CAD_Tess_State.tess_count = Add(CAD_Tess_State.tess_count, 1)
        CAD_Tess_State.triangle_count = tri_count
        CAD_Tess_State.vertex_count = vert_count
        ReturnValue(tri_count)
    }
}

// Collapse verts with the same xyz so adjacent faces share indices.
// pack: [nv, nt] in/out. Leaves unused verts in the slab.
Function.CAD_Tess.WeldMesh {
    Input: v_base: Address
    Input: i_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        nv = ArrayGet(pack_addr, 0)
        nt = ArrayGet(pack_addr, 1)
        IfCondition LessThan(nv, 2) ThenBlock: { ReturnValue(nt) }
        IfCondition GreaterThan(nv, 8192) ThenBlock: { ReturnValue(nt) }
        // (0.02 mm)² — tighter than tess step, looser than noise
        eps2 = 0x3F147AE147AE147B
        map = Allocate(65536)
        i = 0
        WhileLoop LessThan(i, nv) {
            ArraySet(map, i, i)
            xi = ArrayGet(v_base, Multiply(i, 3))
            yi = ArrayGet(v_base, Add(Multiply(i, 3), 1))
            zi = ArrayGet(v_base, Add(Multiply(i, 3), 2))
            j = 0
            WhileLoop LessThan(j, i) {
                IfCondition EqualTo(ArrayGet(map, j), j) ThenBlock: {
                    dx = Float_Sub(xi, ArrayGet(v_base, Multiply(j, 3)))
                    dy = Float_Sub(yi, ArrayGet(v_base, Add(Multiply(j, 3), 1)))
                    dz = Float_Sub(zi, ArrayGet(v_base, Add(Multiply(j, 3), 2)))
                    d2 = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d2, eps2)), 1) ThenBlock: {
                        ArraySet(map, i, j)
                        j = i
                    }
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        t = 0
        w = 0
        WhileLoop LessThan(t, nt) {
            a = ArrayGet(map, ArrayGet(i_base, Multiply(t, 3)))
            b = ArrayGet(map, ArrayGet(i_base, Add(Multiply(t, 3), 1)))
            c = ArrayGet(map, ArrayGet(i_base, Add(Multiply(t, 3), 2)))
            ok = 1
            IfCondition EqualTo(a, b) ThenBlock: { ok = 0 }
            IfCondition EqualTo(b, c) ThenBlock: { ok = 0 }
            IfCondition EqualTo(c, a) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                ArraySet(i_base, Multiply(w, 3), a)
                ArraySet(i_base, Add(Multiply(w, 3), 1), b)
                ArraySet(i_base, Add(Multiply(w, 3), 2), c)
                w = Add(w, 1)
            }
            t = Add(t, 1)
        }
        ArraySet(pack_addr, 1, w)
        nw = 0
        i = 0
        WhileLoop LessThan(i, nv) {
            IfCondition NotEqual(ArrayGet(map, i), i) ThenBlock: { nw = Add(nw, 1) }
            i = Add(i, 1)
        }
        ArraySet(pack_addr, 2, nw)
        IfCondition LessThan(nv, 400) ThenBlock: {
            PrintMessage("weld n=")
            PrintNumber(nw)
            PrintMessage(" nt=")
            PrintNumber(w)
            PrintMessage("\n")
        }
        Deallocate(map, 65536)
        ReturnValue(w)
    }
}

// Watertight check: every undirected edge appears exactly twice.
// FreeCAD has no easy UI for this — use this gate / demo print.
// Returns 1 closed, 0 open/non-manifold. O(n_tris^2) simple scan (fine for CAD demos).
Function.CAD_Tess.VerifyWatertight {
    Input: mesh_addr: Address
    Output: Integer
    Body: {
        n_tris = ArrayGet(mesh_addr, 1)
        i_base = ArrayGet(mesh_addr, 3)
        IfCondition LessThan(n_tris, 4) ThenBlock: { ReturnValue(0) }
        ebuf = Allocate(65536)
        ecnt = Allocate(65536)
        ne = 0
        t = 0
        WhileLoop LessThan(t, n_tris) {
            io = Multiply(t, 3)
            a = ArrayGet(i_base, io)
            b = ArrayGet(i_base, Add(io, 1))
            c = ArrayGet(i_base, Add(io, 2))
            k = 0
            WhileLoop LessThan(k, 3) {
                IfCondition EqualTo(k, 0) ThenBlock: {
                    u = a
                    v = b
                }
                IfCondition EqualTo(k, 1) ThenBlock: {
                    u = b
                    v = c
                }
                IfCondition EqualTo(k, 2) ThenBlock: {
                    u = c
                    v = a
                }
                IfCondition GreaterThan(u, v) ThenBlock: {
                    tmp = u
                    u = v
                    v = tmp
                }
                key = Add(Multiply(u, 65536), v)
                found = 0
                j = 0
                WhileLoop LessThan(j, ne) {
                    IfCondition EqualTo(ArrayGet(ebuf, j), key) ThenBlock: {
                        ArraySet(ecnt, j, Add(ArrayGet(ecnt, j), 1))
                        found = 1
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    ArraySet(ebuf, ne, key)
                    ArraySet(ecnt, ne, 1)
                    ne = Add(ne, 1)
                }
                k = Add(k, 1)
            }
            t = Add(t, 1)
        }
        ok = 1
        j = 0
        WhileLoop LessThan(j, ne) {
            IfCondition NotEqual(ArrayGet(ecnt, j), 2) ThenBlock: { ok = 0 }
            j = Add(j, 1)
        }
        Deallocate(ebuf, 65536)
        Deallocate(ecnt, 65536)
        ReturnValue(ok)
    }
}

// Export ASCII STL from mesh buffer
Function.CAD_Tess.ExportMeshSTL {
    Input: mesh_addr: Address
    Input: filename_addr: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, filename_addr, 577, 438)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-16)
        }
        n_tris = ArrayGet(mesh_addr, 1)
        v_base = ArrayGet(mesh_addr, 2)
        i_base = ArrayGet(mesh_addr, 3)
        CAD_Tess.WriteStr(fd, "solid AILang_CAD\n")
        tri = Allocate(96)
        t = 0
        zero = 0x0000000000000000
        WhileLoop LessThan(t, n_tris) {
            io = Multiply(t, 3)
            i0 = ArrayGet(i_base, io)
            i1 = ArrayGet(i_base, Add(io, 1))
            i2 = ArrayGet(i_base, Add(io, 2))
            b0 = Multiply(i0, 3)
            b1 = Multiply(i1, 3)
            b2 = Multiply(i2, 3)
            ArraySet(tri, 0, ArrayGet(v_base, b0))
            ArraySet(tri, 1, ArrayGet(v_base, Add(b0, 1)))
            ArraySet(tri, 2, ArrayGet(v_base, Add(b0, 2)))
            ArraySet(tri, 3, ArrayGet(v_base, b1))
            ArraySet(tri, 4, ArrayGet(v_base, Add(b1, 1)))
            ArraySet(tri, 5, ArrayGet(v_base, Add(b1, 2)))
            ArraySet(tri, 6, ArrayGet(v_base, b2))
            ArraySet(tri, 7, ArrayGet(v_base, Add(b2, 1)))
            ArraySet(tri, 8, ArrayGet(v_base, Add(b2, 2)))
            CAD_Tess.WriteFacet(fd, zero, zero, zero, tri)
            t = Add(t, 1)
        }
        CAD_Tess.WriteStr(fd, "endsolid AILang_CAD\n")
        Deallocate(tri, 96)
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }
}

Function.CAD_Tess.ExportSTL {
    Input: solid_handle: Integer
    Input: filename_addr: Address
    Output: Integer
    Body: {
        mesh = Allocate(48)
        n = CAD_Tess.MeshSolid(solid_handle, 0, mesh)
        IfCondition LessThan(n, 1) ThenBlock: {
            Deallocate(mesh, 48)
            ReturnValue(-1)
        }
        rc = CAD_Tess.ExportMeshSTL(mesh, filename_addr)
        Deallocate(mesh, 48)
        ReturnValue(rc)
    }
}
