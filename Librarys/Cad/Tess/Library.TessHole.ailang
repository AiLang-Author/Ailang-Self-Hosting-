LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.StringUtils

Function.CAD_Tess.PointInIdxPoly {
    Input: wx: Integer
    Input: wy: Integer
    Input: v_base: Address
    Input: idx_addr: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        inside = 0
        i = 0
        j = Subtract(n, 1)
        WhileLoop LessThan(i, n) {
            ia = ArrayGet(idx_addr, i)
            ib = ArrayGet(idx_addr, j)
            xi = ArrayGet(v_base, Multiply(ia, 3))
            yi = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
            xj = ArrayGet(v_base, Multiply(ib, 3))
            yj = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
            a = 0
            b = 0
            // yi > wy  /  yj > wy — IsNeg, not Float_Le (broken for negatives)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wy, yi)), 1) ThenBlock: { a = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wy, yj)), 1) ThenBlock: { b = 1 }
            IfCondition NotEqual(a, b) ThenBlock: {
                den = Float_Sub(yj, yi)
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    xint = Float_Add(xi, Float_Mul(Float_Sub(xj, xi), Float_Div(Float_Sub(wy, yi), den)))
                    // wx < xint
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wx, xint)), 1) ThenBlock: {
                        inside = Subtract(1, inside)
                    }
                }
            }
            j = i
            i = Add(i, 1)
        }
        ReturnValue(inside)
    }
}

// 1 if (wx,wy) is inside or on triangle i0-i1-i2 (no opposing Orient2D signs).
Function.CAD_Tess.PointInTriXY {
    Input: wx: Integer
    Input: wy: Integer
    Input: v_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        i0 = ArrayGet(pack_addr, 0)
        i1 = ArrayGet(pack_addr, 1)
        i2 = ArrayGet(pack_addr, 2)
        ax = ArrayGet(v_base, Multiply(i0, 3))
        ay = ArrayGet(v_base, Add(Multiply(i0, 3), 1))
        bx = ArrayGet(v_base, Multiply(i1, 3))
        by = ArrayGet(v_base, Add(Multiply(i1, 3), 1))
        cx = ArrayGet(v_base, Multiply(i2, 3))
        cy = ArrayGet(v_base, Add(Multiply(i2, 3), 1))
        // sign of (B-A)×(P-A), (C-B)×(P-B), (A-C)×(P-C)
        d1 = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(wy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(wx, ax)))
        d2 = Float_Sub(Float_Mul(Float_Sub(cx, bx), Float_Sub(wy, by)), Float_Mul(Float_Sub(cy, by), Float_Sub(wx, bx)))
        d3 = Float_Sub(Float_Mul(Float_Sub(ax, cx), Float_Sub(wy, cy)), Float_Mul(Float_Sub(ay, cy), Float_Sub(wx, cx)))
        has_pos = 0
        has_neg = 0
        IfCondition EqualTo(CAD_Num.IsZero(d1, 0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { has_neg = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 0) ThenBlock: { has_pos = 1 }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d2, 0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { has_neg = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 0) ThenBlock: { has_pos = 1 }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d3, 0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(d3), 1) ThenBlock: { has_neg = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(d3), 0) ThenBlock: { has_pos = 1 }
        }
        IfCondition EqualTo(has_pos, 1) ThenBlock: {
            IfCondition EqualTo(has_neg, 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(has_pos, 0) ThenBlock: {
            IfCondition EqualTo(has_neg, 0) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

// Even-odd test of (zip_cx, zip_cy) against merge_orig[off, n).
Function.CAD_Tess.PointInOrigSpan {
    Input: off: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        CAD_Tess_State.sc_a0 = off
        CAD_Tess_State.sc_closed = n
        IfCondition LessThan(CAD_Tess_State.sc_closed, 3) ThenBlock: { ReturnValue(0) }
        CAD_Tess_State.zip_ao = 0
        CAD_Tess_State.sc_span = 0
        CAD_Tess_State.sc_crv = Subtract(CAD_Tess_State.sc_closed, 1)
        WhileLoop LessThan(CAD_Tess_State.sc_span, CAD_Tess_State.sc_closed) {
            CAD_Tess_State.punch_q = CAD_Num.IsNeg(Float_Sub(CAD_Tess_State.zip_cy, ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ArrayGet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.sc_a0, CAD_Tess_State.sc_span)), 3), 1))))
            CAD_Tess_State.punch_s = CAD_Num.IsNeg(Float_Sub(CAD_Tess_State.zip_cy, ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ArrayGet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.sc_a0, CAD_Tess_State.sc_crv)), 3), 1))))
            IfCondition NotEqual(CAD_Tess_State.punch_q, CAD_Tess_State.punch_s) ThenBlock: {
                CAD_Tess_State.zip_nt = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ArrayGet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.sc_a0, CAD_Tess_State.sc_crv)), 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ArrayGet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.sc_a0, CAD_Tess_State.sc_span)), 3), 1)))
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.zip_nt, 0), 0) ThenBlock: {
                    CAD_Tess_State.zip_nt = Float_Add(ArrayGet(CAD_Tess_State.v_base, Multiply(ArrayGet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.sc_a0, CAD_Tess_State.sc_span)), 3)), Float_Mul(Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(ArrayGet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.sc_a0, CAD_Tess_State.sc_crv)), 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(ArrayGet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.sc_a0, CAD_Tess_State.sc_span)), 3))), Float_Div(Float_Sub(CAD_Tess_State.zip_cy, ArrayGet(CAD_Tess_State.v_base, Add(Multiply(ArrayGet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.sc_a0, CAD_Tess_State.sc_span)), 3), 1))), CAD_Tess_State.zip_nt)))
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_nt)), 1) ThenBlock: {
                        CAD_Tess_State.zip_ao = Subtract(1, CAD_Tess_State.zip_ao)
                    }
                }
            }
            CAD_Tess_State.sc_crv = CAD_Tess_State.sc_span
            CAD_Tess_State.sc_span = Add(CAD_Tess_State.sc_span, 1)
        }
        ReturnValue(CAD_Tess_State.zip_ao)
    }
}

// 1 if spoke zip_i→zip_j misses every still-unmerged packed hole.
Function.CAD_Tess.SpokeClearsRest {
    Output: Integer
    Body: {
        CAD_Tess_State.zip_cx = Float_Mul(Float_Add(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_j, 3))), 0x3FE0000000000000)
        CAD_Tess_State.zip_cy = Float_Mul(Float_Add(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_j, 3), 1))), 0x3FE0000000000000)
        CAD_Tess_State.zip_ah = 0
        CAD_Tess_State.pi = 0
        WhileLoop LessEqual(CAD_Tess_State.pi, CAD_Tess_State.merge_hi) {
            CAD_Tess_State.zip_ah = Add(CAD_Tess_State.zip_ah, ArrayGet(CAD_Tess_State.clean, Add(CAD_Tess_State.pi, 1)))
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        CAD_Tess_State.want_h = Add(CAD_Tess_State.merge_hi, 1)
        WhileLoop LessThan(CAD_Tess_State.want_h, CAD_Tess_State.holes_ok) {
            CAD_Tess_State.nn = ArrayGet(CAD_Tess_State.clean, Add(CAD_Tess_State.want_h, 1))
            CAD_Tess_State.nring = 0
            WhileLoop LessThan(CAD_Tess_State.nring, CAD_Tess_State.nn) {
                CAD_Tess_State.zip_ao = Add(CAD_Tess_State.nring, 1)
                IfCondition EqualTo(CAD_Tess_State.zip_ao, CAD_Tess_State.nn) ThenBlock: { CAD_Tess_State.zip_ao = 0 }
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(CAD_Tess_State.v_base, CAD_Tess_State.zip_i, CAD_Tess_State.zip_j, ArrayGet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.zip_ah, CAD_Tess_State.nring)), ArrayGet(CAD_Tess_State.merge_orig, Add(CAD_Tess_State.zip_ah, CAD_Tess_State.zip_ao))), 1) ThenBlock: {
                    ReturnValue(0)
                }
                CAD_Tess_State.nring = Add(CAD_Tess_State.nring, 1)
            }
            IfCondition EqualTo(CAD_Tess.PointInOrigSpan(CAD_Tess_State.zip_ah, CAD_Tess_State.nn), 1) ThenBlock: {
                ReturnValue(0)
            }
            CAD_Tess_State.zip_ah = Add(CAD_Tess_State.zip_ah, CAD_Tess_State.nn)
            CAD_Tess_State.want_h = Add(CAD_Tess_State.want_h, 1)
        }
        ReturnValue(1)
    }
}

// Proper segment intersection (shared endpoints do not count).
Function.CAD_Tess.SegsCrossXY {
    Input: v_base: Address
    Input: ia: Integer
    Input: ib: Integer
    Input: ic: Integer
    Input: id: Integer
    Output: Integer
    Body: {
        ax = ArrayGet(v_base, Multiply(ia, 3))
        ay = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
        bx = ArrayGet(v_base, Multiply(ib, 3))
        by = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
        cx = ArrayGet(v_base, Multiply(ic, 3))
        cy = ArrayGet(v_base, Add(Multiply(ic, 3), 1))
        dx = ArrayGet(v_base, Multiply(id, 3))
        dy = ArrayGet(v_base, Add(Multiply(id, 3), 1))
        // Orient(A,B,C), (A,B,D), (C,D,A), (C,D,B)
        d1 = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(cy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(cx, ax)))
        d2 = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(dy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(dx, ax)))
        d3 = Float_Sub(Float_Mul(Float_Sub(dx, cx), Float_Sub(ay, cy)), Float_Mul(Float_Sub(dy, cy), Float_Sub(ax, cx)))
        d4 = Float_Sub(Float_Mul(Float_Sub(dx, cx), Float_Sub(by, cy)), Float_Mul(Float_Sub(dy, cy), Float_Sub(bx, cx)))
        o1 = 0
        o2 = 0
        o3 = 0
        o4 = 0
        IfCondition EqualTo(CAD_Num.IsZero(d1, 0), 0) ThenBlock: {
            o1 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { o1 = Subtract(0, 1) }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d2, 0), 0) ThenBlock: {
            o2 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { o2 = Subtract(0, 1) }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d3, 0), 0) ThenBlock: {
            o3 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d3), 1) ThenBlock: { o3 = Subtract(0, 1) }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d4, 0), 0) ThenBlock: {
            o4 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d4), 1) ThenBlock: { o4 = Subtract(0, 1) }
        }
        r = 0
        IfCondition NotEqual(o1, o2) ThenBlock: {
            IfCondition NotEqual(o1, 0) ThenBlock: {
                IfCondition NotEqual(o2, 0) ThenBlock: {
                    IfCondition NotEqual(o3, o4) ThenBlock: {
                        IfCondition NotEqual(o3, 0) ThenBlock: {
                            IfCondition NotEqual(o4, 0) ThenBlock: { r = 1 }
                        }
                    }
                }
            }
        }
        ReturnValue(r)
    }
}

// 1 if oidx[ep0]→merge_hc[ep1] is a proper visible diagonal of the
// current ring + this hole. Remaining packed holes are SpokeClearsRest.
Function.CAD_Tess.BridgeVisible {
    Input: v_base: Address
    Input: oidx: Address
    Input: hidx: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.oidx, ArrayGet(CAD_Tess_State.ep, 0))
        CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.merge_hc, ArrayGet(CAD_Tess_State.ep, 1))
        CAD_Tess_State.pi = 0
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nout) {
            CAD_Tess_State.nn = Add(CAD_Tess_State.pi, 1)
            IfCondition EqualTo(CAD_Tess_State.nn, CAD_Tess_State.nout) ThenBlock: { CAD_Tess_State.nn = 0 }
            CAD_Tess_State.zip_nt = 0
            IfCondition EqualTo(CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.ep, 0)) ThenBlock: { CAD_Tess_State.zip_nt = 1 }
            IfCondition EqualTo(CAD_Tess_State.nn, ArrayGet(CAD_Tess_State.ep, 0)) ThenBlock: { CAD_Tess_State.zip_nt = 1 }
            IfCondition EqualTo(CAD_Tess_State.zip_nt, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(CAD_Tess_State.v_base, CAD_Tess_State.zip_i, CAD_Tess_State.zip_j, ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.pi), ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.nn)), 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        CAD_Tess_State.pi = 0
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nh) {
            CAD_Tess_State.nn = Add(CAD_Tess_State.pi, 1)
            IfCondition EqualTo(CAD_Tess_State.nn, CAD_Tess_State.nh) ThenBlock: { CAD_Tess_State.nn = 0 }
            CAD_Tess_State.zip_nt = 0
            IfCondition EqualTo(CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.ep, 1)) ThenBlock: { CAD_Tess_State.zip_nt = 1 }
            IfCondition EqualTo(CAD_Tess_State.nn, ArrayGet(CAD_Tess_State.ep, 1)) ThenBlock: { CAD_Tess_State.zip_nt = 1 }
            IfCondition EqualTo(CAD_Tess_State.zip_nt, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(CAD_Tess_State.v_base, CAD_Tess_State.zip_i, CAD_Tess_State.zip_j, ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.pi), ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.nn)), 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        CAD_Tess_State.zip_cx = Float_Mul(Float_Add(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_j, 3))), 0x3FE0000000000000)
        CAD_Tess_State.zip_cy = Float_Mul(Float_Add(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_j, 3), 1))), 0x3FE0000000000000)
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy, CAD_Tess_State.v_base, CAD_Tess_State.oidx, CAD_Tess_State.nout), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy, CAD_Tess_State.v_base, CAD_Tess_State.merge_hc, CAD_Tess_State.nh), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Splice one hole into the current ring along a visible spoke.
// A spoke is legal iff it does not cross the ring, this hole, or any
// still-unmerged hole, and its midpoint sits in the face interior.
// Any such spoke is correct; shortest is only a quality pick.
Function.CAD_Tess.MergeHoleRing {
    Input: v_base: Address
    Input: oidx: Address
    Input: hidx: Address
    Input: out_idx: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(CAD_Tess_State.nout, 3) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CAD_Tess_State.nh, 3) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Tess.FaceBufs(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Tess_State.pi = 0
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nh) {
            ArraySet(CAD_Tess_State.merge_hc, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.hidx, CAD_Tess_State.pi))
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        CAD_Tess_State.zip_best = 0
        CAD_Tess_State.pi = 0
        WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nh) {
            CAD_Tess_State.nn = Add(CAD_Tess_State.pi, 1)
            IfCondition EqualTo(CAD_Tess_State.nn, CAD_Tess_State.nh) ThenBlock: { CAD_Tess_State.nn = 0 }
            CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.pi)
            CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.nn)
            CAD_Tess_State.zip_best = Float_Add(CAD_Tess_State.zip_best, Float_Sub(Float_Mul(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_j, 3), 1))), Float_Mul(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_j, 3)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)))))
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Tess_State.zip_best), 0) ThenBlock: {
            CAD_Tess_State.pi = 0
            CAD_Tess_State.nn = Subtract(CAD_Tess_State.nh, 1)
            WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nn) {
                CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.pi)
                ArraySet(CAD_Tess_State.merge_hc, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.nn))
                ArraySet(CAD_Tess_State.merge_hc, CAD_Tess_State.nn, CAD_Tess_State.zip_i)
                CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
                CAD_Tess_State.nn = Subtract(CAD_Tess_State.nn, 1)
            }
        }
        CAD_Tess.PipeI("pipe merge nout=", 16, CAD_Tess_State.nout)
        CAD_Tess.PipeI(" nh=", 4, CAD_Tess_State.nh)
        CAD_Tess_State.use_zip = 0
        CAD_Tess_State.merge_bi = 0
        CAD_Tess_State.merge_bj = 0
        CAD_Tess_State.merge_best = 0
        CAD_Tess_State.inner = 0
        WhileLoop LessThan(CAD_Tess_State.inner, 2) {
            CAD_Tess_State.merge_si = 0
            WhileLoop LessThan(CAD_Tess_State.merge_si, CAD_Tess_State.nout) {
                CAD_Tess_State.zip_nt = 1
                IfCondition EqualTo(CAD_Tess_State.inner, 0) ThenBlock: {
                    IfCondition GreaterEqual(ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.merge_si), CAD_Tess_State.merge_obase) ThenBlock: { CAD_Tess_State.zip_nt = 0 }
                }
                IfCondition EqualTo(CAD_Tess_State.zip_nt, 1) ThenBlock: {
                    CAD_Tess_State.merge_sj = 0
                    WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.nh) {
                        ArraySet(CAD_Tess_State.ep, 0, CAD_Tess_State.merge_si)
                        ArraySet(CAD_Tess_State.ep, 1, CAD_Tess_State.merge_sj)
                        ArraySet(CAD_Tess_State.ep, 2, CAD_Tess_State.nout)
                        ArraySet(CAD_Tess_State.ep, 3, CAD_Tess_State.nh)
                        IfCondition EqualTo(CAD_Tess.BridgeVisible(CAD_Tess_State.v_base, CAD_Tess_State.oidx, CAD_Tess_State.merge_hc, CAD_Tess_State.ep), 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Tess.SpokeClearsRest(), 1) ThenBlock: {
                                CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.merge_si)
                                CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.merge_sj)
                                CAD_Tess_State.zip_cx = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_j, 3)))
                                CAD_Tess_State.zip_cy = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_j, 3), 1)))
                                CAD_Tess_State.zip_cx = Float_Add(Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cy))
                                CAD_Tess_State.zip_ao = 0
                                IfCondition EqualTo(CAD_Tess_State.use_zip, 0) ThenBlock: { CAD_Tess_State.zip_ao = 1 }
                                IfCondition EqualTo(CAD_Tess_State.use_zip, 1) ThenBlock: {
                                    IfCondition EqualTo(Float_Le(CAD_Tess_State.zip_cx, CAD_Tess_State.merge_best), 1) ThenBlock: { CAD_Tess_State.zip_ao = 1 }
                                }
                                IfCondition EqualTo(CAD_Tess_State.zip_ao, 1) ThenBlock: {
                                    CAD_Tess_State.merge_best = CAD_Tess_State.zip_cx
                                    CAD_Tess_State.merge_bi = CAD_Tess_State.merge_si
                                    CAD_Tess_State.merge_bj = CAD_Tess_State.merge_sj
                                    CAD_Tess_State.use_zip = 1
                                }
                            }
                        }
                        CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
                    }
                }
                CAD_Tess_State.merge_si = Add(CAD_Tess_State.merge_si, 1)
            }
            IfCondition EqualTo(CAD_Tess_State.use_zip, 1) ThenBlock: { CAD_Tess_State.inner = 2 }
            IfCondition NotEqual(CAD_Tess_State.inner, 2) ThenBlock: { CAD_Tess_State.inner = Add(CAD_Tess_State.inner, 1) }
        }
        IfCondition EqualTo(CAD_Tess_State.use_zip, 0) ThenBlock: { ReturnValue(0) }
        // Left of h→h_next must be the annulus, not the hole interior.
        CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.merge_bj)
        CAD_Tess_State.zip_ao = Add(CAD_Tess_State.merge_bj, 1)
        IfCondition EqualTo(CAD_Tess_State.zip_ao, CAD_Tess_State.nh) ThenBlock: { CAD_Tess_State.zip_ao = 0 }
        CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.zip_ao)
        CAD_Tess_State.zip_cx = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_j, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)))
        CAD_Tess_State.zip_cy = Float_Sub(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_j, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)))
        CAD_Tess_State.zip_best = CAD_Num.Sqrt(Float_Add(Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cx), Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cy)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.zip_best, 0), 0) ThenBlock: {
            CAD_Tess_State.sc_a0 = Float_Div(0x3FA999999999999A, CAD_Tess_State.zip_best)
            CAD_Tess_State.zip_nt = Float_Mul(Float_Add(ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_i, 3)), ArrayGet(CAD_Tess_State.v_base, Multiply(CAD_Tess_State.zip_j, 3))), 0x3FE0000000000000)
            CAD_Tess_State.nring = Float_Mul(Float_Add(ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_i, 3), 1)), ArrayGet(CAD_Tess_State.v_base, Add(Multiply(CAD_Tess_State.zip_j, 3), 1))), 0x3FE0000000000000)
            CAD_Tess_State.zip_nt = Float_Sub(CAD_Tess_State.zip_nt, Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.sc_a0))
            CAD_Tess_State.nring = Float_Add(CAD_Tess_State.nring, Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.sc_a0))
            IfCondition EqualTo(CAD_Tess.PointInIdxPoly(CAD_Tess_State.zip_nt, CAD_Tess_State.nring, CAD_Tess_State.v_base, CAD_Tess_State.merge_hc, CAD_Tess_State.nh), 1) ThenBlock: {
                CAD_Tess_State.pi = 0
                CAD_Tess_State.nn = Subtract(CAD_Tess_State.nh, 1)
                WhileLoop LessThan(CAD_Tess_State.pi, CAD_Tess_State.nn) {
                    CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.pi)
                    ArraySet(CAD_Tess_State.merge_hc, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.nn))
                    ArraySet(CAD_Tess_State.merge_hc, CAD_Tess_State.nn, CAD_Tess_State.zip_i)
                    CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
                    CAD_Tess_State.nn = Subtract(CAD_Tess_State.nn, 1)
                }
                CAD_Tess_State.merge_bj = Subtract(Subtract(CAD_Tess_State.nh, 1), CAD_Tess_State.merge_bj)
                CAD_Tess.Pipe("pipe hole walk-rev\n", 18)
            }
        }
        CAD_Tess_State.pi = 0
        CAD_Tess_State.nn = 0
        WhileLoop LessEqual(CAD_Tess_State.nn, CAD_Tess_State.merge_bi) {
            ArraySet(CAD_Tess_State.bridged, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.nn))
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
        }
        CAD_Tess_State.nn = 0
        WhileLoop LessThan(CAD_Tess_State.nn, CAD_Tess_State.nh) {
            CAD_Tess_State.want_h = Add(CAD_Tess_State.merge_bj, CAD_Tess_State.nn)
            IfCondition GreaterEqual(CAD_Tess_State.want_h, CAD_Tess_State.nh) ThenBlock: { CAD_Tess_State.want_h = Subtract(CAD_Tess_State.want_h, CAD_Tess_State.nh) }
            ArraySet(CAD_Tess_State.bridged, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.want_h))
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
        }
        ArraySet(CAD_Tess_State.bridged, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.merge_hc, CAD_Tess_State.merge_bj))
        CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        ArraySet(CAD_Tess_State.bridged, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.merge_bi))
        CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
        CAD_Tess_State.nn = Add(CAD_Tess_State.merge_bi, 1)
        WhileLoop LessThan(CAD_Tess_State.nn, CAD_Tess_State.nout) {
            ArraySet(CAD_Tess_State.bridged, CAD_Tess_State.pi, ArrayGet(CAD_Tess_State.oidx, CAD_Tess_State.nn))
            CAD_Tess_State.pi = Add(CAD_Tess_State.pi, 1)
            CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
        }
        ReturnValue(CAD_Tess_State.pi)
    }
}

// 1 if triangle i0-i1-i2 overlaps indexed loop (hole).
// pack: [i0, i1, i2, n]
Function.CAD_Tess.TriOverlapsIdxPoly {
    Input: v_base: Address
    Input: idx_addr: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        i0 = ArrayGet(pack_addr, 0)
        i1 = ArrayGet(pack_addr, 1)
        i2 = ArrayGet(pack_addr, 2)
        n = ArrayGet(pack_addr, 3)
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        three = 0x4008000000000000
        x0 = ArrayGet(v_base, Multiply(i0, 3))
        y0 = ArrayGet(v_base, Add(Multiply(i0, 3), 1))
        x1 = ArrayGet(v_base, Multiply(i1, 3))
        y1 = ArrayGet(v_base, Add(Multiply(i1, 3), 1))
        x2 = ArrayGet(v_base, Multiply(i2, 3))
        y2 = ArrayGet(v_base, Add(Multiply(i2, 3), 1))
        mx = Float_Div(Float_Add(Float_Add(x0, x1), x2), three)
        my = Float_Div(Float_Add(Float_Add(y0, y1), y2), three)
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(x0, y0, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(x1, y1, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(x2, y2, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        tp = Allocate(16)
        ArraySet(tp, 0, i0)
        ArraySet(tp, 1, i1)
        ArraySet(tp, 2, i2)
        k = 0
        hit = 0
        WhileLoop LessThan(k, n) {
            IfCondition EqualTo(hit, 0) ThenBlock: {
                hk = ArrayGet(idx_addr, k)
                hx = ArrayGet(v_base, Multiply(hk, 3))
                hy = ArrayGet(v_base, Add(Multiply(hk, 3), 1))
                IfCondition EqualTo(CAD_Tess.PointInTriXY(hx, hy, v_base, tp), 1) ThenBlock: { hit = 1 }
            }
            k = Add(k, 1)
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            Deallocate(tp, 16)
            ReturnValue(1)
        }
        k = 0
        WhileLoop LessThan(k, n) {
            IfCondition EqualTo(hit, 0) ThenBlock: {
                kn = Add(k, 1)
                IfCondition EqualTo(kn, n) ThenBlock: { kn = 0 }
                ha = ArrayGet(idx_addr, k)
                hb = ArrayGet(idx_addr, kn)
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, i0, i1, ha, hb), 1) ThenBlock: { hit = 1 }
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, i1, i2, ha, hb), 1) ThenBlock: { hit = 1 }
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, i2, i0, ha, hb), 1) ThenBlock: { hit = 1 }
            }
            k = Add(k, 1)
        }
        Deallocate(tp, 16)
        ReturnValue(hit)
    }
}
