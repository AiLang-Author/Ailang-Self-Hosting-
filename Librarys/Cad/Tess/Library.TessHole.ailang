// CAD.Tess — mesh generation + STL (facade). part Hole
// API stays Function.CAD_Tess.*  (facade: LibraryImport.Cad.CAD_Tess)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.StringUtils

Function.CAD_Tess.PointInIdxPoly {
    Input: wx: Integer
    Input: wy: Integer
    Input: v_base: Address
    Input: idx_addr: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        inside = 0
        i = 0
        j = Subtract(n, 1)
        WhileLoop LessThan(i, n) {
            ia = ArrayGet(idx_addr, i)
            ib = ArrayGet(idx_addr, j)
            xi = ArrayGet(v_base, Multiply(ia, 3))
            yi = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
            xj = ArrayGet(v_base, Multiply(ib, 3))
            yj = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
            a = 0
            b = 0
            // yi > wy  /  yj > wy — IsNeg, not Float_Le (broken for negatives)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wy, yi)), 1) ThenBlock: { a = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wy, yj)), 1) ThenBlock: { b = 1 }
            IfCondition NotEqual(a, b) ThenBlock: {
                den = Float_Sub(yj, yi)
                IfCondition EqualTo(CAD_Num.IsZero(den, 0), 0) ThenBlock: {
                    xint = Float_Add(xi, Float_Mul(Float_Sub(xj, xi), Float_Div(Float_Sub(wy, yi), den)))
                    // wx < xint
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(wx, xint)), 1) ThenBlock: {
                        inside = Subtract(1, inside)
                    }
                }
            }
            j = i
            i = Add(i, 1)
        }
        ReturnValue(inside)
    }
}

// 1 if (wx,wy) is inside or on triangle i0-i1-i2 (no opposing Orient2D signs).
Function.CAD_Tess.PointInTriXY {
    Input: wx: Integer
    Input: wy: Integer
    Input: v_base: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        i0 = ArrayGet(pack_addr, 0)
        i1 = ArrayGet(pack_addr, 1)
        i2 = ArrayGet(pack_addr, 2)
        ax = ArrayGet(v_base, Multiply(i0, 3))
        ay = ArrayGet(v_base, Add(Multiply(i0, 3), 1))
        bx = ArrayGet(v_base, Multiply(i1, 3))
        by = ArrayGet(v_base, Add(Multiply(i1, 3), 1))
        cx = ArrayGet(v_base, Multiply(i2, 3))
        cy = ArrayGet(v_base, Add(Multiply(i2, 3), 1))
        // sign of (B-A)×(P-A), (C-B)×(P-B), (A-C)×(P-C)
        d1 = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(wy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(wx, ax)))
        d2 = Float_Sub(Float_Mul(Float_Sub(cx, bx), Float_Sub(wy, by)), Float_Mul(Float_Sub(cy, by), Float_Sub(wx, bx)))
        d3 = Float_Sub(Float_Mul(Float_Sub(ax, cx), Float_Sub(wy, cy)), Float_Mul(Float_Sub(ay, cy), Float_Sub(wx, cx)))
        has_pos = 0
        has_neg = 0
        IfCondition EqualTo(CAD_Num.IsZero(d1, 0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { has_neg = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 0) ThenBlock: { has_pos = 1 }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d2, 0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { has_neg = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 0) ThenBlock: { has_pos = 1 }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d3, 0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(d3), 1) ThenBlock: { has_neg = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(d3), 0) ThenBlock: { has_pos = 1 }
        }
        IfCondition EqualTo(has_pos, 1) ThenBlock: {
            IfCondition EqualTo(has_neg, 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(has_pos, 0) ThenBlock: {
            IfCondition EqualTo(has_neg, 0) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

// Proper segment intersection (shared endpoints do not count).
Function.CAD_Tess.SegsCrossXY {
    Input: v_base: Address
    Input: ia: Integer
    Input: ib: Integer
    Input: ic: Integer
    Input: id: Integer
    Output: Integer
    Body: {
        ax = ArrayGet(v_base, Multiply(ia, 3))
        ay = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
        bx = ArrayGet(v_base, Multiply(ib, 3))
        by = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
        cx = ArrayGet(v_base, Multiply(ic, 3))
        cy = ArrayGet(v_base, Add(Multiply(ic, 3), 1))
        dx = ArrayGet(v_base, Multiply(id, 3))
        dy = ArrayGet(v_base, Add(Multiply(id, 3), 1))
        // Orient(A,B,C), (A,B,D), (C,D,A), (C,D,B)
        d1 = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(cy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(cx, ax)))
        d2 = Float_Sub(Float_Mul(Float_Sub(bx, ax), Float_Sub(dy, ay)), Float_Mul(Float_Sub(by, ay), Float_Sub(dx, ax)))
        d3 = Float_Sub(Float_Mul(Float_Sub(dx, cx), Float_Sub(ay, cy)), Float_Mul(Float_Sub(dy, cy), Float_Sub(ax, cx)))
        d4 = Float_Sub(Float_Mul(Float_Sub(dx, cx), Float_Sub(by, cy)), Float_Mul(Float_Sub(dy, cy), Float_Sub(bx, cx)))
        o1 = 0
        o2 = 0
        o3 = 0
        o4 = 0
        IfCondition EqualTo(CAD_Num.IsZero(d1, 0), 0) ThenBlock: {
            o1 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { o1 = Subtract(0, 1) }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d2, 0), 0) ThenBlock: {
            o2 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d2), 1) ThenBlock: { o2 = Subtract(0, 1) }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d3, 0), 0) ThenBlock: {
            o3 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d3), 1) ThenBlock: { o3 = Subtract(0, 1) }
        }
        IfCondition EqualTo(CAD_Num.IsZero(d4, 0), 0) ThenBlock: {
            o4 = 1
            IfCondition EqualTo(CAD_Num.IsNeg(d4), 1) ThenBlock: { o4 = Subtract(0, 1) }
        }
        r = 0
        IfCondition NotEqual(o1, o2) ThenBlock: {
            IfCondition NotEqual(o1, 0) ThenBlock: {
                IfCondition NotEqual(o2, 0) ThenBlock: {
                    IfCondition NotEqual(o3, o4) ThenBlock: {
                        IfCondition NotEqual(o3, 0) ThenBlock: {
                            IfCondition NotEqual(o4, 0) ThenBlock: { r = 1 }
                        }
                    }
                }
            }
        }
        ReturnValue(r)
    }
}

// 1 if segment outer[oi]→hole[hj] is a proper visible diagonal:
// no proper crossing of outer or hole edges, midpoint in the annulus.
// pack: [oi, hj, nout, nh]
Function.CAD_Tess.BridgeVisible {
    Input: v_base: Address
    Input: oidx: Address
    Input: hidx: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        oi = ArrayGet(pack_addr, 0)
        hj = ArrayGet(pack_addr, 1)
        nout = ArrayGet(pack_addr, 2)
        nh = ArrayGet(pack_addr, 3)
        ia = ArrayGet(oidx, oi)
        ib = ArrayGet(hidx, hj)
        e = 0
        WhileLoop LessThan(e, nout) {
            e1 = Add(e, 1)
            IfCondition EqualTo(e1, nout) ThenBlock: { e1 = 0 }
            skip = 0
            IfCondition EqualTo(e, oi) ThenBlock: { skip = 1 }
            IfCondition EqualTo(e1, oi) ThenBlock: { skip = 1 }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, ia, ib, ArrayGet(oidx, e), ArrayGet(oidx, e1)), 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
            e = Add(e, 1)
        }
        e = 0
        WhileLoop LessThan(e, nh) {
            e1 = Add(e, 1)
            IfCondition EqualTo(e1, nh) ThenBlock: { e1 = 0 }
            skip = 0
            IfCondition EqualTo(e, hj) ThenBlock: { skip = 1 }
            IfCondition EqualTo(e1, hj) ThenBlock: { skip = 1 }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, ia, ib, ArrayGet(hidx, e), ArrayGet(hidx, e1)), 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
            e = Add(e, 1)
        }
        half = 0x3FE0000000000000
        mx = Float_Mul(Float_Add(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3))), half)
        my = Float_Mul(Float_Add(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), half)
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, oidx, nout), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, hidx, nh), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Insert a hole into an outer ring along a non-crossing spoke.
// Geometry: hole centroid C, farthest outer vertex O, hole vertex H
// most aligned with (O−C). For nested circles that spoke is radial.
// Then Held visible, then shortest annulus midpoint. Address-pinned
// (Allocate locals die across BridgeVisible — rect-in-rect hit first
// pair; a 32-gon circle did not and crashed). pack: [nout, nh]
Function.CAD_Tess.MergeHoleRing {
    Input: v_base: Address
    Input: oidx: Address
    Input: hidx: Address
    Input: out_idx: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        nout = ArrayGet(pack_addr, 0)
        nh = ArrayGet(pack_addr, 1)
        IfCondition LessThan(nout, 3) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nh, 3) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Tess.FaceBufs(), 0) ThenBlock: { ReturnValue(0) }
        v_base = CAD_Tess_State.v_base
        oidx = CAD_Tess_State.oidx
        hidx = CAD_Tess_State.hidx
        hc = CAD_Tess_State.merge_hc
        out_idx = CAD_Tess_State.bridged
        j = 0
        WhileLoop LessThan(j, nh) {
            ArraySet(hc, j, ArrayGet(hidx, j))
            j = Add(j, 1)
        }
        harea = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            jn = Add(j, 1)
            IfCondition EqualTo(jn, nh) ThenBlock: { jn = 0 }
            ia = ArrayGet(hc, j)
            ib = ArrayGet(hc, jn)
            harea = Float_Add(harea, Float_Sub(Float_Mul(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), Float_Mul(ArrayGet(v_base, Multiply(ib, 3)), ArrayGet(v_base, Add(Multiply(ia, 3), 1)))))
            j = Add(j, 1)
        }
        // hole opposite outer: CW (negative area)
        IfCondition EqualTo(CAD_Num.IsNeg(harea), 0) ThenBlock: {
            hc = CAD_Tess_State.merge_hc
            lo = 0
            hi = Subtract(nh, 1)
            WhileLoop LessThan(lo, hi) {
                tmpi = ArrayGet(hc, lo)
                ArraySet(hc, lo, ArrayGet(hc, hi))
                ArraySet(hc, hi, tmpi)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        v_base = CAD_Tess_State.v_base
        oidx = CAD_Tess_State.oidx
        hc = CAD_Tess_State.merge_hc
        // hole centroid — radial spoke is the known nested-circle diagonal
        hcx = 0
        hcy = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            ia = ArrayGet(hc, j)
            hcx = Float_Add(hcx, ArrayGet(v_base, Multiply(ia, 3)))
            hcy = Float_Add(hcy, ArrayGet(v_base, Add(Multiply(ia, 3), 1)))
            j = Add(j, 1)
        }
        nf = Float_FromInt(nh)
        hcx = Float_Div(hcx, nf)
        hcy = Float_Div(hcy, nf)
        v_base = CAD_Tess_State.v_base
        oidx = CAD_Tess_State.oidx
        hc = CAD_Tess_State.merge_hc
        bi = 0
        best_d2 = 0
        i = 0
        WhileLoop LessThan(i, nout) {
            ia = ArrayGet(oidx, i)
            dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), hcx)
            dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), hcy)
            d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
            IfCondition EqualTo(Float_Le(d2, best_d2), 0) ThenBlock: {
                best_d2 = d2
                bi = i
            }
            i = Add(i, 1)
        }
        ia = ArrayGet(oidx, bi)
        ox = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), hcx)
        oy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), hcy)
        bj = 0
        best_dot = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            ib = ArrayGet(hc, j)
            hx = Float_Sub(ArrayGet(v_base, Multiply(ib, 3)), hcx)
            hy = Float_Sub(ArrayGet(v_base, Add(Multiply(ib, 3), 1)), hcy)
            dt = Float_Add(Float_Mul(hx, ox), Float_Mul(hy, oy))
            IfCondition EqualTo(j, 0) ThenBlock: {
                best_dot = dt
                bj = 0
            }
            IfCondition GreaterThan(j, 0) ThenBlock: {
                IfCondition EqualTo(Float_Le(dt, best_dot), 0) ThenBlock: {
                    best_dot = dt
                    bj = j
                }
            }
            j = Add(j, 1)
        }
        bp = CAD_Tess_State.ep
        ArraySet(bp, 0, bi)
        ArraySet(bp, 1, bj)
        ArraySet(bp, 2, nout)
        ArraySet(bp, 3, nh)
        found = 0
        IfCondition EqualTo(CAD_Tess.BridgeVisible(CAD_Tess_State.v_base, CAD_Tess_State.oidx, CAD_Tess_State.merge_hc, CAD_Tess_State.ep), 1) ThenBlock: {
            found = 1
        }
        // Held: first remaining visible diagonal
        i = 0
        WhileLoop LessThan(i, nout) {
            IfCondition EqualTo(found, 0) ThenBlock: {
                j = 0
                WhileLoop LessThan(j, nh) {
                    IfCondition EqualTo(found, 0) ThenBlock: {
                        bp = CAD_Tess_State.ep
                        ArraySet(bp, 0, i)
                        ArraySet(bp, 1, j)
                        ArraySet(bp, 2, nout)
                        ArraySet(bp, 3, nh)
                        IfCondition EqualTo(CAD_Tess.BridgeVisible(CAD_Tess_State.v_base, CAD_Tess_State.oidx, CAD_Tess_State.merge_hc, CAD_Tess_State.ep), 1) ThenBlock: {
                            bi = i
                            bj = j
                            found = 1
                        }
                    }
                    j = Add(j, 1)
                }
            }
            i = Add(i, 1)
        }
        // shortest pair whose midpoint sits in the annulus (inside outer, outside hole)
        IfCondition EqualTo(found, 0) ThenBlock: {
            best_d2 = 0x7FF0000000000000
            i = 0
            WhileLoop LessThan(i, nout) {
                j = 0
                WhileLoop LessThan(j, nh) {
                    v_base = CAD_Tess_State.v_base
                    oidx = CAD_Tess_State.oidx
                    hc = CAD_Tess_State.merge_hc
                    ia = ArrayGet(oidx, i)
                    ib = ArrayGet(hc, j)
                    dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                    dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                    d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                    half = 0x3FE0000000000000
                    mx = Float_Mul(Float_Add(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3))), half)
                    my = Float_Mul(Float_Add(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), half)
                    pin_o = CAD_Tess.PointInIdxPoly(mx, my, CAD_Tess_State.v_base, CAD_Tess_State.oidx, nout)
                    pin_h = CAD_Tess.PointInIdxPoly(mx, my, CAD_Tess_State.v_base, CAD_Tess_State.merge_hc, nh)
                    IfCondition EqualTo(pin_o, 1) ThenBlock: {
                        IfCondition EqualTo(pin_h, 0) ThenBlock: {
                            IfCondition EqualTo(Float_Le(d2, best_d2), 1) ThenBlock: {
                                best_d2 = d2
                                bi = i
                                bj = j
                                found = 1
                            }
                        }
                    }
                    j = Add(j, 1)
                }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(found, 0) ThenBlock: { ReturnValue(0) }
        // [0..bi] + hole cycle from bj + hole[bj] + outer[bi] + [bi+1..]
        oidx = CAD_Tess_State.oidx
        hc = CAD_Tess_State.merge_hc
        out_idx = CAD_Tess_State.bridged
        ti = 0
        k = 0
        WhileLoop LessEqual(k, bi) {
            ArraySet(out_idx, ti, ArrayGet(oidx, k))
            ti = Add(ti, 1)
            k = Add(k, 1)
        }
        k = 0
        WhileLoop LessThan(k, nh) {
            kk = Add(bj, k)
            IfCondition GreaterEqual(kk, nh) ThenBlock: { kk = Subtract(kk, nh) }
            ArraySet(out_idx, ti, ArrayGet(hc, kk))
            ti = Add(ti, 1)
            k = Add(k, 1)
        }
        ArraySet(out_idx, ti, ArrayGet(hc, bj))
        ti = Add(ti, 1)
        ArraySet(out_idx, ti, ArrayGet(oidx, bi))
        ti = Add(ti, 1)
        k = Add(bi, 1)
        WhileLoop LessThan(k, nout) {
            ArraySet(out_idx, ti, ArrayGet(oidx, k))
            ti = Add(ti, 1)
            k = Add(k, 1)
        }
        ReturnValue(ti)
    }
}

// 1 if triangle i0-i1-i2 overlaps indexed loop (hole).
// pack: [i0, i1, i2, n]
Function.CAD_Tess.TriOverlapsIdxPoly {
    Input: v_base: Address
    Input: idx_addr: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        i0 = ArrayGet(pack_addr, 0)
        i1 = ArrayGet(pack_addr, 1)
        i2 = ArrayGet(pack_addr, 2)
        n = ArrayGet(pack_addr, 3)
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        three = 0x4008000000000000
        x0 = ArrayGet(v_base, Multiply(i0, 3))
        y0 = ArrayGet(v_base, Add(Multiply(i0, 3), 1))
        x1 = ArrayGet(v_base, Multiply(i1, 3))
        y1 = ArrayGet(v_base, Add(Multiply(i1, 3), 1))
        x2 = ArrayGet(v_base, Multiply(i2, 3))
        y2 = ArrayGet(v_base, Add(Multiply(i2, 3), 1))
        mx = Float_Div(Float_Add(Float_Add(x0, x1), x2), three)
        my = Float_Div(Float_Add(Float_Add(y0, y1), y2), three)
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(x0, y0, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(x1, y1, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(x2, y2, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, idx_addr, n), 1) ThenBlock: { ReturnValue(1) }
        tp = Allocate(16)
        ArraySet(tp, 0, i0)
        ArraySet(tp, 1, i1)
        ArraySet(tp, 2, i2)
        k = 0
        hit = 0
        WhileLoop LessThan(k, n) {
            IfCondition EqualTo(hit, 0) ThenBlock: {
                hk = ArrayGet(idx_addr, k)
                hx = ArrayGet(v_base, Multiply(hk, 3))
                hy = ArrayGet(v_base, Add(Multiply(hk, 3), 1))
                IfCondition EqualTo(CAD_Tess.PointInTriXY(hx, hy, v_base, tp), 1) ThenBlock: { hit = 1 }
            }
            k = Add(k, 1)
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            Deallocate(tp, 16)
            ReturnValue(1)
        }
        k = 0
        WhileLoop LessThan(k, n) {
            IfCondition EqualTo(hit, 0) ThenBlock: {
                kn = Add(k, 1)
                IfCondition EqualTo(kn, n) ThenBlock: { kn = 0 }
                ha = ArrayGet(idx_addr, k)
                hb = ArrayGet(idx_addr, kn)
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, i0, i1, ha, hb), 1) ThenBlock: { hit = 1 }
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, i1, i2, ha, hb), 1) ThenBlock: { hit = 1 }
                IfCondition EqualTo(CAD_Tess.SegsCrossXY(v_base, i2, i0, ha, hb), 1) ThenBlock: { hit = 1 }
            }
            k = Add(k, 1)
        }
        Deallocate(tp, 16)
        ReturnValue(hit)
    }
}

// Zipper a CCW triangle to a hole loop. Writes tris into i_base.
// tpack: [i0, i1, i2]   opack: [nh, flip, tri_count]
// Returns updated tri_count. Interior spokes — not a degenerate keyhole slit.
