// Mesh a kind-6 loft wall by evaluating the rational quarter.
// 17 by 5 samples. Two triangles per cell. Caps stay on the ear-clip.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.Nurbs.NurbsSurf

FixedPool.CAD_Tess_Nurb {
    "surf": Initialize=0, CanChange=True
    "base": Initialize=0, CanChange=True
    "iu": Initialize=0, CanChange=True
    "iv": Initialize=0, CanChange=True
    "nu": Initialize=0, CanChange=True
    "nv": Initialize=0, CanChange=True
    "stride": Initialize=0, CanChange=True
    "rc": Initialize=0, CanChange=True
    "x": Initialize=0, CanChange=True
    "y": Initialize=0, CanChange=True
    "z": Initialize=0, CanChange=True
    "u": Initialize=0, CanChange=True
    "v": Initialize=0, CanChange=True
    "i0": Initialize=0, CanChange=True
    "i1": Initialize=0, CanChange=True
    "i2": Initialize=0, CanChange=True
    "i3": Initialize=0, CanChange=True
    "vo": Initialize=0, CanChange=True
    "to": Initialize=0, CanChange=True
    "fnu": Initialize=0, CanChange=True
    "fnv": Initialize=0, CanChange=True
}

Function.CAD_Tess.MeshNurbsFace {
    Output: Integer
    Body: {
        CAD_Tess_Nurb.surf = CAD_Store.Read(CAD_Tess_State.tess_face, 0)
        IfCondition EqualTo(CAD_Tess_Nurb.surf, 0) ThenBlock: { ReturnValue(0) }
        CAD_NurbsSurf_Wall.h = CAD_Tess_Nurb.surf
        CAD_Tess_Nurb.rc = CAD_NurbsSurf.BindWall()
        IfCondition NotEqual(CAD_Tess_Nurb.rc, 0) ThenBlock: { ReturnValue(0) }
        CAD_Tess_Nurb.nu = 16
        CAD_Tess_Nurb.nv = 4
        CAD_Tess_Nurb.stride = 17
        CAD_Tess_Nurb.fnu = Float_FromInt(CAD_Tess_Nurb.nu)
        CAD_Tess_Nurb.fnv = Float_FromInt(CAD_Tess_Nurb.nv)
        CAD_Tess_Nurb.base = ArrayGet(CAD_Tess_State.pack, 0)
        CAD_Tess_Nurb.iv = 0
        WhileLoop LessThan(CAD_Tess_Nurb.iv, 5) {
            CAD_Tess_Nurb.iu = 0
            WhileLoop LessThan(CAD_Tess_Nurb.iu, 17) {
                CAD_Tess_Nurb.u = Float_FromInt(CAD_Tess_Nurb.iu)
                CAD_Tess_Nurb.u = Float_Div(CAD_Tess_Nurb.u, CAD_Tess_Nurb.fnu)
                CAD_Tess_Nurb.v = Float_FromInt(CAD_Tess_Nurb.iv)
                CAD_Tess_Nurb.v = Float_Div(CAD_Tess_Nurb.v, CAD_Tess_Nurb.fnv)
                CAD_Tess_Nurb.rc = CAD_NurbsSurf.EvalWall(CAD_Tess_Nurb.u, CAD_Tess_Nurb.v)
                IfCondition NotEqual(CAD_Tess_Nurb.rc, 0) ThenBlock: {
                    CAD_NurbsSurf.ReleaseWall()
                    ReturnValue(0)
                }
                CAD_Tess_Nurb.x = CAD_NurbsSurf_Wall.x
                CAD_Tess_Nurb.y = CAD_NurbsSurf_Wall.y
                CAD_Tess_Nurb.z = CAD_NurbsSurf_Wall.z
                CAD_Tess_Nurb.i0 = Multiply(CAD_Tess_Nurb.iv, CAD_Tess_Nurb.stride)
                CAD_Tess_Nurb.i0 = Add(CAD_Tess_Nurb.i0, CAD_Tess_Nurb.iu)
                CAD_Tess_Nurb.i0 = Add(CAD_Tess_Nurb.i0, CAD_Tess_Nurb.base)
                CAD_Tess_Nurb.vo = Multiply(CAD_Tess_Nurb.i0, 3)
                ArraySet(CAD_Tess_State.v_base, CAD_Tess_Nurb.vo, CAD_Tess_Nurb.x)
                CAD_Tess_Nurb.vo = Add(CAD_Tess_Nurb.vo, 1)
                ArraySet(CAD_Tess_State.v_base, CAD_Tess_Nurb.vo, CAD_Tess_Nurb.y)
                CAD_Tess_Nurb.vo = Add(CAD_Tess_Nurb.vo, 1)
                ArraySet(CAD_Tess_State.v_base, CAD_Tess_Nurb.vo, CAD_Tess_Nurb.z)
                CAD_Tess_Nurb.iu = Add(CAD_Tess_Nurb.iu, 1)
            }
            CAD_Tess_Nurb.iv = Add(CAD_Tess_Nurb.iv, 1)
        }
        CAD_Tess_Nurb.to = ArrayGet(CAD_Tess_State.pack, 1)
        CAD_Tess_Nurb.iv = 0
        WhileLoop LessThan(CAD_Tess_Nurb.iv, CAD_Tess_Nurb.nv) {
            CAD_Tess_Nurb.iu = 0
            WhileLoop LessThan(CAD_Tess_Nurb.iu, CAD_Tess_Nurb.nu) {
                CAD_Tess_Nurb.i0 = Multiply(CAD_Tess_Nurb.iv, CAD_Tess_Nurb.stride)
                CAD_Tess_Nurb.i0 = Add(CAD_Tess_Nurb.i0, CAD_Tess_Nurb.iu)
                CAD_Tess_Nurb.i0 = Add(CAD_Tess_Nurb.i0, CAD_Tess_Nurb.base)
                CAD_Tess_Nurb.i1 = Add(CAD_Tess_Nurb.i0, 1)
                CAD_Tess_Nurb.i2 = Add(CAD_Tess_Nurb.i0, CAD_Tess_Nurb.stride)
                CAD_Tess_Nurb.i3 = Add(CAD_Tess_Nurb.i2, 1)
                CAD_Tess_Nurb.vo = Multiply(CAD_Tess_Nurb.to, 3)
                ArraySet(CAD_Tess_State.i_base, CAD_Tess_Nurb.vo, CAD_Tess_Nurb.i0)
                CAD_Tess_Nurb.vo = Add(CAD_Tess_Nurb.vo, 1)
                ArraySet(CAD_Tess_State.i_base, CAD_Tess_Nurb.vo, CAD_Tess_Nurb.i1)
                CAD_Tess_Nurb.vo = Add(CAD_Tess_Nurb.vo, 1)
                ArraySet(CAD_Tess_State.i_base, CAD_Tess_Nurb.vo, CAD_Tess_Nurb.i3)
                CAD_Tess_Nurb.to = Add(CAD_Tess_Nurb.to, 1)
                CAD_Tess_Nurb.vo = Multiply(CAD_Tess_Nurb.to, 3)
                ArraySet(CAD_Tess_State.i_base, CAD_Tess_Nurb.vo, CAD_Tess_Nurb.i0)
                CAD_Tess_Nurb.vo = Add(CAD_Tess_Nurb.vo, 1)
                ArraySet(CAD_Tess_State.i_base, CAD_Tess_Nurb.vo, CAD_Tess_Nurb.i3)
                CAD_Tess_Nurb.vo = Add(CAD_Tess_Nurb.vo, 1)
                ArraySet(CAD_Tess_State.i_base, CAD_Tess_Nurb.vo, CAD_Tess_Nurb.i2)
                CAD_Tess_Nurb.to = Add(CAD_Tess_Nurb.to, 1)
                CAD_Tess_Nurb.iu = Add(CAD_Tess_Nurb.iu, 1)
            }
            CAD_Tess_Nurb.iv = Add(CAD_Tess_Nurb.iv, 1)
        }
        CAD_Tess_Nurb.i0 = Multiply(CAD_Tess_Nurb.stride, 5)
        CAD_Tess_Nurb.i0 = Add(CAD_Tess_Nurb.base, CAD_Tess_Nurb.i0)
        ArraySet(CAD_Tess_State.pack, 0, CAD_Tess_Nurb.i0)
        ArraySet(CAD_Tess_State.pack, 1, CAD_Tess_Nurb.to)
        CAD_NurbsSurf.ReleaseWall()
        ReturnValue(0)
    }
}
