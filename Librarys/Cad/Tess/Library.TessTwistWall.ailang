// Straight ruled quads whose four corners are not coplanar.
// Split along the ruling so flat shading follows the surface.
// A planar wall returns 0 and the caller keeps two triangles.
// Fillet and cylinder rails never reach here: they already have
// more than two samples. No sagitta print.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.StringUtils

// Copy one mesh vertex into samp[dst .. dst+2].
Function.CAD_Tess.TwistLoad {
    Input: vi: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        CAD_Tess_State.sc_i = vi
        CAD_Tess_State.sc_n = dst
        CAD_Tess_State.nn = Multiply(CAD_Tess_State.sc_i, 3)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.v_base, CAD_Tess_State.nn)
        ArraySet(CAD_Tess_State.samp, CAD_Tess_State.sc_n, CAD_Tess_State.zip_cx)
        CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.v_base, CAD_Tess_State.nn)
        CAD_Tess_State.pi = Add(CAD_Tess_State.sc_n, 1)
        ArraySet(CAD_Tess_State.samp, CAD_Tess_State.pi, CAD_Tess_State.zip_cx)
        CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.v_base, CAD_Tess_State.nn)
        CAD_Tess_State.pi = Add(CAD_Tess_State.sc_n, 2)
        ArraySet(CAD_Tess_State.samp, CAD_Tess_State.pi, CAD_Tess_State.zip_cx)
        ReturnValue(0)
    }
}

// samp[dst] = samp[a] - samp[b]. One component.
Function.CAD_Tess.TwistSub {
    Input: a: Integer
    Input: b: Integer
    Input: dst: Integer
    Output: Integer
    Body: {
        CAD_Tess_State.sc_i = a
        CAD_Tess_State.sc_n = b
        CAD_Tess_State.sc_closed = dst
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.sc_i)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.sc_n)
        CAD_Tess_State.zip_nt = Float_Sub(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy)
        ArraySet(CAD_Tess_State.samp, CAD_Tess_State.sc_closed, CAD_Tess_State.zip_nt)
        ReturnValue(0)
    }
}

// |xyz| at samp[at]. Result left in merge_hi.
Function.CAD_Tess.TwistLen {
    Input: at: Integer
    Output: Integer
    Body: {
        CAD_Tess_State.sc_i = at
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.sc_i)
        CAD_Tess_State.zip_cx = Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cx)
        CAD_Tess_State.sc_n = Add(CAD_Tess_State.sc_i, 1)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.sc_n)
        CAD_Tess_State.zip_cy = Float_Mul(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cy)
        CAD_Tess_State.sc_n = Add(CAD_Tess_State.sc_i, 2)
        CAD_Tess_State.zip_nt = ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.sc_n)
        CAD_Tess_State.zip_nt = Float_Mul(CAD_Tess_State.zip_nt, CAD_Tess_State.zip_nt)
        CAD_Tess_State.zip_cx = Float_Add(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy)
        CAD_Tess_State.zip_cx = Float_Add(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_nt)
        CAD_Tess_State.merge_hi = CAD_Num.Sqrt(CAD_Tess_State.zip_cx)
        ReturnValue(0)
    }
}

// N = U × V. U is samp[12], V is samp[15], N lands in samp[21].
Function.CAD_Tess.TwistCross {
    Output: Integer
    Body: {
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, 13)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, 17)
        CAD_Tess_State.zip_nt = Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, 14)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, 16)
        CAD_Tess_State.zip_cy = Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy)
        CAD_Tess_State.zip_nt = Float_Sub(CAD_Tess_State.zip_nt, CAD_Tess_State.zip_cy)
        ArraySet(CAD_Tess_State.samp, 21, CAD_Tess_State.zip_nt)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, 14)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, 15)
        CAD_Tess_State.zip_nt = Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, 12)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, 17)
        CAD_Tess_State.zip_cy = Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy)
        CAD_Tess_State.zip_nt = Float_Sub(CAD_Tess_State.zip_nt, CAD_Tess_State.zip_cy)
        ArraySet(CAD_Tess_State.samp, 22, CAD_Tess_State.zip_nt)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, 12)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, 16)
        CAD_Tess_State.zip_nt = Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, 13)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, 15)
        CAD_Tess_State.zip_cy = Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy)
        CAD_Tess_State.zip_nt = Float_Sub(CAD_Tess_State.zip_nt, CAD_Tess_State.zip_cy)
        ArraySet(CAD_Tess_State.samp, 23, CAD_Tess_State.zip_nt)
        ReturnValue(0)
    }
}

// 0 when the quad is flat. Otherwise steps along the ruling.
// Corners already sit in samp: A0, A1, B0, B1.
// The mesh cache is per solid, so the step does not follow zoom.
Function.CAD_Tess.TwistSteps {
    Output: Integer
    Body: {
        CAD_Tess.TwistSub(3, 0, 12)
        CAD_Tess.TwistSub(4, 1, 13)
        CAD_Tess.TwistSub(5, 2, 14)
        CAD_Tess.TwistSub(6, 0, 15)
        CAD_Tess.TwistSub(7, 1, 16)
        CAD_Tess.TwistSub(8, 2, 17)
        CAD_Tess.TwistCross()
        CAD_Tess.TwistLen(21)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Tess_State.merge_hi, 0), 1) ThenBlock: {
            ReturnValue(0)
        }
        ArraySet(CAD_Tess_State.samp, 24, CAD_Tess_State.merge_hi)
        CAD_Tess.TwistSub(9, 0, 18)
        CAD_Tess.TwistSub(10, 1, 19)
        CAD_Tess.TwistSub(11, 2, 20)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, 18)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, 21)
        CAD_Tess_State.zip_nt = Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, 19)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, 22)
        CAD_Tess_State.zip_cy = Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy)
        CAD_Tess_State.zip_nt = Float_Add(CAD_Tess_State.zip_nt, CAD_Tess_State.zip_cy)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, 20)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, 23)
        CAD_Tess_State.zip_cy = Float_Mul(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_cy)
        CAD_Tess_State.zip_nt = Float_Add(CAD_Tess_State.zip_nt, CAD_Tess_State.zip_cy)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Tess_State.zip_nt), 1) ThenBlock: {
            CAD_Tess_State.zip_nt = Float_Sub(0, CAD_Tess_State.zip_nt)
        }
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, 24)
        CAD_Tess_State.merge_hoff = Float_Div(CAD_Tess_State.zip_nt, CAD_Tess_State.zip_cx)
        CAD_Tess_State.zip_best = 0x3F947AE147AE147B
        IfCondition EqualTo(Float_Le(CAD_Tess_State.zip_best, CAD_Tess_State.merge_hoff), 0) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Tess.TwistLen(15)
        CAD_Tess_State.zip_best = CAD_Tess_State.merge_hi
        CAD_Tess.TwistSub(9, 3, 18)
        CAD_Tess.TwistSub(10, 4, 19)
        CAD_Tess.TwistSub(11, 5, 20)
        CAD_Tess.TwistLen(18)
        IfCondition EqualTo(Float_Le(CAD_Tess_State.zip_best, CAD_Tess_State.merge_hi), 1) ThenBlock: {
            CAD_Tess_State.zip_best = CAD_Tess_State.merge_hi
        }
        CAD_Tess_State.zip_cx = 0x3F947AE147AE147B
        IfCondition EqualTo(Float_Le(CAD_Tess_State.zip_best, CAD_Tess_State.zip_cx), 1) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Tess_State.zip_best = Float_Div(CAD_Tess_State.zip_best, 0x4000000000000000)
        CAD_Tess_State.nn = Float_ToInt(CAD_Tess_State.zip_best)
        IfCondition LessThan(CAD_Tess_State.nn, 8) ThenBlock: {
            CAD_Tess_State.nn = 8
        }
        IfCondition GreaterThan(CAD_Tess_State.nn, 32) ThenBlock: {
            CAD_Tess_State.nn = 32
        }
        ReturnValue(CAD_Tess_State.nn)
    }
}

// P = A + t*(B-A), t in zip_best. Write vertex vi.
Function.CAD_Tess.TwistLerp {
    Input: ia: Integer
    Input: ib: Integer
    Input: vi: Integer
    Output: Integer
    Body: {
        CAD_Tess_State.sc_i = ia
        CAD_Tess_State.sc_n = ib
        CAD_Tess_State.sc_closed = vi
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.sc_i)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.sc_n)
        CAD_Tess_State.zip_nt = Float_Sub(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cx)
        CAD_Tess_State.zip_nt = Float_Mul(CAD_Tess_State.zip_best, CAD_Tess_State.zip_nt)
        CAD_Tess_State.zip_nt = Float_Add(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_nt)
        CAD_Tess_State.nn = Multiply(CAD_Tess_State.sc_closed, 3)
        ArraySet(CAD_Tess_State.v_base, CAD_Tess_State.nn, CAD_Tess_State.zip_nt)
        CAD_Tess_State.pi = Add(CAD_Tess_State.sc_i, 1)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.pi)
        CAD_Tess_State.pi = Add(CAD_Tess_State.sc_n, 1)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.pi)
        CAD_Tess_State.zip_nt = Float_Sub(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cx)
        CAD_Tess_State.zip_nt = Float_Mul(CAD_Tess_State.zip_best, CAD_Tess_State.zip_nt)
        CAD_Tess_State.zip_nt = Float_Add(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_nt)
        CAD_Tess_State.nn = Multiply(CAD_Tess_State.sc_closed, 3)
        CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
        ArraySet(CAD_Tess_State.v_base, CAD_Tess_State.nn, CAD_Tess_State.zip_nt)
        CAD_Tess_State.pi = Add(CAD_Tess_State.sc_i, 2)
        CAD_Tess_State.zip_cx = ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.pi)
        CAD_Tess_State.pi = Add(CAD_Tess_State.sc_n, 2)
        CAD_Tess_State.zip_cy = ArrayGet(CAD_Tess_State.samp, CAD_Tess_State.pi)
        CAD_Tess_State.zip_nt = Float_Sub(CAD_Tess_State.zip_cy, CAD_Tess_State.zip_cx)
        CAD_Tess_State.zip_nt = Float_Mul(CAD_Tess_State.zip_best, CAD_Tess_State.zip_nt)
        CAD_Tess_State.zip_nt = Float_Add(CAD_Tess_State.zip_cx, CAD_Tess_State.zip_nt)
        CAD_Tess_State.nn = Multiply(CAD_Tess_State.sc_closed, 3)
        CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 2)
        ArraySet(CAD_Tess_State.v_base, CAD_Tess_State.nn, CAD_Tess_State.zip_nt)
        ReturnValue(0)
    }
}

// Vertex index of one corner of the grid. Row 0 and row n are the
// sampled profile ends. Rows between them were appended at merge_bi.
Function.CAD_Tess.TwistRowVert {
    Input: row: Integer
    Input: side: Integer
    Output: Integer
    Body: {
        CAD_Tess_State.sc_ang = row
        CAD_Tess_State.sc_crv = side
        IfCondition EqualTo(CAD_Tess_State.sc_ang, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Tess_State.sc_crv, 0) ThenBlock: {
                ReturnValue(ArrayGet(CAD_Tess_State.samp, 40))
            }
            ReturnValue(ArrayGet(CAD_Tess_State.samp, 41))
        }
        IfCondition EqualTo(CAD_Tess_State.sc_ang, CAD_Tess_State.merge_si) ThenBlock: {
            IfCondition EqualTo(CAD_Tess_State.sc_crv, 0) ThenBlock: {
                ReturnValue(ArrayGet(CAD_Tess_State.samp, 42))
            }
            ReturnValue(ArrayGet(CAD_Tess_State.samp, 43))
        }
        CAD_Tess_State.nn = Subtract(CAD_Tess_State.sc_ang, 1)
        CAD_Tess_State.nn = Multiply(CAD_Tess_State.nn, 2)
        CAD_Tess_State.nn = Add(CAD_Tess_State.nn, CAD_Tess_State.sc_crv)
        CAD_Tess_State.nn = Add(CAD_Tess_State.merge_bi, CAD_Tess_State.nn)
        ReturnValue(CAD_Tess_State.nn)
    }
}

// 1 when this 2-point quad was replaced by a ruled grid. 0 keeps
// the caller's two triangles. nout and nh stay 2, so the curved-rail
// sagitta print does not run.
Function.CAD_Tess.MeshTwistWall {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Tess_State.samp, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(CAD_Tess_State.nout, 2) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(CAD_Tess_State.nh, 2) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Tess_State.zip_ao = ArrayGet(CAD_Tess_State.oidx, 0)
        ArraySet(CAD_Tess_State.samp, 40, CAD_Tess_State.zip_ao)
        CAD_Tess.TwistLoad(CAD_Tess_State.zip_ao, 0)
        CAD_Tess_State.zip_ah = ArrayGet(CAD_Tess_State.oidx, 1)
        ArraySet(CAD_Tess_State.samp, 41, CAD_Tess_State.zip_ah)
        CAD_Tess.TwistLoad(CAD_Tess_State.zip_ah, 3)
        CAD_Tess_State.zip_i = ArrayGet(CAD_Tess_State.hidx, 0)
        ArraySet(CAD_Tess_State.samp, 42, CAD_Tess_State.zip_i)
        CAD_Tess.TwistLoad(CAD_Tess_State.zip_i, 6)
        CAD_Tess_State.zip_j = ArrayGet(CAD_Tess_State.hidx, 1)
        ArraySet(CAD_Tess_State.samp, 43, CAD_Tess_State.zip_j)
        CAD_Tess.TwistLoad(CAD_Tess_State.zip_j, 9)
        CAD_Tess_State.merge_si = CAD_Tess.TwistSteps()
        IfCondition LessThan(CAD_Tess_State.merge_si, 8) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Tess_State.merge_bi = ArrayGet(CAD_Tess_State.pack, 0)
        CAD_Tess_State.pi = Subtract(CAD_Tess_State.merge_si, 1)
        CAD_Tess_State.pi = Multiply(CAD_Tess_State.pi, 2)
        CAD_Tess_State.nn = Add(CAD_Tess_State.merge_bi, CAD_Tess_State.pi)
        IfCondition GreaterThan(CAD_Tess_State.nn, 8000) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Tess_State.pi = Multiply(CAD_Tess_State.merge_si, 2)
        CAD_Tess_State.nn = Add(CAD_Tess_State.holes_ok, CAD_Tess_State.pi)
        IfCondition GreaterThan(CAD_Tess_State.nn, 40000) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Tess_State.merge_sj = 1
        WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.merge_si) {
            CAD_Tess_State.zip_best = Float_Div(Float_FromInt(CAD_Tess_State.merge_sj), Float_FromInt(CAD_Tess_State.merge_si))
            CAD_Tess_State.sc_a0 = Subtract(CAD_Tess_State.merge_sj, 1)
            CAD_Tess_State.sc_a0 = Multiply(CAD_Tess_State.sc_a0, 2)
            CAD_Tess_State.sc_a0 = Add(CAD_Tess_State.merge_bi, CAD_Tess_State.sc_a0)
            CAD_Tess.TwistLerp(0, 6, CAD_Tess_State.sc_a0)
            CAD_Tess_State.sc_a0 = Add(CAD_Tess_State.sc_a0, 1)
            CAD_Tess.TwistLerp(3, 9, CAD_Tess_State.sc_a0)
            CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
        }
        CAD_Tess_State.pi = Subtract(CAD_Tess_State.merge_si, 1)
        CAD_Tess_State.pi = Multiply(CAD_Tess_State.pi, 2)
        CAD_Tess_State.pi = Add(CAD_Tess_State.merge_bi, CAD_Tess_State.pi)
        ArraySet(CAD_Tess_State.pack, 0, CAD_Tess_State.pi)
        CAD_Tess_State.merge_sj = 0
        WhileLoop LessThan(CAD_Tess_State.merge_sj, CAD_Tess_State.merge_si) {
            CAD_Tess_State.zip_ao = CAD_Tess.TwistRowVert(CAD_Tess_State.merge_sj, 0)
            CAD_Tess_State.zip_ah = CAD_Tess.TwistRowVert(CAD_Tess_State.merge_sj, 1)
            CAD_Tess_State.sc_span = Add(CAD_Tess_State.merge_sj, 1)
            CAD_Tess_State.zip_i = CAD_Tess.TwistRowVert(CAD_Tess_State.sc_span, 0)
            CAD_Tess_State.zip_j = CAD_Tess.TwistRowVert(CAD_Tess_State.sc_span, 1)
            CAD_Tess_State.nn = CAD_Tess_State.holes_ok
            ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
            ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_ah)
            ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_j)
            CAD_Tess_State.nn = Add(CAD_Tess_State.nn, 1)
            ArraySet(CAD_Tess_State.i_base, Multiply(CAD_Tess_State.nn, 3), CAD_Tess_State.zip_ao)
            ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 1), CAD_Tess_State.zip_j)
            ArraySet(CAD_Tess_State.i_base, Add(Multiply(CAD_Tess_State.nn, 3), 2), CAD_Tess_State.zip_i)
            CAD_Tess_State.holes_ok = Add(CAD_Tess_State.nn, 1)
            CAD_Tess_State.merge_sj = Add(CAD_Tess_State.merge_sj, 1)
        }
        ReturnValue(1)
    }
}
