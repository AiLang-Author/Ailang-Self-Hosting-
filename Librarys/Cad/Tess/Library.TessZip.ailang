// CAD.Tess — mesh generation + STL (facade). part Zip
// API stays Function.CAD_Tess.*  (facade: LibraryImport.Cad.CAD_Tess)

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Topo
LibraryImport.Cad.CAD_Geom
LibraryImport.StringUtils

Function.CAD_Tess.ZipperTriHole {
    Input: v_base: Address
    Input: i_base: Address
    Input: tpack: Address
    Input: hidx: Address
    Input: opack: Address
    Output: Integer
    Body: {
        nh = ArrayGet(opack, 0)
        flip = ArrayGet(opack, 1)
        tri = ArrayGet(opack, 2)
        IfCondition LessThan(nh, 3) ThenBlock: { ReturnValue(tri) }
        oa = Allocate(32)
        ArraySet(oa, 0, ArrayGet(tpack, 0))
        ArraySet(oa, 1, ArrayGet(tpack, 1))
        ArraySet(oa, 2, ArrayGet(tpack, 2))
        area = 0
        j = 0
        WhileLoop LessThan(j, 3) {
            jn = Add(j, 1)
            IfCondition EqualTo(jn, 3) ThenBlock: { jn = 0 }
            ia = ArrayGet(oa, j)
            ib = ArrayGet(oa, jn)
            xa = ArrayGet(v_base, Multiply(ia, 3))
            ya = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
            xb = ArrayGet(v_base, Multiply(ib, 3))
            yb = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
            area = Float_Add(area, Float_Sub(Float_Mul(xa, yb), Float_Mul(xb, ya)))
            j = Add(j, 1)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(area), 1) ThenBlock: {
            tmpi = ArrayGet(oa, 1)
            ArraySet(oa, 1, ArrayGet(oa, 2))
            ArraySet(oa, 2, tmpi)
        }
        hc = Allocate(16384)
        j = 0
        WhileLoop LessThan(j, nh) {
            ArraySet(hc, j, ArrayGet(hidx, j))
            j = Add(j, 1)
        }
        harea = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            jn = Add(j, 1)
            IfCondition EqualTo(jn, nh) ThenBlock: { jn = 0 }
            ia = ArrayGet(hc, j)
            ib = ArrayGet(hc, jn)
            xa = ArrayGet(v_base, Multiply(ia, 3))
            ya = ArrayGet(v_base, Add(Multiply(ia, 3), 1))
            xb = ArrayGet(v_base, Multiply(ib, 3))
            yb = ArrayGet(v_base, Add(Multiply(ib, 3), 1))
            harea = Float_Add(harea, Float_Sub(Float_Mul(xa, yb), Float_Mul(xb, ya)))
            j = Add(j, 1)
        }
        // hole must be CW (negative) so zipper stays in the annulus
        IfCondition EqualTo(CAD_Num.IsNeg(harea), 0) ThenBlock: {
            lo = 0
            hi = Subtract(nh, 1)
            WhileLoop LessThan(lo, hi) {
                tmpi = ArrayGet(hc, lo)
                ArraySet(hc, lo, ArrayGet(hc, hi))
                ArraySet(hc, hi, tmpi)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        bi = 0
        bj = 0
        best = 0x7FF0000000000000
        i = 0
        WhileLoop LessThan(i, 3) {
            j = 0
            WhileLoop LessThan(j, nh) {
                ia = ArrayGet(oa, i)
                ib = ArrayGet(hc, j)
                dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bi = i
                    bj = j
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        pa = Allocate(32)
        pb = Allocate(32)
        pc = Allocate(32)
        i = bi
        j = bj
        ao = 0
        ah = 0
        guard = 0
        maxg = Add(Add(3, nh), 4)
        WhileLoop LessThan(guard, maxg) {
            done = 0
            IfCondition EqualTo(ao, 3) ThenBlock: {
                IfCondition EqualTo(ah, nh) ThenBlock: { done = 1 }
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
                i1 = Add(i, 1)
                IfCondition EqualTo(i1, 3) ThenBlock: { i1 = 0 }
                j1 = Add(j, 1)
                IfCondition EqualTo(j1, nh) ThenBlock: { j1 = 0 }
                take_o = 0
                IfCondition EqualTo(ah, nh) ThenBlock: { take_o = 1 }
                IfCondition EqualTo(ao, 3) ThenBlock: { take_o = 0 }
                IfCondition LessThan(ao, 3) ThenBlock: {
                    IfCondition LessThan(ah, nh) ThenBlock: {
                        ia = ArrayGet(oa, i1)
                        ib = ArrayGet(hc, j)
                        dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                        dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                        d_o = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        ia = ArrayGet(oa, i)
                        ib = ArrayGet(hc, j1)
                        dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                        dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                        d_h = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                        take_o = 0
                        IfCondition EqualTo(Float_Le(d_o, d_h), 1) ThenBlock: { take_o = 1 }
                    }
                }
                a = 0
                b = 0
                c = 0
                IfCondition EqualTo(take_o, 1) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(oa, i1)
                    c = ArrayGet(hc, j)
                    i = i1
                    ao = Add(ao, 1)
                }
                IfCondition EqualTo(take_o, 0) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(hc, j)
                    c = ArrayGet(hc, j1)
                    j = j1
                    ah = Add(ah, 1)
                }
                IfCondition NotEqual(a, b) ThenBlock: {
                    IfCondition NotEqual(b, c) ThenBlock: {
                        IfCondition NotEqual(a, c) ThenBlock: {
                            ArraySet(pa, 0, ArrayGet(v_base, Multiply(a, 3)))
                            ArraySet(pa, 1, ArrayGet(v_base, Add(Multiply(a, 3), 1)))
                            ArraySet(pb, 0, ArrayGet(v_base, Multiply(b, 3)))
                            ArraySet(pb, 1, ArrayGet(v_base, Add(Multiply(b, 3), 1)))
                            ArraySet(pc, 0, ArrayGet(v_base, Multiply(c, 3)))
                            ArraySet(pc, 1, ArrayGet(v_base, Add(Multiply(c, 3), 1)))
                            o = CAD_Num.Orient2D(pa, pb, pc)
                            IfCondition EqualTo(o, Subtract(0, 1)) ThenBlock: {
                                tmpi = b
                                b = c
                                c = tmpi
                                o = 1
                            }
                            IfCondition EqualTo(o, 1) ThenBlock: {
                                tt = Multiply(tri, 3)
                                IfCondition EqualTo(flip, 0) ThenBlock: {
                                    ArraySet(i_base, tt, a)
                                    ArraySet(i_base, Add(tt, 1), b)
                                    ArraySet(i_base, Add(tt, 2), c)
                                }
                                IfCondition EqualTo(flip, 1) ThenBlock: {
                                    ArraySet(i_base, tt, a)
                                    ArraySet(i_base, Add(tt, 1), c)
                                    ArraySet(i_base, Add(tt, 2), b)
                                }
                                tri = Add(tri, 1)
                            }
                        }
                    }
                }
            }
            guard = Add(guard, 1)
        }
        ArraySet(opack, 2, tri)
        Deallocate(pa, 32)
        Deallocate(pb, 32)
        Deallocate(pc, 32)
        Deallocate(oa, 32)
        Deallocate(hc, 16384)
        ReturnValue(tri)
    }
}

// Zipper an outer ring (CCW) to a hole ring. Real spokes — not a
// degenerate keyhole. Each emit must sit in the annulus (centroid
// inside outer, outside hole) so a concave notch stays empty.
// pack: [nout, nh, flip, tri_count]  writes into i_base from tri_count.
Function.CAD_Tess.ZipperLoopsXY {
    Input: v_base: Address
    Input: i_base: Address
    Input: oidx: Address
    Input: hidx: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        nout = ArrayGet(pack_addr, 0)
        nh = ArrayGet(pack_addr, 1)
        flip = ArrayGet(pack_addr, 2)
        tri = ArrayGet(pack_addr, 3)
        IfCondition LessThan(nout, 3) ThenBlock: { ReturnValue(tri) }
        IfCondition LessThan(nh, 3) ThenBlock: { ReturnValue(tri) }
        oa = Allocate(16384)
        hc = Allocate(16384)
        j = 0
        WhileLoop LessThan(j, nout) {
            ArraySet(oa, j, ArrayGet(oidx, j))
            j = Add(j, 1)
        }
        j = 0
        WhileLoop LessThan(j, nh) {
            ArraySet(hc, j, ArrayGet(hidx, j))
            j = Add(j, 1)
        }
        // outer → CCW
        area = 0
        j = 0
        WhileLoop LessThan(j, nout) {
            jn = Add(j, 1)
            IfCondition EqualTo(jn, nout) ThenBlock: { jn = 0 }
            ia = ArrayGet(oa, j)
            ib = ArrayGet(oa, jn)
            area = Float_Add(area, Float_Sub(Float_Mul(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), Float_Mul(ArrayGet(v_base, Multiply(ib, 3)), ArrayGet(v_base, Add(Multiply(ia, 3), 1)))))
            j = Add(j, 1)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(area), 1) ThenBlock: {
            lo = 0
            hi = Subtract(nout, 1)
            WhileLoop LessThan(lo, hi) {
                tmpi = ArrayGet(oa, lo)
                ArraySet(oa, lo, ArrayGet(oa, hi))
                ArraySet(oa, hi, tmpi)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        // hole → CW
        harea = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            jn = Add(j, 1)
            IfCondition EqualTo(jn, nh) ThenBlock: { jn = 0 }
            ia = ArrayGet(hc, j)
            ib = ArrayGet(hc, jn)
            harea = Float_Add(harea, Float_Sub(Float_Mul(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Add(Multiply(ib, 3), 1))), Float_Mul(ArrayGet(v_base, Multiply(ib, 3)), ArrayGet(v_base, Add(Multiply(ia, 3), 1)))))
            j = Add(j, 1)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(harea), 0) ThenBlock: {
            lo = 0
            hi = Subtract(nh, 1)
            WhileLoop LessThan(lo, hi) {
                tmpi = ArrayGet(hc, lo)
                ArraySet(hc, lo, ArrayGet(hc, hi))
                ArraySet(hc, hi, tmpi)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        bi = 0
        bj = 0
        best = 0x7FF0000000000000
        i = 0
        WhileLoop LessThan(i, nout) {
            j = 0
            WhileLoop LessThan(j, nh) {
                ia = ArrayGet(oa, i)
                ib = ArrayGet(hc, j)
                dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                d2 = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                IfCondition EqualTo(Float_Le(d2, best), 1) ThenBlock: {
                    best = d2
                    bi = i
                    bj = j
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        three = 0x4008000000000000
        // hole centroid — a candidate that contains it spans the opening
        hcx = 0
        hcy = 0
        j = 0
        WhileLoop LessThan(j, nh) {
            ia = ArrayGet(hc, j)
            hcx = Float_Add(hcx, ArrayGet(v_base, Multiply(ia, 3)))
            hcy = Float_Add(hcy, ArrayGet(v_base, Add(Multiply(ia, 3), 1)))
            j = Add(j, 1)
        }
        hcx = Float_Div(hcx, Float_FromInt(nh))
        hcy = Float_Div(hcy, Float_FromInt(nh))
        pa = Allocate(32)
        pb = Allocate(32)
        pc = Allocate(32)
        tpack = Allocate(16)
        i = bi
        j = bj
        ao = 0
        ah = 0
        guard = 0
        maxg = Add(Multiply(Add(nout, nh), 2), 8)
        IfCondition GreaterThan(maxg, 4096) ThenBlock: { maxg = 4096 }
        WhileLoop LessThan(guard, maxg) {
            done = 0
            IfCondition EqualTo(ao, nout) ThenBlock: {
                IfCondition EqualTo(ah, nh) ThenBlock: { done = 1 }
            }
            IfCondition EqualTo(done, 0) ThenBlock: {
                i1 = Add(i, 1)
                IfCondition EqualTo(i1, nout) ThenBlock: { i1 = 0 }
                j1 = Add(j, 1)
                IfCondition EqualTo(j1, nh) ThenBlock: { j1 = 0 }
                // score both candidates: 2=valid annulus, 1=not-in-hole, 0=bad
                vo = 0
                vh = 0
                IfCondition LessThan(ao, nout) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(oa, i1)
                    c = ArrayGet(hc, j)
                    ArraySet(tpack, 0, a)
                    ArraySet(tpack, 1, b)
                    ArraySet(tpack, 2, c)
                    IfCondition EqualTo(CAD_Tess.PointInTriXY(hcx, hcy, v_base, tpack), 0) ThenBlock: {
                    mx = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Multiply(a, 3)), ArrayGet(v_base, Multiply(b, 3))), ArrayGet(v_base, Multiply(c, 3))), three)
                    my = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Add(Multiply(a, 3), 1)), ArrayGet(v_base, Add(Multiply(b, 3), 1))), ArrayGet(v_base, Add(Multiply(c, 3), 1))), three)
                    IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, hc, nh), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, oa, nout), 1) ThenBlock: { vo = 2 }
                        IfCondition EqualTo(vo, 0) ThenBlock: { vo = 1 }
                    }
                    }
                }
                wo = 0
                wh = 0
                IfCondition LessThan(ah, nh) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(hc, j)
                    c = ArrayGet(hc, j1)
                    ArraySet(tpack, 0, a)
                    ArraySet(tpack, 1, b)
                    ArraySet(tpack, 2, c)
                    IfCondition EqualTo(CAD_Tess.PointInTriXY(hcx, hcy, v_base, tpack), 0) ThenBlock: {
                    mx = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Multiply(a, 3)), ArrayGet(v_base, Multiply(b, 3))), ArrayGet(v_base, Multiply(c, 3))), three)
                    my = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Add(Multiply(a, 3), 1)), ArrayGet(v_base, Add(Multiply(b, 3), 1))), ArrayGet(v_base, Add(Multiply(c, 3), 1))), three)
                    IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, hc, nh), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, oa, nout), 1) ThenBlock: { wo = 2 }
                        IfCondition EqualTo(wo, 0) ThenBlock: { wo = 1 }
                    }
                    }
                }
                take_o = 0
                IfCondition EqualTo(ah, nh) ThenBlock: { take_o = 1 }
                IfCondition EqualTo(ao, nout) ThenBlock: { take_o = 0 }
                IfCondition LessThan(ao, nout) ThenBlock: {
                    IfCondition LessThan(ah, nh) ThenBlock: {
                        take_o = 0
                        IfCondition GreaterThan(vo, wo) ThenBlock: { take_o = 1 }
                        IfCondition EqualTo(vo, wo) ThenBlock: {
                            ia = ArrayGet(oa, i1)
                            ib = ArrayGet(hc, j)
                            dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                            dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                            d_o = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            ia = ArrayGet(oa, i)
                            ib = ArrayGet(hc, j1)
                            dx = Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), ArrayGet(v_base, Multiply(ib, 3)))
                            dy = Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), ArrayGet(v_base, Add(Multiply(ib, 3), 1)))
                            d_h = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
                            IfCondition EqualTo(Float_Le(d_o, d_h), 1) ThenBlock: { take_o = 1 }
                        }
                    }
                }
                a = 0
                b = 0
                c = 0
                IfCondition EqualTo(take_o, 1) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(oa, i1)
                    c = ArrayGet(hc, j)
                    i = i1
                    ao = Add(ao, 1)
                }
                IfCondition EqualTo(take_o, 0) ThenBlock: {
                    a = ArrayGet(oa, i)
                    b = ArrayGet(hc, j)
                    c = ArrayGet(hc, j1)
                    j = j1
                    ah = Add(ah, 1)
                }
                keep = 0
                IfCondition EqualTo(take_o, 1) ThenBlock: {
                    IfCondition GreaterThan(vo, 1) ThenBlock: { keep = 1 }
                }
                IfCondition EqualTo(take_o, 0) ThenBlock: {
                    IfCondition GreaterThan(wo, 1) ThenBlock: { keep = 1 }
                }
                IfCondition EqualTo(keep, 1) ThenBlock: {
                    IfCondition NotEqual(a, b) ThenBlock: {
                        IfCondition NotEqual(b, c) ThenBlock: {
                            IfCondition NotEqual(a, c) ThenBlock: {
                                ArraySet(pa, 0, ArrayGet(v_base, Multiply(a, 3)))
                                ArraySet(pa, 1, ArrayGet(v_base, Add(Multiply(a, 3), 1)))
                                ArraySet(pb, 0, ArrayGet(v_base, Multiply(b, 3)))
                                ArraySet(pb, 1, ArrayGet(v_base, Add(Multiply(b, 3), 1)))
                                ArraySet(pc, 0, ArrayGet(v_base, Multiply(c, 3)))
                                ArraySet(pc, 1, ArrayGet(v_base, Add(Multiply(c, 3), 1)))
                                o = CAD_Num.Orient2D(pa, pb, pc)
                                IfCondition EqualTo(o, Subtract(0, 1)) ThenBlock: {
                                    tmpi = b
                                    b = c
                                    c = tmpi
                                    o = 1
                                }
                                IfCondition EqualTo(o, 1) ThenBlock: {
                                    tt = Multiply(tri, 3)
                                    IfCondition EqualTo(flip, 0) ThenBlock: {
                                        ArraySet(i_base, tt, a)
                                        ArraySet(i_base, Add(tt, 1), b)
                                        ArraySet(i_base, Add(tt, 2), c)
                                    }
                                    IfCondition EqualTo(flip, 1) ThenBlock: {
                                        ArraySet(i_base, tt, a)
                                        ArraySet(i_base, Add(tt, 1), c)
                                        ArraySet(i_base, Add(tt, 2), b)
                                    }
                                    tri = Add(tri, 1)
                                }
                            }
                        }
                    }
                }
            }
            guard = Add(guard, 1)
        }
        ArraySet(pack_addr, 3, tri)
        Deallocate(tpack, 16)
        Deallocate(pa, 32)
        Deallocate(pb, 32)
        Deallocate(pc, 32)
        Deallocate(oa, 16384)
        Deallocate(hc, 16384)
        ReturnValue(tri)
    }
}

// Fill triangle minus a hole by fanning each polar sector
// (triangle vertex → next) onto the hole verts in that sector.
// Only keeps tris whose centroid lies in the original triangle
// (so a partition of ears does not overlap). pack: [nh, flip, ns]
Function.CAD_Tess.FanTriToHole {
    Input: v_base: Address
    Input: i_base: Address
    Input: tpack: Address
    Input: hidx: Address
    Input: pack_addr: Address
    Output: Integer
    Body: {
        nh = ArrayGet(pack_addr, 0)
        flip = ArrayGet(pack_addr, 1)
        ns = ArrayGet(pack_addr, 2)
        IfCondition LessThan(nh, 3) ThenBlock: { ReturnValue(ns) }
        t0 = ArrayGet(tpack, 0)
        t1 = ArrayGet(tpack, 1)
        t2 = ArrayGet(tpack, 2)
        hcx = 0
        hcy = 0
        k = 0
        WhileLoop LessThan(k, nh) {
            ia = ArrayGet(hidx, k)
            hcx = Float_Add(hcx, ArrayGet(v_base, Multiply(ia, 3)))
            hcy = Float_Add(hcy, ArrayGet(v_base, Add(Multiply(ia, 3), 1)))
            k = Add(k, 1)
        }
        hcx = Float_Div(hcx, Float_FromInt(nh))
        hcy = Float_Div(hcy, Float_FromInt(nh))
        ta = Allocate(32)
        aa = Allocate(32)
        ArraySet(ta, 0, t0)
        ArraySet(ta, 1, t1)
        ArraySet(ta, 2, t2)
        s = 0
        WhileLoop LessThan(s, 3) {
            ia = ArrayGet(ta, s)
            ArraySet(aa, s, CAD_Geom.Atan2(Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), hcy), Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), hcx)))
            s = Add(s, 1)
        }
        // sort triangle verts by angle
        s = 0
        WhileLoop LessThan(s, 2) {
            u = 0
            WhileLoop LessThan(u, 2) {
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(ArrayGet(aa, Add(u, 1)), ArrayGet(aa, u))), 1) ThenBlock: {
                    tmpi = ArrayGet(ta, u)
                    ArraySet(ta, u, ArrayGet(ta, Add(u, 1)))
                    ArraySet(ta, Add(u, 1), tmpi)
                    tmpi = ArrayGet(aa, u)
                    ArraySet(aa, u, ArrayGet(aa, Add(u, 1)))
                    ArraySet(aa, Add(u, 1), tmpi)
                }
                u = Add(u, 1)
            }
            s = Add(s, 1)
        }
        ha = Allocate(16384)
        ho = Allocate(16384)
        k = 0
        WhileLoop LessThan(k, nh) {
            ia = ArrayGet(hidx, k)
            ArraySet(ho, k, ia)
            ArraySet(ha, k, CAD_Geom.Atan2(Float_Sub(ArrayGet(v_base, Add(Multiply(ia, 3), 1)), hcy), Float_Sub(ArrayGet(v_base, Multiply(ia, 3)), hcx)))
            k = Add(k, 1)
        }
        // bubble-sort hole verts by angle
        changed = 1
        guard = 0
        WhileLoop EqualTo(changed, 1) {
            changed = 0
            IfCondition LessThan(guard, nh) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, Subtract(nh, 1)) {
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(ArrayGet(ha, Add(k, 1)), ArrayGet(ha, k))), 1) ThenBlock: {
                        tmpi = ArrayGet(ha, k)
                        ArraySet(ha, k, ArrayGet(ha, Add(k, 1)))
                        ArraySet(ha, Add(k, 1), tmpi)
                        tmpi = ArrayGet(ho, k)
                        ArraySet(ho, k, ArrayGet(ho, Add(k, 1)))
                        ArraySet(ho, Add(k, 1), tmpi)
                        changed = 1
                    }
                    k = Add(k, 1)
                }
            }
            guard = Add(guard, 1)
        }
        three = 0x4008000000000000
        orig = Allocate(16)
        ArraySet(orig, 0, t0)
        ArraySet(orig, 1, t1)
        ArraySet(orig, 2, t2)
        sec = 0
        WhileLoop LessThan(sec, 3) {
            i0 = ArrayGet(ta, sec)
            i1 = ArrayGet(ta, 0)
            IfCondition LessThan(sec, 2) ThenBlock: { i1 = ArrayGet(ta, Add(sec, 1)) }
            a0 = ArrayGet(aa, sec)
            a1 = ArrayGet(aa, 0)
            IfCondition LessThan(sec, 2) ThenBlock: { a1 = ArrayGet(aa, Add(sec, 1)) }
            span = CAD_Num.PosMod2Pi(Float_Sub(a1, a0))
            // sector hole verts, high angle first (CW along hole)
            secn = 0
            secv = Allocate(16384)
            k = Subtract(nh, 1)
            WhileLoop GreaterEqual(k, 0) {
                dh = CAD_Num.PosMod2Pi(Float_Sub(ArrayGet(ha, k), a0))
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(dh, span)), 1) ThenBlock: {
                    ArraySet(secv, secn, ArrayGet(ho, k))
                    secn = Add(secn, 1)
                }
                k = Subtract(k, 1)
            }
            IfCondition EqualTo(secn, 0) ThenBlock: {
                // no hole vert in sector — skip (adjacent sectors own the rim)
            }
            IfCondition GreaterThan(secn, 0) ThenBlock: {
                // (i0, i1, secv[0]) then (i0, secv[p], secv[p+1])
                a = i0
                b = i1
                c = ArrayGet(secv, 0)
                mx = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Multiply(a, 3)), ArrayGet(v_base, Multiply(b, 3))), ArrayGet(v_base, Multiply(c, 3))), three)
                my = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Add(Multiply(a, 3), 1)), ArrayGet(v_base, Add(Multiply(b, 3), 1))), ArrayGet(v_base, Add(Multiply(c, 3), 1))), three)
                IfCondition EqualTo(CAD_Tess.PointInTriXY(mx, my, v_base, orig), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, hidx, nh), 0) ThenBlock: {
                        tt = Multiply(ns, 3)
                        IfCondition EqualTo(flip, 0) ThenBlock: {
                            ArraySet(i_base, tt, a)
                            ArraySet(i_base, Add(tt, 1), b)
                            ArraySet(i_base, Add(tt, 2), c)
                        }
                        IfCondition EqualTo(flip, 1) ThenBlock: {
                            ArraySet(i_base, tt, a)
                            ArraySet(i_base, Add(tt, 1), c)
                            ArraySet(i_base, Add(tt, 2), b)
                        }
                        ns = Add(ns, 1)
                    }
                }
                p = 0
                WhileLoop LessThan(p, Subtract(secn, 1)) {
                    a = i0
                    b = ArrayGet(secv, p)
                    c = ArrayGet(secv, Add(p, 1))
                    mx = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Multiply(a, 3)), ArrayGet(v_base, Multiply(b, 3))), ArrayGet(v_base, Multiply(c, 3))), three)
                    my = Float_Div(Float_Add(Float_Add(ArrayGet(v_base, Add(Multiply(a, 3), 1)), ArrayGet(v_base, Add(Multiply(b, 3), 1))), ArrayGet(v_base, Add(Multiply(c, 3), 1))), three)
                    IfCondition EqualTo(CAD_Tess.PointInTriXY(mx, my, v_base, orig), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Tess.PointInIdxPoly(mx, my, v_base, hidx, nh), 0) ThenBlock: {
                            tt = Multiply(ns, 3)
                            IfCondition EqualTo(flip, 0) ThenBlock: {
                                ArraySet(i_base, tt, a)
                                ArraySet(i_base, Add(tt, 1), b)
                                ArraySet(i_base, Add(tt, 2), c)
                            }
                            IfCondition EqualTo(flip, 1) ThenBlock: {
                                ArraySet(i_base, tt, a)
                                ArraySet(i_base, Add(tt, 1), c)
                                ArraySet(i_base, Add(tt, 2), b)
                            }
                            ns = Add(ns, 1)
                        }
                    }
                    p = Add(p, 1)
                }
            }
            Deallocate(secv, 16384)
            sec = Add(sec, 1)
        }
        ArraySet(pack_addr, 2, ns)
        Deallocate(orig, 16)
        Deallocate(ha, 16384)
        Deallocate(ho, 16384)
        Deallocate(ta, 32)
        Deallocate(aa, 32)
        ReturnValue(ns)
    }
}

// Subdivide a triangle against a hole until each child is clearly
// inside (drop) or outside (keep). Adds Steiner midpoints to v_base.
// tpack: [i0,i1,i2]   opack: [nh, ns, vcount, unused]
// Writes kept tris to scratch[ns...] and returns new ns.
Function.CAD_Tess.SubdivPunchTri {
    Input: v_base: Address
    Input: hidx: Address
    Input: scratch: Address
    Input: tpack: Address
    Input: opack: Address
    Output: Integer
    Body: {
        nh = ArrayGet(opack, 0)
        ns = ArrayGet(opack, 1)
        vc = ArrayGet(opack, 2)
        q = ArrayGet(opack, 3)
        i0 = ArrayGet(tpack, 0)
        i1 = ArrayGet(tpack, 1)
        i2 = ArrayGet(tpack, 2)
        ArraySet(q, 0, i0)
        ArraySet(q, 1, i1)
        ArraySet(q, 2, i2)
        ArraySet(q, 3, 0)
        qn = 1
        qi = 0
        // hole AABB from first vert, then expand
        hk0 = ArrayGet(hidx, 0)
        hminx = ArrayGet(v_base, Multiply(hk0, 3))
        hminy = ArrayGet(v_base, Add(Multiply(hk0, 3), 1))
        hmaxx = hminx
        hmaxy = hminy
        k = 1
        WhileLoop LessThan(k, nh) {
            hk = ArrayGet(hidx, k)
            hx = ArrayGet(v_base, Multiply(hk, 3))
            hy = ArrayGet(v_base, Add(Multiply(hk, 3), 1))
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hx, hminx)), 1) ThenBlock: { hminx = hx }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hy, hminy)), 1) ThenBlock: { hminy = hy }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hmaxx, hx)), 1) ThenBlock: { hmaxx = hx }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hmaxy, hy)), 1) ThenBlock: { hmaxy = hy }
            k = Add(k, 1)
        }
        nsep = 0
        half = 0x3FE0000000000000
        three = 0x4008000000000000
        maxq = 400
        WhileLoop LessThan(qi, qn) {
            qb = Multiply(qi, 4)
            a = ArrayGet(q, qb)
            b = ArrayGet(q, Add(qb, 1))
            c = ArrayGet(q, Add(qb, 2))
            depth = ArrayGet(q, Add(qb, 3))
            xa = ArrayGet(v_base, Multiply(a, 3))
            ya = ArrayGet(v_base, Add(Multiply(a, 3), 1))
            xb = ArrayGet(v_base, Multiply(b, 3))
            yb = ArrayGet(v_base, Add(Multiply(b, 3), 1))
            xc = ArrayGet(v_base, Multiply(c, 3))
            yc = ArrayGet(v_base, Add(Multiply(c, 3), 1))
            // tri AABB vs hole AABB — far plate corners must stay
            tminx = xa
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(xb, tminx)), 1) ThenBlock: { tminx = xb }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(xc, tminx)), 1) ThenBlock: { tminx = xc }
            tmaxx = xa
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxx, xb)), 1) ThenBlock: { tmaxx = xb }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxx, xc)), 1) ThenBlock: { tmaxx = xc }
            tminy = ya
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(yb, tminy)), 1) ThenBlock: { tminy = yb }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(yc, tminy)), 1) ThenBlock: { tminy = yc }
            tmaxy = ya
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxy, yb)), 1) ThenBlock: { tmaxy = yb }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxy, yc)), 1) ThenBlock: { tmaxy = yc }
            sep = 0
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxx, hminx)), 1) ThenBlock: { sep = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hmaxx, tminx)), 1) ThenBlock: { sep = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(tmaxy, hminy)), 1) ThenBlock: { sep = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(hmaxy, tminy)), 1) ThenBlock: { sep = 1 }
            IfCondition EqualTo(sep, 1) ThenBlock: {
                nsep = Add(nsep, 1)
                ArraySet(scratch, Multiply(ns, 3), a)
                ArraySet(scratch, Add(Multiply(ns, 3), 1), b)
                ArraySet(scratch, Add(Multiply(ns, 3), 2), c)
                ns = Add(ns, 1)
            }
            IfCondition EqualTo(sep, 0) ThenBlock: {
            ina = CAD_Tess.PointInIdxPoly(xa, ya, v_base, hidx, nh)
            inb = CAD_Tess.PointInIdxPoly(xb, yb, v_base, hidx, nh)
            inc = CAD_Tess.PointInIdxPoly(xc, yc, v_base, hidx, nh)
            allin = 0
            IfCondition EqualTo(ina, 1) ThenBlock: {
                IfCondition EqualTo(inb, 1) ThenBlock: {
                    IfCondition EqualTo(inc, 1) ThenBlock: { allin = 1 }
                }
            }
            mx = Float_Div(Float_Add(Float_Add(xa, xb), xc), three)
            my = Float_Div(Float_Add(Float_Add(ya, yb), yc), three)
            cin = CAD_Tess.PointInIdxPoly(mx, my, v_base, hidx, nh)
            // hole vertex inside this tri?
            ArraySet(tpack, 0, a)
            ArraySet(tpack, 1, b)
            ArraySet(tpack, 2, c)
            hin = 0
            k = 0
            step = 1
            IfCondition GreaterThan(nh, 8) ThenBlock: { step = Divide(nh, 8) }
            WhileLoop LessThan(k, nh) {
                IfCondition EqualTo(hin, 0) ThenBlock: {
                    hk = ArrayGet(hidx, k)
                    IfCondition EqualTo(CAD_Tess.PointInTriXY(ArrayGet(v_base, Multiply(hk, 3)), ArrayGet(v_base, Add(Multiply(hk, 3), 1)), v_base, tpack), 1) ThenBlock: {
                        hin = 1
                    }
                }
                k = Add(k, step)
            }
            ov = cin
            IfCondition EqualTo(ina, 1) ThenBlock: { ov = 1 }
            IfCondition EqualTo(inb, 1) ThenBlock: { ov = 1 }
            IfCondition EqualTo(inc, 1) ThenBlock: { ov = 1 }
            IfCondition EqualTo(hin, 1) ThenBlock: { ov = 1 }
            IfCondition EqualTo(allin, 1) ThenBlock: { ov = 2 }
            IfCondition EqualTo(ov, 0) ThenBlock: {
                ArraySet(scratch, Multiply(ns, 3), a)
                ArraySet(scratch, Add(Multiply(ns, 3), 1), b)
                ArraySet(scratch, Add(Multiply(ns, 3), 2), c)
                ns = Add(ns, 1)
            }
            IfCondition EqualTo(ov, 1) ThenBlock: {
                split = 1
                IfCondition GreaterThan(depth, 4) ThenBlock: { split = 0 }
                IfCondition GreaterThan(Add(qn, 4), maxq) ThenBlock: { split = 0 }
                IfCondition EqualTo(split, 0) ThenBlock: {
                    // drop leftover overlap — those slivers poke into the hole
                }
                IfCondition EqualTo(split, 1) ThenBlock: {
                    za = ArrayGet(v_base, Add(Multiply(a, 3), 2))
                    m01 = vc
                    ArraySet(v_base, Multiply(m01, 3), Float_Mul(Float_Add(xa, xb), half))
                    ArraySet(v_base, Add(Multiply(m01, 3), 1), Float_Mul(Float_Add(ya, yb), half))
                    ArraySet(v_base, Add(Multiply(m01, 3), 2), za)
                    vc = Add(vc, 1)
                    m12 = vc
                    ArraySet(v_base, Multiply(m12, 3), Float_Mul(Float_Add(xb, xc), half))
                    ArraySet(v_base, Add(Multiply(m12, 3), 1), Float_Mul(Float_Add(yb, yc), half))
                    ArraySet(v_base, Add(Multiply(m12, 3), 2), za)
                    vc = Add(vc, 1)
                    m20 = vc
                    ArraySet(v_base, Multiply(m20, 3), Float_Mul(Float_Add(xc, xa), half))
                    ArraySet(v_base, Add(Multiply(m20, 3), 1), Float_Mul(Float_Add(yc, ya), half))
                    ArraySet(v_base, Add(Multiply(m20, 3), 2), za)
                    vc = Add(vc, 1)
                    nd = Add(depth, 1)
                    qb2 = Multiply(qn, 4)
                    ArraySet(q, qb2, a)
                    ArraySet(q, Add(qb2, 1), m01)
                    ArraySet(q, Add(qb2, 2), m20)
                    ArraySet(q, Add(qb2, 3), nd)
                    qn = Add(qn, 1)
                    qb2 = Multiply(qn, 4)
                    ArraySet(q, qb2, b)
                    ArraySet(q, Add(qb2, 1), m12)
                    ArraySet(q, Add(qb2, 2), m01)
                    ArraySet(q, Add(qb2, 3), nd)
                    qn = Add(qn, 1)
                    qb2 = Multiply(qn, 4)
                    ArraySet(q, qb2, c)
                    ArraySet(q, Add(qb2, 1), m20)
                    ArraySet(q, Add(qb2, 2), m12)
                    ArraySet(q, Add(qb2, 3), nd)
                    qn = Add(qn, 1)
                    qb2 = Multiply(qn, 4)
                    ArraySet(q, qb2, m01)
                    ArraySet(q, Add(qb2, 1), m12)
                    ArraySet(q, Add(qb2, 2), m20)
                    ArraySet(q, Add(qb2, 3), nd)
                    qn = Add(qn, 1)
                }
            }
            }
            qi = Add(qi, 1)
        }
        ArraySet(opack, 1, ns)
        ArraySet(opack, 2, vc)
        ReturnValue(ns)
    }
}

// Valid inner (hole) loop on this outer, or 0. Topology, not a vert-count guess.
