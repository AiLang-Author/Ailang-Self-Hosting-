// CAD.Topo.ChamferEmit — compiler EMIT for chamfer (same IR as fillet).
// D = host setback (mm). A = angle of the bevel from the host (deg).
// 45° on a 90° wall is equal setback. Meridians are lines, not arcs.
// LINE → plane strip. ARC → ruled cone (tess MeshRuledLoop, not torus).
// API stays Function.CAD_Topo.*
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.ChamferTanDeg {
    Input: deg: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.k = deg
        IfCondition LessThan(CAD_Topo_FComp.k, 1) ThenBlock: { CAD_Topo_FComp.k = 45 }
        IfCondition GreaterThan(CAD_Topo_FComp.k, 89) ThenBlock: { CAD_Topo_FComp.k = 89 }
        CAD_Topo_FCove.d12 = Float_Mul(Float_FromInt(CAD_Topo_FComp.k), 0x400921FB54442D18)
        CAD_Topo_FCove.d12 = Float_Div(CAD_Topo_FCove.d12, Float_FromInt(180))
        CAD_Topo_FCove.d13 = CAD_Geom.Sin(CAD_Topo_FCove.d12)
        CAD_Topo_FCove.d23 = CAD_Geom.Cos(CAD_Topo_FCove.d12)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.d23, 0), 1) ThenBlock: {
            ReturnValue(0x3FF0000000000000)
        }
        ReturnValue(Float_Div(CAD_Topo_FCove.d13, CAD_Topo_FCove.d23))
    }
}

Function.CAD_Topo.ChamferSolveVert {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.kind = CAD_Topo.FCoveGet(24, i)
        CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, i)
        CAD_Topo_FCove.n2x = 0
        CAD_Topo_FCove.n2y = 0
        CAD_Topo_FCove.n2z = 0
        IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
            IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.f2, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.n2x = ArrayGet(CAD_Topo_FCove.pl, 10)
            CAD_Topo_FCove.n2y = ArrayGet(CAD_Topo_FCove.pl, 11)
            CAD_Topo_FCove.n2z = ArrayGet(CAD_Topo_FCove.pl, 12)
        }
        IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.which, 1)
            CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.which, 2)
            CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.which, 3)
            CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 0), CAD_Topo_FCove.cx)
            CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 1), CAD_Topo_FCove.cy)
            CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 2), CAD_Topo_FCove.cz)
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveGet(36, i), 0) ThenBlock: {
                    CAD_Topo_FCove.n2x = Float_Sub(CAD_Topo_FCove.cx, CAD_Store.Read(CAD_Topo_FCove.v0, 0))
                    CAD_Topo_FCove.n2y = Float_Sub(CAD_Topo_FCove.cy, CAD_Store.Read(CAD_Topo_FCove.v0, 1))
                    CAD_Topo_FCove.n2z = Float_Sub(CAD_Topo_FCove.cz, CAD_Store.Read(CAD_Topo_FCove.v0, 2))
                }
            }
        }
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.aa = CAD_Topo_FCove.r
        CAD_Topo_FCove.bb = CAD_Topo_FCove.padh
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            CAD_Topo_FCove.aa = Float_Sub(0, CAD_Topo_FCove.aa)
            CAD_Topo_FCove.bb = Float_Sub(0, CAD_Topo_FCove.bb)
        }
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 0), Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 1), Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 2), Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.n2z)))
        CAD_Topo.FCoveSet(432, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 0), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n1x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 1), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n1y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 2), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n1z)))
        CAD_Topo.FCoveSet(276, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        IfCondition EqualTo(CAD_Topo.FCoveGet(432, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(276, i), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FCoveSet(288, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(432, i), CAD_Topo.FCoveGet(276, i)))
        IfCondition EqualTo(CAD_Topo.FCoveGet(288, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.ChamferMakeSeg {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.k = Add(i, 1)
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
        CAD_Topo_FCove.kind = CAD_Topo.FCoveGet(24, i)
        IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
            CAD_Topo.FCoveSet(312, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(432, i), CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k)))
            CAD_Topo.FCoveSet(324, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(276, i), CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k)))
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(432, i)
            CAD_Topo_FCove.ok1 = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k)
            CAD_Topo_FCove.hit = CAD_Topo.FCoveGet(276, i)
            ArraySet(CAD_Topo_FCove.pt, 0, CAD_Store.Read(CAD_Topo_FCove.ok, 0))
            ArraySet(CAD_Topo_FCove.pt, 1, CAD_Store.Read(CAD_Topo_FCove.ok, 1))
            ArraySet(CAD_Topo_FCove.pt, 2, CAD_Store.Read(CAD_Topo_FCove.ok, 2))
            ArraySet(CAD_Topo_FCove.p1b, 0, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok1, 0), CAD_Store.Read(CAD_Topo_FCove.ok, 0)))
            ArraySet(CAD_Topo_FCove.p1b, 1, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok1, 1), CAD_Store.Read(CAD_Topo_FCove.ok, 1)))
            ArraySet(CAD_Topo_FCove.p1b, 2, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok1, 2), CAD_Store.Read(CAD_Topo_FCove.ok, 2)))
            ArraySet(CAD_Topo_FCove.frame, 0, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.hit, 0), CAD_Store.Read(CAD_Topo_FCove.ok, 0)))
            ArraySet(CAD_Topo_FCove.frame, 1, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.hit, 1), CAD_Store.Read(CAD_Topo_FCove.ok, 1)))
            ArraySet(CAD_Topo_FCove.frame, 2, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.hit, 2), CAD_Store.Read(CAD_Topo_FCove.ok, 2)))
            CAD_Topo.FCoveSet(300, i, CAD_Geom.MakePlaneAxes(CAD_Topo_FCove.pt, CAD_Topo_FCove.p1b, CAD_Topo_FCove.frame))
            CAD_Topo.FCoveSet(348, i, CAD_Topo.FCoveGet(288, i))
        }
        IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.which, 1)
            CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.which, 2)
            CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.which, 3)
            CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_FCove.which, 10)
            CAD_Topo_FCove.orig = CAD_Topo_FCove.r
            IfCondition EqualTo(CAD_Topo.FCoveGet(36, i), 0) ThenBlock: { CAD_Topo_FCove.orig = Float_Sub(0, CAD_Topo_FCove.r) }
            CAD_Topo_FCove.ab = Float_Sub(CAD_Topo_FCove.aa, CAD_Topo_FCove.orig)
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.orig), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.ab), 1) ThenBlock: { ReturnValue(0) }
            }
            ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
            ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
            ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
            ArraySet(CAD_Topo_FCove.frame, 3, CAD_Store.Read(CAD_Topo_FCove.which, 4))
            ArraySet(CAD_Topo_FCove.frame, 4, CAD_Store.Read(CAD_Topo_FCove.which, 5))
            ArraySet(CAD_Topo_FCove.frame, 5, CAD_Store.Read(CAD_Topo_FCove.which, 6))
            ArraySet(CAD_Topo_FCove.frame, 6, CAD_Store.Read(CAD_Topo_FCove.which, 7))
            ArraySet(CAD_Topo_FCove.frame, 7, CAD_Store.Read(CAD_Topo_FCove.which, 8))
            ArraySet(CAD_Topo_FCove.frame, 8, CAD_Store.Read(CAD_Topo_FCove.which, 9))
            CAD_Topo_FCove.ln = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab)
            CAD_Topo.FCoveSet(312, i, CAD_Topo.FilletEmitArcRail(CAD_Topo.FCoveGet(432, i), CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k), CAD_Topo_FCove.ln, CAD_Topo_FCove.which, CAD_Topo_FCove.e, CAD_Topo.FCoveGet(12, i)))
            CAD_Topo_FCove.s = CAD_Topo_FCove.padh
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.s = Float_Sub(0, CAD_Topo_FCove.padh) }
            ArraySet(CAD_Topo_FCove.frame, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1x)))
            ArraySet(CAD_Topo_FCove.frame, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1y)))
            ArraySet(CAD_Topo_FCove.frame, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1z)))
            CAD_Topo_FCove.bb = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.aa)
            CAD_Topo.FCoveSet(324, i, CAD_Topo.FilletEmitArcRail(CAD_Topo.FCoveGet(276, i), CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k), CAD_Topo_FCove.bb, CAD_Topo_FCove.which, CAD_Topo_FCove.e, CAD_Topo.FCoveGet(12, i)))
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(432, i)
            CAD_Topo_FCove.hit = CAD_Topo.FCoveGet(276, i)
            ArraySet(CAD_Topo_FCove.pt, 0, CAD_Store.Read(CAD_Topo_FCove.ok, 0))
            ArraySet(CAD_Topo_FCove.pt, 1, CAD_Store.Read(CAD_Topo_FCove.ok, 1))
            ArraySet(CAD_Topo_FCove.pt, 2, CAD_Store.Read(CAD_Topo_FCove.ok, 2))
            ArraySet(CAD_Topo_FCove.p1b, 0, Float_Sub(CAD_Store.Read(CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k), 0), CAD_Store.Read(CAD_Topo_FCove.ok, 0)))
            ArraySet(CAD_Topo_FCove.p1b, 1, Float_Sub(CAD_Store.Read(CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k), 1), CAD_Store.Read(CAD_Topo_FCove.ok, 1)))
            ArraySet(CAD_Topo_FCove.p1b, 2, Float_Sub(CAD_Store.Read(CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k), 2), CAD_Store.Read(CAD_Topo_FCove.ok, 2)))
            ArraySet(CAD_Topo_FCove.frame, 0, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.hit, 0), CAD_Store.Read(CAD_Topo_FCove.ok, 0)))
            ArraySet(CAD_Topo_FCove.frame, 1, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.hit, 1), CAD_Store.Read(CAD_Topo_FCove.ok, 1)))
            ArraySet(CAD_Topo_FCove.frame, 2, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.hit, 2), CAD_Store.Read(CAD_Topo_FCove.ok, 2)))
            CAD_Topo.FCoveSet(300, i, CAD_Geom.MakePlaneAxes(CAD_Topo_FCove.pt, CAD_Topo_FCove.p1b, CAD_Topo_FCove.frame))
            CAD_Topo.FCoveSet(348, i, CAD_Topo.FCoveGet(288, i))
        }
        IfCondition EqualTo(CAD_Topo.FCoveGet(312, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(324, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(300, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.ChamferEmitChain {
    Input: solid_handle: Integer
    Input: dist_r: Integer
    Input: angle_deg: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIREnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CAD_Topo_FComp.n, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_State.fillet_reason = 0
        CAD_Topo_FCove.solid = solid_handle
        CAD_Topo_FCove.r = dist_r
        CAD_Topo_FCove.padh = CAD_Num.Mul(dist_r, CAD_Topo.ChamferTanDeg(angle_deg))
        CAD_Topo_FCove.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletEmitPickChain(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 21
            PrintMessage("chamfer IR emit no chain\n")
            ReturnValue(0)
        }
        PrintMessage("chamfer IR emit loop n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage(" D=")
        PrintNumber(Float_ToInt(dist_r))
        PrintMessage(" A=")
        PrintNumber(angle_deg)
        PrintMessage("\n")
        IfCondition EqualTo(CAD_Topo.RimOrder(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 22
            PrintMessage("chamfer IR emit order FAIL\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.FilletEmitBindFromIR(), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.RimFillHost(), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 23
                PrintMessage("chamfer IR emit host FAIL\n")
                ReturnValue(0)
            }
        }
        CAD_Topo.FilletEmitTagFromIR()
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.ChamferSolveVert(CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 24
                PrintMessage("chamfer IR emit vert FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.ChamferMakeSeg(CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 25
                PrintMessage("chamfer IR emit seg FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimSwap(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 26
            PrintMessage("chamfer IR emit swap FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveMakeJoinFace(CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 27
                PrintMessage("chamfer IR emit face FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        PrintMessage("chamfer IR emit ok n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        ReturnValue(solid_handle)
    }
}
