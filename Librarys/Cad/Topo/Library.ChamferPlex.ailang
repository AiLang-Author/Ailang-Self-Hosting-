// CAD.Topo.ChamferPlex — chamfer chain on its own plex ring.
// Fillet keeps ring 0 and ring 1 (type 1 line, type 2 arc). A chamfer
// node is type 7 and lives only on ring 2. Nothing here is inserted
// into FPlex.head. No FixedPool: a new pool would shift later slots.
// Straight edges commit from this ring. A closed chain with arcs does
// too: arc rails stay circles, and the bevel is a cylinder so the mesh
// rules the two arcs. A closed circle is the same bevel all the way
// around: two full circles and one seam. An open arc stays on the old path.
// Slots: 0 edge, 1 host, 2 wall, 3 start, 4 end, 5 kind,
// 6 near host, 7 near wall, 8 far host, 9 far wall, 10 host rail,
// 11 wall rail, 12 near mer, 13 far mer, 14 plane, 15 sew the far end.
// API stays Function.CAD_Topo.*
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Plex
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.ChamferRingLine {
    Output: Integer
    Body: {
        IfCondition LessThan(CAD_Topo_FCove.n, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition NotEqual(CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

// All-line chains, including one edge, already take the ring. A mixed
// line and arc chain takes it only when every end meets the next start,
// so the shared contacts are the miter and the arc is not left open.
Function.CAD_Topo.ChamferRingUse {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo.ChamferRingLine(), 1) ThenBlock: { ReturnValue(1) }
        IfCondition LessThan(CAD_Topo_FCove.n, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.i = 0
        CAD_Topo_FCove.hit1 = 1
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.kind = CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.kind, 1) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.kind, 2) ThenBlock: { ReturnValue(0) }
            }
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i)
            CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
            IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.v0) ThenBlock: {
                CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
            }
            CAD_Topo_FCove.k = Add(CAD_Topo_FCove.i, 1)
            IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
            IfCondition NotEqual(CAD_Topo_FCove.v1, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)) ThenBlock: {
                CAD_Topo_FCove.hit1 = 0
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(CAD_Topo_FCove.hit1)
    }
}

Function.CAD_Topo.ChamferRingAt {
    Input: head: Integer
    Input: idx: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.hd = head
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, idx) {
            CAD_Topo_FCove.hd = Plex.RingNext(CAD_Topo_FCove.hd, 2)
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ReturnValue(CAD_Topo_FCove.hd)
    }
}

// Old coedge origin is one end of the selected edge. That end picks
// the rail contact, so the swapped coedge keeps the loop direction.
Function.CAD_Topo.ChamferRingOrigin {
    Input: node: Integer
    Input: old_origin: Integer
    Input: near_slot: Integer
    Input: far_slot: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.hit = Plex.Get(node, near_slot)
        IfCondition EqualTo(old_origin, Plex.Get(node, 4)) ThenBlock: {
            CAD_Topo_FCove.hit = Plex.Get(node, far_slot)
        }
        IfCondition NotEqual(old_origin, Plex.Get(node, 3)) ThenBlock: {
            IfCondition NotEqual(old_origin, Plex.Get(node, 4)) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(CAD_Topo_FCove.hit)
    }
}

Function.CAD_Topo.ChamferRingSwap {
    Input: node: Integer
    Input: face_slot: Integer
    Input: rail_slot: Integer
    Input: near_slot: Integer
    Input: far_slot: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.f1 = Plex.Get(node, face_slot)
        CAD_Topo_FCove.e = Plex.Get(node, 0)
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f1, CAD_Topo_FCove.e)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
        CAD_Topo_FCove.which = CAD_Topo.ChamferRingOrigin(node, CAD_Topo_FCove.orig, near_slot, far_slot)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.e = Plex.Get(node, rail_slot)
        IfCondition EqualTo(CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo_FCove.e, CAD_Topo_FCove.which), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Far end of one straight edge. A closed chain shares the next edge's
// near contacts (miter on the host, host drop on the wall). An open
// end, including one selected edge, is offset with the same wall
// setback (aa, n2) and host setback (bb, n1).
Function.CAD_Topo.ChamferRingFar {
    Input: node: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.k = Add(CAD_Topo_FCove.i, 1)
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
        // Closed circle: the seam is both ends. The far contacts are the
        // near ones. A second meridian keeps the 4-cycle the mesher rules.
        // FaceGetPlane fails on the cylinder wall, so do not offset here.
        CAD_Topo_FCove.v1 = Plex.Get(node, 4)
        CAD_Topo_FCove.v0 = Plex.Get(node, 3)
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.v0) ThenBlock: {
            CAD_Topo_FCove.hit = Plex.Get(node, 6)
            Plex.Set(node, 8, CAD_Topo_FCove.hit)
            CAD_Topo_FCove.hit = Plex.Get(node, 7)
            Plex.Set(node, 9, CAD_Topo_FCove.hit)
            CAD_Topo_FCove.v0 = Plex.Get(node, 6)
            CAD_Topo_FCove.v1 = Plex.Get(node, 7)
            Plex.Set(node, 13, CAD_Topo.FCoveMakeLineE(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1))
            IfCondition EqualTo(Plex.Get(node, 8), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Plex.Get(node, 9), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Plex.Get(node, 13), 0) ThenBlock: { ReturnValue(0) }
            Plex.Set(node, 15, 0)
            ReturnValue(1)
        }
        CAD_Topo_FCove.v1 = Plex.Get(node, 4)
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_FCove.n, 1) ThenBlock: {
                Plex.Set(node, 8, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k))
                Plex.Set(node, 9, CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k))
                Plex.Set(node, 13, CAD_Topo.FCoveGet(288, CAD_Topo_FCove.k))
                Plex.Set(node, 15, 0)
                IfCondition EqualTo(Plex.Get(node, 8), 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Plex.Get(node, 9), 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Plex.Get(node, 13), 0) ThenBlock: { ReturnValue(0) }
                ReturnValue(1)
            }
        }
        CAD_Topo_FCove.f2 = Plex.Get(node, 2)
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.f2, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = ArrayGet(CAD_Topo_FCove.pl, 10)
        CAD_Topo_FCove.n2y = ArrayGet(CAD_Topo_FCove.pl, 11)
        CAD_Topo_FCove.n2z = ArrayGet(CAD_Topo_FCove.pl, 12)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1x = CAD_Topo_FCove.n3x
        CAD_Topo_FCove.n1y = CAD_Topo_FCove.n3y
        CAD_Topo_FCove.n1z = CAD_Topo_FCove.n3z
        CAD_Topo_FCove.aa = CAD_Topo_FCove.r
        CAD_Topo_FCove.bb = CAD_Topo_FCove.padh
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            CAD_Topo_FCove.aa = Float_Sub(0, CAD_Topo_FCove.aa)
            CAD_Topo_FCove.bb = Float_Sub(0, CAD_Topo_FCove.bb)
        }
        CAD_Topo_FCove.v1 = Plex.Get(node, 4)
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 0), Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 1), Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 2), Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.n2z)))
        Plex.Set(node, 8, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 0), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n1x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 1), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n1y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 2), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n1z)))
        Plex.Set(node, 9, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        IfCondition EqualTo(Plex.Get(node, 8), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Plex.Get(node, 9), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.v0 = Plex.Get(node, 8)
        CAD_Topo_FCove.v1 = Plex.Get(node, 9)
        Plex.Set(node, 13, CAD_Topo.FCoveMakeLineE(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1))
        IfCondition EqualTo(Plex.Get(node, 13), 0) ThenBlock: { ReturnValue(0) }
        Plex.Set(node, 15, 1)
        ReturnValue(1)
    }
}

// Arc bevel. Host circle is the sketch arc grown or shrunk by D. Wall
// circle keeps that radius and drops by padh along the host normal.
// The face is a cylinder so a 4-cycle rules the two arcs. A plane here
// is the triangle fan.
Function.CAD_Topo.ChamferRingArc {
    Input: node: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.ok = node
        CAD_Topo_FCove.e = Plex.Get(CAD_Topo_FCove.ok, 0)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_FCove.which, 10)
        CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.which, 1)
        CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.which, 2)
        CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.which, 3)
        CAD_Topo_FCove.orig = CAD_Topo_FCove.r
        IfCondition EqualTo(CAD_Topo.FCoveGet(36, CAD_Topo_FCove.i), 0) ThenBlock: {
            CAD_Topo_FCove.orig = Float_Sub(0, CAD_Topo_FCove.r)
        }
        CAD_Topo_FCove.ab = Float_Sub(CAD_Topo_FCove.aa, CAD_Topo_FCove.orig)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.orig), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.ab), 1) ThenBlock: { ReturnValue(0) }
        }
        CAD_Topo_FCove.s = CAD_Topo_FCove.aa
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Store.Read(CAD_Topo_FCove.which, 4))
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Store.Read(CAD_Topo_FCove.which, 5))
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Store.Read(CAD_Topo_FCove.which, 6))
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Store.Read(CAD_Topo_FCove.which, 7))
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Store.Read(CAD_Topo_FCove.which, 8))
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Store.Read(CAD_Topo_FCove.which, 9))
        CAD_Topo_FCove.ln = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab)
        CAD_Topo_FCove.v0 = Plex.Get(CAD_Topo_FCove.ok, 6)
        CAD_Topo_FCove.v1 = Plex.Get(CAD_Topo_FCove.ok, 8)
        CAD_Topo_FCove.k = Plex.Get(CAD_Topo_FCove.ok, 3)
        CAD_Topo_FCove.ln = CAD_Topo.FilletEmitArcRail(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1, CAD_Topo_FCove.ln, CAD_Topo_FCove.which, CAD_Topo_FCove.e, CAD_Topo_FCove.k)
        IfCondition EqualTo(CAD_Topo_FCove.ln, 0) ThenBlock: { ReturnValue(0) }
        Plex.Set(CAD_Topo_FCove.ok, 10, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.bb = CAD_Topo_FCove.padh
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            CAD_Topo_FCove.bb = Float_Sub(0, CAD_Topo_FCove.padh)
        }
        ArraySet(CAD_Topo_FCove.frame, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n3x)))
        ArraySet(CAD_Topo_FCove.frame, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n3y)))
        ArraySet(CAD_Topo_FCove.frame, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n3z)))
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Store.Read(CAD_Topo_FCove.which, 4))
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Store.Read(CAD_Topo_FCove.which, 5))
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Store.Read(CAD_Topo_FCove.which, 6))
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Store.Read(CAD_Topo_FCove.which, 7))
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Store.Read(CAD_Topo_FCove.which, 8))
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Store.Read(CAD_Topo_FCove.which, 9))
        CAD_Topo_FCove.ln = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.s)
        CAD_Topo_FCove.v0 = Plex.Get(CAD_Topo_FCove.ok, 7)
        CAD_Topo_FCove.v1 = Plex.Get(CAD_Topo_FCove.ok, 9)
        CAD_Topo_FCove.k = Plex.Get(CAD_Topo_FCove.ok, 3)
        CAD_Topo_FCove.ln = CAD_Topo.FilletEmitArcRail(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1, CAD_Topo_FCove.ln, CAD_Topo_FCove.which, CAD_Topo_FCove.e, CAD_Topo_FCove.k)
        IfCondition EqualTo(CAD_Topo_FCove.ln, 0) ThenBlock: { ReturnValue(0) }
        Plex.Set(CAD_Topo_FCove.ok, 11, CAD_Topo_FCove.ln)
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Store.Read(CAD_Topo_FCove.which, 4))
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Store.Read(CAD_Topo_FCove.which, 5))
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Store.Read(CAD_Topo_FCove.which, 6))
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Store.Read(CAD_Topo_FCove.which, 7))
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Store.Read(CAD_Topo_FCove.which, 8))
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Store.Read(CAD_Topo_FCove.which, 9))
        ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FCove.n3x)
        ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FCove.n3y)
        ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FCove.n3z)
        Plex.Set(CAD_Topo_FCove.ok, 14, CAD_Geom.MakeCylinderSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab))
        IfCondition EqualTo(Plex.Get(CAD_Topo_FCove.ok, 10), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Plex.Get(CAD_Topo_FCove.ok, 11), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Plex.Get(CAD_Topo_FCove.ok, 14), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.ChamferRingBuild {
    Output: Integer
    Body: {
        IfCondition EqualTo(Plex.Init(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CAD_Topo_FCove.n, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n3x = CAD_Topo_FCove.n1x
        CAD_Topo_FCove.n3y = CAD_Topo_FCove.n1y
        CAD_Topo_FCove.n3z = CAD_Topo_FCove.n1z
        CAD_Topo_FCove.i = 0
        CAD_Topo_FCove.hd = 0
        CAD_Topo_FCove.prv = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.ok = Plex.Alloc(7)
            IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: {
                PrintMessage("chamfer plex alloc\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i)
            IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 0)
            IfCondition EqualTo(CAD_Topo_FCove.which, CAD_Topo_FCove.v0) ThenBlock: {
                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 1)
            }
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo_FCove.which, CAD_Topo_FCove.v0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i), 2) ThenBlock: { ReturnValue(0) }
            }
            Plex.Set(CAD_Topo_FCove.ok, 0, CAD_Topo_FCove.e)
            Plex.Set(CAD_Topo_FCove.ok, 3, CAD_Topo_FCove.v0)
            Plex.Set(CAD_Topo_FCove.ok, 4, CAD_Topo_FCove.which)
            Plex.Set(CAD_Topo_FCove.ok, 5, CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i))
            CAD_Topo_FCove.f1 = CAD_Topo_FCove.host_f
            CAD_Topo_FCove.k = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
            IfCondition GreaterEqual(CAD_Topo_FCove.k, 0) ThenBlock: {
                CAD_Topo_FCove.which = CAD_Topo.FilletIRGet(CAD_Topo_FCove.k, 19)
                IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.f1 = CAD_Topo_FCove.which }
            }
            CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, CAD_Topo_FCove.i)
            IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { ReturnValue(0) }
            Plex.Set(CAD_Topo_FCove.ok, 1, CAD_Topo_FCove.f1)
            Plex.Set(CAD_Topo_FCove.ok, 2, CAD_Topo_FCove.f2)
            Plex.Set(CAD_Topo_FCove.ok, 6, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i))
            Plex.Set(CAD_Topo_FCove.ok, 7, CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i))
            Plex.Set(CAD_Topo_FCove.ok, 12, CAD_Topo.FCoveGet(288, CAD_Topo_FCove.i))
            IfCondition EqualTo(Plex.Get(CAD_Topo_FCove.ok, 6), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Plex.Get(CAD_Topo_FCove.ok, 7), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Plex.Get(CAD_Topo_FCove.ok, 12), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo.ChamferRingFar(CAD_Topo_FCove.ok), 0) ThenBlock: {
                PrintMessage("chamfer plex far\n")
                ReturnValue(0)
            }
            IfCondition EqualTo(CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i), 2) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.ChamferRingArc(CAD_Topo_FCove.ok), 0) ThenBlock: {
                    PrintMessage("chamfer plex arc\n")
                    ReturnValue(0)
                }
            }
            IfCondition NotEqual(CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i), 2) ThenBlock: {
            CAD_Topo_FCove.v0 = Plex.Get(CAD_Topo_FCove.ok, 6)
            CAD_Topo_FCove.v1 = Plex.Get(CAD_Topo_FCove.ok, 8)
            Plex.Set(CAD_Topo_FCove.ok, 10, CAD_Topo.FCoveMakeLineE(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1))
            CAD_Topo_FCove.v0 = Plex.Get(CAD_Topo_FCove.ok, 7)
            CAD_Topo_FCove.v1 = Plex.Get(CAD_Topo_FCove.ok, 9)
            Plex.Set(CAD_Topo_FCove.ok, 11, CAD_Topo.FCoveMakeLineE(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1))
            IfCondition EqualTo(Plex.Get(CAD_Topo_FCove.ok, 10), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Plex.Get(CAD_Topo_FCove.ok, 11), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.v0 = Plex.Get(CAD_Topo_FCove.ok, 6)
            CAD_Topo_FCove.v1 = Plex.Get(CAD_Topo_FCove.ok, 8)
            CAD_Topo_FCove.e = Plex.Get(CAD_Topo_FCove.ok, 7)
            ArraySet(CAD_Topo_FCove.pt, 0, CAD_Store.Read(CAD_Topo_FCove.v0, 0))
            ArraySet(CAD_Topo_FCove.pt, 1, CAD_Store.Read(CAD_Topo_FCove.v0, 1))
            ArraySet(CAD_Topo_FCove.pt, 2, CAD_Store.Read(CAD_Topo_FCove.v0, 2))
            ArraySet(CAD_Topo_FCove.p1b, 0, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0)))
            ArraySet(CAD_Topo_FCove.p1b, 1, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1)))
            ArraySet(CAD_Topo_FCove.p1b, 2, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2)))
            ArraySet(CAD_Topo_FCove.frame, 0, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0)))
            ArraySet(CAD_Topo_FCove.frame, 1, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1)))
            ArraySet(CAD_Topo_FCove.frame, 2, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.e, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2)))
            Plex.Set(CAD_Topo_FCove.ok, 14, CAD_Geom.MakePlaneAxes(CAD_Topo_FCove.pt, CAD_Topo_FCove.p1b, CAD_Topo_FCove.frame))
            IfCondition EqualTo(Plex.Get(CAD_Topo_FCove.ok, 14), 0) ThenBlock: {
                PrintMessage("chamfer plex plane\n")
                ReturnValue(0)
            }
            }
            Plex.RingSingleton(CAD_Topo_FCove.ok, 2)
            IfCondition EqualTo(CAD_Topo_FCove.i, 0) ThenBlock: { CAD_Topo_FCove.hd = CAD_Topo_FCove.ok }
            IfCondition NotEqual(CAD_Topo_FCove.i, 0) ThenBlock: {
                IfCondition EqualTo(Plex.RingInsertAfter(CAD_Topo_FCove.prv, CAD_Topo_FCove.ok, 2), 0) ThenBlock: { ReturnValue(0) }
            }
            CAD_Topo_FCove.prv = CAD_Topo_FCove.ok
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(CAD_Topo_FCove.hd)
    }
}

// 1 when edge is a straight chamfer still waiting on ring 2. Fillet
// nodes are type 1 or 2, so a fillet sew does not take this branch.
Function.CAD_Topo.ChamferRingSkipEdge {
    Input: edge: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Plex_State.initialized, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(edge, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.s = 1
        WhileLoop LessThan(CAD_Topo_FCove.s, Add(Plex_State.count, 1)) {
            IfCondition EqualTo(Plex.Type(CAD_Topo_FCove.s), 7) ThenBlock: {
                IfCondition NotEqual(Plex.RingNext(CAD_Topo_FCove.s, 2), 0) ThenBlock: {
                    IfCondition EqualTo(Plex.Get(CAD_Topo_FCove.s, 0), edge) ThenBlock: { ReturnValue(1) }
                }
            }
            CAD_Topo_FCove.s = Add(CAD_Topo_FCove.s, 1)
        }
        ReturnValue(0)
    }
}

// Move LINE ends on this face from old_v to new_v. Skip the new rail
// and any other selected chamfer edge. Those still carry the corner
// the next swap has to recognize. Does not call FaceRetargetVert.
Function.CAD_Topo.ChamferRingRetarget {
    Input: face_h: Integer
    Input: old_v: Integer
    Input: new_v: Integer
    Input: skip_edge: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_v, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.wb = old_v
        CAD_Topo_FCove.ok1 = new_v
        CAD_Topo_FCove.ab = skip_edge
        CAD_Topo_FCove.lp = CAD_Store.Read(face_h, 1)
        CAD_Topo_FCove.j = 0
        WhileLoop NotEqual(CAD_Topo_FCove.lp, 0) {
            IfCondition GreaterThan(CAD_Topo_FCove.j, 8) ThenBlock: { CAD_Topo_FCove.lp = 0 }
            IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                CAD_Topo_FCove.wa = CAD_Store.Read(CAD_Topo_FCove.lp, 2)
                CAD_Topo_FCove.hd = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
                CAD_Topo_FCove.ce = CAD_Topo_FCove.hd
                CAD_Topo_FCove.g = 0
                WhileLoop LessThan(CAD_Topo_FCove.g, 256) {
                    IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.g = 256 }
                    IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                        CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                        CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                        CAD_Topo_FCove.hit1 = 1
                        IfCondition EqualTo(CAD_Topo_FCove.orig, 0) ThenBlock: { CAD_Topo_FCove.hit1 = 0 }
                        IfCondition EqualTo(CAD_Topo_FCove.orig, CAD_Topo_FCove.ab) ThenBlock: { CAD_Topo_FCove.hit1 = 0 }
                        IfCondition EqualTo(CAD_Topo_FCove.hit1, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.ChamferRingSkipEdge(CAD_Topo_FCove.orig), 1) ThenBlock: { CAD_Topo_FCove.hit1 = 0 }
                        }
                        IfCondition EqualTo(CAD_Topo_FCove.hit1, 1) ThenBlock: {
                            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.orig, 2)
                            CAD_Topo_FCove.kind = 1
                            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                                CAD_Topo_FCove.kind = CAD_Store.Read(CAD_Topo_FCove.which, 0)
                            }
                            IfCondition NotEqual(CAD_Topo_FCove.kind, 1) ThenBlock: { CAD_Topo_FCove.hit1 = 0 }
                        }
                        IfCondition EqualTo(CAD_Topo_FCove.hit1, 1) ThenBlock: {
                            CAD_Topo_FCove.hit = 0
                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.orig, 0), CAD_Topo_FCove.wb) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.orig, 1), CAD_Topo_FCove.wb) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                            IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                                CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.orig, CAD_Topo_FCove.wb, CAD_Topo_FCove.ok1)
                            }
                        }
                        CAD_Topo_FCove.ce = CAD_Topo_FCove.nxt
                        IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 256 }
                    }
                    CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
                }
                CAD_Topo_FCove.lp = CAD_Topo_FCove.wa
            }
            CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.ChamferRingFace {
    Input: node: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.e = Plex.Get(node, 10)
        CAD_Topo_FCove.v0 = Plex.Get(node, 6)
        ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.e, CAD_Topo_FCove.v0))
        CAD_Topo_FCove.e = Plex.Get(node, 13)
        CAD_Topo_FCove.v0 = Plex.Get(node, 8)
        ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.e, CAD_Topo_FCove.v0))
        CAD_Topo_FCove.e = Plex.Get(node, 11)
        CAD_Topo_FCove.v0 = Plex.Get(node, 9)
        ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.e, CAD_Topo_FCove.v0))
        CAD_Topo_FCove.e = Plex.Get(node, 12)
        CAD_Topo_FCove.v0 = Plex.Get(node, 7)
        ArraySet(CAD_Topo_FCove.ring, 3, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.e, CAD_Topo_FCove.v0))
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 1), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 2), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 3), 0) ThenBlock: { ReturnValue(0) }
        // Full circles both sample the same way. The mesh then flips the
        // second rail. Opposite sense on the wall rail keeps the rulings
        // from crossing. An open arc has two vertices and stays as built.
        CAD_Topo_FCove.e = Plex.Get(node, 11)
        IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
            CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
            CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
            IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1) ThenBlock: {
                CAD_Store.Write(ArrayGet(CAD_Topo_FCove.ring, 2), 6, 0)
            }
        }
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 4, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.f1 = CAD_Topo.MakeFace(Plex.Get(node, 14), CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.f1)
        ReturnValue(1)
    }
}

Function.CAD_Topo.ChamferRingSew {
    Input: node: Integer
    Input: vert_slot: Integer
    Input: host_slot: Integer
    Input: wall_slot: Integer
    Input: mer_slot: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.wa = CAD_Topo_FCove.host_f
        CAD_Topo_FCove.host_f = Plex.Get(node, 1)
        CAD_Topo_FCove.v0 = Plex.Get(node, vert_slot)
        CAD_Topo_FCove.wb = Plex.Get(node, host_slot)
        CAD_Topo_FCove.ok1 = Plex.Get(node, wall_slot)
        CAD_Topo_FCove.ab = Plex.Get(node, mer_slot)
        CAD_Topo_FCove.f2 = Plex.Get(node, 2)
        CAD_Topo.FilletSewOpenEnd(CAD_Topo_FCove.v0, CAD_Topo_FCove.wb, CAD_Topo_FCove.ok1, CAD_Topo_FCove.ab, CAD_Topo_FCove.f2)
        CAD_Topo_FCove.host_f = CAD_Topo_FCove.wa
        ReturnValue(1)
    }
}

Function.CAD_Topo.ChamferRingCommit {
    Input: head: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(head, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.lp1 = CAD_Topo.ChamferRingAt(head, CAD_Topo_FCove.i)
            IfCondition LessThan(CAD_Topo_FCove.lp1, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo.ChamferRingSwap(CAD_Topo_FCove.lp1, 1, 10, 6, 8), 0) ThenBlock: {
                PrintMessage("chamfer plex swap host\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.lp1 = CAD_Topo.ChamferRingAt(head, CAD_Topo_FCove.i)
            IfCondition EqualTo(CAD_Topo.ChamferRingSwap(CAD_Topo_FCove.lp1, 2, 11, 7, 9), 0) ThenBlock: {
                PrintMessage("chamfer plex swap wall\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.lp1 = CAD_Topo.ChamferRingAt(head, CAD_Topo_FCove.i)
            CAD_Topo_FCove.f1 = Plex.Get(CAD_Topo_FCove.lp1, 1)
            CAD_Topo_FCove.v0 = Plex.Get(CAD_Topo_FCove.lp1, 3)
            CAD_Topo_FCove.v1 = Plex.Get(CAD_Topo_FCove.lp1, 6)
            CAD_Topo_FCove.e = Plex.Get(CAD_Topo_FCove.lp1, 10)
            CAD_Topo.ChamferRingRetarget(CAD_Topo_FCove.f1, CAD_Topo_FCove.v0, CAD_Topo_FCove.v1, CAD_Topo_FCove.e)
            CAD_Topo_FCove.lp1 = CAD_Topo.ChamferRingAt(head, CAD_Topo_FCove.i)
            CAD_Topo_FCove.f1 = Plex.Get(CAD_Topo_FCove.lp1, 1)
            CAD_Topo_FCove.v0 = Plex.Get(CAD_Topo_FCove.lp1, 4)
            CAD_Topo_FCove.v1 = Plex.Get(CAD_Topo_FCove.lp1, 8)
            CAD_Topo_FCove.e = Plex.Get(CAD_Topo_FCove.lp1, 10)
            CAD_Topo.ChamferRingRetarget(CAD_Topo_FCove.f1, CAD_Topo_FCove.v0, CAD_Topo_FCove.v1, CAD_Topo_FCove.e)
            CAD_Topo_FCove.lp1 = CAD_Topo.ChamferRingAt(head, CAD_Topo_FCove.i)
            CAD_Topo_FCove.f2 = Plex.Get(CAD_Topo_FCove.lp1, 2)
            CAD_Topo_FCove.v0 = Plex.Get(CAD_Topo_FCove.lp1, 3)
            CAD_Topo_FCove.v1 = Plex.Get(CAD_Topo_FCove.lp1, 7)
            CAD_Topo_FCove.e = Plex.Get(CAD_Topo_FCove.lp1, 11)
            CAD_Topo.ChamferRingRetarget(CAD_Topo_FCove.f2, CAD_Topo_FCove.v0, CAD_Topo_FCove.v1, CAD_Topo_FCove.e)
            CAD_Topo_FCove.lp1 = CAD_Topo.ChamferRingAt(head, CAD_Topo_FCove.i)
            CAD_Topo_FCove.f2 = Plex.Get(CAD_Topo_FCove.lp1, 2)
            CAD_Topo_FCove.v0 = Plex.Get(CAD_Topo_FCove.lp1, 4)
            CAD_Topo_FCove.v1 = Plex.Get(CAD_Topo_FCove.lp1, 9)
            CAD_Topo_FCove.e = Plex.Get(CAD_Topo_FCove.lp1, 11)
            CAD_Topo.ChamferRingRetarget(CAD_Topo_FCove.f2, CAD_Topo_FCove.v0, CAD_Topo_FCove.v1, CAD_Topo_FCove.e)
            CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.i, 1)
            IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
            CAD_Topo_FCove.hit1 = Plex.Get(CAD_Topo.ChamferRingAt(head, CAD_Topo_FCove.k), 15)
            CAD_Topo_FCove.lp1 = CAD_Topo.ChamferRingAt(head, CAD_Topo_FCove.i)
            IfCondition EqualTo(CAD_Topo_FCove.hit1, 1) ThenBlock: {
                CAD_Topo.ChamferRingSew(CAD_Topo_FCove.lp1, 3, 6, 7, 12)
            }
            CAD_Topo_FCove.lp1 = CAD_Topo.ChamferRingAt(head, CAD_Topo_FCove.i)
            IfCondition EqualTo(Plex.Get(CAD_Topo_FCove.lp1, 15), 1) ThenBlock: {
                CAD_Topo.ChamferRingSew(CAD_Topo_FCove.lp1, 4, 8, 9, 13)
            }
            CAD_Topo_FCove.lp1 = CAD_Topo.ChamferRingAt(head, CAD_Topo_FCove.i)
            IfCondition EqualTo(CAD_Topo.ChamferRingFace(CAD_Topo_FCove.lp1), 0) ThenBlock: {
                PrintMessage("chamfer plex face\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}
