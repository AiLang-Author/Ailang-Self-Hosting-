// CAD.Topo.Core — split from Library.CAD_Topo.ailang
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

FixedPool.CAD_Topo_State {
    "vertex_count": Initialize=0
    "edge_count":   Initialize=0
    "coedge_count": Initialize=0
    "loop_count":   Initialize=0
    "face_count":   Initialize=0
    "shell_count":  Initialize=0
    "solid_count":  Initialize=0
    "digon_S":      Initialize=0, CanChange=True
    "digon_nreg":   Initialize=0, CanChange=True
    "digon_k":      Initialize=0, CanChange=True
    "digon_first_f": Initialize=0, CanChange=True
    "digon_prev_f": Initialize=0, CanChange=True
    "walk_skip":    Initialize=0, CanChange=True
    "walk_hd":      Initialize=0, CanChange=True
    "walk_ce":      Initialize=0, CanChange=True
    "walk_sh":      Initialize=0, CanChange=True
    "walk_face":    Initialize=0, CanChange=True
    "walk_lp":      Initialize=0, CanChange=True
    "rb_pt":        Initialize=0, CanChange=True
    "rb_ax":        Initialize=0, CanChange=True
    "rb_ay":        Initialize=0, CanChange=True
    "walk_v0":      Initialize=0, CanChange=True
    "walk_v1":      Initialize=0, CanChange=True
    "walk_v2":      Initialize=0, CanChange=True
}

// MakePolyPrism pin — nested MakeVertex/MakeEdge clobber locals → n collapses
// to ~4 and pad becomes a featureless box (padfail2.png primary n=56 but cube).
FixedPool.CAD_Topo_Prism {
    "n":   Initialize=0, CanChange=True
    "xy":  Initialize=0, CanChange=True
    "hz":  Initialize=0, CanChange=True
    "out": Initialize=0, CanChange=True
    "pt":  Initialize=0, CanChange=True
    "p1b": Initialize=0, CanChange=True
    "ax":  Initialize=0, CanChange=True
    "ay":  Initialize=0, CanChange=True
    "ring": Initialize=0, CanChange=True
    "vb":  Initialize=0, CanChange=True
    "vt":  Initialize=0, CanChange=True
    "eb":  Initialize=0, CanChange=True
    "et":  Initialize=0, CanChange=True
    "ev":  Initialize=0, CanChange=True
    "faces": Initialize=0, CanChange=True
    "i":     Initialize=0, CanChange=True
    "j":     Initialize=0, CanChange=True
    "nf":    Initialize=0, CanChange=True
}

Function.CAD_Topo.PrismBufs {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_Prism.pt, 0) ThenBlock: { CAD_Topo_Prism.pt = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_Prism.p1b, 0) ThenBlock: { CAD_Topo_Prism.p1b = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_Prism.ax, 0) ThenBlock: { CAD_Topo_Prism.ax = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_Prism.ay, 0) ThenBlock: { CAD_Topo_Prism.ay = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_Prism.ring, 0) ThenBlock: { CAD_Topo_Prism.ring = Allocate(16384) }
        IfCondition EqualTo(CAD_Topo_Prism.vb, 0) ThenBlock: { CAD_Topo_Prism.vb = Allocate(16384) }
        IfCondition EqualTo(CAD_Topo_Prism.vt, 0) ThenBlock: { CAD_Topo_Prism.vt = Allocate(16384) }
        IfCondition EqualTo(CAD_Topo_Prism.eb, 0) ThenBlock: { CAD_Topo_Prism.eb = Allocate(16384) }
        IfCondition EqualTo(CAD_Topo_Prism.et, 0) ThenBlock: { CAD_Topo_Prism.et = Allocate(16384) }
        IfCondition EqualTo(CAD_Topo_Prism.ev, 0) ThenBlock: { CAD_Topo_Prism.ev = Allocate(16384) }
        IfCondition EqualTo(CAD_Topo_Prism.faces, 0) ThenBlock: { CAD_Topo_Prism.faces = Allocate(32768) }
        IfCondition EqualTo(CAD_Topo_Prism.vb, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Topo_Prism.vt, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

