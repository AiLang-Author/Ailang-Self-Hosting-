// CAD.Topo.Digon — split from Library.CAD_Topo.ailang
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.Solve3Planes {
    Input: na: Address
    Input: nb: Address
    Input: nc: Address
    Input: b: Address
    Input: out: Address
    Output: Integer
    Body: {
        nax = ArrayGet(na, 0)
        nay = ArrayGet(na, 1)
        naz = ArrayGet(na, 2)
        nbx = ArrayGet(nb, 0)
        nby = ArrayGet(nb, 1)
        nbz = ArrayGet(nb, 2)
        ncx = ArrayGet(nc, 0)
        ncy = ArrayGet(nc, 1)
        ncz = ArrayGet(nc, 2)
        ba = ArrayGet(b, 0)
        bb = ArrayGet(b, 1)
        bc = ArrayGet(b, 2)
        cx = Float_Sub(Float_Mul(nby, ncz), Float_Mul(nbz, ncy))
        cy = Float_Sub(Float_Mul(nbz, ncx), Float_Mul(nbx, ncz))
        cz = Float_Sub(Float_Mul(nbx, ncy), Float_Mul(nby, ncx))
        det = Float_Add(Float_Add(Float_Mul(nax, cx), Float_Mul(nay, cy)), Float_Mul(naz, cz))
        IfCondition EqualTo(CAD_Num.IsZero(det, 0), 1) ThenBlock: { ReturnValue(-1) }
        // det_x = b · (Nb × Nc)
        cx = Float_Sub(Float_Mul(nby, ncz), Float_Mul(nbz, ncy))
        cy = Float_Sub(Float_Mul(nbz, ncx), Float_Mul(nbx, ncz))
        cz = Float_Sub(Float_Mul(nbx, ncy), Float_Mul(nby, ncx))
        dx = Float_Add(Float_Add(Float_Mul(ba, cx), Float_Mul(bb, cy)), Float_Mul(bc, cz))
        // det_y = Na · (b × Nc)
        tx = Float_Sub(Float_Mul(bb, ncz), Float_Mul(bc, ncy))
        ty = Float_Sub(Float_Mul(bc, ncx), Float_Mul(ba, ncz))
        tz = Float_Sub(Float_Mul(ba, ncy), Float_Mul(bb, ncx))
        dy = Float_Add(Float_Add(Float_Mul(nax, tx), Float_Mul(nay, ty)), Float_Mul(naz, tz))
        // det_z = Na · (Nb × b)
        tx = Float_Sub(Float_Mul(nby, bc), Float_Mul(nbz, bb))
        ty = Float_Sub(Float_Mul(nbz, ba), Float_Mul(nbx, bc))
        tz = Float_Sub(Float_Mul(nbx, bb), Float_Mul(nby, ba))
        dz = Float_Add(Float_Add(Float_Mul(nax, tx), Float_Mul(nay, ty)), Float_Mul(naz, tz))
        ArraySet(out, 0, Float_Div(dx, det))
        ArraySet(out, 1, Float_Div(dy, det))
        ArraySet(out, 2, Float_Div(dz, det))
        ReturnValue(0)
    }
}

// Solve n_a·x=ba, n_b·x=bb, n_c·x=bc for any angles:
//   x = (ba (nb×nc) + bb (nc×na) + bc (na×nb)) / (na·(nb×nc))
// Pin RHS on digon_S 433..435 — stack args die across IsZero/nested ops.
// Normals digon_S 410/411/412. Result digon_S 422,423,424. 0 ok, -1 singular.
Function.CAD_Topo.DigonSolve3 {
    Input: ba: Integer
    Input: bb: Integer
    Input: bc: Integer
    Output: Integer
    Body: {
        S = CAD_Topo_State.digon_S
        ArraySet(S, 433, ba)
        ArraySet(S, 434, bb)
        ArraySet(S, 435, bc)
        na = ArrayGet(S, 410)
        nb = ArrayGet(S, 411)
        nc = ArrayGet(S, 412)
        nax = ArrayGet(na, 0)
        nay = ArrayGet(na, 1)
        naz = ArrayGet(na, 2)
        nbx = ArrayGet(nb, 0)
        nby = ArrayGet(nb, 1)
        nbz = ArrayGet(nb, 2)
        ncx = ArrayGet(nc, 0)
        ncy = ArrayGet(nc, 1)
        ncz = ArrayGet(nc, 2)
        // nb × nc
        bcx = Float_Sub(Float_Mul(nby, ncz), Float_Mul(nbz, ncy))
        bcy = Float_Sub(Float_Mul(nbz, ncx), Float_Mul(nbx, ncz))
        bcz = Float_Sub(Float_Mul(nbx, ncy), Float_Mul(nby, ncx))
        // nc × na
        cax = Float_Sub(Float_Mul(ncy, naz), Float_Mul(ncz, nay))
        cay = Float_Sub(Float_Mul(ncz, nax), Float_Mul(ncx, naz))
        caz = Float_Sub(Float_Mul(ncx, nay), Float_Mul(ncy, nax))
        // na × nb
        abx = Float_Sub(Float_Mul(nay, nbz), Float_Mul(naz, nby))
        aby = Float_Sub(Float_Mul(naz, nbx), Float_Mul(nax, nbz))
        abz = Float_Sub(Float_Mul(nax, nby), Float_Mul(nay, nbx))
        det = Float_Add(Float_Add(Float_Mul(nax, bcx), Float_Mul(nay, bcy)), Float_Mul(naz, bcz))
        IfCondition EqualTo(CAD_Num.IsZero(det, 0), 1) ThenBlock: { ReturnValue(-1) }
        // reload everything after IsZero
        S = CAD_Topo_State.digon_S
        ba = ArrayGet(S, 433)
        bb = ArrayGet(S, 434)
        bc = ArrayGet(S, 435)
        na = ArrayGet(S, 410)
        nb = ArrayGet(S, 411)
        nc = ArrayGet(S, 412)
        nax = ArrayGet(na, 0)
        nay = ArrayGet(na, 1)
        naz = ArrayGet(na, 2)
        nbx = ArrayGet(nb, 0)
        nby = ArrayGet(nb, 1)
        nbz = ArrayGet(nb, 2)
        ncx = ArrayGet(nc, 0)
        ncy = ArrayGet(nc, 1)
        ncz = ArrayGet(nc, 2)
        bcx = Float_Sub(Float_Mul(nby, ncz), Float_Mul(nbz, ncy))
        bcy = Float_Sub(Float_Mul(nbz, ncx), Float_Mul(nbx, ncz))
        bcz = Float_Sub(Float_Mul(nbx, ncy), Float_Mul(nby, ncx))
        cax = Float_Sub(Float_Mul(ncy, naz), Float_Mul(ncz, nay))
        cay = Float_Sub(Float_Mul(ncz, nax), Float_Mul(ncx, naz))
        caz = Float_Sub(Float_Mul(ncx, nay), Float_Mul(ncy, nax))
        abx = Float_Sub(Float_Mul(nay, nbz), Float_Mul(naz, nby))
        aby = Float_Sub(Float_Mul(naz, nbx), Float_Mul(nax, nbz))
        abz = Float_Sub(Float_Mul(nax, nby), Float_Mul(nay, nbx))
        det = Float_Add(Float_Add(Float_Mul(nax, bcx), Float_Mul(nay, bcy)), Float_Mul(naz, bcz))
        rx = Float_Add(Float_Add(Float_Mul(ba, bcx), Float_Mul(bb, cax)), Float_Mul(bc, abx))
        ry = Float_Add(Float_Add(Float_Mul(ba, bcy), Float_Mul(bb, cay)), Float_Mul(bc, aby))
        rz = Float_Add(Float_Add(Float_Mul(ba, bcz), Float_Mul(bb, caz)), Float_Mul(bc, abz))
        S = CAD_Topo_State.digon_S
        ArraySet(S, 422, Float_Div(rx, det))
        ArraySet(S, 423, Float_Div(ry, det))
        ArraySet(S, 424, Float_Div(rz, det))
        ReturnValue(0)
    }
}

// Equal-R corner for ANY dihedral (not just 90°).
// Outward unit normals na,nb (walls) and nc (cap/third face) at vertex v.
// Offset planes: n·x = n·v - R  (into solid). Intersection:
//   P_ww: walls through v, cap offset  → on wall∩wall, inset from cap
//   P_cap: walls offset, cap through v → on cap, inset from walls
//   Cs:   all three offset          → rolling-ball center (dist R to all 3 faces)
// Writes digon_S out9 [414]: P_ww[0..2], P_cap[3..5], Cs[6..8].
// NO sphere face here — Cs is only the digon/cylinder spine corner point.
// Globe/sphere face only later when radii unequal or explicit ball-corner.
Function.CAD_Topo.DigonEqualRSolve {
    Input: ignored: Integer
    Output: Integer
    Body: {
        S = CAD_Topo_State.digon_S
        na = ArrayGet(S, 410)
        nb = ArrayGet(S, 411)
        nc = ArrayGet(S, 412)
        vv = ArrayGet(S, 413)
        radius_r = ArrayGet(S, 305)
        nax = ArrayGet(na, 0)
        nay = ArrayGet(na, 1)
        naz = ArrayGet(na, 2)
        nbx = ArrayGet(nb, 0)
        nby = ArrayGet(nb, 1)
        nbz = ArrayGet(nb, 2)
        ncx = ArrayGet(nc, 0)
        ncy = ArrayGet(nc, 1)
        ncz = ArrayGet(nc, 2)
        vx = ArrayGet(vv, 0)
        vy = ArrayGet(vv, 1)
        vz = ArrayGet(vv, 2)
        da = Float_Add(Float_Add(Float_Mul(nax, vx), Float_Mul(nay, vy)), Float_Mul(naz, vz))
        db = Float_Add(Float_Add(Float_Mul(nbx, vx), Float_Mul(nby, vy)), Float_Mul(nbz, vz))
        dc = Float_Add(Float_Add(Float_Mul(ncx, vx), Float_Mul(ncy, vy)), Float_Mul(ncz, vz))
        // pin plane constants + R (survive nested DigonSolve3)
        ArraySet(S, 436, da)
        ArraySet(S, 437, db)
        ArraySet(S, 438, dc)
        ArraySet(S, 439, radius_r)
        // Convex FILLET: offset −R into the solid (void > 180°).
        // Concave COVE: +R into the empty pocket (void ≤ 180°).
        // Flag lives at S[450] — S[431] is e_gc after DigonCylEdges.
        sgn = 0
        IfCondition EqualTo(ArrayGet(S, 450), 1) ThenBlock: {
            sgn = 1
        }
        dcs = Float_Sub(dc, radius_r)
        IfCondition EqualTo(sgn, 1) ThenBlock: { dcs = Float_Add(dc, radius_r) }
        IfCondition NotEqual(CAD_Topo.DigonSolve3(da, db, dcs), 0) ThenBlock: {
            ReturnValue(-1)
        }
        S = CAD_Topo_State.digon_S
        out9 = ArrayGet(S, 414)
        ArraySet(out9, 0, ArrayGet(S, 422))
        ArraySet(out9, 1, ArrayGet(S, 423))
        ArraySet(out9, 2, ArrayGet(S, 424))
        da = ArrayGet(S, 436)
        db = ArrayGet(S, 437)
        dc = ArrayGet(S, 438)
        radius_r = ArrayGet(S, 439)
        das = Float_Sub(da, radius_r)
        dbs = Float_Sub(db, radius_r)
        IfCondition EqualTo(ArrayGet(S, 450), 1) ThenBlock: {
            das = Float_Add(da, radius_r)
            dbs = Float_Add(db, radius_r)
        }
        IfCondition NotEqual(CAD_Topo.DigonSolve3(das, dbs, dc), 0) ThenBlock: {
            ReturnValue(-1)
        }
        S = CAD_Topo_State.digon_S
        out9 = ArrayGet(S, 414)
        ArraySet(out9, 3, ArrayGet(S, 422))
        ArraySet(out9, 4, ArrayGet(S, 423))
        ArraySet(out9, 5, ArrayGet(S, 424))
        da = ArrayGet(S, 436)
        db = ArrayGet(S, 437)
        dc = ArrayGet(S, 438)
        radius_r = ArrayGet(S, 439)
        das = Float_Sub(da, radius_r)
        dbs = Float_Sub(db, radius_r)
        dcs = Float_Sub(dc, radius_r)
        IfCondition EqualTo(ArrayGet(S, 450), 1) ThenBlock: {
            das = Float_Add(da, radius_r)
            dbs = Float_Add(db, radius_r)
            dcs = Float_Add(dc, radius_r)
        }
        IfCondition NotEqual(CAD_Topo.DigonSolve3(das, dbs, dcs), 0) ThenBlock: {
            ReturnValue(-1)
        }
        S = CAD_Topo_State.digon_S
        out9 = ArrayGet(S, 414)
        ArraySet(out9, 6, ArrayGet(S, 422))
        ArraySet(out9, 7, ArrayGet(S, 423))
        ArraySet(out9, 8, ArrayGet(S, 424))
        ReturnValue(0)
    }
}

// Legacy entry: copies args into digon pins if digon_S set; prefer DigonEqualRSolve.
Function.CAD_Topo.EqualRCornerPoints {
    Input: v_addr: Address
    Input: na_addr: Address
    Input: nb_addr: Address
    Input: nc_addr: Address
    Input: radius_r: Integer
    Input: out9_addr: Address
    Output: Integer
    Body: {
        // float-only path writing through digon_S scratch then copy to out9_addr
        S = CAD_Topo_State.digon_S
        IfCondition EqualTo(S, 0) ThenBlock: { ReturnValue(-1) }
        vv = ArrayGet(S, 413)
        na = ArrayGet(S, 410)
        nb = ArrayGet(S, 411)
        nc = ArrayGet(S, 412)
        ArraySet(vv, 0, ArrayGet(v_addr, 0))
        ArraySet(vv, 1, ArrayGet(v_addr, 1))
        ArraySet(vv, 2, ArrayGet(v_addr, 2))
        ArraySet(na, 0, ArrayGet(na_addr, 0))
        ArraySet(na, 1, ArrayGet(na_addr, 1))
        ArraySet(na, 2, ArrayGet(na_addr, 2))
        ArraySet(nb, 0, ArrayGet(nb_addr, 0))
        ArraySet(nb, 1, ArrayGet(nb_addr, 1))
        ArraySet(nb, 2, ArrayGet(nb_addr, 2))
        ArraySet(nc, 0, ArrayGet(nc_addr, 0))
        ArraySet(nc, 1, ArrayGet(nc_addr, 1))
        ArraySet(nc, 2, ArrayGet(nc_addr, 2))
        ArraySet(S, 305, radius_r)
        IfCondition NotEqual(CAD_Topo.DigonEqualRSolve(0), 0) ThenBlock: { ReturnValue(-1) }
        S = CAD_Topo_State.digon_S
        out9 = ArrayGet(S, 414)
        ArraySet(out9_addr, 0, ArrayGet(out9, 0))
        ArraySet(out9_addr, 1, ArrayGet(out9, 1))
        ArraySet(out9_addr, 2, ArrayGet(out9, 2))
        ArraySet(out9_addr, 3, ArrayGet(out9, 3))
        ArraySet(out9_addr, 4, ArrayGet(out9, 4))
        ArraySet(out9_addr, 5, ArrayGet(out9, 5))
        ArraySet(out9_addr, 6, ArrayGet(out9, 6))
        ArraySet(out9_addr, 7, ArrayGet(out9, 7))
        ArraySet(out9_addr, 8, ArrayGet(out9, 8))
        ReturnValue(0)
    }
}

// Ellipse digon P_ww↔P_cap on Steinmetz plane through Cs.
// Frame from actual points (not edge-dir n×s which put the ellipse horizontal):
//   X = unit(P_ww−Cs)  major  rmaj=|P_ww−Cs|
//   Y = unit(P_cap−Cs) minor  rmin=|P_cap−Cs|
//   Z = X×Y  (plane normal)
// d1/d2 unused (kept for call-site compatibility).
Function.CAD_Topo.MakeEqualRDigonEdge {
    Input: pww_h: Integer
    Input: pcap_h: Integer
    Input: cs_addr: Address
    Input: d1_addr: Address
    Input: d2_addr: Address
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pww_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pcap_h, 0) ThenBlock: { ReturnValue(0) }
        cx0 = ArrayGet(cs_addr, 0)
        cy0 = ArrayGet(cs_addr, 1)
        cz0 = ArrayGet(cs_addr, 2)
        // major axis toward P_ww
        sx = Float_Sub(CAD_Store.Read(pww_h, 0), cx0)
        sy = Float_Sub(CAD_Store.Read(pww_h, 1), cy0)
        sz = Float_Sub(CAD_Store.Read(pww_h, 2), cz0)
        rmaj = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(sx, sx), Float_Mul(sy, sy)), Float_Mul(sz, sz)))
        IfCondition EqualTo(CAD_Num.IsZero(rmaj, 0), 1) ThenBlock: { ReturnValue(0) }
        sx = Float_Div(sx, rmaj)
        sy = Float_Div(sy, rmaj)
        sz = Float_Div(sz, rmaj)
        // minor axis toward P_cap
        mx = Float_Sub(CAD_Store.Read(pcap_h, 0), cx0)
        my = Float_Sub(CAD_Store.Read(pcap_h, 1), cy0)
        mz = Float_Sub(CAD_Store.Read(pcap_h, 2), cz0)
        rmin = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(mx, mx), Float_Mul(my, my)), Float_Mul(mz, mz)))
        IfCondition EqualTo(CAD_Num.IsZero(rmin, 0), 1) ThenBlock: { ReturnValue(0) }
        mx = Float_Div(mx, rmin)
        my = Float_Div(my, rmin)
        mz = Float_Div(mz, rmin)
        // plane normal Z = X × Y
        nx = Float_Sub(Float_Mul(sy, mz), Float_Mul(sz, my))
        ny = Float_Sub(Float_Mul(sz, mx), Float_Mul(sx, mz))
        nz = Float_Sub(Float_Mul(sx, my), Float_Mul(sy, mx))
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 1) ThenBlock: { ReturnValue(0) }
        // MakeEllipse frame layout: O(0..2) X(3..5) Y(6..8) — same as MakeCircle
        // CAD_Geom.MakeEllipse reads O + Xdir + Ydir (not Z). Store X=major, Y=minor.
        ArraySet(cs_addr, 3, sx)
        ArraySet(cs_addr, 4, sy)
        ArraySet(cs_addr, 5, sz)
        ArraySet(cs_addr, 6, mx)
        ArraySet(cs_addr, 7, my)
        ArraySet(cs_addr, 8, mz)
        // Steinmetz ellipse through BOTH contacts. A circle of radius R at
        // Cs misses P_ww (|P_ww−Cs|=R√2 on a 90° corner) so the first
        // sample was a horizontal jog at z+R — the shelf in the cove.
        // Zip of these ellipses along the edge is the rolling-ball
        // quarter-cylinder; the ellipse itself is only the corner seam.
        S = CAD_Topo_State.digon_S
        ArraySet(S, 434, pww_h)
        ArraySet(S, 435, pcap_h)
        ArraySet(S, 436, rmaj)
        ArraySet(S, 437, rmin)
        ell = CAD_Geom.MakeEllipse(cs_addr, ArrayGet(S, 436), ArrayGet(S, 437))
        S = CAD_Topo_State.digon_S
        ArraySet(S, 436, ell)
        IfCondition EqualTo(ArrayGet(S, 436), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Topo.MakeMinorArcEdge(ArrayGet(S, 434), ArrayGet(S, 435), ArrayGet(S, 436)))
    }
}

// Corner k: equal-R digon points for ANY wall angles (31°, 120°, …).
// Policy: equal R on both edges → digon (cylinders + ellipse), NOT a sphere face.
// Sphere/"globe" corner only when radii differ or caller requests ball-corner later.
// Normals oriented outward via cycle centroid; nc flipped if needed so offset goes into solid.
Function.CAD_Topo.DigonCornerAtK {
    Input: ignored: Integer
    Output: Integer
    Body: {
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        n_edges = ArrayGet(S, 304)
        vv = ArrayGet(S, 413)
        na = ArrayGet(S, 410)
        nb = ArrayGet(S, 411)
        nc = ArrayGet(S, 412)
        vh = ArrayGet(S, Add(80, k))
        ArraySet(vv, 0, CAD_Store.Read(vh, 0))
        ArraySet(vv, 1, CAD_Store.Read(vh, 1))
        ArraySet(vv, 2, CAD_Store.Read(vh, 2))
        // cycle vertex sum for outward test: ox = n*v - sum
        cx = 0
        cy = 0
        cz = 0
        i = 0
        WhileLoop LessThan(i, n_edges) {
            vh2 = ArrayGet(S, Add(80, i))
            cx = Float_Add(cx, CAD_Store.Read(vh2, 0))
            cy = Float_Add(cy, CAD_Store.Read(vh2, 1))
            cz = Float_Add(cz, CAD_Store.Read(vh2, 2))
            i = Add(i, 1)
        }
        ox = 0
        oy = 0
        oz = 0
        i = 0
        WhileLoop LessThan(i, n_edges) {
            ox = Float_Add(ox, ArrayGet(vv, 0))
            oy = Float_Add(oy, ArrayGet(vv, 1))
            oz = Float_Add(oz, ArrayGet(vv, 2))
            i = Add(i, 1)
        }
        ox = Float_Sub(ox, cx)
        oy = Float_Sub(oy, cy)
        oz = Float_Sub(oz, cz)
        ip = Subtract(k, 1)
        IfCondition LessThan(ip, 0) ThenBlock: { ip = Subtract(n_edges, 1) }
        ep = ArrayGet(S, Add(64, ip))
        ec = ArrayGet(S, Add(64, k))
        ArraySet(na, 0, ArrayGet(S, Add(96, ep)))
        ArraySet(na, 1, ArrayGet(S, Add(112, ep)))
        ArraySet(na, 2, ArrayGet(S, Add(128, ep)))
        ArraySet(nb, 0, ArrayGet(S, Add(96, ec)))
        ArraySet(nb, 1, ArrayGet(S, Add(112, ec)))
        ArraySet(nb, 2, ArrayGet(S, Add(128, ec)))
        // walls: flip if n · (v−centroid) ≤ 0 (inward)
        da = Float_Add(Float_Add(Float_Mul(ArrayGet(na, 0), ox), Float_Mul(ArrayGet(na, 1), oy)), Float_Mul(ArrayGet(na, 2), oz))
        IfCondition EqualTo(Float_Le(da, 0), 1) ThenBlock: {
            ArraySet(na, 0, Float_Sub(0, ArrayGet(na, 0)))
            ArraySet(na, 1, Float_Sub(0, ArrayGet(na, 1)))
            ArraySet(na, 2, Float_Sub(0, ArrayGet(na, 2)))
        }
        db = Float_Add(Float_Add(Float_Mul(ArrayGet(nb, 0), ox), Float_Mul(ArrayGet(nb, 1), oy)), Float_Mul(ArrayGet(nb, 2), oz))
        IfCondition EqualTo(Float_Le(db, 0), 1) ThenBlock: {
            ArraySet(nb, 0, Float_Sub(0, ArrayGet(nb, 0)))
            ArraySet(nb, 1, Float_Sub(0, ArrayGet(nb, 1)))
            ArraySet(nb, 2, Float_Sub(0, ArrayGet(nb, 2)))
        }
        // cap: work on a copy — never permanently flip shared digon_S[412]
        ncx0 = ArrayGet(nc, 0)
        ncy0 = ArrayGet(nc, 1)
        ncz0 = ArrayGet(nc, 2)
        ix = Float_Sub(0, ox)
        iy = Float_Sub(0, oy)
        iz = Float_Sub(0, 0x3FF0000000000000)
        din = Float_Add(Float_Add(Float_Mul(ncx0, ix), Float_Mul(ncy0, iy)), Float_Mul(ncz0, iz))
        IfCondition EqualTo(Float_Le(din, 0), 0) ThenBlock: {
            ncx0 = Float_Sub(0, ncx0)
            ncy0 = Float_Sub(0, ncy0)
            ncz0 = Float_Sub(0, ncz0)
        }
        ArraySet(nc, 0, ncx0)
        ArraySet(nc, 1, ncy0)
        ArraySet(nc, 2, ncz0)
        // general-angle equal-R solve (works for non-ortho dihedrals)
        IfCondition NotEqual(CAD_Topo.DigonEqualRSolve(0), 0) ThenBlock: {
            // restore pristine cap normal from face plane slot 412 was setup once —
            // re-load from digon setup: stored also at 425..427 at digon init
            S = CAD_Topo_State.digon_S
            nc = ArrayGet(S, 412)
            ArraySet(nc, 0, ArrayGet(S, 425))
            ArraySet(nc, 1, ArrayGet(S, 426))
            ArraySet(nc, 2, ArrayGet(S, 427))
            PrintMessage("[digon] EqualR singular at corner k=")
            PrintNumber(CAD_Topo_State.digon_k)
            PrintMessage("\n")
            ReturnValue(0)
        }
        S = CAD_Topo_State.digon_S
        // restore shared cap normal for next corner
        nc = ArrayGet(S, 412)
        ArraySet(nc, 0, ArrayGet(S, 425))
        ArraySet(nc, 1, ArrayGet(S, 426))
        ArraySet(nc, 2, ArrayGet(S, 427))
        out9 = ArrayGet(S, 414)
        pt = ArrayGet(S, 404)
        k = CAD_Topo_State.digon_k
        ArraySet(pt, 0, ArrayGet(out9, 0))
        ArraySet(pt, 1, ArrayGet(out9, 1))
        ArraySet(pt, 2, ArrayGet(out9, 2))
        ArraySet(S, Add(144, k), CAD_Topo.MakeVertex(pt))
        S = CAD_Topo_State.digon_S
        out9 = ArrayGet(S, 414)
        pt = ArrayGet(S, 404)
        k = CAD_Topo_State.digon_k
        ArraySet(pt, 0, ArrayGet(out9, 3))
        ArraySet(pt, 1, ArrayGet(out9, 4))
        ArraySet(pt, 2, ArrayGet(out9, 5))
        ArraySet(S, Add(160, k), CAD_Topo.MakeVertex(pt))
        S = CAD_Topo_State.digon_S
        out9 = ArrayGet(S, 414)
        k = CAD_Topo_State.digon_k
        ArraySet(S, Add(176, k), ArrayGet(out9, 6))
        ArraySet(S, Add(192, k), ArrayGet(out9, 7))
        ArraySet(S, Add(208, k), ArrayGet(out9, 8))
        ReturnValue(1)
    }
}

// Ellipse digon at corner digon_k
Function.CAD_Topo.DigonEllAtK {
    Input: ignored: Integer
    Output: Integer
    Body: {
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        n_edges = ArrayGet(S, 304)
        radius_r = ArrayGet(S, 305)
        ip = Subtract(k, 1)
        IfCondition LessThan(ip, 0) ThenBlock: { ip = Subtract(n_edges, 1) }
        ep = ArrayGet(S, Add(64, ip))
        ec = ArrayGet(S, Add(64, k))
        ArraySet(S, 310, ArrayGet(S, Add(224, ep)))
        ArraySet(S, 311, ArrayGet(S, Add(240, ep)))
        ArraySet(S, 312, ArrayGet(S, Add(256, ep)))
        ArraySet(S, 313, ArrayGet(S, Add(224, ec)))
        ArraySet(S, 314, ArrayGet(S, Add(240, ec)))
        ArraySet(S, 315, ArrayGet(S, Add(256, ec)))
        ArraySet(S, 316, ArrayGet(S, Add(176, k)))
        ArraySet(S, 317, ArrayGet(S, Add(192, k)))
        ArraySet(S, 318, ArrayGet(S, Add(208, k)))
        vh = ArrayGet(S, Add(80, k))
        IfCondition EqualTo(ArrayGet(S, Add(32, ep)), vh) ThenBlock: {
            ArraySet(S, 310, Float_Sub(0, ArrayGet(S, 310)))
            ArraySet(S, 311, Float_Sub(0, ArrayGet(S, 311)))
            ArraySet(S, 312, Float_Sub(0, ArrayGet(S, 312)))
        }
        IfCondition EqualTo(ArrayGet(S, Add(48, ec)), vh) ThenBlock: {
            ArraySet(S, 313, Float_Sub(0, ArrayGet(S, 313)))
            ArraySet(S, 314, Float_Sub(0, ArrayGet(S, 314)))
            ArraySet(S, 315, Float_Sub(0, ArrayGet(S, 315)))
        }
        d1 = Add(S, Multiply(310, 8))
        d2 = Add(S, Multiply(313, 8))
        cs = Add(S, Multiply(316, 8))
        ee = CAD_Topo.MakeEqualRDigonEdge(ArrayGet(S, Add(144, k)), ArrayGet(S, Add(160, k)), cs, d1, d2, radius_r)
        IfCondition EqualTo(ee, 0) ThenBlock: { ReturnValue(0) }
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        ArraySet(S, Add(272, k), ee)
        ReturnValue(ArrayGet(S, Add(272, k)))
    }
}

// Cylinder face for cycle edge digon_k. prev face linked. Returns new face.
Function.CAD_Topo.DigonCylSurf {
    Input: ignored: Integer
    Output: Integer
    Body: {
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        frame = ArrayGet(S, 403)
        d1 = ArrayGet(S, 406)
        ei = ArrayGet(S, Add(64, k))
        n_edges = ArrayGet(S, 304)
        // eord may be corrupted under stack stress — fall back to k
        IfCondition GreaterEqual(ei, n_edges) ThenBlock: { ei = k }
        IfCondition LessThan(ei, 0) ThenBlock: { ei = k }
        ArraySet(frame, 0, ArrayGet(S, Add(176, k)))
        ArraySet(frame, 1, ArrayGet(S, Add(192, k)))
        ArraySet(frame, 2, ArrayGet(S, Add(208, k)))
        ArraySet(frame, 3, ArrayGet(S, Add(96, ei)))
        ArraySet(frame, 4, ArrayGet(S, Add(112, ei)))
        ArraySet(frame, 5, ArrayGet(S, Add(128, ei)))
        ArraySet(d1, 0, ArrayGet(S, Add(224, ei)))
        ArraySet(d1, 1, ArrayGet(S, Add(240, ei)))
        ArraySet(d1, 2, ArrayGet(S, Add(256, ei)))
        yx = Float_Sub(Float_Mul(ArrayGet(d1, 1), ArrayGet(frame, 5)), Float_Mul(ArrayGet(d1, 2), ArrayGet(frame, 4)))
        yy = Float_Sub(Float_Mul(ArrayGet(d1, 2), ArrayGet(frame, 3)), Float_Mul(ArrayGet(d1, 0), ArrayGet(frame, 5)))
        yz = Float_Sub(Float_Mul(ArrayGet(d1, 0), ArrayGet(frame, 4)), Float_Mul(ArrayGet(d1, 1), ArrayGet(frame, 3)))
        yl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(yx, yx), Float_Mul(yy, yy)), Float_Mul(yz, yz)))
        IfCondition EqualTo(CAD_Num.IsZero(yl, 0), 1) ThenBlock: {
            // fallback: pick any unit Y ⟂ X
            one = 0x3FF0000000000000
            ArraySet(frame, 6, 0)
            ArraySet(frame, 7, one)
            ArraySet(frame, 8, 0)
            ArraySet(frame, 9, ArrayGet(d1, 0))
            ArraySet(frame, 10, ArrayGet(d1, 1))
            ArraySet(frame, 11, ArrayGet(d1, 2))
        }
        IfCondition EqualTo(CAD_Num.IsZero(yl, 0), 0) ThenBlock: {
            ArraySet(frame, 6, Float_Div(yx, yl))
            ArraySet(frame, 7, Float_Div(yy, yl))
            ArraySet(frame, 8, Float_Div(yz, yl))
            ArraySet(frame, 9, ArrayGet(d1, 0))
            ArraySet(frame, 10, ArrayGet(d1, 1))
            ArraySet(frame, 11, ArrayGet(d1, 2))
        }
        kn = Add(k, 1)
        IfCondition EqualTo(kn, n_edges) ThenBlock: { kn = 0 }
        ArraySet(d1, 0, Float_Sub(ArrayGet(S, Add(176, kn)), ArrayGet(S, Add(176, k))))
        ArraySet(d1, 1, Float_Sub(ArrayGet(S, Add(192, kn)), ArrayGet(S, Add(192, k))))
        ArraySet(d1, 2, Float_Sub(ArrayGet(S, Add(208, kn)), ArrayGet(S, Add(208, k))))
        yl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(d1, 0), ArrayGet(d1, 0)), Float_Mul(ArrayGet(d1, 1), ArrayGet(d1, 1))), Float_Mul(ArrayGet(d1, 2), ArrayGet(d1, 2))))
        IfCondition EqualTo(CAD_Num.IsZero(yl, 0), 0) ThenBlock: {
            ArraySet(frame, 9, Float_Div(ArrayGet(d1, 0), yl))
            ArraySet(frame, 10, Float_Div(ArrayGet(d1, 1), yl))
            ArraySet(frame, 11, Float_Div(ArrayGet(d1, 2), yl))
        }
        ReturnValue(CAD_Geom.MakeCylinderSurf(frame, ArrayGet(S, 305)))
    }
}

// Restore DigonCylAtK assembly: edges + face
Function.CAD_Topo.DigonCylEdges {
    Input: ignored: Integer
    Output: Integer
    Body: {
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        n_edges = ArrayGet(S, 304)
        kn = Add(k, 1)
        IfCondition EqualTo(kn, n_edges) ThenBlock: { kn = 0 }
        pt = ArrayGet(S, 404)
        p1b = ArrayGet(S, 405)
        vc0 = ArrayGet(S, Add(160, k))
        vc1 = ArrayGet(S, Add(160, kn))
        ArraySet(pt, 0, CAD_Store.Read(vc0, 0))
        ArraySet(pt, 1, CAD_Store.Read(vc0, 1))
        ArraySet(pt, 2, CAD_Store.Read(vc0, 2))
        ArraySet(p1b, 0, CAD_Store.Read(vc1, 0))
        ArraySet(p1b, 1, CAD_Store.Read(vc1, 1))
        ArraySet(p1b, 2, CAD_Store.Read(vc1, 2))
        e_gc = CAD_Topo.MakeEdge(vc0, vc1, CAD_Geom.MakeLine(pt, p1b))
        S = CAD_Topo_State.digon_S
        ArraySet(S, 437, e_gc)
        ArraySet(S, 431, ArrayGet(S, 437))
        k = CAD_Topo_State.digon_k
        n_edges = ArrayGet(S, 304)
        kn = Add(k, 1)
        IfCondition EqualTo(kn, n_edges) ThenBlock: { kn = 0 }
        pt = ArrayGet(S, 404)
        p1b = ArrayGet(S, 405)
        vw0 = ArrayGet(S, Add(144, k))
        vw1 = ArrayGet(S, Add(144, kn))
        ArraySet(pt, 0, CAD_Store.Read(vw0, 0))
        ArraySet(pt, 1, CAD_Store.Read(vw0, 1))
        ArraySet(pt, 2, CAD_Store.Read(vw0, 2))
        ArraySet(p1b, 0, CAD_Store.Read(vw1, 0))
        ArraySet(p1b, 1, CAD_Store.Read(vw1, 1))
        ArraySet(p1b, 2, CAD_Store.Read(vw1, 2))
        e_gw = CAD_Topo.MakeEdge(vw0, vw1, CAD_Geom.MakeLine(pt, p1b))
        S = CAD_Topo_State.digon_S
        ArraySet(S, 437, e_gw)
        ArraySet(S, 432, ArrayGet(S, 437))
        nreg = ArrayGet(S, 420)
        reg_a = ArrayGet(S, 400)
        reg_b = ArrayGet(S, 401)
        reg_e = ArrayGet(S, 402)
        k = CAD_Topo_State.digon_k
        n_edges = ArrayGet(S, 304)
        kn = Add(k, 1)
        IfCondition EqualTo(kn, n_edges) ThenBlock: { kn = 0 }
        ArraySet(reg_a, nreg, ArrayGet(S, Add(160, k)))
        ArraySet(reg_b, nreg, ArrayGet(S, Add(160, kn)))
        ArraySet(reg_e, nreg, ArrayGet(S, 431))
        nreg = Add(nreg, 1)
        ArraySet(reg_a, nreg, ArrayGet(S, Add(144, k)))
        ArraySet(reg_b, nreg, ArrayGet(S, Add(144, kn)))
        ArraySet(reg_e, nreg, ArrayGet(S, 432))
        nreg = Add(nreg, 1)
        ArraySet(S, 420, nreg)
        ReturnValue(1)
    }
}

Function.CAD_Topo.DigonCylFace {
    Input: prev_f: Integer
    Output: Integer
    Body: {
        // Cylinder face: e_gc (cap gen) → e_ell1 → e_gw (wall gen rev) → e_ell0
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        kn = Add(k, 1)
        n_edges = ArrayGet(S, 304)
        IfCondition EqualTo(kn, n_edges) ThenBlock: { kn = 0 }
        vc0 = ArrayGet(S, Add(160, k))
        vc1 = ArrayGet(S, Add(160, kn))
        vw0 = ArrayGet(S, Add(144, k))
        vw1 = ArrayGet(S, Add(144, kn))
        e_gc = ArrayGet(S, 431)
        e_gw = ArrayGet(S, 432)
        sn = 1
        IfCondition NotEqual(CAD_Store.Read(e_gc, 0), vc0) ThenBlock: { sn = 0 }
        c0 = CAD_Topo.MakeCoedge(e_gc, vc0, sn)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 437, c0)
        ring = ArrayGet(S, 408)
        ArraySet(ring, 0, ArrayGet(S, 437))
        e_gc = ArrayGet(S, 431)
        CAD_Store.Write(e_gc, 3, ArrayGet(ring, 0))
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        kn = Add(k, 1)
        n_edges = ArrayGet(S, 304)
        IfCondition EqualTo(kn, n_edges) ThenBlock: { kn = 0 }
        vc1 = ArrayGet(S, Add(160, kn))
        e_ell1 = ArrayGet(S, Add(272, kn))
        sn = 1
        IfCondition NotEqual(CAD_Store.Read(e_ell1, 0), vc1) ThenBlock: { sn = 0 }
        c1 = CAD_Topo.MakeCoedge(e_ell1, vc1, sn)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 437, c1)
        ring = ArrayGet(S, 408)
        ArraySet(ring, 1, ArrayGet(S, 437))
        k = CAD_Topo_State.digon_k
        kn = Add(k, 1)
        n_edges = ArrayGet(S, 304)
        IfCondition EqualTo(kn, n_edges) ThenBlock: { kn = 0 }
        e_ell1 = ArrayGet(S, Add(272, kn))
        ca = CAD_Store.Read(e_ell1, 3)
        IfCondition EqualTo(ca, 0) ThenBlock: { CAD_Store.Write(e_ell1, 3, ArrayGet(ring, 1)) }
        IfCondition NotEqual(ca, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(e_ell1, 4), 0) ThenBlock: {
                CAD_Store.Write(e_ell1, 4, ArrayGet(ring, 1))
                CAD_Topo.LinkTwins(ca, ArrayGet(ring, 1))
            }
        }
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        kn = Add(k, 1)
        n_edges = ArrayGet(S, 304)
        IfCondition EqualTo(kn, n_edges) ThenBlock: { kn = 0 }
        vw1 = ArrayGet(S, Add(144, kn))
        e_gw = ArrayGet(S, 432)
        sn = 1
        IfCondition NotEqual(CAD_Store.Read(e_gw, 0), vw1) ThenBlock: { sn = 0 }
        c2 = CAD_Topo.MakeCoedge(e_gw, vw1, sn)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 437, c2)
        ring = ArrayGet(S, 408)
        ArraySet(ring, 2, ArrayGet(S, 437))
        e_gw = ArrayGet(S, 432)
        CAD_Store.Write(e_gw, 3, ArrayGet(ring, 2))
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        vw0 = ArrayGet(S, Add(144, k))
        e_ell0 = ArrayGet(S, Add(272, k))
        sn = 1
        IfCondition NotEqual(CAD_Store.Read(e_ell0, 0), vw0) ThenBlock: { sn = 0 }
        c3 = CAD_Topo.MakeCoedge(e_ell0, vw0, sn)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 437, c3)
        ring = ArrayGet(S, 408)
        ArraySet(ring, 3, ArrayGet(S, 437))
        k = CAD_Topo_State.digon_k
        e_ell0 = ArrayGet(S, Add(272, k))
        ca = CAD_Store.Read(e_ell0, 3)
        IfCondition EqualTo(ca, 0) ThenBlock: { CAD_Store.Write(e_ell0, 3, ArrayGet(ring, 3)) }
        IfCondition NotEqual(ca, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(e_ell0, 4), 0) ThenBlock: {
                CAD_Store.Write(e_ell0, 4, ArrayGet(ring, 3))
                CAD_Topo.LinkTwins(ca, ArrayGet(ring, 3))
            }
        }
        S = CAD_Topo_State.digon_S
        ring = ArrayGet(S, 408)
        lp = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        S = CAD_Topo_State.digon_S
        ring = ArrayGet(S, 408)
        CAD_Topo.LinkLoopRing(ring, 4, lp)
        S = CAD_Topo_State.digon_S
        ff = CAD_Topo.MakeFace(ArrayGet(S, 430), lp)
        IfCondition EqualTo(ff, 0) ThenBlock: { ReturnValue(0) }
        // link via pool — prev_f stack arg may be dead after nested Make*
        pf = CAD_Topo_State.digon_prev_f
        IfCondition NotEqual(pf, 0) ThenBlock: { CAD_Store.Write(pf, 3, ff) }
        ReturnValue(ff)
    }
}

Function.CAD_Topo.DigonCylAtK {
    Input: prev_f: Integer
    Output: Integer
    Body: {
        cyl = CAD_Topo.DigonCylSurf(0)
        IfCondition EqualTo(cyl, 0) ThenBlock: {
            PrintMessage("[digon] CylSurf FAIL k=")
            PrintNumber(CAD_Topo_State.digon_k)
            PrintMessage("\n")
            ReturnValue(0)
        }
        S = CAD_Topo_State.digon_S
        ArraySet(S, 430, cyl)
        IfCondition EqualTo(CAD_Topo.DigonCylEdges(0), 0) ThenBlock: {
            PrintMessage("[digon] CylEdges FAIL\n")
            ReturnValue(0)
        }
        ff = CAD_Topo.DigonCylFace(prev_f)
        IfCondition EqualTo(ff, 0) ThenBlock: {
            PrintMessage("[digon] CylFace FAIL\n")
            ReturnValue(0)
        }
        ReturnValue(ff)
    }
}

// Equal-R vertex: three concurrent R-cylinders, no sphere.
// Per corner k (n_prev, n_curr, n_cap):
//   P_ca = V − R n_curr   cap ∩ wall_prev (start of e_gc[k])
//   P_cb = V − R n_prev   cap ∩ wall_curr (end of e_gc[k−1])
//   P_wa = Cs + R n_prev  wall_prev contact
//   P_wb = Cs + R n_curr  wall_curr contact
// Cap quarter-circle P_cb→P_ca, center P_cap, radius R (vert ∩ cap).
Function.CAD_Topo.DigonBallVerts {
    Input: ignored: Integer
    Output: Integer
    Body: {
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        n_edges = ArrayGet(S, 304)
        radius_r = ArrayGet(S, 305)
        ip = Subtract(k, 1)
        IfCondition LessThan(ip, 0) ThenBlock: { ip = Subtract(n_edges, 1) }
        ei = ArrayGet(S, Add(64, ip))
        ec = ArrayGet(S, Add(64, k))
        nax = ArrayGet(S, Add(96, ei))
        nay = ArrayGet(S, Add(112, ei))
        naz = ArrayGet(S, Add(128, ei))
        nbx = ArrayGet(S, Add(96, ec))
        nby = ArrayGet(S, Add(112, ec))
        nbz = ArrayGet(S, Add(128, ec))
        vh = ArrayGet(S, Add(80, k))
        vv = ArrayGet(S, 413)
        ArraySet(vv, 0, CAD_Store.Read(vh, 0))
        ArraySet(vv, 1, CAD_Store.Read(vh, 1))
        ArraySet(vv, 2, CAD_Store.Read(vh, 2))
        // flip wall normals the same way DigonCornerAtK did (outward)
        cx = 0
        cy = 0
        cz = 0
        i = 0
        WhileLoop LessThan(i, n_edges) {
            vh2 = ArrayGet(S, Add(80, i))
            cx = Float_Add(cx, CAD_Store.Read(vh2, 0))
            cy = Float_Add(cy, CAD_Store.Read(vh2, 1))
            cz = Float_Add(cz, CAD_Store.Read(vh2, 2))
            i = Add(i, 1)
        }
        ox = 0
        oy = 0
        oz = 0
        i = 0
        WhileLoop LessThan(i, n_edges) {
            ox = Float_Add(ox, ArrayGet(vv, 0))
            oy = Float_Add(oy, ArrayGet(vv, 1))
            oz = Float_Add(oz, ArrayGet(vv, 2))
            i = Add(i, 1)
        }
        ox = Float_Sub(ox, cx)
        oy = Float_Sub(oy, cy)
        oz = Float_Sub(oz, cz)
        da = Float_Add(Float_Add(Float_Mul(nax, ox), Float_Mul(nay, oy)), Float_Mul(naz, oz))
        IfCondition EqualTo(Float_Le(da, 0), 1) ThenBlock: {
            nax = Float_Sub(0, nax)
            nay = Float_Sub(0, nay)
            naz = Float_Sub(0, naz)
        }
        db = Float_Add(Float_Add(Float_Mul(nbx, ox), Float_Mul(nby, oy)), Float_Mul(nbz, oz))
        IfCondition EqualTo(Float_Le(db, 0), 1) ThenBlock: {
            nbx = Float_Sub(0, nbx)
            nby = Float_Sub(0, nby)
            nbz = Float_Sub(0, nbz)
        }
        IfCondition EqualTo(ArrayGet(S, 450), 1) ThenBlock: {
            radius_r = Float_Sub(0, radius_r)
        }
        // Pin 4 points on frame (12 qwords) BEFORE MakeVertex clobbers locals.
        // P_ca = V − R n_curr; P_cb = V − R n_prev
        // P_wa = Cs + R n_prev; P_wb = Cs + R n_curr
        frame = ArrayGet(S, 403)
        vv = ArrayGet(S, 413)
        ArraySet(frame, 0, Float_Sub(ArrayGet(vv, 0), Float_Mul(radius_r, nbx)))
        ArraySet(frame, 1, Float_Sub(ArrayGet(vv, 1), Float_Mul(radius_r, nby)))
        ArraySet(frame, 2, Float_Sub(ArrayGet(vv, 2), Float_Mul(radius_r, nbz)))
        ArraySet(frame, 3, Float_Sub(ArrayGet(vv, 0), Float_Mul(radius_r, nax)))
        ArraySet(frame, 4, Float_Sub(ArrayGet(vv, 1), Float_Mul(radius_r, nay)))
        ArraySet(frame, 5, Float_Sub(ArrayGet(vv, 2), Float_Mul(radius_r, naz)))
        csx = ArrayGet(S, Add(176, k))
        csy = ArrayGet(S, Add(192, k))
        csz = ArrayGet(S, Add(208, k))
        ArraySet(frame, 6, Float_Add(csx, Float_Mul(radius_r, nax)))
        ArraySet(frame, 7, Float_Add(csy, Float_Mul(radius_r, nay)))
        ArraySet(frame, 8, Float_Add(csz, Float_Mul(radius_r, naz)))
        ArraySet(frame, 9, Float_Add(csx, Float_Mul(radius_r, nbx)))
        ArraySet(frame, 10, Float_Add(csy, Float_Mul(radius_r, nby)))
        ArraySet(frame, 11, Float_Add(csz, Float_Mul(radius_r, nbz)))
        pt = ArrayGet(S, 404)
        ArraySet(pt, 0, ArrayGet(frame, 0))
        ArraySet(pt, 1, ArrayGet(frame, 1))
        ArraySet(pt, 2, ArrayGet(frame, 2))
        pca = CAD_Topo.MakeVertex(pt)
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        ArraySet(ArrayGet(S, 453), k, pca)
        pt = ArrayGet(S, 404)
        frame = ArrayGet(S, 403)
        ArraySet(pt, 0, ArrayGet(frame, 3))
        ArraySet(pt, 1, ArrayGet(frame, 4))
        ArraySet(pt, 2, ArrayGet(frame, 5))
        pcb = CAD_Topo.MakeVertex(pt)
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        ArraySet(ArrayGet(S, 454), k, pcb)
        pt = ArrayGet(S, 404)
        frame = ArrayGet(S, 403)
        ArraySet(pt, 0, ArrayGet(frame, 6))
        ArraySet(pt, 1, ArrayGet(frame, 7))
        ArraySet(pt, 2, ArrayGet(frame, 8))
        pwa = CAD_Topo.MakeVertex(pt)
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        ArraySet(ArrayGet(S, 455), k, pwa)
        pt = ArrayGet(S, 404)
        frame = ArrayGet(S, 403)
        ArraySet(pt, 0, ArrayGet(frame, 9))
        ArraySet(pt, 1, ArrayGet(frame, 10))
        ArraySet(pt, 2, ArrayGet(frame, 11))
        pwb = CAD_Topo.MakeVertex(pt)
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        ArraySet(ArrayGet(S, 456), k, pwb)
        ReturnValue(1)
    }
}

// Cap quarter-circle at corner k: P_cb → P_ca, center P_cap, radius |R|.
Function.CAD_Topo.DigonCapArcAtK {
    Input: ignored: Integer
    Output: Integer
    Body: {
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        radius_r = ArrayGet(S, 305)
        IfCondition EqualTo(ArrayGet(S, 450), 1) ThenBlock: {
            radius_r = Float_Sub(0, radius_r)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(radius_r), 1) ThenBlock: {
            radius_r = Float_Sub(0, radius_r)
        }
        frame = ArrayGet(S, 403)
        pcap = ArrayGet(S, Add(160, k))
        ArraySet(frame, 0, CAD_Store.Read(pcap, 0))
        ArraySet(frame, 1, CAD_Store.Read(pcap, 1))
        ArraySet(frame, 2, CAD_Store.Read(pcap, 2))
        // X = unit(P_cb − P_cap), Y = unit(P_ca − P_cap)  (cap-plane frame)
        pcb = ArrayGet(ArrayGet(S, 454), k)
        pca = ArrayGet(ArrayGet(S, 453), k)
        xx = Float_Sub(CAD_Store.Read(pcb, 0), ArrayGet(frame, 0))
        xy = Float_Sub(CAD_Store.Read(pcb, 1), ArrayGet(frame, 1))
        xz = Float_Sub(CAD_Store.Read(pcb, 2), ArrayGet(frame, 2))
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(xx, xx), Float_Mul(xy, xy)), Float_Mul(xz, xz)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(frame, 3, Float_Div(xx, ln))
        ArraySet(frame, 4, Float_Div(xy, ln))
        ArraySet(frame, 5, Float_Div(xz, ln))
        yx = Float_Sub(CAD_Store.Read(pca, 0), ArrayGet(frame, 0))
        yy = Float_Sub(CAD_Store.Read(pca, 1), ArrayGet(frame, 1))
        yz = Float_Sub(CAD_Store.Read(pca, 2), ArrayGet(frame, 2))
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(yx, yx), Float_Mul(yy, yy)), Float_Mul(yz, yz)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(frame, 6, Float_Div(yx, ln))
        ArraySet(frame, 7, Float_Div(yy, ln))
        ArraySet(frame, 8, Float_Div(yz, ln))
        circ = CAD_Geom.MakeCircle(frame, radius_r)
        IfCondition EqualTo(circ, 0) ThenBlock: { ReturnValue(0) }
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        ee = CAD_Topo.MakeMinorArcEdge(ArrayGet(ArrayGet(S, 454), k), ArrayGet(ArrayGet(S, 453), k), circ)
        IfCondition EqualTo(ee, 0) ThenBlock: { ReturnValue(0) }
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        ArraySet(ArrayGet(S, 457), k, ee)
        ReturnValue(ee)
    }
}

// Vertical cylinder stub at corner k: cap-arc, gen P_ca–P_wa, wall-arc, gen P_wb–P_cb.
Function.CAD_Topo.DigonVertCylAtK {
    Input: prev_f: Integer
    Output: Integer
    Body: {
        CAD_Topo_State.digon_prev_f = prev_f
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        radius_r = ArrayGet(S, 305)
        frame = ArrayGet(S, 403)
        ArraySet(frame, 0, ArrayGet(S, Add(176, k)))
        ArraySet(frame, 1, ArrayGet(S, Add(192, k)))
        ArraySet(frame, 2, ArrayGet(S, Add(208, k)))
        n_edges = ArrayGet(S, 304)
        ip = Subtract(k, 1)
        IfCondition LessThan(ip, 0) ThenBlock: { ip = Subtract(n_edges, 1) }
        ei = ArrayGet(S, Add(64, ip))
        // X = n_prev, Z = cap normal (pristine 425..427)
        ArraySet(frame, 3, ArrayGet(S, Add(96, ei)))
        ArraySet(frame, 4, ArrayGet(S, Add(112, ei)))
        ArraySet(frame, 5, ArrayGet(S, Add(128, ei)))
        ArraySet(frame, 9, ArrayGet(S, 425))
        ArraySet(frame, 10, ArrayGet(S, 426))
        ArraySet(frame, 11, ArrayGet(S, 427))
        // Y = Z × X
        yx = Float_Sub(Float_Mul(ArrayGet(frame, 10), ArrayGet(frame, 5)), Float_Mul(ArrayGet(frame, 11), ArrayGet(frame, 4)))
        yy = Float_Sub(Float_Mul(ArrayGet(frame, 11), ArrayGet(frame, 3)), Float_Mul(ArrayGet(frame, 9), ArrayGet(frame, 5)))
        yz = Float_Sub(Float_Mul(ArrayGet(frame, 9), ArrayGet(frame, 4)), Float_Mul(ArrayGet(frame, 10), ArrayGet(frame, 3)))
        yl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(yx, yx), Float_Mul(yy, yy)), Float_Mul(yz, yz)))
        IfCondition EqualTo(CAD_Num.IsZero(yl, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(frame, 6, Float_Div(yx, yl))
        ArraySet(frame, 7, Float_Div(yy, yl))
        ArraySet(frame, 8, Float_Div(yz, yl))
        cyl = CAD_Geom.MakeCylinderSurf(frame, radius_r)
        IfCondition EqualTo(cyl, 0) ThenBlock: { ReturnValue(0) }
        S = CAD_Topo_State.digon_S
        ArraySet(S, 430, cyl)
        k = CAD_Topo_State.digon_k
        // wall-arc P_wa → P_wb, circle in plane through Cs ⟂ nc
        frame = ArrayGet(S, 403)
        ArraySet(frame, 0, ArrayGet(S, Add(176, k)))
        ArraySet(frame, 1, ArrayGet(S, Add(192, k)))
        ArraySet(frame, 2, ArrayGet(S, Add(208, k)))
        pwa = ArrayGet(ArrayGet(S, 455), k)
        pwb = ArrayGet(ArrayGet(S, 456), k)
        xx = Float_Sub(CAD_Store.Read(pwa, 0), ArrayGet(frame, 0))
        xy = Float_Sub(CAD_Store.Read(pwa, 1), ArrayGet(frame, 1))
        xz = Float_Sub(CAD_Store.Read(pwa, 2), ArrayGet(frame, 2))
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(xx, xx), Float_Mul(xy, xy)), Float_Mul(xz, xz)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(frame, 3, Float_Div(xx, ln))
        ArraySet(frame, 4, Float_Div(xy, ln))
        ArraySet(frame, 5, Float_Div(xz, ln))
        yx = Float_Sub(CAD_Store.Read(pwb, 0), ArrayGet(frame, 0))
        yy = Float_Sub(CAD_Store.Read(pwb, 1), ArrayGet(frame, 1))
        yz = Float_Sub(CAD_Store.Read(pwb, 2), ArrayGet(frame, 2))
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(yx, yx), Float_Mul(yy, yy)), Float_Mul(yz, yz)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(frame, 6, Float_Div(yx, ln))
        ArraySet(frame, 7, Float_Div(yy, ln))
        ArraySet(frame, 8, Float_Div(yz, ln))
        circ = CAD_Geom.MakeCircle(frame, radius_r)
        IfCondition EqualTo(circ, 0) ThenBlock: { ReturnValue(0) }
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        ebot = CAD_Topo.MakeMinorArcEdge(ArrayGet(ArrayGet(S, 455), k), ArrayGet(ArrayGet(S, 456), k), circ)
        IfCondition EqualTo(ebot, 0) ThenBlock: { ReturnValue(0) }
        S = CAD_Topo_State.digon_S
        ArraySet(S, 462, ebot)
        k = CAD_Topo_State.digon_k
        pt = ArrayGet(S, 404)
        p1b = ArrayGet(S, 405)
        pca = ArrayGet(ArrayGet(S, 453), k)
        pwa = ArrayGet(ArrayGet(S, 455), k)
        ArraySet(pt, 0, CAD_Store.Read(pca, 0))
        ArraySet(pt, 1, CAD_Store.Read(pca, 1))
        ArraySet(pt, 2, CAD_Store.Read(pca, 2))
        ArraySet(p1b, 0, CAD_Store.Read(pwa, 0))
        ArraySet(p1b, 1, CAD_Store.Read(pwa, 1))
        ArraySet(p1b, 2, CAD_Store.Read(pwa, 2))
        ega = CAD_Topo.MakeEdge(pca, pwa, CAD_Geom.MakeLine(pt, p1b))
        S = CAD_Topo_State.digon_S
        ArraySet(S, 463, ega)
        k = CAD_Topo_State.digon_k
        pt = ArrayGet(S, 404)
        p1b = ArrayGet(S, 405)
        pcb = ArrayGet(ArrayGet(S, 454), k)
        pwb = ArrayGet(ArrayGet(S, 456), k)
        ArraySet(pt, 0, CAD_Store.Read(pwb, 0))
        ArraySet(pt, 1, CAD_Store.Read(pwb, 1))
        ArraySet(pt, 2, CAD_Store.Read(pwb, 2))
        ArraySet(p1b, 0, CAD_Store.Read(pcb, 0))
        ArraySet(p1b, 1, CAD_Store.Read(pcb, 1))
        ArraySet(p1b, 2, CAD_Store.Read(pcb, 2))
        egb = CAD_Topo.MakeEdge(pwb, pcb, CAD_Geom.MakeLine(pt, p1b))
        S = CAD_Topo_State.digon_S
        ArraySet(S, 464, egb)
        k = CAD_Topo_State.digon_k
        ecap = ArrayGet(ArrayGet(S, 457), k)
        pca = ArrayGet(ArrayGet(S, 453), k)
        pcb = ArrayGet(ArrayGet(S, 454), k)
        pwa = ArrayGet(ArrayGet(S, 455), k)
        pwb = ArrayGet(ArrayGet(S, 456), k)
        ega = ArrayGet(S, 463)
        ebot = ArrayGet(S, 462)
        egb = ArrayGet(S, 464)
        ring = ArrayGet(S, 408)
        // cap-arc starts at P_cb
        sn = 1
        IfCondition NotEqual(CAD_Store.Read(ecap, 0), pcb) ThenBlock: { sn = 0 }
        ArraySet(ring, 0, CAD_Topo.MakeCoedge(ecap, pcb, sn))
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        CAD_Topo.DigonBindCoedge(ArrayGet(ArrayGet(S, 457), k), ArrayGet(ArrayGet(S, 408), 0))
        // gen P_ca → P_wa  (after cap-arc we are at P_ca)
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        ring = ArrayGet(S, 408)
        ega = ArrayGet(S, 463)
        pca = ArrayGet(ArrayGet(S, 453), k)
        sn = 1
        IfCondition NotEqual(CAD_Store.Read(ega, 0), pca) ThenBlock: { sn = 0 }
        ArraySet(ring, 1, CAD_Topo.MakeCoedge(ega, pca, sn))
        S = CAD_Topo_State.digon_S
        CAD_Store.Write(ArrayGet(S, 463), 3, ArrayGet(ArrayGet(S, 408), 1))
        // wall-arc P_wa → P_wb
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        ring = ArrayGet(S, 408)
        ebot = ArrayGet(S, 462)
        pwa = ArrayGet(ArrayGet(S, 455), k)
        sn = 1
        IfCondition NotEqual(CAD_Store.Read(ebot, 0), pwa) ThenBlock: { sn = 0 }
        ArraySet(ring, 2, CAD_Topo.MakeCoedge(ebot, pwa, sn))
        S = CAD_Topo_State.digon_S
        CAD_Store.Write(ArrayGet(S, 462), 3, ArrayGet(ArrayGet(S, 408), 2))
        // gen P_wb → P_cb
        S = CAD_Topo_State.digon_S
        k = CAD_Topo_State.digon_k
        ring = ArrayGet(S, 408)
        egb = ArrayGet(S, 464)
        pwb = ArrayGet(ArrayGet(S, 456), k)
        sn = 1
        IfCondition NotEqual(CAD_Store.Read(egb, 0), pwb) ThenBlock: { sn = 0 }
        ArraySet(ring, 3, CAD_Topo.MakeCoedge(egb, pwb, sn))
        S = CAD_Topo_State.digon_S
        CAD_Store.Write(ArrayGet(S, 464), 3, ArrayGet(ArrayGet(S, 408), 3))
        lp = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        S = CAD_Topo_State.digon_S
        ring = ArrayGet(S, 408)
        CAD_Topo.LinkLoopRing(ring, 4, lp)
        S = CAD_Topo_State.digon_S
        ff = CAD_Topo.MakeFace(ArrayGet(S, 430), lp)
        IfCondition EqualTo(ff, 0) ThenBlock: { ReturnValue(0) }
        pf = CAD_Topo_State.digon_prev_f
        IfCondition NotEqual(pf, 0) ThenBlock: { CAD_Store.Write(pf, 3, ff) }
        ReturnValue(ff)
    }
}
