// CAD.Topo.Digon2 — split from Library.CAD_Topo.ailang
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

// Attach cee to ee. If both twin slots are full, steal the coedge
// whose face is the old fcap (being replaced) so the new cap and the
// existing cove cylinder share the hole rim.
Function.CAD_Topo.DigonBindCoedge {
    Input: ee: Integer
    Input: cee: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ee, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cee, 0) ThenBlock: { ReturnValue(0) }
        ca = CAD_Store.Read(ee, 3)
        IfCondition EqualTo(ca, 0) ThenBlock: {
            CAD_Store.Write(ee, 3, cee)
            ReturnValue(1)
        }
        IfCondition EqualTo(CAD_Store.Read(ee, 4), 0) ThenBlock: {
            CAD_Store.Write(ee, 4, cee)
            CAD_Topo.LinkTwins(ca, cee)
            ReturnValue(1)
        }
        S = CAD_Topo_State.digon_S
        fcap = 0
        IfCondition NotEqual(S, 0) ThenBlock: { fcap = ArrayGet(S, 307) }
        lp = CAD_Store.Read(ca, 4)
        fa = 0
        IfCondition NotEqual(lp, 0) ThenBlock: { fa = CAD_Store.Read(lp, 1) }
        IfCondition EqualTo(fa, fcap) ThenBlock: {
            CAD_Store.Write(ee, 3, cee)
            CAD_Topo.LinkTwins(CAD_Store.Read(ee, 4), cee)
            ReturnValue(1)
        }
        cb = CAD_Store.Read(ee, 4)
        lp = 0
        IfCondition NotEqual(cb, 0) ThenBlock: { lp = CAD_Store.Read(cb, 4) }
        fb = 0
        IfCondition NotEqual(lp, 0) ThenBlock: { fb = CAD_Store.Read(lp, 1) }
        IfCondition EqualTo(fb, fcap) ThenBlock: {
            CAD_Store.Write(ee, 4, cee)
            CAD_Topo.LinkTwins(ca, cee)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Clone a loop with DigonMapVert (used to keep a host outer ring).
Function.CAD_Topo.DigonCloneLoop {
    Input: old_lp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(old_lp, 0) ThenBlock: { ReturnValue(0) }
        head = CAD_Store.Read(old_lp, 0)
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(0) }
        nlist = Allocate(16384)
        carr = Allocate(16384)
        nn = 0
        ce = head
        g = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ov = CAD_Store.Read(ce, 5)
            nv = CAD_Topo.DigonMapVert(ov)
            add = 1
            IfCondition EqualTo(nv, 0) ThenBlock: { add = 0 }
            IfCondition GreaterThan(nn, 0) ThenBlock: {
                IfCondition EqualTo(nv, ArrayGet(nlist, Subtract(nn, 1))) ThenBlock: { add = 0 }
            }
            IfCondition EqualTo(add, 1) ThenBlock: {
                ArraySet(nlist, nn, nv)
                nn = Add(nn, 1)
            }
            ce = CAD_Store.Read(ce, 2)
            g = Add(g, 1)
            IfCondition EqualTo(ce, head) ThenBlock: { done = 1 }
            IfCondition GreaterThan(g, 2048) ThenBlock: { done = 1 }
        }
        IfCondition GreaterThan(nn, 1) ThenBlock: {
            IfCondition EqualTo(ArrayGet(nlist, 0), ArrayGet(nlist, Subtract(nn, 1))) ThenBlock: {
                nn = Subtract(nn, 1)
            }
        }
        IfCondition LessThan(nn, 3) ThenBlock: {
            Deallocate(nlist, 16384)
            Deallocate(carr, 16384)
            ReturnValue(0)
        }
        nout = 0
        i = 0
        WhileLoop LessThan(i, nn) {
            S = CAD_Topo_State.digon_S
            jn = Add(i, 1)
            IfCondition EqualTo(jn, nn) ThenBlock: { jn = 0 }
            ua = ArrayGet(nlist, i)
            ub = ArrayGet(nlist, jn)
            IfCondition NotEqual(ua, ub) ThenBlock: {
                ee = 0
                reg_a = ArrayGet(S, 400)
                reg_b = ArrayGet(S, 401)
                reg_e = ArrayGet(S, 402)
                nreg = ArrayGet(S, 420)
                ri = 0
                WhileLoop LessThan(ri, nreg) {
                    IfCondition EqualTo(ArrayGet(reg_a, ri), ua) ThenBlock: {
                        IfCondition EqualTo(ArrayGet(reg_b, ri), ub) ThenBlock: { ee = ArrayGet(reg_e, ri) }
                    }
                    IfCondition EqualTo(ArrayGet(reg_a, ri), ub) ThenBlock: {
                        IfCondition EqualTo(ArrayGet(reg_b, ri), ua) ThenBlock: { ee = ArrayGet(reg_e, ri) }
                    }
                    ri = Add(ri, 1)
                }
                IfCondition EqualTo(ee, 0) ThenBlock: {
                    pt = ArrayGet(S, 404)
                    p1b = ArrayGet(S, 405)
                    ArraySet(pt, 0, CAD_Store.Read(ua, 0))
                    ArraySet(pt, 1, CAD_Store.Read(ua, 1))
                    ArraySet(pt, 2, CAD_Store.Read(ua, 2))
                    ArraySet(p1b, 0, CAD_Store.Read(ub, 0))
                    ArraySet(p1b, 1, CAD_Store.Read(ub, 1))
                    ArraySet(p1b, 2, CAD_Store.Read(ub, 2))
                    ee = CAD_Topo.MakeEdge(ua, ub, CAD_Geom.MakeLine(pt, p1b))
                    S = CAD_Topo_State.digon_S
                    reg_a = ArrayGet(S, 400)
                    reg_b = ArrayGet(S, 401)
                    reg_e = ArrayGet(S, 402)
                    nreg = ArrayGet(S, 420)
                    ArraySet(reg_a, nreg, ua)
                    ArraySet(reg_b, nreg, ub)
                    ArraySet(reg_e, nreg, ee)
                    ArraySet(S, 420, Add(nreg, 1))
                }
                sn = 1
                IfCondition NotEqual(CAD_Store.Read(ee, 0), ua) ThenBlock: { sn = 0 }
                cee = CAD_Topo.MakeCoedge(ee, ua, sn)
                ArraySet(carr, nout, cee)
                nout = Add(nout, 1)
                ca = CAD_Store.Read(ee, 3)
                IfCondition EqualTo(ca, 0) ThenBlock: { CAD_Store.Write(ee, 3, cee) }
                IfCondition NotEqual(ca, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(ee, 4), 0) ThenBlock: {
                        CAD_Store.Write(ee, 4, cee)
                        CAD_Topo.LinkTwins(ca, cee)
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(nout, 3) ThenBlock: {
            Deallocate(nlist, 16384)
            Deallocate(carr, 16384)
            ReturnValue(0)
        }
        lp = CAD_Topo.MakeLoop(ArrayGet(carr, 0))
        CAD_Topo.LinkLoopRing(carr, nout, lp)
        Deallocate(nlist, 16384)
        Deallocate(carr, 16384)
        ReturnValue(lp)
    }
}

Function.CAD_Topo.DigonMakeCap {
    Input: prev_f: Integer
    Output: Integer
    Body: {
        // pin link target — stack args clobber across nested Make*
        CAD_Topo_State.digon_prev_f = prev_f
        S = CAD_Topo_State.digon_S
        n_edges = ArrayGet(S, 304)
        // pin coedge array on digon_S so it survives nested Make*
        // n_edges coedges (≤12); ArraySet idx i needs 8+(i+1)*8 bytes
        tmp = Allocate(128)
        IfCondition EqualTo(tmp, 0) ThenBlock: {
            PrintMessage("[digon] MakeCap Allocate FAIL\n")
            ReturnValue(0)
        }
        S = CAD_Topo_State.digon_S
        ArraySet(S, 416, tmp)
        i = 0
        WhileLoop LessThan(i, n_edges) {
            S = CAD_Topo_State.digon_S
            reg_a = ArrayGet(S, 400)
            reg_b = ArrayGet(S, 401)
            reg_e = ArrayGet(S, 402)
            pt = ArrayGet(S, 404)
            p1b = ArrayGet(S, 405)
            nreg = ArrayGet(S, 420)
            n_edges = ArrayGet(S, 304)
            jn = Add(i, 1)
            IfCondition EqualTo(jn, n_edges) ThenBlock: { jn = 0 }
            ua = ArrayGet(S, Add(160, i))
            ub = ArrayGet(S, Add(160, jn))
            ee = 0
            ri = 0
            WhileLoop LessThan(ri, nreg) {
                IfCondition EqualTo(ArrayGet(reg_a, ri), ua) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(reg_b, ri), ub) ThenBlock: { ee = ArrayGet(reg_e, ri) }
                }
                IfCondition EqualTo(ArrayGet(reg_a, ri), ub) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(reg_b, ri), ua) ThenBlock: { ee = ArrayGet(reg_e, ri) }
                }
                ri = Add(ri, 1)
            }
            IfCondition EqualTo(ee, 0) ThenBlock: {
                ArraySet(pt, 0, CAD_Store.Read(ua, 0))
                ArraySet(pt, 1, CAD_Store.Read(ua, 1))
                ArraySet(pt, 2, CAD_Store.Read(ua, 2))
                ArraySet(p1b, 0, CAD_Store.Read(ub, 0))
                ArraySet(p1b, 1, CAD_Store.Read(ub, 1))
                ArraySet(p1b, 2, CAD_Store.Read(ub, 2))
                ee = CAD_Topo.MakeEdge(ua, ub, CAD_Geom.MakeLine(pt, p1b))
                S = CAD_Topo_State.digon_S
                reg_a = ArrayGet(S, 400)
                reg_b = ArrayGet(S, 401)
                reg_e = ArrayGet(S, 402)
                nreg = ArrayGet(S, 420)
                ArraySet(reg_a, nreg, ua)
                ArraySet(reg_b, nreg, ub)
                ArraySet(reg_e, nreg, ee)
                nreg = Add(nreg, 1)
                ArraySet(S, 420, nreg)
            }
            sn = 1
            IfCondition NotEqual(CAD_Store.Read(ee, 0), ua) ThenBlock: { sn = 0 }
            cee = CAD_Topo.MakeCoedge(ee, ua, sn)
            S = CAD_Topo_State.digon_S
            carr = ArrayGet(S, 416)
            ArraySet(carr, i, cee)
            CAD_Topo.DigonBindCoedge(ee, cee)
            i = Add(i, 1)
            n_edges = ArrayGet(CAD_Topo_State.digon_S, 304)
        }
        S = CAD_Topo_State.digon_S
        carr = ArrayGet(S, 416)
        n_edges = ArrayGet(S, 304)
        c0 = ArrayGet(carr, 0)
        IfCondition EqualTo(c0, 0) ThenBlock: {
            PrintMessage("[digon] MakeCap c0 null\n")
            ReturnValue(0)
        }
        lp = CAD_Topo.MakeLoop(c0)
        S = CAD_Topo_State.digon_S
        carr = ArrayGet(S, 416)
        n_edges = ArrayGet(S, 304)
        CAD_Topo.LinkLoopRing(carr, n_edges, lp)
        S = CAD_Topo_State.digon_S
        pl = ArrayGet(S, 409)
        fcap = ArrayGet(S, 307)
        ArraySet(S, 422, 0)
        IfCondition NotEqual(fcap, 0) ThenBlock: {
            ArraySet(S, 422, CAD_Store.Read(fcap, 1))
        }
        CAD_Topo.FaceGetPlane(fcap, pl)
        S = CAD_Topo_State.digon_S
        pl = ArrayGet(S, 409)
        pt = ArrayGet(S, 404)
        d1 = ArrayGet(S, 406)
        d2 = ArrayGet(S, 407)
        ArraySet(pt, 0, ArrayGet(pl, 1))
        ArraySet(pt, 1, ArrayGet(pl, 2))
        ArraySet(pt, 2, ArrayGet(pl, 3))
        ArraySet(d1, 0, ArrayGet(pl, 4))
        ArraySet(d1, 1, ArrayGet(pl, 5))
        ArraySet(d1, 2, ArrayGet(pl, 6))
        ArraySet(d2, 0, ArrayGet(pl, 7))
        ArraySet(d2, 1, ArrayGet(pl, 8))
        ArraySet(d2, 2, ArrayGet(pl, 9))
        surf = CAD_Geom.MakePlaneAxes(pt, d1, d2)
        // Concave join: P_cap cycle is the NEW INNER on the host face.
        // Keep the original OUTER so the lower body is not replaced
        // by the imprint rectangle.
        IfCondition EqualTo(ArrayGet(CAD_Topo_State.digon_S, 450), 1) ThenBlock: {
            ArraySet(CAD_Topo_State.digon_S, 433, lp)
            old_o = ArrayGet(CAD_Topo_State.digon_S, 422)
            ArraySet(CAD_Topo_State.digon_S, 432, 0)
            IfCondition NotEqual(old_o, 0) ThenBlock: {
                ArraySet(CAD_Topo_State.digon_S, 432, CAD_Store.Read(old_o, 2))
            }
            olp = CAD_Topo.DigonCloneLoop(old_o)
            IfCondition EqualTo(olp, 0) ThenBlock: {
                PrintMessage("[digon] concave outer clone FAIL\n")
                ReturnValue(0)
            }
            ff = CAD_Topo.MakeFace(surf, olp)
            IfCondition EqualTo(ff, 0) ThenBlock: {
                PrintMessage("[digon] MakeCap face FAIL\n")
                ReturnValue(0)
            }
            S = CAD_Topo_State.digon_S
            ilp = ArrayGet(S, 433)
            CAD_Store.Write(olp, 2, ilp)
            CAD_Store.Write(ilp, 1, ff)
            pf = CAD_Topo_State.digon_prev_f
            IfCondition NotEqual(pf, 0) ThenBlock: { CAD_Store.Write(pf, 3, ff) }
            S = CAD_Topo_State.digon_S
            ArraySet(S, 423, ilp)
            CAD_Topo.DigonAttachInners()
            S = CAD_Topo_State.digon_S
            Deallocate(ArrayGet(S, 416), 128)
            ArraySet(S, 416, 0)
            PrintMessage("digon concave cap kept host outer\n")
            ReturnValue(ff)
        }
        ff = CAD_Topo.MakeFace(surf, lp)
        IfCondition EqualTo(ff, 0) ThenBlock: {
            PrintMessage("[digon] MakeCap face FAIL\n")
            ReturnValue(0)
        }
        pf = CAD_Topo_State.digon_prev_f
        IfCondition NotEqual(pf, 0) ThenBlock: { CAD_Store.Write(pf, 3, ff) }
        S = CAD_Topo_State.digon_S
        ArraySet(S, 432, 0)
        ArraySet(S, 423, CAD_Store.Read(ff, 1))
        CAD_Topo.DigonAttachInners()
        S = CAD_Topo_State.digon_S
        Deallocate(ArrayGet(S, 416), 128)
        ArraySet(S, 416, 0)
        ReturnValue(ff)
    }
}

// Map original vertex → digon vertex. Cycle corners → P_ww; others shared via oldv/newv map.
// digon_S: 418=oldv, 419=newv, 421=nvmap. Returns new vertex handle.
Function.CAD_Topo.DigonMapVert {
    Input: ov: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ov, 0) ThenBlock: { ReturnValue(0) }
        S = CAD_Topo_State.digon_S
        n_edges = ArrayGet(S, 304)
        // cycle corner → P_ww
        i = 0
        WhileLoop LessThan(i, n_edges) {
            IfCondition EqualTo(ov, ArrayGet(S, Add(80, i))) ThenBlock: {
                ReturnValue(ArrayGet(S, Add(144, i)))
            }
            i = Add(i, 1)
        }
        // also match selected-edge endpoints (same handles as cycle verts usually)
        i = 0
        WhileLoop LessThan(i, n_edges) {
            IfCondition EqualTo(ov, ArrayGet(S, Add(32, i))) ThenBlock: {
                j = 0
                WhileLoop LessThan(j, n_edges) {
                    IfCondition EqualTo(ArrayGet(S, Add(80, j)), ov) ThenBlock: {
                        ReturnValue(ArrayGet(S, Add(144, j)))
                    }
                    j = Add(j, 1)
                }
            }
            IfCondition EqualTo(ov, ArrayGet(S, Add(48, i))) ThenBlock: {
                j = 0
                WhileLoop LessThan(j, n_edges) {
                    IfCondition EqualTo(ArrayGet(S, Add(80, j)), ov) ThenBlock: {
                        ReturnValue(ArrayGet(S, Add(144, j)))
                    }
                    j = Add(j, 1)
                }
            }
            i = Add(i, 1)
        }
        // Non-cycle verts keep their original handles so untouched
        // faces (boss top on a concave step fillet) stay stitched.
        ReturnValue(ov)
    }
}

// Copy inner loops (holes) from old_outer onto new_outer.
// DigonMakeCap / DigonRebuildFace only walked the outer ring, so a
// roof circle vanished when the waist was filleted. Map verts, keep
// circle curves, link via loop slot 2. S[422]=old_outer S[423]=new_outer.
Function.CAD_Topo.DigonAttachInners {
    Output: Integer
    Body: {
        S = CAD_Topo_State.digon_S
        IfCondition EqualTo(S, 0) ThenBlock: { ReturnValue(0) }
        old_o = ArrayGet(S, 422)
        new_o = ArrayGet(S, 423)
        IfCondition EqualTo(old_o, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_o, 0) ThenBlock: { ReturnValue(0) }
        inner = CAD_Store.Read(old_o, 2)
        IfCondition EqualTo(inner, 0) ThenBlock: { ReturnValue(0) }
        skip_lp = ArrayGet(S, 432)
        nlist = Allocate(16384)
        carr = Allocate(16384)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 428, nlist)
        ArraySet(S, 429, carr)
        prev = new_o
        natt = 0
        hguard = 0
        WhileLoop NotEqual(inner, 0) {
            IfCondition GreaterThan(hguard, 8) ThenBlock: { inner = 0 }
            IfCondition NotEqual(inner, 0) ThenBlock: {
                S = CAD_Topo_State.digon_S
                ArraySet(S, 430, inner)
                work = 1
                IfCondition EqualTo(inner, ArrayGet(S, 432)) ThenBlock: { work = 0 }
                IfCondition EqualTo(work, 0) ThenBlock: {
                    inner = CAD_Store.Read(inner, 2)
                }
                IfCondition EqualTo(work, 1) ThenBlock: {
                nlist = ArrayGet(S, 428)
                head = CAD_Store.Read(inner, 0)
                nn = 0
                ce = head
                cguard = 0
                done = 0
                IfCondition EqualTo(head, 0) ThenBlock: { done = 1 }
                WhileLoop EqualTo(done, 0) {
                    ov = CAD_Store.Read(ce, 5)
                    nv = CAD_Topo.DigonMapVert(ov)
                    S = CAD_Topo_State.digon_S
                    nlist = ArrayGet(S, 428)
                    add = 1
                    IfCondition EqualTo(nv, 0) ThenBlock: { add = 0 }
                    IfCondition GreaterThan(nn, 0) ThenBlock: {
                        IfCondition EqualTo(nv, ArrayGet(nlist, Subtract(nn, 1))) ThenBlock: { add = 0 }
                    }
                    IfCondition EqualTo(add, 1) ThenBlock: {
                        ArraySet(nlist, nn, nv)
                        nn = Add(nn, 1)
                    }
                    ce = CAD_Store.Read(ce, 2)
                    cguard = Add(cguard, 1)
                    IfCondition EqualTo(ce, head) ThenBlock: { done = 1 }
                    IfCondition GreaterThan(cguard, 2048) ThenBlock: { done = 1 }
                }
                S = CAD_Topo_State.digon_S
                nlist = ArrayGet(S, 428)
                IfCondition GreaterThan(nn, 1) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(nlist, 0), ArrayGet(nlist, Subtract(nn, 1))) ThenBlock: {
                        nn = Subtract(nn, 1)
                    }
                }
                IfCondition GreaterEqual(nn, 3) ThenBlock: {
                    nout = 0
                    i = 0
                    WhileLoop LessThan(i, nn) {
                        S = CAD_Topo_State.digon_S
                        nlist = ArrayGet(S, 428)
                        carr = ArrayGet(S, 429)
                        reg_a = ArrayGet(S, 400)
                        reg_b = ArrayGet(S, 401)
                        reg_e = ArrayGet(S, 402)
                        pt = ArrayGet(S, 404)
                        p1b = ArrayGet(S, 405)
                        nreg = ArrayGet(S, 420)
                        jn = Add(i, 1)
                        IfCondition EqualTo(jn, nn) ThenBlock: { jn = 0 }
                        ua = ArrayGet(nlist, i)
                        ub = ArrayGet(nlist, jn)
                        IfCondition NotEqual(ua, ub) ThenBlock: {
                            ee = 0
                            ri = 0
                            WhileLoop LessThan(ri, nreg) {
                                IfCondition EqualTo(ArrayGet(reg_a, ri), ua) ThenBlock: {
                                    IfCondition EqualTo(ArrayGet(reg_b, ri), ub) ThenBlock: { ee = ArrayGet(reg_e, ri) }
                                }
                                IfCondition EqualTo(ArrayGet(reg_a, ri), ub) ThenBlock: {
                                    IfCondition EqualTo(ArrayGet(reg_b, ri), ua) ThenBlock: { ee = ArrayGet(reg_e, ri) }
                                }
                                ri = Add(ri, 1)
                            }
                            IfCondition EqualTo(ee, 0) ThenBlock: {
                                ArraySet(pt, 0, CAD_Store.Read(ua, 0))
                                ArraySet(pt, 1, CAD_Store.Read(ua, 1))
                                ArraySet(pt, 2, CAD_Store.Read(ua, 2))
                                ArraySet(p1b, 0, CAD_Store.Read(ub, 0))
                                ArraySet(p1b, 1, CAD_Store.Read(ub, 1))
                                ArraySet(p1b, 2, CAD_Store.Read(ub, 2))
                                ee = CAD_Topo.MakeEdge(ua, ub, CAD_Geom.MakeLine(pt, p1b))
                                S = CAD_Topo_State.digon_S
                                reg_a = ArrayGet(S, 400)
                                reg_b = ArrayGet(S, 401)
                                reg_e = ArrayGet(S, 402)
                                nreg = ArrayGet(S, 420)
                                ArraySet(reg_a, nreg, ua)
                                ArraySet(reg_b, nreg, ub)
                                ArraySet(reg_e, nreg, ee)
                                ArraySet(S, 420, Add(nreg, 1))
                            }
                            sn = 1
                            IfCondition NotEqual(CAD_Store.Read(ee, 0), ua) ThenBlock: { sn = 0 }
                            cee = CAD_Topo.MakeCoedge(ee, ua, sn)
                            S = CAD_Topo_State.digon_S
                            carr = ArrayGet(S, 429)
                            ArraySet(carr, nout, cee)
                            nout = Add(nout, 1)
                            CAD_Topo.DigonBindCoedge(ee, cee)
                        }
                        i = Add(i, 1)
                    }
                    IfCondition GreaterEqual(nout, 3) ThenBlock: {
                        S = CAD_Topo_State.digon_S
                        carr = ArrayGet(S, 429)
                        lh = CAD_Topo.MakeLoop(ArrayGet(carr, 0))
                        S = CAD_Topo_State.digon_S
                        carr = ArrayGet(S, 429)
                        CAD_Topo.LinkLoopRing(carr, nout, lh)
                        S = CAD_Topo_State.digon_S
                        prev = ArrayGet(S, 423)
                        CAD_Store.Write(prev, 2, lh)
                        nf = CAD_Store.Read(prev, 1)
                        CAD_Store.Write(lh, 1, nf)
                        ArraySet(S, 423, lh)
                        natt = Add(natt, 1)
                    }
                }
                S = CAD_Topo_State.digon_S
                inner = CAD_Store.Read(ArrayGet(S, 430), 2)
                }
            }
            hguard = Add(hguard, 1)
        }
        S = CAD_Topo_State.digon_S
        Deallocate(ArrayGet(S, 428), 16384)
        Deallocate(ArrayGet(S, 429), 16384)
        ArraySet(S, 428, 0)
        ArraySet(S, 429, 0)
        IfCondition GreaterThan(natt, 0) ThenBlock: {
            PrintMessage("digon attach inner n=")
            PrintNumber(natt)
            PrintMessage("\n")
        }
        ReturnValue(natt)
    }
}

// Rebuild one original plane face (wall or bottom) with P_ww substitutions.
// face handle in digon_k (reused). Returns new face or 0 if skipped.
Function.CAD_Topo.DigonRebuildFace {
    Input: prev_f: Integer
    Output: Integer
    Body: {
        // Rebuild one original plane face with cycle corners → P_ww.
        // Shared DigonMapVert so walls/bottom stitch (manifold).
        CAD_Topo_State.digon_prev_f = prev_f
        S = CAD_Topo_State.digon_S
        face = CAD_Topo_State.digon_k
        ArraySet(S, 445, CAD_Store.Read(face, 3))
        fcap = ArrayGet(S, 307)
        IfCondition EqualTo(face, fcap) ThenBlock: { ReturnValue(prev_f) }
        old_s = CAD_Store.Read(face, 0)
        sk = 0
        IfCondition NotEqual(old_s, 0) ThenBlock: { sk = CAD_Store.Read(old_s, 0) }
        ArraySet(S, 447, sk)
        loop_h = CAD_Store.Read(face, 1)
        ArraySet(S, 422, loop_h)
        head = CAD_Store.Read(loop_h, 0)
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(prev_f) }
        // Faces with no cycle corner (boss top on a step fillet) stay as-is
        // so Digon does not clone a second twisted cap.
        has_c = 0
        ce = head
        cguard = 0
        n_edges = ArrayGet(S, 304)
        WhileLoop LessThan(cguard, 2048) {
            S = CAD_Topo_State.digon_S
            n_edges = ArrayGet(S, 304)
            ov = CAD_Store.Read(ce, 5)
            i = 0
            WhileLoop LessThan(i, n_edges) {
                S = CAD_Topo_State.digon_S
                IfCondition EqualTo(ov, ArrayGet(S, Add(80, i))) ThenBlock: { has_c = 1 }
                IfCondition EqualTo(ov, ArrayGet(S, Add(32, i))) ThenBlock: { has_c = 1 }
                IfCondition EqualTo(ov, ArrayGet(S, Add(48, i))) ThenBlock: { has_c = 1 }
                i = Add(i, 1)
            }
            ed = CAD_Store.Read(ce, 0)
            IfCondition NotEqual(ed, 0) ThenBlock: {
                S = CAD_Topo_State.digon_S
                reg_a = ArrayGet(S, 400)
                reg_b = ArrayGet(S, 401)
                reg_e = ArrayGet(S, 402)
                nreg = ArrayGet(S, 420)
                ArraySet(reg_a, nreg, CAD_Store.Read(ed, 0))
                ArraySet(reg_b, nreg, CAD_Store.Read(ed, 1))
                ArraySet(reg_e, nreg, ed)
                ArraySet(S, 420, Add(nreg, 1))
            }
            S = CAD_Topo_State.digon_S
            ce = CAD_Store.Read(ce, 2)
            cguard = Add(cguard, 1)
            IfCondition EqualTo(ce, head) ThenBlock: { cguard = 2048 }
            IfCondition EqualTo(ce, 0) ThenBlock: { cguard = 2048 }
        }
        IfCondition EqualTo(has_c, 0) ThenBlock: {
            pf = CAD_Topo_State.digon_prev_f
            IfCondition NotEqual(pf, 0) ThenBlock: { CAD_Store.Write(pf, 3, face) }
            CAD_Store.Write(face, 3, 0)
            ReturnValue(face)
        }
        // Existing cove/fillet cylinders that touch a cycle vert: still
        // keep them. Rebuilding as a plane turns the cove into a chamfer.
        S = CAD_Topo_State.digon_S
        sk = ArrayGet(S, 447)
        IfCondition NotEqual(sk, 1) ThenBlock: {
            pf = CAD_Topo_State.digon_prev_f
            IfCondition NotEqual(pf, 0) ThenBlock: { CAD_Store.Write(pf, 3, face) }
            CAD_Store.Write(face, 3, 0)
            ReturnValue(face)
        }
        tmp = Allocate(256)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 417, tmp)
        nn = 0
        ce = head
        cguard = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            ov = CAD_Store.Read(ce, 5)
            nv = CAD_Topo.DigonMapVert(ov)
            S = CAD_Topo_State.digon_S
            nlist = ArrayGet(S, 417)
            // skip null / consecutive duplicate (zero-length)
            add = 1
            IfCondition EqualTo(nv, 0) ThenBlock: { add = 0 }
            IfCondition GreaterThan(nn, 0) ThenBlock: {
                IfCondition EqualTo(nv, ArrayGet(nlist, Subtract(nn, 1))) ThenBlock: { add = 0 }
            }
            IfCondition EqualTo(add, 1) ThenBlock: {
                ArraySet(nlist, nn, nv)
                nn = Add(nn, 1)
            }
            ce = CAD_Store.Read(ce, 2)
            cguard = Add(cguard, 1)
            IfCondition EqualTo(ce, head) ThenBlock: { done = 1 }
            IfCondition GreaterThan(cguard, 2048) ThenBlock: { done = 1 }
        }
        S = CAD_Topo_State.digon_S
        nlist = ArrayGet(S, 417)
        // close-ring dedup
        IfCondition GreaterThan(nn, 1) ThenBlock: {
            IfCondition EqualTo(ArrayGet(nlist, 0), ArrayGet(nlist, Subtract(nn, 1))) ThenBlock: {
                nn = Subtract(nn, 1)
            }
        }
        IfCondition LessThan(nn, 3) ThenBlock: {
            Deallocate(ArrayGet(S, 417), 256)
            ArraySet(S, 417, 0)
            ReturnValue(prev_f)
        }
        // If rebuilt ring faces opposite the original plane, reverse it
        // (missing front wall / noendclosure when viewed from outside).
        S = CAD_Topo_State.digon_S
        nlist = ArrayGet(S, 417)
        pl = ArrayGet(S, 409)
        CAD_Topo.FaceGetPlane(face, pl)
        S = CAD_Topo_State.digon_S
        nlist = ArrayGet(S, 417)
        pl = ArrayGet(S, 409)
        ua = ArrayGet(nlist, 0)
        ub = ArrayGet(nlist, 1)
        uc = ArrayGet(nlist, 2)
        e1x = Float_Sub(CAD_Store.Read(ub, 0), CAD_Store.Read(ua, 0))
        e1y = Float_Sub(CAD_Store.Read(ub, 1), CAD_Store.Read(ua, 1))
        e1z = Float_Sub(CAD_Store.Read(ub, 2), CAD_Store.Read(ua, 2))
        e2x = Float_Sub(CAD_Store.Read(uc, 0), CAD_Store.Read(ua, 0))
        e2y = Float_Sub(CAD_Store.Read(uc, 1), CAD_Store.Read(ua, 1))
        e2z = Float_Sub(CAD_Store.Read(uc, 2), CAD_Store.Read(ua, 2))
        nx = Float_Sub(Float_Mul(e1y, e2z), Float_Mul(e1z, e2y))
        ny = Float_Sub(Float_Mul(e1z, e2x), Float_Mul(e1x, e2z))
        nz = Float_Sub(Float_Mul(e1x, e2y), Float_Mul(e1y, e2x))
        dp = Float_Add(Float_Add(Float_Mul(nx, ArrayGet(pl, 10)), Float_Mul(ny, ArrayGet(pl, 11))), Float_Mul(nz, ArrayGet(pl, 12)))
        IfCondition EqualTo(CAD_Num.IsNeg(dp), 1) ThenBlock: {
            lo = 0
            hi = Subtract(nn, 1)
            WhileLoop LessThan(lo, hi) {
                tmpi = ArrayGet(nlist, lo)
                ArraySet(nlist, lo, ArrayGet(nlist, hi))
                ArraySet(nlist, hi, tmpi)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        tmp = Allocate(256)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 416, tmp)
        // build coedges; skip zero-length; share edges via reg
        nout = 0
        i = 0
        WhileLoop LessThan(i, nn) {
            S = CAD_Topo_State.digon_S
            nlist = ArrayGet(S, 417)
            carr = ArrayGet(S, 416)
            reg_a = ArrayGet(S, 400)
            reg_b = ArrayGet(S, 401)
            reg_e = ArrayGet(S, 402)
            pt = ArrayGet(S, 404)
            p1b = ArrayGet(S, 405)
            nreg = ArrayGet(S, 420)
            jn = Add(i, 1)
            IfCondition EqualTo(jn, nn) ThenBlock: { jn = 0 }
            ua = ArrayGet(nlist, i)
            ub = ArrayGet(nlist, jn)
            IfCondition NotEqual(ua, ub) ThenBlock: {
                ee = 0
                ri = 0
                WhileLoop LessThan(ri, nreg) {
                    IfCondition EqualTo(ArrayGet(reg_a, ri), ua) ThenBlock: {
                        IfCondition EqualTo(ArrayGet(reg_b, ri), ub) ThenBlock: { ee = ArrayGet(reg_e, ri) }
                    }
                    IfCondition EqualTo(ArrayGet(reg_a, ri), ub) ThenBlock: {
                        IfCondition EqualTo(ArrayGet(reg_b, ri), ua) ThenBlock: { ee = ArrayGet(reg_e, ri) }
                    }
                    ri = Add(ri, 1)
                }
                IfCondition EqualTo(ee, 0) ThenBlock: {
                    ArraySet(pt, 0, CAD_Store.Read(ua, 0))
                    ArraySet(pt, 1, CAD_Store.Read(ua, 1))
                    ArraySet(pt, 2, CAD_Store.Read(ua, 2))
                    ArraySet(p1b, 0, CAD_Store.Read(ub, 0))
                    ArraySet(p1b, 1, CAD_Store.Read(ub, 1))
                    ArraySet(p1b, 2, CAD_Store.Read(ub, 2))
                    ee = CAD_Topo.MakeEdge(ua, ub, CAD_Geom.MakeLine(pt, p1b))
                    S = CAD_Topo_State.digon_S
                    reg_a = ArrayGet(S, 400)
                    reg_b = ArrayGet(S, 401)
                    reg_e = ArrayGet(S, 402)
                    nreg = ArrayGet(S, 420)
                    ArraySet(reg_a, nreg, ua)
                    ArraySet(reg_b, nreg, ub)
                    ArraySet(reg_e, nreg, ee)
                    ArraySet(S, 420, Add(nreg, 1))
                }
                sn = 1
                IfCondition NotEqual(CAD_Store.Read(ee, 0), ua) ThenBlock: { sn = 0 }
                cee = CAD_Topo.MakeCoedge(ee, ua, sn)
                S = CAD_Topo_State.digon_S
                carr = ArrayGet(S, 416)
                ArraySet(carr, nout, cee)
                nout = Add(nout, 1)
                ca = CAD_Store.Read(ee, 3)
                IfCondition EqualTo(ca, 0) ThenBlock: { CAD_Store.Write(ee, 3, cee) }
                IfCondition NotEqual(ca, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(ee, 4), 0) ThenBlock: {
                        CAD_Store.Write(ee, 4, cee)
                        CAD_Topo.LinkTwins(ca, cee)
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(nout, 3) ThenBlock: {
            S = CAD_Topo_State.digon_S
            Deallocate(ArrayGet(S, 416), 256)
            Deallocate(ArrayGet(S, 417), 256)
            ArraySet(S, 416, 0)
            ArraySet(S, 417, 0)
            ReturnValue(prev_f)
        }
        S = CAD_Topo_State.digon_S
        carr = ArrayGet(S, 416)
        face = CAD_Topo_State.digon_k
        pl = ArrayGet(S, 409)
        pt = ArrayGet(S, 404)
        d1 = ArrayGet(S, 406)
        d2 = ArrayGet(S, 407)
        lp = CAD_Topo.MakeLoop(ArrayGet(carr, 0))
        S = CAD_Topo_State.digon_S
        carr = ArrayGet(S, 416)
        CAD_Topo.LinkLoopRing(carr, nout, lp)
        S = CAD_Topo_State.digon_S
        face = CAD_Topo_State.digon_k
        pl = ArrayGet(S, 409)
        pt = ArrayGet(S, 404)
        d1 = ArrayGet(S, 406)
        d2 = ArrayGet(S, 407)
        CAD_Topo.FaceGetPlane(face, pl)
        S = CAD_Topo_State.digon_S
        pl = ArrayGet(S, 409)
        pt = ArrayGet(S, 404)
        d1 = ArrayGet(S, 406)
        d2 = ArrayGet(S, 407)
        ArraySet(pt, 0, ArrayGet(pl, 1))
        ArraySet(pt, 1, ArrayGet(pl, 2))
        ArraySet(pt, 2, ArrayGet(pl, 3))
        ArraySet(d1, 0, ArrayGet(pl, 4))
        ArraySet(d1, 1, ArrayGet(pl, 5))
        ArraySet(d1, 2, ArrayGet(pl, 6))
        ArraySet(d2, 0, ArrayGet(pl, 7))
        ArraySet(d2, 1, ArrayGet(pl, 8))
        ArraySet(d2, 2, ArrayGet(pl, 9))
        surf = CAD_Geom.MakePlaneAxes(pt, d1, d2)
        ff = CAD_Topo.MakeFace(surf, lp)
        IfCondition EqualTo(ff, 0) ThenBlock: {
            S = CAD_Topo_State.digon_S
            Deallocate(ArrayGet(S, 416), 256)
            Deallocate(ArrayGet(S, 417), 256)
            ArraySet(S, 416, 0)
            ArraySet(S, 417, 0)
            ReturnValue(0)
        }
        pf = CAD_Topo_State.digon_prev_f
        IfCondition NotEqual(pf, 0) ThenBlock: { CAD_Store.Write(pf, 3, ff) }
        S = CAD_Topo_State.digon_S
        ArraySet(S, 423, CAD_Store.Read(ff, 1))
        CAD_Topo.DigonAttachInners()
        S = CAD_Topo_State.digon_S
        Deallocate(ArrayGet(S, 416), 256)
        Deallocate(ArrayGet(S, 417), 256)
        ArraySet(S, 416, 0)
        ArraySet(S, 417, 0)
        ReturnValue(ff)
    }
}

// OCC digon equal-R on a cycle of plane–plane edges sharing one face.
Function.CAD_Topo.DigonFree {
    Output: Integer
    Body: {
        S = CAD_Topo_State.digon_S
        IfCondition EqualTo(S, 0) ThenBlock: { ReturnValue(0) }
        p = ArrayGet(S, 400)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 2048) }
        p = ArrayGet(S, 401)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 2048) }
        p = ArrayGet(S, 402)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 2048) }
        p = ArrayGet(S, 403)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 128) }
        p = ArrayGet(S, 404)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 64) }
        p = ArrayGet(S, 405)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 64) }
        p = ArrayGet(S, 406)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 64) }
        p = ArrayGet(S, 407)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 64) }
        p = ArrayGet(S, 408)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 64) }
        p = ArrayGet(S, 409)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 128) }
        p = ArrayGet(S, 410)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 64) }
        p = ArrayGet(S, 411)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 64) }
        p = ArrayGet(S, 412)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 64) }
        p = ArrayGet(S, 413)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 64) }
        p = ArrayGet(S, 414)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 128) }
        p = ArrayGet(S, 415)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 64) }
        p = ArrayGet(S, 418)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 2048) }
        p = ArrayGet(S, 419)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 2048) }
        p = ArrayGet(S, 453)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 256) }
        p = ArrayGet(S, 454)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 256) }
        p = ArrayGet(S, 455)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 256) }
        p = ArrayGet(S, 456)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 256) }
        p = ArrayGet(S, 457)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 256) }
        p = ArrayGet(S, 458)
        IfCondition NotEqual(p, 0) ThenBlock: { Deallocate(p, 256) }
        Deallocate(S, 4096)
        CAD_Topo_State.digon_S = 0
        ReturnValue(0)
    }
}

Function.CAD_Topo.FilletPlaneEdgesDigon {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        // Thin orchestrator only — all state on digon_S.
        // ArrayGet/Set use offset = 8 + index*8 (qword slots). digon_S needs
        // slots through ~432 → Allocate >= 8+433*8 ≈ 3.5KB. 512 was overrun
        // (poisoned Arena freelist → SEGV on next Allocate after cylinders).
        IfCondition LessThan(n_edges, 3) ThenBlock: { ReturnValue(0) }
        shell0 = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(shell0, 0) ThenBlock: { ReturnValue(0) }
        S = Allocate(4096)
        IfCondition EqualTo(S, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_State.digon_S = S
        zi = 400
        WhileLoop LessThan(zi, 420) {
            ArraySet(S, zi, 0)
            zi = Add(zi, 1)
        }
        // Pin buffers one-at-a-time; reload S from pool after each Allocate
        // reg arrays: nreg can grow with walls; 2048 B ≈ 255 slots
        tmp = Allocate(2048)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 400, tmp)
        tmp = Allocate(2048)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 401, tmp)
        tmp = Allocate(2048)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 402, tmp)
        // frame OXYZ 12 qwords → need ≥104 B
        tmp = Allocate(128)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 403, tmp)
        // pt/p1b 3 qwords each → need ≥32 B; use 64 for margin
        tmp = Allocate(64)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 404, tmp)
        tmp = Allocate(64)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 405, tmp)
        // d1/d2 3 qwords
        tmp = Allocate(64)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 406, tmp)
        tmp = Allocate(64)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 407, tmp)
        // ring 4 coedges → need ≥40 B
        tmp = Allocate(64)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 408, tmp)
        // pl FaceGetPlane 13 qwords
        tmp = Allocate(128)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 409, tmp)
        // na/nb/nc/vv 3 qwords; out9 9 qwords; faces 2
        tmp = Allocate(64)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 410, tmp)
        tmp = Allocate(64)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 411, tmp)
        tmp = Allocate(64)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 412, tmp)
        tmp = Allocate(64)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 413, tmp)
        tmp = Allocate(128)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 414, tmp)
        tmp = Allocate(64)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 415, tmp)
        // shared vert map for wall/bottom rebuild (manifold stitch)
        tmp = Allocate(2048)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 418, tmp)
        tmp = Allocate(2048)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 419, tmp)
        ArraySet(S, 421, 0)
        // ball-corner verts/arcs (12 slots each)
        tmp = Allocate(256)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 453, tmp)
        tmp = Allocate(256)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 454, tmp)
        tmp = Allocate(256)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 455, tmp)
        tmp = Allocate(256)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 456, tmp)
        tmp = Allocate(256)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 457, tmp)
        tmp = Allocate(256)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 458, tmp)
        S = CAD_Topo_State.digon_S
        ArraySet(S, 304, n_edges)
        ArraySet(S, 305, radius_r)
        ArraySet(S, 306, shell0)
        ArraySet(S, 446, solid_handle)
        ArraySet(S, 450, 0)
        // collect edges
        i = 0
        WhileLoop LessThan(i, n_edges) {
            S = CAD_Topo_State.digon_S
            ft = ArrayGet(S, 415)
            ed = ArrayGet(edges_addr, i)
            IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(ed, ft), 0) ThenBlock: {
                CAD_Topo.DigonFree()
                ReturnValue(0)
            }
            S = CAD_Topo_State.digon_S
            ft = ArrayGet(S, 415)
            ArraySet(S, i, ArrayGet(ft, 0))
            ArraySet(S, Add(16, i), ArrayGet(ft, 1))
            ArraySet(S, Add(32, i), CAD_Store.Read(ed, 0))
            ArraySet(S, Add(48, i), CAD_Store.Read(ed, 1))
            ArraySet(S, Add(448, i), ed)
            i = Add(i, 1)
            n_edges = ArrayGet(CAD_Topo_State.digon_S, 304)
        }
        // fcap
        S = CAD_Topo_State.digon_S
        n_edges = ArrayGet(S, 304)
        fcap = ArrayGet(S, 0)
        i = 1
        WhileLoop LessThan(i, n_edges) {
            hit = 0
            IfCondition EqualTo(ArrayGet(S, i), fcap) ThenBlock: { hit = 1 }
            IfCondition EqualTo(ArrayGet(S, Add(16, i)), fcap) ThenBlock: { hit = 1 }
            IfCondition EqualTo(hit, 0) ThenBlock: { fcap = 0 }
            i = Add(i, 1)
        }
        IfCondition EqualTo(fcap, 0) ThenBlock: {
            fcap = ArrayGet(S, 16)
            i = 0
            WhileLoop LessThan(i, n_edges) {
                hit = 0
                IfCondition EqualTo(ArrayGet(S, i), fcap) ThenBlock: { hit = 1 }
                IfCondition EqualTo(ArrayGet(S, Add(16, i)), fcap) ThenBlock: { hit = 1 }
                IfCondition EqualTo(hit, 0) ThenBlock: {
                    CAD_Topo.DigonFree()
                    ReturnValue(0)
                }
                i = Add(i, 1)
            }
        }
        ArraySet(S, 307, fcap)
        IfCondition NotEqual(CAD_Topo_State.fillet_host_f, 0) ThenBlock: {
            fcap = CAD_Topo_State.fillet_host_f
            ArraySet(S, 307, fcap)
        }
        ArraySet(S, 432, 0)
        // Cove vs fillet: occupancy of ±N1±N2 (void ≤180° vs >180°).
        // S[450] is the flag; S[431] is later e_gc and must not hold it.
        ArraySet(S, 450, 0)
        IfCondition EqualTo(CAD_Topo.EdgeIsCove(ArrayGet(S, 446), ArrayGet(S, 448)), 1) ThenBlock: {
            S = CAD_Topo_State.digon_S
            ArraySet(S, 450, 1)
        }
        S = CAD_Topo_State.digon_S
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            ArraySet(S, 450, 1)
        }
        IfCondition EqualTo(ArrayGet(S, 450), 1) ThenBlock: {
            CAD_Topo_State.fillet_concave = 1
        }
        // Inner-loop walk only picks the HOST cap (plate), never the mode.
        S = CAD_Topo_State.digon_S
        ArraySet(S, 440, CAD_Store.Read(ArrayGet(S, 446), 0))
        WhileLoop NotEqual(ArrayGet(S, 440), 0) {
            S = CAD_Topo_State.digon_S
            ArraySet(S, 441, CAD_Store.Read(ArrayGet(S, 440), 0))
            ArraySet(S, 442, CAD_Store.Read(ArrayGet(S, 440), 2))
            WhileLoop NotEqual(ArrayGet(S, 441), 0) {
                S = CAD_Topo_State.digon_S
                ArraySet(S, 443, CAD_Store.Read(ArrayGet(S, 441), 3))
                ArraySet(S, 444, 0)
                WhileLoop LessThan(ArrayGet(S, 444), ArrayGet(S, 304)) {
                    S = CAD_Topo_State.digon_S
                    ed = ArrayGet(S, Add(448, ArrayGet(S, 444)))
                    IfCondition EqualTo(CAD_Topo.EdgeOnInnerLoop(ed, ArrayGet(CAD_Topo_State.digon_S, 441)), 1) ThenBlock: {
                        S = CAD_Topo_State.digon_S
                        ArraySet(S, 307, ArrayGet(S, 441))
                    }
                    S = CAD_Topo_State.digon_S
                    ArraySet(S, 444, Add(ArrayGet(S, 444), 1))
                }
                S = CAD_Topo_State.digon_S
                ArraySet(S, 441, ArrayGet(S, 443))
            }
            S = CAD_Topo_State.digon_S
            ArraySet(S, 440, ArrayGet(S, 442))
        }
        S = CAD_Topo_State.digon_S
        IfCondition EqualTo(ArrayGet(S, 450), 1) ThenBlock: {
            PrintMessage("digon COVE void<=180 +R pocket\n")
        }
        IfCondition EqualTo(ArrayGet(S, 450), 0) ThenBlock: {
            PrintMessage("digon FILLET void>180 -R rim\n")
        }
        S = CAD_Topo_State.digon_S
        fcap = ArrayGet(S, 307)
        pl = ArrayGet(S, 409)
        nc = ArrayGet(S, 412)
        CAD_Topo.FaceGetPlane(fcap, pl)
        S = CAD_Topo_State.digon_S
        pl = ArrayGet(S, 409)
        nc = ArrayGet(S, 412)
        ArraySet(nc, 0, ArrayGet(pl, 10))
        ArraySet(nc, 1, ArrayGet(pl, 11))
        ArraySet(nc, 2, ArrayGet(pl, 12))
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(nc, 0), ArrayGet(nc, 0)), Float_Mul(ArrayGet(nc, 1), ArrayGet(nc, 1))), Float_Mul(ArrayGet(nc, 2), ArrayGet(nc, 2))))
        ArraySet(nc, 0, Float_Div(ArrayGet(nc, 0), ln))
        ArraySet(nc, 1, Float_Div(ArrayGet(nc, 1), ln))
        ArraySet(nc, 2, Float_Div(ArrayGet(nc, 2), ln))
        // pristine cap normal (DigonCornerAtK must not leave 412 flipped)
        ArraySet(S, 425, ArrayGet(nc, 0))
        ArraySet(S, 426, ArrayGet(nc, 1))
        ArraySet(S, 427, ArrayGet(nc, 2))
        // wall normals + dirs
        i = 0
        n_edges = ArrayGet(S, 304)
        WhileLoop LessThan(i, n_edges) {
            S = CAD_Topo_State.digon_S
            pl = ArrayGet(S, 409)
            fcap = ArrayGet(S, 307)
            wf = ArrayGet(S, i)
            IfCondition EqualTo(wf, fcap) ThenBlock: { wf = ArrayGet(S, Add(16, i)) }
            CAD_Topo.FaceGetPlane(wf, pl)
            S = CAD_Topo_State.digon_S
            pl = ArrayGet(S, 409)
            ArraySet(S, Add(96, i), ArrayGet(pl, 10))
            ArraySet(S, Add(112, i), ArrayGet(pl, 11))
            ArraySet(S, Add(128, i), ArrayGet(pl, 12))
            ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(S, Add(96, i)), ArrayGet(S, Add(96, i))), Float_Mul(ArrayGet(S, Add(112, i)), ArrayGet(S, Add(112, i)))), Float_Mul(ArrayGet(S, Add(128, i)), ArrayGet(S, Add(128, i)))))
            ArraySet(S, Add(96, i), Float_Div(ArrayGet(S, Add(96, i)), ln))
            ArraySet(S, Add(112, i), Float_Div(ArrayGet(S, Add(112, i)), ln))
            ArraySet(S, Add(128, i), Float_Div(ArrayGet(S, Add(128, i)), ln))
            v0 = ArrayGet(S, Add(32, i))
            v1 = ArrayGet(S, Add(48, i))
            ArraySet(S, Add(224, i), Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0)))
            ArraySet(S, Add(240, i), Float_Sub(CAD_Store.Read(v1, 1), CAD_Store.Read(v0, 1)))
            ArraySet(S, Add(256, i), Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2)))
            ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(S, Add(224, i)), ArrayGet(S, Add(224, i))), Float_Mul(ArrayGet(S, Add(240, i)), ArrayGet(S, Add(240, i)))), Float_Mul(ArrayGet(S, Add(256, i)), ArrayGet(S, Add(256, i)))))
            ArraySet(S, Add(224, i), Float_Div(ArrayGet(S, Add(224, i)), ln))
            ArraySet(S, Add(240, i), Float_Div(ArrayGet(S, Add(240, i)), ln))
            ArraySet(S, Add(256, i), Float_Div(ArrayGet(S, Add(256, i)), ln))
            i = Add(i, 1)
            n_edges = ArrayGet(CAD_Topo_State.digon_S, 304)
        }
        // cycle walk
        S = CAD_Topo_State.digon_S
        n_edges = ArrayGet(S, 304)
        ArraySet(S, 64, 0)
        i = 0
        WhileLoop LessThan(i, n_edges) {
            ArraySet(S, Add(288, i), 0)
            i = Add(i, 1)
        }
        ArraySet(S, 288, 1)
        ArraySet(S, 80, ArrayGet(S, 32))
        tip = ArrayGet(S, 48)
        ArraySet(S, 81, tip)
        k = 1
        WhileLoop LessThan(k, n_edges) {
            found = -1
            ntip = tip
            j = 0
            WhileLoop LessThan(j, n_edges) {
                IfCondition EqualTo(ArrayGet(S, Add(288, j)), 0) ThenBlock: {
                    IfCondition EqualTo(ArrayGet(S, Add(32, j)), tip) ThenBlock: {
                        found = j
                        ntip = ArrayGet(S, Add(48, j))
                    }
                    IfCondition EqualTo(found, -1) ThenBlock: {
                        IfCondition EqualTo(ArrayGet(S, Add(48, j)), tip) ThenBlock: {
                            found = j
                            ntip = ArrayGet(S, Add(32, j))
                        }
                    }
                }
                IfCondition NotEqual(found, -1) ThenBlock: { j = n_edges }
                j = Add(j, 1)
            }
            tip = ntip
            IfCondition EqualTo(found, -1) ThenBlock: {
                PrintMessage("[digon] cycle walk FAIL k=")
                PrintNumber(k)
                PrintMessage("\n")
                CAD_Topo.DigonFree()
                ReturnValue(0)
            }
            ArraySet(S, Add(64, k), found)
            ArraySet(S, Add(288, found), 1)
            ArraySet(S, Add(80, Add(k, 1)), tip)
            k = Add(k, 1)
        }
        IfCondition NotEqual(tip, ArrayGet(S, 80)) ThenBlock: {
            CAD_Topo.DigonFree()
            ReturnValue(0)
        }
        // corners + ball verts + cap arcs + ellipses
        k = 0
        WhileLoop LessThan(k, n_edges) {
            CAD_Topo_State.digon_k = k
            IfCondition EqualTo(CAD_Topo.DigonCornerAtK(0), 0) ThenBlock: {
                PrintMessage("[digon] CornerAtK FAIL k=")
                PrintNumber(CAD_Topo_State.digon_k)
                PrintMessage("\n")
                CAD_Topo.DigonFree()
                ReturnValue(0)
            }
            k = Add(k, 1)
            n_edges = ArrayGet(CAD_Topo_State.digon_S, 304)
        }
        k = 0
        n_edges = ArrayGet(CAD_Topo_State.digon_S, 304)
        WhileLoop LessThan(k, n_edges) {
            CAD_Topo_State.digon_k = k
            IfCondition EqualTo(CAD_Topo.DigonEllAtK(0), 0) ThenBlock: {
                CAD_Topo.DigonFree()
                ReturnValue(0)
            }
            k = Add(k, 1)
            n_edges = ArrayGet(CAD_Topo_State.digon_S, 304)
        }
        // register ellipses
        S = CAD_Topo_State.digon_S
        reg_a = ArrayGet(S, 400)
        reg_b = ArrayGet(S, 401)
        reg_e = ArrayGet(S, 402)
        nreg = 0
        k = 0
        n_edges = ArrayGet(S, 304)
        WhileLoop LessThan(k, n_edges) {
            ArraySet(reg_a, nreg, ArrayGet(S, Add(144, k)))
            ArraySet(reg_b, nreg, ArrayGet(S, Add(160, k)))
            ArraySet(reg_e, nreg, ArrayGet(S, Add(272, k)))
            nreg = Add(nreg, 1)
            k = Add(k, 1)
        }
        ArraySet(S, 420, nreg)
        // cylinders — store first/prev in pool to survive nested calls
        CAD_Topo_State.digon_first_f = 0
        CAD_Topo_State.digon_prev_f = 0
        k = 0
        n_edges = ArrayGet(CAD_Topo_State.digon_S, 304)
        WhileLoop LessThan(k, n_edges) {
            CAD_Topo_State.digon_k = k
            ff = CAD_Topo.DigonCylAtK(CAD_Topo_State.digon_prev_f)
            IfCondition EqualTo(ff, 0) ThenBlock: {
                CAD_Topo.DigonFree()
                ReturnValue(0)
            }
            IfCondition EqualTo(CAD_Topo_State.digon_first_f, 0) ThenBlock: {
                CAD_Topo_State.digon_first_f = ff
            }
            CAD_Topo_State.digon_prev_f = ff
            k = Add(k, 1)
            n_edges = ArrayGet(CAD_Topo_State.digon_S, 304)
        }
        // Register original edges (every loop, including cove inners)
        // BEFORE MakeCap so AttachInners twins the hole to existing
        // cylinders instead of MakeLine copies (open shell / torn cap).
        S = CAD_Topo_State.digon_S
        ArraySet(S, 440, ArrayGet(S, 306))
        WhileLoop NotEqual(ArrayGet(S, 440), 0) {
            S = CAD_Topo_State.digon_S
            ArraySet(S, 441, CAD_Store.Read(ArrayGet(S, 440), 0))
            ArraySet(S, 442, CAD_Store.Read(ArrayGet(S, 440), 2))
            WhileLoop NotEqual(ArrayGet(S, 441), 0) {
                S = CAD_Topo_State.digon_S
                ArraySet(S, 443, CAD_Store.Read(ArrayGet(S, 441), 3))
                ArraySet(S, 451, CAD_Store.Read(ArrayGet(S, 441), 1))
                ArraySet(S, 452, 0)
                WhileLoop NotEqual(ArrayGet(S, 451), 0) {
                    IfCondition GreaterThan(ArrayGet(S, 452), 8) ThenBlock: { ArraySet(S, 451, 0) }
                    IfCondition NotEqual(ArrayGet(S, 451), 0) ThenBlock: {
                        S = CAD_Topo_State.digon_S
                        hd = CAD_Store.Read(ArrayGet(S, 451), 0)
                        ce = hd
                        cg = 0
                        WhileLoop LessThan(cg, 2048) {
                            IfCondition EqualTo(ce, 0) ThenBlock: { cg = 2048 }
                            IfCondition NotEqual(ce, 0) ThenBlock: {
                                ed = CAD_Store.Read(ce, 0)
                                IfCondition NotEqual(ed, 0) ThenBlock: {
                                    S = CAD_Topo_State.digon_S
                                    nreg = ArrayGet(S, 420)
                                    ArraySet(ArrayGet(S, 400), nreg, CAD_Store.Read(ed, 0))
                                    ArraySet(ArrayGet(S, 401), nreg, CAD_Store.Read(ed, 1))
                                    ArraySet(ArrayGet(S, 402), nreg, ed)
                                    ArraySet(S, 420, Add(nreg, 1))
                                }
                                ce = CAD_Store.Read(ce, 2)
                                IfCondition EqualTo(ce, hd) ThenBlock: { cg = 2048 }
                            }
                            cg = Add(cg, 1)
                        }
                        S = CAD_Topo_State.digon_S
                        ArraySet(S, 451, CAD_Store.Read(ArrayGet(S, 451), 2))
                    }
                    S = CAD_Topo_State.digon_S
                    ArraySet(S, 452, Add(ArrayGet(S, 452), 1))
                }
                S = CAD_Topo_State.digon_S
                ArraySet(S, 441, ArrayGet(S, 443))
            }
            S = CAD_Topo_State.digon_S
            ArraySet(S, 440, ArrayGet(S, 442))
        }
        // cap
        ff = CAD_Topo.DigonMakeCap(CAD_Topo_State.digon_prev_f)
        IfCondition EqualTo(ff, 0) ThenBlock: {
            CAD_Topo.DigonFree()
            ReturnValue(0)
        }
        CAD_Topo_State.digon_prev_f = ff
        // Register original edges first so rebuilt walls reuse the
        // untouched faces' rims (boss top) instead of duplicate edges.
        S = CAD_Topo_State.digon_S
        shell0 = ArrayGet(S, 306)
        face = CAD_Store.Read(shell0, 0)
        fguard = 0
        WhileLoop NotEqual(face, 0) {
            S = CAD_Topo_State.digon_S
            ArraySet(S, 445, CAD_Store.Read(face, 3))
            lp = CAD_Store.Read(face, 1)
            IfCondition NotEqual(lp, 0) ThenBlock: {
                hd = CAD_Store.Read(lp, 0)
                ce = hd
                cg = 0
                WhileLoop LessThan(cg, 2048) {
                    IfCondition EqualTo(ce, 0) ThenBlock: { cg = 2048 }
                    IfCondition NotEqual(ce, 0) ThenBlock: {
                        ed = CAD_Store.Read(ce, 0)
                        IfCondition NotEqual(ed, 0) ThenBlock: {
                            S = CAD_Topo_State.digon_S
                            nreg = ArrayGet(S, 420)
                            ArraySet(ArrayGet(S, 400), nreg, CAD_Store.Read(ed, 0))
                            ArraySet(ArrayGet(S, 401), nreg, CAD_Store.Read(ed, 1))
                            ArraySet(ArrayGet(S, 402), nreg, ed)
                            ArraySet(S, 420, Add(nreg, 1))
                        }
                        ce = CAD_Store.Read(ce, 2)
                        IfCondition EqualTo(ce, hd) ThenBlock: { cg = 2048 }
                    }
                    cg = Add(cg, 1)
                }
            }
            S = CAD_Topo_State.digon_S
            face = ArrayGet(S, 445)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 64) ThenBlock: { face = 0 }
        }
        // walls + other plane faces (skip fcap inside DigonRebuildFace)
        S = CAD_Topo_State.digon_S
        shell0 = ArrayGet(S, 306)
        face = CAD_Store.Read(shell0, 0)
        fguard = 0
        WhileLoop NotEqual(face, 0) {
            CAD_Topo_State.digon_k = face
            nxt = CAD_Topo.DigonRebuildFace(CAD_Topo_State.digon_prev_f)
            IfCondition NotEqual(nxt, CAD_Topo_State.digon_prev_f) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_State.digon_first_f, 0) ThenBlock: {
                    CAD_Topo_State.digon_first_f = nxt
                }
                CAD_Topo_State.digon_prev_f = nxt
            }
            S = CAD_Topo_State.digon_S
            face = ArrayGet(S, 445)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 64) ThenBlock: { face = 0 }
        }
        first_f = CAD_Topo_State.digon_first_f
        prev_f = CAD_Topo_State.digon_prev_f
        IfCondition EqualTo(first_f, 0) ThenBlock: {
            CAD_Topo.DigonFree()
            ReturnValue(0)
        }
        CAD_Store.Write(prev_f, 3, 0)
        h_sh = CAD_Topo.MakeShell(first_f)
        ff = first_f
        fguard = 0
        WhileLoop NotEqual(ff, 0) {
            CAD_Store.Write(ff, 2, h_sh)
            ff = CAD_Store.Read(ff, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 64) ThenBlock: { ff = 0 }
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        CAD_Topo.DigonFree()
        ReturnValue(h_so)
    }
}

// Fillet every selected edge. After each rebuild, handles are dead —
// rebind by plane-pair + direction (EdgeSigFill / FindEdgeBySig).
Function.CAD_Topo.FilletEdgesSequential {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.solid = solid_handle
        CAD_Topo_FSeq.n = n_edges
        CAD_Topo_FSeq.r = radius_r
        IfCondition EqualTo(CAD_Topo_FSeq.sigs, 0) ThenBlock: { CAD_Topo_FSeq.sigs = Allocate(4096) }
        IfCondition EqualTo(CAD_Topo_FSeq.pack, 0) ThenBlock: { CAD_Topo_FSeq.pack = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.sigs, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            ArraySet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i), ArrayGet(edges_addr, CAD_Topo_FSeq.i))
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i))
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.EdgeSigFill(CAD_Topo_FSeq.e, CAD_Topo_FSeq.pack), 0) ThenBlock: {
                    CAD_Topo_FSeq.k = 0
                    WhileLoop LessThan(CAD_Topo_FSeq.k, 12) {
                        ArraySet(CAD_Topo_FSeq.sigs, Add(Multiply(CAD_Topo_FSeq.i, 12), CAD_Topo_FSeq.k), ArrayGet(CAD_Topo_FSeq.pack, CAD_Topo_FSeq.k))
                        CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
                    }
                }
            }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        CAD_Topo_FSeq.h = CAD_Topo_FSeq.solid
        CAD_Topo_FSeq.ok = 0
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            CAD_Topo_FSeq.k = 0
            WhileLoop LessThan(CAD_Topo_FSeq.k, 12) {
                ArraySet(CAD_Topo_FSeq.pack, CAD_Topo_FSeq.k, ArrayGet(CAD_Topo_FSeq.sigs, Add(Multiply(CAD_Topo_FSeq.i, 12), CAD_Topo_FSeq.k)))
                CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
            }
            // Live edge on the current solid (midpoint tie-break).
            // Stale pick handle after a join Digon is the wrong body.
            CAD_Topo_FSeq.e = CAD_Topo.FindEdgeBySig(CAD_Topo_FSeq.h, CAD_Topo_FSeq.pack)
            IfCondition EqualTo(CAD_Topo_FSeq.e, 0) ThenBlock: {
                CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i))
            }
            CAD_Topo_FSeq.nh = 0
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                CAD_Topo_FSeq.k = CAD_Store.Read(CAD_Topo_FSeq.e, 2)
                IfCondition NotEqual(CAD_Topo_FSeq.k, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FSeq.k, 0), 1) ThenBlock: {
                        CAD_Topo_FSeq.e = 0
                    }
                }
            }
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                CAD_Topo_FSeq.nh = CAD_Topo.FilletPlanePlaneEdge(CAD_Topo_FSeq.h, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r)
            }
            IfCondition NotEqual(CAD_Topo_FSeq.nh, 0) ThenBlock: {
                CAD_Topo_FSeq.h = CAD_Topo_FSeq.nh
                CAD_Topo_FSeq.ok = Add(CAD_Topo_FSeq.ok, 1)
                PrintMessage("fillet sequential ok i=")
                PrintNumber(CAD_Topo_FSeq.i)
                PrintMessage("\n")
            }
            IfCondition EqualTo(CAD_Topo_FSeq.nh, 0) ThenBlock: {
                PrintMessage("fillet sequential miss i=")
                PrintNumber(CAD_Topo_FSeq.i)
                PrintMessage("\n")
            }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        PrintMessage("fillet sequential done n=")
        PrintNumber(CAD_Topo_FSeq.ok)
        PrintMessage("\n")
        IfCondition EqualTo(CAD_Topo_FSeq.ok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Topo_FSeq.h)
    }
}

Function.CAD_Topo.FilletPlaneEdges {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_edges, 12) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(n_edges, 1) ThenBlock: {
            ReturnValue(CAD_Topo.FilletPlanePlaneEdge(solid_handle, ArrayGet(edges_addr, 0), radius_r))
        }
        // Split same-Z rims (Digon cycle) from verticals (sequential local).
        // A mixed 4-top+4-vertical batch used to skip Digon and sequential-
        // inset the cap into a trapezoid (brokenprojection.png).
        IfCondition EqualTo(CAD_Topo_FSeq.horiz, 0) ThenBlock: { CAD_Topo_FSeq.horiz = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.vert, 0) ThenBlock: { CAD_Topo_FSeq.vert = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.horiz, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.r = radius_r
        CAD_Topo_FSeq.solid = solid_handle
        CAD_Topo_FSeq.nH = 0
        CAD_Topo_FSeq.nV = 0
        CAD_Topo_FSeq.i = 0
        PrintMessage("fillet PlaneEdges n=")
        PrintNumber(n_edges)
        PrintMessage("\n")
        WhileLoop LessThan(CAD_Topo_FSeq.i, n_edges) {
            ei = ArrayGet(edges_addr, CAD_Topo_FSeq.i)
            dz = 0
            IfCondition NotEqual(ei, 0) ThenBlock: {
                va = CAD_Store.Read(ei, 0)
                vb = CAD_Store.Read(ei, 1)
                IfCondition NotEqual(va, 0) ThenBlock: {
                    IfCondition NotEqual(vb, 0) ThenBlock: {
                        dz = Float_Sub(CAD_Store.Read(vb, 2), CAD_Store.Read(va, 2))
                        IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(0, dz) }
                    }
                }
            }
            IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 1) ThenBlock: {
                ArraySet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.nH, ei)
                CAD_Topo_FSeq.nH = Add(CAD_Topo_FSeq.nH, 1)
            }
            IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 0) ThenBlock: {
                ArraySet(CAD_Topo_FSeq.vert, CAD_Topo_FSeq.nV, ei)
                CAD_Topo_FSeq.nV = Add(CAD_Topo_FSeq.nV, 1)
            }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        PrintMessage("fillet nH=")
        PrintNumber(CAD_Topo_FSeq.nH)
        PrintMessage(" nV=")
        PrintNumber(CAD_Topo_FSeq.nV)
        PrintMessage("\n")
        CAD_Topo_FSeq.h = solid_handle
        IfCondition GreaterEqual(CAD_Topo_FSeq.nH, 3) ThenBlock: {
            shared = 0
            CAD_Topo_FSeq.i = 0
            WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.nH) {
                ei = ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.i)
                v0 = CAD_Store.Read(ei, 0)
                v1 = CAD_Store.Read(ei, 1)
                CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.i, 1)
                WhileLoop LessThan(CAD_Topo_FSeq.k, CAD_Topo_FSeq.nH) {
                    ej = ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.k)
                    u0 = CAD_Store.Read(ej, 0)
                    u1 = CAD_Store.Read(ej, 1)
                    IfCondition EqualTo(v0, u0) ThenBlock: { shared = 1 }
                    IfCondition EqualTo(v0, u1) ThenBlock: { shared = 1 }
                    IfCondition EqualTo(v1, u0) ThenBlock: { shared = 1 }
                    IfCondition EqualTo(v1, u1) ThenBlock: { shared = 1 }
                    CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
                }
                CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
            }
            IfCondition EqualTo(shared, 1) ThenBlock: {
                // Sequential FilletEdgeLocal on a closed cycle is slow and
                // punches holes (Screenshot_2026-08-23_15-19-06). Digon is
                // the cycle path — it already keeps non-plane faces and
                // inner host-cap holes. Only a second shell is dropped.
                IfCondition GreaterThan(CAD_Topo.SolidCountShells(CAD_Topo_FSeq.solid), 1) ThenBlock: {
                    PrintMessage("fillet path=seq multi-shell\n")
                    shared = 0
                }
            }
            IfCondition EqualTo(shared, 1) ThenBlock: {
                PrintMessage("fillet path=digon horiz n=")
                PrintNumber(CAD_Topo_FSeq.nH)
                PrintMessage(" nV=")
                PrintNumber(CAD_Topo_FSeq.nV)
                PrintMessage("\n")
                // Pin vertical signatures before Digon kills their handles.
                IfCondition GreaterThan(CAD_Topo_FSeq.nV, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo_FSeq.sigs, 0) ThenBlock: { CAD_Topo_FSeq.sigs = Allocate(4096) }
                    IfCondition EqualTo(CAD_Topo_FSeq.pack, 0) ThenBlock: { CAD_Topo_FSeq.pack = Allocate(128) }
                    CAD_Topo_FSeq.i = 0
                    WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.nV) {
                        IfCondition EqualTo(CAD_Topo.EdgeSigFill(ArrayGet(CAD_Topo_FSeq.vert, CAD_Topo_FSeq.i), CAD_Topo_FSeq.pack), 0) ThenBlock: {
                            CAD_Topo_FSeq.k = 0
                            WhileLoop LessThan(CAD_Topo_FSeq.k, 12) {
                                ArraySet(CAD_Topo_FSeq.sigs, Add(Multiply(CAD_Topo_FSeq.i, 12), CAD_Topo_FSeq.k), ArrayGet(CAD_Topo_FSeq.pack, CAD_Topo_FSeq.k))
                                CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
                            }
                        }
                        CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
                    }
                }
                dig = CAD_Topo.FilletPlaneEdgesDigon(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.nH, CAD_Topo_FSeq.r)
                IfCondition NotEqual(dig, 0) ThenBlock: {
                    CAD_Topo_FSeq.h = dig
                    IfCondition EqualTo(CAD_Topo_FSeq.nV, 0) ThenBlock: { ReturnValue(dig) }
                    PrintMessage("fillet path=seq verticals n=")
                    PrintNumber(CAD_Topo_FSeq.nV)
                    PrintMessage("\n")
                    CAD_Topo_FSeq.i = 0
                    WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.nV) {
                        CAD_Topo_FSeq.k = 0
                        WhileLoop LessThan(CAD_Topo_FSeq.k, 12) {
                            ArraySet(CAD_Topo_FSeq.pack, CAD_Topo_FSeq.k, ArrayGet(CAD_Topo_FSeq.sigs, Add(Multiply(CAD_Topo_FSeq.i, 12), CAD_Topo_FSeq.k)))
                            CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
                        }
                        ArraySet(CAD_Topo_FSeq.vert, CAD_Topo_FSeq.i, CAD_Topo.FindEdgeBySig(CAD_Topo_FSeq.h, CAD_Topo_FSeq.pack))
                        CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
                    }
                    seq = CAD_Topo.FilletEdgesSequential(CAD_Topo_FSeq.h, CAD_Topo_FSeq.vert, CAD_Topo_FSeq.nV, CAD_Topo_FSeq.r)
                    IfCondition NotEqual(seq, 0) ThenBlock: { ReturnValue(seq) }
                    ReturnValue(CAD_Topo_FSeq.h)
                }
                PrintMessage("digon FAIL — sequential fallback\n")
            }
        }
        ReturnValue(CAD_Topo.FilletEdgesSequential(solid_handle, edges_addr, n_edges, radius_r))
    }
}
