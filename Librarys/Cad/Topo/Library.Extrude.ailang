// CAD.Topo.Extrude — wires of sketch curves become a solid.
//
// Ingest (only):
//   SweepReset
//   SweepBeginWire
//   SweepAddLine(x0,y0,x1,y1)
//   SweepAddArc(cx,cy,r,a0,a1)   full circle: a0=0 a1=2π
//   ExtrudeContours
//
// One algorithm. Line → plane wall. Arc/circle → cylinder wall.
// Caps = the wire loops. Wire 0 is the outer; wires 1.. are holes.
// No polyline dump. No combo table. No kind stamp.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

FixedPool.CAD_Topo_Sweep {
    "ncont":  Initialize=0, CanChange=True
    "hz":     Initialize=0, CanChange=True
    "ncurve": Initialize=0, CanChange=True
    "ckind":  Initialize=0, CanChange=True
    "cwire":  Initialize=0, CanChange=True
    "cx0":    Initialize=0, CanChange=True
    "cy0":    Initialize=0, CanChange=True
    "cx1":    Initialize=0, CanChange=True
    "cy1":    Initialize=0, CanChange=True
    "ca0":    Initialize=0, CanChange=True
    "ca1":    Initialize=0, CanChange=True
    "vb":     Initialize=0, CanChange=True
    "vt":     Initialize=0, CanChange=True
    "eb":     Initialize=0, CanChange=True
    "et":     Initialize=0, CanChange=True
    "ev":     Initialize=0, CanChange=True
    "csrf":   Initialize=0, CanChange=True
    "faces":  Initialize=0, CanChange=True
    "pt":     Initialize=0, CanChange=True
    "p1":     Initialize=0, CanChange=True
    "ax":     Initialize=0, CanChange=True
    "ay":     Initialize=0, CanChange=True
    "fr":     Initialize=0, CanChange=True
    "ring":   Initialize=0, CanChange=True
    "i":      Initialize=0, CanChange=True
    "j":      Initialize=0, CanChange=True
    "nf":     Initialize=0, CanChange=True
    "lp0":    Initialize=0, CanChange=True
    "lp1":    Initialize=0, CanChange=True
    "prev":   Initialize=0, CanChange=True
    "out":    Initialize=0, CanChange=True
    "sbot":   Initialize=0, CanChange=True
    "stop":   Initialize=0, CanChange=True
    "lph":    Initialize=0, CanChange=True
    "px0":    Initialize=0, CanChange=True
    "py0":    Initialize=0, CanChange=True
    "px1":    Initialize=0, CanChange=True
    "py1":    Initialize=0, CanChange=True
    "pa0":    Initialize=0, CanChange=True
    "pa1":    Initialize=0, CanChange=True
}

Function.CAD_Topo.SweepEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_Sweep.ckind, 0) ThenBlock: {
            CAD_Topo_Sweep.ckind = Allocate(16384)
            CAD_Topo_Sweep.cwire = Allocate(16384)
            CAD_Topo_Sweep.cx0 = Allocate(16384)
            CAD_Topo_Sweep.cy0 = Allocate(16384)
            CAD_Topo_Sweep.cx1 = Allocate(16384)
            CAD_Topo_Sweep.cy1 = Allocate(16384)
            CAD_Topo_Sweep.ca0 = Allocate(16384)
            CAD_Topo_Sweep.ca1 = Allocate(16384)
            CAD_Topo_Sweep.vb = Allocate(16384)
            CAD_Topo_Sweep.vt = Allocate(16384)
            CAD_Topo_Sweep.eb = Allocate(16384)
            CAD_Topo_Sweep.et = Allocate(16384)
            CAD_Topo_Sweep.ev = Allocate(16384)
            CAD_Topo_Sweep.csrf = Allocate(16384)
            CAD_Topo_Sweep.faces = Allocate(32768)
            CAD_Topo_Sweep.pt = Allocate(32)
            CAD_Topo_Sweep.p1 = Allocate(32)
            CAD_Topo_Sweep.ax = Allocate(32)
            CAD_Topo_Sweep.ay = Allocate(32)
            CAD_Topo_Sweep.fr = Allocate(128)
            CAD_Topo_Sweep.ring = Allocate(16384)
        }
        IfCondition EqualTo(CAD_Topo_Sweep.ckind, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Topo_Sweep.pt, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.CAD_Topo.SweepReset {
    Output: Integer
    Body: {
        CAD_Topo.SweepEnsure()
        CAD_Topo_Sweep.ncont = 0
        CAD_Topo_Sweep.ncurve = 0
        ReturnValue(0)
    }
}

Function.CAD_Topo.SweepBeginWire {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Topo.SweepEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(CAD_Topo_Sweep.ncont, 32) ThenBlock: { ReturnValue(-1) }
        CAD_Topo_Sweep.ncont = Add(CAD_Topo_Sweep.ncont, 1)
        ReturnValue(Subtract(CAD_Topo_Sweep.ncont, 1))
    }
}

// Uses CAD_Topo_Sweep.px0,py0,px1,py1 already pinned. No float args.
Function.CAD_Topo.SweepAddLinePinned {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Topo.SweepEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(CAD_Topo_Sweep.ncurve, 256) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Topo_Sweep.ncont, 0) ThenBlock: { CAD_Topo.SweepBeginWire() }
        CAD_Topo_Sweep.j = CAD_Topo_Sweep.ncurve
        ArraySet(CAD_Topo_Sweep.ckind, CAD_Topo_Sweep.j, 0)
        ArraySet(CAD_Topo_Sweep.cx0, CAD_Topo_Sweep.j, CAD_Topo_Sweep.px0)
        ArraySet(CAD_Topo_Sweep.cy0, CAD_Topo_Sweep.j, CAD_Topo_Sweep.py0)
        ArraySet(CAD_Topo_Sweep.cx1, CAD_Topo_Sweep.j, CAD_Topo_Sweep.px1)
        ArraySet(CAD_Topo_Sweep.cy1, CAD_Topo_Sweep.j, CAD_Topo_Sweep.py1)
        ArraySet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.j, Subtract(CAD_Topo_Sweep.ncont, 1))
        CAD_Topo_Sweep.ncurve = Add(CAD_Topo_Sweep.j, 1)
        ReturnValue(CAD_Topo_Sweep.j)
    }
}

Function.CAD_Topo.SweepAddLine {
    Input: x0_r: Integer
    Input: y0_r: Integer
    Input: x1_r: Integer
    Input: y1_r: Integer
    Output: Integer
    Body: {
        CAD_Topo_Sweep.px0 = x0_r
        CAD_Topo_Sweep.py0 = y0_r
        CAD_Topo_Sweep.px1 = x1_r
        CAD_Topo_Sweep.py1 = y1_r
        ReturnValue(CAD_Topo.SweepAddLinePinned())
    }
}

// Uses px0,py0,px1=r,pa0,pa1 already pinned. No float args (5-arg ABI clobber).
// Sketch AddArc: a1 may be < a0 (crosses 0); span = a1-a0+2π.
// A 90° fillet at π → −π/2 must stay π/2, not −3π/2 (broken4fillet.png).
Function.CAD_Topo.SweepAddArcPinned {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Topo.SweepEnsure(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_Sweep.px1, 0), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(CAD_Topo_Sweep.ncurve, 256) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Topo_Sweep.ncont, 0) ThenBlock: { CAD_Topo.SweepBeginWire() }
        CAD_Topo_Sweep.j = CAD_Topo_Sweep.ncurve
        ArraySet(CAD_Topo_Sweep.ckind, CAD_Topo_Sweep.j, 2)
        ArraySet(CAD_Topo_Sweep.cx0, CAD_Topo_Sweep.j, CAD_Topo_Sweep.px0)
        ArraySet(CAD_Topo_Sweep.cy0, CAD_Topo_Sweep.j, CAD_Topo_Sweep.py0)
        ArraySet(CAD_Topo_Sweep.cx1, CAD_Topo_Sweep.j, CAD_Topo_Sweep.px1)
        ArraySet(CAD_Topo_Sweep.ca0, CAD_Topo_Sweep.j, CAD_Topo_Sweep.pa0)
        ArraySet(CAD_Topo_Sweep.ca1, CAD_Topo_Sweep.j, CAD_Topo_Sweep.pa1)
        ArraySet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.j, Subtract(CAD_Topo_Sweep.ncont, 1))
        CAD_Topo_Sweep.ncurve = Add(CAD_Topo_Sweep.j, 1)
        ReturnValue(CAD_Topo_Sweep.j)
    }
}

// Circular curve on the current wire. Full circle = a0=0 a1=2π.
Function.CAD_Topo.SweepAddArc {
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: rad_r: Integer
    Input: a0_r: Integer
    Input: a1_r: Integer
    Output: Integer
    Body: {
        CAD_Topo_Sweep.px0 = cx_r
        CAD_Topo_Sweep.py0 = cy_r
        CAD_Topo_Sweep.px1 = rad_r
        CAD_Topo_Sweep.pa0 = a0_r
        CAD_Topo_Sweep.pa1 = a1_r
        ReturnValue(CAD_Topo.SweepAddArcPinned())
    }
}

Function.CAD_Topo.SweepNextInWire {
    Input: k: Integer
    Output: Integer
    Body: {
        CAD_Topo_Sweep.prev = ArrayGet(CAD_Topo_Sweep.cwire, k)
        CAD_Topo_Sweep.out = k
        CAD_Topo_Sweep.j = Add(k, 1)
        WhileLoop LessThan(CAD_Topo_Sweep.j, CAD_Topo_Sweep.ncurve) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.j), CAD_Topo_Sweep.prev) ThenBlock: {
                CAD_Topo_Sweep.out = CAD_Topo_Sweep.j
                CAD_Topo_Sweep.j = CAD_Topo_Sweep.ncurve
            }
            IfCondition NotEqual(CAD_Topo_Sweep.out, k) ThenBlock: {
                IfCondition LessThan(CAD_Topo_Sweep.j, CAD_Topo_Sweep.ncurve) ThenBlock: {
                    CAD_Topo_Sweep.j = CAD_Topo_Sweep.ncurve
                }
            }
            IfCondition EqualTo(CAD_Topo_Sweep.out, k) ThenBlock: {
                CAD_Topo_Sweep.j = Add(CAD_Topo_Sweep.j, 1)
            }
        }
        IfCondition EqualTo(CAD_Topo_Sweep.out, k) ThenBlock: {
            CAD_Topo_Sweep.j = 0
            WhileLoop LessThan(CAD_Topo_Sweep.j, k) {
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.j), CAD_Topo_Sweep.prev) ThenBlock: {
                    CAD_Topo_Sweep.out = CAD_Topo_Sweep.j
                    CAD_Topo_Sweep.j = k
                }
                IfCondition EqualTo(CAD_Topo_Sweep.out, k) ThenBlock: {
                    CAD_Topo_Sweep.j = Add(CAD_Topo_Sweep.j, 1)
                }
            }
        }
        ReturnValue(CAD_Topo_Sweep.out)
    }
}

// One curve → bottom/top edges + generator + side surface.
Function.CAD_Topo.SweepEmitCurve {
    Input: k: Integer
    Output: Integer
    Body: {
        CAD_Topo_Sweep.i = k
        CAD_Topo_Sweep.j = CAD_Topo.SweepNextInWire(k)
        CAD_Topo_Sweep.lp0 = ArrayGet(CAD_Topo_Sweep.vb, CAD_Topo_Sweep.i)
        CAD_Topo_Sweep.lp1 = ArrayGet(CAD_Topo_Sweep.vb, CAD_Topo_Sweep.j)
        CAD_Topo_Sweep.sbot = ArrayGet(CAD_Topo_Sweep.vt, CAD_Topo_Sweep.i)
        CAD_Topo_Sweep.stop = ArrayGet(CAD_Topo_Sweep.vt, CAD_Topo_Sweep.j)
        IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CAD_Topo_Sweep.i), 2) ThenBlock: {
            CAD_Topo_Sweep.prev = 0
            WhileLoop LessThan(CAD_Topo_Sweep.prev, 12) {
                ArraySet(CAD_Topo_Sweep.fr, CAD_Topo_Sweep.prev, 0)
                CAD_Topo_Sweep.prev = Add(CAD_Topo_Sweep.prev, 1)
            }
            ArraySet(CAD_Topo_Sweep.fr, 0, ArrayGet(CAD_Topo_Sweep.cx0, CAD_Topo_Sweep.i))
            ArraySet(CAD_Topo_Sweep.fr, 1, ArrayGet(CAD_Topo_Sweep.cy0, CAD_Topo_Sweep.i))
            ArraySet(CAD_Topo_Sweep.fr, 3, 0x3FF0000000000000)
            ArraySet(CAD_Topo_Sweep.fr, 7, 0x3FF0000000000000)
            // Pin a0 + signed span in fr[9], fr[10]. MakeCircle only reads
            // fr[0..8]. Log showed slot11=0 while span=-4 — ca0[] died.
            CAD_Topo_Sweep.out = CAD_Topo_Sweep.i
            ArraySet(CAD_Topo_Sweep.fr, 12, CAD_Topo_Sweep.i)
            ArraySet(CAD_Topo_Sweep.fr, 10, ArrayGet(CAD_Topo_Sweep.ca0, CAD_Topo_Sweep.i))
            ArraySet(CAD_Topo_Sweep.fr, 9, Float_Sub(ArrayGet(CAD_Topo_Sweep.ca1, CAD_Topo_Sweep.i), ArrayGet(CAD_Topo_Sweep.ca0, CAD_Topo_Sweep.i)))
            CAD_Topo_Sweep.lph = CAD_Geom.MakeCircle(CAD_Topo_Sweep.fr, ArrayGet(CAD_Topo_Sweep.cx1, CAD_Topo_Sweep.out))
            CAD_Store.Write(CAD_Topo_Sweep.lph, 11, ArrayGet(CAD_Topo_Sweep.fr, 10))
            CAD_Store.Write(CAD_Topo_Sweep.lph, 12, ArrayGet(CAD_Topo_Sweep.fr, 9))
            ArraySet(CAD_Topo_Sweep.fr, 2, CAD_Topo_Sweep.hz)
            CAD_Topo_Sweep.prev = CAD_Geom.MakeCircle(CAD_Topo_Sweep.fr, ArrayGet(CAD_Topo_Sweep.cx1, CAD_Topo_Sweep.out))
            CAD_Store.Write(CAD_Topo_Sweep.prev, 11, ArrayGet(CAD_Topo_Sweep.fr, 10))
            CAD_Store.Write(CAD_Topo_Sweep.prev, 12, ArrayGet(CAD_Topo_Sweep.fr, 9))
            CAD_Topo_Sweep.i = ArrayGet(CAD_Topo_Sweep.fr, 12)
            fd = SystemCall(2, "/tmp/cad_app/session.log", 1089, 420)
            CAD_Sys.Write(2, "pipe curve-wr\n", 14)
            IfCondition GreaterThan(fd, 0) ThenBlock: {
                SystemCall(1, fd, "pipe curve-wr\n", 14)
            }
            PrintMessage("pipe curve-wr bot11=")
            PrintNumber(CAD_Store.Read(CAD_Topo_Sweep.lph, 11))
            PrintMessage(" bot12=")
            PrintNumber(CAD_Store.Read(CAD_Topo_Sweep.lph, 12))
            PrintMessage(" top11=")
            PrintNumber(CAD_Store.Read(CAD_Topo_Sweep.prev, 11))
            PrintMessage(" top12=")
            PrintNumber(CAD_Store.Read(CAD_Topo_Sweep.prev, 12))
            PrintMessage("\n")
            IfCondition GreaterThan(fd, 0) ThenBlock: {
                SystemCall(3, fd, 0, 0)
            }
            ArraySet(CAD_Topo_Sweep.fr, 2, 0)
            ArraySet(CAD_Topo_Sweep.fr, 11, 0x3FF0000000000000)
            ArraySet(CAD_Topo_Sweep.csrf, CAD_Topo_Sweep.i, CAD_Geom.MakeCylinderSurf(CAD_Topo_Sweep.fr, ArrayGet(CAD_Topo_Sweep.cx1, CAD_Topo_Sweep.i)))
            ArraySet(CAD_Topo_Sweep.eb, CAD_Topo_Sweep.i, CAD_Topo.MakeEdge(CAD_Topo_Sweep.lp0, CAD_Topo_Sweep.lp1, CAD_Topo_Sweep.lph))
            ArraySet(CAD_Topo_Sweep.et, CAD_Topo_Sweep.i, CAD_Topo.MakeEdge(CAD_Topo_Sweep.sbot, CAD_Topo_Sweep.stop, CAD_Topo_Sweep.prev))
        }
        IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CAD_Topo_Sweep.i), 0) ThenBlock: {
            ArraySet(CAD_Topo_Sweep.pt, 0, CAD_Store.Read(CAD_Topo_Sweep.lp0, 0))
            ArraySet(CAD_Topo_Sweep.pt, 1, CAD_Store.Read(CAD_Topo_Sweep.lp0, 1))
            ArraySet(CAD_Topo_Sweep.pt, 2, 0)
            ArraySet(CAD_Topo_Sweep.p1, 0, CAD_Store.Read(CAD_Topo_Sweep.lp1, 0))
            ArraySet(CAD_Topo_Sweep.p1, 1, CAD_Store.Read(CAD_Topo_Sweep.lp1, 1))
            ArraySet(CAD_Topo_Sweep.p1, 2, 0)
            ArraySet(CAD_Topo_Sweep.eb, CAD_Topo_Sweep.i, CAD_Topo.MakeEdge(CAD_Topo_Sweep.lp0, CAD_Topo_Sweep.lp1, CAD_Geom.MakeLine(CAD_Topo_Sweep.pt, CAD_Topo_Sweep.p1)))
            ArraySet(CAD_Topo_Sweep.pt, 2, CAD_Topo_Sweep.hz)
            ArraySet(CAD_Topo_Sweep.p1, 2, CAD_Topo_Sweep.hz)
            ArraySet(CAD_Topo_Sweep.et, CAD_Topo_Sweep.i, CAD_Topo.MakeEdge(CAD_Topo_Sweep.sbot, CAD_Topo_Sweep.stop, CAD_Geom.MakeLine(CAD_Topo_Sweep.pt, CAD_Topo_Sweep.p1)))
            ArraySet(CAD_Topo_Sweep.pt, 0, CAD_Store.Read(CAD_Topo_Sweep.lp0, 0))
            ArraySet(CAD_Topo_Sweep.pt, 1, CAD_Store.Read(CAD_Topo_Sweep.lp0, 1))
            ArraySet(CAD_Topo_Sweep.pt, 2, 0)
            ArraySet(CAD_Topo_Sweep.p1, 0, CAD_Store.Read(CAD_Topo_Sweep.lp1, 0))
            ArraySet(CAD_Topo_Sweep.p1, 1, CAD_Store.Read(CAD_Topo_Sweep.lp1, 1))
            ArraySet(CAD_Topo_Sweep.p1, 2, 0)
            ArraySet(CAD_Topo_Sweep.ax, 0, Float_Sub(ArrayGet(CAD_Topo_Sweep.p1, 0), ArrayGet(CAD_Topo_Sweep.pt, 0)))
            ArraySet(CAD_Topo_Sweep.ax, 1, Float_Sub(ArrayGet(CAD_Topo_Sweep.p1, 1), ArrayGet(CAD_Topo_Sweep.pt, 1)))
            ArraySet(CAD_Topo_Sweep.ax, 2, 0)
            CAD_Topo_Sweep.prev = CAD_Num.Sqrt(Float_Add(Float_Mul(ArrayGet(CAD_Topo_Sweep.ax, 0), ArrayGet(CAD_Topo_Sweep.ax, 0)), Float_Mul(ArrayGet(CAD_Topo_Sweep.ax, 1), ArrayGet(CAD_Topo_Sweep.ax, 1))))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_Sweep.prev, 0), 0) ThenBlock: {
                ArraySet(CAD_Topo_Sweep.ax, 0, Float_Div(ArrayGet(CAD_Topo_Sweep.ax, 0), CAD_Topo_Sweep.prev))
                ArraySet(CAD_Topo_Sweep.ax, 1, Float_Div(ArrayGet(CAD_Topo_Sweep.ax, 1), CAD_Topo_Sweep.prev))
            }
            IfCondition GreaterThan(ArrayGet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.i), 0) ThenBlock: {
                ArraySet(CAD_Topo_Sweep.ax, 0, Float_Sub(0, ArrayGet(CAD_Topo_Sweep.ax, 0)))
                ArraySet(CAD_Topo_Sweep.ax, 1, Float_Sub(0, ArrayGet(CAD_Topo_Sweep.ax, 1)))
            }
            ArraySet(CAD_Topo_Sweep.ay, 0, 0)
            ArraySet(CAD_Topo_Sweep.ay, 1, 0)
            ArraySet(CAD_Topo_Sweep.ay, 2, 0x3FF0000000000000)
            ArraySet(CAD_Topo_Sweep.csrf, CAD_Topo_Sweep.i, CAD_Geom.MakePlaneAxes(CAD_Topo_Sweep.pt, CAD_Topo_Sweep.ax, CAD_Topo_Sweep.ay))
        }
        ArraySet(CAD_Topo_Sweep.pt, 0, CAD_Store.Read(CAD_Topo_Sweep.lp0, 0))
        ArraySet(CAD_Topo_Sweep.pt, 1, CAD_Store.Read(CAD_Topo_Sweep.lp0, 1))
        ArraySet(CAD_Topo_Sweep.pt, 2, 0)
        ArraySet(CAD_Topo_Sweep.p1, 0, CAD_Store.Read(CAD_Topo_Sweep.sbot, 0))
        ArraySet(CAD_Topo_Sweep.p1, 1, CAD_Store.Read(CAD_Topo_Sweep.sbot, 1))
        ArraySet(CAD_Topo_Sweep.p1, 2, CAD_Topo_Sweep.hz)
        ArraySet(CAD_Topo_Sweep.ev, CAD_Topo_Sweep.i, CAD_Topo.MakeEdge(CAD_Topo_Sweep.lp0, CAD_Topo_Sweep.sbot, CAD_Geom.MakeLine(CAD_Topo_Sweep.pt, CAD_Topo_Sweep.p1)))
        CAD_Topo_Sweep.lph = ArrayGet(CAD_Topo_Sweep.eb, CAD_Topo_Sweep.i)
        CAD_Topo_Sweep.prev = CAD_Topo.MakeCoedge(CAD_Topo_Sweep.lph, CAD_Topo_Sweep.lp0, 1)
        CAD_Topo_Sweep.out = CAD_Topo.MakeCoedge(CAD_Topo_Sweep.lph, CAD_Topo_Sweep.lp1, 0)
        CAD_Topo.LinkTwins(CAD_Topo_Sweep.prev, CAD_Topo_Sweep.out)
        CAD_Store.Write(CAD_Topo_Sweep.lph, 3, CAD_Topo_Sweep.prev)
        CAD_Store.Write(CAD_Topo_Sweep.lph, 4, CAD_Topo_Sweep.out)
        CAD_Topo_Sweep.lph = ArrayGet(CAD_Topo_Sweep.et, CAD_Topo_Sweep.i)
        CAD_Topo_Sweep.prev = CAD_Topo.MakeCoedge(CAD_Topo_Sweep.lph, CAD_Topo_Sweep.sbot, 1)
        CAD_Topo_Sweep.out = CAD_Topo.MakeCoedge(CAD_Topo_Sweep.lph, CAD_Topo_Sweep.stop, 0)
        CAD_Topo.LinkTwins(CAD_Topo_Sweep.prev, CAD_Topo_Sweep.out)
        CAD_Store.Write(CAD_Topo_Sweep.lph, 3, CAD_Topo_Sweep.prev)
        CAD_Store.Write(CAD_Topo_Sweep.lph, 4, CAD_Topo_Sweep.out)
        CAD_Topo_Sweep.lph = ArrayGet(CAD_Topo_Sweep.ev, CAD_Topo_Sweep.i)
        CAD_Topo_Sweep.prev = CAD_Topo.MakeCoedge(CAD_Topo_Sweep.lph, CAD_Topo_Sweep.lp0, 1)
        CAD_Topo_Sweep.out = CAD_Topo.MakeCoedge(CAD_Topo_Sweep.lph, CAD_Topo_Sweep.sbot, 0)
        CAD_Topo.LinkTwins(CAD_Topo_Sweep.prev, CAD_Topo_Sweep.out)
        CAD_Store.Write(CAD_Topo_Sweep.lph, 3, CAD_Topo_Sweep.prev)
        CAD_Store.Write(CAD_Topo_Sweep.lph, 4, CAD_Topo_Sweep.out)
        ReturnValue(0)
    }
}

// Caps from wires + one side face per curve.
Function.CAD_Topo.SweepBuildCaps {
    Output: Integer
    Body: {
        CAD_Topo_Sweep.j = 0
        CAD_Topo_Sweep.i = 0
        WhileLoop LessThan(CAD_Topo_Sweep.i, CAD_Topo_Sweep.ncurve) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.i), 0) ThenBlock: {
                CAD_Topo_Sweep.j = Add(CAD_Topo_Sweep.j, 1)
            }
            CAD_Topo_Sweep.i = Add(CAD_Topo_Sweep.i, 1)
        }
        CAD_Topo_Sweep.prev = CAD_Topo_Sweep.j
        CAD_Topo_Sweep.i = 0
        CAD_Topo_Sweep.j = 0
        WhileLoop LessThan(CAD_Topo_Sweep.i, CAD_Topo_Sweep.ncurve) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.i), 0) ThenBlock: {
                ArraySet(CAD_Topo_Sweep.ring, Subtract(Subtract(CAD_Topo_Sweep.prev, 1), CAD_Topo_Sweep.j), CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.eb, CAD_Topo_Sweep.i), 4))
                CAD_Topo_Sweep.j = Add(CAD_Topo_Sweep.j, 1)
            }
            CAD_Topo_Sweep.i = Add(CAD_Topo_Sweep.i, 1)
        }
        CAD_Topo_Sweep.lp0 = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_Sweep.ring, 0))
        IfCondition EqualTo(CAD_Topo_Sweep.prev, 1) ThenBlock: {
            CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 2, ArrayGet(CAD_Topo_Sweep.ring, 0))
            CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 3, ArrayGet(CAD_Topo_Sweep.ring, 0))
            CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 4, CAD_Topo_Sweep.lp0)
            CAD_Store.Write(CAD_Topo_Sweep.lp0, 0, ArrayGet(CAD_Topo_Sweep.ring, 0))
        }
        IfCondition GreaterThan(CAD_Topo_Sweep.prev, 1) ThenBlock: {
            CAD_Topo.LinkLoopRing(CAD_Topo_Sweep.ring, CAD_Topo_Sweep.prev, CAD_Topo_Sweep.lp0)
        }
        ArraySet(CAD_Topo_Sweep.faces, 0, CAD_Topo.MakeFace(CAD_Topo_Sweep.sbot, CAD_Topo_Sweep.lp0))
        CAD_Topo_Sweep.out = 1
        WhileLoop LessThan(CAD_Topo_Sweep.out, CAD_Topo_Sweep.ncont) {
            CAD_Topo_Sweep.j = 0
            CAD_Topo_Sweep.i = 0
            WhileLoop LessThan(CAD_Topo_Sweep.i, CAD_Topo_Sweep.ncurve) {
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.i), CAD_Topo_Sweep.out) ThenBlock: {
                    ArraySet(CAD_Topo_Sweep.ring, CAD_Topo_Sweep.j, CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.eb, CAD_Topo_Sweep.i), 3))
                    CAD_Topo_Sweep.j = Add(CAD_Topo_Sweep.j, 1)
                }
                CAD_Topo_Sweep.i = Add(CAD_Topo_Sweep.i, 1)
            }
            CAD_Topo_Sweep.lph = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_Sweep.ring, 0))
            IfCondition EqualTo(CAD_Topo_Sweep.j, 1) ThenBlock: {
                CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 2, ArrayGet(CAD_Topo_Sweep.ring, 0))
                CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 3, ArrayGet(CAD_Topo_Sweep.ring, 0))
                CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 4, CAD_Topo_Sweep.lph)
                CAD_Store.Write(CAD_Topo_Sweep.lph, 0, ArrayGet(CAD_Topo_Sweep.ring, 0))
            }
            IfCondition GreaterThan(CAD_Topo_Sweep.j, 1) ThenBlock: {
                CAD_Topo.LinkLoopRing(CAD_Topo_Sweep.ring, CAD_Topo_Sweep.j, CAD_Topo_Sweep.lph)
            }
            CAD_Topo.FaceAppendLoop(ArrayGet(CAD_Topo_Sweep.faces, 0), CAD_Topo_Sweep.lph)
            CAD_Topo_Sweep.out = Add(CAD_Topo_Sweep.out, 1)
        }
        CAD_Topo_Sweep.j = 0
        CAD_Topo_Sweep.i = 0
        WhileLoop LessThan(CAD_Topo_Sweep.i, CAD_Topo_Sweep.ncurve) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.i), 0) ThenBlock: {
                ArraySet(CAD_Topo_Sweep.ring, CAD_Topo_Sweep.j, CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.et, CAD_Topo_Sweep.i), 3))
                CAD_Topo_Sweep.j = Add(CAD_Topo_Sweep.j, 1)
            }
            CAD_Topo_Sweep.i = Add(CAD_Topo_Sweep.i, 1)
        }
        CAD_Topo_Sweep.lp1 = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_Sweep.ring, 0))
        IfCondition EqualTo(CAD_Topo_Sweep.j, 1) ThenBlock: {
            CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 2, ArrayGet(CAD_Topo_Sweep.ring, 0))
            CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 3, ArrayGet(CAD_Topo_Sweep.ring, 0))
            CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 4, CAD_Topo_Sweep.lp1)
            CAD_Store.Write(CAD_Topo_Sweep.lp1, 0, ArrayGet(CAD_Topo_Sweep.ring, 0))
        }
        IfCondition GreaterThan(CAD_Topo_Sweep.j, 1) ThenBlock: {
            CAD_Topo.LinkLoopRing(CAD_Topo_Sweep.ring, CAD_Topo_Sweep.j, CAD_Topo_Sweep.lp1)
        }
        ArraySet(CAD_Topo_Sweep.faces, 1, CAD_Topo.MakeFace(CAD_Topo_Sweep.stop, CAD_Topo_Sweep.lp1))
        CAD_Topo_Sweep.out = 1
        WhileLoop LessThan(CAD_Topo_Sweep.out, CAD_Topo_Sweep.ncont) {
            CAD_Topo_Sweep.prev = 0
            CAD_Topo_Sweep.i = 0
            WhileLoop LessThan(CAD_Topo_Sweep.i, CAD_Topo_Sweep.ncurve) {
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.i), CAD_Topo_Sweep.out) ThenBlock: {
                    CAD_Topo_Sweep.prev = Add(CAD_Topo_Sweep.prev, 1)
                }
                CAD_Topo_Sweep.i = Add(CAD_Topo_Sweep.i, 1)
            }
            CAD_Topo_Sweep.j = 0
            CAD_Topo_Sweep.i = 0
            WhileLoop LessThan(CAD_Topo_Sweep.i, CAD_Topo_Sweep.ncurve) {
                IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.i), CAD_Topo_Sweep.out) ThenBlock: {
                    ArraySet(CAD_Topo_Sweep.ring, Subtract(Subtract(CAD_Topo_Sweep.prev, 1), CAD_Topo_Sweep.j), CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.et, CAD_Topo_Sweep.i), 4))
                    CAD_Topo_Sweep.j = Add(CAD_Topo_Sweep.j, 1)
                }
                CAD_Topo_Sweep.i = Add(CAD_Topo_Sweep.i, 1)
            }
            CAD_Topo_Sweep.lph = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_Sweep.ring, 0))
            IfCondition EqualTo(CAD_Topo_Sweep.j, 1) ThenBlock: {
                CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 2, ArrayGet(CAD_Topo_Sweep.ring, 0))
                CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 3, ArrayGet(CAD_Topo_Sweep.ring, 0))
                CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.ring, 0), 4, CAD_Topo_Sweep.lph)
                CAD_Store.Write(CAD_Topo_Sweep.lph, 0, ArrayGet(CAD_Topo_Sweep.ring, 0))
            }
            IfCondition GreaterThan(CAD_Topo_Sweep.j, 1) ThenBlock: {
                CAD_Topo.LinkLoopRing(CAD_Topo_Sweep.ring, CAD_Topo_Sweep.j, CAD_Topo_Sweep.lph)
            }
            CAD_Topo.FaceAppendLoop(ArrayGet(CAD_Topo_Sweep.faces, 1), CAD_Topo_Sweep.lph)
            CAD_Topo_Sweep.out = Add(CAD_Topo_Sweep.out, 1)
        }
        CAD_Topo_Sweep.nf = 2
        CAD_Topo_Sweep.i = 0
        WhileLoop LessThan(CAD_Topo_Sweep.i, CAD_Topo_Sweep.ncurve) {
            CAD_Topo_Sweep.j = CAD_Topo.SweepNextInWire(CAD_Topo_Sweep.i)
            IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.i), 0) ThenBlock: {
                ArraySet(CAD_Topo_Sweep.ring, 0, CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.eb, CAD_Topo_Sweep.i), 3))
                ArraySet(CAD_Topo_Sweep.ring, 1, CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.ev, CAD_Topo_Sweep.j), 3))
                ArraySet(CAD_Topo_Sweep.ring, 2, CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.et, CAD_Topo_Sweep.i), 4))
                ArraySet(CAD_Topo_Sweep.ring, 3, CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.ev, CAD_Topo_Sweep.i), 4))
            }
            IfCondition GreaterThan(ArrayGet(CAD_Topo_Sweep.cwire, CAD_Topo_Sweep.i), 0) ThenBlock: {
                ArraySet(CAD_Topo_Sweep.ring, 0, CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.eb, CAD_Topo_Sweep.i), 4))
                ArraySet(CAD_Topo_Sweep.ring, 1, CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.ev, CAD_Topo_Sweep.i), 3))
                ArraySet(CAD_Topo_Sweep.ring, 2, CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.et, CAD_Topo_Sweep.i), 3))
                ArraySet(CAD_Topo_Sweep.ring, 3, CAD_Store.Read(ArrayGet(CAD_Topo_Sweep.ev, CAD_Topo_Sweep.j), 4))
            }
            CAD_Topo_Sweep.lph = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_Sweep.ring, 0))
            CAD_Topo.LinkLoopRing(CAD_Topo_Sweep.ring, 4, CAD_Topo_Sweep.lph)
            ArraySet(CAD_Topo_Sweep.faces, CAD_Topo_Sweep.nf, CAD_Topo.MakeFace(ArrayGet(CAD_Topo_Sweep.csrf, CAD_Topo_Sweep.i), CAD_Topo_Sweep.lph))
            CAD_Topo_Sweep.nf = Add(CAD_Topo_Sweep.nf, 1)
            CAD_Topo_Sweep.i = Add(CAD_Topo_Sweep.i, 1)
        }
        ReturnValue(CAD_Topo_Sweep.nf)
    }
}

// Each curve of each wire → side face. Caps from the wires.
Function.CAD_Topo.ExtrudeContours {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Topo.SweepEnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CAD_Topo_Sweep.ncurve, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_Sweep.hz, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_Sweep.i = 0
        WhileLoop LessThan(CAD_Topo_Sweep.i, CAD_Topo_Sweep.ncurve) {
            ArraySet(CAD_Topo_Sweep.pt, 0, ArrayGet(CAD_Topo_Sweep.cx0, CAD_Topo_Sweep.i))
            ArraySet(CAD_Topo_Sweep.pt, 1, ArrayGet(CAD_Topo_Sweep.cy0, CAD_Topo_Sweep.i))
            ArraySet(CAD_Topo_Sweep.pt, 2, 0)
            IfCondition EqualTo(ArrayGet(CAD_Topo_Sweep.ckind, CAD_Topo_Sweep.i), 2) ThenBlock: {
                ArraySet(CAD_Topo_Sweep.pt, 0, Float_Add(ArrayGet(CAD_Topo_Sweep.cx0, CAD_Topo_Sweep.i), Float_Mul(ArrayGet(CAD_Topo_Sweep.cx1, CAD_Topo_Sweep.i), CAD_Geom.Cos(ArrayGet(CAD_Topo_Sweep.ca0, CAD_Topo_Sweep.i)))))
                ArraySet(CAD_Topo_Sweep.pt, 1, Float_Add(ArrayGet(CAD_Topo_Sweep.cy0, CAD_Topo_Sweep.i), Float_Mul(ArrayGet(CAD_Topo_Sweep.cx1, CAD_Topo_Sweep.i), CAD_Geom.Sin(ArrayGet(CAD_Topo_Sweep.ca0, CAD_Topo_Sweep.i)))))
            }
            ArraySet(CAD_Topo_Sweep.vb, CAD_Topo_Sweep.i, CAD_Topo.MakeVertex(CAD_Topo_Sweep.pt))
            ArraySet(CAD_Topo_Sweep.pt, 2, CAD_Topo_Sweep.hz)
            ArraySet(CAD_Topo_Sweep.vt, CAD_Topo_Sweep.i, CAD_Topo.MakeVertex(CAD_Topo_Sweep.pt))
            CAD_Topo_Sweep.i = Add(CAD_Topo_Sweep.i, 1)
        }
        CAD_Topo_Sweep.i = 0
        WhileLoop LessThan(CAD_Topo_Sweep.i, CAD_Topo_Sweep.ncurve) {
            CAD_Topo.SweepEmitCurve(CAD_Topo_Sweep.i)
            CAD_Topo_Sweep.i = Add(CAD_Topo_Sweep.i, 1)
        }
        ArraySet(CAD_Topo_Sweep.pt, 0, ArrayGet(CAD_Topo_Sweep.cx0, 0))
        ArraySet(CAD_Topo_Sweep.pt, 1, ArrayGet(CAD_Topo_Sweep.cy0, 0))
        ArraySet(CAD_Topo_Sweep.pt, 2, 0)
        ArraySet(CAD_Topo_Sweep.ax, 0, 0x3FF0000000000000)
        ArraySet(CAD_Topo_Sweep.ax, 1, 0)
        ArraySet(CAD_Topo_Sweep.ax, 2, 0)
        ArraySet(CAD_Topo_Sweep.ay, 0, 0)
        ArraySet(CAD_Topo_Sweep.ay, 1, 0xBFF0000000000000)
        ArraySet(CAD_Topo_Sweep.ay, 2, 0)
        CAD_Topo_Sweep.sbot = CAD_Geom.MakePlaneAxes(CAD_Topo_Sweep.pt, CAD_Topo_Sweep.ax, CAD_Topo_Sweep.ay)
        ArraySet(CAD_Topo_Sweep.pt, 2, CAD_Topo_Sweep.hz)
        ArraySet(CAD_Topo_Sweep.ay, 1, 0x3FF0000000000000)
        CAD_Topo_Sweep.stop = CAD_Geom.MakePlaneAxes(CAD_Topo_Sweep.pt, CAD_Topo_Sweep.ax, CAD_Topo_Sweep.ay)
        CAD_Topo.SweepBuildCaps()
        CAD_Topo_Sweep.i = 0
        WhileLoop LessThan(CAD_Topo_Sweep.i, Subtract(CAD_Topo_Sweep.nf, 1)) {
            CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.faces, CAD_Topo_Sweep.i), 3, ArrayGet(CAD_Topo_Sweep.faces, Add(CAD_Topo_Sweep.i, 1)))
            CAD_Topo_Sweep.i = Add(CAD_Topo_Sweep.i, 1)
        }
        CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.faces, Subtract(CAD_Topo_Sweep.nf, 1)), 3, 0)
        CAD_Topo_Sweep.lph = CAD_Topo.MakeShell(ArrayGet(CAD_Topo_Sweep.faces, 0))
        CAD_Topo_Sweep.i = 1
        WhileLoop LessThan(CAD_Topo_Sweep.i, CAD_Topo_Sweep.nf) {
            CAD_Store.Write(ArrayGet(CAD_Topo_Sweep.faces, CAD_Topo_Sweep.i), 2, CAD_Topo_Sweep.lph)
            CAD_Topo_Sweep.i = Add(CAD_Topo_Sweep.i, 1)
        }
        CAD_Topo_Sweep.out = CAD_Topo.MakeSolid(CAD_Topo_Sweep.lph)
        CAD_Store.Write(CAD_Topo_Sweep.out, 1, 0)
        CAD_Store.Write(CAD_Topo_Sweep.out, 2, 0)
        CAD_Store.Write(CAD_Topo_Sweep.out, 3, 0)
        ReturnValue(CAD_Topo_Sweep.out)
    }
}
