LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.Topo.FilletRim
LibraryImport.Cad.Topo.FilletEdge

Function.CAD_Topo.MakeMinorArcEdge {
    Input: v0_h: Integer
    Input: v1_h: Integer
    Input: circ_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(v0_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(circ_h, 0) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(circ_h, 1)
        cy = CAD_Store.Read(circ_h, 2)
        cz = CAD_Store.Read(circ_h, 3)
        xx = CAD_Store.Read(circ_h, 4)
        xy = CAD_Store.Read(circ_h, 5)
        xz = CAD_Store.Read(circ_h, 6)
        yx = CAD_Store.Read(circ_h, 7)
        yy = CAD_Store.Read(circ_h, 8)
        yz = CAD_Store.Read(circ_h, 9)
        // unit coords in circle plane: u=(P-C)·X, v=(P-C)·Y
        p0x = Float_Sub(CAD_Store.Read(v0_h, 0), cx)
        p0y = Float_Sub(CAD_Store.Read(v0_h, 1), cy)
        p0z = Float_Sub(CAD_Store.Read(v0_h, 2), cz)
        p1x = Float_Sub(CAD_Store.Read(v1_h, 0), cx)
        p1y = Float_Sub(CAD_Store.Read(v1_h, 1), cy)
        p1z = Float_Sub(CAD_Store.Read(v1_h, 2), cz)
        u0 = Float_Add(Float_Add(Float_Mul(p0x, xx), Float_Mul(p0y, xy)), Float_Mul(p0z, xz))
        v0 = Float_Add(Float_Add(Float_Mul(p0x, yx), Float_Mul(p0y, yy)), Float_Mul(p0z, yz))
        u1 = Float_Add(Float_Add(Float_Mul(p1x, xx), Float_Mul(p1y, xy)), Float_Mul(p1z, xz))
        v1 = Float_Add(Float_Add(Float_Mul(p1x, yx), Float_Mul(p1y, yy)), Float_Mul(p1z, yz))
        // Minor arc only. A 270° end-cap was tessellated as a sheet that
        // ran past the edge (16-35/16-36). Clone the circle and store the
        // signed span in (-π, π] so SampleCircleEdge cannot walk the long way.
        a0 = CAD_Geom.Atan2(v0, u0)
        a1 = CAD_Geom.Atan2(v1, u1)
        two_pi = 0x401921FB54442D18
        pi = 0x400921FB54442D18
        span = Float_Sub(a1, a0)
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(span, Float_Sub(0, pi))), 1) ThenBlock: {
            span = Float_Add(span, two_pi)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, span)), 1) ThenBlock: {
            span = Float_Sub(span, two_pi)
        }
        aa = v0_h
        bb = v1_h
        IfCondition EqualTo(CAD_Num.IsNeg(span), 1) ThenBlock: {
            aa = v1_h
            bb = v0_h
            span = Float_Sub(0, span)
        }
        ch = CAD_Store.Alloc(16, 14)
        IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(CAD_Topo.MakeEdge(aa, bb, circ_h)) }
        si = 0
        WhileLoop LessThan(si, 13) {
            CAD_Store.Write(ch, si, CAD_Store.Read(circ_h, si))
            si = Add(si, 1)
        }
        CAD_Store.Write(ch, 12, span)
        ReturnValue(CAD_Topo.MakeEdge(aa, bb, ch))
    }
}

// Closer of va, vb to point p. Method-9 mer sew: each host LINE at the
// end wall gets Th or Tw by the other vertex, not by curve kind.
// Kind==2 → Th / kind!=2 → Tw assigned Tw to both LINEs and pulled the
// lid corner down (top-edge ear, hdZ=lnZ=Tw).
Function.CAD_Topo.FilletMerCloser {
    Input: va: Integer
    Input: vb: Integer
    Input: p: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(va) }
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(vb) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(va) }
        dx = Float_Sub(CAD_Store.Read(p, 0), CAD_Store.Read(va, 0))
        dy = Float_Sub(CAD_Store.Read(p, 1), CAD_Store.Read(va, 1))
        dz = Float_Sub(CAD_Store.Read(p, 2), CAD_Store.Read(va, 2))
        da = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
        dx = Float_Sub(CAD_Store.Read(p, 0), CAD_Store.Read(vb, 0))
        dy = Float_Sub(CAD_Store.Read(p, 1), CAD_Store.Read(vb, 1))
        dz = Float_Sub(CAD_Store.Read(p, 2), CAD_Store.Read(vb, 2))
        db = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(da, db)), 1) ThenBlock: { ReturnValue(va) }
        ReturnValue(vb)
    }
}

// 1 if vert sits on a class-3 collar (planar nce=3 with a CIRCLE coedge).
Function.CAD_Topo.FilletVertOnCollar {
    Input: vert_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.solid, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.shell = CAD_Store.Read(CAD_Topo_FLoc.solid, 0)
        CAD_Topo_FLoc.ei = 0
        WhileLoop NotEqual(CAD_Topo_FLoc.shell, 0) {
            IfCondition GreaterThan(CAD_Topo_FLoc.ei, 64) ThenBlock: { CAD_Topo_FLoc.shell = 0 }
            IfCondition NotEqual(CAD_Topo_FLoc.shell, 0) ThenBlock: {
                CAD_Topo_FLoc.endf = CAD_Store.Read(CAD_Topo_FLoc.shell, 0)
                CAD_Topo_FLoc.ln = 0
                WhileLoop NotEqual(CAD_Topo_FLoc.endf, 0) {
                    IfCondition GreaterThan(CAD_Topo_FLoc.ln, 4096) ThenBlock: { CAD_Topo_FLoc.endf = 0 }
                    IfCondition NotEqual(CAD_Topo_FLoc.endf, 0) ThenBlock: {
                        CAD_Topo_FLoc.lp = CAD_Store.Read(CAD_Topo_FLoc.endf, 1)
                        CAD_Topo_FLoc.hd = 0
                        IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                            CAD_Topo_FLoc.hd = CAD_Topo.LoopCountCoedges(CAD_Topo_FLoc.lp)
                        }
                        IfCondition EqualTo(CAD_Topo_FLoc.hd, 3) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_FLoc.endf, CAD_Topo_FLoc.pl1), 0) ThenBlock: {
                                CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.lp, 0)
                                CAD_Topo_FLoc.which = 0
                                CAD_Topo_FLoc.sn = 0
                                CAD_Topo_FLoc.aa = 0
                                WhileLoop LessThan(CAD_Topo_FLoc.aa, 4) {
                                    IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.ce, 5), vert_h) ThenBlock: { CAD_Topo_FLoc.which = 1 }
                                        CAD_Topo_FLoc.bb = CAD_Store.Read(CAD_Topo_FLoc.ce, 0)
                                        IfCondition NotEqual(CAD_Topo_FLoc.bb, 0) ThenBlock: {
                                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.bb, 0), vert_h) ThenBlock: { CAD_Topo_FLoc.which = 1 }
                                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.bb, 1), vert_h) ThenBlock: { CAD_Topo_FLoc.which = 1 }
                                            CAD_Topo_FLoc.cyl = CAD_Store.Read(CAD_Topo_FLoc.bb, 2)
                                            IfCondition NotEqual(CAD_Topo_FLoc.cyl, 0) ThenBlock: {
                                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.cyl, 0), 2) ThenBlock: {
                                                    // Collar mer is minor (|span|≤π). A 270° host
                                                    // rim is not a previous-fillet collar.
                                                    CAD_Topo_FLoc.ln = CAD_Store.Read(CAD_Topo_FLoc.cyl, 12)
                                                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FLoc.ln), 1) ThenBlock: {
                                                        CAD_Topo_FLoc.ln = Float_Sub(0, CAD_Topo_FLoc.ln)
                                                    }
                                                    IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 0) ThenBlock: {
                                                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0x400921FB54442D18, CAD_Topo_FLoc.ln)), 0) ThenBlock: {
                                                            CAD_Topo_FLoc.sn = 1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.ce, 2)
                                    }
                                    CAD_Topo_FLoc.aa = Add(CAD_Topo_FLoc.aa, 1)
                                }
                                IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
                                    IfCondition EqualTo(CAD_Topo_FLoc.sn, 1) ThenBlock: { ReturnValue(1) }
                                }
                            }
                        }
                        CAD_Topo_FLoc.endf = CAD_Store.Read(CAD_Topo_FLoc.endf, 3)
                    }
                    CAD_Topo_FLoc.ln = Add(CAD_Topo_FLoc.ln, 1)
                }
                CAD_Topo_FLoc.shell = CAD_Store.Read(CAD_Topo_FLoc.shell, 2)
            }
            CAD_Topo_FLoc.ei = Add(CAD_Topo_FLoc.ei, 1)
        }
        ReturnValue(0)
    }
}

// Vertex function for junc=5 (open LINE into a cylindrical face).
// Moves Th along the rail onto the blocker. Tw stays on the wall —
// shifting C dragged Tw off the cylinder and left the corners open.
// Caller stays sequential so LINE+LINE copes still chain.
Function.CAD_Topo.FilletPlexRailArcShift {
    Input: which: Integer
    Output: Integer
    Body: {
        vh = CAD_Topo_FLoc.v0
        th = CAD_Topo_FLoc.va0
        CAD_Topo_FLoc.ab = CAD_Topo_FLoc.n1z
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FLoc.ab), 1) ThenBlock: { CAD_Topo_FLoc.ab = Float_Sub(0, CAD_Topo_FLoc.ab) }
        CAD_Topo_FLoc.aa = CAD_Topo_FLoc.n2z
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FLoc.aa), 1) ThenBlock: { CAD_Topo_FLoc.aa = Float_Sub(0, CAD_Topo_FLoc.aa) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.aa)), 1) ThenBlock: { th = CAD_Topo_FLoc.vb0 }
        IfCondition EqualTo(which, 1) ThenBlock: {
            vh = CAD_Topo_FLoc.v1
            th = CAD_Topo_FLoc.va1
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.aa)), 1) ThenBlock: { th = CAD_Topo_FLoc.vb1 }
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo.FilletDumpI("rail-arc which=", 15, which)
        CAD_Topo.FilletDumpI(" nsel=", 6, CAD_Topo.FilletIRCountAt(vh))
        IfCondition NotEqual(CAD_Topo.FilletIRCountAt(vh), 1) ThenBlock: {
            CAD_Topo.FilletDumpS(" skip nsel\n", 11)
            ReturnValue(1)
        }
        blk = CAD_Topo.FilletPlexBlockingFace(CAD_Topo_FLoc.solid, vh, CAD_Topo_FLoc.f1, CAD_Topo_FLoc.f2)
        CAD_Topo.FilletDumpI(" blk=", 5, blk)
        IfCondition EqualTo(blk, 0) ThenBlock: {
            CAD_Topo.FilletDumpS(" no blk\n", 8)
            ReturnValue(1)
        }
        surf = CAD_Store.Read(blk, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo.FilletDumpI(" sk=", 4, CAD_Store.Read(surf, 0))
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: {
            CAD_Topo.FilletDumpS(" not cyl\n", 9)
            ReturnValue(1)
        }
        tx = CAD_Store.Read(th, 0)
        ty = CAD_Store.Read(th, 1)
        tz = CAD_Store.Read(th, 2)
        ocx = CAD_Store.Read(surf, 1)
        ocy = CAD_Store.Read(surf, 2)
        rr = CAD_Store.Read(surf, 13)
        CAD_Topo.FilletDumpI(" O=", 3, Float_ToInt(ocx))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(ocy))
        CAD_Topo.FilletDumpI(" R=", 3, Float_ToInt(rr))
        CAD_Topo.FilletDumpI(" Z=", 3, Float_ToInt(Float_Mul(CAD_Store.Read(surf, 12), 0x408F400000000000)))
        CAD_Topo.FilletDumpI(" Th=", 4, Float_ToInt(tx))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(ty))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(tz))
        nx = Float_Sub(tx, ocx)
        ny = Float_Sub(ty, ocy)
        CAD_Topo.FilletDumpI(" dR=", 4, Float_ToInt(CAD_Num.Abs(Float_Sub(CAD_Num.Sqrt(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny))), rr))))
        dx = CAD_Topo_FLoc.edx
        dy = CAD_Topo_FLoc.edy
        aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS(" Dxy0\n", 6)
            ReturnValue(1)
        }
        bb = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(nx, dx), Float_Mul(ny, dy)))
        cc = Float_Sub(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(rr, rr))
        disc = Float_Sub(Float_Mul(bb, bb), Float_Mul(0x4010000000000000, Float_Mul(aa, cc)))
        IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
            CAD_Topo.FilletDumpS(" disc-\n", 7)
            ReturnValue(1)
        }
        disc = CAD_Num.Sqrt(disc)
        s0 = Float_Div(Float_Sub(Float_Sub(0, bb), disc), Float_Mul(0x4000000000000000, aa))
        s1 = Float_Div(Float_Add(Float_Sub(0, bb), disc), Float_Mul(0x4000000000000000, aa))
        as0 = s0
        IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
        as1 = s1
        IfCondition EqualTo(CAD_Num.IsNeg(as1), 1) ThenBlock: { as1 = Float_Sub(0, as1) }
        s = s0
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as1, as0)), 1) ThenBlock: { s = s1 }
        in0 = -1
        in1 = -1
        IfCondition NotEqual(CAD_Topo_FLoc.pt, 0) ThenBlock: {
            ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(tx, Float_Mul(s0, CAD_Topo_FLoc.edx)))
            ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(ty, Float_Mul(s0, CAD_Topo_FLoc.edy)))
            ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(tz, Float_Mul(s0, CAD_Topo_FLoc.edz)))
            in0 = CAD_Topo.PointInSolid(CAD_Topo_FLoc.solid, CAD_Topo_FLoc.pt)
            ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(tx, Float_Mul(s1, CAD_Topo_FLoc.edx)))
            ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(ty, Float_Mul(s1, CAD_Topo_FLoc.edy)))
            ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(tz, Float_Mul(s1, CAD_Topo_FLoc.edz)))
            in1 = CAD_Topo.PointInSolid(CAD_Topo_FLoc.solid, CAD_Topo_FLoc.pt)
            IfCondition EqualTo(in0, 1) ThenBlock: {
                IfCondition EqualTo(in1, 0) ThenBlock: { s = s1 }
            }
            IfCondition EqualTo(in0, 0) ThenBlock: {
                IfCondition EqualTo(in1, 1) ThenBlock: { s = s0 }
            }
        }
        CAD_Topo.FilletDumpI(" s0=", 4, Float_ToInt(s0))
        CAD_Topo.FilletDumpI(" s1=", 4, Float_ToInt(s1))
        CAD_Topo.FilletDumpI(" in0=", 5, in0)
        CAD_Topo.FilletDumpI(" in1=", 5, in1)
        CAD_Topo.FilletDumpI(" s=", 3, Float_ToInt(s))
        as0 = s
        IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
        IfCondition EqualTo(CAD_Num.IsZero(s, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS(" s=0\n", 5)
            ReturnValue(1)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as0, 0x412E848000000000)), 0) ThenBlock: {
            CAD_Topo.FilletDumpS(" |s|>=1m\n", 9)
            ReturnValue(1)
        }
        CAD_Store.Write(th, 0, Float_Add(tx, Float_Mul(s, CAD_Topo_FLoc.edx)))
        CAD_Store.Write(th, 1, Float_Add(ty, Float_Mul(s, CAD_Topo_FLoc.edy)))
        CAD_Store.Write(th, 2, Float_Add(tz, Float_Mul(s, CAD_Topo_FLoc.edz)))
        CAD_Topo.FilletDumpI(" Th'=", 5, Float_ToInt(CAD_Store.Read(th, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th, 1)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th, 2)))
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(1)
    }
}

// Fillet one plane–plane edge. Local surgery — previous blends stay.
Function.CAD_Topo.FilletPlanePlaneEdge {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Topo.FilletEdgeLocal(solid_handle, edge_handle, radius_r))
    }
}

// Host rail ended on this edge's own far Th, so the host loop is open
// from the next edge's drop to that Th. Move the shared edge onto the
// Th, and close the side that still holds the drop with the triangle
// drop–far Th–wall contact. The quarter and the digon are the other two
// sides. No sphere.
Function.CAD_Topo.FilletSewDropTri {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.s = 0
        CAD_Topo_FCove.k = Add(CAD_Topo_FCove.i, 1)
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.i) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.k)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.e, 0)
        IfCondition EqualTo(CAD_Topo_FCove.ok, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)) ThenBlock: {
            CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.ok, CAD_Topo_FCove.v0), 1) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i)
        IfCondition EqualTo(CAD_Topo_FCove.orig, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.hit = 0
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.orig, 0), CAD_Topo_FCove.ok), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.orig, 1), CAD_Topo_FCove.ok), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.ok1 = CAD_Store.Read(CAD_Topo_FCove.orig, 0)
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.ok1, CAD_Topo_FCove.ok), 1) ThenBlock: {
            CAD_Topo_FCove.ok1 = CAD_Store.Read(CAD_Topo_FCove.orig, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.ok1, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.ok1, CAD_Topo_FCove.ok), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.ok1, CAD_Topo_FCove.v0), 1) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.which = CAD_Topo.FCoveGet(348, CAD_Topo_FCove.k)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.which = CAD_Topo.FCoveGet(396, CAD_Topo_FCove.k) }
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.hit = 0
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.which, 0), CAD_Topo_FCove.ok1), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.which, 1), CAD_Topo_FCove.ok1), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.hit = 0
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.which, 0), CAD_Topo_FCove.v0), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.which, 1), CAD_Topo_FCove.v0), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.orig, 3), 0) ThenBlock: {
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.orig, 4), 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.which, 3), 0) ThenBlock: {
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.which, 4), 0) ThenBlock: { ReturnValue(1) }
        }
        CAD_Topo_FCove.hit = CAD_Topo.FilletIRIndexOf(CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i))
        IfCondition LessThan(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.f1 = CAD_Topo.FilletIRGet(CAD_Topo_FCove.hit, 19)
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.f1, 1)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.prv = 0
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 32) {
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.g = 32 }
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                CAD_Topo_FCove.hit = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                        IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.nxt, 5), CAD_Topo_FCove.ok), 1) ThenBlock: {
                                CAD_Topo_FCove.prv = CAD_Topo_FCove.ce
                            }
                        }
                    }
                }
                CAD_Topo_FCove.ce = CAD_Topo_FCove.nxt
                IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 32 }
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.prv, 0) ThenBlock: {
            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
            CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
            CAD_Topo_FCove.g = 0
            WhileLoop LessThan(CAD_Topo_FCove.g, 32) {
                IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.g = 32 }
                IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                    CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                    CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                    CAD_Topo_FCove.hit = 0
                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                        IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.ok), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                            IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.ok), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                            IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0), 1) ThenBlock: { CAD_Topo_FCove.hit = 0 }
                            IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0), 1) ThenBlock: { CAD_Topo_FCove.hit = 0 }
                            IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.nxt, 5), CAD_Topo_FCove.v0), 1) ThenBlock: {
                                    CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.nxt, 0)
                                    CAD_Topo_FCove.hit = 0
                                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                    }
                                    IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                                        CAD_Topo_FCove.prv = CAD_Topo_FCove.nxt
                                        CAD_Topo_FCove.s = 1
                                    }
                                }
                            }
                        }
                    }
                    CAD_Topo_FCove.ce = CAD_Topo_FCove.nxt
                    IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 32 }
                }
                CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.prv, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.prv, 0)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 0)
        IfCondition EqualTo(CAD_Topo_FCove.f2, CAD_Topo_FCove.f1) ThenBlock: { CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 1) }
        IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo_FCove.f2, CAD_Topo_FCove.f1) ThenBlock: { ReturnValue(1) }
        CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.e, CAD_Topo_FCove.v0, CAD_Topo_FCove.ok)
        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.f2, 1)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.prv = 0
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 32) {
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.g = 32 }
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                CAD_Topo_FCove.hit = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo_FCove.s, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                            IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                            IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.nxt, 5), CAD_Topo_FCove.ok), 1) ThenBlock: {
                                    CAD_Topo_FCove.prv = CAD_Topo_FCove.ce
                                }
                            }
                        }
                        IfCondition EqualTo(CAD_Topo_FCove.s, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.ok), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                            IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.ok), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                            IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.nxt, 5), CAD_Topo_FCove.v0), 1) ThenBlock: {
                                    CAD_Topo_FCove.prv = CAD_Topo_FCove.ce
                                }
                            }
                        }
                    }
                }
                CAD_Topo_FCove.ce = CAD_Topo_FCove.nxt
                IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 32 }
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.prv, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo_FCove.s, 0) ThenBlock: {
            CAD_Topo_FCove.f2 = CAD_Topo.FCoveMakeLineE(CAD_Topo_FCove.v0, CAD_Topo_FCove.ok)
            IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { ReturnValue(1) }
            CAD_Topo_FCove.hd = CAD_Topo.MakeCoedge(CAD_Topo_FCove.f2, CAD_Topo_FCove.v0, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.s, 1) ThenBlock: {
            CAD_Topo_FCove.f2 = CAD_Topo.FCoveMakeLineE(CAD_Topo_FCove.ok, CAD_Topo_FCove.v0)
            IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { ReturnValue(1) }
            CAD_Topo_FCove.hd = CAD_Topo.MakeCoedge(CAD_Topo_FCove.f2, CAD_Topo_FCove.ok, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.hd, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo.CoedgeInsertAfter(CAD_Topo_FCove.prv, CAD_Topo_FCove.hd)
        CAD_Store.Write(CAD_Topo_FCove.f2, 3, CAD_Topo_FCove.hd)
        IfCondition EqualTo(CAD_Topo_FCove.s, 0) ThenBlock: {
            ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.f2, CAD_Topo_FCove.ok))
            ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.which, CAD_Topo_FCove.v0))
            ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.orig, CAD_Topo_FCove.ok1))
        }
        IfCondition EqualTo(CAD_Topo_FCove.s, 1) ThenBlock: {
            ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.orig, CAD_Topo_FCove.ok))
            ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.which, CAD_Topo_FCove.ok1))
            ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.f2, CAD_Topo_FCove.v0))
            CAD_Topo_FCove.hd = CAD_Topo_FCove.v0
            CAD_Topo_FCove.v0 = CAD_Topo_FCove.ok1
            CAD_Topo_FCove.ok1 = CAD_Topo_FCove.hd
        }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 0), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 1), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 2), 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.ok, 0)
        CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.ok, 1)
        CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.ok, 2)
        CAD_Topo_FCove.n1x = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.n1y = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.n1z = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok1, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok1, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok1, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.aa = Float_Sub(Float_Mul(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n2z), Float_Mul(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n2y))
        CAD_Topo_FCove.bb = Float_Sub(Float_Mul(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n2z))
        CAD_Topo_FCove.ab = Float_Sub(Float_Mul(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n2y), Float_Mul(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n2x))
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.aa), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.bb)), Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.ab)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.aa = Float_Div(CAD_Topo_FCove.aa, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.bb = Float_Div(CAD_Topo_FCove.bb, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.ab = Float_Div(CAD_Topo_FCove.ab, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n1x), Float_Mul(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n1y)), Float_Mul(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.n1x = Float_Div(CAD_Topo_FCove.n1x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1y = Float_Div(CAD_Topo_FCove.n1y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1z = Float_Div(CAD_Topo_FCove.n1z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2x = Float_Sub(Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n1z), Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n1y))
        CAD_Topo_FCove.n2y = Float_Sub(Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n1x), Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.n2z = Float_Sub(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.n1y), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n1x))
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.n2x)
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.n2y)
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.n2z)
        ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FCove.aa)
        ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FCove.bb)
        ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FCove.ab)
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 3, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.f1 = CAD_Topo.MakeFace(CAD_Geom.MakePlaneFrame(CAD_Topo_FCove.frame), CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.f1)
        PrintMessage("fillet sew tri\n")
        ReturnValue(1)
    }
}

// How many compiled rim edges touch vh. Sphere only if >=3 (trihedral pick).
Function.CAD_Topo.MixVertSelCount {
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        nsel = 0
        si = 0
        WhileLoop LessThan(si, CAD_Topo_FCove.n) {
            se = CAD_Topo.FCoveGet(0, si)
            IfCondition NotEqual(se, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(se, 0), vh) ThenBlock: { nsel = Add(nsel, 1) }
                IfCondition EqualTo(CAD_Store.Read(se, 1), vh) ThenBlock: { nsel = Add(nsel, 1) }
            }
            si = Add(si, 1)
        }
        ReturnValue(nsel)
    }
}

// Rim vertex whose two support edges are LINE+CIRCLE: plane–cyl, not 2-plane.
Function.CAD_Topo.MixVertPlaneCyl {
    Input: i: Integer
    Output: Integer
    Body: {
        pk = Subtract(i, 1)
        IfCondition LessThan(pk, 0) ThenBlock: { pk = Subtract(CAD_Topo_FCove.n, 1) }
        a = CAD_Topo.FCoveGet(24, i)
        b = CAD_Topo.FCoveGet(24, pk)
        IfCondition EqualTo(a, 1) ThenBlock: {
            IfCondition EqualTo(b, 2) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(a, 2) ThenBlock: {
            IfCondition EqualTo(b, 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.MixFixSharp {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo.FilletEmitLoadHostN(CAD_Topo_FCove.i)
            CAD_Topo_FCove.sn = CAD_Topo.ClassifyFilletJunction(CAD_Topo_FCove.i)
            CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i)
            IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo.FilletDumpI("fillet IR th i=", 14, CAD_Topo_FCove.i)
            CAD_Topo.FilletDumpI(" jc=", 4, CAD_Topo_FCove.sn)
            CAD_Topo.FilletDumpI(" nsel=", 6, CAD_Topo.MixVertSelCount(CAD_Topo_FCove.v0))
            // Compound fillet cannot join a sharp (not G1) arc to a line
            // in one pass. Sphere needs XYZ; cope is two-plane.
            IfCondition EqualTo(CAD_Topo.MixVertPlaneCyl(CAD_Topo_FCove.i), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.MixVertSelCount(CAD_Topo_FCove.v0), 2) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FilletIdentifyJoinG1(CAD_Topo_FCove.i), 0) ThenBlock: {
                        CAD_Topo_State.fillet_reason = 12
                        PrintMessage("fillet refuse: sharp arc-line in compound\n")
                        CAD_Topo.FilletDumpI(" refuse i=", 10, CAD_Topo_FCove.i)
                        CAD_Topo.FilletDumpS("\n", 1)
                        ReturnValue(0)
                    }
                }
            }
            // sn=1 XYZ trihedral sphere. sn=2 two-LINE cope. Never both.
            IfCondition EqualTo(CAD_Topo_FCove.sn, 1) ThenBlock: {
                IfCondition GreaterThan(CAD_Topo.MixVertSelCount(CAD_Topo_FCove.v0), 2) ThenBlock: {
                    CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.i, 1)
                    IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
                    CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.k)
                    CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
                    CAD_Topo_FCove.ok = 0
                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.ok = 6 }
                    }
                    IfCondition NotEqual(CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i), 0) ThenBlock: {
                        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.ok))
                        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 1)))
                        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 2)))
                        CAD_Topo.FCoveSet(408, CAD_Topo_FCove.i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
                        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 3)))
                        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 4)))
                        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 5)))
                        CAD_Topo.FCoveSet(480, CAD_Topo_FCove.i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
                        CAD_Topo_FCove.ln = CAD_Topo_FCove.r
                        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
                        CAD_Topo_FCove.cx = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.ok), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x))
                        CAD_Topo_FCove.cy = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 1)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y))
                        CAD_Topo_FCove.cz = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 2)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
                        CAD_Topo_FCove.n2x = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 3)), CAD_Topo_FCove.cx)
                        CAD_Topo_FCove.n2y = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 4)), CAD_Topo_FCove.cy)
                        CAD_Topo_FCove.n2z = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 5)), CAD_Topo_FCove.cz)
                        CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
                        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
                            CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ab)
                            CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ab)
                            CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ab)
                            ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
                            ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
                            ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
                            ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
                            ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
                            ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
                            ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.n2x)
                            ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.n2y)
                            ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.n2z)
                            CAD_Topo_FCove.which = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
                            CAD_Topo.FCoveSet(384, CAD_Topo_FCove.i, 1)
                            CAD_Topo.FCoveSet(288, CAD_Topo_FCove.i, CAD_Topo.FilletSphereArc(CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)))
                            CAD_Topo.FCoveSet(396, CAD_Topo_FCove.i, CAD_Topo.FilletSphereArc(CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(480, CAD_Topo_FCove.i)))
                        }
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.sn, 2) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.MixVertSelCount(CAD_Topo_FCove.v0), 2) ThenBlock: {
                    // Rim-only (hfilt 0) still copes. A split host with a
                    // third selected edge leaves the quarter: the canal
                    // pass fillets that vertical on the convex center.
                    CAD_Topo_FCove.hit = 1
                    IfCondition NotEqual(CAD_Topo_FComp.hfilt, 0) ThenBlock: {
                        IfCondition GreaterThan(CAD_Topo.FilletIRCountAt(CAD_Topo_FCove.v0), 2) ThenBlock: {
                            CAD_Topo_FCove.hit = 0
                        }
                    }
                    IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                        CAD_Topo.MixCopeVert(CAD_Topo_FCove.i)
                    }
                }
            }
            CAD_Topo.FilletDumpI(" gram=", 6, CAD_Topo.FCoveGet(384, CAD_Topo_FCove.i))
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

// Previous edge's Tw at this vertex. The end whose vertex is V.
// No Sqrt. Clobbers k, pt, v0, e, ok, orig, FComp.h.
Function.CAD_Topo.MixCopeOtherTw {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.k = Subtract(i, 1)
        IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.k)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
        IfCondition LessThan(CAD_Topo_FComp.h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok = 0
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.ok = 6 }
        IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: {
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0) ThenBlock: { ReturnValue(0) }
        }
        CAD_Topo_FCove.orig = 14
        IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 15 }
        IfCondition NotEqual(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 3)))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 4)))
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 5)))
        ReturnValue(CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
    }
}

// 1 when the cope drop left the corner's Z and the solved contact
// did not. A both-axis meet already shares that Z, so the contact
// stays. Copies land in d12/d13/d23; aa/bb/ab are the heights.
Function.CAD_Topo.FilletCopePreferDrop {
    Input: contact: Integer
    Input: drop: Integer
    Input: corner: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.d12 = contact
        CAD_Topo_FCove.d13 = drop
        CAD_Topo_FCove.d23 = corner
        IfCondition EqualTo(CAD_Topo_FCove.d13, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.d12, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo_FCove.d23, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.aa = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.d12, 2), CAD_Store.Read(CAD_Topo_FCove.d23, 2))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.aa), 1) ThenBlock: {
            CAD_Topo_FCove.aa = Float_Sub(0, CAD_Topo_FCove.aa)
        }
        CAD_Topo_FCove.bb = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.d13, 2), CAD_Store.Read(CAD_Topo_FCove.d23, 2))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.bb), 1) ThenBlock: {
            CAD_Topo_FCove.bb = Float_Sub(0, CAD_Topo_FCove.bb)
        }
        CAD_Topo_FCove.ab = Float_Sub(CAD_Topo_FCove.bb, CAD_Topo_FCove.aa)
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FCove.ab, 0x3FA999999999999A)), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// Wall contact, or the cope drop when that contact is still at the
// sharp height. g/minlen/padh hold the args across PreferDrop.
Function.CAD_Topo.FilletCopeCap {
    Input: contact: Integer
    Input: drop: Integer
    Input: corner: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.g = contact
        CAD_Topo_FCove.minlen = drop
        CAD_Topo_FCove.padh = corner
        IfCondition EqualTo(CAD_Topo.FilletCopePreferDrop(CAD_Topo_FCove.g, CAD_Topo_FCove.minlen, CAD_Topo_FCove.padh), 1) ThenBlock: {
            ReturnValue(CAD_Topo_FCove.minlen)
        }
        IfCondition EqualTo(CAD_Topo_FCove.g, 0) ThenBlock: { ReturnValue(CAD_Topo_FCove.minlen) }
        ReturnValue(CAD_Topo_FCove.g)
    }
}

// 1 when edge i's host face is edge k's wall face. The two rails
// then lie on that one face. The other flip (i's wall is k's host)
// is a different pair and stays on the cope drop.
Function.CAD_Topo.FCoveHostIsWall {
    Input: i: Integer
    Input: k: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.j = i
        CAD_Topo_FCove.nxt = k
        CAD_Topo_FComp.host = 0
        CAD_Topo_FComp.j = CAD_Topo.FilletIRIndexOf(CAD_Topo.FCoveGet(0, CAD_Topo_FCove.j))
        IfCondition GreaterEqual(CAD_Topo_FComp.j, 0) ThenBlock: {
            CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 19)
        }
        IfCondition EqualTo(CAD_Topo_FComp.host, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.wall = CAD_Topo.FCoveGet(48, CAD_Topo_FCove.nxt)
        IfCondition EqualTo(CAD_Topo_FComp.host, CAD_Topo_FComp.wall) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when two vertices share two axes within 0.05 mm.
// d12/d13/aa/det are scratch. j and nxt stay put.
Function.CAD_Topo.FCoveAxisAlign {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.d12 = a
        CAD_Topo_FCove.d13 = b
        IfCondition EqualTo(CAD_Topo_FCove.d12, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.d13, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.det = 0
        CAD_Topo_FCove.aa = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.d12, 0), CAD_Store.Read(CAD_Topo_FCove.d13, 0))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.aa), 1) ThenBlock: {
            CAD_Topo_FCove.aa = Float_Sub(0, CAD_Topo_FCove.aa)
        }
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.aa, 0x3FA999999999999A), 1) ThenBlock: {
            CAD_Topo_FCove.det = Add(CAD_Topo_FCove.det, 1)
        }
        CAD_Topo_FCove.aa = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.d12, 1), CAD_Store.Read(CAD_Topo_FCove.d13, 1))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.aa), 1) ThenBlock: {
            CAD_Topo_FCove.aa = Float_Sub(0, CAD_Topo_FCove.aa)
        }
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.aa, 0x3FA999999999999A), 1) ThenBlock: {
            CAD_Topo_FCove.det = Add(CAD_Topo_FCove.det, 1)
        }
        CAD_Topo_FCove.aa = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.d12, 2), CAD_Store.Read(CAD_Topo_FCove.d13, 2))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.aa), 1) ThenBlock: {
            CAD_Topo_FCove.aa = Float_Sub(0, CAD_Topo_FCove.aa)
        }
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.aa, 0x3FA999999999999A), 1) ThenBlock: {
            CAD_Topo_FCove.det = Add(CAD_Topo_FCove.det, 1)
        }
        IfCondition GreaterEqual(CAD_Topo_FCove.det, 2) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Vertex where i's host rail meets k's wall rail. The wall contact
// replaces the cope drop only when that contact lines up with i's
// host start and the drop does not — a slash onto the plan corner.
// A contact still at the sharp height keeps the drop. Sphere corners
// and every other pair return 0 so the caller keeps slot 480.
Function.CAD_Topo.FCoveSharedCap {
    Input: i: Integer
    Input: k: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.j = i
        CAD_Topo_FCove.nxt = k
        IfCondition NotEqual(CAD_Topo.FCoveGet(384, CAD_Topo_FCove.nxt), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveHostIsWall(CAD_Topo_FCove.j, CAD_Topo_FCove.nxt), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.g = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.nxt)
        CAD_Topo_FCove.minlen = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.nxt)
        IfCondition EqualTo(CAD_Topo_FCove.g, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.minlen, 0) ThenBlock: { ReturnValue(CAD_Topo_FCove.g) }
        CAD_Topo_FCove.padh = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.j)
        IfCondition EqualTo(CAD_Topo.FCoveAxisAlign(CAD_Topo_FCove.padh, CAD_Topo_FCove.g), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveAxisAlign(CAD_Topo_FCove.padh, CAD_Topo_FCove.minlen), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.padh = CAD_Topo.FCoveGet(12, CAD_Topo_FCove.nxt)
        ReturnValue(CAD_Topo.FilletCopeCap(CAD_Topo_FCove.g, CAD_Topo_FCove.minlen, CAD_Topo_FCove.padh))
    }
}

// Same meet at this edge's start: the previous edge's host is this wall.
Function.CAD_Topo.FCoveSharedCapPrev {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.j = i
        CAD_Topo_FCove.nxt = Subtract(CAD_Topo_FCove.j, 1)
        IfCondition LessThan(CAD_Topo_FCove.nxt, 0) ThenBlock: {
            CAD_Topo_FCove.nxt = Subtract(CAD_Topo_FCove.n, 1)
        }
        ReturnValue(CAD_Topo.FCoveSharedCap(CAD_Topo_FCove.nxt, CAD_Topo_FCove.j))
    }
}

// n1 is this edge's host. A chain that arrives on the vertical
// has a horizontal host normal, so V-R*N slides along the top
// edge and the back rail climbs to the sharp corner. Keep the
// host with the larger |Nz| — that is the drop that shortens
// the vertical. Equal |Nz| leaves this edge's host in place.
Function.CAD_Topo.MixCopeDropHost {
    Input: i: Integer
    Output: Integer
    Body: {
        zx = Float_Mul(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n1z)
        CAD_Topo_FCove.k = Subtract(i, 1)
        IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
        ok = CAD_Topo.FilletEmitLoadHostN(CAD_Topo_FCove.k)
        use = 0
        IfCondition EqualTo(ok, 1) ThenBlock: {
            zy = Float_Mul(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n1z)
            IfCondition EqualTo(Float_Le(zy, zx), 0) ThenBlock: { use = 1 }
        }
        IfCondition EqualTo(use, 0) ThenBlock: {
            CAD_Topo.FilletEmitLoadHostN(i)
        }
        ReturnValue(1)
    }
}

// Equal-R line-line corner. Ellipse from Th down to V_drop.
// Slot 492 stays 0: no sphere, no shelf, no plan-view round.
// Slot 480 stays V_drop so the vertical shortens and stays vertical.
// Slot 396 is the equal-R digon Th to V_drop.
Function.CAD_Topo.MixCopeVert {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.k = Subtract(i, 1)
        IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
        IfCondition NotEqual(CAD_Topo.FilletIRFaceKind(CAD_Topo.FCoveGet(48, i)), 1) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(CAD_Topo.FilletIRFaceKind(CAD_Topo.FCoveGet(48, CAD_Topo_FCove.k)), 1) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        CAD_Topo_FCove.f1 = CAD_Topo.FCoveGet(432, i)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo.MixCopeDropHost(i)
        CAD_Topo_FCove.ln = CAD_Topo_FCove.r
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 0), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 1), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 2), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z)))
        CAD_Topo_FCove.hit = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo.FCoveSet(480, i, CAD_Topo_FCove.hit)
        CAD_Topo_FCove.cx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 0), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x))
        CAD_Topo_FCove.cy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 1), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y))
        CAD_Topo_FCove.cz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 2), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
        CAD_Topo.FCoveSet(204, i, CAD_Topo_FCove.cx)
        CAD_Topo.FCoveSet(216, i, CAD_Topo_FCove.cy)
        CAD_Topo.FCoveSet(228, i, CAD_Topo_FCove.cz)
        CAD_Topo.FCoveSet(492, i, 0)
        IfCondition EqualTo(CAD_Topo_State.digon_S, 0) ThenBlock: { CAD_Topo_State.digon_S = Allocate(4096) }
        IfCondition EqualTo(CAD_Topo_State.digon_S, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo_FCove.frame, 0) ThenBlock: { ReturnValue(1) }
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        CAD_Topo_FCove.which = CAD_Topo.MakeEqualRDigonEdge(CAD_Topo_FCove.f1, CAD_Topo_FCove.hit, CAD_Topo_FCove.frame, CAD_Topo_FCove.frame, CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo.FCoveSet(396, i, CAD_Topo_FCove.which)
        CAD_Topo.FilletDumpI("fillet IR cope i=", 16, i)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Short line Tw-Vdrop beside the wall rail. ce0 is this coedge so the
// shelf's RegisterCe takes the twin. Does not assign FCove.i.
Function.CAD_Topo.MixCopeSplice {
    Input: face_h: Integer
    Input: rail_e: Integer
    Input: tw_v: Integer
    Input: drop_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(rail_e, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tw_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(drop_v, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.wa = CAD_Topo.FindCoedgeOnFace(face_h, rail_e)
        IfCondition EqualTo(CAD_Topo_FCove.wa, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.wa, 5)
        IfCondition EqualTo(CAD_Topo_FCove.orig, tw_v) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveMakeLineE(drop_v, tw_v)
            IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.ce = CAD_Topo.MakeCoedge(CAD_Topo_FCove.e, drop_v, 1)
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
            CAD_Store.Write(CAD_Topo_FCove.e, 3, CAD_Topo_FCove.ce)
            CAD_Topo_FCove.prv = CAD_Store.Read(CAD_Topo_FCove.wa, 3)
            IfCondition EqualTo(CAD_Topo_FCove.prv, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo.CoedgeInsertAfter(CAD_Topo_FCove.prv, CAD_Topo_FCove.ce), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(CAD_Topo_FCove.e)
        }
        CAD_Topo_FCove.v0 = CAD_Store.Read(rail_e, 0)
        CAD_Topo_FCove.v1 = CAD_Store.Read(rail_e, 1)
        CAD_Topo_FCove.ok = 0
        IfCondition EqualTo(CAD_Topo_FCove.v0, tw_v) ThenBlock: { CAD_Topo_FCove.ok = 1 }
        IfCondition EqualTo(CAD_Topo_FCove.v1, tw_v) ThenBlock: { CAD_Topo_FCove.ok = 1 }
        IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.e = CAD_Topo.FCoveMakeLineE(tw_v, drop_v)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ce = CAD_Topo.MakeCoedge(CAD_Topo_FCove.e, tw_v, 1)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Topo_FCove.e, 3, CAD_Topo_FCove.ce)
        IfCondition EqualTo(CAD_Topo.CoedgeInsertAfter(CAD_Topo_FCove.wa, CAD_Topo_FCove.ce), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Topo_FCove.e)
    }
}

// Plane through C, normal n1. X = unit(Tw-C), Y = Z cross X.
Function.CAD_Topo.MixCopeShelfSurf {
    Input: cx_r: Integer
    Input: cy_r: Integer
    Input: cz_r: Integer
    Input: tw_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(tw_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.frame, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.cx = cx_r
        CAD_Topo_FCove.cy = cy_r
        CAD_Topo_FCove.cz = cz_r
        CAD_Topo_FCove.v0 = tw_v
        CAD_Topo_FCove.aa = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.bb = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.ab = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.ln = Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.n1x), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n1y)), Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.aa = Float_Sub(CAD_Topo_FCove.aa, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x))
        CAD_Topo_FCove.bb = Float_Sub(CAD_Topo_FCove.bb, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y))
        CAD_Topo_FCove.ab = Float_Sub(CAD_Topo_FCove.ab, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.aa), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.bb)), Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.ab)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.aa = Float_Div(CAD_Topo_FCove.aa, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.bb = Float_Div(CAD_Topo_FCove.bb, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.ab = Float_Div(CAD_Topo_FCove.ab, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2x = Float_Sub(Float_Mul(CAD_Topo_FCove.n1y, CAD_Topo_FCove.ab), Float_Mul(CAD_Topo_FCove.n1z, CAD_Topo_FCove.bb))
        CAD_Topo_FCove.n2y = Float_Sub(Float_Mul(CAD_Topo_FCove.n1z, CAD_Topo_FCove.aa), Float_Mul(CAD_Topo_FCove.n1x, CAD_Topo_FCove.ab))
        CAD_Topo_FCove.n2z = Float_Sub(Float_Mul(CAD_Topo_FCove.n1x, CAD_Topo_FCove.bb), Float_Mul(CAD_Topo_FCove.n1y, CAD_Topo_FCove.aa))
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.aa)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.bb)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.ab)
        ArraySet(CAD_Topo_FCove.frame, 6, Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln))
        ArraySet(CAD_Topo_FCove.frame, 7, Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln))
        ArraySet(CAD_Topo_FCove.frame, 8, Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln))
        ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FCove.n1x)
        ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FCove.n1y)
        ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FCove.n1z)
        ReturnValue(CAD_Geom.MakePlaneFrame(CAD_Topo_FCove.frame))
    }
}

// Sphere octant plus the shelf under it. Splice both walls first.
// A failed splice is printed and does not refuse the fillet.
// Does not assign FCove.i.
Function.CAD_Topo.MixCopeClose {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo.FilletEmitLoadHostN(i)
        CAD_Topo_FCove.k = Subtract(i, 1)
        IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
        CAD_Topo_FCove.f1 = CAD_Topo.MixCopeSplice(CAD_Topo.FCoveGet(48, i), CAD_Topo.FCoveGet(324, i), CAD_Topo.FCoveGet(276, i), CAD_Topo.FCoveGet(480, i))
        CAD_Topo_FCove.f2 = CAD_Topo.MixCopeSplice(CAD_Topo.FCoveGet(48, CAD_Topo_FCove.k), CAD_Topo.FCoveGet(324, CAD_Topo_FCove.k), CAD_Topo.FCoveGet(492, i), CAD_Topo.FCoveGet(480, i))
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: {
            PrintMessage("fillet cope splice this i=")
            PrintNumber(i)
            PrintMessage("\n")
        }
        IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: {
            PrintMessage("fillet cope splice prev i=")
            PrintNumber(i)
            PrintMessage("\n")
        }
        CAD_Topo_FVert.cx = CAD_Topo.FCoveGet(204, i)
        CAD_Topo_FVert.cy = CAD_Topo.FCoveGet(216, i)
        CAD_Topo_FVert.cz = CAD_Topo.FCoveGet(228, i)
        CAD_Topo_FVert.r = CAD_Topo_FCove.r
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(276, i)
        CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(492, i)
        CAD_Topo_FCove.hit = CAD_Topo.FilletSphereArc(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1)
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
            PrintMessage("fillet cope ball arc i=")
            PrintNumber(i)
            PrintMessage("\n")
            ReturnValue(1)
        }
        CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(432, i)
        ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(288, i), CAD_Topo_FCove.ok))
        ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.hit, CAD_Topo_FCove.v0))
        ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(396, i), CAD_Topo_FCove.v1))
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 0), 0) ThenBlock: {
            PrintMessage("fillet cope ball ring i=")
            PrintNumber(i)
            PrintMessage("\n")
            ReturnValue(1)
        }
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 3, CAD_Topo_FCove.lp)
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo_FVert.cx)
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo_FVert.cy)
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo_FVert.cz)
        CAD_Topo_FCove.which = CAD_Topo.MakeFace(CAD_Geom.MakeSphereSurf(CAD_Topo_FCove.pt, CAD_Topo_FCove.r), CAD_Topo_FCove.lp)
        IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
            CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.which)
        }
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.aa = CAD_Topo.MixCopeShelfSurf(CAD_Topo_FVert.cx, CAD_Topo_FVert.cy, CAD_Topo_FVert.cz, CAD_Topo_FCove.v0)
        IfCondition EqualTo(CAD_Topo_FCove.aa, 0) ThenBlock: { ReturnValue(1) }
        ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.f1, CAD_Topo_FCove.v0))
        ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.f2, CAD_Topo.FCoveGet(480, i)))
        ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.hit, CAD_Topo_FCove.v1))
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 0), 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 3, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.which = CAD_Topo.MakeFace(CAD_Topo_FCove.aa, CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.which)
        ReturnValue(1)
    }
}

Function.CAD_Topo.MixMakeSphere {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveGet(384, CAD_Topo_FCove.i), 1) ThenBlock: {
                CAD_Topo_FVert.cx = CAD_Topo.FCoveGet(204, CAD_Topo_FCove.i)
                CAD_Topo_FVert.cy = CAD_Topo.FCoveGet(216, CAD_Topo_FCove.i)
                CAD_Topo_FVert.cz = CAD_Topo.FCoveGet(228, CAD_Topo_FCove.i)
                CAD_Topo_FVert.r = CAD_Topo_FCove.r
                CAD_Topo_FCove.which = CAD_Topo.FilletSphereArc(CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(480, CAD_Topo_FCove.i))
                IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
                ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(288, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)))
                ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.which, CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)))
                ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(480, CAD_Topo_FCove.i)))
                IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 0), 0) ThenBlock: { ReturnValue(0) }
                CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
                CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 3, CAD_Topo_FCove.lp)
                ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo_FVert.cx)
                ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo_FVert.cy)
                ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo_FVert.cz)
                CAD_Topo_FCove.f1 = CAD_Topo.MakeFace(CAD_Geom.MakeSphereSurf(CAD_Topo_FCove.pt, CAD_Topo_FCove.r), CAD_Topo_FCove.lp)
                IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(0) }
                CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.f1)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

// Per-edge host normal from the IR. A chain can mix the top face
// with side springs; the last arc must not steer every rail.
// 0 leaves the chain normal already in n1.
Function.CAD_Topo.FilletEmitLoadHostN {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
        IfCondition LessThan(CAD_Topo_FComp.h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.aa = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 6)
        CAD_Topo_FCove.ab = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 7)
        CAD_Topo_FCove.bb = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 8)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.aa), Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.ab)), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.bb)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = Float_Div(CAD_Topo_FCove.aa, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1y = Float_Div(CAD_Topo_FCove.ab, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1z = Float_Div(CAD_Topo_FCove.bb, CAD_Topo_FCove.ln)
        ReturnValue(1)
    }
}

// 1 when a split-host chain meets at two lines and the cope is off.
// Those corners keep each edge's own wall contact. A G1 seam, a cope,
// and a rim-only chain (hfilt 0) still share the next edge's cap.
Function.CAD_Topo.FilletSplitLineCorner {
    Input: i: Integer
    Input: k: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FComp.hfilt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FCoveGet(24, i), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FCoveGet(24, k), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FCoveGet(480, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FCoveGet(480, k), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FCoveGet(492, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FCoveGet(492, k), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Far Tw of edge i from its own solved end. The next edge's Tw is the
// other wall of the corner, so the wall rail must not end there.
Function.CAD_Topo.FilletOwnFarTw {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo.FCoveGet(12, i)) ThenBlock: {
            CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        }
        CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
        IfCondition LessThan(CAD_Topo_FComp.h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok = 0
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v1) ThenBlock: {
            CAD_Topo_FCove.ok = 6
        }
        CAD_Topo_FCove.orig = 14
        IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 15 }
        IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 0) ThenBlock: {
            ReturnValue(0)
        }
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 3)))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 4)))
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 5)))
        ReturnValue(CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
    }
}

// Far Th of edge i from its own solved end. The next edge's drop is
// the plan corner, so the host rail must not end there.
Function.CAD_Topo.FilletOwnFarTh {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo.FCoveGet(12, i)) ThenBlock: {
            CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        }
        CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
        IfCondition LessThan(CAD_Topo_FComp.h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok = 0
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v1) ThenBlock: {
            CAD_Topo_FCove.ok = 6
        }
        CAD_Topo_FCove.orig = 14
        IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 15 }
        IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 0) ThenBlock: {
            ReturnValue(0)
        }
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.ok))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 1)))
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 2)))
        ReturnValue(CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
    }
}

// 1 when edge i's host is edge k's wall, or i's wall is k's host.
// The rolling ball then continues on the shared face: host rail ends
// on k's wall contact, wall rail on k's host contact. Same host stays 0.
Function.CAD_Topo.FCoveHostWallFlip {
    Input: i: Integer
    Input: k: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.host = 0
        CAD_Topo_FComp.j = CAD_Topo.FilletIRIndexOf(CAD_Topo.FCoveGet(0, i))
        IfCondition GreaterEqual(CAD_Topo_FComp.j, 0) ThenBlock: {
            CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 19)
        }
        CAD_Topo_FComp.wall = 0
        CAD_Topo_FComp.j = CAD_Topo.FilletIRIndexOf(CAD_Topo.FCoveGet(0, k))
        IfCondition GreaterEqual(CAD_Topo_FComp.j, 0) ThenBlock: {
            CAD_Topo_FComp.wall = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 19)
        }
        IfCondition NotEqual(CAD_Topo_FComp.host, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.host, CAD_Topo.FCoveGet(48, k)) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition NotEqual(CAD_Topo_FComp.wall, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FCoveGet(48, i), CAD_Topo_FComp.wall) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// Record a unique corner of the fillet batch. cnt tracks how many
// selected edges share it — a vertex sphere needs at least two.
