            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                PrintNumber(Float_ToInt(CAD_Store.Read(CAD_Topo_FCove.ok, 0)))
                PrintMessage(",")
                PrintNumber(Float_ToInt(CAD_Store.Read(CAD_Topo_FCove.ok, 1)))
            }
            PrintMessage(" prev=")
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(408, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                PrintNumber(Float_ToInt(CAD_Store.Read(CAD_Topo_FCove.ok, 0)))
                PrintMessage(",")
                PrintNumber(Float_ToInt(CAD_Store.Read(CAD_Topo_FCove.ok, 1)))
            }
            PrintMessage(" gram=")
            PrintNumber(CAD_Topo.FCoveGet(384, CAD_Topo_FCove.i))
            PrintMessage("\n")
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

// EMIT does not invent a meet. SOLVE already refused miss>|R|.
Function.CAD_Topo.MixCopeVert {
    Input: i: Integer
    Output: Integer
    Body: {
        ReturnValue(1)
    }
}

Function.CAD_Topo.MixMakeSphere {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveGet(384, CAD_Topo_FCove.i), 1) ThenBlock: {
                CAD_Topo_FVert.cx = CAD_Topo.FCoveGet(204, CAD_Topo_FCove.i)
                CAD_Topo_FVert.cy = CAD_Topo.FCoveGet(216, CAD_Topo_FCove.i)
                CAD_Topo_FVert.cz = CAD_Topo.FCoveGet(228, CAD_Topo_FCove.i)
                CAD_Topo_FVert.r = CAD_Topo_FCove.r
                CAD_Topo_FCove.which = CAD_Topo.FilletSphereArc(CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(390, CAD_Topo_FCove.i))
                IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
                ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(288, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)))
                ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.which, CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)))
                ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(390, CAD_Topo_FCove.i)))
                IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 0), 0) ThenBlock: { ReturnValue(0) }
                CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
                CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 3, CAD_Topo_FCove.lp)
                ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo_FVert.cx)
                ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo_FVert.cy)
                ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo_FVert.cz)
                CAD_Topo_FCove.f1 = CAD_Topo.MakeFace(CAD_Geom.MakeSphereSurf(CAD_Topo_FCove.pt, CAD_Topo_FCove.r), CAD_Topo_FCove.lp)
                IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(0) }
                CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.f1)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.RimSolveVert {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
        CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
        CAD_Topo_FCove.hit = 0
        IfCondition GreaterEqual(CAD_Topo_FComp.h, 0) ThenBlock: {
            CAD_Topo_FCove.ok = 0
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.ok = 6 }
            }
            CAD_Topo_FCove.orig = 14
            IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 15 }
            IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 1) ThenBlock: {
                ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.ok))
                ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 1)))
                ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 2)))
                CAD_Topo.FCoveSet(432, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
                ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 3)))
                ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 4)))
                ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 5)))
                CAD_Topo.FCoveSet(276, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
                CAD_Topo_FCove.ln = CAD_Topo_FCove.r
                IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
                CAD_Topo_FCove.cx = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.ok), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x))
                CAD_Topo_FCove.cy = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 1)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y))
                CAD_Topo_FCove.cz = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 2)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
                CAD_Topo_FCove.n2x = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 3)), CAD_Topo_FCove.cx)
                CAD_Topo_FCove.n2y = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 4)), CAD_Topo_FCove.cy)
                CAD_Topo_FCove.n2z = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 5)), CAD_Topo_FCove.cz)
                CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
                    CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ab)
                    CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ab)
                    CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ab)
                    ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
                    ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
                    ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
                    ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
                    ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
                    ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
                    ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.n2x)
                    ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.n2y)
                    ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.n2z)
                    CAD_Topo_FCove.which = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
                    CAD_Topo.FCoveSet(288, i, CAD_Topo.MakeMinorArcEdge(CAD_Topo.FCoveGet(432, i), CAD_Topo.FCoveGet(276, i), CAD_Topo_FCove.which))
                    CAD_Topo_FCove.orig = 12
                    IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 13 }
                    IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 1) ThenBlock: {
                        CAD_Topo.FCoveSet(384, i, 1)
                    }
                    CAD_Topo_FCove.hit = 1
                }
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FCoveGet(432, i), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo.FCoveGet(276, i), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo.FCoveGet(288, i), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        IfCondition EqualTo(CAD_Topo.RimWallN(i, CAD_Topo_FCove.v0), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ab = Float_Add(0x3FF0000000000000, Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ab = Float_Div(CAD_Topo_FCove.r, CAD_Topo_FCove.ab)
        CAD_Topo_FCove.ln = CAD_Topo_FCove.r
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
        CAD_Topo_FCove.cx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 0), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n2x)))
        CAD_Topo_FCove.cy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 1), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n2y)))
        CAD_Topo_FCove.cz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 2), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            CAD_Topo_FCove.cx = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 0), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n2x)))
            CAD_Topo_FCove.cy = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 1), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n2y)))
            CAD_Topo_FCove.cz = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 2), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n2z)))
        }
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z)))
        CAD_Topo.FCoveSet(432, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n2z)))
        CAD_Topo.FCoveSet(276, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.n2x)
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.n2y)
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.n2z)
        CAD_Topo_FCove.which = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
        CAD_Topo.FCoveSet(288, i, CAD_Topo.MakeMinorArcEdge(CAD_Topo.FCoveGet(432, i), CAD_Topo.FCoveGet(276, i), CAD_Topo_FCove.which))
        IfCondition EqualTo(CAD_Topo.FCoveGet(432, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(276, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(288, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.RimMakeSeg {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.k = Add(i, 1)
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
        CAD_Topo_FCove.hit = 0
        IfCondition NotEqual(CAD_Topo_FCove.k, i) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k), CAD_Store.Read(CAD_Topo_FCove.e, 0)) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                IfCondition EqualTo(CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k), CAD_Store.Read(CAD_Topo_FCove.e, 1)) ThenBlock: { CAD_Topo_FCove.hit = 1 }
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
            CAD_Topo_FCove.f1 = CAD_Topo.FCoveGet(408, CAD_Topo_FCove.k)
            IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { CAD_Topo_FCove.f1 = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k) }
            CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(390, CAD_Topo_FCove.k)
            IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k) }
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
            CAD_Topo_FCove.v1 = 0
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo.FCoveGet(12, i)) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1) }
            }
            CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
            CAD_Topo_FCove.ok = 0
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v1) ThenBlock: { CAD_Topo_FCove.ok = 6 }
            }
            CAD_Topo_FCove.orig = 14
            IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 15 }
            IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 1) ThenBlock: {
                ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.ok))
                ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 1)))
                ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 2)))
                CAD_Topo_FCove.f1 = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
                ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 3)))
                ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 4)))
                ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 5)))
                CAD_Topo_FCove.f2 = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
            }
            IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FilletIRVert2Face(CAD_Topo_FComp.h, CAD_Topo_FCove.v1), 1) ThenBlock: {
                    ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo_FComp.px)
                    ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo_FComp.py)
                    ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo_FComp.pz)
                    CAD_Topo_FCove.f1 = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
                    ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo_FComp.cx)
                    ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo_FComp.cy)
                    ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo_FComp.cz)
                    CAD_Topo_FCove.f2 = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
                }
            }
        }
        CAD_Topo_FCove.kind = CAD_Topo.FCoveGet(24, i)
        IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
            CAD_Topo.FCoveSet(312, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(432, i), CAD_Topo_FCove.f1))
            CAD_Topo.FCoveSet(324, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(276, i), CAD_Topo_FCove.f2))
            CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
            IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k), 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0))
                CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k), 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1))
                CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k), 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2))
            }
            IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
                CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 0), CAD_Store.Read(CAD_Topo.FCoveGet(432, i), 0))
                CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 1), CAD_Store.Read(CAD_Topo.FCoveGet(432, i), 1))
                CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 2), CAD_Store.Read(CAD_Topo.FCoveGet(432, i), 2))
            }
            CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 0) ThenBlock: {
                CAD_Topo_FCove.edx = Float_Div(CAD_Topo_FCove.edx, CAD_Topo_FCove.ln)
                CAD_Topo_FCove.edy = Float_Div(CAD_Topo_FCove.edy, CAD_Topo_FCove.ln)
                CAD_Topo_FCove.edz = Float_Div(CAD_Topo_FCove.edz, CAD_Topo_FCove.ln)
            }
            CAD_Topo_FCove.ln = CAD_Topo_FCove.r
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
            CAD_Topo_FCove.cx = Float_Sub(CAD_Store.Read(CAD_Topo.FCoveGet(432, i), 0), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x))
            CAD_Topo_FCove.cy = Float_Sub(CAD_Store.Read(CAD_Topo.FCoveGet(432, i), 1), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y))
            CAD_Topo_FCove.cz = Float_Sub(CAD_Store.Read(CAD_Topo.FCoveGet(432, i), 2), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
            ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
            ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
            ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
            ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
            ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
            ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
            CAD_Topo_FCove.aa = Float_Sub(Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.n1z), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.n1y))
            CAD_Topo_FCove.bb = Float_Sub(Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.n1x), Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.n1z))
            CAD_Topo_FCove.ln = Float_Sub(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.n1y), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.n1x))
            CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.aa), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.bb)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.ln)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
                CAD_Topo_FCove.aa = Float_Div(CAD_Topo_FCove.aa, CAD_Topo_FCove.ab)
                CAD_Topo_FCove.bb = Float_Div(CAD_Topo_FCove.bb, CAD_Topo_FCove.ab)
                CAD_Topo_FCove.ln = Float_Div(CAD_Topo_FCove.ln, CAD_Topo_FCove.ab)
            }
            ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.aa)
            ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.bb)
            ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.ln)
            ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FCove.edx)
            ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FCove.edy)
            ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FCove.edz)
            CAD_Topo.FCoveSet(300, CAD_Topo_FCove.i, CAD_Geom.MakeCylinderSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.r))
            CAD_Topo.FCoveSet(348, CAD_Topo_FCove.i, CAD_Topo.FCoveGet(288, CAD_Topo_FCove.i))
            IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.f1, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.f2, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i), 0) ThenBlock: {
                            CAD_Topo.FCoveSet(396, CAD_Topo_FCove.i, CAD_Topo.FilletMerThrough(CAD_Topo_FCove.f1, CAD_Topo_FCove.f2))
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.which, 1)
            CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.which, 2)
            CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.which, 3)
            CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_FCove.which, 10)
            CAD_Topo_FCove.orig = CAD_Topo_FCove.r
            IfCondition EqualTo(CAD_Topo.FCoveGet(36, i), 0) ThenBlock: { CAD_Topo_FCove.orig = Float_Sub(0, CAD_Topo_FCove.r) }
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.orig = Float_Sub(0, CAD_Topo_FCove.r) }
            CAD_Topo_FCove.ab = Float_Sub(CAD_Topo_FCove.aa, CAD_Topo_FCove.orig)
            PrintMessage("fillet rim arc i=")
            PrintNumber(i)
            PrintMessage(" conv=")
            PrintNumber(CAD_Topo.FCoveGet(36, i))
            PrintMessage(" r2=")
            PrintNumber(Float_ToInt(CAD_Topo_FCove.aa))
            PrintMessage(" Rmaj=")
            PrintNumber(Float_ToInt(CAD_Topo_FCove.ab))
            PrintMessage("\n")
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.orig), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.ab), 1) ThenBlock: { ReturnValue(0) }
            }
            CAD_Topo_FCove.s = CAD_Topo_FCove.r
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.s = Float_Sub(0, CAD_Topo_FCove.r) }
            ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
            ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
            ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
            ArraySet(CAD_Topo_FCove.frame, 3, CAD_Store.Read(CAD_Topo_FCove.which, 4))
            ArraySet(CAD_Topo_FCove.frame, 4, CAD_Store.Read(CAD_Topo_FCove.which, 5))
            ArraySet(CAD_Topo_FCove.frame, 5, CAD_Store.Read(CAD_Topo_FCove.which, 6))
            ArraySet(CAD_Topo_FCove.frame, 6, CAD_Store.Read(CAD_Topo_FCove.which, 7))
            ArraySet(CAD_Topo_FCove.frame, 7, CAD_Store.Read(CAD_Topo_FCove.which, 8))
            ArraySet(CAD_Topo_FCove.frame, 8, CAD_Store.Read(CAD_Topo_FCove.which, 9))
            // Host circle through the SOLVE T_host, not r±R. Rank-3 mouths
            // sit off the 2-face offset; a circle they are not on tessellates
            // as a sharp original rim / planar chord.
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(432, i)
            IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 0), CAD_Topo_FCove.cx)
                CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 1), CAD_Topo_FCove.cy)
                CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 2), CAD_Topo_FCove.cz)
                CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 0) ThenBlock: { CAD_Topo_FCove.ab = CAD_Topo_FCove.ln }
            }
            PrintMessage("fillet rim hostR=")
            PrintNumber(Float_ToInt(CAD_Topo_FCove.ab))
            PrintMessage("\n")
            CAD_Topo_FCove.ln = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab)
            CAD_Topo.FCoveSet(312, i, CAD_Topo.FilletEmitArcRail(CAD_Topo.FCoveGet(432, i), CAD_Topo_FCove.f1, CAD_Topo_FCove.ln, CAD_Topo_FCove.which, CAD_Topo_FCove.e, CAD_Topo.FCoveGet(12, i)))
            ArraySet(CAD_Topo_FCove.frame, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1x)))
            ArraySet(CAD_Topo_FCove.frame, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1y)))
            ArraySet(CAD_Topo_FCove.frame, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1z)))
            CAD_Topo_FCove.v1 = CAD_Topo_FCove.f2
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(276, i)
            IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 0), ArrayGet(CAD_Topo_FCove.frame, 0))
                CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 1), ArrayGet(CAD_Topo_FCove.frame, 1))
                CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 2), ArrayGet(CAD_Topo_FCove.frame, 2))
                CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 0) ThenBlock: { CAD_Topo_FCove.aa = CAD_Topo_FCove.ln }
            }
            CAD_Topo_FCove.bb = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.aa)
            CAD_Topo.FCoveSet(324, i, CAD_Topo.FilletEmitArcRail(CAD_Topo.FCoveGet(276, i), CAD_Topo_FCove.v1, CAD_Topo_FCove.bb, CAD_Topo_FCove.which, CAD_Topo_FCove.e, CAD_Topo.FCoveGet(12, i)))
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(312, i)
            CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(324, i)
            IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
                    CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.ok, 2)
                    CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.orig, 2)
                    IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                        IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
                            CAD_Store.Write(CAD_Topo_FCove.orig, 12, CAD_Store.Read(CAD_Topo_FCove.ok, 12))
                        }
                    }
                }
            }
            ArraySet(CAD_Topo_FCove.frame, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1x)))
            ArraySet(CAD_Topo_FCove.frame, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1y)))
            ArraySet(CAD_Topo_FCove.frame, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1z)))
            ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FCove.n1x)
            ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FCove.n1y)
            ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FCove.n1z)
            CAD_Topo.FCoveSet(300, i, CAD_Geom.MakeTorusSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab, CAD_Topo_FCove.r))
            CAD_Topo.FCoveSet(348, i, CAD_Topo.FCoveGet(288, i))
            IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.f1, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.f2, 0) ThenBlock: {
                        // Same mer as RimSolveVert: C = T_host − ln N_host.
                        CAD_Topo_FCove.ln = CAD_Topo_FCove.r
                        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
                        CAD_Topo_FCove.cx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 0), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x))
                        CAD_Topo_FCove.cy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 1), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y))
                        CAD_Topo_FCove.cz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 2), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
                        CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f2, 0), CAD_Topo_FCove.cx)
                        CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f2, 1), CAD_Topo_FCove.cy)
                        CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f2, 2), CAD_Topo_FCove.cz)
                        CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
                        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
                            CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ab)
                            CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ab)
                            CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ab)
                        }
                        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
                        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
                        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
                        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
                        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
                        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
                        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.n2x)
                        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.n2y)
                        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.n2z)
                        CAD_Topo.FCoveSet(396, i, CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.f1, CAD_Topo_FCove.f2, CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)))
                    }
                }
            }
        }
        IfCondition EqualTo(CAD_Topo.FCoveGet(312, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(324, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(300, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.RimSwap {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.host_f, CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i))
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            CAD_Topo_FCove.which = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)
            CAD_Topo_FCove.k = Add(CAD_Topo_FCove.i, 1)
            IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
            IfCondition EqualTo(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)) ThenBlock: {
                CAD_Topo_FCove.which = CAD_Topo.FCoveGet(408, CAD_Topo_FCove.k)
                IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.which = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k) }
            }
            IfCondition EqualTo(CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i), CAD_Topo_FCove.which), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, CAD_Topo_FCove.i)
            CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f2, CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i))
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            CAD_Topo_FCove.which = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)
            IfCondition EqualTo(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)) ThenBlock: {
                CAD_Topo_FCove.which = CAD_Topo.FCoveGet(390, CAD_Topo_FCove.k)
                IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.which = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k) }
            }
            IfCondition EqualTo(CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i), CAD_Topo_FCove.which), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo.FaceRetargetVert(CAD_Topo_FCove.f2, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i))
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(408, CAD_Topo_FCove.i)
            CAD_Topo_FCove.hit = 1
            IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveGet(384, CAD_Topo_FCove.i), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.ok, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)), 0) ThenBlock: {
                        CAD_Topo_FCove.hit = 0
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                CAD_Topo.FaceRetargetVert(CAD_Topo_FCove.host_f, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i))
            }
            CAD_Topo.FilletSewOpenEnd(CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(288, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(48, CAD_Topo_FCove.i))
            IfCondition NotEqual(CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
                CAD_Topo_FCove.v1 = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                    IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i)) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1) }
                }
                CAD_Topo_FCove.ok = 0
                CAD_Topo_FCove.hit = 0
                CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i)
                IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
                    CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.orig, 0)
                    IfCondition EqualTo(CAD_Topo_FCove.ok, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)) ThenBlock: { CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.orig, 1) }
                }
                CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i)
                IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
                    CAD_Topo_FCove.hit = CAD_Store.Read(CAD_Topo_FCove.orig, 0)
                    IfCondition EqualTo(CAD_Topo_FCove.hit, CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)) ThenBlock: { CAD_Topo_FCove.hit = CAD_Store.Read(CAD_Topo_FCove.orig, 1) }
                }
                CAD_Topo.FaceRetargetVert(CAD_Topo_FCove.host_f, CAD_Topo_FCove.v1, CAD_Topo_FCove.ok, CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i))
                CAD_Topo.FaceRetargetVert(CAD_Topo_FCove.f2, CAD_Topo_FCove.v1, CAD_Topo_FCove.hit, CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i))
                CAD_Topo.FilletSewOpenEnd(CAD_Topo_FCove.v1, CAD_Topo_FCove.ok, CAD_Topo_FCove.hit, CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(48, CAD_Topo_FCove.i))
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

// Record a unique corner of the fillet batch. cnt tracks how many
// selected edges share it — a vertex sphere needs at least two.
