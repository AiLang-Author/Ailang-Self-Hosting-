// CAD.Topo.Fillet — split from Library.CAD_Topo.ailang
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.MakeMinorArcEdge {
    Input: v0_h: Integer
    Input: v1_h: Integer
    Input: circ_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(v0_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(circ_h, 0) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(circ_h, 1)
        cy = CAD_Store.Read(circ_h, 2)
        cz = CAD_Store.Read(circ_h, 3)
        xx = CAD_Store.Read(circ_h, 4)
        xy = CAD_Store.Read(circ_h, 5)
        xz = CAD_Store.Read(circ_h, 6)
        yx = CAD_Store.Read(circ_h, 7)
        yy = CAD_Store.Read(circ_h, 8)
        yz = CAD_Store.Read(circ_h, 9)
        // unit coords in circle plane: u=(P-C)·X, v=(P-C)·Y
        p0x = Float_Sub(CAD_Store.Read(v0_h, 0), cx)
        p0y = Float_Sub(CAD_Store.Read(v0_h, 1), cy)
        p0z = Float_Sub(CAD_Store.Read(v0_h, 2), cz)
        p1x = Float_Sub(CAD_Store.Read(v1_h, 0), cx)
        p1y = Float_Sub(CAD_Store.Read(v1_h, 1), cy)
        p1z = Float_Sub(CAD_Store.Read(v1_h, 2), cz)
        u0 = Float_Add(Float_Add(Float_Mul(p0x, xx), Float_Mul(p0y, xy)), Float_Mul(p0z, xz))
        v0 = Float_Add(Float_Add(Float_Mul(p0x, yx), Float_Mul(p0y, yy)), Float_Mul(p0z, yz))
        u1 = Float_Add(Float_Add(Float_Mul(p1x, xx), Float_Mul(p1y, xy)), Float_Mul(p1z, xz))
        v1 = Float_Add(Float_Add(Float_Mul(p1x, yx), Float_Mul(p1y, yy)), Float_Mul(p1z, yz))
        // Minor arc only. A 270° end-cap was tessellated as a sheet that
        // ran past the edge (16-35/16-36). Clone the circle and store the
        // signed span in (-π, π] so SampleCircleEdge cannot walk the long way.
        a0 = CAD_Geom.Atan2(v0, u0)
        a1 = CAD_Geom.Atan2(v1, u1)
        two_pi = 0x401921FB54442D18
        pi = 0x400921FB54442D18
        span = Float_Sub(a1, a0)
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(span, Float_Sub(0, pi))), 1) ThenBlock: {
            span = Float_Add(span, two_pi)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, span)), 1) ThenBlock: {
            span = Float_Sub(span, two_pi)
        }
        aa = v0_h
        bb = v1_h
        IfCondition EqualTo(CAD_Num.IsNeg(span), 1) ThenBlock: {
            aa = v1_h
            bb = v0_h
            span = Float_Sub(0, span)
        }
        ch = CAD_Store.Alloc(16, 14)
        IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(CAD_Topo.MakeEdge(aa, bb, circ_h)) }
        si = 0
        WhileLoop LessThan(si, 14) {
            CAD_Store.Write(ch, si, CAD_Store.Read(circ_h, si))
            si = Add(si, 1)
        }
        CAD_Store.Write(ch, 12, span)
        ReturnValue(CAD_Topo.MakeEdge(aa, bb, ch))
    }
}

// In-place fillet of ONE plane–plane edge. Adds a blend face and trims
// only the two support faces + the two end faces. Existing coves stay.
Function.CAD_Topo.FilletEdgeLocal {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.solid = solid_handle
        CAD_Topo_FLoc.edge = edge_handle
        CAD_Topo_FLoc.r = radius_r
        CAD_Topo_FLoc.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FLoc.shell, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.faces, 0) ThenBlock: { CAD_Topo_FLoc.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FLoc.pl1, 0) ThenBlock: { CAD_Topo_FLoc.pl1 = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FLoc.pl2, 0) ThenBlock: { CAD_Topo_FLoc.pl2 = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: { CAD_Topo_FLoc.pt = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FLoc.p1b, 0) ThenBlock: { CAD_Topo_FLoc.p1b = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FLoc.frame, 0) ThenBlock: { CAD_Topo_FLoc.frame = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FLoc.ring, 0) ThenBlock: { CAD_Topo_FLoc.ring = Allocate(64) }
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FLoc.edge, CAD_Topo_FLoc.faces), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.f1 = ArrayGet(CAD_Topo_FLoc.faces, 0)
        CAD_Topo_FLoc.f2 = ArrayGet(CAD_Topo_FLoc.faces, 1)
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FLoc.f1, CAD_Topo_FLoc.pl1), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FLoc.f2, CAD_Topo_FLoc.pl2), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.v0 = CAD_Store.Read(CAD_Topo_FLoc.edge, 0)
        CAD_Topo_FLoc.v1 = CAD_Store.Read(CAD_Topo_FLoc.edge, 1)
        IfCondition EqualTo(CAD_Topo_FLoc.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.v1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.edge, 2)
        IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ce, 0), 1) ThenBlock: { ReturnValue(0) }
        }
        CAD_Topo_FLoc.n1x = ArrayGet(CAD_Topo_FLoc.pl1, 10)
        CAD_Topo_FLoc.n1y = ArrayGet(CAD_Topo_FLoc.pl1, 11)
        CAD_Topo_FLoc.n1z = ArrayGet(CAD_Topo_FLoc.pl1, 12)
        CAD_Topo_FLoc.n2x = ArrayGet(CAD_Topo_FLoc.pl2, 10)
        CAD_Topo_FLoc.n2y = ArrayGet(CAD_Topo_FLoc.pl2, 11)
        CAD_Topo_FLoc.n2z = ArrayGet(CAD_Topo_FLoc.pl2, 12)
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n1x), Float_Mul(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n1y)), Float_Mul(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.n1x = Float_Div(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n1y = Float_Div(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n1z = Float_Div(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.n2x, CAD_Topo_FLoc.n2x), Float_Mul(CAD_Topo_FLoc.n2y, CAD_Topo_FLoc.n2y)), Float_Mul(CAD_Topo_FLoc.n2z, CAD_Topo_FLoc.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.n2x = Float_Div(CAD_Topo_FLoc.n2x, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n2y = Float_Div(CAD_Topo_FLoc.n2y, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n2z = Float_Div(CAD_Topo_FLoc.n2z, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        CAD_Topo_FLoc.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        CAD_Topo_FLoc.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.ln)
        // Span the original edge. The vertex sphere owns the corner:
        // it retargets these generator ends onto the 3-plane ball.
        ArraySet(CAD_Topo_FLoc.pt, 0, CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        ArraySet(CAD_Topo_FLoc.pt, 1, CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        ArraySet(CAD_Topo_FLoc.pt, 2, CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
        ArraySet(CAD_Topo_FLoc.p1b, 0, CAD_Store.Read(CAD_Topo_FLoc.v1, 0))
        ArraySet(CAD_Topo_FLoc.p1b, 1, CAD_Store.Read(CAD_Topo_FLoc.v1, 1))
        ArraySet(CAD_Topo_FLoc.p1b, 2, CAD_Store.Read(CAD_Topo_FLoc.v1, 2))
        CAD_Topo_FLoc.ab = Float_Add(0x3FF0000000000000, Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x), Float_Mul(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y)), Float_Mul(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ab, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.ab = Float_Div(CAD_Topo_FLoc.r, CAD_Topo_FLoc.ab)
        // Convex: C = P − ab(N1+N2). Cove: C = P + ab(N1+N2).
        CAD_Topo_FLoc.which = 0
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FLoc.which = 1 }
        CAD_Topo_FLoc.c0x = Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x))
        CAD_Topo_FLoc.c0y = Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y))
        CAD_Topo_FLoc.c0z = Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z))
        IfCondition EqualTo(CAD_Topo_FLoc.which, 0) ThenBlock: {
            CAD_Topo_FLoc.c0x = Float_Sub(ArrayGet(CAD_Topo_FLoc.pt, 0), CAD_Topo_FLoc.c0x)
            CAD_Topo_FLoc.c0y = Float_Sub(ArrayGet(CAD_Topo_FLoc.pt, 1), CAD_Topo_FLoc.c0y)
            CAD_Topo_FLoc.c0z = Float_Sub(ArrayGet(CAD_Topo_FLoc.pt, 2), CAD_Topo_FLoc.c0z)
            CAD_Topo_FLoc.c1x = Float_Sub(ArrayGet(CAD_Topo_FLoc.p1b, 0), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x)))
            CAD_Topo_FLoc.c1y = Float_Sub(ArrayGet(CAD_Topo_FLoc.p1b, 1), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y)))
            CAD_Topo_FLoc.c1z = Float_Sub(ArrayGet(CAD_Topo_FLoc.p1b, 2), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z)))
        }
        IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
            CAD_Topo_FLoc.c0x = Float_Add(ArrayGet(CAD_Topo_FLoc.pt, 0), CAD_Topo_FLoc.c0x)
            CAD_Topo_FLoc.c0y = Float_Add(ArrayGet(CAD_Topo_FLoc.pt, 1), CAD_Topo_FLoc.c0y)
            CAD_Topo_FLoc.c0z = Float_Add(ArrayGet(CAD_Topo_FLoc.pt, 2), CAD_Topo_FLoc.c0z)
            CAD_Topo_FLoc.c1x = Float_Add(ArrayGet(CAD_Topo_FLoc.p1b, 0), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x)))
            CAD_Topo_FLoc.c1y = Float_Add(ArrayGet(CAD_Topo_FLoc.p1b, 1), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y)))
            CAD_Topo_FLoc.c1z = Float_Add(ArrayGet(CAD_Topo_FLoc.p1b, 2), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z)))
        }
        // Contacts: convex C+R N, cove C−R N
        CAD_Topo_FLoc.ln = CAD_Topo_FLoc.r
        IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: { CAD_Topo_FLoc.ln = Float_Sub(0, CAD_Topo_FLoc.r) }
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c0x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c0y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c0z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1z)))
        CAD_Topo_FLoc.va0 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c0x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c0y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c0z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2z)))
        CAD_Topo_FLoc.vb0 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c1x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c1y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c1z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1z)))
        CAD_Topo_FLoc.va1 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c1x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c1y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c1z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2z)))
        CAD_Topo_FLoc.vb1 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        IfCondition EqualTo(CAD_Topo_FLoc.va0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.vb1, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FLoc.frame, 0, CAD_Topo_FLoc.c0x)
        ArraySet(CAD_Topo_FLoc.frame, 1, CAD_Topo_FLoc.c0y)
        ArraySet(CAD_Topo_FLoc.frame, 2, CAD_Topo_FLoc.c0z)
        ArraySet(CAD_Topo_FLoc.frame, 3, CAD_Topo_FLoc.n1x)
        ArraySet(CAD_Topo_FLoc.frame, 4, CAD_Topo_FLoc.n1y)
        ArraySet(CAD_Topo_FLoc.frame, 5, CAD_Topo_FLoc.n1z)
        CAD_Topo_FLoc.ab = Float_Sub(Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.n1z), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.n1y))
        ArraySet(CAD_Topo_FLoc.frame, 6, CAD_Topo_FLoc.ab)
        CAD_Topo_FLoc.ab = Float_Sub(Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.n1x), Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.n1z))
        ArraySet(CAD_Topo_FLoc.frame, 7, CAD_Topo_FLoc.ab)
        CAD_Topo_FLoc.ab = Float_Sub(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.n1y), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.n1x))
        ArraySet(CAD_Topo_FLoc.frame, 8, CAD_Topo_FLoc.ab)
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Topo_FLoc.frame, 6), ArrayGet(CAD_Topo_FLoc.frame, 6)), Float_Mul(ArrayGet(CAD_Topo_FLoc.frame, 7), ArrayGet(CAD_Topo_FLoc.frame, 7))), Float_Mul(ArrayGet(CAD_Topo_FLoc.frame, 8), ArrayGet(CAD_Topo_FLoc.frame, 8))))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 0) ThenBlock: {
            ArraySet(CAD_Topo_FLoc.frame, 6, Float_Div(ArrayGet(CAD_Topo_FLoc.frame, 6), CAD_Topo_FLoc.ln))
            ArraySet(CAD_Topo_FLoc.frame, 7, Float_Div(ArrayGet(CAD_Topo_FLoc.frame, 7), CAD_Topo_FLoc.ln))
            ArraySet(CAD_Topo_FLoc.frame, 8, Float_Div(ArrayGet(CAD_Topo_FLoc.frame, 8), CAD_Topo_FLoc.ln))
        }
        ArraySet(CAD_Topo_FLoc.frame, 9, CAD_Topo_FLoc.edx)
        ArraySet(CAD_Topo_FLoc.frame, 10, CAD_Topo_FLoc.edy)
        ArraySet(CAD_Topo_FLoc.frame, 11, CAD_Topo_FLoc.edz)
        CAD_Topo_FLoc.cyl = CAD_Geom.MakeCylinderSurf(CAD_Topo_FLoc.frame, CAD_Topo_FLoc.r)
        ArraySet(CAD_Topo_FLoc.frame, 0, CAD_Topo_FLoc.c0x)
        ArraySet(CAD_Topo_FLoc.frame, 1, CAD_Topo_FLoc.c0y)
        ArraySet(CAD_Topo_FLoc.frame, 2, CAD_Topo_FLoc.c0z)
        CAD_Topo_FLoc.ce = CAD_Geom.MakeCircle(CAD_Topo_FLoc.frame, CAD_Topo_FLoc.r)
        ArraySet(CAD_Topo_FLoc.frame, 0, CAD_Topo_FLoc.c1x)
        ArraySet(CAD_Topo_FLoc.frame, 1, CAD_Topo_FLoc.c1y)
        ArraySet(CAD_Topo_FLoc.frame, 2, CAD_Topo_FLoc.c1z)
        CAD_Topo_FLoc.endf = CAD_Geom.MakeCircle(CAD_Topo_FLoc.frame, CAD_Topo_FLoc.r)
        ArraySet(CAD_Topo_FLoc.pt, 0, CAD_Store.Read(CAD_Topo_FLoc.va0, 0))
        ArraySet(CAD_Topo_FLoc.pt, 1, CAD_Store.Read(CAD_Topo_FLoc.va0, 1))
        ArraySet(CAD_Topo_FLoc.pt, 2, CAD_Store.Read(CAD_Topo_FLoc.va0, 2))
        ArraySet(CAD_Topo_FLoc.p1b, 0, CAD_Store.Read(CAD_Topo_FLoc.va1, 0))
        ArraySet(CAD_Topo_FLoc.p1b, 1, CAD_Store.Read(CAD_Topo_FLoc.va1, 1))
        ArraySet(CAD_Topo_FLoc.p1b, 2, CAD_Store.Read(CAD_Topo_FLoc.va1, 2))
        CAD_Topo_FLoc.ega = CAD_Topo.MakeEdge(CAD_Topo_FLoc.va0, CAD_Topo_FLoc.va1, CAD_Geom.MakeLine(CAD_Topo_FLoc.pt, CAD_Topo_FLoc.p1b))
        ArraySet(CAD_Topo_FLoc.pt, 0, CAD_Store.Read(CAD_Topo_FLoc.vb0, 0))
        ArraySet(CAD_Topo_FLoc.pt, 1, CAD_Store.Read(CAD_Topo_FLoc.vb0, 1))
        ArraySet(CAD_Topo_FLoc.pt, 2, CAD_Store.Read(CAD_Topo_FLoc.vb0, 2))
        ArraySet(CAD_Topo_FLoc.p1b, 0, CAD_Store.Read(CAD_Topo_FLoc.vb1, 0))
        ArraySet(CAD_Topo_FLoc.p1b, 1, CAD_Store.Read(CAD_Topo_FLoc.vb1, 1))
        ArraySet(CAD_Topo_FLoc.p1b, 2, CAD_Store.Read(CAD_Topo_FLoc.vb1, 2))
        CAD_Topo_FLoc.egb = CAD_Topo.MakeEdge(CAD_Topo_FLoc.vb0, CAD_Topo_FLoc.vb1, CAD_Geom.MakeLine(CAD_Topo_FLoc.pt, CAD_Topo_FLoc.p1b))
        CAD_Topo_FLoc.arc0 = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FLoc.va0, CAD_Topo_FLoc.vb0, CAD_Topo_FLoc.ce)
        CAD_Topo_FLoc.arc1 = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FLoc.va1, CAD_Topo_FLoc.vb1, CAD_Topo_FLoc.endf)
        IfCondition EqualTo(CAD_Topo_FLoc.ega, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.arc1, 0) ThenBlock: { ReturnValue(0) }
        // Blend loop: A-gen, arc1, B-gen rev, arc0 rev
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ega, 0), CAD_Topo_FLoc.va0) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 0, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.ega, CAD_Topo_FLoc.va0, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.ega, 3, ArrayGet(CAD_Topo_FLoc.ring, 0))
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.arc1, 0), CAD_Topo_FLoc.va1) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 1, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.arc1, CAD_Topo_FLoc.va1, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.arc1, 3, ArrayGet(CAD_Topo_FLoc.ring, 1))
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.egb, 0), CAD_Topo_FLoc.vb1) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 2, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.egb, CAD_Topo_FLoc.vb1, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.egb, 3, ArrayGet(CAD_Topo_FLoc.ring, 2))
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.arc0, 0), CAD_Topo_FLoc.vb0) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 3, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.arc0, CAD_Topo_FLoc.vb0, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.arc0, 3, ArrayGet(CAD_Topo_FLoc.ring, 3))
        CAD_Topo_FLoc.ce = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FLoc.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FLoc.ring, 4, CAD_Topo_FLoc.ce)
        CAD_Topo_FLoc.endf = CAD_Topo.MakeFace(CAD_Topo_FLoc.cyl, CAD_Topo_FLoc.ce)
        IfCondition EqualTo(CAD_Topo_FLoc.endf, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Topo_FLoc.shell, CAD_Topo_FLoc.endf)
        // Trim F1 / F2: replace E with generators
        CAD_Topo_FLoc.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FLoc.f1, CAD_Topo_FLoc.edge)
        IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: {
            PrintMessage("fillet LOCAL no coedge f1\n")
            ReturnValue(0)
        }
        CAD_Topo_FLoc.which = CAD_Store.Read(CAD_Topo_FLoc.ce, 5)
        CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va0
        IfCondition EqualTo(CAD_Topo_FLoc.which, CAD_Topo_FLoc.v1) ThenBlock: { CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va1 }
        CAD_Topo.CoedgeSwapEdge(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.ega, CAD_Topo_FLoc.aa)
        CAD_Topo_FLoc.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FLoc.f2, CAD_Topo_FLoc.edge)
        IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: {
            PrintMessage("fillet LOCAL no coedge f2\n")
            ReturnValue(0)
        }
        CAD_Topo_FLoc.which = CAD_Store.Read(CAD_Topo_FLoc.ce, 5)
        CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb0
        IfCondition EqualTo(CAD_Topo_FLoc.which, CAD_Topo_FLoc.v1) ThenBlock: { CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb1 }
        CAD_Topo.CoedgeSwapEdge(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.egb, CAD_Topo_FLoc.bb)
        // Cove: do not insert the end-cap arc into the adjacent wall.
        // That fan sat in the next face's plane and ran past the edge
        // (16-35 / 16-43). Convex still closes the two end faces.
        CAD_Topo_FLoc.ei = 0
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            CAD_Topo_FLoc.ei = 2
        }
        WhileLoop LessThan(CAD_Topo_FLoc.ei, 2) {
            CAD_Topo_FLoc.vv = CAD_Topo_FLoc.v0
            CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va0
            CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb0
            CAD_Topo_FLoc.ar = CAD_Topo_FLoc.arc0
            IfCondition EqualTo(CAD_Topo_FLoc.ei, 1) ThenBlock: {
                CAD_Topo_FLoc.vv = CAD_Topo_FLoc.v1
                CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va1
                CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb1
                CAD_Topo_FLoc.ar = CAD_Topo_FLoc.arc1
            }
            CAD_Topo_FCE.dx = CAD_Topo_FLoc.edx
            CAD_Topo_FCE.dy = CAD_Topo_FLoc.edy
            CAD_Topo_FCE.dz = CAD_Topo_FLoc.edz
            CAD_Topo_FLoc.endf = CAD_Topo.FindFaceWithVert(CAD_Topo_FLoc.solid, CAD_Topo_FLoc.vv, CAD_Topo_FLoc.f1, CAD_Topo_FLoc.f2)
            IfCondition NotEqual(CAD_Topo_FLoc.endf, 0) ThenBlock: {
                CAD_Topo_FLoc.lp = 0
                CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.endf, 1), 0)
                CAD_Topo_FLoc.hd = CAD_Topo_FLoc.ce
                CAD_Topo_FLoc.ln = 0
                WhileLoop LessThan(CAD_Topo_FLoc.ln, 2048) {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.ce, 5), CAD_Topo_FLoc.vv) ThenBlock: {
                        CAD_Topo_FLoc.lp = CAD_Topo_FLoc.ce
                        CAD_Topo_FLoc.ln = 2048
                    }
                    IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: { CAD_Topo_FLoc.ln = 2048 }
                    IfCondition EqualTo(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.ce, 2)
                        IfCondition EqualTo(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.hd) ThenBlock: { CAD_Topo_FLoc.ln = 2048 }
                    }
                    CAD_Topo_FLoc.ln = Add(CAD_Topo_FLoc.ln, 1)
                }
                IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                    CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.lp, 3)
                    CAD_Topo_FLoc.hd = 0
                    IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.FindCoedgeOnFace(CAD_Topo_FLoc.f1, CAD_Store.Read(CAD_Topo_FLoc.ce, 0)), 0) ThenBlock: {
                            CAD_Topo_FLoc.hd = 1
                        }
                    }
                    IfCondition EqualTo(CAD_Topo_FLoc.hd, 1) ThenBlock: {
                        CAD_Topo_FLoc.ln = CAD_Topo_FLoc.aa
                        CAD_Topo_FLoc.aa = CAD_Topo_FLoc.bb
                        CAD_Topo_FLoc.bb = CAD_Topo_FLoc.ln
                    }
                    CAD_Topo_FLoc.sn = 1
                    IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ar, 0), CAD_Topo_FLoc.aa) ThenBlock: { CAD_Topo_FLoc.sn = 0 }
                    CAD_Topo_FLoc.cyl = CAD_Topo.MakeCoedge(CAD_Topo_FLoc.ar, CAD_Topo_FLoc.aa, CAD_Topo_FLoc.sn)
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.ar, 4), 0) ThenBlock: {
                        CAD_Store.Write(CAD_Topo_FLoc.ar, 4, CAD_Topo_FLoc.cyl)
                        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ar, 3), 0) ThenBlock: {
                            CAD_Topo.LinkTwins(CAD_Store.Read(CAD_Topo_FLoc.ar, 3), CAD_Topo_FLoc.cyl)
                        }
                    }
                    CAD_Topo.CoedgeInsertAfter(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.cyl)
                    IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                        CAD_Topo.EdgeRetargetVert(CAD_Store.Read(CAD_Topo_FLoc.ce, 0), CAD_Topo_FLoc.vv, CAD_Topo_FLoc.aa)
                    }
                    CAD_Topo.EdgeRetargetVert(CAD_Store.Read(CAD_Topo_FLoc.lp, 0), CAD_Topo_FLoc.vv, CAD_Topo_FLoc.bb)
                }
            }
            CAD_Topo_FLoc.ei = Add(CAD_Topo_FLoc.ei, 1)
        }
        // Connect F1/F2 loops: adjacent edges still pointed at v0/v1 after
        // the swap. End-face insert may have retargeted some; this catches all.
        CAD_Topo.FaceRetargetVert(CAD_Topo_FLoc.f1, CAD_Topo_FLoc.v0, CAD_Topo_FLoc.va0, CAD_Topo_FLoc.ega)
        CAD_Topo.FaceRetargetVert(CAD_Topo_FLoc.f1, CAD_Topo_FLoc.v1, CAD_Topo_FLoc.va1, CAD_Topo_FLoc.ega)
        CAD_Topo.FaceRetargetVert(CAD_Topo_FLoc.f2, CAD_Topo_FLoc.v0, CAD_Topo_FLoc.vb0, CAD_Topo_FLoc.egb)
        CAD_Topo.FaceRetargetVert(CAD_Topo_FLoc.f2, CAD_Topo_FLoc.v1, CAD_Topo_FLoc.vb1, CAD_Topo_FLoc.egb)
        PrintMessage("fillet LOCAL edge ok\n")
        ReturnValue(CAD_Topo_FLoc.solid)
    }
}

// Fillet one plane–plane edge. Local surgery — previous blends stay.
Function.CAD_Topo.FilletPlanePlaneEdge {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Topo.FilletEdgeLocal(solid_handle, edge_handle, radius_r))
    }
}

// Record a unique corner of the fillet batch. cnt tracks how many
// selected edges share it — a vertex sphere needs at least two.
Function.CAD_Topo.FilletVertNote {
    Input: vx: Integer
    Input: vy: Integer
    Input: vz: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FVert.xyz, 0) ThenBlock: { CAD_Topo_FVert.xyz = Allocate(256) }
        IfCondition EqualTo(CAD_Topo_FVert.cnt, 0) ThenBlock: { CAD_Topo_FVert.cnt = Allocate(64) }
        IfCondition EqualTo(CAD_Topo_FVert.xyz, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.k = 0
        CAD_Topo_FVert.ok = 0
        WhileLoop LessThan(CAD_Topo_FVert.k, CAD_Topo_FVert.n) {
            IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(CAD_Topo_FVert.xyz, Multiply(CAD_Topo_FVert.k, 3)), vx, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.k, 3), 1)), vy, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.k, 3), 2)), vz, 0), 1) ThenBlock: {
                        ArraySet(CAD_Topo_FVert.cnt, CAD_Topo_FVert.k, Add(ArrayGet(CAD_Topo_FVert.cnt, CAD_Topo_FVert.k), 1))
                        CAD_Topo_FVert.ok = 1
                        CAD_Topo_FVert.k = CAD_Topo_FVert.n
                    }
                }
            }
            CAD_Topo_FVert.k = Add(CAD_Topo_FVert.k, 1)
        }
        IfCondition EqualTo(CAD_Topo_FVert.ok, 0) ThenBlock: {
            IfCondition LessThan(CAD_Topo_FVert.n, 32) ThenBlock: {
                ArraySet(CAD_Topo_FVert.xyz, Multiply(CAD_Topo_FVert.n, 3), vx)
                ArraySet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.n, 3), 1), vy)
                ArraySet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.n, 3), 2), vz)
                ArraySet(CAD_Topo_FVert.cnt, CAD_Topo_FVert.n, 1)
                CAD_Topo_FVert.n = Add(CAD_Topo_FVert.n, 1)
            }
        }
        ReturnValue(CAD_Topo_FVert.n)
    }
}

// Minor arc on the sphere: circle at C through va, vb.
Function.CAD_Topo.FilletSphereArc {
    Input: va: Integer
    Input: vb: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FVert.frame, 0) ThenBlock: { CAD_Topo_FVert.frame = Allocate(128) }
        CAD_Topo_FVert.aa = Float_Sub(CAD_Store.Read(va, 0), CAD_Topo_FVert.cx)
        CAD_Topo_FVert.bb = Float_Sub(CAD_Store.Read(va, 1), CAD_Topo_FVert.cy)
        CAD_Topo_FVert.ln = Float_Sub(CAD_Store.Read(va, 2), CAD_Topo_FVert.cz)
        CAD_Topo_FVert.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FVert.ab, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.aa = Float_Div(CAD_Topo_FVert.aa, CAD_Topo_FVert.ab)
        CAD_Topo_FVert.bb = Float_Div(CAD_Topo_FVert.bb, CAD_Topo_FVert.ab)
        CAD_Topo_FVert.ln = Float_Div(CAD_Topo_FVert.ln, CAD_Topo_FVert.ab)
        ArraySet(CAD_Topo_FVert.frame, 0, CAD_Topo_FVert.cx)
        ArraySet(CAD_Topo_FVert.frame, 1, CAD_Topo_FVert.cy)
        ArraySet(CAD_Topo_FVert.frame, 2, CAD_Topo_FVert.cz)
        ArraySet(CAD_Topo_FVert.frame, 3, CAD_Topo_FVert.aa)
        ArraySet(CAD_Topo_FVert.frame, 4, CAD_Topo_FVert.bb)
        ArraySet(CAD_Topo_FVert.frame, 5, CAD_Topo_FVert.ln)
        CAD_Topo_FVert.k = Float_Sub(CAD_Store.Read(vb, 0), CAD_Topo_FVert.cx)
        CAD_Topo_FVert.g = Float_Sub(CAD_Store.Read(vb, 1), CAD_Topo_FVert.cy)
        CAD_Topo_FVert.ok = Float_Sub(CAD_Store.Read(vb, 2), CAD_Topo_FVert.cz)
        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.k, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.g, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ok, CAD_Topo_FVert.ln))
        CAD_Topo_FVert.k = Float_Sub(CAD_Topo_FVert.k, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.aa))
        CAD_Topo_FVert.g = Float_Sub(CAD_Topo_FVert.g, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.bb))
        CAD_Topo_FVert.ok = Float_Sub(CAD_Topo_FVert.ok, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.ln))
        CAD_Topo_FVert.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.k, CAD_Topo_FVert.k), Float_Mul(CAD_Topo_FVert.g, CAD_Topo_FVert.g)), Float_Mul(CAD_Topo_FVert.ok, CAD_Topo_FVert.ok)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FVert.ab, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FVert.frame, 6, Float_Div(CAD_Topo_FVert.k, CAD_Topo_FVert.ab))
        ArraySet(CAD_Topo_FVert.frame, 7, Float_Div(CAD_Topo_FVert.g, CAD_Topo_FVert.ab))
        ArraySet(CAD_Topo_FVert.frame, 8, Float_Div(CAD_Topo_FVert.ok, CAD_Topo_FVert.ab))
        CAD_Topo_FVert.which = CAD_Geom.MakeCircle(CAD_Topo_FVert.frame, CAD_Topo_FVert.r)
        IfCondition EqualTo(CAD_Topo_FVert.which, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Topo.MakeMinorArcEdge(va, vb, CAD_Topo_FVert.which))
    }
}

// Nearest of T1,T2,T3 to v. 0 if v is farther than thr from the corner.
Function.CAD_Topo.FilletNearT {
    Input: v_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(v_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.aa = Float_Sub(CAD_Store.Read(v_h, 0), CAD_Topo_FVert.px)
        CAD_Topo_FVert.bb = Float_Sub(CAD_Store.Read(v_h, 1), CAD_Topo_FVert.py)
        CAD_Topo_FVert.ln = Float_Sub(CAD_Store.Read(v_h, 2), CAD_Topo_FVert.pz)
        CAD_Topo_FVert.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln)))
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FVert.ab, CAD_Topo_FVert.thr), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.which = CAD_Topo_FVert.t1
        CAD_Topo_FVert.aa = Float_Sub(CAD_Store.Read(v_h, 0), CAD_Store.Read(CAD_Topo_FVert.t1, 0))
        CAD_Topo_FVert.bb = Float_Sub(CAD_Store.Read(v_h, 1), CAD_Store.Read(CAD_Topo_FVert.t1, 1))
        CAD_Topo_FVert.ln = Float_Sub(CAD_Store.Read(v_h, 2), CAD_Store.Read(CAD_Topo_FVert.t1, 2))
        CAD_Topo_FVert.ok = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln))
        CAD_Topo_FVert.aa = Float_Sub(CAD_Store.Read(v_h, 0), CAD_Store.Read(CAD_Topo_FVert.t2, 0))
        CAD_Topo_FVert.bb = Float_Sub(CAD_Store.Read(v_h, 1), CAD_Store.Read(CAD_Topo_FVert.t2, 1))
        CAD_Topo_FVert.ln = Float_Sub(CAD_Store.Read(v_h, 2), CAD_Store.Read(CAD_Topo_FVert.t2, 2))
        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln))
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FVert.ab, CAD_Topo_FVert.ok), 1) ThenBlock: {
            CAD_Topo_FVert.ok = CAD_Topo_FVert.ab
            CAD_Topo_FVert.which = CAD_Topo_FVert.t2
        }
        CAD_Topo_FVert.aa = Float_Sub(CAD_Store.Read(v_h, 0), CAD_Store.Read(CAD_Topo_FVert.t3, 0))
        CAD_Topo_FVert.bb = Float_Sub(CAD_Store.Read(v_h, 1), CAD_Store.Read(CAD_Topo_FVert.t3, 1))
        CAD_Topo_FVert.ln = Float_Sub(CAD_Store.Read(v_h, 2), CAD_Store.Read(CAD_Topo_FVert.t3, 2))
        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln))
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FVert.ab, CAD_Topo_FVert.ok), 1) ThenBlock: {
            CAD_Topo_FVert.which = CAD_Topo_FVert.t3
        }
        ReturnValue(CAD_Topo_FVert.which)
    }
}

// Rolling-ball vertex blend. Sphere tangent to the 3 planes at P:
// Ni·(C−P) = s, s=+R cove / −R convex. Contacts Ti = C − s Ni.
// 3 minor arcs, MakeSphereSurf face, then stitch cylinder ends onto it.
Function.CAD_Topo.FilletVertexSphere {
    Input: solid_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.solid = solid_handle
        CAD_Topo_FVert.r = radius_r
        CAD_Topo_FVert.s = radius_r
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 0) ThenBlock: {
            CAD_Topo_FVert.s = Float_Sub(0, radius_r)
        }
        CAD_Topo_FVert.thr = Float_Mul(radius_r, 0x3FF8000000000000)
        IfCondition EqualTo(CAD_Topo_FVert.pl, 0) ThenBlock: { CAD_Topo_FVert.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FVert.pt, 0) ThenBlock: { CAD_Topo_FVert.pt = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FVert.ring, 0) ThenBlock: { CAD_Topo_FVert.ring = Allocate(64) }
        IfCondition EqualTo(CAD_Topo_FVert.frame, 0) ThenBlock: { CAD_Topo_FVert.frame = Allocate(128) }
        CAD_Topo_FVert.nfound = 0
        CAD_Topo_FVert.f1 = 0
        CAD_Topo_FVert.f2 = 0
        CAD_Topo_FVert.f3 = 0
        CAD_Topo_FVert.sh = CAD_Store.Read(solid_handle, 0)
        CAD_Topo_FVert.sg = 0
        WhileLoop NotEqual(CAD_Topo_FVert.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FVert.sg, 64) ThenBlock: { CAD_Topo_FVert.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FVert.sh, 0) ThenBlock: {
                CAD_Topo_FVert.face = CAD_Store.Read(CAD_Topo_FVert.sh, 0)
                CAD_Topo_FVert.fg = 0
                WhileLoop NotEqual(CAD_Topo_FVert.face, 0) {
                    IfCondition GreaterThan(CAD_Topo_FVert.fg, 4096) ThenBlock: { CAD_Topo_FVert.face = 0 }
                    IfCondition NotEqual(CAD_Topo_FVert.face, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_FVert.face, CAD_Topo_FVert.pl), 0) ThenBlock: {
                            CAD_Topo_FVert.aa = ArrayGet(CAD_Topo_FVert.pl, 10)
                            CAD_Topo_FVert.bb = ArrayGet(CAD_Topo_FVert.pl, 11)
                            CAD_Topo_FVert.ln = ArrayGet(CAD_Topo_FVert.pl, 12)
                            CAD_Topo_FVert.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln)))
                            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FVert.ab, 0), 0) ThenBlock: {
                                CAD_Topo_FVert.aa = Float_Div(CAD_Topo_FVert.aa, CAD_Topo_FVert.ab)
                                CAD_Topo_FVert.bb = Float_Div(CAD_Topo_FVert.bb, CAD_Topo_FVert.ab)
                                CAD_Topo_FVert.ln = Float_Div(CAD_Topo_FVert.ln, CAD_Topo_FVert.ab)
                                CAD_Topo_FVert.ok = Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Topo_FVert.px, ArrayGet(CAD_Topo_FVert.pl, 1)), CAD_Topo_FVert.aa), Float_Mul(Float_Sub(CAD_Topo_FVert.py, ArrayGet(CAD_Topo_FVert.pl, 2)), CAD_Topo_FVert.bb)), Float_Mul(Float_Sub(CAD_Topo_FVert.pz, ArrayGet(CAD_Topo_FVert.pl, 3)), CAD_Topo_FVert.ln))
                                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FVert.ok, 0), 1) ThenBlock: {
                                    CAD_Topo_FVert.which = 1
                                    IfCondition EqualTo(CAD_Topo_FVert.nfound, 1) ThenBlock: {
                                        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.n1x), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.n1y)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.n1z))
                                        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.ab = Float_Sub(0, CAD_Topo_FVert.ab) }
                                        IfCondition EqualTo(CAD_Num.Le(0x3FE8000000000000, CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.which = 0 }
                                    }
                                    IfCondition EqualTo(CAD_Topo_FVert.nfound, 2) ThenBlock: {
                                        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.n1x), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.n1y)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.n1z))
                                        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.ab = Float_Sub(0, CAD_Topo_FVert.ab) }
                                        IfCondition EqualTo(CAD_Num.Le(0x3FE8000000000000, CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.which = 0 }
                                        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.n2x), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.n2y)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.n2z))
                                        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.ab = Float_Sub(0, CAD_Topo_FVert.ab) }
                                        IfCondition EqualTo(CAD_Num.Le(0x3FE8000000000000, CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.which = 0 }
                                    }
                                    IfCondition GreaterThan(CAD_Topo_FVert.nfound, 2) ThenBlock: { CAD_Topo_FVert.which = 0 }
                                    IfCondition EqualTo(CAD_Topo_FVert.which, 1) ThenBlock: {
                                        IfCondition EqualTo(CAD_Topo_FVert.nfound, 0) ThenBlock: {
                                            CAD_Topo_FVert.n1x = CAD_Topo_FVert.aa
                                            CAD_Topo_FVert.n1y = CAD_Topo_FVert.bb
                                            CAD_Topo_FVert.n1z = CAD_Topo_FVert.ln
                                            CAD_Topo_FVert.f1 = CAD_Topo_FVert.face
                                        }
                                        IfCondition EqualTo(CAD_Topo_FVert.nfound, 1) ThenBlock: {
                                            CAD_Topo_FVert.n2x = CAD_Topo_FVert.aa
                                            CAD_Topo_FVert.n2y = CAD_Topo_FVert.bb
                                            CAD_Topo_FVert.n2z = CAD_Topo_FVert.ln
                                            CAD_Topo_FVert.f2 = CAD_Topo_FVert.face
                                        }
                                        IfCondition EqualTo(CAD_Topo_FVert.nfound, 2) ThenBlock: {
                                            CAD_Topo_FVert.n3x = CAD_Topo_FVert.aa
                                            CAD_Topo_FVert.n3y = CAD_Topo_FVert.bb
                                            CAD_Topo_FVert.n3z = CAD_Topo_FVert.ln
                                            CAD_Topo_FVert.f3 = CAD_Topo_FVert.face
                                        }
                                        CAD_Topo_FVert.nfound = Add(CAD_Topo_FVert.nfound, 1)
                                    }
                                }
                            }
                        }
                        CAD_Topo_FVert.face = CAD_Store.Read(CAD_Topo_FVert.face, 3)
                    }
                    CAD_Topo_FVert.fg = Add(CAD_Topo_FVert.fg, 1)
                }
                CAD_Topo_FVert.sh = CAD_Store.Read(CAD_Topo_FVert.sh, 2)
            }
            CAD_Topo_FVert.sg = Add(CAD_Topo_FVert.sg, 1)
        }
        IfCondition LessThan(CAD_Topo_FVert.nfound, 3) ThenBlock: {
            PrintMessage("fillet VERTEX need 3 planes n=")
            PrintNumber(CAD_Topo_FVert.nfound)
            PrintMessage("\n")
            ReturnValue(0)
        }
        // 3×3: Ni·(x N1 + y N2 + z N3) = s
        CAD_Topo_FVert.d12 = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.n1x, CAD_Topo_FVert.n2x), Float_Mul(CAD_Topo_FVert.n1y, CAD_Topo_FVert.n2y)), Float_Mul(CAD_Topo_FVert.n1z, CAD_Topo_FVert.n2z))
        CAD_Topo_FVert.d13 = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.n1x, CAD_Topo_FVert.n3x), Float_Mul(CAD_Topo_FVert.n1y, CAD_Topo_FVert.n3y)), Float_Mul(CAD_Topo_FVert.n1z, CAD_Topo_FVert.n3z))
        CAD_Topo_FVert.d23 = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.n2x, CAD_Topo_FVert.n3x), Float_Mul(CAD_Topo_FVert.n2y, CAD_Topo_FVert.n3y)), Float_Mul(CAD_Topo_FVert.n2z, CAD_Topo_FVert.n3z))
        CAD_Topo_FVert.det = 0x3FF0000000000000
        CAD_Topo_FVert.det = Float_Sub(CAD_Topo_FVert.det, Float_Mul(CAD_Topo_FVert.d12, CAD_Topo_FVert.d12))
        CAD_Topo_FVert.det = Float_Sub(CAD_Topo_FVert.det, Float_Mul(CAD_Topo_FVert.d13, CAD_Topo_FVert.d13))
        CAD_Topo_FVert.det = Float_Sub(CAD_Topo_FVert.det, Float_Mul(CAD_Topo_FVert.d23, CAD_Topo_FVert.d23))
        CAD_Topo_FVert.det = Float_Add(CAD_Topo_FVert.det, Float_Mul(0x4000000000000000, Float_Mul(CAD_Topo_FVert.d12, Float_Mul(CAD_Topo_FVert.d13, CAD_Topo_FVert.d23))))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FVert.det, 0), 1) ThenBlock: {
            PrintMessage("fillet VERTEX degenerate trihedral\n")
            ReturnValue(0)
        }
        CAD_Topo_FVert.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FVert.d12), CAD_Topo_FVert.d13)
        CAD_Topo_FVert.bb = Float_Sub(Float_Add(CAD_Topo_FVert.d12, CAD_Topo_FVert.d13), CAD_Topo_FVert.d23)
        CAD_Topo_FVert.ab = Float_Div(Float_Mul(CAD_Topo_FVert.s, Float_Add(CAD_Topo_FVert.aa, Float_Mul(CAD_Topo_FVert.d23, CAD_Topo_FVert.bb))), CAD_Topo_FVert.det)
        CAD_Topo_FVert.cx = Float_Add(CAD_Topo_FVert.px, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n1x))
        CAD_Topo_FVert.cy = Float_Add(CAD_Topo_FVert.py, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n1y))
        CAD_Topo_FVert.cz = Float_Add(CAD_Topo_FVert.pz, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n1z))
        CAD_Topo_FVert.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FVert.d12), CAD_Topo_FVert.d23)
        CAD_Topo_FVert.bb = Float_Sub(Float_Add(CAD_Topo_FVert.d12, CAD_Topo_FVert.d23), CAD_Topo_FVert.d13)
        CAD_Topo_FVert.ab = Float_Div(Float_Mul(CAD_Topo_FVert.s, Float_Add(CAD_Topo_FVert.aa, Float_Mul(CAD_Topo_FVert.d13, CAD_Topo_FVert.bb))), CAD_Topo_FVert.det)
        CAD_Topo_FVert.cx = Float_Add(CAD_Topo_FVert.cx, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n2x))
        CAD_Topo_FVert.cy = Float_Add(CAD_Topo_FVert.cy, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n2y))
        CAD_Topo_FVert.cz = Float_Add(CAD_Topo_FVert.cz, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n2z))
        CAD_Topo_FVert.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FVert.d13), CAD_Topo_FVert.d23)
        CAD_Topo_FVert.bb = Float_Sub(Float_Add(CAD_Topo_FVert.d13, CAD_Topo_FVert.d23), CAD_Topo_FVert.d12)
        CAD_Topo_FVert.ab = Float_Div(Float_Mul(CAD_Topo_FVert.s, Float_Add(CAD_Topo_FVert.aa, Float_Mul(CAD_Topo_FVert.d12, CAD_Topo_FVert.bb))), CAD_Topo_FVert.det)
        CAD_Topo_FVert.cx = Float_Add(CAD_Topo_FVert.cx, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n3x))
        CAD_Topo_FVert.cy = Float_Add(CAD_Topo_FVert.cy, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n3y))
        CAD_Topo_FVert.cz = Float_Add(CAD_Topo_FVert.cz, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n3z))
        ArraySet(CAD_Topo_FVert.pt, 0, Float_Sub(CAD_Topo_FVert.cx, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n1x)))
        ArraySet(CAD_Topo_FVert.pt, 1, Float_Sub(CAD_Topo_FVert.cy, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n1y)))
        ArraySet(CAD_Topo_FVert.pt, 2, Float_Sub(CAD_Topo_FVert.cz, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n1z)))
        CAD_Topo_FVert.t1 = CAD_Topo.MakeVertex(CAD_Topo_FVert.pt)
        ArraySet(CAD_Topo_FVert.pt, 0, Float_Sub(CAD_Topo_FVert.cx, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n2x)))
        ArraySet(CAD_Topo_FVert.pt, 1, Float_Sub(CAD_Topo_FVert.cy, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n2y)))
        ArraySet(CAD_Topo_FVert.pt, 2, Float_Sub(CAD_Topo_FVert.cz, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n2z)))
        CAD_Topo_FVert.t2 = CAD_Topo.MakeVertex(CAD_Topo_FVert.pt)
        ArraySet(CAD_Topo_FVert.pt, 0, Float_Sub(CAD_Topo_FVert.cx, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n3x)))
        ArraySet(CAD_Topo_FVert.pt, 1, Float_Sub(CAD_Topo_FVert.cy, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n3y)))
        ArraySet(CAD_Topo_FVert.pt, 2, Float_Sub(CAD_Topo_FVert.cz, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n3z)))
        CAD_Topo_FVert.t3 = CAD_Topo.MakeVertex(CAD_Topo_FVert.pt)
        IfCondition EqualTo(CAD_Topo_FVert.t1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FVert.t3, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.a12 = CAD_Topo.FilletSphereArc(CAD_Topo_FVert.t1, CAD_Topo_FVert.t2)
        CAD_Topo_FVert.a23 = CAD_Topo.FilletSphereArc(CAD_Topo_FVert.t2, CAD_Topo_FVert.t3)
        CAD_Topo_FVert.a31 = CAD_Topo.FilletSphereArc(CAD_Topo_FVert.t3, CAD_Topo_FVert.t1)
        IfCondition EqualTo(CAD_Topo_FVert.a12, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FVert.a31, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FVert.a12, 0), CAD_Topo_FVert.t1) ThenBlock: { CAD_Topo_FVert.which = 0 }
        ArraySet(CAD_Topo_FVert.ring, 0, CAD_Topo.MakeCoedge(CAD_Topo_FVert.a12, CAD_Topo_FVert.t1, CAD_Topo_FVert.which))
        CAD_Store.Write(CAD_Topo_FVert.a12, 3, ArrayGet(CAD_Topo_FVert.ring, 0))
        CAD_Topo_FVert.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FVert.a23, 0), CAD_Topo_FVert.t2) ThenBlock: { CAD_Topo_FVert.which = 0 }
        ArraySet(CAD_Topo_FVert.ring, 1, CAD_Topo.MakeCoedge(CAD_Topo_FVert.a23, CAD_Topo_FVert.t2, CAD_Topo_FVert.which))
        CAD_Store.Write(CAD_Topo_FVert.a23, 3, ArrayGet(CAD_Topo_FVert.ring, 1))
        CAD_Topo_FVert.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FVert.a31, 0), CAD_Topo_FVert.t3) ThenBlock: { CAD_Topo_FVert.which = 0 }
        ArraySet(CAD_Topo_FVert.ring, 2, CAD_Topo.MakeCoedge(CAD_Topo_FVert.a31, CAD_Topo_FVert.t3, CAD_Topo_FVert.which))
        CAD_Store.Write(CAD_Topo_FVert.a31, 3, ArrayGet(CAD_Topo_FVert.ring, 2))
        CAD_Topo_FVert.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FVert.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FVert.ring, 3, CAD_Topo_FVert.lp)
        ArraySet(CAD_Topo_FVert.pt, 0, CAD_Topo_FVert.cx)
        ArraySet(CAD_Topo_FVert.pt, 1, CAD_Topo_FVert.cy)
        ArraySet(CAD_Topo_FVert.pt, 2, CAD_Topo_FVert.cz)
        CAD_Topo_FVert.surf = CAD_Geom.MakeSphereSurf(CAD_Topo_FVert.pt, CAD_Topo_FVert.r)
        IfCondition EqualTo(CAD_Topo_FVert.surf, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.face = CAD_Topo.MakeFace(CAD_Topo_FVert.surf, CAD_Topo_FVert.lp)
        IfCondition EqualTo(CAD_Topo_FVert.face, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Store.Read(CAD_Topo_FVert.solid, 0), CAD_Topo_FVert.face)
        // Stitch: retarget cylinder generators onto Ti, swap end-arcs
        // for the sphere's great-circle arcs (twins).
        CAD_Topo_FVert.sh = CAD_Store.Read(CAD_Topo_FVert.solid, 0)
        CAD_Topo_FVert.sg = 0
        WhileLoop NotEqual(CAD_Topo_FVert.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FVert.sg, 64) ThenBlock: { CAD_Topo_FVert.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FVert.sh, 0) ThenBlock: {
                CAD_Topo_FVert.k = CAD_Store.Read(CAD_Topo_FVert.sh, 0)
                CAD_Topo_FVert.fg = 0
                WhileLoop NotEqual(CAD_Topo_FVert.k, 0) {
                    IfCondition GreaterThan(CAD_Topo_FVert.fg, 4096) ThenBlock: { CAD_Topo_FVert.k = 0 }
                    IfCondition NotEqual(CAD_Topo_FVert.k, 0) ThenBlock: {
                        CAD_Topo_FVert.surf = CAD_Store.Read(CAD_Topo_FVert.k, 0)
                        CAD_Topo_FVert.ok = 0
                        IfCondition NotEqual(CAD_Topo_FVert.surf, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FVert.surf, 0), 2) ThenBlock: { CAD_Topo_FVert.ok = 1 }
                        }
                        IfCondition EqualTo(CAD_Topo_FVert.ok, 1) ThenBlock: {
                            CAD_Topo_FVert.lp = CAD_Store.Read(CAD_Topo_FVert.k, 1)
                            IfCondition NotEqual(CAD_Topo_FVert.lp, 0) ThenBlock: {
                                CAD_Topo_FVert.ce = CAD_Store.Read(CAD_Topo_FVert.lp, 0)
                                CAD_Topo_FVert.hd = CAD_Topo_FVert.ce
                                CAD_Topo_FVert.g = 0
                                WhileLoop LessThan(CAD_Topo_FVert.g, 8) {
                                    IfCondition EqualTo(CAD_Topo_FVert.ce, 0) ThenBlock: { CAD_Topo_FVert.g = 8 }
                                    IfCondition NotEqual(CAD_Topo_FVert.ce, 0) ThenBlock: {
                                        CAD_Topo_FVert.e = CAD_Store.Read(CAD_Topo_FVert.ce, 0)
                                        IfCondition NotEqual(CAD_Topo_FVert.e, 0) ThenBlock: {
                                            CAD_Topo_FVert.v0 = CAD_Store.Read(CAD_Topo_FVert.e, 0)
                                            CAD_Topo_FVert.v1 = CAD_Store.Read(CAD_Topo_FVert.e, 1)
                                            CAD_Topo_FVert.which = CAD_Store.Read(CAD_Topo_FVert.e, 2)
                                            CAD_Topo_FVert.aa = 0
                                            IfCondition NotEqual(CAD_Topo_FVert.which, 0) ThenBlock: {
                                                CAD_Topo_FVert.aa = CAD_Store.Read(CAD_Topo_FVert.which, 0)
                                            }
                                            IfCondition EqualTo(CAD_Topo_FVert.aa, 1) ThenBlock: {
                                                CAD_Topo_FVert.ta = CAD_Topo.FilletNearT(CAD_Topo_FVert.v0)
                                                CAD_Topo_FVert.tb = CAD_Topo.FilletNearT(CAD_Topo_FVert.v1)
                                                IfCondition NotEqual(CAD_Topo_FVert.ta, 0) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Topo_FVert.tb, 0) ThenBlock: {
                                                        CAD_Topo.EdgeRetargetVert(CAD_Topo_FVert.e, CAD_Topo_FVert.v0, CAD_Topo_FVert.ta)
                                                    }
                                                }
                                                IfCondition NotEqual(CAD_Topo_FVert.tb, 0) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Topo_FVert.ta, 0) ThenBlock: {
                                                        CAD_Topo.EdgeRetargetVert(CAD_Topo_FVert.e, CAD_Topo_FVert.v1, CAD_Topo_FVert.tb)
                                                    }
                                                }
                                            }
                                            IfCondition EqualTo(CAD_Topo_FVert.aa, 2) ThenBlock: {
                                                CAD_Topo_FVert.ta = CAD_Topo.FilletNearT(CAD_Topo_FVert.v0)
                                                CAD_Topo_FVert.tb = CAD_Topo.FilletNearT(CAD_Topo_FVert.v1)
                                                IfCondition NotEqual(CAD_Topo_FVert.ta, 0) ThenBlock: {
                                                    IfCondition NotEqual(CAD_Topo_FVert.tb, 0) ThenBlock: {
                                                        IfCondition NotEqual(CAD_Topo_FVert.ta, CAD_Topo_FVert.tb) ThenBlock: {
                                                            CAD_Topo_FVert.which = 0
                                                            IfCondition EqualTo(CAD_Topo_FVert.ta, CAD_Topo_FVert.t1) ThenBlock: {
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t2) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a12 }
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t3) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a31 }
                                                            }
                                                            IfCondition EqualTo(CAD_Topo_FVert.ta, CAD_Topo_FVert.t2) ThenBlock: {
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t1) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a12 }
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t3) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a23 }
                                                            }
                                                            IfCondition EqualTo(CAD_Topo_FVert.ta, CAD_Topo_FVert.t3) ThenBlock: {
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t1) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a31 }
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t2) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a23 }
                                                            }
                                                            IfCondition NotEqual(CAD_Topo_FVert.which, 0) ThenBlock: {
                                                                IfCondition NotEqual(CAD_Topo_FVert.which, CAD_Topo_FVert.e) ThenBlock: {
                                                                    CAD_Topo_FVert.bb = CAD_Topo.FilletNearT(CAD_Store.Read(CAD_Topo_FVert.ce, 5))
                                                                    IfCondition EqualTo(CAD_Topo_FVert.bb, 0) ThenBlock: { CAD_Topo_FVert.bb = CAD_Topo_FVert.ta }
                                                                    CAD_Topo.CoedgeSwapEdge(CAD_Topo_FVert.ce, CAD_Topo_FVert.which, CAD_Topo_FVert.bb)
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        CAD_Topo_FVert.ce = CAD_Store.Read(CAD_Topo_FVert.ce, 2)
                                        IfCondition EqualTo(CAD_Topo_FVert.ce, CAD_Topo_FVert.hd) ThenBlock: { CAD_Topo_FVert.g = 8 }
                                    }
                                    CAD_Topo_FVert.g = Add(CAD_Topo_FVert.g, 1)
                                }
                            }
                        }
                        CAD_Topo_FVert.k = CAD_Store.Read(CAD_Topo_FVert.k, 3)
                    }
                    CAD_Topo_FVert.fg = Add(CAD_Topo_FVert.fg, 1)
                }
                CAD_Topo_FVert.sh = CAD_Store.Read(CAD_Topo_FVert.sh, 2)
            }
            CAD_Topo_FVert.sg = Add(CAD_Topo_FVert.sg, 1)
        }
        PrintMessage("fillet VERTEX sphere ok\n")
        ReturnValue(CAD_Topo_FVert.solid)
    }
}

Function.CAD_Topo.FilletVerticesAfter {
    Input: solid_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.h = solid_handle
        CAD_Topo_FSeq.r = radius_r
        CAD_Topo_FVert.ii = 0
        CAD_Topo_FSeq.nh = 0
        WhileLoop LessThan(CAD_Topo_FVert.ii, CAD_Topo_FVert.n) {
            IfCondition GreaterThan(ArrayGet(CAD_Topo_FVert.cnt, CAD_Topo_FVert.ii), 1) ThenBlock: {
                CAD_Topo_FVert.px = ArrayGet(CAD_Topo_FVert.xyz, Multiply(CAD_Topo_FVert.ii, 3))
                CAD_Topo_FVert.py = ArrayGet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.ii, 3), 1))
                CAD_Topo_FVert.pz = ArrayGet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.ii, 3), 2))
                IfCondition NotEqual(CAD_Topo.FilletVertexSphere(CAD_Topo_FSeq.h, CAD_Topo_FSeq.r), 0) ThenBlock: {
                    CAD_Topo_FSeq.nh = Add(CAD_Topo_FSeq.nh, 1)
                }
            }
            CAD_Topo_FVert.ii = Add(CAD_Topo_FVert.ii, 1)
        }
        PrintMessage("fillet VERTEX done n=")
        PrintNumber(CAD_Topo_FSeq.nh)
        PrintMessage("\n")
        ReturnValue(CAD_Topo_FSeq.h)
    }
}

Function.CAD_Topo.FilletPlanePlaneEdge_UNUSED_START {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        shell0 = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(shell0, 0) ThenBlock: { ReturnValue(0) }

        faces = Allocate(32)
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(edge_handle, faces), 0) ThenBlock: {
            Deallocate(faces, 32)
            ReturnValue(0)
        }
        f1 = ArrayGet(faces, 0)
        f2 = ArrayGet(faces, 1)
        Deallocate(faces, 32)

        pl1 = Allocate(128)
        pl2 = Allocate(128)
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(f1, pl1), 0) ThenBlock: {
            Deallocate(pl1, 128)
            Deallocate(pl2, 128)
            ReturnValue(0)
        }
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(f2, pl2), 0) ThenBlock: {
            Deallocate(pl1, 128)
            Deallocate(pl2, 128)
            ReturnValue(0)
        }

        v0 = CAD_Store.Read(edge_handle, 0)
        v1 = CAD_Store.Read(edge_handle, 1)
        p0x = CAD_Store.Read(v0, 0)
        p0y = CAD_Store.Read(v0, 1)
        p0z = CAD_Store.Read(v0, 2)
        p1x = CAD_Store.Read(v1, 0)
        p1y = CAD_Store.Read(v1, 1)
        p1z = CAD_Store.Read(v1, 2)

        // outward unit normals from plane Z (indices 10-12)
        n1x = ArrayGet(pl1, 10)
        n1y = ArrayGet(pl1, 11)
        n1z = ArrayGet(pl1, 12)
        n2x = ArrayGet(pl2, 10)
        n2y = ArrayGet(pl2, 11)
        n2z = ArrayGet(pl2, 12)
        ln1 = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(n1x, n1x), Float_Mul(n1y, n1y)), Float_Mul(n1z, n1z)))
        ln2 = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(n2x, n2x), Float_Mul(n2y, n2y)), Float_Mul(n2z, n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(ln1, 0), 1) ThenBlock: {
            Deallocate(pl1, 128)
            Deallocate(pl2, 128)
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Num.IsZero(ln2, 0), 1) ThenBlock: {
            Deallocate(pl1, 128)
            Deallocate(pl2, 128)
            ReturnValue(0)
        }
        n1x = Float_Div(n1x, ln1)
        n1y = Float_Div(n1y, ln1)
        n1z = Float_Div(n1z, ln1)
        n2x = Float_Div(n2x, ln2)
        n2y = Float_Div(n2y, ln2)
        n2z = Float_Div(n2z, ln2)

        edx = Float_Sub(p1x, p0x)
        edy = Float_Sub(p1y, p0y)
        edz = Float_Sub(p1z, p0z)
        elen = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(edx, edx), Float_Mul(edy, edy)), Float_Mul(edz, edz)))
        IfCondition EqualTo(CAD_Num.IsZero(elen, 0), 1) ThenBlock: {
            Deallocate(pl1, 128)
            Deallocate(pl2, 128)
            ReturnValue(0)
        }
        edx = Float_Div(edx, elen)
        edy = Float_Div(edy, elen)
        edz = Float_Div(edz, elen)

        // flip edge dir to match N1×N2
        cxp = Float_Sub(Float_Mul(n1y, n2z), Float_Mul(n1z, n2y))
        cyp = Float_Sub(Float_Mul(n1z, n2x), Float_Mul(n1x, n2z))
        czp = Float_Sub(Float_Mul(n1x, n2y), Float_Mul(n1y, n2x))
        al = Float_Add(Float_Add(Float_Mul(edx, cxp), Float_Mul(edy, cyp)), Float_Mul(edz, czp))
        IfCondition EqualTo(Float_Le(al, 0), 1) ThenBlock: {
            // swap v0/v1 labeling for consistent A/B
            tmp = v0
            v0 = v1
            v1 = tmp
            tx = p0x
            ty = p0y
            tz = p0z
            p0x = p1x
            p0y = p1y
            p0z = p1z
            p1x = tx
            p1y = ty
            p1z = tz
            edx = Float_Sub(0, edx)
            edy = Float_Sub(0, edy)
            edz = Float_Sub(0, edz)
        }

        one = 0x3FF0000000000000
        cdot = Float_Add(Float_Add(Float_Mul(n1x, n2x), Float_Mul(n1y, n2y)), Float_Mul(n1z, n2z))
        den = Float_Add(one, cdot)
        IfCondition EqualTo(CAD_Num.IsZero(den, 0), 1) ThenBlock: {
            Deallocate(pl1, 128)
            Deallocate(pl2, 128)
            ReturnValue(0)
        }
        ab = Float_Div(radius_r, den)

        // spine centers at ends
        c0x = Float_Sub(Float_Sub(p0x, Float_Mul(ab, n1x)), Float_Mul(ab, n2x))
        c0y = Float_Sub(Float_Sub(p0y, Float_Mul(ab, n1y)), Float_Mul(ab, n2y))
        c0z = Float_Sub(Float_Sub(p0z, Float_Mul(ab, n1z)), Float_Mul(ab, n2z))
        c1x = Float_Sub(Float_Sub(p1x, Float_Mul(ab, n1x)), Float_Mul(ab, n2x))
        c1y = Float_Sub(Float_Sub(p1y, Float_Mul(ab, n1y)), Float_Mul(ab, n2y))
        c1z = Float_Sub(Float_Sub(p1z, Float_Mul(ab, n1z)), Float_Mul(ab, n2z))

        // contact on F1 (A*) and F2 (B*): C + R*N
        a0x = Float_Add(c0x, Float_Mul(radius_r, n1x))
        a0y = Float_Add(c0y, Float_Mul(radius_r, n1y))
        a0z = Float_Add(c0z, Float_Mul(radius_r, n1z))
        b0x = Float_Add(c0x, Float_Mul(radius_r, n2x))
        b0y = Float_Add(c0y, Float_Mul(radius_r, n2y))
        b0z = Float_Add(c0z, Float_Mul(radius_r, n2z))
        a1x = Float_Add(c1x, Float_Mul(radius_r, n1x))
        a1y = Float_Add(c1y, Float_Mul(radius_r, n1y))
        a1z = Float_Add(c1z, Float_Mul(radius_r, n1z))
        b1x = Float_Add(c1x, Float_Mul(radius_r, n2x))
        b1y = Float_Add(c1y, Float_Mul(radius_r, n2y))
        b1z = Float_Add(c1z, Float_Mul(radius_r, n2z))

        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        frame = Allocate(128)
        ring = Allocate(256)
        oldv = Allocate(4096)
        newv = Allocate(4096)
        nvmap = 0

        ArraySet(pt, 0, a0x)
        ArraySet(pt, 1, a0y)
        ArraySet(pt, 2, a0z)
        va0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, b0x)
        ArraySet(pt, 1, b0y)
        ArraySet(pt, 2, b0z)
        vb0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, a1x)
        ArraySet(pt, 1, a1y)
        ArraySet(pt, 2, a1z)
        va1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, b1x)
        ArraySet(pt, 1, b1y)
        ArraySet(pt, 2, b1z)
        vb1 = CAD_Topo.MakeVertex(pt)

        // clone all verts except endpoints of filleted edge
        face = CAD_Store.Read(shell0, 0)
        fguard = 0
        WhileLoop NotEqual(face, 0) {
            loop_h = CAD_Store.Read(face, 1)
            head = CAD_Store.Read(loop_h, 0)
            ce = head
            cguard = 0
            done = 0
            WhileLoop EqualTo(done, 0) {
                ov = CAD_Store.Read(ce, 5)
                IfCondition NotEqual(ov, v0) ThenBlock: {
                    IfCondition NotEqual(ov, v1) ThenBlock: {
                        found = 0
                        i = 0
                        WhileLoop LessThan(i, nvmap) {
                            IfCondition EqualTo(ArrayGet(oldv, i), ov) ThenBlock: { found = 1 }
                            i = Add(i, 1)
                        }
                        IfCondition EqualTo(found, 0) ThenBlock: {
                            ArraySet(pt, 0, CAD_Store.Read(ov, 0))
                            ArraySet(pt, 1, CAD_Store.Read(ov, 1))
                            ArraySet(pt, 2, CAD_Store.Read(ov, 2))
                            nv = CAD_Topo.MakeVertex(pt)
                            ArraySet(oldv, nvmap, ov)
                            ArraySet(newv, nvmap, nv)
                            nvmap = Add(nvmap, 1)
                        }
                    }
                }
                ce = CAD_Store.Read(ce, 2)
                cguard = Add(cguard, 1)
                IfCondition EqualTo(ce, head) ThenBlock: { done = 1 }
                IfCondition GreaterThan(cguard, 4096) ThenBlock: { done = 1 }
            }
            face = CAD_Store.Read(face, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 4096) ThenBlock: { face = 0 }
        }
        CAD_Topo_State.vmap_old = oldv
        CAD_Topo_State.vmap_new = newv
        CAD_Topo_State.vmap_n = nvmap

        // cylinder + end circles
        ArraySet(frame, 0, c0x)
        ArraySet(frame, 1, c0y)
        ArraySet(frame, 2, c0z)
        ArraySet(frame, 3, n1x)
        ArraySet(frame, 4, n1y)
        ArraySet(frame, 5, n1z)
        yx = Float_Sub(Float_Mul(edy, n1z), Float_Mul(edz, n1y))
        yy = Float_Sub(Float_Mul(edz, n1x), Float_Mul(edx, n1z))
        yz = Float_Sub(Float_Mul(edx, n1y), Float_Mul(edy, n1x))
        yl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(yx, yx), Float_Mul(yy, yy)), Float_Mul(yz, yz)))
        IfCondition EqualTo(CAD_Num.IsZero(yl, 0), 1) ThenBlock: {
            Deallocate(pl1, 128)
            Deallocate(pl2, 128)
            Deallocate(pt, 32)
            Deallocate(p1b, 32)
            Deallocate(ax, 32)
            Deallocate(ay, 32)
            Deallocate(frame, 128)
            Deallocate(ring, 256)
            Deallocate(oldv, 4096)
            Deallocate(newv, 4096)
            ReturnValue(0)
        }
        ArraySet(frame, 6, Float_Div(yx, yl))
        ArraySet(frame, 7, Float_Div(yy, yl))
        ArraySet(frame, 8, Float_Div(yz, yl))
        ArraySet(frame, 9, edx)
        ArraySet(frame, 10, edy)
        ArraySet(frame, 11, edz)
        cyl = CAD_Geom.MakeCylinderSurf(frame, radius_r)
        ArraySet(frame, 0, c0x)
        ArraySet(frame, 1, c0y)
        ArraySet(frame, 2, c0z)
        circ0 = CAD_Geom.MakeCircle(frame, radius_r)
        ArraySet(frame, 0, c1x)
        ArraySet(frame, 1, c1y)
        ArraySet(frame, 2, c1z)
        circ1 = CAD_Geom.MakeCircle(frame, radius_r)

        ArraySet(pt, 0, a0x)
        ArraySet(pt, 1, a0y)
        ArraySet(pt, 2, a0z)
        ArraySet(p1b, 0, a1x)
        ArraySet(p1b, 1, a1y)
        ArraySet(p1b, 2, a1z)
        e_ga = CAD_Topo.MakeEdge(va0, va1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, b0x)
        ArraySet(pt, 1, b0y)
        ArraySet(pt, 2, b0z)
        ArraySet(p1b, 0, b1x)
        ArraySet(p1b, 1, b1y)
        ArraySet(p1b, 2, b1z)
        e_gb = CAD_Topo.MakeEdge(vb0, vb1, CAD_Geom.MakeLine(pt, p1b))
        // minor arcs only — major-arc order folds fillet into solid
        e_arc0 = CAD_Topo.MakeMinorArcEdge(va0, vb0, circ0)
        e_arc1 = CAD_Topo.MakeMinorArcEdge(va1, vb1, circ1)

        cga_f1 = CAD_Topo.MakeCoedge(e_ga, va0, 1)
        cga_bl = CAD_Topo.MakeCoedge(e_ga, va1, 0)
        CAD_Topo.LinkTwins(cga_f1, cga_bl)
        CAD_Store.Write(e_ga, 3, cga_f1)
        CAD_Store.Write(e_ga, 4, cga_bl)
        cgb_f2 = CAD_Topo.MakeCoedge(e_gb, vb0, 1)
        cgb_bl = CAD_Topo.MakeCoedge(e_gb, vb1, 0)
        CAD_Topo.LinkTwins(cgb_f2, cgb_bl)
        CAD_Store.Write(e_gb, 3, cgb_f2)
        CAD_Store.Write(e_gb, 4, cgb_bl)
        // blend face uses ga up, arc1, gb down, arc0 rev
        carc0_end = CAD_Topo.MakeCoedge(e_arc0, va0, 1)
        carc0_bl = CAD_Topo.MakeCoedge(e_arc0, vb0, 0)
        CAD_Topo.LinkTwins(carc0_end, carc0_bl)
        CAD_Store.Write(e_arc0, 3, carc0_end)
        CAD_Store.Write(e_arc0, 4, carc0_bl)
        carc1_end = CAD_Topo.MakeCoedge(e_arc1, va1, 1)
        carc1_bl = CAD_Topo.MakeCoedge(e_arc1, vb1, 0)
        CAD_Topo.LinkTwins(carc1_end, carc1_bl)
        CAD_Store.Write(e_arc1, 3, carc1_end)
        CAD_Store.Write(e_arc1, 4, carc1_bl)

        // cylinder loop: A-gen, arc1 A→B, B-gen reverse, arc0 B→A
        ArraySet(ring, 0, cga_bl)
        // cga_bl is sense0 origin va1: va1→va0 — wrong direction for blend
        // Want va0→va1, va1→vb1, vb1→vb0, vb0→va0
        ArraySet(ring, 0, cga_f1)
        ArraySet(ring, 1, carc1_end)
        ArraySet(ring, 2, cgb_bl)
        ArraySet(ring, 3, carc0_bl)
        lp_bl = CAD_Topo.MakeLoop(cga_f1)
        CAD_Topo.LinkLoopRing(ring, 4, lp_bl)
        f_blend = CAD_Topo.MakeFace(cyl, lp_bl)

        // edge registry
        reg_a = Allocate(4096)
        reg_b = Allocate(4096)
        reg_e = Allocate(4096)
        nreg = 0
        ArraySet(reg_a, 0, va0)
        ArraySet(reg_b, 0, va1)
        ArraySet(reg_e, 0, e_ga)
        ArraySet(reg_a, 1, vb0)
        ArraySet(reg_b, 1, vb1)
        ArraySet(reg_e, 1, e_gb)
        ArraySet(reg_a, 2, va0)
        ArraySet(reg_b, 2, vb0)
        ArraySet(reg_e, 2, e_arc0)
        ArraySet(reg_a, 3, va1)
        ArraySet(reg_b, 3, vb1)
        ArraySet(reg_e, 3, e_arc1)
        nreg = 4

        first_f = f_blend
        prev_f = f_blend

        face = CAD_Store.Read(shell0, 0)
        fguard = 0
        WhileLoop NotEqual(face, 0) {
            CAD_Topo_State.walk_face = face
            loop_h = CAD_Store.Read(face, 1)
            head = CAD_Store.Read(loop_h, 0)
            ovlist = Allocate(16384)
            oelist = Allocate(16384)
            nvo = 0
            ce = head
            cguard = 0
            done = 0
            WhileLoop EqualTo(done, 0) {
                IfCondition LessThan(nvo, 2048) ThenBlock: {
                    ArraySet(ovlist, nvo, CAD_Store.Read(ce, 5))
                    ArraySet(oelist, nvo, CAD_Store.Read(ce, 0))
                    nvo = Add(nvo, 1)
                }
                ce = CAD_Store.Read(ce, 2)
                cguard = Add(cguard, 1)
                IfCondition EqualTo(ce, head) ThenBlock: { done = 1 }
                IfCondition GreaterThan(cguard, 4096) ThenBlock: { done = 1 }
            }
            CAD_Topo_State.walk_lp = oelist
            CAD_Topo_State.walk_v0 = nvo

            // classify face role
            is_f1 = 0
            is_f2 = 0
            IfCondition EqualTo(face, f1) ThenBlock: { is_f1 = 1 }
            IfCondition EqualTo(face, f2) ThenBlock: { is_f2 = 1 }
            has_v0 = 0
            has_v1 = 0
            i = 0
            WhileLoop LessThan(i, nvo) {
                IfCondition EqualTo(ArrayGet(ovlist, i), v0) ThenBlock: { has_v0 = 1 }
                IfCondition EqualTo(ArrayGet(ovlist, i), v1) ThenBlock: { has_v1 = 1 }
                i = Add(i, 1)
            }
            // end face: has endpoint but is not a support face
            is_end0 = 0
            is_end1 = 0
            IfCondition EqualTo(has_v0, 1) ThenBlock: {
                IfCondition EqualTo(is_f1, 0) ThenBlock: {
                    IfCondition EqualTo(is_f2, 0) ThenBlock: { is_end0 = 1 }
                }
            }
            IfCondition EqualTo(has_v1, 1) ThenBlock: {
                IfCondition EqualTo(is_f1, 0) ThenBlock: {
                    IfCondition EqualTo(is_f2, 0) ThenBlock: { is_end1 = 1 }
                }
            }

            nlist = Allocate(16384)
            nn = 0
            i = 0
            WhileLoop LessThan(i, nvo) {
                ov = ArrayGet(ovlist, i)
                jn = Add(i, 1)
                IfCondition EqualTo(jn, nvo) ThenBlock: { jn = 0 }
                nxt = ArrayGet(ovlist, jn)

                // support face: replace filleted edge with generator
                did = 0
                IfCondition EqualTo(is_f1, 1) ThenBlock: {
                    IfCondition EqualTo(ov, v0) ThenBlock: {
                        IfCondition EqualTo(nxt, v1) ThenBlock: {
                            ArraySet(nlist, nn, va0)
                            nn = Add(nn, 1)
                            ArraySet(nlist, nn, va1)
                            nn = Add(nn, 1)
                            did = 1
                        }
                    }
                    IfCondition EqualTo(ov, v1) ThenBlock: {
                        IfCondition EqualTo(nxt, v0) ThenBlock: {
                            ArraySet(nlist, nn, va1)
                            nn = Add(nn, 1)
                            ArraySet(nlist, nn, va0)
                            nn = Add(nn, 1)
                            did = 1
                        }
                    }
                }
                IfCondition EqualTo(is_f2, 1) ThenBlock: {
                    IfCondition EqualTo(ov, v0) ThenBlock: {
                        IfCondition EqualTo(nxt, v1) ThenBlock: {
                            ArraySet(nlist, nn, vb0)
                            nn = Add(nn, 1)
                            ArraySet(nlist, nn, vb1)
                            nn = Add(nn, 1)
                            did = 1
                        }
                    }
                    IfCondition EqualTo(ov, v1) ThenBlock: {
                        IfCondition EqualTo(nxt, v0) ThenBlock: {
                            ArraySet(nlist, nn, vb1)
                            nn = Add(nn, 1)
                            ArraySet(nlist, nn, vb0)
                            nn = Add(nn, 1)
                            did = 1
                        }
                    }
                }

                IfCondition EqualTo(did, 0) ThenBlock: {
                    // end face: replace corner vertex with arc endpoints
                    IfCondition EqualTo(is_end0, 1) ThenBlock: {
                        IfCondition EqualTo(ov, v0) ThenBlock: {
                            // previous vertex in loop (who we arrived from)
                            ip = Subtract(i, 1)
                            IfCondition LessThan(ip, 0) ThenBlock: { ip = Subtract(nvo, 1) }
                            prev = ArrayGet(ovlist, ip)
                            px = CAD_Store.Read(prev, 0)
                            py = CAD_Store.Read(prev, 1)
                            pz = CAD_Store.Read(prev, 2)
                            // on F1 if |N1·(P-O1)| small — O1 from pl1
                            o1x = ArrayGet(pl1, 1)
                            o1y = ArrayGet(pl1, 2)
                            o1z = ArrayGet(pl1, 3)
                            d1 = Float_Add(Float_Add(Float_Mul(n1x, Float_Sub(px, o1x)), Float_Mul(n1y, Float_Sub(py, o1y))), Float_Mul(n1z, Float_Sub(pz, o1z)))
                            IfCondition EqualTo(Float_Le(d1, 0), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
                            // if prev on F1, leave along F1 so A first; else B first
                            IfCondition EqualTo(Float_Le(d1, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                                ArraySet(nlist, nn, va0)
                                nn = Add(nn, 1)
                                ArraySet(nlist, nn, vb0)
                                nn = Add(nn, 1)
                            }
                            IfCondition EqualTo(Float_Le(d1, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                                ArraySet(nlist, nn, vb0)
                                nn = Add(nn, 1)
                                ArraySet(nlist, nn, va0)
                                nn = Add(nn, 1)
                            }
                            did = 1
                        }
                    }
                    IfCondition EqualTo(is_end1, 1) ThenBlock: {
                        IfCondition EqualTo(ov, v1) ThenBlock: {
                            ip = Subtract(i, 1)
                            IfCondition LessThan(ip, 0) ThenBlock: { ip = Subtract(nvo, 1) }
                            prev = ArrayGet(ovlist, ip)
                            px = CAD_Store.Read(prev, 0)
                            py = CAD_Store.Read(prev, 1)
                            pz = CAD_Store.Read(prev, 2)
                            o1x = ArrayGet(pl1, 1)
                            o1y = ArrayGet(pl1, 2)
                            o1z = ArrayGet(pl1, 3)
                            d1 = Float_Add(Float_Add(Float_Mul(n1x, Float_Sub(px, o1x)), Float_Mul(n1y, Float_Sub(py, o1y))), Float_Mul(n1z, Float_Sub(pz, o1z)))
                            IfCondition EqualTo(Float_Le(d1, 0), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
                            IfCondition EqualTo(Float_Le(d1, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                                ArraySet(nlist, nn, va1)
                                nn = Add(nn, 1)
                                ArraySet(nlist, nn, vb1)
                                nn = Add(nn, 1)
                            }
                            IfCondition EqualTo(Float_Le(d1, 0x3F50624DD2F1A9FC), 0) ThenBlock: {
                                ArraySet(nlist, nn, vb1)
                                nn = Add(nn, 1)
                                ArraySet(nlist, nn, va1)
                                nn = Add(nn, 1)
                            }
                            did = 1
                        }
                    }
                }

                IfCondition EqualTo(did, 0) ThenBlock: {
                    // skip old endpoints entirely (already handled on supports/ends)
                    IfCondition NotEqual(ov, v0) ThenBlock: {
                        IfCondition NotEqual(ov, v1) ThenBlock: {
                            nv = 0
                            k = 0
                            WhileLoop LessThan(k, nvmap) {
                                IfCondition EqualTo(ArrayGet(oldv, k), ov) ThenBlock: {
                                    nv = ArrayGet(newv, k)
                                }
                                k = Add(k, 1)
                            }
                            IfCondition NotEqual(nv, 0) ThenBlock: {
                                ArraySet(nlist, nn, nv)
                                nn = Add(nn, 1)
                            }
                        }
                    }
                }
                i = Add(i, 1)
            }
            Deallocate(ovlist, 16384)

            // build face from nlist if enough verts
            IfCondition GreaterThan(nn, 2) ThenBlock: {
                old_s0 = CAD_Store.Read(face, 0)
                sk0 = 0
                IfCondition NotEqual(old_s0, 0) ThenBlock: {
                    sk0 = CAD_Store.Read(old_s0, 0)
                }
                carr = Allocate(16384)
                i = 0
                WhileLoop LessThan(i, nn) {
                    jn = Add(i, 1)
                    IfCondition EqualTo(jn, nn) ThenBlock: { jn = 0 }
                    ua = ArrayGet(nlist, i)
                    ub = ArrayGet(nlist, jn)
                    ArraySet(pt, 0, CAD_Store.Read(ua, 0))
                    ArraySet(pt, 1, CAD_Store.Read(ua, 1))
                    ArraySet(pt, 2, CAD_Store.Read(ua, 2))
                    ArraySet(p1b, 0, CAD_Store.Read(ub, 0))
                    ArraySet(p1b, 1, CAD_Store.Read(ub, 1))
                    ArraySet(p1b, 2, CAD_Store.Read(ub, 2))
                    ee = 0
                    ri = 0
                    WhileLoop LessThan(ri, nreg) {
                        ra = ArrayGet(reg_a, ri)
                        rb = ArrayGet(reg_b, ri)
                        IfCondition EqualTo(ra, ua) ThenBlock: {
                            IfCondition EqualTo(rb, ub) ThenBlock: {
                                ee = ArrayGet(reg_e, ri)
                            }
                        }
                        IfCondition EqualTo(ra, ub) ThenBlock: {
                            IfCondition EqualTo(rb, ua) ThenBlock: {
                                ee = ArrayGet(reg_e, ri)
                            }
                        }
                        ri = Add(ri, 1)
                    }
                    IfCondition EqualTo(ee, 0) ThenBlock: {
                        // Keep original curve (cove ellipse/circle) when both
                        // mapped endpoints match an old edge. MakeLine here is
                        // what turned a finished cove into a chamfer.
                        oi = 0
                        nvo = CAD_Topo_State.walk_v0
                        oelist = CAD_Topo_State.walk_lp
                        nvmap = CAD_Topo_State.vmap_n
                        oldv = CAD_Topo_State.vmap_old
                        newv = CAD_Topo_State.vmap_new
                        WhileLoop LessThan(oi, nvo) {
                            oed = ArrayGet(oelist, oi)
                            IfCondition NotEqual(oed, 0) ThenBlock: {
                                oa = CAD_Store.Read(oed, 0)
                                ob = CAD_Store.Read(oed, 1)
                                na = 0
                                nb = 0
                                k = 0
                                WhileLoop LessThan(k, nvmap) {
                                    IfCondition EqualTo(ArrayGet(oldv, k), oa) ThenBlock: { na = ArrayGet(newv, k) }
                                    IfCondition EqualTo(ArrayGet(oldv, k), ob) ThenBlock: { nb = ArrayGet(newv, k) }
                                    k = Add(k, 1)
                                }
                                hitc = 0
                                IfCondition EqualTo(na, ua) ThenBlock: {
                                    IfCondition EqualTo(nb, ub) ThenBlock: { hitc = 1 }
                                }
                                IfCondition EqualTo(na, ub) ThenBlock: {
                                    IfCondition EqualTo(nb, ua) ThenBlock: { hitc = 1 }
                                }
                                IfCondition EqualTo(hitc, 1) ThenBlock: {
                                    crv0 = CAD_Store.Read(oed, 2)
                                    IfCondition NotEqual(crv0, 0) ThenBlock: {
                                        ee = CAD_Topo.MakeEdge(ua, ub, crv0)
                                        oi = nvo
                                    }
                                }
                            }
                            oi = Add(oi, 1)
                        }
                    }
                    IfCondition EqualTo(ee, 0) ThenBlock: {
                        // prior cylinder face: end arcs are circles about cyl axis
                        IfCondition EqualTo(sk0, 2) ThenBlock: {
                            czx = CAD_Store.Read(old_s0, 10)
                            czy = CAD_Store.Read(old_s0, 11)
                            czz = CAD_Store.Read(old_s0, 12)
                            cox = CAD_Store.Read(old_s0, 1)
                            coy = CAD_Store.Read(old_s0, 2)
                            coz = CAD_Store.Read(old_s0, 3)
                            cr = CAD_Store.Read(old_s0, 13)
                            // chord · axis ≈ 0 → arc in plane ⊥ axis
                            cdx = Float_Sub(ArrayGet(p1b, 0), ArrayGet(pt, 0))
                            cdy = Float_Sub(ArrayGet(p1b, 1), ArrayGet(pt, 1))
                            cdz = Float_Sub(ArrayGet(p1b, 2), ArrayGet(pt, 2))
                            cdotz = Float_Add(Float_Add(Float_Mul(cdx, czx), Float_Mul(cdy, czy)), Float_Mul(cdz, czz))
                            IfCondition EqualTo(Float_Le(cdotz, 0), 1) ThenBlock: { cdotz = Float_Sub(0, cdotz) }
                            IfCondition EqualTo(Float_Le(cdotz, 0x3F50624DD2F1A9FC), 1) ThenBlock: {
                                // circle center = project ua onto axis... use mid along axis from O
                                // frame at point on axis through ua
                                tpar = Float_Add(Float_Add(Float_Mul(Float_Sub(ArrayGet(pt, 0), cox), czx), Float_Mul(Float_Sub(ArrayGet(pt, 1), coy), czy)), Float_Mul(Float_Sub(ArrayGet(pt, 2), coz), czz))
                                ArraySet(frame, 0, Float_Add(cox, Float_Mul(tpar, czx)))
                                ArraySet(frame, 1, Float_Add(coy, Float_Mul(tpar, czy)))
                                ArraySet(frame, 2, Float_Add(coz, Float_Mul(tpar, czz)))
                                ArraySet(frame, 3, CAD_Store.Read(old_s0, 4))
                                ArraySet(frame, 4, CAD_Store.Read(old_s0, 5))
                                ArraySet(frame, 5, CAD_Store.Read(old_s0, 6))
                                ArraySet(frame, 6, CAD_Store.Read(old_s0, 7))
                                ArraySet(frame, 7, CAD_Store.Read(old_s0, 8))
                                ArraySet(frame, 8, CAD_Store.Read(old_s0, 9))
                                circ = CAD_Geom.MakeCircle(frame, cr)
                                ee = CAD_Topo.MakeMinorArcEdge(ua, ub, circ)
                            }
                        }
                        IfCondition EqualTo(ee, 0) ThenBlock: {
                            ee = CAD_Topo.MakeEdge(ua, ub, CAD_Geom.MakeLine(pt, p1b))
                        }
                        ArraySet(reg_a, nreg, ua)
                        ArraySet(reg_b, nreg, ub)
                        ArraySet(reg_e, nreg, ee)
                        nreg = Add(nreg, 1)
                    }
                    sense = 1
                    IfCondition NotEqual(CAD_Store.Read(ee, 0), ua) ThenBlock: { sense = 0 }
                    cee = CAD_Topo.MakeCoedge(ee, ua, sense)
                    ArraySet(carr, i, cee)
                    ca = CAD_Store.Read(ee, 3)
                    cb = CAD_Store.Read(ee, 4)
                    IfCondition EqualTo(ca, 0) ThenBlock: {
                        CAD_Store.Write(ee, 3, cee)
                    }
                    IfCondition NotEqual(ca, 0) ThenBlock: {
                        IfCondition EqualTo(cb, 0) ThenBlock: {
                            CAD_Store.Write(ee, 4, cee)
                            CAD_Topo.LinkTwins(ca, cee)
                        }
                    }
                    i = Add(i, 1)
                }
                lp = CAD_Topo.MakeLoop(ArrayGet(carr, 0))
                CAD_Topo.LinkLoopRing(carr, nn, lp)
                i = 0
                WhileLoop LessThan(i, nn) {
                    CAD_Store.Write(ArrayGet(carr, i), 4, lp)
                    i = Add(i, 1)
                }
                // surface: plane copy, or keep cylinder/sphere from original face
                surf = 0
                old_s = CAD_Store.Read(face, 0)
                sk = 0
                IfCondition NotEqual(old_s, 0) ThenBlock: {
                    sk = CAD_Store.Read(old_s, 0)
                }
                IfCondition EqualTo(sk, 1) ThenBlock: {
                    pl = Allocate(128)
                    CAD_Topo.FaceGetPlane(face, pl)
                    ArraySet(pt, 0, ArrayGet(pl, 1))
                    ArraySet(pt, 1, ArrayGet(pl, 2))
                    ArraySet(pt, 2, ArrayGet(pl, 3))
                    ArraySet(ax, 0, ArrayGet(pl, 4))
                    ArraySet(ax, 1, ArrayGet(pl, 5))
                    ArraySet(ax, 2, ArrayGet(pl, 6))
                    ArraySet(ay, 0, ArrayGet(pl, 7))
                    ArraySet(ay, 1, ArrayGet(pl, 8))
                    ArraySet(ay, 2, ArrayGet(pl, 9))
                    surf = CAD_Geom.MakePlaneAxes(pt, ax, ay)
                    Deallocate(pl, 128)
                }
                IfCondition EqualTo(sk, 2) ThenBlock: {
                    // copy cylinder frame + R
                    ArraySet(frame, 0, CAD_Store.Read(old_s, 1))
                    ArraySet(frame, 1, CAD_Store.Read(old_s, 2))
                    ArraySet(frame, 2, CAD_Store.Read(old_s, 3))
                    ArraySet(frame, 3, CAD_Store.Read(old_s, 4))
                    ArraySet(frame, 4, CAD_Store.Read(old_s, 5))
                    ArraySet(frame, 5, CAD_Store.Read(old_s, 6))
                    ArraySet(frame, 6, CAD_Store.Read(old_s, 7))
                    ArraySet(frame, 7, CAD_Store.Read(old_s, 8))
                    ArraySet(frame, 8, CAD_Store.Read(old_s, 9))
                    ArraySet(frame, 9, CAD_Store.Read(old_s, 10))
                    ArraySet(frame, 10, CAD_Store.Read(old_s, 11))
                    ArraySet(frame, 11, CAD_Store.Read(old_s, 12))
                    surf = CAD_Geom.MakeCylinderSurf(frame, CAD_Store.Read(old_s, 13))
                }
                IfCondition EqualTo(sk, 3) ThenBlock: {
                    ArraySet(pt, 0, CAD_Store.Read(old_s, 1))
                    ArraySet(pt, 1, CAD_Store.Read(old_s, 2))
                    ArraySet(pt, 2, CAD_Store.Read(old_s, 3))
                    surf = CAD_Geom.MakeSphereSurf(pt, CAD_Store.Read(old_s, 4))
                }
                IfCondition EqualTo(surf, 0) ThenBlock: {
                    // fallback plane from 3 verts
                    ArraySet(pt, 0, CAD_Store.Read(ArrayGet(nlist, 0), 0))
                    ArraySet(pt, 1, CAD_Store.Read(ArrayGet(nlist, 0), 1))
                    ArraySet(pt, 2, CAD_Store.Read(ArrayGet(nlist, 0), 2))
                    ArraySet(ax, 0, Float_Sub(CAD_Store.Read(ArrayGet(nlist, 1), 0), ArrayGet(pt, 0)))
                    ArraySet(ax, 1, Float_Sub(CAD_Store.Read(ArrayGet(nlist, 1), 1), ArrayGet(pt, 1)))
                    ArraySet(ax, 2, Float_Sub(CAD_Store.Read(ArrayGet(nlist, 1), 2), ArrayGet(pt, 2)))
                    ArraySet(ay, 0, Float_Sub(CAD_Store.Read(ArrayGet(nlist, 2), 0), ArrayGet(pt, 0)))
                    ArraySet(ay, 1, Float_Sub(CAD_Store.Read(ArrayGet(nlist, 2), 1), ArrayGet(pt, 1)))
                    ArraySet(ay, 2, Float_Sub(CAD_Store.Read(ArrayGet(nlist, 2), 2), ArrayGet(pt, 2)))
                    surf = CAD_Geom.MakePlaneAxes(pt, ax, ay)
                }
                ff = CAD_Topo.MakeFace(surf, lp)
                CAD_Store.Write(prev_f, 3, ff)
                prev_f = ff
                CAD_Topo.FaceCopyInners(CAD_Topo_State.walk_face, ff)
                Deallocate(carr, 16384)
            }
            IfCondition NotEqual(CAD_Topo_State.walk_lp, 0) ThenBlock: {
                Deallocate(CAD_Topo_State.walk_lp, 16384)
                CAD_Topo_State.walk_lp = 0
            }
            Deallocate(nlist, 16384)
            face = CAD_Store.Read(CAD_Topo_State.walk_face, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 4096) ThenBlock: { face = 0 }
        }
        CAD_Store.Write(prev_f, 3, 0)

        h_sh = CAD_Topo.MakeShell(first_f)
        ff = first_f
        fguard = 0
        WhileLoop NotEqual(ff, 0) {
            CAD_Store.Write(ff, 2, h_sh)
            ff = CAD_Store.Read(ff, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 256) ThenBlock: { ff = 0 }
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)

        Deallocate(reg_a, 4096)
        Deallocate(reg_b, 4096)
        Deallocate(reg_e, 4096)
        Deallocate(pl1, 128)
        Deallocate(pl2, 128)
        Deallocate(oldv, 4096)
        Deallocate(newv, 4096)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(frame, 128)
        Deallocate(ring, 256)
        ReturnValue(h_so)
    }
}


// Rebuild all plane surfaces on a kind-0 solid from face loop verts (after vertex edits).
// Uses first three coedge origins: O, ax=P1-P0, ay=P2-P0 (orthogonalized). Returns 0 ok.
