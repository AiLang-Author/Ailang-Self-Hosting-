LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.MakeMinorArcEdge {
    Input: v0_h: Integer
    Input: v1_h: Integer
    Input: circ_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(v0_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(circ_h, 0) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(circ_h, 1)
        cy = CAD_Store.Read(circ_h, 2)
        cz = CAD_Store.Read(circ_h, 3)
        xx = CAD_Store.Read(circ_h, 4)
        xy = CAD_Store.Read(circ_h, 5)
        xz = CAD_Store.Read(circ_h, 6)
        yx = CAD_Store.Read(circ_h, 7)
        yy = CAD_Store.Read(circ_h, 8)
        yz = CAD_Store.Read(circ_h, 9)
        // unit coords in circle plane: u=(P-C)·X, v=(P-C)·Y
        p0x = Float_Sub(CAD_Store.Read(v0_h, 0), cx)
        p0y = Float_Sub(CAD_Store.Read(v0_h, 1), cy)
        p0z = Float_Sub(CAD_Store.Read(v0_h, 2), cz)
        p1x = Float_Sub(CAD_Store.Read(v1_h, 0), cx)
        p1y = Float_Sub(CAD_Store.Read(v1_h, 1), cy)
        p1z = Float_Sub(CAD_Store.Read(v1_h, 2), cz)
        u0 = Float_Add(Float_Add(Float_Mul(p0x, xx), Float_Mul(p0y, xy)), Float_Mul(p0z, xz))
        v0 = Float_Add(Float_Add(Float_Mul(p0x, yx), Float_Mul(p0y, yy)), Float_Mul(p0z, yz))
        u1 = Float_Add(Float_Add(Float_Mul(p1x, xx), Float_Mul(p1y, xy)), Float_Mul(p1z, xz))
        v1 = Float_Add(Float_Add(Float_Mul(p1x, yx), Float_Mul(p1y, yy)), Float_Mul(p1z, yz))
        // Minor arc only. A 270° end-cap was tessellated as a sheet that
        // ran past the edge (16-35/16-36). Clone the circle and store the
        // signed span in (-π, π] so SampleCircleEdge cannot walk the long way.
        a0 = CAD_Geom.Atan2(v0, u0)
        a1 = CAD_Geom.Atan2(v1, u1)
        two_pi = 0x401921FB54442D18
        pi = 0x400921FB54442D18
        span = Float_Sub(a1, a0)
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(span, Float_Sub(0, pi))), 1) ThenBlock: {
            span = Float_Add(span, two_pi)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, span)), 1) ThenBlock: {
            span = Float_Sub(span, two_pi)
        }
        aa = v0_h
        bb = v1_h
        IfCondition EqualTo(CAD_Num.IsNeg(span), 1) ThenBlock: {
            aa = v1_h
            bb = v0_h
            span = Float_Sub(0, span)
        }
        ch = CAD_Store.Alloc(16, 14)
        IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(CAD_Topo.MakeEdge(aa, bb, circ_h)) }
        si = 0
        WhileLoop LessThan(si, 14) {
            CAD_Store.Write(ch, si, CAD_Store.Read(circ_h, si))
            si = Add(si, 1)
        }
        CAD_Store.Write(ch, 12, span)
        ReturnValue(CAD_Topo.MakeEdge(aa, bb, ch))
    }
}

// 1 if vert sits on a class-3 collar (planar nce=3 with a CIRCLE coedge).
Function.CAD_Topo.FilletVertOnCollar {
    Input: vert_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.solid, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.shell = CAD_Store.Read(CAD_Topo_FLoc.solid, 0)
        CAD_Topo_FLoc.ei = 0
        WhileLoop NotEqual(CAD_Topo_FLoc.shell, 0) {
            IfCondition GreaterThan(CAD_Topo_FLoc.ei, 64) ThenBlock: { CAD_Topo_FLoc.shell = 0 }
            IfCondition NotEqual(CAD_Topo_FLoc.shell, 0) ThenBlock: {
                CAD_Topo_FLoc.endf = CAD_Store.Read(CAD_Topo_FLoc.shell, 0)
                CAD_Topo_FLoc.ln = 0
                WhileLoop NotEqual(CAD_Topo_FLoc.endf, 0) {
                    IfCondition GreaterThan(CAD_Topo_FLoc.ln, 4096) ThenBlock: { CAD_Topo_FLoc.endf = 0 }
                    IfCondition NotEqual(CAD_Topo_FLoc.endf, 0) ThenBlock: {
                        CAD_Topo_FLoc.lp = CAD_Store.Read(CAD_Topo_FLoc.endf, 1)
                        CAD_Topo_FLoc.hd = 0
                        IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                            CAD_Topo_FLoc.hd = CAD_Topo.LoopCountCoedges(CAD_Topo_FLoc.lp)
                        }
                        IfCondition EqualTo(CAD_Topo_FLoc.hd, 3) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_FLoc.endf, CAD_Topo_FLoc.pl1), 0) ThenBlock: {
                                CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.lp, 0)
                                CAD_Topo_FLoc.which = 0
                                CAD_Topo_FLoc.sn = 0
                                CAD_Topo_FLoc.aa = 0
                                WhileLoop LessThan(CAD_Topo_FLoc.aa, 4) {
                                    IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.ce, 5), vert_h) ThenBlock: { CAD_Topo_FLoc.which = 1 }
                                        CAD_Topo_FLoc.bb = CAD_Store.Read(CAD_Topo_FLoc.ce, 0)
                                        IfCondition NotEqual(CAD_Topo_FLoc.bb, 0) ThenBlock: {
                                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.bb, 0), vert_h) ThenBlock: { CAD_Topo_FLoc.which = 1 }
                                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.bb, 1), vert_h) ThenBlock: { CAD_Topo_FLoc.which = 1 }
                                            CAD_Topo_FLoc.cyl = CAD_Store.Read(CAD_Topo_FLoc.bb, 2)
                                            IfCondition NotEqual(CAD_Topo_FLoc.cyl, 0) ThenBlock: {
                                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.cyl, 0), 2) ThenBlock: {
                                                    // Collar mer is minor (|span|≤π). A 270° host
                                                    // rim is not a previous-fillet collar.
                                                    CAD_Topo_FLoc.ln = CAD_Store.Read(CAD_Topo_FLoc.cyl, 12)
                                                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FLoc.ln), 1) ThenBlock: {
                                                        CAD_Topo_FLoc.ln = Float_Sub(0, CAD_Topo_FLoc.ln)
                                                    }
                                                    IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 0) ThenBlock: {
                                                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(0x400921FB54442D18, CAD_Topo_FLoc.ln)), 0) ThenBlock: {
                                                            CAD_Topo_FLoc.sn = 1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.ce, 2)
                                    }
                                    CAD_Topo_FLoc.aa = Add(CAD_Topo_FLoc.aa, 1)
                                }
                                IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
                                    IfCondition EqualTo(CAD_Topo_FLoc.sn, 1) ThenBlock: { ReturnValue(1) }
                                }
                            }
                        }
                        CAD_Topo_FLoc.endf = CAD_Store.Read(CAD_Topo_FLoc.endf, 3)
                    }
                    CAD_Topo_FLoc.ln = Add(CAD_Topo_FLoc.ln, 1)
                }
                CAD_Topo_FLoc.shell = CAD_Store.Read(CAD_Topo_FLoc.shell, 2)
            }
            CAD_Topo_FLoc.ei = Add(CAD_Topo_FLoc.ei, 1)
        }
        ReturnValue(0)
    }
}

// In-place fillet of ONE plane–plane edge. Adds a blend face and trims
// only the two support faces + the two end faces. Existing coves stay.
Function.CAD_Topo.FilletEdgeLocal {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.solid = solid_handle
        CAD_Topo_FLoc.edge = edge_handle
        CAD_Topo_FLoc.r = radius_r
        CAD_Topo_FLoc.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FLoc.shell, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.faces, 0) ThenBlock: { CAD_Topo_FLoc.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FLoc.pl1, 0) ThenBlock: { CAD_Topo_FLoc.pl1 = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FLoc.pl2, 0) ThenBlock: { CAD_Topo_FLoc.pl2 = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: { CAD_Topo_FLoc.pt = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FLoc.p1b, 0) ThenBlock: { CAD_Topo_FLoc.p1b = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FLoc.frame, 0) ThenBlock: { CAD_Topo_FLoc.frame = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FLoc.ring, 0) ThenBlock: { CAD_Topo_FLoc.ring = Allocate(64) }
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FLoc.edge, CAD_Topo_FLoc.faces), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.f1 = ArrayGet(CAD_Topo_FLoc.faces, 0)
        CAD_Topo_FLoc.f2 = ArrayGet(CAD_Topo_FLoc.faces, 1)
        CAD_Topo_FLoc.v0 = CAD_Store.Read(CAD_Topo_FLoc.edge, 0)
        CAD_Topo_FLoc.v1 = CAD_Store.Read(CAD_Topo_FLoc.edge, 1)
        IfCondition EqualTo(CAD_Topo_FLoc.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.v1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.px = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 0), CAD_Store.Read(CAD_Topo_FLoc.v1, 0)), 0x3FE0000000000000)
        CAD_Topo_FComp.py = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 1), CAD_Store.Read(CAD_Topo_FLoc.v1, 1)), 0x3FE0000000000000)
        CAD_Topo_FComp.pz = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 2), CAD_Store.Read(CAD_Topo_FLoc.v1, 2)), 0x3FE0000000000000)
        CAD_Topo_FComp.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        CAD_Topo_FComp.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        CAD_Topo_FComp.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
        IfCondition EqualTo(CAD_Topo.FilletFaceN(CAD_Topo_FLoc.f1), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FLoc.pl1, 10, CAD_Topo_FComp.n2x)
        ArraySet(CAD_Topo_FLoc.pl1, 11, CAD_Topo_FComp.n2y)
        ArraySet(CAD_Topo_FLoc.pl1, 12, CAD_Topo_FComp.n2z)
        IfCondition EqualTo(CAD_Topo.FilletFaceN(CAD_Topo_FLoc.f2), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FLoc.pl2, 10, CAD_Topo_FComp.n2x)
        ArraySet(CAD_Topo_FLoc.pl2, 11, CAD_Topo_FComp.n2y)
        ArraySet(CAD_Topo_FLoc.pl2, 12, CAD_Topo_FComp.n2z)
        IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(CAD_Topo_FLoc.edge), 1) ThenBlock: {
            // Hole ID straights are inner + convex (IR side=1). Skip only cove.
            CAD_Topo_FLoc.ln = 1
            IfCondition GreaterThan(CAD_Topo_FComp.n, 0) ThenBlock: {
                CAD_Topo_FLoc.ln = CAD_Topo.FilletIRGet(0, 3)
            }
            IfCondition EqualTo(CAD_Topo_FLoc.ln, 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 1
                PrintMessage("fillet LOCAL skip inner cove\n")
                ReturnValue(0)
            }
            PrintMessage("fillet LOCAL inner convex\n")
        }
        IfCondition EqualTo(CAD_Topo.FilletVertOnCollar(CAD_Topo_FLoc.v0), 1) ThenBlock: {
            CAD_Topo_State.fillet_reason = 5
            PrintMessage("fillet LOCAL incident-collar\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.FilletVertOnCollar(CAD_Topo_FLoc.v1), 1) ThenBlock: {
            CAD_Topo_State.fillet_reason = 5
            PrintMessage("fillet LOCAL incident-collar\n")
            ReturnValue(0)
        }
        CAD_Topo_FLoc.shell = CAD_Store.Read(CAD_Topo_FLoc.solid, 0)
        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.edge, 2)
        IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ce, 0), 1) ThenBlock: { ReturnValue(0) }
        }
        CAD_Topo_FLoc.n1x = ArrayGet(CAD_Topo_FLoc.pl1, 10)
        CAD_Topo_FLoc.n1y = ArrayGet(CAD_Topo_FLoc.pl1, 11)
        CAD_Topo_FLoc.n1z = ArrayGet(CAD_Topo_FLoc.pl1, 12)
        CAD_Topo_FLoc.n2x = ArrayGet(CAD_Topo_FLoc.pl2, 10)
        CAD_Topo_FLoc.n2y = ArrayGet(CAD_Topo_FLoc.pl2, 11)
        CAD_Topo_FLoc.n2z = ArrayGet(CAD_Topo_FLoc.pl2, 12)
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n1x), Float_Mul(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n1y)), Float_Mul(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.n1x = Float_Div(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n1y = Float_Div(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n1z = Float_Div(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.n2x, CAD_Topo_FLoc.n2x), Float_Mul(CAD_Topo_FLoc.n2y, CAD_Topo_FLoc.n2y)), Float_Mul(CAD_Topo_FLoc.n2z, CAD_Topo_FLoc.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.n2x = Float_Div(CAD_Topo_FLoc.n2x, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n2y = Float_Div(CAD_Topo_FLoc.n2y, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n2z = Float_Div(CAD_Topo_FLoc.n2z, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        CAD_Topo_FLoc.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        CAD_Topo_FLoc.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.ln)
        // Span the original edge. The vertex sphere owns the corner:
        // it retargets these generator ends onto the 3-plane ball.
        ArraySet(CAD_Topo_FLoc.pt, 0, CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        ArraySet(CAD_Topo_FLoc.pt, 1, CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        ArraySet(CAD_Topo_FLoc.pt, 2, CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
        ArraySet(CAD_Topo_FLoc.p1b, 0, CAD_Store.Read(CAD_Topo_FLoc.v1, 0))
        ArraySet(CAD_Topo_FLoc.p1b, 1, CAD_Store.Read(CAD_Topo_FLoc.v1, 1))
        ArraySet(CAD_Topo_FLoc.p1b, 2, CAD_Store.Read(CAD_Topo_FLoc.v1, 2))
        CAD_Topo_FLoc.hd = 0
        CAD_Topo_FComp.mode = 0
        CAD_Topo_FLoc.aa = CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f1)
        CAD_Topo_FLoc.bb = CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f2)
        IfCondition EqualTo(CAD_Topo_FLoc.aa, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FLoc.bb, 2) ThenBlock: { CAD_Topo_FLoc.hd = 1 }
        }
        IfCondition EqualTo(CAD_Topo_FLoc.aa, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FLoc.bb, 1) ThenBlock: { CAD_Topo_FLoc.hd = 1 }
        }
        IfCondition EqualTo(CAD_Topo_FLoc.hd, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FilletSolvePlaneCyl(), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 11
                PrintMessage("fillet LOCAL plane-cyl SOLVE fail\n")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(CAD_Topo_FLoc.hd, 0) ThenBlock: {
            PrintMessage("fillet LOCAL not plane-cyl\n")
        }
        IfCondition EqualTo(CAD_Topo_FLoc.hd, 0) ThenBlock: {
            CAD_Topo_FLoc.ab = Float_Add(0x3FF0000000000000, Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x), Float_Mul(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y)), Float_Mul(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ab, 0), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FLoc.ab = Float_Div(CAD_Topo_FLoc.r, CAD_Topo_FLoc.ab)
            // Convex: C = P − ab(N1+N2). Cove: C = P + ab(N1+N2).
            CAD_Topo_FLoc.which = 0
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FLoc.which = 1 }
            CAD_Topo_FLoc.c0x = Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x))
            CAD_Topo_FLoc.c0y = Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y))
            CAD_Topo_FLoc.c0z = Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z))
            IfCondition EqualTo(CAD_Topo_FLoc.which, 0) ThenBlock: {
                CAD_Topo_FLoc.c0x = Float_Sub(ArrayGet(CAD_Topo_FLoc.pt, 0), CAD_Topo_FLoc.c0x)
                CAD_Topo_FLoc.c0y = Float_Sub(ArrayGet(CAD_Topo_FLoc.pt, 1), CAD_Topo_FLoc.c0y)
                CAD_Topo_FLoc.c0z = Float_Sub(ArrayGet(CAD_Topo_FLoc.pt, 2), CAD_Topo_FLoc.c0z)
                CAD_Topo_FLoc.c1x = Float_Sub(ArrayGet(CAD_Topo_FLoc.p1b, 0), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x)))
                CAD_Topo_FLoc.c1y = Float_Sub(ArrayGet(CAD_Topo_FLoc.p1b, 1), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y)))
                CAD_Topo_FLoc.c1z = Float_Sub(ArrayGet(CAD_Topo_FLoc.p1b, 2), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z)))
            }
            IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
                CAD_Topo_FLoc.c0x = Float_Add(ArrayGet(CAD_Topo_FLoc.pt, 0), CAD_Topo_FLoc.c0x)
                CAD_Topo_FLoc.c0y = Float_Add(ArrayGet(CAD_Topo_FLoc.pt, 1), CAD_Topo_FLoc.c0y)
                CAD_Topo_FLoc.c0z = Float_Add(ArrayGet(CAD_Topo_FLoc.pt, 2), CAD_Topo_FLoc.c0z)
                CAD_Topo_FLoc.c1x = Float_Add(ArrayGet(CAD_Topo_FLoc.p1b, 0), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x)))
                CAD_Topo_FLoc.c1y = Float_Add(ArrayGet(CAD_Topo_FLoc.p1b, 1), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y)))
                CAD_Topo_FLoc.c1z = Float_Add(ArrayGet(CAD_Topo_FLoc.p1b, 2), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z)))
            }
        }
        CAD_Topo_FLoc.which = 0
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FLoc.which = 1 }
        IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: {
            CAD_Topo_FLoc.c0x = CAD_Topo_FComp.n3x
            CAD_Topo_FLoc.c0y = CAD_Topo_FComp.n3y
            CAD_Topo_FLoc.c0z = CAD_Topo_FComp.n3z
            CAD_Topo_FLoc.c1x = CAD_Topo_FComp.cx
            CAD_Topo_FLoc.c1y = CAD_Topo_FComp.cy
            CAD_Topo_FLoc.c1z = CAD_Topo_FComp.cz
            CAD_Topo_FLoc.n1x = CAD_Topo_FComp.xx
            CAD_Topo_FLoc.n1y = CAD_Topo_FComp.xy
            CAD_Topo_FLoc.n1z = CAD_Topo_FComp.xz
            CAD_Topo_FLoc.n2x = CAD_Topo_FComp.yx
            CAD_Topo_FLoc.n2y = CAD_Topo_FComp.yy
            CAD_Topo_FLoc.n2z = CAD_Topo_FComp.yz
            CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.edx, CAD_Topo_FComp.edx), Float_Mul(CAD_Topo_FComp.edy, CAD_Topo_FComp.edy)), Float_Mul(CAD_Topo_FComp.edz, CAD_Topo_FComp.edz)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 0) ThenBlock: {
                CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FComp.edx, CAD_Topo_FLoc.ln)
                CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FComp.edy, CAD_Topo_FLoc.ln)
                CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FComp.edz, CAD_Topo_FLoc.ln)
            }
        }
        // Contacts: convex C+R N, cove C−R N. Plane-cyl N is already C→T.
        CAD_Topo_FLoc.ln = CAD_Topo_FLoc.r
        IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: {
                CAD_Topo_FLoc.ln = Float_Sub(0, CAD_Topo_FLoc.r)
            }
        }
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c0x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c0y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c0z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1z)))
        CAD_Topo_FLoc.va0 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c0x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c0y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c0z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2z)))
        CAD_Topo_FLoc.vb0 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c1x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c1y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c1z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1z)))
        CAD_Topo_FLoc.va1 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c1x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c1y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c1z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2z)))
        CAD_Topo_FLoc.vb1 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        IfCondition EqualTo(CAD_Topo_FLoc.va0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.vb1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: {
            CAD_Topo_FLoc.c0x = CAD_Topo_FComp.n3x
            CAD_Topo_FLoc.c0y = CAD_Topo_FComp.n3y
            CAD_Topo_FLoc.c0z = CAD_Topo_FComp.n3z
            CAD_Topo_FLoc.c1x = CAD_Topo_FComp.cx
            CAD_Topo_FLoc.c1y = CAD_Topo_FComp.cy
            CAD_Topo_FLoc.c1z = CAD_Topo_FComp.cz
            CAD_Topo_FLoc.n1x = CAD_Topo_FComp.xx
            CAD_Topo_FLoc.n1y = CAD_Topo_FComp.xy
            CAD_Topo_FLoc.n1z = CAD_Topo_FComp.xz
            CAD_Topo_FLoc.n2x = CAD_Topo_FComp.yx
            CAD_Topo_FLoc.n2y = CAD_Topo_FComp.yy
            CAD_Topo_FLoc.n2z = CAD_Topo_FComp.yz
            CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.edx, CAD_Topo_FComp.edx), Float_Mul(CAD_Topo_FComp.edy, CAD_Topo_FComp.edy)), Float_Mul(CAD_Topo_FComp.edz, CAD_Topo_FComp.edz)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 0) ThenBlock: {
                CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FComp.edx, CAD_Topo_FLoc.ln)
                CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FComp.edy, CAD_Topo_FLoc.ln)
                CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FComp.edz, CAD_Topo_FLoc.ln)
            }
        }
        ArraySet(CAD_Topo_FLoc.frame, 0, CAD_Topo_FLoc.c0x)
        ArraySet(CAD_Topo_FLoc.frame, 1, CAD_Topo_FLoc.c0y)
        ArraySet(CAD_Topo_FLoc.frame, 2, CAD_Topo_FLoc.c0z)
        ArraySet(CAD_Topo_FLoc.frame, 3, CAD_Topo_FLoc.n1x)
        ArraySet(CAD_Topo_FLoc.frame, 4, CAD_Topo_FLoc.n1y)
        ArraySet(CAD_Topo_FLoc.frame, 5, CAD_Topo_FLoc.n1z)
        CAD_Topo_FLoc.ab = Float_Sub(Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.n1z), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.n1y))
        ArraySet(CAD_Topo_FLoc.frame, 6, CAD_Topo_FLoc.ab)
        CAD_Topo_FLoc.ab = Float_Sub(Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.n1x), Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.n1z))
        ArraySet(CAD_Topo_FLoc.frame, 7, CAD_Topo_FLoc.ab)
        CAD_Topo_FLoc.ab = Float_Sub(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.n1y), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.n1x))
        ArraySet(CAD_Topo_FLoc.frame, 8, CAD_Topo_FLoc.ab)
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Topo_FLoc.frame, 6), ArrayGet(CAD_Topo_FLoc.frame, 6)), Float_Mul(ArrayGet(CAD_Topo_FLoc.frame, 7), ArrayGet(CAD_Topo_FLoc.frame, 7))), Float_Mul(ArrayGet(CAD_Topo_FLoc.frame, 8), ArrayGet(CAD_Topo_FLoc.frame, 8))))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 0) ThenBlock: {
            ArraySet(CAD_Topo_FLoc.frame, 6, Float_Div(ArrayGet(CAD_Topo_FLoc.frame, 6), CAD_Topo_FLoc.ln))
            ArraySet(CAD_Topo_FLoc.frame, 7, Float_Div(ArrayGet(CAD_Topo_FLoc.frame, 7), CAD_Topo_FLoc.ln))
            ArraySet(CAD_Topo_FLoc.frame, 8, Float_Div(ArrayGet(CAD_Topo_FLoc.frame, 8), CAD_Topo_FLoc.ln))
        }
        ArraySet(CAD_Topo_FLoc.frame, 9, CAD_Topo_FLoc.edx)
        ArraySet(CAD_Topo_FLoc.frame, 10, CAD_Topo_FLoc.edy)
        ArraySet(CAD_Topo_FLoc.frame, 11, CAD_Topo_FLoc.edz)
        CAD_Topo_FLoc.cyl = CAD_Geom.MakeCylinderSurf(CAD_Topo_FLoc.frame, CAD_Topo_FLoc.r)
        ArraySet(CAD_Topo_FLoc.frame, 0, CAD_Topo_FLoc.c0x)
        ArraySet(CAD_Topo_FLoc.frame, 1, CAD_Topo_FLoc.c0y)
        ArraySet(CAD_Topo_FLoc.frame, 2, CAD_Topo_FLoc.c0z)
        CAD_Topo_FLoc.ce = CAD_Geom.MakeCircle(CAD_Topo_FLoc.frame, CAD_Topo_FLoc.r)
        ArraySet(CAD_Topo_FLoc.frame, 0, CAD_Topo_FLoc.c1x)
        ArraySet(CAD_Topo_FLoc.frame, 1, CAD_Topo_FLoc.c1y)
        ArraySet(CAD_Topo_FLoc.frame, 2, CAD_Topo_FLoc.c1z)
        CAD_Topo_FLoc.endf = CAD_Geom.MakeCircle(CAD_Topo_FLoc.frame, CAD_Topo_FLoc.r)
        ArraySet(CAD_Topo_FLoc.pt, 0, CAD_Store.Read(CAD_Topo_FLoc.va0, 0))
        ArraySet(CAD_Topo_FLoc.pt, 1, CAD_Store.Read(CAD_Topo_FLoc.va0, 1))
        ArraySet(CAD_Topo_FLoc.pt, 2, CAD_Store.Read(CAD_Topo_FLoc.va0, 2))
        ArraySet(CAD_Topo_FLoc.p1b, 0, CAD_Store.Read(CAD_Topo_FLoc.va1, 0))
        ArraySet(CAD_Topo_FLoc.p1b, 1, CAD_Store.Read(CAD_Topo_FLoc.va1, 1))
        ArraySet(CAD_Topo_FLoc.p1b, 2, CAD_Store.Read(CAD_Topo_FLoc.va1, 2))
        CAD_Topo_FLoc.ega = CAD_Topo.MakeEdge(CAD_Topo_FLoc.va0, CAD_Topo_FLoc.va1, CAD_Geom.MakeLine(CAD_Topo_FLoc.pt, CAD_Topo_FLoc.p1b))
        ArraySet(CAD_Topo_FLoc.pt, 0, CAD_Store.Read(CAD_Topo_FLoc.vb0, 0))
        ArraySet(CAD_Topo_FLoc.pt, 1, CAD_Store.Read(CAD_Topo_FLoc.vb0, 1))
        ArraySet(CAD_Topo_FLoc.pt, 2, CAD_Store.Read(CAD_Topo_FLoc.vb0, 2))
        ArraySet(CAD_Topo_FLoc.p1b, 0, CAD_Store.Read(CAD_Topo_FLoc.vb1, 0))
        ArraySet(CAD_Topo_FLoc.p1b, 1, CAD_Store.Read(CAD_Topo_FLoc.vb1, 1))
        ArraySet(CAD_Topo_FLoc.p1b, 2, CAD_Store.Read(CAD_Topo_FLoc.vb1, 2))
        CAD_Topo_FLoc.egb = CAD_Topo.MakeEdge(CAD_Topo_FLoc.vb0, CAD_Topo_FLoc.vb1, CAD_Geom.MakeLine(CAD_Topo_FLoc.pt, CAD_Topo_FLoc.p1b))
        CAD_Topo_FLoc.arc0 = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FLoc.va0, CAD_Topo_FLoc.vb0, CAD_Topo_FLoc.ce)
        CAD_Topo_FLoc.arc1 = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FLoc.va1, CAD_Topo_FLoc.vb1, CAD_Topo_FLoc.endf)
        IfCondition EqualTo(CAD_Topo_FLoc.ega, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.arc1, 0) ThenBlock: { ReturnValue(0) }
        // Blend loop: A-gen, arc1, B-gen rev, arc0 rev
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ega, 0), CAD_Topo_FLoc.va0) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 0, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.ega, CAD_Topo_FLoc.va0, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.ega, 3, ArrayGet(CAD_Topo_FLoc.ring, 0))
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.arc1, 0), CAD_Topo_FLoc.va1) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 1, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.arc1, CAD_Topo_FLoc.va1, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.arc1, 3, ArrayGet(CAD_Topo_FLoc.ring, 1))
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.egb, 0), CAD_Topo_FLoc.vb1) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 2, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.egb, CAD_Topo_FLoc.vb1, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.egb, 3, ArrayGet(CAD_Topo_FLoc.ring, 2))
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.arc0, 0), CAD_Topo_FLoc.vb0) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 3, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.arc0, CAD_Topo_FLoc.vb0, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.arc0, 3, ArrayGet(CAD_Topo_FLoc.ring, 3))
        CAD_Topo_FLoc.ce = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FLoc.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FLoc.ring, 4, CAD_Topo_FLoc.ce)
        CAD_Topo_FLoc.endf = CAD_Topo.MakeFace(CAD_Topo_FLoc.cyl, CAD_Topo_FLoc.ce)
        IfCondition EqualTo(CAD_Topo_FLoc.endf, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Topo_FLoc.shell, CAD_Topo_FLoc.endf)
        // Trim F1 / F2: replace E with generators
        CAD_Topo_FLoc.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FLoc.f1, CAD_Topo_FLoc.edge)
        IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: {
            PrintMessage("fillet LOCAL no coedge f1\n")
            ReturnValue(0)
        }
        CAD_Topo_FLoc.which = CAD_Store.Read(CAD_Topo_FLoc.ce, 5)
        CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va0
        IfCondition EqualTo(CAD_Topo_FLoc.which, CAD_Topo_FLoc.v1) ThenBlock: { CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va1 }
        CAD_Topo.CoedgeSwapEdge(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.ega, CAD_Topo_FLoc.aa)
        CAD_Topo_FLoc.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FLoc.f2, CAD_Topo_FLoc.edge)
        IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: {
            PrintMessage("fillet LOCAL no coedge f2\n")
            ReturnValue(0)
        }
        CAD_Topo_FLoc.which = CAD_Store.Read(CAD_Topo_FLoc.ce, 5)
        CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb0
        IfCondition EqualTo(CAD_Topo_FLoc.which, CAD_Topo_FLoc.v1) ThenBlock: { CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb1 }
        CAD_Topo.CoedgeSwapEdge(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.egb, CAD_Topo_FLoc.bb)
        // Cove: do not insert the end-cap arc into the adjacent wall.
        // That fan sat in the next face's plane and ran past the edge
        // (16-35 / 16-43). Convex still closes the two end faces.
        // Plane∩cyl: project T onto the cap CIRCLE/LINE, then sew.
        CAD_Topo_FLoc.ei = 0
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            CAD_Topo_FLoc.ei = 2
        }
        WhileLoop LessThan(CAD_Topo_FLoc.ei, 2) {
            CAD_Topo_FLoc.vv = CAD_Topo_FLoc.v0
            CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va0
            CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb0
            CAD_Topo_FLoc.ar = CAD_Topo_FLoc.arc0
            IfCondition EqualTo(CAD_Topo_FLoc.ei, 1) ThenBlock: {
                CAD_Topo_FLoc.vv = CAD_Topo_FLoc.v1
                CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va1
                CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb1
                CAD_Topo_FLoc.ar = CAD_Topo_FLoc.arc1
            }
            CAD_Topo_FCE.dx = CAD_Topo_FLoc.edx
            CAD_Topo_FCE.dy = CAD_Topo_FLoc.edy
            CAD_Topo_FCE.dz = CAD_Topo_FLoc.edz
            CAD_Topo_FLoc.endf = CAD_Topo.FindFaceWithVert(CAD_Topo_FLoc.solid, CAD_Topo_FLoc.vv, CAD_Topo_FLoc.f1, CAD_Topo_FLoc.f2)
            IfCondition NotEqual(CAD_Topo_FLoc.endf, 0) ThenBlock: {
                CAD_Topo_FLoc.lp = 0
                CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.endf, 1), 0)
                CAD_Topo_FLoc.hd = CAD_Topo_FLoc.ce
                CAD_Topo_FLoc.ln = 0
                WhileLoop LessThan(CAD_Topo_FLoc.ln, 2048) {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.ce, 5), CAD_Topo_FLoc.vv) ThenBlock: {
                        CAD_Topo_FLoc.lp = CAD_Topo_FLoc.ce
                        CAD_Topo_FLoc.ln = 2048
                    }
                    IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: { CAD_Topo_FLoc.ln = 2048 }
                    IfCondition EqualTo(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.ce, 2)
                        IfCondition EqualTo(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.hd) ThenBlock: { CAD_Topo_FLoc.ln = 2048 }
                    }
                    CAD_Topo_FLoc.ln = Add(CAD_Topo_FLoc.ln, 1)
                }
                IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FLoc.ar, 0) ThenBlock: {
                        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.lp, 3)
                        IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: {
                            CAD_Topo_FLoc.hd = 0
                            IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo.FindCoedgeOnFace(CAD_Topo_FLoc.f1, CAD_Store.Read(CAD_Topo_FLoc.ce, 0)), 0) ThenBlock: {
                                    CAD_Topo_FLoc.hd = 1
                                }
                            }
                            IfCondition EqualTo(CAD_Topo_FLoc.hd, 1) ThenBlock: {
                                CAD_Topo_FLoc.ln = CAD_Topo_FLoc.aa
                                CAD_Topo_FLoc.aa = CAD_Topo_FLoc.bb
                                CAD_Topo_FLoc.bb = CAD_Topo_FLoc.ln
                            }
                        }
                        IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f1), 2) ThenBlock: {
                                CAD_Topo_FLoc.ln = CAD_Topo_FLoc.aa
                                CAD_Topo_FLoc.aa = CAD_Topo_FLoc.bb
                                CAD_Topo_FLoc.bb = CAD_Topo_FLoc.ln
                            }
                        }
                        CAD_Topo_FLoc.hd = CAD_Topo_FLoc.aa
                        CAD_Topo_FLoc.ln = CAD_Topo_FLoc.bb
                        IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: {
                            CAD_Topo_FLoc.hd = CAD_Topo_FLoc.aa
                            IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                                CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.ce, 0), 2)
                                IfCondition NotEqual(CAD_Topo_FLoc.vv, 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.vv, 0), 2) ThenBlock: { CAD_Topo_FLoc.hd = CAD_Topo_FLoc.bb }
                                }
                            }
                            CAD_Topo_FLoc.ln = CAD_Topo_FLoc.aa
                            CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.lp, 0), 2)
                            IfCondition NotEqual(CAD_Topo_FLoc.vv, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.vv, 0), 2) ThenBlock: { CAD_Topo_FLoc.ln = CAD_Topo_FLoc.bb }
                            }
                        }
                        CAD_Topo_FLoc.vv = 1
                        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ar, 0), CAD_Topo_FLoc.hd) ThenBlock: { CAD_Topo_FLoc.vv = 0 }
                        ArraySet(CAD_Topo_FLoc.ring, 8, CAD_Topo_FLoc.hd)
                        ArraySet(CAD_Topo_FLoc.ring, 9, CAD_Topo_FLoc.ln)
                        CAD_Topo_FLoc.cyl = CAD_Topo.MakeCoedge(CAD_Topo_FLoc.ar, CAD_Topo_FLoc.hd, CAD_Topo_FLoc.vv)
                        IfCondition NotEqual(CAD_Topo_FLoc.cyl, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.ar, 4), 0) ThenBlock: {
                                CAD_Store.Write(CAD_Topo_FLoc.ar, 4, CAD_Topo_FLoc.cyl)
                                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ar, 3), 0) ThenBlock: {
                                    CAD_Topo.LinkTwins(CAD_Store.Read(CAD_Topo_FLoc.ar, 3), CAD_Topo_FLoc.cyl)
                                }
                            }
                            CAD_Topo.CoedgeInsertAfter(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.cyl)
                            IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                                CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.ce, 0), 2)
                                CAD_Topo_FLoc.which = 1
                                IfCondition NotEqual(CAD_Topo_FLoc.vv, 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.vv, 0), 2) ThenBlock: { CAD_Topo_FLoc.which = 0 }
                                }
                                IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
                                    CAD_Topo.EdgeRetargetVert(CAD_Store.Read(CAD_Topo_FLoc.ce, 0), CAD_Store.Read(CAD_Topo_FLoc.lp, 5), ArrayGet(CAD_Topo_FLoc.ring, 8))
                                }
                                IfCondition EqualTo(CAD_Topo_FLoc.which, 0) ThenBlock: {
                                    CAD_Topo.FilletEmitCircleEnd(CAD_Store.Read(CAD_Topo_FLoc.ce, 0), CAD_Store.Read(CAD_Topo_FLoc.lp, 5), ArrayGet(CAD_Topo_FLoc.ring, 8))
                                }
                            }
                            CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.lp, 0), 2)
                            CAD_Topo_FLoc.which = 1
                            IfCondition NotEqual(CAD_Topo_FLoc.vv, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.vv, 0), 2) ThenBlock: { CAD_Topo_FLoc.which = 0 }
                            }
                            IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
                                CAD_Topo.EdgeRetargetVert(CAD_Store.Read(CAD_Topo_FLoc.lp, 0), CAD_Store.Read(CAD_Topo_FLoc.lp, 5), ArrayGet(CAD_Topo_FLoc.ring, 9))
                            }
                            IfCondition EqualTo(CAD_Topo_FLoc.which, 0) ThenBlock: {
                                CAD_Topo.FilletEmitCircleEnd(CAD_Store.Read(CAD_Topo_FLoc.lp, 0), CAD_Store.Read(CAD_Topo_FLoc.lp, 5), ArrayGet(CAD_Topo_FLoc.ring, 9))
                            }
                        }
                    }
                }
            }
            CAD_Topo_FLoc.ei = Add(CAD_Topo_FLoc.ei, 1)
        }
        // 2-plane box recipe: pull every LINE on the support to the
        // contact. On plane∩cyl that yank is the radial pie LINE while
        // the 270° ARC stays at the old vert — triangle ear, size of
        // the wall not of R. Mer already retargeted each support's
        // end-edge to its own contact. Skip the yank when mode=1.
        IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FaceHasInnerLoop(CAD_Topo_FLoc.f1), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f1), 1) ThenBlock: {
                    CAD_Topo.FaceRetargetVert(CAD_Topo_FLoc.f1, CAD_Topo_FLoc.v0, CAD_Topo_FLoc.va0, CAD_Topo_FLoc.ega)
                    CAD_Topo.FaceRetargetVert(CAD_Topo_FLoc.f1, CAD_Topo_FLoc.v1, CAD_Topo_FLoc.va1, CAD_Topo_FLoc.ega)
                }
            }
            IfCondition EqualTo(CAD_Topo.FaceHasInnerLoop(CAD_Topo_FLoc.f2), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f2), 1) ThenBlock: {
                    CAD_Topo.FaceRetargetVert(CAD_Topo_FLoc.f2, CAD_Topo_FLoc.v0, CAD_Topo_FLoc.vb0, CAD_Topo_FLoc.egb)
                    CAD_Topo.FaceRetargetVert(CAD_Topo_FLoc.f2, CAD_Topo_FLoc.v1, CAD_Topo_FLoc.vb1, CAD_Topo_FLoc.egb)
                }
            }
        }
        IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: {
            CAD_Topo.FilletEmitEnclosureProbe()
        }
        PrintMessage("fillet LOCAL edge ok\n")
        ReturnValue(CAD_Topo_FLoc.solid)
    }
}

// Fillet one plane–plane edge. Local surgery — previous blends stay.
Function.CAD_Topo.FilletPlanePlaneEdge {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Topo.FilletEdgeLocal(solid_handle, edge_handle, radius_r))
    }
}

// Class 8: outer top rim of a rounded-rect (LINE+ARC, convex).
// Cylinders on flats, quarter-tori on the 2D-fillet arcs. R < r_arc.
Function.CAD_Topo.FilletOuterRoundedRim {
    Input: solid_handle: Integer
    Input: horiz_addr: Address
    Input: n_horiz: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(horiz_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_horiz, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_horiz, 12) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.solid = CAD_Topo_FSeq.solid
        CAD_Topo_FCove.r = CAD_Topo_FSeq.r
        CAD_Topo_FCove.n = CAD_Topo_FSeq.nH
        CAD_Topo_FCove.shell = CAD_Store.Read(CAD_Topo_FCove.solid, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CAD_Topo_FCove.n, 3) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo.FCoveSet(372, CAD_Topo_FCove.i, ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FCove.i))
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimOrder(), 0) ThenBlock: {
            PrintMessage("fillet outer-rim order FAIL\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.RimFillHost(), 0) ThenBlock: {
            PrintMessage("fillet outer-rim host FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo.RimTagArcs()
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimSolveVert(CAD_Topo_FCove.i), 0) ThenBlock: {
                PrintMessage("fillet outer-rim vert FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimMakeSeg(CAD_Topo_FCove.i), 0) ThenBlock: {
                PrintMessage("fillet outer-rim seg FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimSwap(), 0) ThenBlock: {
            PrintMessage("fillet outer-rim swap FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveMakeJoinFace(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            PrintMessage("fillet inner-rim ok n=")
        }
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 0) ThenBlock: {
            PrintMessage("fillet outer-rim ok n=")
        }
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        ReturnValue(CAD_Topo_FCove.solid)
    }
}

// Fusion-style mixed outer rim: class-8 pipes (convex/concave arcs) plus
// Digon vertex spheres at LINE-LINE sharp corners.
Function.CAD_Topo.FilletMixedRim {
    Input: solid_handle: Integer
    Input: horiz_addr: Address
    Input: n_horiz: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(horiz_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_horiz, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_horiz, 12) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.solid = CAD_Topo_FSeq.solid
        CAD_Topo_FCove.r = CAD_Topo_FSeq.r
        CAD_Topo_FCove.n = CAD_Topo_FSeq.nH
        CAD_Topo_FCove.shell = CAD_Store.Read(CAD_Topo_FCove.solid, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo.FCoveSet(372, CAD_Topo_FCove.i, ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FCove.i))
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimOrder(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.RimFillHost(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.RimTagArcs()
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimSolveVert(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.MixFixSharp(), 0) ThenBlock: {
            PrintMessage("fillet mixed sharp FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimMakeSeg(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimSwap(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveMakeJoinFace(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.MixMakeSphere(), 0) ThenBlock: {
            PrintMessage("fillet mixed sphere FAIL\n")
            ReturnValue(0)
        }
        PrintMessage("fillet mixed-rim ok n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        ReturnValue(CAD_Topo_FCove.solid)
    }
}



Function.CAD_Topo.RimFillHost {
    Output: Integer
    Body: {
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, 0)
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.host_f = ArrayGet(CAD_Topo_FCove.faces, 0)
        CAD_Topo_FCove.i = 0
        CAD_Topo_FCove.hit = 1
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.aa = ArrayGet(CAD_Topo_FCove.faces, 0)
            CAD_Topo_FCove.bb = ArrayGet(CAD_Topo_FCove.faces, 1)
            CAD_Topo_FCove.ok = 0
            IfCondition EqualTo(CAD_Topo_FCove.aa, CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.ok = 1 }
            IfCondition EqualTo(CAD_Topo_FCove.bb, CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.ok = 1 }
            IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { CAD_Topo_FCove.hit = 0 }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, 0)
            CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces)
            CAD_Topo_FCove.host_f = ArrayGet(CAD_Topo_FCove.faces, 1)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces)
            CAD_Topo_FCove.aa = ArrayGet(CAD_Topo_FCove.faces, 0)
            CAD_Topo_FCove.bb = ArrayGet(CAD_Topo_FCove.faces, 1)
            CAD_Topo_FCove.f2 = CAD_Topo_FCove.bb
            IfCondition EqualTo(CAD_Topo_FCove.bb, CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.f2 = CAD_Topo_FCove.aa }
            CAD_Topo.FCoveSet(48, CAD_Topo_FCove.i, CAD_Topo_FCove.f2)
            CAD_Topo_FCove.kind = 1
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                CAD_Topo_FCove.kind = CAD_Store.Read(CAD_Topo_FCove.which, 0)
            }
            CAD_Topo.FCoveSet(24, CAD_Topo_FCove.i, CAD_Topo_FCove.kind)
            CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 1)
            CAD_Topo.FCoveSet(384, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(408, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(390, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(396, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(420, CAD_Topo_FCove.i, 0)
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.host_f, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = ArrayGet(CAD_Topo_FCove.pl, 10)
        CAD_Topo_FCove.n1y = ArrayGet(CAD_Topo_FCove.pl, 11)
        CAD_Topo_FCove.n1z = ArrayGet(CAD_Topo_FCove.pl, 12)
        ReturnValue(1)
    }
}

// Host-face membership of the 2D arc centre: inside = convex r-R, else concave r+R.
Function.CAD_Topo.RimTagArcs {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 1)
            IfCondition EqualTo(CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i), 2) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
                CAD_Topo_FCove.which = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                }
                IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                    ArraySet(CAD_Topo_FCove.pt, 0, CAD_Store.Read(CAD_Topo_FCove.which, 1))
                    ArraySet(CAD_Topo_FCove.pt, 1, CAD_Store.Read(CAD_Topo_FCove.which, 2))
                    ArraySet(CAD_Topo_FCove.pt, 2, CAD_Store.Read(CAD_Topo_FCove.which, 3))
                    IfCondition EqualTo(CAD_Topo.PointInFaceUV(CAD_Topo_FCove.host_f, CAD_Topo_FCove.pt), 0) ThenBlock: {
                        CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 0)
                    }
                }
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

// Wall unit N of edge i at vertex vh. Plane is constant; cyl radial is at vh
// (toward axis when conv=0 ID). Always evaluate at the vertex being solved —
// a prev ARC's start is the other mouth, and those two radials look G1.
Function.CAD_Topo.RimWallN {
    Input: i: Integer
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.kind = CAD_Topo.FCoveGet(24, i)
        CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, i)
        CAD_Topo_FCove.n2x = 0
        CAD_Topo_FCove.n2y = 0
        CAD_Topo_FCove.n2z = 0
        IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
            IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.f2, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.n2x = ArrayGet(CAD_Topo_FCove.pl, 10)
            CAD_Topo_FCove.n2y = ArrayGet(CAD_Topo_FCove.pl, 11)
            CAD_Topo_FCove.n2z = ArrayGet(CAD_Topo_FCove.pl, 12)
        }
        IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.which, 1)
            CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.which, 2)
            CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.which, 3)
            CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(vh, 0), CAD_Topo_FCove.cx)
            CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(vh, 1), CAD_Topo_FCove.cy)
            CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(vh, 2), CAD_Topo_FCove.cz)
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveGet(36, i), 0) ThenBlock: {
                    CAD_Topo_FCove.n2x = Float_Sub(CAD_Topo_FCove.cx, CAD_Store.Read(vh, 0))
                    CAD_Topo_FCove.n2y = Float_Sub(CAD_Topo_FCove.cy, CAD_Store.Read(vh, 1))
                    CAD_Topo_FCove.n2z = Float_Sub(CAD_Topo_FCove.cz, CAD_Store.Read(vh, 2))
                }
            }
        }
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        // LINE: outward from a probe at the EDGE MIDPOINT. Probing at a
        // trihedral vertex (V or mouth) flips one wall and inverts the
        // sphere — degenerate corner + punched top. Cyl ID already uses
        // toward-axis; do not PointInSolid there.
        IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_FCove.solid, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.pt, 0) ThenBlock: {
                    CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
                    CAD_Topo_FCove.ok = 0
                    CAD_Topo_FCove.orig = 0
                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                        CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                        CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                    }
                    IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                        IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
                            CAD_Topo_FCove.ab = 0x3FE0000000000000
                            ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(Float_Mul(0x3FE0000000000000, Float_Add(CAD_Store.Read(CAD_Topo_FCove.ok, 0), CAD_Store.Read(CAD_Topo_FCove.orig, 0))), Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2x)))
                            ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(Float_Mul(0x3FE0000000000000, Float_Add(CAD_Store.Read(CAD_Topo_FCove.ok, 1), CAD_Store.Read(CAD_Topo_FCove.orig, 1))), Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2y)))
                            ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(Float_Mul(0x3FE0000000000000, Float_Add(CAD_Store.Read(CAD_Topo_FCove.ok, 2), CAD_Store.Read(CAD_Topo_FCove.orig, 2))), Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2z)))
                            IfCondition EqualTo(CAD_Topo.PointInSolid(CAD_Topo_FCove.solid, CAD_Topo_FCove.pt), 1) ThenBlock: {
                                CAD_Topo_FCove.n2x = Float_Sub(0, CAD_Topo_FCove.n2x)
                                CAD_Topo_FCove.n2y = Float_Sub(0, CAD_Topo_FCove.n2y)
                                CAD_Topo_FCove.n2z = Float_Sub(0, CAD_Topo_FCove.n2z)
                            }
                        }
                    }
                }
            }
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.MixFixSharp {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.i, 1)
            IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
            CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i)
            IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.g = 0
            CAD_Topo_FCove.hit = 0
            IfCondition NotEqual(CAD_Topo_FCove.k, CAD_Topo_FCove.i) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.k)
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { CAD_Topo_FCove.g = 1 }
            IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.k)
            CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
            IfCondition GreaterEqual(CAD_Topo_FComp.h, 0) ThenBlock: {
                CAD_Topo_FCove.ok = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.ok = 6 }
                }
                CAD_Topo_FCove.orig = 14
                IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 15 }
                IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 1) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i), 0) ThenBlock: {
                        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.ok))
                        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 1)))
                        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 2)))
                        CAD_Topo.FCoveSet(408, CAD_Topo_FCove.i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
                        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 3)))
