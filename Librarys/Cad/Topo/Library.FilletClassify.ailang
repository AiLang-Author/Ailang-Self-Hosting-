// CAD.Topo.FilletClassify — junction type classifier for fillet edge pairs.
// Pure read-only: inspects IR VSol flags and face kinds, returns enum.
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)
//
// Junction enum: 0=none, 1=TRIHEDRAL_SPHERE, 2=SHARP_COPE,
//                3=STADIUM_ARC, 4=MIXED_ARC_LINE
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.ClassifyFilletJunction {
    Input: i: Integer
    Output: Integer
    Body: {
        nd = CAD_Topo.FilletPlexGetNode(i)
        IfCondition NotEqual(nd, 0) ThenBlock: {
            jt = Plex.Get(nd, 7)
            IfCondition EqualTo(jt, 1) ThenBlock: {
                ReturnValue(2) // SHARP_COPE forced by Plex local Ring 0 classification
            }
        }
        CAD_Topo_FCove.k = Subtract(i, 1)
        IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.hit = 0
        IfCondition NotEqual(CAD_Topo_FCove.k, i) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.k)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.hit = 1 }
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.k)
        CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
        IfCondition LessThan(CAD_Topo_FComp.h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok = 0
        IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.ok = 6 }
        }
        CAD_Topo_FCove.orig = 14
        IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 15 }
        IfCondition NotEqual(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIRFaceKind(CAD_Topo.FCoveGet(48, i)), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FilletIRFaceKind(CAD_Topo.FCoveGet(48, CAD_Topo_FCove.k)), 1) ThenBlock: {
                ReturnValue(2)
            }
        }
        CAD_Topo_FCove.orig = 12
        IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 13 }
        IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(4)
    }
}
