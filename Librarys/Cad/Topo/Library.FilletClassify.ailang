// CAD.Topo.FilletClassify — junction type classifier for fillet edge pairs.
// Pure read-only: inspects IR VSol flags and face kinds, returns enum.
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)
//
// Junction enum: 0=none, 1=TRIHEDRAL_SPHERE, 2=SHARP_COPE,
//                3=STADIUM_ARC, 4=MIXED_ARC_LINE, 5=RAIL_ARC
// junc 5 is plex-tagged (open LINE vs cylindrical face); MixFixSharp
// does not consume it — sequential calls FilletPlexRailArcShift.
//
// Vertex-local (Sketchpad): look at the two loop edges at this vertex.
//   3+ selected edges → XYZ vertex join → sphere (stacked boxes)
//   two LINE → cope
//   LINE+ARC G1 → tangent, no extra corner solver
//   LINE+ARC not G1 in a compound → MixFixSharp refuses (no single-pass join)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

// Wall unit N of cove edge i at join vertex vh. LINE = plane of the
// wall face. ARC = V−C at vh (no conv reverse, no PointInSolid).
Function.CAD_Topo.FilletIdentifyWallNAt {
    Input: i: Integer
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.kind = CAD_Topo.FCoveGet(24, i)
        IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
            CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, i)
            IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.f2, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.n2x = ArrayGet(CAD_Topo_FCove.pl, 10)
            CAD_Topo_FCove.n2y = ArrayGet(CAD_Topo_FCove.pl, 11)
            CAD_Topo_FCove.n2z = ArrayGet(CAD_Topo_FCove.pl, 12)
        }
        IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
            IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(vh, 0), CAD_Store.Read(CAD_Topo_FCove.which, 1))
            CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(vh, 1), CAD_Store.Read(CAD_Topo_FCove.which, 2))
            CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(vh, 2), CAD_Store.Read(CAD_Topo_FCove.which, 3))
        }
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        ReturnValue(1)
    }
}

// 1 iff the two walls at chain vertex i are G1 (Ns parallel at V).
Function.CAD_Topo.FilletIdentifyJoinG1 {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.k = Subtract(i, 1)
        IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIdentifyWallNAt(i, CAD_Topo_FCove.v0), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n3x = CAD_Topo_FCove.n2x
        CAD_Topo_FCove.n3y = CAD_Topo_FCove.n2y
        CAD_Topo_FCove.n3z = CAD_Topo_FCove.n2z
        IfCondition EqualTo(CAD_Topo.FilletIdentifyWallNAt(CAD_Topo_FCove.k, CAD_Topo_FCove.v0), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.aa = CAD_Num.Abs(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n3x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n3y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n3z, CAD_Topo_FCove.n2z)))
        PrintMessage("fillet g1 i=")
        PrintNumber(i)
        PrintMessage(" |N·N|=")
        PrintNumber(Float_ToInt(Float_Mul(CAD_Topo_FCove.aa, 0x408F400000000000)))
        PrintMessage("\n")
        // G1 iff |N·N| >= 0.8
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FCove.aa, 0x3FE999999999999A)), 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.ClassifyFilletJunction {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.k = Subtract(i, 1)
        IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        // XYZ: three selected edges. Sphere only here — not at 2-edge sharp corners.
        IfCondition GreaterThan(CAD_Topo.MixVertSelCount(CAD_Topo_FCove.v0), 2) ThenBlock: {
            ReturnValue(1)
        }
        // Two selected LINE walls at this vertex → cope.
        // Open-chain wrap (i=0 vs last) is not a corner: nsel=1 there.
        IfCondition EqualTo(CAD_Topo.MixVertSelCount(CAD_Topo_FCove.v0), 2) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FCoveGet(24, i), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveGet(24, CAD_Topo_FCove.k), 1) ThenBlock: {
                    ReturnValue(2)
                }
            }
        }
        CAD_Topo_FCove.hit = 0
        IfCondition NotEqual(CAD_Topo_FCove.k, i) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.k)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.hit = 1 }
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(0) }
        // LINE+ARC G1 (2D fillet) → tangent. Sharp mixed → refuse in MixFixSharp.
        IfCondition EqualTo(CAD_Topo.FilletIdentifyJoinG1(i), 1) ThenBlock: {
            ReturnValue(4)
        }
        ReturnValue(0)
    }
}
