// CAD.Topo.FilletCove — class-3 join-cove: 2-plane cylinders that COPE
// Adjacent equal-R pipes meet on a Steinmetz ellipse (same as outer Digon).
// Host inner = sharp offset rectangle (90°). No extra corner face.
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)
// buf map: Library.Core CAD_Topo_FCove (max_slot=482, Allocate 4096)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

// Join-cove Construction F'. buf = Allocate(4096) once; max_slot=482 ≤ 510.
FixedPool.CAD_Topo_FCove {
    "solid": Initialize=0, CanChange=True
    "r":     Initialize=0, CanChange=True
    "n":     Initialize=0, CanChange=True
    "i":     Initialize=0, CanChange=True
    "k":     Initialize=0, CanChange=True
    "ok":    Initialize=0, CanChange=True
    "host_f": Initialize=0, CanChange=True
    "pad_top_f": Initialize=0, CanChange=True
    "which": Initialize=0, CanChange=True
    "ln":    Initialize=0, CanChange=True
    "aa":    Initialize=0, CanChange=True
    "bb":    Initialize=0, CanChange=True
    "buf":   Initialize=0, CanChange=True
    "pt":    Initialize=0, CanChange=True
    "p1b":   Initialize=0, CanChange=True
    "frame": Initialize=0, CanChange=True
    "pl":    Initialize=0, CanChange=True
    "ring":  Initialize=0, CanChange=True
    "faces": Initialize=0, CanChange=True
    "shell": Initialize=0, CanChange=True
    "ce":    Initialize=0, CanChange=True
    "lp":    Initialize=0, CanChange=True
    "hd":    Initialize=0, CanChange=True
    "v0":    Initialize=0, CanChange=True
    "v1":    Initialize=0, CanChange=True
    "e":     Initialize=0, CanChange=True
    "f1":    Initialize=0, CanChange=True
    "f2":    Initialize=0, CanChange=True
    "sn":    Initialize=0, CanChange=True
    "orig":  Initialize=0, CanChange=True
    "nxt":   Initialize=0, CanChange=True
    "prv":   Initialize=0, CanChange=True
    "n1x":   Initialize=0, CanChange=True
    "n1y":   Initialize=0, CanChange=True
    "n1z":   Initialize=0, CanChange=True
    "n2x":   Initialize=0, CanChange=True
    "n2y":   Initialize=0, CanChange=True
    "n2z":   Initialize=0, CanChange=True
    "n3x":   Initialize=0, CanChange=True
    "n3y":   Initialize=0, CanChange=True
    "n3z":   Initialize=0, CanChange=True
    "cx":    Initialize=0, CanChange=True
    "cy":    Initialize=0, CanChange=True
    "cz":    Initialize=0, CanChange=True
    "d12":   Initialize=0, CanChange=True
    "d13":   Initialize=0, CanChange=True
    "d23":   Initialize=0, CanChange=True
    "det":   Initialize=0, CanChange=True
    "edx":   Initialize=0, CanChange=True
    "edy":   Initialize=0, CanChange=True
    "edz":   Initialize=0, CanChange=True
    "ab":    Initialize=0, CanChange=True
    "s":     Initialize=0, CanChange=True
    "g":     Initialize=0, CanChange=True
    "minlen": Initialize=0, CanChange=True
    "padh":  Initialize=0, CanChange=True
    "j":     Initialize=0, CanChange=True
    "hit":   Initialize=0, CanChange=True
    "wa":    Initialize=0, CanChange=True
    "wb":    Initialize=0, CanChange=True
    "kind":  Initialize=0, CanChange=True
    "ok1":   Initialize=0, CanChange=True
    "hit1":  Initialize=0, CanChange=True
    "lp1":   Initialize=0, CanChange=True
    "nxt1":  Initialize=0, CanChange=True
}

Function.CAD_Topo.FCoveEnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FCove.buf, 0) ThenBlock: { CAD_Topo_FCove.buf = Allocate(4096) }
        IfCondition EqualTo(CAD_Topo_FCove.pt, 0) ThenBlock: { CAD_Topo_FCove.pt = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FCove.p1b, 0) ThenBlock: { CAD_Topo_FCove.p1b = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FCove.frame, 0) ThenBlock: { CAD_Topo_FCove.frame = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FCove.pl, 0) ThenBlock: { CAD_Topo_FCove.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FCove.ring, 0) ThenBlock: { CAD_Topo_FCove.ring = Allocate(64) }
        IfCondition EqualTo(CAD_Topo_FCove.faces, 0) ThenBlock: { CAD_Topo_FCove.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FCove.buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.pt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.ring, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveGet {
    Input: base: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        ReturnValue(ArrayGet(CAD_Topo_FCove.buf, Add(base, i)))
    }
}

Function.CAD_Topo.FCoveSet {
    Input: base: Integer
    Input: i: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        ArraySet(CAD_Topo_FCove.buf, Add(base, i), val)
        ReturnValue(val)
    }
}

Function.CAD_Topo.FCoveVertEq {
    Input: va: Integer
    Input: vb: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(va, vb) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 0), CAD_Store.Read(vb, 0), 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 1), CAD_Store.Read(vb, 1), 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(va, 2), CAD_Store.Read(vb, 2), 0), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveRegisterCe {
    Input: edge_handle: Integer
    Input: origin_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(origin_v, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.sn = 1
        IfCondition NotEqual(CAD_Store.Read(edge_handle, 0), origin_v) ThenBlock: { CAD_Topo_FCove.sn = 0 }
        CAD_Topo_FCove.ce = CAD_Topo.MakeCoedge(edge_handle, origin_v, CAD_Topo_FCove.sn)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Store.Read(edge_handle, 3), 0) ThenBlock: {
            CAD_Store.Write(edge_handle, 3, CAD_Topo_FCove.ce)
        }
        IfCondition NotEqual(CAD_Store.Read(edge_handle, 3), CAD_Topo_FCove.ce) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(edge_handle, 4), 0) ThenBlock: {
                CAD_Store.Write(edge_handle, 4, CAD_Topo_FCove.ce)
                CAD_Topo.LinkTwins(CAD_Store.Read(edge_handle, 3), CAD_Topo_FCove.ce)
            }
        }
        ReturnValue(CAD_Topo_FCove.ce)
    }
}

Function.CAD_Topo.FCoveInnerLoop {
    Input: edge_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.k = 0
        WhileLoop LessThan(CAD_Topo_FCove.k, 2) {
            CAD_Topo_FCove.ce = CAD_Store.Read(edge_handle, Add(3, CAD_Topo_FCove.k))
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.ce, 4)
                IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                    CAD_Topo_FCove.f1 = CAD_Store.Read(CAD_Topo_FCove.lp, 1)
                    IfCondition NotEqual(CAD_Topo_FCove.f1, 0) ThenBlock: {
                        CAD_Topo_FCove.hd = CAD_Store.Read(CAD_Topo_FCove.f1, 1)
                        IfCondition NotEqual(CAD_Topo_FCove.hd, 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Topo_FCove.lp, CAD_Topo_FCove.hd) ThenBlock: {
                                ReturnValue(CAD_Topo_FCove.lp)
                            }
                        }
                    }
                }
            }
            CAD_Topo_FCove.k = Add(CAD_Topo_FCove.k, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.FCoveFindUpright {
    Input: p_v: Integer
    Input: wall_a: Integer
    Input: wall_b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(p_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(wall_a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(wall_b, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.v0 = p_v
        CAD_Topo_FCove.f1 = wall_a
        CAD_Topo_FCove.f2 = wall_b
        IfCondition EqualTo(CAD_Topo_FCove.faces, 0) ThenBlock: { CAD_Topo_FCove.faces = Allocate(32) }
        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.f1, 1)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.hd = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        CAD_Topo_FCove.ce = CAD_Topo_FCove.hd
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 16) {
            CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
            CAD_Topo_FCove.ok = 0
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.which, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: {
                            CAD_Topo_FCove.aa = ArrayGet(CAD_Topo_FCove.faces, 0)
                            CAD_Topo_FCove.bb = ArrayGet(CAD_Topo_FCove.faces, 1)
                            CAD_Topo_FCove.ok = 0
                            IfCondition EqualTo(CAD_Topo_FCove.aa, CAD_Topo_FCove.f1) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo_FCove.bb, CAD_Topo_FCove.f2) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                            }
                            IfCondition EqualTo(CAD_Topo_FCove.aa, CAD_Topo_FCove.f2) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo_FCove.bb, CAD_Topo_FCove.f1) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0), 1) ThenBlock: {
                    ReturnValue(CAD_Topo_FCove.e)
                }
                IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0), 1) ThenBlock: {
                    ReturnValue(CAD_Topo_FCove.e)
                }
            }
            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
            IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 16 }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.FCoveMakeLineE {
    Input: va: Integer
    Input: vb: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Store.Read(va, 0))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Store.Read(va, 1))
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Store.Read(va, 2))
        ArraySet(CAD_Topo_FCove.p1b, 0, CAD_Store.Read(vb, 0))
        ArraySet(CAD_Topo_FCove.p1b, 1, CAD_Store.Read(vb, 1))
        ArraySet(CAD_Topo_FCove.p1b, 2, CAD_Store.Read(vb, 2))
        CAD_Topo_FCove.ln = CAD_Geom.MakeLine(CAD_Topo_FCove.pt, CAD_Topo_FCove.p1b)
        IfCondition EqualTo(CAD_Topo_FCove.ln, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Topo.MakeEdge(va, vb, CAD_Topo_FCove.ln))
    }
}

Function.CAD_Topo.FCoveMakeArc {
    Input: va: Integer
    Input: vb: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = Float_Sub(CAD_Store.Read(va, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.n1y = Float_Sub(CAD_Store.Read(va, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.n1z = Float_Sub(CAD_Store.Read(va, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n1x), Float_Mul(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n1y)), Float_Mul(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = Float_Div(CAD_Topo_FCove.n1x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1y = Float_Div(CAD_Topo_FCove.n1y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1z = Float_Div(CAD_Topo_FCove.n1z, CAD_Topo_FCove.ln)
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
        CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(vb, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(vb, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(vb, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n1x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n1y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.n2x = Float_Sub(CAD_Topo_FCove.n2x, Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n1x))
        CAD_Topo_FCove.n2y = Float_Sub(CAD_Topo_FCove.n2y, Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n1y))
        CAD_Topo_FCove.n2z = Float_Sub(CAD_Topo_FCove.n2z, Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FCove.frame, 6, Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln))
        ArraySet(CAD_Topo_FCove.frame, 7, Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln))
        ArraySet(CAD_Topo_FCove.frame, 8, Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln))
        CAD_Topo_FCove.which = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Topo.MakeMinorArcEdge(va, vb, CAD_Topo_FCove.which))
    }
}

Function.CAD_Topo.FCoveWalkFill {
    Output: Integer
    Body: {
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, 0)
        CAD_Topo_FCove.lp = CAD_Topo.FCoveInnerLoop(CAD_Topo_FCove.e)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FCoveSet(457, 0, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.hd = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        IfCondition EqualTo(CAD_Topo_FCove.hd, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ce = CAD_Topo_FCove.hd
        CAD_Topo_FCove.n = 0
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 16) {
            CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
            CAD_Topo.FCoveSet(0, CAD_Topo_FCove.n, CAD_Topo_FCove.e)
            CAD_Topo.FCoveSet(12, CAD_Topo_FCove.n, CAD_Store.Read(CAD_Topo_FCove.ce, 5))
            CAD_Topo_FCove.n = Add(CAD_Topo_FCove.n, 1)
            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
            IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 16 }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        IfCondition LessThan(CAD_Topo_FCove.n, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CAD_Topo_FCove.n, 12) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FCoveSet(456, 0, CAD_Topo_FCove.n)
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.k = Add(CAD_Topo_FCove.i, 1)
            IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
            CAD_Topo.FCoveSet(24, CAD_Topo_FCove.i, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k))
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.f1 = ArrayGet(CAD_Topo_FCove.faces, 0)
            CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 1)
            CAD_Topo_FCove.host_f = CAD_Topo_FCove.f2
            CAD_Topo_FCove.which = CAD_Topo_FCove.f1
            IfCondition EqualTo(CAD_Topo.EdgeOnInnerLoop(CAD_Topo_FCove.e, CAD_Topo_FCove.f1), 1) ThenBlock: {
                CAD_Topo_FCove.host_f = CAD_Topo_FCove.f1
                CAD_Topo_FCove.which = CAD_Topo_FCove.f2
            }
            CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, CAD_Topo_FCove.host_f)
            CAD_Topo.FCoveSet(48, CAD_Topo_FCove.i, CAD_Topo_FCove.which)
            CAD_Topo.FCoveSet(459, CAD_Topo_FCove.i, CAD_Topo_FCove.which)
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        CAD_Topo_FCove.host_f = CAD_Topo.FCoveGet(36, 0)
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.k = CAD_Topo_FCove.i
            IfCondition EqualTo(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = CAD_Topo_FCove.n }
            CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.k, 1)
            CAD_Topo.FCoveSet(72, CAD_Topo_FCove.i, CAD_Topo.FCoveGet(48, CAD_Topo_FCove.k))
            CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i)
            CAD_Topo_FCove.e = CAD_Topo.FCoveFindUpright(CAD_Topo_FCove.v0, CAD_Topo.FCoveGet(48, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(72, CAD_Topo_FCove.i))
            IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo.FCoveSet(60, CAD_Topo_FCove.i, CAD_Topo_FCove.e)
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveFillJoin {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.f1 = CAD_Topo.FCoveGet(36, i)
        CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, i)
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.f1, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = ArrayGet(CAD_Topo_FCove.pl, 10)
        CAD_Topo_FCove.n1y = ArrayGet(CAD_Topo_FCove.pl, 11)
        CAD_Topo_FCove.n1z = ArrayGet(CAD_Topo_FCove.pl, 12)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n1x), Float_Mul(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n1y)), Float_Mul(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FCoveSet(84, i, Float_Div(CAD_Topo_FCove.n1x, CAD_Topo_FCove.ln))
        CAD_Topo.FCoveSet(96, i, Float_Div(CAD_Topo_FCove.n1y, CAD_Topo_FCove.ln))
        CAD_Topo.FCoveSet(108, i, Float_Div(CAD_Topo_FCove.n1z, CAD_Topo_FCove.ln))
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.f2, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = ArrayGet(CAD_Topo_FCove.pl, 10)
        CAD_Topo_FCove.n2y = ArrayGet(CAD_Topo_FCove.pl, 11)
        CAD_Topo_FCove.n2z = ArrayGet(CAD_Topo_FCove.pl, 12)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FCoveSet(120, i, Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln))
        CAD_Topo.FCoveSet(132, i, Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln))
        CAD_Topo.FCoveSet(144, i, Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln))
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(24, i)
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2))
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FCoveSet(156, i, Float_Div(CAD_Topo_FCove.edx, CAD_Topo_FCove.ln))
        CAD_Topo.FCoveSet(168, i, Float_Div(CAD_Topo_FCove.edy, CAD_Topo_FCove.ln))
        CAD_Topo.FCoveSet(180, i, Float_Div(CAD_Topo_FCove.edz, CAD_Topo_FCove.ln))
        IfCondition EqualTo(CAD_Topo_FCove.i, 0) ThenBlock: { CAD_Topo_FCove.minlen = CAD_Topo_FCove.ln }
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.ln, CAD_Topo_FCove.minlen), 1) ThenBlock: { CAD_Topo_FCove.minlen = CAD_Topo_FCove.ln }
        CAD_Topo_FCove.ab = Float_Add(0x3FF0000000000000, Float_Add(Float_Add(Float_Mul(CAD_Topo.FCoveGet(84, i), CAD_Topo.FCoveGet(120, i)), Float_Mul(CAD_Topo.FCoveGet(96, i), CAD_Topo.FCoveGet(132, i))), Float_Mul(CAD_Topo.FCoveGet(108, i), CAD_Topo.FCoveGet(144, i))))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FCoveSet(192, i, Float_Div(CAD_Topo_FCove.r, CAD_Topo_FCove.ab))
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveSolveCorner {
    Input: i: Integer
    Output: Integer
    Body: {
        // 2-plane rolling ball at both original endpoints. C = P + ab(Nh+Nw),
        // T_h = C − R Nh (host, outboard by R), T_w = C − R Nw = P' (up the wall).
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(24, i)
        CAD_Topo_FCove.n1x = CAD_Topo.FCoveGet(84, i)
        CAD_Topo_FCove.n1y = CAD_Topo.FCoveGet(96, i)
        CAD_Topo_FCove.n1z = CAD_Topo.FCoveGet(108, i)
        CAD_Topo_FCove.n2x = CAD_Topo.FCoveGet(120, i)
        CAD_Topo_FCove.n2y = CAD_Topo.FCoveGet(132, i)
        CAD_Topo_FCove.n2z = CAD_Topo.FCoveGet(144, i)
        CAD_Topo_FCove.s = CAD_Topo_FCove.r
        CAD_Topo_FCove.ab = CAD_Topo.FCoveGet(192, i)
        CAD_Topo_FCove.cx = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 0), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n2x)))
        CAD_Topo_FCove.cy = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 1), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n2y)))
        CAD_Topo_FCove.cz = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 2), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n2z)))
        CAD_Topo.FCoveSet(204, i, CAD_Topo_FCove.cx)
        CAD_Topo.FCoveSet(216, i, CAD_Topo_FCove.cy)
        CAD_Topo.FCoveSet(228, i, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1z)))
        CAD_Topo.FCoveSet(240, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n2z)))
        CAD_Topo.FCoveSet(252, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        CAD_Topo.FCoveSet(276, i, CAD_Topo.FCoveGet(252, i))
        CAD_Topo_FCove.cx = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 0), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n2x)))
        CAD_Topo_FCove.cy = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 1), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n2y)))
        CAD_Topo_FCove.cz = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 2), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n2z)))
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1z)))
        CAD_Topo.FCoveSet(264, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        CAD_Topo_FCove.k = i
        IfCondition EqualTo(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = CAD_Topo_FCove.n }
        CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.k, 1)
        CAD_Topo_FCove.n3x = CAD_Topo.FCoveGet(120, CAD_Topo_FCove.k)
        CAD_Topo_FCove.n3y = CAD_Topo.FCoveGet(132, CAD_Topo_FCove.k)
        CAD_Topo_FCove.n3z = CAD_Topo.FCoveGet(144, CAD_Topo_FCove.k)
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 0), Float_Mul(CAD_Topo_FCove.s, Float_Add(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n3x))))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 1), Float_Mul(CAD_Topo_FCove.s, Float_Add(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n3y))))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 2), Float_Mul(CAD_Topo_FCove.s, Float_Add(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n3z))))
        CAD_Topo.FCoveSet(432, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        IfCondition EqualTo(CAD_Topo.FCoveGet(240, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(252, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(432, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveMakeJoinGeom {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.k = Add(i, 1)
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
        CAD_Topo_FCove.n1x = CAD_Topo.FCoveGet(84, i)
        CAD_Topo_FCove.n1y = CAD_Topo.FCoveGet(96, i)
        CAD_Topo_FCove.n1z = CAD_Topo.FCoveGet(108, i)
        CAD_Topo_FCove.edx = CAD_Topo.FCoveGet(156, i)
        CAD_Topo_FCove.edy = CAD_Topo.FCoveGet(168, i)
        CAD_Topo_FCove.edz = CAD_Topo.FCoveGet(180, i)
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo.FCoveGet(204, i))
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo.FCoveGet(216, i))
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo.FCoveGet(228, i))
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
        CAD_Topo_FCove.aa = Float_Sub(Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.n1z), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.n1y))
        CAD_Topo_FCove.bb = Float_Sub(Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.n1x), Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.ln = Float_Sub(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.n1y), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.n1x))
        CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.aa), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.bb)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.ln)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
            CAD_Topo_FCove.aa = Float_Div(CAD_Topo_FCove.aa, CAD_Topo_FCove.ab)
            CAD_Topo_FCove.bb = Float_Div(CAD_Topo_FCove.bb, CAD_Topo_FCove.ab)
            CAD_Topo_FCove.ln = Float_Div(CAD_Topo_FCove.ln, CAD_Topo_FCove.ab)
        }
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.aa)
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.bb)
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.ln)
        ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FCove.edx)
        ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FCove.edy)
        ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FCove.edz)
        CAD_Topo.FCoveSet(300, i, CAD_Geom.MakeCylinderSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.r))
        CAD_Topo.FCoveSet(312, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(432, i), CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k)))
        CAD_Topo.FCoveSet(324, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(276, i), CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k)))
        IfCondition EqualTo(CAD_Topo.FCoveGet(312, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(324, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveMakeCornerGeom {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.k = i
        IfCondition EqualTo(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = CAD_Topo_FCove.n }
        CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.k, 1)
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(60, i)
        CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(12, i)
        CAD_Topo_FCove.which = CAD_Topo_FCove.v1
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.v0, CAD_Topo_FCove.orig), 1) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Topo_FCove.v1
        }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.v1, CAD_Topo_FCove.orig), 1) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Topo_FCove.v0
        }
        CAD_Topo.FCoveSet(288, i, CAD_Topo.FCoveMakeLineE(CAD_Topo_FCove.which, CAD_Topo.FCoveGet(276, i)))
        // Cope seam: Steinmetz ellipse P' ↔ H90 (host 90° offset corner).
        // Shared by the two cylinders. No extra corner face.
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(276, i)
        CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(432, i)
        CAD_Topo_FCove.n1x = CAD_Topo.FCoveGet(84, i)
        CAD_Topo_FCove.n1y = CAD_Topo.FCoveGet(96, i)
        CAD_Topo_FCove.n1z = CAD_Topo.FCoveGet(108, i)
        CAD_Topo_FCove.cx = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 0), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1x))
        CAD_Topo_FCove.cy = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 1), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1y))
        CAD_Topo_FCove.cz = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 2), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.aa = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.bb = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.ln = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.aa), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.bb)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.ln)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.frame, 3, Float_Div(CAD_Topo_FCove.aa, CAD_Topo_FCove.ab))
        ArraySet(CAD_Topo_FCove.frame, 4, Float_Div(CAD_Topo_FCove.bb, CAD_Topo_FCove.ab))
        ArraySet(CAD_Topo_FCove.frame, 5, Float_Div(CAD_Topo_FCove.ln, CAD_Topo_FCove.ab))
        CAD_Topo_FCove.edx = CAD_Topo_FCove.ab
        CAD_Topo_FCove.aa = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.bb = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.ln = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.aa), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.bb)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.ln)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FCove.frame, 6, Float_Div(CAD_Topo_FCove.aa, CAD_Topo_FCove.ab))
        ArraySet(CAD_Topo_FCove.frame, 7, Float_Div(CAD_Topo_FCove.bb, CAD_Topo_FCove.ab))
        ArraySet(CAD_Topo_FCove.frame, 8, Float_Div(CAD_Topo_FCove.ln, CAD_Topo_FCove.ab))
        CAD_Topo_FCove.which = CAD_Geom.MakeEllipse(CAD_Topo_FCove.frame, CAD_Topo_FCove.edx, CAD_Topo_FCove.ab)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FCoveSet(348, i, CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1, CAD_Topo_FCove.which))
        IfCondition EqualTo(CAD_Topo.FCoveGet(288, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(348, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveMapTh {
    Input: old_v: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.k = Add(i, 1)
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(old_v, CAD_Topo.FCoveGet(12, i)), 1) ThenBlock: {
            ReturnValue(CAD_Topo.FCoveGet(432, i))
        }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(old_v, CAD_Topo.FCoveGet(24, i)), 1) ThenBlock: {
            ReturnValue(CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k))
        }
        ReturnValue(CAD_Topo.FCoveGet(432, i))
    }
}

Function.CAD_Topo.FCoveMapPp {
    Input: old_v: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.k = Add(i, 1)
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(old_v, CAD_Topo.FCoveGet(12, i)), 1) ThenBlock: {
            ReturnValue(CAD_Topo.FCoveGet(276, i))
        }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(old_v, CAD_Topo.FCoveGet(24, i)), 1) ThenBlock: {
            ReturnValue(CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k))
        }
        ReturnValue(CAD_Topo.FCoveGet(276, i))
    }
}

Function.CAD_Topo.FCoveSwapHost {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.host_f, CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i))
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            CAD_Topo_FCove.which = CAD_Topo.FCoveMapTh(CAD_Topo_FCove.orig, CAD_Topo_FCove.i)
            CAD_Topo_FCove.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i), CAD_Topo_FCove.which)
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo.FCoveSet(444, CAD_Topo_FCove.i, CAD_Topo_FCove.ce)
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveSwapVertCe {
    Input: ce_h: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ce_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.e = CAD_Store.Read(ce_h, 0)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.e, CAD_Topo.FCoveGet(324, i)) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.which, 0), 1) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.edx, 0), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.edy, 0), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.edz, 0), 1) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.k = Add(i, 1)
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
        CAD_Topo_FCove.j = i
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.v0, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)), 1) ThenBlock: { CAD_Topo_FCove.j = CAD_Topo_FCove.k }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.v1, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)), 1) ThenBlock: { CAD_Topo_FCove.j = CAD_Topo_FCove.k }
        CAD_Topo_FCove.orig = CAD_Store.Read(ce_h, 5)
        CAD_Topo_FCove.which = CAD_Topo_FCove.orig
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.j)), 1) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.j)
        }
        IfCondition EqualTo(CAD_Topo.CoedgeSwapEdge(ce_h, CAD_Topo.FCoveGet(288, CAD_Topo_FCove.j), CAD_Topo_FCove.which), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveSwapWall {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, i)
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f2, CAD_Topo.FCoveGet(0, i))
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
        CAD_Topo_FCove.which = CAD_Topo.FCoveMapPp(CAD_Topo_FCove.orig, i)
        CAD_Topo_FCove.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo.FCoveGet(324, i), CAD_Topo_FCove.which)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
        CAD_Topo_FCove.prv = CAD_Store.Read(CAD_Topo_FCove.ce, 3)
        IfCondition EqualTo(CAD_Topo.FCoveSwapVertCe(CAD_Topo_FCove.nxt, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveSwapVertCe(CAD_Topo_FCove.prv, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveMakeJoinFace {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.k = Add(i, 1)
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
        ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(312, i), CAD_Topo.FCoveGet(432, i)))
        CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(348, CAD_Topo_FCove.k)
        CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k)
        IfCondition EqualTo(CAD_Topo.FCoveGet(384, CAD_Topo_FCove.k), 1) ThenBlock: {
            CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(396, CAD_Topo_FCove.k)
            CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(390, CAD_Topo_FCove.k)
        }
        ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k)))
        ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(324, i), CAD_Topo_FCove.v1))
        ArraySet(CAD_Topo_FCove.ring, 3, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(348, i), CAD_Topo.FCoveGet(276, i)))
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 3), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 4, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.f1 = CAD_Topo.MakeFace(CAD_Topo.FCoveGet(300, i), CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.f1)
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveMakeSphereFace {
    Input: i: Integer
    Output: Integer
    Body: {
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveMakeCollarFace {
    Input: i: Integer
    Output: Integer
    Body: {
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveUnlinkOld {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                CAD_Store.Write(CAD_Topo_FCove.e, 3, 0)
                CAD_Store.Write(CAD_Topo_FCove.e, 4, 0)
            }
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(60, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                CAD_Store.Write(CAD_Topo_FCove.e, 3, 0)
                CAD_Store.Write(CAD_Topo_FCove.e, 4, 0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveFindPadTop {
    Output: Integer
    Body: {
        CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, 0)
        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.f2, 1)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.hd = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        CAD_Topo_FCove.ce = CAD_Topo_FCove.hd
        CAD_Topo_FCove.g = 0
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, 0)
        WhileLoop LessThan(CAD_Topo_FCove.g, 16) {
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
            IfCondition NotEqual(CAD_Topo_FCove.which, CAD_Topo_FCove.e) ThenBlock: {
                CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.which, 0)
                CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.which, 1)
                IfCondition NotEqual(CAD_Topo_FCove.v0, 0) ThenBlock: {
                    CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2))
                    IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.edz, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.which, CAD_Topo_FCove.faces), 0) ThenBlock: {
                            CAD_Topo_FCove.aa = ArrayGet(CAD_Topo_FCove.faces, 0)
                            CAD_Topo_FCove.bb = ArrayGet(CAD_Topo_FCove.faces, 1)
                            CAD_Topo_FCove.pad_top_f = CAD_Topo_FCove.bb
                            IfCondition EqualTo(CAD_Topo_FCove.aa, CAD_Topo_FCove.f2) ThenBlock: {
                                CAD_Topo_FCove.pad_top_f = CAD_Topo_FCove.bb
                            }
                            IfCondition EqualTo(CAD_Topo_FCove.bb, CAD_Topo_FCove.f2) ThenBlock: {
                                CAD_Topo_FCove.pad_top_f = CAD_Topo_FCove.aa
                            }
                            ReturnValue(1)
                        }
                    }
                }
            }
            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
            IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 16 }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.FilletJoinCoveCycle {
    Input: solid_handle: Integer
    Input: horiz_addr: Address
    Input: n_horiz: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(horiz_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_horiz, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_horiz, 12) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.solid = solid_handle
        CAD_Topo_FCove.r = radius_r
        CAD_Topo_FCove.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FCoveSet(0, 0, ArrayGet(horiz_addr, 0))
        IfCondition EqualTo(CAD_Topo.FCoveWalkFill(), 0) ThenBlock: {
            PrintMessage("fillet join-cove walk FAIL\n")
            CAD_Topo_State.fillet_reason = 3
            ReturnValue(0)
        }
        CAD_Topo_FCove.n = CAD_Topo.FCoveGet(456, 0)
        CAD_Topo_FCove.i = 0
        CAD_Topo_FCove.minlen = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveFillJoin(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        CAD_Topo.FCoveFindPadTop()
        CAD_Topo_FCove.padh = CAD_Topo_FCove.minlen
        IfCondition NotEqual(CAD_Topo_FCove.pad_top_f, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.host_f, CAD_Topo_FCove.pl), 0) ThenBlock: {
                CAD_Topo_FCove.n1x = ArrayGet(CAD_Topo_FCove.pl, 10)
                CAD_Topo_FCove.n1y = ArrayGet(CAD_Topo_FCove.pl, 11)
                CAD_Topo_FCove.n1z = ArrayGet(CAD_Topo_FCove.pl, 12)
                CAD_Topo_FCove.cx = ArrayGet(CAD_Topo_FCove.pl, 1)
                CAD_Topo_FCove.cy = ArrayGet(CAD_Topo_FCove.pl, 2)
                CAD_Topo_FCove.cz = ArrayGet(CAD_Topo_FCove.pl, 3)
                IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.pad_top_f, CAD_Topo_FCove.pl), 0) ThenBlock: {
                    CAD_Topo_FCove.aa = Float_Sub(ArrayGet(CAD_Topo_FCove.pl, 1), CAD_Topo_FCove.cx)
                    CAD_Topo_FCove.bb = Float_Sub(ArrayGet(CAD_Topo_FCove.pl, 2), CAD_Topo_FCove.cy)
                    CAD_Topo_FCove.ln = Float_Sub(ArrayGet(CAD_Topo_FCove.pl, 3), CAD_Topo_FCove.cz)
                    CAD_Topo_FCove.padh = Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.n1x), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.n1y)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.padh), 1) ThenBlock: { CAD_Topo_FCove.padh = Float_Sub(0, CAD_Topo_FCove.padh) }
                }
            }
        }
        CAD_Topo_FCove.ab = Float_Mul(CAD_Topo_FCove.minlen, 0x3FE0000000000000)
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.ab, CAD_Topo_FCove.r), 1) ThenBlock: {
            PrintMessage("fillet join-cove R too big vs join\n")
            CAD_Topo_State.fillet_reason = 6
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.padh, CAD_Topo_FCove.r), 1) ThenBlock: {
            PrintMessage("fillet join-cove R too big vs pad\n")
            CAD_Topo_State.fillet_reason = 6
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveSolveCorner(CAD_Topo_FCove.i), 0) ThenBlock: {
                PrintMessage("fillet join-cove Gram FAIL\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveMakeJoinGeom(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveMakeCornerGeom(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.FCoveSwapHost(), 0) ThenBlock: {
            PrintMessage("fillet join-cove host swap FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveSwapWall(CAD_Topo_FCove.i), 0) ThenBlock: {
                PrintMessage("fillet join-cove wall swap FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveMakeJoinFace(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        CAD_Topo.FCoveUnlinkOld()
        PrintMessage("fillet join-cove ok n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        ReturnValue(CAD_Topo_FCove.solid)
    }
}

// Class 6: plane–cyl inner CIRCLE → quarter-torus cove weld.
// Host hole grows to r+R, wall shortens by R, one torus face.
Function.CAD_Topo.FilletBossBaseCove {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        PrintMessage("fillet plane-cyl join class=")
        PrintNumber(CAD_Topo_State.fillet_class)
        PrintMessage("\n")
        CAD_Topo_FCove.solid = solid_handle
        CAD_Topo_FCove.e = edge_handle
        CAD_Topo_FCove.r = radius_r
        CAD_Topo_FCove.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.orig = CAD_Store.Read(edge_handle, 2)
        IfCondition EqualTo(CAD_Topo_FCove.orig, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.orig, 0), 2) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.d13 = CAD_Topo.EdgeIsInnerLoop(edge_handle)
        CAD_Topo_FCove.v0 = CAD_Store.Read(edge_handle, 0)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_FCove.orig, 10)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.aa, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(edge_handle, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.f1 = ArrayGet(CAD_Topo_FCove.faces, 0)
        CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 1)
        CAD_Topo_FCove.host_f = 0
        IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.f1, CAD_Topo_FCove.pl), 0) ThenBlock: {
            CAD_Topo_FCove.host_f = CAD_Topo_FCove.f1
            CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.f2, CAD_Topo_FCove.pl), 0) ThenBlock: {
                CAD_Topo_FCove.host_f = CAD_Topo_FCove.f2
                CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 0)
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: {
            PrintMessage("fillet plane-cyl no host plane\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.host_f, CAD_Topo_FCove.pl), 0) ThenBlock: {
            CAD_Topo_FCove.n1x = ArrayGet(CAD_Topo_FCove.pl, 10)
            CAD_Topo_FCove.n1y = ArrayGet(CAD_Topo_FCove.pl, 11)
            CAD_Topo_FCove.n1z = ArrayGet(CAD_Topo_FCove.pl, 12)
            CAD_Topo_FCove.n3x = CAD_Topo_FCove.n1x
            CAD_Topo_FCove.n3y = CAD_Topo_FCove.n1y
            CAD_Topo_FCove.n3z = CAD_Topo_FCove.n1z
        }
        CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.orig, 1)
        CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.orig, 2)
        CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.orig, 3)
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.edx, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.edy, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.edz, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f2, edge_handle)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.nxt = 0
        CAD_Topo_FCove.orig = CAD_Topo.FilletBossFindGen(CAD_Topo_FCove.ce, CAD_Topo_FCove.v0)
        IfCondition EqualTo(CAD_Topo_FCove.orig, 0) ThenBlock: {
            PrintMessage("fillet plane-cyl no gen\n")
            ReturnValue(0)
        }
        CAD_Topo_FCove.nxt = CAD_Topo_FCove.orig
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.nxt, 0)
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.v0) ThenBlock: {
            CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.nxt, 1)
        }
        // Wall generator vs host outward:
        //   into host + inner loop → hole ID (−n1, +n2, r+R)
        //   into host + outer loop → convex OD (−n1, −n2, r−R)
        //   out of host → boss cove (+n1, +n2, r+R)
        CAD_Topo_FCove.padh = Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0)), CAD_Topo_FCove.n1x), Float_Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1)), CAD_Topo_FCove.n1y)), Float_Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2)), CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.s = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.padh), 1) ThenBlock: {
            CAD_Topo_FCove.s = 1
            CAD_Topo_FCove.padh = Float_Sub(0, CAD_Topo_FCove.padh)
        }
        IfCondition EqualTo(CAD_Topo_FCove.s, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FCove.d13, 0) ThenBlock: {
                CAD_Topo_FCove.s = 2
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.s, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.aa, CAD_Topo_FCove.r), 1) ThenBlock: {
                PrintMessage("fillet boss-base R>=r\n")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.s, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.aa, CAD_Topo_FCove.r), 1) ThenBlock: {
                PrintMessage("fillet outer-od R>=r\n")
                ReturnValue(0)
            }
        }
        IfCondition GreaterThan(CAD_Topo_FCove.s, 0) ThenBlock: {
            CAD_Topo_FCove.n1x = Float_Sub(0, CAD_Topo_FCove.n1x)
            CAD_Topo_FCove.n1y = Float_Sub(0, CAD_Topo_FCove.n1y)
            CAD_Topo_FCove.n1z = Float_Sub(0, CAD_Topo_FCove.n1z)
        }
        IfCondition EqualTo(CAD_Topo_FCove.s, 1) ThenBlock: {
            PrintMessage("fillet hole-id n1 flip\n")
        }
        IfCondition EqualTo(CAD_Topo_FCove.s, 2) ThenBlock: {
            CAD_Topo_FCove.n2x = Float_Sub(0, CAD_Topo_FCove.n2x)
            CAD_Topo_FCove.n2y = Float_Sub(0, CAD_Topo_FCove.n2y)
            CAD_Topo_FCove.n2z = Float_Sub(0, CAD_Topo_FCove.n2z)
            PrintMessage("fillet outer-od n1n2 flip\n")
        }
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.padh, CAD_Topo_FCove.r), 1) ThenBlock: {
            PrintMessage("fillet boss-base R>=h\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.FilletBossMakeGeom(), 0) ThenBlock: { ReturnValue(0) }
        PrintMessage("fillet boss-base torus ok\n")
        ReturnValue(CAD_Topo_FCove.solid)
    }
}

Function.CAD_Topo.FilletBossFindGen {
    Input: start_ce: Integer
    Input: v_join: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.ce = start_ce
        CAD_Topo_FCove.k = 0
        WhileLoop LessThan(CAD_Topo_FCove.k, 6) {
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                CAD_Topo_FCove.ln = CAD_Store.Read(CAD_Topo_FCove.which, 2)
                IfCondition NotEqual(CAD_Topo_FCove.ln, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.ln, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.which, 0), v_join) ThenBlock: {
                            ReturnValue(CAD_Topo_FCove.which)
                        }
                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.which, 1), v_join) ThenBlock: {
                            ReturnValue(CAD_Topo_FCove.which)
                        }
                    }
                }
            }
            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.k = 6 }
            IfCondition EqualTo(CAD_Topo_FCove.ce, start_ce) ThenBlock: { CAD_Topo_FCove.k = 6 }
            CAD_Topo_FCove.k = Add(CAD_Topo_FCove.k, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.FilletBossMakeGeom {
    Output: Integer
    Body: {
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 0), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 1), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 2), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2z)))
        CAD_Topo_FCove.ok = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 0), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 1), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 2), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1z)))
        CAD_Topo_FCove.hit = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 12) {
            ArraySet(CAD_Topo_FCove.frame, CAD_Topo_FCove.g, 0)
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Store.Read(CAD_Topo_FCove.ok, 2))
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Store.Read(CAD_Topo_FCove.which, 4))
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Store.Read(CAD_Topo_FCove.which, 5))
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Store.Read(CAD_Topo_FCove.which, 6))
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Store.Read(CAD_Topo_FCove.which, 7))
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Store.Read(CAD_Topo_FCove.which, 8))
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Store.Read(CAD_Topo_FCove.which, 9))
        CAD_Topo_FCove.ab = Float_Add(CAD_Topo_FCove.aa, CAD_Topo_FCove.r)
        IfCondition EqualTo(CAD_Topo_FCove.s, 2) ThenBlock: {
            CAD_Topo_FCove.ab = Float_Sub(CAD_Topo_FCove.aa, CAD_Topo_FCove.r)
        }
        CAD_Topo_FCove.wa = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab)
        CAD_Store.Write(CAD_Topo_FCove.wa, 12, 0x401921FB54442D18)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Store.Read(CAD_Topo_FCove.hit, 2))
        CAD_Topo_FCove.wb = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.aa)
        CAD_Store.Write(CAD_Topo_FCove.wb, 12, 0x401921FB54442D18)
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Store.Read(CAD_Topo_FCove.hit, 2))
        ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FCove.n3x)
        ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FCove.n3y)
        ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FCove.n3z)
        CAD_Topo_FCove.kind = CAD_Geom.MakeTorusSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab, CAD_Topo_FCove.r)
        ArraySet(CAD_Topo_FCove.frame, 0, Float_Add(CAD_Store.Read(CAD_Topo_FCove.ok, 0), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1x)))
        ArraySet(CAD_Topo_FCove.frame, 1, Float_Add(CAD_Store.Read(CAD_Topo_FCove.ok, 1), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1y)))
        ArraySet(CAD_Topo_FCove.frame, 2, Float_Add(CAD_Store.Read(CAD_Topo_FCove.ok, 2), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1z)))
        ArraySet(CAD_Topo_FCove.frame, 3, Float_Sub(0, CAD_Topo_FCove.n2x))
        ArraySet(CAD_Topo_FCove.frame, 4, Float_Sub(0, CAD_Topo_FCove.n2y))
        ArraySet(CAD_Topo_FCove.frame, 5, Float_Sub(0, CAD_Topo_FCove.n2z))
        ArraySet(CAD_Topo_FCove.frame, 6, Float_Sub(0, CAD_Topo_FCove.n1x))
        ArraySet(CAD_Topo_FCove.frame, 7, Float_Sub(0, CAD_Topo_FCove.n1y))
        ArraySet(CAD_Topo_FCove.frame, 8, Float_Sub(0, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.minlen = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
        CAD_Topo_FCove.bb = CAD_Topo.MakeEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.ok, CAD_Topo_FCove.wa)
        CAD_Topo_FCove.sn = CAD_Topo.MakeEdge(CAD_Topo_FCove.hit, CAD_Topo_FCove.hit, CAD_Topo_FCove.wb)
        CAD_Topo_FCove.lp = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.hit, CAD_Topo_FCove.minlen)
        IfCondition EqualTo(CAD_Topo_FCove.bb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.sn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletBossSwap(), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletBossSwap {
    Output: Integer
    Body: {
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.host_f, CAD_Topo_FCove.e)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo_FCove.bb, CAD_Topo_FCove.ok)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f2, CAD_Topo_FCove.e)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo_FCove.sn, CAD_Topo_FCove.hit)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.prv = CAD_Topo_FCove.ce
        CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.nxt, CAD_Topo_FCove.v0, CAD_Topo_FCove.hit)
        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.nxt, 2)
        IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.which, 0), 1) ThenBlock: {
                CAD_Store.Write(CAD_Topo_FCove.which, 1, CAD_Store.Read(CAD_Topo_FCove.hit, 0))
                CAD_Store.Write(CAD_Topo_FCove.which, 2, CAD_Store.Read(CAD_Topo_FCove.hit, 1))
                CAD_Store.Write(CAD_Topo_FCove.which, 3, CAD_Store.Read(CAD_Topo_FCove.hit, 2))
                CAD_Store.Write(CAD_Topo_FCove.which, 4, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 0), CAD_Store.Read(CAD_Topo_FCove.hit, 0)))
                CAD_Store.Write(CAD_Topo_FCove.which, 5, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 1), CAD_Store.Read(CAD_Topo_FCove.hit, 1)))
                CAD_Store.Write(CAD_Topo_FCove.which, 6, Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Store.Read(CAD_Topo_FCove.hit, 2)))
            }
        }
        CAD_Topo_FCove.wa = CAD_Topo.MakeCoedge(CAD_Topo_FCove.bb, CAD_Topo_FCove.ok, 0)
        CAD_Topo_FCove.wb = CAD_Topo.MakeCoedge(CAD_Topo_FCove.sn, CAD_Topo_FCove.hit, 0)
        CAD_Topo.LinkTwins(CAD_Topo_FCove.hd, CAD_Topo_FCove.wa)
        CAD_Topo.LinkTwins(CAD_Topo_FCove.prv, CAD_Topo_FCove.wb)
        CAD_Store.Write(CAD_Topo_FCove.bb, 4, CAD_Topo_FCove.wa)
        CAD_Store.Write(CAD_Topo_FCove.sn, 4, CAD_Topo_FCove.wb)
        CAD_Topo_FCove.aa = CAD_Topo.MakeCoedge(CAD_Topo_FCove.lp, CAD_Topo_FCove.ok, 1)
        CAD_Topo_FCove.bb = CAD_Topo.MakeCoedge(CAD_Topo_FCove.lp, CAD_Topo_FCove.hit, 0)
        CAD_Topo.LinkTwins(CAD_Topo_FCove.aa, CAD_Topo_FCove.bb)
        CAD_Store.Write(CAD_Topo_FCove.lp, 3, CAD_Topo_FCove.aa)
        CAD_Store.Write(CAD_Topo_FCove.lp, 4, CAD_Topo_FCove.bb)
        ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo_FCove.wa)
        ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo_FCove.aa)
        ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo_FCove.wb)
        ArraySet(CAD_Topo_FCove.ring, 3, CAD_Topo_FCove.bb)
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(CAD_Topo_FCove.wa)
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 4, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.which = CAD_Topo.MakeFace(CAD_Topo_FCove.kind, CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.which), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}
