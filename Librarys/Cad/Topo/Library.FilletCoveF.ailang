LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.FCoveMakeJoinFace {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.k = Add(CAD_Topo_FCove.i, 1)
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
        // Meet on the host rail, not the original edge. RimSwap retargets
        // that edge. An open chain (verticals under a spring) does not wrap:
        // joining the last segment to the first stretches the cylinder
        // across the solid.
        CAD_Topo_FCove.hit = 0
        IfCondition NotEqual(CAD_Topo_FCove.k, CAD_Topo_FCove.i) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i)
            CAD_Topo_FCove.v0 = 0
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)) ThenBlock: {
                    CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                }
            }
            IfCondition NotEqual(CAD_Topo_FCove.v0, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k)) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                IfCondition NotEqual(CAD_Topo.FCoveGet(408, CAD_Topo_FCove.k), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo.FCoveGet(408, CAD_Topo_FCove.k)) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                }
                IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k)) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                IfCondition NotEqual(CAD_Topo.FCoveGet(480, CAD_Topo_FCove.k), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo.FCoveGet(480, CAD_Topo_FCove.k)) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                }
            }
        }
        CAD_Topo_FCove.which = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i)
        IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: { CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 0) }
        ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.e, CAD_Topo_FCove.which))
        IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
            // Slot 396 is the corner curve only when it touches the next
            // start (cope ellipse, sphere arc). An open edge keeps its far
            // cap there too; that cap is the other end of the edge.
            CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(396, CAD_Topo_FCove.k)
            IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
                CAD_Topo_FCove.ok1 = 0
                IfCondition NotEqual(CAD_Topo.FCoveEdgeHasVert(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k)), 0) ThenBlock: { CAD_Topo_FCove.ok1 = 1 }
                IfCondition NotEqual(CAD_Topo.FCoveGet(408, CAD_Topo_FCove.k), 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo.FCoveEdgeHasVert(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(408, CAD_Topo_FCove.k)), 0) ThenBlock: { CAD_Topo_FCove.ok1 = 1 }
                }
                IfCondition EqualTo(CAD_Topo_FCove.ok1, 0) ThenBlock: { CAD_Topo_FCove.orig = 0 }
            }
            IfCondition EqualTo(CAD_Topo_FCove.orig, 0) ThenBlock: { CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(348, CAD_Topo_FCove.k) }
            CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.k)
            IfCondition EqualTo(CAD_Topo_FCove.v1, 0) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k) }
            // Host rail meets k's wall contact, not the plan-corner drop.
            // The Th–Tw arc is that corner; the drop digon would gap.
            CAD_Topo_FCove.wa = CAD_Topo.FCoveSharedCap(CAD_Topo_FCove.i, CAD_Topo_FCove.k)
            IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: {
                CAD_Topo_FCove.v1 = CAD_Topo_FCove.wa
                CAD_Topo_FCove.wa = CAD_Topo.FCoveGet(288, CAD_Topo_FCove.k)
                IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: { CAD_Topo_FCove.orig = CAD_Topo_FCove.wa }
            }
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(408, CAD_Topo_FCove.k)
            IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k) }
            IfCondition EqualTo(CAD_Topo.FCoveHostWallFlip(i, CAD_Topo_FCove.k), 1) ThenBlock: {
                CAD_Topo_FCove.wa = CAD_Topo_FCove.ok
                CAD_Topo_FCove.ok = CAD_Topo_FCove.v1
                CAD_Topo_FCove.v1 = CAD_Topo_FCove.wa
            }
            IfCondition EqualTo(CAD_Topo.FCoveGet(336, CAD_Topo_FCove.i), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveGet(336, CAD_Topo_FCove.k), 0) ThenBlock: {
                    CAD_Topo_FCove.n1x = CAD_Topo.FCoveGet(84, CAD_Topo_FCove.i)
                    CAD_Topo_FCove.n1y = CAD_Topo.FCoveGet(96, CAD_Topo_FCove.i)
                    CAD_Topo_FCove.n1z = CAD_Topo.FCoveGet(108, CAD_Topo_FCove.i)
                    CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(264, CAD_Topo_FCove.i)
                    CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k)
                    CAD_Topo_FCove.orig = CAD_Topo.FilletMerThrough(CAD_Topo_FCove.ok, CAD_Topo_FCove.v1)
                    CAD_Topo.FCoveSet(396, CAD_Topo_FCove.i, CAD_Topo_FCove.orig)
                }
            }
            CAD_Topo_FCove.hit1 = CAD_Topo.FCoveGet(492, CAD_Topo_FCove.k)
            IfCondition NotEqual(CAD_Topo_FCove.hit1, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
                    CAD_Topo_FCove.ok1 = 0
                    CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.orig, 0)
                    IfCondition EqualTo(CAD_Topo_FCove.e, CAD_Topo_FCove.hit1) ThenBlock: { CAD_Topo_FCove.ok1 = 1 }
                    CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.orig, 1)
                    IfCondition EqualTo(CAD_Topo_FCove.e, CAD_Topo_FCove.hit1) ThenBlock: { CAD_Topo_FCove.ok1 = 1 }
                    IfCondition EqualTo(CAD_Topo_FCove.ok1, 1) ThenBlock: {
                        CAD_Topo_FCove.v1 = CAD_Topo_FCove.hit1
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo.FilletSplitLineCorner(CAD_Topo_FCove.i, CAD_Topo_FCove.k), 1) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i)
                CAD_Topo_FCove.ok = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                    IfCondition EqualTo(CAD_Topo_FCove.ok, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)) ThenBlock: {
                        CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                    }
                }
                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i)
                CAD_Topo_FCove.wa = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    CAD_Topo_FCove.wa = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                    IfCondition EqualTo(CAD_Topo_FCove.wa, CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)) ThenBlock: {
                        CAD_Topo_FCove.wa = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                    }
                }
                IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: {
                        CAD_Topo.FilletEmitLoadHostN(CAD_Topo_FCove.i)
                        CAD_Topo_FCove.e = CAD_Topo.FilletMerThrough(CAD_Topo_FCove.ok, CAD_Topo_FCove.wa)
                        IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                            CAD_Topo_FCove.orig = CAD_Topo_FCove.e
                            CAD_Topo.FCoveSet(396, CAD_Topo_FCove.i, CAD_Topo_FCove.orig)
                            CAD_Topo_FCove.v1 = CAD_Topo_FCove.wa
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
            CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i)
            CAD_Topo_FCove.ok = 0
            CAD_Topo_FCove.v1 = 0
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                IfCondition EqualTo(CAD_Topo_FCove.ok, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)) ThenBlock: { CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.e, 1) }
            }
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1) }
            }
            CAD_Topo_FCove.hit = 0
            IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.orig, 0), CAD_Topo_FCove.ok) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.orig, 1), CAD_Topo_FCove.ok) ThenBlock: { CAD_Topo_FCove.hit = 1 }
            }
            IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                CAD_Topo_FCove.hit = 0
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.orig, 0), CAD_Topo_FCove.v1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.orig, 1), CAD_Topo_FCove.v1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
            }
            IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
                CAD_Topo_FCove.orig = CAD_Topo.FilletMerThrough(CAD_Topo_FCove.ok, CAD_Topo_FCove.v1)
                CAD_Topo.FCoveSet(396, CAD_Topo_FCove.i, CAD_Topo_FCove.orig)
            }
        }
        IfCondition EqualTo(CAD_Topo.FCoveGet(336, CAD_Topo_FCove.i), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FCoveGet(336, CAD_Topo_FCove.k), 1) ThenBlock: {
                CAD_Topo_FCove.n1x = CAD_Topo.FCoveGet(84, CAD_Topo_FCove.i)
                CAD_Topo_FCove.n1y = CAD_Topo.FCoveGet(96, CAD_Topo_FCove.i)
                CAD_Topo_FCove.n1z = CAD_Topo.FCoveGet(108, CAD_Topo_FCove.i)
                CAD_Topo.FCoveSet(348, CAD_Topo_FCove.i, CAD_Topo.FilletMerThrough(CAD_Topo.FCoveGet(240, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)))
            }
        }
        IfCondition EqualTo(CAD_Topo.FCoveGet(348, CAD_Topo_FCove.i), 0) ThenBlock: {
            CAD_Topo.FCoveSet(348, CAD_Topo_FCove.i, CAD_Topo.FilletMerThrough(CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)))
        }
        CAD_Topo_FCove.wb = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.i)
        IfCondition EqualTo(CAD_Topo_FCove.wb, 0) ThenBlock: { CAD_Topo_FCove.wb = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i) }
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(348, CAD_Topo_FCove.i)
        IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
            CAD_Topo_FCove.ok1 = 0
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.wb) ThenBlock: { CAD_Topo_FCove.ok1 = 1 }
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.wb) ThenBlock: { CAD_Topo_FCove.ok1 = 1 }
            IfCondition EqualTo(CAD_Topo_FCove.ok1, 0) ThenBlock: {
                CAD_Topo_FCove.wb = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)
            }
        }
        ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.orig, CAD_Topo_FCove.ok))
        ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i), CAD_Topo_FCove.v1))
        ArraySet(CAD_Topo_FCove.ring, 3, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(348, CAD_Topo_FCove.i), CAD_Topo_FCove.wb))
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 0), 0) ThenBlock: {
            CAD_Topo.FilletDumpI("fillet join ring0=0 i=", 21, CAD_Topo_FCove.i)
            CAD_Topo.FilletDumpS("\n", 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 3), 0) ThenBlock: {
            CAD_Topo.FilletDumpI("fillet join ring3=0 i=", 21, CAD_Topo_FCove.i)
            CAD_Topo.FilletDumpS("\n", 1)
            ReturnValue(0)
        }
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 4, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.f1 = CAD_Topo.MakeFace(CAD_Topo.FCoveGet(300, CAD_Topo_FCove.i), CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.f1)
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveFootOne {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveFillJoin(i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveSolveCorner(i), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = CAD_Topo.FCoveGet(84, i)
        CAD_Topo_FCove.n1y = CAD_Topo.FCoveGet(96, i)
        CAD_Topo_FCove.n1z = CAD_Topo.FCoveGet(108, i)
        CAD_Topo_FCove.n2x = CAD_Topo.FCoveGet(120, i)
        CAD_Topo_FCove.n2y = CAD_Topo.FCoveGet(132, i)
        CAD_Topo_FCove.n2z = CAD_Topo.FCoveGet(144, i)
        CAD_Topo.FCoveSet(240, i, CAD_Topo.FCovePickT(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n1y, CAD_Topo_FCove.n1z))
        CAD_Topo.FCoveSet(276, i, CAD_Topo.FCovePickT(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2z))
        CAD_Topo.FCoveSet(252, i, CAD_Topo.FCoveGet(276, i))
        CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(24, i)
        CAD_Topo_FCove.ab = CAD_Topo.FCoveGet(192, i)
        CAD_Topo_FCove.cx = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 0), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n2x)))
        CAD_Topo_FCove.cy = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 1), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n2y)))
        CAD_Topo_FCove.cz = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 2), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n2z)))
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2z)))
        CAD_Topo.FCoveSet(480, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        IfCondition EqualTo(CAD_Topo.FCoveGet(240, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(264, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(276, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(480, i), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FCoveSet(312, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(240, i), CAD_Topo.FCoveGet(264, i)))
        CAD_Topo.FCoveSet(324, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(480, i), CAD_Topo.FCoveGet(276, i)))
        CAD_Topo_FCove.edx = CAD_Topo.FCoveGet(156, i)
        CAD_Topo_FCove.edy = CAD_Topo.FCoveGet(168, i)
        CAD_Topo_FCove.edz = CAD_Topo.FCoveGet(180, i)
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo.FCoveGet(204, i))
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo.FCoveGet(216, i))
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo.FCoveGet(228, i))
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
        CAD_Topo_FCove.aa = Float_Sub(Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.n1z), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.n1y))
        CAD_Topo_FCove.bb = Float_Sub(Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.n1x), Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.ln = Float_Sub(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.n1y), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.n1x))
        CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.aa), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.bb)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.ln)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
            CAD_Topo_FCove.aa = Float_Div(CAD_Topo_FCove.aa, CAD_Topo_FCove.ab)
            CAD_Topo_FCove.bb = Float_Div(CAD_Topo_FCove.bb, CAD_Topo_FCove.ab)
            CAD_Topo_FCove.ln = Float_Div(CAD_Topo_FCove.ln, CAD_Topo_FCove.ab)
        }
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.aa)
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.bb)
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.ln)
        ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FCove.edx)
        ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FCove.edy)
        ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FCove.edz)
        CAD_Topo.FCoveSet(300, i, CAD_Geom.MakeCylinderSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.r))
        CAD_Topo_FCove.cx = CAD_Topo_FVert.cx
        CAD_Topo_FCove.cy = CAD_Topo_FVert.cy
        CAD_Topo_FCove.cz = CAD_Topo_FVert.cz
        CAD_Topo.FCoveSet(348, i, CAD_Topo.FCoveMakeArc(CAD_Topo.FCoveGet(240, i), CAD_Topo.FCoveGet(276, i)))
        CAD_Topo_FCove.n1x = CAD_Topo.FCoveGet(84, i)
        CAD_Topo_FCove.n1y = CAD_Topo.FCoveGet(96, i)
        CAD_Topo_FCove.n1z = CAD_Topo.FCoveGet(108, i)
        CAD_Topo.FCoveSet(396, i, CAD_Topo.FilletMerThrough(CAD_Topo.FCoveGet(264, i), CAD_Topo.FCoveGet(480, i)))
        IfCondition EqualTo(CAD_Topo.FCoveGet(312, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(324, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(300, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(348, i), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(312, i), CAD_Topo.FCoveGet(240, i)))
        ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(396, i), CAD_Topo.FCoveGet(264, i)))
        ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(324, i), CAD_Topo.FCoveGet(480, i)))
        ArraySet(CAD_Topo_FCove.ring, 3, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(348, i), CAD_Topo.FCoveGet(276, i)))
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 3), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 4, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.f1 = CAD_Topo.MakeFace(CAD_Topo.FCoveGet(300, i), CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.f1)
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo.FCoveGet(36, i), CAD_Topo.FCoveGet(0, i))
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            CAD_Topo_FCove.which = CAD_Topo.FCoveGet(240, i)
            IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(24, i)), 1) ThenBlock: {
                CAD_Topo_FCove.which = CAD_Topo.FCoveGet(264, i)
            }
            CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo.FCoveGet(312, i), CAD_Topo_FCove.which)
        }
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo.FCoveGet(48, i), CAD_Topo.FCoveGet(0, i))
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            CAD_Topo_FCove.which = CAD_Topo.FCoveGet(276, i)
            IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(24, i)), 1) ThenBlock: {
                CAD_Topo_FCove.which = CAD_Topo.FCoveGet(480, i)
            }
            CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo.FCoveGet(324, i), CAD_Topo_FCove.which)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveMakeUprightGeom {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.k = i
        IfCondition EqualTo(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = CAD_Topo_FCove.n }
        CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.k, 1)
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = CAD_Topo.FCoveGet(84, i)
        CAD_Topo_FCove.n1y = CAD_Topo.FCoveGet(96, i)
        CAD_Topo_FCove.n1z = CAD_Topo.FCoveGet(108, i)
        CAD_Topo_FCove.n2x = CAD_Topo.FCoveGet(120, i)
        CAD_Topo_FCove.n2y = CAD_Topo.FCoveGet(132, i)
        CAD_Topo_FCove.n2z = CAD_Topo.FCoveGet(144, i)
        CAD_Topo_FCove.n3x = CAD_Topo.FCoveGet(120, CAD_Topo_FCove.k)
        CAD_Topo_FCove.n3y = CAD_Topo.FCoveGet(132, CAD_Topo_FCove.k)
        CAD_Topo_FCove.n3z = CAD_Topo.FCoveGet(144, CAD_Topo_FCove.k)
        CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(432, i)
        IfCondition EqualTo(CAD_Topo_FCove.orig, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.cx = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 0), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1x))
        CAD_Topo_FCove.cy = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 1), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1y))
        CAD_Topo_FCove.cz = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 2), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1z))
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2z)))
        CAD_Topo.FCoveSet(276, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        CAD_Topo.FCoveSet(252, i, CAD_Topo.FCoveGet(276, i))
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n3x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n3y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n3z)))
        CAD_Topo.FCoveSet(372, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        CAD_Topo.FCoveSet(480, i, CAD_Topo.FCoveGet(372, i))
        IfCondition EqualTo(CAD_Topo.FCoveGet(276, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(372, i), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(60, i)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        CAD_Topo_FCove.which = CAD_Topo_FCove.v1
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0), 1) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0), 1) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 0)
        }
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ab = Float_Add(0x3FF0000000000000, Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n3x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n3y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n3z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ab = Float_Div(CAD_Topo_FCove.r, CAD_Topo_FCove.ab)
        CAD_Topo_FCove.aa = Float_Add(CAD_Store.Read(CAD_Topo_FCove.which, 0), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n3x)))
        CAD_Topo_FCove.bb = Float_Add(CAD_Store.Read(CAD_Topo_FCove.which, 1), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n3y)))
        CAD_Topo_FCove.ln = Float_Add(CAD_Store.Read(CAD_Topo_FCove.which, 2), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n3z)))
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Topo_FCove.aa, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Topo_FCove.bb, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Topo_FCove.ln, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n2z)))
        CAD_Topo.FCoveSet(360, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Sub(CAD_Topo_FCove.aa, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n3x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Sub(CAD_Topo_FCove.bb, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n3y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Sub(CAD_Topo_FCove.ln, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n3z)))
        CAD_Topo.FCoveSet(420, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        IfCondition EqualTo(CAD_Topo.FCoveGet(360, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(420, i), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FCoveSet(288, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(360, i), CAD_Topo.FCoveGet(276, i)))
        CAD_Topo.FCoveSet(468, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(420, i), CAD_Topo.FCoveGet(372, i)))
        IfCondition EqualTo(CAD_Topo.FCoveGet(288, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(468, i), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.cx = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 0), Float_Mul(CAD_Topo_FCove.r, CAD_Topo.FCoveGet(84, i)))
        CAD_Topo_FCove.cy = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 1), Float_Mul(CAD_Topo_FCove.r, CAD_Topo.FCoveGet(96, i)))
        CAD_Topo_FCove.cz = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 2), Float_Mul(CAD_Topo_FCove.r, CAD_Topo.FCoveGet(108, i)))
        CAD_Topo.FCoveSet(348, i, CAD_Topo.FCoveMakeArc(CAD_Topo.FCoveGet(432, i), CAD_Topo.FCoveGet(276, i)))
        CAD_Topo_FCove.cx = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 0), Float_Mul(CAD_Topo_FCove.r, CAD_Topo.FCoveGet(84, i)))
        CAD_Topo_FCove.cy = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 1), Float_Mul(CAD_Topo_FCove.r, CAD_Topo.FCoveGet(96, i)))
        CAD_Topo_FCove.cz = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 2), Float_Mul(CAD_Topo_FCove.r, CAD_Topo.FCoveGet(108, i)))
        CAD_Topo.FCoveSet(396, i, CAD_Topo.FCoveMakeArc(CAD_Topo.FCoveGet(432, i), CAD_Topo.FCoveGet(372, i)))
        IfCondition EqualTo(CAD_Topo.FCoveGet(348, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(396, i), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FilletDumpI("chain upright i=", 16, i)
        CAD_Topo.FilletDumpU(" C=", 3, CAD_Topo_FCove.cx)
        CAD_Topo.FilletDumpU(",", 1, CAD_Topo_FCove.cy)
        CAD_Topo.FilletDumpU(",", 1, CAD_Topo_FCove.cz)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.CAD_Topo.FCoveEmitUpright {
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo.FCoveGet(336, i), 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.k = i
        IfCondition EqualTo(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = CAD_Topo_FCove.n }
        CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.k, 1)
        CAD_Topo_FCove.n1x = CAD_Topo.FCoveGet(84, i)
        CAD_Topo_FCove.n1y = CAD_Topo.FCoveGet(96, i)
        CAD_Topo_FCove.n1z = CAD_Topo.FCoveGet(108, i)
        CAD_Topo_FCove.n2x = CAD_Topo.FCoveGet(120, i)
        CAD_Topo_FCove.n2y = CAD_Topo.FCoveGet(132, i)
        CAD_Topo_FCove.n2z = CAD_Topo.FCoveGet(144, i)
        CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(432, i)
        CAD_Topo_FCove.cx = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 0), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1x))
        CAD_Topo_FCove.cy = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 1), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1y))
        CAD_Topo_FCove.cz = Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 2), Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(276, i)
        CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(360, i)
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2))
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.edx = Float_Div(CAD_Topo_FCove.edx, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.edy = Float_Div(CAD_Topo_FCove.edy, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.edz = Float_Div(CAD_Topo_FCove.edz, CAD_Topo_FCove.ln)
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n2x)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n2y)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n2z)
        CAD_Topo_FCove.aa = Float_Sub(Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.n2z), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.n2y))
        CAD_Topo_FCove.bb = Float_Sub(Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.n2z))
        CAD_Topo_FCove.ln = Float_Sub(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.n2y), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.n2x))
        CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.aa), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.bb)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.ln)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
            CAD_Topo_FCove.aa = Float_Div(CAD_Topo_FCove.aa, CAD_Topo_FCove.ab)
            CAD_Topo_FCove.bb = Float_Div(CAD_Topo_FCove.bb, CAD_Topo_FCove.ab)
            CAD_Topo_FCove.ln = Float_Div(CAD_Topo_FCove.ln, CAD_Topo_FCove.ab)
        }
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.aa)
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.bb)
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.ln)
        ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FCove.edx)
        ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FCove.edy)
        ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FCove.edz)
        CAD_Topo_FCove.sn = CAD_Geom.MakeCylinderSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
        IfCondition EqualTo(CAD_Topo_FCove.sn, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok = CAD_Topo.FCoveMakeArc(CAD_Topo.FCoveGet(276, i), CAD_Topo.FCoveGet(372, i))
        CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo.FCoveGet(360, i), 0)
        CAD_Topo_FCove.bb = CAD_Store.Read(CAD_Topo.FCoveGet(360, i), 1)
        CAD_Topo_FCove.ln = CAD_Store.Read(CAD_Topo.FCoveGet(360, i), 2)
        CAD_Topo_FCove.n3x = CAD_Topo.FCoveGet(120, i)
        CAD_Topo_FCove.cx = Float_Add(CAD_Topo_FCove.aa, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n3x))
        CAD_Topo_FCove.n3y = CAD_Topo.FCoveGet(132, i)
        CAD_Topo_FCove.cy = Float_Add(CAD_Topo_FCove.bb, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n3y))
        CAD_Topo_FCove.n3z = CAD_Topo.FCoveGet(144, i)
        CAD_Topo_FCove.cz = Float_Add(CAD_Topo_FCove.ln, Float_Mul(CAD_Topo_FCove.r, CAD_Topo_FCove.n3z))
        CAD_Topo_FCove.hit = CAD_Topo.FCoveMakeArc(CAD_Topo.FCoveGet(420, i), CAD_Topo.FCoveGet(360, i))
        IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok1 = CAD_Topo_FCove.ok
        CAD_Topo_FCove.hit1 = CAD_Topo_FCove.sn
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(60, i)
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0), 1) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        }
        IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0), 1) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 0)
        }
        CAD_Topo_FCE.dx = CAD_Topo_FCove.edx
        CAD_Topo_FCE.dy = CAD_Topo_FCove.edy
        CAD_Topo_FCE.dz = CAD_Topo_FCove.edz
        CAD_Topo_FCove.f2 = CAD_Topo.FindFaceWithVert(CAD_Topo_FCove.solid, CAD_Topo_FCove.which, CAD_Topo.FCoveGet(48, i), CAD_Topo.FCoveGet(72, i))
        CAD_Topo_FCove.prv = 0
        CAD_Topo_FCove.ce = 0
        IfCondition NotEqual(CAD_Topo_FCove.f2, 0) ThenBlock: {
            CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.f2, 1)
            IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                CAD_Topo_FCove.hd = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
                CAD_Topo_FCove.ce = CAD_Topo_FCove.hd
                CAD_Topo_FCove.g = 0
                WhileLoop LessThan(CAD_Topo_FCove.g, 32) {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.ce, 5), CAD_Topo_FCove.which) ThenBlock: {
                        CAD_Topo_FCove.prv = CAD_Store.Read(CAD_Topo_FCove.ce, 3)
                        CAD_Topo_FCove.g = 32
                    }
                    IfCondition NotEqual(CAD_Topo_FCove.prv, 0) ThenBlock: { CAD_Topo_FCove.g = 32 }
                    IfCondition EqualTo(CAD_Topo_FCove.prv, 0) ThenBlock: {
                        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                        IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 32 }
                    }
                    CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
                }
            }
        }
        CAD_Topo_FCove.wa = CAD_Topo.FCoveGet(420, i)
        IfCondition NotEqual(CAD_Topo_FCove.prv, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Topo.FindCoedgeOnFace(CAD_Topo.FCoveGet(48, i), CAD_Store.Read(CAD_Topo_FCove.ce, 0)), 0) ThenBlock: {
                CAD_Topo.EdgeRetargetVert(CAD_Store.Read(CAD_Topo_FCove.ce, 0), CAD_Topo_FCove.which, CAD_Topo.FCoveGet(360, i))
                CAD_Topo.EdgeRetargetVert(CAD_Store.Read(CAD_Topo_FCove.prv, 0), CAD_Topo_FCove.which, CAD_Topo.FCoveGet(420, i))
                CAD_Topo_FCove.wa = CAD_Topo.FCoveGet(420, i)
            }
            IfCondition EqualTo(CAD_Topo.FindCoedgeOnFace(CAD_Topo.FCoveGet(48, i), CAD_Store.Read(CAD_Topo_FCove.ce, 0)), 0) ThenBlock: {
                CAD_Topo.EdgeRetargetVert(CAD_Store.Read(CAD_Topo_FCove.ce, 0), CAD_Topo_FCove.which, CAD_Topo.FCoveGet(420, i))
                CAD_Topo.EdgeRetargetVert(CAD_Store.Read(CAD_Topo_FCove.prv, 0), CAD_Topo_FCove.which, CAD_Topo.FCoveGet(360, i))
                CAD_Topo_FCove.wa = CAD_Topo.FCoveGet(360, i)
            }
        }
        CAD_Topo.FCoveRetargetWallTop(CAD_Topo.FCoveGet(48, i), CAD_Topo_FCove.which, CAD_Topo.FCoveGet(360, i), CAD_Topo.FCoveGet(288, i))
        CAD_Topo.FCoveRetargetWallTop(CAD_Topo.FCoveGet(72, i), CAD_Topo_FCove.which, CAD_Topo.FCoveGet(420, i), CAD_Topo.FCoveGet(468, i))
        IfCondition NotEqual(CAD_Topo_FCove.prv, 0) ThenBlock: {
            CAD_Topo_FCove.kind = 1
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.hit, 0), CAD_Topo_FCove.wa) ThenBlock: { CAD_Topo_FCove.kind = 0 }
            CAD_Topo_FCove.nxt = CAD_Topo.MakeCoedge(CAD_Topo_FCove.hit, CAD_Topo_FCove.wa, CAD_Topo_FCove.kind)
            IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.hit, 3), 0) ThenBlock: {
                    CAD_Store.Write(CAD_Topo_FCove.hit, 3, CAD_Topo_FCove.nxt)
                }
                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.hit, 3), CAD_Topo_FCove.nxt) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.hit, 4), 0) ThenBlock: {
                        CAD_Store.Write(CAD_Topo_FCove.hit, 4, CAD_Topo_FCove.nxt)
                        CAD_Topo.LinkTwins(CAD_Store.Read(CAD_Topo_FCove.hit, 3), CAD_Topo_FCove.nxt)
                    }
                }
                CAD_Topo.CoedgeInsertAfter(CAD_Topo_FCove.prv, CAD_Topo_FCove.nxt)
            }
        }
        CAD_Topo_FCove.ok = CAD_Topo_FCove.ok1
        CAD_Topo_FCove.sn = CAD_Topo_FCove.hit1
        CAD_Topo_FCove.wb = CAD_Topo.FCoveGet(360, i)
        IfCondition EqualTo(CAD_Topo_FCove.wa, CAD_Topo.FCoveGet(360, i)) ThenBlock: { CAD_Topo_FCove.wb = CAD_Topo.FCoveGet(420, i) }
        IfCondition EqualTo(CAD_Topo_FCove.wa, CAD_Topo.FCoveGet(420, i)) ThenBlock: {
            ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(288, i), CAD_Topo.FCoveGet(276, i)))
            ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.hit, CAD_Topo_FCove.wb))
            ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(468, i), CAD_Topo.FCoveGet(420, i)))
            ArraySet(CAD_Topo_FCove.ring, 3, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.ok, CAD_Topo.FCoveGet(372, i)))
        }
        IfCondition EqualTo(CAD_Topo_FCove.wa, CAD_Topo.FCoveGet(360, i)) ThenBlock: {
            ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(288, i), CAD_Topo.FCoveGet(360, i)))
            ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.ok, CAD_Topo.FCoveGet(276, i)))
            ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(468, i), CAD_Topo.FCoveGet(372, i)))
            ArraySet(CAD_Topo_FCove.ring, 3, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.hit, CAD_Topo_FCove.wb))
        }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 3), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 4, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.f1 = CAD_Topo.MakeFace(CAD_Topo_FCove.sn, CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.f1)
        CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(432, i)
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 0), Float_Mul(CAD_Topo_FCove.r, CAD_Topo.FCoveGet(84, i))))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 1), Float_Mul(CAD_Topo_FCove.r, CAD_Topo.FCoveGet(96, i))))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Store.Read(CAD_Topo_FCove.orig, 2), Float_Mul(CAD_Topo_FCove.r, CAD_Topo.FCoveGet(108, i))))
        CAD_Topo_FCove.ok1 = CAD_Topo_FCove.ok
        IfCondition EqualTo(CAD_Topo_FCove.wa, CAD_Topo.FCoveGet(360, i)) ThenBlock: {
            CAD_Topo_FCove.cx = ArrayGet(CAD_Topo_FCove.pt, 0)
            CAD_Topo_FCove.cy = ArrayGet(CAD_Topo_FCove.pt, 1)
            CAD_Topo_FCove.cz = ArrayGet(CAD_Topo_FCove.pt, 2)
            CAD_Topo_FCove.ok1 = CAD_Topo.FCoveMakeArc(CAD_Topo.FCoveGet(276, i), CAD_Topo.FCoveGet(372, i))
        }
        ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(348, i), CAD_Topo.FCoveGet(432, i)))
        ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.FCoveRegisterCe(CAD_Topo_FCove.ok1, CAD_Topo.FCoveGet(276, i)))
        ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.FCoveRegisterCe(CAD_Topo.FCoveGet(396, i), CAD_Topo.FCoveGet(372, i)))
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.ring, 2), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 3, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.f1 = CAD_Topo.MakeFace(CAD_Geom.MakeSphereSurf(CAD_Topo_FCove.pt, CAD_Topo_FCove.r), CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.f1)
        ReturnValue(1)
    }
}

