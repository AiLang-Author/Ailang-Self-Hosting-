LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

// In-place fillet of ONE plane–plane edge. Adds a blend face and trims
// only the two support faces + the two end faces. Existing coves stay.
Function.CAD_Topo.FilletEdgeLocal {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.solid = solid_handle
        CAD_Topo_FLoc.edge = edge_handle
        CAD_Topo_FLoc.r = radius_r
        CAD_Topo_FLoc.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FLoc.shell, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.faces, 0) ThenBlock: { CAD_Topo_FLoc.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FLoc.pl1, 0) ThenBlock: { CAD_Topo_FLoc.pl1 = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FLoc.pl2, 0) ThenBlock: { CAD_Topo_FLoc.pl2 = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: { CAD_Topo_FLoc.pt = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FLoc.p1b, 0) ThenBlock: { CAD_Topo_FLoc.p1b = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FLoc.frame, 0) ThenBlock: { CAD_Topo_FLoc.frame = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FLoc.ring, 0) ThenBlock: { CAD_Topo_FLoc.ring = Allocate(64) }
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FLoc.edge, CAD_Topo_FLoc.faces), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.f1 = ArrayGet(CAD_Topo_FLoc.faces, 0)
        CAD_Topo_FLoc.f2 = ArrayGet(CAD_Topo_FLoc.faces, 1)
        CAD_Topo_FLoc.v0 = CAD_Store.Read(CAD_Topo_FLoc.edge, 0)
        CAD_Topo_FLoc.v1 = CAD_Store.Read(CAD_Topo_FLoc.edge, 1)
        IfCondition EqualTo(CAD_Topo_FLoc.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.v1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.px = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 0), CAD_Store.Read(CAD_Topo_FLoc.v1, 0)), 0x3FE0000000000000)
        CAD_Topo_FComp.py = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 1), CAD_Store.Read(CAD_Topo_FLoc.v1, 1)), 0x3FE0000000000000)
        CAD_Topo_FComp.pz = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 2), CAD_Store.Read(CAD_Topo_FLoc.v1, 2)), 0x3FE0000000000000)
        CAD_Topo_FComp.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        CAD_Topo_FComp.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        CAD_Topo_FComp.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
        IfCondition EqualTo(CAD_Topo.FilletFaceN(CAD_Topo_FLoc.f1), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FLoc.pl1, 10, CAD_Topo_FComp.n2x)
        ArraySet(CAD_Topo_FLoc.pl1, 11, CAD_Topo_FComp.n2y)
        ArraySet(CAD_Topo_FLoc.pl1, 12, CAD_Topo_FComp.n2z)
        IfCondition EqualTo(CAD_Topo.FilletFaceN(CAD_Topo_FLoc.f2), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FLoc.pl2, 10, CAD_Topo_FComp.n2x)
        ArraySet(CAD_Topo_FLoc.pl2, 11, CAD_Topo_FComp.n2y)
        ArraySet(CAD_Topo_FLoc.pl2, 12, CAD_Topo_FComp.n2z)
        CAD_Topo_FLoc.shell = CAD_Store.Read(CAD_Topo_FLoc.solid, 0)
        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.edge, 2)
        IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ce, 0), 1) ThenBlock: { ReturnValue(0) }
        }
        CAD_Topo_FLoc.n1x = ArrayGet(CAD_Topo_FLoc.pl1, 10)
        CAD_Topo_FLoc.n1y = ArrayGet(CAD_Topo_FLoc.pl1, 11)
        CAD_Topo_FLoc.n1z = ArrayGet(CAD_Topo_FLoc.pl1, 12)
        CAD_Topo_FLoc.n2x = ArrayGet(CAD_Topo_FLoc.pl2, 10)
        CAD_Topo_FLoc.n2y = ArrayGet(CAD_Topo_FLoc.pl2, 11)
        CAD_Topo_FLoc.n2z = ArrayGet(CAD_Topo_FLoc.pl2, 12)
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n1x), Float_Mul(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n1y)), Float_Mul(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.n1x = Float_Div(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n1y = Float_Div(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n1z = Float_Div(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.n2x, CAD_Topo_FLoc.n2x), Float_Mul(CAD_Topo_FLoc.n2y, CAD_Topo_FLoc.n2y)), Float_Mul(CAD_Topo_FLoc.n2z, CAD_Topo_FLoc.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.n2x = Float_Div(CAD_Topo_FLoc.n2x, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n2y = Float_Div(CAD_Topo_FLoc.n2y, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.n2z = Float_Div(CAD_Topo_FLoc.n2z, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        CAD_Topo_FLoc.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        CAD_Topo_FLoc.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.ln)
        // Span the original edge. End meridians are the ball-roll
        // section in each end face — not a vertex sphere.
        ArraySet(CAD_Topo_FLoc.pt, 0, CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        ArraySet(CAD_Topo_FLoc.pt, 1, CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        ArraySet(CAD_Topo_FLoc.pt, 2, CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
        ArraySet(CAD_Topo_FLoc.p1b, 0, CAD_Store.Read(CAD_Topo_FLoc.v1, 0))
        ArraySet(CAD_Topo_FLoc.p1b, 1, CAD_Store.Read(CAD_Topo_FLoc.v1, 1))
        ArraySet(CAD_Topo_FLoc.p1b, 2, CAD_Store.Read(CAD_Topo_FLoc.v1, 2))
        CAD_Topo_FLoc.hd = 0
        CAD_Topo_FComp.mode = 0
        CAD_Topo_FLoc.aa = CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f1)
        CAD_Topo_FLoc.bb = CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f2)
        IfCondition EqualTo(CAD_Topo_FLoc.aa, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FLoc.bb, 2) ThenBlock: { CAD_Topo_FLoc.hd = 1 }
        }
        IfCondition EqualTo(CAD_Topo_FLoc.aa, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FLoc.bb, 1) ThenBlock: { CAD_Topo_FLoc.hd = 1 }
        }
        IfCondition EqualTo(CAD_Topo_FLoc.hd, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FilletSolvePlaneCyl(), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 11
                PrintMessage("fillet LOCAL plane-cyl SOLVE fail\n")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(CAD_Topo_FLoc.hd, 0) ThenBlock: {
            PrintMessage("fillet LOCAL not plane-cyl\n")
        }
        IfCondition EqualTo(CAD_Topo_FLoc.hd, 0) ThenBlock: {
            CAD_Topo_FLoc.ab = Float_Add(0x3FF0000000000000, Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x), Float_Mul(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y)), Float_Mul(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ab, 0), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FLoc.ab = Float_Div(CAD_Topo_FLoc.r, CAD_Topo_FLoc.ab)
            // Convex: C = P − ab(N1+N2). Cove: C = P + ab(N1+N2).
            // IR slot 3 is occupancy (0=cove, 1=convex). Per edge, not batch.
            CAD_Topo_FLoc.which = 0
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FLoc.which = 1 }
            CAD_Topo_FLoc.ei = CAD_Topo.FilletIRIndexOf(CAD_Topo_FLoc.edge)
            IfCondition GreaterEqual(CAD_Topo_FLoc.ei, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FLoc.ei, 3), 0) ThenBlock: { CAD_Topo_FLoc.which = 1 }
                IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FLoc.ei, 3), 1) ThenBlock: { CAD_Topo_FLoc.which = 0 }
            }
            CAD_Topo_FLoc.c0x = Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x))
            CAD_Topo_FLoc.c0y = Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y))
            CAD_Topo_FLoc.c0z = Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z))
            IfCondition EqualTo(CAD_Topo_FLoc.which, 0) ThenBlock: {
                CAD_Topo_FLoc.c0x = Float_Sub(ArrayGet(CAD_Topo_FLoc.pt, 0), CAD_Topo_FLoc.c0x)
                CAD_Topo_FLoc.c0y = Float_Sub(ArrayGet(CAD_Topo_FLoc.pt, 1), CAD_Topo_FLoc.c0y)
                CAD_Topo_FLoc.c0z = Float_Sub(ArrayGet(CAD_Topo_FLoc.pt, 2), CAD_Topo_FLoc.c0z)
                CAD_Topo_FLoc.c1x = Float_Sub(ArrayGet(CAD_Topo_FLoc.p1b, 0), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x)))
                CAD_Topo_FLoc.c1y = Float_Sub(ArrayGet(CAD_Topo_FLoc.p1b, 1), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y)))
                CAD_Topo_FLoc.c1z = Float_Sub(ArrayGet(CAD_Topo_FLoc.p1b, 2), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z)))
            }
            IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
                CAD_Topo_FLoc.c0x = Float_Add(ArrayGet(CAD_Topo_FLoc.pt, 0), CAD_Topo_FLoc.c0x)
                CAD_Topo_FLoc.c0y = Float_Add(ArrayGet(CAD_Topo_FLoc.pt, 1), CAD_Topo_FLoc.c0y)
                CAD_Topo_FLoc.c0z = Float_Add(ArrayGet(CAD_Topo_FLoc.pt, 2), CAD_Topo_FLoc.c0z)
                CAD_Topo_FLoc.c1x = Float_Add(ArrayGet(CAD_Topo_FLoc.p1b, 0), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1x, CAD_Topo_FLoc.n2x)))
                CAD_Topo_FLoc.c1y = Float_Add(ArrayGet(CAD_Topo_FLoc.p1b, 1), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1y, CAD_Topo_FLoc.n2y)))
                CAD_Topo_FLoc.c1z = Float_Add(ArrayGet(CAD_Topo_FLoc.p1b, 2), Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FLoc.n1z, CAD_Topo_FLoc.n2z)))
            }
        }
        IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: { CAD_Topo.FilletEmitRestorePlaneCyl() }
        // Contacts: convex C+R N, cove C−R N. Plane-cyl N is already C→T.
        CAD_Topo_FLoc.ln = CAD_Topo_FLoc.r
        IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: {
                CAD_Topo_FLoc.ln = Float_Sub(0, CAD_Topo_FLoc.r)
            }
        }
        // junc=5: translate that end's C onto the blocker. Same function
        // both ends. Host CIRCLE stays full. Must not write FLoc.which.
        sh0 = CAD_Topo.FilletPlexShortenRailEnd(0)
        sh1 = CAD_Topo.FilletPlexShortenRailEnd(1)
        af = CAD_Topo_FPlex.arc4
        IfCondition EqualTo(af, 1) ThenBlock: {
            IfCondition EqualTo(sh0, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(sh1, 0) ThenBlock: { ReturnValue(0) }
        }
        // A vertex sphere (three edges) closes this end. The end circle
        // ties T_host and T_wall. Shift that center one radius along the
        // edge so the arc meets the ball. A two-edge corner is a digon:
        // the same shift moves the meridian off Th/Tw and the host loop
        // loses the corner.
        IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: {
            CAD_Topo_FLoc.aa = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
            CAD_Topo_FLoc.bb = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
            CAD_Topo_FLoc.ab = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
            CAD_Topo_FLoc.ar = Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.aa, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.bb, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edz))
            CAD_Topo_FLoc.aa = CAD_Store.Read(CAD_Topo_FLoc.v0, 0)
            CAD_Topo_FLoc.bb = CAD_Store.Read(CAD_Topo_FLoc.v0, 1)
            CAD_Topo_FLoc.ab = CAD_Store.Read(CAD_Topo_FLoc.v0, 2)
            CAD_Topo_FLoc.sn = CAD_Topo.FilletVertCount(CAD_Topo_FLoc.aa, CAD_Topo_FLoc.bb, CAD_Topo_FLoc.ab)
            CAD_Topo_FLoc.aa = CAD_Store.Read(CAD_Topo_FLoc.v1, 0)
            CAD_Topo_FLoc.bb = CAD_Store.Read(CAD_Topo_FLoc.v1, 1)
            CAD_Topo_FLoc.ab = CAD_Store.Read(CAD_Topo_FLoc.v1, 2)
            CAD_Topo_FLoc.ei = CAD_Topo.FilletVertCount(CAD_Topo_FLoc.aa, CAD_Topo_FLoc.bb, CAD_Topo_FLoc.ab)
            CAD_Topo_FLoc.aa = 0
            IfCondition GreaterEqual(CAD_Topo_FLoc.sn, 3) ThenBlock: { CAD_Topo_FLoc.aa = Float_Add(CAD_Topo_FLoc.aa, CAD_Topo_FLoc.r) }
            IfCondition GreaterEqual(CAD_Topo_FLoc.ei, 3) ThenBlock: { CAD_Topo_FLoc.aa = Float_Add(CAD_Topo_FLoc.aa, CAD_Topo_FLoc.r) }
            IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FLoc.ar, CAD_Topo_FLoc.aa), 0) ThenBlock: {
                IfCondition GreaterEqual(CAD_Topo_FLoc.sn, 3) ThenBlock: {
                    CAD_Topo_FLoc.c0x = Float_Add(CAD_Topo_FLoc.c0x, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.edx))
                    CAD_Topo_FLoc.c0y = Float_Add(CAD_Topo_FLoc.c0y, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.edy))
                    CAD_Topo_FLoc.c0z = Float_Add(CAD_Topo_FLoc.c0z, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.edz))
                }
                IfCondition GreaterEqual(CAD_Topo_FLoc.ei, 3) ThenBlock: {
                    CAD_Topo_FLoc.c1x = Float_Sub(CAD_Topo_FLoc.c1x, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.edx))
                    CAD_Topo_FLoc.c1y = Float_Sub(CAD_Topo_FLoc.c1y, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.edy))
                    CAD_Topo_FLoc.c1z = Float_Sub(CAD_Topo_FLoc.c1z, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.edz))
                }
            }
        }
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c0x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c0y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c0z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1z)))
        CAD_Topo_FLoc.va0 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c0x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c0y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c0z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2z)))
        CAD_Topo_FLoc.vb0 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c1x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c1y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c1z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n1z)))
        CAD_Topo_FLoc.va1 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c1x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2x)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c1y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2y)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c1z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.n2z)))
        CAD_Topo_FLoc.vb1 = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        IfCondition EqualTo(CAD_Topo_FLoc.va0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.vb1, 0) ThenBlock: { ReturnValue(0) }
        // Native mer on the fillet circle. Do not RailArcShift here:
        // which=0 vs which=1 puts the south mer at loop slot 3 vs 1,
        // then MeshRuledLoop samples circle-first vs ellipse-first —
        // off-plane Th makes one end a 2-point triangle and the other
        // a round arc. Same function, two tess paths. Not a sign flip.
        CAD_Topo.FilletPlexMerReset()
        IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: { CAD_Topo.FilletEmitRestorePlaneCyl() }
        ArraySet(CAD_Topo_FLoc.frame, 0, CAD_Topo_FLoc.c0x)
        ArraySet(CAD_Topo_FLoc.frame, 1, CAD_Topo_FLoc.c0y)
        ArraySet(CAD_Topo_FLoc.frame, 2, CAD_Topo_FLoc.c0z)
        ArraySet(CAD_Topo_FLoc.frame, 3, CAD_Topo_FLoc.n1x)
        ArraySet(CAD_Topo_FLoc.frame, 4, CAD_Topo_FLoc.n1y)
        ArraySet(CAD_Topo_FLoc.frame, 5, CAD_Topo_FLoc.n1z)
        CAD_Topo_FLoc.ab = Float_Sub(Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.n1z), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.n1y))
        ArraySet(CAD_Topo_FLoc.frame, 6, CAD_Topo_FLoc.ab)
        CAD_Topo_FLoc.ab = Float_Sub(Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.n1x), Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.n1z))
        ArraySet(CAD_Topo_FLoc.frame, 7, CAD_Topo_FLoc.ab)
        CAD_Topo_FLoc.ab = Float_Sub(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.n1y), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.n1x))
        ArraySet(CAD_Topo_FLoc.frame, 8, CAD_Topo_FLoc.ab)
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Topo_FLoc.frame, 6), ArrayGet(CAD_Topo_FLoc.frame, 6)), Float_Mul(ArrayGet(CAD_Topo_FLoc.frame, 7), ArrayGet(CAD_Topo_FLoc.frame, 7))), Float_Mul(ArrayGet(CAD_Topo_FLoc.frame, 8), ArrayGet(CAD_Topo_FLoc.frame, 8))))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 0) ThenBlock: {
            ArraySet(CAD_Topo_FLoc.frame, 6, Float_Div(ArrayGet(CAD_Topo_FLoc.frame, 6), CAD_Topo_FLoc.ln))
            ArraySet(CAD_Topo_FLoc.frame, 7, Float_Div(ArrayGet(CAD_Topo_FLoc.frame, 7), CAD_Topo_FLoc.ln))
            ArraySet(CAD_Topo_FLoc.frame, 8, Float_Div(ArrayGet(CAD_Topo_FLoc.frame, 8), CAD_Topo_FLoc.ln))
        }
        ArraySet(CAD_Topo_FLoc.frame, 9, CAD_Topo_FLoc.edx)
        ArraySet(CAD_Topo_FLoc.frame, 10, CAD_Topo_FLoc.edy)
        ArraySet(CAD_Topo_FLoc.frame, 11, CAD_Topo_FLoc.edz)
        CAD_Topo_FLoc.cyl = CAD_Geom.MakeCylinderSurf(CAD_Topo_FLoc.frame, CAD_Topo_FLoc.r)
        ArraySet(CAD_Topo_FLoc.frame, 0, CAD_Topo_FLoc.c0x)
        ArraySet(CAD_Topo_FLoc.frame, 1, CAD_Topo_FLoc.c0y)
        ArraySet(CAD_Topo_FLoc.frame, 2, CAD_Topo_FLoc.c0z)
        CAD_Topo_FLoc.ce = CAD_Geom.MakeCircle(CAD_Topo_FLoc.frame, CAD_Topo_FLoc.r)
        ArraySet(CAD_Topo_FLoc.frame, 0, CAD_Topo_FLoc.c1x)
        ArraySet(CAD_Topo_FLoc.frame, 1, CAD_Topo_FLoc.c1y)
        ArraySet(CAD_Topo_FLoc.frame, 2, CAD_Topo_FLoc.c1z)
        CAD_Topo_FLoc.endf = CAD_Geom.MakeCircle(CAD_Topo_FLoc.frame, CAD_Topo_FLoc.r)
        ArraySet(CAD_Topo_FLoc.pt, 0, CAD_Store.Read(CAD_Topo_FLoc.va0, 0))
        ArraySet(CAD_Topo_FLoc.pt, 1, CAD_Store.Read(CAD_Topo_FLoc.va0, 1))
        ArraySet(CAD_Topo_FLoc.pt, 2, CAD_Store.Read(CAD_Topo_FLoc.va0, 2))
        ArraySet(CAD_Topo_FLoc.p1b, 0, CAD_Store.Read(CAD_Topo_FLoc.va1, 0))
        ArraySet(CAD_Topo_FLoc.p1b, 1, CAD_Store.Read(CAD_Topo_FLoc.va1, 1))
        ArraySet(CAD_Topo_FLoc.p1b, 2, CAD_Store.Read(CAD_Topo_FLoc.va1, 2))
        CAD_Topo_FLoc.ega = CAD_Topo.MakeEdge(CAD_Topo_FLoc.va0, CAD_Topo_FLoc.va1, CAD_Geom.MakeLine(CAD_Topo_FLoc.pt, CAD_Topo_FLoc.p1b))
        ArraySet(CAD_Topo_FLoc.pt, 0, CAD_Store.Read(CAD_Topo_FLoc.vb0, 0))
        ArraySet(CAD_Topo_FLoc.pt, 1, CAD_Store.Read(CAD_Topo_FLoc.vb0, 1))
        ArraySet(CAD_Topo_FLoc.pt, 2, CAD_Store.Read(CAD_Topo_FLoc.vb0, 2))
        ArraySet(CAD_Topo_FLoc.p1b, 0, CAD_Store.Read(CAD_Topo_FLoc.vb1, 0))
        ArraySet(CAD_Topo_FLoc.p1b, 1, CAD_Store.Read(CAD_Topo_FLoc.vb1, 1))
        ArraySet(CAD_Topo_FLoc.p1b, 2, CAD_Store.Read(CAD_Topo_FLoc.vb1, 2))
        CAD_Topo_FLoc.egb = CAD_Topo.MakeEdge(CAD_Topo_FLoc.vb0, CAD_Topo_FLoc.vb1, CAD_Geom.MakeLine(CAD_Topo_FLoc.pt, CAD_Topo_FLoc.p1b))
        CAD_Topo_FLoc.arc0 = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FLoc.va0, CAD_Topo_FLoc.vb0, CAD_Topo_FLoc.ce)
        CAD_Topo_FLoc.arc1 = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FLoc.va1, CAD_Topo_FLoc.vb1, CAD_Topo_FLoc.endf)
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("mer0 k=", 7, CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.arc0, 2), 0))
        CAD_Topo.FilletDumpI(" sp=", 4, Float_ToInt(Float_Mul(CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.arc0, 2), 12), 0x408F400000000000)))
        CAD_Topo.FilletDumpI(" mer1 k=", 8, CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.arc1, 2), 0))
        CAD_Topo.FilletDumpI(" sp=", 4, Float_ToInt(Float_Mul(CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.arc1, 2), 12), 0x408F400000000000)))
        CAD_Topo.FilletDumpS("\n", 1)
        CAD_Topo_FLoc.ln = CAD_Topo_FLoc.r
        IfCondition EqualTo(CAD_Topo_FLoc.ega, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.arc1, 0) ThenBlock: { ReturnValue(0) }
        // Blend loop: A-gen, arc1, B-gen rev, arc0 rev. Native mer.
        // junc=5: ShortenRailEnd already moved C; kind=2 still skip sew.
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ega, 0), CAD_Topo_FLoc.va0) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 0, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.ega, CAD_Topo_FLoc.va0, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.ega, 3, ArrayGet(CAD_Topo_FLoc.ring, 0))
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.arc1, 0), CAD_Topo_FLoc.va1) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 1, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.arc1, CAD_Topo_FLoc.va1, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.arc1, 3, ArrayGet(CAD_Topo_FLoc.ring, 1))
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.egb, 0), CAD_Topo_FLoc.vb1) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 2, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.egb, CAD_Topo_FLoc.vb1, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.egb, 3, ArrayGet(CAD_Topo_FLoc.ring, 2))
        CAD_Topo_FLoc.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.arc0, 0), CAD_Topo_FLoc.vb0) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        ArraySet(CAD_Topo_FLoc.ring, 3, CAD_Topo.MakeCoedge(CAD_Topo_FLoc.arc0, CAD_Topo_FLoc.vb0, CAD_Topo_FLoc.which))
        CAD_Store.Write(CAD_Topo_FLoc.arc0, 3, ArrayGet(CAD_Topo_FLoc.ring, 3))
        CAD_Topo_FLoc.ce = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FLoc.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FLoc.ring, 4, CAD_Topo_FLoc.ce)
        CAD_Topo_FLoc.endf = CAD_Topo.MakeFace(CAD_Topo_FLoc.cyl, CAD_Topo_FLoc.ce)
        IfCondition EqualTo(CAD_Topo_FLoc.endf, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Topo_FLoc.shell, CAD_Topo_FLoc.endf)
        // Trim F1 / F2: replace E with generators
        CAD_Topo_FLoc.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FLoc.f1, CAD_Topo_FLoc.edge)
        IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: {
            PrintMessage("fillet LOCAL no coedge f1\n")
            ReturnValue(0)
        }
        CAD_Topo_FLoc.which = CAD_Store.Read(CAD_Topo_FLoc.ce, 5)
        CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va0
        IfCondition EqualTo(CAD_Topo_FLoc.which, CAD_Topo_FLoc.v1) ThenBlock: { CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va1 }
        CAD_Topo.CoedgeSwapEdge(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.ega, CAD_Topo_FLoc.aa)
        CAD_Topo_FLoc.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FLoc.f2, CAD_Topo_FLoc.edge)
        IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: {
            PrintMessage("fillet LOCAL no coedge f2\n")
            ReturnValue(0)
        }
        CAD_Topo_FLoc.which = CAD_Store.Read(CAD_Topo_FLoc.ce, 5)
        CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb0
        IfCondition EqualTo(CAD_Topo_FLoc.which, CAD_Topo_FLoc.v1) ThenBlock: { CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb1 }
        CAD_Topo.CoedgeSwapEdge(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.egb, CAD_Topo_FLoc.bb)
        CAD_Topo_FLoc.ei = 0
        WhileLoop LessThan(CAD_Topo_FLoc.ei, 2) {
            CAD_Topo_FLoc.vv = CAD_Topo_FLoc.v0
            CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va0
            CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb0
            CAD_Topo_FLoc.ar = CAD_Topo_FLoc.arc0
            IfCondition EqualTo(CAD_Topo_FLoc.ei, 1) ThenBlock: {
                CAD_Topo_FLoc.vv = CAD_Topo_FLoc.v1
                CAD_Topo_FLoc.aa = CAD_Topo_FLoc.va1
                CAD_Topo_FLoc.bb = CAD_Topo_FLoc.vb1
                CAD_Topo_FLoc.ar = CAD_Topo_FLoc.arc1
            }
            CAD_Topo_FCE.dx = CAD_Topo_FLoc.edx
            CAD_Topo_FCE.dy = CAD_Topo_FLoc.edy
            CAD_Topo_FCE.dz = CAD_Topo_FLoc.edz
            CAD_Topo_FLoc.endf = CAD_Topo.FindFaceWithVert(CAD_Topo_FLoc.solid, CAD_Topo_FLoc.vv, CAD_Topo_FLoc.f1, CAD_Topo_FLoc.f2)
            // Shared vert: skip planar mer. Sequential sews the
            // equal-R ellipse after both cylinders exist.
            // FVert is this batch only. FilletPlexSolve clears it, and
            // a lone edge (case 9) clears it again. A stale count>1
            // from the previous solid skips this sew and the fillet
            // never meets the side edge.
            vx = CAD_Store.Read(CAD_Topo_FLoc.vv, 0)
            vy = CAD_Store.Read(CAD_Topo_FLoc.vv, 1)
            vz = CAD_Store.Read(CAD_Topo_FLoc.vv, 2)
            CAD_Topo_FLoc.sn = CAD_Topo.FilletVertShared(vx, vy, vz)
            IfCondition EqualTo(CAD_Topo_FLoc.sn, 1) ThenBlock: {
                CAD_Topo_FLoc.endf = 0
            }
            IfCondition EqualTo(CAD_Topo_FLoc.endf, 0) ThenBlock: {
                CAD_Topo_FLoc.endf = CAD_Topo.FilletPlexBlockingFace(CAD_Topo_FLoc.solid, CAD_Topo_FLoc.vv, CAD_Topo_FLoc.f1, CAD_Topo_FLoc.f2)
            }
            jn = CAD_Topo.FilletPlexJuncAt(CAD_Topo_FLoc.vv, CAD_Topo_FLoc.f1, CAD_Topo_FLoc.f2)
            fk = CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.endf)
            sk = 0
            // Skip only when the cylinder is a face of this edge (host
            // circle). A neighbor cylinder is an earlier fillet; its loop
            // still has to take the meridian or the corner edge is lost.
            IfCondition EqualTo(fk, 2) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FLoc.endf, CAD_Topo_FLoc.f1) ThenBlock: { sk = 1 }
                IfCondition EqualTo(CAD_Topo_FLoc.endf, CAD_Topo_FLoc.f2) ThenBlock: { sk = 1 }
            }
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpI("mer ei=", 7, CAD_Topo_FLoc.ei)
            CAD_Topo.FilletDumpI(" sh=", 4, CAD_Topo_FLoc.sn)
            CAD_Topo.FilletDumpI(" endf=", 6, CAD_Topo_FLoc.endf)
            CAD_Topo.FilletDumpI(" k=", 3, fk)
            CAD_Topo.FilletDumpI(" junc=", 6, jn)
            CAD_Topo.FilletDumpI(" nsel=", 6, CAD_Topo.FilletIRCountAt(CAD_Topo_FLoc.vv))
            CAD_Topo.FilletDumpI(" skip=", 6, sk)
            CAD_Topo.FilletDumpS("\n", 1)
            // Shared host CIRCLE: sequential CircleEnd is two paths.
            // First rail: hdZ=20 lnZ=12, full arc. Second: loop reversed
            // so hdZ=12 lnZ=20, remainder. That is triangle vs round.
            // Skip both ends. Same function, same mer. ShortenRailEnd
            // already moved C; kind=2 still not sewn.
            IfCondition EqualTo(sk, 1) ThenBlock: {
                CAD_Topo.FilletDumpS("mer skip cyl seq\n", 17)
                CAD_Topo_FLoc.endf = 0
            }
            // Two selected edges still meet here. Histogram cnt can read 0;
            // sewing the planar mer pulls the next top edge off the corner.
            vv = CAD_Topo_FLoc.vv
            nc = CAD_Topo.FilletIRCountAt(vv)
            CAD_Topo_FLoc.vv = vv
            IfCondition GreaterEqual(nc, 2) ThenBlock: { CAD_Topo_FLoc.endf = 0 }
            IfCondition NotEqual(CAD_Topo_FLoc.endf, 0) ThenBlock: {
                CAD_Topo_FLoc.lp = 0
                CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.endf, 1), 0)
                CAD_Topo_FLoc.hd = CAD_Topo_FLoc.ce
                CAD_Topo_FLoc.ln = 0
                WhileLoop LessThan(CAD_Topo_FLoc.ln, 2048) {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.ce, 5), CAD_Topo_FLoc.vv) ThenBlock: {
                        CAD_Topo_FLoc.lp = CAD_Topo_FLoc.ce
                        CAD_Topo_FLoc.ln = 2048
                    }
                    IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: { CAD_Topo_FLoc.ln = 2048 }
                    IfCondition EqualTo(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.ce, 2)
                        IfCondition EqualTo(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.hd) ThenBlock: { CAD_Topo_FLoc.ln = 2048 }
                    }
                    CAD_Topo_FLoc.ln = Add(CAD_Topo_FLoc.ln, 1)
                }
                IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FLoc.ar, 0) ThenBlock: {
                        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.lp, 3)
                        IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: {
                            // Each host edge at V gets the mer vertex closer
                            // to its other end. Kind==2 → Th / LINE → Tw
                            // assigned Tw to both LINEs on a top-edge fillet
                            // (hdZ=lnZ=Tw, lid corner pulled down).
                            CAD_Topo_FLoc.hd = CAD_Topo_FLoc.aa
                            CAD_Topo_FLoc.ln = CAD_Topo_FLoc.bb
                            IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                                CAD_Topo_FLoc.cyl = CAD_Store.Read(CAD_Topo_FLoc.ce, 0)
                                IfCondition NotEqual(CAD_Topo_FLoc.cyl, 0) ThenBlock: {
                                    CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Topo_FLoc.cyl, 0)
                                    IfCondition EqualTo(CAD_Topo_FLoc.vv, CAD_Store.Read(CAD_Topo_FLoc.lp, 5)) ThenBlock: {
                                        CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Topo_FLoc.cyl, 1)
                                    }
                                    CAD_Topo_FLoc.hd = CAD_Topo.FilletMerCloser(CAD_Topo_FLoc.aa, CAD_Topo_FLoc.bb, CAD_Topo_FLoc.vv)
                                }
                            }
                            IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                                CAD_Topo_FLoc.cyl = CAD_Store.Read(CAD_Topo_FLoc.lp, 0)
                                IfCondition NotEqual(CAD_Topo_FLoc.cyl, 0) ThenBlock: {
                                    CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Topo_FLoc.cyl, 0)
                                    IfCondition EqualTo(CAD_Topo_FLoc.vv, CAD_Store.Read(CAD_Topo_FLoc.lp, 5)) ThenBlock: {
                                        CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Topo_FLoc.cyl, 1)
                                    }
                                    CAD_Topo_FLoc.ln = CAD_Topo.FilletMerCloser(CAD_Topo_FLoc.aa, CAD_Topo_FLoc.bb, CAD_Topo_FLoc.vv)
                                }
                            }
                            CAD_Topo.FilletDumpI("mer hdZ=", 8, Float_ToInt(CAD_Store.Read(CAD_Topo_FLoc.hd, 2)))
                            CAD_Topo.FilletDumpI(" lnZ=", 5, Float_ToInt(CAD_Store.Read(CAD_Topo_FLoc.ln, 2)))
                            CAD_Topo.FilletDumpS("\n", 1)
                        }
                        IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f1), 2) ThenBlock: {
                                CAD_Topo_FLoc.ln = CAD_Topo_FLoc.aa
                                CAD_Topo_FLoc.aa = CAD_Topo_FLoc.bb
                                CAD_Topo_FLoc.bb = CAD_Topo_FLoc.ln
                            }
                        }
                        IfCondition NotEqual(CAD_Topo_FComp.mode, 0) ThenBlock: {
                            CAD_Topo_FLoc.hd = CAD_Topo_FLoc.aa
                            CAD_Topo_FLoc.ln = CAD_Topo_FLoc.bb
                        }
                        IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: {
                            CAD_Topo_FLoc.hd = CAD_Topo_FLoc.aa
                            IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                                CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.ce, 0), 2)
                                IfCondition NotEqual(CAD_Topo_FLoc.vv, 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.vv, 0), 2) ThenBlock: { CAD_Topo_FLoc.hd = CAD_Topo_FLoc.bb }
                                }
                            }
                            CAD_Topo_FLoc.ln = CAD_Topo_FLoc.aa
                            CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Store.Read(CAD_Topo_FLoc.lp, 0), 2)
                            IfCondition NotEqual(CAD_Topo_FLoc.vv, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.vv, 0), 2) ThenBlock: { CAD_Topo_FLoc.ln = CAD_Topo_FLoc.bb }
                            }
                        }
                        CAD_Topo_FLoc.vv = 1
                        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ar, 0), CAD_Topo_FLoc.hd) ThenBlock: { CAD_Topo_FLoc.vv = 0 }
                        ArraySet(CAD_Topo_FLoc.ring, 8, CAD_Topo_FLoc.hd)
                        ArraySet(CAD_Topo_FLoc.ring, 9, CAD_Topo_FLoc.ln)
                        ArraySet(CAD_Topo_FLoc.ring, 10, 0)
                        ArraySet(CAD_Topo_FLoc.ring, 11, 0)
                        ArraySet(CAD_Topo_FLoc.ring, 12, 0)
                        IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: { ArraySet(CAD_Topo_FLoc.ring, 10, CAD_Store.Read(CAD_Topo_FLoc.ce, 0)) }
                        IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                            ArraySet(CAD_Topo_FLoc.ring, 11, CAD_Store.Read(CAD_Topo_FLoc.lp, 0))
                            ArraySet(CAD_Topo_FLoc.ring, 12, CAD_Store.Read(CAD_Topo_FLoc.lp, 5))
                        }
                        // Same test at both supports. An off-circle vertex
                        // (the old fillet center) must not be spliced: the
                        // split bails and that end of the face becomes a sheet.
                        CAD_Topo_FLoc.sn = CAD_Topo.FilletEmitMerOnSupport(ArrayGet(CAD_Topo_FLoc.ring, 10), ArrayGet(CAD_Topo_FLoc.ring, 8), ArrayGet(CAD_Topo_FLoc.ring, 11), ArrayGet(CAD_Topo_FLoc.ring, 9))
                        IfCondition EqualTo(CAD_Topo_FLoc.sn, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
                            CAD_Topo.FilletDumpS("mer off circ\n", 13)
                        }
                        IfCondition EqualTo(CAD_Topo_FLoc.sn, 1) ThenBlock: {
                            CAD_Topo_FLoc.cyl = CAD_Topo.MakeCoedge(CAD_Topo_FLoc.ar, CAD_Topo_FLoc.hd, CAD_Topo_FLoc.vv)
                            IfCondition NotEqual(CAD_Topo_FLoc.cyl, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.ar, 4), 0) ThenBlock: {
                                    CAD_Store.Write(CAD_Topo_FLoc.ar, 4, CAD_Topo_FLoc.cyl)
                                    IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.ar, 3), 0) ThenBlock: {
                                        CAD_Topo.LinkTwins(CAD_Store.Read(CAD_Topo_FLoc.ar, 3), CAD_Topo_FLoc.cyl)
                                    }
                                }
                                CAD_Topo.CoedgeInsertAfter(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.cyl)
                                ArraySet(CAD_Topo_FLoc.ring, 13, CAD_Topo.FilletEmitMerSupport(ArrayGet(CAD_Topo_FLoc.ring, 10), ArrayGet(CAD_Topo_FLoc.ring, 12), ArrayGet(CAD_Topo_FLoc.ring, 8)))
                                ArraySet(CAD_Topo_FLoc.ring, 14, CAD_Topo.FilletEmitMerSupport(ArrayGet(CAD_Topo_FLoc.ring, 11), ArrayGet(CAD_Topo_FLoc.ring, 12), ArrayGet(CAD_Topo_FLoc.ring, 9)))
                                ArraySet(CAD_Topo_FLoc.ring, 15, 1)
                                IfCondition EqualTo(ArrayGet(CAD_Topo_FLoc.ring, 13), 0) ThenBlock: { ArraySet(CAD_Topo_FLoc.ring, 15, 0) }
                                IfCondition EqualTo(ArrayGet(CAD_Topo_FLoc.ring, 14), 0) ThenBlock: { ArraySet(CAD_Topo_FLoc.ring, 15, 0) }
                                IfCondition EqualTo(ArrayGet(CAD_Topo_FLoc.ring, 15), 0) ThenBlock: {
                                    CAD_Topo.FilletEmitMerUndo(CAD_Topo_FLoc.cyl, ArrayGet(CAD_Topo_FLoc.ring, 10), ArrayGet(CAD_Topo_FLoc.ring, 8), ArrayGet(CAD_Topo_FLoc.ring, 11), ArrayGet(CAD_Topo_FLoc.ring, 9), ArrayGet(CAD_Topo_FLoc.ring, 12))
                                    IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
                                    CAD_Topo.FilletDumpS("mer sew undo\n", 13)
                                }
                            }
                        }
                    }
                }
            }
            CAD_Topo_FLoc.ei = Add(CAD_Topo_FLoc.ei, 1)
        }
        IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: {
            CAD_Topo.FilletEmitEnclosureProbe()
        }
        PrintMessage("fillet LOCAL edge ok\n")
        ReturnValue(CAD_Topo_FLoc.solid)
    }
}

