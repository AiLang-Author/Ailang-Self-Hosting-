// CAD.Topo.FilletEmit — B-Rep mutation from FilletIR solve pack.
// Plane–cyl: one torus. Top vs bottom is N_host. Frames are right-handed on N_host
// (copying the rim circle XY with Z=−N_host was left-handed and broke bottom).
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.Topo.FilletEmitOpen
LibraryImport.Cad.Topo.FilletEmitPlane
LibraryImport.Cad.Topo.FilletEmitChain

// N of a support face at FComp.px. Plane from FaceGetPlane; cylinder
// radial (P−O) minus axis. Writes n2*. 1 ok.
Function.CAD_Topo.FilletFaceN {
    Input: face_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FaceGetPlane(face_h, CAD_Topo_FComp.pl), 0) ThenBlock: {
            CAD_Topo_FComp.n2x = ArrayGet(CAD_Topo_FComp.pl, 10)
            CAD_Topo_FComp.n2y = ArrayGet(CAD_Topo_FComp.pl, 11)
            CAD_Topo_FComp.n2z = ArrayGet(CAD_Topo_FComp.pl, 12)
            CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n2z)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.n2x = Float_Div(CAD_Topo_FComp.n2x, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.n2y = Float_Div(CAD_Topo_FComp.n2y, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.n2z = Float_Div(CAD_Topo_FComp.n2z, CAD_Topo_FComp.ln)
            ReturnValue(1)
        }
        CAD_Topo_FComp.which = CAD_Store.Read(face_h, 0)
        IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FComp.which, 0), 2) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.n2x = Float_Sub(CAD_Topo_FComp.px, CAD_Store.Read(CAD_Topo_FComp.which, 1))
        CAD_Topo_FComp.n2y = Float_Sub(CAD_Topo_FComp.py, CAD_Store.Read(CAD_Topo_FComp.which, 2))
        CAD_Topo_FComp.n2z = Float_Sub(CAD_Topo_FComp.pz, CAD_Store.Read(CAD_Topo_FComp.which, 3))
        CAD_Topo_FComp.xx = CAD_Topo_FComp.edx
        CAD_Topo_FComp.xy = CAD_Topo_FComp.edy
        CAD_Topo_FComp.xz = CAD_Topo_FComp.edz
        CAD_Topo_FComp.ln = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.xx), Float_Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.xy)), Float_Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.xz))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: {
            CAD_Topo_FComp.xx = CAD_Store.Read(CAD_Topo_FComp.which, 10)
            CAD_Topo_FComp.xy = CAD_Store.Read(CAD_Topo_FComp.which, 11)
            CAD_Topo_FComp.xz = CAD_Store.Read(CAD_Topo_FComp.which, 12)
        }
        CAD_Topo_FComp.ln = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.xx), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.xy)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.xz))
        CAD_Topo_FComp.aa = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.xx), Float_Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.xy)), Float_Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.xz))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.aa, 0), 0) ThenBlock: {
            CAD_Topo_FComp.ln = Float_Div(CAD_Topo_FComp.ln, CAD_Topo_FComp.aa)
        }
        CAD_Topo_FComp.n2x = Float_Sub(CAD_Topo_FComp.n2x, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.xx))
        CAD_Topo_FComp.n2y = Float_Sub(CAD_Topo_FComp.n2y, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.xy))
        CAD_Topo_FComp.n2z = Float_Sub(CAD_Topo_FComp.n2z, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.xz))
        CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.n2x = Float_Div(CAD_Topo_FComp.n2x, CAD_Topo_FComp.ln)
        CAD_Topo_FComp.n2y = Float_Div(CAD_Topo_FComp.n2y, CAD_Topo_FComp.ln)
        CAD_Topo_FComp.n2z = Float_Div(CAD_Topo_FComp.n2z, CAD_Topo_FComp.ln)
        ReturnValue(1)
    }
}

// Order selected edges into a path. Try every start and both
// orientations — a 2-edge V shares v0 of the first pick, not v1.
Function.CAD_Topo.RimOrder {
    Output: Integer
    Body: {
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.sn = 0
            WhileLoop LessThan(CAD_Topo_FCove.sn, 2) {
                CAD_Topo_FCove.i = 0
                WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
                    CAD_Topo.FCoveSet(360, CAD_Topo_FCove.i, 0)
                    CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
                }
                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(372, CAD_Topo_FCove.g)
                CAD_Topo_FCove.ok = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    CAD_Topo.FCoveSet(0, 0, CAD_Topo_FCove.e)
                    CAD_Topo.FCoveSet(360, CAD_Topo_FCove.g, 1)
                    IfCondition EqualTo(CAD_Topo_FCove.sn, 0) ThenBlock: {
                        CAD_Topo.FCoveSet(12, 0, CAD_Store.Read(CAD_Topo_FCove.e, 0))
                        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                    }
                    IfCondition EqualTo(CAD_Topo_FCove.sn, 1) ThenBlock: {
                        CAD_Topo.FCoveSet(12, 0, CAD_Store.Read(CAD_Topo_FCove.e, 1))
                        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                    }
                    CAD_Topo_FCove.k = 1
                    CAD_Topo_FCove.ok = 1
                    WhileLoop LessThan(CAD_Topo_FCove.k, CAD_Topo_FCove.n) {
                        CAD_Topo_FCove.hit = 0
                        CAD_Topo_FCove.j = 0
                        WhileLoop LessThan(CAD_Topo_FCove.j, CAD_Topo_FCove.n) {
                            IfCondition EqualTo(CAD_Topo.FCoveGet(360, CAD_Topo_FCove.j), 0) ThenBlock: {
                                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(372, CAD_Topo_FCove.j)
                                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                                    CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                                    CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                                    IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1) ThenBlock: {
                                        CAD_Topo.FCoveSet(0, CAD_Topo_FCove.k, CAD_Topo_FCove.e)
                                        CAD_Topo.FCoveSet(12, CAD_Topo_FCove.k, CAD_Topo_FCove.v0)
                                        CAD_Topo_FCove.v1 = CAD_Topo_FCove.orig
                                        CAD_Topo.FCoveSet(360, CAD_Topo_FCove.j, 1)
                                        CAD_Topo_FCove.hit = 1
                                        CAD_Topo_FCove.j = CAD_Topo_FCove.n
                                    }
                                    IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Topo_FCove.orig, CAD_Topo_FCove.v1) ThenBlock: {
                                            CAD_Topo.FCoveSet(0, CAD_Topo_FCove.k, CAD_Topo_FCove.e)
                                            CAD_Topo.FCoveSet(12, CAD_Topo_FCove.k, CAD_Topo_FCove.orig)
                                            CAD_Topo_FCove.v1 = CAD_Topo_FCove.v0
                                            CAD_Topo.FCoveSet(360, CAD_Topo_FCove.j, 1)
                                            CAD_Topo_FCove.hit = 1
                                            CAD_Topo_FCove.j = CAD_Topo_FCove.n
                                        }
                                    }
                                }
                            }
                            CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
                        }
                        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
                            CAD_Topo_FCove.ok = 0
                            CAD_Topo_FCove.k = CAD_Topo_FCove.n
                        }
                        CAD_Topo_FCove.k = Add(CAD_Topo_FCove.k, 1)
                    }
                }
                IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: { ReturnValue(1) }
                CAD_Topo_FCove.sn = Add(CAD_Topo_FCove.sn, 1)
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ReturnValue(0)
    }
}

// Minor mer through Th and Tw on the solved C = T_host − ln N_host.
Function.CAD_Topo.FilletMerThrough {
    Input: th: Integer
    Input: tw: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ln = CAD_Topo_FCove.r
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
        CAD_Topo_FCove.cx = Float_Sub(CAD_Store.Read(th, 0), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x))
        CAD_Topo_FCove.cy = Float_Sub(CAD_Store.Read(th, 1), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y))
        CAD_Topo_FCove.cz = Float_Sub(CAD_Store.Read(th, 2), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(tw, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(tw, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(tw, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
            CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ab)
            CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ab)
            CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ab)
        }
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.n2x)
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.n2y)
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.n2z)
        ReturnValue(CAD_Topo.MakeMinorArcEdge(th, tw, CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)))
    }
}

Function.CAD_Topo.FilletIRLog {
    Input: idx: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.which = idx
        CAD_Topo_FComp.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.which, 8)
        CAD_Topo_FComp.k = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.n1z), 1) ThenBlock: { CAD_Topo_FComp.k = Subtract(0, 1) }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.n1z), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.n1z, 0), 0) ThenBlock: { CAD_Topo_FComp.k = 1 }
        }
        PrintMessage("fillet IR kind=")
        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.which, 1))
        PrintMessage(" inner=")
        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.which, 2))
        PrintMessage(" side=")
        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.which, 3))
        PrintMessage(" pair=")
        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.which, 11))
        PrintMessage(" Nz=")
        PrintNumber(CAD_Topo_FComp.k)
        PrintMessage(" mode=")
        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.which, 21))
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletEmitFillFrame {
    Output: Integer
    Body: {
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 12) {
            ArraySet(CAD_Topo_FCove.frame, CAD_Topo_FCove.g, 0)
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        // Host/wall circles must keep the rim XY. Flipping Y to make the
        // torus right-handed reversed the bottom-cap loop and sheared the
        // solid (standalone bottom fillet). det is stored; torus flips later.
        CAD_Topo_FComp.xx = CAD_Store.Read(CAD_Topo_FCove.which, 4)
        CAD_Topo_FComp.xy = CAD_Store.Read(CAD_Topo_FCove.which, 5)
        CAD_Topo_FComp.xz = CAD_Store.Read(CAD_Topo_FCove.which, 6)
        CAD_Topo_FComp.yx = CAD_Store.Read(CAD_Topo_FCove.which, 7)
        CAD_Topo_FComp.yy = CAD_Store.Read(CAD_Topo_FCove.which, 8)
        CAD_Topo_FComp.yz = CAD_Store.Read(CAD_Topo_FCove.which, 9)
        CAD_Topo_FCove.d12 = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.yz), CAD_Num.Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.yy))
        CAD_Topo_FCove.d13 = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.yx), CAD_Num.Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.yz))
        CAD_Topo_FCove.d23 = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.yy), CAD_Num.Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.yx))
        CAD_Topo_FCove.det = Float_Add(Float_Add(CAD_Num.Mul(CAD_Topo_FCove.d12, CAD_Topo_FComp.n1x), CAD_Num.Mul(CAD_Topo_FCove.d13, CAD_Topo_FComp.n1y)), CAD_Num.Mul(CAD_Topo_FCove.d23, CAD_Topo_FComp.n1z))
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FComp.xx)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FComp.xy)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FComp.xz)
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FComp.yx)
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FComp.yy)
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FComp.yz)
        ReturnValue(1)
    }
}

// Distance² from C to segment AB. 1 when the grown hole meets that edge.
// g holds (Rmaj+0.05 mm)². Point edges (v0==v1) test the vertex.
Function.CAD_Topo.FilletEmitCapSeg {
    Input: ed: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ed, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.wa = CAD_Store.Read(ed, 0)
        CAD_Topo_FCove.wb = CAD_Store.Read(ed, 1)
        IfCondition EqualTo(CAD_Topo_FCove.wa, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.edx = CAD_Store.Read(CAD_Topo_FCove.wa, 0)
        CAD_Topo_FCove.edy = CAD_Store.Read(CAD_Topo_FCove.wa, 1)
        CAD_Topo_FCove.edz = CAD_Store.Read(CAD_Topo_FCove.wa, 2)
        CAD_Topo_FCove.j = 1
        IfCondition NotEqual(CAD_Topo_FCove.wb, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_FCove.wb, CAD_Topo_FCove.wa) ThenBlock: {
                CAD_Topo_FCove.j = 0
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.j, 0) ThenBlock: {
            CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_FCove.wb, 0)
            CAD_Topo_FCove.ab = CAD_Store.Read(CAD_Topo_FCove.wb, 1)
            CAD_Topo_FCove.ln = CAD_Store.Read(CAD_Topo_FCove.wb, 2)
            CAD_Topo_FCove.aa = Float_Sub(CAD_Topo_FCove.aa, CAD_Topo_FCove.edx)
            CAD_Topo_FCove.ab = Float_Sub(CAD_Topo_FCove.ab, CAD_Topo_FCove.edy)
            CAD_Topo_FCove.ln = Float_Sub(CAD_Topo_FCove.ln, CAD_Topo_FCove.edz)
            CAD_Topo_FCove.wb = CAD_Num.Sq(CAD_Topo_FCove.aa)
            CAD_Topo_FCove.wb = Float_Add(CAD_Topo_FCove.wb, CAD_Num.Sq(CAD_Topo_FCove.ab))
            CAD_Topo_FCove.wb = Float_Add(CAD_Topo_FCove.wb, CAD_Num.Sq(CAD_Topo_FCove.ln))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.wb, 0), 1) ThenBlock: {
                CAD_Topo_FCove.j = 1
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.j, 0) ThenBlock: {
            CAD_Topo_FCove.wa = Float_Sub(CAD_Topo_FCove.cx, CAD_Topo_FCove.edx)
            CAD_Topo_FCove.wa = CAD_Num.Mul(CAD_Topo_FCove.wa, CAD_Topo_FCove.aa)
            CAD_Topo_FCove.hit = Float_Sub(CAD_Topo_FCove.cy, CAD_Topo_FCove.edy)
            CAD_Topo_FCove.hit = CAD_Num.Mul(CAD_Topo_FCove.hit, CAD_Topo_FCove.ab)
            CAD_Topo_FCove.wa = Float_Add(CAD_Topo_FCove.wa, CAD_Topo_FCove.hit)
            CAD_Topo_FCove.hit = Float_Sub(CAD_Topo_FCove.cz, CAD_Topo_FCove.edz)
            CAD_Topo_FCove.hit = CAD_Num.Mul(CAD_Topo_FCove.hit, CAD_Topo_FCove.ln)
            CAD_Topo_FCove.wa = Float_Add(CAD_Topo_FCove.wa, CAD_Topo_FCove.hit)
            CAD_Topo_FCove.wa = Float_Div(CAD_Topo_FCove.wa, CAD_Topo_FCove.wb)
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.wa), 1) ThenBlock: {
                CAD_Topo_FCove.wa = 0
            }
            IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.wa, 0x3FF0000000000000), 0) ThenBlock: {
                CAD_Topo_FCove.wa = 0x3FF0000000000000
            }
            CAD_Topo_FCove.edx = Float_Add(CAD_Topo_FCove.edx, CAD_Num.Mul(CAD_Topo_FCove.wa, CAD_Topo_FCove.aa))
            CAD_Topo_FCove.edy = Float_Add(CAD_Topo_FCove.edy, CAD_Num.Mul(CAD_Topo_FCove.wa, CAD_Topo_FCove.ab))
            CAD_Topo_FCove.edz = Float_Add(CAD_Topo_FCove.edz, CAD_Num.Mul(CAD_Topo_FCove.wa, CAD_Topo_FCove.ln))
        }
        CAD_Topo_FCove.wa = Float_Sub(CAD_Topo_FCove.cx, CAD_Topo_FCove.edx)
        CAD_Topo_FCove.wa = CAD_Num.Sq(CAD_Topo_FCove.wa)
        CAD_Topo_FCove.aa = Float_Sub(CAD_Topo_FCove.cy, CAD_Topo_FCove.edy)
        CAD_Topo_FCove.wa = Float_Add(CAD_Topo_FCove.wa, CAD_Num.Sq(CAD_Topo_FCove.aa))
        CAD_Topo_FCove.aa = Float_Sub(CAD_Topo_FCove.cz, CAD_Topo_FCove.edz)
        CAD_Topo_FCove.wa = Float_Add(CAD_Topo_FCove.wa, CAD_Num.Sq(CAD_Topo_FCove.aa))
        ReturnValue(CAD_Num.Le(CAD_Topo_FCove.wa, CAD_Topo_FCove.g))
    }
}

// One host face. An inner circle of radius Rc that comes within Rc+R
// of an outer edge cannot be filleted: the new rails would cross it.
// 0 refuses (reason 29, no vertex). 1 means this face is clear.
Function.CAD_Topo.FilletEmitHoleFace {
    Input: face_h: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.f1 = face_h
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.f1, 1)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.orig = CAD_Topo_FCove.lp
        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.orig, 2)
        CAD_Topo_FCove.k = 0
        WhileLoop LessThan(CAD_Topo_FCove.k, 8) {
            IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { CAD_Topo_FCove.k = 8 }
            IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                CAD_Topo_FCove.hd = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
                CAD_Topo_FCove.ce = CAD_Topo_FCove.hd
                CAD_Topo_FCove.padh = 0
                CAD_Topo_FCove.kind = 0
                WhileLoop LessThan(CAD_Topo_FCove.padh, 64) {
                    IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.padh = 64 }
                    IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo_FCove.kind, 0) ThenBlock: {
                            CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                            IfCondition NotEqual(CAD_Topo_FCove.sn, 0) ThenBlock: {
                                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.sn, 2)
                                IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                                    CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_FCove.which, 0)
                                    IfCondition EqualTo(CAD_Topo_FCove.aa, 2) ThenBlock: {
                                        CAD_Topo_FCove.kind = 1
                                        CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.which, 1)
                                        CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.which, 2)
                                        CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.which, 3)
                                        CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_FCove.which, 10)
                                        CAD_Topo_FCove.aa = Float_Add(CAD_Topo_FCove.aa, CAD_Topo_FCove.r)
                                        CAD_Topo_FCove.aa = Float_Add(CAD_Topo_FCove.aa, 0x3FA999999999999A)
                                        CAD_Topo_FCove.g = CAD_Num.Sq(CAD_Topo_FCove.aa)
                                        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.orig, 0)
                                        CAD_Topo_FCove.v0 = CAD_Topo_FCove.v1
                                        CAD_Topo_FCove.nxt = 0
                                        WhileLoop LessThan(CAD_Topo_FCove.nxt, 64) {
                                            IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { CAD_Topo_FCove.nxt = 64 }
                                            IfCondition NotEqual(CAD_Topo_FCove.v0, 0) ThenBlock: {
                                                CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_FCove.v0, 0)
                                                IfCondition NotEqual(CAD_Topo_FCove.sn, 0) ThenBlock: {
                                                    CAD_Topo_FCove.ok = CAD_Topo.FilletEmitCapSeg(CAD_Topo_FCove.sn)
                                                    IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                                                        CAD_Topo_State.fillet_reason = 29
                                                        PrintMessage("fillet hole cross\n")
                                                        ReturnValue(0)
                                                    }
                                                }
                                                CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.v0, 2)
                                                IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1) ThenBlock: {
                                                    CAD_Topo_FCove.nxt = 64
                                                }
                                            }
                                            CAD_Topo_FCove.nxt = Add(CAD_Topo_FCove.nxt, 1)
                                        }
                                    }
                                }
                            }
                        }
                        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                        IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: {
                            CAD_Topo_FCove.padh = 64
                        }
                    }
                    CAD_Topo_FCove.padh = Add(CAD_Topo_FCove.padh, 1)
                }
                CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.lp, 2)
            }
            CAD_Topo_FCove.k = Add(CAD_Topo_FCove.k, 1)
        }
        ReturnValue(1)
    }
}

// Before the chain writes a vertex. Each host face that already has an
// inner circle is tested at Rc+R. A miss leaves the solid as it was.
Function.CAD_Topo.FilletEmitHoleClear {
    Output: Integer
    Body: {
        CAD_Topo_FComp.host = CAD_Topo_FCove.host_f
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
            IfCondition GreaterEqual(CAD_Topo_FComp.h, 0) ThenBlock: {
                CAD_Topo_FCove.ok1 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 19)
                CAD_Topo_FCove.f2 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 20)
                CAD_Topo_FCove.ok = CAD_Topo.FilletEmitHoleFace(CAD_Topo_FCove.ok1)
                IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: {
                    CAD_Topo_FCove.host_f = CAD_Topo_FComp.host
                    ReturnValue(0)
                }
                CAD_Topo_FCove.ok = CAD_Topo.FilletEmitHoleFace(CAD_Topo_FCove.f2)
                IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: {
                    CAD_Topo_FCove.host_f = CAD_Topo_FComp.host
                    ReturnValue(0)
                }
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        CAD_Topo_FCove.host_f = CAD_Topo_FComp.host
        ReturnValue(1)
    }
}

// 1 when (px,py,pz) is within 0.05 mm of either endpoint of sn.
// CapSeg's closest point is then the end of that edge: the sharp
// corner, or the side-fillet rail that now ends on the offset circle.
Function.CAD_Topo.FilletEmitCapAtJoint {
    Input: px: Integer
    Input: py: Integer
    Input: pz: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.wa = px
        CAD_Topo_FCove.wb = py
        CAD_Topo_FCove.hit = pz
        CAD_Topo_FCove.padh = CAD_Topo_FCove.sn
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo_FCove.wa)
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo_FCove.wb)
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo_FCove.hit)
        ArraySet(CAD_Topo_FCove.p1b, 0, CAD_Topo_FCove.padh)
        CAD_Topo_FCove.kind = 0
        WhileLoop LessThan(CAD_Topo_FCove.kind, 2) {
            CAD_Topo_FCove.padh = CAD_Store.Read(ArrayGet(CAD_Topo_FCove.p1b, 0), CAD_Topo_FCove.kind)
            ArraySet(CAD_Topo_FCove.p1b, 1, CAD_Topo_FCove.padh)
            IfCondition NotEqual(ArrayGet(CAD_Topo_FCove.p1b, 1), 0) ThenBlock: {
                CAD_Topo_FCove.aa = CAD_Store.Read(ArrayGet(CAD_Topo_FCove.p1b, 1), 0)
                CAD_Topo_FCove.ab = CAD_Store.Read(ArrayGet(CAD_Topo_FCove.p1b, 1), 1)
                CAD_Topo_FCove.ln = CAD_Store.Read(ArrayGet(CAD_Topo_FCove.p1b, 1), 2)
                CAD_Topo_FCove.aa = Float_Sub(CAD_Topo_FCove.aa, ArrayGet(CAD_Topo_FCove.pt, 0))
                CAD_Topo_FCove.ab = Float_Sub(CAD_Topo_FCove.ab, ArrayGet(CAD_Topo_FCove.pt, 1))
                CAD_Topo_FCove.ln = Float_Sub(CAD_Topo_FCove.ln, ArrayGet(CAD_Topo_FCove.pt, 2))
                CAD_Topo_FCove.aa = CAD_Num.Sq(CAD_Topo_FCove.aa)
                CAD_Topo_FCove.ab = CAD_Num.Sq(CAD_Topo_FCove.ab)
                CAD_Topo_FCove.aa = Float_Add(CAD_Topo_FCove.aa, CAD_Topo_FCove.ab)
                CAD_Topo_FCove.ln = CAD_Num.Sq(CAD_Topo_FCove.ln)
                CAD_Topo_FCove.aa = Float_Add(CAD_Topo_FCove.aa, CAD_Topo_FCove.ln)
                CAD_Topo_FCove.ab = CAD_Num.Sq(0x3FA999999999999A)
                IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.aa, CAD_Topo_FCove.ab), 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
            CAD_Topo_FCove.kind = Add(CAD_Topo_FCove.kind, 1)
        }
        ReturnValue(0)
    }
}

// Mode 0 boss and mode 1 hole both grow to Rmaj. Refuse before
// MakeVertex when that circle meets the outer loop. Mode 2 does not.
// The edge's own chord is not a meet. A hit only at an edge end is the joint.
Function.CAD_Topo.FilletEmitCapClear {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Topo_FCove.s, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_FCove.s, 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.g = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 12)
        CAD_Topo_FCove.g = Float_Add(CAD_Topo_FCove.g, 0x3FA999999999999A)
        CAD_Topo_FCove.g = CAD_Num.Sq(CAD_Topo_FCove.g)
        CAD_Topo_FCove.orig = CAD_Topo_FCove.e
        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.host_f, 1)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.hd = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        IfCondition EqualTo(CAD_Topo_FCove.hd, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.ce = CAD_Topo_FCove.hd
        CAD_Topo_FCove.k = 0
        WhileLoop LessThan(CAD_Topo_FCove.k, 64) {
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.k = 64 }
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                IfCondition NotEqual(CAD_Topo_FCove.sn, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.sn, CAD_Topo_FCove.orig) ThenBlock: {
                        CAD_Topo_FCove.j = CAD_Topo.FilletEmitCapSeg(CAD_Topo_FCove.sn)
                        IfCondition EqualTo(CAD_Topo_FCove.j, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.FilletEmitCapAtJoint(CAD_Topo_FCove.edx, CAD_Topo_FCove.edy, CAD_Topo_FCove.edz), 0) ThenBlock: {
                                CAD_Topo_FCove.e = CAD_Topo_FCove.orig
                                IfCondition EqualTo(CAD_Topo_FCove.s, 1) ThenBlock: {
                                    CAD_Topo_State.fillet_reason = 28
                                    PrintMessage("fillet cap meet\n")
                                    ReturnValue(0)
                                }
                                CAD_Topo_State.fillet_reason = 29
                                PrintMessage("fillet hole cross\n")
                                ReturnValue(0)
                            }
                        }
                    }
                }
                CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: {
                    CAD_Topo_FCove.k = 64
                }
            }
            CAD_Topo_FCove.k = Add(CAD_Topo_FCove.k, 1)
        }
        CAD_Topo_FCove.e = CAD_Topo_FCove.orig
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletEmitMakeGeom {
    Output: Integer
    Body: {
        CAD_Topo_FCove.j = CAD_Topo.FilletEmitCapClear()
        IfCondition EqualTo(CAD_Topo_FCove.j, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 0))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 1))
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 2))
        CAD_Topo_FCove.ok = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 3))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 4))
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 5))
        CAD_Topo_FCove.hit = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.aa = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 15)
        CAD_Topo_FCove.ab = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 12)
        CAD_Topo_FCove.padh = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13)
        // Wall circle on the host plane, radius Rmaj. Origin = rim circle O.
        CAD_Topo.FilletEmitFillFrame()
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        CAD_Topo_FCove.wa = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab)
        CAD_Store.Write(CAD_Topo_FCove.wa, 12, 0x401921FB54442D18)
        // Host circle + torus at A0 + s_host N_host.
        ArraySet(CAD_Topo_FCove.frame, 0, Float_Add(CAD_Topo_FCove.cx, CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1x)))
        ArraySet(CAD_Topo_FCove.frame, 1, Float_Add(CAD_Topo_FCove.cy, CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1y)))
        ArraySet(CAD_Topo_FCove.frame, 2, Float_Add(CAD_Topo_FCove.cz, CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1z)))
        CAD_Topo_FCove.wb = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.aa)
        CAD_Store.Write(CAD_Topo_FCove.wb, 12, 0x401921FB54442D18)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.det), 1) ThenBlock: {
            ArraySet(CAD_Topo_FCove.frame, 6, Float_Sub(0, CAD_Topo_FComp.yx))
            ArraySet(CAD_Topo_FCove.frame, 7, Float_Sub(0, CAD_Topo_FComp.yy))
            ArraySet(CAD_Topo_FCove.frame, 8, Float_Sub(0, CAD_Topo_FComp.yz))
        }
        ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FComp.n1x)
        ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FComp.n1y)
        ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FComp.n1z)
        CAD_Topo_FCove.kind = CAD_Geom.MakeTorusSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab, CAD_Topo_FCove.r)
        // Minor circle at C_ball, X=−n2_signed, Y=−n1_signed.
        CAD_Topo_FCove.n1x = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13), CAD_Topo_FComp.n1x)
        CAD_Topo_FCove.n1y = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13), CAD_Topo_FComp.n1y)
        CAD_Topo_FCove.n1z = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13), CAD_Topo_FComp.n1z)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n1x), CAD_Num.Sq(CAD_Topo_FCove.n1y)), CAD_Num.Sq(CAD_Topo_FCove.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = Float_Div(CAD_Topo_FCove.n1x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1y = Float_Div(CAD_Topo_FCove.n1y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1z = Float_Div(CAD_Topo_FCove.n1z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2x = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14), CAD_Topo_FComp.n2x)
        CAD_Topo_FCove.n2y = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14), CAD_Topo_FComp.n2y)
        CAD_Topo_FCove.n2z = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14), CAD_Topo_FComp.n2z)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n2x), CAD_Num.Sq(CAD_Topo_FCove.n2y)), CAD_Num.Sq(CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 16))
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 17))
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 18))
        ArraySet(CAD_Topo_FCove.frame, 3, Float_Sub(0, CAD_Topo_FCove.n2x))
        ArraySet(CAD_Topo_FCove.frame, 4, Float_Sub(0, CAD_Topo_FCove.n2y))
        ArraySet(CAD_Topo_FCove.frame, 5, Float_Sub(0, CAD_Topo_FCove.n2z))
        ArraySet(CAD_Topo_FCove.frame, 6, Float_Sub(0, CAD_Topo_FCove.n1x))
        ArraySet(CAD_Topo_FCove.frame, 7, Float_Sub(0, CAD_Topo_FCove.n1y))
        ArraySet(CAD_Topo_FCove.frame, 8, Float_Sub(0, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.minlen = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        IfCondition EqualTo(CAD_Topo_FCove.v1, 0) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Topo_FCove.v0 }
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.v0) ThenBlock: {
            CAD_Topo_FCove.bb = CAD_Topo.MakeEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.ok, CAD_Topo_FCove.wa)
            CAD_Topo_FCove.sn = CAD_Topo.MakeEdge(CAD_Topo_FCove.hit, CAD_Topo_FCove.hit, CAD_Topo_FCove.wb)
            CAD_Topo_FCove.lp = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.hit, CAD_Topo_FCove.minlen)
            IfCondition EqualTo(CAD_Topo_FCove.bb, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo_FCove.sn, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo.FilletBossSwap(), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        // Open arc (stadium): torus patch, not a closed circle in the loop.
        IfCondition EqualTo(CAD_Topo.FilletEmitOpenPatch(), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Contacts at a rim vertex: wall = V+srad n_rad, host = V+shost N.
Function.CAD_Topo.FilletEmitVertContact {
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(vh, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(vh, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(vh, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n2x), CAD_Num.Sq(CAD_Topo_FCove.n2y)), CAD_Num.Sq(CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.ab = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14)
        CAD_Topo_FCove.padh = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13)
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Store.Read(vh, 0), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Store.Read(vh, 1), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Store.Read(vh, 2), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2z)))
        CAD_Topo_FCove.aa = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Store.Read(vh, 0), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Store.Read(vh, 1), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Store.Read(vh, 2), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1z)))
        CAD_Topo_FCove.g = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        IfCondition EqualTo(CAD_Topo_FCove.aa, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.g, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Offset-arc span from SOLVE endpoints, same rotational sense as the
// source. Copying the source's 270° onto a 3-face T_host pair left a
// pinned chord. Do not write FCove.ab — RimMakeSeg still holds Rmaj.
Function.CAD_Topo.FilletEmitArcRail {
    Input: va: Integer
    Input: vb: Integer
    Input: circ_h: Integer
    Input: src_crv: Integer
    Input: src_edge: Integer
    Input: start_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(circ_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.d12 = 0
        IfCondition NotEqual(src_crv, 0) ThenBlock: {
            CAD_Topo_FCove.d12 = CAD_Store.Read(src_crv, 12)
            CAD_Store.Write(circ_h, 11, CAD_Store.Read(src_crv, 11))
        }
        IfCondition NotEqual(src_edge, 0) ThenBlock: {
            IfCondition NotEqual(start_v, 0) ThenBlock: {
                IfCondition NotEqual(start_v, CAD_Store.Read(src_edge, 0)) ThenBlock: {
                    CAD_Topo_FCove.d12 = Float_Sub(0, CAD_Topo_FCove.d12)
                }
            }
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.d12, 0), 1) ThenBlock: {
            ReturnValue(CAD_Topo.MakeMinorArcEdge(va, vb, circ_h))
        }
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(va, 0), CAD_Store.Read(circ_h, 1))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(va, 1), CAD_Store.Read(circ_h, 2))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(va, 2), CAD_Store.Read(circ_h, 3))
        CAD_Topo_FCove.aa = CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 7)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 8))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 9))), Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 4)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 5))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 6))))
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(vb, 0), CAD_Store.Read(circ_h, 1))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(vb, 1), CAD_Store.Read(circ_h, 2))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(vb, 2), CAD_Store.Read(circ_h, 3))
        CAD_Topo_FCove.bb = CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 7)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 8))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 9))), Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 4)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 5))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 6))))
        CAD_Topo_FCove.g = Float_Sub(CAD_Topo_FCove.bb, CAD_Topo_FCove.aa)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.d12), 1) ThenBlock: {
            CAD_Topo_FCove.g = Float_Sub(0, CAD_Num.PosMod2Pi(Float_Sub(0, CAD_Topo_FCove.g)))
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.d12), 0) ThenBlock: {
            CAD_Topo_FCove.g = CAD_Num.PosMod2Pi(CAD_Topo_FCove.g)
        }
        CAD_Store.Write(circ_h, 12, CAD_Topo_FCove.g)
        ReturnValue(CAD_Topo.MakeEdge(va, vb, circ_h))
    }
}

// Fresh Store cell every call. rb_pt / rb_ax stay the plane-rebuild
// point buffers. A handle there makes the next RebuildKind0Planes fault.
Function.CAD_Topo.FilletEmitPark {
    Output: Integer
    Body: {
        CAD_Topo_State.emit_pt = CAD_Store.Alloc(8, 16)
        ReturnValue(CAD_Topo_State.emit_pt)
    }
}

Function.CAD_Topo.FilletEmitParkRem {
    Output: Integer
    Body: {
        CAD_Topo_State.emit_ax = CAD_Store.Alloc(8, 8)
        ReturnValue(CAD_Topo_State.emit_ax)
    }
}

// 1 when vert is on the circle within 0.05 mm. The end contact of an
// equal-R neighbor fillet lands on the old circle's center; that is
// not a split point.
Function.CAD_Topo.FilletEmitPtOnCircle {
    Input: circ_h: Integer
    Input: vert_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(circ_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(vert_h, 0), CAD_Store.Read(circ_h, 1))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(vert_h, 1), CAD_Store.Read(circ_h, 2))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(vert_h, 2), CAD_Store.Read(circ_h, 3))
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
        CAD_Topo_FCove.ln = CAD_Num.Abs(Float_Sub(CAD_Topo_FCove.ln, CAD_Store.Read(circ_h, 10)))
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.ln, 0x3FA999999999999A), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when every CIRCLE support can take its new vertex. A LINE support
// is not tested. Both ends use the same test.
Function.CAD_Topo.FilletEmitMerOnSupport {
    Input: e0: Integer
    Input: v0: Integer
    Input: e1: Integer
    Input: v1: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(e0, 0) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Store.Read(e0, 2)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), 2) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FilletEmitPtOnCircle(CAD_Topo_FCove.e, v0), 0) ThenBlock: { ReturnValue(0) }
                }
            }
        }
        IfCondition NotEqual(e1, 0) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Store.Read(e1, 2)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), 2) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FilletEmitPtOnCircle(CAD_Topo_FCove.e, v1), 0) ThenBlock: { ReturnValue(0) }
                }
            }
        }
        ReturnValue(1)
    }
}

// Pull a spliced meridian coedge back out of its loop. Clears the edge
// slot and the twin so the neighbor face does not keep the sheet.
Function.CAD_Topo.FilletEmitCoedgeDrop {
    Input: ce: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.hd = CAD_Store.Read(ce, 3)
        CAD_Topo_FCove.nxt = CAD_Store.Read(ce, 2)
        IfCondition NotEqual(CAD_Topo_FCove.hd, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.hd, 2), ce) ThenBlock: {
                CAD_Store.Write(CAD_Topo_FCove.hd, 2, CAD_Topo_FCove.nxt)
            }
        }
        IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.nxt, 3), ce) ThenBlock: {
                CAD_Store.Write(CAD_Topo_FCove.nxt, 3, CAD_Topo_FCove.hd)
            }
        }
        CAD_Topo_FCove.lp = CAD_Store.Read(ce, 4)
        IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.lp, 0), ce) ThenBlock: {
                CAD_Store.Write(CAD_Topo_FCove.lp, 0, CAD_Topo_FCove.nxt)
            }
        }
        CAD_Topo_FCove.e = CAD_Store.Read(ce, 0)
        IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 4), ce) ThenBlock: { CAD_Store.Write(CAD_Topo_FCove.e, 4, 0) }
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 3), ce) ThenBlock: { CAD_Store.Write(CAD_Topo_FCove.e, 3, 0) }
        }
        CAD_Topo_FCove.ce = CAD_Store.Read(ce, 1)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.ce, 1), ce) ThenBlock: { CAD_Store.Write(CAD_Topo_FCove.ce, 1, 0) }
        }
        CAD_Store.Write(ce, 1, 0)
        CAD_Store.Write(ce, 2, 0)
        CAD_Store.Write(ce, 3, 0)
        ReturnValue(1)
    }
}

// Circle split failed after the splice. Drop that coedge. A LINE
// support that already moved is put back; a circle split is left.
Function.CAD_Topo.FilletEmitMerUndo {
    Input: ce: Integer
    Input: e0: Integer
    Input: v0: Integer
    Input: e1: Integer
    Input: v1: Integer
    Input: old_v: Integer
    Output: Integer
    Body: {
        CAD_Topo.FilletEmitCoedgeDrop(ce)
        IfCondition NotEqual(e0, 0) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Store.Read(e0, 2)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), 1) ThenBlock: {
                    CAD_Topo.EdgeRetargetVert(e0, v0, old_v)
                }
            }
        }
        IfCondition NotEqual(e1, 0) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Store.Read(e1, 2)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), 1) ThenBlock: {
                    CAD_Topo.EdgeRetargetVert(e1, v1, old_v)
                }
            }
        }
        ReturnValue(1)
    }
}

// Dispatch from edge Store curve kind, not FLoc.which after Geom.
Function.CAD_Topo.FilletEmitMerSupport {
    Input: edge_h: Integer
    Input: old_v: Integer
    Input: new_v: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.e = 0
        CAD_Topo_FCove.kind = 0
        IfCondition NotEqual(edge_h, 0) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Store.Read(edge_h, 2)
        }
        IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
            CAD_Topo_FCove.kind = CAD_Store.Read(CAD_Topo_FCove.e, 0)
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("mer ce=", 7, CAD_Topo_FLoc.ce)
        CAD_Topo.FilletDumpI(" lp=", 4, CAD_Topo_FLoc.lp)
        CAD_Topo.FilletDumpI(" e=", 3, edge_h)
        CAD_Topo.FilletDumpI(" crv=", 5, CAD_Topo_FCove.e)
        CAD_Topo.FilletDumpI(" k=", 3, CAD_Topo_FCove.kind)
        CAD_Topo.FilletDumpI(" which=", 7, CAD_Topo_FLoc.which)
        CAD_Topo.FilletDumpS("\n", 1)
        IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: {
            ReturnValue(CAD_Topo.FilletEmitCircleEnd(edge_h, old_v, new_v))
        }
        ReturnValue(CAD_Topo.EdgeRetargetVert(edge_h, old_v, new_v))
    }
}

// Other coedge of this rim: CIRCLE same R and cz, owns old_v, not skip_edge.
// Cap CircleEnd finds the wall rail (822 after a prior split); wall finds cap.
Function.CAD_Topo.FilletEmitRimMateCe {
    Input: src_crv: Integer
    Input: skip_edge: Integer
    Input: old_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src_crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.solid, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.shell = CAD_Store.Read(CAD_Topo_FLoc.solid, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.shell, 0)
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 16) {
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.g = 16 }
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.which, 1)
                IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                    CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
                    CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
                    CAD_Topo_FCove.j = 0
                    WhileLoop LessThan(CAD_Topo_FCove.j, 16) {
                        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.j = 16 }
                        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                            CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                                IfCondition NotEqual(CAD_Topo_FCove.e, skip_edge) ThenBlock: {
                                    CAD_Topo_FCove.ok = 0
                                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), old_v) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), old_v) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                                    IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                                        CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                                        IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: {
                                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.nxt, 0), 2) ThenBlock: {
                                                IfCondition EqualTo(CAD_Num.IsZero(Float_Sub(CAD_Store.Read(CAD_Topo_FCove.nxt, 10), CAD_Store.Read(src_crv, 10)), 0), 1) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Num.IsZero(Float_Sub(CAD_Store.Read(CAD_Topo_FCove.nxt, 3), CAD_Store.Read(src_crv, 3)), 0), 1) ThenBlock: {
                                                        ReturnValue(CAD_Topo_FCove.ce)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                            IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.j = 16 }
                        }
                        CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
                    }
                }
                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.which, 3)
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ReturnValue(0)
    }
}

// Enclosure probes after plane∩cyl Local. Not a height gate on C.
Function.CAD_Topo.FilletEmitEnclosureProbe {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FLoc.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        ArraySet(CAD_Topo_FCove.pt, 2, 0x3FF0000000000000)
        CAD_Topo.FilletDumpI("encl z1=", 8, CAD_Topo.PointInSolid(CAD_Topo_FLoc.solid, CAD_Topo_FCove.pt))
        ArraySet(CAD_Topo_FCove.pt, 2, 0x4033000000000000)
        CAD_Topo.FilletDumpI(" z19=", 5, CAD_Topo.PointInSolid(CAD_Topo_FLoc.solid, CAD_Topo_FCove.pt))
        IfCondition NotEqual(CAD_Topo_FLoc.v1, 0) ThenBlock: {
            ArraySet(CAD_Topo_FCove.pt, 0, Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 0), CAD_Store.Read(CAD_Topo_FLoc.v1, 0)), 0x3FE0000000000000))
            ArraySet(CAD_Topo_FCove.pt, 1, Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 1), CAD_Store.Read(CAD_Topo_FLoc.v1, 1)), 0x3FE0000000000000))
            ArraySet(CAD_Topo_FCove.pt, 2, 0x4014000000000000)
            CAD_Topo.FilletDumpI(" chordz5=", 9, CAD_Topo.PointInSolid(CAD_Topo_FLoc.solid, CAD_Topo_FCove.pt))
        }
        IfCondition NotEqual(CAD_Topo_FLoc.va0, 0) ThenBlock: { CAD_Topo.FilletDumpU(" va0z=", 6, CAD_Store.Read(CAD_Topo_FLoc.va0, 2)) }
        IfCondition NotEqual(CAD_Topo_FLoc.va1, 0) ThenBlock: { CAD_Topo.FilletDumpU(" va1z=", 6, CAD_Store.Read(CAD_Topo_FLoc.va1, 2)) }
        IfCondition NotEqual(CAD_Topo_FLoc.vb0, 0) ThenBlock: { CAD_Topo.FilletDumpU(" vb0z=", 6, CAD_Store.Read(CAD_Topo_FLoc.vb0, 2)) }
        IfCondition NotEqual(CAD_Topo_FLoc.vb1, 0) ThenBlock: { CAD_Topo.FilletDumpU(" vb1z=", 6, CAD_Store.Read(CAD_Topo_FLoc.vb1, 2)) }
        CAD_Topo.FilletDumpS("\n", 1)
        CAD_Topo_FCove.shell = CAD_Store.Read(CAD_Topo_FLoc.solid, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.shell, 0)
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 16) {
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.g = 16 }
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                CAD_Topo_FCove.kind = CAD_Topo.FilletIRFaceKind(CAD_Topo_FCove.which)
                CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.which, 1)
                CAD_Topo.FilletDumpI("face=", 5, CAD_Topo_FCove.which)
                CAD_Topo.FilletDumpI(" k=", 3, CAD_Topo_FCove.kind)
                IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                    CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
                    CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
                    CAD_Topo_FCove.j = 0
                    WhileLoop LessThan(CAD_Topo_FCove.j, 8) {
                        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.j = 8 }
                        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                            CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                            CAD_Topo_FCove.s = 0
                            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                                CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                                IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: { CAD_Topo_FCove.s = CAD_Store.Read(CAD_Topo_FCove.nxt, 0) }
                            }
                            CAD_Topo.FilletDumpI(" e=", 3, CAD_Topo_FCove.e)
                            CAD_Topo.FilletDumpI(" ck=", 4, CAD_Topo_FCove.s)
                            IfCondition EqualTo(CAD_Topo_FCove.s, 2) ThenBlock: {
                                CAD_Topo.FilletDumpU(" R=", 3, CAD_Store.Read(CAD_Topo_FCove.nxt, 10))
                                CAD_Topo.FilletDumpU(" cz=", 4, CAD_Store.Read(CAD_Topo_FCove.nxt, 3))
                                CAD_Topo.FilletDumpU(" sp=", 4, CAD_Store.Read(CAD_Topo_FCove.nxt, 12))
                            }
                            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                            IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.j = 8 }
                        }
                        CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
                    }
                }
                CAD_Topo.FilletDumpS("\n", 1)
                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.which, 3)
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ReturnValue(1)
    }
}

// 1 when edge idx belongs to face_h. Slot 19 wins. A coedge match is
// only for an edge that never got a host, so a side wall does not
// steal the top edge that also bounds it.
Function.CAD_Topo.FilletEmitOnHost {
    Input: idx: Integer
    Input: face_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        s19 = CAD_Topo.FilletIRGet(idx, 19)
        IfCondition EqualTo(s19, face_h) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(s19, 0) ThenBlock: { ReturnValue(0) }
        eh = CAD_Topo.FilletIRGet(idx, 0)
        IfCondition EqualTo(eh, 0) ThenBlock: { ReturnValue(0) }
        hit = CAD_Topo.FindCoedgeOnFace(face_h, eh)
        IfCondition NotEqual(hit, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Sharp verticals after the host rims. Both gram flags mean a real
// corner. A cove side still uses the convex canal so the center is the
// one already on the rim. G1 seams (gram 0) stay.
Function.CAD_Topo.FilletEmitVertCanals {
    Input: solid_handle: Integer
    Input: radius_r: Integer
    Input: nleft: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nleft, 1) ThenBlock: { ReturnValue(solid_handle) }
        ncan = 0
        i = 0
        WhileLoop LessThan(i, nleft) {
            e = ArrayGet(CAD_Topo_FComp.left, i)
            idx = CAD_Topo.FilletIRIndexOf(e)
            IfCondition GreaterEqual(idx, 0) ThenBlock: {
                g0 = CAD_Topo.FilletIRVSolGet(idx, 12)
                g1 = CAD_Topo.FilletIRVSolGet(idx, 13)
                IfCondition EqualTo(g0, 1) ThenBlock: {
                    IfCondition EqualTo(g1, 1) ThenBlock: {
                        sd = CAD_Topo.FilletIRGet(idx, 3)
                        IfCondition EqualTo(sd, 0) ThenBlock: {
                            CAD_Topo.FilletIRPut(idx, 3, 1)
                        }
                        CAD_Topo_State.fillet_concave = 0
                        CAD_Topo_State.fillet_reason = 0
                        h = CAD_Topo.FilletEdgeLocal(solid_handle, e, radius_r)
                        IfCondition EqualTo(sd, 0) ThenBlock: {
                            CAD_Topo.FilletIRPut(idx, 3, 0)
                        }
                        IfCondition NotEqual(h, 0) ThenBlock: { ncan = Add(ncan, 1) }
                        IfCondition EqualTo(h, 0) ThenBlock: {
                            PrintMessage("fillet canal miss i=")
                            PrintNumber(i)
                            PrintMessage("\n")
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        PrintMessage("fillet canal n=")
        PrintNumber(ncan)
        PrintMessage("\n")
        CAD_Topo_State.fillet_concave = 0
        CAD_Topo_State.fillet_reason = 0
        CAD_Topo.FilletVerticesAfter(solid_handle, radius_r)
        ReturnValue(solid_handle)
    }
}

