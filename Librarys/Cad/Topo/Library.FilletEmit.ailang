// CAD.Topo.FilletEmit — B-Rep mutation from FilletIR solve pack.
// Plane–cyl: one torus. Top vs bottom is N_host. Frames are right-handed on N_host
// (copying the rim circle XY with Z=−N_host was left-handed and broke bottom).
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.FilletEmitFillFrame {
    Output: Integer
    Body: {
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 12) {
            ArraySet(CAD_Topo_FCove.frame, CAD_Topo_FCove.g, 0)
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        // Host/wall circles must keep the rim XY. Flipping Y to make the
        // torus right-handed reversed the bottom-cap loop and sheared the
        // solid (standalone bottom fillet). det is stored; torus flips later.
        CAD_Topo_FComp.xx = CAD_Store.Read(CAD_Topo_FCove.which, 4)
        CAD_Topo_FComp.xy = CAD_Store.Read(CAD_Topo_FCove.which, 5)
        CAD_Topo_FComp.xz = CAD_Store.Read(CAD_Topo_FCove.which, 6)
        CAD_Topo_FComp.yx = CAD_Store.Read(CAD_Topo_FCove.which, 7)
        CAD_Topo_FComp.yy = CAD_Store.Read(CAD_Topo_FCove.which, 8)
        CAD_Topo_FComp.yz = CAD_Store.Read(CAD_Topo_FCove.which, 9)
        CAD_Topo_FCove.d12 = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.yz), CAD_Num.Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.yy))
        CAD_Topo_FCove.d13 = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.yx), CAD_Num.Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.yz))
        CAD_Topo_FCove.d23 = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.yy), CAD_Num.Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.yx))
        CAD_Topo_FCove.det = Float_Add(Float_Add(CAD_Num.Mul(CAD_Topo_FCove.d12, CAD_Topo_FComp.n1x), CAD_Num.Mul(CAD_Topo_FCove.d13, CAD_Topo_FComp.n1y)), CAD_Num.Mul(CAD_Topo_FCove.d23, CAD_Topo_FComp.n1z))
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FComp.xx)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FComp.xy)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FComp.xz)
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FComp.yx)
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FComp.yy)
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FComp.yz)
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletEmitMakeGeom {
    Output: Integer
    Body: {
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 0))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 1))
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 2))
        CAD_Topo_FCove.ok = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 3))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 4))
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 5))
        CAD_Topo_FCove.hit = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.aa = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 15)
        CAD_Topo_FCove.ab = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 12)
        CAD_Topo_FCove.padh = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13)
        // Wall circle on the host plane, radius Rmaj. Origin = rim circle O.
        CAD_Topo.FilletEmitFillFrame()
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        CAD_Topo_FCove.wa = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab)
        CAD_Store.Write(CAD_Topo_FCove.wa, 12, 0x401921FB54442D18)
        // Host circle + torus at A0 + s_host N_host.
        ArraySet(CAD_Topo_FCove.frame, 0, Float_Add(CAD_Topo_FCove.cx, CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1x)))
        ArraySet(CAD_Topo_FCove.frame, 1, Float_Add(CAD_Topo_FCove.cy, CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1y)))
        ArraySet(CAD_Topo_FCove.frame, 2, Float_Add(CAD_Topo_FCove.cz, CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1z)))
        CAD_Topo_FCove.wb = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.aa)
        CAD_Store.Write(CAD_Topo_FCove.wb, 12, 0x401921FB54442D18)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.det), 1) ThenBlock: {
            ArraySet(CAD_Topo_FCove.frame, 6, Float_Sub(0, CAD_Topo_FComp.yx))
            ArraySet(CAD_Topo_FCove.frame, 7, Float_Sub(0, CAD_Topo_FComp.yy))
            ArraySet(CAD_Topo_FCove.frame, 8, Float_Sub(0, CAD_Topo_FComp.yz))
        }
        ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FComp.n1x)
        ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FComp.n1y)
        ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FComp.n1z)
        CAD_Topo_FCove.kind = CAD_Geom.MakeTorusSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab, CAD_Topo_FCove.r)
        // Minor circle at C_ball, X=−n2_signed, Y=−n1_signed.
        CAD_Topo_FCove.n1x = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13), CAD_Topo_FComp.n1x)
        CAD_Topo_FCove.n1y = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13), CAD_Topo_FComp.n1y)
        CAD_Topo_FCove.n1z = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13), CAD_Topo_FComp.n1z)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n1x), CAD_Num.Sq(CAD_Topo_FCove.n1y)), CAD_Num.Sq(CAD_Topo_FCove.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = Float_Div(CAD_Topo_FCove.n1x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1y = Float_Div(CAD_Topo_FCove.n1y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1z = Float_Div(CAD_Topo_FCove.n1z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2x = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14), CAD_Topo_FComp.n2x)
        CAD_Topo_FCove.n2y = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14), CAD_Topo_FComp.n2y)
        CAD_Topo_FCove.n2z = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14), CAD_Topo_FComp.n2z)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n2x), CAD_Num.Sq(CAD_Topo_FCove.n2y)), CAD_Num.Sq(CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 16))
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 17))
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 18))
        ArraySet(CAD_Topo_FCove.frame, 3, Float_Sub(0, CAD_Topo_FCove.n2x))
        ArraySet(CAD_Topo_FCove.frame, 4, Float_Sub(0, CAD_Topo_FCove.n2y))
        ArraySet(CAD_Topo_FCove.frame, 5, Float_Sub(0, CAD_Topo_FCove.n2z))
        ArraySet(CAD_Topo_FCove.frame, 6, Float_Sub(0, CAD_Topo_FCove.n1x))
        ArraySet(CAD_Topo_FCove.frame, 7, Float_Sub(0, CAD_Topo_FCove.n1y))
        ArraySet(CAD_Topo_FCove.frame, 8, Float_Sub(0, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.minlen = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        IfCondition EqualTo(CAD_Topo_FCove.v1, 0) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Topo_FCove.v0 }
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.v0) ThenBlock: {
            CAD_Topo_FCove.bb = CAD_Topo.MakeEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.ok, CAD_Topo_FCove.wa)
            CAD_Topo_FCove.sn = CAD_Topo.MakeEdge(CAD_Topo_FCove.hit, CAD_Topo_FCove.hit, CAD_Topo_FCove.wb)
            CAD_Topo_FCove.lp = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.hit, CAD_Topo_FCove.minlen)
            IfCondition EqualTo(CAD_Topo_FCove.bb, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo_FCove.sn, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo.FilletBossSwap(), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        // Open arc (stadium): torus patch, not a closed circle in the loop.
        IfCondition EqualTo(CAD_Topo.FilletEmitOpenPatch(), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Contacts at a rim vertex: wall = V+srad n_rad, host = V+shost N.
Function.CAD_Topo.FilletEmitVertContact {
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(vh, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(vh, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(vh, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n2x), CAD_Num.Sq(CAD_Topo_FCove.n2y)), CAD_Num.Sq(CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.ab = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14)
        CAD_Topo_FCove.padh = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13)
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Store.Read(vh, 0), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Store.Read(vh, 1), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Store.Read(vh, 2), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2z)))
        CAD_Topo_FCove.aa = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Store.Read(vh, 0), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Store.Read(vh, 1), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Store.Read(vh, 2), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1z)))
        CAD_Topo_FCove.g = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        IfCondition EqualTo(CAD_Topo_FCove.aa, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.g, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletEmitOpenPatch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo.FilletEmitVertContact(CAD_Topo_FCove.v0), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok = CAD_Topo_FCove.aa
        CAD_Topo_FCove.hit = CAD_Topo_FCove.g
        IfCondition EqualTo(CAD_Topo.FilletEmitVertContact(CAD_Topo_FCove.v1), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok1 = CAD_Topo_FCove.aa
        CAD_Topo_FCove.hit1 = CAD_Topo_FCove.g
        CAD_Topo_FCove.bb = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.ok1, CAD_Topo_FCove.wa)
        CAD_Topo_FCove.sn = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.hit, CAD_Topo_FCove.hit1, CAD_Topo_FCove.wb)
        CAD_Topo_FCove.lp = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.hit, CAD_Topo_FCove.minlen)
        ArraySet(CAD_Topo_FCove.frame, 0, Float_Add(Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 0), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1x)), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.frame, 1, Float_Add(Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 1), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1y)), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.frame, 2, Float_Add(Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1z)), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2z)))
        ArraySet(CAD_Topo_FCove.frame, 3, Float_Sub(0, CAD_Topo_FCove.n2x))
        ArraySet(CAD_Topo_FCove.frame, 4, Float_Sub(0, CAD_Topo_FCove.n2y))
        ArraySet(CAD_Topo_FCove.frame, 5, Float_Sub(0, CAD_Topo_FCove.n2z))
        ArraySet(CAD_Topo_FCove.frame, 6, Float_Sub(0, CAD_Topo_FComp.n1x))
        ArraySet(CAD_Topo_FCove.frame, 7, Float_Sub(0, CAD_Topo_FComp.n1y))
        ArraySet(CAD_Topo_FCove.frame, 8, Float_Sub(0, CAD_Topo_FComp.n1z))
        CAD_Topo_FCove.minlen = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
        CAD_Topo_FCove.lp1 = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok1, CAD_Topo_FCove.hit1, CAD_Topo_FCove.minlen)
        IfCondition EqualTo(CAD_Topo_FCove.bb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.sn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.lp1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletOpenSwap(), 0) ThenBlock: { ReturnValue(0) }
        PrintMessage("fillet emit OPEN arc\n")
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletOpenSwap {
    Output: Integer
    Body: {
        CAD_Topo_FCove.nxt1 = 0
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f2, CAD_Topo_FCove.e)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Topo_FCove.nxt1 = CAD_Topo.FilletIRFindGen(CAD_Topo_FCove.ce, CAD_Topo_FCove.v1)
        }
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.host_f, CAD_Topo_FCove.e)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo_FCove.bb, CAD_Topo_FCove.ok)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f2, CAD_Topo_FCove.e)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo_FCove.sn, CAD_Topo_FCove.hit)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.prv = CAD_Topo_FCove.ce
        IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: {
            CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.nxt, CAD_Topo_FCove.v0, CAD_Topo_FCove.hit)
        }
        IfCondition NotEqual(CAD_Topo_FCove.nxt1, 0) ThenBlock: {
            CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.nxt1, CAD_Topo_FCove.v1, CAD_Topo_FCove.hit1)
        }
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.bb, 0), CAD_Topo_FCove.ok) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.MakeCoedge(CAD_Topo_FCove.bb, CAD_Topo_FCove.ok, CAD_Topo_FCove.which))
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.lp1, 0), CAD_Topo_FCove.ok1) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.MakeCoedge(CAD_Topo_FCove.lp1, CAD_Topo_FCove.ok1, CAD_Topo_FCove.which))
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.sn, 0), CAD_Topo_FCove.hit1) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.MakeCoedge(CAD_Topo_FCove.sn, CAD_Topo_FCove.hit1, CAD_Topo_FCove.which))
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.lp, 0), CAD_Topo_FCove.hit) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 3, CAD_Topo.MakeCoedge(CAD_Topo_FCove.lp, CAD_Topo_FCove.hit, CAD_Topo_FCove.which))
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 4, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.which = CAD_Topo.MakeFace(CAD_Topo_FCove.kind, CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.which), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletEmitPlaneCyl {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIREnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(edge_handle)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.h), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 11), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 15), 4) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.solid = solid_handle
        CAD_Topo_FCove.e = edge_handle
        CAD_Topo_FCove.r = radius_r
        CAD_Topo_FCove.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.host_f = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 19)
        CAD_Topo_FCove.f2 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 20)
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.v0 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 23)
        CAD_Topo_FCove.nxt = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 22)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.nxt, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.nxt, 0)
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.v0) ThenBlock: {
            CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.nxt, 1)
        }
        CAD_Topo_FComp.n1x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 6)
        CAD_Topo_FComp.n1y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 7)
        CAD_Topo_FComp.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 8)
        CAD_Topo_FComp.n2x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 9)
        CAD_Topo_FComp.n2y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 10)
        CAD_Topo_FComp.n2z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 11)
        CAD_Topo_FCove.n3x = CAD_Topo_FComp.n1x
        CAD_Topo_FCove.n3y = CAD_Topo_FComp.n1y
        CAD_Topo_FCove.n3z = CAD_Topo_FComp.n1z
        CAD_Topo_FCove.which = CAD_Store.Read(edge_handle, 2)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.which, 1)
        CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.which, 2)
        CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.which, 3)
        CAD_Topo_FCove.s = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 21)
        PrintMessage("fillet emit plane-cyl mode=")
        PrintNumber(CAD_Topo_FCove.s)
        PrintMessage(" Rmaj=")
        PrintNumber(Float_ToInt(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 12)))
        PrintMessage(" Nz=")
        CAD_Topo_FComp.k = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.n1z), 1) ThenBlock: { CAD_Topo_FComp.k = Subtract(0, 1) }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.n1z), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.n1z, 0), 0) ThenBlock: { CAD_Topo_FComp.k = 1 }
        }
        PrintNumber(CAD_Topo_FComp.k)
        PrintMessage("\n")
        IfCondition EqualTo(CAD_Topo.FilletEmitMakeGeom(), 0) ThenBlock: { ReturnValue(0) }
        PrintMessage("fillet emit torus ok\n")
        ReturnValue(CAD_Topo_FCove.solid)
    }
}

// Offset arc with the SOURCE edge's signed span. MakeMinorArcEdge is
// the short way in (-π, π]; stadium caps are ±π and must not flip.
Function.CAD_Topo.FilletEmitArcRail {
    Input: va: Integer
    Input: vb: Integer
    Input: circ_h: Integer
    Input: src_crv: Integer
    Input: src_edge: Integer
    Input: start_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(circ_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.d12 = 0
        IfCondition NotEqual(src_crv, 0) ThenBlock: {
            CAD_Topo_FCove.d12 = CAD_Store.Read(src_crv, 12)
            CAD_Store.Write(circ_h, 11, CAD_Store.Read(src_crv, 11))
        }
        IfCondition NotEqual(src_edge, 0) ThenBlock: {
            IfCondition NotEqual(start_v, 0) ThenBlock: {
                IfCondition NotEqual(start_v, CAD_Store.Read(src_edge, 0)) ThenBlock: {
                    CAD_Topo_FCove.d12 = Float_Sub(0, CAD_Topo_FCove.d12)
                }
            }
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.d12, 0), 1) ThenBlock: {
            ReturnValue(CAD_Topo.MakeMinorArcEdge(va, vb, circ_h))
        }
        CAD_Store.Write(circ_h, 12, CAD_Topo_FCove.d12)
        ReturnValue(CAD_Topo.MakeEdge(va, vb, circ_h))
    }
}

// Host = the plane the most selected edges already name (IR 19) or
// sit on. Do not require mix or FindCoedge — after a top chamfer the
// bottom coedge walk can miss while the four rims are still a loop.
Function.CAD_Topo.FilletEmitPickChain {
    Output: Integer
    Body: {
        CAD_Topo_FComp.host = 0
        CAD_Topo_FComp.ok = 0
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            CAD_Topo_FComp.which = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
            IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: {
                CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
                IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FComp.e, CAD_Topo_FComp.faces), 0) ThenBlock: {
                    CAD_Topo_FComp.which = ArrayGet(CAD_Topo_FComp.faces, 0)
                    IfCondition NotEqual(CAD_Topo.FilletIRFaceKind(CAD_Topo_FComp.which), 1) ThenBlock: {
                        CAD_Topo_FComp.which = ArrayGet(CAD_Topo_FComp.faces, 1)
                    }
                }
            }
            IfCondition NotEqual(CAD_Topo_FComp.which, 0) ThenBlock: {
                CAD_Topo_FComp.k = 0
                CAD_Topo_FComp.j = 0
                WhileLoop LessThan(CAD_Topo_FComp.j, CAD_Topo_FComp.n) {
                    CAD_Topo_FComp.ce = 0
                    IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 19), CAD_Topo_FComp.which) ThenBlock: {
                        CAD_Topo_FComp.ce = 1
                    }
                    IfCondition EqualTo(CAD_Topo_FComp.ce, 0) ThenBlock: {
                        CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0)
                        IfCondition NotEqual(CAD_Topo.FindCoedgeOnFace(CAD_Topo_FComp.which, CAD_Topo_FComp.e), 0) ThenBlock: {
                            CAD_Topo_FComp.ce = 1
                        }
                    }
                    IfCondition EqualTo(CAD_Topo_FComp.ce, 1) ThenBlock: {
                        CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
                    }
                    CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
                }
                IfCondition GreaterThan(CAD_Topo_FComp.k, CAD_Topo_FComp.ok) ThenBlock: {
                    CAD_Topo_FComp.ok = CAD_Topo_FComp.k
                    CAD_Topo_FComp.host = CAD_Topo_FComp.which
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        CAD_Topo_FCove.n = 0
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
            CAD_Topo_FComp.ce = 0
            IfCondition EqualTo(CAD_Topo_FComp.host, 0) ThenBlock: { CAD_Topo_FComp.ce = 1 }
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19), CAD_Topo_FComp.host) ThenBlock: {
                CAD_Topo_FComp.ce = 1
            }
            IfCondition EqualTo(CAD_Topo_FComp.ce, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FindCoedgeOnFace(CAD_Topo_FComp.host, CAD_Topo_FComp.e), 0) ThenBlock: {
                    CAD_Topo_FComp.ce = 1
                }
            }
            IfCondition EqualTo(CAD_Topo_FComp.ce, 1) ThenBlock: {
                IfCondition LessThan(CAD_Topo_FCove.n, 12) ThenBlock: {
                    CAD_Topo.FCoveSet(372, CAD_Topo_FCove.n, CAD_Topo_FComp.e)
                    CAD_Topo_FCove.n = Add(CAD_Topo_FCove.n, 1)
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        IfCondition LessThan(CAD_Topo_FCove.n, 3) ThenBlock: {
            CAD_Topo_FCove.n = 0
            CAD_Topo_FComp.i = 0
            WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
                CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
                IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                    IfCondition LessThan(CAD_Topo_FCove.n, 12) ThenBlock: {
                        CAD_Topo.FCoveSet(372, CAD_Topo_FCove.n, CAD_Topo_FComp.e)
                        CAD_Topo_FCove.n = Add(CAD_Topo_FCove.n, 1)
                    }
                }
                CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
            }
        }
        PrintMessage("fillet IR pick n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage(" of ")
        PrintNumber(CAD_Topo_FComp.n)
        PrintMessage("\n")
        IfCondition LessThan(CAD_Topo_FCove.n, 3) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Slot 36 = 2D convex (r−R) vs concave (r+R). Do NOT use PointInFaceUV:
// a concentric stadium's arc centre sits in the hole, so UV says "outside"
// and outer caps were tagged ID (r+R flange). IR mode/inner is the source.
Function.CAD_Topo.FilletEmitTagFromIR {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 1)
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo_FComp.j = 0
            WhileLoop LessThan(CAD_Topo_FComp.j, CAD_Topo_FComp.n) {
                IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0), CAD_Topo_FCove.e) ThenBlock: {
                    CAD_Topo_FComp.mode = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 21)
                    CAD_Topo_FComp.inner = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 2)
                    CAD_Topo_FComp.ok = 1
                    IfCondition EqualTo(CAD_Topo_FComp.inner, 1) ThenBlock: { CAD_Topo_FComp.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: { CAD_Topo_FComp.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: { CAD_Topo_FComp.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FComp.mode, 2) ThenBlock: { CAD_Topo_FComp.ok = 1 }
                    CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, CAD_Topo_FComp.ok)
                    PrintMessage("fillet IR tag i=")
                    PrintNumber(CAD_Topo_FCove.i)
                    PrintMessage(" inner=")
                    PrintNumber(CAD_Topo_FComp.inner)
                    PrintMessage(" mode=")
                    PrintNumber(CAD_Topo_FComp.mode)
                    PrintMessage(" conv=")
                    PrintNumber(CAD_Topo_FComp.ok)
                    PrintMessage("\n")
                    CAD_Topo_FComp.j = CAD_Topo_FComp.n
                }
                CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

// Host face + outward N_host + per-edge wall from IR (not FaceGetPlane[0]).
// Bottom plane often stores +Z (into the solid); Analyze already flipped it.
Function.CAD_Topo.FilletEmitBindFromIR {
    Output: Integer
    Body: {
        CAD_Topo_FCove.host_f = 0
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 11), 1) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19), 0) ThenBlock: {
                    CAD_Topo_FCove.host_f = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
                    CAD_Topo_FCove.n1x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 6)
                    CAD_Topo_FCove.n1y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 7)
                    CAD_Topo_FCove.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 8)
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: {
            CAD_Topo_FComp.i = 0
            WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
                IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19), 0) ThenBlock: {
                    CAD_Topo_FCove.host_f = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
                    CAD_Topo_FCove.n1x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 6)
                    CAD_Topo_FCove.n1y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 7)
                    CAD_Topo_FCove.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 8)
                }
                CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n1x), CAD_Num.Sq(CAD_Topo_FCove.n1y)), CAD_Num.Sq(CAD_Topo_FCove.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: {
            IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.host_f, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.n1x = ArrayGet(CAD_Topo_FCove.pl, 10)
            CAD_Topo_FCove.n1y = ArrayGet(CAD_Topo_FCove.pl, 11)
            CAD_Topo_FCove.n1z = ArrayGet(CAD_Topo_FCove.pl, 12)
            CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n1x), CAD_Num.Sq(CAD_Topo_FCove.n1y)), CAD_Num.Sq(CAD_Topo_FCove.n1z)))
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = Float_Div(CAD_Topo_FCove.n1x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1y = Float_Div(CAD_Topo_FCove.n1y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1z = Float_Div(CAD_Topo_FCove.n1z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo_FCove.f2 = 0
            CAD_Topo_FCove.kind = 1
            CAD_Topo_FComp.j = 0
            WhileLoop LessThan(CAD_Topo_FComp.j, CAD_Topo_FComp.n) {
                IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0), CAD_Topo_FCove.e) ThenBlock: {
                    CAD_Topo_FCove.f2 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 20)
                    CAD_Topo_FCove.kind = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 1)
                    CAD_Topo_FComp.j = CAD_Topo_FComp.n
                }
                CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
            }
            IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: {
                    CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 1)
                    IfCondition EqualTo(CAD_Topo_FCove.f2, CAD_Topo_FCove.host_f) ThenBlock: {
                        CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 0)
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.kind, 0) ThenBlock: { CAD_Topo_FCove.kind = 1 }
            CAD_Topo.FCoveSet(48, CAD_Topo_FCove.i, CAD_Topo_FCove.f2)
            CAD_Topo.FCoveSet(24, CAD_Topo_FCove.i, CAD_Topo_FCove.kind)
            CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 1)
            CAD_Topo.FCoveSet(384, CAD_Topo_FCove.i, 0)
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        PrintMessage("fillet IR emit host Nz=")
        CAD_Topo_FComp.k = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.n1z), 1) ThenBlock: { CAD_Topo_FComp.k = Subtract(0, 1) }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.n1z), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.n1z, 0), 0) ThenBlock: { CAD_Topo_FComp.k = 1 }
        }
        PrintNumber(CAD_Topo_FComp.k)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Compiler EMIT: build every rail from the IR, then one host/wall rewrite.
// Sequential Local after torus patches tore the oval (shells=7 faces=82).
Function.CAD_Topo.FilletEmitChain {
    Input: solid_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIREnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CAD_Topo_FComp.n, 3) ThenBlock: { ReturnValue(0) }
        CAD_Topo_State.fillet_reason = 0
        CAD_Topo_FCove.solid = solid_handle
        CAD_Topo_FCove.r = radius_r
        CAD_Topo_FCove.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletEmitPickChain(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 21
            PrintMessage("fillet IR emit no chain\n")
            ReturnValue(0)
        }
        PrintMessage("fillet IR emit loop n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        IfCondition EqualTo(CAD_Topo.RimOrder(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 22
            PrintMessage("fillet IR emit order FAIL\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.FilletEmitBindFromIR(), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.RimFillHost(), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 23
                PrintMessage("fillet IR emit host FAIL\n")
                ReturnValue(0)
            }
        }
        CAD_Topo.FilletEmitTagFromIR()
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimSolveVert(CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 24
                PrintMessage("fillet IR emit vert FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.MixFixSharp(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 24
            PrintMessage("fillet IR emit vert3 FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimMakeSeg(CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 25
                PrintMessage("fillet IR emit seg FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimSwap(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 26
            PrintMessage("fillet IR emit swap FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveMakeJoinFace(CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 27
                PrintMessage("fillet IR emit face FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.MixMakeSphere(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 27
            PrintMessage("fillet IR emit sphere FAIL\n")
            ReturnValue(0)
        }
        PrintMessage("fillet IR emit ok n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        ReturnValue(solid_handle)
    }
}
