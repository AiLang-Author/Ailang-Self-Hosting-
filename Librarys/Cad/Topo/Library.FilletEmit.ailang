// CAD.Topo.FilletEmit — B-Rep mutation from FilletIR solve pack.
// Plane–cyl: one torus. Top vs bottom is N_host. Frames are right-handed on N_host
// (copying the rim circle XY with Z=−N_host was left-handed and broke bottom).
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Sys

// N of a support face at FComp.px. Plane from FaceGetPlane; cylinder
// radial (P−O) minus axis. Writes n2*. 1 ok.
Function.CAD_Topo.FilletFaceN {
    Input: face_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FaceGetPlane(face_h, CAD_Topo_FComp.pl), 0) ThenBlock: {
            CAD_Topo_FComp.n2x = ArrayGet(CAD_Topo_FComp.pl, 10)
            CAD_Topo_FComp.n2y = ArrayGet(CAD_Topo_FComp.pl, 11)
            CAD_Topo_FComp.n2z = ArrayGet(CAD_Topo_FComp.pl, 12)
            CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n2z)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.n2x = Float_Div(CAD_Topo_FComp.n2x, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.n2y = Float_Div(CAD_Topo_FComp.n2y, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.n2z = Float_Div(CAD_Topo_FComp.n2z, CAD_Topo_FComp.ln)
            ReturnValue(1)
        }
        CAD_Topo_FComp.which = CAD_Store.Read(face_h, 0)
        IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FComp.which, 0), 2) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.n2x = Float_Sub(CAD_Topo_FComp.px, CAD_Store.Read(CAD_Topo_FComp.which, 1))
        CAD_Topo_FComp.n2y = Float_Sub(CAD_Topo_FComp.py, CAD_Store.Read(CAD_Topo_FComp.which, 2))
        CAD_Topo_FComp.n2z = Float_Sub(CAD_Topo_FComp.pz, CAD_Store.Read(CAD_Topo_FComp.which, 3))
        CAD_Topo_FComp.xx = CAD_Topo_FComp.edx
        CAD_Topo_FComp.xy = CAD_Topo_FComp.edy
        CAD_Topo_FComp.xz = CAD_Topo_FComp.edz
        CAD_Topo_FComp.ln = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.xx), Float_Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.xy)), Float_Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.xz))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: {
            CAD_Topo_FComp.xx = CAD_Store.Read(CAD_Topo_FComp.which, 10)
            CAD_Topo_FComp.xy = CAD_Store.Read(CAD_Topo_FComp.which, 11)
            CAD_Topo_FComp.xz = CAD_Store.Read(CAD_Topo_FComp.which, 12)
        }
        CAD_Topo_FComp.ln = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.xx), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.xy)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.xz))
        CAD_Topo_FComp.aa = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.xx), Float_Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.xy)), Float_Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.xz))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.aa, 0), 0) ThenBlock: {
            CAD_Topo_FComp.ln = Float_Div(CAD_Topo_FComp.ln, CAD_Topo_FComp.aa)
        }
        CAD_Topo_FComp.n2x = Float_Sub(CAD_Topo_FComp.n2x, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.xx))
        CAD_Topo_FComp.n2y = Float_Sub(CAD_Topo_FComp.n2y, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.xy))
        CAD_Topo_FComp.n2z = Float_Sub(CAD_Topo_FComp.n2z, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.xz))
        CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.n2x = Float_Div(CAD_Topo_FComp.n2x, CAD_Topo_FComp.ln)
        CAD_Topo_FComp.n2y = Float_Div(CAD_Topo_FComp.n2y, CAD_Topo_FComp.ln)
        CAD_Topo_FComp.n2z = Float_Div(CAD_Topo_FComp.n2z, CAD_Topo_FComp.ln)
        ReturnValue(1)
    }
}

// Rolling-ball 2-face SOLVE: plane ∩ cylinder generatrix.
// Void>180 (convex, same as 2-plane C=P−ab(N1+N2)): offset both −N
// into the solid. Void≤180 (cove): offset both +N into the void.
// Offset plane ∩ offset cylinder is two generatrices; keep the one
// in this edge's dihedral. Writes FLoc.c0/c1 and replaces n1/n2 so
// Local contacts C+R N lie on the plane and on the cylinder.
// FLoc.sn=1 if f1 is the plane, 2 if f1 is the cylinder. 1 ok.
Function.CAD_Topo.FilletSolvePlaneCyl {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpS("PCYL enter\n", 11)
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail pt\n", 13)
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo_FLoc.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.v1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.aa = CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f1)
        CAD_Topo_FLoc.bb = CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f2)
        CAD_Topo_FLoc.cyl = 0
        CAD_Topo_FLoc.sn = 0
        IfCondition EqualTo(CAD_Topo_FLoc.aa, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FLoc.bb, 2) ThenBlock: {
                CAD_Topo_FLoc.cyl = CAD_Store.Read(CAD_Topo_FLoc.f2, 0)
                CAD_Topo_FLoc.sn = 1
            }
        }
        IfCondition EqualTo(CAD_Topo_FLoc.aa, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FLoc.bb, 1) ThenBlock: {
                CAD_Topo_FLoc.cyl = CAD_Store.Read(CAD_Topo_FLoc.f1, 0)
                CAD_Topo_FLoc.sn = 2
            }
        }
        IfCondition EqualTo(CAD_Topo_FLoc.cyl, 0) ThenBlock: {
            CAD_Topo.FilletDumpOpen()
            CAD_Topo.FilletDumpI("PCYL fail kind f1=", 18, CAD_Topo_FLoc.aa)
            CAD_Topo.FilletDumpI(" f2=", 4, CAD_Topo_FLoc.bb)
            CAD_Topo.FilletDumpS("\n", 1)
            ReturnValue(0)
        }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.cyl, 0), 2) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail cylk\n", 15)
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo_FLoc.sn, 1) ThenBlock: {
            CAD_Topo_FComp.n1x = CAD_Topo_FLoc.n1x
            CAD_Topo_FComp.n1y = CAD_Topo_FLoc.n1y
            CAD_Topo_FComp.n1z = CAD_Topo_FLoc.n1z
            CAD_Topo_FLoc.endf = CAD_Topo_FLoc.f2
        }
        IfCondition EqualTo(CAD_Topo_FLoc.sn, 2) ThenBlock: {
            CAD_Topo_FComp.n1x = CAD_Topo_FLoc.n2x
            CAD_Topo_FComp.n1y = CAD_Topo_FLoc.n2y
            CAD_Topo_FComp.n1z = CAD_Topo_FLoc.n2z
            CAD_Topo_FLoc.endf = CAD_Topo_FLoc.f1
        }
        CAD_Topo_FComp.px = CAD_Store.Read(CAD_Topo_FLoc.cyl, 1)
        CAD_Topo_FComp.py = CAD_Store.Read(CAD_Topo_FLoc.cyl, 2)
        CAD_Topo_FComp.pz = CAD_Store.Read(CAD_Topo_FLoc.cyl, 3)
        CAD_Topo_FLoc.lp = 0
        IfCondition NotEqual(CAD_Topo_FLoc.endf, 0) ThenBlock: {
            CAD_Topo_FLoc.lp = CAD_Store.Read(CAD_Topo_FLoc.endf, 1)
        }
        IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: {
            CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.lp, 0)
            CAD_Topo_FLoc.hd = CAD_Topo_FLoc.ce
            CAD_Topo_FLoc.aa = 0
            WhileLoop LessThan(CAD_Topo_FLoc.aa, 8) {
                IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: { CAD_Topo_FLoc.aa = 8 }
                IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                    CAD_Topo_FComp.e = CAD_Store.Read(CAD_Topo_FLoc.ce, 0)
                    IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                        CAD_Topo_FComp.e = CAD_Store.Read(CAD_Topo_FComp.e, 2)
                        IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.e, 0), 2) ThenBlock: {
                                CAD_Topo_FComp.px = CAD_Store.Read(CAD_Topo_FComp.e, 1)
                                CAD_Topo_FComp.py = CAD_Store.Read(CAD_Topo_FComp.e, 2)
                                CAD_Topo_FComp.pz = CAD_Store.Read(CAD_Topo_FComp.e, 3)
                                CAD_Topo_FLoc.aa = 8
                            }
                        }
                    }
                    IfCondition LessThan(CAD_Topo_FLoc.aa, 8) ThenBlock: {
                        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.ce, 2)
                        IfCondition EqualTo(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.hd) ThenBlock: { CAD_Topo_FLoc.aa = 8 }
                    }
                }
                CAD_Topo_FLoc.aa = Add(CAD_Topo_FLoc.aa, 1)
            }
        }
        CAD_Topo_FLoc.ab = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v0, 0), CAD_Topo_FComp.px)
        CAD_Topo_FLoc.ln = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v0, 1), CAD_Topo_FComp.py)
        CAD_Topo_FLoc.hd = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v0, 2), CAD_Topo_FComp.pz)
        CAD_Topo_FComp.shost = Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.hd, CAD_Topo_FLoc.edz))
        CAD_Topo_FComp.xx = Float_Sub(CAD_Topo_FLoc.ab, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edx))
        CAD_Topo_FComp.xy = Float_Sub(CAD_Topo_FLoc.ln, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edy))
        CAD_Topo_FComp.xz = Float_Sub(CAD_Topo_FLoc.hd, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edz))
        CAD_Topo_FLoc.ab = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Topo_FComp.px)
        CAD_Topo_FLoc.ln = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Topo_FComp.py)
        CAD_Topo_FLoc.hd = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Topo_FComp.pz)
        CAD_Topo_FComp.srad = Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.hd, CAD_Topo_FLoc.edz))
        CAD_Topo_FComp.padh = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.xx), Float_Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.xy)), Float_Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.xz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.padh, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail padh\n", 15)
            ReturnValue(0)
        }
        CAD_Topo_FComp.rr = CAD_Topo_FComp.padh
        // Sqrt/IsZero smash FLoc.edx. Reload the generatrix from verts.
        CAD_Topo_FLoc.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        CAD_Topo_FLoc.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        CAD_Topo_FLoc.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail ed0\n", 14)
            ReturnValue(0)
        }
        CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.ln = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FLoc.edz))
        CAD_Topo_FComp.n1x = Float_Sub(CAD_Topo_FComp.n1x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.edx))
        CAD_Topo_FComp.n1y = Float_Sub(CAD_Topo_FComp.n1y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.edy))
        CAD_Topo_FComp.n1z = Float_Sub(CAD_Topo_FComp.n1z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.edz))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n1x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n1y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail n1\n", 13)
            ReturnValue(0)
        }
        CAD_Topo_FComp.n1x = Float_Div(CAD_Topo_FComp.n1x, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n1y = Float_Div(CAD_Topo_FComp.n1y, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n1z = Float_Div(CAD_Topo_FComp.n1z, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2x = Float_Sub(Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FComp.n1z), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FComp.n1y))
        CAD_Topo_FComp.n2y = Float_Sub(Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FComp.n1x), Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FComp.n1z))
        CAD_Topo_FComp.n2z = Float_Sub(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FComp.n1y), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FComp.n1x))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail n2\n", 13)
            ReturnValue(0)
        }
        CAD_Topo_FComp.n2x = Float_Div(CAD_Topo_FComp.n2x, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2y = Float_Div(CAD_Topo_FComp.n2y, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2z = Float_Div(CAD_Topo_FComp.n2z, CAD_Topo_FLoc.ln)
        // FaceGetPlane N follows sketch-line ax×Z. That is not outward
        // when the LINE was drawn the other way. Same rule as 2-plane:
        // +N is void. Wall is planar — PointInSolid sees it.
        // PointInFaceUV Integer locals smash FComp/FLoc. Park in Store.
        CAD_Topo_State.vmap_new = CAD_Store.Alloc(8, 16)
        IfCondition EqualTo(CAD_Topo_State.vmap_new, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Topo_State.vmap_new, 0, CAD_Topo_FComp.edx)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 1, CAD_Topo_FComp.edy)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 2, CAD_Topo_FComp.edz)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 3, CAD_Topo_FComp.n1x)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 4, CAD_Topo_FComp.n1y)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 5, CAD_Topo_FComp.n1z)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 6, CAD_Topo_FComp.xx)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 7, CAD_Topo_FComp.xy)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 8, CAD_Topo_FComp.xz)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 9, CAD_Topo_FComp.rr)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 10, CAD_Topo_FComp.padh)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 11, CAD_Topo_FComp.shost)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 12, CAD_Topo_FComp.srad)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 13, CAD_Topo_FComp.px)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 14, CAD_Topo_FComp.py)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 15, CAD_Topo_FComp.pz)
        CAD_Topo_FLoc.c0x = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 0), CAD_Store.Read(CAD_Topo_FLoc.v1, 0)), 0x3FE0000000000000)
        CAD_Topo_FLoc.c0y = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 1), CAD_Store.Read(CAD_Topo_FLoc.v1, 1)), 0x3FE0000000000000)
        CAD_Topo_FLoc.c0z = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 2), CAD_Store.Read(CAD_Topo_FLoc.v1, 2)), 0x3FE0000000000000)
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c0x, Float_Mul(0x3FE0000000000000, CAD_Store.Read(CAD_Topo_State.vmap_new, 3))))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c0y, Float_Mul(0x3FE0000000000000, CAD_Store.Read(CAD_Topo_State.vmap_new, 4))))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c0z, Float_Mul(0x3FE0000000000000, CAD_Store.Read(CAD_Topo_State.vmap_new, 5))))
        CAD_Topo_FLoc.hd = CAD_Topo.PointInSolid(CAD_Topo_FLoc.solid, CAD_Topo_FLoc.pt)
        CAD_Topo_FComp.edx = CAD_Store.Read(CAD_Topo_State.vmap_new, 0)
        CAD_Topo_FComp.edy = CAD_Store.Read(CAD_Topo_State.vmap_new, 1)
        CAD_Topo_FComp.edz = CAD_Store.Read(CAD_Topo_State.vmap_new, 2)
        CAD_Topo_FComp.n1x = CAD_Store.Read(CAD_Topo_State.vmap_new, 3)
        CAD_Topo_FComp.n1y = CAD_Store.Read(CAD_Topo_State.vmap_new, 4)
        CAD_Topo_FComp.n1z = CAD_Store.Read(CAD_Topo_State.vmap_new, 5)
        CAD_Topo_FComp.xx = CAD_Store.Read(CAD_Topo_State.vmap_new, 6)
        CAD_Topo_FComp.xy = CAD_Store.Read(CAD_Topo_State.vmap_new, 7)
        CAD_Topo_FComp.xz = CAD_Store.Read(CAD_Topo_State.vmap_new, 8)
        CAD_Topo_FComp.rr = CAD_Store.Read(CAD_Topo_State.vmap_new, 9)
        CAD_Topo_FComp.padh = CAD_Store.Read(CAD_Topo_State.vmap_new, 10)
        CAD_Topo_FComp.shost = CAD_Store.Read(CAD_Topo_State.vmap_new, 11)
        CAD_Topo_FComp.srad = CAD_Store.Read(CAD_Topo_State.vmap_new, 12)
        CAD_Topo_FComp.px = CAD_Store.Read(CAD_Topo_State.vmap_new, 13)
        CAD_Topo_FComp.py = CAD_Store.Read(CAD_Topo_State.vmap_new, 14)
        CAD_Topo_FComp.pz = CAD_Store.Read(CAD_Topo_State.vmap_new, 15)
        IfCondition EqualTo(CAD_Topo_FLoc.hd, 1) ThenBlock: {
            CAD_Topo_FComp.n1x = Float_Sub(0, CAD_Topo_FComp.n1x)
            CAD_Topo_FComp.n1y = Float_Sub(0, CAD_Topo_FComp.n1y)
            CAD_Topo_FComp.n1z = Float_Sub(0, CAD_Topo_FComp.n1z)
        }
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.edx, CAD_Topo_FComp.edx), Float_Mul(CAD_Topo_FComp.edy, CAD_Topo_FComp.edy)), Float_Mul(CAD_Topo_FComp.edz, CAD_Topo_FComp.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail edx\n", 14)
            ReturnValue(0)
        }
        CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FComp.edx, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FComp.edy, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FComp.edz, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2x = Float_Sub(Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FComp.n1z), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FComp.n1y))
        CAD_Topo_FComp.n2y = Float_Sub(Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FComp.n1x), Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FComp.n1z))
        CAD_Topo_FComp.n2z = Float_Sub(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FComp.n1y), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FComp.n1x))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail n2b\n", 14)
            ReturnValue(0)
        }
        CAD_Topo_FComp.n2x = Float_Div(CAD_Topo_FComp.n2x, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2y = Float_Div(CAD_Topo_FComp.n2y, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2z = Float_Div(CAD_Topo_FComp.n2z, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n3x = Float_Div(CAD_Topo_FComp.xx, CAD_Topo_FComp.rr)
        CAD_Topo_FComp.n3y = Float_Div(CAD_Topo_FComp.xy, CAD_Topo_FComp.rr)
        CAD_Topo_FComp.n3z = Float_Div(CAD_Topo_FComp.xz, CAD_Topo_FComp.rr)
        CAD_Topo_FComp.yx = CAD_Topo_FComp.n3x
        CAD_Topo_FComp.yy = CAD_Topo_FComp.n3y
        CAD_Topo_FComp.yz = CAD_Topo_FComp.n3z
        // Void>180 convex: offset −N (into solid). Void≤180 cove: +N.
        // Same convention as 2-plane C = P ∓ ab(N1+N2). Signs live on
        // FLoc.which — FComp.s/yx are IR scratch and get smashed.
        CAD_Topo_FLoc.which = 0
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FLoc.which = 1 }
        CAD_Topo_FComp.bb = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.xx), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.xy)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.xz))
        CAD_Topo_FLoc.ab = Float_Add(0x3FF0000000000000, Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n3z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ab, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpOpen()
            CAD_Topo.FilletDumpS("PCYL fail 1+n1n3\n", 17)
            ReturnValue(0)
        }
        CAD_Topo_FLoc.ab = Float_Div(CAD_Topo_FLoc.r, CAD_Topo_FLoc.ab)
        CAD_Topo_FComp.aa = Float_Sub(CAD_Topo_FComp.rr, CAD_Topo_FLoc.r)
        CAD_Topo_FLoc.ln = Float_Sub(CAD_Topo_FComp.bb, CAD_Topo_FLoc.r)
        CAD_Topo_FLoc.c1x = Float_Sub(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n3x)))
        CAD_Topo_FLoc.c1y = Float_Sub(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n3y)))
        CAD_Topo_FLoc.c1z = Float_Sub(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n3z)))
        IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
            CAD_Topo_FComp.aa = Float_Add(CAD_Topo_FComp.rr, CAD_Topo_FLoc.r)
            CAD_Topo_FLoc.ln = Float_Add(CAD_Topo_FComp.bb, CAD_Topo_FLoc.r)
            CAD_Topo_FLoc.c1x = Float_Add(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n3x)))
            CAD_Topo_FLoc.c1y = Float_Add(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n3y)))
            CAD_Topo_FLoc.c1z = Float_Add(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n3z)))
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.aa), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail Roff\n", 15)
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.aa, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.lp = Float_Sub(Float_Mul(CAD_Topo_FComp.aa, CAD_Topo_FComp.aa), Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.ln))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FLoc.lp), 1) ThenBlock: {
            CAD_Topo.FilletDumpOpen()
            CAD_Topo.FilletDumpS("PCYL fail disc\n", 15)
            ReturnValue(0)
        }
        CAD_Topo_FLoc.lp = CAD_Num.Sqrt(CAD_Topo_FLoc.lp)
        CAD_Topo_FComp.ok = 0
        CAD_Topo_FLoc.ar = 0
        WhileLoop LessThan(CAD_Topo_FLoc.ar, 2) {
            CAD_Topo_FLoc.ce = CAD_Topo_FLoc.lp
            IfCondition EqualTo(CAD_Topo_FLoc.ar, 1) ThenBlock: {
                CAD_Topo_FLoc.ce = Float_Sub(0, CAD_Topo_FLoc.lp)
            }
            CAD_Topo_FComp.cx = Float_Add(Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FComp.n1x), Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n2x))
            CAD_Topo_FComp.cy = Float_Add(Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FComp.n1y), Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n2y))
            CAD_Topo_FComp.cz = Float_Add(Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FComp.n1z), Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n2z))
            CAD_Topo_FLoc.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Topo_FComp.cx, CAD_Topo_FLoc.c1x), Float_Sub(CAD_Topo_FComp.cx, CAD_Topo_FLoc.c1x)), Float_Mul(Float_Sub(CAD_Topo_FComp.cy, CAD_Topo_FLoc.c1y), Float_Sub(CAD_Topo_FComp.cy, CAD_Topo_FLoc.c1y))), Float_Mul(Float_Sub(CAD_Topo_FComp.cz, CAD_Topo_FLoc.c1z), Float_Sub(CAD_Topo_FComp.cz, CAD_Topo_FLoc.c1z))))
            CAD_Topo_FLoc.hd = 0
            IfCondition EqualTo(CAD_Topo_FComp.ok, 0) ThenBlock: { CAD_Topo_FLoc.hd = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FLoc.ab, CAD_Topo_FComp.padh)), 1) ThenBlock: { CAD_Topo_FLoc.hd = 1 }
            IfCondition EqualTo(CAD_Topo_FLoc.hd, 1) ThenBlock: {
                CAD_Topo_FComp.ok = 1
                CAD_Topo_FComp.padh = CAD_Topo_FLoc.ab
                CAD_Topo_FLoc.c0x = CAD_Topo_FComp.cx
                CAD_Topo_FLoc.c0y = CAD_Topo_FComp.cy
                CAD_Topo_FLoc.c0z = CAD_Topo_FComp.cz
            }
            CAD_Topo_FLoc.ar = Add(CAD_Topo_FLoc.ar, 1)
        }
        IfCondition EqualTo(CAD_Topo_FComp.ok, 0) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail noC\n", 14)
            ReturnValue(0)
        }
        CAD_Topo_FComp.n3x = CAD_Topo_FLoc.c0x
        CAD_Topo_FComp.n3y = CAD_Topo_FLoc.c0y
        CAD_Topo_FComp.n3z = CAD_Topo_FLoc.c0z
        CAD_Topo_FComp.padh = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Topo_FComp.n3x, CAD_Topo_FComp.xx), Float_Sub(CAD_Topo_FComp.n3x, CAD_Topo_FComp.xx)), Float_Mul(Float_Sub(CAD_Topo_FComp.n3y, CAD_Topo_FComp.xy), Float_Sub(CAD_Topo_FComp.n3y, CAD_Topo_FComp.xy))), Float_Mul(Float_Sub(CAD_Topo_FComp.n3z, CAD_Topo_FComp.xz), Float_Sub(CAD_Topo_FComp.n3z, CAD_Topo_FComp.xz))))
        CAD_Topo_FLoc.ab = CAD_Num.Abs(Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Topo_FComp.n3x, CAD_Topo_FComp.xx), CAD_Topo_FComp.n1x), Float_Mul(Float_Sub(CAD_Topo_FComp.n3y, CAD_Topo_FComp.xy), CAD_Topo_FComp.n1y)), Float_Mul(Float_Sub(CAD_Topo_FComp.n3z, CAD_Topo_FComp.xz), CAD_Topo_FComp.n1z)))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n3x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n3y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.n3z, CAD_Topo_FComp.n3z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.hd = CAD_Num.Abs(Float_Sub(CAD_Topo_FLoc.ln, CAD_Topo_FComp.rr))
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpU("PCYL dpl=", 9, CAD_Topo_FLoc.ab)
        CAD_Topo.FilletDumpU(" dcyl=", 6, CAD_Topo_FLoc.hd)
        CAD_Topo.FilletDumpU(" R=", 3, CAD_Topo_FLoc.r)
        CAD_Topo.FilletDumpS("\n", 1)
        CAD_Topo_FComp.cx = Float_Div(CAD_Topo_FComp.n3x, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.cy = Float_Div(CAD_Topo_FComp.n3y, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.cz = Float_Div(CAD_Topo_FComp.n3z, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.edx, CAD_Topo_FComp.edx), Float_Mul(CAD_Topo_FComp.edy, CAD_Topo_FComp.edy)), Float_Mul(CAD_Topo_FComp.edz, CAD_Topo_FComp.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FComp.edx, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FComp.edy, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FComp.edz, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.c0x = Float_Add(Float_Add(CAD_Topo_FComp.px, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edx))
        CAD_Topo_FLoc.c0y = Float_Add(Float_Add(CAD_Topo_FComp.py, CAD_Topo_FComp.n3y), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edy))
        CAD_Topo_FLoc.c0z = Float_Add(Float_Add(CAD_Topo_FComp.pz, CAD_Topo_FComp.n3z), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edz))
        CAD_Topo_FLoc.c1x = Float_Add(Float_Add(CAD_Topo_FComp.px, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FLoc.edx))
        CAD_Topo_FLoc.c1y = Float_Add(Float_Add(CAD_Topo_FComp.py, CAD_Topo_FComp.n3y), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FLoc.edy))
        CAD_Topo_FLoc.c1z = Float_Add(Float_Add(CAD_Topo_FComp.pz, CAD_Topo_FComp.n3z), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FLoc.edz))
        CAD_Topo_FLoc.ab = Float_Sub(Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.cx), CAD_Topo_FComp.n3x)
        CAD_Topo_FLoc.ln = Float_Sub(Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.cy), CAD_Topo_FComp.n3y)
        CAD_Topo_FLoc.hd = Float_Sub(Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.cz), CAD_Topo_FComp.n3z)
        CAD_Topo_FLoc.lp = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.ab), Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.ln)), Float_Mul(CAD_Topo_FLoc.hd, CAD_Topo_FLoc.hd)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.lp, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.ab = Float_Div(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.lp)
        CAD_Topo_FLoc.ln = Float_Div(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.lp)
        CAD_Topo_FLoc.hd = Float_Div(CAD_Topo_FLoc.hd, CAD_Topo_FLoc.lp)
        CAD_Topo_FLoc.ce = 0x3FF0000000000000
        IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: { CAD_Topo_FLoc.ce = 0xBFF0000000000000 }
        IfCondition EqualTo(CAD_Topo_FLoc.sn, 1) ThenBlock: {
            CAD_Topo_FLoc.n1x = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1x)
            CAD_Topo_FLoc.n1y = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1y)
            CAD_Topo_FLoc.n1z = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1z)
            CAD_Topo_FLoc.n2x = CAD_Topo_FLoc.ab
            CAD_Topo_FLoc.n2y = CAD_Topo_FLoc.ln
            CAD_Topo_FLoc.n2z = CAD_Topo_FLoc.hd
        }
        IfCondition EqualTo(CAD_Topo_FLoc.sn, 2) ThenBlock: {
            CAD_Topo_FLoc.n2x = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1x)
            CAD_Topo_FLoc.n2y = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1y)
            CAD_Topo_FLoc.n2z = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1z)
            CAD_Topo_FLoc.n1x = CAD_Topo_FLoc.ab
            CAD_Topo_FLoc.n1y = CAD_Topo_FLoc.ln
            CAD_Topo_FLoc.n1z = CAD_Topo_FLoc.hd
        }
        CAD_Topo_FComp.mode = 1
        PrintMessage("fillet SOLVE plane-cyl\n")
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpS("PCYL\n", 5)
        CAD_Topo.FilletDumpU(" Rc=", 4, CAD_Topo_FComp.rr)
        CAD_Topo.FilletDumpU(" Roff=", 6, CAD_Topo_FComp.aa)
        CAD_Topo.FilletDumpU(" d=", 3, CAD_Topo_FComp.padh)
        CAD_Topo.FilletDumpI(" which=", 7, CAD_Topo_FLoc.which)
        CAD_Topo.FilletDumpU(" n1=", 4, CAD_Topo_FComp.n1x)
        CAD_Topo.FilletDumpU(",", 1, CAD_Topo_FComp.n1y)
        CAD_Topo.FilletDumpU(" nw=", 4, CAD_Topo_FComp.yx)
        CAD_Topo.FilletDumpU(",", 1, CAD_Topo_FComp.yy)
        CAD_Topo.FilletDumpU(" c0z=", 5, CAD_Topo_FLoc.c0z)
        CAD_Topo.FilletDumpU(" c1z=", 5, CAD_Topo_FLoc.c1z)
        CAD_Topo.FilletDumpS("\n", 1)
        // Dump Integer locals smash FLoc.c0/n. Contacts read these.
        CAD_Topo_FComp.n3x = CAD_Topo_FLoc.c0x
        CAD_Topo_FComp.n3y = CAD_Topo_FLoc.c0y
        CAD_Topo_FComp.n3z = CAD_Topo_FLoc.c0z
        CAD_Topo_FComp.cx = CAD_Topo_FLoc.c1x
        CAD_Topo_FComp.cy = CAD_Topo_FLoc.c1y
        CAD_Topo_FComp.cz = CAD_Topo_FLoc.c1z
        CAD_Topo_FComp.xx = CAD_Topo_FLoc.n1x
        CAD_Topo_FComp.xy = CAD_Topo_FLoc.n1y
        CAD_Topo_FComp.xz = CAD_Topo_FLoc.n1z
        CAD_Topo_FComp.yx = CAD_Topo_FLoc.n2x
        CAD_Topo_FComp.yy = CAD_Topo_FLoc.n2y
        CAD_Topo_FComp.yz = CAD_Topo_FLoc.n2z
        ReturnValue(1)
    }
}

// Order selected edges into a path. Try every start and both
// orientations — a 2-edge V shares v0 of the first pick, not v1.
Function.CAD_Topo.RimOrder {
    Output: Integer
    Body: {
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.sn = 0
            WhileLoop LessThan(CAD_Topo_FCove.sn, 2) {
                CAD_Topo_FCove.i = 0
                WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
                    CAD_Topo.FCoveSet(360, CAD_Topo_FCove.i, 0)
                    CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
                }
                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(372, CAD_Topo_FCove.g)
                CAD_Topo_FCove.ok = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    CAD_Topo.FCoveSet(0, 0, CAD_Topo_FCove.e)
                    CAD_Topo.FCoveSet(360, CAD_Topo_FCove.g, 1)
                    IfCondition EqualTo(CAD_Topo_FCove.sn, 0) ThenBlock: {
                        CAD_Topo.FCoveSet(12, 0, CAD_Store.Read(CAD_Topo_FCove.e, 0))
                        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                    }
                    IfCondition EqualTo(CAD_Topo_FCove.sn, 1) ThenBlock: {
                        CAD_Topo.FCoveSet(12, 0, CAD_Store.Read(CAD_Topo_FCove.e, 1))
                        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                    }
                    CAD_Topo_FCove.k = 1
                    CAD_Topo_FCove.ok = 1
                    WhileLoop LessThan(CAD_Topo_FCove.k, CAD_Topo_FCove.n) {
                        CAD_Topo_FCove.hit = 0
                        CAD_Topo_FCove.j = 0
                        WhileLoop LessThan(CAD_Topo_FCove.j, CAD_Topo_FCove.n) {
                            IfCondition EqualTo(CAD_Topo.FCoveGet(360, CAD_Topo_FCove.j), 0) ThenBlock: {
                                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(372, CAD_Topo_FCove.j)
                                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                                    CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                                    CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                                    IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo_FCove.v1) ThenBlock: {
                                        CAD_Topo.FCoveSet(0, CAD_Topo_FCove.k, CAD_Topo_FCove.e)
                                        CAD_Topo.FCoveSet(12, CAD_Topo_FCove.k, CAD_Topo_FCove.v0)
                                        CAD_Topo_FCove.v1 = CAD_Topo_FCove.orig
                                        CAD_Topo.FCoveSet(360, CAD_Topo_FCove.j, 1)
                                        CAD_Topo_FCove.hit = 1
                                        CAD_Topo_FCove.j = CAD_Topo_FCove.n
                                    }
                                    IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Topo_FCove.orig, CAD_Topo_FCove.v1) ThenBlock: {
                                            CAD_Topo.FCoveSet(0, CAD_Topo_FCove.k, CAD_Topo_FCove.e)
                                            CAD_Topo.FCoveSet(12, CAD_Topo_FCove.k, CAD_Topo_FCove.orig)
                                            CAD_Topo_FCove.v1 = CAD_Topo_FCove.v0
                                            CAD_Topo.FCoveSet(360, CAD_Topo_FCove.j, 1)
                                            CAD_Topo_FCove.hit = 1
                                            CAD_Topo_FCove.j = CAD_Topo_FCove.n
                                        }
                                    }
                                }
                            }
                            CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
                        }
                        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
                            CAD_Topo_FCove.ok = 0
                            CAD_Topo_FCove.k = CAD_Topo_FCove.n
                        }
                        CAD_Topo_FCove.k = Add(CAD_Topo_FCove.k, 1)
                    }
                }
                IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: { ReturnValue(1) }
                CAD_Topo_FCove.sn = Add(CAD_Topo_FCove.sn, 1)
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ReturnValue(0)
    }
}

// Minor mer through Th and Tw on the solved C = T_host − ln N_host.
Function.CAD_Topo.FilletMerThrough {
    Input: th: Integer
    Input: tw: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ln = CAD_Topo_FCove.r
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
        CAD_Topo_FCove.cx = Float_Sub(CAD_Store.Read(th, 0), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x))
        CAD_Topo_FCove.cy = Float_Sub(CAD_Store.Read(th, 1), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y))
        CAD_Topo_FCove.cz = Float_Sub(CAD_Store.Read(th, 2), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(tw, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(tw, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(tw, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
            CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ab)
            CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ab)
            CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ab)
        }
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.n2x)
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.n2y)
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.n2z)
        ReturnValue(CAD_Topo.MakeMinorArcEdge(th, tw, CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)))
    }
}

Function.CAD_Topo.FilletIRLog {
    Input: idx: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.which = idx
        CAD_Topo_FComp.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.which, 8)
        CAD_Topo_FComp.k = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.n1z), 1) ThenBlock: { CAD_Topo_FComp.k = Subtract(0, 1) }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.n1z), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.n1z, 0), 0) ThenBlock: { CAD_Topo_FComp.k = 1 }
        }
        PrintMessage("fillet IR kind=")
        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.which, 1))
        PrintMessage(" inner=")
        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.which, 2))
        PrintMessage(" side=")
        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.which, 3))
        PrintMessage(" pair=")
        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.which, 11))
        PrintMessage(" Nz=")
        PrintNumber(CAD_Topo_FComp.k)
        PrintMessage(" mode=")
        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.which, 21))
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletEmitFillFrame {
    Output: Integer
    Body: {
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 12) {
            ArraySet(CAD_Topo_FCove.frame, CAD_Topo_FCove.g, 0)
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        // Host/wall circles must keep the rim XY. Flipping Y to make the
        // torus right-handed reversed the bottom-cap loop and sheared the
        // solid (standalone bottom fillet). det is stored; torus flips later.
        CAD_Topo_FComp.xx = CAD_Store.Read(CAD_Topo_FCove.which, 4)
        CAD_Topo_FComp.xy = CAD_Store.Read(CAD_Topo_FCove.which, 5)
        CAD_Topo_FComp.xz = CAD_Store.Read(CAD_Topo_FCove.which, 6)
        CAD_Topo_FComp.yx = CAD_Store.Read(CAD_Topo_FCove.which, 7)
        CAD_Topo_FComp.yy = CAD_Store.Read(CAD_Topo_FCove.which, 8)
        CAD_Topo_FComp.yz = CAD_Store.Read(CAD_Topo_FCove.which, 9)
        CAD_Topo_FCove.d12 = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.yz), CAD_Num.Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.yy))
        CAD_Topo_FCove.d13 = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.yx), CAD_Num.Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.yz))
        CAD_Topo_FCove.d23 = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.yy), CAD_Num.Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.yx))
        CAD_Topo_FCove.det = Float_Add(Float_Add(CAD_Num.Mul(CAD_Topo_FCove.d12, CAD_Topo_FComp.n1x), CAD_Num.Mul(CAD_Topo_FCove.d13, CAD_Topo_FComp.n1y)), CAD_Num.Mul(CAD_Topo_FCove.d23, CAD_Topo_FComp.n1z))
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FComp.xx)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FComp.xy)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FComp.xz)
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FComp.yx)
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FComp.yy)
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FComp.yz)
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletEmitMakeGeom {
    Output: Integer
    Body: {
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 0))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 1))
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 2))
        CAD_Topo_FCove.ok = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 3))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 4))
        ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 5))
        CAD_Topo_FCove.hit = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.aa = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 15)
        CAD_Topo_FCove.ab = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 12)
        CAD_Topo_FCove.padh = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13)
        // Wall circle on the host plane, radius Rmaj. Origin = rim circle O.
        CAD_Topo.FilletEmitFillFrame()
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        CAD_Topo_FCove.wa = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab)
        CAD_Store.Write(CAD_Topo_FCove.wa, 12, 0x401921FB54442D18)
        // Host circle + torus at A0 + s_host N_host.
        ArraySet(CAD_Topo_FCove.frame, 0, Float_Add(CAD_Topo_FCove.cx, CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1x)))
        ArraySet(CAD_Topo_FCove.frame, 1, Float_Add(CAD_Topo_FCove.cy, CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1y)))
        ArraySet(CAD_Topo_FCove.frame, 2, Float_Add(CAD_Topo_FCove.cz, CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1z)))
        CAD_Topo_FCove.wb = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.aa)
        CAD_Store.Write(CAD_Topo_FCove.wb, 12, 0x401921FB54442D18)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.det), 1) ThenBlock: {
            ArraySet(CAD_Topo_FCove.frame, 6, Float_Sub(0, CAD_Topo_FComp.yx))
            ArraySet(CAD_Topo_FCove.frame, 7, Float_Sub(0, CAD_Topo_FComp.yy))
            ArraySet(CAD_Topo_FCove.frame, 8, Float_Sub(0, CAD_Topo_FComp.yz))
        }
        ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FComp.n1x)
        ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FComp.n1y)
        ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FComp.n1z)
        CAD_Topo_FCove.kind = CAD_Geom.MakeTorusSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab, CAD_Topo_FCove.r)
        // Minor circle at C_ball, X=−n2_signed, Y=−n1_signed.
        CAD_Topo_FCove.n1x = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13), CAD_Topo_FComp.n1x)
        CAD_Topo_FCove.n1y = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13), CAD_Topo_FComp.n1y)
        CAD_Topo_FCove.n1z = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13), CAD_Topo_FComp.n1z)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n1x), CAD_Num.Sq(CAD_Topo_FCove.n1y)), CAD_Num.Sq(CAD_Topo_FCove.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = Float_Div(CAD_Topo_FCove.n1x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1y = Float_Div(CAD_Topo_FCove.n1y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1z = Float_Div(CAD_Topo_FCove.n1z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2x = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14), CAD_Topo_FComp.n2x)
        CAD_Topo_FCove.n2y = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14), CAD_Topo_FComp.n2y)
        CAD_Topo_FCove.n2z = CAD_Num.Mul(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14), CAD_Topo_FComp.n2z)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n2x), CAD_Num.Sq(CAD_Topo_FCove.n2y)), CAD_Num.Sq(CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 16))
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 17))
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 18))
        ArraySet(CAD_Topo_FCove.frame, 3, Float_Sub(0, CAD_Topo_FCove.n2x))
        ArraySet(CAD_Topo_FCove.frame, 4, Float_Sub(0, CAD_Topo_FCove.n2y))
        ArraySet(CAD_Topo_FCove.frame, 5, Float_Sub(0, CAD_Topo_FCove.n2z))
        ArraySet(CAD_Topo_FCove.frame, 6, Float_Sub(0, CAD_Topo_FCove.n1x))
        ArraySet(CAD_Topo_FCove.frame, 7, Float_Sub(0, CAD_Topo_FCove.n1y))
        ArraySet(CAD_Topo_FCove.frame, 8, Float_Sub(0, CAD_Topo_FCove.n1z))
        CAD_Topo_FCove.minlen = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
        IfCondition EqualTo(CAD_Topo_FCove.v1, 0) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Topo_FCove.v0 }
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.v0) ThenBlock: {
            CAD_Topo_FCove.bb = CAD_Topo.MakeEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.ok, CAD_Topo_FCove.wa)
            CAD_Topo_FCove.sn = CAD_Topo.MakeEdge(CAD_Topo_FCove.hit, CAD_Topo_FCove.hit, CAD_Topo_FCove.wb)
            CAD_Topo_FCove.lp = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.hit, CAD_Topo_FCove.minlen)
            IfCondition EqualTo(CAD_Topo_FCove.bb, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo_FCove.sn, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo.FilletBossSwap(), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        // Open arc (stadium): torus patch, not a closed circle in the loop.
        IfCondition EqualTo(CAD_Topo.FilletEmitOpenPatch(), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Contacts at a rim vertex: wall = V+srad n_rad, host = V+shost N.
Function.CAD_Topo.FilletEmitVertContact {
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(vh, 0), CAD_Topo_FCove.cx)
        CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(vh, 1), CAD_Topo_FCove.cy)
        CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(vh, 2), CAD_Topo_FCove.cz)
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n2x), CAD_Num.Sq(CAD_Topo_FCove.n2y)), CAD_Num.Sq(CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.ab = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 14)
        CAD_Topo_FCove.padh = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 13)
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Store.Read(vh, 0), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Store.Read(vh, 1), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Store.Read(vh, 2), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2z)))
        CAD_Topo_FCove.aa = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Store.Read(vh, 0), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Store.Read(vh, 1), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Store.Read(vh, 2), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1z)))
        CAD_Topo_FCove.g = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
        IfCondition EqualTo(CAD_Topo_FCove.aa, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.g, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletEmitOpenPatch {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo.FilletEmitVertContact(CAD_Topo_FCove.v0), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok = CAD_Topo_FCove.aa
        CAD_Topo_FCove.hit = CAD_Topo_FCove.g
        IfCondition EqualTo(CAD_Topo.FilletEmitVertContact(CAD_Topo_FCove.v1), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok1 = CAD_Topo_FCove.aa
        CAD_Topo_FCove.hit1 = CAD_Topo_FCove.g
        CAD_Topo_FCove.bb = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.ok1, CAD_Topo_FCove.wa)
        CAD_Topo_FCove.sn = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.hit, CAD_Topo_FCove.hit1, CAD_Topo_FCove.wb)
        CAD_Topo_FCove.lp = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.hit, CAD_Topo_FCove.minlen)
        ArraySet(CAD_Topo_FCove.frame, 0, Float_Add(Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 0), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1x)), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.frame, 1, Float_Add(Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 1), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1y)), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.frame, 2, Float_Add(Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1z)), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2z)))
        ArraySet(CAD_Topo_FCove.frame, 3, Float_Sub(0, CAD_Topo_FCove.n2x))
        ArraySet(CAD_Topo_FCove.frame, 4, Float_Sub(0, CAD_Topo_FCove.n2y))
        ArraySet(CAD_Topo_FCove.frame, 5, Float_Sub(0, CAD_Topo_FCove.n2z))
        ArraySet(CAD_Topo_FCove.frame, 6, Float_Sub(0, CAD_Topo_FComp.n1x))
        ArraySet(CAD_Topo_FCove.frame, 7, Float_Sub(0, CAD_Topo_FComp.n1y))
        ArraySet(CAD_Topo_FCove.frame, 8, Float_Sub(0, CAD_Topo_FComp.n1z))
        CAD_Topo_FCove.minlen = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
        CAD_Topo_FCove.lp1 = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok1, CAD_Topo_FCove.hit1, CAD_Topo_FCove.minlen)
        IfCondition EqualTo(CAD_Topo_FCove.bb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.sn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.lp1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletOpenSwap(), 0) ThenBlock: { ReturnValue(0) }
        PrintMessage("fillet emit OPEN arc\n")
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletOpenSwap {
    Output: Integer
    Body: {
        CAD_Topo_FCove.nxt1 = 0
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f2, CAD_Topo_FCove.e)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Topo_FCove.nxt1 = CAD_Topo.FilletIRFindGen(CAD_Topo_FCove.ce, CAD_Topo_FCove.v1)
        }
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.host_f, CAD_Topo_FCove.e)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo_FCove.bb, CAD_Topo_FCove.ok)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f2, CAD_Topo_FCove.e)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo_FCove.sn, CAD_Topo_FCove.hit)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.prv = CAD_Topo_FCove.ce
        IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: {
            CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.nxt, CAD_Topo_FCove.v0, CAD_Topo_FCove.hit)
        }
        IfCondition NotEqual(CAD_Topo_FCove.nxt1, 0) ThenBlock: {
            CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.nxt1, CAD_Topo_FCove.v1, CAD_Topo_FCove.hit1)
        }
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.bb, 0), CAD_Topo_FCove.ok) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.MakeCoedge(CAD_Topo_FCove.bb, CAD_Topo_FCove.ok, CAD_Topo_FCove.which))
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.lp1, 0), CAD_Topo_FCove.ok1) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.MakeCoedge(CAD_Topo_FCove.lp1, CAD_Topo_FCove.ok1, CAD_Topo_FCove.which))
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.sn, 0), CAD_Topo_FCove.hit1) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.MakeCoedge(CAD_Topo_FCove.sn, CAD_Topo_FCove.hit1, CAD_Topo_FCove.which))
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.lp, 0), CAD_Topo_FCove.hit) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 3, CAD_Topo.MakeCoedge(CAD_Topo_FCove.lp, CAD_Topo_FCove.hit, CAD_Topo_FCove.which))
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 4, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.which = CAD_Topo.MakeFace(CAD_Topo_FCove.kind, CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.ShellAppendFace(CAD_Topo_FCove.shell, CAD_Topo_FCove.which), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Open canal end: meridian joins every incident plane face that is
// not host and not this wall. Find by edge endpoints (origin is the
// start of a coedge, not the mouth). The two LINEs that met at the
// mouth become Th (host-incident) and Tw (the other); mer goes
// between those coedges.
Function.CAD_Topo.FilletSewOpenEnd {
    Input: v_orig: Integer
    Input: th: Integer
    Input: tw: Integer
    Input: mer: Integer
    Input: wall_f: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(v_orig, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.f1 = 0
        CAD_Topo_FCove.which = 0
        IfCondition NotEqual(CAD_Topo_FCove.solid, 0) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.solid, 0)
        }
        IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.which, 0)
        }
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 64) {
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.g = 64 }
            IfCondition NotEqual(CAD_Topo_FCove.f1, 0) ThenBlock: { CAD_Topo_FCove.g = 64 }
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: {
                    CAD_Topo_FCove.ok = 1
                    IfCondition EqualTo(CAD_Topo_FCove.which, CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FCove.which, wall_f) ThenBlock: { CAD_Topo_FCove.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.which, 0)
                        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { CAD_Topo_FCove.ok = 0 }
                    }
                    IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.which, 1)
                        IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
                            CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
                            CAD_Topo_FCove.j = 0
                            WhileLoop LessThan(CAD_Topo_FCove.j, 64) {
                                IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.j = 64 }
                                IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                                    CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                                        CAD_Topo_FCove.hit = 0
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), v_orig) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), v_orig) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), th) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), th) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                        IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                                            CAD_Topo_FCove.f1 = CAD_Topo_FCove.which
                                            CAD_Topo_FCove.j = 64
                                        }
                                    }
                                    CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                                    IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.j = 64 }
                                }
                                CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
                            }
                        }
                    }
                    CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.which, 3)
                }
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: {
            CAD_Topo.FilletDumpI("fillet sew no side v=", 20, v_orig)
            CAD_Topo.FilletDumpS("\n", 1)
            ReturnValue(1)
        }
        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.f1, 1)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 64) {
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.g = 64 }
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    CAD_Topo_FCove.ok = 0
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), v_orig) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), v_orig) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                    IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                        CAD_Topo_FCove.kind = 1
                        CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                        IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: { CAD_Topo_FCove.kind = CAD_Store.Read(CAD_Topo_FCove.nxt, 0) }
                        IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: {
                                CAD_Topo_FCove.hit = 0
                                IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.faces, 0), CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.faces, 1), CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: { CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.e, v_orig, th) }
                                IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.e, v_orig, tw) }
                            }
                        }
                    }
                }
                CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 64 }
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.orig = 0
        CAD_Topo_FCove.v1 = 0
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 64) {
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.g = 64 }
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), th) ThenBlock: { CAD_Topo_FCove.orig = CAD_Topo_FCove.ce }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), th) ThenBlock: { CAD_Topo_FCove.orig = CAD_Topo_FCove.ce }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), tw) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Topo_FCove.ce }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), tw) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Topo_FCove.ce }
                }
                CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 64 }
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        CAD_Topo_FCove.prv = 0
        CAD_Topo_FCove.ok = 0
        IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_FCove.v1, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.orig, CAD_Topo_FCove.v1) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.orig, 2), CAD_Topo_FCove.v1) ThenBlock: {
                        CAD_Topo_FCove.prv = CAD_Topo_FCove.orig
                        CAD_Topo_FCove.ok = th
                    }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Topo_FCove.orig) ThenBlock: {
                        CAD_Topo_FCove.prv = CAD_Topo_FCove.v1
                        CAD_Topo_FCove.ok = tw
                    }
                }
            }
        }
        IfCondition NotEqual(CAD_Topo_FCove.prv, 0) ThenBlock: {
            CAD_Topo_FCove.sn = 1
            IfCondition NotEqual(CAD_Store.Read(mer, 0), CAD_Topo_FCove.ok) ThenBlock: { CAD_Topo_FCove.sn = 0 }
            CAD_Topo_FCove.ce = CAD_Topo.MakeCoedge(mer, CAD_Topo_FCove.ok, CAD_Topo_FCove.sn)
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo.CoedgeInsertAfter(CAD_Topo_FCove.prv, CAD_Topo_FCove.ce)
                IfCondition EqualTo(CAD_Store.Read(mer, 3), 0) ThenBlock: { CAD_Store.Write(mer, 3, CAD_Topo_FCove.ce) }
                IfCondition NotEqual(CAD_Store.Read(mer, 3), CAD_Topo_FCove.ce) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(mer, 4), 0) ThenBlock: {
                        CAD_Store.Write(mer, 4, CAD_Topo_FCove.ce)
                        CAD_Topo.LinkTwins(CAD_Store.Read(mer, 3), CAD_Topo_FCove.ce)
                    }
                }
            }
        }
        CAD_Topo.FilletDumpI("fillet sew side=", 16, CAD_Topo_FCove.f1)
        CAD_Topo.FilletDumpI("ins=", 4, CAD_Topo_FCove.prv)
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletEmitPlaneCyl {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIREnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(edge_handle)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.h), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 11), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 15), 4) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.solid = solid_handle
        CAD_Topo_FCove.e = edge_handle
        CAD_Topo_FCove.r = radius_r
        CAD_Topo_FCove.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.host_f = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 19)
        CAD_Topo_FCove.f2 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 20)
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.v0 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 23)
        CAD_Topo_FCove.nxt = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 22)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.nxt, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.nxt, 0)
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.v0) ThenBlock: {
            CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.nxt, 1)
        }
        CAD_Topo_FComp.n1x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 6)
        CAD_Topo_FComp.n1y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 7)
        CAD_Topo_FComp.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 8)
        CAD_Topo_FComp.n2x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 9)
        CAD_Topo_FComp.n2y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 10)
        CAD_Topo_FComp.n2z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 11)
        CAD_Topo_FCove.n3x = CAD_Topo_FComp.n1x
        CAD_Topo_FCove.n3y = CAD_Topo_FComp.n1y
        CAD_Topo_FCove.n3z = CAD_Topo_FComp.n1z
        CAD_Topo_FCove.which = CAD_Store.Read(edge_handle, 2)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.which, 1)
        CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.which, 2)
        CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.which, 3)
        CAD_Topo_FCove.s = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 21)
        PrintMessage("fillet emit plane-cyl mode=")
        PrintNumber(CAD_Topo_FCove.s)
        PrintMessage(" Rmaj=")
        PrintNumber(Float_ToInt(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 12)))
        PrintMessage(" Nz=")
        CAD_Topo_FComp.k = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.n1z), 1) ThenBlock: { CAD_Topo_FComp.k = Subtract(0, 1) }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.n1z), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.n1z, 0), 0) ThenBlock: { CAD_Topo_FComp.k = 1 }
        }
        PrintNumber(CAD_Topo_FComp.k)
        PrintMessage("\n")
        IfCondition EqualTo(CAD_Topo.FilletEmitMakeGeom(), 0) ThenBlock: { ReturnValue(0) }
        PrintMessage("fillet emit torus ok\n")
        ReturnValue(CAD_Topo_FCove.solid)
    }
}

// Offset-arc span from SOLVE endpoints, same rotational sense as the
// source. Copying the source's 270° onto a 3-face T_host pair left a
// pinned chord. Do not write FCove.ab — RimMakeSeg still holds Rmaj.
Function.CAD_Topo.FilletEmitArcRail {
    Input: va: Integer
    Input: vb: Integer
    Input: circ_h: Integer
    Input: src_crv: Integer
    Input: src_edge: Integer
    Input: start_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(circ_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.d12 = 0
        IfCondition NotEqual(src_crv, 0) ThenBlock: {
            CAD_Topo_FCove.d12 = CAD_Store.Read(src_crv, 12)
            CAD_Store.Write(circ_h, 11, CAD_Store.Read(src_crv, 11))
        }
        IfCondition NotEqual(src_edge, 0) ThenBlock: {
            IfCondition NotEqual(start_v, 0) ThenBlock: {
                IfCondition NotEqual(start_v, CAD_Store.Read(src_edge, 0)) ThenBlock: {
                    CAD_Topo_FCove.d12 = Float_Sub(0, CAD_Topo_FCove.d12)
                }
            }
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.d12, 0), 1) ThenBlock: {
            ReturnValue(CAD_Topo.MakeMinorArcEdge(va, vb, circ_h))
        }
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(va, 0), CAD_Store.Read(circ_h, 1))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(va, 1), CAD_Store.Read(circ_h, 2))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(va, 2), CAD_Store.Read(circ_h, 3))
        CAD_Topo_FCove.aa = CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 7)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 8))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 9))), Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 4)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 5))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 6))))
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(vb, 0), CAD_Store.Read(circ_h, 1))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(vb, 1), CAD_Store.Read(circ_h, 2))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(vb, 2), CAD_Store.Read(circ_h, 3))
        CAD_Topo_FCove.bb = CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 7)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 8))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 9))), Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 4)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 5))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 6))))
        CAD_Topo_FCove.g = Float_Sub(CAD_Topo_FCove.bb, CAD_Topo_FCove.aa)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.d12), 1) ThenBlock: {
            CAD_Topo_FCove.g = Float_Sub(0, CAD_Num.PosMod2Pi(Float_Sub(0, CAD_Topo_FCove.g)))
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.d12), 0) ThenBlock: {
            CAD_Topo_FCove.g = CAD_Num.PosMod2Pi(CAD_Topo_FCove.g)
        }
        CAD_Store.Write(circ_h, 12, CAD_Topo_FCove.g)
        ReturnValue(CAD_Topo.MakeEdge(va, vb, circ_h))
    }
}

// Dump/MakeVertex smash FLoc.c0/n/edx. SOLVE left them on FComp.
Function.CAD_Topo.FilletEmitRestorePlaneCyl {
    Output: Integer
    Body: {
        CAD_Topo_FLoc.c0x = CAD_Topo_FComp.n3x
        CAD_Topo_FLoc.c0y = CAD_Topo_FComp.n3y
        CAD_Topo_FLoc.c0z = CAD_Topo_FComp.n3z
        CAD_Topo_FLoc.c1x = CAD_Topo_FComp.cx
        CAD_Topo_FLoc.c1y = CAD_Topo_FComp.cy
        CAD_Topo_FLoc.c1z = CAD_Topo_FComp.cz
        CAD_Topo_FLoc.n1x = CAD_Topo_FComp.xx
        CAD_Topo_FLoc.n1y = CAD_Topo_FComp.xy
        CAD_Topo_FLoc.n1z = CAD_Topo_FComp.xz
        CAD_Topo_FLoc.n2x = CAD_Topo_FComp.yx
        CAD_Topo_FLoc.n2y = CAD_Topo_FComp.yy
        CAD_Topo_FLoc.n2z = CAD_Topo_FComp.yz
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.edx, CAD_Topo_FComp.edx), Float_Mul(CAD_Topo_FComp.edy, CAD_Topo_FComp.edy)), Float_Mul(CAD_Topo_FComp.edz, CAD_Topo_FComp.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 0) ThenBlock: {
            CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FComp.edx, CAD_Topo_FLoc.ln)
            CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FComp.edy, CAD_Topo_FLoc.ln)
            CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FComp.edz, CAD_Topo_FLoc.ln)
        }
        ReturnValue(1)
    }
}

// Fresh Store cell every call. Never reuse pick-ray rb_* pointers.
Function.CAD_Topo.FilletEmitPark {
    Output: Integer
    Body: {
        CAD_Topo_State.rb_pt = CAD_Store.Alloc(8, 16)
        ReturnValue(CAD_Topo_State.rb_pt)
    }
}

Function.CAD_Topo.FilletEmitParkRem {
    Output: Integer
    Body: {
        CAD_Topo_State.rb_ax = CAD_Store.Alloc(8, 8)
        ReturnValue(CAD_Topo_State.rb_ax)
    }
}

// Dispatch from edge Store curve kind, not FLoc.which after Geom.
Function.CAD_Topo.FilletEmitMerSupport {
    Input: edge_h: Integer
    Input: old_v: Integer
    Input: new_v: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.e = 0
        CAD_Topo_FCove.kind = 0
        IfCondition NotEqual(edge_h, 0) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Store.Read(edge_h, 2)
        }
        IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
            CAD_Topo_FCove.kind = CAD_Store.Read(CAD_Topo_FCove.e, 0)
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("mer ce=", 7, CAD_Topo_FLoc.ce)
        CAD_Topo.FilletDumpI(" lp=", 4, CAD_Topo_FLoc.lp)
        CAD_Topo.FilletDumpI(" e=", 3, edge_h)
        CAD_Topo.FilletDumpI(" crv=", 5, CAD_Topo_FCove.e)
        CAD_Topo.FilletDumpI(" k=", 3, CAD_Topo_FCove.kind)
        CAD_Topo.FilletDumpI(" which=", 7, CAD_Topo_FLoc.which)
        CAD_Topo.FilletDumpS("\n", 1)
        IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: {
            ReturnValue(CAD_Topo.FilletEmitCircleEnd(edge_h, old_v, new_v))
        }
        ReturnValue(CAD_Topo.EdgeRetargetVert(edge_h, old_v, new_v))
    }
}

// Host CIRCLE remainder. Park is a fresh Store cell; handle in vmap_old
// (Tess sc_crv class — not FCove, not rb_*, not pick). Slot 0 clone, 1 va,
// 2 vb, 3 srcspan, 4 A, 5 B, 6 g.
Function.CAD_Topo.FilletEmitCircleRemainder {
    Input: va: Integer
    Input: vb: Integer
    Input: circ_h: Integer
    Input: src_edge: Integer
    Input: start_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(circ_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_State.vmap_old = CAD_Store.Alloc(8, 8)
        IfCondition EqualTo(CAD_Topo_State.vmap_old, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Topo_State.vmap_old, 1, va)
        CAD_Store.Write(CAD_Topo_State.vmap_old, 2, vb)
        CAD_Topo_FCove.d12 = CAD_Store.Read(circ_h, 12)
        IfCondition NotEqual(src_edge, 0) ThenBlock: {
            IfCondition NotEqual(start_v, 0) ThenBlock: {
                IfCondition NotEqual(start_v, CAD_Store.Read(src_edge, 0)) ThenBlock: {
                    CAD_Topo_FCove.d12 = Float_Sub(0, CAD_Topo_FCove.d12)
                }
            }
        }
        CAD_Store.Write(CAD_Topo_State.vmap_old, 3, CAD_Topo_FCove.d12)
        CAD_Topo_State.vmap_new = CAD_Store.Alloc(16, 15)
        IfCondition EqualTo(CAD_Topo_State.vmap_new, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Topo_State.vmap_old, 0, CAD_Topo_State.vmap_new)
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 15) {
            CAD_Store.Write(CAD_Topo_State.vmap_new, CAD_Topo_FCove.g, CAD_Store.Read(circ_h, CAD_Topo_FCove.g))
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_State.vmap_old, 0)
        CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_State.vmap_old, 1)
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.aa, 0), CAD_Store.Read(CAD_Topo_FCove.ok, 1))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.aa, 1), CAD_Store.Read(CAD_Topo_FCove.ok, 2))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.aa, 2), CAD_Store.Read(CAD_Topo_FCove.ok, 3))
        CAD_Store.Write(CAD_Topo_State.vmap_old, 4, CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(CAD_Topo_FCove.ok, 7)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(CAD_Topo_FCove.ok, 8))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(CAD_Topo_FCove.ok, 9))), Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(CAD_Topo_FCove.ok, 4)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(CAD_Topo_FCove.ok, 5))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(CAD_Topo_FCove.ok, 6)))))
        CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_State.vmap_old, 0)
        CAD_Topo_FCove.bb = CAD_Store.Read(CAD_Topo_State.vmap_old, 2)
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.bb, 0), CAD_Store.Read(CAD_Topo_FCove.ok, 1))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.bb, 1), CAD_Store.Read(CAD_Topo_FCove.ok, 2))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.bb, 2), CAD_Store.Read(CAD_Topo_FCove.ok, 3))
        CAD_Store.Write(CAD_Topo_State.vmap_old, 5, CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(CAD_Topo_FCove.ok, 7)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(CAD_Topo_FCove.ok, 8))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(CAD_Topo_FCove.ok, 9))), Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(CAD_Topo_FCove.ok, 4)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(CAD_Topo_FCove.ok, 5))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(CAD_Topo_FCove.ok, 6)))))
        CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_State.vmap_old, 0)
        CAD_Topo_FCove.d12 = CAD_Store.Read(CAD_Topo_State.vmap_old, 3)
        CAD_Topo_FCove.g = Float_Sub(CAD_Store.Read(CAD_Topo_State.vmap_old, 5), CAD_Store.Read(CAD_Topo_State.vmap_old, 4))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.d12), 1) ThenBlock: {
            CAD_Topo_FCove.g = Float_Sub(0, CAD_Num.PosMod2Pi(Float_Sub(0, CAD_Topo_FCove.g)))
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.d12), 0) ThenBlock: {
            CAD_Topo_FCove.g = CAD_Num.PosMod2Pi(CAD_Topo_FCove.g)
        }
        CAD_Store.Write(CAD_Topo_State.vmap_old, 6, CAD_Topo_FCove.g)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Store.Read(CAD_Topo_State.vmap_old, 6), 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Store.Read(CAD_Topo_State.vmap_old, 3), 0), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
                CAD_Topo.FilletDumpI("span0 va=", 9, CAD_Store.Read(CAD_Topo_State.vmap_old, 1))
                CAD_Topo.FilletDumpI(" vb=", 4, CAD_Store.Read(CAD_Topo_State.vmap_old, 2))
                CAD_Topo.FilletDumpU(" A=", 3, CAD_Store.Read(CAD_Topo_State.vmap_old, 4))
                CAD_Topo.FilletDumpU(" B=", 3, CAD_Store.Read(CAD_Topo_State.vmap_old, 5))
                CAD_Topo.FilletDumpU(" g=", 3, CAD_Store.Read(CAD_Topo_State.vmap_old, 6))
                CAD_Topo.FilletDumpU(" src=", 5, CAD_Store.Read(CAD_Topo_State.vmap_old, 3))
                CAD_Topo.FilletDumpS("\n", 1)
                ReturnValue(0)
            }
        }
        CAD_Store.Write(CAD_Store.Read(CAD_Topo_State.vmap_old, 0), 12, CAD_Store.Read(CAD_Topo_State.vmap_old, 6))
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpU(" remspan=", 9, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.vmap_old, 0), 12))
        CAD_Topo.FilletDumpI(" ck=", 4, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.vmap_old, 0), 0))
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(CAD_Topo.MakeEdge(CAD_Store.Read(CAD_Topo_State.vmap_old, 1), CAD_Store.Read(CAD_Topo_State.vmap_old, 2), CAD_Store.Read(CAD_Topo_State.vmap_old, 0)))
    }
}

// Other coedge of this rim: CIRCLE same R and cz, owns old_v, not skip_edge.
// Cap CircleEnd finds the wall rail (822 after a prior split); wall finds cap.
Function.CAD_Topo.FilletEmitRimMateCe {
    Input: src_crv: Integer
    Input: skip_edge: Integer
    Input: old_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src_crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.solid, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.shell = CAD_Store.Read(CAD_Topo_FLoc.solid, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.shell, 0)
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 16) {
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.g = 16 }
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.which, 1)
                IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                    CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
                    CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
                    CAD_Topo_FCove.j = 0
                    WhileLoop LessThan(CAD_Topo_FCove.j, 16) {
                        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.j = 16 }
                        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                            CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                                IfCondition NotEqual(CAD_Topo_FCove.e, skip_edge) ThenBlock: {
                                    CAD_Topo_FCove.ok = 0
                                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), old_v) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), old_v) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                                    IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                                        CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                                        IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: {
                                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.nxt, 0), 2) ThenBlock: {
                                                IfCondition EqualTo(CAD_Num.IsZero(Float_Sub(CAD_Store.Read(CAD_Topo_FCove.nxt, 10), CAD_Store.Read(src_crv, 10)), 0), 1) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Num.IsZero(Float_Sub(CAD_Store.Read(CAD_Topo_FCove.nxt, 3), CAD_Store.Read(src_crv, 3)), 0), 1) ThenBlock: {
                                                        ReturnValue(CAD_Topo_FCove.ce)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                            IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.j = 16 }
                        }
                        CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
                    }
                }
                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.which, 3)
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ReturnValue(0)
    }
}

// One remainder curve. Cap and wall twins share that edge.
Function.CAD_Topo.FilletEmitCircleEnd {
    Input: edge_h: Integer
    Input: old_v: Integer
    Input: new_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_v, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok = CAD_Topo.FilletEmitPark()
        IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.e = CAD_Store.Read(edge_h, 2)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), 2) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Topo_FCove.ok, 4, edge_h)
        CAD_Store.Write(CAD_Topo_FCove.ok, 5, old_v)
        CAD_Store.Write(CAD_Topo_FCove.ok, 6, new_v)
        CAD_Store.Write(CAD_Topo_FCove.ok, 7, CAD_Topo_FCove.e)
        CAD_Store.Write(CAD_Topo_FCove.ok, 8, CAD_Store.Read(edge_h, 0))
        CAD_Store.Write(CAD_Topo_FCove.ok, 9, CAD_Store.Read(edge_h, 1))
        CAD_Store.Write(CAD_Topo_FCove.ok, 10, CAD_Store.Read(edge_h, 3))
        CAD_Store.Write(CAD_Topo_FCove.ok, 11, CAD_Store.Read(edge_h, 4))
        CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_State.rb_pt, 8)
        CAD_Topo_FCove.bb = CAD_Store.Read(CAD_Topo_State.rb_pt, 9)
        IfCondition EqualTo(CAD_Topo_FCove.aa, old_v) ThenBlock: { CAD_Topo_FCove.aa = new_v }
        IfCondition EqualTo(CAD_Topo_FCove.bb, CAD_Store.Read(CAD_Topo_State.rb_pt, 5)) ThenBlock: { CAD_Topo_FCove.bb = CAD_Store.Read(CAD_Topo_State.rb_pt, 6) }
        CAD_Store.Write(CAD_Topo_State.rb_pt, 12, CAD_Topo_FCove.aa)
        CAD_Store.Write(CAD_Topo_State.rb_pt, 13, CAD_Topo_FCove.bb)
        CAD_Topo_FCove.f1 = 0
        CAD_Topo_FCove.f2 = 0
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_State.rb_pt, 10)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.ce, 4)
            IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: { CAD_Topo_FCove.f1 = CAD_Store.Read(CAD_Topo_FCove.lp, 1) }
        }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_State.rb_pt, 11)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Topo_FCove.lp1 = CAD_Store.Read(CAD_Topo_FCove.ce, 4)
            IfCondition NotEqual(CAD_Topo_FCove.lp1, 0) ThenBlock: { CAD_Topo_FCove.f2 = CAD_Store.Read(CAD_Topo_FCove.lp1, 1) }
        }
        CAD_Store.Write(CAD_Topo_State.rb_pt, 14, CAD_Topo_FCove.f1)
        CAD_Store.Write(CAD_Topo_State.rb_pt, 0, CAD_Topo_FCove.f2)
        CAD_Topo_FCove.kind = 0
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_State.rb_pt, 14), 0) ThenBlock: {
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_State.rb_pt, 0), 0) ThenBlock: {
                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_State.rb_pt, 14), CAD_Store.Read(CAD_Topo_State.rb_pt, 0)) ThenBlock: { CAD_Topo_FCove.kind = 1 }
            }
        }
        CAD_Store.Write(CAD_Topo_State.rb_pt, 15, CAD_Topo_FCove.kind)
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.rb_pt, 6), 0), CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.rb_pt, 7), 1))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.rb_pt, 6), 1), CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.rb_pt, 7), 2))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.rb_pt, 6), 2), CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.rb_pt, 7), 3))
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
        CAD_Store.Write(CAD_Topo_State.rb_pt, 3, CAD_Num.Abs(Float_Sub(CAD_Topo_FCove.ln, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.rb_pt, 7), 10))))
        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_State.rb_pt, 12), CAD_Store.Read(CAD_Topo_State.rb_pt, 13)) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpI("va=vb ", 6, CAD_Store.Read(CAD_Topo_State.rb_pt, 12))
            CAD_Topo.FilletDumpS("\n", 1)
            ReturnValue(0)
        }
        CAD_Topo_FCove.hit = CAD_Topo.FilletEmitCircleRemainder(CAD_Store.Read(CAD_Topo_State.rb_pt, 12), CAD_Store.Read(CAD_Topo_State.rb_pt, 13), CAD_Store.Read(CAD_Topo_State.rb_pt, 7), CAD_Store.Read(CAD_Topo_State.rb_pt, 4), CAD_Store.Read(CAD_Topo_State.rb_pt, 8))
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Topo_State.rb_pt, 1, CAD_Topo_FCove.hit)
        CAD_Store.Write(CAD_Topo_State.rb_pt, 2, CAD_Topo_FCove.hit)
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_State.rb_pt, 10)
        CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_State.rb_pt, 5)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            IfCondition EqualTo(CAD_Topo_FCove.sn, CAD_Topo_FCove.orig) ThenBlock: {
                CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.rb_pt, 12)
                IfCondition NotEqual(CAD_Topo_FCove.orig, CAD_Store.Read(CAD_Topo_State.rb_pt, 8)) ThenBlock: { CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.rb_pt, 13) }
            }
            CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Store.Read(CAD_Topo_State.rb_pt, 1), CAD_Topo_FCove.sn)
        }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_State.rb_pt, 11)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Store.Write(CAD_Topo_State.rb_pt, 15, 1)
            CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            IfCondition EqualTo(CAD_Topo_FCove.sn, CAD_Store.Read(CAD_Topo_State.rb_pt, 5)) ThenBlock: {
                CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.rb_pt, 12)
                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_State.rb_pt, 5), CAD_Store.Read(CAD_Topo_State.rb_pt, 8)) ThenBlock: { CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.rb_pt, 13) }
            }
            CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Store.Read(CAD_Topo_State.rb_pt, 1), CAD_Topo_FCove.sn)
        }
        CAD_Topo_FCove.ce = CAD_Topo.FilletEmitRimMateCe(CAD_Store.Read(CAD_Topo_State.rb_pt, 7), CAD_Store.Read(CAD_Topo_State.rb_pt, 4), CAD_Store.Read(CAD_Topo_State.rb_pt, 5))
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Store.Write(CAD_Topo_State.rb_pt, 15, 1)
            CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
            CAD_Topo_FCove.lp1 = CAD_Store.Read(CAD_Topo_FCove.ce, 4)
            IfCondition NotEqual(CAD_Topo_FCove.lp1, 0) ThenBlock: { CAD_Store.Write(CAD_Topo_State.rb_pt, 0, CAD_Store.Read(CAD_Topo_FCove.lp1, 1)) }
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpI(" mate_e=", 8, CAD_Topo_FCove.e)
            CAD_Topo.FilletDumpS("\n", 1)
            CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            IfCondition EqualTo(CAD_Topo_FCove.sn, CAD_Store.Read(CAD_Topo_State.rb_pt, 5)) ThenBlock: {
                CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.rb_pt, 12)
                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_State.rb_pt, 5), CAD_Store.Read(CAD_Topo_State.rb_pt, 8)) ThenBlock: { CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.rb_pt, 13) }
            }
            CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Store.Read(CAD_Topo_State.rb_pt, 1), CAD_Topo_FCove.sn)
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("split e=", 8, CAD_Store.Read(CAD_Topo_State.rb_pt, 4))
        CAD_Topo.FilletDumpI(" f1=", 4, CAD_Store.Read(CAD_Topo_State.rb_pt, 14))
        CAD_Topo.FilletDumpI(" k1=", 4, CAD_Topo.FilletIRFaceKind(CAD_Store.Read(CAD_Topo_State.rb_pt, 14)))
        CAD_Topo.FilletDumpI(" f2=", 4, CAD_Store.Read(CAD_Topo_State.rb_pt, 0))
        CAD_Topo.FilletDumpI(" k2=", 4, CAD_Topo.FilletIRFaceKind(CAD_Store.Read(CAD_Topo_State.rb_pt, 0)))
        CAD_Topo.FilletDumpI(" two=", 5, CAD_Store.Read(CAD_Topo_State.rb_pt, 15))
        CAD_Topo.FilletDumpU(" R=", 3, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.rb_pt, 7), 10))
        CAD_Topo.FilletDumpU(" cz=", 4, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.rb_pt, 7), 3))
        CAD_Topo.FilletDumpU(" srcspan=", 9, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.rb_pt, 7), 12))
        CAD_Topo.FilletDumpU(" vz=", 4, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.rb_pt, 6), 2))
        CAD_Topo.FilletDumpU(" dR=", 4, CAD_Store.Read(CAD_Topo_State.rb_pt, 3))
        CAD_Topo.FilletDumpI(" eA=", 4, CAD_Store.Read(CAD_Topo_State.rb_pt, 1))
        CAD_Topo.FilletDumpI(" eB=", 4, CAD_Store.Read(CAD_Topo_State.rb_pt, 2))
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(CAD_Store.Read(CAD_Topo_State.rb_pt, 1))
    }
}

// Enclosure probes after plane∩cyl Local. Not a height gate on C.
Function.CAD_Topo.FilletEmitEnclosureProbe {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FLoc.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        ArraySet(CAD_Topo_FCove.pt, 0, CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        ArraySet(CAD_Topo_FCove.pt, 1, CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        ArraySet(CAD_Topo_FCove.pt, 2, 0x3FF0000000000000)
        CAD_Topo.FilletDumpI("encl z1=", 8, CAD_Topo.PointInSolid(CAD_Topo_FLoc.solid, CAD_Topo_FCove.pt))
        ArraySet(CAD_Topo_FCove.pt, 2, 0x4033000000000000)
        CAD_Topo.FilletDumpI(" z19=", 5, CAD_Topo.PointInSolid(CAD_Topo_FLoc.solid, CAD_Topo_FCove.pt))
        IfCondition NotEqual(CAD_Topo_FLoc.v1, 0) ThenBlock: {
            ArraySet(CAD_Topo_FCove.pt, 0, Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 0), CAD_Store.Read(CAD_Topo_FLoc.v1, 0)), 0x3FE0000000000000))
            ArraySet(CAD_Topo_FCove.pt, 1, Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 1), CAD_Store.Read(CAD_Topo_FLoc.v1, 1)), 0x3FE0000000000000))
            ArraySet(CAD_Topo_FCove.pt, 2, 0x4014000000000000)
            CAD_Topo.FilletDumpI(" chordz5=", 9, CAD_Topo.PointInSolid(CAD_Topo_FLoc.solid, CAD_Topo_FCove.pt))
        }
        IfCondition NotEqual(CAD_Topo_FLoc.va0, 0) ThenBlock: { CAD_Topo.FilletDumpU(" va0z=", 6, CAD_Store.Read(CAD_Topo_FLoc.va0, 2)) }
        IfCondition NotEqual(CAD_Topo_FLoc.va1, 0) ThenBlock: { CAD_Topo.FilletDumpU(" va1z=", 6, CAD_Store.Read(CAD_Topo_FLoc.va1, 2)) }
        IfCondition NotEqual(CAD_Topo_FLoc.vb0, 0) ThenBlock: { CAD_Topo.FilletDumpU(" vb0z=", 6, CAD_Store.Read(CAD_Topo_FLoc.vb0, 2)) }
        IfCondition NotEqual(CAD_Topo_FLoc.vb1, 0) ThenBlock: { CAD_Topo.FilletDumpU(" vb1z=", 6, CAD_Store.Read(CAD_Topo_FLoc.vb1, 2)) }
        CAD_Topo.FilletDumpS("\n", 1)
        CAD_Topo_FCove.shell = CAD_Store.Read(CAD_Topo_FLoc.solid, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.shell, 0)
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 16) {
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.g = 16 }
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                CAD_Topo_FCove.kind = CAD_Topo.FilletIRFaceKind(CAD_Topo_FCove.which)
                CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.which, 1)
                CAD_Topo.FilletDumpI("face=", 5, CAD_Topo_FCove.which)
                CAD_Topo.FilletDumpI(" k=", 3, CAD_Topo_FCove.kind)
                IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                    CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
                    CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
                    CAD_Topo_FCove.j = 0
                    WhileLoop LessThan(CAD_Topo_FCove.j, 8) {
                        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.j = 8 }
                        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                            CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                            CAD_Topo_FCove.s = 0
                            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                                CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                                IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: { CAD_Topo_FCove.s = CAD_Store.Read(CAD_Topo_FCove.nxt, 0) }
                            }
                            CAD_Topo.FilletDumpI(" e=", 3, CAD_Topo_FCove.e)
                            CAD_Topo.FilletDumpI(" ck=", 4, CAD_Topo_FCove.s)
                            IfCondition EqualTo(CAD_Topo_FCove.s, 2) ThenBlock: {
                                CAD_Topo.FilletDumpU(" R=", 3, CAD_Store.Read(CAD_Topo_FCove.nxt, 10))
                                CAD_Topo.FilletDumpU(" cz=", 4, CAD_Store.Read(CAD_Topo_FCove.nxt, 3))
                                CAD_Topo.FilletDumpU(" sp=", 4, CAD_Store.Read(CAD_Topo_FCove.nxt, 12))
                            }
                            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                            IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.j = 8 }
                        }
                        CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
                    }
                }
                CAD_Topo.FilletDumpS("\n", 1)
                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.which, 3)
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ReturnValue(1)
    }
}

// Host = the plane the most selected edges already name (IR 19) or
// sit on. Do not require mix or FindCoedge — after a top chamfer the
// bottom coedge walk can miss while the four rims are still a loop.
Function.CAD_Topo.FilletEmitPickChain {
    Output: Integer
    Body: {
        CAD_Topo_FComp.host = 0
        CAD_Topo_FComp.ok = 0
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            CAD_Topo_FComp.which = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
            IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: {
                CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
                IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FComp.e, CAD_Topo_FComp.faces), 0) ThenBlock: {
                    CAD_Topo_FComp.which = ArrayGet(CAD_Topo_FComp.faces, 0)
                    IfCondition NotEqual(CAD_Topo.FilletIRFaceKind(CAD_Topo_FComp.which), 1) ThenBlock: {
                        CAD_Topo_FComp.which = ArrayGet(CAD_Topo_FComp.faces, 1)
                    }
                }
            }
            IfCondition NotEqual(CAD_Topo_FComp.which, 0) ThenBlock: {
                CAD_Topo_FComp.k = 0
                CAD_Topo_FComp.j = 0
                WhileLoop LessThan(CAD_Topo_FComp.j, CAD_Topo_FComp.n) {
                    CAD_Topo_FComp.ce = 0
                    IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 19), CAD_Topo_FComp.which) ThenBlock: {
                        CAD_Topo_FComp.ce = 1
                    }
                    IfCondition EqualTo(CAD_Topo_FComp.ce, 0) ThenBlock: {
                        CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0)
                        IfCondition NotEqual(CAD_Topo.FindCoedgeOnFace(CAD_Topo_FComp.which, CAD_Topo_FComp.e), 0) ThenBlock: {
                            CAD_Topo_FComp.ce = 1
                        }
                    }
                    IfCondition EqualTo(CAD_Topo_FComp.ce, 1) ThenBlock: {
                        CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
                    }
                    CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
                }
                IfCondition GreaterThan(CAD_Topo_FComp.k, CAD_Topo_FComp.ok) ThenBlock: {
                    CAD_Topo_FComp.ok = CAD_Topo_FComp.k
                    CAD_Topo_FComp.host = CAD_Topo_FComp.which
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        CAD_Topo_FCove.n = 0
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
            CAD_Topo_FComp.ce = 0
            IfCondition EqualTo(CAD_Topo_FComp.host, 0) ThenBlock: { CAD_Topo_FComp.ce = 1 }
            IfCondition LessThan(CAD_Topo_FComp.ok, CAD_Topo_FComp.n) ThenBlock: { CAD_Topo_FComp.ce = 1 }
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19), CAD_Topo_FComp.host) ThenBlock: {
                CAD_Topo_FComp.ce = 1
            }
            IfCondition EqualTo(CAD_Topo_FComp.ce, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FindCoedgeOnFace(CAD_Topo_FComp.host, CAD_Topo_FComp.e), 0) ThenBlock: {
                    CAD_Topo_FComp.ce = 1
                }
            }
            IfCondition EqualTo(CAD_Topo_FComp.ce, 1) ThenBlock: {
                IfCondition LessThan(CAD_Topo_FCove.n, 12) ThenBlock: {
                    CAD_Topo.FCoveSet(372, CAD_Topo_FCove.n, CAD_Topo_FComp.e)
                    CAD_Topo_FCove.n = Add(CAD_Topo_FCove.n, 1)
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        IfCondition LessThan(CAD_Topo_FCove.n, 1) ThenBlock: {
            CAD_Topo_FCove.n = 0
            CAD_Topo_FComp.i = 0
            WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
                CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
                IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                    IfCondition LessThan(CAD_Topo_FCove.n, 12) ThenBlock: {
                        CAD_Topo.FCoveSet(372, CAD_Topo_FCove.n, CAD_Topo_FComp.e)
                        CAD_Topo_FCove.n = Add(CAD_Topo_FCove.n, 1)
                    }
                }
                CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
            }
        }
        PrintMessage("fillet IR pick n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage(" of ")
        PrintNumber(CAD_Topo_FComp.n)
        PrintMessage("\n")
        IfCondition LessThan(CAD_Topo_FCove.n, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Slot 36 = 2D convex (r−R) vs concave (r+R). Do NOT use PointInFaceUV:
// a concentric stadium's arc centre sits in the hole, so UV says "outside"
// and outer caps were tagged ID (r+R flange). IR mode/inner is the source.
Function.CAD_Topo.FilletEmitTagFromIR {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 1)
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo_FComp.j = 0
            WhileLoop LessThan(CAD_Topo_FComp.j, CAD_Topo_FComp.n) {
                IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0), CAD_Topo_FCove.e) ThenBlock: {
                    CAD_Topo_FComp.mode = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 21)
                    CAD_Topo_FComp.inner = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 2)
                    CAD_Topo_FComp.ok = 1
                    IfCondition EqualTo(CAD_Topo_FComp.inner, 1) ThenBlock: { CAD_Topo_FComp.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: { CAD_Topo_FComp.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: { CAD_Topo_FComp.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FComp.mode, 2) ThenBlock: { CAD_Topo_FComp.ok = 1 }
                    CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, CAD_Topo_FComp.ok)
                    PrintMessage("fillet IR tag i=")
                    PrintNumber(CAD_Topo_FCove.i)
                    PrintMessage(" inner=")
                    PrintNumber(CAD_Topo_FComp.inner)
                    PrintMessage(" mode=")
                    PrintNumber(CAD_Topo_FComp.mode)
                    PrintMessage(" conv=")
                    PrintNumber(CAD_Topo_FComp.ok)
                    PrintMessage("\n")
                    CAD_Topo_FComp.j = CAD_Topo_FComp.n
                }
                CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

// Host face + outward N_host + per-edge wall from IR (not FaceGetPlane[0]).
// Bottom plane often stores +Z (into the solid); Analyze already flipped it.
Function.CAD_Topo.FilletEmitBindFromIR {
    Output: Integer
    Body: {
        CAD_Topo_FCove.host_f = 0
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 11), 1) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19), 0) ThenBlock: {
                    CAD_Topo_FCove.host_f = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
                    CAD_Topo_FCove.n1x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 6)
                    CAD_Topo_FCove.n1y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 7)
                    CAD_Topo_FCove.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 8)
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: {
            CAD_Topo_FComp.i = 0
            WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
                IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19), 0) ThenBlock: {
                    CAD_Topo_FCove.host_f = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
                    CAD_Topo_FCove.n1x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 6)
                    CAD_Topo_FCove.n1y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 7)
                    CAD_Topo_FCove.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 8)
                }
                CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n1x), CAD_Num.Sq(CAD_Topo_FCove.n1y)), CAD_Num.Sq(CAD_Topo_FCove.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: {
            IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.host_f, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.n1x = ArrayGet(CAD_Topo_FCove.pl, 10)
            CAD_Topo_FCove.n1y = ArrayGet(CAD_Topo_FCove.pl, 11)
            CAD_Topo_FCove.n1z = ArrayGet(CAD_Topo_FCove.pl, 12)
            CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n1x), CAD_Num.Sq(CAD_Topo_FCove.n1y)), CAD_Num.Sq(CAD_Topo_FCove.n1z)))
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = Float_Div(CAD_Topo_FCove.n1x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1y = Float_Div(CAD_Topo_FCove.n1y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1z = Float_Div(CAD_Topo_FCove.n1z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo_FCove.f2 = 0
            CAD_Topo_FCove.kind = 1
            CAD_Topo_FComp.j = 0
            WhileLoop LessThan(CAD_Topo_FComp.j, CAD_Topo_FComp.n) {
                IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0), CAD_Topo_FCove.e) ThenBlock: {
                    CAD_Topo_FCove.f2 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 20)
                    CAD_Topo_FCove.kind = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 1)
                    CAD_Topo_FComp.j = CAD_Topo_FComp.n
                }
                CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
            }
            IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: {
                    CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 1)
                    IfCondition EqualTo(CAD_Topo_FCove.f2, CAD_Topo_FCove.host_f) ThenBlock: {
                        CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 0)
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.kind, 0) ThenBlock: { CAD_Topo_FCove.kind = 1 }
            CAD_Topo.FCoveSet(48, CAD_Topo_FCove.i, CAD_Topo_FCove.f2)
            CAD_Topo.FCoveSet(24, CAD_Topo_FCove.i, CAD_Topo_FCove.kind)
            CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 1)
            CAD_Topo.FCoveSet(384, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(408, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(390, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(396, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(420, CAD_Topo_FCove.i, 0)
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        PrintMessage("fillet IR emit host Nz=")
        CAD_Topo_FComp.k = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.n1z), 1) ThenBlock: { CAD_Topo_FComp.k = Subtract(0, 1) }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.n1z), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.n1z, 0), 0) ThenBlock: { CAD_Topo_FComp.k = 1 }
        }
        PrintNumber(CAD_Topo_FComp.k)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Compiler EMIT: build every rail from the IR, then one host/wall rewrite.
// Sequential Local after torus patches tore the oval (shells=7 faces=82).
Function.CAD_Topo.FilletEmitChain {
    Input: solid_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIREnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CAD_Topo_FComp.n, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_State.fillet_reason = 0
        CAD_Topo_FCove.solid = solid_handle
        CAD_Topo_FCove.r = radius_r
        CAD_Topo_FCove.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletEmitPickChain(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 21
            PrintMessage("fillet IR emit no chain\n")
            ReturnValue(0)
        }
        PrintMessage("fillet IR emit loop n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        IfCondition EqualTo(CAD_Topo.RimOrder(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 22
            PrintMessage("fillet IR emit order FAIL\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.FilletEmitBindFromIR(), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.RimFillHost(), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 23
                PrintMessage("fillet IR emit host FAIL\n")
                ReturnValue(0)
            }
        }
        CAD_Topo.FilletEmitTagFromIR()
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimSolveVert(CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 24
                PrintMessage("fillet IR emit vert FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.MixFixSharp(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 24
            PrintMessage("fillet IR emit vert3 FAIL\n")
            CAD_Topo.FilletDumpEmit()
            ReturnValue(0)
        }
        CAD_Topo.FilletDumpEmit()
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimMakeSeg(CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 25
                PrintMessage("fillet IR emit seg FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimSwap(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 26
            PrintMessage("fillet IR emit swap FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveMakeJoinFace(CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 27
                PrintMessage("fillet IR emit face FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.MixMakeSphere(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 27
            PrintMessage("fillet IR emit sphere FAIL\n")
            ReturnValue(0)
        }
        PrintMessage("fillet IR emit ok n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        CAD_Topo.FilletDumpEmit()
        CAD_Topo.FilletDumpClose()
        ReturnValue(solid_handle)
    }
}
