LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Sys

// Host = the plane the most selected edges already name (IR 19) or
// sit on. Do not require mix or FindCoedge — after a top chamfer the
// bottom coedge walk can miss while the four rims are still a loop.
Function.CAD_Topo.FilletEmitPickChain {
    Output: Integer
    Body: {
        CAD_Topo_FComp.host = 0
        CAD_Topo_FComp.ok = 0
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            CAD_Topo_FComp.which = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
            IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: {
                CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
                IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FComp.e, CAD_Topo_FComp.faces), 0) ThenBlock: {
                    CAD_Topo_FComp.which = ArrayGet(CAD_Topo_FComp.faces, 0)
                    IfCondition NotEqual(CAD_Topo.FilletIRFaceKind(CAD_Topo_FComp.which), 1) ThenBlock: {
                        CAD_Topo_FComp.which = ArrayGet(CAD_Topo_FComp.faces, 1)
                    }
                }
            }
            IfCondition NotEqual(CAD_Topo_FComp.which, 0) ThenBlock: {
                CAD_Topo_FComp.k = 0
                CAD_Topo_FComp.j = 0
                WhileLoop LessThan(CAD_Topo_FComp.j, CAD_Topo_FComp.n) {
                    CAD_Topo_FComp.ce = 0
                    IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 19), CAD_Topo_FComp.which) ThenBlock: {
                        CAD_Topo_FComp.ce = 1
                    }
                    IfCondition EqualTo(CAD_Topo_FComp.ce, 0) ThenBlock: {
                        CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0)
                        IfCondition NotEqual(CAD_Topo.FindCoedgeOnFace(CAD_Topo_FComp.which, CAD_Topo_FComp.e), 0) ThenBlock: {
                            CAD_Topo_FComp.ce = 1
                        }
                    }
                    IfCondition EqualTo(CAD_Topo_FComp.ce, 1) ThenBlock: {
                        CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
                    }
                    CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
                }
                IfCondition GreaterThan(CAD_Topo_FComp.k, CAD_Topo_FComp.ok) ThenBlock: {
                    CAD_Topo_FComp.ok = CAD_Topo_FComp.k
                    CAD_Topo_FComp.host = CAD_Topo_FComp.which
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        CAD_Topo_FCove.n = 0
        CAD_Topo_FComp.i = 0
        // hfilt is one host face. Do not pull every selected edge in,
        // and do not pull an edge whose slot 19 names a different face
        // (that edge's coedge also sits on the side wall).
        IfCondition NotEqual(CAD_Topo_FComp.hfilt, 0) ThenBlock: {
            CAD_Topo_FComp.host = CAD_Topo_FComp.hfilt
            CAD_Topo_FComp.ok = CAD_Topo_FComp.n
        }
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
            CAD_Topo_FComp.ce = 0
            IfCondition EqualTo(CAD_Topo_FComp.hfilt, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FComp.host, 0) ThenBlock: { CAD_Topo_FComp.ce = 1 }
                IfCondition LessThan(CAD_Topo_FComp.ok, CAD_Topo_FComp.n) ThenBlock: { CAD_Topo_FComp.ce = 1 }
            }
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19), CAD_Topo_FComp.host) ThenBlock: {
                CAD_Topo_FComp.ce = 1
            }
            IfCondition EqualTo(CAD_Topo_FComp.ce, 0) ThenBlock: {
                CAD_Topo_FComp.which = 1
                IfCondition NotEqual(CAD_Topo_FComp.hfilt, 0) ThenBlock: {
                    CAD_Topo_FComp.edx = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
                    IfCondition NotEqual(CAD_Topo_FComp.edx, 0) ThenBlock: { CAD_Topo_FComp.which = 0 }
                }
                IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo.FindCoedgeOnFace(CAD_Topo_FComp.host, CAD_Topo_FComp.e), 0) ThenBlock: {
                        CAD_Topo_FComp.ce = 1
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FComp.ce, 1) ThenBlock: {
                IfCondition LessThan(CAD_Topo_FCove.n, 12) ThenBlock: {
                    CAD_Topo.FCoveSet(372, CAD_Topo_FCove.n, CAD_Topo_FComp.e)
                    CAD_Topo_FCove.n = Add(CAD_Topo_FCove.n, 1)
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        IfCondition LessThan(CAD_Topo_FCove.n, 1) ThenBlock: {
            CAD_Topo_FCove.n = 0
            CAD_Topo_FComp.i = 0
            WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
                CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
                IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                    IfCondition LessThan(CAD_Topo_FCove.n, 12) ThenBlock: {
                        CAD_Topo.FCoveSet(372, CAD_Topo_FCove.n, CAD_Topo_FComp.e)
                        CAD_Topo_FCove.n = Add(CAD_Topo_FCove.n, 1)
                    }
                }
                CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
            }
        }
        PrintMessage("fillet IR pick n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage(" of ")
        PrintNumber(CAD_Topo_FComp.n)
        PrintMessage("\n")
        IfCondition LessThan(CAD_Topo_FCove.n, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Reason 22 means the selection is not one chain. Emit each host face
// that does order (top, then bottom), then the leftover lines. If no
// host orders, leave reason 22: two disconnected verticals still refuse.
Function.CAD_Topo.FilletEmitSplitHosts {
    Input: solid_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIREnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CAD_Topo_FComp.n, 1) ThenBlock: { ReturnValue(0) }
        nedges = CAD_Topo_FComp.n
        // Note corners before the rims move edge vertices. A 3-edge
        // corner stays above 2 so the canal's sphere pass still sees it.
        IfCondition NotEqual(CAD_Topo.FilletVertReset(), 0) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, nedges) {
                e = CAD_Topo.FilletIRGet(i, 0)
                IfCondition NotEqual(e, 0) ThenBlock: {
                    v = CAD_Store.Read(e, 0)
                    IfCondition NotEqual(v, 0) ThenBlock: {
                        CAD_Topo.FilletVertNote(CAD_Store.Read(v, 0), CAD_Store.Read(v, 1), CAD_Store.Read(v, 2))
                    }
                    v = CAD_Store.Read(e, 1)
                    IfCondition NotEqual(v, 0) ThenBlock: {
                        CAD_Topo.FilletVertNote(CAD_Store.Read(v, 0), CAD_Store.Read(v, 1), CAD_Store.Read(v, 2))
                    }
                }
                i = Add(i, 1)
            }
            PrintMessage("fillet split note n=")
            PrintNumber(CAD_Topo_FVert.n)
            PrintMessage("\n")
        }
        i = 0
        WhileLoop LessThan(i, 192) {
            ArraySet(CAD_Topo_FComp.grp, i, 0)
            i = Add(i, 1)
        }
        nh = 0
        i = 0
        WhileLoop LessThan(i, nedges) {
            face = CAD_Topo.FilletIRGet(i, 19)
            IfCondition NotEqual(face, 0) ThenBlock: {
                found = 0
                k = 0
                WhileLoop LessThan(k, nh) {
                    prev = ArrayGet(CAD_Topo_FComp.grp, Add(64, k))
                    IfCondition EqualTo(prev, face) ThenBlock: { found = 1 }
                    k = Add(k, 1)
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    IfCondition LessThan(nh, 64) ThenBlock: {
                        ArraySet(CAD_Topo_FComp.grp, Add(64, nh), face)
                        nh = Add(nh, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        a = 0
        WhileLoop LessThan(a, nh) {
            best = a
            bestc = 0
            k = 0
            WhileLoop LessThan(k, nedges) {
                on = CAD_Topo.FilletEmitOnHost(k, ArrayGet(CAD_Topo_FComp.grp, Add(64, a)))
                IfCondition EqualTo(on, 1) ThenBlock: { bestc = Add(bestc, 1) }
                k = Add(k, 1)
            }
            b = Add(a, 1)
            WhileLoop LessThan(b, nh) {
                cntb = 0
                k = 0
                WhileLoop LessThan(k, nedges) {
                    on = CAD_Topo.FilletEmitOnHost(k, ArrayGet(CAD_Topo_FComp.grp, Add(64, b)))
                    IfCondition EqualTo(on, 1) ThenBlock: { cntb = Add(cntb, 1) }
                    k = Add(k, 1)
                }
                IfCondition GreaterThan(cntb, bestc) ThenBlock: {
                    best = b
                    bestc = cntb
                }
                b = Add(b, 1)
            }
            IfCondition NotEqual(best, a) ThenBlock: {
                tmp = ArrayGet(CAD_Topo_FComp.grp, Add(64, a))
                ArraySet(CAD_Topo_FComp.grp, Add(64, a), ArrayGet(CAD_Topo_FComp.grp, Add(64, best)))
                ArraySet(CAD_Topo_FComp.grp, Add(64, best), tmp)
            }
            a = Add(a, 1)
        }
        emitted = 0
        hi = 0
        WhileLoop LessThan(hi, nh) {
            face = ArrayGet(CAD_Topo_FComp.grp, Add(64, hi))
            cnt = 0
            allcove = 1
            k = 0
            WhileLoop LessThan(k, nedges) {
                mark = ArrayGet(CAD_Topo_FComp.grp, k)
                IfCondition EqualTo(mark, 0) ThenBlock: {
                    on = CAD_Topo.FilletEmitOnHost(k, face)
                    IfCondition EqualTo(on, 1) ThenBlock: {
                        cnt = Add(cnt, 1)
                        side = CAD_Topo.FilletIRGet(k, 3)
                        IfCondition NotEqual(side, 0) ThenBlock: { allcove = 0 }
                    }
                }
                k = Add(k, 1)
            }
            IfCondition GreaterThan(cnt, 1) ThenBlock: {
                IfCondition LessEqual(cnt, 12) ThenBlock: {
                    CAD_Topo_FComp.n = nedges
                    CAD_Topo_FComp.hfilt = face
                    CAD_Topo_State.fillet_concave = 0
                    IfCondition EqualTo(allcove, 1) ThenBlock: { CAD_Topo_State.fillet_concave = 1 }
                    CAD_Topo_State.fillet_reason = 0
                    PrintMessage("fillet split host n=")
                    PrintNumber(cnt)
                    PrintMessage("\n")
                    res = CAD_Topo.FilletEmitChain(solid_handle, radius_r)
                    CAD_Topo_FComp.hfilt = 0
                    CAD_Topo_FComp.n = nedges
                    IfCondition NotEqual(res, 0) ThenBlock: {
                        emitted = Add(emitted, 1)
                        k = 0
                        WhileLoop LessThan(k, nedges) {
                            on = CAD_Topo.FilletEmitOnHost(k, face)
                            IfCondition EqualTo(on, 1) ThenBlock: { ArraySet(CAD_Topo_FComp.grp, k, 1) }
                            k = Add(k, 1)
                        }
                    }
                    IfCondition EqualTo(res, 0) ThenBlock: {
                        PrintMessage("fillet split miss reason=")
                        PrintNumber(CAD_Topo_State.fillet_reason)
                        PrintMessage("\n")
                    }
                }
            }
            hi = Add(hi, 1)
        }
        CAD_Topo_FComp.hfilt = 0
        CAD_Topo_FComp.n = nedges
        IfCondition EqualTo(emitted, 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 22
            PrintMessage("fillet split no host\n")
            ReturnValue(0)
        }
        nleft = 0
        i = 0
        WhileLoop LessThan(i, nedges) {
            mark = ArrayGet(CAD_Topo_FComp.grp, i)
            IfCondition EqualTo(mark, 0) ThenBlock: {
                kind = CAD_Topo.FilletIRGet(i, 1)
                IfCondition EqualTo(kind, 1) ThenBlock: {
                    eh = CAD_Topo.FilletIRGet(i, 0)
                    IfCondition NotEqual(eh, 0) ThenBlock: {
                        IfCondition LessThan(nleft, 64) ThenBlock: {
                            ArraySet(CAD_Topo_FComp.left, nleft, eh)
                            nleft = Add(nleft, 1)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        PrintMessage("fillet split left=")
        PrintNumber(nleft)
        PrintMessage(" emitted=")
        PrintNumber(emitted)
        PrintMessage("\n")
        // Rims are in. Sharp verticals were not shortened. Canal them
        // on the convex center, then the same octant as the cube.
        // Sequential after a mutated solid tore the shell. Leave it below.
        IfCondition GreaterThan(emitted, 0) ThenBlock: {
            CAD_Topo_State.fillet_concave = 0
            CAD_Topo_State.fillet_reason = 0
            ReturnValue(CAD_Topo.FilletEmitVertCanals(solid_handle, radius_r, nleft))
        }
        IfCondition LessThan(nleft, 1) ThenBlock: {
            CAD_Topo_State.fillet_concave = 0
            CAD_Topo_State.fillet_reason = 0
            ReturnValue(solid_handle)
        }
        allcove = 1
        i = 0
        WhileLoop LessThan(i, nedges) {
            mark = ArrayGet(CAD_Topo_FComp.grp, i)
            IfCondition EqualTo(mark, 0) ThenBlock: {
                kind = CAD_Topo.FilletIRGet(i, 1)
                IfCondition EqualTo(kind, 1) ThenBlock: {
                    side = CAD_Topo.FilletIRGet(i, 3)
                    IfCondition NotEqual(side, 0) ThenBlock: { allcove = 0 }
                }
            }
            i = Add(i, 1)
        }
        CAD_Topo_State.fillet_concave = 0
        IfCondition EqualTo(allcove, 1) ThenBlock: { CAD_Topo_State.fillet_concave = 1 }
        CAD_Topo_State.fillet_reason = 0
        seq = CAD_Topo.FilletEdgesSequential(solid_handle, CAD_Topo_FComp.left, nleft, radius_r)
        IfCondition EqualTo(seq, 0) ThenBlock: {
            PrintMessage("fillet split vert miss\n")
            ReturnValue(0)
        }
        ReturnValue(seq)
    }
}

// Compiler EMIT: build every rail from the IR, then one host/wall rewrite.
// Sequential Local after torus patches tore the oval (shells=7 faces=82).
Function.CAD_Topo.FilletEmitChain {
    Input: solid_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIREnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CAD_Topo_FComp.n, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_State.fillet_reason = 0
        CAD_Topo_FCove.solid = solid_handle
        CAD_Topo_FCove.r = radius_r
        CAD_Topo_FCove.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletEmitPickChain(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 21
            PrintMessage("fillet IR emit no chain\n")
            ReturnValue(0)
        }
        IfCondition GreaterThan(CAD_Topo_FCove.n, 12) ThenBlock: {
            CAD_Topo_State.fillet_reason = 21
            PrintMessage("fillet IR emit n>12\n")
            ReturnValue(0)
        }
        PrintMessage("fillet IR emit loop n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        IfCondition EqualTo(CAD_Topo.RimOrder(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 22
            PrintMessage("fillet IR emit order FAIL\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.FilletEmitBindFromIR(), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.RimFillHost(), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 23
                PrintMessage("fillet IR emit host FAIL\n")
                ReturnValue(0)
            }
        }
        CAD_Topo.FilletEmitTagFromIR()
        IfCondition EqualTo(CAD_Topo.FilletEmitHoleClear(), 0) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimSolveVert(CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 24
                PrintMessage("fillet IR emit vert FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.MixFixSharp(), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_State.fillet_reason, 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 24
            }
            PrintMessage("fillet IR emit vert3 FAIL\n")
            CAD_Topo.FilletDumpEmit()
            ReturnValue(0)
        }
        CAD_Topo.FilletDumpEmit()
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimMakeSeg(CAD_Topo_FCove.i), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_State.fillet_reason, 0) ThenBlock: {
                    CAD_Topo_State.fillet_reason = 25
                }
                PrintMessage("fillet IR emit seg FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimSwap(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 26
            PrintMessage("fillet IR emit swap FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveMakeJoinFace(CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_State.fillet_reason = 27
                PrintMessage("fillet IR emit face FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo.FilletSewDropTri(CAD_Topo_FCove.i)
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.MixMakeSphere(), 0) ThenBlock: {
            CAD_Topo_State.fillet_reason = 27
            PrintMessage("fillet IR emit sphere FAIL\n")
            ReturnValue(0)
        }
        PrintMessage("fillet IR emit ok n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        // Coplanar line+arc rim is class 8. A chain that changes host
        // (top plus side springs) stays the plex class.
        IfCondition EqualTo(CAD_Topo.FilletIRCoplanar(), 1) ThenBlock: {
            CAD_Topo_State.fillet_class = 8
        }
        CAD_Topo.FilletDumpEmit()
        CAD_Topo.FilletDumpClose()
        ReturnValue(solid_handle)
    }
}

// Host face + outward N_host + per-edge wall from IR (not FaceGetPlane[0]).
// Bottom plane often stores +Z (into the solid); Analyze already flipped it.
Function.CAD_Topo.FilletEmitBindFromIR {
    Output: Integer
    Body: {
        CAD_Topo_FCove.host_f = 0
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 11), 1) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19), 0) ThenBlock: {
                    CAD_Topo_FCove.host_f = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
                    CAD_Topo_FCove.n1x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 6)
                    CAD_Topo_FCove.n1y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 7)
                    CAD_Topo_FCove.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 8)
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: {
            CAD_Topo_FComp.i = 0
            WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
                IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19), 0) ThenBlock: {
                    CAD_Topo_FCove.host_f = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
                    CAD_Topo_FCove.n1x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 6)
                    CAD_Topo_FCove.n1y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 7)
                    CAD_Topo_FCove.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 8)
                }
                CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n1x), CAD_Num.Sq(CAD_Topo_FCove.n1y)), CAD_Num.Sq(CAD_Topo_FCove.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: {
            IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.host_f, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.n1x = ArrayGet(CAD_Topo_FCove.pl, 10)
            CAD_Topo_FCove.n1y = ArrayGet(CAD_Topo_FCove.pl, 11)
            CAD_Topo_FCove.n1z = ArrayGet(CAD_Topo_FCove.pl, 12)
            CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FCove.n1x), CAD_Num.Sq(CAD_Topo_FCove.n1y)), CAD_Num.Sq(CAD_Topo_FCove.n1z)))
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = Float_Div(CAD_Topo_FCove.n1x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1y = Float_Div(CAD_Topo_FCove.n1y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n1z = Float_Div(CAD_Topo_FCove.n1z, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo_FCove.f2 = 0
            CAD_Topo_FCove.kind = 1
            CAD_Topo_FComp.j = 0
            WhileLoop LessThan(CAD_Topo_FComp.j, CAD_Topo_FComp.n) {
                IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0), CAD_Topo_FCove.e) ThenBlock: {
                    CAD_Topo_FCove.f2 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 20)
                    CAD_Topo_FCove.kind = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 1)
                    CAD_Topo_FComp.j = CAD_Topo_FComp.n
                }
                CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
            }
            IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: {
                    CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 1)
                    IfCondition EqualTo(CAD_Topo_FCove.f2, CAD_Topo_FCove.host_f) ThenBlock: {
                        CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 0)
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.kind, 0) ThenBlock: { CAD_Topo_FCove.kind = 1 }
            CAD_Topo.FCoveSet(48, CAD_Topo_FCove.i, CAD_Topo_FCove.f2)
            CAD_Topo.FCoveSet(24, CAD_Topo_FCove.i, CAD_Topo_FCove.kind)
            CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 1)
            CAD_Topo.FCoveSet(384, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(408, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(480, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(396, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(420, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(492, CAD_Topo_FCove.i, 0)
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        PrintMessage("fillet IR emit host Nz=")
        CAD_Topo_FComp.k = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.n1z), 1) ThenBlock: { CAD_Topo_FComp.k = Subtract(0, 1) }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.n1z), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.n1z, 0), 0) ThenBlock: { CAD_Topo_FComp.k = 1 }
        }
        PrintNumber(CAD_Topo_FComp.k)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Slot 36 = 2D convex (r−R) vs concave (r+R). IR mode is the source:
// FilletPlexIdentifyPair1 (N2 vs host-coedge left), not inner=0 and not
// PointInFaceUV of the arc centre.
Function.CAD_Topo.FilletEmitTagFromIR {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 1)
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo_FComp.j = 0
            WhileLoop LessThan(CAD_Topo_FComp.j, CAD_Topo_FComp.n) {
                IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0), CAD_Topo_FCove.e) ThenBlock: {
                    CAD_Topo_FComp.mode = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 21)
                    CAD_Topo_FComp.inner = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 2)
                    CAD_Topo_FComp.ok = 1
                    IfCondition EqualTo(CAD_Topo_FComp.inner, 1) ThenBlock: { CAD_Topo_FComp.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: { CAD_Topo_FComp.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FComp.mode, 1) ThenBlock: { CAD_Topo_FComp.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FComp.mode, 2) ThenBlock: { CAD_Topo_FComp.ok = 1 }
                    CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, CAD_Topo_FComp.ok)
                    PrintMessage("fillet IR tag i=")
                    PrintNumber(CAD_Topo_FCove.i)
                    PrintMessage(" inner=")
                    PrintNumber(CAD_Topo_FComp.inner)
                    PrintMessage(" mode=")
                    PrintNumber(CAD_Topo_FComp.mode)
                    PrintMessage(" conv=")
                    PrintNumber(CAD_Topo_FComp.ok)
                    PrintMessage("\n")
                    CAD_Topo_FComp.j = CAD_Topo_FComp.n
                }
                CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

// One remainder curve. Cap and wall twins share that edge.
Function.CAD_Topo.FilletEmitCircleEnd {
    Input: edge_h: Integer
    Input: old_v: Integer
    Input: new_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_v, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok = CAD_Topo.FilletEmitPark()
        IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.e = CAD_Store.Read(edge_h, 2)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), 2) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.hit = 0
        IfCondition EqualTo(CAD_Store.Read(edge_h, 0), CAD_Store.Read(edge_h, 1)) ThenBlock: { CAD_Topo_FCove.hit = 1 }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Store.Read(CAD_Topo_FCove.e, 12), 0), 1) ThenBlock: { CAD_Topo_FCove.hit = 1 }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Topo.FilletEmitOpenRimEdge(CAD_Topo_FCove.e, old_v, edge_h)
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                PrintMessage("fillet plex open-rim redirect\n")
                edge_h = CAD_Topo_FCove.which
                CAD_Topo_FCove.e = CAD_Store.Read(edge_h, 2)
                IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(0) }
            }
        }
        CAD_Store.Write(CAD_Topo_FCove.ok, 4, edge_h)
        CAD_Store.Write(CAD_Topo_FCove.ok, 5, old_v)
        CAD_Store.Write(CAD_Topo_FCove.ok, 6, new_v)
        CAD_Store.Write(CAD_Topo_FCove.ok, 7, CAD_Topo_FCove.e)
        CAD_Store.Write(CAD_Topo_FCove.ok, 8, CAD_Store.Read(edge_h, 0))
        CAD_Store.Write(CAD_Topo_FCove.ok, 9, CAD_Store.Read(edge_h, 1))
        CAD_Store.Write(CAD_Topo_FCove.ok, 10, CAD_Store.Read(edge_h, 3))
        CAD_Store.Write(CAD_Topo_FCove.ok, 11, CAD_Store.Read(edge_h, 4))
        CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_State.emit_pt, 8)
        CAD_Topo_FCove.bb = CAD_Store.Read(CAD_Topo_State.emit_pt, 9)
        IfCondition EqualTo(CAD_Topo_FCove.aa, old_v) ThenBlock: { CAD_Topo_FCove.aa = new_v }
        IfCondition EqualTo(CAD_Topo_FCove.bb, CAD_Store.Read(CAD_Topo_State.emit_pt, 5)) ThenBlock: { CAD_Topo_FCove.bb = CAD_Store.Read(CAD_Topo_State.emit_pt, 6) }
        CAD_Store.Write(CAD_Topo_State.emit_pt, 12, CAD_Topo_FCove.aa)
        CAD_Store.Write(CAD_Topo_State.emit_pt, 13, CAD_Topo_FCove.bb)
        CAD_Topo_FCove.f1 = 0
        CAD_Topo_FCove.f2 = 0
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_State.emit_pt, 10)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.ce, 4)
            IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: { CAD_Topo_FCove.f1 = CAD_Store.Read(CAD_Topo_FCove.lp, 1) }
        }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_State.emit_pt, 11)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Topo_FCove.lp1 = CAD_Store.Read(CAD_Topo_FCove.ce, 4)
            IfCondition NotEqual(CAD_Topo_FCove.lp1, 0) ThenBlock: { CAD_Topo_FCove.f2 = CAD_Store.Read(CAD_Topo_FCove.lp1, 1) }
        }
        CAD_Store.Write(CAD_Topo_State.emit_pt, 14, CAD_Topo_FCove.f1)
        CAD_Store.Write(CAD_Topo_State.emit_pt, 0, CAD_Topo_FCove.f2)
        CAD_Topo_FCove.kind = 0
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_State.emit_pt, 14), 0) ThenBlock: {
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_State.emit_pt, 0), 0) ThenBlock: {
                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_State.emit_pt, 14), CAD_Store.Read(CAD_Topo_State.emit_pt, 0)) ThenBlock: { CAD_Topo_FCove.kind = 1 }
            }
        }
        CAD_Store.Write(CAD_Topo_State.emit_pt, 15, CAD_Topo_FCove.kind)
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.emit_pt, 6), 0), CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.emit_pt, 7), 1))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.emit_pt, 6), 1), CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.emit_pt, 7), 2))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.emit_pt, 6), 2), CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.emit_pt, 7), 3))
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
        CAD_Store.Write(CAD_Topo_State.emit_pt, 3, CAD_Num.Abs(Float_Sub(CAD_Topo_FCove.ln, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.emit_pt, 7), 10))))
        // 0.05 mm. The center of the old fillet circle is a full radius
        // off; splitting there returns span 0 and leaves the splice.
        IfCondition EqualTo(CAD_Num.Le(CAD_Store.Read(CAD_Topo_State.emit_pt, 3), 0x3FA999999999999A), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpU(" dRoff=", 7, CAD_Store.Read(CAD_Topo_State.emit_pt, 3))
            CAD_Topo.FilletDumpS("\n", 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_State.emit_pt, 12), CAD_Store.Read(CAD_Topo_State.emit_pt, 13)) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpI("va=vb ", 6, CAD_Store.Read(CAD_Topo_State.emit_pt, 12))
            CAD_Topo.FilletDumpS("\n", 1)
            ReturnValue(0)
        }
        CAD_Topo_FCove.hit = CAD_Topo.FilletEmitCircleRemainder(CAD_Store.Read(CAD_Topo_State.emit_pt, 12), CAD_Store.Read(CAD_Topo_State.emit_pt, 13), CAD_Store.Read(CAD_Topo_State.emit_pt, 7), CAD_Store.Read(CAD_Topo_State.emit_pt, 4), CAD_Store.Read(CAD_Topo_State.emit_pt, 8))
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Topo_State.emit_pt, 1, CAD_Topo_FCove.hit)
        CAD_Store.Write(CAD_Topo_State.emit_pt, 2, CAD_Topo_FCove.hit)
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_State.emit_pt, 10)
        CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_State.emit_pt, 5)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            IfCondition EqualTo(CAD_Topo_FCove.sn, CAD_Topo_FCove.orig) ThenBlock: {
                CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.emit_pt, 12)
                IfCondition NotEqual(CAD_Topo_FCove.orig, CAD_Store.Read(CAD_Topo_State.emit_pt, 8)) ThenBlock: { CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.emit_pt, 13) }
            }
            CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Store.Read(CAD_Topo_State.emit_pt, 1), CAD_Topo_FCove.sn)
        }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_State.emit_pt, 11)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Store.Write(CAD_Topo_State.emit_pt, 15, 1)
            CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            IfCondition EqualTo(CAD_Topo_FCove.sn, CAD_Store.Read(CAD_Topo_State.emit_pt, 5)) ThenBlock: {
                CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.emit_pt, 12)
                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_State.emit_pt, 5), CAD_Store.Read(CAD_Topo_State.emit_pt, 8)) ThenBlock: { CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.emit_pt, 13) }
            }
            CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Store.Read(CAD_Topo_State.emit_pt, 1), CAD_Topo_FCove.sn)
        }
        CAD_Topo_FCove.ce = CAD_Topo.FilletEmitRimMateCe(CAD_Store.Read(CAD_Topo_State.emit_pt, 7), CAD_Store.Read(CAD_Topo_State.emit_pt, 4), CAD_Store.Read(CAD_Topo_State.emit_pt, 5))
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Store.Write(CAD_Topo_State.emit_pt, 15, 1)
            CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
            CAD_Topo_FCove.lp1 = CAD_Store.Read(CAD_Topo_FCove.ce, 4)
            IfCondition NotEqual(CAD_Topo_FCove.lp1, 0) ThenBlock: { CAD_Store.Write(CAD_Topo_State.emit_pt, 0, CAD_Store.Read(CAD_Topo_FCove.lp1, 1)) }
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpI(" mate_e=", 8, CAD_Topo_FCove.e)
            CAD_Topo.FilletDumpS("\n", 1)
            CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            IfCondition EqualTo(CAD_Topo_FCove.sn, CAD_Store.Read(CAD_Topo_State.emit_pt, 5)) ThenBlock: {
                CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.emit_pt, 12)
                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_State.emit_pt, 5), CAD_Store.Read(CAD_Topo_State.emit_pt, 8)) ThenBlock: { CAD_Topo_FCove.sn = CAD_Store.Read(CAD_Topo_State.emit_pt, 13) }
            }
            CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Store.Read(CAD_Topo_State.emit_pt, 1), CAD_Topo_FCove.sn)
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("split e=", 8, CAD_Store.Read(CAD_Topo_State.emit_pt, 4))
        CAD_Topo.FilletDumpI(" f1=", 4, CAD_Store.Read(CAD_Topo_State.emit_pt, 14))
        CAD_Topo.FilletDumpI(" k1=", 4, CAD_Topo.FilletIRFaceKind(CAD_Store.Read(CAD_Topo_State.emit_pt, 14)))
        CAD_Topo.FilletDumpI(" f2=", 4, CAD_Store.Read(CAD_Topo_State.emit_pt, 0))
        CAD_Topo.FilletDumpI(" k2=", 4, CAD_Topo.FilletIRFaceKind(CAD_Store.Read(CAD_Topo_State.emit_pt, 0)))
        CAD_Topo.FilletDumpI(" two=", 5, CAD_Store.Read(CAD_Topo_State.emit_pt, 15))
        CAD_Topo.FilletDumpU(" R=", 3, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.emit_pt, 7), 10))
        CAD_Topo.FilletDumpU(" cz=", 4, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.emit_pt, 7), 3))
        CAD_Topo.FilletDumpU(" srcspan=", 9, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.emit_pt, 7), 12))
        CAD_Topo.FilletDumpU(" vz=", 4, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.emit_pt, 6), 2))
        CAD_Topo.FilletDumpU(" dR=", 4, CAD_Store.Read(CAD_Topo_State.emit_pt, 3))
        CAD_Topo.FilletDumpI(" eA=", 4, CAD_Store.Read(CAD_Topo_State.emit_pt, 1))
        CAD_Topo.FilletDumpI(" eB=", 4, CAD_Store.Read(CAD_Topo_State.emit_pt, 2))
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(CAD_Store.Read(CAD_Topo_State.emit_pt, 1))
    }
}

// Host CIRCLE remainder. Park is a fresh Store cell; handle in vmap_old
// (Tess sc_crv class — not FCove, not rb_*, not pick). Slot 0 clone, 1 va,
// 2 vb, 3 srcspan, 4 A, 5 B, 6 g.
Function.CAD_Topo.FilletEmitCircleRemainder {
    Input: va: Integer
    Input: vb: Integer
    Input: circ_h: Integer
    Input: src_edge: Integer
    Input: start_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(circ_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_State.vmap_old = CAD_Store.Alloc(8, 8)
        IfCondition EqualTo(CAD_Topo_State.vmap_old, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Topo_State.vmap_old, 1, va)
        CAD_Store.Write(CAD_Topo_State.vmap_old, 2, vb)
        CAD_Topo_FCove.d12 = CAD_Store.Read(circ_h, 12)
        // span=0 means unset (full-circle slot). Infer the minor arc from
        // the source edge vertices — otherwise PosMod2Pi keeps a 7° ear.
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.d12, 0), 1) ThenBlock: {
            IfCondition NotEqual(src_edge, 0) ThenBlock: {
                CAD_Topo_FCove.aa = CAD_Store.Read(src_edge, 0)
                CAD_Topo_FCove.bb = CAD_Store.Read(src_edge, 1)
                IfCondition NotEqual(CAD_Topo_FCove.aa, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.bb, 0) ThenBlock: {
                        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.aa, 0), CAD_Store.Read(circ_h, 1))
                        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.aa, 1), CAD_Store.Read(circ_h, 2))
                        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.aa, 2), CAD_Store.Read(circ_h, 3))
                        CAD_Topo_FCove.ln = CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 7)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 8))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 9))), Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 4)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 5))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 6))))
                        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.bb, 0), CAD_Store.Read(circ_h, 1))
                        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.bb, 1), CAD_Store.Read(circ_h, 2))
                        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.bb, 2), CAD_Store.Read(circ_h, 3))
                        CAD_Topo_FCove.ab = CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 7)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 8))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 9))), Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(circ_h, 4)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(circ_h, 5))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(circ_h, 6))))
                        CAD_Topo_FCove.d12 = Float_Sub(CAD_Topo_FCove.ab, CAD_Topo_FCove.ln)
                        CAD_Topo_FCove.g = 0x400921FB54442D18
                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FCove.d12, Float_Sub(0, CAD_Topo_FCove.g))), 1) ThenBlock: {
                            CAD_Topo_FCove.d12 = Float_Add(CAD_Topo_FCove.d12, 0x401921FB54442D18)
                        }
                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FCove.g, CAD_Topo_FCove.d12)), 1) ThenBlock: {
                            CAD_Topo_FCove.d12 = Float_Sub(CAD_Topo_FCove.d12, 0x401921FB54442D18)
                        }
                    }
                }
            }
        }
        IfCondition NotEqual(src_edge, 0) ThenBlock: {
            IfCondition NotEqual(start_v, 0) ThenBlock: {
                IfCondition NotEqual(start_v, CAD_Store.Read(src_edge, 0)) ThenBlock: {
                    CAD_Topo_FCove.d12 = Float_Sub(0, CAD_Topo_FCove.d12)
                }
            }
        }
        CAD_Store.Write(CAD_Topo_State.vmap_old, 3, CAD_Topo_FCove.d12)
        CAD_Topo_State.vmap_new = CAD_Store.Alloc(16, 15)
        IfCondition EqualTo(CAD_Topo_State.vmap_new, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Topo_State.vmap_old, 0, CAD_Topo_State.vmap_new)
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 15) {
            CAD_Store.Write(CAD_Topo_State.vmap_new, CAD_Topo_FCove.g, CAD_Store.Read(circ_h, CAD_Topo_FCove.g))
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_State.vmap_old, 0)
        CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_State.vmap_old, 1)
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.aa, 0), CAD_Store.Read(CAD_Topo_FCove.ok, 1))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.aa, 1), CAD_Store.Read(CAD_Topo_FCove.ok, 2))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.aa, 2), CAD_Store.Read(CAD_Topo_FCove.ok, 3))
        CAD_Store.Write(CAD_Topo_State.vmap_old, 4, CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(CAD_Topo_FCove.ok, 7)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(CAD_Topo_FCove.ok, 8))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(CAD_Topo_FCove.ok, 9))), Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(CAD_Topo_FCove.ok, 4)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(CAD_Topo_FCove.ok, 5))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(CAD_Topo_FCove.ok, 6)))))
        CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_State.vmap_old, 0)
        CAD_Topo_FCove.bb = CAD_Store.Read(CAD_Topo_State.vmap_old, 2)
        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.bb, 0), CAD_Store.Read(CAD_Topo_FCove.ok, 1))
        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.bb, 1), CAD_Store.Read(CAD_Topo_FCove.ok, 2))
        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.bb, 2), CAD_Store.Read(CAD_Topo_FCove.ok, 3))
        CAD_Store.Write(CAD_Topo_State.vmap_old, 5, CAD_Geom.Atan2(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(CAD_Topo_FCove.ok, 7)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(CAD_Topo_FCove.ok, 8))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(CAD_Topo_FCove.ok, 9))), Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Store.Read(CAD_Topo_FCove.ok, 4)), Float_Mul(CAD_Topo_FCove.edy, CAD_Store.Read(CAD_Topo_FCove.ok, 5))), Float_Mul(CAD_Topo_FCove.edz, CAD_Store.Read(CAD_Topo_FCove.ok, 6)))))
        CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_State.vmap_old, 0)
        CAD_Topo_FCove.d12 = CAD_Store.Read(CAD_Topo_State.vmap_old, 3)
        CAD_Topo_FCove.g = Float_Sub(CAD_Store.Read(CAD_Topo_State.vmap_old, 5), CAD_Store.Read(CAD_Topo_State.vmap_old, 4))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.d12), 1) ThenBlock: {
            CAD_Topo_FCove.g = Float_Sub(0, CAD_Num.PosMod2Pi(Float_Sub(0, CAD_Topo_FCove.g)))
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.d12), 0) ThenBlock: {
            CAD_Topo_FCove.g = CAD_Num.PosMod2Pi(CAD_Topo_FCove.g)
        }
        CAD_Store.Write(CAD_Topo_State.vmap_old, 6, CAD_Topo_FCove.g)
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Store.Read(CAD_Topo_State.vmap_old, 6), 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Store.Read(CAD_Topo_State.vmap_old, 3), 0), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
                CAD_Topo.FilletDumpI("span0 va=", 9, CAD_Store.Read(CAD_Topo_State.vmap_old, 1))
                CAD_Topo.FilletDumpI(" vb=", 4, CAD_Store.Read(CAD_Topo_State.vmap_old, 2))
                CAD_Topo.FilletDumpU(" A=", 3, CAD_Store.Read(CAD_Topo_State.vmap_old, 4))
                CAD_Topo.FilletDumpU(" B=", 3, CAD_Store.Read(CAD_Topo_State.vmap_old, 5))
                CAD_Topo.FilletDumpU(" g=", 3, CAD_Store.Read(CAD_Topo_State.vmap_old, 6))
                CAD_Topo.FilletDumpU(" src=", 5, CAD_Store.Read(CAD_Topo_State.vmap_old, 3))
                CAD_Topo.FilletDumpS("\n", 1)
                ReturnValue(0)
            }
        }
        CAD_Store.Write(CAD_Store.Read(CAD_Topo_State.vmap_old, 0), 12, CAD_Store.Read(CAD_Topo_State.vmap_old, 6))
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpU(" remspan=", 9, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.vmap_old, 0), 12))
        CAD_Topo.FilletDumpI(" ck=", 4, CAD_Store.Read(CAD_Store.Read(CAD_Topo_State.vmap_old, 0), 0))
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(CAD_Topo.MakeEdge(CAD_Store.Read(CAD_Topo_State.vmap_old, 1), CAD_Store.Read(CAD_Topo_State.vmap_old, 2), CAD_Store.Read(CAD_Topo_State.vmap_old, 0)))
    }
}

