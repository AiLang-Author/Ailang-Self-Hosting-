LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Sys

// Move Th onto the side plane along the lid circle and return a meridian
// that lies in that plane. 0 leaves Th where it was (ball quarter stays).
Function.CAD_Topo.FilletEmitCapEnd {
    Input: vh: Integer
    Input: th: Integer
    Input: tw: Integer
    Input: tor_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.wa, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletEmitSidePlane(vh), 0) ThenBlock: { ReturnValue(0) }
        nx = ArrayGet(CAD_Topo_FCove.pl, 10)
        ny = ArrayGet(CAD_Topo_FCove.pl, 11)
        nz = ArrayGet(CAD_Topo_FCove.pl, 12)
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(nx), CAD_Num.Sq(ny)), CAD_Num.Sq(nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 1) ThenBlock: { ReturnValue(0) }
        nx = Float_Div(nx, nl)
        ny = Float_Div(ny, nl)
        nz = Float_Div(nz, nl)
        ArraySet(CAD_Topo_FCove.pl, 10, nx)
        ArraySet(CAD_Topo_FCove.pl, 11, ny)
        ArraySet(CAD_Topo_FCove.pl, 12, nz)
        tx = CAD_Store.Read(th, 0)
        ty = CAD_Store.Read(th, 1)
        tz = CAD_Store.Read(th, 2)
        vx = CAD_Store.Read(vh, 0)
        vy = CAD_Store.Read(vh, 1)
        vz = CAD_Store.Read(vh, 2)
        dist = Float_Add(Float_Add(Float_Mul(nx, Float_Sub(tx, vx)), Float_Mul(ny, Float_Sub(ty, vy))), Float_Mul(nz, Float_Sub(tz, vz)))
        IfCondition EqualTo(CAD_Num.Le(CAD_Num.Abs(dist), 0x3FC999999999999A), 1) ThenBlock: { ReturnValue(0) }
        circ = CAD_Topo_FCove.wa
        cx = CAD_Store.Read(circ, 1)
        cy = CAD_Store.Read(circ, 2)
        cz = CAD_Store.Read(circ, 3)
        xx = CAD_Store.Read(circ, 4)
        xy = CAD_Store.Read(circ, 5)
        xz = CAD_Store.Read(circ, 6)
        yx = CAD_Store.Read(circ, 7)
        yy = CAD_Store.Read(circ, 8)
        yz = CAD_Store.Read(circ, 9)
        rr = CAD_Store.Read(circ, 10)
        aa = Float_Mul(rr, Float_Add(Float_Add(Float_Mul(nx, xx), Float_Mul(ny, xy)), Float_Mul(nz, xz)))
        bb = Float_Mul(rr, Float_Add(Float_Add(Float_Mul(nx, yx), Float_Mul(ny, yy)), Float_Mul(nz, yz)))
        dd = Float_Add(Float_Add(Float_Mul(nx, Float_Sub(cx, vx)), Float_Mul(ny, Float_Sub(cy, vy))), Float_Mul(nz, Float_Sub(cz, vz)))
        dd = Float_Sub(0, dd)
        IfCondition NotEqual(CAD_Topo.FilletSolveAng(aa, bb, dd, CAD_Topo_FCove.p1b), 2) ThenBlock: { ReturnValue(0) }
        t0 = ArrayGet(CAD_Topo_FCove.p1b, 0)
        t1 = ArrayGet(CAD_Topo_FCove.p1b, 1)
        cu = CAD_Geom.Cos(t0)
        su = CAD_Geom.Sin(t0)
        p0x = Float_Add(cx, Float_Add(Float_Mul(Float_Mul(rr, cu), xx), Float_Mul(Float_Mul(rr, su), yx)))
        p0y = Float_Add(cy, Float_Add(Float_Mul(Float_Mul(rr, cu), xy), Float_Mul(Float_Mul(rr, su), yy)))
        p0z = Float_Add(cz, Float_Add(Float_Mul(Float_Mul(rr, cu), xz), Float_Mul(Float_Mul(rr, su), yz)))
        cu = CAD_Geom.Cos(t1)
        su = CAD_Geom.Sin(t1)
        p1x = Float_Add(cx, Float_Add(Float_Mul(Float_Mul(rr, cu), xx), Float_Mul(Float_Mul(rr, su), yx)))
        p1y = Float_Add(cy, Float_Add(Float_Mul(Float_Mul(rr, cu), xy), Float_Mul(Float_Mul(rr, su), yy)))
        p1z = Float_Add(cz, Float_Add(Float_Mul(Float_Mul(rr, cu), xz), Float_Mul(Float_Mul(rr, su), yz)))
        d0 = Float_Add(Float_Add(CAD_Num.Sq(Float_Sub(p0x, tx)), CAD_Num.Sq(Float_Sub(p0y, ty))), CAD_Num.Sq(Float_Sub(p0z, tz)))
        d1 = Float_Add(Float_Add(CAD_Num.Sq(Float_Sub(p1x, tx)), CAD_Num.Sq(Float_Sub(p1y, ty))), CAD_Num.Sq(Float_Sub(p1z, tz)))
        IfCondition EqualTo(CAD_Num.Le(d1, d0), 1) ThenBlock: {
            p0x = p1x
            p0y = p1y
            p0z = p1z
        }
        CAD_Store.Write(th, 0, p0x)
        CAD_Store.Write(th, 1, p0y)
        CAD_Store.Write(th, 2, p0z)
        ed = CAD_Topo.FilletEmitPlaneMer(th, tw, tor_h)
        IfCondition EqualTo(ed, 0) ThenBlock: {
            CAD_Store.Write(th, 0, tx)
            CAD_Store.Write(th, 1, ty)
            CAD_Store.Write(th, 2, tz)
            ReturnValue(0)
        }
        PrintMessage("fillet cap ")
        PrintNumber(Float_ToInt(Float_Mul(p0x, 0x408F400000000000)))
        PrintMessage(" ")
        PrintNumber(Float_ToInt(Float_Mul(p0y, 0x408F400000000000)))
        PrintMessage(" ")
        PrintNumber(Float_ToInt(Float_Mul(p0z, 0x408F400000000000)))
        PrintMessage("\n")
        ReturnValue(ed)
    }
}

Function.CAD_Topo.FilletEmitOpenPatch {
    Output: Integer
    Body: {
        ov0 = CAD_Topo_FCove.v0
        ov1 = CAD_Topo_FCove.v1
        af = CAD_Topo_FPlex.arc4
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(af, 1) ThenBlock: {
            IfCondition NotEqual(bp, 0) ThenBlock: {
                tv = ArrayGet(bp, 19)
                IfCondition NotEqual(tv, 0) ThenBlock: { CAD_Topo_FCove.v0 = tv }
                tv = ArrayGet(bp, 20)
                IfCondition NotEqual(tv, 0) ThenBlock: { CAD_Topo_FCove.v1 = tv }
            }
        }
        IfCondition EqualTo(CAD_Topo.FilletEmitVertContact(CAD_Topo_FCove.v0), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok = CAD_Topo_FCove.aa
        CAD_Topo_FCove.hit = CAD_Topo_FCove.g
        r0x = CAD_Topo_FCove.n2x
        r0y = CAD_Topo_FCove.n2y
        r0z = CAD_Topo_FCove.n2z
        p0h = CAD_Topo_FCove.padh
        a0s = CAD_Topo_FCove.ab
        IfCondition EqualTo(CAD_Topo.FilletEmitVertContact(CAD_Topo_FCove.v1), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ok1 = CAD_Topo_FCove.aa
        CAD_Topo_FCove.hit1 = CAD_Topo_FCove.g
        // Lone open arc: the normal-plane quarter sticks past the side
        // face, and the cap fills the chord. Seat Th on the side plane
        // and use a circle in that plane. arc4 keeps its own seams.
        CAD_Topo_FCove.lp = 0
        CAD_Topo_FCove.lp1 = 0
        IfCondition EqualTo(af, 0) ThenBlock: {
            tor = CAD_Topo_FCove.kind
            CAD_Topo_FCove.lp = CAD_Topo.FilletEmitCapEnd(CAD_Topo_FCove.v0, CAD_Topo_FCove.ok, CAD_Topo_FCove.hit, tor)
            CAD_Topo_FCove.lp1 = CAD_Topo.FilletEmitCapEnd(CAD_Topo_FCove.v1, CAD_Topo_FCove.ok1, CAD_Topo_FCove.hit1, tor)
        }
        CAD_Topo_FCove.bb = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.ok1, CAD_Topo_FCove.wa)
        CAD_Topo_FCove.sn = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.hit, CAD_Topo_FCove.hit1, CAD_Topo_FCove.wb)
        // Both open ends need a circle at that end's ball. The MakeGeom
        // circle is one frame (the solve point). On a curved edge the other
        // end is not on it, and the minor arc then crosses the rear wall.
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: {
            vh = CAD_Topo_FCove.v0
            rd = CAD_Topo_FCove.r
            vx = CAD_Store.Read(vh, 0)
            vy = CAD_Store.Read(vh, 1)
            vz = CAD_Store.Read(vh, 2)
            n1x = CAD_Topo_FComp.n1x
            n1y = CAD_Topo_FComp.n1y
            n1z = CAD_Topo_FComp.n1z
            ArraySet(CAD_Topo_FCove.frame, 0, Float_Add(Float_Add(vx, CAD_Num.Mul(p0h, n1x)), CAD_Num.Mul(a0s, r0x)))
            ArraySet(CAD_Topo_FCove.frame, 1, Float_Add(Float_Add(vy, CAD_Num.Mul(p0h, n1y)), CAD_Num.Mul(a0s, r0y)))
            ArraySet(CAD_Topo_FCove.frame, 2, Float_Add(Float_Add(vz, CAD_Num.Mul(p0h, n1z)), CAD_Num.Mul(a0s, r0z)))
            ArraySet(CAD_Topo_FCove.frame, 3, Float_Sub(0, r0x))
            ArraySet(CAD_Topo_FCove.frame, 4, Float_Sub(0, r0y))
            ArraySet(CAD_Topo_FCove.frame, 5, Float_Sub(0, r0z))
            ArraySet(CAD_Topo_FCove.frame, 6, Float_Sub(0, n1x))
            ArraySet(CAD_Topo_FCove.frame, 7, Float_Sub(0, n1y))
            ArraySet(CAD_Topo_FCove.frame, 8, Float_Sub(0, n1z))
            CAD_Topo_FCove.minlen = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, rd)
            CAD_Topo_FCove.lp = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok, CAD_Topo_FCove.hit, CAD_Topo_FCove.minlen)
        }
        IfCondition EqualTo(CAD_Topo_FCove.lp1, 0) ThenBlock: {
            ArraySet(CAD_Topo_FCove.frame, 0, Float_Add(Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 0), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1x)), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2x)))
            ArraySet(CAD_Topo_FCove.frame, 1, Float_Add(Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 1), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1y)), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2y)))
            ArraySet(CAD_Topo_FCove.frame, 2, Float_Add(Float_Add(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Num.Mul(CAD_Topo_FCove.padh, CAD_Topo_FComp.n1z)), CAD_Num.Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2z)))
            ArraySet(CAD_Topo_FCove.frame, 3, Float_Sub(0, CAD_Topo_FCove.n2x))
            ArraySet(CAD_Topo_FCove.frame, 4, Float_Sub(0, CAD_Topo_FCove.n2y))
            ArraySet(CAD_Topo_FCove.frame, 5, Float_Sub(0, CAD_Topo_FCove.n2z))
            ArraySet(CAD_Topo_FCove.frame, 6, Float_Sub(0, CAD_Topo_FComp.n1x))
            ArraySet(CAD_Topo_FCove.frame, 7, Float_Sub(0, CAD_Topo_FComp.n1y))
            ArraySet(CAD_Topo_FCove.frame, 8, Float_Sub(0, CAD_Topo_FComp.n1z))
            CAD_Topo_FCove.minlen = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
            CAD_Topo_FCove.lp1 = CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.ok1, CAD_Topo_FCove.hit1, CAD_Topo_FCove.minlen)
        }
        IfCondition EqualTo(CAD_Topo_FCove.bb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.sn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.lp1, 0) ThenBlock: { ReturnValue(0) }
        m0 = CAD_Topo_FCove.lp
        m1 = CAD_Topo_FCove.lp1
        sv0 = CAD_Topo_FCove.v0
        sv1 = CAD_Topo_FCove.v1
        c0 = CAD_Topo_FCove.ok
        h0 = CAD_Topo_FCove.hit
        c1 = CAD_Topo_FCove.ok1
        h1 = CAD_Topo_FCove.hit1
        wf = CAD_Topo_FCove.f2
        af = CAD_Topo_FPlex.arc4
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(af, 1) ThenBlock: {
            IfCondition NotEqual(bp, 0) ThenBlock: {
                ArraySet(bp, 21, m0)
                ArraySet(bp, 22, m1)
            }
            CAD_Topo_FCove.v0 = ov0
            CAD_Topo_FCove.v1 = ov1
        }
        IfCondition EqualTo(CAD_Topo.FilletOpenSwap(), 0) ThenBlock: { ReturnValue(0) }
        // OpenSwap moves only the wall generators. The lid lines still
        // end at the old corners, so the lid loop fans. Sew each end
        // into the side face. arc4 already seamed those ends.
        af = CAD_Topo_FPlex.arc4
        IfCondition EqualTo(af, 0) ThenBlock: {
            CAD_Topo.FilletSewOpenEnd(sv0, c0, h0, m0, wf)
            CAD_Topo.FilletSewOpenEnd(sv1, c1, h1, m1, wf)
        }
        PrintMessage("fillet emit OPEN arc\n")
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletOpenSwap {
    Output: Integer
    Body: {
        CAD_Topo_FCove.nxt1 = 0
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f2, CAD_Topo_FCove.e)
        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
            CAD_Topo_FCove.nxt1 = CAD_Topo.FilletIRFindGen(CAD_Topo_FCove.ce, CAD_Topo_FCove.v1)
        }
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.host_f, CAD_Topo_FCove.e)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        oo = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
        no = CAD_Topo_FCove.ok
        IfCondition EqualTo(oo, CAD_Topo_FCove.v1) ThenBlock: { no = CAD_Topo_FCove.ok1 }
        CAD_Topo_FCove.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo_FCove.bb, no)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f2, CAD_Topo_FCove.e)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        oo = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
        no = CAD_Topo_FCove.hit
        IfCondition EqualTo(oo, CAD_Topo_FCove.v1) ThenBlock: { no = CAD_Topo_FCove.hit1 }
        CAD_Topo_FCove.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo_FCove.sn, no)
        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.prv = CAD_Topo_FCove.ce
        IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: {
            CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.nxt, CAD_Topo_FCove.v0, CAD_Topo_FCove.hit)
        }
        IfCondition NotEqual(CAD_Topo_FCove.nxt1, 0) ThenBlock: {
            CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.nxt1, CAD_Topo_FCove.v1, CAD_Topo_FCove.hit1)
        }
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.bb, 0), CAD_Topo_FCove.ok) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 0, CAD_Topo.MakeCoedge(CAD_Topo_FCove.bb, CAD_Topo_FCove.ok, CAD_Topo_FCove.which))
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.lp1, 0), CAD_Topo_FCove.ok1) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 1, CAD_Topo.MakeCoedge(CAD_Topo_FCove.lp1, CAD_Topo_FCove.ok1, CAD_Topo_FCove.which))
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.sn, 0), CAD_Topo_FCove.hit1) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 2, CAD_Topo.MakeCoedge(CAD_Topo_FCove.sn, CAD_Topo_FCove.hit1, CAD_Topo_FCove.which))
        CAD_Topo_FCove.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.lp, 0), CAD_Topo_FCove.hit) ThenBlock: { CAD_Topo_FCove.which = 0 }
        ArraySet(CAD_Topo_FCove.ring, 3, CAD_Topo.MakeCoedge(CAD_Topo_FCove.lp, CAD_Topo_FCove.hit, CAD_Topo_FCove.which))
        CAD_Topo_FCove.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FCove.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FCove.ring, 4, CAD_Topo_FCove.lp)
        CAD_Topo_FCove.which = CAD_Topo.MakeFace(CAD_Topo_FCove.kind, CAD_Topo_FCove.lp)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        tf = CAD_Topo_FCove.which
        sh = CAD_Topo_FCove.shell
        af = CAD_Topo_FPlex.arc4
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(af, 1) ThenBlock: {
            IfCondition NotEqual(bp, 0) ThenBlock: { ArraySet(bp, 26, tf) }
        }
        IfCondition NotEqual(CAD_Topo.ShellAppendFace(sh, tf), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Open canal end: meridian joins every incident plane face that is
// not host and not this wall. Find by edge endpoints (origin is the
// start of a coedge, not the mouth). The two LINEs that met at the
// mouth become Th (host-incident) and Tw (the other); mer goes
// between those coedges.
Function.CAD_Topo.FilletSewOpenEnd {
    Input: v_orig: Integer
    Input: th: Integer
    Input: tw: Integer
    Input: mer: Integer
    Input: wall_f: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(v_orig, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.f1 = 0
        CAD_Topo_FCove.which = 0
        IfCondition NotEqual(CAD_Topo_FCove.solid, 0) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.solid, 0)
        }
        IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.which, 0)
        }
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 64) {
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.g = 64 }
            IfCondition NotEqual(CAD_Topo_FCove.f1, 0) ThenBlock: { CAD_Topo_FCove.g = 64 }
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: {
                    CAD_Topo_FCove.ok = 1
                    IfCondition EqualTo(CAD_Topo_FCove.which, CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FCove.which, wall_f) ThenBlock: { CAD_Topo_FCove.ok = 0 }
                    IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.which, 0)
                        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { CAD_Topo_FCove.ok = 0 }
                    }
                    IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.which, 1)
                        IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
                            CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
                            CAD_Topo_FCove.j = 0
                            WhileLoop LessThan(CAD_Topo_FCove.j, 64) {
                                IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.j = 64 }
                                IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                                    CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                                        CAD_Topo_FCove.hit = 0
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), v_orig) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), v_orig) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), th) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), th) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                        IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                                            CAD_Topo_FCove.f1 = CAD_Topo_FCove.which
                                            CAD_Topo_FCove.j = 64
                                        }
                                    }
                                    CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                                    IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.j = 64 }
                                }
                                CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
                            }
                        }
                    }
                    CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.which, 3)
                }
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: {
            CAD_Topo.FilletDumpI("fillet sew no side v=", 20, v_orig)
            CAD_Topo.FilletDumpS("\n", 1)
            ReturnValue(1)
        }
        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.f1, 1)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 64) {
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.g = 64 }
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    CAD_Topo_FCove.ok = 0
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), v_orig) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), v_orig) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                    IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                        CAD_Topo_FCove.kind = 1
                        CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                        IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: { CAD_Topo_FCove.kind = CAD_Store.Read(CAD_Topo_FCove.nxt, 0) }
                        IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.ChamferRingSkipEdge(CAD_Topo_FCove.e), 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: {
                                    CAD_Topo_FCove.hit = 0
                                    IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.faces, 0), CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                    IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.faces, 1), CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                                    IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: { CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.e, v_orig, th) }
                                    IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.e, v_orig, tw) }
                                }
                            }
                        }
                    }
                }
                CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 64 }
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.orig = 0
        CAD_Topo_FCove.v1 = 0
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 64) {
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.g = 64 }
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), th) ThenBlock: { CAD_Topo_FCove.orig = CAD_Topo_FCove.ce }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), th) ThenBlock: { CAD_Topo_FCove.orig = CAD_Topo_FCove.ce }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), tw) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Topo_FCove.ce }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), tw) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Topo_FCove.ce }
                }
                CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 64 }
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        CAD_Topo_FCove.prv = 0
        CAD_Topo_FCove.ok = 0
        IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_FCove.v1, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.orig, CAD_Topo_FCove.v1) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.orig, 2), CAD_Topo_FCove.v1) ThenBlock: {
                        CAD_Topo_FCove.prv = CAD_Topo_FCove.orig
                        CAD_Topo_FCove.ok = th
                    }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.v1, 2), CAD_Topo_FCove.orig) ThenBlock: {
                        CAD_Topo_FCove.prv = CAD_Topo_FCove.v1
                        CAD_Topo_FCove.ok = tw
                    }
                }
            }
        }
        IfCondition NotEqual(CAD_Topo_FCove.prv, 0) ThenBlock: {
            CAD_Topo_FCove.sn = 1
            IfCondition NotEqual(CAD_Store.Read(mer, 0), CAD_Topo_FCove.ok) ThenBlock: { CAD_Topo_FCove.sn = 0 }
            CAD_Topo_FCove.ce = CAD_Topo.MakeCoedge(mer, CAD_Topo_FCove.ok, CAD_Topo_FCove.sn)
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo.CoedgeInsertAfter(CAD_Topo_FCove.prv, CAD_Topo_FCove.ce)
                IfCondition EqualTo(CAD_Store.Read(mer, 3), 0) ThenBlock: { CAD_Store.Write(mer, 3, CAD_Topo_FCove.ce) }
                IfCondition NotEqual(CAD_Store.Read(mer, 3), CAD_Topo_FCove.ce) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(mer, 4), 0) ThenBlock: {
                        CAD_Store.Write(mer, 4, CAD_Topo_FCove.ce)
                        CAD_Topo.LinkTwins(CAD_Store.Read(mer, 3), CAD_Topo_FCove.ce)
                    }
                }
            }
        }
        CAD_Topo.FilletDumpI("fillet sew side=", 16, CAD_Topo_FCove.f1)
        CAD_Topo.FilletDumpI("ins=", 4, CAD_Topo_FCove.prv)
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(1)
    }
}

// Open (v0≠v1) circle edge, same R and cz as src, owns vert, not skip.
// Closed extrusion circles (span=0, v0=v1) must not be CircleEnd'd —
// that leftover is the hanging ear.
Function.CAD_Topo.FilletEmitOpenRimEdge {
    Input: src_crv: Integer
    Input: vert_h: Integer
    Input: skip_edge: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src_crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.solid, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.shell = CAD_Store.Read(CAD_Topo_FLoc.solid, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.shell, 0)
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 16) {
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.g = 16 }
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.which, 1)
                IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                    CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
                    CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
                    CAD_Topo_FCove.j = 0
                    WhileLoop LessThan(CAD_Topo_FCove.j, 16) {
                        IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.j = 16 }
                        IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                            CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                                IfCondition NotEqual(CAD_Topo_FCove.e, skip_edge) ThenBlock: {
                                    IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Store.Read(CAD_Topo_FCove.e, 1)) ThenBlock: {
                                        CAD_Topo_FCove.ok = 0
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), vert_h) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), vert_h) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                                        IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                                            CAD_Topo_FCove.nxt = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                                            IfCondition NotEqual(CAD_Topo_FCove.nxt, 0) ThenBlock: {
                                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.nxt, 0), 2) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Num.IsZero(Float_Sub(CAD_Store.Read(CAD_Topo_FCove.nxt, 10), CAD_Store.Read(src_crv, 10)), 0), 1) ThenBlock: {
                                                        IfCondition EqualTo(CAD_Num.IsZero(Float_Sub(CAD_Store.Read(CAD_Topo_FCove.nxt, 3), CAD_Store.Read(src_crv, 3)), 0), 1) ThenBlock: {
                                                            ReturnValue(CAD_Topo_FCove.e)
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                            IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.j = 16 }
                        }
                        CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
                    }
                }
                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.which, 3)
            }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ReturnValue(0)
    }
}

