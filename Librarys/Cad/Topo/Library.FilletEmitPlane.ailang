LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Sys

// Rolling-ball 2-face SOLVE: plane ∩ cylinder generatrix.
// Void>180 (convex, same as 2-plane C=P−ab(N1+N2)): offset both −N
// into the solid. Void≤180 (cove): offset both +N into the void.
// Offset plane ∩ offset cylinder is two generatrices; keep the one
// in this edge's dihedral. Writes FLoc.c0/c1 and replaces n1/n2 so
// Local contacts C+R N lie on the plane and on the cylinder.
// FLoc.sn=1 if f1 is the plane, 2 if f1 is the cylinder. 1 ok.
Function.CAD_Topo.FilletSolvePlaneCyl {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpS("PCYL enter\n", 11)
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail pt\n", 13)
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo_FLoc.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.v1, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.aa = CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f1)
        CAD_Topo_FLoc.bb = CAD_Topo.FilletIRFaceKind(CAD_Topo_FLoc.f2)
        CAD_Topo_FLoc.cyl = 0
        CAD_Topo_FLoc.sn = 0
        IfCondition EqualTo(CAD_Topo_FLoc.aa, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FLoc.bb, 2) ThenBlock: {
                CAD_Topo_FLoc.cyl = CAD_Store.Read(CAD_Topo_FLoc.f2, 0)
                CAD_Topo_FLoc.sn = 1
            }
        }
        IfCondition EqualTo(CAD_Topo_FLoc.aa, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FLoc.bb, 1) ThenBlock: {
                CAD_Topo_FLoc.cyl = CAD_Store.Read(CAD_Topo_FLoc.f1, 0)
                CAD_Topo_FLoc.sn = 2
            }
        }
        IfCondition EqualTo(CAD_Topo_FLoc.cyl, 0) ThenBlock: {
            CAD_Topo.FilletDumpOpen()
            CAD_Topo.FilletDumpI("PCYL fail kind f1=", 18, CAD_Topo_FLoc.aa)
            CAD_Topo.FilletDumpI(" f2=", 4, CAD_Topo_FLoc.bb)
            CAD_Topo.FilletDumpS("\n", 1)
            ReturnValue(0)
        }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FLoc.cyl, 0), 2) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail cylk\n", 15)
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo_FLoc.sn, 1) ThenBlock: {
            CAD_Topo_FComp.n1x = CAD_Topo_FLoc.n1x
            CAD_Topo_FComp.n1y = CAD_Topo_FLoc.n1y
            CAD_Topo_FComp.n1z = CAD_Topo_FLoc.n1z
            CAD_Topo_FLoc.endf = CAD_Topo_FLoc.f2
        }
        IfCondition EqualTo(CAD_Topo_FLoc.sn, 2) ThenBlock: {
            CAD_Topo_FComp.n1x = CAD_Topo_FLoc.n2x
            CAD_Topo_FComp.n1y = CAD_Topo_FLoc.n2y
            CAD_Topo_FComp.n1z = CAD_Topo_FLoc.n2z
            CAD_Topo_FLoc.endf = CAD_Topo_FLoc.f1
        }
        CAD_Topo_FComp.px = CAD_Store.Read(CAD_Topo_FLoc.cyl, 1)
        CAD_Topo_FComp.py = CAD_Store.Read(CAD_Topo_FLoc.cyl, 2)
        CAD_Topo_FComp.pz = CAD_Store.Read(CAD_Topo_FLoc.cyl, 3)
        CAD_Topo_FLoc.lp = 0
        IfCondition NotEqual(CAD_Topo_FLoc.endf, 0) ThenBlock: {
            CAD_Topo_FLoc.lp = CAD_Store.Read(CAD_Topo_FLoc.endf, 1)
        }
        IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: {
            CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.lp, 0)
            CAD_Topo_FLoc.hd = CAD_Topo_FLoc.ce
            CAD_Topo_FLoc.aa = 0
            WhileLoop LessThan(CAD_Topo_FLoc.aa, 8) {
                IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: { CAD_Topo_FLoc.aa = 8 }
                IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                    CAD_Topo_FComp.e = CAD_Store.Read(CAD_Topo_FLoc.ce, 0)
                    IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                        CAD_Topo_FComp.e = CAD_Store.Read(CAD_Topo_FComp.e, 2)
                        IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.e, 0), 2) ThenBlock: {
                                CAD_Topo_FComp.px = CAD_Store.Read(CAD_Topo_FComp.e, 1)
                                CAD_Topo_FComp.py = CAD_Store.Read(CAD_Topo_FComp.e, 2)
                                CAD_Topo_FComp.pz = CAD_Store.Read(CAD_Topo_FComp.e, 3)
                                CAD_Topo_FLoc.aa = 8
                            }
                        }
                    }
                    IfCondition LessThan(CAD_Topo_FLoc.aa, 8) ThenBlock: {
                        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.ce, 2)
                        IfCondition EqualTo(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.hd) ThenBlock: { CAD_Topo_FLoc.aa = 8 }
                    }
                }
                CAD_Topo_FLoc.aa = Add(CAD_Topo_FLoc.aa, 1)
            }
        }
        CAD_Topo_FLoc.ab = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v0, 0), CAD_Topo_FComp.px)
        CAD_Topo_FLoc.ln = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v0, 1), CAD_Topo_FComp.py)
        CAD_Topo_FLoc.hd = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v0, 2), CAD_Topo_FComp.pz)
        CAD_Topo_FComp.shost = Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.hd, CAD_Topo_FLoc.edz))
        CAD_Topo_FComp.xx = Float_Sub(CAD_Topo_FLoc.ab, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edx))
        CAD_Topo_FComp.xy = Float_Sub(CAD_Topo_FLoc.ln, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edy))
        CAD_Topo_FComp.xz = Float_Sub(CAD_Topo_FLoc.hd, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edz))
        CAD_Topo_FLoc.ab = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Topo_FComp.px)
        CAD_Topo_FLoc.ln = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Topo_FComp.py)
        CAD_Topo_FLoc.hd = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Topo_FComp.pz)
        CAD_Topo_FComp.srad = Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.hd, CAD_Topo_FLoc.edz))
        CAD_Topo_FComp.padh = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.xx, CAD_Topo_FComp.xx), Float_Mul(CAD_Topo_FComp.xy, CAD_Topo_FComp.xy)), Float_Mul(CAD_Topo_FComp.xz, CAD_Topo_FComp.xz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.padh, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail padh\n", 15)
            ReturnValue(0)
        }
        CAD_Topo_FComp.rr = CAD_Topo_FComp.padh
        // Sqrt/IsZero smash FLoc.edx. Reload the generatrix from verts.
        CAD_Topo_FLoc.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        CAD_Topo_FLoc.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        CAD_Topo_FLoc.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail ed0\n", 14)
            ReturnValue(0)
        }
        CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.ln = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FLoc.edz))
        CAD_Topo_FComp.n1x = Float_Sub(CAD_Topo_FComp.n1x, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.edx))
        CAD_Topo_FComp.n1y = Float_Sub(CAD_Topo_FComp.n1y, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.edy))
        CAD_Topo_FComp.n1z = Float_Sub(CAD_Topo_FComp.n1z, Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.edz))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n1x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n1y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail n1\n", 13)
            ReturnValue(0)
        }
        CAD_Topo_FComp.n1x = Float_Div(CAD_Topo_FComp.n1x, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n1y = Float_Div(CAD_Topo_FComp.n1y, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n1z = Float_Div(CAD_Topo_FComp.n1z, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2x = Float_Sub(Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FComp.n1z), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FComp.n1y))
        CAD_Topo_FComp.n2y = Float_Sub(Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FComp.n1x), Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FComp.n1z))
        CAD_Topo_FComp.n2z = Float_Sub(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FComp.n1y), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FComp.n1x))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail n2\n", 13)
            ReturnValue(0)
        }
        CAD_Topo_FComp.n2x = Float_Div(CAD_Topo_FComp.n2x, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2y = Float_Div(CAD_Topo_FComp.n2y, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2z = Float_Div(CAD_Topo_FComp.n2z, CAD_Topo_FLoc.ln)
        // FaceGetPlane N follows sketch-line ax×Z. That is not outward
        // when the LINE was drawn the other way. Same rule as 2-plane:
        // +N is void. Wall is planar — PointInSolid sees it.
        // PointInFaceUV Integer locals smash FComp/FLoc. Park in Store.
        CAD_Topo_State.vmap_new = CAD_Store.Alloc(8, 16)
        IfCondition EqualTo(CAD_Topo_State.vmap_new, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(CAD_Topo_State.vmap_new, 0, CAD_Topo_FComp.edx)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 1, CAD_Topo_FComp.edy)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 2, CAD_Topo_FComp.edz)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 3, CAD_Topo_FComp.n1x)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 4, CAD_Topo_FComp.n1y)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 5, CAD_Topo_FComp.n1z)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 6, CAD_Topo_FComp.xx)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 7, CAD_Topo_FComp.xy)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 8, CAD_Topo_FComp.xz)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 9, CAD_Topo_FComp.rr)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 10, CAD_Topo_FComp.padh)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 11, CAD_Topo_FComp.shost)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 12, CAD_Topo_FComp.srad)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 13, CAD_Topo_FComp.px)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 14, CAD_Topo_FComp.py)
        CAD_Store.Write(CAD_Topo_State.vmap_new, 15, CAD_Topo_FComp.pz)
        CAD_Topo_FLoc.c0x = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 0), CAD_Store.Read(CAD_Topo_FLoc.v1, 0)), 0x3FE0000000000000)
        CAD_Topo_FLoc.c0y = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 1), CAD_Store.Read(CAD_Topo_FLoc.v1, 1)), 0x3FE0000000000000)
        CAD_Topo_FLoc.c0z = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v0, 2), CAD_Store.Read(CAD_Topo_FLoc.v1, 2)), 0x3FE0000000000000)
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(CAD_Topo_FLoc.c0x, Float_Mul(0x3FE0000000000000, CAD_Store.Read(CAD_Topo_State.vmap_new, 3))))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(CAD_Topo_FLoc.c0y, Float_Mul(0x3FE0000000000000, CAD_Store.Read(CAD_Topo_State.vmap_new, 4))))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(CAD_Topo_FLoc.c0z, Float_Mul(0x3FE0000000000000, CAD_Store.Read(CAD_Topo_State.vmap_new, 5))))
        CAD_Topo_FLoc.hd = CAD_Topo.PointInSolid(CAD_Topo_FLoc.solid, CAD_Topo_FLoc.pt)
        CAD_Topo_FComp.edx = CAD_Store.Read(CAD_Topo_State.vmap_new, 0)
        CAD_Topo_FComp.edy = CAD_Store.Read(CAD_Topo_State.vmap_new, 1)
        CAD_Topo_FComp.edz = CAD_Store.Read(CAD_Topo_State.vmap_new, 2)
        CAD_Topo_FComp.n1x = CAD_Store.Read(CAD_Topo_State.vmap_new, 3)
        CAD_Topo_FComp.n1y = CAD_Store.Read(CAD_Topo_State.vmap_new, 4)
        CAD_Topo_FComp.n1z = CAD_Store.Read(CAD_Topo_State.vmap_new, 5)
        CAD_Topo_FComp.xx = CAD_Store.Read(CAD_Topo_State.vmap_new, 6)
        CAD_Topo_FComp.xy = CAD_Store.Read(CAD_Topo_State.vmap_new, 7)
        CAD_Topo_FComp.xz = CAD_Store.Read(CAD_Topo_State.vmap_new, 8)
        CAD_Topo_FComp.rr = CAD_Store.Read(CAD_Topo_State.vmap_new, 9)
        CAD_Topo_FComp.padh = CAD_Store.Read(CAD_Topo_State.vmap_new, 10)
        CAD_Topo_FComp.shost = CAD_Store.Read(CAD_Topo_State.vmap_new, 11)
        CAD_Topo_FComp.srad = CAD_Store.Read(CAD_Topo_State.vmap_new, 12)
        CAD_Topo_FComp.px = CAD_Store.Read(CAD_Topo_State.vmap_new, 13)
        CAD_Topo_FComp.py = CAD_Store.Read(CAD_Topo_State.vmap_new, 14)
        CAD_Topo_FComp.pz = CAD_Store.Read(CAD_Topo_State.vmap_new, 15)
        IfCondition EqualTo(CAD_Topo_FLoc.hd, 1) ThenBlock: {
            CAD_Topo_FComp.n1x = Float_Sub(0, CAD_Topo_FComp.n1x)
            CAD_Topo_FComp.n1y = Float_Sub(0, CAD_Topo_FComp.n1y)
            CAD_Topo_FComp.n1z = Float_Sub(0, CAD_Topo_FComp.n1z)
        }
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.edx, CAD_Topo_FComp.edx), Float_Mul(CAD_Topo_FComp.edy, CAD_Topo_FComp.edy)), Float_Mul(CAD_Topo_FComp.edz, CAD_Topo_FComp.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail edx\n", 14)
            ReturnValue(0)
        }
        CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FComp.edx, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FComp.edy, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FComp.edz, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2x = Float_Sub(Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FComp.n1z), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FComp.n1y))
        CAD_Topo_FComp.n2y = Float_Sub(Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FComp.n1x), Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FComp.n1z))
        CAD_Topo_FComp.n2z = Float_Sub(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FComp.n1y), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FComp.n1x))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail n2b\n", 14)
            ReturnValue(0)
        }
        CAD_Topo_FComp.n2x = Float_Div(CAD_Topo_FComp.n2x, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2y = Float_Div(CAD_Topo_FComp.n2y, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n2z = Float_Div(CAD_Topo_FComp.n2z, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.n3x = Float_Div(CAD_Topo_FComp.xx, CAD_Topo_FComp.rr)
        CAD_Topo_FComp.n3y = Float_Div(CAD_Topo_FComp.xy, CAD_Topo_FComp.rr)
        CAD_Topo_FComp.n3z = Float_Div(CAD_Topo_FComp.xz, CAD_Topo_FComp.rr)
        CAD_Topo_FComp.yx = CAD_Topo_FComp.n3x
        CAD_Topo_FComp.yy = CAD_Topo_FComp.n3y
        CAD_Topo_FComp.yz = CAD_Topo_FComp.n3z
        // Void>180 convex: offset −N (into solid). Void≤180 cove: +N.
        // Same convention as 2-plane C = P ∓ ab(N1+N2). Signs live on
        // FLoc.which — FComp.s/yx are IR scratch and get smashed.
        CAD_Topo_FLoc.which = 0
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FLoc.which = 1 }
        CAD_Topo_FComp.bb = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.xx), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.xy)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.xz))
        CAD_Topo_FLoc.ab = Float_Add(0x3FF0000000000000, Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n3z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ab, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpOpen()
            CAD_Topo.FilletDumpS("PCYL fail 1+n1n3\n", 17)
            ReturnValue(0)
        }
        CAD_Topo_FLoc.ab = Float_Div(CAD_Topo_FLoc.r, CAD_Topo_FLoc.ab)
        CAD_Topo_FComp.aa = Float_Sub(CAD_Topo_FComp.rr, CAD_Topo_FLoc.r)
        CAD_Topo_FLoc.ln = Float_Sub(CAD_Topo_FComp.bb, CAD_Topo_FLoc.r)
        CAD_Topo_FLoc.c1x = Float_Sub(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n3x)))
        CAD_Topo_FLoc.c1y = Float_Sub(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n3y)))
        CAD_Topo_FLoc.c1z = Float_Sub(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n3z)))
        IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
            CAD_Topo_FComp.aa = Float_Add(CAD_Topo_FComp.rr, CAD_Topo_FLoc.r)
            CAD_Topo_FLoc.ln = Float_Add(CAD_Topo_FComp.bb, CAD_Topo_FLoc.r)
            CAD_Topo_FLoc.c1x = Float_Add(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n3x)))
            CAD_Topo_FLoc.c1y = Float_Add(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n3y)))
            CAD_Topo_FLoc.c1z = Float_Add(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FLoc.ab, Float_Add(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n3z)))
        }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.aa), 1) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail Roff\n", 15)
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.aa, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.lp = Float_Sub(Float_Mul(CAD_Topo_FComp.aa, CAD_Topo_FComp.aa), Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.ln))
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FLoc.lp), 1) ThenBlock: {
            CAD_Topo.FilletDumpOpen()
            CAD_Topo.FilletDumpS("PCYL fail disc\n", 15)
            ReturnValue(0)
        }
        CAD_Topo_FLoc.lp = CAD_Num.Sqrt(CAD_Topo_FLoc.lp)
        CAD_Topo_FComp.ok = 0
        CAD_Topo_FLoc.ar = 0
        WhileLoop LessThan(CAD_Topo_FLoc.ar, 2) {
            CAD_Topo_FLoc.ce = CAD_Topo_FLoc.lp
            IfCondition EqualTo(CAD_Topo_FLoc.ar, 1) ThenBlock: {
                CAD_Topo_FLoc.ce = Float_Sub(0, CAD_Topo_FLoc.lp)
            }
            CAD_Topo_FComp.cx = Float_Add(Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FComp.n1x), Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n2x))
            CAD_Topo_FComp.cy = Float_Add(Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FComp.n1y), Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n2y))
            CAD_Topo_FComp.cz = Float_Add(Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FComp.n1z), Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n2z))
            CAD_Topo_FLoc.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Topo_FComp.cx, CAD_Topo_FLoc.c1x), Float_Sub(CAD_Topo_FComp.cx, CAD_Topo_FLoc.c1x)), Float_Mul(Float_Sub(CAD_Topo_FComp.cy, CAD_Topo_FLoc.c1y), Float_Sub(CAD_Topo_FComp.cy, CAD_Topo_FLoc.c1y))), Float_Mul(Float_Sub(CAD_Topo_FComp.cz, CAD_Topo_FLoc.c1z), Float_Sub(CAD_Topo_FComp.cz, CAD_Topo_FLoc.c1z))))
            CAD_Topo_FLoc.hd = 0
            IfCondition EqualTo(CAD_Topo_FComp.ok, 0) ThenBlock: { CAD_Topo_FLoc.hd = 1 }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FLoc.ab, CAD_Topo_FComp.padh)), 1) ThenBlock: { CAD_Topo_FLoc.hd = 1 }
            IfCondition EqualTo(CAD_Topo_FLoc.hd, 1) ThenBlock: {
                CAD_Topo_FComp.ok = 1
                CAD_Topo_FComp.padh = CAD_Topo_FLoc.ab
                CAD_Topo_FLoc.c0x = CAD_Topo_FComp.cx
                CAD_Topo_FLoc.c0y = CAD_Topo_FComp.cy
                CAD_Topo_FLoc.c0z = CAD_Topo_FComp.cz
            }
            CAD_Topo_FLoc.ar = Add(CAD_Topo_FLoc.ar, 1)
        }
        IfCondition EqualTo(CAD_Topo_FComp.ok, 0) ThenBlock: {
            CAD_Topo.FilletDumpS("PCYL fail noC\n", 14)
            ReturnValue(0)
        }
        CAD_Topo_FComp.n3x = CAD_Topo_FLoc.c0x
        CAD_Topo_FComp.n3y = CAD_Topo_FLoc.c0y
        CAD_Topo_FComp.n3z = CAD_Topo_FLoc.c0z
        CAD_Topo_FComp.padh = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Topo_FComp.n3x, CAD_Topo_FComp.xx), Float_Sub(CAD_Topo_FComp.n3x, CAD_Topo_FComp.xx)), Float_Mul(Float_Sub(CAD_Topo_FComp.n3y, CAD_Topo_FComp.xy), Float_Sub(CAD_Topo_FComp.n3y, CAD_Topo_FComp.xy))), Float_Mul(Float_Sub(CAD_Topo_FComp.n3z, CAD_Topo_FComp.xz), Float_Sub(CAD_Topo_FComp.n3z, CAD_Topo_FComp.xz))))
        CAD_Topo_FLoc.ab = CAD_Num.Abs(Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Topo_FComp.n3x, CAD_Topo_FComp.xx), CAD_Topo_FComp.n1x), Float_Mul(Float_Sub(CAD_Topo_FComp.n3y, CAD_Topo_FComp.xy), CAD_Topo_FComp.n1y)), Float_Mul(Float_Sub(CAD_Topo_FComp.n3z, CAD_Topo_FComp.xz), CAD_Topo_FComp.n1z)))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n3x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n3y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.n3z, CAD_Topo_FComp.n3z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.hd = CAD_Num.Abs(Float_Sub(CAD_Topo_FLoc.ln, CAD_Topo_FComp.rr))
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpU("PCYL dpl=", 9, CAD_Topo_FLoc.ab)
        CAD_Topo.FilletDumpU(" dcyl=", 6, CAD_Topo_FLoc.hd)
        CAD_Topo.FilletDumpU(" R=", 3, CAD_Topo_FLoc.r)
        CAD_Topo.FilletDumpS("\n", 1)
        CAD_Topo_FComp.cx = Float_Div(CAD_Topo_FComp.n3x, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.cy = Float_Div(CAD_Topo_FComp.n3y, CAD_Topo_FLoc.ln)
        CAD_Topo_FComp.cz = Float_Div(CAD_Topo_FComp.n3z, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.edx, CAD_Topo_FComp.edx), Float_Mul(CAD_Topo_FComp.edy, CAD_Topo_FComp.edy)), Float_Mul(CAD_Topo_FComp.edz, CAD_Topo_FComp.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FComp.edx, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FComp.edy, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FComp.edz, CAD_Topo_FLoc.ln)
        CAD_Topo_FLoc.c0x = Float_Add(Float_Add(CAD_Topo_FComp.px, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edx))
        CAD_Topo_FLoc.c0y = Float_Add(Float_Add(CAD_Topo_FComp.py, CAD_Topo_FComp.n3y), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edy))
        CAD_Topo_FLoc.c0z = Float_Add(Float_Add(CAD_Topo_FComp.pz, CAD_Topo_FComp.n3z), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FLoc.edz))
        CAD_Topo_FLoc.c1x = Float_Add(Float_Add(CAD_Topo_FComp.px, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FLoc.edx))
        CAD_Topo_FLoc.c1y = Float_Add(Float_Add(CAD_Topo_FComp.py, CAD_Topo_FComp.n3y), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FLoc.edy))
        CAD_Topo_FLoc.c1z = Float_Add(Float_Add(CAD_Topo_FComp.pz, CAD_Topo_FComp.n3z), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FLoc.edz))
        CAD_Topo_FLoc.ab = Float_Sub(Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.cx), CAD_Topo_FComp.n3x)
        CAD_Topo_FLoc.ln = Float_Sub(Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.cy), CAD_Topo_FComp.n3y)
        CAD_Topo_FLoc.hd = Float_Sub(Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.cz), CAD_Topo_FComp.n3z)
        CAD_Topo_FLoc.lp = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.ab), Float_Mul(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.ln)), Float_Mul(CAD_Topo_FLoc.hd, CAD_Topo_FLoc.hd)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.lp, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.ab = Float_Div(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.lp)
        CAD_Topo_FLoc.ln = Float_Div(CAD_Topo_FLoc.ln, CAD_Topo_FLoc.lp)
        CAD_Topo_FLoc.hd = Float_Div(CAD_Topo_FLoc.hd, CAD_Topo_FLoc.lp)
        CAD_Topo_FLoc.ce = 0x3FF0000000000000
        IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: { CAD_Topo_FLoc.ce = 0xBFF0000000000000 }
        IfCondition EqualTo(CAD_Topo_FLoc.sn, 1) ThenBlock: {
            CAD_Topo_FLoc.n1x = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1x)
            CAD_Topo_FLoc.n1y = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1y)
            CAD_Topo_FLoc.n1z = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1z)
            CAD_Topo_FLoc.n2x = CAD_Topo_FLoc.ab
            CAD_Topo_FLoc.n2y = CAD_Topo_FLoc.ln
            CAD_Topo_FLoc.n2z = CAD_Topo_FLoc.hd
        }
        IfCondition EqualTo(CAD_Topo_FLoc.sn, 2) ThenBlock: {
            CAD_Topo_FLoc.n2x = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1x)
            CAD_Topo_FLoc.n2y = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1y)
            CAD_Topo_FLoc.n2z = Float_Mul(CAD_Topo_FLoc.ce, CAD_Topo_FComp.n1z)
            CAD_Topo_FLoc.n1x = CAD_Topo_FLoc.ab
            CAD_Topo_FLoc.n1y = CAD_Topo_FLoc.ln
            CAD_Topo_FLoc.n1z = CAD_Topo_FLoc.hd
        }
        CAD_Topo_FComp.mode = 1
        PrintMessage("fillet SOLVE plane-cyl\n")
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpS("PCYL\n", 5)
        CAD_Topo.FilletDumpU(" Rc=", 4, CAD_Topo_FComp.rr)
        CAD_Topo.FilletDumpU(" Roff=", 6, CAD_Topo_FComp.aa)
        CAD_Topo.FilletDumpU(" d=", 3, CAD_Topo_FComp.padh)
        CAD_Topo.FilletDumpI(" which=", 7, CAD_Topo_FLoc.which)
        CAD_Topo.FilletDumpU(" n1=", 4, CAD_Topo_FComp.n1x)
        CAD_Topo.FilletDumpU(",", 1, CAD_Topo_FComp.n1y)
        CAD_Topo.FilletDumpU(" nw=", 4, CAD_Topo_FComp.yx)
        CAD_Topo.FilletDumpU(",", 1, CAD_Topo_FComp.yy)
        CAD_Topo.FilletDumpU(" c0z=", 5, CAD_Topo_FLoc.c0z)
        CAD_Topo.FilletDumpU(" c1z=", 5, CAD_Topo_FLoc.c1z)
        CAD_Topo.FilletDumpS("\n", 1)
        // Dump Integer locals smash FLoc.c0/n. Contacts read these.
        CAD_Topo_FComp.n3x = CAD_Topo_FLoc.c0x
        CAD_Topo_FComp.n3y = CAD_Topo_FLoc.c0y
        CAD_Topo_FComp.n3z = CAD_Topo_FLoc.c0z
        CAD_Topo_FComp.cx = CAD_Topo_FLoc.c1x
        CAD_Topo_FComp.cy = CAD_Topo_FLoc.c1y
        CAD_Topo_FComp.cz = CAD_Topo_FLoc.c1z
        CAD_Topo_FComp.xx = CAD_Topo_FLoc.n1x
        CAD_Topo_FComp.xy = CAD_Topo_FLoc.n1y
        CAD_Topo_FComp.xz = CAD_Topo_FLoc.n1z
        CAD_Topo_FComp.yx = CAD_Topo_FLoc.n2x
        CAD_Topo_FComp.yy = CAD_Topo_FLoc.n2y
        CAD_Topo_FComp.yz = CAD_Topo_FLoc.n2z
        ReturnValue(1)
    }
}

// A cos t + B sin t = D. Writes the two roots to out[0], out[1].
// Returns 2, or 0 when the line misses the circle.
Function.CAD_Topo.FilletSolveAng {
    Input: aa: Integer
    Input: bb: Integer
    Input: dd: Integer
    Input: out_a: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(out_a, 0) ThenBlock: { ReturnValue(0) }
        hyp = CAD_Num.Sqrt(Float_Add(CAD_Num.Sq(aa), CAD_Num.Sq(bb)))
        IfCondition EqualTo(CAD_Num.IsZero(hyp, 0), 1) ThenBlock: { ReturnValue(0) }
        c = Float_Div(dd, hyp)
        one = 0x3FF0000000000000
        over = 0x3FF028F5C28F5C29
        IfCondition EqualTo(CAD_Num.Le(over, c), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(c, Float_Sub(0, over)), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(one, c), 1) ThenBlock: { c = one }
        IfCondition EqualTo(CAD_Num.Le(c, Float_Sub(0, one)), 1) ThenBlock: { c = Float_Sub(0, one) }
        alpha = CAD_Geom.Atan2(bb, aa)
        s = CAD_Num.Sqrt(Float_Sub(one, CAD_Num.Sq(c)))
        delta = CAD_Geom.Atan2(s, c)
        ArraySet(out_a, 0, Float_Add(alpha, delta))
        ArraySet(out_a, 1, Float_Sub(alpha, delta))
        ReturnValue(2)
    }
}

// Plane face at this corner that is not the lid and not the fillet wall.
// Fills FCove.pl. Returns 1 on hit.
Function.CAD_Topo.FilletEmitSidePlane {
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.pl, 0) ThenBlock: { ReturnValue(0) }
        hf = CAD_Topo_FCove.host_f
        wf = CAD_Topo_FCove.f2
        sh = CAD_Store.Read(CAD_Topo_FCove.solid, 0)
        IfCondition EqualTo(sh, 0) ThenBlock: { ReturnValue(0) }
        face = CAD_Store.Read(sh, 0)
        found = 0
        g = 0
        WhileLoop LessThan(g, 64) {
            IfCondition EqualTo(face, 0) ThenBlock: { g = 64 }
            IfCondition NotEqual(found, 0) ThenBlock: { g = 64 }
            IfCondition NotEqual(face, 0) ThenBlock: {
                IfCondition EqualTo(found, 0) ThenBlock: {
                    use = 1
                    IfCondition EqualTo(face, hf) ThenBlock: { use = 0 }
                    IfCondition EqualTo(face, wf) ThenBlock: { use = 0 }
                    surf = 0
                    IfCondition EqualTo(use, 1) ThenBlock: { surf = CAD_Store.Read(face, 0) }
                    sk = 0
                    IfCondition NotEqual(surf, 0) ThenBlock: { sk = CAD_Store.Read(surf, 0) }
                    IfCondition NotEqual(sk, 1) ThenBlock: { use = 0 }
                    IfCondition EqualTo(use, 1) ThenBlock: {
                        lp = CAD_Store.Read(face, 1)
                        IfCondition EqualTo(lp, 0) ThenBlock: { use = 0 }
                        IfCondition EqualTo(use, 1) ThenBlock: {
                            ce = CAD_Store.Read(lp, 0)
                            hd = ce
                            j = 0
                            WhileLoop LessThan(j, 64) {
                                IfCondition EqualTo(ce, 0) ThenBlock: { j = 64 }
                                IfCondition NotEqual(ce, 0) ThenBlock: {
                                    ed = CAD_Store.Read(ce, 0)
                                    hit = 0
                                    IfCondition NotEqual(ed, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Store.Read(ed, 0), vh) ThenBlock: { hit = 1 }
                                        IfCondition EqualTo(CAD_Store.Read(ed, 1), vh) ThenBlock: { hit = 1 }
                                    }
                                    IfCondition EqualTo(hit, 1) ThenBlock: {
                                        found = face
                                        j = 64
                                    }
                                    ce = CAD_Store.Read(ce, 2)
                                    IfCondition EqualTo(ce, hd) ThenBlock: { j = 64 }
                                }
                                j = Add(j, 1)
                            }
                        }
                    }
                    face = CAD_Store.Read(face, 3)
                }
            }
            g = Add(g, 1)
        }
        IfCondition EqualTo(found, 0) ThenBlock: { ReturnValue(0) }
        rc = CAD_Topo.FaceGetPlane(found, CAD_Topo_FCove.pl)
        IfCondition EqualTo(rc, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Circle through Th, Tw, and the torus section at the side plane.
// Th is already on the plane. Returns the edge, or 0.
Function.CAD_Topo.FilletEmitPlaneMer {
    Input: th: Integer
    Input: tw: Integer
    Input: tor_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tor_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.pl, 0) ThenBlock: { ReturnValue(0) }
        ox = CAD_Store.Read(tor_h, 1)
        oy = CAD_Store.Read(tor_h, 2)
        oz = CAD_Store.Read(tor_h, 3)
        xx = CAD_Store.Read(tor_h, 4)
        xy = CAD_Store.Read(tor_h, 5)
        xz = CAD_Store.Read(tor_h, 6)
        yx = CAD_Store.Read(tor_h, 7)
        yy = CAD_Store.Read(tor_h, 8)
        yz = CAD_Store.Read(tor_h, 9)
        zx = CAD_Store.Read(tor_h, 10)
        zy = CAD_Store.Read(tor_h, 11)
        zz = CAD_Store.Read(tor_h, 12)
        rmaj = CAD_Store.Read(tor_h, 13)
        rmin = CAD_Store.Read(tor_h, 14)
        IfCondition EqualTo(CAD_Num.IsZero(rmin, 0), 1) ThenBlock: { ReturnValue(0) }
        nx = ArrayGet(CAD_Topo_FCove.pl, 10)
        ny = ArrayGet(CAD_Topo_FCove.pl, 11)
        nz = ArrayGet(CAD_Topo_FCove.pl, 12)
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(nx), CAD_Num.Sq(ny)), CAD_Num.Sq(nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 1) ThenBlock: { ReturnValue(0) }
        nx = Float_Div(nx, nl)
        ny = Float_Div(ny, nl)
        nz = Float_Div(nz, nl)
        px = CAD_Store.Read(th, 0)
        py = CAD_Store.Read(th, 1)
        pz = CAD_Store.Read(th, 2)
        qx = CAD_Store.Read(tw, 0)
        qy = CAD_Store.Read(tw, 1)
        qz = CAD_Store.Read(tw, 2)
        dx = Float_Sub(px, ox)
        dy = Float_Sub(py, oy)
        dz = Float_Sub(pz, oz)
        ax = Float_Add(Float_Add(Float_Mul(dx, zx), Float_Mul(dy, zy)), Float_Mul(dz, zz))
        rx = Float_Sub(dx, Float_Mul(ax, zx))
        ry = Float_Sub(dy, Float_Mul(ax, zy))
        rz = Float_Sub(dz, Float_Mul(ax, zz))
        rd = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(rx), CAD_Num.Sq(ry)), CAD_Num.Sq(rz)))
        vth = CAD_Geom.Atan2(Float_Div(ax, rmin), Float_Div(Float_Sub(rd, rmaj), rmin))
        dx = Float_Sub(qx, ox)
        dy = Float_Sub(qy, oy)
        dz = Float_Sub(qz, oz)
        ax = Float_Add(Float_Add(Float_Mul(dx, zx), Float_Mul(dy, zy)), Float_Mul(dz, zz))
        rx = Float_Sub(dx, Float_Mul(ax, zx))
        ry = Float_Sub(dy, Float_Mul(ax, zy))
        rz = Float_Sub(dz, Float_Mul(ax, zz))
        rd = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(rx), CAD_Num.Sq(ry)), CAD_Num.Sq(rz)))
        vtw = CAD_Geom.Atan2(Float_Div(ax, rmin), Float_Div(Float_Sub(rd, rmaj), rmin))
        pi = 0x400921FB54442D18
        two = 0x401921FB54442D18
        half = 0x3FE0000000000000
        dv = Float_Sub(vtw, vth)
        IfCondition EqualTo(CAD_Num.Le(pi, dv), 1) ThenBlock: { dv = Float_Sub(dv, two) }
        IfCondition EqualTo(CAD_Num.Le(dv, Float_Sub(0, pi)), 1) ThenBlock: { dv = Float_Add(dv, two) }
        vm = Float_Add(vth, Float_Mul(dv, half))
        cv = CAD_Geom.Cos(vm)
        sv = CAD_Geom.Sin(vm)
        rho = Float_Add(rmaj, Float_Mul(rmin, cv))
        aa = Float_Mul(rho, Float_Add(Float_Add(Float_Mul(nx, xx), Float_Mul(ny, xy)), Float_Mul(nz, xz)))
        bb = Float_Mul(rho, Float_Add(Float_Add(Float_Mul(nx, yx), Float_Mul(ny, yy)), Float_Mul(nz, yz)))
        dd = Float_Add(Float_Add(Float_Mul(nx, Float_Sub(ox, px)), Float_Mul(ny, Float_Sub(oy, py))), Float_Mul(nz, Float_Sub(oz, pz)))
        dd = Float_Sub(0, dd)
        dd = Float_Sub(dd, Float_Mul(Float_Mul(rmin, sv), Float_Add(Float_Add(Float_Mul(nx, zx), Float_Mul(ny, zy)), Float_Mul(nz, zz))))
        IfCondition NotEqual(CAD_Topo.FilletSolveAng(aa, bb, dd, CAD_Topo_FCove.p1b), 2) ThenBlock: { ReturnValue(0) }
        t0 = ArrayGet(CAD_Topo_FCove.p1b, 0)
        t1 = ArrayGet(CAD_Topo_FCove.p1b, 1)
        cu = CAD_Geom.Cos(t0)
        su = CAD_Geom.Sin(t0)
        mx = Float_Add(ox, Float_Add(Float_Mul(rho, Float_Add(Float_Mul(cu, xx), Float_Mul(su, yx))), Float_Mul(Float_Mul(rmin, sv), zx)))
        my = Float_Add(oy, Float_Add(Float_Mul(rho, Float_Add(Float_Mul(cu, xy), Float_Mul(su, yy))), Float_Mul(Float_Mul(rmin, sv), zy)))
        mz = Float_Add(oz, Float_Add(Float_Mul(rho, Float_Add(Float_Mul(cu, xz), Float_Mul(su, yz))), Float_Mul(Float_Mul(rmin, sv), zz)))
        cu = CAD_Geom.Cos(t1)
        su = CAD_Geom.Sin(t1)
        m2x = Float_Add(ox, Float_Add(Float_Mul(rho, Float_Add(Float_Mul(cu, xx), Float_Mul(su, yx))), Float_Mul(Float_Mul(rmin, sv), zx)))
        m2y = Float_Add(oy, Float_Add(Float_Mul(rho, Float_Add(Float_Mul(cu, xy), Float_Mul(su, yy))), Float_Mul(Float_Mul(rmin, sv), zy)))
        m2z = Float_Add(oz, Float_Add(Float_Mul(rho, Float_Add(Float_Mul(cu, xz), Float_Mul(su, yz))), Float_Mul(Float_Mul(rmin, sv), zz)))
        mid = Float_Mul(Float_Add(px, qx), half)
        midy = Float_Mul(Float_Add(py, qy), half)
        midz = Float_Mul(Float_Add(pz, qz), half)
        d0 = Float_Add(Float_Add(CAD_Num.Sq(Float_Sub(mx, mid)), CAD_Num.Sq(Float_Sub(my, midy))), CAD_Num.Sq(Float_Sub(mz, midz)))
        d1 = Float_Add(Float_Add(CAD_Num.Sq(Float_Sub(m2x, mid)), CAD_Num.Sq(Float_Sub(m2y, midy))), CAD_Num.Sq(Float_Sub(m2z, midz)))
        IfCondition EqualTo(CAD_Num.Le(d1, d0), 1) ThenBlock: {
            mx = m2x
            my = m2y
            mz = m2z
        }
        abx = Float_Sub(qx, px)
        aby = Float_Sub(qy, py)
        abz = Float_Sub(qz, pz)
        acx = Float_Sub(mx, px)
        acy = Float_Sub(my, py)
        acz = Float_Sub(mz, pz)
        nnx = Float_Sub(Float_Mul(aby, acz), Float_Mul(abz, acy))
        nny = Float_Sub(Float_Mul(abz, acx), Float_Mul(abx, acz))
        nnz = Float_Sub(Float_Mul(abx, acy), Float_Mul(aby, acx))
        nn = Float_Add(Float_Add(CAD_Num.Sq(nnx), CAD_Num.Sq(nny)), CAD_Num.Sq(nnz))
        IfCondition EqualTo(CAD_Num.Le(nn, 0x3EB0C6F7A0B5ED8D), 1) ThenBlock: { ReturnValue(0) }
        a2 = Float_Add(Float_Add(CAD_Num.Sq(abx), CAD_Num.Sq(aby)), CAD_Num.Sq(abz))
        c2 = Float_Add(Float_Add(CAD_Num.Sq(acx), CAD_Num.Sq(acy)), CAD_Num.Sq(acz))
        t1x = Float_Sub(Float_Mul(nny, abz), Float_Mul(nnz, aby))
        t1y = Float_Sub(Float_Mul(nnz, abx), Float_Mul(nnx, abz))
        t1z = Float_Sub(Float_Mul(nnx, aby), Float_Mul(nny, abx))
        t2x = Float_Sub(Float_Mul(acy, nnz), Float_Mul(acz, nny))
        t2y = Float_Sub(Float_Mul(acz, nnx), Float_Mul(acx, nnz))
        t2z = Float_Sub(Float_Mul(acx, nny), Float_Mul(acy, nnx))
        den = Float_Add(nn, nn)
        cx = Float_Add(px, Float_Div(Float_Add(Float_Mul(c2, t1x), Float_Mul(a2, t2x)), den))
        cy = Float_Add(py, Float_Div(Float_Add(Float_Mul(c2, t1y), Float_Mul(a2, t2y)), den))
        cz = Float_Add(pz, Float_Div(Float_Add(Float_Mul(c2, t1z), Float_Mul(a2, t2z)), den))
        rr = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(Float_Sub(px, cx)), CAD_Num.Sq(Float_Sub(py, cy))), CAD_Num.Sq(Float_Sub(pz, cz))))
        lo = Float_Mul(rmin, 0x3FD0000000000000)
        rhi = Float_Mul(rmin, 0x4010000000000000)
        IfCondition EqualTo(CAD_Num.Le(rr, lo), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.Le(rhi, rr), 1) ThenBlock: { ReturnValue(0) }
        em = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(Float_Sub(mx, cx)), CAD_Num.Sq(Float_Sub(my, cy))), CAD_Num.Sq(Float_Sub(mz, cz))))
        em = CAD_Num.Abs(Float_Sub(em, rr))
        IfCondition EqualTo(CAD_Num.Le(0x3FE0000000000000, em), 1) ThenBlock: { ReturnValue(0) }
        ux = Float_Div(Float_Sub(px, cx), rr)
        uy = Float_Div(Float_Sub(py, cy), rr)
        uz = Float_Div(Float_Sub(pz, cz), rr)
        vx = Float_Sub(Float_Mul(nny, uz), Float_Mul(nnz, uy))
        vy = Float_Sub(Float_Mul(nnz, ux), Float_Mul(nnx, uz))
        vz = Float_Sub(Float_Mul(nnx, uy), Float_Mul(nny, ux))
        vl = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(vx), CAD_Num.Sq(vy)), CAD_Num.Sq(vz)))
        IfCondition EqualTo(CAD_Num.IsZero(vl, 0), 1) ThenBlock: { ReturnValue(0) }
        vx = Float_Div(vx, vl)
        vy = Float_Div(vy, vl)
        vz = Float_Div(vz, vl)
        ArraySet(CAD_Topo_FCove.frame, 0, cx)
        ArraySet(CAD_Topo_FCove.frame, 1, cy)
        ArraySet(CAD_Topo_FCove.frame, 2, cz)
        ArraySet(CAD_Topo_FCove.frame, 3, ux)
        ArraySet(CAD_Topo_FCove.frame, 4, uy)
        ArraySet(CAD_Topo_FCove.frame, 5, uz)
        ArraySet(CAD_Topo_FCove.frame, 6, vx)
        ArraySet(CAD_Topo_FCove.frame, 7, vy)
        ArraySet(CAD_Topo_FCove.frame, 8, vz)
        ch = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, rr)
        IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Topo.MakeMinorArcEdge(th, tw, ch))
    }
}

Function.CAD_Topo.FilletEmitPlaneCyl {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIREnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(edge_handle)
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.h), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 11), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 15), 4) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.solid = solid_handle
        CAD_Topo_FCove.e = edge_handle
        CAD_Topo_FCove.r = radius_r
        CAD_Topo_FCove.shell = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.host_f = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 19)
        CAD_Topo_FCove.f2 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 20)
        IfCondition EqualTo(CAD_Topo_FCove.host_f, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.v0 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 23)
        CAD_Topo_FCove.nxt = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 22)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.nxt, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.nxt, 0)
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.v0) ThenBlock: {
            CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.nxt, 1)
        }
        CAD_Topo_FComp.n1x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 6)
        CAD_Topo_FComp.n1y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 7)
        CAD_Topo_FComp.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 8)
        CAD_Topo_FComp.n2x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 9)
        CAD_Topo_FComp.n2y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 10)
        CAD_Topo_FComp.n2z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 11)
        CAD_Topo_FCove.n3x = CAD_Topo_FComp.n1x
        CAD_Topo_FCove.n3y = CAD_Topo_FComp.n1y
        CAD_Topo_FCove.n3z = CAD_Topo_FComp.n1z
        CAD_Topo_FCove.which = CAD_Store.Read(edge_handle, 2)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.which, 1)
        CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.which, 2)
        CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.which, 3)
        CAD_Topo_FCove.s = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 21)
        PrintMessage("fillet emit plane-cyl mode=")
        PrintNumber(CAD_Topo_FCove.s)
        PrintMessage(" Rmaj=")
        PrintNumber(Float_ToInt(CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 12)))
        PrintMessage(" Nz=")
        CAD_Topo_FComp.k = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.n1z), 1) ThenBlock: { CAD_Topo_FComp.k = Subtract(0, 1) }
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.n1z), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.n1z, 0), 0) ThenBlock: { CAD_Topo_FComp.k = 1 }
        }
        PrintNumber(CAD_Topo_FComp.k)
        PrintMessage("\n")
        CAD_Topo_FCove.j = CAD_Topo.FilletEmitMakeGeom()
        IfCondition EqualTo(CAD_Topo_FCove.j, 0) ThenBlock: { ReturnValue(0) }
        PrintMessage("fillet emit torus ok\n")
        ReturnValue(CAD_Topo_FCove.solid)
    }
}

// Dump/MakeVertex smash FLoc.c0/n/edx. SOLVE left them on FComp.
Function.CAD_Topo.FilletEmitRestorePlaneCyl {
    Output: Integer
    Body: {
        CAD_Topo_FLoc.c0x = CAD_Topo_FComp.n3x
        CAD_Topo_FLoc.c0y = CAD_Topo_FComp.n3y
        CAD_Topo_FLoc.c0z = CAD_Topo_FComp.n3z
        CAD_Topo_FLoc.c1x = CAD_Topo_FComp.cx
        CAD_Topo_FLoc.c1y = CAD_Topo_FComp.cy
        CAD_Topo_FLoc.c1z = CAD_Topo_FComp.cz
        CAD_Topo_FLoc.n1x = CAD_Topo_FComp.xx
        CAD_Topo_FLoc.n1y = CAD_Topo_FComp.xy
        CAD_Topo_FLoc.n1z = CAD_Topo_FComp.xz
        CAD_Topo_FLoc.n2x = CAD_Topo_FComp.yx
        CAD_Topo_FLoc.n2y = CAD_Topo_FComp.yy
        CAD_Topo_FLoc.n2z = CAD_Topo_FComp.yz
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.edx, CAD_Topo_FComp.edx), Float_Mul(CAD_Topo_FComp.edy, CAD_Topo_FComp.edy)), Float_Mul(CAD_Topo_FComp.edz, CAD_Topo_FComp.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 0) ThenBlock: {
            CAD_Topo_FLoc.edx = Float_Div(CAD_Topo_FComp.edx, CAD_Topo_FLoc.ln)
            CAD_Topo_FLoc.edy = Float_Div(CAD_Topo_FComp.edy, CAD_Topo_FLoc.ln)
            CAD_Topo_FLoc.edz = Float_Div(CAD_Topo_FComp.edz, CAD_Topo_FLoc.ln)
        }
        ReturnValue(1)
    }
}

