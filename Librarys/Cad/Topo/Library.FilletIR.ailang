// CAD.Topo.FilletIR — PARSE/ANALYZE/CHAIN/SOLVE. Slab 24 / sol 16 / vsol 16.
// 2-face at V; Gram iff 3 planes det≠0; miss>|R| is not a constant-R join.
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Err
LibraryImport.Cad.CAD_Sys

FixedPool.CAD_Topo_FComp {
    "solid": Initialize=0, CanChange=True
    "n":     Initialize=0, CanChange=True
    "r":     Initialize=0, CanChange=True
    "i":     Initialize=0, CanChange=True
    "k":     Initialize=0, CanChange=True
    "j":     Initialize=0, CanChange=True
    "e":     Initialize=0, CanChange=True
    "h":     Initialize=0, CanChange=True
    "ok":    Initialize=0, CanChange=True
    "slab":  Initialize=0, CanChange=True
    "sol":   Initialize=0, CanChange=True
    "vsol":  Initialize=0, CanChange=True
    "faces": Initialize=0, CanChange=True
    "pl":    Initialize=0, CanChange=True
    "xyz":   Initialize=0, CanChange=True
    "f1":    Initialize=0, CanChange=True
    "f2":    Initialize=0, CanChange=True
    "s1":    Initialize=0, CanChange=True
    "s2":    Initialize=0, CanChange=True
    "kind":  Initialize=0, CanChange=True
    "inner": Initialize=0, CanChange=True
    "side":  Initialize=0, CanChange=True
    "pair":  Initialize=0, CanChange=True
    "px":    Initialize=0, CanChange=True
    "py":    Initialize=0, CanChange=True
    "pz":    Initialize=0, CanChange=True
    "n1x":   Initialize=0, CanChange=True
    "n1y":   Initialize=0, CanChange=True
    "n1z":   Initialize=0, CanChange=True
    "n2x":   Initialize=0, CanChange=True
    "n2y":   Initialize=0, CanChange=True
    "n2z":   Initialize=0, CanChange=True
    "xx":    Initialize=0, CanChange=True
    "xy":    Initialize=0, CanChange=True
    "xz":    Initialize=0, CanChange=True
    "yx":    Initialize=0, CanChange=True
    "yy":    Initialize=0, CanChange=True
    "yz":    Initialize=0, CanChange=True
    "cx":    Initialize=0, CanChange=True
    "cy":    Initialize=0, CanChange=True
    "cz":    Initialize=0, CanChange=True
    "rr":    Initialize=0, CanChange=True
    "padh":  Initialize=0, CanChange=True
    "mode":  Initialize=0, CanChange=True
    "ln":    Initialize=0, CanChange=True
    "v0":    Initialize=0, CanChange=True
    "v1":    Initialize=0, CanChange=True
    "gen":   Initialize=0, CanChange=True
    "shost": Initialize=0, CanChange=True
    "srad":  Initialize=0, CanChange=True
    "rmaj":  Initialize=0, CanChange=True
    "refuse": Initialize=0, CanChange=True
    "host":  Initialize=0, CanChange=True
    "wall":  Initialize=0, CanChange=True
    "ce":    Initialize=0, CanChange=True
    "which": Initialize=0, CanChange=True
    "edx":   Initialize=0, CanChange=True
    "edy":   Initialize=0, CanChange=True
    "edz":   Initialize=0, CanChange=True
    "n3x":   Initialize=0, CanChange=True
    "n3y":   Initialize=0, CanChange=True
    "n3z":   Initialize=0, CanChange=True
    "s":     Initialize=0, CanChange=True
    "aa":    Initialize=0, CanChange=True
    "bb":    Initialize=0, CanChange=True
    "mfd":   Initialize=0, CanChange=True
}

Function.CAD_Topo.FilletIREnsure {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FComp.slab, 0) ThenBlock: { CAD_Topo_FComp.slab = Allocate(4096) }
        IfCondition EqualTo(CAD_Topo_FComp.sol, 0) ThenBlock: { CAD_Topo_FComp.sol = Allocate(2048) }
        IfCondition EqualTo(CAD_Topo_FComp.vsol, 0) ThenBlock: { CAD_Topo_FComp.vsol = Allocate(2048) }
        IfCondition EqualTo(CAD_Topo_FComp.faces, 0) ThenBlock: { CAD_Topo_FComp.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FComp.pl, 0) ThenBlock: { CAD_Topo_FComp.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FComp.xyz, 0) ThenBlock: { CAD_Topo_FComp.xyz = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FComp.slab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.sol, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.vsol, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.faces, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletIRPut {
    Input: idx: Integer
    Input: slot: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        ArraySet(CAD_Topo_FComp.slab, Add(Multiply(idx, 24), slot), val)
        ReturnValue(val)
    }
}

Function.CAD_Topo.FilletIRGet {
    Input: idx: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        ReturnValue(ArrayGet(CAD_Topo_FComp.slab, Add(Multiply(idx, 24), slot)))
    }
}

Function.CAD_Topo.FilletIRSolPut {
    Input: idx: Integer
    Input: slot: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        ArraySet(CAD_Topo_FComp.sol, Add(Multiply(idx, 16), slot), val)
        ReturnValue(val)
    }
}

Function.CAD_Topo.FilletIRSolGet {
    Input: idx: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        ReturnValue(ArrayGet(CAD_Topo_FComp.sol, Add(Multiply(idx, 16), slot)))
    }
}

Function.CAD_Topo.FilletIRVSolPut {
    Input: idx: Integer
    Input: slot: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        ArraySet(CAD_Topo_FComp.vsol, Add(Multiply(idx, 16), slot), val)
        ReturnValue(val)
    }
}

Function.CAD_Topo.FilletIRVSolGet {
    Input: idx: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        ReturnValue(ArrayGet(CAD_Topo_FComp.vsol, Add(Multiply(idx, 16), slot)))
    }
}

Function.CAD_Topo.FilletIRFaceKind {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.which = CAD_Store.Read(face_handle, 0)
        IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(CAD_Topo_FComp.which, 0))
    }
}

// min/max signed distance of solid verts from host plane (P, N_host).
// shost=min srad=max. Walk temps: rmaj/xx/xy/xz/yx. Not i/h/ok/kind/pair.
Function.CAD_Topo.FilletIRHostMinMax {
    Output: Integer
    Body: {
        CAD_Topo_FComp.shost = CAD_Topo_FComp.padh
        CAD_Topo_FComp.srad = CAD_Topo_FComp.padh
        CAD_Topo_FComp.ce = CAD_Store.Read(CAD_Topo_FComp.solid, 0)
        CAD_Topo_FComp.k = 0
        WhileLoop NotEqual(CAD_Topo_FComp.ce, 0) {
            IfCondition GreaterThan(CAD_Topo_FComp.k, 64) ThenBlock: { CAD_Topo_FComp.ce = 0 }
            IfCondition NotEqual(CAD_Topo_FComp.ce, 0) ThenBlock: {
                CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FComp.ce, 0)
                CAD_Topo_FComp.j = 0
                WhileLoop NotEqual(CAD_Topo_FComp.which, 0) {
                    IfCondition GreaterThan(CAD_Topo_FComp.j, 256) ThenBlock: { CAD_Topo_FComp.which = 0 }
                    IfCondition NotEqual(CAD_Topo_FComp.which, 0) ThenBlock: {
                        CAD_Topo_FComp.rmaj = CAD_Store.Read(CAD_Topo_FComp.which, 1)
                        CAD_Topo_FComp.refuse = 0
                        WhileLoop NotEqual(CAD_Topo_FComp.rmaj, 0) {
                            IfCondition GreaterThan(CAD_Topo_FComp.refuse, 8) ThenBlock: { CAD_Topo_FComp.rmaj = 0 }
                            IfCondition NotEqual(CAD_Topo_FComp.rmaj, 0) ThenBlock: {
                                CAD_Topo_FComp.xx = CAD_Store.Read(CAD_Topo_FComp.rmaj, 0)
                                CAD_Topo_FComp.xy = CAD_Topo_FComp.xx
                                CAD_Topo_FComp.xz = 0
                                WhileLoop LessThan(CAD_Topo_FComp.xz, 256) {
                                    IfCondition EqualTo(CAD_Topo_FComp.xy, 0) ThenBlock: { CAD_Topo_FComp.xz = 256 }
                                    IfCondition NotEqual(CAD_Topo_FComp.xy, 0) ThenBlock: {
                                        CAD_Topo_FComp.yx = CAD_Store.Read(CAD_Topo_FComp.xy, 5)
                                        IfCondition NotEqual(CAD_Topo_FComp.yx, 0) ThenBlock: {
                                            CAD_Topo_FComp.yy = Float_Add(Float_Add(CAD_Num.Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FComp.yx, 0), CAD_Topo_FComp.px), CAD_Topo_FComp.n1x), CAD_Num.Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FComp.yx, 1), CAD_Topo_FComp.py), CAD_Topo_FComp.n1y)), CAD_Num.Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FComp.yx, 2), CAD_Topo_FComp.pz), CAD_Topo_FComp.n1z))
                                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.yy, CAD_Topo_FComp.shost)), 1) ThenBlock: {
                                                CAD_Topo_FComp.shost = CAD_Topo_FComp.yy
                                            }
                                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.srad, CAD_Topo_FComp.yy)), 1) ThenBlock: {
                                                CAD_Topo_FComp.srad = CAD_Topo_FComp.yy
                                            }
                                        }
                                        CAD_Topo_FComp.xy = CAD_Store.Read(CAD_Topo_FComp.xy, 2)
                                        IfCondition EqualTo(CAD_Topo_FComp.xy, CAD_Topo_FComp.xx) ThenBlock: { CAD_Topo_FComp.xz = 256 }
                                    }
                                    CAD_Topo_FComp.xz = Add(CAD_Topo_FComp.xz, 1)
                                }
                                CAD_Topo_FComp.rmaj = CAD_Store.Read(CAD_Topo_FComp.rmaj, 2)
                            }
                            CAD_Topo_FComp.refuse = Add(CAD_Topo_FComp.refuse, 1)
                        }
                        CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FComp.which, 3)
                    }
                    CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
                }
                CAD_Topo_FComp.ce = CAD_Store.Read(CAD_Topo_FComp.ce, 2)
            }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletIRIndexOf {
    Input: edge_handle: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.k, 0), edge_handle) ThenBlock: {
                ReturnValue(CAD_Topo_FComp.k)
            }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        ReturnValue(Subtract(0, 1))
    }
}

// LINE on the wall face incident to the rim vertex.
Function.CAD_Topo.FilletIRFindGen {
    Input: start_ce: Integer
    Input: v_join: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.ce = start_ce
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, 6) {
            CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FComp.ce, 0)
            IfCondition NotEqual(CAD_Topo_FComp.which, 0) ThenBlock: {
                CAD_Topo_FComp.ln = CAD_Store.Read(CAD_Topo_FComp.which, 2)
                IfCondition NotEqual(CAD_Topo_FComp.ln, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.ln, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.which, 0), v_join) ThenBlock: {
                            ReturnValue(CAD_Topo_FComp.which)
                        }
                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.which, 1), v_join) ThenBlock: {
                            ReturnValue(CAD_Topo_FComp.which)
                        }
                    }
                }
            }
            CAD_Topo_FComp.ce = CAD_Store.Read(CAD_Topo_FComp.ce, 2)
            IfCondition EqualTo(CAD_Topo_FComp.ce, 0) ThenBlock: { CAD_Topo_FComp.k = 6 }
            IfCondition EqualTo(CAD_Topo_FComp.ce, start_ce) ThenBlock: { CAD_Topo_FComp.k = 6 }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        ReturnValue(0)
    }
}

// Right-handed XY from Z = N_host (n1*). Writes xx..yz.
Function.CAD_Topo.FilletIRBasis {
    Output: Integer
    Body: {
        CAD_Topo_FComp.ok = 1
        CAD_Topo_FComp.ln = CAD_Num.Abs(CAD_Topo_FComp.n1z)
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.ln, CAD_Num.Abs(CAD_Topo_FComp.n1x))), 1) ThenBlock: {
            CAD_Topo_FComp.ok = 0
        }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.ln, CAD_Num.Abs(CAD_Topo_FComp.n1y))), 1) ThenBlock: {
            CAD_Topo_FComp.ok = 0
        }
        // H helper: (0,0,1) unless N is already ±Z, then (1,0,0). Temps shost/srad/rmaj.
        CAD_Topo_FComp.shost = 0
        CAD_Topo_FComp.srad = 0
        CAD_Topo_FComp.rmaj = 0x3FF0000000000000
        IfCondition EqualTo(CAD_Topo_FComp.ok, 1) ThenBlock: {
            CAD_Topo_FComp.shost = 0x3FF0000000000000
            CAD_Topo_FComp.srad = 0
            CAD_Topo_FComp.rmaj = 0
        }
        // X = N × H
        CAD_Topo_FComp.xx = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.rmaj), CAD_Num.Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.srad))
        CAD_Topo_FComp.xy = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.shost), CAD_Num.Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.rmaj))
        CAD_Topo_FComp.xz = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.srad), CAD_Num.Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.shost))
        CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FComp.xx), CAD_Num.Sq(CAD_Topo_FComp.xy)), CAD_Num.Sq(CAD_Topo_FComp.xz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.xx = Float_Div(CAD_Topo_FComp.xx, CAD_Topo_FComp.ln)
        CAD_Topo_FComp.xy = Float_Div(CAD_Topo_FComp.xy, CAD_Topo_FComp.ln)
        CAD_Topo_FComp.xz = Float_Div(CAD_Topo_FComp.xz, CAD_Topo_FComp.ln)
        // Y = N × X
        CAD_Topo_FComp.yx = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.xz), CAD_Num.Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.xy))
        CAD_Topo_FComp.yy = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.xx), CAD_Num.Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.xz))
        CAD_Topo_FComp.yz = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.xy), CAD_Num.Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.xx))
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletParseSel {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.solid = solid_handle
        CAD_Topo_FComp.n = n_edges
        CAD_Topo_FComp.r = radius_r
        CAD_Topo_FComp.refuse = 0
        IfCondition EqualTo(CAD_Topo.FilletIREnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, 24) {
            CAD_Topo.FilletIRPut(0, CAD_Topo_FComp.i, 0)
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            CAD_Topo_FComp.k = 0
            WhileLoop LessThan(CAD_Topo_FComp.k, 16) {
                CAD_Topo.FilletIRVSolPut(CAD_Topo_FComp.i, CAD_Topo_FComp.k, 0)
                CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.i, CAD_Topo_FComp.k, 0)
                CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 0, ArrayGet(edges_addr, CAD_Topo_FComp.i))
            CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 13, Subtract(0, 1))
            CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 14, Subtract(0, 1))
            CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 12, CAD_Topo_FComp.i)
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletAnalyzeOne {
    Input: idx: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.h = idx
        CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 0)
        IfCondition EqualTo(CAD_Topo_FComp.e, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.kind = 0
        CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FComp.e, 2)
        IfCondition NotEqual(CAD_Topo_FComp.which, 0) ThenBlock: {
            CAD_Topo_FComp.kind = CAD_Store.Read(CAD_Topo_FComp.which, 0)
        }
        CAD_Topo_FComp.inner = CAD_Topo.EdgeIsInnerLoop(CAD_Topo_FComp.e)
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FComp.e, CAD_Topo_FComp.faces), 0) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Topo_FComp.f1 = ArrayGet(CAD_Topo_FComp.faces, 0)
        CAD_Topo_FComp.f2 = ArrayGet(CAD_Topo_FComp.faces, 1)
        CAD_Topo_FComp.s1 = CAD_Topo.FilletIRFaceKind(CAD_Topo_FComp.f1)
        CAD_Topo_FComp.s2 = CAD_Topo.FilletIRFaceKind(CAD_Topo_FComp.f2)
        CAD_Topo_FComp.pair = 2
        IfCondition EqualTo(CAD_Topo_FComp.s1, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.s2, 1) ThenBlock: { CAD_Topo_FComp.pair = 0 }
            IfCondition EqualTo(CAD_Topo_FComp.s2, 2) ThenBlock: { CAD_Topo_FComp.pair = 1 }
        }
        IfCondition EqualTo(CAD_Topo_FComp.s1, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.s2, 1) ThenBlock: { CAD_Topo_FComp.pair = 1 }
        }
        // LINE on plane+cyl is a generatrix, not a rim circle.
        IfCondition EqualTo(CAD_Topo_FComp.pair, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.kind, 1) ThenBlock: { CAD_Topo_FComp.pair = 0 }
        }
        CAD_Topo_FComp.v0 = CAD_Store.Read(CAD_Topo_FComp.e, 0)
        CAD_Topo_FComp.v1 = CAD_Store.Read(CAD_Topo_FComp.e, 1)
        IfCondition EqualTo(CAD_Topo_FComp.v0, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.px = CAD_Store.Read(CAD_Topo_FComp.v0, 0)
        CAD_Topo_FComp.py = CAD_Store.Read(CAD_Topo_FComp.v0, 1)
        CAD_Topo_FComp.pz = CAD_Store.Read(CAD_Topo_FComp.v0, 2)
        IfCondition NotEqual(CAD_Topo_FComp.v1, 0) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_FComp.v1, CAD_Topo_FComp.v0) ThenBlock: {
                CAD_Topo_FComp.px = Float_Mul(Float_Add(CAD_Topo_FComp.px, CAD_Store.Read(CAD_Topo_FComp.v1, 0)), 0x3FE0000000000000)
                CAD_Topo_FComp.py = Float_Mul(Float_Add(CAD_Topo_FComp.py, CAD_Store.Read(CAD_Topo_FComp.v1, 1)), 0x3FE0000000000000)
                CAD_Topo_FComp.pz = Float_Mul(Float_Add(CAD_Topo_FComp.pz, CAD_Store.Read(CAD_Topo_FComp.v1, 2)), 0x3FE0000000000000)
            }
        }
        CAD_Topo_FComp.host = 0
        CAD_Topo_FComp.wall = 0
        CAD_Topo_FComp.side = 1
        CAD_Topo_FComp.mode = 0
        CAD_Topo_FComp.gen = 0
        IfCondition EqualTo(CAD_Topo_FComp.pair, 0) ThenBlock: {
            CAD_Topo_FComp.edx = 0
            CAD_Topo_FComp.edy = 0
            CAD_Topo_FComp.edz = 0
            IfCondition NotEqual(CAD_Topo_FComp.v0, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FComp.v1, 0) ThenBlock: {
                    CAD_Topo_FComp.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v1, 0), CAD_Store.Read(CAD_Topo_FComp.v0, 0))
                    CAD_Topo_FComp.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v1, 1), CAD_Store.Read(CAD_Topo_FComp.v0, 1))
                    CAD_Topo_FComp.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v1, 2), CAD_Store.Read(CAD_Topo_FComp.v0, 2))
                }
            }
            IfCondition EqualTo(CAD_Topo.FilletFaceN(CAD_Topo_FComp.f1), 1) ThenBlock: {
                CAD_Topo_FComp.n1x = CAD_Topo_FComp.n2x
                CAD_Topo_FComp.n1y = CAD_Topo_FComp.n2y
                CAD_Topo_FComp.n1z = CAD_Topo_FComp.n2z
            }
            CAD_Topo.FilletFaceN(CAD_Topo_FComp.f2)
            // Occupancy without inner-loop force. nin>=3 → cove.
            CAD_Topo_FComp.ln = 0x3FE0000000000000
            CAD_Topo_FComp.ok = 0
            CAD_Topo_FComp.k = 0
            WhileLoop LessThan(CAD_Topo_FComp.k, 2) {
                CAD_Topo_FComp.j = 0
                WhileLoop LessThan(CAD_Topo_FComp.j, 2) {
                    CAD_Topo_FComp.shost = 0x3FF0000000000000
                    IfCondition EqualTo(CAD_Topo_FComp.k, 0) ThenBlock: { CAD_Topo_FComp.shost = 0xBFF0000000000000 }
                    CAD_Topo_FComp.srad = 0x3FF0000000000000
                    IfCondition EqualTo(CAD_Topo_FComp.j, 0) ThenBlock: { CAD_Topo_FComp.srad = 0xBFF0000000000000 }
                    ArraySet(CAD_Topo_FComp.xyz, 0, Float_Add(CAD_Topo_FComp.px, Float_Add(CAD_Num.Mul(CAD_Num.Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.ln), CAD_Topo_FComp.n1x), CAD_Num.Mul(CAD_Num.Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.ln), CAD_Topo_FComp.n2x))))
                    ArraySet(CAD_Topo_FComp.xyz, 1, Float_Add(CAD_Topo_FComp.py, Float_Add(CAD_Num.Mul(CAD_Num.Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.ln), CAD_Topo_FComp.n1y), CAD_Num.Mul(CAD_Num.Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.ln), CAD_Topo_FComp.n2y))))
                    ArraySet(CAD_Topo_FComp.xyz, 2, Float_Add(CAD_Topo_FComp.pz, Float_Add(CAD_Num.Mul(CAD_Num.Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.ln), CAD_Topo_FComp.n1z), CAD_Num.Mul(CAD_Num.Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.ln), CAD_Topo_FComp.n2z))))
                    IfCondition EqualTo(CAD_Topo.PointInSolid(CAD_Topo_FComp.solid, CAD_Topo_FComp.xyz), 1) ThenBlock: {
                        CAD_Topo_FComp.ok = Add(CAD_Topo_FComp.ok, 1)
                    }
                    CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
                }
                CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
            }
            CAD_Topo_FComp.side = 1
            IfCondition EqualTo(CAD_Topo_FComp.ok, 3) ThenBlock: { CAD_Topo_FComp.side = 0 }
            CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 15, 2)
        }
        IfCondition EqualTo(CAD_Topo_FComp.pair, 1) ThenBlock: {
            CAD_Topo_FComp.host = CAD_Topo_FComp.f1
            CAD_Topo_FComp.wall = CAD_Topo_FComp.f2
            IfCondition NotEqual(CAD_Topo_FComp.s1, 1) ThenBlock: {
                CAD_Topo_FComp.host = CAD_Topo_FComp.f2
                CAD_Topo_FComp.wall = CAD_Topo_FComp.f1
            }
            IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FComp.host, CAD_Topo_FComp.pl), 0) ThenBlock: {
                ReturnValue(0)
            }
            CAD_Topo_FComp.n1x = ArrayGet(CAD_Topo_FComp.pl, 10)
            CAD_Topo_FComp.n1y = ArrayGet(CAD_Topo_FComp.pl, 11)
            CAD_Topo_FComp.n1z = ArrayGet(CAD_Topo_FComp.pl, 12)
            CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FComp.n1x), CAD_Num.Sq(CAD_Topo_FComp.n1y)), CAD_Num.Sq(CAD_Topo_FComp.n1z)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.n1x = Float_Div(CAD_Topo_FComp.n1x, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.n1y = Float_Div(CAD_Topo_FComp.n1y, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.n1z = Float_Div(CAD_Topo_FComp.n1z, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FComp.e, 2)
            IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.cx = CAD_Store.Read(CAD_Topo_FComp.which, 1)
            CAD_Topo_FComp.cy = CAD_Store.Read(CAD_Topo_FComp.which, 2)
            CAD_Topo_FComp.cz = CAD_Store.Read(CAD_Topo_FComp.which, 3)
            CAD_Topo_FComp.rr = CAD_Store.Read(CAD_Topo_FComp.which, 10)
            CAD_Topo_FComp.n2x = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v0, 0), CAD_Topo_FComp.cx)
            CAD_Topo_FComp.n2y = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v0, 1), CAD_Topo_FComp.cy)
            CAD_Topo_FComp.n2z = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v0, 2), CAD_Topo_FComp.cz)
            CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FComp.n2x), CAD_Num.Sq(CAD_Topo_FComp.n2y)), CAD_Num.Sq(CAD_Topo_FComp.n2z)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.n2x = Float_Div(CAD_Topo_FComp.n2x, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.n2y = Float_Div(CAD_Topo_FComp.n2y, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.n2z = Float_Div(CAD_Topo_FComp.n2z, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FComp.wall, CAD_Topo_FComp.e)
            CAD_Topo_FComp.gen = 0
            IfCondition NotEqual(CAD_Topo_FComp.ce, 0) ThenBlock: {
                CAD_Topo_FComp.gen = CAD_Topo.FilletIRFindGen(CAD_Topo_FComp.ce, CAD_Topo_FComp.v0)
            }
            CAD_Topo_FComp.mode = 0
            CAD_Topo_FComp.padh = CAD_Topo_FComp.r
            IfCondition NotEqual(CAD_Topo_FComp.gen, 0) ThenBlock: {
                CAD_Topo_FComp.ok = CAD_Store.Read(CAD_Topo_FComp.gen, 0)
                IfCondition EqualTo(CAD_Topo_FComp.ok, CAD_Topo_FComp.v0) ThenBlock: {
                    CAD_Topo_FComp.ok = CAD_Store.Read(CAD_Topo_FComp.gen, 1)
                }
                IfCondition NotEqual(CAD_Topo_FComp.ok, 0) ThenBlock: {
                    CAD_Topo_FComp.padh = Float_Add(Float_Add(CAD_Num.Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FComp.ok, 0), CAD_Store.Read(CAD_Topo_FComp.v0, 0)), CAD_Topo_FComp.n1x), CAD_Num.Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FComp.ok, 1), CAD_Store.Read(CAD_Topo_FComp.v0, 1)), CAD_Topo_FComp.n1y)), CAD_Num.Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FComp.ok, 2), CAD_Store.Read(CAD_Topo_FComp.v0, 2)), CAD_Topo_FComp.n1z))
                    // Outward N from which side of the host plane the solid
                    // occupies — not gen length (top OD shortens the wall, then
                    // bottom OD was tagged as a boss cove on the sketch plane).
                    // All verts on +N → flip. Both sides (pad) or all on −N → keep.
                    CAD_Topo.FilletIRHostMinMax()
                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.shost), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.srad, 0), 0) ThenBlock: {
                            CAD_Topo_FComp.n1x = Float_Sub(0, CAD_Topo_FComp.n1x)
                            CAD_Topo_FComp.n1y = Float_Sub(0, CAD_Topo_FComp.n1y)
                            CAD_Topo_FComp.n1z = Float_Sub(0, CAD_Topo_FComp.n1z)
                            CAD_Topo_FComp.padh = Float_Sub(0, CAD_Topo_FComp.padh)
                        }
                    }
                    CAD_Topo_FComp.mode = 0
                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.padh), 1) ThenBlock: {
                        CAD_Topo_FComp.mode = 1
                        CAD_Topo_FComp.padh = Float_Sub(0, CAD_Topo_FComp.padh)
                        IfCondition EqualTo(CAD_Topo_FComp.inner, 0) ThenBlock: { CAD_Topo_FComp.mode = 2 }
                    }
                }
            }
            CAD_Topo_FComp.side = 1
            IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: { CAD_Topo_FComp.side = 0 }
            CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 15, 4)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 6, CAD_Topo_FComp.n1x)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 7, CAD_Topo_FComp.n1y)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 8, CAD_Topo_FComp.n1z)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 9, CAD_Topo_FComp.n2x)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 10, CAD_Topo_FComp.n2y)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 11, CAD_Topo_FComp.n2z)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 15, CAD_Topo_FComp.rr)
        }
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 1, CAD_Topo_FComp.kind)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 2, CAD_Topo_FComp.inner)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 3, CAD_Topo_FComp.side)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 4, CAD_Topo_FComp.f1)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 5, CAD_Topo_FComp.f2)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 6, CAD_Topo_FComp.s1)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 7, CAD_Topo_FComp.s2)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 8, CAD_Topo_FComp.px)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 9, CAD_Topo_FComp.py)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 10, CAD_Topo_FComp.pz)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 11, CAD_Topo_FComp.pair)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 19, CAD_Topo_FComp.host)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 20, CAD_Topo_FComp.wall)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 21, CAD_Topo_FComp.mode)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 22, CAD_Topo_FComp.gen)
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 23, CAD_Topo_FComp.v0)
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletAnalyze {
    Output: Integer
    Body: {
        CAD_Topo_FComp.i = 0
        CAD_Topo_FSeq.ok = 1
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletAnalyzeOne(CAD_Topo_FComp.i), 0) ThenBlock: {
                CAD_Topo_FSeq.ok = 0
                PrintMessage("fillet IR analyze miss i=")
                PrintNumber(CAD_Topo_FComp.i)
                PrintMessage("\n")
            }
            IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 11), 2) ThenBlock: {
                CAD_Topo.FilletIRLog(CAD_Topo_FComp.i)
            }
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 11), 2) ThenBlock: {
                PrintMessage("fillet IR pair=other i=")
                PrintNumber(CAD_Topo_FComp.i)
                PrintMessage("\n")
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        ReturnValue(CAD_Topo_FSeq.ok)
    }
}

Function.CAD_Topo.FilletChain {
    Output: Integer
    Body: {
        CAD_Topo_FComp.ok = 1
        WhileLoop EqualTo(CAD_Topo_FComp.ok, 1) {
            CAD_Topo_FComp.ok = 0
            CAD_Topo_FComp.i = 0
            WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
                CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
                CAD_Topo_FComp.v0 = 0
                CAD_Topo_FComp.v1 = 0
                IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                    CAD_Topo_FComp.v0 = CAD_Store.Read(CAD_Topo_FComp.e, 0)
                    CAD_Topo_FComp.v1 = CAD_Store.Read(CAD_Topo_FComp.e, 1)
                }
                CAD_Topo_FComp.j = Add(CAD_Topo_FComp.i, 1)
                WhileLoop LessThan(CAD_Topo_FComp.j, CAD_Topo_FComp.n) {
                    CAD_Topo_FComp.h = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0)
                    CAD_Topo_FComp.s1 = 0
                    CAD_Topo_FComp.s2 = 0
                    IfCondition NotEqual(CAD_Topo_FComp.h, 0) ThenBlock: {
                        CAD_Topo_FComp.s1 = CAD_Store.Read(CAD_Topo_FComp.h, 0)
                        CAD_Topo_FComp.s2 = CAD_Store.Read(CAD_Topo_FComp.h, 1)
                    }
                    CAD_Topo_FComp.which = 0
                    IfCondition EqualTo(CAD_Topo_FComp.v0, CAD_Topo_FComp.s1) ThenBlock: { CAD_Topo_FComp.which = 1 }
                    IfCondition EqualTo(CAD_Topo_FComp.v0, CAD_Topo_FComp.s2) ThenBlock: { CAD_Topo_FComp.which = 1 }
                    IfCondition EqualTo(CAD_Topo_FComp.v1, CAD_Topo_FComp.s1) ThenBlock: { CAD_Topo_FComp.which = 1 }
                    IfCondition EqualTo(CAD_Topo_FComp.v1, CAD_Topo_FComp.s2) ThenBlock: { CAD_Topo_FComp.which = 1 }
                    IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
                        CAD_Topo_FComp.f1 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 12)
                        CAD_Topo_FComp.f2 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 12)
                        IfCondition NotEqual(CAD_Topo_FComp.f1, CAD_Topo_FComp.f2) ThenBlock: {
                            CAD_Topo_FComp.ok = 1
                            IfCondition LessThan(CAD_Topo_FComp.f1, CAD_Topo_FComp.f2) ThenBlock: {
                                CAD_Topo.FilletIRPut(CAD_Topo_FComp.j, 12, CAD_Topo_FComp.f1)
                            }
                            IfCondition LessThan(CAD_Topo_FComp.f2, CAD_Topo_FComp.f1) ThenBlock: {
                                CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 12, CAD_Topo_FComp.f2)
                            }
                        }
                    }
                    CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
                }
                CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
            }
        }
        ReturnValue(1)
    }
}

// Host face of a mixed chain is the pair-1 plane. Tag pair-0 LINEs.
Function.CAD_Topo.FilletIRBindHost {
    Output: Integer
    Body: {
        CAD_Topo_FComp.host = 0
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 11), 1) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19), 0) ThenBlock: {
                    CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_FComp.host, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 11), 0) ThenBlock: {
                CAD_Topo_FComp.f1 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 4)
                CAD_Topo_FComp.f2 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 5)
                IfCondition EqualTo(CAD_Topo_FComp.f1, CAD_Topo_FComp.host) ThenBlock: {
                    CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 19, CAD_Topo_FComp.f1)
                    CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 20, CAD_Topo_FComp.f2)
                }
                IfCondition EqualTo(CAD_Topo_FComp.f2, CAD_Topo_FComp.host) ThenBlock: {
                    CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 19, CAD_Topo_FComp.f2)
                    CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 20, CAD_Topo_FComp.f1)
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletSolveOne {
    Input: idx: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.h = idx
        CAD_Topo_FComp.pair = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 11)
        IfCondition EqualTo(CAD_Topo_FComp.pair, 0) ThenBlock: {
            CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 19)
            CAD_Topo_FComp.wall = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 20)
            IfCondition EqualTo(CAD_Topo_FComp.host, 0) ThenBlock: {
                CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 4)
                CAD_Topo_FComp.wall = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 5)
            }
            IfCondition EqualTo(CAD_Topo_FComp.host, 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(CAD_Topo_FComp.wall, 0) ThenBlock: { ReturnValue(1) }
            CAD_Topo_FComp.px = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 8)
            CAD_Topo_FComp.py = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 9)
            CAD_Topo_FComp.pz = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 10)
            CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 0)
            CAD_Topo_FComp.edx = 0
            CAD_Topo_FComp.edy = 0
            CAD_Topo_FComp.edz = 0
            IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                CAD_Topo_FComp.v0 = CAD_Store.Read(CAD_Topo_FComp.e, 0)
                CAD_Topo_FComp.v1 = CAD_Store.Read(CAD_Topo_FComp.e, 1)
                IfCondition NotEqual(CAD_Topo_FComp.v0, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FComp.v1, 0) ThenBlock: {
                        CAD_Topo_FComp.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v1, 0), CAD_Store.Read(CAD_Topo_FComp.v0, 0))
                        CAD_Topo_FComp.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v1, 1), CAD_Store.Read(CAD_Topo_FComp.v0, 1))
                        CAD_Topo_FComp.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v1, 2), CAD_Store.Read(CAD_Topo_FComp.v0, 2))
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo.FilletFaceN(CAD_Topo_FComp.host), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.n1x = CAD_Topo_FComp.n2x
            CAD_Topo_FComp.n1y = CAD_Topo_FComp.n2y
            CAD_Topo_FComp.n1z = CAD_Topo_FComp.n2z
            IfCondition EqualTo(CAD_Topo.FilletFaceN(CAD_Topo_FComp.wall), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.ok = CAD_Topo.FilletIRFaceKind(CAD_Topo_FComp.host)
            CAD_Topo_FComp.k = CAD_Topo.FilletIRFaceKind(CAD_Topo_FComp.wall)
            IfCondition NotEqual(CAD_Topo_FComp.ok, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FComp.k, 1) ThenBlock: {
                    CAD_Topo_FComp.xx = CAD_Topo_FComp.n1x
                    CAD_Topo_FComp.xy = CAD_Topo_FComp.n1y
                    CAD_Topo_FComp.xz = CAD_Topo_FComp.n1z
                    CAD_Topo_FComp.n1x = CAD_Topo_FComp.n2x
                    CAD_Topo_FComp.n1y = CAD_Topo_FComp.n2y
                    CAD_Topo_FComp.n1z = CAD_Topo_FComp.n2z
                    CAD_Topo_FComp.n2x = CAD_Topo_FComp.xx
                    CAD_Topo_FComp.n2y = CAD_Topo_FComp.xy
                    CAD_Topo_FComp.n2z = CAD_Topo_FComp.xz
                    CAD_Topo_FComp.xx = CAD_Topo_FComp.host
                    CAD_Topo_FComp.host = CAD_Topo_FComp.wall
                    CAD_Topo_FComp.wall = CAD_Topo_FComp.xx
                }
            }
            CAD_Topo_FComp.aa = CAD_Num.Abs(CAD_Topo_FComp.n1z)
            CAD_Topo_FComp.bb = CAD_Num.Abs(CAD_Topo_FComp.n2z)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.aa, CAD_Topo_FComp.bb)), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.Le(0x3FE0000000000000, CAD_Topo_FComp.bb), 1) ThenBlock: {
                CAD_Topo_FComp.xx = CAD_Topo_FComp.n1x
                CAD_Topo_FComp.xy = CAD_Topo_FComp.n1y
                CAD_Topo_FComp.xz = CAD_Topo_FComp.n1z
                CAD_Topo_FComp.n1x = CAD_Topo_FComp.n2x
                CAD_Topo_FComp.n1y = CAD_Topo_FComp.n2y
                CAD_Topo_FComp.n1z = CAD_Topo_FComp.n2z
                CAD_Topo_FComp.n2x = CAD_Topo_FComp.xx
                CAD_Topo_FComp.n2y = CAD_Topo_FComp.xy
                CAD_Topo_FComp.n2z = CAD_Topo_FComp.xz
                CAD_Topo_FComp.xx = CAD_Topo_FComp.host
                CAD_Topo_FComp.host = CAD_Topo_FComp.wall
                CAD_Topo_FComp.wall = CAD_Topo_FComp.xx
                }
            }
            CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 19, CAD_Topo_FComp.host)
            CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 20, CAD_Topo_FComp.wall)
            CAD_Topo_FComp.px = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 8)
            CAD_Topo_FComp.py = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 9)
            CAD_Topo_FComp.pz = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 10)
            CAD_Topo_FComp.padh = 0
            CAD_Topo.FilletIRHostMinMax()
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.shost), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.srad, 0), 0) ThenBlock: {
                    CAD_Topo_FComp.n1x = Float_Sub(0, CAD_Topo_FComp.n1x)
                    CAD_Topo_FComp.n1y = Float_Sub(0, CAD_Topo_FComp.n1y)
                    CAD_Topo_FComp.n1z = Float_Sub(0, CAD_Topo_FComp.n1z)
                }
            }
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 6, CAD_Topo_FComp.n1x)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 7, CAD_Topo_FComp.n1y)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 8, CAD_Topo_FComp.n1z)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 9, CAD_Topo_FComp.n2x)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 10, CAD_Topo_FComp.n2y)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 11, CAD_Topo_FComp.n2z)
            CAD_Topo_FComp.shost = Float_Sub(0, CAD_Topo_FComp.r)
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 3), 0) ThenBlock: {
                CAD_Topo_FComp.shost = CAD_Topo_FComp.r
            }
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 13, CAD_Topo_FComp.shost)
            CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 14, CAD_Topo_FComp.shost)
            CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 15, 2)
            ReturnValue(1)
        }
        IfCondition NotEqual(CAD_Topo_FComp.pair, 1) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FComp.px = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 8)
        CAD_Topo_FComp.py = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 9)
        CAD_Topo_FComp.pz = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 10)
        CAD_Topo_FComp.n1x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 6)
        CAD_Topo_FComp.n1y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 7)
        CAD_Topo_FComp.n1z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 8)
        CAD_Topo_FComp.n2x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 9)
        CAD_Topo_FComp.n2y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 10)
        CAD_Topo_FComp.n2z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 11)
        CAD_Topo_FComp.rr = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.h, 15)
        CAD_Topo_FComp.mode = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 21)
        CAD_Topo_FComp.shost = Float_Sub(0, CAD_Topo_FComp.r)
        CAD_Topo_FComp.srad = CAD_Topo_FComp.r
        CAD_Topo_FComp.rmaj = Float_Add(CAD_Topo_FComp.rr, CAD_Topo_FComp.r)
        IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: {
            CAD_Topo_FComp.shost = CAD_Topo_FComp.r
        }
        IfCondition EqualTo(CAD_Topo_FComp.mode, 2) ThenBlock: {
            CAD_Topo_FComp.srad = Float_Sub(0, CAD_Topo_FComp.r)
            CAD_Topo_FComp.rmaj = Float_Sub(CAD_Topo_FComp.rr, CAD_Topo_FComp.r)
        }
        IfCondition EqualTo(CAD_Topo_FComp.mode, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FComp.rr, CAD_Topo_FComp.r), 1) ThenBlock: {
                CAD_Topo_State.fillet_reason = 6
                PrintMessage("fillet IR R>=r OD\n")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FComp.rr, CAD_Topo_FComp.r), 1) ThenBlock: {
                CAD_Topo_State.fillet_reason = 6
                PrintMessage("fillet IR R>=r cove\n")
                ReturnValue(0)
            }
        }
        CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 0, Float_Add(CAD_Topo_FComp.px, CAD_Num.Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2x)))
        CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 1, Float_Add(CAD_Topo_FComp.py, CAD_Num.Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2y)))
        CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 2, Float_Add(CAD_Topo_FComp.pz, CAD_Num.Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2z)))
        CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 3, Float_Add(CAD_Topo_FComp.px, CAD_Num.Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1x)))
        CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 4, Float_Add(CAD_Topo_FComp.py, CAD_Num.Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1y)))
        CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 5, Float_Add(CAD_Topo_FComp.pz, CAD_Num.Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1z)))
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 16, Float_Add(Float_Add(CAD_Topo_FComp.px, CAD_Num.Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1x)), CAD_Num.Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2x)))
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 17, Float_Add(Float_Add(CAD_Topo_FComp.py, CAD_Num.Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1y)), CAD_Num.Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2y)))
        CAD_Topo.FilletIRPut(CAD_Topo_FComp.h, 18, Float_Add(Float_Add(CAD_Topo_FComp.pz, CAD_Num.Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1z)), CAD_Num.Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2z)))
        CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 12, CAD_Topo_FComp.rmaj)
        CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 13, CAD_Topo_FComp.shost)
        CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.h, 14, CAD_Topo_FComp.srad)
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletSolve {
    Output: Integer
    Body: {
        CAD_Topo_FComp.i = 0
        CAD_Topo_FComp.ok = 1
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletSolveOne(CAD_Topo_FComp.i), 0) ThenBlock: {
                CAD_Topo_FComp.ok = 0
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        CAD_Topo_FComp.n3x = 0
        CAD_Topo_FComp.n3y = 0
        CAD_Topo_FComp.n3z = 0
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.k, 11), 1) ThenBlock: {
                CAD_Topo_FComp.n3x = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.k, 6)
                CAD_Topo_FComp.n3y = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.k, 7)
                CAD_Topo_FComp.n3z = CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.k, 8)
            }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n3x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n3y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.n3z, CAD_Topo_FComp.n3z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 0) ThenBlock: {
            CAD_Topo_FComp.k = 0
            WhileLoop LessThan(CAD_Topo_FComp.k, CAD_Topo_FComp.n) {
                IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.k, 11), 0) ThenBlock: {
                    CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.k, 6, CAD_Topo_FComp.n3x)
                    CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.k, 7, CAD_Topo_FComp.n3y)
                    CAD_Topo.FilletIRSolPut(CAD_Topo_FComp.k, 8, CAD_Topo_FComp.n3z)
                }
                CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
            }
        }
        CAD_Topo_FComp.ce = CAD_Topo_FComp.ok
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, CAD_Topo_FComp.n) {
            CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.k, 0)
            IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FilletIRVert2Face(CAD_Topo_FComp.k, CAD_Store.Read(CAD_Topo_FComp.e, 0)), 1) ThenBlock: {
                    CAD_Topo.FilletIRVSolAt(CAD_Topo_FComp.k, CAD_Store.Read(CAD_Topo_FComp.e, 0))
                }
                IfCondition EqualTo(CAD_Topo.FilletIRVert2Face(CAD_Topo_FComp.k, CAD_Store.Read(CAD_Topo_FComp.e, 1)), 1) ThenBlock: {
                    CAD_Topo.FilletIRVSolAt(CAD_Topo_FComp.k, CAD_Store.Read(CAD_Topo_FComp.e, 1))
                }
            }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        ReturnValue(CAD_Topo_FComp.ce)
    }
}

// 1 iff the three supporting faces are planes. Gram 3-face needs that.
Function.CAD_Topo.FilletIRVertBallable {
    Input: host_f: Integer
    Input: wall_prev: Integer
    Input: wall_this: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo.FilletIRFaceKind(host_f), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FilletIRFaceKind(wall_prev), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FilletIRFaceKind(wall_this), 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

// 2-face at vertex vh from the compiled edge solve. T_host → px,py,pz; T_wall → cx,cy,cz.
Function.CAD_Topo.FilletIRVert2Face {
    Input: idx: Integer
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.n1x = CAD_Topo.FilletIRSolGet(idx, 6)
        CAD_Topo_FComp.n1y = CAD_Topo.FilletIRSolGet(idx, 7)
        CAD_Topo_FComp.n1z = CAD_Topo.FilletIRSolGet(idx, 8)
        CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n1x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n1y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.pair = CAD_Topo.FilletIRGet(idx, 11)
        IfCondition EqualTo(CAD_Topo_FComp.pair, 0) ThenBlock: {
            CAD_Topo_FComp.n2x = CAD_Topo.FilletIRSolGet(idx, 9)
            CAD_Topo_FComp.n2y = CAD_Topo.FilletIRSolGet(idx, 10)
            CAD_Topo_FComp.n2z = CAD_Topo.FilletIRSolGet(idx, 11)
            CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(idx, 0)
            IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FComp.xyz, 0) ThenBlock: {
                    CAD_Topo_FComp.v0 = CAD_Store.Read(CAD_Topo_FComp.e, 0)
                    CAD_Topo_FComp.v1 = CAD_Store.Read(CAD_Topo_FComp.e, 1)
                    IfCondition NotEqual(CAD_Topo_FComp.v0, 0) ThenBlock: {
                        IfCondition NotEqual(CAD_Topo_FComp.v1, 0) ThenBlock: {
                            CAD_Topo_FComp.ab = 0x3FE0000000000000
                            ArraySet(CAD_Topo_FComp.xyz, 0, Float_Add(Float_Mul(0x3FE0000000000000, Float_Add(CAD_Store.Read(CAD_Topo_FComp.v0, 0), CAD_Store.Read(CAD_Topo_FComp.v1, 0))), Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n2x)))
                            ArraySet(CAD_Topo_FComp.xyz, 1, Float_Add(Float_Mul(0x3FE0000000000000, Float_Add(CAD_Store.Read(CAD_Topo_FComp.v0, 1), CAD_Store.Read(CAD_Topo_FComp.v1, 1))), Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n2y)))
                            ArraySet(CAD_Topo_FComp.xyz, 2, Float_Add(Float_Mul(0x3FE0000000000000, Float_Add(CAD_Store.Read(CAD_Topo_FComp.v0, 2), CAD_Store.Read(CAD_Topo_FComp.v1, 2))), Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n2z)))
                            IfCondition EqualTo(CAD_Topo.PointInSolid(CAD_Topo_FComp.solid, CAD_Topo_FComp.xyz), 1) ThenBlock: {
                                CAD_Topo_FComp.n2x = Float_Sub(0, CAD_Topo_FComp.n2x)
                                CAD_Topo_FComp.n2y = Float_Sub(0, CAD_Topo_FComp.n2y)
                                CAD_Topo_FComp.n2z = Float_Sub(0, CAD_Topo_FComp.n2z)
                            }
                        }
                    }
                }
            }
            CAD_Topo_FComp.ab = Float_Add(0x3FF0000000000000, Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n2z)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ab, 0), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.ab = Float_Div(CAD_Topo_FComp.r, CAD_Topo_FComp.ab)
            CAD_Topo_FComp.ln = CAD_Topo_FComp.r
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FComp.ln = Float_Sub(0, CAD_Topo_FComp.r) }
            CAD_Topo_FComp.cx = Float_Sub(CAD_Store.Read(vh, 0), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n2x)))
            CAD_Topo_FComp.cy = Float_Sub(CAD_Store.Read(vh, 1), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n2y)))
            CAD_Topo_FComp.cz = Float_Sub(CAD_Store.Read(vh, 2), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n2z)))
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
                CAD_Topo_FComp.cx = Float_Add(CAD_Store.Read(vh, 0), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n2x)))
                CAD_Topo_FComp.cy = Float_Add(CAD_Store.Read(vh, 1), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n2y)))
                CAD_Topo_FComp.cz = Float_Add(CAD_Store.Read(vh, 2), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n2z)))
            }
            CAD_Topo_FComp.px = Float_Add(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n1x))
            CAD_Topo_FComp.py = Float_Add(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n1y))
            CAD_Topo_FComp.pz = Float_Add(CAD_Topo_FComp.cz, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n1z))
            CAD_Topo_FComp.xx = CAD_Topo_FComp.cx
            CAD_Topo_FComp.xy = CAD_Topo_FComp.cy
            CAD_Topo_FComp.xz = CAD_Topo_FComp.cz
            CAD_Topo_FComp.cx = Float_Add(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n2x))
            CAD_Topo_FComp.cy = Float_Add(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n2y))
            CAD_Topo_FComp.cz = Float_Add(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n2z))
            CAD_Topo_FComp.aa = Float_Sub(CAD_Topo_FComp.px, CAD_Store.Read(vh, 0))
            CAD_Topo_FComp.bb = Float_Sub(CAD_Topo_FComp.py, CAD_Store.Read(vh, 1))
            CAD_Topo_FComp.refuse = Float_Sub(CAD_Topo_FComp.pz, CAD_Store.Read(vh, 2))
            CAD_Topo_FComp.aa = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.aa, CAD_Topo_FComp.aa), Float_Mul(CAD_Topo_FComp.bb, CAD_Topo_FComp.bb)), Float_Mul(CAD_Topo_FComp.refuse, CAD_Topo_FComp.refuse)))
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Mul(0x4010000000000000, CAD_Topo_FComp.r), CAD_Topo_FComp.aa)), 1) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        IfCondition EqualTo(CAD_Topo_FComp.pair, 1) ThenBlock: {
            CAD_Topo_FComp.shost = CAD_Topo.FilletIRSolGet(idx, 13)
            CAD_Topo_FComp.srad = CAD_Topo.FilletIRSolGet(idx, 14)
            CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(idx, 0)
            IfCondition EqualTo(CAD_Topo_FComp.e, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FComp.e, 2)
            IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.n2x = Float_Sub(CAD_Store.Read(vh, 0), CAD_Store.Read(CAD_Topo_FComp.which, 1))
            CAD_Topo_FComp.n2y = Float_Sub(CAD_Store.Read(vh, 1), CAD_Store.Read(CAD_Topo_FComp.which, 2))
            CAD_Topo_FComp.n2z = Float_Sub(CAD_Store.Read(vh, 2), CAD_Store.Read(CAD_Topo_FComp.which, 3))
            CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n2z)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.n2x = Float_Div(CAD_Topo_FComp.n2x, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.n2y = Float_Div(CAD_Topo_FComp.n2y, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.n2z = Float_Div(CAD_Topo_FComp.n2z, CAD_Topo_FComp.ln)
            CAD_Topo_FComp.px = Float_Add(CAD_Store.Read(vh, 0), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2x))
            CAD_Topo_FComp.py = Float_Add(CAD_Store.Read(vh, 1), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2y))
            CAD_Topo_FComp.pz = Float_Add(CAD_Store.Read(vh, 2), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2z))
            CAD_Topo_FComp.cx = Float_Add(CAD_Store.Read(vh, 0), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1x))
            CAD_Topo_FComp.cy = Float_Add(CAD_Store.Read(vh, 1), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1y))
            CAD_Topo_FComp.cz = Float_Add(CAD_Store.Read(vh, 2), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1z))
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Store T_host (px) and T_wall (cx) at vh into vsol start or end of idx.
Function.CAD_Topo.FilletIRVSolAt {
    Input: idx: Integer
    Input: vh: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(idx, 0)
        CAD_Topo_FComp.ok = 0
        IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.e, 0), vh) ThenBlock: { CAD_Topo_FComp.ok = 0 }
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FComp.e, 0), vh) ThenBlock: { CAD_Topo_FComp.ok = 6 }
        }
        CAD_Topo.FilletIRVSolPut(idx, CAD_Topo_FComp.ok, CAD_Topo_FComp.px)
        CAD_Topo.FilletIRVSolPut(idx, Add(CAD_Topo_FComp.ok, 1), CAD_Topo_FComp.py)
        CAD_Topo.FilletIRVSolPut(idx, Add(CAD_Topo_FComp.ok, 2), CAD_Topo_FComp.pz)
        CAD_Topo.FilletIRVSolPut(idx, Add(CAD_Topo_FComp.ok, 3), CAD_Topo_FComp.cx)
        CAD_Topo.FilletIRVSolPut(idx, Add(CAD_Topo_FComp.ok, 4), CAD_Topo_FComp.cy)
        CAD_Topo.FilletIRVSolPut(idx, Add(CAD_Topo_FComp.ok, 5), CAD_Topo_FComp.cz)
        IfCondition EqualTo(CAD_Topo_FComp.ok, 0) ThenBlock: { CAD_Topo.FilletIRVSolPut(idx, 14, 1) }
        IfCondition EqualTo(CAD_Topo_FComp.ok, 6) ThenBlock: { CAD_Topo.FilletIRVSolPut(idx, 15, 1) }
        ReturnValue(1)
    }
}

// Per chain-vertex: 2-face start/end from compiled edge solve, Gram if 3 planes.
Function.CAD_Topo.FilletSolveVert {
    Output: Integer
    Body: {
        CAD_Topo_FComp.wall = 0
        CAD_Topo_FComp.gen = 0
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.k, 11), 1) ThenBlock: { CAD_Topo_FComp.gen = 1 }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            CAD_Topo_FComp.j = Add(CAD_Topo_FComp.i, 1)
            WhileLoop LessThan(CAD_Topo_FComp.j, CAD_Topo_FComp.n) {
                IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 12), CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 12)) ThenBlock: {
                    CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
                    CAD_Topo_FComp.h = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0)
                    CAD_Topo_FComp.v0 = 0
                    CAD_Topo_FComp.v1 = 0
                    CAD_Topo_FComp.s1 = 0
                    CAD_Topo_FComp.s2 = 0
                    IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                        CAD_Topo_FComp.v0 = CAD_Store.Read(CAD_Topo_FComp.e, 0)
                        CAD_Topo_FComp.v1 = CAD_Store.Read(CAD_Topo_FComp.e, 1)
                    }
                    IfCondition NotEqual(CAD_Topo_FComp.h, 0) ThenBlock: {
                        CAD_Topo_FComp.s1 = CAD_Store.Read(CAD_Topo_FComp.h, 0)
                        CAD_Topo_FComp.s2 = CAD_Store.Read(CAD_Topo_FComp.h, 1)
                    }
                    CAD_Topo_FComp.which = 0
                    CAD_Topo_FComp.padh = 0
                    IfCondition EqualTo(CAD_Topo_FComp.v0, CAD_Topo_FComp.s1) ThenBlock: {
                        CAD_Topo_FComp.which = 1
                        CAD_Topo_FComp.padh = CAD_Topo_FComp.v0
                    }
                    IfCondition EqualTo(CAD_Topo_FComp.v0, CAD_Topo_FComp.s2) ThenBlock: {
                        CAD_Topo_FComp.which = 1
                        CAD_Topo_FComp.padh = CAD_Topo_FComp.v0
                    }
                    IfCondition EqualTo(CAD_Topo_FComp.v1, CAD_Topo_FComp.s1) ThenBlock: {
                        CAD_Topo_FComp.which = 1
                        CAD_Topo_FComp.padh = CAD_Topo_FComp.v1
                    }
                    IfCondition EqualTo(CAD_Topo_FComp.v1, CAD_Topo_FComp.s2) ThenBlock: {
                        CAD_Topo_FComp.which = 1
                        CAD_Topo_FComp.padh = CAD_Topo_FComp.v1
                    }
                    IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
                        IfCondition NotEqual(CAD_Topo_FComp.padh, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.FilletIRVert2Face(CAD_Topo_FComp.i, CAD_Topo_FComp.padh), 1) ThenBlock: {
                                CAD_Topo.FilletIRVSolAt(CAD_Topo_FComp.i, CAD_Topo_FComp.padh)
                                CAD_Topo_FComp.edx = CAD_Topo_FComp.n2x
                                CAD_Topo_FComp.edy = CAD_Topo_FComp.n2y
                                CAD_Topo_FComp.edz = CAD_Topo_FComp.n2z
                                CAD_Topo_FComp.yx = CAD_Topo_FComp.px
                                CAD_Topo_FComp.yy = CAD_Topo_FComp.py
                                CAD_Topo_FComp.yz = CAD_Topo_FComp.pz
                            }
                        }
                        IfCondition NotEqual(CAD_Topo_FComp.padh, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo.FilletIRVert2Face(CAD_Topo_FComp.j, CAD_Topo_FComp.padh), 1) ThenBlock: {
                                CAD_Topo.FilletIRVSolAt(CAD_Topo_FComp.j, CAD_Topo_FComp.padh)
                            }
                        }
                        CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
                        IfCondition EqualTo(CAD_Topo_FComp.host, 0) ThenBlock: {
                            CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 19)
                        }
                        CAD_Topo_FComp.f1 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 20)
                        CAD_Topo_FComp.f2 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 20)
                        CAD_Topo_FComp.ok = 0
                        IfCondition NotEqual(CAD_Topo_FComp.f1, 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Topo_FComp.f2, 0) ThenBlock: {
                                CAD_Topo_FComp.ok = CAD_Topo.FilletIRVertBallable(CAD_Topo_FComp.host, CAD_Topo_FComp.f1, CAD_Topo_FComp.f2)
                            }
                        }
                        IfCondition EqualTo(CAD_Topo_FComp.ok, 1) ThenBlock: {
                            CAD_Topo_FComp.n3x = CAD_Topo_FComp.n2x
                            CAD_Topo_FComp.n3y = CAD_Topo_FComp.n2y
                            CAD_Topo_FComp.n3z = CAD_Topo_FComp.n2z
                            CAD_Topo_FComp.n2x = CAD_Topo_FComp.edx
                            CAD_Topo_FComp.n2y = CAD_Topo_FComp.edy
                            CAD_Topo_FComp.n2z = CAD_Topo_FComp.edz
                            CAD_Topo_FComp.s = Float_Sub(0, CAD_Topo_FComp.r)
                            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FComp.s = CAD_Topo_FComp.r }
                            CAD_Topo_FComp.shost = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n2z))
                            CAD_Topo_FComp.srad = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n3z))
                            CAD_Topo_FComp.rmaj = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n3z))
                            CAD_Topo_FComp.ln = 0x3FF0000000000000
                            CAD_Topo_FComp.ln = Float_Sub(CAD_Topo_FComp.ln, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.shost))
                            CAD_Topo_FComp.ln = Float_Sub(CAD_Topo_FComp.ln, Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.srad))
                            CAD_Topo_FComp.ln = Float_Sub(CAD_Topo_FComp.ln, Float_Mul(CAD_Topo_FComp.rmaj, CAD_Topo_FComp.rmaj))
                            CAD_Topo_FComp.ln = Float_Add(CAD_Topo_FComp.ln, Float_Mul(0x4000000000000000, Float_Mul(CAD_Topo_FComp.shost, Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.rmaj))))
                            CAD_Topo_FComp.refuse = CAD_Topo_FComp.rmaj
                            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.refuse), 1) ThenBlock: { CAD_Topo_FComp.refuse = Float_Sub(0, CAD_Topo_FComp.refuse) }
                            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Topo_FComp.refuse, 0x3FF0000000000000, 0), 1) ThenBlock: { CAD_Topo_FComp.ln = 0 }
                            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { CAD_Topo_FComp.ok = 0 }
                            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 0) ThenBlock: {
                                CAD_Topo_FComp.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FComp.shost), CAD_Topo_FComp.srad)
                                CAD_Topo_FComp.bb = Float_Sub(Float_Add(CAD_Topo_FComp.shost, CAD_Topo_FComp.srad), CAD_Topo_FComp.rmaj)
                                CAD_Topo_FComp.ab = Float_Div(Float_Mul(CAD_Topo_FComp.s, Float_Add(CAD_Topo_FComp.aa, Float_Mul(CAD_Topo_FComp.rmaj, CAD_Topo_FComp.bb))), CAD_Topo_FComp.ln)
                                CAD_Topo_FComp.cx = Float_Add(CAD_Store.Read(CAD_Topo_FComp.padh, 0), Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n1x))
                                CAD_Topo_FComp.cy = Float_Add(CAD_Store.Read(CAD_Topo_FComp.padh, 1), Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n1y))
                                CAD_Topo_FComp.cz = Float_Add(CAD_Store.Read(CAD_Topo_FComp.padh, 2), Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n1z))
                                CAD_Topo_FComp.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FComp.shost), CAD_Topo_FComp.rmaj)
                                CAD_Topo_FComp.bb = Float_Sub(Float_Add(CAD_Topo_FComp.shost, CAD_Topo_FComp.rmaj), CAD_Topo_FComp.srad)
                                CAD_Topo_FComp.ab = Float_Div(Float_Mul(CAD_Topo_FComp.s, Float_Add(CAD_Topo_FComp.aa, Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.bb))), CAD_Topo_FComp.ln)
                                CAD_Topo_FComp.cx = Float_Add(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n2x))
                                CAD_Topo_FComp.cy = Float_Add(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n2y))
                                CAD_Topo_FComp.cz = Float_Add(CAD_Topo_FComp.cz, Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n2z))
                                CAD_Topo_FComp.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FComp.srad), CAD_Topo_FComp.rmaj)
                                CAD_Topo_FComp.bb = Float_Sub(Float_Add(CAD_Topo_FComp.srad, CAD_Topo_FComp.rmaj), CAD_Topo_FComp.shost)
                                CAD_Topo_FComp.ab = Float_Div(Float_Mul(CAD_Topo_FComp.s, Float_Add(CAD_Topo_FComp.aa, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.bb))), CAD_Topo_FComp.ln)
                                CAD_Topo_FComp.cx = Float_Add(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n3x))
                                CAD_Topo_FComp.cy = Float_Add(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n3y))
                                CAD_Topo_FComp.cz = Float_Add(CAD_Topo_FComp.cz, Float_Mul(CAD_Topo_FComp.ab, CAD_Topo_FComp.n3z))
                                CAD_Topo_FComp.px = Float_Sub(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n1x))
                                CAD_Topo_FComp.py = Float_Sub(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n1y))
                                CAD_Topo_FComp.pz = Float_Sub(CAD_Topo_FComp.cz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n1z))
                                CAD_Topo_FComp.aa = Float_Sub(CAD_Topo_FComp.px, CAD_Store.Read(CAD_Topo_FComp.padh, 0))
                                CAD_Topo_FComp.bb = Float_Sub(CAD_Topo_FComp.py, CAD_Store.Read(CAD_Topo_FComp.padh, 1))
                                CAD_Topo_FComp.refuse = Float_Sub(CAD_Topo_FComp.pz, CAD_Store.Read(CAD_Topo_FComp.padh, 2))
                                CAD_Topo_FComp.aa = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.aa, CAD_Topo_FComp.aa), Float_Mul(CAD_Topo_FComp.bb, CAD_Topo_FComp.bb)), Float_Mul(CAD_Topo_FComp.refuse, CAD_Topo_FComp.refuse)))
                                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Mul(0x4010000000000000, CAD_Topo_FComp.r), CAD_Topo_FComp.aa)), 1) ThenBlock: {
                                    CAD_Topo_FComp.ok = 0
                                }
                                IfCondition EqualTo(CAD_Topo_FComp.ok, 1) ThenBlock: {
                                CAD_Topo_FComp.xx = CAD_Topo_FComp.cx
                                CAD_Topo_FComp.xy = CAD_Topo_FComp.cy
                                CAD_Topo_FComp.xz = CAD_Topo_FComp.cz
                                CAD_Topo_FComp.cx = Float_Sub(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2x))
                                CAD_Topo_FComp.cy = Float_Sub(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2y))
                                CAD_Topo_FComp.cz = Float_Sub(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2z))
                                CAD_Topo.FilletIRVSolAt(CAD_Topo_FComp.i, CAD_Topo_FComp.padh)
                                CAD_Topo_FComp.cx = Float_Sub(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n3x))
                                CAD_Topo_FComp.cy = Float_Sub(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n3y))
                                CAD_Topo_FComp.cz = Float_Sub(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n3z))
                                CAD_Topo.FilletIRVSolAt(CAD_Topo_FComp.j, CAD_Topo_FComp.padh)
                                CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.e, 0), CAD_Topo_FComp.padh) ThenBlock: {
                                    CAD_Topo.FilletIRVSolPut(CAD_Topo_FComp.i, 12, 1)
                                }
                                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FComp.e, 0), CAD_Topo_FComp.padh) ThenBlock: {
                                    CAD_Topo.FilletIRVSolPut(CAD_Topo_FComp.i, 13, 1)
                                }
                                CAD_Topo_FComp.h = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0)
                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.h, 0), CAD_Topo_FComp.padh) ThenBlock: {
                                    CAD_Topo.FilletIRVSolPut(CAD_Topo_FComp.j, 12, 1)
                                }
                                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FComp.h, 0), CAD_Topo_FComp.padh) ThenBlock: {
                                    CAD_Topo.FilletIRVSolPut(CAD_Topo_FComp.j, 13, 1)
                                }
                                }
                            }
                        }
                        IfCondition EqualTo(CAD_Topo_FComp.ok, 0) ThenBlock: {
                            CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
                            CAD_Topo_FComp.s = 0
                            IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FComp.e, 0), CAD_Topo_FComp.padh) ThenBlock: { CAD_Topo_FComp.s = 6 }
                            }
                            CAD_Topo_FComp.h = CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 0)
                            CAD_Topo_FComp.aa = 0
                            IfCondition NotEqual(CAD_Topo_FComp.h, 0) ThenBlock: {
                                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FComp.h, 0), CAD_Topo_FComp.padh) ThenBlock: { CAD_Topo_FComp.aa = 6 }
                            }
                            CAD_Topo_FComp.xx = CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, CAD_Topo_FComp.s)
                            CAD_Topo_FComp.xy = CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, Add(CAD_Topo_FComp.s, 1))
                            CAD_Topo_FComp.xz = CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, Add(CAD_Topo_FComp.s, 2))
                            CAD_Topo_FComp.px = CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.j, CAD_Topo_FComp.aa)
                            CAD_Topo_FComp.py = CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.j, Add(CAD_Topo_FComp.aa, 1))
                            CAD_Topo_FComp.pz = CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.j, Add(CAD_Topo_FComp.aa, 2))
                            CAD_Topo_FComp.edx = Float_Sub(CAD_Topo_FComp.px, CAD_Topo_FComp.xx)
                            CAD_Topo_FComp.edy = Float_Sub(CAD_Topo_FComp.py, CAD_Topo_FComp.xy)
                            CAD_Topo_FComp.edz = Float_Sub(CAD_Topo_FComp.pz, CAD_Topo_FComp.xz)
                            CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.edx, CAD_Topo_FComp.edx), Float_Mul(CAD_Topo_FComp.edy, CAD_Topo_FComp.edy)), Float_Mul(CAD_Topo_FComp.edz, CAD_Topo_FComp.edz)))
                            PrintMessage("fillet IR miss=")
                            PrintNumber(Float_ToInt(CAD_Topo_FComp.ln))
                            PrintMessage("\n")
                            IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FComp.r, CAD_Topo_FComp.ln), 1) ThenBlock: {
                                CAD_Topo_FComp.wall = 1
                            }
                        }
                        PrintMessage("fillet IR vert i=")
                        PrintNumber(CAD_Topo_FComp.i)
                        PrintMessage(" j=")
                        PrintNumber(CAD_Topo_FComp.j)
                        PrintMessage(" pair=")
                        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 11))
                        PrintMessage(",")
                        PrintNumber(CAD_Topo.FilletIRGet(CAD_Topo_FComp.j, 11))
                        PrintMessage(" ball=")
                        PrintNumber(CAD_Topo_FComp.ok)
                        PrintMessage(" Th=")
                        PrintNumber(Float_ToInt(CAD_Topo_FComp.px))
                        PrintMessage(",")
                        PrintNumber(Float_ToInt(CAD_Topo_FComp.py))
                        PrintMessage("\n")
                    }
                }
                CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_FComp.wall, 1) ThenBlock: {
            CAD_Topo_State.fillet_reason = 11
            PrintMessage("fillet IR traces miss >R\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// ASCII math log: /tmp/cad_app/fillet_math.log  (microns = mm*1000)
Function.CAD_Topo.FilletDumpOpen {
    Output: Integer
    Body: {
        IfCondition GreaterThan(CAD_Topo_FComp.mfd, 0) ThenBlock: {
            CAD_Sys.Close(CAD_Topo_FComp.mfd)
            CAD_Topo_FComp.mfd = 0
        }
        CAD_Topo_FComp.mfd = CAD_Sys.Open("/tmp/cad_app/fillet_math.log", 577, 420)
        IfCondition LessThan(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo_FComp.mfd = 0 }
        ReturnValue(CAD_Topo_FComp.mfd)
    }
}

Function.CAD_Topo.FilletDumpS {
    Input: msg: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(CAD_Topo_FComp.mfd, 0) ThenBlock: {
            CAD_Sys.Write(CAD_Topo_FComp.mfd, msg, n)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.FilletDumpI {
    Input: msg: Address
    Input: nmsg: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        CAD_Topo.FilletDumpS(msg, nmsg)
        PrintMessage(msg)
        PrintNumber(val)
        CAD_Topo_FComp.ok = val
        CAD_Topo_FComp.k = 0
        IfCondition LessThan(CAD_Topo_FComp.ok, 0) ThenBlock: {
            CAD_Topo.FilletDumpS("-", 1)
            CAD_Topo_FComp.ok = Subtract(0, CAD_Topo_FComp.ok)
        }
        db = Allocate(32)
        IfCondition EqualTo(CAD_Topo_FComp.ok, 0) ThenBlock: {
            SetByte(db, 0, 48)
            CAD_Topo_FComp.k = 1
        }
        WhileLoop GreaterThan(CAD_Topo_FComp.ok, 0) {
            SetByte(db, CAD_Topo_FComp.k, Add(48, Modulo(CAD_Topo_FComp.ok, 10)))
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
            CAD_Topo_FComp.ok = Divide(CAD_Topo_FComp.ok, 10)
        }
        CAD_Topo_FComp.j = Subtract(CAD_Topo_FComp.k, 1)
        WhileLoop GreaterEqual(CAD_Topo_FComp.j, 0) {
            CAD_Topo.FilletDumpS(Add(db, CAD_Topo_FComp.j), 1)
            CAD_Topo_FComp.j = Subtract(CAD_Topo_FComp.j, 1)
        }
        Deallocate(db, 32)
        CAD_Topo.FilletDumpS(" ", 1)
        PrintMessage(" ")
        ReturnValue(0)
    }
}

Function.CAD_Topo.FilletDumpU {
    Input: msg: Address
    Input: nmsg: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Topo.FilletDumpI(msg, nmsg, Float_ToInt(Float_Mul(val, 0x408F400000000000))))
    }
}

Function.CAD_Topo.FilletDumpIR {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: {
            CAD_Topo.FilletDumpOpen()
        }
        CAD_Topo.FilletDumpS("FMM SOLVE\n", 10)
        PrintMessage("FMM SOLVE\n")
        CAD_Topo.FilletDumpI("n=", 2, CAD_Topo_FComp.n)
        CAD_Topo.FilletDumpU(" R_um=", 6, CAD_Topo_FComp.r)
        CAD_Topo.FilletDumpI(" conc=", 6, CAD_Topo_State.fillet_concave)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            CAD_Topo.FilletDumpI("e", 1, CAD_Topo_FComp.i)
            CAD_Topo.FilletDumpI(" kind=", 6, CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 1))
            CAD_Topo.FilletDumpI(" pair=", 6, CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 11))
            CAD_Topo.FilletDumpI(" inner=", 7, CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 2))
            CAD_Topo.FilletDumpI(" side=", 6, CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 3))
            CAD_Topo.FilletDumpI(" mode=", 6, CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 21))
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            CAD_Topo.FilletDumpU("  P=", 4, CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 8))
            CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 9))
            CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 10))
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            CAD_Topo.FilletDumpU("  Nh=", 5, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 6))
            CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 7))
            CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 8))
            CAD_Topo.FilletDumpU(" Nw=", 4, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 9))
            CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 10))
            CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 11))
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            CAD_Topo.FilletDumpU("  Tmid=", 7, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 3))
            CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 4))
            CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 5))
            CAD_Topo.FilletDumpU(" Rmaj=", 6, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 12))
            CAD_Topo.FilletDumpU(" sh=", 4, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 13))
            CAD_Topo.FilletDumpU(" sr=", 4, CAD_Topo.FilletIRSolGet(CAD_Topo_FComp.i, 14))
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 0)
            CAD_Topo_FComp.v0 = 0
            CAD_Topo_FComp.v1 = 0
            IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
                CAD_Topo_FComp.v0 = CAD_Store.Read(CAD_Topo_FComp.e, 0)
                CAD_Topo_FComp.v1 = CAD_Store.Read(CAD_Topo_FComp.e, 1)
            }
            IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 14), 1) ThenBlock: {
                CAD_Topo.FilletDumpI("  start ok gram=", 16, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 12))
                IfCondition NotEqual(CAD_Topo_FComp.v0, 0) ThenBlock: {
                    CAD_Topo.FilletDumpU(" V=", 3, CAD_Store.Read(CAD_Topo_FComp.v0, 0))
                    CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FComp.v0, 1))
                    CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FComp.v0, 2))
                }
                CAD_Topo.FilletDumpU(" Th=", 4, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 0))
                CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 1))
                CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 2))
                CAD_Topo.FilletDumpU(" Tw=", 4, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 3))
                CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 4))
                CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 5))
                IfCondition NotEqual(CAD_Topo_FComp.v0, 0) ThenBlock: {
                    CAD_Topo_FComp.px = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 0), CAD_Store.Read(CAD_Topo_FComp.v0, 0))
                    CAD_Topo_FComp.py = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 1), CAD_Store.Read(CAD_Topo_FComp.v0, 1))
                    CAD_Topo_FComp.pz = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 2), CAD_Store.Read(CAD_Topo_FComp.v0, 2))
                    CAD_Topo.FilletDumpU(" dTh=", 5, CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.px, CAD_Topo_FComp.px), Float_Mul(CAD_Topo_FComp.py, CAD_Topo_FComp.py)), Float_Mul(CAD_Topo_FComp.pz, CAD_Topo_FComp.pz))))
                }
                CAD_Topo.FilletDumpS("\n", 1)
                PrintMessage("\n")
            }
            IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 15), 1) ThenBlock: {
                CAD_Topo.FilletDumpI("  end ok gram=", 14, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 13))
                IfCondition NotEqual(CAD_Topo_FComp.v1, 0) ThenBlock: {
                    CAD_Topo.FilletDumpU(" V=", 3, CAD_Store.Read(CAD_Topo_FComp.v1, 0))
                    CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FComp.v1, 1))
                    CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FComp.v1, 2))
                }
                CAD_Topo.FilletDumpU(" Th=", 4, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 6))
                CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 7))
                CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 8))
                CAD_Topo.FilletDumpU(" Tw=", 4, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 9))
                CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 10))
                CAD_Topo.FilletDumpU(",", 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 11))
                IfCondition NotEqual(CAD_Topo_FComp.v1, 0) ThenBlock: {
                    CAD_Topo_FComp.px = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 6), CAD_Store.Read(CAD_Topo_FComp.v1, 0))
                    CAD_Topo_FComp.py = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 7), CAD_Store.Read(CAD_Topo_FComp.v1, 1))
                    CAD_Topo_FComp.pz = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.i, 8), CAD_Store.Read(CAD_Topo_FComp.v1, 2))
                    CAD_Topo.FilletDumpU(" dTh=", 5, CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.px, CAD_Topo_FComp.px), Float_Mul(CAD_Topo_FComp.py, CAD_Topo_FComp.py)), Float_Mul(CAD_Topo_FComp.pz, CAD_Topo_FComp.pz))))
                }
                CAD_Topo.FilletDumpS("\n", 1)
                PrintMessage("\n")
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletDumpEmit {
    Output: Integer
    Body: {
        CAD_Topo.FilletDumpS("FMM EMIT\n", 9)
        PrintMessage("FMM EMIT\n")
        IfCondition EqualTo(CAD_Topo_FCove.buf, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FilletDumpI("n=", 2, CAD_Topo_FCove.n)
        CAD_Topo.FilletDumpU(" R_um=", 6, CAD_Topo_FCove.r)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo.FilletDumpI("v", 1, CAD_Topo_FCove.i)
            CAD_Topo.FilletDumpI(" kind=", 6, CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i))
            CAD_Topo.FilletDumpI(" conv=", 6, CAD_Topo.FCoveGet(36, CAD_Topo_FCove.i))
            CAD_Topo.FilletDumpI(" gram=", 6, CAD_Topo.FCoveGet(384, CAD_Topo_FCove.i))
            CAD_Topo.FilletDumpI(" blend=", 7, CAD_Topo.FCoveGet(420, CAD_Topo_FCove.i))
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.v0, 0) ThenBlock: {
                CAD_Topo.FilletDumpU("  V=", 4, CAD_Store.Read(CAD_Topo_FCove.v0, 0))
                CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FCove.v0, 1))
                CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FCove.v0, 2))
            }
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                CAD_Topo.FilletDumpU(" Th=", 4, CAD_Store.Read(CAD_Topo_FCove.ok, 0))
                CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FCove.ok, 1))
                CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FCove.ok, 2))
            }
            CAD_Topo_FCove.hit = CAD_Topo.FCoveGet(408, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.hit, 0) ThenBlock: {
                CAD_Topo.FilletDumpU(" Tp=", 4, CAD_Store.Read(CAD_Topo_FCove.hit, 0))
                CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FCove.hit, 1))
                CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FCove.hit, 2))
            }
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
                CAD_Topo.FilletDumpU("  Tw=", 5, CAD_Store.Read(CAD_Topo_FCove.orig, 0))
                CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FCove.orig, 1))
                CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FCove.orig, 2))
            }
            CAD_Topo_FCove.which = CAD_Topo.FCoveGet(390, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                CAD_Topo.FilletDumpU(" Tpw=", 5, CAD_Store.Read(CAD_Topo_FCove.which, 0))
                CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FCove.which, 1))
                CAD_Topo.FilletDumpU(",", 1, CAD_Store.Read(CAD_Topo_FCove.which, 2))
            }
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            IfCondition NotEqual(CAD_Topo_FCove.v0, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                    CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0))
                    CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1))
                    CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2))
                    CAD_Topo.FilletDumpU("  dTh=", 6, CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz))))
                }
                IfCondition NotEqual(CAD_Topo_FCove.hit, 0) ThenBlock: {
                    CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.hit, 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0))
                    CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.hit, 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1))
                    CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.hit, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2))
                    CAD_Topo.FilletDumpU(" dTp=", 5, CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz))))
                }
            }
            IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.hit, 0) ThenBlock: {
                    CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 0), CAD_Store.Read(CAD_Topo_FCove.hit, 0))
                    CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 1), CAD_Store.Read(CAD_Topo_FCove.hit, 1))
                    CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 2), CAD_Store.Read(CAD_Topo_FCove.hit, 2))
                    CAD_Topo.FilletDumpU(" gap=", 5, CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz))))
                }
            }
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                    CAD_Topo.FilletDumpU(" span=", 6, CAD_Store.Read(CAD_Topo_FCove.which, 12))
                    CAD_Topo.FilletDumpU(" rad=", 5, CAD_Store.Read(CAD_Topo_FCove.which, 10))
                }
            }
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletDumpClose {
    Output: Integer
    Body: {
        IfCondition GreaterThan(CAD_Topo_FComp.mfd, 0) ThenBlock: {
            CAD_Sys.Close(CAD_Topo_FComp.mfd)
            CAD_Topo_FComp.mfd = 0
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.FilletCompile {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_edges, 64) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletParseSel(solid_handle, edges_addr, n_edges, radius_r), 0) ThenBlock: {
            PrintMessage("fillet IR parse fail\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.FilletAnalyze(), 0) ThenBlock: {
            PrintMessage("fillet IR analyze fail\n")
            ReturnValue(0)
        }
        CAD_Topo.FilletChain()
        CAD_Topo.FilletIRBindHost()
        IfCondition EqualTo(CAD_Topo.FilletSolve(), 0) ThenBlock: {
            PrintMessage("fillet IR solve fail\n")
            CAD_Topo.FilletDumpIR()
            ReturnValue(0)
        }
        CAD_Topo.FilletDumpIR()
        IfCondition EqualTo(CAD_Topo.FilletSolveVert(), 0) ThenBlock: {
            PrintMessage("fillet IR vert fail\n")
            CAD_Topo.FilletDumpIR()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.FilletSolve(), 0) ThenBlock: {
            PrintMessage("fillet IR resolve fail\n")
            CAD_Topo.FilletDumpIR()
            ReturnValue(0)
        }
        CAD_Topo.FilletDumpIR()
        ReturnValue(1)
    }
}
