LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Err
LibraryImport.Cad.CAD_Sys

Function.CAD_Topo.FilletIREnsure {
    Output: Integer
    Body: {
        // 64 edges. Stride 24 / 16 / 16 qwords. 4096 held 21 slab rows
        // and 2048 held 16 sol rows, so edge 16 wrote into vsol.
        IfCondition EqualTo(CAD_Topo_FComp.slab, 0) ThenBlock: { CAD_Topo_FComp.slab = Allocate(12288) }
        IfCondition EqualTo(CAD_Topo_FComp.sol, 0) ThenBlock: { CAD_Topo_FComp.sol = Allocate(8192) }
        IfCondition EqualTo(CAD_Topo_FComp.vsol, 0) ThenBlock: { CAD_Topo_FComp.vsol = Allocate(8192) }
        IfCondition EqualTo(CAD_Topo_FComp.faces, 0) ThenBlock: { CAD_Topo_FComp.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FComp.pl, 0) ThenBlock: { CAD_Topo_FComp.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FComp.xyz, 0) ThenBlock: { CAD_Topo_FComp.xyz = Allocate(256) }
        IfCondition EqualTo(CAD_Topo_FComp.grp, 0) ThenBlock: { CAD_Topo_FComp.grp = Allocate(2048) }
        IfCondition EqualTo(CAD_Topo_FComp.left, 0) ThenBlock: { CAD_Topo_FComp.left = Allocate(512) }
        IfCondition EqualTo(CAD_Topo_FComp.slab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.sol, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.vsol, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.faces, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.grp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.left, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletIRPut {
    Input: idx: Integer
    Input: slot: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        ArraySet(CAD_Topo_FComp.slab, Add(Multiply(idx, 24), slot), val)
        ReturnValue(val)
    }
}

Function.CAD_Topo.FilletIRGet {
    Input: idx: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        ReturnValue(ArrayGet(CAD_Topo_FComp.slab, Add(Multiply(idx, 24), slot)))
    }
}

Function.CAD_Topo.FilletIRSolPut {
    Input: idx: Integer
    Input: slot: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        ArraySet(CAD_Topo_FComp.sol, Add(Multiply(idx, 16), slot), val)
        ReturnValue(val)
    }
}

Function.CAD_Topo.FilletIRSolGet {
    Input: idx: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        ReturnValue(ArrayGet(CAD_Topo_FComp.sol, Add(Multiply(idx, 16), slot)))
    }
}

Function.CAD_Topo.FilletIRVSolPut {
    Input: idx: Integer
    Input: slot: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        ArraySet(CAD_Topo_FComp.vsol, Add(Multiply(idx, 16), slot), val)
        ReturnValue(val)
    }
}

Function.CAD_Topo.FilletIRVSolGet {
    Input: idx: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        ReturnValue(ArrayGet(CAD_Topo_FComp.vsol, Add(Multiply(idx, 16), slot)))
    }
}

Function.CAD_Topo.FilletIRFaceKind {
    Input: face_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.which = CAD_Store.Read(face_handle, 0)
        IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(CAD_Topo_FComp.which, 0))
    }
}

// min/max signed distance of solid verts from host plane (P, N_host).
// shost=min srad=max. Walk temps: rmaj/xx/xy/xz/yx. Not i/h/ok/kind/pair.
Function.CAD_Topo.FilletIRHostMinMax {
    Output: Integer
    Body: {
        CAD_Topo_FComp.shost = CAD_Topo_FComp.padh
        CAD_Topo_FComp.srad = CAD_Topo_FComp.padh
        CAD_Topo_FComp.ce = CAD_Store.Read(CAD_Topo_FComp.solid, 0)
        CAD_Topo_FComp.k = 0
        WhileLoop NotEqual(CAD_Topo_FComp.ce, 0) {
            IfCondition GreaterThan(CAD_Topo_FComp.k, 64) ThenBlock: { CAD_Topo_FComp.ce = 0 }
            IfCondition NotEqual(CAD_Topo_FComp.ce, 0) ThenBlock: {
                CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FComp.ce, 0)
                CAD_Topo_FComp.j = 0
                WhileLoop NotEqual(CAD_Topo_FComp.which, 0) {
                    IfCondition GreaterThan(CAD_Topo_FComp.j, 256) ThenBlock: { CAD_Topo_FComp.which = 0 }
                    IfCondition NotEqual(CAD_Topo_FComp.which, 0) ThenBlock: {
                        CAD_Topo_FComp.rmaj = CAD_Store.Read(CAD_Topo_FComp.which, 1)
                        CAD_Topo_FComp.refuse = 0
                        WhileLoop NotEqual(CAD_Topo_FComp.rmaj, 0) {
                            IfCondition GreaterThan(CAD_Topo_FComp.refuse, 8) ThenBlock: { CAD_Topo_FComp.rmaj = 0 }
                            IfCondition NotEqual(CAD_Topo_FComp.rmaj, 0) ThenBlock: {
                                CAD_Topo_FComp.xx = CAD_Store.Read(CAD_Topo_FComp.rmaj, 0)
                                CAD_Topo_FComp.xy = CAD_Topo_FComp.xx
                                CAD_Topo_FComp.xz = 0
                                WhileLoop LessThan(CAD_Topo_FComp.xz, 256) {
                                    IfCondition EqualTo(CAD_Topo_FComp.xy, 0) ThenBlock: { CAD_Topo_FComp.xz = 256 }
                                    IfCondition NotEqual(CAD_Topo_FComp.xy, 0) ThenBlock: {
                                        CAD_Topo_FComp.yx = CAD_Store.Read(CAD_Topo_FComp.xy, 5)
                                        IfCondition NotEqual(CAD_Topo_FComp.yx, 0) ThenBlock: {
                                            CAD_Topo_FComp.yy = Float_Add(Float_Add(CAD_Num.Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FComp.yx, 0), CAD_Topo_FComp.px), CAD_Topo_FComp.n1x), CAD_Num.Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FComp.yx, 1), CAD_Topo_FComp.py), CAD_Topo_FComp.n1y)), CAD_Num.Mul(Float_Sub(CAD_Store.Read(CAD_Topo_FComp.yx, 2), CAD_Topo_FComp.pz), CAD_Topo_FComp.n1z))
                                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.yy, CAD_Topo_FComp.shost)), 1) ThenBlock: {
                                                CAD_Topo_FComp.shost = CAD_Topo_FComp.yy
                                            }
                                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.srad, CAD_Topo_FComp.yy)), 1) ThenBlock: {
                                                CAD_Topo_FComp.srad = CAD_Topo_FComp.yy
                                            }
                                        }
                                        CAD_Topo_FComp.xy = CAD_Store.Read(CAD_Topo_FComp.xy, 2)
                                        IfCondition EqualTo(CAD_Topo_FComp.xy, CAD_Topo_FComp.xx) ThenBlock: { CAD_Topo_FComp.xz = 256 }
                                    }
                                    CAD_Topo_FComp.xz = Add(CAD_Topo_FComp.xz, 1)
                                }
                                CAD_Topo_FComp.rmaj = CAD_Store.Read(CAD_Topo_FComp.rmaj, 2)
                            }
                            CAD_Topo_FComp.refuse = Add(CAD_Topo_FComp.refuse, 1)
                        }
                        CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FComp.which, 3)
                    }
                    CAD_Topo_FComp.j = Add(CAD_Topo_FComp.j, 1)
                }
                CAD_Topo_FComp.ce = CAD_Store.Read(CAD_Topo_FComp.ce, 2)
            }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletIRIndexOf {
    Input: edge_handle: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.k, 0), edge_handle) ThenBlock: {
                ReturnValue(CAD_Topo_FComp.k)
            }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        ReturnValue(Subtract(0, 1))
    }
}

// LINE on the wall face incident to the rim vertex.
Function.CAD_Topo.FilletIRFindGen {
    Input: start_ce: Integer
    Input: v_join: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.ce = start_ce
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, 6) {
            CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FComp.ce, 0)
            IfCondition NotEqual(CAD_Topo_FComp.which, 0) ThenBlock: {
                CAD_Topo_FComp.ln = CAD_Store.Read(CAD_Topo_FComp.which, 2)
                IfCondition NotEqual(CAD_Topo_FComp.ln, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.ln, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.which, 0), v_join) ThenBlock: {
                            ReturnValue(CAD_Topo_FComp.which)
                        }
                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.which, 1), v_join) ThenBlock: {
                            ReturnValue(CAD_Topo_FComp.which)
                        }
                    }
                }
            }
            CAD_Topo_FComp.ce = CAD_Store.Read(CAD_Topo_FComp.ce, 2)
            IfCondition EqualTo(CAD_Topo_FComp.ce, 0) ThenBlock: { CAD_Topo_FComp.k = 6 }
            IfCondition EqualTo(CAD_Topo_FComp.ce, start_ce) ThenBlock: { CAD_Topo_FComp.k = 6 }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        ReturnValue(0)
    }
}

// Right-handed XY from Z = N_host (n1*). Writes xx..yz.
Function.CAD_Topo.FilletIRBasis {
    Output: Integer
    Body: {
        CAD_Topo_FComp.ok = 1
        CAD_Topo_FComp.ln = CAD_Num.Abs(CAD_Topo_FComp.n1z)
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.ln, CAD_Num.Abs(CAD_Topo_FComp.n1x))), 1) ThenBlock: {
            CAD_Topo_FComp.ok = 0
        }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.ln, CAD_Num.Abs(CAD_Topo_FComp.n1y))), 1) ThenBlock: {
            CAD_Topo_FComp.ok = 0
        }
        // H helper: (0,0,1) unless N is already ±Z, then (1,0,0). Temps shost/srad/rmaj.
        CAD_Topo_FComp.shost = 0
        CAD_Topo_FComp.srad = 0
        CAD_Topo_FComp.rmaj = 0x3FF0000000000000
        IfCondition EqualTo(CAD_Topo_FComp.ok, 1) ThenBlock: {
            CAD_Topo_FComp.shost = 0x3FF0000000000000
            CAD_Topo_FComp.srad = 0
            CAD_Topo_FComp.rmaj = 0
        }
        // X = N × H
        CAD_Topo_FComp.xx = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.rmaj), CAD_Num.Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.srad))
        CAD_Topo_FComp.xy = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.shost), CAD_Num.Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.rmaj))
        CAD_Topo_FComp.xz = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.srad), CAD_Num.Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.shost))
        CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(CAD_Num.Sq(CAD_Topo_FComp.xx), CAD_Num.Sq(CAD_Topo_FComp.xy)), CAD_Num.Sq(CAD_Topo_FComp.xz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.xx = Float_Div(CAD_Topo_FComp.xx, CAD_Topo_FComp.ln)
        CAD_Topo_FComp.xy = Float_Div(CAD_Topo_FComp.xy, CAD_Topo_FComp.ln)
        CAD_Topo_FComp.xz = Float_Div(CAD_Topo_FComp.xz, CAD_Topo_FComp.ln)
        // Y = N × X
        CAD_Topo_FComp.yx = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.xz), CAD_Num.Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.xy))
        CAD_Topo_FComp.yy = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.xx), CAD_Num.Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.xz))
        CAD_Topo_FComp.yz = Float_Sub(CAD_Num.Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.xy), CAD_Num.Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.xx))
        ReturnValue(1)
    }
}

// Host face of a mixed chain is the pair-1 plane. Tag pair-0 LINEs.
Function.CAD_Topo.FilletIRBindHost {
    Output: Integer
    Body: {
        CAD_Topo_FComp.host = 0
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 11), 1) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19), 0) ThenBlock: {
                    CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 19)
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_FComp.host, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FComp.i = 0
        WhileLoop LessThan(CAD_Topo_FComp.i, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 11), 0) ThenBlock: {
                CAD_Topo_FComp.f1 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 4)
                CAD_Topo_FComp.f2 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.i, 5)
                IfCondition EqualTo(CAD_Topo_FComp.f1, CAD_Topo_FComp.host) ThenBlock: {
                    CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 19, CAD_Topo_FComp.f1)
                    CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 20, CAD_Topo_FComp.f2)
                }
                IfCondition EqualTo(CAD_Topo_FComp.f2, CAD_Topo_FComp.host) ThenBlock: {
                    CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 19, CAD_Topo_FComp.f2)
                    CAD_Topo.FilletIRPut(CAD_Topo_FComp.i, 20, CAD_Topo_FComp.f1)
                }
            }
            CAD_Topo_FComp.i = Add(CAD_Topo_FComp.i, 1)
        }
        ReturnValue(1)
    }
}

// Open rail (one selected edge at vh): clip Th-line to the blocking face
// (plane or cylinder). Same for any blocker — not a box+arc recipe.
Function.CAD_Topo.FilletIRClipThToBlock {
    Input: idx: Integer
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Topo.FilletIRCountAt(vh), 1) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FComp.gen = CAD_Topo.FilletPlexBlockingFace(CAD_Topo_FComp.solid, vh, CAD_Topo.FilletIRGet(idx, 4), CAD_Topo.FilletIRGet(idx, 5))
        IfCondition EqualTo(CAD_Topo_FComp.gen, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(idx, 0)
        IfCondition EqualTo(CAD_Topo_FComp.e, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FComp.v0 = CAD_Store.Read(CAD_Topo_FComp.e, 0)
        CAD_Topo_FComp.v1 = CAD_Store.Read(CAD_Topo_FComp.e, 1)
        CAD_Topo_FComp.edx = 0
        CAD_Topo_FComp.edy = 0
        CAD_Topo_FComp.edz = 0
        IfCondition EqualTo(CAD_Topo_FComp.v0, vh) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_FComp.v1, 0) ThenBlock: {
                CAD_Topo_FComp.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v1, 0), CAD_Store.Read(vh, 0))
                CAD_Topo_FComp.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v1, 1), CAD_Store.Read(vh, 1))
                CAD_Topo_FComp.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v1, 2), CAD_Store.Read(vh, 2))
            }
        }
        IfCondition EqualTo(CAD_Topo_FComp.v1, vh) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_FComp.v0, 0) ThenBlock: {
                CAD_Topo_FComp.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v0, 0), CAD_Store.Read(vh, 0))
                CAD_Topo_FComp.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v0, 1), CAD_Store.Read(vh, 1))
                CAD_Topo_FComp.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.v0, 2), CAD_Store.Read(vh, 2))
            }
        }
        CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FComp.gen, 0)
        IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FComp.kind = CAD_Store.Read(CAD_Topo_FComp.which, 0)
        IfCondition NotEqual(CAD_Topo_FComp.kind, 2) ThenBlock: {
            CAD_Topo_FComp.ce = 0
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FComp.gen, 1), 0) ThenBlock: {
                CAD_Topo_FComp.ce = CAD_Store.Read(CAD_Store.Read(CAD_Topo_FComp.gen, 1), 0)
            }
            CAD_Topo_FComp.hd = CAD_Topo_FComp.ce
            CAD_Topo_FCE.g = 0
            WhileLoop LessThan(CAD_Topo_FCE.g, 64) {
                IfCondition EqualTo(CAD_Topo_FComp.ce, 0) ThenBlock: { CAD_Topo_FCE.g = 64 }
                IfCondition NotEqual(CAD_Topo_FComp.ce, 0) ThenBlock: {
                    CAD_Topo_FComp.ok = CAD_Store.Read(CAD_Topo_FComp.ce, 0)
                    IfCondition NotEqual(CAD_Topo_FComp.ok, 0) ThenBlock: {
                        CAD_Topo_FComp.ok = CAD_Store.Read(CAD_Topo_FComp.ok, 2)
                        IfCondition NotEqual(CAD_Topo_FComp.ok, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.ok, 0), 2) ThenBlock: {
                                CAD_Topo_FComp.which = CAD_Topo_FComp.ok
                                CAD_Topo_FComp.kind = 2
                                CAD_Topo_FCE.g = 64
                            }
                        }
                    }
                    CAD_Topo_FComp.ce = CAD_Store.Read(CAD_Topo_FComp.ce, 2)
                    IfCondition EqualTo(CAD_Topo_FComp.ce, CAD_Topo_FComp.hd) ThenBlock: { CAD_Topo_FCE.g = 64 }
                }
                CAD_Topo_FCE.g = Add(CAD_Topo_FCE.g, 1)
            }
        }
        CAD_Topo_FComp.s = 0
        IfCondition EqualTo(CAD_Topo_FComp.kind, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_FComp.gen, CAD_Topo_FComp.pl), 0) ThenBlock: {
                CAD_Topo_FComp.n3x = ArrayGet(CAD_Topo_FComp.pl, 10)
                CAD_Topo_FComp.n3y = ArrayGet(CAD_Topo_FComp.pl, 11)
                CAD_Topo_FComp.n3z = ArrayGet(CAD_Topo_FComp.pl, 12)
                CAD_Topo_FComp.ln = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.edx, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.edy, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.edz, CAD_Topo_FComp.n3z))
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 0) ThenBlock: {
                    CAD_Topo_FComp.aa = Float_Add(Float_Add(Float_Mul(Float_Sub(ArrayGet(CAD_Topo_FComp.pl, 1), CAD_Topo_FComp.px), CAD_Topo_FComp.n3x), Float_Mul(Float_Sub(ArrayGet(CAD_Topo_FComp.pl, 2), CAD_Topo_FComp.py), CAD_Topo_FComp.n3y)), Float_Mul(Float_Sub(ArrayGet(CAD_Topo_FComp.pl, 3), CAD_Topo_FComp.pz), CAD_Topo_FComp.n3z))
                    CAD_Topo_FComp.s = Float_Div(CAD_Topo_FComp.aa, CAD_Topo_FComp.ln)
                }
            }
        }
        IfCondition EqualTo(CAD_Topo_FComp.kind, 2) ThenBlock: {
            CAD_Topo_FComp.yx = CAD_Store.Read(CAD_Topo_FComp.which, 1)
            CAD_Topo_FComp.yy = CAD_Store.Read(CAD_Topo_FComp.which, 2)
            CAD_Topo_FComp.rr = CAD_Store.Read(CAD_Topo_FComp.which, 13)
            CAD_Topo_FComp.aa = Float_Add(Float_Mul(CAD_Topo_FComp.edx, CAD_Topo_FComp.edx), Float_Mul(CAD_Topo_FComp.edy, CAD_Topo_FComp.edy))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.aa, 0), 0) ThenBlock: {
                CAD_Topo_FComp.n3x = Float_Sub(CAD_Topo_FComp.px, CAD_Topo_FComp.yx)
                CAD_Topo_FComp.n3y = Float_Sub(CAD_Topo_FComp.py, CAD_Topo_FComp.yy)
                CAD_Topo_FComp.bb = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(CAD_Topo_FComp.n3x, CAD_Topo_FComp.edx), Float_Mul(CAD_Topo_FComp.n3y, CAD_Topo_FComp.edy)))
                CAD_Topo_FComp.refuse = Float_Sub(Float_Add(Float_Mul(CAD_Topo_FComp.n3x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n3y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.rr))
                CAD_Topo_FComp.ln = Float_Sub(Float_Mul(CAD_Topo_FComp.bb, CAD_Topo_FComp.bb), Float_Mul(0x4010000000000000, Float_Mul(CAD_Topo_FComp.aa, CAD_Topo_FComp.refuse)))
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.ln), 0) ThenBlock: {
                    CAD_Topo_FComp.ln = CAD_Num.Sqrt(CAD_Topo_FComp.ln)
                    CAD_Topo_FComp.s = Float_Div(Float_Sub(Float_Sub(0, CAD_Topo_FComp.bb), CAD_Topo_FComp.ln), Float_Mul(0x4000000000000000, CAD_Topo_FComp.aa))
                    CAD_Topo_FComp.ab = Float_Div(Float_Add(Float_Sub(0, CAD_Topo_FComp.bb), CAD_Topo_FComp.ln), Float_Mul(0x4000000000000000, CAD_Topo_FComp.aa))
                    CAD_Topo_FComp.n3z = CAD_Topo_FComp.s
                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.s), 1) ThenBlock: { CAD_Topo_FComp.n3z = Float_Sub(0, CAD_Topo_FComp.s) }
                    CAD_Topo_FComp.padh = CAD_Topo_FComp.ab
                    IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.ab), 1) ThenBlock: { CAD_Topo_FComp.padh = Float_Sub(0, CAD_Topo_FComp.ab) }
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.padh, CAD_Topo_FComp.n3z)), 1) ThenBlock: { CAD_Topo_FComp.s = CAD_Topo_FComp.ab }
                }
            }
        }
        CAD_Topo_FComp.aa = CAD_Topo_FComp.s
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.aa), 1) ThenBlock: { CAD_Topo_FComp.aa = Float_Sub(0, CAD_Topo_FComp.aa) }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.s, 0), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.aa, 0x4000000000000000)), 1) ThenBlock: {
                CAD_Topo_FComp.px = Float_Add(CAD_Topo_FComp.px, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.edx))
                CAD_Topo_FComp.py = Float_Add(CAD_Topo_FComp.py, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.edy))
                CAD_Topo_FComp.pz = Float_Add(CAD_Topo_FComp.pz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.edz))
                CAD_Topo_FComp.cx = Float_Add(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.edx))
                CAD_Topo_FComp.cy = Float_Add(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.edy))
                CAD_Topo_FComp.cz = Float_Add(CAD_Topo_FComp.cz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.edz))
                PrintMessage("fillet plex clip rail idx=")
                PrintNumber(idx)
                PrintMessage("\n")
            }
        }
        ReturnValue(1)
    }
}

// 1 iff the three supporting faces are planes. Gram 3-face needs that.
Function.CAD_Topo.FilletIRVertBallable {
    Input: host_f: Integer
    Input: wall_prev: Integer
    Input: wall_this: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.k = CAD_Topo.FilletIRFaceKind(host_f)
        IfCondition NotEqual(CAD_Topo_FComp.k, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.k = CAD_Topo.FilletIRFaceKind(wall_prev)
        IfCondition NotEqual(CAD_Topo_FComp.k, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.k = CAD_Topo.FilletIRFaceKind(wall_this)
        IfCondition NotEqual(CAD_Topo_FComp.k, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Unit n2 in place. Sqrt stays in this small function so it cannot
// smash Vert2Face's vertex handle.
Function.CAD_Topo.FilletIRUnitN2 {
    Output: Integer
    Body: {
        CAD_Topo_FComp.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.n2x = Float_Div(CAD_Topo_FComp.n2x, CAD_Topo_FComp.ln)
        CAD_Topo_FComp.n2y = Float_Div(CAD_Topo_FComp.n2y, CAD_Topo_FComp.ln)
        CAD_Topo_FComp.n2z = Float_Div(CAD_Topo_FComp.n2z, CAD_Topo_FComp.ln)
        ReturnValue(1)
    }
}

// 2-face at vertex vh from the compiled edge solve. T_host → px,py,pz; T_wall → cx,cy,cz.
Function.CAD_Topo.FilletIRVert2Face {
    Input: idx: Integer
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.n1x = CAD_Topo.FilletIRSolGet(idx, 6)
        CAD_Topo_FComp.n1y = CAD_Topo.FilletIRSolGet(idx, 7)
        CAD_Topo_FComp.n1z = CAD_Topo.FilletIRSolGet(idx, 8)
        CAD_Topo_FComp.ln = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n1x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n1y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n1z))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.pair = CAD_Topo.FilletIRGet(idx, 11)
        IfCondition EqualTo(CAD_Topo_FComp.pair, 0) ThenBlock: {
            CAD_Topo_FComp.n2x = CAD_Topo.FilletIRSolGet(idx, 9)
            CAD_Topo_FComp.n2y = CAD_Topo.FilletIRSolGet(idx, 10)
            CAD_Topo_FComp.n2z = CAD_Topo.FilletIRSolGet(idx, 11)
            // Plane wall only. PointInSolid's ray skips the inside
            // cylinder and flips a correct outward wall. A cylinder
            // radial stays as stored: flipping it fillets a G1 vertical.
            // The wall face must not go in FComp.e. FilletSolve reads
            // the edge from that field again after this returns.
            wf = CAD_Topo.FilletIRGet(idx, 20)
            IfCondition EqualTo(CAD_Topo.FilletIRFaceKind(wf), 1) ThenBlock: {
                wf = CAD_Topo.FilletIRGet(idx, 20)
                IfCondition EqualTo(CAD_Topo.FilletIRInward(wf), 1) ThenBlock: {
                    CAD_Topo_FComp.n2x = Float_Sub(0, CAD_Topo_FComp.n2x)
                    CAD_Topo_FComp.n2y = Float_Sub(0, CAD_Topo_FComp.n2y)
                    CAD_Topo_FComp.n2z = Float_Sub(0, CAD_Topo_FComp.n2z)
                }
            }
            CAD_Topo_FComp.ab = Float_Add(0x3FF0000000000000, Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n2z)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ab, 0), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.ab = Float_Div(CAD_Topo_FComp.r, CAD_Topo_FComp.ab)
            CAD_Topo_FComp.ln = CAD_Topo_FComp.r
            CAD_Topo_FComp.side = CAD_Topo.FilletIRGet(idx, 3)
            IfCondition EqualTo(CAD_Topo_FComp.side, 0) ThenBlock: { CAD_Topo_FComp.ln = Float_Sub(0, CAD_Topo_FComp.r) }
            CAD_Topo_FComp.cx = Float_Sub(CAD_Store.Read(vh, 0), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n2x)))
            CAD_Topo_FComp.cy = Float_Sub(CAD_Store.Read(vh, 1), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n2y)))
            CAD_Topo_FComp.cz = Float_Sub(CAD_Store.Read(vh, 2), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n2z)))
            IfCondition EqualTo(CAD_Topo_FComp.side, 0) ThenBlock: {
                CAD_Topo_FComp.cx = Float_Add(CAD_Store.Read(vh, 0), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n2x)))
                CAD_Topo_FComp.cy = Float_Add(CAD_Store.Read(vh, 1), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n2y)))
                CAD_Topo_FComp.cz = Float_Add(CAD_Store.Read(vh, 2), Float_Mul(CAD_Topo_FComp.ab, Float_Add(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n2z)))
            }
            CAD_Topo_FComp.px = Float_Add(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n1x))
            CAD_Topo_FComp.py = Float_Add(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n1y))
            CAD_Topo_FComp.pz = Float_Add(CAD_Topo_FComp.cz, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n1z))
            CAD_Topo_FComp.xx = CAD_Topo_FComp.cx
            CAD_Topo_FComp.xy = CAD_Topo_FComp.cy
            CAD_Topo_FComp.xz = CAD_Topo_FComp.cz
            CAD_Topo_FComp.cx = Float_Add(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n2x))
            CAD_Topo_FComp.cy = Float_Add(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n2y))
            CAD_Topo_FComp.cz = Float_Add(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n2z))
            CAD_Topo_FComp.aa = Float_Sub(CAD_Topo_FComp.px, CAD_Store.Read(vh, 0))
            CAD_Topo_FComp.bb = Float_Sub(CAD_Topo_FComp.py, CAD_Store.Read(vh, 1))
            CAD_Topo_FComp.refuse = Float_Sub(CAD_Topo_FComp.pz, CAD_Store.Read(vh, 2))
            CAD_Topo_FComp.aa = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.aa, CAD_Topo_FComp.aa), Float_Mul(CAD_Topo_FComp.bb, CAD_Topo_FComp.bb)), Float_Mul(CAD_Topo_FComp.refuse, CAD_Topo_FComp.refuse))
            CAD_Topo_FComp.bb = Float_Mul(0x4010000000000000, CAD_Topo_FComp.r)
            CAD_Topo_FComp.bb = Float_Mul(CAD_Topo_FComp.bb, CAD_Topo_FComp.bb)
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_FComp.bb, CAD_Topo_FComp.aa)), 1) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        IfCondition EqualTo(CAD_Topo_FComp.pair, 1) ThenBlock: {
            CAD_Topo_FComp.shost = CAD_Topo.FilletIRSolGet(idx, 13)
            CAD_Topo_FComp.srad = CAD_Topo.FilletIRSolGet(idx, 14)
            CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(idx, 0)
            IfCondition EqualTo(CAD_Topo_FComp.e, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FComp.e, 2)
            IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.n2x = Float_Sub(CAD_Store.Read(vh, 0), CAD_Store.Read(CAD_Topo_FComp.which, 1))
            CAD_Topo_FComp.n2y = Float_Sub(CAD_Store.Read(vh, 1), CAD_Store.Read(CAD_Topo_FComp.which, 2))
            CAD_Topo_FComp.n2z = Float_Sub(CAD_Store.Read(vh, 2), CAD_Store.Read(CAD_Topo_FComp.which, 3))
            IfCondition EqualTo(CAD_Topo.FilletIRUnitN2(), 0) ThenBlock: { ReturnValue(0) }
            // N2 = normalize(V - arc_center) is intrinsically outward; no PointInSolid flip needed.
            CAD_Topo_FComp.px = Float_Add(CAD_Store.Read(vh, 0), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2x))
            CAD_Topo_FComp.py = Float_Add(CAD_Store.Read(vh, 1), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2y))
            CAD_Topo_FComp.pz = Float_Add(CAD_Store.Read(vh, 2), Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.n2z))
            CAD_Topo_FComp.cx = Float_Add(CAD_Store.Read(vh, 0), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1x))
            CAD_Topo_FComp.cy = Float_Add(CAD_Store.Read(vh, 1), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1y))
            CAD_Topo_FComp.cz = Float_Add(CAD_Store.Read(vh, 2), Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.n1z))
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Store T_host (px) and T_wall (cx) at vh into vsol start or end of idx.
Function.CAD_Topo.FilletIRVSolAt {
    Input: idx: Integer
    Input: vh: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(idx, 0)
        CAD_Topo_FComp.ok = 0
        IfCondition NotEqual(CAD_Topo_FComp.e, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.e, 0), vh) ThenBlock: { CAD_Topo_FComp.ok = 0 }
            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FComp.e, 0), vh) ThenBlock: { CAD_Topo_FComp.ok = 6 }
        }
        CAD_Topo.FilletIRVSolPut(idx, CAD_Topo_FComp.ok, CAD_Topo_FComp.px)
        CAD_Topo.FilletIRVSolPut(idx, Add(CAD_Topo_FComp.ok, 1), CAD_Topo_FComp.py)
        CAD_Topo.FilletIRVSolPut(idx, Add(CAD_Topo_FComp.ok, 2), CAD_Topo_FComp.pz)
        CAD_Topo.FilletIRVSolPut(idx, Add(CAD_Topo_FComp.ok, 3), CAD_Topo_FComp.cx)
        CAD_Topo.FilletIRVSolPut(idx, Add(CAD_Topo_FComp.ok, 4), CAD_Topo_FComp.cy)
        CAD_Topo.FilletIRVSolPut(idx, Add(CAD_Topo_FComp.ok, 5), CAD_Topo_FComp.cz)
        IfCondition EqualTo(CAD_Topo_FComp.ok, 0) ThenBlock: { CAD_Topo.FilletIRVSolPut(idx, 14, 1) }
        IfCondition EqualTo(CAD_Topo_FComp.ok, 6) ThenBlock: { CAD_Topo.FilletIRVSolPut(idx, 15, 1) }
        ReturnValue(1)
    }
}

// Append face_h to xyz[13 ..] if it is new. refuse is the count.
// 0 when a fourth distinct face shows up. 1 otherwise.
Function.CAD_Topo.FilletIRPushFace {
    Input: face_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, CAD_Topo_FComp.refuse) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_FComp.xyz, Add(13, CAD_Topo_FComp.k)), face_h) ThenBlock: { ReturnValue(1) }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        IfCondition GreaterEqual(CAD_Topo_FComp.refuse, 3) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FComp.xyz, Add(13, CAD_Topo_FComp.refuse), face_h)
        CAD_Topo_FComp.refuse = Add(CAD_Topo_FComp.refuse, 1)
        ReturnValue(1)
    }
}

// 1 when FOut.hit lies in an inner loop of face_h. PointInFaceUV tests
// the outer loop only, so a ray through a hole still counts the cap.
// Plane is already in FOut.pl. Does not write FOut or n1/n2.
Function.CAD_Topo.FilletIRHoleHit {
    Input: face_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FOut.pl, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FOut.hit, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.host = CAD_Store.Read(face_h, 1)
        IfCondition EqualTo(CAD_Topo_FComp.host, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.host = CAD_Store.Read(CAD_Topo_FComp.host, 2)
        CAD_Topo_FComp.pair = 0
        WhileLoop NotEqual(CAD_Topo_FComp.host, 0) {
            IfCondition GreaterThan(CAD_Topo_FComp.pair, 8) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.wall = CAD_Store.Read(CAD_Topo_FComp.host, 0)
            IfCondition NotEqual(CAD_Topo_FComp.wall, 0) ThenBlock: {
                CAD_Topo_FComp.px = Float_Sub(ArrayGet(CAD_Topo_FOut.hit, 0), ArrayGet(CAD_Topo_FOut.pl, 1))
                CAD_Topo_FComp.py = Float_Sub(ArrayGet(CAD_Topo_FOut.hit, 1), ArrayGet(CAD_Topo_FOut.pl, 2))
                CAD_Topo_FComp.pz = Float_Sub(ArrayGet(CAD_Topo_FOut.hit, 2), ArrayGet(CAD_Topo_FOut.pl, 3))
                CAD_Topo_FComp.edx = Float_Mul(CAD_Topo_FComp.px, ArrayGet(CAD_Topo_FOut.pl, 4))
                CAD_Topo_FComp.edx = Float_Add(CAD_Topo_FComp.edx, Float_Mul(CAD_Topo_FComp.py, ArrayGet(CAD_Topo_FOut.pl, 5)))
                CAD_Topo_FComp.edx = Float_Add(CAD_Topo_FComp.edx, Float_Mul(CAD_Topo_FComp.pz, ArrayGet(CAD_Topo_FOut.pl, 6)))
                CAD_Topo_FComp.edy = Float_Mul(CAD_Topo_FComp.px, ArrayGet(CAD_Topo_FOut.pl, 7))
                CAD_Topo_FComp.edy = Float_Add(CAD_Topo_FComp.edy, Float_Mul(CAD_Topo_FComp.py, ArrayGet(CAD_Topo_FOut.pl, 8)))
                CAD_Topo_FComp.edy = Float_Add(CAD_Topo_FComp.edy, Float_Mul(CAD_Topo_FComp.pz, ArrayGet(CAD_Topo_FOut.pl, 9)))
                CAD_Topo_FComp.rr = 0
                CAD_Topo_FComp.which = 0
                CAD_Topo_FComp.side = 0
                CAD_Topo_FComp.kind = CAD_Topo_FComp.wall
                WhileLoop NotEqual(CAD_Topo_FComp.kind, 0) {
                    IfCondition GreaterThan(CAD_Topo_FComp.side, 64) ThenBlock: { CAD_Topo_FComp.kind = 0 }
                    IfCondition NotEqual(CAD_Topo_FComp.kind, 0) ThenBlock: {
                        CAD_Topo_FComp.inner = CAD_Store.Read(CAD_Topo_FComp.kind, 2)
                        CAD_Topo_FComp.aa = CAD_Store.Read(CAD_Topo_FComp.kind, 5)
                        IfCondition NotEqual(CAD_Topo_FComp.aa, 0) ThenBlock: {
                            CAD_Topo_FComp.px = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.aa, 0), ArrayGet(CAD_Topo_FOut.pl, 1))
                            CAD_Topo_FComp.py = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.aa, 1), ArrayGet(CAD_Topo_FOut.pl, 2))
                            CAD_Topo_FComp.pz = Float_Sub(CAD_Store.Read(CAD_Topo_FComp.aa, 2), ArrayGet(CAD_Topo_FOut.pl, 3))
                            CAD_Topo_FComp.cx = Float_Mul(CAD_Topo_FComp.px, ArrayGet(CAD_Topo_FOut.pl, 4))
                            CAD_Topo_FComp.cx = Float_Add(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.py, ArrayGet(CAD_Topo_FOut.pl, 5)))
                            CAD_Topo_FComp.cx = Float_Add(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.pz, ArrayGet(CAD_Topo_FOut.pl, 6)))
                            CAD_Topo_FComp.cy = Float_Mul(CAD_Topo_FComp.px, ArrayGet(CAD_Topo_FOut.pl, 7))
                            CAD_Topo_FComp.cy = Float_Add(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.py, ArrayGet(CAD_Topo_FOut.pl, 8)))
                            CAD_Topo_FComp.cy = Float_Add(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.pz, ArrayGet(CAD_Topo_FOut.pl, 9)))
                            IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
                                CAD_Topo_FComp.aa = 0
                                CAD_Topo_FComp.bb = CAD_Num.Le(CAD_Topo_FComp.xy, CAD_Topo_FComp.edy)
                                IfCondition EqualTo(CAD_Topo_FComp.bb, 1) ThenBlock: {
                                    CAD_Topo_FComp.bb = CAD_Num.Le(CAD_Topo_FComp.edy, CAD_Topo_FComp.cy)
                                    IfCondition EqualTo(CAD_Topo_FComp.bb, 1) ThenBlock: { CAD_Topo_FComp.aa = 1 }
                                }
                                CAD_Topo_FComp.bb = CAD_Num.Le(CAD_Topo_FComp.cy, CAD_Topo_FComp.edy)
                                IfCondition EqualTo(CAD_Topo_FComp.bb, 1) ThenBlock: {
                                    CAD_Topo_FComp.bb = CAD_Num.Le(CAD_Topo_FComp.edy, CAD_Topo_FComp.xy)
                                    IfCondition EqualTo(CAD_Topo_FComp.bb, 1) ThenBlock: { CAD_Topo_FComp.aa = 1 }
                                }
                                IfCondition EqualTo(CAD_Topo_FComp.aa, 1) ThenBlock: {
                                    CAD_Topo_FComp.ln = Float_Sub(CAD_Topo_FComp.cy, CAD_Topo_FComp.xy)
                                    CAD_Topo_FComp.bb = CAD_Num.IsZero(CAD_Topo_FComp.ln, 0)
                                    IfCondition EqualTo(CAD_Topo_FComp.bb, 0) ThenBlock: {
                                        CAD_Topo_FComp.ln = Float_Div(Float_Sub(CAD_Topo_FComp.edy, CAD_Topo_FComp.xy), CAD_Topo_FComp.ln)
                                        CAD_Topo_FComp.pz = Float_Sub(CAD_Topo_FComp.cx, CAD_Topo_FComp.xx)
                                        CAD_Topo_FComp.ln = Float_Add(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.pz))
                                        CAD_Topo_FComp.bb = CAD_Num.Le(CAD_Topo_FComp.edx, CAD_Topo_FComp.ln)
                                        IfCondition EqualTo(CAD_Topo_FComp.bb, 1) ThenBlock: {
                                            CAD_Topo_FComp.rr = Subtract(1, CAD_Topo_FComp.rr)
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: {
                                CAD_Topo_FComp.yx = CAD_Topo_FComp.cx
                                CAD_Topo_FComp.yy = CAD_Topo_FComp.cy
                                CAD_Topo_FComp.which = 1
                            }
                            CAD_Topo_FComp.xx = CAD_Topo_FComp.cx
                            CAD_Topo_FComp.xy = CAD_Topo_FComp.cy
                        }
                        IfCondition EqualTo(CAD_Topo_FComp.inner, CAD_Topo_FComp.wall) ThenBlock: { CAD_Topo_FComp.kind = 0 }
                        IfCondition NotEqual(CAD_Topo_FComp.inner, CAD_Topo_FComp.wall) ThenBlock: { CAD_Topo_FComp.kind = CAD_Topo_FComp.inner }
                    }
                    CAD_Topo_FComp.side = Add(CAD_Topo_FComp.side, 1)
                }
                IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
                    CAD_Topo_FComp.aa = 0
                    CAD_Topo_FComp.bb = CAD_Num.Le(CAD_Topo_FComp.xy, CAD_Topo_FComp.edy)
                    IfCondition EqualTo(CAD_Topo_FComp.bb, 1) ThenBlock: {
                        CAD_Topo_FComp.bb = CAD_Num.Le(CAD_Topo_FComp.edy, CAD_Topo_FComp.yy)
                        IfCondition EqualTo(CAD_Topo_FComp.bb, 1) ThenBlock: { CAD_Topo_FComp.aa = 1 }
                    }
                    CAD_Topo_FComp.bb = CAD_Num.Le(CAD_Topo_FComp.yy, CAD_Topo_FComp.edy)
                    IfCondition EqualTo(CAD_Topo_FComp.bb, 1) ThenBlock: {
                        CAD_Topo_FComp.bb = CAD_Num.Le(CAD_Topo_FComp.edy, CAD_Topo_FComp.xy)
                        IfCondition EqualTo(CAD_Topo_FComp.bb, 1) ThenBlock: { CAD_Topo_FComp.aa = 1 }
                    }
                    IfCondition EqualTo(CAD_Topo_FComp.aa, 1) ThenBlock: {
                        CAD_Topo_FComp.ln = Float_Sub(CAD_Topo_FComp.yy, CAD_Topo_FComp.xy)
                        CAD_Topo_FComp.bb = CAD_Num.IsZero(CAD_Topo_FComp.ln, 0)
                        IfCondition EqualTo(CAD_Topo_FComp.bb, 0) ThenBlock: {
                            CAD_Topo_FComp.ln = Float_Div(Float_Sub(CAD_Topo_FComp.edy, CAD_Topo_FComp.xy), CAD_Topo_FComp.ln)
                            CAD_Topo_FComp.pz = Float_Sub(CAD_Topo_FComp.yx, CAD_Topo_FComp.xx)
                            CAD_Topo_FComp.ln = Float_Add(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.pz))
                            CAD_Topo_FComp.bb = CAD_Num.Le(CAD_Topo_FComp.edx, CAD_Topo_FComp.ln)
                            IfCondition EqualTo(CAD_Topo_FComp.bb, 1) ThenBlock: {
                                CAD_Topo_FComp.rr = Subtract(1, CAD_Topo_FComp.rr)
                            }
                        }
                    }
                }
                IfCondition EqualTo(CAD_Topo_FComp.rr, 1) ThenBlock: { ReturnValue(1) }
            }
            CAD_Topo_FComp.host = CAD_Store.Read(CAD_Topo_FComp.host, 2)
            CAD_Topo_FComp.pair = Add(CAD_Topo_FComp.pair, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.FilletIRRayOdd {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FComp.solid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FOut.pl, 0) ThenBlock: { CAD_Topo_FOut.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FOut.hit, 0) ThenBlock: { CAD_Topo_FOut.hit = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FOut.pl, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FOut.inside = 0
        CAD_Topo_FOut.shell = CAD_Store.Read(CAD_Topo_FComp.solid, 0)
        CAD_Topo_FOut.guard = 0
        WhileLoop NotEqual(CAD_Topo_FOut.shell, 0) {
            IfCondition GreaterThan(CAD_Topo_FOut.guard, 64) ThenBlock: { CAD_Topo_FOut.shell = 0 }
            IfCondition NotEqual(CAD_Topo_FOut.shell, 0) ThenBlock: {
                CAD_Topo_FOut.snext = CAD_Store.Read(CAD_Topo_FOut.shell, 2)
                CAD_Topo_FOut.face = CAD_Store.Read(CAD_Topo_FOut.shell, 0)
                CAD_Topo_FOut.fg = 0
                WhileLoop NotEqual(CAD_Topo_FOut.face, 0) {
                    IfCondition GreaterThan(CAD_Topo_FOut.fg, 512) ThenBlock: { CAD_Topo_FOut.face = 0 }
                    IfCondition NotEqual(CAD_Topo_FOut.face, 0) ThenBlock: {
                        CAD_Topo_FOut.fnext = CAD_Store.Read(CAD_Topo_FOut.face, 3)
                        IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_FOut.face, CAD_Topo_FOut.pl), 0) ThenBlock: {
                            CAD_Topo_FOut.den = Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Topo_FOut.pl, 10), CAD_Topo_FOut.dx), Float_Mul(ArrayGet(CAD_Topo_FOut.pl, 11), CAD_Topo_FOut.dy)), Float_Mul(ArrayGet(CAD_Topo_FOut.pl, 12), CAD_Topo_FOut.dz))
                            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FOut.den, 0), 0) ThenBlock: {
                                CAD_Topo_FOut.t = Float_Sub(ArrayGet(CAD_Topo_FOut.pl, 1), ArrayGet(CAD_Topo_FOut.xyz, 0))
                                CAD_Topo_FOut.t = Float_Mul(ArrayGet(CAD_Topo_FOut.pl, 10), CAD_Topo_FOut.t)
                                CAD_Topo_FOut.t = Float_Add(CAD_Topo_FOut.t, Float_Mul(ArrayGet(CAD_Topo_FOut.pl, 11), Float_Sub(ArrayGet(CAD_Topo_FOut.pl, 2), ArrayGet(CAD_Topo_FOut.xyz, 1))))
                                CAD_Topo_FOut.t = Float_Add(CAD_Topo_FOut.t, Float_Mul(ArrayGet(CAD_Topo_FOut.pl, 12), Float_Sub(ArrayGet(CAD_Topo_FOut.pl, 3), ArrayGet(CAD_Topo_FOut.xyz, 2))))
                                CAD_Topo_FOut.t = Float_Div(CAD_Topo_FOut.t, CAD_Topo_FOut.den)
                                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FOut.t), 0) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FOut.t, 0), 0) ThenBlock: {
                                        ArraySet(CAD_Topo_FOut.hit, 0, Float_Add(ArrayGet(CAD_Topo_FOut.xyz, 0), Float_Mul(CAD_Topo_FOut.t, CAD_Topo_FOut.dx)))
                                        ArraySet(CAD_Topo_FOut.hit, 1, Float_Add(ArrayGet(CAD_Topo_FOut.xyz, 1), Float_Mul(CAD_Topo_FOut.t, CAD_Topo_FOut.dy)))
                                        ArraySet(CAD_Topo_FOut.hit, 2, Float_Add(ArrayGet(CAD_Topo_FOut.xyz, 2), Float_Mul(CAD_Topo_FOut.t, CAD_Topo_FOut.dz)))
                                        IfCondition EqualTo(CAD_Topo.PointInFaceUV(CAD_Topo_FOut.face, CAD_Topo_FOut.hit), 1) ThenBlock: {
                                            IfCondition EqualTo(CAD_Topo.FilletIRHoleHit(CAD_Topo_FOut.face), 0) ThenBlock: {
                                                CAD_Topo_FOut.inside = Subtract(1, CAD_Topo_FOut.inside)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        CAD_Topo_FOut.face = CAD_Topo_FOut.fnext
                    }
                    CAD_Topo_FOut.fg = Add(CAD_Topo_FOut.fg, 1)
                }
                CAD_Topo_FOut.shell = CAD_Topo_FOut.snext
            }
            CAD_Topo_FOut.guard = Add(CAD_Topo_FOut.guard, 1)
        }
        ReturnValue(CAD_Topo_FOut.inside)
    }
}

// 1 when n2, already a unit normal of face_h, points into the material.
// The sample is the face centroid, not the corner: a corner step lands
// on the neighboring face. A 0.13 mm Y shift keeps the ray off a vertex.
// Default ray: +Z on a vertical wall, +X on a horizontal one. RayOdd
// counts planes only, so that +Z ray crosses a skipped X-axis corner
// cylinder and flips a correct outward hole wall. A neighbor cylinder
// whose axis is not parallel to n2 replaces the ray. The axis sign
// follows the default ray, so a Z cylinder stays +Z. Do not write
// FComp.e, k, n, ce, i, j, refuse, s1, s2, v0, solid, r, n1, n2, xyz, pl.
Function.CAD_Topo.FilletIRInward {
    Input: face_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FOut.face = face_h
        IfCondition EqualTo(CAD_Topo_FOut.xyz, 0) ThenBlock: { CAD_Topo_FOut.xyz = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FOut.xyz, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FaceCentroid(CAD_Topo_FOut.face, CAD_Topo_FOut.xyz), 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FOut.xyz, 0, Float_Add(ArrayGet(CAD_Topo_FOut.xyz, 0), Float_Mul(0x3FE0000000000000, CAD_Topo_FComp.n2x)))
        ArraySet(CAD_Topo_FOut.xyz, 1, Float_Add(ArrayGet(CAD_Topo_FOut.xyz, 1), Float_Mul(0x3FE0000000000000, CAD_Topo_FComp.n2y)))
        ArraySet(CAD_Topo_FOut.xyz, 1, Float_Add(ArrayGet(CAD_Topo_FOut.xyz, 1), 0x3FC0A3D70A3D70A4))
        ArraySet(CAD_Topo_FOut.xyz, 2, Float_Add(ArrayGet(CAD_Topo_FOut.xyz, 2), Float_Mul(0x3FE0000000000000, CAD_Topo_FComp.n2z)))
        CAD_Topo_FOut.den = CAD_Topo_FComp.n2z
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FOut.den), 1) ThenBlock: { CAD_Topo_FOut.den = Float_Sub(0, CAD_Topo_FOut.den) }
        CAD_Topo_FOut.dx = 0
        CAD_Topo_FOut.dy = 0
        CAD_Topo_FOut.dz = 0x3FF0000000000000
        IfCondition EqualTo(CAD_Num.Le(0x3FE0000000000000, CAD_Topo_FOut.den), 1) ThenBlock: {
            CAD_Topo_FOut.dx = 0x3FF0000000000000
            CAD_Topo_FOut.dz = 0
        }
        CAD_Topo_FOut.inside = 0
        CAD_Topo_FOut.shell = CAD_Store.Read(CAD_Topo_FOut.face, 1)
        CAD_Topo_FOut.guard = 0
        WhileLoop NotEqual(CAD_Topo_FOut.shell, 0) {
            IfCondition GreaterThan(CAD_Topo_FOut.guard, 8) ThenBlock: { CAD_Topo_FOut.shell = 0 }
            IfCondition NotEqual(CAD_Topo_FOut.shell, 0) ThenBlock: {
                CAD_Topo_FOut.snext = CAD_Store.Read(CAD_Topo_FOut.shell, 2)
                CAD_Topo_FOut.fnext = CAD_Store.Read(CAD_Topo_FOut.shell, 0)
                CAD_Topo_FOut.fg = 0
                WhileLoop NotEqual(CAD_Topo_FOut.fnext, 0) {
                    IfCondition GreaterThan(CAD_Topo_FOut.fg, 64) ThenBlock: { CAD_Topo_FOut.fnext = 0 }
                    IfCondition NotEqual(CAD_Topo_FOut.fnext, 0) ThenBlock: {
                        CAD_Topo_FOut.den = CAD_Store.Read(CAD_Topo_FOut.fnext, 2)
                        CAD_Topo_FOut.t = CAD_Store.Read(CAD_Topo_FOut.fnext, 1)
                        IfCondition NotEqual(CAD_Topo_FOut.t, 0) ThenBlock: {
                            CAD_Topo_FOut.t = CAD_Store.Read(CAD_Topo_FOut.t, 4)
                            IfCondition NotEqual(CAD_Topo_FOut.t, 0) ThenBlock: {
                                CAD_Topo_FOut.t = CAD_Store.Read(CAD_Topo_FOut.t, 1)
                                IfCondition NotEqual(CAD_Topo_FOut.t, 0) ThenBlock: {
                                    IfCondition NotEqual(CAD_Topo_FOut.t, CAD_Topo_FOut.face) ThenBlock: {
                                        CAD_Topo_FOut.t = CAD_Store.Read(CAD_Topo_FOut.t, 0)
                                        IfCondition NotEqual(CAD_Topo_FOut.t, 0) ThenBlock: {
                                            CAD_Topo_FComp.which = CAD_Store.Read(CAD_Topo_FOut.t, 0)
                                            IfCondition EqualTo(CAD_Topo_FComp.which, 2) ThenBlock: {
                                                CAD_Topo_FComp.aa = CAD_Store.Read(CAD_Topo_FOut.t, 10)
                                                CAD_Topo_FComp.bb = CAD_Store.Read(CAD_Topo_FOut.t, 11)
                                                CAD_Topo_FComp.ln = CAD_Store.Read(CAD_Topo_FOut.t, 12)
                                                CAD_Topo_FComp.px = Float_Mul(CAD_Topo_FComp.aa, CAD_Topo_FComp.n2x)
                                                CAD_Topo_FComp.px = Float_Add(CAD_Topo_FComp.px, Float_Mul(CAD_Topo_FComp.bb, CAD_Topo_FComp.n2y))
                                                CAD_Topo_FComp.px = Float_Add(CAD_Topo_FComp.px, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FComp.n2z))
                                                CAD_Topo_FComp.ln = Float_Mul(CAD_Topo_FComp.aa, CAD_Topo_FComp.aa)
                                                CAD_Topo_FComp.ln = Float_Add(CAD_Topo_FComp.ln, Float_Mul(CAD_Topo_FComp.bb, CAD_Topo_FComp.bb))
                                                CAD_Topo_FComp.bb = CAD_Store.Read(CAD_Topo_FOut.t, 12)
                                                CAD_Topo_FComp.ln = Float_Add(CAD_Topo_FComp.ln, Float_Mul(CAD_Topo_FComp.bb, CAD_Topo_FComp.bb))
                                                CAD_Topo_FComp.which = CAD_Num.IsZero(CAD_Topo_FComp.ln, 0)
                                                IfCondition EqualTo(CAD_Topo_FComp.which, 0) ThenBlock: {
                                                    CAD_Topo_FComp.aa = Float_Mul(CAD_Topo_FComp.px, CAD_Topo_FComp.px)
                                                    CAD_Topo_FComp.bb = Float_Mul(0x3FD0000000000000, CAD_Topo_FComp.ln)
                                                    CAD_Topo_FComp.aa = Float_Sub(CAD_Topo_FComp.aa, CAD_Topo_FComp.bb)
                                                    CAD_Topo_FComp.which = CAD_Num.IsNeg(CAD_Topo_FComp.aa)
                                                    IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
                                                        CAD_Topo_FComp.py = CAD_Topo_FComp.ln
                                                        CAD_Topo_FComp.aa = CAD_Store.Read(CAD_Topo_FOut.t, 10)
                                                        CAD_Topo_FComp.bb = CAD_Store.Read(CAD_Topo_FOut.t, 11)
                                                        CAD_Topo_FComp.ln = CAD_Store.Read(CAD_Topo_FOut.t, 12)
                                                        CAD_Topo_FComp.px = Float_Mul(CAD_Topo_FComp.aa, CAD_Topo_FOut.dx)
                                                        CAD_Topo_FComp.px = Float_Add(CAD_Topo_FComp.px, Float_Mul(CAD_Topo_FComp.bb, CAD_Topo_FOut.dy))
                                                        CAD_Topo_FComp.px = Float_Add(CAD_Topo_FComp.px, Float_Mul(CAD_Topo_FComp.ln, CAD_Topo_FOut.dz))
                                                        CAD_Topo_FComp.which = CAD_Num.IsNeg(CAD_Topo_FComp.px)
                                                        IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
                                                            CAD_Topo_FComp.aa = Float_Sub(0, CAD_Topo_FComp.aa)
                                                            CAD_Topo_FComp.bb = Float_Sub(0, CAD_Topo_FComp.bb)
                                                            CAD_Topo_FComp.ln = Float_Sub(0, CAD_Topo_FComp.ln)
                                                            CAD_Topo_FComp.px = Float_Sub(0, CAD_Topo_FComp.px)
                                                        }
                                                        CAD_Topo_FComp.px = Float_Mul(CAD_Topo_FComp.px, CAD_Topo_FComp.px)
                                                        CAD_Topo_FComp.px = Float_Div(CAD_Topo_FComp.px, CAD_Topo_FComp.py)
                                                        CAD_Topo_FComp.which = 0
                                                        IfCondition EqualTo(CAD_Topo_FOut.inside, 0) ThenBlock: { CAD_Topo_FComp.which = 1 }
                                                        IfCondition EqualTo(CAD_Topo_FOut.inside, 1) ThenBlock: {
                                                            CAD_Topo_FComp.py = Float_Sub(CAD_Topo_FComp.px, CAD_Topo_FComp.rr)
                                                            CAD_Topo_FComp.py = CAD_Num.IsNeg(CAD_Topo_FComp.py)
                                                            IfCondition EqualTo(CAD_Topo_FComp.py, 1) ThenBlock: { CAD_Topo_FComp.which = 1 }
                                                        }
                                                        IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
                                                            CAD_Topo_FComp.rr = CAD_Topo_FComp.px
                                                            CAD_Topo_FComp.xx = CAD_Topo_FComp.aa
                                                            CAD_Topo_FComp.xy = CAD_Topo_FComp.bb
                                                            CAD_Topo_FComp.xz = CAD_Topo_FComp.ln
                                                            CAD_Topo_FOut.inside = 1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(CAD_Topo_FOut.den, 0) ThenBlock: { CAD_Topo_FOut.fnext = 0 }
                        IfCondition NotEqual(CAD_Topo_FOut.den, 0) ThenBlock: {
                            CAD_Topo_FOut.t = CAD_Store.Read(CAD_Topo_FOut.shell, 0)
                            IfCondition EqualTo(CAD_Topo_FOut.den, CAD_Topo_FOut.t) ThenBlock: { CAD_Topo_FOut.fnext = 0 }
                            IfCondition NotEqual(CAD_Topo_FOut.den, CAD_Topo_FOut.t) ThenBlock: { CAD_Topo_FOut.fnext = CAD_Topo_FOut.den }
                        }
                    }
                    CAD_Topo_FOut.fg = Add(CAD_Topo_FOut.fg, 1)
                }
                CAD_Topo_FOut.shell = CAD_Topo_FOut.snext
            }
            CAD_Topo_FOut.guard = Add(CAD_Topo_FOut.guard, 1)
        }
        IfCondition EqualTo(CAD_Topo_FOut.inside, 1) ThenBlock: {
            CAD_Topo_FOut.dx = CAD_Topo_FComp.xx
            CAD_Topo_FOut.dy = CAD_Topo_FComp.xy
            CAD_Topo_FOut.dz = CAD_Topo_FComp.xz
        }
        ReturnValue(CAD_Topo.FilletIRRayOdd())
    }
}

// Outward unit normal of a plane into n2.
Function.CAD_Topo.FilletIROutN {
    Input: face_h: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.wall = face_h
        IfCondition EqualTo(CAD_Topo.FilletFaceN(CAD_Topo_FComp.wall), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIRInward(CAD_Topo_FComp.wall), 1) ThenBlock: {
            CAD_Topo_FComp.n2x = Float_Sub(0, CAD_Topo_FComp.n2x)
            CAD_Topo_FComp.n2y = Float_Sub(0, CAD_Topo_FComp.n2y)
            CAD_Topo_FComp.n2z = Float_Sub(0, CAD_Topo_FComp.n2z)
        }
        ReturnValue(1)
    }
}

// Copy the saved normal of face_h into n2. Faces live at xyz[13..15],
// normals at xyz[4], [7], [10].
Function.CAD_Topo.FilletIRGramN {
    Input: face_h: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, 3) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_FComp.xyz, Add(13, CAD_Topo_FComp.k)), face_h) ThenBlock: {
                CAD_Topo_FComp.which = Add(4, Multiply(CAD_Topo_FComp.k, 3))
                CAD_Topo_FComp.n2x = ArrayGet(CAD_Topo_FComp.xyz, CAD_Topo_FComp.which)
                CAD_Topo_FComp.n2y = ArrayGet(CAD_Topo_FComp.xyz, Add(CAD_Topo_FComp.which, 1))
                CAD_Topo_FComp.n2z = ArrayGet(CAD_Topo_FComp.xyz, Add(CAD_Topo_FComp.which, 2))
                ReturnValue(1)
            }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        ReturnValue(0)
    }
}

// 3-plane corner of edges ia and ja at vh. 1 wrote the rolling-ball
// contacts (and gram when 3 selected edges meet). 2 the three planes
// are real but the formula failed. 0 is not this pair: caller keeps
// the 2-face path. A pair that is not three distinct planes does not
// set the trace-miss flag and does not clobber a stored gram contact.
Function.CAD_Topo.FilletIRVertGram {
    Input: ia: Integer
    Input: ja: Integer
    Input: vh: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.s1 = ia
        CAD_Topo_FComp.s2 = ja
        CAD_Topo_FComp.v0 = vh
        CAD_Topo_FComp.refuse = 0
        IfCondition EqualTo(CAD_Topo.FilletIRPushFace(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s1, 19)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIRPushFace(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s1, 20)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIRPushFace(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s2, 19)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIRPushFace(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s2, 20)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo_FComp.refuse, 3) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FComp.xyz, 12, CAD_Topo_FComp.refuse)
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, 3) {
            IfCondition NotEqual(CAD_Topo.FilletIRFaceKind(ArrayGet(CAD_Topo_FComp.xyz, Add(13, CAD_Topo_FComp.k))), 1) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        CAD_Topo_FComp.refuse = 0
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, CAD_Topo_FComp.n) {
            CAD_Topo_FComp.ce = CAD_Topo.FilletIRGet(CAD_Topo_FComp.k, 0)
            IfCondition NotEqual(CAD_Topo_FComp.ce, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.ce, 0), CAD_Topo_FComp.v0) ThenBlock: { CAD_Topo_FComp.refuse = Add(CAD_Topo_FComp.refuse, 1) }
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.ce, 1), CAD_Topo_FComp.v0) ThenBlock: { CAD_Topo_FComp.refuse = Add(CAD_Topo_FComp.refuse, 1) }
            }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        IfCondition LessEqual(CAD_Topo_FComp.refuse, 2) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FComp.xyz, 3, CAD_Topo_FComp.refuse)
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, 3) {
            IfCondition EqualTo(CAD_Topo.FilletIROutN(ArrayGet(CAD_Topo_FComp.xyz, Add(13, CAD_Topo_FComp.k))), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FComp.which = Add(4, Multiply(CAD_Topo_FComp.k, 3))
            ArraySet(CAD_Topo_FComp.xyz, CAD_Topo_FComp.which, CAD_Topo_FComp.n2x)
            ArraySet(CAD_Topo_FComp.xyz, Add(CAD_Topo_FComp.which, 1), CAD_Topo_FComp.n2y)
            ArraySet(CAD_Topo_FComp.xyz, Add(CAD_Topo_FComp.which, 2), CAD_Topo_FComp.n2z)
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        CAD_Topo_FComp.n1x = ArrayGet(CAD_Topo_FComp.xyz, 4)
        CAD_Topo_FComp.n1y = ArrayGet(CAD_Topo_FComp.xyz, 5)
        CAD_Topo_FComp.n1z = ArrayGet(CAD_Topo_FComp.xyz, 6)
        CAD_Topo_FComp.n2x = ArrayGet(CAD_Topo_FComp.xyz, 7)
        CAD_Topo_FComp.n2y = ArrayGet(CAD_Topo_FComp.xyz, 8)
        CAD_Topo_FComp.n2z = ArrayGet(CAD_Topo_FComp.xyz, 9)
        CAD_Topo_FComp.n3x = ArrayGet(CAD_Topo_FComp.xyz, 10)
        CAD_Topo_FComp.n3y = ArrayGet(CAD_Topo_FComp.xyz, 11)
        CAD_Topo_FComp.n3z = ArrayGet(CAD_Topo_FComp.xyz, 12)
        // Sign from this pair only. Both edges cove: ball in the notch
        // (s = +R). One cove and one convex: keep s = -R so the cove
        // meets the rim ball. A convex edge resets s. mode is the
        // seen-convex flag; the caller overwrites mode with the return.
        CAD_Topo_FComp.s = Float_Sub(0, CAD_Topo_FComp.r)
        CAD_Topo_FComp.mode = 0
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, CAD_Topo_FComp.n) {
            CAD_Topo_FComp.which = 0
            IfCondition EqualTo(CAD_Topo_FComp.k, CAD_Topo_FComp.s1) ThenBlock: { CAD_Topo_FComp.which = 1 }
            IfCondition EqualTo(CAD_Topo_FComp.k, CAD_Topo_FComp.s2) ThenBlock: { CAD_Topo_FComp.which = 1 }
            IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
                CAD_Topo_FComp.ce = CAD_Topo.FilletIRGet(CAD_Topo_FComp.k, 0)
                IfCondition NotEqual(CAD_Topo_FComp.ce, 0) ThenBlock: {
                    CAD_Topo_FComp.which = 0
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.ce, 0), CAD_Topo_FComp.v0) ThenBlock: { CAD_Topo_FComp.which = 1 }
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.ce, 1), CAD_Topo_FComp.v0) ThenBlock: { CAD_Topo_FComp.which = 1 }
                    IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.k, 3), 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Topo_FComp.mode, 0) ThenBlock: {
                                CAD_Topo_FComp.s = CAD_Topo_FComp.r
                            }
                        }
                        IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.k, 3), 1) ThenBlock: {
                            CAD_Topo_FComp.mode = 1
                            CAD_Topo_FComp.s = Float_Sub(0, CAD_Topo_FComp.r)
                        }
                    }
                }
            }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        CAD_Topo_FComp.shost = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n2z))
        CAD_Topo_FComp.srad = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n3z))
        CAD_Topo_FComp.rmaj = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n3z))
        CAD_Topo_FComp.ln = 0x3FF0000000000000
        CAD_Topo_FComp.ln = Float_Sub(CAD_Topo_FComp.ln, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.shost))
        CAD_Topo_FComp.ln = Float_Sub(CAD_Topo_FComp.ln, Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.srad))
        CAD_Topo_FComp.ln = Float_Sub(CAD_Topo_FComp.ln, Float_Mul(CAD_Topo_FComp.rmaj, CAD_Topo_FComp.rmaj))
        CAD_Topo_FComp.ln = Float_Add(CAD_Topo_FComp.ln, Float_Mul(0x4000000000000000, Float_Mul(CAD_Topo_FComp.shost, Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.rmaj))))
        CAD_Topo_FComp.aa = CAD_Topo_FComp.rmaj
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.aa), 1) ThenBlock: { CAD_Topo_FComp.aa = Float_Sub(0, CAD_Topo_FComp.aa) }
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Topo_FComp.aa, 0x3FF0000000000000, 0), 1) ThenBlock: { CAD_Topo_FComp.ln = 0 }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(2) }
        CAD_Topo_FComp.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FComp.shost), CAD_Topo_FComp.srad)
        CAD_Topo_FComp.bb = Float_Sub(Float_Add(CAD_Topo_FComp.shost, CAD_Topo_FComp.srad), CAD_Topo_FComp.rmaj)
        CAD_Topo_FComp.rr = Float_Div(Float_Mul(CAD_Topo_FComp.s, Float_Add(CAD_Topo_FComp.aa, Float_Mul(CAD_Topo_FComp.rmaj, CAD_Topo_FComp.bb))), CAD_Topo_FComp.ln)
        CAD_Topo_FComp.cx = Float_Add(CAD_Store.Read(CAD_Topo_FComp.v0, 0), Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n1x))
        CAD_Topo_FComp.cy = Float_Add(CAD_Store.Read(CAD_Topo_FComp.v0, 1), Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n1y))
        CAD_Topo_FComp.cz = Float_Add(CAD_Store.Read(CAD_Topo_FComp.v0, 2), Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n1z))
        CAD_Topo_FComp.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FComp.shost), CAD_Topo_FComp.rmaj)
        CAD_Topo_FComp.bb = Float_Sub(Float_Add(CAD_Topo_FComp.shost, CAD_Topo_FComp.rmaj), CAD_Topo_FComp.srad)
        CAD_Topo_FComp.rr = Float_Div(Float_Mul(CAD_Topo_FComp.s, Float_Add(CAD_Topo_FComp.aa, Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.bb))), CAD_Topo_FComp.ln)
        CAD_Topo_FComp.cx = Float_Add(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n2x))
        CAD_Topo_FComp.cy = Float_Add(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n2y))
        CAD_Topo_FComp.cz = Float_Add(CAD_Topo_FComp.cz, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n2z))
        CAD_Topo_FComp.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FComp.srad), CAD_Topo_FComp.rmaj)
        CAD_Topo_FComp.bb = Float_Sub(Float_Add(CAD_Topo_FComp.srad, CAD_Topo_FComp.rmaj), CAD_Topo_FComp.shost)
        CAD_Topo_FComp.rr = Float_Div(Float_Mul(CAD_Topo_FComp.s, Float_Add(CAD_Topo_FComp.aa, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.bb))), CAD_Topo_FComp.ln)
        CAD_Topo_FComp.cx = Float_Add(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n3x))
        CAD_Topo_FComp.cy = Float_Add(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n3y))
        CAD_Topo_FComp.cz = Float_Add(CAD_Topo_FComp.cz, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n3z))
        CAD_Topo_FComp.xx = CAD_Topo_FComp.cx
        CAD_Topo_FComp.xy = CAD_Topo_FComp.cy
        CAD_Topo_FComp.xz = CAD_Topo_FComp.cz
        CAD_Topo_FComp.px = Float_Sub(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n1x))
        CAD_Topo_FComp.py = Float_Sub(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n1y))
        CAD_Topo_FComp.pz = Float_Sub(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n1z))
        CAD_Topo_FComp.aa = Float_Sub(CAD_Topo_FComp.px, CAD_Store.Read(CAD_Topo_FComp.v0, 0))
        CAD_Topo_FComp.bb = Float_Sub(CAD_Topo_FComp.py, CAD_Store.Read(CAD_Topo_FComp.v0, 1))
        CAD_Topo_FComp.rr = Float_Sub(CAD_Topo_FComp.pz, CAD_Store.Read(CAD_Topo_FComp.v0, 2))
        CAD_Topo_FComp.aa = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.aa, CAD_Topo_FComp.aa), Float_Mul(CAD_Topo_FComp.bb, CAD_Topo_FComp.bb)), Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.rr)))
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Mul(0x4010000000000000, CAD_Topo_FComp.r), CAD_Topo_FComp.aa)), 1) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(CAD_Topo.FilletIRGramN(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s1, 19)), 0) ThenBlock: { ReturnValue(2) }
        CAD_Topo_FComp.px = Float_Sub(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2x))
        CAD_Topo_FComp.py = Float_Sub(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2y))
        CAD_Topo_FComp.pz = Float_Sub(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2z))
        IfCondition EqualTo(CAD_Topo.FilletIRGramN(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s1, 20)), 0) ThenBlock: { ReturnValue(2) }
        CAD_Topo_FComp.cx = Float_Sub(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2x))
        CAD_Topo_FComp.cy = Float_Sub(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2y))
        CAD_Topo_FComp.cz = Float_Sub(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2z))
        // A concave solution must not replace a convex edge's contact.
        // A convex solution does write the cove, so a mixed corner is one ball.
        CAD_Topo_FComp.which = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.s), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s1, 3), 1) ThenBlock: { CAD_Topo_FComp.which = 1 }
        }
        IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s1, 3), 0) ThenBlock: { CAD_Topo_FComp.which = 1 }
        IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
            CAD_Topo.FilletIRVSolAt(CAD_Topo_FComp.s1, CAD_Topo_FComp.v0)
        }
        IfCondition EqualTo(CAD_Topo.FilletIRGramN(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s2, 19)), 0) ThenBlock: { ReturnValue(2) }
        CAD_Topo_FComp.px = Float_Sub(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2x))
        CAD_Topo_FComp.py = Float_Sub(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2y))
        CAD_Topo_FComp.pz = Float_Sub(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2z))
        IfCondition EqualTo(CAD_Topo.FilletIRGramN(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s2, 20)), 0) ThenBlock: { ReturnValue(2) }
        CAD_Topo_FComp.cx = Float_Sub(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2x))
        CAD_Topo_FComp.cy = Float_Sub(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2y))
        CAD_Topo_FComp.cz = Float_Sub(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2z))
        CAD_Topo_FComp.which = 0
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.s), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s2, 3), 1) ThenBlock: { CAD_Topo_FComp.which = 1 }
        }
        IfCondition EqualTo(CAD_Topo.FilletIRGet(CAD_Topo_FComp.s2, 3), 0) ThenBlock: { CAD_Topo_FComp.which = 1 }
        IfCondition EqualTo(CAD_Topo_FComp.which, 1) ThenBlock: {
            CAD_Topo.FilletIRVSolAt(CAD_Topo_FComp.s2, CAD_Topo_FComp.v0)
        }
        CAD_Topo_FComp.e = CAD_Topo.FilletIRGet(CAD_Topo_FComp.s1, 0)
        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.e, 0), CAD_Topo_FComp.v0) ThenBlock: {
            CAD_Topo.FilletIRVSolPut(CAD_Topo_FComp.s1, 12, 1)
        }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FComp.e, 0), CAD_Topo_FComp.v0) ThenBlock: {
            CAD_Topo.FilletIRVSolPut(CAD_Topo_FComp.s1, 13, 1)
        }
        CAD_Topo_FComp.h = CAD_Topo.FilletIRGet(CAD_Topo_FComp.s2, 0)
        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FComp.h, 0), CAD_Topo_FComp.v0) ThenBlock: {
            CAD_Topo.FilletIRVSolPut(CAD_Topo_FComp.s2, 12, 1)
        }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FComp.h, 0), CAD_Topo_FComp.v0) ThenBlock: {
            CAD_Topo.FilletIRVSolPut(CAD_Topo_FComp.s2, 13, 1)
        }
        ReturnValue(1)
    }
}

// Append a plane to the 3-face set. Handle at xyz[13+refuse], outward
// normal at xyz[4+refuse*3]. Duplicate is 1 and does not grow. A
// non-plane or a fourth face is 0 so the 2-face contacts stay.
Function.CAD_Topo.FilletIRBallPush {
    Input: face_h: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.ce = face_h
        IfCondition EqualTo(CAD_Topo_FComp.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.k = CAD_Topo.FilletIRFaceKind(CAD_Topo_FComp.ce)
        IfCondition NotEqual(CAD_Topo_FComp.k, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.k = 0
        WhileLoop LessThan(CAD_Topo_FComp.k, CAD_Topo_FComp.refuse) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_FComp.xyz, Add(13, CAD_Topo_FComp.k)), CAD_Topo_FComp.ce) ThenBlock: { ReturnValue(1) }
            CAD_Topo_FComp.k = Add(CAD_Topo_FComp.k, 1)
        }
        IfCondition GreaterEqual(CAD_Topo_FComp.refuse, 3) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FComp.xyz, Add(13, CAD_Topo_FComp.refuse), CAD_Topo_FComp.ce)
        IfCondition EqualTo(CAD_Topo.FilletIROutN(CAD_Topo_FComp.ce), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.which = Add(4, Multiply(CAD_Topo_FComp.refuse, 3))
        ArraySet(CAD_Topo_FComp.xyz, CAD_Topo_FComp.which, CAD_Topo_FComp.n2x)
        ArraySet(CAD_Topo_FComp.xyz, Add(CAD_Topo_FComp.which, 1), CAD_Topo_FComp.n2y)
        ArraySet(CAD_Topo_FComp.xyz, Add(CAD_Topo_FComp.which, 2), CAD_Topo_FComp.n2z)
        CAD_Topo_FComp.refuse = Add(CAD_Topo_FComp.refuse, 1)
        ReturnValue(1)
    }
}

// Host contact into px, wall contact into cx, from the center in xx.
// Each edge uses its own two faces. ce is idx; v0 is the corner.
Function.CAD_Topo.FilletIRVertBallPut {
    Input: idx: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.ce = idx
        CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.ce, 19)
        IfCondition EqualTo(CAD_Topo.FilletIRGramN(CAD_Topo_FComp.host), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.px = Float_Sub(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2x))
        CAD_Topo_FComp.py = Float_Sub(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2y))
        CAD_Topo_FComp.pz = Float_Sub(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2z))
        CAD_Topo_FComp.wall = CAD_Topo.FilletIRGet(CAD_Topo_FComp.ce, 20)
        IfCondition EqualTo(CAD_Topo.FilletIRGramN(CAD_Topo_FComp.wall), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.cx = Float_Sub(CAD_Topo_FComp.xx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2x))
        CAD_Topo_FComp.cy = Float_Sub(CAD_Topo_FComp.xy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2y))
        CAD_Topo_FComp.cz = Float_Sub(CAD_Topo_FComp.xz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n2z))
        CAD_Topo.FilletIRVSolAt(CAD_Topo_FComp.ce, CAD_Topo_FComp.v0)
        ReturnValue(1)
    }
}

// Union of the two edges' host and wall planes. One shared px duplicated
// the face that is host of one edge and wall of the other, so that
// corner kept the 2-face point. Contacts are per face: C - s*N.
// 0 leaves the 2-face solution already stored. Does not set gram.
Function.CAD_Topo.FilletIRVertBallStore {
    Input: ia: Integer
    Input: ja: Integer
    Input: vh: Integer
    Output: Integer
    Body: {
        CAD_Topo_FComp.s1 = ia
        CAD_Topo_FComp.s2 = ja
        CAD_Topo_FComp.v0 = vh
        IfCondition EqualTo(CAD_Topo_FComp.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.xyz, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.refuse = 0
        CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.s1, 19)
        IfCondition EqualTo(CAD_Topo.FilletIRBallPush(CAD_Topo_FComp.host), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.s1, 20)
        IfCondition EqualTo(CAD_Topo.FilletIRBallPush(CAD_Topo_FComp.host), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.s2, 19)
        IfCondition EqualTo(CAD_Topo.FilletIRBallPush(CAD_Topo_FComp.host), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.host = CAD_Topo.FilletIRGet(CAD_Topo_FComp.s2, 20)
        IfCondition EqualTo(CAD_Topo.FilletIRBallPush(CAD_Topo_FComp.host), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo_FComp.refuse, 3) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.n1x = ArrayGet(CAD_Topo_FComp.xyz, 4)
        CAD_Topo_FComp.n1y = ArrayGet(CAD_Topo_FComp.xyz, 5)
        CAD_Topo_FComp.n1z = ArrayGet(CAD_Topo_FComp.xyz, 6)
        CAD_Topo_FComp.n2x = ArrayGet(CAD_Topo_FComp.xyz, 7)
        CAD_Topo_FComp.n2y = ArrayGet(CAD_Topo_FComp.xyz, 8)
        CAD_Topo_FComp.n2z = ArrayGet(CAD_Topo_FComp.xyz, 9)
        CAD_Topo_FComp.n3x = ArrayGet(CAD_Topo_FComp.xyz, 10)
        CAD_Topo_FComp.n3y = ArrayGet(CAD_Topo_FComp.xyz, 11)
        CAD_Topo_FComp.n3z = ArrayGet(CAD_Topo_FComp.xyz, 12)
        CAD_Topo_FComp.s = Float_Sub(0, CAD_Topo_FComp.r)
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FComp.s = CAD_Topo_FComp.r }
        CAD_Topo_FComp.shost = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n2x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n2y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n2z))
        CAD_Topo_FComp.srad = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n1x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n1y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.n1z, CAD_Topo_FComp.n3z))
        CAD_Topo_FComp.rmaj = Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.n2x, CAD_Topo_FComp.n3x), Float_Mul(CAD_Topo_FComp.n2y, CAD_Topo_FComp.n3y)), Float_Mul(CAD_Topo_FComp.n2z, CAD_Topo_FComp.n3z))
        CAD_Topo_FComp.ln = 0x3FF0000000000000
        CAD_Topo_FComp.ln = Float_Sub(CAD_Topo_FComp.ln, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.shost))
        CAD_Topo_FComp.ln = Float_Sub(CAD_Topo_FComp.ln, Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.srad))
        CAD_Topo_FComp.ln = Float_Sub(CAD_Topo_FComp.ln, Float_Mul(CAD_Topo_FComp.rmaj, CAD_Topo_FComp.rmaj))
        CAD_Topo_FComp.ln = Float_Add(CAD_Topo_FComp.ln, Float_Mul(0x4000000000000000, Float_Mul(CAD_Topo_FComp.shost, Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.rmaj))))
        CAD_Topo_FComp.aa = CAD_Topo_FComp.rmaj
        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FComp.aa), 1) ThenBlock: { CAD_Topo_FComp.aa = Float_Sub(0, CAD_Topo_FComp.aa) }
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Topo_FComp.aa, 0x3FF0000000000000, 0), 1) ThenBlock: { CAD_Topo_FComp.ln = 0 }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FComp.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FComp.shost), CAD_Topo_FComp.srad)
        CAD_Topo_FComp.bb = Float_Sub(Float_Add(CAD_Topo_FComp.shost, CAD_Topo_FComp.srad), CAD_Topo_FComp.rmaj)
        CAD_Topo_FComp.rr = Float_Div(Float_Mul(CAD_Topo_FComp.s, Float_Add(CAD_Topo_FComp.aa, Float_Mul(CAD_Topo_FComp.rmaj, CAD_Topo_FComp.bb))), CAD_Topo_FComp.ln)
        CAD_Topo_FComp.cx = Float_Add(CAD_Store.Read(CAD_Topo_FComp.v0, 0), Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n1x))
        CAD_Topo_FComp.cy = Float_Add(CAD_Store.Read(CAD_Topo_FComp.v0, 1), Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n1y))
        CAD_Topo_FComp.cz = Float_Add(CAD_Store.Read(CAD_Topo_FComp.v0, 2), Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n1z))
        CAD_Topo_FComp.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FComp.shost), CAD_Topo_FComp.rmaj)
        CAD_Topo_FComp.bb = Float_Sub(Float_Add(CAD_Topo_FComp.shost, CAD_Topo_FComp.rmaj), CAD_Topo_FComp.srad)
        CAD_Topo_FComp.rr = Float_Div(Float_Mul(CAD_Topo_FComp.s, Float_Add(CAD_Topo_FComp.aa, Float_Mul(CAD_Topo_FComp.srad, CAD_Topo_FComp.bb))), CAD_Topo_FComp.ln)
        CAD_Topo_FComp.cx = Float_Add(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n2x))
        CAD_Topo_FComp.cy = Float_Add(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n2y))
        CAD_Topo_FComp.cz = Float_Add(CAD_Topo_FComp.cz, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n2z))
        CAD_Topo_FComp.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FComp.srad), CAD_Topo_FComp.rmaj)
        CAD_Topo_FComp.bb = Float_Sub(Float_Add(CAD_Topo_FComp.srad, CAD_Topo_FComp.rmaj), CAD_Topo_FComp.shost)
        CAD_Topo_FComp.rr = Float_Div(Float_Mul(CAD_Topo_FComp.s, Float_Add(CAD_Topo_FComp.aa, Float_Mul(CAD_Topo_FComp.shost, CAD_Topo_FComp.bb))), CAD_Topo_FComp.ln)
        CAD_Topo_FComp.cx = Float_Add(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n3x))
        CAD_Topo_FComp.cy = Float_Add(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n3y))
        CAD_Topo_FComp.cz = Float_Add(CAD_Topo_FComp.cz, Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.n3z))
        CAD_Topo_FComp.px = Float_Sub(CAD_Topo_FComp.cx, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n1x))
        CAD_Topo_FComp.py = Float_Sub(CAD_Topo_FComp.cy, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n1y))
        CAD_Topo_FComp.pz = Float_Sub(CAD_Topo_FComp.cz, Float_Mul(CAD_Topo_FComp.s, CAD_Topo_FComp.n1z))
        CAD_Topo_FComp.aa = Float_Sub(CAD_Topo_FComp.px, CAD_Store.Read(CAD_Topo_FComp.v0, 0))
        CAD_Topo_FComp.bb = Float_Sub(CAD_Topo_FComp.py, CAD_Store.Read(CAD_Topo_FComp.v0, 1))
        CAD_Topo_FComp.rr = Float_Sub(CAD_Topo_FComp.pz, CAD_Store.Read(CAD_Topo_FComp.v0, 2))
        CAD_Topo_FComp.aa = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FComp.aa, CAD_Topo_FComp.aa), Float_Mul(CAD_Topo_FComp.bb, CAD_Topo_FComp.bb)), Float_Mul(CAD_Topo_FComp.rr, CAD_Topo_FComp.rr)))
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(Float_Mul(0x4010000000000000, CAD_Topo_FComp.r), CAD_Topo_FComp.aa)), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FComp.xx = CAD_Topo_FComp.cx
        CAD_Topo_FComp.xy = CAD_Topo_FComp.cy
        CAD_Topo_FComp.xz = CAD_Topo_FComp.cz
        IfCondition EqualTo(CAD_Topo.FilletIRVertBallPut(CAD_Topo_FComp.s1), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletIRVertBallPut(CAD_Topo_FComp.s2), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

