// CAD.Topo.FilletPlex — Multi-ring Plex graph classification, pathing, and segment dispatch.
// Local ring queries string N junction types on one loop (cope / sphere / tangent).
// Coplanar is a vertex fact (two LINEs vs XYZ join), not a batch recipe.
// Part of CAD.Topo facade (LibraryImport.Cad.CAD_Topo).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Plex
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Err
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Blend


FixedPool.CAD_Topo_FPlex {
    "count":     Initialize=0, CanChange=True
    "head":      Initialize=0, CanChange=True
    "solid":     Initialize=0, CanChange=True
    "r":         Initialize=0, CanChange=True
    "seg_count": Initialize=0, CanChange=True
    "nodes":     Initialize=0, CanChange=True
    "segs":      Initialize=0, CanChange=True
    "vert_buf":  Initialize=0, CanChange=True
    "init":      Initialize=0, CanChange=True
    "mer0":      Initialize=0, CanChange=True
    "mer1":      Initialize=0, CanChange=True
    "mer0n":     Initialize=0, CanChange=True
    "mer1n":     Initialize=0, CanChange=True
    "th0":       Initialize=0, CanChange=True
    "th1":       Initialize=0, CanChange=True
    "j5":        Initialize=0, CanChange=True
    "j5n":       Initialize=0, CanChange=True
    "j5host":    Initialize=0, CanChange=True
    "arc4":      Initialize=0, CanChange=True
    "arc4b":     Initialize=0, CanChange=True
    "arc4c":     Initialize=0, CanChange=True
    "arc4n":     Initialize=0, CanChange=True
}

// Data Slot Constants for Plex Nodes (0..15)
// Slot 0: Edge handle
// Slot 1: Face A
// Slot 2: Face B
// Slot 3: Start vertex (v0)
// Slot 4: End vertex (v1)
// Slot 5: Curve kind / pair type
// Slot 6: Assigned Solve Method
// Slot 7: Junction at v0 (1=cope 2=tangent 4=sphere 5=rail-arc)
// Slot 8: Segment ID
// Slot 9: Fillet IR Index
// Slot 10: blocking cyl face at v0 (junc 5)
// Slot 11: blocking cyl face at v1 (junc 5)
// Slot 12: Junction at v1 (same enum as slot 7 — per VERTEX, not per edge)
//
// junc 5 = SHARP_RAIL_ARC: one selected LINE at V, incident
// cylindrical face. Not a cope (nsel=1 — same as filleting one
// box edge). Plex tags it (slots 7/12, blockers 10/11). EdgeLocal
// does not read those slots — junction API is FilletPlexJuncAt
// per end. FilletPlexJunc5EmitEnd / RailArcShift / FilletPlexJunc5*
// have zero product-path call sites. Method 10 is defined and
// never assigned. Same function left and right.
//
// Solve Method Enum:
// 1 = SEQUENTIAL (FilletEdgesSequential)
// 2 = EMIT_CHAIN (FilletEmitChain)
// 3 = CORNER_3E (FilletJoinFoot3)
// 4 = CYL_TOP_RIM (CAD_Blend.FilletCylTopRim)
// 5 = CYL_BOT_RIM (CAD_Blend.FilletCylBottomRim)
// 6 = PLANE_CYL (FilletEmitPlaneCyl / FilletPlaneCylJoin)
// 7 = DIGON (FilletPlaneEdgesDigon)
// 8 = COVE_CYCLE (FilletJoinCoveCycle)
// 9 = EDGE_LOCAL (FilletEdgeLocal)
// 10 = RAIL_ARC (same local emit; junc 5 is the vertex solve)

Function.CAD_Topo.FilletPlexInit {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FPlex.init, 0) ThenBlock: {
            Plex.Init()
            CAD_Topo_FPlex.nodes = Allocate(256)
            CAD_Topo_FPlex.segs = Allocate(512)
            CAD_Topo_FPlex.vert_buf = Allocate(256)
            CAD_Topo_FPlex.init = 1
        }
        IfCondition EqualTo(CAD_Topo_FPlex.mer0, 0) ThenBlock: { CAD_Topo_FPlex.mer0 = Allocate(16) }
        IfCondition EqualTo(CAD_Topo_FPlex.mer1, 0) ThenBlock: { CAD_Topo_FPlex.mer1 = Allocate(16) }
        IfCondition EqualTo(CAD_Topo_FPlex.j5, 0) ThenBlock: { CAD_Topo_FPlex.j5 = Allocate(512) }
        CAD_Topo_FPlex.th0 = 0
        CAD_Topo_FPlex.th1 = 0
        CAD_Topo_FPlex.j5n = 0
        CAD_Topo_FPlex.j5host = 0
        CAD_Topo_FPlex.arc4 = 0
        CAD_Topo_FPlex.arc4n = 0
        CAD_Topo_FPlex.count = 0
        CAD_Topo_FPlex.head = 0
        CAD_Topo_FPlex.seg_count = 0
        ReturnValue(1)
    }
}

// ----------------------------------------------------------------------------
// BUILD: Construct Plex Ring 0 (Coedge Chain) & Ring 1 (Vertex Stars)
// ----------------------------------------------------------------------------

Function.CAD_Topo.FilletPlexBuild {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        CAD_Topo.FilletPlexInit()
        CAD_Topo_FPlex.solid = solid_handle
        CAD_Topo_FPlex.r = radius_r
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }

        i = 0
        prev_node = 0
        WhileLoop LessThan(i, CAD_Topo_FComp.n) {
            edge_h = CAD_Topo.FilletIRGet(i, 0)
            pair_t = CAD_Topo.FilletIRGet(i, 11)
            f1 = CAD_Topo.FilletIRGet(i, 4)
            f2 = CAD_Topo.FilletIRGet(i, 5)
            v0 = CAD_Store.Read(edge_h, 0)
            v1 = CAD_Store.Read(edge_h, 1)

            // Curve kind: 1=LINE, 2=ARC/CIRCLE
            ckind = 1
            IfCondition NotEqual(pair_t, 0) ThenBlock: { ckind = 2 }

            nd = Plex.Alloc(ckind)
            IfCondition EqualTo(nd, 0) ThenBlock: { ReturnValue(0) }

            Plex.Set(nd, 0, edge_h)
            Plex.Set(nd, 1, f1)
            Plex.Set(nd, 2, f2)
            Plex.Set(nd, 3, v0)
            Plex.Set(nd, 4, v1)
            Plex.Set(nd, 5, pair_t)
            Plex.Set(nd, 6, 0) // Solve method TBD
            Plex.Set(nd, 7, 0) // Flags TBD
            Plex.Set(nd, 9, i)

            ArraySet(CAD_Topo_FPlex.nodes, i, nd)
            Plex.RingSingleton(nd, 0)
            Plex.RingSingleton(nd, 1)

            IfCondition EqualTo(i, 0) ThenBlock: {
                CAD_Topo_FPlex.head = nd
            } ElseBlock: {
                Plex.RingInsertAfter(prev_node, nd, 0)
            }
            prev_node = nd
            i = Add(i, 1)
        }

        CAD_Topo_FPlex.count = CAD_Topo_FComp.n

        // Build Ring 1: Vertex Star Rings (edges sharing a vertex)
        i = 0
        WhileLoop LessThan(i, CAD_Topo_FPlex.count) {
            nd_i = ArrayGet(CAD_Topo_FPlex.nodes, i)
            v0_i = Plex.Get(nd_i, 3)
            v1_i = Plex.Get(nd_i, 4)

            j = Add(i, 1)
            WhileLoop LessThan(j, CAD_Topo_FPlex.count) {
                nd_j = ArrayGet(CAD_Topo_FPlex.nodes, j)
                v0_j = Plex.Get(nd_j, 3)
                v1_j = Plex.Get(nd_j, 4)

                shares_v = 0
                IfCondition EqualTo(v0_i, v0_j) ThenBlock: { shares_v = 1 }
                IfCondition EqualTo(v0_i, v1_j) ThenBlock: { shares_v = 1 }
                IfCondition EqualTo(v1_i, v0_j) ThenBlock: { shares_v = 1 }
                IfCondition EqualTo(v1_i, v1_j) ThenBlock: { shares_v = 1 }

                IfCondition EqualTo(shares_v, 1) ThenBlock: {
                    Plex.RingInsertAfter(nd_i, nd_j, 1)
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }

        ReturnValue(CAD_Topo_FPlex.count)
    }
}

Function.CAD_Topo.FilletPlexGetNode {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FPlex.head, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LessThan(idx, CAD_Topo_FPlex.count), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(ArrayGet(CAD_Topo_FPlex.nodes, idx))
    }
}

// pair=1 wall at this rim: fillet along +N2 (1) vs toward-center OD (2).
// Local fact: N2 = V−C vs host-coedge left (N_host × D). Interior is left
// of a CCW loop with outward N. N2 into the face → fillet (r+R). N2 off
// the face → OD (r−R). Not inner=0, not center-in-face.
Function.CAD_Topo.FilletPlexIdentifyPair1 {
    Input: idx: Integer
    Output: Integer
    Body: {
        host = CAD_Topo.FilletIRGet(idx, 19)
        e = CAD_Topo.FilletIRGet(idx, 0)
        IfCondition EqualTo(host, 0) ThenBlock: { ReturnValue(CAD_Topo.FilletIRGet(idx, 21)) }
        IfCondition EqualTo(e, 0) ThenBlock: { ReturnValue(CAD_Topo.FilletIRGet(idx, 21)) }
        v0 = CAD_Store.Read(e, 0)
        v1 = CAD_Store.Read(e, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(CAD_Topo.FilletIRGet(idx, 21)) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(CAD_Topo.FilletIRGet(idx, 21)) }
        ce = CAD_Topo.FindCoedgeOnFace(host, e)
        IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(CAD_Topo.FilletIRGet(idx, 21)) }
        org = CAD_Store.Read(ce, 5)
        dx = Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0))
        dy = Float_Sub(CAD_Store.Read(v1, 1), CAD_Store.Read(v0, 1))
        dz = Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2))
        IfCondition NotEqual(org, v0) ThenBlock: {
            dx = Float_Sub(0, dx)
            dy = Float_Sub(0, dy)
            dz = Float_Sub(0, dz)
        }
        // Closed CIRCLE: v0==v1 so D=0 and pair always 1 (brim). Tangent = N×(P−C).
        aa = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
        IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 1) ThenBlock: {
            crv = CAD_Store.Read(e, 2)
            IfCondition NotEqual(crv, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                    rx = Float_Sub(CAD_Store.Read(v0, 0), CAD_Store.Read(crv, 1))
                    ry = Float_Sub(CAD_Store.Read(v0, 1), CAD_Store.Read(crv, 2))
                    rz = Float_Sub(CAD_Store.Read(v0, 2), CAD_Store.Read(crv, 3))
                    Xx = CAD_Store.Read(crv, 4)
                    Xy = CAD_Store.Read(crv, 5)
                    Xz = CAD_Store.Read(crv, 6)
                    Yx = CAD_Store.Read(crv, 7)
                    Yy = CAD_Store.Read(crv, 8)
                    Yz = CAD_Store.Read(crv, 9)
                    nx = Float_Sub(Float_Mul(Xy, Yz), Float_Mul(Xz, Yy))
                    ny = Float_Sub(Float_Mul(Xz, Yx), Float_Mul(Xx, Yz))
                    nz = Float_Sub(Float_Mul(Xx, Yy), Float_Mul(Xy, Yx))
                    dx = Float_Sub(Float_Mul(ny, rz), Float_Mul(nz, ry))
                    dy = Float_Sub(Float_Mul(nz, rx), Float_Mul(nx, rz))
                    dz = Float_Sub(Float_Mul(nx, ry), Float_Mul(ny, rx))
                    sp = CAD_Store.Read(crv, 12)
                    IfCondition EqualTo(CAD_Num.IsNeg(sp), 1) ThenBlock: {
                        dx = Float_Sub(0, dx)
                        dy = Float_Sub(0, dy)
                        dz = Float_Sub(0, dz)
                    }
                }
            }
        }
        n1x = CAD_Topo.FilletIRSolGet(idx, 6)
        n1y = CAD_Topo.FilletIRSolGet(idx, 7)
        n1z = CAD_Topo.FilletIRSolGet(idx, 8)
        n2x = CAD_Topo.FilletIRSolGet(idx, 9)
        n2y = CAD_Topo.FilletIRSolGet(idx, 10)
        n2z = CAD_Topo.FilletIRSolGet(idx, 11)
        lx = Float_Sub(Float_Mul(n1y, dz), Float_Mul(n1z, dy))
        ly = Float_Sub(Float_Mul(n1z, dx), Float_Mul(n1x, dz))
        lz = Float_Sub(Float_Mul(n1x, dy), Float_Mul(n1y, dx))
        dot = Float_Add(Float_Add(Float_Mul(n2x, lx), Float_Mul(n2y, ly)), Float_Mul(n2z, lz))
        IfCondition EqualTo(CAD_Num.IsNeg(dot), 1) ThenBlock: {
            ReturnValue(2)
        }
        ReturnValue(1)
    }
}

// Incident face at vh other than skip1/skip2. Any surface kind (plane or
// cylinder). FindFaceWithVert drops non-planes; open rails vs a curve need this.
Function.CAD_Topo.FilletPlexBlockingFace {
    Input: solid_h: Integer
    Input: vert_h: Integer
    Input: skip1: Integer
    Input: skip2: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCE.solid = solid_h
        CAD_Topo_FCE.vert = vert_h
        CAD_Topo_FCE.skip1 = skip1
        CAD_Topo_FCE.skip2 = skip2
        CAD_Topo_FCE.sh = CAD_Store.Read(solid_h, 0)
        CAD_Topo_FCE.sg = 0
        WhileLoop NotEqual(CAD_Topo_FCE.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FCE.sg, 64) ThenBlock: { CAD_Topo_FCE.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FCE.sh, 0) ThenBlock: {
                CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.sh, 0)
                CAD_Topo_FCE.fg = 0
                WhileLoop NotEqual(CAD_Topo_FCE.face, 0) {
                    IfCondition GreaterThan(CAD_Topo_FCE.fg, 4096) ThenBlock: { CAD_Topo_FCE.face = 0 }
                    IfCondition NotEqual(CAD_Topo_FCE.face, 0) ThenBlock: {
                        CAD_Topo_FCE.hd = 1
                        IfCondition EqualTo(CAD_Topo_FCE.face, CAD_Topo_FCE.skip1) ThenBlock: { CAD_Topo_FCE.hd = 0 }
                        IfCondition EqualTo(CAD_Topo_FCE.face, CAD_Topo_FCE.skip2) ThenBlock: { CAD_Topo_FCE.hd = 0 }
                        IfCondition EqualTo(CAD_Topo_FCE.hd, 1) ThenBlock: {
                            CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.face, 1)
                            CAD_Topo_FCE.ok = 0
                            IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                CAD_Topo_FCE.ce = CAD_Store.Read(CAD_Topo_FCE.lp, 0)
                                CAD_Topo_FCE.hd = CAD_Topo_FCE.ce
                                CAD_Topo_FCE.g = 0
                                WhileLoop LessThan(CAD_Topo_FCE.g, 2048) {
                                    IfCondition EqualTo(CAD_Topo_FCE.ce, 0) ThenBlock: { CAD_Topo_FCE.g = 2048 }
                                    IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.ce, 5), CAD_Topo_FCE.vert) ThenBlock: {
                                            // Cylindrical blocker only. Planar ends
                                            // stay on FindFaceWithVert.
                                            CAD_Topo_FCE.ok = CAD_Store.Read(CAD_Topo_FCE.face, 0)
                                            IfCondition NotEqual(CAD_Topo_FCE.ok, 0) ThenBlock: {
                                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.ok, 0), 2) ThenBlock: {
                                                    ReturnValue(CAD_Topo_FCE.face)
                                                }
                                            }
                                        }
                                        CAD_Topo_FCE.ce = CAD_Store.Read(CAD_Topo_FCE.ce, 2)
                                        IfCondition EqualTo(CAD_Topo_FCE.ce, CAD_Topo_FCE.hd) ThenBlock: { CAD_Topo_FCE.g = 2048 }
                                    }
                                    CAD_Topo_FCE.g = Add(CAD_Topo_FCE.g, 1)
                                }
                            }
                        }
                        CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.face, 3)
                    }
                    CAD_Topo_FCE.fg = Add(CAD_Topo_FCE.fg, 1)
                }
                CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FCE.sh, 2)
            }
            CAD_Topo_FCE.sg = Add(CAD_Topo_FCE.sg, 1)
        }
        ReturnValue(0)
    }
}

// Blocking cyl face at an open LINE end, or 0. Caller tags junc 5
// and stores the face in plex slots 10/11.
Function.CAD_Topo.FilletPlexIdentifyRailArc {
    Input: vert_h: Integer
    Input: skip1: Integer
    Input: skip2: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FilletIRCountAt(vert_h), 1) ThenBlock: { ReturnValue(0) }
        blk = CAD_Topo.FilletPlexBlockingFace(CAD_Topo_FPlex.solid, vert_h, skip1, skip2)
        IfCondition EqualTo(blk, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(blk)
    }
}

// Junction at one vertex of this edge. Independent of the other end —
// a rail can be cope at the back and rail-arc at the south.
Function.CAD_Topo.FilletPlexJuncAt {
    Input: vert_h: Integer
    Input: skip1: Integer
    Input: skip2: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(0) }
        nsel = CAD_Topo.FilletIRCountAt(vert_h)
        IfCondition NotEqual(CAD_Topo.FilletPlexIdentifyRailArc(vert_h, skip1, skip2), 0) ThenBlock: { ReturnValue(5) }
        IfCondition GreaterThan(nsel, 2) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(nsel, 2) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Move vert along the rail (FLoc.edx) onto the Z-cylinder of face_h.
// Independent of the Th shift — Tw has its own hit.
Function.CAD_Topo.FilletPlexCylClipVert {
    Input: vert_h: Integer
    Input: face_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(1) }
        surf = CAD_Store.Read(face_h, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: { ReturnValue(1) }
        tx = CAD_Store.Read(vert_h, 0)
        ty = CAD_Store.Read(vert_h, 1)
        tz = CAD_Store.Read(vert_h, 2)
        ocx = CAD_Store.Read(surf, 1)
        ocy = CAD_Store.Read(surf, 2)
        rr = CAD_Store.Read(surf, 13)
        dx = CAD_Topo_FLoc.edx
        dy = CAD_Topo_FLoc.edy
        aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 1) ThenBlock: { ReturnValue(1) }
        nx = Float_Sub(tx, ocx)
        ny = Float_Sub(ty, ocy)
        bb = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(nx, dx), Float_Mul(ny, dy)))
        cc = Float_Sub(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(rr, rr))
        disc = Float_Sub(Float_Mul(bb, bb), Float_Mul(0x4010000000000000, Float_Mul(aa, cc)))
        IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: { ReturnValue(1) }
        disc = CAD_Num.Sqrt(disc)
        s0 = Float_Div(Float_Sub(Float_Sub(0, bb), disc), Float_Mul(0x4000000000000000, aa))
        s1 = Float_Div(Float_Add(Float_Sub(0, bb), disc), Float_Mul(0x4000000000000000, aa))
        as0 = s0
        IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
        as1 = s1
        IfCondition EqualTo(CAD_Num.IsNeg(as1), 1) ThenBlock: { as1 = Float_Sub(0, as1) }
        s = s0
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as1, as0)), 1) ThenBlock: { s = s1 }
        as0 = s
        IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
        IfCondition EqualTo(CAD_Num.IsZero(s, 0), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as0, 0x412E848000000000)), 0) ThenBlock: { ReturnValue(1) }
        CAD_Store.Write(vert_h, 0, Float_Add(tx, Float_Mul(s, CAD_Topo_FLoc.edx)))
        CAD_Store.Write(vert_h, 1, Float_Add(ty, Float_Mul(s, CAD_Topo_FLoc.edy)))
        CAD_Store.Write(vert_h, 2, Float_Add(tz, Float_Mul(s, CAD_Topo_FLoc.edz)))
        PrintMessage("fillet plex cyl-clip s_um=")
        PrintNumber(Float_ToInt(s))
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Hit P + s*rail against Z-cylinder (Oxy, R). Smaller |s|.
// Writes the hit to FLoc.pt and s to FLoc.ab. 1 ok.
Function.CAD_Topo.FilletPlexHitZCyl {
    Input: ocx: Integer
    Input: ocy: Integer
    Input: rr: Integer
    Input: px: Integer
    Input: py: Integer
    Input: pz: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: { ReturnValue(0) }
        dx = CAD_Topo_FLoc.edx
        dy = CAD_Topo_FLoc.edy
        aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 1) ThenBlock: { ReturnValue(0) }
        nx = Float_Sub(px, ocx)
        ny = Float_Sub(py, ocy)
        bb = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(nx, dx), Float_Mul(ny, dy)))
        cc = Float_Sub(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(rr, rr))
        disc = Float_Sub(Float_Mul(bb, bb), Float_Mul(0x4010000000000000, Float_Mul(aa, cc)))
        IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: { ReturnValue(0) }
        disc = CAD_Num.Sqrt(disc)
        s0 = Float_Div(Float_Sub(Float_Sub(0, bb), disc), Float_Mul(0x4000000000000000, aa))
        s1 = Float_Div(Float_Add(Float_Sub(0, bb), disc), Float_Mul(0x4000000000000000, aa))
        as0 = s0
        IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
        as1 = s1
        IfCondition EqualTo(CAD_Num.IsNeg(as1), 1) ThenBlock: { as1 = Float_Sub(0, as1) }
        s = s0
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as1, as0)), 1) ThenBlock: { s = s1 }
        as0 = s
        IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as0, 0x412E848000000000)), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.ab = s
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(px, Float_Mul(s, CAD_Topo_FLoc.edx)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(py, Float_Mul(s, CAD_Topo_FLoc.edy)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(pz, Float_Mul(s, CAD_Topo_FLoc.edz)))
        ReturnValue(1)
    }
}

// Emit-time junc=5: translate that end's C along the rail onto the
// blocker. Contacts are then created by EdgeLocal MakeVertex from C'.
// Must not write FLoc.which. HitZCyl clobbers FLoc.ab / FLoc.pt (safe
// after ln is set, before MakeVertex). 0 miss / 1 ok or no-op.
Function.CAD_Topo.FilletPlexShortenRailEnd {
    Input: which_end: Integer
    Output: Integer
    Body: {
        vv = CAD_Topo_FLoc.v0
        cx = CAD_Topo_FLoc.c0x
        cy = CAD_Topo_FLoc.c0y
        cz = CAD_Topo_FLoc.c0z
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            vv = CAD_Topo_FLoc.v1
            cx = CAD_Topo_FLoc.c1x
            cy = CAD_Topo_FLoc.c1y
            cz = CAD_Topo_FLoc.c1z
        }
        IfCondition EqualTo(vv, 0) ThenBlock: { ReturnValue(1) }
        jn = CAD_Topo.FilletPlexJuncAt(vv, CAD_Topo_FLoc.f1, CAD_Topo_FLoc.f2)
        IfCondition NotEqual(jn, 5) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("shorten which=", 14, which_end)
        blk = 0
        ei = CAD_Topo.FilletIRIndexOf(CAD_Topo_FLoc.edge)
        IfCondition GreaterEqual(ei, 0) ThenBlock: {
            nd = CAD_Topo.FilletPlexGetNode(ei)
            IfCondition NotEqual(nd, 0) ThenBlock: {
                IfCondition EqualTo(which_end, 0) ThenBlock: { blk = Plex.Get(nd, 10) }
                IfCondition EqualTo(which_end, 1) ThenBlock: { blk = Plex.Get(nd, 11) }
            }
        }
        IfCondition EqualTo(blk, 0) ThenBlock: {
            blk = CAD_Topo.FilletPlexBlockingFace(CAD_Topo_FLoc.solid, vv, CAD_Topo_FLoc.f1, CAD_Topo_FLoc.f2)
        }
        CAD_Topo.FilletDumpI(" blk=", 5, blk)
        IfCondition EqualTo(blk, 0) ThenBlock: {
            CAD_Topo.FilletDumpS(" no blk\n", 8)
            ReturnValue(0)
        }
        surf = CAD_Store.Read(blk, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            CAD_Topo.FilletDumpS(" no surf\n", 9)
            ReturnValue(0)
        }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: {
            CAD_Topo.FilletDumpS(" not cyl\n", 9)
            ReturnValue(0)
        }
        zz = CAD_Store.Read(surf, 12)
        IfCondition EqualTo(CAD_Num.IsNeg(zz), 1) ThenBlock: { zz = Float_Sub(0, zz) }
        IfCondition EqualTo(CAD_Num.IsEqual(zz, 0x3FF0000000000000, 0), 0) ThenBlock: {
            CAD_Topo.FilletDumpS(" skip axis\n", 11)
            ReturnValue(0)
        }
        ocx = CAD_Store.Read(surf, 1)
        ocy = CAD_Store.Read(surf, 2)
        rr = CAD_Store.Read(surf, 13)
        af = CAD_Topo_FPlex.arc4
        IfCondition EqualTo(af, 1) ThenBlock: {
            rm = CAD_Topo.FilletPlexArcSharpRmaj(ocx, ocy)
            IfCondition EqualTo(CAD_Num.IsZero(rm, 0), 0) ThenBlock: { rr = rm }
            IfCondition EqualTo(CAD_Num.IsZero(rm, 0), 1) ThenBlock: {
                bp = CAD_Topo_FPlex.arc4b
                IfCondition NotEqual(bp, 0) ThenBlock: {
                    rm = ArrayGet(bp, 0)
                    IfCondition EqualTo(CAD_Num.IsZero(rm, 0), 0) ThenBlock: { rr = rm }
                }
            }
        }
        n1a = CAD_Topo_FLoc.n1z
        IfCondition EqualTo(CAD_Num.IsNeg(n1a), 1) ThenBlock: { n1a = Float_Sub(0, n1a) }
        n2a = CAD_Topo_FLoc.n2z
        IfCondition EqualTo(CAD_Num.IsNeg(n2a), 1) ThenBlock: { n2a = Float_Sub(0, n2a) }
        nx = CAD_Topo_FLoc.n1x
        ny = CAD_Topo_FLoc.n1y
        nz = CAD_Topo_FLoc.n1z
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(n1a, n2a)), 1) ThenBlock: {
            nx = CAD_Topo_FLoc.n2x
            ny = CAD_Topo_FLoc.n2y
            nz = CAD_Topo_FLoc.n2z
        }
        thx = Float_Add(cx, Float_Mul(CAD_Topo_FLoc.ln, nx))
        thy = Float_Add(cy, Float_Mul(CAD_Topo_FLoc.ln, ny))
        thz = Float_Add(cz, Float_Mul(CAD_Topo_FLoc.ln, nz))
        IfCondition EqualTo(CAD_Topo.FilletPlexHitZCyl(ocx, ocy, rr, thx, thy, thz), 0) ThenBlock: {
            CAD_Topo.FilletDumpS(" miss\n", 6)
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ab, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS(" s0\n", 4)
            ReturnValue(0)
        }
        CAD_Topo.FilletDumpU(" s_um=", 6, CAD_Topo_FLoc.ab)
        IfCondition EqualTo(which_end, 0) ThenBlock: {
            CAD_Topo_FLoc.c0x = Float_Add(CAD_Topo_FLoc.c0x, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edx))
            CAD_Topo_FLoc.c0y = Float_Add(CAD_Topo_FLoc.c0y, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edy))
            CAD_Topo_FLoc.c0z = Float_Add(CAD_Topo_FLoc.c0z, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edz))
        }
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            CAD_Topo_FLoc.c1x = Float_Add(CAD_Topo_FLoc.c1x, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edx))
            CAD_Topo_FLoc.c1y = Float_Add(CAD_Topo_FLoc.c1y, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edy))
            CAD_Topo_FLoc.c1z = Float_Add(CAD_Topo_FLoc.c1z, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edz))
        }
        CAD_Topo.FilletDumpS(" ok\n", 4)
        ReturnValue(1)
    }
}

// Mer for junc=5: lathe the fillet quarter-circle onto the blocker.
// Native mer is C + r (cosθ N1 + sinθ N2) in a plane ⊥ rail. Each of
// those points, shot along the rail, hits the south cylinder. Those
// hits lie on both cylinders — the real end, not a 3-point circle.
// dest 0/1 selects mer0/mer1 edge list. Returns first LINE edge.
Function.CAD_Topo.FilletPlexCylMer {
    Input: th: Integer
    Input: tw: Integer
    Input: face_h: Integer
    Input: dest: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dest, 0) ThenBlock: { CAD_Topo_FPlex.mer0n = 0 }
        IfCondition NotEqual(dest, 0) ThenBlock: { CAD_Topo_FPlex.mer1n = 0 }
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.mer0, 0) ThenBlock: { CAD_Topo_FPlex.mer0 = Allocate(16) }
        IfCondition EqualTo(CAD_Topo_FPlex.mer1, 0) ThenBlock: { CAD_Topo_FPlex.mer1 = Allocate(16) }
        IfCondition EqualTo(CAD_Topo_FPlex.mer0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.mer1, 0) ThenBlock: { ReturnValue(0) }
        surf = CAD_Store.Read(face_h, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: { ReturnValue(0) }
        ocx = CAD_Store.Read(surf, 1)
        ocy = CAD_Store.Read(surf, 2)
        rr = CAD_Store.Read(surf, 13)
        cx = CAD_Topo_FLoc.c0x
        cy = CAD_Topo_FLoc.c0y
        cz = CAD_Topo_FLoc.c0z
        IfCondition EqualTo(th, CAD_Topo_FLoc.va1) ThenBlock: {
            cx = CAD_Topo_FLoc.c1x
            cy = CAD_Topo_FLoc.c1y
            cz = CAD_Topo_FLoc.c1z
        }
        IfCondition EqualTo(th, CAD_Topo_FLoc.vb1) ThenBlock: {
            cx = CAD_Topo_FLoc.c1x
            cy = CAD_Topo_FLoc.c1y
            cz = CAD_Topo_FLoc.c1z
        }
        // 5 samples, θ = 0 .. π/2. k=0 is Th, k=4 is Tw.
        ArraySet(CAD_Topo_FLoc.ring, 48, th)
        k = 1
        WhileLoop LessThan(k, 4) {
            da = Float_Mul(Float_FromInt(k), 0x3FD921FB54442D18)
            ax = Float_Add(Float_Mul(CAD_Geom.Cos(da), CAD_Topo_FLoc.n1x), Float_Mul(CAD_Geom.Sin(da), CAD_Topo_FLoc.n2x))
            ay = Float_Add(Float_Mul(CAD_Geom.Cos(da), CAD_Topo_FLoc.n1y), Float_Mul(CAD_Geom.Sin(da), CAD_Topo_FLoc.n2y))
            az = Float_Add(Float_Mul(CAD_Geom.Cos(da), CAD_Topo_FLoc.n1z), Float_Mul(CAD_Geom.Sin(da), CAD_Topo_FLoc.n2z))
            pmx = Float_Add(cx, Float_Mul(CAD_Topo_FLoc.r, ax))
            pmy = Float_Add(cy, Float_Mul(CAD_Topo_FLoc.r, ay))
            pmz = Float_Add(cz, Float_Mul(CAD_Topo_FLoc.r, az))
            IfCondition EqualTo(CAD_Topo.FilletPlexHitZCyl(ocx, ocy, rr, pmx, pmy, pmz), 0) ThenBlock: { ReturnValue(0) }
            ArraySet(CAD_Topo_FLoc.ring, Add(48, k), CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt))
            IfCondition EqualTo(ArrayGet(CAD_Topo_FLoc.ring, Add(48, k)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpI("cyl-mer lathe k=", 16, k)
            CAD_Topo.FilletDumpI(" ", 1, Float_ToInt(ArrayGet(CAD_Topo_FLoc.pt, 0)))
            CAD_Topo.FilletDumpI(",", 1, Float_ToInt(ArrayGet(CAD_Topo_FLoc.pt, 1)))
            CAD_Topo.FilletDumpI(",", 1, Float_ToInt(ArrayGet(CAD_Topo_FLoc.pt, 2)))
            CAD_Topo.FilletDumpI(" s=", 3, Float_ToInt(CAD_Topo_FLoc.ab))
            CAD_Topo.FilletDumpS("\n", 1)
            k = Add(k, 1)
        }
        // Snap Tw along the rail onto the blocker (same as Th, not a C shift).
        pmx = Float_Add(cx, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.n2x))
        pmy = Float_Add(cy, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.n2y))
        pmz = Float_Add(cz, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.n2z))
        IfCondition EqualTo(CAD_Topo.FilletPlexHitZCyl(ocx, ocy, rr, pmx, pmy, pmz), 1) ThenBlock: {
            as0 = CAD_Topo_FLoc.ab
            IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as0, Float_Mul(0x4010000000000000, CAD_Topo_FLoc.r))), 1) ThenBlock: {
                CAD_Store.Write(tw, 0, ArrayGet(CAD_Topo_FLoc.pt, 0))
                CAD_Store.Write(tw, 1, ArrayGet(CAD_Topo_FLoc.pt, 1))
                CAD_Store.Write(tw, 2, ArrayGet(CAD_Topo_FLoc.pt, 2))
            }
        }
        ArraySet(CAD_Topo_FLoc.ring, 52, tw)
        n = 0
        k = 0
        WhileLoop LessThan(k, 4) {
            ArraySet(CAD_Topo_FLoc.pt, 0, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(48, k)), 0))
            ArraySet(CAD_Topo_FLoc.pt, 1, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(48, k)), 1))
            ArraySet(CAD_Topo_FLoc.pt, 2, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(48, k)), 2))
            ArraySet(CAD_Topo_FLoc.p1b, 0, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(49, k)), 0))
            ArraySet(CAD_Topo_FLoc.p1b, 1, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(49, k)), 1))
            ArraySet(CAD_Topo_FLoc.p1b, 2, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(49, k)), 2))
            mer = CAD_Topo.MakeEdge(ArrayGet(CAD_Topo_FLoc.ring, Add(48, k)), ArrayGet(CAD_Topo_FLoc.ring, Add(49, k)), CAD_Geom.MakeLine(CAD_Topo_FLoc.pt, CAD_Topo_FLoc.p1b))
            IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(dest, 0) ThenBlock: {
                ArraySet(CAD_Topo_FPlex.mer0, Add(n, 1), mer)
            }
            IfCondition NotEqual(dest, 0) ThenBlock: {
                ArraySet(CAD_Topo_FPlex.mer1, Add(n, 1), mer)
            }
            n = Add(n, 1)
            k = Add(k, 1)
        }
        IfCondition EqualTo(dest, 0) ThenBlock: {
            CAD_Topo_FPlex.mer0n = n
            ArraySet(CAD_Topo_FPlex.mer0, 0, n)
        }
        IfCondition NotEqual(dest, 0) ThenBlock: {
            CAD_Topo_FPlex.mer1n = n
            ArraySet(CAD_Topo_FPlex.mer1, 0, n)
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("cyl-mer lathe n=", 16, n)
        CAD_Topo.FilletDumpI(" dest=", 6, dest)
        CAD_Topo.FilletDumpS("\n", 1)
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Topo_FPlex.mer0, 1)) }
        ReturnValue(ArrayGet(CAD_Topo_FPlex.mer1, 1))
    }
}

Function.CAD_Topo.FilletPlexMerReset {
    Output: Integer
    Body: {
        CAD_Topo_FPlex.mer0n = 0
        CAD_Topo_FPlex.mer1n = 0
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletPlexStashTh {
    Input: th: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.th0, 0) ThenBlock: {
            CAD_Topo_FPlex.th0 = th
            ReturnValue(1)
        }
        IfCondition EqualTo(CAD_Topo_FPlex.th1, 0) ThenBlock: {
            IfCondition NotEqual(th, CAD_Topo_FPlex.th0) ThenBlock: { CAD_Topo_FPlex.th1 = th }
        }
        ReturnValue(1)
    }
}

// Open CIRCLE on the blocker that still owns vh (the south top-arc).
Function.CAD_Topo.FilletPlexJunc5FindHost {
    Input: face_h: Integer
    Input: vert_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(0) }
        lp = CAD_Store.Read(face_h, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        ce = CAD_Store.Read(lp, 0)
        hd = ce
        g = 0
        WhileLoop LessThan(g, 16) {
            IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(0) }
            e = CAD_Store.Read(ce, 0)
            IfCondition NotEqual(e, 0) ThenBlock: {
                ok = 0
                IfCondition EqualTo(CAD_Store.Read(e, 0), vert_h) ThenBlock: { ok = 1 }
                IfCondition EqualTo(CAD_Store.Read(e, 1), vert_h) ThenBlock: { ok = 1 }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    IfCondition NotEqual(CAD_Store.Read(e, 0), CAD_Store.Read(e, 1)) ThenBlock: {
                        crv = CAD_Store.Read(e, 2)
                        IfCondition NotEqual(crv, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: { ReturnValue(e) }
                        }
                    }
                }
            }
            ce = CAD_Store.Read(ce, 2)
            IfCondition EqualTo(ce, hd) ThenBlock: { ReturnValue(0) }
            g = Add(g, 1)
        }
        ReturnValue(0)
    }
}

// Rewrite a LINE curve from the edge's current vertices.
Function.CAD_Topo.FilletPlexRefreshLine {
    Input: edge_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        crv = CAD_Store.Read(edge_h, 2)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(crv, 1, CAD_Store.Read(v0, 0))
        CAD_Store.Write(crv, 2, CAD_Store.Read(v0, 1))
        CAD_Store.Write(crv, 3, CAD_Store.Read(v0, 2))
        CAD_Store.Write(crv, 4, Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0)))
        CAD_Store.Write(crv, 5, Float_Sub(CAD_Store.Read(v1, 1), CAD_Store.Read(v0, 1)))
        CAD_Store.Write(crv, 6, Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2)))
        ReturnValue(1)
    }
}

// Emit-time junc=5: Th onto the end-face CIRCLE (smaller |s|), then
// caller sews like a single-edge fillet (CircleEnd arc, retarget line).
// nsel!=1 is a cope — do not steal that vertex.
Function.CAD_Topo.FilletPlexJunc5EmitEnd {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FLoc.endf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.vv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FilletIRCountAt(CAD_Topo_FLoc.vv), 1) ThenBlock: { ReturnValue(0) }
        th = CAD_Topo_FLoc.aa
        gen = CAD_Topo_FLoc.ega
        ab = CAD_Topo_FLoc.n1z
        IfCondition EqualTo(CAD_Num.IsNeg(ab), 1) ThenBlock: { ab = Float_Sub(0, ab) }
        aa = CAD_Topo_FLoc.n2z
        IfCondition EqualTo(CAD_Num.IsNeg(aa), 1) ThenBlock: { aa = Float_Sub(0, aa) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(ab, aa)), 1) ThenBlock: {
            th = CAD_Topo_FLoc.bb
            gen = CAD_Topo_FLoc.egb
        }
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        hit = CAD_Topo.FilletPlexJunc5FindHost(CAD_Topo_FLoc.endf, CAD_Topo_FLoc.vv)
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        crv = CAD_Store.Read(hit, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: { CAD_Topo_FLoc.pt = Allocate(32) }
        IfCondition EqualTo(CAD_Topo.FilletPlexHitZCyl(CAD_Store.Read(crv, 1), CAD_Store.Read(crv, 2), CAD_Store.Read(crv, 10), CAD_Store.Read(th, 0), CAD_Store.Read(th, 1), CAD_Store.Read(th, 2)), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpS("j5 emit miss\n", 13)
            ReturnValue(0)
        }
        CAD_Store.Write(th, 0, ArrayGet(CAD_Topo_FLoc.pt, 0))
        CAD_Store.Write(th, 1, ArrayGet(CAD_Topo_FLoc.pt, 1))
        CAD_Store.Write(th, 2, ArrayGet(CAD_Topo_FLoc.pt, 2))
        CAD_Topo.FilletPlexRefreshLine(gen)
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("j5 emit s=", 10, Float_ToInt(CAD_Topo_FLoc.ab))
        CAD_Topo.FilletDumpI(" Th'=", 5, Float_ToInt(CAD_Store.Read(th, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th, 1)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th, 2)))
        CAD_Topo.FilletDumpI(" R=", 3, Float_ToInt(CAD_Store.Read(crv, 10)))
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(1)
    }
}

// During EdgeLocal skip: record this junc=5 end. Th is the lid contact
// (|Nz| larger). Host is the blocker's open circle at V.
Function.CAD_Topo.FilletPlexStashJunc5 {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FPlex.j5, 0) ThenBlock: { CAD_Topo_FPlex.j5 = Allocate(512) }
        IfCondition EqualTo(CAD_Topo_FPlex.j5, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CAD_Topo_FPlex.j5n, 8) ThenBlock: { ReturnValue(0) }
        th = CAD_Topo_FLoc.aa
        tw = CAD_Topo_FLoc.bb
        gen = CAD_Topo_FLoc.ega
        ab = CAD_Topo_FLoc.n1z
        IfCondition EqualTo(CAD_Num.IsNeg(ab), 1) ThenBlock: { ab = Float_Sub(0, ab) }
        aa = CAD_Topo_FLoc.n2z
        IfCondition EqualTo(CAD_Num.IsNeg(aa), 1) ThenBlock: { aa = Float_Sub(0, aa) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(ab, aa)), 1) ThenBlock: {
            th = CAD_Topo_FLoc.bb
            tw = CAD_Topo_FLoc.aa
            gen = CAD_Topo_FLoc.egb
        }
        cx = CAD_Topo_FLoc.c0x
        cy = CAD_Topo_FLoc.c0y
        cz = CAD_Topo_FLoc.c0z
        IfCondition EqualTo(CAD_Topo_FLoc.ei, 1) ThenBlock: {
            cx = CAD_Topo_FLoc.c1x
            cy = CAD_Topo_FLoc.c1y
            cz = CAD_Topo_FLoc.c1z
        }
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.r, 0), 1) ThenBlock: { ReturnValue(0) }
        base = Multiply(CAD_Topo_FPlex.j5n, 20)
        ArraySet(CAD_Topo_FPlex.j5, base, CAD_Topo_FLoc.vv)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 1), th)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 2), tw)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 3), CAD_Topo_FLoc.ar)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 4), CAD_Topo_FLoc.endf)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 5), CAD_Topo_FLoc.edx)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 6), CAD_Topo_FLoc.edy)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 7), CAD_Topo_FLoc.edz)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 8), cx)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 9), cy)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 10), cz)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 11), CAD_Topo_FLoc.r)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 12), gen)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 13), Float_Div(Float_Sub(CAD_Store.Read(th, 0), cx), CAD_Topo_FLoc.r))
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 14), Float_Div(Float_Sub(CAD_Store.Read(th, 1), cy), CAD_Topo_FLoc.r))
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 15), Float_Div(Float_Sub(CAD_Store.Read(th, 2), cz), CAD_Topo_FLoc.r))
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 16), Float_Div(Float_Sub(CAD_Store.Read(tw, 0), cx), CAD_Topo_FLoc.r))
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 17), Float_Div(Float_Sub(CAD_Store.Read(tw, 1), cy), CAD_Topo_FLoc.r))
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 18), Float_Div(Float_Sub(CAD_Store.Read(tw, 2), cz), CAD_Topo_FLoc.r))
        hit = CAD_Topo.FilletPlexJunc5FindHost(CAD_Topo_FLoc.endf, CAD_Topo_FLoc.vv)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 19), hit)
        IfCondition EqualTo(CAD_Topo_FPlex.j5host, 0) ThenBlock: { CAD_Topo_FPlex.j5host = hit }
        CAD_Topo_FPlex.j5n = Add(CAD_Topo_FPlex.j5n, 1)
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("j5 stash n=", 11, CAD_Topo_FPlex.j5n)
        CAD_Topo.FilletDumpI(" Th=", 4, Float_ToInt(CAD_Store.Read(th, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th, 1)))
        CAD_Topo.FilletDumpI(" Tw=", 4, Float_ToInt(CAD_Store.Read(tw, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(tw, 1)))
        CAD_Topo.FilletDumpI(" host=", 6, hit)
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(1)
    }
}

// Open CIRCLE whose two verts are the two junc=5 V's — the south
// top-arc, not whichever circle BlockingFace saw first.
Function.CAD_Topo.FilletPlexJunc5ResolveHost {
    Output: Integer
    Body: {
        IfCondition LessThan(CAD_Topo_FPlex.j5n, 2) ThenBlock: { ReturnValue(0) }
        vh0 = ArrayGet(CAD_Topo_FPlex.j5, 0)
        vh1 = ArrayGet(CAD_Topo_FPlex.j5, 20)
        IfCondition EqualTo(vh0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vh1, 0) ThenBlock: { ReturnValue(0) }
        hit = 0
        e = ArrayGet(CAD_Topo_FPlex.j5, 19)
        IfCondition NotEqual(e, 0) ThenBlock: {
            ok = 0
            IfCondition EqualTo(CAD_Store.Read(e, 0), vh0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(e, 1), vh1) ThenBlock: { ok = 1 }
            }
            IfCondition EqualTo(CAD_Store.Read(e, 0), vh1) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(e, 1), vh0) ThenBlock: { ok = 1 }
            }
            IfCondition EqualTo(ok, 1) ThenBlock: { hit = e }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            e = ArrayGet(CAD_Topo_FPlex.j5, 39)
            IfCondition NotEqual(e, 0) ThenBlock: {
                ok = 0
                IfCondition EqualTo(CAD_Store.Read(e, 0), vh0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(e, 1), vh1) ThenBlock: { ok = 1 }
                }
                IfCondition EqualTo(CAD_Store.Read(e, 0), vh1) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(e, 1), vh0) ThenBlock: { ok = 1 }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: { hit = e }
            }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FPlex.solid, 0) ThenBlock: { ReturnValue(0) }
            sh = CAD_Store.Read(CAD_Topo_FPlex.solid, 0)
            sg = 0
            WhileLoop NotEqual(sh, 0) {
                IfCondition GreaterThan(sg, 64) ThenBlock: { sh = 0 }
                IfCondition NotEqual(sh, 0) ThenBlock: {
                    face = CAD_Store.Read(sh, 0)
                    fg = 0
                    WhileLoop NotEqual(face, 0) {
                        IfCondition GreaterThan(fg, 4096) ThenBlock: { face = 0 }
                        IfCondition NotEqual(face, 0) ThenBlock: {
                            lp = CAD_Store.Read(face, 1)
                            IfCondition NotEqual(lp, 0) ThenBlock: {
                                ce = CAD_Store.Read(lp, 0)
                                hd = ce
                                g = 0
                                WhileLoop LessThan(g, 16) {
                                    IfCondition EqualTo(ce, 0) ThenBlock: { g = 16 }
                                    IfCondition NotEqual(ce, 0) ThenBlock: {
                                        e = CAD_Store.Read(ce, 0)
                                        IfCondition NotEqual(e, 0) ThenBlock: {
                                            IfCondition NotEqual(CAD_Store.Read(e, 0), CAD_Store.Read(e, 1)) ThenBlock: {
                                                crv = CAD_Store.Read(e, 2)
                                                IfCondition NotEqual(crv, 0) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                                                        ok = 0
                                                        IfCondition EqualTo(CAD_Store.Read(e, 0), vh0) ThenBlock: {
                                                            IfCondition EqualTo(CAD_Store.Read(e, 1), vh1) ThenBlock: { ok = 1 }
                                                        }
                                                        IfCondition EqualTo(CAD_Store.Read(e, 0), vh1) ThenBlock: {
                                                            IfCondition EqualTo(CAD_Store.Read(e, 1), vh0) ThenBlock: { ok = 1 }
                                                        }
                                                        IfCondition EqualTo(ok, 1) ThenBlock: {
                                                            hit = e
                                                            g = 16
                                                            face = 0
                                                            sh = 0
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        IfCondition LessThan(g, 16) ThenBlock: {
                                            ce = CAD_Store.Read(ce, 2)
                                            IfCondition EqualTo(ce, hd) ThenBlock: { g = 16 }
                                        }
                                    }
                                    g = Add(g, 1)
                                }
                            }
                            IfCondition NotEqual(face, 0) ThenBlock: { face = CAD_Store.Read(face, 3) }
                        }
                        fg = Add(fg, 1)
                    }
                    IfCondition NotEqual(sh, 0) ThenBlock: { sh = CAD_Store.Read(sh, 2) }
                }
                sg = Add(sg, 1)
            }
        }
        CAD_Topo_FPlex.j5host = hit
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("j5 host=", 8, hit)
        IfCondition NotEqual(hit, 0) ThenBlock: {
            CAD_Topo.FilletDumpI(" R=", 3, Float_ToInt(CAD_Store.Read(CAD_Store.Read(hit, 2), 10)))
        }
        CAD_Topo.FilletDumpS("\n", 1)
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Th along the rail onto the SHARED host circle. Smaller |s| only.
Function.CAD_Topo.FilletPlexJunc5Shift {
    Input: i: Integer
    Output: Integer
    Body: {
        base = Multiply(i, 20)
        th = ArrayGet(CAD_Topo_FPlex.j5, Add(base, 1))
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        hit = CAD_Topo_FPlex.j5host
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        crv = CAD_Store.Read(hit, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 2) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.edx = ArrayGet(CAD_Topo_FPlex.j5, Add(base, 5))
        CAD_Topo_FLoc.edy = ArrayGet(CAD_Topo_FPlex.j5, Add(base, 6))
        CAD_Topo_FLoc.edz = ArrayGet(CAD_Topo_FPlex.j5, Add(base, 7))
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: { CAD_Topo_FLoc.pt = Allocate(32) }
        IfCondition EqualTo(CAD_Topo.FilletPlexHitZCyl(CAD_Store.Read(crv, 1), CAD_Store.Read(crv, 2), CAD_Store.Read(crv, 10), CAD_Store.Read(th, 0), CAD_Store.Read(th, 1), CAD_Store.Read(th, 2)), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpI("j5 shift miss i=", 16, i)
            CAD_Topo.FilletDumpS("\n", 1)
            ReturnValue(0)
        }
        CAD_Store.Write(th, 0, ArrayGet(CAD_Topo_FLoc.pt, 0))
        CAD_Store.Write(th, 1, ArrayGet(CAD_Topo_FLoc.pt, 1))
        CAD_Store.Write(th, 2, ArrayGet(CAD_Topo_FLoc.pt, 2))
        CAD_Topo.FilletPlexRefreshLine(ArrayGet(CAD_Topo_FPlex.j5, Add(base, 12)))
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("j5 shift i=", 11, i)
        CAD_Topo.FilletDumpI(" s=", 3, Float_ToInt(CAD_Topo_FLoc.ab))
        CAD_Topo.FilletDumpI(" Th'=", 5, Float_ToInt(CAD_Store.Read(th, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th, 1)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th, 2)))
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(1)
    }
}

// Replace the native mer coedge with the CylMer polyline on the fillet.
Function.CAD_Topo.FilletPlexJunc5ReplaceMer {
    Input: i: Integer
    Output: Integer
    Body: {
        base = Multiply(i, 20)
        old = ArrayGet(CAD_Topo_FPlex.j5, Add(base, 3))
        th = ArrayGet(CAD_Topo_FPlex.j5, Add(base, 1))
        IfCondition EqualTo(old, 0) ThenBlock: { ReturnValue(0) }
        n = CAD_Topo_FPlex.mer0n
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        ce = CAD_Store.Read(old, 3)
        IfCondition EqualTo(ce, 0) ThenBlock: { ce = CAD_Store.Read(old, 4) }
        IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(0) }
        org = CAD_Store.Read(ce, 5)
        tw = ArrayGet(CAD_Topo_FPlex.j5, Add(base, 2))
        IfCondition NotEqual(org, th) ThenBlock: {
            IfCondition NotEqual(org, tw) ThenBlock: { org = th }
        }
        e0 = ArrayGet(CAD_Topo_FPlex.mer0, 1)
        IfCondition EqualTo(e0, 0) ThenBlock: { ReturnValue(0) }
        fwd = 0
        IfCondition EqualTo(CAD_Store.Read(e0, 0), org) ThenBlock: { fwd = 1 }
        IfCondition EqualTo(CAD_Store.Read(e0, 1), org) ThenBlock: { fwd = 1 }
        ii = 1
        IfCondition EqualTo(fwd, 0) ThenBlock: { ii = n }
        mer = ArrayGet(CAD_Topo_FPlex.mer0, ii)
        ce = CAD_Topo.CoedgeSwapEdge(ce, mer, org)
        IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(0) }
        prev = CAD_Store.Read(mer, 1)
        IfCondition EqualTo(org, CAD_Store.Read(mer, 1)) ThenBlock: { prev = CAD_Store.Read(mer, 0) }
        k = 2
        WhileLoop LessThan(k, Add(n, 1)) {
            ii = k
            IfCondition EqualTo(fwd, 0) ThenBlock: { ii = Subtract(Add(n, 1), k) }
            mer = ArrayGet(CAD_Topo_FPlex.mer0, ii)
            CAD_Topo_FLoc.vv = 1
            IfCondition NotEqual(CAD_Store.Read(mer, 0), prev) ThenBlock: { CAD_Topo_FLoc.vv = 0 }
            CAD_Topo_FLoc.cyl = CAD_Topo.MakeCoedge(mer, prev, CAD_Topo_FLoc.vv)
            IfCondition NotEqual(CAD_Topo_FLoc.cyl, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(mer, 3), 0) ThenBlock: {
                    CAD_Store.Write(mer, 3, CAD_Topo_FLoc.cyl)
                }
                CAD_Topo.CoedgeInsertAfter(ce, CAD_Topo_FLoc.cyl)
                ce = CAD_Topo_FLoc.cyl
            }
            IfCondition EqualTo(CAD_Topo_FLoc.vv, 1) ThenBlock: { prev = CAD_Store.Read(mer, 1) }
            IfCondition EqualTo(CAD_Topo_FLoc.vv, 0) ThenBlock: { prev = CAD_Store.Read(mer, 0) }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

// Retarget the south vertical V→Tw and sew the mer onto the blocker.
Function.CAD_Topo.FilletPlexJunc5SewSouth {
    Input: i: Integer
    Output: Integer
    Body: {
        base = Multiply(i, 20)
        vh = ArrayGet(CAD_Topo_FPlex.j5, base)
        th = ArrayGet(CAD_Topo_FPlex.j5, Add(base, 1))
        tw = ArrayGet(CAD_Topo_FPlex.j5, Add(base, 2))
        blk = ArrayGet(CAD_Topo_FPlex.j5, Add(base, 4))
        IfCondition EqualTo(blk, 0) ThenBlock: { ReturnValue(0) }
        lp = CAD_Store.Read(blk, 1)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        ce = CAD_Store.Read(lp, 0)
        hd = ce
        ce_v = 0
        vert_e = 0
        g = 0
        WhileLoop LessThan(g, 16) {
            IfCondition EqualTo(ce, 0) ThenBlock: { g = 16 }
            IfCondition NotEqual(ce, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(ce, 5), vh) ThenBlock: { ce_v = ce }
                e = CAD_Store.Read(ce, 0)
                IfCondition NotEqual(e, 0) ThenBlock: {
                    ok = 0
                    IfCondition EqualTo(CAD_Store.Read(e, 0), vh) ThenBlock: { ok = 1 }
                    IfCondition EqualTo(CAD_Store.Read(e, 1), vh) ThenBlock: { ok = 1 }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        crv = CAD_Store.Read(e, 2)
                        IfCondition NotEqual(crv, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(crv, 0), 1) ThenBlock: { vert_e = e }
                        }
                    }
                }
                ce = CAD_Store.Read(ce, 2)
                IfCondition EqualTo(ce, hd) ThenBlock: { g = 16 }
            }
            g = Add(g, 1)
        }
        IfCondition EqualTo(ce_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vert_e, 0) ThenBlock: { ReturnValue(0) }
        prv = CAD_Store.Read(ce_v, 3)
        CAD_Topo.EdgeRetargetVert(vert_e, vh, tw)
        CAD_Topo.FilletPlexRefreshLine(vert_e)
        start = tw
        IfCondition EqualTo(CAD_Store.Read(ce_v, 0), vert_e) ThenBlock: { start = th }
        IfCondition EqualTo(CAD_Topo.FilletPlexSewMer(prv, start, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("j5 sew i=", 9, i)
        CAD_Topo.FilletDumpI(" startZ=", 8, Float_ToInt(CAD_Store.Read(start, 2)))
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(1)
    }
}

// One host remainder Th–Th on BOTH twins. Origin is the host's V
// mapped to that end's Th — not prev-dest (south prev is still V).
Function.CAD_Topo.FilletPlexClipHostArc {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FPlex.th0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.th1, 0) ThenBlock: { ReturnValue(0) }
        hit = CAD_Topo_FPlex.j5host
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpS("j5 clip no host\n", 16)
            ReturnValue(0)
        }
        crv = CAD_Store.Read(hit, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        ov0 = CAD_Store.Read(hit, 0)
        ov1 = CAD_Store.Read(hit, 1)
        aa = CAD_Topo_FPlex.th0
        bb = CAD_Topo_FPlex.th1
        IfCondition EqualTo(ov0, ArrayGet(CAD_Topo_FPlex.j5, 20)) ThenBlock: {
            aa = CAD_Topo_FPlex.th1
            bb = CAD_Topo_FPlex.th0
        }
        IfCondition EqualTo(ov0, ArrayGet(CAD_Topo_FPlex.j5, 0)) ThenBlock: {
            aa = CAD_Topo_FPlex.th0
            bb = CAD_Topo_FPlex.th1
        }
        mer = CAD_Topo.MakeMinorArcEdge(aa, bb, crv)
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("j5 clip Th0=", 12, Float_ToInt(CAD_Store.Read(CAD_Topo_FPlex.th0, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(CAD_Topo_FPlex.th0, 1)))
        CAD_Topo.FilletDumpI(" Th1=", 5, Float_ToInt(CAD_Store.Read(CAD_Topo_FPlex.th1, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(CAD_Topo_FPlex.th1, 1)))
        CAD_Topo.FilletDumpS("\n", 1)
        nswap = 0
        ei = 3
        WhileLoop LessThan(ei, 5) {
            ce = CAD_Store.Read(hit, ei)
            IfCondition NotEqual(ce, 0) ThenBlock: {
                org = CAD_Store.Read(ce, 5)
                IfCondition EqualTo(org, ov0) ThenBlock: { org = aa }
                IfCondition EqualTo(org, ov1) ThenBlock: { org = bb }
                ok = 0
                IfCondition EqualTo(org, aa) ThenBlock: { ok = 1 }
                IfCondition EqualTo(org, bb) ThenBlock: { ok = 1 }
                CAD_Topo.FilletDumpI("j5 clip ce=", 11, ei)
                CAD_Topo.FilletDumpI(" ok=", 4, ok)
                IfCondition NotEqual(org, 0) ThenBlock: {
                    CAD_Topo.FilletDumpI(" org=", 5, Float_ToInt(CAD_Store.Read(org, 0)))
                    CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(org, 1)))
                }
                CAD_Topo.FilletDumpS("\n", 1)
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    CAD_Topo.CoedgeSwapEdge(ce, mer, org)
                    nswap = Add(nswap, 1)
                }
            }
            ei = Add(ei, 1)
        }
        CAD_Topo.FilletDumpI("j5 clip R=", 10, Float_ToInt(CAD_Store.Read(crv, 10)))
        CAD_Topo.FilletDumpI(" sp=", 4, Float_ToInt(Float_Mul(CAD_Store.Read(CAD_Store.Read(mer, 2), 12), 0x408F400000000000)))
        CAD_Topo.FilletDumpI(" nswap=", 7, nswap)
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(nswap)
    }
}

// One junc=5 vertex: shift Th onto the shared host, leave native mer.
Function.CAD_Topo.FilletPlexJunc5At {
    Input: i: Integer
    Output: Integer
    Body: {
        th = ArrayGet(CAD_Topo_FPlex.j5, Add(Multiply(i, 20), 1))
        IfCondition EqualTo(CAD_Topo.FilletPlexJunc5Shift(i), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FilletPlexStashTh(th)
        ReturnValue(1)
    }
}

// Vertex function for every stashed junc=5 end, then one host clip.
Function.CAD_Topo.FilletPlexJunc5 {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FPlex.j5n, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FLoc.solid = CAD_Topo_FPlex.solid
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("j5 run n=", 9, CAD_Topo_FPlex.j5n)
        CAD_Topo.FilletDumpS("\n", 1)
        IfCondition EqualTo(CAD_Topo.FilletPlexJunc5ResolveHost(), 0) ThenBlock: {
            CAD_Topo.FilletDumpS("j5 no shared host\n", 18)
            ReturnValue(1)
        }
        CAD_Topo_FPlex.th0 = 0
        CAD_Topo_FPlex.th1 = 0
        i = 0
        ok = 0
        WhileLoop LessThan(i, CAD_Topo_FPlex.j5n) {
            IfCondition EqualTo(CAD_Topo.FilletPlexJunc5At(i), 1) ThenBlock: { ok = Add(ok, 1) }
            i = Add(i, 1)
        }
        IfCondition EqualTo(ok, CAD_Topo_FPlex.j5n) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_FPlex.th0, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FPlex.th1, 0) ThenBlock: {
                    CAD_Topo.FilletPlexClipHostArc()
                }
            }
        }
        CAD_Topo.FilletDumpI("j5 done ok=", 11, ok)
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletPlexMerBankN {
    Input: dest: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(CAD_Topo_FPlex.mer0n) }
        ReturnValue(CAD_Topo_FPlex.mer1n)
    }
}

Function.CAD_Topo.FilletPlexMerBankE {
    Input: dest: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Topo_FPlex.mer0, i)) }
        ReturnValue(ArrayGet(CAD_Topo_FPlex.mer1, i))
    }
}

// Append mer-chain coedges to FLoc.ring starting at idx, walking from
// start_v along the bank. Returns the next free idx.
Function.CAD_Topo.FilletPlexFillMerRing {
    Input: idx: Integer
    Input: start_v: Integer
    Input: dest: Integer
    Output: Integer
    Body: {
        n = CAD_Topo.FilletPlexMerBankN(dest)
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(idx) }
        e0 = CAD_Topo.FilletPlexMerBankE(dest, 1)
        fwd = 0
        IfCondition EqualTo(CAD_Store.Read(e0, 0), start_v) ThenBlock: { fwd = 1 }
        IfCondition EqualTo(CAD_Store.Read(e0, 1), start_v) ThenBlock: { fwd = 1 }
        prev = start_v
        k = 1
        WhileLoop LessThan(k, Add(n, 1)) {
            i = k
            IfCondition EqualTo(fwd, 0) ThenBlock: { i = Subtract(Add(n, 1), k) }
            mer = CAD_Topo.FilletPlexMerBankE(dest, i)
            CAD_Topo_FLoc.which = 1
            IfCondition NotEqual(CAD_Store.Read(mer, 0), prev) ThenBlock: { CAD_Topo_FLoc.which = 0 }
            ArraySet(CAD_Topo_FLoc.ring, idx, CAD_Topo.MakeCoedge(mer, prev, CAD_Topo_FLoc.which))
            IfCondition EqualTo(CAD_Store.Read(mer, 3), 0) ThenBlock: {
                CAD_Store.Write(mer, 3, ArrayGet(CAD_Topo_FLoc.ring, idx))
            }
            IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
                prev = CAD_Store.Read(mer, 1)
            }
            IfCondition EqualTo(CAD_Topo_FLoc.which, 0) ThenBlock: {
                prev = CAD_Store.Read(mer, 0)
            }
            idx = Add(idx, 1)
            k = Add(k, 1)
        }
        ReturnValue(idx)
    }
}

// Insert mer-chain coedges on the blocking face after ce_prev, from hd to ln.
Function.CAD_Topo.FilletPlexSewMer {
    Input: ce_prev: Integer
    Input: hd: Integer
    Input: dest: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ce_prev, 0) ThenBlock: { ReturnValue(0) }
        n = CAD_Topo.FilletPlexMerBankN(dest)
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        e0 = CAD_Topo.FilletPlexMerBankE(dest, 1)
        fwd = 0
        IfCondition EqualTo(CAD_Store.Read(e0, 0), hd) ThenBlock: { fwd = 1 }
        IfCondition EqualTo(CAD_Store.Read(e0, 1), hd) ThenBlock: { fwd = 1 }
        prev = hd
        k = 1
        WhileLoop LessThan(k, Add(n, 1)) {
            i = k
            IfCondition EqualTo(fwd, 0) ThenBlock: { i = Subtract(Add(n, 1), k) }
            mer = CAD_Topo.FilletPlexMerBankE(dest, i)
            CAD_Topo_FLoc.vv = 1
            IfCondition NotEqual(CAD_Store.Read(mer, 0), prev) ThenBlock: { CAD_Topo_FLoc.vv = 0 }
            CAD_Topo_FLoc.cyl = CAD_Topo.MakeCoedge(mer, prev, CAD_Topo_FLoc.vv)
            IfCondition NotEqual(CAD_Topo_FLoc.cyl, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(mer, 4), 0) ThenBlock: {
                    CAD_Store.Write(mer, 4, CAD_Topo_FLoc.cyl)
                    IfCondition NotEqual(CAD_Store.Read(mer, 3), 0) ThenBlock: {
                        CAD_Topo.LinkTwins(CAD_Store.Read(mer, 3), CAD_Topo_FLoc.cyl)
                    }
                }
                CAD_Topo.CoedgeInsertAfter(ce_prev, CAD_Topo_FLoc.cyl)
                ce_prev = CAD_Topo_FLoc.cyl
            }
            IfCondition EqualTo(CAD_Topo_FLoc.vv, 1) ThenBlock: {
                prev = CAD_Store.Read(mer, 1)
            }
            IfCondition EqualTo(CAD_Topo_FLoc.vv, 0) ThenBlock: {
                prev = CAD_Store.Read(mer, 0)
            }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletPlexIdentifyWalls {
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(i, 11), 1) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FilletIRGet(i, 21), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FilletIRGet(i, 2), 0) ThenBlock: {
                        m = CAD_Topo.FilletPlexIdentifyPair1(i)
                        CAD_Topo.FilletIRPut(i, 21, m)
                        PrintMessage("fillet plex id pair1 i=")
                        PrintNumber(i)
                        PrintMessage(" mode=")
                        PrintNumber(m)
                        PrintMessage("\n")
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// ----------------------------------------------------------------------------
// CLASSIFY: Query local ring properties to resolve solver method per node
// ----------------------------------------------------------------------------

Function.CAD_Topo.FilletPlexClassifyJunction {
    Output: Integer
    Body: {
        head = CAD_Topo_FPlex.head
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(0) }

        total_nodes = CAD_Topo_FPlex.count
        n_line = Plex.RingCountType(head, 0, 1)
        n_circ = Plex.RingCountType(head, 0, 2)
        is_rim_cycle = CAD_Topo.FilletIRRimCycle()

        cur = head
        i = 0
        WhileLoop LessThan(i, total_nodes) {
            nd_type = Plex.Type(cur)
            edge_h = Plex.Get(cur, 0)
            junc_type = 0
            method = 1 // Default SEQUENTIAL
            f1 = Plex.Get(cur, 1)
            f2 = Plex.Get(cur, 2)
            b0 = CAD_Topo.FilletPlexIdentifyRailArc(Plex.Get(cur, 3), f1, f2)
            b1 = CAD_Topo.FilletPlexIdentifyRailArc(Plex.Get(cur, 4), f1, f2)
            j0 = CAD_Topo.FilletPlexJuncAt(Plex.Get(cur, 3), f1, f2)
            j1 = CAD_Topo.FilletPlexJuncAt(Plex.Get(cur, 4), f1, f2)
            IfCondition NotEqual(b0, 0) ThenBlock: { Plex.Set(cur, 10, b0) }
            IfCondition NotEqual(b1, 0) ThenBlock: { Plex.Set(cur, 11, b1) }
            junc_type = j0
            IfCondition EqualTo(junc_type, 0) ThenBlock: { junc_type = j1 }

            IfCondition EqualTo(total_nodes, 1) ThenBlock: {
                IfCondition EqualTo(nd_type, 2) ThenBlock: {
                    // Single arc/circle edge: PLANE_CYL solver handles both top rims and boss-base joins
                    method = 6 // PLANE_CYL
                } ElseBlock: {
                    method = 9 // EDGE_LOCAL
                }
            } ElseBlock: {
                IfCondition EqualTo(n_line, total_nodes) ThenBlock: {
                    // All-LINE n≥2: plex method 1. Do not call JoinFootOk /
                    // HasGlue — those read leftover FSeq (prior sequential
                    // n, null vert, forgotten edge handles) and GPF. Open
                    // rails vs an unselected curve stay sequential; junc=5
                    // is already on the node from IdentifyRailArc / JuncAt.
                    method = 1
                } ElseBlock: {
                    IfCondition EqualTo(n_circ, total_nodes) ThenBlock: {
                        // All CIRCLE edges
                        IfCondition EqualTo(is_rim_cycle, 1) ThenBlock: {
                            method = 4 // CYL_TOP_RIM
                        } ElseBlock: {
                            method = 2 // EMIT_CHAIN
                        }
                    } ElseBlock: {
                        // MIXED LINE+CIRCLE: one emit chain strings N junction types.
                        // Coplanar is a local query at the vertex (two LINEs → cope;
                        // 3+ selected edges → XYZ sphere), not a batch recipe.
                        method = 2
                        vh = Plex.Get(cur, 3)
                        n_share = 0
                        n_ln = 0
                        n_ar = 0
                        t = head
                        ti = 0
                        WhileLoop LessThan(ti, total_nodes) {
                            share = 0
                            IfCondition EqualTo(Plex.Get(t, 3), vh) ThenBlock: { share = 1 }
                            IfCondition EqualTo(Plex.Get(t, 4), vh) ThenBlock: { share = 1 }
                            IfCondition EqualTo(share, 1) ThenBlock: {
                                n_share = Add(n_share, 1)
                                IfCondition EqualTo(Plex.Type(t), 1) ThenBlock: { n_ln = Add(n_ln, 1) }
                                IfCondition EqualTo(Plex.Type(t), 2) ThenBlock: { n_ar = Add(n_ar, 1) }
                            }
                            t = Plex.RingNext(t, 0)
                            ti = Add(ti, 1)
                        }
                        IfCondition GreaterThan(n_share, 2) ThenBlock: {
                            IfCondition EqualTo(j0, 0) ThenBlock: { j0 = 4 }
                        } ElseBlock: {
                            IfCondition GreaterThan(n_ln, 1) ThenBlock: {
                                IfCondition EqualTo(j0, 0) ThenBlock: { j0 = 1 }
                            } ElseBlock: {
                                IfCondition GreaterThan(n_ln, 0) ThenBlock: {
                                    IfCondition EqualTo(j0, 0) ThenBlock: { j0 = 2 }
                                } ElseBlock: {
                                    IfCondition EqualTo(j0, 0) ThenBlock: { j0 = 3 }
                                }
                            }
                        }
                        junc_type = j0
                        IfCondition EqualTo(junc_type, 0) ThenBlock: { junc_type = j1 }
                    }
                }
            }

            Plex.Set(cur, 6, method)
            Plex.Set(cur, 7, junc_type)
            Plex.Set(cur, 12, j1)
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpI("plex nd=", 8, i)
            CAD_Topo.FilletDumpI(" j0=", 4, j0)
            CAD_Topo.FilletDumpI(" j1=", 4, j1)
            CAD_Topo.FilletDumpI(" ns0=", 5, CAD_Topo.FilletIRCountAt(Plex.Get(cur, 3)))
            CAD_Topo.FilletDumpI(" ns1=", 5, CAD_Topo.FilletIRCountAt(Plex.Get(cur, 4)))
            CAD_Topo.FilletDumpI(" meth=", 6, method)
            CAD_Topo.FilletDumpI(" b0=", 4, b0)
            CAD_Topo.FilletDumpI(" b1=", 4, b1)
            CAD_Topo.FilletDumpS("\n", 1)
            cur = Plex.RingNext(cur, 0)
            i = Add(i, 1)
        }

        ReturnValue(1)
    }
}

// ----------------------------------------------------------------------------
// SEGMENT WALK: Group contiguous nodes in Ring 0 with identical solve methods
// ----------------------------------------------------------------------------

Function.CAD_Topo.FilletPlexSegmentWalk {
    Output: Integer
    Body: {
        head = CAD_Topo_FPlex.head
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(0) }

        // Find a true segment boundary node in circular Ring 0 (where method changes from prev node)
        start_node = head
        k = 0
        WhileLoop LessThan(k, CAD_Topo_FPlex.count) {
            pv_node = Plex.RingPrev(start_node, 0)
            IfCondition NotEqual(Plex.Get(start_node, 6), Plex.Get(pv_node, 6)) ThenBlock: {
                k = CAD_Topo_FPlex.count // Found transition
            } ElseBlock: {
                start_node = Plex.RingNext(start_node, 0)
                k = Add(k, 1)
            }
        }

        CAD_Topo_FPlex.seg_count = 0
        cur = start_node
        seg_start = cur
        seg_method = Plex.Get(cur, 6)
        seg_len = 0

        i = 0
        WhileLoop LessThan(i, CAD_Topo_FPlex.count) {
            cur_method = Plex.Get(cur, 6)

            IfCondition NotEqual(cur_method, seg_method) ThenBlock: {
                // Emit completed segment
                seg_idx = CAD_Topo_FPlex.seg_count
                base = Multiply(seg_idx, 4)
                ArraySet(CAD_Topo_FPlex.segs, base, seg_start)
                ArraySet(CAD_Topo_FPlex.segs, Add(base, 1), Plex.RingPrev(cur, 0))
                ArraySet(CAD_Topo_FPlex.segs, Add(base, 2), seg_len)
                ArraySet(CAD_Topo_FPlex.segs, Add(base, 3), seg_method)
                CAD_Topo_FPlex.seg_count = Add(CAD_Topo_FPlex.seg_count, 1)

                // Start new segment
                seg_start = cur
                seg_method = cur_method
                seg_len = 0
            }

            seg_len = Add(seg_len, 1)
            cur = Plex.RingNext(cur, 0)
            i = Add(i, 1)
        }

        // Emit final segment
        IfCondition GreaterThan(seg_len, 0) ThenBlock: {
            seg_idx = CAD_Topo_FPlex.seg_count
            base = Multiply(seg_idx, 4)
            ArraySet(CAD_Topo_FPlex.segs, base, seg_start)
            ArraySet(CAD_Topo_FPlex.segs, Add(base, 1), Plex.RingPrev(cur, 0))
            ArraySet(CAD_Topo_FPlex.segs, Add(base, 2), seg_len)
            ArraySet(CAD_Topo_FPlex.segs, Add(base, 3), seg_method)
            CAD_Topo_FPlex.seg_count = Add(CAD_Topo_FPlex.seg_count, 1)
        }

        ReturnValue(CAD_Topo_FPlex.seg_count)
    }
}

// ----------------------------------------------------------------------------
// DISPATCH: Execute solvers per segment
// ----------------------------------------------------------------------------

Function.CAD_Topo.FilletPlexDispatchSegment {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FPlex.seg_count, 0) ThenBlock: { ReturnValue(0) }

        solid = CAD_Topo_FPlex.solid
        r = CAD_Topo_FPlex.r
        res = 1

        // PASS 1: Dispatch SEQUENTIAL segments (method=1) first so sharp LINE corners/vertex spheres solve first
        s_idx = 0
        WhileLoop LessThan(s_idx, CAD_Topo_FPlex.seg_count) {
            base = Multiply(s_idx, 4)
            start_nd = ArrayGet(CAD_Topo_FPlex.segs, base)
            count = ArrayGet(CAD_Topo_FPlex.segs, Add(base, 2))
            method = ArrayGet(CAD_Topo_FPlex.segs, Add(base, 3))

            IfCondition EqualTo(method, 1) ThenBlock: {
                PrintMessage("fillet plex dispatch pass1 (SEQUENTIAL) seg ")
                PrintNumber(s_idx)
                PrintMessage(" count=")
                PrintNumber(count)
                PrintMessage("\n")

                // Straight LINE rails first (junc≠5, copes at the back),
                // then open rails into the unselected cylinder (junc=5).
                cur = start_nd
                k = 0
                i = 0
                WhileLoop LessThan(i, count) {
                    CAD_Topo_FLoc.sn = 0
                    IfCondition EqualTo(Plex.Get(cur, 7), 5) ThenBlock: { CAD_Topo_FLoc.sn = 1 }
                    IfCondition EqualTo(Plex.Get(cur, 12), 5) ThenBlock: { CAD_Topo_FLoc.sn = 1 }
                    IfCondition EqualTo(CAD_Topo_FLoc.sn, 0) ThenBlock: {
                        ArraySet(CAD_Topo_FPlex.vert_buf, k, Plex.Get(cur, 0))
                        k = Add(k, 1)
                    }
                    cur = Plex.RingNext(cur, 0)
                    i = Add(i, 1)
                }
                cur = start_nd
                i = 0
                WhileLoop LessThan(i, count) {
                    CAD_Topo_FLoc.sn = 0
                    IfCondition EqualTo(Plex.Get(cur, 7), 5) ThenBlock: { CAD_Topo_FLoc.sn = 1 }
                    IfCondition EqualTo(Plex.Get(cur, 12), 5) ThenBlock: { CAD_Topo_FLoc.sn = 1 }
                    IfCondition EqualTo(CAD_Topo_FLoc.sn, 1) ThenBlock: {
                        ArraySet(CAD_Topo_FPlex.vert_buf, k, Plex.Get(cur, 0))
                        k = Add(k, 1)
                    }
                    cur = Plex.RingNext(cur, 0)
                    i = Add(i, 1)
                }
                IfCondition EqualTo(CAD_Topo.FilletBatchOnBlend(CAD_Topo_FPlex.vert_buf, count), 1) ThenBlock: {
                    PrintMessage("fillet incident-collar seq\n")
                    CAD_Topo_State.fillet_reason = 5
                    ReturnValue(0)
                }
                IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
                CAD_Topo.FilletDumpI("plex seq n=", 11, count)
                CAD_Topo.FilletDumpS("\n", 1)
                res = CAD_Topo.FilletEdgesSequential(solid, CAD_Topo_FPlex.vert_buf, count, r)
                IfCondition EqualTo(res, 0) ThenBlock: { ReturnValue(0) }
            }
            s_idx = Add(s_idx, 1)
        }

        // PASS 2: Dispatch non-SEQUENTIAL segments (EMIT_CHAIN, CYL_RIM, etc.)
        s_idx = 0
        WhileLoop LessThan(s_idx, CAD_Topo_FPlex.seg_count) {
            base = Multiply(s_idx, 4)
            start_nd = ArrayGet(CAD_Topo_FPlex.segs, base)
            count = ArrayGet(CAD_Topo_FPlex.segs, Add(base, 2))
            method = ArrayGet(CAD_Topo_FPlex.segs, Add(base, 3))

            IfCondition NotEqual(method, 1) ThenBlock: {
                PrintMessage("fillet plex dispatch pass2 seg ")
                PrintNumber(s_idx)
                PrintMessage(" method=")
                PrintNumber(method)
                PrintMessage(" count=")
                PrintNumber(count)
                PrintMessage("\n")

                Branch method {
                    Case 2: {
                        // Sharp circles plus lines, or lines between arcs.
                        // -1 falls through. 0 is a matched miss: do not
                        // also emit-chain. Subtract stays out of the compare.
                        miss = Subtract(0, 1)
                        res = CAD_Topo.FilletPlexArcSharp(solid, r)
                        IfCondition EqualTo(res, miss) ThenBlock: {
                            CAD_Topo_State.fillet_class = 99
                            CAD_Topo_FComp.hfilt = 0
                            res = CAD_Topo.FilletEmitChain(solid, r)
                            IfCondition EqualTo(res, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo_State.fillet_reason, 22) ThenBlock: {
                                    res = CAD_Topo.FilletEmitSplitHosts(solid, r)
                                }
                            }
                        }
                    }
                    Case 3: {
                        res = CAD_Topo.FilletJoinFoot3(solid, r)
                    }
                    Case 4: {
                        // Closed all-circle loop. A pad of sharp arcs is
                        // the same vertex walk. A real cylinder rim is G1
                        // or closed and falls through to the rim fillet.
                        miss = Subtract(0, 1)
                        res = CAD_Topo.FilletPlexArcSharp(solid, r)
                        IfCondition EqualTo(res, miss) ThenBlock: {
                            e = Plex.Get(start_nd, 0)
                            res = CAD_Blend.FilletCylTopRim(solid, e, r)
                        }
                    }
                    Case 5: {
                        e = Plex.Get(start_nd, 0)
                        res = CAD_Blend.FilletCylBottomRim(solid, e, r)
                    }
                    Case 6: {
                        e = Plex.Get(start_nd, 0)
                        em = CAD_Topo.FilletEmitPlaneCyl(solid, e, r)
                        IfCondition NotEqual(em, 0) ThenBlock: {
                            res = em
                        } ElseBlock: {
                            // Reason 28 refused before any vertex. The boss
                            // cove would still sew a cap that has no width.
                            res = 0
                            IfCondition NotEqual(CAD_Topo_State.fillet_reason, 28) ThenBlock: {
                                res = CAD_Blend.FilletPlaneCylJoin(solid, e, r)
                            }
                        }
                    }
                    Case 7: {
                        e = Plex.Get(start_nd, 0)
                        nH = count
                        res = CAD_Topo.FilletPlaneEdgesDigon(solid, e, nH, r)
                    }
                    Case 8: {
                        e = Plex.Get(start_nd, 0)
                        nH = count
                        res = CAD_Topo.FilletJoinCoveCycle(solid, e, nH, r)
                    }
                    Case 9: {
                        // Pass 1 may have noted other corners. This edge
                        // is alone (nsel=1). Do not inherit that count.
                        CAD_Topo.FilletVertReset()
                        e = Plex.Get(start_nd, 0)
                        res = CAD_Topo.FilletEdgeLocal(solid, e, r)
                        IfCondition NotEqual(res, 0) ThenBlock: {
                            CAD_Topo.FilletPlexResolveNotch(res)
                        }
                    }
                    Case 10: {
                        // RAIL_ARC: never assigned. Same emit as Case 9:
                        // FilletEdgeLocal. FilletPlexRailArcShift is not
                        // called from EdgeLocal (zero product-path call sites).
                        e = Plex.Get(start_nd, 0)
                        res = CAD_Topo.FilletEdgeLocal(solid, e, r)
                    }
                    Default: {
                        res = 0
                    }
                }
                IfCondition EqualTo(res, 0) ThenBlock: { ReturnValue(0) }
            }
            s_idx = Add(s_idx, 1)
        }

        ReturnValue(res)
    }
}

// Face of a coedge: ce[4] is the loop, loop[1] is the face.
Function.CAD_Topo.FilletPlexCeFace {
    Input: ce_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ce_h, 0) ThenBlock: { ReturnValue(0) }
        lp = CAD_Store.Read(ce_h, 4)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(lp, 1))
    }
}

// Terminator through Th (va) and Tw (vb). The host-axis plane cuts a
// short chord of the blocker (sagitta ~0.17 mm) and the fillet face
// rules flat. Plane is Th, Tw, and the fillet bisector shot along the
// axis onto the host. Ellipse is that plane ∩ the fillet cylinder
// (rmin = fillet R). Eccentric angle is the fillet angle, so a ruled
// zip stays on the cylinder. Same MakeEllipse layout. 0 fail-closed.
Function.CAD_Topo.FilletPlexNotchEllipse {
    Input: va: Integer
    Input: vb: Integer
    Input: surf: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: { ReturnValue(0) }
        hx = CAD_Store.Read(surf, 1)
        hy = CAD_Store.Read(surf, 2)
        hr = CAD_Store.Read(surf, 13)
        IfCondition EqualTo(CAD_Num.IsZero(hr, 0), 1) ThenBlock: { ReturnValue(0) }
        rf = CAD_Topo_FPlex.r
        solid = CAD_Topo_FPlex.solid
        IfCondition EqualTo(CAD_Num.IsZero(rf, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(solid, 0) ThenBlock: { ReturnValue(0) }
        tax = CAD_Store.Read(va, 0)
        tay = CAD_Store.Read(va, 1)
        taz = CAD_Store.Read(va, 2)
        wbx = CAD_Store.Read(vb, 0)
        wby = CAD_Store.Read(vb, 1)
        wbz = CAD_Store.Read(vb, 2)
        eds = Allocate(4096)
        IfCondition EqualTo(eds, 0) ThenBlock: { ReturnValue(0) }
        ne = CAD_Topo.SolidCollectEdges(solid, eds, 256)
        got = 0
        mcx = 0
        mcy = 0
        mcz = 0
        xx = 0
        xy = 0
        xz = 0
        yx = 0
        yy = 0
        yz = 0
        i = 0
        WhileLoop LessThan(i, ne) {
            e = ArrayGet(eds, i)
            IfCondition NotEqual(e, 0) ThenBlock: {
                crv = CAD_Store.Read(e, 2)
                IfCondition NotEqual(crv, 0) ThenBlock: {
                    ck = CAD_Store.Read(crv, 0)
                    IfCondition EqualTo(ck, 2) ThenBlock: {
                        cr = CAD_Store.Read(crv, 10)
                        IfCondition EqualTo(CAD_Num.IsEqual(cr, rf, 0), 1) ThenBlock: {
                            v0 = CAD_Store.Read(e, 0)
                            v1 = CAD_Store.Read(e, 1)
                            hit = 0
                            IfCondition EqualTo(v0, va) ThenBlock: { hit = 1 }
                            IfCondition EqualTo(v1, va) ThenBlock: { hit = 1 }
                            IfCondition EqualTo(hit, 1) ThenBlock: {
                                mcx = CAD_Store.Read(crv, 1)
                                mcy = CAD_Store.Read(crv, 2)
                                mcz = CAD_Store.Read(crv, 3)
                                xx = CAD_Store.Read(crv, 4)
                                xy = CAD_Store.Read(crv, 5)
                                xz = CAD_Store.Read(crv, 6)
                                yx = CAD_Store.Read(crv, 7)
                                yy = CAD_Store.Read(crv, 8)
                                yz = CAD_Store.Read(crv, 9)
                                got = 1
                                i = ne
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        Deallocate(eds, 4096)
        IfCondition EqualTo(got, 0) ThenBlock: {
            PrintMessage("notch ell miss 1\n")
            ReturnValue(0)
        }
        dx = Float_Sub(Float_Mul(xy, yz), Float_Mul(xz, yy))
        dy = Float_Sub(Float_Mul(xz, yx), Float_Mul(xx, yz))
        dz = Float_Sub(Float_Mul(xx, yy), Float_Mul(xy, yx))
        dl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz)))
        IfCondition EqualTo(CAD_Num.IsZero(dl, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 2\n")
            ReturnValue(0)
        }
        dx = Float_Div(dx, dl)
        dy = Float_Div(dy, dl)
        dz = Float_Div(dz, dl)
        vx = Float_Sub(tax, mcx)
        vy = Float_Sub(tay, mcy)
        vz = Float_Sub(taz, mcz)
        vl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(vx, vx), Float_Mul(vy, vy)), Float_Mul(vz, vz)))
        IfCondition EqualTo(CAD_Num.IsEqual(vl, rf, 0), 0) ThenBlock: {
            PrintMessage("notch ell miss 3\n")
            ReturnValue(0)
        }
        vx = Float_Div(vx, vl)
        vy = Float_Div(vy, vl)
        vz = Float_Div(vz, vl)
        wx = Float_Sub(wbx, mcx)
        wy = Float_Sub(wby, mcy)
        wz = Float_Sub(wbz, mcz)
        t = Float_Add(Float_Add(Float_Mul(wx, dx), Float_Mul(wy, dy)), Float_Mul(wz, dz))
        ux = Float_Sub(wx, Float_Mul(t, dx))
        uy = Float_Sub(wy, Float_Mul(t, dy))
        uz = Float_Sub(wz, Float_Mul(t, dz))
        ul = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ux, ux), Float_Mul(uy, uy)), Float_Mul(uz, uz)))
        IfCondition EqualTo(CAD_Num.IsEqual(ul, rf, 0), 0) ThenBlock: {
            PrintMessage("notch ell miss 4\n")
            ReturnValue(0)
        }
        ux = Float_Div(ux, ul)
        uy = Float_Div(uy, ul)
        uz = Float_Div(uz, ul)
        bx = Float_Add(ux, vx)
        by = Float_Add(uy, vy)
        bz = Float_Add(uz, vz)
        bl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(bx, bx), Float_Mul(by, by)), Float_Mul(bz, bz)))
        IfCondition EqualTo(CAD_Num.IsZero(bl, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 5\n")
            ReturnValue(0)
        }
        bx = Float_Div(bx, bl)
        by = Float_Div(by, bl)
        bz = Float_Div(bz, bl)
        qx = Float_Add(mcx, Float_Mul(rf, bx))
        qy = Float_Add(mcy, Float_Mul(rf, by))
        qz = Float_Add(mcz, Float_Mul(rf, bz))
        px = Float_Sub(qx, hx)
        py = Float_Sub(qy, hy)
        aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 6\n")
            ReturnValue(0)
        }
        bb = Float_Add(Float_Mul(px, dx), Float_Mul(py, dy))
        cc = Float_Sub(Float_Add(Float_Mul(px, px), Float_Mul(py, py)), Float_Mul(hr, hr))
        disc = Float_Sub(Float_Mul(bb, bb), Float_Mul(aa, cc))
        IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
            PrintMessage("notch ell miss 7\n")
            ReturnValue(0)
        }
        sd = CAD_Num.Sqrt(disc)
        s0 = Float_Div(Float_Sub(Float_Sub(0, bb), sd), aa)
        s1 = Float_Div(Float_Add(Float_Sub(0, bb), sd), aa)
        sm = Float_Mul(t, 0x3FE0000000000000)
        d0 = Float_Sub(s0, sm)
        IfCondition EqualTo(CAD_Num.IsNeg(d0), 1) ThenBlock: { d0 = Float_Sub(0, d0) }
        d1 = Float_Sub(s1, sm)
        IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
        s = s0
        ds = d0
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d1, d0)), 1) ThenBlock: {
            s = s1
            ds = d1
        }
        lim = t
        IfCondition EqualTo(CAD_Num.IsNeg(lim), 1) ThenBlock: { lim = Float_Sub(0, lim) }
        lim = Float_Add(lim, rf)
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(lim, ds)), 1) ThenBlock: {
            PrintMessage("notch ell miss 8\n")
            ReturnValue(0)
        }
        mx = Float_Add(qx, Float_Mul(s, dx))
        my = Float_Add(qy, Float_Mul(s, dy))
        mz = Float_Add(qz, Float_Mul(s, dz))
        e1x = Float_Sub(mx, wbx)
        e1y = Float_Sub(my, wby)
        e1z = Float_Sub(mz, wbz)
        e2x = Float_Sub(tax, wbx)
        e2y = Float_Sub(tay, wby)
        e2z = Float_Sub(taz, wbz)
        nx = Float_Sub(Float_Mul(e1y, e2z), Float_Mul(e1z, e2y))
        ny = Float_Sub(Float_Mul(e1z, e2x), Float_Mul(e1x, e2z))
        nz = Float_Sub(Float_Mul(e1x, e2y), Float_Mul(e1y, e2x))
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 9\n")
            ReturnValue(0)
        }
        nx = Float_Div(nx, nl)
        ny = Float_Div(ny, nl)
        nz = Float_Div(nz, nl)
        nd = Float_Add(Float_Add(Float_Mul(nx, dx), Float_Mul(ny, dy)), Float_Mul(nz, dz))
        cosa = nd
        IfCondition EqualTo(CAD_Num.IsNeg(cosa), 1) ThenBlock: { cosa = Float_Sub(0, cosa) }
        IfCondition EqualTo(CAD_Num.IsZero(cosa, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 10\n")
            ReturnValue(0)
        }
        sc = Float_Add(Float_Add(Float_Mul(nx, Float_Sub(tax, mcx)), Float_Mul(ny, Float_Sub(tay, mcy))), Float_Mul(nz, Float_Sub(taz, mcz)))
        sc = Float_Div(sc, nd)
        cx = Float_Add(mcx, Float_Mul(sc, dx))
        cy = Float_Add(mcy, Float_Mul(sc, dy))
        cz = Float_Add(mcz, Float_Mul(sc, dz))
        yx = Float_Sub(Float_Mul(dy, nz), Float_Mul(dz, ny))
        yy = Float_Sub(Float_Mul(dz, nx), Float_Mul(dx, nz))
        yz = Float_Sub(Float_Mul(dx, ny), Float_Mul(dy, nx))
        yl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(yx, yx), Float_Mul(yy, yy)), Float_Mul(yz, yz)))
        IfCondition EqualTo(CAD_Num.IsZero(yl, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 11\n")
            ReturnValue(0)
        }
        yx = Float_Div(yx, yl)
        yy = Float_Div(yy, yl)
        yz = Float_Div(yz, yl)
        xx = Float_Sub(Float_Mul(ny, yz), Float_Mul(nz, yy))
        xy = Float_Sub(Float_Mul(nz, yx), Float_Mul(nx, yz))
        xz = Float_Sub(Float_Mul(nx, yy), Float_Mul(ny, yx))
        xl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(xx, xx), Float_Mul(xy, xy)), Float_Mul(xz, xz)))
        IfCondition EqualTo(CAD_Num.IsZero(xl, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 12\n")
            ReturnValue(0)
        }
        xx = Float_Div(xx, xl)
        xy = Float_Div(xy, xl)
        xz = Float_Div(xz, xl)
        rmin = rf
        rmaj = Float_Div(rf, cosa)
        IfCondition EqualTo(CAD_Topo_FLoc.pl1, 0) ThenBlock: { CAD_Topo_FLoc.pl1 = Allocate(32) }
        fr = CAD_Topo_FLoc.pl1
        IfCondition EqualTo(fr, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(fr, 0, cx)
        ArraySet(fr, 1, cy)
        ArraySet(fr, 2, cz)
        ArraySet(fr, 3, xx)
        ArraySet(fr, 4, xy)
        ArraySet(fr, 5, xz)
        ArraySet(fr, 6, yx)
        ArraySet(fr, 7, yy)
        ArraySet(fr, 8, yz)
        PrintMessage("notch ell rmaj_um=")
        PrintNumber(Float_ToInt(Float_Mul(rmaj, 0x408F400000000000)))
        PrintMessage("\n")
        ReturnValue(CAD_Geom.MakeEllipse(fr, rmaj, rmin))
    }
}

// One terminator: fillet-cylinder ellipse Th–Tw on the original generator,
// insert after after_ce, split the vertical at Tw, swap the fillet mer
// onto the ellipse. org_tw=0 origin Th (dest corner), 1 origin Tw.
// 1 ok, 0 miss.
Function.CAD_Topo.FilletPlexNotchInsertTerm {
    Input: th: Integer
    Input: vtop: Integer
    Input: after_ce: Integer
    Input: org_tw: Integer
    Input: surf: Integer
    Input: vert_e: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vtop, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(after_ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vert_e, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: { CAD_Topo_FLoc.pt = Allocate(32) }
        pt = CAD_Topo_FLoc.pt
        IfCondition EqualTo(pt, 0) ThenBlock: { ReturnValue(0) }
        twz = Float_Sub(CAD_Store.Read(th, 2), CAD_Topo_FPlex.r)
        ArraySet(pt, 0, CAD_Store.Read(vtop, 0))
        ArraySet(pt, 1, CAD_Store.Read(vtop, 1))
        ArraySet(pt, 2, twz)
        tw = CAD_Topo.MakeVertex(pt)
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        elc = CAD_Topo.FilletPlexNotchEllipse(th, tw, surf)
        IfCondition EqualTo(elc, 0) ThenBlock: { ReturnValue(0) }
        ell_e = CAD_Topo.MakeMinorArcEdge(th, tw, elc)
        IfCondition EqualTo(ell_e, 0) ThenBlock: { ReturnValue(0) }
        org = th
        IfCondition EqualTo(org_tw, 1) ThenBlock: { org = tw }
        sn = 1
        IfCondition NotEqual(CAD_Store.Read(ell_e, 0), org) ThenBlock: { sn = 0 }
        ell_ce = CAD_Topo.MakeCoedge(ell_e, org, sn)
        IfCondition EqualTo(ell_ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(ell_e, 3, ell_ce)
        CAD_Topo.CoedgeInsertAfter(after_ce, ell_ce)
        CAD_Topo.EdgeRetargetVert(vert_e, vtop, tw)
        CAD_Topo.FilletPlexNotchRetargetMer(th, tw, ell_e)
        ReturnValue(1)
    }
}

// Method-9 analog on the cylindrical blocker: short top is already
// the lid Th–Th arc (shared). Insert the fillet ellipse Th→Tw
// at each end, retarget the original verticals onto Tw, and swap the
// fillet's circular mer onto that same ellipse so the blend ends on
// the wall. nring becomes 6; MeshCylLoopUV tessellates a right cylinder.
// 0 miss (lid trim already done). 1 sewn.
Function.CAD_Topo.FilletPlexNotchSew {
    Input: th_a: Integer
    Input: th_b: Integer
    Input: mer: Integer
    Input: wall_ce: Integer
    Input: blk_face: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th_a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(th_b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(wall_ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(blk_face, 0) ThenBlock: { ReturnValue(0) }
        surf = CAD_Store.Read(blk_face, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: { ReturnValue(0) }
        org = CAD_Store.Read(wall_ce, 5)
        aa = CAD_Topo.FilletMerCloser(th_a, th_b, org)
        g = CAD_Topo.CoedgeSwapEdge(wall_ce, mer, aa)
        IfCondition EqualTo(g, 0) ThenBlock: { ReturnValue(0) }
        th_org = CAD_Store.Read(g, 5)
        th_dst = th_a
        IfCondition EqualTo(th_org, th_a) ThenBlock: { th_dst = th_b }
        prev_ce = CAD_Store.Read(g, 3)
        next_ce = CAD_Store.Read(g, 2)
        n_ok = 0
        // Dest: after short top, origin Th. Origin: after incoming vert, origin Tw.
        // Extrude outer side is bot→up, top reversed, down-vert — next origin is
        // the top of the down-vert, prev dest is the top of the up-vert.
        IfCondition NotEqual(next_ce, 0) ThenBlock: {
            IfCondition NotEqual(next_ce, g) ThenBlock: {
                vtop = CAD_Store.Read(next_ce, 5)
                vert_e = CAD_Store.Read(next_ce, 0)
                hit = CAD_Topo.FilletPlexNotchInsertTerm(th_dst, vtop, g, 0, surf, vert_e)
                n_ok = Add(n_ok, hit)
            }
        }
        IfCondition NotEqual(prev_ce, 0) ThenBlock: {
            IfCondition NotEqual(prev_ce, g) ThenBlock: {
                vert_e = CAD_Store.Read(prev_ce, 0)
                vtop = 0
                IfCondition NotEqual(vert_e, 0) ThenBlock: {
                    v0 = CAD_Store.Read(vert_e, 0)
                    v1 = CAD_Store.Read(vert_e, 1)
                    vtop = v0
                    IfCondition NotEqual(v0, 0) ThenBlock: {
                        IfCondition NotEqual(v1, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Store.Read(v0, 2), CAD_Store.Read(v1, 2))), 1) ThenBlock: { vtop = v1 }
                        }
                    }
                }
                hit = CAD_Topo.FilletPlexNotchInsertTerm(th_org, vtop, prev_ce, 1, surf, vert_e)
                n_ok = Add(n_ok, hit)
            }
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("notch sew n=", 12, n_ok)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("notch sew n=")
        PrintNumber(n_ok)
        PrintMessage("\n")
        IfCondition LessThan(n_ok, 2) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// One junc=5 Th: wall top is far–Th (remaining host arc), one
// fillet ellipse at Th. Far generatrix stays full height.
// nring=5. 0 miss, 1 sewn.
Function.CAD_Topo.FilletPlexNotchSewOne {
    Input: th: Integer
    Input: mer: Integer
    Input: wall_ce: Integer
    Input: blk_face: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(wall_ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(blk_face, 0) ThenBlock: { ReturnValue(0) }
        surf = CAD_Store.Read(blk_face, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: { ReturnValue(0) }
        mv0 = CAD_Store.Read(mer, 0)
        mv1 = CAD_Store.Read(mer, 1)
        IfCondition EqualTo(mv0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mv1, 0) ThenBlock: { ReturnValue(0) }
        org = CAD_Store.Read(wall_ce, 5)
        aa = CAD_Topo.FilletMerCloser(mv0, mv1, org)
        g = CAD_Topo.CoedgeSwapEdge(wall_ce, mer, aa)
        IfCondition EqualTo(g, 0) ThenBlock: { ReturnValue(0) }
        th_org = CAD_Store.Read(g, 5)
        th_dst = mv0
        IfCondition EqualTo(th_org, mv0) ThenBlock: { th_dst = mv1 }
        n_ok = 0
        IfCondition EqualTo(th_dst, th) ThenBlock: {
            next_ce = CAD_Store.Read(g, 2)
            IfCondition NotEqual(next_ce, 0) ThenBlock: {
                IfCondition NotEqual(next_ce, g) ThenBlock: {
                    vtop = CAD_Store.Read(next_ce, 5)
                    vert_e = CAD_Store.Read(next_ce, 0)
                    hit = CAD_Topo.FilletPlexNotchInsertTerm(th_dst, vtop, g, 0, surf, vert_e)
                    n_ok = Add(n_ok, hit)
                }
            }
        }
        IfCondition EqualTo(th_org, th) ThenBlock: {
            prev_ce = CAD_Store.Read(g, 3)
            IfCondition NotEqual(prev_ce, 0) ThenBlock: {
                IfCondition NotEqual(prev_ce, g) ThenBlock: {
                    vert_e = CAD_Store.Read(prev_ce, 0)
                    vtop = 0
                    IfCondition NotEqual(vert_e, 0) ThenBlock: {
                        v0 = CAD_Store.Read(vert_e, 0)
                        v1 = CAD_Store.Read(vert_e, 1)
                        vtop = v0
                        IfCondition NotEqual(v0, 0) ThenBlock: {
                            IfCondition NotEqual(v1, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Store.Read(v0, 2), CAD_Store.Read(v1, 2))), 1) ThenBlock: { vtop = v1 }
                            }
                        }
                    }
                    hit = CAD_Topo.FilletPlexNotchInsertTerm(th_org, vtop, prev_ce, 1, surf, vert_e)
                    n_ok = Add(n_ok, hit)
                }
            }
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("notch sew n=", 12, n_ok)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("notch sew n=")
        PrintNumber(n_ok)
        PrintMessage("\n")
        IfCondition LessThan(n_ok, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Swap the fillet 4-cycle's circular mer (R = fillet R, vertex Th)
// onto the wall ellipse, and pull the side generator from Tw_mer to Tw.
// The mer's other vertex sits at Tw height (wall). A lid rail is also
// CIRCLE R=R through Th, but both verts are at lid Z. Swapping that
// onto the vertical ellipse makes the lid non-planar and MeshRuledLoop
// stars the top. Skip same-Z rails; keep searching for the mer.
Function.CAD_Topo.FilletPlexNotchRetargetMer {
    Input: th: Integer
    Input: tw: Integer
    Input: ell_e: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ell_e, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.solid, 0) ThenBlock: { ReturnValue(0) }
        eds = Allocate(4096)
        IfCondition EqualTo(eds, 0) ThenBlock: { ReturnValue(0) }
        ne = CAD_Topo.SolidCollectEdges(CAD_Topo_FPlex.solid, eds, 256)
        rr = CAD_Topo_FPlex.r
        twz = CAD_Store.Read(tw, 2)
        i = 0
        hit = 0
        WhileLoop LessThan(i, ne) {
            e = ArrayGet(eds, i)
            IfCondition NotEqual(e, 0) ThenBlock: {
                IfCondition NotEqual(e, ell_e) ThenBlock: {
                    crv = CAD_Store.Read(e, 2)
                    IfCondition NotEqual(crv, 0) ThenBlock: {
                        ck = CAD_Store.Read(crv, 0)
                        IfCondition EqualTo(ck, 2) ThenBlock: {
                            cr = CAD_Store.Read(crv, 10)
                            IfCondition EqualTo(CAD_Num.IsEqual(cr, rr, 0), 1) ThenBlock: {
                                v0 = CAD_Store.Read(e, 0)
                                v1 = CAD_Store.Read(e, 1)
                                has = 0
                                other = 0
                                IfCondition EqualTo(v0, th) ThenBlock: {
                                    has = 1
                                    other = v1
                                }
                                IfCondition EqualTo(v1, th) ThenBlock: {
                                    has = 1
                                    other = v0
                                }
                                IfCondition EqualTo(has, 1) ThenBlock: {
                                    skip = 1
                                    IfCondition NotEqual(other, 0) ThenBlock: {
                                        oz = CAD_Store.Read(other, 2)
                                        IfCondition EqualTo(CAD_Num.IsEqual(oz, twz, 0), 1) ThenBlock: { skip = 0 }
                                    }
                                    IfCondition EqualTo(skip, 1) ThenBlock: {
                                        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
                                        CAD_Topo.FilletDumpS("retarget mer skip lid\n", 22)
                                    }
                                    IfCondition EqualTo(skip, 0) ThenBlock: {
                                        ce = CAD_Store.Read(e, 3)
                                        IfCondition EqualTo(ce, 0) ThenBlock: { ce = CAD_Store.Read(e, 4) }
                                        IfCondition NotEqual(ce, 0) ThenBlock: {
                                            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
                                            CAD_Topo.FilletDumpS("retarget mer hit\n", 17)
                                            fa = CAD_Topo.FilletPlexCeFace(ce)
                                            sk = 0
                                            nr = 0
                                            IfCondition NotEqual(fa, 0) ThenBlock: {
                                                su = CAD_Store.Read(fa, 0)
                                                IfCondition NotEqual(su, 0) ThenBlock: { sk = CAD_Store.Read(su, 0) }
                                                lp = CAD_Store.Read(fa, 1)
                                                IfCondition NotEqual(lp, 0) ThenBlock: { nr = CAD_Topo.LoopCountCoedges(lp) }
                                            }
                                            CAD_Topo.FilletDumpI("  ce sk=", 8, sk)
                                            CAD_Topo.FilletDumpI(" nring=", 7, nr)
                                            CAD_Topo.FilletDumpS("\n", 1)
                                            CAD_Topo.CoedgeSwapEdge(ce, ell_e, th)
                                            CAD_Topo.FilletPlexNotchRetargetGen(other, tw, eds, ne)
                                            hit = 1
                                            i = ne
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        Deallocate(eds, 4096)
        ReturnValue(hit)
    }
}

Function.CAD_Topo.FilletPlexNotchRetargetGen {
    Input: old_v: Integer
    Input: new_v: Integer
    Input: eds: Address
    Input: ne: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(eds, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        n = 0
        WhileLoop LessThan(i, ne) {
            e = ArrayGet(eds, i)
            IfCondition NotEqual(e, 0) ThenBlock: {
                crv = CAD_Store.Read(e, 2)
                ck = 0
                IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                IfCondition EqualTo(ck, 1) ThenBlock: {
                    has = 0
                    IfCondition EqualTo(CAD_Store.Read(e, 0), old_v) ThenBlock: { has = 1 }
                    IfCondition EqualTo(CAD_Store.Read(e, 1), old_v) ThenBlock: { has = 1 }
                    IfCondition EqualTo(has, 1) ThenBlock: {
                        CAD_Topo.EdgeRetargetVert(e, old_v, new_v)
                        n = Add(n, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// Shrink the LID twin of the host CIRCLE to Th_a–Th_b, then sew the
// blocker with the same short arc plus plane∩cyl ellipses at each Th
// (method-9 analog). Dual-twin of the short arc alone was a warped
// 4-cycle; lid-only left a crack. Do not write th0/th1/j5/j5host.
// 0 fail-closed (no mutation). 1 ok (lid trimmed; sew may no-op).
// Only ResolveNotch calls this.
Function.CAD_Topo.FilletPlexNotchHost {
    Input: th_a: Integer
    Input: th_b: Integer
    Input: host_edge: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(host_edge, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(th_a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(th_b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(th_a, th_b) ThenBlock: { ReturnValue(0) }
        crv = CAD_Store.Read(host_edge, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 2) ThenBlock: { ReturnValue(0) }
        // Host R is the blocker arc, not the fillet mer. Swapping a
        // mer would move blend 4-cycle slots.
        hr = CAD_Store.Read(crv, 10)
        rr = CAD_Topo_FPlex.r
        IfCondition EqualTo(CAD_Num.IsEqual(hr, rr, 0), 1) ThenBlock: { ReturnValue(0) }
        ca = CAD_Store.Read(host_edge, 3)
        cb = CAD_Store.Read(host_edge, 4)
        IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cb, 0) ThenBlock: { ReturnValue(0) }
        mer = CAD_Topo.MakeMinorArcEdge(th_a, th_b, crv)
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.pl1, 0) ThenBlock: { CAD_Topo_FLoc.pl1 = Allocate(32) }
        pl = CAD_Topo_FLoc.pl1
        IfCondition EqualTo(pl, 0) ThenBlock: { ReturnValue(0) }
        fa = CAD_Topo.FilletPlexCeFace(ca)
        fb = CAD_Topo.FilletPlexCeFace(cb)
        nz_a = 0
        pa = CAD_Topo.FaceGetPlane(fa, pl)
        IfCondition EqualTo(pa, 0) ThenBlock: {
            nz_a = ArrayGet(pl, 12)
            IfCondition EqualTo(CAD_Num.IsNeg(nz_a), 1) ThenBlock: { nz_a = Float_Sub(0, nz_a) }
        }
        nz_b = 0
        pb = CAD_Topo.FaceGetPlane(fb, pl)
        IfCondition EqualTo(pb, 0) ThenBlock: {
            nz_b = ArrayGet(pl, 12)
            IfCondition EqualTo(CAD_Num.IsNeg(nz_b), 1) ThenBlock: { nz_b = Float_Sub(0, nz_b) }
        }
        lid_ce = 0
        IfCondition EqualTo(pa, 0) ThenBlock: {
            IfCondition NotEqual(pb, 0) ThenBlock: { lid_ce = ca }
        }
        IfCondition EqualTo(pb, 0) ThenBlock: {
            IfCondition NotEqual(pa, 0) ThenBlock: { lid_ce = cb }
        }
        IfCondition EqualTo(pa, 0) ThenBlock: {
            IfCondition EqualTo(pb, 0) ThenBlock: {
                lid_ce = ca
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(nz_a, nz_b)), 1) ThenBlock: { lid_ce = cb }
            }
        }
        IfCondition EqualTo(lid_ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("notch Th0=", 10, Float_ToInt(CAD_Store.Read(th_a, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th_a, 1)))
        CAD_Topo.FilletDumpI(" Th1=", 5, Float_ToInt(CAD_Store.Read(th_b, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th_b, 1)))
        CAD_Topo.FilletDumpS("\n", 1)
        org = CAD_Store.Read(lid_ce, 5)
        aa = CAD_Topo.FilletMerCloser(th_a, th_b, org)
        CAD_Topo.CoedgeSwapEdge(lid_ce, mer, aa)
        CAD_Topo.FilletDumpI("notch R=", 8, Float_ToInt(hr))
        mch = CAD_Store.Read(mer, 2)
        spv = 0
        IfCondition NotEqual(mch, 0) ThenBlock: { spv = CAD_Store.Read(mch, 12) }
        CAD_Topo.FilletDumpI(" sp=", 4, Float_ToInt(Float_Mul(spv, 0x408F400000000000)))
        CAD_Topo.FilletDumpS("\n", 1)
        wall_ce = ca
        IfCondition EqualTo(lid_ce, ca) ThenBlock: { wall_ce = cb }
        blk_face = CAD_Topo.FilletPlexCeFace(wall_ce)
        CAD_Topo.FilletPlexNotchSew(th_a, th_b, mer, wall_ce, blk_face)
        lpw = 0
        IfCondition NotEqual(blk_face, 0) ThenBlock: { lpw = CAD_Store.Read(blk_face, 1) }
        nrw = 0
        IfCondition NotEqual(lpw, 0) ThenBlock: { nrw = CAD_Topo.LoopCountCoedges(lpw) }
        CAD_Topo.FilletDumpI("notch wall nring=", 17, nrw)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("notch wall nring=")
        PrintNumber(nrw)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// One junc=5 Th: lid host CIRCLE becomes far–Th (original other
// arc end stays). Then sew one ellipse at Th. Same lid-twin
// pick as NotchHost. 0 fail-closed. 1 ok.
Function.CAD_Topo.FilletPlexNotchHostOne {
    Input: th: Integer
    Input: host_edge: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(host_edge, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        crv = CAD_Store.Read(host_edge, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 2) ThenBlock: { ReturnValue(0) }
        hr = CAD_Store.Read(crv, 10)
        rr = CAD_Topo_FPlex.r
        IfCondition EqualTo(CAD_Num.IsEqual(hr, rr, 0), 1) ThenBlock: { ReturnValue(0) }
        hv0 = CAD_Store.Read(host_edge, 0)
        hv1 = CAD_Store.Read(host_edge, 1)
        IfCondition EqualTo(hv0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(hv1, 0) ThenBlock: { ReturnValue(0) }
        dx = Float_Sub(CAD_Store.Read(hv0, 0), CAD_Store.Read(th, 0))
        dy = Float_Sub(CAD_Store.Read(hv0, 1), CAD_Store.Read(th, 1))
        dz = Float_Sub(CAD_Store.Read(hv0, 2), CAD_Store.Read(th, 2))
        d0 = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
        dx = Float_Sub(CAD_Store.Read(hv1, 0), CAD_Store.Read(th, 0))
        dy = Float_Sub(CAD_Store.Read(hv1, 1), CAD_Store.Read(th, 1))
        dz = Float_Sub(CAD_Store.Read(hv1, 2), CAD_Store.Read(th, 2))
        d1 = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
        far = hv0
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d0, d1)), 1) ThenBlock: { far = hv1 }
        IfCondition EqualTo(far, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(far, th) ThenBlock: { ReturnValue(0) }
        ca = CAD_Store.Read(host_edge, 3)
        cb = CAD_Store.Read(host_edge, 4)
        IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cb, 0) ThenBlock: { ReturnValue(0) }
        mer = CAD_Topo.MakeMinorArcEdge(far, th, crv)
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.pl1, 0) ThenBlock: { CAD_Topo_FLoc.pl1 = Allocate(32) }
        pl = CAD_Topo_FLoc.pl1
        IfCondition EqualTo(pl, 0) ThenBlock: { ReturnValue(0) }
        fa = CAD_Topo.FilletPlexCeFace(ca)
        fb = CAD_Topo.FilletPlexCeFace(cb)
        nz_a = 0
        pa = CAD_Topo.FaceGetPlane(fa, pl)
        IfCondition EqualTo(pa, 0) ThenBlock: {
            nz_a = ArrayGet(pl, 12)
            IfCondition EqualTo(CAD_Num.IsNeg(nz_a), 1) ThenBlock: { nz_a = Float_Sub(0, nz_a) }
        }
        nz_b = 0
        pb = CAD_Topo.FaceGetPlane(fb, pl)
        IfCondition EqualTo(pb, 0) ThenBlock: {
            nz_b = ArrayGet(pl, 12)
            IfCondition EqualTo(CAD_Num.IsNeg(nz_b), 1) ThenBlock: { nz_b = Float_Sub(0, nz_b) }
        }
        lid_ce = 0
        IfCondition EqualTo(pa, 0) ThenBlock: {
            IfCondition NotEqual(pb, 0) ThenBlock: { lid_ce = ca }
        }
        IfCondition EqualTo(pb, 0) ThenBlock: {
            IfCondition NotEqual(pa, 0) ThenBlock: { lid_ce = cb }
        }
        IfCondition EqualTo(pa, 0) ThenBlock: {
            IfCondition EqualTo(pb, 0) ThenBlock: {
                lid_ce = ca
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(nz_a, nz_b)), 1) ThenBlock: { lid_ce = cb }
            }
        }
        IfCondition EqualTo(lid_ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("notch one Th=", 13, Float_ToInt(CAD_Store.Read(th, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th, 1)))
        CAD_Topo.FilletDumpI(" far=", 5, Float_ToInt(CAD_Store.Read(far, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(far, 1)))
        CAD_Topo.FilletDumpS("\n", 1)
        org = CAD_Store.Read(lid_ce, 5)
        aa = CAD_Topo.FilletMerCloser(far, th, org)
        CAD_Topo.CoedgeSwapEdge(lid_ce, mer, aa)
        CAD_Topo.FilletDumpI("notch R=", 8, Float_ToInt(hr))
        mch = CAD_Store.Read(mer, 2)
        spv = 0
        IfCondition NotEqual(mch, 0) ThenBlock: { spv = CAD_Store.Read(mch, 12) }
        CAD_Topo.FilletDumpI(" sp=", 4, Float_ToInt(Float_Mul(spv, 0x408F400000000000)))
        CAD_Topo.FilletDumpS("\n", 1)
        wall_ce = ca
        IfCondition EqualTo(lid_ce, ca) ThenBlock: { wall_ce = cb }
        blk_face = CAD_Topo.FilletPlexCeFace(wall_ce)
        CAD_Topo.FilletPlexNotchSewOne(th, mer, wall_ce, blk_face)
        lpw = 0
        IfCondition NotEqual(blk_face, 0) ThenBlock: { lpw = CAD_Store.Read(blk_face, 1) }
        nrw = 0
        IfCondition NotEqual(lpw, 0) ThenBlock: { nrw = CAD_Topo.LoopCountCoedges(lpw) }
        CAD_Topo.FilletDumpI("notch wall nring=", 17, nrw)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("notch wall nring=")
        PrintNumber(nrw)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// After Sequential: two lid-side mer Th + one host CIRCLE → NotchHost.
// After method 9: one Th + one host CIRCLE → NotchHostOne.
// Else 1 (no-op). Closed 4-LINE box has 0 Th. Do not FindEdgeBySig on slot 0.
Function.CAD_Topo.FilletPlexResolveNotch {
    Input: solid_h: Integer
    Output: Integer
    Body: {
        // Selected arc owns the host circle. NotchHost would clip it
        // to the untrimmed Th–Th and fight the torus patch.
        af = CAD_Topo_FPlex.arc4
        IfCondition EqualTo(af, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(solid_h, 0) ThenBlock: { ReturnValue(1) }
        nnd = CAD_Topo_FPlex.count
        IfCondition LessThan(nnd, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo_FPlex.head, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo_FLoc.pl1, 0) ThenBlock: { CAD_Topo_FLoc.pl1 = Allocate(32) }
        pl = CAD_Topo_FLoc.pl1
        IfCondition EqualTo(pl, 0) ThenBlock: { ReturnValue(1) }
        n_th = 0
        th_a = 0
        th_b = 0
        host_e = 0
        n_host = 0
        i = 0
        WhileLoop LessThan(i, nnd) {
            nd = CAD_Topo.FilletPlexGetNode(i)
            IfCondition NotEqual(nd, 0) ThenBlock: {
                v0 = Plex.Get(nd, 3)
                v1 = Plex.Get(nd, 4)
                f1 = Plex.Get(nd, 1)
                f2 = Plex.Get(nd, 2)
                j0 = CAD_Topo.FilletPlexJuncAt(v0, f1, f2)
                j1 = CAD_Topo.FilletPlexJuncAt(v1, f1, f2)
                need = 0
                IfCondition EqualTo(j0, 5) ThenBlock: { need = 1 }
                IfCondition EqualTo(j1, 5) ThenBlock: { need = 1 }
                IfCondition EqualTo(need, 1) ThenBlock: {
                    blk = 0
                    IfCondition EqualTo(j0, 5) ThenBlock: { blk = Plex.Get(nd, 10) }
                    IfCondition EqualTo(blk, 0) ThenBlock: {
                        IfCondition EqualTo(j1, 5) ThenBlock: { blk = Plex.Get(nd, 11) }
                    }
                    lid = f1
                    nz1 = 0
                    nz2 = 0
                    IfCondition EqualTo(CAD_Topo.FaceGetPlane(f1, pl), 0) ThenBlock: {
                        nz1 = ArrayGet(pl, 12)
                        IfCondition EqualTo(CAD_Num.IsNeg(nz1), 1) ThenBlock: { nz1 = Float_Sub(0, nz1) }
                    }
                    IfCondition EqualTo(CAD_Topo.FaceGetPlane(f2, pl), 0) ThenBlock: {
                        nz2 = ArrayGet(pl, 12)
                        IfCondition EqualTo(CAD_Num.IsNeg(nz2), 1) ThenBlock: { nz2 = Float_Sub(0, nz2) }
                    }
                    IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(nz1, nz2)), 1) ThenBlock: { lid = f2 }
                    lp = 0
                    IfCondition NotEqual(lid, 0) ThenBlock: { lp = CAD_Store.Read(lid, 1) }
                    IfCondition NotEqual(lp, 0) ThenBlock: {
                        mx = Float_Div(Float_Add(CAD_Store.Read(v0, 0), CAD_Store.Read(v1, 0)), 0x4000000000000000)
                        my = Float_Div(Float_Add(CAD_Store.Read(v0, 1), CAD_Store.Read(v1, 1)), 0x4000000000000000)
                        mz = Float_Div(Float_Add(CAD_Store.Read(v0, 2), CAD_Store.Read(v1, 2)), 0x4000000000000000)
                        ce = CAD_Store.Read(lp, 0)
                        hd = ce
                        best_ce = 0
                        best_d2 = 0
                        best_set = 0
                        cg = 0
                        WhileLoop LessThan(cg, 2048) {
                            IfCondition EqualTo(ce, 0) ThenBlock: { cg = 2048 }
                            IfCondition NotEqual(ce, 0) ThenBlock: {
                                e = CAD_Store.Read(ce, 0)
                                IfCondition NotEqual(e, 0) ThenBlock: {
                                    crv = CAD_Store.Read(e, 2)
                                    ck = 0
                                    IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                                    ca = CAD_Store.Read(e, 3)
                                    cb = CAD_Store.Read(e, 4)
                                    fa = CAD_Topo.FilletPlexCeFace(ca)
                                    fb = CAD_Topo.FilletPlexCeFace(cb)
                                    other = 0
                                    IfCondition EqualTo(fa, lid) ThenBlock: { other = fb }
                                    IfCondition EqualTo(fb, lid) ThenBlock: { other = fa }
                                    IfCondition EqualTo(ck, 2) ThenBlock: {
                                        IfCondition EqualTo(other, blk) ThenBlock: {
                                            IfCondition NotEqual(blk, 0) ThenBlock: {
                                                IfCondition EqualTo(host_e, 0) ThenBlock: {
                                                    host_e = e
                                                    n_host = 1
                                                }
                                                IfCondition NotEqual(host_e, e) ThenBlock: { n_host = Add(n_host, 1) }
                                            }
                                        }
                                    }
                                    IfCondition EqualTo(ck, 1) ThenBlock: {
                                        IfCondition NotEqual(other, 0) ThenBlock: {
                                            os = CAD_Store.Read(other, 0)
                                            IfCondition NotEqual(os, 0) ThenBlock: {
                                                IfCondition EqualTo(CAD_Store.Read(os, 0), 2) ThenBlock: {
                                                    ga = CAD_Store.Read(e, 0)
                                                    gb = CAD_Store.Read(e, 1)
                                                    IfCondition NotEqual(ga, 0) ThenBlock: {
                                                        IfCondition NotEqual(gb, 0) ThenBlock: {
                                                            dx = Float_Sub(Float_Div(Float_Add(CAD_Store.Read(ga, 0), CAD_Store.Read(gb, 0)), 0x4000000000000000), mx)
                                                            dy = Float_Sub(Float_Div(Float_Add(CAD_Store.Read(ga, 1), CAD_Store.Read(gb, 1)), 0x4000000000000000), my)
                                                            dz = Float_Sub(Float_Div(Float_Add(CAD_Store.Read(ga, 2), CAD_Store.Read(gb, 2)), 0x4000000000000000), mz)
                                                            d2 = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
                                                            take = 0
                                                            IfCondition EqualTo(best_set, 0) ThenBlock: { take = 1 }
                                                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d2, best_d2)), 1) ThenBlock: { take = 1 }
                                                            IfCondition EqualTo(take, 1) ThenBlock: {
                                                                best_ce = ce
                                                                best_d2 = d2
                                                                best_set = 1
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                ce = CAD_Store.Read(ce, 2)
                                IfCondition EqualTo(ce, hd) ThenBlock: { cg = 2048 }
                            }
                            cg = Add(cg, 1)
                        }
                        IfCondition NotEqual(best_ce, 0) ThenBlock: {
                            ega = CAD_Store.Read(best_ce, 0)
                            blend_ce = CAD_Store.Read(best_ce, 1)
                            IfCondition EqualTo(blend_ce, 0) ThenBlock: {
                                IfCondition NotEqual(ega, 0) ThenBlock: {
                                    ca = CAD_Store.Read(ega, 3)
                                    cb = CAD_Store.Read(ega, 4)
                                    IfCondition EqualTo(ca, best_ce) ThenBlock: { blend_ce = cb }
                                    IfCondition EqualTo(cb, best_ce) ThenBlock: { blend_ce = ca }
                                }
                            }
                            IfCondition NotEqual(blend_ce, 0) ThenBlock: {
                                IfCondition NotEqual(ega, 0) ThenBlock: {
                                    gv0 = CAD_Store.Read(ega, 0)
                                    gv1 = CAD_Store.Read(ega, 1)
                                    ei = 0
                                    WhileLoop LessThan(ei, 2) {
                                        mer_ce = 0
                                        want = 0
                                        IfCondition EqualTo(ei, 0) ThenBlock: {
                                            IfCondition EqualTo(j0, 5) ThenBlock: {
                                                mer_ce = CAD_Store.Read(blend_ce, 3)
                                                want = 1
                                            }
                                        }
                                        IfCondition EqualTo(ei, 1) ThenBlock: {
                                            IfCondition EqualTo(j1, 5) ThenBlock: {
                                                mer_ce = CAD_Store.Read(blend_ce, 2)
                                                want = 1
                                            }
                                        }
                                        IfCondition EqualTo(want, 1) ThenBlock: {
                                            IfCondition NotEqual(mer_ce, 0) ThenBlock: {
                                                mer_e = CAD_Store.Read(mer_ce, 0)
                                                IfCondition NotEqual(mer_e, 0) ThenBlock: {
                                                    mv0 = CAD_Store.Read(mer_e, 0)
                                                    mv1 = CAD_Store.Read(mer_e, 1)
                                                    th = mv0
                                                    hit = 0
                                                    IfCondition EqualTo(mv0, gv0) ThenBlock: { hit = 1 }
                                                    IfCondition EqualTo(mv0, gv1) ThenBlock: { hit = 1 }
                                                    IfCondition EqualTo(hit, 0) ThenBlock: { th = mv1 }
                                                    skip = 0
                                                    IfCondition EqualTo(th, 0) ThenBlock: { skip = 1 }
                                                    IfCondition EqualTo(th, th_a) ThenBlock: { skip = 1 }
                                                    IfCondition EqualTo(th, th_b) ThenBlock: { skip = 1 }
                                                    IfCondition EqualTo(skip, 0) ThenBlock: {
                                                        IfCondition EqualTo(n_th, 0) ThenBlock: { th_a = th }
                                                        IfCondition EqualTo(n_th, 1) ThenBlock: { th_b = th }
                                                        n_th = Add(n_th, 1)
                                                    }
                                                }
                                            }
                                        }
                                        ei = Add(ei, 1)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("notch nTh=", 10, n_th)
        CAD_Topo.FilletDumpI(" nHost=", 7, n_host)
        CAD_Topo.FilletDumpS("\n", 1)
        IfCondition EqualTo(host_e, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(n_host, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n_th, 1) ThenBlock: {
            IfCondition EqualTo(th_a, 0) ThenBlock: { ReturnValue(1) }
            ok = CAD_Topo.FilletPlexNotchHostOne(th_a, host_e)
            ReturnValue(ok)
        }
        IfCondition NotEqual(n_th, 2) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(th_b, 0) ThenBlock: { ReturnValue(1) }
        hv0 = CAD_Store.Read(host_e, 0)
        aa = CAD_Topo.FilletMerCloser(th_a, th_b, hv0)
        bb = th_b
        IfCondition EqualTo(aa, th_b) ThenBlock: { bb = th_a }
        ok = CAD_Topo.FilletPlexNotchHost(aa, bb, host_e)
        ReturnValue(ok)
    }
}

// One sharp CIRCLE plus LINEs. Scan returns 2 (not this pattern),
// 0 (matched, but the hit/axis/radius is bad — do not emit-chain),
// or 1 (both arc ends hit the host cylinder at Rmaj). The flag stays
// clear until the orchestrator zeros the circle and fillets the LINEs.
// Buffer (arc4b), 8-byte slots:
//  0 Rmaj  1 circle edge  2 circle IR  3 cx  4 cy  5 cz  6 Rh
//  7 line0 IR  8 which0  9 line1 IR  10 which1
//  11 corner0  12 corner1  13..15 hit0  16..18 hit1
//  19 trim0  20 trim1  21 mer0  22 mer1  23 line0 edge  24 line1 edge
//  26 torus face
// |N·radial| >= 0.8 is G1 and falls through. Both joints must be sharp.

Function.CAD_Topo.FilletPlexArcSharpG1 {
    Input: line_i: Integer
    Input: corner_v: Integer
    Input: circ_e: Integer
    Output: Integer
    Body: {
        // 1 = tangent, 0 = sharp, 2 = degenerate.
        IfCondition EqualTo(corner_v, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(circ_e, 0) ThenBlock: { ReturnValue(2) }
        nx = CAD_Topo.FilletIRSolGet(line_i, 9)
        ny = CAD_Topo.FilletIRSolGet(line_i, 10)
        nz = CAD_Topo.FilletIRSolGet(line_i, 11)
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(2) }
        nx = Float_Div(nx, ln)
        ny = Float_Div(ny, ln)
        nz = Float_Div(nz, ln)
        crv = CAD_Store.Read(circ_e, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(2) }
        cx = CAD_Store.Read(crv, 1)
        cy = CAD_Store.Read(crv, 2)
        vx = CAD_Store.Read(corner_v, 0)
        vy = CAD_Store.Read(corner_v, 1)
        dx = Float_Sub(vx, cx)
        dy = Float_Sub(vy, cy)
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(2) }
        dx = Float_Div(dx, ln)
        dy = Float_Div(dy, ln)
        dot = Float_Add(Float_Add(Float_Mul(nx, dx), Float_Mul(ny, dy)), Float_Mul(nz, 0))
        IfCondition EqualTo(CAD_Num.IsNeg(dot), 1) ThenBlock: { dot = Float_Sub(0, dot) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(dot, 0x3FE999999999999A)), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Hit one LINE's unshortened Th against the host cylinder at Rmaj.
// Smaller |s|. Writes xyz at buffer[base]. 0 miss, 1 ok. Does not set arc4.
Function.CAD_Topo.FilletPlexArcSharpHit {
    Input: line_i: Integer
    Input: which_end: Integer
    Input: base: Integer
    Output: Integer
    Body: {
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        cx = ArrayGet(bp, 3)
        cy = ArrayGet(bp, 4)
        rr = ArrayGet(bp, 0)
        e = CAD_Topo.FilletIRGet(line_i, 0)
        IfCondition EqualTo(e, 0) ThenBlock: { ReturnValue(0) }
        v0 = CAD_Store.Read(e, 0)
        v1 = CAD_Store.Read(e, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        x0 = CAD_Store.Read(v0, 0)
        y0 = CAD_Store.Read(v0, 1)
        z0 = CAD_Store.Read(v0, 2)
        x1 = CAD_Store.Read(v1, 0)
        y1 = CAD_Store.Read(v1, 1)
        z1 = CAD_Store.Read(v1, 2)
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        dz = Float_Sub(z1, z0)
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(0) }
        dx = Float_Div(dx, ln)
        dy = Float_Div(dy, ln)
        dz = Float_Div(dz, ln)
        fs = 14
        bs = 0
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            fs = 15
            bs = 6
        }
        okf = CAD_Topo.FilletIRVSolGet(line_i, fs)
        IfCondition NotEqual(okf, 1) ThenBlock: { ReturnValue(0) }
        thx = CAD_Topo.FilletIRVSolGet(line_i, bs)
        bs1 = Add(bs, 1)
        thy = CAD_Topo.FilletIRVSolGet(line_i, bs1)
        bs2 = Add(bs, 2)
        thz = CAD_Topo.FilletIRVSolGet(line_i, bs2)
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: {
            CAD_Topo_FLoc.pt = Allocate(32)
        }
        pt = CAD_Topo_FLoc.pt
        IfCondition EqualTo(pt, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.edx = dx
        CAD_Topo_FLoc.edy = dy
        CAD_Topo_FLoc.edz = dz
        ok = CAD_Topo.FilletPlexHitZCyl(cx, cy, rr, thx, thy, thz)
        pt = CAD_Topo_FLoc.pt
        ab = CAD_Topo_FLoc.ab
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(ab, 0), 1) ThenBlock: { ReturnValue(0) }
        hx = ArrayGet(pt, 0)
        hy = ArrayGet(pt, 1)
        hz = ArrayGet(pt, 2)
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        ix = base
        ArraySet(bp, ix, hx)
        ix = Add(base, 1)
        ArraySet(bp, ix, hy)
        ix = Add(base, 2)
        ArraySet(bp, ix, hz)
        CAD_Topo.FilletDumpI("fillet arc4 hit ", 16, which_end)
        CAD_Topo.FilletDumpU(" ", 1, hx)
        CAD_Topo.FilletDumpU(" ", 1, hy)
        CAD_Topo.FilletDumpU(" ", 1, hz)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Project hit xy radially onto the host circle at lid z. Returns the vertex.
Function.CAD_Topo.FilletPlexArcSharpTrim {
    Input: base: Integer
    Output: Integer
    Body: {
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        hx = ArrayGet(bp, base)
        ix = Add(base, 1)
        hy = ArrayGet(bp, ix)
        cx = ArrayGet(bp, 3)
        cy = ArrayGet(bp, 4)
        cz = ArrayGet(bp, 5)
        rh = ArrayGet(bp, 6)
        IfCondition EqualTo(CAD_Num.IsZero(rh, 0), 1) ThenBlock: { ReturnValue(0) }
        dx = Float_Sub(hx, cx)
        dy = Float_Sub(hy, cy)
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(0) }
        dx = Float_Div(dx, ln)
        dy = Float_Div(dy, ln)
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: {
            CAD_Topo_FLoc.pt = Allocate(32)
        }
        pt = CAD_Topo_FLoc.pt
        IfCondition EqualTo(pt, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(pt, 0, Float_Add(cx, Float_Mul(rh, dx)))
        ArraySet(pt, 1, Float_Add(cy, Float_Mul(rh, dy)))
        ArraySet(pt, 2, cz)
        ReturnValue(CAD_Topo.MakeVertex(pt))
    }
}

// Put every saved circle back. Leaves the arc4 flag alone.
Function.CAD_Topo.FilletPlexArcSharpRestore {
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        IfCondition NotEqual(tab, 0) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, nc) {
                b = Multiply(i, 24)
                eh = ArrayGet(tab, b)
                ci = ArrayGet(tab, Add(b, 1))
                IfCondition NotEqual(eh, 0) ThenBlock: {
                    CAD_Topo.FilletIRPut(ci, 0, eh)
                }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(tab, 0) ThenBlock: {
            bp = CAD_Topo_FPlex.arc4b
            IfCondition NotEqual(bp, 0) ThenBlock: {
                ci = ArrayGet(bp, 2)
                eh = ArrayGet(bp, 1)
                IfCondition NotEqual(eh, 0) ThenBlock: {
                    CAD_Topo.FilletIRPut(ci, 0, eh)
                }
            }
        }
        ReturnValue(1)
    }
}

// Hide every selected circle so sequential fillets only the lines.
Function.CAD_Topo.FilletPlexArcSharpZero {
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 24)
            ci = ArrayGet(tab, Add(b, 1))
            CAD_Topo.FilletIRPut(ci, 0, 0)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Put the saved circles back and drop the flag.
Function.CAD_Topo.FilletPlexArcSharpClear {
    Output: Integer
    Body: {
        CAD_Topo.FilletPlexArcSharpRestore()
        CAD_Topo_FPlex.arc4 = 0
        ReturnValue(1)
    }
}

// Signed short span of a circle from its current v0 to v1. Does not
// swap the vertices: SampleCircleEdge walks the sign, and a swap would
// flip the coedge.
Function.CAD_Topo.FilletPlexCircleSpan {
    Input: crv: Integer
    Input: v0: Integer
    Input: v1: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, v1) ThenBlock: {
            CAD_Store.Write(crv, 12, 0)
            ReturnValue(1)
        }
        cx = CAD_Store.Read(crv, 1)
        cy = CAD_Store.Read(crv, 2)
        cz = CAD_Store.Read(crv, 3)
        xx = CAD_Store.Read(crv, 4)
        xy = CAD_Store.Read(crv, 5)
        xz = CAD_Store.Read(crv, 6)
        yx = CAD_Store.Read(crv, 7)
        yy = CAD_Store.Read(crv, 8)
        yz = CAD_Store.Read(crv, 9)
        p0x = Float_Sub(CAD_Store.Read(v0, 0), cx)
        p0y = Float_Sub(CAD_Store.Read(v0, 1), cy)
        p0z = Float_Sub(CAD_Store.Read(v0, 2), cz)
        p1x = Float_Sub(CAD_Store.Read(v1, 0), cx)
        p1y = Float_Sub(CAD_Store.Read(v1, 1), cy)
        p1z = Float_Sub(CAD_Store.Read(v1, 2), cz)
        u0 = Float_Add(Float_Add(Float_Mul(p0x, xx), Float_Mul(p0y, xy)), Float_Mul(p0z, xz))
        w0 = Float_Add(Float_Add(Float_Mul(p0x, yx), Float_Mul(p0y, yy)), Float_Mul(p0z, yz))
        u1 = Float_Add(Float_Add(Float_Mul(p1x, xx), Float_Mul(p1y, xy)), Float_Mul(p1z, xz))
        w1 = Float_Add(Float_Add(Float_Mul(p1x, yx), Float_Mul(p1y, yy)), Float_Mul(p1z, yz))
        a0 = CAD_Geom.Atan2(w0, u0)
        a1 = CAD_Geom.Atan2(w1, u1)
        span = Float_Sub(a1, a0)
        two_pi = 0x401921FB54442D18
        pi = 0x400921FB54442D18
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(span, Float_Sub(0, pi))), 1) ThenBlock: {
            span = Float_Add(span, two_pi)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, span)), 1) ThenBlock: {
            span = Float_Sub(span, two_pi)
        }
        CAD_Store.Write(crv, 12, span)
        ReturnValue(1)
    }
}

// Move every circle edge that still holds old_v onto new_v and rewrite
// its span. Lines stay on MeetLineTo. Handle equality, so a second visit
// is a no-op. Assumes FSeq.h is the solid.
Function.CAD_Topo.FilletPlexRetargetCircles {
    Input: old_v: Integer
    Input: new_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(old_v, new_v) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FSeq.h, 0)
        CAD_Topo_FCE.sg = 0
        WhileLoop NotEqual(CAD_Topo_FCE.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FCE.sg, 64) ThenBlock: { CAD_Topo_FCE.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FCE.sh, 0) ThenBlock: {
                CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.sh, 0)
                CAD_Topo_FCE.fg = 0
                WhileLoop NotEqual(CAD_Topo_FCE.face, 0) {
                    IfCondition GreaterThan(CAD_Topo_FCE.fg, 4096) ThenBlock: { CAD_Topo_FCE.face = 0 }
                    IfCondition NotEqual(CAD_Topo_FCE.face, 0) ThenBlock: {
                        CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.face, 1)
                        IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                            CAD_Topo_FCE.ce = CAD_Store.Read(CAD_Topo_FCE.lp, 0)
                            CAD_Topo_FCE.hd = CAD_Topo_FCE.ce
                            CAD_Topo_FCE.g = 0
                            WhileLoop LessThan(CAD_Topo_FCE.g, 16) {
                                IfCondition EqualTo(CAD_Topo_FCE.ce, 0) ThenBlock: { CAD_Topo_FCE.g = 16 }
                                IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: {
                                    ed = CAD_Store.Read(CAD_Topo_FCE.ce, 0)
                                    nxt = CAD_Store.Read(CAD_Topo_FCE.ce, 2)
                                    IfCondition NotEqual(ed, 0) ThenBlock: {
                                        crv = CAD_Store.Read(ed, 2)
                                        IfCondition NotEqual(crv, 0) ThenBlock: {
                                            IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                                                va = CAD_Store.Read(ed, 0)
                                                vb = CAD_Store.Read(ed, 1)
                                                hit = 0
                                                IfCondition EqualTo(va, old_v) ThenBlock: { hit = 1 }
                                                IfCondition EqualTo(vb, old_v) ThenBlock: { hit = 1 }
                                                IfCondition EqualTo(hit, 1) ThenBlock: {
                                                    CAD_Topo.EdgeRetargetVert(ed, old_v, new_v)
                                                    va = CAD_Store.Read(ed, 0)
                                                    vb = CAD_Store.Read(ed, 1)
                                                    CAD_Topo.FilletPlexCircleSpan(crv, va, vb)
                                                }
                                            }
                                        }
                                    }
                                    CAD_Topo_FCE.ce = nxt
                                    IfCondition EqualTo(CAD_Topo_FCE.ce, CAD_Topo_FCE.hd) ThenBlock: { CAD_Topo_FCE.g = 16 }
                                }
                                CAD_Topo_FCE.g = Add(CAD_Topo_FCE.g, 1)
                            }
                        }
                        CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.face, 3)
                    }
                    CAD_Topo_FCE.fg = Add(CAD_Topo_FCE.fg, 1)
                }
                CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FCE.sh, 2)
            }
            CAD_Topo_FCE.sg = Add(CAD_Topo_FCE.sg, 1)
        }
        ReturnValue(1)
    }
}

// Fillet-zone cylinder∩torus edge from the lid contact sv to
// S = corner − R·N. N is the meridian radius toward sv, W toward the
// cylinder wall contact. Stores the frame; does not sample φ.
// Edge is (sv, S). FLoc.sn is S, written last.
Function.CAD_Topo.FilletPlexArcSharpCope {
    Input: line_e: Integer
    Input: sv: Integer
    Input: tw: Integer
    Input: corner: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        rmaj = ArrayGet(bp, 0)
        cx = ArrayGet(bp, 3)
        cy = ArrayGet(bp, 4)
        rh = ArrayGet(bp, 6)
        IfCondition EqualTo(CAD_Num.IsZero(rmaj, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(rh, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(line_e, 0) ThenBlock: { ReturnValue(0) }
        crv = CAD_Store.Read(line_e, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 2) ThenBlock: { ReturnValue(0) }
        mx = CAD_Store.Read(crv, 1)
        my = CAD_Store.Read(crv, 2)
        mz = CAD_Store.Read(crv, 3)
        wx = Float_Sub(CAD_Store.Read(tw, 0), mx)
        wy = Float_Sub(CAD_Store.Read(tw, 1), my)
        wz = Float_Sub(CAD_Store.Read(tw, 2), mz)
        wl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(wx, wx), Float_Mul(wy, wy)), Float_Mul(wz, wz)))
        IfCondition EqualTo(CAD_Num.IsZero(wl, 0), 1) ThenBlock: { ReturnValue(0) }
        wx = Float_Div(wx, wl)
        wy = Float_Div(wy, wl)
        wz = Float_Div(wz, wl)
        nx = Float_Sub(CAD_Store.Read(sv, 0), mx)
        ny = Float_Sub(CAD_Store.Read(sv, 1), my)
        nz = Float_Sub(CAD_Store.Read(sv, 2), mz)
        wl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(wl, 0), 1) ThenBlock: { ReturnValue(0) }
        nx = Float_Div(nx, wl)
        ny = Float_Div(ny, wl)
        nz = Float_Div(nz, wl)
        dx = Float_Sub(Float_Mul(wy, nz), Float_Mul(wz, ny))
        dy = Float_Sub(Float_Mul(wz, nx), Float_Mul(wx, nz))
        dz = Float_Sub(Float_Mul(wx, ny), Float_Mul(wy, nx))
        wl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz)))
        IfCondition EqualTo(CAD_Num.IsZero(wl, 0), 1) ThenBlock: { ReturnValue(0) }
        dx = Float_Div(dx, wl)
        dy = Float_Div(dy, wl)
        dz = Float_Div(dz, wl)
        vx = Float_Sub(CAD_Store.Read(corner, 0), Float_Mul(radius_r, nx))
        vy = Float_Sub(CAD_Store.Read(corner, 1), Float_Mul(radius_r, ny))
        vz = Float_Sub(CAD_Store.Read(corner, 2), Float_Mul(radius_r, nz))
        buf = Allocate(32)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(buf, 0, vx)
        ArraySet(buf, 1, vy)
        ArraySet(buf, 2, vz)
        vh = CAD_Topo.MakeVertex(buf)
        Deallocate(buf, 32)
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        ch = CAD_Store.Alloc(16, 19)
        IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(ch, 0, 5)
        CAD_Store.Write(ch, 1, mx)
        CAD_Store.Write(ch, 2, my)
        CAD_Store.Write(ch, 3, mz)
        CAD_Store.Write(ch, 4, wx)
        CAD_Store.Write(ch, 5, wy)
        CAD_Store.Write(ch, 6, wz)
        CAD_Store.Write(ch, 7, nx)
        CAD_Store.Write(ch, 8, ny)
        CAD_Store.Write(ch, 9, nz)
        CAD_Store.Write(ch, 10, dx)
        CAD_Store.Write(ch, 11, dy)
        CAD_Store.Write(ch, 12, dz)
        CAD_Store.Write(ch, 13, radius_r)
        CAD_Store.Write(ch, 14, rmaj)
        CAD_Store.Write(ch, 15, rh)
        CAD_Store.Write(ch, 16, cx)
        CAD_Store.Write(ch, 17, cy)
        CAD_Store.Write(ch, 18, mz)
        ed = CAD_Topo.MakeEdge(sv, vh, ch)
        IfCondition EqualTo(ed, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.sn = vh
        ReturnValue(ed)
    }
}

// The vertical wall edge still ends on the profile corner after the
// cope is written. Move that end onto S. A lid line at the same corner
// stays: pulling it down to S would drop the top face.
Function.CAD_Topo.FilletPlexArcSharpDropCorner {
    Input: solid_h: Integer
    Input: corner: Integer
    Input: sn: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(corner, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(sn, 0) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(corner, 0)
        cy = CAD_Store.Read(corner, 1)
        cz = CAD_Store.Read(corner, 2)
        n = 0
        sh = CAD_Store.Read(solid_h, 0)
        sg = 0
        WhileLoop NotEqual(sh, 0) {
            IfCondition GreaterThan(sg, 64) ThenBlock: { sh = 0 }
            IfCondition NotEqual(sh, 0) ThenBlock: {
                face = CAD_Store.Read(sh, 0)
                fg = 0
                WhileLoop NotEqual(face, 0) {
                    IfCondition GreaterThan(fg, 4096) ThenBlock: { face = 0 }
                    IfCondition NotEqual(face, 0) ThenBlock: {
                        nxtf = CAD_Store.Read(face, 3)
                        lp = CAD_Store.Read(face, 1)
                        IfCondition NotEqual(lp, 0) ThenBlock: {
                            ce = CAD_Store.Read(lp, 0)
                            hd = ce
                            g = 0
                            WhileLoop LessThan(g, 16) {
                                IfCondition EqualTo(ce, 0) ThenBlock: { g = 16 }
                                IfCondition NotEqual(ce, 0) ThenBlock: {
                                    ed = CAD_Store.Read(ce, 0)
                                    nxt = CAD_Store.Read(ce, 2)
                                    IfCondition NotEqual(ed, 0) ThenBlock: {
                                        crv = CAD_Store.Read(ed, 2)
                                        ck = 0
                                        IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                                        IfCondition EqualTo(ck, 1) ThenBlock: {
                                            va = CAD_Store.Read(ed, 0)
                                            vb = CAD_Store.Read(ed, 1)
                                            ha = CAD_Topo.VertSamePos(va, corner)
                                            hb = CAD_Topo.VertSamePos(vb, corner)
                                            IfCondition EqualTo(ha, 1) ThenBlock: {
                                                IfCondition EqualTo(hb, 1) ThenBlock: {
                                                    ha = 0
                                                    hb = 0
                                                }
                                            }
                                            ov = 0
                                            mv = 0
                                            IfCondition EqualTo(ha, 1) ThenBlock: {
                                                ov = vb
                                                mv = va
                                            }
                                            IfCondition EqualTo(hb, 1) ThenBlock: {
                                                ov = va
                                                mv = vb
                                            }
                                            IfCondition NotEqual(ov, 0) ThenBlock: {
                                                ox = CAD_Store.Read(ov, 0)
                                                oy = CAD_Store.Read(ov, 1)
                                                oz = CAD_Store.Read(ov, 2)
                                                same_xy = 0
                                                IfCondition EqualTo(CAD_Num.IsEqual(ox, cx, 0), 1) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Num.IsEqual(oy, cy, 0), 1) ThenBlock: { same_xy = 1 }
                                                }
                                                same_z = CAD_Num.IsEqual(oz, cz, 0)
                                                IfCondition EqualTo(same_xy, 1) ThenBlock: {
                                                    IfCondition EqualTo(same_z, 0) ThenBlock: {
                                                        CAD_Topo.EdgeRetargetVert(ed, mv, sn)
                                                        n = Add(n, 1)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ce = nxt
                                    IfCondition EqualTo(ce, hd) ThenBlock: { g = 16 }
                                }
                                g = Add(g, 1)
                            }
                        }
                        face = nxtf
                    }
                    fg = Add(fg, 1)
                }
                sh = CAD_Store.Read(sh, 2)
            }
            sg = Add(sg, 1)
        }
        CAD_Topo.FilletDumpI("fillet arc4 drop ", 17, n)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        ReturnValue(n)
    }
}

// Seam one arc end. The cope runs from the lid contact to S on the wall
// (corner − R·N). Both fillet faces stay 4-sided. No digon and no sphere.
Function.CAD_Topo.FilletPlexArcSharpSeam {
    Input: solid_h: Integer
    Input: which_end: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        slm = 21
        slc = 11
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            slm = 22
            slc = 12
        }
        mer = ArrayGet(bp, slm)
        corner = ArrayGet(bp, slc)
        face_t = ArrayGet(bp, 26)
        IfCondition EqualTo(mer, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail mer\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(corner, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail corner\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(face_t, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail face\n")
            ReturnValue(0)
        }
        ta = CAD_Store.Read(mer, 0)
        tb = CAD_Store.Read(mer, 1)
        IfCondition EqualTo(ta, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tb, 0) ThenBlock: { ReturnValue(0) }
        found = 0
        line_e = 0
        line_f = 0
        sh = CAD_Store.Read(solid_h, 0)
        sg = 0
        WhileLoop NotEqual(sh, 0) {
            IfCondition GreaterThan(sg, 64) ThenBlock: { sh = 0 }
            IfCondition NotEqual(sh, 0) ThenBlock: {
                face = CAD_Store.Read(sh, 0)
                fg = 0
                WhileLoop NotEqual(face, 0) {
                    IfCondition GreaterThan(fg, 64) ThenBlock: { face = 0 }
                    IfCondition NotEqual(face, 0) ThenBlock: {
                        nxtf = CAD_Store.Read(face, 3)
                        surf = CAD_Store.Read(face, 0)
                        sk = 0
                        IfCondition NotEqual(surf, 0) ThenBlock: { sk = CAD_Store.Read(surf, 0) }
                        IfCondition EqualTo(sk, 2) ThenBlock: {
                            lp = CAD_Store.Read(face, 1)
                            IfCondition NotEqual(lp, 0) ThenBlock: {
                                ce = CAD_Store.Read(lp, 0)
                                hd = ce
                                g = 0
                                WhileLoop LessThan(g, 16) {
                                    IfCondition EqualTo(ce, 0) ThenBlock: { g = 16 }
                                    IfCondition NotEqual(ce, 0) ThenBlock: {
                                        e = CAD_Store.Read(ce, 0)
                                        nxt = CAD_Store.Read(ce, 2)
                                        IfCondition NotEqual(e, 0) ThenBlock: {
                                            IfCondition NotEqual(e, mer) ThenBlock: {
                                                crv = CAD_Store.Read(e, 2)
                                                ck = 0
                                                IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                                                IfCondition EqualTo(ck, 2) ThenBlock: {
                                                    ea = CAD_Store.Read(e, 0)
                                                    eb = CAD_Store.Read(e, 1)
                                                    za = 0
                                                    zb = 0
                                                    IfCondition NotEqual(ea, 0) ThenBlock: { za = CAD_Store.Read(ea, 2) }
                                                    IfCondition NotEqual(eb, 0) ThenBlock: { zb = CAD_Store.Read(eb, 2) }
                                                    // Host rail is horizontal. The line mer spans lid to wall.
                                                    IfCondition EqualTo(CAD_Num.IsEqual(za, zb, 0), 0) ThenBlock: {
                                                        hit = 0
                                                        IfCondition EqualTo(CAD_Topo.VertSamePos(ea, ta), 1) ThenBlock: { hit = 1 }
                                                        IfCondition EqualTo(CAD_Topo.VertSamePos(ea, tb), 1) ThenBlock: { hit = 1 }
                                                        IfCondition EqualTo(CAD_Topo.VertSamePos(eb, ta), 1) ThenBlock: { hit = 1 }
                                                        IfCondition EqualTo(CAD_Topo.VertSamePos(eb, tb), 1) ThenBlock: { hit = 1 }
                                                        IfCondition EqualTo(hit, 1) ThenBlock: {
                                                            IfCondition EqualTo(found, 0) ThenBlock: {
                                                                line_e = e
                                                                line_f = face
                                                                found = 1
                                                            }
                                                            IfCondition NotEqual(e, line_e) ThenBlock: { found = 2 }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        ce = nxt
                                        IfCondition EqualTo(ce, hd) ThenBlock: { g = 16 }
                                    }
                                    g = Add(g, 1)
                                }
                            }
                        }
                        face = nxtf
                    }
                    fg = Add(fg, 1)
                }
                sh = CAD_Store.Read(sh, 2)
            }
            sg = Add(sg, 1)
        }
        IfCondition NotEqual(found, 1) ThenBlock: {
            CAD_Topo.FilletDumpI("fillet arc4 seam fail n=", 24, found)
            CAD_Topo.FilletDumpI("end=", 4, which_end)
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            ReturnValue(0)
        }
        ce0 = CAD_Topo.FindCoedgeOnFace(line_f, line_e)
        ce1 = CAD_Topo.FindCoedgeOnFace(face_t, mer)
        IfCondition EqualTo(ce0, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail ce0\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(ce1, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail ce1\n")
            ReturnValue(0)
        }
        la = CAD_Store.Read(line_e, 0)
        lb = CAD_Store.Read(line_e, 1)
        sv = 0
        tw = 0
        IfCondition EqualTo(CAD_Topo.VertSamePos(la, ta), 1) ThenBlock: {
            sv = la
            tw = lb
        }
        IfCondition EqualTo(CAD_Topo.VertSamePos(la, tb), 1) ThenBlock: {
            sv = la
            tw = lb
        }
        IfCondition EqualTo(sv, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.VertSamePos(lb, ta), 1) ThenBlock: {
                sv = lb
                tw = la
            }
            IfCondition EqualTo(CAD_Topo.VertSamePos(lb, tb), 1) ThenBlock: {
                sv = lb
                tw = la
            }
        }
        IfCondition EqualTo(sv, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail share\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        sa = CAD_Topo.VertSamePos(ta, sv)
        sb = CAD_Topo.VertSamePos(tb, sv)
        IfCondition EqualTo(sa, 1) ThenBlock: {
            IfCondition EqualTo(sb, 1) ThenBlock: { ReturnValue(0) }
        }
        gv = 0
        IfCondition EqualTo(sa, 1) ThenBlock: { gv = tb }
        IfCondition EqualTo(sb, 1) ThenBlock: { gv = ta }
        IfCondition EqualTo(gv, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail g\n")
            ReturnValue(0)
        }
        dig = CAD_Topo.FilletPlexArcSharpCope(line_e, sv, tw, corner, radius_r)
        IfCondition EqualTo(dig, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail cope\n")
            ReturnValue(0)
        }
        sn = CAD_Store.Read(dig, 1)
        IfCondition EqualTo(sn, 0) ThenBlock: { ReturnValue(0) }
        sx = CAD_Store.Read(sn, 0)
        sy = CAD_Store.Read(sn, 1)
        sz = CAD_Store.Read(sn, 2)
        CAD_Topo.FilletDumpU("fillet arc4 sn ", 15, sx)
        CAD_Topo.FilletDumpU(" ", 1, sy)
        CAD_Topo.FilletDumpU(" ", 1, sz)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        CAD_Topo_FSeq.h = solid_h
        CAD_Topo.FilletRailsMeetLineTo(tw, sn)
        CAD_Topo.FilletRailsMeetLineTo(gv, sn)
        CAD_Topo.FilletPlexRetargetCircles(gv, sn)
        vx = CAD_Store.Read(sv, 0)
        vy = CAD_Store.Read(sv, 1)
        vz = CAD_Store.Read(sv, 2)
        CAD_Topo_FVert.px = vx
        CAD_Topo_FVert.py = vy
        CAD_Topo_FVert.pz = vz
        CAD_Topo_FLoc.v0 = sv
        CAD_Topo_FLoc.sn = sn
        CAD_Topo_FSeq.h = solid_h
        CAD_Topo.FilletRailsMeetPin()
        CAD_Topo.FilletPlexArcSharpDropCorner(solid_h, corner, sn)
        vv = CAD_Store.Read(ce0, 5)
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, sv), 1) ThenBlock: { vv = sv }
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, sv), 0) ThenBlock: { vv = sn }
        nce = CAD_Topo.CoedgeSwapEdge(ce0, dig, vv)
        IfCondition EqualTo(nce, 0) ThenBlock: { ReturnValue(0) }
        sens = 1
        dv0 = CAD_Store.Read(dig, 0)
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, dv0), 0) ThenBlock: { sens = 0 }
        CAD_Store.Write(nce, 6, sens)
        vv = CAD_Store.Read(ce1, 5)
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, sv), 1) ThenBlock: { vv = sv }
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, sv), 0) ThenBlock: { vv = sn }
        nce = CAD_Topo.CoedgeSwapEdge(ce1, dig, vv)
        IfCondition EqualTo(nce, 0) ThenBlock: { ReturnValue(0) }
        sens = 1
        dv0 = CAD_Store.Read(dig, 0)
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, dv0), 0) ThenBlock: { sens = 0 }
        CAD_Store.Write(nce, 6, sens)
        CAD_Topo.FilletDumpI("fillet arc4 seam ", 17, which_end)
        CAD_Topo.FilletDumpLine("ok\n")
        ReturnValue(1)
    }
}

// Circle table arc4c, stride 24, max 8. One row per selected open arc.
//  0 edge  1 ir  2 rmaj  3 rh  4 cx  5 cy  6 cz  7 v0  8 v1
//  9 end0 kind (1 line, 2 arc)  10 end0 index  11 end0 which
//  12 end1 kind  13 end1 index  14 end1 which
//  15 flags  16 mer0  17 mer1  18 face  19 trim0  20 trim1
//  21 shost  22 srad  23 reserved
// bp stays the one-circle buffer the line-arc hit, trim, and seam read.
// A G1 joint (|dot| >= 0.8) still refuses the whole selection.

// Rmaj of the selected arc whose wall center is (ocx, ocy). 0 = none.
Function.CAD_Topo.FilletPlexArcSharpRmaj {
    Input: ocx: Integer
    Input: ocy: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 24)
            cx = ArrayGet(tab, Add(b, 4))
            cy = ArrayGet(tab, Add(b, 5))
            hit = 0
            IfCondition EqualTo(CAD_Num.IsEqual(cx, ocx, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(cy, ocy, 0), 1) ThenBlock: { hit = 1 }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(ArrayGet(tab, Add(b, 2)))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when the vertices are the same record or the same position.
Function.CAD_Topo.FilletPlexArcSharpSame {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(a, b) ThenBlock: { ReturnValue(1) }
        ReturnValue(CAD_Topo.VertSamePos(a, b))
    }
}

// 1 tangent, 0 sharp, 2 degenerate. Radials of the two host circles.
// Near-collinear only (|dot| >= 0.999, about 2.6 deg). Line-arc G1 stays at 0.8.
Function.CAD_Topo.FilletPlexArcSharpG1Arc {
    Input: corner_v: Integer
    Input: e0: Integer
    Input: e1: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(corner_v, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(e0, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(e1, 0) ThenBlock: { ReturnValue(2) }
        c0 = CAD_Store.Read(e0, 2)
        c1 = CAD_Store.Read(e1, 2)
        IfCondition EqualTo(c0, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(c1, 0) ThenBlock: { ReturnValue(2) }
        vx = CAD_Store.Read(corner_v, 0)
        vy = CAD_Store.Read(corner_v, 1)
        ax = Float_Sub(vx, CAD_Store.Read(c0, 1))
        ay = Float_Sub(vy, CAD_Store.Read(c0, 2))
        bx = Float_Sub(vx, CAD_Store.Read(c1, 1))
        by = Float_Sub(vy, CAD_Store.Read(c1, 2))
        la = CAD_Num.Sqrt(Float_Add(Float_Mul(ax, ax), Float_Mul(ay, ay)))
        lb = CAD_Num.Sqrt(Float_Add(Float_Mul(bx, bx), Float_Mul(by, by)))
        IfCondition EqualTo(CAD_Num.IsZero(la, 0), 1) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(CAD_Num.IsZero(lb, 0), 1) ThenBlock: { ReturnValue(2) }
        ax = Float_Div(ax, la)
        ay = Float_Div(ay, la)
        bx = Float_Div(bx, lb)
        by = Float_Div(by, lb)
        dot = Float_Add(Float_Mul(ax, bx), Float_Mul(ay, by))
        IfCondition EqualTo(CAD_Num.IsNeg(dot), 1) ThenBlock: { dot = Float_Sub(0, dot) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(dot, 0x3FEFF7CED916872B)), 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 g1\n")
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Row of a circle edge, or -1.
Function.CAD_Topo.FilletPlexArcSharpRowOf {
    Input: eh: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 24)
            IfCondition EqualTo(ArrayGet(tab, b), eh) ThenBlock: { ReturnValue(i) }
            i = Add(i, 1)
        }
        miss = Subtract(0, 1)
        ReturnValue(miss)
    }
}

// Copy one circle row into bp so the line-arc helpers keep working.
Function.CAD_Topo.FilletPlexArcSharpLoad {
    Input: ci: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        b = Multiply(ci, 24)
        ArraySet(bp, 0, ArrayGet(tab, Add(b, 2)))
        ArraySet(bp, 1, ArrayGet(tab, b))
        ArraySet(bp, 2, ArrayGet(tab, Add(b, 1)))
        ArraySet(bp, 3, ArrayGet(tab, Add(b, 4)))
        ArraySet(bp, 4, ArrayGet(tab, Add(b, 5)))
        ArraySet(bp, 5, ArrayGet(tab, Add(b, 6)))
        ArraySet(bp, 6, ArrayGet(tab, Add(b, 3)))
        ArraySet(bp, 11, ArrayGet(tab, Add(b, 7)))
        ArraySet(bp, 12, ArrayGet(tab, Add(b, 8)))
        ArraySet(bp, 7, 0)
        ArraySet(bp, 8, 0)
        ArraySet(bp, 9, 0)
        ArraySet(bp, 10, 0)
        ArraySet(bp, 23, 0)
        ArraySet(bp, 24, 0)
        k0 = ArrayGet(tab, Add(b, 9))
        IfCondition EqualTo(k0, 1) ThenBlock: {
            li = ArrayGet(tab, Add(b, 10))
            ArraySet(bp, 7, li)
            ArraySet(bp, 8, ArrayGet(tab, Add(b, 11)))
            ArraySet(bp, 23, CAD_Topo.FilletIRGet(li, 0))
        }
        k1 = ArrayGet(tab, Add(b, 12))
        IfCondition EqualTo(k1, 1) ThenBlock: {
            li = ArrayGet(tab, Add(b, 13))
            ArraySet(bp, 9, li)
            ArraySet(bp, 10, ArrayGet(tab, Add(b, 14)))
            ArraySet(bp, 24, CAD_Topo.FilletIRGet(li, 0))
        }
        ArraySet(bp, 19, ArrayGet(tab, Add(b, 19)))
        ArraySet(bp, 20, ArrayGet(tab, Add(b, 20)))
        ArraySet(bp, 21, ArrayGet(tab, Add(b, 16)))
        ArraySet(bp, 22, ArrayGet(tab, Add(b, 17)))
        ArraySet(bp, 26, ArrayGet(tab, Add(b, 18)))
        ReturnValue(1)
    }
}

// Meridians, face, and trims survive the next circle's emit.
Function.CAD_Topo.FilletPlexArcSharpSave {
    Input: ci: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        b = Multiply(ci, 24)
        ArraySet(tab, Add(b, 19), ArrayGet(bp, 19))
        ArraySet(tab, Add(b, 20), ArrayGet(bp, 20))
        ArraySet(tab, Add(b, 16), ArrayGet(bp, 21))
        ArraySet(tab, Add(b, 17), ArrayGet(bp, 22))
        ArraySet(tab, Add(b, 18), ArrayGet(bp, 26))
        ReturnValue(1)
    }
}

// 1 stored, 2 not this pattern, 0 matched but the radius or wall is bad.
Function.CAD_Topo.FilletPlexArcSharpNote {
    Input: ir: Integer
    Output: Integer
    Body: {
        eh = CAD_Topo.FilletIRGet(ir, 0)
        IfCondition EqualTo(eh, 0) ThenBlock: { ReturnValue(2) }
        IfCondition NotEqual(CAD_Topo.FilletIRGet(ir, 11), 1) ThenBlock: { ReturnValue(2) }
        IfCondition NotEqual(CAD_Topo.FilletIRGet(ir, 15), 4) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(CAD_Topo.FilletIRGet(ir, 19), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(CAD_Topo.FilletIRGet(ir, 20), 0) ThenBlock: { ReturnValue(2) }
        v0 = CAD_Store.Read(eh, 0)
        v1 = CAD_Store.Read(eh, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(v0, v1) ThenBlock: { ReturnValue(2) }
        wall = CAD_Topo.FilletIRGet(ir, 20)
        surf = 0
        IfCondition NotEqual(wall, 0) ThenBlock: { surf = CAD_Store.Read(wall, 0) }
        sk = 0
        IfCondition NotEqual(surf, 0) ThenBlock: { sk = CAD_Store.Read(surf, 0) }
        IfCondition NotEqual(sk, 2) ThenBlock: { ReturnValue(2) }
        zz = CAD_Store.Read(surf, 12)
        IfCondition EqualTo(CAD_Num.IsNeg(zz), 1) ThenBlock: { zz = Float_Sub(0, zz) }
        IfCondition EqualTo(CAD_Num.IsEqual(zz, 0x3FF0000000000000, 0), 0) ThenBlock: { ReturnValue(2) }
        crv = CAD_Store.Read(eh, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(2) }
        ccx = CAD_Store.Read(crv, 1)
        ccy = CAD_Store.Read(crv, 2)
        wcx = CAD_Store.Read(surf, 1)
        wcy = CAD_Store.Read(surf, 2)
        IfCondition EqualTo(CAD_Num.IsEqual(ccx, wcx, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsEqual(ccy, wcy, 0), 0) ThenBlock: { ReturnValue(0) }
        rmj = CAD_Topo.FilletIRSolGet(ir, 12)
        IfCondition EqualTo(CAD_Num.IsZero(rmj, 0), 1) ThenBlock: {
            // Unsolved (R > r) leaves sh and sr at 0: this pattern
            // matched and must not emit. R == r writes sh = sr = -R
            // and a zero major radius, which is the sphere octant
            // on the emit-chain path, not this seam builder.
            sh = CAD_Topo.FilletIRSolGet(ir, 13)
            sr = CAD_Topo.FilletIRSolGet(ir, 14)
            IfCondition EqualTo(CAD_Num.IsZero(sh, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(sr, 0), 1) ThenBlock: { ReturnValue(0) }
            }
            ReturnValue(2)
        }
        rh = CAD_Topo.FilletIRSolGet(ir, 15)
        IfCondition EqualTo(CAD_Num.IsZero(rh, 0), 1) ThenBlock: { rh = CAD_Store.Read(surf, 13) }
        IfCondition EqualTo(CAD_Num.IsZero(rh, 0), 1) ThenBlock: { ReturnValue(0) }
        sh = CAD_Topo.FilletIRSolGet(ir, 13)
        sr = CAD_Topo.FilletIRSolGet(ir, 14)
        cz = CAD_Store.Read(v0, 2)
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(nc, 7) ThenBlock: { ReturnValue(2) }
        b = Multiply(nc, 24)
        ArraySet(tab, b, eh)
        ArraySet(tab, Add(b, 1), ir)
        ArraySet(tab, Add(b, 2), rmj)
        ArraySet(tab, Add(b, 3), rh)
        ArraySet(tab, Add(b, 4), ccx)
        ArraySet(tab, Add(b, 5), ccy)
        ArraySet(tab, Add(b, 6), cz)
        ArraySet(tab, Add(b, 7), v0)
        ArraySet(tab, Add(b, 8), v1)
        s = 9
        WhileLoop LessThan(s, 24) {
            ArraySet(tab, Add(b, s), 0)
            s = Add(s, 1)
        }
        ArraySet(tab, Add(b, 21), sh)
        ArraySet(tab, Add(b, 22), sr)
        CAD_Topo_FPlex.arc4n = Add(nc, 1)
        CAD_Topo.FilletDumpI("fillet arc4 circ ", 17, ir)
        CAD_Topo.FilletDumpU(" ", 1, ccx)
        CAD_Topo.FilletDumpU(" ", 1, ccy)
        CAD_Topo.FilletDumpU(" ", 1, rmj)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Classify both ends of every stored circle. 1 ok, 0 miss, 2 not this.
Function.CAD_Topo.FilletPlexArcSharpBind {
    Input: solid_h: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        n = CAD_Topo_FComp.n
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        ci = 0
        WhileLoop LessThan(ci, nc) {
            b = Multiply(ci, 24)
            eh = ArrayGet(tab, b)
            v0 = ArrayGet(tab, Add(b, 7))
            v1 = ArrayGet(tab, Add(b, 8))
            ccx = ArrayGet(tab, Add(b, 4))
            ccy = ArrayGet(tab, Add(b, 5))
            en = 0
            WhileLoop LessThan(en, 2) {
                cv = v0
                IfCondition EqualTo(en, 1) ThenBlock: { cv = v1 }
                nsel = 0
                kind = 0
                idx = 0
                wh = 0
                i = 0
                WhileLoop LessThan(i, n) {
                    e = CAD_Topo.FilletIRGet(i, 0)
                    IfCondition NotEqual(e, 0) ThenBlock: {
                        IfCondition NotEqual(e, eh) ThenBlock: {
                            knd = CAD_Topo.FilletIRGet(i, 1)
                            use = 0
                            IfCondition EqualTo(knd, 1) ThenBlock: { use = 1 }
                            IfCondition EqualTo(knd, 2) ThenBlock: { use = 1 }
                            IfCondition EqualTo(use, 1) ThenBlock: {
                                a = CAD_Store.Read(e, 0)
                                bb = CAD_Store.Read(e, 1)
                                ha = CAD_Topo.FilletPlexArcSharpSame(a, cv)
                                hb = CAD_Topo.FilletPlexArcSharpSame(bb, cv)
                                hit = ha
                                IfCondition EqualTo(hb, 1) ThenBlock: { hit = 1 }
                                IfCondition EqualTo(hit, 1) ThenBlock: {
                                    nsel = Add(nsel, 1)
                                    IfCondition EqualTo(ha, 1) ThenBlock: {
                                        IfCondition EqualTo(hb, 1) ThenBlock: { nsel = Add(nsel, 1) }
                                    }
                                    IfCondition EqualTo(nsel, 1) ThenBlock: {
                                        kind = knd
                                        idx = i
                                        wh = 0
                                        IfCondition EqualTo(hb, 1) ThenBlock: { wh = 1 }
                                        IfCondition EqualTo(knd, 2) ThenBlock: {
                                            idx = CAD_Topo.FilletPlexArcSharpRowOf(e)
                                        }
                                    }
                                }
                            }
                        }
                    }
                    i = Add(i, 1)
                }
                IfCondition NotEqual(nsel, 1) ThenBlock: {
                    CAD_Topo.FilletDumpLine("fillet arc4 miss share\n")
                    ReturnValue(2)
                }
                IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(kind, 1) ThenBlock: {
                    g = CAD_Topo.FilletPlexArcSharpG1(idx, cv, eh)
                    IfCondition EqualTo(g, 2) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(g, 1) ThenBlock: { ReturnValue(2) }
                    f1 = CAD_Topo.FilletIRGet(idx, 4)
                    f2 = CAD_Topo.FilletIRGet(idx, 5)
                    blk = CAD_Topo.FilletPlexBlockingFace(solid_h, cv, f1, f2)
                    IfCondition EqualTo(blk, 0) ThenBlock: { ReturnValue(0) }
                    surf = CAD_Store.Read(blk, 0)
                    IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
                    sk = CAD_Store.Read(surf, 0)
                    IfCondition NotEqual(sk, 2) ThenBlock: { ReturnValue(0) }
                    zz = CAD_Store.Read(surf, 12)
                    IfCondition EqualTo(CAD_Num.IsNeg(zz), 1) ThenBlock: { zz = Float_Sub(0, zz) }
                    IfCondition EqualTo(CAD_Num.IsEqual(zz, 0x3FF0000000000000, 0), 0) ThenBlock: { ReturnValue(0) }
                    wcx = CAD_Store.Read(surf, 1)
                    wcy = CAD_Store.Read(surf, 2)
                    IfCondition EqualTo(CAD_Num.IsEqual(wcx, ccx, 0), 0) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(CAD_Num.IsEqual(wcy, ccy, 0), 0) ThenBlock: { ReturnValue(0) }
                }
                IfCondition EqualTo(kind, 2) ThenBlock: {
                    ob = Multiply(idx, 24)
                    oe = ArrayGet(tab, ob)
                    g = CAD_Topo.FilletPlexArcSharpG1Arc(cv, eh, oe)
                    IfCondition EqualTo(g, 2) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(g, 1) ThenBlock: { ReturnValue(2) }
                }
                slot = 9
                IfCondition EqualTo(en, 1) ThenBlock: { slot = 12 }
                ArraySet(tab, Add(b, slot), kind)
                ArraySet(tab, Add(b, Add(slot, 1)), idx)
                ArraySet(tab, Add(b, Add(slot, 2)), wh)
                en = Add(en, 1)
            }
            ci = Add(ci, 1)
        }
        ReturnValue(1)
    }
}

// Host point of circle ci at the spine-intersection angle. The lid
// contact is that point plus srad along the same radial, so the trim
// is not the pinch and not the profile corner.
Function.CAD_Topo.FilletPlexArcSharpSpine {
    Input: ci: Integer
    Input: oj: Integer
    Input: corner: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(corner, 0) ThenBlock: { ReturnValue(0) }
        b = Multiply(ci, 24)
        ob = Multiply(oj, 24)
        cx = ArrayGet(tab, Add(b, 4))
        cy = ArrayGet(tab, Add(b, 5))
        cz = ArrayGet(tab, Add(b, 6))
        rh = ArrayGet(tab, Add(b, 3))
        r1 = ArrayGet(tab, Add(b, 2))
        cx2 = ArrayGet(tab, Add(ob, 4))
        cy2 = ArrayGet(tab, Add(ob, 5))
        r2 = ArrayGet(tab, Add(ob, 2))
        IfCondition EqualTo(CAD_Num.IsZero(r1, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(r2, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(rh, 0), 1) ThenBlock: { ReturnValue(0) }
        dx = Float_Sub(cx2, cx)
        dy = Float_Sub(cy2, cy)
        d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: { ReturnValue(0) }
        slack = 0x3F847AE147AE147B
        gap = Float_Sub(d, Float_Add(r1, r2))
        IfCondition EqualTo(CAD_Num.IsNeg(gap), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(gap, slack), 0) ThenBlock: { ReturnValue(0) }
        }
        dif = Float_Sub(r1, r2)
        IfCondition EqualTo(CAD_Num.IsNeg(dif), 1) ThenBlock: { dif = Float_Sub(0, dif) }
        sep = Float_Sub(dif, d)
        IfCondition EqualTo(CAD_Num.IsNeg(sep), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(sep, slack), 0) ThenBlock: { ReturnValue(0) }
        }
        two = 0x4000000000000000
        a = Float_Div(Float_Add(Float_Sub(Float_Mul(r1, r1), Float_Mul(r2, r2)), Float_Mul(d, d)), Float_Mul(two, d))
        h2 = Float_Sub(Float_Mul(r1, r1), Float_Mul(a, a))
        IfCondition EqualTo(CAD_Num.IsNeg(h2), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(h2, 0x3F1A36E2EB1C432D), 1) ThenBlock: { h2 = 0 }
        }
        IfCondition EqualTo(CAD_Num.IsNeg(h2), 1) ThenBlock: { ReturnValue(0) }
        h = CAD_Num.Sqrt(h2)
        ux = Float_Div(dx, d)
        uy = Float_Div(dy, d)
        px = Float_Sub(0, uy)
        py = ux
        mx = Float_Add(cx, Float_Mul(a, ux))
        my = Float_Add(cy, Float_Mul(a, uy))
        p1x = Float_Add(mx, Float_Mul(h, px))
        p1y = Float_Add(my, Float_Mul(h, py))
        p2x = Float_Sub(mx, Float_Mul(h, px))
        p2y = Float_Sub(my, Float_Mul(h, py))
        vx = CAD_Store.Read(corner, 0)
        vy = CAD_Store.Read(corner, 1)
        d1 = Float_Add(CAD_Num.Sq(Float_Sub(p1x, vx)), CAD_Num.Sq(Float_Sub(p1y, vy)))
        d2 = Float_Add(CAD_Num.Sq(Float_Sub(p2x, vx)), CAD_Num.Sq(Float_Sub(p2y, vy)))
        qx = p1x
        qy = p1y
        IfCondition EqualTo(CAD_Num.Le(d2, d1), 1) ThenBlock: {
            qx = p2x
            qy = p2y
        }
        hx = Float_Sub(qx, cx)
        hy = Float_Sub(qy, cy)
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(hx, hx), Float_Mul(hy, hy)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(0) }
        buf = Allocate(32)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(buf, 0, Float_Add(cx, Float_Mul(rh, Float_Div(hx, ln))))
        ArraySet(buf, 1, Float_Add(cy, Float_Mul(rh, Float_Div(hy, ln))))
        ArraySet(buf, 2, cz)
        vh = CAD_Topo.MakeVertex(buf)
        Deallocate(buf, 32)
        ReturnValue(vh)
    }
}

// Trim one end. Line end uses the cylinder hit. Arc end uses the spine.
Function.CAD_Topo.FilletPlexArcSharpEndTrim {
    Input: ci: Integer
    Input: which_end: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        b = Multiply(ci, 24)
        slot = 9
        base = 13
        corner = ArrayGet(tab, Add(b, 7))
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            slot = 12
            base = 16
            corner = ArrayGet(tab, Add(b, 8))
        }
        kind = ArrayGet(tab, Add(b, slot))
        idx = ArrayGet(tab, Add(b, Add(slot, 1)))
        wh = ArrayGet(tab, Add(b, Add(slot, 2)))
        IfCondition EqualTo(kind, 1) ThenBlock: {
            h = CAD_Topo.FilletPlexArcSharpHit(idx, wh, base)
            IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(CAD_Topo.FilletPlexArcSharpTrim(base))
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            ReturnValue(CAD_Topo.FilletPlexArcSharpSpine(ci, idx, corner))
        }
        ReturnValue(0)
    }
}

// Swap one meridian coedge onto the cope. Origin follows the old coedge.
Function.CAD_Topo.FilletPlexArcSharpSwap {
    Input: ce: Integer
    Input: ed: Integer
    Input: lid: Integer
    Input: wall: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ed, 0) ThenBlock: { ReturnValue(0) }
        vv = CAD_Store.Read(ce, 5)
        origin = wall
        same = CAD_Topo.VertSamePos(vv, lid)
        IfCondition EqualTo(same, 1) ThenBlock: { origin = lid }
        nce = CAD_Topo.CoedgeSwapEdge(ce, ed, origin)
        IfCondition EqualTo(nce, 0) ThenBlock: { ReturnValue(0) }
        sens = 1
        dv0 = CAD_Store.Read(ed, 0)
        same = CAD_Topo.VertSamePos(origin, dv0)
        IfCondition EqualTo(same, 0) ThenBlock: { sens = 0 }
        CAD_Store.Write(nce, 6, sens)
        ReturnValue(nce)
    }
}

// Torus∩torus edge. Seamed once, from the lower circle index.
// Edge is (lid pinch, corner at z = lid + shost). No sphere.
Function.CAD_Topo.FilletPlexArcArcSeam {
    Input: solid_h: Integer
    Input: ci: Integer
    Input: which_end: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(solid_h, 0) ThenBlock: { ReturnValue(0) }
        b = Multiply(ci, 24)
        slot = 9
        corner = ArrayGet(tab, Add(b, 7))
        mer = ArrayGet(tab, Add(b, 16))
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            slot = 12
            corner = ArrayGet(tab, Add(b, 8))
            mer = ArrayGet(tab, Add(b, 17))
        }
        kind = ArrayGet(tab, Add(b, slot))
        IfCondition NotEqual(kind, 2) ThenBlock: { ReturnValue(0) }
        oj = ArrayGet(tab, Add(b, Add(slot, 1)))
        ow = ArrayGet(tab, Add(b, Add(slot, 2)))
        IfCondition LessThan(oj, ci) ThenBlock: { ReturnValue(1) }
        face = ArrayGet(tab, Add(b, 18))
        cx = ArrayGet(tab, Add(b, 4))
        cy = ArrayGet(tab, Add(b, 5))
        cz = ArrayGet(tab, Add(b, 6))
        sh = ArrayGet(tab, Add(b, 21))
        rmaj = ArrayGet(tab, Add(b, 2))
        rh = ArrayGet(tab, Add(b, 3))
        ob = Multiply(oj, 24)
        merb = ArrayGet(tab, Add(ob, 16))
        IfCondition EqualTo(ow, 1) ThenBlock: { merb = ArrayGet(tab, Add(ob, 17)) }
        faceb = ArrayGet(tab, Add(ob, 18))
        cx2 = ArrayGet(tab, Add(ob, 4))
        cy2 = ArrayGet(tab, Add(ob, 5))
        rmaj2 = ArrayGet(tab, Add(ob, 2))
        rh2 = ArrayGet(tab, Add(ob, 3))
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(merb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(face, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(faceb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(corner, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(sh, 0), 1) ThenBlock: { ReturnValue(0) }
        ta = CAD_Store.Read(mer, 0)
        tb = CAD_Store.Read(mer, 1)
        IfCondition EqualTo(ta, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tb, 0) ThenBlock: { ReturnValue(0) }
        za = CAD_Store.Read(ta, 2)
        zb = CAD_Store.Read(tb, 2)
        sv = ta
        gv = tb
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(za, zb)), 1) ThenBlock: {
            sv = tb
            gv = ta
        }
        ua = CAD_Store.Read(merb, 0)
        ub = CAD_Store.Read(merb, 1)
        IfCondition EqualTo(ua, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ub, 0) ThenBlock: { ReturnValue(0) }
        za2 = CAD_Store.Read(ua, 2)
        zb2 = CAD_Store.Read(ub, 2)
        svb = ua
        gvb = ub
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(za2, zb2)), 1) ThenBlock: {
            svb = ub
            gvb = ua
        }
        same = CAD_Topo.VertSamePos(sv, svb)
        IfCondition EqualTo(same, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc6 seam fail pinch\n")
            ReturnValue(0)
        }
        vx = CAD_Store.Read(corner, 0)
        vy = CAD_Store.Read(corner, 1)
        vz = Float_Add(cz, sh)
        buf = Allocate(32)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(buf, 0, vx)
        ArraySet(buf, 1, vy)
        ArraySet(buf, 2, vz)
        sn = CAD_Topo.MakeVertex(buf)
        Deallocate(buf, 32)
        IfCondition EqualTo(sn, 0) ThenBlock: { ReturnValue(0) }
        ch = CAD_Store.Alloc(16, 16)
        IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(ch, 0, 6)
        CAD_Store.Write(ch, 1, cx)
        CAD_Store.Write(ch, 2, cy)
        CAD_Store.Write(ch, 3, vz)
        CAD_Store.Write(ch, 4, rmaj)
        CAD_Store.Write(ch, 5, rh)
        CAD_Store.Write(ch, 6, cx2)
        CAD_Store.Write(ch, 7, cy2)
        CAD_Store.Write(ch, 8, rmaj2)
        CAD_Store.Write(ch, 9, rh2)
        CAD_Store.Write(ch, 10, radius_r)
        CAD_Store.Write(ch, 11, vx)
        CAD_Store.Write(ch, 12, vy)
        ed = CAD_Topo.MakeEdge(sv, sn, ch)
        IfCondition EqualTo(ed, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FilletDumpU("fillet arc6 sn ", 15, vx)
        CAD_Topo.FilletDumpU(" ", 1, vy)
        CAD_Topo.FilletDumpU(" ", 1, vz)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        CAD_Topo_FSeq.h = solid_h
        CAD_Topo.FilletRailsMeetLineTo(gv, sn)
        CAD_Topo.FilletRailsMeetLineTo(gvb, sn)
        CAD_Topo.FilletPlexRetargetCircles(gv, sn)
        CAD_Topo.FilletPlexRetargetCircles(gvb, sn)
        IfCondition NotEqual(svb, sv) ThenBlock: {
            CAD_Topo.FilletPlexRetargetCircles(svb, sv)
            CAD_Topo_FSeq.h = solid_h
            CAD_Topo.FilletRailsMeetLineTo(svb, sv)
        }
        CAD_Topo_FVert.px = CAD_Store.Read(sv, 0)
        CAD_Topo_FVert.py = CAD_Store.Read(sv, 1)
        CAD_Topo_FVert.pz = CAD_Store.Read(sv, 2)
        CAD_Topo_FLoc.v0 = sv
        CAD_Topo_FLoc.sn = sn
        CAD_Topo_FSeq.h = solid_h
        CAD_Topo.FilletRailsMeetPin()
        CAD_Topo.FilletPlexArcSharpDropCorner(solid_h, corner, sn)
        ce0 = CAD_Topo.FindCoedgeOnFace(face, mer)
        ce1 = CAD_Topo.FindCoedgeOnFace(faceb, merb)
        IfCondition EqualTo(ce0, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc6 seam fail ce\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(ce1, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc6 seam fail ce\n")
            ReturnValue(0)
        }
        nce = CAD_Topo.FilletPlexArcSharpSwap(ce0, ed, sv, sn)
        IfCondition EqualTo(nce, 0) ThenBlock: { ReturnValue(0) }
        nce = CAD_Topo.FilletPlexArcSharpSwap(ce1, ed, sv, sn)
        IfCondition EqualTo(nce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FilletDumpLine("fillet arc6 seam ok\n")
        ReturnValue(1)
    }
}

// 2 = not this pattern. 0 = matched miss (no IR write). 1 = table filled.
Function.CAD_Topo.FilletPlexArcSharpScan {
    Input: solid_h: Integer
    Output: Integer
    Body: {
        n = CAD_Topo_FComp.n
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(2) }
        n_circ = 0
        n_line = 0
        n_other = 0
        i = 0
        WhileLoop LessThan(i, n) {
            eh = CAD_Topo.FilletIRGet(i, 0)
            IfCondition NotEqual(eh, 0) ThenBlock: {
                knd = CAD_Topo.FilletIRGet(i, 1)
                IfCondition EqualTo(knd, 2) ThenBlock: { n_circ = Add(n_circ, 1) }
                IfCondition EqualTo(knd, 1) ThenBlock: { n_line = Add(n_line, 1) }
                IfCondition NotEqual(knd, 1) ThenBlock: {
                    IfCondition NotEqual(knd, 2) ThenBlock: { n_other = Add(n_other, 1) }
                }
            }
            i = Add(i, 1)
        }
        IfCondition NotEqual(n_other, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(n_circ, 0) ThenBlock: { ReturnValue(2) }
        IfCondition GreaterThan(n_circ, 8) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(n_circ, 1) ThenBlock: {
            IfCondition LessThan(n_line, 1) ThenBlock: { ReturnValue(2) }
        }
        CAD_Topo_FPlex.arc4n = 0
        IfCondition EqualTo(CAD_Topo_FPlex.arc4c, 0) ThenBlock: {
            CAD_Topo_FPlex.arc4c = Allocate(2048)
        }
        IfCondition EqualTo(CAD_Topo_FPlex.arc4c, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.arc4b, 0) ThenBlock: {
            CAD_Topo_FPlex.arc4b = Allocate(256)
        }
        IfCondition EqualTo(CAD_Topo_FPlex.arc4b, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            eh = CAD_Topo.FilletIRGet(i, 0)
            IfCondition NotEqual(eh, 0) ThenBlock: {
                knd = CAD_Topo.FilletIRGet(i, 1)
                IfCondition EqualTo(knd, 2) ThenBlock: {
                    st = CAD_Topo.FilletPlexArcSharpNote(i)
                    IfCondition NotEqual(st, 1) ThenBlock: { ReturnValue(st) }
                }
            }
            i = Add(i, 1)
        }
        st = CAD_Topo.FilletPlexArcSharpBind(solid_h)
        IfCondition NotEqual(st, 1) ThenBlock: { ReturnValue(st) }
        CAD_Topo.FilletDumpI("fillet arc4 n=", 14, CAD_Topo_FPlex.arc4n)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        CAD_Topo.FilletDumpLine("fillet arc4 take\n")
        ReturnValue(1)
    }
}

// -1 not this pattern (caller emit-chains or rim-fillets).
// 0 matched failure, circle IR restored. Otherwise the solid.
Function.CAD_Topo.FilletPlexArcSharp {
    Input: solid_h: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        CAD_Topo_FPlex.arc4 = 0
        st = CAD_Topo.FilletPlexArcSharpScan(solid_h)
        IfCondition EqualTo(st, 2) ThenBlock: {
            miss = Subtract(0, 1)
            ReturnValue(miss)
        }
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(0) }
        lines = Allocate(128)
        IfCondition EqualTo(lines, 0) ThenBlock: { ReturnValue(0) }
        k = 0
        n = CAD_Topo_FComp.n
        i = 0
        WhileLoop LessThan(i, n) {
            eh = CAD_Topo.FilletIRGet(i, 0)
            IfCondition NotEqual(eh, 0) ThenBlock: {
                knd = CAD_Topo.FilletIRGet(i, 1)
                IfCondition EqualTo(knd, 1) ThenBlock: {
                    IfCondition GreaterThan(k, 15) ThenBlock: { ReturnValue(0) }
                    ArraySet(lines, k, eh)
                    k = Add(k, 1)
                }
            }
            i = Add(i, 1)
        }
        nc = CAD_Topo_FPlex.arc4n
        IfCondition LessThan(k, 1) ThenBlock: {
            IfCondition LessThan(nc, 2) ThenBlock: { ReturnValue(0) }
        }
        solid = solid_h
        IfCondition GreaterThan(k, 0) ThenBlock: {
            CAD_Topo.FilletPlexArcSharpZero()
            CAD_Topo_FPlex.arc4 = 1
            seq = CAD_Topo.FilletEdgesSequential(solid_h, lines, k, radius_r)
            CAD_Topo.FilletPlexArcSharpRestore()
            IfCondition EqualTo(seq, 0) ThenBlock: {
                CAD_Topo_FPlex.arc4 = 0
                ReturnValue(0)
            }
            solid = seq
        }
        IfCondition EqualTo(k, 0) ThenBlock: { CAD_Topo_FPlex.arc4 = 1 }
        ci = 0
        WhileLoop LessThan(ci, nc) {
            CAD_Topo.FilletPlexArcSharpLoad(ci)
            t0 = CAD_Topo.FilletPlexArcSharpEndTrim(ci, 0)
            t1 = CAD_Topo.FilletPlexArcSharpEndTrim(ci, 1)
            IfCondition EqualTo(t0, 0) ThenBlock: {
                CAD_Topo.FilletDumpLine("fillet arc4 trim miss\n")
                CAD_Topo_FPlex.arc4 = 0
                ReturnValue(0)
            }
            IfCondition EqualTo(t1, 0) ThenBlock: {
                CAD_Topo.FilletDumpLine("fillet arc4 trim miss\n")
                CAD_Topo_FPlex.arc4 = 0
                ReturnValue(0)
            }
            bp = CAD_Topo_FPlex.arc4b
            ArraySet(bp, 19, t0)
            ArraySet(bp, 20, t1)
            tx = CAD_Store.Read(t0, 0)
            ty = CAD_Store.Read(t0, 1)
            tz = CAD_Store.Read(t0, 2)
            CAD_Topo.FilletDumpU("fillet arc4 trim0 ", 18, tx)
            CAD_Topo.FilletDumpU(" ", 1, ty)
            CAD_Topo.FilletDumpU(" ", 1, tz)
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            tx = CAD_Store.Read(t1, 0)
            ty = CAD_Store.Read(t1, 1)
            tz = CAD_Store.Read(t1, 2)
            CAD_Topo.FilletDumpU("fillet arc4 trim1 ", 18, tx)
            CAD_Topo.FilletDumpU(" ", 1, ty)
            CAD_Topo.FilletDumpU(" ", 1, tz)
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            tab = CAD_Topo_FPlex.arc4c
            eh = ArrayGet(tab, Multiply(ci, 24))
            em = CAD_Topo.FilletEmitPlaneCyl(solid, eh, radius_r)
            IfCondition EqualTo(em, 0) ThenBlock: {
                CAD_Topo_FPlex.arc4 = 0
                ReturnValue(0)
            }
            solid = em
            CAD_Topo.FilletPlexArcSharpSave(ci)
            ci = Add(ci, 1)
        }
        ci = 0
        WhileLoop LessThan(ci, nc) {
            CAD_Topo.FilletPlexArcSharpLoad(ci)
            tab = CAD_Topo_FPlex.arc4c
            b = Multiply(ci, 24)
            k0 = ArrayGet(tab, Add(b, 9))
            k1 = ArrayGet(tab, Add(b, 12))
            IfCondition EqualTo(k0, 1) ThenBlock: {
                s0 = CAD_Topo.FilletPlexArcSharpSeam(solid, 0, radius_r)
                IfCondition EqualTo(s0, 0) ThenBlock: {
                    CAD_Topo_FPlex.arc4 = 0
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(k0, 2) ThenBlock: {
                s0 = CAD_Topo.FilletPlexArcArcSeam(solid, ci, 0, radius_r)
                IfCondition EqualTo(s0, 0) ThenBlock: {
                    CAD_Topo_FPlex.arc4 = 0
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(k1, 1) ThenBlock: {
                s1 = CAD_Topo.FilletPlexArcSharpSeam(solid, 1, radius_r)
                IfCondition EqualTo(s1, 0) ThenBlock: {
                    CAD_Topo_FPlex.arc4 = 0
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(k1, 2) ThenBlock: {
                s1 = CAD_Topo.FilletPlexArcArcSeam(solid, ci, 1, radius_r)
                IfCondition EqualTo(s1, 0) ThenBlock: {
                    CAD_Topo_FPlex.arc4 = 0
                    ReturnValue(0)
                }
            }
            ci = Add(ci, 1)
        }
        CAD_Topo_FPlex.arc4 = 0
        CAD_Topo.FilletDumpLine("fillet arc4 ok\n")
        ReturnValue(solid)
    }
}

// ----------------------------------------------------------------------------
// MAIN PLEX SOLVE ENTRY POINT
// ----------------------------------------------------------------------------

Function.CAD_Topo.FilletPlexSolve {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }

        // Previous fillet's corner counts stay in FVert. The next pad
        // often reuses the same coordinates. EdgeLocal treats count>1
        // as "another selected edge meets here" and skips the end
        // meridian, so a single edge no longer meets the side face.
        // Sequential notes again after its own reset.
        CAD_Topo.FilletVertReset()

        // Step 1: Build Plex rings from compiled IR
        PrintMessage("plex solve enter n=")
        PrintNumber(n_edges)
        PrintMessage("\n")
        IfCondition EqualTo(CAD_Topo.FilletPlexBuild(solid_handle, edges_addr, n_edges, radius_r), 0) ThenBlock: {
            PrintMessage("fillet plex build failed\n")
            ReturnValue(0)
        }
        PrintMessage("plex solve built\n")

        // Step 2: Classify junctions using local ring queries
        CAD_Topo.FilletPlexClassifyJunction()
        PrintMessage("plex solve classified\n")

        // Step 3: Walk Ring 0 to split into contiguous solver segments
        CAD_Topo.FilletPlexSegmentWalk()
        PrintMessage("plex solve walked\n")

        // Step 4: Dispatch. All-LINE rings are meth=1: FilletEdgesSequential
        // → FilletEdgeLocal. EdgeLocal calls JuncAt per end (not slot 7)
        // and ShortenRailEnd at junc=5. Case 10 is never assigned.
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("plex emit n=", 11, CAD_Topo_FPlex.count)
        CAD_Topo.FilletDumpS(" seq EdgeLocal, skip cyl both\n", 30)
        CAD_Topo_State.fillet_class = 99
        ReturnValue(CAD_Topo.FilletPlexDispatchSegment())
    }
}
