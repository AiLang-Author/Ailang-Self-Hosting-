// CAD.Topo.FilletPlex — Multi-ring Plex graph classification, pathing, and segment dispatch.
// Local ring queries string N junction types on one loop (cope / sphere / tangent).
// Coplanar is a vertex fact (two LINEs vs XYZ join), not a batch recipe.
// Part of CAD.Topo facade (LibraryImport.Cad.CAD_Topo).
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Plex
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Err
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Blend
LibraryImport.Cad.Topo.FilletPlexNotch
LibraryImport.Cad.Topo.FilletPlexArc
LibraryImport.Cad.Topo.FilletPlexJunc
LibraryImport.Cad.Topo.FilletPlexWalk

FixedPool.CAD_Topo_FPlex {
    "count":     Initialize=0, CanChange=True
    "head":      Initialize=0, CanChange=True
    "solid":     Initialize=0, CanChange=True
    "r":         Initialize=0, CanChange=True
    "seg_count": Initialize=0, CanChange=True
    "nodes":     Initialize=0, CanChange=True
    "segs":      Initialize=0, CanChange=True
    "vert_buf":  Initialize=0, CanChange=True
    "init":      Initialize=0, CanChange=True
    "mer0":      Initialize=0, CanChange=True
    "mer1":      Initialize=0, CanChange=True
    "mer0n":     Initialize=0, CanChange=True
    "mer1n":     Initialize=0, CanChange=True
    "th0":       Initialize=0, CanChange=True
    "th1":       Initialize=0, CanChange=True
    "j5":        Initialize=0, CanChange=True
    "j5n":       Initialize=0, CanChange=True
    "j5host":    Initialize=0, CanChange=True
    "arc4":      Initialize=0, CanChange=True
    "arc4b":     Initialize=0, CanChange=True
    "arc4c":     Initialize=0, CanChange=True
    "arc4n":     Initialize=0, CanChange=True
}

// Data Slot Constants for Plex Nodes (0..15)
// Slot 0: Edge handle
// Slot 1: Face A
// Slot 2: Face B
// Slot 3: Start vertex (v0)
// Slot 4: End vertex (v1)
// Slot 5: Curve kind / pair type
// Slot 6: Assigned Solve Method
// Slot 7: Junction at v0 (1=cope 2=tangent 4=sphere 5=rail-arc)
// Slot 8: Segment ID
// Slot 9: Fillet IR Index
// Slot 10: blocking cyl face at v0 (junc 5)
// Slot 11: blocking cyl face at v1 (junc 5)
// Slot 12: Junction at v1 (same enum as slot 7 — per VERTEX, not per edge)
//
// junc 5 = SHARP_RAIL_ARC: one selected LINE at V, incident
// cylindrical face. Not a cope (nsel=1 — same as filleting one
// box edge). Plex tags it (slots 7/12, blockers 10/11). EdgeLocal
// does not read those slots — junction API is FilletPlexJuncAt
// per end. FilletPlexJunc5EmitEnd / RailArcShift / FilletPlexJunc5*
// have zero product-path call sites. Method 10 is defined and
// never assigned. Same function left and right.
//
// Solve Method Enum:
// 1 = SEQUENTIAL (FilletEdgesSequential)
// 2 = EMIT_CHAIN (FilletEmitChain)
// 3 = CORNER_3E (FilletJoinFoot3)
// 4 = CYL_TOP_RIM (CAD_Blend.FilletCylTopRim)
// 5 = CYL_BOT_RIM (CAD_Blend.FilletCylBottomRim)
// 6 = PLANE_CYL (FilletEmitPlaneCyl / FilletPlaneCylJoin)
// 7 = DIGON (FilletPlaneEdgesDigon)
// 8 = COVE_CYCLE (FilletJoinCoveCycle)
// 9 = EDGE_LOCAL (FilletEdgeLocal)
// 10 = RAIL_ARC (same local emit; junc 5 is the vertex solve)

Function.CAD_Topo.FilletPlexInit {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FPlex.init, 0) ThenBlock: {
            Plex.Init()
            CAD_Topo_FPlex.nodes = Allocate(256)
            CAD_Topo_FPlex.segs = Allocate(512)
            CAD_Topo_FPlex.vert_buf = Allocate(256)
            CAD_Topo_FPlex.init = 1
        }
        IfCondition EqualTo(CAD_Topo_FPlex.mer0, 0) ThenBlock: { CAD_Topo_FPlex.mer0 = Allocate(16) }
        IfCondition EqualTo(CAD_Topo_FPlex.mer1, 0) ThenBlock: { CAD_Topo_FPlex.mer1 = Allocate(16) }
        IfCondition EqualTo(CAD_Topo_FPlex.j5, 0) ThenBlock: { CAD_Topo_FPlex.j5 = Allocate(512) }
        CAD_Topo_FPlex.th0 = 0
        CAD_Topo_FPlex.th1 = 0
        CAD_Topo_FPlex.j5n = 0
        CAD_Topo_FPlex.j5host = 0
        CAD_Topo_FPlex.arc4 = 0
        CAD_Topo_FPlex.arc4n = 0
        CAD_Topo_FPlex.count = 0
        CAD_Topo_FPlex.head = 0
        CAD_Topo_FPlex.seg_count = 0
        ReturnValue(1)
    }
}

// ----------------------------------------------------------------------------
// BUILD: Construct Plex Ring 0 (Coedge Chain) & Ring 1 (Vertex Stars)
// ----------------------------------------------------------------------------

Function.CAD_Topo.FilletPlexBuild {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        CAD_Topo.FilletPlexInit()
        CAD_Topo_FPlex.solid = solid_handle
        CAD_Topo_FPlex.r = radius_r
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }

        i = 0
        prev_node = 0
        WhileLoop LessThan(i, CAD_Topo_FComp.n) {
            edge_h = CAD_Topo.FilletIRGet(i, 0)
            pair_t = CAD_Topo.FilletIRGet(i, 11)
            f1 = CAD_Topo.FilletIRGet(i, 4)
            f2 = CAD_Topo.FilletIRGet(i, 5)
            v0 = CAD_Store.Read(edge_h, 0)
            v1 = CAD_Store.Read(edge_h, 1)

            // Curve kind: 1=LINE, 2=ARC/CIRCLE
            ckind = 1
            IfCondition NotEqual(pair_t, 0) ThenBlock: { ckind = 2 }

            nd = Plex.Alloc(ckind)
            IfCondition EqualTo(nd, 0) ThenBlock: { ReturnValue(0) }

            Plex.Set(nd, 0, edge_h)
            Plex.Set(nd, 1, f1)
            Plex.Set(nd, 2, f2)
            Plex.Set(nd, 3, v0)
            Plex.Set(nd, 4, v1)
            Plex.Set(nd, 5, pair_t)
            Plex.Set(nd, 6, 0) // Solve method TBD
            Plex.Set(nd, 7, 0) // Flags TBD
            Plex.Set(nd, 9, i)

            ArraySet(CAD_Topo_FPlex.nodes, i, nd)
            Plex.RingSingleton(nd, 0)
            Plex.RingSingleton(nd, 1)

            IfCondition EqualTo(i, 0) ThenBlock: {
                CAD_Topo_FPlex.head = nd
            } ElseBlock: {
                Plex.RingInsertAfter(prev_node, nd, 0)
            }
            prev_node = nd
            i = Add(i, 1)
        }

        CAD_Topo_FPlex.count = CAD_Topo_FComp.n

        // Build Ring 1: Vertex Star Rings (edges sharing a vertex)
        i = 0
        WhileLoop LessThan(i, CAD_Topo_FPlex.count) {
            nd_i = ArrayGet(CAD_Topo_FPlex.nodes, i)
            v0_i = Plex.Get(nd_i, 3)
            v1_i = Plex.Get(nd_i, 4)

            j = Add(i, 1)
            WhileLoop LessThan(j, CAD_Topo_FPlex.count) {
                nd_j = ArrayGet(CAD_Topo_FPlex.nodes, j)
                v0_j = Plex.Get(nd_j, 3)
                v1_j = Plex.Get(nd_j, 4)

                shares_v = 0
                IfCondition EqualTo(v0_i, v0_j) ThenBlock: { shares_v = 1 }
                IfCondition EqualTo(v0_i, v1_j) ThenBlock: { shares_v = 1 }
                IfCondition EqualTo(v1_i, v0_j) ThenBlock: { shares_v = 1 }
                IfCondition EqualTo(v1_i, v1_j) ThenBlock: { shares_v = 1 }

                IfCondition EqualTo(shares_v, 1) ThenBlock: {
                    Plex.RingInsertAfter(nd_i, nd_j, 1)
                }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }

        ReturnValue(CAD_Topo_FPlex.count)
    }
}

Function.CAD_Topo.FilletPlexGetNode {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FPlex.head, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LessThan(idx, CAD_Topo_FPlex.count), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(ArrayGet(CAD_Topo_FPlex.nodes, idx))
    }
}

// pair=1 wall at this rim: fillet along +N2 (1) vs toward-center OD (2).
// Local fact: N2 = V−C vs host-coedge left (N_host × D). Interior is left
// of a CCW loop with outward N. N2 into the face → fillet (r+R). N2 off
// the face → OD (r−R). Not inner=0, not center-in-face.
Function.CAD_Topo.FilletPlexIdentifyPair1 {
    Input: idx: Integer
    Output: Integer
    Body: {
        host = CAD_Topo.FilletIRGet(idx, 19)
        e = CAD_Topo.FilletIRGet(idx, 0)
        IfCondition EqualTo(host, 0) ThenBlock: { ReturnValue(CAD_Topo.FilletIRGet(idx, 21)) }
        IfCondition EqualTo(e, 0) ThenBlock: { ReturnValue(CAD_Topo.FilletIRGet(idx, 21)) }
        v0 = CAD_Store.Read(e, 0)
        v1 = CAD_Store.Read(e, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(CAD_Topo.FilletIRGet(idx, 21)) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(CAD_Topo.FilletIRGet(idx, 21)) }
        ce = CAD_Topo.FindCoedgeOnFace(host, e)
        IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(CAD_Topo.FilletIRGet(idx, 21)) }
        org = CAD_Store.Read(ce, 5)
        dx = Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0))
        dy = Float_Sub(CAD_Store.Read(v1, 1), CAD_Store.Read(v0, 1))
        dz = Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2))
        IfCondition NotEqual(org, v0) ThenBlock: {
            dx = Float_Sub(0, dx)
            dy = Float_Sub(0, dy)
            dz = Float_Sub(0, dz)
        }
        // Closed CIRCLE: v0==v1 so D=0 and pair always 1 (brim). Tangent = N×(P−C).
        aa = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
        IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 1) ThenBlock: {
            crv = CAD_Store.Read(e, 2)
            IfCondition NotEqual(crv, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                    rx = Float_Sub(CAD_Store.Read(v0, 0), CAD_Store.Read(crv, 1))
                    ry = Float_Sub(CAD_Store.Read(v0, 1), CAD_Store.Read(crv, 2))
                    rz = Float_Sub(CAD_Store.Read(v0, 2), CAD_Store.Read(crv, 3))
                    Xx = CAD_Store.Read(crv, 4)
                    Xy = CAD_Store.Read(crv, 5)
                    Xz = CAD_Store.Read(crv, 6)
                    Yx = CAD_Store.Read(crv, 7)
                    Yy = CAD_Store.Read(crv, 8)
                    Yz = CAD_Store.Read(crv, 9)
                    nx = Float_Sub(Float_Mul(Xy, Yz), Float_Mul(Xz, Yy))
                    ny = Float_Sub(Float_Mul(Xz, Yx), Float_Mul(Xx, Yz))
                    nz = Float_Sub(Float_Mul(Xx, Yy), Float_Mul(Xy, Yx))
                    dx = Float_Sub(Float_Mul(ny, rz), Float_Mul(nz, ry))
                    dy = Float_Sub(Float_Mul(nz, rx), Float_Mul(nx, rz))
                    dz = Float_Sub(Float_Mul(nx, ry), Float_Mul(ny, rx))
                    sp = CAD_Store.Read(crv, 12)
                    IfCondition EqualTo(CAD_Num.IsNeg(sp), 1) ThenBlock: {
                        dx = Float_Sub(0, dx)
                        dy = Float_Sub(0, dy)
                        dz = Float_Sub(0, dz)
                    }
                }
            }
        }
        n1x = CAD_Topo.FilletIRSolGet(idx, 6)
        n1y = CAD_Topo.FilletIRSolGet(idx, 7)
        n1z = CAD_Topo.FilletIRSolGet(idx, 8)
        n2x = CAD_Topo.FilletIRSolGet(idx, 9)
        n2y = CAD_Topo.FilletIRSolGet(idx, 10)
        n2z = CAD_Topo.FilletIRSolGet(idx, 11)
        lx = Float_Sub(Float_Mul(n1y, dz), Float_Mul(n1z, dy))
        ly = Float_Sub(Float_Mul(n1z, dx), Float_Mul(n1x, dz))
        lz = Float_Sub(Float_Mul(n1x, dy), Float_Mul(n1y, dx))
        dot = Float_Add(Float_Add(Float_Mul(n2x, lx), Float_Mul(n2y, ly)), Float_Mul(n2z, lz))
        IfCondition EqualTo(CAD_Num.IsNeg(dot), 1) ThenBlock: {
            ReturnValue(2)
        }
        ReturnValue(1)
    }
}

// Incident face at vh other than skip1/skip2. Any surface kind (plane or
// cylinder). FindFaceWithVert drops non-planes; open rails vs a curve need this.
Function.CAD_Topo.FilletPlexBlockingFace {
    Input: solid_h: Integer
    Input: vert_h: Integer
    Input: skip1: Integer
    Input: skip2: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCE.solid = solid_h
        CAD_Topo_FCE.vert = vert_h
        CAD_Topo_FCE.skip1 = skip1
        CAD_Topo_FCE.skip2 = skip2
        CAD_Topo_FCE.sh = CAD_Store.Read(solid_h, 0)
        CAD_Topo_FCE.sg = 0
        WhileLoop NotEqual(CAD_Topo_FCE.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FCE.sg, 64) ThenBlock: { CAD_Topo_FCE.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FCE.sh, 0) ThenBlock: {
                CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.sh, 0)
                CAD_Topo_FCE.fg = 0
                WhileLoop NotEqual(CAD_Topo_FCE.face, 0) {
                    IfCondition GreaterThan(CAD_Topo_FCE.fg, 4096) ThenBlock: { CAD_Topo_FCE.face = 0 }
                    IfCondition NotEqual(CAD_Topo_FCE.face, 0) ThenBlock: {
                        CAD_Topo_FCE.hd = 1
                        IfCondition EqualTo(CAD_Topo_FCE.face, CAD_Topo_FCE.skip1) ThenBlock: { CAD_Topo_FCE.hd = 0 }
                        IfCondition EqualTo(CAD_Topo_FCE.face, CAD_Topo_FCE.skip2) ThenBlock: { CAD_Topo_FCE.hd = 0 }
                        IfCondition EqualTo(CAD_Topo_FCE.hd, 1) ThenBlock: {
                            CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.face, 1)
                            CAD_Topo_FCE.ok = 0
                            IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                CAD_Topo_FCE.ce = CAD_Store.Read(CAD_Topo_FCE.lp, 0)
                                CAD_Topo_FCE.hd = CAD_Topo_FCE.ce
                                CAD_Topo_FCE.g = 0
                                WhileLoop LessThan(CAD_Topo_FCE.g, 2048) {
                                    IfCondition EqualTo(CAD_Topo_FCE.ce, 0) ThenBlock: { CAD_Topo_FCE.g = 2048 }
                                    IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.ce, 5), CAD_Topo_FCE.vert) ThenBlock: {
                                            // Cylindrical blocker only. Planar ends
                                            // stay on FindFaceWithVert.
                                            CAD_Topo_FCE.ok = CAD_Store.Read(CAD_Topo_FCE.face, 0)
                                            IfCondition NotEqual(CAD_Topo_FCE.ok, 0) ThenBlock: {
                                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.ok, 0), 2) ThenBlock: {
                                                    ReturnValue(CAD_Topo_FCE.face)
                                                }
                                            }
                                        }
                                        CAD_Topo_FCE.ce = CAD_Store.Read(CAD_Topo_FCE.ce, 2)
                                        IfCondition EqualTo(CAD_Topo_FCE.ce, CAD_Topo_FCE.hd) ThenBlock: { CAD_Topo_FCE.g = 2048 }
                                    }
                                    CAD_Topo_FCE.g = Add(CAD_Topo_FCE.g, 1)
                                }
                            }
                        }
                        CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.face, 3)
                    }
                    CAD_Topo_FCE.fg = Add(CAD_Topo_FCE.fg, 1)
                }
                CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FCE.sh, 2)
            }
            CAD_Topo_FCE.sg = Add(CAD_Topo_FCE.sg, 1)
        }
        ReturnValue(0)
    }
}

// Blocking cyl face at an open LINE end, or 0. Caller tags junc 5
// and stores the face in plex slots 10/11.
Function.CAD_Topo.FilletPlexIdentifyRailArc {
    Input: vert_h: Integer
    Input: skip1: Integer
    Input: skip2: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FilletIRCountAt(vert_h), 1) ThenBlock: { ReturnValue(0) }
        blk = CAD_Topo.FilletPlexBlockingFace(CAD_Topo_FPlex.solid, vert_h, skip1, skip2)
        IfCondition EqualTo(blk, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(blk)
    }
}

// Move vert along the rail (FLoc.edx) onto the Z-cylinder of face_h.
// Independent of the Th shift — Tw has its own hit.
Function.CAD_Topo.FilletPlexCylClipVert {
    Input: vert_h: Integer
    Input: face_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(1) }
        surf = CAD_Store.Read(face_h, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: { ReturnValue(1) }
        tx = CAD_Store.Read(vert_h, 0)
        ty = CAD_Store.Read(vert_h, 1)
        tz = CAD_Store.Read(vert_h, 2)
        ocx = CAD_Store.Read(surf, 1)
        ocy = CAD_Store.Read(surf, 2)
        rr = CAD_Store.Read(surf, 13)
        dx = CAD_Topo_FLoc.edx
        dy = CAD_Topo_FLoc.edy
        aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 1) ThenBlock: { ReturnValue(1) }
        nx = Float_Sub(tx, ocx)
        ny = Float_Sub(ty, ocy)
        bb = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(nx, dx), Float_Mul(ny, dy)))
        cc = Float_Sub(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(rr, rr))
        disc = Float_Sub(Float_Mul(bb, bb), Float_Mul(0x4010000000000000, Float_Mul(aa, cc)))
        IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: { ReturnValue(1) }
        disc = CAD_Num.Sqrt(disc)
        s0 = Float_Div(Float_Sub(Float_Sub(0, bb), disc), Float_Mul(0x4000000000000000, aa))
        s1 = Float_Div(Float_Add(Float_Sub(0, bb), disc), Float_Mul(0x4000000000000000, aa))
        as0 = s0
        IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
        as1 = s1
        IfCondition EqualTo(CAD_Num.IsNeg(as1), 1) ThenBlock: { as1 = Float_Sub(0, as1) }
        s = s0
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as1, as0)), 1) ThenBlock: { s = s1 }
        as0 = s
        IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
        IfCondition EqualTo(CAD_Num.IsZero(s, 0), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as0, 0x412E848000000000)), 0) ThenBlock: { ReturnValue(1) }
        CAD_Store.Write(vert_h, 0, Float_Add(tx, Float_Mul(s, CAD_Topo_FLoc.edx)))
        CAD_Store.Write(vert_h, 1, Float_Add(ty, Float_Mul(s, CAD_Topo_FLoc.edy)))
        CAD_Store.Write(vert_h, 2, Float_Add(tz, Float_Mul(s, CAD_Topo_FLoc.edz)))
        PrintMessage("fillet plex cyl-clip s_um=")
        PrintNumber(Float_ToInt(s))
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Hit P + s*rail against Z-cylinder (Oxy, R). Smaller |s|.
// Writes the hit to FLoc.pt and s to FLoc.ab. 1 ok.
Function.CAD_Topo.FilletPlexHitZCyl {
    Input: ocx: Integer
    Input: ocy: Integer
    Input: rr: Integer
    Input: px: Integer
    Input: py: Integer
    Input: pz: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: { ReturnValue(0) }
        dx = CAD_Topo_FLoc.edx
        dy = CAD_Topo_FLoc.edy
        aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 1) ThenBlock: { ReturnValue(0) }
        nx = Float_Sub(px, ocx)
        ny = Float_Sub(py, ocy)
        bb = Float_Mul(0x4000000000000000, Float_Add(Float_Mul(nx, dx), Float_Mul(ny, dy)))
        cc = Float_Sub(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(rr, rr))
        disc = Float_Sub(Float_Mul(bb, bb), Float_Mul(0x4010000000000000, Float_Mul(aa, cc)))
        IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: { ReturnValue(0) }
        disc = CAD_Num.Sqrt(disc)
        s0 = Float_Div(Float_Sub(Float_Sub(0, bb), disc), Float_Mul(0x4000000000000000, aa))
        s1 = Float_Div(Float_Add(Float_Sub(0, bb), disc), Float_Mul(0x4000000000000000, aa))
        as0 = s0
        IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
        as1 = s1
        IfCondition EqualTo(CAD_Num.IsNeg(as1), 1) ThenBlock: { as1 = Float_Sub(0, as1) }
        s = s0
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as1, as0)), 1) ThenBlock: { s = s1 }
        as0 = s
        IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as0, 0x412E848000000000)), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.ab = s
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Add(px, Float_Mul(s, CAD_Topo_FLoc.edx)))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Add(py, Float_Mul(s, CAD_Topo_FLoc.edy)))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Add(pz, Float_Mul(s, CAD_Topo_FLoc.edz)))
        ReturnValue(1)
    }
}

// Emit-time junc=5: translate that end's C along the rail onto the
// blocker. Contacts are then created by EdgeLocal MakeVertex from C'.
// Must not write FLoc.which. HitZCyl clobbers FLoc.ab / FLoc.pt (safe
// after ln is set, before MakeVertex). 0 miss / 1 ok or no-op.
Function.CAD_Topo.FilletPlexShortenRailEnd {
    Input: which_end: Integer
    Output: Integer
    Body: {
        vv = CAD_Topo_FLoc.v0
        cx = CAD_Topo_FLoc.c0x
        cy = CAD_Topo_FLoc.c0y
        cz = CAD_Topo_FLoc.c0z
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            vv = CAD_Topo_FLoc.v1
            cx = CAD_Topo_FLoc.c1x
            cy = CAD_Topo_FLoc.c1y
            cz = CAD_Topo_FLoc.c1z
        }
        IfCondition EqualTo(vv, 0) ThenBlock: { ReturnValue(1) }
        jn = CAD_Topo.FilletPlexJuncAt(vv, CAD_Topo_FLoc.f1, CAD_Topo_FLoc.f2)
        IfCondition NotEqual(jn, 5) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("shorten which=", 14, which_end)
        blk = 0
        ei = CAD_Topo.FilletIRIndexOf(CAD_Topo_FLoc.edge)
        IfCondition GreaterEqual(ei, 0) ThenBlock: {
            nd = CAD_Topo.FilletPlexGetNode(ei)
            IfCondition NotEqual(nd, 0) ThenBlock: {
                IfCondition EqualTo(which_end, 0) ThenBlock: { blk = Plex.Get(nd, 10) }
                IfCondition EqualTo(which_end, 1) ThenBlock: { blk = Plex.Get(nd, 11) }
            }
        }
        IfCondition EqualTo(blk, 0) ThenBlock: {
            blk = CAD_Topo.FilletPlexBlockingFace(CAD_Topo_FLoc.solid, vv, CAD_Topo_FLoc.f1, CAD_Topo_FLoc.f2)
        }
        CAD_Topo.FilletDumpI(" blk=", 5, blk)
        IfCondition EqualTo(blk, 0) ThenBlock: {
            CAD_Topo.FilletDumpS(" no blk\n", 8)
            ReturnValue(0)
        }
        surf = CAD_Store.Read(blk, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            CAD_Topo.FilletDumpS(" no surf\n", 9)
            ReturnValue(0)
        }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: {
            CAD_Topo.FilletDumpS(" not cyl\n", 9)
            ReturnValue(0)
        }
        zz = CAD_Store.Read(surf, 12)
        IfCondition EqualTo(CAD_Num.IsNeg(zz), 1) ThenBlock: { zz = Float_Sub(0, zz) }
        IfCondition EqualTo(CAD_Num.IsEqual(zz, 0x3FF0000000000000, 0), 0) ThenBlock: {
            CAD_Topo.FilletDumpS(" skip axis\n", 11)
            ReturnValue(0)
        }
        ocx = CAD_Store.Read(surf, 1)
        ocy = CAD_Store.Read(surf, 2)
        rr = CAD_Store.Read(surf, 13)
        af = CAD_Topo_FPlex.arc4
        IfCondition EqualTo(af, 1) ThenBlock: {
            rm = CAD_Topo.FilletPlexArcSharpRmaj(ocx, ocy)
            IfCondition EqualTo(CAD_Num.IsZero(rm, 0), 0) ThenBlock: { rr = rm }
            IfCondition EqualTo(CAD_Num.IsZero(rm, 0), 1) ThenBlock: {
                bp = CAD_Topo_FPlex.arc4b
                IfCondition NotEqual(bp, 0) ThenBlock: {
                    rm = ArrayGet(bp, 0)
                    IfCondition EqualTo(CAD_Num.IsZero(rm, 0), 0) ThenBlock: { rr = rm }
                }
            }
        }
        n1a = CAD_Topo_FLoc.n1z
        IfCondition EqualTo(CAD_Num.IsNeg(n1a), 1) ThenBlock: { n1a = Float_Sub(0, n1a) }
        n2a = CAD_Topo_FLoc.n2z
        IfCondition EqualTo(CAD_Num.IsNeg(n2a), 1) ThenBlock: { n2a = Float_Sub(0, n2a) }
        nx = CAD_Topo_FLoc.n1x
        ny = CAD_Topo_FLoc.n1y
        nz = CAD_Topo_FLoc.n1z
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(n1a, n2a)), 1) ThenBlock: {
            nx = CAD_Topo_FLoc.n2x
            ny = CAD_Topo_FLoc.n2y
            nz = CAD_Topo_FLoc.n2z
        }
        thx = Float_Add(cx, Float_Mul(CAD_Topo_FLoc.ln, nx))
        thy = Float_Add(cy, Float_Mul(CAD_Topo_FLoc.ln, ny))
        thz = Float_Add(cz, Float_Mul(CAD_Topo_FLoc.ln, nz))
        IfCondition EqualTo(CAD_Topo.FilletPlexHitZCyl(ocx, ocy, rr, thx, thy, thz), 0) ThenBlock: {
            CAD_Topo.FilletDumpS(" miss\n", 6)
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ab, 0), 1) ThenBlock: {
            CAD_Topo.FilletDumpS(" s0\n", 4)
            ReturnValue(0)
        }
        CAD_Topo.FilletDumpU(" s_um=", 6, CAD_Topo_FLoc.ab)
        IfCondition EqualTo(which_end, 0) ThenBlock: {
            CAD_Topo_FLoc.c0x = Float_Add(CAD_Topo_FLoc.c0x, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edx))
            CAD_Topo_FLoc.c0y = Float_Add(CAD_Topo_FLoc.c0y, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edy))
            CAD_Topo_FLoc.c0z = Float_Add(CAD_Topo_FLoc.c0z, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edz))
        }
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            CAD_Topo_FLoc.c1x = Float_Add(CAD_Topo_FLoc.c1x, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edx))
            CAD_Topo_FLoc.c1y = Float_Add(CAD_Topo_FLoc.c1y, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edy))
            CAD_Topo_FLoc.c1z = Float_Add(CAD_Topo_FLoc.c1z, Float_Mul(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.edz))
        }
        CAD_Topo.FilletDumpS(" ok\n", 4)
        ReturnValue(1)
    }
}

// Mer for junc=5: lathe the fillet quarter-circle onto the blocker.
// Native mer is C + r (cosθ N1 + sinθ N2) in a plane ⊥ rail. Each of
// those points, shot along the rail, hits the south cylinder. Those
// hits lie on both cylinders — the real end, not a 3-point circle.
// dest 0/1 selects mer0/mer1 edge list. Returns first LINE edge.
Function.CAD_Topo.FilletPlexCylMer {
    Input: th: Integer
    Input: tw: Integer
    Input: face_h: Integer
    Input: dest: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dest, 0) ThenBlock: { CAD_Topo_FPlex.mer0n = 0 }
        IfCondition NotEqual(dest, 0) ThenBlock: { CAD_Topo_FPlex.mer1n = 0 }
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.mer0, 0) ThenBlock: { CAD_Topo_FPlex.mer0 = Allocate(16) }
        IfCondition EqualTo(CAD_Topo_FPlex.mer1, 0) ThenBlock: { CAD_Topo_FPlex.mer1 = Allocate(16) }
        IfCondition EqualTo(CAD_Topo_FPlex.mer0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.mer1, 0) ThenBlock: { ReturnValue(0) }
        surf = CAD_Store.Read(face_h, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: { ReturnValue(0) }
        ocx = CAD_Store.Read(surf, 1)
        ocy = CAD_Store.Read(surf, 2)
        rr = CAD_Store.Read(surf, 13)
        cx = CAD_Topo_FLoc.c0x
        cy = CAD_Topo_FLoc.c0y
        cz = CAD_Topo_FLoc.c0z
        IfCondition EqualTo(th, CAD_Topo_FLoc.va1) ThenBlock: {
            cx = CAD_Topo_FLoc.c1x
            cy = CAD_Topo_FLoc.c1y
            cz = CAD_Topo_FLoc.c1z
        }
        IfCondition EqualTo(th, CAD_Topo_FLoc.vb1) ThenBlock: {
            cx = CAD_Topo_FLoc.c1x
            cy = CAD_Topo_FLoc.c1y
            cz = CAD_Topo_FLoc.c1z
        }
        // 5 samples, θ = 0 .. π/2. k=0 is Th, k=4 is Tw.
        ArraySet(CAD_Topo_FLoc.ring, 48, th)
        k = 1
        WhileLoop LessThan(k, 4) {
            da = Float_Mul(Float_FromInt(k), 0x3FD921FB54442D18)
            ax = Float_Add(Float_Mul(CAD_Geom.Cos(da), CAD_Topo_FLoc.n1x), Float_Mul(CAD_Geom.Sin(da), CAD_Topo_FLoc.n2x))
            ay = Float_Add(Float_Mul(CAD_Geom.Cos(da), CAD_Topo_FLoc.n1y), Float_Mul(CAD_Geom.Sin(da), CAD_Topo_FLoc.n2y))
            az = Float_Add(Float_Mul(CAD_Geom.Cos(da), CAD_Topo_FLoc.n1z), Float_Mul(CAD_Geom.Sin(da), CAD_Topo_FLoc.n2z))
            pmx = Float_Add(cx, Float_Mul(CAD_Topo_FLoc.r, ax))
            pmy = Float_Add(cy, Float_Mul(CAD_Topo_FLoc.r, ay))
            pmz = Float_Add(cz, Float_Mul(CAD_Topo_FLoc.r, az))
            IfCondition EqualTo(CAD_Topo.FilletPlexHitZCyl(ocx, ocy, rr, pmx, pmy, pmz), 0) ThenBlock: { ReturnValue(0) }
            ArraySet(CAD_Topo_FLoc.ring, Add(48, k), CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt))
            IfCondition EqualTo(ArrayGet(CAD_Topo_FLoc.ring, Add(48, k)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpI("cyl-mer lathe k=", 16, k)
            CAD_Topo.FilletDumpI(" ", 1, Float_ToInt(ArrayGet(CAD_Topo_FLoc.pt, 0)))
            CAD_Topo.FilletDumpI(",", 1, Float_ToInt(ArrayGet(CAD_Topo_FLoc.pt, 1)))
            CAD_Topo.FilletDumpI(",", 1, Float_ToInt(ArrayGet(CAD_Topo_FLoc.pt, 2)))
            CAD_Topo.FilletDumpI(" s=", 3, Float_ToInt(CAD_Topo_FLoc.ab))
            CAD_Topo.FilletDumpS("\n", 1)
            k = Add(k, 1)
        }
        // Snap Tw along the rail onto the blocker (same as Th, not a C shift).
        pmx = Float_Add(cx, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.n2x))
        pmy = Float_Add(cy, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.n2y))
        pmz = Float_Add(cz, Float_Mul(CAD_Topo_FLoc.r, CAD_Topo_FLoc.n2z))
        IfCondition EqualTo(CAD_Topo.FilletPlexHitZCyl(ocx, ocy, rr, pmx, pmy, pmz), 1) ThenBlock: {
            as0 = CAD_Topo_FLoc.ab
            IfCondition EqualTo(CAD_Num.IsNeg(as0), 1) ThenBlock: { as0 = Float_Sub(0, as0) }
            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(as0, Float_Mul(0x4010000000000000, CAD_Topo_FLoc.r))), 1) ThenBlock: {
                CAD_Store.Write(tw, 0, ArrayGet(CAD_Topo_FLoc.pt, 0))
                CAD_Store.Write(tw, 1, ArrayGet(CAD_Topo_FLoc.pt, 1))
                CAD_Store.Write(tw, 2, ArrayGet(CAD_Topo_FLoc.pt, 2))
            }
        }
        ArraySet(CAD_Topo_FLoc.ring, 52, tw)
        n = 0
        k = 0
        WhileLoop LessThan(k, 4) {
            ArraySet(CAD_Topo_FLoc.pt, 0, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(48, k)), 0))
            ArraySet(CAD_Topo_FLoc.pt, 1, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(48, k)), 1))
            ArraySet(CAD_Topo_FLoc.pt, 2, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(48, k)), 2))
            ArraySet(CAD_Topo_FLoc.p1b, 0, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(49, k)), 0))
            ArraySet(CAD_Topo_FLoc.p1b, 1, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(49, k)), 1))
            ArraySet(CAD_Topo_FLoc.p1b, 2, CAD_Store.Read(ArrayGet(CAD_Topo_FLoc.ring, Add(49, k)), 2))
            mer = CAD_Topo.MakeEdge(ArrayGet(CAD_Topo_FLoc.ring, Add(48, k)), ArrayGet(CAD_Topo_FLoc.ring, Add(49, k)), CAD_Geom.MakeLine(CAD_Topo_FLoc.pt, CAD_Topo_FLoc.p1b))
            IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(dest, 0) ThenBlock: {
                ArraySet(CAD_Topo_FPlex.mer0, Add(n, 1), mer)
            }
            IfCondition NotEqual(dest, 0) ThenBlock: {
                ArraySet(CAD_Topo_FPlex.mer1, Add(n, 1), mer)
            }
            n = Add(n, 1)
            k = Add(k, 1)
        }
        IfCondition EqualTo(dest, 0) ThenBlock: {
            CAD_Topo_FPlex.mer0n = n
            ArraySet(CAD_Topo_FPlex.mer0, 0, n)
        }
        IfCondition NotEqual(dest, 0) ThenBlock: {
            CAD_Topo_FPlex.mer1n = n
            ArraySet(CAD_Topo_FPlex.mer1, 0, n)
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("cyl-mer lathe n=", 16, n)
        CAD_Topo.FilletDumpI(" dest=", 6, dest)
        CAD_Topo.FilletDumpS("\n", 1)
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Topo_FPlex.mer0, 1)) }
        ReturnValue(ArrayGet(CAD_Topo_FPlex.mer1, 1))
    }
}

Function.CAD_Topo.FilletPlexMerReset {
    Output: Integer
    Body: {
        CAD_Topo_FPlex.mer0n = 0
        CAD_Topo_FPlex.mer1n = 0
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletPlexStashTh {
    Input: th: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.th0, 0) ThenBlock: {
            CAD_Topo_FPlex.th0 = th
            ReturnValue(1)
        }
        IfCondition EqualTo(CAD_Topo_FPlex.th1, 0) ThenBlock: {
            IfCondition NotEqual(th, CAD_Topo_FPlex.th0) ThenBlock: { CAD_Topo_FPlex.th1 = th }
        }
        ReturnValue(1)
    }
}

// Rewrite a LINE curve from the edge's current vertices.
Function.CAD_Topo.FilletPlexRefreshLine {
    Input: edge_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        v0 = CAD_Store.Read(edge_h, 0)
        v1 = CAD_Store.Read(edge_h, 1)
        crv = CAD_Store.Read(edge_h, 2)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(crv, 1, CAD_Store.Read(v0, 0))
        CAD_Store.Write(crv, 2, CAD_Store.Read(v0, 1))
        CAD_Store.Write(crv, 3, CAD_Store.Read(v0, 2))
        CAD_Store.Write(crv, 4, Float_Sub(CAD_Store.Read(v1, 0), CAD_Store.Read(v0, 0)))
        CAD_Store.Write(crv, 5, Float_Sub(CAD_Store.Read(v1, 1), CAD_Store.Read(v0, 1)))
        CAD_Store.Write(crv, 6, Float_Sub(CAD_Store.Read(v1, 2), CAD_Store.Read(v0, 2)))
        ReturnValue(1)
    }
}

// During EdgeLocal skip: record this junc=5 end. Th is the lid contact
// (|Nz| larger). Host is the blocker's open circle at V.
Function.CAD_Topo.FilletPlexStashJunc5 {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FPlex.j5, 0) ThenBlock: { CAD_Topo_FPlex.j5 = Allocate(512) }
        IfCondition EqualTo(CAD_Topo_FPlex.j5, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(CAD_Topo_FPlex.j5n, 8) ThenBlock: { ReturnValue(0) }
        th = CAD_Topo_FLoc.aa
        tw = CAD_Topo_FLoc.bb
        gen = CAD_Topo_FLoc.ega
        ab = CAD_Topo_FLoc.n1z
        IfCondition EqualTo(CAD_Num.IsNeg(ab), 1) ThenBlock: { ab = Float_Sub(0, ab) }
        aa = CAD_Topo_FLoc.n2z
        IfCondition EqualTo(CAD_Num.IsNeg(aa), 1) ThenBlock: { aa = Float_Sub(0, aa) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(ab, aa)), 1) ThenBlock: {
            th = CAD_Topo_FLoc.bb
            tw = CAD_Topo_FLoc.aa
            gen = CAD_Topo_FLoc.egb
        }
        cx = CAD_Topo_FLoc.c0x
        cy = CAD_Topo_FLoc.c0y
        cz = CAD_Topo_FLoc.c0z
        IfCondition EqualTo(CAD_Topo_FLoc.ei, 1) ThenBlock: {
            cx = CAD_Topo_FLoc.c1x
            cy = CAD_Topo_FLoc.c1y
            cz = CAD_Topo_FLoc.c1z
        }
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.r, 0), 1) ThenBlock: { ReturnValue(0) }
        base = Multiply(CAD_Topo_FPlex.j5n, 20)
        ArraySet(CAD_Topo_FPlex.j5, base, CAD_Topo_FLoc.vv)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 1), th)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 2), tw)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 3), CAD_Topo_FLoc.ar)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 4), CAD_Topo_FLoc.endf)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 5), CAD_Topo_FLoc.edx)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 6), CAD_Topo_FLoc.edy)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 7), CAD_Topo_FLoc.edz)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 8), cx)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 9), cy)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 10), cz)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 11), CAD_Topo_FLoc.r)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 12), gen)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 13), Float_Div(Float_Sub(CAD_Store.Read(th, 0), cx), CAD_Topo_FLoc.r))
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 14), Float_Div(Float_Sub(CAD_Store.Read(th, 1), cy), CAD_Topo_FLoc.r))
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 15), Float_Div(Float_Sub(CAD_Store.Read(th, 2), cz), CAD_Topo_FLoc.r))
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 16), Float_Div(Float_Sub(CAD_Store.Read(tw, 0), cx), CAD_Topo_FLoc.r))
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 17), Float_Div(Float_Sub(CAD_Store.Read(tw, 1), cy), CAD_Topo_FLoc.r))
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 18), Float_Div(Float_Sub(CAD_Store.Read(tw, 2), cz), CAD_Topo_FLoc.r))
        hit = CAD_Topo.FilletPlexJunc5FindHost(CAD_Topo_FLoc.endf, CAD_Topo_FLoc.vv)
        ArraySet(CAD_Topo_FPlex.j5, Add(base, 19), hit)
        IfCondition EqualTo(CAD_Topo_FPlex.j5host, 0) ThenBlock: { CAD_Topo_FPlex.j5host = hit }
        CAD_Topo_FPlex.j5n = Add(CAD_Topo_FPlex.j5n, 1)
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("j5 stash n=", 11, CAD_Topo_FPlex.j5n)
        CAD_Topo.FilletDumpI(" Th=", 4, Float_ToInt(CAD_Store.Read(th, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th, 1)))
        CAD_Topo.FilletDumpI(" Tw=", 4, Float_ToInt(CAD_Store.Read(tw, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(tw, 1)))
        CAD_Topo.FilletDumpI(" host=", 6, hit)
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(1)
    }
}

// One host remainder Th–Th on BOTH twins. Origin is the host's V
// mapped to that end's Th — not prev-dest (south prev is still V).
Function.CAD_Topo.FilletPlexClipHostArc {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FPlex.th0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.th1, 0) ThenBlock: { ReturnValue(0) }
        hit = CAD_Topo_FPlex.j5host
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpS("j5 clip no host\n", 16)
            ReturnValue(0)
        }
        crv = CAD_Store.Read(hit, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        ov0 = CAD_Store.Read(hit, 0)
        ov1 = CAD_Store.Read(hit, 1)
        aa = CAD_Topo_FPlex.th0
        bb = CAD_Topo_FPlex.th1
        IfCondition EqualTo(ov0, ArrayGet(CAD_Topo_FPlex.j5, 20)) ThenBlock: {
            aa = CAD_Topo_FPlex.th1
            bb = CAD_Topo_FPlex.th0
        }
        IfCondition EqualTo(ov0, ArrayGet(CAD_Topo_FPlex.j5, 0)) ThenBlock: {
            aa = CAD_Topo_FPlex.th0
            bb = CAD_Topo_FPlex.th1
        }
        mer = CAD_Topo.MakeMinorArcEdge(aa, bb, crv)
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("j5 clip Th0=", 12, Float_ToInt(CAD_Store.Read(CAD_Topo_FPlex.th0, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(CAD_Topo_FPlex.th0, 1)))
        CAD_Topo.FilletDumpI(" Th1=", 5, Float_ToInt(CAD_Store.Read(CAD_Topo_FPlex.th1, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(CAD_Topo_FPlex.th1, 1)))
        CAD_Topo.FilletDumpS("\n", 1)
        nswap = 0
        ei = 3
        WhileLoop LessThan(ei, 5) {
            ce = CAD_Store.Read(hit, ei)
            IfCondition NotEqual(ce, 0) ThenBlock: {
                org = CAD_Store.Read(ce, 5)
                IfCondition EqualTo(org, ov0) ThenBlock: { org = aa }
                IfCondition EqualTo(org, ov1) ThenBlock: { org = bb }
                ok = 0
                IfCondition EqualTo(org, aa) ThenBlock: { ok = 1 }
                IfCondition EqualTo(org, bb) ThenBlock: { ok = 1 }
                CAD_Topo.FilletDumpI("j5 clip ce=", 11, ei)
                CAD_Topo.FilletDumpI(" ok=", 4, ok)
                IfCondition NotEqual(org, 0) ThenBlock: {
                    CAD_Topo.FilletDumpI(" org=", 5, Float_ToInt(CAD_Store.Read(org, 0)))
                    CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(org, 1)))
                }
                CAD_Topo.FilletDumpS("\n", 1)
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    CAD_Topo.CoedgeSwapEdge(ce, mer, org)
                    nswap = Add(nswap, 1)
                }
            }
            ei = Add(ei, 1)
        }
        CAD_Topo.FilletDumpI("j5 clip R=", 10, Float_ToInt(CAD_Store.Read(crv, 10)))
        CAD_Topo.FilletDumpI(" sp=", 4, Float_ToInt(Float_Mul(CAD_Store.Read(CAD_Store.Read(mer, 2), 12), 0x408F400000000000)))
        CAD_Topo.FilletDumpI(" nswap=", 7, nswap)
        CAD_Topo.FilletDumpS("\n", 1)
        ReturnValue(nswap)
    }
}

Function.CAD_Topo.FilletPlexMerBankN {
    Input: dest: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(CAD_Topo_FPlex.mer0n) }
        ReturnValue(CAD_Topo_FPlex.mer1n)
    }
}

Function.CAD_Topo.FilletPlexMerBankE {
    Input: dest: Integer
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(ArrayGet(CAD_Topo_FPlex.mer0, i)) }
        ReturnValue(ArrayGet(CAD_Topo_FPlex.mer1, i))
    }
}

// Append mer-chain coedges to FLoc.ring starting at idx, walking from
// start_v along the bank. Returns the next free idx.
Function.CAD_Topo.FilletPlexFillMerRing {
    Input: idx: Integer
    Input: start_v: Integer
    Input: dest: Integer
    Output: Integer
    Body: {
        n = CAD_Topo.FilletPlexMerBankN(dest)
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(idx) }
        e0 = CAD_Topo.FilletPlexMerBankE(dest, 1)
        fwd = 0
        IfCondition EqualTo(CAD_Store.Read(e0, 0), start_v) ThenBlock: { fwd = 1 }
        IfCondition EqualTo(CAD_Store.Read(e0, 1), start_v) ThenBlock: { fwd = 1 }
        prev = start_v
        k = 1
        WhileLoop LessThan(k, Add(n, 1)) {
            i = k
            IfCondition EqualTo(fwd, 0) ThenBlock: { i = Subtract(Add(n, 1), k) }
            mer = CAD_Topo.FilletPlexMerBankE(dest, i)
            CAD_Topo_FLoc.which = 1
            IfCondition NotEqual(CAD_Store.Read(mer, 0), prev) ThenBlock: { CAD_Topo_FLoc.which = 0 }
            ArraySet(CAD_Topo_FLoc.ring, idx, CAD_Topo.MakeCoedge(mer, prev, CAD_Topo_FLoc.which))
            IfCondition EqualTo(CAD_Store.Read(mer, 3), 0) ThenBlock: {
                CAD_Store.Write(mer, 3, ArrayGet(CAD_Topo_FLoc.ring, idx))
            }
            IfCondition EqualTo(CAD_Topo_FLoc.which, 1) ThenBlock: {
                prev = CAD_Store.Read(mer, 1)
            }
            IfCondition EqualTo(CAD_Topo_FLoc.which, 0) ThenBlock: {
                prev = CAD_Store.Read(mer, 0)
            }
            idx = Add(idx, 1)
            k = Add(k, 1)
        }
        ReturnValue(idx)
    }
}

// Insert mer-chain coedges on the blocking face after ce_prev, from hd to ln.
Function.CAD_Topo.FilletPlexSewMer {
    Input: ce_prev: Integer
    Input: hd: Integer
    Input: dest: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ce_prev, 0) ThenBlock: { ReturnValue(0) }
        n = CAD_Topo.FilletPlexMerBankN(dest)
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        e0 = CAD_Topo.FilletPlexMerBankE(dest, 1)
        fwd = 0
        IfCondition EqualTo(CAD_Store.Read(e0, 0), hd) ThenBlock: { fwd = 1 }
        IfCondition EqualTo(CAD_Store.Read(e0, 1), hd) ThenBlock: { fwd = 1 }
        prev = hd
        k = 1
        WhileLoop LessThan(k, Add(n, 1)) {
            i = k
            IfCondition EqualTo(fwd, 0) ThenBlock: { i = Subtract(Add(n, 1), k) }
            mer = CAD_Topo.FilletPlexMerBankE(dest, i)
            CAD_Topo_FLoc.vv = 1
            IfCondition NotEqual(CAD_Store.Read(mer, 0), prev) ThenBlock: { CAD_Topo_FLoc.vv = 0 }
            CAD_Topo_FLoc.cyl = CAD_Topo.MakeCoedge(mer, prev, CAD_Topo_FLoc.vv)
            IfCondition NotEqual(CAD_Topo_FLoc.cyl, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(mer, 4), 0) ThenBlock: {
                    CAD_Store.Write(mer, 4, CAD_Topo_FLoc.cyl)
                    IfCondition NotEqual(CAD_Store.Read(mer, 3), 0) ThenBlock: {
                        CAD_Topo.LinkTwins(CAD_Store.Read(mer, 3), CAD_Topo_FLoc.cyl)
                    }
                }
                CAD_Topo.CoedgeInsertAfter(ce_prev, CAD_Topo_FLoc.cyl)
                ce_prev = CAD_Topo_FLoc.cyl
            }
            IfCondition EqualTo(CAD_Topo_FLoc.vv, 1) ThenBlock: {
                prev = CAD_Store.Read(mer, 1)
            }
            IfCondition EqualTo(CAD_Topo_FLoc.vv, 0) ThenBlock: {
                prev = CAD_Store.Read(mer, 0)
            }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletPlexIdentifyWalls {
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, CAD_Topo_FComp.n) {
            IfCondition EqualTo(CAD_Topo.FilletIRGet(i, 11), 1) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FilletIRGet(i, 21), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FilletIRGet(i, 2), 0) ThenBlock: {
                        m = CAD_Topo.FilletPlexIdentifyPair1(i)
                        CAD_Topo.FilletIRPut(i, 21, m)
                        PrintMessage("fillet plex id pair1 i=")
                        PrintNumber(i)
                        PrintMessage(" mode=")
                        PrintNumber(m)
                        PrintMessage("\n")
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// ----------------------------------------------------------------------------
// CLASSIFY: Query local ring properties to resolve solver method per node
// ----------------------------------------------------------------------------

Function.CAD_Topo.FilletPlexClassifyJunction {
    Output: Integer
    Body: {
        head = CAD_Topo_FPlex.head
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(0) }

        total_nodes = CAD_Topo_FPlex.count
        n_line = Plex.RingCountType(head, 0, 1)
        n_circ = Plex.RingCountType(head, 0, 2)
        is_rim_cycle = CAD_Topo.FilletIRRimCycle()

        cur = head
        i = 0
        WhileLoop LessThan(i, total_nodes) {
            nd_type = Plex.Type(cur)
            edge_h = Plex.Get(cur, 0)
            junc_type = 0
            method = 1 // Default SEQUENTIAL
            f1 = Plex.Get(cur, 1)
            f2 = Plex.Get(cur, 2)
            b0 = CAD_Topo.FilletPlexIdentifyRailArc(Plex.Get(cur, 3), f1, f2)
            b1 = CAD_Topo.FilletPlexIdentifyRailArc(Plex.Get(cur, 4), f1, f2)
            j0 = CAD_Topo.FilletPlexJuncAt(Plex.Get(cur, 3), f1, f2)
            j1 = CAD_Topo.FilletPlexJuncAt(Plex.Get(cur, 4), f1, f2)
            IfCondition NotEqual(b0, 0) ThenBlock: { Plex.Set(cur, 10, b0) }
            IfCondition NotEqual(b1, 0) ThenBlock: { Plex.Set(cur, 11, b1) }
            junc_type = j0
            IfCondition EqualTo(junc_type, 0) ThenBlock: { junc_type = j1 }

            IfCondition EqualTo(total_nodes, 1) ThenBlock: {
                IfCondition EqualTo(nd_type, 2) ThenBlock: {
                    // Single arc/circle edge: PLANE_CYL solver handles both top rims and boss-base joins
                    method = 6 // PLANE_CYL
                } ElseBlock: {
                    method = 9 // EDGE_LOCAL
                }
            } ElseBlock: {
                IfCondition EqualTo(n_line, total_nodes) ThenBlock: {
                    // All-LINE n≥2: plex method 1. Do not call JoinFootOk /
                    // HasGlue — those read leftover FSeq (prior sequential
                    // n, null vert, forgotten edge handles) and GPF. Open
                    // rails vs an unselected curve stay sequential; junc=5
                    // is already on the node from IdentifyRailArc / JuncAt.
                    method = 1
                } ElseBlock: {
                    IfCondition EqualTo(n_circ, total_nodes) ThenBlock: {
                        // All CIRCLE edges
                        IfCondition EqualTo(is_rim_cycle, 1) ThenBlock: {
                            method = 4 // CYL_TOP_RIM
                        } ElseBlock: {
                            method = 2 // EMIT_CHAIN
                        }
                    } ElseBlock: {
                        // MIXED LINE+CIRCLE: one emit chain strings N junction types.
                        // Coplanar is a local query at the vertex (two LINEs → cope;
                        // 3+ selected edges → XYZ sphere), not a batch recipe.
                        method = 2
                        vh = Plex.Get(cur, 3)
                        n_share = 0
                        n_ln = 0
                        n_ar = 0
                        t = head
                        ti = 0
                        WhileLoop LessThan(ti, total_nodes) {
                            share = 0
                            IfCondition EqualTo(Plex.Get(t, 3), vh) ThenBlock: { share = 1 }
                            IfCondition EqualTo(Plex.Get(t, 4), vh) ThenBlock: { share = 1 }
                            IfCondition EqualTo(share, 1) ThenBlock: {
                                n_share = Add(n_share, 1)
                                IfCondition EqualTo(Plex.Type(t), 1) ThenBlock: { n_ln = Add(n_ln, 1) }
                                IfCondition EqualTo(Plex.Type(t), 2) ThenBlock: { n_ar = Add(n_ar, 1) }
                            }
                            t = Plex.RingNext(t, 0)
                            ti = Add(ti, 1)
                        }
                        IfCondition GreaterThan(n_share, 2) ThenBlock: {
                            IfCondition EqualTo(j0, 0) ThenBlock: { j0 = 4 }
                        } ElseBlock: {
                            IfCondition GreaterThan(n_ln, 1) ThenBlock: {
                                IfCondition EqualTo(j0, 0) ThenBlock: { j0 = 1 }
                            } ElseBlock: {
                                IfCondition GreaterThan(n_ln, 0) ThenBlock: {
                                    IfCondition EqualTo(j0, 0) ThenBlock: { j0 = 2 }
                                } ElseBlock: {
                                    IfCondition EqualTo(j0, 0) ThenBlock: { j0 = 3 }
                                }
                            }
                        }
                        junc_type = j0
                        IfCondition EqualTo(junc_type, 0) ThenBlock: { junc_type = j1 }
                    }
                }
            }

            Plex.Set(cur, 6, method)
            Plex.Set(cur, 7, junc_type)
            Plex.Set(cur, 12, j1)
            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
            CAD_Topo.FilletDumpI("plex nd=", 8, i)
            CAD_Topo.FilletDumpI(" j0=", 4, j0)
            CAD_Topo.FilletDumpI(" j1=", 4, j1)
            CAD_Topo.FilletDumpI(" ns0=", 5, CAD_Topo.FilletIRCountAt(Plex.Get(cur, 3)))
            CAD_Topo.FilletDumpI(" ns1=", 5, CAD_Topo.FilletIRCountAt(Plex.Get(cur, 4)))
            CAD_Topo.FilletDumpI(" meth=", 6, method)
            CAD_Topo.FilletDumpI(" b0=", 4, b0)
            CAD_Topo.FilletDumpI(" b1=", 4, b1)
            CAD_Topo.FilletDumpS("\n", 1)
            cur = Plex.RingNext(cur, 0)
            i = Add(i, 1)
        }

        ReturnValue(1)
    }
}

// ----------------------------------------------------------------------------
// SEGMENT WALK: Group contiguous nodes in Ring 0 with identical solve methods
// ----------------------------------------------------------------------------

Function.CAD_Topo.FilletPlexSegmentWalk {
    Output: Integer
    Body: {
        head = CAD_Topo_FPlex.head
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(0) }

        // Find a true segment boundary node in circular Ring 0 (where method changes from prev node)
        start_node = head
        k = 0
        WhileLoop LessThan(k, CAD_Topo_FPlex.count) {
            pv_node = Plex.RingPrev(start_node, 0)
            IfCondition NotEqual(Plex.Get(start_node, 6), Plex.Get(pv_node, 6)) ThenBlock: {
                k = CAD_Topo_FPlex.count // Found transition
            } ElseBlock: {
                start_node = Plex.RingNext(start_node, 0)
                k = Add(k, 1)
            }
        }

        CAD_Topo_FPlex.seg_count = 0
        cur = start_node
        seg_start = cur
        seg_method = Plex.Get(cur, 6)
        seg_len = 0

        i = 0
        WhileLoop LessThan(i, CAD_Topo_FPlex.count) {
            cur_method = Plex.Get(cur, 6)

            IfCondition NotEqual(cur_method, seg_method) ThenBlock: {
                // Emit completed segment
                seg_idx = CAD_Topo_FPlex.seg_count
                base = Multiply(seg_idx, 4)
                ArraySet(CAD_Topo_FPlex.segs, base, seg_start)
                ArraySet(CAD_Topo_FPlex.segs, Add(base, 1), Plex.RingPrev(cur, 0))
                ArraySet(CAD_Topo_FPlex.segs, Add(base, 2), seg_len)
                ArraySet(CAD_Topo_FPlex.segs, Add(base, 3), seg_method)
                CAD_Topo_FPlex.seg_count = Add(CAD_Topo_FPlex.seg_count, 1)

                // Start new segment
                seg_start = cur
                seg_method = cur_method
                seg_len = 0
            }

            seg_len = Add(seg_len, 1)
            cur = Plex.RingNext(cur, 0)
            i = Add(i, 1)
        }

        // Emit final segment
        IfCondition GreaterThan(seg_len, 0) ThenBlock: {
            seg_idx = CAD_Topo_FPlex.seg_count
            base = Multiply(seg_idx, 4)
            ArraySet(CAD_Topo_FPlex.segs, base, seg_start)
            ArraySet(CAD_Topo_FPlex.segs, Add(base, 1), Plex.RingPrev(cur, 0))
            ArraySet(CAD_Topo_FPlex.segs, Add(base, 2), seg_len)
            ArraySet(CAD_Topo_FPlex.segs, Add(base, 3), seg_method)
            CAD_Topo_FPlex.seg_count = Add(CAD_Topo_FPlex.seg_count, 1)
        }

        ReturnValue(CAD_Topo_FPlex.seg_count)
    }
}

// Face of a coedge: ce[4] is the loop, loop[1] is the face.
Function.CAD_Topo.FilletPlexCeFace {
    Input: ce_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ce_h, 0) ThenBlock: { ReturnValue(0) }
        lp = CAD_Store.Read(ce_h, 4)
        IfCondition EqualTo(lp, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Store.Read(lp, 1))
    }
}

// Signed short span of a circle from its current v0 to v1. Does not
// swap the vertices: SampleCircleEdge walks the sign, and a swap would
// flip the coedge.
Function.CAD_Topo.FilletPlexCircleSpan {
    Input: crv: Integer
    Input: v0: Integer
    Input: v1: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v0, v1) ThenBlock: {
            CAD_Store.Write(crv, 12, 0)
            ReturnValue(1)
        }
        cx = CAD_Store.Read(crv, 1)
        cy = CAD_Store.Read(crv, 2)
        cz = CAD_Store.Read(crv, 3)
        xx = CAD_Store.Read(crv, 4)
        xy = CAD_Store.Read(crv, 5)
        xz = CAD_Store.Read(crv, 6)
        yx = CAD_Store.Read(crv, 7)
        yy = CAD_Store.Read(crv, 8)
        yz = CAD_Store.Read(crv, 9)
        p0x = Float_Sub(CAD_Store.Read(v0, 0), cx)
        p0y = Float_Sub(CAD_Store.Read(v0, 1), cy)
        p0z = Float_Sub(CAD_Store.Read(v0, 2), cz)
        p1x = Float_Sub(CAD_Store.Read(v1, 0), cx)
        p1y = Float_Sub(CAD_Store.Read(v1, 1), cy)
        p1z = Float_Sub(CAD_Store.Read(v1, 2), cz)
        u0 = Float_Add(Float_Add(Float_Mul(p0x, xx), Float_Mul(p0y, xy)), Float_Mul(p0z, xz))
        w0 = Float_Add(Float_Add(Float_Mul(p0x, yx), Float_Mul(p0y, yy)), Float_Mul(p0z, yz))
        u1 = Float_Add(Float_Add(Float_Mul(p1x, xx), Float_Mul(p1y, xy)), Float_Mul(p1z, xz))
        w1 = Float_Add(Float_Add(Float_Mul(p1x, yx), Float_Mul(p1y, yy)), Float_Mul(p1z, yz))
        a0 = CAD_Geom.Atan2(w0, u0)
        a1 = CAD_Geom.Atan2(w1, u1)
        span = Float_Sub(a1, a0)
        two_pi = 0x401921FB54442D18
        pi = 0x400921FB54442D18
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(span, Float_Sub(0, pi))), 1) ThenBlock: {
            span = Float_Add(span, two_pi)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(pi, span)), 1) ThenBlock: {
            span = Float_Sub(span, two_pi)
        }
        CAD_Store.Write(crv, 12, span)
        ReturnValue(1)
    }
}

// Move every circle edge that still holds old_v onto new_v and rewrite
// its span. Lines stay on MeetLineTo. Handle equality, so a second visit
// is a no-op. Assumes FSeq.h is the solid.
Function.CAD_Topo.FilletPlexRetargetCircles {
    Input: old_v: Integer
    Input: new_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(old_v, new_v) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FSeq.h, 0)
        CAD_Topo_FCE.sg = 0
        WhileLoop NotEqual(CAD_Topo_FCE.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FCE.sg, 64) ThenBlock: { CAD_Topo_FCE.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FCE.sh, 0) ThenBlock: {
                CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.sh, 0)
                CAD_Topo_FCE.fg = 0
                WhileLoop NotEqual(CAD_Topo_FCE.face, 0) {
                    IfCondition GreaterThan(CAD_Topo_FCE.fg, 4096) ThenBlock: { CAD_Topo_FCE.face = 0 }
                    IfCondition NotEqual(CAD_Topo_FCE.face, 0) ThenBlock: {
                        CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.face, 1)
                        IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                            CAD_Topo_FCE.ce = CAD_Store.Read(CAD_Topo_FCE.lp, 0)
                            CAD_Topo_FCE.hd = CAD_Topo_FCE.ce
                            CAD_Topo_FCE.g = 0
                            WhileLoop LessThan(CAD_Topo_FCE.g, 16) {
                                IfCondition EqualTo(CAD_Topo_FCE.ce, 0) ThenBlock: { CAD_Topo_FCE.g = 16 }
                                IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: {
                                    ed = CAD_Store.Read(CAD_Topo_FCE.ce, 0)
                                    nxt = CAD_Store.Read(CAD_Topo_FCE.ce, 2)
                                    IfCondition NotEqual(ed, 0) ThenBlock: {
                                        crv = CAD_Store.Read(ed, 2)
                                        IfCondition NotEqual(crv, 0) ThenBlock: {
                                            IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                                                va = CAD_Store.Read(ed, 0)
                                                vb = CAD_Store.Read(ed, 1)
                                                hit = 0
                                                IfCondition EqualTo(va, old_v) ThenBlock: { hit = 1 }
                                                IfCondition EqualTo(vb, old_v) ThenBlock: { hit = 1 }
                                                IfCondition EqualTo(hit, 1) ThenBlock: {
                                                    CAD_Topo.EdgeRetargetVert(ed, old_v, new_v)
                                                    va = CAD_Store.Read(ed, 0)
                                                    vb = CAD_Store.Read(ed, 1)
                                                    CAD_Topo.FilletPlexCircleSpan(crv, va, vb)
                                                }
                                            }
                                        }
                                    }
                                    CAD_Topo_FCE.ce = nxt
                                    IfCondition EqualTo(CAD_Topo_FCE.ce, CAD_Topo_FCE.hd) ThenBlock: { CAD_Topo_FCE.g = 16 }
                                }
                                CAD_Topo_FCE.g = Add(CAD_Topo_FCE.g, 1)
                            }
                        }
                        CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.face, 3)
                    }
                    CAD_Topo_FCE.fg = Add(CAD_Topo_FCE.fg, 1)
                }
                CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FCE.sh, 2)
            }
            CAD_Topo_FCE.sg = Add(CAD_Topo_FCE.sg, 1)
        }
        ReturnValue(1)
    }
}

// Circle table arc4c, stride 24, max 8. One row per selected open arc.
//  0 edge  1 ir  2 rmaj  3 rh  4 cx  5 cy  6 cz  7 v0  8 v1
//  9 end0 kind (1 line, 2 arc)  10 end0 index  11 end0 which
//  12 end1 kind  13 end1 index  14 end1 which
//  15 flags  16 mer0  17 mer1  18 face  19 trim0  20 trim1
//  21 shost  22 srad  23 reserved
// bp stays the one-circle buffer the line-arc hit, trim, and seam read.
// A G1 joint (|dot| >= 0.8) still refuses the whole selection.

// ----------------------------------------------------------------------------
// MAIN PLEX SOLVE ENTRY POINT
// ----------------------------------------------------------------------------

Function.CAD_Topo.FilletPlexSolve {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }

        // Previous fillet's corner counts stay in FVert. The next pad
        // often reuses the same coordinates. EdgeLocal treats count>1
        // as "another selected edge meets here" and skips the end
        // meridian, so a single edge no longer meets the side face.
        // Sequential notes again after its own reset.
        CAD_Topo.FilletVertReset()

        // Step 1: Build Plex rings from compiled IR
        PrintMessage("plex solve enter n=")
        PrintNumber(n_edges)
        PrintMessage("\n")
        IfCondition EqualTo(CAD_Topo.FilletPlexBuild(solid_handle, edges_addr, n_edges, radius_r), 0) ThenBlock: {
            PrintMessage("fillet plex build failed\n")
            ReturnValue(0)
        }
        PrintMessage("plex solve built\n")

        // Step 2: Classify junctions using local ring queries
        CAD_Topo.FilletPlexClassifyJunction()
        PrintMessage("plex solve classified\n")

        // Step 3: Walk Ring 0 to split into contiguous solver segments
        CAD_Topo.FilletPlexSegmentWalk()
        PrintMessage("plex solve walked\n")

        // Step 4: Dispatch. All-LINE rings are meth=1: FilletEdgesSequential
        // → FilletEdgeLocal. EdgeLocal calls JuncAt per end (not slot 7)
        // and ShortenRailEnd at junc=5. Case 10 is never assigned.
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("plex emit n=", 11, CAD_Topo_FPlex.count)
        CAD_Topo.FilletDumpS(" seq EdgeLocal, skip cyl both\n", 30)
        CAD_Topo_State.fillet_class = 99
        ReturnValue(CAD_Topo.FilletPlexDispatchSegment())
    }
}
