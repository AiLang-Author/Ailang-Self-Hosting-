LibraryImport.Arena
LibraryImport.Plex
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Err
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Blend

// One sharp CIRCLE plus LINEs. Scan returns 2 (not this pattern),
// 0 (matched, but the hit/axis/radius is bad — do not emit-chain),
// or 1 (both arc ends hit the host cylinder at Rmaj). The flag stays
// clear until the orchestrator zeros the circle and fillets the LINEs.
// Buffer (arc4b), 8-byte slots:
//  0 Rmaj  1 circle edge  2 circle IR  3 cx  4 cy  5 cz  6 Rh
//  7 line0 IR  8 which0  9 line1 IR  10 which1
//  11 corner0  12 corner1  13..15 hit0  16..18 hit1
//  19 trim0  20 trim1  21 mer0  22 mer1  23 line0 edge  24 line1 edge
//  26 torus face
// |N·radial| >= 0.8 is G1 and falls through. Both joints must be sharp.

Function.CAD_Topo.FilletPlexArcSharpG1 {
    Input: line_i: Integer
    Input: corner_v: Integer
    Input: circ_e: Integer
    Output: Integer
    Body: {
        // 1 = tangent, 0 = sharp, 2 = degenerate.
        IfCondition EqualTo(corner_v, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(circ_e, 0) ThenBlock: { ReturnValue(2) }
        nx = CAD_Topo.FilletIRSolGet(line_i, 9)
        ny = CAD_Topo.FilletIRSolGet(line_i, 10)
        nz = CAD_Topo.FilletIRSolGet(line_i, 11)
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(2) }
        nx = Float_Div(nx, ln)
        ny = Float_Div(ny, ln)
        nz = Float_Div(nz, ln)
        crv = CAD_Store.Read(circ_e, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(2) }
        cx = CAD_Store.Read(crv, 1)
        cy = CAD_Store.Read(crv, 2)
        vx = CAD_Store.Read(corner_v, 0)
        vy = CAD_Store.Read(corner_v, 1)
        dx = Float_Sub(vx, cx)
        dy = Float_Sub(vy, cy)
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(2) }
        dx = Float_Div(dx, ln)
        dy = Float_Div(dy, ln)
        dot = Float_Add(Float_Add(Float_Mul(nx, dx), Float_Mul(ny, dy)), Float_Mul(nz, 0))
        IfCondition EqualTo(CAD_Num.IsNeg(dot), 1) ThenBlock: { dot = Float_Sub(0, dot) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(dot, 0x3FE999999999999A)), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Hit one LINE's unshortened Th against the host cylinder at Rmaj.
// Smaller |s|. Writes xyz at buffer[base]. 0 miss, 1 ok. Does not set arc4.
Function.CAD_Topo.FilletPlexArcSharpHit {
    Input: line_i: Integer
    Input: which_end: Integer
    Input: base: Integer
    Output: Integer
    Body: {
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        cx = ArrayGet(bp, 3)
        cy = ArrayGet(bp, 4)
        rr = ArrayGet(bp, 0)
        e = CAD_Topo.FilletIRGet(line_i, 0)
        IfCondition EqualTo(e, 0) ThenBlock: { ReturnValue(0) }
        v0 = CAD_Store.Read(e, 0)
        v1 = CAD_Store.Read(e, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        x0 = CAD_Store.Read(v0, 0)
        y0 = CAD_Store.Read(v0, 1)
        z0 = CAD_Store.Read(v0, 2)
        x1 = CAD_Store.Read(v1, 0)
        y1 = CAD_Store.Read(v1, 1)
        z1 = CAD_Store.Read(v1, 2)
        dx = Float_Sub(x1, x0)
        dy = Float_Sub(y1, y0)
        dz = Float_Sub(z1, z0)
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(0) }
        dx = Float_Div(dx, ln)
        dy = Float_Div(dy, ln)
        dz = Float_Div(dz, ln)
        fs = 14
        bs = 0
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            fs = 15
            bs = 6
        }
        okf = CAD_Topo.FilletIRVSolGet(line_i, fs)
        IfCondition NotEqual(okf, 1) ThenBlock: { ReturnValue(0) }
        thx = CAD_Topo.FilletIRVSolGet(line_i, bs)
        bs1 = Add(bs, 1)
        thy = CAD_Topo.FilletIRVSolGet(line_i, bs1)
        bs2 = Add(bs, 2)
        thz = CAD_Topo.FilletIRVSolGet(line_i, bs2)
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: {
            CAD_Topo_FLoc.pt = Allocate(32)
        }
        pt = CAD_Topo_FLoc.pt
        IfCondition EqualTo(pt, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.edx = dx
        CAD_Topo_FLoc.edy = dy
        CAD_Topo_FLoc.edz = dz
        ok = CAD_Topo.FilletPlexHitZCyl(cx, cy, rr, thx, thy, thz)
        pt = CAD_Topo_FLoc.pt
        ab = CAD_Topo_FLoc.ab
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(ab, 0), 1) ThenBlock: { ReturnValue(0) }
        hx = ArrayGet(pt, 0)
        hy = ArrayGet(pt, 1)
        hz = ArrayGet(pt, 2)
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        ix = base
        ArraySet(bp, ix, hx)
        ix = Add(base, 1)
        ArraySet(bp, ix, hy)
        ix = Add(base, 2)
        ArraySet(bp, ix, hz)
        CAD_Topo.FilletDumpI("fillet arc4 hit ", 16, which_end)
        CAD_Topo.FilletDumpU(" ", 1, hx)
        CAD_Topo.FilletDumpU(" ", 1, hy)
        CAD_Topo.FilletDumpU(" ", 1, hz)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Project hit xy radially onto the host circle at lid z. Returns the vertex.
Function.CAD_Topo.FilletPlexArcSharpTrim {
    Input: base: Integer
    Output: Integer
    Body: {
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        hx = ArrayGet(bp, base)
        ix = Add(base, 1)
        hy = ArrayGet(bp, ix)
        cx = ArrayGet(bp, 3)
        cy = ArrayGet(bp, 4)
        cz = ArrayGet(bp, 5)
        rh = ArrayGet(bp, 6)
        IfCondition EqualTo(CAD_Num.IsZero(rh, 0), 1) ThenBlock: { ReturnValue(0) }
        dx = Float_Sub(hx, cx)
        dy = Float_Sub(hy, cy)
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(0) }
        dx = Float_Div(dx, ln)
        dy = Float_Div(dy, ln)
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: {
            CAD_Topo_FLoc.pt = Allocate(32)
        }
        pt = CAD_Topo_FLoc.pt
        IfCondition EqualTo(pt, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(pt, 0, Float_Add(cx, Float_Mul(rh, dx)))
        ArraySet(pt, 1, Float_Add(cy, Float_Mul(rh, dy)))
        ArraySet(pt, 2, cz)
        ReturnValue(CAD_Topo.MakeVertex(pt))
    }
}

// Put every saved circle back. Leaves the arc4 flag alone.
Function.CAD_Topo.FilletPlexArcSharpRestore {
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        IfCondition NotEqual(tab, 0) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, nc) {
                b = Multiply(i, 24)
                eh = ArrayGet(tab, b)
                ci = ArrayGet(tab, Add(b, 1))
                IfCondition NotEqual(eh, 0) ThenBlock: {
                    CAD_Topo.FilletIRPut(ci, 0, eh)
                }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(tab, 0) ThenBlock: {
            bp = CAD_Topo_FPlex.arc4b
            IfCondition NotEqual(bp, 0) ThenBlock: {
                ci = ArrayGet(bp, 2)
                eh = ArrayGet(bp, 1)
                IfCondition NotEqual(eh, 0) ThenBlock: {
                    CAD_Topo.FilletIRPut(ci, 0, eh)
                }
            }
        }
        ReturnValue(1)
    }
}

// Hide every selected circle so sequential fillets only the lines.
Function.CAD_Topo.FilletPlexArcSharpZero {
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 24)
            ci = ArrayGet(tab, Add(b, 1))
            CAD_Topo.FilletIRPut(ci, 0, 0)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Put the saved circles back and drop the flag.
Function.CAD_Topo.FilletPlexArcSharpClear {
    Output: Integer
    Body: {
        CAD_Topo.FilletPlexArcSharpRestore()
        CAD_Topo_FPlex.arc4 = 0
        ReturnValue(1)
    }
}

// Fillet-zone cylinder∩torus edge from the lid contact sv to
// S = corner − R·N. N is the meridian radius toward sv, W toward the
// cylinder wall contact. Stores the frame; does not sample φ.
// Edge is (sv, S). FLoc.sn is S, written last.
Function.CAD_Topo.FilletPlexArcSharpCope {
    Input: line_e: Integer
    Input: sv: Integer
    Input: tw: Integer
    Input: corner: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        rmaj = ArrayGet(bp, 0)
        cx = ArrayGet(bp, 3)
        cy = ArrayGet(bp, 4)
        rh = ArrayGet(bp, 6)
        IfCondition EqualTo(CAD_Num.IsZero(rmaj, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(rh, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(line_e, 0) ThenBlock: { ReturnValue(0) }
        crv = CAD_Store.Read(line_e, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 2) ThenBlock: { ReturnValue(0) }
        mx = CAD_Store.Read(crv, 1)
        my = CAD_Store.Read(crv, 2)
        mz = CAD_Store.Read(crv, 3)
        wx = Float_Sub(CAD_Store.Read(tw, 0), mx)
        wy = Float_Sub(CAD_Store.Read(tw, 1), my)
        wz = Float_Sub(CAD_Store.Read(tw, 2), mz)
        wl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(wx, wx), Float_Mul(wy, wy)), Float_Mul(wz, wz)))
        IfCondition EqualTo(CAD_Num.IsZero(wl, 0), 1) ThenBlock: { ReturnValue(0) }
        wx = Float_Div(wx, wl)
        wy = Float_Div(wy, wl)
        wz = Float_Div(wz, wl)
        nx = Float_Sub(CAD_Store.Read(sv, 0), mx)
        ny = Float_Sub(CAD_Store.Read(sv, 1), my)
        nz = Float_Sub(CAD_Store.Read(sv, 2), mz)
        wl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(wl, 0), 1) ThenBlock: { ReturnValue(0) }
        nx = Float_Div(nx, wl)
        ny = Float_Div(ny, wl)
        nz = Float_Div(nz, wl)
        dx = Float_Sub(Float_Mul(wy, nz), Float_Mul(wz, ny))
        dy = Float_Sub(Float_Mul(wz, nx), Float_Mul(wx, nz))
        dz = Float_Sub(Float_Mul(wx, ny), Float_Mul(wy, nx))
        wl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz)))
        IfCondition EqualTo(CAD_Num.IsZero(wl, 0), 1) ThenBlock: { ReturnValue(0) }
        dx = Float_Div(dx, wl)
        dy = Float_Div(dy, wl)
        dz = Float_Div(dz, wl)
        vx = Float_Sub(CAD_Store.Read(corner, 0), Float_Mul(radius_r, nx))
        vy = Float_Sub(CAD_Store.Read(corner, 1), Float_Mul(radius_r, ny))
        vz = Float_Sub(CAD_Store.Read(corner, 2), Float_Mul(radius_r, nz))
        buf = Allocate(32)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(buf, 0, vx)
        ArraySet(buf, 1, vy)
        ArraySet(buf, 2, vz)
        vh = CAD_Topo.MakeVertex(buf)
        Deallocate(buf, 32)
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        ch = CAD_Store.Alloc(16, 19)
        IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(ch, 0, 5)
        CAD_Store.Write(ch, 1, mx)
        CAD_Store.Write(ch, 2, my)
        CAD_Store.Write(ch, 3, mz)
        CAD_Store.Write(ch, 4, wx)
        CAD_Store.Write(ch, 5, wy)
        CAD_Store.Write(ch, 6, wz)
        CAD_Store.Write(ch, 7, nx)
        CAD_Store.Write(ch, 8, ny)
        CAD_Store.Write(ch, 9, nz)
        CAD_Store.Write(ch, 10, dx)
        CAD_Store.Write(ch, 11, dy)
        CAD_Store.Write(ch, 12, dz)
        CAD_Store.Write(ch, 13, radius_r)
        CAD_Store.Write(ch, 14, rmaj)
        CAD_Store.Write(ch, 15, rh)
        CAD_Store.Write(ch, 16, cx)
        CAD_Store.Write(ch, 17, cy)
        CAD_Store.Write(ch, 18, mz)
        ed = CAD_Topo.MakeEdge(sv, vh, ch)
        IfCondition EqualTo(ed, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.sn = vh
        ReturnValue(ed)
    }
}

// The vertical wall edge still ends on the profile corner after the
// cope is written. Move that end onto S. A lid line at the same corner
// stays: pulling it down to S would drop the top face.
Function.CAD_Topo.FilletPlexArcSharpDropCorner {
    Input: solid_h: Integer
    Input: corner: Integer
    Input: sn: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(corner, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(sn, 0) ThenBlock: { ReturnValue(0) }
        cx = CAD_Store.Read(corner, 0)
        cy = CAD_Store.Read(corner, 1)
        cz = CAD_Store.Read(corner, 2)
        n = 0
        sh = CAD_Store.Read(solid_h, 0)
        sg = 0
        WhileLoop NotEqual(sh, 0) {
            IfCondition GreaterThan(sg, 64) ThenBlock: { sh = 0 }
            IfCondition NotEqual(sh, 0) ThenBlock: {
                face = CAD_Store.Read(sh, 0)
                fg = 0
                WhileLoop NotEqual(face, 0) {
                    IfCondition GreaterThan(fg, 4096) ThenBlock: { face = 0 }
                    IfCondition NotEqual(face, 0) ThenBlock: {
                        nxtf = CAD_Store.Read(face, 3)
                        lp = CAD_Store.Read(face, 1)
                        IfCondition NotEqual(lp, 0) ThenBlock: {
                            ce = CAD_Store.Read(lp, 0)
                            hd = ce
                            g = 0
                            WhileLoop LessThan(g, 16) {
                                IfCondition EqualTo(ce, 0) ThenBlock: { g = 16 }
                                IfCondition NotEqual(ce, 0) ThenBlock: {
                                    ed = CAD_Store.Read(ce, 0)
                                    nxt = CAD_Store.Read(ce, 2)
                                    IfCondition NotEqual(ed, 0) ThenBlock: {
                                        crv = CAD_Store.Read(ed, 2)
                                        ck = 0
                                        IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                                        IfCondition EqualTo(ck, 1) ThenBlock: {
                                            va = CAD_Store.Read(ed, 0)
                                            vb = CAD_Store.Read(ed, 1)
                                            ha = CAD_Topo.VertSamePos(va, corner)
                                            hb = CAD_Topo.VertSamePos(vb, corner)
                                            IfCondition EqualTo(ha, 1) ThenBlock: {
                                                IfCondition EqualTo(hb, 1) ThenBlock: {
                                                    ha = 0
                                                    hb = 0
                                                }
                                            }
                                            ov = 0
                                            mv = 0
                                            IfCondition EqualTo(ha, 1) ThenBlock: {
                                                ov = vb
                                                mv = va
                                            }
                                            IfCondition EqualTo(hb, 1) ThenBlock: {
                                                ov = va
                                                mv = vb
                                            }
                                            IfCondition NotEqual(ov, 0) ThenBlock: {
                                                ox = CAD_Store.Read(ov, 0)
                                                oy = CAD_Store.Read(ov, 1)
                                                oz = CAD_Store.Read(ov, 2)
                                                same_xy = 0
                                                IfCondition EqualTo(CAD_Num.IsEqual(ox, cx, 0), 1) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Num.IsEqual(oy, cy, 0), 1) ThenBlock: { same_xy = 1 }
                                                }
                                                same_z = CAD_Num.IsEqual(oz, cz, 0)
                                                IfCondition EqualTo(same_xy, 1) ThenBlock: {
                                                    IfCondition EqualTo(same_z, 0) ThenBlock: {
                                                        CAD_Topo.EdgeRetargetVert(ed, mv, sn)
                                                        n = Add(n, 1)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ce = nxt
                                    IfCondition EqualTo(ce, hd) ThenBlock: { g = 16 }
                                }
                                g = Add(g, 1)
                            }
                        }
                        face = nxtf
                    }
                    fg = Add(fg, 1)
                }
                sh = CAD_Store.Read(sh, 2)
            }
            sg = Add(sg, 1)
        }
        CAD_Topo.FilletDumpI("fillet arc4 drop ", 17, n)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        ReturnValue(n)
    }
}

// Seam one arc end. The cope runs from the lid contact to S on the wall
// (corner − R·N). Both fillet faces stay 4-sided. No digon and no sphere.
Function.CAD_Topo.FilletPlexArcSharpSeam {
    Input: solid_h: Integer
    Input: which_end: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        slm = 21
        slc = 11
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            slm = 22
            slc = 12
        }
        mer = ArrayGet(bp, slm)
        corner = ArrayGet(bp, slc)
        face_t = ArrayGet(bp, 26)
        IfCondition EqualTo(mer, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail mer\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(corner, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail corner\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(face_t, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail face\n")
            ReturnValue(0)
        }
        ta = CAD_Store.Read(mer, 0)
        tb = CAD_Store.Read(mer, 1)
        IfCondition EqualTo(ta, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tb, 0) ThenBlock: { ReturnValue(0) }
        found = 0
        line_e = 0
        line_f = 0
        sh = CAD_Store.Read(solid_h, 0)
        sg = 0
        WhileLoop NotEqual(sh, 0) {
            IfCondition GreaterThan(sg, 64) ThenBlock: { sh = 0 }
            IfCondition NotEqual(sh, 0) ThenBlock: {
                face = CAD_Store.Read(sh, 0)
                fg = 0
                WhileLoop NotEqual(face, 0) {
                    IfCondition GreaterThan(fg, 64) ThenBlock: { face = 0 }
                    IfCondition NotEqual(face, 0) ThenBlock: {
                        nxtf = CAD_Store.Read(face, 3)
                        surf = CAD_Store.Read(face, 0)
                        sk = 0
                        IfCondition NotEqual(surf, 0) ThenBlock: { sk = CAD_Store.Read(surf, 0) }
                        IfCondition EqualTo(sk, 2) ThenBlock: {
                            lp = CAD_Store.Read(face, 1)
                            IfCondition NotEqual(lp, 0) ThenBlock: {
                                ce = CAD_Store.Read(lp, 0)
                                hd = ce
                                g = 0
                                WhileLoop LessThan(g, 16) {
                                    IfCondition EqualTo(ce, 0) ThenBlock: { g = 16 }
                                    IfCondition NotEqual(ce, 0) ThenBlock: {
                                        e = CAD_Store.Read(ce, 0)
                                        nxt = CAD_Store.Read(ce, 2)
                                        IfCondition NotEqual(e, 0) ThenBlock: {
                                            IfCondition NotEqual(e, mer) ThenBlock: {
                                                crv = CAD_Store.Read(e, 2)
                                                ck = 0
                                                IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                                                IfCondition EqualTo(ck, 2) ThenBlock: {
                                                    ea = CAD_Store.Read(e, 0)
                                                    eb = CAD_Store.Read(e, 1)
                                                    za = 0
                                                    zb = 0
                                                    IfCondition NotEqual(ea, 0) ThenBlock: { za = CAD_Store.Read(ea, 2) }
                                                    IfCondition NotEqual(eb, 0) ThenBlock: { zb = CAD_Store.Read(eb, 2) }
                                                    // Host rail is horizontal. The line mer spans lid to wall.
                                                    IfCondition EqualTo(CAD_Num.IsEqual(za, zb, 0), 0) ThenBlock: {
                                                        hit = 0
                                                        IfCondition EqualTo(CAD_Topo.VertSamePos(ea, ta), 1) ThenBlock: { hit = 1 }
                                                        IfCondition EqualTo(CAD_Topo.VertSamePos(ea, tb), 1) ThenBlock: { hit = 1 }
                                                        IfCondition EqualTo(CAD_Topo.VertSamePos(eb, ta), 1) ThenBlock: { hit = 1 }
                                                        IfCondition EqualTo(CAD_Topo.VertSamePos(eb, tb), 1) ThenBlock: { hit = 1 }
                                                        IfCondition EqualTo(hit, 1) ThenBlock: {
                                                            IfCondition EqualTo(found, 0) ThenBlock: {
                                                                line_e = e
                                                                line_f = face
                                                                found = 1
                                                            }
                                                            IfCondition NotEqual(e, line_e) ThenBlock: { found = 2 }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        ce = nxt
                                        IfCondition EqualTo(ce, hd) ThenBlock: { g = 16 }
                                    }
                                    g = Add(g, 1)
                                }
                            }
                        }
                        face = nxtf
                    }
                    fg = Add(fg, 1)
                }
                sh = CAD_Store.Read(sh, 2)
            }
            sg = Add(sg, 1)
        }
        IfCondition NotEqual(found, 1) ThenBlock: {
            CAD_Topo.FilletDumpI("fillet arc4 seam fail n=", 24, found)
            CAD_Topo.FilletDumpI("end=", 4, which_end)
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            ReturnValue(0)
        }
        ce0 = CAD_Topo.FindCoedgeOnFace(line_f, line_e)
        ce1 = CAD_Topo.FindCoedgeOnFace(face_t, mer)
        IfCondition EqualTo(ce0, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail ce0\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(ce1, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail ce1\n")
            ReturnValue(0)
        }
        la = CAD_Store.Read(line_e, 0)
        lb = CAD_Store.Read(line_e, 1)
        sv = 0
        tw = 0
        IfCondition EqualTo(CAD_Topo.VertSamePos(la, ta), 1) ThenBlock: {
            sv = la
            tw = lb
        }
        IfCondition EqualTo(CAD_Topo.VertSamePos(la, tb), 1) ThenBlock: {
            sv = la
            tw = lb
        }
        IfCondition EqualTo(sv, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.VertSamePos(lb, ta), 1) ThenBlock: {
                sv = lb
                tw = la
            }
            IfCondition EqualTo(CAD_Topo.VertSamePos(lb, tb), 1) ThenBlock: {
                sv = lb
                tw = la
            }
        }
        IfCondition EqualTo(sv, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail share\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        sa = CAD_Topo.VertSamePos(ta, sv)
        sb = CAD_Topo.VertSamePos(tb, sv)
        IfCondition EqualTo(sa, 1) ThenBlock: {
            IfCondition EqualTo(sb, 1) ThenBlock: { ReturnValue(0) }
        }
        gv = 0
        IfCondition EqualTo(sa, 1) ThenBlock: { gv = tb }
        IfCondition EqualTo(sb, 1) ThenBlock: { gv = ta }
        IfCondition EqualTo(gv, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail g\n")
            ReturnValue(0)
        }
        dig = CAD_Topo.FilletPlexArcSharpCope(line_e, sv, tw, corner, radius_r)
        IfCondition EqualTo(dig, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 seam fail cope\n")
            ReturnValue(0)
        }
        sn = CAD_Store.Read(dig, 1)
        IfCondition EqualTo(sn, 0) ThenBlock: { ReturnValue(0) }
        sx = CAD_Store.Read(sn, 0)
        sy = CAD_Store.Read(sn, 1)
        sz = CAD_Store.Read(sn, 2)
        CAD_Topo.FilletDumpU("fillet arc4 sn ", 15, sx)
        CAD_Topo.FilletDumpU(" ", 1, sy)
        CAD_Topo.FilletDumpU(" ", 1, sz)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        CAD_Topo_FSeq.h = solid_h
        CAD_Topo.FilletRailsMeetLineTo(tw, sn)
        CAD_Topo.FilletRailsMeetLineTo(gv, sn)
        CAD_Topo.FilletPlexRetargetCircles(gv, sn)
        vx = CAD_Store.Read(sv, 0)
        vy = CAD_Store.Read(sv, 1)
        vz = CAD_Store.Read(sv, 2)
        CAD_Topo_FVert.px = vx
        CAD_Topo_FVert.py = vy
        CAD_Topo_FVert.pz = vz
        CAD_Topo_FLoc.v0 = sv
        CAD_Topo_FLoc.sn = sn
        CAD_Topo_FSeq.h = solid_h
        CAD_Topo.FilletRailsMeetPin()
        CAD_Topo.FilletPlexArcSharpDropCorner(solid_h, corner, sn)
        vv = CAD_Store.Read(ce0, 5)
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, sv), 1) ThenBlock: { vv = sv }
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, sv), 0) ThenBlock: { vv = sn }
        nce = CAD_Topo.CoedgeSwapEdge(ce0, dig, vv)
        IfCondition EqualTo(nce, 0) ThenBlock: { ReturnValue(0) }
        sens = 1
        dv0 = CAD_Store.Read(dig, 0)
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, dv0), 0) ThenBlock: { sens = 0 }
        CAD_Store.Write(nce, 6, sens)
        vv = CAD_Store.Read(ce1, 5)
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, sv), 1) ThenBlock: { vv = sv }
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, sv), 0) ThenBlock: { vv = sn }
        nce = CAD_Topo.CoedgeSwapEdge(ce1, dig, vv)
        IfCondition EqualTo(nce, 0) ThenBlock: { ReturnValue(0) }
        sens = 1
        dv0 = CAD_Store.Read(dig, 0)
        IfCondition EqualTo(CAD_Topo.VertSamePos(vv, dv0), 0) ThenBlock: { sens = 0 }
        CAD_Store.Write(nce, 6, sens)
        CAD_Topo.FilletDumpI("fillet arc4 seam ", 17, which_end)
        CAD_Topo.FilletDumpLine("ok\n")
        ReturnValue(1)
    }
}

// Rmaj of the selected arc whose wall center is (ocx, ocy). 0 = none.
Function.CAD_Topo.FilletPlexArcSharpRmaj {
    Input: ocx: Integer
    Input: ocy: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 24)
            cx = ArrayGet(tab, Add(b, 4))
            cy = ArrayGet(tab, Add(b, 5))
            hit = 0
            IfCondition EqualTo(CAD_Num.IsEqual(cx, ocx, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(cy, ocy, 0), 1) ThenBlock: { hit = 1 }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(ArrayGet(tab, Add(b, 2)))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when the vertices are the same record or the same position.
Function.CAD_Topo.FilletPlexArcSharpSame {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(a, b) ThenBlock: { ReturnValue(1) }
        ReturnValue(CAD_Topo.VertSamePos(a, b))
    }
}

// 1 tangent, 0 sharp, 2 degenerate. Radials of the two host circles.
// Near-collinear only (|dot| >= 0.999, about 2.6 deg). Line-arc G1 stays at 0.8.
Function.CAD_Topo.FilletPlexArcSharpG1Arc {
    Input: corner_v: Integer
    Input: e0: Integer
    Input: e1: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(corner_v, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(e0, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(e1, 0) ThenBlock: { ReturnValue(2) }
        c0 = CAD_Store.Read(e0, 2)
        c1 = CAD_Store.Read(e1, 2)
        IfCondition EqualTo(c0, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(c1, 0) ThenBlock: { ReturnValue(2) }
        vx = CAD_Store.Read(corner_v, 0)
        vy = CAD_Store.Read(corner_v, 1)
        ax = Float_Sub(vx, CAD_Store.Read(c0, 1))
        ay = Float_Sub(vy, CAD_Store.Read(c0, 2))
        bx = Float_Sub(vx, CAD_Store.Read(c1, 1))
        by = Float_Sub(vy, CAD_Store.Read(c1, 2))
        la = CAD_Num.Sqrt(Float_Add(Float_Mul(ax, ax), Float_Mul(ay, ay)))
        lb = CAD_Num.Sqrt(Float_Add(Float_Mul(bx, bx), Float_Mul(by, by)))
        IfCondition EqualTo(CAD_Num.IsZero(la, 0), 1) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(CAD_Num.IsZero(lb, 0), 1) ThenBlock: { ReturnValue(2) }
        ax = Float_Div(ax, la)
        ay = Float_Div(ay, la)
        bx = Float_Div(bx, lb)
        by = Float_Div(by, lb)
        dot = Float_Add(Float_Mul(ax, bx), Float_Mul(ay, by))
        IfCondition EqualTo(CAD_Num.IsNeg(dot), 1) ThenBlock: { dot = Float_Sub(0, dot) }
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(dot, 0x3FEFF7CED916872B)), 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc4 g1\n")
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Row of a circle edge, or -1.
Function.CAD_Topo.FilletPlexArcSharpRowOf {
    Input: eh: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        i = 0
        WhileLoop LessThan(i, nc) {
            b = Multiply(i, 24)
            IfCondition EqualTo(ArrayGet(tab, b), eh) ThenBlock: { ReturnValue(i) }
            i = Add(i, 1)
        }
        miss = Subtract(0, 1)
        ReturnValue(miss)
    }
}

// Copy one circle row into bp so the line-arc helpers keep working.
Function.CAD_Topo.FilletPlexArcSharpLoad {
    Input: ci: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        b = Multiply(ci, 24)
        ArraySet(bp, 0, ArrayGet(tab, Add(b, 2)))
        ArraySet(bp, 1, ArrayGet(tab, b))
        ArraySet(bp, 2, ArrayGet(tab, Add(b, 1)))
        ArraySet(bp, 3, ArrayGet(tab, Add(b, 4)))
        ArraySet(bp, 4, ArrayGet(tab, Add(b, 5)))
        ArraySet(bp, 5, ArrayGet(tab, Add(b, 6)))
        ArraySet(bp, 6, ArrayGet(tab, Add(b, 3)))
        ArraySet(bp, 11, ArrayGet(tab, Add(b, 7)))
        ArraySet(bp, 12, ArrayGet(tab, Add(b, 8)))
        ArraySet(bp, 7, 0)
        ArraySet(bp, 8, 0)
        ArraySet(bp, 9, 0)
        ArraySet(bp, 10, 0)
        ArraySet(bp, 23, 0)
        ArraySet(bp, 24, 0)
        k0 = ArrayGet(tab, Add(b, 9))
        IfCondition EqualTo(k0, 1) ThenBlock: {
            li = ArrayGet(tab, Add(b, 10))
            ArraySet(bp, 7, li)
            ArraySet(bp, 8, ArrayGet(tab, Add(b, 11)))
            ArraySet(bp, 23, CAD_Topo.FilletIRGet(li, 0))
        }
        k1 = ArrayGet(tab, Add(b, 12))
        IfCondition EqualTo(k1, 1) ThenBlock: {
            li = ArrayGet(tab, Add(b, 13))
            ArraySet(bp, 9, li)
            ArraySet(bp, 10, ArrayGet(tab, Add(b, 14)))
            ArraySet(bp, 24, CAD_Topo.FilletIRGet(li, 0))
        }
        ArraySet(bp, 19, ArrayGet(tab, Add(b, 19)))
        ArraySet(bp, 20, ArrayGet(tab, Add(b, 20)))
        ArraySet(bp, 21, ArrayGet(tab, Add(b, 16)))
        ArraySet(bp, 22, ArrayGet(tab, Add(b, 17)))
        ArraySet(bp, 26, ArrayGet(tab, Add(b, 18)))
        ReturnValue(1)
    }
}

// Meridians, face, and trims survive the next circle's emit.
Function.CAD_Topo.FilletPlexArcSharpSave {
    Input: ci: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        bp = CAD_Topo_FPlex.arc4b
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(bp, 0) ThenBlock: { ReturnValue(0) }
        b = Multiply(ci, 24)
        ArraySet(tab, Add(b, 19), ArrayGet(bp, 19))
        ArraySet(tab, Add(b, 20), ArrayGet(bp, 20))
        ArraySet(tab, Add(b, 16), ArrayGet(bp, 21))
        ArraySet(tab, Add(b, 17), ArrayGet(bp, 22))
        ArraySet(tab, Add(b, 18), ArrayGet(bp, 26))
        ReturnValue(1)
    }
}

// 1 stored, 2 not this pattern, 0 matched but the radius or wall is bad.
Function.CAD_Topo.FilletPlexArcSharpNote {
    Input: ir: Integer
    Output: Integer
    Body: {
        eh = CAD_Topo.FilletIRGet(ir, 0)
        IfCondition EqualTo(eh, 0) ThenBlock: { ReturnValue(2) }
        IfCondition NotEqual(CAD_Topo.FilletIRGet(ir, 11), 1) ThenBlock: { ReturnValue(2) }
        IfCondition NotEqual(CAD_Topo.FilletIRGet(ir, 15), 4) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(CAD_Topo.FilletIRGet(ir, 19), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(CAD_Topo.FilletIRGet(ir, 20), 0) ThenBlock: { ReturnValue(2) }
        v0 = CAD_Store.Read(eh, 0)
        v1 = CAD_Store.Read(eh, 1)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(v0, v1) ThenBlock: { ReturnValue(2) }
        wall = CAD_Topo.FilletIRGet(ir, 20)
        surf = 0
        IfCondition NotEqual(wall, 0) ThenBlock: { surf = CAD_Store.Read(wall, 0) }
        sk = 0
        IfCondition NotEqual(surf, 0) ThenBlock: { sk = CAD_Store.Read(surf, 0) }
        IfCondition NotEqual(sk, 2) ThenBlock: { ReturnValue(2) }
        zz = CAD_Store.Read(surf, 12)
        IfCondition EqualTo(CAD_Num.IsNeg(zz), 1) ThenBlock: { zz = Float_Sub(0, zz) }
        IfCondition EqualTo(CAD_Num.IsEqual(zz, 0x3FF0000000000000, 0), 0) ThenBlock: { ReturnValue(2) }
        crv = CAD_Store.Read(eh, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(2) }
        ccx = CAD_Store.Read(crv, 1)
        ccy = CAD_Store.Read(crv, 2)
        wcx = CAD_Store.Read(surf, 1)
        wcy = CAD_Store.Read(surf, 2)
        IfCondition EqualTo(CAD_Num.IsEqual(ccx, wcx, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsEqual(ccy, wcy, 0), 0) ThenBlock: { ReturnValue(0) }
        rmj = CAD_Topo.FilletIRSolGet(ir, 12)
        IfCondition EqualTo(CAD_Num.IsZero(rmj, 0), 1) ThenBlock: {
            // Unsolved (R > r) leaves sh and sr at 0: this pattern
            // matched and must not emit. R == r writes sh = sr = -R
            // and a zero major radius, which is the sphere octant
            // on the emit-chain path, not this seam builder.
            sh = CAD_Topo.FilletIRSolGet(ir, 13)
            sr = CAD_Topo.FilletIRSolGet(ir, 14)
            IfCondition EqualTo(CAD_Num.IsZero(sh, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsZero(sr, 0), 1) ThenBlock: { ReturnValue(0) }
            }
            ReturnValue(2)
        }
        rh = CAD_Topo.FilletIRSolGet(ir, 15)
        IfCondition EqualTo(CAD_Num.IsZero(rh, 0), 1) ThenBlock: { rh = CAD_Store.Read(surf, 13) }
        IfCondition EqualTo(CAD_Num.IsZero(rh, 0), 1) ThenBlock: { ReturnValue(0) }
        sh = CAD_Topo.FilletIRSolGet(ir, 13)
        sr = CAD_Topo.FilletIRSolGet(ir, 14)
        cz = CAD_Store.Read(v0, 2)
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(nc, 7) ThenBlock: { ReturnValue(2) }
        b = Multiply(nc, 24)
        ArraySet(tab, b, eh)
        ArraySet(tab, Add(b, 1), ir)
        ArraySet(tab, Add(b, 2), rmj)
        ArraySet(tab, Add(b, 3), rh)
        ArraySet(tab, Add(b, 4), ccx)
        ArraySet(tab, Add(b, 5), ccy)
        ArraySet(tab, Add(b, 6), cz)
        ArraySet(tab, Add(b, 7), v0)
        ArraySet(tab, Add(b, 8), v1)
        s = 9
        WhileLoop LessThan(s, 24) {
            ArraySet(tab, Add(b, s), 0)
            s = Add(s, 1)
        }
        ArraySet(tab, Add(b, 21), sh)
        ArraySet(tab, Add(b, 22), sr)
        CAD_Topo_FPlex.arc4n = Add(nc, 1)
        CAD_Topo.FilletDumpI("fillet arc4 circ ", 17, ir)
        CAD_Topo.FilletDumpU(" ", 1, ccx)
        CAD_Topo.FilletDumpU(" ", 1, ccy)
        CAD_Topo.FilletDumpU(" ", 1, rmj)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Classify both ends of every stored circle. 1 ok, 0 miss, 2 not this.
Function.CAD_Topo.FilletPlexArcSharpBind {
    Input: solid_h: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        nc = CAD_Topo_FPlex.arc4n
        n = CAD_Topo_FComp.n
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        ci = 0
        WhileLoop LessThan(ci, nc) {
            b = Multiply(ci, 24)
            eh = ArrayGet(tab, b)
            v0 = ArrayGet(tab, Add(b, 7))
            v1 = ArrayGet(tab, Add(b, 8))
            ccx = ArrayGet(tab, Add(b, 4))
            ccy = ArrayGet(tab, Add(b, 5))
            en = 0
            WhileLoop LessThan(en, 2) {
                cv = v0
                IfCondition EqualTo(en, 1) ThenBlock: { cv = v1 }
                nsel = 0
                kind = 0
                idx = 0
                wh = 0
                i = 0
                WhileLoop LessThan(i, n) {
                    e = CAD_Topo.FilletIRGet(i, 0)
                    IfCondition NotEqual(e, 0) ThenBlock: {
                        IfCondition NotEqual(e, eh) ThenBlock: {
                            knd = CAD_Topo.FilletIRGet(i, 1)
                            use = 0
                            IfCondition EqualTo(knd, 1) ThenBlock: { use = 1 }
                            IfCondition EqualTo(knd, 2) ThenBlock: { use = 1 }
                            IfCondition EqualTo(use, 1) ThenBlock: {
                                a = CAD_Store.Read(e, 0)
                                bb = CAD_Store.Read(e, 1)
                                ha = CAD_Topo.FilletPlexArcSharpSame(a, cv)
                                hb = CAD_Topo.FilletPlexArcSharpSame(bb, cv)
                                hit = ha
                                IfCondition EqualTo(hb, 1) ThenBlock: { hit = 1 }
                                IfCondition EqualTo(hit, 1) ThenBlock: {
                                    nsel = Add(nsel, 1)
                                    IfCondition EqualTo(ha, 1) ThenBlock: {
                                        IfCondition EqualTo(hb, 1) ThenBlock: { nsel = Add(nsel, 1) }
                                    }
                                    IfCondition EqualTo(nsel, 1) ThenBlock: {
                                        kind = knd
                                        idx = i
                                        wh = 0
                                        IfCondition EqualTo(hb, 1) ThenBlock: { wh = 1 }
                                        IfCondition EqualTo(knd, 2) ThenBlock: {
                                            idx = CAD_Topo.FilletPlexArcSharpRowOf(e)
                                        }
                                    }
                                }
                            }
                        }
                    }
                    i = Add(i, 1)
                }
                IfCondition NotEqual(nsel, 1) ThenBlock: {
                    CAD_Topo.FilletDumpLine("fillet arc4 miss share\n")
                    ReturnValue(2)
                }
                IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(kind, 1) ThenBlock: {
                    g = CAD_Topo.FilletPlexArcSharpG1(idx, cv, eh)
                    IfCondition EqualTo(g, 2) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(g, 1) ThenBlock: { ReturnValue(2) }
                    f1 = CAD_Topo.FilletIRGet(idx, 4)
                    f2 = CAD_Topo.FilletIRGet(idx, 5)
                    blk = CAD_Topo.FilletPlexBlockingFace(solid_h, cv, f1, f2)
                    IfCondition EqualTo(blk, 0) ThenBlock: { ReturnValue(0) }
                    surf = CAD_Store.Read(blk, 0)
                    IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
                    sk = CAD_Store.Read(surf, 0)
                    IfCondition NotEqual(sk, 2) ThenBlock: { ReturnValue(0) }
                    zz = CAD_Store.Read(surf, 12)
                    IfCondition EqualTo(CAD_Num.IsNeg(zz), 1) ThenBlock: { zz = Float_Sub(0, zz) }
                    IfCondition EqualTo(CAD_Num.IsEqual(zz, 0x3FF0000000000000, 0), 0) ThenBlock: { ReturnValue(0) }
                    wcx = CAD_Store.Read(surf, 1)
                    wcy = CAD_Store.Read(surf, 2)
                    IfCondition EqualTo(CAD_Num.IsEqual(wcx, ccx, 0), 0) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(CAD_Num.IsEqual(wcy, ccy, 0), 0) ThenBlock: { ReturnValue(0) }
                }
                IfCondition EqualTo(kind, 2) ThenBlock: {
                    ob = Multiply(idx, 24)
                    oe = ArrayGet(tab, ob)
                    g = CAD_Topo.FilletPlexArcSharpG1Arc(cv, eh, oe)
                    IfCondition EqualTo(g, 2) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(g, 1) ThenBlock: { ReturnValue(2) }
                }
                slot = 9
                IfCondition EqualTo(en, 1) ThenBlock: { slot = 12 }
                ArraySet(tab, Add(b, slot), kind)
                ArraySet(tab, Add(b, Add(slot, 1)), idx)
                ArraySet(tab, Add(b, Add(slot, 2)), wh)
                en = Add(en, 1)
            }
            ci = Add(ci, 1)
        }
        ReturnValue(1)
    }
}

// Host point of circle ci at the spine-intersection angle. The lid
// contact is that point plus srad along the same radial, so the trim
// is not the pinch and not the profile corner.
Function.CAD_Topo.FilletPlexArcSharpSpine {
    Input: ci: Integer
    Input: oj: Integer
    Input: corner: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(corner, 0) ThenBlock: { ReturnValue(0) }
        b = Multiply(ci, 24)
        ob = Multiply(oj, 24)
        cx = ArrayGet(tab, Add(b, 4))
        cy = ArrayGet(tab, Add(b, 5))
        cz = ArrayGet(tab, Add(b, 6))
        rh = ArrayGet(tab, Add(b, 3))
        r1 = ArrayGet(tab, Add(b, 2))
        cx2 = ArrayGet(tab, Add(ob, 4))
        cy2 = ArrayGet(tab, Add(ob, 5))
        r2 = ArrayGet(tab, Add(ob, 2))
        IfCondition EqualTo(CAD_Num.IsZero(r1, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(r2, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(rh, 0), 1) ThenBlock: { ReturnValue(0) }
        dx = Float_Sub(cx2, cx)
        dy = Float_Sub(cy2, cy)
        d = CAD_Num.Sqrt(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)))
        IfCondition EqualTo(CAD_Num.IsZero(d, 0), 1) ThenBlock: { ReturnValue(0) }
        slack = 0x3F847AE147AE147B
        gap = Float_Sub(d, Float_Add(r1, r2))
        IfCondition EqualTo(CAD_Num.IsNeg(gap), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(gap, slack), 0) ThenBlock: { ReturnValue(0) }
        }
        dif = Float_Sub(r1, r2)
        IfCondition EqualTo(CAD_Num.IsNeg(dif), 1) ThenBlock: { dif = Float_Sub(0, dif) }
        sep = Float_Sub(dif, d)
        IfCondition EqualTo(CAD_Num.IsNeg(sep), 0) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(sep, slack), 0) ThenBlock: { ReturnValue(0) }
        }
        two = 0x4000000000000000
        a = Float_Div(Float_Add(Float_Sub(Float_Mul(r1, r1), Float_Mul(r2, r2)), Float_Mul(d, d)), Float_Mul(two, d))
        h2 = Float_Sub(Float_Mul(r1, r1), Float_Mul(a, a))
        IfCondition EqualTo(CAD_Num.IsNeg(h2), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsZero(h2, 0x3F1A36E2EB1C432D), 1) ThenBlock: { h2 = 0 }
        }
        IfCondition EqualTo(CAD_Num.IsNeg(h2), 1) ThenBlock: { ReturnValue(0) }
        h = CAD_Num.Sqrt(h2)
        ux = Float_Div(dx, d)
        uy = Float_Div(dy, d)
        px = Float_Sub(0, uy)
        py = ux
        mx = Float_Add(cx, Float_Mul(a, ux))
        my = Float_Add(cy, Float_Mul(a, uy))
        p1x = Float_Add(mx, Float_Mul(h, px))
        p1y = Float_Add(my, Float_Mul(h, py))
        p2x = Float_Sub(mx, Float_Mul(h, px))
        p2y = Float_Sub(my, Float_Mul(h, py))
        vx = CAD_Store.Read(corner, 0)
        vy = CAD_Store.Read(corner, 1)
        d1 = Float_Add(CAD_Num.Sq(Float_Sub(p1x, vx)), CAD_Num.Sq(Float_Sub(p1y, vy)))
        d2 = Float_Add(CAD_Num.Sq(Float_Sub(p2x, vx)), CAD_Num.Sq(Float_Sub(p2y, vy)))
        qx = p1x
        qy = p1y
        IfCondition EqualTo(CAD_Num.Le(d2, d1), 1) ThenBlock: {
            qx = p2x
            qy = p2y
        }
        hx = Float_Sub(qx, cx)
        hy = Float_Sub(qy, cy)
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(hx, hx), Float_Mul(hy, hy)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: { ReturnValue(0) }
        buf = Allocate(32)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(buf, 0, Float_Add(cx, Float_Mul(rh, Float_Div(hx, ln))))
        ArraySet(buf, 1, Float_Add(cy, Float_Mul(rh, Float_Div(hy, ln))))
        ArraySet(buf, 2, cz)
        vh = CAD_Topo.MakeVertex(buf)
        Deallocate(buf, 32)
        ReturnValue(vh)
    }
}

// Trim one end. Line end uses the cylinder hit. Arc end uses the spine.
Function.CAD_Topo.FilletPlexArcSharpEndTrim {
    Input: ci: Integer
    Input: which_end: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        b = Multiply(ci, 24)
        slot = 9
        base = 13
        corner = ArrayGet(tab, Add(b, 7))
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            slot = 12
            base = 16
            corner = ArrayGet(tab, Add(b, 8))
        }
        kind = ArrayGet(tab, Add(b, slot))
        idx = ArrayGet(tab, Add(b, Add(slot, 1)))
        wh = ArrayGet(tab, Add(b, Add(slot, 2)))
        IfCondition EqualTo(kind, 1) ThenBlock: {
            h = CAD_Topo.FilletPlexArcSharpHit(idx, wh, base)
            IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(CAD_Topo.FilletPlexArcSharpTrim(base))
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            ReturnValue(CAD_Topo.FilletPlexArcSharpSpine(ci, idx, corner))
        }
        ReturnValue(0)
    }
}

// Swap one meridian coedge onto the cope. Origin follows the old coedge.
Function.CAD_Topo.FilletPlexArcSharpSwap {
    Input: ce: Integer
    Input: ed: Integer
    Input: lid: Integer
    Input: wall: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ed, 0) ThenBlock: { ReturnValue(0) }
        vv = CAD_Store.Read(ce, 5)
        origin = wall
        same = CAD_Topo.VertSamePos(vv, lid)
        IfCondition EqualTo(same, 1) ThenBlock: { origin = lid }
        nce = CAD_Topo.CoedgeSwapEdge(ce, ed, origin)
        IfCondition EqualTo(nce, 0) ThenBlock: { ReturnValue(0) }
        sens = 1
        dv0 = CAD_Store.Read(ed, 0)
        same = CAD_Topo.VertSamePos(origin, dv0)
        IfCondition EqualTo(same, 0) ThenBlock: { sens = 0 }
        CAD_Store.Write(nce, 6, sens)
        ReturnValue(nce)
    }
}

// Torus∩torus edge. Seamed once, from the lower circle index.
// Edge is (lid pinch, corner at z = lid + shost). No sphere.
Function.CAD_Topo.FilletPlexArcArcSeam {
    Input: solid_h: Integer
    Input: ci: Integer
    Input: which_end: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        tab = CAD_Topo_FPlex.arc4c
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(solid_h, 0) ThenBlock: { ReturnValue(0) }
        b = Multiply(ci, 24)
        slot = 9
        corner = ArrayGet(tab, Add(b, 7))
        mer = ArrayGet(tab, Add(b, 16))
        IfCondition EqualTo(which_end, 1) ThenBlock: {
            slot = 12
            corner = ArrayGet(tab, Add(b, 8))
            mer = ArrayGet(tab, Add(b, 17))
        }
        kind = ArrayGet(tab, Add(b, slot))
        IfCondition NotEqual(kind, 2) ThenBlock: { ReturnValue(0) }
        oj = ArrayGet(tab, Add(b, Add(slot, 1)))
        ow = ArrayGet(tab, Add(b, Add(slot, 2)))
        IfCondition LessThan(oj, ci) ThenBlock: { ReturnValue(1) }
        face = ArrayGet(tab, Add(b, 18))
        cx = ArrayGet(tab, Add(b, 4))
        cy = ArrayGet(tab, Add(b, 5))
        cz = ArrayGet(tab, Add(b, 6))
        sh = ArrayGet(tab, Add(b, 21))
        rmaj = ArrayGet(tab, Add(b, 2))
        rh = ArrayGet(tab, Add(b, 3))
        ob = Multiply(oj, 24)
        merb = ArrayGet(tab, Add(ob, 16))
        IfCondition EqualTo(ow, 1) ThenBlock: { merb = ArrayGet(tab, Add(ob, 17)) }
        faceb = ArrayGet(tab, Add(ob, 18))
        cx2 = ArrayGet(tab, Add(ob, 4))
        cy2 = ArrayGet(tab, Add(ob, 5))
        rmaj2 = ArrayGet(tab, Add(ob, 2))
        rh2 = ArrayGet(tab, Add(ob, 3))
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(merb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(face, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(faceb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(corner, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(sh, 0), 1) ThenBlock: { ReturnValue(0) }
        ta = CAD_Store.Read(mer, 0)
        tb = CAD_Store.Read(mer, 1)
        IfCondition EqualTo(ta, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tb, 0) ThenBlock: { ReturnValue(0) }
        za = CAD_Store.Read(ta, 2)
        zb = CAD_Store.Read(tb, 2)
        sv = ta
        gv = tb
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(za, zb)), 1) ThenBlock: {
            sv = tb
            gv = ta
        }
        ua = CAD_Store.Read(merb, 0)
        ub = CAD_Store.Read(merb, 1)
        IfCondition EqualTo(ua, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ub, 0) ThenBlock: { ReturnValue(0) }
        za2 = CAD_Store.Read(ua, 2)
        zb2 = CAD_Store.Read(ub, 2)
        svb = ua
        gvb = ub
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(za2, zb2)), 1) ThenBlock: {
            svb = ub
            gvb = ua
        }
        same = CAD_Topo.VertSamePos(sv, svb)
        IfCondition EqualTo(same, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc6 seam fail pinch\n")
            ReturnValue(0)
        }
        vx = CAD_Store.Read(corner, 0)
        vy = CAD_Store.Read(corner, 1)
        vz = Float_Add(cz, sh)
        buf = Allocate(32)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(buf, 0, vx)
        ArraySet(buf, 1, vy)
        ArraySet(buf, 2, vz)
        sn = CAD_Topo.MakeVertex(buf)
        Deallocate(buf, 32)
        IfCondition EqualTo(sn, 0) ThenBlock: { ReturnValue(0) }
        ch = CAD_Store.Alloc(16, 16)
        IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(ch, 0, 6)
        CAD_Store.Write(ch, 1, cx)
        CAD_Store.Write(ch, 2, cy)
        CAD_Store.Write(ch, 3, vz)
        CAD_Store.Write(ch, 4, rmaj)
        CAD_Store.Write(ch, 5, rh)
        CAD_Store.Write(ch, 6, cx2)
        CAD_Store.Write(ch, 7, cy2)
        CAD_Store.Write(ch, 8, rmaj2)
        CAD_Store.Write(ch, 9, rh2)
        CAD_Store.Write(ch, 10, radius_r)
        CAD_Store.Write(ch, 11, vx)
        CAD_Store.Write(ch, 12, vy)
        ed = CAD_Topo.MakeEdge(sv, sn, ch)
        IfCondition EqualTo(ed, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FilletDumpU("fillet arc6 sn ", 15, vx)
        CAD_Topo.FilletDumpU(" ", 1, vy)
        CAD_Topo.FilletDumpU(" ", 1, vz)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        CAD_Topo_FSeq.h = solid_h
        CAD_Topo.FilletRailsMeetLineTo(gv, sn)
        CAD_Topo.FilletRailsMeetLineTo(gvb, sn)
        CAD_Topo.FilletPlexRetargetCircles(gv, sn)
        CAD_Topo.FilletPlexRetargetCircles(gvb, sn)
        IfCondition NotEqual(svb, sv) ThenBlock: {
            CAD_Topo.FilletPlexRetargetCircles(svb, sv)
            CAD_Topo_FSeq.h = solid_h
            CAD_Topo.FilletRailsMeetLineTo(svb, sv)
        }
        CAD_Topo_FVert.px = CAD_Store.Read(sv, 0)
        CAD_Topo_FVert.py = CAD_Store.Read(sv, 1)
        CAD_Topo_FVert.pz = CAD_Store.Read(sv, 2)
        CAD_Topo_FLoc.v0 = sv
        CAD_Topo_FLoc.sn = sn
        CAD_Topo_FSeq.h = solid_h
        CAD_Topo.FilletRailsMeetPin()
        CAD_Topo.FilletPlexArcSharpDropCorner(solid_h, corner, sn)
        ce0 = CAD_Topo.FindCoedgeOnFace(face, mer)
        ce1 = CAD_Topo.FindCoedgeOnFace(faceb, merb)
        IfCondition EqualTo(ce0, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc6 seam fail ce\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(ce1, 0) ThenBlock: {
            CAD_Topo.FilletDumpLine("fillet arc6 seam fail ce\n")
            ReturnValue(0)
        }
        nce = CAD_Topo.FilletPlexArcSharpSwap(ce0, ed, sv, sn)
        IfCondition EqualTo(nce, 0) ThenBlock: { ReturnValue(0) }
        nce = CAD_Topo.FilletPlexArcSharpSwap(ce1, ed, sv, sn)
        IfCondition EqualTo(nce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FilletDumpLine("fillet arc6 seam ok\n")
        ReturnValue(1)
    }
}

// 2 = not this pattern. 0 = matched miss (no IR write). 1 = table filled.
Function.CAD_Topo.FilletPlexArcSharpScan {
    Input: solid_h: Integer
    Output: Integer
    Body: {
        n = CAD_Topo_FComp.n
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(2) }
        n_circ = 0
        n_line = 0
        n_other = 0
        i = 0
        WhileLoop LessThan(i, n) {
            eh = CAD_Topo.FilletIRGet(i, 0)
            IfCondition NotEqual(eh, 0) ThenBlock: {
                knd = CAD_Topo.FilletIRGet(i, 1)
                IfCondition EqualTo(knd, 2) ThenBlock: { n_circ = Add(n_circ, 1) }
                IfCondition EqualTo(knd, 1) ThenBlock: { n_line = Add(n_line, 1) }
                IfCondition NotEqual(knd, 1) ThenBlock: {
                    IfCondition NotEqual(knd, 2) ThenBlock: { n_other = Add(n_other, 1) }
                }
            }
            i = Add(i, 1)
        }
        IfCondition NotEqual(n_other, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(n_circ, 0) ThenBlock: { ReturnValue(2) }
        IfCondition GreaterThan(n_circ, 8) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(n_circ, 1) ThenBlock: {
            IfCondition LessThan(n_line, 1) ThenBlock: { ReturnValue(2) }
        }
        CAD_Topo_FPlex.arc4n = 0
        IfCondition EqualTo(CAD_Topo_FPlex.arc4c, 0) ThenBlock: {
            CAD_Topo_FPlex.arc4c = Allocate(2048)
        }
        IfCondition EqualTo(CAD_Topo_FPlex.arc4c, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.arc4b, 0) ThenBlock: {
            CAD_Topo_FPlex.arc4b = Allocate(256)
        }
        IfCondition EqualTo(CAD_Topo_FPlex.arc4b, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            eh = CAD_Topo.FilletIRGet(i, 0)
            IfCondition NotEqual(eh, 0) ThenBlock: {
                knd = CAD_Topo.FilletIRGet(i, 1)
                IfCondition EqualTo(knd, 2) ThenBlock: {
                    st = CAD_Topo.FilletPlexArcSharpNote(i)
                    IfCondition NotEqual(st, 1) ThenBlock: { ReturnValue(st) }
                }
            }
            i = Add(i, 1)
        }
        st = CAD_Topo.FilletPlexArcSharpBind(solid_h)
        IfCondition NotEqual(st, 1) ThenBlock: { ReturnValue(st) }
        CAD_Topo.FilletDumpI("fillet arc4 n=", 14, CAD_Topo_FPlex.arc4n)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("\n")
        CAD_Topo.FilletDumpLine("fillet arc4 take\n")
        ReturnValue(1)
    }
}

// -1 not this pattern (caller emit-chains or rim-fillets).
// 0 matched failure, circle IR restored. Otherwise the solid.
Function.CAD_Topo.FilletPlexArcSharp {
    Input: solid_h: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        CAD_Topo_FPlex.arc4 = 0
        st = CAD_Topo.FilletPlexArcSharpScan(solid_h)
        IfCondition EqualTo(st, 2) ThenBlock: {
            miss = Subtract(0, 1)
            ReturnValue(miss)
        }
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(0) }
        lines = Allocate(128)
        IfCondition EqualTo(lines, 0) ThenBlock: { ReturnValue(0) }
        k = 0
        n = CAD_Topo_FComp.n
        i = 0
        WhileLoop LessThan(i, n) {
            eh = CAD_Topo.FilletIRGet(i, 0)
            IfCondition NotEqual(eh, 0) ThenBlock: {
                knd = CAD_Topo.FilletIRGet(i, 1)
                IfCondition EqualTo(knd, 1) ThenBlock: {
                    IfCondition GreaterThan(k, 15) ThenBlock: { ReturnValue(0) }
                    ArraySet(lines, k, eh)
                    k = Add(k, 1)
                }
            }
            i = Add(i, 1)
        }
        nc = CAD_Topo_FPlex.arc4n
        IfCondition LessThan(k, 1) ThenBlock: {
            IfCondition LessThan(nc, 2) ThenBlock: { ReturnValue(0) }
        }
        solid = solid_h
        IfCondition GreaterThan(k, 0) ThenBlock: {
            CAD_Topo.FilletPlexArcSharpZero()
            CAD_Topo_FPlex.arc4 = 1
            seq = CAD_Topo.FilletEdgesSequential(solid_h, lines, k, radius_r)
            CAD_Topo.FilletPlexArcSharpRestore()
            IfCondition EqualTo(seq, 0) ThenBlock: {
                CAD_Topo_FPlex.arc4 = 0
                ReturnValue(0)
            }
            solid = seq
        }
        IfCondition EqualTo(k, 0) ThenBlock: { CAD_Topo_FPlex.arc4 = 1 }
        ci = 0
        WhileLoop LessThan(ci, nc) {
            CAD_Topo.FilletPlexArcSharpLoad(ci)
            t0 = CAD_Topo.FilletPlexArcSharpEndTrim(ci, 0)
            t1 = CAD_Topo.FilletPlexArcSharpEndTrim(ci, 1)
            IfCondition EqualTo(t0, 0) ThenBlock: {
                CAD_Topo.FilletDumpLine("fillet arc4 trim miss\n")
                CAD_Topo_FPlex.arc4 = 0
                ReturnValue(0)
            }
            IfCondition EqualTo(t1, 0) ThenBlock: {
                CAD_Topo.FilletDumpLine("fillet arc4 trim miss\n")
                CAD_Topo_FPlex.arc4 = 0
                ReturnValue(0)
            }
            bp = CAD_Topo_FPlex.arc4b
            ArraySet(bp, 19, t0)
            ArraySet(bp, 20, t1)
            tx = CAD_Store.Read(t0, 0)
            ty = CAD_Store.Read(t0, 1)
            tz = CAD_Store.Read(t0, 2)
            CAD_Topo.FilletDumpU("fillet arc4 trim0 ", 18, tx)
            CAD_Topo.FilletDumpU(" ", 1, ty)
            CAD_Topo.FilletDumpU(" ", 1, tz)
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            tx = CAD_Store.Read(t1, 0)
            ty = CAD_Store.Read(t1, 1)
            tz = CAD_Store.Read(t1, 2)
            CAD_Topo.FilletDumpU("fillet arc4 trim1 ", 18, tx)
            CAD_Topo.FilletDumpU(" ", 1, ty)
            CAD_Topo.FilletDumpU(" ", 1, tz)
            CAD_Topo.FilletDumpS("\n", 1)
            PrintMessage("\n")
            tab = CAD_Topo_FPlex.arc4c
            eh = ArrayGet(tab, Multiply(ci, 24))
            em = CAD_Topo.FilletEmitPlaneCyl(solid, eh, radius_r)
            IfCondition EqualTo(em, 0) ThenBlock: {
                CAD_Topo_FPlex.arc4 = 0
                ReturnValue(0)
            }
            solid = em
            CAD_Topo.FilletPlexArcSharpSave(ci)
            ci = Add(ci, 1)
        }
        ci = 0
        WhileLoop LessThan(ci, nc) {
            CAD_Topo.FilletPlexArcSharpLoad(ci)
            tab = CAD_Topo_FPlex.arc4c
            b = Multiply(ci, 24)
            k0 = ArrayGet(tab, Add(b, 9))
            k1 = ArrayGet(tab, Add(b, 12))
            IfCondition EqualTo(k0, 1) ThenBlock: {
                s0 = CAD_Topo.FilletPlexArcSharpSeam(solid, 0, radius_r)
                IfCondition EqualTo(s0, 0) ThenBlock: {
                    CAD_Topo_FPlex.arc4 = 0
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(k0, 2) ThenBlock: {
                s0 = CAD_Topo.FilletPlexArcArcSeam(solid, ci, 0, radius_r)
                IfCondition EqualTo(s0, 0) ThenBlock: {
                    CAD_Topo_FPlex.arc4 = 0
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(k1, 1) ThenBlock: {
                s1 = CAD_Topo.FilletPlexArcSharpSeam(solid, 1, radius_r)
                IfCondition EqualTo(s1, 0) ThenBlock: {
                    CAD_Topo_FPlex.arc4 = 0
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(k1, 2) ThenBlock: {
                s1 = CAD_Topo.FilletPlexArcArcSeam(solid, ci, 1, radius_r)
                IfCondition EqualTo(s1, 0) ThenBlock: {
                    CAD_Topo_FPlex.arc4 = 0
                    ReturnValue(0)
                }
            }
            ci = Add(ci, 1)
        }
        CAD_Topo_FPlex.arc4 = 0
        CAD_Topo.FilletDumpLine("fillet arc4 ok\n")
        ReturnValue(solid)
    }
}

