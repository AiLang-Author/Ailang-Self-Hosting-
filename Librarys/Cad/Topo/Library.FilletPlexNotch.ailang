LibraryImport.Arena
LibraryImport.Plex
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Err
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Blend

// Terminator through Th (va) and Tw (vb). The host-axis plane cuts a
// short chord of the blocker (sagitta ~0.17 mm) and the fillet face
// rules flat. Plane is Th, Tw, and the fillet bisector shot along the
// axis onto the host. Ellipse is that plane ∩ the fillet cylinder
// (rmin = fillet R). Eccentric angle is the fillet angle, so a ruled
// zip stays on the cylinder. Same MakeEllipse layout. 0 fail-closed.
Function.CAD_Topo.FilletPlexNotchEllipse {
    Input: va: Integer
    Input: vb: Integer
    Input: surf: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: { ReturnValue(0) }
        hx = CAD_Store.Read(surf, 1)
        hy = CAD_Store.Read(surf, 2)
        hr = CAD_Store.Read(surf, 13)
        IfCondition EqualTo(CAD_Num.IsZero(hr, 0), 1) ThenBlock: { ReturnValue(0) }
        rf = CAD_Topo_FPlex.r
        solid = CAD_Topo_FPlex.solid
        IfCondition EqualTo(CAD_Num.IsZero(rf, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(solid, 0) ThenBlock: { ReturnValue(0) }
        tax = CAD_Store.Read(va, 0)
        tay = CAD_Store.Read(va, 1)
        taz = CAD_Store.Read(va, 2)
        wbx = CAD_Store.Read(vb, 0)
        wby = CAD_Store.Read(vb, 1)
        wbz = CAD_Store.Read(vb, 2)
        eds = Allocate(4096)
        IfCondition EqualTo(eds, 0) ThenBlock: { ReturnValue(0) }
        ne = CAD_Topo.SolidCollectEdges(solid, eds, 256)
        got = 0
        mcx = 0
        mcy = 0
        mcz = 0
        xx = 0
        xy = 0
        xz = 0
        yx = 0
        yy = 0
        yz = 0
        i = 0
        WhileLoop LessThan(i, ne) {
            e = ArrayGet(eds, i)
            IfCondition NotEqual(e, 0) ThenBlock: {
                crv = CAD_Store.Read(e, 2)
                IfCondition NotEqual(crv, 0) ThenBlock: {
                    ck = CAD_Store.Read(crv, 0)
                    IfCondition EqualTo(ck, 2) ThenBlock: {
                        cr = CAD_Store.Read(crv, 10)
                        IfCondition EqualTo(CAD_Num.IsEqual(cr, rf, 0), 1) ThenBlock: {
                            v0 = CAD_Store.Read(e, 0)
                            v1 = CAD_Store.Read(e, 1)
                            hit = 0
                            IfCondition EqualTo(v0, va) ThenBlock: { hit = 1 }
                            IfCondition EqualTo(v1, va) ThenBlock: { hit = 1 }
                            IfCondition EqualTo(hit, 1) ThenBlock: {
                                mcx = CAD_Store.Read(crv, 1)
                                mcy = CAD_Store.Read(crv, 2)
                                mcz = CAD_Store.Read(crv, 3)
                                xx = CAD_Store.Read(crv, 4)
                                xy = CAD_Store.Read(crv, 5)
                                xz = CAD_Store.Read(crv, 6)
                                yx = CAD_Store.Read(crv, 7)
                                yy = CAD_Store.Read(crv, 8)
                                yz = CAD_Store.Read(crv, 9)
                                got = 1
                                i = ne
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        Deallocate(eds, 4096)
        IfCondition EqualTo(got, 0) ThenBlock: {
            PrintMessage("notch ell miss 1\n")
            ReturnValue(0)
        }
        dx = Float_Sub(Float_Mul(xy, yz), Float_Mul(xz, yy))
        dy = Float_Sub(Float_Mul(xz, yx), Float_Mul(xx, yz))
        dz = Float_Sub(Float_Mul(xx, yy), Float_Mul(xy, yx))
        dl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz)))
        IfCondition EqualTo(CAD_Num.IsZero(dl, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 2\n")
            ReturnValue(0)
        }
        dx = Float_Div(dx, dl)
        dy = Float_Div(dy, dl)
        dz = Float_Div(dz, dl)
        vx = Float_Sub(tax, mcx)
        vy = Float_Sub(tay, mcy)
        vz = Float_Sub(taz, mcz)
        vl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(vx, vx), Float_Mul(vy, vy)), Float_Mul(vz, vz)))
        IfCondition EqualTo(CAD_Num.IsEqual(vl, rf, 0), 0) ThenBlock: {
            PrintMessage("notch ell miss 3\n")
            ReturnValue(0)
        }
        vx = Float_Div(vx, vl)
        vy = Float_Div(vy, vl)
        vz = Float_Div(vz, vl)
        wx = Float_Sub(wbx, mcx)
        wy = Float_Sub(wby, mcy)
        wz = Float_Sub(wbz, mcz)
        t = Float_Add(Float_Add(Float_Mul(wx, dx), Float_Mul(wy, dy)), Float_Mul(wz, dz))
        ux = Float_Sub(wx, Float_Mul(t, dx))
        uy = Float_Sub(wy, Float_Mul(t, dy))
        uz = Float_Sub(wz, Float_Mul(t, dz))
        ul = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ux, ux), Float_Mul(uy, uy)), Float_Mul(uz, uz)))
        IfCondition EqualTo(CAD_Num.IsEqual(ul, rf, 0), 0) ThenBlock: {
            PrintMessage("notch ell miss 4\n")
            ReturnValue(0)
        }
        ux = Float_Div(ux, ul)
        uy = Float_Div(uy, ul)
        uz = Float_Div(uz, ul)
        bx = Float_Add(ux, vx)
        by = Float_Add(uy, vy)
        bz = Float_Add(uz, vz)
        bl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(bx, bx), Float_Mul(by, by)), Float_Mul(bz, bz)))
        IfCondition EqualTo(CAD_Num.IsZero(bl, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 5\n")
            ReturnValue(0)
        }
        bx = Float_Div(bx, bl)
        by = Float_Div(by, bl)
        bz = Float_Div(bz, bl)
        qx = Float_Add(mcx, Float_Mul(rf, bx))
        qy = Float_Add(mcy, Float_Mul(rf, by))
        qz = Float_Add(mcz, Float_Mul(rf, bz))
        px = Float_Sub(qx, hx)
        py = Float_Sub(qy, hy)
        aa = Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy))
        IfCondition EqualTo(CAD_Num.IsZero(aa, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 6\n")
            ReturnValue(0)
        }
        bb = Float_Add(Float_Mul(px, dx), Float_Mul(py, dy))
        cc = Float_Sub(Float_Add(Float_Mul(px, px), Float_Mul(py, py)), Float_Mul(hr, hr))
        disc = Float_Sub(Float_Mul(bb, bb), Float_Mul(aa, cc))
        IfCondition EqualTo(CAD_Num.IsNeg(disc), 1) ThenBlock: {
            PrintMessage("notch ell miss 7\n")
            ReturnValue(0)
        }
        sd = CAD_Num.Sqrt(disc)
        s0 = Float_Div(Float_Sub(Float_Sub(0, bb), sd), aa)
        s1 = Float_Div(Float_Add(Float_Sub(0, bb), sd), aa)
        sm = Float_Mul(t, 0x3FE0000000000000)
        d0 = Float_Sub(s0, sm)
        IfCondition EqualTo(CAD_Num.IsNeg(d0), 1) ThenBlock: { d0 = Float_Sub(0, d0) }
        d1 = Float_Sub(s1, sm)
        IfCondition EqualTo(CAD_Num.IsNeg(d1), 1) ThenBlock: { d1 = Float_Sub(0, d1) }
        s = s0
        ds = d0
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d1, d0)), 1) ThenBlock: {
            s = s1
            ds = d1
        }
        lim = t
        IfCondition EqualTo(CAD_Num.IsNeg(lim), 1) ThenBlock: { lim = Float_Sub(0, lim) }
        lim = Float_Add(lim, rf)
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(lim, ds)), 1) ThenBlock: {
            PrintMessage("notch ell miss 8\n")
            ReturnValue(0)
        }
        mx = Float_Add(qx, Float_Mul(s, dx))
        my = Float_Add(qy, Float_Mul(s, dy))
        mz = Float_Add(qz, Float_Mul(s, dz))
        e1x = Float_Sub(mx, wbx)
        e1y = Float_Sub(my, wby)
        e1z = Float_Sub(mz, wbz)
        e2x = Float_Sub(tax, wbx)
        e2y = Float_Sub(tay, wby)
        e2z = Float_Sub(taz, wbz)
        nx = Float_Sub(Float_Mul(e1y, e2z), Float_Mul(e1z, e2y))
        ny = Float_Sub(Float_Mul(e1z, e2x), Float_Mul(e1x, e2z))
        nz = Float_Sub(Float_Mul(e1x, e2y), Float_Mul(e1y, e2x))
        nl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(nx, nx), Float_Mul(ny, ny)), Float_Mul(nz, nz)))
        IfCondition EqualTo(CAD_Num.IsZero(nl, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 9\n")
            ReturnValue(0)
        }
        nx = Float_Div(nx, nl)
        ny = Float_Div(ny, nl)
        nz = Float_Div(nz, nl)
        nd = Float_Add(Float_Add(Float_Mul(nx, dx), Float_Mul(ny, dy)), Float_Mul(nz, dz))
        cosa = nd
        IfCondition EqualTo(CAD_Num.IsNeg(cosa), 1) ThenBlock: { cosa = Float_Sub(0, cosa) }
        IfCondition EqualTo(CAD_Num.IsZero(cosa, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 10\n")
            ReturnValue(0)
        }
        sc = Float_Add(Float_Add(Float_Mul(nx, Float_Sub(tax, mcx)), Float_Mul(ny, Float_Sub(tay, mcy))), Float_Mul(nz, Float_Sub(taz, mcz)))
        sc = Float_Div(sc, nd)
        cx = Float_Add(mcx, Float_Mul(sc, dx))
        cy = Float_Add(mcy, Float_Mul(sc, dy))
        cz = Float_Add(mcz, Float_Mul(sc, dz))
        yx = Float_Sub(Float_Mul(dy, nz), Float_Mul(dz, ny))
        yy = Float_Sub(Float_Mul(dz, nx), Float_Mul(dx, nz))
        yz = Float_Sub(Float_Mul(dx, ny), Float_Mul(dy, nx))
        yl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(yx, yx), Float_Mul(yy, yy)), Float_Mul(yz, yz)))
        IfCondition EqualTo(CAD_Num.IsZero(yl, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 11\n")
            ReturnValue(0)
        }
        yx = Float_Div(yx, yl)
        yy = Float_Div(yy, yl)
        yz = Float_Div(yz, yl)
        xx = Float_Sub(Float_Mul(ny, yz), Float_Mul(nz, yy))
        xy = Float_Sub(Float_Mul(nz, yx), Float_Mul(nx, yz))
        xz = Float_Sub(Float_Mul(nx, yy), Float_Mul(ny, yx))
        xl = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(xx, xx), Float_Mul(xy, xy)), Float_Mul(xz, xz)))
        IfCondition EqualTo(CAD_Num.IsZero(xl, 0), 1) ThenBlock: {
            PrintMessage("notch ell miss 12\n")
            ReturnValue(0)
        }
        xx = Float_Div(xx, xl)
        xy = Float_Div(xy, xl)
        xz = Float_Div(xz, xl)
        rmin = rf
        rmaj = Float_Div(rf, cosa)
        IfCondition EqualTo(CAD_Topo_FLoc.pl1, 0) ThenBlock: { CAD_Topo_FLoc.pl1 = Allocate(32) }
        fr = CAD_Topo_FLoc.pl1
        IfCondition EqualTo(fr, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(fr, 0, cx)
        ArraySet(fr, 1, cy)
        ArraySet(fr, 2, cz)
        ArraySet(fr, 3, xx)
        ArraySet(fr, 4, xy)
        ArraySet(fr, 5, xz)
        ArraySet(fr, 6, yx)
        ArraySet(fr, 7, yy)
        ArraySet(fr, 8, yz)
        PrintMessage("notch ell rmaj_um=")
        PrintNumber(Float_ToInt(Float_Mul(rmaj, 0x408F400000000000)))
        PrintMessage("\n")
        ReturnValue(CAD_Geom.MakeEllipse(fr, rmaj, rmin))
    }
}

// One terminator: fillet-cylinder ellipse Th–Tw on the original generator,
// insert after after_ce, split the vertical at Tw, swap the fillet mer
// onto the ellipse. org_tw=0 origin Th (dest corner), 1 origin Tw.
// 1 ok, 0 miss.
Function.CAD_Topo.FilletPlexNotchInsertTerm {
    Input: th: Integer
    Input: vtop: Integer
    Input: after_ce: Integer
    Input: org_tw: Integer
    Input: surf: Integer
    Input: vert_e: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vtop, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(after_ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vert_e, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: { CAD_Topo_FLoc.pt = Allocate(32) }
        pt = CAD_Topo_FLoc.pt
        IfCondition EqualTo(pt, 0) ThenBlock: { ReturnValue(0) }
        twz = Float_Sub(CAD_Store.Read(th, 2), CAD_Topo_FPlex.r)
        ArraySet(pt, 0, CAD_Store.Read(vtop, 0))
        ArraySet(pt, 1, CAD_Store.Read(vtop, 1))
        ArraySet(pt, 2, twz)
        tw = CAD_Topo.MakeVertex(pt)
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        elc = CAD_Topo.FilletPlexNotchEllipse(th, tw, surf)
        IfCondition EqualTo(elc, 0) ThenBlock: { ReturnValue(0) }
        ell_e = CAD_Topo.MakeMinorArcEdge(th, tw, elc)
        IfCondition EqualTo(ell_e, 0) ThenBlock: { ReturnValue(0) }
        org = th
        IfCondition EqualTo(org_tw, 1) ThenBlock: { org = tw }
        sn = 1
        IfCondition NotEqual(CAD_Store.Read(ell_e, 0), org) ThenBlock: { sn = 0 }
        ell_ce = CAD_Topo.MakeCoedge(ell_e, org, sn)
        IfCondition EqualTo(ell_ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(ell_e, 3, ell_ce)
        CAD_Topo.CoedgeInsertAfter(after_ce, ell_ce)
        CAD_Topo.EdgeRetargetVert(vert_e, vtop, tw)
        CAD_Topo.FilletPlexNotchRetargetMer(th, tw, ell_e)
        ReturnValue(1)
    }
}

// Method-9 analog on the cylindrical blocker: short top is already
// the lid Th–Th arc (shared). Insert the fillet ellipse Th→Tw
// at each end, retarget the original verticals onto Tw, and swap the
// fillet's circular mer onto that same ellipse so the blend ends on
// the wall. nring becomes 6; MeshCylLoopUV tessellates a right cylinder.
// 0 miss (lid trim already done). 1 sewn.
Function.CAD_Topo.FilletPlexNotchSew {
    Input: th_a: Integer
    Input: th_b: Integer
    Input: mer: Integer
    Input: wall_ce: Integer
    Input: blk_face: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th_a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(th_b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(wall_ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(blk_face, 0) ThenBlock: { ReturnValue(0) }
        surf = CAD_Store.Read(blk_face, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: { ReturnValue(0) }
        org = CAD_Store.Read(wall_ce, 5)
        aa = CAD_Topo.FilletMerCloser(th_a, th_b, org)
        g = CAD_Topo.CoedgeSwapEdge(wall_ce, mer, aa)
        IfCondition EqualTo(g, 0) ThenBlock: { ReturnValue(0) }
        th_org = CAD_Store.Read(g, 5)
        th_dst = th_a
        IfCondition EqualTo(th_org, th_a) ThenBlock: { th_dst = th_b }
        prev_ce = CAD_Store.Read(g, 3)
        next_ce = CAD_Store.Read(g, 2)
        n_ok = 0
        // Dest: after short top, origin Th. Origin: after incoming vert, origin Tw.
        // Extrude outer side is bot→up, top reversed, down-vert — next origin is
        // the top of the down-vert, prev dest is the top of the up-vert.
        IfCondition NotEqual(next_ce, 0) ThenBlock: {
            IfCondition NotEqual(next_ce, g) ThenBlock: {
                vtop = CAD_Store.Read(next_ce, 5)
                vert_e = CAD_Store.Read(next_ce, 0)
                hit = CAD_Topo.FilletPlexNotchInsertTerm(th_dst, vtop, g, 0, surf, vert_e)
                n_ok = Add(n_ok, hit)
            }
        }
        IfCondition NotEqual(prev_ce, 0) ThenBlock: {
            IfCondition NotEqual(prev_ce, g) ThenBlock: {
                vert_e = CAD_Store.Read(prev_ce, 0)
                vtop = 0
                IfCondition NotEqual(vert_e, 0) ThenBlock: {
                    v0 = CAD_Store.Read(vert_e, 0)
                    v1 = CAD_Store.Read(vert_e, 1)
                    vtop = v0
                    IfCondition NotEqual(v0, 0) ThenBlock: {
                        IfCondition NotEqual(v1, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Store.Read(v0, 2), CAD_Store.Read(v1, 2))), 1) ThenBlock: { vtop = v1 }
                        }
                    }
                }
                hit = CAD_Topo.FilletPlexNotchInsertTerm(th_org, vtop, prev_ce, 1, surf, vert_e)
                n_ok = Add(n_ok, hit)
            }
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("notch sew n=", 12, n_ok)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("notch sew n=")
        PrintNumber(n_ok)
        PrintMessage("\n")
        IfCondition LessThan(n_ok, 2) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// One junc=5 Th: wall top is far–Th (remaining host arc), one
// fillet ellipse at Th. Far generatrix stays full height.
// nring=5. 0 miss, 1 sewn.
Function.CAD_Topo.FilletPlexNotchSewOne {
    Input: th: Integer
    Input: mer: Integer
    Input: wall_ce: Integer
    Input: blk_face: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(wall_ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(blk_face, 0) ThenBlock: { ReturnValue(0) }
        surf = CAD_Store.Read(blk_face, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(surf, 0), 2) ThenBlock: { ReturnValue(0) }
        mv0 = CAD_Store.Read(mer, 0)
        mv1 = CAD_Store.Read(mer, 1)
        IfCondition EqualTo(mv0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mv1, 0) ThenBlock: { ReturnValue(0) }
        org = CAD_Store.Read(wall_ce, 5)
        aa = CAD_Topo.FilletMerCloser(mv0, mv1, org)
        g = CAD_Topo.CoedgeSwapEdge(wall_ce, mer, aa)
        IfCondition EqualTo(g, 0) ThenBlock: { ReturnValue(0) }
        th_org = CAD_Store.Read(g, 5)
        th_dst = mv0
        IfCondition EqualTo(th_org, mv0) ThenBlock: { th_dst = mv1 }
        n_ok = 0
        IfCondition EqualTo(th_dst, th) ThenBlock: {
            next_ce = CAD_Store.Read(g, 2)
            IfCondition NotEqual(next_ce, 0) ThenBlock: {
                IfCondition NotEqual(next_ce, g) ThenBlock: {
                    vtop = CAD_Store.Read(next_ce, 5)
                    vert_e = CAD_Store.Read(next_ce, 0)
                    hit = CAD_Topo.FilletPlexNotchInsertTerm(th_dst, vtop, g, 0, surf, vert_e)
                    n_ok = Add(n_ok, hit)
                }
            }
        }
        IfCondition EqualTo(th_org, th) ThenBlock: {
            prev_ce = CAD_Store.Read(g, 3)
            IfCondition NotEqual(prev_ce, 0) ThenBlock: {
                IfCondition NotEqual(prev_ce, g) ThenBlock: {
                    vert_e = CAD_Store.Read(prev_ce, 0)
                    vtop = 0
                    IfCondition NotEqual(vert_e, 0) ThenBlock: {
                        v0 = CAD_Store.Read(vert_e, 0)
                        v1 = CAD_Store.Read(vert_e, 1)
                        vtop = v0
                        IfCondition NotEqual(v0, 0) ThenBlock: {
                            IfCondition NotEqual(v1, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Store.Read(v0, 2), CAD_Store.Read(v1, 2))), 1) ThenBlock: { vtop = v1 }
                            }
                        }
                    }
                    hit = CAD_Topo.FilletPlexNotchInsertTerm(th_org, vtop, prev_ce, 1, surf, vert_e)
                    n_ok = Add(n_ok, hit)
                }
            }
        }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("notch sew n=", 12, n_ok)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("notch sew n=")
        PrintNumber(n_ok)
        PrintMessage("\n")
        IfCondition LessThan(n_ok, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Swap the fillet 4-cycle's circular mer (R = fillet R, vertex Th)
// onto the wall ellipse, and pull the side generator from Tw_mer to Tw.
// The mer's other vertex sits at Tw height (wall). A lid rail is also
// CIRCLE R=R through Th, but both verts are at lid Z. Swapping that
// onto the vertical ellipse makes the lid non-planar and MeshRuledLoop
// stars the top. Skip same-Z rails; keep searching for the mer.
Function.CAD_Topo.FilletPlexNotchRetargetMer {
    Input: th: Integer
    Input: tw: Integer
    Input: ell_e: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ell_e, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FPlex.solid, 0) ThenBlock: { ReturnValue(0) }
        eds = Allocate(4096)
        IfCondition EqualTo(eds, 0) ThenBlock: { ReturnValue(0) }
        ne = CAD_Topo.SolidCollectEdges(CAD_Topo_FPlex.solid, eds, 256)
        rr = CAD_Topo_FPlex.r
        twz = CAD_Store.Read(tw, 2)
        i = 0
        hit = 0
        WhileLoop LessThan(i, ne) {
            e = ArrayGet(eds, i)
            IfCondition NotEqual(e, 0) ThenBlock: {
                IfCondition NotEqual(e, ell_e) ThenBlock: {
                    crv = CAD_Store.Read(e, 2)
                    IfCondition NotEqual(crv, 0) ThenBlock: {
                        ck = CAD_Store.Read(crv, 0)
                        IfCondition EqualTo(ck, 2) ThenBlock: {
                            cr = CAD_Store.Read(crv, 10)
                            IfCondition EqualTo(CAD_Num.IsEqual(cr, rr, 0), 1) ThenBlock: {
                                v0 = CAD_Store.Read(e, 0)
                                v1 = CAD_Store.Read(e, 1)
                                has = 0
                                other = 0
                                IfCondition EqualTo(v0, th) ThenBlock: {
                                    has = 1
                                    other = v1
                                }
                                IfCondition EqualTo(v1, th) ThenBlock: {
                                    has = 1
                                    other = v0
                                }
                                IfCondition EqualTo(has, 1) ThenBlock: {
                                    skip = 1
                                    IfCondition NotEqual(other, 0) ThenBlock: {
                                        oz = CAD_Store.Read(other, 2)
                                        IfCondition EqualTo(CAD_Num.IsEqual(oz, twz, 0), 1) ThenBlock: { skip = 0 }
                                    }
                                    IfCondition EqualTo(skip, 1) ThenBlock: {
                                        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
                                        CAD_Topo.FilletDumpS("retarget mer skip lid\n", 22)
                                    }
                                    IfCondition EqualTo(skip, 0) ThenBlock: {
                                        ce = CAD_Store.Read(e, 3)
                                        IfCondition EqualTo(ce, 0) ThenBlock: { ce = CAD_Store.Read(e, 4) }
                                        IfCondition NotEqual(ce, 0) ThenBlock: {
                                            IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
                                            CAD_Topo.FilletDumpS("retarget mer hit\n", 17)
                                            fa = CAD_Topo.FilletPlexCeFace(ce)
                                            sk = 0
                                            nr = 0
                                            IfCondition NotEqual(fa, 0) ThenBlock: {
                                                su = CAD_Store.Read(fa, 0)
                                                IfCondition NotEqual(su, 0) ThenBlock: { sk = CAD_Store.Read(su, 0) }
                                                lp = CAD_Store.Read(fa, 1)
                                                IfCondition NotEqual(lp, 0) ThenBlock: { nr = CAD_Topo.LoopCountCoedges(lp) }
                                            }
                                            CAD_Topo.FilletDumpI("  ce sk=", 8, sk)
                                            CAD_Topo.FilletDumpI(" nring=", 7, nr)
                                            CAD_Topo.FilletDumpS("\n", 1)
                                            CAD_Topo.CoedgeSwapEdge(ce, ell_e, th)
                                            CAD_Topo.FilletPlexNotchRetargetGen(other, tw, eds, ne)
                                            hit = 1
                                            i = ne
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        Deallocate(eds, 4096)
        ReturnValue(hit)
    }
}

Function.CAD_Topo.FilletPlexNotchRetargetGen {
    Input: old_v: Integer
    Input: new_v: Integer
    Input: eds: Address
    Input: ne: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(eds, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        n = 0
        WhileLoop LessThan(i, ne) {
            e = ArrayGet(eds, i)
            IfCondition NotEqual(e, 0) ThenBlock: {
                crv = CAD_Store.Read(e, 2)
                ck = 0
                IfCondition NotEqual(crv, 0) ThenBlock: { ck = CAD_Store.Read(crv, 0) }
                IfCondition EqualTo(ck, 1) ThenBlock: {
                    has = 0
                    IfCondition EqualTo(CAD_Store.Read(e, 0), old_v) ThenBlock: { has = 1 }
                    IfCondition EqualTo(CAD_Store.Read(e, 1), old_v) ThenBlock: { has = 1 }
                    IfCondition EqualTo(has, 1) ThenBlock: {
                        CAD_Topo.EdgeRetargetVert(e, old_v, new_v)
                        n = Add(n, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// Shrink the LID twin of the host CIRCLE to Th_a–Th_b, then sew the
// blocker with the same short arc plus plane∩cyl ellipses at each Th
// (method-9 analog). Dual-twin of the short arc alone was a warped
// 4-cycle; lid-only left a crack. Do not write th0/th1/j5/j5host.
// 0 fail-closed (no mutation). 1 ok (lid trimmed; sew may no-op).
// Only ResolveNotch calls this.
Function.CAD_Topo.FilletPlexNotchHost {
    Input: th_a: Integer
    Input: th_b: Integer
    Input: host_edge: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(host_edge, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(th_a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(th_b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(th_a, th_b) ThenBlock: { ReturnValue(0) }
        crv = CAD_Store.Read(host_edge, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 2) ThenBlock: { ReturnValue(0) }
        // Host R is the blocker arc, not the fillet mer. Swapping a
        // mer would move blend 4-cycle slots.
        hr = CAD_Store.Read(crv, 10)
        rr = CAD_Topo_FPlex.r
        IfCondition EqualTo(CAD_Num.IsEqual(hr, rr, 0), 1) ThenBlock: { ReturnValue(0) }
        ca = CAD_Store.Read(host_edge, 3)
        cb = CAD_Store.Read(host_edge, 4)
        IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cb, 0) ThenBlock: { ReturnValue(0) }
        mer = CAD_Topo.MakeMinorArcEdge(th_a, th_b, crv)
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.pl1, 0) ThenBlock: { CAD_Topo_FLoc.pl1 = Allocate(32) }
        pl = CAD_Topo_FLoc.pl1
        IfCondition EqualTo(pl, 0) ThenBlock: { ReturnValue(0) }
        fa = CAD_Topo.FilletPlexCeFace(ca)
        fb = CAD_Topo.FilletPlexCeFace(cb)
        nz_a = 0
        pa = CAD_Topo.FaceGetPlane(fa, pl)
        IfCondition EqualTo(pa, 0) ThenBlock: {
            nz_a = ArrayGet(pl, 12)
            IfCondition EqualTo(CAD_Num.IsNeg(nz_a), 1) ThenBlock: { nz_a = Float_Sub(0, nz_a) }
        }
        nz_b = 0
        pb = CAD_Topo.FaceGetPlane(fb, pl)
        IfCondition EqualTo(pb, 0) ThenBlock: {
            nz_b = ArrayGet(pl, 12)
            IfCondition EqualTo(CAD_Num.IsNeg(nz_b), 1) ThenBlock: { nz_b = Float_Sub(0, nz_b) }
        }
        lid_ce = 0
        IfCondition EqualTo(pa, 0) ThenBlock: {
            IfCondition NotEqual(pb, 0) ThenBlock: { lid_ce = ca }
        }
        IfCondition EqualTo(pb, 0) ThenBlock: {
            IfCondition NotEqual(pa, 0) ThenBlock: { lid_ce = cb }
        }
        IfCondition EqualTo(pa, 0) ThenBlock: {
            IfCondition EqualTo(pb, 0) ThenBlock: {
                lid_ce = ca
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(nz_a, nz_b)), 1) ThenBlock: { lid_ce = cb }
            }
        }
        IfCondition EqualTo(lid_ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("notch Th0=", 10, Float_ToInt(CAD_Store.Read(th_a, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th_a, 1)))
        CAD_Topo.FilletDumpI(" Th1=", 5, Float_ToInt(CAD_Store.Read(th_b, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th_b, 1)))
        CAD_Topo.FilletDumpS("\n", 1)
        org = CAD_Store.Read(lid_ce, 5)
        aa = CAD_Topo.FilletMerCloser(th_a, th_b, org)
        CAD_Topo.CoedgeSwapEdge(lid_ce, mer, aa)
        CAD_Topo.FilletDumpI("notch R=", 8, Float_ToInt(hr))
        mch = CAD_Store.Read(mer, 2)
        spv = 0
        IfCondition NotEqual(mch, 0) ThenBlock: { spv = CAD_Store.Read(mch, 12) }
        CAD_Topo.FilletDumpI(" sp=", 4, Float_ToInt(Float_Mul(spv, 0x408F400000000000)))
        CAD_Topo.FilletDumpS("\n", 1)
        wall_ce = ca
        IfCondition EqualTo(lid_ce, ca) ThenBlock: { wall_ce = cb }
        blk_face = CAD_Topo.FilletPlexCeFace(wall_ce)
        CAD_Topo.FilletPlexNotchSew(th_a, th_b, mer, wall_ce, blk_face)
        lpw = 0
        IfCondition NotEqual(blk_face, 0) ThenBlock: { lpw = CAD_Store.Read(blk_face, 1) }
        nrw = 0
        IfCondition NotEqual(lpw, 0) ThenBlock: { nrw = CAD_Topo.LoopCountCoedges(lpw) }
        CAD_Topo.FilletDumpI("notch wall nring=", 17, nrw)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("notch wall nring=")
        PrintNumber(nrw)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// One junc=5 Th: lid host CIRCLE becomes far–Th (original other
// arc end stays). Then sew one ellipse at Th. Same lid-twin
// pick as NotchHost. 0 fail-closed. 1 ok.
Function.CAD_Topo.FilletPlexNotchHostOne {
    Input: th: Integer
    Input: host_edge: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(host_edge, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(th, 0) ThenBlock: { ReturnValue(0) }
        crv = CAD_Store.Read(host_edge, 2)
        IfCondition EqualTo(crv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(crv, 0), 2) ThenBlock: { ReturnValue(0) }
        hr = CAD_Store.Read(crv, 10)
        rr = CAD_Topo_FPlex.r
        IfCondition EqualTo(CAD_Num.IsEqual(hr, rr, 0), 1) ThenBlock: { ReturnValue(0) }
        hv0 = CAD_Store.Read(host_edge, 0)
        hv1 = CAD_Store.Read(host_edge, 1)
        IfCondition EqualTo(hv0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(hv1, 0) ThenBlock: { ReturnValue(0) }
        dx = Float_Sub(CAD_Store.Read(hv0, 0), CAD_Store.Read(th, 0))
        dy = Float_Sub(CAD_Store.Read(hv0, 1), CAD_Store.Read(th, 1))
        dz = Float_Sub(CAD_Store.Read(hv0, 2), CAD_Store.Read(th, 2))
        d0 = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
        dx = Float_Sub(CAD_Store.Read(hv1, 0), CAD_Store.Read(th, 0))
        dy = Float_Sub(CAD_Store.Read(hv1, 1), CAD_Store.Read(th, 1))
        dz = Float_Sub(CAD_Store.Read(hv1, 2), CAD_Store.Read(th, 2))
        d1 = Float_Add(Float_Add(Float_Mul(dx, dx), Float_Mul(dy, dy)), Float_Mul(dz, dz))
        far = hv0
        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(d0, d1)), 1) ThenBlock: { far = hv1 }
        IfCondition EqualTo(far, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(far, th) ThenBlock: { ReturnValue(0) }
        ca = CAD_Store.Read(host_edge, 3)
        cb = CAD_Store.Read(host_edge, 4)
        IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cb, 0) ThenBlock: { ReturnValue(0) }
        mer = CAD_Topo.MakeMinorArcEdge(far, th, crv)
        IfCondition EqualTo(mer, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.pl1, 0) ThenBlock: { CAD_Topo_FLoc.pl1 = Allocate(32) }
        pl = CAD_Topo_FLoc.pl1
        IfCondition EqualTo(pl, 0) ThenBlock: { ReturnValue(0) }
        fa = CAD_Topo.FilletPlexCeFace(ca)
        fb = CAD_Topo.FilletPlexCeFace(cb)
        nz_a = 0
        pa = CAD_Topo.FaceGetPlane(fa, pl)
        IfCondition EqualTo(pa, 0) ThenBlock: {
            nz_a = ArrayGet(pl, 12)
            IfCondition EqualTo(CAD_Num.IsNeg(nz_a), 1) ThenBlock: { nz_a = Float_Sub(0, nz_a) }
        }
        nz_b = 0
        pb = CAD_Topo.FaceGetPlane(fb, pl)
        IfCondition EqualTo(pb, 0) ThenBlock: {
            nz_b = ArrayGet(pl, 12)
            IfCondition EqualTo(CAD_Num.IsNeg(nz_b), 1) ThenBlock: { nz_b = Float_Sub(0, nz_b) }
        }
        lid_ce = 0
        IfCondition EqualTo(pa, 0) ThenBlock: {
            IfCondition NotEqual(pb, 0) ThenBlock: { lid_ce = ca }
        }
        IfCondition EqualTo(pb, 0) ThenBlock: {
            IfCondition NotEqual(pa, 0) ThenBlock: { lid_ce = cb }
        }
        IfCondition EqualTo(pa, 0) ThenBlock: {
            IfCondition EqualTo(pb, 0) ThenBlock: {
                lid_ce = ca
                IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(nz_a, nz_b)), 1) ThenBlock: { lid_ce = cb }
            }
        }
        IfCondition EqualTo(lid_ce, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
        CAD_Topo.FilletDumpI("notch one Th=", 13, Float_ToInt(CAD_Store.Read(th, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(th, 1)))
        CAD_Topo.FilletDumpI(" far=", 5, Float_ToInt(CAD_Store.Read(far, 0)))
        CAD_Topo.FilletDumpI(",", 1, Float_ToInt(CAD_Store.Read(far, 1)))
        CAD_Topo.FilletDumpS("\n", 1)
        org = CAD_Store.Read(lid_ce, 5)
        aa = CAD_Topo.FilletMerCloser(far, th, org)
        CAD_Topo.CoedgeSwapEdge(lid_ce, mer, aa)
        CAD_Topo.FilletDumpI("notch R=", 8, Float_ToInt(hr))
        mch = CAD_Store.Read(mer, 2)
        spv = 0
        IfCondition NotEqual(mch, 0) ThenBlock: { spv = CAD_Store.Read(mch, 12) }
        CAD_Topo.FilletDumpI(" sp=", 4, Float_ToInt(Float_Mul(spv, 0x408F400000000000)))
        CAD_Topo.FilletDumpS("\n", 1)
        wall_ce = ca
        IfCondition EqualTo(lid_ce, ca) ThenBlock: { wall_ce = cb }
        blk_face = CAD_Topo.FilletPlexCeFace(wall_ce)
        CAD_Topo.FilletPlexNotchSewOne(th, mer, wall_ce, blk_face)
        lpw = 0
        IfCondition NotEqual(blk_face, 0) ThenBlock: { lpw = CAD_Store.Read(blk_face, 1) }
        nrw = 0
        IfCondition NotEqual(lpw, 0) ThenBlock: { nrw = CAD_Topo.LoopCountCoedges(lpw) }
        CAD_Topo.FilletDumpI("notch wall nring=", 17, nrw)
        CAD_Topo.FilletDumpS("\n", 1)
        PrintMessage("notch wall nring=")
        PrintNumber(nrw)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

