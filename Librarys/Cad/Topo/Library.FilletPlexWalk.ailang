LibraryImport.Arena
LibraryImport.Plex
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Err
LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Blend

// ----------------------------------------------------------------------------
// DISPATCH: Execute solvers per segment
// ----------------------------------------------------------------------------

Function.CAD_Topo.FilletPlexDispatchSegment {
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FPlex.seg_count, 0) ThenBlock: { ReturnValue(0) }

        solid = CAD_Topo_FPlex.solid
        r = CAD_Topo_FPlex.r
        res = 1

        // PASS 1: Dispatch SEQUENTIAL segments (method=1) first so sharp LINE corners/vertex spheres solve first
        s_idx = 0
        WhileLoop LessThan(s_idx, CAD_Topo_FPlex.seg_count) {
            base = Multiply(s_idx, 4)
            start_nd = ArrayGet(CAD_Topo_FPlex.segs, base)
            count = ArrayGet(CAD_Topo_FPlex.segs, Add(base, 2))
            method = ArrayGet(CAD_Topo_FPlex.segs, Add(base, 3))

            IfCondition EqualTo(method, 1) ThenBlock: {
                PrintMessage("fillet plex dispatch pass1 (SEQUENTIAL) seg ")
                PrintNumber(s_idx)
                PrintMessage(" count=")
                PrintNumber(count)
                PrintMessage("\n")

                // Straight LINE rails first (junc≠5, copes at the back),
                // then open rails into the unselected cylinder (junc=5).
                cur = start_nd
                k = 0
                i = 0
                WhileLoop LessThan(i, count) {
                    CAD_Topo_FLoc.sn = 0
                    IfCondition EqualTo(Plex.Get(cur, 7), 5) ThenBlock: { CAD_Topo_FLoc.sn = 1 }
                    IfCondition EqualTo(Plex.Get(cur, 12), 5) ThenBlock: { CAD_Topo_FLoc.sn = 1 }
                    IfCondition EqualTo(CAD_Topo_FLoc.sn, 0) ThenBlock: {
                        ArraySet(CAD_Topo_FPlex.vert_buf, k, Plex.Get(cur, 0))
                        k = Add(k, 1)
                    }
                    cur = Plex.RingNext(cur, 0)
                    i = Add(i, 1)
                }
                cur = start_nd
                i = 0
                WhileLoop LessThan(i, count) {
                    CAD_Topo_FLoc.sn = 0
                    IfCondition EqualTo(Plex.Get(cur, 7), 5) ThenBlock: { CAD_Topo_FLoc.sn = 1 }
                    IfCondition EqualTo(Plex.Get(cur, 12), 5) ThenBlock: { CAD_Topo_FLoc.sn = 1 }
                    IfCondition EqualTo(CAD_Topo_FLoc.sn, 1) ThenBlock: {
                        ArraySet(CAD_Topo_FPlex.vert_buf, k, Plex.Get(cur, 0))
                        k = Add(k, 1)
                    }
                    cur = Plex.RingNext(cur, 0)
                    i = Add(i, 1)
                }
                IfCondition EqualTo(CAD_Topo.FilletBatchOnBlend(CAD_Topo_FPlex.vert_buf, count), 1) ThenBlock: {
                    PrintMessage("fillet incident-collar seq\n")
                    CAD_Topo_State.fillet_reason = 5
                    ReturnValue(0)
                }
                IfCondition EqualTo(CAD_Topo_FComp.mfd, 0) ThenBlock: { CAD_Topo.FilletDumpOpen() }
                CAD_Topo.FilletDumpI("plex seq n=", 11, count)
                CAD_Topo.FilletDumpS("\n", 1)
                res = CAD_Topo.FilletEdgesSequential(solid, CAD_Topo_FPlex.vert_buf, count, r)
                IfCondition EqualTo(res, 0) ThenBlock: { ReturnValue(0) }
            }
            s_idx = Add(s_idx, 1)
        }

        // PASS 2: Dispatch non-SEQUENTIAL segments (EMIT_CHAIN, CYL_RIM, etc.)
        s_idx = 0
        WhileLoop LessThan(s_idx, CAD_Topo_FPlex.seg_count) {
            base = Multiply(s_idx, 4)
            start_nd = ArrayGet(CAD_Topo_FPlex.segs, base)
            count = ArrayGet(CAD_Topo_FPlex.segs, Add(base, 2))
            method = ArrayGet(CAD_Topo_FPlex.segs, Add(base, 3))

            IfCondition NotEqual(method, 1) ThenBlock: {
                PrintMessage("fillet plex dispatch pass2 seg ")
                PrintNumber(s_idx)
                PrintMessage(" method=")
                PrintNumber(method)
                PrintMessage(" count=")
                PrintNumber(count)
                PrintMessage("\n")

                Branch method {
                    Case 2: {
                        // Sharp circles plus lines, or lines between arcs.
                        // -1 falls through. 0 is a matched miss: do not
                        // also emit-chain. Subtract stays out of the compare.
                        miss = Subtract(0, 1)
                        res = CAD_Topo.FilletPlexArcSharp(solid, r)
                        IfCondition EqualTo(res, miss) ThenBlock: {
                            CAD_Topo_State.fillet_class = 99
                            CAD_Topo_FComp.hfilt = 0
                            res = CAD_Topo.FilletEmitChain(solid, r)
                            IfCondition EqualTo(res, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo_State.fillet_reason, 22) ThenBlock: {
                                    res = CAD_Topo.FilletEmitSplitHosts(solid, r)
                                }
                            }
                        }
                    }
                    Case 3: {
                        res = CAD_Topo.FilletJoinFoot3(solid, r)
                    }
                    Case 4: {
                        // Closed all-circle loop. A pad of sharp arcs is
                        // the same vertex walk. A real cylinder rim is G1
                        // or closed and falls through to the rim fillet.
                        miss = Subtract(0, 1)
                        res = CAD_Topo.FilletPlexArcSharp(solid, r)
                        IfCondition EqualTo(res, miss) ThenBlock: {
                            e = Plex.Get(start_nd, 0)
                            res = CAD_Blend.FilletCylTopRim(solid, e, r)
                        }
                    }
                    Case 5: {
                        e = Plex.Get(start_nd, 0)
                        res = CAD_Blend.FilletCylBottomRim(solid, e, r)
                    }
                    Case 6: {
                        e = Plex.Get(start_nd, 0)
                        em = CAD_Topo.FilletEmitPlaneCyl(solid, e, r)
                        IfCondition NotEqual(em, 0) ThenBlock: {
                            res = em
                        } ElseBlock: {
                            // Reason 28 or 29 refused before any vertex. The
                            // boss cove would still sew a cap that has no width.
                            res = 0
                            IfCondition NotEqual(CAD_Topo_State.fillet_reason, 28) ThenBlock: {
                                IfCondition NotEqual(CAD_Topo_State.fillet_reason, 29) ThenBlock: {
                                    res = CAD_Blend.FilletPlaneCylJoin(solid, e, r)
                                }
                            }
                        }
                    }
                    Case 7: {
                        e = Plex.Get(start_nd, 0)
                        nH = count
                        res = CAD_Topo.FilletPlaneEdgesDigon(solid, e, nH, r)
                    }
                    Case 8: {
                        e = Plex.Get(start_nd, 0)
                        nH = count
                        res = CAD_Topo.FilletJoinCoveCycle(solid, e, nH, r)
                    }
                    Case 9: {
                        // Pass 1 may have noted other corners. This edge
                        // is alone (nsel=1). Do not inherit that count.
                        CAD_Topo.FilletVertReset()
                        e = Plex.Get(start_nd, 0)
                        res = CAD_Topo.FilletEdgeLocal(solid, e, r)
                        IfCondition NotEqual(res, 0) ThenBlock: {
                            CAD_Topo.FilletPlexResolveNotch(res)
                        }
                    }
                    Case 10: {
                        // RAIL_ARC: never assigned. Same emit as Case 9:
                        // FilletEdgeLocal. FilletPlexRailArcShift is not
                        // called from EdgeLocal (zero product-path call sites).
                        e = Plex.Get(start_nd, 0)
                        res = CAD_Topo.FilletEdgeLocal(solid, e, r)
                    }
                    Default: {
                        res = 0
                    }
                }
                IfCondition EqualTo(res, 0) ThenBlock: { ReturnValue(0) }
            }
            s_idx = Add(s_idx, 1)
        }

        ReturnValue(res)
    }
}

