// CAD.Topo.FilletRetarget — vertex retargeting for fillet junctions.
// RetargetWallLoops:        walk wall-face loops, retarget non-fillet edges.
// RetargetCopeVerticalEdge: retarget the retained vertical corner edge below
//                           a Steinmetz cope curve without corrupting the
//                           host wall loop.
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.RetargetWallLoops {
    Input: i: Integer
    Input: jclass: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(jclass, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, i)
        IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.k = Subtract(i, 1)
        IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
        CAD_Topo_FCove.f1 = CAD_Topo.FCoveGet(48, CAD_Topo_FCove.k)
        IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.which = CAD_Topo.FCoveGet(276, i)
        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.f2, 1)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.j = 0
        WhileLoop LessThan(CAD_Topo_FCove.j, 64) {
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.j = 64 }
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    IfCondition LessThan(CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: {
                            CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.e, CAD_Topo_FCove.v0, CAD_Topo_FCove.which)
                        }
                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0) ThenBlock: {
                            CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.e, CAD_Topo_FCove.v0, CAD_Topo_FCove.which)
                        }
                    }
                }
                CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.j = 64 }
            }
            CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
        }
        IfCondition NotEqual(CAD_Topo_FCove.f1, CAD_Topo_FCove.f2) ThenBlock: {
            CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.f1, 1)
            IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
                CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
                CAD_Topo_FCove.j = 0
                WhileLoop LessThan(CAD_Topo_FCove.j, 64) {
                    IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.j = 64 }
                    IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                        CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                        IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                            IfCondition LessThan(CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e), 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: {
                                    CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.e, CAD_Topo_FCove.v0, CAD_Topo_FCove.which)
                                }
                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0) ThenBlock: {
                                    CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.e, CAD_Topo_FCove.v0, CAD_Topo_FCove.which)
                                }
                            }
                        }
                        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                        IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.j = 64 }
                    }
                    CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
                }
            }
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.RetargetCopeVerticalEdge {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(468, i), 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(276, i)
        CAD_Topo_FCove.hit = CAD_Topo.FCoveGet(480, i)
        IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.k = Subtract(i, 1)
        IfCondition LessThan(CAD_Topo_FCove.k, 0) ThenBlock: { CAD_Topo_FCove.k = Subtract(CAD_Topo_FCove.n, 1) }
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
        IfCondition EqualTo(CAD_Topo_FCove.e, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1) }
        IfCondition EqualTo(CAD_Topo_FCove.v1, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, i)
        IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.f2, 1)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(1) }
        CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        CAD_Topo_FCove.hd = CAD_Topo_FCove.ce
        CAD_Topo_FCove.j = 0
        WhileLoop LessThan(CAD_Topo_FCove.j, 64) {
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: { CAD_Topo_FCove.j = 64 }
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    IfCondition LessThan(CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v1) ThenBlock: {
                                CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.e, CAD_Topo_FCove.v0, CAD_Topo_FCove.ok)
                            }
                        }
                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v1) ThenBlock: {
                                CAD_Topo.EdgeRetargetVert(CAD_Topo_FCove.e, CAD_Topo_FCove.v0, CAD_Topo_FCove.ok)
                            }
                        }
                    }
                }
                CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
                IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.j = 64 }
            }
            CAD_Topo_FCove.j = Add(CAD_Topo_FCove.j, 1)
        }
        ReturnValue(1)
    }
}
