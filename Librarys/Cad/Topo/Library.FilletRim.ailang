LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

// Class 8: outer top rim of a rounded-rect (LINE+ARC, convex).
// Cylinders on flats, quarter-tori on the 2D-fillet arcs. R < r_arc.
Function.CAD_Topo.FilletOuterRoundedRim {
    Input: solid_handle: Integer
    Input: horiz_addr: Address
    Input: n_horiz: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(horiz_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_horiz, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_horiz, 12) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.solid = CAD_Topo_FSeq.solid
        CAD_Topo_FCove.r = CAD_Topo_FSeq.r
        CAD_Topo_FCove.n = CAD_Topo_FSeq.nH
        CAD_Topo_FCove.shell = CAD_Store.Read(CAD_Topo_FCove.solid, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(CAD_Topo_FCove.n, 3) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo.FCoveSet(372, CAD_Topo_FCove.i, ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FCove.i))
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimOrder(), 0) ThenBlock: {
            PrintMessage("fillet outer-rim order FAIL\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo.RimFillHost(), 0) ThenBlock: {
            PrintMessage("fillet outer-rim host FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo.RimTagArcs()
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimSolveVert(CAD_Topo_FCove.i), 0) ThenBlock: {
                PrintMessage("fillet outer-rim vert FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimMakeSeg(CAD_Topo_FCove.i), 0) ThenBlock: {
                PrintMessage("fillet outer-rim seg FAIL i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimSwap(), 0) ThenBlock: {
            PrintMessage("fillet outer-rim swap FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveMakeJoinFace(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo.FilletSewDropTri(CAD_Topo_FCove.i)
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            PrintMessage("fillet inner-rim ok n=")
        }
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 0) ThenBlock: {
            PrintMessage("fillet outer-rim ok n=")
        }
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        ReturnValue(CAD_Topo_FCove.solid)
    }
}

// Fusion-style mixed outer rim: class-8 pipes (convex/concave arcs) plus
// Digon vertex spheres at LINE-LINE sharp corners.
Function.CAD_Topo.FilletMixedRim {
    Input: solid_handle: Integer
    Input: horiz_addr: Address
    Input: n_horiz: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(horiz_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_horiz, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_horiz, 12) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveEnsure(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.solid = CAD_Topo_FSeq.solid
        CAD_Topo_FCove.r = CAD_Topo_FSeq.r
        CAD_Topo_FCove.n = CAD_Topo_FSeq.nH
        CAD_Topo_FCove.shell = CAD_Store.Read(CAD_Topo_FCove.solid, 0)
        IfCondition EqualTo(CAD_Topo_FCove.shell, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo.FCoveSet(372, CAD_Topo_FCove.i, ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FCove.i))
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimOrder(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.RimFillHost(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.RimTagArcs()
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimSolveVert(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.MixFixSharp(), 0) ThenBlock: {
            PrintMessage("fillet mixed sharp FAIL\n")
            ReturnValue(0)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.RimMakeSeg(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.RimSwap(), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            IfCondition EqualTo(CAD_Topo.FCoveMakeJoinFace(CAD_Topo_FCove.i), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo.FilletSewDropTri(CAD_Topo_FCove.i)
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo.MixMakeSphere(), 0) ThenBlock: {
            PrintMessage("fillet mixed sphere FAIL\n")
            ReturnValue(0)
        }
        PrintMessage("fillet mixed-rim ok n=")
        PrintNumber(CAD_Topo_FCove.n)
        PrintMessage("\n")
        ReturnValue(CAD_Topo_FCove.solid)
    }
}

Function.CAD_Topo.RimFillHost {
    Output: Integer
    Body: {
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, 0)
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.host_f = ArrayGet(CAD_Topo_FCove.faces, 0)
        CAD_Topo_FCove.i = 0
        CAD_Topo_FCove.hit = 1
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.aa = ArrayGet(CAD_Topo_FCove.faces, 0)
            CAD_Topo_FCove.bb = ArrayGet(CAD_Topo_FCove.faces, 1)
            CAD_Topo_FCove.ok = 0
            IfCondition EqualTo(CAD_Topo_FCove.aa, CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.ok = 1 }
            IfCondition EqualTo(CAD_Topo_FCove.bb, CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.ok = 1 }
            IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { CAD_Topo_FCove.hit = 0 }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, 0)
            CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces)
            CAD_Topo_FCove.host_f = ArrayGet(CAD_Topo_FCove.faces, 1)
        }
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces)
            CAD_Topo_FCove.aa = ArrayGet(CAD_Topo_FCove.faces, 0)
            CAD_Topo_FCove.bb = ArrayGet(CAD_Topo_FCove.faces, 1)
            CAD_Topo_FCove.f2 = CAD_Topo_FCove.bb
            IfCondition EqualTo(CAD_Topo_FCove.bb, CAD_Topo_FCove.host_f) ThenBlock: { CAD_Topo_FCove.f2 = CAD_Topo_FCove.aa }
            CAD_Topo.FCoveSet(48, CAD_Topo_FCove.i, CAD_Topo_FCove.f2)
            CAD_Topo_FCove.kind = 1
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
            IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                CAD_Topo_FCove.kind = CAD_Store.Read(CAD_Topo_FCove.which, 0)
            }
            CAD_Topo.FCoveSet(24, CAD_Topo_FCove.i, CAD_Topo_FCove.kind)
            CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 1)
            CAD_Topo.FCoveSet(384, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(408, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(480, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(396, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(420, CAD_Topo_FCove.i, 0)
            CAD_Topo.FCoveSet(492, CAD_Topo_FCove.i, 0)
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.host_f, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n1x = ArrayGet(CAD_Topo_FCove.pl, 10)
        CAD_Topo_FCove.n1y = ArrayGet(CAD_Topo_FCove.pl, 11)
        CAD_Topo_FCove.n1z = ArrayGet(CAD_Topo_FCove.pl, 12)
        ReturnValue(1)
    }
}

// Host-face membership of the 2D arc centre: inside = convex r-R, else concave r+R.
Function.CAD_Topo.RimTagArcs {
    Output: Integer
    Body: {
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 1)
            IfCondition EqualTo(CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i), 2) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
                CAD_Topo_FCove.which = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                }
                IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                    ArraySet(CAD_Topo_FCove.pt, 0, CAD_Store.Read(CAD_Topo_FCove.which, 1))
                    ArraySet(CAD_Topo_FCove.pt, 1, CAD_Store.Read(CAD_Topo_FCove.which, 2))
                    ArraySet(CAD_Topo_FCove.pt, 2, CAD_Store.Read(CAD_Topo_FCove.which, 3))
                    IfCondition EqualTo(CAD_Topo.PointInFaceUV(CAD_Topo_FCove.host_f, CAD_Topo_FCove.pt), 0) ThenBlock: {
                        CAD_Topo.FCoveSet(36, CAD_Topo_FCove.i, 0)
                    }
                }
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

// Wall unit N of edge i at vertex vh. Plane is constant; cyl radial is at vh
// (toward axis when conv=0 ID). Always evaluate at the vertex being solved —
// a prev ARC's start is the other mouth, and those two radials look G1.
Function.CAD_Topo.RimWallN {
    Input: i: Integer
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.kind = CAD_Topo.FCoveGet(24, i)
        CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, i)
        CAD_Topo_FCove.n2x = 0
        CAD_Topo_FCove.n2y = 0
        CAD_Topo_FCove.n2z = 0
        IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
            IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCove.f2, CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.n2x = ArrayGet(CAD_Topo_FCove.pl, 10)
            CAD_Topo_FCove.n2y = ArrayGet(CAD_Topo_FCove.pl, 11)
            CAD_Topo_FCove.n2z = ArrayGet(CAD_Topo_FCove.pl, 12)
        }
        IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.which, 1)
            CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.which, 2)
            CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.which, 3)
            CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(vh, 0), CAD_Topo_FCove.cx)
            CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(vh, 1), CAD_Topo_FCove.cy)
            CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(vh, 2), CAD_Topo_FCove.cz)
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveGet(36, i), 0) ThenBlock: {
                    CAD_Topo_FCove.n2x = Float_Sub(CAD_Topo_FCove.cx, CAD_Store.Read(vh, 0))
                    CAD_Topo_FCove.n2y = Float_Sub(CAD_Topo_FCove.cy, CAD_Store.Read(vh, 1))
                    CAD_Topo_FCove.n2z = Float_Sub(CAD_Topo_FCove.cz, CAD_Store.Read(vh, 2))
                }
            }
        }
        CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ln)
        CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ln)
        // LINE: outward from a probe at the EDGE MIDPOINT. Probing at a
        // trihedral vertex (V or mouth) flips one wall and inverts the
        // sphere — degenerate corner + punched top. Cyl ID already uses
        // toward-axis; do not PointInSolid there.
        IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
            IfCondition NotEqual(CAD_Topo_FCove.solid, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.pt, 0) ThenBlock: {
                    CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
                    CAD_Topo_FCove.wa = 0
                    CAD_Topo_FCove.wb = 0
                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                        CAD_Topo_FCove.wa = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                        CAD_Topo_FCove.wb = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                    }
                    IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: {
                        IfCondition NotEqual(CAD_Topo_FCove.wb, 0) ThenBlock: {
                            CAD_Topo_FCove.ab = 0x3FE0000000000000
                            ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(Float_Mul(0x3FE0000000000000, Float_Add(CAD_Store.Read(CAD_Topo_FCove.wa, 0), CAD_Store.Read(CAD_Topo_FCove.wb, 0))), Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2x)))
                            ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(Float_Mul(0x3FE0000000000000, Float_Add(CAD_Store.Read(CAD_Topo_FCove.wa, 1), CAD_Store.Read(CAD_Topo_FCove.wb, 1))), Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2y)))
                            ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(Float_Mul(0x3FE0000000000000, Float_Add(CAD_Store.Read(CAD_Topo_FCove.wa, 2), CAD_Store.Read(CAD_Topo_FCove.wb, 2))), Float_Mul(CAD_Topo_FCove.ab, CAD_Topo_FCove.n2z)))
                            IfCondition EqualTo(CAD_Topo.PointInSolid(CAD_Topo_FCove.solid, CAD_Topo_FCove.pt), 1) ThenBlock: {
                                CAD_Topo_FCove.n2x = Float_Sub(0, CAD_Topo_FCove.n2x)
                                CAD_Topo_FCove.n2y = Float_Sub(0, CAD_Topo_FCove.n2y)
                                CAD_Topo_FCove.n2z = Float_Sub(0, CAD_Topo_FCove.n2z)
                            }
                        }
                    }
                }
            }
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.RimSolveVert {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo.FilletEmitLoadHostN(i)
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
        IfCondition EqualTo(CAD_Topo_FCove.v0, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
        CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
        CAD_Topo_FCove.hit = 0
        IfCondition GreaterEqual(CAD_Topo_FComp.h, 0) ThenBlock: {
            CAD_Topo_FCove.ok = 0
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: { CAD_Topo_FCove.ok = 6 }
            }
            CAD_Topo_FCove.orig = 14
            IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 15 }
            IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 1) ThenBlock: {
                ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.ok))
                ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 1)))
                ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 2)))
                CAD_Topo.FCoveSet(432, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
                ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 3)))
                ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 4)))
                ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 5)))
                CAD_Topo.FCoveSet(276, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
                CAD_Topo_FCove.ln = CAD_Topo_FCove.r
                IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
                CAD_Topo_FCove.cx = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.ok), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x))
                CAD_Topo_FCove.cy = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 1)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y))
                CAD_Topo_FCove.cz = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 2)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
                CAD_Topo_FCove.n2x = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 3)), CAD_Topo_FCove.cx)
                CAD_Topo_FCove.n2y = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 4)), CAD_Topo_FCove.cy)
                CAD_Topo_FCove.n2z = Float_Sub(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 5)), CAD_Topo_FCove.cz)
                CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
                    CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ab)
                    CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ab)
                    CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ab)
                    ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
                    ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
                    ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
                    ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
                    ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
                    ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
                    ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.n2x)
                    ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.n2y)
                    ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.n2z)
                    CAD_Topo_FCove.which = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
                    CAD_Topo.FCoveSet(288, i, CAD_Topo.MakeMinorArcEdge(CAD_Topo.FCoveGet(432, i), CAD_Topo.FCoveGet(276, i), CAD_Topo_FCove.which))
                    CAD_Topo_FCove.orig = 12
                    IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 13 }
                    // Gram marks a 3-edge corner. This chain has two edges
                    // here, so the corner stays the cope, not a sphere.
                    IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 1) ThenBlock: {
                        IfCondition GreaterThan(CAD_Topo.MixVertSelCount(CAD_Topo_FCove.v0), 2) ThenBlock: {
                            CAD_Topo.FCoveSet(384, i, 1)
                        }
                    }
                    CAD_Topo_FCove.hit = 1
                }
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FCoveGet(432, i), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo.FCoveGet(276, i), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Topo.FCoveGet(288, i), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        IfCondition EqualTo(CAD_Topo.RimWallN(i, CAD_Topo_FCove.v0), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ab = Float_Add(0x3FF0000000000000, Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.ab = Float_Div(CAD_Topo_FCove.r, CAD_Topo_FCove.ab)
        CAD_Topo_FCove.ln = CAD_Topo_FCove.r
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
        CAD_Topo_FCove.cx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 0), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n2x)))
        CAD_Topo_FCove.cy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 1), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n2y)))
        CAD_Topo_FCove.cz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.v0, 2), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n2z)))
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            CAD_Topo_FCove.cx = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 0), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1x, CAD_Topo_FCove.n2x)))
            CAD_Topo_FCove.cy = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 1), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1y, CAD_Topo_FCove.n2y)))
            CAD_Topo_FCove.cz = Float_Add(CAD_Store.Read(CAD_Topo_FCove.v0, 2), Float_Mul(CAD_Topo_FCove.ab, Float_Add(CAD_Topo_FCove.n1z, CAD_Topo_FCove.n2z)))
        }
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z)))
        CAD_Topo.FCoveSet(432, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        ArraySet(CAD_Topo_FCove.pt, 0, Float_Add(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n2x)))
        ArraySet(CAD_Topo_FCove.pt, 1, Float_Add(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n2y)))
        ArraySet(CAD_Topo_FCove.pt, 2, Float_Add(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n2z)))
        CAD_Topo.FCoveSet(276, i, CAD_Topo.MakeVertex(CAD_Topo_FCove.pt))
        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.n2x)
        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.n2y)
        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.n2z)
        CAD_Topo_FCove.which = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)
        CAD_Topo.FCoveSet(288, i, CAD_Topo.MakeMinorArcEdge(CAD_Topo.FCoveGet(432, i), CAD_Topo.FCoveGet(276, i), CAD_Topo_FCove.which))
        IfCondition EqualTo(CAD_Topo.FCoveGet(432, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(276, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(288, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.RimMakeSeg {
    Input: i: Integer
    Output: Integer
    Body: {
        CAD_Topo.FilletEmitLoadHostN(i)
        CAD_Topo_FCove.i = i
        CAD_Topo_FCove.k = Add(i, 1)
        IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
        CAD_Topo_FCove.hit = 0
        IfCondition NotEqual(CAD_Topo_FCove.k, i) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k), CAD_Store.Read(CAD_Topo_FCove.e, 0)) ThenBlock: { CAD_Topo_FCove.hit = 1 }
                IfCondition EqualTo(CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k), CAD_Store.Read(CAD_Topo_FCove.e, 1)) ThenBlock: { CAD_Topo_FCove.hit = 1 }
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
            CAD_Topo_FCove.f1 = CAD_Topo.FCoveGet(408, CAD_Topo_FCove.k)
            IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: { CAD_Topo_FCove.f1 = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k) }
            CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.k)
            IfCondition EqualTo(CAD_Topo_FCove.f2, 0) ThenBlock: { CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k) }
            CAD_Topo_FCove.wa = CAD_Topo.FCoveSharedCap(CAD_Topo_FCove.i, CAD_Topo_FCove.k)
            IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: { CAD_Topo_FCove.f2 = CAD_Topo_FCove.wa }
            IfCondition EqualTo(CAD_Topo.FCoveHostWallFlip(i, CAD_Topo_FCove.k), 1) ThenBlock: {
                CAD_Topo_FCove.wa = CAD_Topo_FCove.f1
                CAD_Topo_FCove.f1 = CAD_Topo_FCove.f2
                CAD_Topo_FCove.f2 = CAD_Topo_FCove.wa
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
            CAD_Topo_FCove.v1 = 0
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo.FCoveGet(12, i)) ThenBlock: { CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1) }
            }
            CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
            CAD_Topo_FCove.ok = 0
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v1) ThenBlock: { CAD_Topo_FCove.ok = 6 }
            }
            CAD_Topo_FCove.orig = 14
            IfCondition EqualTo(CAD_Topo_FCove.ok, 6) ThenBlock: { CAD_Topo_FCove.orig = 15 }
            IfCondition EqualTo(CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.orig), 1) ThenBlock: {
                ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, CAD_Topo_FCove.ok))
                ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 1)))
                ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 2)))
                CAD_Topo_FCove.f1 = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
                ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 3)))
                ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 4)))
                ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo.FilletIRVSolGet(CAD_Topo_FComp.h, Add(CAD_Topo_FCove.ok, 5)))
                CAD_Topo_FCove.f2 = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
            }
            IfCondition EqualTo(CAD_Topo_FCove.f1, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FilletIRVert2Face(CAD_Topo_FComp.h, CAD_Topo_FCove.v1), 1) ThenBlock: {
                    ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo_FComp.px)
                    ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo_FComp.py)
                    ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo_FComp.pz)
                    CAD_Topo_FCove.f1 = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
                    ArraySet(CAD_Topo_FCove.pt, 0, CAD_Topo_FComp.cx)
                    ArraySet(CAD_Topo_FCove.pt, 1, CAD_Topo_FComp.cy)
                    ArraySet(CAD_Topo_FCove.pt, 2, CAD_Topo_FComp.cz)
                    CAD_Topo_FCove.f2 = CAD_Topo.MakeVertex(CAD_Topo_FCove.pt)
                }
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.FilletSplitLineCorner(i, CAD_Topo_FCove.k), 1) ThenBlock: {
                CAD_Topo_FCove.wa = CAD_Topo.FilletOwnFarTw(i)
                IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: {
                    CAD_Topo_FCove.f2 = CAD_Topo_FCove.wa
                }
            }
            // Second flip arm lands the host rail on k's drop. That drop
            // is not on this host. End the rail on this edge's own far Th.
            CAD_Topo_FCove.wa = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.k)
            IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FCove.f1, CAD_Topo_FCove.wa) ThenBlock: {
                    CAD_Topo_FCove.wa = CAD_Topo.FilletOwnFarTh(i)
                    IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: {
                        CAD_Topo_FCove.f1 = CAD_Topo_FCove.wa
                    }
                }
            }
        }
        CAD_Topo_FCove.kind = CAD_Topo.FCoveGet(24, i)
        IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
            CAD_Topo.FCoveSet(312, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(432, i), CAD_Topo_FCove.f1))
            // A line-line ball (slot 492) trims the wall rail to the Tw
            // points. The far end is the next edge's other-wall Tw.
            CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(276, i)
            CAD_Topo_FCove.v1 = CAD_Topo_FCove.f2
            IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FCoveGet(492, CAD_Topo_FCove.k), 0) ThenBlock: {
                    CAD_Topo_FCove.v1 = CAD_Topo.FCoveGet(492, CAD_Topo_FCove.k)
                }
            }
            IfCondition EqualTo(CAD_Topo.FCoveGet(492, i), 0) ThenBlock: {
                CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(480, i)
                IfCondition EqualTo(CAD_Topo_FCove.orig, 0) ThenBlock: { CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(276, i) }
                CAD_Topo_FCove.wa = CAD_Topo.FCoveSharedCapPrev(CAD_Topo_FCove.i)
                IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: { CAD_Topo_FCove.orig = CAD_Topo_FCove.wa }
            }
            CAD_Topo.FCoveSet(324, i, CAD_Topo.FCoveMakeLineE(CAD_Topo_FCove.orig, CAD_Topo_FCove.v1))
            CAD_Topo_FCove.v0 = CAD_Topo.FCoveGet(12, i)
            IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)
                IfCondition NotEqual(CAD_Topo_FCove.v0, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0))
                        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1))
                        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2))
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
                CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(432, i)
                IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(12, i) }
                CAD_Topo_FCove.ok1 = CAD_Topo_FCove.f1
                IfCondition EqualTo(CAD_Topo_FCove.ok1, 0) ThenBlock: { CAD_Topo_FCove.ok1 = CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k) }
                IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.ok1, 0) ThenBlock: {
                        CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok1, 0), CAD_Store.Read(CAD_Topo_FCove.ok, 0))
                        CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok1, 1), CAD_Store.Read(CAD_Topo_FCove.ok, 1))
                        CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok1, 2), CAD_Store.Read(CAD_Topo_FCove.ok, 2))
                    }
                }
            }
            CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 0) ThenBlock: {
                CAD_Topo_FCove.edx = Float_Div(CAD_Topo_FCove.edx, CAD_Topo_FCove.ln)
                CAD_Topo_FCove.edy = Float_Div(CAD_Topo_FCove.edy, CAD_Topo_FCove.ln)
                CAD_Topo_FCove.edz = Float_Div(CAD_Topo_FCove.edz, CAD_Topo_FCove.ln)
            }
            CAD_Topo_FCove.ln = CAD_Topo_FCove.r
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(432, i)
            IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(12, i) }
            IfCondition EqualTo(CAD_Topo_FCove.ok, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.cx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 0), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x))
            CAD_Topo_FCove.cy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 1), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y))
            CAD_Topo_FCove.cz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 2), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
            ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
            ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
            ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
            ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
            ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
            ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
            CAD_Topo_FCove.aa = Float_Sub(Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.n1z), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.n1y))
            CAD_Topo_FCove.bb = Float_Sub(Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.n1x), Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.n1z))
            CAD_Topo_FCove.ln = Float_Sub(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.n1y), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.n1x))
            CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.aa, CAD_Topo_FCove.aa), Float_Mul(CAD_Topo_FCove.bb, CAD_Topo_FCove.bb)), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.ln)))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
                CAD_Topo_FCove.aa = Float_Div(CAD_Topo_FCove.aa, CAD_Topo_FCove.ab)
                CAD_Topo_FCove.bb = Float_Div(CAD_Topo_FCove.bb, CAD_Topo_FCove.ab)
                CAD_Topo_FCove.ln = Float_Div(CAD_Topo_FCove.ln, CAD_Topo_FCove.ab)
            }
            ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.aa)
            ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.bb)
            ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.ln)
            ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FCove.edx)
            ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FCove.edy)
            ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FCove.edz)
            CAD_Topo.FCoveSet(300, CAD_Topo_FCove.i, CAD_Geom.MakeCylinderSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.r))
            CAD_Topo.FCoveSet(348, CAD_Topo_FCove.i, CAD_Topo.FCoveGet(288, CAD_Topo_FCove.i))
            IfCondition NotEqual(CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveGet(492, CAD_Topo_FCove.i), 0) ThenBlock: {
                    // Shared-face rail already meets at Tw. Keep the Th–Tw
                    // arc. The drop digon does not touch that vertex.
                    CAD_Topo_FCove.wa = CAD_Topo.FCoveSharedCapPrev(CAD_Topo_FCove.i)
                    IfCondition EqualTo(CAD_Topo_FCove.wa, 0) ThenBlock: {
                        CAD_Topo.FCoveSet(348, CAD_Topo_FCove.i, CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i))
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.f1, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.f2, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i), 0) ThenBlock: {
                            CAD_Topo.FCoveSet(396, CAD_Topo_FCove.i, CAD_Topo.FilletMerThrough(CAD_Topo_FCove.f1, CAD_Topo_FCove.f2))
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: {
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, i)
            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
            IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FCove.cx = CAD_Store.Read(CAD_Topo_FCove.which, 1)
            CAD_Topo_FCove.cy = CAD_Store.Read(CAD_Topo_FCove.which, 2)
            CAD_Topo_FCove.cz = CAD_Store.Read(CAD_Topo_FCove.which, 3)
            CAD_Topo_FCove.aa = CAD_Store.Read(CAD_Topo_FCove.which, 10)
            CAD_Topo_FCove.orig = CAD_Topo_FCove.r
            IfCondition EqualTo(CAD_Topo.FCoveGet(36, i), 0) ThenBlock: { CAD_Topo_FCove.orig = Float_Sub(0, CAD_Topo_FCove.r) }
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.orig = Float_Sub(0, CAD_Topo_FCove.r) }
            CAD_Topo_FCove.ab = Float_Sub(CAD_Topo_FCove.aa, CAD_Topo_FCove.orig)
            PrintMessage("fillet rim arc i=")
            PrintNumber(i)
            PrintMessage(" conv=")
            PrintNumber(CAD_Topo.FCoveGet(36, i))
            PrintMessage(" r2=")
            PrintNumber(Float_ToInt(CAD_Topo_FCove.aa))
            PrintMessage(" Rmaj=")
            PrintNumber(Float_ToInt(CAD_Topo_FCove.ab))
            PrintMessage("\n")
            IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.orig), 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCove.ab), 1) ThenBlock: {
                    CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.ab)
                    IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.ln, 0x3FA999999999999A), 1) ThenBlock: {
                        CAD_Topo_FCove.ab = 0
                    }
                    IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.ln, 0x3FA999999999999A), 0) ThenBlock: {
                        CAD_Topo_State.fillet_reason = 6
                        ReturnValue(0)
                    }
                }
            }
            CAD_Topo_FCove.s = CAD_Topo_FCove.r
            IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.s = Float_Sub(0, CAD_Topo_FCove.r) }
            ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
            ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
            ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
            ArraySet(CAD_Topo_FCove.frame, 3, CAD_Store.Read(CAD_Topo_FCove.which, 4))
            ArraySet(CAD_Topo_FCove.frame, 4, CAD_Store.Read(CAD_Topo_FCove.which, 5))
            ArraySet(CAD_Topo_FCove.frame, 5, CAD_Store.Read(CAD_Topo_FCove.which, 6))
            ArraySet(CAD_Topo_FCove.frame, 6, CAD_Store.Read(CAD_Topo_FCove.which, 7))
            ArraySet(CAD_Topo_FCove.frame, 7, CAD_Store.Read(CAD_Topo_FCove.which, 8))
            ArraySet(CAD_Topo_FCove.frame, 8, CAD_Store.Read(CAD_Topo_FCove.which, 9))
            // Host circle through the SOLVE T_host, not r±R. Rank-3 mouths
            // sit off the 2-face offset; a circle they are not on tessellates
            // as a sharp original rim / planar chord.
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(432, i)
            IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 0), CAD_Topo_FCove.cx)
                CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 1), CAD_Topo_FCove.cy)
                CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 2), CAD_Topo_FCove.cz)
                CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 0) ThenBlock: { CAD_Topo_FCove.ab = CAD_Topo_FCove.ln }
            }
            PrintMessage("fillet rim hostR=")
            PrintNumber(Float_ToInt(CAD_Topo_FCove.ab))
            PrintMessage("\n")
            // R == r: T_host is the arc centre. A circle of radius 0
            // has no angle. A zero-length line still shares the next
            // Th handle so the top loop stays closed.
            CAD_Topo_FCove.ok1 = 0
            IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCove.ab, 0x3FA999999999999A), 1) ThenBlock: {
                CAD_Topo.FCoveSet(312, i, CAD_Topo.FCoveMakeLineE(CAD_Topo.FCoveGet(432, i), CAD_Topo_FCove.f1))
                CAD_Topo_FCove.ab = 0
                CAD_Topo_FCove.ok1 = 1
            }
            IfCondition EqualTo(CAD_Topo_FCove.ok1, 0) ThenBlock: {
                CAD_Topo_FCove.ln = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab)
                CAD_Topo.FCoveSet(312, i, CAD_Topo.FilletEmitArcRail(CAD_Topo.FCoveGet(432, i), CAD_Topo_FCove.f1, CAD_Topo_FCove.ln, CAD_Topo_FCove.which, CAD_Topo_FCove.e, CAD_Topo.FCoveGet(12, i)))
            }
            ArraySet(CAD_Topo_FCove.frame, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1x)))
            ArraySet(CAD_Topo_FCove.frame, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1y)))
            ArraySet(CAD_Topo_FCove.frame, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1z)))
            CAD_Topo_FCove.v1 = CAD_Topo_FCove.f2
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(276, i)
            IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                CAD_Topo_FCove.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 0), ArrayGet(CAD_Topo_FCove.frame, 0))
                CAD_Topo_FCove.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 1), ArrayGet(CAD_Topo_FCove.frame, 1))
                CAD_Topo_FCove.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.ok, 2), ArrayGet(CAD_Topo_FCove.frame, 2))
                CAD_Topo_FCove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.edx, CAD_Topo_FCove.edx), Float_Mul(CAD_Topo_FCove.edy, CAD_Topo_FCove.edy)), Float_Mul(CAD_Topo_FCove.edz, CAD_Topo_FCove.edz)))
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ln, 0), 0) ThenBlock: { CAD_Topo_FCove.aa = CAD_Topo_FCove.ln }
            }
            CAD_Topo_FCove.bb = CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.aa)
            CAD_Topo.FCoveSet(324, i, CAD_Topo.FilletEmitArcRail(CAD_Topo.FCoveGet(276, i), CAD_Topo_FCove.v1, CAD_Topo_FCove.bb, CAD_Topo_FCove.which, CAD_Topo_FCove.e, CAD_Topo.FCoveGet(12, i)))
            // A line host is 8 words. Slot 12 is the circle span only.
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
                CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(312, i)
                CAD_Topo_FCove.orig = CAD_Topo.FCoveGet(324, i)
                IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
                        CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.ok, 2)
                        CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.orig, 2)
                        IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Topo_FCove.orig, 0) ThenBlock: {
                                CAD_Store.Write(CAD_Topo_FCove.orig, 12, CAD_Store.Read(CAD_Topo_FCove.ok, 12))
                            }
                        }
                    }
                }
            }
            ArraySet(CAD_Topo_FCove.frame, 0, Float_Sub(CAD_Topo_FCove.cx, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1x)))
            ArraySet(CAD_Topo_FCove.frame, 1, Float_Sub(CAD_Topo_FCove.cy, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1y)))
            ArraySet(CAD_Topo_FCove.frame, 2, Float_Sub(CAD_Topo_FCove.cz, Float_Mul(CAD_Topo_FCove.s, CAD_Topo_FCove.n1z)))
            ArraySet(CAD_Topo_FCove.frame, 9, CAD_Topo_FCove.n1x)
            ArraySet(CAD_Topo_FCove.frame, 10, CAD_Topo_FCove.n1y)
            ArraySet(CAD_Topo_FCove.frame, 11, CAD_Topo_FCove.n1z)
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 1) ThenBlock: {
                CAD_Topo.FCoveSet(300, i, CAD_Geom.MakeSphereSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.r))
            }
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
                CAD_Topo.FCoveSet(300, i, CAD_Geom.MakeTorusSurf(CAD_Topo_FCove.frame, CAD_Topo_FCove.ab, CAD_Topo_FCove.r))
            }
            CAD_Topo.FCoveSet(348, i, CAD_Topo.FCoveGet(288, i))
            IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.f1, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.f2, 0) ThenBlock: {
                        // Same mer as RimSolveVert: C = T_host − ln N_host.
                        CAD_Topo_FCove.ln = CAD_Topo_FCove.r
                        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: { CAD_Topo_FCove.ln = Float_Sub(0, CAD_Topo_FCove.r) }
                        CAD_Topo_FCove.cx = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 0), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1x))
                        CAD_Topo_FCove.cy = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 1), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1y))
                        CAD_Topo_FCove.cz = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f1, 2), Float_Mul(CAD_Topo_FCove.ln, CAD_Topo_FCove.n1z))
                        CAD_Topo_FCove.n2x = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f2, 0), CAD_Topo_FCove.cx)
                        CAD_Topo_FCove.n2y = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f2, 1), CAD_Topo_FCove.cy)
                        CAD_Topo_FCove.n2z = Float_Sub(CAD_Store.Read(CAD_Topo_FCove.f2, 2), CAD_Topo_FCove.cz)
                        CAD_Topo_FCove.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FCove.n2x, CAD_Topo_FCove.n2x), Float_Mul(CAD_Topo_FCove.n2y, CAD_Topo_FCove.n2y)), Float_Mul(CAD_Topo_FCove.n2z, CAD_Topo_FCove.n2z)))
                        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCove.ab, 0), 0) ThenBlock: {
                            CAD_Topo_FCove.n2x = Float_Div(CAD_Topo_FCove.n2x, CAD_Topo_FCove.ab)
                            CAD_Topo_FCove.n2y = Float_Div(CAD_Topo_FCove.n2y, CAD_Topo_FCove.ab)
                            CAD_Topo_FCove.n2z = Float_Div(CAD_Topo_FCove.n2z, CAD_Topo_FCove.ab)
                        }
                        ArraySet(CAD_Topo_FCove.frame, 0, CAD_Topo_FCove.cx)
                        ArraySet(CAD_Topo_FCove.frame, 1, CAD_Topo_FCove.cy)
                        ArraySet(CAD_Topo_FCove.frame, 2, CAD_Topo_FCove.cz)
                        ArraySet(CAD_Topo_FCove.frame, 3, CAD_Topo_FCove.n1x)
                        ArraySet(CAD_Topo_FCove.frame, 4, CAD_Topo_FCove.n1y)
                        ArraySet(CAD_Topo_FCove.frame, 5, CAD_Topo_FCove.n1z)
                        ArraySet(CAD_Topo_FCove.frame, 6, CAD_Topo_FCove.n2x)
                        ArraySet(CAD_Topo_FCove.frame, 7, CAD_Topo_FCove.n2y)
                        ArraySet(CAD_Topo_FCove.frame, 8, CAD_Topo_FCove.n2z)
                        CAD_Topo.FCoveSet(396, i, CAD_Topo.MakeMinorArcEdge(CAD_Topo_FCove.f1, CAD_Topo_FCove.f2, CAD_Geom.MakeCircle(CAD_Topo_FCove.frame, CAD_Topo_FCove.r)))
                    }
                }
            }
        }
        IfCondition EqualTo(CAD_Topo.FCoveGet(312, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(324, i), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FCoveGet(300, i), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.CAD_Topo.RimSwap {
    Output: Integer
    Body: {
        CAD_Topo_FSeq.h = CAD_Topo_FCove.solid
        CAD_Topo_FCove.i = 0
        WhileLoop LessThan(CAD_Topo_FCove.i, CAD_Topo_FCove.n) {
            // Each edge keeps the face IR slot 19 names. Springs sit on
            // the side walls; the chain host is only the fallback.
            CAD_Topo_FCove.f1 = CAD_Topo_FCove.host_f
            CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
            CAD_Topo_FComp.h = CAD_Topo.FilletIRIndexOf(CAD_Topo_FCove.e)
            IfCondition GreaterEqual(CAD_Topo_FComp.h, 0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 19), 0) ThenBlock: {
                    CAD_Topo_FCove.f1 = CAD_Topo.FilletIRGet(CAD_Topo_FComp.h, 19)
                }
            }
            CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f1, CAD_Topo_FCove.e)
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: {
                PrintMessage("fillet swap miss i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            CAD_Topo_FCove.which = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)
            CAD_Topo_FCove.k = Add(CAD_Topo_FCove.i, 1)
            IfCondition EqualTo(CAD_Topo_FCove.k, CAD_Topo_FCove.n) ThenBlock: { CAD_Topo_FCove.k = 0 }
            CAD_Topo_FCove.hit1 = CAD_Topo.FCoveHostWallFlip(CAD_Topo_FCove.i, CAD_Topo_FCove.k)
            IfCondition EqualTo(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FCove.hit1, 1) ThenBlock: {
                    CAD_Topo_FCove.which = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.k)
                    IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.which = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k) }
                    CAD_Topo_FCove.wa = CAD_Topo.FCoveSharedCap(CAD_Topo_FCove.i, CAD_Topo_FCove.k)
                    IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: { CAD_Topo_FCove.which = CAD_Topo_FCove.wa }
                }
                IfCondition EqualTo(CAD_Topo_FCove.hit1, 0) ThenBlock: {
                    CAD_Topo_FCove.which = CAD_Topo.FCoveGet(408, CAD_Topo_FCove.k)
                    IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.which = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k) }
                }
            }
            // Open chain: the far vertex is not the next edge's start.
            // Keep the coedge aimed the way the old loop ran.
            CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i), 0)
            IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i)) ThenBlock: {
                CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i), 1)
            }
            IfCondition EqualTo(CAD_Topo_FCove.orig, CAD_Topo_FCove.v0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.k, CAD_Topo_FCove.i) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)) ThenBlock: {
                    CAD_Topo_FCove.e = CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i)
                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                        IfCondition EqualTo(CAD_Topo_FCove.which, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)) ThenBlock: {
                            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                        }
                    }
                }
                }
            }
            // Host rail was pulled off the drop onto this edge's far Th.
            // Aim the coedge at that same end, or the loop starts at the drop.
            IfCondition EqualTo(CAD_Topo_FCove.hit1, 1) ThenBlock: {
                CAD_Topo_FCove.wa = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.k)
                IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo_FCove.which, CAD_Topo_FCove.wa) ThenBlock: {
                        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i)
                        IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                            IfCondition EqualTo(CAD_Topo_FCove.which, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)) ThenBlock: {
                                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i), CAD_Topo_FCove.which), 0) ThenBlock: {
                PrintMessage("fillet swap host i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.f2 = CAD_Topo.FCoveGet(48, CAD_Topo_FCove.i)
            CAD_Topo_FCove.ce = CAD_Topo.FindCoedgeOnFace(CAD_Topo_FCove.f2, CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i))
            IfCondition EqualTo(CAD_Topo_FCove.ce, 0) ThenBlock: {
                PrintMessage("fillet swap wall i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.ce, 5)
            CAD_Topo_FCove.which = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)
            IfCondition EqualTo(CAD_Topo.FCoveGet(492, CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo_FCove.which = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.i)
                IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.which = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i) }
                CAD_Topo_FCove.wa = CAD_Topo.FCoveSharedCapPrev(CAD_Topo_FCove.i)
                IfCondition NotEqual(CAD_Topo_FCove.wa, 0) ThenBlock: { CAD_Topo_FCove.which = CAD_Topo_FCove.wa }
            }
            IfCondition EqualTo(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FCove.hit1, 1) ThenBlock: {
                    CAD_Topo_FCove.which = CAD_Topo.FCoveGet(408, CAD_Topo_FCove.k)
                    IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.which = CAD_Topo.FCoveGet(432, CAD_Topo_FCove.k) }
                }
                IfCondition EqualTo(CAD_Topo_FCove.hit1, 0) ThenBlock: {
                    CAD_Topo_FCove.which = CAD_Topo.FCoveGet(492, CAD_Topo_FCove.k)
                    IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: {
                        CAD_Topo_FCove.which = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.k)
                        IfCondition EqualTo(CAD_Topo_FCove.which, 0) ThenBlock: { CAD_Topo_FCove.which = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.k) }
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo.FilletSplitLineCorner(CAD_Topo_FCove.i, CAD_Topo_FCove.k), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FCove.hit1, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)) ThenBlock: {
                        CAD_Topo_FCove.e = CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i)
                        CAD_Topo_FCove.ok1 = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i)
                        IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                            IfCondition EqualTo(CAD_Topo_FCove.which, CAD_Topo_FCove.ok1) ThenBlock: {
                                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.orig, CAD_Topo_FCove.v0) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.k, CAD_Topo_FCove.i) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.orig, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.k)) ThenBlock: {
                    CAD_Topo_FCove.e = CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i)
                    CAD_Topo_FCove.ok1 = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.i)
                    IfCondition EqualTo(CAD_Topo_FCove.ok1, 0) ThenBlock: { CAD_Topo_FCove.ok1 = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i) }
                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                        CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                        IfCondition EqualTo(CAD_Topo_FCove.which, CAD_Topo_FCove.ok1) ThenBlock: {
                            CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                        }
                    }
                }
                }
            }
            IfCondition EqualTo(CAD_Topo.CoedgeSwapEdge(CAD_Topo_FCove.ce, CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i), CAD_Topo_FCove.which), 0) ThenBlock: {
                PrintMessage("fillet swap wall-edge i=")
                PrintNumber(CAD_Topo_FCove.i)
                PrintMessage("\n")
                ReturnValue(0)
            }
            CAD_Topo_FCove.wb = CAD_Topo.FCoveGet(480, CAD_Topo_FCove.i)
            IfCondition EqualTo(CAD_Topo_FCove.wb, 0) ThenBlock: { CAD_Topo_FCove.wb = CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i) }
            // No cope on a split-host line: Tw is off the vertical.
            // Retarget to the corner so the generator stays put.
            CAD_Topo_FCove.ok1 = CAD_Topo_FCove.wb
            IfCondition NotEqual(CAD_Topo_FComp.hfilt, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveGet(480, CAD_Topo_FCove.i), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i), 1) ThenBlock: {
                        CAD_Topo_FCove.wb = CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i)
                    }
                }
            }
            CAD_Topo.FaceRetargetVert(CAD_Topo_FCove.f2, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i), CAD_Topo_FCove.wb, CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i))
            CAD_Topo_FCove.wb = CAD_Topo_FCove.ok1
            // Arc far end. The next edge is the tangent line, and that
            // line keeps the corner so a sharp vertical is not pulled
            // off its generator. The arc's own wall rail already ends
            // at the far Tw, which lies on the generator.
            IfCondition EqualTo(CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i), 2) ThenBlock: {
                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
                CAD_Topo_FCove.v0 = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                    IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i)) ThenBlock: {
                        CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                    }
                }
                CAD_Topo_FCove.e = CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i)
                CAD_Topo_FCove.v1 = 0
                IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                    CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                    IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.wb) ThenBlock: {
                        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                    }
                }
                IfCondition NotEqual(CAD_Topo_FCove.v0, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Topo_FCove.v1, 0) ThenBlock: {
                        CAD_Topo.FaceRetargetVert(CAD_Topo_FCove.f2, CAD_Topo_FCove.v0, CAD_Topo_FCove.v1, CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i))
                    }
                }
            }
            CAD_Topo_FCove.ok = CAD_Topo.FCoveGet(408, CAD_Topo_FCove.i)
            CAD_Topo_FCove.hit = 1
            IfCondition NotEqual(CAD_Topo_FCove.ok, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.FCoveGet(384, CAD_Topo_FCove.i), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FCoveVertEq(CAD_Topo_FCove.ok, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)), 0) ThenBlock: {
                        CAD_Topo_FCove.hit = 0
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                CAD_Topo.FaceRetargetVert(CAD_Topo_FCove.f1, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i))
            }
            CAD_Topo_FCove.sn = CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i)
            IfCondition NotEqual(CAD_Topo_FCove.sn, 0) ThenBlock: {
                // Cope and sphere curves touch the start Th. The far cap of
                // an open vertical does not: sew that end into the bottom.
                CAD_Topo_FCove.ok1 = 0
                IfCondition NotEqual(CAD_Topo.FCoveEdgeHasVert(CAD_Topo_FCove.sn, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)), 0) ThenBlock: { CAD_Topo_FCove.ok1 = 1 }
                IfCondition EqualTo(CAD_Topo_FCove.ok1, 1) ThenBlock: {
                    CAD_Topo.FilletRailsMeetLineTo(CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i), CAD_Topo_FCove.wb)
                }
                IfCondition EqualTo(CAD_Topo_FCove.ok1, 0) ThenBlock: {
                    CAD_Topo_FCove.e = CAD_Topo.FCoveGet(0, CAD_Topo_FCove.i)
                    CAD_Topo_FCove.v0 = 0
                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                        CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                        IfCondition EqualTo(CAD_Topo_FCove.v0, CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i)) ThenBlock: {
                            CAD_Topo_FCove.v0 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                        }
                    }
                    CAD_Topo_FCove.e = CAD_Topo.FCoveGet(312, CAD_Topo_FCove.i)
                    CAD_Topo_FCove.ok = 0
                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                        CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                        IfCondition EqualTo(CAD_Topo_FCove.ok, CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i)) ThenBlock: {
                            CAD_Topo_FCove.ok = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                        }
                    }
                    CAD_Topo_FCove.e = CAD_Topo.FCoveGet(324, CAD_Topo_FCove.i)
                    CAD_Topo_FCove.v1 = 0
                    IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                        CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                        IfCondition EqualTo(CAD_Topo_FCove.v1, CAD_Topo_FCove.wb) ThenBlock: {
                            CAD_Topo_FCove.v1 = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                        }
                    }
                    CAD_Topo_FSeq.aa = CAD_Topo_FCove.host_f
                    CAD_Topo_FCove.host_f = CAD_Topo_FCove.f1
                    CAD_Topo.FilletSewOpenEnd(CAD_Topo_FCove.v0, CAD_Topo_FCove.ok, CAD_Topo_FCove.v1, CAD_Topo_FCove.sn, CAD_Topo.FCoveGet(48, CAD_Topo_FCove.i))
                    CAD_Topo_FCove.host_f = CAD_Topo_FSeq.aa
                }
            }
            IfCondition EqualTo(CAD_Topo.FCoveGet(396, CAD_Topo_FCove.i), 0) ThenBlock: {
                // Same corners: open-end sew would pull the vertical to Tw.
                CAD_Topo_FCove.hit = 1
                IfCondition NotEqual(CAD_Topo_FComp.hfilt, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FCoveGet(480, CAD_Topo_FCove.i), 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.FCoveGet(24, CAD_Topo_FCove.i), 1) ThenBlock: {
                            CAD_Topo_FCove.hit = 0
                        }
                    }
                }
                IfCondition EqualTo(CAD_Topo_FCove.hit, 1) ThenBlock: {
                    CAD_Topo_FSeq.aa = CAD_Topo_FCove.host_f
                    CAD_Topo_FCove.host_f = CAD_Topo_FCove.f1
                    CAD_Topo.FilletSewOpenEnd(CAD_Topo.FCoveGet(12, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(432, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(276, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(288, CAD_Topo_FCove.i), CAD_Topo.FCoveGet(48, CAD_Topo_FCove.i))
                    CAD_Topo_FCove.host_f = CAD_Topo_FSeq.aa
                }
            }
            IfCondition NotEqual(CAD_Topo.FCoveGet(492, CAD_Topo_FCove.i), 0) ThenBlock: {
                CAD_Topo.MixCopeClose(CAD_Topo_FCove.i)
            }
            CAD_Topo_FCove.i = Add(CAD_Topo_FCove.i, 1)
        }
        ReturnValue(1)
    }
}

