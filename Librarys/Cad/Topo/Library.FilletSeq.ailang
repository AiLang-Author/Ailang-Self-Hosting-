// CAD.Topo.Digon2 / FilletSeq part FilletSeq
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.FilletEdgesSequential {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.solid = solid_handle
        CAD_Topo_FSeq.n = n_edges
        CAD_Topo_FSeq.r = radius_r
        IfCondition EqualTo(CAD_Topo_FSeq.sigs, 0) ThenBlock: { CAD_Topo_FSeq.sigs = Allocate(4096) }
        IfCondition EqualTo(CAD_Topo_FSeq.pack, 0) ThenBlock: { CAD_Topo_FSeq.pack = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.sigs, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.i = 0
        CAD_Topo_FVert.n = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            ArraySet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i), ArrayGet(edges_addr, CAD_Topo_FSeq.i))
            CAD_Topo_FSeq.e = ArrayGet(edges_addr, CAD_Topo_FSeq.i)
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                CAD_Topo_FSeq.k = CAD_Store.Read(CAD_Topo_FSeq.e, 0)
                IfCondition NotEqual(CAD_Topo_FSeq.k, 0) ThenBlock: {
                    CAD_Topo.FilletVertNote(CAD_Store.Read(CAD_Topo_FSeq.k, 0), CAD_Store.Read(CAD_Topo_FSeq.k, 1), CAD_Store.Read(CAD_Topo_FSeq.k, 2))
                }
                CAD_Topo_FSeq.k = CAD_Store.Read(CAD_Topo_FSeq.e, 1)
                IfCondition NotEqual(CAD_Topo_FSeq.k, 0) ThenBlock: {
                    CAD_Topo.FilletVertNote(CAD_Store.Read(CAD_Topo_FSeq.k, 0), CAD_Store.Read(CAD_Topo_FSeq.k, 1), CAD_Store.Read(CAD_Topo_FSeq.k, 2))
                }
            }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i))
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.EdgeSigFill(CAD_Topo_FSeq.e, CAD_Topo_FSeq.pack), 0) ThenBlock: {
                    CAD_Topo_FSeq.k = 0
                    WhileLoop LessThan(CAD_Topo_FSeq.k, 12) {
                        ArraySet(CAD_Topo_FSeq.sigs, Add(Multiply(CAD_Topo_FSeq.i, 12), CAD_Topo_FSeq.k), ArrayGet(CAD_Topo_FSeq.pack, CAD_Topo_FSeq.k))
                        CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
                    }
                }
            }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        CAD_Topo_FSeq.h = CAD_Topo_FSeq.solid
        CAD_Topo_FSeq.ok = 0
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            CAD_Topo_FSeq.k = 0
            WhileLoop LessThan(CAD_Topo_FSeq.k, 12) {
                ArraySet(CAD_Topo_FSeq.pack, CAD_Topo_FSeq.k, ArrayGet(CAD_Topo_FSeq.sigs, Add(Multiply(CAD_Topo_FSeq.i, 12), CAD_Topo_FSeq.k)))
                CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
            }
            // Live edge on the current solid (midpoint tie-break).
            // Stale pick handle after a join Digon is the wrong body.
            CAD_Topo_FSeq.e = CAD_Topo.FindEdgeBySig(CAD_Topo_FSeq.h, CAD_Topo_FSeq.pack)
            IfCondition EqualTo(CAD_Topo_FSeq.e, 0) ThenBlock: {
                CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i))
            }
            CAD_Topo_FSeq.nh = 0
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                CAD_Topo_FSeq.k = CAD_Store.Read(CAD_Topo_FSeq.e, 2)
                IfCondition NotEqual(CAD_Topo_FSeq.k, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FSeq.k, 0), 1) ThenBlock: {
                        CAD_Topo_FSeq.e = 0
                    }
                }
            }
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                CAD_Topo_FSeq.nh = CAD_Topo.FilletPlanePlaneEdge(CAD_Topo_FSeq.h, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r)
            }
            IfCondition NotEqual(CAD_Topo_FSeq.nh, 0) ThenBlock: {
                CAD_Topo_FSeq.h = CAD_Topo_FSeq.nh
                CAD_Topo_FSeq.ok = Add(CAD_Topo_FSeq.ok, 1)
                PrintMessage("fillet sequential ok i=")
                PrintNumber(CAD_Topo_FSeq.i)
                PrintMessage("\n")
            }
            IfCondition EqualTo(CAD_Topo_FSeq.nh, 0) ThenBlock: {
                PrintMessage("fillet sequential miss i=")
                PrintNumber(CAD_Topo_FSeq.i)
                PrintMessage("\n")
            }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        PrintMessage("fillet sequential done n=")
        PrintNumber(CAD_Topo_FSeq.ok)
        PrintMessage("\n")
        IfCondition EqualTo(CAD_Topo_FSeq.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FilletVerticesAfter(CAD_Topo_FSeq.h, CAD_Topo_FSeq.r)
        ReturnValue(CAD_Topo_FSeq.h)
    }
}

// OUTER coplanar cycle → Digon (prism cap). INNER cycle (pad join)
// → sequential local cove. Isolated edges (verticals) → sequential.
// End cap: outer-loop plane; prefer |N·D| large, else the side wall.
Function.CAD_Topo.FilletPlaneEdges {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_edges, 12) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(n_edges, 1) ThenBlock: {
            ReturnValue(CAD_Topo.FilletPlanePlaneEdge(solid_handle, ArrayGet(edges_addr, 0), radius_r))
        }
        // Split same-Z rims (Digon cycle) from verticals (sequential local).
        // A mixed 4-top+4-vertical batch used to skip Digon and sequential-
        // inset the cap into a trapezoid (brokenprojection.png).
        IfCondition EqualTo(CAD_Topo_FSeq.horiz, 0) ThenBlock: { CAD_Topo_FSeq.horiz = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.vert, 0) ThenBlock: { CAD_Topo_FSeq.vert = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.horiz, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.r = radius_r
        CAD_Topo_FSeq.solid = solid_handle
        CAD_Topo_FSeq.nH = 0
        CAD_Topo_FSeq.nV = 0
        CAD_Topo_FSeq.i = 0
        PrintMessage("fillet PlaneEdges n=")
        PrintNumber(n_edges)
        PrintMessage("\n")
        WhileLoop LessThan(CAD_Topo_FSeq.i, n_edges) {
            ei = ArrayGet(edges_addr, CAD_Topo_FSeq.i)
            dz = 0
            IfCondition NotEqual(ei, 0) ThenBlock: {
                va = CAD_Store.Read(ei, 0)
                vb = CAD_Store.Read(ei, 1)
                IfCondition NotEqual(va, 0) ThenBlock: {
                    IfCondition NotEqual(vb, 0) ThenBlock: {
                        dz = Float_Sub(CAD_Store.Read(vb, 2), CAD_Store.Read(va, 2))
                        IfCondition EqualTo(CAD_Num.IsNeg(dz), 1) ThenBlock: { dz = Float_Sub(0, dz) }
                    }
                }
            }
            IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 1) ThenBlock: {
                ArraySet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.nH, ei)
                CAD_Topo_FSeq.nH = Add(CAD_Topo_FSeq.nH, 1)
            }
            IfCondition EqualTo(CAD_Num.IsZero(dz, 0), 0) ThenBlock: {
                ArraySet(CAD_Topo_FSeq.vert, CAD_Topo_FSeq.nV, ei)
                CAD_Topo_FSeq.nV = Add(CAD_Topo_FSeq.nV, 1)
            }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        PrintMessage("fillet nH=")
        PrintNumber(CAD_Topo_FSeq.nH)
        PrintMessage(" nV=")
        PrintNumber(CAD_Topo_FSeq.nV)
        PrintMessage("\n")
        CAD_Topo_FSeq.h = solid_handle
        IfCondition GreaterEqual(CAD_Topo_FSeq.nH, 3) ThenBlock: {
            shared = 0
            CAD_Topo_FSeq.i = 0
            WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.nH) {
                ei = ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.i)
                v0 = CAD_Store.Read(ei, 0)
                v1 = CAD_Store.Read(ei, 1)
                CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.i, 1)
                WhileLoop LessThan(CAD_Topo_FSeq.k, CAD_Topo_FSeq.nH) {
                    ej = ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.k)
                    u0 = CAD_Store.Read(ej, 0)
                    u1 = CAD_Store.Read(ej, 1)
                    IfCondition EqualTo(v0, u0) ThenBlock: { shared = 1 }
                    IfCondition EqualTo(v0, u1) ThenBlock: { shared = 1 }
                    IfCondition EqualTo(v1, u0) ThenBlock: { shared = 1 }
                    IfCondition EqualTo(v1, u1) ThenBlock: { shared = 1 }
                    CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
                }
                CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
            }
            IfCondition EqualTo(shared, 1) ThenBlock: {
                // Digon rebuilds an OUTER prism cap. An inner join cycle
                // (pad-on-face) is a hole — Digon cove turned it into the
                // diamond trench (hotmess.png). Sequential local cove
                // keeps the host outer and fillets the four gutters.
                CAD_Topo_FSeq.k = 0
                CAD_Topo_FSeq.i = 0
                WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.nH) {
                    IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.i)), 1) ThenBlock: {
                        CAD_Topo_FSeq.k = 1
                    }
                    CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
                }
                IfCondition EqualTo(CAD_Topo_FSeq.k, 1) ThenBlock: {
                    PrintMessage("fillet path=seq inner-join nH=")
                    PrintNumber(CAD_Topo_FSeq.nH)
                    PrintMessage("\n")
                    shared = 0
                }
                IfCondition GreaterThan(CAD_Topo.SolidCountShells(CAD_Topo_FSeq.solid), 1) ThenBlock: {
                    PrintMessage("fillet path=seq multi-shell\n")
                    shared = 0
                }
            }
            IfCondition EqualTo(shared, 1) ThenBlock: {
                PrintMessage("fillet path=digon horiz n=")
                PrintNumber(CAD_Topo_FSeq.nH)
                PrintMessage(" nV=")
                PrintNumber(CAD_Topo_FSeq.nV)
                PrintMessage("\n")
                // Pin vertical signatures before Digon kills their handles.
                IfCondition GreaterThan(CAD_Topo_FSeq.nV, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo_FSeq.sigs, 0) ThenBlock: { CAD_Topo_FSeq.sigs = Allocate(4096) }
                    IfCondition EqualTo(CAD_Topo_FSeq.pack, 0) ThenBlock: { CAD_Topo_FSeq.pack = Allocate(128) }
                    CAD_Topo_FSeq.i = 0
                    WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.nV) {
                        IfCondition EqualTo(CAD_Topo.EdgeSigFill(ArrayGet(CAD_Topo_FSeq.vert, CAD_Topo_FSeq.i), CAD_Topo_FSeq.pack), 0) ThenBlock: {
                            CAD_Topo_FSeq.k = 0
                            WhileLoop LessThan(CAD_Topo_FSeq.k, 12) {
                                ArraySet(CAD_Topo_FSeq.sigs, Add(Multiply(CAD_Topo_FSeq.i, 12), CAD_Topo_FSeq.k), ArrayGet(CAD_Topo_FSeq.pack, CAD_Topo_FSeq.k))
                                CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
                            }
                        }
                        CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
                    }
                }
                dig = CAD_Topo.FilletPlaneEdgesDigon(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.nH, CAD_Topo_FSeq.r)
                IfCondition NotEqual(dig, 0) ThenBlock: {
                    CAD_Topo_FSeq.h = dig
                    IfCondition EqualTo(CAD_Topo_FSeq.nV, 0) ThenBlock: { ReturnValue(dig) }
                    PrintMessage("fillet path=seq verticals n=")
                    PrintNumber(CAD_Topo_FSeq.nV)
                    PrintMessage("\n")
                    CAD_Topo_FSeq.i = 0
                    WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.nV) {
                        CAD_Topo_FSeq.k = 0
                        WhileLoop LessThan(CAD_Topo_FSeq.k, 12) {
                            ArraySet(CAD_Topo_FSeq.pack, CAD_Topo_FSeq.k, ArrayGet(CAD_Topo_FSeq.sigs, Add(Multiply(CAD_Topo_FSeq.i, 12), CAD_Topo_FSeq.k)))
                            CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
                        }
                        ArraySet(CAD_Topo_FSeq.vert, CAD_Topo_FSeq.i, CAD_Topo.FindEdgeBySig(CAD_Topo_FSeq.h, CAD_Topo_FSeq.pack))
                        CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
                    }
                    seq = CAD_Topo.FilletEdgesSequential(CAD_Topo_FSeq.h, CAD_Topo_FSeq.vert, CAD_Topo_FSeq.nV, CAD_Topo_FSeq.r)
                    IfCondition NotEqual(seq, 0) ThenBlock: { ReturnValue(seq) }
                    ReturnValue(CAD_Topo_FSeq.h)
                }
                PrintMessage("digon FAIL — no seq on a cycle\n")
                ReturnValue(0)
            }
        }
        ReturnValue(CAD_Topo.FilletEdgesSequential(solid_handle, edges_addr, n_edges, radius_r))
    }
}
