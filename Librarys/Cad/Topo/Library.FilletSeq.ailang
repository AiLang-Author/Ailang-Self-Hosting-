LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Err

Function.CAD_Topo.FilletJoinVertHit {
    Input: vh: Integer
    Input: idx: Integer
    Input: off: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vh, 0), CAD_Topo.FilletIRVSolGet(idx, off), 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vh, 1), CAD_Topo.FilletIRVSolGet(idx, Add(off, 1)), 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vh, 2), CAD_Topo.FilletIRVSolGet(idx, Add(off, 2)), 0), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Equal-R cylinder–cylinder seam: Steinmetz ellipse, not a sphere.
// Called from Local when the end cap is already a previous blend (no plane).
Function.CAD_Topo.FilletRetargetHostEnd {
    Input: face_h: Integer
    Input: old_v: Integer
    Input: new_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_v, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.lp = CAD_Store.Read(face_h, 1)
        IfCondition EqualTo(CAD_Topo_FLoc.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.lp, 0)
        CAD_Topo_FLoc.hd = CAD_Topo_FLoc.ce
        CAD_Topo_FSeq.k = 0
        WhileLoop LessThan(CAD_Topo_FSeq.k, 16) {
            IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: { CAD_Topo_FSeq.k = 16 }
            IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.ce, 5), old_v) ThenBlock: {
                    CAD_Topo_FSeq.e = CAD_Store.Read(CAD_Topo_FLoc.ce, 0)
                    IfCondition NotEqual(CAD_Topo_FSeq.e, CAD_Topo_FLoc.edge) ThenBlock: {
                        IfCondition LessThan(CAD_Topo.FilletIRIndexOf(CAD_Topo_FSeq.e), 0) ThenBlock: {
                            CAD_Topo.EdgeRetargetVert(CAD_Topo_FSeq.e, old_v, new_v)
                        }
                    }
                }
                CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.ce, 2)
                IfCondition EqualTo(CAD_Topo_FLoc.ce, CAD_Topo_FLoc.hd) ThenBlock: { CAD_Topo_FSeq.k = 16 }
            }
            CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletLocalJoinPrev {
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

Function.CAD_Topo.FilletRailsMeet {
    Input: solid_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FVert.n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_State.digon_S, 0) ThenBlock: { CAD_Topo_State.digon_S = Allocate(4096) }
        IfCondition EqualTo(CAD_Topo_State.digon_S, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.frame, 0) ThenBlock: { CAD_Topo_FLoc.frame = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FLoc.pt, 0) ThenBlock: { CAD_Topo_FLoc.pt = Allocate(32) }
        CAD_Topo_FVert.ii = 0
        WhileLoop LessThan(CAD_Topo_FVert.ii, CAD_Topo_FVert.n) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_FVert.cnt, CAD_Topo_FVert.ii), 2) ThenBlock: {
                CAD_Topo_FVert.px = ArrayGet(CAD_Topo_FVert.xyz, Multiply(CAD_Topo_FVert.ii, 3))
                CAD_Topo_FVert.py = ArrayGet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.ii, 3), 1))
                CAD_Topo_FVert.pz = ArrayGet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.ii, 3), 2))
                CAD_Topo.FilletRailsMeetAt()
            }
            CAD_Topo_FVert.ii = Add(CAD_Topo_FVert.ii, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletRailsMeetLineTo {
    Input: old_v: Integer
    Input: new_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(old_v, new_v) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FSeq.h, 0)
        CAD_Topo_FCE.sg = 0
        WhileLoop NotEqual(CAD_Topo_FCE.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FCE.sg, 64) ThenBlock: { CAD_Topo_FCE.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FCE.sh, 0) ThenBlock: {
                CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.sh, 0)
                CAD_Topo_FCE.fg = 0
                WhileLoop NotEqual(CAD_Topo_FCE.face, 0) {
                    IfCondition GreaterThan(CAD_Topo_FCE.fg, 4096) ThenBlock: { CAD_Topo_FCE.face = 0 }
                    IfCondition NotEqual(CAD_Topo_FCE.face, 0) ThenBlock: {
                        CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.face, 1)
                        IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                            CAD_Topo_FCE.ce = CAD_Store.Read(CAD_Topo_FCE.lp, 0)
                            CAD_Topo_FCE.hd = CAD_Topo_FCE.ce
                            CAD_Topo_FCE.g = 0
                            WhileLoop LessThan(CAD_Topo_FCE.g, 16) {
                                IfCondition EqualTo(CAD_Topo_FCE.ce, 0) ThenBlock: { CAD_Topo_FCE.g = 16 }
                                IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: {
                                    CAD_Topo_FCE.edge = CAD_Store.Read(CAD_Topo_FCE.ce, 0)
                                    nxt = CAD_Store.Read(CAD_Topo_FCE.ce, 2)
                                    IfCondition NotEqual(CAD_Topo_FCE.edge, 0) ThenBlock: {
                                        CAD_Topo_FCE.vert = CAD_Store.Read(CAD_Topo_FCE.edge, 2)
                                        IfCondition NotEqual(CAD_Topo_FCE.vert, 0) ThenBlock: {
                                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.vert, 0), 1) ThenBlock: {
                                                CAD_Topo.EdgeRetargetVert(CAD_Topo_FCE.edge, old_v, new_v)
                                            }
                                        }
                                    }
                                    CAD_Topo_FCE.ce = nxt
                                    IfCondition EqualTo(CAD_Topo_FCE.ce, CAD_Topo_FCE.hd) ThenBlock: { CAD_Topo_FCE.g = 16 }
                                }
                                CAD_Topo_FCE.g = Add(CAD_Topo_FCE.g, 1)
                            }
                        }
                        CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.face, 3)
                    }
                    CAD_Topo_FCE.fg = Add(CAD_Topo_FCE.fg, 1)
                }
                CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FCE.sh, 2)
            }
            CAD_Topo_FCE.sg = Add(CAD_Topo_FCE.sg, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletRailsMeetPin {
    Output: Integer
    Body: {
        CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FSeq.h, 0)
        CAD_Topo_FCE.sg = 0
        WhileLoop NotEqual(CAD_Topo_FCE.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FCE.sg, 64) ThenBlock: { CAD_Topo_FCE.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FCE.sh, 0) ThenBlock: {
                CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.sh, 0)
                CAD_Topo_FCE.fg = 0
                WhileLoop NotEqual(CAD_Topo_FCE.face, 0) {
                    IfCondition GreaterThan(CAD_Topo_FCE.fg, 4096) ThenBlock: { CAD_Topo_FCE.face = 0 }
                    IfCondition NotEqual(CAD_Topo_FCE.face, 0) ThenBlock: {
                        CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.face, 1)
                        IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                            CAD_Topo_FCE.ce = CAD_Store.Read(CAD_Topo_FCE.lp, 0)
                            CAD_Topo_FCE.hd = CAD_Topo_FCE.ce
                            CAD_Topo_FCE.g = 0
                            WhileLoop LessThan(CAD_Topo_FCE.g, 16) {
                                IfCondition EqualTo(CAD_Topo_FCE.ce, 0) ThenBlock: { CAD_Topo_FCE.g = 16 }
                                IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: {
                                    CAD_Topo_FCE.edge = CAD_Store.Read(CAD_Topo_FCE.ce, 0)
                                    nxt = CAD_Store.Read(CAD_Topo_FCE.ce, 2)
                                    IfCondition NotEqual(CAD_Topo_FCE.edge, 0) ThenBlock: {
                                        CAD_Topo_FCE.vert = CAD_Store.Read(CAD_Topo_FCE.edge, 2)
                                        IfCondition NotEqual(CAD_Topo_FCE.vert, 0) ThenBlock: {
                                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.vert, 0), 1) ThenBlock: {
                                                CAD_Topo_FCE.ok = CAD_Store.Read(CAD_Topo_FCE.edge, 0)
                                                CAD_Topo.FilletRailsMeetPinVert(CAD_Topo_FCE.edge, CAD_Topo_FCE.ok)
                                                CAD_Topo_FCE.ok = CAD_Store.Read(CAD_Topo_FCE.edge, 1)
                                                CAD_Topo.FilletRailsMeetPinVert(CAD_Topo_FCE.edge, CAD_Topo_FCE.ok)
                                            }
                                        }
                                    }
                                    CAD_Topo_FCE.ce = nxt
                                    IfCondition EqualTo(CAD_Topo_FCE.ce, CAD_Topo_FCE.hd) ThenBlock: { CAD_Topo_FCE.g = 16 }
                                }
                                CAD_Topo_FCE.g = Add(CAD_Topo_FCE.g, 1)
                            }
                        }
                        CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.face, 3)
                    }
                    CAD_Topo_FCE.fg = Add(CAD_Topo_FCE.fg, 1)
                }
                CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FCE.sh, 2)
            }
            CAD_Topo_FCE.sg = Add(CAD_Topo_FCE.sg, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletRailsMeetPinVert {
    Input: edge_h: Integer
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vh, CAD_Topo_FLoc.v0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vh, CAD_Topo_FLoc.sn) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.VertSamePos(vh, CAD_Topo_FLoc.v0), 1) ThenBlock: {
            ReturnValue(CAD_Topo.EdgeRetargetVert(edge_h, vh, CAD_Topo_FLoc.v0))
        }
        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vh, 0), CAD_Topo_FVert.px, 0), 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vh, 1), CAD_Topo_FVert.py, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(vh, 2), CAD_Topo_FVert.pz, 0), 1) ThenBlock: {
                    ReturnValue(CAD_Topo.EdgeRetargetVert(edge_h, vh, CAD_Topo_FLoc.v0))
                }
            }
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.FilletRailsMeetAt {
    Output: Integer
    Body: {
        CAD_Topo_FLoc.aa = 0
        CAD_Topo_FLoc.bb = 0
        CAD_Topo_FLoc.cyl = 0
        CAD_Topo_FLoc.ar = 0
        CAD_Topo_FLoc.ei = 0
        CAD_Topo_FLoc.lp = CAD_Store.Read(CAD_Topo_FSeq.h, 0)
        CAD_Topo_FLoc.ln = 0
        WhileLoop NotEqual(CAD_Topo_FLoc.lp, 0) {
            IfCondition GreaterThan(CAD_Topo_FLoc.ln, 64) ThenBlock: { CAD_Topo_FLoc.lp = 0 }
            IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                CAD_Topo_FLoc.endf = CAD_Store.Read(CAD_Topo_FLoc.lp, 0)
                CAD_Topo_FLoc.which = 0
                WhileLoop NotEqual(CAD_Topo_FLoc.endf, 0) {
                    IfCondition GreaterThan(CAD_Topo_FLoc.which, 4096) ThenBlock: { CAD_Topo_FLoc.endf = 0 }
                    IfCondition NotEqual(CAD_Topo_FLoc.endf, 0) ThenBlock: {
                        CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Topo_FLoc.endf, 0)
                        IfCondition NotEqual(CAD_Topo_FLoc.vv, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FLoc.vv, 0), 2) ThenBlock: {
                                CAD_Topo_FLoc.hd = CAD_Store.Read(CAD_Topo_FLoc.endf, 1)
                                IfCondition NotEqual(CAD_Topo_FLoc.hd, 0) ThenBlock: {
                                    CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.hd, 0)
                                    CAD_Topo_FSeq.e = CAD_Topo_FLoc.ce
                                    CAD_Topo_FSeq.k = 0
                                    WhileLoop LessThan(CAD_Topo_FSeq.k, 8) {
                                        IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: { CAD_Topo_FSeq.k = 8 }
                                        IfCondition NotEqual(CAD_Topo_FLoc.ce, 0) ThenBlock: {
                                            CAD_Topo_FLoc.ab = CAD_Store.Read(CAD_Topo_FLoc.ce, 0)
                                            IfCondition NotEqual(CAD_Topo_FLoc.ab, 0) ThenBlock: {
                                                CAD_Topo_FSeq.nV = CAD_Store.Read(CAD_Topo_FLoc.ab, 2)
                                                IfCondition NotEqual(CAD_Topo_FSeq.nV, 0) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FSeq.nV, 0), 2) ThenBlock: {
                                                        CAD_Topo_FSeq.nH = 0
                                                        CAD_Topo_FLoc.v0 = CAD_Store.Read(CAD_Topo_FLoc.ab, 0)
                                                        CAD_Topo_FLoc.v1 = CAD_Store.Read(CAD_Topo_FLoc.ab, 1)
                                                        IfCondition NotEqual(CAD_Topo_FLoc.v0, 0) ThenBlock: {
                                                            CAD_Topo_FLoc.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v0, 0), CAD_Topo_FVert.px)
                                                            CAD_Topo_FLoc.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v0, 1), CAD_Topo_FVert.py)
                                                            CAD_Topo_FLoc.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v0, 2), CAD_Topo_FVert.pz)
                                                            CAD_Topo_FLoc.sn = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.edz)))
                                                            IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FLoc.sn, Float_Add(CAD_Topo_FSeq.r, CAD_Topo_FSeq.r)), 1) ThenBlock: { CAD_Topo_FSeq.nH = 1 }
                                                        }
                                                        IfCondition EqualTo(CAD_Topo_FSeq.nH, 0) ThenBlock: {
                                                            IfCondition NotEqual(CAD_Topo_FLoc.v1, 0) ThenBlock: {
                                                                CAD_Topo_FLoc.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Topo_FVert.px)
                                                                CAD_Topo_FLoc.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Topo_FVert.py)
                                                                CAD_Topo_FLoc.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Topo_FVert.pz)
                                                                CAD_Topo_FLoc.sn = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.edz)))
                                                                IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FLoc.sn, Float_Add(CAD_Topo_FSeq.r, CAD_Topo_FSeq.r)), 1) ThenBlock: { CAD_Topo_FSeq.nH = 1 }
                                                            }
                                                        }
                                                        IfCondition EqualTo(CAD_Topo_FSeq.nH, 1) ThenBlock: {
                                                            IfCondition EqualTo(CAD_Topo_FLoc.aa, 0) ThenBlock: {
                                                                CAD_Topo_FLoc.aa = CAD_Topo_FLoc.ce
                                                                CAD_Topo_FLoc.cyl = CAD_Topo_FLoc.ab
                                                                CAD_Topo_FLoc.ei = 1
                                                            }
                                                            IfCondition NotEqual(CAD_Topo_FLoc.aa, 0) ThenBlock: {
                                                                IfCondition NotEqual(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.cyl) ThenBlock: {
                                                                    IfCondition EqualTo(CAD_Topo_FLoc.bb, 0) ThenBlock: {
                                                                        CAD_Topo_FLoc.bb = CAD_Topo_FLoc.ce
                                                                        CAD_Topo_FLoc.ar = CAD_Topo_FLoc.ab
                                                                        CAD_Topo_FLoc.ei = 2
                                                                    }
                                                                    IfCondition NotEqual(CAD_Topo_FLoc.bb, 0) ThenBlock: {
                                                                        IfCondition NotEqual(CAD_Topo_FLoc.ab, CAD_Topo_FLoc.ar) ThenBlock: {
                                                                            CAD_Topo_FLoc.ei = 3
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            IfCondition LessThan(CAD_Topo_FSeq.k, 8) ThenBlock: {
                                                CAD_Topo_FLoc.ce = CAD_Store.Read(CAD_Topo_FLoc.ce, 2)
                                                IfCondition EqualTo(CAD_Topo_FLoc.ce, CAD_Topo_FSeq.e) ThenBlock: { CAD_Topo_FSeq.k = 8 }
                                            }
                                        }
                                        CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
                                    }
                                }
                            }
                        }
                        IfCondition NotEqual(CAD_Topo_FLoc.endf, 0) ThenBlock: {
                            CAD_Topo_FLoc.endf = CAD_Store.Read(CAD_Topo_FLoc.endf, 3)
                        }
                    }
                    CAD_Topo_FLoc.which = Add(CAD_Topo_FLoc.which, 1)
                }
                IfCondition NotEqual(CAD_Topo_FLoc.lp, 0) ThenBlock: {
                    CAD_Topo_FLoc.lp = CAD_Store.Read(CAD_Topo_FLoc.lp, 2)
                }
            }
            CAD_Topo_FLoc.ln = Add(CAD_Topo_FLoc.ln, 1)
        }
        IfCondition NotEqual(CAD_Topo_FLoc.ei, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.cyl, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FLoc.ar, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.v0 = CAD_Store.Read(CAD_Topo_FLoc.cyl, 0)
        CAD_Topo_FLoc.v1 = CAD_Store.Read(CAD_Topo_FLoc.cyl, 1)
        CAD_Topo_FSeq.e = CAD_Store.Read(CAD_Topo_FLoc.ar, 0)
        CAD_Topo_FLoc.hd = CAD_Store.Read(CAD_Topo_FLoc.ar, 1)
        IfCondition EqualTo(CAD_Topo_FLoc.v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FSeq.e, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.nH = 0
        IfCondition EqualTo(CAD_Topo.VertSamePos(CAD_Topo_FLoc.v0, CAD_Topo_FSeq.e), 1) ThenBlock: { CAD_Topo_FSeq.nH = 1 }
        IfCondition EqualTo(CAD_Topo.VertSamePos(CAD_Topo_FLoc.v0, CAD_Topo_FLoc.hd), 1) ThenBlock: { CAD_Topo_FSeq.nH = 1 }
        IfCondition EqualTo(CAD_Topo_FSeq.nH, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo.VertSamePos(CAD_Topo_FLoc.v1, CAD_Topo_FSeq.e), 1) ThenBlock: { CAD_Topo_FSeq.nH = 2 }
            IfCondition EqualTo(CAD_Topo.VertSamePos(CAD_Topo_FLoc.v1, CAD_Topo_FLoc.hd), 1) ThenBlock: { CAD_Topo_FSeq.nH = 2 }
        }
        IfCondition EqualTo(CAD_Topo_FSeq.nH, 2) ThenBlock: {
            CAD_Topo_FLoc.sn = CAD_Topo_FLoc.v0
            CAD_Topo_FLoc.v0 = CAD_Topo_FLoc.v1
            CAD_Topo_FLoc.v1 = CAD_Topo_FLoc.sn
            CAD_Topo_FSeq.nH = 1
        }
        IfCondition EqualTo(CAD_Topo_FSeq.nH, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.VertSamePos(CAD_Topo_FSeq.e, CAD_Topo_FLoc.v0), 1) ThenBlock: {
            CAD_Topo_FSeq.e = CAD_Topo_FLoc.hd
        }
        CAD_Topo_FLoc.hd = CAD_Topo_FSeq.e
        IfCondition EqualTo(CAD_Topo_FLoc.hd, 0) ThenBlock: { ReturnValue(0) }
        // Steinmetz far point: pa + pb − P. Center: sn + v_common − P.
        ArraySet(CAD_Topo_FLoc.pt, 0, Float_Sub(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v1, 0), CAD_Store.Read(CAD_Topo_FLoc.hd, 0)), CAD_Topo_FVert.px))
        ArraySet(CAD_Topo_FLoc.pt, 1, Float_Sub(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v1, 1), CAD_Store.Read(CAD_Topo_FLoc.hd, 1)), CAD_Topo_FVert.py))
        ArraySet(CAD_Topo_FLoc.pt, 2, Float_Sub(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.v1, 2), CAD_Store.Read(CAD_Topo_FLoc.hd, 2)), CAD_Topo_FVert.pz))
        CAD_Topo_FLoc.sn = CAD_Topo.MakeVertex(CAD_Topo_FLoc.pt)
        IfCondition EqualTo(CAD_Topo_FLoc.sn, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FLoc.frame, 0, Float_Sub(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.sn, 0), CAD_Store.Read(CAD_Topo_FLoc.v0, 0)), CAD_Topo_FVert.px))
        ArraySet(CAD_Topo_FLoc.frame, 1, Float_Sub(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.sn, 1), CAD_Store.Read(CAD_Topo_FLoc.v0, 1)), CAD_Topo_FVert.py))
        ArraySet(CAD_Topo_FLoc.frame, 2, Float_Sub(Float_Add(CAD_Store.Read(CAD_Topo_FLoc.sn, 2), CAD_Store.Read(CAD_Topo_FLoc.v0, 2)), CAD_Topo_FVert.pz))
        CAD_Topo_FLoc.edx = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.sn, 0), CAD_Store.Read(CAD_Topo_FLoc.v0, 0))
        CAD_Topo_FLoc.edy = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.sn, 1), CAD_Store.Read(CAD_Topo_FLoc.v0, 1))
        CAD_Topo_FLoc.edz = Float_Sub(CAD_Store.Read(CAD_Topo_FLoc.sn, 2), CAD_Store.Read(CAD_Topo_FLoc.v0, 2))
        CAD_Topo_FLoc.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FLoc.edx, CAD_Topo_FLoc.edx), Float_Mul(CAD_Topo_FLoc.edy, CAD_Topo_FLoc.edy)), Float_Mul(CAD_Topo_FLoc.edz, CAD_Topo_FLoc.edz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FLoc.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.ab = CAD_Topo.MakeEqualRDigonEdge(CAD_Topo_FLoc.v0, CAD_Topo_FLoc.sn, CAD_Topo_FLoc.frame, CAD_Topo_FLoc.frame, CAD_Topo_FLoc.frame, CAD_Topo_FSeq.r)
        IfCondition EqualTo(CAD_Topo_FLoc.ab, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FilletRailsMeetLineTo(CAD_Topo_FLoc.v1, CAD_Topo_FLoc.sn)
        CAD_Topo.FilletRailsMeetLineTo(CAD_Topo_FLoc.hd, CAD_Topo_FLoc.sn)
        CAD_Topo.FilletRailsMeetPin()
        CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Topo_FLoc.aa, 5)
        IfCondition EqualTo(CAD_Topo.VertSamePos(CAD_Topo_FLoc.vv, CAD_Topo_FLoc.v0), 1) ThenBlock: {
            CAD_Topo_FLoc.vv = CAD_Topo_FLoc.v0
        }
        IfCondition EqualTo(CAD_Topo.VertSamePos(CAD_Topo_FLoc.vv, CAD_Topo_FLoc.v0), 0) ThenBlock: {
            CAD_Topo_FLoc.vv = CAD_Topo_FLoc.sn
        }
        CAD_Topo_FLoc.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FLoc.aa, CAD_Topo_FLoc.ab, CAD_Topo_FLoc.vv)
        IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.which = 1
        IfCondition EqualTo(CAD_Topo.VertSamePos(CAD_Topo_FLoc.vv, CAD_Store.Read(CAD_Topo_FLoc.ab, 0)), 0) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        CAD_Store.Write(CAD_Topo_FLoc.ce, 6, CAD_Topo_FLoc.which)
        CAD_Topo_FLoc.vv = CAD_Store.Read(CAD_Topo_FLoc.bb, 5)
        IfCondition EqualTo(CAD_Topo.VertSamePos(CAD_Topo_FLoc.vv, CAD_Topo_FLoc.v0), 1) ThenBlock: {
            CAD_Topo_FLoc.vv = CAD_Topo_FLoc.v0
        }
        IfCondition EqualTo(CAD_Topo.VertSamePos(CAD_Topo_FLoc.vv, CAD_Topo_FLoc.v0), 0) ThenBlock: {
            CAD_Topo_FLoc.vv = CAD_Topo_FLoc.sn
        }
        CAD_Topo_FLoc.ce = CAD_Topo.CoedgeSwapEdge(CAD_Topo_FLoc.bb, CAD_Topo_FLoc.ab, CAD_Topo_FLoc.vv)
        IfCondition EqualTo(CAD_Topo_FLoc.ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FLoc.which = 1
        IfCondition EqualTo(CAD_Topo.VertSamePos(CAD_Topo_FLoc.vv, CAD_Store.Read(CAD_Topo_FLoc.ab, 0)), 0) ThenBlock: { CAD_Topo_FLoc.which = 0 }
        CAD_Store.Write(CAD_Topo_FLoc.ce, 6, CAD_Topo_FLoc.which)
        PrintMessage("fillet rails meet\n")
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletEdgesSequential {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.solid = solid_handle
        CAD_Topo_FSeq.n = n_edges
        CAD_Topo_FSeq.r = radius_r
        IfCondition EqualTo(CAD_Topo_FSeq.sigs, 0) ThenBlock: { CAD_Topo_FSeq.sigs = Allocate(4096) }
        IfCondition EqualTo(CAD_Topo_FSeq.pack, 0) ThenBlock: { CAD_Topo_FSeq.pack = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.sigs, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            ArraySet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i), ArrayGet(edges_addr, CAD_Topo_FSeq.i))
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        CAD_Topo_FVert.n = 0
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i))
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                CAD_Topo_FSeq.k = CAD_Store.Read(CAD_Topo_FSeq.e, 0)
                IfCondition NotEqual(CAD_Topo_FSeq.k, 0) ThenBlock: {
                    CAD_Topo.FilletVertNote(CAD_Store.Read(CAD_Topo_FSeq.k, 0), CAD_Store.Read(CAD_Topo_FSeq.k, 1), CAD_Store.Read(CAD_Topo_FSeq.k, 2))
                }
                CAD_Topo_FSeq.k = CAD_Store.Read(CAD_Topo_FSeq.e, 1)
                IfCondition NotEqual(CAD_Topo_FSeq.k, 0) ThenBlock: {
                    CAD_Topo.FilletVertNote(CAD_Store.Read(CAD_Topo_FSeq.k, 0), CAD_Store.Read(CAD_Topo_FSeq.k, 1), CAD_Store.Read(CAD_Topo_FSeq.k, 2))
                }
            }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i))
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.EdgeSigFill(CAD_Topo_FSeq.e, CAD_Topo_FSeq.pack), 0) ThenBlock: {
                    CAD_Topo_FSeq.k = 0
                    WhileLoop LessThan(CAD_Topo_FSeq.k, 12) {
                        ArraySet(CAD_Topo_FSeq.sigs, Add(Multiply(CAD_Topo_FSeq.i, 12), CAD_Topo_FSeq.k), ArrayGet(CAD_Topo_FSeq.pack, CAD_Topo_FSeq.k))
                        CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
                    }
                }
            }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        CAD_Topo_FSeq.h = CAD_Topo_FSeq.solid
        CAD_Topo_FSeq.ok = 0
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            CAD_Topo_FSeq.k = 0
            WhileLoop LessThan(CAD_Topo_FSeq.k, 12) {
                ArraySet(CAD_Topo_FSeq.pack, CAD_Topo_FSeq.k, ArrayGet(CAD_Topo_FSeq.sigs, Add(Multiply(CAD_Topo_FSeq.i, 12), CAD_Topo_FSeq.k)))
                CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
            }
            // Live edge on the current solid (midpoint tie-break).
            // Stale pick handle after a join Digon is the wrong body.
            CAD_Topo_FSeq.e = CAD_Topo.FindEdgeBySig(CAD_Topo_FSeq.h, CAD_Topo_FSeq.pack)
            IfCondition EqualTo(CAD_Topo_FSeq.e, 0) ThenBlock: {
                CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i))
            }
            CAD_Topo_FSeq.nh = 0
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                CAD_Topo_FSeq.k = CAD_Store.Read(CAD_Topo_FSeq.e, 2)
                IfCondition NotEqual(CAD_Topo_FSeq.k, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FSeq.k, 0), 1) ThenBlock: {
                        CAD_Topo_FSeq.e = 0
                    }
                }
            }
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                CAD_Topo_FSeq.nh = CAD_Topo.FilletPlanePlaneEdge(CAD_Topo_FSeq.h, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r)
            }
            IfCondition NotEqual(CAD_Topo_FSeq.nh, 0) ThenBlock: {
                CAD_Topo_FSeq.h = CAD_Topo_FSeq.nh
                CAD_Topo_FSeq.ok = Add(CAD_Topo_FSeq.ok, 1)
                PrintMessage("fillet sequential ok i=")
                PrintNumber(CAD_Topo_FSeq.i)
                PrintMessage("\n")
            }
            IfCondition EqualTo(CAD_Topo_FSeq.nh, 0) ThenBlock: {
                PrintMessage("fillet sequential miss i=")
                PrintNumber(CAD_Topo_FSeq.i)
                PrintMessage("\n")
            }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        PrintMessage("fillet sequential done n=")
        PrintNumber(CAD_Topo_FSeq.ok)
        PrintMessage("\n")
        IfCondition EqualTo(CAD_Topo_FSeq.ok, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.FilletRailsMeet(CAD_Topo_FSeq.h, CAD_Topo_FSeq.r)
        CAD_Topo.FilletVerticesAfter(CAD_Topo_FSeq.h, CAD_Topo_FSeq.r)
        ReturnValue(CAD_Topo_FSeq.h)
    }
}

Function.CAD_Topo.ClassifyFail {
    Input: reason: Integer
    Output: Integer
    Body: {
        CAD_Topo_State.fillet_class = 0
        CAD_Topo_State.fillet_reason = reason
        CAD_Err.Fillet(reason)
        PrintMessage("fillet class=0 reason=")
        PrintNumber(reason)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.CAD_Topo.ClassifyFSeqInit {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        CAD_Topo_FSeq.solid = solid_handle
        CAD_Topo_FSeq.n = n_edges
        CAD_Topo_FSeq.r = radius_r
        CAD_Topo_FSeq.nH = 0
        CAD_Topo_FSeq.nV = 0
        CAD_Topo_FSeq.e = 0
        IfCondition EqualTo(CAD_Topo_FSeq.sigs, 0) ThenBlock: { CAD_Topo_FSeq.sigs = Allocate(4096) }
        IfCondition EqualTo(CAD_Topo_FSeq.pack, 0) ThenBlock: { CAD_Topo_FSeq.pack = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.horiz, 0) ThenBlock: { CAD_Topo_FSeq.horiz = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.vert, 0) ThenBlock: { CAD_Topo_FSeq.vert = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FCove.faces, 0) ThenBlock: { CAD_Topo_FCove.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FCove.pl, 0) ThenBlock: { CAD_Topo_FCove.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.sigs, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, n_edges) {
            ArraySet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i), ArrayGet(edges_addr, CAD_Topo_FSeq.i))
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.sigs, 200)
        ReturnValue(1)
    }
}

Function.CAD_Topo.ClassifyInnerLoopOf {
    Input: edge_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.k = 0
        WhileLoop LessThan(CAD_Topo_FCove.k, 2) {
            CAD_Topo_FCove.ce = CAD_Store.Read(edge_handle, Add(3, CAD_Topo_FCove.k))
            IfCondition NotEqual(CAD_Topo_FCove.ce, 0) ThenBlock: {
                CAD_Topo_FCove.lp = CAD_Store.Read(CAD_Topo_FCove.ce, 4)
                IfCondition NotEqual(CAD_Topo_FCove.lp, 0) ThenBlock: {
                    CAD_Topo_FCove.f1 = CAD_Store.Read(CAD_Topo_FCove.lp, 1)
                    IfCondition NotEqual(CAD_Topo_FCove.f1, 0) ThenBlock: {
                        CAD_Topo_FCove.hd = CAD_Store.Read(CAD_Topo_FCove.f1, 1)
                        IfCondition NotEqual(CAD_Topo_FCove.hd, 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Topo_FCove.lp, CAD_Topo_FCove.hd) ThenBlock: {
                                ReturnValue(CAD_Topo_FCove.lp)
                            }
                        }
                    }
                }
            }
            CAD_Topo_FCove.k = Add(CAD_Topo_FCove.k, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.ClassifyFindUpright {
    Input: p_v: Integer
    Input: wall_a: Integer
    Input: wall_b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(p_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(wall_a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.faces, 0) ThenBlock: { CAD_Topo_FCove.faces = Allocate(32) }
        CAD_Topo_FCove.v0 = p_v
        CAD_Topo_FCove.f1 = wall_a
        CAD_Topo_FCove.f2 = wall_b
        CAD_Topo_FCove.lp = CAD_Store.Read(wall_a, 1)
        IfCondition EqualTo(CAD_Topo_FCove.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.hd = CAD_Store.Read(CAD_Topo_FCove.lp, 0)
        CAD_Topo_FCove.ce = CAD_Topo_FCove.hd
        CAD_Topo_FCove.g = 0
        WhileLoop LessThan(CAD_Topo_FCove.g, 16) {
            CAD_Topo_FCove.e = CAD_Store.Read(CAD_Topo_FCove.ce, 0)
            CAD_Topo_FCove.ok = 0
            IfCondition NotEqual(CAD_Topo_FCove.e, 0) ThenBlock: {
                CAD_Topo_FCove.which = CAD_Store.Read(CAD_Topo_FCove.e, 2)
                IfCondition NotEqual(CAD_Topo_FCove.which, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.which, 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FCove.e, CAD_Topo_FCove.faces), 0) ThenBlock: {
                            CAD_Topo_FCove.aa = ArrayGet(CAD_Topo_FCove.faces, 0)
                            CAD_Topo_FCove.bb = ArrayGet(CAD_Topo_FCove.faces, 1)
                            IfCondition EqualTo(CAD_Topo_FCove.aa, CAD_Topo_FCove.f1) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo_FCove.bb, CAD_Topo_FCove.f2) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                            }
                            IfCondition EqualTo(CAD_Topo_FCove.aa, CAD_Topo_FCove.f2) ThenBlock: {
                                IfCondition EqualTo(CAD_Topo_FCove.bb, CAD_Topo_FCove.f1) ThenBlock: { CAD_Topo_FCove.ok = 1 }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FCove.ok, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 0), CAD_Topo_FCove.v0) ThenBlock: { ReturnValue(CAD_Topo_FCove.e) }
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCove.e, 1), CAD_Topo_FCove.v0) ThenBlock: { ReturnValue(CAD_Topo_FCove.e) }
                CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.e, 0)
                IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Topo_FCove.orig, 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0), 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Topo_FCove.orig, 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1), 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Topo_FCove.orig, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2), 0), 1) ThenBlock: {
                            ReturnValue(CAD_Topo_FCove.e)
                        }
                    }
                }
                CAD_Topo_FCove.orig = CAD_Store.Read(CAD_Topo_FCove.e, 1)
                IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Topo_FCove.orig, 0), CAD_Store.Read(CAD_Topo_FCove.v0, 0), 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Topo_FCove.orig, 1), CAD_Store.Read(CAD_Topo_FCove.v0, 1), 0), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.IsEqual(CAD_Store.Read(CAD_Topo_FCove.orig, 2), CAD_Store.Read(CAD_Topo_FCove.v0, 2), 0), 1) ThenBlock: {
                            ReturnValue(CAD_Topo_FCove.e)
                        }
                    }
                }
            }
            CAD_Topo_FCove.ce = CAD_Store.Read(CAD_Topo_FCove.ce, 2)
            IfCondition EqualTo(CAD_Topo_FCove.ce, CAD_Topo_FCove.hd) ThenBlock: { CAD_Topo_FCove.g = 16 }
            CAD_Topo_FCove.g = Add(CAD_Topo_FCove.g, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.ClassifyJoinWall {
    Input: edge_handle: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(edge_handle, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCove.f1 = ArrayGet(CAD_Topo_FCove.faces, 0)
        CAD_Topo_FCove.f2 = ArrayGet(CAD_Topo_FCove.faces, 1)
        IfCondition EqualTo(CAD_Topo.EdgeOnInnerLoop(edge_handle, CAD_Topo_FCove.f1), 1) ThenBlock: {
            ReturnValue(CAD_Topo_FCove.f2)
        }
        ReturnValue(CAD_Topo_FCove.f1)
    }
}

Function.CAD_Topo.ClassifyInnerCycle {
    Input: first_e: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FSeq.n, 1) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
        IfCondition GreaterThan(CAD_Topo.SolidCountShells(CAD_Topo_FSeq.solid), 1) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(4)) }
        CAD_Topo_FSeq.h = CAD_Topo.ClassifyInnerLoopOf(first_e)
        IfCondition EqualTo(CAD_Topo_FSeq.h, 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
        CAD_Topo_FSeq.ok = CAD_Store.Read(CAD_Topo_FSeq.h, 0)
        IfCondition EqualTo(CAD_Topo_FSeq.ok, 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
        CAD_Topo_FSeq.nh = CAD_Topo_FSeq.ok
        CAD_Topo_FSeq.nH = 0
        CAD_Topo_FSeq.k = 0
        WhileLoop LessThan(CAD_Topo_FSeq.k, 16) {
            CAD_Topo_FSeq.e = CAD_Store.Read(CAD_Topo_FSeq.nh, 0)
            ArraySet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.nH, CAD_Topo_FSeq.e)
            CAD_Topo_FSeq.nH = Add(CAD_Topo_FSeq.nH, 1)
            CAD_Topo_FSeq.nh = CAD_Store.Read(CAD_Topo_FSeq.nh, 2)
            IfCondition EqualTo(CAD_Topo_FSeq.nh, CAD_Topo_FSeq.ok) ThenBlock: { CAD_Topo_FSeq.k = 16 }
            CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
        }
        IfCondition LessThan(CAD_Topo_FSeq.nH, 3) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
        IfCondition GreaterThan(CAD_Topo_FSeq.nH, 12) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
        CAD_Topo_FSeq.nV = 0
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.nH) {
            CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.i)
            IfCondition EqualTo(CAD_Topo_FSeq.e, 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
            CAD_Topo_FSeq.k = CAD_Store.Read(CAD_Topo_FSeq.e, 2)
            IfCondition EqualTo(CAD_Topo_FSeq.k, 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
            CAD_Topo_FCove.kind = CAD_Store.Read(CAD_Topo_FSeq.k, 0)
            IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: {
                IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FSeq.e, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
                IfCondition NotEqual(CAD_Topo.FaceGetPlane(ArrayGet(CAD_Topo_FCove.faces, 0), CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
                IfCondition NotEqual(CAD_Topo.FaceGetPlane(ArrayGet(CAD_Topo_FCove.faces, 1), CAD_Topo_FCove.pl), 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
            }
            IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: {
                CAD_Topo_FSeq.nV = Add(CAD_Topo_FSeq.nV, 1)
                IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FSeq.e, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
            }
            IfCondition NotEqual(CAD_Topo_FCove.kind, 1) ThenBlock: {
                IfCondition NotEqual(CAD_Topo_FCove.kind, 2) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
            }
            CAD_Topo_FSeq.h = CAD_Store.Read(CAD_Topo_FSeq.e, 0)
            CAD_Topo_FSeq.ok = CAD_Store.Read(CAD_Topo_FSeq.e, 1)
            CAD_Topo_FSeq.nh = Float_Sub(CAD_Store.Read(CAD_Topo_FSeq.ok, 2), CAD_Store.Read(CAD_Topo_FSeq.h, 2))
            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FSeq.nh, 0), 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(2)) }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        IfCondition GreaterThan(CAD_Topo_FSeq.nV, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FSeq.nV, CAD_Topo_FSeq.nH) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(1)) }
            CAD_Topo_State.fillet_concave = 1
            CAD_Topo_State.fillet_class = 8
            CAD_Topo_State.fillet_reason = 0
            CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.horiz, 0)
            ReturnValue(8)
        }
        CAD_Topo_FCove.n = 0
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.nH) {
            CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.i, 1)
            IfCondition EqualTo(CAD_Topo_FSeq.k, CAD_Topo_FSeq.nH) ThenBlock: { CAD_Topo_FSeq.k = 0 }
            CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.i)
            CAD_Topo_FSeq.h = ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.k)
            CAD_Topo_FSeq.ok = CAD_Store.Read(CAD_Topo_FSeq.e, 0)
            CAD_Topo_FSeq.nh = CAD_Store.Read(CAD_Topo_FSeq.e, 1)
            CAD_Topo_FCove.hit = 0
            IfCondition EqualTo(CAD_Topo_FSeq.ok, CAD_Store.Read(CAD_Topo_FSeq.h, 0)) ThenBlock: { CAD_Topo_FCove.hit = CAD_Topo_FSeq.ok }
            IfCondition EqualTo(CAD_Topo_FSeq.ok, CAD_Store.Read(CAD_Topo_FSeq.h, 1)) ThenBlock: { CAD_Topo_FCove.hit = CAD_Topo_FSeq.ok }
            IfCondition EqualTo(CAD_Topo_FSeq.nh, CAD_Store.Read(CAD_Topo_FSeq.h, 0)) ThenBlock: { CAD_Topo_FCove.hit = CAD_Topo_FSeq.nh }
            IfCondition EqualTo(CAD_Topo_FSeq.nh, CAD_Store.Read(CAD_Topo_FSeq.h, 1)) ThenBlock: { CAD_Topo_FCove.hit = CAD_Topo_FSeq.nh }
            IfCondition EqualTo(CAD_Topo_FCove.hit, 0) ThenBlock: { CAD_Topo_FCove.hit = CAD_Topo_FSeq.nh }
            CAD_Topo_FCove.wa = CAD_Topo.ClassifyJoinWall(CAD_Topo_FSeq.e)
            CAD_Topo_FCove.wb = CAD_Topo.ClassifyJoinWall(ArrayGet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.k))
            IfCondition EqualTo(CAD_Topo.ClassifyFindUpright(CAD_Topo_FCove.hit, CAD_Topo_FCove.wa, CAD_Topo_FCove.wb), 0) ThenBlock: {
                ReturnValue(CAD_Topo.ClassifyFail(3))
            }
            CAD_Topo_FCove.n = Add(CAD_Topo_FCove.n, 1)
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.horiz, 0)
        CAD_Topo_State.fillet_concave = 1
        CAD_Topo_State.fillet_class = 3
        CAD_Topo_State.fillet_reason = 0
        ReturnValue(3)
    }
}

Function.CAD_Topo.ClassifyCylRim {
    Input: edge_handle: Integer
    Output: Integer
    Body: {
        // Inner CIRCLE: class 6 plane–cyl (hole ID vs boss). Outer CIRCLE
        // on a holed solid is the same builder (convex OD), not a lone-cyl
        // rebuild — that gate was the washer outer FAIL.
        IfCondition EqualTo(CAD_Topo.EdgeIsInnerLoop(edge_handle), 1) ThenBlock: {
            CAD_Topo_State.fillet_class = 6
            ReturnValue(6)
        }
        IfCondition GreaterThan(CAD_Topo.SolidCountShells(CAD_Topo_FSeq.solid), 1) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        CAD_Topo_FSeq.h = 0
        CAD_Topo_FSeq.ok = 0
        CAD_Topo_FSeq.nh = 0
        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FSeq.solid, 3), 1) ThenBlock: {
            CAD_Topo_FSeq.k = CAD_Store.Read(CAD_Topo_FSeq.solid, 1)
            IfCondition NotEqual(CAD_Topo_FSeq.k, 0) ThenBlock: {
                CAD_Topo_FSeq.ok = CAD_Store.Read(CAD_Topo_FSeq.k, 4)
                CAD_Topo_FSeq.nh = Float_Add(CAD_Topo_FSeq.ok, CAD_Store.Read(CAD_Topo_FSeq.k, 1))
                CAD_Topo_FSeq.h = 1
            }
        }
        CAD_Topo_FSeq.nV = CAD_Store.Read(edge_handle, 0)
        IfCondition EqualTo(CAD_Topo_FSeq.nV, 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        CAD_Topo_FSeq.nH = CAD_Store.Read(CAD_Topo_FSeq.nV, 2)
        IfCondition EqualTo(CAD_Topo_FSeq.h, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Topo_FSeq.nH, CAD_Topo_FSeq.nh, 0), 1) ThenBlock: {
                CAD_Topo_State.fillet_class = 4
                ReturnValue(4)
            }
            IfCondition EqualTo(CAD_Num.IsEqual(CAD_Topo_FSeq.nH, CAD_Topo_FSeq.ok, 0), 1) ThenBlock: {
                CAD_Topo_State.fillet_class = 5
                ReturnValue(5)
            }
        }
        IfCondition EqualTo(CAD_Topo_FSeq.h, 0) ThenBlock: {
            CAD_Topo_FSeq.k = CAD_Store.Read(edge_handle, 2)
            IfCondition NotEqual(CAD_Topo_FSeq.k, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(CAD_Topo_FSeq.nH, CAD_Store.Read(CAD_Topo_FSeq.k, 3), 0), 1) ThenBlock: {
                    CAD_Topo_State.fillet_class = 4
                    ReturnValue(4)
                }
            }
        }
        CAD_Topo_State.fillet_class = 8
        ReturnValue(8)
    }
}

Function.CAD_Topo.ClassifyFilletBatch {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        CAD_Topo_State.fillet_class = 0
        CAD_Topo_State.fillet_reason = 0
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        IfCondition GreaterThan(n_edges, 12) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        IfCondition EqualTo(CAD_Topo.ClassifyFSeqInit(solid_handle, edges_addr, n_edges, radius_r), 0) ThenBlock: {
            ReturnValue(CAD_Topo.ClassifyFail(0))
        }
        // Curve kind only: LINE=1 sequential Local, CIRCLE=2 rim/join.
        // No height split, no inner-cycle steal, no Digon/sphere recipe.
        CAD_Topo_FSeq.nH = 0
        CAD_Topo_FSeq.nV = 0
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            CAD_Topo_FSeq.h = ArrayGet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i))
            CAD_Topo_FSeq.k = 0
            IfCondition NotEqual(CAD_Topo_FSeq.h, 0) ThenBlock: {
                CAD_Topo_FSeq.k = CAD_Store.Read(CAD_Topo_FSeq.h, 2)
            }
            CAD_Topo_FCove.kind = 0
            IfCondition NotEqual(CAD_Topo_FSeq.k, 0) ThenBlock: { CAD_Topo_FCove.kind = CAD_Store.Read(CAD_Topo_FSeq.k, 0) }
            IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: { CAD_Topo_FSeq.nH = Add(CAD_Topo_FSeq.nH, 1) }
            IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: { CAD_Topo_FSeq.nV = Add(CAD_Topo_FSeq.nV, 1) }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_FSeq.n, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FSeq.nV, 1) ThenBlock: {
                ReturnValue(CAD_Topo.ClassifyCylRim(CAD_Topo_FSeq.e))
            }
        }
        IfCondition EqualTo(CAD_Topo_FSeq.nH, CAD_Topo_FSeq.n) ThenBlock: {
            IfCondition GreaterThan(CAD_Topo_FSeq.nH, 0) ThenBlock: {
                CAD_Topo_FSeq.i = 0
                WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
                    ArraySet(CAD_Topo_FSeq.vert, CAD_Topo_FSeq.i, ArrayGet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i)))
                    CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
                }
                CAD_Topo_FSeq.nV = CAD_Topo_FSeq.n
                CAD_Topo_State.fillet_class = 7
                ReturnValue(7)
            }
        }
        IfCondition EqualTo(CAD_Topo_FSeq.nV, CAD_Topo_FSeq.n) ThenBlock: {
            IfCondition GreaterThan(CAD_Topo_FSeq.nV, 0) ThenBlock: {
                CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.sigs, 200)
                CAD_Topo_State.fillet_class = 6
                ReturnValue(6)
            }
        }
        IfCondition GreaterThan(CAD_Topo_FSeq.nH, 0) ThenBlock: {
            IfCondition GreaterThan(CAD_Topo_FSeq.nV, 0) ThenBlock: {
                CAD_Topo_State.fillet_class = 8
                ReturnValue(8)
            }
        }
        ReturnValue(CAD_Topo.ClassifyFail(0))
    }
}

Function.CAD_Topo.ClassifyFilletEdge {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FSeq.pack, 0) ThenBlock: { CAD_Topo_FSeq.pack = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.pack, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FSeq.pack, 0, edge_handle)
        ReturnValue(CAD_Topo.ClassifyFilletBatch(solid_handle, CAD_Topo_FSeq.pack, 1, radius_r))
    }
}

Function.CAD_Topo.FilletClassCylTop {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Blend.FilletCylTopRim(solid_handle, edge_handle, radius_r))
    }
}

Function.CAD_Topo.FilletClassCylBot {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Blend.FilletCylBottomRim(solid_handle, edge_handle, radius_r))
    }
}

Function.CAD_Topo.FilletClassCylJoin {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Blend.FilletPlaneCylJoin(solid_handle, edge_handle, radius_r))
    }
}

Function.CAD_Topo.FilletPlaneEdges {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_edges, 64) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletCompile(solid_handle, edges_addr, n_edges, radius_r), 0) ThenBlock: {
            PrintMessage("fillet IR compile fail\n")
            ReturnValue(0)
        }
        CAD_Topo_FVert.n = 0
        CAD_Topo_FSeq.nH = 0
        CAD_Topo_FSeq.nV = 0
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FComp.n) {
            CAD_Topo_FSeq.k = CAD_Topo.FilletIRGet(CAD_Topo_FSeq.i, 11)
            IfCondition EqualTo(CAD_Topo_FSeq.k, 0) ThenBlock: { CAD_Topo_FSeq.nH = Add(CAD_Topo_FSeq.nH, 1) }
            IfCondition EqualTo(CAD_Topo_FSeq.k, 1) ThenBlock: { CAD_Topo_FSeq.nV = Add(CAD_Topo_FSeq.nV, 1) }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        IfCondition GreaterThan(CAD_Topo_FSeq.nH, 0) ThenBlock: {
            IfCondition GreaterThan(CAD_Topo_FSeq.nV, 0) ThenBlock: {
                PrintMessage("fillet IR mixed chain LINE=")
                PrintNumber(CAD_Topo_FSeq.nH)
                PrintMessage(" CIRC=")
                PrintNumber(CAD_Topo_FSeq.nV)
                PrintMessage("\n")
                CAD_Topo_State.fillet_class = 8
                ReturnValue(CAD_Topo.FilletEmitChain(solid_handle, radius_r))
            }
        }
        CAD_Topo_State.fillet_class = CAD_Topo.ClassifyFilletBatch(solid_handle, edges_addr, n_edges, radius_r)
        cls = CAD_Topo_State.fillet_class
        PrintMessage("fillet class=")
        PrintNumber(cls)
        PrintMessage(" n=")
        PrintNumber(n_edges)
        PrintMessage("\n")
        Branch cls {
            Case 1: {
                dig = CAD_Topo.FilletPlaneEdgesDigon(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.nH, CAD_Topo_FSeq.r)
                IfCondition EqualTo(dig, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(CAD_Topo_FSeq.nV, 0) ThenBlock: { ReturnValue(dig) }
                CAD_Topo_FSeq.i = 0
                WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.nV) {
                    CAD_Topo_FSeq.k = 0
                    WhileLoop LessThan(CAD_Topo_FSeq.k, 12) {
                        ArraySet(CAD_Topo_FSeq.pack, CAD_Topo_FSeq.k, ArrayGet(CAD_Topo_FSeq.sigs, Add(Multiply(CAD_Topo_FSeq.i, 12), CAD_Topo_FSeq.k)))
                        CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
                    }
                    ArraySet(CAD_Topo_FSeq.vert, CAD_Topo_FSeq.i, CAD_Topo.FindEdgeBySig(dig, CAD_Topo_FSeq.pack))
                    CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
                }
                seq = CAD_Topo.FilletEdgesSequential(dig, CAD_Topo_FSeq.vert, CAD_Topo_FSeq.nV, CAD_Topo_FSeq.r)
                IfCondition NotEqual(seq, 0) ThenBlock: { ReturnValue(seq) }
                ReturnValue(dig)
            }
            Case 2: {
                ReturnValue(CAD_Topo.FilletEdgeLocal(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r))
            }
            Case 3: {
                ReturnValue(CAD_Topo.FilletJoinCoveCycle(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.nH, CAD_Topo_FSeq.r))
            }
            Case 4: {
                ReturnValue(CAD_Blend.FilletCylTopRim(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r))
            }
            Case 5: {
                ReturnValue(CAD_Blend.FilletCylBottomRim(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r))
            }
            Case 6: {
                em = CAD_Topo.FilletEmitPlaneCyl(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r)
                IfCondition NotEqual(em, 0) ThenBlock: { ReturnValue(em) }
                ReturnValue(CAD_Blend.FilletPlaneCylJoin(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.e, CAD_Topo_FSeq.r))
            }
            Case 7: {
                ReturnValue(CAD_Topo.FilletEdgesSequential(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.vert, CAD_Topo_FSeq.nV, CAD_Topo_FSeq.r))
            }
            Case 8: {
                ReturnValue(CAD_Topo.FilletEmitChain(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.r))
            }
            Case 9: {
                ReturnValue(CAD_Topo.FilletEmitChain(CAD_Topo_FSeq.solid, CAD_Topo_FSeq.r))
            }
            Default: {
                ReturnValue(0)
            }
        }
    }
}
