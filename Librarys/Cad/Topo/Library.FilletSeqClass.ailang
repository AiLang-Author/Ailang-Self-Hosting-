LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Cad.CAD_Err

Function.CAD_Topo.ClassifyFilletBatch {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        CAD_Topo_State.fillet_class = 0
        CAD_Topo_State.fillet_reason = 0
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        IfCondition GreaterThan(n_edges, 12) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(CAD_Topo.ClassifyFail(0)) }
        IfCondition EqualTo(CAD_Topo.ClassifyFSeqInit(solid_handle, edges_addr, n_edges, radius_r), 0) ThenBlock: {
            ReturnValue(CAD_Topo.ClassifyFail(0))
        }
        // Curve kind only: LINE=1 sequential Local, CIRCLE=2 rim/join.
        // No height split, no inner-cycle steal, no Digon/sphere recipe.
        CAD_Topo_FSeq.nH = 0
        CAD_Topo_FSeq.nV = 0
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
            CAD_Topo_FSeq.h = ArrayGet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i))
            CAD_Topo_FSeq.k = 0
            IfCondition NotEqual(CAD_Topo_FSeq.h, 0) ThenBlock: {
                CAD_Topo_FSeq.k = CAD_Store.Read(CAD_Topo_FSeq.h, 2)
            }
            CAD_Topo_FCove.kind = 0
            IfCondition NotEqual(CAD_Topo_FSeq.k, 0) ThenBlock: { CAD_Topo_FCove.kind = CAD_Store.Read(CAD_Topo_FSeq.k, 0) }
            IfCondition EqualTo(CAD_Topo_FCove.kind, 1) ThenBlock: { CAD_Topo_FSeq.nH = Add(CAD_Topo_FSeq.nH, 1) }
            IfCondition EqualTo(CAD_Topo_FCove.kind, 2) ThenBlock: { CAD_Topo_FSeq.nV = Add(CAD_Topo_FSeq.nV, 1) }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_FSeq.n, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_FSeq.nV, 1) ThenBlock: {
                ReturnValue(CAD_Topo.ClassifyCylRim(CAD_Topo_FSeq.e))
            }
        }
        IfCondition EqualTo(CAD_Topo_FSeq.nH, CAD_Topo_FSeq.n) ThenBlock: {
            IfCondition GreaterThan(CAD_Topo_FSeq.nH, 0) ThenBlock: {
                CAD_Topo_FSeq.i = 0
                WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
                    ArraySet(CAD_Topo_FSeq.vert, CAD_Topo_FSeq.i, ArrayGet(CAD_Topo_FSeq.sigs, Add(200, CAD_Topo_FSeq.i)))
                    CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
                }
                CAD_Topo_FSeq.nV = CAD_Topo_FSeq.n
                IfCondition EqualTo(CAD_Topo_FSeq.n, 3) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FilletJoinFootOk(), 1) ThenBlock: {
                        CAD_Topo_FSeq.i = 0
                        WhileLoop LessThan(CAD_Topo_FSeq.i, 3) {
                            ArraySet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.i, ArrayGet(CAD_Topo_FSeq.vert, CAD_Topo_FSeq.i))
                            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
                        }
                        CAD_Topo_FSeq.nH = 3
                        CAD_Topo_State.fillet_class = 3
                        ReturnValue(3)
                    }
                }
                IfCondition GreaterThan(CAD_Topo_FSeq.n, 2) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FilletJoinHasGlue(), 1) ThenBlock: {
                        CAD_Topo_FSeq.i = 0
                        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FSeq.n) {
                            ArraySet(CAD_Topo_FSeq.horiz, CAD_Topo_FSeq.i, ArrayGet(CAD_Topo_FSeq.vert, CAD_Topo_FSeq.i))
                            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
                        }
                        CAD_Topo_FSeq.nH = CAD_Topo_FSeq.n
                        CAD_Topo_State.fillet_class = 3
                        ReturnValue(3)
                    }
                }
                CAD_Topo_State.fillet_class = 7
                ReturnValue(7)
            }
        }
        IfCondition EqualTo(CAD_Topo_FSeq.nV, CAD_Topo_FSeq.n) ThenBlock: {
            IfCondition GreaterThan(CAD_Topo_FSeq.nV, 0) ThenBlock: {
                CAD_Topo_FSeq.e = ArrayGet(CAD_Topo_FSeq.sigs, 200)
                CAD_Topo_State.fillet_class = 6
                ReturnValue(6)
            }
        }
        IfCondition GreaterThan(CAD_Topo_FSeq.nH, 0) ThenBlock: {
            IfCondition GreaterThan(CAD_Topo_FSeq.nV, 0) ThenBlock: {
                CAD_Topo_State.fillet_class = 8
                ReturnValue(8)
            }
        }
        CAD_Topo_State.fillet_class = 8
        ReturnValue(8)
    }
}

Function.CAD_Topo.ClassifyFilletEdge {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FSeq.pack, 0) ThenBlock: { CAD_Topo_FSeq.pack = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FSeq.pack, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FSeq.pack, 0, edge_handle)
        ReturnValue(CAD_Topo.ClassifyFilletBatch(solid_handle, CAD_Topo_FSeq.pack, 1, radius_r))
    }
}

Function.CAD_Topo.FilletClassCylTop {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Blend.FilletCylTopRim(solid_handle, edge_handle, radius_r))
    }
}

Function.CAD_Topo.FilletClassCylBot {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Blend.FilletCylBottomRim(solid_handle, edge_handle, radius_r))
    }
}

Function.CAD_Topo.FilletClassCylJoin {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Blend.FilletPlaneCylJoin(solid_handle, edge_handle, radius_r))
    }
}

Function.CAD_Topo.FilletFaceIsBlend {
    Input: face_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.h = CAD_Store.Read(face_h, 0)
        IfCondition EqualTo(CAD_Topo_FSeq.h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.ok = CAD_Store.Read(CAD_Topo_FSeq.h, 0)
        IfCondition EqualTo(CAD_Topo_FSeq.ok, 3) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(CAD_Topo_FSeq.ok, 2) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.lp = CAD_Store.Read(face_h, 1)
        IfCondition EqualTo(CAD_Topo_FSeq.lp, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.hd = CAD_Store.Read(CAD_Topo_FSeq.lp, 0)
        IfCondition EqualTo(CAD_Topo_FSeq.hd, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.e = CAD_Topo_FSeq.hd
        CAD_Topo_FSeq.nh = 0
        CAD_Topo_FSeq.k = 0
        WhileLoop LessThan(CAD_Topo_FSeq.k, 16) {
            CAD_Topo_FSeq.ok = CAD_Store.Read(CAD_Topo_FSeq.e, 0)
            IfCondition NotEqual(CAD_Topo_FSeq.ok, 0) ThenBlock: {
                CAD_Topo_FSeq.h = CAD_Store.Read(CAD_Topo_FSeq.ok, 2)
                IfCondition NotEqual(CAD_Topo_FSeq.h, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FSeq.h, 0), 1) ThenBlock: {
                        CAD_Topo_FSeq.aa = CAD_Store.Read(CAD_Topo_FSeq.ok, 0)
                        CAD_Topo_FSeq.bb = CAD_Store.Read(CAD_Topo_FSeq.ok, 1)
                        IfCondition NotEqual(CAD_Topo_FSeq.aa, 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Topo_FSeq.bb, 0) ThenBlock: {
                                CAD_Topo_FSeq.nh = Float_Sub(CAD_Store.Read(CAD_Topo_FSeq.bb, 0), CAD_Store.Read(CAD_Topo_FSeq.aa, 0))
                                CAD_Topo_FSeq.ok = Float_Sub(CAD_Store.Read(CAD_Topo_FSeq.bb, 1), CAD_Store.Read(CAD_Topo_FSeq.aa, 1))
                                CAD_Topo_FSeq.h = Float_Sub(CAD_Store.Read(CAD_Topo_FSeq.bb, 2), CAD_Store.Read(CAD_Topo_FSeq.aa, 2))
                                CAD_Topo_FSeq.nh = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FSeq.nh, CAD_Topo_FSeq.nh), Float_Mul(CAD_Topo_FSeq.ok, CAD_Topo_FSeq.ok)), Float_Mul(CAD_Topo_FSeq.h, CAD_Topo_FSeq.h)))
                                CAD_Topo_FSeq.ok = Float_Add(CAD_Topo_FComp.r, CAD_Topo_FComp.r)
                                IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FSeq.nh, CAD_Topo_FSeq.ok), 0) ThenBlock: { ReturnValue(0) }
                            }
                        }
                    }
                }
            }
            CAD_Topo_FSeq.e = CAD_Store.Read(CAD_Topo_FSeq.e, 2)
            IfCondition EqualTo(CAD_Topo_FSeq.e, CAD_Topo_FSeq.hd) ThenBlock: { CAD_Topo_FSeq.k = 16 }
            CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletEdgeOnBlend {
    Input: edge_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.faces, 0) ThenBlock: { CAD_Topo_FCove.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FCove.faces, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(edge_h, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletFaceIsBlend(ArrayGet(CAD_Topo_FCove.faces, 0)), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CAD_Topo.FilletFaceIsBlend(ArrayGet(CAD_Topo_FCove.faces, 1)), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.CAD_Topo.FilletBatchOnBlend {
    Input: edges_addr: Address
    Input: n_edges: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, n_edges) {
            CAD_Topo_FSeq.e = ArrayGet(edges_addr, CAD_Topo_FSeq.i)
            IfCondition EqualTo(CAD_Topo.FilletEdgeOnBlend(CAD_Topo_FSeq.e), 1) ThenBlock: { ReturnValue(1) }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        ReturnValue(0)
    }
}

// 1 iff every compiled IR vertex is touched by exactly two selected edges.
Function.CAD_Topo.FilletIRCountAt {
    Input: vh: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.ok = 0
        CAD_Topo_FSeq.k = 0
        WhileLoop LessThan(CAD_Topo_FSeq.k, CAD_Topo_FComp.n) {
            CAD_Topo_FSeq.e = CAD_Topo.FilletIRGet(CAD_Topo_FSeq.k, 0)
            IfCondition NotEqual(CAD_Topo_FSeq.e, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FSeq.e, 0), vh) ThenBlock: { CAD_Topo_FSeq.ok = Add(CAD_Topo_FSeq.ok, 1) }
                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FSeq.e, 1), vh) ThenBlock: { CAD_Topo_FSeq.ok = Add(CAD_Topo_FSeq.ok, 1) }
            }
            CAD_Topo_FSeq.k = Add(CAD_Topo_FSeq.k, 1)
        }
        ReturnValue(CAD_Topo_FSeq.ok)
    }
}

Function.CAD_Topo.FilletIRRimCycle {
    Output: Integer
    Body: {
        IfCondition LessThan(CAD_Topo_FComp.n, 3) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.i = 0
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FComp.n) {
            CAD_Topo_FSeq.e = CAD_Topo.FilletIRGet(CAD_Topo_FSeq.i, 0)
            IfCondition EqualTo(CAD_Topo_FSeq.e, 0) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(CAD_Topo.FilletIRCountAt(CAD_Store.Read(CAD_Topo_FSeq.e, 0)), 2) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(CAD_Topo.FilletIRCountAt(CAD_Store.Read(CAD_Topo_FSeq.e, 1)), 2) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        ReturnValue(1)
    }
}

// 1 iff every IR edge shares at least one common incident face (coplanar rim).
Function.CAD_Topo.FilletIRCoplanar {
    Output: Integer
    Body: {
        IfCondition LessThan(CAD_Topo_FComp.n, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FCove.faces, 0) ThenBlock: { CAD_Topo_FCove.faces = Allocate(32) }
        CAD_Topo_FSeq.e = CAD_Topo.FilletIRGet(0, 0)
        IfCondition EqualTo(CAD_Topo_FSeq.e, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FSeq.e, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.aa = ArrayGet(CAD_Topo_FCove.faces, 0)
        CAD_Topo_FSeq.bb = ArrayGet(CAD_Topo_FCove.faces, 1)
        CAD_Topo_FSeq.i = 1
        WhileLoop LessThan(CAD_Topo_FSeq.i, CAD_Topo_FComp.n) {
            CAD_Topo_FSeq.e = CAD_Topo.FilletIRGet(CAD_Topo_FSeq.i, 0)
            IfCondition EqualTo(CAD_Topo_FSeq.e, 0) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FSeq.e, CAD_Topo_FCove.faces), 0) ThenBlock: { ReturnValue(0) }
            CAD_Topo_FSeq.ok = 0
            IfCondition NotEqual(CAD_Topo_FSeq.aa, 0) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.faces, 0), CAD_Topo_FSeq.aa) ThenBlock: { CAD_Topo_FSeq.ok = 1 }
                IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.faces, 1), CAD_Topo_FSeq.aa) ThenBlock: { CAD_Topo_FSeq.ok = 1 }
                IfCondition EqualTo(CAD_Topo_FSeq.ok, 0) ThenBlock: { CAD_Topo_FSeq.aa = 0 }
            }
            CAD_Topo_FSeq.ok = 0
            IfCondition NotEqual(CAD_Topo_FSeq.bb, 0) ThenBlock: {
                IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.faces, 0), CAD_Topo_FSeq.bb) ThenBlock: { CAD_Topo_FSeq.ok = 1 }
                IfCondition EqualTo(ArrayGet(CAD_Topo_FCove.faces, 1), CAD_Topo_FSeq.bb) ThenBlock: { CAD_Topo_FSeq.ok = 1 }
                IfCondition EqualTo(CAD_Topo_FSeq.ok, 0) ThenBlock: { CAD_Topo_FSeq.bb = 0 }
            }
            IfCondition EqualTo(CAD_Topo_FSeq.aa, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_FSeq.bb, 0) ThenBlock: { ReturnValue(0) }
            }
            CAD_Topo_FSeq.i = Add(CAD_Topo_FSeq.i, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.FilletPlaneEdges {
    Input: solid_handle: Integer
    Input: edges_addr: Address
    Input: n_edges: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_edges, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_edges, 64) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.FilletCompile(solid_handle, edges_addr, n_edges, radius_r), 0) ThenBlock: {
            PrintMessage("fillet IR compile fail\n")
            ReturnValue(0)
        }
        ReturnValue(CAD_Topo.FilletPlexSolve(solid_handle, edges_addr, n_edges, radius_r))
    }
}

