LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.FilletVertNote {
    Input: vx: Integer
    Input: vy: Integer
    Input: vz: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Topo_FVert.xyz, 0) ThenBlock: { CAD_Topo_FVert.xyz = Allocate(256) }
        IfCondition EqualTo(CAD_Topo_FVert.cnt, 0) ThenBlock: { CAD_Topo_FVert.cnt = Allocate(64) }
        IfCondition EqualTo(CAD_Topo_FVert.xyz, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.k = 0
        CAD_Topo_FVert.ok = 0
        WhileLoop LessThan(CAD_Topo_FVert.k, CAD_Topo_FVert.n) {
            IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(CAD_Topo_FVert.xyz, Multiply(CAD_Topo_FVert.k, 3)), vx, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.k, 3), 1)), vy, 0), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.k, 3), 2)), vz, 0), 1) ThenBlock: {
                        ArraySet(CAD_Topo_FVert.cnt, CAD_Topo_FVert.k, Add(ArrayGet(CAD_Topo_FVert.cnt, CAD_Topo_FVert.k), 1))
                        CAD_Topo_FVert.ok = 1
                        CAD_Topo_FVert.k = CAD_Topo_FVert.n
                    }
                }
            }
            CAD_Topo_FVert.k = Add(CAD_Topo_FVert.k, 1)
        }
        IfCondition EqualTo(CAD_Topo_FVert.ok, 0) ThenBlock: {
            IfCondition LessThan(CAD_Topo_FVert.n, 32) ThenBlock: {
                ArraySet(CAD_Topo_FVert.xyz, Multiply(CAD_Topo_FVert.n, 3), vx)
                ArraySet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.n, 3), 1), vy)
                ArraySet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.n, 3), 2), vz)
                ArraySet(CAD_Topo_FVert.cnt, CAD_Topo_FVert.n, 1)
                CAD_Topo_FVert.n = Add(CAD_Topo_FVert.n, 1)
            }
        }
        ReturnValue(CAD_Topo_FVert.n)
    }
}

// Minor arc on the sphere: circle at C through va, vb.
Function.CAD_Topo.FilletSphereArc {
    Input: va: Integer
    Input: vb: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(va, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FVert.frame, 0) ThenBlock: { CAD_Topo_FVert.frame = Allocate(128) }
        CAD_Topo_FVert.aa = Float_Sub(CAD_Store.Read(va, 0), CAD_Topo_FVert.cx)
        CAD_Topo_FVert.bb = Float_Sub(CAD_Store.Read(va, 1), CAD_Topo_FVert.cy)
        CAD_Topo_FVert.ln = Float_Sub(CAD_Store.Read(va, 2), CAD_Topo_FVert.cz)
        CAD_Topo_FVert.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FVert.ab, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.aa = Float_Div(CAD_Topo_FVert.aa, CAD_Topo_FVert.ab)
        CAD_Topo_FVert.bb = Float_Div(CAD_Topo_FVert.bb, CAD_Topo_FVert.ab)
        CAD_Topo_FVert.ln = Float_Div(CAD_Topo_FVert.ln, CAD_Topo_FVert.ab)
        ArraySet(CAD_Topo_FVert.frame, 0, CAD_Topo_FVert.cx)
        ArraySet(CAD_Topo_FVert.frame, 1, CAD_Topo_FVert.cy)
        ArraySet(CAD_Topo_FVert.frame, 2, CAD_Topo_FVert.cz)
        ArraySet(CAD_Topo_FVert.frame, 3, CAD_Topo_FVert.aa)
        ArraySet(CAD_Topo_FVert.frame, 4, CAD_Topo_FVert.bb)
        ArraySet(CAD_Topo_FVert.frame, 5, CAD_Topo_FVert.ln)
        CAD_Topo_FVert.k = Float_Sub(CAD_Store.Read(vb, 0), CAD_Topo_FVert.cx)
        CAD_Topo_FVert.g = Float_Sub(CAD_Store.Read(vb, 1), CAD_Topo_FVert.cy)
        CAD_Topo_FVert.ok = Float_Sub(CAD_Store.Read(vb, 2), CAD_Topo_FVert.cz)
        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.k, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.g, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ok, CAD_Topo_FVert.ln))
        CAD_Topo_FVert.k = Float_Sub(CAD_Topo_FVert.k, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.aa))
        CAD_Topo_FVert.g = Float_Sub(CAD_Topo_FVert.g, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.bb))
        CAD_Topo_FVert.ok = Float_Sub(CAD_Topo_FVert.ok, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.ln))
        CAD_Topo_FVert.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.k, CAD_Topo_FVert.k), Float_Mul(CAD_Topo_FVert.g, CAD_Topo_FVert.g)), Float_Mul(CAD_Topo_FVert.ok, CAD_Topo_FVert.ok)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FVert.ab, 0), 1) ThenBlock: { ReturnValue(0) }
        ArraySet(CAD_Topo_FVert.frame, 6, Float_Div(CAD_Topo_FVert.k, CAD_Topo_FVert.ab))
        ArraySet(CAD_Topo_FVert.frame, 7, Float_Div(CAD_Topo_FVert.g, CAD_Topo_FVert.ab))
        ArraySet(CAD_Topo_FVert.frame, 8, Float_Div(CAD_Topo_FVert.ok, CAD_Topo_FVert.ab))
        CAD_Topo_FVert.which = CAD_Geom.MakeCircle(CAD_Topo_FVert.frame, CAD_Topo_FVert.r)
        IfCondition EqualTo(CAD_Topo_FVert.which, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(CAD_Topo.MakeMinorArcEdge(va, vb, CAD_Topo_FVert.which))
    }
}

// Nearest of T1,T2,T3 to v. 0 if v is farther than thr from the corner.
Function.CAD_Topo.FilletNearT {
    Input: v_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(v_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.aa = Float_Sub(CAD_Store.Read(v_h, 0), CAD_Topo_FVert.px)
        CAD_Topo_FVert.bb = Float_Sub(CAD_Store.Read(v_h, 1), CAD_Topo_FVert.py)
        CAD_Topo_FVert.ln = Float_Sub(CAD_Store.Read(v_h, 2), CAD_Topo_FVert.pz)
        CAD_Topo_FVert.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln)))
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FVert.ab, CAD_Topo_FVert.thr), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.which = CAD_Topo_FVert.t1
        CAD_Topo_FVert.aa = Float_Sub(CAD_Store.Read(v_h, 0), CAD_Store.Read(CAD_Topo_FVert.t1, 0))
        CAD_Topo_FVert.bb = Float_Sub(CAD_Store.Read(v_h, 1), CAD_Store.Read(CAD_Topo_FVert.t1, 1))
        CAD_Topo_FVert.ln = Float_Sub(CAD_Store.Read(v_h, 2), CAD_Store.Read(CAD_Topo_FVert.t1, 2))
        CAD_Topo_FVert.ok = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln))
        CAD_Topo_FVert.aa = Float_Sub(CAD_Store.Read(v_h, 0), CAD_Store.Read(CAD_Topo_FVert.t2, 0))
        CAD_Topo_FVert.bb = Float_Sub(CAD_Store.Read(v_h, 1), CAD_Store.Read(CAD_Topo_FVert.t2, 1))
        CAD_Topo_FVert.ln = Float_Sub(CAD_Store.Read(v_h, 2), CAD_Store.Read(CAD_Topo_FVert.t2, 2))
        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln))
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FVert.ab, CAD_Topo_FVert.ok), 1) ThenBlock: {
            CAD_Topo_FVert.ok = CAD_Topo_FVert.ab
            CAD_Topo_FVert.which = CAD_Topo_FVert.t2
        }
        CAD_Topo_FVert.aa = Float_Sub(CAD_Store.Read(v_h, 0), CAD_Store.Read(CAD_Topo_FVert.t3, 0))
        CAD_Topo_FVert.bb = Float_Sub(CAD_Store.Read(v_h, 1), CAD_Store.Read(CAD_Topo_FVert.t3, 1))
        CAD_Topo_FVert.ln = Float_Sub(CAD_Store.Read(v_h, 2), CAD_Store.Read(CAD_Topo_FVert.t3, 2))
        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln))
        IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FVert.ab, CAD_Topo_FVert.ok), 1) ThenBlock: {
            CAD_Topo_FVert.which = CAD_Topo_FVert.t3
        }
        ReturnValue(CAD_Topo_FVert.which)
    }
}

// Rolling-ball vertex blend. Sphere tangent to the 3 planes at P:
// Ni·(C−P) = s, s=+R cove / −R convex. Contacts Ti = C − s Ni.
// 3 minor arcs, MakeSphereSurf face, then stitch cylinder ends onto it.
Function.CAD_Topo.FilletVertexSphere {
    Input: solid_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.solid = solid_handle
        CAD_Topo_FVert.r = radius_r
        CAD_Topo_FVert.s = radius_r
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 0) ThenBlock: {
            CAD_Topo_FVert.s = Float_Sub(0, radius_r)
        }
        CAD_Topo_FVert.thr = Float_Mul(radius_r, 0x3FF8000000000000)
        IfCondition EqualTo(CAD_Topo_FVert.pl, 0) ThenBlock: { CAD_Topo_FVert.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_FVert.pt, 0) ThenBlock: { CAD_Topo_FVert.pt = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FVert.ring, 0) ThenBlock: { CAD_Topo_FVert.ring = Allocate(64) }
        IfCondition EqualTo(CAD_Topo_FVert.frame, 0) ThenBlock: { CAD_Topo_FVert.frame = Allocate(128) }
        CAD_Topo_FVert.nfound = 0
        CAD_Topo_FVert.f1 = 0
        CAD_Topo_FVert.f2 = 0
        CAD_Topo_FVert.f3 = 0
        CAD_Topo_FVert.sh = CAD_Store.Read(solid_handle, 0)
        CAD_Topo_FVert.sg = 0
        WhileLoop NotEqual(CAD_Topo_FVert.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FVert.sg, 64) ThenBlock: { CAD_Topo_FVert.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FVert.sh, 0) ThenBlock: {
                CAD_Topo_FVert.face = CAD_Store.Read(CAD_Topo_FVert.sh, 0)
                CAD_Topo_FVert.fg = 0
                WhileLoop NotEqual(CAD_Topo_FVert.face, 0) {
                    IfCondition GreaterThan(CAD_Topo_FVert.fg, 4096) ThenBlock: { CAD_Topo_FVert.face = 0 }
                    IfCondition NotEqual(CAD_Topo_FVert.face, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_FVert.face, CAD_Topo_FVert.pl), 0) ThenBlock: {
                            CAD_Topo_FVert.aa = ArrayGet(CAD_Topo_FVert.pl, 10)
                            CAD_Topo_FVert.bb = ArrayGet(CAD_Topo_FVert.pl, 11)
                            CAD_Topo_FVert.ln = ArrayGet(CAD_Topo_FVert.pl, 12)
                            CAD_Topo_FVert.ab = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.aa), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.bb)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.ln)))
                            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FVert.ab, 0), 0) ThenBlock: {
                                CAD_Topo_FVert.aa = Float_Div(CAD_Topo_FVert.aa, CAD_Topo_FVert.ab)
                                CAD_Topo_FVert.bb = Float_Div(CAD_Topo_FVert.bb, CAD_Topo_FVert.ab)
                                CAD_Topo_FVert.ln = Float_Div(CAD_Topo_FVert.ln, CAD_Topo_FVert.ab)
                                CAD_Topo_FVert.ok = Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Topo_FVert.px, ArrayGet(CAD_Topo_FVert.pl, 1)), CAD_Topo_FVert.aa), Float_Mul(Float_Sub(CAD_Topo_FVert.py, ArrayGet(CAD_Topo_FVert.pl, 2)), CAD_Topo_FVert.bb)), Float_Mul(Float_Sub(CAD_Topo_FVert.pz, ArrayGet(CAD_Topo_FVert.pl, 3)), CAD_Topo_FVert.ln))
                                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FVert.ok, 0), 1) ThenBlock: {
                                    CAD_Topo_FVert.which = 1
                                    IfCondition EqualTo(CAD_Topo_FVert.nfound, 1) ThenBlock: {
                                        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.n1x), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.n1y)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.n1z))
                                        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.ab = Float_Sub(0, CAD_Topo_FVert.ab) }
                                        IfCondition EqualTo(CAD_Num.Le(0x3FE8000000000000, CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.which = 0 }
                                    }
                                    IfCondition EqualTo(CAD_Topo_FVert.nfound, 2) ThenBlock: {
                                        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.n1x), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.n1y)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.n1z))
                                        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.ab = Float_Sub(0, CAD_Topo_FVert.ab) }
                                        IfCondition EqualTo(CAD_Num.Le(0x3FE8000000000000, CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.which = 0 }
                                        CAD_Topo_FVert.ab = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.aa, CAD_Topo_FVert.n2x), Float_Mul(CAD_Topo_FVert.bb, CAD_Topo_FVert.n2y)), Float_Mul(CAD_Topo_FVert.ln, CAD_Topo_FVert.n2z))
                                        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.ab = Float_Sub(0, CAD_Topo_FVert.ab) }
                                        IfCondition EqualTo(CAD_Num.Le(0x3FE8000000000000, CAD_Topo_FVert.ab), 1) ThenBlock: { CAD_Topo_FVert.which = 0 }
                                    }
                                    IfCondition GreaterThan(CAD_Topo_FVert.nfound, 2) ThenBlock: { CAD_Topo_FVert.which = 0 }
                                    IfCondition EqualTo(CAD_Topo_FVert.which, 1) ThenBlock: {
                                        IfCondition EqualTo(CAD_Topo_FVert.nfound, 0) ThenBlock: {
                                            CAD_Topo_FVert.n1x = CAD_Topo_FVert.aa
                                            CAD_Topo_FVert.n1y = CAD_Topo_FVert.bb
                                            CAD_Topo_FVert.n1z = CAD_Topo_FVert.ln
                                            CAD_Topo_FVert.f1 = CAD_Topo_FVert.face
                                        }
                                        IfCondition EqualTo(CAD_Topo_FVert.nfound, 1) ThenBlock: {
                                            CAD_Topo_FVert.n2x = CAD_Topo_FVert.aa
                                            CAD_Topo_FVert.n2y = CAD_Topo_FVert.bb
                                            CAD_Topo_FVert.n2z = CAD_Topo_FVert.ln
                                            CAD_Topo_FVert.f2 = CAD_Topo_FVert.face
                                        }
                                        IfCondition EqualTo(CAD_Topo_FVert.nfound, 2) ThenBlock: {
                                            CAD_Topo_FVert.n3x = CAD_Topo_FVert.aa
                                            CAD_Topo_FVert.n3y = CAD_Topo_FVert.bb
                                            CAD_Topo_FVert.n3z = CAD_Topo_FVert.ln
                                            CAD_Topo_FVert.f3 = CAD_Topo_FVert.face
                                        }
                                        CAD_Topo_FVert.nfound = Add(CAD_Topo_FVert.nfound, 1)
                                    }
                                }
                            }
                        }
                        CAD_Topo_FVert.face = CAD_Store.Read(CAD_Topo_FVert.face, 3)
                    }
                    CAD_Topo_FVert.fg = Add(CAD_Topo_FVert.fg, 1)
                }
                CAD_Topo_FVert.sh = CAD_Store.Read(CAD_Topo_FVert.sh, 2)
            }
            CAD_Topo_FVert.sg = Add(CAD_Topo_FVert.sg, 1)
        }
        IfCondition LessThan(CAD_Topo_FVert.nfound, 3) ThenBlock: {
            PrintMessage("fillet VERTEX need 3 planes n=")
            PrintNumber(CAD_Topo_FVert.nfound)
            PrintMessage("\n")
            ReturnValue(0)
        }
        // 3×3: Ni·(x N1 + y N2 + z N3) = s
        CAD_Topo_FVert.d12 = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.n1x, CAD_Topo_FVert.n2x), Float_Mul(CAD_Topo_FVert.n1y, CAD_Topo_FVert.n2y)), Float_Mul(CAD_Topo_FVert.n1z, CAD_Topo_FVert.n2z))
        CAD_Topo_FVert.d13 = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.n1x, CAD_Topo_FVert.n3x), Float_Mul(CAD_Topo_FVert.n1y, CAD_Topo_FVert.n3y)), Float_Mul(CAD_Topo_FVert.n1z, CAD_Topo_FVert.n3z))
        CAD_Topo_FVert.d23 = Float_Add(Float_Add(Float_Mul(CAD_Topo_FVert.n2x, CAD_Topo_FVert.n3x), Float_Mul(CAD_Topo_FVert.n2y, CAD_Topo_FVert.n3y)), Float_Mul(CAD_Topo_FVert.n2z, CAD_Topo_FVert.n3z))
        CAD_Topo_FVert.det = 0x3FF0000000000000
        CAD_Topo_FVert.det = Float_Sub(CAD_Topo_FVert.det, Float_Mul(CAD_Topo_FVert.d12, CAD_Topo_FVert.d12))
        CAD_Topo_FVert.det = Float_Sub(CAD_Topo_FVert.det, Float_Mul(CAD_Topo_FVert.d13, CAD_Topo_FVert.d13))
        CAD_Topo_FVert.det = Float_Sub(CAD_Topo_FVert.det, Float_Mul(CAD_Topo_FVert.d23, CAD_Topo_FVert.d23))
        CAD_Topo_FVert.det = Float_Add(CAD_Topo_FVert.det, Float_Mul(0x4000000000000000, Float_Mul(CAD_Topo_FVert.d12, Float_Mul(CAD_Topo_FVert.d13, CAD_Topo_FVert.d23))))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FVert.det, 0), 1) ThenBlock: {
            PrintMessage("fillet VERTEX degenerate trihedral\n")
            ReturnValue(0)
        }
        CAD_Topo_FVert.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FVert.d12), CAD_Topo_FVert.d13)
        CAD_Topo_FVert.bb = Float_Sub(Float_Add(CAD_Topo_FVert.d12, CAD_Topo_FVert.d13), CAD_Topo_FVert.d23)
        CAD_Topo_FVert.ab = Float_Div(Float_Mul(CAD_Topo_FVert.s, Float_Add(CAD_Topo_FVert.aa, Float_Mul(CAD_Topo_FVert.d23, CAD_Topo_FVert.bb))), CAD_Topo_FVert.det)
        CAD_Topo_FVert.cx = Float_Add(CAD_Topo_FVert.px, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n1x))
        CAD_Topo_FVert.cy = Float_Add(CAD_Topo_FVert.py, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n1y))
        CAD_Topo_FVert.cz = Float_Add(CAD_Topo_FVert.pz, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n1z))
        CAD_Topo_FVert.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FVert.d12), CAD_Topo_FVert.d23)
        CAD_Topo_FVert.bb = Float_Sub(Float_Add(CAD_Topo_FVert.d12, CAD_Topo_FVert.d23), CAD_Topo_FVert.d13)
        CAD_Topo_FVert.ab = Float_Div(Float_Mul(CAD_Topo_FVert.s, Float_Add(CAD_Topo_FVert.aa, Float_Mul(CAD_Topo_FVert.d13, CAD_Topo_FVert.bb))), CAD_Topo_FVert.det)
        CAD_Topo_FVert.cx = Float_Add(CAD_Topo_FVert.cx, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n2x))
        CAD_Topo_FVert.cy = Float_Add(CAD_Topo_FVert.cy, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n2y))
        CAD_Topo_FVert.cz = Float_Add(CAD_Topo_FVert.cz, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n2z))
        CAD_Topo_FVert.aa = Float_Sub(Float_Sub(0x3FF0000000000000, CAD_Topo_FVert.d13), CAD_Topo_FVert.d23)
        CAD_Topo_FVert.bb = Float_Sub(Float_Add(CAD_Topo_FVert.d13, CAD_Topo_FVert.d23), CAD_Topo_FVert.d12)
        CAD_Topo_FVert.ab = Float_Div(Float_Mul(CAD_Topo_FVert.s, Float_Add(CAD_Topo_FVert.aa, Float_Mul(CAD_Topo_FVert.d12, CAD_Topo_FVert.bb))), CAD_Topo_FVert.det)
        CAD_Topo_FVert.cx = Float_Add(CAD_Topo_FVert.cx, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n3x))
        CAD_Topo_FVert.cy = Float_Add(CAD_Topo_FVert.cy, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n3y))
        CAD_Topo_FVert.cz = Float_Add(CAD_Topo_FVert.cz, Float_Mul(CAD_Topo_FVert.ab, CAD_Topo_FVert.n3z))
        ArraySet(CAD_Topo_FVert.pt, 0, Float_Sub(CAD_Topo_FVert.cx, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n1x)))
        ArraySet(CAD_Topo_FVert.pt, 1, Float_Sub(CAD_Topo_FVert.cy, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n1y)))
        ArraySet(CAD_Topo_FVert.pt, 2, Float_Sub(CAD_Topo_FVert.cz, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n1z)))
        CAD_Topo_FVert.t1 = CAD_Topo.MakeVertex(CAD_Topo_FVert.pt)
        ArraySet(CAD_Topo_FVert.pt, 0, Float_Sub(CAD_Topo_FVert.cx, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n2x)))
        ArraySet(CAD_Topo_FVert.pt, 1, Float_Sub(CAD_Topo_FVert.cy, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n2y)))
        ArraySet(CAD_Topo_FVert.pt, 2, Float_Sub(CAD_Topo_FVert.cz, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n2z)))
        CAD_Topo_FVert.t2 = CAD_Topo.MakeVertex(CAD_Topo_FVert.pt)
        ArraySet(CAD_Topo_FVert.pt, 0, Float_Sub(CAD_Topo_FVert.cx, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n3x)))
        ArraySet(CAD_Topo_FVert.pt, 1, Float_Sub(CAD_Topo_FVert.cy, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n3y)))
        ArraySet(CAD_Topo_FVert.pt, 2, Float_Sub(CAD_Topo_FVert.cz, Float_Mul(CAD_Topo_FVert.s, CAD_Topo_FVert.n3z)))
        CAD_Topo_FVert.t3 = CAD_Topo.MakeVertex(CAD_Topo_FVert.pt)
        IfCondition EqualTo(CAD_Topo_FVert.t1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FVert.t3, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.a12 = CAD_Topo.FilletSphereArc(CAD_Topo_FVert.t1, CAD_Topo_FVert.t2)
        CAD_Topo_FVert.a23 = CAD_Topo.FilletSphereArc(CAD_Topo_FVert.t2, CAD_Topo_FVert.t3)
        CAD_Topo_FVert.a31 = CAD_Topo.FilletSphereArc(CAD_Topo_FVert.t3, CAD_Topo_FVert.t1)
        IfCondition EqualTo(CAD_Topo_FVert.a12, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_FVert.a31, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FVert.a12, 0), CAD_Topo_FVert.t1) ThenBlock: { CAD_Topo_FVert.which = 0 }
        ArraySet(CAD_Topo_FVert.ring, 0, CAD_Topo.MakeCoedge(CAD_Topo_FVert.a12, CAD_Topo_FVert.t1, CAD_Topo_FVert.which))
        CAD_Store.Write(CAD_Topo_FVert.a12, 3, ArrayGet(CAD_Topo_FVert.ring, 0))
        CAD_Topo_FVert.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FVert.a23, 0), CAD_Topo_FVert.t2) ThenBlock: { CAD_Topo_FVert.which = 0 }
        ArraySet(CAD_Topo_FVert.ring, 1, CAD_Topo.MakeCoedge(CAD_Topo_FVert.a23, CAD_Topo_FVert.t2, CAD_Topo_FVert.which))
        CAD_Store.Write(CAD_Topo_FVert.a23, 3, ArrayGet(CAD_Topo_FVert.ring, 1))
        CAD_Topo_FVert.which = 1
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FVert.a31, 0), CAD_Topo_FVert.t3) ThenBlock: { CAD_Topo_FVert.which = 0 }
        ArraySet(CAD_Topo_FVert.ring, 2, CAD_Topo.MakeCoedge(CAD_Topo_FVert.a31, CAD_Topo_FVert.t3, CAD_Topo_FVert.which))
        CAD_Store.Write(CAD_Topo_FVert.a31, 3, ArrayGet(CAD_Topo_FVert.ring, 2))
        CAD_Topo_FVert.lp = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_FVert.ring, 0))
        CAD_Topo.LinkLoopRing(CAD_Topo_FVert.ring, 3, CAD_Topo_FVert.lp)
        ArraySet(CAD_Topo_FVert.pt, 0, CAD_Topo_FVert.cx)
        ArraySet(CAD_Topo_FVert.pt, 1, CAD_Topo_FVert.cy)
        ArraySet(CAD_Topo_FVert.pt, 2, CAD_Topo_FVert.cz)
        CAD_Topo_FVert.surf = CAD_Geom.MakeSphereSurf(CAD_Topo_FVert.pt, CAD_Topo_FVert.r)
        IfCondition EqualTo(CAD_Topo_FVert.surf, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FVert.face = CAD_Topo.MakeFace(CAD_Topo_FVert.surf, CAD_Topo_FVert.lp)
        IfCondition EqualTo(CAD_Topo_FVert.face, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo.ShellAppendFace(CAD_Store.Read(CAD_Topo_FVert.solid, 0), CAD_Topo_FVert.face)
        // Stitch: retarget cylinder generators onto Ti, swap end-arcs
        // for the sphere's great-circle arcs (twins). Cove join: skip.
        // Extending the wall generators off the pad plane made the
        // frustum + flying host triangle (17-47). Sphere still sits
        // in the gutter; cylinders keep the original span.
        CAD_Topo_FVert.sh = CAD_Store.Read(CAD_Topo_FVert.solid, 0)
        IfCondition EqualTo(CAD_Topo_State.fillet_concave, 1) ThenBlock: {
            CAD_Topo_FVert.sh = 0
            PrintMessage("fillet VERTEX sphere no-stitch cove\n")
        }
        CAD_Topo_FVert.sg = 0
        WhileLoop NotEqual(CAD_Topo_FVert.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FVert.sg, 64) ThenBlock: { CAD_Topo_FVert.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FVert.sh, 0) ThenBlock: {
                CAD_Topo_FVert.k = CAD_Store.Read(CAD_Topo_FVert.sh, 0)
                CAD_Topo_FVert.fg = 0
                WhileLoop NotEqual(CAD_Topo_FVert.k, 0) {
                    IfCondition GreaterThan(CAD_Topo_FVert.fg, 4096) ThenBlock: { CAD_Topo_FVert.k = 0 }
                    IfCondition NotEqual(CAD_Topo_FVert.k, 0) ThenBlock: {
                        CAD_Topo_FVert.surf = CAD_Store.Read(CAD_Topo_FVert.k, 0)
                        CAD_Topo_FVert.ok = 0
                        IfCondition NotEqual(CAD_Topo_FVert.surf, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FVert.surf, 0), 2) ThenBlock: { CAD_Topo_FVert.ok = 1 }
                        }
                        IfCondition EqualTo(CAD_Topo_FVert.ok, 1) ThenBlock: {
                            CAD_Topo_FVert.lp = CAD_Store.Read(CAD_Topo_FVert.k, 1)
                            IfCondition NotEqual(CAD_Topo_FVert.lp, 0) ThenBlock: {
                                CAD_Topo_FVert.ce = CAD_Store.Read(CAD_Topo_FVert.lp, 0)
                                CAD_Topo_FVert.hd = CAD_Topo_FVert.ce
                                CAD_Topo_FVert.g = 0
                                WhileLoop LessThan(CAD_Topo_FVert.g, 8) {
                                    IfCondition EqualTo(CAD_Topo_FVert.ce, 0) ThenBlock: { CAD_Topo_FVert.g = 8 }
                                    IfCondition NotEqual(CAD_Topo_FVert.ce, 0) ThenBlock: {
                                        CAD_Topo_FVert.e = CAD_Store.Read(CAD_Topo_FVert.ce, 0)
                                        IfCondition NotEqual(CAD_Topo_FVert.e, 0) ThenBlock: {
                                            CAD_Topo_FVert.v0 = CAD_Store.Read(CAD_Topo_FVert.e, 0)
                                            CAD_Topo_FVert.v1 = CAD_Store.Read(CAD_Topo_FVert.e, 1)
                                            CAD_Topo_FVert.which = CAD_Store.Read(CAD_Topo_FVert.e, 2)
                                            CAD_Topo_FVert.aa = 0
                                            IfCondition NotEqual(CAD_Topo_FVert.which, 0) ThenBlock: {
                                                CAD_Topo_FVert.aa = CAD_Store.Read(CAD_Topo_FVert.which, 0)
                                            }
                                            IfCondition EqualTo(CAD_Topo_FVert.aa, 1) ThenBlock: {
                                                CAD_Topo_FVert.ta = CAD_Topo.FilletNearT(CAD_Topo_FVert.v0)
                                                CAD_Topo_FVert.tb = CAD_Topo.FilletNearT(CAD_Topo_FVert.v1)
                                                IfCondition NotEqual(CAD_Topo_FVert.ta, 0) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Topo_FVert.tb, 0) ThenBlock: {
                                                        CAD_Topo.EdgeRetargetVert(CAD_Topo_FVert.e, CAD_Topo_FVert.v0, CAD_Topo_FVert.ta)
                                                    }
                                                }
                                                IfCondition NotEqual(CAD_Topo_FVert.tb, 0) ThenBlock: {
                                                    IfCondition EqualTo(CAD_Topo_FVert.ta, 0) ThenBlock: {
                                                        CAD_Topo.EdgeRetargetVert(CAD_Topo_FVert.e, CAD_Topo_FVert.v1, CAD_Topo_FVert.tb)
                                                    }
                                                }
                                            }
                                            IfCondition EqualTo(CAD_Topo_FVert.aa, 2) ThenBlock: {
                                                CAD_Topo_FVert.ta = CAD_Topo.FilletNearT(CAD_Topo_FVert.v0)
                                                CAD_Topo_FVert.tb = CAD_Topo.FilletNearT(CAD_Topo_FVert.v1)
                                                IfCondition NotEqual(CAD_Topo_FVert.ta, 0) ThenBlock: {
                                                    IfCondition NotEqual(CAD_Topo_FVert.tb, 0) ThenBlock: {
                                                        IfCondition NotEqual(CAD_Topo_FVert.ta, CAD_Topo_FVert.tb) ThenBlock: {
                                                            CAD_Topo_FVert.which = 0
                                                            IfCondition EqualTo(CAD_Topo_FVert.ta, CAD_Topo_FVert.t1) ThenBlock: {
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t2) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a12 }
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t3) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a31 }
                                                            }
                                                            IfCondition EqualTo(CAD_Topo_FVert.ta, CAD_Topo_FVert.t2) ThenBlock: {
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t1) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a12 }
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t3) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a23 }
                                                            }
                                                            IfCondition EqualTo(CAD_Topo_FVert.ta, CAD_Topo_FVert.t3) ThenBlock: {
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t1) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a31 }
                                                                IfCondition EqualTo(CAD_Topo_FVert.tb, CAD_Topo_FVert.t2) ThenBlock: { CAD_Topo_FVert.which = CAD_Topo_FVert.a23 }
                                                            }
                                                            IfCondition NotEqual(CAD_Topo_FVert.which, 0) ThenBlock: {
                                                                IfCondition NotEqual(CAD_Topo_FVert.which, CAD_Topo_FVert.e) ThenBlock: {
                                                                    CAD_Topo_FVert.bb = CAD_Topo.FilletNearT(CAD_Store.Read(CAD_Topo_FVert.ce, 5))
                                                                    IfCondition EqualTo(CAD_Topo_FVert.bb, 0) ThenBlock: { CAD_Topo_FVert.bb = CAD_Topo_FVert.ta }
                                                                    CAD_Topo.CoedgeSwapEdge(CAD_Topo_FVert.ce, CAD_Topo_FVert.which, CAD_Topo_FVert.bb)
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        CAD_Topo_FVert.ce = CAD_Store.Read(CAD_Topo_FVert.ce, 2)
                                        IfCondition EqualTo(CAD_Topo_FVert.ce, CAD_Topo_FVert.hd) ThenBlock: { CAD_Topo_FVert.g = 8 }
                                    }
                                    CAD_Topo_FVert.g = Add(CAD_Topo_FVert.g, 1)
                                }
                            }
                        }
                        CAD_Topo_FVert.k = CAD_Store.Read(CAD_Topo_FVert.k, 3)
                    }
                    CAD_Topo_FVert.fg = Add(CAD_Topo_FVert.fg, 1)
                }
                CAD_Topo_FVert.sh = CAD_Store.Read(CAD_Topo_FVert.sh, 2)
            }
            CAD_Topo_FVert.sg = Add(CAD_Topo_FVert.sg, 1)
        }
        PrintMessage("fillet VERTEX sphere ok\n")
        ReturnValue(CAD_Topo_FVert.solid)
    }
}

Function.CAD_Topo.FilletVerticesAfter {
    Input: solid_handle: Integer
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FSeq.h = solid_handle
        CAD_Topo_FSeq.r = radius_r
        CAD_Topo_FVert.ii = 0
        CAD_Topo_FSeq.nh = 0
        WhileLoop LessThan(CAD_Topo_FVert.ii, CAD_Topo_FVert.n) {
            IfCondition GreaterThan(ArrayGet(CAD_Topo_FVert.cnt, CAD_Topo_FVert.ii), 1) ThenBlock: {
                CAD_Topo_FVert.px = ArrayGet(CAD_Topo_FVert.xyz, Multiply(CAD_Topo_FVert.ii, 3))
                CAD_Topo_FVert.py = ArrayGet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.ii, 3), 1))
                CAD_Topo_FVert.pz = ArrayGet(CAD_Topo_FVert.xyz, Add(Multiply(CAD_Topo_FVert.ii, 3), 2))
                IfCondition NotEqual(CAD_Topo.FilletVertexSphere(CAD_Topo_FSeq.h, CAD_Topo_FSeq.r), 0) ThenBlock: {
                    CAD_Topo_FSeq.nh = Add(CAD_Topo_FSeq.nh, 1)
                }
            }
            CAD_Topo_FVert.ii = Add(CAD_Topo_FVert.ii, 1)
        }
        PrintMessage("fillet VERTEX done n=")
        PrintNumber(CAD_Topo_FSeq.nh)
        PrintMessage("\n")
        ReturnValue(CAD_Topo_FSeq.h)
    }
}
