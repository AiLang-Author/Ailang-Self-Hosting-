LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.MakeBoxRectNotchXSolid {
    Input: pack_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        dx = ArrayGet(pack_addr, 0)
        dy = ArrayGet(pack_addr, 1)
        dz = ArrayGet(pack_addr, 2)
        py0 = ArrayGet(pack_addr, 3)
        pz0 = ArrayGet(pack_addr, 4)
        py1 = ArrayGet(pack_addr, 5)
        pz1 = ArrayGet(pack_addr, 6)
        depth = ArrayGet(pack_addr, 7)
        IfCondition EqualTo(CAD_Num.IsZero(dx, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(py1, py0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(pz1, pz0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(depth, 0), 1) ThenBlock: { depth = dx }
        IfCondition EqualTo(Float_Le(dx, depth), 1) ThenBlock: { depth = dx }
        thr = 0
        IfCondition EqualTo(CAD_Num.IsEqual(depth, dx, 0), 1) ThenBlock: { thr = 1 }
        xf = depth
        IfCondition EqualTo(thr, 1) ThenBlock: { xf = dx }
        IfCondition EqualTo(Float_Le(py0, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(pz0, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(dy, py1), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(dz, pz1), 1) ThenBlock: { ReturnValue(0) }

        one = 0x3FF0000000000000
        zro = 0
        neg1 = 0xBFF0000000000000
        x0 = zro
        y0 = zro
        z0 = zro
        x1 = dx
        y1 = dy
        z1 = dz

        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(128)

        // outer box verts
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        v0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v3 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z1)
        v4 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v5 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v6 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v7 = CAD_Topo.MakeVertex(pt)

        // notch entry at x=0: n0..n3 (py0,pz0)->(py1,pz0)->(py1,pz1)->(py0,pz1)
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, pz0)
        n0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, py1)
        n1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 2, pz1)
        n2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, py0)
        n3 = CAD_Topo.MakeVertex(pt)
        // notch floor/exit at x=xf
        ArraySet(pt, 0, xf)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, pz0)
        m0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, py1)
        m1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 2, pz1)
        m2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, py0)
        m3 = CAD_Topo.MakeVertex(pt)

        // outer edges
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z0)
        e01 = CAD_Topo.MakeEdge(v0, v1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        e12 = CAD_Topo.MakeEdge(v1, v2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        e23 = CAD_Topo.MakeEdge(v2, v3, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        e30 = CAD_Topo.MakeEdge(v3, v0, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z1)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z1)
        e45 = CAD_Topo.MakeEdge(v4, v5, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        e56 = CAD_Topo.MakeEdge(v5, v6, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        e67 = CAD_Topo.MakeEdge(v6, v7, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        e74 = CAD_Topo.MakeEdge(v7, v4, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(p1b, 0, x0)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z1)
        e04 = CAD_Topo.MakeEdge(v0, v4, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 0, x1)
        e15 = CAD_Topo.MakeEdge(v1, v5, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 1, y1)
        e26 = CAD_Topo.MakeEdge(v2, v6, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 0, x0)
        e37 = CAD_Topo.MakeEdge(v3, v7, CAD_Geom.MakeLine(pt, p1b))

        // entry rect at x=0
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, pz0)
        ArraySet(p1b, 0, x0)
        ArraySet(p1b, 1, py1)
        ArraySet(p1b, 2, pz0)
        en01 = CAD_Topo.MakeEdge(n0, n1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, py1)
        ArraySet(p1b, 2, pz1)
        en12 = CAD_Topo.MakeEdge(n1, n2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 2, pz1)
        ArraySet(p1b, 1, py0)
        en23 = CAD_Topo.MakeEdge(n2, n3, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, py0)
        ArraySet(p1b, 2, pz0)
        en30 = CAD_Topo.MakeEdge(n3, n0, CAD_Geom.MakeLine(pt, p1b))
        // floor rect at x=xf
        ArraySet(pt, 0, xf)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, pz0)
        ArraySet(p1b, 0, xf)
        ArraySet(p1b, 1, py1)
        ArraySet(p1b, 2, pz0)
        em01 = CAD_Topo.MakeEdge(m0, m1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, py1)
        ArraySet(p1b, 2, pz1)
        em12 = CAD_Topo.MakeEdge(m1, m2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 2, pz1)
        ArraySet(p1b, 1, py0)
        em23 = CAD_Topo.MakeEdge(m2, m3, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, py0)
        ArraySet(p1b, 2, pz0)
        em30 = CAD_Topo.MakeEdge(m3, m0, CAD_Geom.MakeLine(pt, p1b))
        // verticals n→m along +X
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, pz0)
        ArraySet(p1b, 0, xf)
        ArraySet(p1b, 1, py0)
        ArraySet(p1b, 2, pz0)
        ev0 = CAD_Topo.MakeEdge(n0, m0, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, py1)
        ArraySet(p1b, 1, py1)
        ev1 = CAD_Topo.MakeEdge(n1, m1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 2, pz1)
        ArraySet(p1b, 2, pz1)
        ev2 = CAD_Topo.MakeEdge(n2, m2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, py0)
        ArraySet(p1b, 1, py0)
        ev3 = CAD_Topo.MakeEdge(n3, m3, CAD_Geom.MakeLine(pt, p1b))

        // outer coedges
        c01 = CAD_Topo.MakeCoedge(e01, v0, 1)
        c10 = CAD_Topo.MakeCoedge(e01, v1, 0)
        CAD_Topo.LinkTwins(c01, c10)
        CAD_Store.Write(e01, 3, c01)
        CAD_Store.Write(e01, 4, c10)
        c12 = CAD_Topo.MakeCoedge(e12, v1, 1)
        c21 = CAD_Topo.MakeCoedge(e12, v2, 0)
        CAD_Topo.LinkTwins(c12, c21)
        CAD_Store.Write(e12, 3, c12)
        CAD_Store.Write(e12, 4, c21)
        c23 = CAD_Topo.MakeCoedge(e23, v2, 1)
        c32 = CAD_Topo.MakeCoedge(e23, v3, 0)
        CAD_Topo.LinkTwins(c23, c32)
        CAD_Store.Write(e23, 3, c23)
        CAD_Store.Write(e23, 4, c32)
        c30 = CAD_Topo.MakeCoedge(e30, v3, 1)
        c03 = CAD_Topo.MakeCoedge(e30, v0, 0)
        CAD_Topo.LinkTwins(c30, c03)
        CAD_Store.Write(e30, 3, c30)
        CAD_Store.Write(e30, 4, c03)
        c45 = CAD_Topo.MakeCoedge(e45, v4, 1)
        c54 = CAD_Topo.MakeCoedge(e45, v5, 0)
        CAD_Topo.LinkTwins(c45, c54)
        CAD_Store.Write(e45, 3, c45)
        CAD_Store.Write(e45, 4, c54)
        c56 = CAD_Topo.MakeCoedge(e56, v5, 1)
        c65 = CAD_Topo.MakeCoedge(e56, v6, 0)
        CAD_Topo.LinkTwins(c56, c65)
        CAD_Store.Write(e56, 3, c56)
        CAD_Store.Write(e56, 4, c65)
        c67 = CAD_Topo.MakeCoedge(e67, v6, 1)
        c76 = CAD_Topo.MakeCoedge(e67, v7, 0)
        CAD_Topo.LinkTwins(c67, c76)
        CAD_Store.Write(e67, 3, c67)
        CAD_Store.Write(e67, 4, c76)
        c74 = CAD_Topo.MakeCoedge(e74, v7, 1)
        c47 = CAD_Topo.MakeCoedge(e74, v4, 0)
        CAD_Topo.LinkTwins(c74, c47)
        CAD_Store.Write(e74, 3, c74)
        CAD_Store.Write(e74, 4, c47)
        c04 = CAD_Topo.MakeCoedge(e04, v0, 1)
        c40 = CAD_Topo.MakeCoedge(e04, v4, 0)
        CAD_Topo.LinkTwins(c04, c40)
        CAD_Store.Write(e04, 3, c04)
        CAD_Store.Write(e04, 4, c40)
        c15 = CAD_Topo.MakeCoedge(e15, v1, 1)
        c51 = CAD_Topo.MakeCoedge(e15, v5, 0)
        CAD_Topo.LinkTwins(c15, c51)
        CAD_Store.Write(e15, 3, c15)
        CAD_Store.Write(e15, 4, c51)
        c26 = CAD_Topo.MakeCoedge(e26, v2, 1)
        c62 = CAD_Topo.MakeCoedge(e26, v6, 0)
        CAD_Topo.LinkTwins(c26, c62)
        CAD_Store.Write(e26, 3, c26)
        CAD_Store.Write(e26, 4, c62)
        c37 = CAD_Topo.MakeCoedge(e37, v3, 1)
        c73 = CAD_Topo.MakeCoedge(e37, v7, 0)
        CAD_Topo.LinkTwins(c37, c73)
        CAD_Store.Write(e37, 3, c37)
        CAD_Store.Write(e37, 4, c73)

        // entry: wall forward n0→n1→n2→n3, face hole reverse
        cn01w = CAD_Topo.MakeCoedge(en01, n0, 1)
        cn01f = CAD_Topo.MakeCoedge(en01, n1, 0)
        CAD_Topo.LinkTwins(cn01w, cn01f)
        CAD_Store.Write(en01, 3, cn01w)
        CAD_Store.Write(en01, 4, cn01f)
        cn12w = CAD_Topo.MakeCoedge(en12, n1, 1)
        cn12f = CAD_Topo.MakeCoedge(en12, n2, 0)
        CAD_Topo.LinkTwins(cn12w, cn12f)
        CAD_Store.Write(en12, 3, cn12w)
        CAD_Store.Write(en12, 4, cn12f)
        cn23w = CAD_Topo.MakeCoedge(en23, n2, 1)
        cn23f = CAD_Topo.MakeCoedge(en23, n3, 0)
        CAD_Topo.LinkTwins(cn23w, cn23f)
        CAD_Store.Write(en23, 3, cn23w)
        CAD_Store.Write(en23, 4, cn23f)
        cn30w = CAD_Topo.MakeCoedge(en30, n3, 1)
        cn30f = CAD_Topo.MakeCoedge(en30, n0, 0)
        CAD_Topo.LinkTwins(cn30w, cn30f)
        CAD_Store.Write(en30, 3, cn30w)
        CAD_Store.Write(en30, 4, cn30f)

        // floor: face forward m0→m1→m2→m3, wall reverse
        cm01f = CAD_Topo.MakeCoedge(em01, m0, 1)
        cm01w = CAD_Topo.MakeCoedge(em01, m1, 0)
        CAD_Topo.LinkTwins(cm01f, cm01w)
        CAD_Store.Write(em01, 3, cm01f)
        CAD_Store.Write(em01, 4, cm01w)
        cm12f = CAD_Topo.MakeCoedge(em12, m1, 1)
        cm12w = CAD_Topo.MakeCoedge(em12, m2, 0)
        CAD_Topo.LinkTwins(cm12f, cm12w)
        CAD_Store.Write(em12, 3, cm12f)
        CAD_Store.Write(em12, 4, cm12w)
        cm23f = CAD_Topo.MakeCoedge(em23, m2, 1)
        cm23w = CAD_Topo.MakeCoedge(em23, m3, 0)
        CAD_Topo.LinkTwins(cm23f, cm23w)
        CAD_Store.Write(em23, 3, cm23f)
        CAD_Store.Write(em23, 4, cm23w)
        cm30f = CAD_Topo.MakeCoedge(em30, m3, 1)
        cm30w = CAD_Topo.MakeCoedge(em30, m0, 0)
        CAD_Topo.LinkTwins(cm30f, cm30w)
        CAD_Store.Write(em30, 3, cm30f)
        CAD_Store.Write(em30, 4, cm30w)

        cv0u = CAD_Topo.MakeCoedge(ev0, n0, 1)
        cv0d = CAD_Topo.MakeCoedge(ev0, m0, 0)
        CAD_Topo.LinkTwins(cv0u, cv0d)
        CAD_Store.Write(ev0, 3, cv0u)
        CAD_Store.Write(ev0, 4, cv0d)
        cv1u = CAD_Topo.MakeCoedge(ev1, n1, 1)
        cv1d = CAD_Topo.MakeCoedge(ev1, m1, 0)
        CAD_Topo.LinkTwins(cv1u, cv1d)
        CAD_Store.Write(ev1, 3, cv1u)
        CAD_Store.Write(ev1, 4, cv1d)
        cv2u = CAD_Topo.MakeCoedge(ev2, n2, 1)
        cv2d = CAD_Topo.MakeCoedge(ev2, m2, 0)
        CAD_Topo.LinkTwins(cv2u, cv2d)
        CAD_Store.Write(ev2, 3, cv2u)
        CAD_Store.Write(ev2, 4, cv2d)
        cv3u = CAD_Topo.MakeCoedge(ev3, n3, 1)
        cv3d = CAD_Topo.MakeCoedge(ev3, m3, 0)
        CAD_Topo.LinkTwins(cv3u, cv3d)
        CAD_Store.Write(ev3, 3, cv3u)
        CAD_Store.Write(ev3, 4, cv3d)

        // planes
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, z1)
        ArraySet(ay, 1, one)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, z0)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        pl_y0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 1, y1)
        ArraySet(ax, 0, neg1)
        pl_y1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(ax, 0, zro)
        ArraySet(ax, 1, neg1)
        ArraySet(ax, 2, zro)
        pl_x0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 0, x1)
        ArraySet(ax, 1, one)
        pl_x1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        // floor at x=xf N=-X into cavity
        ArraySet(pt, 0, xf)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, pz0)
        ArraySet(ax, 0, zro)
        ArraySet(ax, 1, one)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        ArraySet(ax, 1, neg1)
        pl_fl = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        // wall planes (into cavity)
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, pz0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        ArraySet(ay, 2, neg1)
        pl_ws = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 1, py1)
        ArraySet(ay, 2, one)
        pl_wn = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, pz0)
        ArraySet(ax, 0, zro)
        ArraySet(ax, 1, one)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, one)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, zro)
        // wait wall bottom z=pz0: N=+Z into cavity. X=(0,1,0) Y=(1,0,0) → N = j×i = -k? 
        // X=(1,0,0) Y=(0,1,0) N=+Z
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, one)
        ArraySet(ay, 2, zro)
        pl_wb = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, pz1)
        ArraySet(ay, 1, neg1)
        pl_wt = CAD_Geom.MakePlaneAxes(pt, ax, ay)

        // LEFT x=0 outer + hole reverse: n0→n3→n2→n1
        ArraySet(ring, 0, c04)
        ArraySet(ring, 1, c47)
        ArraySet(ring, 2, c73)
        ArraySet(ring, 3, c30)
        lp_l = CAD_Topo.MakeLoop(c04)
        CAD_Topo.LinkLoopRing(ring, 4, lp_l)
        ArraySet(ring, 0, cn30f)
        ArraySet(ring, 1, cn23f)
        ArraySet(ring, 2, cn12f)
        ArraySet(ring, 3, cn01f)
        lp_li = CAD_Topo.MakeLoop(cn30f)
        CAD_Topo.LinkLoopRing(ring, 4, lp_li)
        CAD_Store.Write(lp_l, 2, lp_li)
        f_x0 = CAD_Topo.MakeFace(pl_x0, lp_l)

        // RIGHT x=dx
        ArraySet(ring, 0, c12)
        ArraySet(ring, 1, c26)
        ArraySet(ring, 2, c65)
        ArraySet(ring, 3, c51)
        lp_r = CAD_Topo.MakeLoop(c12)
        CAD_Topo.LinkLoopRing(ring, 4, lp_r)
        IfCondition EqualTo(thr, 1) ThenBlock: {
            ArraySet(ring, 0, cm01f)
            ArraySet(ring, 1, cm12f)
            ArraySet(ring, 2, cm23f)
            ArraySet(ring, 3, cm30f)
            lp_ri = CAD_Topo.MakeLoop(cm01f)
            CAD_Topo.LinkLoopRing(ring, 4, lp_ri)
            CAD_Store.Write(lp_r, 2, lp_ri)
        }
        f_x1 = CAD_Topo.MakeFace(pl_x1, lp_r)

        ArraySet(ring, 0, c03)
        ArraySet(ring, 1, c32)
        ArraySet(ring, 2, c21)
        ArraySet(ring, 3, c10)
        lp_bo = CAD_Topo.MakeLoop(c03)
        CAD_Topo.LinkLoopRing(ring, 4, lp_bo)
        f_bot = CAD_Topo.MakeFace(pl_bot, lp_bo)
        ArraySet(ring, 0, c45)
        ArraySet(ring, 1, c56)
        ArraySet(ring, 2, c67)
        ArraySet(ring, 3, c74)
        lp_to = CAD_Topo.MakeLoop(c45)
        CAD_Topo.LinkLoopRing(ring, 4, lp_to)
        f_top = CAD_Topo.MakeFace(pl_top, lp_to)
        ArraySet(ring, 0, c01)
        ArraySet(ring, 1, c15)
        ArraySet(ring, 2, c54)
        ArraySet(ring, 3, c40)
        lp_y0 = CAD_Topo.MakeLoop(c01)
        CAD_Topo.LinkLoopRing(ring, 4, lp_y0)
        f_y0 = CAD_Topo.MakeFace(pl_y0, lp_y0)
        ArraySet(ring, 0, c37)
        ArraySet(ring, 1, c76)
        ArraySet(ring, 2, c62)
        ArraySet(ring, 3, c23)
        lp_y1 = CAD_Topo.MakeLoop(c37)
        CAD_Topo.LinkLoopRing(ring, 4, lp_y1)
        f_y1 = CAD_Topo.MakeFace(pl_y1, lp_y1)

        f_fl = 0
        IfCondition EqualTo(thr, 0) ThenBlock: {
            ArraySet(ring, 0, cm01f)
            ArraySet(ring, 1, cm12f)
            ArraySet(ring, 2, cm23f)
            ArraySet(ring, 3, cm30f)
            lp_fl = CAD_Topo.MakeLoop(cm01f)
            CAD_Topo.LinkLoopRing(ring, 4, lp_fl)
            f_fl = CAD_Topo.MakeFace(pl_fl, lp_fl)
        }

        // notch walls: bottom z=pz0, east y=py1, top z=pz1, west y=py0
        ArraySet(ring, 0, cn01w)
        ArraySet(ring, 1, cv1u)
        ArraySet(ring, 2, cm01w)
        ArraySet(ring, 3, cv0d)
        lp_wb = CAD_Topo.MakeLoop(cn01w)
        CAD_Topo.LinkLoopRing(ring, 4, lp_wb)
        f_wb = CAD_Topo.MakeFace(pl_wb, lp_wb)
        ArraySet(ring, 0, cn12w)
        ArraySet(ring, 1, cv2u)
        ArraySet(ring, 2, cm12w)
        ArraySet(ring, 3, cv1d)
        lp_we2 = CAD_Topo.MakeLoop(cn12w)
        CAD_Topo.LinkLoopRing(ring, 4, lp_we2)
        f_we2 = CAD_Topo.MakeFace(pl_wn, lp_we2)
        ArraySet(ring, 0, cn23w)
        ArraySet(ring, 1, cv3u)
        ArraySet(ring, 2, cm23w)
        ArraySet(ring, 3, cv2d)
        lp_wt = CAD_Topo.MakeLoop(cn23w)
        CAD_Topo.LinkLoopRing(ring, 4, lp_wt)
        f_wt = CAD_Topo.MakeFace(pl_wt, lp_wt)
        ArraySet(ring, 0, cn30w)
        ArraySet(ring, 1, cv0u)
        ArraySet(ring, 2, cm30w)
        ArraySet(ring, 3, cv3d)
        lp_ww2 = CAD_Topo.MakeLoop(cn30w)
        CAD_Topo.LinkLoopRing(ring, 4, lp_ww2)
        f_ww2 = CAD_Topo.MakeFace(pl_ws, lp_ww2)

        CAD_Store.Write(f_bot, 3, f_top)
        CAD_Store.Write(f_top, 3, f_y0)
        CAD_Store.Write(f_y0, 3, f_y1)
        CAD_Store.Write(f_y1, 3, f_x0)
        CAD_Store.Write(f_x0, 3, f_x1)
        CAD_Store.Write(f_x1, 3, f_wb)
        CAD_Store.Write(f_wb, 3, f_we2)
        CAD_Store.Write(f_we2, 3, f_wt)
        CAD_Store.Write(f_wt, 3, f_ww2)
        IfCondition EqualTo(thr, 0) ThenBlock: {
            CAD_Store.Write(f_ww2, 3, f_fl)
            CAD_Store.Write(f_fl, 3, 0)
        }
        IfCondition EqualTo(thr, 1) ThenBlock: {
            CAD_Store.Write(f_ww2, 3, 0)
        }
        h_sh = CAD_Topo.MakeShell(f_bot)
        ff = f_bot
        fguard = 0
        WhileLoop NotEqual(ff, 0) {
            CAD_Store.Write(ff, 2, h_sh)
            ff = CAD_Store.Read(ff, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 32) ThenBlock: { ff = 0 }
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 128)
        ReturnValue(h_so)
    }
}



// Plate [0,dx]x[0,dy]x[0,dz] with rectangular boss on top.
// pack: [dx,dy,dz, px0,py0,px1,py1, hgt] boss strictly inside top XY.
// Kind 0 stepped shell (walk STEP). Returns solid or 0.
Function.CAD_Topo.MakeBoxBossSolid {
    Input: pack_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        dx = ArrayGet(pack_addr, 0)
        dy = ArrayGet(pack_addr, 1)
        dz = ArrayGet(pack_addr, 2)
        px0 = ArrayGet(pack_addr, 3)
        py0 = ArrayGet(pack_addr, 4)
        px1 = ArrayGet(pack_addr, 5)
        py1 = ArrayGet(pack_addr, 6)
        hgt = ArrayGet(pack_addr, 7)
        IfCondition EqualTo(CAD_Num.IsZero(dx, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(hgt, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(px1, px0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(py1, py0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(px0, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(py0, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(dx, px1), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(dy, py1), 1) ThenBlock: { ReturnValue(0) }

        one = 0x3FF0000000000000
        zro = 0
        neg1 = 0xBFF0000000000000
        x0 = zro
        y0 = zro
        z0 = zro
        x1 = dx
        y1 = dy
        z1 = dz
        z2 = Float_Add(dz, hgt)

        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(128)

        // base 8 verts
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        v0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v3 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z1)
        v4 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v5 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v6 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v7 = CAD_Topo.MakeVertex(pt)

        // boss footprint at z=dz: b0..b3
        ArraySet(pt, 0, px0)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, z1)
        b0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, px1)
        b1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, py1)
        b2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, px0)
        b3 = CAD_Topo.MakeVertex(pt)
        // boss top at z2: t0..t3
        ArraySet(pt, 2, z2)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 0, px0)
        t0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, px1)
        t1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, py1)
        t2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, px0)
        t3 = CAD_Topo.MakeVertex(pt)

        // base outer edges (same as box)
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z0)
        e01 = CAD_Topo.MakeEdge(v0, v1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        e12 = CAD_Topo.MakeEdge(v1, v2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        e23 = CAD_Topo.MakeEdge(v2, v3, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        e30 = CAD_Topo.MakeEdge(v3, v0, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z1)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z1)
        e45 = CAD_Topo.MakeEdge(v4, v5, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        e56 = CAD_Topo.MakeEdge(v5, v6, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        e67 = CAD_Topo.MakeEdge(v6, v7, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        e74 = CAD_Topo.MakeEdge(v7, v4, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(p1b, 0, x0)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z1)
        e04 = CAD_Topo.MakeEdge(v0, v4, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 0, x1)
        e15 = CAD_Topo.MakeEdge(v1, v5, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 1, y1)
        e26 = CAD_Topo.MakeEdge(v2, v6, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 0, x0)
        e37 = CAD_Topo.MakeEdge(v3, v7, CAD_Geom.MakeLine(pt, p1b))

        // boss footprint edges at z1
        ArraySet(pt, 0, px0)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, z1)
        ArraySet(p1b, 0, px1)
        ArraySet(p1b, 1, py0)
        ArraySet(p1b, 2, z1)
        eb01 = CAD_Topo.MakeEdge(b0, b1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, px1)
        ArraySet(p1b, 1, py1)
        eb12 = CAD_Topo.MakeEdge(b1, b2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, py1)
        ArraySet(p1b, 0, px0)
        eb23 = CAD_Topo.MakeEdge(b2, b3, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, px0)
        ArraySet(p1b, 1, py0)
        eb30 = CAD_Topo.MakeEdge(b3, b0, CAD_Geom.MakeLine(pt, p1b))
        // boss top edges
        ArraySet(pt, 0, px0)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, z2)
        ArraySet(p1b, 0, px1)
        ArraySet(p1b, 1, py0)
        ArraySet(p1b, 2, z2)
        et01 = CAD_Topo.MakeEdge(t0, t1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, px1)
        ArraySet(p1b, 1, py1)
        et12 = CAD_Topo.MakeEdge(t1, t2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, py1)
        ArraySet(p1b, 0, px0)
        et23 = CAD_Topo.MakeEdge(t2, t3, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, px0)
        ArraySet(p1b, 1, py0)
        et30 = CAD_Topo.MakeEdge(t3, t0, CAD_Geom.MakeLine(pt, p1b))
        // boss verticals b→t
        ArraySet(pt, 0, px0)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, z1)
        ArraySet(p1b, 0, px0)
        ArraySet(p1b, 1, py0)
        ArraySet(p1b, 2, z2)
        ev0 = CAD_Topo.MakeEdge(b0, t0, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, px1)
        ArraySet(p1b, 0, px1)
        ev1 = CAD_Topo.MakeEdge(b1, t1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, py1)
        ArraySet(p1b, 1, py1)
        ev2 = CAD_Topo.MakeEdge(b2, t2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, px0)
        ArraySet(p1b, 0, px0)
        ev3 = CAD_Topo.MakeEdge(b3, t3, CAD_Geom.MakeLine(pt, p1b))

        // outer coedges
        c01 = CAD_Topo.MakeCoedge(e01, v0, 1)
        c10 = CAD_Topo.MakeCoedge(e01, v1, 0)
        CAD_Topo.LinkTwins(c01, c10)
        CAD_Store.Write(e01, 3, c01)
        CAD_Store.Write(e01, 4, c10)
        c12 = CAD_Topo.MakeCoedge(e12, v1, 1)
        c21 = CAD_Topo.MakeCoedge(e12, v2, 0)
        CAD_Topo.LinkTwins(c12, c21)
        CAD_Store.Write(e12, 3, c12)
        CAD_Store.Write(e12, 4, c21)
        c23 = CAD_Topo.MakeCoedge(e23, v2, 1)
        c32 = CAD_Topo.MakeCoedge(e23, v3, 0)
        CAD_Topo.LinkTwins(c23, c32)
        CAD_Store.Write(e23, 3, c23)
        CAD_Store.Write(e23, 4, c32)
        c30 = CAD_Topo.MakeCoedge(e30, v3, 1)
        c03 = CAD_Topo.MakeCoedge(e30, v0, 0)
        CAD_Topo.LinkTwins(c30, c03)
        CAD_Store.Write(e30, 3, c30)
        CAD_Store.Write(e30, 4, c03)
        c45 = CAD_Topo.MakeCoedge(e45, v4, 1)
        c54 = CAD_Topo.MakeCoedge(e45, v5, 0)
        CAD_Topo.LinkTwins(c45, c54)
        CAD_Store.Write(e45, 3, c45)
        CAD_Store.Write(e45, 4, c54)
        c56 = CAD_Topo.MakeCoedge(e56, v5, 1)
        c65 = CAD_Topo.MakeCoedge(e56, v6, 0)
        CAD_Topo.LinkTwins(c56, c65)
        CAD_Store.Write(e56, 3, c56)
        CAD_Store.Write(e56, 4, c65)
        c67 = CAD_Topo.MakeCoedge(e67, v6, 1)
        c76 = CAD_Topo.MakeCoedge(e67, v7, 0)
        CAD_Topo.LinkTwins(c67, c76)
        CAD_Store.Write(e67, 3, c67)
        CAD_Store.Write(e67, 4, c76)
        c74 = CAD_Topo.MakeCoedge(e74, v7, 1)
        c47 = CAD_Topo.MakeCoedge(e74, v4, 0)
        CAD_Topo.LinkTwins(c74, c47)
        CAD_Store.Write(e74, 3, c74)
        CAD_Store.Write(e74, 4, c47)
        c04 = CAD_Topo.MakeCoedge(e04, v0, 1)
        c40 = CAD_Topo.MakeCoedge(e04, v4, 0)
        CAD_Topo.LinkTwins(c04, c40)
        CAD_Store.Write(e04, 3, c04)
        CAD_Store.Write(e04, 4, c40)
        c15 = CAD_Topo.MakeCoedge(e15, v1, 1)
        c51 = CAD_Topo.MakeCoedge(e15, v5, 0)
        CAD_Topo.LinkTwins(c15, c51)
        CAD_Store.Write(e15, 3, c15)
        CAD_Store.Write(e15, 4, c51)
        c26 = CAD_Topo.MakeCoedge(e26, v2, 1)
        c62 = CAD_Topo.MakeCoedge(e26, v6, 0)
        CAD_Topo.LinkTwins(c26, c62)
        CAD_Store.Write(e26, 3, c26)
        CAD_Store.Write(e26, 4, c62)
        c37 = CAD_Topo.MakeCoedge(e37, v3, 1)
        c73 = CAD_Topo.MakeCoedge(e37, v7, 0)
        CAD_Topo.LinkTwins(c37, c73)
        CAD_Store.Write(e37, 3, c37)
        CAD_Store.Write(e37, 4, c73)

        // footprint: wall sense1 along edge, step sense0 (twins)
        cb01w = CAD_Topo.MakeCoedge(eb01, b0, 1)
        cb01s = CAD_Topo.MakeCoedge(eb01, b1, 0)
        CAD_Topo.LinkTwins(cb01w, cb01s)
        CAD_Store.Write(eb01, 3, cb01w)
        CAD_Store.Write(eb01, 4, cb01s)
        cb12w = CAD_Topo.MakeCoedge(eb12, b1, 1)
        cb12s = CAD_Topo.MakeCoedge(eb12, b2, 0)
        CAD_Topo.LinkTwins(cb12w, cb12s)
        CAD_Store.Write(eb12, 3, cb12w)
        CAD_Store.Write(eb12, 4, cb12s)
        cb23w = CAD_Topo.MakeCoedge(eb23, b2, 1)
        cb23s = CAD_Topo.MakeCoedge(eb23, b3, 0)
        CAD_Topo.LinkTwins(cb23w, cb23s)
        CAD_Store.Write(eb23, 3, cb23w)
        CAD_Store.Write(eb23, 4, cb23s)
        cb30w = CAD_Topo.MakeCoedge(eb30, b3, 1)
        cb30s = CAD_Topo.MakeCoedge(eb30, b0, 0)
        CAD_Topo.LinkTwins(cb30w, cb30s)
        CAD_Store.Write(eb30, 3, cb30w)
        CAD_Store.Write(eb30, 4, cb30s)

        ct01t = CAD_Topo.MakeCoedge(et01, t0, 1)
        ct01w = CAD_Topo.MakeCoedge(et01, t1, 0)
        CAD_Topo.LinkTwins(ct01t, ct01w)
        CAD_Store.Write(et01, 3, ct01t)
        CAD_Store.Write(et01, 4, ct01w)
        ct12t = CAD_Topo.MakeCoedge(et12, t1, 1)
        ct12w = CAD_Topo.MakeCoedge(et12, t2, 0)
        CAD_Topo.LinkTwins(ct12t, ct12w)
        CAD_Store.Write(et12, 3, ct12t)
        CAD_Store.Write(et12, 4, ct12w)
        ct23t = CAD_Topo.MakeCoedge(et23, t2, 1)
        ct23w = CAD_Topo.MakeCoedge(et23, t3, 0)
        CAD_Topo.LinkTwins(ct23t, ct23w)
        CAD_Store.Write(et23, 3, ct23t)
        CAD_Store.Write(et23, 4, ct23w)
        ct30t = CAD_Topo.MakeCoedge(et30, t3, 1)
        ct30w = CAD_Topo.MakeCoedge(et30, t0, 0)
        CAD_Topo.LinkTwins(ct30t, ct30w)
        CAD_Store.Write(et30, 3, ct30t)
        CAD_Store.Write(et30, 4, ct30w)

        cv0u = CAD_Topo.MakeCoedge(ev0, b0, 1)
        cv0d = CAD_Topo.MakeCoedge(ev0, t0, 0)
        CAD_Topo.LinkTwins(cv0u, cv0d)
        CAD_Store.Write(ev0, 3, cv0u)
        CAD_Store.Write(ev0, 4, cv0d)
        cv1u = CAD_Topo.MakeCoedge(ev1, b1, 1)
        cv1d = CAD_Topo.MakeCoedge(ev1, t1, 0)
        CAD_Topo.LinkTwins(cv1u, cv1d)
        CAD_Store.Write(ev1, 3, cv1u)
        CAD_Store.Write(ev1, 4, cv1d)
        cv2u = CAD_Topo.MakeCoedge(ev2, b2, 1)
        cv2d = CAD_Topo.MakeCoedge(ev2, t2, 0)
        CAD_Topo.LinkTwins(cv2u, cv2d)
        CAD_Store.Write(ev2, 3, cv2u)
        CAD_Store.Write(ev2, 4, cv2d)
        cv3u = CAD_Topo.MakeCoedge(ev3, b3, 1)
        cv3d = CAD_Topo.MakeCoedge(ev3, t3, 0)
        CAD_Topo.LinkTwins(cv3u, cv3d)
        CAD_Store.Write(ev3, 3, cv3u)
        CAD_Store.Write(ev3, 4, cv3d)

        // planes
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, z1)
        ArraySet(ay, 1, one)
        pl_step = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, z2)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, z0)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        pl_y0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 1, y1)
        ArraySet(ax, 0, neg1)
        pl_y1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(ax, 0, zro)
        ArraySet(ax, 1, neg1)
        ArraySet(ax, 2, zro)
        pl_x0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 0, x1)
        ArraySet(ax, 1, one)
        pl_x1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        // boss walls outward
        ArraySet(pt, 0, px0)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, z1)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        ArraySet(ay, 2, neg1)
        pl_ws = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 1, py1)
        ArraySet(ay, 2, one)
        pl_wn = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 1, py0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, one)
        ArraySet(ay, 2, zro)
        pl_wb = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 1, py1)
        ArraySet(ay, 1, neg1)
        // for top wall of boss at y? bottom edge b0-b1 at py0 is south wall with N=-Y outward
        // fix: south wall py0 N=-Y: X=+X Y=+Z → N=-Y
        ArraySet(pt, 0, px0)
        ArraySet(pt, 1, py0)
        ArraySet(pt, 2, z1)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        pl_wsouth = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 1, py1)
        ArraySet(ay, 2, neg1)
        pl_wnorth = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 0, px0)
        ArraySet(pt, 1, py0)
        ArraySet(ax, 0, zro)
        ArraySet(ax, 1, one)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        // west x=px0 N=-X: X=(0,1,0) Y=(0,0,1) → N=+X wrong; X=(0,-1,0) Y=(0,0,1) → N=-X
        ArraySet(ax, 1, neg1)
        pl_wwest = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 0, px1)
        ArraySet(ax, 1, one)
        pl_weast = CAD_Geom.MakePlaneAxes(pt, ax, ay)

        // BOTTOM
        ArraySet(ring, 0, c03)
        ArraySet(ring, 1, c32)
        ArraySet(ring, 2, c21)
        ArraySet(ring, 3, c10)
        lp_bo = CAD_Topo.MakeLoop(c03)
        CAD_Topo.LinkLoopRing(ring, 4, lp_bo)
        f_bot = CAD_Topo.MakeFace(pl_bot, lp_bo)

        // STEP at z=dz: outer top of base + inner boss footprint reverse
        ArraySet(ring, 0, c45)
        ArraySet(ring, 1, c56)
        ArraySet(ring, 2, c67)
        ArraySet(ring, 3, c74)
        lp_st = CAD_Topo.MakeLoop(c45)
        CAD_Topo.LinkLoopRing(ring, 4, lp_st)
        ArraySet(ring, 0, cb30s)
        ArraySet(ring, 1, cb23s)
        ArraySet(ring, 2, cb12s)
        ArraySet(ring, 3, cb01s)
        lp_si = CAD_Topo.MakeLoop(cb30s)
        CAD_Topo.LinkLoopRing(ring, 4, lp_si)
        CAD_Store.Write(lp_st, 2, lp_si)
        f_step = CAD_Topo.MakeFace(pl_step, lp_st)

        // base sides
        ArraySet(ring, 0, c01)
        ArraySet(ring, 1, c15)
        ArraySet(ring, 2, c54)
        ArraySet(ring, 3, c40)
        lp_y0 = CAD_Topo.MakeLoop(c01)
        CAD_Topo.LinkLoopRing(ring, 4, lp_y0)
        f_y0 = CAD_Topo.MakeFace(pl_y0, lp_y0)
        ArraySet(ring, 0, c12)
        ArraySet(ring, 1, c26)
        ArraySet(ring, 2, c65)
        ArraySet(ring, 3, c51)
        lp_x1 = CAD_Topo.MakeLoop(c12)
        CAD_Topo.LinkLoopRing(ring, 4, lp_x1)
        f_x1 = CAD_Topo.MakeFace(pl_x1, lp_x1)
        ArraySet(ring, 0, c23)
        ArraySet(ring, 1, c37)
        ArraySet(ring, 2, c76)
        ArraySet(ring, 3, c62)
        ArraySet(ring, 0, c37)
        ArraySet(ring, 1, c76)
        ArraySet(ring, 2, c62)
        ArraySet(ring, 3, c23)
        lp_y1 = CAD_Topo.MakeLoop(c37)
        CAD_Topo.LinkLoopRing(ring, 4, lp_y1)
        f_y1 = CAD_Topo.MakeFace(pl_y1, lp_y1)
        ArraySet(ring, 0, c04)
        ArraySet(ring, 1, c47)
        ArraySet(ring, 2, c73)
        ArraySet(ring, 3, c30)
        lp_x0 = CAD_Topo.MakeLoop(c04)
        CAD_Topo.LinkLoopRing(ring, 4, lp_x0)
        f_x0 = CAD_Topo.MakeFace(pl_x0, lp_x0)

        // boss top
        ArraySet(ring, 0, ct01t)
        ArraySet(ring, 1, ct12t)
        ArraySet(ring, 2, ct23t)
        ArraySet(ring, 3, ct30t)
        lp_tp = CAD_Topo.MakeLoop(ct01t)
        CAD_Topo.LinkLoopRing(ring, 4, lp_tp)
        f_top = CAD_Topo.MakeFace(pl_top, lp_tp)

        // boss walls: footprint forward, up, top rev, down
        // south py0: b0→b1, b1→t1, t1→t0, t0→b0
        // Use wall coedge on footprint: cb01w sense1 origin b1 - wrong
        // Need sense1 origin b0: recreate as using cb01w if sense1 origin b1...
        // Edge eb01 b0→b1. sense1 origin b0 → b0→b1.
        // I set cb01w = MakeCoedge(eb01, b1, 1) which is wrong (origin b1 sense1 = b1→?).
        // MakeCoedge(edge, origin, sense): if sense1, travel edge dir from origin which must be v0 of edge.
        // So wall: MakeCoedge(eb01, b0, 1). I had origin b1. Broken.
        // Fix by using only correctly constructed coedges for walls from verticals and top reverse and invent footprint wall by using the twin of step.
        // If step uses sense0, wall uses twin sense1.

        // South wall: start with twin of step coedge on eb01
        // cb01s is twin of cb01w. Use cb01w for wall.
        ArraySet(ring, 0, cb01w)
        ArraySet(ring, 1, cv1u)
        ArraySet(ring, 2, ct01w)
        ArraySet(ring, 3, cv0d)
        lp_ws = CAD_Topo.MakeLoop(cb01w)
        CAD_Topo.LinkLoopRing(ring, 4, lp_ws)
        f_ws = CAD_Topo.MakeFace(pl_wsouth, lp_ws)
        ArraySet(ring, 0, cb12w)
        ArraySet(ring, 1, cv2u)
        ArraySet(ring, 2, ct12w)
        ArraySet(ring, 3, cv1d)
        lp_we = CAD_Topo.MakeLoop(cb12w)
        CAD_Topo.LinkLoopRing(ring, 4, lp_we)
        f_we = CAD_Topo.MakeFace(pl_weast, lp_we)
        ArraySet(ring, 0, cb23w)
        ArraySet(ring, 1, cv3u)
        ArraySet(ring, 2, ct23w)
        ArraySet(ring, 3, cv2d)
        lp_wn = CAD_Topo.MakeLoop(cb23w)
        CAD_Topo.LinkLoopRing(ring, 4, lp_wn)
        f_wn = CAD_Topo.MakeFace(pl_wnorth, lp_wn)
        ArraySet(ring, 0, cb30w)
        ArraySet(ring, 1, cv0u)
        ArraySet(ring, 2, ct30w)
        ArraySet(ring, 3, cv3d)
        lp_ww = CAD_Topo.MakeLoop(cb30w)
        CAD_Topo.LinkLoopRing(ring, 4, lp_ww)
        f_ww = CAD_Topo.MakeFace(pl_wwest, lp_ww)

        CAD_Store.Write(f_bot, 3, f_step)
        CAD_Store.Write(f_step, 3, f_y0)
        CAD_Store.Write(f_y0, 3, f_x1)
        CAD_Store.Write(f_x1, 3, f_y1)
        CAD_Store.Write(f_y1, 3, f_x0)
        CAD_Store.Write(f_x0, 3, f_top)
        CAD_Store.Write(f_top, 3, f_ws)
        CAD_Store.Write(f_ws, 3, f_we)
        CAD_Store.Write(f_we, 3, f_wn)
        CAD_Store.Write(f_wn, 3, f_ww)
        CAD_Store.Write(f_ww, 3, 0)
        h_sh = CAD_Topo.MakeShell(f_bot)
        ff = f_bot
        fguard = 0
        WhileLoop NotEqual(ff, 0) {
            CAD_Store.Write(ff, 2, h_sh)
            ff = CAD_Store.Read(ff, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 32) ThenBlock: { ff = 0 }
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 128)
        ReturnValue(h_so)
    }
}





// -------------------------------------------------------------------------
// Edge-based plane–plane fillet (any faceted solid — not shape recipes)
// -------------------------------------------------------------------------

// Writes face handles to out_faces[0..1]. Returns 0 ok, -1 fail.
