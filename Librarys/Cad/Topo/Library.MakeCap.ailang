// CAD.Topo.MakeCap — split from Library.CAD_Topo.ailang
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.ChamferPrismCap {
    Input: solid_handle: Integer
    Input: D_r: Integer
    Input: on_top: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(D_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CAD_Topo.SolidCountShells(solid_handle), 1) ThenBlock: { ReturnValue(0) }
        xy = Allocate(16384)
        zpack = Allocate(32)
        n = CAD_Topo.ExtractBottomLoopXY(solid_handle, xy, zpack)
        IfCondition LessThan(n, 3) ThenBlock: {
            Deallocate(xy, 16384)
            Deallocate(zpack, 32)
            ReturnValue(0)
        }
        // InsetPolyXY treats CCW-left as inward. Bottom loops are often CW
        // (MakePolyPrism reverse) — that EXPANDED the cap and opened corners.
        area = 0
        ai = 0
        WhileLoop LessThan(ai, n) {
            aj = Add(ai, 1)
            IfCondition EqualTo(aj, n) ThenBlock: { aj = 0 }
            area = Float_Add(area, Float_Sub(Float_Mul(ArrayGet(xy, Multiply(ai, 2)), ArrayGet(xy, Add(Multiply(aj, 2), 1))), Float_Mul(ArrayGet(xy, Multiply(aj, 2)), ArrayGet(xy, Add(Multiply(ai, 2), 1)))))
            ai = Add(ai, 1)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(area), 1) ThenBlock: {
            lo = 0
            hi = Subtract(n, 1)
            WhileLoop LessThan(lo, hi) {
                tx = ArrayGet(xy, Multiply(lo, 2))
                ty = ArrayGet(xy, Add(Multiply(lo, 2), 1))
                ArraySet(xy, Multiply(lo, 2), ArrayGet(xy, Multiply(hi, 2)))
                ArraySet(xy, Add(Multiply(lo, 2), 1), ArrayGet(xy, Add(Multiply(hi, 2), 1)))
                ArraySet(xy, Multiply(hi, 2), tx)
                ArraySet(xy, Add(Multiply(hi, 2), 1), ty)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        zmin = ArrayGet(zpack, 0)
        zmax = ArrayGet(zpack, 1)
        H = Float_Sub(zmax, zmin)
        IfCondition EqualTo(Float_Le(H, D_r), 1) ThenBlock: {
            Deallocate(xy, 16384)
            Deallocate(zpack, 32)
            ReturnValue(0)
        }
        ins = Allocate(16384)
        ni = CAD_Topo.InsetPolyXY(xy, n, D_r, ins)
        IfCondition LessThan(ni, 3) ThenBlock: {
            Deallocate(xy, 16384)
            Deallocate(zpack, 32)
            Deallocate(ins, 16384)
            ReturnValue(0)
        }
        // z rings: bot / mid (wall top) / cap
        zb = zmin
        zm = Float_Sub(zmax, D_r)
        zc = zmax
        IfCondition EqualTo(on_top, 0) ThenBlock: {
            zb = zmax
            zm = Float_Add(zmin, D_r)
            zc = zmin
        }
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(16384)
        vb = Allocate(16384)
        vm = Allocate(16384)
        vc = Allocate(16384)
        i = 0
        WhileLoop LessThan(i, n) {
            x = ArrayGet(xy, Multiply(i, 2))
            y = ArrayGet(xy, Add(Multiply(i, 2), 1))
            ArraySet(pt, 0, x)
            ArraySet(pt, 1, y)
            ArraySet(pt, 2, zb)
            ArraySet(vb, i, CAD_Topo.MakeVertex(pt))
            ArraySet(pt, 2, zm)
            ArraySet(vm, i, CAD_Topo.MakeVertex(pt))
            ArraySet(pt, 0, ArrayGet(ins, Multiply(i, 2)))
            ArraySet(pt, 1, ArrayGet(ins, Add(Multiply(i, 2), 1)))
            ArraySet(pt, 2, zc)
            ArraySet(vc, i, CAD_Topo.MakeVertex(pt))
            i = Add(i, 1)
        }
        one = 0x3FF0000000000000
        zro = 0
        faces = Allocate(32768)
        nf = 0
        // helper via inline face maker
        // BOTTOM (or original top if chamfering bottom): loop vb
        i = 0
        WhileLoop LessThan(i, n) {
            k = Subtract(n, Add(i, 1))
            IfCondition EqualTo(on_top, 0) ThenBlock: { k = i }
            va = ArrayGet(vb, k)
            j = Add(k, 1)
            IfCondition EqualTo(on_top, 1) ThenBlock: {
                j = Subtract(k, 1)
                IfCondition LessThan(j, 0) ThenBlock: { j = Subtract(n, 1) }
            }
            IfCondition EqualTo(on_top, 0) ThenBlock: {
                IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            }
            vb2 = ArrayGet(vb, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, CAD_Store.Read(va, 2))
            ArraySet(p1b, 0, CAD_Store.Read(vb2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(vb2, 1))
            ArraySet(p1b, 2, CAD_Store.Read(vb2, 2))
            e = CAD_Topo.MakeEdge(va, vb2, CAD_Geom.MakeLine(pt, p1b))
            c0 = CAD_Topo.MakeCoedge(e, va, 1)
            CAD_Store.Write(e, 3, c0)
            ArraySet(ring, i, c0)
            i = Add(i, 1)
        }
        ArraySet(pt, 0, ArrayGet(xy, 0))
        ArraySet(pt, 1, ArrayGet(xy, 1))
        ArraySet(pt, 2, zb)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, one)
        ArraySet(ay, 2, zro)
        IfCondition EqualTo(on_top, 1) ThenBlock: {
            ArraySet(ay, 1, 0xBFF0000000000000)
        }
        sbot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        lp = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n, lp)
        ArraySet(faces, nf, CAD_Topo.MakeFace(sbot, lp))
        nf = Add(nf, 1)
        // SIDE quads vb-vm
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            a0 = ArrayGet(vb, i)
            a1 = ArrayGet(vb, j)
            a2 = ArrayGet(vm, j)
            a3 = ArrayGet(vm, i)
            ArraySet(pt, 0, CAD_Store.Read(a0, 0))
            ArraySet(pt, 1, CAD_Store.Read(a0, 1))
            ArraySet(pt, 2, CAD_Store.Read(a0, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a1, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a1, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a1, 2))
            e0 = CAD_Topo.MakeEdge(a0, a1, CAD_Geom.MakeLine(pt, p1b))
            ArraySet(pt, 2, CAD_Store.Read(a2, 2))
            ArraySet(p1b, 2, CAD_Store.Read(a2, 2))
            ArraySet(pt, 0, CAD_Store.Read(a1, 0))
            ArraySet(pt, 1, CAD_Store.Read(a1, 1))
            ArraySet(p1b, 0, CAD_Store.Read(a2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a2, 1))
            e1 = CAD_Topo.MakeEdge(a1, a2, CAD_Geom.MakeLine(pt, p1b))
            ArraySet(pt, 0, CAD_Store.Read(a2, 0))
            ArraySet(pt, 1, CAD_Store.Read(a2, 1))
            ArraySet(pt, 2, CAD_Store.Read(a2, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a3, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a3, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a3, 2))
            e2 = CAD_Topo.MakeEdge(a2, a3, CAD_Geom.MakeLine(pt, p1b))
            ArraySet(pt, 0, CAD_Store.Read(a3, 0))
            ArraySet(pt, 1, CAD_Store.Read(a3, 1))
            ArraySet(pt, 2, CAD_Store.Read(a3, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a0, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a0, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a0, 2))
            e3 = CAD_Topo.MakeEdge(a3, a0, CAD_Geom.MakeLine(pt, p1b))
            c0 = CAD_Topo.MakeCoedge(e0, a0, 1)
            c1 = CAD_Topo.MakeCoedge(e1, a1, 1)
            c2 = CAD_Topo.MakeCoedge(e2, a2, 1)
            c3 = CAD_Topo.MakeCoedge(e3, a3, 1)
            CAD_Store.Write(e0, 3, c0)
            CAD_Store.Write(e1, 3, c1)
            CAD_Store.Write(e2, 3, c2)
            CAD_Store.Write(e3, 3, c3)
            ArraySet(ring, 0, c0)
            ArraySet(ring, 1, c1)
            ArraySet(ring, 2, c2)
            ArraySet(ring, 3, c3)
            lp = CAD_Topo.MakeLoop(c0)
            CAD_Topo.LinkLoopRing(ring, 4, lp)
            ArraySet(pt, 0, CAD_Store.Read(a0, 0))
            ArraySet(pt, 1, CAD_Store.Read(a0, 1))
            ArraySet(pt, 2, CAD_Store.Read(a0, 2))
            ArraySet(ax, 0, Float_Sub(CAD_Store.Read(a1, 0), CAD_Store.Read(a0, 0)))
            ArraySet(ax, 1, Float_Sub(CAD_Store.Read(a1, 1), CAD_Store.Read(a0, 1)))
            ArraySet(ax, 2, zro)
            ArraySet(ay, 0, zro)
            ArraySet(ay, 1, zro)
            ArraySet(ay, 2, one)
            ss = CAD_Geom.MakePlaneAxes(pt, ax, ay)
            ArraySet(faces, nf, CAD_Topo.MakeFace(ss, lp))
            nf = Add(nf, 1)
            i = Add(i, 1)
        }
        // BEVEL quads vm -> vc (the actual chamfer)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            a0 = ArrayGet(vm, i)
            a1 = ArrayGet(vm, j)
            a2 = ArrayGet(vc, j)
            a3 = ArrayGet(vc, i)
            ArraySet(pt, 0, CAD_Store.Read(a0, 0))
            ArraySet(pt, 1, CAD_Store.Read(a0, 1))
            ArraySet(pt, 2, CAD_Store.Read(a0, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a1, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a1, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a1, 2))
            e0 = CAD_Topo.MakeEdge(a0, a1, CAD_Geom.MakeLine(pt, p1b))
            ArraySet(pt, 0, CAD_Store.Read(a1, 0))
            ArraySet(pt, 1, CAD_Store.Read(a1, 1))
            ArraySet(pt, 2, CAD_Store.Read(a1, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a2, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a2, 2))
            e1 = CAD_Topo.MakeEdge(a1, a2, CAD_Geom.MakeLine(pt, p1b))
            ArraySet(pt, 0, CAD_Store.Read(a2, 0))
            ArraySet(pt, 1, CAD_Store.Read(a2, 1))
            ArraySet(pt, 2, CAD_Store.Read(a2, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a3, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a3, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a3, 2))
            e2 = CAD_Topo.MakeEdge(a2, a3, CAD_Geom.MakeLine(pt, p1b))
            ArraySet(pt, 0, CAD_Store.Read(a3, 0))
            ArraySet(pt, 1, CAD_Store.Read(a3, 1))
            ArraySet(pt, 2, CAD_Store.Read(a3, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a0, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a0, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a0, 2))
            e3 = CAD_Topo.MakeEdge(a3, a0, CAD_Geom.MakeLine(pt, p1b))
            c0 = CAD_Topo.MakeCoedge(e0, a0, 1)
            c1 = CAD_Topo.MakeCoedge(e1, a1, 1)
            c2 = CAD_Topo.MakeCoedge(e2, a2, 1)
            c3 = CAD_Topo.MakeCoedge(e3, a3, 1)
            CAD_Store.Write(e0, 3, c0)
            CAD_Store.Write(e1, 3, c1)
            CAD_Store.Write(e2, 3, c2)
            CAD_Store.Write(e3, 3, c3)
            ArraySet(ring, 0, c0)
            ArraySet(ring, 1, c1)
            ArraySet(ring, 2, c2)
            ArraySet(ring, 3, c3)
            lp = CAD_Topo.MakeLoop(c0)
            CAD_Topo.LinkLoopRing(ring, 4, lp)
            ArraySet(pt, 0, CAD_Store.Read(a0, 0))
            ArraySet(pt, 1, CAD_Store.Read(a0, 1))
            ArraySet(pt, 2, CAD_Store.Read(a0, 2))
            ArraySet(ax, 0, Float_Sub(CAD_Store.Read(a1, 0), CAD_Store.Read(a0, 0)))
            ArraySet(ax, 1, Float_Sub(CAD_Store.Read(a1, 1), CAD_Store.Read(a0, 1)))
            ArraySet(ax, 2, Float_Sub(CAD_Store.Read(a1, 2), CAD_Store.Read(a0, 2)))
            ArraySet(ay, 0, Float_Sub(CAD_Store.Read(a3, 0), CAD_Store.Read(a0, 0)))
            ArraySet(ay, 1, Float_Sub(CAD_Store.Read(a3, 1), CAD_Store.Read(a0, 1)))
            ArraySet(ay, 2, Float_Sub(CAD_Store.Read(a3, 2), CAD_Store.Read(a0, 2)))
            ss = CAD_Geom.MakePlaneAxes(pt, ax, ay)
            ArraySet(faces, nf, CAD_Topo.MakeFace(ss, lp))
            nf = Add(nf, 1)
            i = Add(i, 1)
        }
        // TOP (inset)
        i = 0
        WhileLoop LessThan(i, n) {
            k = i
            IfCondition EqualTo(on_top, 0) ThenBlock: {
                k = Subtract(n, Add(i, 1))
            }
            va = ArrayGet(vc, k)
            j = Add(k, 1)
            IfCondition EqualTo(on_top, 1) ThenBlock: {
                IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            }
            IfCondition EqualTo(on_top, 0) ThenBlock: {
                j = Subtract(k, 1)
                IfCondition LessThan(j, 0) ThenBlock: { j = Subtract(n, 1) }
            }
            vb2 = ArrayGet(vc, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, CAD_Store.Read(va, 2))
            ArraySet(p1b, 0, CAD_Store.Read(vb2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(vb2, 1))
            ArraySet(p1b, 2, CAD_Store.Read(vb2, 2))
            e = CAD_Topo.MakeEdge(va, vb2, CAD_Geom.MakeLine(pt, p1b))
            c0 = CAD_Topo.MakeCoedge(e, va, 1)
            CAD_Store.Write(e, 3, c0)
            ArraySet(ring, i, c0)
            i = Add(i, 1)
        }
        ArraySet(pt, 0, ArrayGet(ins, 0))
        ArraySet(pt, 1, ArrayGet(ins, 1))
        ArraySet(pt, 2, zc)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, one)
        ArraySet(ay, 2, zro)
        IfCondition EqualTo(on_top, 0) ThenBlock: {
            ArraySet(ay, 1, 0xBFF0000000000000)
        }
        stop = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        lp = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n, lp)
        ArraySet(faces, nf, CAD_Topo.MakeFace(stop, lp))
        nf = Add(nf, 1)
        i = 0
        WhileLoop LessThan(i, Subtract(nf, 1)) {
            CAD_Store.Write(ArrayGet(faces, i), 3, ArrayGet(faces, Add(i, 1)))
            i = Add(i, 1)
        }
        CAD_Store.Write(ArrayGet(faces, Subtract(nf, 1)), 3, 0)
        h_sh = CAD_Topo.MakeShell(ArrayGet(faces, 0))
        i = 0
        WhileLoop LessThan(i, nf) {
            CAD_Store.Write(ArrayGet(faces, i), 2, h_sh)
            i = Add(i, 1)
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 16384)
        Deallocate(vb, 16384)
        Deallocate(vm, 16384)
        Deallocate(vc, 16384)
        Deallocate(faces, 32768)
        Deallocate(xy, 16384)
        Deallocate(zpack, 32)
        Deallocate(ins, 16384)
        ReturnValue(h_so)
    }
}

// Equal-R fillet of a vertical prism's top (or bottom) rim cycle.
// Same shared rings as ChamferPrismCap (vb / vm / vc) so walls, cylinders
// and the inset cap meet at identical vertices. Bevel quads become
// cylinders: wall-rail + cap-rail (lines) and two quarter-ellipses
// (Pww=vm[k] → Pcap=vc[k], center at inset XY / zm). Adjacent cylinders
// share that ellipse — Steinmetz, no sphere, no Digon rebuild.
// Plain prisms only (n walls + 2 caps); holes/features return 0.
Function.CAD_Topo.FilletPrismCap {
    Input: solid_handle: Integer
    Input: R_r: Integer
    Input: on_top: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(R_r, 0), 1) ThenBlock: { ReturnValue(0) }
        xy = Allocate(16384)
        zpack = Allocate(32)
        n = CAD_Topo.ExtractBottomLoopXY(solid_handle, xy, zpack)
        IfCondition LessThan(n, 3) ThenBlock: {
            Deallocate(xy, 16384)
            Deallocate(zpack, 32)
            ReturnValue(0)
        }
        // refuse holed / already-blended solids (would drop extra faces)
        nf0 = 0
        sh0 = CAD_Store.Read(solid_handle, 0)
        IfCondition NotEqual(sh0, 0) ThenBlock: {
            f0 = CAD_Store.Read(sh0, 0)
            WhileLoop NotEqual(f0, 0) {
                nf0 = Add(nf0, 1)
                f0 = CAD_Store.Read(f0, 3)
                IfCondition GreaterThan(nf0, 4096) ThenBlock: { f0 = 0 }
            }
        }
        IfCondition NotEqual(nf0, Add(n, 2)) ThenBlock: {
            Deallocate(xy, 16384)
            Deallocate(zpack, 32)
            ReturnValue(0)
        }
        // Compound / glued boss: first shell may still look like a box.
        // Rebuilding it drops the other shell (cylinder vanished).
        IfCondition GreaterThan(CAD_Topo.SolidCountShells(solid_handle), 1) ThenBlock: {
            Deallocate(xy, 16384)
            Deallocate(zpack, 32)
            ReturnValue(0)
        }
        has_hole = 0
        sh1 = CAD_Store.Read(solid_handle, 0)
        IfCondition NotEqual(sh1, 0) ThenBlock: {
            f1 = CAD_Store.Read(sh1, 0)
            WhileLoop NotEqual(f1, 0) {
                lp1 = CAD_Store.Read(f1, 1)
                IfCondition NotEqual(lp1, 0) ThenBlock: {
                    IfCondition NotEqual(CAD_Store.Read(lp1, 2), 0) ThenBlock: { has_hole = 1 }
                }
                su1 = CAD_Store.Read(f1, 0)
                IfCondition NotEqual(su1, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(su1, 0), 2) ThenBlock: { has_hole = 1 }
                }
                f1 = CAD_Store.Read(f1, 3)
                IfCondition EqualTo(has_hole, 1) ThenBlock: { f1 = 0 }
            }
        }
        IfCondition EqualTo(has_hole, 1) ThenBlock: {
            Deallocate(xy, 16384)
            Deallocate(zpack, 32)
            ReturnValue(0)
        }
        // InsetPolyXY treats CCW-left as inward. Bottom loops are often CW.
        area = 0
        ai = 0
        WhileLoop LessThan(ai, n) {
            aj = Add(ai, 1)
            IfCondition EqualTo(aj, n) ThenBlock: { aj = 0 }
            area = Float_Add(area, Float_Sub(Float_Mul(ArrayGet(xy, Multiply(ai, 2)), ArrayGet(xy, Add(Multiply(aj, 2), 1))), Float_Mul(ArrayGet(xy, Multiply(aj, 2)), ArrayGet(xy, Add(Multiply(ai, 2), 1)))))
            ai = Add(ai, 1)
        }
        IfCondition EqualTo(CAD_Num.IsNeg(area), 1) ThenBlock: {
            lo = 0
            hi = Subtract(n, 1)
            WhileLoop LessThan(lo, hi) {
                tx = ArrayGet(xy, Multiply(lo, 2))
                ty = ArrayGet(xy, Add(Multiply(lo, 2), 1))
                ArraySet(xy, Multiply(lo, 2), ArrayGet(xy, Multiply(hi, 2)))
                ArraySet(xy, Add(Multiply(lo, 2), 1), ArrayGet(xy, Add(Multiply(hi, 2), 1)))
                ArraySet(xy, Multiply(hi, 2), tx)
                ArraySet(xy, Add(Multiply(hi, 2), 1), ty)
                lo = Add(lo, 1)
                hi = Subtract(hi, 1)
            }
        }
        zmin = ArrayGet(zpack, 0)
        zmax = ArrayGet(zpack, 1)
        H = Float_Sub(zmax, zmin)
        IfCondition EqualTo(Float_Le(H, R_r), 1) ThenBlock: {
            Deallocate(xy, 16384)
            Deallocate(zpack, 32)
            ReturnValue(0)
        }
        ins = Allocate(16384)
        ni = CAD_Topo.InsetPolyXY(xy, n, R_r, ins)
        IfCondition LessThan(ni, 3) ThenBlock: {
            Deallocate(xy, 16384)
            Deallocate(zpack, 32)
            Deallocate(ins, 16384)
            ReturnValue(0)
        }
        IfCondition NotEqual(ni, n) ThenBlock: {
            Deallocate(xy, 16384)
            Deallocate(zpack, 32)
            Deallocate(ins, 16384)
            ReturnValue(0)
        }
        zb = zmin
        zm = Float_Sub(zmax, R_r)
        zc = zmax
        IfCondition EqualTo(on_top, 0) ThenBlock: {
            zb = zmax
            zm = Float_Add(zmin, R_r)
            zc = zmin
        }
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        csf = Allocate(128)
        ring = Allocate(16384)
        vb = Allocate(16384)
        vm = Allocate(16384)
        vc = Allocate(16384)
        ell = Allocate(16384)
        i = 0
        WhileLoop LessThan(i, n) {
            x = ArrayGet(xy, Multiply(i, 2))
            y = ArrayGet(xy, Add(Multiply(i, 2), 1))
            ArraySet(pt, 0, x)
            ArraySet(pt, 1, y)
            ArraySet(pt, 2, zb)
            ArraySet(vb, i, CAD_Topo.MakeVertex(pt))
            ArraySet(pt, 2, zm)
            ArraySet(vm, i, CAD_Topo.MakeVertex(pt))
            ArraySet(pt, 0, ArrayGet(ins, Multiply(i, 2)))
            ArraySet(pt, 1, ArrayGet(ins, Add(Multiply(i, 2), 1)))
            ArraySet(pt, 2, zc)
            ArraySet(vc, i, CAD_Topo.MakeVertex(pt))
            i = Add(i, 1)
        }
        // one quarter-ellipse per corner: Pww=vm → Pcap=vc, center (ins, zm)
        i = 0
        bad = 0
        WhileLoop LessThan(i, n) {
            ArraySet(csf, 0, ArrayGet(ins, Multiply(i, 2)))
            ArraySet(csf, 1, ArrayGet(ins, Add(Multiply(i, 2), 1)))
            ArraySet(csf, 2, zm)
            ee = CAD_Topo.MakeEqualRDigonEdge(ArrayGet(vm, i), ArrayGet(vc, i), csf, ax, ay, R_r)
            ArraySet(ell, i, ee)
            IfCondition EqualTo(ee, 0) ThenBlock: { bad = 1 }
            i = Add(i, 1)
        }
        IfCondition EqualTo(bad, 1) ThenBlock: {
            Deallocate(pt, 32)
            Deallocate(p1b, 32)
            Deallocate(ax, 32)
            Deallocate(ay, 32)
            Deallocate(csf, 128)
            Deallocate(ring, 16384)
            Deallocate(vb, 16384)
            Deallocate(vm, 16384)
            Deallocate(vc, 16384)
            Deallocate(ell, 16384)
            Deallocate(xy, 16384)
            Deallocate(zpack, 32)
            Deallocate(ins, 16384)
            ReturnValue(0)
        }
        one = 0x3FF0000000000000
        zro = 0
        faces = Allocate(32768)
        nf = 0
        // BOTTOM (or original top if filleting bottom): loop vb
        i = 0
        WhileLoop LessThan(i, n) {
            k = Subtract(n, Add(i, 1))
            IfCondition EqualTo(on_top, 0) ThenBlock: { k = i }
            va = ArrayGet(vb, k)
            j = Add(k, 1)
            IfCondition EqualTo(on_top, 1) ThenBlock: {
                j = Subtract(k, 1)
                IfCondition LessThan(j, 0) ThenBlock: { j = Subtract(n, 1) }
            }
            IfCondition EqualTo(on_top, 0) ThenBlock: {
                IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            }
            vb2 = ArrayGet(vb, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, CAD_Store.Read(va, 2))
            ArraySet(p1b, 0, CAD_Store.Read(vb2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(vb2, 1))
            ArraySet(p1b, 2, CAD_Store.Read(vb2, 2))
            e = CAD_Topo.MakeEdge(va, vb2, CAD_Geom.MakeLine(pt, p1b))
            c0 = CAD_Topo.MakeCoedge(e, va, 1)
            CAD_Store.Write(e, 3, c0)
            ArraySet(ring, i, c0)
            i = Add(i, 1)
        }
        ArraySet(pt, 0, ArrayGet(xy, 0))
        ArraySet(pt, 1, ArrayGet(xy, 1))
        ArraySet(pt, 2, zb)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, one)
        ArraySet(ay, 2, zro)
        IfCondition EqualTo(on_top, 1) ThenBlock: {
            ArraySet(ay, 1, 0xBFF0000000000000)
        }
        sbot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        lp = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n, lp)
        ArraySet(faces, nf, CAD_Topo.MakeFace(sbot, lp))
        nf = Add(nf, 1)
        // SIDE quads vb-vm (same as chamfer — shared vm with cylinders)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            a0 = ArrayGet(vb, i)
            a1 = ArrayGet(vb, j)
            a2 = ArrayGet(vm, j)
            a3 = ArrayGet(vm, i)
            ArraySet(pt, 0, CAD_Store.Read(a0, 0))
            ArraySet(pt, 1, CAD_Store.Read(a0, 1))
            ArraySet(pt, 2, CAD_Store.Read(a0, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a1, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a1, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a1, 2))
            e0 = CAD_Topo.MakeEdge(a0, a1, CAD_Geom.MakeLine(pt, p1b))
            ArraySet(pt, 2, CAD_Store.Read(a2, 2))
            ArraySet(p1b, 2, CAD_Store.Read(a2, 2))
            ArraySet(pt, 0, CAD_Store.Read(a1, 0))
            ArraySet(pt, 1, CAD_Store.Read(a1, 1))
            ArraySet(p1b, 0, CAD_Store.Read(a2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a2, 1))
            e1 = CAD_Topo.MakeEdge(a1, a2, CAD_Geom.MakeLine(pt, p1b))
            ArraySet(pt, 0, CAD_Store.Read(a2, 0))
            ArraySet(pt, 1, CAD_Store.Read(a2, 1))
            ArraySet(pt, 2, CAD_Store.Read(a2, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a3, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a3, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a3, 2))
            e2 = CAD_Topo.MakeEdge(a2, a3, CAD_Geom.MakeLine(pt, p1b))
            ArraySet(pt, 0, CAD_Store.Read(a3, 0))
            ArraySet(pt, 1, CAD_Store.Read(a3, 1))
            ArraySet(pt, 2, CAD_Store.Read(a3, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a0, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a0, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a0, 2))
            e3 = CAD_Topo.MakeEdge(a3, a0, CAD_Geom.MakeLine(pt, p1b))
            c0 = CAD_Topo.MakeCoedge(e0, a0, 1)
            c1 = CAD_Topo.MakeCoedge(e1, a1, 1)
            c2 = CAD_Topo.MakeCoedge(e2, a2, 1)
            c3 = CAD_Topo.MakeCoedge(e3, a3, 1)
            CAD_Store.Write(e0, 3, c0)
            CAD_Store.Write(e1, 3, c1)
            CAD_Store.Write(e2, 3, c2)
            CAD_Store.Write(e3, 3, c3)
            ArraySet(ring, 0, c0)
            ArraySet(ring, 1, c1)
            ArraySet(ring, 2, c2)
            ArraySet(ring, 3, c3)
            lp = CAD_Topo.MakeLoop(c0)
            CAD_Topo.LinkLoopRing(ring, 4, lp)
            ArraySet(pt, 0, CAD_Store.Read(a0, 0))
            ArraySet(pt, 1, CAD_Store.Read(a0, 1))
            ArraySet(pt, 2, CAD_Store.Read(a0, 2))
            ArraySet(ax, 0, Float_Sub(CAD_Store.Read(a1, 0), CAD_Store.Read(a0, 0)))
            ArraySet(ax, 1, Float_Sub(CAD_Store.Read(a1, 1), CAD_Store.Read(a0, 1)))
            ArraySet(ax, 2, zro)
            ArraySet(ay, 0, zro)
            ArraySet(ay, 1, zro)
            ArraySet(ay, 2, one)
            ss = CAD_Geom.MakePlaneAxes(pt, ax, ay)
            ArraySet(faces, nf, CAD_Topo.MakeFace(ss, lp))
            nf = Add(nf, 1)
            i = Add(i, 1)
        }
        // CYLINDER faces: wall-rail / ell[j] / cap-rail / ell[i]
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            a0 = ArrayGet(vm, i)
            a1 = ArrayGet(vm, j)
            a2 = ArrayGet(vc, j)
            a3 = ArrayGet(vc, i)
            ArraySet(pt, 0, CAD_Store.Read(a0, 0))
            ArraySet(pt, 1, CAD_Store.Read(a0, 1))
            ArraySet(pt, 2, CAD_Store.Read(a0, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a1, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a1, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a1, 2))
            e0 = CAD_Topo.MakeEdge(a0, a1, CAD_Geom.MakeLine(pt, p1b))
            e1 = ArrayGet(ell, j)
            ArraySet(pt, 0, CAD_Store.Read(a2, 0))
            ArraySet(pt, 1, CAD_Store.Read(a2, 1))
            ArraySet(pt, 2, CAD_Store.Read(a2, 2))
            ArraySet(p1b, 0, CAD_Store.Read(a3, 0))
            ArraySet(p1b, 1, CAD_Store.Read(a3, 1))
            ArraySet(p1b, 2, CAD_Store.Read(a3, 2))
            e2 = CAD_Topo.MakeEdge(a2, a3, CAD_Geom.MakeLine(pt, p1b))
            e3 = ArrayGet(ell, i)
            c0 = CAD_Topo.MakeCoedge(e0, a0, 1)
            CAD_Store.Write(e0, 3, c0)
            sn1 = 1
            IfCondition NotEqual(CAD_Store.Read(e1, 0), a1) ThenBlock: { sn1 = 0 }
            c1 = CAD_Topo.MakeCoedge(e1, a1, sn1)
            ca = CAD_Store.Read(e1, 3)
            IfCondition EqualTo(ca, 0) ThenBlock: { CAD_Store.Write(e1, 3, c1) }
            IfCondition NotEqual(ca, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(e1, 4), 0) ThenBlock: {
                    CAD_Store.Write(e1, 4, c1)
                    CAD_Topo.LinkTwins(ca, c1)
                }
            }
            c2 = CAD_Topo.MakeCoedge(e2, a2, 1)
            CAD_Store.Write(e2, 3, c2)
            // ell[i] is vm[i]→vc[i]; walk vc[i]→vm[i]
            sn3 = 0
            IfCondition EqualTo(CAD_Store.Read(e3, 0), a3) ThenBlock: { sn3 = 1 }
            c3 = CAD_Topo.MakeCoedge(e3, a3, sn3)
            ca = CAD_Store.Read(e3, 3)
            IfCondition EqualTo(ca, 0) ThenBlock: { CAD_Store.Write(e3, 3, c3) }
            IfCondition NotEqual(ca, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Store.Read(e3, 4), 0) ThenBlock: {
                    CAD_Store.Write(e3, 4, c3)
                    CAD_Topo.LinkTwins(ca, c3)
                }
            }
            ArraySet(ring, 0, c0)
            ArraySet(ring, 1, c1)
            ArraySet(ring, 2, c2)
            ArraySet(ring, 3, c3)
            lp = CAD_Topo.MakeLoop(c0)
            CAD_Topo.LinkLoopRing(ring, 4, lp)
            // cylinder: axis along inset edge at zm, radius R
            ArraySet(csf, 0, ArrayGet(ins, Multiply(i, 2)))
            ArraySet(csf, 1, ArrayGet(ins, Add(Multiply(i, 2), 1)))
            ArraySet(csf, 2, zm)
            ArraySet(csf, 3, Float_Sub(ArrayGet(xy, Multiply(i, 2)), ArrayGet(ins, Multiply(i, 2))))
            ArraySet(csf, 4, Float_Sub(ArrayGet(xy, Add(Multiply(i, 2), 1)), ArrayGet(ins, Add(Multiply(i, 2), 1))))
            ArraySet(csf, 5, zro)
            zx = Float_Sub(ArrayGet(ins, Multiply(j, 2)), ArrayGet(ins, Multiply(i, 2)))
            zy = Float_Sub(ArrayGet(ins, Add(Multiply(j, 2), 1)), ArrayGet(ins, Add(Multiply(i, 2), 1)))
            // Y = Z × X with Z=(zx,zy,0), X=(outward,0) → (0,0, zx*Xx - zy*Xy)
            yz = Float_Sub(Float_Mul(zx, ArrayGet(csf, 4)), Float_Mul(zy, ArrayGet(csf, 3)))
            ArraySet(csf, 6, zro)
            ArraySet(csf, 7, zro)
            ArraySet(csf, 8, yz)
            ArraySet(csf, 9, zx)
            ArraySet(csf, 10, zy)
            ArraySet(csf, 11, zro)
            ss = CAD_Geom.MakeCylinderSurf(csf, R_r)
            ArraySet(faces, nf, CAD_Topo.MakeFace(ss, lp))
            nf = Add(nf, 1)
            i = Add(i, 1)
        }
        // TOP (inset) — same as chamfer, verts are Pcap
        i = 0
        WhileLoop LessThan(i, n) {
            k = i
            IfCondition EqualTo(on_top, 0) ThenBlock: {
                k = Subtract(n, Add(i, 1))
            }
            va = ArrayGet(vc, k)
            j = Add(k, 1)
            IfCondition EqualTo(on_top, 1) ThenBlock: {
                IfCondition EqualTo(j, n) ThenBlock: { j = 0 }
            }
            IfCondition EqualTo(on_top, 0) ThenBlock: {
                j = Subtract(k, 1)
                IfCondition LessThan(j, 0) ThenBlock: { j = Subtract(n, 1) }
            }
            vb2 = ArrayGet(vc, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, CAD_Store.Read(va, 2))
            ArraySet(p1b, 0, CAD_Store.Read(vb2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(vb2, 1))
            ArraySet(p1b, 2, CAD_Store.Read(vb2, 2))
            e = CAD_Topo.MakeEdge(va, vb2, CAD_Geom.MakeLine(pt, p1b))
            c0 = CAD_Topo.MakeCoedge(e, va, 1)
            CAD_Store.Write(e, 3, c0)
            ArraySet(ring, i, c0)
            i = Add(i, 1)
        }
        ArraySet(pt, 0, ArrayGet(ins, 0))
        ArraySet(pt, 1, ArrayGet(ins, 1))
        ArraySet(pt, 2, zc)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, one)
        ArraySet(ay, 2, zro)
        IfCondition EqualTo(on_top, 0) ThenBlock: {
            ArraySet(ay, 1, 0xBFF0000000000000)
        }
        stop = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        lp = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n, lp)
        ArraySet(faces, nf, CAD_Topo.MakeFace(stop, lp))
        nf = Add(nf, 1)
        i = 0
        WhileLoop LessThan(i, Subtract(nf, 1)) {
            CAD_Store.Write(ArrayGet(faces, i), 3, ArrayGet(faces, Add(i, 1)))
            i = Add(i, 1)
        }
        CAD_Store.Write(ArrayGet(faces, Subtract(nf, 1)), 3, 0)
        h_sh = CAD_Topo.MakeShell(ArrayGet(faces, 0))
        i = 0
        WhileLoop LessThan(i, nf) {
            CAD_Store.Write(ArrayGet(faces, i), 2, h_sh)
            i = Add(i, 1)
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        PrintMessage("[topo] FilletPrismCap n=")
        PrintNumber(n)
        PrintMessage(" nf=")
        PrintNumber(nf)
        PrintMessage("\n")
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(csf, 128)
        Deallocate(ring, 16384)
        Deallocate(vb, 16384)
        Deallocate(vm, 16384)
        Deallocate(vc, 16384)
        Deallocate(ell, 16384)
        Deallocate(faces, 32768)
        Deallocate(xy, 16384)
        Deallocate(zpack, 32)
        Deallocate(ins, 16384)
        ReturnValue(h_so)
    }
}

// Poly prism with through holes: outer + hole INNER loops on caps (no keyhole).
// Caller MUST set before call:
//   CAD_Topo_State.digon_S   = holes_xy (concatenated rings)
//   CAD_Topo_State.digon_nreg = hole_ns array (count per hole)
//   CAD_Topo_State.digon_k   = nholes (1..8)
// 4-arg ABI only (outer_xy, outer_n, hz, out).
Function.CAD_Topo.MakePolyPrismHoles {
    Input: outer_xy: Address
    Input: outer_n: Integer
    Input: hz_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        CAD_Topo_Prism.xy = outer_xy
        CAD_Topo_Prism.n = outer_n
        CAD_Topo_Prism.hz = hz_r
        CAD_Topo_Prism.out = out_solid_addr
        no = CAD_Topo_Prism.n
        nholes = CAD_Topo_State.digon_k
        IfCondition LessThan(no, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(no, 1024) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nholes, 1) ThenBlock: {
            ReturnValue(CAD_Topo.MakePolyPrism(CAD_Topo_Prism.xy, CAD_Topo_Prism.n, CAD_Topo_Prism.hz, CAD_Topo_Prism.out))
        }
        IfCondition GreaterThan(nholes, 8) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_Prism.hz, 0), 1) ThenBlock: { ReturnValue(0) }
        holes_xy = CAD_Topo_State.digon_S
        hole_ns = CAD_Topo_State.digon_nreg
        // total hole verts
        tot_h = 0
        hi = 0
        WhileLoop LessThan(hi, nholes) {
            tot_h = Add(tot_h, ArrayGet(hole_ns, hi))
            hi = Add(hi, 1)
        }
        IfCondition GreaterThan(Add(no, tot_h), 2048) ThenBlock: { ReturnValue(0) }
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(16384)
        // outer verts
        vb = Allocate(16384)
        vt = Allocate(16384)
        eb = Allocate(16384)
        et = Allocate(16384)
        ev = Allocate(16384)
        // hole verts/edges: max 8*256, use offset base in same arrays after outer
        // store hole bottom verts starting at index 1024 in vb/vt for simplicity
        // Actually separate: h_vb pack
        h_vb = Allocate(65536)
        h_vt = Allocate(65536)
        h_eb = Allocate(65536)
        h_et = Allocate(65536)
        h_ev = Allocate(65536)
        one = 0x3FF0000000000000
        neg1 = 0xBFF0000000000000
        zro = 0
        // --- outer verts ---
        i = 0
        no = CAD_Topo_Prism.n
        WhileLoop LessThan(i, no) {
            no = CAD_Topo_Prism.n
            ArraySet(pt, 0, ArrayGet(CAD_Topo_Prism.xy, Multiply(i, 2)))
            ArraySet(pt, 1, ArrayGet(CAD_Topo_Prism.xy, Add(Multiply(i, 2), 1)))
            ArraySet(pt, 2, 0)
            ArraySet(vb, i, CAD_Topo.MakeVertex(pt))
            ArraySet(pt, 2, CAD_Topo_Prism.hz)
            ArraySet(vt, i, CAD_Topo.MakeVertex(pt))
            i = Add(i, 1)
            no = CAD_Topo_Prism.n
        }
        // outer edges
        i = 0
        no = CAD_Topo_Prism.n
        WhileLoop LessThan(i, no) {
            no = CAD_Topo_Prism.n
            j = Add(i, 1)
            IfCondition EqualTo(j, no) ThenBlock: { j = 0 }
            va = ArrayGet(vb, i)
            vb2 = ArrayGet(vb, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, 0)
            ArraySet(p1b, 0, CAD_Store.Read(vb2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(vb2, 1))
            ArraySet(p1b, 2, 0)
            ArraySet(eb, i, CAD_Topo.MakeEdge(va, vb2, CAD_Geom.MakeLine(pt, p1b)))
            ta = ArrayGet(vt, i)
            tb = ArrayGet(vt, j)
            ArraySet(pt, 2, CAD_Topo_Prism.hz)
            ArraySet(p1b, 2, CAD_Topo_Prism.hz)
            ArraySet(pt, 0, CAD_Store.Read(ta, 0))
            ArraySet(pt, 1, CAD_Store.Read(ta, 1))
            ArraySet(p1b, 0, CAD_Store.Read(tb, 0))
            ArraySet(p1b, 1, CAD_Store.Read(tb, 1))
            ArraySet(et, i, CAD_Topo.MakeEdge(ta, tb, CAD_Geom.MakeLine(pt, p1b)))
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, 0)
            ArraySet(p1b, 0, CAD_Store.Read(ta, 0))
            ArraySet(p1b, 1, CAD_Store.Read(ta, 1))
            ArraySet(p1b, 2, CAD_Topo_Prism.hz)
            ArraySet(ev, i, CAD_Topo.MakeEdge(va, ta, CAD_Geom.MakeLine(pt, p1b)))
            // coedges
            e = ArrayGet(eb, i)
            c0 = CAD_Topo.MakeCoedge(e, va, 1)
            c1 = CAD_Topo.MakeCoedge(e, vb2, 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            e = ArrayGet(et, i)
            c0 = CAD_Topo.MakeCoedge(e, ta, 1)
            c1 = CAD_Topo.MakeCoedge(e, tb, 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            e = ArrayGet(ev, i)
            c0 = CAD_Topo.MakeCoedge(e, va, 1)
            c1 = CAD_Topo.MakeCoedge(e, ta, 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            i = Add(i, 1)
            no = CAD_Topo_Prism.n
        }
        // --- each hole ---
        h_off = 0
        hi = 0
        WhileLoop LessThan(hi, nholes) {
            nh = ArrayGet(hole_ns, hi)
            // hole verts
            i = 0
            WhileLoop LessThan(i, nh) {
                base = Add(h_off, i)
                ArraySet(pt, 0, ArrayGet(holes_xy, Multiply(Add(h_off, i), 2)))
                ArraySet(pt, 1, ArrayGet(holes_xy, Add(Multiply(Add(h_off, i), 2), 1)))
                ArraySet(pt, 2, 0)
                ArraySet(h_vb, base, CAD_Topo.MakeVertex(pt))
                ArraySet(pt, 2, CAD_Topo_Prism.hz)
                ArraySet(h_vt, base, CAD_Topo.MakeVertex(pt))
                i = Add(i, 1)
            }
            // hole edges + coedges
            i = 0
            WhileLoop LessThan(i, nh) {
                j = Add(i, 1)
                IfCondition EqualTo(j, nh) ThenBlock: { j = 0 }
                bi = Add(h_off, i)
                bj = Add(h_off, j)
                va = ArrayGet(h_vb, bi)
                vb2 = ArrayGet(h_vb, bj)
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, 0)
                ArraySet(p1b, 0, CAD_Store.Read(vb2, 0))
                ArraySet(p1b, 1, CAD_Store.Read(vb2, 1))
                ArraySet(p1b, 2, 0)
                ArraySet(h_eb, bi, CAD_Topo.MakeEdge(va, vb2, CAD_Geom.MakeLine(pt, p1b)))
                ta = ArrayGet(h_vt, bi)
                tb = ArrayGet(h_vt, bj)
                ArraySet(pt, 2, CAD_Topo_Prism.hz)
                ArraySet(p1b, 2, CAD_Topo_Prism.hz)
                ArraySet(pt, 0, CAD_Store.Read(ta, 0))
                ArraySet(pt, 1, CAD_Store.Read(ta, 1))
                ArraySet(p1b, 0, CAD_Store.Read(tb, 0))
                ArraySet(p1b, 1, CAD_Store.Read(tb, 1))
                ArraySet(h_et, bi, CAD_Topo.MakeEdge(ta, tb, CAD_Geom.MakeLine(pt, p1b)))
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, 0)
                ArraySet(p1b, 0, CAD_Store.Read(ta, 0))
                ArraySet(p1b, 1, CAD_Store.Read(ta, 1))
                ArraySet(p1b, 2, CAD_Topo_Prism.hz)
                ArraySet(h_ev, bi, CAD_Topo.MakeEdge(va, ta, CAD_Geom.MakeLine(pt, p1b)))
                e = ArrayGet(h_eb, bi)
                c0 = CAD_Topo.MakeCoedge(e, va, 1)
                c1 = CAD_Topo.MakeCoedge(e, vb2, 0)
                CAD_Topo.LinkTwins(c0, c1)
                CAD_Store.Write(e, 3, c0)
                CAD_Store.Write(e, 4, c1)
                e = ArrayGet(h_et, bi)
                c0 = CAD_Topo.MakeCoedge(e, ta, 1)
                c1 = CAD_Topo.MakeCoedge(e, tb, 0)
                CAD_Topo.LinkTwins(c0, c1)
                CAD_Store.Write(e, 3, c0)
                CAD_Store.Write(e, 4, c1)
                e = ArrayGet(h_ev, bi)
                c0 = CAD_Topo.MakeCoedge(e, va, 1)
                c1 = CAD_Topo.MakeCoedge(e, ta, 0)
                CAD_Topo.LinkTwins(c0, c1)
                CAD_Store.Write(e, 3, c0)
                CAD_Store.Write(e, 4, c1)
                i = Add(i, 1)
            }
            h_off = Add(h_off, nh)
            hi = Add(hi, 1)
        }
        // planes for caps
        ArraySet(pt, 0, ArrayGet(CAD_Topo_Prism.xy, 0))
        ArraySet(pt, 1, ArrayGet(CAD_Topo_Prism.xy, 1))
        ArraySet(pt, 2, 0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        sbot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, CAD_Topo_Prism.hz)
        ArraySet(ay, 1, one)
        stop = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        // BOTTOM outer reverse
        no = CAD_Topo_Prism.n
        i = 0
        WhileLoop LessThan(i, no) {
            k = Subtract(no, Add(i, 1))
            ArraySet(ring, i, CAD_Store.Read(ArrayGet(eb, k), 4))
            i = Add(i, 1)
        }
        lbot = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, no, lbot)
        // chain hole loops on bottom (forward = hole CCW as inner)
        prev_lp = lbot
        h_off = 0
        hi = 0
        WhileLoop LessThan(hi, nholes) {
            nh = ArrayGet(hole_ns, hi)
            i = 0
            WhileLoop LessThan(i, nh) {
                ArraySet(ring, i, CAD_Store.Read(ArrayGet(h_eb, Add(h_off, i)), 3))
                i = Add(i, 1)
            }
            lh = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
            CAD_Topo.LinkLoopRing(ring, nh, lh)
            CAD_Store.Write(prev_lp, 2, lh)
            prev_lp = lh
            h_off = Add(h_off, nh)
            hi = Add(hi, 1)
        }
        fbot = CAD_Topo.MakeFace(sbot, lbot)
        // TOP outer forward
        i = 0
        WhileLoop LessThan(i, no) {
            ArraySet(ring, i, CAD_Store.Read(ArrayGet(et, i), 3))
            i = Add(i, 1)
        }
        ltop = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, no, ltop)
        prev_lp = ltop
        h_off = 0
        hi = 0
        WhileLoop LessThan(hi, nholes) {
            nh = ArrayGet(hole_ns, hi)
            // hole reverse on top
            i = 0
            WhileLoop LessThan(i, nh) {
                k = Subtract(nh, Add(i, 1))
                ArraySet(ring, i, CAD_Store.Read(ArrayGet(h_et, Add(h_off, k)), 4))
                i = Add(i, 1)
            }
            lh = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
            CAD_Topo.LinkLoopRing(ring, nh, lh)
            CAD_Store.Write(prev_lp, 2, lh)
            prev_lp = lh
            h_off = Add(h_off, nh)
            hi = Add(hi, 1)
        }
        ftop = CAD_Topo.MakeFace(stop, ltop)
        // faces list: bot, top, outer sides, hole sides
        faces = Allocate(32768)
        ArraySet(faces, 0, fbot)
        ArraySet(faces, 1, ftop)
        nf = 2
        // outer sides
        i = 0
        WhileLoop LessThan(i, no) {
            j = Add(i, 1)
            IfCondition EqualTo(j, no) ThenBlock: { j = 0 }
            ArraySet(ring, 0, CAD_Store.Read(ArrayGet(eb, i), 3))
            ArraySet(ring, 1, CAD_Store.Read(ArrayGet(ev, j), 3))
            ArraySet(ring, 2, CAD_Store.Read(ArrayGet(et, i), 4))
            ArraySet(ring, 3, CAD_Store.Read(ArrayGet(ev, i), 4))
            va = ArrayGet(vb, i)
            vb2 = ArrayGet(vb, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, 0)
            ArraySet(ax, 0, Float_Sub(CAD_Store.Read(vb2, 0), CAD_Store.Read(va, 0)))
            ArraySet(ax, 1, Float_Sub(CAD_Store.Read(vb2, 1), CAD_Store.Read(va, 1)))
            ArraySet(ax, 2, zro)
            ln = CAD_Num.Sqrt(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))))
            IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
                ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), ln))
                ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), ln))
            }
            ArraySet(ay, 0, zro)
            ArraySet(ay, 1, zro)
            ArraySet(ay, 2, one)
            sside = CAD_Geom.MakePlaneAxes(pt, ax, ay)
            ls = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
            CAD_Topo.LinkLoopRing(ring, 4, ls)
            ArraySet(faces, nf, CAD_Topo.MakeFace(sside, ls))
            nf = Add(nf, 1)
            i = Add(i, 1)
        }
        // hole sides (inward — reverse sense of bottom edge)
        h_off = 0
        hi = 0
        WhileLoop LessThan(hi, nholes) {
            nh = ArrayGet(hole_ns, hi)
            i = 0
            WhileLoop LessThan(i, nh) {
                j = Add(i, 1)
                IfCondition EqualTo(j, nh) ThenBlock: { j = 0 }
                bi = Add(h_off, i)
                bj = Add(h_off, j)
                // reverse bottom for inward wall
                ArraySet(ring, 0, CAD_Store.Read(ArrayGet(h_eb, bi), 4))
                ArraySet(ring, 1, CAD_Store.Read(ArrayGet(h_ev, bi), 3))
                ArraySet(ring, 2, CAD_Store.Read(ArrayGet(h_et, bi), 3))
                ArraySet(ring, 3, CAD_Store.Read(ArrayGet(h_ev, bj), 4))
                va = ArrayGet(h_vb, bi)
                vb2 = ArrayGet(h_vb, bj)
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, 0)
                ArraySet(ax, 0, Float_Sub(CAD_Store.Read(vb2, 0), CAD_Store.Read(va, 0)))
                ArraySet(ax, 1, Float_Sub(CAD_Store.Read(vb2, 1), CAD_Store.Read(va, 1)))
                ArraySet(ax, 2, zro)
                ln = CAD_Num.Sqrt(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))))
                IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
                    ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), ln))
                    ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), ln))
                }
                // flip outward for hole wall
                ArraySet(ax, 0, Float_Sub(0, ArrayGet(ax, 0)))
                ArraySet(ax, 1, Float_Sub(0, ArrayGet(ax, 1)))
                ArraySet(ay, 0, zro)
                ArraySet(ay, 1, zro)
                ArraySet(ay, 2, one)
                sside = CAD_Geom.MakePlaneAxes(pt, ax, ay)
                ls = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
                CAD_Topo.LinkLoopRing(ring, 4, ls)
                ArraySet(faces, nf, CAD_Topo.MakeFace(sside, ls))
                nf = Add(nf, 1)
                i = Add(i, 1)
            }
            h_off = Add(h_off, nh)
            hi = Add(hi, 1)
        }
        // chain faces
        i = 0
        WhileLoop LessThan(i, Subtract(nf, 1)) {
            CAD_Store.Write(ArrayGet(faces, i), 3, ArrayGet(faces, Add(i, 1)))
            i = Add(i, 1)
        }
        CAD_Store.Write(ArrayGet(faces, Subtract(nf, 1)), 3, 0)
        h_sh = CAD_Topo.MakeShell(ArrayGet(faces, 0))
        i = 1
        WhileLoop LessThan(i, nf) {
            CAD_Store.Write(ArrayGet(faces, i), 2, h_sh)
            i = Add(i, 1)
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(CAD_Topo_Prism.out, 0, h_so)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 16384)
        Deallocate(vb, 16384)
        Deallocate(vt, 16384)
        Deallocate(eb, 16384)
        Deallocate(et, 16384)
        Deallocate(ev, 16384)
        Deallocate(h_vb, 65536)
        Deallocate(h_vt, 65536)
        Deallocate(h_eb, 65536)
        Deallocate(h_et, 65536)
        Deallocate(h_ev, 65536)
        Deallocate(faces, 32768)
        ReturnValue(h_so)
    }
}

// Ruled solid between two XY polygons (same n) at z_bot and z_top.
// xy_bot / xy_top: interleaved [x,y]*n. zpack: [z_bot, z_top]. Kind-0 (2 caps + n sides).
// Domain: n 3..64, z_top != z_bot, same winding. SysV-safe (5 inputs).
