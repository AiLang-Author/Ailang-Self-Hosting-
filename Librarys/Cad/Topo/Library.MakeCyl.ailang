// CAD.Topo.MakeCyl — split from Library.CAD_Topo.ailang
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.MakeCylinderSolid {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        one = 0x3FF0000000000000
        zro = 0x0000000000000000
        neg1 = 0xBFF0000000000000
        pt = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        frame = Allocate(128)
        ring = Allocate(64)

        // Seam verts on +X
        ArraySet(pt, 0, radius_r)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        vb = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 2, height_r)
        vt = CAD_Topo.MakeVertex(pt)

        // Geom: circles, cylinder, planes
        ArraySet(frame, 0, zro)
        ArraySet(frame, 1, zro)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 3, one)
        ArraySet(frame, 4, zro)
        ArraySet(frame, 5, zro)
        ArraySet(frame, 6, zro)
        ArraySet(frame, 7, one)
        ArraySet(frame, 8, zro)
        circ_bot = CAD_Geom.MakeCircle(frame, radius_r)
        ArraySet(frame, 2, height_r)
        circ_top = CAD_Geom.MakeCircle(frame, radius_r)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 9, zro)
        ArraySet(frame, 10, zro)
        ArraySet(frame, 11, one)
        cyl_s = CAD_Geom.MakeCylinderSurf(frame, radius_r)

        ArraySet(pt, 0, zro)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, height_r)
        ArraySet(ay, 1, one)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)

        // Edges: closed circles (v0==v1) + generator
        eb = CAD_Topo.MakeEdge(vb, vb, circ_bot)
        et = CAD_Topo.MakeEdge(vt, vt, circ_top)
        ArraySet(pt, 0, radius_r)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, radius_r)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, height_r)
        ln = CAD_Geom.MakeLine(pt, ax)
        es = CAD_Topo.MakeEdge(vb, vt, ln)

        // Coedges: each edge → face pair (side vs cap)
        cb_side = CAD_Topo.MakeCoedge(eb, vb, 1)
        cb_bot = CAD_Topo.MakeCoedge(eb, vb, 0)
        CAD_Topo.LinkTwins(cb_side, cb_bot)
        CAD_Store.Write(eb, 3, cb_side)
        CAD_Store.Write(eb, 4, cb_bot)

        ct_top = CAD_Topo.MakeCoedge(et, vt, 1)
        ct_side = CAD_Topo.MakeCoedge(et, vt, 0)
        CAD_Topo.LinkTwins(ct_top, ct_side)
        CAD_Store.Write(et, 3, ct_top)
        CAD_Store.Write(et, 4, ct_side)

        cs_up = CAD_Topo.MakeCoedge(es, vb, 1)
        cs_dn = CAD_Topo.MakeCoedge(es, vt, 0)
        CAD_Topo.LinkTwins(cs_up, cs_dn)
        CAD_Store.Write(es, 3, cs_up)
        CAD_Store.Write(es, 4, cs_dn)

        // Bottom cap: single reverse circle (outward -Z)
        lp_bot = CAD_Topo.MakeLoop(cb_bot)
        CAD_Store.Write(cb_bot, 2, cb_bot)
        CAD_Store.Write(cb_bot, 3, cb_bot)
        CAD_Store.Write(cb_bot, 4, lp_bot)
        CAD_Store.Write(lp_bot, 0, cb_bot)
        f_bot = CAD_Topo.MakeFace(pl_bot, lp_bot)

        // Top cap: single forward circle
        lp_top = CAD_Topo.MakeLoop(ct_top)
        CAD_Store.Write(ct_top, 2, ct_top)
        CAD_Store.Write(ct_top, 3, ct_top)
        CAD_Store.Write(ct_top, 4, lp_top)
        CAD_Store.Write(lp_top, 0, ct_top)
        f_top = CAD_Topo.MakeFace(pl_top, lp_top)

        // Side: bottom fwd, seam up, top rev, seam down
        lp_side = CAD_Topo.MakeLoop(cb_side)
        ring = Allocate(64)
        ArraySet(ring, 0, cb_side)
        ArraySet(ring, 1, cs_up)
        ArraySet(ring, 2, ct_side)
        ArraySet(ring, 3, cs_dn)
        CAD_Topo.LinkLoopRing(ring, 4, lp_side)
        f_side = CAD_Topo.MakeFace(cyl_s, lp_side)

        CAD_Store.Write(f_bot, 3, f_top)
        CAD_Store.Write(f_top, 3, f_side)
        CAD_Store.Write(f_side, 3, 0)
        CAD_Store.Write(f_bot, 4, circ_bot)
        CAD_Store.Write(f_top, 4, circ_top)

        h_sh = CAD_Topo.MakeShell(f_bot)
        CAD_Store.Write(f_top, 2, h_sh)
        CAD_Store.Write(f_side, 2, h_sh)
        h_so = CAD_Topo.MakeSolid(h_sh)
        // params: r, h, ox, oy, oz
        ph = CAD_Store.Alloc(13, 8)
        CAD_Store.Write(ph, 0, radius_r)
        CAD_Store.Write(ph, 1, height_r)
        CAD_Store.Write(ph, 2, zro)
        CAD_Store.Write(ph, 3, zro)
        CAD_Store.Write(ph, 4, zro)
        CAD_Store.Write(ph, 5, 0)
        CAD_Store.Write(ph, 6, 0)
        CAD_Store.Write(ph, 7, 0)
        CAD_Store.Write(h_so, 1, ph)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 1)
        ArraySet(out_solid_addr, 0, h_so)

        Deallocate(pt, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(frame, 128)
        Deallocate(ring, 64)
        ReturnValue(h_so)
    }
}

// Lathe solid: revolve RZ profile about +Z into kind-0 shell.
// rz_addr: [rho,z]*n_rings (rho>=0), n_rings 3..32, n_ang 8..64.
// Caps = ring 0 and ring n_rings-1; side quads between consecutive rings.
Function.CAD_Topo.MakeLatheSolid {
    Input: rz_addr: Address
    Input: n_rings: Integer
    Input: n_ang: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n_rings, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_rings, 32) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_ang, 8) ThenBlock: { n_ang = 8 }
        IfCondition GreaterThan(n_ang, 64) ThenBlock: { n_ang = 64 }
        nr = n_rings
        na = n_ang
        // verts[ring * na + j]
        maxv = Multiply(nr, na)
        IfCondition GreaterThan(maxv, 2048) ThenBlock: { ReturnValue(0) }
        verts = Allocate(16384)
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(1024)
        faces = Allocate(4096)
        two_pi = 0x401921FB54442D18
        one = 0x3FF0000000000000
        zro = 0
        i = 0
        WhileLoop LessThan(i, nr) {
            rho = ArrayGet(rz_addr, Multiply(i, 2))
            zz = ArrayGet(rz_addr, Add(Multiply(i, 2), 1))
            IfCondition EqualTo(CAD_Num.IsNeg(rho), 1) ThenBlock: {
                mag = Float_Sub(0, rho)
                IfCondition EqualTo(Float_Le(0x3EE4F8B588E368F1, mag), 1) ThenBlock: {
                    Deallocate(verts, 16384)
                    Deallocate(pt, 32)
                    Deallocate(p1b, 32)
                    Deallocate(ax, 32)
                    Deallocate(ay, 32)
                    Deallocate(ring, 1024)
                    Deallocate(faces, 4096)
                    ReturnValue(0)
                }
                rho = 0
            }
            j = 0
            WhileLoop LessThan(j, na) {
                a = Float_Mul(two_pi, Float_Div(Float_FromInt(j), Float_FromInt(na)))
                ArraySet(pt, 0, Float_Mul(rho, CAD_Geom.Cos(a)))
                ArraySet(pt, 1, Float_Mul(rho, CAD_Geom.Sin(a)))
                ArraySet(pt, 2, zz)
                ArraySet(verts, Add(Multiply(i, na), j), CAD_Topo.MakeVertex(pt))
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        // edges: ring edges er[i][j] between j and j+1; vertical ev[i][j] ring i to i+1
        er = Allocate(16384)
        ev = Allocate(16384)
        i = 0
        WhileLoop LessThan(i, nr) {
            j = 0
            WhileLoop LessThan(j, na) {
                jn = Add(j, 1)
                IfCondition EqualTo(jn, na) ThenBlock: { jn = 0 }
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(i, na), jn))
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, CAD_Store.Read(va, 2))
                ArraySet(p1b, 0, CAD_Store.Read(vb, 0))
                ArraySet(p1b, 1, CAD_Store.Read(vb, 1))
                ArraySet(p1b, 2, CAD_Store.Read(vb, 2))
                ArraySet(er, Add(Multiply(i, na), j), CAD_Topo.MakeEdge(va, vb, CAD_Geom.MakeLine(pt, p1b)))
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, Subtract(nr, 1)) {
            j = 0
            WhileLoop LessThan(j, na) {
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(Add(i, 1), na), j))
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, CAD_Store.Read(va, 2))
                ArraySet(p1b, 0, CAD_Store.Read(vb, 0))
                ArraySet(p1b, 1, CAD_Store.Read(vb, 1))
                ArraySet(p1b, 2, CAD_Store.Read(vb, 2))
                ArraySet(ev, Add(Multiply(i, na), j), CAD_Topo.MakeEdge(va, vb, CAD_Geom.MakeLine(pt, p1b)))
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        // coedges for ring and vertical edges
        i = 0
        WhileLoop LessThan(i, nr) {
            j = 0
            WhileLoop LessThan(j, na) {
                jn = Add(j, 1)
                IfCondition EqualTo(jn, na) ThenBlock: { jn = 0 }
                e = ArrayGet(er, Add(Multiply(i, na), j))
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(i, na), jn))
                c0 = CAD_Topo.MakeCoedge(e, va, 1)
                c1 = CAD_Topo.MakeCoedge(e, vb, 0)
                CAD_Topo.LinkTwins(c0, c1)
                CAD_Store.Write(e, 3, c0)
                CAD_Store.Write(e, 4, c1)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, Subtract(nr, 1)) {
            j = 0
            WhileLoop LessThan(j, na) {
                e = ArrayGet(ev, Add(Multiply(i, na), j))
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(Add(i, 1), na), j))
                c0 = CAD_Topo.MakeCoedge(e, va, 1)
                c1 = CAD_Topo.MakeCoedge(e, vb, 0)
                CAD_Topo.LinkTwins(c0, c1)
                CAD_Store.Write(e, 3, c0)
                CAD_Store.Write(e, 4, c1)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        nf = 0
        // bottom cap: reverse ring 0 (outward -Z)
        j = 0
        WhileLoop LessThan(j, na) {
            k = Subtract(na, Add(j, 1))
            e = ArrayGet(er, k)
            ArraySet(ring, j, CAD_Store.Read(e, 4))
            j = Add(j, 1)
        }
        ArraySet(pt, 0, 0)
        ArraySet(pt, 1, 0)
        ArraySet(pt, 2, ArrayGet(rz_addr, 1))
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, 0xBFF0000000000000)
        ArraySet(ay, 2, zro)
        sbot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        lbot = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, na, lbot)
        ArraySet(faces, nf, CAD_Topo.MakeFace(sbot, lbot))
        nf = Add(nf, 1)
        // top cap: forward last ring
        last = Subtract(nr, 1)
        j = 0
        WhileLoop LessThan(j, na) {
            e = ArrayGet(er, Add(Multiply(last, na), j))
            ArraySet(ring, j, CAD_Store.Read(e, 3))
            j = Add(j, 1)
        }
        ArraySet(pt, 2, ArrayGet(rz_addr, Add(Multiply(last, 2), 1)))
        ArraySet(ay, 1, one)
        stop = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ltop = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, na, ltop)
        ArraySet(faces, nf, CAD_Topo.MakeFace(stop, ltop))
        nf = Add(nf, 1)
        // side quads: between ring i and i+1
        i = 0
        WhileLoop LessThan(i, Subtract(nr, 1)) {
            j = 0
            WhileLoop LessThan(j, na) {
                jn = Add(j, 1)
                IfCondition EqualTo(jn, na) ThenBlock: { jn = 0 }
                // bottom ring fwd, vert jn up, top rev, vert j down
                ArraySet(ring, 0, CAD_Store.Read(ArrayGet(er, Add(Multiply(i, na), j)), 3))
                ArraySet(ring, 1, CAD_Store.Read(ArrayGet(ev, Add(Multiply(i, na), jn)), 3))
                ArraySet(ring, 2, CAD_Store.Read(ArrayGet(er, Add(Multiply(Add(i, 1), na), j)), 4))
                ArraySet(ring, 3, CAD_Store.Read(ArrayGet(ev, Add(Multiply(i, na), j)), 4))
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(i, na), jn))
                vc = ArrayGet(verts, Add(Multiply(Add(i, 1), na), j))
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, CAD_Store.Read(va, 2))
                ArraySet(ax, 0, Float_Sub(CAD_Store.Read(vb, 0), CAD_Store.Read(va, 0)))
                ArraySet(ax, 1, Float_Sub(CAD_Store.Read(vb, 1), CAD_Store.Read(va, 1)))
                ArraySet(ax, 2, Float_Sub(CAD_Store.Read(vb, 2), CAD_Store.Read(va, 2)))
                lx = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))), Float_Mul(ArrayGet(ax, 2), ArrayGet(ax, 2))))
                IfCondition EqualTo(CAD_Num.IsZero(lx, 0), 0) ThenBlock: {
                    ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), lx))
                    ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), lx))
                    ArraySet(ax, 2, Float_Div(ArrayGet(ax, 2), lx))
                }
                ArraySet(ay, 0, Float_Sub(CAD_Store.Read(vc, 0), CAD_Store.Read(va, 0)))
                ArraySet(ay, 1, Float_Sub(CAD_Store.Read(vc, 1), CAD_Store.Read(va, 1)))
                ArraySet(ay, 2, Float_Sub(CAD_Store.Read(vc, 2), CAD_Store.Read(va, 2)))
                dot = Float_Add(Float_Add(Float_Mul(ArrayGet(ay, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ay, 1), ArrayGet(ax, 1))), Float_Mul(ArrayGet(ay, 2), ArrayGet(ax, 2)))
                ArraySet(ay, 0, Float_Sub(ArrayGet(ay, 0), Float_Mul(dot, ArrayGet(ax, 0))))
                ArraySet(ay, 1, Float_Sub(ArrayGet(ay, 1), Float_Mul(dot, ArrayGet(ax, 1))))
                ArraySet(ay, 2, Float_Sub(ArrayGet(ay, 2), Float_Mul(dot, ArrayGet(ax, 2))))
                ly = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(ay, 0), ArrayGet(ay, 0)), Float_Mul(ArrayGet(ay, 1), ArrayGet(ay, 1))), Float_Mul(ArrayGet(ay, 2), ArrayGet(ay, 2))))
                IfCondition EqualTo(CAD_Num.IsZero(ly, 0), 0) ThenBlock: {
                    ArraySet(ay, 0, Float_Div(ArrayGet(ay, 0), ly))
                    ArraySet(ay, 1, Float_Div(ArrayGet(ay, 1), ly))
                    ArraySet(ay, 2, Float_Div(ArrayGet(ay, 2), ly))
                }
                sside = CAD_Geom.MakePlaneAxes(pt, ax, ay)
                ls = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
                CAD_Topo.LinkLoopRing(ring, 4, ls)
                ArraySet(faces, nf, CAD_Topo.MakeFace(sside, ls))
                nf = Add(nf, 1)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, Subtract(nf, 1)) {
            CAD_Store.Write(ArrayGet(faces, i), 3, ArrayGet(faces, Add(i, 1)))
            i = Add(i, 1)
        }
        CAD_Store.Write(ArrayGet(faces, Subtract(nf, 1)), 3, 0)
        h_sh = CAD_Topo.MakeShell(ArrayGet(faces, 0))
        i = 1
        WhileLoop LessThan(i, nf) {
            CAD_Store.Write(ArrayGet(faces, i), 2, h_sh)
            i = Add(i, 1)
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(verts, 16384)
        Deallocate(er, 16384)
        Deallocate(ev, 16384)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 1024)
        Deallocate(faces, 4096)
        ReturnValue(h_so)
    }
}

// Cylinder with constant-R fillet on top rim (plane–cyl convex outer edge).
// Domain: r>R, h>R. Lathe of RZ profile; n_ang 16..48, n_arc 4..16. Kind 0.
Function.CAD_Topo.MakeCylinderTopFillet {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: fillet_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(fillet_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(radius_r, fillet_r), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(height_r, fillet_r), 1) ThenBlock: { ReturnValue(0) }
        R = fillet_r
        r = radius_r
        h = height_r
        // profile rings: bottom, side@h-R, arc samples, top
        n_arc = 6
        // rings = 2 + n_arc  (bottom, side, n_arc-1 mids, top) — use n_arc inclusive ends shared
        // [0]=(r,0) [1]=(r,h-R) [2..n_arc]=(fillet) [last]=(r-R,h)
        // n_arc samples of φ from 0 to π/2 inclusive → n_arc+1 points but φ=0 == side
        // total = 1 bottom + n_arc+1 fillet (φ=0..π/2) = 2+n_arc, with φ=0 = side
        n_rings = Add(2, n_arc)
        rz = Allocate(512)
        ArraySet(rz, 0, r)
        ArraySet(rz, 1, 0)
        // fillet φ = 0 .. π/2
        half_pi = 0x3FF921FB54442D18
        rc = Float_Sub(r, R)
        zc = Float_Sub(h, R)
        k = 0
        WhileLoop LessEqual(k, n_arc) {
            // φ = k/n_arc * π/2; cosφ,sinφ
            t = Float_Div(Float_FromInt(k), Float_FromInt(n_arc))
            // φ from 0 (horizontal outward from center = at wall) to π/2 (up)
            // use Cos/Sin of half_pi * t
            ang = Float_Mul(half_pi, t)
            // point: (rc + R cos(φ), zc + R sin(φ)) with φ=0 at +rho
            // at φ=0: (r, h-R); at φ=π/2: (r-R, h)
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            // ring index 1+k
            idx = Add(1, k)
            ArraySet(rz, Multiply(idx, 2), Float_Add(rc, Float_Mul(R, c)))
            ArraySet(rz, Add(Multiply(idx, 2), 1), Float_Add(zc, Float_Mul(R, s)))
            k = Add(k, 1)
        }
        // n_rings = 1 + (n_arc+1) = 2+n_arc ✓
        out = Allocate(16)
        hs = CAD_Topo.MakeLatheSolid(rz, n_rings, 24, out)
        Deallocate(rz, 512)
        Deallocate(out, 16)
        IfCondition EqualTo(hs, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(out_solid_addr, 0, hs)
        ReturnValue(hs)
    }
}

// Cylinder bottom rim plane–cyl fillet (convex). R < r, R < h. Kind 0 lathe.
Function.CAD_Topo.MakeCylinderBottomFillet {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: fillet_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(fillet_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(radius_r, fillet_r), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(height_r, fillet_r), 1) ThenBlock: { ReturnValue(0) }
        R = fillet_r
        r = radius_r
        h = height_r
        n_arc = 6
        // rings: (r-R,0), fillet φ steps 1..n_arc (-π/2→0), (r,h)
        n_rings = Add(2, n_arc)
        rz = Allocate(512)
        rc = Float_Sub(r, R)
        half_pi = 0x3FF921FB54442D18
        ArraySet(rz, 0, rc)
        ArraySet(rz, 1, 0)
        k = 1
        WhileLoop LessEqual(k, n_arc) {
            t = Float_Div(Float_FromInt(k), Float_FromInt(n_arc))
            ang = Float_Add(Float_Sub(0, half_pi), Float_Mul(half_pi, t))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            ArraySet(rz, Multiply(k, 2), Float_Add(rc, Float_Mul(R, c)))
            ArraySet(rz, Add(Multiply(k, 2), 1), Float_Add(R, Float_Mul(R, s)))
            k = Add(k, 1)
        }
        // ring n_arc is (r,R); ring n_arc+1 = (r,h)
        ArraySet(rz, Multiply(Add(n_arc, 1), 2), r)
        ArraySet(rz, Add(Multiply(Add(n_arc, 1), 2), 1), h)
        out = Allocate(16)
        hs = CAD_Topo.MakeLatheSolid(rz, n_rings, 24, out)
        Deallocate(rz, 512)
        Deallocate(out, 16)
        IfCondition EqualTo(hs, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(out_solid_addr, 0, hs)
        ReturnValue(hs)
    }
}

// Quarter-torus weld at a boss base: circle r at z=z0, fillet R.
// Closed RZ: (r,z0) → (r,z0+R) → arc → (r+R,z0) → back. Lathe about +Z.
Function.CAD_Topo.MakeBossBaseFilletRing {
    Input: radius_r: Integer
    Input: z0_r: Integer
    Input: fillet_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(fillet_r, 0), 1) ThenBlock: { ReturnValue(0) }
        R = fillet_r
        r = radius_r
        z0 = z0_r
        n_arc = 8
        np = Add(n_arc, 2)
        rz = Allocate(512)
        ArraySet(rz, 0, r)
        ArraySet(rz, 1, z0)
        ArraySet(rz, 2, r)
        ArraySet(rz, 3, Float_Add(z0, R))
        rc = Float_Add(r, R)
        zc = Float_Add(z0, R)
        pi = 0x400921FB54442D18
        half_pi = 0x3FF921FB54442D18
        k = 1
        WhileLoop LessThan(k, n_arc) {
            t = Float_Div(Float_FromInt(k), Float_FromInt(n_arc))
            ang = Float_Add(pi, Float_Mul(half_pi, t))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            idx = Add(k, 1)
            ArraySet(rz, Multiply(idx, 2), Float_Add(rc, Float_Mul(R, c)))
            ArraySet(rz, Add(Multiply(idx, 2), 1), Float_Add(zc, Float_Mul(R, s)))
            k = Add(k, 1)
        }
        last = Add(n_arc, 1)
        ArraySet(rz, Multiply(last, 2), Float_Add(r, R))
        ArraySet(rz, Add(Multiply(last, 2), 1), z0)
        out = Allocate(16)
        hs = CAD_Topo.MakeLatheClosed(rz, np, 48, out)
        Deallocate(rz, 512)
        Deallocate(out, 16)
        IfCondition EqualTo(hs, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(out_solid_addr, 0, hs)
        ReturnValue(hs)
    }
}

// Closed-profile lathe: revolve closed RZ polygon about +Z (no disk caps). Kind 0.
// rz_addr [rho,z]*n_prof, n_prof 3..512, n_ang 8..64. Last connects to first.
// Budget: np*na <= 4096 (verts/edges/faces slabs).
Function.CAD_Topo.MakeLatheClosed {
    Input: rz_addr: Address
    Input: n_prof: Integer
    Input: n_ang: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        CAD_Topo_Lathe.rz = rz_addr
        CAD_Topo_Lathe.np = n_prof
        CAD_Topo_Lathe.na = n_ang
        CAD_Topo_Lathe.out = out_solid_addr
        np = CAD_Topo_Lathe.np
        na = CAD_Topo_Lathe.na
        IfCondition LessThan(np, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(np, 512) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(na, 8) ThenBlock: {
            CAD_Topo_Lathe.na = 8
            na = 8
        }
        IfCondition GreaterThan(na, 64) ThenBlock: {
            CAD_Topo_Lathe.na = 64
            na = 64
        }
        IfCondition GreaterThan(Multiply(np, na), 4096) ThenBlock: { ReturnValue(0) }
        verts = Allocate(65536)
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ringce = Allocate(64)
        faces = Allocate(65536)
        two_pi = 0x401921FB54442D18
        er = Allocate(65536)
        ev = Allocate(65536)
        CAD_Topo_Lathe.i = 0
        np = CAD_Topo_Lathe.np
        na = CAD_Topo_Lathe.na
        WhileLoop LessThan(CAD_Topo_Lathe.i, np) {
            i = CAD_Topo_Lathe.i
            np = CAD_Topo_Lathe.np
            na = CAD_Topo_Lathe.na
            rho = ArrayGet(CAD_Topo_Lathe.rz, Multiply(i, 2))
            zz = ArrayGet(CAD_Topo_Lathe.rz, Add(Multiply(i, 2), 1))
            // Float_Le is wrong on negatives — do not test rho against -eps.
            // On-axis (0) is legal; only a real left-of-axis (IsNeg && |rho|>eps) fails.
            IfCondition EqualTo(CAD_Num.IsNeg(rho), 1) ThenBlock: {
                mag = Float_Sub(0, rho)
                IfCondition EqualTo(Float_Le(0x3EE4F8B588E368F1, mag), 1) ThenBlock: {
                    Deallocate(verts, 65536)
                    Deallocate(pt, 32)
                    Deallocate(p1b, 32)
                    Deallocate(ax, 32)
                    Deallocate(ay, 32)
                    Deallocate(ringce, 64)
                    Deallocate(faces, 65536)
                    Deallocate(er, 65536)
                    Deallocate(ev, 65536)
                    ReturnValue(0)
                }
                rho = 0
            }
            CAD_Topo_Lathe.j = 0
            WhileLoop LessThan(CAD_Topo_Lathe.j, CAD_Topo_Lathe.na) {
                j = CAD_Topo_Lathe.j
                i = CAD_Topo_Lathe.i
                na = CAD_Topo_Lathe.na
                a = Float_Mul(two_pi, Float_Div(Float_FromInt(j), Float_FromInt(na)))
                ArraySet(pt, 0, Float_Mul(rho, CAD_Geom.Cos(a)))
                ArraySet(pt, 1, Float_Mul(rho, CAD_Geom.Sin(a)))
                ArraySet(pt, 2, zz)
                ArraySet(verts, Add(Multiply(i, na), j), CAD_Topo.MakeVertex(pt))
                CAD_Topo_Lathe.j = Add(CAD_Topo_Lathe.j, 1)
            }
            CAD_Topo_Lathe.i = Add(CAD_Topo_Lathe.i, 1)
            np = CAD_Topo_Lathe.np
        }
        // ring edges per profile vertex
        CAD_Topo_Lathe.i = 0
        np = CAD_Topo_Lathe.np
        WhileLoop LessThan(CAD_Topo_Lathe.i, np) {
            i = CAD_Topo_Lathe.i
            na = CAD_Topo_Lathe.na
            CAD_Topo_Lathe.j = 0
            WhileLoop LessThan(CAD_Topo_Lathe.j, CAD_Topo_Lathe.na) {
                j = CAD_Topo_Lathe.j
                i = CAD_Topo_Lathe.i
                na = CAD_Topo_Lathe.na
                jn = Add(j, 1)
                IfCondition EqualTo(jn, na) ThenBlock: { jn = 0 }
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(i, na), jn))
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, CAD_Store.Read(va, 2))
                ArraySet(p1b, 0, CAD_Store.Read(vb, 0))
                ArraySet(p1b, 1, CAD_Store.Read(vb, 1))
                ArraySet(p1b, 2, CAD_Store.Read(vb, 2))
                ArraySet(er, Add(Multiply(i, na), j), CAD_Topo.MakeEdge(va, vb, CAD_Geom.MakeLine(pt, p1b)))
                CAD_Topo_Lathe.j = Add(CAD_Topo_Lathe.j, 1)
            }
            CAD_Topo_Lathe.i = Add(CAD_Topo_Lathe.i, 1)
            np = CAD_Topo_Lathe.np
        }
        // profile edges between ring i and next (mod np)
        CAD_Topo_Lathe.i = 0
        np = CAD_Topo_Lathe.np
        WhileLoop LessThan(CAD_Topo_Lathe.i, np) {
            i = CAD_Topo_Lathe.i
            np = CAD_Topo_Lathe.np
            na = CAD_Topo_Lathe.na
            inx = Add(i, 1)
            IfCondition EqualTo(inx, np) ThenBlock: { inx = 0 }
            CAD_Topo_Lathe.j = 0
            WhileLoop LessThan(CAD_Topo_Lathe.j, CAD_Topo_Lathe.na) {
                j = CAD_Topo_Lathe.j
                i = CAD_Topo_Lathe.i
                na = CAD_Topo_Lathe.na
                np = CAD_Topo_Lathe.np
                inx = Add(i, 1)
                IfCondition EqualTo(inx, np) ThenBlock: { inx = 0 }
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(inx, na), j))
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, CAD_Store.Read(va, 2))
                ArraySet(p1b, 0, CAD_Store.Read(vb, 0))
                ArraySet(p1b, 1, CAD_Store.Read(vb, 1))
                ArraySet(p1b, 2, CAD_Store.Read(vb, 2))
                ArraySet(ev, Add(Multiply(i, na), j), CAD_Topo.MakeEdge(va, vb, CAD_Geom.MakeLine(pt, p1b)))
                CAD_Topo_Lathe.j = Add(CAD_Topo_Lathe.j, 1)
            }
            CAD_Topo_Lathe.i = Add(CAD_Topo_Lathe.i, 1)
            np = CAD_Topo_Lathe.np
        }
        // coedges
        CAD_Topo_Lathe.i = 0
        np = CAD_Topo_Lathe.np
        WhileLoop LessThan(CAD_Topo_Lathe.i, np) {
            CAD_Topo_Lathe.j = 0
            WhileLoop LessThan(CAD_Topo_Lathe.j, CAD_Topo_Lathe.na) {
                j = CAD_Topo_Lathe.j
                i = CAD_Topo_Lathe.i
                na = CAD_Topo_Lathe.na
                np = CAD_Topo_Lathe.np
                jn = Add(j, 1)
                IfCondition EqualTo(jn, na) ThenBlock: { jn = 0 }
                e = ArrayGet(er, Add(Multiply(i, na), j))
                c0 = CAD_Topo.MakeCoedge(e, ArrayGet(verts, Add(Multiply(i, na), j)), 1)
                c1 = CAD_Topo.MakeCoedge(e, ArrayGet(verts, Add(Multiply(i, na), jn)), 0)
                CAD_Topo.LinkTwins(c0, c1)
                CAD_Store.Write(e, 3, c0)
                CAD_Store.Write(e, 4, c1)
                i = CAD_Topo_Lathe.i
                j = CAD_Topo_Lathe.j
                na = CAD_Topo_Lathe.na
                np = CAD_Topo_Lathe.np
                e = ArrayGet(ev, Add(Multiply(i, na), j))
                inx = Add(i, 1)
                IfCondition EqualTo(inx, np) ThenBlock: { inx = 0 }
                c0 = CAD_Topo.MakeCoedge(e, ArrayGet(verts, Add(Multiply(i, na), j)), 1)
                c1 = CAD_Topo.MakeCoedge(e, ArrayGet(verts, Add(Multiply(inx, na), j)), 0)
                CAD_Topo.LinkTwins(c0, c1)
                CAD_Store.Write(e, 3, c0)
                CAD_Store.Write(e, 4, c1)
                CAD_Topo_Lathe.j = Add(CAD_Topo_Lathe.j, 1)
            }
            CAD_Topo_Lathe.i = Add(CAD_Topo_Lathe.i, 1)
            np = CAD_Topo_Lathe.np
        }
        // faces: only side quads (closed profile)
        nf = 0
        CAD_Topo_Lathe.i = 0
        np = CAD_Topo_Lathe.np
        WhileLoop LessThan(CAD_Topo_Lathe.i, np) {
            i = CAD_Topo_Lathe.i
            np = CAD_Topo_Lathe.np
            na = CAD_Topo_Lathe.na
            inx = Add(i, 1)
            IfCondition EqualTo(inx, np) ThenBlock: { inx = 0 }
            CAD_Topo_Lathe.j = 0
            WhileLoop LessThan(CAD_Topo_Lathe.j, CAD_Topo_Lathe.na) {
                j = CAD_Topo_Lathe.j
                i = CAD_Topo_Lathe.i
                na = CAD_Topo_Lathe.na
                np = CAD_Topo_Lathe.np
                inx = Add(i, 1)
                IfCondition EqualTo(inx, np) ThenBlock: { inx = 0 }
                jn = Add(j, 1)
                IfCondition EqualTo(jn, na) ThenBlock: { jn = 0 }
                ArraySet(ringce, 0, CAD_Store.Read(ArrayGet(er, Add(Multiply(i, na), j)), 3))
                ArraySet(ringce, 1, CAD_Store.Read(ArrayGet(ev, Add(Multiply(i, na), jn)), 3))
                ArraySet(ringce, 2, CAD_Store.Read(ArrayGet(er, Add(Multiply(inx, na), j)), 4))
                ArraySet(ringce, 3, CAD_Store.Read(ArrayGet(ev, Add(Multiply(i, na), j)), 4))
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(i, na), jn))
                vc = ArrayGet(verts, Add(Multiply(inx, na), j))
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, CAD_Store.Read(va, 2))
                ArraySet(ax, 0, Float_Sub(CAD_Store.Read(vb, 0), CAD_Store.Read(va, 0)))
                ArraySet(ax, 1, Float_Sub(CAD_Store.Read(vb, 1), CAD_Store.Read(va, 1)))
                ArraySet(ax, 2, Float_Sub(CAD_Store.Read(vb, 2), CAD_Store.Read(va, 2)))
                lx = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))), Float_Mul(ArrayGet(ax, 2), ArrayGet(ax, 2))))
                IfCondition EqualTo(CAD_Num.IsZero(lx, 0), 0) ThenBlock: {
                    ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), lx))
                    ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), lx))
                    ArraySet(ax, 2, Float_Div(ArrayGet(ax, 2), lx))
                }
                ArraySet(ay, 0, Float_Sub(CAD_Store.Read(vc, 0), CAD_Store.Read(va, 0)))
                ArraySet(ay, 1, Float_Sub(CAD_Store.Read(vc, 1), CAD_Store.Read(va, 1)))
                ArraySet(ay, 2, Float_Sub(CAD_Store.Read(vc, 2), CAD_Store.Read(va, 2)))
                dot = Float_Add(Float_Add(Float_Mul(ArrayGet(ay, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ay, 1), ArrayGet(ax, 1))), Float_Mul(ArrayGet(ay, 2), ArrayGet(ax, 2)))
                ArraySet(ay, 0, Float_Sub(ArrayGet(ay, 0), Float_Mul(dot, ArrayGet(ax, 0))))
                ArraySet(ay, 1, Float_Sub(ArrayGet(ay, 1), Float_Mul(dot, ArrayGet(ax, 1))))
                ArraySet(ay, 2, Float_Sub(ArrayGet(ay, 2), Float_Mul(dot, ArrayGet(ax, 2))))
                ly = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(ay, 0), ArrayGet(ay, 0)), Float_Mul(ArrayGet(ay, 1), ArrayGet(ay, 1))), Float_Mul(ArrayGet(ay, 2), ArrayGet(ay, 2))))
                IfCondition EqualTo(CAD_Num.IsZero(ly, 0), 0) ThenBlock: {
                    ArraySet(ay, 0, Float_Div(ArrayGet(ay, 0), ly))
                    ArraySet(ay, 1, Float_Div(ArrayGet(ay, 1), ly))
                    ArraySet(ay, 2, Float_Div(ArrayGet(ay, 2), ly))
                }
                sside = CAD_Geom.MakePlaneAxes(pt, ax, ay)
                ls = CAD_Topo.MakeLoop(ArrayGet(ringce, 0))
                CAD_Topo.LinkLoopRing(ringce, 4, ls)
                ArraySet(faces, nf, CAD_Topo.MakeFace(sside, ls))
                nf = Add(nf, 1)
                CAD_Topo_Lathe.j = Add(CAD_Topo_Lathe.j, 1)
            }
            CAD_Topo_Lathe.i = Add(CAD_Topo_Lathe.i, 1)
            np = CAD_Topo_Lathe.np
        }
        i = 0
        WhileLoop LessThan(i, Subtract(nf, 1)) {
            CAD_Store.Write(ArrayGet(faces, i), 3, ArrayGet(faces, Add(i, 1)))
            i = Add(i, 1)
        }
        CAD_Store.Write(ArrayGet(faces, Subtract(nf, 1)), 3, 0)
        h_sh = CAD_Topo.MakeShell(ArrayGet(faces, 0))
        i = 1
        WhileLoop LessThan(i, nf) {
            CAD_Store.Write(ArrayGet(faces, i), 2, h_sh)
            i = Add(i, 1)
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(CAD_Topo_Lathe.out, 0, h_so)
        Deallocate(verts, 65536)
        Deallocate(er, 65536)
        Deallocate(ev, 65536)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ringce, 64)
        Deallocate(faces, 65536)
        ReturnValue(h_so)
    }
}

// Class A surface of revolution (kind 6). RZ profile + axis frame in CAD_Topo_Lathe.
// Display tessellates with CircleSegCount (≥90) — never a stone-tablet n-gon B-Rep.
Function.CAD_Topo.MakeLatheRevolution {
    Input: rz_addr: Address
    Input: n_prof: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(rz_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_prof, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_prof, 512) ThenBlock: { ReturnValue(0) }
        // Pin frame BEFORE any nested call. Re-reading CAD_Topo_Lathe after
        // Alloc/Write was dropping the picked axis (u→0, default +Z / leftover Y)
        // so a tilted line lathed as if it were the world upright through O.
        pox = CAD_Topo_Lathe.ox
        poy = CAD_Topo_Lathe.oy
        poz = CAD_Topo_Lathe.oz
        pux = CAD_Topo_Lathe.ux
        puy = CAD_Topo_Lathe.uy
        puz = CAD_Topo_Lathe.uz
        pnx = CAD_Topo_Lathe.nx
        pny = CAD_Topo_Lathe.ny
        pnz = CAD_Topo_Lathe.nz
        npin = n_prof
        rz_in = rz_addr
        ul = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(pux, pux), Float_Mul(puy, puy)), Float_Mul(puz, puz)))
        IfCondition EqualTo(CAD_Num.IsZero(ul, 0), 1) ThenBlock: {
            pux = 0
            puy = 0
            puz = 0x3FF0000000000000
            pnx = 0x3FF0000000000000
            pny = 0
            pnz = 0
        }
        copy = Allocate(16384)
        rmax = 0
        i = 0
        WhileLoop LessThan(i, npin) {
            rho = ArrayGet(rz_in, Multiply(i, 2))
            zz = ArrayGet(rz_in, Add(Multiply(i, 2), 1))
            IfCondition EqualTo(CAD_Num.IsNeg(rho), 1) ThenBlock: { rho = 0 }
            ArraySet(copy, Multiply(i, 2), rho)
            ArraySet(copy, Add(Multiply(i, 2), 1), zz)
            IfCondition EqualTo(Float_Le(rmax, rho), 1) ThenBlock: { rmax = rho }
            i = Add(i, 1)
        }
        IfCondition EqualTo(CAD_Num.IsZero(rmax, 0), 1) ThenBlock: {
            Deallocate(copy, 16384)
            ReturnValue(0)
        }
        ph = CAD_Store.Alloc(18, 16)
        IfCondition EqualTo(ph, 0) ThenBlock: {
            Deallocate(copy, 16384)
            ReturnValue(0)
        }
        CAD_Store.Write(ph, 0, npin)
        CAD_Store.Write(ph, 1, rmax)
        CAD_Store.Write(ph, 2, pox)
        CAD_Store.Write(ph, 3, poy)
        CAD_Store.Write(ph, 4, poz)
        CAD_Store.Write(ph, 5, pux)
        CAD_Store.Write(ph, 6, puy)
        CAD_Store.Write(ph, 7, puz)
        CAD_Store.Write(ph, 8, pnx)
        CAD_Store.Write(ph, 9, pny)
        CAD_Store.Write(ph, 10, pnz)
        CAD_Store.Write(ph, 11, copy)
        sw = CAD_Topo_Lathe.sweep
        IfCondition LessThan(sw, 1) ThenBlock: { sw = 360 }
        IfCondition GreaterThan(sw, 360) ThenBlock: { sw = 360 }
        CAD_Store.Write(ph, 12, sw)
        h_so = CAD_Topo.MakeSolid(0)
        CAD_Store.Write(h_so, 1, ph)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 6)
        IfCondition NotEqual(out_solid_addr, 0) ThenBlock: {
            ArraySet(out_solid_addr, 0, h_so)
        }
        PrintMessage("[lathe] ClassA n=")
        PrintNumber(n_prof)
        PrintMessage("\n")
        ReturnValue(h_so)
    }
}

// Washer (annulus) with concave plane–cyl fillet on top *inner* rim.
// r_in < r_out, R < (r_out-r_in)/2 roughly, R < h. Kind 0 closed lathe.
Function.CAD_Topo.MakeWasherTopInnerFillet {
    Input: r_in_r: Integer
    Input: r_out_r: Integer
    Input: height_r: Integer
    Input: fillet_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Float_Le(r_out_r, r_in_r), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(fillet_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(height_r, fillet_r), 1) ThenBlock: { ReturnValue(0) }
        gap = Float_Sub(r_out_r, r_in_r)
        IfCondition EqualTo(Float_Le(gap, fillet_r), 1) ThenBlock: { ReturnValue(0) }
        R = fillet_r
        ri = r_in_r
        ro = r_out_r
        h = height_r
        n_arc = 6
        // closed profile: bot-out, top-out, top-to-fillet, fillet, hole wall bot, bot-in→close
        // (ro,0)(ro,h)(ri+R,h) + fillet to (ri,h-R) + (ri,0)
        n_prof = Add(4, n_arc)
        rz = Allocate(512)
        ArraySet(rz, 0, ro)
        ArraySet(rz, 1, 0)
        ArraySet(rz, 2, ro)
        ArraySet(rz, 3, h)
        // fillet center (ri+R, h-R); φ from π/2 (top) to π (hole)
        half_pi = 0x3FF921FB54442D18
        pi = 0x400921FB54442D18
        rc = Float_Add(ri, R)
        zc = Float_Sub(h, R)
        k = 0
        WhileLoop LessEqual(k, n_arc) {
            t = Float_Div(Float_FromInt(k), Float_FromInt(n_arc))
            ang = Float_Add(half_pi, Float_Mul(half_pi, t))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            idx = Add(2, k)
            ArraySet(rz, Multiply(idx, 2), Float_Add(rc, Float_Mul(R, c)))
            ArraySet(rz, Add(Multiply(idx, 2), 1), Float_Add(zc, Float_Mul(R, s)))
            k = Add(k, 1)
        }
        // after fillet last is (ri, h-R); append (ri, 0)
        // n_prof = 2 + (n_arc+1) + 1 = 4+n_arc
        ArraySet(rz, Multiply(Subtract(n_prof, 1), 2), ri)
        ArraySet(rz, Add(Multiply(Subtract(n_prof, 1), 2), 1), 0)
        out = Allocate(16)
        hs = CAD_Topo.MakeLatheClosed(rz, n_prof, 24, out)
        Deallocate(rz, 512)
        Deallocate(out, 16)
        IfCondition EqualTo(hs, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(out_solid_addr, 0, hs)
        ReturnValue(hs)
    }
}

// N-gon prism approximation (debug / stress). Prefer MakeCylinderSolid.
// n_seg 4..256. Chord edges; kind still 1 so STEP stays analytic.
Function.CAD_Topo.MakeCylinderPrismSolid {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: n_seg: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        n = n_seg
        IfCondition LessThan(n, 4) ThenBlock: { n = 4 }
        IfCondition GreaterThan(n, 256) ThenBlock: { n = 256 }

        // handle tables: 256 * 8 bytes = 2048
        vb = Allocate(2048)
        vt = Allocate(2048)
        eb = Allocate(2048)
        et = Allocate(2048)
        ev = Allocate(2048)
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        frame = Allocate(128)
        ring = Allocate(2048)

        two_pi = 0x401921FB54442D18
        one = 0x3FF0000000000000
        zro = 0x0000000000000000
        neg1 = 0xBFF0000000000000
        nf = Float_FromInt(n)

        // circle + cylinder analytic surfaces (shared)
        ArraySet(frame, 0, zro)
        ArraySet(frame, 1, zro)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 3, one)
        ArraySet(frame, 4, zro)
        ArraySet(frame, 5, zro)
        ArraySet(frame, 6, zro)
        ArraySet(frame, 7, one)
        ArraySet(frame, 8, zro)
        circ_bot = CAD_Geom.MakeCircle(frame, radius_r)
        ArraySet(frame, 2, height_r)
        circ_top = CAD_Geom.MakeCircle(frame, radius_r)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 9, zro)
        ArraySet(frame, 10, zro)
        ArraySet(frame, 11, one)
        cyl_s = CAD_Geom.MakeCylinderSurf(frame, radius_r)

        // bottom plane -Z, top +Z
        ArraySet(pt, 0, zro)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, height_r)
        ArraySet(ay, 1, one)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)

        // vertices
        i = 0
        WhileLoop LessThan(i, n) {
            ang = Float_Mul(two_pi, Float_Div(Float_FromInt(i), nf))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            x = Float_Mul(radius_r, c)
            y = Float_Mul(radius_r, s)
            ArraySet(pt, 0, x)
            ArraySet(pt, 1, y)
            ArraySet(pt, 2, zro)
            ArraySet(vb, i, CAD_Topo.MakeVertex(pt))
            ArraySet(pt, 2, height_r)
            ArraySet(vt, i, CAD_Topo.MakeVertex(pt))
            i = Add(i, 1)
        }

        // edges: bottom, top, vertical (+ line curves)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }

            // bottom chord
            ArraySet(pt, 0, CAD_Store.Read(ArrayGet(vb, i), 0))
            ArraySet(pt, 1, CAD_Store.Read(ArrayGet(vb, i), 1))
            ArraySet(pt, 2, CAD_Store.Read(ArrayGet(vb, i), 2))
            ArraySet(p1b, 0, CAD_Store.Read(ArrayGet(vb, j), 0))
            ArraySet(p1b, 1, CAD_Store.Read(ArrayGet(vb, j), 1))
            ArraySet(p1b, 2, CAD_Store.Read(ArrayGet(vb, j), 2))
            ln = CAD_Geom.MakeLine(pt, p1b)
            ArraySet(eb, i, CAD_Topo.MakeEdge(ArrayGet(vb, i), ArrayGet(vb, j), ln))

            // top chord
            ArraySet(pt, 0, CAD_Store.Read(ArrayGet(vt, i), 0))
            ArraySet(pt, 1, CAD_Store.Read(ArrayGet(vt, i), 1))
            ArraySet(pt, 2, CAD_Store.Read(ArrayGet(vt, i), 2))
            ArraySet(p1b, 0, CAD_Store.Read(ArrayGet(vt, j), 0))
            ArraySet(p1b, 1, CAD_Store.Read(ArrayGet(vt, j), 1))
            ArraySet(p1b, 2, CAD_Store.Read(ArrayGet(vt, j), 2))
            ln = CAD_Geom.MakeLine(pt, p1b)
            ArraySet(et, i, CAD_Topo.MakeEdge(ArrayGet(vt, i), ArrayGet(vt, j), ln))

            // vertical
            ArraySet(pt, 0, CAD_Store.Read(ArrayGet(vb, i), 0))
            ArraySet(pt, 1, CAD_Store.Read(ArrayGet(vb, i), 1))
            ArraySet(pt, 2, zro)
            ArraySet(p1b, 0, ArrayGet(pt, 0))
            ArraySet(p1b, 1, ArrayGet(pt, 1))
            ArraySet(p1b, 2, height_r)
            ln = CAD_Geom.MakeLine(pt, p1b)
            ArraySet(ev, i, CAD_Topo.MakeEdge(ArrayGet(vb, i), ArrayGet(vt, i), ln))
            i = Add(i, 1)
        }

        // Side faces (quads) + coedges. Outward: bot i→j, vert j, top j→i, vert i down
        // coedge scratch tables: we create twins when both sides known
        // For each edge store first coedge in edge slots 3/4 as we go
        first_side = 0
        prev_face = 0
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            IfCondition GreaterEqual(j, n) ThenBlock: { j = 0 }

            ebi = ArrayGet(eb, i)
            eti = ArrayGet(et, i)
            evi = ArrayGet(ev, i)
            evj = ArrayGet(ev, j)

            // side coedges (primary sense for this face)
            cb = CAD_Topo.MakeCoedge(ebi, ArrayGet(vb, i), 1)
            cvj = CAD_Topo.MakeCoedge(evj, ArrayGet(vb, j), 1)
            ct = CAD_Topo.MakeCoedge(eti, ArrayGet(vt, j), 0)
            cvi = CAD_Topo.MakeCoedge(evi, ArrayGet(vt, i), 0)

            // mate coedges for radial (will be used by caps / other side)
            // bottom mate used by bottom cap: reverse
            cbm = CAD_Topo.MakeCoedge(ebi, ArrayGet(vb, j), 0)
            CAD_Topo.LinkTwins(cb, cbm)
            CAD_Store.Write(ebi, 3, cb)
            CAD_Store.Write(ebi, 4, cbm)

            ctm = CAD_Topo.MakeCoedge(eti, ArrayGet(vt, i), 1)
            CAD_Topo.LinkTwins(ct, ctm)
            CAD_Store.Write(eti, 3, ct)
            CAD_Store.Write(eti, 4, ctm)

            // vertical: side uses reverse (down); mate is up for... only one side face uses each vertical twice? 
            // Each vertical shared by two side faces only — NOT by caps.
            // Face i uses evi reverse (top→bot); face (i-1) uses evi forward (bot→top)
            // So twins are the two side coedges. Create mate only once — on first creation.
            // When i uses evi reverse, previous face j-1 already created forward on evi as "cvj" of that face.
            // Simpler: create both coedges for verticals in a pre-pass.

            ArraySet(ring, 0, cb)
            ArraySet(ring, 1, cvj)
            ArraySet(ring, 2, ct)
            ArraySet(ring, 3, cvi)
            // vertical twins: deferred — LinkTwins later via stored

            lp = CAD_Topo.MakeLoop(cb)
            CAD_Topo.LinkLoopRing(ring, 4, lp)
            fc = CAD_Topo.MakeFace(cyl_s, lp)
            IfCondition EqualTo(i, 0) ThenBlock: {
                first_side = fc
            }
            IfCondition NotEqual(prev_face, 0) ThenBlock: {
                CAD_Store.Write(prev_face, 3, fc)
            }
            prev_face = fc

            // stash side coedges for vertical twin linking: use edge slot temporarily
            // store forward coedge for vertical i in edge.unused field 5 if free
            // Edge stride 6: 0 v0 1 v1 2 curve 3 coa 4 cob 5 unused
            // For vertical edge: we need both coedges. Face i creates cvi (rev).
            // Face (i-1) creates cvj when j=i which is forward on evi.
            // After all sides, walk and LinkTwins if both set.

            // Save reverse coedge on evi field 4, forward on field 3 when created
            CAD_Store.Write(evi, 4, cvi)
            CAD_Store.Write(evj, 3, cvj)

            i = Add(i, 1)
        }

        // Link vertical twins
        i = 0
        WhileLoop LessThan(i, n) {
            evi = ArrayGet(ev, i)
            ca = CAD_Store.Read(evi, 3)
            cb2 = CAD_Store.Read(evi, 4)
            IfCondition NotEqual(ca, 0) ThenBlock: {
                IfCondition NotEqual(cb2, 0) ThenBlock: {
                    CAD_Topo.LinkTwins(ca, cb2)
                }
            }
            i = Add(i, 1)
        }

        // Bottom cap: outward -Z. Loop uses bottom edge mates (cbm), reverse around
        // For i = 0..n-1: walk edges reverse: edge (n-1-i) mate = from vb[j] to vb[i] when edge i is i→j
        // CCW from below = decreasing index: start at 0, go to n-1, n-2, ...
        // Edge k from k→(k+1)%n. Mate coedge origin is (k+1), sense 0.
        // Chain: ... for k = n-1, n-2, ..., 0: use mate of edge k
        i = 0
        WhileLoop LessThan(i, n) {
            // index of edge in reverse walk: e = n-1-i
            eidx = Subtract(n, Add(i, 1))
            ebi = ArrayGet(eb, eidx)
            // mate is coedge_b (slot 4)
            ArraySet(ring, i, CAD_Store.Read(ebi, 4))
            i = Add(i, 1)
        }
        lp_bot = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n, lp_bot)
        f_bot = CAD_Topo.MakeFace(pl_bot, lp_bot)
        CAD_Store.Write(prev_face, 3, f_bot)
        prev_face = f_bot

        // Top cap: outward +Z, edges forward i=0..n-1 use mate? 
        // Side used ct = reverse on top edge (origin vt[j], sense 0). Mate ctm sense 1 origin vt[i].
        // Top walk CCW from +Z: i → i+1 uses forward on et[i] which is ctm (slot 4)
        i = 0
        WhileLoop LessThan(i, n) {
            eti = ArrayGet(et, i)
            ArraySet(ring, i, CAD_Store.Read(eti, 4))
            i = Add(i, 1)
        }
        lp_top = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n, lp_top)
        f_top = CAD_Topo.MakeFace(pl_top, lp_top)
        CAD_Store.Write(prev_face, 3, f_top)
        CAD_Store.Write(f_top, 3, 0)

        // Attach circle curves as metadata on first bottom/top edge curve field already line;
        // store circle handles on face unused slots 4,5 for export later
        CAD_Store.Write(f_bot, 4, circ_bot)
        CAD_Store.Write(f_top, 4, circ_top)

        h_sh = CAD_Topo.MakeShell(first_side)
        // set shell on all faces
        fx = first_side
        guard = 0
        WhileLoop NotEqual(fx, 0) {
            CAD_Store.Write(fx, 2, h_sh)
            fx = CAD_Store.Read(fx, 3)
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 256) ThenBlock: { fx = 0 }
        }

        h_so = CAD_Topo.MakeSolid(h_sh)
        // kind 2 prism; params r,h,ox,oy,oz for tess/STEP/translate
        ph2 = CAD_Store.Alloc(13, 8)
        CAD_Store.Write(ph2, 0, radius_r)
        CAD_Store.Write(ph2, 1, height_r)
        CAD_Store.Write(ph2, 2, 0)
        CAD_Store.Write(ph2, 3, 0)
        CAD_Store.Write(ph2, 4, 0)
        CAD_Store.Write(ph2, 5, 0)
        CAD_Store.Write(ph2, 6, 0)
        CAD_Store.Write(ph2, 7, 0)
        CAD_Store.Write(h_so, 1, ph2)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 2)
        ArraySet(out_solid_addr, 0, h_so)

        Deallocate(vb, 2048)
        Deallocate(vt, 2048)
        Deallocate(eb, 2048)
        Deallocate(et, 2048)
        Deallocate(ev, 2048)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(frame, 128)
        Deallocate(ring, 2048)
        ReturnValue(h_so)
    }
}

// Box hole solid. pack_addr: [dx,dy,dz, hole_r, cx, cy, hole_depth]
// hole_depth >= dz → through; else blind pocket from top (z=dz down).
