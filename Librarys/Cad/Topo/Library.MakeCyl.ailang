LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.MakeCylinderSolid {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        one = 0x3FF0000000000000
        zro = 0x0000000000000000
        neg1 = 0xBFF0000000000000
        pt = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        frame = Allocate(128)
        ring = Allocate(64)

        // Seam verts on +X
        ArraySet(pt, 0, radius_r)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        vb = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 2, height_r)
        vt = CAD_Topo.MakeVertex(pt)

        // Geom: circles, cylinder, planes
        ArraySet(frame, 0, zro)
        ArraySet(frame, 1, zro)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 3, one)
        ArraySet(frame, 4, zro)
        ArraySet(frame, 5, zro)
        ArraySet(frame, 6, zro)
        ArraySet(frame, 7, one)
        ArraySet(frame, 8, zro)
        circ_bot = CAD_Geom.MakeCircle(frame, radius_r)
        ArraySet(frame, 2, height_r)
        circ_top = CAD_Geom.MakeCircle(frame, radius_r)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 9, zro)
        ArraySet(frame, 10, zro)
        ArraySet(frame, 11, one)
        cyl_s = CAD_Geom.MakeCylinderSurf(frame, radius_r)

        ArraySet(pt, 0, zro)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, height_r)
        ArraySet(ay, 1, one)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)

        // Edges: closed circles (v0==v1) + generator
        eb = CAD_Topo.MakeEdge(vb, vb, circ_bot)
        et = CAD_Topo.MakeEdge(vt, vt, circ_top)
        ArraySet(pt, 0, radius_r)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, radius_r)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, height_r)
        ln = CAD_Geom.MakeLine(pt, ax)
        es = CAD_Topo.MakeEdge(vb, vt, ln)

        // Coedges: each edge → face pair (side vs cap)
        cb_side = CAD_Topo.MakeCoedge(eb, vb, 1)
        cb_bot = CAD_Topo.MakeCoedge(eb, vb, 0)
        CAD_Topo.LinkTwins(cb_side, cb_bot)
        CAD_Store.Write(eb, 3, cb_side)
        CAD_Store.Write(eb, 4, cb_bot)

        ct_top = CAD_Topo.MakeCoedge(et, vt, 1)
        ct_side = CAD_Topo.MakeCoedge(et, vt, 0)
        CAD_Topo.LinkTwins(ct_top, ct_side)
        CAD_Store.Write(et, 3, ct_top)
        CAD_Store.Write(et, 4, ct_side)

        cs_up = CAD_Topo.MakeCoedge(es, vb, 1)
        cs_dn = CAD_Topo.MakeCoedge(es, vt, 0)
        CAD_Topo.LinkTwins(cs_up, cs_dn)
        CAD_Store.Write(es, 3, cs_up)
        CAD_Store.Write(es, 4, cs_dn)

        // Bottom cap: single reverse circle (outward -Z)
        lp_bot = CAD_Topo.MakeLoop(cb_bot)
        CAD_Store.Write(cb_bot, 2, cb_bot)
        CAD_Store.Write(cb_bot, 3, cb_bot)
        CAD_Store.Write(cb_bot, 4, lp_bot)
        CAD_Store.Write(lp_bot, 0, cb_bot)
        f_bot = CAD_Topo.MakeFace(pl_bot, lp_bot)

        // Top cap: single forward circle
        lp_top = CAD_Topo.MakeLoop(ct_top)
        CAD_Store.Write(ct_top, 2, ct_top)
        CAD_Store.Write(ct_top, 3, ct_top)
        CAD_Store.Write(ct_top, 4, lp_top)
        CAD_Store.Write(lp_top, 0, ct_top)
        f_top = CAD_Topo.MakeFace(pl_top, lp_top)

        // Side: bottom fwd, seam up, top rev, seam down
        lp_side = CAD_Topo.MakeLoop(cb_side)
        ring = Allocate(64)
        ArraySet(ring, 0, cb_side)
        ArraySet(ring, 1, cs_up)
        ArraySet(ring, 2, ct_side)
        ArraySet(ring, 3, cs_dn)
        CAD_Topo.LinkLoopRing(ring, 4, lp_side)
        f_side = CAD_Topo.MakeFace(cyl_s, lp_side)

        CAD_Store.Write(f_bot, 3, f_top)
        CAD_Store.Write(f_top, 3, f_side)
        CAD_Store.Write(f_side, 3, 0)
        CAD_Store.Write(f_bot, 4, circ_bot)
        CAD_Store.Write(f_top, 4, circ_top)

        h_sh = CAD_Topo.MakeShell(f_bot)
        CAD_Store.Write(f_top, 2, h_sh)
        CAD_Store.Write(f_side, 2, h_sh)
        h_so = CAD_Topo.MakeSolid(h_sh)
        // params: r, h, ox, oy, oz
        ph = CAD_Store.Alloc(13, 8)
        CAD_Store.Write(ph, 0, radius_r)
        CAD_Store.Write(ph, 1, height_r)
        CAD_Store.Write(ph, 2, zro)
        CAD_Store.Write(ph, 3, zro)
        CAD_Store.Write(ph, 4, zro)
        CAD_Store.Write(ph, 5, 0)
        CAD_Store.Write(ph, 6, 0)
        CAD_Store.Write(ph, 7, 0)
        CAD_Store.Write(h_so, 1, ph)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 1)
        ArraySet(out_solid_addr, 0, h_so)

        Deallocate(pt, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(frame, 128)
        Deallocate(ring, 64)
        ReturnValue(h_so)
    }
}

// Lathe solid: revolve RZ profile about +Z into kind-0 shell.
// rz_addr: [rho,z]*n_rings (rho>=0), n_rings 3..32, n_ang 8..64.
// Caps = ring 0 and ring n_rings-1; side quads between consecutive rings.
Function.CAD_Topo.MakeLatheSolid {
    Input: rz_addr: Address
    Input: n_rings: Integer
    Input: n_ang: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n_rings, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_rings, 32) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n_ang, 8) ThenBlock: { n_ang = 8 }
        IfCondition GreaterThan(n_ang, 128) ThenBlock: { n_ang = 128 }
        nr = n_rings
        na = n_ang
        // verts[ring * na + j]
        maxv = Multiply(nr, na)
        IfCondition GreaterThan(maxv, 2048) ThenBlock: { ReturnValue(0) }
        verts = Allocate(16384)
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(1024)
        faces = Allocate(4096)
        two_pi = 0x401921FB54442D18
        one = 0x3FF0000000000000
        zro = 0
        i = 0
        WhileLoop LessThan(i, nr) {
            rho = ArrayGet(rz_addr, Multiply(i, 2))
            zz = ArrayGet(rz_addr, Add(Multiply(i, 2), 1))
            IfCondition EqualTo(CAD_Num.IsNeg(rho), 1) ThenBlock: {
                mag = Float_Sub(0, rho)
                IfCondition EqualTo(Float_Le(0x3EE4F8B588E368F1, mag), 1) ThenBlock: {
                    Deallocate(verts, 16384)
                    Deallocate(pt, 32)
                    Deallocate(p1b, 32)
                    Deallocate(ax, 32)
                    Deallocate(ay, 32)
                    Deallocate(ring, 1024)
                    Deallocate(faces, 4096)
                    ReturnValue(0)
                }
                rho = 0
            }
            j = 0
            WhileLoop LessThan(j, na) {
                a = Float_Mul(two_pi, Float_Div(Float_FromInt(j), Float_FromInt(na)))
                ArraySet(pt, 0, Float_Mul(rho, CAD_Geom.Cos(a)))
                ArraySet(pt, 1, Float_Mul(rho, CAD_Geom.Sin(a)))
                ArraySet(pt, 2, zz)
                ArraySet(verts, Add(Multiply(i, na), j), CAD_Topo.MakeVertex(pt))
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        // edges: ring edges er[i][j] between j and j+1; vertical ev[i][j] ring i to i+1
        er = Allocate(16384)
        ev = Allocate(16384)
        i = 0
        WhileLoop LessThan(i, nr) {
            j = 0
            WhileLoop LessThan(j, na) {
                jn = Add(j, 1)
                IfCondition EqualTo(jn, na) ThenBlock: { jn = 0 }
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(i, na), jn))
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, CAD_Store.Read(va, 2))
                ArraySet(p1b, 0, CAD_Store.Read(vb, 0))
                ArraySet(p1b, 1, CAD_Store.Read(vb, 1))
                ArraySet(p1b, 2, CAD_Store.Read(vb, 2))
                ArraySet(er, Add(Multiply(i, na), j), CAD_Topo.MakeEdge(va, vb, CAD_Geom.MakeLine(pt, p1b)))
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, Subtract(nr, 1)) {
            j = 0
            WhileLoop LessThan(j, na) {
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(Add(i, 1), na), j))
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, CAD_Store.Read(va, 2))
                ArraySet(p1b, 0, CAD_Store.Read(vb, 0))
                ArraySet(p1b, 1, CAD_Store.Read(vb, 1))
                ArraySet(p1b, 2, CAD_Store.Read(vb, 2))
                ArraySet(ev, Add(Multiply(i, na), j), CAD_Topo.MakeEdge(va, vb, CAD_Geom.MakeLine(pt, p1b)))
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        // coedges for ring and vertical edges
        i = 0
        WhileLoop LessThan(i, nr) {
            j = 0
            WhileLoop LessThan(j, na) {
                jn = Add(j, 1)
                IfCondition EqualTo(jn, na) ThenBlock: { jn = 0 }
                e = ArrayGet(er, Add(Multiply(i, na), j))
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(i, na), jn))
                c0 = CAD_Topo.MakeCoedge(e, va, 1)
                c1 = CAD_Topo.MakeCoedge(e, vb, 0)
                CAD_Topo.LinkTwins(c0, c1)
                CAD_Store.Write(e, 3, c0)
                CAD_Store.Write(e, 4, c1)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, Subtract(nr, 1)) {
            j = 0
            WhileLoop LessThan(j, na) {
                e = ArrayGet(ev, Add(Multiply(i, na), j))
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(Add(i, 1), na), j))
                c0 = CAD_Topo.MakeCoedge(e, va, 1)
                c1 = CAD_Topo.MakeCoedge(e, vb, 0)
                CAD_Topo.LinkTwins(c0, c1)
                CAD_Store.Write(e, 3, c0)
                CAD_Store.Write(e, 4, c1)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        nf = 0
        // bottom cap: reverse ring 0 (outward -Z)
        j = 0
        WhileLoop LessThan(j, na) {
            k = Subtract(na, Add(j, 1))
            e = ArrayGet(er, k)
            ArraySet(ring, j, CAD_Store.Read(e, 4))
            j = Add(j, 1)
        }
        ArraySet(pt, 0, 0)
        ArraySet(pt, 1, 0)
        ArraySet(pt, 2, ArrayGet(rz_addr, 1))
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, 0xBFF0000000000000)
        ArraySet(ay, 2, zro)
        sbot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        lbot = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, na, lbot)
        ArraySet(faces, nf, CAD_Topo.MakeFace(sbot, lbot))
        nf = Add(nf, 1)
        // top cap: forward last ring
        last = Subtract(nr, 1)
        j = 0
        WhileLoop LessThan(j, na) {
            e = ArrayGet(er, Add(Multiply(last, na), j))
            ArraySet(ring, j, CAD_Store.Read(e, 3))
            j = Add(j, 1)
        }
        ArraySet(pt, 2, ArrayGet(rz_addr, Add(Multiply(last, 2), 1)))
        ArraySet(ay, 1, one)
        stop = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ltop = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, na, ltop)
        ArraySet(faces, nf, CAD_Topo.MakeFace(stop, ltop))
        nf = Add(nf, 1)
        // side quads: between ring i and i+1
        i = 0
        WhileLoop LessThan(i, Subtract(nr, 1)) {
            j = 0
            WhileLoop LessThan(j, na) {
                jn = Add(j, 1)
                IfCondition EqualTo(jn, na) ThenBlock: { jn = 0 }
                // bottom ring fwd, vert jn up, top rev, vert j down
                ArraySet(ring, 0, CAD_Store.Read(ArrayGet(er, Add(Multiply(i, na), j)), 3))
                ArraySet(ring, 1, CAD_Store.Read(ArrayGet(ev, Add(Multiply(i, na), jn)), 3))
                ArraySet(ring, 2, CAD_Store.Read(ArrayGet(er, Add(Multiply(Add(i, 1), na), j)), 4))
                ArraySet(ring, 3, CAD_Store.Read(ArrayGet(ev, Add(Multiply(i, na), j)), 4))
                va = ArrayGet(verts, Add(Multiply(i, na), j))
                vb = ArrayGet(verts, Add(Multiply(i, na), jn))
                vc = ArrayGet(verts, Add(Multiply(Add(i, 1), na), j))
                ArraySet(pt, 0, CAD_Store.Read(va, 0))
                ArraySet(pt, 1, CAD_Store.Read(va, 1))
                ArraySet(pt, 2, CAD_Store.Read(va, 2))
                ArraySet(ax, 0, Float_Sub(CAD_Store.Read(vb, 0), CAD_Store.Read(va, 0)))
                ArraySet(ax, 1, Float_Sub(CAD_Store.Read(vb, 1), CAD_Store.Read(va, 1)))
                ArraySet(ax, 2, Float_Sub(CAD_Store.Read(vb, 2), CAD_Store.Read(va, 2)))
                lx = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))), Float_Mul(ArrayGet(ax, 2), ArrayGet(ax, 2))))
                IfCondition EqualTo(CAD_Num.IsZero(lx, 0), 0) ThenBlock: {
                    ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), lx))
                    ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), lx))
                    ArraySet(ax, 2, Float_Div(ArrayGet(ax, 2), lx))
                }
                ArraySet(ay, 0, Float_Sub(CAD_Store.Read(vc, 0), CAD_Store.Read(va, 0)))
                ArraySet(ay, 1, Float_Sub(CAD_Store.Read(vc, 1), CAD_Store.Read(va, 1)))
                ArraySet(ay, 2, Float_Sub(CAD_Store.Read(vc, 2), CAD_Store.Read(va, 2)))
                dot = Float_Add(Float_Add(Float_Mul(ArrayGet(ay, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ay, 1), ArrayGet(ax, 1))), Float_Mul(ArrayGet(ay, 2), ArrayGet(ax, 2)))
                ArraySet(ay, 0, Float_Sub(ArrayGet(ay, 0), Float_Mul(dot, ArrayGet(ax, 0))))
                ArraySet(ay, 1, Float_Sub(ArrayGet(ay, 1), Float_Mul(dot, ArrayGet(ax, 1))))
                ArraySet(ay, 2, Float_Sub(ArrayGet(ay, 2), Float_Mul(dot, ArrayGet(ax, 2))))
                ly = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(ay, 0), ArrayGet(ay, 0)), Float_Mul(ArrayGet(ay, 1), ArrayGet(ay, 1))), Float_Mul(ArrayGet(ay, 2), ArrayGet(ay, 2))))
                IfCondition EqualTo(CAD_Num.IsZero(ly, 0), 0) ThenBlock: {
                    ArraySet(ay, 0, Float_Div(ArrayGet(ay, 0), ly))
                    ArraySet(ay, 1, Float_Div(ArrayGet(ay, 1), ly))
                    ArraySet(ay, 2, Float_Div(ArrayGet(ay, 2), ly))
                }
                sside = CAD_Geom.MakePlaneAxes(pt, ax, ay)
                ls = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
                CAD_Topo.LinkLoopRing(ring, 4, ls)
                ArraySet(faces, nf, CAD_Topo.MakeFace(sside, ls))
                nf = Add(nf, 1)
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, Subtract(nf, 1)) {
            CAD_Store.Write(ArrayGet(faces, i), 3, ArrayGet(faces, Add(i, 1)))
            i = Add(i, 1)
        }
        CAD_Store.Write(ArrayGet(faces, Subtract(nf, 1)), 3, 0)
        h_sh = CAD_Topo.MakeShell(ArrayGet(faces, 0))
        i = 1
        WhileLoop LessThan(i, nf) {
            CAD_Store.Write(ArrayGet(faces, i), 2, h_sh)
            i = Add(i, 1)
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(verts, 16384)
        Deallocate(er, 16384)
        Deallocate(ev, 16384)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 1024)
        Deallocate(faces, 4096)
        ReturnValue(h_so)
    }
}

// Angular samples so chord sag of a circle of radius r is ≤ 0.05 mm.
// 24 was a visible n-gon on a ~100 mm pad (cylinderfilletmakesngon.png).
Function.CAD_Topo.LatheAngCount {
    Input: radius_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(48) }
        mag = radius_r
        IfCondition EqualTo(CAD_Num.IsNeg(mag), 1) ThenBlock: { mag = Float_Sub(0, mag) }
        // n ≈ π √(r / (2s)), s = 0.05 mm → 2s = 0.1
        two_s = 0x3FB999999999999A
        napprox = CAD_Num.Sqrt(Float_Div(mag, two_s))
        n_ang = Float_ToInt(Float_Mul(0x400921FB54442D18, napprox))
        IfCondition LessThan(n_ang, 48) ThenBlock: { n_ang = 48 }
        IfCondition GreaterThan(n_ang, 128) ThenBlock: { n_ang = 128 }
        ReturnValue(n_ang)
    }
}

// Cylinder with constant-R fillet on top rim (plane–cyl convex outer edge).
// Domain: r>R, h>R. Analytic B-rep: circles + cylinder + quarter-torus. Kind 0.
// Tess samples the circles — the solid is not an n-gon prism.
Function.CAD_Topo.MakeCylinderTopFillet {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: fillet_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(fillet_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(radius_r, fillet_r), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(height_r, fillet_r), 1) ThenBlock: { ReturnValue(0) }
        R = fillet_r
        r = radius_r
        h = height_r
        rc = Float_Sub(r, R)
        zc = Float_Sub(h, R)
        one = 0x3FF0000000000000
        zro = 0x0000000000000000
        neg1 = 0xBFF0000000000000
        pt = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        frame = Allocate(128)
        ring = Allocate(64)

        ArraySet(pt, 0, r)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        vb = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 2, zc)
        vm = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, rc)
        ArraySet(pt, 2, h)
        vt = CAD_Topo.MakeVertex(pt)

        ArraySet(frame, 0, zro)
        ArraySet(frame, 1, zro)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 3, one)
        ArraySet(frame, 4, zro)
        ArraySet(frame, 5, zro)
        ArraySet(frame, 6, zro)
        ArraySet(frame, 7, one)
        ArraySet(frame, 8, zro)
        circ_bot = CAD_Geom.MakeCircle(frame, r)
        ArraySet(frame, 2, zc)
        circ_mid = CAD_Geom.MakeCircle(frame, r)
        ArraySet(frame, 2, h)
        circ_top = CAD_Geom.MakeCircle(frame, rc)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 9, zro)
        ArraySet(frame, 10, zro)
        ArraySet(frame, 11, one)
        cyl_s = CAD_Geom.MakeCylinderSurf(frame, r)
        ArraySet(frame, 0, zro)
        ArraySet(frame, 1, zro)
        ArraySet(frame, 2, zc)
        tor_s = CAD_Geom.MakeTorusSurf(frame, rc, R)

        ArraySet(pt, 0, zro)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, h)
        ArraySet(ay, 1, one)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)

        eb = CAD_Topo.MakeEdge(vb, vb, circ_bot)
        em = CAD_Topo.MakeEdge(vm, vm, circ_mid)
        et = CAD_Topo.MakeEdge(vt, vt, circ_top)
        ArraySet(pt, 0, r)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, r)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zc)
        es = CAD_Topo.MakeEdge(vb, vm, CAD_Geom.MakeLine(pt, ax))
        ArraySet(frame, 0, rc)
        ArraySet(frame, 1, zro)
        ArraySet(frame, 2, zc)
        ArraySet(frame, 3, one)
        ArraySet(frame, 4, zro)
        ArraySet(frame, 5, zro)
        ArraySet(frame, 6, zro)
        ArraySet(frame, 7, zro)
        ArraySet(frame, 8, one)
        circ_mer = CAD_Geom.MakeCircle(frame, R)
        ea = CAD_Topo.MakeEdge(vm, vt, circ_mer)

        cb_side = CAD_Topo.MakeCoedge(eb, vb, 1)
        cb_bot = CAD_Topo.MakeCoedge(eb, vb, 0)
        CAD_Topo.LinkTwins(cb_side, cb_bot)
        CAD_Store.Write(eb, 3, cb_side)
        CAD_Store.Write(eb, 4, cb_bot)

        cm_tor = CAD_Topo.MakeCoedge(em, vm, 1)
        cm_cyl = CAD_Topo.MakeCoedge(em, vm, 0)
        CAD_Topo.LinkTwins(cm_tor, cm_cyl)
        CAD_Store.Write(em, 3, cm_tor)
        CAD_Store.Write(em, 4, cm_cyl)

        ct_top = CAD_Topo.MakeCoedge(et, vt, 1)
        ct_tor = CAD_Topo.MakeCoedge(et, vt, 0)
        CAD_Topo.LinkTwins(ct_top, ct_tor)
        CAD_Store.Write(et, 3, ct_top)
        CAD_Store.Write(et, 4, ct_tor)

        cs_up = CAD_Topo.MakeCoedge(es, vb, 1)
        cs_dn = CAD_Topo.MakeCoedge(es, vm, 0)
        CAD_Topo.LinkTwins(cs_up, cs_dn)
        CAD_Store.Write(es, 3, cs_up)
        CAD_Store.Write(es, 4, cs_dn)

        ca_up = CAD_Topo.MakeCoedge(ea, vm, 1)
        ca_dn = CAD_Topo.MakeCoedge(ea, vt, 0)
        CAD_Topo.LinkTwins(ca_up, ca_dn)
        CAD_Store.Write(ea, 3, ca_up)
        CAD_Store.Write(ea, 4, ca_dn)

        lp_bot = CAD_Topo.MakeLoop(cb_bot)
        CAD_Store.Write(cb_bot, 2, cb_bot)
        CAD_Store.Write(cb_bot, 3, cb_bot)
        CAD_Store.Write(cb_bot, 4, lp_bot)
        CAD_Store.Write(lp_bot, 0, cb_bot)
        f_bot = CAD_Topo.MakeFace(pl_bot, lp_bot)

        lp_top = CAD_Topo.MakeLoop(ct_top)
        CAD_Store.Write(ct_top, 2, ct_top)
        CAD_Store.Write(ct_top, 3, ct_top)
        CAD_Store.Write(ct_top, 4, lp_top)
        CAD_Store.Write(lp_top, 0, ct_top)
        f_top = CAD_Topo.MakeFace(pl_top, lp_top)

        lp_cyl = CAD_Topo.MakeLoop(cb_side)
        ArraySet(ring, 0, cb_side)
        ArraySet(ring, 1, cs_up)
        ArraySet(ring, 2, cm_cyl)
        ArraySet(ring, 3, cs_dn)
        CAD_Topo.LinkLoopRing(ring, 4, lp_cyl)
        f_cyl = CAD_Topo.MakeFace(cyl_s, lp_cyl)

        lp_tor = CAD_Topo.MakeLoop(cm_tor)
        ArraySet(ring, 0, cm_tor)
        ArraySet(ring, 1, ca_up)
        ArraySet(ring, 2, ct_tor)
        ArraySet(ring, 3, ca_dn)
        CAD_Topo.LinkLoopRing(ring, 4, lp_tor)
        f_tor = CAD_Topo.MakeFace(tor_s, lp_tor)

        CAD_Store.Write(f_bot, 3, f_cyl)
        CAD_Store.Write(f_cyl, 3, f_tor)
        CAD_Store.Write(f_tor, 3, f_top)
        CAD_Store.Write(f_top, 3, 0)
        CAD_Store.Write(f_bot, 4, circ_bot)
        CAD_Store.Write(f_top, 4, circ_top)

        h_sh = CAD_Topo.MakeShell(f_bot)
        CAD_Store.Write(f_cyl, 2, h_sh)
        CAD_Store.Write(f_tor, 2, h_sh)
        CAD_Store.Write(f_top, 2, h_sh)
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)

        Deallocate(pt, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(frame, 128)
        Deallocate(ring, 64)
        ReturnValue(h_so)
    }
}

// Cylinder bottom rim plane–cyl fillet (convex). R < r, R < h.
// Analytic B-rep: circles + cylinder + quarter-torus. Kind 0.
Function.CAD_Topo.MakeCylinderBottomFillet {
    Input: radius_r: Integer
    Input: height_r: Integer
    Input: fillet_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(height_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(fillet_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(radius_r, fillet_r), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(height_r, fillet_r), 1) ThenBlock: { ReturnValue(0) }
        R = fillet_r
        r = radius_r
        h = height_r
        rc = Float_Sub(r, R)
        one = 0x3FF0000000000000
        zro = 0x0000000000000000
        neg1 = 0xBFF0000000000000
        pt = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        frame = Allocate(128)
        ring = Allocate(64)

        ArraySet(pt, 0, rc)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        vb = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, r)
        ArraySet(pt, 2, R)
        vm = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 2, h)
        vt = CAD_Topo.MakeVertex(pt)

        ArraySet(frame, 0, zro)
        ArraySet(frame, 1, zro)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 3, one)
        ArraySet(frame, 4, zro)
        ArraySet(frame, 5, zro)
        ArraySet(frame, 6, zro)
        ArraySet(frame, 7, one)
        ArraySet(frame, 8, zro)
        circ_bot = CAD_Geom.MakeCircle(frame, rc)
        ArraySet(frame, 2, R)
        circ_mid = CAD_Geom.MakeCircle(frame, r)
        ArraySet(frame, 2, h)
        circ_top = CAD_Geom.MakeCircle(frame, r)
        ArraySet(frame, 2, R)
        ArraySet(frame, 9, zro)
        ArraySet(frame, 10, zro)
        ArraySet(frame, 11, one)
        cyl_s = CAD_Geom.MakeCylinderSurf(frame, r)
        ArraySet(frame, 2, R)
        tor_s = CAD_Geom.MakeTorusSurf(frame, rc, R)

        ArraySet(pt, 0, zro)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, h)
        ArraySet(ay, 1, one)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)

        eb = CAD_Topo.MakeEdge(vb, vb, circ_bot)
        em = CAD_Topo.MakeEdge(vm, vm, circ_mid)
        et = CAD_Topo.MakeEdge(vt, vt, circ_top)
        ArraySet(pt, 0, r)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, R)
        ArraySet(ax, 0, r)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, h)
        es = CAD_Topo.MakeEdge(vm, vt, CAD_Geom.MakeLine(pt, ax))
        ArraySet(frame, 0, rc)
        ArraySet(frame, 1, zro)
        ArraySet(frame, 2, R)
        ArraySet(frame, 3, zro)
        ArraySet(frame, 4, zro)
        ArraySet(frame, 5, neg1)
        ArraySet(frame, 6, one)
        ArraySet(frame, 7, zro)
        ArraySet(frame, 8, zro)
        circ_mer = CAD_Geom.MakeCircle(frame, R)
        ea = CAD_Topo.MakeEdge(vb, vm, circ_mer)

        cb_tor = CAD_Topo.MakeCoedge(eb, vb, 1)
        cb_bot = CAD_Topo.MakeCoedge(eb, vb, 0)
        CAD_Topo.LinkTwins(cb_tor, cb_bot)
        CAD_Store.Write(eb, 3, cb_tor)
        CAD_Store.Write(eb, 4, cb_bot)

        cm_cyl = CAD_Topo.MakeCoedge(em, vm, 1)
        cm_tor = CAD_Topo.MakeCoedge(em, vm, 0)
        CAD_Topo.LinkTwins(cm_cyl, cm_tor)
        CAD_Store.Write(em, 3, cm_cyl)
        CAD_Store.Write(em, 4, cm_tor)

        ct_top = CAD_Topo.MakeCoedge(et, vt, 1)
        ct_cyl = CAD_Topo.MakeCoedge(et, vt, 0)
        CAD_Topo.LinkTwins(ct_top, ct_cyl)
        CAD_Store.Write(et, 3, ct_top)
        CAD_Store.Write(et, 4, ct_cyl)

        cs_up = CAD_Topo.MakeCoedge(es, vm, 1)
        cs_dn = CAD_Topo.MakeCoedge(es, vt, 0)
        CAD_Topo.LinkTwins(cs_up, cs_dn)
        CAD_Store.Write(es, 3, cs_up)
        CAD_Store.Write(es, 4, cs_dn)

        ca_up = CAD_Topo.MakeCoedge(ea, vb, 1)
        ca_dn = CAD_Topo.MakeCoedge(ea, vm, 0)
        CAD_Topo.LinkTwins(ca_up, ca_dn)
        CAD_Store.Write(ea, 3, ca_up)
        CAD_Store.Write(ea, 4, ca_dn)

        lp_bot = CAD_Topo.MakeLoop(cb_bot)
        CAD_Store.Write(cb_bot, 2, cb_bot)
        CAD_Store.Write(cb_bot, 3, cb_bot)
        CAD_Store.Write(cb_bot, 4, lp_bot)
        CAD_Store.Write(lp_bot, 0, cb_bot)
        f_bot = CAD_Topo.MakeFace(pl_bot, lp_bot)

        lp_top = CAD_Topo.MakeLoop(ct_top)
        CAD_Store.Write(ct_top, 2, ct_top)
        CAD_Store.Write(ct_top, 3, ct_top)
        CAD_Store.Write(ct_top, 4, lp_top)
        CAD_Store.Write(lp_top, 0, ct_top)
        f_top = CAD_Topo.MakeFace(pl_top, lp_top)

        lp_tor = CAD_Topo.MakeLoop(cb_tor)
        ArraySet(ring, 0, cb_tor)
        ArraySet(ring, 1, ca_up)
        ArraySet(ring, 2, cm_tor)
        ArraySet(ring, 3, ca_dn)
        CAD_Topo.LinkLoopRing(ring, 4, lp_tor)
        f_tor = CAD_Topo.MakeFace(tor_s, lp_tor)

        lp_cyl = CAD_Topo.MakeLoop(cm_cyl)
        ArraySet(ring, 0, cm_cyl)
        ArraySet(ring, 1, cs_up)
        ArraySet(ring, 2, ct_cyl)
        ArraySet(ring, 3, cs_dn)
        CAD_Topo.LinkLoopRing(ring, 4, lp_cyl)
        f_cyl = CAD_Topo.MakeFace(cyl_s, lp_cyl)

        CAD_Store.Write(f_bot, 3, f_tor)
        CAD_Store.Write(f_tor, 3, f_cyl)
        CAD_Store.Write(f_cyl, 3, f_top)
        CAD_Store.Write(f_top, 3, 0)
        CAD_Store.Write(f_bot, 4, circ_bot)
        CAD_Store.Write(f_top, 4, circ_top)

        h_sh = CAD_Topo.MakeShell(f_bot)
        CAD_Store.Write(f_tor, 2, h_sh)
        CAD_Store.Write(f_cyl, 2, h_sh)
        CAD_Store.Write(f_top, 2, h_sh)
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)

        Deallocate(pt, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(frame, 128)
        Deallocate(ring, 64)
        ReturnValue(h_so)
    }
}

// Quarter-torus weld at a boss base: circle r at z=z0, fillet R.
// Closed RZ: (r,z0) → (r,z0+R) → arc → (r+R,z0) → back. Lathe about +Z.
Function.CAD_Topo.MakeBossBaseFilletRing {
    Input: radius_r: Integer
    Input: z0_r: Integer
    Input: fillet_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(fillet_r, 0), 1) ThenBlock: { ReturnValue(0) }
        R = fillet_r
        r = radius_r
        z0 = z0_r
        n_arc = 8
        np = Add(n_arc, 2)
        rz = Allocate(512)
        ArraySet(rz, 0, r)
        ArraySet(rz, 1, z0)
        ArraySet(rz, 2, r)
        ArraySet(rz, 3, Float_Add(z0, R))
        rc = Float_Add(r, R)
        zc = Float_Add(z0, R)
        pi = 0x400921FB54442D18
        half_pi = 0x3FF921FB54442D18
        k = 1
        WhileLoop LessThan(k, n_arc) {
            t = Float_Div(Float_FromInt(k), Float_FromInt(n_arc))
            ang = Float_Add(pi, Float_Mul(half_pi, t))
            c = CAD_Geom.Cos(ang)
            s = CAD_Geom.Sin(ang)
            idx = Add(k, 1)
            ArraySet(rz, Multiply(idx, 2), Float_Add(rc, Float_Mul(R, c)))
            ArraySet(rz, Add(Multiply(idx, 2), 1), Float_Add(zc, Float_Mul(R, s)))
            k = Add(k, 1)
        }
        last = Add(n_arc, 1)
        ArraySet(rz, Multiply(last, 2), Float_Add(r, R))
        ArraySet(rz, Add(Multiply(last, 2), 1), z0)
        out = Allocate(16)
        hs = CAD_Topo.MakeLatheRevolution(rz, np, out)
        Deallocate(rz, 512)
        Deallocate(out, 16)
        IfCondition EqualTo(hs, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(out_solid_addr, 0, hs)
        ReturnValue(hs)
    }
}

// Closed-profile lathe: revolve closed RZ polygon about +Z (no disk caps). Kind 0.
// rz_addr [rho,z]*n_prof, n_prof 3..512, n_ang 8..64. Last connects to first.
// Budget: np*na <= 4096 (verts/edges/faces slabs).
