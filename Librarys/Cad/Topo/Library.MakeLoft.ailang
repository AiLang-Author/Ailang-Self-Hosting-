// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

FixedPool.CAD_Topo_Loft {
    "ox": Initialize=0, CanChange=True
    "oy": Initialize=0, CanChange=True
    "oz": Initialize=0, CanChange=True
    "xx": Initialize=0, CanChange=True
    "xy": Initialize=0, CanChange=True
    "xz": Initialize=0, CanChange=True
    "yx": Initialize=0, CanChange=True
    "yy": Initialize=0, CanChange=True
    "yz": Initialize=0, CanChange=True
}

// Newell of xyz triples, then a plane frame.
// sign +1: normal follows the ring. sign -1: opposite.
// origin, ax, ay are 3-word buffers. Returns 0 if the ring has no area.
Function.CAD_Topo.LoftFrame {
    Input: xyz: Address
    Input: n: Integer
    Input: sign: Integer
    Output: Integer
    Body: {
        sc = Allocate(128)
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(sc, 0, xyz)
        ArraySet(sc, 1, n)
        ArraySet(sc, 2, sign)
        ArraySet(sc, 6, 0)
        ArraySet(sc, 7, 0)
        ArraySet(sc, 8, 0)
        ArraySet(sc, 9, 0)
        WhileLoop LessThan(ArrayGet(sc, 6), ArrayGet(sc, 1)) {
            i = ArrayGet(sc, 6)
            j = Add(i, 1)
            IfCondition EqualTo(j, ArrayGet(sc, 1)) ThenBlock: { j = 0 }
            xyz = ArrayGet(sc, 0)
            x0 = ArrayGet(xyz, Multiply(i, 3))
            y0 = ArrayGet(xyz, Add(Multiply(i, 3), 1))
            z0 = ArrayGet(xyz, Add(Multiply(i, 3), 2))
            x1 = ArrayGet(xyz, Multiply(j, 3))
            y1 = ArrayGet(xyz, Add(Multiply(j, 3), 1))
            z1 = ArrayGet(xyz, Add(Multiply(j, 3), 2))
            ArraySet(sc, 7, Float_Add(ArrayGet(sc, 7), Float_Mul(Float_Sub(y0, y1), Float_Add(z0, z1))))
            ArraySet(sc, 8, Float_Add(ArrayGet(sc, 8), Float_Mul(Float_Sub(z0, z1), Float_Add(x0, x1))))
            ArraySet(sc, 9, Float_Add(ArrayGet(sc, 9), Float_Mul(Float_Sub(x0, x1), Float_Add(y0, y1))))
            ArraySet(sc, 6, Add(i, 1))
        }
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(sc, 7), ArrayGet(sc, 7)), Float_Mul(ArrayGet(sc, 8), ArrayGet(sc, 8))), Float_Mul(ArrayGet(sc, 9), ArrayGet(sc, 9))))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: {
            Deallocate(sc, 128)
            ReturnValue(0)
        }
        ArraySet(sc, 7, Float_Div(ArrayGet(sc, 7), ln))
        ArraySet(sc, 8, Float_Div(ArrayGet(sc, 8), ln))
        ArraySet(sc, 9, Float_Div(ArrayGet(sc, 9), ln))
        ArraySet(sc, 7, Float_Mul(ArrayGet(sc, 7), ArrayGet(sc, 2)))
        ArraySet(sc, 8, Float_Mul(ArrayGet(sc, 8), ArrayGet(sc, 2)))
        ArraySet(sc, 9, Float_Mul(ArrayGet(sc, 9), ArrayGet(sc, 2)))
        xyz = ArrayGet(sc, 0)
        x0 = ArrayGet(xyz, 0)
        y0 = ArrayGet(xyz, 1)
        z0 = ArrayGet(xyz, 2)
        x1 = ArrayGet(xyz, 3)
        y1 = ArrayGet(xyz, 4)
        z1 = ArrayGet(xyz, 5)
        ArraySet(sc, 10, Float_Sub(x1, x0))
        ArraySet(sc, 11, Float_Sub(y1, y0))
        ArraySet(sc, 12, Float_Sub(z1, z0))
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(sc, 10), ArrayGet(sc, 10)), Float_Mul(ArrayGet(sc, 11), ArrayGet(sc, 11))), Float_Mul(ArrayGet(sc, 12), ArrayGet(sc, 12))))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: {
            Deallocate(sc, 128)
            ReturnValue(0)
        }
        ArraySet(sc, 10, Float_Div(ArrayGet(sc, 10), ln))
        ArraySet(sc, 11, Float_Div(ArrayGet(sc, 11), ln))
        ArraySet(sc, 12, Float_Div(ArrayGet(sc, 12), ln))
        // ay = outward × ax
        ox = ArrayGet(sc, 7)
        oy = ArrayGet(sc, 8)
        oz = ArrayGet(sc, 9)
        ax0 = ArrayGet(sc, 10)
        ay0 = ArrayGet(sc, 11)
        az0 = ArrayGet(sc, 12)
        ArraySet(sc, 13, Float_Sub(Float_Mul(oy, az0), Float_Mul(oz, ay0)))
        ArraySet(sc, 3, Float_Sub(Float_Mul(oz, ax0), Float_Mul(ox, az0)))
        ArraySet(sc, 4, Float_Sub(Float_Mul(ox, ay0), Float_Mul(oy, ax0)))
        ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(sc, 13), ArrayGet(sc, 13)), Float_Mul(ArrayGet(sc, 3), ArrayGet(sc, 3))), Float_Mul(ArrayGet(sc, 4), ArrayGet(sc, 4))))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: {
            Deallocate(sc, 128)
            ReturnValue(0)
        }
        // Origin is control 0. x0/y0/z0 do not survive the square root.
        xyz = ArrayGet(sc, 0)
        CAD_Topo_Loft.ox = ArrayGet(xyz, 0)
        xyz = ArrayGet(sc, 0)
        CAD_Topo_Loft.oy = ArrayGet(xyz, 1)
        xyz = ArrayGet(sc, 0)
        CAD_Topo_Loft.oz = ArrayGet(xyz, 2)
        CAD_Topo_Loft.xx = ArrayGet(sc, 10)
        CAD_Topo_Loft.xy = ArrayGet(sc, 11)
        CAD_Topo_Loft.xz = ArrayGet(sc, 12)
        CAD_Topo_Loft.yx = Float_Div(ArrayGet(sc, 13), ln)
        CAD_Topo_Loft.yy = Float_Div(ArrayGet(sc, 3), ln)
        CAD_Topo_Loft.yz = Float_Div(ArrayGet(sc, 4), ln)
        Deallocate(sc, 128)
        ReturnValue(1)
    }
}

// Ruled solid. xyz_bot and xyz_top are n triples. Caps use the ring normals.
// Returns a kind-0 solid, or 0.
Function.CAD_Topo.MakeRuledSolidXYZ {
    Input: xyz_bot: Address
    Input: xyz_top: Address
    Input: n_pts: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n_pts, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_pts, 60) ThenBlock: { ReturnValue(0) }
        n0 = n_pts
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(512)
        vb = Allocate(512)
        vt = Allocate(512)
        eb = Allocate(512)
        et = Allocate(512)
        ev = Allocate(512)
        i = 0
        WhileLoop LessThan(i, n0) {
            ArraySet(pt, 0, ArrayGet(xyz_bot, Multiply(i, 3)))
            ArraySet(pt, 1, ArrayGet(xyz_bot, Add(Multiply(i, 3), 1)))
            ArraySet(pt, 2, ArrayGet(xyz_bot, Add(Multiply(i, 3), 2)))
            ArraySet(vb, i, CAD_Topo.MakeVertex(pt))
            ArraySet(pt, 0, ArrayGet(xyz_top, Multiply(i, 3)))
            ArraySet(pt, 1, ArrayGet(xyz_top, Add(Multiply(i, 3), 1)))
            ArraySet(pt, 2, ArrayGet(xyz_top, Add(Multiply(i, 3), 2)))
            ArraySet(vt, i, CAD_Topo.MakeVertex(pt))
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, n0) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            va = ArrayGet(vb, i)
            vb2 = ArrayGet(vb, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, CAD_Store.Read(va, 2))
            ArraySet(p1b, 0, CAD_Store.Read(vb2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(vb2, 1))
            ArraySet(p1b, 2, CAD_Store.Read(vb2, 2))
            ArraySet(eb, i, CAD_Topo.MakeEdge(va, vb2, CAD_Geom.MakeLine(pt, p1b)))
            ta = ArrayGet(vt, i)
            tb = ArrayGet(vt, j)
            ArraySet(pt, 0, CAD_Store.Read(ta, 0))
            ArraySet(pt, 1, CAD_Store.Read(ta, 1))
            ArraySet(pt, 2, CAD_Store.Read(ta, 2))
            ArraySet(p1b, 0, CAD_Store.Read(tb, 0))
            ArraySet(p1b, 1, CAD_Store.Read(tb, 1))
            ArraySet(p1b, 2, CAD_Store.Read(tb, 2))
            ArraySet(et, i, CAD_Topo.MakeEdge(ta, tb, CAD_Geom.MakeLine(pt, p1b)))
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, CAD_Store.Read(va, 2))
            ArraySet(p1b, 0, CAD_Store.Read(ta, 0))
            ArraySet(p1b, 1, CAD_Store.Read(ta, 1))
            ArraySet(p1b, 2, CAD_Store.Read(ta, 2))
            ArraySet(ev, i, CAD_Topo.MakeEdge(va, ta, CAD_Geom.MakeLine(pt, p1b)))
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, n0) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            e = ArrayGet(eb, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, j), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            e = ArrayGet(et, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, j), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            e = ArrayGet(ev, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, i), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, n0) {
            k = Subtract(n0, Add(i, 1))
            e = ArrayGet(eb, k)
            ArraySet(ring, i, CAD_Store.Read(e, 4))
            i = Add(i, 1)
        }
        // Bottom cap faces away from the top. sign -1.
        IfCondition EqualTo(CAD_Topo.LoftFrame(xyz_bot, n0, 0xBFF0000000000000), 0) ThenBlock: {
            Deallocate(pt, 32)
            Deallocate(p1b, 32)
            Deallocate(ax, 32)
            Deallocate(ay, 32)
            Deallocate(ring, 512)
            Deallocate(vb, 512)
            Deallocate(vt, 512)
            Deallocate(eb, 512)
            Deallocate(et, 512)
            Deallocate(ev, 512)
            ReturnValue(0)
        }
        ArraySet(pt, 0, CAD_Topo_Loft.ox)
        ArraySet(pt, 1, CAD_Topo_Loft.oy)
        ArraySet(pt, 2, CAD_Topo_Loft.oz)
        ArraySet(ax, 0, CAD_Topo_Loft.xx)
        ArraySet(ax, 1, CAD_Topo_Loft.xy)
        ArraySet(ax, 2, CAD_Topo_Loft.xz)
        ArraySet(ay, 0, CAD_Topo_Loft.yx)
        ArraySet(ay, 1, CAD_Topo_Loft.yy)
        ArraySet(ay, 2, CAD_Topo_Loft.yz)
        sbot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        lbot = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n0, lbot)
        fbot = CAD_Topo.MakeFace(sbot, lbot)
        i = 0
        WhileLoop LessThan(i, n0) {
            e = ArrayGet(et, i)
            ArraySet(ring, i, CAD_Store.Read(e, 3))
            i = Add(i, 1)
        }
        IfCondition EqualTo(CAD_Topo.LoftFrame(xyz_top, n0, 0x3FF0000000000000), 0) ThenBlock: {
            Deallocate(pt, 32)
            Deallocate(p1b, 32)
            Deallocate(ax, 32)
            Deallocate(ay, 32)
            Deallocate(ring, 512)
            Deallocate(vb, 512)
            Deallocate(vt, 512)
            Deallocate(eb, 512)
            Deallocate(et, 512)
            Deallocate(ev, 512)
            ReturnValue(0)
        }
        ArraySet(pt, 0, CAD_Topo_Loft.ox)
        ArraySet(pt, 1, CAD_Topo_Loft.oy)
        ArraySet(pt, 2, CAD_Topo_Loft.oz)
        ArraySet(ax, 0, CAD_Topo_Loft.xx)
        ArraySet(ax, 1, CAD_Topo_Loft.xy)
        ArraySet(ax, 2, CAD_Topo_Loft.xz)
        ArraySet(ay, 0, CAD_Topo_Loft.yx)
        ArraySet(ay, 1, CAD_Topo_Loft.yy)
        ArraySet(ay, 2, CAD_Topo_Loft.yz)
        stop = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ltop = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n0, ltop)
        ftop = CAD_Topo.MakeFace(stop, ltop)
        faces = Allocate(512)
        ArraySet(faces, 0, fbot)
        ArraySet(faces, 1, ftop)
        nf = 2
        i = 0
        WhileLoop LessThan(i, n0) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            ArraySet(ring, 0, CAD_Store.Read(ArrayGet(eb, i), 3))
            ArraySet(ring, 1, CAD_Store.Read(ArrayGet(ev, j), 3))
            ArraySet(ring, 2, CAD_Store.Read(ArrayGet(et, i), 4))
            ArraySet(ring, 3, CAD_Store.Read(ArrayGet(ev, i), 4))
            va = ArrayGet(vb, i)
            vb2 = ArrayGet(vb, j)
            ta = ArrayGet(vt, i)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, CAD_Store.Read(va, 2))
            ArraySet(ax, 0, Float_Sub(CAD_Store.Read(vb2, 0), CAD_Store.Read(va, 0)))
            ArraySet(ax, 1, Float_Sub(CAD_Store.Read(vb2, 1), CAD_Store.Read(va, 1)))
            ArraySet(ax, 2, Float_Sub(CAD_Store.Read(vb2, 2), CAD_Store.Read(va, 2)))
            ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))), Float_Mul(ArrayGet(ax, 2), ArrayGet(ax, 2))))
            // A collapsed profile edge has no direction. Use the other ring.
            IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 1) ThenBlock: {
                ta = ArrayGet(vt, i)
                vb2 = ArrayGet(vt, j)
                ArraySet(ax, 0, Float_Sub(CAD_Store.Read(vb2, 0), CAD_Store.Read(ta, 0)))
                ArraySet(ax, 1, Float_Sub(CAD_Store.Read(vb2, 1), CAD_Store.Read(ta, 1)))
                ArraySet(ax, 2, Float_Sub(CAD_Store.Read(vb2, 2), CAD_Store.Read(ta, 2)))
                ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))), Float_Mul(ArrayGet(ax, 2), ArrayGet(ax, 2))))
            }
            IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
                ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), ln))
                ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), ln))
                ArraySet(ax, 2, Float_Div(ArrayGet(ax, 2), ln))
            }
            ArraySet(ay, 0, Float_Sub(CAD_Store.Read(ta, 0), CAD_Store.Read(va, 0)))
            ArraySet(ay, 1, Float_Sub(CAD_Store.Read(ta, 1), CAD_Store.Read(va, 1)))
            ArraySet(ay, 2, Float_Sub(CAD_Store.Read(ta, 2), CAD_Store.Read(va, 2)))
            dot = Float_Add(Float_Add(Float_Mul(ArrayGet(ay, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ay, 1), ArrayGet(ax, 1))), Float_Mul(ArrayGet(ay, 2), ArrayGet(ax, 2)))
            ArraySet(ay, 0, Float_Sub(ArrayGet(ay, 0), Float_Mul(dot, ArrayGet(ax, 0))))
            ArraySet(ay, 1, Float_Sub(ArrayGet(ay, 1), Float_Mul(dot, ArrayGet(ax, 1))))
            ArraySet(ay, 2, Float_Sub(ArrayGet(ay, 2), Float_Mul(dot, ArrayGet(ax, 2))))
            ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(ay, 0), ArrayGet(ay, 0)), Float_Mul(ArrayGet(ay, 1), ArrayGet(ay, 1))), Float_Mul(ArrayGet(ay, 2), ArrayGet(ay, 2))))
            IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
                ArraySet(ay, 0, Float_Div(ArrayGet(ay, 0), ln))
                ArraySet(ay, 1, Float_Div(ArrayGet(ay, 1), ln))
                ArraySet(ay, 2, Float_Div(ArrayGet(ay, 2), ln))
            }
            sside = CAD_Geom.MakePlaneAxes(pt, ax, ay)
            ls = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
            CAD_Topo.LinkLoopRing(ring, 4, ls)
            fs = CAD_Topo.MakeFace(sside, ls)
            ArraySet(faces, nf, fs)
            nf = Add(nf, 1)
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, Subtract(nf, 1)) {
            CAD_Store.Write(ArrayGet(faces, i), 3, ArrayGet(faces, Add(i, 1)))
            i = Add(i, 1)
        }
        CAD_Store.Write(ArrayGet(faces, Subtract(nf, 1)), 3, 0)
        h_sh = CAD_Topo.MakeShell(ArrayGet(faces, 0))
        i = 1
        WhileLoop LessThan(i, nf) {
            CAD_Store.Write(ArrayGet(faces, i), 2, h_sh)
            i = Add(i, 1)
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 512)
        Deallocate(vb, 512)
        Deallocate(vt, 512)
        Deallocate(eb, 512)
        Deallocate(et, 512)
        Deallocate(ev, 512)
        Deallocate(faces, 512)
        ReturnValue(h_so)
    }
}
