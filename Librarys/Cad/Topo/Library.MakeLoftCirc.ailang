// Ruled loft when a section is one sketch circle.
// The circle stays a circle: center, plane axes, radius. The other
// profile keeps its corners. Each corner meets the circle along the
// ray from that center. Display samples the arc. The stored edge does not.
// Two circles split into four quadrants of each circle.
// A polygon loft does not come here.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

FixedPool.CAD_Topo_LCirc {
    "bin": Initialize=0, CanChange=True
    "tin": Initialize=0, CanChange=True
    "n": Initialize=0, CanChange=True
    "desc": Initialize=0, CanChange=True
    "out": Initialize=0, CanChange=True
    "bot": Initialize=0, CanChange=True
    "top": Initialize=0, CanChange=True
    "botc": Initialize=0, CanChange=True
    "topc": Initialize=0, CanChange=True
    "pt": Initialize=0, CanChange=True
    "p1": Initialize=0, CanChange=True
    "axb": Initialize=0, CanChange=True
    "ayb": Initialize=0, CanChange=True
    "frame": Initialize=0, CanChange=True
    "vb": Initialize=0, CanChange=True
    "vt": Initialize=0, CanChange=True
    "eb": Initialize=0, CanChange=True
    "et": Initialize=0, CanChange=True
    "ev": Initialize=0, CanChange=True
    "ring": Initialize=0, CanChange=True
    "faces": Initialize=0, CanChange=True
    "angs": Initialize=0, CanChange=True
    "i": Initialize=0, CanChange=True
    "j": Initialize=0, CanChange=True
    "k": Initialize=0, CanChange=True
    "nf": Initialize=0, CanChange=True
    "h": Initialize=0, CanChange=True
    "e": Initialize=0, CanChange=True
    "va": Initialize=0, CanChange=True
    "vb2": Initialize=0, CanChange=True
    "c0": Initialize=0, CanChange=True
    "c1": Initialize=0, CanChange=True
    "cx": Initialize=0, CanChange=True
    "cy": Initialize=0, CanChange=True
    "cz": Initialize=0, CanChange=True
    "xx": Initialize=0, CanChange=True
    "xy": Initialize=0, CanChange=True
    "xz": Initialize=0, CanChange=True
    "yx": Initialize=0, CanChange=True
    "yy": Initialize=0, CanChange=True
    "yz": Initialize=0, CanChange=True
    "rad": Initialize=0, CanChange=True
    "u": Initialize=0, CanChange=True
    "v": Initialize=0, CanChange=True
    "ang": Initialize=0, CanChange=True
    "span": Initialize=0, CanChange=True
    "cs": Initialize=0, CanChange=True
    "sn": Initialize=0, CanChange=True
    "x0": Initialize=0, CanChange=True
    "y0": Initialize=0, CanChange=True
    "z0": Initialize=0, CanChange=True
    "x1": Initialize=0, CanChange=True
    "y1": Initialize=0, CanChange=True
    "z1": Initialize=0, CanChange=True
    "ln": Initialize=0, CanChange=True
    "dot": Initialize=0, CanChange=True
    "nx": Initialize=0, CanChange=True
    "ny": Initialize=0, CanChange=True
    "nz": Initialize=0, CanChange=True
    "sx": Initialize=0, CanChange=True
    "sy": Initialize=0, CanChange=True
    "sz": Initialize=0, CanChange=True
    "which": Initialize=0, CanChange=True
    "base": Initialize=0, CanChange=True
    "shift": Initialize=0, CanChange=True
    "pos": Initialize=0, CanChange=True
    "neg": Initialize=0, CanChange=True
    "sum": Initialize=0, CanChange=True
    "src": Initialize=0, CanChange=True
    "dst": Initialize=0, CanChange=True
    "net": Initialize=0, CanChange=True
    "wbuf": Initialize=0, CanChange=True
}

Function.CAD_Topo.LoftCircDrop {
    Output: Integer
    Body: {
        IfCondition NotEqual(CAD_Topo_LCirc.bot, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.bot, 2048) }
        IfCondition NotEqual(CAD_Topo_LCirc.top, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.top, 2048) }
        IfCondition NotEqual(CAD_Topo_LCirc.pt, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.pt, 32) }
        IfCondition NotEqual(CAD_Topo_LCirc.p1, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.p1, 32) }
        IfCondition NotEqual(CAD_Topo_LCirc.axb, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.axb, 32) }
        IfCondition NotEqual(CAD_Topo_LCirc.ayb, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.ayb, 32) }
        IfCondition NotEqual(CAD_Topo_LCirc.frame, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.frame, 128) }
        IfCondition NotEqual(CAD_Topo_LCirc.vb, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.vb, 512) }
        IfCondition NotEqual(CAD_Topo_LCirc.vt, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.vt, 512) }
        IfCondition NotEqual(CAD_Topo_LCirc.eb, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.eb, 512) }
        IfCondition NotEqual(CAD_Topo_LCirc.et, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.et, 512) }
        IfCondition NotEqual(CAD_Topo_LCirc.ev, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.ev, 512) }
        IfCondition NotEqual(CAD_Topo_LCirc.ring, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.ring, 512) }
        IfCondition NotEqual(CAD_Topo_LCirc.faces, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.faces, 512) }
        IfCondition NotEqual(CAD_Topo_LCirc.angs, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.angs, 1024) }
        IfCondition NotEqual(CAD_Topo_LCirc.net, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.net, 256) }
        IfCondition NotEqual(CAD_Topo_LCirc.wbuf, 0) ThenBlock: { Deallocate(CAD_Topo_LCirc.wbuf, 64) }
        CAD_Topo_LCirc.bot = 0
        CAD_Topo_LCirc.top = 0
        CAD_Topo_LCirc.pt = 0
        CAD_Topo_LCirc.p1 = 0
        CAD_Topo_LCirc.axb = 0
        CAD_Topo_LCirc.ayb = 0
        CAD_Topo_LCirc.frame = 0
        CAD_Topo_LCirc.vb = 0
        CAD_Topo_LCirc.vt = 0
        CAD_Topo_LCirc.eb = 0
        CAD_Topo_LCirc.et = 0
        CAD_Topo_LCirc.ev = 0
        CAD_Topo_LCirc.ring = 0
        CAD_Topo_LCirc.faces = 0
        CAD_Topo_LCirc.angs = 0
        CAD_Topo_LCirc.net = 0
        CAD_Topo_LCirc.wbuf = 0
        ReturnValue(0)
    }
}

// Load circle which (0 bottom, 1 top) into cx..rad.
Function.CAD_Topo.LoftCircFrame {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.base = 4
        CAD_Topo_LCirc.k = 2
        IfCondition EqualTo(CAD_Topo_LCirc.which, 1) ThenBlock: {
            CAD_Topo_LCirc.base = 13
            CAD_Topo_LCirc.k = 3
        }
        CAD_Topo_LCirc.rad = ArrayGet(CAD_Topo_LCirc.desc, CAD_Topo_LCirc.k)
        CAD_Topo_LCirc.cx = ArrayGet(CAD_Topo_LCirc.desc, CAD_Topo_LCirc.base)
        CAD_Topo_LCirc.base = Add(CAD_Topo_LCirc.base, 1)
        CAD_Topo_LCirc.cy = ArrayGet(CAD_Topo_LCirc.desc, CAD_Topo_LCirc.base)
        CAD_Topo_LCirc.base = Add(CAD_Topo_LCirc.base, 1)
        CAD_Topo_LCirc.cz = ArrayGet(CAD_Topo_LCirc.desc, CAD_Topo_LCirc.base)
        CAD_Topo_LCirc.base = Add(CAD_Topo_LCirc.base, 1)
        CAD_Topo_LCirc.xx = ArrayGet(CAD_Topo_LCirc.desc, CAD_Topo_LCirc.base)
        CAD_Topo_LCirc.base = Add(CAD_Topo_LCirc.base, 1)
        CAD_Topo_LCirc.xy = ArrayGet(CAD_Topo_LCirc.desc, CAD_Topo_LCirc.base)
        CAD_Topo_LCirc.base = Add(CAD_Topo_LCirc.base, 1)
        CAD_Topo_LCirc.xz = ArrayGet(CAD_Topo_LCirc.desc, CAD_Topo_LCirc.base)
        CAD_Topo_LCirc.base = Add(CAD_Topo_LCirc.base, 1)
        CAD_Topo_LCirc.yx = ArrayGet(CAD_Topo_LCirc.desc, CAD_Topo_LCirc.base)
        CAD_Topo_LCirc.base = Add(CAD_Topo_LCirc.base, 1)
        CAD_Topo_LCirc.yy = ArrayGet(CAD_Topo_LCirc.desc, CAD_Topo_LCirc.base)
        CAD_Topo_LCirc.base = Add(CAD_Topo_LCirc.base, 1)
        CAD_Topo_LCirc.yz = ArrayGet(CAD_Topo_LCirc.desc, CAD_Topo_LCirc.base)
        ReturnValue(0)
    }
}

// Point at pool.ang on the loaded circle, written to pool.dst at pool.i.
Function.CAD_Topo.LoftCircPut {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.cs = CAD_Geom.Cos(CAD_Topo_LCirc.ang)
        CAD_Topo_LCirc.sn = CAD_Geom.Sin(CAD_Topo_LCirc.ang)
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.rad, CAD_Topo_LCirc.cs)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.xx)
        CAD_Topo_LCirc.x0 = Float_Add(CAD_Topo_LCirc.cx, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.rad, CAD_Topo_LCirc.sn)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.yx)
        CAD_Topo_LCirc.x0 = Float_Add(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.rad, CAD_Topo_LCirc.cs)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.xy)
        CAD_Topo_LCirc.y0 = Float_Add(CAD_Topo_LCirc.cy, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.rad, CAD_Topo_LCirc.sn)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.yy)
        CAD_Topo_LCirc.y0 = Float_Add(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.rad, CAD_Topo_LCirc.cs)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.xz)
        CAD_Topo_LCirc.z0 = Float_Add(CAD_Topo_LCirc.cz, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.rad, CAD_Topo_LCirc.sn)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.yz)
        CAD_Topo_LCirc.z0 = Float_Add(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.k = Multiply(CAD_Topo_LCirc.i, 3)
        ArraySet(CAD_Topo_LCirc.dst, CAD_Topo_LCirc.k, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
        ArraySet(CAD_Topo_LCirc.dst, CAD_Topo_LCirc.k, CAD_Topo_LCirc.y0)
        CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
        ArraySet(CAD_Topo_LCirc.dst, CAD_Topo_LCirc.k, CAD_Topo_LCirc.z0)
        ReturnValue(0)
    }
}

// Four quadrant points on circle which.
Function.CAD_Topo.LoftCircQuad {
    Output: Integer
    Body: {
        CAD_Topo.LoftCircFrame()
        IfCondition EqualTo(CAD_Topo_LCirc.which, 0) ThenBlock: { CAD_Topo_LCirc.dst = CAD_Topo_LCirc.bot }
        IfCondition EqualTo(CAD_Topo_LCirc.which, 1) ThenBlock: { CAD_Topo_LCirc.dst = CAD_Topo_LCirc.top }
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, 4) {
            CAD_Topo_LCirc.ang = Float_FromInt(CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.ang = Float_Mul(CAD_Topo_LCirc.ang, 0x3FF921FB54442D18)
            CAD_Topo.LoftCircPut()
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        ReturnValue(0)
    }
}

// Load work point pool.src[pool.i] into x0,y0,z0.
Function.CAD_Topo.LoftCircAt {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.k = Multiply(CAD_Topo_LCirc.i, 3)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.src, CAD_Topo_LCirc.k)
        CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.src, CAD_Topo_LCirc.k)
        CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
        CAD_Topo_LCirc.z0 = ArrayGet(CAD_Topo_LCirc.src, CAD_Topo_LCirc.k)
        ReturnValue(0)
    }
}

// Circle which takes one point per corner of the other ring.
Function.CAD_Topo.LoftCircProject {
    Output: Integer
    Body: {
        CAD_Topo.LoftCircFrame()
        IfCondition EqualTo(CAD_Topo_LCirc.which, 0) ThenBlock: {
            CAD_Topo_LCirc.dst = CAD_Topo_LCirc.bot
            CAD_Topo_LCirc.src = CAD_Topo_LCirc.top
        }
        IfCondition EqualTo(CAD_Topo_LCirc.which, 1) ThenBlock: {
            CAD_Topo_LCirc.dst = CAD_Topo_LCirc.top
            CAD_Topo_LCirc.src = CAD_Topo_LCirc.bot
        }
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.n) {
            CAD_Topo.LoftCircAt()
            CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.cx)
            CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.xx)
            CAD_Topo_LCirc.dot = CAD_Topo_LCirc.v
            CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.cy)
            CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.xy)
            CAD_Topo_LCirc.dot = Float_Add(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.cz)
            CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.xz)
            CAD_Topo_LCirc.u = Float_Add(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.dot = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.cx)
            CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.yx)
            CAD_Topo_LCirc.ln = CAD_Topo_LCirc.v
            CAD_Topo_LCirc.dot = Float_Sub(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.cy)
            CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.yy)
            CAD_Topo_LCirc.ln = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.dot = Float_Sub(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.cz)
            CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.yz)
            CAD_Topo_LCirc.v = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.ang = 0
            CAD_Topo_LCirc.k = CAD_Num.IsZero(CAD_Topo_LCirc.u, 0)
            CAD_Topo_LCirc.shift = CAD_Num.IsZero(CAD_Topo_LCirc.v, 0)
            IfCondition EqualTo(CAD_Topo_LCirc.k, 0) ThenBlock: {
                CAD_Topo_LCirc.ang = CAD_Geom.Atan2(CAD_Topo_LCirc.v, CAD_Topo_LCirc.u)
            }
            IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_LCirc.shift, 0) ThenBlock: {
                    CAD_Topo_LCirc.ang = CAD_Geom.Atan2(CAD_Topo_LCirc.v, CAD_Topo_LCirc.u)
                }
            }
            CAD_Topo.LoftCircPut()
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        ReturnValue(0)
    }
}

// Copy pool.n points from pool.src to pool.dst.
Function.CAD_Topo.LoftCircCopy {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.k = Multiply(CAD_Topo_LCirc.n, 3)
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.k) {
            CAD_Topo_LCirc.ang = ArrayGet(CAD_Topo_LCirc.src, CAD_Topo_LCirc.i)
            ArraySet(CAD_Topo_LCirc.dst, CAD_Topo_LCirc.i, CAD_Topo_LCirc.ang)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        ReturnValue(0)
    }
}

// Rotate the top ring so point 0 is the closest top point to bottom 0.
Function.CAD_Topo.LoftCircAlign {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.src = CAD_Topo_LCirc.bot
        CAD_Topo_LCirc.i = 0
        CAD_Topo.LoftCircAt()
        CAD_Topo_LCirc.x1 = CAD_Topo_LCirc.x0
        CAD_Topo_LCirc.y1 = CAD_Topo_LCirc.y0
        CAD_Topo_LCirc.z1 = CAD_Topo_LCirc.z0
        CAD_Topo_LCirc.shift = 0
        CAD_Topo_LCirc.ln = 0
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, 4) {
            CAD_Topo_LCirc.src = CAD_Topo_LCirc.top
            CAD_Topo.LoftCircAt()
            CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.x1)
            CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.dot = CAD_Topo_LCirc.v
            CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.y1)
            CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.dot = Float_Add(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.z1)
            CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.dot = Float_Add(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.k = 0
            IfCondition EqualTo(CAD_Topo_LCirc.i, 0) ThenBlock: { CAD_Topo_LCirc.k = 1 }
            IfCondition EqualTo(Float_Le(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.ln), 1) ThenBlock: { CAD_Topo_LCirc.k = 1 }
            IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: {
                CAD_Topo_LCirc.ln = CAD_Topo_LCirc.dot
                CAD_Topo_LCirc.shift = CAD_Topo_LCirc.i
            }
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        IfCondition EqualTo(CAD_Topo_LCirc.shift, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, 4) {
            CAD_Topo_LCirc.src = CAD_Topo_LCirc.top
            CAD_Topo.LoftCircAt()
            CAD_Topo_LCirc.k = Multiply(CAD_Topo_LCirc.i, 3)
            ArraySet(CAD_Topo_LCirc.frame, CAD_Topo_LCirc.k, CAD_Topo_LCirc.x0)
            CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
            ArraySet(CAD_Topo_LCirc.frame, CAD_Topo_LCirc.k, CAD_Topo_LCirc.y0)
            CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
            ArraySet(CAD_Topo_LCirc.frame, CAD_Topo_LCirc.k, CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, 4) {
            CAD_Topo_LCirc.j = Add(CAD_Topo_LCirc.i, CAD_Topo_LCirc.shift)
            CAD_Topo_LCirc.j = Modulo(CAD_Topo_LCirc.j, 4)
            CAD_Topo_LCirc.k = Multiply(CAD_Topo_LCirc.j, 3)
            CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.frame, CAD_Topo_LCirc.k)
            CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
            CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.frame, CAD_Topo_LCirc.k)
            CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
            CAD_Topo_LCirc.z0 = ArrayGet(CAD_Topo_LCirc.frame, CAD_Topo_LCirc.k)
            CAD_Topo_LCirc.k = Multiply(CAD_Topo_LCirc.i, 3)
            ArraySet(CAD_Topo_LCirc.top, CAD_Topo_LCirc.k, CAD_Topo_LCirc.x0)
            CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
            ArraySet(CAD_Topo_LCirc.top, CAD_Topo_LCirc.k, CAD_Topo_LCirc.y0)
            CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
            ArraySet(CAD_Topo_LCirc.top, CAD_Topo_LCirc.k, CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        ReturnValue(0)
    }
}

// Reverse pool.src, pool.n points.
Function.CAD_Topo.LoftCircRev {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.i = 0
        CAD_Topo_LCirc.k = Divide(CAD_Topo_LCirc.n, 2)
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.k) {
            CAD_Topo_LCirc.j = Subtract(CAD_Topo_LCirc.n, 1)
            CAD_Topo_LCirc.j = Subtract(CAD_Topo_LCirc.j, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.base = Multiply(CAD_Topo_LCirc.i, 3)
            CAD_Topo_LCirc.shift = Multiply(CAD_Topo_LCirc.j, 3)
            CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.src, CAD_Topo_LCirc.base)
            CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.src, Add(CAD_Topo_LCirc.base, 1))
            CAD_Topo_LCirc.z0 = ArrayGet(CAD_Topo_LCirc.src, Add(CAD_Topo_LCirc.base, 2))
            CAD_Topo_LCirc.x1 = ArrayGet(CAD_Topo_LCirc.src, CAD_Topo_LCirc.shift)
            CAD_Topo_LCirc.y1 = ArrayGet(CAD_Topo_LCirc.src, Add(CAD_Topo_LCirc.shift, 1))
            CAD_Topo_LCirc.z1 = ArrayGet(CAD_Topo_LCirc.src, Add(CAD_Topo_LCirc.shift, 2))
            ArraySet(CAD_Topo_LCirc.src, CAD_Topo_LCirc.base, CAD_Topo_LCirc.x1)
            ArraySet(CAD_Topo_LCirc.src, Add(CAD_Topo_LCirc.base, 1), CAD_Topo_LCirc.y1)
            ArraySet(CAD_Topo_LCirc.src, Add(CAD_Topo_LCirc.base, 2), CAD_Topo_LCirc.z1)
            ArraySet(CAD_Topo_LCirc.src, CAD_Topo_LCirc.shift, CAD_Topo_LCirc.x0)
            ArraySet(CAD_Topo_LCirc.src, Add(CAD_Topo_LCirc.shift, 1), CAD_Topo_LCirc.y0)
            ArraySet(CAD_Topo_LCirc.src, Add(CAD_Topo_LCirc.shift, 2), CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        ReturnValue(0)
    }
}

// Same winding on both circles. Delta is top centroid minus bottom centroid.
Function.CAD_Topo.LoftCircWind {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.sx = 0
        CAD_Topo_LCirc.sy = 0
        CAD_Topo_LCirc.sz = 0
        CAD_Topo_LCirc.x1 = 0
        CAD_Topo_LCirc.y1 = 0
        CAD_Topo_LCirc.z1 = 0
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.n) {
            CAD_Topo_LCirc.src = CAD_Topo_LCirc.bot
            CAD_Topo.LoftCircAt()
            CAD_Topo_LCirc.sx = Float_Add(CAD_Topo_LCirc.sx, CAD_Topo_LCirc.x0)
            CAD_Topo_LCirc.sy = Float_Add(CAD_Topo_LCirc.sy, CAD_Topo_LCirc.y0)
            CAD_Topo_LCirc.sz = Float_Add(CAD_Topo_LCirc.sz, CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.src = CAD_Topo_LCirc.top
            CAD_Topo.LoftCircAt()
            CAD_Topo_LCirc.x1 = Float_Add(CAD_Topo_LCirc.x1, CAD_Topo_LCirc.x0)
            CAD_Topo_LCirc.y1 = Float_Add(CAD_Topo_LCirc.y1, CAD_Topo_LCirc.y0)
            CAD_Topo_LCirc.z1 = Float_Add(CAD_Topo_LCirc.z1, CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        CAD_Topo_LCirc.ln = Float_FromInt(CAD_Topo_LCirc.n)
        CAD_Topo_LCirc.sx = Float_Div(CAD_Topo_LCirc.sx, CAD_Topo_LCirc.ln)
        CAD_Topo_LCirc.sy = Float_Div(CAD_Topo_LCirc.sy, CAD_Topo_LCirc.ln)
        CAD_Topo_LCirc.sz = Float_Div(CAD_Topo_LCirc.sz, CAD_Topo_LCirc.ln)
        CAD_Topo_LCirc.x1 = Float_Div(CAD_Topo_LCirc.x1, CAD_Topo_LCirc.ln)
        CAD_Topo_LCirc.y1 = Float_Div(CAD_Topo_LCirc.y1, CAD_Topo_LCirc.ln)
        CAD_Topo_LCirc.z1 = Float_Div(CAD_Topo_LCirc.z1, CAD_Topo_LCirc.ln)
        CAD_Topo_LCirc.x1 = Float_Sub(CAD_Topo_LCirc.x1, CAD_Topo_LCirc.sx)
        CAD_Topo_LCirc.y1 = Float_Sub(CAD_Topo_LCirc.y1, CAD_Topo_LCirc.sy)
        CAD_Topo_LCirc.z1 = Float_Sub(CAD_Topo_LCirc.z1, CAD_Topo_LCirc.sz)
        CAD_Topo_LCirc.nx = 0
        CAD_Topo_LCirc.ny = 0
        CAD_Topo_LCirc.nz = 0
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.n) {
            CAD_Topo_LCirc.j = Add(CAD_Topo_LCirc.i, 1)
            IfCondition EqualTo(CAD_Topo_LCirc.j, CAD_Topo_LCirc.n) ThenBlock: { CAD_Topo_LCirc.j = 0 }
            CAD_Topo_LCirc.src = CAD_Topo_LCirc.top
            CAD_Topo.LoftCircAt()
            CAD_Topo_LCirc.sx = CAD_Topo_LCirc.x0
            CAD_Topo_LCirc.sy = CAD_Topo_LCirc.y0
            CAD_Topo_LCirc.sz = CAD_Topo_LCirc.z0
            CAD_Topo_LCirc.shift = CAD_Topo_LCirc.i
            CAD_Topo_LCirc.i = CAD_Topo_LCirc.j
            CAD_Topo.LoftCircAt()
            CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.sy, CAD_Topo_LCirc.y0)
            CAD_Topo_LCirc.v = Float_Add(CAD_Topo_LCirc.sz, CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.nx = Float_Add(CAD_Topo_LCirc.nx, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.sz, CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.v = Float_Add(CAD_Topo_LCirc.sx, CAD_Topo_LCirc.x0)
            CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.ny = Float_Add(CAD_Topo_LCirc.ny, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.sx, CAD_Topo_LCirc.x0)
            CAD_Topo_LCirc.v = Float_Add(CAD_Topo_LCirc.sy, CAD_Topo_LCirc.y0)
            CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.nz = Float_Add(CAD_Topo_LCirc.nz, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.i = CAD_Topo_LCirc.shift
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.nx, CAD_Topo_LCirc.x1)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.ny, CAD_Topo_LCirc.y1)
        CAD_Topo_LCirc.u = Float_Add(CAD_Topo_LCirc.u, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.nz, CAD_Topo_LCirc.z1)
        CAD_Topo_LCirc.dot = Float_Add(CAD_Topo_LCirc.u, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.k = CAD_Num.IsNeg(CAD_Topo_LCirc.dot)
        CAD_Topo_LCirc.shift = CAD_Num.IsZero(CAD_Topo_LCirc.dot, 0)
        IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_LCirc.shift, 0) ThenBlock: {
                CAD_Topo_LCirc.src = CAD_Topo_LCirc.top
                CAD_Topo.LoftCircRev()
            }
        }
        ReturnValue(0)
    }
}

// Angle of work point pool.i on the loaded circle, into angs[base+i].
Function.CAD_Topo.LoftCircAng {
    Output: Integer
    Body: {
        CAD_Topo.LoftCircAt()
        CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.cx)
        CAD_Topo_LCirc.dot = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.xx)
        CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.cy)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.xy)
        CAD_Topo_LCirc.dot = Float_Add(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.cz)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.xz)
        CAD_Topo_LCirc.u = Float_Add(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.dot = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.cx)
        CAD_Topo_LCirc.ln = Float_Mul(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.yx)
        CAD_Topo_LCirc.dot = Float_Sub(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.cy)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.yy)
        CAD_Topo_LCirc.ln = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.dot = Float_Sub(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.cz)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.yz)
        CAD_Topo_LCirc.v = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.ang = CAD_Geom.Atan2(CAD_Topo_LCirc.v, CAD_Topo_LCirc.u)
        CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.base, CAD_Topo_LCirc.i)
        ArraySet(CAD_Topo_LCirc.angs, CAD_Topo_LCirc.k, CAD_Topo_LCirc.ang)
        ReturnValue(0)
    }
}

// Wrap pool.span into (-pi, pi].
Function.CAD_Topo.LoftCircWrap {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.u = Float_Add(CAD_Topo_LCirc.span, 0x400921FB54442D18)
        CAD_Topo_LCirc.k = CAD_Num.IsNeg(CAD_Topo_LCirc.u)
        IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: {
            CAD_Topo_LCirc.span = Float_Add(CAD_Topo_LCirc.span, 0x401921FB54442D18)
        }
        CAD_Topo_LCirc.u = Float_Sub(0x400921FB54442D18, CAD_Topo_LCirc.span)
        CAD_Topo_LCirc.k = CAD_Num.IsNeg(CAD_Topo_LCirc.u)
        IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: {
            CAD_Topo_LCirc.span = Float_Sub(CAD_Topo_LCirc.span, 0x401921FB54442D18)
        }
        ReturnValue(0)
    }
}

// 1 when each circle's corner arcs are one turn, all the same way.
Function.CAD_Topo.LoftCircSpans {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.which = 0
        WhileLoop LessThan(CAD_Topo_LCirc.which, 2) {
            CAD_Topo_LCirc.k = CAD_Topo_LCirc.botc
            IfCondition EqualTo(CAD_Topo_LCirc.which, 1) ThenBlock: { CAD_Topo_LCirc.k = CAD_Topo_LCirc.topc }
            IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: {
                CAD_Topo.LoftCircFrame()
                CAD_Topo_LCirc.base = 0
                CAD_Topo_LCirc.src = CAD_Topo_LCirc.bot
                IfCondition EqualTo(CAD_Topo_LCirc.which, 1) ThenBlock: {
                    CAD_Topo_LCirc.base = 64
                    CAD_Topo_LCirc.src = CAD_Topo_LCirc.top
                }
                CAD_Topo_LCirc.i = 0
                WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.n) {
                    CAD_Topo.LoftCircAng()
                    CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
                }
                CAD_Topo_LCirc.sum = 0
                CAD_Topo_LCirc.pos = 0
                CAD_Topo_LCirc.neg = 0
                CAD_Topo_LCirc.i = 0
                WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.n) {
                    CAD_Topo_LCirc.j = Add(CAD_Topo_LCirc.i, 1)
                    IfCondition EqualTo(CAD_Topo_LCirc.j, CAD_Topo_LCirc.n) ThenBlock: { CAD_Topo_LCirc.j = 0 }
                    CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.base, CAD_Topo_LCirc.i)
                    CAD_Topo_LCirc.ang = ArrayGet(CAD_Topo_LCirc.angs, CAD_Topo_LCirc.k)
                    CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.base, CAD_Topo_LCirc.j)
                    CAD_Topo_LCirc.span = ArrayGet(CAD_Topo_LCirc.angs, CAD_Topo_LCirc.k)
                    CAD_Topo_LCirc.span = Float_Sub(CAD_Topo_LCirc.span, CAD_Topo_LCirc.ang)
                    CAD_Topo.LoftCircWrap()
                    CAD_Topo_LCirc.k = CAD_Num.IsZero(CAD_Topo_LCirc.span, 0)
                    IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: { ReturnValue(0) }
                    CAD_Topo_LCirc.k = CAD_Num.IsNeg(CAD_Topo_LCirc.span)
                    IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: { CAD_Topo_LCirc.neg = Add(CAD_Topo_LCirc.neg, 1) }
                    IfCondition EqualTo(CAD_Topo_LCirc.k, 0) ThenBlock: { CAD_Topo_LCirc.pos = Add(CAD_Topo_LCirc.pos, 1) }
                    CAD_Topo_LCirc.sum = Float_Add(CAD_Topo_LCirc.sum, CAD_Topo_LCirc.span)
                    CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
                }
                IfCondition GreaterThan(CAD_Topo_LCirc.pos, 0) ThenBlock: {
                    IfCondition GreaterThan(CAD_Topo_LCirc.neg, 0) ThenBlock: { ReturnValue(0) }
                }
                CAD_Topo_LCirc.k = CAD_Num.IsNeg(CAD_Topo_LCirc.sum)
                IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: {
                    CAD_Topo_LCirc.sum = Float_Sub(0, CAD_Topo_LCirc.sum)
                }
                CAD_Topo_LCirc.k = CAD_Num.IsEqual(CAD_Topo_LCirc.sum, 0x401921FB54442D18, 0)
                IfCondition EqualTo(CAD_Topo_LCirc.k, 0) ThenBlock: { ReturnValue(0) }
            }
            CAD_Topo_LCirc.which = Add(CAD_Topo_LCirc.which, 1)
        }
        ReturnValue(1)
    }
}

// Circle arc edge from vert i to j on ring which. Handle in pool.h.
Function.CAD_Topo.LoftCircArc {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.j = Add(CAD_Topo_LCirc.i, 1)
        IfCondition EqualTo(CAD_Topo_LCirc.j, CAD_Topo_LCirc.n) ThenBlock: { CAD_Topo_LCirc.j = 0 }
        CAD_Topo_LCirc.base = 0
        CAD_Topo_LCirc.src = CAD_Topo_LCirc.vb
        IfCondition EqualTo(CAD_Topo_LCirc.which, 1) ThenBlock: {
            CAD_Topo_LCirc.base = 64
            CAD_Topo_LCirc.src = CAD_Topo_LCirc.vt
        }
        CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.src, CAD_Topo_LCirc.i)
        CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.src, CAD_Topo_LCirc.j)
        CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.base, CAD_Topo_LCirc.i)
        CAD_Topo_LCirc.ang = ArrayGet(CAD_Topo_LCirc.angs, CAD_Topo_LCirc.k)
        CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.base, CAD_Topo_LCirc.j)
        CAD_Topo_LCirc.span = ArrayGet(CAD_Topo_LCirc.angs, CAD_Topo_LCirc.k)
        CAD_Topo_LCirc.span = Float_Sub(CAD_Topo_LCirc.span, CAD_Topo_LCirc.ang)
        CAD_Topo.LoftCircWrap()
        CAD_Topo.LoftCircFrame()
        ArraySet(CAD_Topo_LCirc.frame, 0, CAD_Topo_LCirc.cx)
        ArraySet(CAD_Topo_LCirc.frame, 1, CAD_Topo_LCirc.cy)
        ArraySet(CAD_Topo_LCirc.frame, 2, CAD_Topo_LCirc.cz)
        ArraySet(CAD_Topo_LCirc.frame, 3, CAD_Topo_LCirc.xx)
        ArraySet(CAD_Topo_LCirc.frame, 4, CAD_Topo_LCirc.xy)
        ArraySet(CAD_Topo_LCirc.frame, 5, CAD_Topo_LCirc.xz)
        ArraySet(CAD_Topo_LCirc.frame, 6, CAD_Topo_LCirc.yx)
        ArraySet(CAD_Topo_LCirc.frame, 7, CAD_Topo_LCirc.yy)
        ArraySet(CAD_Topo_LCirc.frame, 8, CAD_Topo_LCirc.yz)
        CAD_Topo_LCirc.h = CAD_Geom.MakeCircle(CAD_Topo_LCirc.frame, CAD_Topo_LCirc.rad)
        CAD_Store.Write(CAD_Topo_LCirc.h, 12, CAD_Topo_LCirc.span)
        CAD_Topo_LCirc.h = CAD_Topo.MakeEdge(CAD_Topo_LCirc.va, CAD_Topo_LCirc.vb2, CAD_Topo_LCirc.h)
        ReturnValue(CAD_Topo_LCirc.h)
    }
}

// Line edge between verts pool.va and pool.vb2. Reads their coordinates.
Function.CAD_Topo.LoftCircLine {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 0)
        CAD_Topo_LCirc.y0 = CAD_Store.Read(CAD_Topo_LCirc.va, 1)
        CAD_Topo_LCirc.z0 = CAD_Store.Read(CAD_Topo_LCirc.va, 2)
        CAD_Topo_LCirc.x1 = CAD_Store.Read(CAD_Topo_LCirc.vb2, 0)
        CAD_Topo_LCirc.y1 = CAD_Store.Read(CAD_Topo_LCirc.vb2, 1)
        CAD_Topo_LCirc.z1 = CAD_Store.Read(CAD_Topo_LCirc.vb2, 2)
        ArraySet(CAD_Topo_LCirc.pt, 0, CAD_Topo_LCirc.x0)
        ArraySet(CAD_Topo_LCirc.pt, 1, CAD_Topo_LCirc.y0)
        ArraySet(CAD_Topo_LCirc.pt, 2, CAD_Topo_LCirc.z0)
        ArraySet(CAD_Topo_LCirc.p1, 0, CAD_Topo_LCirc.x1)
        ArraySet(CAD_Topo_LCirc.p1, 1, CAD_Topo_LCirc.y1)
        ArraySet(CAD_Topo_LCirc.p1, 2, CAD_Topo_LCirc.z1)
        CAD_Topo_LCirc.h = CAD_Geom.MakeLine(CAD_Topo_LCirc.pt, CAD_Topo_LCirc.p1)
        CAD_Topo_LCirc.h = CAD_Topo.MakeEdge(CAD_Topo_LCirc.va, CAD_Topo_LCirc.vb2, CAD_Topo_LCirc.h)
        ReturnValue(CAD_Topo_LCirc.h)
    }
}

// Top ring shares the bottom angle. Bottom X,Y stay in frame[0..5].
Function.CAD_Topo.LoftCircTopMatch {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.which = 0
        CAD_Topo.LoftCircFrame()
        ArraySet(CAD_Topo_LCirc.frame, 0, CAD_Topo_LCirc.xx)
        ArraySet(CAD_Topo_LCirc.frame, 1, CAD_Topo_LCirc.xy)
        ArraySet(CAD_Topo_LCirc.frame, 2, CAD_Topo_LCirc.xz)
        ArraySet(CAD_Topo_LCirc.frame, 3, CAD_Topo_LCirc.yx)
        ArraySet(CAD_Topo_LCirc.frame, 4, CAD_Topo_LCirc.yy)
        ArraySet(CAD_Topo_LCirc.frame, 5, CAD_Topo_LCirc.yz)
        CAD_Topo_LCirc.which = 1
        CAD_Topo.LoftCircFrame()
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.xy, CAD_Topo_LCirc.yz)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.xz, CAD_Topo_LCirc.yy)
        CAD_Topo_LCirc.nx = Float_Sub(CAD_Topo_LCirc.u, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.xz, CAD_Topo_LCirc.yx)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.xx, CAD_Topo_LCirc.yz)
        CAD_Topo_LCirc.ny = Float_Sub(CAD_Topo_LCirc.u, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.xx, CAD_Topo_LCirc.yy)
        CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.xy, CAD_Topo_LCirc.yx)
        CAD_Topo_LCirc.nz = Float_Sub(CAD_Topo_LCirc.u, CAD_Topo_LCirc.v)
        CAD_Topo_LCirc.ln = Float_Mul(CAD_Topo_LCirc.nx, CAD_Topo_LCirc.nx)
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.ny, CAD_Topo_LCirc.ny)
        CAD_Topo_LCirc.ln = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.u)
        CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.nz, CAD_Topo_LCirc.nz)
        CAD_Topo_LCirc.ln = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.u)
        CAD_Topo_LCirc.dst = CAD_Topo_LCirc.top
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, 4) {
            CAD_Topo_LCirc.ang = Float_FromInt(CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.ang = Float_Mul(CAD_Topo_LCirc.ang, 0x3FF921FB54442D18)
            CAD_Topo_LCirc.cs = CAD_Geom.Cos(CAD_Topo_LCirc.ang)
            CAD_Topo_LCirc.sn = CAD_Geom.Sin(CAD_Topo_LCirc.ang)
            CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.frame, 0)
            CAD_Topo_LCirc.x0 = Float_Mul(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.cs)
            CAD_Topo_LCirc.u = ArrayGet(CAD_Topo_LCirc.frame, 3)
            CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.sn)
            CAD_Topo_LCirc.x0 = Float_Add(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.frame, 1)
            CAD_Topo_LCirc.y0 = Float_Mul(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.cs)
            CAD_Topo_LCirc.u = ArrayGet(CAD_Topo_LCirc.frame, 4)
            CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.sn)
            CAD_Topo_LCirc.y0 = Float_Add(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.z0 = ArrayGet(CAD_Topo_LCirc.frame, 2)
            CAD_Topo_LCirc.z0 = Float_Mul(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.cs)
            CAD_Topo_LCirc.u = ArrayGet(CAD_Topo_LCirc.frame, 5)
            CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.sn)
            CAD_Topo_LCirc.z0 = Float_Add(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.dot = Float_Mul(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.nx)
            CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.ny)
            CAD_Topo_LCirc.dot = Float_Add(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.nz)
            CAD_Topo_LCirc.dot = Float_Add(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.k = CAD_Num.IsZero(CAD_Topo_LCirc.ln, 0)
            IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: {
                CAD_Topo.LoftCircPut()
            }
            IfCondition EqualTo(CAD_Topo_LCirc.k, 0) ThenBlock: {
                CAD_Topo_LCirc.u = Float_Div(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.ln)
                CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.nx)
                CAD_Topo_LCirc.x0 = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.v)
                CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.ny)
                CAD_Topo_LCirc.y0 = Float_Sub(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.v)
                CAD_Topo_LCirc.v = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.nz)
                CAD_Topo_LCirc.z0 = Float_Sub(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.v)
                CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.x0)
                CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.y0)
                CAD_Topo_LCirc.span = Float_Add(CAD_Topo_LCirc.span, CAD_Topo_LCirc.u)
                CAD_Topo_LCirc.u = Float_Mul(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.z0)
                CAD_Topo_LCirc.span = Float_Add(CAD_Topo_LCirc.span, CAD_Topo_LCirc.u)
                CAD_Topo_LCirc.span = CAD_Num.Sqrt(CAD_Topo_LCirc.span)
                CAD_Topo_LCirc.shift = CAD_Num.IsZero(CAD_Topo_LCirc.span, 0)
                IfCondition EqualTo(CAD_Topo_LCirc.shift, 1) ThenBlock: {
                    CAD_Topo.LoftCircPut()
                }
                IfCondition EqualTo(CAD_Topo_LCirc.shift, 0) ThenBlock: {
                    CAD_Topo_LCirc.x1 = Float_Div(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.span)
                    CAD_Topo_LCirc.x1 = Float_Mul(CAD_Topo_LCirc.x1, CAD_Topo_LCirc.rad)
                    CAD_Topo_LCirc.x1 = Float_Add(CAD_Topo_LCirc.cx, CAD_Topo_LCirc.x1)
                    CAD_Topo_LCirc.y1 = Float_Div(CAD_Topo_LCirc.y0, CAD_Topo_LCirc.span)
                    CAD_Topo_LCirc.y1 = Float_Mul(CAD_Topo_LCirc.y1, CAD_Topo_LCirc.rad)
                    CAD_Topo_LCirc.y1 = Float_Add(CAD_Topo_LCirc.cy, CAD_Topo_LCirc.y1)
                    CAD_Topo_LCirc.z1 = Float_Div(CAD_Topo_LCirc.z0, CAD_Topo_LCirc.span)
                    CAD_Topo_LCirc.z1 = Float_Mul(CAD_Topo_LCirc.z1, CAD_Topo_LCirc.rad)
                    CAD_Topo_LCirc.z1 = Float_Add(CAD_Topo_LCirc.cz, CAD_Topo_LCirc.z1)
                    CAD_Topo_LCirc.k = Multiply(CAD_Topo_LCirc.i, 3)
                    ArraySet(CAD_Topo_LCirc.dst, CAD_Topo_LCirc.k, CAD_Topo_LCirc.x1)
                    CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
                    ArraySet(CAD_Topo_LCirc.dst, CAD_Topo_LCirc.k, CAD_Topo_LCirc.y1)
                    CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
                    ArraySet(CAD_Topo_LCirc.dst, CAD_Topo_LCirc.k, CAD_Topo_LCirc.z1)
                }
            }
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        ReturnValue(0)
    }
}

// Both-circle wall. Rational quarter, degree (2,1). 0 falls back to a plane.
Function.CAD_Topo.LoftCircNurbsWall {
    Output: Integer
    Body: {
        CAD_Topo_LCirc.shift = CAD_Topo_LCirc.i
        CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.eb, CAD_Topo_LCirc.i)
        CAD_Topo_LCirc.h = 0
        IfCondition NotEqual(CAD_Topo_LCirc.e, 0) ThenBlock: {
            CAD_Topo_LCirc.h = CAD_Store.Read(CAD_Topo_LCirc.e, 2)
        }
        CAD_Topo_LCirc.span = 0
        IfCondition NotEqual(CAD_Topo_LCirc.h, 0) ThenBlock: {
            CAD_Topo_LCirc.span = CAD_Store.Read(CAD_Topo_LCirc.h, 12)
        }
        CAD_Topo_LCirc.k = CAD_Num.IsNeg(CAD_Topo_LCirc.span)
        IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: {
            CAD_Topo_LCirc.span = Float_Sub(0, CAD_Topo_LCirc.span)
        }
        CAD_Topo_LCirc.k = CAD_Num.IsEqual(CAD_Topo_LCirc.span, 0x3FF921FB54442D18, 0x3FA999999999999A)
        IfCondition EqualTo(CAD_Topo_LCirc.k, 0) ThenBlock: {
            CAD_Topo_LCirc.i = CAD_Topo_LCirc.shift
            ReturnValue(0)
        }
        CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.et, CAD_Topo_LCirc.i)
        CAD_Topo_LCirc.h = 0
        IfCondition NotEqual(CAD_Topo_LCirc.e, 0) ThenBlock: {
            CAD_Topo_LCirc.h = CAD_Store.Read(CAD_Topo_LCirc.e, 2)
        }
        CAD_Topo_LCirc.span = 0
        IfCondition NotEqual(CAD_Topo_LCirc.h, 0) ThenBlock: {
            CAD_Topo_LCirc.span = CAD_Store.Read(CAD_Topo_LCirc.h, 12)
        }
        CAD_Topo_LCirc.k = CAD_Num.IsNeg(CAD_Topo_LCirc.span)
        IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: {
            CAD_Topo_LCirc.span = Float_Sub(0, CAD_Topo_LCirc.span)
        }
        CAD_Topo_LCirc.k = CAD_Num.IsEqual(CAD_Topo_LCirc.span, 0x3FF921FB54442D18, 0x3FA999999999999A)
        IfCondition EqualTo(CAD_Topo_LCirc.k, 0) ThenBlock: {
            CAD_Topo_LCirc.i = CAD_Topo_LCirc.shift
            ReturnValue(0)
        }
        CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.i)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 0)
        ArraySet(CAD_Topo_LCirc.angs, 0, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 1)
        ArraySet(CAD_Topo_LCirc.angs, 1, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 2)
        ArraySet(CAD_Topo_LCirc.angs, 2, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.j)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 0)
        ArraySet(CAD_Topo_LCirc.angs, 3, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 1)
        ArraySet(CAD_Topo_LCirc.angs, 4, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 2)
        ArraySet(CAD_Topo_LCirc.angs, 5, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.i)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 0)
        ArraySet(CAD_Topo_LCirc.angs, 9, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 1)
        ArraySet(CAD_Topo_LCirc.angs, 10, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 2)
        ArraySet(CAD_Topo_LCirc.angs, 11, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.j)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 0)
        ArraySet(CAD_Topo_LCirc.angs, 12, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 1)
        ArraySet(CAD_Topo_LCirc.angs, 13, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 2)
        ArraySet(CAD_Topo_LCirc.angs, 14, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.which = 0
        CAD_Topo.LoftCircFrame()
        ArraySet(CAD_Topo_LCirc.angs, 6, CAD_Topo_LCirc.cx)
        ArraySet(CAD_Topo_LCirc.angs, 7, CAD_Topo_LCirc.cy)
        ArraySet(CAD_Topo_LCirc.angs, 8, CAD_Topo_LCirc.cz)
        CAD_Topo_LCirc.which = 1
        CAD_Topo.LoftCircFrame()
        ArraySet(CAD_Topo_LCirc.angs, 15, CAD_Topo_LCirc.cx)
        ArraySet(CAD_Topo_LCirc.angs, 16, CAD_Topo_LCirc.cy)
        ArraySet(CAD_Topo_LCirc.angs, 17, CAD_Topo_LCirc.cz)
        IfCondition EqualTo(CAD_Topo_LCirc.net, 0) ThenBlock: {
            CAD_Topo_LCirc.net = Allocate(256)
        }
        IfCondition EqualTo(CAD_Topo_LCirc.wbuf, 0) ThenBlock: {
            CAD_Topo_LCirc.wbuf = Allocate(64)
        }
        IfCondition EqualTo(CAD_Topo_LCirc.net, 0) ThenBlock: {
            CAD_Topo_LCirc.i = CAD_Topo_LCirc.shift
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo_LCirc.wbuf, 0) ThenBlock: {
            CAD_Topo_LCirc.i = CAD_Topo_LCirc.shift
            ReturnValue(0)
        }
        CAD_Topo_LCirc.k = 0
        WhileLoop LessThan(CAD_Topo_LCirc.k, 3) {
            CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, CAD_Topo_LCirc.k)
            ArraySet(CAD_Topo_LCirc.net, CAD_Topo_LCirc.k, CAD_Topo_LCirc.x0)
            CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.k, 1)
        }
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 0)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 3)
        CAD_Topo_LCirc.x0 = Float_Add(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 6)
        CAD_Topo_LCirc.x0 = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        ArraySet(CAD_Topo_LCirc.net, 3, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 1)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 4)
        CAD_Topo_LCirc.x0 = Float_Add(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 7)
        CAD_Topo_LCirc.x0 = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        ArraySet(CAD_Topo_LCirc.net, 4, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 2)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 5)
        CAD_Topo_LCirc.x0 = Float_Add(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 8)
        CAD_Topo_LCirc.x0 = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        ArraySet(CAD_Topo_LCirc.net, 5, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 3)
        ArraySet(CAD_Topo_LCirc.net, 6, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 4)
        ArraySet(CAD_Topo_LCirc.net, 7, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 5)
        ArraySet(CAD_Topo_LCirc.net, 8, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 9)
        ArraySet(CAD_Topo_LCirc.net, 9, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 10)
        ArraySet(CAD_Topo_LCirc.net, 10, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 11)
        ArraySet(CAD_Topo_LCirc.net, 11, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 9)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 12)
        CAD_Topo_LCirc.x0 = Float_Add(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 15)
        CAD_Topo_LCirc.x0 = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        ArraySet(CAD_Topo_LCirc.net, 12, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 10)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 13)
        CAD_Topo_LCirc.x0 = Float_Add(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 16)
        CAD_Topo_LCirc.x0 = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        ArraySet(CAD_Topo_LCirc.net, 13, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 11)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 14)
        CAD_Topo_LCirc.x0 = Float_Add(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        CAD_Topo_LCirc.y0 = ArrayGet(CAD_Topo_LCirc.angs, 17)
        CAD_Topo_LCirc.x0 = Float_Sub(CAD_Topo_LCirc.x0, CAD_Topo_LCirc.y0)
        ArraySet(CAD_Topo_LCirc.net, 14, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 12)
        ArraySet(CAD_Topo_LCirc.net, 15, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 13)
        ArraySet(CAD_Topo_LCirc.net, 16, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.x0 = ArrayGet(CAD_Topo_LCirc.angs, 14)
        ArraySet(CAD_Topo_LCirc.net, 17, CAD_Topo_LCirc.x0)
        CAD_Topo_LCirc.cs = CAD_Geom.Cos(0x3FE921FB54442D18)
        ArraySet(CAD_Topo_LCirc.wbuf, 0, 0x3FF0000000000000)
        ArraySet(CAD_Topo_LCirc.wbuf, 1, CAD_Topo_LCirc.cs)
        ArraySet(CAD_Topo_LCirc.wbuf, 2, 0x3FF0000000000000)
        ArraySet(CAD_Topo_LCirc.wbuf, 3, 0x3FF0000000000000)
        ArraySet(CAD_Topo_LCirc.wbuf, 4, CAD_Topo_LCirc.cs)
        ArraySet(CAD_Topo_LCirc.wbuf, 5, 0x3FF0000000000000)
        CAD_Topo_LCirc.h = CAD_Geom.MakeNurbsWall(CAD_Topo_LCirc.net, CAD_Topo_LCirc.wbuf)
        CAD_Topo_LCirc.i = CAD_Topo_LCirc.shift
        ReturnValue(CAD_Topo_LCirc.h)
    }
}

// desc: [0] bot is circle [1] top is circle [2] bot r [3] top r
// [4..12] bot center, X, Y. [13..21] top center, X, Y.
// bot_xyz / top_xyz supply the polygon corners. A circle ring is rebuilt.
// Returns the solid, or 0. Does not write the caller's rings.
Function.CAD_Topo.MakeRuledSolidCircle {
    Input: bot_xyz: Address
    Input: top_xyz: Address
    Input: n_pts: Integer
    Input: desc: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        CAD_Topo_LCirc.bin = bot_xyz
        CAD_Topo_LCirc.tin = top_xyz
        CAD_Topo_LCirc.n = n_pts
        CAD_Topo_LCirc.desc = desc
        CAD_Topo_LCirc.out = out_solid_addr
        CAD_Topo_LCirc.bot = 0
        CAD_Topo_LCirc.top = 0
        CAD_Topo_LCirc.pt = 0
        CAD_Topo_LCirc.p1 = 0
        CAD_Topo_LCirc.axb = 0
        CAD_Topo_LCirc.ayb = 0
        CAD_Topo_LCirc.frame = 0
        CAD_Topo_LCirc.vb = 0
        CAD_Topo_LCirc.vt = 0
        CAD_Topo_LCirc.eb = 0
        CAD_Topo_LCirc.et = 0
        CAD_Topo_LCirc.ev = 0
        CAD_Topo_LCirc.ring = 0
        CAD_Topo_LCirc.faces = 0
        CAD_Topo_LCirc.angs = 0
        CAD_Topo_LCirc.net = 0
        CAD_Topo_LCirc.wbuf = 0
        IfCondition LessThan(CAD_Topo_LCirc.n, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(CAD_Topo_LCirc.n, 60) ThenBlock: { ReturnValue(0) }
        CAD_Topo_LCirc.botc = ArrayGet(CAD_Topo_LCirc.desc, 0)
        CAD_Topo_LCirc.topc = ArrayGet(CAD_Topo_LCirc.desc, 1)
        CAD_Topo_LCirc.k = Add(CAD_Topo_LCirc.botc, CAD_Topo_LCirc.topc)
        IfCondition EqualTo(CAD_Topo_LCirc.k, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_LCirc.k, 2) ThenBlock: { CAD_Topo_LCirc.n = 4 }
        CAD_Topo_LCirc.bot = Allocate(2048)
        CAD_Topo_LCirc.top = Allocate(2048)
        CAD_Topo_LCirc.frame = Allocate(128)
        CAD_Topo_LCirc.angs = Allocate(1024)
        IfCondition EqualTo(CAD_Topo_LCirc.bot, 0) ThenBlock: {
            CAD_Topo.LoftCircDrop()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo_LCirc.top, 0) ThenBlock: {
            CAD_Topo.LoftCircDrop()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo_LCirc.frame, 0) ThenBlock: {
            CAD_Topo.LoftCircDrop()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo_LCirc.angs, 0) ThenBlock: {
            CAD_Topo.LoftCircDrop()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo_LCirc.k, 2) ThenBlock: {
            CAD_Topo_LCirc.which = 0
            CAD_Topo.LoftCircQuad()
            CAD_Topo.LoftCircTopMatch()
        }
        IfCondition EqualTo(CAD_Topo_LCirc.botc, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_LCirc.topc, 0) ThenBlock: {
                CAD_Topo_LCirc.src = CAD_Topo_LCirc.tin
                CAD_Topo_LCirc.dst = CAD_Topo_LCirc.top
                CAD_Topo.LoftCircCopy()
                CAD_Topo_LCirc.which = 0
                CAD_Topo.LoftCircProject()
            }
        }
        IfCondition EqualTo(CAD_Topo_LCirc.topc, 1) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_LCirc.botc, 0) ThenBlock: {
                CAD_Topo_LCirc.src = CAD_Topo_LCirc.bin
                CAD_Topo_LCirc.dst = CAD_Topo_LCirc.bot
                CAD_Topo.LoftCircCopy()
                CAD_Topo_LCirc.which = 1
                CAD_Topo.LoftCircProject()
            }
        }
        CAD_Topo_LCirc.h = CAD_Topo.LoftCircSpans()
        IfCondition EqualTo(CAD_Topo_LCirc.h, 0) ThenBlock: {
            CAD_Topo.LoftCircDrop()
            ReturnValue(0)
        }
        CAD_Topo_LCirc.pt = Allocate(32)
        CAD_Topo_LCirc.p1 = Allocate(32)
        CAD_Topo_LCirc.axb = Allocate(32)
        CAD_Topo_LCirc.ayb = Allocate(32)
        CAD_Topo_LCirc.vb = Allocate(512)
        CAD_Topo_LCirc.vt = Allocate(512)
        CAD_Topo_LCirc.eb = Allocate(512)
        CAD_Topo_LCirc.et = Allocate(512)
        CAD_Topo_LCirc.ev = Allocate(512)
        CAD_Topo_LCirc.ring = Allocate(512)
        CAD_Topo_LCirc.faces = Allocate(512)
        IfCondition EqualTo(CAD_Topo_LCirc.pt, 0) ThenBlock: {
            CAD_Topo.LoftCircDrop()
            ReturnValue(0)
        }
        IfCondition EqualTo(CAD_Topo_LCirc.faces, 0) ThenBlock: {
            CAD_Topo.LoftCircDrop()
            ReturnValue(0)
        }
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.n) {
            CAD_Topo_LCirc.src = CAD_Topo_LCirc.bot
            CAD_Topo.LoftCircAt()
            ArraySet(CAD_Topo_LCirc.pt, 0, CAD_Topo_LCirc.x0)
            ArraySet(CAD_Topo_LCirc.pt, 1, CAD_Topo_LCirc.y0)
            ArraySet(CAD_Topo_LCirc.pt, 2, CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.h = CAD_Topo.MakeVertex(CAD_Topo_LCirc.pt)
            ArraySet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.i, CAD_Topo_LCirc.h)
            CAD_Topo_LCirc.src = CAD_Topo_LCirc.top
            CAD_Topo.LoftCircAt()
            ArraySet(CAD_Topo_LCirc.pt, 0, CAD_Topo_LCirc.x0)
            ArraySet(CAD_Topo_LCirc.pt, 1, CAD_Topo_LCirc.y0)
            ArraySet(CAD_Topo_LCirc.pt, 2, CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.h = CAD_Topo.MakeVertex(CAD_Topo_LCirc.pt)
            ArraySet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.i, CAD_Topo_LCirc.h)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.n) {
            CAD_Topo_LCirc.j = Add(CAD_Topo_LCirc.i, 1)
            IfCondition EqualTo(CAD_Topo_LCirc.j, CAD_Topo_LCirc.n) ThenBlock: { CAD_Topo_LCirc.j = 0 }
            IfCondition EqualTo(CAD_Topo_LCirc.botc, 1) ThenBlock: {
                CAD_Topo_LCirc.which = 0
                CAD_Topo.LoftCircArc()
                ArraySet(CAD_Topo_LCirc.eb, CAD_Topo_LCirc.i, CAD_Topo_LCirc.h)
            }
            IfCondition EqualTo(CAD_Topo_LCirc.botc, 0) ThenBlock: {
                CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.i)
                CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.j)
                CAD_Topo.LoftCircLine()
                ArraySet(CAD_Topo_LCirc.eb, CAD_Topo_LCirc.i, CAD_Topo_LCirc.h)
            }
            IfCondition EqualTo(CAD_Topo_LCirc.topc, 1) ThenBlock: {
                CAD_Topo_LCirc.which = 1
                CAD_Topo.LoftCircArc()
                ArraySet(CAD_Topo_LCirc.et, CAD_Topo_LCirc.i, CAD_Topo_LCirc.h)
            }
            IfCondition EqualTo(CAD_Topo_LCirc.topc, 0) ThenBlock: {
                CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.i)
                CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.j)
                CAD_Topo.LoftCircLine()
                ArraySet(CAD_Topo_LCirc.et, CAD_Topo_LCirc.i, CAD_Topo_LCirc.h)
            }
            CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.i)
            CAD_Topo.LoftCircLine()
            ArraySet(CAD_Topo_LCirc.ev, CAD_Topo_LCirc.i, CAD_Topo_LCirc.h)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.n) {
            CAD_Topo_LCirc.j = Add(CAD_Topo_LCirc.i, 1)
            IfCondition EqualTo(CAD_Topo_LCirc.j, CAD_Topo_LCirc.n) ThenBlock: { CAD_Topo_LCirc.j = 0 }
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.eb, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.j)
            CAD_Topo_LCirc.c0 = CAD_Topo.MakeCoedge(CAD_Topo_LCirc.e, CAD_Topo_LCirc.va, 1)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.eb, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.j)
            CAD_Topo_LCirc.c1 = CAD_Topo.MakeCoedge(CAD_Topo_LCirc.e, CAD_Topo_LCirc.vb2, 0)
            CAD_Topo.LinkTwins(CAD_Topo_LCirc.c0, CAD_Topo_LCirc.c1)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.eb, CAD_Topo_LCirc.i)
            CAD_Store.Write(CAD_Topo_LCirc.e, 3, CAD_Topo_LCirc.c0)
            CAD_Store.Write(CAD_Topo_LCirc.e, 4, CAD_Topo_LCirc.c1)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.et, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.j)
            CAD_Topo_LCirc.c0 = CAD_Topo.MakeCoedge(CAD_Topo_LCirc.e, CAD_Topo_LCirc.va, 1)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.et, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.j)
            CAD_Topo_LCirc.c1 = CAD_Topo.MakeCoedge(CAD_Topo_LCirc.e, CAD_Topo_LCirc.vb2, 0)
            CAD_Topo.LinkTwins(CAD_Topo_LCirc.c0, CAD_Topo_LCirc.c1)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.et, CAD_Topo_LCirc.i)
            CAD_Store.Write(CAD_Topo_LCirc.e, 3, CAD_Topo_LCirc.c0)
            CAD_Store.Write(CAD_Topo_LCirc.e, 4, CAD_Topo_LCirc.c1)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.ev, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.c0 = CAD_Topo.MakeCoedge(CAD_Topo_LCirc.e, CAD_Topo_LCirc.va, 1)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.ev, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.c1 = CAD_Topo.MakeCoedge(CAD_Topo_LCirc.e, CAD_Topo_LCirc.vb2, 0)
            CAD_Topo.LinkTwins(CAD_Topo_LCirc.c0, CAD_Topo_LCirc.c1)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.ev, CAD_Topo_LCirc.i)
            CAD_Store.Write(CAD_Topo_LCirc.e, 3, CAD_Topo_LCirc.c0)
            CAD_Store.Write(CAD_Topo_LCirc.e, 4, CAD_Topo_LCirc.c1)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.n) {
            CAD_Topo_LCirc.k = Subtract(CAD_Topo_LCirc.n, 1)
            CAD_Topo_LCirc.k = Subtract(CAD_Topo_LCirc.k, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.eb, CAD_Topo_LCirc.k)
            CAD_Topo_LCirc.h = CAD_Store.Read(CAD_Topo_LCirc.e, 4)
            ArraySet(CAD_Topo_LCirc.ring, CAD_Topo_LCirc.i, CAD_Topo_LCirc.h)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        CAD_Topo_LCirc.h = CAD_Topo.LoftFrame(CAD_Topo_LCirc.bot, CAD_Topo_LCirc.n, 0xBFF0000000000000)
        IfCondition EqualTo(CAD_Topo_LCirc.h, 0) ThenBlock: {
            CAD_Topo.LoftCircDrop()
            ReturnValue(0)
        }
        ArraySet(CAD_Topo_LCirc.pt, 0, CAD_Topo_Loft.ox)
        ArraySet(CAD_Topo_LCirc.pt, 1, CAD_Topo_Loft.oy)
        ArraySet(CAD_Topo_LCirc.pt, 2, CAD_Topo_Loft.oz)
        ArraySet(CAD_Topo_LCirc.axb, 0, CAD_Topo_Loft.xx)
        ArraySet(CAD_Topo_LCirc.axb, 1, CAD_Topo_Loft.xy)
        ArraySet(CAD_Topo_LCirc.axb, 2, CAD_Topo_Loft.xz)
        ArraySet(CAD_Topo_LCirc.ayb, 0, CAD_Topo_Loft.yx)
        ArraySet(CAD_Topo_LCirc.ayb, 1, CAD_Topo_Loft.yy)
        ArraySet(CAD_Topo_LCirc.ayb, 2, CAD_Topo_Loft.yz)
        CAD_Topo_LCirc.h = CAD_Geom.MakePlaneAxes(CAD_Topo_LCirc.pt, CAD_Topo_LCirc.axb, CAD_Topo_LCirc.ayb)
        CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.ring, 0)
        CAD_Topo_LCirc.c0 = CAD_Topo.MakeLoop(CAD_Topo_LCirc.e)
        CAD_Topo.LinkLoopRing(CAD_Topo_LCirc.ring, CAD_Topo_LCirc.n, CAD_Topo_LCirc.c0)
        CAD_Topo_LCirc.c0 = CAD_Topo.MakeFace(CAD_Topo_LCirc.h, CAD_Topo_LCirc.c0)
        ArraySet(CAD_Topo_LCirc.faces, 0, CAD_Topo_LCirc.c0)
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.n) {
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.et, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.h = CAD_Store.Read(CAD_Topo_LCirc.e, 3)
            ArraySet(CAD_Topo_LCirc.ring, CAD_Topo_LCirc.i, CAD_Topo_LCirc.h)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        CAD_Topo_LCirc.h = CAD_Topo.LoftFrame(CAD_Topo_LCirc.top, CAD_Topo_LCirc.n, 0x3FF0000000000000)
        IfCondition EqualTo(CAD_Topo_LCirc.h, 0) ThenBlock: {
            CAD_Topo.LoftCircDrop()
            ReturnValue(0)
        }
        ArraySet(CAD_Topo_LCirc.pt, 0, CAD_Topo_Loft.ox)
        ArraySet(CAD_Topo_LCirc.pt, 1, CAD_Topo_Loft.oy)
        ArraySet(CAD_Topo_LCirc.pt, 2, CAD_Topo_Loft.oz)
        ArraySet(CAD_Topo_LCirc.axb, 0, CAD_Topo_Loft.xx)
        ArraySet(CAD_Topo_LCirc.axb, 1, CAD_Topo_Loft.xy)
        ArraySet(CAD_Topo_LCirc.axb, 2, CAD_Topo_Loft.xz)
        ArraySet(CAD_Topo_LCirc.ayb, 0, CAD_Topo_Loft.yx)
        ArraySet(CAD_Topo_LCirc.ayb, 1, CAD_Topo_Loft.yy)
        ArraySet(CAD_Topo_LCirc.ayb, 2, CAD_Topo_Loft.yz)
        CAD_Topo_LCirc.h = CAD_Geom.MakePlaneAxes(CAD_Topo_LCirc.pt, CAD_Topo_LCirc.axb, CAD_Topo_LCirc.ayb)
        CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.ring, 0)
        CAD_Topo_LCirc.c0 = CAD_Topo.MakeLoop(CAD_Topo_LCirc.e)
        CAD_Topo.LinkLoopRing(CAD_Topo_LCirc.ring, CAD_Topo_LCirc.n, CAD_Topo_LCirc.c0)
        CAD_Topo_LCirc.c0 = CAD_Topo.MakeFace(CAD_Topo_LCirc.h, CAD_Topo_LCirc.c0)
        ArraySet(CAD_Topo_LCirc.faces, 1, CAD_Topo_LCirc.c0)
        CAD_Topo_LCirc.nf = 2
        CAD_Topo_LCirc.i = 0
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.n) {
            CAD_Topo_LCirc.j = Add(CAD_Topo_LCirc.i, 1)
            IfCondition EqualTo(CAD_Topo_LCirc.j, CAD_Topo_LCirc.n) ThenBlock: { CAD_Topo_LCirc.j = 0 }
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.eb, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.h = CAD_Store.Read(CAD_Topo_LCirc.e, 3)
            ArraySet(CAD_Topo_LCirc.ring, 0, CAD_Topo_LCirc.h)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.ev, CAD_Topo_LCirc.j)
            CAD_Topo_LCirc.h = CAD_Store.Read(CAD_Topo_LCirc.e, 3)
            ArraySet(CAD_Topo_LCirc.ring, 1, CAD_Topo_LCirc.h)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.et, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.h = CAD_Store.Read(CAD_Topo_LCirc.e, 4)
            ArraySet(CAD_Topo_LCirc.ring, 2, CAD_Topo_LCirc.h)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.ev, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.h = CAD_Store.Read(CAD_Topo_LCirc.e, 4)
            ArraySet(CAD_Topo_LCirc.ring, 3, CAD_Topo_LCirc.h)
            CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.j)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 0)
            CAD_Topo_LCirc.y0 = CAD_Store.Read(CAD_Topo_LCirc.va, 1)
            CAD_Topo_LCirc.z0 = CAD_Store.Read(CAD_Topo_LCirc.va, 2)
            CAD_Topo_LCirc.x1 = CAD_Store.Read(CAD_Topo_LCirc.vb2, 0)
            CAD_Topo_LCirc.y1 = CAD_Store.Read(CAD_Topo_LCirc.vb2, 1)
            CAD_Topo_LCirc.z1 = CAD_Store.Read(CAD_Topo_LCirc.vb2, 2)
            CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.x1, CAD_Topo_LCirc.x0)
            CAD_Topo_LCirc.v = Float_Sub(CAD_Topo_LCirc.y1, CAD_Topo_LCirc.y0)
            CAD_Topo_LCirc.dot = Float_Sub(CAD_Topo_LCirc.z1, CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.ln = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.v, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.ln = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.span)
            CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.dot)
            CAD_Topo_LCirc.ln = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.span)
            CAD_Topo_LCirc.ln = CAD_Num.Sqrt(CAD_Topo_LCirc.ln)
            CAD_Topo_LCirc.k = CAD_Num.IsZero(CAD_Topo_LCirc.ln, 0)
            IfCondition EqualTo(CAD_Topo_LCirc.k, 1) ThenBlock: {
                CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.i)
                CAD_Topo_LCirc.vb2 = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.j)
                CAD_Topo_LCirc.x1 = CAD_Store.Read(CAD_Topo_LCirc.va, 0)
                CAD_Topo_LCirc.y1 = CAD_Store.Read(CAD_Topo_LCirc.va, 1)
                CAD_Topo_LCirc.z1 = CAD_Store.Read(CAD_Topo_LCirc.va, 2)
                CAD_Topo_LCirc.sx = CAD_Store.Read(CAD_Topo_LCirc.vb2, 0)
                CAD_Topo_LCirc.sy = CAD_Store.Read(CAD_Topo_LCirc.vb2, 1)
                CAD_Topo_LCirc.sz = CAD_Store.Read(CAD_Topo_LCirc.vb2, 2)
                CAD_Topo_LCirc.u = Float_Sub(CAD_Topo_LCirc.sx, CAD_Topo_LCirc.x1)
                CAD_Topo_LCirc.v = Float_Sub(CAD_Topo_LCirc.sy, CAD_Topo_LCirc.y1)
                CAD_Topo_LCirc.dot = Float_Sub(CAD_Topo_LCirc.sz, CAD_Topo_LCirc.z1)
                CAD_Topo_LCirc.ln = Float_Mul(CAD_Topo_LCirc.u, CAD_Topo_LCirc.u)
                CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.v, CAD_Topo_LCirc.v)
                CAD_Topo_LCirc.ln = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.span)
                CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.dot)
                CAD_Topo_LCirc.ln = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.span)
                CAD_Topo_LCirc.ln = CAD_Num.Sqrt(CAD_Topo_LCirc.ln)
            }
            CAD_Topo_LCirc.k = CAD_Num.IsZero(CAD_Topo_LCirc.ln, 0)
            IfCondition EqualTo(CAD_Topo_LCirc.k, 0) ThenBlock: {
                CAD_Topo_LCirc.u = Float_Div(CAD_Topo_LCirc.u, CAD_Topo_LCirc.ln)
                CAD_Topo_LCirc.v = Float_Div(CAD_Topo_LCirc.v, CAD_Topo_LCirc.ln)
                CAD_Topo_LCirc.dot = Float_Div(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.ln)
            }
            ArraySet(CAD_Topo_LCirc.axb, 0, CAD_Topo_LCirc.u)
            ArraySet(CAD_Topo_LCirc.axb, 1, CAD_Topo_LCirc.v)
            ArraySet(CAD_Topo_LCirc.axb, 2, CAD_Topo_LCirc.dot)
            CAD_Topo_LCirc.va = ArrayGet(CAD_Topo_LCirc.vb, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.vt, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.x0 = CAD_Store.Read(CAD_Topo_LCirc.va, 0)
            CAD_Topo_LCirc.y0 = CAD_Store.Read(CAD_Topo_LCirc.va, 1)
            CAD_Topo_LCirc.z0 = CAD_Store.Read(CAD_Topo_LCirc.va, 2)
            CAD_Topo_LCirc.x1 = CAD_Store.Read(CAD_Topo_LCirc.e, 0)
            CAD_Topo_LCirc.y1 = CAD_Store.Read(CAD_Topo_LCirc.e, 1)
            CAD_Topo_LCirc.z1 = CAD_Store.Read(CAD_Topo_LCirc.e, 2)
            ArraySet(CAD_Topo_LCirc.pt, 0, CAD_Topo_LCirc.x0)
            ArraySet(CAD_Topo_LCirc.pt, 1, CAD_Topo_LCirc.y0)
            ArraySet(CAD_Topo_LCirc.pt, 2, CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.sx = Float_Sub(CAD_Topo_LCirc.x1, CAD_Topo_LCirc.x0)
            CAD_Topo_LCirc.sy = Float_Sub(CAD_Topo_LCirc.y1, CAD_Topo_LCirc.y0)
            CAD_Topo_LCirc.sz = Float_Sub(CAD_Topo_LCirc.z1, CAD_Topo_LCirc.z0)
            CAD_Topo_LCirc.dot = Float_Mul(CAD_Topo_LCirc.sx, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.sy, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.dot = Float_Add(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.span)
            CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.sz, CAD_Topo_LCirc.dot)
            CAD_Topo_LCirc.dot = Float_Add(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.span)
            CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.u)
            CAD_Topo_LCirc.sx = Float_Sub(CAD_Topo_LCirc.sx, CAD_Topo_LCirc.span)
            CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.v)
            CAD_Topo_LCirc.sy = Float_Sub(CAD_Topo_LCirc.sy, CAD_Topo_LCirc.span)
            CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.dot, CAD_Topo_LCirc.dot)
            CAD_Topo_LCirc.sz = Float_Sub(CAD_Topo_LCirc.sz, CAD_Topo_LCirc.span)
            CAD_Topo_LCirc.ln = Float_Mul(CAD_Topo_LCirc.sx, CAD_Topo_LCirc.sx)
            CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.sy, CAD_Topo_LCirc.sy)
            CAD_Topo_LCirc.ln = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.span)
            CAD_Topo_LCirc.span = Float_Mul(CAD_Topo_LCirc.sz, CAD_Topo_LCirc.sz)
            CAD_Topo_LCirc.ln = Float_Add(CAD_Topo_LCirc.ln, CAD_Topo_LCirc.span)
            CAD_Topo_LCirc.ln = CAD_Num.Sqrt(CAD_Topo_LCirc.ln)
            CAD_Topo_LCirc.k = CAD_Num.IsZero(CAD_Topo_LCirc.ln, 0)
            IfCondition EqualTo(CAD_Topo_LCirc.k, 0) ThenBlock: {
                CAD_Topo_LCirc.sx = Float_Div(CAD_Topo_LCirc.sx, CAD_Topo_LCirc.ln)
                CAD_Topo_LCirc.sy = Float_Div(CAD_Topo_LCirc.sy, CAD_Topo_LCirc.ln)
                CAD_Topo_LCirc.sz = Float_Div(CAD_Topo_LCirc.sz, CAD_Topo_LCirc.ln)
            }
            ArraySet(CAD_Topo_LCirc.ayb, 0, CAD_Topo_LCirc.sx)
            ArraySet(CAD_Topo_LCirc.ayb, 1, CAD_Topo_LCirc.sy)
            ArraySet(CAD_Topo_LCirc.ayb, 2, CAD_Topo_LCirc.sz)
            CAD_Topo_LCirc.h = 0
            IfCondition EqualTo(CAD_Topo_LCirc.botc, 1) ThenBlock: {
                IfCondition EqualTo(CAD_Topo_LCirc.topc, 1) ThenBlock: {
                    CAD_Topo_LCirc.h = CAD_Topo.LoftCircNurbsWall()
                }
            }
            IfCondition EqualTo(CAD_Topo_LCirc.h, 0) ThenBlock: {
                CAD_Topo_LCirc.h = CAD_Geom.MakePlaneAxes(CAD_Topo_LCirc.pt, CAD_Topo_LCirc.axb, CAD_Topo_LCirc.ayb)
            }
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.ring, 0)
            CAD_Topo_LCirc.c0 = CAD_Topo.MakeLoop(CAD_Topo_LCirc.e)
            CAD_Topo.LinkLoopRing(CAD_Topo_LCirc.ring, 4, CAD_Topo_LCirc.c0)
            CAD_Topo_LCirc.c0 = CAD_Topo.MakeFace(CAD_Topo_LCirc.h, CAD_Topo_LCirc.c0)
            ArraySet(CAD_Topo_LCirc.faces, CAD_Topo_LCirc.nf, CAD_Topo_LCirc.c0)
            CAD_Topo_LCirc.nf = Add(CAD_Topo_LCirc.nf, 1)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        CAD_Topo_LCirc.i = 0
        CAD_Topo_LCirc.k = Subtract(CAD_Topo_LCirc.nf, 1)
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.k) {
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.faces, CAD_Topo_LCirc.i)
            CAD_Topo_LCirc.j = Add(CAD_Topo_LCirc.i, 1)
            CAD_Topo_LCirc.h = ArrayGet(CAD_Topo_LCirc.faces, CAD_Topo_LCirc.j)
            CAD_Store.Write(CAD_Topo_LCirc.e, 3, CAD_Topo_LCirc.h)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.faces, CAD_Topo_LCirc.k)
        CAD_Store.Write(CAD_Topo_LCirc.e, 3, 0)
        CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.faces, 0)
        CAD_Topo_LCirc.h = CAD_Topo.MakeShell(CAD_Topo_LCirc.e)
        CAD_Topo_LCirc.i = 1
        WhileLoop LessThan(CAD_Topo_LCirc.i, CAD_Topo_LCirc.nf) {
            CAD_Topo_LCirc.e = ArrayGet(CAD_Topo_LCirc.faces, CAD_Topo_LCirc.i)
            CAD_Store.Write(CAD_Topo_LCirc.e, 2, CAD_Topo_LCirc.h)
            CAD_Topo_LCirc.i = Add(CAD_Topo_LCirc.i, 1)
        }
        CAD_Topo_LCirc.e = CAD_Topo.MakeSolid(CAD_Topo_LCirc.h)
        CAD_Store.Write(CAD_Topo_LCirc.e, 1, 0)
        CAD_Store.Write(CAD_Topo_LCirc.e, 2, 0)
        CAD_Store.Write(CAD_Topo_LCirc.e, 3, 0)
        ArraySet(CAD_Topo_LCirc.out, 0, CAD_Topo_LCirc.e)
        CAD_Topo_LCirc.h = CAD_Topo_LCirc.e
        CAD_Topo.LoftCircDrop()
        ReturnValue(CAD_Topo_LCirc.h)
    }
}
