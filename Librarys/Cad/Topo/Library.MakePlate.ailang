// CAD.Topo.MakePlate — split from Library.CAD_Topo.ailang
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.MakeBoxThroughHole {
    Input: dx_r: Integer
    Input: dy_r: Integer
    Input: dz_r: Integer
    Input: hole_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        // default center + through (depth=dz)
        half = 0x4000000000000000
        cx = Float_Div(dx_r, half)
        cy = Float_Div(dy_r, half)
        pack = Allocate(64)
        ArraySet(pack, 0, dx_r)
        ArraySet(pack, 1, dy_r)
        ArraySet(pack, 2, dz_r)
        ArraySet(pack, 3, hole_r)
        ArraySet(pack, 4, cx)
        ArraySet(pack, 5, cy)
        ArraySet(pack, 6, dz_r)
        h = CAD_Topo.MakeBoxHolePack(pack, out_solid_addr)
        Deallocate(pack, 64)
        ReturnValue(h)
    }
}

// pack: [dx,dy,dz, hole_r, cx, cy, hole_depth] → kind-3 solid with n_holes=1
// Params stride 26: hole0 at 3..5,8; n_holes at 9; extra holes at 10+
Function.CAD_Topo.MakeBoxHolePack {
    Input: pack_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        dx_r = ArrayGet(pack_addr, 0)
        dy_r = ArrayGet(pack_addr, 1)
        dz_r = ArrayGet(pack_addr, 2)
        hole_r = ArrayGet(pack_addr, 3)
        cx = ArrayGet(pack_addr, 4)
        cy = ArrayGet(pack_addr, 5)
        hdep = ArrayGet(pack_addr, 6)
        IfCondition EqualTo(CAD_Num.IsZero(dx_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(hole_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(hdep, 0), 1) ThenBlock: { hdep = dz_r }
        // clamp depth to plate
        IfCondition EqualTo(Float_Le(dz_r, hdep), 1) ThenBlock: { hdep = dz_r }
        ph = CAD_Store.Alloc(13, 26)
        IfCondition EqualTo(ph, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(ph, 0, dx_r)
        CAD_Store.Write(ph, 1, dy_r)
        CAD_Store.Write(ph, 2, dz_r)
        CAD_Store.Write(ph, 3, hole_r)
        CAD_Store.Write(ph, 4, cx)
        CAD_Store.Write(ph, 5, cy)
        CAD_Store.Write(ph, 6, 0)
        CAD_Store.Write(ph, 7, 0)
        CAD_Store.Write(ph, 8, hdep)
        CAD_Store.Write(ph, 9, 1)
        h_so = CAD_Store.Alloc(7, 4)
        IfCondition EqualTo(h_so, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h_so, 0, 0)
        CAD_Store.Write(h_so, 1, ph)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 3)
        // BREP-first: attach walkable shell for single through-hole (export without recipe)
        CAD_Topo.BuildPlateThroughHoleShell(h_so)
        CAD_Topo_State.solid_count = Add(CAD_Topo_State.solid_count, 1)
        ArraySet(out_solid_addr, 0, h_so)
        ReturnValue(h_so)
    }
}


// Build walkable B-Rep shell for kind-3 plate with 1..5 holes (through and/or blind).
// Independent holes: top/bottom get one inner circle per opening.
// Nested coaxial counterbore (2 holes, large shallow + small deeper): annular floor,
// pilot wall only below floor — topology truth in Topo, not a STEP recipe.
// Attaches shell to solid[0]. Returns 0 ok, -1 fail.
Function.CAD_Topo.BuildPlateHoleShell {
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(CAD_Store.Read(solid_handle, 3), 3) ThenBlock: { ReturnValue(-1) }
        ph = CAD_Store.Read(solid_handle, 1)
        nh = CAD_Store.Read(ph, 9)
        IfCondition EqualTo(nh, 0) ThenBlock: { nh = 1 }
        IfCondition GreaterThan(nh, 5) ThenBlock: { ReturnValue(-1) }
        dx = CAD_Store.Read(ph, 0)
        dy = CAD_Store.Read(ph, 1)
        dz = CAD_Store.Read(ph, 2)
        ox = CAD_Store.Read(ph, 6)
        oy = CAD_Store.Read(ph, 7)
        one = 0x3FF0000000000000
        zro = 0
        neg1 = 0xBFF0000000000000
        x0 = ox
        y0 = oy
        x1 = Float_Add(ox, dx)
        y1 = Float_Add(oy, dy)

        // load holes into arrays r[5],cx,cy,dep,zf,thru
        hr_a = Allocate(64)
        cx_a = Allocate(64)
        cy_a = Allocate(64)
        dep_a = Allocate(64)
        zf_a = Allocate(64)
        thr_a = Allocate(64)
        hi = 0
        WhileLoop LessThan(hi, nh) {
            IfCondition EqualTo(hi, 0) ThenBlock: {
                ArraySet(hr_a, hi, CAD_Store.Read(ph, 3))
                ArraySet(cx_a, hi, CAD_Store.Read(ph, 4))
                ArraySet(cy_a, hi, CAD_Store.Read(ph, 5))
                hdep = CAD_Store.Read(ph, 8)
            }
            IfCondition GreaterThan(hi, 0) ThenBlock: {
                base = Add(10, Multiply(Subtract(hi, 1), 4))
                ArraySet(hr_a, hi, CAD_Store.Read(ph, base))
                ArraySet(cx_a, hi, CAD_Store.Read(ph, Add(base, 1)))
                ArraySet(cy_a, hi, CAD_Store.Read(ph, Add(base, 2)))
                hdep = CAD_Store.Read(ph, Add(base, 3))
            }
            IfCondition EqualTo(CAD_Num.IsZero(hdep, 0), 1) ThenBlock: { hdep = dz }
            IfCondition EqualTo(Float_Le(dz, hdep), 1) ThenBlock: { hdep = dz }
            ArraySet(dep_a, hi, hdep)
            ArraySet(zf_a, hi, Float_Sub(dz, hdep))
            thr = 0
            IfCondition EqualTo(CAD_Num.IsEqual(hdep, dz, 0), 1) ThenBlock: { thr = 1 }
            ArraySet(thr_a, hi, thr)
            hi = Add(hi, 1)
        }

        // detect nested counterbore: nh=2, same center, different r, larger shallower
        nested = 0
        ismall = 0
        ilarge = 1
        IfCondition EqualTo(nh, 2) ThenBlock: {
            IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(cx_a, 0), ArrayGet(cx_a, 1), 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ArrayGet(cy_a, 0), ArrayGet(cy_a, 1), 0), 1) ThenBlock: {
                    r0 = ArrayGet(hr_a, 0)
                    r1 = ArrayGet(hr_a, 1)
                    IfCondition EqualTo(CAD_Num.IsEqual(r0, r1, 0), 0) ThenBlock: {
                        IfCondition EqualTo(Float_Le(r0, r1), 1) ThenBlock: {
                            ismall = 0
                            ilarge = 1
                        }
                        IfCondition EqualTo(Float_Le(r1, r0), 1) ThenBlock: {
                            ismall = 1
                            ilarge = 0
                        }
                        // large must be shallower than small
                        IfCondition EqualTo(Float_Le(ArrayGet(dep_a, ilarge), ArrayGet(dep_a, ismall)), 1) ThenBlock: {
                            nested = 1
                        }
                    }
                }
            }
        }

        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        frame = Allocate(128)
        ring = Allocate(128)

        // box verts
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, zro)
        v0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v3 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, dz)
        v4 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v5 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v6 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v7 = CAD_Topo.MakeVertex(pt)

        // box edges
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, zro)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, zro)
        e01 = CAD_Topo.MakeEdge(v0, v1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        e12 = CAD_Topo.MakeEdge(v1, v2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        e23 = CAD_Topo.MakeEdge(v2, v3, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        e30 = CAD_Topo.MakeEdge(v3, v0, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, dz)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, dz)
        e45 = CAD_Topo.MakeEdge(v4, v5, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        e56 = CAD_Topo.MakeEdge(v5, v6, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        e67 = CAD_Topo.MakeEdge(v6, v7, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        e74 = CAD_Topo.MakeEdge(v7, v4, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, zro)
        ArraySet(p1b, 0, x0)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, dz)
        e04 = CAD_Topo.MakeEdge(v0, v4, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 0, x1)
        e15 = CAD_Topo.MakeEdge(v1, v5, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 1, y1)
        e26 = CAD_Topo.MakeEdge(v2, v6, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 0, x0)
        e37 = CAD_Topo.MakeEdge(v3, v7, CAD_Geom.MakeLine(pt, p1b))

        // planes
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, dz)
        ArraySet(ay, 1, one)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, neg1)
        pl_y0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 1, y1)
        ArraySet(ay, 2, one)
        pl_y1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 0, x1)
        ArraySet(pt, 1, y0)
        ArraySet(ax, 0, zro)
        ArraySet(ax, 1, one)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        pl_x1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 0, x0)
        ArraySet(ax, 1, neg1)
        pl_x0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)

        // box coedges
        c01b = CAD_Topo.MakeCoedge(e01, v0, 1)
        c01s = CAD_Topo.MakeCoedge(e01, v1, 0)
        CAD_Topo.LinkTwins(c01b, c01s)
        CAD_Store.Write(e01, 3, c01b)
        CAD_Store.Write(e01, 4, c01s)
        c12b = CAD_Topo.MakeCoedge(e12, v1, 1)
        c12s = CAD_Topo.MakeCoedge(e12, v2, 0)
        CAD_Topo.LinkTwins(c12b, c12s)
        CAD_Store.Write(e12, 3, c12b)
        CAD_Store.Write(e12, 4, c12s)
        c23b = CAD_Topo.MakeCoedge(e23, v2, 1)
        c23s = CAD_Topo.MakeCoedge(e23, v3, 0)
        CAD_Topo.LinkTwins(c23b, c23s)
        CAD_Store.Write(e23, 3, c23b)
        CAD_Store.Write(e23, 4, c23s)
        c30b = CAD_Topo.MakeCoedge(e30, v3, 1)
        c30s = CAD_Topo.MakeCoedge(e30, v0, 0)
        CAD_Topo.LinkTwins(c30b, c30s)
        CAD_Store.Write(e30, 3, c30b)
        CAD_Store.Write(e30, 4, c30s)
        c45t = CAD_Topo.MakeCoedge(e45, v4, 1)
        c45s = CAD_Topo.MakeCoedge(e45, v5, 0)
        CAD_Topo.LinkTwins(c45t, c45s)
        CAD_Store.Write(e45, 3, c45t)
        CAD_Store.Write(e45, 4, c45s)
        c56t = CAD_Topo.MakeCoedge(e56, v5, 1)
        c56s = CAD_Topo.MakeCoedge(e56, v6, 0)
        CAD_Topo.LinkTwins(c56t, c56s)
        CAD_Store.Write(e56, 3, c56t)
        CAD_Store.Write(e56, 4, c56s)
        c67t = CAD_Topo.MakeCoedge(e67, v6, 1)
        c67s = CAD_Topo.MakeCoedge(e67, v7, 0)
        CAD_Topo.LinkTwins(c67t, c67s)
        CAD_Store.Write(e67, 3, c67t)
        CAD_Store.Write(e67, 4, c67s)
        c74t = CAD_Topo.MakeCoedge(e74, v7, 1)
        c74s = CAD_Topo.MakeCoedge(e74, v4, 0)
        CAD_Topo.LinkTwins(c74t, c74s)
        CAD_Store.Write(e74, 3, c74t)
        CAD_Store.Write(e74, 4, c74s)
        c04u = CAD_Topo.MakeCoedge(e04, v0, 1)
        c04d = CAD_Topo.MakeCoedge(e04, v4, 0)
        CAD_Topo.LinkTwins(c04u, c04d)
        CAD_Store.Write(e04, 3, c04u)
        CAD_Store.Write(e04, 4, c04d)
        c15u = CAD_Topo.MakeCoedge(e15, v1, 1)
        c15d = CAD_Topo.MakeCoedge(e15, v5, 0)
        CAD_Topo.LinkTwins(c15u, c15d)
        CAD_Store.Write(e15, 3, c15u)
        CAD_Store.Write(e15, 4, c15d)
        c26u = CAD_Topo.MakeCoedge(e26, v2, 1)
        c26d = CAD_Topo.MakeCoedge(e26, v6, 0)
        CAD_Topo.LinkTwins(c26u, c26d)
        CAD_Store.Write(e26, 3, c26u)
        CAD_Store.Write(e26, 4, c26d)
        c37u = CAD_Topo.MakeCoedge(e37, v3, 1)
        c37d = CAD_Topo.MakeCoedge(e37, v7, 0)
        CAD_Topo.LinkTwins(c37u, c37d)
        CAD_Store.Write(e37, 3, c37u)
        CAD_Store.Write(e37, 4, c37d)

        // store hole coedges for face assembly: top_inner[i], bot_inner[i], wall faces
        top_in = Allocate(64)
        bot_in = Allocate(64)
        n_bot_in = 0
        face_list = Allocate(128)
        nfaces = 0

        // ----- NESTED COUNTERBORE -----
        IfCondition EqualTo(nested, 1) ThenBlock: {
            rs = ArrayGet(hr_a, ismall)
            rl = ArrayGet(hr_a, ilarge)
            zf = ArrayGet(zf_a, ilarge)
            hx = Float_Add(ox, ArrayGet(cx_a, ismall))
            hy = Float_Add(oy, ArrayGet(cy_a, ismall))
            // verts: pilot bot z=0, mid z=zf, large top z=dz seams
            ArraySet(pt, 0, Float_Add(hx, rs))
            ArraySet(pt, 1, hy)
            ArraySet(pt, 2, zro)
            vsb = CAD_Topo.MakeVertex(pt)
            ArraySet(pt, 2, zf)
            vsm = CAD_Topo.MakeVertex(pt)
            ArraySet(pt, 0, Float_Add(hx, rl))
            ArraySet(pt, 2, zf)
            vlb = CAD_Topo.MakeVertex(pt)
            ArraySet(pt, 2, dz)
            vlt = CAD_Topo.MakeVertex(pt)
            // circles
            ArraySet(frame, 0, hx)
            ArraySet(frame, 1, hy)
            ArraySet(frame, 2, zro)
            ArraySet(frame, 3, one)
            ArraySet(frame, 4, zro)
            ArraySet(frame, 5, zro)
            ArraySet(frame, 6, zro)
            ArraySet(frame, 7, one)
            ArraySet(frame, 8, zro)
            ArraySet(frame, 9, zro)
            ArraySet(frame, 10, zro)
            ArraySet(frame, 11, one)
            circ_sb = CAD_Geom.MakeCircle(frame, rs)
            ArraySet(frame, 2, zf)
            circ_sm = CAD_Geom.MakeCircle(frame, rs)
            circ_lf = CAD_Geom.MakeCircle(frame, rl)
            ArraySet(frame, 2, dz)
            circ_lt = CAD_Geom.MakeCircle(frame, rl)
            ArraySet(frame, 2, zro)
            cyl_s = CAD_Geom.MakeCylinderSurf(frame, rs)
            ArraySet(frame, 2, zf)
            cyl_l = CAD_Geom.MakeCylinderSurf(frame, rl)
            ArraySet(pt, 0, Float_Add(hx, rs))
            ArraySet(pt, 1, hy)
            ArraySet(pt, 2, zro)
            ArraySet(p1b, 0, Float_Add(hx, rs))
            ArraySet(p1b, 1, hy)
            ArraySet(p1b, 2, zf)
            e_ps = CAD_Topo.MakeEdge(vsb, vsm, CAD_Geom.MakeLine(pt, p1b))
            ArraySet(pt, 0, Float_Add(hx, rl))
            ArraySet(pt, 2, zf)
            ArraySet(p1b, 0, Float_Add(hx, rl))
            ArraySet(p1b, 2, dz)
            e_ls = CAD_Topo.MakeEdge(vlb, vlt, CAD_Geom.MakeLine(pt, p1b))
            e_sb = CAD_Topo.MakeEdge(vsb, vsb, circ_sb)
            e_sm = CAD_Topo.MakeEdge(vsm, vsm, circ_sm)
            e_lf = CAD_Topo.MakeEdge(vlb, vlb, circ_lf)
            e_lt = CAD_Topo.MakeEdge(vlt, vlt, circ_lt)
            // Coedges: cylindrical walls need opposite circle senses (bot T, top F)
            // same as MakeCylinderSolid / through-hole — same sense = FreeCAD vanishing cyl.
            csb_bot = CAD_Topo.MakeCoedge(e_sb, vsb, 0)
            csb_w = CAD_Topo.MakeCoedge(e_sb, vsb, 1)
            CAD_Topo.LinkTwins(csb_bot, csb_w)
            CAD_Store.Write(e_sb, 3, csb_bot)
            CAD_Store.Write(e_sb, 4, csb_w)
            // mid: wall reverse (0), floor forward (1)
            csm_w = CAD_Topo.MakeCoedge(e_sm, vsm, 0)
            csm_fl = CAD_Topo.MakeCoedge(e_sm, vsm, 1)
            CAD_Topo.LinkTwins(csm_w, csm_fl)
            CAD_Store.Write(e_sm, 3, csm_w)
            CAD_Store.Write(e_sm, 4, csm_fl)
            // large: wall bot(floor) forward (1), wall top reverse (0)
            clf_w = CAD_Topo.MakeCoedge(e_lf, vlb, 1)
            clf_fl = CAD_Topo.MakeCoedge(e_lf, vlb, 0)
            CAD_Topo.LinkTwins(clf_w, clf_fl)
            CAD_Store.Write(e_lf, 3, clf_w)
            CAD_Store.Write(e_lf, 4, clf_fl)
            clt_w = CAD_Topo.MakeCoedge(e_lt, vlt, 0)
            clt_top = CAD_Topo.MakeCoedge(e_lt, vlt, 1)
            CAD_Topo.LinkTwins(clt_w, clt_top)
            CAD_Store.Write(e_lt, 3, clt_w)
            CAD_Store.Write(e_lt, 4, clt_top)
            cps_u = CAD_Topo.MakeCoedge(e_ps, vsb, 1)
            cps_d = CAD_Topo.MakeCoedge(e_ps, vsm, 0)
            CAD_Topo.LinkTwins(cps_u, cps_d)
            CAD_Store.Write(e_ps, 3, cps_u)
            CAD_Store.Write(e_ps, 4, cps_d)
            cls_u = CAD_Topo.MakeCoedge(e_ls, vlb, 1)
            cls_d = CAD_Topo.MakeCoedge(e_ls, vlt, 0)
            CAD_Topo.LinkTwins(cls_u, cls_d)
            CAD_Store.Write(e_ls, 3, cls_u)
            CAD_Store.Write(e_ls, 4, cls_d)
            // floor plane at zf
            ArraySet(pt, 0, hx)
            ArraySet(pt, 1, hy)
            ArraySet(pt, 2, zf)
            ArraySet(ax, 0, one)
            ArraySet(ax, 1, zro)
            ArraySet(ax, 2, zro)
            ArraySet(ay, 0, zro)
            ArraySet(ay, 1, one)
            ArraySet(ay, 2, zro)
            pl_fl = CAD_Geom.MakePlaneAxes(pt, ax, ay)
            // BOTTOM outer + pilot
            ArraySet(ring, 0, c01b)
            ArraySet(ring, 1, c12b)
            ArraySet(ring, 2, c23b)
            ArraySet(ring, 3, c30b)
            lp_bo = CAD_Topo.MakeLoop(c01b)
            CAD_Topo.LinkLoopRing(ring, 4, lp_bo)
            ArraySet(ring, 0, csb_bot)
            lp_bi = CAD_Topo.MakeLoop(csb_bot)
            CAD_Topo.LinkLoopRing(ring, 1, lp_bi)
            CAD_Store.Write(lp_bo, 2, lp_bi)
            f_bot = CAD_Topo.MakeFace(pl_bot, lp_bo)
            // TOP outer + large only
            ArraySet(ring, 0, c45t)
            ArraySet(ring, 1, c56t)
            ArraySet(ring, 2, c67t)
            ArraySet(ring, 3, c74t)
            lp_to = CAD_Topo.MakeLoop(c45t)
            CAD_Topo.LinkLoopRing(ring, 4, lp_to)
            ArraySet(ring, 0, clt_top)
            lp_ti = CAD_Topo.MakeLoop(clt_top)
            CAD_Topo.LinkLoopRing(ring, 1, lp_ti)
            CAD_Store.Write(lp_to, 2, lp_ti)
            f_top = CAD_Topo.MakeFace(pl_top, lp_to)
            // sides
            ArraySet(ring, 0, c01s)
            ArraySet(ring, 1, c15u)
            ArraySet(ring, 2, c45s)
            ArraySet(ring, 3, c04d)
            lp_s0 = CAD_Topo.MakeLoop(c01s)
            CAD_Topo.LinkLoopRing(ring, 4, lp_s0)
            f_s0 = CAD_Topo.MakeFace(pl_y0, lp_s0)
            ArraySet(ring, 0, c12s)
            ArraySet(ring, 1, c26u)
            ArraySet(ring, 2, c56s)
            ArraySet(ring, 3, c15d)
            lp_s1 = CAD_Topo.MakeLoop(c12s)
            CAD_Topo.LinkLoopRing(ring, 4, lp_s1)
            f_s1 = CAD_Topo.MakeFace(pl_x1, lp_s1)
            ArraySet(ring, 0, c23s)
            ArraySet(ring, 1, c37u)
            ArraySet(ring, 2, c67s)
            ArraySet(ring, 3, c26d)
            lp_s2 = CAD_Topo.MakeLoop(c23s)
            CAD_Topo.LinkLoopRing(ring, 4, lp_s2)
            f_s2 = CAD_Topo.MakeFace(pl_y1, lp_s2)
            ArraySet(ring, 0, c30s)
            ArraySet(ring, 1, c04u)
            ArraySet(ring, 2, c74s)
            ArraySet(ring, 3, c37d)
            lp_s3 = CAD_Topo.MakeLoop(c30s)
            CAD_Topo.LinkLoopRing(ring, 4, lp_s3)
            f_s3 = CAD_Topo.MakeFace(pl_x0, lp_s3)
            // floor annulus
            ArraySet(ring, 0, clf_fl)
            lp_fo = CAD_Topo.MakeLoop(clf_fl)
            CAD_Topo.LinkLoopRing(ring, 1, lp_fo)
            ArraySet(ring, 0, csm_fl)
            lp_fi = CAD_Topo.MakeLoop(csm_fl)
            CAD_Topo.LinkLoopRing(ring, 1, lp_fi)
            CAD_Store.Write(lp_fo, 2, lp_fi)
            f_fl = CAD_Topo.MakeFace(pl_fl, lp_fo)
            // pilot wall 0..zf
            ArraySet(ring, 0, csb_w)
            ArraySet(ring, 1, cps_u)
            ArraySet(ring, 2, csm_w)
            ArraySet(ring, 3, cps_d)
            lp_pw = CAD_Topo.MakeLoop(csb_w)
            CAD_Topo.LinkLoopRing(ring, 4, lp_pw)
            f_pw = CAD_Topo.MakeFace(cyl_s, lp_pw)
            // large wall zf..dz
            ArraySet(ring, 0, clf_w)
            ArraySet(ring, 1, cls_u)
            ArraySet(ring, 2, clt_w)
            ArraySet(ring, 3, cls_d)
            lp_lw = CAD_Topo.MakeLoop(clf_w)
            CAD_Topo.LinkLoopRing(ring, 4, lp_lw)
            f_lw = CAD_Topo.MakeFace(cyl_l, lp_lw)
            // chain faces
            CAD_Store.Write(f_bot, 3, f_top)
            CAD_Store.Write(f_top, 3, f_s0)
            CAD_Store.Write(f_s0, 3, f_s1)
            CAD_Store.Write(f_s1, 3, f_s2)
            CAD_Store.Write(f_s2, 3, f_s3)
            CAD_Store.Write(f_s3, 3, f_fl)
            CAD_Store.Write(f_fl, 3, f_pw)
            CAD_Store.Write(f_pw, 3, f_lw)
            CAD_Store.Write(f_lw, 3, 0)
            h_sh = CAD_Topo.MakeShell(f_bot)
            ff = f_bot
            fguard = 0
            WhileLoop NotEqual(ff, 0) {
                CAD_Store.Write(ff, 2, h_sh)
                ff = CAD_Store.Read(ff, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 32) ThenBlock: { ff = 0 }
            }
            CAD_Store.Write(solid_handle, 0, h_sh)
            CAD_Store.Write(h_sh, 1, solid_handle)
            Deallocate(hr_a, 64)
            Deallocate(cx_a, 64)
            Deallocate(cy_a, 64)
            Deallocate(dep_a, 64)
            Deallocate(zf_a, 64)
            Deallocate(thr_a, 64)
            Deallocate(top_in, 64)
            Deallocate(bot_in, 64)
            Deallocate(face_list, 128)
            Deallocate(pt, 32)
            Deallocate(p1b, 32)
            Deallocate(ax, 32)
            Deallocate(ay, 32)
            Deallocate(frame, 128)
            Deallocate(ring, 128)
            ReturnValue(0)
        }

        // ----- INDEPENDENT HOLES (nh >= 1) -----
        // per-hole wall/floor faces chained after sides
        first_extra = 0
        prev_extra = 0
        hi = 0
        WhileLoop LessThan(hi, nh) {
            hr = ArrayGet(hr_a, hi)
            hcx = Float_Add(ox, ArrayGet(cx_a, hi))
            hcy = Float_Add(oy, ArrayGet(cy_a, hi))
            zf = ArrayGet(zf_a, hi)
            thr = ArrayGet(thr_a, hi)
            ArraySet(pt, 0, Float_Add(hcx, hr))
            ArraySet(pt, 1, hcy)
            ArraySet(pt, 2, zf)
            vsb = CAD_Topo.MakeVertex(pt)
            ArraySet(pt, 2, dz)
            vst = CAD_Topo.MakeVertex(pt)
            ArraySet(frame, 0, hcx)
            ArraySet(frame, 1, hcy)
            ArraySet(frame, 2, zf)
            ArraySet(frame, 3, one)
            ArraySet(frame, 4, zro)
            ArraySet(frame, 5, zro)
            ArraySet(frame, 6, zro)
            ArraySet(frame, 7, one)
            ArraySet(frame, 8, zro)
            ArraySet(frame, 9, zro)
            ArraySet(frame, 10, zro)
            ArraySet(frame, 11, one)
            circ_b = CAD_Geom.MakeCircle(frame, hr)
            ArraySet(frame, 2, dz)
            circ_t = CAD_Geom.MakeCircle(frame, hr)
            ArraySet(frame, 2, zf)
            cyl_s = CAD_Geom.MakeCylinderSurf(frame, hr)
            ArraySet(pt, 0, Float_Add(hcx, hr))
            ArraySet(pt, 1, hcy)
            ArraySet(pt, 2, zf)
            ArraySet(p1b, 0, Float_Add(hcx, hr))
            ArraySet(p1b, 1, hcy)
            ArraySet(p1b, 2, dz)
            e_seam = CAD_Topo.MakeEdge(vsb, vst, CAD_Geom.MakeLine(pt, p1b))
            e_cb = CAD_Topo.MakeEdge(vsb, vsb, circ_b)
            e_ct = CAD_Topo.MakeEdge(vst, vst, circ_t)
            ccb_face = CAD_Topo.MakeCoedge(e_cb, vsb, 0)
            ccb_wall = CAD_Topo.MakeCoedge(e_cb, vsb, 1)
            CAD_Topo.LinkTwins(ccb_face, ccb_wall)
            CAD_Store.Write(e_cb, 3, ccb_face)
            CAD_Store.Write(e_cb, 4, ccb_wall)
            cct_top = CAD_Topo.MakeCoedge(e_ct, vst, 1)
            cct_wall = CAD_Topo.MakeCoedge(e_ct, vst, 0)
            CAD_Topo.LinkTwins(cct_top, cct_wall)
            CAD_Store.Write(e_ct, 3, cct_top)
            CAD_Store.Write(e_ct, 4, cct_wall)
            cs_up = CAD_Topo.MakeCoedge(e_seam, vsb, 1)
            cs_dn = CAD_Topo.MakeCoedge(e_seam, vst, 0)
            CAD_Topo.LinkTwins(cs_up, cs_dn)
            CAD_Store.Write(e_seam, 3, cs_up)
            CAD_Store.Write(e_seam, 4, cs_dn)
            ArraySet(top_in, hi, cct_top)
            // through: bottom opening uses floor circle at z=0 (= zf)
            IfCondition EqualTo(thr, 1) ThenBlock: {
                ArraySet(bot_in, n_bot_in, ccb_face)
                n_bot_in = Add(n_bot_in, 1)
            }
            // wall face
            ArraySet(ring, 0, ccb_wall)
            ArraySet(ring, 1, cs_up)
            ArraySet(ring, 2, cct_wall)
            ArraySet(ring, 3, cs_dn)
            lp_w = CAD_Topo.MakeLoop(ccb_wall)
            CAD_Topo.LinkLoopRing(ring, 4, lp_w)
            f_w = CAD_Topo.MakeFace(cyl_s, lp_w)
            IfCondition EqualTo(first_extra, 0) ThenBlock: { first_extra = f_w }
            IfCondition NotEqual(prev_extra, 0) ThenBlock: {
                CAD_Store.Write(prev_extra, 3, f_w)
            }
            prev_extra = f_w
            // blind floor disk
            IfCondition EqualTo(thr, 0) ThenBlock: {
                ArraySet(pt, 0, hcx)
                ArraySet(pt, 1, hcy)
                ArraySet(pt, 2, zf)
                ArraySet(ax, 0, one)
                ArraySet(ax, 1, zro)
                ArraySet(ax, 2, zro)
                ArraySet(ay, 0, zro)
                ArraySet(ay, 1, one)
                ArraySet(ay, 2, zro)
                pl_f = CAD_Geom.MakePlaneAxes(pt, ax, ay)
                // floor uses same circle edge - need coedge for floor
                cfl = CAD_Topo.MakeCoedge(e_cb, vsb, 0)
                // already have ccb_face as twin of wall - use ccb_face for floor
                ArraySet(ring, 0, ccb_face)
                lp_f = CAD_Topo.MakeLoop(ccb_face)
                CAD_Topo.LinkLoopRing(ring, 1, lp_f)
                f_f = CAD_Topo.MakeFace(pl_f, lp_f)
                CAD_Store.Write(prev_extra, 3, f_f)
                prev_extra = f_f
            }
            hi = Add(hi, 1)
        }
        IfCondition NotEqual(prev_extra, 0) ThenBlock: {
            CAD_Store.Write(prev_extra, 3, 0)
        }

        // BOTTOM
        ArraySet(ring, 0, c01b)
        ArraySet(ring, 1, c12b)
        ArraySet(ring, 2, c23b)
        ArraySet(ring, 3, c30b)
        lp_bo = CAD_Topo.MakeLoop(c01b)
        CAD_Topo.LinkLoopRing(ring, 4, lp_bo)
        IfCondition GreaterThan(n_bot_in, 0) ThenBlock: {
            // chain through inners on bottom
            prev_l = lp_bo
            bi = 0
            WhileLoop LessThan(bi, n_bot_in) {
                ArraySet(ring, 0, ArrayGet(bot_in, bi))
                lp_i = CAD_Topo.MakeLoop(ArrayGet(bot_in, bi))
                CAD_Topo.LinkLoopRing(ring, 1, lp_i)
                CAD_Store.Write(prev_l, 2, lp_i)
                prev_l = lp_i
                bi = Add(bi, 1)
            }
        }
        f_bot = CAD_Topo.MakeFace(pl_bot, lp_bo)

        // TOP all hole openings
        ArraySet(ring, 0, c45t)
        ArraySet(ring, 1, c56t)
        ArraySet(ring, 2, c67t)
        ArraySet(ring, 3, c74t)
        lp_to = CAD_Topo.MakeLoop(c45t)
        CAD_Topo.LinkLoopRing(ring, 4, lp_to)
        prev_l = lp_to
        hi = 0
        WhileLoop LessThan(hi, nh) {
            ArraySet(ring, 0, ArrayGet(top_in, hi))
            lp_i = CAD_Topo.MakeLoop(ArrayGet(top_in, hi))
            CAD_Topo.LinkLoopRing(ring, 1, lp_i)
            CAD_Store.Write(prev_l, 2, lp_i)
            prev_l = lp_i
            hi = Add(hi, 1)
        }
        f_top = CAD_Topo.MakeFace(pl_top, lp_to)

        // sides
        ArraySet(ring, 0, c01s)
        ArraySet(ring, 1, c15u)
        ArraySet(ring, 2, c45s)
        ArraySet(ring, 3, c04d)
        lp_s0 = CAD_Topo.MakeLoop(c01s)
        CAD_Topo.LinkLoopRing(ring, 4, lp_s0)
        f_s0 = CAD_Topo.MakeFace(pl_y0, lp_s0)
        ArraySet(ring, 0, c12s)
        ArraySet(ring, 1, c26u)
        ArraySet(ring, 2, c56s)
        ArraySet(ring, 3, c15d)
        lp_s1 = CAD_Topo.MakeLoop(c12s)
        CAD_Topo.LinkLoopRing(ring, 4, lp_s1)
        f_s1 = CAD_Topo.MakeFace(pl_x1, lp_s1)
        ArraySet(ring, 0, c23s)
        ArraySet(ring, 1, c37u)
        ArraySet(ring, 2, c67s)
        ArraySet(ring, 3, c26d)
        lp_s2 = CAD_Topo.MakeLoop(c23s)
        CAD_Topo.LinkLoopRing(ring, 4, lp_s2)
        f_s2 = CAD_Topo.MakeFace(pl_y1, lp_s2)
        ArraySet(ring, 0, c30s)
        ArraySet(ring, 1, c04u)
        ArraySet(ring, 2, c74s)
        ArraySet(ring, 3, c37d)
        lp_s3 = CAD_Topo.MakeLoop(c30s)
        CAD_Topo.LinkLoopRing(ring, 4, lp_s3)
        f_s3 = CAD_Topo.MakeFace(pl_x0, lp_s3)

        CAD_Store.Write(f_bot, 3, f_top)
        CAD_Store.Write(f_top, 3, f_s0)
        CAD_Store.Write(f_s0, 3, f_s1)
        CAD_Store.Write(f_s1, 3, f_s2)
        CAD_Store.Write(f_s2, 3, f_s3)
        IfCondition EqualTo(first_extra, 0) ThenBlock: {
            CAD_Store.Write(f_s3, 3, 0)
        }
        IfCondition NotEqual(first_extra, 0) ThenBlock: {
            CAD_Store.Write(f_s3, 3, first_extra)
        }
        h_sh = CAD_Topo.MakeShell(f_bot)
        ff = f_bot
        fguard = 0
        WhileLoop NotEqual(ff, 0) {
            CAD_Store.Write(ff, 2, h_sh)
            ff = CAD_Store.Read(ff, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 64) ThenBlock: { ff = 0 }
        }
        CAD_Store.Write(solid_handle, 0, h_sh)
        CAD_Store.Write(h_sh, 1, solid_handle)

        Deallocate(hr_a, 64)
        Deallocate(cx_a, 64)
        Deallocate(cy_a, 64)
        Deallocate(dep_a, 64)
        Deallocate(zf_a, 64)
        Deallocate(thr_a, 64)
        Deallocate(top_in, 64)
        Deallocate(bot_in, 64)
        Deallocate(face_list, 128)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(frame, 128)
        Deallocate(ring, 128)
        ReturnValue(0)
    }
}

// Back-compat name
Function.CAD_Topo.BuildPlateThroughHoleShell {
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        ReturnValue(CAD_Topo.BuildPlateHoleShell(solid_handle))
    }
}

// Append hole to kind-3 plate. pack: [r, cx, cy, depth] in plate-local XY.
// Max 5 holes. Returns new solid handle or 0.
Function.CAD_Topo.AppendBoxHole {
    Input: solid_handle: Integer
    Input: pack_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(solid_handle, 3), 3) ThenBlock: { ReturnValue(0) }
        ph0 = CAD_Store.Read(solid_handle, 1)
        nh = CAD_Store.Read(ph0, 9)
        IfCondition EqualTo(nh, 0) ThenBlock: { nh = 1 }
        IfCondition GreaterEqual(nh, 5) ThenBlock: { ReturnValue(0) }
        hr = ArrayGet(pack_addr, 0)
        cx = ArrayGet(pack_addr, 1)
        cy = ArrayGet(pack_addr, 2)
        hdep = ArrayGet(pack_addr, 3)
        dz_r = CAD_Store.Read(ph0, 2)
        IfCondition EqualTo(CAD_Num.IsZero(hr, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(hdep, 0), 1) ThenBlock: { hdep = dz_r }
        IfCondition EqualTo(Float_Le(dz_r, hdep), 1) ThenBlock: { hdep = dz_r }
        ph = CAD_Store.Alloc(13, 26)
        IfCondition EqualTo(ph, 0) ThenBlock: { ReturnValue(0) }
        // copy plate + existing holes
        si = 0
        WhileLoop LessThan(si, 26) {
            CAD_Store.Write(ph, si, CAD_Store.Read(ph0, si))
            si = Add(si, 1)
        }
        // append at hole index nh (0→ fields 3/4/5/8; ≥1 → 10+4*(i-1))
        IfCondition EqualTo(nh, 0) ThenBlock: {
            CAD_Store.Write(ph, 3, hr)
            CAD_Store.Write(ph, 4, cx)
            CAD_Store.Write(ph, 5, cy)
            CAD_Store.Write(ph, 8, hdep)
        }
        IfCondition GreaterThan(nh, 0) ThenBlock: {
            base = Add(10, Multiply(Subtract(nh, 1), 4))
            CAD_Store.Write(ph, base, hr)
            CAD_Store.Write(ph, Add(base, 1), cx)
            CAD_Store.Write(ph, Add(base, 2), cy)
            CAD_Store.Write(ph, Add(base, 3), hdep)
        }
        CAD_Store.Write(ph, 9, Add(nh, 1))
        h_so = CAD_Store.Alloc(7, 4)
        IfCondition EqualTo(h_so, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h_so, 0, 0)
        CAD_Store.Write(h_so, 1, ph)
        CAD_Store.Write(h_so, 2, CAD_Store.Read(solid_handle, 2))
        CAD_Store.Write(h_so, 3, 3)
        // rebuild full plate+holes shell (multi/blind/nested) — export walks this
        CAD_Topo.BuildPlateHoleShell(h_so)
        CAD_Topo_State.solid_count = Add(CAD_Topo_State.solid_count, 1)
        ArraySet(out_solid_addr, 0, h_so)
        ReturnValue(h_so)
    }
}

// Exact sphere B-Rep (walkable): SPHERICAL_SURFACE + two hemispheres.
// Equator CIRCLE edge is shared (twins); north/south faces bound the solid.
// Not a STEP recipe — Export walks shell and emits SPHERICAL_SURFACE.
Function.CAD_Topo.MakeSphereSolid {
    Input: radius_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(radius_r, 0), 1) ThenBlock: { ReturnValue(0) }
        one = 0x3FF0000000000000
        zro = 0
        pt = Allocate(32)
        frame = Allocate(128)
        ring = Allocate(64)

        // Seam vertex on equator +X
        ArraySet(pt, 0, radius_r)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        ve = CAD_Topo.MakeVertex(pt)

        // Equator circle in XY about origin
        ArraySet(frame, 0, zro)
        ArraySet(frame, 1, zro)
        ArraySet(frame, 2, zro)
        ArraySet(frame, 3, one)
        ArraySet(frame, 4, zro)
        ArraySet(frame, 5, zro)
        ArraySet(frame, 6, zro)
        ArraySet(frame, 7, one)
        ArraySet(frame, 8, zro)
        circ_eq = CAD_Geom.MakeCircle(frame, radius_r)

        // Spherical surface at origin
        ArraySet(pt, 0, zro)
        ArraySet(pt, 1, zro)
        ArraySet(pt, 2, zro)
        sph = CAD_Geom.MakeSphereSurf(pt, radius_r)

        // Closed equator edge
        ee = CAD_Topo.MakeEdge(ve, ve, circ_eq)
        ce_n = CAD_Topo.MakeCoedge(ee, ve, 1)
        ce_s = CAD_Topo.MakeCoedge(ee, ve, 0)
        CAD_Topo.LinkTwins(ce_n, ce_s)
        CAD_Store.Write(ee, 3, ce_n)
        CAD_Store.Write(ee, 4, ce_s)

        // North hemisphere (outer bound = equator)
        ArraySet(ring, 0, ce_n)
        lp_n = CAD_Topo.MakeLoop(ce_n)
        CAD_Topo.LinkLoopRing(ring, 1, lp_n)
        f_n = CAD_Topo.MakeFace(sph, lp_n)

        // South hemisphere (reverse equator)
        ArraySet(ring, 0, ce_s)
        lp_s = CAD_Topo.MakeLoop(ce_s)
        CAD_Topo.LinkLoopRing(ring, 1, lp_s)
        f_s = CAD_Topo.MakeFace(sph, lp_s)

        CAD_Store.Write(f_n, 3, f_s)
        CAD_Store.Write(f_s, 3, 0)
        h_sh = CAD_Topo.MakeShell(f_n)
        CAD_Store.Write(f_n, 2, h_sh)
        CAD_Store.Write(f_s, 2, h_sh)

        ph = CAD_Store.Alloc(13, 8)
        IfCondition EqualTo(ph, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(ph, 0, radius_r)
        CAD_Store.Write(ph, 1, zro)
        CAD_Store.Write(ph, 2, zro)
        CAD_Store.Write(ph, 3, zro)
        CAD_Store.Write(ph, 4, 0)
        CAD_Store.Write(ph, 5, 0)
        CAD_Store.Write(ph, 6, 0)
        CAD_Store.Write(ph, 7, 0)

        h_so = CAD_Store.Alloc(7, 4)
        IfCondition EqualTo(h_so, 0) ThenBlock: { ReturnValue(0) }
        CAD_Store.Write(h_so, 0, h_sh)
        CAD_Store.Write(h_so, 1, ph)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 4)
        CAD_Store.Write(h_sh, 1, h_so)
        CAD_Topo_State.solid_count = Add(CAD_Topo_State.solid_count, 1)
        ArraySet(out_solid_addr, 0, h_so)

        Deallocate(pt, 32)
        Deallocate(frame, 128)
        Deallocate(ring, 64)
        ReturnValue(h_so)
    }
}


// Axis-aligned rectangular pocket cut from top of a box [0,dx]x[0,dy]x[0,dz].
// pack: [dx,dy,dz, px0,py0,px1,py1, depth]  depth from top; depth>=dz ⇒ through.
// Result kind 0 solid with full shell (walk STEP — not a recipe).
// Returns solid handle or 0.
