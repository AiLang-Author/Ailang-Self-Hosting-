LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.MakeTriangleSolid {
    Input: pts_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        p0 = Allocate(32)
        p1 = Allocate(32)
        p2 = Allocate(32)
        ArraySet(p0, 0, ArrayGet(pts_addr, 0))
        ArraySet(p0, 1, ArrayGet(pts_addr, 1))
        ArraySet(p0, 2, ArrayGet(pts_addr, 2))
        ArraySet(p1, 0, ArrayGet(pts_addr, 3))
        ArraySet(p1, 1, ArrayGet(pts_addr, 4))
        ArraySet(p1, 2, ArrayGet(pts_addr, 5))
        ArraySet(p2, 0, ArrayGet(pts_addr, 6))
        ArraySet(p2, 1, ArrayGet(pts_addr, 7))
        ArraySet(p2, 2, ArrayGet(pts_addr, 8))

        v0 = CAD_Topo.MakeVertex(p0)
        v1 = CAD_Topo.MakeVertex(p1)
        v2 = CAD_Topo.MakeVertex(p2)

        e01 = CAD_Topo.MakeEdge(v0, v1, 0)
        e12 = CAD_Topo.MakeEdge(v1, v2, 0)
        e20 = CAD_Topo.MakeEdge(v2, v0, 0)

        // outer coedges around face (CCW): 0->1->2->0
        c01 = CAD_Topo.MakeCoedge(e01, v0, 1)
        c12 = CAD_Topo.MakeCoedge(e12, v1, 1)
        c20 = CAD_Topo.MakeCoedge(e20, v2, 1)
        // mates (opposite sense)
        c10 = CAD_Topo.MakeCoedge(e01, v1, 0)
        c21 = CAD_Topo.MakeCoedge(e12, v2, 0)
        c02 = CAD_Topo.MakeCoedge(e20, v0, 0)
        CAD_Topo.LinkTwins(c01, c10)
        CAD_Topo.LinkTwins(c12, c21)
        CAD_Topo.LinkTwins(c20, c02)

        CAD_Store.Write(e01, 3, c01)
        CAD_Store.Write(e01, 4, c10)
        CAD_Store.Write(e12, 3, c12)
        CAD_Store.Write(e12, 4, c21)
        CAD_Store.Write(e20, 3, c20)
        CAD_Store.Write(e20, 4, c02)

        ring = Allocate(32)
        ArraySet(ring, 0, c01)
        ArraySet(ring, 1, c12)
        ArraySet(ring, 2, c20)
        h_l = CAD_Topo.MakeLoop(c01)
        CAD_Topo.LinkLoopRing(ring, 3, h_l)

        h_f = CAD_Topo.MakeFace(0, h_l)
        h_sh = CAD_Topo.MakeShell(h_f)
        h_so = CAD_Topo.MakeSolid(h_sh)

        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(p0, 32)
        Deallocate(p1, 32)
        Deallocate(p2, 32)
        Deallocate(ring, 32)
        ReturnValue(h_so)
    }
}

// Axis-aligned box [min,max]. Closed: V=8 E=12 F=6 → Euler 2.
// Outward face loops; each coedge used exactly once.
Function.CAD_Topo.MakeBoxSolid {
    Input: min_addr: Address
    Input: max_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        x0 = ArrayGet(min_addr, 0)
        y0 = ArrayGet(min_addr, 1)
        z0 = ArrayGet(min_addr, 2)
        x1 = ArrayGet(max_addr, 0)
        y1 = ArrayGet(max_addr, 1)
        z1 = ArrayGet(max_addr, 2)

        pt = Allocate(32)
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        v0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v3 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z1)
        v4 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        v5 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        v6 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        v7 = CAD_Topo.MakeVertex(pt)

        // Line curves between box corners (p0, p1 scratch in pt / p1b)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)

        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z0)
        ln01 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        ln12 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        ln23 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        ln30 = CAD_Geom.MakeLine(pt, p1b)

        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z1)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z1)
        ln45 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        ln56 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        ln67 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        ln74 = CAD_Geom.MakeLine(pt, p1b)

        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(p1b, 0, x0)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z1)
        ln04 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 0, x1)
        ln15 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 1, y1)
        ln26 = CAD_Geom.MakeLine(pt, p1b)
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 0, x0)
        ln37 = CAD_Geom.MakeLine(pt, p1b)

        e01 = CAD_Topo.MakeEdge(v0, v1, ln01)
        e12 = CAD_Topo.MakeEdge(v1, v2, ln12)
        e23 = CAD_Topo.MakeEdge(v2, v3, ln23)
        e30 = CAD_Topo.MakeEdge(v3, v0, ln30)
        e45 = CAD_Topo.MakeEdge(v4, v5, ln45)
        e56 = CAD_Topo.MakeEdge(v5, v6, ln56)
        e67 = CAD_Topo.MakeEdge(v6, v7, ln67)
        e74 = CAD_Topo.MakeEdge(v7, v4, ln74)
        e04 = CAD_Topo.MakeEdge(v0, v4, ln04)
        e15 = CAD_Topo.MakeEdge(v1, v5, ln15)
        e26 = CAD_Topo.MakeEdge(v2, v6, ln26)
        e37 = CAD_Topo.MakeEdge(v3, v7, ln37)

        c01 = CAD_Topo.MakeCoedge(e01, v0, 1)
        c10 = CAD_Topo.MakeCoedge(e01, v1, 0)
        CAD_Topo.LinkTwins(c01, c10)
        CAD_Store.Write(e01, 3, c01)
        CAD_Store.Write(e01, 4, c10)
        c12 = CAD_Topo.MakeCoedge(e12, v1, 1)
        c21 = CAD_Topo.MakeCoedge(e12, v2, 0)
        CAD_Topo.LinkTwins(c12, c21)
        CAD_Store.Write(e12, 3, c12)
        CAD_Store.Write(e12, 4, c21)
        c23 = CAD_Topo.MakeCoedge(e23, v2, 1)
        c32 = CAD_Topo.MakeCoedge(e23, v3, 0)
        CAD_Topo.LinkTwins(c23, c32)
        CAD_Store.Write(e23, 3, c23)
        CAD_Store.Write(e23, 4, c32)
        c30 = CAD_Topo.MakeCoedge(e30, v3, 1)
        c03 = CAD_Topo.MakeCoedge(e30, v0, 0)
        CAD_Topo.LinkTwins(c30, c03)
        CAD_Store.Write(e30, 3, c30)
        CAD_Store.Write(e30, 4, c03)
        c45 = CAD_Topo.MakeCoedge(e45, v4, 1)
        c54 = CAD_Topo.MakeCoedge(e45, v5, 0)
        CAD_Topo.LinkTwins(c45, c54)
        CAD_Store.Write(e45, 3, c45)
        CAD_Store.Write(e45, 4, c54)
        c56 = CAD_Topo.MakeCoedge(e56, v5, 1)
        c65 = CAD_Topo.MakeCoedge(e56, v6, 0)
        CAD_Topo.LinkTwins(c56, c65)
        CAD_Store.Write(e56, 3, c56)
        CAD_Store.Write(e56, 4, c65)
        c67 = CAD_Topo.MakeCoedge(e67, v6, 1)
        c76 = CAD_Topo.MakeCoedge(e67, v7, 0)
        CAD_Topo.LinkTwins(c67, c76)
        CAD_Store.Write(e67, 3, c67)
        CAD_Store.Write(e67, 4, c76)
        c74 = CAD_Topo.MakeCoedge(e74, v7, 1)
        c47 = CAD_Topo.MakeCoedge(e74, v4, 0)
        CAD_Topo.LinkTwins(c74, c47)
        CAD_Store.Write(e74, 3, c74)
        CAD_Store.Write(e74, 4, c47)
        c04 = CAD_Topo.MakeCoedge(e04, v0, 1)
        c40 = CAD_Topo.MakeCoedge(e04, v4, 0)
        CAD_Topo.LinkTwins(c04, c40)
        CAD_Store.Write(e04, 3, c04)
        CAD_Store.Write(e04, 4, c40)
        c15 = CAD_Topo.MakeCoedge(e15, v1, 1)
        c51 = CAD_Topo.MakeCoedge(e15, v5, 0)
        CAD_Topo.LinkTwins(c15, c51)
        CAD_Store.Write(e15, 3, c15)
        CAD_Store.Write(e15, 4, c51)
        c26 = CAD_Topo.MakeCoedge(e26, v2, 1)
        c62 = CAD_Topo.MakeCoedge(e26, v6, 0)
        CAD_Topo.LinkTwins(c26, c62)
        CAD_Store.Write(e26, 3, c26)
        CAD_Store.Write(e26, 4, c62)
        c37 = CAD_Topo.MakeCoedge(e37, v3, 1)
        c73 = CAD_Topo.MakeCoedge(e37, v7, 0)
        CAD_Topo.LinkTwins(c37, c73)
        CAD_Store.Write(e37, 3, c37)
        CAD_Store.Write(e37, 4, c73)

        ring = Allocate(64)
        one = 0x3FF0000000000000
        neg1 = 0xBFF0000000000000
        zro = 0x0000000000000000

        // bot -Z outward: O=(x0,y0,z0) X=+X Y=-Y → N=-Z
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        s0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c03)
        ArraySet(ring, 1, c32)
        ArraySet(ring, 2, c21)
        ArraySet(ring, 3, c10)
        l0 = CAD_Topo.MakeLoop(c03)
        CAD_Topo.LinkLoopRing(ring, 4, l0)
        f0 = CAD_Topo.MakeFace(s0, l0)

        // top +Z: O=(x0,y0,z1) X=+X Y=+Y → N=+Z
        ArraySet(pt, 2, z1)
        ArraySet(ay, 1, one)
        s1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c45)
        ArraySet(ring, 1, c56)
        ArraySet(ring, 2, c67)
        ArraySet(ring, 3, c74)
        l1 = CAD_Topo.MakeLoop(c45)
        CAD_Topo.LinkLoopRing(ring, 4, l1)
        f1 = CAD_Topo.MakeFace(s1, l1)

        // front -Y: O=(x0,y0,z0) X=+X Y=+Z → N=-Y
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        s2 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c01)
        ArraySet(ring, 1, c15)
        ArraySet(ring, 2, c54)
        ArraySet(ring, 3, c40)
        l2 = CAD_Topo.MakeLoop(c01)
        CAD_Topo.LinkLoopRing(ring, 4, l2)
        f2 = CAD_Topo.MakeFace(s2, l2)

        // back +Y: O=(x0,y1,z0) X=-X Y=+Z → N=+Y
        ArraySet(pt, 1, y1)
        ArraySet(ax, 0, neg1)
        s3 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c37)
        ArraySet(ring, 1, c76)
        ArraySet(ring, 2, c62)
        ArraySet(ring, 3, c23)
        l3 = CAD_Topo.MakeLoop(c37)
        CAD_Topo.LinkLoopRing(ring, 4, l3)
        f3 = CAD_Topo.MakeFace(s3, l3)

        // left -X: O=(x0,y0,z0) X=-Y Y=+Z → N=-X
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(ax, 0, zro)
        ArraySet(ax, 1, neg1)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        s4 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c04)
        ArraySet(ring, 1, c47)
        ArraySet(ring, 2, c73)
        ArraySet(ring, 3, c30)
        l4 = CAD_Topo.MakeLoop(c04)
        CAD_Topo.LinkLoopRing(ring, 4, l4)
        f4 = CAD_Topo.MakeFace(s4, l4)

        // right +X: O=(x1,y0,z0) X=+Y Y=+Z → N=+X
        ArraySet(pt, 0, x1)
        ArraySet(ax, 1, one)
        s5 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c12)
        ArraySet(ring, 1, c26)
        ArraySet(ring, 2, c65)
        ArraySet(ring, 3, c51)
        l5 = CAD_Topo.MakeLoop(c12)
        CAD_Topo.LinkLoopRing(ring, 4, l5)
        f5 = CAD_Topo.MakeFace(s5, l5)

        CAD_Store.Write(f0, 3, f1)
        CAD_Store.Write(f1, 3, f2)
        CAD_Store.Write(f2, 3, f3)
        CAD_Store.Write(f3, 3, f4)
        CAD_Store.Write(f4, 3, f5)
        CAD_Store.Write(f5, 3, 0)

        h_sh = CAD_Topo.MakeShell(f0)
        CAD_Store.Write(f1, 2, h_sh)
        CAD_Store.Write(f2, 2, h_sh)
        CAD_Store.Write(f3, 2, h_sh)
        CAD_Store.Write(f4, 2, h_sh)
        CAD_Store.Write(f5, 2, h_sh)

        h_so = CAD_Topo.MakeSolid(h_sh)
        // kind 0 = general poly (walk STEP)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 64)
        ReturnValue(h_so)
    }
}

// Right triangular prism (wedge): apex (0,0), base corners (x1,0) and (x2,y2),
// height hz. Top is a plane triangle — digon fillet of its 3 edges exercises
// non-ortho dihedrals (e.g. 31° at apex). V=6 E=9 F=5 → Euler 2.
Function.CAD_Topo.MakeWedgePrism {
    Input: x1_r: Integer
    Input: x2_r: Integer
    Input: y2_r: Integer
    Input: hz_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(64)
        one = 0x3FF0000000000000
        neg1 = 0xBFF0000000000000
        zro = 0
        // bottom triangle
        ArraySet(pt, 0, 0)
        ArraySet(pt, 1, 0)
        ArraySet(pt, 2, 0)
        v0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1_r)
        v1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x2_r)
        ArraySet(pt, 1, y2_r)
        v2 = CAD_Topo.MakeVertex(pt)
        // top
        ArraySet(pt, 0, 0)
        ArraySet(pt, 1, 0)
        ArraySet(pt, 2, hz_r)
        v3 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1_r)
        v4 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x2_r)
        ArraySet(pt, 1, y2_r)
        v5 = CAD_Topo.MakeVertex(pt)

        // lines + edges
        ArraySet(pt, 0, 0)
        ArraySet(pt, 1, 0)
        ArraySet(pt, 2, 0)
        ArraySet(p1b, 0, x1_r)
        ArraySet(p1b, 1, 0)
        ArraySet(p1b, 2, 0)
        e01 = CAD_Topo.MakeEdge(v0, v1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1_r)
        ArraySet(p1b, 0, x2_r)
        ArraySet(p1b, 1, y2_r)
        e12 = CAD_Topo.MakeEdge(v1, v2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x2_r)
        ArraySet(pt, 1, y2_r)
        ArraySet(p1b, 0, 0)
        ArraySet(p1b, 1, 0)
        e20 = CAD_Topo.MakeEdge(v2, v0, CAD_Geom.MakeLine(pt, p1b))

        ArraySet(pt, 0, 0)
        ArraySet(pt, 1, 0)
        ArraySet(pt, 2, hz_r)
        ArraySet(p1b, 0, x1_r)
        ArraySet(p1b, 1, 0)
        ArraySet(p1b, 2, hz_r)
        e34 = CAD_Topo.MakeEdge(v3, v4, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1_r)
        ArraySet(p1b, 0, x2_r)
        ArraySet(p1b, 1, y2_r)
        e45 = CAD_Topo.MakeEdge(v4, v5, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x2_r)
        ArraySet(pt, 1, y2_r)
        ArraySet(p1b, 0, 0)
        ArraySet(p1b, 1, 0)
        e53 = CAD_Topo.MakeEdge(v5, v3, CAD_Geom.MakeLine(pt, p1b))

        ArraySet(pt, 0, 0)
        ArraySet(pt, 1, 0)
        ArraySet(pt, 2, 0)
        ArraySet(p1b, 0, 0)
        ArraySet(p1b, 1, 0)
        ArraySet(p1b, 2, hz_r)
        e03 = CAD_Topo.MakeEdge(v0, v3, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1_r)
        ArraySet(p1b, 0, x1_r)
        e14 = CAD_Topo.MakeEdge(v1, v4, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x2_r)
        ArraySet(pt, 1, y2_r)
        ArraySet(p1b, 0, x2_r)
        ArraySet(p1b, 1, y2_r)
        e25 = CAD_Topo.MakeEdge(v2, v5, CAD_Geom.MakeLine(pt, p1b))

        // coedge pairs
        c01 = CAD_Topo.MakeCoedge(e01, v0, 1)
        c10 = CAD_Topo.MakeCoedge(e01, v1, 0)
        CAD_Topo.LinkTwins(c01, c10)
        CAD_Store.Write(e01, 3, c01)
        CAD_Store.Write(e01, 4, c10)
        c12 = CAD_Topo.MakeCoedge(e12, v1, 1)
        c21 = CAD_Topo.MakeCoedge(e12, v2, 0)
        CAD_Topo.LinkTwins(c12, c21)
        CAD_Store.Write(e12, 3, c12)
        CAD_Store.Write(e12, 4, c21)
        c20 = CAD_Topo.MakeCoedge(e20, v2, 1)
        c02 = CAD_Topo.MakeCoedge(e20, v0, 0)
        CAD_Topo.LinkTwins(c20, c02)
        CAD_Store.Write(e20, 3, c20)
        CAD_Store.Write(e20, 4, c02)
        c34 = CAD_Topo.MakeCoedge(e34, v3, 1)
        c43 = CAD_Topo.MakeCoedge(e34, v4, 0)
        CAD_Topo.LinkTwins(c34, c43)
        CAD_Store.Write(e34, 3, c34)
        CAD_Store.Write(e34, 4, c43)
        c45 = CAD_Topo.MakeCoedge(e45, v4, 1)
        c54 = CAD_Topo.MakeCoedge(e45, v5, 0)
        CAD_Topo.LinkTwins(c45, c54)
        CAD_Store.Write(e45, 3, c45)
        CAD_Store.Write(e45, 4, c54)
        c53 = CAD_Topo.MakeCoedge(e53, v5, 1)
        c35 = CAD_Topo.MakeCoedge(e53, v3, 0)
        CAD_Topo.LinkTwins(c53, c35)
        CAD_Store.Write(e53, 3, c53)
        CAD_Store.Write(e53, 4, c35)
        c03 = CAD_Topo.MakeCoedge(e03, v0, 1)
        c30 = CAD_Topo.MakeCoedge(e03, v3, 0)
        CAD_Topo.LinkTwins(c03, c30)
        CAD_Store.Write(e03, 3, c03)
        CAD_Store.Write(e03, 4, c30)
        c14 = CAD_Topo.MakeCoedge(e14, v1, 1)
        c41 = CAD_Topo.MakeCoedge(e14, v4, 0)
        CAD_Topo.LinkTwins(c14, c41)
        CAD_Store.Write(e14, 3, c14)
        CAD_Store.Write(e14, 4, c41)
        c25 = CAD_Topo.MakeCoedge(e25, v2, 1)
        c52 = CAD_Topo.MakeCoedge(e25, v5, 0)
        CAD_Topo.LinkTwins(c25, c52)
        CAD_Store.Write(e25, 3, c25)
        CAD_Store.Write(e25, 4, c52)

        // bot -Z: CW from above (v0→v2→v1)
        ArraySet(pt, 0, 0)
        ArraySet(pt, 1, 0)
        ArraySet(pt, 2, 0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        s0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c02)
        ArraySet(ring, 1, c21)
        ArraySet(ring, 2, c10)
        l0 = CAD_Topo.MakeLoop(c02)
        CAD_Topo.LinkLoopRing(ring, 3, l0)
        f0 = CAD_Topo.MakeFace(s0, l0)

        // top +Z: CCW from above (v3→v4→v5)
        ArraySet(pt, 2, hz_r)
        ArraySet(ay, 1, one)
        s1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c34)
        ArraySet(ring, 1, c45)
        ArraySet(ring, 2, c53)
        l1 = CAD_Topo.MakeLoop(c34)
        CAD_Topo.LinkLoopRing(ring, 3, l1)
        f1 = CAD_Topo.MakeFace(s1, l1)

        // side 0-1 (along +X axis edge): outward ~ -Y
        ArraySet(pt, 0, 0)
        ArraySet(pt, 1, 0)
        ArraySet(pt, 2, 0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        s2 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c01)
        ArraySet(ring, 1, c14)
        ArraySet(ring, 2, c43)
        ArraySet(ring, 3, c30)
        l2 = CAD_Topo.MakeLoop(c01)
        CAD_Topo.LinkLoopRing(ring, 4, l2)
        f2 = CAD_Topo.MakeFace(s2, l2)

        // side 1-2: plane through (x1,0,0) and (x2,y2,0); X along base edge, Y=+Z
        ArraySet(pt, 0, x1_r)
        ArraySet(pt, 1, 0)
        ArraySet(pt, 2, 0)
        ArraySet(ax, 0, Float_Sub(x2_r, x1_r))
        ArraySet(ax, 1, y2_r)
        ArraySet(ax, 2, zro)
        // normalize ax
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))))
        ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), ln))
        ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), ln))
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        s3 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c12)
        ArraySet(ring, 1, c25)
        ArraySet(ring, 2, c54)
        ArraySet(ring, 3, c41)
        l3 = CAD_Topo.MakeLoop(c12)
        CAD_Topo.LinkLoopRing(ring, 4, l3)
        f3 = CAD_Topo.MakeFace(s3, l3)

        // side 2-0: through (x2,y2) and origin; X along edge v2→v0, Y=+Z
        ArraySet(pt, 0, x2_r)
        ArraySet(pt, 1, y2_r)
        ArraySet(pt, 2, 0)
        ArraySet(ax, 0, Float_Sub(0, x2_r))
        ArraySet(ax, 1, Float_Sub(0, y2_r))
        ArraySet(ax, 2, zro)
        ln = CAD_Num.Sqrt(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))))
        ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), ln))
        ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), ln))
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        s4 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c20)
        ArraySet(ring, 1, c03)
        ArraySet(ring, 2, c35)
        ArraySet(ring, 3, c52)
        l4 = CAD_Topo.MakeLoop(c20)
        CAD_Topo.LinkLoopRing(ring, 4, l4)
        f4 = CAD_Topo.MakeFace(s4, l4)

        CAD_Store.Write(f0, 3, f1)
        CAD_Store.Write(f1, 3, f2)
        CAD_Store.Write(f2, 3, f3)
        CAD_Store.Write(f3, 3, f4)
        CAD_Store.Write(f4, 3, 0)
        h_sh = CAD_Topo.MakeShell(f0)
        CAD_Store.Write(f1, 2, h_sh)
        CAD_Store.Write(f2, 2, h_sh)
        CAD_Store.Write(f3, 2, h_sh)
        CAD_Store.Write(f4, 2, h_sh)
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 64)
        ReturnValue(h_so)
    }
}

// Extrude polygon in XY (n_pts verts, open: first≠last) to height hz.
// Max 2048 verts — dense tessellated multi-circle / freehand envelopes.
// Outward shells, kind 0. Handle buffers sized for 2048 entries (16KB each).
Function.CAD_Topo.MakePolyPrism {
    Input: xy_addr: Address
    Input: n_pts: Integer
    Input: hz_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        // pin ALL inputs into FixedPool before any nested call
        CAD_Topo_Prism.n = n_pts
        CAD_Topo_Prism.xy = xy_addr
        CAD_Topo_Prism.hz = hz_r
        CAD_Topo_Prism.out = out_solid_addr
        n0 = CAD_Topo_Prism.n
        // strip first==last closing duplicate (zero edge → earclip death)
        IfCondition GreaterThan(n0, 3) ThenBlock: {
            lx = ArrayGet(CAD_Topo_Prism.xy, Multiply(Subtract(n0, 1), 2))
            ly = ArrayGet(CAD_Topo_Prism.xy, Add(Multiply(Subtract(n0, 1), 2), 1))
            fx = ArrayGet(CAD_Topo_Prism.xy, 0)
            fy = ArrayGet(CAD_Topo_Prism.xy, 1)
            IfCondition EqualTo(CAD_Num.IsEqual(lx, fx, 0), 1) ThenBlock: {
                IfCondition EqualTo(CAD_Num.IsEqual(ly, fy, 0), 1) ThenBlock: {
                    n0 = Subtract(n0, 1)
                    CAD_Topo_Prism.n = n0
                }
            }
        }
        n0 = CAD_Topo_Prism.n
        IfCondition LessThan(n0, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n0, 2048) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_Prism.hz, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.PrismBufs(), 0) ThenBlock: { ReturnValue(0) }
        pt = CAD_Topo_Prism.pt
        p1b = CAD_Topo_Prism.p1b
        ax = CAD_Topo_Prism.ax
        ay = CAD_Topo_Prism.ay
        ring = CAD_Topo_Prism.ring
        vb = CAD_Topo_Prism.vb
        vt = CAD_Topo_Prism.vt
        eb = CAD_Topo_Prism.eb
        et = CAD_Topo_Prism.et
        ev = CAD_Topo_Prism.ev
        one = 0x3FF0000000000000
        neg1 = 0xBFF0000000000000
        zro = 0
        CAD_Topo_Prism.i = 0
        WhileLoop LessThan(CAD_Topo_Prism.i, CAD_Topo_Prism.n) {
            i = CAD_Topo_Prism.i
            n0 = CAD_Topo_Prism.n
            x = ArrayGet(CAD_Topo_Prism.xy, Multiply(i, 2))
            y = ArrayGet(CAD_Topo_Prism.xy, Add(Multiply(i, 2), 1))
            ArraySet(pt, 0, x)
            ArraySet(pt, 1, y)
            ArraySet(pt, 2, 0)
            ArraySet(vb, i, CAD_Topo.MakeVertex(pt))
            i = CAD_Topo_Prism.i
            ArraySet(pt, 2, CAD_Topo_Prism.hz)
            ArraySet(vt, i, CAD_Topo.MakeVertex(pt))
            CAD_Topo_Prism.i = Add(CAD_Topo_Prism.i, 1)
        }
        // edges bottom/top/vert
        CAD_Topo_Prism.i = 0
        WhileLoop LessThan(CAD_Topo_Prism.i, CAD_Topo_Prism.n) {
            i = CAD_Topo_Prism.i
            n0 = CAD_Topo_Prism.n
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            CAD_Topo_Prism.j = j
            va = ArrayGet(vb, i)
            vb2 = ArrayGet(vb, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, 0)
            ArraySet(p1b, 0, CAD_Store.Read(vb2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(vb2, 1))
            ArraySet(p1b, 2, 0)
            ArraySet(eb, i, CAD_Topo.MakeEdge(va, vb2, CAD_Geom.MakeLine(pt, p1b)))
            ta = ArrayGet(vt, i)
            tb = ArrayGet(vt, j)
            ArraySet(pt, 0, CAD_Store.Read(ta, 0))
            ArraySet(pt, 1, CAD_Store.Read(ta, 1))
            ArraySet(pt, 2, CAD_Topo_Prism.hz)
            ArraySet(p1b, 0, CAD_Store.Read(tb, 0))
            ArraySet(p1b, 1, CAD_Store.Read(tb, 1))
            ArraySet(p1b, 2, CAD_Topo_Prism.hz)
            ArraySet(et, i, CAD_Topo.MakeEdge(ta, tb, CAD_Geom.MakeLine(pt, p1b)))
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, 0)
            ArraySet(p1b, 0, CAD_Store.Read(ta, 0))
            ArraySet(p1b, 1, CAD_Store.Read(ta, 1))
            ArraySet(p1b, 2, CAD_Topo_Prism.hz)
            ArraySet(ev, i, CAD_Topo.MakeEdge(va, ta, CAD_Geom.MakeLine(pt, p1b)))
            CAD_Topo_Prism.i = Add(CAD_Topo_Prism.i, 1)
        }
        // coedges for each edge: create forward/rev twins
        CAD_Topo_Prism.i = 0
        WhileLoop LessThan(CAD_Topo_Prism.i, CAD_Topo_Prism.n) {
            i = CAD_Topo_Prism.i
            n0 = CAD_Topo_Prism.n
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            e = ArrayGet(eb, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, j), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            e = ArrayGet(et, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, j), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            e = ArrayGet(ev, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, i), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            CAD_Topo_Prism.i = Add(CAD_Topo_Prism.i, 1)
        }
        // bottom face -Z
        CAD_Topo_Prism.i = 0
        WhileLoop LessThan(CAD_Topo_Prism.i, CAD_Topo_Prism.n) {
            i = CAD_Topo_Prism.i
            n0 = CAD_Topo_Prism.n
            k = Subtract(n0, Add(i, 1))
            e = ArrayGet(eb, k)
            ArraySet(ring, i, CAD_Store.Read(e, 4))
            CAD_Topo_Prism.i = Add(CAD_Topo_Prism.i, 1)
        }
        n0 = CAD_Topo_Prism.n
        ArraySet(pt, 0, ArrayGet(CAD_Topo_Prism.xy, 0))
        ArraySet(pt, 1, ArrayGet(CAD_Topo_Prism.xy, 1))
        ArraySet(pt, 2, 0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        sbot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        lbot = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        n0 = CAD_Topo_Prism.n
        CAD_Topo.LinkLoopRing(ring, n0, lbot)
        fbot = CAD_Topo.MakeFace(sbot, lbot)
        CAD_Store.Write(lbot, 2, 0)
        // top +Z
        CAD_Topo_Prism.i = 0
        WhileLoop LessThan(CAD_Topo_Prism.i, CAD_Topo_Prism.n) {
            i = CAD_Topo_Prism.i
            e = ArrayGet(et, i)
            ArraySet(ring, i, CAD_Store.Read(e, 3))
            CAD_Topo_Prism.i = Add(CAD_Topo_Prism.i, 1)
        }
        ArraySet(pt, 2, CAD_Topo_Prism.hz)
        ArraySet(ay, 1, one)
        stop = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ltop = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        n0 = CAD_Topo_Prism.n
        CAD_Topo.LinkLoopRing(ring, n0, ltop)
        ftop = CAD_Topo.MakeFace(stop, ltop)
        CAD_Store.Write(ltop, 2, 0)
        // side faces
        faces = CAD_Topo_Prism.faces
        IfCondition EqualTo(faces, 0) ThenBlock: { faces = Allocate(32768) }
        ArraySet(faces, 0, fbot)
        ArraySet(faces, 1, ftop)
        nf = 2
        CAD_Topo_Prism.nf = 2
        CAD_Topo_Prism.i = 0
        WhileLoop LessThan(CAD_Topo_Prism.i, CAD_Topo_Prism.n) {
            i = CAD_Topo_Prism.i
            n0 = CAD_Topo_Prism.n
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            ArraySet(ring, 0, CAD_Store.Read(ArrayGet(eb, i), 3))
            ArraySet(ring, 1, CAD_Store.Read(ArrayGet(ev, j), 3))
            ArraySet(ring, 2, CAD_Store.Read(ArrayGet(et, i), 4))
            ArraySet(ring, 3, CAD_Store.Read(ArrayGet(ev, i), 4))
            va = ArrayGet(vb, i)
            vb2 = ArrayGet(vb, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, 0)
            ArraySet(ax, 0, Float_Sub(CAD_Store.Read(vb2, 0), CAD_Store.Read(va, 0)))
            ArraySet(ax, 1, Float_Sub(CAD_Store.Read(vb2, 1), CAD_Store.Read(va, 1)))
            ArraySet(ax, 2, zro)
            ln = CAD_Num.Sqrt(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))))
            IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
                ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), ln))
                ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), ln))
            }
            ArraySet(ay, 0, zro)
            ArraySet(ay, 1, zro)
            ArraySet(ay, 2, one)
            sside = CAD_Geom.MakePlaneAxes(pt, ax, ay)
            ls = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
            CAD_Topo.LinkLoopRing(ring, 4, ls)
            fs = CAD_Topo.MakeFace(sside, ls)
            nf = CAD_Topo_Prism.nf
            ArraySet(faces, nf, fs)
            CAD_Topo_Prism.nf = Add(nf, 1)
            CAD_Topo_Prism.i = Add(CAD_Topo_Prism.i, 1)
        }
        nf = CAD_Topo_Prism.nf
        // chain faces
        i = 0
        WhileLoop LessThan(i, Subtract(nf, 1)) {
            CAD_Store.Write(ArrayGet(faces, i), 3, ArrayGet(faces, Add(i, 1)))
            i = Add(i, 1)
        }
        CAD_Store.Write(ArrayGet(faces, Subtract(nf, 1)), 3, 0)
        h_sh = CAD_Topo.MakeShell(ArrayGet(faces, 0))
        i = 1
        WhileLoop LessThan(i, nf) {
            CAD_Store.Write(ArrayGet(faces, i), 2, h_sh)
            i = Add(i, 1)
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(CAD_Topo_Prism.out, 0, h_so)
        ReturnValue(h_so)
    }
}

// Inset a closed XY loop by D (convex CCW). out_xy same layout. Returns n or 0.
Function.CAD_Topo.InsetPolyXY {
    Input: xy_addr: Address
    Input: n: Integer
    Input: D_r: Integer
    Input: out_xy: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            ip = Subtract(i, 1)
            IfCondition LessThan(ip, 0) ThenBlock: { ip = Subtract(n, 1) }
            inx = Add(i, 1)
            IfCondition EqualTo(inx, n) ThenBlock: { inx = 0 }
            x0 = ArrayGet(xy_addr, Multiply(ip, 2))
            y0 = ArrayGet(xy_addr, Add(Multiply(ip, 2), 1))
            x1 = ArrayGet(xy_addr, Multiply(i, 2))
            y1 = ArrayGet(xy_addr, Add(Multiply(i, 2), 1))
            x2 = ArrayGet(xy_addr, Multiply(inx, 2))
            y2 = ArrayGet(xy_addr, Add(Multiply(inx, 2), 1))
            d0x = Float_Sub(x1, x0)
            d0y = Float_Sub(y1, y0)
            d1x = Float_Sub(x2, x1)
            d1y = Float_Sub(y2, y1)
            l0 = CAD_Num.Sqrt(Float_Add(Float_Mul(d0x, d0x), Float_Mul(d0y, d0y)))
            l1 = CAD_Num.Sqrt(Float_Add(Float_Mul(d1x, d1x), Float_Mul(d1y, d1y)))
            IfCondition EqualTo(CAD_Num.IsZero(l0, 0), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(CAD_Num.IsZero(l1, 0), 1) ThenBlock: { ReturnValue(0) }
            // inward = rotate CCW edge left (-dy, dx)
            n0x = Float_Div(Float_Sub(0, d0y), l0)
            n0y = Float_Div(d0x, l0)
            n1x = Float_Div(Float_Sub(0, d1y), l1)
            n1y = Float_Div(d1x, l1)
            p0x = Float_Add(x1, Float_Mul(D_r, n0x))
            p0y = Float_Add(y1, Float_Mul(D_r, n0y))
            p1x = Float_Add(x1, Float_Mul(D_r, n1x))
            p1y = Float_Add(y1, Float_Mul(D_r, n1y))
            cr = Float_Sub(Float_Mul(d0x, d1y), Float_Mul(d0y, d1x))
            ix = p0x
            iy = p0y
            IfCondition EqualTo(CAD_Num.IsZero(cr, 0), 0) ThenBlock: {
                wx = Float_Sub(p1x, p0x)
                wy = Float_Sub(p1y, p0y)
                s = Float_Div(Float_Sub(Float_Mul(wx, d1y), Float_Mul(wy, d1x)), cr)
                ix = Float_Add(p0x, Float_Mul(s, d0x))
                iy = Float_Add(p0y, Float_Mul(s, d0y))
            }
            ArraySet(out_xy, Multiply(i, 2), ix)
            ArraySet(out_xy, Add(Multiply(i, 2), 1), iy)
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// Chamfer the top (on_top=1) or bottom (0) of a kind-0 prism by equal setback D.
// One rebuild: inset cap + planar bevel quads + shortened walls. Meeting-cut corners.
