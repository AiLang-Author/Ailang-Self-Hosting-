// CAD.Topo.MakeSweep — split from Library.CAD_Topo.ailang
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.MakeRuledSolid {
    Input: xy_bot: Address
    Input: xy_top: Address
    Input: n_pts: Integer
    Input: zpack_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n_pts, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_pts, 64) ThenBlock: { ReturnValue(0) }
        zb = ArrayGet(zpack_addr, 0)
        zt = ArrayGet(zpack_addr, 1)
        IfCondition EqualTo(CAD_Num.IsEqual(zb, zt, 0), 1) ThenBlock: { ReturnValue(0) }
        n0 = n_pts
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(512)
        vb = Allocate(512)
        vt = Allocate(512)
        eb = Allocate(512)
        et = Allocate(512)
        ev = Allocate(512)
        one = 0x3FF0000000000000
        neg1 = 0xBFF0000000000000
        zro = 0
        i = 0
        WhileLoop LessThan(i, n0) {
            ArraySet(pt, 0, ArrayGet(xy_bot, Multiply(i, 2)))
            ArraySet(pt, 1, ArrayGet(xy_bot, Add(Multiply(i, 2), 1)))
            ArraySet(pt, 2, zb)
            ArraySet(vb, i, CAD_Topo.MakeVertex(pt))
            ArraySet(pt, 0, ArrayGet(xy_top, Multiply(i, 2)))
            ArraySet(pt, 1, ArrayGet(xy_top, Add(Multiply(i, 2), 1)))
            ArraySet(pt, 2, zt)
            ArraySet(vt, i, CAD_Topo.MakeVertex(pt))
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, n0) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            va = ArrayGet(vb, i)
            vb2 = ArrayGet(vb, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, CAD_Store.Read(va, 2))
            ArraySet(p1b, 0, CAD_Store.Read(vb2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(vb2, 1))
            ArraySet(p1b, 2, CAD_Store.Read(vb2, 2))
            ArraySet(eb, i, CAD_Topo.MakeEdge(va, vb2, CAD_Geom.MakeLine(pt, p1b)))
            ta = ArrayGet(vt, i)
            tb = ArrayGet(vt, j)
            ArraySet(pt, 0, CAD_Store.Read(ta, 0))
            ArraySet(pt, 1, CAD_Store.Read(ta, 1))
            ArraySet(pt, 2, CAD_Store.Read(ta, 2))
            ArraySet(p1b, 0, CAD_Store.Read(tb, 0))
            ArraySet(p1b, 1, CAD_Store.Read(tb, 1))
            ArraySet(p1b, 2, CAD_Store.Read(tb, 2))
            ArraySet(et, i, CAD_Topo.MakeEdge(ta, tb, CAD_Geom.MakeLine(pt, p1b)))
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, CAD_Store.Read(va, 2))
            ArraySet(p1b, 0, CAD_Store.Read(ta, 0))
            ArraySet(p1b, 1, CAD_Store.Read(ta, 1))
            ArraySet(p1b, 2, CAD_Store.Read(ta, 2))
            ArraySet(ev, i, CAD_Topo.MakeEdge(va, ta, CAD_Geom.MakeLine(pt, p1b)))
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, n0) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            e = ArrayGet(eb, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, j), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            e = ArrayGet(et, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, j), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            e = ArrayGet(ev, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, i), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            i = Add(i, 1)
        }
        // bottom face at z_bot: reverse bottom edges
        i = 0
        WhileLoop LessThan(i, n0) {
            k = Subtract(n0, Add(i, 1))
            e = ArrayGet(eb, k)
            ArraySet(ring, i, CAD_Store.Read(e, 4))
            i = Add(i, 1)
        }
        ArraySet(pt, 0, ArrayGet(xy_bot, 0))
        ArraySet(pt, 1, ArrayGet(xy_bot, 1))
        ArraySet(pt, 2, zb)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        sbot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        lbot = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n0, lbot)
        fbot = CAD_Topo.MakeFace(sbot, lbot)
        // top face
        i = 0
        WhileLoop LessThan(i, n0) {
            e = ArrayGet(et, i)
            ArraySet(ring, i, CAD_Store.Read(e, 3))
            i = Add(i, 1)
        }
        ArraySet(pt, 0, ArrayGet(xy_top, 0))
        ArraySet(pt, 1, ArrayGet(xy_top, 1))
        ArraySet(pt, 2, zt)
        ArraySet(ay, 1, one)
        stop = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ltop = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n0, ltop)
        ftop = CAD_Topo.MakeFace(stop, ltop)
        faces = Allocate(512)
        ArraySet(faces, 0, fbot)
        ArraySet(faces, 1, ftop)
        nf = 2
        i = 0
        WhileLoop LessThan(i, n0) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            ArraySet(ring, 0, CAD_Store.Read(ArrayGet(eb, i), 3))
            ArraySet(ring, 1, CAD_Store.Read(ArrayGet(ev, j), 3))
            ArraySet(ring, 2, CAD_Store.Read(ArrayGet(et, i), 4))
            ArraySet(ring, 3, CAD_Store.Read(ArrayGet(ev, i), 4))
            va = ArrayGet(vb, i)
            vb2 = ArrayGet(vb, j)
            ta = ArrayGet(vt, i)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, CAD_Store.Read(va, 2))
            // ax along bottom edge (3d)
            ArraySet(ax, 0, Float_Sub(CAD_Store.Read(vb2, 0), CAD_Store.Read(va, 0)))
            ArraySet(ax, 1, Float_Sub(CAD_Store.Read(vb2, 1), CAD_Store.Read(va, 1)))
            ArraySet(ax, 2, Float_Sub(CAD_Store.Read(vb2, 2), CAD_Store.Read(va, 2)))
            ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))), Float_Mul(ArrayGet(ax, 2), ArrayGet(ax, 2))))
            IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
                ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), ln))
                ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), ln))
                ArraySet(ax, 2, Float_Div(ArrayGet(ax, 2), ln))
            }
            // ay along ruled generator bottom→top (may be non-vertical)
            ArraySet(ay, 0, Float_Sub(CAD_Store.Read(ta, 0), CAD_Store.Read(va, 0)))
            ArraySet(ay, 1, Float_Sub(CAD_Store.Read(ta, 1), CAD_Store.Read(va, 1)))
            ArraySet(ay, 2, Float_Sub(CAD_Store.Read(ta, 2), CAD_Store.Read(va, 2)))
            // orthogonalize ay against ax: ay = ay - (ay·ax) ax
            dot = Float_Add(Float_Add(Float_Mul(ArrayGet(ay, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ay, 1), ArrayGet(ax, 1))), Float_Mul(ArrayGet(ay, 2), ArrayGet(ax, 2)))
            ArraySet(ay, 0, Float_Sub(ArrayGet(ay, 0), Float_Mul(dot, ArrayGet(ax, 0))))
            ArraySet(ay, 1, Float_Sub(ArrayGet(ay, 1), Float_Mul(dot, ArrayGet(ax, 1))))
            ArraySet(ay, 2, Float_Sub(ArrayGet(ay, 2), Float_Mul(dot, ArrayGet(ax, 2))))
            ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(ay, 0), ArrayGet(ay, 0)), Float_Mul(ArrayGet(ay, 1), ArrayGet(ay, 1))), Float_Mul(ArrayGet(ay, 2), ArrayGet(ay, 2))))
            IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
                ArraySet(ay, 0, Float_Div(ArrayGet(ay, 0), ln))
                ArraySet(ay, 1, Float_Div(ArrayGet(ay, 1), ln))
                ArraySet(ay, 2, Float_Div(ArrayGet(ay, 2), ln))
            }
            sside = CAD_Geom.MakePlaneAxes(pt, ax, ay)
            ls = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
            CAD_Topo.LinkLoopRing(ring, 4, ls)
            fs = CAD_Topo.MakeFace(sside, ls)
            ArraySet(faces, nf, fs)
            nf = Add(nf, 1)
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, Subtract(nf, 1)) {
            CAD_Store.Write(ArrayGet(faces, i), 3, ArrayGet(faces, Add(i, 1)))
            i = Add(i, 1)
        }
        CAD_Store.Write(ArrayGet(faces, Subtract(nf, 1)), 3, 0)
        h_sh = CAD_Topo.MakeShell(ArrayGet(faces, 0))
        i = 1
        WhileLoop LessThan(i, nf) {
            CAD_Store.Write(ArrayGet(faces, i), 2, h_sh)
            i = Add(i, 1)
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 512)
        Deallocate(vb, 512)
        Deallocate(vt, 512)
        Deallocate(eb, 512)
        Deallocate(et, 512)
        Deallocate(ev, 512)
        Deallocate(faces, 512)
        ReturnValue(h_so)
    }
}

// Sweep XY profile along a polyline path (parallel transport of profile).
// xy: [x,y]*n profile relative; path_xyz: [x,y,z]*npath (npath 2..32).
// Section s vertex i = profile[i] + (path[s] - path[0]). Kind-0.
Function.CAD_Topo.MakePathSweepSolid {
    Input: xy_addr: Address
    Input: n_pts: Integer
    Input: path_xyz: Address
    Input: npath: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n_pts, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_pts, 64) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(npath, 2) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(npath, 32) ThenBlock: { ReturnValue(0) }
        // two-section path → single ruled solid (common case)
        IfCondition EqualTo(npath, 2) ThenBlock: {
            bot = Allocate(1024)
            top = Allocate(1024)
            p0x = ArrayGet(path_xyz, 0)
            p0y = ArrayGet(path_xyz, 1)
            p0z = ArrayGet(path_xyz, 2)
            p1x = ArrayGet(path_xyz, 3)
            p1y = ArrayGet(path_xyz, 4)
            p1z = ArrayGet(path_xyz, 5)
            i = 0
            WhileLoop LessThan(i, n_pts) {
                px = ArrayGet(xy_addr, Multiply(i, 2))
                py = ArrayGet(xy_addr, Add(Multiply(i, 2), 1))
                ArraySet(bot, Multiply(i, 2), Float_Add(px, p0x))
                ArraySet(bot, Add(Multiply(i, 2), 1), Float_Add(py, p0y))
                ArraySet(top, Multiply(i, 2), Float_Add(px, p1x))
                ArraySet(top, Add(Multiply(i, 2), 1), Float_Add(py, p1y))
                i = Add(i, 1)
            }
            // if path Z equal, still ok if XY path moves (loft in plane needs z_bot!=z_top check)
            // bump tiny Z if flat path so MakeRuledSolid accepts — use path Z primarily
            zpack = Allocate(32)
            ArraySet(zpack, 0, p0z)
            ArraySet(zpack, 1, p1z)
            h = CAD_Topo.MakeRuledSolid(bot, top, n_pts, zpack, out_solid_addr)
            Deallocate(zpack, 32)
            Deallocate(bot, 1024)
            Deallocate(top, 1024)
            ReturnValue(h)
        }
        // multi-section: chain of ruled segments CompoundAdd (each segment is a solid shell)
        bot = Allocate(1024)
        top = Allocate(1024)
        out = Allocate(16)
        zpack = Allocate(32)
        result = 0
        s = 0
        WhileLoop LessThan(s, Subtract(npath, 1)) {
            p0x = ArrayGet(path_xyz, Multiply(s, 3))
            p0y = ArrayGet(path_xyz, Add(Multiply(s, 3), 1))
            p0z = ArrayGet(path_xyz, Add(Multiply(s, 3), 2))
            p1x = ArrayGet(path_xyz, Multiply(Add(s, 1), 3))
            p1y = ArrayGet(path_xyz, Add(Multiply(Add(s, 1), 3), 1))
            p1z = ArrayGet(path_xyz, Add(Multiply(Add(s, 1), 3), 2))
            IfCondition EqualTo(CAD_Num.IsEqual(p0z, p1z, 0), 1) ThenBlock: {
                Deallocate(bot, 1024)
                Deallocate(top, 1024)
                Deallocate(out, 16)
                Deallocate(zpack, 32)
                ReturnValue(0)
            }
            i = 0
            WhileLoop LessThan(i, n_pts) {
                px = ArrayGet(xy_addr, Multiply(i, 2))
                py = ArrayGet(xy_addr, Add(Multiply(i, 2), 1))
                ArraySet(bot, Multiply(i, 2), Float_Add(px, p0x))
                ArraySet(bot, Add(Multiply(i, 2), 1), Float_Add(py, p0y))
                ArraySet(top, Multiply(i, 2), Float_Add(px, p1x))
                ArraySet(top, Add(Multiply(i, 2), 1), Float_Add(py, p1y))
                i = Add(i, 1)
            }
            ArraySet(zpack, 0, p0z)
            ArraySet(zpack, 1, p1z)
            seg = CAD_Topo.MakeRuledSolid(bot, top, n_pts, zpack, out)
            IfCondition EqualTo(seg, 0) ThenBlock: {
                Deallocate(bot, 1024)
                Deallocate(top, 1024)
                Deallocate(out, 16)
                Deallocate(zpack, 32)
                ReturnValue(0)
            }
            IfCondition EqualTo(result, 0) ThenBlock: {
                result = seg
            }
            IfCondition NotEqual(result, 0) ThenBlock: {
                IfCondition NotEqual(result, seg) ThenBlock: {
                    result = CAD_Topo.CompoundAdd(result, seg)
                }
            }
            s = Add(s, 1)
        }
        ArraySet(out_solid_addr, 0, result)
        Deallocate(bot, 1024)
        Deallocate(top, 1024)
        Deallocate(out, 16)
        Deallocate(zpack, 32)
        ReturnValue(result)
    }
}

// Right circular tube about +Z (origin). Closed solid — no keyhole slit.
// B-Rep: outer ring + true inner hole loop (MakePolyPrismHoles).
// Kind 5 + params so display uses analytic MeshTubeAnalytic (smooth, full 360).
// nseg used only for poly shell density (STEP/face-walk); clamp 16..128.
Function.CAD_Topo.MakeAnnulusPrism {
    Input: r_in_r: Integer
    Input: r_out_r: Integer
    Input: hz_r: Integer
    Input: nseg: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CAD_Num.IsZero(hz_r, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(r_out_r, r_in_r), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Num.IsZero(r_in_r, 0), 1) ThenBlock: {
            // solid cylinder (no hole)
            ReturnValue(CAD_Topo.MakeCylinderSolid(r_out_r, hz_r, out_solid_addr))
        }
        IfCondition LessThan(nseg, 16) ThenBlock: { nseg = 16 }
        IfCondition GreaterThan(nseg, 128) ThenBlock: { nseg = 128 }
        outer_xy = Allocate(4096)
        holes_xy = Allocate(4096)
        hole_ns = Allocate(64)
        two_pi = 0x401921FB54442D18
        i = 0
        WhileLoop LessThan(i, nseg) {
            a = Float_Mul(two_pi, Float_Div(Float_FromInt(i), Float_FromInt(nseg)))
            ArraySet(outer_xy, Multiply(i, 2), Float_Mul(r_out_r, CAD_Geom.Cos(a)))
            ArraySet(outer_xy, Add(Multiply(i, 2), 1), Float_Mul(r_out_r, CAD_Geom.Sin(a)))
            i = Add(i, 1)
        }
        // inner hole CW (reverse of outer) so wall normals point into material
        i = 0
        WhileLoop LessThan(i, nseg) {
            j = Subtract(Subtract(nseg, 1), i)
            a = Float_Mul(two_pi, Float_Div(Float_FromInt(j), Float_FromInt(nseg)))
            ArraySet(holes_xy, Multiply(i, 2), Float_Mul(r_in_r, CAD_Geom.Cos(a)))
            ArraySet(holes_xy, Add(Multiply(i, 2), 1), Float_Mul(r_in_r, CAD_Geom.Sin(a)))
            i = Add(i, 1)
        }
        ArraySet(hole_ns, 0, nseg)
        CAD_Topo_State.digon_S = holes_xy
        CAD_Topo_State.digon_nreg = hole_ns
        CAD_Topo_State.digon_k = 1
        h = CAD_Topo.MakePolyPrismHoles(outer_xy, nseg, hz_r, out_solid_addr)
        Deallocate(outer_xy, 4096)
        Deallocate(holes_xy, 4096)
        Deallocate(hole_ns, 64)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        // tag analytic tube for smooth full-turn mesh
        ph = CAD_Store.Alloc(13, 8)
        zro = 0
        CAD_Store.Write(ph, 0, r_in_r)
        CAD_Store.Write(ph, 1, r_out_r)
        CAD_Store.Write(ph, 2, hz_r)
        CAD_Store.Write(ph, 3, zro)
        CAD_Store.Write(ph, 4, zro)
        CAD_Store.Write(ph, 5, zro)
        CAD_Store.Write(ph, 6, 0)
        CAD_Store.Write(ph, 7, 0)
        CAD_Store.Write(h, 1, ph)
        CAD_Store.Write(h, 2, 0)
        CAD_Store.Write(h, 3, 5)
        ReturnValue(h)
    }
}

// Tube solid: r_in < r_out, height along +Z, base at origin. Kind 5.
Function.CAD_Topo.MakeTubeSolid {
    Input: r_in_r: Integer
    Input: r_out_r: Integer
    Input: height_r: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        // dense poly shell for STEP; display is analytic regardless
        ReturnValue(CAD_Topo.MakeAnnulusPrism(r_in_r, r_out_r, height_r, 96, out_solid_addr))
    }
}

// Axis-aligned rectangular frustum (draft pad): bottom [bx0,by0]–[bx1,by1] at z=0,
// top [tx0,ty0]–[tx1,ty1] at z=hz. Kind-0 shell (8 verts, 6 faces). pack 9 doubles.
Function.CAD_Topo.MakeRectFrustum {
    Input: pack_addr: Address
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        bx0 = ArrayGet(pack_addr, 0)
        by0 = ArrayGet(pack_addr, 1)
        bx1 = ArrayGet(pack_addr, 2)
        by1 = ArrayGet(pack_addr, 3)
        tx0 = ArrayGet(pack_addr, 4)
        ty0 = ArrayGet(pack_addr, 5)
        tx1 = ArrayGet(pack_addr, 6)
        ty1 = ArrayGet(pack_addr, 7)
        hz = ArrayGet(pack_addr, 8)
        IfCondition EqualTo(CAD_Num.IsZero(hz, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(bx1, bx0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(by1, by0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(tx1, tx0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(ty1, ty0), 1) ThenBlock: { ReturnValue(0) }
        one = 0x3FF0000000000000
        neg1 = 0xBFF0000000000000
        zro = 0
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(64)
        // bottom verts 0..3 CCW, top 4..7
        ArraySet(pt, 0, bx0)
        ArraySet(pt, 1, by0)
        ArraySet(pt, 2, zro)
        v0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, bx1)
        v1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, by1)
        v2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, bx0)
        v3 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, tx0)
        ArraySet(pt, 1, ty0)
        ArraySet(pt, 2, hz)
        v4 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, tx1)
        v5 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, ty1)
        v6 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, tx0)
        v7 = CAD_Topo.MakeVertex(pt)
        // edges bottom
        ArraySet(pt, 0, bx0)
        ArraySet(pt, 1, by0)
        ArraySet(pt, 2, zro)
        ArraySet(p1b, 0, bx1)
        ArraySet(p1b, 1, by0)
        ArraySet(p1b, 2, zro)
        e01 = CAD_Topo.MakeEdge(v0, v1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, bx1)
        ArraySet(p1b, 1, by1)
        e12 = CAD_Topo.MakeEdge(v1, v2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, by1)
        ArraySet(p1b, 0, bx0)
        e23 = CAD_Topo.MakeEdge(v2, v3, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, bx0)
        ArraySet(p1b, 1, by0)
        e30 = CAD_Topo.MakeEdge(v3, v0, CAD_Geom.MakeLine(pt, p1b))
        // top
        ArraySet(pt, 0, tx0)
        ArraySet(pt, 1, ty0)
        ArraySet(pt, 2, hz)
        ArraySet(p1b, 0, tx1)
        ArraySet(p1b, 1, ty0)
        ArraySet(p1b, 2, hz)
        e45 = CAD_Topo.MakeEdge(v4, v5, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, tx1)
        ArraySet(p1b, 1, ty1)
        e56 = CAD_Topo.MakeEdge(v5, v6, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, ty1)
        ArraySet(p1b, 0, tx0)
        e67 = CAD_Topo.MakeEdge(v6, v7, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, tx0)
        ArraySet(p1b, 1, ty0)
        e74 = CAD_Topo.MakeEdge(v7, v4, CAD_Geom.MakeLine(pt, p1b))
        // verticals
        ArraySet(pt, 0, bx0)
        ArraySet(pt, 1, by0)
        ArraySet(pt, 2, zro)
        ArraySet(p1b, 0, tx0)
        ArraySet(p1b, 1, ty0)
        ArraySet(p1b, 2, hz)
        e04 = CAD_Topo.MakeEdge(v0, v4, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, bx1)
        ArraySet(p1b, 0, tx1)
        e15 = CAD_Topo.MakeEdge(v1, v5, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, by1)
        ArraySet(p1b, 1, ty1)
        e26 = CAD_Topo.MakeEdge(v2, v6, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, bx0)
        ArraySet(p1b, 0, tx0)
        e37 = CAD_Topo.MakeEdge(v3, v7, CAD_Geom.MakeLine(pt, p1b))
        // coedges twins
        c01 = CAD_Topo.MakeCoedge(e01, v0, 1)
        c10 = CAD_Topo.MakeCoedge(e01, v1, 0)
        CAD_Topo.LinkTwins(c01, c10)
        CAD_Store.Write(e01, 3, c01)
        CAD_Store.Write(e01, 4, c10)
        c12 = CAD_Topo.MakeCoedge(e12, v1, 1)
        c21 = CAD_Topo.MakeCoedge(e12, v2, 0)
        CAD_Topo.LinkTwins(c12, c21)
        CAD_Store.Write(e12, 3, c12)
        CAD_Store.Write(e12, 4, c21)
        c23 = CAD_Topo.MakeCoedge(e23, v2, 1)
        c32 = CAD_Topo.MakeCoedge(e23, v3, 0)
        CAD_Topo.LinkTwins(c23, c32)
        CAD_Store.Write(e23, 3, c23)
        CAD_Store.Write(e23, 4, c32)
        c30 = CAD_Topo.MakeCoedge(e30, v3, 1)
        c03 = CAD_Topo.MakeCoedge(e30, v0, 0)
        CAD_Topo.LinkTwins(c30, c03)
        CAD_Store.Write(e30, 3, c30)
        CAD_Store.Write(e30, 4, c03)
        c45 = CAD_Topo.MakeCoedge(e45, v4, 1)
        c54 = CAD_Topo.MakeCoedge(e45, v5, 0)
        CAD_Topo.LinkTwins(c45, c54)
        CAD_Store.Write(e45, 3, c45)
        CAD_Store.Write(e45, 4, c54)
        c56 = CAD_Topo.MakeCoedge(e56, v5, 1)
        c65 = CAD_Topo.MakeCoedge(e56, v6, 0)
        CAD_Topo.LinkTwins(c56, c65)
        CAD_Store.Write(e56, 3, c56)
        CAD_Store.Write(e56, 4, c65)
        c67 = CAD_Topo.MakeCoedge(e67, v6, 1)
        c76 = CAD_Topo.MakeCoedge(e67, v7, 0)
        CAD_Topo.LinkTwins(c67, c76)
        CAD_Store.Write(e67, 3, c67)
        CAD_Store.Write(e67, 4, c76)
        c74 = CAD_Topo.MakeCoedge(e74, v7, 1)
        c47 = CAD_Topo.MakeCoedge(e74, v4, 0)
        CAD_Topo.LinkTwins(c74, c47)
        CAD_Store.Write(e74, 3, c74)
        CAD_Store.Write(e74, 4, c47)
        c04 = CAD_Topo.MakeCoedge(e04, v0, 1)
        c40 = CAD_Topo.MakeCoedge(e04, v4, 0)
        CAD_Topo.LinkTwins(c04, c40)
        CAD_Store.Write(e04, 3, c04)
        CAD_Store.Write(e04, 4, c40)
        c15 = CAD_Topo.MakeCoedge(e15, v1, 1)
        c51 = CAD_Topo.MakeCoedge(e15, v5, 0)
        CAD_Topo.LinkTwins(c15, c51)
        CAD_Store.Write(e15, 3, c15)
        CAD_Store.Write(e15, 4, c51)
        c26 = CAD_Topo.MakeCoedge(e26, v2, 1)
        c62 = CAD_Topo.MakeCoedge(e26, v6, 0)
        CAD_Topo.LinkTwins(c26, c62)
        CAD_Store.Write(e26, 3, c26)
        CAD_Store.Write(e26, 4, c62)
        c37 = CAD_Topo.MakeCoedge(e37, v3, 1)
        c73 = CAD_Topo.MakeCoedge(e37, v7, 0)
        CAD_Topo.LinkTwins(c37, c73)
        CAD_Store.Write(e37, 3, c37)
        CAD_Store.Write(e37, 4, c73)
        // faces: bot reverse, top fwd, 4 sides
        ArraySet(pt, 0, bx0)
        ArraySet(pt, 1, by0)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c03)
        ArraySet(ring, 1, c32)
        ArraySet(ring, 2, c21)
        ArraySet(ring, 3, c10)
        lb = CAD_Topo.MakeLoop(c03)
        CAD_Topo.LinkLoopRing(ring, 4, lb)
        f_bot = CAD_Topo.MakeFace(pl_bot, lb)
        ArraySet(pt, 2, hz)
        ArraySet(ay, 1, one)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(ring, 0, c45)
        ArraySet(ring, 1, c56)
        ArraySet(ring, 2, c67)
        ArraySet(ring, 3, c74)
        lt = CAD_Topo.MakeLoop(c45)
        CAD_Topo.LinkLoopRing(ring, 4, lt)
        f_top = CAD_Topo.MakeFace(pl_top, lt)
        // side y=by0: e01, e15, e45rev, e04rev
        ArraySet(ring, 0, c01)
        ArraySet(ring, 1, c15)
        ArraySet(ring, 2, c54)
        ArraySet(ring, 3, c40)
        ArraySet(pt, 0, bx0)
        ArraySet(pt, 1, by0)
        ArraySet(pt, 2, zro)
        ArraySet(ax, 0, Float_Sub(bx1, bx0))
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ln = CAD_Num.Sqrt(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
            ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), ln))
        }
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        pl_s0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ls0 = CAD_Topo.MakeLoop(c01)
        CAD_Topo.LinkLoopRing(ring, 4, ls0)
        f_s0 = CAD_Topo.MakeFace(pl_s0, ls0)
        ArraySet(ring, 0, c12)
        ArraySet(ring, 1, c26)
        ArraySet(ring, 2, c65)
        ArraySet(ring, 3, c51)
        ArraySet(pt, 0, bx1)
        ArraySet(pt, 1, by0)
        ArraySet(ax, 0, zro)
        ArraySet(ax, 1, Float_Sub(by1, by0))
        ArraySet(ax, 2, zro)
        ln = CAD_Num.Sqrt(Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
            ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), ln))
        }
        pl_s1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ls1 = CAD_Topo.MakeLoop(c12)
        CAD_Topo.LinkLoopRing(ring, 4, ls1)
        f_s1 = CAD_Topo.MakeFace(pl_s1, ls1)
        ArraySet(ring, 0, c23)
        ArraySet(ring, 1, c37)
        ArraySet(ring, 2, c76)
        ArraySet(ring, 3, c62)
        ArraySet(pt, 0, bx1)
        ArraySet(pt, 1, by1)
        ArraySet(ax, 0, Float_Sub(bx0, bx1))
        ArraySet(ax, 1, zro)
        ln = CAD_Num.Sqrt(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
            ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), ln))
        }
        pl_s2 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ls2 = CAD_Topo.MakeLoop(c23)
        CAD_Topo.LinkLoopRing(ring, 4, ls2)
        f_s2 = CAD_Topo.MakeFace(pl_s2, ls2)
        ArraySet(ring, 0, c30)
        ArraySet(ring, 1, c04)
        ArraySet(ring, 2, c47)
        ArraySet(ring, 3, c73)
        ArraySet(pt, 0, bx0)
        ArraySet(pt, 1, by1)
        ArraySet(ax, 0, zro)
        ArraySet(ax, 1, Float_Sub(by0, by1))
        ln = CAD_Num.Sqrt(Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1)))
        IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
            ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), ln))
        }
        pl_s3 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ls3 = CAD_Topo.MakeLoop(c30)
        CAD_Topo.LinkLoopRing(ring, 4, ls3)
        f_s3 = CAD_Topo.MakeFace(pl_s3, ls3)
        CAD_Store.Write(f_bot, 3, f_top)
        CAD_Store.Write(f_top, 3, f_s0)
        CAD_Store.Write(f_s0, 3, f_s1)
        CAD_Store.Write(f_s1, 3, f_s2)
        CAD_Store.Write(f_s2, 3, f_s3)
        CAD_Store.Write(f_s3, 3, 0)
        h_sh = CAD_Topo.MakeShell(f_bot)
        ff = f_bot
        g = 0
        WhileLoop NotEqual(ff, 0) {
            CAD_Store.Write(ff, 2, h_sh)
            ff = CAD_Store.Read(ff, 3)
            g = Add(g, 1)
            IfCondition GreaterThan(g, 16) ThenBlock: { ff = 0 }
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 64)
        ReturnValue(h_so)
    }
}

// Rectangular plate with through polygonal hole (door-escutcheon pattern).
// pack: [x0,y0,x1,y1,hz] outer AABB × height; xy_addr = hole poly (n 3..56).
// Top/bottom: outer loop + reverse/forward inner hole; n vertical hole walls; 4 plate sides.
// Kind-0 walkable shell (STEP export). Returns solid handle or 0.
// Pack form (not 8 loose args) avoids stack-arg clobber with heavy locals.
Function.CAD_Topo.MakePlateThroughPolyHole {
    Input: pack_addr: Address
    Input: xy_addr: Address
    Input: n_pts: Integer
    Input: out_solid_addr: Address
    Output: Integer
    Body: {
        IfCondition LessThan(n_pts, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n_pts, 56) ThenBlock: { ReturnValue(0) }
        x0 = ArrayGet(pack_addr, 0)
        y0 = ArrayGet(pack_addr, 1)
        x1 = ArrayGet(pack_addr, 2)
        y1 = ArrayGet(pack_addr, 3)
        z1 = ArrayGet(pack_addr, 4)
        IfCondition EqualTo(CAD_Num.IsZero(z1, 0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(x1, x0), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Float_Le(y1, y0), 1) ThenBlock: { ReturnValue(0) }
        n0 = n_pts
        z0 = 0
        one = 0x3FF0000000000000
        neg1 = 0xBFF0000000000000
        zro = 0

        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(512)
        vb = Allocate(512)
        vt = Allocate(512)
        eb = Allocate(512)
        et = Allocate(512)
        ev = Allocate(512)
        faces = Allocate(1024)

        // --- outer plate box verts ---
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ov0 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        ov1 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        ov2 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        ov3 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z1)
        ov4 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x1)
        ov5 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 1, y1)
        ov6 = CAD_Topo.MakeVertex(pt)
        ArraySet(pt, 0, x0)
        ov7 = CAD_Topo.MakeVertex(pt)

        // outer edges
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z0)
        e01 = CAD_Topo.MakeEdge(ov0, ov1, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        e12 = CAD_Topo.MakeEdge(ov1, ov2, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        e23 = CAD_Topo.MakeEdge(ov2, ov3, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        e30 = CAD_Topo.MakeEdge(ov3, ov0, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z1)
        ArraySet(p1b, 0, x1)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z1)
        e45 = CAD_Topo.MakeEdge(ov4, ov5, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 1, y1)
        e56 = CAD_Topo.MakeEdge(ov5, ov6, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 0, x0)
        e67 = CAD_Topo.MakeEdge(ov6, ov7, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 1, y0)
        e74 = CAD_Topo.MakeEdge(ov7, ov4, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(p1b, 0, x0)
        ArraySet(p1b, 1, y0)
        ArraySet(p1b, 2, z1)
        e04 = CAD_Topo.MakeEdge(ov0, ov4, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x1)
        ArraySet(p1b, 0, x1)
        e15 = CAD_Topo.MakeEdge(ov1, ov5, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 1, y1)
        ArraySet(p1b, 1, y1)
        e26 = CAD_Topo.MakeEdge(ov2, ov6, CAD_Geom.MakeLine(pt, p1b))
        ArraySet(pt, 0, x0)
        ArraySet(p1b, 0, x0)
        e37 = CAD_Topo.MakeEdge(ov3, ov7, CAD_Geom.MakeLine(pt, p1b))

        // outer coedges (twins)
        c01 = CAD_Topo.MakeCoedge(e01, ov0, 1)
        c10 = CAD_Topo.MakeCoedge(e01, ov1, 0)
        CAD_Topo.LinkTwins(c01, c10)
        CAD_Store.Write(e01, 3, c01)
        CAD_Store.Write(e01, 4, c10)
        c12 = CAD_Topo.MakeCoedge(e12, ov1, 1)
        c21 = CAD_Topo.MakeCoedge(e12, ov2, 0)
        CAD_Topo.LinkTwins(c12, c21)
        CAD_Store.Write(e12, 3, c12)
        CAD_Store.Write(e12, 4, c21)
        c23 = CAD_Topo.MakeCoedge(e23, ov2, 1)
        c32 = CAD_Topo.MakeCoedge(e23, ov3, 0)
        CAD_Topo.LinkTwins(c23, c32)
        CAD_Store.Write(e23, 3, c23)
        CAD_Store.Write(e23, 4, c32)
        c30 = CAD_Topo.MakeCoedge(e30, ov3, 1)
        c03 = CAD_Topo.MakeCoedge(e30, ov0, 0)
        CAD_Topo.LinkTwins(c30, c03)
        CAD_Store.Write(e30, 3, c30)
        CAD_Store.Write(e30, 4, c03)
        c45 = CAD_Topo.MakeCoedge(e45, ov4, 1)
        c54 = CAD_Topo.MakeCoedge(e45, ov5, 0)
        CAD_Topo.LinkTwins(c45, c54)
        CAD_Store.Write(e45, 3, c45)
        CAD_Store.Write(e45, 4, c54)
        c56 = CAD_Topo.MakeCoedge(e56, ov5, 1)
        c65 = CAD_Topo.MakeCoedge(e56, ov6, 0)
        CAD_Topo.LinkTwins(c56, c65)
        CAD_Store.Write(e56, 3, c56)
        CAD_Store.Write(e56, 4, c65)
        c67 = CAD_Topo.MakeCoedge(e67, ov6, 1)
        c76 = CAD_Topo.MakeCoedge(e67, ov7, 0)
        CAD_Topo.LinkTwins(c67, c76)
        CAD_Store.Write(e67, 3, c67)
        CAD_Store.Write(e67, 4, c76)
        c74 = CAD_Topo.MakeCoedge(e74, ov7, 1)
        c47 = CAD_Topo.MakeCoedge(e74, ov4, 0)
        CAD_Topo.LinkTwins(c74, c47)
        CAD_Store.Write(e74, 3, c74)
        CAD_Store.Write(e74, 4, c47)
        c04 = CAD_Topo.MakeCoedge(e04, ov0, 1)
        c40 = CAD_Topo.MakeCoedge(e04, ov4, 0)
        CAD_Topo.LinkTwins(c04, c40)
        CAD_Store.Write(e04, 3, c04)
        CAD_Store.Write(e04, 4, c40)
        c15 = CAD_Topo.MakeCoedge(e15, ov1, 1)
        c51 = CAD_Topo.MakeCoedge(e15, ov5, 0)
        CAD_Topo.LinkTwins(c15, c51)
        CAD_Store.Write(e15, 3, c15)
        CAD_Store.Write(e15, 4, c51)
        c26 = CAD_Topo.MakeCoedge(e26, ov2, 1)
        c62 = CAD_Topo.MakeCoedge(e26, ov6, 0)
        CAD_Topo.LinkTwins(c26, c62)
        CAD_Store.Write(e26, 3, c26)
        CAD_Store.Write(e26, 4, c62)
        c37 = CAD_Topo.MakeCoedge(e37, ov3, 1)
        c73 = CAD_Topo.MakeCoedge(e37, ov7, 0)
        CAD_Topo.LinkTwins(c37, c73)
        CAD_Store.Write(e37, 3, c37)
        CAD_Store.Write(e37, 4, c73)

        // --- hole poly verts / edges (n0 pinned once; do not re-read n_pts) ---
        i = 0
        WhileLoop LessThan(i, n0) {
            xx = ArrayGet(xy_addr, Multiply(i, 2))
            yy = ArrayGet(xy_addr, Add(Multiply(i, 2), 1))
            ArraySet(pt, 0, xx)
            ArraySet(pt, 1, yy)
            ArraySet(pt, 2, z0)
            ArraySet(vb, i, CAD_Topo.MakeVertex(pt))
            ArraySet(pt, 2, z1)
            ArraySet(vt, i, CAD_Topo.MakeVertex(pt))
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, n0) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            va = ArrayGet(vb, i)
            vb2 = ArrayGet(vb, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, z0)
            ArraySet(p1b, 0, CAD_Store.Read(vb2, 0))
            ArraySet(p1b, 1, CAD_Store.Read(vb2, 1))
            ArraySet(p1b, 2, z0)
            ArraySet(eb, i, CAD_Topo.MakeEdge(va, vb2, CAD_Geom.MakeLine(pt, p1b)))
            ta = ArrayGet(vt, i)
            tb = ArrayGet(vt, j)
            ArraySet(pt, 0, CAD_Store.Read(ta, 0))
            ArraySet(pt, 1, CAD_Store.Read(ta, 1))
            ArraySet(pt, 2, z1)
            ArraySet(p1b, 0, CAD_Store.Read(tb, 0))
            ArraySet(p1b, 1, CAD_Store.Read(tb, 1))
            ArraySet(p1b, 2, z1)
            ArraySet(et, i, CAD_Topo.MakeEdge(ta, tb, CAD_Geom.MakeLine(pt, p1b)))
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, z0)
            ArraySet(p1b, 0, CAD_Store.Read(ta, 0))
            ArraySet(p1b, 1, CAD_Store.Read(ta, 1))
            ArraySet(p1b, 2, z1)
            ArraySet(ev, i, CAD_Topo.MakeEdge(va, ta, CAD_Geom.MakeLine(pt, p1b)))
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, n0) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            e = ArrayGet(eb, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, j), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            e = ArrayGet(et, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, j), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            e = ArrayGet(ev, i)
            c0 = CAD_Topo.MakeCoedge(e, ArrayGet(vb, i), 1)
            c1 = CAD_Topo.MakeCoedge(e, ArrayGet(vt, i), 0)
            CAD_Topo.LinkTwins(c0, c1)
            CAD_Store.Write(e, 3, c0)
            CAD_Store.Write(e, 4, c1)
            i = Add(i, 1)
        }

        // outer planes
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(pt, 2, z0)
        ArraySet(ax, 0, one)
        ArraySet(ax, 1, zro)
        ArraySet(ax, 2, zro)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, neg1)
        ArraySet(ay, 2, zro)
        pl_bot = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, z1)
        ArraySet(ay, 1, one)
        pl_top = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 2, z0)
        ArraySet(ay, 0, zro)
        ArraySet(ay, 1, zro)
        ArraySet(ay, 2, one)
        pl_y0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 1, y1)
        ArraySet(ax, 0, neg1)
        pl_y1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 0, x0)
        ArraySet(pt, 1, y0)
        ArraySet(ax, 0, zro)
        ArraySet(ax, 1, neg1)
        ArraySet(ax, 2, zro)
        pl_x0 = CAD_Geom.MakePlaneAxes(pt, ax, ay)
        ArraySet(pt, 0, x1)
        ArraySet(ax, 1, one)
        pl_x1 = CAD_Geom.MakePlaneAxes(pt, ax, ay)

        // TOP: outer CCW + hole CW (inner reverse)
        ArraySet(ring, 0, c45)
        ArraySet(ring, 1, c56)
        ArraySet(ring, 2, c67)
        ArraySet(ring, 3, c74)
        lp_to = CAD_Topo.MakeLoop(c45)
        CAD_Topo.LinkLoopRing(ring, 4, lp_to)
        i = 0
        WhileLoop LessThan(i, n0) {
            k = Subtract(n0, Add(i, 1))
            e = ArrayGet(et, k)
            ArraySet(ring, i, CAD_Store.Read(e, 4))
            i = Add(i, 1)
        }
        lp_ti = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n0, lp_ti)
        CAD_Store.Write(lp_to, 2, lp_ti)
        f_top = CAD_Topo.MakeFace(pl_top, lp_to)

        // BOTTOM: outer reverse + hole CCW (forward)
        ArraySet(ring, 0, c03)
        ArraySet(ring, 1, c32)
        ArraySet(ring, 2, c21)
        ArraySet(ring, 3, c10)
        lp_bo = CAD_Topo.MakeLoop(c03)
        CAD_Topo.LinkLoopRing(ring, 4, lp_bo)
        i = 0
        WhileLoop LessThan(i, n0) {
            e = ArrayGet(eb, i)
            ArraySet(ring, i, CAD_Store.Read(e, 3))
            i = Add(i, 1)
        }
        lp_bi = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
        CAD_Topo.LinkLoopRing(ring, n0, lp_bi)
        CAD_Store.Write(lp_bo, 2, lp_bi)
        f_bot = CAD_Topo.MakeFace(pl_bot, lp_bo)

        // outer sides
        ArraySet(ring, 0, c01)
        ArraySet(ring, 1, c15)
        ArraySet(ring, 2, c54)
        ArraySet(ring, 3, c40)
        lp_s0 = CAD_Topo.MakeLoop(c01)
        CAD_Topo.LinkLoopRing(ring, 4, lp_s0)
        f_s0 = CAD_Topo.MakeFace(pl_y0, lp_s0)
        ArraySet(ring, 0, c12)
        ArraySet(ring, 1, c26)
        ArraySet(ring, 2, c65)
        ArraySet(ring, 3, c51)
        lp_s1 = CAD_Topo.MakeLoop(c12)
        CAD_Topo.LinkLoopRing(ring, 4, lp_s1)
        f_s1 = CAD_Topo.MakeFace(pl_x1, lp_s1)
        ArraySet(ring, 0, c37)
        ArraySet(ring, 1, c76)
        ArraySet(ring, 2, c62)
        ArraySet(ring, 3, c23)
        lp_s2 = CAD_Topo.MakeLoop(c37)
        CAD_Topo.LinkLoopRing(ring, 4, lp_s2)
        f_s2 = CAD_Topo.MakeFace(pl_y1, lp_s2)
        ArraySet(ring, 0, c04)
        ArraySet(ring, 1, c47)
        ArraySet(ring, 2, c73)
        ArraySet(ring, 3, c30)
        lp_s3 = CAD_Topo.MakeLoop(c04)
        CAD_Topo.LinkLoopRing(ring, 4, lp_s3)
        f_s3 = CAD_Topo.MakeFace(pl_x0, lp_s3)

        ArraySet(faces, 0, f_bot)
        ArraySet(faces, 1, f_top)
        ArraySet(faces, 2, f_s0)
        ArraySet(faces, 3, f_s1)
        ArraySet(faces, 4, f_s2)
        ArraySet(faces, 5, f_s3)
        nf = 6

        // hole walls: top fwd, vert j down, bot rev, vert i up; N into void
        i = 0
        WhileLoop LessThan(i, n0) {
            j = Add(i, 1)
            IfCondition EqualTo(j, n0) ThenBlock: { j = 0 }
            ArraySet(ring, 0, CAD_Store.Read(ArrayGet(et, i), 3))
            ArraySet(ring, 1, CAD_Store.Read(ArrayGet(ev, j), 4))
            ArraySet(ring, 2, CAD_Store.Read(ArrayGet(eb, i), 4))
            ArraySet(ring, 3, CAD_Store.Read(ArrayGet(ev, i), 3))
            va = ArrayGet(vb, i)
            vb2 = ArrayGet(vb, j)
            ArraySet(pt, 0, CAD_Store.Read(va, 0))
            ArraySet(pt, 1, CAD_Store.Read(va, 1))
            ArraySet(pt, 2, z0)
            ArraySet(ax, 0, Float_Sub(CAD_Store.Read(vb2, 0), CAD_Store.Read(va, 0)))
            ArraySet(ax, 1, Float_Sub(CAD_Store.Read(vb2, 1), CAD_Store.Read(va, 1)))
            ArraySet(ax, 2, zro)
            ln = CAD_Num.Sqrt(Float_Add(Float_Mul(ArrayGet(ax, 0), ArrayGet(ax, 0)), Float_Mul(ArrayGet(ax, 1), ArrayGet(ax, 1))))
            IfCondition EqualTo(CAD_Num.IsZero(ln, 0), 0) ThenBlock: {
                ArraySet(ax, 0, Float_Div(ArrayGet(ax, 0), ln))
                ArraySet(ax, 1, Float_Div(ArrayGet(ax, 1), ln))
            }
            // Y=-Z so N = X×Y points into hole (void)
            ArraySet(ay, 0, zro)
            ArraySet(ay, 1, zro)
            ArraySet(ay, 2, neg1)
            sside = CAD_Geom.MakePlaneAxes(pt, ax, ay)
            ls = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
            CAD_Topo.LinkLoopRing(ring, 4, ls)
            fs = CAD_Topo.MakeFace(sside, ls)
            ArraySet(faces, nf, fs)
            nf = Add(nf, 1)
            i = Add(i, 1)
        }

        // chain faces
        i = 0
        WhileLoop LessThan(i, Subtract(nf, 1)) {
            CAD_Store.Write(ArrayGet(faces, i), 3, ArrayGet(faces, Add(i, 1)))
            i = Add(i, 1)
        }
        CAD_Store.Write(ArrayGet(faces, Subtract(nf, 1)), 3, 0)
        h_sh = CAD_Topo.MakeShell(ArrayGet(faces, 0))
        i = 0
        WhileLoop LessThan(i, nf) {
            CAD_Store.Write(ArrayGet(faces, i), 2, h_sh)
            i = Add(i, 1)
        }
        h_so = CAD_Topo.MakeSolid(h_sh)
        CAD_Store.Write(h_so, 1, 0)
        CAD_Store.Write(h_so, 2, 0)
        CAD_Store.Write(h_so, 3, 0)
        ArraySet(out_solid_addr, 0, h_so)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 512)
        Deallocate(vb, 512)
        Deallocate(vt, 512)
        Deallocate(eb, 512)
        Deallocate(et, 512)
        Deallocate(ev, 512)
        Deallocate(faces, 1024)
        ReturnValue(h_so)
    }
}

// Exact right cylinder B-Rep (honest kernel solid):
// V=2 seam verts, E=3 (CIRCLE bot/top + LINE generator), F=3 (planes + cyl).
// Euler 2-3+3=2. Tess samples surfaces; STEP uses analytic path (kind=1).
// Axis +Z, bottom center origin, radius/height doubles.
