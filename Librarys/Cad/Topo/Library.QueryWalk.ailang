LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.EdgeInLoop {
    Input: edge_h: Integer
    Input: loop_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(loop_h, 0) ThenBlock: { ReturnValue(0) }
        head = CAD_Store.Read(loop_h, 0)
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(0) }
        ce = head
        g = 0
        WhileLoop LessThan(g, 2048) {
            IfCondition EqualTo(CAD_Store.Read(ce, 0), edge_h) ThenBlock: { ReturnValue(1) }
            ce = CAD_Store.Read(ce, 2)
            IfCondition EqualTo(ce, head) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(0) }
            g = Add(g, 1)
        }
        ReturnValue(0)
    }
}

// 1 if edge sits on an INNER loop of face (imprint / hole), not the outer.
Function.CAD_Topo.EdgeOnInnerLoop {
    Input: edge_h: Integer
    Input: face_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        outer = CAD_Store.Read(face_h, 1)
        IfCondition EqualTo(outer, 0) ThenBlock: { ReturnValue(0) }
        inner = CAD_Store.Read(outer, 2)
        g = 0
        WhileLoop NotEqual(inner, 0) {
            IfCondition EqualTo(CAD_Topo.EdgeInLoop(edge_h, inner), 1) ThenBlock: { ReturnValue(1) }
            inner = CAD_Store.Read(inner, 2)
            g = Add(g, 1)
            IfCondition GreaterThan(g, 8) ThenBlock: { inner = 0 }
        }
        ReturnValue(0)
    }
}

// Point-in-solid: even-odd ray vs planar faces. Ray dir is biased off-axis
// so axis-aligned box/step faces are never parallel. 1 inside, 0 out.
// All state on CAD_Topo_PIS — FaceGetPlane / PointInFaceUV clobber locals.
FixedPool.CAD_Topo_PIS {
    "solid": Initialize=0, CanChange=True
    "px": Initialize=0, CanChange=True
    "py": Initialize=0, CanChange=True
    "pz": Initialize=0, CanChange=True
    "dx": Initialize=0, CanChange=True
    "dy": Initialize=0, CanChange=True
    "dz": Initialize=0, CanChange=True
    "inside": Initialize=0, CanChange=True
    "pl": Initialize=0, CanChange=True
    "hitp": Initialize=0, CanChange=True
    "face": Initialize=0, CanChange=True
    "shell": Initialize=0, CanChange=True
    "next_face": Initialize=0, CanChange=True
    "next_shell": Initialize=0, CanChange=True
    "sguard": Initialize=0, CanChange=True
    "fguard": Initialize=0, CanChange=True
    "den": Initialize=0, CanChange=True
    "t": Initialize=0, CanChange=True
}

Function.CAD_Topo.PointInSolid {
    Input: solid_handle: Integer
    Input: xyz: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(xyz, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_PIS.solid = solid_handle
        CAD_Topo_PIS.px = ArrayGet(xyz, 0)
        CAD_Topo_PIS.py = ArrayGet(xyz, 1)
        CAD_Topo_PIS.pz = ArrayGet(xyz, 2)
        // (1, 0.13, 0.37) — no AABB face is parallel
        CAD_Topo_PIS.dx = 0x3FF0000000000000
        CAD_Topo_PIS.dy = 0x3FC0A3D70A3D70A4
        CAD_Topo_PIS.dz = 0x3FD7AE147AE147AE
        CAD_Topo_PIS.inside = 0
        IfCondition EqualTo(CAD_Topo_PIS.pl, 0) ThenBlock: { CAD_Topo_PIS.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_PIS.hitp, 0) ThenBlock: { CAD_Topo_PIS.hitp = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_PIS.pl, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_PIS.shell = CAD_Store.Read(CAD_Topo_PIS.solid, 0)
        CAD_Topo_PIS.sguard = 0
        WhileLoop NotEqual(CAD_Topo_PIS.shell, 0) {
            CAD_Topo_PIS.next_shell = CAD_Store.Read(CAD_Topo_PIS.shell, 2)
            CAD_Topo_PIS.face = CAD_Store.Read(CAD_Topo_PIS.shell, 0)
            CAD_Topo_PIS.fguard = 0
            WhileLoop NotEqual(CAD_Topo_PIS.face, 0) {
                CAD_Topo_PIS.next_face = CAD_Store.Read(CAD_Topo_PIS.face, 3)
                IfCondition EqualTo(CAD_Topo.FaceGetPlane(CAD_Topo_PIS.face, CAD_Topo_PIS.pl), 0) ThenBlock: {
                    CAD_Topo_PIS.den = Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Topo_PIS.pl, 10), CAD_Topo_PIS.dx), Float_Mul(ArrayGet(CAD_Topo_PIS.pl, 11), CAD_Topo_PIS.dy)), Float_Mul(ArrayGet(CAD_Topo_PIS.pl, 12), CAD_Topo_PIS.dz))
                    IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_PIS.den, 0), 0) ThenBlock: {
                        CAD_Topo_PIS.t = Float_Sub(ArrayGet(CAD_Topo_PIS.pl, 1), CAD_Topo_PIS.px)
                        CAD_Topo_PIS.t = Float_Mul(ArrayGet(CAD_Topo_PIS.pl, 10), CAD_Topo_PIS.t)
                        CAD_Topo_PIS.t = Float_Add(CAD_Topo_PIS.t, Float_Mul(ArrayGet(CAD_Topo_PIS.pl, 11), Float_Sub(ArrayGet(CAD_Topo_PIS.pl, 2), CAD_Topo_PIS.py)))
                        CAD_Topo_PIS.t = Float_Add(CAD_Topo_PIS.t, Float_Mul(ArrayGet(CAD_Topo_PIS.pl, 12), Float_Sub(ArrayGet(CAD_Topo_PIS.pl, 3), CAD_Topo_PIS.pz)))
                        CAD_Topo_PIS.t = Float_Div(CAD_Topo_PIS.t, CAD_Topo_PIS.den)
                        IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_PIS.t), 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_PIS.t, 0), 0) ThenBlock: {
                                ArraySet(CAD_Topo_PIS.hitp, 0, Float_Add(CAD_Topo_PIS.px, Float_Mul(CAD_Topo_PIS.t, CAD_Topo_PIS.dx)))
                                ArraySet(CAD_Topo_PIS.hitp, 1, Float_Add(CAD_Topo_PIS.py, Float_Mul(CAD_Topo_PIS.t, CAD_Topo_PIS.dy)))
                                ArraySet(CAD_Topo_PIS.hitp, 2, Float_Add(CAD_Topo_PIS.pz, Float_Mul(CAD_Topo_PIS.t, CAD_Topo_PIS.dz)))
                                IfCondition EqualTo(CAD_Topo.PointInFaceUV(CAD_Topo_PIS.face, CAD_Topo_PIS.hitp), 1) ThenBlock: {
                                    CAD_Topo_PIS.inside = Subtract(1, CAD_Topo_PIS.inside)
                                }
                            }
                        }
                    }
                }
                CAD_Topo_PIS.face = CAD_Topo_PIS.next_face
                CAD_Topo_PIS.fguard = Add(CAD_Topo_PIS.fguard, 1)
                IfCondition GreaterThan(CAD_Topo_PIS.fguard, 512) ThenBlock: { CAD_Topo_PIS.face = 0 }
            }
            CAD_Topo_PIS.shell = CAD_Topo_PIS.next_shell
            CAD_Topo_PIS.sguard = Add(CAD_Topo_PIS.sguard, 1)
            IfCondition GreaterThan(CAD_Topo_PIS.sguard, 64) ThenBlock: { CAD_Topo_PIS.shell = 0 }
        }
        ReturnValue(CAD_Topo_PIS.inside)
    }
}

// Classify a plane–plane edge by VOID occupancy of the four N1/N2 quadrants.
// Outward normals. Probe M ± ε N1 ± ε N2:
//   1 inside  → convex FILLET (void > 180°, ball on the rim)
//   3 inside  → concave COVE  (void ≤ 180°, ball in the pocket)
// N1·N2 is 90° for both a box rim and a boss-on-plate step — occupancy
// is the measure, not inner-loop heuristics.
// Returns 1 = cove, 0 = fillet.
FixedPool.CAD_Topo_Cove {
    "solid": Initialize=0, CanChange=True
    "edge": Initialize=0, CanChange=True
    "faces": Initialize=0, CanChange=True
    "xyz": Initialize=0, CanChange=True
    "pl": Initialize=0, CanChange=True
    "f1": Initialize=0, CanChange=True
    "f2": Initialize=0, CanChange=True
    "n1x": Initialize=0, CanChange=True
    "n1y": Initialize=0, CanChange=True
    "n1z": Initialize=0, CanChange=True
    "n2x": Initialize=0, CanChange=True
    "n2y": Initialize=0, CanChange=True
    "n2z": Initialize=0, CanChange=True
    "mx": Initialize=0, CanChange=True
    "my": Initialize=0, CanChange=True
    "mz": Initialize=0, CanChange=True
    "eps": Initialize=0, CanChange=True
    "nin": Initialize=0, CanChange=True
    "si": Initialize=0, CanChange=True
    "sj": Initialize=0, CanChange=True
    "s1": Initialize=0, CanChange=True
    "s2": Initialize=0, CanChange=True
    "ln": Initialize=0, CanChange=True
}

Function.CAD_Topo.EdgeIsCove {
    Input: solid_handle: Integer
    Input: edge_handle: Integer
    Output: Integer
    Body: {
        CAD_Topo_State.fillet_nin = 0
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_Cove.solid = solid_handle
        CAD_Topo_Cove.edge = edge_handle
        IfCondition EqualTo(CAD_Topo_Cove.faces, 0) ThenBlock: { CAD_Topo_Cove.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_Cove.xyz, 0) ThenBlock: { CAD_Topo_Cove.xyz = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_Cove.pl, 0) ThenBlock: { CAD_Topo_Cove.pl = Allocate(128) }
        IfCondition EqualTo(CAD_Topo_Cove.faces, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_Cove.edge, CAD_Topo_Cove.faces), 0) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Topo_Cove.f1 = ArrayGet(CAD_Topo_Cove.faces, 0)
        CAD_Topo_Cove.f2 = ArrayGet(CAD_Topo_Cove.faces, 1)
        IfCondition EqualTo(CAD_Topo_Cove.f1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_Cove.f2, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_Cove.f1, CAD_Topo_Cove.pl), 0) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Topo_Cove.n1x = ArrayGet(CAD_Topo_Cove.pl, 10)
        CAD_Topo_Cove.n1y = ArrayGet(CAD_Topo_Cove.pl, 11)
        CAD_Topo_Cove.n1z = ArrayGet(CAD_Topo_Cove.pl, 12)
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_Cove.f2, CAD_Topo_Cove.pl), 0) ThenBlock: {
            ReturnValue(0)
        }
        CAD_Topo_Cove.n2x = ArrayGet(CAD_Topo_Cove.pl, 10)
        CAD_Topo_Cove.n2y = ArrayGet(CAD_Topo_Cove.pl, 11)
        CAD_Topo_Cove.n2z = ArrayGet(CAD_Topo_Cove.pl, 12)
        CAD_Topo_Cove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_Cove.n1x, CAD_Topo_Cove.n1x), Float_Mul(CAD_Topo_Cove.n1y, CAD_Topo_Cove.n1y)), Float_Mul(CAD_Topo_Cove.n1z, CAD_Topo_Cove.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_Cove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_Cove.n1x = Float_Div(CAD_Topo_Cove.n1x, CAD_Topo_Cove.ln)
        CAD_Topo_Cove.n1y = Float_Div(CAD_Topo_Cove.n1y, CAD_Topo_Cove.ln)
        CAD_Topo_Cove.n1z = Float_Div(CAD_Topo_Cove.n1z, CAD_Topo_Cove.ln)
        CAD_Topo_Cove.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_Cove.n2x, CAD_Topo_Cove.n2x), Float_Mul(CAD_Topo_Cove.n2y, CAD_Topo_Cove.n2y)), Float_Mul(CAD_Topo_Cove.n2z, CAD_Topo_Cove.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_Cove.ln, 0), 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_Cove.n2x = Float_Div(CAD_Topo_Cove.n2x, CAD_Topo_Cove.ln)
        CAD_Topo_Cove.n2y = Float_Div(CAD_Topo_Cove.n2y, CAD_Topo_Cove.ln)
        CAD_Topo_Cove.n2z = Float_Div(CAD_Topo_Cove.n2z, CAD_Topo_Cove.ln)
        CAD_Topo_Cove.ln = CAD_Store.Read(CAD_Topo_Cove.edge, 0)
        IfCondition EqualTo(CAD_Topo_Cove.ln, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_Cove.mx = CAD_Store.Read(CAD_Topo_Cove.ln, 0)
        CAD_Topo_Cove.my = CAD_Store.Read(CAD_Topo_Cove.ln, 1)
        CAD_Topo_Cove.mz = CAD_Store.Read(CAD_Topo_Cove.ln, 2)
        CAD_Topo_Cove.ln = CAD_Store.Read(CAD_Topo_Cove.edge, 1)
        IfCondition EqualTo(CAD_Topo_Cove.ln, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_Cove.mx = Float_Mul(Float_Add(CAD_Topo_Cove.mx, CAD_Store.Read(CAD_Topo_Cove.ln, 0)), 0x3FE0000000000000)
        CAD_Topo_Cove.my = Float_Mul(Float_Add(CAD_Topo_Cove.my, CAD_Store.Read(CAD_Topo_Cove.ln, 1)), 0x3FE0000000000000)
        CAD_Topo_Cove.mz = Float_Mul(Float_Add(CAD_Topo_Cove.mz, CAD_Store.Read(CAD_Topo_Cove.ln, 2)), 0x3FE0000000000000)
        // 0.5 mm off the edge — local vs R, off the planes
        CAD_Topo_Cove.eps = 0x3FE0000000000000
        CAD_Topo_Cove.nin = 0
        CAD_Topo_Cove.si = 0
        WhileLoop LessThan(CAD_Topo_Cove.si, 2) {
            CAD_Topo_Cove.sj = 0
            WhileLoop LessThan(CAD_Topo_Cove.sj, 2) {
                CAD_Topo_Cove.s1 = 0x3FF0000000000000
                IfCondition EqualTo(CAD_Topo_Cove.si, 0) ThenBlock: { CAD_Topo_Cove.s1 = 0xBFF0000000000000 }
                CAD_Topo_Cove.s2 = 0x3FF0000000000000
                IfCondition EqualTo(CAD_Topo_Cove.sj, 0) ThenBlock: { CAD_Topo_Cove.s2 = 0xBFF0000000000000 }
                ArraySet(CAD_Topo_Cove.xyz, 0, Float_Add(CAD_Topo_Cove.mx, Float_Add(Float_Mul(Float_Mul(CAD_Topo_Cove.s1, CAD_Topo_Cove.eps), CAD_Topo_Cove.n1x), Float_Mul(Float_Mul(CAD_Topo_Cove.s2, CAD_Topo_Cove.eps), CAD_Topo_Cove.n2x))))
                ArraySet(CAD_Topo_Cove.xyz, 1, Float_Add(CAD_Topo_Cove.my, Float_Add(Float_Mul(Float_Mul(CAD_Topo_Cove.s1, CAD_Topo_Cove.eps), CAD_Topo_Cove.n1y), Float_Mul(Float_Mul(CAD_Topo_Cove.s2, CAD_Topo_Cove.eps), CAD_Topo_Cove.n2y))))
                ArraySet(CAD_Topo_Cove.xyz, 2, Float_Add(CAD_Topo_Cove.mz, Float_Add(Float_Mul(Float_Mul(CAD_Topo_Cove.s1, CAD_Topo_Cove.eps), CAD_Topo_Cove.n1z), Float_Mul(Float_Mul(CAD_Topo_Cove.s2, CAD_Topo_Cove.eps), CAD_Topo_Cove.n2z))))
                IfCondition EqualTo(CAD_Topo.PointInSolid(CAD_Topo_Cove.solid, CAD_Topo_Cove.xyz), 1) ThenBlock: {
                    CAD_Topo_Cove.nin = Add(CAD_Topo_Cove.nin, 1)
                }
                CAD_Topo_Cove.sj = Add(CAD_Topo_Cove.sj, 1)
            }
            CAD_Topo_Cove.si = Add(CAD_Topo_Cove.si, 1)
        }
        CAD_Topo_State.fillet_nin = CAD_Topo_Cove.nin
        PrintMessage("topo EdgeIsCove nin=")
        PrintNumber(CAD_Topo_Cove.nin)
        PrintMessage("\n")
        CAD_Topo_Cove.s1 = 0
        IfCondition EqualTo(CAD_Topo_Cove.nin, 3) ThenBlock: { CAD_Topo_Cove.s1 = 1 }
        // Hole ID is an inner loop with void>180 (nin<=1) — convex, not cove.
        // Inner-loop force turned washer/stadium holes into coves (torn ID).
        IfCondition EqualTo(CAD_Topo_Cove.s1, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Topo_Cove.nin, 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(CAD_Topo_Cove.s1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo.EdgeOnInnerLoop(CAD_Topo_Cove.edge, CAD_Topo_Cove.f1), 1) ThenBlock: {
            CAD_Topo_State.fillet_host_f = CAD_Topo_Cove.f1
        }
        IfCondition EqualTo(CAD_Topo.EdgeOnInnerLoop(CAD_Topo_Cove.edge, CAD_Topo_Cove.f2), 1) ThenBlock: {
            CAD_Topo_State.fillet_host_f = CAD_Topo_Cove.f2
        }
        ReturnValue(1)
    }
}

// 1 if any selected edge meets a non-plane (cyl/torus). LINE occupancy
// then cannot be trusted: PointInSolid even-odd skips those walls, so a
// mixed rim LINE can read nin>=3 and the whole chain becomes a cove.
Function.CAD_Topo.SelHasNonPlaneWall {
    Input: edges_addr: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edges_addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_Cove.faces, 0) ThenBlock: { CAD_Topo_Cove.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_Cove.faces, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_Cove.si = 0
        WhileLoop LessThan(CAD_Topo_Cove.si, n) {
            CAD_Topo_Cove.edge = ArrayGet(edges_addr, CAD_Topo_Cove.si)
            IfCondition NotEqual(CAD_Topo_Cove.edge, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_Cove.edge, CAD_Topo_Cove.faces), 0) ThenBlock: {
                    CAD_Topo_Cove.f1 = ArrayGet(CAD_Topo_Cove.faces, 0)
                    CAD_Topo_Cove.f2 = ArrayGet(CAD_Topo_Cove.faces, 1)
                    IfCondition NotEqual(CAD_Topo_Cove.f1, 0) ThenBlock: {
                        CAD_Topo_Cove.ln = CAD_Store.Read(CAD_Topo_Cove.f1, 0)
                        IfCondition NotEqual(CAD_Topo_Cove.ln, 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_Cove.ln, 0), 1) ThenBlock: { ReturnValue(1) }
                        }
                    }
                    IfCondition NotEqual(CAD_Topo_Cove.f2, 0) ThenBlock: {
                        CAD_Topo_Cove.ln = CAD_Store.Read(CAD_Topo_Cove.f2, 0)
                        IfCondition NotEqual(CAD_Topo_Cove.ln, 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_Cove.ln, 0), 1) ThenBlock: { ReturnValue(1) }
                        }
                    }
                }
            }
            CAD_Topo_Cove.si = Add(CAD_Topo_Cove.si, 1)
        }
        ReturnValue(0)
    }
}

// Edge signature for rebind after a rebuild (handles go stale).
// pack[12]: N1[0..2] N2[3..5] dir[6..8] mid[9..11]. Returns 0 ok, -1 fail.
FixedPool.CAD_Topo_FindE {
    "solid": Initialize=0, CanChange=True
    "edge": Initialize=0, CanChange=True
    "pack": Initialize=0, CanChange=True
    "faces": Initialize=0, CanChange=True
    "pl": Initialize=0, CanChange=True
    "buf": Initialize=0, CanChange=True
    "n1x": Initialize=0, CanChange=True
    "n1y": Initialize=0, CanChange=True
    "n1z": Initialize=0, CanChange=True
    "n2x": Initialize=0, CanChange=True
    "n2y": Initialize=0, CanChange=True
    "n2z": Initialize=0, CanChange=True
    "dx": Initialize=0, CanChange=True
    "dy": Initialize=0, CanChange=True
    "dz": Initialize=0, CanChange=True
    "mx": Initialize=0, CanChange=True
    "my": Initialize=0, CanChange=True
    "mz": Initialize=0, CanChange=True
    "ln": Initialize=0, CanChange=True
    "i": Initialize=0, CanChange=True
    "n": Initialize=0, CanChange=True
    "best": Initialize=0, CanChange=True
    "best_d": Initialize=0, CanChange=True
    "ad": Initialize=0, CanChange=True
    "ok": Initialize=0, CanChange=True
    "v0": Initialize=0, CanChange=True
    "v1": Initialize=0, CanChange=True
}

Function.CAD_Topo.EdgeSigFill {
    Input: edge_handle: Integer
    Input: pack_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Topo_FindE.edge = edge_handle
        CAD_Topo_FindE.pack = pack_addr
        IfCondition EqualTo(CAD_Topo_FindE.faces, 0) ThenBlock: { CAD_Topo_FindE.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FindE.pl, 0) ThenBlock: { CAD_Topo_FindE.pl = Allocate(128) }
        IfCondition NotEqual(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FindE.edge, CAD_Topo_FindE.faces), 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(ArrayGet(CAD_Topo_FindE.faces, 0), CAD_Topo_FindE.pl), 0) ThenBlock: {
            ReturnValue(-1)
        }
        CAD_Topo_FindE.n1x = ArrayGet(CAD_Topo_FindE.pl, 10)
        CAD_Topo_FindE.n1y = ArrayGet(CAD_Topo_FindE.pl, 11)
        CAD_Topo_FindE.n1z = ArrayGet(CAD_Topo_FindE.pl, 12)
        IfCondition NotEqual(CAD_Topo.FaceGetPlane(ArrayGet(CAD_Topo_FindE.faces, 1), CAD_Topo_FindE.pl), 0) ThenBlock: {
            ReturnValue(-1)
        }
        CAD_Topo_FindE.n2x = ArrayGet(CAD_Topo_FindE.pl, 10)
        CAD_Topo_FindE.n2y = ArrayGet(CAD_Topo_FindE.pl, 11)
        CAD_Topo_FindE.n2z = ArrayGet(CAD_Topo_FindE.pl, 12)
        CAD_Topo_FindE.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.n1x, CAD_Topo_FindE.n1x), Float_Mul(CAD_Topo_FindE.n1y, CAD_Topo_FindE.n1y)), Float_Mul(CAD_Topo_FindE.n1z, CAD_Topo_FindE.n1z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FindE.ln, 0), 1) ThenBlock: { ReturnValue(-1) }
        CAD_Topo_FindE.n1x = Float_Div(CAD_Topo_FindE.n1x, CAD_Topo_FindE.ln)
        CAD_Topo_FindE.n1y = Float_Div(CAD_Topo_FindE.n1y, CAD_Topo_FindE.ln)
        CAD_Topo_FindE.n1z = Float_Div(CAD_Topo_FindE.n1z, CAD_Topo_FindE.ln)
        CAD_Topo_FindE.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.n2x, CAD_Topo_FindE.n2x), Float_Mul(CAD_Topo_FindE.n2y, CAD_Topo_FindE.n2y)), Float_Mul(CAD_Topo_FindE.n2z, CAD_Topo_FindE.n2z)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FindE.ln, 0), 1) ThenBlock: { ReturnValue(-1) }
        CAD_Topo_FindE.n2x = Float_Div(CAD_Topo_FindE.n2x, CAD_Topo_FindE.ln)
        CAD_Topo_FindE.n2y = Float_Div(CAD_Topo_FindE.n2y, CAD_Topo_FindE.ln)
        CAD_Topo_FindE.n2z = Float_Div(CAD_Topo_FindE.n2z, CAD_Topo_FindE.ln)
        CAD_Topo_FindE.v0 = CAD_Store.Read(CAD_Topo_FindE.edge, 0)
        CAD_Topo_FindE.v1 = CAD_Store.Read(CAD_Topo_FindE.edge, 1)
        IfCondition EqualTo(CAD_Topo_FindE.v0, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Topo_FindE.v1, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Topo_FindE.dx = Float_Sub(CAD_Store.Read(CAD_Topo_FindE.v1, 0), CAD_Store.Read(CAD_Topo_FindE.v0, 0))
        CAD_Topo_FindE.dy = Float_Sub(CAD_Store.Read(CAD_Topo_FindE.v1, 1), CAD_Store.Read(CAD_Topo_FindE.v0, 1))
        CAD_Topo_FindE.dz = Float_Sub(CAD_Store.Read(CAD_Topo_FindE.v1, 2), CAD_Store.Read(CAD_Topo_FindE.v0, 2))
        CAD_Topo_FindE.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.dx, CAD_Topo_FindE.dx), Float_Mul(CAD_Topo_FindE.dy, CAD_Topo_FindE.dy)), Float_Mul(CAD_Topo_FindE.dz, CAD_Topo_FindE.dz)))
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FindE.ln, 0), 1) ThenBlock: { ReturnValue(-1) }
        CAD_Topo_FindE.dx = Float_Div(CAD_Topo_FindE.dx, CAD_Topo_FindE.ln)
        CAD_Topo_FindE.dy = Float_Div(CAD_Topo_FindE.dy, CAD_Topo_FindE.ln)
        CAD_Topo_FindE.dz = Float_Div(CAD_Topo_FindE.dz, CAD_Topo_FindE.ln)
        CAD_Topo_FindE.mx = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FindE.v0, 0), CAD_Store.Read(CAD_Topo_FindE.v1, 0)), 0x3FE0000000000000)
        CAD_Topo_FindE.my = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FindE.v0, 1), CAD_Store.Read(CAD_Topo_FindE.v1, 1)), 0x3FE0000000000000)
        CAD_Topo_FindE.mz = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FindE.v0, 2), CAD_Store.Read(CAD_Topo_FindE.v1, 2)), 0x3FE0000000000000)
        ArraySet(CAD_Topo_FindE.pack, 0, CAD_Topo_FindE.n1x)
        ArraySet(CAD_Topo_FindE.pack, 1, CAD_Topo_FindE.n1y)
        ArraySet(CAD_Topo_FindE.pack, 2, CAD_Topo_FindE.n1z)
        ArraySet(CAD_Topo_FindE.pack, 3, CAD_Topo_FindE.n2x)
        ArraySet(CAD_Topo_FindE.pack, 4, CAD_Topo_FindE.n2y)
        ArraySet(CAD_Topo_FindE.pack, 5, CAD_Topo_FindE.n2z)
        ArraySet(CAD_Topo_FindE.pack, 6, CAD_Topo_FindE.dx)
        ArraySet(CAD_Topo_FindE.pack, 7, CAD_Topo_FindE.dy)
        ArraySet(CAD_Topo_FindE.pack, 8, CAD_Topo_FindE.dz)
        ArraySet(CAD_Topo_FindE.pack, 9, CAD_Topo_FindE.mx)
        ArraySet(CAD_Topo_FindE.pack, 10, CAD_Topo_FindE.my)
        ArraySet(CAD_Topo_FindE.pack, 11, CAD_Topo_FindE.mz)
        ReturnValue(0)
    }
}

// Find a live edge on solid whose two planes + direction match pack.
// Midpoint is the tie-break (adjacent fillet moves one end by ~R).
Function.CAD_Topo.FindEdgeBySig {
    Input: solid_handle: Integer
    Input: pack_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pack_addr, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FindE.solid = solid_handle
        CAD_Topo_FindE.pack = pack_addr
        IfCondition EqualTo(CAD_Topo_FindE.buf, 0) ThenBlock: { CAD_Topo_FindE.buf = Allocate(2048) }
        IfCondition EqualTo(CAD_Topo_FindE.faces, 0) ThenBlock: { CAD_Topo_FindE.faces = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_FindE.pl, 0) ThenBlock: { CAD_Topo_FindE.pl = Allocate(128) }
        CAD_Topo_FindE.n = CAD_Topo.SolidCollectEdges(CAD_Topo_FindE.solid, CAD_Topo_FindE.buf, 256)
        IfCondition LessThan(CAD_Topo_FindE.n, 1) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FindE.best = 0
        CAD_Topo_FindE.best_d = 0x40C3880000000000
        CAD_Topo_FindE.i = 0
        WhileLoop LessThan(CAD_Topo_FindE.i, CAD_Topo_FindE.n) {
            CAD_Topo_FindE.edge = ArrayGet(CAD_Topo_FindE.buf, CAD_Topo_FindE.i)
            CAD_Topo_FindE.ok = 0
            IfCondition NotEqual(CAD_Topo_FindE.edge, 0) ThenBlock: {
                IfCondition EqualTo(CAD_Topo.EdgeIncidentFaces(CAD_Topo_FindE.edge, CAD_Topo_FindE.faces), 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Topo.FaceGetPlane(ArrayGet(CAD_Topo_FindE.faces, 0), CAD_Topo_FindE.pl), 0) ThenBlock: {
                        CAD_Topo_FindE.n1x = ArrayGet(CAD_Topo_FindE.pl, 10)
                        CAD_Topo_FindE.n1y = ArrayGet(CAD_Topo_FindE.pl, 11)
                        CAD_Topo_FindE.n1z = ArrayGet(CAD_Topo_FindE.pl, 12)
                        IfCondition EqualTo(CAD_Topo.FaceGetPlane(ArrayGet(CAD_Topo_FindE.faces, 1), CAD_Topo_FindE.pl), 0) ThenBlock: {
                            CAD_Topo_FindE.n2x = ArrayGet(CAD_Topo_FindE.pl, 10)
                            CAD_Topo_FindE.n2y = ArrayGet(CAD_Topo_FindE.pl, 11)
                            CAD_Topo_FindE.n2z = ArrayGet(CAD_Topo_FindE.pl, 12)
                            CAD_Topo_FindE.ok = 1
                        }
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FindE.ok, 1) ThenBlock: {
                CAD_Topo_FindE.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.n1x, CAD_Topo_FindE.n1x), Float_Mul(CAD_Topo_FindE.n1y, CAD_Topo_FindE.n1y)), Float_Mul(CAD_Topo_FindE.n1z, CAD_Topo_FindE.n1z)))
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FindE.ln, 0), 1) ThenBlock: { CAD_Topo_FindE.ok = 0 }
            }
            IfCondition EqualTo(CAD_Topo_FindE.ok, 1) ThenBlock: {
                CAD_Topo_FindE.n1x = Float_Div(CAD_Topo_FindE.n1x, CAD_Topo_FindE.ln)
                CAD_Topo_FindE.n1y = Float_Div(CAD_Topo_FindE.n1y, CAD_Topo_FindE.ln)
                CAD_Topo_FindE.n1z = Float_Div(CAD_Topo_FindE.n1z, CAD_Topo_FindE.ln)
                CAD_Topo_FindE.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.n2x, CAD_Topo_FindE.n2x), Float_Mul(CAD_Topo_FindE.n2y, CAD_Topo_FindE.n2y)), Float_Mul(CAD_Topo_FindE.n2z, CAD_Topo_FindE.n2z)))
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FindE.ln, 0), 1) ThenBlock: { CAD_Topo_FindE.ok = 0 }
            }
            IfCondition EqualTo(CAD_Topo_FindE.ok, 1) ThenBlock: {
                CAD_Topo_FindE.n2x = Float_Div(CAD_Topo_FindE.n2x, CAD_Topo_FindE.ln)
                CAD_Topo_FindE.n2y = Float_Div(CAD_Topo_FindE.n2y, CAD_Topo_FindE.ln)
                CAD_Topo_FindE.n2z = Float_Div(CAD_Topo_FindE.n2z, CAD_Topo_FindE.ln)
                // plane pair (either order), |dot| >= 0.92
                CAD_Topo_FindE.ad = Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.n1x, ArrayGet(CAD_Topo_FindE.pack, 0)), Float_Mul(CAD_Topo_FindE.n1y, ArrayGet(CAD_Topo_FindE.pack, 1))), Float_Mul(CAD_Topo_FindE.n1z, ArrayGet(CAD_Topo_FindE.pack, 2)))
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FindE.ad), 1) ThenBlock: { CAD_Topo_FindE.ad = Float_Sub(0, CAD_Topo_FindE.ad) }
                CAD_Topo_FindE.dx = Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.n2x, ArrayGet(CAD_Topo_FindE.pack, 3)), Float_Mul(CAD_Topo_FindE.n2y, ArrayGet(CAD_Topo_FindE.pack, 4))), Float_Mul(CAD_Topo_FindE.n2z, ArrayGet(CAD_Topo_FindE.pack, 5)))
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FindE.dx), 1) ThenBlock: { CAD_Topo_FindE.dx = Float_Sub(0, CAD_Topo_FindE.dx) }
                CAD_Topo_FindE.dy = Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.n1x, ArrayGet(CAD_Topo_FindE.pack, 3)), Float_Mul(CAD_Topo_FindE.n1y, ArrayGet(CAD_Topo_FindE.pack, 4))), Float_Mul(CAD_Topo_FindE.n1z, ArrayGet(CAD_Topo_FindE.pack, 5)))
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FindE.dy), 1) ThenBlock: { CAD_Topo_FindE.dy = Float_Sub(0, CAD_Topo_FindE.dy) }
                CAD_Topo_FindE.dz = Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.n2x, ArrayGet(CAD_Topo_FindE.pack, 0)), Float_Mul(CAD_Topo_FindE.n2y, ArrayGet(CAD_Topo_FindE.pack, 1))), Float_Mul(CAD_Topo_FindE.n2z, ArrayGet(CAD_Topo_FindE.pack, 2)))
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FindE.dz), 1) ThenBlock: { CAD_Topo_FindE.dz = Float_Sub(0, CAD_Topo_FindE.dz) }
                CAD_Topo_FindE.ok = 0
                IfCondition EqualTo(CAD_Num.Le(0x3FED70A3D70A3D71, CAD_Topo_FindE.ad), 1) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(0x3FED70A3D70A3D71, CAD_Topo_FindE.dx), 1) ThenBlock: { CAD_Topo_FindE.ok = 1 }
                }
                IfCondition EqualTo(CAD_Topo_FindE.ok, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Num.Le(0x3FED70A3D70A3D71, CAD_Topo_FindE.dy), 1) ThenBlock: {
                        IfCondition EqualTo(CAD_Num.Le(0x3FED70A3D70A3D71, CAD_Topo_FindE.dz), 1) ThenBlock: { CAD_Topo_FindE.ok = 1 }
                    }
                }
            }
            IfCondition EqualTo(CAD_Topo_FindE.ok, 1) ThenBlock: {
                CAD_Topo_FindE.v0 = CAD_Store.Read(CAD_Topo_FindE.edge, 0)
                CAD_Topo_FindE.v1 = CAD_Store.Read(CAD_Topo_FindE.edge, 1)
                IfCondition EqualTo(CAD_Topo_FindE.v0, 0) ThenBlock: { CAD_Topo_FindE.ok = 0 }
                IfCondition EqualTo(CAD_Topo_FindE.v1, 0) ThenBlock: { CAD_Topo_FindE.ok = 0 }
            }
            IfCondition EqualTo(CAD_Topo_FindE.ok, 1) ThenBlock: {
                CAD_Topo_FindE.mx = Float_Sub(CAD_Store.Read(CAD_Topo_FindE.v1, 0), CAD_Store.Read(CAD_Topo_FindE.v0, 0))
                CAD_Topo_FindE.my = Float_Sub(CAD_Store.Read(CAD_Topo_FindE.v1, 1), CAD_Store.Read(CAD_Topo_FindE.v0, 1))
                CAD_Topo_FindE.mz = Float_Sub(CAD_Store.Read(CAD_Topo_FindE.v1, 2), CAD_Store.Read(CAD_Topo_FindE.v0, 2))
                CAD_Topo_FindE.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.mx, CAD_Topo_FindE.mx), Float_Mul(CAD_Topo_FindE.my, CAD_Topo_FindE.my)), Float_Mul(CAD_Topo_FindE.mz, CAD_Topo_FindE.mz)))
                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FindE.ln, 0), 1) ThenBlock: { CAD_Topo_FindE.ok = 0 }
            }
            IfCondition EqualTo(CAD_Topo_FindE.ok, 1) ThenBlock: {
                CAD_Topo_FindE.mx = Float_Div(CAD_Topo_FindE.mx, CAD_Topo_FindE.ln)
                CAD_Topo_FindE.my = Float_Div(CAD_Topo_FindE.my, CAD_Topo_FindE.ln)
                CAD_Topo_FindE.mz = Float_Div(CAD_Topo_FindE.mz, CAD_Topo_FindE.ln)
                CAD_Topo_FindE.ad = Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.mx, ArrayGet(CAD_Topo_FindE.pack, 6)), Float_Mul(CAD_Topo_FindE.my, ArrayGet(CAD_Topo_FindE.pack, 7))), Float_Mul(CAD_Topo_FindE.mz, ArrayGet(CAD_Topo_FindE.pack, 8)))
                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FindE.ad), 1) ThenBlock: { CAD_Topo_FindE.ad = Float_Sub(0, CAD_Topo_FindE.ad) }
                IfCondition EqualTo(CAD_Num.Le(0x3FED70A3D70A3D71, CAD_Topo_FindE.ad), 0) ThenBlock: { CAD_Topo_FindE.ok = 0 }
            }
            IfCondition EqualTo(CAD_Topo_FindE.ok, 1) ThenBlock: {
                CAD_Topo_FindE.mx = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FindE.v0, 0), CAD_Store.Read(CAD_Topo_FindE.v1, 0)), 0x3FE0000000000000)
                CAD_Topo_FindE.my = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FindE.v0, 1), CAD_Store.Read(CAD_Topo_FindE.v1, 1)), 0x3FE0000000000000)
                CAD_Topo_FindE.mz = Float_Mul(Float_Add(CAD_Store.Read(CAD_Topo_FindE.v0, 2), CAD_Store.Read(CAD_Topo_FindE.v1, 2)), 0x3FE0000000000000)
                CAD_Topo_FindE.dx = Float_Sub(CAD_Topo_FindE.mx, ArrayGet(CAD_Topo_FindE.pack, 9))
                CAD_Topo_FindE.dy = Float_Sub(CAD_Topo_FindE.my, ArrayGet(CAD_Topo_FindE.pack, 10))
                CAD_Topo_FindE.dz = Float_Sub(CAD_Topo_FindE.mz, ArrayGet(CAD_Topo_FindE.pack, 11))
                CAD_Topo_FindE.ln = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(CAD_Topo_FindE.dx, CAD_Topo_FindE.dx), Float_Mul(CAD_Topo_FindE.dy, CAD_Topo_FindE.dy)), Float_Mul(CAD_Topo_FindE.dz, CAD_Topo_FindE.dz)))
                IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FindE.ln, CAD_Topo_FindE.best_d), 1) ThenBlock: {
                    CAD_Topo_FindE.best_d = CAD_Topo_FindE.ln
                    CAD_Topo_FindE.best = CAD_Topo_FindE.edge
                }
            }
            CAD_Topo_FindE.i = Add(CAD_Topo_FindE.i, 1)
        }
        ReturnValue(CAD_Topo_FindE.best)
    }
}

// Copy inner loops from old_face onto new_face, mapping verts via vmap_*.
// Reuses original curves so a cove hole stays a hole (not a filled plate).
FixedPool.CAD_Topo_InC {
    "old_f": Initialize=0, CanChange=True
    "new_f": Initialize=0, CanChange=True
    "inner": Initialize=0, CanChange=True
    "prev": Initialize=0, CanChange=True
    "nlist": Initialize=0, CanChange=True
    "carr": Initialize=0, CanChange=True
    "nn": Initialize=0, CanChange=True
    "i": Initialize=0, CanChange=True
    "ce": Initialize=0, CanChange=True
    "head": Initialize=0, CanChange=True
    "ov": Initialize=0, CanChange=True
    "nv": Initialize=0, CanChange=True
    "k": Initialize=0, CanChange=True
    "ua": Initialize=0, CanChange=True
    "ub": Initialize=0, CanChange=True
    "ee": Initialize=0, CanChange=True
    "crv": Initialize=0, CanChange=True
    "oed": Initialize=0, CanChange=True
    "g": Initialize=0, CanChange=True
}

Function.CAD_Topo.MapVmap {
    Input: ov: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ov, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_InC.k = 0
        WhileLoop LessThan(CAD_Topo_InC.k, CAD_Topo_State.vmap_n) {
            IfCondition EqualTo(ArrayGet(CAD_Topo_State.vmap_old, CAD_Topo_InC.k), ov) ThenBlock: {
                ReturnValue(ArrayGet(CAD_Topo_State.vmap_new, CAD_Topo_InC.k))
            }
            CAD_Topo_InC.k = Add(CAD_Topo_InC.k, 1)
        }
        ReturnValue(ov)
    }
}

Function.CAD_Topo.FaceCopyInners {
    Input: old_face: Integer
    Input: new_face: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(old_face, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_face, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_InC.old_f = old_face
        CAD_Topo_InC.new_f = new_face
        CAD_Topo_InC.prev = CAD_Store.Read(new_face, 1)
        IfCondition EqualTo(CAD_Topo_InC.prev, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Store.Read(old_face, 1), 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_InC.inner = CAD_Store.Read(CAD_Store.Read(old_face, 1), 2)
        IfCondition EqualTo(CAD_Topo_InC.inner, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Topo_InC.nlist, 0) ThenBlock: { CAD_Topo_InC.nlist = Allocate(16384) }
        IfCondition EqualTo(CAD_Topo_InC.carr, 0) ThenBlock: { CAD_Topo_InC.carr = Allocate(16384) }
        CAD_Topo_InC.g = 0
        WhileLoop NotEqual(CAD_Topo_InC.inner, 0) {
            IfCondition GreaterThan(CAD_Topo_InC.g, 8) ThenBlock: { CAD_Topo_InC.inner = 0 }
            IfCondition NotEqual(CAD_Topo_InC.inner, 0) ThenBlock: {
                CAD_Topo_InC.head = CAD_Store.Read(CAD_Topo_InC.inner, 0)
                CAD_Topo_InC.nn = 0
                CAD_Topo_InC.ce = CAD_Topo_InC.head
                CAD_Topo_InC.i = 0
                WhileLoop LessThan(CAD_Topo_InC.i, 2048) {
                    IfCondition EqualTo(CAD_Topo_InC.ce, 0) ThenBlock: { CAD_Topo_InC.i = 2048 }
                    IfCondition NotEqual(CAD_Topo_InC.ce, 0) ThenBlock: {
                        CAD_Topo_InC.nv = CAD_Topo.MapVmap(CAD_Store.Read(CAD_Topo_InC.ce, 5))
                        IfCondition NotEqual(CAD_Topo_InC.nv, 0) ThenBlock: {
                            ArraySet(CAD_Topo_InC.nlist, CAD_Topo_InC.nn, CAD_Topo_InC.nv)
                            CAD_Topo_InC.nn = Add(CAD_Topo_InC.nn, 1)
                        }
                        CAD_Topo_InC.ce = CAD_Store.Read(CAD_Topo_InC.ce, 2)
                        IfCondition EqualTo(CAD_Topo_InC.ce, CAD_Topo_InC.head) ThenBlock: { CAD_Topo_InC.i = 2048 }
                    }
                    CAD_Topo_InC.i = Add(CAD_Topo_InC.i, 1)
                }
                IfCondition GreaterEqual(CAD_Topo_InC.nn, 3) ThenBlock: {
                    CAD_Topo_InC.i = 0
                    CAD_Topo_InC.k = 0
                    WhileLoop LessThan(CAD_Topo_InC.i, CAD_Topo_InC.nn) {
                        CAD_Topo_InC.ua = ArrayGet(CAD_Topo_InC.nlist, CAD_Topo_InC.i)
                        IfCondition EqualTo(Add(CAD_Topo_InC.i, 1), CAD_Topo_InC.nn) ThenBlock: {
                            CAD_Topo_InC.ub = ArrayGet(CAD_Topo_InC.nlist, 0)
                        }
                        IfCondition NotEqual(Add(CAD_Topo_InC.i, 1), CAD_Topo_InC.nn) ThenBlock: {
                            CAD_Topo_InC.ub = ArrayGet(CAD_Topo_InC.nlist, Add(CAD_Topo_InC.i, 1))
                        }
                        CAD_Topo_InC.crv = 0
                        CAD_Topo_InC.ce = CAD_Topo_InC.head
                        CAD_Topo_InC.oed = 0
                        WhileLoop LessThan(CAD_Topo_InC.oed, 2048) {
                            IfCondition EqualTo(CAD_Topo_InC.ce, 0) ThenBlock: { CAD_Topo_InC.oed = 2048 }
                            IfCondition NotEqual(CAD_Topo_InC.ce, 0) ThenBlock: {
                                CAD_Topo_InC.ee = CAD_Store.Read(CAD_Topo_InC.ce, 0)
                                IfCondition NotEqual(CAD_Topo_InC.ee, 0) ThenBlock: {
                                    CAD_Topo_InC.ov = CAD_Topo.MapVmap(CAD_Store.Read(CAD_Topo_InC.ee, 0))
                                    CAD_Topo_InC.nv = CAD_Topo.MapVmap(CAD_Store.Read(CAD_Topo_InC.ee, 1))
                                    IfCondition EqualTo(CAD_Topo_InC.ov, CAD_Topo_InC.ua) ThenBlock: {
                                        IfCondition EqualTo(CAD_Topo_InC.nv, CAD_Topo_InC.ub) ThenBlock: {
                                            CAD_Topo_InC.crv = CAD_Store.Read(CAD_Topo_InC.ee, 2)
                                        }
                                    }
                                    IfCondition EqualTo(CAD_Topo_InC.ov, CAD_Topo_InC.ub) ThenBlock: {
                                        IfCondition EqualTo(CAD_Topo_InC.nv, CAD_Topo_InC.ua) ThenBlock: {
                                            CAD_Topo_InC.crv = CAD_Store.Read(CAD_Topo_InC.ee, 2)
                                        }
                                    }
                                }
                                CAD_Topo_InC.ce = CAD_Store.Read(CAD_Topo_InC.ce, 2)
                                IfCondition EqualTo(CAD_Topo_InC.ce, CAD_Topo_InC.head) ThenBlock: { CAD_Topo_InC.oed = 2048 }
                            }
                            CAD_Topo_InC.oed = Add(CAD_Topo_InC.oed, 1)
                        }
                        IfCondition EqualTo(CAD_Topo_InC.crv, 0) ThenBlock: { CAD_Topo_InC.i = CAD_Topo_InC.nn }
                        IfCondition NotEqual(CAD_Topo_InC.crv, 0) ThenBlock: {
                            CAD_Topo_InC.ee = CAD_Topo.MakeEdge(CAD_Topo_InC.ua, CAD_Topo_InC.ub, CAD_Topo_InC.crv)
                            IfCondition EqualTo(CAD_Topo_InC.ee, 0) ThenBlock: { CAD_Topo_InC.i = CAD_Topo_InC.nn }
                            IfCondition NotEqual(CAD_Topo_InC.ee, 0) ThenBlock: {
                                CAD_Topo_InC.ov = 1
                                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_InC.ee, 0), CAD_Topo_InC.ua) ThenBlock: { CAD_Topo_InC.ov = 0 }
                                CAD_Topo_InC.ce = CAD_Topo.MakeCoedge(CAD_Topo_InC.ee, CAD_Topo_InC.ua, CAD_Topo_InC.ov)
                                ArraySet(CAD_Topo_InC.carr, CAD_Topo_InC.k, CAD_Topo_InC.ce)
                                CAD_Topo_InC.k = Add(CAD_Topo_InC.k, 1)
                                IfCondition EqualTo(CAD_Store.Read(CAD_Topo_InC.ee, 3), 0) ThenBlock: {
                                    CAD_Store.Write(CAD_Topo_InC.ee, 3, CAD_Topo_InC.ce)
                                }
                            }
                        }
                        CAD_Topo_InC.i = Add(CAD_Topo_InC.i, 1)
                    }
                    IfCondition GreaterEqual(CAD_Topo_InC.k, 3) ThenBlock: {
                        CAD_Topo_InC.ee = CAD_Topo.MakeLoop(ArrayGet(CAD_Topo_InC.carr, 0))
                        CAD_Topo.LinkLoopRing(CAD_Topo_InC.carr, CAD_Topo_InC.k, CAD_Topo_InC.ee)
                        CAD_Store.Write(CAD_Topo_InC.prev, 2, CAD_Topo_InC.ee)
                        CAD_Store.Write(CAD_Topo_InC.ee, 1, CAD_Topo_InC.new_f)
                        CAD_Topo_InC.prev = CAD_Topo_InC.ee
                    }
                }
                CAD_Topo_InC.inner = CAD_Store.Read(CAD_Topo_InC.inner, 2)
            }
            CAD_Topo_InC.g = Add(CAD_Topo_InC.g, 1)
        }
        ReturnValue(1)
    }
}

FixedPool.CAD_Topo_FCE {
    "face": Initialize=0, CanChange=True
    "edge": Initialize=0, CanChange=True
    "lp": Initialize=0, CanChange=True
    "ce": Initialize=0, CanChange=True
    "hd": Initialize=0, CanChange=True
    "g": Initialize=0, CanChange=True
    "lg": Initialize=0, CanChange=True
    "solid": Initialize=0, CanChange=True
    "skip1": Initialize=0, CanChange=True
    "skip2": Initialize=0, CanChange=True
    "vert": Initialize=0, CanChange=True
    "sh": Initialize=0, CanChange=True
    "sg": Initialize=0, CanChange=True
    "fg": Initialize=0, CanChange=True
    "ok": Initialize=0, CanChange=True
    "dx": Initialize=0, CanChange=True
    "dy": Initialize=0, CanChange=True
    "dz": Initialize=0, CanChange=True
    "best": Initialize=0, CanChange=True
    "best_ad": Initialize=0, CanChange=True
    "ad": Initialize=0, CanChange=True
    "side": Initialize=0, CanChange=True
    "pl": Initialize=0, CanChange=True
}

Function.CAD_Topo.FindCoedgeOnFace {
    Input: face_h: Integer
    Input: edge_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCE.face = face_h
        CAD_Topo_FCE.edge = edge_h
        CAD_Topo_FCE.lp = CAD_Store.Read(face_h, 1)
        CAD_Topo_FCE.lg = 0
        WhileLoop NotEqual(CAD_Topo_FCE.lp, 0) {
            IfCondition GreaterThan(CAD_Topo_FCE.lg, 8) ThenBlock: { CAD_Topo_FCE.lp = 0 }
            IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                CAD_Topo_FCE.hd = CAD_Store.Read(CAD_Topo_FCE.lp, 0)
                CAD_Topo_FCE.ce = CAD_Topo_FCE.hd
                CAD_Topo_FCE.g = 0
                WhileLoop LessThan(CAD_Topo_FCE.g, 2048) {
                    IfCondition EqualTo(CAD_Topo_FCE.ce, 0) ThenBlock: { CAD_Topo_FCE.g = 2048 }
                    IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: {
                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.ce, 0), CAD_Topo_FCE.edge) ThenBlock: {
                            ReturnValue(CAD_Topo_FCE.ce)
                        }
                        CAD_Topo_FCE.ce = CAD_Store.Read(CAD_Topo_FCE.ce, 2)
                        IfCondition EqualTo(CAD_Topo_FCE.ce, CAD_Topo_FCE.hd) ThenBlock: { CAD_Topo_FCE.g = 2048 }
                    }
                    CAD_Topo_FCE.g = Add(CAD_Topo_FCE.g, 1)
                }
                CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.lp, 2)
            }
            CAD_Topo_FCE.lg = Add(CAD_Topo_FCE.lg, 1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.EdgeRetargetVert {
    Input: edge_h: Integer
    Input: old_v: Integer
    Input: new_v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(edge_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CAD_Store.Read(edge_h, 0), old_v) ThenBlock: { CAD_Store.Write(edge_h, 0, new_v) }
        IfCondition EqualTo(CAD_Store.Read(edge_h, 1), old_v) ThenBlock: { CAD_Store.Write(edge_h, 1, new_v) }
        CAD_Topo_FCE.ce = CAD_Store.Read(edge_h, 3)
        IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.ce, 5), old_v) ThenBlock: {
                CAD_Store.Write(CAD_Topo_FCE.ce, 5, new_v)
            }
        }
        CAD_Topo_FCE.ce = CAD_Store.Read(edge_h, 4)
        IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.ce, 5), old_v) ThenBlock: {
                CAD_Store.Write(CAD_Topo_FCE.ce, 5, new_v)
            }
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.CoedgeSwapEdge {
    Input: ce_old: Integer
    Input: new_edge: Integer
    Input: new_origin: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ce_old, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_edge, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCE.edge = new_edge
        CAD_Topo_FCE.vert = new_origin
        CAD_Topo_FCE.hd = CAD_Store.Read(ce_old, 3)
        CAD_Topo_FCE.lp = CAD_Store.Read(ce_old, 2)
        CAD_Topo_FCE.face = CAD_Store.Read(ce_old, 4)
        // Keep the old coedge sense. Inferring sn from v0==origin always
        // yields 1 on a closed CIRCLE, which flipped the washer outer loop
        // (original top outer is sn=0) and sheared the wall in tess.
        sn = CAD_Store.Read(ce_old, 6)
        CAD_Topo_FCE.g = CAD_Topo.MakeCoedge(new_edge, new_origin, sn)
        IfCondition EqualTo(CAD_Topo_FCE.g, 0) ThenBlock: { ReturnValue(0) }
        // 1-coedge loop (closed CIRCLE): self-link the new coedge.
        // Inserting beside the old one left inner = two concentric circles
        // and tess fanned the disk on the plate.
        IfCondition EqualTo(CAD_Topo_FCE.lp, ce_old) ThenBlock: {
            CAD_Store.Write(CAD_Topo_FCE.g, 2, CAD_Topo_FCE.g)
            CAD_Store.Write(CAD_Topo_FCE.g, 3, CAD_Topo_FCE.g)
            CAD_Store.Write(CAD_Topo_FCE.g, 4, CAD_Topo_FCE.face)
        }
        IfCondition NotEqual(CAD_Topo_FCE.lp, ce_old) ThenBlock: {
            CAD_Store.Write(CAD_Topo_FCE.g, 2, CAD_Topo_FCE.lp)
            CAD_Store.Write(CAD_Topo_FCE.g, 3, CAD_Topo_FCE.hd)
            CAD_Store.Write(CAD_Topo_FCE.g, 4, CAD_Topo_FCE.face)
            IfCondition NotEqual(CAD_Topo_FCE.hd, 0) ThenBlock: { CAD_Store.Write(CAD_Topo_FCE.hd, 2, CAD_Topo_FCE.g) }
            IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: { CAD_Store.Write(CAD_Topo_FCE.lp, 3, CAD_Topo_FCE.g) }
        }
        IfCondition NotEqual(CAD_Topo_FCE.face, 0) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.face, 0), ce_old) ThenBlock: {
                CAD_Store.Write(CAD_Topo_FCE.face, 0, CAD_Topo_FCE.g)
            }
        }
        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.edge, 3), 0) ThenBlock: {
            CAD_Store.Write(CAD_Topo_FCE.edge, 3, CAD_Topo_FCE.g)
        }
        IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCE.edge, 3), CAD_Topo_FCE.g) ThenBlock: {
            IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.edge, 4), 0) ThenBlock: {
                CAD_Store.Write(CAD_Topo_FCE.edge, 4, CAD_Topo_FCE.g)
                CAD_Topo.LinkTwins(CAD_Store.Read(CAD_Topo_FCE.edge, 3), CAD_Topo_FCE.g)
            }
        }
        ReturnValue(CAD_Topo_FCE.g)
    }
}

Function.CAD_Topo.CoedgeInsertAfter {
    Input: ce_prev: Integer
    Input: new_ce: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ce_prev, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_ce, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCE.ce = CAD_Store.Read(ce_prev, 2)
        CAD_Store.Write(ce_prev, 2, new_ce)
        CAD_Store.Write(new_ce, 3, ce_prev)
        CAD_Store.Write(new_ce, 2, CAD_Topo_FCE.ce)
        IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: { CAD_Store.Write(CAD_Topo_FCE.ce, 3, new_ce) }
        CAD_Store.Write(new_ce, 4, CAD_Store.Read(ce_prev, 4))
        ReturnValue(1)
    }
}

// End cap of an edge fillet at vert: planar face on the OUTER loop
// whose normal is along the edge (|N·D| large). A hole (inner loop)
// is not an end cap — that is how a pad-on-face join stays closed
// while the pad TOP still takes the corner arc.
Function.CAD_Topo.FindFaceWithVert {
    Input: solid_h: Integer
    Input: vert_h: Integer
    Input: skip1: Integer
    Input: skip2: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vert_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCE.solid = solid_h
        CAD_Topo_FCE.vert = vert_h
        CAD_Topo_FCE.skip1 = skip1
        CAD_Topo_FCE.skip2 = skip2
        CAD_Topo_FCE.best = 0
        CAD_Topo_FCE.best_ad = 0
        CAD_Topo_FCE.side = 0
        IfCondition EqualTo(CAD_Topo_FCE.pl, 0) ThenBlock: { CAD_Topo_FCE.pl = Allocate(128) }
        CAD_Topo_FCE.sh = CAD_Store.Read(solid_h, 0)
        CAD_Topo_FCE.sg = 0
        WhileLoop NotEqual(CAD_Topo_FCE.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FCE.sg, 64) ThenBlock: { CAD_Topo_FCE.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FCE.sh, 0) ThenBlock: {
                CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.sh, 0)
                CAD_Topo_FCE.fg = 0
                WhileLoop NotEqual(CAD_Topo_FCE.face, 0) {
                    IfCondition GreaterThan(CAD_Topo_FCE.fg, 4096) ThenBlock: { CAD_Topo_FCE.face = 0 }
                    IfCondition NotEqual(CAD_Topo_FCE.face, 0) ThenBlock: {
                        CAD_Topo_FCE.hd = 1
                        IfCondition EqualTo(CAD_Topo_FCE.face, CAD_Topo_FCE.skip1) ThenBlock: { CAD_Topo_FCE.hd = 0 }
                        IfCondition EqualTo(CAD_Topo_FCE.face, CAD_Topo_FCE.skip2) ThenBlock: { CAD_Topo_FCE.hd = 0 }
                        IfCondition EqualTo(CAD_Topo_FCE.hd, 1) ThenBlock: {
                            CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.face, 0)
                            IfCondition EqualTo(CAD_Topo_FCE.lp, 0) ThenBlock: { CAD_Topo_FCE.hd = 0 }
                            IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCE.lp, 0), 1) ThenBlock: { CAD_Topo_FCE.hd = 0 }
                            }
                        }
                        IfCondition EqualTo(CAD_Topo_FCE.hd, 1) ThenBlock: {
                            CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.face, 1)
                            CAD_Topo_FCE.ok = 0
                            IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                CAD_Topo_FCE.ce = CAD_Store.Read(CAD_Topo_FCE.lp, 0)
                                CAD_Topo_FCE.hd = CAD_Topo_FCE.ce
                                CAD_Topo_FCE.g = 0
                                WhileLoop LessThan(CAD_Topo_FCE.g, 2048) {
                                    IfCondition EqualTo(CAD_Topo_FCE.ce, 0) ThenBlock: { CAD_Topo_FCE.g = 2048 }
                                    IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: {
                                        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_FCE.ce, 5), CAD_Topo_FCE.vert) ThenBlock: {
                                            CAD_Topo_FCE.ok = 1
                                            CAD_Topo_FCE.g = 2048
                                        }
                                        CAD_Topo_FCE.ce = CAD_Store.Read(CAD_Topo_FCE.ce, 2)
                                        IfCondition EqualTo(CAD_Topo_FCE.ce, CAD_Topo_FCE.hd) ThenBlock: { CAD_Topo_FCE.g = 2048 }
                                    }
                                    CAD_Topo_FCE.g = Add(CAD_Topo_FCE.g, 1)
                                }
                            }
                            IfCondition EqualTo(CAD_Topo_FCE.ok, 1) ThenBlock: {
                                CAD_Topo_FCE.lg = Float_Add(Float_Add(Float_Mul(CAD_Topo_FCE.dx, CAD_Topo_FCE.dx), Float_Mul(CAD_Topo_FCE.dy, CAD_Topo_FCE.dy)), Float_Mul(CAD_Topo_FCE.dz, CAD_Topo_FCE.dz))
                                IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_FCE.lg, 0), 1) ThenBlock: {
                                    ReturnValue(CAD_Topo_FCE.face)
                                }
                                IfCondition NotEqual(CAD_Topo.FaceGetPlane(CAD_Topo_FCE.face, CAD_Topo_FCE.pl), 0) ThenBlock: {
                                    CAD_Topo_FCE.ok = 0
                                }
                            }
                            IfCondition EqualTo(CAD_Topo_FCE.ok, 1) ThenBlock: {
                                CAD_Topo_FCE.ad = Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Topo_FCE.pl, 10), CAD_Topo_FCE.dx), Float_Mul(ArrayGet(CAD_Topo_FCE.pl, 11), CAD_Topo_FCE.dy)), Float_Mul(ArrayGet(CAD_Topo_FCE.pl, 12), CAD_Topo_FCE.dz))
                                IfCondition EqualTo(CAD_Num.IsNeg(CAD_Topo_FCE.ad), 1) ThenBlock: { CAD_Topo_FCE.ad = Float_Sub(0, CAD_Topo_FCE.ad) }
                                // Prefer a true end cap (|N·D| large: pad top).
                                // A side wall (|N·D|~0) is the corner of a
                                // join-edge fillet — still an end face.
                                IfCondition EqualTo(CAD_Num.Le(0x3FE0000000000000, CAD_Topo_FCE.ad), 1) ThenBlock: {
                                    IfCondition EqualTo(CAD_Num.Le(CAD_Topo_FCE.best_ad, CAD_Topo_FCE.ad), 1) ThenBlock: {
                                        CAD_Topo_FCE.best_ad = CAD_Topo_FCE.ad
                                        CAD_Topo_FCE.best = CAD_Topo_FCE.face
                                    }
                                }
                                IfCondition EqualTo(CAD_Topo_FCE.side, 0) ThenBlock: {
                                    CAD_Topo_FCE.side = CAD_Topo_FCE.face
                                }
                            }
                        }
                        CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.face, 3)
                    }
                    CAD_Topo_FCE.fg = Add(CAD_Topo_FCE.fg, 1)
                }
                CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FCE.sh, 2)
            }
            CAD_Topo_FCE.sg = Add(CAD_Topo_FCE.sg, 1)
        }
        IfCondition NotEqual(CAD_Topo_FCE.best, 0) ThenBlock: { ReturnValue(CAD_Topo_FCE.best) }
        ReturnValue(CAD_Topo_FCE.side)
    }
}

Function.CAD_Topo.FaceRetargetVert {
    Input: face_h: Integer
    Input: old_v: Integer
    Input: new_v: Integer
    Input: skip_edge: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(face_h, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(old_v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(new_v, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCE.face = face_h
        CAD_Topo_FCE.vert = old_v
        CAD_Topo_FCE.skip1 = new_v
        CAD_Topo_FCE.skip2 = skip_edge
        CAD_Topo_FCE.lp = CAD_Store.Read(face_h, 1)
        CAD_Topo_FCE.lg = 0
        WhileLoop NotEqual(CAD_Topo_FCE.lp, 0) {
            IfCondition GreaterThan(CAD_Topo_FCE.lg, 8) ThenBlock: { CAD_Topo_FCE.lp = 0 }
            IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                CAD_Topo_FCE.hd = CAD_Store.Read(CAD_Topo_FCE.lp, 0)
                CAD_Topo_FCE.ce = CAD_Topo_FCE.hd
                CAD_Topo_FCE.g = 0
                WhileLoop LessThan(CAD_Topo_FCE.g, 2048) {
                    IfCondition EqualTo(CAD_Topo_FCE.ce, 0) ThenBlock: { CAD_Topo_FCE.g = 2048 }
                    IfCondition NotEqual(CAD_Topo_FCE.ce, 0) ThenBlock: {
                        CAD_Topo_FCE.edge = CAD_Store.Read(CAD_Topo_FCE.ce, 0)
                        CAD_Topo_FCE.sg = CAD_Store.Read(CAD_Topo_FCE.ce, 2)
                        CAD_Topo_FCE.ok = 1
                        IfCondition EqualTo(CAD_Topo_FCE.edge, CAD_Topo_FCE.skip2) ThenBlock: { CAD_Topo_FCE.ok = 0 }
                        IfCondition EqualTo(CAD_Topo_FCE.ok, 1) ThenBlock: {
                            IfCondition NotEqual(CAD_Topo_FCE.edge, 0) ThenBlock: {
                                CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.edge, 2)
                                IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                    IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCE.lp, 0), 1) ThenBlock: { CAD_Topo_FCE.ok = 0 }
                                }
                                CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.edge, 3)
                                IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                    CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.lp, 4)
                                    IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                        CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.lp, 1)
                                        IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                            CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.lp, 0)
                                            IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCE.lp, 0), 1) ThenBlock: { CAD_Topo_FCE.ok = 0 }
                                            }
                                        }
                                    }
                                }
                                CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.edge, 4)
                                IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                    CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.lp, 4)
                                    IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                        CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.lp, 1)
                                        IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                            CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.lp, 0)
                                            IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                                                IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCE.lp, 0), 1) ThenBlock: { CAD_Topo_FCE.ok = 0 }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(CAD_Topo_FCE.ok, 1) ThenBlock: {
                            CAD_Topo.EdgeRetargetVert(CAD_Topo_FCE.edge, CAD_Topo_FCE.vert, CAD_Topo_FCE.skip1)
                        }
                        CAD_Topo_FCE.ce = CAD_Topo_FCE.sg
                        IfCondition EqualTo(CAD_Topo_FCE.ce, CAD_Topo_FCE.hd) ThenBlock: { CAD_Topo_FCE.g = 2048 }
                    }
                    CAD_Topo_FCE.g = Add(CAD_Topo_FCE.g, 1)
                }
                CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.lp, 2)
            }
            CAD_Topo_FCE.lg = Add(CAD_Topo_FCE.lg, 1)
        }
        ReturnValue(1)
    }
}

Function.CAD_Topo.SolidHasNonPlane {
    Input: solid_h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_h, 0) ThenBlock: { ReturnValue(0) }
        CAD_Topo_FCE.sh = CAD_Store.Read(solid_h, 0)
        CAD_Topo_FCE.sg = 0
        WhileLoop NotEqual(CAD_Topo_FCE.sh, 0) {
            IfCondition GreaterThan(CAD_Topo_FCE.sg, 64) ThenBlock: { CAD_Topo_FCE.sh = 0 }
            IfCondition NotEqual(CAD_Topo_FCE.sh, 0) ThenBlock: {
                CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.sh, 0)
                CAD_Topo_FCE.fg = 0
                WhileLoop NotEqual(CAD_Topo_FCE.face, 0) {
                    IfCondition GreaterThan(CAD_Topo_FCE.fg, 4096) ThenBlock: { CAD_Topo_FCE.face = 0 }
                    IfCondition NotEqual(CAD_Topo_FCE.face, 0) ThenBlock: {
                        CAD_Topo_FCE.lp = CAD_Store.Read(CAD_Topo_FCE.face, 0)
                        IfCondition NotEqual(CAD_Topo_FCE.lp, 0) ThenBlock: {
                            IfCondition NotEqual(CAD_Store.Read(CAD_Topo_FCE.lp, 0), 1) ThenBlock: {
                                ReturnValue(1)
                            }
                        }
                        CAD_Topo_FCE.face = CAD_Store.Read(CAD_Topo_FCE.face, 3)
                    }
                    CAD_Topo_FCE.fg = Add(CAD_Topo_FCE.fg, 1)
                }
                CAD_Topo_FCE.sh = CAD_Store.Read(CAD_Topo_FCE.sh, 2)
            }
            CAD_Topo_FCE.sg = Add(CAD_Topo_FCE.sg, 1)
        }
        ReturnValue(0)
    }
}
