// CAD.Topo.Xform — split from Library.CAD_Topo.ailang
// API stays Function.CAD_Topo.*  (facade: LibraryImport.Cad.CAD_Topo)

LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom

Function.CAD_Topo.RebuildKind0Planes {
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(CAD_Store.Read(solid_handle, 3), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Topo_State.rb_pt, 0) ThenBlock: { CAD_Topo_State.rb_pt = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_State.rb_ax, 0) ThenBlock: { CAD_Topo_State.rb_ax = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_State.rb_ay, 0) ThenBlock: { CAD_Topo_State.rb_ay = Allocate(32) }
        IfCondition EqualTo(CAD_Topo_State.rb_pt, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Topo_State.rb_ax, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CAD_Topo_State.rb_ay, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Topo_State.walk_sh = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(CAD_Topo_State.walk_sh, 0) ThenBlock: { ReturnValue(-1) }
        sguard = 0
        WhileLoop NotEqual(CAD_Topo_State.walk_sh, 0) {
            CAD_Topo_State.walk_face = CAD_Store.Read(CAD_Topo_State.walk_sh, 0)
            fguard = 0
            WhileLoop NotEqual(CAD_Topo_State.walk_face, 0) {
                CAD_Topo_State.walk_skip = 0
                osurf = CAD_Store.Read(CAD_Topo_State.walk_face, 0)
                IfCondition NotEqual(osurf, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(osurf, 0), 2) ThenBlock: {
                        CAD_Topo_State.walk_skip = 1
                    }
                }
                IfCondition EqualTo(CAD_Topo_State.walk_skip, 0) ThenBlock: {
                    CAD_Topo_State.walk_lp = CAD_Store.Read(CAD_Topo_State.walk_face, 1)
                    CAD_Topo_State.walk_hd = 0
                    IfCondition NotEqual(CAD_Topo_State.walk_lp, 0) ThenBlock: {
                        CAD_Topo_State.walk_hd = CAD_Store.Read(CAD_Topo_State.walk_lp, 0)
                    }
                    IfCondition EqualTo(CAD_Topo_State.walk_hd, 0) ThenBlock: {
                        CAD_Topo_State.walk_skip = 1
                    }
                }
                IfCondition EqualTo(CAD_Topo_State.walk_skip, 0) ThenBlock: {
                    CAD_Topo_State.walk_ce = CAD_Store.Read(CAD_Topo_State.walk_hd, 2)
                    IfCondition EqualTo(CAD_Topo_State.walk_ce, 0) ThenBlock: {
                        CAD_Topo_State.walk_skip = 1
                    }
                    IfCondition EqualTo(CAD_Topo_State.walk_hd, CAD_Topo_State.walk_ce) ThenBlock: {
                        CAD_Topo_State.walk_skip = 1
                    }
                }
                IfCondition EqualTo(CAD_Topo_State.walk_skip, 0) ThenBlock: {
                    IfCondition EqualTo(CAD_Store.Read(CAD_Topo_State.walk_hd, 5), CAD_Store.Read(CAD_Topo_State.walk_ce, 5)) ThenBlock: {
                        CAD_Topo_State.walk_skip = 1
                    }
                }
                IfCondition EqualTo(CAD_Topo_State.walk_skip, 0) ThenBlock: {
                    CAD_Topo_State.walk_lp = CAD_Store.Read(CAD_Topo_State.walk_face, 1)
                    IfCondition EqualTo(CAD_Topo_State.walk_lp, 0) ThenBlock: {
                        CAD_Topo_State.walk_skip = 1
                    }
                }
                IfCondition EqualTo(CAD_Topo_State.walk_skip, 0) ThenBlock: {
                    CAD_Topo_State.walk_hd = CAD_Store.Read(CAD_Topo_State.walk_lp, 0)
                    IfCondition EqualTo(CAD_Topo_State.walk_hd, 0) ThenBlock: {
                        CAD_Topo_State.walk_skip = 1
                    }
                }
                IfCondition EqualTo(CAD_Topo_State.walk_skip, 0) ThenBlock: {
                    CAD_Topo_State.walk_ce = CAD_Store.Read(CAD_Topo_State.walk_hd, 2)
                    IfCondition EqualTo(CAD_Topo_State.walk_ce, 0) ThenBlock: {
                        CAD_Topo_State.walk_skip = 1
                    }
                }
                IfCondition EqualTo(CAD_Topo_State.walk_skip, 0) ThenBlock: {
                    CAD_Topo_State.walk_v0 = CAD_Store.Read(CAD_Topo_State.walk_hd, 5)
                    CAD_Topo_State.walk_v1 = CAD_Store.Read(CAD_Topo_State.walk_ce, 5)
                    CAD_Topo_State.walk_ce = CAD_Store.Read(CAD_Topo_State.walk_ce, 2)
                    CAD_Topo_State.walk_v2 = 0
                    IfCondition NotEqual(CAD_Topo_State.walk_ce, 0) ThenBlock: {
                        CAD_Topo_State.walk_v2 = CAD_Store.Read(CAD_Topo_State.walk_ce, 5)
                    }
                    IfCondition EqualTo(CAD_Topo_State.walk_v0, 0) ThenBlock: { CAD_Topo_State.walk_skip = 1 }
                    IfCondition EqualTo(CAD_Topo_State.walk_v1, 0) ThenBlock: { CAD_Topo_State.walk_skip = 1 }
                    IfCondition EqualTo(CAD_Topo_State.walk_v2, 0) ThenBlock: { CAD_Topo_State.walk_skip = 1 }
                    IfCondition EqualTo(CAD_Topo_State.walk_skip, 0) ThenBlock: {
                        ArraySet(CAD_Topo_State.rb_pt, 0, CAD_Store.Read(CAD_Topo_State.walk_v0, 0))
                        ArraySet(CAD_Topo_State.rb_pt, 1, CAD_Store.Read(CAD_Topo_State.walk_v0, 1))
                        ArraySet(CAD_Topo_State.rb_pt, 2, CAD_Store.Read(CAD_Topo_State.walk_v0, 2))
                        ArraySet(CAD_Topo_State.rb_ax, 0, Float_Sub(CAD_Store.Read(CAD_Topo_State.walk_v1, 0), ArrayGet(CAD_Topo_State.rb_pt, 0)))
                        ArraySet(CAD_Topo_State.rb_ax, 1, Float_Sub(CAD_Store.Read(CAD_Topo_State.walk_v1, 1), ArrayGet(CAD_Topo_State.rb_pt, 1)))
                        ArraySet(CAD_Topo_State.rb_ax, 2, Float_Sub(CAD_Store.Read(CAD_Topo_State.walk_v1, 2), ArrayGet(CAD_Topo_State.rb_pt, 2)))
                        ArraySet(CAD_Topo_State.rb_ay, 0, Float_Sub(CAD_Store.Read(CAD_Topo_State.walk_v2, 0), ArrayGet(CAD_Topo_State.rb_pt, 0)))
                        ArraySet(CAD_Topo_State.rb_ay, 1, Float_Sub(CAD_Store.Read(CAD_Topo_State.walk_v2, 1), ArrayGet(CAD_Topo_State.rb_pt, 1)))
                        ArraySet(CAD_Topo_State.rb_ay, 2, Float_Sub(CAD_Store.Read(CAD_Topo_State.walk_v2, 2), ArrayGet(CAD_Topo_State.rb_pt, 2)))
                        lx = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Topo_State.rb_ax, 0), ArrayGet(CAD_Topo_State.rb_ax, 0)), Float_Mul(ArrayGet(CAD_Topo_State.rb_ax, 1), ArrayGet(CAD_Topo_State.rb_ax, 1))), Float_Mul(ArrayGet(CAD_Topo_State.rb_ax, 2), ArrayGet(CAD_Topo_State.rb_ax, 2))))
                        IfCondition EqualTo(CAD_Num.IsZero(lx, 0), 0) ThenBlock: {
                            ArraySet(CAD_Topo_State.rb_ax, 0, Float_Div(ArrayGet(CAD_Topo_State.rb_ax, 0), lx))
                            ArraySet(CAD_Topo_State.rb_ax, 1, Float_Div(ArrayGet(CAD_Topo_State.rb_ax, 1), lx))
                            ArraySet(CAD_Topo_State.rb_ax, 2, Float_Div(ArrayGet(CAD_Topo_State.rb_ax, 2), lx))
                        }
                        dot = Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Topo_State.rb_ay, 0), ArrayGet(CAD_Topo_State.rb_ax, 0)), Float_Mul(ArrayGet(CAD_Topo_State.rb_ay, 1), ArrayGet(CAD_Topo_State.rb_ax, 1))), Float_Mul(ArrayGet(CAD_Topo_State.rb_ay, 2), ArrayGet(CAD_Topo_State.rb_ax, 2)))
                        ArraySet(CAD_Topo_State.rb_ay, 0, Float_Sub(ArrayGet(CAD_Topo_State.rb_ay, 0), Float_Mul(dot, ArrayGet(CAD_Topo_State.rb_ax, 0))))
                        ArraySet(CAD_Topo_State.rb_ay, 1, Float_Sub(ArrayGet(CAD_Topo_State.rb_ay, 1), Float_Mul(dot, ArrayGet(CAD_Topo_State.rb_ax, 1))))
                        ArraySet(CAD_Topo_State.rb_ay, 2, Float_Sub(ArrayGet(CAD_Topo_State.rb_ay, 2), Float_Mul(dot, ArrayGet(CAD_Topo_State.rb_ax, 2))))
                        ly = CAD_Num.Sqrt(Float_Add(Float_Add(Float_Mul(ArrayGet(CAD_Topo_State.rb_ay, 0), ArrayGet(CAD_Topo_State.rb_ay, 0)), Float_Mul(ArrayGet(CAD_Topo_State.rb_ay, 1), ArrayGet(CAD_Topo_State.rb_ay, 1))), Float_Mul(ArrayGet(CAD_Topo_State.rb_ay, 2), ArrayGet(CAD_Topo_State.rb_ay, 2))))
                        IfCondition EqualTo(CAD_Num.IsZero(ly, 0), 0) ThenBlock: {
                            ArraySet(CAD_Topo_State.rb_ay, 0, Float_Div(ArrayGet(CAD_Topo_State.rb_ay, 0), ly))
                            ArraySet(CAD_Topo_State.rb_ay, 1, Float_Div(ArrayGet(CAD_Topo_State.rb_ay, 1), ly))
                            ArraySet(CAD_Topo_State.rb_ay, 2, Float_Div(ArrayGet(CAD_Topo_State.rb_ay, 2), ly))
                        }
                        nsurf = CAD_Geom.MakePlaneAxes(CAD_Topo_State.rb_pt, CAD_Topo_State.rb_ax, CAD_Topo_State.rb_ay)
                        CAD_Store.Write(CAD_Topo_State.walk_face, 0, nsurf)
                    }
                }
                CAD_Topo_State.walk_face = CAD_Store.Read(CAD_Topo_State.walk_face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 256) ThenBlock: { CAD_Topo_State.walk_face = 0 }
            }
            CAD_Topo_State.walk_sh = CAD_Store.Read(CAD_Topo_State.walk_sh, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CAD_Topo_State.walk_sh = 0 }
        }
        ReturnValue(0)
    }
}

// Translate solid in place. dxyz_addr: [dx,dy,dz]. Returns 0 ok, -1 fail.
Function.CAD_Topo.TranslateSolid {
    Input: solid_handle: Integer
    Input: dxyz_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        dx = ArrayGet(dxyz_addr, 0)
        dy = ArrayGet(dxyz_addr, 1)
        dz = ArrayGet(dxyz_addr, 2)
        kind = CAD_Store.Read(solid_handle, 3)
        // kind 0: walk verts once (shared verts appear on many coedges — mark bit62)
        IfCondition EqualTo(kind, 0) ThenBlock: {
            shell = CAD_Store.Read(solid_handle, 0)
            IfCondition EqualTo(shell, 0) ThenBlock: { ReturnValue(-1) }
            sguard = 0
            WhileLoop NotEqual(shell, 0) {
                face = CAD_Store.Read(shell, 0)
                fguard = 0
                WhileLoop NotEqual(face, 0) {
                    lp = CAD_Store.Read(face, 1)
                    lguard = 0
                    WhileLoop NotEqual(lp, 0) {
                        hd = CAD_Store.Read(lp, 0)
                        ce = hd
                        cdone = 0
                        cguard = 0
                        WhileLoop EqualTo(cdone, 0) {
                            ov = CAD_Store.Read(ce, 5)
                            euse = CAD_Store.Read(ov, 3)
                            IfCondition EqualTo(BitwiseAnd(euse, 0x4000000000000000), 0) ThenBlock: {
                                CAD_Store.Write(ov, 0, Float_Add(CAD_Store.Read(ov, 0), dx))
                                CAD_Store.Write(ov, 1, Float_Add(CAD_Store.Read(ov, 1), dy))
                                CAD_Store.Write(ov, 2, Float_Add(CAD_Store.Read(ov, 2), dz))
                                CAD_Store.Write(ov, 3, BitwiseOr(euse, 0x4000000000000000))
                            }
                            ce = CAD_Store.Read(ce, 2)
                            cguard = Add(cguard, 1)
                            IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                            IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
                        }
                        lp = CAD_Store.Read(lp, 2)
                        lguard = Add(lguard, 1)
                        IfCondition GreaterThan(lguard, 16) ThenBlock: { lp = 0 }
                    }
                    face = CAD_Store.Read(face, 3)
                    fguard = Add(fguard, 1)
                    IfCondition GreaterThan(fguard, 256) ThenBlock: { face = 0 }
                }
                shell = CAD_Store.Read(shell, 2)
                sguard = Add(sguard, 1)
                IfCondition GreaterThan(sguard, 64) ThenBlock: { shell = 0 }
            }
            // clear mark bits
            shell = CAD_Store.Read(solid_handle, 0)
            sguard = 0
            WhileLoop NotEqual(shell, 0) {
                face = CAD_Store.Read(shell, 0)
                fguard = 0
                WhileLoop NotEqual(face, 0) {
                    lp = CAD_Store.Read(face, 1)
                    WhileLoop NotEqual(lp, 0) {
                        hd = CAD_Store.Read(lp, 0)
                        ce = hd
                        cdone = 0
                        cguard = 0
                        WhileLoop EqualTo(cdone, 0) {
                            ov = CAD_Store.Read(ce, 5)
                            euse = CAD_Store.Read(ov, 3)
                            CAD_Store.Write(ov, 3, BitwiseAnd(euse, 0xBFFFFFFFFFFFFFFF))
                            ce = CAD_Store.Read(ce, 2)
                            cguard = Add(cguard, 1)
                            IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                            IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
                        }
                        lp = CAD_Store.Read(lp, 2)
                    }
                    face = CAD_Store.Read(face, 3)
                    fguard = Add(fguard, 1)
                    IfCondition GreaterThan(fguard, 256) ThenBlock: { face = 0 }
                }
                shell = CAD_Store.Read(shell, 2)
                sguard = Add(sguard, 1)
                IfCondition GreaterThan(sguard, 64) ThenBlock: { shell = 0 }
            }
            ReturnValue(0)
        }
        // kind 1/2 cylinder: params ox,oy,oz AND B-Rep verts (STEP walks shell)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            CAD_Store.Write(ph, 2, Float_Add(CAD_Store.Read(ph, 2), dx))
            CAD_Store.Write(ph, 3, Float_Add(CAD_Store.Read(ph, 3), dy))
            CAD_Store.Write(ph, 4, Float_Add(CAD_Store.Read(ph, 4), dz))
            shell = CAD_Store.Read(solid_handle, 0)
            IfCondition EqualTo(shell, 0) ThenBlock: { ReturnValue(0) }
            face = CAD_Store.Read(shell, 0)
            fguard = 0
            WhileLoop NotEqual(face, 0) {
                lp = CAD_Store.Read(face, 1)
                hd = CAD_Store.Read(lp, 0)
                ce = hd
                cdone = 0
                cguard = 0
                WhileLoop EqualTo(cdone, 0) {
                    ov = CAD_Store.Read(ce, 5)
                    euse = CAD_Store.Read(ov, 3)
                    IfCondition EqualTo(BitwiseAnd(euse, 0x4000000000000000), 0) ThenBlock: {
                        CAD_Store.Write(ov, 0, Float_Add(CAD_Store.Read(ov, 0), dx))
                        CAD_Store.Write(ov, 1, Float_Add(CAD_Store.Read(ov, 1), dy))
                        CAD_Store.Write(ov, 2, Float_Add(CAD_Store.Read(ov, 2), dz))
                        CAD_Store.Write(ov, 3, BitwiseOr(euse, 0x4000000000000000))
                    }
                    ed = CAD_Store.Read(ce, 0)
                    IfCondition NotEqual(ed, 0) ThenBlock: {
                        crv = CAD_Store.Read(ed, 2)
                        IfCondition NotEqual(crv, 0) ThenBlock: {
                            IfCondition EqualTo(CAD_Store.Read(crv, 11), 0) ThenBlock: {
                                CAD_Store.Write(crv, 1, Float_Add(CAD_Store.Read(crv, 1), dx))
                                CAD_Store.Write(crv, 2, Float_Add(CAD_Store.Read(crv, 2), dy))
                                CAD_Store.Write(crv, 3, Float_Add(CAD_Store.Read(crv, 3), dz))
                                CAD_Store.Write(crv, 11, 1)
                            }
                        }
                    }
                    ce = CAD_Store.Read(ce, 2)
                    cguard = Add(cguard, 1)
                    IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                    IfCondition GreaterThan(cguard, 64) ThenBlock: { cdone = 1 }
                }
                surf = CAD_Store.Read(face, 0)
                IfCondition NotEqual(surf, 0) ThenBlock: {
                    CAD_Store.Write(surf, 1, Float_Add(CAD_Store.Read(surf, 1), dx))
                    CAD_Store.Write(surf, 2, Float_Add(CAD_Store.Read(surf, 2), dy))
                    CAD_Store.Write(surf, 3, Float_Add(CAD_Store.Read(surf, 3), dz))
                }
                face = CAD_Store.Read(face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 64) ThenBlock: { face = 0 }
            }
            // clear visit marks
            face = CAD_Store.Read(shell, 0)
            fguard = 0
            WhileLoop NotEqual(face, 0) {
                lp = CAD_Store.Read(face, 1)
                hd = CAD_Store.Read(lp, 0)
                ce = hd
                cdone = 0
                cguard = 0
                WhileLoop EqualTo(cdone, 0) {
                    ov = CAD_Store.Read(ce, 5)
                    CAD_Store.Write(ov, 3, BitwiseAnd(CAD_Store.Read(ov, 3), 0xBFFFFFFFFFFFFFFF))
                    ed = CAD_Store.Read(ce, 0)
                    IfCondition NotEqual(ed, 0) ThenBlock: {
                        crv = CAD_Store.Read(ed, 2)
                        IfCondition NotEqual(crv, 0) ThenBlock: { CAD_Store.Write(crv, 11, 0) }
                    }
                    ce = CAD_Store.Read(ce, 2)
                    cguard = Add(cguard, 1)
                    IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                    IfCondition GreaterThan(cguard, 64) ThenBlock: { cdone = 1 }
                }
                face = CAD_Store.Read(face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 64) ThenBlock: { face = 0 }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            CAD_Store.Write(ph, 2, Float_Add(CAD_Store.Read(ph, 2), dx))
            CAD_Store.Write(ph, 3, Float_Add(CAD_Store.Read(ph, 3), dy))
            CAD_Store.Write(ph, 4, Float_Add(CAD_Store.Read(ph, 4), dz))
            ReturnValue(0)
        }
        // kind 3 plate: world = (ox,oy)+local hole; translate only ox,oy (+ solid oz).
        // Do NOT shift hole local cx,cy (would double-count).
        IfCondition EqualTo(kind, 3) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            CAD_Store.Write(ph, 6, Float_Add(CAD_Store.Read(ph, 6), dx))
            CAD_Store.Write(ph, 7, Float_Add(CAD_Store.Read(ph, 7), dy))
            CAD_Store.Write(solid_handle, 2, Float_Add(CAD_Store.Read(solid_handle, 2), dz))
            ReturnValue(0)
        }
        // kind 4 sphere: center cx,cy,cz at 1,2,3
        IfCondition EqualTo(kind, 4) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            CAD_Store.Write(ph, 1, Float_Add(CAD_Store.Read(ph, 1), dx))
            CAD_Store.Write(ph, 2, Float_Add(CAD_Store.Read(ph, 2), dy))
            CAD_Store.Write(ph, 3, Float_Add(CAD_Store.Read(ph, 3), dz))
            ReturnValue(0)
        }
        // kind 5 tube: params ox,oy,oz at 3,4,5 + B-Rep verts
        IfCondition EqualTo(kind, 5) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            IfCondition NotEqual(ph, 0) ThenBlock: {
                CAD_Store.Write(ph, 3, Float_Add(CAD_Store.Read(ph, 3), dx))
                CAD_Store.Write(ph, 4, Float_Add(CAD_Store.Read(ph, 4), dy))
                CAD_Store.Write(ph, 5, Float_Add(CAD_Store.Read(ph, 5), dz))
            }
            shell = CAD_Store.Read(solid_handle, 0)
            IfCondition EqualTo(shell, 0) ThenBlock: { ReturnValue(0) }
            face = CAD_Store.Read(shell, 0)
            fguard = 0
            WhileLoop NotEqual(face, 0) {
                lp = CAD_Store.Read(face, 1)
                IfCondition NotEqual(lp, 0) ThenBlock: {
                    hd = CAD_Store.Read(lp, 0)
                    ce = hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        ov = CAD_Store.Read(ce, 5)
                        CAD_Store.Write(ov, 0, Float_Add(CAD_Store.Read(ov, 0), dx))
                        CAD_Store.Write(ov, 1, Float_Add(CAD_Store.Read(ov, 1), dy))
                        CAD_Store.Write(ov, 2, Float_Add(CAD_Store.Read(ov, 2), dz))
                        ce = CAD_Store.Read(ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
                    }
                    // hole loops on cap faces
                    ilp = CAD_Store.Read(lp, 2)
                    WhileLoop NotEqual(ilp, 0) {
                        hd = CAD_Store.Read(ilp, 0)
                        ce = hd
                        cdone = 0
                        cguard = 0
                        WhileLoop EqualTo(cdone, 0) {
                            ov = CAD_Store.Read(ce, 5)
                            CAD_Store.Write(ov, 0, Float_Add(CAD_Store.Read(ov, 0), dx))
                            CAD_Store.Write(ov, 1, Float_Add(CAD_Store.Read(ov, 1), dy))
                            CAD_Store.Write(ov, 2, Float_Add(CAD_Store.Read(ov, 2), dz))
                            ce = CAD_Store.Read(ce, 2)
                            cguard = Add(cguard, 1)
                            IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                            IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
                        }
                        ilp = CAD_Store.Read(ilp, 2)
                    }
                }
                face = CAD_Store.Read(face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 256) ThenBlock: { face = 0 }
            }
            ReturnValue(0)
        }
        ReturnValue(-1)
    }
}

// Map solid from local coords to world via plane frame (12 doubles: O X Y Z).
// Each vertex p' = O + px*X + py*Y + pz*Z. Kind 0 (+ kind 5 shell). In place.
// Used by sketch-on-plane pad: extrude in UV/normal local, then place on plane.
Function.CAD_Topo.MapSolidByFrame {
    Input: solid_handle: Integer
    Input: frame_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(frame_addr, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Topo_Map.solid = solid_handle
        CAD_Topo_Map.ox = ArrayGet(frame_addr, 0)
        CAD_Topo_Map.oy = ArrayGet(frame_addr, 1)
        CAD_Topo_Map.oz = ArrayGet(frame_addr, 2)
        CAD_Topo_Map.xx = ArrayGet(frame_addr, 3)
        CAD_Topo_Map.xy = ArrayGet(frame_addr, 4)
        CAD_Topo_Map.xz = ArrayGet(frame_addr, 5)
        CAD_Topo_Map.yx = ArrayGet(frame_addr, 6)
        CAD_Topo_Map.yy = ArrayGet(frame_addr, 7)
        CAD_Topo_Map.yz = ArrayGet(frame_addr, 8)
        CAD_Topo_Map.zx = ArrayGet(frame_addr, 9)
        CAD_Topo_Map.zy = ArrayGet(frame_addr, 10)
        CAD_Topo_Map.zz = ArrayGet(frame_addr, 11)
        CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.solid, 0)
        IfCondition EqualTo(CAD_Topo_Map.shell, 0) ThenBlock: { ReturnValue(-1) }
        sguard = 0
        WhileLoop NotEqual(CAD_Topo_Map.shell, 0) {
            CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.shell, 0)
            fguard = 0
            WhileLoop NotEqual(CAD_Topo_Map.face, 0) {
                CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.face, 1)
                lguard = 0
                WhileLoop NotEqual(CAD_Topo_Map.lp, 0) {
                    CAD_Topo_Map.hd = CAD_Store.Read(CAD_Topo_Map.lp, 0)
                    CAD_Topo_Map.ce = CAD_Topo_Map.hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        CAD_Topo_Map.ov = CAD_Store.Read(CAD_Topo_Map.ce, 5)
                        CAD_Topo_Map.euse = CAD_Store.Read(CAD_Topo_Map.ov, 3)
                        IfCondition EqualTo(BitwiseAnd(CAD_Topo_Map.euse, 0x4000000000000000), 0) ThenBlock: {
                            CAD_Topo_Map.px = CAD_Store.Read(CAD_Topo_Map.ov, 0)
                            CAD_Topo_Map.py = CAD_Store.Read(CAD_Topo_Map.ov, 1)
                            CAD_Topo_Map.pz = CAD_Store.Read(CAD_Topo_Map.ov, 2)
                            CAD_Topo_Map.nx = Float_Add(CAD_Topo_Map.ox, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xx), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yx), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zx))))
                            CAD_Topo_Map.ny = Float_Add(CAD_Topo_Map.oy, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xy), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yy), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zy))))
                            CAD_Topo_Map.nz = Float_Add(CAD_Topo_Map.oz, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xz), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yz), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zz))))
                            CAD_Store.Write(CAD_Topo_Map.ov, 0, CAD_Topo_Map.nx)
                            CAD_Store.Write(CAD_Topo_Map.ov, 1, CAD_Topo_Map.ny)
                            CAD_Store.Write(CAD_Topo_Map.ov, 2, CAD_Topo_Map.nz)
                            CAD_Store.Write(CAD_Topo_Map.ov, 3, BitwiseOr(CAD_Topo_Map.euse, 0x4000000000000000))
                        }
                        CAD_Topo_Map.ce = CAD_Store.Read(CAD_Topo_Map.ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(CAD_Topo_Map.ce, CAD_Topo_Map.hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 512) ThenBlock: { cdone = 1 }
                    }
                    CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.lp, 2)
                    lguard = Add(lguard, 1)
                    IfCondition GreaterThan(lguard, 16) ThenBlock: { CAD_Topo_Map.lp = 0 }
                }
                CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CAD_Topo_Map.face = 0 }
            }
            CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CAD_Topo_Map.shell = 0 }
        }
        // clear visited flags
        CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CAD_Topo_Map.shell, 0) {
            CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.shell, 0)
            fguard = 0
            WhileLoop NotEqual(CAD_Topo_Map.face, 0) {
                CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.face, 1)
                WhileLoop NotEqual(CAD_Topo_Map.lp, 0) {
                    CAD_Topo_Map.hd = CAD_Store.Read(CAD_Topo_Map.lp, 0)
                    CAD_Topo_Map.ce = CAD_Topo_Map.hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        CAD_Topo_Map.ov = CAD_Store.Read(CAD_Topo_Map.ce, 5)
                        CAD_Topo_Map.euse = CAD_Store.Read(CAD_Topo_Map.ov, 3)
                        CAD_Store.Write(CAD_Topo_Map.ov, 3, BitwiseAnd(CAD_Topo_Map.euse, 0xBFFFFFFFFFFFFFFF))
                        CAD_Topo_Map.ce = CAD_Store.Read(CAD_Topo_Map.ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(CAD_Topo_Map.ce, CAD_Topo_Map.hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 512) ThenBlock: { cdone = 1 }
                    }
                    CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.lp, 2)
                }
                CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CAD_Topo_Map.face = 0 }
            }
            CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CAD_Topo_Map.shell = 0 }
        }
        // Map circle curves + cylinder surfaces (verts already mapped).
        CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CAD_Topo_Map.shell, 0) {
            CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.shell, 0)
            fguard = 0
            WhileLoop NotEqual(CAD_Topo_Map.face, 0) {
                surf = CAD_Store.Read(CAD_Topo_Map.face, 0)
                IfCondition NotEqual(surf, 0) ThenBlock: {
                    CAD_Topo_Map.skind = CAD_Store.Read(surf, 0)
                    // kind 1 plane (cyl caps) AND kind 2 cylinder. Caps used to stay
                    // at local z=H = box top, so pick always fell through to the square.
                    IfCondition EqualTo(CAD_Topo_Map.skind, 1) ThenBlock: {
                        CAD_Topo_Map.skind = 2
                    }
                    IfCondition EqualTo(CAD_Topo_Map.skind, 2) ThenBlock: {
                        CAD_Topo_Map.px = CAD_Store.Read(surf, 1)
                        CAD_Topo_Map.py = CAD_Store.Read(surf, 2)
                        CAD_Topo_Map.pz = CAD_Store.Read(surf, 3)
                        CAD_Store.Write(surf, 1, Float_Add(CAD_Topo_Map.ox, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xx), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yx), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zx)))))
                        CAD_Store.Write(surf, 2, Float_Add(CAD_Topo_Map.oy, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xy), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yy), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zy)))))
                        CAD_Store.Write(surf, 3, Float_Add(CAD_Topo_Map.oz, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xz), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yz), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zz)))))
                        CAD_Topo_Map.px = CAD_Store.Read(surf, 4)
                        CAD_Topo_Map.py = CAD_Store.Read(surf, 5)
                        CAD_Topo_Map.pz = CAD_Store.Read(surf, 6)
                        CAD_Store.Write(surf, 4, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xx), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yx), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zx))))
                        CAD_Store.Write(surf, 5, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xy), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yy), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zy))))
                        CAD_Store.Write(surf, 6, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xz), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yz), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zz))))
                        CAD_Topo_Map.px = CAD_Store.Read(surf, 7)
                        CAD_Topo_Map.py = CAD_Store.Read(surf, 8)
                        CAD_Topo_Map.pz = CAD_Store.Read(surf, 9)
                        CAD_Store.Write(surf, 7, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xx), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yx), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zx))))
                        CAD_Store.Write(surf, 8, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xy), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yy), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zy))))
                        CAD_Store.Write(surf, 9, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xz), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yz), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zz))))
                        CAD_Topo_Map.px = CAD_Store.Read(surf, 10)
                        CAD_Topo_Map.py = CAD_Store.Read(surf, 11)
                        CAD_Topo_Map.pz = CAD_Store.Read(surf, 12)
                        CAD_Store.Write(surf, 10, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xx), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yx), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zx))))
                        CAD_Store.Write(surf, 11, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xy), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yy), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zy))))
                        CAD_Store.Write(surf, 12, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xz), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yz), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zz))))
                    }
                }
                CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.face, 1)
                WhileLoop NotEqual(CAD_Topo_Map.lp, 0) {
                    CAD_Topo_Map.hd = CAD_Store.Read(CAD_Topo_Map.lp, 0)
                    CAD_Topo_Map.ce = CAD_Topo_Map.hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        ed = CAD_Store.Read(CAD_Topo_Map.ce, 0)
                        IfCondition NotEqual(ed, 0) ThenBlock: {
                            crv = CAD_Store.Read(ed, 2)
                            IfCondition NotEqual(crv, 0) ThenBlock: {
                                IfCondition EqualTo(CAD_Store.Read(crv, 0), 2) ThenBlock: {
                                    IfCondition EqualTo(CAD_Store.Read(crv, 11), 0) ThenBlock: {
                                        CAD_Topo_Map.px = CAD_Store.Read(crv, 1)
                                        CAD_Topo_Map.py = CAD_Store.Read(crv, 2)
                                        CAD_Topo_Map.pz = CAD_Store.Read(crv, 3)
                                        CAD_Store.Write(crv, 1, Float_Add(CAD_Topo_Map.ox, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xx), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yx), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zx)))))
                                        CAD_Store.Write(crv, 2, Float_Add(CAD_Topo_Map.oy, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xy), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yy), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zy)))))
                                        CAD_Store.Write(crv, 3, Float_Add(CAD_Topo_Map.oz, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xz), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yz), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zz)))))
                                        CAD_Topo_Map.px = CAD_Store.Read(crv, 4)
                                        CAD_Topo_Map.py = CAD_Store.Read(crv, 5)
                                        CAD_Topo_Map.pz = CAD_Store.Read(crv, 6)
                                        CAD_Store.Write(crv, 4, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xx), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yx), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zx))))
                                        CAD_Store.Write(crv, 5, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xy), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yy), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zy))))
                                        CAD_Store.Write(crv, 6, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xz), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yz), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zz))))
                                        CAD_Topo_Map.px = CAD_Store.Read(crv, 7)
                                        CAD_Topo_Map.py = CAD_Store.Read(crv, 8)
                                        CAD_Topo_Map.pz = CAD_Store.Read(crv, 9)
                                        CAD_Store.Write(crv, 7, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xx), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yx), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zx))))
                                        CAD_Store.Write(crv, 8, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xy), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yy), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zy))))
                                        CAD_Store.Write(crv, 9, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xz), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yz), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zz))))
                                        CAD_Store.Write(crv, 11, 1)
                                    }
                                }
                            }
                        }
                        CAD_Topo_Map.ce = CAD_Store.Read(CAD_Topo_Map.ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(CAD_Topo_Map.ce, CAD_Topo_Map.hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 512) ThenBlock: { cdone = 1 }
                    }
                    CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.lp, 2)
                }
                CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CAD_Topo_Map.face = 0 }
            }
            CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CAD_Topo_Map.shell = 0 }
        }
        // clear circle visit marks
        CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CAD_Topo_Map.shell, 0) {
            CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.shell, 0)
            fguard = 0
            WhileLoop NotEqual(CAD_Topo_Map.face, 0) {
                CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.face, 1)
                WhileLoop NotEqual(CAD_Topo_Map.lp, 0) {
                    CAD_Topo_Map.hd = CAD_Store.Read(CAD_Topo_Map.lp, 0)
                    CAD_Topo_Map.ce = CAD_Topo_Map.hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        ed = CAD_Store.Read(CAD_Topo_Map.ce, 0)
                        IfCondition NotEqual(ed, 0) ThenBlock: {
                            crv = CAD_Store.Read(ed, 2)
                            IfCondition NotEqual(crv, 0) ThenBlock: { CAD_Store.Write(crv, 11, 0) }
                        }
                        CAD_Topo_Map.ce = CAD_Store.Read(CAD_Topo_Map.ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(CAD_Topo_Map.ce, CAD_Topo_Map.hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 512) ThenBlock: { cdone = 1 }
                    }
                    CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.lp, 2)
                }
                CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CAD_Topo_Map.face = 0 }
            }
            CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CAD_Topo_Map.shell = 0 }
        }
        IfCondition EqualTo(CAD_Store.Read(CAD_Topo_Map.solid, 3), 1) ThenBlock: {
            ph = CAD_Store.Read(CAD_Topo_Map.solid, 1)
            IfCondition NotEqual(ph, 0) ThenBlock: {
                CAD_Topo_Map.px = CAD_Store.Read(ph, 2)
                CAD_Topo_Map.py = CAD_Store.Read(ph, 3)
                CAD_Topo_Map.pz = CAD_Store.Read(ph, 4)
                CAD_Store.Write(ph, 2, Float_Add(CAD_Topo_Map.ox, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xx), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yx), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zx)))))
                CAD_Store.Write(ph, 3, Float_Add(CAD_Topo_Map.oy, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xy), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yy), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zy)))))
                CAD_Store.Write(ph, 4, Float_Add(CAD_Topo_Map.oz, Float_Add(Float_Mul(CAD_Topo_Map.px, CAD_Topo_Map.xz), Float_Add(Float_Mul(CAD_Topo_Map.py, CAD_Topo_Map.yz), Float_Mul(CAD_Topo_Map.pz, CAD_Topo_Map.zz)))))
            }
        }
        ReturnValue(0)
    }
}

// Shift solid so min((P−O)·N) = 0. Height origin is the sketch plane, not world Z.
Function.CAD_Topo.SnapSolidToFrame {
    Input: solid_handle: Integer
    Input: frame_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(frame_addr, 0) ThenBlock: { ReturnValue(-1) }
        CAD_Topo_Map.solid = solid_handle
        CAD_Topo_Map.ox = ArrayGet(frame_addr, 0)
        CAD_Topo_Map.oy = ArrayGet(frame_addr, 1)
        CAD_Topo_Map.oz = ArrayGet(frame_addr, 2)
        CAD_Topo_Map.zx = ArrayGet(frame_addr, 9)
        CAD_Topo_Map.zy = ArrayGet(frame_addr, 10)
        CAD_Topo_Map.zz = ArrayGet(frame_addr, 11)
        CAD_Topo_Map.dmin = 0x7FEFFFFFFFFFFFFF
        CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CAD_Topo_Map.shell, 0) {
            CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.shell, 0)
            fguard = 0
            WhileLoop NotEqual(CAD_Topo_Map.face, 0) {
                CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.face, 1)
                WhileLoop NotEqual(CAD_Topo_Map.lp, 0) {
                    CAD_Topo_Map.hd = CAD_Store.Read(CAD_Topo_Map.lp, 0)
                    CAD_Topo_Map.ce = CAD_Topo_Map.hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        CAD_Topo_Map.ov = CAD_Store.Read(CAD_Topo_Map.ce, 5)
                        CAD_Topo_Map.px = CAD_Store.Read(CAD_Topo_Map.ov, 0)
                        CAD_Topo_Map.py = CAD_Store.Read(CAD_Topo_Map.ov, 1)
                        CAD_Topo_Map.pz = CAD_Store.Read(CAD_Topo_Map.ov, 2)
                        CAD_Topo_Map.nx = Float_Add(Float_Add(Float_Mul(Float_Sub(CAD_Topo_Map.px, CAD_Topo_Map.ox), CAD_Topo_Map.zx), Float_Mul(Float_Sub(CAD_Topo_Map.py, CAD_Topo_Map.oy), CAD_Topo_Map.zy)), Float_Mul(Float_Sub(CAD_Topo_Map.pz, CAD_Topo_Map.oz), CAD_Topo_Map.zz))
                        IfCondition EqualTo(CAD_Num.IsNeg(Float_Sub(CAD_Topo_Map.nx, CAD_Topo_Map.dmin)), 1) ThenBlock: {
                            CAD_Topo_Map.dmin = CAD_Topo_Map.nx
                        }
                        CAD_Topo_Map.ce = CAD_Store.Read(CAD_Topo_Map.ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(CAD_Topo_Map.ce, CAD_Topo_Map.hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 512) ThenBlock: { cdone = 1 }
                    }
                    CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.lp, 2)
                }
                CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CAD_Topo_Map.face = 0 }
            }
            CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CAD_Topo_Map.shell = 0 }
        }
        IfCondition EqualTo(CAD_Num.IsZero(CAD_Topo_Map.dmin, 0), 1) ThenBlock: { ReturnValue(0) }
        // P := P − dmin N  so the lowest point sits on the sketch plane
        CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CAD_Topo_Map.shell, 0) {
            CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.shell, 0)
            fguard = 0
            WhileLoop NotEqual(CAD_Topo_Map.face, 0) {
                CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.face, 1)
                WhileLoop NotEqual(CAD_Topo_Map.lp, 0) {
                    CAD_Topo_Map.hd = CAD_Store.Read(CAD_Topo_Map.lp, 0)
                    CAD_Topo_Map.ce = CAD_Topo_Map.hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        CAD_Topo_Map.ov = CAD_Store.Read(CAD_Topo_Map.ce, 5)
                        CAD_Topo_Map.euse = CAD_Store.Read(CAD_Topo_Map.ov, 3)
                        IfCondition EqualTo(BitwiseAnd(CAD_Topo_Map.euse, 0x4000000000000000), 0) ThenBlock: {
                            CAD_Topo_Map.px = CAD_Store.Read(CAD_Topo_Map.ov, 0)
                            CAD_Topo_Map.py = CAD_Store.Read(CAD_Topo_Map.ov, 1)
                            CAD_Topo_Map.pz = CAD_Store.Read(CAD_Topo_Map.ov, 2)
                            CAD_Store.Write(CAD_Topo_Map.ov, 0, Float_Sub(CAD_Topo_Map.px, Float_Mul(CAD_Topo_Map.dmin, CAD_Topo_Map.zx)))
                            CAD_Store.Write(CAD_Topo_Map.ov, 1, Float_Sub(CAD_Topo_Map.py, Float_Mul(CAD_Topo_Map.dmin, CAD_Topo_Map.zy)))
                            CAD_Store.Write(CAD_Topo_Map.ov, 2, Float_Sub(CAD_Topo_Map.pz, Float_Mul(CAD_Topo_Map.dmin, CAD_Topo_Map.zz)))
                            CAD_Store.Write(CAD_Topo_Map.ov, 3, BitwiseOr(CAD_Topo_Map.euse, 0x4000000000000000))
                        }
                        CAD_Topo_Map.ce = CAD_Store.Read(CAD_Topo_Map.ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(CAD_Topo_Map.ce, CAD_Topo_Map.hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 512) ThenBlock: { cdone = 1 }
                    }
                    CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.lp, 2)
                }
                CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CAD_Topo_Map.face = 0 }
            }
            CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CAD_Topo_Map.shell = 0 }
        }
        CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.solid, 0)
        sguard = 0
        WhileLoop NotEqual(CAD_Topo_Map.shell, 0) {
            CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.shell, 0)
            fguard = 0
            WhileLoop NotEqual(CAD_Topo_Map.face, 0) {
                CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.face, 1)
                WhileLoop NotEqual(CAD_Topo_Map.lp, 0) {
                    CAD_Topo_Map.hd = CAD_Store.Read(CAD_Topo_Map.lp, 0)
                    CAD_Topo_Map.ce = CAD_Topo_Map.hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        CAD_Topo_Map.ov = CAD_Store.Read(CAD_Topo_Map.ce, 5)
                        CAD_Topo_Map.euse = CAD_Store.Read(CAD_Topo_Map.ov, 3)
                        CAD_Store.Write(CAD_Topo_Map.ov, 3, BitwiseAnd(CAD_Topo_Map.euse, 0xBFFFFFFFFFFFFFFF))
                        CAD_Topo_Map.ce = CAD_Store.Read(CAD_Topo_Map.ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(CAD_Topo_Map.ce, CAD_Topo_Map.hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 512) ThenBlock: { cdone = 1 }
                    }
                    CAD_Topo_Map.lp = CAD_Store.Read(CAD_Topo_Map.lp, 2)
                }
                CAD_Topo_Map.face = CAD_Store.Read(CAD_Topo_Map.face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 512) ThenBlock: { CAD_Topo_Map.face = 0 }
            }
            CAD_Topo_Map.shell = CAD_Store.Read(CAD_Topo_Map.shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { CAD_Topo_Map.shell = 0 }
        }
        ReturnValue(0)
    }
}

// Rotate solid about world +Z by ang_r (radians), in place.
// Kind 0: vertices; kind 1/2: axis (ox,oy); kind 3: plate origin + hole XY;
// kind 4: sphere center XY. Returns 0 ok, -1 fail.
Function.CAD_Topo.RotateSolidZ {
    Input: solid_handle: Integer
    Input: ang_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        c = CAD_Geom.Cos(ang_r)
        s = CAD_Geom.Sin(ang_r)
        kind = CAD_Store.Read(solid_handle, 3)
        IfCondition EqualTo(kind, 0) ThenBlock: {
            shell = CAD_Store.Read(solid_handle, 0)
            IfCondition EqualTo(shell, 0) ThenBlock: { ReturnValue(-1) }
            sguard = 0
            WhileLoop NotEqual(shell, 0) {
                face = CAD_Store.Read(shell, 0)
                fguard = 0
                WhileLoop NotEqual(face, 0) {
                    lp = CAD_Store.Read(face, 1)
                    hd = CAD_Store.Read(lp, 0)
                    ce = hd
                    cdone = 0
                    cguard = 0
                    WhileLoop EqualTo(cdone, 0) {
                        ov = CAD_Store.Read(ce, 5)
                        x = CAD_Store.Read(ov, 0)
                        y = CAD_Store.Read(ov, 1)
                        CAD_Store.Write(ov, 0, Float_Sub(Float_Mul(x, c), Float_Mul(y, s)))
                        CAD_Store.Write(ov, 1, Float_Add(Float_Mul(x, s), Float_Mul(y, c)))
                        ce = CAD_Store.Read(ce, 2)
                        cguard = Add(cguard, 1)
                        IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                        IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
                    }
                    face = CAD_Store.Read(face, 3)
                    fguard = Add(fguard, 1)
                    IfCondition GreaterThan(fguard, 256) ThenBlock: { face = 0 }
                }
                shell = CAD_Store.Read(shell, 2)
                sguard = Add(sguard, 1)
                IfCondition GreaterThan(sguard, 64) ThenBlock: { shell = 0 }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            x = CAD_Store.Read(ph, 2)
            y = CAD_Store.Read(ph, 3)
            CAD_Store.Write(ph, 2, Float_Sub(Float_Mul(x, c), Float_Mul(y, s)))
            CAD_Store.Write(ph, 3, Float_Add(Float_Mul(x, s), Float_Mul(y, c)))
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            x = CAD_Store.Read(ph, 2)
            y = CAD_Store.Read(ph, 3)
            CAD_Store.Write(ph, 2, Float_Sub(Float_Mul(x, c), Float_Mul(y, s)))
            CAD_Store.Write(ph, 3, Float_Add(Float_Mul(x, s), Float_Mul(y, c)))
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            ox = CAD_Store.Read(ph, 6)
            oy = CAD_Store.Read(ph, 7)
            // rotate plate origin
            nox = Float_Sub(Float_Mul(ox, c), Float_Mul(oy, s))
            noy = Float_Add(Float_Mul(ox, s), Float_Mul(oy, c))
            CAD_Store.Write(ph, 6, nox)
            CAD_Store.Write(ph, 7, noy)
            nh = CAD_Store.Read(ph, 9)
            IfCondition EqualTo(nh, 0) ThenBlock: { nh = 1 }
            hi = 0
            WhileLoop LessThan(hi, nh) {
                IfCondition EqualTo(hi, 0) ThenBlock: {
                    hcx = CAD_Store.Read(ph, 4)
                    hcy = CAD_Store.Read(ph, 5)
                }
                IfCondition GreaterThan(hi, 0) ThenBlock: {
                    base = Add(10, Multiply(Subtract(hi, 1), 4))
                    hcx = CAD_Store.Read(ph, Add(base, 1))
                    hcy = CAD_Store.Read(ph, Add(base, 2))
                }
                // world hole, rotate, re-local to new origin
                wx = Float_Add(ox, hcx)
                wy = Float_Add(oy, hcy)
                nwx = Float_Sub(Float_Mul(wx, c), Float_Mul(wy, s))
                nwy = Float_Add(Float_Mul(wx, s), Float_Mul(wy, c))
                nhx = Float_Sub(nwx, nox)
                nhy = Float_Sub(nwy, noy)
                IfCondition EqualTo(hi, 0) ThenBlock: {
                    CAD_Store.Write(ph, 4, nhx)
                    CAD_Store.Write(ph, 5, nhy)
                }
                IfCondition GreaterThan(hi, 0) ThenBlock: {
                    base = Add(10, Multiply(Subtract(hi, 1), 4))
                    CAD_Store.Write(ph, Add(base, 1), nhx)
                    CAD_Store.Write(ph, Add(base, 2), nhy)
                }
                hi = Add(hi, 1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 4) ThenBlock: {
            ph = CAD_Store.Read(solid_handle, 1)
            x = CAD_Store.Read(ph, 1)
            y = CAD_Store.Read(ph, 2)
            CAD_Store.Write(ph, 1, Float_Sub(Float_Mul(x, c), Float_Mul(y, s)))
            CAD_Store.Write(ph, 2, Float_Add(Float_Mul(x, s), Float_Mul(y, c)))
            ReturnValue(0)
        }
        ReturnValue(-1)
    }
}

// Reflect kind-0 solid verts about plane through (cx,cy,cz).
// axis 0=YZ (flip X), 1=XZ (flip Y), 2=XY (flip Z). In place. Returns 0 ok.
Function.CAD_Topo.ReflectSolid {
    Input: solid_handle: Integer
    Input: axis: Integer
    Input: cxyz_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(CAD_Store.Read(solid_handle, 3), 0) ThenBlock: { ReturnValue(-1) }
        cx = ArrayGet(cxyz_addr, 0)
        cy = ArrayGet(cxyz_addr, 1)
        cz = ArrayGet(cxyz_addr, 2)
        half = 0x4000000000000000
        shell = CAD_Store.Read(solid_handle, 0)
        sguard = 0
        WhileLoop NotEqual(shell, 0) {
            face = CAD_Store.Read(shell, 0)
            fguard = 0
            WhileLoop NotEqual(face, 0) {
                lp = CAD_Store.Read(face, 1)
                hd = CAD_Store.Read(lp, 0)
                ce = hd
                cdone = 0
                cguard = 0
                WhileLoop EqualTo(cdone, 0) {
                    ov = CAD_Store.Read(ce, 5)
                    IfCondition EqualTo(axis, 0) ThenBlock: {
                        x = CAD_Store.Read(ov, 0)
                        CAD_Store.Write(ov, 0, Float_Sub(Float_Mul(cx, half), x))
                    }
                    IfCondition EqualTo(axis, 1) ThenBlock: {
                        y = CAD_Store.Read(ov, 1)
                        CAD_Store.Write(ov, 1, Float_Sub(Float_Mul(cy, half), y))
                    }
                    IfCondition EqualTo(axis, 2) ThenBlock: {
                        z = CAD_Store.Read(ov, 2)
                        CAD_Store.Write(ov, 2, Float_Sub(Float_Mul(cz, half), z))
                    }
                    ce = CAD_Store.Read(ce, 2)
                    cguard = Add(cguard, 1)
                    IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                    IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
                }
                face = CAD_Store.Read(face, 3)
                fguard = Add(fguard, 1)
                IfCondition GreaterThan(fguard, 256) ThenBlock: { face = 0 }
            }
            shell = CAD_Store.Read(shell, 2)
            sguard = Add(sguard, 1)
            IfCondition GreaterThan(sguard, 64) ThenBlock: { shell = 0 }
        }
        ReturnValue(0)
    }
}

// Deep-clone kind-0 solid (plane faces, line edges, outer loops).
// Clones **first shell only** (safe seed for Linear/CircularPattern after CompoundAdd).
// Max 256 verts / 512 edges / 128 faces. Returns new solid or 0.
Function.CAD_Topo.CloneKind0 {
    Input: solid_handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(CAD_Store.Read(solid_handle, 3), 0) ThenBlock: { ReturnValue(0) }
        shell0 = CAD_Store.Read(solid_handle, 0)
        IfCondition EqualTo(shell0, 0) ThenBlock: { ReturnValue(0) }
        old_v = Allocate(2048)
        new_v = Allocate(2048)
        nv = 0
        old_e = Allocate(4096)
        new_e = Allocate(4096)
        old_ca = Allocate(4096)
        old_cb = Allocate(4096)
        new_ca = Allocate(4096)
        new_cb = Allocate(4096)
        ne = 0
        pt = Allocate(32)
        p1b = Allocate(32)
        ax = Allocate(32)
        ay = Allocate(32)
        ring = Allocate(512)
        faces = Allocate(1024)
        // --- pass 1: first shell only (pattern seed) ---
        face = CAD_Store.Read(shell0, 0)
        fguard = 0
        WhileLoop NotEqual(face, 0) {
            lp = CAD_Store.Read(face, 1)
            hd = CAD_Store.Read(lp, 0)
            ce = hd
            cdone = 0
            cguard = 0
            WhileLoop EqualTo(cdone, 0) {
                ov = CAD_Store.Read(ce, 5)
                found = 0
                k = 0
                WhileLoop LessThan(k, nv) {
                    IfCondition EqualTo(ArrayGet(old_v, k), ov) ThenBlock: { found = 1 }
                    k = Add(k, 1)
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    IfCondition LessThan(nv, 256) ThenBlock: {
                        ArraySet(old_v, nv, ov)
                        nv = Add(nv, 1)
                    }
                }
                eh = CAD_Store.Read(ce, 0)
                found = 0
                k = 0
                WhileLoop LessThan(k, ne) {
                    IfCondition EqualTo(ArrayGet(old_e, k), eh) ThenBlock: { found = 1 }
                    k = Add(k, 1)
                }
                IfCondition EqualTo(found, 0) ThenBlock: {
                    IfCondition LessThan(ne, 512) ThenBlock: {
                        ArraySet(old_e, ne, eh)
                        ArraySet(old_ca, ne, CAD_Store.Read(eh, 3))
                        ArraySet(old_cb, ne, CAD_Store.Read(eh, 4))
                        ne = Add(ne, 1)
                    }
                }
                ce = CAD_Store.Read(ce, 2)
                cguard = Add(cguard, 1)
                IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
            }
            face = CAD_Store.Read(face, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 256) ThenBlock: { face = 0 }
        }
        IfCondition LessThan(nv, 3) ThenBlock: {
            Deallocate(old_v, 2048)
            Deallocate(new_v, 2048)
            Deallocate(old_e, 4096)
            Deallocate(new_e, 4096)
            Deallocate(old_ca, 4096)
            Deallocate(old_cb, 4096)
            Deallocate(new_ca, 4096)
            Deallocate(new_cb, 4096)
            Deallocate(pt, 32)
            Deallocate(p1b, 32)
            Deallocate(ax, 32)
            Deallocate(ay, 32)
            Deallocate(ring, 512)
            Deallocate(faces, 1024)
            ReturnValue(0)
        }
        // --- pass 2: clone vertices ---
        i = 0
        WhileLoop LessThan(i, nv) {
            ov = ArrayGet(old_v, i)
            ArraySet(pt, 0, CAD_Store.Read(ov, 0))
            ArraySet(pt, 1, CAD_Store.Read(ov, 1))
            ArraySet(pt, 2, CAD_Store.Read(ov, 2))
            ArraySet(new_v, i, CAD_Topo.MakeVertex(pt))
            i = Add(i, 1)
        }
        // map old vertex handle -> new: linear search helper inline
        // --- pass 3: clone edges + coedges ---
        i = 0
        WhileLoop LessThan(i, ne) {
            eh = ArrayGet(old_e, i)
            ov0 = CAD_Store.Read(eh, 0)
            ov1 = CAD_Store.Read(eh, 1)
            // map verts
            nv0 = 0
            nv1 = 0
            k = 0
            WhileLoop LessThan(k, nv) {
                IfCondition EqualTo(ArrayGet(old_v, k), ov0) ThenBlock: { nv0 = ArrayGet(new_v, k) }
                IfCondition EqualTo(ArrayGet(old_v, k), ov1) ThenBlock: { nv1 = ArrayGet(new_v, k) }
                k = Add(k, 1)
            }
            ArraySet(pt, 0, CAD_Store.Read(nv0, 0))
            ArraySet(pt, 1, CAD_Store.Read(nv0, 1))
            ArraySet(pt, 2, CAD_Store.Read(nv0, 2))
            ArraySet(p1b, 0, CAD_Store.Read(nv1, 0))
            ArraySet(p1b, 1, CAD_Store.Read(nv1, 1))
            ArraySet(p1b, 2, CAD_Store.Read(nv1, 2))
            ln = CAD_Geom.MakeLine(pt, p1b)
            nedge = CAD_Topo.MakeEdge(nv0, nv1, ln)
            ca = ArrayGet(old_ca, i)
            cb = ArrayGet(old_cb, i)
            // map coedge origins
            ova = CAD_Store.Read(ca, 5)
            ovb = CAD_Store.Read(cb, 5)
            nva = 0
            nvb = 0
            k = 0
            WhileLoop LessThan(k, nv) {
                IfCondition EqualTo(ArrayGet(old_v, k), ova) ThenBlock: { nva = ArrayGet(new_v, k) }
                IfCondition EqualTo(ArrayGet(old_v, k), ovb) ThenBlock: { nvb = ArrayGet(new_v, k) }
                k = Add(k, 1)
            }
            nca = CAD_Topo.MakeCoedge(nedge, nva, CAD_Store.Read(ca, 6))
            ncb = CAD_Topo.MakeCoedge(nedge, nvb, CAD_Store.Read(cb, 6))
            CAD_Topo.LinkTwins(nca, ncb)
            CAD_Store.Write(nedge, 3, nca)
            CAD_Store.Write(nedge, 4, ncb)
            ArraySet(new_e, i, nedge)
            ArraySet(new_ca, i, nca)
            ArraySet(new_cb, i, ncb)
            i = Add(i, 1)
        }
        // --- pass 4: clone faces of first shell ---
        face = CAD_Store.Read(shell0, 0)
        nf = 0
        fguard = 0
        WhileLoop NotEqual(face, 0) {
            surf = CAD_Store.Read(face, 0)
            ArraySet(pt, 0, CAD_Store.Read(surf, 1))
            ArraySet(pt, 1, CAD_Store.Read(surf, 2))
            ArraySet(pt, 2, CAD_Store.Read(surf, 3))
            ArraySet(ax, 0, CAD_Store.Read(surf, 4))
            ArraySet(ax, 1, CAD_Store.Read(surf, 5))
            ArraySet(ax, 2, CAD_Store.Read(surf, 6))
            ArraySet(ay, 0, CAD_Store.Read(surf, 7))
            ArraySet(ay, 1, CAD_Store.Read(surf, 8))
            ArraySet(ay, 2, CAD_Store.Read(surf, 9))
            nsurf = CAD_Geom.MakePlaneAxes(pt, ax, ay)
            lp = CAD_Store.Read(face, 1)
            hd = CAD_Store.Read(lp, 0)
            ce = hd
            nring = 0
            cdone = 0
            cguard = 0
            WhileLoop EqualTo(cdone, 0) {
                eh = CAD_Store.Read(ce, 0)
                mapped = 0
                k = 0
                WhileLoop LessThan(k, ne) {
                    IfCondition EqualTo(ArrayGet(old_e, k), eh) ThenBlock: {
                        IfCondition EqualTo(ArrayGet(old_ca, k), ce) ThenBlock: {
                            mapped = ArrayGet(new_ca, k)
                        }
                        IfCondition EqualTo(ArrayGet(old_cb, k), ce) ThenBlock: {
                            mapped = ArrayGet(new_cb, k)
                        }
                    }
                    k = Add(k, 1)
                }
                IfCondition NotEqual(mapped, 0) ThenBlock: {
                    IfCondition LessThan(nring, 64) ThenBlock: {
                        ArraySet(ring, nring, mapped)
                        nring = Add(nring, 1)
                    }
                }
                ce = CAD_Store.Read(ce, 2)
                cguard = Add(cguard, 1)
                IfCondition EqualTo(ce, hd) ThenBlock: { cdone = 1 }
                IfCondition GreaterThan(cguard, 256) ThenBlock: { cdone = 1 }
            }
            IfCondition GreaterThan(nring, 2) ThenBlock: {
                nl = CAD_Topo.MakeLoop(ArrayGet(ring, 0))
                CAD_Topo.LinkLoopRing(ring, nring, nl)
                nf_face = CAD_Topo.MakeFace(nsurf, nl)
                IfCondition LessThan(nf, 128) ThenBlock: {
                    ArraySet(faces, nf, nf_face)
                    nf = Add(nf, 1)
                }
            }
            face = CAD_Store.Read(face, 3)
            fguard = Add(fguard, 1)
            IfCondition GreaterThan(fguard, 256) ThenBlock: { face = 0 }
        }
        result = 0
        IfCondition GreaterThan(nf, 0) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, Subtract(nf, 1)) {
                CAD_Store.Write(ArrayGet(faces, i), 3, ArrayGet(faces, Add(i, 1)))
                i = Add(i, 1)
            }
            CAD_Store.Write(ArrayGet(faces, Subtract(nf, 1)), 3, 0)
            nsh = CAD_Topo.MakeShell(ArrayGet(faces, 0))
            i = 1
            WhileLoop LessThan(i, nf) {
                CAD_Store.Write(ArrayGet(faces, i), 2, nsh)
                i = Add(i, 1)
            }
            result = CAD_Topo.MakeSolid(nsh)
            CAD_Store.Write(result, 1, 0)
            CAD_Store.Write(result, 2, 0)
            CAD_Store.Write(result, 3, 0)
        }
        Deallocate(old_v, 2048)
        Deallocate(new_v, 2048)
        Deallocate(old_e, 4096)
        Deallocate(new_e, 4096)
        Deallocate(old_ca, 4096)
        Deallocate(old_cb, 4096)
        Deallocate(new_ca, 4096)
        Deallocate(new_cb, 4096)
        Deallocate(pt, 32)
        Deallocate(p1b, 32)
        Deallocate(ax, 32)
        Deallocate(ay, 32)
        Deallocate(ring, 512)
        Deallocate(faces, 1024)
        ReturnValue(result)
    }
}

// Count coedges walking next around a loop (guard max 1024)
Function.CAD_Topo.LoopCountCoedges {
    Input: loop_h: Integer
    Output: Integer
    Body: {
        head = CAD_Store.Read(loop_h, 0)
        IfCondition EqualTo(head, 0) ThenBlock: { ReturnValue(0) }
        n = 1
        ce = CAD_Store.Read(head, 2)
        guard = 0
        WhileLoop NotEqual(ce, head) {
            IfCondition EqualTo(ce, 0) ThenBlock: { ReturnValue(-1) }
            n = Add(n, 1)
            ce = CAD_Store.Read(ce, 2)
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 4096) ThenBlock: { ReturnValue(-1) }
        }
        ReturnValue(n)
    }
}

// Euler-Poincaré: V - E + F == 2*(S - G) + H
// counts_addr: [V, E, F, S, G, H] — 1 Input (SysV-safe)
Function.CAD_Topo.VerifyEulerInvariants {
    Input: counts_addr: Address
    Output: Integer
    Body: {
        num_v = ArrayGet(counts_addr, 0)
        num_e = ArrayGet(counts_addr, 1)
        num_f = ArrayGet(counts_addr, 2)
        num_s = ArrayGet(counts_addr, 3)
        num_g = ArrayGet(counts_addr, 4)
        num_h = ArrayGet(counts_addr, 5)
        lhs = Add(Subtract(num_v, num_e), num_f)
        s_g = Subtract(num_s, num_g)
        rhs = Add(Multiply(2, s_g), num_h)
        IfCondition EqualTo(lhs, rhs) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.CAD_Topo.Counts {
    Input: out_addr: Address
    Output: Integer
    Body: {
        // out: V E F S solid coedge loop
        ArraySet(out_addr, 0, CAD_Topo_State.vertex_count)
        ArraySet(out_addr, 1, CAD_Topo_State.edge_count)
        ArraySet(out_addr, 2, CAD_Topo_State.face_count)
        ArraySet(out_addr, 3, CAD_Topo_State.shell_count)
        ArraySet(out_addr, 4, CAD_Topo_State.solid_count)
        ArraySet(out_addr, 5, CAD_Topo_State.coedge_count)
        ArraySet(out_addr, 6, CAD_Topo_State.loop_count)
        ReturnValue(0)
    }
}


// =============================================================================
// Equal-R digon cycle fillet (OCC Steinmetz ellipses + cylinders)
// State lives on digon_S heap buffer — reload from CAD_Topo_State.digon_S after
// any nested call. Thin helpers only (no fat monologue frames).
//
// ArrayGet/Set use offset = 8 + index*8. digon_S must be Allocate(>=4096) for
// slots through ~432 (Allocate(512) freelist-poisoned after cylinders).
// Pin buffers: reg* 2048B, frame/pl 128B, vec/ring 64B, carr/nlist 128–256B.
//
// S layout (qword slots):
//   0..n-1 wall faces of selected edges (wf)
//   16..   other face (may be fcap)
//   32..   edge v0, 48.. edge v1
//   64..   eord cycle edge indices
//   80..   cycle verts (n)
//   96..   wall nx, 112 ny, 128 nz
//   144..  P_ww verts, 160.. P_cap verts
//   176..  Cs x, 192 y, 208 z
//   224..  edge dir x,y,z 240 256
//   272..  digon ellipse edge handles
//   288..  used flags
//   304 n_edges, 305 radius, 306 shell0, 307 fcap
//   400 reg_a, 401 reg_b, 402 reg_e, 403 frame, 404 pt, 405 p1b
//   406 d1, 407 d2, 408 ring, 409 pl, 410 na, 411 nb, 412 nc
//   413 vv, 414 out9, 415 faces, 416 carr, 417 nlist, 420 nreg
//   418/419 oldv/newv map, 421 nvmap
//   422..424 DigonSolve3 result; 425..427 pristine cap normal
//   433..435 Solve3 RHS pin; 436..439 da,db,dc,R pin
//   430 cyl surf, 431 e_gc, 432 e_gw
//
// Corner policy (equal-R digon, no globe by default):
//   equal R on meeting edges → cylinders + Steinmetz digon ellipse (any dihedral)
//   sphere/"globe" only later if radii differ or explicit ball-corner requested
// =============================================================================
