// Checksum — byte-range integrity math for any program.
// Inclusive [start..end] on a raw buffer. No file or ECU types.
//
// Sum8 / Sum16 / Sum32  wrapping byte sums
// Sum16BE / Sum16LE     wrapping 16-bit word sums (skip_addr < 0 = none)
// Neg16 / Ones16        two's / one's complement
// CRC32IEEE             CRC-32/ISO-HDLC (poly 0xEDB88320, "123456789" = 0xCBF43926)
// CRC16CCITT            CRC-16/CCITT-FALSE (init 0xFFFF, poly 0x1021)
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

Function.Checksum.Fold8 {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(n, 255))
    }
}

Function.Checksum.Fold16 {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(n, 65535))
    }
}

Function.Checksum.Fold32 {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(n, 4294967295))
    }
}

Function.Checksum.Neg16 {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(Subtract(0, n), 65535))
    }
}

Function.Checksum.Ones16 {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(BitwiseXor(n, 65535), 65535))
    }
}

Function.Checksum.Sum8 {
    Input: buf: Address
    Input: start: Integer
    Input: end: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(start, end) ThenBlock: { ReturnValue(0) }
        s = 0
        i = start
        WhileLoop LessEqual(i, end) {
            s = Checksum.Fold8(Add(s, GetByte(buf, i)))
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.Checksum.Xor8 {
    Input: buf: Address
    Input: start: Integer
    Input: end: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(start, end) ThenBlock: { ReturnValue(0) }
        x = 0
        i = start
        WhileLoop LessEqual(i, end) {
            x = BitwiseXor(x, GetByte(buf, i))
            i = Add(i, 1)
        }
        ReturnValue(Checksum.Fold8(x))
    }
}

Function.Checksum.Sum16 {
    Input: buf: Address
    Input: start: Integer
    Input: end: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(start, end) ThenBlock: { ReturnValue(0) }
        s = 0
        i = start
        WhileLoop LessEqual(i, end) {
            s = Checksum.Fold16(Add(s, GetByte(buf, i)))
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.Checksum.Sum32 {
    Input: buf: Address
    Input: start: Integer
    Input: end: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(start, end) ThenBlock: { ReturnValue(0) }
        s = 0
        i = start
        WhileLoop LessEqual(i, end) {
            s = Checksum.Fold32(Add(s, GetByte(buf, i)))
            i = Add(i, 1)
        }
        ReturnValue(s)
    }
}

Function.Checksum.Word16BE {
    Input: buf: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        hi = GetByte(buf, addr)
        lo = GetByte(buf, Add(addr, 1))
        ReturnValue(Add(Multiply(hi, 256), lo))
    }
}

Function.Checksum.Word16LE {
    Input: buf: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        lo = GetByte(buf, addr)
        hi = GetByte(buf, Add(addr, 1))
        ReturnValue(Add(Multiply(hi, 256), lo))
    }
}

Function.Checksum.Sum16BE {
    Input: buf: Address
    Input: start: Integer
    Input: end: Integer
    Input: skip: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(start, end) ThenBlock: { ReturnValue(0) }
        s = 0
        i = start
        WhileLoop LessEqual(Add(i, 1), end) {
            use = 1
            IfCondition EqualTo(i, skip) ThenBlock: { use = 0 }
            IfCondition EqualTo(use, 1) ThenBlock: {
                s = Checksum.Fold16(Add(s, Checksum.Word16BE(buf, i)))
            }
            i = Add(i, 2)
        }
        ReturnValue(s)
    }
}

Function.Checksum.Sum16LE {
    Input: buf: Address
    Input: start: Integer
    Input: end: Integer
    Input: skip: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(start, end) ThenBlock: { ReturnValue(0) }
        s = 0
        i = start
        WhileLoop LessEqual(Add(i, 1), end) {
            use = 1
            IfCondition EqualTo(i, skip) ThenBlock: { use = 0 }
            IfCondition EqualTo(use, 1) ThenBlock: {
                s = Checksum.Fold16(Add(s, Checksum.Word16LE(buf, i)))
            }
            i = Add(i, 2)
        }
        ReturnValue(s)
    }
}

Function.Checksum.CRC32IEEE {
    Input: buf: Address
    Input: start: Integer
    Input: end: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(start, end) ThenBlock: { ReturnValue(0) }
        crc = 4294967295
        poly = 3988292384
        i = start
        WhileLoop LessEqual(i, end) {
            crc = BitwiseXor(crc, GetByte(buf, i))
            bit = 0
            WhileLoop LessThan(bit, 8) {
                lsb = BitwiseAnd(crc, 1)
                crc = ShiftRight(crc, 1)
                IfCondition NotEqual(lsb, 0) ThenBlock: {
                    crc = BitwiseXor(crc, poly)
                }
                crc = Checksum.Fold32(crc)
                bit = Add(bit, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(Checksum.Fold32(BitwiseXor(crc, 4294967295)))
    }
}

Function.Checksum.CRC16CCITT {
    Input: buf: Address
    Input: start: Integer
    Input: end: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(start, end) ThenBlock: { ReturnValue(0) }
        crc = 65535
        poly = 4129
        i = start
        WhileLoop LessEqual(i, end) {
            crc = BitwiseXor(crc, Multiply(GetByte(buf, i), 256))
            bit = 0
            WhileLoop LessThan(bit, 8) {
                hi = BitwiseAnd(crc, 32768)
                crc = Checksum.Fold16(Multiply(crc, 2))
                IfCondition NotEqual(hi, 0) ThenBlock: {
                    crc = Checksum.Fold16(BitwiseXor(crc, poly))
                }
                bit = Add(bit, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(Checksum.Fold16(crc))
    }
}
