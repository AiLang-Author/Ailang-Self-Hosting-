Function.EmitBuffer_Init {
    Body: {
        IfCondition NotEqual(EmitBuffer.instructions, 0) ThenBlock: {
            count = XArray.XSize(EmitBuffer.instructions)
            i = 0
            WhileLoop LessThan(i, count) {
                entry = XArray.XGet(EmitBuffer.instructions, i)
                IfCondition NotEqual(entry, 0) ThenBlock: {
                    Deallocate(entry, 56)
                }
                i = Add(i, 1)
            }
            XArray.XDestroy(EmitBuffer.instructions)
        }
        EmitBuffer.instructions = XArray.XCreate(4096)
        EmitBuffer.optimized_count = 0
        ReturnValue(1)
    }
}

Function.EmitBuffer_Add {
    Input: opcode: Integer
    Input: opt_class: Integer
    Input: op1: Integer
    Input: op2: Integer
    Body: {
        EmitBuffer_Add3(opcode, opt_class, op1, op2, 0)
        ReturnValue(1)
    }
}

Function.EmitBuffer_Add3 {
    Input: opcode: Integer
    Input: opt_class: Integer
    Input: op1: Integer
    Input: op2: Integer
    Input: op3: Integer
    Body: {
        entry = Allocate(56)
        StoreValue(entry, Compile.current_func)
        StoreValue(Add(entry, 8), Compile.current_node)
        StoreValue(Add(entry, 16), opcode)
        StoreValue(Add(entry, 24), opt_class)
        StoreValue(Add(entry, 32), op1)
        StoreValue(Add(entry, 40), op2)
        StoreValue(Add(entry, 48), op3)
        XArray.XPush(EmitBuffer.instructions, entry)
        ReturnValue(1)
    }
}

Function.EmitBuffer_Optimize {
    Body: {
        count = XArray.XSize(EmitBuffer.instructions)
        i = 0
        
        WhileLoop LessThan(i, Subtract(count, 1)) {
            entry = XArray.XGet(EmitBuffer.instructions, i)
            next = XArray.XGet(EmitBuffer.instructions, Add(i, 1))
            
            this_class = Dereference(Add(entry, 24))
            next_class = Dereference(Add(next, 24))
            this_op1 = Dereference(Add(entry, 32))
            next_op1 = Dereference(Add(next, 32))
            
            // Pattern: STORE_LOCAL offset X, then LOAD_LOCAL offset X
            IfCondition EqualTo(this_class, OptClass.STORE_LOCAL) ThenBlock: {
                IfCondition EqualTo(next_class, OptClass.LOAD_LOCAL) ThenBlock: {
                    IfCondition EqualTo(this_op1, next_op1) ThenBlock: {
                        // NOP out the redundant load
                        StoreValue(Add(next, 16), OpCode.NOP)
                        StoreValue(Add(next, 24), OptClass.NOP)
                        EmitBuffer.optimized_count = Add(EmitBuffer.optimized_count, 1)
                    }
                }
            }
            
            i = Add(i, 1)
        }
        
        PrintMessage("[OPT] Eliminated ")
        PrintNumber(EmitBuffer.optimized_count)
        PrintMessage(" redundant load instructions.\n")
    }
}

Function.EmitBuffer_Flush {
    Body: {
        count = XArray.XSize(EmitBuffer.instructions)
        i = 0
        
        EmitBuffer.enabled = 0
        
        WhileLoop LessThan(i, count) {
            entry = XArray.XGet(EmitBuffer.instructions, i)
            opcode = Dereference(Add(entry, 16))
            op1 = Dereference(Add(entry, 32))
            op2 = Dereference(Add(entry, 40))
            op3 = Dereference(Add(entry, 48))
            
            IfCondition NotEqual(opcode, OpCode.NOP) ThenBlock: {
                IfCondition EqualTo(opcode, OpCode.MovRbpRsp) ThenBlock: { Emit_MovRbpRsp() }
                IfCondition EqualTo(opcode, OpCode.AddRegReg) ThenBlock: { Emit_AddRegReg(op1, op2) }
                IfCondition EqualTo(opcode, OpCode.SubRaxImm8) ThenBlock: { Emit_SubRaxImm8(op1) }
                IfCondition EqualTo(opcode, OpCode.MulRbx) ThenBlock: { Emit_MulRbx() }
                IfCondition EqualTo(opcode, OpCode.DivRbx) ThenBlock: { Emit_DivRbx() }
                IfCondition EqualTo(opcode, OpCode.MovByteR14Dl) ThenBlock: { Emit_MovByteR14Dl() }
                IfCondition EqualTo(opcode, OpCode.MovByteR14OffsetImm8) ThenBlock: { Emit_MovByteR14OffsetImm8(op1, op2) }
                IfCondition EqualTo(opcode, OpCode.MovzxRaxBytePtrRsi) ThenBlock: { Emit_MovzxRaxBytePtrRsi() }
                IfCondition EqualTo(opcode, OpCode.MovByteDerefRdiImm8) ThenBlock: { Emit_MovByteDerefRdiImm8(op1) }
                IfCondition EqualTo(opcode, OpCode.MovRspRbp) ThenBlock: { Emit_MovRspRbp() }
                IfCondition EqualTo(opcode, OpCode.MovR12Rbx) ThenBlock: { Emit_MovR12Rbx() }
                IfCondition EqualTo(opcode, OpCode.MovR12Rcx) ThenBlock: { Emit_MovR12Rcx() }
                IfCondition EqualTo(opcode, OpCode.MovR12Rdx) ThenBlock: { Emit_MovR12Rdx() }
                IfCondition EqualTo(opcode, OpCode.MovRdxR12) ThenBlock: { Emit_MovRdxR12() }
                IfCondition EqualTo(opcode, OpCode.MovRsiR12) ThenBlock: { Emit_MovRsiR12() }
                IfCondition EqualTo(opcode, OpCode.MovRdiR12) ThenBlock: { Emit_MovRdiR12() }
                IfCondition EqualTo(opcode, OpCode.MovR12Rdi) ThenBlock: { Emit_MovR12Rdi() }
                IfCondition EqualTo(opcode, OpCode.MovR13Rbx) ThenBlock: { Emit_MovR13Rbx() }
                IfCondition EqualTo(opcode, OpCode.MovR13Rcx) ThenBlock: { Emit_MovR13Rcx() }
                IfCondition EqualTo(opcode, OpCode.MovR13Rdx) ThenBlock: { Emit_MovR13Rdx() }
                IfCondition EqualTo(opcode, OpCode.MovRdxR13) ThenBlock: { Emit_MovRdxR13() }
                IfCondition EqualTo(opcode, OpCode.MovR13Rdi) ThenBlock: { Emit_MovR13Rdi() }
                IfCondition EqualTo(opcode, OpCode.MovR14Rsp) ThenBlock: { Emit_MovR14Rsp() }
                IfCondition EqualTo(opcode, OpCode.MovR14Rbx) ThenBlock: { Emit_MovR14Rbx() }
                IfCondition EqualTo(opcode, OpCode.MovR14Rcx) ThenBlock: { Emit_MovR14Rcx() }
                IfCondition EqualTo(opcode, OpCode.MovRbxR14) ThenBlock: { Emit_MovRbxR14() }
                IfCondition EqualTo(opcode, OpCode.MovRcxR14) ThenBlock: { Emit_MovRcxR14() }
                IfCondition EqualTo(opcode, OpCode.MovRdxR14) ThenBlock: { Emit_MovRdxR14() }
                IfCondition EqualTo(opcode, OpCode.MovR15Rbx) ThenBlock: { Emit_MovR15Rbx() }
                IfCondition EqualTo(opcode, OpCode.MovRbxR15) ThenBlock: { Emit_MovRbxR15() }
                IfCondition EqualTo(opcode, OpCode.MovRcxR15) ThenBlock: { Emit_MovRcxR15() }
                IfCondition EqualTo(opcode, OpCode.MovRdxR15) ThenBlock: { Emit_MovRdxR15() }
                IfCondition EqualTo(opcode, OpCode.MovR15Rax) ThenBlock: { Emit_MovR15Rax() }
                IfCondition EqualTo(opcode, OpCode.XorR15R15) ThenBlock: { Emit_XorR15R15() }
                IfCondition EqualTo(opcode, OpCode.MovRdiRbx) ThenBlock: { Emit_MovRdiRbx() }
                IfCondition EqualTo(opcode, OpCode.MovRsiRbx) ThenBlock: { Emit_MovRsiRbx() }
                IfCondition EqualTo(opcode, OpCode.MovRbxRdi) ThenBlock: { Emit_MovRbxRdi() }
                IfCondition EqualTo(opcode, OpCode.MovRbxRsi) ThenBlock: { Emit_MovRbxRsi() }
                IfCondition EqualTo(opcode, OpCode.MovRaxRsp) ThenBlock: { Emit_MovRaxRsp() }
                IfCondition EqualTo(opcode, OpCode.MovRaxImm64) ThenBlock: { Emit_MovRaxImm64(op1) }
                IfCondition EqualTo(opcode, OpCode.MovRaxDerefRbxRcxScaled) ThenBlock: { Emit_MovRaxDerefRbxRcxScaled(op1) }
                IfCondition EqualTo(opcode, OpCode.MovRaxDerefRsp) ThenBlock: { Emit_MovRaxDerefRsp() }
                IfCondition EqualTo(opcode, OpCode.MovRdiR13) ThenBlock: { Emit_MovRdiR13() }
                IfCondition EqualTo(opcode, OpCode.MovRdiR14) ThenBlock: { Emit_MovRdiR14() }
                IfCondition EqualTo(opcode, OpCode.MovRsiR13) ThenBlock: { Emit_MovRsiR13() }
                IfCondition EqualTo(opcode, OpCode.MovRsiR14) ThenBlock: { Emit_MovRsiR14() }
                IfCondition EqualTo(opcode, OpCode.MovRbxRcx) ThenBlock: { Emit_MovRbxRcx() }
                IfCondition EqualTo(opcode, OpCode.MovRcxRbx) ThenBlock: { Emit_MovRcxRbx() }
                IfCondition EqualTo(opcode, OpCode.MovRsiRcx) ThenBlock: { Emit_MovRsiRcx() }
                IfCondition EqualTo(opcode, OpCode.MovRdiRcx) ThenBlock: { Emit_MovRdiRcx() }
                IfCondition EqualTo(opcode, OpCode.MovRdxRcx) ThenBlock: { Emit_MovRdxRcx() }
                IfCondition EqualTo(opcode, OpCode.MovRbxImm64) ThenBlock: { Emit_MovRbxImm64(op1) }
                IfCondition EqualTo(opcode, OpCode.MovRcxImm64) ThenBlock: { Emit_MovRcxImm64(op1) }
                IfCondition EqualTo(opcode, OpCode.MovRdxImm64) ThenBlock: { Emit_MovRdxImm64(op1) }
                IfCondition EqualTo(opcode, OpCode.MovRdiImm64) ThenBlock: { Emit_MovRdiImm64(op1) }
                IfCondition EqualTo(opcode, OpCode.MovRsiImm64) ThenBlock: { Emit_MovRsiImm64(op1) }
