                IfCondition EqualTo(opcode, OpCode.MovRspRbpOffset) ThenBlock: { Emit_MovRspRbpOffset(op1) }
                IfCondition EqualTo(opcode, OpCode.MovDerefRcxDl) ThenBlock: { Emit_MovDerefRcxDl() }
                IfCondition EqualTo(opcode, OpCode.AddRsiImm8) ThenBlock: { Emit_AddRsiImm8(op1) }
                IfCondition EqualTo(opcode, OpCode.AddRaxImm) ThenBlock: { Emit_AddRaxImm(op1) }
                IfCondition EqualTo(opcode, OpCode.AddRcxRax) ThenBlock: { Emit_AddRcxRax() }
                IfCondition EqualTo(opcode, OpCode.MovWordDerefRaxBx) ThenBlock: { Emit_MovWordDerefRaxBx() }
                IfCondition EqualTo(opcode, OpCode.MovWordDerefRbxAx) ThenBlock: { Emit_MovWordDerefRbxAx() }
                IfCondition EqualTo(opcode, OpCode.MovWordDerefRdiAx) ThenBlock: { Emit_MovWordDerefRdiAx() }
                IfCondition EqualTo(opcode, OpCode.MovRbxDerefRbpOffset) ThenBlock: { Emit_MovRbxDerefRbpOffset(op1) }
                IfCondition EqualTo(opcode, OpCode.MovRbxRbpOffset) ThenBlock: { Emit_MovRbxRbpOffset(op1) }
                IfCondition EqualTo(opcode, OpCode.MovRbxR15Offset) ThenBlock: { Emit_MovRbxR15Offset(op1) }
                IfCondition EqualTo(opcode, OpCode.MovzxRaxWordDerefRax) ThenBlock: { Emit_MovzxRaxWordDerefRax() }
                IfCondition EqualTo(opcode, OpCode.MovzxRaxWordDerefRbx) ThenBlock: { Emit_MovzxRaxWordDerefRbx() }
                IfCondition EqualTo(opcode, OpCode.MovzxRaxWordDerefRdi) ThenBlock: { Emit_MovzxRaxWordDerefRdi() }
                IfCondition EqualTo(opcode, OpCode.MovDwordDerefRaxEbx) ThenBlock: { Emit_MovDwordDerefRaxEbx() }
                IfCondition EqualTo(opcode, OpCode.MovDwordDerefRbxEax) ThenBlock: { Emit_MovDwordDerefRbxEax() }
                IfCondition EqualTo(opcode, OpCode.MovDwordDerefRdiEax) ThenBlock: { Emit_MovDwordDerefRdiEax() }
                IfCondition EqualTo(opcode, OpCode.MovEaxDerefRax) ThenBlock: { Emit_MovEaxDerefRax() }
                IfCondition EqualTo(opcode, OpCode.MovEaxDerefRbx) ThenBlock: { Emit_MovEaxDerefRbx() }
                IfCondition EqualTo(opcode, OpCode.MovEaxDerefRdi) ThenBlock: { Emit_MovEaxDerefRdi() }
                IfCondition EqualTo(opcode, OpCode.MovDerefRbxRax) ThenBlock: { Emit_MovDerefRbxRax() }
                IfCondition EqualTo(opcode, OpCode.StoreSizedDerefRax) ThenBlock: { Emit_StoreSizedDerefRax(op1) }
                IfCondition EqualTo(opcode, OpCode.LoadSizedDerefRax) ThenBlock: { Emit_LoadSizedDerefRax(op1) }
                IfCondition EqualTo(opcode, OpCode.StoreSizedAtReg) ThenBlock: { Emit_StoreSizedAtReg(op1, op2) }
                IfCondition EqualTo(opcode, OpCode.LoadSizedFromReg) ThenBlock: { Emit_LoadSizedFromReg(op1, op2) }
                IfCondition EqualTo(opcode, OpCode.MovR10Rax) ThenBlock: { Emit_MovR10Rax() }
                IfCondition EqualTo(opcode, OpCode.MovR11Rax) ThenBlock: { Emit_MovR11Rax() }
                IfCondition EqualTo(opcode, OpCode.TestR11R11) ThenBlock: { Emit_TestR11R11() }
                IfCondition EqualTo(opcode, OpCode.MovR11RbpOffset) ThenBlock: { Emit_MovR11RbpOffset(op1) }
                IfCondition EqualTo(opcode, OpCode.MovDerefR11R10) ThenBlock: { Emit_MovDerefR11R10() }
                IfCondition EqualTo(opcode, OpCode.MovDerefR11OffsetR10) ThenBlock: { Emit_MovDerefR11OffsetR10(op1) }
                IfCondition EqualTo(opcode, OpCode.MovDerefR12Rax) ThenBlock: { Emit_MovDerefR12Rax() }
                IfCondition EqualTo(opcode, OpCode.MovDerefR12OffsetRax) ThenBlock: { Emit_MovDerefR12OffsetRax(op1) }
                IfCondition EqualTo(opcode, OpCode.TestR12R12) ThenBlock: { Emit_TestR12R12() }
                IfCondition EqualTo(opcode, OpCode.CmpR14R13) ThenBlock: { Emit_CmpR14R13() }
                IfCondition EqualTo(opcode, OpCode.AddRsiR13) ThenBlock: { Emit_AddRsiR13() }
                IfCondition EqualTo(opcode, OpCode.CmpByteDerefRdiRcxZero) ThenBlock: { Emit_CmpByteDerefRdiRcxZero() }
                IfCondition EqualTo(opcode, OpCode.CmpAlImm8) ThenBlock: { Emit_CmpAlImm8(op1) }
                IfCondition EqualTo(opcode, OpCode.SubAlImm8) ThenBlock: { Emit_SubAlImm8(op1) }
                IfCondition EqualTo(opcode, OpCode.AddAlImm8) ThenBlock: { Emit_AddAlImm8(op1) }
                IfCondition EqualTo(opcode, OpCode.CmpRdiR12) ThenBlock: { Emit_CmpRdiR12() }
                IfCondition EqualTo(opcode, OpCode.CmpRdxImm8) ThenBlock: { Emit_CmpRdxImm8(op1) }
                IfCondition EqualTo(opcode, OpCode.SubRaxR14) ThenBlock: { Emit_SubRaxR14() }
                IfCondition EqualTo(opcode, OpCode.ShrRaxImm8) ThenBlock: { Emit_ShrRaxImm8(op1) }
                IfCondition EqualTo(opcode, OpCode.ShrRaxCl) ThenBlock: { Emit_ShrRaxCl() }
                IfCondition EqualTo(opcode, OpCode.AndRaxImm8) ThenBlock: { Emit_AndRaxImm8(op1) }
                IfCondition EqualTo(opcode, OpCode.IncR14) ThenBlock: { Emit_IncR14() }
                IfCondition EqualTo(opcode, OpCode.CmpRbxR15) ThenBlock: { Emit_CmpRbxR15() }
                IfCondition EqualTo(opcode, OpCode.MovRspOff1Al) ThenBlock: { Emit_MovRspOff1Al() }
                IfCondition EqualTo(opcode, OpCode.MovzxRaxByteR12R14) ThenBlock: { Emit_MovzxRaxByteR12R14() }
                IfCondition EqualTo(opcode, OpCode.MovRaxRspOff8) ThenBlock: { Emit_MovRaxRspOff8() }
                IfCondition EqualTo(opcode, OpCode.AddRdiRdx) ThenBlock: { Emit_AddRdiRdx() }
                IfCondition EqualTo(opcode, OpCode.MovRdiR15) ThenBlock: { Emit_MovRdiR15() }
                IfCondition EqualTo(opcode, OpCode.AndRspAlignment) ThenBlock: { Emit_AndRspAlignment() }
                IfCondition EqualTo(opcode, OpCode.MovzxRaxByteRdiRcx) ThenBlock: { Emit_MovzxRaxByteRdiRcx() }
                IfCondition EqualTo(opcode, OpCode.MovzxR9dByteRsiRcx) ThenBlock: { Emit_MovzxR9dByteRsiRcx() }
                IfCondition EqualTo(opcode, OpCode.MovRaxRsp8) ThenBlock: { Emit_MovRaxRsp8() }
                IfCondition EqualTo(opcode, OpCode.MovRspR8Dl) ThenBlock: { Emit_MovRspR8Dl() }
                IfCondition EqualTo(opcode, OpCode.MovzxRaxRspR8) ThenBlock: { Emit_MovzxRaxRspR8() }
                IfCondition EqualTo(opcode, OpCode.MovRspRax) ThenBlock: { Emit_MovRspRax() }
                IfCondition EqualTo(opcode, OpCode.MovRsiRsp) ThenBlock: { Emit_MovRsiRsp() }
                IfCondition EqualTo(opcode, OpCode.AddRdxImm8) ThenBlock: { Emit_AddRdxImm8(op1) }
                IfCondition EqualTo(opcode, OpCode.MovRspAl) ThenBlock: { Emit_MovRspAl() }
                IfCondition EqualTo(opcode, OpCode.LeaRsiRspR8) ThenBlock: { Emit_LeaRsiRspR8() }
                IfCondition EqualTo(opcode, OpCode.CallRax) ThenBlock: { Emit_CallRax() }
                IfCondition EqualTo(opcode, OpCode.LeaRaxLabel) ThenBlock: { Emit_LeaRaxLabel(op1) }
                IfCondition EqualTo(opcode, OpCode.PushR8) ThenBlock: { Emit_PushR8() }
                IfCondition EqualTo(opcode, OpCode.MovR8Rax) ThenBlock: { Emit_MovR8Rax() }
                IfCondition EqualTo(opcode, OpCode.MovR12Rsp) ThenBlock: { Emit_MovR12Rsp() }
                IfCondition EqualTo(opcode, OpCode.MovRspR12) ThenBlock: { Emit_MovRspR12() }
                IfCondition EqualTo(opcode, OpCode.MovRaxRspOffset) ThenBlock: { Emit_MovRaxRspOffset(op1) }
                IfCondition EqualTo(opcode, OpCode.MarkLabel) ThenBlock: { Emit_MarkLabel(op1) }
            }
            
            i = Add(i, 1)
        }
        
        EmitBuffer.enabled = 1
    }
}

Function.EmitBuffer_ExportJSON {
    Output: Address
    Body: {
        PrintMessage("[EMIT BUFFER] Exporting trace...\n")
        json_array = JSON.NewArray()
        count = XArray.XSize(EmitBuffer.instructions)
        
        i = 0
        WhileLoop LessThan(i, count) {
            entry = XArray.XGet(EmitBuffer.instructions, i)
            func_node = Dereference(entry)
            ast_node = Dereference(Add(entry, 8))
            opcode = Dereference(Add(entry, 16))
            opt_class = Dereference(Add(entry, 24))
            op1 = Dereference(Add(entry, 32))
            op2 = Dereference(Add(entry, 40))
            
            inst_obj = JSON.NewObject()
            JSON.SetNumber(inst_obj, "i", i)
            
            IfCondition NotEqual(func_node, 0) ThenBlock: {
                func_name = AST_GetData1(func_node)
                JSON.SetString(inst_obj, "func", func_name)
            } ElseBlock: {
                JSON.SetString(inst_obj, "func", "global")
            }
            
            IfCondition NotEqual(ast_node, 0) ThenBlock: {
                ast_type = AST_GetType(ast_node)
                JSON.SetNumber(inst_obj, "ast_type", ast_type)
            }
            
            JSON.SetNumber(inst_obj, "op", opcode)
            JSON.SetNumber(inst_obj, "cls", opt_class)
            JSON.SetNumber(inst_obj, "op1", op1)
            JSON.SetNumber(inst_obj, "op2", op2)
            
            JSON.PushObject(json_array, inst_obj)
            i = Add(i, 1)
        }
        
        json_str = JSON.SerializeArray(json_array)
        JSON.FreeArray(json_array)
        ReturnValue(json_str)
    }
}

Function.EmitBuffer_SaveToFile {
    Input: filename: Address
    Body: {
        json_str = EmitBuffer_ExportJSON()
        WriteTextFile(filename, json_str)
    }
}