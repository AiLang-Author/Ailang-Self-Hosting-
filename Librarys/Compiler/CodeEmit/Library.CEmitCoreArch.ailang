// =============================================================================
// MEMORY ACCESS WITH OFFSET FROM Rsb Rsp
// =============================================================================


// Save RSP to [RBP+offset]
Function.Emit_MovRbpOffsetRsp {
    Input: offset: Integer
    Body: {
        IfCondition EqualTo(Emit.target, 1) ThenBlock: {
            X86_MovRbpOffsetRsp(offset)
        }
    }
}

