// =============================================================================
// GENERIC SIZE-DISPATCHING FUNCTIONS
// For type-aware StoreValue/Dereference compilation
// =============================================================================

// Store value from RBX to address in RAX, sized by type
// size: 1=byte, 2=word, 4=dword, 8=qword
Function.Emit_StoreSizedDerefRax {
    Input: size: Integer
    Body: {
        IfCondition EqualTo(Emit.target, 1) ThenBlock: {
            IfCondition EqualTo(size, 1) ThenBlock: { X86_MovByteDerefRaxBl() }
            IfCondition EqualTo(size, 2) ThenBlock: { X86_MovWordDerefRaxBx() }
            IfCondition EqualTo(size, 4) ThenBlock: { X86_MovDwordDerefRaxEbx() }
            IfCondition EqualTo(size, 8) ThenBlock: { X86_MovDerefRaxRbx() }
        }
    }
}

// Load value from address in RAX into RAX, sized by type (zero-extended)
// size: 1=byte, 2=word, 4=dword, 8=qword
Function.Emit_LoadSizedDerefRax {
    Input: size: Integer
    Body: {
        IfCondition EqualTo(Emit.target, 1) ThenBlock: {
            IfCondition EqualTo(size, 1) ThenBlock: { X86_MovzxRaxByteDerefRax() }
            IfCondition EqualTo(size, 2) ThenBlock: { X86_MovzxRaxWordDerefRax() }
            IfCondition EqualTo(size, 4) ThenBlock: { X86_MovEaxDerefRax() }
            IfCondition EqualTo(size, 8) ThenBlock: { X86_MovRaxDerefRax() }
        }
    }
}

// Store AL/AX/EAX/RAX to address in specified register
// reg: base address register, size: data size
Function.Emit_StoreSizedAtReg {
    Input: reg: Integer
    Input: size: Integer
    Body: {
        IfCondition EqualTo(Emit.target, 1) ThenBlock: {
            IfCondition EqualTo(size, 1) ThenBlock: {
                // Byte store (AL)
                IfCondition EqualTo(reg, Reg.RAX) ThenBlock: { X86_MovByteDerefRaxBl() }
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { X86_MovByteDerefRbxAl() }
                IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { X86_MovByteDerefRdiAl() }
                IfCondition EqualTo(reg, Reg.RSI) ThenBlock: { X86_MovByteDerefRsiAl() }
            }
            IfCondition EqualTo(size, 2) ThenBlock: {
                // Word store (AX)
                IfCondition EqualTo(reg, Reg.RAX) ThenBlock: { X86_MovWordDerefRaxBx() }
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { X86_MovWordDerefRbxAx() }
                IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { X86_MovWordDerefRdiAx() }
            }
            IfCondition EqualTo(size, 4) ThenBlock: {
                // Dword store (EAX)
                IfCondition EqualTo(reg, Reg.RAX) ThenBlock: { X86_MovDwordDerefRaxEbx() }
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { X86_MovDwordDerefRbxEax() }
                IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { X86_MovDwordDerefRdiEax() }
            }
            IfCondition EqualTo(size, 8) ThenBlock: {
                // Qword store (RAX)
                IfCondition EqualTo(reg, Reg.RAX) ThenBlock: { X86_MovDerefRaxRbx() }
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { X86_MovDerefRbxRax() }
            }
        }
    }
}

// Load sized value from address in register to RAX (zero-extended)
Function.Emit_LoadSizedFromReg {
    Input: reg: Integer
    Input: size: Integer
    Body: {
        IfCondition EqualTo(Emit.target, 1) ThenBlock: {
            IfCondition EqualTo(size, 1) ThenBlock: {
                // Byte load -> zero-extend to RAX
                IfCondition EqualTo(reg, Reg.RAX) ThenBlock: { X86_MovzxRaxByteDerefRax() }
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { X86_MovzxRaxByteDerefRbx() }
                IfCondition EqualTo(reg, Reg.RSI) ThenBlock: { X86_MovzxRaxByteDerefRsi() }
                IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { X86_MovzxRaxByteDerefRdi() }
            }
            IfCondition EqualTo(size, 2) ThenBlock: {
                // Word load -> zero-extend to RAX
                IfCondition EqualTo(reg, Reg.RAX) ThenBlock: { X86_MovzxRaxWordDerefRax() }
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { X86_MovzxRaxWordDerefRbx() }
                IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { X86_MovzxRaxWordDerefRdi() }
            }
            IfCondition EqualTo(size, 4) ThenBlock: {
                // Dword load -> auto zero-extends in x86-64
                IfCondition EqualTo(reg, Reg.RAX) ThenBlock: { X86_MovEaxDerefRax() }
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { X86_MovEaxDerefRbx() }
                IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { X86_MovEaxDerefRdi() }
            }
            IfCondition EqualTo(size, 8) ThenBlock: {
                // Qword load
                IfCondition EqualTo(reg, Reg.RAX) ThenBlock: { X86_MovRaxDerefRax() }
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { X86_MovRaxDerefRbx() }
            }
        }
    }
}


