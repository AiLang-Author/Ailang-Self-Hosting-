// Library.CListing.ailang
// -asm listing. Each source line is printed above the instructions it emitted.
// Compiler-inserted bytes (frame, pool base, exit) get their own comment.
// Recording is off unless -asm / -asm-all is passed, and it never writes
// the code buffer. The ELF bytes stay the ones the emitter chose.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL).

LibraryImport.Arrays
LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.Import.CFileMap

// Record, 64 bytes:
//   [0]  code pos    [8]  byte length
//   [16] mnemonic    [24] combined source line
//   [32] compiler note, or 0
//   [40] func file ("main", a library name, or 0 for startup)
//   [48] local line  [56] flags (1 = label anchor, 0 = instruction)
FixedPool.Listing {
    "mode": Initialize=0, CanChange=True
    "records": Initialize=0, CanChange=True
    "span_pos": Initialize=0, CanChange=True
    "span_text": Initialize=0, CanChange=True
    "span_open": Initialize=0, CanChange=True
    "span_depth": Initialize=0, CanChange=True
    "note": Initialize=0, CanChange=True
    "line": Initialize=0, CanChange=True
    "func_file": Initialize=0, CanChange=True
    "main_path": Initialize=0, CanChange=True
    "main_base": Initialize=0, CanChange=True
    "main_text": Initialize=0, CanChange=True
    "main_offs": Initialize=0, CanChange=True
    "main_orig": Initialize=0, CanChange=True
    "hexbuf": Initialize=0, CanChange=True
}

Function.Listing_Copy {
    Input: text: Address
    Output: Address
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = StringLength(text)
        buf = Allocate(Add(n, 1))
        MemoryCopy(buf, text, n)
        SetByte(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.Listing_RegName {
    Input: reg: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue("rax") }
        IfCondition EqualTo(reg, 1) ThenBlock: { ReturnValue("rcx") }
        IfCondition EqualTo(reg, 2) ThenBlock: { ReturnValue("rdx") }
        IfCondition EqualTo(reg, 3) ThenBlock: { ReturnValue("rbx") }
        IfCondition EqualTo(reg, 4) ThenBlock: { ReturnValue("rsp") }
        IfCondition EqualTo(reg, 5) ThenBlock: { ReturnValue("rbp") }
        IfCondition EqualTo(reg, 6) ThenBlock: { ReturnValue("rsi") }
        IfCondition EqualTo(reg, 7) ThenBlock: { ReturnValue("rdi") }
        IfCondition EqualTo(reg, 8) ThenBlock: { ReturnValue("r8") }
        IfCondition EqualTo(reg, 9) ThenBlock: { ReturnValue("r9") }
        IfCondition EqualTo(reg, 10) ThenBlock: { ReturnValue("r10") }
        IfCondition EqualTo(reg, 11) ThenBlock: { ReturnValue("r11") }
        IfCondition EqualTo(reg, 12) ThenBlock: { ReturnValue("r12") }
        IfCondition EqualTo(reg, 13) ThenBlock: { ReturnValue("r13") }
        IfCondition EqualTo(reg, 14) ThenBlock: { ReturnValue("r14") }
        IfCondition EqualTo(reg, 15) ThenBlock: { ReturnValue("r15") }
        ReturnValue("reg")
    }
}

Function.Listing_CcName {
    Input: cc: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(cc, 0) ThenBlock: { ReturnValue("JO") }
        IfCondition EqualTo(cc, 1) ThenBlock: { ReturnValue("JNO") }
        IfCondition EqualTo(cc, 2) ThenBlock: { ReturnValue("JB") }
        IfCondition EqualTo(cc, 3) ThenBlock: { ReturnValue("JAE") }
        IfCondition EqualTo(cc, 4) ThenBlock: { ReturnValue("JE") }
        IfCondition EqualTo(cc, 5) ThenBlock: { ReturnValue("JNE") }
        IfCondition EqualTo(cc, 6) ThenBlock: { ReturnValue("JBE") }
        IfCondition EqualTo(cc, 7) ThenBlock: { ReturnValue("JA") }
        IfCondition EqualTo(cc, 8) ThenBlock: { ReturnValue("JS") }
        IfCondition EqualTo(cc, 9) ThenBlock: { ReturnValue("JNS") }
        IfCondition EqualTo(cc, 10) ThenBlock: { ReturnValue("JP") }
        IfCondition EqualTo(cc, 11) ThenBlock: { ReturnValue("JNP") }
        IfCondition EqualTo(cc, 12) ThenBlock: { ReturnValue("JL") }
        IfCondition EqualTo(cc, 13) ThenBlock: { ReturnValue("JGE") }
        IfCondition EqualTo(cc, 14) ThenBlock: { ReturnValue("JLE") }
        IfCondition EqualTo(cc, 15) ThenBlock: { ReturnValue("JG") }
        ReturnValue("JCC")
    }
}

Function.Listing_BaseName {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: {
            ReturnValue("main")
        }
        n = StringLength(path)
        i = Subtract(n, 1)
        slash = -1
        WhileLoop GreaterEqual(i, 0) {
            b = GetByte(path, i)
            IfCondition EqualTo(b, 47) ThenBlock: {
                slash = i
                ExitLoop
            }
            i = Subtract(i, 1)
        }
        IfCondition LessThan(slash, 0) ThenBlock: {
            ReturnValue(path)
        }
        start = Add(slash, 1)
        len = Subtract(n, start)
        buf = Allocate(Add(len, 1))
        MemoryCopy(buf, Add(path, start), len)
        SetByte(buf, len, 0)
        ReturnValue(buf)
    }
}

Function.Listing_ReadFile {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: {
            ReturnValue(0)
        }
        fd = FileOpen(path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        sz = FileSeek(fd, 0, 2)
        FileSeek(fd, 0, 0)
        IfCondition LessThan(sz, 1) ThenBlock: {
            FileClose(fd)
            ReturnValue(0)
        }
        buf = Allocate(Add(sz, 1))
        n = FileRead(fd, buf, sz)
        FileClose(fd)
        IfCondition LessThan(n, 1) ThenBlock: {
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.Listing_IndexMain {
    Input: path: Address
    Body: {
        Listing.main_path = path
        Listing.main_base = Listing_BaseName(path)
        text = Listing_ReadFile(path)
        Listing.main_text = text
        IfCondition EqualTo(text, 0) ThenBlock: {
            ReturnValue(0)
        }
        offs = Array.Create(256)
        orig = Array.Create(256)
        Array.Push(offs, 0)
        n = StringLength(text)
        i = 0
        line_no = 1
        line_start = 0
        WhileLoop LessThan(i, n) {
            b = GetByte(text, i)
            IfCondition EqualTo(b, 10) ThenBlock: {
                llen = Subtract(i, line_start)
                is_imp = Listing_IsImport(line_start, llen)
                IfCondition EqualTo(is_imp, 0) ThenBlock: {
                    Array.Push(orig, line_no)
                }
                line_no = Add(line_no, 1)
                line_start = Add(i, 1)
                Array.Push(offs, line_start)
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(line_start, n) ThenBlock: {
            llen = Subtract(n, line_start)
            IfCondition GreaterThan(llen, 0) ThenBlock: {
                is_imp = Listing_IsImport(line_start, llen)
                IfCondition EqualTo(is_imp, 0) ThenBlock: {
                    Array.Push(orig, line_no)
                }
            }
        }
        Listing.main_offs = offs
        Listing.main_orig = orig
        ReturnValue(1)
    }
}

Function.Listing_Match {
    Input: start: Integer
    Input: prefix: Address
    Output: Integer
    Body: {
        n = StringLength(prefix)
        i = 0
        WhileLoop LessThan(i, n) {
            a = GetByte(Listing.main_text, Add(start, i))
            b = GetByte(prefix, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Listing_IsImport {
    Input: start: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(len, 7) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(len, 14) ThenBlock: {
            hit = Listing_Match(start, "LibraryImport.")
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        hit = Listing_Match(start, "Import.")
        ReturnValue(hit)
    }
}

Function.Listing_OrigLine {
    Input: emitted: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Listing.main_orig, 0) ThenBlock: {
            ReturnValue(emitted)
        }
        IfCondition LessThan(emitted, 1) ThenBlock: {
            ReturnValue(emitted)
        }
        idx = Subtract(emitted, 1)
        count = Array.Size(Listing.main_orig)
        IfCondition GreaterEqual(idx, count) ThenBlock: {
            ReturnValue(emitted)
        }
        orig = Array.Get(Listing.main_orig, idx)
        ReturnValue(orig)
    }
}

Function.Listing_LineText {
    Input: local_line: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(Listing.main_text, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(local_line, 1) ThenBlock: {
            ReturnValue(0)
        }
        idx = Subtract(local_line, 1)
        count = Array.Size(Listing.main_offs)
        IfCondition GreaterEqual(idx, count) ThenBlock: {
            ReturnValue(0)
        }
        start = Array.Get(Listing.main_offs, idx)
        endp = StringLength(Listing.main_text)
        next = Add(idx, 1)
        IfCondition LessThan(next, count) ThenBlock: {
            endp = Array.Get(Listing.main_offs, next)
        }
        WhileLoop LessThan(start, endp) {
            b = GetByte(Listing.main_text, start)
            IfCondition EqualTo(b, 32) ThenBlock: {
                start = Add(start, 1)
                ContinueLoop
            }
            IfCondition EqualTo(b, 9) ThenBlock: {
                start = Add(start, 1)
                ContinueLoop
            }
            ExitLoop
        }
        stop = endp
        WhileLoop GreaterThan(stop, start) {
            prev = Subtract(stop, 1)
            b = GetByte(Listing.main_text, prev)
            IfCondition EqualTo(b, 10) ThenBlock: {
                stop = prev
                ContinueLoop
            }
            IfCondition EqualTo(b, 13) ThenBlock: {
                stop = prev
                ContinueLoop
            }
            ExitLoop
        }
        len = Subtract(stop, start)
        IfCondition LessEqual(len, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(len, 240) ThenBlock: {
            len = 240
        }
        buf = Allocate(Add(len, 1))
        MemoryCopy(buf, Add(Listing.main_text, start), len)
        SetByte(buf, len, 0)
        ReturnValue(buf)
    }
}

Function.Listing_Init {
    Input: mode: Integer
    Input: main_path: Address
    Body: {
        Listing.mode = mode
        Listing.span_open = 0
        Listing.span_depth = 0
        Listing.note = 0
        Listing.line = 0
        Listing.func_file = 0
        Listing.records = 0
        Listing.main_text = 0
        Listing.main_offs = 0
        Listing.main_orig = 0
        IfCondition EqualTo(mode, 0) ThenBlock: {
            ReturnValue(0)
        }
        Listing.records = Array.Create(1024)
        Listing.hexbuf = Allocate(2048)
        Listing_IndexMain(main_path)
        ReturnValue(1)
    }
}

Function.Listing_SetLine {
    Input: combined: Integer
    Body: {
        IfCondition EqualTo(Listing.mode, 0) ThenBlock: {
            ReturnValue(0)
        }
        Listing.line = combined
        ReturnValue(1)
    }
}

Function.Listing_Compiler {
    Input: note: Address
    Body: {
        IfCondition EqualTo(Listing.mode, 0) ThenBlock: {
            ReturnValue(0)
        }
        Listing.note = note
        ReturnValue(1)
    }
}

Function.Listing_Source {
    Body: {
        Listing.note = 0
        ReturnValue(1)
    }
}

Function.Listing_BeginFunc {
    Input: node: Address
    Body: {
        IfCondition EqualTo(Listing.mode, 0) ThenBlock: {
            ReturnValue(0)
        }
        line = AST_GetLine(node)
        Listing.line = line
        found = FileMap_Lookup(line)
        IfCondition EqualTo(found, 1) ThenBlock: {
            Listing.func_file = FileMap.result_file
        } ElseBlock: {
            Listing.func_file = "main"
        }
        ReturnValue(1)
    }
}

Function.Listing_EndFunc {
    Body: {
        Listing.func_file = 0
        Listing.note = 0
        ReturnValue(1)
    }
}

Function.Listing_Push {
    Input: pos: Integer
    Input: len: Integer
    Input: text: Address
    Input: flags: Integer
    Body: {
        entry = Allocate(64)
        StoreValue(entry, pos)
        StoreValue(Add(entry, 8), len)
        StoreValue(Add(entry, 16), Listing_Copy(text))
        StoreValue(Add(entry, 24), Listing.line)
        StoreValue(Add(entry, 32), Listing.note)
        StoreValue(Add(entry, 40), Listing.func_file)
        local_line = 0
        IfCondition GreaterThan(Listing.line, 0) ThenBlock: {
            found = FileMap_Lookup(Listing.line)
            IfCondition EqualTo(found, 1) ThenBlock: {
                local_line = FileMap.result_line
                fcmp = StringCompare(FileMap.result_file, "main")
                IfCondition EqualTo(fcmp, 0) ThenBlock: {
                    local_line = Listing_OrigLine(local_line)
                }
            }
        }
        StoreValue(Add(entry, 48), local_line)
        StoreValue(Add(entry, 56), flags)
        Array.Push(Listing.records, entry)
        ReturnValue(1)
    }
}

Function.Listing_Anchor {
    Input: name: Address
    Body: {
        IfCondition EqualTo(Listing.mode, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        Listing_Push(Emit.code_size, 0, name, 1)
        ReturnValue(1)
    }
}

Function.Listing_Open {
    Input: text: Address
    Body: {
        IfCondition EqualTo(Listing.mode, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Listing.span_open, 1) ThenBlock: {
            Listing.span_depth = Add(Listing.span_depth, 1)
            ReturnValue(0)
        }
        Listing.span_pos = Emit.code_size
        Listing.span_text = Listing_Copy(text)
        Listing.span_open = 1
        Listing.span_depth = 1
        ReturnValue(1)
    }
}

Function.Listing_Close {
    Body: {
        IfCondition EqualTo(Listing.mode, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Listing.span_open, 0) ThenBlock: {
            ReturnValue(0)
        }
        Listing.span_depth = Subtract(Listing.span_depth, 1)
        IfCondition GreaterThan(Listing.span_depth, 0) ThenBlock: {
            ReturnValue(0)
        }
        len = Subtract(Emit.code_size, Listing.span_pos)
        Listing.span_open = 0
        IfCondition LessEqual(len, 0) ThenBlock: {
            ReturnValue(0)
        }
        Listing_Push(Listing.span_pos, len, Listing.span_text, 0)
        ReturnValue(1)
    }
}

Function.Listing_WriteStr {
    Input: fd: Integer
    Input: text: Address
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = StringLength(text)
        FileWrite(fd, text, n)
        ReturnValue(n)
    }
}

Function.Listing_HexDigit {
    Input: v: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(v, 10) ThenBlock: {
            ReturnValue(Add(48, v))
        }
        ReturnValue(Add(55, v))
    }
}

Function.Listing_WriteHex {
    Input: fd: Integer
    Input: pos: Integer
    Input: len: Integer
    Body: {
        i = 0
        out = 0
        WhileLoop LessThan(i, len) {
            IfCondition GreaterThan(out, 2040) ThenBlock: {
                ExitLoop
            }
            raw = GetByte(Emit.code, Add(pos, i))
            b = BitwiseAnd(raw, 255)
            hi = RightShift(b, 4)
            lo = BitwiseAnd(b, 15)
            SetByte(Listing.hexbuf, out, Listing_HexDigit(hi))
            SetByte(Listing.hexbuf, Add(out, 1), Listing_HexDigit(lo))
            SetByte(Listing.hexbuf, Add(out, 2), 32)
            out = Add(out, 3)
            i = Add(i, 1)
        }
        FileWrite(fd, Listing.hexbuf, out)
        ReturnValue(out)
    }
}

Function.Listing_AllNop {
    Input: pos: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(len, 0) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, len) {
            raw = GetByte(Emit.code, Add(pos, i))
            b = BitwiseAnd(raw, 255)
            IfCondition NotEqual(b, 144) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Listing_Disp32 {
    Input: at: Integer
    Output: Integer
    Body: {
        b0 = BitwiseAnd(GetByte(Emit.code, at), 255)
        b1 = BitwiseAnd(GetByte(Emit.code, Add(at, 1)), 255)
        b2 = BitwiseAnd(GetByte(Emit.code, Add(at, 2)), 255)
        b3 = BitwiseAnd(GetByte(Emit.code, Add(at, 3)), 255)
        disp = b0
        disp = Add(disp, Multiply(b1, 256))
        disp = Add(disp, Multiply(b2, 65536))
        disp = Add(disp, Multiply(b3, 16777216))
        IfCondition GreaterEqual(b3, 128) ThenBlock: {
            disp = Subtract(disp, 4294967296)
        }
        ReturnValue(disp)
    }
}

Function.Listing_FindAnchor {
    Input: target: Integer
    Output: Address
    Body: {
        count = Array.Size(Listing.records)
        i = 0
        WhileLoop LessThan(i, count) {
            entry = Array.Get(Listing.records, i)
            flags = Dereference(Add(entry, 56))
            IfCondition EqualTo(flags, 1) ThenBlock: {
                apos = Dereference(entry)
                IfCondition EqualTo(apos, target) ThenBlock: {
                    ReturnValue(Dereference(Add(entry, 16)))
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Listing_ResolveBranch {
    Input: pos: Integer
    Input: len: Integer
    Output: Address
    Body: {
        IfCondition LessThan(len, 5) ThenBlock: {
            ReturnValue(0)
        }
        op = GetByte(Emit.code, pos)
        IfCondition EqualTo(op, 232) ThenBlock: {
            disp = Listing_Disp32(Add(pos, 1))
            target = Add(Add(pos, 5), disp)
            name = Listing_FindAnchor(target)
            IfCondition EqualTo(name, 0) ThenBlock: {
                ReturnValue(0)
            }
            text = StringConcat("CALL ", name)
            ReturnValue(text)
        }
        IfCondition EqualTo(op, 233) ThenBlock: {
            disp = Listing_Disp32(Add(pos, 1))
            target = Add(Add(pos, 5), disp)
            name = Listing_FindAnchor(target)
            IfCondition EqualTo(name, 0) ThenBlock: {
                ReturnValue(0)
            }
            text = StringConcat("JMP ", name)
            ReturnValue(text)
        }
        ReturnValue(0)
    }
}

Function.Listing_Shown {
    Input: filter_file: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Listing.mode, 2) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(filter_file, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp = StringCompare(filter_file, "main")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Listing_AsmPath {
    Input: path: Address
    Output: Address
    Body: {
        n = StringLength(path)
        IfCondition GreaterEqual(n, 2) ThenBlock: {
            dot = GetByte(path, Subtract(n, 2))
            ex = GetByte(path, Subtract(n, 1))
            IfCondition EqualTo(dot, 46) ThenBlock: {
                IfCondition EqualTo(ex, 120) ThenBlock: {
                    pref = Allocate(n)
                    MemoryCopy(pref, path, Subtract(n, 1))
                    SetByte(pref, Subtract(n, 1), 0)
                    result = StringConcat(pref, "asm")
                    ReturnValue(result)
                }
            }
        }
        result = StringConcat(path, ".asm")
        ReturnValue(result)
    }
}

Function.Listing_WriteBracket {
    Input: fd: Integer
    Input: note: Address
    Input: filter_file: Address
    Input: local_line: Integer
    Body: {
        Listing_WriteStr(fd, "\n")
        IfCondition NotEqual(note, 0) ThenBlock: {
            Listing_WriteStr(fd, "; compiler: ")
            Listing_WriteStr(fd, note)
            Listing_WriteStr(fd, "\n")
            ReturnValue(1)
        }
        Listing_WriteStr(fd, "; ")
        cmp = 1
        IfCondition EqualTo(filter_file, 0) ThenBlock: {
            cmp = 0
        }
        IfCondition NotEqual(filter_file, 0) ThenBlock: {
            cmp = StringCompare(filter_file, "main")
        }
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            Listing_WriteStr(fd, Listing.main_base)
        } ElseBlock: {
            IfCondition EqualTo(filter_file, 0) ThenBlock: {
                Listing_WriteStr(fd, Listing.main_base)
            } ElseBlock: {
                Listing_WriteStr(fd, filter_file)
            }
        }
        Listing_WriteStr(fd, ":")
        nstr = NumberToString(local_line)
        Listing_WriteStr(fd, nstr)
        Listing_WriteStr(fd, "    ")
        src = 0
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            src = Listing_LineText(local_line)
        }
        IfCondition NotEqual(src, 0) ThenBlock: {
            Listing_WriteStr(fd, src)
        }
        Listing_WriteStr(fd, "\n")
        ReturnValue(1)
    }
}

Function.Listing_Write {
    Input: out_path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Listing.mode, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Listing.records, 0) ThenBlock: {
            ReturnValue(0)
        }
        path = Listing_AsmPath(out_path)
        fd = FileOpen(path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[ASM] could not write ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        Listing_WriteStr(fd, "; AILANG listing. Each source line is above the instructions it emitted.\n")
        Listing_WriteStr(fd, "; Lines marked compiler are bytes the program did not write: frame, pool base, exit.\n")
        IfCondition EqualTo(Listing.mode, 1) ThenBlock: {
            Listing_WriteStr(fd, "; Library bodies are omitted. -asm-all includes them.\n")
        }
        Listing_WriteStr(fd, "; ")
        Listing_WriteStr(fd, Listing.main_base)
        Listing_WriteStr(fd, "\n")

        count = Array.Size(Listing.records)
        i = 0
        prev_note = 0
        prev_line = -1
        prev_file = 0
        have_prev = 0
        omit_n = 0
        omit_file = 0
        WhileLoop LessThan(i, count) {
            entry = Array.Get(Listing.records, i)
            pos = Dereference(entry)
            len = Dereference(Add(entry, 8))
            text = Dereference(Add(entry, 16))
            note = Dereference(Add(entry, 32))
            filter_file = Dereference(Add(entry, 40))
            local_line = Dereference(Add(entry, 48))
            flags = Dereference(Add(entry, 56))
            show = Listing_Shown(filter_file)
            IfCondition EqualTo(show, 0) ThenBlock: {
                IfCondition EqualTo(flags, 0) ThenBlock: {
                    omit_n = Add(omit_n, 1)
                    omit_file = filter_file
                }
            } ElseBlock: {
                IfCondition GreaterThan(omit_n, 0) ThenBlock: {
                    Listing_WriteStr(fd, "\n; compiler: omitted ")
                    nstr = NumberToString(omit_n)
                    Listing_WriteStr(fd, nstr)
                    Listing_WriteStr(fd, " instructions from ")
                    IfCondition EqualTo(omit_file, 0) ThenBlock: {
                        Listing_WriteStr(fd, "library")
                    } ElseBlock: {
                        Listing_WriteStr(fd, omit_file)
                    }
                    Listing_WriteStr(fd, "\n")
                    omit_n = 0
                    have_prev = 0
                }
                IfCondition EqualTo(flags, 1) ThenBlock: {
                    Listing_WriteStr(fd, "\n")
                    Listing_WriteStr(fd, text)
                    Listing_WriteStr(fd, ":\n")
                    have_prev = 0
                } ElseBlock: {
                    same = 0
                    IfCondition EqualTo(have_prev, 1) ThenBlock: {
                        IfCondition NotEqual(note, 0) ThenBlock: {
                            IfCondition NotEqual(prev_note, 0) ThenBlock: {
                                scmp = StringCompare(note, prev_note)
                                IfCondition EqualTo(scmp, 0) ThenBlock: {
                                    same = 1
                                }
                            }
                        } ElseBlock: {
                            IfCondition EqualTo(prev_note, 0) ThenBlock: {
                                IfCondition EqualTo(local_line, prev_line) ThenBlock: {
                                    IfCondition EqualTo(filter_file, prev_file) ThenBlock: {
                                        same = 1
                                    }
                                    IfCondition EqualTo(filter_file, 0) ThenBlock: {
                                        IfCondition EqualTo(prev_file, 0) ThenBlock: {
                                            same = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(same, 0) ThenBlock: {
                        Listing_WriteBracket(fd, note, filter_file, local_line)
                    }
                    Listing_WriteStr(fd, "    ")
                    Listing_WriteHex(fd, pos, len)
                    shown = text
                    branch = Listing_ResolveBranch(pos, len)
                    IfCondition NotEqual(branch, 0) ThenBlock: {
                        shown = branch
                    }
                    nop = Listing_AllNop(pos, len)
                    IfCondition EqualTo(nop, 1) ThenBlock: {
                        Listing_WriteStr(fd, "NOP")
                        scmp = StringCompare(text, "NOP")
                        IfCondition NotEqual(scmp, 0) ThenBlock: {
                            Listing_WriteStr(fd, "    ; redundant reload removed")
                        }
                    } ElseBlock: {
                        Listing_WriteStr(fd, shown)
                    }
                    Listing_WriteStr(fd, "\n")
                    prev_note = note
                    prev_line = local_line
                    prev_file = filter_file
                    have_prev = 1
                }
            }
            i = Add(i, 1)
        }
        IfCondition GreaterThan(omit_n, 0) ThenBlock: {
            Listing_WriteStr(fd, "\n; compiler: omitted ")
            nstr = NumberToString(omit_n)
            Listing_WriteStr(fd, nstr)
            Listing_WriteStr(fd, " instructions from ")
            IfCondition EqualTo(omit_file, 0) ThenBlock: {
                Listing_WriteStr(fd, "library")
            } ElseBlock: {
                Listing_WriteStr(fd, omit_file)
            }
            Listing_WriteStr(fd, "\n")
        }
        FileClose(fd)
        PrintMessage("[ASM] ")
        PrintMessage(path)
        PrintMessage("\n")
        ReturnValue(1)
    }
}
