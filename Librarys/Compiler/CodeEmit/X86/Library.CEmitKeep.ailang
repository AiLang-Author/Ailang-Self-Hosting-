// PSHUFLW XMM0, XMM0, 0 - F2 0F 70 C0 00

Function.X86_MOVSD_DerefRSP_XMM0 {
    Body: {
        mtxt = "MOVSD_DerefRSP_XMM0"
        Listing_Open(mtxt)
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x11)
        Emit_Byte(0x04)
        Emit_Byte(0x24)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOVSD XMM0, [RAX] - F2 0F 10 00
// Loads a double from memory pointed to by RAX. Used by the transcendental
// constant loader: RAX holds a relocated data-section address, this
// dereferences it into XMM0.

Function.X86_MOVSD_XMM0_DerefRSP {
    Body: {
        mtxt = "MOVSD_XMM0_DerefRSP"
        Listing_Open(mtxt)
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x10)
        Emit_Byte(0x04)  // SIB follows
        Emit_Byte(0x24)  // RSP
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOVSD [RSP], XMM0 - F2 0F 11 04 24

Function.X86_MOVSD_XMM0_DerefRax {
    Body: {
        mtxt = "MOVSD_XMM0_DerefRax"
        Listing_Open(mtxt)
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x10)
        Emit_Byte(0x00)  // ModR/M: mod=00, reg=000 (XMM0), rm=000 (RAX)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOVSD XMM0, [RBP+off] - F2 0F 10 45 xx (8-bit offset)

Function.X86_PopXMM0 {
    Body: {
        mtxt = "POP xmm0"
        Listing_Open(mtxt)
        // MOVSD XMM0, [RSP]
        X86_MOVSD_XMM0_DerefRSP()
        // ADD RSP, 8
        Emit_Byte(0x48)
        Emit_Byte(0x83)
        Emit_Byte(0xC4)
        Emit_Byte(0x08)
        Listing_Close()
    }
}

// Push XMM1 to stack

Function.X86_PushXMM0 {
    Body: {
        mtxt = "PUSH xmm0"
        Listing_Open(mtxt)
        // SUB RSP, 8
        Emit_Byte(0x48)
        Emit_Byte(0x83)
        Emit_Byte(0xEC)
        Emit_Byte(0x08)
        // MOVSD [RSP], XMM0
        X86_MOVSD_DerefRSP_XMM0()
        Listing_Close()
    }
}

// Pop XMM0 from stack (MOVSD XMM0, [RSP]; ADD RSP,8)

