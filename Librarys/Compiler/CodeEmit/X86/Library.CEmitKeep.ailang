        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x0F)    // 0x0F
        Emit_Byte(0xB6)   // 0xB6 MOVZX r64, r/m8
        Emit_Byte(0x06)     // 0x06 ModR/M: RAX, [RSI]
