// MOV R10, imm64

Function.X86_MovRaxDerefRsp {
    Body: {
        mtxt = "MovRaxDerefRsp"
        Listing_Open(mtxt)
        // 48 8B 04 24 = MOV RAX, [RSP]
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        Emit_Byte(0x04)     // 0x04 ModR/M: RAX, SIB follows
        Emit_Byte(0x24)    // 0x24 SIB: [RSP]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RBP, RSP - set up frame pointer

Function.X86_MovRaxImm64 {
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("MOV rax, ", nstr)
        Listing_Open(mtxt)
        // REX.W + B8+rd (0x48 0xB8) then 8 bytes
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xB8)   // 0xB8 MOV RAX
        Emit_QWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RBX, imm64

Function.X86_MovRbxImm64 {
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("MOV rbx, ", nstr)
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xBB)   // 0xBB MOV RBX
        Emit_QWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RCX, imm64

Function.X86_MovRcxDerefRbx {
    Body: {
