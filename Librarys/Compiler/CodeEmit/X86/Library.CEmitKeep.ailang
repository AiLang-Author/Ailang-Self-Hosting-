Function.X86_MovDerefRcxDl {
    Body: {
        mtxt = "MovDerefRcxDl"
        Listing_Open(mtxt)
        Emit_Byte(0x88)   // 0x88 MOV r/m8, r8
        Emit_Byte(0x11)    // 0x11 ModR/M: [RCX], DL
