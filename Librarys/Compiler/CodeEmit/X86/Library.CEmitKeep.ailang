        Listing_Open(mtxt)
        Emit_Byte(0x48)    // REX.W
        Emit_Byte(0x87)    // XCHG
        Emit_Byte(0x37)    // ModR/M: [RDI], RSI
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

