Function.X86_AddR12R13 {
    Body: {
        mtxt = "AddR12R13"
        Listing_Open(mtxt)
        Emit_Byte(77)
        Emit_Byte(1)
        Emit_Byte(236)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
