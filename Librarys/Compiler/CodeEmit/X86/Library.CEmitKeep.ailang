// MOV RDI, imm64

Function.X86_MovRegReg {
    Input: dst: Integer
    Input: src: Integer
    Body: {
        rd = Listing_RegName(dst)
        rs = Listing_RegName(src)
        mtxt = StringConcat("MOV ", rd)
        mtxt = StringConcat(mtxt, ", ")
        mtxt = StringConcat(mtxt, rs)
        Listing_Open(mtxt)
        // REX.W MOV r/m64, r64 = 48 89 /r
        rex = 72    // 0x48 base REX.W
        src_enc = src
        dst_enc = dst
        
        // Handle R8-R15 for source (REX.R)
        IfCondition GreaterEqual(src, 8) ThenBlock: {
            rex = BitwiseOr(rex, REX.R)
            src_enc = Subtract(src, 8)
        }
        // Handle R8-R15 for destination (REX.B)
        IfCondition GreaterEqual(dst, 8) ThenBlock: {
            rex = BitwiseOr(rex, REX.B)
            dst_enc = Subtract(dst, 8)
        }
        
        Emit_Byte(rex)
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        // ModR/M: mod=11 (direct), reg=src, r/m=dst
        modrm = BitwiseOr(192, BitwiseOr(LeftShift(src_enc, 3), dst_enc))
        Emit_Byte(modrm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// Convenience: MOV RAX, RBX

Function.X86_MovRsiImm64 {
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("MOV rsi, ", nstr)
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xBE)   // 0xBE MOV RSI
        Emit_QWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV R8, imm64

Function.X86_TestRegReg {
    Input: reg1: Integer
    Input: reg2: Integer
    Body: {
        rd = Listing_RegName(reg1)
        rs = Listing_RegName(reg2)
        mtxt = StringConcat("TEST ", rd)
        mtxt = StringConcat(mtxt, ", ")
        mtxt = StringConcat(mtxt, rs)
        Listing_Open(mtxt)
        rex = 72
        IfCondition GreaterEqual(reg1, 8) ThenBlock: { rex = BitwiseOr(rex, 1) }
        IfCondition GreaterEqual(reg2, 8) ThenBlock: { rex = BitwiseOr(rex, 4) }
        Emit_Byte(rex)
        Emit_Byte(0x85)
        reg1_enc = BitwiseAnd(reg1, 7)
        reg2_enc = BitwiseAnd(reg2, 7)
        modrm = BitwiseOr(192, BitwiseOr(LeftShift(reg2_enc, 3), reg1_enc))
        Emit_Byte(modrm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_XorRegReg {
    Input: dst: Integer
    Input: src: Integer
    Body: {
        rd = Listing_RegName(dst)
        rs = Listing_RegName(src)
        mtxt = StringConcat("XOR ", rd)
        mtxt = StringConcat(mtxt, ", ")
        mtxt = StringConcat(mtxt, rs)
        Listing_Open(mtxt)
        rex = 72
        IfCondition GreaterEqual(dst, 8) ThenBlock: { rex = BitwiseOr(rex, 1) }
        IfCondition GreaterEqual(src, 8) ThenBlock: { rex = BitwiseOr(rex, 4) }
        Emit_Byte(rex)
        Emit_Byte(0x31)
        dst_enc = BitwiseAnd(dst, 7)
        src_enc = BitwiseAnd(src, 7)
        modrm = BitwiseOr(192, BitwiseOr(LeftShift(src_enc, 3), dst_enc))
        Emit_Byte(modrm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_AddRspImm32 {
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("ADD rsp, ", nstr)
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x81)   // 0x81 ADD r/m64, imm32
        Emit_Byte(0xC4)   // 0xC4 ModR/M for RSP
        Emit_DWord(imm)
        Emit.stack_depth = Subtract(Emit.stack_depth, imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// SUB RSP, imm8 - Small stack allocation

Function.X86_Epilogue {
    Body: {
        // MOV RSP, RBP
        X86_MovRegReg(Reg.RSP, Reg.RBP)
        // POP RBP
        X86_PopRbp()
        // RET
        X86_Ret()
    }
}

// Leave instruction (shorthand for MOV RSP,RBP; POP RBP)

Function.X86_LeaRsiRspR8 {
    Body: {
        mtxt = "LEA rsi, rsp, r8"
        Listing_Open(mtxt)
        // LEA RSI, [RSP+R8] = 4A 8D 34 04
        Emit_Byte(0x4A)    // REX.W + REX.X (R8 as index)
        Emit_Byte(0x8D)    // LEA
        Emit_Byte(0x34)    // ModR/M: mod=00, reg=RSI, r/m=SIB
        Emit_Byte(0x04)    // SIB: scale=1, index=R8, base=RSP
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_MovRspR8Dl {
    Body: {
        mtxt = "MOV rsp, r8, dl"
        Listing_Open(mtxt)
        Emit_Byte(0x42)
        Emit_Byte(0x88)
        Emit_Byte(0x14)
        Emit_Byte(0x04)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_MovzxRaxRspR8 {
    Body: {
        mtxt = "MOVZX rax, rsp, r8"
        Listing_Open(mtxt)
        Emit_Byte(0x4A)
        Emit_Byte(0x0F)
        Emit_Byte(0xB6)
        Emit_Byte(0x04)
        Emit_Byte(0x04)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_PopRbp {
    Body: {
        mtxt = "POP rbp"
        Listing_Open(mtxt)
        Emit_Byte(0x5D)    // 0x5D
        Emit.stack_depth = Subtract(Emit.stack_depth, 8)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_Prologue {
    Input: stack_size: Integer
    Body: {
        // PUSH RBP
        X86_PushRbp()
        // MOV RBP, RSP
        X86_MovRegReg(Reg.RBP, Reg.RSP)
        // SUB RSP, stack_size (if needed)
        IfCondition GreaterThan(stack_size, 0) ThenBlock: {
            // Align to 16 bytes
            aligned = BitwiseAnd(Add(stack_size, 15), -16)
            X86_SubRspImm32(aligned)
        }
    }
}

// Standard epilogue

Function.X86_PushRbp {
    Body: {
        mtxt = "PUSH rbp"
        Listing_Open(mtxt)
        Emit_Byte(0x55)    // 0x55
        Emit.stack_depth = Add(Emit.stack_depth, 8)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_SubRspImm32 {
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("SUB rsp, ", nstr)
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x81)   // 0x81 SUB r/m64, imm32
        Emit_Byte(0xEC)   // 0xEC ModR/M for RSP
        Emit_DWord(imm)
        Emit.stack_depth = Add(Emit.stack_depth, imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

