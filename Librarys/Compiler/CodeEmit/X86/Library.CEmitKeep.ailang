}

// INT n - software interrupt

Function.X86_Nop {
    Body: {
        mtxt = "NOP"
        Listing_Open(mtxt)
        Emit_Byte(0x90)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// One architected NOP of length n, n in 1..9. Long form is 0F 1F.
Function.X86_NopLen {
    Input: n: Integer
    Body: {
        IfCondition EqualTo(n, 9) ThenBlock: {
            Emit_Byte(102)
            Emit_Byte(15)
            Emit_Byte(31)
            Emit_Byte(132)
            Emit_Byte(0)
            Emit_Byte(0)
            Emit_Byte(0)
            Emit_Byte(0)
            Emit_Byte(0)
        }
        IfCondition EqualTo(n, 8) ThenBlock: {
            Emit_Byte(15)
            Emit_Byte(31)
            Emit_Byte(132)
            Emit_Byte(0)
            Emit_Byte(0)
            Emit_Byte(0)
            Emit_Byte(0)
            Emit_Byte(0)
        }
        IfCondition EqualTo(n, 7) ThenBlock: {
            Emit_Byte(15)
            Emit_Byte(31)
            Emit_Byte(128)
            Emit_Byte(0)
            Emit_Byte(0)
            Emit_Byte(0)
            Emit_Byte(0)
        }
        IfCondition EqualTo(n, 6) ThenBlock: {
            Emit_Byte(102)
            Emit_Byte(15)
            Emit_Byte(31)
            Emit_Byte(68)
            Emit_Byte(0)
            Emit_Byte(0)
        }
        IfCondition EqualTo(n, 5) ThenBlock: {
            Emit_Byte(15)
            Emit_Byte(31)
            Emit_Byte(68)
            Emit_Byte(0)
            Emit_Byte(0)
        }
        IfCondition EqualTo(n, 4) ThenBlock: {
            Emit_Byte(15)
            Emit_Byte(31)
            Emit_Byte(64)
            Emit_Byte(0)
        }
        IfCondition EqualTo(n, 3) ThenBlock: {
            Emit_Byte(15)
            Emit_Byte(31)
            Emit_Byte(0)
        }
        IfCondition EqualTo(n, 2) ThenBlock: {
            Emit_Byte(102)
            Emit_Byte(144)
        }
        IfCondition EqualTo(n, 1) ThenBlock: {
            Emit_Byte(144)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// Pad so the next byte is 32-byte aligned at runtime.
// Text vaddr is 0x400000 + 176 = 0x4000B0, which is 16 mod 32.
// A label is aligned when code_size mod 32 is 16.
Function.X86_Align32 {
    Body: {
        rem = BitwiseAnd(Emit.code_size, 31)
        need = 0
        IfCondition LessThan(rem, 16) ThenBlock: {
            need = Subtract(16, rem)
        }
        IfCondition GreaterThan(rem, 16) ThenBlock: {
            need = Subtract(48, rem)
        }
        IfCondition GreaterThan(need, 0) ThenBlock: {
            Listing_Open("ALIGN 32")
            WhileLoop GreaterEqual(need, 9) {
                X86_NopLen(9)
                need = Subtract(need, 9)
            }
            IfCondition GreaterThan(need, 0) ThenBlock: {
                X86_NopLen(need)
            }
            Listing_Close()
        }
    }
}

// Backward JNE. The label is already marked, so bake rel8 when it fits.
// The tag peephole only NOPs in place, so the displacement stays valid.
Function.X86_JneBack {
    Input: label_id: Integer
    Body: {
        done = 0
        ok = Emit_IsLabelResolved(label_id)
        IfCondition EqualTo(ok, 1) ThenBlock: {
            addr = Emit_GetLabelAddress(label_id)
            rel = Subtract(addr, Add(Emit.code_size, 2))
            biased = Add(rel, 128)
            IfCondition GreaterEqual(biased, 0) ThenBlock: {
                IfCondition LessThan(biased, 256) ThenBlock: {
                    Listing_Open("JNE rel8")
                    Emit_Byte(117)
                    Emit_Byte(BitwiseAnd(rel, 255))
                    Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
                    Listing_Close()
                    done = 1
                }
            }
        }
        IfCondition EqualTo(done, 0) ThenBlock: {
            X86_Jne(label_id)
        }
    }
}

Function.X86_Rdtsc {
    Body: {
        mtxt = "RDTSC"
        Listing_Open(mtxt)
        Emit_Byte(0x0F)
        Emit_Byte(0x31)    // RDTSC
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

