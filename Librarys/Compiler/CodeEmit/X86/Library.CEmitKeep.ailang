    Body: {
        mtxt = "MovDerefR12Rax"
        Listing_Open(mtxt)
        Emit_Byte(0x49)
        Emit_Byte(0x89)
        Emit_Byte(0x04)
        Emit_Byte(0x24)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
