        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        Emit_Byte(0x83)   // 0x83 ModR/M: RAX, [RBX+disp32]
        Emit_DWord(offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
