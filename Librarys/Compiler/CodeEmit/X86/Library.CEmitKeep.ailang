        Emit_Byte(0x0F)    // 0x0F
        Emit_Byte(0xB6)   // 0xB6 MOVZX r64, r/m8
        Emit_Byte(0x07)     // 0x07 ModR/M: RAX, [RDI]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// =============================================================================
// MOV BYTE PTR - Store byte to memory
// =============================================================================

// MOV BYTE PTR [RDI], AL

Function.X86_MovzxRaxByteDerefRsi {
    Body: {
        mtxt = "MovzxRaxByteDerefRsi"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x0F)    // 0x0F
        Emit_Byte(0xB6)   // 0xB6 MOVZX r64, r/m8
        Emit_Byte(0x06)     // 0x06 ModR/M: RAX, [RSI]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOVZX RAX, BYTE PTR [RDI] - load byte from [RDI], zero-extend to RAX

Function.X86_LeaRaxRbpOffset {
    Input: offset: Integer
    Body: {
        mtxt = "LeaRaxRbpOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8D)   // 0x8D LEA
        
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x45)    // mod=01, reg=RAX, r/m=RBP
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x85)   // mod=10
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        EmitTag_Add(Emit.code_size, 0, TagClass.ADDR, offset)
        Listing_Close()
    }
}

// =============================================================================
// DATA ADDRESS LOADING (with relocation tracking)
// =============================================================================

// LEA/MOV for data section address - TRACKS RELOCATION

Function.X86_LeaRaxRipOffset {
    Input: offset: Integer
    Body: {
        mtxt = "LeaRaxRipOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8D)   // 0x8D LEA
        Emit_Byte(0x05)     // 0x05 ModR/M: RAX, [RIP+disp32]
        Emit_DWord(offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// LEA RSI, [RIP + disp32]

Function.X86_LeaRdiRipOffset {
    Input: offset: Integer
    Body: {
        mtxt = "LeaRdiRipOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8D)   // 0x8D LEA
        Emit_Byte(0x3D)    // 0x3D ModR/M: RDI, [RIP+disp32]
        Emit_DWord(offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}




// MOV R11, [RBP + offset] - Load from stack variable into R11

Function.X86_LeaRsiRipOffset {
    Input: offset: Integer
    Body: {
        mtxt = "LeaRsiRipOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8D)   // 0x8D LEA
        Emit_Byte(0x35)    // 0x35 ModR/M: RSI, [RIP+disp32]
        Emit_DWord(offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// LEA RDI, [RIP + disp32]

Function.X86_LeaRspRbpOffset {
    Input: offset: Integer
    Body: {
        mtxt = "LeaRspRbpOffset"
        Listing_Open(mtxt)
        // LEA RSP, [RBP + disp]
        // Encoding: 48 8D 65 disp8  OR  48 8D A5 disp32
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8D)   // 0x8D LEA opcode
        
        // ModR/M byte: mod=01/10, reg=RSP(100), r/m=RBP(101)
        // For RBP base: use 0x65 for disp8, 0xA5 for disp32
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x65)   // 0x65 ModR/M: mod=01, reg=RSP, r/m=RBP
            // Handle signed byte
            IfCondition LessThan(offset, 0) ThenBlock: {
                Emit_Byte(Add(256, offset))  // Convert to unsigned byte
            } ElseBlock: {
                Emit_Byte(offset)
            }
        } ElseBlock: {
            Emit_Byte(0xA5)   // 0xA5 ModR/M: mod=10, reg=RSP, r/m=RBP
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}



// =============================================================================
// INDIRECT ACCESS (through register)
// =============================================================================

// MOV RAX, [RAX] - Load through pointer in RAX

Function.X86_LoadDataAddress {
    Input: data_offset: Integer
    Body: {
        mtxt = "LoadDataAddress"
        Listing_Open(mtxt)
        // Use MOV RAX, imm64 for absolute address
        // This will be patched by Emit_ApplyDataRelocations
        
        Emit_Byte(0x48)   // REX.W
        Emit_Byte(0xB8)   // MOV RAX, imm64
        
        // Record current position for relocation
        Emit_AddDataReloc(Emit.code_size, data_offset)
        
        // Emit placeholder (8 bytes of zeros)
        // These will be patched with the actual address
        Emit_QWord(0)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}


// Alternative: Load data address into RSI (for syscalls)

Function.X86_LoadDataAddressRdi {
    Input: data_offset: Integer
    Body: {
        mtxt = "LoadDataAddressRdi"
        Listing_Open(mtxt)
        // MOV RDI, imm64
        Emit_Byte(0x48)   // REX.W
        Emit_Byte(0xBF)   // MOV RDI, imm64
        
        Emit_AddDataReloc(Emit.code_size, data_offset)
        Emit_QWord(0)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}


// -----------------------------------------------------------------------------
// WORD (16-BIT) STORE OPERATIONS
// -----------------------------------------------------------------------------

// MOV [RAX], BX - Store word from BX to memory at [RAX]
// Encoding: 66 89 18

Function.X86_LoadDataAddressRsi {
    Input: data_offset: Integer
    Body: {
        mtxt = "LoadDataAddressRsi"
        Listing_Open(mtxt)
        // MOV RSI, imm64
        Emit_Byte(0x48)   // REX.W
        Emit_Byte(0xBE)   // MOV RSI, imm64
        
        // Record for relocation
        Emit_AddDataReloc(Emit.code_size, data_offset)
        
        // Placeholder
        Emit_QWord(0)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// Load data address into RDI

Function.X86_MovByteDerefRdiImm8 {
    Input: val: Integer
    Body: {
        mtxt = "MovByteDerefRdiImm8"
        Listing_Open(mtxt)
        Emit_Byte(0xC6)
        Emit_Byte(0x07)
        Emit_Byte(val)
        Listing_Close()
    }
}

// MOV BYTE [R14], DL

Function.X86_MovByteR14Dl {
    Body: {
        mtxt = "MovByteR14Dl"
        Listing_Open(mtxt)
        Emit_Byte(0x41)
        Emit_Byte(0x88)
        Emit_Byte(0x16)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// =============================================================================
// GENERIC MOV reg, [base+offset] and MOV [base+offset], reg
// =============================================================================

Function.X86_MovByteR14OffsetImm8 {
    Input: offset: Integer
    Input: value: Integer
    Body: {
        mtxt = "MovByteR14OffsetImm8"
        Listing_Open(mtxt)
        Emit_Byte(0x41)
        Emit_Byte(0xC6)
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x06)
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x46)
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x86)
                Emit_DWord(offset)
            }
        }
        Emit_Byte(value)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOVZX RAX, BYTE PTR [RSI] - zero-extend byte at [RSI] into RAX
// Encoding: 48 0F B6 06

Function.X86_MovByteRspOffsetImm8 {
    Input: offset: Integer
    Input: value: Integer
    Body: {
        mtxt = "MovByteRspOffsetImm8"
        Listing_Open(mtxt)
        Emit_Byte(0xC6)
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x04)
            Emit_Byte(0x24)
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x44)
                Emit_Byte(0x24)
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x84)
                Emit_Byte(0x24)
                Emit_DWord(offset)
            }
        }
        Emit_Byte(value)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV BYTE [R14+offset], imm8

Function.X86_MovDerefR11OffsetR10 {
    Input: offset: Integer
    Body: {
        mtxt = "MovDerefR11OffsetR10"
        Listing_Open(mtxt)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            // 4D 89 53 xx = MOV [R11+disp8], R10
            Emit_Byte(0x4D)
            Emit_Byte(0x89)
            Emit_Byte(0x53)
            Emit_Byte(offset)
        } ElseBlock: {
            // 4D 89 93 xx xx xx xx = MOV [R11+disp32], R10
            Emit_Byte(0x4D)
            Emit_Byte(0x89)
            Emit_Byte(0x93)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [R12], RAX - Store RAX to memory at [R12]
// R12 requires SIB byte: 49 89 04 24

Function.X86_MovDerefR11R10 {
    Body: {
        mtxt = "MovDerefR11R10"
        Listing_Open(mtxt)
        Emit_Byte(0x4D)
        Emit_Byte(0x89)
        Emit_Byte(0x13)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [R11 + offset], R10 - Store R10 to memory at [R11+offset]

Function.X86_MovDerefR12OffsetRax {
    Input: offset: Integer
    Body: {
        mtxt = "MovDerefR12OffsetRax"
        Listing_Open(mtxt)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            // 49 89 44 24 xx = MOV [R12+disp8], RAX
            Emit_Byte(0x49)
            Emit_Byte(0x89)
            Emit_Byte(0x44)
            Emit_Byte(0x24)
            Emit_Byte(offset)
        } ElseBlock: {
            // 49 89 84 24 xx xx xx xx = MOV [R12+disp32], RAX
            Emit_Byte(0x49)
            Emit_Byte(0x89)
            Emit_Byte(0x84)
            Emit_Byte(0x24)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RBX, [RBP + offset] - Load from stack into RBX

Function.X86_MovDerefR12Rax {
    Body: {
        mtxt = "MovDerefR12Rax"
        Listing_Open(mtxt)
        Emit_Byte(0x49)
        Emit_Byte(0x89)
        Emit_Byte(0x04)
        Emit_Byte(0x24)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [R12 + offset], RAX - Store RAX to memory at [R12+offset]

Function.X86_MovDerefRaxOffsetRbx {
    Input: offset: Integer
    Body: {
        mtxt = "MovDerefRaxOffsetRbx"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x89)   // 0x89 MOV
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x18)    // [RAX], RBX
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x58)    // mod=01
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x98)   // mod=10
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// =============================================================================
// MOV data_offset (with relocation)
// =============================================================================

// Emits placeholder value, records position for later patching

Function.X86_MovDerefRaxRbx {
    Body: {
        mtxt = "MovDerefRaxRbx"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        Emit_Byte(0x18)    // 0x18 ModR/M: [RAX], RBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RAX], RCX

Function.X86_MovDerefRaxRcx {
    Body: {
        mtxt = "MovDerefRaxRcx"
        Listing_Open(mtxt)
        Emit_Byte(0x48)
        Emit_Byte(0x89)
        Emit_Byte(0x08)     // ModR/M: [RAX], RCX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RDI], RAX — store 64-bit value
// Encoding: 48 89 07

Function.X86_MovDerefRbxAl {
    Body: {
        mtxt = "MovDerefRbxAl"
        Listing_Open(mtxt)
        Emit_Byte(0x88)   // 0x88 MOV r/m8, r8
        Emit_Byte(0x03)     // ModR/M: [RBX], AL
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV AL, [RAX + RBX] - Load byte with index

Function.X86_MovDerefRbxRax {
    Body: {
        mtxt = "MovDerefRbxRax"
        Listing_Open(mtxt)
        Emit_Byte(0x48)   // REX.W
        Emit_Byte(0x89)   // MOV r/m64, r64
        Emit_Byte(0x03)   // ModRM: [RBX], RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// =============================================================================
// QWORD MEMORY ACCESS
// =============================================================================

// MOV RAX, [RAX + offset]

Function.X86_MovDerefRcxDl {
    Body: {
        mtxt = "MovDerefRcxDl"
        Listing_Open(mtxt)
        Emit_Byte(0x88)   // 0x88 MOV r/m8, r8
        Emit_Byte(0x11)    // 0x11 ModR/M: [RCX], DL
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// =============================================================================
// 
// instructions for saving/restoring RSP to/from RBP-relative stack slots
// =============================================================================

// MOV [RBP + offset], RSP - Save RSP to stack slot
// This is used to preserve RSP across function calls where expression
// evaluation might clobber registers.
//
// Encoding: 48 89 65 disp8  OR  48 89 A5 disp32
// 48 = REX.W (64-bit operand)
// 89 = MOV r/m64, r64
// 65 = ModR/M: mod=01, reg=RSP(100=4), r/m=RBP(101=5) -> 01 100 101 = 0x65
// A5 = ModR/M: mod=10, reg=RSP(100=4), r/m=RBP(101=5) -> 10 100 101 = 0xA5
//
// NOTE: RBP as r/m does NOT require SIB byte (unlike RSP)

Function.X86_MovDerefRdiRax {
    Body: {
        mtxt = "MovDerefRdiRax"
        Listing_Open(mtxt)
        Emit_Byte(0x48)
        Emit_Byte(0x89)
        Emit_Byte(0x07)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// =============================================================================
// BYTE ACCESS
// =============================================================================

// MOV AL, [RBX] - Load byte

Function.X86_MovDwordDerefRaxEbx {
    Body: {
        mtxt = "MovDwordDerefRaxEbx"
        Listing_Open(mtxt)
        Emit_Byte(0x89)   // MOV r/m32, r32
        Emit_Byte(0x18)   // ModRM: [RAX], EBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RBX], EAX - Store dword from EAX to memory at [RBX]
// Encoding: 89 03

Function.X86_MovDwordDerefRbxEax {
    Body: {
        mtxt = "MovDwordDerefRbxEax"
        Listing_Open(mtxt)
        Emit_Byte(0x89)   // MOV r/m32, r32
        Emit_Byte(0x03)   // ModRM: [RBX], EAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RDI], EAX - Store dword from EAX to memory at [RDI]
// Encoding: 89 07

Function.X86_MovDwordDerefRdiEax {
    Body: {
        mtxt = "MovDwordDerefRdiEax"
        Listing_Open(mtxt)
        Emit_Byte(0x89)   // MOV r/m32, r32
        Emit_Byte(0x07)   // ModRM: [RDI], EAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// -----------------------------------------------------------------------------
// DWORD (32-BIT) LOAD OPERATIONS
// -----------------------------------------------------------------------------

// MOV EAX, [RAX] - Load dword (auto zero-extends to RAX in 64-bit mode)
// Encoding: 8B 00 (no REX.W)

Function.X86_MovEaxDerefRax {
    Body: {
        mtxt = "MovEaxDerefRax"
        Listing_Open(mtxt)
        Emit_Byte(0x8B)   // MOV r32, r/m32
        Emit_Byte(0x00)   // ModRM: EAX, [RAX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV EAX, [RBX] - Load dword from [RBX] (auto zero-extends)
// Encoding: 8B 03

Function.X86_MovEaxDerefRbx {
    Body: {
        mtxt = "MovEaxDerefRbx"
        Listing_Open(mtxt)
        Emit_Byte(0x8B)   // MOV r32, r/m32
        Emit_Byte(0x03)   // ModRM: EAX, [RBX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV EAX, [RDI] - Load dword from [RDI] (auto zero-extends)
// Encoding: 8B 07

Function.X86_MovEaxDerefRdi {
    Body: {
        mtxt = "MovEaxDerefRdi"
        Listing_Open(mtxt)
        Emit_Byte(0x8B)   // MOV r32, r/m32
        Emit_Byte(0x07)   // ModRM: EAX, [RDI]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// -----------------------------------------------------------------------------
// QWORD (64-BIT) STORE - MISSING FROM CODEBASE
// -----------------------------------------------------------------------------

// MOV [RBX], RAX - Store qword from RAX to memory at [RBX]
// Encoding: 48 89 03

Function.X86_MovR11RbpOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MovR11RbpOffset"
        Listing_Open(mtxt)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            // 4C 8B 5D xx = MOV R11, [RBP+disp8]
            Emit_Byte(0x4C)
            Emit_Byte(0x8B)
            Emit_Byte(0x5D)
            Emit_Byte(offset)
        } ElseBlock: {
            // 4C 8B 9D xx xx xx xx = MOV R11, [RBP+disp32]
            Emit_Byte(0x4C)
            Emit_Byte(0x8B)
            Emit_Byte(0x9D)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        EmitTag_Add(Emit.code_size, 0, TagClass.LOAD_LOCAL, offset)
        Listing_Close()
    }
}

// MOV [R11], R10 - Store R10 to memory at [R11]
// 4D 89 13

Function.X86_MovR15OffsetRax {
    Input: offset: Integer
    Body: {
        nstr = NumberToString(offset)
        mtxt = StringConcat("MOV [r15+", nstr)
        mtxt = StringConcat(mtxt, "], rax")
        Listing_Open(mtxt)
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x89)   // 0x89 MOV
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x47)
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x87)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}



// MOV RAX, [R15] - Load from pool table base

Function.X86_MovRaxDataOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MOV rax, data"
        Listing_Open(mtxt)
        // MOV RAX, imm64: REX.W (0x48) + 0xB8 + 8-byte immediate
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xB8)   // 0xB8 MOV RAX, imm64
        
        reloc_pos = Emit.code_size
        Emit_QWord(offset)
        Emit_AddDataReloc(reloc_pos, offset)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RDI, data_offset (with relocation)

Function.X86_MovRaxDerefRax {
    Body: {
        mtxt = "MovRaxDerefRax"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV
        Emit_Byte(0x00)     // ModR/M: [RAX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RAX, [RBX]

Function.X86_MovRaxDerefRaxOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MovRaxDerefRaxOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x00)     // [RAX]
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x40)    // mod=01
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x80)   // mod=10
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RAX + offset], RBX

Function.X86_MovRaxDerefRbx {
    Body: {
        mtxt = "MovRaxDerefRbx"
        Listing_Open(mtxt)
        Emit_Byte(0x48)
        Emit_Byte(0x8B)
        Emit_Byte(0x03)     // ModR/M: [RBX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RAX], RBX - Store RBX to address in RAX

Function.X86_MovRaxDerefRbxRcxScaled {
    Input: scale: Integer
    Body: {
        mtxt = "MovRaxDerefRbxRcxScaled"
        Listing_Open(mtxt)
        // REX.W prefix
        Emit_Byte(0x48)
        // MOV opcode
        Emit_Byte(0x8B)
        // ModRM: mod=00, reg=RAX(000), r/m=100(SIB)
        Emit_Byte(0x04)
        
        // SIB byte: scale | (RCX << 3) | RBX
        // RCX = 001, RBX = 011
        // index_base = (001 << 3) | 011 = 0x0B
        
        IfCondition EqualTo(scale, 1) ThenBlock: {
            Emit_Byte(0x0B)    // 00_001_011
        }
        IfCondition EqualTo(scale, 2) ThenBlock: {
            Emit_Byte(0x4B)    // 01_001_011
        }
        IfCondition EqualTo(scale, 4) ThenBlock: {
            Emit_Byte(0x8B)    // 10_001_011
        }
        IfCondition EqualTo(scale, 8) ThenBlock: {
            Emit_Byte(0xCB)    // 11_001_011
        }
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RAX, [R14 + RCX*scale]
// Same SIB load as MovRaxDerefRbxRcxScaled, with the base in R14 so a
// loop limit parked in RBX survives the load.
// scale 8: 49 8B 04 CE

Function.X86_MovRaxDerefR14RcxScaled {
    Input: scale: Integer
    Body: {
        mtxt = "MovRaxDerefR14RcxScaled"
        Listing_Open(mtxt)
        Emit_Byte(73)
        Emit_Byte(139)
        Emit_Byte(4)
        IfCondition EqualTo(scale, 1) ThenBlock: { Emit_Byte(14) }
        IfCondition EqualTo(scale, 2) ThenBlock: { Emit_Byte(78) }
        IfCondition EqualTo(scale, 4) ThenBlock: { Emit_Byte(142) }
        IfCondition EqualTo(scale, 8) ThenBlock: { Emit_Byte(206) }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV rax, [r14+rcx+disp8]. disp is a signed byte and not zero.
// rcx stays the raw byte offset. 8: 49 8B 44 0E 08.

Function.X86_MovRaxDerefR14RcxDisp8 {
    Input: disp: Integer
    Body: {
        mtxt = "MovRaxDerefR14RcxDisp8"
        Listing_Open(mtxt)
        Emit_Byte(73)
        Emit_Byte(139)
        Emit_Byte(68)
        Emit_Byte(14)
        Emit_Byte(BitwiseAnd(disp, 255))
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// acc = acc +/- [r14 + r13*scale]. r12 is the accumulator, r14 the table,
// r13 the integer cursor. scale 8 add: 4F 03 24 EE. scale 8 sub: 4F 2B 24 EE.
// opcode 3 is ADD r64, r/m64. opcode 43 is SUB r64, r/m64.

Function.X86_AccMemR14R13 {
    Input: opcode: Integer
    Input: scale: Integer
    Body: {
        mtxt = "AccMemR14R13"
        Listing_Open(mtxt)
        Emit_Byte(79)
        Emit_Byte(opcode)
        Emit_Byte(36)
        IfCondition EqualTo(scale, 1) ThenBlock: { Emit_Byte(46) }
        IfCondition EqualTo(scale, 2) ThenBlock: { Emit_Byte(110) }
        IfCondition EqualTo(scale, 4) ThenBlock: { Emit_Byte(174) }
        IfCondition EqualTo(scale, 8) ThenBlock: { Emit_Byte(238) }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// acc = acc +/- [r14 + rcx*scale]. The index is not the cursor, so it
// arrives in rcx. r12 stays the accumulator. scale 8 add: 4D 03 24 CE.
// scale 8 sub: 4D 2B 24 CE. opcode 3 is ADD. opcode 43 is SUB.

Function.X86_AccMemR14Rcx {
    Input: opcode: Integer
    Input: scale: Integer
    Body: {
        mtxt = "AccMemR14Rcx"
        Listing_Open(mtxt)
        Emit_Byte(77)
        Emit_Byte(opcode)
        Emit_Byte(36)
        IfCondition EqualTo(scale, 1) ThenBlock: { Emit_Byte(14) }
        IfCondition EqualTo(scale, 2) ThenBlock: { Emit_Byte(78) }
        IfCondition EqualTo(scale, 4) ThenBlock: { Emit_Byte(142) }
        IfCondition EqualTo(scale, 8) ThenBlock: { Emit_Byte(206) }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [r14+r13*scale], r13. The cursor is both the index and the value.
// scale 8: 4F 89 2C EE.

Function.X86_StR13AtR14R13 {
    Input: scale: Integer
    Body: {
        mtxt = "StR13AtR14R13"
        Listing_Open(mtxt)
        Emit_Byte(79)
        Emit_Byte(137)
        Emit_Byte(44)
        IfCondition EqualTo(scale, 1) ThenBlock: { Emit_Byte(46) }
        IfCondition EqualTo(scale, 2) ThenBlock: { Emit_Byte(110) }
        IfCondition EqualTo(scale, 4) ThenBlock: { Emit_Byte(174) }
        IfCondition EqualTo(scale, 8) ThenBlock: { Emit_Byte(238) }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [r14+rcx*scale], rax.  scale 8: 49 89 04 CE.

Function.X86_StRaxAtR14RcxScaled {
    Input: scale: Integer
    Body: {
        mtxt = "StRaxAtR14RcxScaled"
        Listing_Open(mtxt)
        Emit_Byte(73)
        Emit_Byte(137)
        Emit_Byte(4)
        IfCondition EqualTo(scale, 1) ThenBlock: { Emit_Byte(14) }
        IfCondition EqualTo(scale, 2) ThenBlock: { Emit_Byte(78) }
        IfCondition EqualTo(scale, 4) ThenBlock: { Emit_Byte(142) }
        IfCondition EqualTo(scale, 8) ThenBlock: { Emit_Byte(206) }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV rax, [r14+r13*scale]. scale 8: 4B 8B 04 EE.

Function.X86_MovRaxAtR14R13 {
    Input: scale: Integer
    Body: {
        mtxt = "MovRaxAtR14R13"
        Listing_Open(mtxt)
        Emit_Byte(75)
        Emit_Byte(139)
        Emit_Byte(4)
        IfCondition EqualTo(scale, 1) ThenBlock: { Emit_Byte(46) }
        IfCondition EqualTo(scale, 2) ThenBlock: { Emit_Byte(110) }
        IfCondition EqualTo(scale, 4) ThenBlock: { Emit_Byte(174) }
        IfCondition EqualTo(scale, 8) ThenBlock: { Emit_Byte(238) }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// IMUL rax, rax, imm32. 48 69 C0 imm32.

Function.X86_ImulRaxImm32 {
    Input: imm: Integer
    Body: {
        mtxt = "ImulRaxImm32"
        Listing_Open(mtxt)
        Emit_Byte(72)
        Emit_Byte(105)
        Emit_Byte(192)
        Emit_DWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// SSE scalar op, xmm, [r14+index*scale]. index 1 is RCX, 12 is R12, 13 is R13.
// opcode 16 movsd, 88 addsd, 92 subsd, 89 mulsd, 94 divsd, 93 minsd, 95 maxsd.
// xmm is 0-7. scale 8, xmm0, rcx: F2 41 0F 59 04 CE. r13: F2 43 0F 59 04 EE.

Function.X86_XmmScaled {
    Input: opcode: Integer
    Input: xmm: Integer
    Input: scale: Integer
    Input: index: Integer
    Body: {
        mtxt = "XmmScaled"
        Listing_Open(mtxt)
        Emit_Byte(242)
        rex = 65
        index_field = 1
        IfCondition EqualTo(index, 12) ThenBlock: {
            rex = 67
            index_field = 4
        }
        IfCondition EqualTo(index, 13) ThenBlock: {
            rex = 67
            index_field = 5
        }
        Emit_Byte(rex)
        Emit_Byte(15)
        Emit_Byte(opcode)
        Emit_Byte(Add(4, Multiply(xmm, 8)))
        scale_bits = 0
        IfCondition EqualTo(scale, 2) ThenBlock: { scale_bits = 1 }
        IfCondition EqualTo(scale, 4) ThenBlock: { scale_bits = 2 }
        IfCondition EqualTo(scale, 8) ThenBlock: { scale_bits = 3 }
        sib = Add(Add(Multiply(scale_bits, 64), Multiply(index_field, 8)), 6)
        Emit_Byte(sib)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// XMM register moves used by extra float homes.
// op 1: MOVQ xmmReg, rax
// op 2: MOVQ rax, xmmReg
// op 3: MOVSD xmm0, xmmReg
// op 4: MOVSD xmmReg, xmm0
// op 5: ADDSD xmmReg, xmm0
// op 6: SUBSD xmmReg, xmm0
// op 7: MULSD xmmReg, xmm0
// op 8: MOVSD xmm1, xmmReg

Function.X86_XmmRR {
    Input: op: Integer
    Input: reg: Integer
    Body: {
        mtxt = "XmmRR"
        Listing_Open(mtxt)
        low = reg
        hi = 0
        IfCondition GreaterEqual(reg, 8) ThenBlock: {
            low = Subtract(reg, 8)
            hi = 1
        }
        mod_dst = Add(192, Multiply(low, 8))
        mod_src = Add(192, low)
        wrex = 72
        IfCondition EqualTo(hi, 1) ThenBlock: { wrex = 76 }
        IfCondition EqualTo(op, 1) ThenBlock: {
            Emit_Byte(102)
            Emit_Byte(wrex)
            Emit_Byte(15)
            Emit_Byte(110)
            Emit_Byte(mod_dst)
        }
        IfCondition EqualTo(op, 2) ThenBlock: {
            Emit_Byte(102)
            Emit_Byte(wrex)
            Emit_Byte(15)
            Emit_Byte(126)
            Emit_Byte(mod_dst)
        }
        IfCondition EqualTo(op, 3) ThenBlock: {
            Emit_Byte(242)
            IfCondition EqualTo(hi, 1) ThenBlock: { Emit_Byte(65) }
            Emit_Byte(15)
            Emit_Byte(16)
            Emit_Byte(mod_src)
        }
        IfCondition EqualTo(op, 4) ThenBlock: {
            Emit_Byte(242)
            IfCondition EqualTo(hi, 1) ThenBlock: { Emit_Byte(68) }
            Emit_Byte(15)
            Emit_Byte(16)
            Emit_Byte(mod_dst)
        }
        IfCondition EqualTo(op, 5) ThenBlock: {
            Emit_Byte(242)
            IfCondition EqualTo(hi, 1) ThenBlock: { Emit_Byte(68) }
            Emit_Byte(15)
            Emit_Byte(88)
            Emit_Byte(mod_dst)
        }
        IfCondition EqualTo(op, 6) ThenBlock: {
            Emit_Byte(242)
            IfCondition EqualTo(hi, 1) ThenBlock: { Emit_Byte(68) }
            Emit_Byte(15)
            Emit_Byte(92)
            Emit_Byte(mod_dst)
        }
        IfCondition EqualTo(op, 7) ThenBlock: {
            Emit_Byte(242)
            IfCondition EqualTo(hi, 1) ThenBlock: { Emit_Byte(68) }
            Emit_Byte(15)
            Emit_Byte(89)
            Emit_Byte(mod_dst)
        }
        // op 8: MOVSD xmm1, xmmReg. modrm is 0xC8 + low 3 bits.
        IfCondition EqualTo(op, 8) ThenBlock: {
            Emit_Byte(242)
            IfCondition EqualTo(hi, 1) ThenBlock: { Emit_Byte(65) }
            Emit_Byte(15)
            Emit_Byte(16)
            Emit_Byte(Add(200, low))
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// SSE scalar op, xmm dst, xmm src. opcode 16 movsd, 88 addsd, 92 subsd, 89 mulsd.
// xmm8–xmm15 set REX.R on the destination and REX.B on the source.

Function.X86_XmmBin {
    Input: opcode: Integer
    Input: dst: Integer
    Input: src: Integer
    Body: {
        mtxt = "XmmBin"
        Listing_Open(mtxt)
        dl = dst
        sl = src
        rex = 0
        IfCondition GreaterEqual(dst, 8) ThenBlock: {
            dl = Subtract(dst, 8)
            rex = 4
        }
        IfCondition GreaterEqual(src, 8) ThenBlock: {
            sl = Subtract(src, 8)
            rex = Add(rex, 1)
        }
        Emit_Byte(242)
        IfCondition GreaterThan(rex, 0) ThenBlock: { Emit_Byte(Add(64, rex)) }
        Emit_Byte(15)
        Emit_Byte(opcode)
        Emit_Byte(Add(192, Add(Multiply(dl, 8), sl)))
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOVAPD xmm, xmm. Full 16-byte copy. Register movsd would keep a
// false dependence on the destination. SSE2.
Function.X86_Movapd {
    Input: dst: Integer
    Input: src: Integer
    Body: {
        mtxt = "Movapd"
        Listing_Open(mtxt)
        dl = dst
        sl = src
        rex = 0
        IfCondition GreaterEqual(dst, 8) ThenBlock: {
            dl = Subtract(dst, 8)
            rex = 4
        }
        IfCondition GreaterEqual(src, 8) ThenBlock: {
            sl = Subtract(src, 8)
            rex = Add(rex, 1)
        }
        Emit_Byte(102)
        IfCondition GreaterThan(rex, 0) ThenBlock: { Emit_Byte(Add(64, rex)) }
        Emit_Byte(15)
        Emit_Byte(40)
        Emit_Byte(Add(192, Add(Multiply(dl, 8), sl)))
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// PXOR xmm, xmm. Scalar +0.0 with no frame load. SSE2.
Function.X86_PxorXmm {
    Input: dst: Integer
    Body: {
        mtxt = "PxorXmm"
        Listing_Open(mtxt)
        dl = dst
        rex = 0
        IfCondition GreaterEqual(dst, 8) ThenBlock: {
            dl = Subtract(dst, 8)
            rex = 5
        }
        Emit_Byte(102)
        IfCondition GreaterThan(rex, 0) ThenBlock: { Emit_Byte(Add(64, rex)) }
        Emit_Byte(15)
        Emit_Byte(239)
        Emit_Byte(Add(192, Add(Multiply(dl, 8), dl)))
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOVSD [r9+disp], xmm. r9 is the hoisted store base. SSE2.
Function.X86_MovsdR9 {
    Input: xmm: Integer
    Input: disp: Integer
    Body: {
        mtxt = "MovsdR9"
        Listing_Open(mtxt)
        low = xmm
        rex = 65
        IfCondition GreaterEqual(xmm, 8) ThenBlock: {
            low = Subtract(xmm, 8)
            rex = 69
        }
        Emit_Byte(242)
        Emit_Byte(rex)
        Emit_Byte(15)
        Emit_Byte(17)
        reg8 = Multiply(low, 8)
        small = 0
        IfCondition GreaterEqual(disp, -128) ThenBlock: {
            IfCondition LessThan(disp, 128) ThenBlock: { small = 1 }
        }
        IfCondition EqualTo(disp, 0) ThenBlock: {
            Emit_Byte(Add(1, reg8))
        } ElseBlock: {
            IfCondition EqualTo(small, 1) ThenBlock: {
                Emit_Byte(Add(65, reg8))
                Emit_Byte(BitwiseAnd(disp, 255))
            } ElseBlock: {
                Emit_Byte(Add(129, reg8))
                Emit_DWord(disp)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// Copy a cached k=0 pointer. slot 0 is r8, slot 1 is r10.
// dir 0 moves the cache into reg (11 or 14). dir 1 saves reg into the cache.
Function.X86_IpCache {
    Input: slot: Integer
    Input: reg: Integer
    Input: dir: Integer
    Body: {
        mtxt = "IpCache"
        Listing_Open(mtxt)
        b0 = 0
        b1 = 0
        b2 = 0
        IfCondition EqualTo(dir, 0) ThenBlock: {
            IfCondition EqualTo(slot, 0) ThenBlock: {
                IfCondition EqualTo(reg, 11) ThenBlock: { b0 = 77 b1 = 139 b2 = 216 }
                IfCondition EqualTo(reg, 14) ThenBlock: { b0 = 77 b1 = 139 b2 = 240 }
            }
            IfCondition EqualTo(slot, 1) ThenBlock: {
                IfCondition EqualTo(reg, 11) ThenBlock: { b0 = 77 b1 = 139 b2 = 218 }
                IfCondition EqualTo(reg, 14) ThenBlock: { b0 = 77 b1 = 139 b2 = 242 }
            }
        } ElseBlock: {
            IfCondition EqualTo(slot, 0) ThenBlock: {
                IfCondition EqualTo(reg, 11) ThenBlock: { b0 = 77 b1 = 139 b2 = 195 }
                IfCondition EqualTo(reg, 14) ThenBlock: { b0 = 77 b1 = 139 b2 = 198 }
            }
            IfCondition EqualTo(slot, 1) ThenBlock: {
                IfCondition EqualTo(reg, 11) ThenBlock: { b0 = 77 b1 = 139 b2 = 211 }
                IfCondition EqualTo(reg, 14) ThenBlock: { b0 = 77 b1 = 139 b2 = 214 }
            }
        }
        IfCondition NotEqual(b0, 0) ThenBlock: {
            Emit_Byte(b0)
            Emit_Byte(b1)
            Emit_Byte(b2)
            Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        }
        Listing_Close()
    }
}

// MOV r9, rax. The hoisted store base.
Function.X86_MovR9Rax {
    Body: {
        mtxt = "MovR9Rax"
        Listing_Open(mtxt)
        Emit_Byte(76)
        Emit_Byte(139)
        Emit_Byte(200)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOVSD xmm, [reg+disp]. reg is 11 or 14. xmm 0–7 keeps REX.B.
// xmm8–xmm15 also sets REX.R and keeps only the low 3 bits in ModRM.
// r14 has no bare [reg] form, so a zero displacement uses disp8.
Function.X86_MovsdPtr {
    Input: xmm: Integer
    Input: reg: Integer
    Input: disp: Integer
    Body: {
        mtxt = "MovsdPtr"
        Listing_Open(mtxt)
        low = xmm
        rex = 65
        IfCondition GreaterEqual(xmm, 8) ThenBlock: {
            low = Subtract(xmm, 8)
            rex = 69
        }
        rm = 3
        IfCondition EqualTo(reg, 14) ThenBlock: { rm = 6 }
        Emit_Byte(242)
        Emit_Byte(rex)
        Emit_Byte(15)
        Emit_Byte(16)
        reg8 = Multiply(low, 8)
        bare = 0
        IfCondition EqualTo(reg, 11) ThenBlock: {
            IfCondition EqualTo(disp, 0) ThenBlock: { bare = 1 }
        }
        IfCondition EqualTo(bare, 1) ThenBlock: {
            Emit_Byte(Add(rm, reg8))
        } ElseBlock: {
            small = 0
            IfCondition GreaterEqual(disp, -128) ThenBlock: {
                IfCondition LessThan(disp, 128) ThenBlock: { small = 1 }
            }
            IfCondition EqualTo(small, 1) ThenBlock: {
                Emit_Byte(Add(64, Add(rm, reg8)))
                Emit_Byte(BitwiseAnd(disp, 255))
            } ElseBlock: {
                Emit_Byte(Add(128, Add(rm, reg8)))
                Emit_DWord(disp)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOVSD [r11 or r14 + disp], xmm. Opcode 11 is the store form of MovsdPtr.
// A zero displacement on r14 uses disp8 so it is not [rip].
// xmm8–xmm15 set REX.R and keep only the low 3 bits in ModRM. A raw xmm
// index of 8 turns modrm 0x46 into 0x86, which consumes the next bytes as
// a disp32 and stores through a wild address.
Function.X86_MovsdIpXmm {
    Input: reg: Integer
    Input: disp: Integer
    Input: xmm: Integer
    Body: {
        mtxt = "MovsdIpXmm"
        Listing_Open(mtxt)
        low = xmm
        rex = 65
        IfCondition GreaterEqual(xmm, 8) ThenBlock: {
            low = Subtract(xmm, 8)
            rex = 69
        }
        rm = 3
        IfCondition EqualTo(reg, 14) ThenBlock: { rm = 6 }
        Emit_Byte(242)
        Emit_Byte(rex)
        Emit_Byte(15)
        Emit_Byte(17)
        reg8 = Multiply(low, 8)
        bare = 0
        IfCondition EqualTo(reg, 11) ThenBlock: {
            IfCondition EqualTo(disp, 0) ThenBlock: { bare = 1 }
        }
        IfCondition EqualTo(bare, 1) ThenBlock: {
            Emit_Byte(Add(rm, reg8))
        } ElseBlock: {
            small = 0
            IfCondition GreaterEqual(disp, -128) ThenBlock: {
                IfCondition LessThan(disp, 128) ThenBlock: { small = 1 }
            }
            IfCondition EqualTo(small, 1) ThenBlock: {
                Emit_Byte(Add(64, Add(rm, reg8)))
                Emit_Byte(BitwiseAnd(disp, 255))
            } ElseBlock: {
                Emit_Byte(Add(128, Add(rm, reg8)))
                Emit_DWord(disp)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOVDQA xmm15, xmm0. The assembler keeps only the low 3 bits of an xmm index.
Function.X86_CopyXmm15 {
    Body: {
        mtxt = "MOVDQA xmm15, xmm0"
        Listing_Open(mtxt)
        Emit_Byte(102)
        Emit_Byte(68)
        Emit_Byte(15)
        Emit_Byte(111)
        Emit_Byte(248)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// kind 0 VFMADD231SD, 1 VFMSUB231SD, 2 VFNMADD231SD.
// xmm0 = xmm0 ± xmm1*xmm15, and kind 2 is xmm0 = xmm0 - xmm1*xmm15.
// Bytes are the gas form. Trans_Asm cannot name xmm15.
Function.X86_FmaXmm15 {
    Input: kind: Integer
    Body: {
        op = 185
        IfCondition EqualTo(kind, 1) ThenBlock: { op = 187 }
        IfCondition EqualTo(kind, 2) ThenBlock: { op = 189 }
        mtxt = "FMA231 xmm0, xmm1, xmm15"
        Listing_Open(mtxt)
        Emit_Byte(196)
        Emit_Byte(194)
        Emit_Byte(241)
        Emit_Byte(op)
        Emit_Byte(199)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// Scalar SSE op, xmm, [r11 or r14 + disp]. Opcode 16 loads, 88/92/89/94 compute.
// A zero displacement on r14 uses disp8. xmm8–xmm15 set REX.R.
Function.X86_XmmIp {
    Input: opcode: Integer
    Input: xmm: Integer
    Input: reg: Integer
    Input: disp: Integer
    Body: {
        mtxt = "XmmIp"
        Listing_Open(mtxt)
        low = xmm
        rex = 65
        IfCondition GreaterEqual(xmm, 8) ThenBlock: {
            low = Subtract(xmm, 8)
            rex = 69
        }
        rm = 3
        IfCondition EqualTo(reg, 14) ThenBlock: { rm = 6 }
        Emit_Byte(242)
        Emit_Byte(rex)
        Emit_Byte(15)
        Emit_Byte(opcode)
        reg8 = Multiply(low, 8)
        bare = 0
        IfCondition EqualTo(reg, 11) ThenBlock: {
            IfCondition EqualTo(disp, 0) ThenBlock: { bare = 1 }
        }
        IfCondition EqualTo(bare, 1) ThenBlock: {
            Emit_Byte(Add(rm, reg8))
        } ElseBlock: {
            small = 0
            IfCondition GreaterEqual(disp, -128) ThenBlock: {
                IfCondition LessThan(disp, 128) ThenBlock: { small = 1 }
            }
            IfCondition EqualTo(small, 1) ThenBlock: {
                Emit_Byte(Add(64, Add(rm, reg8)))
                Emit_Byte(BitwiseAnd(disp, 255))
            } ElseBlock: {
                Emit_Byte(Add(128, Add(rm, reg8)))
                Emit_DWord(disp)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// VFMADD231SD or VFNMADD231SD into xmm8–xmm14. src2 is xmm0, src3 is xmm1.
// The assembler cannot name these destinations.
Function.X86_FmaHigh {
    Input: slot: Integer
    Input: is_sub: Integer
    Body: {
        op = 185
        IfCondition EqualTo(is_sub, 1) ThenBlock: { op = 189 }
        low = Subtract(slot, 8)
        mtxt = "FMA231 high"
        Listing_Open(mtxt)
        Emit_Byte(196)
        Emit_Byte(98)
        Emit_Byte(249)
        Emit_Byte(op)
        Emit_Byte(Add(193, Multiply(low, 8)))
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// ADD r11 or r14, imm32. The displacement is the pointer stride.
Function.X86_AddIpImm {
    Input: reg: Integer
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("ADD ip, ", nstr)
        Listing_Open(mtxt)
        Emit_Byte(73)
        modrm = 195
        IfCondition EqualTo(reg, 14) ThenBlock: { modrm = 198 }
        small = 0
        IfCondition GreaterEqual(imm, -128) ThenBlock: {
            IfCondition LessThan(imm, 128) ThenBlock: { small = 1 }
        }
        IfCondition EqualTo(small, 1) ThenBlock: {
            Emit_Byte(131)
            Emit_Byte(modrm)
            Emit_Byte(BitwiseAnd(imm, 255))
        } ElseBlock: {
            Emit_Byte(129)
            Emit_Byte(modrm)
            Emit_DWord(imm)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV rax, [r11 or r14 + disp]. Disp 0 uses disp8 so r14 is not [rip].
Function.X86_MovRaxIp {
    Input: reg: Integer
    Input: disp: Integer
    Body: {
        mtxt = "MovRaxIp"
        Listing_Open(mtxt)
        Emit_Byte(73)
        Emit_Byte(139)
        small = 0
        IfCondition GreaterEqual(disp, -128) ThenBlock: {
            IfCondition LessThan(disp, 128) ThenBlock: { small = 1 }
        }
        IfCondition EqualTo(small, 1) ThenBlock: {
            modrm = 67
            IfCondition EqualTo(reg, 14) ThenBlock: { modrm = 70 }
            Emit_Byte(modrm)
            Emit_Byte(BitwiseAnd(disp, 255))
        } ElseBlock: {
            modrm = 131
            IfCondition EqualTo(reg, 14) ThenBlock: { modrm = 134 }
            Emit_Byte(modrm)
            Emit_DWord(disp)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [r11 or r14 + disp], rbx. Same disp8 rule as the load.
Function.X86_MovIpRbx {
    Input: reg: Integer
    Input: disp: Integer
    Body: {
        mtxt = "MovIpRbx"
        Listing_Open(mtxt)
        Emit_Byte(73)
        Emit_Byte(137)
        small = 0
        IfCondition GreaterEqual(disp, -128) ThenBlock: {
            IfCondition LessThan(disp, 128) ThenBlock: { small = 1 }
        }
        IfCondition EqualTo(small, 1) ThenBlock: {
            modrm = 91
            IfCondition EqualTo(reg, 14) ThenBlock: { modrm = 94 }
            Emit_Byte(modrm)
            Emit_Byte(BitwiseAnd(disp, 255))
        } ElseBlock: {
            modrm = 155
            IfCondition EqualTo(reg, 14) ThenBlock: { modrm = 158 }
            Emit_Byte(modrm)
            Emit_DWord(disp)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// SSE scalar op, xmm, [rbp+offset]. opcode 16 movsd, 88 addsd, 92 subsd, 89 mulsd.
// [rbp] is encoded with a displacement. Registers 0-7 only.

Function.X86_EmitRbpXmm {
    Input: opcode: Integer
    Input: xmm: Integer
    Input: offset: Integer
    Body: {
        mtxt = "RbpXmm"
        Listing_Open(mtxt)
        low = xmm
        Emit_Byte(242)
        IfCondition GreaterEqual(xmm, 8) ThenBlock: {
            low = Subtract(xmm, 8)
            Emit_Byte(68)
        }
        Emit_Byte(15)
        Emit_Byte(opcode)
        reg8 = Multiply(low, 8)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(Add(69, reg8))
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(Add(133, reg8))
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        EmitTag_Add(Emit.code_size, 0, TagClass.LOAD_LOCAL, offset)
        Listing_Close()
    }
}

// SSE scalar op, xmm, [r15+offset]. Same opcodes. REX.B selects r15.

Function.X86_EmitR15Xmm {
    Input: opcode: Integer
    Input: xmm: Integer
    Input: offset: Integer
    Body: {
        mtxt = "R15Xmm"
        Listing_Open(mtxt)
        low = xmm
        rex = 65
        IfCondition GreaterEqual(xmm, 8) ThenBlock: {
            low = Subtract(xmm, 8)
            rex = 69
        }
        Emit_Byte(242)
        Emit_Byte(rex)
        Emit_Byte(15)
        Emit_Byte(opcode)
        reg8 = Multiply(low, 8)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(Add(71, reg8))
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(Add(135, reg8))
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// =============================================================================
// MOV BYTE [RSP+offset], imm8
// =============================================================================

Function.X86_MovRaxR15Offset {
    Input: offset: Integer
    Body: {
        nstr = NumberToString(offset)
        mtxt = StringConcat("MOV rax, [r15+", nstr)
        mtxt = StringConcat(mtxt, "]")
        Listing_Open(mtxt)
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x8B)   // 0x8B MOV
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x47)    // mod=01, reg=RAX, r/m=R15
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x87)   // mod=10
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [R15 + offset], RAX - Store pool variable

Function.X86_MovRaxRbpOffset {
    Input: offset: Integer
    Body: {
        nstr = NumberToString(offset)
        mtxt = StringConcat("MOV rax, [rbp+", nstr)
        mtxt = StringConcat(mtxt, "]")
        Listing_Open(mtxt)
        tag_pos = Emit.code_size
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64

        IfCondition EqualTo(offset, 0) ThenBlock: {
            // [RBP] needs disp8=0 due to RBP encoding
            Emit_Byte(0x45)    // 0x45 ModR/M: mod=01, reg=RAX, r/m=RBP
            Emit_Byte(0x00)
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x45)    // mod=01
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x85)   // 0x85 mod=10
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        tag_len = Subtract(Emit.code_size, tag_pos)
        EmitTag_Add(tag_pos, tag_len, TagClass.LOAD_LOCAL, offset)
        Listing_Close()
    }
}

// MOV [RBP + offset], RAX - Store local variable

Function.X86_MovRaxRspOff8 {
    Body: {
        mtxt = "MovRaxRspOff8"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // REX.W
        Emit_Byte(0x8B)    // MOV r64, r/m64
        Emit_Byte(0x44)    // ModR/M: mod=01, reg=RAX, r/m=SIB
        Emit_Byte(0x24)    // SIB: RSP
        Emit_Byte(0x08)    // disp8 = 8
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// mov rax, [rsp+24]. PerfEnd stores the elapsed count there
// (push; sub rsp, 24). The assembler has no memory-operand form.
Function.X86_MovRaxRsp24 {
    Body: {
        mtxt = "MovRaxRsp24"
        Listing_Open(mtxt)
        Emit_Byte(0x48)
        Emit_Byte(0x8B)
        Emit_Byte(0x44)
        Emit_Byte(0x24)
        Emit_Byte(0x18)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_MovRaxRspOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MovRaxRspOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        
        IfCondition EqualTo(offset, 0) ThenBlock: {
            // [RSP] needs SIB byte
            Emit_Byte(0x04)     // ModR/M: mod=00, reg=RAX, r/m=100 (SIB)
            Emit_Byte(0x24)    // SIB: scale=00, index=RSP, base=RSP
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x44)    // mod=01
                Emit_Byte(0x24)    // SIB
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x84)   // mod=10
                Emit_Byte(0x24)    // SIB
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RSP + offset], RAX

Function.X86_MovRbpOffsetRax {
    Input: offset: Integer
    Body: {
        nstr = NumberToString(offset)
        mtxt = StringConcat("MOV [rbp+", nstr)
        mtxt = StringConcat(mtxt, "], rax")
        Listing_Open(mtxt)
        tag_pos = Emit.code_size
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64

        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x45)
            Emit_Byte(0x00)
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x45)
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x85)
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        tag_len = Subtract(Emit.code_size, tag_pos)
        EmitTag_Add(tag_pos, tag_len, TagClass.STORE_LOCAL, offset)
        Listing_Close()
    }
}

Function.X86_MovRbpOffsetRsp {
    Input: offset: Integer
    Body: {
        mtxt = "MovRbpOffsetRsp"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        
        // RBP requires displacement even for offset=0 (ModR/M encoding quirk)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x65)   // 0x65 mod=01, reg=RSP, r/m=RBP
            // Handle signed byte
            IfCondition LessThan(offset, 0) ThenBlock: {
                Emit_Byte(Add(256, offset))
            } ElseBlock: {
                Emit_Byte(offset)
            }
        } ElseBlock: {
            Emit_Byte(0xA5)   // 0xA5 mod=10, reg=RSP, r/m=RBP
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RSP, [RBP + offset] - Restore RSP from stack slot
//
// Encoding: 48 8B 65 disp8  OR  48 8B A5 disp32
// 48 = REX.W (64-bit operand)
// 8B = MOV r64, r/m64
// 65 = ModR/M: mod=01, reg=RSP(100=4), r/m=RBP(101=5) -> 01 100 101 = 0x65
// A5 = ModR/M: mod=10, reg=RSP(100=4), r/m=RBP(101=5) -> 10 100 101 = 0xA5

Function.X86_MovRbxR15Offset {
    Input: offset: Integer
    Body: {
        mtxt = "MovRbxR15Offset"
        Listing_Open(mtxt)
        Emit_Byte(0x49)    // REX.WB (64-bit, R15 base)
        Emit_Byte(0x8B)    // MOV r64, r/m64
        
        IfCondition And(GreaterEqual(offset, 0), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x5F)    // ModR/M: mod=01, reg=RBX(011), r/m=R15(111)
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x9F)    // mod=10
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}


// MOV [RSP+1], AL

Function.X86_MovRbxRbpOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MovRbxRbpOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // REX.W
        Emit_Byte(0x8B)    // MOV r64, r/m64
        
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x5D)    // ModR/M: mod=01, reg=RBX(011), r/m=RBP(101)
            IfCondition LessThan(offset, 0) ThenBlock: {
                Emit_Byte(Add(256, offset))
            } ElseBlock: {
                Emit_Byte(offset)
            }
        } ElseBlock: {
            Emit_Byte(0x9D)    // ModR/M: mod=10, reg=RBX, r/m=RBP
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        EmitTag_Add(Emit.code_size, 0, TagClass.LOAD_LOCAL, offset)
        Listing_Close()
    }
}

// MOV RBX, [R15 + offset] - Load pool variable into RBX

Function.X86_MovRdiDataOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MOV rdi, data"
        Listing_Open(mtxt)
        // MOV RDI, imm64: REX.W (0x48) + 0xBF + 8-byte immediate
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xBF)   // 0xBF MOV RDI, imm64
        
        reloc_pos = Emit.code_size
        Emit_QWord(offset)
        Emit_AddDataReloc(reloc_pos, offset)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}
