        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x0F)    // 0x0F
        Emit_Byte(0xB6)   // 0xB6 MOVZX r64, r/m8
        Emit_Byte(0x00)     // 0x00 ModR/M: RAX, [RAX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

