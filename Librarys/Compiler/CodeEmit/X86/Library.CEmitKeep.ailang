        Listing_Close()
    }
}

// Exact 8 or 4 bytes from [rsi] to [rdi]. Uses xmm0. Does not read past the width.
// 8: movq xmm0, [rsi] / movq [rdi], xmm0. 4: movd xmm0, [rsi] / movd [rdi], xmm0.
Function.X86_CopyXmmRsiRdi {
    Input: nbytes: Integer
    Body: {
        IfCondition EqualTo(nbytes, 8) ThenBlock: {
            Emit_Byte(0xF3)
            Emit_Byte(0x0F)
            Emit_Byte(0x7E)
            Emit_Byte(0x06)
            Emit_Byte(0x66)
            Emit_Byte(0x0F)
            Emit_Byte(0xD6)
            Emit_Byte(0x07)
            Emit.instructions_emitted = Add(Emit.instructions_emitted, 2)
        }
        IfCondition EqualTo(nbytes, 4) ThenBlock: {
            Emit_Byte(0x66)
            Emit_Byte(0x0F)
            Emit_Byte(0x6E)
            Emit_Byte(0x06)
            Emit_Byte(0x66)
            Emit_Byte(0x0F)
            Emit_Byte(0x7E)
            Emit_Byte(0x07)
            Emit.instructions_emitted = Add(Emit.instructions_emitted, 2)
        }
    }
}

// MOVDQU xmm0, [rsi+disp8] then MOVDQU [rdi+disp8], xmm0. disp fits in a byte.
Function.X86_MOVDQU_CopyDisp {
    Input: disp: Integer
    Body: {
        Emit_Byte(0xF3)
        Emit_Byte(0x0F)
        Emit_Byte(0x6F)
        Emit_Byte(0x46)
        Emit_Byte(disp)
        Emit_Byte(0xF3)
        Emit_Byte(0x0F)
        Emit_Byte(0x7F)
        Emit_Byte(0x47)
        Emit_Byte(disp)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 2)
    }
}

