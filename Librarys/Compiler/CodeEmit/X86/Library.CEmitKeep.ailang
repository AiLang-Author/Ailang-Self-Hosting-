        Listing_Open(mtxt)
        Emit_Byte(0x88)   // 0x88 MOV r/m8, r8
        Emit_Byte(0x06)     // 0x06 ModR/M: [RSI], AL
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV BYTE PTR [RBX], AL

// [R13 + offset]. disp 0 uses disp8: mod=0 rm=5 is rip-relative.
// prefix 0 skips the prefix byte. op0 15 emits 0F then op1.

Function.X86_EmitR13Mem {
    Input: prefix: Integer
    Input: rex: Integer
    Input: op0: Integer
    Input: op1: Integer
    Input: reg: Integer
    Input: offset: Integer
    Body: {
        mtxt = "EmitR13Mem"
        Listing_Open(mtxt)
        low = reg
        IfCondition GreaterEqual(reg, 8) ThenBlock: {
            low = Subtract(reg, 8)
            rex = Add(rex, 4)
        }
        IfCondition NotEqual(prefix, 0) ThenBlock: {
            Emit_Byte(prefix)
        }
        Emit_Byte(rex)
        IfCondition EqualTo(op0, 15) ThenBlock: {
            Emit_Byte(15)
            Emit_Byte(op1)
        } ElseBlock: {
            Emit_Byte(op0)
        }
        use8 = 0
        IfCondition GreaterEqual(offset, 0) ThenBlock: {
            IfCondition LessEqual(offset, 127) ThenBlock: {
                use8 = 1
            }
        }
        reg8 = Multiply(low, 8)
        IfCondition EqualTo(use8, 1) ThenBlock: {
            modrm = Add(69, reg8)
            Emit_Byte(modrm)
            Emit_Byte(offset)
        } ElseBlock: {
            modrm = Add(133, reg8)
            Emit_Byte(modrm)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

