// JNZ (alias for JNE)

Function.X86_LeaRaxLabel {
    Input: label_id: Integer
    Body: {
        nstr = NumberToString(label_id)
        mtxt = StringConcat("LEA rax, .L", nstr)
        Listing_Open(mtxt)
        // LEA RAX, [RIP + disp32] = 48 8D 05 xx xx xx xx
        Emit_Byte(0x48)
        Emit_Byte(0x8D)
        Emit_Byte(0x05)
        Emit_AddFixup(label_id, FixupType.REL32)
        Emit_DWord(0)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

