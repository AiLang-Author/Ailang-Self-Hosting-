// =============================================================================
// 
// instructions for saving/restoring RSP to/from RBP-relative stack slots
// =============================================================================

// MOV [RBP + offset], RSP - Save RSP to stack slot
// This is used to preserve RSP across function calls where expression
// evaluation might clobber registers.
//
// Encoding: 48 89 65 disp8  OR  48 89 A5 disp32
// 48 = REX.W (64-bit operand)
// 89 = MOV r/m64, r64
// 65 = ModR/M: mod=01, reg=RSP(100=4), r/m=RBP(101=5) -> 01 100 101 = 0x65
// A5 = ModR/M: mod=10, reg=RSP(100=4), r/m=RBP(101=5) -> 10 100 101 = 0xA5
//
// NOTE: RBP as r/m does NOT require SIB byte (unlike RSP)

Function.X86_MovDerefRdiRax {
    Body: {
        mtxt = "MovDerefRdiRax"
        Listing_Open(mtxt)
        Emit_Byte(0x48)
        Emit_Byte(0x89)
        Emit_Byte(0x07)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// =============================================================================
// BYTE ACCESS
// =============================================================================

// MOV AL, [RBX] - Load byte

Function.X86_MovDwordDerefRaxEbx {
    Body: {
        mtxt = "MovDwordDerefRaxEbx"
        Listing_Open(mtxt)
        Emit_Byte(0x89)   // MOV r/m32, r32
        Emit_Byte(0x18)   // ModRM: [RAX], EBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RBX], EAX - Store dword from EAX to memory at [RBX]
// Encoding: 89 03

Function.X86_MovDwordDerefRbxEax {
    Body: {
        mtxt = "MovDwordDerefRbxEax"
        Listing_Open(mtxt)
        Emit_Byte(0x89)   // MOV r/m32, r32
        Emit_Byte(0x03)   // ModRM: [RBX], EAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RDI], EAX - Store dword from EAX to memory at [RDI]
// Encoding: 89 07

Function.X86_MovDwordDerefRdiEax {
    Body: {
        mtxt = "MovDwordDerefRdiEax"
        Listing_Open(mtxt)
        Emit_Byte(0x89)   // MOV r/m32, r32
        Emit_Byte(0x07)   // ModRM: [RDI], EAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// -----------------------------------------------------------------------------
// DWORD (32-BIT) LOAD OPERATIONS
// -----------------------------------------------------------------------------

// MOV EAX, [RAX] - Load dword (auto zero-extends to RAX in 64-bit mode)
// Encoding: 8B 00 (no REX.W)

Function.X86_MovEaxDerefRax {
    Body: {
        mtxt = "MovEaxDerefRax"
        Listing_Open(mtxt)
        Emit_Byte(0x8B)   // MOV r32, r/m32
        Emit_Byte(0x00)   // ModRM: EAX, [RAX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV EAX, [RBX] - Load dword from [RBX] (auto zero-extends)
// Encoding: 8B 03

Function.X86_MovEaxDerefRbx {
    Body: {
        mtxt = "MovEaxDerefRbx"
        Listing_Open(mtxt)
        Emit_Byte(0x8B)   // MOV r32, r/m32
        Emit_Byte(0x03)   // ModRM: EAX, [RBX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV EAX, [RDI] - Load dword from [RDI] (auto zero-extends)
// Encoding: 8B 07

Function.X86_MovEaxDerefRdi {
    Body: {
        mtxt = "MovEaxDerefRdi"
        Listing_Open(mtxt)
        Emit_Byte(0x8B)   // MOV r32, r/m32
        Emit_Byte(0x07)   // ModRM: EAX, [RDI]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// -----------------------------------------------------------------------------
// QWORD (64-BIT) STORE - MISSING FROM CODEBASE
// -----------------------------------------------------------------------------

// MOV [RBX], RAX - Store qword from RAX to memory at [RBX]
// Encoding: 48 89 03

Function.X86_MovR11RbpOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MovR11RbpOffset"
        Listing_Open(mtxt)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            // 4C 8B 5D xx = MOV R11, [RBP+disp8]
            Emit_Byte(0x4C)
            Emit_Byte(0x8B)
            Emit_Byte(0x5D)
            Emit_Byte(offset)
        } ElseBlock: {
            // 4C 8B 9D xx xx xx xx = MOV R11, [RBP+disp32]
            Emit_Byte(0x4C)
            Emit_Byte(0x8B)
            Emit_Byte(0x9D)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [R11], R10 - Store R10 to memory at [R11]
// 4D 89 13

Function.X86_MovR15OffsetRax {
    Input: offset: Integer
    Body: {
        nstr = NumberToString(offset)
        mtxt = StringConcat("MOV [r15+", nstr)
        mtxt = StringConcat(mtxt, "], rax")
        Listing_Open(mtxt)
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x89)   // 0x89 MOV
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x47)
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x87)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}



// MOV RAX, [R15] - Load from pool table base

Function.X86_MovRaxDataOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MOV rax, data"
        Listing_Open(mtxt)
        // MOV RAX, imm64: REX.W (0x48) + 0xB8 + 8-byte immediate
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xB8)   // 0xB8 MOV RAX, imm64
        
        reloc_pos = Emit.code_size
        Emit_QWord(offset)
        Emit_AddDataReloc(reloc_pos, offset)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RDI, data_offset (with relocation)

Function.X86_MovRaxDerefRax {
    Body: {
        mtxt = "MovRaxDerefRax"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV
        Emit_Byte(0x00)     // ModR/M: [RAX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RAX, [RBX]

Function.X86_MovRaxDerefRaxOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MovRaxDerefRaxOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x00)     // [RAX]
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x40)    // mod=01
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x80)   // mod=10
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RAX + offset], RBX

Function.X86_MovRaxDerefRbx {
    Body: {
        mtxt = "MovRaxDerefRbx"
        Listing_Open(mtxt)
        Emit_Byte(0x48)
        Emit_Byte(0x8B)
        Emit_Byte(0x03)     // ModR/M: [RBX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RAX], RBX - Store RBX to address in RAX

Function.X86_MovRaxDerefRbxRcxScaled {
    Input: scale: Integer
    Body: {
        mtxt = "MovRaxDerefRbxRcxScaled"
        Listing_Open(mtxt)
        // REX.W prefix
        Emit_Byte(0x48)
        // MOV opcode
        Emit_Byte(0x8B)
        // ModRM: mod=00, reg=RAX(000), r/m=100(SIB)
        Emit_Byte(0x04)
        
        // SIB byte: scale | (RCX << 3) | RBX
        // RCX = 001, RBX = 011
        // index_base = (001 << 3) | 011 = 0x0B
        
        IfCondition EqualTo(scale, 1) ThenBlock: {
            Emit_Byte(0x0B)    // 00_001_011
        }
        IfCondition EqualTo(scale, 2) ThenBlock: {
            Emit_Byte(0x4B)    // 01_001_011
        }
        IfCondition EqualTo(scale, 4) ThenBlock: {
            Emit_Byte(0x8B)    // 10_001_011
        }
        IfCondition EqualTo(scale, 8) ThenBlock: {
            Emit_Byte(0xCB)    // 11_001_011
        }
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RAX, [R14 + RCX*scale]
// Same SIB load as MovRaxDerefRbxRcxScaled, with the base in R14 so a
// loop limit parked in RBX survives the load.
// scale 8: 49 8B 04 CE

Function.X86_MovRaxDerefR14RcxScaled {
    Input: scale: Integer
    Body: {
        mtxt = "MovRaxDerefR14RcxScaled"
        Listing_Open(mtxt)
        Emit_Byte(73)
        Emit_Byte(139)
        Emit_Byte(4)
        IfCondition EqualTo(scale, 1) ThenBlock: { Emit_Byte(14) }
        IfCondition EqualTo(scale, 2) ThenBlock: { Emit_Byte(78) }
        IfCondition EqualTo(scale, 4) ThenBlock: { Emit_Byte(142) }
        IfCondition EqualTo(scale, 8) ThenBlock: { Emit_Byte(206) }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// XMM register moves used by extra float homes.
// op 1: MOVQ xmmReg, rax
// op 2: MOVQ rax, xmmReg
// op 3: MOVSD xmm0, xmmReg
// op 4: MOVSD xmmReg, xmm0
// op 5: ADDSD xmmReg, xmm0
// op 6: SUBSD xmmReg, xmm0
// op 7: MULSD xmmReg, xmm0
// op 8: MOVSD xmm1, xmmReg

Function.X86_XmmRR {
    Input: op: Integer
    Input: reg: Integer
    Body: {
        mtxt = "XmmRR"
        Listing_Open(mtxt)
        mod_dst = Add(192, Multiply(reg, 8))
        mod_src = Add(192, reg)
        IfCondition EqualTo(op, 1) ThenBlock: {
            Emit_Byte(102)
            Emit_Byte(72)
            Emit_Byte(15)
            Emit_Byte(110)
            Emit_Byte(mod_dst)
        }
        IfCondition EqualTo(op, 2) ThenBlock: {
            Emit_Byte(102)
            Emit_Byte(72)
            Emit_Byte(15)
            Emit_Byte(126)
            Emit_Byte(mod_dst)
        }
        IfCondition EqualTo(op, 3) ThenBlock: {
            Emit_Byte(242)
            Emit_Byte(15)
            Emit_Byte(16)
            Emit_Byte(mod_src)
        }
        IfCondition EqualTo(op, 4) ThenBlock: {
            Emit_Byte(242)
            Emit_Byte(15)
            Emit_Byte(16)
            Emit_Byte(mod_dst)
        }
        IfCondition EqualTo(op, 5) ThenBlock: {
            Emit_Byte(242)
            Emit_Byte(15)
            Emit_Byte(88)
            Emit_Byte(mod_dst)
        }
        IfCondition EqualTo(op, 6) ThenBlock: {
            Emit_Byte(242)
            Emit_Byte(15)
            Emit_Byte(92)
            Emit_Byte(mod_dst)
        }
        IfCondition EqualTo(op, 7) ThenBlock: {
            Emit_Byte(242)
            Emit_Byte(15)
            Emit_Byte(89)
            Emit_Byte(mod_dst)
        }
        // op 8: MOVSD xmm1, xmmReg. modrm is 0xC8 + reg.
        IfCondition EqualTo(op, 8) ThenBlock: {
            Emit_Byte(242)
            Emit_Byte(15)
            Emit_Byte(16)
            Emit_Byte(Add(200, reg))
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// SSE scalar op, xmm dst, xmm src. opcode 16 movsd, 88 addsd, 92 subsd, 89 mulsd.
// Registers 0-7 only. modrm is 192 + dst*8 + src.

Function.X86_XmmBin {
    Input: opcode: Integer
    Input: dst: Integer
    Input: src: Integer
    Body: {
        mtxt = "XmmBin"
        Listing_Open(mtxt)
        Emit_Byte(242)
        Emit_Byte(15)
        Emit_Byte(opcode)
        Emit_Byte(Add(192, Add(Multiply(dst, 8), src)))
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// SSE scalar op, xmm, [rbp+offset]. opcode 16 movsd, 88 addsd, 92 subsd, 89 mulsd.
// [rbp] is encoded with a displacement. Registers 0-7 only.

Function.X86_EmitRbpXmm {
    Input: opcode: Integer
    Input: xmm: Integer
    Input: offset: Integer
    Body: {
        mtxt = "RbpXmm"
        Listing_Open(mtxt)
        Emit_Byte(242)
        Emit_Byte(15)
        Emit_Byte(opcode)
        reg8 = Multiply(xmm, 8)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(Add(69, reg8))
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(Add(133, reg8))
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// SSE scalar op, xmm, [r15+offset]. Same opcodes. REX.B selects r15.

Function.X86_EmitR15Xmm {
    Input: opcode: Integer
    Input: xmm: Integer
    Input: offset: Integer
    Body: {
        mtxt = "R15Xmm"
        Listing_Open(mtxt)
        Emit_Byte(242)
        Emit_Byte(65)
        Emit_Byte(15)
        Emit_Byte(opcode)
        reg8 = Multiply(xmm, 8)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(Add(71, reg8))
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(Add(135, reg8))
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// =============================================================================
// MOV BYTE [RSP+offset], imm8
// =============================================================================

Function.X86_MovRaxR15Offset {
    Input: offset: Integer
    Body: {
        nstr = NumberToString(offset)
        mtxt = StringConcat("MOV rax, [r15+", nstr)
        mtxt = StringConcat(mtxt, "]")
        Listing_Open(mtxt)
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x8B)   // 0x8B MOV
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x47)    // mod=01, reg=RAX, r/m=R15
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x87)   // mod=10
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [R15 + offset], RAX - Store pool variable

Function.X86_MovRaxRbpOffset {
    Input: offset: Integer
    Body: {
        nstr = NumberToString(offset)
        mtxt = StringConcat("MOV rax, [rbp+", nstr)
        mtxt = StringConcat(mtxt, "]")
        Listing_Open(mtxt)
        tag_pos = Emit.code_size
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64

        IfCondition EqualTo(offset, 0) ThenBlock: {
            // [RBP] needs disp8=0 due to RBP encoding
            Emit_Byte(0x45)    // 0x45 ModR/M: mod=01, reg=RAX, r/m=RBP
            Emit_Byte(0x00)
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x45)    // mod=01
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x85)   // 0x85 mod=10
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        tag_len = Subtract(Emit.code_size, tag_pos)
        EmitTag_Add(tag_pos, tag_len, TagClass.LOAD_LOCAL, offset)
        Listing_Close()
    }
}

// MOV [RBP + offset], RAX - Store local variable

Function.X86_MovRaxRspOff8 {
    Body: {
        mtxt = "MovRaxRspOff8"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // REX.W
        Emit_Byte(0x8B)    // MOV r64, r/m64
        Emit_Byte(0x44)    // ModR/M: mod=01, reg=RAX, r/m=SIB
        Emit_Byte(0x24)    // SIB: RSP
        Emit_Byte(0x08)    // disp8 = 8
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// mov rax, [rsp+24]. PerfEnd stores the elapsed count there
// (push; sub rsp, 24). The assembler has no memory-operand form.
Function.X86_MovRaxRsp24 {
    Body: {
        mtxt = "MovRaxRsp24"
        Listing_Open(mtxt)
        Emit_Byte(0x48)
        Emit_Byte(0x8B)
        Emit_Byte(0x44)
        Emit_Byte(0x24)
        Emit_Byte(0x18)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_MovRaxRspOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MovRaxRspOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        
        IfCondition EqualTo(offset, 0) ThenBlock: {
            // [RSP] needs SIB byte
            Emit_Byte(0x04)     // ModR/M: mod=00, reg=RAX, r/m=100 (SIB)
            Emit_Byte(0x24)    // SIB: scale=00, index=RSP, base=RSP
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x44)    // mod=01
                Emit_Byte(0x24)    // SIB
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x84)   // mod=10
                Emit_Byte(0x24)    // SIB
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV [RSP + offset], RAX

Function.X86_MovRbpOffsetRax {
    Input: offset: Integer
    Body: {
        nstr = NumberToString(offset)
        mtxt = StringConcat("MOV [rbp+", nstr)
        mtxt = StringConcat(mtxt, "], rax")
        Listing_Open(mtxt)
        tag_pos = Emit.code_size
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64

        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x45)
            Emit_Byte(0x00)
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x45)
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x85)
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        tag_len = Subtract(Emit.code_size, tag_pos)
        EmitTag_Add(tag_pos, tag_len, TagClass.STORE_LOCAL, offset)
        Listing_Close()
    }
}

Function.X86_MovRbpOffsetRsp {
    Input: offset: Integer
    Body: {
        mtxt = "MovRbpOffsetRsp"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        
        // RBP requires displacement even for offset=0 (ModR/M encoding quirk)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x65)   // 0x65 mod=01, reg=RSP, r/m=RBP
            // Handle signed byte
            IfCondition LessThan(offset, 0) ThenBlock: {
                Emit_Byte(Add(256, offset))
            } ElseBlock: {
                Emit_Byte(offset)
            }
        } ElseBlock: {
            Emit_Byte(0xA5)   // 0xA5 mod=10, reg=RSP, r/m=RBP
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RSP, [RBP + offset] - Restore RSP from stack slot
//
// Encoding: 48 8B 65 disp8  OR  48 8B A5 disp32
// 48 = REX.W (64-bit operand)
// 8B = MOV r64, r/m64
// 65 = ModR/M: mod=01, reg=RSP(100=4), r/m=RBP(101=5) -> 01 100 101 = 0x65
// A5 = ModR/M: mod=10, reg=RSP(100=4), r/m=RBP(101=5) -> 10 100 101 = 0xA5

Function.X86_MovRbxR15Offset {
    Input: offset: Integer
    Body: {
        mtxt = "MovRbxR15Offset"
        Listing_Open(mtxt)
        Emit_Byte(0x49)    // REX.WB (64-bit, R15 base)
        Emit_Byte(0x8B)    // MOV r64, r/m64
        
        IfCondition And(GreaterEqual(offset, 0), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x5F)    // ModR/M: mod=01, reg=RBX(011), r/m=R15(111)
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x9F)    // mod=10
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}


// MOV [RSP+1], AL

Function.X86_MovRbxRbpOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MovRbxRbpOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // REX.W
        Emit_Byte(0x8B)    // MOV r64, r/m64
        
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x5D)    // ModR/M: mod=01, reg=RBX(011), r/m=RBP(101)
            IfCondition LessThan(offset, 0) ThenBlock: {
                Emit_Byte(Add(256, offset))
            } ElseBlock: {
                Emit_Byte(offset)
            }
        } ElseBlock: {
            Emit_Byte(0x9D)    // ModR/M: mod=10, reg=RBX, r/m=RBP
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RBX, [R15 + offset] - Load pool variable into RBX

Function.X86_MovRdiDataOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MOV rdi, data"
        Listing_Open(mtxt)
        // MOV RDI, imm64: REX.W (0x48) + 0xBF + 8-byte immediate
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xBF)   // 0xBF MOV RDI, imm64
        
        reloc_pos = Emit.code_size
        Emit_QWord(offset)
        Emit_AddDataReloc(reloc_pos, offset)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}
// =============================================================================
// LEA RIP-RELATIVE - Load Effective Address with RIP-relative offset
// =============================================================================

// LEA RAX, [RIP + disp32]

Function.X86_MovRsiDataOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MOV rsi, data"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xBE)   // 0xBE MOV RSI, imm64
        reloc_pos = Emit.code_size
        Emit_QWord(offset)
        Emit_AddDataReloc(reloc_pos, offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RAX, data_offset (with relocation)

Function.X86_MovRspOff1Al {
    Body: {
        mtxt = "MovRspOff1Al"
        Listing_Open(mtxt)
        Emit_Byte(0x88)    // MOV r/m8, r8
        Emit_Byte(0x44)    // ModR/M: mod=01, reg=AL, r/m=SIB
        Emit_Byte(0x24)    // SIB: RSP
        Emit_Byte(0x01)    // disp8 = 1
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOVZX RAX, BYTE [R12+R14]

Function.X86_MovRspRbpOffset {
    Input: offset: Integer
    Body: {
        mtxt = "MovRspRbpOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        
        // RBP requires displacement even for offset=0
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x65)   // 0x65 mod=01, reg=RSP, r/m=RBP
            IfCondition LessThan(offset, 0) ThenBlock: {
                Emit_Byte(Add(256, offset))
            } ElseBlock: {
                Emit_Byte(offset)
            }
        } ElseBlock: {
            Emit_Byte(0xA5)   // 0xA5 mod=10, reg=RSP, r/m=RBP
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

