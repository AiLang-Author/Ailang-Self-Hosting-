// MOVZX RAX, BYTE PTR [RDI] - load byte from [RDI], zero-extend to RAX

Function.X86_LeaRaxRbpOffset {
    Input: offset: Integer
    Body: {
        mtxt = "LeaRaxRbpOffset"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8D)   // 0x8D LEA
        
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x45)    // mod=01, reg=RAX, r/m=RBP
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x85)   // mod=10
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

