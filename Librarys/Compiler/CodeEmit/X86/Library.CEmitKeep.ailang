// LEA RAX, [home + RAX + disp]. home is R12 or R13. R13 has no disp0
// encoding, so a zero displacement uses a disp8 of 0. disp8 is -128..127.
// R12 + RAX + 1: 49 8D 44 04 01.

Function.X86_LeaRaxHome {
    Input: base: Integer
    Input: disp: Integer
    Body: {
        nstr = NumberToString(disp)
        mtxt = StringConcat("LEA rax, [home+rax+", nstr)
        mtxt = StringConcat(mtxt, "]")
        Listing_Open(mtxt)
        Emit_Byte(73)
        Emit_Byte(141)
        sib = 4
        IfCondition EqualTo(base, Reg.R13) ThenBlock: { sib = 5 }
        use8 = 0
        IfCondition GreaterEqual(disp, -128) ThenBlock: {
            IfCondition LessEqual(disp, 127) ThenBlock: { use8 = 1 }
        }
        IfCondition EqualTo(disp, 0) ThenBlock: {
            IfCondition EqualTo(base, Reg.R12) ThenBlock: { use8 = 0 }
        }
        IfCondition EqualTo(use8, 1) ThenBlock: {
            Emit_Byte(68)
            Emit_Byte(sib)
            Emit_Byte(BitwiseAnd(disp, 255))
        } ElseBlock: {
            IfCondition EqualTo(disp, 0) ThenBlock: {
                Emit_Byte(4)
                Emit_Byte(sib)
            } ElseBlock: {
                Emit_Byte(132)
                Emit_Byte(sib)
                Emit_DWord(disp)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// LEA RBX, [RAX + disp]. Disp 0 is the three-byte form. RAX is not the
// RBP/R13 mod=00 trap, so a zero displacement needs no disp8. Disp8 is
// -128..127. Wider displacements are disp32. 1: 48 8D 58 01. 0: 48 8D 18.

Function.X86_LeaRbxRax {
    Input: disp: Integer
    Body: {
        nstr = NumberToString(disp)
        mtxt = StringConcat("LEA rbx, [rax+", nstr)
        mtxt = StringConcat(mtxt, "]")
        Listing_Open(mtxt)
        Emit_Byte(72)
        Emit_Byte(141)
        use8 = 0
        IfCondition GreaterEqual(disp, -128) ThenBlock: {
            IfCondition LessEqual(disp, 127) ThenBlock: { use8 = 1 }
        }
        IfCondition EqualTo(disp, 0) ThenBlock: { use8 = 0 }
        IfCondition EqualTo(use8, 1) ThenBlock: {
            Emit_Byte(88)
            Emit_Byte(BitwiseAnd(disp, 255))
        } ElseBlock: {
            IfCondition EqualTo(disp, 0) ThenBlock: {
                Emit_Byte(24)
            } ElseBlock: {
                Emit_Byte(152)
                Emit_DWord(disp)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// CVTSI2SD XMM1, RAX. F2 48 0F 2A C8. XMM0 is left alone.

Function.X86_Cvtsi2sdXmm1 {
    Body: {
        mtxt = "CVTSI2SD xmm1, rax"
        Listing_Open(mtxt)
        Emit_Byte(242)
        Emit_Byte(72)
        Emit_Byte(15)
        Emit_Byte(42)
        Emit_Byte(200)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// CMP of R12 or R13 with [RBP+disp]. mem_left 0: opcode 3B, home minus
// memory. mem_left 1: opcode 39, memory minus home. Disp 0 is a disp8 of
// 00, because mod=00 with RBP means disp32 and no base.
// r13, [rbp-8]: 4C 3B 6D F8. [rbp-8], r12: 4C 39 65 F8.

Function.X86_CmpHomeMem {
    Input: reg: Integer
    Input: disp: Integer
    Input: mem_left: Integer
    Body: {
        mtxt = "CmpHomeMem"
        Listing_Open(mtxt)
        tag_pos = Emit.code_size
        Emit_Byte(76)
        IfCondition EqualTo(mem_left, 1) ThenBlock: {
            Emit_Byte(57)
        } ElseBlock: {
            Emit_Byte(59)
        }
        field = 4
        IfCondition EqualTo(reg, 13) ThenBlock: { field = 5 }
        use8 = 0
        IfCondition GreaterEqual(disp, -128) ThenBlock: {
            IfCondition LessEqual(disp, 127) ThenBlock: { use8 = 1 }
        }
        IfCondition EqualTo(use8, 1) ThenBlock: {
            Emit_Byte(Add(Add(64, Multiply(field, 8)), 5))
            Emit_Byte(BitwiseAnd(disp, 255))
        } ElseBlock: {
            Emit_Byte(Add(Add(128, Multiply(field, 8)), 5))
            Emit_DWord(disp)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        tag_len = Subtract(Emit.code_size, tag_pos)
        EmitTag_Add(tag_pos, tag_len, TagClass.USE_LOCAL, disp)
        Listing_Close()
    }
}

// CMP rax with [rbp+disp]. mem_left 0: rax minus memory (opcode 3B).
// mem_left 1: memory minus rax (opcode 39). Disp 0 is a disp8 of 00.
// [rbp-8], form 0: 48 3B 45 F8. Form 1: 48 39 45 F8.

Function.X86_CmpRaxMem {
    Input: disp: Integer
    Input: mem_left: Integer
    Body: {
        mtxt = "CmpRaxMem"
        Listing_Open(mtxt)
        tag_pos = Emit.code_size
        Emit_Byte(72)
        IfCondition EqualTo(mem_left, 1) ThenBlock: {
            Emit_Byte(57)
        } ElseBlock: {
            Emit_Byte(59)
        }
        use8 = 0
        IfCondition GreaterEqual(disp, -128) ThenBlock: {
            IfCondition LessEqual(disp, 127) ThenBlock: { use8 = 1 }
        }
        IfCondition EqualTo(use8, 1) ThenBlock: {
            Emit_Byte(69)
            Emit_Byte(BitwiseAnd(disp, 255))
        } ElseBlock: {
            Emit_Byte(133)
            Emit_DWord(disp)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        tag_len = Subtract(Emit.code_size, tag_pos)
        EmitTag_Add(tag_pos, tag_len, TagClass.USE_LOCAL, disp)
        Listing_Close()
    }
}

// CMP rdx, imm. imm8 sign-extends, so -1 and 0 are one byte. Wider
// values that still fit in imm32 use the imm32 form.

Function.X86_CmpRdxImm {
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("CMP rdx, ", nstr)
        Listing_Open(mtxt)
        use8 = 0
        IfCondition GreaterEqual(imm, -128) ThenBlock: {
            IfCondition LessEqual(imm, 127) ThenBlock: { use8 = 1 }
        }
        Emit_Byte(72)
        IfCondition EqualTo(use8, 1) ThenBlock: {
            Emit_Byte(131)
            Emit_Byte(250)
            Emit_Byte(BitwiseAnd(imm, 255))
        } ElseBlock: {
            Emit_Byte(129)
            Emit_Byte(250)
            Emit_DWord(imm)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// CMP rdx, [rbp+disp]. rdx minus memory. Disp 0 is a disp8 of 00,
// because mod=00 with RBP means disp32 and no base. The tag keeps the
// store of that frame slot. [rbp-8]: 48 3B 55 F8.

Function.X86_CmpRdxMem {
    Input: disp: Integer
    Body: {
        mtxt = "CmpRdxMem"
        Listing_Open(mtxt)
        tag_pos = Emit.code_size
        Emit_Byte(72)
        Emit_Byte(59)
        use8 = 0
        IfCondition GreaterEqual(disp, -128) ThenBlock: {
            IfCondition LessEqual(disp, 127) ThenBlock: { use8 = 1 }
        }
        IfCondition EqualTo(use8, 1) ThenBlock: {
            Emit_Byte(85)
            Emit_Byte(BitwiseAnd(disp, 255))
        } ElseBlock: {
            Emit_Byte(149)
            Emit_DWord(disp)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        tag_len = Subtract(Emit.code_size, tag_pos)
        EmitTag_Add(tag_pos, tag_len, TagClass.USE_LOCAL, disp)
        Listing_Close()
    }
}

// AND r13, [rbp+disp]. Disp 0 is a disp8 of 00. The tag keeps the store
// of that frame slot. r13, [rbp-8]: 4C 23 6D F8.

Function.X86_AndR13Mem {
    Input: disp: Integer
    Body: {
        mtxt = "AndR13Mem"
        Listing_Open(mtxt)
        tag_pos = Emit.code_size
        Emit_Byte(76)
        Emit_Byte(35)
        use8 = 0
        IfCondition GreaterEqual(disp, -128) ThenBlock: {
            IfCondition LessEqual(disp, 127) ThenBlock: { use8 = 1 }
        }
        IfCondition EqualTo(use8, 1) ThenBlock: {
            Emit_Byte(109)
            Emit_Byte(BitwiseAnd(disp, 255))
        } ElseBlock: {
            Emit_Byte(173)
            Emit_DWord(disp)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        tag_len = Subtract(Emit.code_size, tag_pos)
        EmitTag_Add(tag_pos, tag_len, TagClass.USE_LOCAL, disp)
        Listing_Close()
    }
}

