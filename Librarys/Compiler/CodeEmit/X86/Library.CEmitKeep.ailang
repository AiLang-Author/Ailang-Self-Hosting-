// AND RAX, imm32

Function.X86_LockCmpxchgDerefRdiRsi {
    Body: {
        mtxt = "LockCmpxchgDerefRdiRsi"
        Listing_Open(mtxt)
        Emit_Byte(0xF0)    // LOCK
        Emit_Byte(0x48)    // REX.W
        Emit_Byte(0x0F)    // 2-byte opcode escape
        Emit_Byte(0xB1)    // CMPXCHG
        Emit_Byte(0x37)    // ModR/M: [RDI], RSI
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// =============================================================================
// LOCK XADD [RDI], RSI
// Atomically: temp = [RDI]; [RDI] = [RDI] + RSI; RSI = temp
// Returns the OLD value in RSI
//
// Encoding: F0 48 0F C1 37
//   F0       = LOCK
//   48       = REX.W
//   0F C1    = XADD r/m64, r64
//   37       = ModR/M: [RDI], RSI
// =============================================================================

Function.X86_LockXaddDerefRdiRsi {
    Body: {
        mtxt = "LockXaddDerefRdiRsi"
        Listing_Open(mtxt)
        Emit_Byte(0xF0)    // LOCK
        Emit_Byte(0x48)    // REX.W
        Emit_Byte(0x0F)    // 2-byte opcode escape
        Emit_Byte(0xC1)    // XADD
        Emit_Byte(0x37)    // ModR/M: [RDI], RSI
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// =============================================================================
// XCHG [RDI], RSI
// Atomically: swap [RDI] and RSI (LOCK implied for memory operands)
//
// Encoding: 48 87 37
//   48       = REX.W
//   87       = XCHG r/m64, r64
//   37       = ModR/M: [RDI], RSI
// =============================================================================

Function.X86_NotRax {
    Body: {
        mtxt = "NOT rax"
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xF7)   // 0xF7 NOT r/m64
        Emit_Byte(0xD0)   // 0xD0 ModR/M: /2, RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// NOT RBX

Function.X86_NotRbx {
    Body: {
        mtxt = "NOT rbx"
        Listing_Open(mtxt)
        Emit_Byte(0x48)
        Emit_Byte(0xF7)
        Emit_Byte(0xD3)   // 0xD3
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

