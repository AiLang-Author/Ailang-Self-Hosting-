        Emit_Byte(0x8B)   // 0x8B MOV r64, r64
        Emit_Byte(0x0B)    // 0x0B ModR/M: RCX, [RBX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

