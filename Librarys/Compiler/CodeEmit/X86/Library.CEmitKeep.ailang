// MOVDQU XMM0, [RDI] — F3 0F 6F 07
// Load 128 bits from unaligned memory at RDI into XMM0

Function.X86_BroadcastAL_XMM0 {
    Body: {
        mtxt = "BroadcastAL_XMM0"
        Listing_Open(mtxt)
        // MOVD XMM0, EAX - 66 0F 6E C0
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x6E)
        Emit_Byte(0xC0)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        
        X86_PUNPCKLBW_XMM0_XMM0()
        X86_PSHUFLW_XMM0_XMM0_0()
        X86_PSHUFD_XMM0_XMM0_0()
        Listing_Close()
    }
}

// =============================================================================
// BSF - Bit Scan Forward (find first set bit)
// =============================================================================

// BSF EDX, EAX - 0F BC D0

Function.X86_BroadcastAL_XMM1 {
    Body: {
        mtxt = "BroadcastAL_XMM1"
        Listing_Open(mtxt)
        // MOVD XMM1, EAX - 66 0F 6E C8
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x6E)
        Emit_Byte(0xC8)
        
        // PUNPCKLBW XMM1, XMM1 - 66 0F 60 C9
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x60)
        Emit_Byte(0xC9)
        
        // PSHUFLW XMM1, XMM1, 0 - F2 0F 70 C9 00
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x70)
        Emit_Byte(0xC9)
        Emit_Byte(0x00)
        
        // PSHUFD XMM1, XMM1, 0 - 66 0F 70 C9 00
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x70)
        Emit_Byte(0xC9)
        Emit_Byte(0x00)
        Listing_Close()
    }
}

