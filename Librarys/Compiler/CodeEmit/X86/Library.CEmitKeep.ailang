// MOV RSI, imm64

Function.X86_MovRdxImm64 {
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("MOV rdx, ", nstr)
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xBA)   // 0xBA MOV RDX
        Emit_QWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV RDI, imm64

Function.X86_MovRegReg {
    Input: dst: Integer
    Input: src: Integer
    Body: {
        rd = Listing_RegName(dst)
        rs = Listing_RegName(src)
        mtxt = StringConcat("MOV ", rd)
        mtxt = StringConcat(mtxt, ", ")
        mtxt = StringConcat(mtxt, rs)
        Listing_Open(mtxt)
        // REX.W MOV r/m64, r64 = 48 89 /r
        rex = 72    // 0x48 base REX.W
        src_enc = src
        dst_enc = dst
        
        // Handle R8-R15 for source (REX.R)
        IfCondition GreaterEqual(src, 8) ThenBlock: {
            rex = BitwiseOr(rex, REX.R)
            src_enc = Subtract(src, 8)
        }
        // Handle R8-R15 for destination (REX.B)
        IfCondition GreaterEqual(dst, 8) ThenBlock: {
            rex = BitwiseOr(rex, REX.B)
            dst_enc = Subtract(dst, 8)
        }
        
        Emit_Byte(rex)
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        // ModR/M: mod=11 (direct), reg=src, r/m=dst
        modrm = BitwiseOr(192, BitwiseOr(LeftShift(src_enc, 3), dst_enc))
        Emit_Byte(modrm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// Convenience: MOV RAX, RBX

Function.X86_MovRsiImm64 {
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("MOV rsi, ", nstr)
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xBE)   // 0xBE MOV RSI
        Emit_QWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV R8, imm64

Function.X86_TestRegReg {
    Input: reg1: Integer
    Input: reg2: Integer
    Body: {
        rd = Listing_RegName(reg1)
        rs = Listing_RegName(reg2)
        mtxt = StringConcat("TEST ", rd)
        mtxt = StringConcat(mtxt, ", ")
        mtxt = StringConcat(mtxt, rs)
        Listing_Open(mtxt)
        rex = 72
        IfCondition GreaterEqual(reg1, 8) ThenBlock: { rex = BitwiseOr(rex, 1) }
        IfCondition GreaterEqual(reg2, 8) ThenBlock: { rex = BitwiseOr(rex, 4) }
        Emit_Byte(rex)
        Emit_Byte(0x85)
        reg1_enc = BitwiseAnd(reg1, 7)
        reg2_enc = BitwiseAnd(reg2, 7)
        modrm = BitwiseOr(192, BitwiseOr(LeftShift(reg2_enc, 3), reg1_enc))
        Emit_Byte(modrm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_XorRegReg {
    Input: dst: Integer
    Input: src: Integer
    Body: {
        rd = Listing_RegName(dst)
        rs = Listing_RegName(src)
        mtxt = StringConcat("XOR ", rd)
        mtxt = StringConcat(mtxt, ", ")
        mtxt = StringConcat(mtxt, rs)
        Listing_Open(mtxt)
        rex = 72
        IfCondition GreaterEqual(dst, 8) ThenBlock: { rex = BitwiseOr(rex, 1) }
        IfCondition GreaterEqual(src, 8) ThenBlock: { rex = BitwiseOr(rex, 4) }
        Emit_Byte(rex)
        Emit_Byte(0x31)
        dst_enc = BitwiseAnd(dst, 7)
        src_enc = BitwiseAnd(src, 7)
        modrm = BitwiseOr(192, BitwiseOr(LeftShift(src_enc, 3), dst_enc))
        Emit_Byte(modrm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// OR dst, src and AND dst, src. Same ModRM as XOR. Opcode 0x09 is OR,
// opcode 0x21 is AND. Both are r/m, r so the destination is the r/m field.

Function.X86_OrRegReg {
    Input: dst: Integer
    Input: src: Integer
    Body: {
        rd = Listing_RegName(dst)
        rs = Listing_RegName(src)
        mtxt = StringConcat("OR ", rd)
        mtxt = StringConcat(mtxt, ", ")
        mtxt = StringConcat(mtxt, rs)
        Listing_Open(mtxt)
        rex = 72
        IfCondition GreaterEqual(dst, 8) ThenBlock: { rex = BitwiseOr(rex, 1) }
        IfCondition GreaterEqual(src, 8) ThenBlock: { rex = BitwiseOr(rex, 4) }
        Emit_Byte(rex)
        Emit_Byte(0x09)
        dst_enc = BitwiseAnd(dst, 7)
        src_enc = BitwiseAnd(src, 7)
        modrm = BitwiseOr(192, BitwiseOr(LeftShift(src_enc, 3), dst_enc))
        Emit_Byte(modrm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_AndRegReg {
    Input: dst: Integer
    Input: src: Integer
    Body: {
        rd = Listing_RegName(dst)
        rs = Listing_RegName(src)
        mtxt = StringConcat("AND ", rd)
        mtxt = StringConcat(mtxt, ", ")
        mtxt = StringConcat(mtxt, rs)
        Listing_Open(mtxt)
        rex = 72
        IfCondition GreaterEqual(dst, 8) ThenBlock: { rex = BitwiseOr(rex, 1) }
        IfCondition GreaterEqual(src, 8) ThenBlock: { rex = BitwiseOr(rex, 4) }
        Emit_Byte(rex)
        Emit_Byte(0x21)
        dst_enc = BitwiseAnd(dst, 7)
        src_enc = BitwiseAnd(src, 7)
        modrm = BitwiseOr(192, BitwiseOr(LeftShift(src_enc, 3), dst_enc))
        Emit_Byte(modrm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// IMUL dst, src. Opcode 0F AF, reg is the destination, r/m is the source.

Function.X86_ImulRegReg {
    Input: dst: Integer
    Input: src: Integer
    Body: {
        rd = Listing_RegName(dst)
        rs = Listing_RegName(src)
        mtxt = StringConcat("IMUL ", rd)
        mtxt = StringConcat(mtxt, ", ")
        mtxt = StringConcat(mtxt, rs)
        Listing_Open(mtxt)
        rex = 72
        IfCondition GreaterEqual(dst, 8) ThenBlock: { rex = BitwiseOr(rex, 4) }
        IfCondition GreaterEqual(src, 8) ThenBlock: { rex = BitwiseOr(rex, 1) }
        Emit_Byte(rex)
        Emit_Byte(0x0F)
        Emit_Byte(0xAF)
        dst_enc = BitwiseAnd(dst, 7)
        src_enc = BitwiseAnd(src, 7)
        modrm = BitwiseOr(192, BitwiseOr(LeftShift(dst_enc, 3), src_enc))
        Emit_Byte(modrm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// UCOMISD xmm0, xmm1. 66 0F 2E C1. Flags match the integer setcc path.

Function.X86_UcomisdXmm0Xmm1 {
    Body: {
        Listing_Open("UCOMISD xmm0, xmm1")
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x2E)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// UCOMISD xmm0, xmmSrc. Same opcode. REX.B selects xmm8–xmm15.

Function.X86_UcomisdXmm0 {
    Input: src: Integer
    Body: {
        Listing_Open("UCOMISD xmm0, xmm")
        Emit_Byte(0x66)
        IfCondition GreaterEqual(src, 8) ThenBlock: { Emit_Byte(0x41) }
        Emit_Byte(0x0F)
        Emit_Byte(0x2E)
        low = BitwiseAnd(src, 7)
        Emit_Byte(BitwiseOr(0xC0, low))
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// MOV rcx, [rbp+offset]. A byte base that is not already in a register.
// The load is tagged so a store of that slot stays live.

Function.X86_MovRcxRbpOffset {
    Input: offset: Integer
    Body: {
        nstr = NumberToString(offset)
        mtxt = StringConcat("MOV rcx, [rbp+", nstr)
        mtxt = StringConcat(mtxt, "]")
        Listing_Open(mtxt)
        tag_pos = Emit.code_size
        Emit_Byte(0x48)
        Emit_Byte(0x8B)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x4D)
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x8D)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        tag_len = Subtract(Emit.code_size, tag_pos)
        EmitTag_Add(tag_pos, tag_len, TagClass.LOAD_LOCAL, offset)
        Listing_Close()
    }
}

// Byte op on [base+index], scale 1. kind 1 is MOVZX rax, byte [base+index].
// kind 2 is MOV byte [base+index], al. base is rcx (1) or r14 (14).
// index is rax (0), rbx (3), r12 (12), or r13 (13). r13 as a base is not
// this form: mod 0 with base 5 forces a disp32.

Function.X86_SibByte {
    Input: kind: Integer
    Input: base: Integer
    Input: index: Integer
    Body: {
        Listing_Open("SibByte")
        ifield = index
        xf = 0
        IfCondition GreaterEqual(index, 8) ThenBlock: {
            ifield = Subtract(index, 8)
            xf = 1
        }
        bfield = base
        bex = 0
        IfCondition GreaterEqual(base, 8) ThenBlock: {
            bfield = Subtract(base, 8)
            bex = 1
        }
        sib = BitwiseOr(LeftShift(ifield, 3), bfield)
        rex_lo = BitwiseOr(LeftShift(xf, 1), bex)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            Emit_Byte(BitwiseOr(0x48, rex_lo))
            Emit_Byte(0x0F)
            Emit_Byte(0xB6)
            Emit_Byte(0x04)
            Emit_Byte(sib)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            IfCondition GreaterThan(rex_lo, 0) ThenBlock: {
                Emit_Byte(BitwiseOr(0x40, rex_lo))
            }
            Emit_Byte(0x88)
            Emit_Byte(0x04)
            Emit_Byte(sib)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_AddRspImm32 {
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("ADD rsp, ", nstr)
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x81)   // 0x81 ADD r/m64, imm32
        Emit_Byte(0xC4)   // 0xC4 ModR/M for RSP
        Emit_DWord(imm)
        Emit.stack_depth = Subtract(Emit.stack_depth, imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// SUB RSP, imm8 - Small stack allocation

Function.X86_Epilogue {
    Body: {
        // MOV RSP, RBP
        X86_MovRegReg(Reg.RSP, Reg.RBP)
        // POP RBP
        X86_PopRbp()
        // RET
        X86_Ret()
    }
}

// Leave instruction (shorthand for MOV RSP,RBP; POP RBP)

Function.X86_LeaRsiRspR8 {
    Body: {
        mtxt = "LEA rsi, rsp, r8"
        Listing_Open(mtxt)
        // LEA RSI, [RSP+R8] = 4A 8D 34 04
        Emit_Byte(0x4A)    // REX.W + REX.X (R8 as index)
        Emit_Byte(0x8D)    // LEA
        Emit_Byte(0x34)    // ModR/M: mod=00, reg=RSI, r/m=SIB
        Emit_Byte(0x04)    // SIB: scale=1, index=R8, base=RSP
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_MovRspR8Dl {
    Body: {
        mtxt = "MOV rsp, r8, dl"
        Listing_Open(mtxt)
        Emit_Byte(0x42)
        Emit_Byte(0x88)
        Emit_Byte(0x14)
        Emit_Byte(0x04)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_MovzxRaxRspR8 {
    Body: {
        mtxt = "MOVZX rax, rsp, r8"
        Listing_Open(mtxt)
        Emit_Byte(0x4A)
        Emit_Byte(0x0F)
        Emit_Byte(0xB6)
        Emit_Byte(0x04)
        Emit_Byte(0x04)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_PopRbp {
    Body: {
        mtxt = "POP rbp"
        Listing_Open(mtxt)
        Emit_Byte(0x5D)    // 0x5D
        Emit.stack_depth = Subtract(Emit.stack_depth, 8)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_Prologue {
    Input: stack_size: Integer
    Body: {
        // PUSH RBP
        X86_PushRbp()
        // MOV RBP, RSP
        X86_MovRegReg(Reg.RBP, Reg.RSP)
        // SUB RSP, stack_size (if needed)
        IfCondition GreaterThan(stack_size, 0) ThenBlock: {
            // Align to 16 bytes
            aligned = BitwiseAnd(Add(stack_size, 15), -16)
            X86_SubRspImm32(aligned)
        }
    }
}

// Standard epilogue

Function.X86_PushRbp {
    Body: {
        mtxt = "PUSH rbp"
        Listing_Open(mtxt)
        Emit_Byte(0x55)    // 0x55
        Emit.stack_depth = Add(Emit.stack_depth, 8)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.X86_SubRspImm32 {
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("SUB rsp, ", nstr)
        Listing_Open(mtxt)
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x81)   // 0x81 SUB r/m64, imm32
        Emit_Byte(0xEC)   // 0xEC ModR/M for RSP
        Emit_DWord(imm)
        Emit.stack_depth = Add(Emit.stack_depth, imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

