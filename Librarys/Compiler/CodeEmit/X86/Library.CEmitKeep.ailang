// Library.CEmitKeep.ailang
// Remaining hand-encoded x86 helpers that cannot use X86Enc_Assemble yet:
// label fixups, memory operands, frame composites, Enc zero-op gaps, SSE mem.
// Collected from former CEmitX86* / FPUEmit* files.
//
LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CListing

Function.X86_AddR12Imm32 {
    Input: imm: Integer
    Body: {
        nstr = NumberToString(imm)
        mtxt = StringConcat("ADD r12, ", nstr)
        Listing_Open(mtxt)
        Emit_Byte(0x49)
        Emit_Byte(0x81)
        Emit_Byte(0xC4)
        Emit_DWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

