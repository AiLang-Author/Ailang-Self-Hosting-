Function.X86_Call {
    Input: label_id: Integer
    Body: {
        nstr = NumberToString(label_id)
        mtxt = StringConcat("CALL .L", nstr)
        Listing_Open(mtxt)
        Emit_Byte(0xE8)   // 0xE8 CALL rel32
        Emit_AddFixup(label_id, FixupType.REL32)
        Emit_DWord(0)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// CALL RAX (indirect call through register)

Function.X86_Ja {
    Input: label_id: Integer
    Body: { X86_Jcc(CC.A, label_id) }
}

// JAE (jump if above or equal, unsigned)

Function.X86_Jae {
    Input: label_id: Integer
    Body: { X86_Jcc(CC.AE, label_id) }
}

// JS (jump if sign/negative)

Function.X86_Jb {
    Input: label_id: Integer
    Body: { X86_Jcc(CC.B, label_id) }
}

// JBE (jump if below or equal, unsigned)

Function.X86_Jbe {
    Input: label_id: Integer
    Body: { X86_Jcc(CC.BE, label_id) }
}

// JA (jump if above, unsigned)

Function.X86_Jcc {
    Input: cc: Integer
    Input: label_id: Integer
    Body: {
        cname = Listing_CcName(cc)
        nstr = NumberToString(label_id)
        mtxt = StringConcat(cname, " .L")
        mtxt = StringConcat(mtxt, nstr)
        Listing_Open(mtxt)
        Emit_Byte(0x0F)    // 0x0F
        Emit_Byte(Add(128, cc))   // 0x80 + cc
        Emit_AddFixup(label_id, FixupType.REL32)
        Emit_DWord(0)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// JE (jump if equal/zero)

Function.X86_Je {
    Input: label_id: Integer
    Body: { X86_Jcc(CC.E, label_id) }
}

// JNE (jump if not equal/not zero)

Function.X86_Jg {
    Input: label_id: Integer
    Body: { X86_Jcc(CC.G, label_id) }
}

// JGE (jump if greater or equal, signed)

Function.X86_Jge {
    Input: label_id: Integer
    Body: { X86_Jcc(CC.GE, label_id) }
}

// JB (jump if below, unsigned)

Function.X86_Jl {
    Input: label_id: Integer
    Body: { X86_Jcc(CC.L, label_id) }
}

// JLE (jump if less or equal, signed)

Function.X86_Jle {
    Input: label_id: Integer
    Body: { X86_Jcc(CC.LE, label_id) }
}

// JG (jump if greater, signed)

Function.X86_Jmp {
    Input: label_id: Integer
    Body: {
        nstr = NumberToString(label_id)
        mtxt = StringConcat("JMP .L", nstr)
        Listing_Open(mtxt)
        Emit_Byte(0xE9)   // 0xE9 JMP rel32
        Emit_AddFixup(label_id, FixupType.REL32)
        Emit_DWord(0)    // Placeholder for fixup
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// JMP rel8 (short jump, for when target is known to be close)

Function.X86_Jne {
    Input: label_id: Integer
    Body: { X86_Jcc(CC.NE, label_id) }
}

// JZ (alias for JE)

Function.X86_Jno {
