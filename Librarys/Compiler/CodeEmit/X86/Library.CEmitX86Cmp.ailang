Function.X86_CmpRdiR12 {
    Body: {
        Emit_Byte(0x4C)
        Emit_Byte(0x39)
        Emit_Byte(0xE7)
    }
}

// CMP AL, imm8 - 3C xx
Function.X86_CmpAlImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x3C)
        Emit_Byte(imm)
    }
}

