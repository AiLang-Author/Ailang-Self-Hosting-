Function.X86Enc_Lookup_VFM {
    Input: key: Address
    Output: Integer
    Body: {
        c = GetByte(key, 3)
        IfCondition EqualTo(c, 65) ThenBlock: { ReturnValue(X86Enc_Lookup_VFMA(key)) }
        IfCondition EqualTo(c, 83) ThenBlock: { ReturnValue(X86Enc_Lookup_VFMS(key)) }
        IfCondition EqualTo(c, 85) ThenBlock: { ReturnValue(X86Enc_Lookup_VFMU(key)) }
        ReturnValue(0)
    }
}

