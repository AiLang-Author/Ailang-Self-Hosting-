Function.X86Enc_Lookup_VPM {
    Input: key: Address
    Output: Integer
    Body: {
        c = GetByte(key, 3)
        IfCondition EqualTo(c, 65) ThenBlock: { ReturnValue(X86Enc_Lookup_VPMA(key)) }
        IfCondition EqualTo(c, 73) ThenBlock: { ReturnValue(X86Enc_Lookup_VPMI(key)) }
        IfCondition EqualTo(c, 79) ThenBlock: { ReturnValue(X86Enc_Lookup_VPMO(key)) }
        IfCondition EqualTo(c, 85) ThenBlock: { ReturnValue(X86Enc_Lookup_VPMU(key)) }
        ReturnValue(0)
    }
}

