Function.X86Enc_Lookup_VC {
    Input: key: Address
    Output: Integer
    Body: {
        c = GetByte(key, 2)
        IfCondition EqualTo(c, 77) ThenBlock: { ReturnValue(X86Enc_Lookup_VCM(key)) }
        IfCondition EqualTo(c, 79) ThenBlock: { ReturnValue(X86Enc_Lookup_VCO(key)) }
        IfCondition EqualTo(c, 86) ThenBlock: { ReturnValue(X86Enc_Lookup_VCV(key)) }
        ReturnValue(0)
    }
}

