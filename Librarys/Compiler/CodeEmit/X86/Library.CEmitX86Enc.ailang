Function.X86Enc_Lookup_VM {
    Input: key: Address
    Output: Integer
    Body: {
        c = GetByte(key, 2)
        IfCondition EqualTo(c, 65) ThenBlock: { ReturnValue(X86Enc_Lookup_VMA(key)) }
        IfCondition EqualTo(c, 73) ThenBlock: { ReturnValue(X86Enc_Lookup_VMI(key)) }
        IfCondition EqualTo(c, 79) ThenBlock: { ReturnValue(X86Enc_Lookup_VMO(key)) }
        IfCondition EqualTo(c, 80) ThenBlock: { ReturnValue(X86Enc_Lookup_VMP(key)) }
        IfCondition EqualTo(c, 85) ThenBlock: { ReturnValue(X86Enc_Lookup_VMU(key)) }
        ReturnValue(0)
    }
}

