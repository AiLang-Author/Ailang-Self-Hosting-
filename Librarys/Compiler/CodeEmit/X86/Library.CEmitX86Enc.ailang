Function.X86Enc_Lookup_P {
    Input: key: Address
    Output: Integer
    Body: {
        c = GetByte(key, 1)
        IfCondition EqualTo(c, 65) ThenBlock: { ReturnValue(X86Enc_Lookup_PA(key)) }
        IfCondition EqualTo(c, 66) ThenBlock: { ReturnValue(X86Enc_Lookup_PB(key)) }
        IfCondition EqualTo(c, 67) ThenBlock: { ReturnValue(X86Enc_Lookup_PC(key)) }
        IfCondition EqualTo(c, 68) ThenBlock: { ReturnValue(X86Enc_Lookup_PD(key)) }
        IfCondition EqualTo(c, 69) ThenBlock: { ReturnValue(X86Enc_Lookup_PE(key)) }
        IfCondition EqualTo(c, 70) ThenBlock: { ReturnValue(X86Enc_Lookup_PF(key)) }
        IfCondition EqualTo(c, 72) ThenBlock: { ReturnValue(X86Enc_Lookup_PH(key)) }
        IfCondition EqualTo(c, 73) ThenBlock: { ReturnValue(X86Enc_Lookup_PI(key)) }
        IfCondition EqualTo(c, 77) ThenBlock: { ReturnValue(X86Enc_Lookup_PM(key)) }
        IfCondition EqualTo(c, 79) ThenBlock: { ReturnValue(X86Enc_Lookup_PO(key)) }
        IfCondition EqualTo(c, 82) ThenBlock: { ReturnValue(X86Enc_Lookup_PR(key)) }
        IfCondition EqualTo(c, 83) ThenBlock: { ReturnValue(X86Enc_Lookup_PS(key)) }
        IfCondition EqualTo(c, 84) ThenBlock: { ReturnValue(X86Enc_Lookup_PT(key)) }
        IfCondition EqualTo(c, 85) ThenBlock: { ReturnValue(X86Enc_Lookup_PU(key)) }
        IfCondition EqualTo(c, 88) ThenBlock: { ReturnValue(X86Enc_Lookup_PX(key)) }
        ReturnValue(0)
    }
