Function.X86Enc_Lookup {
    Input: key: Address
    Output: Integer
    Body: {
        X86EncResult.desc_a = 0
        X86EncResult.desc_b = 0
        c = GetByte(key, 0)
        IfCondition EqualTo(c, 65) ThenBlock: { ReturnValue(X86Enc_Lookup_A(key)) }
        IfCondition EqualTo(c, 66) ThenBlock: { ReturnValue(X86Enc_Lookup_B(key)) }
        IfCondition EqualTo(c, 67) ThenBlock: { ReturnValue(X86Enc_Lookup_C(key)) }
        IfCondition EqualTo(c, 68) ThenBlock: { ReturnValue(X86Enc_Lookup_D(key)) }
        IfCondition EqualTo(c, 69) ThenBlock: { ReturnValue(X86Enc_Lookup_E(key)) }
        IfCondition EqualTo(c, 70) ThenBlock: { ReturnValue(X86Enc_Lookup_F(key)) }
        IfCondition EqualTo(c, 71) ThenBlock: { ReturnValue(X86Enc_Lookup_G(key)) }
        IfCondition EqualTo(c, 72) ThenBlock: { ReturnValue(X86Enc_Lookup_H(key)) }
        IfCondition EqualTo(c, 73) ThenBlock: { ReturnValue(X86Enc_Lookup_I(key)) }
        IfCondition EqualTo(c, 74) ThenBlock: { ReturnValue(X86Enc_Lookup_J(key)) }
        IfCondition EqualTo(c, 75) ThenBlock: { ReturnValue(X86Enc_Lookup_K(key)) }
        IfCondition EqualTo(c, 76) ThenBlock: { ReturnValue(X86Enc_Lookup_L(key)) }
        IfCondition EqualTo(c, 77) ThenBlock: { ReturnValue(X86Enc_Lookup_M(key)) }
        IfCondition EqualTo(c, 78) ThenBlock: { ReturnValue(X86Enc_Lookup_N(key)) }
        IfCondition EqualTo(c, 79) ThenBlock: { ReturnValue(X86Enc_Lookup_O(key)) }
        IfCondition EqualTo(c, 80) ThenBlock: { ReturnValue(X86Enc_Lookup_P(key)) }
        IfCondition EqualTo(c, 82) ThenBlock: { ReturnValue(X86Enc_Lookup_R(key)) }
        IfCondition EqualTo(c, 83) ThenBlock: { ReturnValue(X86Enc_Lookup_S(key)) }
        IfCondition EqualTo(c, 84) ThenBlock: { ReturnValue(X86Enc_Lookup_T(key)) }
        IfCondition EqualTo(c, 85) ThenBlock: { ReturnValue(X86Enc_Lookup_U(key)) }
        IfCondition EqualTo(c, 86) ThenBlock: { ReturnValue(X86Enc_Lookup_V(key)) }
        IfCondition EqualTo(c, 87) ThenBlock: { ReturnValue(X86Enc_Lookup_W(key)) }
        IfCondition EqualTo(c, 88) ThenBlock: { ReturnValue(X86Enc_Lookup_X(key)) }
        ReturnValue(0)
    }
}

Function.X86Enc_ParseAsm {
    Input: src: Address
    Output: Address
    Body: {
        X86AsmParse.nops = 0
        X86AsmParse.op0 = 0
        X86AsmParse.op1 = 0
        X86AsmParse.op2 = 0
        X86AsmParse.op3 = 0
        len = StringLength(src)
        // Find mnemonic end (first space/tab or end)
        mi = 0
        WhileLoop LessThan(mi, len) {
            mc = GetByte(src, mi)
            IfCondition EqualTo(mc, 32) ThenBlock: { BreakLoop }
            IfCondition EqualTo(mc, 9)  ThenBlock: { BreakLoop }
            mi = Add(mi, 1)
        }
        // Build key buffer (256 bytes max)
        key_buf = Allocate(256)
        kpos = 0
        // Copy mnemonic uppercase
        ki = 0
        WhileLoop LessThan(ki, mi) {
            kc = GetByte(src, ki)
            IfCondition And(GreaterEqual(kc,97), LessEqual(kc,122)) ThenBlock: {
                kc = Subtract(kc, 32)
            }
            SetByte(key_buf, kpos, kc)
            kpos = Add(kpos, 1)
            ki = Add(ki, 1)
        }
        // Parse operands
        i = mi
        op_idx = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(src, i)
            // Skip spaces, commas
            IfCondition Or(EqualTo(c,32), Or(EqualTo(c,9), EqualTo(c,44))) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            // Read token: stop at space, comma
            tok_start = i
            WhileLoop LessThan(i, len) {
                c2 = GetByte(src, i)
                IfCondition Or(EqualTo(c2,32), Or(EqualTo(c2,9), EqualTo(c2,44))) ThenBlock: { BreakLoop }
                i = Add(i, 1)
            }
            tok_len = Subtract(i, tok_start)
            // Copy token lowercase to scratch
            tok = Allocate(Add(tok_len, 1))
            tj = 0
            WhileLoop LessThan(tj, tok_len) {
                tc = GetByte(src, Add(tok_start, tj))
                IfCondition And(GreaterEqual(tc,65), LessEqual(tc,90)) ThenBlock: { tc = Add(tc,32) }
                SetByte(tok, tj, tc)
                tj = Add(tj, 1)
            }
            SetByte(tok, tok_len, 0)
            // Extract base register name (stop at '{', '[', '+')
            base_len = 0
            WhileLoop LessThan(base_len, tok_len) {
                bc = GetByte(tok, base_len)
                IfCondition EqualTo(bc, 123) ThenBlock: { BreakLoop }
                IfCondition EqualTo(bc, 91)  ThenBlock: { BreakLoop }
                IfCondition EqualTo(bc, 43)  ThenBlock: { BreakLoop }
                base_len = Add(base_len, 1)
            }
            base = Allocate(Add(base_len, 1))
            bj = 0
            WhileLoop LessThan(bj, base_len) {
                SetByte(base, bj, GetByte(tok, bj))
                bj = Add(bj, 1)
            }
            SetByte(base, base_len, 0)
            // Register or immediate?
            rtype = X86Enc_RegType(base)
            IfCondition NotEqual(rtype, 0) ThenBlock: {
                // Register — scan decorators in tok for {k} and {z}
                has_mask = 0
                has_zero = 0
                di = base_len
                WhileLoop LessThan(di, tok_len) {
                    dc = GetByte(tok, di)
                    IfCondition EqualTo(dc, 123) ThenBlock: {
                        // read until '}'
                        dec_start = Add(di, 1)
                        di = Add(di, 1)
                        WhileLoop LessThan(di, tok_len) {
                            ec = GetByte(tok, di)
                            IfCondition EqualTo(ec, 125) ThenBlock: { BreakLoop }
                            di = Add(di, 1)
                        }
                        dec_len = Subtract(di, dec_start)
                        // Check if it's 'z' (zeroing) or a k register (mask)
                        IfCondition EqualTo(dec_len, 1) ThenBlock: {
                            zc = GetByte(tok, dec_start)
                            IfCondition EqualTo(zc, 122) ThenBlock: { has_zero = 1 }
                        } ElseBlock: {
                            // k0..k7 -> mask register
                            kc2 = GetByte(tok, dec_start)
                            IfCondition EqualTo(kc2, 107) ThenBlock: { has_mask = 1 }
                        }
                    }
                    di = Add(di, 1)
                }
                // Build full type string in key
                rtype_len = StringLength(rtype)
                SetByte(key_buf, kpos, 95)
                kpos = Add(kpos, 1)
                rtj = 0
                WhileLoop LessThan(rtj, rtype_len) {
                    SetByte(key_buf, kpos, GetByte(rtype, rtj))
                    kpos = Add(kpos, 1)
                    rtj = Add(rtj, 1)
                }
                IfCondition EqualTo(has_mask, 1) ThenBlock: {
                    SetByte(key_buf, kpos, 123)
                    kpos = Add(kpos, 1)
                    SetByte(key_buf, kpos, 107)
                    kpos = Add(kpos, 1)
                    SetByte(key_buf, kpos, 125)
                    kpos = Add(kpos, 1)
                }
                IfCondition EqualTo(has_zero, 1) ThenBlock: {
                    SetByte(key_buf, kpos, 123)
                    kpos = Add(kpos, 1)
                    SetByte(key_buf, kpos, 122)
                    kpos = Add(kpos, 1)
                    SetByte(key_buf, kpos, 125)
                    kpos = Add(kpos, 1)
                }
                rnum = X86Enc_RegNum(base)
                IfCondition EqualTo(op_idx, 0) ThenBlock: { X86AsmParse.op0 = rnum }
                IfCondition EqualTo(op_idx, 1) ThenBlock: { X86AsmParse.op1 = rnum }
                IfCondition EqualTo(op_idx, 2) ThenBlock: { X86AsmParse.op2 = rnum }
                IfCondition EqualTo(op_idx, 3) ThenBlock: { X86AsmParse.op3 = rnum }
            } ElseBlock: {
                // Immediate — parse as decimal/hex number
                imm_val = StringToNumber(tok)
                imm_type_str = "imm32"
                imm_type_len = 5
                IfCondition And(GreaterEqual(imm_val,-128), LessEqual(imm_val,127)) ThenBlock: {
                    imm_type_str = "imm8"
                    imm_type_len = 4
                } ElseBlock: {
                    IfCondition Or(LessThan(imm_val,-2147483648), GreaterThan(imm_val,2147483647)) ThenBlock: {
                        imm_type_str = "imm64"
                        imm_type_len = 5
                    }
                }
                SetByte(key_buf, kpos, 95)
                kpos = Add(kpos, 1)
                itj = 0
                WhileLoop LessThan(itj, imm_type_len) {
                    SetByte(key_buf, kpos, GetByte(imm_type_str, itj))
                    kpos = Add(kpos, 1)
                    itj = Add(itj, 1)
                }
                IfCondition EqualTo(op_idx, 0) ThenBlock: { X86AsmParse.op0 = imm_val }
                IfCondition EqualTo(op_idx, 1) ThenBlock: { X86AsmParse.op1 = imm_val }
                IfCondition EqualTo(op_idx, 2) ThenBlock: { X86AsmParse.op2 = imm_val }
                IfCondition EqualTo(op_idx, 3) ThenBlock: { X86AsmParse.op3 = imm_val }
            }
            op_idx = Add(op_idx, 1)
        }
        SetByte(key_buf, kpos, 0)
        X86AsmParse.nops = op_idx
        ReturnValue(key_buf)
    }
}

// Widen the immediate suffix in a key in-place: imm8->imm32, imm16->imm32, imm32->imm64.
// x86-64 has no MOV r64,imm8 etc — ParseAsm may classify small values as imm8
// but the table only has imm32/imm64 forms. Returns 1 if widened, 0 if no imm found.
Function.X86Enc_WideImm {
    Input: key: Address
    Output: Integer
    Body: {
        len = StringLength(key)
        i = 0
        found = -1
        WhileLoop LessThan(i, Subtract(len, 4)) {
            IfCondition EqualTo(GetByte(key, i), 95) ThenBlock: {
                IfCondition EqualTo(GetByte(key, Add(i,1)), 105) ThenBlock: {
                    IfCondition EqualTo(GetByte(key, Add(i,2)), 109) ThenBlock: {
                        IfCondition EqualTo(GetByte(key, Add(i,3)), 109) ThenBlock: {
                            found = i
                            i = len
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(found, -1) ThenBlock: { ReturnValue(0) }
        num_start = Add(found, 4)
        c0 = GetByte(key, num_start)
        // imm8 -> imm32: shift tail right by 1, write "32"
        IfCondition EqualTo(c0, 56) ThenBlock: {
            j = len
            WhileLoop GreaterThan(j, num_start) {
                SetByte(key, Add(j, 1), GetByte(key, j))
                j = Subtract(j, 1)
            }
            SetByte(key, num_start, 51)
            SetByte(key, Add(num_start, 1), 50)
            ReturnValue(1)
        }
        // imm16 -> imm32
        IfCondition EqualTo(c0, 49) ThenBlock: {
            IfCondition EqualTo(GetByte(key, Add(num_start,1)), 54) ThenBlock: {
                SetByte(key, num_start, 51)
                SetByte(key, Add(num_start, 1), 50)
                ReturnValue(1)
            }
        }
        // imm32 -> imm64
        IfCondition EqualTo(c0, 51) ThenBlock: {
            IfCondition EqualTo(GetByte(key, Add(num_start,1)), 50) ThenBlock: {
                SetByte(key, num_start, 54)
                SetByte(key, Add(num_start, 1), 52)
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.X86Enc_Emit {
    Input: key: Address
    Output: Integer
    Body: {
        found = X86Enc_Lookup(key)
        IfCondition EqualTo(found, 0) ThenBlock: {
            w = X86Enc_WideImm(key)
            IfCondition EqualTo(w, 1) ThenBlock: { found = X86Enc_Lookup(key) }
        }
        IfCondition EqualTo(found, 0) ThenBlock: {
            w = X86Enc_WideImm(key)
            IfCondition EqualTo(w, 1) ThenBlock: { found = X86Enc_Lookup(key) }
        }
        IfCondition EqualTo(found, 0) ThenBlock: {
            PrintMessage("[X86Enc] Unknown instruction: ")
            PrintMessage(key)
            PrintMessage("\n")
            ReturnValue(0)
        }
        desc_a = X86EncResult.desc_a
        desc_b = X86EncResult.desc_b
        op0 = X86AsmParse.op0
        op1 = X86AsmParse.op1
        op2 = X86AsmParse.op2
        op3 = X86AsmParse.op3
        enc_type = X86Enc_Bits(desc_a, 62, 3)

        // --- VEX prefix ---
        IfCondition EqualTo(enc_type, 1) ThenBlock: {
            pp_val    = X86Enc_Bits(desc_b, 0, 3)
            mmmmm_val = X86Enc_Bits(desc_b, 2, 31)
            vex_W     = X86Enc_Bits(desc_b, 7, 1)
            vex_L     = X86Enc_Bits(desc_b, 8, 3)
            vvvv_src  = X86Enc_Bits(desc_b, 10, 7)
            rex_R_src = X86Enc_Bits(desc_a, 35, 3)
            rex_B_src = X86Enc_Bits(desc_a, 37, 3)
            rex_X_src = X86Enc_Bits(desc_a, 39, 3)
            r_reg = X86Enc_OpVal(rex_R_src, op0,op1,op2,op3)
            b_reg = X86Enc_OpVal(rex_B_src, op0,op1,op2,op3)
            x_reg = X86Enc_OpVal(rex_X_src, op0,op1,op2,op3)
            vvvv_reg = 0
            IfCondition LessThan(vvvv_src, 7) ThenBlock: {
                vvvv_reg = X86Enc_OpVal(Add(vvvv_src,1), op0,op1,op2,op3)
            }
            can_2byte = 1
            IfCondition NotEqual(mmmmm_val, 1) ThenBlock: { can_2byte = 0 }
            IfCondition NotEqual(vex_W,     0) ThenBlock: { can_2byte = 0 }
            IfCondition GreaterThan(x_reg,  7) ThenBlock: { can_2byte = 0 }
            IfCondition GreaterThan(b_reg,  7) ThenBlock: { can_2byte = 0 }
            IfCondition EqualTo(can_2byte, 1) ThenBlock: {
                r_bit = 1
                IfCondition GreaterThan(r_reg, 7) ThenBlock: { r_bit = 0 }
                vvvv_inv = BitwiseAnd(BitwiseXor(vvvv_reg, 15), 15)
                byte2 = BitwiseOr(BitwiseOr(BitwiseOr(LeftShift(r_bit,7),LeftShift(vvvv_inv,3)),LeftShift(vex_L,2)),pp_val)
                Emit_Byte(0xC5)
                Emit_Byte(byte2)
            } ElseBlock: {
                r_bit = 1
                IfCondition GreaterThan(r_reg,7) ThenBlock: { r_bit = 0 }
                x_bit = 1
                IfCondition GreaterThan(x_reg,7) ThenBlock: { x_bit = 0 }
                b_bit = 1
                IfCondition GreaterThan(b_reg,7) ThenBlock: { b_bit = 0 }
                vvvv_inv = BitwiseAnd(BitwiseXor(vvvv_reg,15),15)
                b1 = BitwiseOr(BitwiseOr(BitwiseOr(LeftShift(r_bit,7),LeftShift(x_bit,6)),LeftShift(b_bit,5)),mmmmm_val)
                b2 = BitwiseOr(BitwiseOr(BitwiseOr(LeftShift(vex_W,7),LeftShift(vvvv_inv,3)),LeftShift(vex_L,2)),pp_val)
                Emit_Byte(0xC4)
                Emit_Byte(b1)
                Emit_Byte(b2)
            }
        }

        // --- EVEX prefix ---
        IfCondition EqualTo(enc_type, 3) ThenBlock: {
            pp_val    = X86Enc_Bits(desc_b, 0, 3)
            mmmmm_val = X86Enc_Bits(desc_b, 2, 31)
            evex_W    = X86Enc_Bits(desc_b, 7, 1)
            evex_LL   = X86Enc_Bits(desc_b, 8, 3)
            vvvv_src  = X86Enc_Bits(desc_b, 10, 7)
            aaa_src   = X86Enc_Bits(desc_b, 13, 7)
            z_src     = X86Enc_Bits(desc_b, 16, 1)
            b_src_f   = X86Enc_Bits(desc_b, 17, 1)
            rex_R_src = X86Enc_Bits(desc_a, 35, 3)
            rex_B_src = X86Enc_Bits(desc_a, 37, 3)
            rex_X_src = X86Enc_Bits(desc_a, 39, 3)
            r_reg = X86Enc_OpVal(rex_R_src, op0,op1,op2,op3)
            b_reg = X86Enc_OpVal(rex_B_src, op0,op1,op2,op3)
            x_reg = X86Enc_OpVal(rex_X_src, op0,op1,op2,op3)
            vvvv_reg = 0
            IfCondition LessThan(vvvv_src,7) ThenBlock: {
                vvvv_reg = X86Enc_OpVal(Add(vvvv_src,1),op0,op1,op2,op3)
            }
            aaa_val = 0
            IfCondition NotEqual(aaa_src,0) ThenBlock: {
                aaa_val = BitwiseAnd(X86Enc_OpVal(aaa_src,op0,op1,op2,op3),7)
            }
            R1 = 1
            IfCondition GreaterThan(r_reg,7) ThenBlock: { R1 = 0 }
            R2 = 1
            IfCondition GreaterThan(r_reg,15) ThenBlock: { R2 = 0 }
            X1 = 1
            IfCondition GreaterThan(x_reg,7) ThenBlock: { X1 = 0 }
            B1 = 1
            IfCondition GreaterThan(b_reg,7) ThenBlock: { B1 = 0 }
            V2 = 1
            IfCondition GreaterThan(vvvv_reg,15) ThenBlock: { V2 = 0 }
            vvvv_inv = BitwiseAnd(BitwiseXor(vvvv_reg,15),15)
            p1 = BitwiseOr(BitwiseOr(BitwiseOr(BitwiseOr(LeftShift(R1,7),LeftShift(X1,6)),LeftShift(B1,5)),LeftShift(R2,4)),mmmmm_val)
            p2 = BitwiseOr(BitwiseOr(BitwiseOr(LeftShift(evex_W,7),LeftShift(vvvv_inv,3)),4),pp_val)
            p3 = BitwiseOr(BitwiseOr(BitwiseOr(BitwiseOr(BitwiseOr(LeftShift(z_src,7),LeftShift(evex_LL,5)),LeftShift(b_src_f,4)),LeftShift(V2,3)),aaa_val),0)
            Emit_Byte(0x62)
            Emit_Byte(p1)
            Emit_Byte(p2)
            Emit_Byte(p3)
        }

        // --- Legacy prefix ---
        pfx = X86Enc_Bits(desc_a, 26, 255)
        IfCondition NotEqual(pfx, 0) ThenBlock: { Emit_Byte(pfx) }

        // --- REX byte (non-VEX/EVEX) ---
        IfCondition EqualTo(enc_type, 0) ThenBlock: {
            rex_W     = X86Enc_Bits(desc_a, 34, 1)
            rex_R_src = X86Enc_Bits(desc_a, 35, 3)
            rex_B_src = X86Enc_Bits(desc_a, 37, 3)
            rex_X_src = X86Enc_Bits(desc_a, 39, 3)
            r_reg = X86Enc_OpVal(rex_R_src, op0,op1,op2,op3)
            b_reg = X86Enc_OpVal(rex_B_src, op0,op1,op2,op3)
            x_reg = X86Enc_OpVal(rex_X_src, op0,op1,op2,op3)
            need_rex = rex_W
            IfCondition GreaterThan(r_reg, 7) ThenBlock: { need_rex = 1 }
            IfCondition GreaterThan(b_reg, 7) ThenBlock: { need_rex = 1 }
            IfCondition GreaterThan(x_reg, 7) ThenBlock: { need_rex = 1 }
            IfCondition EqualTo(need_rex, 1) ThenBlock: {
                rex_byte = 0x40
                IfCondition EqualTo(rex_W, 1)     ThenBlock: { rex_byte = BitwiseOr(rex_byte, 8) }
                IfCondition GreaterThan(r_reg, 7) ThenBlock: { rex_byte = BitwiseOr(rex_byte, 4) }
                IfCondition GreaterThan(x_reg, 7) ThenBlock: { rex_byte = BitwiseOr(rex_byte, 2) }
                IfCondition GreaterThan(b_reg, 7) ThenBlock: { rex_byte = BitwiseOr(rex_byte, 1) }
                Emit_Byte(rex_byte)
            }
        }

        // --- Opcode bytes ---
        n   = X86Enc_Bits(desc_a, 24, 3)
        o1  = X86Enc_Bits(desc_a,  0, 255)
        o2  = X86Enc_Bits(desc_a,  8, 255)
        o3  = X86Enc_Bits(desc_a, 16, 255)
        add = X86Enc_Bits(desc_a, 53, 7)
        IfCondition GreaterEqual(n, 1) ThenBlock: {
            IfCondition And(EqualTo(n,1), NotEqual(add,0)) ThenBlock: {
                av = BitwiseAnd(X86Enc_OpVal(add,op0,op1,op2,op3), 7)
                Emit_Byte(BitwiseOr(o1, av))
            } ElseBlock: { Emit_Byte(o1) }
        }
        IfCondition GreaterEqual(n, 2) ThenBlock: {
            IfCondition And(EqualTo(n,2), NotEqual(add,0)) ThenBlock: {
                av = BitwiseAnd(X86Enc_OpVal(add,op0,op1,op2,op3), 7)
                Emit_Byte(BitwiseOr(o2, av))
            } ElseBlock: { Emit_Byte(o2) }
        }
        IfCondition GreaterEqual(n, 3) ThenBlock: {
            IfCondition And(EqualTo(n,3), NotEqual(add,0)) ThenBlock: {
                av = BitwiseAnd(X86Enc_OpVal(add,op0,op1,op2,op3), 7)
                Emit_Byte(BitwiseOr(o3, av))
            } ElseBlock: { Emit_Byte(o3) }
        }

        // --- ModRM ---
        IfCondition EqualTo(X86Enc_Bits(desc_a,41,1), 1) ThenBlock: {
            mode_is_op = X86Enc_Bits(desc_a, 44, 1)
            mode_val   = X86Enc_Bits(desc_a, 42, 3)
            IfCondition EqualTo(mode_is_op, 1) ThenBlock: { mode_val = 0 }
            reg_is_op  = X86Enc_Bits(desc_a, 48, 1)
            reg_f      = X86Enc_Bits(desc_a, 45, 7)
            rm_is_lit  = X86Enc_Bits(desc_a, 52, 1)
            rm_f       = X86Enc_Bits(desc_a, 49, 7)
            reg_val = reg_f
            IfCondition EqualTo(reg_is_op, 1) ThenBlock: {
                reg_val = BitwiseAnd(X86Enc_OpVal(Add(reg_f,1),op0,op1,op2,op3), 7)
            }
            rm_val = rm_f
            IfCondition EqualTo(rm_is_lit, 0) ThenBlock: {
                rm_val = BitwiseAnd(X86Enc_OpVal(Add(rm_f,1),op0,op1,op2,op3), 7)
            }
            modrm = BitwiseOr(BitwiseOr(LeftShift(mode_val,6),LeftShift(reg_val,3)),rm_val)
            Emit_Byte(modrm)
        }

        // --- Immediate ---
        isz = X86Enc_Bits(desc_a, 56, 15)
        IfCondition NotEqual(isz, 0) ThenBlock: {
            iop = X86Enc_Bits(desc_a, 60, 3)
            iv  = X86Enc_OpVal(Add(iop,1), op0,op1,op2,op3)
            IfCondition EqualTo(isz, 1) ThenBlock: {
                Emit_Byte(BitwiseAnd(iv, 255))
            }
            IfCondition EqualTo(isz, 2) ThenBlock: {
                Emit_Byte(BitwiseAnd(iv, 255))
                Emit_Byte(BitwiseAnd(RightShift(iv, 8), 255))
            }
            IfCondition EqualTo(isz, 3) ThenBlock: {
                Emit_Byte(BitwiseAnd(iv, 255))
                Emit_Byte(BitwiseAnd(RightShift(iv,  8), 255))
                Emit_Byte(BitwiseAnd(RightShift(iv, 16), 255))
                Emit_Byte(BitwiseAnd(RightShift(iv, 24), 255))
            }
            IfCondition EqualTo(isz, 4) ThenBlock: {
                Emit_Byte(BitwiseAnd(iv, 255))
                Emit_Byte(BitwiseAnd(RightShift(iv,  8), 255))
                Emit_Byte(BitwiseAnd(RightShift(iv, 16), 255))
                Emit_Byte(BitwiseAnd(RightShift(iv, 24), 255))
                Emit_Byte(BitwiseAnd(RightShift(iv, 32), 255))
                Emit_Byte(BitwiseAnd(RightShift(iv, 40), 255))
                Emit_Byte(BitwiseAnd(RightShift(iv, 48), 255))
                Emit_Byte(BitwiseAnd(RightShift(iv, 56), 255))
            }
        }
        ReturnValue(1)
    }
}

Function.X86Enc_Assemble {
    Input: asm_str: Address
    Output: Integer
    Body: {
        key = X86Enc_ParseAsm(asm_str)
        ReturnValue(X86Enc_Emit(key))
    }
}
