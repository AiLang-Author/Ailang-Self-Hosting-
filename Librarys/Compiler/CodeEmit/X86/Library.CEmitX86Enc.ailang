Function.X86Enc_Lookup_VP {
    Input: key: Address
    Output: Integer
    Body: {
        c = GetByte(key, 2)
        IfCondition EqualTo(c, 65) ThenBlock: { ReturnValue(X86Enc_Lookup_VPA(key)) }
        IfCondition EqualTo(c, 66) ThenBlock: { ReturnValue(X86Enc_Lookup_VPB(key)) }
        IfCondition EqualTo(c, 67) ThenBlock: { ReturnValue(X86Enc_Lookup_VPC(key)) }
        IfCondition EqualTo(c, 68) ThenBlock: { ReturnValue(X86Enc_Lookup_VPD(key)) }
        IfCondition EqualTo(c, 69) ThenBlock: { ReturnValue(X86Enc_Lookup_VPE(key)) }
        IfCondition EqualTo(c, 71) ThenBlock: { ReturnValue(X86Enc_Lookup_VPG(key)) }
        IfCondition EqualTo(c, 72) ThenBlock: { ReturnValue(X86Enc_Lookup_VPH(key)) }
        IfCondition EqualTo(c, 73) ThenBlock: { ReturnValue(X86Enc_Lookup_VPI(key)) }
        IfCondition EqualTo(c, 76) ThenBlock: { ReturnValue(X86Enc_Lookup_VPL(key)) }
        IfCondition EqualTo(c, 77) ThenBlock: { ReturnValue(X86Enc_Lookup_VPM(key)) }
        IfCondition EqualTo(c, 79) ThenBlock: { ReturnValue(X86Enc_Lookup_VPO(key)) }
        IfCondition EqualTo(c, 80) ThenBlock: { ReturnValue(X86Enc_Lookup_VPP(key)) }
        IfCondition EqualTo(c, 82) ThenBlock: { ReturnValue(X86Enc_Lookup_VPR(key)) }
        IfCondition EqualTo(c, 83) ThenBlock: { ReturnValue(X86Enc_Lookup_VPS(key)) }
        IfCondition EqualTo(c, 84) ThenBlock: { ReturnValue(X86Enc_Lookup_VPT(key)) }
        IfCondition EqualTo(c, 85) ThenBlock: { ReturnValue(X86Enc_Lookup_VPU(key)) }
        IfCondition EqualTo(c, 88) ThenBlock: { ReturnValue(X86Enc_Lookup_VPX(key)) }
        ReturnValue(0)
    }
}

