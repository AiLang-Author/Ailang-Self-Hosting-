Function.X86Enc_Lookup_VF {
    Input: key: Address
    Output: Integer
    Body: {
        c = GetByte(key, 2)
        IfCondition EqualTo(c, 67) ThenBlock: { ReturnValue(X86Enc_Lookup_VFC(key)) }
        IfCondition EqualTo(c, 73) ThenBlock: { ReturnValue(X86Enc_Lookup_VFI(key)) }
