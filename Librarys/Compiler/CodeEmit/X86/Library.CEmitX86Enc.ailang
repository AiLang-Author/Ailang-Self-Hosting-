Function.X86Enc_Lookup_VPS {
    Input: key: Address
    Output: Integer
    Body: {
        c = GetByte(key, 3)
        IfCondition EqualTo(c, 65) ThenBlock: { ReturnValue(X86Enc_Lookup_VPSA(key)) }
        IfCondition EqualTo(c, 67) ThenBlock: { ReturnValue(X86Enc_Lookup_VPSC(key)) }
        IfCondition EqualTo(c, 72) ThenBlock: { ReturnValue(X86Enc_Lookup_VPSH(key)) }
        IfCondition EqualTo(c, 73) ThenBlock: { ReturnValue(X86Enc_Lookup_VPSI(key)) }
        IfCondition EqualTo(c, 76) ThenBlock: { ReturnValue(X86Enc_Lookup_VPSL(key)) }
        IfCondition EqualTo(c, 82) ThenBlock: { ReturnValue(X86Enc_Lookup_VPSR(key)) }
        IfCondition EqualTo(c, 85) ThenBlock: { ReturnValue(X86Enc_Lookup_VPSU(key)) }
        ReturnValue(0)
    }
}

