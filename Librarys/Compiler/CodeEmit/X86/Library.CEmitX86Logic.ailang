// OR INSTRUCTIONS
// =============================================================================

// OR RAX, RBX
Function.X86_OrRaxRbx {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x09)     // 0x09 OR r/m64, r64
        Emit_Byte(0xD8)   // 0xD8
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// OR RAX, RCX
Function.X86_OrRaxRcx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x09)
        Emit_Byte(0xC8)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// OR RAX, imm32
Function.X86_OrRaxImm32 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x0D)    // 0x0D OR RAX, imm32
        Emit_DWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// XOR INSTRUCTIONS
// =============================================================================

// XOR RAX, RBX
Function.X86_XorRaxRbx {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x31)    // 0x31 XOR r/m64, r64
        Emit_Byte(0xD8)   // 0xD8
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// XOR RAX, RCX
Function.X86_XorRaxRcx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x31)
        Emit_Byte(0xC8)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// XOR RAX, imm32
Function.X86_XorRaxImm32 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x35)    // 0x35 XOR RAX, imm32
        Emit_DWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// NOT INSTRUCTION
// =============================================================================

// NOT RAX (one's complement)
Function.X86_NotRax {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xF7)   // 0xF7 NOT r/m64
        Emit_Byte(0xD0)   // 0xD0 ModR/M: /2, RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// NOT RBX
Function.X86_NotRbx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0xF7)
        Emit_Byte(0xD3)   // 0xD3
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// SHIFT LEFT INSTRUCTIONS
// =============================================================================

// SHL RAX, CL (shift left by CL)
Function.X86_ShlRaxCl {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xD3)   // 0xD3 SHL r/m64, CL
        Emit_Byte(0xE0)   // 0xE0 ModR/M: /4, RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// SHL RAX, imm8
Function.X86_ShlRaxImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xC1)   // 0xC1 SHL r/m64, imm8
        Emit_Byte(0xE0)   // 0xE0 ModR/M: /4, RAX
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// SHL RAX, 1
Function.X86_ShlRax1 {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xD1)   // 0xD1 SHL r/m64, 1
        Emit_Byte(0xE0)   // 0xE0
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// SHIFT RIGHT INSTRUCTIONS
// =============================================================================

// SHR RAX, CL (logical shift right by CL)
Function.X86_ShrRaxCl {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xD3)   // 0xD3 SHR r/m64, CL
        Emit_Byte(0xE8)   // 0xE8 ModR/M: /5, RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// SHR RAX, imm8
Function.X86_ShrRaxImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xC1)   // 0xC1 SHR r/m64, imm8
        Emit_Byte(0xE8)   // 0xE8 ModR/M: /5, RAX
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// SAR RAX, CL (arithmetic shift right, preserves sign)
Function.X86_SarRaxCl {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xD3)   // 0xD3 SAR r/m64, CL
        Emit_Byte(0xF8)   // 0xF8 ModR/M: /7, RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// SAR RAX, imm8
Function.X86_SarRaxImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xC1)   // 0xC1 SAR r/m64, imm8
        Emit_Byte(0xF8)   // 0xF8 ModR/M: /7, RAX
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// ROTATE INSTRUCTIONS
// =============================================================================

// ROL RAX, CL (rotate left)
Function.X86_RolRaxCl {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xD3)   // 0xD3 ROL r/m64, CL
        Emit_Byte(0xC0)   // 0xC0 ModR/M: /0, RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// ROR RAX, CL (rotate right)
Function.X86_RorRaxCl {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xD3)   // 0xD3 ROR r/m64, CL
        Emit_Byte(0xC8)   // 0xC8 ModR/M: /1, RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// BIT TEST INSTRUCTIONS
// =============================================================================

// BT RAX, RBX (bit test - sets CF to bit RBX of RAX)
Function.X86_BtRaxRbx {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x0F)    // 0x0F
        Emit_Byte(0xA3)   // 0xA3 BT r/m64, r64
        Emit_Byte(0xD8)   // 0xD8
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// BTS RAX, RBX (bit test and set)
Function.X86_BtsRaxRbx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x0F)
        Emit_Byte(0xAB)   // 0xAB BTS
        Emit_Byte(0xD8)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// BTR RAX, RBX (bit test and reset)
Function.X86_BtrRaxRbx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x0F)
        Emit_Byte(0xB3)   // 0xB3 BTR
        Emit_Byte(0xD8)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}