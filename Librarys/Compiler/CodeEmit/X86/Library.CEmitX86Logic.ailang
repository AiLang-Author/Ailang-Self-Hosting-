// Library.CEmitX86Logic.ailang
// x86-64 bitwise and logical instructions
// Location: Librarys/Compiler/CodeEmit/X86/Library.CEmitX86Logic.ailang

LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore

// =============================================================================
// AND INSTRUCTIONS
// =============================================================================

// AND RAX, RBX
Function.X86_AndRaxRbx {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x21)    // 0x21 AND r/m64, r64
        Emit_Byte(0xD8)   // 0xD8
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// AND RAX, RCX
Function.X86_AndRaxRcx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x21)
        Emit_Byte(0xC8)   // 0xC8
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// AND RSP, -16 (align stack to 16 bytes) - 48 83 E4 F0
Function.X86_AndRspAlignment {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x83)
        Emit_Byte(0xE4)
        Emit_Byte(0xF0)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// AND RAX, imm32
Function.X86_AndRaxImm32 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x25)    // 0x25 AND RAX, imm32
        Emit_DWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// AND RAX, imm8
Function.X86_AndRaxImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x83)   // 0x83
        Emit_Byte(0xE0)   // 0xE0 ModR/M: /4, RAX
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}


// AND RSP, imm8 - Stack alignment (typically AND RSP, -16)
Function.X86_AndRspImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x83)   // 0x83 AND r/m64, imm8
        Emit_Byte(0xE4)   // 0xE4 ModR/M: /4, RSP
        Emit_Byte(imm)   // imm8 (e.g., 0xF0 for -16)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}
