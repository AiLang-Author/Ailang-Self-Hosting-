        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// -----------------------------------------------------------------------------
// WORD (16-BIT) LOAD OPERATIONS
// -----------------------------------------------------------------------------

// MOVZX RAX, WORD [RAX] - Load word, zero-extend to 64-bit
// Encoding: 48 0F B7 00
Function.X86_MovzxRaxWordDerefRax {
    Body: {
        Emit_Byte(0x48)   // REX.W
        Emit_Byte(0x0F)   // Two-byte opcode prefix
        Emit_Byte(0xB7)   // MOVZX r64, r/m16
        Emit_Byte(0x00)   // ModRM: RAX, [RAX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVZX RAX, WORD [RBX] - Load word from [RBX], zero-extend to RAX
// Encoding: 48 0F B7 03
Function.X86_MovzxRaxWordDerefRbx {
    Body: {
        Emit_Byte(0x48)   // REX.W
        Emit_Byte(0x0F)   // Two-byte opcode prefix
        Emit_Byte(0xB7)   // MOVZX r64, r/m16
        Emit_Byte(0x03)   // ModRM: RAX, [RBX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVZX RAX, WORD [RDI] - Load word from [RDI], zero-extend to RAX
// Encoding: 48 0F B7 07
Function.X86_MovzxRaxWordDerefRdi {
    Body: {
        Emit_Byte(0x48)   // REX.W
        Emit_Byte(0x0F)   // Two-byte opcode prefix
        Emit_Byte(0xB7)   // MOVZX r64, r/m16
        Emit_Byte(0x07)   // ModRM: RAX, [RDI]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// -----------------------------------------------------------------------------
// DWORD (32-BIT) STORE OPERATIONS
// -----------------------------------------------------------------------------

// MOV [RAX], EBX - Store dword from EBX to memory at [RAX]
// Encoding: 89 18 (no REX.W = 32-bit operation)
Function.X86_MovDwordDerefRaxEbx {
    Body: {
        Emit_Byte(0x89)   // MOV r/m32, r32
        Emit_Byte(0x18)   // ModRM: [RAX], EBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RBX], EAX - Store dword from EAX to memory at [RBX]
// Encoding: 89 03
Function.X86_MovDwordDerefRbxEax {
    Body: {
        Emit_Byte(0x89)   // MOV r/m32, r32
        Emit_Byte(0x03)   // ModRM: [RBX], EAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RDI], EAX - Store dword from EAX to memory at [RDI]
// Encoding: 89 07
Function.X86_MovDwordDerefRdiEax {
    Body: {
        Emit_Byte(0x89)   // MOV r/m32, r32
        Emit_Byte(0x07)   // ModRM: [RDI], EAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// -----------------------------------------------------------------------------
// DWORD (32-BIT) LOAD OPERATIONS
// -----------------------------------------------------------------------------

// MOV EAX, [RAX] - Load dword (auto zero-extends to RAX in 64-bit mode)
// Encoding: 8B 00 (no REX.W)
Function.X86_MovEaxDerefRax {
    Body: {
        Emit_Byte(0x8B)   // MOV r32, r/m32
        Emit_Byte(0x00)   // ModRM: EAX, [RAX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV EAX, [RBX] - Load dword from [RBX] (auto zero-extends)
// Encoding: 8B 03
Function.X86_MovEaxDerefRbx {
    Body: {
        Emit_Byte(0x8B)   // MOV r32, r/m32
        Emit_Byte(0x03)   // ModRM: EAX, [RBX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV EAX, [RDI] - Load dword from [RDI] (auto zero-extends)
// Encoding: 8B 07
Function.X86_MovEaxDerefRdi {
    Body: {
        Emit_Byte(0x8B)   // MOV r32, r/m32
        Emit_Byte(0x07)   // ModRM: EAX, [RDI]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// -----------------------------------------------------------------------------
// QWORD (64-BIT) STORE - MISSING FROM CODEBASE
// -----------------------------------------------------------------------------

// MOV [RBX], RAX - Store qword from RAX to memory at [RBX]
// Encoding: 48 89 03
Function.X86_MovDerefRbxRax {
    Body: {
        Emit_Byte(0x48)   // REX.W
        Emit_Byte(0x89)   // MOV r/m64, r64
        Emit_Byte(0x03)   // ModRM: [RBX], RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// QWORD MEMORY ACCESS
// =============================================================================

// MOV RAX, [RAX + offset]
Function.X86_MovRaxDerefRaxOffset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x00)     // [RAX]
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x40)    // mod=01
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x80)   // mod=10
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RAX + offset], RBX
Function.X86_MovDerefRaxOffsetRbx {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x89)   // 0x89 MOV
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x18)    // [RAX], RBX
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x58)    // mod=01
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x98)   // mod=10
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// MOV data_offset (with relocation)
// =============================================================================

// Emits placeholder value, records position for later patching
Function.X86_MovRsiDataOffset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xBE)   // 0xBE MOV RSI, imm64
        reloc_pos = Emit.code_size
        Emit_QWord(offset)
        Emit_AddDataReloc(reloc_pos, offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RAX, data_offset (with relocation)
Function.X86_MovRaxDataOffset {
    Input: offset: Integer
    Body: {
        // MOV RAX, imm64: REX.W (0x48) + 0xB8 + 8-byte immediate
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xB8)   // 0xB8 MOV RAX, imm64
        
        reloc_pos = Emit.code_size
        Emit_QWord(offset)
        Emit_AddDataReloc(reloc_pos, offset)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RDI, data_offset (with relocation)
Function.X86_MovRdiDataOffset {
    Input: offset: Integer
    Body: {
        // MOV RDI, imm64: REX.W (0x48) + 0xBF + 8-byte immediate
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xBF)   // 0xBF MOV RDI, imm64
        
        reloc_pos = Emit.code_size
        Emit_QWord(offset)
        Emit_AddDataReloc(reloc_pos, offset)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}
// =============================================================================
// LEA RIP-RELATIVE - Load Effective Address with RIP-relative offset
// =============================================================================

// LEA RAX, [RIP + disp32]
Function.X86_LeaRaxRipOffset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8D)   // 0x8D LEA
        Emit_Byte(0x05)     // 0x05 ModR/M: RAX, [RIP+disp32]
        Emit_DWord(offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// LEA RSI, [RIP + disp32]
Function.X86_LeaRsiRipOffset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8D)   // 0x8D LEA
        Emit_Byte(0x35)    // 0x35 ModR/M: RSI, [RIP+disp32]
        Emit_DWord(offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// LEA RDI, [RIP + disp32]
Function.X86_LeaRdiRipOffset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8D)   // 0x8D LEA
        Emit_Byte(0x3D)    // 0x3D ModR/M: RDI, [RIP+disp32]
        Emit_DWord(offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}




// MOV R11, [RBP + offset] - Load from stack variable into R11
Function.X86_MovR11RbpOffset {
    Input: offset: Integer
    Body: {
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            // 4C 8B 5D xx = MOV R11, [RBP+disp8]
            Emit_Byte(0x4C)
            Emit_Byte(0x8B)
            Emit_Byte(0x5D)
            Emit_Byte(offset)
        } ElseBlock: {
            // 4C 8B 9D xx xx xx xx = MOV R11, [RBP+disp32]
            Emit_Byte(0x4C)
            Emit_Byte(0x8B)
            Emit_Byte(0x9D)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [R11], R10 - Store R10 to memory at [R11]
// 4D 89 13
Function.X86_MovDerefR11R10 {
    Body: {
        Emit_Byte(0x4D)
        Emit_Byte(0x89)
        Emit_Byte(0x13)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [R11 + offset], R10 - Store R10 to memory at [R11+offset]
Function.X86_MovDerefR11OffsetR10 {
    Input: offset: Integer
    Body: {
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            // 4D 89 53 xx = MOV [R11+disp8], R10
            Emit_Byte(0x4D)
            Emit_Byte(0x89)
            Emit_Byte(0x53)
            Emit_Byte(offset)
        } ElseBlock: {
            // 4D 89 93 xx xx xx xx = MOV [R11+disp32], R10
            Emit_Byte(0x4D)
            Emit_Byte(0x89)
            Emit_Byte(0x93)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [R12], RAX - Store RAX to memory at [R12]
// R12 requires SIB byte: 49 89 04 24
Function.X86_MovDerefR12Rax {
    Body: {
        Emit_Byte(0x49)
        Emit_Byte(0x89)
        Emit_Byte(0x04)
        Emit_Byte(0x24)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [R12 + offset], RAX - Store RAX to memory at [R12+offset]
Function.X86_MovDerefR12OffsetRax {
    Input: offset: Integer
    Body: {
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            // 49 89 44 24 xx = MOV [R12+disp8], RAX
            Emit_Byte(0x49)
            Emit_Byte(0x89)
            Emit_Byte(0x44)
            Emit_Byte(0x24)
            Emit_Byte(offset)
        } ElseBlock: {
            // 49 89 84 24 xx xx xx xx = MOV [R12+disp32], RAX
            Emit_Byte(0x49)
            Emit_Byte(0x89)
            Emit_Byte(0x84)
            Emit_Byte(0x24)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RBX, [RBP + offset] - Load from stack into RBX
Function.X86_MovRbxRbpOffset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // REX.W
        Emit_Byte(0x8B)    // MOV r64, r/m64
        
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x5D)    // ModR/M: mod=01, reg=RBX(011), r/m=RBP(101)
            IfCondition LessThan(offset, 0) ThenBlock: {
                Emit_Byte(Add(256, offset))
            } ElseBlock: {
                Emit_Byte(offset)
            }
        } ElseBlock: {
            Emit_Byte(0x9D)    // ModR/M: mod=10, reg=RBX, r/m=RBP
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RBX, [R15 + offset] - Load pool variable into RBX
Function.X86_MovRbxR15Offset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x49)    // REX.WB (64-bit, R15 base)
        Emit_Byte(0x8B)    // MOV r64, r/m64
        
        IfCondition And(GreaterEqual(offset, 0), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x5F)    // ModR/M: mod=01, reg=RBX(011), r/m=R15(111)
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x9F)    // mod=10
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}


// MOV [RSP+1], AL
Function.X86_MovRspOff1Al {
    Body: {
        Emit_Byte(0x88)    // MOV r/m8, r8
        Emit_Byte(0x44)    // ModR/M: mod=01, reg=AL, r/m=SIB
        Emit_Byte(0x24)    // SIB: RSP
        Emit_Byte(0x01)    // disp8 = 1
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVZX RAX, BYTE [R12+R14]
Function.X86_MovzxRaxByteR12R14 {
    Body: {
        Emit_Byte(0x4B)    // REX.WXB (R12 base, R14 index)
        Emit_Byte(0x0F)    // 2-byte opcode
        Emit_Byte(0xB6)    // MOVZX r64, r/m8
        Emit_Byte(0x04)    // ModR/M: mod=00, reg=RAX, r/m=SIB
        Emit_Byte(0x34)    // SIB: scale=1, index=R14, base=R12
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RAX, [RSP+8]
Function.X86_MovRaxRspOff8 {
    Body: {
        Emit_Byte(0x48)    // REX.W
        Emit_Byte(0x8B)    // MOV r64, r/m64
        Emit_Byte(0x44)    // ModR/M: mod=01, reg=RAX, r/m=SIB
        Emit_Byte(0x24)    // SIB: RSP
        Emit_Byte(0x08)    // disp8 = 8
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}