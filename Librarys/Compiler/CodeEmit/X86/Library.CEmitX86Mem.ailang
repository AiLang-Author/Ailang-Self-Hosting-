// Library.CEmitX86Mem.ailang
// x86-64 memory load/store instructions
// Location: Librarys/Compiler/CodeEmit/X86/Library.CEmitX86Mem.ailang

LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.X86.CEmitX86Helpers

// =============================================================================
// LOCAL VARIABLE ACCESS (RBP-relative)
// =============================================================================

// MOVZX RAX, BYTE [RDI + RCX] - 48 0F B6 04 0F
Function.X86_MovzxRaxByteRdiRcx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x0F)
        Emit_Byte(0xB6)
        Emit_Byte(0x04)
        Emit_Byte(0x0F)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVZX R9D, BYTE [RSI + RCX] - 44 0F B6 0C 0E
Function.X86_MovzxR9dByteRsiRcx {
    Body: {
        Emit_Byte(0x44)
        Emit_Byte(0x0F)
        Emit_Byte(0xB6)
        Emit_Byte(0x0C)
        Emit_Byte(0x0E)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RAX, [RBP + offset] - Load local variable
Function.X86_MovRaxRbpOffset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        
        IfCondition EqualTo(offset, 0) ThenBlock: {
            // [RBP] needs disp8=0 due to RBP encoding
            Emit_Byte(0x45)    // 0x45 ModR/M: mod=01, reg=RAX, r/m=RBP
            Emit_Byte(0x00)
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x45)    // mod=01
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x85)   // 0x85 mod=10
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RBP + offset], RAX - Store local variable
Function.X86_MovRbpOffsetRax {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x45)
            Emit_Byte(0x00)
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x45)
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x85)
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// MOV BYTE [RSP+offset], imm8
// =============================================================================
Function.X86_MovByteRspOffsetImm8 {
    Input: offset: Integer
    Input: value: Integer
    Body: {
        Emit_Byte(0xC6)
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x04)
            Emit_Byte(0x24)
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x44)
                Emit_Byte(0x24)
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x84)
                Emit_Byte(0x24)
                Emit_DWord(offset)
            }
        }
        Emit_Byte(value)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV BYTE [R14+offset], imm8
Function.X86_MovByteR14OffsetImm8 {
    Input: offset: Integer
    Input: value: Integer
    Body: {
        Emit_Byte(0x41)
        Emit_Byte(0xC6)
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x06)
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x46)
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x86)
                Emit_DWord(offset)
            }
        }
        Emit_Byte(value)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVZX RAX, BYTE PTR [RSI] - zero-extend byte at [RSI] into RAX
// Encoding: 48 0F B6 06
Function.X86_MovzxRaxBytePtrRsi {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x0F)
        Emit_Byte(0xB6)
        Emit_Byte(0x06)
    }
}

// MOV BYTE PTR [RDI], imm8 - store immediate byte at [RDI]
// Encoding: C6 07 ib
Function.X86_MovByteDerefRdiImm8 {
    Input: val: Integer
    Body: {
        Emit_Byte(0xC6)
        Emit_Byte(0x07)
        Emit_Byte(val)
    }
}

// MOV BYTE [R14], DL
Function.X86_MovByteR14Dl {
    Body: {
        Emit_Byte(0x41)
        Emit_Byte(0x88)
        Emit_Byte(0x16)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// GENERIC MOV reg, [base+offset] and MOV [base+offset], reg
// =============================================================================
Function.X86_MovRegMemOffset {
    Input: dst: Integer
    Input: base: Integer
    Input: offset: Integer
    Body: {
        rex = 72
        IfCondition GreaterEqual(dst, 8) ThenBlock: { rex = BitwiseOr(rex, 4) }
        IfCondition GreaterEqual(base, 8) ThenBlock: { rex = BitwiseOr(rex, 1) }
        Emit_Byte(rex)
        Emit_Byte(0x8B)
        dst_enc = BitwiseAnd(dst, 7)
        base_enc = BitwiseAnd(base, 7)
        IfCondition EqualTo(offset, 0) ThenBlock: {
            modrm = BitwiseOr(LeftShift(dst_enc, 3), base_enc)
            Emit_Byte(modrm)
            IfCondition EqualTo(base_enc, 4) ThenBlock: { Emit_Byte(0x24) }
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                modrm = BitwiseOr(64, BitwiseOr(LeftShift(dst_enc, 3), base_enc))
                Emit_Byte(modrm)
                IfCondition EqualTo(base_enc, 4) ThenBlock: { Emit_Byte(0x24) }
                Emit_Byte(offset)
            } ElseBlock: {
                modrm = BitwiseOr(128, BitwiseOr(LeftShift(dst_enc, 3), base_enc))
                Emit_Byte(modrm)
                IfCondition EqualTo(base_enc, 4) ThenBlock: { Emit_Byte(0x24) }
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

Function.X86_MovMemOffsetReg {
    Input: base: Integer
    Input: offset: Integer
    Input: src: Integer
    Body: {
        rex = 72
        IfCondition GreaterEqual(src, 8) ThenBlock: { rex = BitwiseOr(rex, 4) }
        IfCondition GreaterEqual(base, 8) ThenBlock: { rex = BitwiseOr(rex, 1) }
        Emit_Byte(rex)
        Emit_Byte(0x89)
        src_enc = BitwiseAnd(src, 7)
        base_enc = BitwiseAnd(base, 7)
        IfCondition EqualTo(offset, 0) ThenBlock: {
            modrm = BitwiseOr(LeftShift(src_enc, 3), base_enc)
            Emit_Byte(modrm)
            IfCondition EqualTo(base_enc, 4) ThenBlock: { Emit_Byte(0x24) }
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                modrm = BitwiseOr(64, BitwiseOr(LeftShift(src_enc, 3), base_enc))
                Emit_Byte(modrm)
                IfCondition EqualTo(base_enc, 4) ThenBlock: { Emit_Byte(0x24) }
                Emit_Byte(offset)
            } ElseBlock: {
                modrm = BitwiseOr(128, BitwiseOr(LeftShift(src_enc, 3), base_enc))
                Emit_Byte(modrm)
                IfCondition EqualTo(base_enc, 4) ThenBlock: { Emit_Byte(0x24) }
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RCX], DL (store byte from DL to address in RCX)
Function.X86_MovDerefRcxDl {
    Body: {
        Emit_Byte(0x88)   // 0x88 MOV r/m8, r8
        Emit_Byte(0x11)    // 0x11 ModR/M: [RCX], DL
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// 
// instructions for saving/restoring RSP to/from RBP-relative stack slots
// =============================================================================

// MOV [RBP + offset], RSP - Save RSP to stack slot
// This is used to preserve RSP across function calls where expression
// evaluation might clobber registers.
//
// Encoding: 48 89 65 disp8  OR  48 89 A5 disp32
// 48 = REX.W (64-bit operand)
// 89 = MOV r/m64, r64
// 65 = ModR/M: mod=01, reg=RSP(100=4), r/m=RBP(101=5) -> 01 100 101 = 0x65
// A5 = ModR/M: mod=10, reg=RSP(100=4), r/m=RBP(101=5) -> 10 100 101 = 0xA5
//
// NOTE: RBP as r/m does NOT require SIB byte (unlike RSP)
Function.X86_MovRbpOffsetRsp {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        
        // RBP requires displacement even for offset=0 (ModR/M encoding quirk)
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x65)   // 0x65 mod=01, reg=RSP, r/m=RBP
            // Handle signed byte
            IfCondition LessThan(offset, 0) ThenBlock: {
                Emit_Byte(Add(256, offset))
            } ElseBlock: {
                Emit_Byte(offset)
            }
        } ElseBlock: {
            Emit_Byte(0xA5)   // 0xA5 mod=10, reg=RSP, r/m=RBP
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RSP, [RBP + offset] - Restore RSP from stack slot
//
// Encoding: 48 8B 65 disp8  OR  48 8B A5 disp32
// 48 = REX.W (64-bit operand)
// 8B = MOV r64, r/m64
// 65 = ModR/M: mod=01, reg=RSP(100=4), r/m=RBP(101=5) -> 01 100 101 = 0x65
// A5 = ModR/M: mod=10, reg=RSP(100=4), r/m=RBP(101=5) -> 10 100 101 = 0xA5
Function.X86_MovRspRbpOffset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        
        // RBP requires displacement even for offset=0
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x65)   // 0x65 mod=01, reg=RSP, r/m=RBP
            IfCondition LessThan(offset, 0) ThenBlock: {
                Emit_Byte(Add(256, offset))
            } ElseBlock: {
                Emit_Byte(offset)
            }
        } ElseBlock: {
            Emit_Byte(0xA5)   // 0xA5 mod=10, reg=RSP, r/m=RBP
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// POOL VARIABLE ACCESS (R15-relative)
// R15 = pool table base address
// =============================================================================

// MOV RAX, [R15 + offset] - Load pool variable
Function.X86_MovRaxR15Offset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x8B)   // 0x8B MOV
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x47)    // mod=01, reg=RAX, r/m=R15
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x87)   // mod=10
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [R15 + offset], RAX - Store pool variable
Function.X86_MovR15OffsetRax {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x89)   // 0x89 MOV
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x47)
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x87)
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}



// MOV RAX, [R15] - Load from pool table base
Function.X86_MovRaxDerefR15 {
    Body: {
        Emit_Byte(0x49)    // 0x49 REX.WB (W=64-bit, B=R15 extension)
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        Emit_Byte(0x07)     // 0x07 ModR/M: mod=00, reg=RAX(000), r/m=R15(111)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RAX, [R15 + offset] - Load from pool table with offset
Function.X86_MovRaxDerefR15Offset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x07)     // ModR/M: [R15]
        } ElseBlock: {
            IfCondition And(GreaterThan(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x47)    // 0x47 ModR/M: mod=01, reg=RAX, r/m=R15
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x87)   // 0x87 ModR/M: mod=10, reg=RAX, r/m=R15
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [R15], RAX - Store to pool table base
Function.X86_MovDerefR15Rax {
    Body: {
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        Emit_Byte(0x07)     // 0x07 ModR/M: [R15], RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [R15 + offset], RAX - Store to pool table with offset
Function.X86_MovDerefR15OffsetRax {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x07)     // ModR/M: [R15], RAX
        } ElseBlock: {
            IfCondition And(GreaterThan(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x47)    // mod=01, reg=RAX, r/m=R15
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x87)   // mod=10, reg=RAX, r/m=R15
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RBX, [R15 + offset] - Load to RBX from pool table
Function.X86_MovRbxDerefR15Offset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x1F)    // 0x1F ModR/M: mod=00, reg=RBX(011), r/m=R15(111)
        } ElseBlock: {
            IfCondition And(GreaterThan(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x5F)    // 0x5F ModR/M: mod=01, reg=RBX, r/m=R15
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x9F)   // 0x9F ModR/M: mod=10, reg=RBX, r/m=R15
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [R15 + offset], RBX - Store RBX to pool table
Function.X86_MovDerefR15OffsetRbx {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x1F)    // ModR/M: [R15], RBX
        } ElseBlock: {
            IfCondition And(GreaterThan(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x5F)    // mod=01, reg=RBX, r/m=R15
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x9F)   // mod=10, reg=RBX, r/m=R15
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// LEA RAX, [R15 + offset] - Load effective address from pool table
Function.X86_LeaRaxR15Offset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x8D)   // 0x8D LEA
        
        IfCondition And(GreaterThan(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x47)    // mod=01, reg=RAX, r/m=R15
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x87)   // mod=10, reg=RAX, r/m=R15
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// STACK-RELATIVE ACCESS (RSP-relative)
// =============================================================================

// MOV RAX, [RSP + offset]
Function.X86_MovRaxRspOffset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        
        IfCondition EqualTo(offset, 0) ThenBlock: {
            // [RSP] needs SIB byte
            Emit_Byte(0x04)     // ModR/M: mod=00, reg=RAX, r/m=100 (SIB)
            Emit_Byte(0x24)    // SIB: scale=00, index=RSP, base=RSP
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x44)    // mod=01
                Emit_Byte(0x24)    // SIB
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x84)   // mod=10
                Emit_Byte(0x24)    // SIB
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RSP + offset], RAX
Function.X86_MovRspOffsetRax {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        
        IfCondition EqualTo(offset, 0) ThenBlock: {
            Emit_Byte(0x04)
            Emit_Byte(0x24)
        } ElseBlock: {
            IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
                Emit_Byte(0x44)
                Emit_Byte(0x24)
                Emit_Byte(offset)
            } ElseBlock: {
                Emit_Byte(0x84)
                Emit_Byte(0x24)
                Emit_DWord(offset)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// LEA RSP, [RBP + offset] - Used to restore RSP in function epilogue
// This is critical for properly restoring callee-saved registers
Function.X86_LeaRspRbpOffset {
    Input: offset: Integer
    Body: {
        // LEA RSP, [RBP + disp]
        // Encoding: 48 8D 65 disp8  OR  48 8D A5 disp32
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8D)   // 0x8D LEA opcode
        
        // ModR/M byte: mod=01/10, reg=RSP(100), r/m=RBP(101)
        // For RBP base: use 0x65 for disp8, 0xA5 for disp32
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x65)   // 0x65 ModR/M: mod=01, reg=RSP, r/m=RBP
            // Handle signed byte
            IfCondition LessThan(offset, 0) ThenBlock: {
                Emit_Byte(Add(256, offset))  // Convert to unsigned byte
            } ElseBlock: {
                Emit_Byte(offset)
            }
        } ElseBlock: {
            Emit_Byte(0xA5)   // 0xA5 ModR/M: mod=10, reg=RSP, r/m=RBP
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}



// =============================================================================
// INDIRECT ACCESS (through register)
// =============================================================================

// MOV RAX, [RAX] - Load through pointer in RAX
Function.X86_MovRaxDerefRax {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV
        Emit_Byte(0x00)     // ModR/M: [RAX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RAX, [RBX]
Function.X86_MovRaxDerefRbx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x8B)
        Emit_Byte(0x03)     // ModR/M: [RBX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RAX], RBX - Store RBX to address in RAX
Function.X86_MovDerefRaxRbx {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        Emit_Byte(0x18)    // 0x18 ModR/M: [RAX], RBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RAX], RCX
Function.X86_MovDerefRaxRcx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x89)
        Emit_Byte(0x08)     // ModR/M: [RAX], RCX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// BYTE ACCESS
// =============================================================================

// MOV AL, [RBX] - Load byte
Function.X86_MovAlDerefRbx {
    Body: {
        Emit_Byte(0x8A)   // 0x8A MOV r8, r/m8
        Emit_Byte(0x03)     // ModR/M: AL, [RBX]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RBX], AL - Store byte
Function.X86_MovDerefRbxAl {
    Body: {
        Emit_Byte(0x88)   // 0x88 MOV r/m8, r8
        Emit_Byte(0x03)     // ModR/M: [RBX], AL
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV AL, [RAX + RBX] - Load byte with index
Function.X86_MovAlRaxRbx {
    Body: {
        Emit_Byte(0x8A)   // 0x8A MOV r8, r/m8
        Emit_Byte(0x04)     // ModR/M with SIB
        Emit_Byte(0x18)    // SIB: RAX + RBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RAX + RBX], CL - Store byte with index
Function.X86_MovRaxRbxCl {
    Body: {
        Emit_Byte(0x88)   // 0x88 MOV r/m8, r8
        Emit_Byte(0x0C)    // ModR/M with SIB, CL
        Emit_Byte(0x18)    // SIB: RAX + RBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// LEA - Load Effective Address
// =============================================================================

// LEA RAX, [RBP + offset]
Function.X86_LeaRaxRbpOffset {
    Input: offset: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8D)   // 0x8D LEA
        
        IfCondition And(GreaterEqual(offset, -128), LessThan(offset, 128)) ThenBlock: {
            Emit_Byte(0x45)    // mod=01, reg=RAX, r/m=RBP
            Emit_Byte(offset)
        } ElseBlock: {
            Emit_Byte(0x85)   // mod=10
            Emit_DWord(offset)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// DATA ADDRESS LOADING (with relocation tracking)
// =============================================================================

// LEA/MOV for data section address - TRACKS RELOCATION
Function.X86_LoadDataAddress {
    Input: data_offset: Integer
    Body: {
        // Use MOV RAX, imm64 for absolute address
        // This will be patched by Emit_ApplyDataRelocations
        
        Emit_Byte(0x48)   // REX.W
        Emit_Byte(0xB8)   // MOV RAX, imm64
        
        // Record current position for relocation
        Emit_AddDataReloc(Emit.code_size, data_offset)
        
        // Emit placeholder (8 bytes of zeros)
        // These will be patched with the actual address
        Emit_QWord(0)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}


// Alternative: Load data address into RSI (for syscalls)
Function.X86_LoadDataAddressRsi {
    Input: data_offset: Integer
    Body: {
        // MOV RSI, imm64
        Emit_Byte(0x48)   // REX.W
        Emit_Byte(0xBE)   // MOV RSI, imm64
        
        // Record for relocation
        Emit_AddDataReloc(Emit.code_size, data_offset)
        
        // Placeholder
        Emit_QWord(0)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// Load data address into RDI
Function.X86_LoadDataAddressRdi {
    Input: data_offset: Integer
    Body: {
        // MOV RDI, imm64
        Emit_Byte(0x48)   // REX.W
        Emit_Byte(0xBF)   // MOV RDI, imm64
        
        Emit_AddDataReloc(Emit.code_size, data_offset)
        Emit_QWord(0)
        
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}


// -----------------------------------------------------------------------------
// WORD (16-BIT) STORE OPERATIONS
// -----------------------------------------------------------------------------

// MOV [RAX], BX - Store word from BX to memory at [RAX]
// Encoding: 66 89 18
Function.X86_MovWordDerefRaxBx {
    Body: {
        Emit_Byte(0x66)   // Operand size prefix (16-bit)
        Emit_Byte(0x89)   // MOV r/m16, r16
        Emit_Byte(0x18)   // ModRM: [RAX], BX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RBX], AX - Store word from AX to memory at [RBX]
// Encoding: 66 89 03
Function.X86_MovWordDerefRbxAx {
    Body: {
        Emit_Byte(0x66)   // Operand size prefix (16-bit)
        Emit_Byte(0x89)   // MOV r/m16, r16
        Emit_Byte(0x03)   // ModRM: [RBX], AX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV [RDI], AX - Store word from AX to memory at [RDI]
// Encoding: 66 89 07
Function.X86_MovWordDerefRdiAx {
    Body: {
        Emit_Byte(0x66)   // Operand size prefix (16-bit)
        Emit_Byte(0x89)   // MOV r/m16, r16
