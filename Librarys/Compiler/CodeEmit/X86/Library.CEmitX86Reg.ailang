        Emit_Byte(0xD2)   // 0xD2 ModR/M: R10, R10
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// ADD TO: Library.CEmitX86Reg.ailang
// Section: MOV reg, reg - After the existing convenience functions
// =============================================================================


// -----------------------------------------------------------------------------
// Frame pointer setup/teardown
// -----------------------------------------------------------------------------

// MOV RAX, [RSP] - load from stack top without popping
Function.X86_MovRaxDerefRsp {
    Body: {
        // 48 8B 04 24 = MOV RAX, [RSP]
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        Emit_Byte(0x04)     // 0x04 ModR/M: RAX, SIB follows
        Emit_Byte(0x24)    // 0x24 SIB: [RSP]
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RBP, RSP - set up frame pointer
Function.X86_MovRbpRsp {
    Body: {
        // 48 89 E5 = REX.W MOV RBP, RSP
        Emit_Byte(0x48)   // 0x48 REX.W
        Emit_Byte(0x89)  // 0x89 MOV r/m64, r64
        Emit_Byte(0xE5)  // 0xE5 ModRM: mod=11, reg=RSP(4), r/m=RBP(5)
    }
}

// MOV RSP, RBP - restore stack pointer
Function.X86_MovRspRbp {
    Body: {
        // 48 89 EC = REX.W MOV RSP, RBP
        Emit_Byte(0x48)   // 0x48 REX.W
        Emit_Byte(0x89)  // 0x89 MOV r/m64, r64
        Emit_Byte(0xEC)  // 0xEC ModRM: mod=11, reg=RBP(5), r/m=RSP(4)
    }
}

Function.X86_TestR13R13 {
    Body: {
        Emit_Byte(0x4D)    // 0x4D REX.WB
        Emit_Byte(0x85)   // 0x85 TEST
        Emit_Byte(0xED)   // 0xED ModR/M: R13, R13
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// X86_ImulRaxR12 - IMUL RAX, R12
Function.X86_ImulRaxR12 {
    Body: {
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0x0F)    // 0x0F
        Emit_Byte(0xAF)   // 0xAF IMUL
        Emit_Byte(0xC4)   // 0xC4 ModR/M: RAX, R12
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// X86_DecR13 - DEC R13
Function.X86_DecR13 {
    Body: {
        Emit_Byte(0x49)    // 0x49 REX.WB
        Emit_Byte(0xFF)   // 0xFF
        Emit_Byte(0xCD)   // 0xCD ModR/M: DEC R13
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}
// =============================================================================
// ADD TO Library.CEmitX86Reg.ailang
// R11/RSP moves for stack alignment preservation
// =============================================================================

// PUSH R11
// Encoding: 41 53
// POP R11
// Encoding: 41 5B
// MOV R11, RSP - Save stack pointer to R11 (caller-saved, safe scratch)
// Encoding: 4C 8B DC
Function.X86_MovR11Rsp {
    Body: {
        Emit_Byte(0x4C)    // 0x4C REX.WR
        Emit_Byte(0x8B)   // 0x8B MOV r64, r/m64
        Emit_Byte(0xDC)   // 0xDC ModRM: R11, RSP
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOV RSP, R11 - Restore stack pointer from R11
// Encoding: 4C 89 DC
Function.X86_MovRspR11 {
    Body: {
        Emit_Byte(0x4C)    // 0x4C REX.WR
        Emit_Byte(0x89)   // 0x89 MOV r/m64, r64
        Emit_Byte(0xDC)   // 0xDC ModRM: RSP, R11
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

