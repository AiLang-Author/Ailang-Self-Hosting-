        Emit_Byte(0x4D)    // 0x4D REX.WRB
        Emit_Byte(0x31)    // 0x31 XOR r/m64, r64
        Emit_Byte(0xC0)   // 0xC0 ModR/M: R8, R8
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}
// XOR R10, R10
Function.X86_XorR10R10 {
