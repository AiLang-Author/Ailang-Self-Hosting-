// =============================================================================
// ADD TO: Library.CEmitX86Reg.ailang
// Section: XOR reg, reg - Zero a register efficiently
// =============================================================================

// XOR R9, R9 (zero R9)
Function.X86_XorR9R9 {
    Body: {
        Emit_Byte(0x4D)    // 0x4D REX.WRB
        Emit_Byte(0x31)    // 0x31 XOR
        Emit_Byte(0xC9)   // 0xC9 ModR/M: R9, R9
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// RDI/RSI <- R13/R14
Function.X86_MovRdiR13 { Body: { X86_MovRegReg(Reg.RDI, Reg.R13) } }
Function.X86_MovRdiR14 { Body: { X86_MovRegReg(Reg.RDI, Reg.R14) } }
Function.X86_MovRsiR13 { Body: { X86_MovRegReg(Reg.RSI, Reg.R13) } }
Function.X86_MovRsiR14 { Body: { X86_MovRegReg(Reg.RSI, Reg.R14) } }
Function.X86_MovRbxRcx { Body: { X86_MovRegReg(Reg.RBX, Reg.RCX) } }
Function.X86_MovRsiRcx { Body: { X86_MovRegReg(Reg.RSI, Reg.RCX) } }
Function.X86_MovRdxRcx { Body: { X86_MovRegReg(Reg.RDX, Reg.RCX) } }
Function.X86_MovRdiRcx { Body: { X86_MovRegReg(Reg.RDI, Reg.RCX) } }


// XOR RSI, RSI
Function.X86_XorRsiRsi {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x31)    // 0x31 XOR r/m64, r64
        Emit_Byte(0xF6)   // 0xF6 ModR/M: RSI, RSI
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

