// Library.FPUTypes.ailang
// Type definitions and constants for FPU/SIMD operations
// Location: Librarys/Compiler/Compile/FPU/Library.FPUTypes.ailang
//
// Self-contained - no imports from CCompileMain
// Can be tested standalone

// =============================================================================
// XMM REGISTER INDICES (x86-64 SSE/AVX)
// =============================================================================
FixedPool.XMM {
    "XMM0": Initialize=0, CanChange=False
    "XMM1": Initialize=1, CanChange=False
    "XMM2": Initialize=2, CanChange=False
    "XMM3": Initialize=3, CanChange=False
    "XMM4": Initialize=4, CanChange=False
    "XMM5": Initialize=5, CanChange=False
    "XMM6": Initialize=6, CanChange=False
    "XMM7": Initialize=7, CanChange=False
    "XMM8": Initialize=8, CanChange=False
    "XMM9": Initialize=9, CanChange=False
    "XMM10": Initialize=10, CanChange=False
    "XMM11": Initialize=11, CanChange=False
    "XMM12": Initialize=12, CanChange=False
    "XMM13": Initialize=13, CanChange=False
    "XMM14": Initialize=14, CanChange=False
    "XMM15": Initialize=15, CanChange=False
}

// =============================================================================
// FLOAT OPERATION CODES
// Used by compile layer to select emit function
// =============================================================================
FixedPool.FloatOp {
    "ADD": Initialize=0, CanChange=False
    "SUB": Initialize=1, CanChange=False
    "MUL": Initialize=2, CanChange=False
    "DIV": Initialize=3, CanChange=False
    "SQRT": Initialize=4, CanChange=False
    "MIN": Initialize=5, CanChange=False
    "MAX": Initialize=6, CanChange=False
    "ABS": Initialize=7, CanChange=False
    "NEG": Initialize=8, CanChange=False
}

// =============================================================================
// FLOAT COMPARISON CODES
// =============================================================================
FixedPool.FloatCmp {
    "EQ": Initialize=0, CanChange=False
    "NE": Initialize=1, CanChange=False
    "LT": Initialize=2, CanChange=False
    "LE": Initialize=3, CanChange=False
    "GT": Initialize=4, CanChange=False
    "GE": Initialize=5, CanChange=False
}

// =============================================================================
// VECTOR SIZES
// =============================================================================
FixedPool.VecSize {
    "VEC2": Initialize=2, CanChange=False
    "VEC3": Initialize=3, CanChange=False
    "VEC4": Initialize=4, CanChange=False
}

// =============================================================================
// TYPE SIZES IN BYTES (for allocation)
// =============================================================================
FixedPool.FPUSize {
    "FLOAT": Initialize=8, CanChange=False      // 64-bit double
    "VEC2": Initialize=16, CanChange=False      // 2 doubles
    "VEC3": Initialize=24, CanChange=False      // 3 doubles (or 32 aligned)
    "VEC4": Initialize=32, CanChange=False      // 4 doubles
    "MAT3": Initialize=72, CanChange=False      // 9 doubles
    "MAT4": Initialize=128, CanChange=False     // 16 doubles
    "QUAT": Initialize=32, CanChange=False      // 4 doubles
}

// =============================================================================
// SSE INSTRUCTION PREFIXES (for emit layer reference)
// =============================================================================
FixedPool.SSEPrefix {
    "NONE": Initialize=0, CanChange=False
    "P_66": Initialize=102, CanChange=False     // 0x66 - packed double / integer
    "P_F2": Initialize=242, CanChange=False     // 0xF2 - scalar double
    "P_F3": Initialize=243, CanChange=False     // 0xF3 - scalar single / MOVDQU
}

// =============================================================================
// FPU STATE (minimal, for standalone testing)
// Main compiler uses Emit.* from CEmitTypes instead
// =============================================================================
FixedPool.FPUState {
    "enabled": Initialize=1, CanChange=True     // SIMD paths enabled
    "xmm_in_use": Initialize=0, CanChange=True  // Bitmask of allocated XMM regs
}