// Library.FPUCompileX86AVX.ailang
// X86-64 SSE4.1 / AVX / FMA3 operation compilation
// Location: Librarys/Compiler/Compile/FPU/X86/Library.FPUCompileX86AVX.ailang
//
// Compiles Packed_*, Float_FMA*, Float_Floor/Ceil/Trunc, DotProduct
// operations to SSE4.1/AVX/FMA3 instructions.
//
// Convention matches FPUCompileX86SSE.ailang:
//   - All user-facing functions take consistent arg counts
//   - Results returned in RAX (integer) or XMM0→RAX (float bits)
//   - Dispatcher returns 1 if handled, 0 if not recognized

LibraryImport.XArrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.FPU.FPUTypes
LibraryImport.Compiler.Compile.FPU.X86.FPUEmitX86AVX

// =============================================================================
// MAIN DISPATCHER
// Returns 1 if handled, 0 if not an AVX/SSE4/FMA operation
// =============================================================================
Function.FPUCompileX86AVX_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }

        func_name = AST_GetData1(node)
        IfCondition EqualTo(func_name, 0) ThenBlock: {
            ReturnValue(0)
        }

        // ─────────────────────────────────────────────────────────────────
        // Packed 32-bit Integer Arithmetic (SSE4.1)
        // Pattern: Packed_Op(addr_a, addr_b) → 4 × 32-bit result at addr_a
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Packed_MulI32")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedBinOpI32(node, 0))
        }

        cmp = StringCompare(func_name, "Packed_AddI32")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedBinOpI32(node, 1))
        }

        cmp = StringCompare(func_name, "Packed_SubI32")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedBinOpI32(node, 2))
        }

        cmp = StringCompare(func_name, "Packed_MinI32")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedBinOpI32(node, 3))
        }

        cmp = StringCompare(func_name, "Packed_MaxI32")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedBinOpI32(node, 4))
        }

        // ─────────────────────────────────────────────────────────────────
        // Packed 32-bit Integer — Unary / Special
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Packed_AbsI32")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedAbsI32(node))
        }

        cmp = StringCompare(func_name, "Packed_MaddWD")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedMaddWD(node))
        }

        // ─────────────────────────────────────────────────────────────────
        // Packed 32-bit Integer — Horizontal Sum (reduce 4 lanes to scalar)
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Packed_SumI32")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedSumI32(node))
        }

        // ─────────────────────────────────────────────────────────────────
        // Packed Load / Store
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Packed_Load128")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedLoad128(node))
        }

        cmp = StringCompare(func_name, "Packed_Store128")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedStore128(node))
        }

        // ─────────────────────────────────────────────────────────────────
        // Float Rounding (SSE4.1 — explicit floor/ceil/trunc)
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Float_Floor")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_FloatRoundMode(node, 1))
        }

        cmp = StringCompare(func_name, "Float_Ceil")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_FloatRoundMode(node, 2))
        }

        cmp = StringCompare(func_name, "Float_Trunc")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_FloatRoundMode(node, 3))
        }

        // ─────────────────────────────────────────────────────────────────
        // Float FMA (Fused Multiply-Add) — 3 arguments
        // Float_FMA(a, b, c) = a * b + c  (single rounding)
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Float_FMA")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_FloatFMA(node, 0))
        }

        cmp = StringCompare(func_name, "Float_FMS")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_FloatFMA(node, 1))
        }

        cmp = StringCompare(func_name, "Float_FNMA")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_FloatFMA(node, 2))
        }

        // ─────────────────────────────────────────────────────────────────
        // Float Dot Product (SSE4.1 DPPD)
        // Float_DotPD(a_ptr, b_ptr) — dot product of 2-element double vectors
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Float_DotPD")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_FloatDotPD(node))
        }

        // ─────────────────────────────────────────────────────────────────
        // Packed Integer Compare
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Packed_EqI32")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedCmpI32(node, 0))
        }

        cmp = StringCompare(func_name, "Packed_GtI32")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedCmpI32(node, 1))
        }

        // ─────────────────────────────────────────────────────────────────
        // Packed Test (SSE4.1 PTEST — sets ZF/CF, returns 0/1)
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Packed_TestZero")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedTestZero(node))
        }

        // ─────────────────────────────────────────────────────────────────
        // Sign/Zero Extend (SSE4.1)
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Packed_SignExtWD")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedExtend(node, 0))
        }

        cmp = StringCompare(func_name, "Packed_ZeroExtWD")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AVX_PackedExtend(node, 1))
        }

        // Not an AVX/SSE4/FMA operation
        ReturnValue(0)
    }
}

// =============================================================================
// PACKED 32-BIT INTEGER BINARY OPS
// Packed_Op(addr_a, addr_b)
// Loads 128 bits from addr_a and addr_b, operates, stores result to addr_a
// Returns addr_a in RAX
// op: 0=MUL, 1=ADD, 2=SUB, 3=MIN, 4=MAX
// =============================================================================
Function.AVX_PackedBinOpI32 {
    Input: node: Address
    Input: op: Integer
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[AVX] Packed integer op requires 2 arguments (addr_a, addr_b)\n")
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        // Compile addr_a -> RAX, push it
        Compile_Expression(arg0)
        Emit_PushRax()

        // Compile addr_b -> RAX
        Compile_Expression(arg1)
        // Load 128 bits from addr_b into XMM1
        X86_MOVDQU_XMM1_DerefRax()

        // Pop addr_a into RAX, load into XMM0
        Emit_PopRax()
        Emit_PushRax()              // keep addr_a for writeback
        X86_MOVDQU_XMM0_DerefRax()

        // Operate
        IfCondition EqualTo(op, 0) ThenBlock: { X86_PMULLD_XMM0_XMM1() }
        IfCondition EqualTo(op, 1) ThenBlock: { X86_PADDD_XMM0_XMM1() }
        IfCondition EqualTo(op, 2) ThenBlock: { X86_PSUBD_XMM0_XMM1() }
        IfCondition EqualTo(op, 3) ThenBlock: { X86_PMINSD_XMM0_XMM1() }
        IfCondition EqualTo(op, 4) ThenBlock: { X86_PMAXSD_XMM0_XMM1() }

        // Store result to addr_a
        Emit_PopRax()
        X86_MOVDQU_DerefRax_XMM0()

        // Return addr_a in RAX (already there)
        ReturnValue(1)
    }
}

// =============================================================================
// PACKED 32-BIT INTEGER ABS
// Packed_AbsI32(addr) — in-place absolute value of 4×32-bit at addr
// =============================================================================
Function.AVX_PackedAbsI32 {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[AVX] Packed_AbsI32 requires 1 argument\n")
            ReturnValue(0)
        }

        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)
        Emit_PushRax()

        // Load 128 bits from [RAX] into XMM1
        X86_MOVDQU_XMM1_DerefRax()

        // PABSD XMM0, XMM1
        X86_PABSD_XMM0_XMM1()

        // Store result back
        Emit_PopRax()
        X86_MOVDQU_DerefRax_XMM0()

        ReturnValue(1)
    }
}

// =============================================================================
// PACKED MULTIPLY-ADD WORD TO DWORD
// Packed_MaddWD(addr_a, addr_b)
// PMADDWD: 8×16-bit multiply, adjacent pair add → 4×32-bit
// Stores result at addr_a, returns addr_a
// =============================================================================
Function.AVX_PackedMaddWD {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[AVX] Packed_MaddWD requires 2 arguments\n")
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        Compile_Expression(arg0)
        Emit_PushRax()

        Compile_Expression(arg1)
        X86_MOVDQU_XMM1_DerefRax()

        Emit_PopRax()
        Emit_PushRax()
        X86_MOVDQU_XMM0_DerefRax()

        X86_PMADDWD_XMM0_XMM1()

        Emit_PopRax()
        X86_MOVDQU_DerefRax_XMM0()

        ReturnValue(1)
    }
}

// =============================================================================
// PACKED HORIZONTAL SUM
// Packed_SumI32(addr) — sum 4×32-bit lanes into scalar, return in RAX
// Uses PSHUFD + PADDD to reduce
// =============================================================================
Function.AVX_PackedSumI32 {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[AVX] Packed_SumI32 requires 1 argument\n")
            ReturnValue(0)
        }

        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)

        // Load 128 bits from [RAX] into XMM0
        X86_MOVDQU_XMM0_DerefRax()

        // XMM0 = [a, b, c, d]
        // Step 1: PSHUFD XMM1, XMM0, 0x4E  (swap high/low 64-bit halves)
        //   XMM1 = [c, d, a, b]
        X86_PSHUFD_XMM1_XMM0(0x4E)

        // Step 2: PADDD XMM0, XMM1 → XMM0 = [a+c, b+d, c+a, d+b]
        X86_PADDD_XMM0_XMM1()

        // Step 3: PSHUFD XMM1, XMM0, 0xB1  (swap adjacent 32-bit pairs)
        //   XMM1 = [b+d, a+c, d+b, c+a]
        X86_PSHUFD_XMM1_XMM0(0xB1)

        // Step 4: PADDD XMM0, XMM1 → low 32 = a+b+c+d
        X86_PADDD_XMM0_XMM1()

        // Extract low 32 bits to EAX
        X86_MOVD_EAX_XMM0()

        // Sign-extend EAX → RAX (MOVSXD RAX, EAX — 48 63 C0)
        Emit_Byte(0x48)
        Emit_Byte(0x63)
        Emit_Byte(0xC0)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)

        ReturnValue(1)
    }
}

// =============================================================================
// PACKED LOAD / STORE (explicit 128-bit unaligned)
// Packed_Load128(dest_addr, src_addr) — load 16 bytes from src to dest
// Packed_Store128(dest_addr, src_addr) — same (alias for symmetry)
// =============================================================================
Function.AVX_PackedLoad128 {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[AVX] Packed_Load128 requires 2 arguments (dest, src)\n")
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        // Compile dest -> push
        Compile_Expression(arg0)
        Emit_PushRax()

        // Compile src -> RAX, load from [RAX]
        Compile_Expression(arg1)
        X86_MOVDQU_XMM0_DerefRax()

        // Pop dest, store to [RAX]
        Emit_PopRax()
        X86_MOVDQU_DerefRax_XMM0()

        ReturnValue(1)
    }
}

Function.AVX_PackedStore128 {
    Input: node: Address
    Output: Integer
    Body: {
        // Same as Load128 — both copy 16 bytes from src to dest
        ReturnValue(AVX_PackedLoad128(node))
    }
}

// =============================================================================
// FLOAT ROUNDING (SSE4.1 ROUNDSD)
// Float_Floor(x), Float_Ceil(x), Float_Trunc(x)
// mode: 0=nearest, 1=floor, 2=ceil, 3=truncate
// =============================================================================
Function.AVX_FloatRoundMode {
    Input: node: Address
    Input: mode: Integer
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[AVX] Float rounding requires 1 argument\n")
            ReturnValue(0)
        }

        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)       // float bits in RAX
        X86_MOVQ_XMM0_RAX()
        X86_MOVSD_XMM1_XMM0()

        // ROUNDSD XMM0, XMM1, mode
        X86_ROUNDSD_XMM0_XMM1(mode)

        // Result bits back to RAX
        X86_MOVQ_RAX_XMM0()

        ReturnValue(1)
    }
}

// =============================================================================
// FLOAT FMA (Fused Multiply-Add)
// Float_FMA(a, b, c)  = a * b + c   (VFMADD231SD)
// Float_FMS(a, b, c)  = a * b - c   (VFMSUB231SD)
// Float_FNMA(a, b, c) = -(a * b) + c (VFNMADD231SD)
//
// All 3 arguments are float-bits in RAX.
// fma_type: 0=FMA, 1=FMS, 2=FNMA
// =============================================================================
Function.AVX_FloatFMA {
    Input: node: Address
    Input: fma_type: Integer
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            PrintMessage("[AVX] Float_FMA/FMS/FNMA requires 3 arguments (a, b, c)\n")
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        arg2 = AST_GetChild(node, 2)

        // Compile c (accumulator) -> XMM0 (destination in 231 form)
        Compile_Expression(arg2)
        X86_MOVQ_XMM0_RAX()
        X86_PushXMM0()

        // Compile a -> XMM1 (first multiply operand)
        Compile_Expression(arg0)
        X86_MOVQ_XMM0_RAX()
        X86_PushXMM0()

        // Compile b -> XMM2 (second multiply operand)
        Compile_Expression(arg1)
        X86_MOVQ_XMM0_RAX()
        X86_MOVDQA_XMM2_XMM0()

        // Pop a -> XMM1
        X86_PopXMM0()
        X86_MOVSD_XMM1_XMM0()

        // Pop c -> XMM0
        X86_PopXMM0()

        // VFMADD231SD XMM0, XMM1, XMM2: XMM0 = XMM1*XMM2 + XMM0
        IfCondition EqualTo(fma_type, 0) ThenBlock: { X86_VFMADD231SD_XMM0_XMM1_XMM2() }
        IfCondition EqualTo(fma_type, 1) ThenBlock: { X86_VFMSUB231SD_XMM0_XMM1_XMM2() }
        IfCondition EqualTo(fma_type, 2) ThenBlock: { X86_VFNMADD231SD_XMM0_XMM1_XMM2() }

        // Result bits back to RAX
        X86_MOVQ_RAX_XMM0()

        ReturnValue(1)
    }
}

// =============================================================================
// FLOAT DOT PRODUCT (SSE4.1 DPPD)
// Float_DotPD(addr_a, addr_b) — dot product of 2-element double vector
// Returns scalar double bits in RAX
// =============================================================================
Function.AVX_FloatDotPD {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[AVX] Float_DotPD requires 2 arguments\n")
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        // Load first vector from [arg0]
        Compile_Expression(arg0)
        Emit_MovRdiRax()
        X86_MOVDQU_XMM0_DerefRdi()
        X86_PushXMM0()

        // Load second vector from [arg1]
        Compile_Expression(arg1)
        Emit_MovRdiRax()
        // MOVDQU XMM1, [RDI] — F3 0F 6F 0F
        Emit_Byte(0xF3)
        Emit_Byte(0x0F)
        Emit_Byte(0x6F)
        Emit_Byte(0x0F)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)

        X86_PopXMM0()

        // DPPD XMM0, XMM1, 0x31
        //   bits [5:4]=11 = use both input elements
        //   bits [1:0]=01 = result in low element only
        X86_DPPD_XMM0_XMM1(0x31)

        // Result (scalar double) in low 64 bits of XMM0
        X86_MOVQ_RAX_XMM0()

        ReturnValue(1)
    }
}

// =============================================================================
// PACKED INTEGER COMPARE
// Packed_EqI32(addr_a, addr_b) — compare equal, store mask at addr_a
// Packed_GtI32(addr_a, addr_b) — compare greater, store mask at addr_a
// cmp_type: 0=EQ, 1=GT
// =============================================================================
Function.AVX_PackedCmpI32 {
    Input: node: Address
    Input: cmp_type: Integer
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[AVX] Packed compare requires 2 arguments\n")
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        Compile_Expression(arg0)
        Emit_PushRax()

        Compile_Expression(arg1)
        X86_MOVDQU_XMM1_DerefRax()

        Emit_PopRax()
        Emit_PushRax()
        X86_MOVDQU_XMM0_DerefRax()

        IfCondition EqualTo(cmp_type, 0) ThenBlock: { X86_PCMPEQD_XMM0_XMM1() }
        IfCondition EqualTo(cmp_type, 1) ThenBlock: { X86_PCMPGTD_XMM0_XMM1() }

        Emit_PopRax()
        X86_MOVDQU_DerefRax_XMM0()

        ReturnValue(1)
    }
}

// =============================================================================
// PACKED TEST ZERO (SSE4.1 PTEST)
// Packed_TestZero(addr) — returns 1 if all 128 bits are zero, 0 otherwise
// =============================================================================
Function.AVX_PackedTestZero {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[AVX] Packed_TestZero requires 1 argument\n")
            ReturnValue(0)
        }

        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)

        // Load 128 bits from [RAX]
        X86_MOVDQU_XMM0_DerefRax()

        // Copy XMM0 → XMM1 so PTEST XMM0, XMM1 acts as PTEST XMM0, XMM0
        X86_MOVDQA_XMM1_XMM0()

        // PTEST XMM0, XMM1 — ZF=1 if (XMM0 AND XMM1)==0, i.e. all zero
        X86_PTEST_XMM0_XMM1()

        // Zero RAX, then SETE AL (ZF=1 → AL=1)
        Emit_Byte(0x48)   // MOV RAX, 0
        Emit_Byte(0xC7)
        Emit_Byte(0xC0)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit_Byte(0x00)

        Emit_Sete()
        Emit_MovzxRaxAl()

        ReturnValue(1)
    }
}

// =============================================================================
// PACKED SIGN/ZERO EXTEND
// Packed_SignExtWD(addr) — sign-extend 4×16-bit to 4×32-bit in-place
// Packed_ZeroExtWD(addr) — zero-extend 4×16-bit to 4×32-bit in-place
// Reads low 64 bits of [addr], extends to full 128 bits, writes back
// ext_type: 0=signed, 1=unsigned
// =============================================================================
Function.AVX_PackedExtend {
    Input: node: Address
    Input: ext_type: Integer
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[AVX] Packed extend requires 1 argument\n")
            ReturnValue(0)
        }

        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)
        Emit_PushRax()

        // Load 128 bits (only low 64 used by PMOVSX/PMOVZX)
        X86_MOVDQU_XMM1_DerefRax()

        IfCondition EqualTo(ext_type, 0) ThenBlock: { X86_PMOVSXWD_XMM0_XMM1() }
        IfCondition EqualTo(ext_type, 1) ThenBlock: { X86_PMOVZXWD_XMM0_XMM1() }

        Emit_PopRax()
        X86_MOVDQU_DerefRax_XMM0()

        ReturnValue(1)
    }
}
