// Library.FPUCompileX86FixedPoint.ailang
// X86-64 Fixed-Point Arithmetic Compiler Primitives
// Location: Librarys/Compiler/Compile/FPU/X86/Library.FPUCompileX86FixedPoint.ailang
//
// Two unified primitives with size as argument:
//   FixedMul(a, b, bits) -> (a * b) >> bits
//   FixedDiv(a, b, bits) -> (a << bits) / b   (direct IDIV, exact, signed)
//
// Where 'bits' is the fractional width: 8, 16, 32, or 64
//
// Format table:
//   bits=8  -> Q8.8   (16-bit values, 32-bit intermediate)
//   bits=16 -> Q16.16 (32-bit values, 64-bit intermediate)
//   bits=32 -> Q32.32 (64-bit values, 128-bit intermediate)
//   bits=64 -> Q64.64 (64-bit values, 128-bit intermediate)
//
// The size argument MUST be a compile-time constant (literal integer).
// Non-constant sizes are rejected at compile time.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.FPU.FPUTypes
LibraryImport.Compiler.Compile.FPU.X86.FPUCompileX86Trans

// =============================================================================
// MAIN DISPATCHER
// =============================================================================
Function.FPUCompileX86FixedPoint_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }

        func_name = AST_GetData1(node)
        IfCondition EqualTo(func_name, 0) ThenBlock: {
            ReturnValue(0)
        }

        cmp = StringCompare(func_name, "FixedMul")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FixedMul(node))
        }

        cmp = StringCompare(func_name, "FixedDiv")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FixedDiv(node))
        }

        ReturnValue(0)
    }
}

// =============================================================================
// FixedMul(a, b, bits)
//
// Unified fixed-point multiplication.
// Result = (a * b) >> bits
//
// Strategy by size:
//   bits=8:  IMUL EAX, ECX (32-bit) then SAR EAX, 8 then MOVSXD
//   bits=16: IMUL RAX, RCX (64-bit) then SAR RAX, 16
//   bits=32: IMUL RCX (128-bit RDX:RAX) then SHRD RAX, RDX, 32
//   bits=64: IMUL RCX (128-bit RDX:RAX) then MOV RAX, RDX (take high 64)
// =============================================================================
Function.FPUCompileX86_FixedMul {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            PrintMessage("[FPU] FixedMul requires 3 arguments: FixedMul(a, b, bits)\n")
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        arg2 = AST_GetChild(node, 2)

        // arg2 (bits) must be a compile-time number literal
        bits_type = AST_GetType(arg2)
        IfCondition NotEqual(bits_type, AST.NUMBER) ThenBlock: {
            PrintMessage("[FPU] FixedMul: bits argument must be a compile-time constant (8, 16, 32, or 64)\n")
            ReturnValue(0)
        }
        bits_str = AST_GetData1(arg2)
        bits = StringToNumber(bits_str)

        // Validate bits
        bits_valid = 0
        IfCondition EqualTo(bits, 8) ThenBlock: { bits_valid = 1 }
        IfCondition EqualTo(bits, 16) ThenBlock: { bits_valid = 1 }
        IfCondition EqualTo(bits, 32) ThenBlock: { bits_valid = 1 }
        IfCondition EqualTo(bits, 64) ThenBlock: { bits_valid = 1 }
        IfCondition EqualTo(bits_valid, 0) ThenBlock: {
            PrintMessage("[FPU] FixedMul: bits must be 8, 16, 32, or 64\n")
            ReturnValue(0)
        }

        // Compile b, push to stack
        Compile_Expression(arg1)
        Emit_PushRax()

        // Compile a into RAX
        Compile_Expression(arg0)

        // Pop b into RCX
        Emit_PopRcx()

        // --- Dispatch by bit width ---
        Branch bits {
            Case 8: {
                // Q8.8: 32-bit multiply, shift right 8, sign-extend to 64-bit
                Trans_Asm("IMUL eax, ecx")
                Trans_Asm("SAR eax, 8")
                Trans_Asm("MOVSXD rax, eax")
            }
            Case 16: {
                // Q16.16: 64-bit multiply, shift right 16
                Trans_Asm("IMUL rax, rcx")
                Trans_Asm("SAR rax, 16")
            }
            Case 32: {
                // Q32.32: 128-bit multiply, extract bits [95:32]
                Trans_Asm("IMUL rcx")
                Trans_Asm("SHRD rax, rdx, 32")
            }
            Case 64: {
                // Q64.64: 128-bit multiply, take high 64 bits
                Trans_Asm("IMUL rcx")
                Emit_MovRaxRdx()
            }
        }

        // Result is now in RAX
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// FixedDiv(a, b, bits)
//
// Unified fixed-point division using direct IDIV (signed, exact).
// Result = (a << bits) / b
//
// This avoids the reciprocal multiply approach which has rounding errors
// and doesn't handle negative divisors correctly.
//
// Strategy by size:
//   bits=8:  RAX = a << 8;  CQO; IDIV RCX
//   bits=16: RAX = a << 16; CQO; IDIV RCX
//   bits=32: RDX:RAX = a << 32 (manual 128-bit shift); IDIV RCX
//   bits=64: RDX = a, RAX = 0 (= a << 64); IDIV RCX
//
// IDIV handles signed values correctly for all cases.
// Division by zero is guarded (returns 0).
// =============================================================================
Function.FPUCompileX86_FixedDiv {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            PrintMessage("[FPU] FixedDiv requires 3 arguments: FixedDiv(a, b, bits)\n")
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        arg2 = AST_GetChild(node, 2)

        // arg2 (bits) must be a compile-time number literal
        bits_type = AST_GetType(arg2)
        IfCondition NotEqual(bits_type, AST.NUMBER) ThenBlock: {
            PrintMessage("[FPU] FixedDiv: bits argument must be a compile-time constant (8, 16, 32, or 64)\n")
            ReturnValue(0)
        }
        bits_str = AST_GetData1(arg2)
        bits = StringToNumber(bits_str)

        // Validate bits
        bits_valid = 0
        IfCondition EqualTo(bits, 8) ThenBlock: { bits_valid = 1 }
        IfCondition EqualTo(bits, 16) ThenBlock: { bits_valid = 1 }
        IfCondition EqualTo(bits, 32) ThenBlock: { bits_valid = 1 }
        IfCondition EqualTo(bits, 64) ThenBlock: { bits_valid = 1 }
        IfCondition EqualTo(bits_valid, 0) ThenBlock: {
            PrintMessage("[FPU] FixedDiv: bits must be 8, 16, 32, or 64\n")
            ReturnValue(0)
        }

        // Labels
        zero_check_ok = Emit_CreateLabel()
        done_label = Emit_CreateLabel()

        // Compile b, push to stack
        Compile_Expression(arg1)
        Emit_PushRax()

        // Compile a into RAX
        Compile_Expression(arg0)

        // Pop b into RCX
        Emit_PopRcx()

        // Zero check on divisor (b in RCX)
        Trans_Asm("TEST rcx, rcx")
        Emit_Jne(zero_check_ok)
        // Division by zero: return 0
        Trans_Asm("XOR rax, rax")
        Emit_Jmp(done_label)

        Emit_MarkLabel(zero_check_ok)

        // --- Direct IDIV approach: (a << bits) / b ---
        // a is in RAX, b is in RCX
        Branch bits {
            Case 8: {
                // Q8.8: RAX = a << 8, sign-extend to RDX:RAX, IDIV RCX
                Trans_Asm("SHL rax, 8")
                X86_Cqo()
                Trans_Asm("IDIV rcx")
            }
            Case 16: {
                // Q16.16: RAX = a << 16, sign-extend to RDX:RAX, IDIV RCX
                Trans_Asm("SHL rax, 16")
                X86_Cqo()
                Trans_Asm("IDIV rcx")
            }
            Case 32: {
                // Q32.32: RDX:RAX = a << 32 (manual 128-bit shift)
                // RAX has a; split into RDX:RAX where:
                //   RAX = a << 32 (low 64 bits)
                //   RDX = a >> 32 (high 64 bits, arithmetic for sign)
                Trans_Asm("MOV rdx, rax")
                Trans_Asm("SHL rax, 32")
                Trans_Asm("SAR rdx, 32")
                Trans_Asm("IDIV rcx")
            }
            Case 64: {
                // Q64.64: RDX:RAX = a << 64
                // RDX = a (entire value becomes high qword)
                // RAX = 0
                Trans_Asm("MOV rdx, rax")
                Trans_Asm("XOR rax, rax")
                Trans_Asm("IDIV rcx")
            }
        }

        Emit_MarkLabel(done_label)

        // Result is in RAX
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}
