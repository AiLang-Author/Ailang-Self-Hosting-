// Library.FPUCompileX86SSE.ailang
// X86-64 SSE2 float/vector operation compilation
// Location: Librarys/Compiler/Compile/FPU/X86/Library.FPUCompileX86SSE.ailang
//
// Compiles Float_*, Vec2_*, Vec3_* operations to SSE2 instructions
// Called from CCompileMain when Emit.target == Arch.X86_64

LibraryImport.XArrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.FPU.FPUTypes


// =============================================================================
// MAIN DISPATCHER
// Returns 1 if handled, 0 if not a float/vector operation
// =============================================================================
Function.FPUCompileX86_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        func_name = AST_GetData1(node)
        IfCondition EqualTo(func_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Float Arithmetic
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Float_Add")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatBinOp(node, FloatOp.ADD))
        }
        
        cmp = StringCompare(func_name, "Float_Sub")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatBinOp(node, FloatOp.SUB))
        }
        
        cmp = StringCompare(func_name, "Float_Mul")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatBinOp(node, FloatOp.MUL))
        }
        
        cmp = StringCompare(func_name, "Float_Div")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatBinOp(node, FloatOp.DIV))
        }
        
        cmp = StringCompare(func_name, "Float_Min")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatBinOp(node, FloatOp.MIN))
        }
        
        cmp = StringCompare(func_name, "Float_Max")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatBinOp(node, FloatOp.MAX))
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Float Unary
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Float_Sqrt")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatSqrt(node))
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Conversions
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Float_FromInt")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatFromInt(node))
        }
        
        cmp = StringCompare(func_name, "Float_ToInt")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatToInt(node))
        }
        
        cmp = StringCompare(func_name, "Float_Round")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatRound(node))
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Float Comparison
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Float_Eq")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatCmp(node, FloatCmp.EQ))
        }
        
        cmp = StringCompare(func_name, "Float_Ne")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatCmp(node, FloatCmp.NE))
        }
        
        cmp = StringCompare(func_name, "Float_Lt")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatCmp(node, FloatCmp.LT))
        }
        
        cmp = StringCompare(func_name, "Float_Gt")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatCmp(node, FloatCmp.GT))
        }
        
        cmp = StringCompare(func_name, "Float_Le")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatCmp(node, FloatCmp.LE))
        }
        
        cmp = StringCompare(func_name, "Float_Ge")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_FloatCmp(node, FloatCmp.GE))
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Vec2 Operations (packed double in XMM)
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "Vec2_Add")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_Vec2BinOp(node, FloatOp.ADD))
        }
        
        cmp = StringCompare(func_name, "Vec2_Sub")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_Vec2BinOp(node, FloatOp.SUB))
        }
        
        cmp = StringCompare(func_name, "Vec2_Mul")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_Vec2BinOp(node, FloatOp.MUL))
        }
        
        cmp = StringCompare(func_name, "Vec2_Dot")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_Vec2Dot(node))
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Math Primitives - Short names
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "ISqrt")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_ISqrt(node))
        }
        
        cmp = StringCompare(func_name, "Abs")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_Abs(node))
        }
        
        cmp = StringCompare(func_name, "Min")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_Min(node))
        }
        
        cmp = StringCompare(func_name, "Max")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_Max(node))
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Math Primitives - Verbose names (aliases)
        // ─────────────────────────────────────────────────────────────────
        cmp = StringCompare(func_name, "SquareRoot")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_ISqrt(node))
        }
        
        cmp = StringCompare(func_name, "IntegerSquareRoot")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_ISqrt(node))
        }
        
        cmp = StringCompare(func_name, "AbsoluteValue")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_Abs(node))
        }
        
        cmp = StringCompare(func_name, "Minimum")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_Min(node))
        }
        
        cmp = StringCompare(func_name, "Maximum")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_Max(node))
        }
        
        // Not a float/vector operation
        ReturnValue(0)
    }
}

// =============================================================================
// FLOAT BINARY OPERATIONS
// Pattern: arg0 -> XMM0, arg1 -> XMM1, op, result in XMM0
// =============================================================================


Function.FPUCompileX86_FloatBinOp {
    Input: node: Address
    Input: op: Integer
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Float binary op requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Compile first arg -> RAX (float bits), bitwise load to XMM0
        Compile_Expression(arg0)
        X86_MOVQ_XMM0_RAX()
        X86_PushXMM0()
        
        // Compile second arg -> RAX (float bits), bitwise load
        Compile_Expression(arg1)
        X86_MOVQ_XMM0_RAX()
        X86_MOVSD_XMM1_XMM0()
        
        // Restore first arg to XMM0
        X86_PopXMM0()
        
        // Emit operation
        IfCondition EqualTo(op, FloatOp.ADD) ThenBlock: { X86_ADDSD_XMM0_XMM1() }
        IfCondition EqualTo(op, FloatOp.SUB) ThenBlock: { X86_SUBSD_XMM0_XMM1() }
        IfCondition EqualTo(op, FloatOp.MUL) ThenBlock: { X86_MULSD_XMM0_XMM1() }
        IfCondition EqualTo(op, FloatOp.DIV) ThenBlock: { X86_DIVSD_XMM0_XMM1() }
        IfCondition EqualTo(op, FloatOp.MIN) ThenBlock: { X86_MINSD_XMM0_XMM1() }
        IfCondition EqualTo(op, FloatOp.MAX) ThenBlock: { X86_MAXSD_XMM0_XMM1() }
        
        // Result bits back to RAX (bitwise, no truncation)
        X86_MOVQ_RAX_XMM0()
        
        ReturnValue(1)
    }
}

// =============================================================================
// FLOAT SQRT
// =============================================================================
Function.FPUCompileX86_FloatSqrt {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[FPU] Float_Sqrt requires 1 argument\n")
            ReturnValue(0)
        }
        
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)
        X86_CVTSI2SD_XMM0_RAX()
        X86_SQRTSD_XMM0()
        X86_CVTTSD2SI_RAX_XMM0()
        
        ReturnValue(1)
    }
}

// =============================================================================
// FLOAT CONVERSIONS
// =============================================================================


Function.FPUCompileX86_FloatFromInt {
    Input: node: Address
    Output: Integer
    Body: {
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)       // integer in RAX
        X86_CVTSI2SD_XMM0_RAX()      // convert int64 → double in XMM0
        X86_MOVQ_RAX_XMM0()          // store float bits in RAX
        ReturnValue(1)
    }
}


Function.FPUCompileX86_FloatToInt {
    Input: node: Address
    Output: Integer
    Body: {
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)       // float bits in RAX
        X86_MOVQ_XMM0_RAX()          // load bits into XMM0
        X86_CVTTSD2SI_RAX_XMM0()     // truncate double → int64 in RAX
        ReturnValue(1)
    }
}


Function.FPUCompileX86_FloatRound {
    Input: node: Address
    Output: Integer
    Body: {
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)       // float bits in RAX
        X86_MOVQ_XMM0_RAX()          // load bits into XMM0
        X86_CVTSD2SI_RAX_XMM0()      // round double → int64 in RAX
        ReturnValue(1)
    }
}

// =============================================================================
// FLOAT COMPARISON
// Pattern: Compare XMM0 vs XMM1, set RAX to 0 or 1
//
// UCOMISD XMM0, XMM1 compares XMM0 to XMM1:
//   XMM0 > XMM1:  ZF=0, CF=0  -> SETA  (above)
//   XMM0 < XMM1:  ZF=0, CF=1  -> SETB  (below)
//   XMM0 == XMM1: ZF=1, CF=0  -> SETE  (equal)
//   Unordered:    ZF=1, CF=1, PF=1
// =============================================================================
Function.FPUCompileX86_FloatCmp {
    Input: node: Address
    Input: cmp_type: Integer
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Float comparison requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Compile first arg -> XMM0
        Compile_Expression(arg0)
        X86_CVTSI2SD_XMM0_RAX()
        X86_PushXMM0()
        
        // Compile second arg -> XMM1
        Compile_Expression(arg1)
        X86_CVTSI2SD_XMM0_RAX()
        X86_MOVSD_XMM1_XMM0()
        
        // Restore first arg to XMM0
        X86_PopXMM0()
        
        // Zero RAX BEFORE compare (MOV doesn't affect flags)
        // MOV RAX, 0 = 48 C7 C0 00 00 00 00
        Emit_Byte(72)
        Emit_Byte(199)
        Emit_Byte(192)
        Emit_Byte(0)
        Emit_Byte(0)
        Emit_Byte(0)
        Emit_Byte(0)
        
        // NOW do the compare - flags will be preserved
        X86_UCOMISD_XMM0_XMM1()
        
        // Set AL based on comparison type
        // FloatCmp: EQ=0, NE=1, LT=2, LE=3, GT=4, GE=5
        Branch cmp_type {
            Case 0: { Emit_Sete() }
            Case 1: { Emit_Setne() }
            Case 2: { Emit_Setb() }
            Case 3: { Emit_Setbe() }
            Case 4: { Emit_Seta() }
            Case 5: { Emit_Setae() }
            Default: {
                PrintMessage("[FPU] Unknown comparison type: ")
                PrintNumber(cmp_type)
                PrintMessage("\n")
            }
        }
        
        // Zero-extend AL to RAX (MOVZX doesn't affect flags, but we already read them)
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}

// =============================================================================
// VEC2 BINARY OPERATIONS (Packed Double)
// Vec2 = 2 doubles packed in one XMM register
// =============================================================================
Function.FPUCompileX86_Vec2BinOp {
    Input: node: Address
    Input: op: Integer
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Vec2 binary op requires 2 arguments\n")
            ReturnValue(0)
        }
        
        // TODO: Implement Vec2 memory layout
        // For now, Vec2 would be a pointer to 16 bytes (2 doubles)
        // Load with MOVUPD, operate with ADDPD/SUBPD/MULPD
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Compile first arg (pointer to Vec2) -> RAX
        Compile_Expression(arg0)
        Emit_MovRdiRax()  // RDI = ptr to first Vec2
        
        // Load Vec2 from [RDI] into XMM0
        // MOVUPD XMM0, [RDI] - 66 0F 10 07
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(16)
        Emit_Byte(7)
        
        X86_PushXMM0()  // Save first vector (actually push 16 bytes)
        
        // Compile second arg
        Compile_Expression(arg1)
        Emit_MovRdiRax()
        
        // Load second Vec2 into XMM1
        // MOVUPD XMM1, [RDI] - 66 0F 10 0F
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(16)
        Emit_Byte(15)
        
        // Restore first to XMM0 (simplified - real impl needs 16-byte stack ops)
        X86_PopXMM0()
        
        // Packed double operation
        IfCondition EqualTo(op, FloatOp.ADD) ThenBlock: { X86_ADDPD_XMM0_XMM1() }
        IfCondition EqualTo(op, FloatOp.SUB) ThenBlock: { X86_SUBPD_XMM0_XMM1() }
        IfCondition EqualTo(op, FloatOp.MUL) ThenBlock: { X86_MULPD_XMM0_XMM1() }
        IfCondition EqualTo(op, FloatOp.DIV) ThenBlock: { X86_DIVPD_XMM0_XMM1() }
        
        // Result in XMM0 - need to store somewhere
        // TODO: Return pointer to result or use temp storage
        
        ReturnValue(1)
    }
}

// =============================================================================
// VEC2 DOT PRODUCT
// dot = a.x * b.x + a.y * b.y
// Using: MULPD then HADDPD (SSE3) or manual shuffle+add
// =============================================================================
Function.FPUCompileX86_Vec2Dot {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Vec2_Dot requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Load both Vec2s
        Compile_Expression(arg0)
        Emit_MovRdiRax()
        // MOVUPD XMM0, [RDI]
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(16)
        Emit_Byte(7)
        
        X86_PushXMM0()
        
        Compile_Expression(arg1)
        Emit_MovRdiRax()
        // MOVUPD XMM1, [RDI]
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(16)
        Emit_Byte(15)
        
        X86_PopXMM0()
        
        // XMM0 = [a.x, a.y], XMM1 = [b.x, b.y]
        // Multiply: XMM0 = [a.x*b.x, a.y*b.y]
        X86_MULPD_XMM0_XMM1()
        
        // Horizontal add: XMM0 = [a.x*b.x + a.y*b.y, ...]
        X86_HADDPD_XMM0_XMM0()
        
        // Result (scalar) is in low 64 bits of XMM0
        // Convert to integer for return
        X86_CVTTSD2SI_RAX_XMM0()
        
        ReturnValue(1)
    }
}

// =============================================================================
// MATH PRIMITIVES - SSE2 versions to replace fixed-point
// =============================================================================

// ISqrt(n) - Integer square root using SSE2
// Convert to float, sqrt, convert back - fast and accurate
Function.FPUCompileX86_ISqrt {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[FPU] ISqrt requires 1 argument\n")
            ReturnValue(0)
        }
        
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)  // Result in RAX
        
        // Convert int to double
        X86_CVTSI2SD_XMM0_RAX()
        
        // SQRTSD - hardware square root
        X86_SQRTSD_XMM0()
        
        // Convert back to int (truncate)
        X86_CVTTSD2SI_RAX_XMM0()
        
        ReturnValue(1)
    }
}

// Abs(n) - Absolute value
// For integers: use branchless (x ^ (x >> 63)) - (x >> 63)
// Or: convert to float, clear sign bit, convert back
Function.FPUCompileX86_Abs {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[FPU] Abs requires 1 argument\n")
            ReturnValue(0)
        }
        
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)  // Result in RAX
        
        // Branchless abs: 
        // RBX = RAX >> 63 (all 1s if negative, all 0s if positive)
        // RAX = (RAX ^ RBX) - RBX
        
        // MOV RBX, RAX
        Emit_MovRbxRax()
        
        // SAR RBX, 63 (arithmetic shift - fills with sign bit)
        // 48 C1 FB 3F
        Emit_Byte(72)
        Emit_Byte(193)
        Emit_Byte(251)
        Emit_Byte(63)
        
        // XOR RAX, RBX
        Emit_XorRaxRbx()
        
        // SUB RAX, RBX
        Emit_SubRaxRbx()
        
        ReturnValue(1)
    }
}

// Min(a, b) - Return minimum of two values
// Using SSE2 MINSD
Function.FPUCompileX86_Min {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Min requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Compile first arg -> XMM0
        Compile_Expression(arg0)
        X86_CVTSI2SD_XMM0_RAX()
        X86_PushXMM0()
        
        // Compile second arg -> XMM1
        Compile_Expression(arg1)
        X86_CVTSI2SD_XMM0_RAX()
        X86_MOVSD_XMM1_XMM0()
        
        X86_PopXMM0()
        
        // MINSD XMM0, XMM1 - XMM0 = min(XMM0, XMM1)
        X86_MINSD_XMM0_XMM1()
        
        // Convert back to int
        X86_CVTTSD2SI_RAX_XMM0()
        
        ReturnValue(1)
    }
}

// Max(a, b) - Return maximum of two values
// Using SSE2 MAXSD
Function.FPUCompileX86_Max {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Max requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Compile first arg -> XMM0
        Compile_Expression(arg0)
        X86_CVTSI2SD_XMM0_RAX()
        X86_PushXMM0()
        
        // Compile second arg -> XMM1
        Compile_Expression(arg1)
        X86_CVTSI2SD_XMM0_RAX()
        X86_MOVSD_XMM1_XMM0()
        
        X86_PopXMM0()
        
        // MAXSD XMM0, XMM1 - XMM0 = max(XMM0, XMM1)
        X86_MAXSD_XMM0_XMM1()
        
        // Convert back to int
        X86_CVTTSD2SI_RAX_XMM0()
        
        ReturnValue(1)
    }
}