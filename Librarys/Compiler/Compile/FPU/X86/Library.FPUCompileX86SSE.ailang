// FLOAT CONVERSIONS
// =============================================================================


Function.FPUCompileX86_FloatFromInt {
    Input: node: Address
    Output: Integer
    Body: {
        arg = AST_GetChild(node, 0)
        saved = OptState.xmm_out
        OptState.xmm_out = 0
        Compile_Expression(arg)
        OptState.xmm_out = saved
        Trans_Asm("CVTSI2SD xmm0, rax")
        ReturnValue(FPUCompileX86_FinishXmm(saved))
    }
}


Function.FPUCompileX86_FloatToInt {
    Input: node: Address
    Output: Integer
    Body: {
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)       // float bits in RAX
        Trans_Asm("MOVQ xmm0, rax")          // load bits into XMM0
        Trans_Asm("CVTTSD2SI rax, xmm0")     // truncate double → int64 in RAX
        ReturnValue(1)
    }
}


Function.FPUCompileX86_FloatRound {
    Input: node: Address
    Output: Integer
    Body: {
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)       // float bits in RAX
        Trans_Asm("MOVQ xmm0, rax")          // load bits into XMM0
        Trans_Asm("CVTSD2SI rax, xmm0")      // round double → int64 in RAX
        ReturnValue(1)
    }
}

// =============================================================================
// FLOAT COMPARISON
// Pattern: Compare XMM0 vs XMM1, set RAX to 0 or 1
//
// UCOMISD XMM0, XMM1 compares XMM0 to XMM1:
//   XMM0 > XMM1:  ZF=0, CF=0  -> SETA  (above)
//   XMM0 < XMM1:  ZF=0, CF=1  -> SETB  (below)
//   XMM0 == XMM1: ZF=1, CF=0  -> SETE  (equal)
//   Unordered:    ZF=1, CF=1, PF=1
// =============================================================================
Function.FPUCompileX86_FloatCmp {
    Input: node: Address
    Input: cmp_type: Integer
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Float comparison requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Compile first arg -> XMM0 (bitwise load - values are already double bits)
        Compile_Expression(arg0)
        Trans_Asm("MOVQ xmm0, rax")
        X86_PushXMM0()

        // Compile second arg -> XMM1 (bitwise load - values are already double bits)
        Compile_Expression(arg1)
        Trans_Asm("MOVQ xmm0, rax")
        Trans_Asm("MOVSD xmm1, xmm0")

        // Restore first arg to XMM0
        X86_PopXMM0()

        // Zero RAX and RCX BEFORE compare (MOV doesn't affect flags)
        // MOV RAX, 0 = 48 C7 C0 00 00 00 00
        Emit_Byte(72)
        Emit_Byte(199)
        Emit_Byte(192)
        Emit_Byte(0)
        Emit_Byte(0)
        Emit_Byte(0)
        Emit_Byte(0)
        // MOV RCX, 0 = 48 C7 C1 00 00 00 00
        Emit_Byte(72)
        Emit_Byte(199)
        Emit_Byte(193)
        Emit_Byte(0)
        Emit_Byte(0)
        Emit_Byte(0)
        Emit_Byte(0)

        // NOW do the compare - flags will be preserved
        Trans_Asm("UCOMISD xmm0, xmm1")

        // UCOMISD flag semantics:
        //   Ordered equal:    ZF=1, PF=0, CF=0
        //   Unordered (NaN):  ZF=1, PF=1, CF=1
        //   Greater:          ZF=0, PF=0, CF=0
        //   Less:             ZF=0, PF=0, CF=1
        //
        // IEEE 754: ALL comparisons involving NaN return false,
        // except NE which returns true.
        //
        // EQ:  return ZF && !PF   (SETE + SETNP + AND)
        // NE:  return !ZF || PF   (SETNE + SETP + OR)
        // LT:  return CF && !PF   (SETB + SETNP + AND)
        // LE:  return (CF||ZF) && !PF  (SETBE + SETNP + AND)
        // GT:  return !CF && !ZF  (SETA — already NaN-correct, returns 0)
        // GE:  return !CF         (SETAE — already NaN-correct, returns 0)

        // FloatCmp: EQ=0, NE=1, LT=2, LE=3, GT=4, GE=5
        Branch cmp_type {
            Case 0: {
                // Float_Eq: SETE AL; SETNP CL; AND AL, CL
                Emit_Sete()
                // SETNP CL = 0F 9B C1
                Emit_Byte(15)
                Emit_Byte(155)
                Emit_Byte(193)
                // AND AL, CL = 20 C8
                Emit_Byte(32)
                Emit_Byte(200)
            }
            Case 1: {
                // Float_Ne: SETNE AL; SETP CL; OR AL, CL
                Emit_Setne()
                // SETP CL = 0F 9A C1
                Emit_Byte(15)
                Emit_Byte(154)
                Emit_Byte(193)
                // OR AL, CL = 08 C8
                Emit_Byte(8)
                Emit_Byte(200)
            }
            Case 2: {
                // Float_Lt: SETB AL; SETNP CL; AND AL, CL
                Emit_Setb()
                // SETNP CL = 0F 9B C1
                Emit_Byte(15)
                Emit_Byte(155)
                Emit_Byte(193)
                // AND AL, CL = 20 C8
                Emit_Byte(32)
                Emit_Byte(200)
            }
            Case 3: {
                // Float_Le: SETBE AL; SETNP CL; AND AL, CL
                Emit_Setbe()
                // SETNP CL = 0F 9B C1
                Emit_Byte(15)
                Emit_Byte(155)
                Emit_Byte(193)
                // AND AL, CL = 20 C8
                Emit_Byte(32)
                Emit_Byte(200)
            }
            Case 4: {
                // Float_Gt: SETA — already NaN-correct (CF=0 && ZF=0, both fail for NaN)
                Emit_Seta()
            }
            Case 5: {
                // Float_Ge: SETAE — already NaN-correct (CF=0, fails for NaN since CF=1)
                Emit_Setae()
            }
            Default: {
                PrintMessage("[FPU] Unknown comparison type: ")
                PrintNumber(cmp_type)
                PrintMessage("\n")
            }
        }

        // Zero-extend AL to RAX (MOVZX doesn't affect flags, but we already read them)
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}

// =============================================================================
// VEC2 BINARY OPERATIONS (Packed Double)
// Vec2 = 2 doubles packed in one XMM register
// =============================================================================
Function.FPUCompileX86_Vec2BinOp {
    Input: node: Address
    Input: op: Integer
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Vec2 binary op requires 2 arguments\n")
            ReturnValue(0)
        }
        
        // TODO: Implement Vec2 memory layout
        // For now, Vec2 would be a pointer to 16 bytes (2 doubles)
        // Load with MOVUPD, operate with ADDPD/SUBPD/MULPD
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Compile first arg (pointer to Vec2) -> RAX
        Compile_Expression(arg0)
        Emit_MovRdiRax()  // RDI = ptr to first Vec2
        
        // Load Vec2 from [RDI] into XMM0
        // MOVUPD XMM0, [RDI] - 66 0F 10 07
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(16)
        Emit_Byte(7)
        
        X86_PushXMM0()  // Save first vector (actually push 16 bytes)
        
        // Compile second arg
        Compile_Expression(arg1)
        Emit_MovRdiRax()
        
        // Load second Vec2 into XMM1
        // MOVUPD XMM1, [RDI] - 66 0F 10 0F
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(16)
        Emit_Byte(15)
        
        // Restore first to XMM0 (simplified - real impl needs 16-byte stack ops)
        X86_PopXMM0()
        
        // Packed double operation
        IfCondition EqualTo(op, FloatOp.ADD) ThenBlock: { Trans_Asm("ADDPD xmm0, xmm1") }
        IfCondition EqualTo(op, FloatOp.SUB) ThenBlock: { Trans_Asm("SUBPD xmm0, xmm1") }
        IfCondition EqualTo(op, FloatOp.MUL) ThenBlock: { Trans_Asm("MULPD xmm0, xmm1") }
        IfCondition EqualTo(op, FloatOp.DIV) ThenBlock: { Trans_Asm("DIVPD xmm0, xmm1") }
        
        // Result in XMM0 - need to store somewhere
        // TODO: Return pointer to result or use temp storage
        
        ReturnValue(1)
    }
}

// =============================================================================
// VEC2 DOT PRODUCT
// dot = a.x * b.x + a.y * b.y
// Using: MULPD then HADDPD (SSE3) or manual shuffle+add
// =============================================================================
Function.FPUCompileX86_Vec2Dot {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Vec2_Dot requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Load both Vec2s
        Compile_Expression(arg0)
        Emit_MovRdiRax()
        // MOVUPD XMM0, [RDI]
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(16)
        Emit_Byte(7)
        
        X86_PushXMM0()
        
        Compile_Expression(arg1)
        Emit_MovRdiRax()
        // MOVUPD XMM1, [RDI]
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(16)
        Emit_Byte(15)
        
        X86_PopXMM0()
        
        // XMM0 = [a.x, a.y], XMM1 = [b.x, b.y]
        // Multiply: XMM0 = [a.x*b.x, a.y*b.y]
        Trans_Asm("MULPD xmm0, xmm1")
        
        // Horizontal add: XMM0 = [a.x*b.x + a.y*b.y, ...]
        Trans_Asm("HADDPD xmm0, xmm0")
        
        // Result (scalar) is in low 64 bits of XMM0
        // Convert to integer for return
        Trans_Asm("CVTTSD2SI rax, xmm0")
        
        ReturnValue(1)
    }
}

// =============================================================================
// MATH PRIMITIVES - SSE2 versions to replace fixed-point
// =============================================================================

// ISqrt(n) - Integer square root using SSE2
// Convert to float, sqrt, convert back - fast and accurate
Function.FPUCompileX86_ISqrt {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[FPU] ISqrt requires 1 argument\n")
            ReturnValue(0)
        }
        
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)  // Result in RAX
        
        // Convert int to double
        Trans_Asm("CVTSI2SD xmm0, rax")
        
        // SQRTSD - hardware square root
        Trans_Asm("SQRTSD xmm0, xmm0")
        
        // Convert back to int (truncate)
        Trans_Asm("CVTTSD2SI rax, xmm0")
        
        ReturnValue(1)
    }
}

// Abs(n) - Absolute value
// For integers: use branchless (x ^ (x >> 63)) - (x >> 63)
// Or: convert to float, clear sign bit, convert back
Function.FPUCompileX86_Abs {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[FPU] Abs requires 1 argument\n")
            ReturnValue(0)
        }
        
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)  // Result in RAX
        
        // Branchless abs: 
        // RBX = RAX >> 63 (all 1s if negative, all 0s if positive)
        // RAX = (RAX ^ RBX) - RBX
        
        // MOV RBX, RAX
        Emit_MovRbxRax()
        
        // SAR RBX, 63 (arithmetic shift - fills with sign bit)
        // 48 C1 FB 3F
        Emit_Byte(72)
        Emit_Byte(193)
        Emit_Byte(251)
        Emit_Byte(63)
        
        // XOR RAX, RBX
        Emit_XorRaxRbx()
        
        // SUB RAX, RBX
        Emit_SubRaxRbx()
        
        ReturnValue(1)
    }
}

// Min(a, b) - Return minimum of two values
// Using SSE2 MINSD
Function.FPUCompileX86_Min {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Min requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Compile first arg -> XMM0
        Compile_Expression(arg0)
        Trans_Asm("CVTSI2SD xmm0, rax")
        X86_PushXMM0()
        
        // Compile second arg -> XMM1
        Compile_Expression(arg1)
        Trans_Asm("CVTSI2SD xmm0, rax")
        Trans_Asm("MOVSD xmm1, xmm0")
        
        X86_PopXMM0()
        
        // MINSD XMM0, XMM1 - XMM0 = min(XMM0, XMM1)
        Trans_Asm("MINSD xmm0, xmm1")
        
        // Convert back to int
        Trans_Asm("CVTTSD2SI rax, xmm0")
        
        ReturnValue(1)
    }
}

// Max(a, b) - Return maximum of two values
// Using SSE2 MAXSD
Function.FPUCompileX86_Max {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Max requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Compile first arg -> XMM0
        Compile_Expression(arg0)
        Trans_Asm("CVTSI2SD xmm0, rax")
        X86_PushXMM0()
        
        // Compile second arg -> XMM1
        Compile_Expression(arg1)
        Trans_Asm("CVTSI2SD xmm0, rax")
        Trans_Asm("MOVSD xmm1, xmm0")
        
        X86_PopXMM0()
        
        // MAXSD XMM0, XMM1 - XMM0 = max(XMM0, XMM1)
        Trans_Asm("MAXSD xmm0, xmm1")
        
        // Convert back to int
        Trans_Asm("CVTTSD2SI rax, xmm0")
        
        ReturnValue(1)
    }
}