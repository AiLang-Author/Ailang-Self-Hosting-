Function.FPUCompileX86_FloatCopysign {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[FPU] Float_Copysign requires 2 arguments (mag, sign)\n")
            ReturnValue(0)
        }
        arg_mag = AST_GetChild(node, 0)
        arg_sgn = AST_GetChild(node, 1)
        Compile_Expression(arg_sgn)
        Emit_PushRax()
        Compile_Expression(arg_mag)
        Trans_Asm("SHL rax, 1")
        Trans_Asm("SHR rax, 1")
        Emit_PopRcx()
        Trans_Asm("SHR rcx, 63")
        Trans_Asm("SHL rcx, 63")
        Trans_Asm("OR rax, rcx")
        ReturnValue(1)
    }
}

Function.FPUCompileX86_FloatIsNan {
    Input: node: Address
