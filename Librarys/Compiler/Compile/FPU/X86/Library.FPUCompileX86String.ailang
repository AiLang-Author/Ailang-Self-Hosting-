// Library.FPUCompileX86String.ailang
// SSE2-accelerated string operations for x86-64
// Location: Librarys/Compiler/Compile/FPU/X86/Library.FPUCompileX86String.ailang
//
// Follows System V AMD64 ABI conventions

LibraryImport.XArrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.FPU.FPUTypes
LibraryImport.Compiler.Compile.FPU.X86.FPUEmitX86SSE
LibraryImport.Compiler.Compile.FPU.X86.FPUEmitX86MemOps

// =============================================================================
// DISPATCHER
// =============================================================================
Function.FPUCompileX86String_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        func_name = AST_GetData1(node)
        IfCondition EqualTo(func_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // StringLength / Strlen
        cmp = StringCompare(func_name, "StringLength")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringLength(node))
        }
        cmp = StringCompare(func_name, "Strlen")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringLength(node))
        }
        
        // StringCompare / Strcmp
        cmp = StringCompare(func_name, "StringCompare")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringCompare(node))
        }
        cmp = StringCompare(func_name, "Strcmp")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringCompare(node))
        }
        
        // StringEquals
        cmp = StringCompare(func_name, "StringEquals")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringEquals(node))
        }
        
        // StringCopy / Strcpy
        cmp = StringCompare(func_name, "StringCopy")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringCopy(node))
        }
        cmp = StringCompare(func_name, "Strcpy")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringCopy(node))
        }
        
        // StringIndexOf / Strchr
        cmp = StringCompare(func_name, "StringIndexOf")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringIndexOf(node))
        }
        cmp = StringCompare(func_name, "Strchr")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringIndexOf(node))
        }
        
        // StringContains
        cmp = StringCompare(func_name, "StringContains")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringContains(node))
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// STRINGLENGTH - SSE2 strlen
// Pattern: Scan 16 bytes for null, BSF to find exact position
// SysV: RDI = str, return length in RAX
// =============================================================================
Function.FPUCompileX86_StringLength {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[SSE2-String] StringLength requires 1 argument\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        sse_loop = Emit_CreateLabel()
        found_null = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        // Compile arg -> RDI
        Compile_Expression(arg0)
        Emit_MovRdiRax()
        
        // R8 = original pointer (for length calculation)
        X86_MovR8Rdi()
        
        // XMM0 = 0 (null bytes to compare against)
        X86_PXOR_XMM0_XMM0()
        
        // === Main loop: 16 bytes at a time ===
        Emit_MarkLabel(sse_loop)
        
        // XMM1 = [RDI] (load 16 bytes)
        X86_MOVDQU_XMM1_DerefRDI()
        
        // XMM1 = (XMM1 == 0) ? 0xFF : 0x00
        X86_PCMPEQB_XMM1_XMM0()
        
        // EAX = bitmask of matches
        X86_PMOVMSKB_EAX_XMM1()
        
        // If any null found, exit loop
        X86_TestEAX_EAX()
        Emit_Jne(found_null)
        
        // Advance pointer by 16
        X86_AddRDI_16()
        Emit_Jmp(sse_loop)
        
        // === Found null ===
        Emit_MarkLabel(found_null)
        
        // ECX = position of first null in block (BSF)
        X86_BSF_ECX_EAX()
        
        // RAX = RDI - R8 (bytes scanned so far)
        Emit_MovRaxRdi()
        X86_SubRaxR8()
        
        // RAX = RAX + RCX (add position within block)
        X86_AddRaxRcx()
        
        Emit_MarkLabel(done_label)
        
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGCOMPARE - SSE2 strcmp
// Pattern: Compare 16 bytes at a time, find first difference or null
// SysV: RDI = s1, RSI = s2, return diff in RAX (0 if equal)
// =============================================================================
Function.FPUCompileX86_StringCompare {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[SSE2-String] StringCompare requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        sse_loop = Emit_CreateLabel()
        found_stop = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        // Compile args: s2 first (push), then s1
        Compile_Expression(arg1)
        Emit_PushRax()
        
        Compile_Expression(arg0)
        Emit_MovRdiRax()    // RDI = s1
        
        Emit_PopRsi()       // RSI = s2
        
        // XMM0 = 0 (for null detection)
        X86_PXOR_XMM0_XMM0()
        
        // === Main loop ===
        Emit_MarkLabel(sse_loop)
        
        // XMM1 = [RDI] (16 bytes from s1)
        X86_MOVDQU_XMM1_DerefRDI()
        
        // XMM2 = [RSI] (16 bytes from s2)
        X86_MOVDQU_XMM2_DerefRSI()
        
        // XMM3 = XMM1 (copy for null check)
        X86_MOVDQA_XMM3_XMM1()
        
        // XMM3 = (XMM3 == 0) - null mask: 0xFF where null
        X86_PCMPEQB_XMM3_XMM0()
        
        // XMM1 = (XMM1 == XMM2) - equal mask: 0xFF where equal
        X86_PCMPEQB_XMM1_XMM2()
        
        // Get both masks into GP registers
        X86_PMOVMSKB_EAX_XMM3()  // EAX = null mask
        X86_PMOVMSKB_ECX_XMM1()  // ECX = equal mask
        
        // NOT ECX to get different mask (1 = different)
        // NOT ECX = F7 D1
        Emit_Byte(0xF7)
        Emit_Byte(0xD1)
        
        // OR EAX, ECX = combined stop mask (null OR different)
        // OR EAX, ECX = 09 C8
        Emit_Byte(0x09)
        Emit_Byte(0xC8)
        
        // If EAX == 0, no stops in this 16-byte chunk
        X86_TestEAX_EAX()
        Emit_Jne(found_stop)
        
        // Continue to next chunk
        X86_AddRDI_16()
        X86_AddRSI_16()
        Emit_Jmp(sse_loop)
        
        // === Found null or difference ===
        Emit_MarkLabel(found_stop)
        
        // ECX = position of first stop (BSF finds first set bit)
        X86_BSF_ECX_EAX()
        
        // Load bytes at that position
        // EAX = s1[RDI + RCX]
        X86_MovzxRaxByteRdiRcx()
        
        // R9D = s2[RSI + RCX]
        X86_MovzxR9dByteRsiRcx()
        
        // RAX = s1[pos] - s2[pos]
        X86_SubRaxR9()
        
        Emit_MarkLabel(done_label)
        
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGEQUALS - SSE2 string equality check
// Same as StringCompare but returns 1 if equal, 0 if different
// =============================================================================
Function.FPUCompileX86_StringEquals {
    Input: node: Address
    Output: Integer
    Body: {
        // Use StringCompare, then convert result
        result = FPUCompileX86_StringCompare(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // RAX has strcmp result (0 if equal)
        // We want: RAX == 0 ? 1 : 0
        
        // TEST RAX, RAX
        X86_TestRAX_RAX()
        
        // SETE AL
        Emit_Sete()
        
        // MOVZX RAX, AL
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGCOPY - SSE2 strcpy
// Copy string including null terminator
// SysV: RDI = dest, RSI = src, return dest in RAX
// =============================================================================
Function.FPUCompileX86_StringCopy {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[SSE2-String] StringCopy requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)  // dest
        arg1 = AST_GetChild(node, 1)  // src
        
        sse_loop = Emit_CreateLabel()
        found_null = Emit_CreateLabel()
        copy_tail = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        // Compile args
        Compile_Expression(arg1)
        Emit_PushRax()
        
        Compile_Expression(arg0)
        Emit_MovRdiRax()    // RDI = dest
        
        Emit_PopRsi()       // RSI = src
        
        // R8 = original dest (return value)
        X86_MovR8Rdi()
        
        // XMM0 = 0 (null detection)
        X86_PXOR_XMM0_XMM0()
        
        // === Main loop: copy 16 bytes, check for null ===
        Emit_MarkLabel(sse_loop)
        
        // XMM1 = [RSI] (load 16 from src)
        X86_MOVDQU_XMM1_DerefRSI()
        
        // Check for null in this block
        X86_MOVDQA_XMM2_XMM1()
        X86_PCMPEQB_XMM2_XMM0()
        X86_PMOVMSKB_EAX_XMM2()
        
        // If null found, do partial copy
        X86_TestEAX_EAX()
        Emit_Jne(found_null)
        
        // No null - copy full 16 bytes
        X86_MOVDQU_DerefRDI_XMM1()
        
        // Advance pointers
        X86_AddRDI_16()
        X86_AddRSI_16()
        Emit_Jmp(sse_loop)
        
        // === Found null - copy remaining bytes ===
        Emit_MarkLabel(found_null)
        
        // ECX = position of null
        X86_BSF_ECX_EAX()
        
        // Copy bytes 0..ECX (including null)
        // Scalar loop for tail
        Emit_MarkLabel(copy_tail)
        
        // AL = [RSI]
        Emit_MovAlDerefRsi()
        // [RDI] = AL
        Emit_MovDerefRdiAl()
        
        // If AL == 0, done
        X86_TestAL_AL()
        Emit_Je(done_label)
        
        // Advance
        X86_IncRDI()
        X86_IncRSI()
        Emit_Jmp(copy_tail)
        
        // === Done ===
        Emit_MarkLabel(done_label)
        
        // Return original dest
        X86_MovRaxR8()
        
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGINDEXOF - SSE2 strchr
// Find first occurrence of character in string
// SysV: RDI = str, RSI = char, return index in RAX (-1 if not found)
// =============================================================================
Function.FPUCompileX86_StringIndexOf {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[SSE2-String] StringIndexOf requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)  // str
        arg1 = AST_GetChild(node, 1)  // char
        
        // CREATE ALL LABELS AT TOP - FIX: was missing found_match, had duplicate calc_index
        sse_loop = Emit_CreateLabel()
        found_match = Emit_CreateLabel()
        check_null_before = Emit_CreateLabel()
        calc_index = Emit_CreateLabel()
        not_found = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        // Compile args
        Compile_Expression(arg1)
        Emit_PushRax()
        
        Compile_Expression(arg0)
        Emit_MovRdiRax()    // RDI = str
        
        Emit_PopRax()       // RAX = char to find
        
        // R8 = original str (for index calc)
        X86_MovR8Rdi()
        
        // Broadcast char to XMM1
        X86_BroadcastAL_XMM1()
        
        // XMM0 = 0 (null detection)
        X86_PXOR_XMM0_XMM0()
        
        // === Main loop ===
        Emit_MarkLabel(sse_loop)
        
        // XMM2 = [RDI] (16 bytes)
        X86_MOVDQU_XMM2_DerefRDI()
        
        // XMM3 = XMM2 (copy for null check)
        X86_MOVDQA_XMM3_XMM2()
        
        // XMM2 = (XMM2 == XMM1) - char matches
        X86_PCMPEQB_XMM2_XMM1()
        
        // XMM3 = (XMM3 == 0) - null positions
        X86_PCMPEQB_XMM3_XMM0()
        
        // Check for char match - FIX: was "found_char", should be "found_match"
        X86_PMOVMSKB_EAX_XMM2()
        X86_TestEAX_EAX()
        Emit_Jne(found_match)
        
        // Check for null (end of string)
        X86_PMOVMSKB_EAX_XMM3()
        X86_TestEAX_EAX()
        Emit_Jne(not_found)
        
        // Advance
        X86_AddRDI_16()
        Emit_Jmp(sse_loop)
        
        // === Found char match ===
        Emit_MarkLabel(found_match)
        
        // But check if null comes before char
        X86_PMOVMSKB_ECX_XMM3()  // ECX = null mask
        
        // EDX = position of char
        X86_BSF_EDX_EAX()
        
        // If null mask is 0, char is valid
        X86_TestECX_ECX()
        Emit_Je(calc_index)
        
        // Check if null position < char position
        X86_BSF_ECX_ECX()
        X86_CmpECX_EDX()
        Emit_Jb(not_found)  // null before char
        
        // === Char is valid, calc index ===
        Emit_MarkLabel(calc_index)
        
        // RAX = RDI - R8 + RDX
        Emit_MovRaxRdi()
        X86_SubRaxR8()
        X86_AddRaxRdx()
        Emit_Jmp(done_label)
        
        // === Not found ===
        Emit_MarkLabel(not_found)
        
        // Return -1
        X86_MovRaxNeg1()
        
        Emit_MarkLabel(done_label)
        
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGCONTAINS - Boolean version of StringIndexOf
// Returns 1 if char found, 0 if not
// =============================================================================
Function.FPUCompileX86_StringContains {
    Input: node: Address
    Output: Integer
    Body: {
        // Use StringIndexOf, convert result
        result = FPUCompileX86_StringIndexOf(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // RAX has index (-1 if not found)
        // We want: RAX >= 0 ? 1 : 0
        
        // CMP RAX, 0
        X86_CmpRAX_0()
        
        // SETGE AL (set if >= 0)
        Emit_Setge()
        
        // MOVZX RAX, AL
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}