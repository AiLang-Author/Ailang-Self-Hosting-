LibraryImport.Arena

// Library.FPUCompileX86String.ailang
// SSE2-accelerated string operations for x86-64
// Location: Librarys/Compiler/Compile/FPU/X86/Library.FPUCompileX86String.ailang
//
// Follows System V AMD64 ABI conventions
LibraryImport.Arena
LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.FPU.FPUTypes

LibraryImport.Compiler.Compile.FPU.X86.FPUCompileX86Trans

// =============================================================================
// DISPATCHER
// =============================================================================
Function.FPUCompileX86String_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        func_name = AST_GetData1(node)
        IfCondition EqualTo(func_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // StringLength / Strlen
        cmp = StringCompare(func_name, "StringLength")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringLength(node))
        }
        cmp = StringCompare(func_name, "Strlen")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringLength(node))
        }
        
        // StringCompare / Strcmp
        cmp = StringCompare(func_name, "StringCompare")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringCompare(node))
        }
        cmp = StringCompare(func_name, "Strcmp")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringCompare(node))
        }
        
        // StringEquals
        cmp = StringCompare(func_name, "StringEquals")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringEquals(node))
        }
        
        // StringCopy / Strcpy
        cmp = StringCompare(func_name, "StringCopy")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringCopy(node))
        }
        cmp = StringCompare(func_name, "Strcpy")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringCopy(node))
        }
        
        // StringIndexOf / Strchr
        cmp = StringCompare(func_name, "StringIndexOf")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringIndexOf(node))
        }
        cmp = StringCompare(func_name, "Strchr")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringIndexOf(node))
        }
        
        // StringContains
        cmp = StringCompare(func_name, "StringContains")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringContains(node))
        }

        cmp = StringCompare(func_name, "StringConcat")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(FPUCompileX86_StringConcat(node))
        }
        
        ReturnValue(0)
    }
}

// RSI = src, RDI = dest, RCX = n. Advances RSI/RDI by n. Clobbers XMM0, EAX, RCX.
Function.FPU_EmitCopyBytes {
    Body: {
        sse_loop = Emit_CreateLabel()
        scalar_check = Emit_CreateLabel()
        scalar_loop = Emit_CreateLabel()
        done_label = Emit_CreateLabel()

        Trans_Asm("TEST rcx, rcx")
        Emit_Je(done_label)

        Emit_MarkLabel(sse_loop)
        Trans_Asm("CMP rcx, 16")
        Emit_Jb(scalar_check)
        X86_MOVDQU_XMM0_DerefRSI()
        X86_MOVDQU_DerefRDI_XMM0()
        Trans_Asm("ADD rsi, 16")
        Trans_Asm("ADD rdi, 16")
        Trans_Asm("SUB rcx, 16")
        Emit_Jmp(sse_loop)

        Emit_MarkLabel(scalar_check)
        Trans_Asm("TEST rcx, rcx")
        Emit_Je(done_label)

        Emit_MarkLabel(scalar_loop)
        X86_MovzxEAX_ByteDerefRSI()
        X86_MovByte_DerefRDI_AL()
        Trans_Asm("INC rsi")
        Trans_Asm("INC rdi")
        Trans_Asm("DEC rcx")
        Emit_Jne(scalar_loop)

        Emit_MarkLabel(done_label)
    }
}

// RDI = C string. Returns length in RAX. Clobbers XMM0/XMM1, R8, EAX, ECX, RDI.
Function.FPU_EmitSse2Strlen {
    Body: {
        sse_loop = Emit_CreateLabel()
        found_null = Emit_CreateLabel()
        Trans_Asm("MOV r8, rdi")
        Trans_Asm("PXOR xmm0, xmm0")
        Emit_MarkLabel(sse_loop)
        X86_MOVDQU_XMM1_DerefRDI()
        Trans_Asm("PCMPEQB xmm1, xmm0")
        Trans_Asm("PMOVMSKB eax, xmm1")
        Trans_Asm("TEST eax, eax")
        Emit_Jne(found_null)
        Trans_Asm("ADD rdi, 16")
        Emit_Jmp(sse_loop)
        Emit_MarkLabel(found_null)
        Trans_Asm("BSF ecx, eax")
        Emit_MovRaxRdi()
        Trans_Asm("SUB rax, r8")
        Trans_Asm("ADD rax, rcx")
    }
}

// =============================================================================
// STRINGLENGTH - SSE2 strlen
// Pattern: Scan 16 bytes for null, BSF to find exact position
// SysV: RDI = str, return length in RAX
// =============================================================================
Function.FPUCompileX86_StringLength {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[SSE2-String] StringLength requires 1 argument\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        Compile_Expression(arg0)
        Emit_MovRdiRax()
        FPU_EmitSse2Strlen()
        ReturnValue(1)
    }
}

Function.FPUCompileX86_StringConcat {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[SSE2-String] StringConcat requires 2 arguments\n")
            ReturnValue(0)
        }
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushR14()

        Compile_Expression(arg0)
        Emit_PushRax()
        Compile_Expression(arg1)
        Emit_PushRax()
        Emit_PopR14()
        Emit_PopR13()

        Emit_MovRdiR13()
        FPU_EmitSse2Strlen()
        Emit_MovRbxRax()

        Emit_MovRdiR14()
        FPU_EmitSse2Strlen()
        Emit_PushRax()
        Emit_AddRaxRbx()
        Emit_IncRax()
        Emit_MovRdiRax()

        // Arena bump when the program imported it; mmap otherwise (tiny probes).
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            Emit_MovRegReg(Reg.RSI, Reg.RDI)
            Emit_MovRaxImm64(9)
            Emit_MovRdiImm64(0)
            Emit_MovRdxImm64(3)
            Emit_MovR10Imm64(34)
            Emit_MovR8Imm64(-1)
            Emit_MovR9Imm64(0)
            Emit_Syscall()
        } ElseBlock: {
            Emit_MovRegReg(Reg.R12, Reg.RSP)
            Emit_AndRspImm8(240)
            Emit_Call(arena_label)
            Emit_MovRegReg(Reg.RSP, Reg.R12)
        }

        Emit_MovR12Rax()
        Emit_PopRax()
        Emit_PushRax()

        Emit_MovRsiR13()
        Emit_MovRdiR12()
        Emit_MovRegReg(Reg.RCX, Reg.RBX)
        FPU_EmitCopyBytes()

        Emit_PopRcx()
        Emit_MovRsiR14()
        FPU_EmitCopyBytes()

        Emit_MovByteDerefRdiZero()
        Emit_MovRaxR12()

        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGCOMPARE - SSE2 strcmp
// Pattern: Compare 16 bytes at a time, find first difference or null
// SysV: RDI = s1, RSI = s2, return diff in RAX (0 if equal)
// =============================================================================
Function.FPUCompileX86_StringCompare {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[SSE2-String] StringCompare requires 2 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        sse_loop = Emit_CreateLabel()
        found_stop = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        Compile_Expression(arg1)
        Emit_PushRax()
        
        Compile_Expression(arg0)
        Emit_MovRdiRax()
        
        Emit_PopRsi()
        
        Trans_Asm("PXOR xmm0, xmm0")
        
        Emit_MarkLabel(sse_loop)
        
        X86_MOVDQU_XMM1_DerefRDI()
        X86_MOVDQU_XMM2_DerefRSI()
        Trans_Asm("MOVDQA xmm3, xmm1")
        Trans_Asm("PCMPEQB xmm3, xmm0")
        Trans_Asm("PCMPEQB xmm1, xmm2")
        
        Trans_Asm("PMOVMSKB eax, xmm3")
        Trans_Asm("PMOVMSKB ecx, xmm1")
        
        // NOT ECX to get different mask (1 = different)
        // NOT ECX = F7 D1
        Emit_Byte(0xF7)
        Emit_Byte(0xD1)

        // AND ECX, 0xFFFF - clear upper 16 bits (PMOVMSKB only sets lower 16)
        // AND ECX, 0xFFFF = 81 E1 FF FF 00 00
        Emit_Byte(0x81)
        Emit_Byte(0xE1)
        Emit_Byte(0xFF)
        Emit_Byte(0xFF)
        Emit_Byte(0x00)
        Emit_Byte(0x00)

        // OR EAX, ECX = combined stop mask (null OR different)
        // OR EAX, ECX = 0B C1
        Emit_Byte(0x0B)
        Emit_Byte(0xC1)
        
        Trans_Asm("TEST eax, eax")
        Emit_Jne(found_stop)
        
        Trans_Asm("ADD rdi, 16")
        Trans_Asm("ADD rsi, 16")
        Emit_Jmp(sse_loop)
        
        Emit_MarkLabel(found_stop)
        
        Trans_Asm("BSF ecx, eax")
        X86_MovzxRaxByteRdiRcx()
        X86_MovzxR9dByteRsiRcx()
        Trans_Asm("SUB rax, r9")
        
        Emit_MarkLabel(done_label)
        
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGEQUALS - SSE2 string equality check
// Same as StringCompare but returns 1 if equal, 0 if different
// =============================================================================
Function.FPUCompileX86_StringEquals {
    Input: node: Address
    Output: Integer
    Body: {
        // Use StringCompare, then convert result
        result = FPUCompileX86_StringCompare(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // RAX has strcmp result (0 if equal)
        // We want: RAX == 0 ? 1 : 0
        
        // TEST RAX, RAX
        Trans_Asm("TEST rax, rax")
        
        // SETE AL
        Emit_Sete()
        
        // MOVZX RAX, AL
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGCOPY - SSE2 strcpy (1 or 2 arguments)
// StringCopy(src) -> allocates new string via Arena, copies, returns pointer
// StringCopy(dest, src) -> copies src to dest, returns dest (no allocation)
// =============================================================================
Function.FPUCompileX86_StringCopy {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        
        IfCondition EqualTo(arg_count, 1) ThenBlock: {
            ReturnValue(FPUCompileX86_StringCopy1(node))
        }
        
        IfCondition EqualTo(arg_count, 2) ThenBlock: {
            ReturnValue(FPUCompileX86_StringCopy2(node))
        }
        
        PrintMessage("[SSE2-String] StringCopy requires 1 or 2 arguments\n")
        ReturnValue(0)
    }
}

// =============================================================================
// STRINGCOPY 1-ARG: Allocate via Arena + SSE2 copy
// =============================================================================
Function.FPUCompileX86_StringCopy1 {
    Input: node: Address
    Output: Integer
    Body: {
        arg0 = AST_GetChild(node, 0)  // src
        
        // Labels
        len_loop = Emit_CreateLabel()
        len_done = Emit_CreateLabel()
        sse_loop = Emit_CreateLabel()
        found_null = Emit_CreateLabel()
        copy_tail = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        null_input = Emit_CreateLabel()
        cleanup = Emit_CreateLabel()
        
        // Save callee-saved
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushR14()
        
        // Compile src -> R12
        Compile_Expression(arg0)
        Emit_MovR12Rax()
        
        // NULL check
        Emit_TestR12R12()
        Emit_Jz(null_input)
        
        // === Calculate length using SSE2 ===
        Emit_MovRdiR12()
        Trans_Asm("MOV r8, rdi")
        Trans_Asm("PXOR xmm0, xmm0")
        
        Emit_MarkLabel(len_loop)
        X86_MOVDQU_XMM1_DerefRDI()
        Trans_Asm("PCMPEQB xmm1, xmm0")
        Trans_Asm("PMOVMSKB eax, xmm1")
        Trans_Asm("TEST eax, eax")
        Emit_Jne(len_done)
        Trans_Asm("ADD rdi, 16")
        Emit_Jmp(len_loop)
        
        Emit_MarkLabel(len_done)
        Trans_Asm("BSF ecx, eax")
        Emit_MovRaxRdi()
        Trans_Asm("SUB rax, r8")
        Trans_Asm("ADD rax, rcx")
        
        // RAX = length, save in RBX
        Emit_MovRbxRax()
        
        // === Arena_Alloc(length + 1) ===
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            PrintMessage("[SSE2-String] Arena_Alloc not found\n")
            ReturnValue(0)
        }
        
        // Align stack, save RSP in R13
        Emit_MovRegReg(Reg.R13, Reg.RSP)
        Emit_AndRspImm8(240)
        
        // RDI = length + 1
        Emit_MovRdiRbx()
        Emit_IncRdi()
        
        Emit_Call(arena_label)
        
        // Restore RSP
        Emit_MovRegReg(Reg.RSP, Reg.R13)
        
        // RAX = dest buffer, save in R14
        Emit_MovR14Rax()
        
        // === SSE2 copy from R12 (src) to R14 (dest) ===
        Emit_MovRdiR14()      // RDI = dest
        Emit_MovRsiR12()      // RSI = src
        
        Trans_Asm("PXOR xmm0, xmm0")
        
        Emit_MarkLabel(sse_loop)
        X86_MOVDQU_XMM1_DerefRSI()
        Trans_Asm("MOVDQA xmm2, xmm1")
        Trans_Asm("PCMPEQB xmm2, xmm0")
        Trans_Asm("PMOVMSKB eax, xmm2")
        Trans_Asm("TEST eax, eax")
        Emit_Jne(found_null)
        
        X86_MOVDQU_DerefRDI_XMM1()
        Trans_Asm("ADD rdi, 16")
        Trans_Asm("ADD rsi, 16")
        Emit_Jmp(sse_loop)
        
        Emit_MarkLabel(found_null)
        Trans_Asm("BSF ecx, eax")
        
        Emit_MarkLabel(copy_tail)
        Emit_MovAlDerefRsi()
        Emit_MovDerefRdiAl()
        Trans_Asm("TEST al, al")
        Emit_Je(done_label)
        Trans_Asm("INC rdi")
        Trans_Asm("INC rsi")
        Emit_Jmp(copy_tail)
        
        // === Normal completion - return R14 ===
        Emit_MarkLabel(done_label)
        Emit_MovRaxR14()
        Emit_Jmp(cleanup)
        
        // === NULL input - return 0 ===
        Emit_MarkLabel(null_input)
        Emit_XorRaxRax()
        
        // === Cleanup and return ===
        Emit_MarkLabel(cleanup)
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
        
        ReturnValue(1)
    }
}
// =============================================================================
// STRINGCOPY 2-ARG: SSE2 copy to provided dest (original implementation)
// =============================================================================
Function.FPUCompileX86_StringCopy2 {
    Input: node: Address
    Output: Integer
    Body: {
        arg0 = AST_GetChild(node, 0)  // dest
        arg1 = AST_GetChild(node, 1)  // src
        
        sse_loop = Emit_CreateLabel()
        found_null = Emit_CreateLabel()
        copy_tail = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        // Compile args
        Compile_Expression(arg1)
        Emit_PushRax()
        
        Compile_Expression(arg0)
        Emit_MovRdiRax()    // RDI = dest
        
        Emit_PopRsi()       // RSI = src
        
        // R8 = original dest (return value)
        Trans_Asm("MOV r8, rdi")
        
        // XMM0 = 0 (null detection)
        Trans_Asm("PXOR xmm0, xmm0")
        
        // === Main loop: copy 16 bytes, check for null ===
        Emit_MarkLabel(sse_loop)
        
        // XMM1 = [RSI] (load 16 from src)
        X86_MOVDQU_XMM1_DerefRSI()
        
        // Check for null in this block
        Trans_Asm("MOVDQA xmm2, xmm1")
        Trans_Asm("PCMPEQB xmm2, xmm0")
        Trans_Asm("PMOVMSKB eax, xmm2")
        
        // If null found, do partial copy
        Trans_Asm("TEST eax, eax")
        Emit_Jne(found_null)
        
        // No null - copy full 16 bytes
        X86_MOVDQU_DerefRDI_XMM1()
        
        // Advance pointers
        Trans_Asm("ADD rdi, 16")
        Trans_Asm("ADD rsi, 16")
        Emit_Jmp(sse_loop)
        
        // === Found null - copy remaining bytes ===
        Emit_MarkLabel(found_null)
        
        // ECX = position of null
        Trans_Asm("BSF ecx, eax")
        
        // Copy bytes 0..ECX (including null)
        // Scalar loop for tail
        Emit_MarkLabel(copy_tail)
        
        // AL = [RSI]
        Emit_MovAlDerefRsi()
        // [RDI] = AL
        Emit_MovDerefRdiAl()
        
        // If AL == 0, done
        Trans_Asm("TEST al, al")
        Emit_Je(done_label)
        
        // Advance
        Trans_Asm("INC rdi")
        Trans_Asm("INC rsi")
        Emit_Jmp(copy_tail)
        
        // === Done ===
        Emit_MarkLabel(done_label)
        
        // Return original dest
        Trans_Asm("MOV rax, r8")
        
        ReturnValue(1)
    }
}


// =============================================================================
// STRINGINDEXOF - SSE2 strchr with start position
// Find first occurrence of character in string starting at position
// SysV: RDI = str, RSI = char, RDX = start_pos
// Returns: index in RAX (-1 if not found), index is absolute (from string start)
// Accepts 2 args (str, char) with default start_pos=0, or 3 args (str, char, start_pos)
// =============================================================================
Function.FPUCompileX86_StringIndexOf {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        
        // Accept 2 or 3 arguments
        IfCondition LessThan(arg_count, 2) ThenBlock: {
            PrintMessage("[SSE2-String] StringIndexOf requires 2-3 arguments\n")
            ReturnValue(0)
        }
        IfCondition GreaterThan(arg_count, 3) ThenBlock: {
            PrintMessage("[SSE2-String] StringIndexOf requires 2-3 arguments\n")
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)  // str
        arg1 = AST_GetChild(node, 1)  // char
        
        sse_loop = Emit_CreateLabel()
        found_match = Emit_CreateLabel()
        calc_index = Emit_CreateLabel()
        not_found = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        // Compile start_pos (arg2) or default to 0
        IfCondition EqualTo(arg_count, 3) ThenBlock: {
            arg2 = AST_GetChild(node, 2)
            Compile_Expression(arg2)
            Emit_PushRax()              // start_pos on stack
        } ElseBlock: {
            // Default start_pos = 0
            Emit_MovRaxImm64(0)
            Emit_PushRax()
        }
        
        Compile_Expression(arg1)
        Emit_MovzxRaxByteDerefRax() // RAX = first byte of char string
        Emit_PushRax()              // char on stack
        
        Compile_Expression(arg0)
        Emit_MovRdiRax()            // RDI = str
        
        Emit_PopRax()               // RAX = char to find
        Emit_PopRdx()               // RDX = start_pos
        
        // R8 = original str pointer (for absolute index calc)
        Trans_Asm("MOV r8, rdi")
        
        // Advance RDI by start_pos: RDI = str + start_pos
        // ADD RDI, RDX
        Trans_Asm("ADD rdi, rdx")
        
        // Broadcast char to XMM1
        X86_BroadcastAL_XMM1()
        
        // XMM0 = 0 (null detection)
        Trans_Asm("PXOR xmm0, xmm0")
        
        // === Main loop ===
        Emit_MarkLabel(sse_loop)
        
        // XMM2 = [RDI] (16 bytes)
        X86_MOVDQU_XMM2_DerefRDI()
        
        // XMM3 = XMM2 (copy for null check)
        Trans_Asm("MOVDQA xmm3, xmm2")
        
        // XMM2 = (XMM2 == XMM1) - char matches
        Trans_Asm("PCMPEQB xmm2, xmm1")
        
        // XMM3 = (XMM3 == 0) - null positions
        Trans_Asm("PCMPEQB xmm3, xmm0")
        
        // Check for char match
        Trans_Asm("PMOVMSKB eax, xmm2")
        Trans_Asm("TEST eax, eax")
        Emit_Jne(found_match)
        
        // Check for null (end of string)
        Trans_Asm("PMOVMSKB eax, xmm3")
        Trans_Asm("TEST eax, eax")
        Emit_Jne(not_found)
        
        // Advance
        Trans_Asm("ADD rdi, 16")
        Emit_Jmp(sse_loop)
        
        // === Found char match ===
        Emit_MarkLabel(found_match)
        
        // But check if null comes before char
        Trans_Asm("PMOVMSKB ecx, xmm3")  // ECX = null mask
        
        // EDX = position of char within 16-byte block
        Trans_Asm("BSF edx, eax")
        
        // If null mask is 0, char is valid
        Trans_Asm("TEST ecx, ecx")
        Emit_Je(calc_index)
        
        // Check if null position < char position
        Trans_Asm("BSF ecx, ecx")
        Trans_Asm("CMP ecx, edx")
        Emit_Jb(not_found)  // null before char
        
        // === Char is valid, calc ABSOLUTE index ===
        Emit_MarkLabel(calc_index)
        
        // RAX = RDI - R8 + RDX
        // (current scan pointer - original string start + position in block)
        // This gives absolute index from beginning of string
        Emit_MovRaxRdi()
        Trans_Asm("SUB rax, r8")
        Trans_Asm("ADD rax, rdx")
        Emit_Jmp(done_label)
        
        // === Not found ===
        Emit_MarkLabel(not_found)
        
        // Return -1
        Trans_Asm("MOV rax, -1")
        
        Emit_MarkLabel(done_label)
        
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGCONTAINS - Boolean version of StringIndexOf
// Returns 1 if char found, 0 if not
// =============================================================================
Function.FPUCompileX86_StringContains {
    Input: node: Address
    Output: Integer
    Body: {
        // Use StringIndexOf, convert result
        result = FPUCompileX86_StringIndexOf(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // RAX has index (-1 if not found)
        // We want: RAX >= 0 ? 1 : 0
        
        // CMP RAX, 0
        Trans_Asm("CMP rax, 0")
        
        // SETGE AL (set if >= 0)
        Emit_Setge()
        
        // MOVZX RAX, AL
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}