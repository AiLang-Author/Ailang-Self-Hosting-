// Library.FPUCompileX86Trans.ailang
// X86-64 SSE2 transcendental function compilation
// Float_Sin/Cos/Tan/Atan2/Exp/Log/Pow are live.
// Location: Librarys/Compiler/Compile/FPU/X86/Library.FPUCompileX86Trans.ailang
//
// Dispatches Float_Sin/Cos/Tan/Atan2/Exp/Log/Pow to per-function compile
// routines. Each routine ships as "recognized at compile, not yet
// implemented" for now — the dispatcher, constant pool, and data-section
// loader helpers are all in place so the remaining work is purely filling
// in polynomial bodies.
//
// Scope deferred to a dedicated implementation session:
//   1. XMM2/XMM3 emitter variants (MOVSD/MULSD/ADDSD/MOVAPD) so
//      polynomial evaluation can keep r and r² in registers without
//      stack spilling.
//   2. Range reduction: x → r in [-π/4, π/4] with quadrant tracking.
//      MVP uses single π/2 subtraction; large-|x| accuracy matches
//      fdlibm pre-Payne–Hanek.
//   3. Remez/fdlibm polynomial bodies (coefficients already encoded
//      as IEEE bit patterns in TransConst below).
//
// Value convention matches the rest of the Float_* backend:
//   - Arguments arrive as IEEE 754 bit patterns in RAX after
//     Compile_Expression(arg).
//   - Move bits to XMM0 via X86_MOVQ_XMM0_RAX for math.
//   - Result bits end up back in RAX via X86_MOVQ_RAX_XMM0.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.CodeEmit.X86.CEmitX86Enc

// =============================================================================
// POLYNOMIAL COEFFICIENTS
// IEEE 754 double bit patterns for fdlibm's sin/cos/exp/log minimax
// approximations. Kept here so the constant table is co-located with the
// compile routines that use it.
// =============================================================================
FixedPool.TransConst {
    // Taylor Horner on [-π/4, π/4]. Bits verified with Python struct '<d'.
    // sin(r) ≈ r · (1 + r² · (S1 + r² · (S3 + r² · (S5 + r² · S7))))
    "SIN_S1":    Initialize=-4628199217061079723      // -1/6
    "SIN_S3":    Initialize=4575957461383581969       //  1/120
    "SIN_S5":    Initialize=-4671919876300759014      // -1/5040
    "SIN_S7":    Initialize=4523617214285662004       //  1/362880
    "SIN_S9":    Initialize=-4730215272828025628      // -1/11!
    "SIN_S11":   Initialize=4460272573143870729       //  1/13!
    "SIN_S13":   Initialize=-4797767418267846625      // -1/15!

    // cos(r) ≈ 1 + r² · (-1/2 + r² · (1/24 + r² · (-1/720 + r² · (1/40320 + ...))))
    "COS_C24":   Initialize=4586165620538955093       //  1/24
    "COS_C720":  Initialize=-4659324094485795817      // -1/720
    "COS_C8":    Initialize=4537941361671905306       //  1/40320
    "COS_C10":   Initialize=-4714566979057836196      // -1/10!
    "COS_C12":   Initialize=4477122120089393304       //  1/12!
    "COS_C14":   Initialize=-4780226356266894179      // -1/14!
    "COS_C16":   Initialize=4407590220077447199       //  1/16!

    "PI_OVER_2":     Initialize=4609753056924675352   //  π/2
    "PI_2_HI":       Initialize=4609753056924401664   //  π/2 high
    "PI_2_LO":       Initialize=4454258360616903473   //  π/2 tail
    "PI_OVER_4":     Initialize=4605249457297304856   //  π/4
    "PI":            Initialize=4614256656552045848   //  π
    "TWO_PI":        Initialize=4618760256179416344   //  2π
    "ONE":           Initialize=4607182418800017408   //  1.0
    "HALF":          Initialize=4602678819172646912   //  0.5
    "NEG_HALF":      Initialize=-4620693217682128896  // -0.5
    "NEG_ONE":       Initialize=-4616189618054758400  // -1.0
    "TWO_OVER_PI":   Initialize=4603909380684499075   //  2/π
    "SIGN_MASK":     Initialize=-9223372036854775808  // -0.0  sign bit
    "QNAN":          Initialize=9221120237041090560   // quiet NaN
    // atan(u) ≈ u · (1 + z · (C3 + z · (C5 + …)))  z=u², |u|≲0.5 after reduce
    "ATAN_C3":       Initialize=-4623695617433709227  // -1/3
    "ATAN_C5":       Initialize=4596373779694328218   //  1/5
    "ATAN_C7":       Initialize=-4629057045561531246  // -1/7
    "ATAN_C9":       Initialize=4592670820000712476   //  1/9
    "ATAN_C11":      Initialize=-4632156925824526522  // -1/11
    "ATAN_C13":      Initialize=4590207312512236308   //  1/13
    "ATAN_C15":      Initialize=-4633903776589082351  // -1/15
    "LN2":           Initialize=4604418534313441775   // ln(2)
    "LN2_HI":        Initialize=4604418534311723008   // ln2 high
    "LN2_LO":        Initialize=4461442080421002358   // ln2 low
    "INV_LN2":       Initialize=4609176140021203710   // 1/ln(2)
    "SQRT2":         Initialize=4609047870845172685   // sqrt(2)
    "EXP_OV":        Initialize=4649447645771726848   // 709.0
    "EXP_UN":        Initialize=-4573607731734249472  // -745.0
    "PINF":          Initialize=9218868437227405312   // +Inf
    "INV3":          Initialize=4599676419421066581   // 1/3  (approx)
    "INV4":          Initialize=4598175219545276416   // 0.25
    "NINV2":         Initialize=-4620693217682128896  // -0.5
    "INV6":          Initialize=4595172819793696085   // 1/6
    "INV24":         Initialize=4586165620538955093   // 1/24
    "INV120":        Initialize=4575957461383581969   // 1/120
    "INV720":        Initialize=4564047942368979991   // 1/720
    "INV5040":       Initialize=4551452160554016794   // 1/5040
    "INV8F":         Initialize=4537941361671905306   // 1/40320
    "INV9F":         Initialize=4523617214285662004   // 1/362880
    "INV10F":        Initialize=4508805057796939612   // 1/3628800
    "INV9":          Initialize=4592670820000712476   // 1/9
    "NINV10":        Initialize=-4631501856787818086  // -1/10
    "INV11":         Initialize=4591215111030249286   // 1/11
    "NINV12":        Initialize=-4632702816688450219  // -1/12
    "INV13":         Initialize=4590207312512236308   // 1/13
    "NINV14":        Initialize=-4633560645188901742  // -1/14
    "INV15":         Initialize=4589468260265693457   // 1/15
    "NINV4":         Initialize=-4625196817309499392  // -1/4
    "INV5":          Initialize=4596373779694328218   // 1/5
    "NINV6":         Initialize=-4628199217061079723  // -1/6
    "INV7":          Initialize=4594314991293244562   // 1/7
    "NINV8":         Initialize=-4629700416936869888  // -1/8
    "FRAC_MASK":     Initialize=4503599627370495      // 52-bit fraction
    "EXP_ONE":       Initialize=4607182418800017408   // 1.0
}

// =============================================================================
// CONSTANT EMISSION
// IEEE 754 doubles live in the data section; a 64-bit bit pattern emits as
// 8 little-endian bytes. Returns the data-section offset so the linker
// relocation machinery (same one string constants use) can patch absolute
// addresses.
// =============================================================================
Function.Trans_EmitDoubleBits {
    Input: bits: Integer
    Output: Integer
    Body: {
        offset = Emit.data_size
        i = 0
        WhileLoop LessThan(i, 8) {
            byte = BitwiseAnd(RightShift(bits, Multiply(i, 8)), 255)
            Emit_DataByte(byte)
            i = Add(i, 1)
        }
        ReturnValue(offset)
    }
}

// Emit: MOV RAX, <abs data addr> ; MOVSD XMM0, [RAX]
// Net: XMM0 = the double constant whose bits were passed in. Clobbers RAX.
Function.Trans_LoadDoubleXmm0 {
    Input: bits: Integer
    Body: {
        data_off = Trans_EmitDoubleBits(bits)
        X86_MovRaxDataOffset(data_off)
        X86_MOVSD_XMM0_DerefRax()
    }
}

// Same but into XMM1 via the XMM0→XMM1 bridge.
Function.Trans_LoadDoubleXmm1 {
    Input: bits: Integer
    Body: {
        Trans_LoadDoubleXmm0(bits)
        Trans_Asm("MOVSD xmm1, xmm0")
    }
}

Function.Trans_Asm {
    Input: s: Address
    Body: {
        ok = X86Enc_Assemble(s)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[TRANS] encode failed: ")
            PrintMessage(s)
            PrintMessage("\n")
        }
    }
}

// Load bits into XMM1, preserve XMM0.
Function.Trans_LoadXmm1KeepXmm0 {
    Input: bits: Integer
    Body: {
        X86_PushXMM0()
        data_off = Trans_EmitDoubleBits(bits)
        X86_MovRaxDataOffset(data_off)
        X86_MOVSD_XMM0_DerefRax()
        Trans_Asm("MOVSD xmm1, xmm0")
        X86_PopXMM0()
    }
}

// XMM0 = acc. RCX holds r² bits. acc = acc * r² + coeff
Function.Trans_HornerR2 {
    Input: coeff_bits: Integer
    Body: {
        Trans_Asm("MOVQ xmm1, rcx")
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_LoadXmm1KeepXmm0(coeff_bits)
        Trans_Asm("ADDSD xmm0, xmm1")
    }
}

Function.Trans_HornerR {
    Input: coeff_bits: Integer
    Body: {
        Trans_Asm("MOVQ xmm1, rsi")
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_LoadXmm1KeepXmm0(coeff_bits)
        Trans_Asm("ADDSD xmm0, xmm1")
    }
}

// XMM0 = r on entry. RCX = r² bits, RSI = r bits. Result in XMM0.
Function.Trans_EvalSinPoly {
    Body: {
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("MOV rsi, rax")
        Trans_Asm("MOVSD xmm1, xmm0")
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVQ rcx, xmm0")
        s13 = TransConst.SIN_S13
        Trans_LoadDoubleXmm0(s13)
        s11 = TransConst.SIN_S11
        Trans_HornerR2(s11)
        s9 = TransConst.SIN_S9
        Trans_HornerR2(s9)
        s7 = TransConst.SIN_S7
        Trans_HornerR2(s7)
        s5 = TransConst.SIN_S5
        Trans_HornerR2(s5)
        s3 = TransConst.SIN_S3
        Trans_HornerR2(s3)
        s1 = TransConst.SIN_S1
        Trans_HornerR2(s1)
        one = TransConst.ONE
        Trans_HornerR2(one)
        Trans_Asm("MOVQ xmm1, rsi")
        Trans_Asm("MULSD xmm0, xmm1")
    }
}

Function.Trans_EvalCosPoly {
    Body: {
        Trans_Asm("MOVSD xmm1, xmm0")
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVQ rcx, xmm0")
        c16 = TransConst.COS_C16
        Trans_LoadDoubleXmm0(c16)
        c14 = TransConst.COS_C14
        Trans_HornerR2(c14)
        c12 = TransConst.COS_C12
        Trans_HornerR2(c12)
        c10 = TransConst.COS_C10
        Trans_HornerR2(c10)
        c8 = TransConst.COS_C8
        Trans_HornerR2(c8)
        c720 = TransConst.COS_C720
        Trans_HornerR2(c720)
        c24 = TransConst.COS_C24
        Trans_HornerR2(c24)
        nh = TransConst.NEG_HALF
        Trans_HornerR2(nh)
        one = TransConst.ONE
        Trans_HornerR2(one)
    }
}

// =============================================================================
// PER-FUNCTION COMPILE ROUTINES
// All currently return 0 with a specific diagnostic. Scaffolding (arg count
// check, future range reduction hooks) is in place; polynomial bodies
// pending implementation in follow-up work.
// =============================================================================

// RAX = IEEE bits in. On Inf/NaN jumps to lab_nan.
// Else XMM0 = r in [-π/4, π/4], RDX = n = round(x * 2/π), RBX = original bits.
Function.Trans_ReduceFromRax {
    Input: lab_nan: Integer
    Body: {
        Trans_Asm("MOV rbx, rax")
        Trans_Asm("SHR rax, 52")
        Trans_Asm("AND rax, 2047")
        Trans_Asm("CMP rax, 2047")
        Emit_Je(lab_nan)

        Trans_Asm("MOV rax, rbx")
        Trans_Asm("MOVQ xmm0, rax")

        two_over_pi = TransConst.TWO_OVER_PI
        Trans_LoadXmm1KeepXmm0(two_over_pi)
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("CVTSD2SI rax, xmm0")
        Trans_Asm("MOV rdx, rax")

        Trans_Asm("CVTSI2SD xmm0, rax")
        hi = TransConst.PI_2_HI
        Trans_LoadXmm1KeepXmm0(hi)
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVSD xmm1, xmm0")
        Trans_Asm("MOV rax, rbx")
        Trans_Asm("MOVQ xmm0, rax")
        Trans_Asm("SUBSD xmm0, xmm1")
        X86_PushXMM0()
        Trans_Asm("MOV rax, rdx")
        Trans_Asm("CVTSI2SD xmm0, rax")
        lo = TransConst.PI_2_LO
        Trans_LoadXmm1KeepXmm0(lo)
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVSD xmm1, xmm0")
        X86_PopXMM0()
        Trans_Asm("SUBSD xmm0, xmm1")
    }
}

Function.Trans_NegateXmm0 {
    Body: {
        sm = TransConst.SIGN_MASK
        Trans_LoadXmm1KeepXmm0(sm)
        Trans_Asm("XORPD xmm0, xmm1")
    }
}

Function.Trans_ClearSignXmm0 {
    Body: {
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("SHL rax, 1")
        Trans_Asm("SHR rax, 1")
        Trans_Asm("MOVQ xmm0, rax")
    }
}

// XMM0 = u (signed, |u|≲1). Result atan(u) in XMM0. Clobbers RSI, RCX, RAX, XMM1.
Function.Trans_EvalAtanPoly {
    Body: {
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("MOV rsi, rax")
        Trans_Asm("MOVSD xmm1, xmm0")
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVQ rcx, xmm0")
        c15 = TransConst.ATAN_C15
        Trans_LoadDoubleXmm0(c15)
        c13 = TransConst.ATAN_C13
        Trans_HornerR2(c13)
        c11 = TransConst.ATAN_C11
        Trans_HornerR2(c11)
        c9 = TransConst.ATAN_C9
        Trans_HornerR2(c9)
        c7 = TransConst.ATAN_C7
        Trans_HornerR2(c7)
        c5 = TransConst.ATAN_C5
        Trans_HornerR2(c5)
        c3 = TransConst.ATAN_C3
        Trans_HornerR2(c3)
        one = TransConst.ONE
        Trans_HornerR2(one)
        Trans_Asm("MOVQ xmm1, rsi")
        Trans_Asm("MULSD xmm0, xmm1")
    }
}

// XMM0 = t ≥ 0, maybe Inf. Result atan(t) in [0, π/2]. Uses RDX as flags.
Function.Trans_AtanPositive {
    Body: {
        lab_pi2 = Compile_NewLabel()
        lab_after_gt1 = Compile_NewLabel()
        lab_poly = Compile_NewLabel()
        lab_check_flip = Compile_NewLabel()
        lab_done = Compile_NewLabel()

        Trans_Asm("XOR rdx, rdx")
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("SHR rax, 52")
        Trans_Asm("AND rax, 2047")
        Trans_Asm("CMP rax, 2047")
        Emit_Je(lab_pi2)

        one = TransConst.ONE
        Trans_LoadXmm1KeepXmm0(one)
        Trans_Asm("UCOMISD xmm0, xmm1")
        Emit_Jbe(lab_after_gt1)
        Trans_Asm("MOVSD xmm1, xmm0")
        Trans_LoadDoubleXmm0(one)
        Trans_Asm("DIVSD xmm0, xmm1")
        Trans_Asm("OR rdx, 1")
        Emit_MarkLabel(lab_after_gt1)

        half = TransConst.HALF
        Trans_LoadXmm1KeepXmm0(half)
        Trans_Asm("UCOMISD xmm0, xmm1")
        Emit_Jbe(lab_poly)
        Emit_PushRdx()
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("MOV rsi, rax")
        one2 = TransConst.ONE
        Trans_LoadXmm1KeepXmm0(one2)
        Trans_Asm("SUBSD xmm0, xmm1")
        Trans_Asm("MOVQ rcx, xmm0")
        Trans_Asm("MOVQ xmm0, rsi")
        Trans_LoadXmm1KeepXmm0(one2)
        Trans_Asm("ADDSD xmm0, xmm1")
        Trans_Asm("MOVQ xmm1, rcx")
        Trans_Asm("DIVSD xmm1, xmm0")
        Trans_Asm("MOVSD xmm0, xmm1")
        Emit_PopRdx()
        Trans_Asm("OR rdx, 2")

        Emit_MarkLabel(lab_poly)
        Emit_PushRdx()
        Trans_EvalAtanPoly()
        Emit_PopRdx()

        Trans_Asm("TEST rdx, 2")
        Emit_Jz(lab_check_flip)
        pq = TransConst.PI_OVER_4
        Trans_LoadXmm1KeepXmm0(pq)
        Trans_Asm("ADDSD xmm0, xmm1")

        Emit_MarkLabel(lab_check_flip)
        Trans_Asm("TEST rdx, 1")
        Emit_Jz(lab_done)
        ph = TransConst.PI_OVER_2
        Trans_LoadXmm1KeepXmm0(ph)
        Trans_Asm("SUBSD xmm1, xmm0")
        Trans_Asm("MOVSD xmm0, xmm1")
        Emit_Jmp(lab_done)

        Emit_MarkLabel(lab_pi2)
        ph2 = TransConst.PI_OVER_2
        Trans_LoadDoubleXmm0(ph2)
        Emit_MarkLabel(lab_done)
    }
}

Function.Trans_CompileFloatSin {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[TRANS] Float_Sin requires 1 argument\n")
            ReturnValue(0)
        }
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)

        lab_nan = Compile_NewLabel()
        lab_done = Compile_NewLabel()
        lab_cos = Compile_NewLabel()
        lab_after_poly = Compile_NewLabel()
        lab_pos = Compile_NewLabel()

        Trans_ReduceFromRax(lab_nan)

        Trans_Asm("MOV rax, rdx")
        Trans_Asm("AND rax, 3")
        Trans_Asm("CMP rax, 1")
        Emit_Je(lab_cos)
        Trans_Asm("CMP rax, 3")
        Emit_Je(lab_cos)
        Trans_EvalSinPoly()
        Emit_Jmp(lab_after_poly)
        Emit_MarkLabel(lab_cos)
        Trans_EvalCosPoly()
        Emit_MarkLabel(lab_after_poly)

        Trans_Asm("MOV rax, rdx")
        Trans_Asm("AND rax, 3")
        Trans_Asm("CMP rax, 2")
        Emit_Jb(lab_pos)
        Trans_NegateXmm0()
        Emit_MarkLabel(lab_pos)
        Trans_Asm("MOVQ rax, xmm0")
        Emit_Jmp(lab_done)

        Emit_MarkLabel(lab_nan)
        qn = TransConst.QNAN
        asm = "MOV rax, "
        nstr = NumberToString(qn)
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Emit_MarkLabel(lab_done)
        ReturnValue(1)
    }
}

Function.Trans_CompileFloatCos {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[TRANS] Float_Cos requires 1 argument\n")
            ReturnValue(0)
        }
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)

        lab_nan = Compile_NewLabel()
        lab_done = Compile_NewLabel()
        lab_sin = Compile_NewLabel()
        lab_after_poly = Compile_NewLabel()
        lab_neg = Compile_NewLabel()
        lab_store = Compile_NewLabel()

        Trans_ReduceFromRax(lab_nan)

        Trans_Asm("MOV rax, rdx")
        Trans_Asm("AND rax, 3")
        Trans_Asm("CMP rax, 1")
        Emit_Je(lab_sin)
        Trans_Asm("CMP rax, 3")
        Emit_Je(lab_sin)
        Trans_EvalCosPoly()
        Emit_Jmp(lab_after_poly)
        Emit_MarkLabel(lab_sin)
        Trans_EvalSinPoly()
        Emit_MarkLabel(lab_after_poly)

        Trans_Asm("MOV rax, rdx")
        Trans_Asm("AND rax, 3")
        Trans_Asm("CMP rax, 1")
        Emit_Je(lab_neg)
        Trans_Asm("CMP rax, 2")
        Emit_Je(lab_neg)
        Emit_Jmp(lab_store)
        Emit_MarkLabel(lab_neg)
        Trans_NegateXmm0()
        Emit_MarkLabel(lab_store)
        Trans_Asm("MOVQ rax, xmm0")
        Emit_Jmp(lab_done)

        Emit_MarkLabel(lab_nan)
        qn = TransConst.QNAN
        asm = "MOV rax, "
        nstr = NumberToString(qn)
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Emit_MarkLabel(lab_done)
        ReturnValue(1)
    }
}

Function.Trans_CompileFloatTan {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[TRANS] Float_Tan requires 1 argument\n")
            ReturnValue(0)
        }
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)

        lab_nan = Compile_NewLabel()
        lab_done = Compile_NewLabel()
        lab_odd = Compile_NewLabel()
        lab_store = Compile_NewLabel()

        Trans_ReduceFromRax(lab_nan)
        Emit_PushRdx()
        Trans_EvalSinPoly()
        Trans_Asm("MOVQ rax, xmm0")
        Emit_PushRax()
        Trans_Asm("MOVQ xmm0, rsi")
        Trans_EvalCosPoly()
        Emit_PopRax()
        Emit_PopRdx()
        Trans_Asm("MOVQ xmm1, rax")

        Trans_Asm("MOV rax, rdx")
        Trans_Asm("AND rax, 3")
        Trans_Asm("CMP rax, 1")
        Emit_Je(lab_odd)
        Trans_Asm("CMP rax, 3")
        Emit_Je(lab_odd)

        Trans_Asm("DIVSD xmm1, xmm0")
        Trans_Asm("MOVSD xmm0, xmm1")
        Emit_Jmp(lab_store)

        Emit_MarkLabel(lab_odd)
        Trans_Asm("DIVSD xmm0, xmm1")
        Trans_NegateXmm0()

        Emit_MarkLabel(lab_store)
        Trans_Asm("MOVQ rax, xmm0")
        Emit_Jmp(lab_done)

        Emit_MarkLabel(lab_nan)
        qn = TransConst.QNAN
        asm = "MOV rax, "
        nstr = NumberToString(qn)
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Emit_MarkLabel(lab_done)
        ReturnValue(1)
    }
}

Function.Trans_CompileFloatAtan2 {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[TRANS] Float_Atan2 requires 2 arguments (y, x)\n")
            ReturnValue(0)
        }
        arg_y = AST_GetChild(node, 0)
        arg_x = AST_GetChild(node, 1)
        Compile_Expression(arg_y)
        Emit_PushRax()
        Compile_Expression(arg_x)
        Trans_Asm("MOV rbx, rax")
        Emit_PopRsi()

        lab_nan = Compile_NewLabel()
        lab_done = Compile_NewLabel()
        lab_y_ok = Compile_NewLabel()
        lab_x_ok = Compile_NewLabel()
        lab_not_both_inf = Compile_NewLabel()
        lab_y_one = Compile_NewLabel()
        lab_x_one = Compile_NewLabel()
        lab_x_one_pos = Compile_NewLabel()
        lab_x_nz = Compile_NewLabel()
        lab_axis_pi = Compile_NewLabel()
        lab_axis_pi2 = Compile_NewLabel()
        lab_y_nz = Compile_NewLabel()
        lab_x_pos = Compile_NewLabel()
        lab_y_pos = Compile_NewLabel()
        lab_y_zero_xpos = Compile_NewLabel()
        lab_store = Compile_NewLabel()

        Trans_Asm("MOV rax, rsi")
        Trans_Asm("SHR rax, 52")
        Trans_Asm("AND rax, 2047")
        Trans_Asm("CMP rax, 2047")
        Emit_Jne(lab_y_ok)
        Trans_Asm("MOV rax, rsi")
        Trans_Asm("SHL rax, 12")
        Trans_Asm("SHR rax, 12")
        Trans_Asm("TEST rax, rax")
        Emit_Jnz(lab_nan)
        Emit_MarkLabel(lab_y_ok)

        Trans_Asm("MOV rax, rbx")
        Trans_Asm("SHR rax, 52")
        Trans_Asm("AND rax, 2047")
        Trans_Asm("CMP rax, 2047")
        Emit_Jne(lab_x_ok)
        Trans_Asm("MOV rax, rbx")
        Trans_Asm("SHL rax, 12")
        Trans_Asm("SHR rax, 12")
        Trans_Asm("TEST rax, rax")
        Emit_Jnz(lab_nan)
        Emit_MarkLabel(lab_x_ok)

        Trans_Asm("MOV rax, rsi")
        Trans_Asm("SHR rax, 52")
        Trans_Asm("AND rax, 2047")
        Trans_Asm("CMP rax, 2047")
        Emit_Jne(lab_not_both_inf)
        Trans_Asm("MOV rax, rbx")
        Trans_Asm("SHR rax, 52")
        Trans_Asm("AND rax, 2047")
        Trans_Asm("CMP rax, 2047")
        Emit_Jne(lab_not_both_inf)
        Trans_Asm("MOV rax, rsi")
        Trans_Asm("SHR rax, 63")
        Trans_Asm("TEST rax, rax")
        oneb = TransConst.ONE
        n1 = TransConst.NEG_ONE
        Emit_Jz(lab_y_one)
        nstr = NumberToString(n1)
        asm = "MOV rsi, "
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Emit_Jmp(lab_x_one)
        Emit_MarkLabel(lab_y_one)
        nstr = NumberToString(oneb)
        asm = "MOV rsi, "
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Emit_MarkLabel(lab_x_one)
        Trans_Asm("MOV rax, rbx")
        Trans_Asm("SHR rax, 63")
        Trans_Asm("TEST rax, rax")
        Emit_Jz(lab_x_one_pos)
        nstr = NumberToString(n1)
        asm = "MOV rbx, "
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Emit_Jmp(lab_not_both_inf)
        Emit_MarkLabel(lab_x_one_pos)
        nstr = NumberToString(oneb)
        asm = "MOV rbx, "
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)

        Emit_MarkLabel(lab_not_both_inf)

        Trans_Asm("MOV rax, rbx")
        Trans_Asm("SHL rax, 1")
        Trans_Asm("SHR rax, 1")
        Trans_Asm("TEST rax, rax")
        Emit_Jnz(lab_x_nz)
        Trans_Asm("MOV rax, rsi")
        Trans_Asm("SHL rax, 1")
        Trans_Asm("SHR rax, 1")
        Trans_Asm("TEST rax, rax")
        Emit_Jnz(lab_axis_pi2)
        Trans_Asm("MOV rax, rbx")
        Trans_Asm("SHR rax, 63")
        Trans_Asm("TEST rax, rax")
        Emit_Jz(lab_y_zero_xpos)
        Emit_Jmp(lab_axis_pi)

        Emit_MarkLabel(lab_x_nz)
        Trans_Asm("MOV rax, rsi")
        Trans_Asm("SHL rax, 1")
        Trans_Asm("SHR rax, 1")
        Trans_Asm("TEST rax, rax")
        Emit_Jnz(lab_y_nz)
        Trans_Asm("MOV rax, rbx")
        Trans_Asm("SHR rax, 63")
        Trans_Asm("TEST rax, rax")
        Emit_Jz(lab_y_zero_xpos)
        Emit_Jmp(lab_axis_pi)
        Emit_MarkLabel(lab_y_zero_xpos)
        Trans_Asm("MOV rax, rsi")
        Emit_Jmp(lab_done)

        Emit_MarkLabel(lab_axis_pi2)
        ph = TransConst.PI_OVER_2
        Trans_LoadDoubleXmm0(ph)
        Emit_Jmp(lab_y_pos)

        Emit_MarkLabel(lab_axis_pi)
        pv = TransConst.PI
        Trans_LoadDoubleXmm0(pv)
        Emit_Jmp(lab_y_pos)

        Emit_MarkLabel(lab_y_nz)
        Trans_Asm("MOV rax, rsi")
        Trans_Asm("SHL rax, 1")
        Trans_Asm("SHR rax, 1")
        Trans_Asm("MOVQ xmm0, rax")
        Trans_Asm("MOV rax, rbx")
        Trans_Asm("SHL rax, 1")
        Trans_Asm("SHR rax, 1")
        Trans_Asm("MOVQ xmm1, rax")
        Trans_Asm("DIVSD xmm0, xmm1")
        Emit_PushRbx()
        Emit_PushRsi()
        Trans_AtanPositive()
        Emit_PopRsi()
        Emit_PopRbx()

        Trans_Asm("MOV rax, rbx")
        Trans_Asm("SHR rax, 63")
        Trans_Asm("TEST rax, rax")
        Emit_Jz(lab_x_pos)
        pv2 = TransConst.PI
        Trans_LoadXmm1KeepXmm0(pv2)
        Trans_Asm("SUBSD xmm1, xmm0")
        Trans_Asm("MOVSD xmm0, xmm1")
        Emit_MarkLabel(lab_x_pos)

        Emit_MarkLabel(lab_y_pos)
        Trans_Asm("MOV rax, rsi")
        Trans_Asm("SHR rax, 63")
        Trans_Asm("TEST rax, rax")
        Emit_Jz(lab_store)
        Trans_NegateXmm0()
        Emit_MarkLabel(lab_store)
        Trans_Asm("MOVQ rax, xmm0")
        Emit_Jmp(lab_done)

        Emit_MarkLabel(lab_nan)
        qn = TransConst.QNAN
        asm = "MOV rax, "
        nstr = NumberToString(qn)
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Emit_MarkLabel(lab_done)
        ReturnValue(1)
    }
}

// XMM0 = x. Result exp(x) in XMM0. Uses RBX, RDX, RSI, RAX, XMM1.
Function.Trans_EvalExpXmm0 {
    Body: {
        lab_ov = Compile_NewLabel()
        lab_un = Compile_NewLabel()
        lab_nan = Compile_NewLabel()
        lab_keep = Compile_NewLabel()
        lab_done = Compile_NewLabel()

        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("MOV rdx, rax")
        Trans_Asm("SHR rax, 52")
        Trans_Asm("AND rax, 2047")
        Trans_Asm("CMP rax, 2047")
        Emit_Je(lab_nan)

        ov = TransConst.EXP_OV
        Trans_LoadXmm1KeepXmm0(ov)
        Trans_Asm("UCOMISD xmm0, xmm1")
        Emit_Ja(lab_ov)
        un = TransConst.EXP_UN
        Trans_LoadXmm1KeepXmm0(un)
        Trans_Asm("UCOMISD xmm0, xmm1")
        Emit_Jb(lab_un)

        inv = TransConst.INV_LN2
        Trans_LoadXmm1KeepXmm0(inv)
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("CVTSD2SI rax, xmm0")
        Trans_Asm("MOV rbx, rax")
        Trans_Asm("CVTSI2SD xmm1, rax")
        Trans_Asm("MOVQ rcx, xmm1")
        hi = TransConst.LN2_HI
        Trans_LoadDoubleXmm0(hi)
        Trans_Asm("MOVQ xmm1, rcx")
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVSD xmm1, xmm0")
        Trans_Asm("MOVQ xmm0, rdx")
        Trans_Asm("SUBSD xmm0, xmm1")
        Trans_Asm("MOVQ rax, xmm0")
        Emit_PushRax()
        lo = TransConst.LN2_LO
        Trans_LoadDoubleXmm0(lo)
        Trans_Asm("MOVQ xmm1, rcx")
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVSD xmm1, xmm0")
        Emit_PopRax()
        Trans_Asm("MOVQ xmm0, rax")
        Trans_Asm("SUBSD xmm0, xmm1")
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("MOV rsi, rax")
        c10 = TransConst.INV10F
        Trans_LoadDoubleXmm0(c10)
        c9 = TransConst.INV9F

        Trans_HornerR(c9)
        c8 = TransConst.INV8F
        Trans_HornerR(c8)
        c7e = TransConst.INV5040
        Trans_HornerR(c7e)
        c720 = TransConst.INV720
        Trans_HornerR(c720)
        c120 = TransConst.INV120
        Trans_HornerR(c120)
        c24 = TransConst.INV24
        Trans_HornerR(c24)
        c6 = TransConst.INV6
        Trans_HornerR(c6)
        hf = TransConst.HALF
        Trans_HornerR(hf)
        one = TransConst.ONE
        Trans_HornerR(one)
        Trans_HornerR(one)
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("SHL rbx, 52")
        Trans_Asm("ADD rax, rbx")
        Trans_Asm("MOVQ xmm0, rax")
        Emit_Jmp(lab_done)

        Emit_MarkLabel(lab_ov)
        pinf = TransConst.PINF
        Trans_LoadDoubleXmm0(pinf)
        Emit_Jmp(lab_done)

        Emit_MarkLabel(lab_un)
        Trans_Asm("PXOR xmm0, xmm0")
        Emit_Jmp(lab_done)

        Emit_MarkLabel(lab_nan)
        Trans_Asm("MOV rax, rdx")
        Trans_Asm("SHL rax, 12")
        Trans_Asm("SHR rax, 12")
        Trans_Asm("TEST rax, rax")
        Emit_Jnz(lab_keep)
        Trans_Asm("MOV rax, rdx")
        Trans_Asm("SHR rax, 63")
        Trans_Asm("TEST rax, rax")
        Emit_Jnz(lab_un)
        pinf2 = TransConst.PINF
        Trans_LoadDoubleXmm0(pinf2)
        Emit_Jmp(lab_done)
        Emit_MarkLabel(lab_keep)
        Trans_Asm("MOVQ xmm0, rdx")
        Emit_MarkLabel(lab_done)
    }
}

// XMM0 = x > 0 finite. Result ln(x) in XMM0. Uses RBX, RSI, RAX, XMM1.
Function.Trans_EvalLogXmm0 {
    Body: {
        lab_gt = Compile_NewLabel()
        lab_poly = Compile_NewLabel()

        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("MOV rdx, rax")
        Trans_Asm("SHR rax, 52")
        Trans_Asm("AND rax, 2047")
        Trans_Asm("SUB rax, 1023")
        Trans_Asm("MOV rbx, rax")
        Trans_Asm("MOV rax, rdx")
        Trans_Asm("SHL rax, 12")
        Trans_Asm("SHR rax, 12")
        oneb = TransConst.EXP_ONE
        nstr = NumberToString(oneb)
        asm = "MOV rcx, "
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Trans_Asm("OR rax, rcx")
        Trans_Asm("MOVQ xmm0, rax")
        sq = TransConst.SQRT2
        Trans_LoadXmm1KeepXmm0(sq)
        Trans_Asm("UCOMISD xmm0, xmm1")
        Emit_Jbe(lab_gt)
        hf = TransConst.HALF
        Trans_LoadXmm1KeepXmm0(hf)
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("INC rbx")
        Emit_MarkLabel(lab_gt)
        one = TransConst.ONE
        Trans_LoadXmm1KeepXmm0(one)
        Trans_Asm("SUBSD xmm0, xmm1")
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("MOV rsi, rax")
        n15 = TransConst.INV15
        Trans_LoadDoubleXmm0(n15)
        n14 = TransConst.NINV14
        Trans_HornerR(n14)
        c13 = TransConst.INV13
        Trans_HornerR(c13)
        n12 = TransConst.NINV12
        Trans_HornerR(n12)
        c11 = TransConst.INV11
        Trans_HornerR(c11)
        n10 = TransConst.NINV10
        Trans_HornerR(n10)
        c9l = TransConst.INV9
        Trans_HornerR(c9l)
        n8 = TransConst.NINV8
        Trans_HornerR(n8)
        c7 = TransConst.INV7
        Trans_HornerR(c7)
        n6 = TransConst.NINV6
        Trans_HornerR(n6)
        c5 = TransConst.INV5
        Trans_HornerR(c5)
        n4 = TransConst.NINV4
        Trans_HornerR(n4)
        c3 = TransConst.INV3
        Trans_HornerR(c3)
        n2 = TransConst.NINV2
        Trans_HornerR(n2)
        Trans_HornerR(one)
        Trans_Asm("MOVQ xmm1, rsi")
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("MOV rsi, rax")
        Trans_Asm("CVTSI2SD xmm0, rbx")
        ln = TransConst.LN2
        Trans_LoadXmm1KeepXmm0(ln)
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVQ xmm1, rsi")
        Trans_Asm("ADDSD xmm0, xmm1")
    }
}

Function.Trans_CompileFloatExp {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[TRANS] Float_Exp requires 1 argument\n")
            ReturnValue(0)
        }
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)
        Emit_PushRbx()
        Trans_Asm("MOVQ xmm0, rax")
        Trans_EvalExpXmm0()
        Trans_Asm("MOVQ rax, xmm0")
        Emit_PopRbx()
        ReturnValue(1)
    }
}

Function.Trans_CompileFloatLog {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[TRANS] Float_Log requires 1 argument\n")
            ReturnValue(0)
        }
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)
        Emit_PushRbx()
        Trans_Asm("MOVQ xmm0, rax")
        lab_bad = Compile_NewLabel()
        lab_ok = Compile_NewLabel()
        lab_done = Compile_NewLabel()
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("TEST rax, rax")
        Emit_Jz(lab_bad)
        Trans_Asm("MOV rdx, rax")
        Trans_Asm("SHR rdx, 63")
        Trans_Asm("TEST rdx, rdx")
        Emit_Jnz(lab_bad)
        Trans_Asm("MOV rdx, rax")
        Trans_Asm("SHR rdx, 52")
        Trans_Asm("AND rdx, 2047")
        Trans_Asm("CMP rdx, 2047")
        Emit_Je(lab_bad)
        Trans_EvalLogXmm0()
        Emit_Jmp(lab_ok)
        Emit_MarkLabel(lab_bad)
        qn = TransConst.QNAN
        nstr = NumberToString(qn)
        asm = "MOV rax, "
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Trans_Asm("MOVQ xmm0, rax")
        Emit_MarkLabel(lab_ok)
        Trans_Asm("MOVQ rax, xmm0")
        Emit_PopRbx()
        ReturnValue(1)
    }
}

Function.Trans_CompileFloatPow {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[TRANS] Float_Pow requires 2 arguments (base, exponent)\n")
            ReturnValue(0)
        }
        arg_x = AST_GetChild(node, 0)
        arg_y = AST_GetChild(node, 1)
        Compile_Expression(arg_y)
        Emit_PushRax()
        Compile_Expression(arg_x)
        Emit_PushRbx()
        Trans_Asm("MOVQ xmm0, rax")
        lab_bad = Compile_NewLabel()
        lab_one = Compile_NewLabel()
        lab_ok = Compile_NewLabel()
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("TEST rax, rax")
        Emit_Js(lab_bad)
        Emit_Jz(lab_bad)
        Trans_EvalLogXmm0()
        Emit_PopRbx()
        Emit_PopRax()
        Trans_Asm("MOVQ xmm1, rax")
        Trans_Asm("MULSD xmm0, xmm1")
        Emit_PushRbx()
        Trans_EvalExpXmm0()
        Emit_PopRbx()
        Trans_Asm("MOVQ rax, xmm0")
        Emit_Jmp(lab_ok)
        Emit_MarkLabel(lab_bad)
        Emit_PopRbx()
        Emit_PopRax()
        qn = TransConst.QNAN
        nstr = NumberToString(qn)
        asm = "MOV rax, "
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Emit_MarkLabel(lab_ok)
        ReturnValue(1)
    }
}

// =============================================================================
// DISPATCHER
// Called from FPUCompileX86_TryCompile before it returns 0. Recognizes the
// seven transcendental function names and routes to per-function compile
// routines. Returns 1 if emit succeeded.
// =============================================================================
Function.Trans_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }

        func_name = AST_GetData1(node)
        IfCondition EqualTo(func_name, 0) ThenBlock: { ReturnValue(0) }

        cmp = StringCompare(func_name, "Float_Sin")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            sin_ok = Trans_CompileFloatSin(node)
            ReturnValue(sin_ok)
        }
        cmp = StringCompare(func_name, "Float_Cos")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cos_ok = Trans_CompileFloatCos(node)
            ReturnValue(cos_ok)
        }
        cmp = StringCompare(func_name, "Float_Tan")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tan_ok = Trans_CompileFloatTan(node)
            ReturnValue(tan_ok)
        }
        cmp = StringCompare(func_name, "Float_Atan2")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            atan_ok = Trans_CompileFloatAtan2(node)
            ReturnValue(atan_ok)
        }
        cmp = StringCompare(func_name, "Float_Exp")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            exp_ok = Trans_CompileFloatExp(node)
            ReturnValue(exp_ok)
        }
        cmp = StringCompare(func_name, "Float_Log")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            log_ok = Trans_CompileFloatLog(node)
            ReturnValue(log_ok)
        }
        cmp = StringCompare(func_name, "Float_Pow")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            pow_ok = Trans_CompileFloatPow(node)
            ReturnValue(pow_ok)
        }

        ReturnValue(0)
    }
}
