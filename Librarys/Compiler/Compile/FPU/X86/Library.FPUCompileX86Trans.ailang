// Library.FPUCompileX86Trans.ailang
// X86-64 SSE2 transcendental function compilation
// Float_Sin is live. Cos/Tan/Atan2/Exp/Log/Pow still scaffold.
// Location: Librarys/Compiler/Compile/FPU/X86/Library.FPUCompileX86Trans.ailang
//
// Dispatches Float_Sin/Cos/Tan/Atan2/Exp/Log/Pow to per-function compile
// routines. Each routine ships as "recognized at compile, not yet
// implemented" for now — the dispatcher, constant pool, and data-section
// loader helpers are all in place so the remaining work is purely filling
// in polynomial bodies.
//
// Scope deferred to a dedicated implementation session:
//   1. XMM2/XMM3 emitter variants (MOVSD/MULSD/ADDSD/MOVAPD) so
//      polynomial evaluation can keep r and r² in registers without
//      stack spilling.
//   2. Range reduction: x → r in [-π/4, π/4] with quadrant tracking.
//      MVP uses single π/2 subtraction; large-|x| accuracy matches
//      fdlibm pre-Payne–Hanek.
//   3. Remez/fdlibm polynomial bodies (coefficients already encoded
//      as IEEE bit patterns in TransConst below).
//
// Value convention matches the rest of the Float_* backend:
//   - Arguments arrive as IEEE 754 bit patterns in RAX after
//     Compile_Expression(arg).
//   - Move bits to XMM0 via X86_MOVQ_XMM0_RAX for math.
//   - Result bits end up back in RAX via X86_MOVQ_RAX_XMM0.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.CodeEmit.X86.CEmitX86Enc

// =============================================================================
// POLYNOMIAL COEFFICIENTS
// IEEE 754 double bit patterns for fdlibm's sin/cos/exp/log minimax
// approximations. Kept here so the constant table is co-located with the
// compile routines that use it.
// =============================================================================
FixedPool.TransConst {
    // Taylor Horner on [-π/4, π/4]. Bits verified with Python struct '<d'.
    // sin(r) ≈ r · (1 + r² · (S1 + r² · (S3 + r² · (S5 + r² · S7))))
    "SIN_S1":    Initialize=-4628199217061079723      // -1/6
    "SIN_S3":    Initialize=4575957461383581969       //  1/120
    "SIN_S5":    Initialize=-4671919876300759014      // -1/5040
    "SIN_S7":    Initialize=4523617214285662004       //  1/362880
    "SIN_S9":    Initialize=-4730215272828025628      // -1/11!
    "SIN_S11":   Initialize=4460272573143870729       //  1/13!
    "SIN_S13":   Initialize=-4797767418267846625      // -1/15!

    // cos(r) ≈ 1 + r² · (-1/2 + r² · (1/24 + r² · (-1/720 + r² · (1/40320 + ...))))
    "COS_C24":   Initialize=4586165620538955093       //  1/24
    "COS_C720":  Initialize=-4659324094485795817      // -1/720
    "COS_C8":    Initialize=4537941361671905306       //  1/40320
    "COS_C10":   Initialize=-4714566979057836196      // -1/10!
    "COS_C12":   Initialize=4477122120089393304       //  1/12!
    "COS_C14":   Initialize=-4780226356266894179      // -1/14!
    "COS_C16":   Initialize=4407590220077447199       //  1/16!

    "PI_OVER_2":     Initialize=4609753056924675352   //  π/2
    "PI_2_HI":       Initialize=4609753056924401664   //  π/2 high
    "PI_2_LO":       Initialize=4454258360616903473   //  π/2 tail
    "PI_OVER_4":     Initialize=4608983858650965898   //  π/4
    "PI":            Initialize=4614256656552045848   //  π
    "TWO_PI":        Initialize=4618760256179416344   //  2π
    "ONE":           Initialize=4607182418800017408   //  1.0
    "HALF":          Initialize=4602678819172646912   //  0.5
    "NEG_HALF":      Initialize=-4620693217682128896  // -0.5
    "NEG_ONE":       Initialize=-4616189618054758400  // -1.0
    "TWO_OVER_PI":   Initialize=4603909380684499075   //  2/π
    "SIGN_MASK":     Initialize=-9223372036854775808  // -0.0  sign bit
    "QNAN":          Initialize=9221120237041090560   // quiet NaN
}

// =============================================================================
// CONSTANT EMISSION
// IEEE 754 doubles live in the data section; a 64-bit bit pattern emits as
// 8 little-endian bytes. Returns the data-section offset so the linker
// relocation machinery (same one string constants use) can patch absolute
// addresses.
// =============================================================================
Function.Trans_EmitDoubleBits {
    Input: bits: Integer
    Output: Integer
    Body: {
        offset = Emit.data_size
        i = 0
        WhileLoop LessThan(i, 8) {
            byte = BitwiseAnd(RightShift(bits, Multiply(i, 8)), 255)
            Emit_DataByte(byte)
            i = Add(i, 1)
        }
        ReturnValue(offset)
    }
}

// Emit: MOV RAX, <abs data addr> ; MOVSD XMM0, [RAX]
// Net: XMM0 = the double constant whose bits were passed in. Clobbers RAX.
Function.Trans_LoadDoubleXmm0 {
    Input: bits: Integer
    Body: {
        data_off = Trans_EmitDoubleBits(bits)
        X86_MovRaxDataOffset(data_off)
        X86_MOVSD_XMM0_DerefRax()
    }
}

// Same but into XMM1 via the XMM0→XMM1 bridge.
Function.Trans_LoadDoubleXmm1 {
    Input: bits: Integer
    Body: {
        Trans_LoadDoubleXmm0(bits)
        Trans_Asm("MOVSD xmm1, xmm0")
    }
}

Function.Trans_Asm {
    Input: s: Address
    Body: {
        ok = X86Enc_Assemble(s)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[TRANS] encode failed: ")
            PrintMessage(s)
            PrintMessage("\n")
        }
    }
}

// Load bits into XMM1, preserve XMM0.
Function.Trans_LoadXmm1KeepXmm0 {
    Input: bits: Integer
    Body: {
        X86_PushXMM0()
        data_off = Trans_EmitDoubleBits(bits)
        X86_MovRaxDataOffset(data_off)
        X86_MOVSD_XMM0_DerefRax()
        Trans_Asm("MOVSD xmm1, xmm0")
        X86_PopXMM0()
    }
}

// XMM0 = acc. RCX holds r² bits. acc = acc * r² + coeff
Function.Trans_HornerR2 {
    Input: coeff_bits: Integer
    Body: {
        Trans_Asm("MOVQ xmm1, rcx")
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_LoadXmm1KeepXmm0(coeff_bits)
        Trans_Asm("ADDSD xmm0, xmm1")
    }
}

// XMM0 = r on entry. RCX = r² bits, RSI = r bits. Result in XMM0.
Function.Trans_EvalSinPoly {
    Body: {
        Trans_Asm("MOVQ rax, xmm0")
        Trans_Asm("MOV rsi, rax")
        Trans_Asm("MOVSD xmm1, xmm0")
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVQ rcx, xmm0")
        s13 = TransConst.SIN_S13
        Trans_LoadDoubleXmm0(s13)
        s11 = TransConst.SIN_S11
        Trans_HornerR2(s11)
        s9 = TransConst.SIN_S9
        Trans_HornerR2(s9)
        s7 = TransConst.SIN_S7
        Trans_HornerR2(s7)
        s5 = TransConst.SIN_S5
        Trans_HornerR2(s5)
        s3 = TransConst.SIN_S3
        Trans_HornerR2(s3)
        s1 = TransConst.SIN_S1
        Trans_HornerR2(s1)
        one = TransConst.ONE
        Trans_HornerR2(one)
        Trans_Asm("MOVQ xmm1, rsi")
        Trans_Asm("MULSD xmm0, xmm1")
    }
}

Function.Trans_EvalCosPoly {
    Body: {
        Trans_Asm("MOVSD xmm1, xmm0")
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVQ rcx, xmm0")
        c16 = TransConst.COS_C16
        Trans_LoadDoubleXmm0(c16)
        c14 = TransConst.COS_C14
        Trans_HornerR2(c14)
        c12 = TransConst.COS_C12
        Trans_HornerR2(c12)
        c10 = TransConst.COS_C10
        Trans_HornerR2(c10)
        c8 = TransConst.COS_C8
        Trans_HornerR2(c8)
        c720 = TransConst.COS_C720
        Trans_HornerR2(c720)
        c24 = TransConst.COS_C24
        Trans_HornerR2(c24)
        nh = TransConst.NEG_HALF
        Trans_HornerR2(nh)
        one = TransConst.ONE
        Trans_HornerR2(one)
    }
}

// =============================================================================
// PER-FUNCTION COMPILE ROUTINES
// All currently return 0 with a specific diagnostic. Scaffolding (arg count
// check, future range reduction hooks) is in place; polynomial bodies
// pending implementation in follow-up work.
// =============================================================================

// RAX = IEEE bits in. On Inf/NaN jumps to lab_nan.
// Else XMM0 = r in [-π/4, π/4], RDX = n = round(x * 2/π), RBX = original bits.
Function.Trans_ReduceFromRax {
    Input: lab_nan: Integer
    Body: {
        Trans_Asm("MOV rbx, rax")
        Trans_Asm("SHR rax, 52")
        Trans_Asm("AND rax, 2047")
        Trans_Asm("CMP rax, 2047")
        Emit_Je(lab_nan)

        Trans_Asm("MOV rax, rbx")
        Trans_Asm("MOVQ xmm0, rax")

        two_over_pi = TransConst.TWO_OVER_PI
        Trans_LoadXmm1KeepXmm0(two_over_pi)
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("CVTSD2SI rax, xmm0")
        Trans_Asm("MOV rdx, rax")

        Trans_Asm("CVTSI2SD xmm0, rax")
        hi = TransConst.PI_2_HI
        Trans_LoadXmm1KeepXmm0(hi)
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVSD xmm1, xmm0")
        Trans_Asm("MOV rax, rbx")
        Trans_Asm("MOVQ xmm0, rax")
        Trans_Asm("SUBSD xmm0, xmm1")
        X86_PushXMM0()
        Trans_Asm("MOV rax, rdx")
        Trans_Asm("CVTSI2SD xmm0, rax")
        lo = TransConst.PI_2_LO
        Trans_LoadXmm1KeepXmm0(lo)
        Trans_Asm("MULSD xmm0, xmm1")
        Trans_Asm("MOVSD xmm1, xmm0")
        X86_PopXMM0()
        Trans_Asm("SUBSD xmm0, xmm1")
    }
}

Function.Trans_NegateXmm0 {
    Body: {
        sm = TransConst.SIGN_MASK
        Trans_LoadXmm1KeepXmm0(sm)
        Trans_Asm("XORPD xmm0, xmm1")
    }
}

Function.Trans_CompileFloatSin {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[TRANS] Float_Sin requires 1 argument\n")
            ReturnValue(0)
        }
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)

        lab_nan = Compile_NewLabel()
        lab_done = Compile_NewLabel()
        lab_cos = Compile_NewLabel()
        lab_after_poly = Compile_NewLabel()
        lab_pos = Compile_NewLabel()

        Trans_ReduceFromRax(lab_nan)

        Trans_Asm("MOV rax, rdx")
        Trans_Asm("AND rax, 3")
        Trans_Asm("CMP rax, 1")
        Emit_Je(lab_cos)
        Trans_Asm("CMP rax, 3")
        Emit_Je(lab_cos)
        Trans_EvalSinPoly()
        Emit_Jmp(lab_after_poly)
        Emit_MarkLabel(lab_cos)
        Trans_EvalCosPoly()
        Emit_MarkLabel(lab_after_poly)

        Trans_Asm("MOV rax, rdx")
        Trans_Asm("AND rax, 3")
        Trans_Asm("CMP rax, 2")
        Emit_Jb(lab_pos)
        Trans_NegateXmm0()
        Emit_MarkLabel(lab_pos)
        Trans_Asm("MOVQ rax, xmm0")
        Emit_Jmp(lab_done)

        Emit_MarkLabel(lab_nan)
        qn = TransConst.QNAN
        asm = "MOV rax, "
        nstr = NumberToString(qn)
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Emit_MarkLabel(lab_done)
        ReturnValue(1)
    }
}

Function.Trans_CompileFloatCos {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[TRANS] Float_Cos requires 1 argument\n")
            ReturnValue(0)
        }
        arg = AST_GetChild(node, 0)
        Compile_Expression(arg)

        lab_nan = Compile_NewLabel()
        lab_done = Compile_NewLabel()
        lab_sin = Compile_NewLabel()
        lab_after_poly = Compile_NewLabel()
        lab_neg = Compile_NewLabel()
        lab_store = Compile_NewLabel()

        Trans_ReduceFromRax(lab_nan)

        Trans_Asm("MOV rax, rdx")
        Trans_Asm("AND rax, 3")
        Trans_Asm("CMP rax, 1")
        Emit_Je(lab_sin)
        Trans_Asm("CMP rax, 3")
        Emit_Je(lab_sin)
        Trans_EvalCosPoly()
        Emit_Jmp(lab_after_poly)
        Emit_MarkLabel(lab_sin)
        Trans_EvalSinPoly()
        Emit_MarkLabel(lab_after_poly)

        Trans_Asm("MOV rax, rdx")
        Trans_Asm("AND rax, 3")
        Trans_Asm("CMP rax, 1")
        Emit_Je(lab_neg)
        Trans_Asm("CMP rax, 2")
        Emit_Je(lab_neg)
        Emit_Jmp(lab_store)
        Emit_MarkLabel(lab_neg)
        Trans_NegateXmm0()
        Emit_MarkLabel(lab_store)
        Trans_Asm("MOVQ rax, xmm0")
        Emit_Jmp(lab_done)

        Emit_MarkLabel(lab_nan)
        qn = TransConst.QNAN
        asm = "MOV rax, "
        nstr = NumberToString(qn)
        asm = StringConcat(asm, nstr)
        Trans_Asm(asm)
        Emit_MarkLabel(lab_done)
        ReturnValue(1)
    }
}

