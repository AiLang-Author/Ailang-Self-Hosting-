}

// =============================================================================
// SSE4.1 — PACKED SIGN/ZERO EXTEND
// =============================================================================

// PMOVSXWD XMM0, XMM1 — 66 0F 38 23 C1
// Sign-extend 4×16-bit in low 64 bits of XMM1 to 4×32-bit in XMM0
Function.X86_PMOVSXWD_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x38)
