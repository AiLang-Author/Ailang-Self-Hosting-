        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PMOVZXWD XMM0, XMM1 — 66 0F 38 33 C1
// Zero-extend 4×16-bit in low 64 bits of XMM1 to 4×32-bit in XMM0
Function.X86_PMOVZXWD_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x38)
        Emit_Byte(0x33)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PMOVSXBW XMM0, XMM1 — 66 0F 38 20 C1
// Sign-extend 8×8-bit in low 64 bits of XMM1 to 8×16-bit in XMM0
Function.X86_PMOVSXBW_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x38)
