// =============================================================================
// AVX — VEX-ENCODED PACKED DOUBLE (3-operand non-destructive)
// VEX for packed double (pp=01 = 66 prefix equiv):
//   VADDPD XMM0, XMM0, XMM1: C5 F9 58 C1
//     C5 = 2-byte VEX; F9 = 1_1111_0_01 (R=1,vvvv=~0=1111,L=0,pp=01)
// =============================================================================

// VADDPD XMM0, XMM0, XMM1 — C5 F9 58 C1
Function.X86_VADDPD_XMM0_XMM0_XMM1 {
    Body: {
        Emit_Byte(0xC5)
        Emit_Byte(0xF9)
        Emit_Byte(0x58)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

