    }
}

// PMOVSXDQ XMM0, XMM1 — 66 0F 38 25 C1
// Sign-extend 2×32-bit in low 64 bits of XMM1 to 2×64-bit in XMM0
Function.X86_PMOVSXDQ_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x38)
        Emit_Byte(0x25)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// SSE4.1 — ROUNDING
// =============================================================================

// ROUNDSD XMM0, XMM1, imm8 — 66 0F 3A 0B C1 <imm>
// Round scalar double in XMM1 to XMM0 per mode:
//   imm=0: round to nearest (even), imm=1: floor, imm=2: ceil, imm=3: truncate
Function.X86_ROUNDSD_XMM0_XMM1 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x3A)
        Emit_Byte(0x0B)
        Emit_Byte(0xC1)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// ROUNDPD XMM0, XMM1, imm8 — 66 0F 3A 09 C1 <imm>
// Round packed doubles in XMM1 to XMM0 per mode
Function.X86_ROUNDPD_XMM0_XMM1 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x3A)
        Emit_Byte(0x09)
        Emit_Byte(0xC1)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// SSE4.1 — DOT PRODUCT
// =============================================================================

// DPPD XMM0, XMM1, imm8 — 66 0F 3A 41 C1 <imm>
// Dot product of packed doubles with mask
//   imm bits [5:4] = input mask (which elements multiply)
//   imm bits [1:0] = output mask (which elements get result, rest zeroed)
//   imm=0x31: both inputs used, result in low element only
Function.X86_DPPD_XMM0_XMM1 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x3A)
        Emit_Byte(0x41)
        Emit_Byte(0xC1)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// SSE4.1 — EXTRACT / INSERT / BLEND / TEST
// =============================================================================

// EXTRACTPS EAX, XMM0, imm8 — 66 0F 3A 17 C0 <imm>
// Extract 32-bit float from XMM0[imm] into EAX
Function.X86_EXTRACTPS_EAX_XMM0 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x3A)
        Emit_Byte(0x17)
        Emit_Byte(0xC0)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PTEST XMM0, XMM1 — 66 0F 38 17 C1
// Test: ZF = (XMM0 AND XMM1 == 0), CF = (XMM0 ANDNOT XMM1 == 0)
Function.X86_PTEST_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x38)
        Emit_Byte(0x17)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PCMPEQD XMM0, XMM1 — 66 0F 76 C1
// Compare 4×32-bit integers for equality, set all-ones or all-zeros per lane
Function.X86_PCMPEQD_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x76)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PCMPGTD XMM0, XMM1 — 66 0F 66 C1
// Compare 4×32-bit signed integers, XMM0 > XMM1 → all-ones, else all-zeros
Function.X86_PCMPGTD_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x66)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

