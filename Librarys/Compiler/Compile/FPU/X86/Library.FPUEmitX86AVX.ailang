// =============================================================================
// AVX — ZERO UPPER
// =============================================================================

// VZEROUPPER — C5 F8 77
// Zero upper 128 bits of all YMM registers. Call at AVX/SSE transition boundary.
Function.X86_VZEROUPPER {
    Body: {
        Emit_Byte(0xC5)
        Emit_Byte(0xF8)
        Emit_Byte(0x77)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// AVX — VEX BROADCAST (from memory)
// =============================================================================

// VBROADCASTSD XMM0, [RAX] — C4 E2 79 19 00
// Broadcast 64-bit double from [RAX] to both lanes of XMM0
// VEX.256 version: C4 E2 7D 19 00 (broadcasts to all 4 lanes of YMM0)
Function.X86_VBROADCASTSD_XMM0_DerefRax {
    Body: {
        Emit_Byte(0xC4)
        Emit_Byte(0xE2)
        Emit_Byte(0x79)
        Emit_Byte(0x19)
        Emit_Byte(0x00)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// FMA3 — FUSED MULTIPLY-ADD (scalar double)
// VEX.128.66.0F38 prefix
//
// VFMADD231SD  XMM0, XMM1, XMM2: XMM0 = XMM1 * XMM2 + XMM0
// VFMSUB231SD  XMM0, XMM1, XMM2: XMM0 = XMM1 * XMM2 - XMM0
// VFNMADD231SD XMM0, XMM1, XMM2: XMM0 = -(XMM1 * XMM2) + XMM0
//
// 231 form chosen: accumulator is the destination (natural for dot products)
//
// VEX encoding: C4 E2 F1 <opcode> C2
//   C4 = 3-byte VEX prefix
//   E2 = R=1,X=1,B=1, mmmmm=00010 (0F38 escape)
//   F1 = W=1, vvvv=~XMM1=1110, L=0, pp=01 (66)
//   C2 = ModRM: mod=11, reg=XMM0(000), rm=XMM2(010)
// =============================================================================

// VFMADD231SD XMM0, XMM1, XMM2 — C4 E2 F1 B9 C2
// XMM0 = XMM1 * XMM2 + XMM0 (fused, single rounding)
Function.X86_VFMADD231SD_XMM0_XMM1_XMM2 {
    Body: {
        Emit_Byte(0xC4)
        Emit_Byte(0xE2)
        Emit_Byte(0xF1)
        Emit_Byte(0xB9)
        Emit_Byte(0xC2)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// VFMSUB231SD XMM0, XMM1, XMM2 — C4 E2 F1 BB C2
// XMM0 = XMM1 * XMM2 - XMM0 (fused, single rounding)
Function.X86_VFMSUB231SD_XMM0_XMM1_XMM2 {
    Body: {
        Emit_Byte(0xC4)
        Emit_Byte(0xE2)
        Emit_Byte(0xF1)
        Emit_Byte(0xBB)
        Emit_Byte(0xC2)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// VFNMADD231SD XMM0, XMM1, XMM2 — C4 E2 F1 BD C2
// XMM0 = -(XMM1 * XMM2) + XMM0 (fused, single rounding)
Function.X86_VFNMADD231SD_XMM0_XMM1_XMM2 {
    Body: {
        Emit_Byte(0xC4)
        Emit_Byte(0xE2)
        Emit_Byte(0xF1)
        Emit_Byte(0xBD)
        Emit_Byte(0xC2)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// FMA3 — FUSED MULTIPLY-ADD (packed double)
// =============================================================================

// VFMADD231PD XMM0, XMM1, XMM2 — C4 E2 F1 B8 C2
// XMM0 = XMM1 * XMM2 + XMM0 (2 × packed double, fused)
Function.X86_VFMADD231PD_XMM0_XMM1_XMM2 {
    Body: {
        Emit_Byte(0xC4)
        Emit_Byte(0xE2)
        Emit_Byte(0xF1)
        Emit_Byte(0xB8)
        Emit_Byte(0xC2)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// VFMSUB231PD XMM0, XMM1, XMM2 — C4 E2 F1 BA C2
// XMM0 = XMM1 * XMM2 - XMM0 (2 × packed double, fused)
Function.X86_VFMSUB231PD_XMM0_XMM1_XMM2 {
    Body: {
        Emit_Byte(0xC4)
        Emit_Byte(0xE2)
        Emit_Byte(0xF1)
        Emit_Byte(0xBA)
        Emit_Byte(0xC2)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// FMA3 — FUSED MULTIPLY-ADD (scalar single — for completeness)
// =============================================================================

// VFMADD231SS XMM0, XMM1, XMM2 — C4 E2 71 B9 C2
// XMM0 = XMM1 * XMM2 + XMM0 (scalar single, fused)
// Note: W=0 (71 vs F1), pp=01 (66 prefix implied)
Function.X86_VFMADD231SS_XMM0_XMM1_XMM2 {
    Body: {
        Emit_Byte(0xC4)
        Emit_Byte(0xE2)
        Emit_Byte(0x71)
        Emit_Byte(0xB9)
        Emit_Byte(0xC2)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// MOVDQA — ALIGNED 128-bit integer move
// =============================================================================

// MOVDQA XMM0, XMM1 — 66 0F 6F C1
Function.X86_MOVDQA_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
