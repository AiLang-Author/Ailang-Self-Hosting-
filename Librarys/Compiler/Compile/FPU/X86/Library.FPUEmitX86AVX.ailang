// =============================================================================
// AVX — VEX-ENCODED SCALAR DOUBLE (3-operand non-destructive)
// VEX.128 prefix: C5 xx (2-byte VEX)
//
// VEX 2-byte format: C5 <vvvv_Lpp>
//   For scalar double (pp=11 = F2 prefix equiv):
//     C5 <R̄ vvvv L pp>
//     R̄ = 1 (no REX.R), vvvv = ~src1, L = 0 (128-bit), pp = 11 (F2)
//
// VADDSD  XMM0, XMM1, XMM2: C4 E1 F3 58 C2 (needs 3-byte VEX for XMM2 encoding)
// Simpler: keep XMM0,XMM0,XMM1 pattern:
//   VADDSD XMM0, XMM0, XMM1: C5 FB 58 C1
//     C5 = 2-byte VEX; FB = 1_1111_0_11 (R=1,vvvv=~0=1111,L=0,pp=11)
// =============================================================================

// VADDSD XMM0, XMM0, XMM1 — C5 FB 58 C1
Function.X86_VADDSD_XMM0_XMM0_XMM1 {
    Body: {
        Emit_Byte(0xC5)
        Emit_Byte(0xFB)
        Emit_Byte(0x58)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// VSUBSD XMM0, XMM0, XMM1 — C5 FB 5C C1
Function.X86_VSUBSD_XMM0_XMM0_XMM1 {
    Body: {
        Emit_Byte(0xC5)
        Emit_Byte(0xFB)
        Emit_Byte(0x5C)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// VMULSD XMM0, XMM0, XMM1 — C5 FB 59 C1
Function.X86_VMULSD_XMM0_XMM0_XMM1 {
    Body: {
        Emit_Byte(0xC5)
        Emit_Byte(0xFB)
        Emit_Byte(0x59)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// VDIVSD XMM0, XMM0, XMM1 — C5 FB 5E C1
Function.X86_VDIVSD_XMM0_XMM0_XMM1 {
