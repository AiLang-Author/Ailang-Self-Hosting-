// Library.FPUEmitX86AVX.ailang
// X86-64 SSE4.1 / AVX / FMA3 instruction byte emission
// Location: Librarys/Compiler/Compile/FPU/X86/Library.FPUEmitX86AVX.ailang
//
// Raw byte emission for SSE4.1, AVX (VEX-encoded), and FMA3 instructions
// Targeting AMD Piledriver (FX-8320): SSE4.1, SSE4.2, AVX, FMA3, FMA4, XOP
// No AVX2 — all packed integer ops are 128-bit SSE4.1.
//
// Convention: same as FPUEmitX86SSE.ailang
//   - Operations on XMM0, XMM1, XMM2 -> result in XMM0
//   - Each function emits raw bytes + increments Emit.instructions_emitted
//   - VEX 3-operand form: dest=XMM0, src1=XMM1, src2=XMM2 (non-destructive)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.Compile.FPU.FPUTypes

// =============================================================================
// SSE4.1 — PACKED INTEGER (32-bit lanes, 128-bit XMM)
// =============================================================================

// PMULLD XMM0, XMM1 — 66 0F 38 40 C1
// XMM0 = XMM0 * XMM1 (4 × 32-bit signed integer multiply, low 32 bits each)
Function.X86_PMULLD_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x38)
        Emit_Byte(0x40)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PMADDWD XMM0, XMM1 — 66 0F F5 C1
// Multiply 8×16-bit signed pairs, add adjacent pairs → 4×32-bit results
// XMM0[31:0]   = XMM0[15:0]*XMM1[15:0] + XMM0[31:16]*XMM1[31:16]  (etc.)
Function.X86_PMADDWD_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0xF5)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PADDD XMM0, XMM1 — 66 0F FE C1
// XMM0 = XMM0 + XMM1 (4 × 32-bit integer add)
Function.X86_PADDD_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0xFE)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PSUBD XMM0, XMM1 — 66 0F FA C1
// XMM0 = XMM0 - XMM1 (4 × 32-bit integer subtract)
Function.X86_PSUBD_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0xFA)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PMINSD XMM0, XMM1 — 66 0F 38 39 C1
// XMM0 = min(XMM0, XMM1) (4 × 32-bit signed integer min)
Function.X86_PMINSD_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x38)
        Emit_Byte(0x39)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PMAXSD XMM0, XMM1 — 66 0F 38 3D C1
// XMM0 = max(XMM0, XMM1) (4 × 32-bit signed integer max)
Function.X86_PMAXSD_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x38)
        Emit_Byte(0x3D)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PABSD XMM0, XMM1 — 66 0F 38 1E C1
// XMM0 = abs(XMM1) (4 × 32-bit signed integer absolute value)
Function.X86_PABSD_XMM0_XMM1 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x38)
        Emit_Byte(0x1E)
        Emit_Byte(0xC1)
