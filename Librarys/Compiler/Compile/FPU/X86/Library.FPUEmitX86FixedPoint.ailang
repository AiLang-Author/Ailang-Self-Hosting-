// Library.FPUEmitX86FixedPoint.ailang
// X86-64 instruction emission for fixed-point arithmetic primitives
// Location: Librarys/Compiler/Compile/FPU/X86/Library.FPUEmitX86FixedPoint.ailang
//
// Only NEW instructions not already in CEmitX86*.ailang:
//   IMUL r/m64 (one-operand: RDX:RAX = RAX * r/m64, signed 128-bit)
//   IMUL EAX, ECX (32-bit two-operand)
//   SHRD RAX, RDX, imm8 (double-precision shift right)
//   SAR EAX, imm8 (32-bit arithmetic shift right)
//   MOV RDX, 1 (for 2^64 setup)
//   MOVSX/MOVSXD (sign extension helpers)
//
// Already available in CodeEmit (DO NOT redefine here):
//   X86_DivRcx, X86_XorRdxRdx, X86_XorRaxRax, X86_MovRcxRax,
//   X86_MovRaxRbx, X86_SarRaxImm8, X86_TestRaxRax, X86_TestRcxRcx,
//   X86_ImulRaxRcx

LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch

// =============================================================================
// IMUL ONE-OPERAND (128-bit signed multiply)
// RDX:RAX = RAX * operand
// =============================================================================

// IMUL RBX (one-operand) - 48 F7 EB
// RDX:RAX = RAX * RBX (signed, 128-bit result)
Function.X86_ImulRbx128 {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0xF7)
        Emit_Byte(0xEB)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// IMUL RCX (one-operand) - 48 F7 E9
// RDX:RAX = RAX * RCX (signed, 128-bit result)
Function.X86_ImulRcx128 {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0xF7)
        Emit_Byte(0xE9)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// IMUL 32-BIT (for Q8.8 where 32-bit result suffices)
// =============================================================================

// IMUL EAX, ECX (32-bit two-operand) - 0F AF C1
// EAX = EAX * ECX (signed, 32-bit result)
Function.X86_ImulEaxEcx {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0xAF)
        Emit_Byte(0xC1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// SHRD - Double-Precision Shift Right
// SHRD dst, src, imm8 : dst = (src:dst) >> imm8 (low bits)
// =============================================================================

// SHRD RAX, RDX, imm8 - 48 0F AC D0 <imm>
// RAX = (RDX:RAX) >> imm8  (extracts bits from 128-bit product)
Function.X86_ShrdRaxRdxImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x0F)
        Emit_Byte(0xAC)
        Emit_Byte(0xD0)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// SAR EAX, imm8 (32-bit arithmetic shift right)
// Note: SAR RAX, imm8 (64-bit) already exists as X86_SarRaxImm8
// =============================================================================

// SAR EAX, imm8 - C1 F8 <imm>
Function.X86_SarEaxImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0xC1)
        Emit_Byte(0xF8)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// MOV RDX, 1 - 48 C7 C2 01 00 00 00
// Used to set RDX=1 for computing 2^64 as RDX:RAX = 1:0
// =============================================================================
Function.X86_MovRdx1 {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0xC7)
        Emit_Byte(0xC2)
        Emit_Byte(0x01)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// MOVSX / MOVSXD - Sign extension for smaller formats
// =============================================================================

// MOVSX EAX, AX (16-bit to 32-bit) - 0F BF C0
Function.X86_MovsxEaxAx {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0xBF)
        Emit_Byte(0xC0)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVSX ECX, CX (16-bit to 32-bit) - 0F BF C9
Function.X86_MovsxEcxCx {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0xBF)
        Emit_Byte(0xC9)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVSXD RAX, EAX (32-bit to 64-bit) - 48 63 C0
Function.X86_MovsxdRaxEax {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x63)
        Emit_Byte(0xC0)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVSXD RCX, ECX (32-bit to 64-bit) - 48 63 C9
Function.X86_MovsxdRcxEcx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x63)
        Emit_Byte(0xC9)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// IDIV RCX (signed 128/64 division)
// RAX = RDX:RAX / RCX (signed quotient)
// RDX = RDX:RAX % RCX (signed remainder)
// Encoding: 48 F7 F9
// =============================================================================
Function.X86_IdivRcx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0xF7)
        Emit_Byte(0xF9)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// CQO - Sign-extend RAX into RDX:RAX
// If RAX >= 0: RDX = 0
// If RAX < 0:  RDX = -1 (0xFFFFFFFFFFFFFFFF)
// Encoding: 48 99
// =============================================================================
Function.X86_Cqo {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x99)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// SHL RAX, imm8 - Shift Left Logical
// RAX = RAX << imm8
// Encoding: 48 C1 E0 <imm>
// =============================================================================
Function.X86_ShlRaxImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0xC1)
        Emit_Byte(0xE0)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// MOV RDX, RAX - 48 89 C2
// =============================================================================
Function.X86_MovRdxRax {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x89)
        Emit_Byte(0xC2)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// SAR RDX, imm8 - Arithmetic Shift Right on RDX
// RDX = RDX >> imm8 (sign-preserving)
// Encoding: 48 C1 FA <imm>
// =============================================================================
Function.X86_SarRdxImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0xC1)
        Emit_Byte(0xFA)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}
