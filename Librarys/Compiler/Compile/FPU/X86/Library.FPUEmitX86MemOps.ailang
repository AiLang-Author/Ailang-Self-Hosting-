// =============================================================================
// PCMPEQB - Packed Compare Equal Bytes
// Sets 0xFF for equal bytes, 0x00 for different
// =============================================================================

// PCMPEQB XMM0, XMM1 - 66 0F 74 C1
Function.X86_PCMPEQB_XMM0_XMM1 {
    Body: {
        Emit_Byte(102)  // 66
        Emit_Byte(15)
        Emit_Byte(116)  // 74
        Emit_Byte(193)  // C1
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PCMPEQB XMM1, XMM0 - 66 0F 74 C8
Function.X86_PCMPEQB_XMM1_XMM0 {
    Body: {
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(116)
        Emit_Byte(200)  // C8
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// PMOVMSKB - Move Byte Mask to Integer
// Extracts high bit of each byte into 16-bit mask
// =============================================================================

// PMOVMSKB EAX, XMM0 - 66 0F D7 C0
Function.X86_PMOVMSKB_EAX_XMM0 {
    Body: {
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(215)  // D7
        Emit_Byte(192)  // C0
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PMOVMSKB EAX, XMM1 - 66 0F D7 C1
Function.X86_PMOVMSKB_EAX_XMM1 {
    Body: {
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(215)
        Emit_Byte(193)  // C1
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// BYTE BROADCAST - Replicate byte to all 16 positions
// Sequence: MOVD XMM0, EAX; PUNPCKLBW; PSHUFLW; PSHUFD
// =============================================================================

// PUNPCKLBW XMM0, XMM0 - 66 0F 60 C0
Function.X86_PUNPCKLBW_XMM0_XMM0 {
    Body: {
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(96)   // 60
        Emit_Byte(192)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PSHUFLW XMM0, XMM0, 0 - F2 0F 70 C0 00
Function.X86_PSHUFLW_XMM0_XMM0_0 {
    Body: {
        Emit_Byte(242)  // F2
        Emit_Byte(15)
        Emit_Byte(112)  // 70
        Emit_Byte(192)
        Emit_Byte(0)    // imm8 = 0
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PSHUFD XMM0, XMM0, 0 - 66 0F 70 C0 00
Function.X86_PSHUFD_XMM0_XMM0_0 {
    Body: {
        Emit_Byte(102)  // 66
        Emit_Byte(15)
        Emit_Byte(112)  // 70
        Emit_Byte(192)
        Emit_Byte(0)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// Complete broadcast: AL -> all 16 bytes of XMM0
Function.X86_BroadcastAL_XMM0 {
    Body: {
        // MOVD XMM0, EAX - 66 0F 6E C0
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(110)
        Emit_Byte(192)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        
        X86_PUNPCKLBW_XMM0_XMM0()
        X86_PSHUFLW_XMM0_XMM0_0()
        X86_PSHUFD_XMM0_XMM0_0()
    }
}

