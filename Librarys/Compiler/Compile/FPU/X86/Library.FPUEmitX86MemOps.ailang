// Library.FPUEmitX86MemOps.ailang
// X86-64 SSE2 instruction emission for memory operations
// Location: Librarys/Compiler/Compile/FPU/X86/Library.FPUEmitX86MemOps.ailang
//
// SIMD instructions for MemSet, MemCopy, MemCompare, MemChr
// These are byte-level operations using XMM for 16-byte chunks

LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.FPU.FPUTypes

// =============================================================================
// MOVDQU - Unaligned 128-bit (16 byte) loads/stores
// =============================================================================

// MOVDQU XMM0, [RSI] - F3 0F 6F 06
Function.X86_MOVDQU_XMM0_DerefRSI {
    Body: {
        Emit_Byte(0xF3)
        Emit_Byte(0x0F)
        Emit_Byte(0x6F)
        Emit_Byte(0x06)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

