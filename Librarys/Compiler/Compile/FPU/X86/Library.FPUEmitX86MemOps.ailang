// =============================================================================
// POINTER ARITHMETIC
// =============================================================================

// =============================================================================
// BROADCAST BYTE TO XMM1
// =============================================================================

// Broadcast AL to all bytes of XMM1
Function.X86_BroadcastAL_XMM1 {
    Body: {
        // MOVD XMM1, EAX - 66 0F 6E C8
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x6E)
        Emit_Byte(0xC8)
        
        // PUNPCKLBW XMM1, XMM1 - 66 0F 60 C9
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x60)
        Emit_Byte(0xC9)
        
        // PSHUFLW XMM1, XMM1, 0 - F2 0F 70 C9 00
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x70)
        Emit_Byte(0xC9)
        Emit_Byte(0x00)
        
        // PSHUFD XMM1, XMM1, 0 - 66 0F 70 C9 00
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x70)
        Emit_Byte(0xC9)
        Emit_Byte(0x00)
    }
}