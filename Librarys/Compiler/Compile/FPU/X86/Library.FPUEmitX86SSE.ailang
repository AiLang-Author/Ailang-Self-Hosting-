// =============================================================================
// XMM STACK HELPERS
// =============================================================================

// Push XMM0 to stack (SUB RSP,8; MOVSD [RSP], XMM0)
Function.X86_PushXMM0 {
    Body: {
        // SUB RSP, 8
        Emit_Byte(0x48)
        Emit_Byte(0x83)
        Emit_Byte(0xEC)
        Emit_Byte(0x08)
        // MOVSD [RSP], XMM0
        X86_MOVSD_DerefRSP_XMM0()
    }
}

// Pop XMM0 from stack (MOVSD XMM0, [RSP]; ADD RSP,8)
Function.X86_PopXMM0 {
    Body: {
        // MOVSD XMM0, [RSP]
        X86_MOVSD_XMM0_DerefRSP()
        // ADD RSP, 8
        Emit_Byte(0x48)
        Emit_Byte(0x83)
        Emit_Byte(0xC4)
        Emit_Byte(0x08)
    }
}

// Push XMM1 to stack
Function.X86_PushXMM1 {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x83)
        Emit_Byte(0xEC)
        Emit_Byte(0x08)
        // MOVSD [RSP], XMM1 - F2 0F 11 0C 24
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x11)
        Emit_Byte(0x0C)
        Emit_Byte(0x24)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// Pop XMM1 from stack
Function.X86_PopXMM1 {
    Body: {
        // MOVSD XMM1, [RSP] - F2 0F 10 0C 24
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x10)
        Emit_Byte(0x0C)
        Emit_Byte(0x24)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        // ADD RSP, 8
        Emit_Byte(0x48)
        Emit_Byte(0x83)
        Emit_Byte(0xC4)
        Emit_Byte(0x08)
    }
}

// =============================================================================
// SHUFFLE (for dot products, cross products)
// =============================================================================

// SHUFPD XMM0, XMM1, imm8 - 66 0F C6 C1 xx
Function.X86_SHUFPD_XMM0_XMM1 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0xC6)
        Emit_Byte(0xC1)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

