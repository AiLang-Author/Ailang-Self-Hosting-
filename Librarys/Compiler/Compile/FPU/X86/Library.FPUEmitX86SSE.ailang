// CVTSI2SD XMM0, RAX - F2 48 0F 2A C0 (int64 -> double)
Function.X86_CVTSI2SD_XMM0_RAX {
    Body: {
        Emit_Byte(0xF2)
        Emit_Byte(0x48)  // REX.W
        Emit_Byte(0x0F)
        Emit_Byte(0x2A)
        Emit_Byte(0xC0)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

