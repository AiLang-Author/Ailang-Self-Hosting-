// =============================================================================
// XMM MEMORY LOADS/STORES
// =============================================================================

// MOVSD XMM0, [RSP] - F2 0F 10 04 24
Function.X86_MOVSD_XMM0_DerefRSP {
    Body: {
        Emit_Byte(242)
        Emit_Byte(15)
        Emit_Byte(16)
        Emit_Byte(4)    // 04 = SIB follows
        Emit_Byte(36)   // 24 = RSP
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVSD [RSP], XMM0 - F2 0F 11 04 24
Function.X86_MOVSD_DerefRSP_XMM0 {
    Body: {
        Emit_Byte(242)
        Emit_Byte(15)
        Emit_Byte(17)   // 11
        Emit_Byte(4)
        Emit_Byte(36)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVSD XMM0, [RBP+off] - F2 0F 10 45 xx (8-bit offset)
Function.X86_MOVSD_XMM0_RBP_Off8 {
    Input: offset: Integer
    Body: {
        Emit_Byte(242)
        Emit_Byte(15)
        Emit_Byte(16)
        Emit_Byte(69)   // 45 = [RBP+disp8]
        Emit_Byte(offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVSD [RBP+off], XMM0 - F2 0F 11 45 xx
Function.X86_MOVSD_RBP_Off8_XMM0 {
    Input: offset: Integer
    Body: {
        Emit_Byte(242)
        Emit_Byte(15)
        Emit_Byte(17)
        Emit_Byte(69)
        Emit_Byte(offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

