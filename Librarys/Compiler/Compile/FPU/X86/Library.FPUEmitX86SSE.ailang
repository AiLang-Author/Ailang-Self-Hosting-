// POR XMM1, XMM3 - 66 0F EB CB
Function.X86_POR_XMM1_XMM3 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0xEB)
        Emit_Byte(0xCB)
    }
}


