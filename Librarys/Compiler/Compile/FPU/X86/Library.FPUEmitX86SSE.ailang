// =============================================================================
// HORIZONTAL ADD (for dot products) - SSE3
// =============================================================================

// HADDPD XMM0, XMM0 - 66 0F 7C C0 (horizontal add)
// XMM0 = [a, b] -> XMM0 = [a+b, a+b]
Function.X86_HADDPD_XMM0_XMM0 {
    Body: {
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(124)  // 7C
        Emit_Byte(192)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}