// Library.FPUEmitX86SSE.ailang
// X86-64 SSE2 instruction byte emission
// Location: Librarys/Compiler/Compile/FPU/X86/Library.FPUEmitX86SSE.ailang
//
// Raw byte emission for SSE2 instructions
// No dependencies on CCompileMain - can test standalone

LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.Compile.FPU.FPUTypes

// =============================================================================
// SCALAR DOUBLE ARITHMETIC (SD suffix = Scalar Double)
// All operate on XMM0, XMM1 -> result in XMM0
// =============================================================================

// ADDSD XMM0, XMM1 - F2 0F 58 C1
Function.X86_ADDSD_XMM0_XMM1 {
    Body: {
        Emit_Byte(242)  // F2
        Emit_Byte(15)   // 0F
        Emit_Byte(88)   // 58
        Emit_Byte(193)  // C1 = ModRM(XMM0, XMM1)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// SUBSD XMM0, XMM1 - F2 0F 5C C1
Function.X86_SUBSD_XMM0_XMM1 {
    Body: {
        Emit_Byte(242)
        Emit_Byte(15)
        Emit_Byte(92)   // 5C
        Emit_Byte(193)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

