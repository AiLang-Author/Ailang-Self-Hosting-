    Body: {
        Emit_Byte(242)  // F2
        Emit_Byte(72)   // REX.W
        Emit_Byte(15)
        Emit_Byte(42)   // 2A
        Emit_Byte(192)  // C0
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

