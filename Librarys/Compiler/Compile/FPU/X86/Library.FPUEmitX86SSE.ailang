// =============================================================================
// XMM MEMORY LOADS/STORES
// =============================================================================

// MOVSD XMM0, [RSP] - F2 0F 10 04 24
Function.X86_MOVSD_XMM0_DerefRSP {
    Body: {
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x10)
        Emit_Byte(0x04)  // SIB follows
        Emit_Byte(0x24)  // RSP
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVSD [RSP], XMM0 - F2 0F 11 04 24
Function.X86_MOVSD_DerefRSP_XMM0 {
    Body: {
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x11)
        Emit_Byte(0x04)
        Emit_Byte(0x24)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVSD XMM0, [RAX] - F2 0F 10 00
// Loads a double from memory pointed to by RAX. Used by the transcendental
// constant loader: RAX holds a relocated data-section address, this
// dereferences it into XMM0.
Function.X86_MOVSD_XMM0_DerefRax {
    Body: {
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x10)
        Emit_Byte(0x00)  // ModR/M: mod=00, reg=000 (XMM0), rm=000 (RAX)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVSD XMM0, [RBP+off] - F2 0F 10 45 xx (8-bit offset)
Function.X86_MOVSD_XMM0_RBP_Off8 {
    Input: offset: Integer
    Body: {
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x10)
        Emit_Byte(0x45)  // [RBP+disp8]
        Emit_Byte(offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MOVSD [RBP+off], XMM0 - F2 0F 11 45 xx
Function.X86_MOVSD_RBP_Off8_XMM0 {
    Input: offset: Integer
    Body: {
        Emit_Byte(0xF2)
        Emit_Byte(0x0F)
        Emit_Byte(0x11)
        Emit_Byte(0x45)
        Emit_Byte(offset)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

