// =============================================================================
// PXOR - XOR (used to zero registers)
// =============================================================================

// PXOR XMM0, XMM0 - 66 0F EF C0 (zero XMM0)
Function.X86_PXOR_XMM0_XMM0 {
    Body: {
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(239)  // EF
        Emit_Byte(192)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// PXOR XMM1, XMM1 - 66 0F EF C9
Function.X86_PXOR_XMM1_XMM1 {
    Body: {
        Emit_Byte(102)
        Emit_Byte(15)
        Emit_Byte(239)
        Emit_Byte(201)  // C9
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// XMM STACK HELPERS
// =============================================================================

// Push XMM0 to stack (SUB RSP,8; MOVSD [RSP], XMM0)
Function.X86_PushXMM0 {
    Body: {
        // SUB RSP, 8 - 48 83 EC 08
        Emit_Byte(72)
        Emit_Byte(131)
        Emit_Byte(236)
        Emit_Byte(8)
        // MOVSD [RSP], XMM0
        X86_MOVSD_DerefRSP_XMM0()
    }
}

// Pop XMM0 from stack (MOVSD XMM0, [RSP]; ADD RSP,8)
Function.X86_PopXMM0 {
    Body: {
        // MOVSD XMM0, [RSP]
        X86_MOVSD_XMM0_DerefRSP()
        // ADD RSP, 8 - 48 83 C4 08
        Emit_Byte(72)
        Emit_Byte(131)
        Emit_Byte(196)
        Emit_Byte(8)
    }
}

// Push XMM1 to stack
Function.X86_PushXMM1 {
    Body: {
        Emit_Byte(72)
        Emit_Byte(131)
        Emit_Byte(236)
        Emit_Byte(8)
        // MOVSD [RSP], XMM1 - F2 0F 11 0C 24
        Emit_Byte(242)
        Emit_Byte(15)
        Emit_Byte(17)
        Emit_Byte(12)   // 0C
        Emit_Byte(36)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// Pop XMM1 from stack
Function.X86_PopXMM1 {
    Body: {
        // MOVSD XMM1, [RSP] - F2 0F 10 0C 24
        Emit_Byte(242)
        Emit_Byte(15)
        Emit_Byte(16)
        Emit_Byte(12)
        Emit_Byte(36)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        // ADD RSP, 8
        Emit_Byte(72)
        Emit_Byte(131)
        Emit_Byte(196)
        Emit_Byte(8)
    }
}

