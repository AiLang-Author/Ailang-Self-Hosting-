LibraryImport.Compiler.Compile.CCompileMain

// =============================================================================
// DISPATCHER
// =============================================================================
Function.CompileFile_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        PrintMessage("[FILE] TryCompile called\n")   // ADD THIS FIRST LINE
        func_name = AST_GetData1(node)
        
        IfCondition EqualTo(func_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        cmp = StringCompare(func_name, "FileOpen")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_Open(node))
        }
        
        cmp = StringCompare(func_name, "FileRead")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_Read(node))
        }
        
        cmp = StringCompare(func_name, "FileWrite")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_Write(node))
        }
        
        cmp = StringCompare(func_name, "FileClose")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_Close(node))
        }
        
        cmp = StringCompare(func_name, "FileSeek")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_Seek(node))
        }
        
        cmp = StringCompare(func_name, "FileGetSize")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_GetSize(node))
        }
        
        cmp = StringCompare(func_name, "FileExists")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_Exists(node))
        }
        
        // Alternate: ReadBinaryFile -> FileRead
        cmp = StringCompare(func_name, "ReadBinaryFile")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_Read(node))
        }

        // Alternate: WriteBinaryFile -> FileWrite  
        cmp = StringCompare(func_name, "WriteBinaryFile")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_Write(node))
        }

        // Alternate: OpenFile -> FileOpen
        cmp = StringCompare(func_name, "OpenFile")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_Open(node))
        }

        // Alternate: CloseFile -> FileClose
        cmp = StringCompare(func_name, "CloseFile")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_Close(node))
        }

        // Alternate: GetFileSize -> FileGetSize
        cmp = StringCompare(func_name, "GetFileSize")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_GetSize(node))
        }

        // ReadTextFile, WriteTextFile, AppendTextFile also need handlers
        // RIGHT:
        cmp = StringCompare(func_name, "WriteTextFile")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_WriteText(node))  // <- CORRECT
        }

        cmp = StringCompare(func_name, "ReadTextFile")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFile_ReadText(node))   // <- CORRECT
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// FILE OPEN
// open(path, flags, mode) -> fd
// syscall 2: RDI=path, RSI=flags, RDX=mode
// =============================================================================
Function.CompileFile_Open {
    Input: node: Address
    Output: Integer
    Body: {
        args = AST_GetChildren(node)
        arg_count = XArray.XSize(args)
        
        IfCondition LessThan(arg_count, 1) ThenBlock: {
            Compile_Error("FileOpen requires path argument")
            ReturnValue(0)
        }
        
        // Push args to stack (compile in order, pop in reverse)
        
        // Arg 0: path
        path_node = XArray.XGet(args, 0)
        Compile_Expression(path_node)
        Emit_PushRax()
        
        // Arg 1: flags (default O_RDONLY=0)
        IfCondition GreaterEqual(arg_count, 2) ThenBlock: {
            flags_node = XArray.XGet(args, 1)
            Compile_Expression(flags_node)
        } ElseBlock: {
            Emit_XorRaxRax()
        }
        Emit_PushRax()
        
        // Arg 2: mode (default 0644=420)
        IfCondition GreaterEqual(arg_count, 3) ThenBlock: {
            mode_node = XArray.XGet(args, 2)
            Compile_Expression(mode_node)
        } ElseBlock: {
            Emit_MovRaxImm64(420)
        }
        Emit_PushRax()
        
        // Pop into syscall regs (reverse order)
        Emit_PopRdx()    // mode
        Emit_PopRsi()    // flags
        Emit_PopRdi()    // path
        
        // syscall 2 = open
        Emit_MovRaxImm64(2)
        Emit_SysInstr()
        
        ReturnValue(1)
    }
}

// =============================================================================
// FILE READ
// read(fd, buf, count) -> bytes_read
// syscall 0: RDI=fd, RSI=buf, RDX=count
// =============================================================================
Function.CompileFile_Read {
    Input: node: Address
    Output: Integer
    Body: {
        args = AST_GetChildren(node)
        arg_count = XArray.XSize(args)
        
        IfCondition LessThan(arg_count, 3) ThenBlock: {
            Compile_Error("FileRead requires fd, buffer, count")
            ReturnValue(0)
        }
        
        // Compile and push all args
        fd_node = XArray.XGet(args, 0)
        Compile_Expression(fd_node)
        Emit_PushRax()
        
        buf_node = XArray.XGet(args, 1)
        Compile_Expression(buf_node)
        Emit_PushRax()
        
        count_node = XArray.XGet(args, 2)
        Compile_Expression(count_node)
        Emit_PushRax()
        
        // Pop into regs
        Emit_PopRdx()    // count
        Emit_PopRsi()    // buffer
        Emit_PopRdi()    // fd
        
        // syscall 0 = read
        Emit_MovRaxImm64(0)
        Emit_SysInstr()
        
        ReturnValue(1)
    }
}

// =============================================================================
// FILE WRITE
// write(fd, buf, count) -> bytes_written
// syscall 1: RDI=fd, RSI=buf, RDX=count
// =============================================================================
Function.CompileFile_Write {
    Input: node: Address
    Output: Integer
    Body: {
        args = AST_GetChildren(node)
        arg_count = XArray.XSize(args)
        
        IfCondition LessThan(arg_count, 3) ThenBlock: {
            Compile_Error("FileWrite requires fd, buffer, count")
            ReturnValue(0)
        }
        
        fd_node = XArray.XGet(args, 0)
        Compile_Expression(fd_node)
        Emit_PushRax()
        
        buf_node = XArray.XGet(args, 1)
        Compile_Expression(buf_node)
        Emit_PushRax()
        
        count_node = XArray.XGet(args, 2)
        Compile_Expression(count_node)
        Emit_PushRax()
        
        Emit_PopRdx()
        Emit_PopRsi()
        Emit_PopRdi()
        
        // syscall 1 = write
        Emit_MovRaxImm64(1)
        Emit_SysInstr()
        
        ReturnValue(1)
    }
}

// =============================================================================
// FILE CLOSE
// close(fd) -> result
// syscall 3: RDI=fd
// =============================================================================
Function.CompileFile_Close {
    Input: node: Address
    Output: Integer
    Body: {
        args = AST_GetChildren(node)
        arg_count = XArray.XSize(args)
        
        IfCondition LessThan(arg_count, 1) ThenBlock: {
            Compile_Error("FileClose requires fd")
            ReturnValue(0)
        }
        
        fd_node = XArray.XGet(args, 0)
        Compile_Expression(fd_node)
        Emit_MovRdiRax()
        
        // syscall 3 = close
        Emit_MovRaxImm64(3)
        Emit_SysInstr()
        
        ReturnValue(1)
    }
}

// =============================================================================
// FILE SEEK
// lseek(fd, offset, whence) -> position
// syscall 8: RDI=fd, RSI=offset, RDX=whence
// =============================================================================
Function.CompileFile_Seek {
    Input: node: Address
    Output: Integer
    Body: {
        args = AST_GetChildren(node)
        arg_count = XArray.XSize(args)
        
        IfCondition LessThan(arg_count, 3) ThenBlock: {
            Compile_Error("FileSeek requires fd, offset, whence")
            ReturnValue(0)
        }
        
        fd_node = XArray.XGet(args, 0)
        Compile_Expression(fd_node)
        Emit_PushRax()
        
        offset_node = XArray.XGet(args, 1)
        Compile_Expression(offset_node)
        Emit_PushRax()
        
        whence_node = XArray.XGet(args, 2)
        Compile_Expression(whence_node)
        Emit_PushRax()
        
        Emit_PopRdx()    // whence
        Emit_PopRsi()    // offset
        Emit_PopRdi()    // fd
        
        // syscall 8 = lseek
        Emit_MovRaxImm64(8)
        Emit_SysInstr()
        
        ReturnValue(1)
    }
}

// =============================================================================
// FILE GET SIZE
// lseek to end, save size, lseek back to start
// Uses stack to preserve fd and size between syscalls
// =============================================================================
Function.CompileFile_GetSize {
    Input: node: Address
    Output: Integer
    Body: {
        args = AST_GetChildren(node)
        arg_count = XArray.XSize(args)
        
        IfCondition LessThan(arg_count, 1) ThenBlock: {
            Compile_Error("FileGetSize requires fd")
            ReturnValue(0)
        }
        
        // Compile fd
        fd_node = XArray.XGet(args, 0)
        Compile_Expression(fd_node)
        Emit_PushRax()           // Stack: [fd]
        
        // lseek(fd, 0, SEEK_END=2)
        Emit_MovRdiRax()         // fd
        Emit_XorRsiRsi()         // offset = 0
        Emit_MovRaxImm64(2)
        Emit_PushRax()
        Emit_PopRdx()            // SEEK_END = 2
        Emit_MovRaxImm64(8)      // lseek syscall
        Emit_SysInstr()
        
        // Save size, restore fd
        Emit_PopRbx()            // fd -> RBX
        Emit_PushRax()           // Stack: [size]
        Emit_PushRbx()           // Stack: [size, fd]
        
        // lseek(fd, 0, SEEK_SET=0) to reset position
        Emit_PushRbx()
        Emit_PopRdi()            // fd -> RDI
        Emit_XorRsiRsi()         // offset = 0
        Emit_XorRdxRdx()         // SEEK_SET = 0
        Emit_MovRaxImm64(8)
        Emit_SysInstr()
        
        // Discard fd, return size
        Emit_PopRbx()            // discard fd
        Emit_PopRax()            // size -> RAX
        
        ReturnValue(1)
    }
}

// =============================================================================
// FILE EXISTS
// access(path, F_OK=0) -> 0 if exists
// Returns 1 if exists, 0 if not
// =============================================================================
Function.CompileFile_Exists {
    Input: node: Address
    Output: Integer
    Body: {
        args = AST_GetChildren(node)
        arg_count = XArray.XSize(args)
        
        IfCondition LessThan(arg_count, 1) ThenBlock: {
            Compile_Error("FileExists requires path")
            ReturnValue(0)
        }
        
        exists_label = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        path_node = XArray.XGet(args, 0)
        Compile_Expression(path_node)
        
        // access(path, F_OK=0)
        Emit_MovRdiRax()
        Emit_XorRsiRsi()         // F_OK = 0
        Emit_MovRaxImm64(21)     // access
        Emit_SysInstr()
        
        // RAX == 0 means exists
        Emit_TestRaxRax()
        Emit_Jz(exists_label)
        
        // Doesn't exist -> return 0
        Emit_XorRaxRax()
        Emit_Jmp(done_label)
        
        // Exists -> return 1
        Emit_MarkLabel(exists_label)
        Emit_MovRaxImm64(1)
        
        Emit_MarkLabel(done_label)
        
        ReturnValue(1)
    }
}

// =============================================================================
// WRITE TEXT FILE
// WriteTextFile(filename, content) -> bytes_written
// High-level: opens file, gets strlen, writes, closes
// NOTE: Avoids R15 for values that need RDI/RSI (no Emit_MovRdiR15)
// =============================================================================
Function.CompileFile_WriteText {
    Input: node: Address
    Output: Integer
    Body: {
        args = AST_GetChildren(node)
        arg_count = XArray.XSize(args)
        
        IfCondition LessThan(arg_count, 2) ThenBlock: {
            Compile_Error("WriteTextFile requires filename, content")
            ReturnValue(0)
        }
        
        strlen_loop = Emit_CreateLabel()
        strlen_done = Emit_CreateLabel()
        error_label = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        Emit_PushR12()    // content ptr
        Emit_PushR13()    // fd
        Emit_PushR14()    // strlen / bytes_written
        Emit_PushR15()    // filename
        Emit_PushRbx()    // scratch
        
        // Compile content -> R12
        content_node = XArray.XGet(args, 1)
        Compile_Expression(content_node)
        Emit_MovR12Rax()
        
        // Compile filename -> R15
        filename_node = XArray.XGet(args, 0)
        Compile_Expression(filename_node)
        Emit_MovR15Rax()
        
        // Inline strlen: RBX = counter, RDI = scanner
        Emit_XorRbxRbx()
        Emit_MovRdiR12()
        
        Emit_MarkLabel(strlen_loop)
        Emit_MovAlDerefRdi()
        Emit_TestAlAl()
        Emit_Jz(strlen_done)
        Emit_IncRdi()
        Emit_IncRbx()
        Emit_Jmp(strlen_loop)
        
        Emit_MarkLabel(strlen_done)
        Emit_MovRaxRbx()
        Emit_MovR14Rax()           // strlen -> R14
        
        // open(filename, O_WRONLY|O_CREAT|O_TRUNC=577, 0644=420)
        // No Emit_MovRdiR15, so: rbx=r15, rdi=rbx
        Emit_MovRbxR15()
        Emit_MovRdiRbx()
        Emit_MovRsiImm64(577)
        Emit_MovRdxImm64(420)
        Emit_MovRaxImm64(2)
        Emit_SysInstr()
        Emit_MovR13Rax()           // fd -> R13
        
        Emit_TestRaxRax()
        Emit_Js(error_label)
        
        // write(fd, content, len)
        Emit_MovRdiR13()
        Emit_MovRsiR12()
        Emit_MovRdxR14()
        Emit_MovRaxImm64(1)
        Emit_SysInstr()
        Emit_MovR14Rax()           // bytes_written
        
        // close(fd)
        Emit_MovRdiR13()
        Emit_MovRaxImm64(3)
        Emit_SysInstr()
        
        Emit_MovRaxR14()
        Emit_Jmp(done_label)
        
        Emit_MarkLabel(error_label)
        Emit_MovRaxR13()
        
        Emit_MarkLabel(done_label)
        Emit_PopRbx()
        Emit_PopR15()
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        
        ReturnValue(1)
    }
}

// =============================================================================
// READ TEXT FILE WITH BUFFER
// ReadTextFile(filename, buffer, maxsize) -> bytes_read
// =============================================================================
Function.CompileFile_ReadTextWithBuffer {
    Input: node: Address
    Output: Integer
    Body: {
        args = AST_GetChildren(node)
        
        error_label = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        Emit_PushR12()    // buffer
        Emit_PushR13()    // fd
        Emit_PushR14()    // maxsize / bytes_read
        Emit_PushRbx()    // filename (use RBX instead of R15)
        
        // Compile args
        maxsize_node = XArray.XGet(args, 2)
        Compile_Expression(maxsize_node)
        Emit_MovR14Rax()
        
        buffer_node = XArray.XGet(args, 1)
        Compile_Expression(buffer_node)
        Emit_MovR12Rax()
        
        filename_node = XArray.XGet(args, 0)
        Compile_Expression(filename_node)
        Emit_PushRax()             // save filename on stack
        
        // open(filename, O_RDONLY=0, 0)
        Emit_MovRdiRax()           // rdi = filename (still in rax)
        Emit_XorRsiRsi()
        Emit_XorRdxRdx()
        Emit_MovRaxImm64(2)
        Emit_SysInstr()
        Emit_MovR13Rax()
        
        Emit_PopRbx()              // discard saved filename
        
        Emit_TestRaxRax()
        Emit_Js(error_label)
        
        // read(fd, buffer, maxsize)
        Emit_MovRdiR13()
        Emit_MovRsiR12()
        Emit_MovRdxR14()
        Emit_MovRaxImm64(0)
        Emit_SysInstr()
        Emit_MovR14Rax()
        
        // close(fd)
        Emit_MovRdiR13()
        Emit_MovRaxImm64(3)
        Emit_SysInstr()
        
        Emit_MovRaxR14()
        Emit_Jmp(done_label)
        
        Emit_MarkLabel(error_label)
        Emit_MovRaxR13()
        
        Emit_MarkLabel(done_label)
        Emit_PopRbx()
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        
        ReturnValue(1)
    }
}

// =============================================================================
// READ TEXT FILE AUTO-ALLOC
// ReadTextFile(filename) -> content_ptr (mmap'd, null-terminated)
// =============================================================================
Function.CompileFile_ReadTextAutoAlloc {
    Input: node: Address
    Output: Integer
    Body: {
        args = AST_GetChildren(node)
        
        error_label = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        Emit_PushR12()    // fd
        Emit_PushR13()    // file size
        Emit_PushR14()    // mmap buffer
        Emit_PushRbx()    // scratch
        
        // Compile filename -> stack (use immediately, don't need to keep)
        filename_node = XArray.XGet(args, 0)
        Compile_Expression(filename_node)
        
        // open - filename already in rax
        Emit_MovRdiRax()
        Emit_XorRsiRsi()
        Emit_XorRdxRdx()
        Emit_MovRaxImm64(2)
        Emit_SysInstr()
        Emit_MovR12Rax()           // fd -> R12
        
        Emit_TestRaxRax()
        Emit_Js(error_label)
        
        // lseek(fd, 0, SEEK_END=2)
        Emit_MovRdiR12()
        Emit_XorRsiRsi()
        Emit_MovRdxImm64(2)
        Emit_MovRaxImm64(8)
        Emit_SysInstr()
        Emit_MovR13Rax()           // size -> R13
        
        // lseek back to start
        Emit_MovRdiR12()
        Emit_XorRsiRsi()
        Emit_XorRdxRdx()
        Emit_MovRaxImm64(8)
        Emit_SysInstr()
        
        // mmap: rdi=0, rsi=size+1, rdx=3, r10=34, r8=-1, r9=0
        Emit_XorRdiRdi()
        Emit_MovRaxR13()
        Emit_AddRaxImm8(1)
        Emit_MovRsiRax()
        Emit_MovRdxImm64(3)
        Emit_MovR10Imm64(34)
        Emit_MovR8Imm64(-1)
        Emit_XorR9R9()
        Emit_MovRaxImm64(9)
        Emit_SysInstr()
        Emit_MovR14Rax()           // buffer -> R14
        
        Emit_CmpRaxImm8(-1)
        Emit_Je(error_label)
        
        // read(fd, buffer, size)
        Emit_MovRdiR12()
        Emit_MovRsiR14()
        Emit_MovRdxR13()
        Emit_MovRaxImm64(0)
        Emit_SysInstr()
        Emit_MovRbxRax()           // bytes_read -> rbx
        
        // Null terminate: buffer[bytes_read] = 0
        Emit_MovRaxR14()
        Emit_AddRaxRbx()
        Emit_MovRdiRax()
        Emit_MovByteDerefRdiZero()
        
        // close(fd)
        Emit_MovRdiR12()
        Emit_MovRaxImm64(3)
        Emit_SysInstr()
        
        Emit_MovRaxR14()
        Emit_Jmp(done_label)
        
        Emit_MarkLabel(error_label)
        Emit_XorRaxRax()
        
        Emit_MarkLabel(done_label)
        Emit_PopRbx()
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        
        ReturnValue(1)
    }
}

// =============================================================================
// DISPATCHER - ReadTextFile routes based on arg count
// =============================================================================
Function.CompileFile_ReadText {
    Input: node: Address
    Output: Integer
    Body: {
        args = AST_GetChildren(node)
        arg_count = XArray.XSize(args)
        
        IfCondition LessThan(arg_count, 1) ThenBlock: {
            Compile_Error("ReadTextFile requires at least filename")
            ReturnValue(0)
        }
        
        IfCondition GreaterEqual(arg_count, 3) ThenBlock: {
            ReturnValue(CompileFile_ReadTextWithBuffer(node))
        }
        
        ReturnValue(CompileFile_ReadTextAutoAlloc(node))
    }
}