FixedPool.Compile {
    "ast": Initialize=0, CanChange=True
    "functions": Initialize=0, CanChange=True
    "variables": Initialize=0, CanChange=True
    "pools": Initialize=0, CanChange=True
    "current_func": Initialize=0, CanChange=True
    "current_scope": Initialize=0, CanChange=True
    "current_return_label": Initialize=0, CanChange=True
    "stack_size": Initialize=0, CanChange=True
    "stack_offset": Initialize=0, CanChange=True
    "label_counter": Initialize=0, CanChange=True
    "loop_stack": Initialize=0, CanChange=True   
    "loop_depth": Initialize=0, CanChange=True   
    "error": Initialize=0, CanChange=True
    "error_msg": Initialize=0, CanChange=True
    "error_line": Initialize=0, CanChange=True
    "nodes_compiled": Initialize=0, CanChange=True
    "bytes_emitted": Initialize=0, CanChange=True
    "binary_op_depth": Initialize=0, CanChange=True
    "pool_member_count": Initialize=0, CanChange=True
    "pending_pool_type": Initialize=0, CanChange=True
    // Set by ailang_cli when -kmod is in effect. Gates the codegen branch
    // that turns calls to ExternalKernelFunction declarations into PLT32
    // relocs against the .ko's symbol table. In ET_EXEC mode (the default)
    // such calls are a compile error since there's no linker to resolve them.
    "kmod_mode":         Initialize=0, CanChange=True
    // XArray of extern names (Address). Pass-1 discovery populates;
    // pass-2 call sites consult.
    "externs":           Initialize=0, CanChange=True
    // XArray of inline-function entries [name][body_node][params_xarray].
    // Populated by CompileFunc_InlineFunction; consulted at every call site.
    "inline_bodies":     Initialize=0, CanChange=True
    // Label to jump to at end of an inline expansion (0 = not in inline).
    "inline_return_label": Initialize=0, CanChange=True
    // Name → label / index / entry. The arrays stay the iteration order.
    // Miss from SHash.Lookup is -1. Labels and extern indexes start at 0.
    "function_hash":     Initialize=0, CanChange=True
    "extern_hash":       Initialize=0, CanChange=True
    "inline_hash":       Initialize=0, CanChange=True
}

// =============================================================================
// VARIABLE TYPES
// =============================================================================
FixedPool.VarType {
    "UNKNOWN": Initialize=-1
    "LOCAL": Initialize=0
    "PARAM": Initialize=1
    "POOL": Initialize=2
    "GLOBAL": Initialize=3
}

FixedPool.VarFlags {
    "NONE": Initialize=0
    "PARAM": Initialize=1
    "LOCAL": Initialize=2
    "GLOBAL": Initialize=4
    "CONST": Initialize=8
}

FixedPool.UnaryOp {
    "NEGATE": Initialize=1
    "NOT": Initialize=2
    "BITNOT": Initialize=3
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Compile_Init {
    Body: {
        // === FREE OLD BUFFERS FIRST ===
        IfCondition NotEqual(Compile.functions, 0) ThenBlock: {
            Array.Destroy(Compile.functions)
        }
        IfCondition NotEqual(Compile.variables, 0) ThenBlock: {
            Array.Destroy(Compile.variables)
        }
        IfCondition NotEqual(Compile.pools, 0) ThenBlock: {
            Array.Destroy(Compile.pools)
        }
        IfCondition NotEqual(Compile.loop_stack, 0) ThenBlock: {
            Array.Destroy(Compile.loop_stack)
        }
        IfCondition NotEqual(Compile.externs, 0) ThenBlock: {
            Array.Destroy(Compile.externs)
        }
        IfCondition NotEqual(Compile.inline_bodies, 0) ThenBlock: {
            Array.Destroy(Compile.inline_bodies)
        }
        IfCondition NotEqual(Compile.function_hash, 0) ThenBlock: {
            SHash.Destroy(Compile.function_hash)
        }
        IfCondition NotEqual(Compile.extern_hash, 0) ThenBlock: {
            SHash.Destroy(Compile.extern_hash)
        }
        IfCondition NotEqual(Compile.inline_hash, 0) ThenBlock: {
            SHash.Destroy(Compile.inline_hash)
        }

        // === NOW ALLOCATE FRESH ===
        Compile.ast = 0
        Compile.functions = Array.Create(256)
        Compile.variables = Array.Create(512)
        Compile.pools = Array.Create(64)
        Compile.externs = Array.Create(64)
        Compile.inline_bodies = Array.Create(64)
        Compile.function_hash = SHash.Create(4096)
        Compile.extern_hash = SHash.Create(256)
        Compile.inline_hash = SHash.Create(256)
        Compile.inline_return_label = 0
        Compile.current_func = 0
        Compile.current_scope = 0
        Compile.stack_size = 0
        Compile.stack_offset = 0
        Compile.label_counter = 0
        // Initialize loop tracking
        Compile.loop_stack = Array.Create(64)  // 32 nested loops max
        Compile.loop_depth = 0
        Compile.error = 0
        Compile.error_msg = 0
        Compile.error_line = 0
        Compile.nodes_compiled = 0
        Compile.bytes_emitted = 0
        Compile.pool_member_count = 0
        
         // Reset pool registry for new compilation
        Pool_Reset()
        
        // Initialize emit layer
        Emit_Init()
         // Initialize scope manager for function compilation
        Scope_Init()

        // Preserve debug level if already initialized by TUI
        IfCondition EqualTo(Dbg.initialized, 0) ThenBlock: {
            Debug_Init(0, 0)
        }

        ReturnValue(1)
    }
}

// =============================================================================
// CLEANUP
// =============================================================================
// =============================================================================
// CLEANUP - Free all entries then destroy arrays
// =============================================================================
Function.Compile_Free {
    Body: {
        // Free debug system
        Debug_Free()
        
        // Free scope manager FIRST (before variables array)
        Scope_Free()

        Emit_Free()
        
        // Free function entries (16 bytes each: [name:8, label:8])
        IfCondition NotEqual(Compile.functions, 0) ThenBlock: {
            count = Array.Size(Compile.functions)
            i = 0
            WhileLoop LessThan(i, count) {
                entry = Array.Get(Compile.functions, i)
                IfCondition NotEqual(entry, 0) ThenBlock: {
                    Deallocate(entry, 16)
                }
                i = Add(i, 1)
            }
            Array.Destroy(Compile.functions)
            Compile.functions = 0
        }
        IfCondition NotEqual(Compile.function_hash, 0) ThenBlock: {
            SHash.Destroy(Compile.function_hash)
            Compile.function_hash = 0
        }
        IfCondition NotEqual(Compile.extern_hash, 0) ThenBlock: {
            SHash.Destroy(Compile.extern_hash)
            Compile.extern_hash = 0
        }
        IfCondition NotEqual(Compile.inline_hash, 0) ThenBlock: {
            SHash.Destroy(Compile.inline_hash)
            Compile.inline_hash = 0
        }
        
        // Free variable entries (40 bytes each: [name:8, offset:8, type:8, size:8, flags:8])
        IfCondition NotEqual(Compile.variables, 0) ThenBlock: {
            count = Array.Size(Compile.variables)
            i = 0
            WhileLoop LessThan(i, count) {
                entry = Array.Get(Compile.variables, i)
                IfCondition NotEqual(entry, 0) ThenBlock: {
                    Deallocate(entry, 40)
                }
                i = Add(i, 1)
            }
            Array.Destroy(Compile.variables)
            Compile.variables = 0
        }
        
        // Free pool entries (32 bytes each: [name:8, field_count:8, size:8, fields:8])
        IfCondition NotEqual(Compile.pools, 0) ThenBlock: {
            count = Array.Size(Compile.pools)
            i = 0
            WhileLoop LessThan(i, count) {
                entry = Array.Get(Compile.pools, i)
                IfCondition NotEqual(entry, 0) ThenBlock: {
                    Deallocate(entry, 32)
                }
                i = Add(i, 1)
            }
            Array.Destroy(Compile.pools)
            Compile.pools = 0
        }
        
        // Free loop stack entries (16 bytes each: [break_label:8, continue_label:8])
        IfCondition NotEqual(Compile.loop_stack, 0) ThenBlock: {
            count = Array.Size(Compile.loop_stack)
            i = 0
            WhileLoop LessThan(i, count) {
                entry = Array.Get(Compile.loop_stack, i)
                IfCondition NotEqual(entry, 0) ThenBlock: {
                    Deallocate(entry, 16)
                }
                i = Add(i, 1)
            }
            Array.Destroy(Compile.loop_stack)
            Compile.loop_stack = 0
        }
        
        Compile.ast = 0
        Compile.current_func = 0
    }
}

// =============================================================================
// ERROR HANDLING
// =============================================================================
Function.Compile_Error {
    Input: msg: Address
    Input: line: Integer
    Body: {
        Compile.error = 1
        Compile.error_msg = msg
        Compile.error_line = line
        
        PrintMessage("COMPILE ERROR at line ")
        PrintNumber(line)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

Function.Compile_HasError {
    Output: Integer
    Body: {
        ReturnValue(Compile.error)
    }
}

// =============================================================================
// LABEL MANAGEMENT
// =============================================================================
Function.Compile_NewLabel {
    Output: Integer
    Body: {
        label = Emit_CreateLabel()
        ReturnValue(label)
    }
}
// =============================================================================
// MAIN ENTRY POINT
// =============================================================================
Function.Compile_Program {
    Input: ast: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ast, 0) ThenBlock: {
            Compile_Error("Null AST", 0)
            ReturnValue(0)
        }
        
        Compile.ast = ast
        
// Pass 0.5: Loop-invariant code motion (AST rewrite)
        // Must run BEFORE discovery so hoisted variables get stack slots
 //       PrintMessage("[COMPILE] Pass 0.5: Hoisting loop invariants...\n")
//        Hoist_OptimizeAST(ast)
// this produces broken code, will need furhter investigation may not be needed with ailang at all. 
// the optimizations required in other language simply might not apply. 

                Phase.miss = 0
        Phase.hit = 0
        Phase.user = 0
        Phase.miss_n = 0
        Phase.hit_n = 0
        Phase.user_n = 0
        Phase.nested = 0

        // Pass 1: Discover declarations (functions, pools, variables)
        DebugPerf.Start("discover")
        Compile_DiscoverDeclarations(ast)
        DebugPerf.End("discover")

        IfCondition EqualTo(Compile.error, 1) ThenBlock: {
            ReturnValue(0)
        }

        // Pass 1.5: Emit pool table initialization (R15)
        // Skipped in kmod mode — kernel modules have no entry point that
        // would execute these bytes. module_init dispatches directly to
        // ail_main via the symbol address; the pool-init prologue at
        // .text+0 would never run, so emitting it just bloats .text and
        // confuses disassembly. Source code that needs FixedPools in a
        // kmod context would have to initialize them inside ail_main.
        DebugPerf.Start("pools")
        IfCondition EqualTo(Compile.kmod_mode, 0) ThenBlock: {
            Compile_EmitPoolTableInit()
            Compile_EmitPoolInitializers()
        }
        DebugPerf.End("pools")

        
        // Pass 2: Generate code
        DebugPerf.Start("generate")
        Compile_GenerateCode(ast)
        DebugPerf.End("generate")

        IfCondition EqualTo(Compile.error, 1) ThenBlock: {
            ReturnValue(0)
        }

        // Pass 3: Resolve fixups (labels, jumps)
        DebugPerf.Start("labels")
        Emit_ResolveFixups()
        DebugPerf.End("labels")

        Prof_Print()
        ReturnValue(1)
    }
}





// =============================================================================
// PASS 1: DISCOVER DECLARATIONS
// Registers all functions, pools, and top-level structures before codegen
// =============================================================================
Function.Compile_DiscoverDeclarations {
    Input: ast: Address
    Body: {
        IfCondition EqualTo(ast, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        node_type = AST_GetType(ast)
        
        // Program - iterate all children
        IfCondition EqualTo(node_type, AST.PROGRAM) ThenBlock: {
            count = AST_GetChildCount(ast)
            i = 0
            WhileLoop LessThan(i, count) {
                child = AST_GetChild(ast, i)
                Compile_DiscoverDeclarations(child)
                i = Add(i, 1)
            }
            ReturnValue(1)
        }
        
        // Function - register with new label
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            name = AST_GetData1(ast)
            label = Compile_NewLabel()
            Compile_RegisterFunction(name, label)
            ReturnValue(1)
        }

        // SubRoutine - register with new label
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            name = AST_GetData1(ast)
            label = Compile_NewLabel()
            Compile_RegisterFunction(name, label)
            ReturnValue(1)
        }

        // InlineFunction — register label (callable fallback) in pass 1
        IfCondition EqualTo(node_type, AST.INLINE_FUNCTION) ThenBlock: {
            name = AST_GetData1(ast)
            label = Compile_NewLabel()
            Compile_RegisterFunction(name, label)
            ReturnValue(1)
        }

        // ExternalKernelFunction — declares a name to be resolved at .ko
        // load time. No label, no codegen. Pass-2 call sites use this list
        // to know to emit a PLT32 reloc instead of a local relative call.
        IfCondition EqualTo(node_type, AST.EXTERN_KFUNC) ThenBlock: {
            name = AST_GetData1(ast)
            Compile_RegisterExtern(name)
            ReturnValue(1)
        }
        
        // FixedPool - register pool variables
        IfCondition EqualTo(node_type, AST.POOL_FIXED) ThenBlock: {
            Compile_RegisterPool(ast)
            ReturnValue(1)
        }
        
        // DynamicPool
        IfCondition EqualTo(node_type, AST.POOL_DYNAMIC) ThenBlock: {
            Compile_RegisterPool(ast)
            ReturnValue(1)
        }

        IfCondition EqualTo(node_type, AST.POOL_LINKAGE) ThenBlock: {
            CompilePool_Declaration(ast)  // Register pool structure
            ReturnValue(1)
        }
        
        // Library imports - no codegen, handled at parse time
        IfCondition EqualTo(node_type, AST.LIBRARY_IMPORT) ThenBlock: {
            ReturnValue(1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// PASS 2: GENERATE CODE
// =============================================================================
Function.Compile_GenerateCode {
    Input: ast: Address
    Body: {
        IfCondition EqualTo(ast, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        node_type = AST_GetType(ast)
        
        // Program - compile all children
        IfCondition EqualTo(node_type, AST.PROGRAM) ThenBlock: {
            count = AST_GetChildCount(ast)
            i = 0
            WhileLoop LessThan(i, count) {
                IfCondition EqualTo(Compile.error, 1) ThenBlock: {
                    ExitLoop
                }
                child = AST_GetChild(ast, i)
                Compile_Node(child)
                i = Add(i, 1)
            }
            ReturnValue(1)
        }
        
        // Single node
        Compile_Node(ast)
        ReturnValue(1)
    }
}

// =============================================================================
// NODE DISPATCHER
// Routes AST nodes to appropriate compile handlers
// Mirrors _node_dispatch dict in ailang_compiler.py
// =============================================================================
Function.Compile_Node {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition EqualTo(Compile.error, 1) ThenBlock: {
            ReturnValue(0)
        }
        
        node_type = AST_GetType(node)
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        
        // ─────────────────────────────────────────────────────────────────
        // Top-Level Declarations
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.PROGRAM) ThenBlock: {
            ReturnValue(Compile_GenerateCode(node))
        }
        
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            ReturnValue(CompileFunc_Function(node))
        }
        
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            ReturnValue(CompileFunc_SubRoutine(node))
        }

        // InlineFunction — compile the body (callable fallback) AND register
        // body+params in the inline table for call-site expansion.
        IfCondition EqualTo(node_type, AST.INLINE_FUNCTION) ThenBlock: {
            ReturnValue(CompileFunc_InlineFunction(node))
        }

        // ExternalKernelFunction — already registered in pass 1. No code emitted;
        // call sites consult Compile_FindExtern and emit PLT32 relocs.
        IfCondition EqualTo(node_type, AST.EXTERN_KFUNC) ThenBlock: {
            ReturnValue(1)
        }
        
        IfCondition EqualTo(node_type, AST.POOL_FIXED) ThenBlock: {
            // Pool data already registered in pass 1
            ReturnValue(1)
        }
        
        IfCondition EqualTo(node_type, AST.POOL_DYNAMIC) ThenBlock: {
            ReturnValue(1)
        }
        
        IfCondition EqualTo(node_type, AST.POOL_LINKAGE) ThenBlock: {
            // Pool already registered in pass 1
            ReturnValue(1)
        }

        IfCondition EqualTo(node_type, AST.LIBRARY_IMPORT) ThenBlock: {
            // Imports handled at parse time
            ReturnValue(1)
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Statements
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.BLOCK) ThenBlock: {
            ReturnValue(CompileStmt_Block(node))
        }
        
        IfCondition EqualTo(node_type, AST.BODY) ThenBlock: {
            ReturnValue(CompileStmt_Block(node))
        }
        
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            ReturnValue(CompileStmt_Assignment(node))
        }
        
        IfCondition EqualTo(node_type, AST.POINTER_FIELD_ASSIGN) ThenBlock: {
            ReturnValue(CompileStmt_PointerFieldAssign(node))
        }

        IfCondition EqualTo(node_type, AST.IF) ThenBlock: {
            ReturnValue(CompileStmt_If(node))
        }
        
        IfCondition EqualTo(node_type, AST.WHILE) ThenBlock: {
            ReturnValue(CompileStmt_While(node))
        }
        
        IfCondition EqualTo(node_type, AST.RETURN) ThenBlock: {
            ReturnValue(CompileStmt_Return(node))
        }
        
        IfCondition EqualTo(node_type, AST.EXIT_LOOP) ThenBlock: {
            ReturnValue(CompileStmt_Break(node))
        }
        
        IfCondition EqualTo(node_type, AST.CONTINUE_LOOP) ThenBlock: {
            ReturnValue(CompileStmt_Continue(node))
        }
        
        IfCondition EqualTo(node_type, AST.TRY) ThenBlock: {
            ReturnValue(CompileStmt_Try(node))
        }
        
        IfCondition EqualTo(node_type, AST.FOR_EVERY) ThenBlock: {
            ReturnValue(CompileStmt_ForEvery(node))
        }
        
        IfCondition EqualTo(node_type, AST.SWITCH) ThenBlock: {
            ReturnValue(CompileStmt_Switch(node))
        }

        IfCondition EqualTo(node_type, AST.FORK) ThenBlock: {
            ReturnValue(CompileStmt_Fork(node))
        }
        
        // ─────────────────────────────────────────────────────────────────
        // DEBUG STATEMENTS
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.DEBUG_BLOCK) ThenBlock: {
            CompileDebug_Block(node)
            ReturnValue(1)
        }
        
        IfCondition EqualTo(node_type, AST.DEBUG_ASSERT) ThenBlock: {
            CompileDebug_Assert(node)
            ReturnValue(1)
        }
        
        IfCondition EqualTo(node_type, AST.DEBUG_TRACE) ThenBlock: {
            CompileDebug_Trace(node)
            ReturnValue(1)
        }
        
        IfCondition EqualTo(node_type, AST.DEBUG_BREAK) ThenBlock: {
            CompileDebug_Break(node)
            ReturnValue(1)
        }

        IfCondition EqualTo(node_type, AST.DEBUG_PERF) ThenBlock: {
            CompileDebug_Perf(node)
            ReturnValue(1)
        }

         IfCondition EqualTo(node_type, AST.DEBUG_MEMORY) ThenBlock: {
            CompileDebug_Memory(node)
            ReturnValue(1)
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Expressions (when used as statements)
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            ReturnValue(Compile_FunctionCall(node))
        }
        
    
        // ─────────────────────────────────────────────────────────────────
        // Literals (when used as standalone statements - rare but valid)
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            ReturnValue(Compile_Expression(node))
        }
        
        IfCondition EqualTo(node_type, AST.STRING) ThenBlock: {
            ReturnValue(Compile_Expression(node))
        }
        
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            ReturnValue(Compile_Expression(node))
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Functions    
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.RUN_TASK) ThenBlock: {
            ReturnValue(CompileFunc_RunTask(node))
        }


        IfCondition EqualTo(node_type, AST.INLINEASM) ThenBlock: {
            ReturnValue(CompileStmt_InlineAsm(node))
        }

        IfCondition EqualTo(node_type, AST.HALT) ThenBlock: {
            ReturnValue(CompileSystem_Halt(node))
        }

        // ─────────────────────────────────────────────────────────────────
        // Unknown - warning and continue
        // ─────────────────────────────────────────────────────────────────
        PrintMessage("[COMPILE] WARNING: Unknown node type ")
        PrintNumber(node_type)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// CALL-DISPATCH ACCOUNTING
// Exclusive cycles inside Compile_FunctionCall. A rejected TryCompile is
// the method-name walk. A hit or a user call is the emit, with nested
// calls subtracted so each cycle is counted once.
// RDTSCP low half. A single probe is far under 2^32 cycles.
// =============================================================================
FixedPool.Phase {
    "miss": Initialize=0, CanChange=True
    "hit": Initialize=0, CanChange=True
    "user": Initialize=0, CanChange=True
    "miss_n": Initialize=0, CanChange=True
    "hit_n": Initialize=0, CanChange=True
    "user_n": Initialize=0, CanChange=True
    "nested": Initialize=0, CanChange=True
}

Function.Prof_Begin {
    Output: Integer
    Body: {
        Phase.nested = 0
        ReturnValue(InlineAsm["0F 01 F9"])
    }
}

Function.Prof_Stamp {
    Output: Integer
    Body: {
        ReturnValue(InlineAsm["0F 01 F9"])
    }
}

Function.Prof_Charge {
    Input: t0: Integer
    Input: t1: Integer
    Input: saved: Integer
    Input: kind: Integer
    Body: {
        dt = Subtract(t1, t0)
        IfCondition LessThan(dt, 0) ThenBlock: {
            dt = Add(dt, 4294967296)
        }
        exclusive = Subtract(dt, Phase.nested)
        IfCondition LessThan(exclusive, 0) ThenBlock: {
            exclusive = 0
        }
        Phase.nested = Add(saved, dt)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            Phase.hit = Add(Phase.hit, exclusive)
            Phase.hit_n = Add(Phase.hit_n, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            Phase.user = Add(Phase.user, exclusive)
            Phase.user_n = Add(Phase.user_n, 1)
            ReturnValue(0)
        }
        Phase.miss = Add(Phase.miss, exclusive)
        Phase.miss_n = Add(Phase.miss_n, 1)
        ReturnValue(0)
    }
}

Function.Prof_Print {
    Body: {
        // Same switch as DebugPerf: quiet unless the compiler was run with -P.
        IfCondition EqualTo(Dbg.perf_enabled, 0) ThenBlock: {
            ReturnValue(0)
        }
        PrintMessage("[PHASE] method-walk ")
        PrintNumber(Phase.miss)
        PrintMessage(" cycles over ")
        PrintNumber(Phase.miss_n)
        PrintMessage(" misses\n")
        PrintMessage("[PHASE] builtin-emit ")
        PrintNumber(Phase.hit)
        PrintMessage(" cycles over ")
        PrintNumber(Phase.hit_n)
        PrintMessage(" hits\n")
        PrintMessage("[PHASE] user-call ")
        PrintNumber(Phase.user)
        PrintMessage(" cycles over ")
        PrintNumber(Phase.user_n)
        PrintMessage(" calls\n")
    }
}

// =============================================================================
// FUNCTION CALL DISPATCHER
// Tries each module until one handles the call
// Mirrors compile_function_call in ailang_compiler.py
// =============================================================================
Function.Compile_FunctionCall {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        func_name = AST_GetData1(node)
        
        IfCondition EqualTo(func_name, 0) ThenBlock: {
            Compile_Error("Function call with null name", 0)
            ReturnValue(0)
        }
        
        // Each TryCompile is timed alone. kind 0 is a rejected name walk,
        // kind 1 is that module emitting the call. Nested calls are subtracted.
        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileFile_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = Optimize_TryMathOp(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileArith_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileCompare_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileLogic_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileBitwise_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileIO_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        IfCondition EqualTo(Emit.target, Arch.X86_64) ThenBlock: {
            saved = Phase.nested
            t0 = Prof_Begin()
            result = FPUCompileX86String_TryCompile(node)
            t1 = Prof_Stamp()
            kind = 0
            IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
            Prof_Charge(t0, t1, saved, kind)
            IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }
        }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileStringCore_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileMem_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileArray_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompilePool_TryCompile(func_name, node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileSystem_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileFunc_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        IfCondition EqualTo(Emit.target, Arch.X86_64) ThenBlock: {
            saved = Phase.nested
            t0 = Prof_Begin()
            result = FPUCompileX86_TryCompile(node)
            t1 = Prof_Stamp()
            kind = 0
            IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
            Prof_Charge(t0, t1, saved, kind)
            IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

            saved = Phase.nested
            t0 = Prof_Begin()
            result = FPUCompileX86MemOps_TryCompile(node)
            t1 = Prof_Stamp()
            kind = 0
            IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
            Prof_Charge(t0, t1, saved, kind)
            IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

            saved = Phase.nested
            t0 = Prof_Begin()
            result = FPUCompileX86FixedPoint_TryCompile(node)
            t1 = Prof_Stamp()
            kind = 0
            IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
            Prof_Charge(t0, t1, saved, kind)
            IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

            saved = Phase.nested
            t0 = Prof_Begin()
            result = FPUCompileX86AVX_TryCompile(node)
            t1 = Prof_Stamp()
            kind = 0
            IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
            Prof_Charge(t0, t1, saved, kind)
            IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }
        }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileAtomic_TryCompile(node)
        t1 = Prof_Stamp()
        kind = 0
        IfCondition EqualTo(result, 1) ThenBlock: { kind = 1 }
        Prof_Charge(t0, t1, saved, kind)
        IfCondition EqualTo(result, 1) ThenBlock: { ReturnValue(1) }

        saved = Phase.nested
        t0 = Prof_Begin()
        result = CompileFunc_UserCall(node)
        t1 = Prof_Stamp()
        Prof_Charge(t0, t1, saved, 2)
        IfCondition EqualTo(result, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Unknown function
        // ─────────────────────────────────────────────────────────────────
        PrintMessage("[COMPILE] ERROR: Unknown function: ")
        PrintMessage(func_name)
        PrintMessage("\n")
        Compile_Error("Unknown function", AST_GetLine(node))
        ReturnValue(0)
    }
}

// =============================================================================
// EXPRESSION COMPILER
// Compiles any expression, leaving result in RAX
// =============================================================================
Function.Compile_Expression {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        node_type = AST_GetType(node)
        
        
        
        // ─────────────────────────────────────────────────────────────────
        // Literals
        // ─────────────────────────────────────────────────────────────────
        
        
        // Number literal -> MOV RAX, value
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            value_str = AST_GetData1(node)
            value = StringToNumber(value_str) 
            Emit_MovRaxImm64(value)
            ReturnValue(1)
        }
                
        // String literal -> load data section address
        IfCondition EqualTo(node_type, AST.STRING) ThenBlock: {
            str_ptr = AST_GetData1(node)
            offset = Emit_AddString(str_ptr)
            Emit_LoadDataAddress(offset)
            ReturnValue(1)
        }
        
        // Boolean literal
        IfCondition EqualTo(node_type, AST.BOOLEAN) ThenBlock: {
            value = AST_GetData1(node)
            Emit_MovRaxImm64(value)
            ReturnValue(1)
        }
        
        // Null literal
        IfCondition EqualTo(node_type, AST.NULL) ThenBlock: {
            Emit_XorRaxRax()
            ReturnValue(1)
        }
        
        
        // ─────────────────────────────────────────────────────────────────
        // Identifier - load variable value
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            ReturnValue(CompileExpr_LoadVariable(name))
        }

        // ─────────────────────────────────────────────────────────────────
        // Function call - result in RAX
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            ReturnValue(Compile_FunctionCall(node))
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Operators
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.BINARY_OP) ThenBlock: {
            ReturnValue(CompileExpr_BinaryOp(node))
        }
        
        IfCondition EqualTo(node_type, AST.UNARY_OP) ThenBlock: {
            ReturnValue(CompileExpr_UnaryOp(node))
        }
        
        // ─────────────────────────────────────────────────────────────────
        // Member access (Pool.field)
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.MEMBER_ACCESS) ThenBlock: {
            ReturnValue(CompileExpr_MemberAccess(node))
        }
        // ─────────────────────────────────────────────────────────────────
        // Pointer field access (ptr@field)
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.POINTER_FIELD_ACCESS) ThenBlock: {
            ReturnValue(CompileExpr_PointerFieldAccess(node))
        }

        // ─────────────────────────────────────────────────────────────────
        // Index access (array[index])
        // ─────────────────────────────────────────────────────────────────
        IfCondition EqualTo(node_type, AST.INDEX_ACCESS) ThenBlock: {
            ReturnValue(CompileExpr_IndexAccess(node))
        }
        
        // InlineAsm as rvalue — emits bytes, result stays in RAX
        IfCondition EqualTo(node_type, AST.INLINEASM) ThenBlock: {
            CompileStmt_InlineAsm(node)
            ReturnValue(1)
        }

        // Unknown expression type
        PrintMessage("[COMPILE] WARNING: Unknown expression type ")
        PrintNumber(node_type)
        PrintMessage("\n")
        ReturnValue(0)
    }
}


Function.Compile_RegisterPool {
    Input: pool_node: Address
    Body: {
        pool_name = AST_GetData1(pool_node)
        
        // Iterate pool members and register each
        count = AST_GetChildCount(pool_node)

        i = 0
        WhileLoop LessThan(i, count) {
            member = AST_GetChild(pool_node, i)
            member_type = AST_GetType(member)
            
            IfCondition EqualTo(member_type, AST.POOL_MEMBER) ThenBlock: {
                member_name = AST_GetData1(member)
                // DATA2 is a pointer to an initializer node: either a
                // NUMBER (init_value is the integer), a STRING (init_value
                // is the data-section offset of the emitted literal), or
                // 0 (unset — field stays zero).
                init_node  = AST_GetData2(member)
                init_value = 0
                is_string  = 0

                IfCondition NotEqual(init_node, 0) ThenBlock: {
                    node_type = AST_GetType(init_node)

                    IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
                        init_str = AST_GetData1(init_node)
                        init_value = StringToNumber(init_str)
                    }

                    // String literal initializer: emit the bytes into the
                    // data section and record the offset. EmitPoolInitializers
                    // will turn that offset into a load-address when it
                    // writes the slot at program startup, so the field
                    // holds a valid pointer instead of NULL.
                    IfCondition EqualTo(node_type, AST.STRING) ThenBlock: {
                        init_str   = AST_GetData1(init_node)
                        init_value = Emit_AddString(init_str)
                        is_string  = 1
                    }
                }

                Compile_RegisterPoolVariable(pool_name, member_name,
                                             Compile.pool_member_count,
                                             init_value, is_string)
                Compile.pool_member_count = Add(Compile.pool_member_count, 1)
            }
            i = Add(i, 1)
        }
    }
}

Function.Compile_RegisterPoolVariable {
    Input: pool_name: Address
    Input: var_name: Address
    Input: index: Integer
    Input: init_value: Integer
    Input: is_string: Integer
    Body: {
        // Build full name: "PoolName.member"
        full_name = StringConcat(pool_name, ".")
        full_name = StringConcat(full_name, var_name)

        // Mark index with POOL_MARKER (0x80000000 = 2147483648)
        marked_index = BitwiseOr(index, 2147483648)

        // Store in variables array. Entry is now 48 bytes:
        //   [0]  full_name
        //   [8]  marked_index
        //   [16] VarType.POOL
        //   [24] pool_name
        //   [32] init_value  (integer value, or data-section offset for strings)
        //   [40] is_string   (0 = integer init, 1 = string init)
        entry = Allocate(48)
        StoreValue(entry, full_name)
        StoreValue(Add(entry, 8), marked_index)
        StoreValue(Add(entry, 16), VarType.POOL)
        StoreValue(Add(entry, 24), pool_name)
        StoreValue(Add(entry, 32), init_value)
        StoreValue(Add(entry, 40), is_string)
        Array.Push(Compile.variables, entry)

    }
}


// =============================================================================
// POOL TABLE INIT - Emit mmap at _start to initialize R15
// =============================================================================
Function.Compile_EmitPoolTableInit {
    Body: {
        IfCondition EqualTo(Compile.pool_member_count, 0) ThenBlock: {
            // No pools - zero R15 for safety
            Emit_XorR15R15()
            ReturnValue(0)
        }
        
        PrintMessage("[POOL] Emitting mmap for R15 (")
        PrintNumber(Compile.pool_member_count)
        PrintMessage(" slots)\n")
        
        // mmap(0, 4096, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
        Emit_MovRaxImm64(9)
        Emit_XorRdiRdi()
        Emit_MovRsiImm64(262144) 
        Emit_MovRdxImm64(3)
        Emit_MovR10Imm64(34)
        Emit_MovR8Imm64(-1)
        Emit_XorR9R9()
        Emit_SysInstr()
        Emit_MovR15Rax()
        
        ReturnValue(1)
    }
}

// =============================================================================
// POOL INITIALIZERS - Emit code to store Initialize= values
// =============================================================================
Function.Compile_EmitPoolInitializers {
    Body: {
        count = Array.Size(Compile.variables)
        emitted = 0
        
        i = 0
        WhileLoop LessThan(i, count) {
            entry = Array.Get(Compile.variables, i)
            var_type = Dereference(Add(entry, 16))
            
            IfCondition EqualTo(var_type, VarType.POOL) ThenBlock: {
                marked_index = Dereference(Add(entry, 8))
                init_value   = Dereference(Add(entry, 32))
                is_string    = Dereference(Add(entry, 40))

                // Get actual index (clear high bit)
                index = BitwiseAnd(marked_index, 2147483647)
                pool_offset = Multiply(index, 8)

                // For string initializers init_value is the offset of the
                // emitted literal in the data section; emit a load-effective-
                // address so the slot holds a real pointer. For integers it's
                // the value itself — emit a MOV imm64.
                IfCondition EqualTo(is_string, 1) ThenBlock: {
                    Emit_LoadDataAddress(init_value)
                } ElseBlock: {
                    Emit_MovRaxImm64(init_value)
                }
                Emit_MovR15OffsetRax(pool_offset)
                emitted = Add(emitted, 1)
            }
            
            i = Add(i, 1)
        }
        
    }
}


// =============================================================================
// DEPTH TRACKING FOR REGISTER ALLOCATION
// =============================================================================
Function.Compile_DepthPush {
    Body: {
        Compile.binary_op_depth = Add(Compile.binary_op_depth, 1)
    }
}

Function.Compile_DepthPop {
    Body: {
        IfCondition GreaterThan(Compile.binary_op_depth, 0) ThenBlock: {
            Compile.binary_op_depth = Subtract(Compile.binary_op_depth, 1)
        }
    }
}

Function.Compile_GetDepth {
    Output: Integer
    Body: {
        ReturnValue(Compile.binary_op_depth)
    }
}

Function.Compile_ShouldUseStack {
    Output: Integer
    Body: {
        // Depth 2+ uses stack to avoid R14/R15 collision
        IfCondition GreaterEqual(Compile.binary_op_depth, 2) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// STATISTICS
// =============================================================================
Function.Compile_PrintStats {
    Body: {
        PrintMessage("[COMPILE STATS]\n")
        PrintMessage("  Nodes compiled: ")
        PrintNumber(Compile.nodes_compiled)
        PrintMessage("\n")
        PrintMessage("  Functions registered: ")
        PrintNumber(Array.Size(Compile.functions))
        PrintMessage("\n")
        PrintMessage("  Variables registered: ")
        PrintNumber(Array.Size(Compile.variables))
        PrintMessage("\n")
        PrintMessage("  Code size: ")
        PrintNumber(Emit.code_size)
        PrintMessage(" bytes\n")
        PrintMessage("  Data size: ")
        PrintNumber(Emit.data_size)
        PrintMessage(" bytes\n")
        PrintMessage("  Labels: ")
        PrintNumber(Emit.label_count)
        PrintMessage("\n")
        // Error reporting
        IfCondition EqualTo(Compile.error, 1) ThenBlock: {
            PrintMessage("  ERRORS: Yes\n")
        }
        // Print debug stats if debug was enabled
        IfCondition GreaterThan(Dbg.level, 0) ThenBlock: {
            Debug_PrintStats()
        }
    }
}
