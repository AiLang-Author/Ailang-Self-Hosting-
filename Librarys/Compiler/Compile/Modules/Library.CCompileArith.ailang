// Library.CCompileArith.ailang
// Arithmetic operations: Add, Subtract, Multiply, Divide, Modulo, Negate
// NO FIXEDPOOL - uses string literals directly to avoid pool collisions

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch

// =============================================================================
// TRY COMPILE - Main dispatch for arithmetic operations
// Returns 1 if handled, 0 if not an arithmetic operation
// =============================================================================
Function.CompileArith_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }

        func_name = AST_GetData1(node)
        IfCondition EqualTo(func_name, 0) ThenBlock: {
            ReturnValue(0)
        }

        cmp = StringCompare(func_name, "Add")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tmp_result = CompileArith_Add(node)
            ReturnValue(tmp_result)
        }
        
        cmp = StringCompare(func_name, "Subtract")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tmp_result = CompileArith_Subtract(node)
            ReturnValue(tmp_result)
        }
        
        cmp = StringCompare(func_name, "Multiply")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tmp_result = CompileArith_Multiply(node)
            ReturnValue(tmp_result)
        }
        
        cmp = StringCompare(func_name, "Divide")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tmp_result = CompileArith_Divide(node)
            ReturnValue(tmp_result)
        }
        
        cmp = StringCompare(func_name, "Modulo")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tmp_result = CompileArith_Modulo(node)
            ReturnValue(tmp_result)
        }
        
        cmp = StringCompare(func_name, "Negate")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tmp_result = CompileArith_Negate(node)
            ReturnValue(tmp_result)
        }
        
        cmp = StringCompare(func_name, "Increment")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tmp_result = CompileArith_Increment(node)
            ReturnValue(tmp_result)
        }
        
        cmp = StringCompare(func_name, "Decrement")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tmp_result = CompileArith_Decrement(node)
            ReturnValue(tmp_result)
        }
        
        cmp = StringCompare(func_name, "Power")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            tmp_result = CompileArith_Power(node)
            ReturnValue(tmp_result)
        }

        // Not an arithmetic operation
        ReturnValue(0)
    }
}


// =============================================================================
// ADD(a, b) → a + b
// =============================================================================
Function.CompileArith_Add {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            Compile_Error("Add requires 2 arguments", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        // A literal right-hand side is an immediate operand, not a value
        // to shuttle through rbx. Skip the push/mov/pop dance entirely.
        IfCondition EqualTo(AST_GetType(arg1), AST.NUMBER) ThenBlock: {
            imm = StringToNumber(AST_GetData1(arg1))
            IfCondition GreaterEqual(imm, -2147483648) ThenBlock: {
                IfCondition LessEqual(imm, 2147483647) ThenBlock: {
                    result = Compile_Expression(arg0)
                    IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(0) }
                    Emit_AddRaxImm32(imm)
                    Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                    ReturnValue(1)
                }
            }
        }

        result = Compile_Expression(arg0)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }

        Emit_PushRax()

        result = Compile_Expression(arg1)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }

        Emit_MovRegReg(Reg.RBX, Reg.RAX)
        Emit_PopRax()
        Emit_AddRaxRbx()

        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// SUBTRACT(a, b) → a - b
// =============================================================================
Function.CompileArith_Subtract {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            Compile_Error("Subtract requires 2 arguments", AST_GetLine(node))
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        // Same immediate fast path as Add, with the operation mirrored.
        IfCondition EqualTo(AST_GetType(arg1), AST.NUMBER) ThenBlock: {
            imm = StringToNumber(AST_GetData1(arg1))
            IfCondition GreaterEqual(imm, -2147483648) ThenBlock: {
                IfCondition LessEqual(imm, 2147483647) ThenBlock: {
                    result = Compile_Expression(arg0)
                    IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(0) }
                    Emit_SubRaxImm32(imm)
                    Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                    ReturnValue(1)
                }
            }
        }

        result = Compile_Expression(arg0)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }

        Emit_PushRax()

        result = Compile_Expression(arg1)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }

        Emit_MovRegReg(Reg.RBX, Reg.RAX)
        Emit_PopRax()
        Emit_SubRaxRbx()

        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// MULTIPLY(a, b) → a * b
// =============================================================================

Function.CompileArith_Multiply {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            Compile_Error("Multiply requires 2 arguments", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // === OPTIMIZATION: Multiply by power of 2 → SHL ===
        // Multiply(x, 2)   → SHL x, 1
        // Multiply(x, 4)   → SHL x, 2
        // Multiply(x, 8)   → SHL x, 3
        // Multiply(x, 16)  → SHL x, 4
        // etc.
        arg1_type = AST_GetType(arg1)
        IfCondition EqualTo(arg1_type, AST.NUMBER) ThenBlock: {
            val_str = AST_GetData1(arg1)
            val = StringToNumber(val_str)
            
            IfCondition GreaterThan(val, 0) ThenBlock: {
                val_minus_1 = Subtract(val, 1)
                check = BitwiseAnd(val, val_minus_1)
                IfCondition EqualTo(check, 0) ThenBlock: {
                    // Power of 2! Calculate shift amount
                    shift = 0
                    tmp = val
                    WhileLoop GreaterThan(tmp, 1) {
                        tmp = Divide(tmp, 2)
                        shift = Add(shift, 1)
                    }
                    
                    // Special case: Multiply by 1 → just compile arg0
                    IfCondition EqualTo(shift, 0) ThenBlock: {
                        result = Compile_Expression(arg0)
                        IfCondition EqualTo(result, 0) ThenBlock: {
                            ReturnValue(0)
                        }
                        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                        ReturnValue(1)
                    }
                    
                    // Emit: compile arg0, SHL RAX, shift
                    result = Compile_Expression(arg0)
                    IfCondition EqualTo(result, 0) ThenBlock: {
                        ReturnValue(0)
                    }
                    Emit_ShlRaxImm8(shift)
                    Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                    ReturnValue(1)
                }
            }
        }
        
        // Also check left operand (Multiply(8, x) → SHL x, 3)
        arg0_type = AST_GetType(arg0)
        IfCondition EqualTo(arg0_type, AST.NUMBER) ThenBlock: {
            val_str = AST_GetData1(arg0)
            val = StringToNumber(val_str)
            
            IfCondition GreaterThan(val, 0) ThenBlock: {
                val_minus_1 = Subtract(val, 1)
                check = BitwiseAnd(val, val_minus_1)
                IfCondition EqualTo(check, 0) ThenBlock: {
                    shift = 0
                    tmp = val
                    WhileLoop GreaterThan(tmp, 1) {
                        tmp = Divide(tmp, 2)
                        shift = Add(shift, 1)
                    }
                    
                    IfCondition EqualTo(shift, 0) ThenBlock: {
                        result = Compile_Expression(arg1)
                        IfCondition EqualTo(result, 0) ThenBlock: {
                            ReturnValue(0)
                        }
                        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                        ReturnValue(1)
                    }
                    
                    result = Compile_Expression(arg1)
                    IfCondition EqualTo(result, 0) ThenBlock: {
                        ReturnValue(0)
                    }
                    Emit_ShlRaxImm8(shift)
                    Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                    ReturnValue(1)
                }
            }
        }
        // === END OPTIMIZATION ===
        
        // Standard path: full IMUL
        result = Compile_Expression(arg0)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        Emit_PushRax()
        
        result = Compile_Expression(arg1)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        Emit_MovRegReg(Reg.RBX, Reg.RAX)
        Emit_PopRax()
        Emit_ImulRaxRbx()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// A number, or one straight-line assignment of a number, is a constant
// divisor. Anything else stays on IDIV.
Function.CompileArith_KnownDivisor {
    Input: node: Address
    Input: arg1: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(arg1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(arg1), AST.NUMBER) ThenBlock: {
            OptState.bind_val = StringToNumber(AST_GetData1(arg1))
            ReturnValue(1)
        }
        IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: {
            ReturnValue(Optimize_BindConst(AST_GetData1(arg1), node))
        }
        ReturnValue(0)
    }
}

// RAX is the dividend. Quotient lands in RAX. Remainder, when requested,
// is n - q*d and also lands in RAX. RCX and RBX are scratch. keep_rdx 1
// restores RDX; the EmitOperation path passes 0 because IDIV clobbers it.
// keep_quot 1, with want_rem 1, keeps the quotient across the remainder
// multiply. A dividend that already lives in r12 or r13 is written there
// while RAX still holds it. Anything else is pushed and the caller pops
// it. A proved non-negative dividend and a positive divisor use unsigned
// MUL and SHR. The magic bits are the same. Negative dividends stay signed.
Function.CompileArith_MagicFinish {
    Input: divisor: Integer
    Input: want_rem: Integer
    Input: keep_rdx: Integer
    Input: nonneg: Integer
    Input: keep_quot: Integer
    Body: {
        m = OptState.magic_m
        sh = OptState.magic_sh
        neg = OptState.magic_neg
        fast = 0
        // Unsigned MUL of this magic matches the signed sequence when the
        // dividend is non-negative only if the magic itself is positive.
        // A negative magic still adds the dividend back. Keep that signed.
        IfCondition EqualTo(nonneg, 1) ThenBlock: {
            IfCondition GreaterThan(divisor, 0) ThenBlock: {
                IfCondition GreaterThan(m, 0) ThenBlock: { fast = 1 }
            }
        }
        IfCondition EqualTo(keep_rdx, 1) ThenBlock: {
            Emit_PushRdx()
        }
        IfCondition EqualTo(fast, 1) ThenBlock: {
            IfCondition EqualTo(want_rem, 1) ThenBlock: {
                Emit_MovRegReg(Reg.RCX, Reg.RAX)
            }
            X86_MovRbxImm64(m)
            X86_MulHighRbx()
            IfCondition GreaterThan(sh, 0) ThenBlock: {
                X86_ShrRdxImm8(sh)
            }
            Emit_MovRegReg(Reg.RAX, Reg.RDX)
        } ElseBlock: {
            Emit_MovRegReg(Reg.RCX, Reg.RAX)
            X86_MovRbxImm64(m)
            X86_ImulHighRbx()
            IfCondition LessThan(m, 0) ThenBlock: {
                X86_AddRegReg(Reg.RDX, Reg.RCX)
            }
            IfCondition GreaterThan(sh, 0) ThenBlock: {
                X86_SarRdxImm8(sh)
            }
            Emit_MovRegReg(Reg.RBX, Reg.RCX)
            X86_SarRbxImm8(63)
            IfCondition EqualTo(neg, 0) ThenBlock: {
                Emit_MovRegReg(Reg.RAX, Reg.RDX)
                X86_SubRegReg(Reg.RAX, Reg.RBX)
            } ElseBlock: {
                Emit_MovRegReg(Reg.RAX, Reg.RBX)
                X86_SubRegReg(Reg.RAX, Reg.RDX)
            }
        }
        IfCondition EqualTo(keep_rdx, 1) ThenBlock: {
            Emit_PopRdx()
        }
        IfCondition EqualTo(want_rem, 1) ThenBlock: {
            IfCondition EqualTo(keep_quot, 1) ThenBlock: {
                IfCondition EqualTo(OptState.divmod_home, 1) ThenBlock: {
                    Emit_HomeMove(17, 0)
                }
                IfCondition EqualTo(OptState.divmod_home, 2) ThenBlock: {
                    Emit_HomeMove(2, 0)
                }
                IfCondition EqualTo(OptState.divmod_home, 0) ThenBlock: {
                    Emit_PushRax()
                }
            }
            IfCondition EqualTo(Optimize_Fit32(divisor), 1) ThenBlock: {
                X86_ImulRaxImm32(divisor)
            } ElseBlock: {
                X86_MovRbxImm64(divisor)
                X86_ImulRaxRbx()
            }
            X86_SubRegReg(Reg.RCX, Reg.RAX)
            Emit_MovRegReg(Reg.RAX, Reg.RCX)
        }
    }
}

// 1 when every call under node is an intrinsic. A user call can be inlined
// and return, which would skip the popped quotient.
Function.CompileArith_CallsOk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IF) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.RETURN) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.BODY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.TRY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.SWITCH) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.FOR_EVERY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.EXIT_LOOP) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.CONTINUE_LOOP) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_HomeCallOk(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        }
        count = AST_GetChildCount(node)
        ci = 0
        WhileLoop LessThan(ci, count) {
            IfCondition EqualTo(CompileArith_CallsOk(AST_GetChild(node, ci)), 0) ThenBlock: { ReturnValue(0) }
            ci = Add(ci, 1)
        }
        ReturnValue(1)
    }
}

// The remainder is in RAX and the quotient is already pushed. When the
// next statement is sum = Add(rem, imm), fold that add into RAX and skip
// the statement. A following SetByte can then take the sum from RAX.
// Returns 1 when the add was taken, 0 to store the remainder normally,
// and -1 when the store of the sum failed.
Function.CompileArith_FoldRemAdd {
    Input: block: Address
    Input: index: Integer
    Input: dest: Address
    Output: Integer
    Body: {
        nxt = Add(index, 1)
        count = AST_GetChildCount(block)
        IfCondition GreaterEqual(nxt, count) ThenBlock: { ReturnValue(0) }
        st = AST_GetChild(block, nxt)
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(0) }
        tname = AST_GetData1(st)
        IfCondition EqualTo(Optimize_NameEq(tname, dest), 1) ThenBlock: { ReturnValue(0) }
        aval = AST_GetChild(st, 0)
        IfCondition EqualTo(aval, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(aval), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(aval), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(aval), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(aval, 0)
        right = AST_GetChild(aval, 1)
        imm_node = 0
        IfCondition EqualTo(Optimize_IdentEq(left, dest), 1) ThenBlock: { imm_node = right }
        IfCondition EqualTo(imm_node, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IdentEq(right, dest), 1) ThenBlock: { imm_node = left }
        }
        IfCondition EqualTo(imm_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(imm_node), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        imm = StringToNumber(AST_GetData1(imm_node))
        IfCondition LessThan(imm, -2147483648) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(imm, 2147483647) ThenBlock: { ReturnValue(0) }
        k = Add(index, 1)
        WhileLoop LessThan(k, count) {
            sk = AST_GetChild(block, k)
            IfCondition NotEqual(k, nxt) ThenBlock: {
                IfCondition EqualTo(Optimize_PlainAssign(sk), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), dest), 1) ThenBlock: { ReturnValue(0) }
                }
                IfCondition GreaterThan(Optimize_CountIdents(sk, dest), 0) ThenBlock: { ReturnValue(0) }
            }
            k = Add(k, 1)
        }
        Emit_AddRaxImm8(imm)
        Optimize_PtrClear(tname)
        Optimize_XmmDrop(tname)
        Optimize_CoalDrop(tname)
        Optimize_OutAssign(tname, aval)
        Optimize_AliasClear(tname)
        held = Optimize_IholdArm(tname)
        IfCondition EqualTo(held, 0) ThenBlock: {
            stored = CompileExpr_StoreVariable(tname)
            IfCondition EqualTo(stored, 0) ThenBlock: { ReturnValue(-1) }
            Optimize_NotePtrCopy(tname, aval)
        }
        OptState.divmod_mid = nxt
        ReturnValue(1)
    }
}

// dig = Modulo(n, K) later in this block followed by n = Divide(n, K).
// One magic multiply produces both. Statements in between do not name n,
// so they still see the old n. When n is the r12 accumulator, the quotient
// is written there before the remainder multiply. The r13 cursor gets the
// same treatment only when no alias or pointer home is live, because those
// loads use r13 without naming it. Every other dividend stays pushed until
// CompileArith_CommitQuot. Returns the divide statement index, -2 after a
// failed emit, or -1.
Function.CompileArith_TryDivMod {
    Input: block: Address
    Input: index: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(-1) }
        st = AST_GetChild(block, index)
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(-1) }
        dest = AST_GetData1(st)
        val = AST_GetChild(st, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Modulo"), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(-1) }
        dividend = AST_GetChild(val, 0)
        IfCondition EqualTo(dividend, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetType(dividend), AST.IDENTIFIER) ThenBlock: { ReturnValue(-1) }
        dname = AST_GetData1(dividend)
        IfCondition EqualTo(Optimize_NameEq(dest, dname), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CompileArith_KnownDivisor(val, AST_GetChild(val, 1)), 0) ThenBlock: { ReturnValue(-1) }
        kval = OptState.bind_val
        IfCondition EqualTo(Optimize_MagicPrepare(kval), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(kval, 0) ThenBlock: {
            km1 = Subtract(kval, 1)
            IfCondition EqualTo(BitwiseAnd(kval, km1), 0) ThenBlock: { ReturnValue(-1) }
        }
        count = AST_GetChildCount(block)
        k = Add(index, 1)
        div_at = -1
        WhileLoop LessThan(k, count) {
            sk = AST_GetChild(block, k)
            IfCondition EqualTo(Optimize_PlainAssign(sk), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), dname), 1) ThenBlock: {
                    dv = AST_GetChild(sk, 0)
                    matched = 0
                    IfCondition NotEqual(dv, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(dv), AST.CALL) ThenBlock: {
                            IfCondition EqualTo(StringCompare(AST_GetData1(dv), "Divide"), 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetChildCount(dv), 2) ThenBlock: {
                                    IfCondition EqualTo(Optimize_IdentEq(AST_GetChild(dv, 0), dname), 1) ThenBlock: {
                                        IfCondition EqualTo(CompileArith_KnownDivisor(dv, AST_GetChild(dv, 1)), 1) ThenBlock: {
                                            IfCondition EqualTo(OptState.bind_val, kval) ThenBlock: { matched = 1 }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(matched, 0) ThenBlock: { ReturnValue(-1) }
                    div_at = k
                    k = count
                }
            }
            IfCondition LessThan(div_at, 0) ThenBlock: {
                straight = 0
                IfCondition EqualTo(Optimize_PlainAssign(sk), 1) ThenBlock: { straight = 1 }
                IfCondition EqualTo(AST_GetType(sk), AST.CALL) ThenBlock: { straight = 1 }
                IfCondition EqualTo(straight, 0) ThenBlock: { ReturnValue(-1) }
                IfCondition EqualTo(CompileArith_CallsOk(sk), 0) ThenBlock: { ReturnValue(-1) }
                IfCondition GreaterThan(Optimize_CountIdents(sk, dname), 0) ThenBlock: { ReturnValue(-1) }
                IfCondition EqualTo(Optimize_PlainAssign(sk), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), dname), 1) ThenBlock: { ReturnValue(-1) }
                }
            }
            k = Add(k, 1)
        }
        IfCondition LessThan(div_at, 0) ThenBlock: { ReturnValue(-1) }
        saved_m = OptState.magic_m
        saved_sh = OptState.magic_sh
        saved_neg = OptState.magic_neg
        dv = AST_GetChild(AST_GetChild(block, div_at), 0)
        IfCondition EqualTo(Optimize_IndexDead(dest, val), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_IndexDead(dname, dv), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_TryReloadDrop(dest, val), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_TryReloadDrop(dname, dv), 1) ThenBlock: { ReturnValue(-1) }

        nn = 0
        IfCondition GreaterThan(kval, 0) ThenBlock: {
            nn = Optimize_ProvedNonNeg(dividend)
        }
        Optimize_IholdMakeRoom(val)
        Optimize_FlushHold()
        Optimize_PtrClear(dest)
        Optimize_XmmDrop(dest)
        Optimize_CoalDrop(dest)
        Optimize_OutAssign(dest, val)
        Optimize_AliasClear(dest)
        got = Compile_Expression(dividend)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(-2) }
        OptState.magic_m = saved_m
        OptState.magic_sh = saved_sh
        OptState.magic_neg = saved_neg
        // r13 is also the cursor address base. A live alias or pointer
        // home reads it without naming the cursor, so that case keeps
        // the push.
        OptState.divmod_home = 0
        IfCondition EqualTo(Optimize_IsAccHome(dname), 1) ThenBlock: {
            OptState.divmod_home = 1
        }
        IfCondition EqualTo(OptState.divmod_home, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsIntHome(dname), 1) ThenBlock: {
                alias = 0
                IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: { alias = 1 }
                IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: { alias = 1 }
                IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: { alias = 1 }
                IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: { alias = 1 }
                IfCondition EqualTo(LoopHome.p0_on, 1) ThenBlock: { alias = 1 }
                IfCondition EqualTo(LoopHome.p1_on, 1) ThenBlock: { alias = 1 }
                IfCondition EqualTo(LoopHome.p2_on, 1) ThenBlock: { alias = 1 }
                IfCondition EqualTo(LoopHome.p3_on, 1) ThenBlock: { alias = 1 }
                IfCondition EqualTo(alias, 0) ThenBlock: {
                    OptState.divmod_home = 2
                }
            }
        }
        CompileArith_MagicFinish(kval, 1, 1, nn, 1)
        took = CompileArith_FoldRemAdd(block, index, dest)
        IfCondition EqualTo(took, -1) ThenBlock: {
            IfCondition EqualTo(OptState.divmod_home, 0) ThenBlock: {
                Emit_PopRax()
            }
            OptState.divmod_home = 0
            OptState.divmod_mid = -1
            Compile.error = 1
            ReturnValue(-2)
        }
        IfCondition EqualTo(took, 0) ThenBlock: {
            stored = CompileExpr_StoreVariable(dest)
            IfCondition EqualTo(stored, 0) ThenBlock: {
                IfCondition EqualTo(OptState.divmod_home, 0) ThenBlock: {
                    Emit_PopRax()
                }
                OptState.divmod_home = 0
                Compile.error = 1
                ReturnValue(-2)
            }
            Optimize_AliasClear(dest)
            Optimize_NotePtrCopy(dest, val)
        }
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 2)
        ReturnValue(div_at)
    }
}

// Store the quotient from CompileArith_TryDivMod as this Divide
// assignment would have. A home park already wrote r12 or r13.
Function.CompileArith_CommitQuot {
    Input: st: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(st, 0) ThenBlock: {
            OptState.divmod_home = 0
            Compile.error = 1
            ReturnValue(0)
        }
        dname = AST_GetData1(st)
        dv = AST_GetChild(st, 0)
        Optimize_PtrClear(dname)
        Optimize_XmmDrop(dname)
        Optimize_CoalDrop(dname)
        Optimize_OutAssign(dname, dv)
        Optimize_IholdMakeRoom(dv)
        Optimize_FlushHold()
        Optimize_AliasClear(dname)
        IfCondition EqualTo(OptState.divmod_home, 0) ThenBlock: {
            Emit_PopRax()
            stored = CompileExpr_StoreVariable(dname)
            IfCondition EqualTo(stored, 0) ThenBlock: {
                OptState.divmod_home = 0
                Compile.error = 1
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(OptState.divmod_home, 2) ThenBlock: {
            Optimize_PtrClearAll()
        }
        OptState.divmod_home = 0
        Optimize_AliasClear(dname)
        Optimize_NotePtrCopy(dname, dv)
        ReturnValue(1)
    }
}

// 1 when target sits under node. The node is not under itself.
Function.CompileArith_NodeHas {
    Input: node: Address
    Input: target: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, target) ThenBlock: { ReturnValue(1) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(CompileArith_NodeHas(AST_GetChild(node, i), target), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Exclusive upper bound of LessThan(name, bound) or GreaterThan(bound, name).
// A number, or one straight-line constant. -1 when it is not that shape.
Function.CompileArith_ReadBound {
    Input: cond: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetType(cond), AST.CALL) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetChildCount(cond), 2) ThenBlock: { ReturnValue(-1) }
        op = AST_GetData1(cond)
        left = AST_GetChild(cond, 0)
        right = AST_GetChild(cond, 1)
        bound = 0
        IfCondition EqualTo(StringCompare(op, "LessThan"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetType(left), AST.IDENTIFIER) ThenBlock: { ReturnValue(-1) }
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(left), name), 0) ThenBlock: { ReturnValue(-1) }
            bound = right
        }
        IfCondition EqualTo(bound, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(op, "GreaterThan"), 0) ThenBlock: {
                IfCondition NotEqual(AST_GetType(right), AST.IDENTIFIER) ThenBlock: { ReturnValue(-1) }
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(right), name), 0) ThenBlock: { ReturnValue(-1) }
                bound = left
            }
        }
        IfCondition EqualTo(bound, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(AST_GetType(bound), AST.NUMBER) ThenBlock: {
            bv = StringToNumber(AST_GetData1(bound))
            IfCondition LessEqual(bv, 0) ThenBlock: { ReturnValue(-1) }
            ReturnValue(bv)
        }
        IfCondition EqualTo(AST_GetType(bound), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_BindConst(AST_GetData1(bound), cond), 0) ThenBlock: { ReturnValue(-1) }
            bv2 = OptState.bind_val
            IfCondition LessEqual(bv2, 0) ThenBlock: { ReturnValue(-1) }
            ReturnValue(bv2)
        }
        ReturnValue(-1)
    }
}

// RHS of the latest plain assignment to name before start, walking back
// through reads and calls. A branch or loop that mentions name stops the
// walk: that write is not a single constant or name. Zero when none.
Function.CompileArith_LastRhs {
    Input: start: Address
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        cur = start
        n = 0
        WhileLoop LessThan(n, 16) {
            cur = Optimize_PrevSibling(Compile.current_func, cur)
            IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_PlainAssign(cur), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(cur), name), 1) ThenBlock: {
                    ReturnValue(AST_GetChild(cur, 0))
                }
            } ElseBlock: {
                IfCondition GreaterThan(Optimize_CountIdents(cur, name), 0) ThenBlock: {
                    IfCondition NotEqual(AST_GetType(cur), AST.CALL) ThenBlock: { ReturnValue(0) }
                }
            }
            n = Add(n, 1)
        }
        ReturnValue(0)
    }
}

// Upper bound of name at inner, from an enclosing counted loop in this
// function. -1 when the value is not proved. Callers do not get to invent
// a bound the function itself does not prove.
Function.CompileArith_DigitHi {
    Input: node: Address
    Input: name: Address
    Input: inner: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(-1) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            sub = CompileArith_DigitHi(AST_GetChild(node, i), name, inner)
            IfCondition GreaterEqual(sub, 0) ThenBlock: { ReturnValue(sub) }
            i = Add(i, 1)
        }
        IfCondition NotEqual(AST_GetType(node), AST.WHILE) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(count, 2) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(CompileArith_NodeHas(AST_GetChild(node, 1), inner), 0) ThenBlock: { ReturnValue(-1) }
        limit = CompileArith_ReadBound(AST_GetChild(node, 0), name)
        IfCondition LessThan(limit, 0) ThenBlock: { ReturnValue(-1) }
        rhs = CompileArith_LastRhs(node, name)
        IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetType(rhs), AST.NUMBER) ThenBlock: { ReturnValue(-1) }
        init = StringToNumber(AST_GetData1(rhs))
        IfCondition LessThan(init, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(init, limit) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(Optimize_NnIncTally(AST_GetChild(node, 1), name), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_LiveEscape(Compile.current_func, name), 1) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Subtract(limit, 1))
    }
}

// How many radix-K digits a value in 0..hi needs. trip+1 means the trip
// cannot be shortened: the value may still have a digit the source keeps.
Function.CompileArith_DigitCount {
    Input: hi: Integer
    Input: kval: Integer
    Input: trip: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(hi, 0) ThenBlock: { ReturnValue(Add(trip, 1)) }
        IfCondition LessThan(hi, kval) ThenBlock: { ReturnValue(1) }
        d = 1
        pow = kval
        maxv = 9223372036854775807
        WhileLoop GreaterEqual(hi, pow) {
            IfCondition GreaterEqual(d, trip) ThenBlock: { ReturnValue(Add(trip, 1)) }
            room = Divide(maxv, kval)
            IfCondition GreaterThan(pow, room) ThenBlock: { ReturnValue(Add(trip, 1)) }
            pow = Multiply(pow, kval)
            d = Add(d, 1)
        }
        ReturnValue(d)
    }
}

// lea rcx, [sib]. sib selects [rdx+rdx*scale] or [rcx+rdx*scale].
// rdx is not written. rax is not written. ModRM is rcx, no displacement.
Function.CompileArith_LeaRcx {
    Input: sib: Integer
    Body: {
        Listing_Open("LEA rcx, [scaled]")
        Emit_Byte(0x48)
        Emit_Byte(0x8D)
        Emit_Byte(0x0C)
        Emit_Byte(sib)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// SHL rcx, n. n is 0..31. rcx is the only register written.
Function.CompileArith_ShlRcx {
    Input: n: Integer
    Body: {
        Listing_Open("SHL rcx, imm8")
        Emit_Byte(0x48)
        Emit_Byte(0xC1)
        Emit_Byte(0xE1)
        Emit_Byte(BitwiseAnd(n, 255))
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// rsi = rsi - rdx*k. rdx stays the quotient. rcx is scratch.
// Does not write rax, so the next mov rax can issue off the quotient
// alone. A small k is a shift of a lea core so this does not take the
// multiply unit. Anything else uses imul. q*k fits: the dividend is
// non-negative and q*k is at most that dividend.
Function.CompileArith_RemRsi {
    Input: k: Integer
    Body: {
        done = 0
        IfCondition GreaterThan(k, 1) ThenBlock: {
            sh = 0
            core = k
            WhileLoop And(EqualTo(BitwiseAnd(core, 1), 0), LessThan(sh, 30)) {
                core = Divide(core, 2)
                sh = Add(sh, 1)
            }
            ok = 0
            IfCondition EqualTo(core, 1) ThenBlock: {
                Emit_MovRegReg(Reg.RCX, Reg.RDX)
                ok = 1
            }
            IfCondition EqualTo(core, 3) ThenBlock: {
                CompileArith_LeaRcx(0x52)
                ok = 1
            }
            IfCondition EqualTo(core, 5) ThenBlock: {
                CompileArith_LeaRcx(0x92)
                ok = 1
            }
            IfCondition EqualTo(core, 9) ThenBlock: {
                CompileArith_LeaRcx(0xD2)
                ok = 1
            }
            IfCondition EqualTo(core, 7) ThenBlock: {
                CompileArith_LeaRcx(0x92)
                CompileArith_LeaRcx(0x51)
                ok = 1
            }
            IfCondition EqualTo(core, 11) ThenBlock: {
                CompileArith_LeaRcx(0xD2)
                CompileArith_LeaRcx(0x51)
                ok = 1
            }
            IfCondition EqualTo(core, 15) ThenBlock: {
                CompileArith_LeaRcx(0x92)
                CompileArith_LeaRcx(0x49)
                ok = 1
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                IfCondition EqualTo(sh, 1) ThenBlock: {
                    X86_AddRegReg(Reg.RCX, Reg.RCX)
                }
                IfCondition GreaterThan(sh, 1) ThenBlock: {
                    CompileArith_ShlRcx(sh)
                }
                X86_SubRegReg(Reg.RSI, Reg.RCX)
                done = 1
            }
        }
        IfCondition EqualTo(done, 0) ThenBlock: {
            Emit_MovRegReg(Reg.RAX, Reg.RDX)
            X86_ImulRaxImm32(k)
            X86_SubRegReg(Reg.RSI, Reg.RAX)
        }
    }
}

// Issue mul rbx of the dividend. from_iv 1 reads r13, otherwise r12.
// The dividend is copied to rsi after the mul is issued. rdx still holds
// the product. rax is not needed again until the next digit.
Function.CompileArith_DigitIssue {
    Input: from_iv: Integer
    Body: {
        IfCondition EqualTo(from_iv, 1) ThenBlock: {
            Emit_MovRaxR13()
            X86_MulHighRbx()
            Emit_MovRegReg(Reg.RSI, Reg.R13)
        } ElseBlock: {
            Emit_MovRaxR12()
            X86_MulHighRbx()
            Emit_MovRegReg(Reg.RSI, Reg.R12)
        }
    }
}

// Finish the mul issued by DigitIssue. Quotient goes to r12. Remainder
// lands in rsi. rdx stays the quotient until the remainder reads it.
Function.CompileArith_DigitFinish {
    Input: divisor: Integer
    Input: sh: Integer
    Body: {
        IfCondition GreaterThan(sh, 0) ThenBlock: {
            X86_ShrRdxImm8(sh)
        }
        Emit_MovRegReg(Reg.R12, Reg.RDX)
        CompileArith_RemRsi(divisor)
    }
}

// n is in r12, magic is in rbx. Remainder lands in rsi. r13 and r14 stay put.
Function.CompileArith_DigitStep {
    Input: divisor: Integer
    Input: sh: Integer
    Body: {
        CompileArith_DigitIssue(0)
        CompileArith_DigitFinish(divisor, sh)
    }
}

// r14 is the running sum. One add. from_quot 1 adds r12, otherwise rsi.
Function.CompileArith_DigitAcc {
    Input: from_quot: Integer
    Body: {
        IfCondition EqualTo(from_quot, 1) ThenBlock: {
            X86Enc_Assemble("ADD r14, r12")
        } ElseBlock: {
            X86Enc_Assemble("ADD r14, rsi")
        }
    }
}

// ADD eax, bias. imm8 when the bias fits in a signed byte, otherwise imm32.
// Zero bias emits nothing. Only the stored low byte is consumed after this.
Function.CompileArith_AddEax {
    Input: bias: Integer
    Body: {
        IfCondition EqualTo(bias, 0) ThenBlock: { ReturnValue(0) }
        Listing_Open("ADD eax, bias")
        IfCondition And(GreaterEqual(bias, -128), LessEqual(bias, 127)) ThenBlock: {
            Emit_Byte(0x83)
            Emit_Byte(0xC0)
            Emit_Byte(BitwiseAnd(bias, 255))
        } ElseBlock: {
            Emit_Byte(0x05)
            Emit_DWord(bias)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// Store one byte at [r14+r13] and decrement r13. from 0 is the remainder
// in rsi, 1 is the quotient in r12, 2 is the bias alone.
Function.CompileArith_DigitByte {
    Input: from: Integer
    Input: bias: Integer
    Body: {
        IfCondition EqualTo(from, 0) ThenBlock: {
            Emit_MovRegReg(Reg.RAX, Reg.RSI)
        }
        IfCondition EqualTo(from, 1) ThenBlock: {
            Emit_MovRaxR12()
        }
        IfCondition EqualTo(from, 2) ThenBlock: {
            IfCondition EqualTo(bias, 0) ThenBlock: {
                Emit_XorRaxRax()
            } ElseBlock: {
                Emit_MovRaxImm64(bias)
            }
        }
        IfCondition LessThan(from, 2) ThenBlock: {
            CompileArith_AddEax(bias)
        }
        Emit_MovRegReg(Reg.RCX, Reg.R14)
        X86_SibByte(2, 1, 13)
        X86_AddR13Imm32(-1)
    }
}

// mov byte [r14+disp], al. disp 0 uses no displacement. r13 is not the index.
Function.CompileArith_ByteDisp {
    Input: disp: Integer
    Body: {
        Listing_Open("MOV byte [r14+disp], al")
        IfCondition EqualTo(disp, 0) ThenBlock: {
            Emit_Byte(0x41)
            Emit_Byte(0x88)
            Emit_Byte(0x06)
        } ElseBlock: {
            IfCondition And(GreaterEqual(disp, -128), LessThan(disp, 128)) ThenBlock: {
                Emit_Byte(0x41)
                Emit_Byte(0x88)
                Emit_Byte(0x46)
                Emit_Byte(BitwiseAnd(disp, 255))
            } ElseBlock: {
                Emit_Byte(0x41)
                Emit_Byte(0x88)
                Emit_Byte(0x86)
                Emit_DWord(disp)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// mov byte [r14+disp], imm8. The immediate is the low 8 bits.
Function.CompileArith_ByteImm {
    Input: disp: Integer
    Input: imm: Integer
    Body: {
        low = BitwiseAnd(imm, 255)
        Listing_Open("MOV byte [r14+disp], imm8")
        IfCondition EqualTo(disp, 0) ThenBlock: {
            Emit_Byte(0x41)
            Emit_Byte(0xC6)
            Emit_Byte(0x06)
            Emit_Byte(low)
        } ElseBlock: {
            IfCondition And(GreaterEqual(disp, -128), LessThan(disp, 128)) ThenBlock: {
                Emit_Byte(0x41)
                Emit_Byte(0xC6)
                Emit_Byte(0x46)
                Emit_Byte(BitwiseAnd(disp, 255))
                Emit_Byte(low)
            } ElseBlock: {
                Emit_Byte(0x41)
                Emit_Byte(0xC6)
                Emit_Byte(0x86)
                Emit_DWord(disp)
                Emit_Byte(low)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// ADD esi, bias. Same split as AddEax. A 32-bit add zero-extends, and
// only sil is stored. Zero bias emits nothing, so rsi stays the remainder.
// Do not use this on the running sum. That add needs all 64 bits.
Function.CompileArith_AddEsi {
    Input: bias: Integer
    Body: {
        IfCondition EqualTo(bias, 0) ThenBlock: { ReturnValue(0) }
        Listing_Open("ADD esi, bias")
        IfCondition And(GreaterEqual(bias, -128), LessEqual(bias, 127)) ThenBlock: {
            Emit_Byte(0x83)
            Emit_Byte(0xC6)
            Emit_Byte(BitwiseAnd(bias, 255))
        } ElseBlock: {
            Emit_Byte(0x81)
            Emit_Byte(0xC6)
            Emit_DWord(bias)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// mov byte [r14+disp], sil. The remainder stays out of rax, so the next
// mov rax is not waiting on the bias add. disp 0 uses no displacement.
Function.CompileArith_ByteSil {
    Input: disp: Integer
    Body: {
        Listing_Open("MOV byte [r14+disp], sil")
        IfCondition EqualTo(disp, 0) ThenBlock: {
            Emit_Byte(0x41)
            Emit_Byte(0x88)
            Emit_Byte(0x36)
        } ElseBlock: {
            IfCondition And(GreaterEqual(disp, -128), LessThan(disp, 128)) ThenBlock: {
                Emit_Byte(0x41)
                Emit_Byte(0x88)
                Emit_Byte(0x76)
                Emit_Byte(BitwiseAnd(disp, 255))
            } ElseBlock: {
                Emit_Byte(0x41)
                Emit_Byte(0x88)
                Emit_Byte(0xB6)
                Emit_DWord(disp)
            }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// Store one digit at [r14+disp]. Does not change r13. from 0 is the
// remainder in rsi, stored from sil. from 1 is the quotient in r12.
// from 2 is the bias byte. The remainder path does not write rax.
Function.CompileArith_DigitAt {
    Input: from: Integer
    Input: bias: Integer
    Input: disp: Integer
    Body: {
        IfCondition EqualTo(from, 2) ThenBlock: {
            CompileArith_ByteImm(disp, bias)
            ReturnValue(0)
        }
        IfCondition EqualTo(from, 0) ThenBlock: {
            CompileArith_AddEsi(bias)
            CompileArith_ByteSil(disp)
            ReturnValue(0)
        }
        Emit_MovRaxR12()
        CompileArith_AddEax(bias)
        CompileArith_ByteDisp(disp)
        ReturnValue(0)
    }
}

// Pack the straight-line controls into one word. SysV keeps six inputs.
// indexed is bit 0. mode is bits 1..2. use_last is bit 3.
// steps is bits 4..8. pconst is bits 9..13. Both counts fit in 0..16
// on every path that stores a byte. A long sum counter is not stored.
// flags is bits 14..16. Bit 0 defers the use_last zero of n to the caller.
// Bit 1 reads the first dividend from r13. Bit 2 bumps r13 once that mul
// is in flight. The nest sets those. A standalone call passes 0.
Function.CompileArith_DigitCtrl {
    Input: indexed: Integer
    Input: mode: Integer
    Input: use_last: Integer
    Input: steps: Integer
    Input: pconst: Integer
    Input: flags: Integer
    Output: Integer
    Body: {
        ctrl = indexed
        ctrl = Add(ctrl, LeftShift(mode, 1))
        ctrl = Add(ctrl, LeftShift(use_last, 3))
        ctrl = Add(ctrl, LeftShift(steps, 4))
        pc = pconst
        IfCondition GreaterThan(pc, 31) ThenBlock: { pc = 0 }
        IfCondition LessThan(pc, 0) ThenBlock: { pc = 0 }
        ctrl = Add(ctrl, LeftShift(pc, 9))
        ctrl = Add(ctrl, LeftShift(BitwiseAnd(flags, 7), 14))
        ReturnValue(ctrl)
    }
}

// Emit the already-owned digit steps with no test and no back edge.
// indexed 1 keeps r13 as the byte index and counts it down. indexed 0
// stores at fixed displacements from pconst and leaves r13 alone.
// use_last adds the leftover quotient. It zeros n unless the caller
// stores that zero itself. A full trip does neither.
// The first multiply can read r13 and bump it once the mul is in flight.
// Those two flags stay off when r13 is the byte index. Up to four proved
// zero bytes sit in that window. A longer run stays after the digits.
Function.CompileArith_DigitStraight {
    Input: ctrl: Integer
    Input: kval: Integer
    Input: sh: Integer
    Input: bias: Integer
    Body: {
        indexed = BitwiseAnd(ctrl, 1)
        mode = BitwiseAnd(RightShift(ctrl, 1), 3)
        use_last = BitwiseAnd(RightShift(ctrl, 3), 1)
        steps = BitwiseAnd(RightShift(ctrl, 4), 31)
        pconst = BitwiseAnd(RightShift(ctrl, 9), 31)
        defer_zero = BitwiseAnd(RightShift(ctrl, 14), 1)
        src_iv = BitwiseAnd(RightShift(ctrl, 15), 1)
        early_inc = BitwiseAnd(RightShift(ctrl, 16), 1)
        IfCondition EqualTo(use_last, 1) ThenBlock: {
            k = 0
            moved_z = 0
            WhileLoop LessThan(k, steps) {
                from_iv = 0
                IfCondition EqualTo(k, 0) ThenBlock: {
                    IfCondition EqualTo(indexed, 0) ThenBlock: {
                        IfCondition EqualTo(src_iv, 1) ThenBlock: {
                            from_iv = 1
                        }
                    }
                }
                CompileArith_DigitIssue(from_iv)
                IfCondition EqualTo(k, 0) ThenBlock: {
                    IfCondition EqualTo(indexed, 0) ThenBlock: {
                        IfCondition EqualTo(early_inc, 1) ThenBlock: {
                            X86_IncR13()
                        }
                        IfCondition EqualTo(mode, 2) ThenBlock: {
                            zcount = Subtract(Subtract(pconst, steps), 1)
                            IfCondition GreaterThan(zcount, 0) ThenBlock: {
                                IfCondition LessEqual(zcount, 4) ThenBlock: {
                                    zlead = zcount
                                    WhileLoop GreaterThan(zlead, 0) {
                                        CompileArith_DigitAt(2, bias, zlead)
                                        zlead = Subtract(zlead, 1)
                                    }
                                    moved_z = 1
                                }
                            }
                        }
                    }
                }
                CompileArith_DigitFinish(kval, sh)
                IfCondition EqualTo(mode, 1) ThenBlock: {
                    CompileArith_DigitAcc(0)
                } ElseBlock: {
                    IfCondition EqualTo(indexed, 1) ThenBlock: {
                        CompileArith_DigitByte(0, bias)
                    } ElseBlock: {
                        at = Subtract(pconst, k)
                        CompileArith_DigitAt(0, bias, at)
                    }
                }
                k = Add(k, 1)
            }
            IfCondition EqualTo(mode, 1) ThenBlock: {
                CompileArith_DigitAcc(1)
            } ElseBlock: {
                IfCondition EqualTo(indexed, 1) ThenBlock: {
                    CompileArith_DigitByte(1, bias)
                } ElseBlock: {
                    qat = Subtract(pconst, steps)
                    CompileArith_DigitAt(1, bias, qat)
                }
            }
            IfCondition EqualTo(defer_zero, 0) ThenBlock: {
                Emit_XorRaxRax()
                Emit_MovR12Rax()
            }
            IfCondition EqualTo(mode, 2) ThenBlock: {
                IfCondition EqualTo(moved_z, 0) ThenBlock: {
                    z = Subtract(Subtract(pconst, steps), 1)
                    WhileLoop GreaterThan(z, 0) {
                        IfCondition EqualTo(indexed, 1) ThenBlock: {
                            CompileArith_DigitByte(2, bias)
                        } ElseBlock: {
                            CompileArith_DigitAt(2, bias, z)
                        }
                        z = Subtract(z, 1)
                    }
                }
            }
        } ElseBlock: {
            k2 = 0
            WhileLoop LessThan(k2, pconst) {
                from_iv = 0
                IfCondition EqualTo(k2, 0) ThenBlock: {
                    IfCondition EqualTo(indexed, 0) ThenBlock: {
                        IfCondition EqualTo(src_iv, 1) ThenBlock: {
                            from_iv = 1
                        }
                    }
                }
                CompileArith_DigitIssue(from_iv)
                IfCondition EqualTo(k2, 0) ThenBlock: {
                    IfCondition EqualTo(indexed, 0) ThenBlock: {
                        IfCondition EqualTo(early_inc, 1) ThenBlock: {
                            X86_IncR13()
                        }
                    }
                }
                CompileArith_DigitFinish(kval, sh)
                IfCondition EqualTo(mode, 1) ThenBlock: {
                    CompileArith_DigitAcc(0)
                } ElseBlock: {
                    IfCondition EqualTo(indexed, 1) ThenBlock: {
                        CompileArith_DigitByte(0, bias)
                    } ElseBlock: {
                        at2 = Subtract(pconst, k2)
                        CompileArith_DigitAt(0, bias, at2)
                    }
                }
                k2 = Add(k2, 1)
            }
        }
    }
}

// 1 when a known trip of at most 16 steps can be copied straight.
// A sum whose proved digit count is short straight-lines that many
// multiplies even when the source counter started higher. A byte
// store still visits every index, so the counter itself is the cap.
Function.CompileArith_DigitFlat {
    Input: mode: Integer
    Input: use_last: Integer
    Input: steps: Integer
    Input: pknown: Integer
    Input: pconst: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(mode, 1) ThenBlock: {
            IfCondition EqualTo(use_last, 1) ThenBlock: {
                IfCondition GreaterEqual(steps, 0) ThenBlock: {
                    IfCondition LessEqual(steps, 16) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            }
        }
        IfCondition EqualTo(pknown, 1) ThenBlock: {
            IfCondition GreaterThan(pconst, 0) ThenBlock: {
                IfCondition LessEqual(pconst, 16) ThenBlock: {
                    IfCondition EqualTo(mode, 2) ThenBlock: { ReturnValue(1) }
                    IfCondition EqualTo(use_last, 0) ThenBlock: {
                        IfCondition EqualTo(mode, 1) ThenBlock: { ReturnValue(1) }
                    }
                }
            }
        }
        ReturnValue(0)
    }
}

// Drop facts borrowed from the loop-home pool. Callers copy them out first.
Function.CompileArith_DigitClear {
    Body: {
        LoopHome.int_name = 0
        LoopHome.acc_name = 0
        LoopHome.flt_name = 0
        LoopHome.assign_name = 0
        LoopHome.hold_name = 0
        LoopHome.lim_name = 0
        LoopHome.int_off = 0
        LoopHome.acc_off = 0
        LoopHome.flt_off = 0
        LoopHome.iv_step = 0
        LoopHome.iv_at = 0
        LoopHome.iv_hi = 0
        LoopHome.iv_lo = 0
        LoopHome.iv_nn = 0
        LoopHome.imm_ok = 0
    }
}

// Identifier node of LessThan(name, bound) or GreaterThan(bound, name).
// Zero when the condition is not a counted cursor.
Function.CompileArith_ReadCursor {
    Input: cond: Address
    Output: Address
    Body: {
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(cond), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(cond), 2) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(cond)
        left = AST_GetChild(cond, 0)
        right = AST_GetChild(cond, 1)
        IfCondition EqualTo(StringCompare(op, "LessThan"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetType(left), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
            ReturnValue(left)
        }
        IfCondition EqualTo(StringCompare(op, "GreaterThan"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetType(right), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
            ReturnValue(right)
        }
        ReturnValue(0)
    }
}

// 1 when st is name = name + 1, either addend order.
Function.CompileArith_IsInc1 {
    Input: st: Address
    Input: ivname: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), ivname), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(val, 0)
        a1 = AST_GetChild(val, 1)
        num_side = 0
        other = 0
        IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
            num_side = a0
            other = a1
        }
        IfCondition EqualTo(num_side, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                num_side = a1
                other = a0
            }
        }
        IfCondition EqualTo(num_side, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringToNumber(AST_GetData1(num_side)), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IdentEq(other, ivname), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Positive Fit32 stride when node is iv * const or const * iv. Otherwise -1.
Function.CompileArith_MulStride {
    Input: node: Address
    Input: ivname: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Multiply"), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(-1) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        num_side = 0
        other = 0
        IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
            num_side = a0
            other = a1
        }
        IfCondition EqualTo(num_side, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                num_side = a1
                other = a0
            }
        }
        IfCondition EqualTo(num_side, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_IdentEq(other, ivname), 0) ThenBlock: { ReturnValue(-1) }
        stride = StringToNumber(AST_GetData1(num_side))
        IfCondition LessEqual(stride, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_Fit32(stride), 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(stride)
    }
}

// Frame slot for a digit name. The store that creates the slot may sit
// inside the loop this pass is compiling, so the name is not registered
// yet. Allocate it the same way the store would, then the later store
// finds the slot and does not take a second one.
Function.CompileArith_FrameSlot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_FrameOff(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        Scope_Resolve(name)
        IfCondition NotEqual(Scope.resolve_type, 0) ThenBlock: { ReturnValue(0) }
        Compile.stack_offset = Add(Compile.stack_offset, 8)
        off = Subtract(0, Compile.stack_offset)
        Compile_RegisterLocal(name, off)
        LoopHome.imm_ok = 1
        LoopHome.imm_val = off
        ReturnValue(1)
    }
}

// while p > 0 { dig = n % K; use(dig); n = n / K; p = p - 1 }
// K is a positive constant with a positive magic multiply, not a power of
// two. Returns 1 for a sum and 2 for a byte store. On success the facts
// sit in the loop-home pool for the caller to copy before any other call.
// Failure writes nothing. Negative n stays on the signed path. This is
// not a countdown unroll and not a narrower-width divide.
Function.CompileArith_DigitPrep {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        cond = AST_GetChild(node, 0)
        body = AST_GetChild(node, 1)
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(cond), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(cond), "GreaterThan"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(cond), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(cond, 0)
        c1 = AST_GetChild(cond, 1)
        IfCondition NotEqual(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(c1), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringToNumber(AST_GetData1(c1)), 0) ThenBlock: { ReturnValue(0) }
        pname = AST_GetData1(c0)
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        bty = AST_GetType(body)
        is_block = 0
        IfCondition EqualTo(bty, AST.BLOCK) ThenBlock: { is_block = 1 }
        IfCondition EqualTo(bty, AST.BODY) ThenBlock: { is_block = 1 }
        IfCondition EqualTo(is_block, 0) ThenBlock: { ReturnValue(0) }
        bcount = AST_GetChildCount(body)
        IfCondition LessThan(bcount, 3) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(bcount, 6) ThenBlock: { ReturnValue(0) }

        mod_at = -1
        nname = 0
        dname = 0
        kval = 0
        dividend = 0
        i = 0
        WhileLoop LessThan(i, bcount) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                val = AST_GetChild(st, 0)
                IfCondition NotEqual(val, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                        IfCondition EqualTo(StringCompare(AST_GetData1(val), "Modulo"), 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetChildCount(val), 2) ThenBlock: {
                                IfCondition GreaterEqual(mod_at, 0) ThenBlock: { ReturnValue(0) }
                                IfCondition EqualTo(CompileArith_KnownDivisor(val, AST_GetChild(val, 1)), 0) ThenBlock: { ReturnValue(0) }
                                IfCondition NotEqual(AST_GetType(AST_GetChild(val, 0)), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
                                mod_at = i
                                dname = AST_GetData1(st)
                                nname = AST_GetData1(AST_GetChild(val, 0))
                                dividend = AST_GetChild(val, 0)
                                kval = OptState.bind_val
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(mod_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(nname, pname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(dname, pname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(dname, nname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(kval, 1) ThenBlock: { ReturnValue(0) }
        km1 = Subtract(kval, 1)
        IfCondition EqualTo(BitwiseAnd(kval, km1), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_MagicPrepare(kval), 0) ThenBlock: { ReturnValue(0) }
        mag = OptState.magic_m
        sh = OptState.magic_sh
        IfCondition LessEqual(mag, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(kval), 0) ThenBlock: { ReturnValue(0) }

        div_at = -1
        dec_at = -1
        acc_at = -1
        imm_at = -1
        set_at = -1
        aname = 0
        cname = 0
        bname = 0
        bias = 0
        set_is_dig = 0
        i = 0
        WhileLoop LessThan(i, bcount) {
            IfCondition NotEqual(i, mod_at) ThenBlock: {
                st = AST_GetChild(body, i)
                kind = 0
                IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                    dest = AST_GetData1(st)
                    val = AST_GetChild(st, 0)
                    IfCondition NotEqual(val, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                            IfCondition EqualTo(AST_GetChildCount(val), 2) ThenBlock: {
                                op = AST_GetData1(val)
                                a0 = AST_GetChild(val, 0)
                                a1 = AST_GetChild(val, 1)
                                IfCondition EqualTo(StringCompare(op, "Divide"), 0) ThenBlock: {
                                    IfCondition EqualTo(Optimize_NameEq(dest, nname), 1) ThenBlock: {
                                        IfCondition EqualTo(Optimize_IdentEq(a0, nname), 1) ThenBlock: {
                                            IfCondition EqualTo(CompileArith_KnownDivisor(val, a1), 1) ThenBlock: {
                                                IfCondition EqualTo(OptState.bind_val, kval) ThenBlock: {
                                                    IfCondition GreaterEqual(div_at, 0) ThenBlock: { ReturnValue(0) }
                                                    div_at = i
                                                    kind = 1
                                                }
                                            }
                                        }
                                    }
                                }
                                IfCondition EqualTo(kind, 0) ThenBlock: {
                                    IfCondition EqualTo(StringCompare(op, "Subtract"), 0) ThenBlock: {
                                        IfCondition EqualTo(Optimize_NameEq(dest, pname), 1) ThenBlock: {
                                            IfCondition EqualTo(Optimize_IdentEq(a0, pname), 1) ThenBlock: {
                                                IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                                                    IfCondition EqualTo(StringToNumber(AST_GetData1(a1)), 1) ThenBlock: {
                                                        IfCondition GreaterEqual(dec_at, 0) ThenBlock: { ReturnValue(0) }
                                                        dec_at = i
                                                        kind = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                IfCondition EqualTo(kind, 0) ThenBlock: {
                                    IfCondition EqualTo(StringCompare(op, "Add"), 0) ThenBlock: {
                                        IfCondition EqualTo(Optimize_NameEq(dest, nname), 1) ThenBlock: { ReturnValue(0) }
                                        IfCondition EqualTo(Optimize_NameEq(dest, pname), 1) ThenBlock: { ReturnValue(0) }
                                        IfCondition EqualTo(Optimize_NameEq(dest, dname), 1) ThenBlock: { ReturnValue(0) }
                                        num_side = 0
                                        other = 0
                                        IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                                            num_side = a0
                                            other = a1
                                        }
                                        IfCondition EqualTo(num_side, 0) ThenBlock: {
                                            IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                                                num_side = a1
                                                other = a0
                                            }
                                        }
                                        IfCondition NotEqual(num_side, 0) ThenBlock: {
                                            IfCondition EqualTo(Optimize_IdentEq(other, dname), 0) ThenBlock: { ReturnValue(0) }
                                            bval = StringToNumber(AST_GetData1(num_side))
                                            IfCondition EqualTo(Optimize_Fit32(bval), 0) ThenBlock: { ReturnValue(0) }
                                            IfCondition GreaterEqual(imm_at, 0) ThenBlock: { ReturnValue(0) }
                                            imm_at = i
                                            cname = dest
                                            bias = bval
                                            kind = 1
                                        } ElseBlock: {
                                            left_d = 0
                                            right_d = 0
                                            IfCondition EqualTo(Optimize_IdentEq(a0, dest), 1) ThenBlock: { left_d = 1 }
                                            IfCondition EqualTo(Optimize_IdentEq(a1, dest), 1) ThenBlock: { right_d = 1 }
                                            IfCondition EqualTo(Optimize_IdentEq(a0, dname), 1) ThenBlock: { right_d = Add(right_d, 0) }
                                            dig_side = 0
                                            acc_side = 0
                                            IfCondition EqualTo(Optimize_IdentEq(a0, dname), 1) ThenBlock: {
                                                dig_side = 1
                                                IfCondition EqualTo(Optimize_IdentEq(a1, dest), 1) ThenBlock: { acc_side = 1 }
                                            }
                                            IfCondition EqualTo(Optimize_IdentEq(a1, dname), 1) ThenBlock: {
                                                dig_side = 1
                                                IfCondition EqualTo(Optimize_IdentEq(a0, dest), 1) ThenBlock: { acc_side = 1 }
                                            }
                                            IfCondition EqualTo(dig_side, 0) ThenBlock: { ReturnValue(0) }
                                            IfCondition EqualTo(acc_side, 0) ThenBlock: { ReturnValue(0) }
                                            IfCondition GreaterEqual(acc_at, 0) ThenBlock: { ReturnValue(0) }
                                            acc_at = i
                                            aname = dest
                                            kind = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(kind, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(st), AST.CALL) ThenBlock: {
                        IfCondition EqualTo(StringCompare(AST_GetData1(st), "SetByte"), 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetChildCount(st), 3) ThenBlock: {
                                IfCondition GreaterEqual(set_at, 0) ThenBlock: { ReturnValue(0) }
                                base = AST_GetChild(st, 0)
                                idx = AST_GetChild(st, 1)
                                byt = AST_GetChild(st, 2)
                                IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
                                IfCondition EqualTo(Optimize_IdentEq(idx, pname), 0) ThenBlock: { ReturnValue(0) }
                                bname = AST_GetData1(base)
                                IfCondition EqualTo(Optimize_NameEq(bname, nname), 1) ThenBlock: { ReturnValue(0) }
                                IfCondition EqualTo(Optimize_NameEq(bname, pname), 1) ThenBlock: { ReturnValue(0) }
                                IfCondition EqualTo(Optimize_NameEq(bname, dname), 1) ThenBlock: { ReturnValue(0) }
                                IfCondition EqualTo(Optimize_IdentEq(byt, dname), 1) ThenBlock: { set_is_dig = 1 }
                                set_at = i
                                kind = 1
                            }
                        }
                    }
                }
                IfCondition EqualTo(kind, 0) ThenBlock: { ReturnValue(0) }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(div_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(dec_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(mod_at, div_at) ThenBlock: { ReturnValue(0) }
        mode = 0
        IfCondition GreaterEqual(acc_at, 0) ThenBlock: {
            IfCondition GreaterEqual(set_at, 0) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterEqual(imm_at, 0) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterThan(mod_at, acc_at) ThenBlock: { ReturnValue(0) }
            mode = 1
        }
        IfCondition GreaterEqual(set_at, 0) ThenBlock: {
            IfCondition GreaterThan(mod_at, set_at) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(bname, aname), 1) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(cname, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(bname, cname), 1) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterEqual(imm_at, 0) ThenBlock: {
                IfCondition GreaterThan(imm_at, set_at) ThenBlock: { ReturnValue(0) }
                stv = AST_GetChild(AST_GetChild(body, set_at), 2)
                IfCondition EqualTo(Optimize_IdentEq(stv, cname), 0) ThenBlock: { ReturnValue(0) }
            } ElseBlock: {
                IfCondition EqualTo(set_is_dig, 0) ThenBlock: { ReturnValue(0) }
            }
            mode = 2
        }
        IfCondition EqualTo(mode, 0) ThenBlock: { ReturnValue(0) }
        // The byte store names p. The source must use that index before
        // p = p - 1. Decrementing first is a different loop.
        IfCondition EqualTo(mode, 2) ThenBlock: {
            IfCondition GreaterEqual(set_at, dec_at) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_ProvedNonNeg(dividend), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_LiveOut(dname, body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(cname, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_LiveOut(cname, body), 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(CompileFunc_HasCalls(Compile.current_func), 0) ThenBlock: { ReturnValue(0) }

        hi = -1
        nrhs = CompileArith_LastRhs(node, nname)
        IfCondition NotEqual(nrhs, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(nrhs), AST.NUMBER) ThenBlock: {
                nv = StringToNumber(AST_GetData1(nrhs))
                IfCondition GreaterEqual(nv, 0) ThenBlock: { hi = nv }
            }
            IfCondition EqualTo(AST_GetType(nrhs), AST.IDENTIFIER) ThenBlock: {
                hi = CompileArith_DigitHi(Compile.current_func, AST_GetData1(nrhs), node)
            }
        }
        pknown = 0
        pconst = 0
        prhs = CompileArith_LastRhs(node, pname)
        IfCondition NotEqual(prhs, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(prhs), AST.NUMBER) ThenBlock: {
                pknown = 1
                pconst = StringToNumber(AST_GetData1(prhs))
            }
        }
        use_last = 0
        steps = 0
        IfCondition EqualTo(pknown, 1) ThenBlock: {
            IfCondition GreaterThan(pconst, 0) ThenBlock: {
                IfCondition GreaterEqual(hi, 0) ThenBlock: {
                    dcount = CompileArith_DigitCount(hi, kval, pconst)
                    IfCondition LessEqual(dcount, pconst) ThenBlock: {
                        IfCondition GreaterEqual(dcount, 1) ThenBlock: {
                            use_last = 1
                            steps = Subtract(dcount, 1)
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(CompileArith_FrameSlot(nname), 0) ThenBlock: { ReturnValue(0) }
        noff = LoopHome.imm_val
        IfCondition EqualTo(CompileArith_FrameSlot(pname), 0) ThenBlock: { ReturnValue(0) }
        poff = LoopHome.imm_val
        roff = 0
        IfCondition EqualTo(mode, 1) ThenBlock: {
            IfCondition EqualTo(CompileArith_FrameSlot(aname), 0) ThenBlock: { ReturnValue(0) }
            roff = LoopHome.imm_val
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            IfCondition EqualTo(CompileArith_FrameSlot(bname), 0) ThenBlock: { ReturnValue(0) }
            roff = LoopHome.imm_val
        }

        // Written only after every check. The caller copies these locals
        // out before it calls anything else, then clears the pool.
        LoopHome.int_name = nname
        LoopHome.acc_name = aname
        LoopHome.flt_name = bname
        LoopHome.assign_name = dname
        LoopHome.hold_name = cname
        LoopHome.lim_name = pname
        LoopHome.int_off = noff
        LoopHome.acc_off = poff
        LoopHome.flt_off = roff
        LoopHome.iv_step = steps
        LoopHome.iv_at = pconst
        LoopHome.iv_hi = use_last
        LoopHome.iv_lo = bias
        LoopHome.iv_nn = pknown
        OptState.bind_val = kval
        OptState.magic_m = mag
        OptState.magic_sh = sh
        ReturnValue(mode)
    }
}

// Emit the countdown. A constant trip of at most 16 is straight-line.
// A longer or variable counter keeps one register loop. r13 and r14 are
// pushed around this loop only.
Function.CompileArith_TryDigitLoop {
    Input: node: Address
    Output: Integer
    Body: {
        mode = CompileArith_DigitPrep(node)
        IfCondition EqualTo(mode, 0) ThenBlock: { ReturnValue(0) }
        nname = LoopHome.int_name
        aname = LoopHome.acc_name
        bname = LoopHome.flt_name
        dname = LoopHome.assign_name
        cname = LoopHome.hold_name
        pname = LoopHome.lim_name
        noff = LoopHome.int_off
        poff = LoopHome.acc_off
        roff = LoopHome.flt_off
        steps = LoopHome.iv_step
        pconst = LoopHome.iv_at
        use_last = LoopHome.iv_hi
        bias = LoopHome.iv_lo
        pknown = LoopHome.iv_nn
        kval = OptState.bind_val
        mag = OptState.magic_m
        sh = OptState.magic_sh
        CompileArith_DigitClear()

        Optimize_IholdFlush()
        Optimize_FlushHold()
        Optimize_RaxDrop()
        IfCondition EqualTo(Compile.error, 1) ThenBlock: { ReturnValue(1) }

        Emit_PushR13()
        Emit_PushR14()
        Emit_MovRaxRbpOffset(noff)
        Emit_MovR12Rax()
        Emit_MovRaxRbpOffset(roff)
        Emit_MovR14Rax()
        X86_MovRbxImm64(mag)

        flat = CompileArith_DigitFlat(mode, use_last, steps, pknown, pconst)
        IfCondition EqualTo(flat, 1) ThenBlock: {
            IfCondition EqualTo(mode, 2) ThenBlock: {
                X86_MovR13Imm64(pconst)
            }
            dctrl = CompileArith_DigitCtrl(1, mode, use_last, steps, pconst, 0)
            CompileArith_DigitStraight(dctrl, kval, sh, bias)
            IfCondition EqualTo(mode, 1) ThenBlock: {
                Emit_XorRegReg(Reg.R13, Reg.R13)
            }
        } ElseBlock: {
            IfCondition EqualTo(mode, 1) ThenBlock: {
                IfCondition EqualTo(use_last, 1) ThenBlock: {
                    X86_MovR13Imm64(steps)
                    top = Compile_NewLabel()
                    after = Compile_NewLabel()
                    Emit_MarkLabel(top)
                    Emit_TestR13R13()
                    Emit_Jle(after)
                    CompileArith_DigitStep(kval, sh)
                    CompileArith_DigitAcc(0)
                    X86_AddR13Imm32(-1)
                    Emit_Jmp(top)
                    Emit_MarkLabel(after)
                    CompileArith_DigitAcc(1)
                    Emit_XorRaxRax()
                    Emit_MovR12Rax()
                } ElseBlock: {
                    IfCondition EqualTo(pknown, 1) ThenBlock: {
                        X86_MovR13Imm64(pconst)
                    } ElseBlock: {
                        Emit_MovRaxRbpOffset(poff)
                        Emit_MovR13Rax()
                    }
                    top2 = Compile_NewLabel()
                    after2 = Compile_NewLabel()
                    Emit_MarkLabel(top2)
                    Emit_TestR13R13()
                    Emit_Jle(after2)
                    CompileArith_DigitStep(kval, sh)
                    CompileArith_DigitAcc(0)
                    X86_AddR13Imm32(-1)
                    Emit_Jmp(top2)
                    Emit_MarkLabel(after2)
                }
            }
            IfCondition EqualTo(mode, 2) ThenBlock: {
                IfCondition EqualTo(use_last, 1) ThenBlock: {
                    X86_MovR13Imm64(pconst)
                    quot = Compile_NewLabel()
                    IfCondition GreaterThan(steps, 0) ThenBlock: {
                        endm = Subtract(pconst, steps)
                        mag_top = Compile_NewLabel()
                        Emit_MarkLabel(mag_top)
                        Emit_HomeMove(15, endm)
                        Emit_Jle(quot)
                        CompileArith_DigitStep(kval, sh)
                        CompileArith_DigitByte(0, bias)
                        Emit_Jmp(mag_top)
                    }
                    Emit_MarkLabel(quot)
                    CompileArith_DigitByte(1, bias)
                    Emit_XorRaxRax()
                    Emit_MovR12Rax()
                    ztop = Compile_NewLabel()
                    zend = Compile_NewLabel()
                    Emit_MarkLabel(ztop)
                    Emit_TestR13R13()
                    Emit_Jle(zend)
                    CompileArith_DigitByte(2, bias)
                    Emit_Jmp(ztop)
                    Emit_MarkLabel(zend)
                } ElseBlock: {
                    IfCondition EqualTo(pknown, 1) ThenBlock: {
                        X86_MovR13Imm64(pconst)
                    } ElseBlock: {
                        Emit_MovRaxRbpOffset(poff)
                        Emit_MovR13Rax()
                    }
                    top3 = Compile_NewLabel()
                    after3 = Compile_NewLabel()
                    Emit_MarkLabel(top3)
                    Emit_TestR13R13()
                    Emit_Jle(after3)
                    CompileArith_DigitStep(kval, sh)
                    CompileArith_DigitByte(0, bias)
                    Emit_Jmp(top3)
                    Emit_MarkLabel(after3)
                }
            }
        }

        Emit_MovRaxR12()
        Emit_MovRbpOffsetRax(noff)
        Emit_MovRaxR13()
        Emit_MovRbpOffsetRax(poff)
        IfCondition EqualTo(mode, 1) ThenBlock: {
            Emit_MovRaxR14()
            Emit_MovRbpOffsetRax(roff)
        }
        Optimize_RaxDrop()
        Optimize_PtrClear(nname)
        Optimize_XmmDrop(nname)
        Optimize_CoalDrop(nname)
        Optimize_AliasClear(nname)
        Optimize_PtrClear(pname)
        Optimize_AliasClear(pname)
        Optimize_PtrClear(dname)
        Optimize_AliasClear(dname)
        IfCondition EqualTo(mode, 1) ThenBlock: {
            Optimize_PtrClear(aname)
            Optimize_XmmDrop(aname)
            Optimize_CoalDrop(aname)
            Optimize_AliasClear(aname)
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            Optimize_PtrClear(bname)
            Optimize_AliasClear(bname)
        }
        IfCondition NotEqual(cname, 0) ThenBlock: {
            Optimize_PtrClear(cname)
            Optimize_AliasClear(cname)
        }
        LoopHome.rdx_on = 0
        LoopHome.rdx_name = 0
        Emit_PopR14()
        Emit_PopR13()
        bcount = AST_GetChildCount(AST_GetChild(node, 1))
        Compile.nodes_compiled = Add(Compile.nodes_compiled, bcount)
        ReturnValue(1)
    }
}

// buf = Add(base, iv * stride), either addend order. Stride, or -1.
// On success the base name is in LoopHome.hold_name. Copy it at once.
Function.CompileArith_BufStride {
    Input: st: Address
    Input: ivname: Address
    Input: bname: Address
    Output: Integer
    Body: {
        LoopHome.hold_name = 0
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), bname), 0) ThenBlock: { ReturnValue(-1) }
        val = AST_GetChild(st, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(-1) }
        a0 = AST_GetChild(val, 0)
        a1 = AST_GetChild(val, 1)
        base = 0
        mul = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            base = a0
            mul = a1
        }
        IfCondition EqualTo(base, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                base = a1
                mul = a0
            }
        }
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(-1) }
        bnm = AST_GetData1(base)
        IfCondition EqualTo(Optimize_NameEq(bnm, ivname), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_NameEq(bnm, bname), 1) ThenBlock: { ReturnValue(-1) }
        stride = CompileArith_MulStride(mul, ivname)
        IfCondition LessThan(stride, 0) ThenBlock: { ReturnValue(-1) }
        LoopHome.hold_name = bnm
        ReturnValue(stride)
    }
}

// i = init; while i < limit { num = i; p = CONST; [buf = base + i*stride;
// constant SetByte]; digit while; i = i + 1 }. Magic is loaded once.
// i stays in r13 and the sum stays in r14 for the whole counted loop.
// A byte buffer stays in r14 and advances by the stride. The digit trip
// is straight-line. Variable p, a trip past 16, or any other statement
// leaves the loop to the normal compiler.
Function.CompileArith_TryDigitNest {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        cond = AST_GetChild(node, 0)
        body = AST_GetChild(node, 1)
        ivnode = CompileArith_ReadCursor(cond)
        IfCondition EqualTo(ivnode, 0) ThenBlock: { ReturnValue(0) }
        ivname = AST_GetData1(ivnode)
        limit = CompileArith_ReadBound(cond, ivname)
        IfCondition LessThan(limit, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(limit), 0) ThenBlock: { ReturnValue(0) }
        irhs = CompileArith_LastRhs(node, ivname)
        IfCondition EqualTo(irhs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(irhs), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        init = StringToNumber(AST_GetData1(irhs))
        IfCondition LessThan(init, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(init, limit) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_NnIncTally(body, ivname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_LiveEscape(Compile.current_func, ivname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FrameOff(ivname), 0) ThenBlock: { ReturnValue(0) }
        ivoff = LoopHome.imm_val
        bty = AST_GetType(body)
        is_block = 0
        IfCondition EqualTo(bty, AST.BLOCK) ThenBlock: { is_block = 1 }
        IfCondition EqualTo(bty, AST.BODY) ThenBlock: { is_block = 1 }
        IfCondition EqualTo(is_block, 0) ThenBlock: { ReturnValue(0) }
        bcount = AST_GetChildCount(body)
        IfCondition LessThan(bcount, 2) ThenBlock: { ReturnValue(0) }
        while_at = -1
        i = 0
        WhileLoop LessThan(i, bcount) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(AST_GetType(st), AST.WHILE) ThenBlock: {
                IfCondition GreaterEqual(while_at, 0) ThenBlock: { ReturnValue(0) }
                while_at = i
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(while_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(while_at, Subtract(bcount, 1)) ThenBlock: { ReturnValue(0) }
        inner = AST_GetChild(body, while_at)
        mode = CompileArith_DigitPrep(inner)
        IfCondition EqualTo(mode, 0) ThenBlock: { ReturnValue(0) }
        nname = LoopHome.int_name
        aname = LoopHome.acc_name
        bname = LoopHome.flt_name
        dname = LoopHome.assign_name
        cname = LoopHome.hold_name
        pname = LoopHome.lim_name
        noff = LoopHome.int_off
        poff = LoopHome.acc_off
        roff = LoopHome.flt_off
        steps = LoopHome.iv_step
        pconst = LoopHome.iv_at
        use_last = LoopHome.iv_hi
        bias = LoopHome.iv_lo
        pknown = LoopHome.iv_nn
        kval = OptState.bind_val
        mag = OptState.magic_m
        sh = OptState.magic_sh
        CompileArith_DigitClear()

        flat = CompileArith_DigitFlat(mode, use_last, steps, pknown, pconst)
        IfCondition EqualTo(flat, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(nname, ivname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(pname, ivname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(aname, ivname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(bname, ivname), 1) ThenBlock: { ReturnValue(0) }

        seen_num = 0
        seen_p = 0
        seen_inc = 0
        seen_buf = 0
        stride = 0
        sname = 0
        baseoff = 0
        pre_n = 0
        post_n = 0
        pre0d = 0
        pre0v = 0
        pre1d = 0
        pre1v = 0
        pre2d = 0
        pre2v = 0
        pre3d = 0
        pre3v = 0
        post0d = 0
        post0v = 0
        post1d = 0
        post1v = 0
        post2d = 0
        post2v = 0
        post3d = 0
        post3v = 0
        last = Subtract(bcount, 1)
        i = 0
        WhileLoop LessThan(i, bcount) {
            matched = 0
            st = AST_GetChild(body, i)
            IfCondition EqualTo(i, while_at) ThenBlock: { matched = 1 }
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(CompileArith_IsInc1(st, ivname), 1) ThenBlock: {
                    IfCondition NotEqual(i, last) ThenBlock: { ReturnValue(0) }
                    seen_inc = 1
                    matched = 1
                }
            }
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), nname), 1) ThenBlock: {
                        IfCondition GreaterEqual(i, while_at) ThenBlock: { ReturnValue(0) }
                        rhs = AST_GetChild(st, 0)
                        IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(0) }
                        IfCondition NotEqual(AST_GetType(rhs), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(rhs), ivname), 0) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(seen_num, 1) ThenBlock: { ReturnValue(0) }
                        seen_num = 1
                        matched = 1
                    }
                }
            }
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), pname), 1) ThenBlock: {
                        IfCondition GreaterEqual(i, while_at) ThenBlock: { ReturnValue(0) }
                        rhs = AST_GetChild(st, 0)
                        IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(0) }
                        IfCondition NotEqual(AST_GetType(rhs), AST.NUMBER) ThenBlock: { ReturnValue(0) }
                        IfCondition NotEqual(StringToNumber(AST_GetData1(rhs)), pconst) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(seen_p, 1) ThenBlock: { ReturnValue(0) }
                        seen_p = 1
                        matched = 1
                    }
                }
            }
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(mode, 2) ThenBlock: {
                    IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), bname), 1) ThenBlock: {
                            IfCondition GreaterEqual(i, while_at) ThenBlock: { ReturnValue(0) }
                            IfCondition EqualTo(seen_buf, 1) ThenBlock: { ReturnValue(0) }
                            got = CompileArith_BufStride(st, ivname, bname)
                            sname = LoopHome.hold_name
                            LoopHome.hold_name = 0
                            IfCondition LessThan(got, 0) ThenBlock: { ReturnValue(0) }
                            stride = got
                            seen_buf = 1
                            matched = 1
                        }
                    }
                }
            }
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(mode, 2) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(st), AST.CALL) ThenBlock: {
                        IfCondition EqualTo(StringCompare(AST_GetData1(st), "SetByte"), 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetChildCount(st), 3) ThenBlock: {
                                sb = AST_GetChild(st, 0)
                                si = AST_GetChild(st, 1)
                                sv = AST_GetChild(st, 2)
                                IfCondition EqualTo(sb, 0) ThenBlock: { ReturnValue(0) }
                                IfCondition NotEqual(AST_GetType(sb), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
                                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sb), bname), 0) ThenBlock: { ReturnValue(0) }
                                IfCondition NotEqual(AST_GetType(si), AST.NUMBER) ThenBlock: { ReturnValue(0) }
                                IfCondition NotEqual(AST_GetType(sv), AST.NUMBER) ThenBlock: { ReturnValue(0) }
                                disp = StringToNumber(AST_GetData1(si))
                                immv = StringToNumber(AST_GetData1(sv))
                                IfCondition LessThan(disp, 0) ThenBlock: { ReturnValue(0) }
                                IfCondition EqualTo(Optimize_Fit32(disp), 0) ThenBlock: { ReturnValue(0) }
                                IfCondition EqualTo(Optimize_Fit32(immv), 0) ThenBlock: { ReturnValue(0) }
                                IfCondition LessThan(i, while_at) ThenBlock: {
                                    IfCondition EqualTo(pre_n, 0) ThenBlock: { pre0d = disp
                                        pre0v = immv
                                    }
                                    IfCondition EqualTo(pre_n, 1) ThenBlock: { pre1d = disp
                                        pre1v = immv
                                    }
                                    IfCondition EqualTo(pre_n, 2) ThenBlock: { pre2d = disp
                                        pre2v = immv
                                    }
                                    IfCondition EqualTo(pre_n, 3) ThenBlock: { pre3d = disp
                                        pre3v = immv
                                    }
                                    pre_n = Add(pre_n, 1)
                                    IfCondition GreaterThan(pre_n, 4) ThenBlock: { ReturnValue(0) }
                                } ElseBlock: {
                                    IfCondition EqualTo(post_n, 0) ThenBlock: { post0d = disp
                                        post0v = immv
                                    }
                                    IfCondition EqualTo(post_n, 1) ThenBlock: { post1d = disp
                                        post1v = immv
                                    }
                                    IfCondition EqualTo(post_n, 2) ThenBlock: { post2d = disp
                                        post2v = immv
                                    }
                                    IfCondition EqualTo(post_n, 3) ThenBlock: { post3d = disp
                                        post3v = immv
                                    }
                                    post_n = Add(post_n, 1)
                                    IfCondition GreaterThan(post_n, 4) ThenBlock: { ReturnValue(0) }
                                }
                                matched = 1
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(matched, 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        IfCondition EqualTo(seen_num, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(seen_p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(seen_inc, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            IfCondition EqualTo(seen_buf, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_LiveOut(bname, body), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(sname, nname), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(sname, pname), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(sname, ivname), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_FrameOff(sname), 0) ThenBlock: { ReturnValue(0) }
            baseoff = LoopHome.imm_val
        }
        span = 0
        IfCondition EqualTo(mode, 2) ThenBlock: {
            IfCondition GreaterThan(init, 0) ThenBlock: {
                room = Divide(2147483647, init)
                IfCondition GreaterThan(stride, room) ThenBlock: { ReturnValue(0) }
                span = Multiply(init, stride)
                IfCondition EqualTo(Optimize_Fit32(span), 0) ThenBlock: { ReturnValue(0) }
            }
        }
        CompileArith_DigitClear()

        Optimize_IholdFlush()
        Optimize_FlushHold()
        Optimize_RaxDrop()
        IfCondition EqualTo(Compile.error, 1) ThenBlock: { ReturnValue(1) }

        Emit_PushR13()
        Emit_PushR14()
        X86_MovRbxImm64(mag)
        Emit_MovRaxRbpOffset(ivoff)
        Emit_MovR13Rax()
        IfCondition EqualTo(mode, 1) ThenBlock: {
            Emit_MovRaxRbpOffset(roff)
            Emit_MovR14Rax()
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            Emit_MovRaxRbpOffset(baseoff)
            Emit_MovR14Rax()
            IfCondition GreaterThan(span, 0) ThenBlock: {
                X86_AddR14Imm32(span)
            }
        }
        top = Compile_NewLabel()
        done = Compile_NewLabel()
        Emit_MarkLabel(top)
        Emit_HomeMove(15, limit)
        Emit_Jge(done)
        IfCondition GreaterThan(pre_n, 0) ThenBlock: { CompileArith_ByteImm(pre0d, pre0v) }
        IfCondition GreaterThan(pre_n, 1) ThenBlock: { CompileArith_ByteImm(pre1d, pre1v) }
        IfCondition GreaterThan(pre_n, 2) ThenBlock: { CompileArith_ByteImm(pre2d, pre2v) }
        IfCondition GreaterThan(pre_n, 3) ThenBlock: { CompileArith_ByteImm(pre3d, pre3v) }
        dflags = 0
        IfCondition EqualTo(use_last, 1) ThenBlock: {
            dflags = 1
        }
        has_issue = steps
        IfCondition EqualTo(use_last, 0) ThenBlock: {
            has_issue = pconst
        }
        IfCondition GreaterThan(has_issue, 0) ThenBlock: {
            dflags = Add(dflags, 6)
        }
        IfCondition EqualTo(has_issue, 0) ThenBlock: {
            Emit_MovRegReg(Reg.R12, Reg.R13)
        }
        dctrl = CompileArith_DigitCtrl(0, mode, use_last, steps, pconst, dflags)
        CompileArith_DigitStraight(dctrl, kval, sh, bias)
        IfCondition GreaterThan(post_n, 0) ThenBlock: { CompileArith_ByteImm(post0d, post0v) }
        IfCondition GreaterThan(post_n, 1) ThenBlock: { CompileArith_ByteImm(post1d, post1v) }
        IfCondition GreaterThan(post_n, 2) ThenBlock: { CompileArith_ByteImm(post2d, post2v) }
        IfCondition GreaterThan(post_n, 3) ThenBlock: { CompileArith_ByteImm(post3d, post3v) }
        IfCondition EqualTo(has_issue, 0) ThenBlock: {
            X86_IncR13()
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            X86_AddR14Imm32(stride)
        }
        Emit_Jmp(top)
        Emit_MarkLabel(done)
        IfCondition EqualTo(use_last, 1) ThenBlock: {
            Emit_XorRaxRax()
        } ElseBlock: {
            Emit_MovRaxR12()
        }
        Emit_MovRbpOffsetRax(noff)
        IfCondition EqualTo(mode, 1) ThenBlock: {
            Emit_MovRaxR14()
            Emit_MovRbpOffsetRax(roff)
        }
        Emit_MovRaxR13()
        Emit_MovRbpOffsetRax(ivoff)
        Emit_XorRaxRax()
        Emit_MovRbpOffsetRax(poff)
        Optimize_RaxDrop()
        Optimize_PtrClear(nname)
        Optimize_XmmDrop(nname)
        Optimize_CoalDrop(nname)
        Optimize_AliasClear(nname)
        Optimize_PtrClear(pname)
        Optimize_AliasClear(pname)
        Optimize_PtrClear(dname)
        Optimize_AliasClear(dname)
        Optimize_PtrClear(ivname)
        Optimize_XmmDrop(ivname)
        Optimize_CoalDrop(ivname)
        Optimize_AliasClear(ivname)
        IfCondition EqualTo(mode, 1) ThenBlock: {
            Optimize_PtrClear(aname)
            Optimize_XmmDrop(aname)
            Optimize_CoalDrop(aname)
            Optimize_AliasClear(aname)
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            Optimize_PtrClear(bname)
            Optimize_AliasClear(bname)
            Optimize_PtrClear(sname)
            Optimize_AliasClear(sname)
        }
        IfCondition NotEqual(cname, 0) ThenBlock: {
            Optimize_PtrClear(cname)
            Optimize_AliasClear(cname)
        }
        LoopHome.rdx_on = 0
        LoopHome.rdx_name = 0
        Emit_PopR14()
        Emit_PopR13()
        ibc = AST_GetChildCount(AST_GetChild(inner, 1))
        Compile.nodes_compiled = Add(Compile.nodes_compiled, Add(bcount, ibc))
        ReturnValue(1)
    }
}

// =============================================================================
// DIVIDE(a, b) → a / b  (FIXED: preserves RDX)
// =============================================================================
Function.CompileArith_Divide {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            Compile_Error("Divide requires 2 arguments", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        // Divide by a positive power of two. SAR alone rounds toward
        // -infinity, and signed Divide rounds toward zero, so a negative
        // dividend adds (2^k - 1) first. A non-negative dividend adds 0.
        // RDX stays live. RCX and RBX are scratch, as on the IDIV path.
        // Other resolved constants use a magic multiply.
        known = CompileArith_KnownDivisor(node, arg1)
        val = OptState.bind_val
        IfCondition EqualTo(known, 1) ThenBlock: {
            IfCondition GreaterThan(val, 0) ThenBlock: {
                val_minus_1 = Subtract(val, 1)
                check = BitwiseAnd(val, val_minus_1)
                IfCondition EqualTo(check, 0) ThenBlock: {
                    shift = 0
                    tmp = val
                    WhileLoop GreaterThan(tmp, 1) {
                        tmp = Divide(tmp, 2)
                        shift = Add(shift, 1)
                    }
                    result = Compile_Expression(arg0)
                    IfCondition EqualTo(result, 0) ThenBlock: {
                        ReturnValue(0)
                    }
                    IfCondition EqualTo(shift, 0) ThenBlock: {
                        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                        ReturnValue(1)
                    }
                    // Same rule as Optimize_EmitOperation. Checked after the
                    // dividend is in RAX and before any bias bytes.
                    IfCondition EqualTo(Optimize_SarSafe(arg0, shift), 1) ThenBlock: {
                        Emit_SarRaxImm8(shift)
                        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                        ReturnValue(1)
                    }
                    Emit_PushRax()
                    Emit_ShrRaxImm8(63)
                    IfCondition EqualTo(shift, 1) ThenBlock: {
                        Emit_MovRegReg(Reg.RCX, Reg.RAX)
                        Emit_PopRax()
                        Emit_AddRaxRcx()
                    } ElseBlock: {
                        Emit_MovRegReg(Reg.RBX, Reg.RAX)
                        Emit_MovRegReg(Reg.RCX, Reg.RAX)
                        Emit_ShlRcxImm8(shift)
                        Emit_MovRegReg(Reg.RAX, Reg.RCX)
                        Emit_SubRaxRbx()
                        Emit_MovRegReg(Reg.RCX, Reg.RAX)
                        Emit_PopRax()
                        Emit_AddRaxRcx()
                    }
                    Emit_SarRaxImm8(shift)
                    Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_MagicPrepare(val), 1) ThenBlock: {
                saved_m = OptState.magic_m
                saved_sh = OptState.magic_sh
                saved_neg = OptState.magic_neg
                nn = 0
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    nn = Optimize_ProvedNonNeg(arg0)
                }
                result = Compile_Expression(arg0)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                OptState.magic_m = saved_m
                OptState.magic_sh = saved_sh
                OptState.magic_neg = saved_neg
                CompileArith_MagicFinish(val, 0, 1, nn, 0)
                Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                ReturnValue(1)
            }
        }
        
        // Compile dividend (a) -> RAX
        result = Compile_Expression(arg0)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        Emit_PushRax()
        
        // Compile divisor (b) -> RAX, then move to RBX
        result = Compile_Expression(arg1)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        Emit_MovRegReg(Reg.RBX, Reg.RAX)
        Emit_PopRax()
        
        // === FIX: Save RDX before CQO/IDIV clobbers it ===
        Emit_PushRdx()
        
        // Sign extend RAX into RDX:RAX, then divide
        Emit_Cqo()
        Emit_IdivRbx()
        
        // Quotient is in RAX - save it temporarily
        Emit_MovRegReg(Reg.RCX, Reg.RAX)  // Save quotient to RCX
        Emit_PopRdx()                       // Restore original RDX
        Emit_MovRegReg(Reg.RAX, Reg.RCX)  // Put quotient back in RAX
        // === END FIX ===
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// MODULO(a, b) → a % b (remainder)  (FIXED: preserves RDX)
// =============================================================================


Function.CompileArith_Modulo {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            Compile_Error("Modulo requires 2 arguments", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // === OPTIMIZATION: Modulo by power of 2 → AND ===
        // Modulo(x, 2) → AND x, 1
        // Modulo(x, 4) → AND x, 3
        // Modulo(x, 8) → AND x, 7
        // etc.
        known = CompileArith_KnownDivisor(node, arg1)
        val = OptState.bind_val
        IfCondition EqualTo(known, 1) ThenBlock: {
            // Check if val is power of 2: val > 0 AND (val & (val-1)) == 0
            IfCondition GreaterThan(val, 0) ThenBlock: {
                val_minus_1 = Subtract(val, 1)
                check = BitwiseAnd(val, val_minus_1)
                IfCondition EqualTo(check, 0) ThenBlock: {
                    // AND is correct only for a proved non-negative dividend
                    // whose mask fits a sign-extended imm32.
                    saved_lo = LoopHome.range_lo
                    saved_hi = LoopHome.range_hi
                    proved = Optimize_NonNeg(arg0)
                    LoopHome.range_lo = saved_lo
                    LoopHome.range_hi = saved_hi
                    IfCondition EqualTo(proved, 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_Fit32(val_minus_1), 1) ThenBlock: {
                            result = Compile_Expression(arg0)
                            IfCondition EqualTo(result, 0) ThenBlock: {
                                ReturnValue(0)
                            }
                            Emit_AndRaxImm32(val_minus_1)
                            Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                            ReturnValue(1)
                        }
                    }
                }
            }
            IfCondition EqualTo(Optimize_MagicPrepare(val), 1) ThenBlock: {
                saved_m = OptState.magic_m
                saved_sh = OptState.magic_sh
                saved_neg = OptState.magic_neg
                nn = 0
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    nn = Optimize_ProvedNonNeg(arg0)
                }
                result = Compile_Expression(arg0)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                OptState.magic_m = saved_m
                OptState.magic_sh = saved_sh
                OptState.magic_neg = saved_neg
                CompileArith_MagicFinish(val, 1, 1, nn, 0)
                Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
                ReturnValue(1)
            }
        }
        // === END OPTIMIZATION ===
        
        // Standard path: full IDIV
        result = Compile_Expression(arg0)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        Emit_PushRax()
        
        result = Compile_Expression(arg1)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        Emit_MovRegReg(Reg.RBX, Reg.RAX)
        Emit_PopRax()
        
        Emit_PushRdx()
        
        Emit_Cqo()
        Emit_IdivRbx()
        
        Emit_MovRegReg(Reg.RCX, Reg.RDX)
        Emit_PopRdx()
        Emit_MovRegReg(Reg.RAX, Reg.RCX)
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}


// =============================================================================
// NEGATE(a) → -a
// =============================================================================
Function.CompileArith_Negate {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("Negate requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        result = Compile_Expression(arg0)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        Emit_NegRax()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

