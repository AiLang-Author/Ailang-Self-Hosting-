// Library.CCompileAtomic.ailang
// Atomic operations — compiler module
// Follows the same pattern as CCompileArith, CCompileMem, etc.

LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.CCompileMain

// =============================================================================
// DISPATCHER
// =============================================================================
Function.CompileAtomic_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        func_name = AST_GetData1(node)

        cmp = StringCompare(func_name, "AtomicCompareSwap")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileAtomic_CAS(node))
        }

        cmp = StringCompare(func_name, "AtomicAdd")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileAtomic_Add(node))
        }

        cmp = StringCompare(func_name, "AtomicExchange")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileAtomic_Exchange(node))
        }

        cmp = StringCompare(func_name, "AtomicRead")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileAtomic_Read(node))
        }

        cmp = StringCompare(func_name, "AtomicWrite")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileAtomic_Write(node))
        }

        cmp = StringCompare(func_name, "CompilerFence")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileAtomic_Fence(node))
        }

        ReturnValue(0)
    }
}

// =============================================================================
// AtomicCompareSwap(addr, expected, desired) → old value
//
// Code generated:
//   compile addr     → push
//   compile expected → push
//   compile desired  → RSI
//   pop RAX          (expected — CMPXCHG uses RAX implicitly)
//   pop RDI          (addr)
//   LOCK CMPXCHG [RDI], RSI
//   result in RAX    (old value, whether swap happened or not)
// =============================================================================
Function.CompileAtomic_CAS {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            Compile_Error("AtomicCompareSwap requires 3 args (addr, expected, desired)", AST_GetLine(node))
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)   // addr
        arg1 = AST_GetChild(node, 1)   // expected
        arg2 = AST_GetChild(node, 2)   // desired

        // Compile addr, save
        Compile_Expression(arg0)
        Emit_PushRax()

        // Compile expected, save
        Compile_Expression(arg1)
        Emit_PushRax()

        // Compile desired → RSI
        Compile_Expression(arg2)
        Emit_MovRsiRax()

        // Pop expected → RAX (CMPXCHG compares [RDI] against RAX)
        Emit_PopRax()

        // Pop addr → RDI
        Emit_PopRdi()

        // LOCK CMPXCHG [RDI], RSI
        // If [RDI]==RAX: [RDI]=RSI, ZF=1, RAX unchanged
        // If [RDI]!=RAX: RAX=[RDI], ZF=0
        // Either way, RAX = old value at [RDI]
        Emit_LockCmpxchgDerefRdiRsi()

        // Result already in RAX
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// AtomicAdd(addr, value) → old value
//
// Code generated:
//   compile addr  → push
//   compile value → RSI
//   pop RDI       (addr)
//   LOCK XADD [RDI], RSI
//   MOV RAX, RSI  (old value is in RSI after XADD)
// =============================================================================
Function.CompileAtomic_Add {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            Compile_Error("AtomicAdd requires 2 args (addr, value)", AST_GetLine(node))
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        Compile_Expression(arg0)
        Emit_PushRax()

        Compile_Expression(arg1)
        Emit_MovRsiRax()

        Emit_PopRdi()

        // LOCK XADD [RDI], RSI
        // Old [RDI] goes into RSI, [RDI] gets old+RSI
        Emit_LockXaddDerefRdiRsi()

        // Move old value from RSI to RAX for return
        Emit_MovRaxRsi()

        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// AtomicExchange(addr, value) → old value
//
// Code generated:
//   compile addr  → push
//   compile value → RSI
//   pop RDI
//   XCHG [RDI], RSI   (implicit LOCK for memory operand)
//   MOV RAX, RSI       (old value)
// =============================================================================
Function.CompileAtomic_Exchange {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            Compile_Error("AtomicExchange requires 2 args (addr, value)", AST_GetLine(node))
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        Compile_Expression(arg0)
        Emit_PushRax()

        Compile_Expression(arg1)
        Emit_MovRsiRax()

        Emit_PopRdi()

        Emit_XchgDerefRdiRsi()

        // Old value now in RSI
        Emit_MovRaxRsi()

        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// AtomicRead(addr) → value
// x86-64 guarantees atomic aligned 8-byte MOV, but we add a
// compiler fence to prevent reordering.
//
// Code generated:
//   compile addr → RAX
//   MOV RAX, [RAX]
//   (no MFENCE needed — x86 MOV has acquire semantics for loads)
// =============================================================================
Function.CompileAtomic_Read {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("AtomicRead requires 1 arg (addr)", AST_GetLine(node))
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        Compile_Expression(arg0)

        // MOV RAX, [RAX] — naturally atomic on x86 for aligned 8-byte
        Emit_MovRaxDerefRax()

        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// AtomicWrite(addr, value)
// Naturally atomic on x86 for aligned 8-byte, but we want release semantics.
//
// Code generated:
//   compile addr  → push
//   compile value → RAX
//   pop RDI
//   MOV [RDI], RAX
//   (MFENCE for store-release if needed by protocol)
// =============================================================================
Function.CompileAtomic_Write {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            Compile_Error("AtomicWrite requires 2 args (addr, value)", AST_GetLine(node))
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        Compile_Expression(arg0)
        Emit_PushRax()

        Compile_Expression(arg1)
        // RAX = value

        Emit_PopRdi()

        // MOV [RDI], RAX
        Emit_MovDerefRdiRax()

        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// CompilerFence() — full memory barrier
// =============================================================================
Function.CompileAtomic_Fence {
    Input: node: Address
    Output: Integer
    Body: {
        Emit_Mfence()
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}