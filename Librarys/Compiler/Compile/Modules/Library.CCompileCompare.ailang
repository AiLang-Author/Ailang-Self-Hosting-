// =============================================================================
// DISPATCHER
// =============================================================================
Function.CompileCompare_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        func_name = AST_GetData1(node)
        IfCondition EqualTo(func_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        cmp = StringCompare(func_name, "EqualTo")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileCompare_EqualTo(node))
        }
        
        cmp = StringCompare(func_name, "NotEqual")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileCompare_NotEqual(node))
        }
        
        cmp = StringCompare(func_name, "LessThan")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileCompare_LessThan(node))
        }
        
        cmp = StringCompare(func_name, "GreaterThan")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileCompare_GreaterThan(node))
        }
        
        cmp = StringCompare(func_name, "LessEqual")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileCompare_LessEqual(node))
        }
        
        cmp = StringCompare(func_name, "GreaterEqual")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileCompare_GreaterEqual(node))
        }
        
        // Not a comparison operation
        ReturnValue(0)
    }
}

// =============================================================================
// HELPER: Compile binary comparison
// Pattern: compile args, CMP, SETcc, MOVZX
// =============================================================================
// Offset of a FixedPool field in the r15 block, or -1. -1 also when an
// optimizer keeps that field in a register (loop home, derived or held
// value, alias, scan home): the memory copy may be stale then.
Function.CompileCompare_PoolOff {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(-1) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        off = Scope_Resolve(name)
        IfCondition NotEqual(Scope.resolve_type, 3) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_Loc(name), 1) ThenBlock: { ReturnValue(-1) }
        }
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: { ReturnValue(-1) }
        }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.hold_name), 1) ThenBlock: { ReturnValue(-1) }
        }
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_ScanHomed(name), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: { ReturnValue(-1) }
        // Re-resolve: the checks above may resolve other names.
        off = Scope_Resolve(name)
        CompileExpr_AssertDotted(name, Multiply(BitwiseAnd(off, 2147483647), 8))
        ReturnValue(Multiply(BitwiseAnd(off, 2147483647), 8))
    }
}

// CMP rax, [r15+off]: 49 3B 47 disp8 or 49 3B 87 disp32
Function.CompileCompare_CmpRaxR15 {
    Input: off: Integer
    Body: {
        Listing_Open("CMP rax, [r15+off]")
        Emit_Byte(0x49)
        Emit_Byte(0x3B)
        IfCondition And(GreaterEqual(off, -128), LessThan(off, 128)) ThenBlock: {
            Emit_Byte(0x47)
            Emit_Byte(off)
        } ElseBlock: {
            Emit_Byte(0x87)
            Emit_DWord(off)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

Function.CompileCompare_Binary {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            Compile_Error("Comparison requires 2 arguments", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        LoopHome.rax_cand = 0

        // A materialized GPR compared with an imm32. cmp reg, imm.
        // ScanAddrBase is 0 when the name is not in a value home, so
        // rax is never the register this path compares.
        IfCondition NotEqual(arg0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg0), AST.IDENTIFIER) ThenBlock: {
                IfCondition NotEqual(arg1, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(arg1), AST.NUMBER) ThenBlock: {
                        creg = Optimize_ScanAddrBase(AST_GetData1(arg0))
                        IfCondition NotEqual(creg, 0) ThenBlock: {
                            cimm = StringToNumber(AST_GetData1(arg1))
                            cfit = 0
                            IfCondition GreaterEqual(cimm, -2147483648) ThenBlock: {
                                IfCondition LessEqual(cimm, 2147483647) ThenBlock: { cfit = 1 }
                            }
                            IfCondition EqualTo(cfit, 1) ThenBlock: {
                                X86_CmpGprImm(creg, cimm)
                                ReturnValue(1)
                            }
                        }
                    }
                }
            }
        }

        homed = Optimize_TryHomeCompare(arg0, arg1)
        IfCondition EqualTo(homed, 1) ThenBlock: { ReturnValue(1) }

        // CMP rax, imm32. The immediate is sign-extended, so -1 is one
        // instruction. The right-hand number never needs RBX, so a limit
        // parked in RBX survives a type test.
        IfCondition NotEqual(arg1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg1), AST.NUMBER) ThenBlock: {
                imm_cmp = StringToNumber(AST_GetData1(arg1))
                imm_ok = 0
                IfCondition GreaterEqual(imm_cmp, -2147483648) ThenBlock: {
                    IfCondition LessEqual(imm_cmp, 2147483647) ThenBlock: { imm_ok = 1 }
                }
                IfCondition EqualTo(imm_ok, 1) ThenBlock: {
                    result_imm = Compile_Expression(arg0)
                    IfCondition EqualTo(result_imm, 0) ThenBlock: { ReturnValue(0) }
                    Emit_CmpRaxImm32(imm_cmp)
                    Optimize_RaxCandidate(arg0)
                    ReturnValue(1)
                }
            }
        }

        // A frame local compares in place. The tag keeps its store.
        IfCondition EqualTo(Optimize_FrameCmpFresh(arg1), 1) ThenBlock: {
            mem_off = LoopHome.imm_val
            result_mem = Compile_Expression(arg0)
            IfCondition EqualTo(result_mem, 0) ThenBlock: { ReturnValue(0) }
            X86_CmpRaxMem(mem_off, 0)
            Optimize_RaxCandidate(arg0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_FrameCmpFresh(arg0), 1) ThenBlock: {
            mem_off = LoopHome.imm_val
            result_mem = Compile_Expression(arg1)
            IfCondition EqualTo(result_mem, 0) ThenBlock: { ReturnValue(0) }
            X86_CmpRaxMem(mem_off, 1)
            Optimize_RaxCandidate(arg1)
            ReturnValue(1)
        }
        
        // A FixedPool field on the right compares in place: cmp rax, [r15+off].
        // No push of the left, no load of the right into rax.
        pool_off = CompileCompare_PoolOff(arg1)
        IfCondition GreaterEqual(pool_off, 0) ThenBlock: {
            result = Compile_Expression(arg0)
            IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(0) }
            CompileCompare_CmpRaxR15(pool_off)
            Optimize_RaxCandidate(arg0)
            ReturnValue(1)
        }

        // Compile first argument → RAX
        result = Compile_Expression(arg0)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Push first arg
        Emit_PushRax()
        
        // Compile second argument → RAX
        result = Compile_Expression(arg1)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Left is at [rsp], right is in RAX. CMP [rsp], rax is left-right.
        // POP then discards the left. POP does not change flags, and it
        // does not write RBX. A soft compare does not save RBX.
        X86_CmpRspRax()
        Emit_PopRax()
        Optimize_RaxCandidate(arg0)
        
        // Caller will emit the specific SETcc
        ReturnValue(1)
    }
}

// =============================================================================
// INDIVIDUAL COMPARISONS
// =============================================================================

Function.CompileCompare_EqualTo {
    Input: node: Address
    Output: Integer
    Body: {
        result = CompileCompare_Binary(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // SETE AL
        Emit_Sete()
        // MOVZX RAX, AL
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}

Function.CompileCompare_NotEqual {
    Input: node: Address
    Output: Integer
    Body: {
        result = CompileCompare_Binary(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // SETNE AL
        Emit_Setne()
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}

Function.CompileCompare_LessThan {
    Input: node: Address
    Output: Integer
    Body: {
        result = CompileCompare_Binary(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // SETL AL (signed less than)
        Emit_Setl()
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}

Function.CompileCompare_GreaterThan {
    Input: node: Address
    Output: Integer
    Body: {
        result = CompileCompare_Binary(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // SETG AL (signed greater than)
        Emit_Setg()
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}

Function.CompileCompare_LessEqual {
    Input: node: Address
    Output: Integer
    Body: {
        result = CompileCompare_Binary(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // SETLE AL
        Emit_Setle()
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}

Function.CompileCompare_GreaterEqual {
    Input: node: Address
    Output: Integer
    Body: {
        result = CompileCompare_Binary(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // SETGE AL
        Emit_Setge()
        Emit_MovzxRaxAl()
        
        ReturnValue(1)
    }
}