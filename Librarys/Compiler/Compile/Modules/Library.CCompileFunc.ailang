// Library.CCompileFunc.ailang
// Function, SubRoutine, and call compilation for the AILang self-hosting compiler
// Mirrors user_functions.py from the Python compiler
// Location: Librarys/Compiler/Compile/Modules/Library.CCompileFunc.ailang
//
// CRITICAL FIX: Stack frame layout now matches SubRoutine pattern
// - SUB RSP for locals BEFORE pushing callee-saved registers
// - POP callee-saved BEFORE ADD RSP to deallocate
// - Parameters stored at RBP-8, RBP-16, etc. (within allocated space)
//
// FIX v2: Save/restore Compile.stack_size to prevent corruption in nested function compilation
// FIX v3: R12-based RSP preservation for call sites (robust at any depth)

LibraryImport.XArrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.Modules.CCompileScope

// =============================================================================
// Library.CCompileFunc.ailang
// Function, SubRoutine, and call compilation for the AILang self-hosting compiler
// =============================================================================
//
// ARCHITECTURE NOTES - READ BEFORE MODIFYING
// =============================================================================
//
// STACK ALIGNMENT (System V AMD64 ABI):
//
//   Call sites: RSP must be 16-byte aligned at CALL instruction.
//   Handled in CompileFunc_UserCall via R12 (callee-saved):
//     MOV R12, RSP      ; Save original RSP (survives nested calls)
//     AND RSP, -16      ; Align to 16 bytes
//     CALL target
//     MOV RSP, R12      ; Restore RSP
//
//   R12 is callee-saved, so nested calls during arg evaluation preserve it.
//   This approach requires no knowledge of stack frame size and works at any depth.
//
// FUTURE: SIMD/FPU ALIGNMENT
//
//   When adding SSE/AVX/AVX-512 support, alignment requirements increase:
//
//   | Type    | Registers | Required Alignment |
//   |---------|-----------|-------------------|
//   | SSE     | XMM0-15   | 16-byte (current) |
//   | AVX     | YMM0-15   | 32-byte           |
//   | AVX-512 | ZMM0-31   | 64-byte           |
//
//   CALLER responsibility (call sites): Always 16-byte - no change needed.
//   CALLEE responsibility (function prologue): Align to 32/64 if using AVX/512.
//
//   Implementation plan for AVX functions:
//   1. Add Function attribute: Alignment: 32 or Alignment: 64
//   2. In CompileFunc_Function prologue, after PUSH RBP; MOV RBP, RSP:
//        IfCondition GreaterThan(func_alignment, 16) ThenBlock: {
//            Emit_AndRspAlignment(func_alignment)  // AND RSP, -32 or -64
//        }
//   3. Epilogue must restore via RBP since RSP was modified:
//        MOV RSP, RBP  (already doing this)
//        POP RBP
//        RET
//
//   Alternative: Auto-detect alignment from SIMD instruction usage in body.
//   Alternative: AVXBlock: { } syntax for scoped alignment regions.
//
//   DO NOT add larger alignment at call sites - that breaks nested expressions.
//   The callee handles its own alignment needs in its prologue.
//
// STACK FRAME LAYOUT (after prologue):
//
//   RBP+8   = return address
//   RBP+0   = saved RBP
//   RBP-8   = param 1 / local 1
//   RBP-16  = param 2 / local 2
//   ...
//   RBP-N   = end of allocated space (N = stack_space)
//   [pushed callee-saved registers below this]
//   RSP ->
//
// CALLEE-SAVED REGISTERS (must preserve across calls):
//   RBX, R12, R13, R14, R15, RBP
//   Currently saving: RBX, R12, R13, R14 (R15 reserved for pool base)
//
// CALLER-SAVED REGISTERS (scratch, not preserved):
//   RAX, RCX, RDX, RSI, RDI, R8, R9, R10, R11
//
// NOTE: R12 is used for RSP preservation during aligned calls.
// Since R12 is callee-saved, it survives nested function calls during
// argument evaluation, making it robust for any call depth.
//
// =============================================================================

// =============================================================================
// FUNCTION DEFINITION COMPILATION
// Function.Name { Input: params Output: type Body: { ... } }
// Mirrors user_functions.py compile_function_definition()
// =============================================================================
Function.CompileFunc_Function {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Get function name
        func_name = AST_GetData1(node)
        
        PrintMessage("[FUNCDEF] Compiling function: ")
        PrintString(func_name)
        PrintMessage("\n")
        
        // Look up the label (registered in pass 1)
        func_label = Compile_FindFunction(func_name)
        IfCondition LessThan(func_label, 0) ThenBlock: {
            Compile_Error("Function not registered", AST_GetLine(node))
            ReturnValue(0)
        }
        
        // Save previous function context
        prev_func = Compile.current_func
        prev_stack_offset = Compile.stack_offset
        prev_stack_size = Compile.stack_size
        prev_return_label = Compile.current_return_label
        Compile.current_func = node
        
        // CRITICAL: Save global scope and create fresh function scope
        Scope_SaveAndClear(func_name)
        
        PrintMessage("[SCOPE] After SaveAndClear, variables: ")
        PrintNumber(XArray.XSize(Compile.variables))
        PrintMessage("\n")
        
        // CRITICAL: Jump over function definition during normal execution
        skip_label = Emit_CreateLabel()
        Emit_Jmp(skip_label)
        
        // Mark function entry point
        Emit_MarkLabel(func_label)
        
        // === FUNCTION PROLOGUE ===
        Emit_PushRbp()
        Emit_MovRegReg(Reg.RBP, Reg.RSP)
        
        // Count parameters and find body BEFORE allocating stack
        param_count = 0
        body_node = 0
        
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            child_type = AST_GetType(child)
            
            IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                param_count = Add(param_count, 1)
            }
            
            IfCondition EqualTo(child_type, AST.BLOCK) ThenBlock: {
                body_node = child
            }
            
            i = Add(i, 1)
        }

        // Build parameter name list for exclusion
        param_names = XArray.XCreate(16)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            child_type = AST_GetType(child)
            IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                pname = AST_GetData1(child)
                XArray.XPush(param_names, pname)
            }
            i = Add(i, 1)
        }
        
        // Count local variables in body
        local_count = 0
        IfCondition NotEqual(body_node, 0) ThenBlock: {
            local_count = Compile_CountLocals(body_node, param_names)
        }
        
        // Cleanup param list (don't free strings - they belong to AST)
        XArray.XDestroy(param_names)
        
        // Calculate stack space
        // - Base 64 bytes for scratch/temporaries/RSP save slot
        // - 16 bytes per local variable (alignment safe)
        // - 8 bytes per parameter
        base_space = 64
        local_space = Multiply(local_count, 16)
        param_space = Multiply(param_count, 8)
        total_space = Add(base_space, Add(local_space, param_space))
        
        // Align to 16 bytes
        stack_space = BitwiseAnd(Add(total_space, 15), -16)
        
        // Debug print AFTER variables are assigned
        PrintMessage("[FUNCDEF] Stack allocation: base=64 + ")
        PrintNumber(local_count)
        PrintMessage(" locals * 16 + ")
        PrintNumber(param_count)
        PrintMessage(" params * 8 = ")
        PrintNumber(stack_space)
        PrintMessage(" bytes\n")
        
        // Allocate stack space FIRST
        IfCondition GreaterThan(stack_space, 0) ThenBlock: {
            Emit_SubRspImm32(stack_space)
        }
        Compile.stack_size = stack_space
        
        // THEN save callee-saved registers
        Emit_PushRbx()
        Emit_PushR12()
        
        
        // === SPILL ARGUMENT REGISTERS TO STACK ===
        // Caller passes args in RDI, RSI, RDX, RCX, R8, R9
        // Body expects them at [RBP-8], [RBP-16], [RBP-24], etc.
        PrintMessage("[FUNCDEF] Spilling ")
        PrintNumber(param_count)
        PrintMessage(" params to stack\n")
        
        IfCondition GreaterEqual(param_count, 1) ThenBlock: {
            Emit_MovRaxRdi()
            Emit_MovRbpOffsetRax(-8)
            PrintMessage("[FUNCDEF] Spilled param 1: RDI -> [RBP-8]\n")
        }
        IfCondition GreaterEqual(param_count, 2) ThenBlock: {
            Emit_MovRaxRsi()
            Emit_MovRbpOffsetRax(-16)
            PrintMessage("[FUNCDEF] Spilled param 2: RSI -> [RBP-16]\n")
        }
        IfCondition GreaterEqual(param_count, 3) ThenBlock: {
            Emit_MovRaxRdx()
            Emit_MovRbpOffsetRax(-24)
            PrintMessage("[FUNCDEF] Spilled param 3: RDX -> [RBP-24]\n")
        }
        IfCondition GreaterEqual(param_count, 4) ThenBlock: {
            Emit_MovRaxRcx()
            Emit_MovRbpOffsetRax(-32)
            PrintMessage("[FUNCDEF] Spilled param 4: RCX -> [RBP-32]\n")
        }
        IfCondition GreaterEqual(param_count, 5) ThenBlock: {
            Emit_MovRaxR8()
            Emit_MovRbpOffsetRax(-40)
            PrintMessage("[FUNCDEF] Spilled param 5: R8 -> [RBP-40]\n")
        }
        IfCondition GreaterEqual(param_count, 6) ThenBlock: {
            Emit_MovRaxR9()
            Emit_MovRbpOffsetRax(-48)
            PrintMessage("[FUNCDEF] Spilled param 6: R9 -> [RBP-48]\n")
        }
        // === END SPILL ===
        
        // Register parameters as local variables
        CompileFunc_RegisterParams(node, param_count)
        
        // === FIX: Set stack_offset to start AFTER parameters ===
        // Parameters are at -8, -16, -24, etc.
        // Locals should start at -(param_count*8 + 8), -(param_count*8 + 16), etc.
        Compile.stack_offset = Multiply(param_count, 8)
        PrintMessage("[FUNCDEF] stack_offset set to ")
        PrintNumber(Compile.stack_offset)
        PrintMessage(" (after ")
        PrintNumber(param_count)
        PrintMessage(" params)\n")
        // === END FIX ===
        
        // === Create return label for ReturnValue calls ===
        return_label = Emit_CreateLabel()
        Compile.current_return_label = return_label
        PrintMessage("[FUNCDEF] Created return_label = ")
        PrintNumber(return_label)
        PrintMessage("\n")
        // === END ADD ===
        
        // Compile the body
        IfCondition NotEqual(body_node, 0) ThenBlock: {
            CompileFunc_CompileBody(body_node)
        }
        
        // Default return 0 for fall-through (no explicit ReturnValue)
        // This is BEFORE the return_label so ReturnValue jumps skip it
        Emit_XorRaxRax()
        
        // === Mark the return label - ReturnValue jumps land HERE ===
        // RAX already contains the return value from ReturnValue
        Emit_MarkLabel(return_label)
        
        // === FUNCTION EPILOGUE ===
        
        Emit_PopR12()
        Emit_PopRbx()
        
        Emit_MovRspRbp()
        
        Emit_PopRbp()
        Emit_Ret()
        
        // Mark skip label
        Emit_MarkLabel(skip_label)
        
        // Restore previous scope
        Scope_ClearFunctionParams(func_name)
        
        PrintMessage("[SCOPE] Before Restore, variables: ")
        PrintNumber(XArray.XSize(Compile.variables))
        PrintMessage("\n")
        
        Scope_Restore()
        
        PrintMessage("[SCOPE] After Restore, variables: ")
        PrintNumber(XArray.XSize(Compile.variables))
        PrintMessage("\n")
        
        // Restore previous context
        Compile.current_func = prev_func
        Compile.stack_size = prev_stack_size
        Compile.current_return_label = prev_return_label
        
        ReturnValue(1)
    }
}


// =============================================================================
// SUBROUTINE DEFINITION COMPILATION
// SubRoutine.Name { ... }
// Mirrors ailang_compiler.py compile_subroutine()
// NOTE: Subroutines have statements directly as children (no Body node)
// =============================================================================
Function.CompileFunc_SubRoutine {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Get subroutine name
        sub_name = AST_GetData1(node)
        
        // Look up the label (registered in pass 1)
        sub_label = Compile_FindFunction(sub_name)
        IfCondition LessThan(sub_label, 0) ThenBlock: {
            Compile_Error("SubRoutine not registered", AST_GetLine(node))
            ReturnValue(0)
        }
        
        // Save context
        prev_func = Compile.current_func
        prev_stack_offset = Compile.stack_offset
        prev_stack_size = Compile.stack_size
        Compile.current_func = node
        Compile.stack_offset = 0
        
        // CRITICAL: Jump over subroutine definition
        skip_label = Emit_CreateLabel()
        Emit_Jmp(skip_label)
        
        // Mark subroutine entry point
        Emit_MarkLabel(sub_label)
        
        // === SUBROUTINE PROLOGUE ===
        Emit_PushRbp()
        Emit_MovRbpRsp()
        
        // Count local variables (no params for subroutine)
        // Scan the node itself since statements are direct children
        empty_params = XArray.XCreate(1)
        local_count = Compile_CountLocals(node, empty_params)
        XArray.XDestroy(empty_params)
        
        // Calculate stack space
        // - Base 64 bytes for scratch/temporaries
        // - 16 bytes per local variable (alignment safe)
        base_space = 64
        local_space = Multiply(local_count, 16)
        total_space = Add(base_space, local_space)
        
        // Align to 16 bytes
        stack_space = BitwiseAnd(Add(total_space, 15), -16)
        
        PrintMessage("[SUBDEF] Stack allocation: base=64 + ")
        PrintNumber(local_count)
        PrintMessage(" locals * 16 = ")
        PrintNumber(stack_space)
        PrintMessage(" bytes\n")
        
        // Allocate stack space FIRST
        IfCondition GreaterThan(stack_space, 0) ThenBlock: {
            Emit_SubRspImm32(stack_space)
        }
        Compile.stack_size = stack_space
        
        // THEN save callee-saved registers
        Emit_PushRbx()
        Emit_PushR12()
        
        // Create return label for early ReturnValue calls
        return_label = Emit_CreateLabel()
        Compile.current_return_label = return_label
        
        // Compile statements directly (no Body wrapper)
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            IfCondition EqualTo(Compile.error, 1) ThenBlock: {
                ExitLoop
            }
            
            child = AST_GetChild(node, i)
            Compile_Node(child)
            
            i = Add(i, 1)
        }
        
        // Mark return point
        Emit_MarkLabel(return_label)
        
        // === SUBROUTINE EPILOGUE ===
        // Pop callee-saved FIRST (correct order)
        
        Emit_PopR12()
        Emit_PopRbx()
        
        // THEN deallocate stack space
        Emit_MovRspRbp() 
        Emit_PopRbp()
        
        Emit_Ret()
        
        // Mark skip label
        Emit_MarkLabel(skip_label)
        
        // Restore context
        Compile.current_func = prev_func
        Compile.stack_offset = prev_stack_offset
        Compile.stack_size = prev_stack_size
        Compile.current_return_label = 0
        
        ReturnValue(1)
    }
}

// =============================================================================
// COMPILE BODY BLOCK
// =============================================================================
Function.CompileFunc_CompileBody {
    Input: body_node: Address
    Output: Integer
    Body: {
        PrintMessage("[BODY] CompileBody called, node=")
        PrintNumber(body_node)
        PrintMessage("\n")
        
        IfCondition EqualTo(body_node, 0) ThenBlock: {
            PrintMessage("[BODY] Body node is NULL!\n")
            ReturnValue(1)
        }
        
        child_count = AST_GetChildCount(body_node)
        PrintMessage("[BODY] Child count: ")
        PrintNumber(child_count)
        PrintMessage("\n")
        
        i = 0
        WhileLoop LessThan(i, child_count) {
            PrintMessage("[BODY] Compiling child ")
            PrintNumber(i)
            PrintMessage("\n")
            
            IfCondition EqualTo(Compile.error, 1) ThenBlock: {
                ExitLoop
            }
            
            child = AST_GetChild(body_node, i)
            Compile_Node(child)
            i = Add(i, 1)
        }
        
        PrintMessage("[BODY] Done\n")
        ReturnValue(1)
    }
}

// =============================================================================
// REGISTER FUNCTION PARAMETERS AS LOCAL VARIABLES
// UPDATED: Parameters now at RBP-8, RBP-16, etc. (within allocated space)
// Also registers with scope manager for proper resolution
// =============================================================================
Function.CompileFunc_RegisterParams {
    Input: func_node: Address
    Input: param_count: Integer
    Body: {
        child_count = AST_GetChildCount(func_node)
        param_index = 0
        i = 0

        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(func_node, i)
            child_type = AST_GetType(child)

            IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                param_name = AST_GetData1(child)
                // FIXED: Stack offset now starts at -8, -16, -24, etc.
                offset = Multiply(Add(param_index, 1), -8)
                
                // Register as local variable
                Compile_RegisterLocal(param_name, offset)
                
                // ALSO register with scope manager for resolution
                Scope_AddParameter(param_name, offset)
                
                param_index = Add(param_index, 1)
            }

            i = Add(i, 1)
        }
    }
}

// =============================================================================
// REGISTER A LOCAL VARIABLE
// =============================================================================
Function.Compile_RegisterLocal {
    Input: name: Address
    Input: offset: Integer
    Body: {
        entry = Allocate(24)
        StoreValue(entry, name)
        StoreValue(Add(entry, 8), offset)
        StoreValue(Add(entry, 16), VarType.LOCAL)
        XArray.XPush(Compile.variables, entry)
    }
}

// =============================================================================
// RUNTASK COMPILATION
// RunTask(SubRoutineName) - calls a subroutine by name
// =============================================================================
Function.CompileFunc_RunTask {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Get the task name
        task_name = AST_GetData1(node)
        
        IfCondition EqualTo(task_name, 0) ThenBlock: {
            arg_count = AST_GetChildCount(node)
            IfCondition GreaterEqual(arg_count, 1) ThenBlock: {
                arg = AST_GetChild(node, 0)
                task_name = AST_GetData1(arg)
            }
        }
        
        IfCondition EqualTo(task_name, 0) ThenBlock: {
            Compile_Error("RunTask requires a task name", AST_GetLine(node))
            ReturnValue(0)
        }
        
        // Look up the subroutine label
        task_label = Compile_FindFunction(task_name)
        IfCondition LessThan(task_label, 0) ThenBlock: {
            Compile_Error("Unknown subroutine for RunTask", AST_GetLine(node))
            ReturnValue(0)
        }
        
        // Emit CALL to the subroutine
        Emit_Call(task_label)
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// USER-DEFINED FUNCTION CALL
// result = FunctionName(arg1, arg2, ...)
// 
// Uses R12 (callee-saved) to preserve RSP across the call.
// This is robust at any nesting depth since R12 survives nested calls.
// =============================================================================
Function.CompileFunc_UserCall {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Get function name
        func_name = AST_GetData1(node)
        
        // Look up the function label
        func_label = Compile_FindFunction(func_name)
        
        IfCondition LessThan(func_label, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Count arguments
        arg_count = AST_GetChildCount(node)
        
        // Evaluate and load arguments into calling convention registers
        // For single-arg (most common): just MOV RDI, RAX — no push/pop
        // For multi-arg: push in reverse, pop into registers
        IfCondition EqualTo(arg_count, 1) ThenBlock: {
            // FAST PATH: single argument — no stack needed
            arg = AST_GetChild(node, 0)
            Compile_Expression(arg)
            Emit_MovRdiRax()
        } ElseBlock: {
            IfCondition GreaterThan(arg_count, 1) ThenBlock: {
                // MULTI-ARG PATH: push in reverse, pop into registers
                i = Subtract(arg_count, 1)
                WhileLoop GreaterEqual(i, 0) {
                    arg = AST_GetChild(node, i)
                    Compile_Expression(arg)
                    Emit_PushRax()
                    i = Subtract(i, 1)
                }
                
                IfCondition GreaterEqual(arg_count, 1) ThenBlock: {
                    Emit_PopRdi()
                }
                IfCondition GreaterEqual(arg_count, 2) ThenBlock: {
                    Emit_PopRsi()
                }
                IfCondition GreaterEqual(arg_count, 3) ThenBlock: {
                    Emit_PopRdx()
                }
                IfCondition GreaterEqual(arg_count, 4) ThenBlock: {
                    Emit_PopRcx()
                }
                IfCondition GreaterEqual(arg_count, 5) ThenBlock: {
                    Emit_PopR8()
                }
                IfCondition GreaterEqual(arg_count, 6) ThenBlock: {
                    Emit_PopR9()
                }
            }
        }
        
        // === RSP SAVE/RESTORE using R12 (callee-saved) ===
        // R12 survives nested calls during arg evaluation
        // No dependency on Compile.stack_size - works for any depth
        Emit_MovRegReg(Reg.R12, Reg.RSP)
        
        // Align stack to 16 bytes before CALL
        Emit_AndRspImm8(240)
        
        // CALL the function
        Emit_Call(func_label)
        
        // Restore RSP from R12 (callee-saved, guaranteed preserved)
        Emit_MovRegReg(Reg.RSP, Reg.R12)

        // Clean up stack-passed arguments (args 7+)
        // SysV AMD64: first 6 args in registers, rest on stack
        // The caller must pop them after the call returns
        IfCondition GreaterThan(arg_count, 6) ThenBlock: {
            stack_args = Subtract(arg_count, 6)
            stack_bytes = Multiply(stack_args, 8)
            Emit_AddRspImm32(stack_bytes)
        }

        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}


// =============================================================================
// COUNT LOCAL VARIABLES IN FUNCTION BODY
// Returns count of unique variable assignments (excluding parameters)
// =============================================================================
Function.Compile_CountLocals {
    Input: body_node: Address
    Input: param_names: Address
    Output: Integer
    Body: {
        PrintMessage("[COUNTLOCALS] Called!\n")
        IfCondition EqualTo(body_node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Create array to track seen variable names
        seen_vars = XArray.XCreate(64)
        
        // Scan recursively
        Compile_ScanForLocals(body_node, seen_vars, param_names)
        
        // Get count
        count = XArray.XSize(seen_vars)
        
        PrintMessage("[LOCALS] Found ")
        PrintNumber(count)
        PrintMessage(" unique local variables\n")
        
        // Cleanup - free copied strings
        i = 0
        WhileLoop LessThan(i, count) {
            name = XArray.XGet(seen_vars, i)
            IfCondition NotEqual(name, 0) ThenBlock: {
                Deallocate(name, 0)
            }
            i = Add(i, 1)
        }
        XArray.XDestroy(seen_vars)
        
        ReturnValue(count)
    }
}

// =============================================================================
// RECURSIVE SCANNER FOR LOCAL VARIABLES
// Walks AST and collects unique assignment targets
// =============================================================================
Function.Compile_ScanForLocals {
    Input: node: Address
    Input: seen_vars: Address
    Input: param_names: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        node_type = AST_GetType(node)
        
        // Check for assignment node
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            var_name = AST_GetData1(node)
            
            IfCondition NotEqual(var_name, 0) ThenBlock: {
                // Skip if it's a parameter
                is_param = Compile_IsParameter(var_name, param_names)
                
                IfCondition EqualTo(is_param, 0) ThenBlock: {
                    // Skip if it's a pool variable (contains dot)
                    is_pool = Compile_ContainsDot(var_name)
                    
                    IfCondition EqualTo(is_pool, 0) ThenBlock: {
                        // Check if already seen
                        is_seen = Compile_IsInList(var_name, seen_vars)
                        
                        IfCondition EqualTo(is_seen, 0) ThenBlock: {
                            // New local - add copy to list
                            // Manually copy the string byte by byte
                            len = StringLength(var_name)
                            name_copy = Allocate(Add(len, 1))
                            
                            j = 0
                            WhileLoop LessEqual(j, len) {
                                c = GetByte(var_name, j)
                                SetByte(name_copy, j, c)
                                j = Add(j, 1)
                            }
                            
                            XArray.XPush(seen_vars, name_copy)
                            
                            PrintMessage("[LOCALS]   Found: ")
                            PrintString(var_name)
                            PrintMessage("\n")
                        }
                    }
                }
            }
        }
        
        // Recurse into all children
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            Compile_ScanForLocals(child, seen_vars, param_names)
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// HELPER: Check if name is in parameter list
// =============================================================================
Function.Compile_IsParameter {
    Input: name: Address
    Input: param_names: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(param_names, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        count = XArray.XSize(param_names)
        i = 0
        WhileLoop LessThan(i, count) {
            param = XArray.XGet(param_names, i)
            IfCondition NotEqual(param, 0) ThenBlock: {
                cmp = StringCompare(name, param)
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// HELPER: Check if name contains a dot (pool variable)
// =============================================================================
Function.Compile_ContainsDot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        i = 0
        WhileLoop LessThan(i, 256) {
            c = GetByte(name, i)
            
            IfCondition EqualTo(c, 0) ThenBlock: {
                ReturnValue(0)
            }
            
            // ASCII 46 = '.'
            IfCondition EqualTo(c, 46) ThenBlock: {
                ReturnValue(1)
            }
            
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// HELPER: Check if name is already in seen list
// =============================================================================
Function.Compile_IsInList {
    Input: name: Address
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        count = XArray.XSize(list)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(list, i)
            IfCondition NotEqual(existing, 0) ThenBlock: {
                cmp = StringCompare(name, existing)
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}


// =============================================================================
// CALLINDIRECT
// CallIndirect(func_ptr, arg1, arg2, ...) - call function through pointer
// System V ABI: RDI, RSI, RDX, RCX, R8, R9 for args 1-6
// =============================================================================
Function.CompileFunc_CallIndirect {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        
        IfCondition LessThan(arg_count, 1) ThenBlock: {
            PrintMessage("[ERROR] CallIndirect requires at least function pointer\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // arg0 = function pointer, args 1-N = call arguments
        num_call_args = Subtract(arg_count, 1)
        
        PrintMessage("[CALLINDIRECT] ")
        PrintNumber(num_call_args)
        PrintMessage(" arguments\n")
        
        // 1. Compile function pointer, save on stack
        arg0 = AST_GetChild(node, 0)
        Compile_Expression(arg0)
        Emit_PushRax()
        
        // 2. Push stack arguments (7+) in reverse order
        stack_args = 0
        IfCondition GreaterThan(num_call_args, 6) ThenBlock: {
            i = arg_count
            i = Subtract(i, 1)
            WhileLoop GreaterThan(i, 6) {
                arg = AST_GetChild(node, i)
                Compile_Expression(arg)
                Emit_PushRax()
                stack_args = Add(stack_args, 1)
                i = Subtract(i, 1)
            }
        }
        
        // 3. Load register arguments 1-6
        // We need to be careful: compiling each arg clobbers RAX
        // So we compile and move to target register, saving previous if needed
        
        // Arg 1 -> RDI
        IfCondition GreaterEqual(num_call_args, 1) ThenBlock: {
            arg1 = AST_GetChild(node, 1)
            Compile_Expression(arg1)
            Emit_MovRdiRax()
        }
        
        // Arg 2 -> RSI (save RDI first)
        IfCondition GreaterEqual(num_call_args, 2) ThenBlock: {
            Emit_PushRdi()
            arg2 = AST_GetChild(node, 2)
            Compile_Expression(arg2)
            Emit_MovRsiRax()
            Emit_PopRdi()
        }
        
        // Arg 3 -> RDX
        IfCondition GreaterEqual(num_call_args, 3) ThenBlock: {
            Emit_PushRdi()
            Emit_PushRsi()
            arg3 = AST_GetChild(node, 3)
            Compile_Expression(arg3)
            Emit_MovRdxRax()
            Emit_PopRsi()
            Emit_PopRdi()
        }
        
        // Arg 4 -> RCX
        IfCondition GreaterEqual(num_call_args, 4) ThenBlock: {
            Emit_PushRdi()
            Emit_PushRsi()
            Emit_PushRdx()
            arg4 = AST_GetChild(node, 4)
            Compile_Expression(arg4)
            Emit_MovRcxRax()
            Emit_PopRdx()
            Emit_PopRsi()
            Emit_PopRdi()
        }
        
        // Arg 5 -> R8
        IfCondition GreaterEqual(num_call_args, 5) ThenBlock: {
            Emit_PushRdi()
            Emit_PushRsi()
            Emit_PushRdx()
            Emit_PushRcx()
            arg5 = AST_GetChild(node, 5)
            Compile_Expression(arg5)
            Emit_MovR8Rax()
            Emit_PopRcx()
            Emit_PopRdx()
            Emit_PopRsi()
            Emit_PopRdi()
        }
        
        // Arg 6 -> R9
        IfCondition GreaterEqual(num_call_args, 6) ThenBlock: {
            Emit_PushRdi()
            Emit_PushRsi()
            Emit_PushRdx()
            Emit_PushRcx()
            Emit_PushR8()
            arg6 = AST_GetChild(node, 6)
            Compile_Expression(arg6)
            Emit_MovR9Rax()
            Emit_PopR8()
            Emit_PopRcx()
            Emit_PopRdx()
            Emit_PopRsi()
            Emit_PopRdi()
        }
        
        // 4. Get function pointer back from stack
        IfCondition GreaterThan(stack_args, 0) ThenBlock: {
            // MOV RAX, [RSP + stack_args * 8]
            offset = Multiply(stack_args, 8)
            Emit_MovRaxRspOffset(offset)
        } ElseBlock: {
            Emit_PopRax()
        }
        
        // 5. Align stack and call
        Emit_MovR12Rsp()
        Emit_AndRspImm8(240)
        Emit_CallRax()
        Emit_MovRspR12()
        
        // 6. Clean up stack if we had stack args
        IfCondition GreaterThan(stack_args, 0) ThenBlock: {
            // Clean func ptr + stack args
            cleanup = Add(8, Multiply(stack_args, 8))
            Emit_AddRspImm32(cleanup)
        }
        
        ReturnValue(1)
    }
}

// =============================================================================
// DISPATCHER FOR FUNCTION-RELATED CALLS
// =============================================================================
Function.CompileFunc_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        func_name = AST_GetData1(node)
        
        
        IfCondition EqualTo(StringCompare(func_name, "CallIndirect"), 0) ThenBlock: {
            ReturnValue(CompileFunc_CallIndirect(node))
        }


        cmp = StringCompare(func_name, "RunTask")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFunc_RunTask(node))
        }
        
        cmp = StringCompare(func_name, "ReturnValue")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileFunc_ReturnValue(node))
        }
        
        ReturnValue(CompileFunc_UserCall(node))
    }
}


// =============================================================================
// RETURNVALUE COMPILATION
// ReturnValue(expr) - return from function/subroutine with value
// =============================================================================
Function.CompileFunc_ReturnValue {
    Input: node: Address
    Output: Integer
    Body: {
        // Compile the return expression into RAX
        arg_count = AST_GetChildCount(node)
        IfCondition GreaterEqual(arg_count, 1) ThenBlock: {
            arg = AST_GetChild(node, 0)
            Compile_Expression(arg)
        } ElseBlock: {
            Emit_XorRaxRax()
        }
        
        // Jump to the return label (epilogue handles cleanup)
        IfCondition NotEqual(Compile.current_return_label, 0) ThenBlock: {
            Emit_Jmp(Compile.current_return_label)
        } ElseBlock: {
            // Should never happen now, but fallback just in case
            PrintMessage("[RETVAL] WARNING: No return label set!\n")
            Emit_Ret()
        }
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// HELPER: FIND FUNCTION BY NAME
// Returns label ID or -1 if not found
// =============================================================================
Function.Compile_FindFunction {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(-1)
        }
        
        count = XArray.XSize(Compile.functions)
        i = 0
        
        WhileLoop LessThan(i, count) {
            entry = XArray.XGet(Compile.functions, i)
            stored_name = Dereference(entry)
            
            cmp = StringCompare(name, stored_name)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                label = Dereference(Add(entry, 8))
                ReturnValue(label)
            }
            
            i = Add(i, 1)
        }
        
        ReturnValue(-1)
    }
}

// =============================================================================
// REGISTER FUNCTION (called from pass 1)
// =============================================================================
Function.Compile_RegisterFunction {
    Input: name: Address
    Input: label: Integer
    Body: {
        entry = Allocate(16)
        StoreValue(entry, name)
        StoreValue(Add(entry, 8), label)
        XArray.XPush(Compile.functions, entry)
    }
}