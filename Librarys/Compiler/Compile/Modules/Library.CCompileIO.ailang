// Library.CCompileIO.ailang
// I/O operations: PrintMessage, PrintNumber, PrintChar, ReadInput
// NO FixedPool for function names - uses string literals to avoid pool collisions

LibraryImport.XArrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Compile.CCompileMain
LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.Modules.CSysDispatch


// =============================================================================
// IO STATE - Track if we've emitted helper routines
// NOTE: This is mutable state, NOT function name constants, so it's OK to keep
// =============================================================================
FixedPool.IOState {
    "print_number_label": Initialize=0, CanChange=True
    "print_number_emitted": Initialize=0, CanChange=True
    "number_buffer_offset": Initialize=0, CanChange=True
}

// =============================================================================
// TRY COMPILE - Main dispatch for I/O operations
// Returns 1 if handled, 0 if not an I/O operation
// =============================================================================
Function.CompileIO_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        PrintMessage("[IO] TryCompile called\n")
        
        IfCondition EqualTo(node, 0) ThenBlock: {
            PrintMessage("[IO] node is null\n")
            ReturnValue(0)
        }

        func_name = AST_GetData1(node)
        
        IfCondition EqualTo(func_name, 0) ThenBlock: {
            PrintMessage("[IO] func_name is null\n")
            ReturnValue(0)
        }
        
        PrintMessage("[IO] Checking function: ")
        PrintString(func_name)
        PrintMessage("\n")

        // Check each I/O operation using string literals
        cmp = StringCompare(func_name, "PrintMessage")
        PrintMessage("[IO] vs PrintMessage: ")
        PrintNumber(cmp)
        PrintMessage("\n")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            PrintMessage("[IO] Matched PrintMessage!\n")
            ReturnValue(CompileIO_PrintMessage(node))
        }

        cmp = StringCompare(func_name, "PrintNumber")
        PrintMessage("[IO] vs PrintNumber: ")
        PrintNumber(cmp)
        PrintMessage("\n")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            PrintMessage("[IO] Matched PrintNumber!\n")
            ReturnValue(CompileIO_PrintNumber(node))
        }

         cmp = StringCompare(func_name, "PrintHex")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
        ReturnValue(CompileIO_PrintHex(node))
        }


        cmp = StringCompare(func_name, "PrintChar")
        PrintMessage("[IO] vs PrintChar: ")
        PrintNumber(cmp)
        PrintMessage("\n")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            PrintMessage("[IO] Matched PrintChar!\n")
            ReturnValue(CompileIO_PrintChar(node))
        }
        
        cmp = StringCompare(func_name, "PrintString")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            PrintMessage("[IO] Matched PrintString!\n")
            ReturnValue(CompileIO_PrintString(node))
        }
        
        cmp = StringCompare(func_name, "ReadLine")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(CompileIO_ReadLine(node))
        }

        // Not an I/O operation
        PrintMessage("[IO] No match, returning 0\n")
        ReturnValue(0)
    }
}



// =============================================================================
// PRINTMESSAGE(string)
// Emit: sys_write(1, string_addr, string_len)
// Handles both literals and runtime strings
// =============================================================================
Function.CompileIO_PrintMessage {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("PrintMessage requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        node_type = AST_GetType(arg0)
        
        // Handle string literal (optimized path - length known at compile time)
        IfCondition EqualTo(node_type, AST.STRING) ThenBlock: {
            str_value = AST_GetData1(arg0)
            str_len = StringLength(str_value)
            
            // Add string to data section
            str_offset = Emit_AddString(str_value)
            
            // sys_write(1, addr, len) - args: RDI=fd, RSI=buf, RDX=len
            Emit_MovRdiImm64(1)        // fd: stdout
            Emit_MovRsiDataOffset(str_offset)
            Emit_MovRdxImm64(str_len)  // length
            Sys_Write()                // OS-portable syscall
            
            Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
            ReturnValue(1)
        }
        
        // Handle expression (variable or function call returning string)
        // Compile string pointer -> RAX
        result = Compile_Expression(arg0)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Save string pointer
        Emit_PushRax()
        
        // Calculate string length at runtime
        Emit_MovRdiRax()      // RDI = string pointer
        Emit_XorRcxRcx()      // RCX = 0 (counter)
        
        len_loop = Emit_CreateLabel()
        len_done = Emit_CreateLabel()
        
        Emit_MarkLabel(len_loop)
        Emit_CmpByteRdiRcxZero()
        Emit_Je(len_done)
        Emit_IncRcx()
        Emit_Jmp(len_loop)
        Emit_MarkLabel(len_done)
        
        // RCX = length, restore string pointer
        Emit_MovRdxRcx()      // RDX = length for syscall
        Emit_PopRsi()         // RSI = string pointer
        
        // write(1, str, len) - RDI=fd, RSI=buf, RDX=len
        Emit_MovRdiImm64(1)   // fd: stdout
        Sys_Write()           // OS-portable syscall
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

Function.CompileIO_PrintNumber {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("PrintNumber requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)

        result = Compile_Expression(arg0)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Save callee-saved 
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushR14()
        
        // Allocate 32 bytes on stack for buffer
        Emit_SubRspImm32(32)
        
        // R12 = number, R13 = sign (0=pos, 1=neg)
        Emit_MovR12Rax()
        Emit_XorRegReg(Reg.R13, Reg.R13)
        
        // Check negative
        is_positive = Emit_CreateLabel()
        Emit_TestR12R12()
        Emit_Jns(is_positive)
        Emit_MovRaxImm64(1)
        Emit_MovR13Rax()
        Emit_NegReg(Reg.R12)
        Emit_MarkLabel(is_positive)
        
        // R14 = RSP + 31 (buffer end)
        Emit_MovRaxRsp()
        Emit_AddRaxImm8(31)
        Emit_MovR14Rax()
        
        // RBX = 10
        Emit_MovRbxImm64(10)
        
        // RCX = digit count
        Emit_XorRcxRcx()
        
        // Labels
        is_zero = Emit_CreateLabel()
        do_convert = Emit_CreateLabel()
        convert_loop = Emit_CreateLabel()
        loop_done = Emit_CreateLabel()
        skip_minus = Emit_CreateLabel()
        print_it = Emit_CreateLabel()
        
        // Check zero
        Emit_TestR12R12()
        Emit_Jz(is_zero)
        Emit_Jmp(do_convert)
        
        Emit_MarkLabel(is_zero)
        Emit_MovRdxImm64(48)
        Emit_MovByteR14Dl()
        Emit_IncRcx()
        Emit_Jmp(print_it)
        
        Emit_MarkLabel(do_convert)
        Emit_MarkLabel(convert_loop)
        Emit_TestR12R12()
        Emit_Jz(loop_done)
        
        Emit_MovRaxR12()
        Emit_XorRdxRdx()
        Emit_DivRbx()
        Emit_AddRdxImm32(48)
        Emit_MovByteR14Dl()
        Emit_DecReg(Reg.R14)
        Emit_IncRcx()
        Emit_MovR12Rax()
        Emit_Jmp(convert_loop)
        
        Emit_MarkLabel(loop_done)
        Emit_IncReg(Reg.R14)
        
        // Add minus if negative
        Emit_TestR13R13()
        Emit_Jz(skip_minus)
        Emit_DecReg(Reg.R14)
        Emit_MovRdxImm64(45)
        Emit_MovByteR14Dl()
        Emit_IncRcx()
        Emit_MarkLabel(skip_minus)
        
        Emit_MarkLabel(print_it)
        
        // sys_write(1, R14, RCX)
        Emit_MovRdxRcx()
        Emit_MovRsiR14()
        Emit_MovRdiImm64(1)
        Emit_MovRaxImm64(1)
        Emit_Syscall()
        
        // Restore stack
        Emit_AddRspImm32(32)
        
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

 
// =============================================================================
// PrintHex(value)
// Prints a 64-bit integer in hexadecimal with "0x" prefix
// =============================================================================
// =============================================================================
// PrintHex(value)
// Prints a 64-bit integer in hexadecimal with "0x" prefix
// =============================================================================
Function.CompileIO_PrintHex {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("PrintHex requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }

        arg0 = AST_GetChild(node, 0)

        result = Compile_Expression(arg0)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Save callee-saved
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushR14()

        // Allocate 24 bytes on stack for buffer (16 hex digits + "0x" + padding)
        Emit_SubRspImm32(24)

        // R12 = number to convert
        Emit_MovR12Rax()

        // R14 = RSP + 17 (buffer end, room for 16 digits)
        Emit_MovRaxRsp()
        Emit_AddRaxImm8(17)
        Emit_MovR14Rax()

        // RBX = 16 (divisor for hex)
        Emit_MovRbxImm64(16)

        // RCX = digit count
        Emit_XorRcxRcx()

        // Labels
        is_zero = Emit_CreateLabel()
        do_convert = Emit_CreateLabel()
        convert_loop = Emit_CreateLabel()
        loop_done = Emit_CreateLabel()
        digit_is_letter = Emit_CreateLabel()
        store_digit = Emit_CreateLabel()
        print_it = Emit_CreateLabel()

        // Check zero
        Emit_TestR12R12()
        Emit_Jz(is_zero)
        Emit_Jmp(do_convert)

        // Zero case: just store '0'
        Emit_MarkLabel(is_zero)
        Emit_MovRdxImm64(48)       // '0'
        Emit_MovByteR14Dl()
        Emit_IncRcx()
        Emit_Jmp(print_it)

        Emit_MarkLabel(do_convert)
        Emit_MarkLabel(convert_loop)
        Emit_TestR12R12()
        Emit_Jz(loop_done)

        // RAX = R12 / 16, RDX = R12 % 16
        Emit_MovRaxR12()
        Emit_XorRdxRdx()
        Emit_DivRbx()

        // Convert nibble to hex char
        Emit_CmpRdxImm8(10)
        Emit_Jge(digit_is_letter)
        
        // 0-9: add '0' (48)
        Emit_AddRdxImm32(48)
        Emit_Jmp(store_digit)

        Emit_MarkLabel(digit_is_letter)
        // 10-15: add 'A'-10 (55)
        Emit_AddRdxImm32(55)

        Emit_MarkLabel(store_digit)
        Emit_MovByteR14Dl()
        Emit_DecReg(Reg.R14)
        Emit_IncRcx()
        Emit_MovR12Rax()           // quotient for next iteration
        Emit_Jmp(convert_loop)

        Emit_MarkLabel(loop_done)
        Emit_IncReg(Reg.R14)       // Point to first digit

        Emit_MarkLabel(print_it)

        // Save RCX (digit count) - syscall clobbers RCX
        Emit_PushRcx()

        // Print "0x" prefix first
        prefix_offset = Emit_AddString("0x")
        Emit_MovRsiDataOffset(prefix_offset)
        Emit_MovRdxImm64(2)
        Emit_MovRdiImm64(1)
        Sys_Write()

        // Restore RCX (digit count)
        Emit_PopRcx()

        // Print hex digits: sys_write(1, R14, RCX)
        Emit_MovRdxRcx()
        Emit_MovRsiR14()
        Emit_MovRdiImm64(1)
        Sys_Write()

        // Clean up stack
        Emit_AddRspImm32(24)

        // Restore callee-saved
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()

        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// PRINTCHAR(char)
// Print a single character
// =============================================================================
Function.CompileIO_PrintChar {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("PrintChar requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        result = Compile_Expression(arg0)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Push char to stack and print from there
        Emit_PushRax()
        
        // sys_write(1, rsp, 1)
        Emit_MovRaxImm64(1)
        Emit_MovRdiImm64(1)
        Emit_MovRegReg(Reg.RSI, Reg.RSP)
        Emit_MovRdxImm64(1)
        Emit_Syscall()
        
        Emit_PopRax()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// PRINTSTRING - Print string from pointer (runtime value)
// =============================================================================
Function.CompileIO_PrintString {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("PrintString requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        // Compile string pointer -> RAX
        Compile_Expression(arg0)
        
        // Save string pointer
        Emit_PushRax()
        
        // First calculate string length (need it for write syscall)
        Emit_MovRdiRax()      // RDI = string pointer
        Emit_XorRcxRcx()      // RCX = 0 (counter)
        
        len_loop = Emit_CreateLabel()
        len_done = Emit_CreateLabel()
        
        Emit_MarkLabel(len_loop)
        Emit_CmpByteRdiRcxZero()
        Emit_Je(len_done)
        Emit_IncRcx()
        Emit_Jmp(len_loop)
        Emit_MarkLabel(len_done)
        
        // RCX = length, restore string pointer
        Emit_MovRdxRcx()      // RDX = length for syscall
        Emit_PopRsi()         // RSI = string pointer
        
        // write(1, str, len)
        Emit_MovRaxImm64(1)   // syscall: write
        Emit_MovRdiImm64(1)   // fd: stdout
        // RSI = string pointer (already set)
        // RDX = length (already set)
        Emit_Syscall()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// READLINE - Stub for future implementation
// =============================================================================
Function.CompileIO_ReadLine {
    Input: node: Address
    Output: Integer
    Body: {
        Compile_Error("ReadLine not yet implemented", AST_GetLine(node))
        ReturnValue(0)
    }
}

// =============================================================================
// HELPER: Emit wrapper for printing (used by CompileIO_Print stub)
// =============================================================================
Function.CompileIO_Print {
    Input: node: Address
    Output: Integer
    Body: {
        node_type = AST_GetType(node)
        
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            
            cmp = StringCompare(func_name, "PrintMessage")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(CompileIO_PrintMessage(node))
            }
            
            cmp = StringCompare(func_name, "PrintNumber")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(CompileIO_PrintNumber(node))
            }

            cmp = StringCompare(func_name, "PrintHex")
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(CompileIO_PrintHex(node))
            }
        }
        
        ReturnValue(0)
    }
}