// Library.CCompileMem.ailang
// Memory operations compiler module for the AILang self-hosting compiler
// Handles: Allocate, Deallocate, MemoryCopy, MemorySet, AddressOf, and the
// RDMEM_ / WRMEM_ memory accesses (Library.CMemPrim.ailang has the shapes)

LibraryImport.Arena

LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.CodeEmit.X86.CEmitKeep
LibraryImport.Compiler.Frontend.AST.CMemPrim

// =============================================================================
// DISPATCHER
// =============================================================================
Function.CompileMem_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        func_name = AST_GetData1(node)
        
        IfCondition EqualTo(StringCompare(func_name, "Allocate"), 0) ThenBlock: {
            ReturnValue(CompileMem_Allocate(node))
        }
        
        IfCondition EqualTo(StringCompare(func_name, "Deallocate"), 0) ThenBlock: {
            ReturnValue(CompileMem_Deallocate(node))
        }
        
        IfCondition EqualTo(StringCompare(func_name, "MemoryCopy"), 0) ThenBlock: {
            ReturnValue(CompileMem_MemoryCopy(node))
        }
        
        IfCondition EqualTo(StringCompare(func_name, "MemorySet"), 0) ThenBlock: {
            ReturnValue(CompileMem_MemorySet(node))
        }
        
        // Add to CompileMem_TryCompile dispatcher:
        IfCondition EqualTo(StringCompare(func_name, "AddressOf"), 0) ThenBlock: {
            ReturnValue(CompileMem_AddressOf(node))
        }


        // RDMEM_<w> / WRMEM_<w>. The parser already checked the argument
        // count and settled the shape.
        mem_code = MemPrim_Decode(func_name)
        IfCondition GreaterThan(mem_code, 0) ThenBlock: {
            IfCondition EqualTo(MemPrim_IsIO(mem_code), 1) ThenBlock: {
                ReturnValue(CompileMem_IO(node, mem_code))
            }
            IfCondition EqualTo(MemNode_IsByteAt(node), 1) ThenBlock: {
                ReturnValue(CompileMem_ByteAt(node))
            }
            IfCondition EqualTo(MemNode_IsByteSetAt(node), 1) ThenBlock: {
                ReturnValue(CompileMem_ByteSetAt(node))
            }
            IfCondition EqualTo(MemNode_IsLoad(node), 1) ThenBlock: {
                ReturnValue(CompileMem_Load(node, mem_code))
            }
            IfCondition EqualTo(MemNode_IsStore(node), 1) ThenBlock: {
                ReturnValue(CompileMem_Store(node, mem_code))
            }
            PrintMessage("[ERROR] memory access with the wrong number of arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }

        // Not a memory operation
        ReturnValue(0)
    }
}

// =============================================================================
// ALLOCATE - Arena-backed version
// Allocate(size) - calls Arena_Alloc, returns address in RAX
// =============================================================================
Function.CompileMem_Allocate {
    Input: node: Address
    Output: Integer
    Body: {
        Optimize_OutKill()
        Optimize_XmmKill()
        Optimize_ZeroKill()
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[ERROR] Allocate requires 1 argument\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        // Compile size argument - result in RAX
        Compile_Expression(arg0)
        
        // Find Arena_Alloc function
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            PrintMessage("[ERROR] Arena_Alloc not found\n")
            PrintMessage("        Ensure LibraryImport.Arena is included\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Save RSP in R12 (callee-saved), align stack to 16 bytes
        Emit_MovRegReg(Reg.R12, Reg.RSP)
        Emit_AndRspImm8(240)
        
        // Size is first argument (RDI)
        Emit_MovRdiRax()
        
        // Call Arena_Alloc
        Emit_Call(arena_label)
        
        // Restore RSP
        Emit_MovRegReg(Reg.RSP, Reg.R12)
        
        // RAX now contains allocated address
        ReturnValue(1)
    }
}

// =============================================================================
// DEALLOCATE - Arena-backed version
// Deallocate(addr, size) - calls Arena_Free
// =============================================================================
Function.CompileMem_Deallocate {
    Input: node: Address
    Output: Integer
    Body: {
        Optimize_OutKill()
        Optimize_XmmKill()
        Optimize_ZeroKill()
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[ERROR] Deallocate requires 2 arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Find Arena_Free function
        arena_free_label = Compile_FindFunction("Arena_Free")
        IfCondition LessThan(arena_free_label, 0) ThenBlock: {
            PrintMessage("[ERROR] Arena_Free not found\n")
            PrintMessage("        Ensure LibraryImport.Arena is included\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Compile ptr argument first, save on stack
        Compile_Expression(arg0)
        Emit_PushRax()
        
        // Compile size argument
        Compile_Expression(arg1)
        Emit_MovRsiRax()          // Size as second arg (RSI)
        
        // Pop ptr into RAX, then move to RDI (first arg)
        Emit_PopRax()
        Emit_MovRdiRax()
        
        // Save RSP in R12 (callee-saved), align stack to 16 bytes
        Emit_MovRegReg(Reg.R12, Reg.RSP)
        Emit_AndRspImm8(240)
        
        // Call Arena_Free
        Emit_Call(arena_free_label)
        
        // Restore RSP
        Emit_MovRegReg(Reg.RSP, Reg.R12)
        
        ReturnValue(1)
    }
}

// 1 when child 1 is a non-negative imm32. 2 when child 0 is.
// 0 for a variable offset, a negative, or a sum that does not fit disp32.
// Add(base, Add(index, constant)) is 0: that index stays on the general path.
Function.CompileMem_FieldAdd {
    Input: addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        c1 = AST_GetChild(addr, 1)
        IfCondition NotEqual(c1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
                val = StringToNumber(AST_GetData1(c1))
                IfCondition LessThan(val, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_Fit32(val), 0) ThenBlock: { ReturnValue(0) }
                ReturnValue(1)
            }
        }
        c0 = AST_GetChild(addr, 0)
        IfCondition NotEqual(c0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(c0), AST.NUMBER) ThenBlock: {
                val = StringToNumber(AST_GetData1(c0))
                IfCondition LessThan(val, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_Fit32(val), 0) ThenBlock: { ReturnValue(0) }
                ReturnValue(2)
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// FLAT WRITE: WRMEM_<w>(addr, value)
// Stores the low <w> bits of value at addr. The 8-byte form takes the
// fast paths below; narrow stores take the plain push path.
// =============================================================================
Function.CompileMem_Store {
    Input: node: Address
    Input: code: Integer
    Output: Integer
    Body: {
        arg0 = AST_GetChild(node, 0)    // address
        arg1 = AST_GetChild(node, 1)    // value
        store_size = MemPrim_Size(code)

        // A float home whose address is affine in an outer cursor stores
        // through r9. A named address already in r11 or r14 stores an
        // identifier straight to [reg+disp]. Anything else keeps the push path.
        IfCondition EqualTo(store_size, 8) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanSwapStore(arg0, arg1), 1) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_ScanPtrHit(arg0), 1) ThenBlock: {
                preg = ScanPtr.hit_reg
                pdisp = ScanPtr.hit_disp
                xs = -1
                IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: {
                    xs = Optimize_ScanFltSrc(arg1)
                    // The scan spilled this name and left it in the field.
                    // Storing that field onto itself reloads the old bits.
                    IfCondition LessThan(xs, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_ScanPtrRmFind(AST_GetData1(arg1)), 1) ThenBlock: {
                            IfCondition EqualTo(ScanPtr.hit_reg, preg) ThenBlock: {
                                IfCondition EqualTo(ScanPtr.hit_disp, pdisp) ThenBlock: {
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                }
                IfCondition GreaterEqual(xs, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanPtrRmFind(AST_GetData1(arg1)), 1) ThenBlock: {
                        IfCondition EqualTo(ScanPtr.hit_reg, preg) ThenBlock: {
                            IfCondition EqualTo(ScanPtr.hit_disp, pdisp) ThenBlock: {
                                IfCondition EqualTo(Optimize_ScanPtrHeld(preg), 1) ThenBlock: {
                                    // Delay only when this body does not
                                    // write the xmm. fieldop updates ix
                                    // then WRMEM; that store stays.
                                    wrote = 0
                                    IfCondition NotEqual(ScanPtr.loop_body, 0) ThenBlock: {
                                        wrote = Optimize_ScanFltParkWritten(ScanPtr.loop_body, AST_GetData1(arg1))
                                    }
                                    IfCondition EqualTo(wrote, 0) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                }
                            }
                        }
                    }
                    X86_MovsdIpXmm(preg, pdisp, xs)
                    ReturnValue(1)
                }
                gotv = Compile_Expression(arg1)
                IfCondition EqualTo(gotv, 0) ThenBlock: { ReturnValue(0) }
                Emit_MovRbxRax()
                X86_MovIpRbx(preg, pdisp)
                ReturnValue(1)
            }
            IfCondition EqualTo(store_size, 8) ThenBlock: {
                fused = Optimize_OutStore(arg0, arg1)
                IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
                fused = Optimize_AddrStore(arg0, arg1)
                IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
            }
        }

        // WRMEM_64(Add(base, Multiply(index, 1/2/4/8)), value)
        // when value is a simple identifier → index→rcx, val→rax,
        // MOV [r14+rcx*scale], rax.  Mirrors the RDMEM SIB load path.
        IfCondition EqualTo(store_size, 8) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg0), AST.CALL) ThenBlock: {
                IfCondition EqualTo(StringCompare(AST_GetData1(arg0), "Add"), 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetChildCount(arg0), 2) ThenBlock: {
                        sb_base = AST_GetChild(arg0, 0)
                        sb_off = AST_GetChild(arg0, 1)
                        IfCondition NotEqual(sb_off, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(sb_off), AST.CALL) ThenBlock: {
                                IfCondition EqualTo(StringCompare(AST_GetData1(sb_off), "Multiply"), 0) ThenBlock: {
                                    IfCondition EqualTo(AST_GetChildCount(sb_off), 2) ThenBlock: {
                                        sb_idx = AST_GetChild(sb_off, 0)
                                        sb_sc = AST_GetChild(sb_off, 1)
                                        IfCondition EqualTo(AST_GetType(sb_sc), AST.NUMBER) ThenBlock: {
                                            sb_sv = StringToNumber(AST_GetData1(sb_sc))
                                            sb_ok = 0
                                            IfCondition EqualTo(sb_sv, 1) ThenBlock: { sb_ok = 1 }
                                            IfCondition EqualTo(sb_sv, 2) ThenBlock: { sb_ok = 1 }
                                            IfCondition EqualTo(sb_sv, 4) ThenBlock: { sb_ok = 1 }
                                            IfCondition EqualTo(sb_sv, 8) ThenBlock: { sb_ok = 1 }
                                            IfCondition EqualTo(sb_ok, 1) ThenBlock: {
                                                sb_val_ok = 0
                                                IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: { sb_val_ok = 1 }
                                                IfCondition EqualTo(AST_GetType(arg1), AST.NUMBER) ThenBlock: { sb_val_ok = 1 }
                                                IfCondition EqualTo(sb_val_ok, 1) ThenBlock: {
                                                    IfCondition EqualTo(AST_GetType(sb_base), AST.IDENTIFIER) ThenBlock: {
                                                        sb_tab = 0
                                                        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
                                                            IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                                                                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sb_base), LoopHome.tab_name), 1) ThenBlock: {
                                                                    sb_tab = 1
                                                                }
                                                            }
                                                        }
                                                        Optimize_RcxDrop()
                                                        sb_scale = 0
                                                        IfCondition NotEqual(ScanPtr.scale_name, 0) ThenBlock: {
                                                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sb_base), ScanPtr.scale_name), 1) ThenBlock: {
                                                                sb_scale = 1
                                                            }
                                                        }
                                                        sb_ireg = 0
                                                        IfCondition EqualTo(AST_GetType(sb_idx), AST.IDENTIFIER) ThenBlock: {
                                                            sb_ireg = Optimize_ScanAddrBase(AST_GetData1(sb_idx))
                                                        }
                                                        sb_breg = Optimize_ScanAddrBase(AST_GetData1(sb_base))
                                                        IfCondition EqualTo(sb_breg, sb_ireg) ThenBlock: { sb_breg = 0 }
                                                        IfCondition NotEqual(sb_breg, 0) ThenBlock: {
                                                            IfCondition NotEqual(sb_ireg, 0) ThenBlock: {
                                                                sb_src = Optimize_ScanStoreSrc(arg1)
                                                                IfCondition GreaterEqual(sb_src, 0) ThenBlock: {
                                                                    LoopHome.ip_hit_reg = sb_breg
                                                                    X86_StRegSib(sb_src, sb_sv, sb_ireg)
                                                                    ReturnValue(1)
                                                                }
                                                                IfCondition EqualTo(Optimize_ScanStorePlain(arg1), 1) ThenBlock: {
                                                                    Compile_Expression(arg1)
                                                                    LoopHome.ip_hit_reg = sb_breg
                                                                    X86_StRaxSib(sb_sv, sb_ireg)
                                                                    ReturnValue(1)
                                                                }
                                                            }
                                                        }
                                                        IfCondition EqualTo(sb_scale, 1) ThenBlock: {
                                                            IfCondition NotEqual(sb_ireg, 0) ThenBlock: {
                                                                Compile_Expression(arg1)
                                                                LoopHome.ip_hit_reg = 14
                                                                X86_StRaxSib(sb_sv, sb_ireg)
                                                                ReturnValue(1)
                                                            }
                                                        }
                                                        sb_direct = 0
                                                        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
                                                            IfCondition EqualTo(AST_GetType(sb_idx), AST.IDENTIFIER) ThenBlock: {
                                                                IfCondition EqualTo(Optimize_IsIntHome(AST_GetData1(sb_idx)), 1) ThenBlock: {
                                                                    sb_direct = 1
                                                                }
                                                            }
                                                        }
                                                        sb_idx_reg = sb_ireg
                                                        IfCondition EqualTo(sb_idx_reg, 0) ThenBlock: {
                                                            IfCondition EqualTo(sb_direct, 1) ThenBlock: {
                                                                Emit_MovRcxR13()
                                                                sb_idx_reg = Reg.RCX
                                                            }
                                                        }
                                                        IfCondition EqualTo(sb_idx_reg, 0) ThenBlock: {
                                                            Compile_Expression(sb_idx)
                                                            avoid_i = 0
                                                            IfCondition EqualTo(sb_scale, 1) ThenBlock: { avoid_i = LeftShift(1, Reg.R14) }
                                                            IfCondition EqualTo(sb_tab, 1) ThenBlock: { avoid_i = LeftShift(1, Reg.R14) }
                                                            sb_idx_reg = Optimize_ScanPark(0, avoid_i)
                                                        }
                                                        sb_use_base = sb_breg
                                                        IfCondition EqualTo(sb_use_base, sb_idx_reg) ThenBlock: { sb_use_base = 0 }
                                                        IfCondition EqualTo(sb_scale, 1) ThenBlock: { sb_use_base = Reg.R14 }
                                                        IfCondition EqualTo(sb_tab, 1) ThenBlock: { sb_use_base = Reg.R14 }
                                                        IfCondition EqualTo(sb_use_base, 0) ThenBlock: {
                                                            IfCondition EqualTo(Optimize_ScanMatOwns(sb_idx_reg), 1) ThenBlock: {
                                                                Emit_MovRegReg(Reg.RAX, sb_idx_reg)
                                                                sb_idx_reg = Optimize_ScanPark(0, 0)
                                                            }
                                                            saved_scratch = ScanState.scratch
                                                            ScanState.scratch = BitwiseOr(saved_scratch, LeftShift(1, sb_idx_reg))
                                                            Compile_Expression(sb_base)
                                                            ScanState.scratch = saved_scratch
                                                            sb_use_base = Optimize_ScanPark(1, LeftShift(1, sb_idx_reg))
                                                        }
                                                        LoopHome.ip_hit_reg = sb_use_base
                                                        saved_scratch = ScanState.scratch
                                                        ScanState.scratch = BitwiseOr(saved_scratch, LeftShift(1, sb_idx_reg))
                                                        ScanState.scratch = BitwiseOr(ScanState.scratch, LeftShift(1, sb_use_base))
                                                        sb_plain = 0
                                                        IfCondition EqualTo(sb_scale, 1) ThenBlock: { sb_plain = 1 }
                                                        IfCondition EqualTo(Optimize_ScanStorePlain(arg1), 1) ThenBlock: { sb_plain = 1 }
                                                        IfCondition EqualTo(sb_plain, 1) ThenBlock: {
                                                            Compile_Expression(arg1)
                                                            ScanState.scratch = saved_scratch
                                                            X86_StRaxSib(sb_sv, sb_idx_reg)
                                                            ReturnValue(1)
                                                        }
                                                        Optimize_ScanPushReg(sb_use_base)
                                                        IfCondition NotEqual(sb_idx_reg, sb_use_base) ThenBlock: {
                                                            Optimize_ScanPushReg(sb_idx_reg)
                                                        }
                                                        Compile_Expression(arg1)
                                                        IfCondition NotEqual(sb_idx_reg, sb_use_base) ThenBlock: {
                                                            Optimize_ScanPopReg(sb_idx_reg)
                                                        }
                                                        Optimize_ScanPopReg(sb_use_base)
                                                        ScanState.scratch = saved_scratch
                                                        X86_StRaxSib(sb_sv, sb_idx_reg)
                                                        ReturnValue(1)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // WRMEM_64(Add(base, constant), value) keeps the constant as a
        // displacement. The base is pushed across the value because that
        // expression clobbers RAX. Narrow stores add the displacement
        // first; there is no byte or word [rax+disp] emitter.
        which = CompileMem_FieldAdd(arg0)
        IfCondition GreaterThan(which, 0) ThenBlock: {
            base_node = AST_GetChild(arg0, 0)
            disp_node = AST_GetChild(arg0, 1)
            IfCondition EqualTo(which, 2) ThenBlock: {
                base_node = AST_GetChild(arg0, 1)
                disp_node = AST_GetChild(arg0, 0)
            }
            disp = StringToNumber(AST_GetData1(disp_node))
            gotb = Compile_Expression(base_node)
            IfCondition EqualTo(gotb, 0) ThenBlock: { ReturnValue(0) }
            // A register or immediate value stores straight to [rax+disp].
            // Checked after the base: compiling it may have moved homes.
            fa_src = CompileMem_StoreSrc(arg1, store_size)
            IfCondition NotEqual(fa_src, -1) ThenBlock: {
                IfCondition And(GreaterEqual(disp, -2147483648), LessEqual(disp, 2147483647)) ThenBlock: {
                    CompileMem_EmitStore(store_size, fa_src, CompileMemSt.imm, Reg.RAX, -1, disp)
                    ReturnValue(1)
                }
            }
            IfCondition NotEqual(store_size, 8) ThenBlock: {
                IfCondition NotEqual(disp, 0) ThenBlock: {
                    Emit_AddRaxImm(disp)
                }
            }
            Emit_PushRax()
            gotv = Compile_Expression(arg1)
            IfCondition EqualTo(gotv, 0) ThenBlock: { ReturnValue(0) }
            Emit_MovRbxRax()
            Emit_PopRax()
            IfCondition EqualTo(store_size, 8) ThenBlock: {
                Emit_MovDerefRaxOffsetRbx(disp)
                ReturnValue(1)
            }
            IfCondition EqualTo(store_size, 1) ThenBlock: {
                Emit_MovByteDerefRaxBl()
                ReturnValue(1)
            }
            IfCondition EqualTo(store_size, 2) ThenBlock: {
                Emit_MovWordDerefRaxBx()
                ReturnValue(1)
            }
            IfCondition EqualTo(store_size, 4) ThenBlock: {
                Emit_MovDwordDerefRaxEbx()
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        
        // Compile address first, save on stack
        Compile_Expression(arg0)
        // A register or immediate value needs no evaluation: mov [rax], src.
        g_src = CompileMem_StoreSrc(arg1, store_size)
        IfCondition NotEqual(g_src, -1) ThenBlock: {
            CompileMem_EmitStore(store_size, g_src, CompileMemSt.imm, Reg.RAX, -1, 0)
            ReturnValue(1)
        }
        Emit_PushRax()
        
        // Compile value
        Compile_Expression(arg1)
        Emit_MovRbxRax()          // value in RBX
        
        // Pop address into RAX
        Emit_PopRax()
        
        // Store based on size
        IfCondition EqualTo(store_size, 1) ThenBlock: {
            Emit_MovByteDerefRaxBl()      // MOV [RAX], BL
        }
        IfCondition EqualTo(store_size, 2) ThenBlock: {
            Emit_MovWordDerefRaxBx()      // MOV [RAX], BX
        }
        IfCondition EqualTo(store_size, 4) ThenBlock: {
            Emit_MovDwordDerefRaxEbx()    // MOV [RAX], EBX
        }
        IfCondition EqualTo(store_size, 8) ThenBlock: {
            Emit_MovDerefRaxRbx()         // MOV [RAX], RBX
        }
        
        ReturnValue(1)
    }
}

// =============================================================================
// DIRECT STORES
// mov [base + index + disp], src with src a register or an immediate.
// size 1/2/4/8. index -1 for none. src -1 means the immediate imm (for size 8
// it must fit a signed imm32). Byte stores from rsp/rbp/rsi/rdi get a REX
// prefix so they name spl/bpl/sil/dil, not ah/ch/dh/bh.
// =============================================================================
Function.CompileMem_EmitStore {
    Input: size: Integer
    Input: src: Integer
    Input: imm: Integer
    Input: base: Integer
    Input: index: Integer
    Input: disp: Integer
    Body: {
        Listing_Open("MOV [mem], src")
        IfCondition EqualTo(size, 2) ThenBlock: { Emit_Byte(0x66) }
        rex = 0
        IfCondition EqualTo(size, 8) ThenBlock: { rex = 8 }
        IfCondition GreaterEqual(src, 8) ThenBlock: { rex = BitwiseOr(rex, 4) }
        IfCondition GreaterEqual(index, 8) ThenBlock: { rex = BitwiseOr(rex, 2) }
        IfCondition GreaterEqual(base, 8) ThenBlock: { rex = BitwiseOr(rex, 1) }
        need40 = 0
        IfCondition EqualTo(size, 1) ThenBlock: {
            IfCondition GreaterEqual(src, 4) ThenBlock: {
                IfCondition LessThan(src, 8) ThenBlock: { need40 = 1 }
            }
        }
        IfCondition Or(NotEqual(rex, 0), EqualTo(need40, 1)) ThenBlock: { Emit_Byte(BitwiseOr(0x40, rex)) }
        IfCondition GreaterEqual(src, 0) ThenBlock: {
            IfCondition EqualTo(size, 1) ThenBlock: { Emit_Byte(0x88) } ElseBlock: { Emit_Byte(0x89) }
        } ElseBlock: {
            IfCondition EqualTo(size, 1) ThenBlock: { Emit_Byte(0xC6) } ElseBlock: { Emit_Byte(0xC7) }
        }
        regf = 0
        IfCondition GreaterEqual(src, 0) ThenBlock: { regf = BitwiseAnd(src, 7) }
        b7 = BitwiseAnd(base, 7)
        md = 0
        IfCondition NotEqual(disp, 0) ThenBlock: { md = 2 }
        IfCondition EqualTo(disp, 0) ThenBlock: {
            IfCondition EqualTo(b7, 5) ThenBlock: { md = 1 }
        }
        IfCondition EqualTo(md, 2) ThenBlock: {
            IfCondition And(GreaterEqual(disp, -128), LessEqual(disp, 127)) ThenBlock: { md = 1 }
        }
        use_sib = 0
        IfCondition GreaterEqual(index, 0) ThenBlock: { use_sib = 1 }
        IfCondition EqualTo(b7, 4) ThenBlock: { use_sib = 1 }
        IfCondition EqualTo(use_sib, 1) ThenBlock: {
            Emit_Byte(BitwiseOr(BitwiseOr(LeftShift(md, 6), LeftShift(regf, 3)), 4))
            i7 = 4
            IfCondition GreaterEqual(index, 0) ThenBlock: { i7 = BitwiseAnd(index, 7) }
            Emit_Byte(BitwiseOr(LeftShift(i7, 3), b7))
        } ElseBlock: {
            Emit_Byte(BitwiseOr(BitwiseOr(LeftShift(md, 6), LeftShift(regf, 3)), b7))
        }
        IfCondition EqualTo(md, 1) ThenBlock: { Emit_Byte(BitwiseAnd(disp, 255)) }
        IfCondition EqualTo(md, 2) ThenBlock: { Emit_DWord(disp) }
        IfCondition LessThan(src, 0) ThenBlock: {
            IfCondition EqualTo(size, 1) ThenBlock: { Emit_Byte(BitwiseAnd(imm, 255)) }
            IfCondition EqualTo(size, 2) ThenBlock: {
                Emit_Byte(BitwiseAnd(imm, 255))
                Emit_Byte(BitwiseAnd(RightShift(imm, 8), 255))
            }
            IfCondition GreaterEqual(size, 4) ThenBlock: { Emit_DWord(imm) }
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
        Listing_Close()
    }
}

// A store source that needs no evaluation: the GPR a scan home holds
// (materialized), -2 for an immediate that fits the store (stored in
// CompileMemSt.imm), or -1.
FixedPool.CompileMemSt {
    "imm": Initialize=0, CanChange=True
}

Function.CompileMem_StoreSrc {
    Input: node: Address
    Input: size: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(-1) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.NUMBER) ThenBlock: {
            v = StringToNumber(AST_GetData1(node))
            IfCondition And(GreaterEqual(v, -2147483648), LessEqual(v, 2147483647)) ThenBlock: {
                CompileMemSt.imm = v
                ReturnValue(-2)
            }
            ReturnValue(-1)
        }
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            r = Optimize_ScanAddrBase(AST_GetData1(node))
            IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(-1) }
            IfCondition EqualTo(r, Reg.RAX) ThenBlock: { ReturnValue(-1) }
            IfCondition GreaterEqual(r, 16) ThenBlock: { ReturnValue(-1) }
            ReturnValue(r)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// ADDRESSOF
// AddressOf(identifier) - returns address of function or variable in RAX
// =============================================================================
Function.CompileMem_AddressOf {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[ERROR] AddressOf requires exactly 1 argument\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg_type = AST_GetType(arg0)
        
        IfCondition EqualTo(arg_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(arg0)
            
            // Try as user-defined function first
            func_label = Compile_FindFunction(name)
            IfCondition GreaterEqual(func_label, 0) ThenBlock: {
                // LEA RAX, [RIP + label]
                Emit_LeaRaxLabel(func_label)
                ReturnValue(1)
            }
            
            // Try as local/param variable
            offset = Scope_Resolve(name)
            IfCondition NotEqual(offset, 0) ThenBlock: {
                // LEA RAX, [RBP + offset]
                Emit_LeaRaxRbpOffset(offset)
                ReturnValue(1)
            }
            
            // Pool variables - not yet supported
            // Would need to resolve pool slot and use LEA RAX, [R15 + offset]
            
            PrintMessage("[ERROR] AddressOf: unknown identifier '")
            PrintMessage(name)
            PrintMessage("'\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        PrintMessage("[ERROR] AddressOf requires identifier argument\n")
        Compile.error = 1
        ReturnValue(0)
    }
}


// =============================================================================
// FLAT READ: RDMEM_<w>(addr)
// The 8-byte read takes the fast paths below. Narrow reads zero-extend,
// the S forms sign-extend, and both take the plain path.
// =============================================================================
Function.CompileMem_Load {
    Input: node: Address
    Input: code: Integer
    Output: Integer
    Body: {
        arg0 = AST_GetChild(node, 0)
        load_size = MemPrim_Size(code)
        IfCondition EqualTo(MemPrim_Signed(code), 1) ThenBlock: {
            Compile_Expression(arg0)
            CompileMem_LoadRax(load_size, 1)
            ReturnValue(1)
        }

        IfCondition EqualTo(load_size, 8) ThenBlock: {
            IfCondition EqualTo(Optimize_IpMatch(arg0), 1) ThenBlock: {
                X86_MovRaxIp(LoopHome.ip_hit_reg, LoopHome.ip_hit_disp)
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_ScanPtrHit(arg0), 1) ThenBlock: {
                X86_MovRaxIp(ScanPtr.hit_reg, ScanPtr.hit_disp)
                ReturnValue(1)
            }
            fused = Optimize_TryHomeDeref(arg0)
            IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
            fused = Optimize_AddrLoad(arg0)
            IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
        }

        // =============================================================
        // OPTIMIZATION: Scaled index addressing
        // Pattern: RDMEM_64(Add(base, Multiply(index, 1/2/4/8)))
        //   → MOV RAX, [RBX + RCX * scale]
        //
        // Also catches post-SHL form:
        // Pattern: RDMEM_64(Add(base, SHL(index, 0/1/2/3)))
        //   → same encoding
        // =============================================================
        IfCondition EqualTo(load_size, 8) ThenBlock: {
            // base[index * 2^k + disp], including a named index*stride local.
            IfCondition EqualTo(Optimize_TryStrideDeref(arg0), 1) ThenBlock: { ReturnValue(1) }
            // The scaled fallback writes rcx. The raw-offset note would be stale.
            Optimize_RcxDrop()
            arg0_type = AST_GetType(arg0)
            IfCondition EqualTo(arg0_type, AST.CALL) ThenBlock: {
                add_name = AST_GetData1(arg0)
                IfCondition EqualTo(StringCompare(add_name, "Add"), 0) ThenBlock: {
                    add_arg_count = AST_GetChildCount(arg0)
                    IfCondition EqualTo(add_arg_count, 2) ThenBlock: {
                        base_node = AST_GetChild(arg0, 0)
                        offset_node = AST_GetChild(arg0, 1)
                        
                        // Check if offset is Multiply(index, constant)
                        offset_type = AST_GetType(offset_node)
                        IfCondition EqualTo(offset_type, AST.CALL) ThenBlock: {
                            mul_name = AST_GetData1(offset_node)
                            IfCondition EqualTo(StringCompare(mul_name, "Multiply"), 0) ThenBlock: {
                                mul_arg_count = AST_GetChildCount(offset_node)
                                IfCondition EqualTo(mul_arg_count, 2) ThenBlock: {
                                    index_node = AST_GetChild(offset_node, 0)
                                    scale_node = AST_GetChild(offset_node, 1)
                                    
                                    // Scale must be a constant 1, 2, 4, or 8
                                    scale_type = AST_GetType(scale_node)
                                    IfCondition EqualTo(scale_type, AST.NUMBER) ThenBlock: {
                                        scale_str = AST_GetData1(scale_node)
                                        scale_val = StringToNumber(scale_str)
                                        
                                        is_valid_scale = 0
                                        IfCondition EqualTo(scale_val, 1) ThenBlock: { is_valid_scale = 1 }
                                        IfCondition EqualTo(scale_val, 2) ThenBlock: { is_valid_scale = 1 }
                                        IfCondition EqualTo(scale_val, 4) ThenBlock: { is_valid_scale = 1 }
                                        IfCondition EqualTo(scale_val, 8) ThenBlock: { is_valid_scale = 1 }
                                        
                                        IfCondition EqualTo(is_valid_scale, 1) ThenBlock: {
                                            // Constant-zero index → plain deref, no SIB.
                                            IfCondition EqualTo(AST_GetType(index_node), AST.NUMBER) ThenBlock: {
                                                IfCondition EqualTo(StringToNumber(AST_GetData1(index_node)), 0) ThenBlock: {
                                                    zero_tab = 0
                                                    IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
                                                        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                                                            IfCondition EqualTo(AST_GetType(base_node), AST.IDENTIFIER) ThenBlock: {
                                                                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base_node), LoopHome.tab_name), 1) ThenBlock: {
                                                                    zero_tab = 1
                                                                }
                                                            }
                                                        }
                                                    }
                                                    IfCondition EqualTo(zero_tab, 1) ThenBlock: {
                                                        Emit_MovRaxDerefR14()
                                                    } ElseBlock: {
                                                        Compile_Expression(base_node)
                                                        Emit_MovRaxDerefRax()
                                                    }
                                                    ReturnValue(1)
                                                }
                                            }
                                            // Index and base come from free scratch when they are
                                            // not already homes. rcx and r14 are the fallback.
                                            ld_direct = 0
                                            idx_reg = 0
                                            IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
                                                IfCondition EqualTo(AST_GetType(index_node), AST.IDENTIFIER) ThenBlock: {
                                                    IfCondition EqualTo(Optimize_IsIntHome(AST_GetData1(index_node)), 1) ThenBlock: {
                                                        Emit_MovRcxR13()
                                                        idx_reg = Reg.RCX
                                                        ld_direct = 1
                                                    }
                                                }
                                            }
                                            IfCondition EqualTo(ld_direct, 0) ThenBlock: {
                                                IfCondition EqualTo(AST_GetType(index_node), AST.IDENTIFIER) ThenBlock: {
                                                    sreg = Optimize_ScanAddrBase(AST_GetData1(index_node))
                                                    IfCondition NotEqual(sreg, 0) ThenBlock: {
                                                        idx_reg = sreg
                                                        ld_direct = 1
                                                    }
                                                }
                                            }
                                            IfCondition EqualTo(ld_direct, 0) ThenBlock: {
                                                Compile_Expression(index_node)
                                                idx_reg = Optimize_ScanPark(0, 0)
                                            }

                                            use_tab = 0
                                            IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
                                                IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                                                    IfCondition EqualTo(AST_GetType(base_node), AST.IDENTIFIER) ThenBlock: {
                                                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base_node), LoopHome.tab_name), 1) ThenBlock: {
                                                            use_tab = 1
                                                        }
                                                    }
                                                }
                                            }
                                            IfCondition EqualTo(use_tab, 1) ThenBlock: {
                                                IfCondition EqualTo(idx_reg, Reg.RCX) ThenBlock: {
                                                    X86_MovRaxDerefR14RcxScaled(scale_val)
                                                } ElseBlock: {
                                                    LoopHome.ip_hit_reg = Reg.R14
                                                    X86_MovRaxSib(scale_val, idx_reg)
                                                }
                                                ReturnValue(1)
                                            }
                                            breg = 0
                                            IfCondition EqualTo(AST_GetType(base_node), AST.IDENTIFIER) ThenBlock: {
                                                breg = Optimize_ScanAddrBase(AST_GetData1(base_node))
                                            }
                                            IfCondition EqualTo(breg, idx_reg) ThenBlock: { breg = 0 }
                                            IfCondition EqualTo(breg, 0) ThenBlock: {
                                                IfCondition EqualTo(AST_GetType(base_node), AST.IDENTIFIER) ThenBlock: {
                                                    IfCondition NotEqual(ScanPtr.scale_name, 0) ThenBlock: {
                                                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base_node), ScanPtr.scale_name), 1) ThenBlock: {
                                                            breg = 14
                                                        }
                                                    }
                                                }
                                            }
                                            IfCondition NotEqual(breg, 0) ThenBlock: {
                                                LoopHome.ip_hit_reg = breg
                                            } ElseBlock: {
                                                // Compiling the base can reseed the index home.
                                                // Copy that home into a free scratch first.
                                                IfCondition EqualTo(Optimize_ScanMatOwns(idx_reg), 1) ThenBlock: {
                                                    Emit_MovRegReg(Reg.RAX, idx_reg)
                                                    idx_reg = Optimize_ScanPark(0, 0)
                                                }
                                                saved_scratch = ScanState.scratch
                                                ScanState.scratch = BitwiseOr(saved_scratch, LeftShift(1, idx_reg))
                                                Compile_Expression(base_node)
                                                ScanState.scratch = saved_scratch
                                                breg = Optimize_ScanPark(1, LeftShift(1, idx_reg))
                                                LoopHome.ip_hit_reg = breg
                                            }
                                            X86_MovRaxSib(scale_val, idx_reg)
                                            ReturnValue(1)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // =============================================================
        // END OPTIMIZATION
        // =============================================================

        // RDMEM_64(Add(base, constant)) is MOV RAX, [base+disp].
        // The scaled and stride paths above already took index*scale.
        which = CompileMem_FieldAdd(arg0)
        IfCondition GreaterThan(which, 0) ThenBlock: {
            base_node = AST_GetChild(arg0, 0)
            disp_node = AST_GetChild(arg0, 1)
            IfCondition EqualTo(which, 2) ThenBlock: {
                base_node = AST_GetChild(arg0, 1)
                disp_node = AST_GetChild(arg0, 0)
            }
            disp = StringToNumber(AST_GetData1(disp_node))
            gotb = Compile_Expression(base_node)
            IfCondition EqualTo(gotb, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(load_size, 8) ThenBlock: {
                Emit_MovRaxDerefRaxOffset(disp)
                ReturnValue(1)
            }
            IfCondition NotEqual(disp, 0) ThenBlock: {
                Emit_AddRaxImm(disp)
            }
            IfCondition EqualTo(load_size, 1) ThenBlock: {
                Emit_MovzxRaxByteDerefRax()
                ReturnValue(1)
            }
            IfCondition EqualTo(load_size, 2) ThenBlock: {
                Emit_MovzxRaxWordDerefRax()
                ReturnValue(1)
            }
            IfCondition EqualTo(load_size, 4) ThenBlock: {
                Emit_MovEaxDerefRax()
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        
        // Standard path: compile address, then load
        Compile_Expression(arg0)
        
        IfCondition EqualTo(load_size, 1) ThenBlock: {
            Emit_MovzxRaxByteDerefRax()
        }
        IfCondition EqualTo(load_size, 2) ThenBlock: {
            Emit_MovzxRaxWordDerefRax()
        }
        IfCondition EqualTo(load_size, 4) ThenBlock: {
            Emit_MovEaxDerefRax()
        }
        IfCondition EqualTo(load_size, 8) ThenBlock: {
            Emit_MovRaxDerefRax()
        }
        
        ReturnValue(1)
    }
}

// RAX = size bytes at [RAX], zero- or sign-extended to 64 bits.
Function.CompileMem_LoadRax {
    Input: size: Integer
    Input: sgn: Integer
    Body: {
        IfCondition EqualTo(sgn, 1) ThenBlock: {
            IfCondition EqualTo(size, 1) ThenBlock: { Emit_MovsxRaxByteDerefRax() }
            IfCondition EqualTo(size, 2) ThenBlock: { Emit_MovsxRaxWordDerefRax() }
            IfCondition EqualTo(size, 4) ThenBlock: { Emit_MovsxdRaxDerefRax() }
            ReturnValue(0)
        }
        IfCondition EqualTo(size, 1) ThenBlock: { Emit_MovzxRaxByteDerefRax() }
        IfCondition EqualTo(size, 2) ThenBlock: { Emit_MovzxRaxWordDerefRax() }
        IfCondition EqualTo(size, 4) ThenBlock: { Emit_MovEaxDerefRax() }
        IfCondition EqualTo(size, 8) ThenBlock: { Emit_MovRaxDerefRax() }
    }
}

// =============================================================================
// RDMEM_IO_<w>(addr) / WRMEM_IO_<w>(addr, value)
// The parser folded (base, offset) into one Add address. One access of
// exactly this width, in source order. No fast path is tried, and the
// optimizer cannot see through the name, so nothing caches, hoists,
// merges, or drops it. The store follows WRMEM's plain path:
// address, push, value, rbx, pop, store.
// =============================================================================
Function.CompileMem_IO {
    Input: node: Address
    Input: code: Integer
    Output: Integer
    Body: {
        op = MemPrim_Op(code)
        size = MemPrim_Size(code)
        n = AST_GetChildCount(node)
        IfCondition EqualTo(op, 1) ThenBlock: {
            IfCondition NotEqual(n, 1) ThenBlock: {
                PrintMessage("[ERROR] RDMEM_IO takes (address) or (base, offset)\n")
                Compile.error = 1
                ReturnValue(0)
            }
            got = Compile_Expression(AST_GetChild(node, 0))
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            CompileMem_LoadRax(size, MemPrim_Signed(code))
            ReturnValue(1)
        }
        IfCondition NotEqual(n, 2) ThenBlock: {
            PrintMessage("[ERROR] WRMEM_IO takes (address, value) or (base, offset, value)\n")
            Compile.error = 1
            ReturnValue(0)
        }
        got = Compile_Expression(AST_GetChild(node, 0))
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        Emit_PushRax()
        got = Compile_Expression(AST_GetChild(node, 1))
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovRbxRax()
        Emit_PopRax()
        IfCondition EqualTo(size, 1) ThenBlock: { Emit_MovByteDerefRaxBl() }
        IfCondition EqualTo(size, 2) ThenBlock: { Emit_MovWordDerefRaxBx() }
        IfCondition EqualTo(size, 4) ThenBlock: { Emit_MovDwordDerefRaxEbx() }
        IfCondition EqualTo(size, 8) ThenBlock: { Emit_MovDerefRaxRbx() }
        ReturnValue(1)
    }
}

// =============================================================================
// BYTE-AT READ: RDMEM_8(base, offset), zero-extended to RAX
// =============================================================================
Function.CompileMem_ByteAt {
    Input: node: Address
    Output: Integer
    Body: {
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        IfCondition EqualTo(Optimize_ScanByteGet(node), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryEmitByteAt(node), 1) ThenBlock: { ReturnValue(1) }
        // Offset first, then base. MOVZX rax, byte [rax+rbx] skips the
        // push/pop/add of the two-scratch path. That holds only while the
        // base is a name or a number: a computed base such as
        // Add(P.buf, P.pos) can use rbx as scratch and overwrite the
        // offset, which read [buf + pos + pos] (RDMEM_8(Add(b, p)), whose
        // offset is 0, hit this in Library.JSON).
        bt = AST_GetType(arg0)
        IfCondition Or(EqualTo(bt, AST.IDENTIFIER), EqualTo(bt, AST.NUMBER)) ThenBlock: {
            Compile_Expression(arg1)
            Emit_MovRbxRax()
            Compile_Expression(arg0)
            X86_SibByte(1, 0, 3)
            ReturnValue(1)
        }
        Compile_Expression(arg1)
        Emit_PushRax()
        Compile_Expression(arg0)
        Emit_PopRcx()
        Emit_AddRaxRcx()
        Emit_MovzxRaxByteDerefRax()
        ReturnValue(1)
    }
}

// =============================================================================
// BYTE-AT WRITE: WRMEM_8(base, offset, value) stores the low byte
// =============================================================================
Function.CompileMem_ByteSetAt {
    Input: node: Address
    Output: Integer
    Body: {
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        arg2 = AST_GetChild(node, 2)
        IfCondition EqualTo(Optimize_ScanByteSet(node), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryEmitByteSetAt(node), 1) ThenBlock: { ReturnValue(1) }
        Optimize_IholdFlush()
        // WRMEM_8(base, off, v) without the stack. rcx and rdi are free for the
        // whole statement: ScanOpClobber charges every byte store with both,
        // so no name used here has its home there. v is a register or an
        // immediate, or is computed and parked in rdi (nested picks skip it).
        // off is a constant, a register, or computed into rax. base is a
        // register, or a plain name loaded into rax after off moves to rcx.
        bs_go = 1
        IfCondition EqualTo(CompileFunc_HasCalls(arg0), 1) ThenBlock: { bs_go = 0 }
        IfCondition EqualTo(CompileFunc_HasCalls(arg1), 1) ThenBlock: { bs_go = 0 }
        IfCondition EqualTo(CompileFunc_HasCalls(arg2), 1) ThenBlock: { bs_go = 0 }
        bs_bname = 0
        IfCondition EqualTo(AST_GetType(arg0), AST.IDENTIFIER) ThenBlock: { bs_bname = AST_GetData1(arg0) } ElseBlock: { bs_go = 0 }
        IfCondition EqualTo(bs_go, 1) ThenBlock: {
            bs_src = CompileMem_StoreSrc(arg2, 1)
            bs_imm = CompileMemSt.imm
            IfCondition EqualTo(bs_src, Reg.RCX) ThenBlock: { bs_src = -1 }
            IfCondition EqualTo(bs_src, Reg.RDI) ThenBlock: { bs_src = -1 }
            bs_saved_depth = Compile.binary_op_depth
            IfCondition EqualTo(bs_src, -1) ThenBlock: {
                got = Compile_Expression(arg2)
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
                Emit_MovRegReg(Reg.RDI, Reg.RAX)
                bs_src = Reg.RDI
                Compile.binary_op_depth = BitwiseOr(bs_saved_depth, LeftShift(1, Reg.RDI))
            }
            // Offset
            bs_idx = -1
            bs_disp = 0
            bs_off_done = 0
            IfCondition EqualTo(AST_GetType(arg1), AST.NUMBER) ThenBlock: {
                bs_disp = StringToNumber(AST_GetData1(arg1))
                IfCondition And(GreaterEqual(bs_disp, -2147483648), LessEqual(bs_disp, 2147483647)) ThenBlock: { bs_off_done = 1 }
            }
            IfCondition EqualTo(bs_off_done, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: {
                    r1 = Optimize_ScanAddrBase(AST_GetData1(arg1))
                    IfCondition And(NotEqual(r1, 0), LessThan(r1, 16)) ThenBlock: {
                        IfCondition And(NotEqual(r1, Reg.RSP), NotEqual(r1, Reg.RCX)) ThenBlock: {
                            IfCondition NotEqual(r1, Reg.RDI) ThenBlock: {
                                bs_idx = r1
                                bs_off_done = 1
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(bs_off_done, 0) ThenBlock: {
                bs_disp = 0
                got = Compile_Expression(arg1)
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
                bs_idx = Reg.RAX
            }
            Compile.binary_op_depth = bs_saved_depth
            // Base, checked after everything above was compiled
            bs_base = Optimize_ScanAddrBase(bs_bname)
            IfCondition Or(EqualTo(bs_base, 0), GreaterEqual(bs_base, 16)) ThenBlock: { bs_base = -1 }
            IfCondition EqualTo(bs_base, Reg.RCX) ThenBlock: { bs_base = -1 }
            IfCondition EqualTo(bs_base, Reg.RDI) ThenBlock: { bs_base = -1 }
            IfCondition EqualTo(bs_base, -1) ThenBlock: {
                IfCondition EqualTo(bs_idx, Reg.RAX) ThenBlock: {
                    Emit_MovRegReg(Reg.RCX, Reg.RAX)
                    bs_idx = Reg.RCX
                }
                got = Compile_Expression(arg0)
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
                bs_base = Reg.RAX
            }
            // A register index read before the value or base compiled: still there?
            IfCondition GreaterEqual(bs_idx, 0) ThenBlock: {
                IfCondition NotEqual(bs_idx, Reg.RAX) ThenBlock: {
                    IfCondition NotEqual(bs_idx, Reg.RCX) ThenBlock: {
                        IfCondition NotEqual(Optimize_ScanAddrBase(AST_GetData1(arg1)), bs_idx) ThenBlock: {
                            // Lost it. rcx is free: reload the offset there unless rax
                            // is the base we just loaded and the offset needs rax.
                            IfCondition EqualTo(bs_base, Reg.RAX) ThenBlock: { Emit_MovRegReg(Reg.RCX, Reg.RAX) bs_base = Reg.RCX }
                            got = Compile_Expression(arg1)
                            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
                            bs_idx = Reg.RAX
                        }
                    }
                }
            }
            // A register value read before the offset and base compiled: still there?
            IfCondition GreaterEqual(bs_src, 0) ThenBlock: {
                IfCondition NotEqual(bs_src, Reg.RDI) ThenBlock: {
                    IfCondition NotEqual(Optimize_ScanAddrBase(AST_GetData1(arg2)), bs_src) ThenBlock: {
                        rax_used = 0
                        IfCondition EqualTo(bs_base, Reg.RAX) ThenBlock: { rax_used = 1 }
                        IfCondition EqualTo(bs_idx, Reg.RAX) ThenBlock: { rax_used = 1 }
                        IfCondition EqualTo(rax_used, 1) ThenBlock: {
                            rcx_used = 0
                            IfCondition EqualTo(bs_base, Reg.RCX) ThenBlock: { rcx_used = 1 }
                            IfCondition EqualTo(bs_idx, Reg.RCX) ThenBlock: { rcx_used = 1 }
                            IfCondition EqualTo(rcx_used, 1) ThenBlock: {
                                Emit_MovRegReg(Reg.RDI, Reg.RAX)
                                IfCondition EqualTo(bs_base, Reg.RAX) ThenBlock: { bs_base = Reg.RDI }
                                IfCondition EqualTo(bs_idx, Reg.RAX) ThenBlock: { bs_idx = Reg.RDI }
                            } ElseBlock: {
                                Emit_MovRegReg(Reg.RCX, Reg.RAX)
                                IfCondition EqualTo(bs_base, Reg.RAX) ThenBlock: { bs_base = Reg.RCX }
                                IfCondition EqualTo(bs_idx, Reg.RAX) ThenBlock: { bs_idx = Reg.RCX }
                            }
                        }
                        got = Compile_Expression(arg2)
                        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
                        bs_src = Reg.RAX
                    }
                }
            }
            CompileMem_EmitStore(1, bs_src, bs_imm, bs_base, bs_idx, bs_disp)
            ReturnValue(1)
        }
        // Compile value first, save
        Compile_Expression(arg2)
        Emit_PushRax()
        
        // Compile offset, save
        Compile_Expression(arg1)
        Emit_PushRax()
        
        // Compile address
        Compile_Expression(arg0)
        // RAX = address
        
        // Pop the offset into RCX. RBX is a value home under linear
        // scan. POP rbx spills that home and clears its mat bit, but
        // the loop header was already emitted as a read of rbx, so the
        // next trip sees the offset (lz4 seed -> out 296208).
        Emit_PopRcx()
        
        // Add offset to address: RAX = addr + offset
        Emit_AddRaxRcx()
        
        // Move target address to RDI
        Emit_MovRdiRax()
        
        // Pop value into RAX (will use AL)
        Emit_PopRax()
        
        // MOV [RDI], AL
        Emit_MovByteDerefRdiAl()
        
        ReturnValue(1)
    }
}

// =============================================================================
// MEMORYCOPY
// MemoryCopy(dest, src, count) - copies count bytes from src to dest.
// A literal count of 0..16 is straight-line 8/4/2/1 moves. A variable
// count uses the 64-byte and 16-byte SSE loops, then one overlapping
// move for the tail. Counts under 16 never enter those loops. RAX stays
// the dest pointer, including when count is 0. RSI, RDI, and RCX are
// restored. Forward only.
// =============================================================================

// dest is in rdi, src is in rsi. n is a literal 1..16. Clobbers rax.
Function.CompileMem_CopyFixed {
    Input: n: Integer
    Body: {
        off = 0
        left = n
        WhileLoop GreaterEqual(left, 8) {
            X86_CopyGpDisp(8, off)
            off = Add(off, 8)
            left = Subtract(left, 8)
        }
        IfCondition GreaterEqual(left, 4) ThenBlock: {
            X86_CopyGpDisp(4, off)
            off = Add(off, 4)
            left = Subtract(left, 4)
        }
        IfCondition GreaterEqual(left, 2) ThenBlock: {
            X86_CopyGpDisp(2, off)
            off = Add(off, 2)
            left = Subtract(left, 2)
        }
        IfCondition GreaterEqual(left, 1) ThenBlock: {
            X86_CopyGpDisp(1, off)
        }
        ReturnValue(0)
    }
}

Function.CompileMem_MemoryCopy {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            PrintMessage("[ERROR] MemoryCopy requires 3 arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        arg2 = AST_GetChild(node, 2)

        Optimize_XmmKill()

        // Save registers clobbered by the copy (RSI, RDI, RCX)
        Emit_PushRsi()
        Emit_PushRdi()
        Emit_PushRcx()

        // Compile dest, save on stack
        Compile_Expression(arg0)
        Emit_PushRax()

        // Compile src, save on stack
        Compile_Expression(arg1)
        Emit_PushRax()

        // Compile count
        Compile_Expression(arg2)
        Emit_MovRcxRax()          // count in RCX

        // Pop src into RSI
        Emit_PopRax()
        Emit_MovRsiRax()

        // Pop dest into RDI. RAX stays the dest pointer.
        Emit_PopRax()
        Emit_MovRdiRax()

        // A fixed fragment is moves only. The copies use rax, so the
        // dest pointer sits on the stack until they finish.
        IfCondition EqualTo(AST_GetType(arg2), AST.NUMBER) ThenBlock: {
            nfix = StringToNumber(AST_GetData1(arg2))
            IfCondition GreaterEqual(nfix, 0) ThenBlock: {
                IfCondition LessEqual(nfix, 16) ThenBlock: {
                    IfCondition GreaterThan(nfix, 0) ThenBlock: {
                        Emit_PushRax()
                        CompileMem_CopyFixed(nfix)
                        Emit_PopRax()
                    }
                    Emit_PopRcx()
                    Emit_PopRdi()
                    Emit_PopRsi()
                    ReturnValue(1)
                }
            }
        }

        wide_loop = Emit_CreateLabel()
        sse_loop = Emit_CreateLabel()
        tail = Emit_CreateLabel()
        small = Emit_CreateLabel()
        lt8 = Emit_CreateLabel()
        lt4 = Emit_CreateLabel()
        after = Emit_CreateLabel()
        done_label = Emit_CreateLabel()

        Emit_TestRcxRcx()
        Emit_Je(done_label)

        // Every remaining copy clobbers rax. The pointer comes back at after.
        Emit_PushRax()

        Trans_Asm("CMP rcx, 16")
        Emit_Jb(small)

        Emit_MarkLabel(wide_loop)
        Trans_Asm("CMP rcx, 64")
        Emit_Jb(sse_loop)
        X86_MOVDQU_CopyDisp(0)
        X86_MOVDQU_CopyDisp(16)
        X86_MOVDQU_CopyDisp(32)
        X86_MOVDQU_CopyDisp(48)
        Trans_Asm("ADD rsi, 64")
        Trans_Asm("ADD rdi, 64")
        Trans_Asm("SUB rcx, 64")
        Emit_Jmp(wide_loop)

        Emit_MarkLabel(sse_loop)
        Trans_Asm("CMP rcx, 16")
        Emit_Jb(tail)
        X86_MOVDQU_XMM0_DerefRSI()
        X86_MOVDQU_DerefRDI_XMM0()
        Trans_Asm("ADD rsi, 16")
        Trans_Asm("ADD rdi, 16")
        Trans_Asm("SUB rcx, 16")
        Emit_Jmp(sse_loop)

        // Remainder 1..15 after at least one 16-byte chunk. One MOVDQU
        // of the last 16 bytes covers it. rcx == 0 skips the load.
        Emit_MarkLabel(tail)
        Emit_TestRcxRcx()
        Emit_Je(after)
        X86_CopyOverlap16()
        Emit_Jmp(after)

        // 1..15 bytes and no earlier chunk, so the overlap must not
        // read before the buffer. Head plus a tail that ends at rcx.
        Emit_MarkLabel(small)
        Trans_Asm("CMP rcx, 8")
        Emit_Jb(lt8)
        X86_CopyGpDisp(8, 0)
        X86_CopyTailIdx(8)
        Emit_Jmp(after)

        Emit_MarkLabel(lt8)
        Trans_Asm("CMP rcx, 4")
        Emit_Jb(lt4)
        X86_CopyGpDisp(4, 0)
        X86_CopyTailIdx(4)
        Emit_Jmp(after)

        Emit_MarkLabel(lt4)
        X86_CopyGpDisp(1, 0)
        Trans_Asm("CMP rcx, 1")
        Emit_Je(after)
        X86_CopyTailIdx(1)
        Trans_Asm("CMP rcx, 2")
        Emit_Je(after)
        X86_CopyGpDisp(1, 1)

        Emit_MarkLabel(after)
        Emit_PopRax()

        Emit_MarkLabel(done_label)
        Emit_PopRcx()
        Emit_PopRdi()
        Emit_PopRsi()

        ReturnValue(1)
    }
}

// =============================================================================
// MEMORYSET
// MemorySet(dest, value, count) - sets count bytes at dest to value
// =============================================================================
Function.CompileMem_MemorySet {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            PrintMessage("[ERROR] MemorySet requires 3 arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        arg2 = AST_GetChild(node, 2)
        
        // Save registers clobbered by REP STOSB (RDI, RCX)
        Emit_PushRdi()
        Emit_PushRcx()

        // Compile dest, save on stack
        Compile_Expression(arg0)
        Emit_PushRax()

        // Compile value
        Compile_Expression(arg1)
        Emit_PushRax()

        // Compile count
        Compile_Expression(arg2)
        Emit_MovRcxRax()          // count in RCX

        // Pop value into RAX, save to RBX
        Emit_PopRax()
        Emit_MovRbxRax()          // Save value in RBX (BL = byte)

        // Pop dest into RDI
        Emit_PopRax()
        Emit_MovRdiRax()

        // Restore value to RAX (AL used by STOSB)
        Emit_MovRaxRbx()

        // CLD + REP STOSB (CLD ensures forward direction)
        Emit_Cld()
        Emit_RepStosb()

        // Restore clobbered registers
        Emit_PopRcx()
        Emit_PopRdi()

        ReturnValue(1)
    }
}