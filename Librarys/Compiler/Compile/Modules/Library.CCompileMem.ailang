// Library.CCompileMem.ailang
// Memory operations compiler module for the AILang self-hosting compiler
// Handles: Allocate, Deallocate, StoreValue, Dereference, GetByte, SetByte, MemoryCopy, MemorySet

LibraryImport.Arena

LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch

// =============================================================================
// DISPATCHER
// =============================================================================
Function.CompileMem_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        func_name = AST_GetData1(node)
        
        IfCondition EqualTo(StringCompare(func_name, "Allocate"), 0) ThenBlock: {
            ReturnValue(CompileMem_Allocate(node))
        }
        
        IfCondition EqualTo(StringCompare(func_name, "Deallocate"), 0) ThenBlock: {
            ReturnValue(CompileMem_Deallocate(node))
        }
        
        IfCondition EqualTo(StringCompare(func_name, "StoreValue"), 0) ThenBlock: {
            ReturnValue(CompileMem_StoreValue(node))
        }
        
        IfCondition EqualTo(StringCompare(func_name, "Dereference"), 0) ThenBlock: {
            ReturnValue(CompileMem_Dereference(node))
        }
        
        IfCondition EqualTo(StringCompare(func_name, "GetByte"), 0) ThenBlock: {
            ReturnValue(CompileMem_GetByte(node))
        }
        
        IfCondition EqualTo(StringCompare(func_name, "SetByte"), 0) ThenBlock: {
            ReturnValue(CompileMem_SetByte(node))
        }
        
        IfCondition EqualTo(StringCompare(func_name, "MemoryCopy"), 0) ThenBlock: {
            ReturnValue(CompileMem_MemoryCopy(node))
        }
        
        IfCondition EqualTo(StringCompare(func_name, "MemorySet"), 0) ThenBlock: {
            ReturnValue(CompileMem_MemorySet(node))
        }
        
        // Add to CompileMem_TryCompile dispatcher:
        IfCondition EqualTo(StringCompare(func_name, "AddressOf"), 0) ThenBlock: {
            ReturnValue(CompileMem_AddressOf(node))
        }


        // Not a memory operation
        ReturnValue(0)
    }
}

// =============================================================================
// ALLOCATE - Arena-backed version
// Allocate(size) - calls Arena_Alloc, returns address in RAX
// =============================================================================
Function.CompileMem_Allocate {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[ERROR] Allocate requires 1 argument\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        // Compile size argument - result in RAX
        Compile_Expression(arg0)
        
        // Find Arena_Alloc function
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            PrintMessage("[ERROR] Arena_Alloc not found\n")
            PrintMessage("        Ensure LibraryImport.Arena is included\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Save RSP in R12 (callee-saved), align stack to 16 bytes
        Emit_MovRegReg(Reg.R12, Reg.RSP)
        Emit_AndRspImm8(240)
        
        // Size is first argument (RDI)
        Emit_MovRdiRax()
        
        // Call Arena_Alloc
        Emit_Call(arena_label)
        
        // Restore RSP
        Emit_MovRegReg(Reg.RSP, Reg.R12)
        
        // RAX now contains allocated address
        ReturnValue(1)
    }
}

// =============================================================================
// DEALLOCATE - Arena-backed version
// Deallocate(addr, size) - calls Arena_Free
// =============================================================================
Function.CompileMem_Deallocate {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[ERROR] Deallocate requires 2 arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Find Arena_Free function
        arena_free_label = Compile_FindFunction("Arena_Free")
        IfCondition LessThan(arena_free_label, 0) ThenBlock: {
            PrintMessage("[ERROR] Arena_Free not found\n")
            PrintMessage("        Ensure LibraryImport.Arena is included\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Compile ptr argument first, save on stack
        Compile_Expression(arg0)
        Emit_PushRax()
        
        // Compile size argument
        Compile_Expression(arg1)
        Emit_MovRsiRax()          // Size as second arg (RSI)
        
        // Pop ptr into RAX, then move to RDI (first arg)
        Emit_PopRax()
        Emit_MovRdiRax()
        
        // Save RSP in R12 (callee-saved), align stack to 16 bytes
        Emit_MovRegReg(Reg.R12, Reg.RSP)
        Emit_AndRspImm8(240)
        
        // Call Arena_Free
        Emit_Call(arena_free_label)
        
        // Restore RSP
        Emit_MovRegReg(Reg.RSP, Reg.R12)
        
        ReturnValue(1)
    }
}

// =============================================================================
// STOREVALUE
// StoreValue(addr, value) - stores value at address
// StoreValue(addr, value, size_hint) - stores with explicit size
// size_hint: "byte", "word", "dword", "qword" (default)
// =============================================================================
Function.CompileMem_StoreValue {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        
        // Accept 2 or 3 arguments
        IfCondition LessThan(arg_count, 2) ThenBlock: {
            PrintMessage("[ERROR] StoreValue requires at least 2 arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }
        IfCondition GreaterThan(arg_count, 3) ThenBlock: {
            PrintMessage("[ERROR] StoreValue accepts at most 3 arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)    // address
        arg1 = AST_GetChild(node, 1)    // value
        
        // Default size = 8 (qword)
        store_size = 8
        
        // Check for size hint (3rd argument)
        IfCondition EqualTo(arg_count, 3) ThenBlock: {
            arg2 = AST_GetChild(node, 2)
            hint_str = AST_GetData1(arg2)
            
            IfCondition EqualTo(StringCompare(hint_str, "byte"), 0) ThenBlock: {
                store_size = 1
            }
            IfCondition EqualTo(StringCompare(hint_str, "word"), 0) ThenBlock: {
                store_size = 2
            }
            IfCondition EqualTo(StringCompare(hint_str, "dword"), 0) ThenBlock: {
                store_size = 4
            }
            IfCondition EqualTo(StringCompare(hint_str, "qword"), 0) ThenBlock: {
                store_size = 8
            }
        }
        
        PrintMessage("[MEM] StoreValue size: ")
        PrintNumber(store_size)
        PrintMessage("\n")
        
        // Compile address first, save on stack
        Compile_Expression(arg0)
        Emit_PushRax()
        
        // Compile value
        Compile_Expression(arg1)
        Emit_MovRbxRax()          // value in RBX
        
        // Pop address into RAX
        Emit_PopRax()
        
        // Store based on size
        IfCondition EqualTo(store_size, 1) ThenBlock: {
            Emit_MovByteDerefRaxBl()      // MOV [RAX], BL
        }
        IfCondition EqualTo(store_size, 2) ThenBlock: {
            Emit_MovWordDerefRaxBx()      // MOV [RAX], BX
        }
        IfCondition EqualTo(store_size, 4) ThenBlock: {
            Emit_MovDwordDerefRaxEbx()    // MOV [RAX], EBX
        }
        IfCondition EqualTo(store_size, 8) ThenBlock: {
            Emit_MovDerefRaxRbx()         // MOV [RAX], RBX
        }
        
        ReturnValue(1)
    }
}

// =============================================================================
// ADDRESSOF
// AddressOf(identifier) - returns address of function or variable in RAX
// =============================================================================
Function.CompileMem_AddressOf {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[ERROR] AddressOf requires exactly 1 argument\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg_type = AST_GetType(arg0)
        
        IfCondition EqualTo(arg_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(arg0)
            
            // Try as user-defined function first
            func_label = Compile_FindFunction(name)
            IfCondition GreaterEqual(func_label, 0) ThenBlock: {
                // LEA RAX, [RIP + label]
                Emit_LeaRaxLabel(func_label)
                PrintMessage("[ADDRESSOF] Function '")
                PrintMessage(name)
                PrintMessage("' -> label ")
                PrintNumber(func_label)
                PrintMessage("\n")
                ReturnValue(1)
            }
            
            // Try as local/param variable
            offset = Scope_Resolve(name)
            IfCondition NotEqual(offset, 0) ThenBlock: {
                // LEA RAX, [RBP + offset]
                Emit_LeaRaxRbpOffset(offset)
                PrintMessage("[ADDRESSOF] Variable '")
                PrintMessage(name)
                PrintMessage("' -> [RBP + ")
                PrintNumber(offset)
                PrintMessage("]\n")
                ReturnValue(1)
            }
            
            // Pool variables - not yet supported
            // Would need to resolve pool slot and use LEA RAX, [R15 + offset]
            
            PrintMessage("[ERROR] AddressOf: unknown identifier '")
            PrintMessage(name)
            PrintMessage("'\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        PrintMessage("[ERROR] AddressOf requires identifier argument\n")
        Compile.error = 1
        ReturnValue(0)
    }
}


Function.CompileMem_Dereference {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        
        IfCondition LessThan(arg_count, 1) ThenBlock: {
            PrintMessage("[ERROR] Dereference requires at least 1 argument\n")
            Compile.error = 1
            ReturnValue(0)
        }
        IfCondition GreaterThan(arg_count, 2) ThenBlock: {
            PrintMessage("[ERROR] Dereference accepts at most 2 arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        // Default size = 8 (qword)
        load_size = 8
        
        // Check for size hint (2nd argument)
        IfCondition EqualTo(arg_count, 2) ThenBlock: {
            arg1 = AST_GetChild(node, 1)
            hint_str = AST_GetData1(arg1)
            
            IfCondition EqualTo(StringCompare(hint_str, "byte"), 0) ThenBlock: {
                load_size = 1
            }
            IfCondition EqualTo(StringCompare(hint_str, "word"), 0) ThenBlock: {
                load_size = 2
            }
            IfCondition EqualTo(StringCompare(hint_str, "dword"), 0) ThenBlock: {
                load_size = 4
            }
            IfCondition EqualTo(StringCompare(hint_str, "qword"), 0) ThenBlock: {
                load_size = 8
            }
        }
        
        // =============================================================
        // OPTIMIZATION: Scaled index addressing
        // Pattern: Dereference(Add(base, Multiply(index, 1/2/4/8)))
        //   → MOV RAX, [RBX + RCX * scale]
        //
        // Also catches post-SHL form:
        // Pattern: Dereference(Add(base, SHL(index, 0/1/2/3)))
        //   → same encoding
        // =============================================================
        IfCondition EqualTo(load_size, 8) ThenBlock: {
            arg0_type = AST_GetType(arg0)
            IfCondition EqualTo(arg0_type, AST.CALL) ThenBlock: {
                add_name = AST_GetData1(arg0)
                IfCondition EqualTo(StringCompare(add_name, "Add"), 0) ThenBlock: {
                    add_arg_count = AST_GetChildCount(arg0)
                    IfCondition EqualTo(add_arg_count, 2) ThenBlock: {
                        base_node = AST_GetChild(arg0, 0)
                        offset_node = AST_GetChild(arg0, 1)
                        
                        // Check if offset is Multiply(index, constant)
                        offset_type = AST_GetType(offset_node)
                        IfCondition EqualTo(offset_type, AST.CALL) ThenBlock: {
                            mul_name = AST_GetData1(offset_node)
                            IfCondition EqualTo(StringCompare(mul_name, "Multiply"), 0) ThenBlock: {
                                mul_arg_count = AST_GetChildCount(offset_node)
                                IfCondition EqualTo(mul_arg_count, 2) ThenBlock: {
                                    index_node = AST_GetChild(offset_node, 0)
                                    scale_node = AST_GetChild(offset_node, 1)
                                    
                                    // Scale must be a constant 1, 2, 4, or 8
                                    scale_type = AST_GetType(scale_node)
                                    IfCondition EqualTo(scale_type, AST.NUMBER) ThenBlock: {
                                        scale_str = AST_GetData1(scale_node)
                                        scale_val = StringToNumber(scale_str)
                                        
                                        is_valid_scale = 0
                                        IfCondition EqualTo(scale_val, 1) ThenBlock: { is_valid_scale = 1 }
                                        IfCondition EqualTo(scale_val, 2) ThenBlock: { is_valid_scale = 1 }
                                        IfCondition EqualTo(scale_val, 4) ThenBlock: { is_valid_scale = 1 }
                                        IfCondition EqualTo(scale_val, 8) ThenBlock: { is_valid_scale = 1 }
                                        
                                        IfCondition EqualTo(is_valid_scale, 1) ThenBlock: {
                                            // Match! Emit: base→RBX, index→RCX, MOV RAX,[RBX+RCX*scale]
                                            
                                            // Compile index → RAX, move to RCX
                                            Compile_Expression(index_node)
                                            Emit_MovRcxRax()
                                            
                                            // Compile base → RAX, move to RBX
                                            Compile_Expression(base_node)
                                            Emit_MovRbxRax()
                                            
                                            // Emit scaled load
                                            Emit_MovRaxDerefRbxRcxScaled(scale_val)
                                            
                                            ReturnValue(1)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // =============================================================
        // END OPTIMIZATION
        // =============================================================
        
        PrintMessage("[MEM] Dereference size: ")
        PrintNumber(load_size)
        PrintMessage("\n")
        
        // Standard path: compile address, then load
        Compile_Expression(arg0)
        
        IfCondition EqualTo(load_size, 1) ThenBlock: {
            Emit_MovzxRaxByteDerefRax()
        }
        IfCondition EqualTo(load_size, 2) ThenBlock: {
            Emit_MovzxRaxWordDerefRax()
        }
        IfCondition EqualTo(load_size, 4) ThenBlock: {
            Emit_MovEaxDerefRax()
        }
        IfCondition EqualTo(load_size, 8) ThenBlock: {
            Emit_MovRaxDerefRax()
        }
        
        ReturnValue(1)
    }
}

// =============================================================================
// GETBYTE
// GetByte(addr, offset) - loads byte at addr+offset, zero-extended to RAX
// =============================================================================
Function.CompileMem_GetByte {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[ERROR] GetByte requires 2 arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Compile address, save on stack
        Compile_Expression(arg0)
        Emit_PushRax()
        
        // Compile offset
        Compile_Expression(arg1)
        Emit_MovRbxRax()          // offset in RBX
        
        // Pop address
        Emit_PopRax()
        
        // Add offset to address
        Emit_AddRaxRbx()
        
        // MOVZX RAX, BYTE [RAX]
        Emit_MovzxRaxByteDerefRax()
        
        ReturnValue(1)
    }
}

// =============================================================================
// SETBYTE
// SetByte(addr, offset, value) - stores low byte of value at addr+offset
// =============================================================================
Function.CompileMem_SetByte {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            PrintMessage("[ERROR] SetByte requires 3 arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        arg2 = AST_GetChild(node, 2)
        
        // Compile value first, save
        Compile_Expression(arg2)
        Emit_PushRax()
        
        // Compile offset, save
        Compile_Expression(arg1)
        Emit_PushRax()
        
        // Compile address
        Compile_Expression(arg0)
        // RAX = address
        
        // Pop offset into RBX
        Emit_PopRbx()
        
        // Add offset to address: RAX = addr + offset
        Emit_AddRaxRbx()
        
        // Move target address to RDI
        Emit_MovRdiRax()
        
        // Pop value into RAX (will use AL)
        Emit_PopRax()
        
        // MOV [RDI], AL
        Emit_MovByteDerefRdiAl()
        
        ReturnValue(1)
    }
}

// =============================================================================
// MEMORYCOPY
// MemoryCopy(dest, src, count) - copies count bytes from src to dest
// =============================================================================
Function.CompileMem_MemoryCopy {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            PrintMessage("[ERROR] MemoryCopy requires 3 arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        arg2 = AST_GetChild(node, 2)
        
        // Save registers clobbered by REP MOVSB (RSI, RDI, RCX)
        Emit_PushRsi()
        Emit_PushRdi()
        Emit_PushRcx()

        // Compile dest, save on stack
        Compile_Expression(arg0)
        Emit_PushRax()

        // Compile src, save on stack
        Compile_Expression(arg1)
        Emit_PushRax()

        // Compile count
        Compile_Expression(arg2)
        Emit_MovRcxRax()          // count in RCX

        // Pop src into RSI
        Emit_PopRax()
        Emit_MovRsiRax()

        // Pop dest into RDI
        Emit_PopRax()
        Emit_MovRdiRax()

        // CLD + REP MOVSB (CLD ensures forward direction)
        Emit_Cld()
        Emit_RepMovsb()

        // Restore clobbered registers
        Emit_PopRcx()
        Emit_PopRdi()
        Emit_PopRsi()

        ReturnValue(1)
    }
}

// =============================================================================
// MEMORYSET
// MemorySet(dest, value, count) - sets count bytes at dest to value
// =============================================================================
Function.CompileMem_MemorySet {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            PrintMessage("[ERROR] MemorySet requires 3 arguments\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        arg2 = AST_GetChild(node, 2)
        
        // Save registers clobbered by REP STOSB (RDI, RCX)
        Emit_PushRdi()
        Emit_PushRcx()

        // Compile dest, save on stack
        Compile_Expression(arg0)
        Emit_PushRax()

        // Compile value
        Compile_Expression(arg1)
        Emit_PushRax()

        // Compile count
        Compile_Expression(arg2)
        Emit_MovRcxRax()          // count in RCX

        // Pop value into RAX, save to RBX
        Emit_PopRax()
        Emit_MovRbxRax()          // Save value in RBX (BL = byte)

        // Pop dest into RDI
        Emit_PopRax()
        Emit_MovRdiRax()

        // Restore value to RAX (AL used by STOSB)
        Emit_MovRaxRbx()

        // CLD + REP STOSB (CLD ensures forward direction)
        Emit_Cld()
        Emit_RepStosb()

        // Restore clobbered registers
        Emit_PopRcx()
        Emit_PopRdi()

        ReturnValue(1)
    }
}