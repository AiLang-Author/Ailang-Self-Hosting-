// Library.CCompilePool.ailang
// LinkagePool compilation - declarations, allocation, field access, operations
// Location: Librarys/Compiler/Compile/Modules/Library.CCompilePool.ailang
//
// Architecture:
//   - Pool definitions stored in FixedPool.PoolRegistry
//   - Field info tracked per pool: offset, direction, type, init_value
//   - Direction enforcement on parameter field access
//   - Uses standard Allocate/Deallocate (Arena-backed automatically)
//   - Introspection primitives resolve to immediates
//

LibraryImport.XArrays
LibraryImport.Arena

LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore

LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.PoolConst {
    "DIR_INPUT":  Initialize=268435456    // 0x10000000 - Read only
    "DIR_OUTPUT": Initialize=536870912    // 0x20000000 - Write only
    "DIR_INOUT":  Initialize=805306368    // 0x30000000 - Read/Write
    "DIR_MASK":   Initialize=4026531840   // 0xF0000000
    
    "TYPE_INT":    Initialize=0
    "TYPE_STRING": Initialize=1
    "TYPE_NESTED": Initialize=2
}

// =============================================================================
// POOL REGISTRY STATE
// =============================================================================
FixedPool.PoolRegistry {
    "pools": Initialize=0           // XArray of pool entries
    "initialized": Initialize=0
}

// Pool entry structure (40 bytes):
//   [0]  pool_name (string pointer)
//   [8]  field_count
//   [16] total_size (bytes)
//   [24] fields_array (XArray of field entries)
//   [32] full_name (e.g., "LinkagePool.CustomerRecord")

// Field entry structure (48 bytes):
//   [0]  field_name (string pointer)
//   [8]  offset (bytes from pool start)
//   [16] direction (DIR_INPUT, DIR_OUTPUT, DIR_INOUT)
//   [24] field_type (TYPE_INT, TYPE_STRING, TYPE_NESTED)
//   [32] nested_pool_name (if TYPE_NESTED, else 0)
//   [40] init_value (integer or string data offset)

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Pool_Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(PoolRegistry.initialized, 0) ThenBlock: {
            PoolRegistry.pools = XArray.XCreate(64)
            PoolRegistry.initialized = 1
            PrintMessage("[POOL] Registry initialized\n")
        }
        ReturnValue(1)
    }
}

Function.Pool_Reset {
    Body: {
        IfCondition NotEqual(PoolRegistry.pools, 0) ThenBlock: {
            XArray.XClear(PoolRegistry.pools)
            PrintMessage("[POOL] Registry cleared for new build\n")
        }
    }
}
// =============================================================================
// POOL DECLARATION COMPILATION
// Processes: LinkagePool.TypeName { "field": Initialize=0, Direction=Input }
// =============================================================================
Function.CompilePool_Declaration {
    Input: node: Address
    Output: Integer
    Body: {
        Pool_Init()
        
        // Get pool name from node (e.g., "CustomerRecord" from LinkagePool.CustomerRecord)
        pool_name = AST_GetData1(node)
        
        // Build full name for tracking
        full_name = Pool_BuildFullName(pool_name)
        
        PrintMessage("[POOL] Compiling ")
        PrintString(full_name)
        PrintMessage("\n")
        
        // Check for duplicate
        IfCondition Pool_Exists(pool_name) ThenBlock: {
            PrintMessage("[ERROR] Duplicate LinkagePool: ")
            PrintString(full_name)
            PrintMessage("\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Create pool entry (40 bytes)
        pool_entry = Allocate(40)
        StoreValue(pool_entry, pool_name)           // [0] name
        StoreValue(Add(pool_entry, 8), 0)           // [8] field_count
        StoreValue(Add(pool_entry, 16), 0)          // [16] size
        StoreValue(Add(pool_entry, 32), full_name)  // [32] full_name
        
        fields_array = XArray.XCreate(32)
        StoreValue(Add(pool_entry, 24), fields_array)
        
        // Process field declarations - fields are direct children of pool node
        offset = 0
        field_count = 0
        child_count = AST_GetChildCount(node)
        
        i = 0
        WhileLoop LessThan(i, child_count) {
            field_node = AST_GetChild(node, i)
            field_type = AST_GetType(field_node)
            
            // Only process POOL_MEMBER nodes
            IfCondition EqualTo(field_type, AST.POOL_MEMBER) ThenBlock: {
                // Parse field entry
                field_result = Pool_ParseField(field_node, offset)
                field_entry = Dereference(field_result)           // Entry pointer
                field_size = Dereference(Add(field_result, 8))    // Size consumed
                
                IfCondition NotEqual(field_entry, 0) ThenBlock: {
                    XArray.XPush(fields_array, field_entry)
                    offset = Add(offset, field_size)
                    field_count = Add(field_count, 1)
                }
            }
            
            i = Add(i, 1)
        }
        
        // Update pool entry with final values
        StoreValue(Add(pool_entry, 8), field_count)
        StoreValue(Add(pool_entry, 16), offset)
        
        // Register pool
        XArray.XPush(PoolRegistry.pools, pool_entry)
        
        PrintMessage("[POOL] Registered ")
        PrintString(full_name)
        PrintMessage(": ")
        PrintNumber(field_count)
        PrintMessage(" fields, ")
        PrintNumber(offset)
        PrintMessage(" bytes\n")
        
        ReturnValue(1)
    }
}

// =============================================================================
// FIELD PARSING HELPER
// Returns: [field_entry_ptr, field_size]
// =============================================================================
Function.Pool_ParseField {
    Input: node: Address
    Input: current_offset: Integer
    Output: Address
    Body: {
        // Get field name (in quotes in AST)
        field_name = AST_GetData1(node)
        
        // Create field entry (48 bytes)
        entry = Allocate(48)
        StoreValue(entry, field_name)                    // [0] name
        StoreValue(Add(entry, 8), current_offset)        // [8] offset
        StoreValue(Add(entry, 16), PoolConst.DIR_INOUT)  // [16] direction default
        StoreValue(Add(entry, 24), PoolConst.TYPE_INT)   // [24] type default
        StoreValue(Add(entry, 32), 0)                    // [32] nested name
        StoreValue(Add(entry, 40), 0)                    // [40] init value
        
        field_size = 8  // Default: 8 bytes for int/string pointer
        
        // Parse attributes
        attr_count = AST_GetChildCount(node)
        j = 0
        WhileLoop LessThan(j, attr_count) {
            attr = AST_GetChild(node, j)
            attr_key = AST_GetData1(attr)
            attr_val_node = AST_GetChild(attr, 0)
            
            // Initialize attribute
            IfCondition EqualTo(StringCompare(attr_key, "Initialize"), 0) ThenBlock: {
                attr_type = AST_GetType(attr_val_node)
                
                // String initializer
                IfCondition EqualTo(attr_type, AST.STRING) ThenBlock: {
                    StoreValue(Add(entry, 24), PoolConst.TYPE_STRING)
                    str_val = AST_GetData1(attr_val_node)
                    // Store string in data section, save offset
                    str_offset = Emit_AddString(str_val)
                    StoreValue(Add(entry, 40), str_offset)
                }
                
                // Integer initializer
                IfCondition EqualTo(attr_type, AST.NUMBER) ThenBlock: {
                    int_val = AST_GetData1(attr_val_node)
                    num_val = StringToNumber(int_val)
                    StoreValue(Add(entry, 40), num_val)
                }
            }
            
            // Direction attribute
            IfCondition EqualTo(StringCompare(attr_key, "Direction"), 0) ThenBlock: {
                dir_str = AST_GetData1(attr_val_node)
                IfCondition EqualTo(StringCompare(dir_str, "Input"), 0) ThenBlock: {
                    StoreValue(Add(entry, 16), PoolConst.DIR_INPUT)
                }
                IfCondition EqualTo(StringCompare(dir_str, "Output"), 0) ThenBlock: {
                    StoreValue(Add(entry, 16), PoolConst.DIR_OUTPUT)
                }
                IfCondition EqualTo(StringCompare(dir_str, "InOut"), 0) ThenBlock: {
                    StoreValue(Add(entry, 16), PoolConst.DIR_INOUT)
                }
            }
            
            // Type attribute (nested pool)
            IfCondition EqualTo(StringCompare(attr_key, "Type"), 0) ThenBlock: {
                nested_type = AST_GetData1(attr_val_node)
                StoreValue(Add(entry, 24), PoolConst.TYPE_NESTED)
                StoreValue(Add(entry, 32), nested_type)
                
                // Get nested pool size
                nested_name = Pool_ExtractPoolName(nested_type)
                nested_size = Pool_GetSize(nested_name)
                IfCondition GreaterThan(nested_size, 0) ThenBlock: {
                    field_size = nested_size
                } ElseBlock: {
                    PrintMessage("[ERROR] Nested pool not found: ")
                    PrintString(nested_type)
                    PrintMessage("\n")
                    PrintMessage("        Nested pools must be declared before use\n")
                    Compile.error = 1
                }
            }
            
            j = Add(j, 1)
        }
        
        PrintMessage("[POOL]   '")
        PrintString(field_name)
        PrintMessage("' offset=")
        PrintNumber(current_offset)
        PrintMessage(" size=")
        PrintNumber(field_size)
        PrintMessage("\n")
        
        // Return [entry, size] pair
        result = Allocate(16)
        StoreValue(result, entry)
        StoreValue(Add(result, 8), field_size)
        ReturnValue(result)
    }
}

// =============================================================================
// POOL LOOKUP HELPERS
// =============================================================================
Function.Pool_Exists {
    Input: pool_name: Address
    Output: Integer
    Body: {
        entry = Pool_Find(pool_name)
        IfCondition NotEqual(entry, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Pool_Find {
    Input: pool_name: Address
    Output: Address
    Body: {
        Pool_Init()
        
        count = XArray.XSize(PoolRegistry.pools)
        i = 0
        WhileLoop LessThan(i, count) {
            entry = XArray.XGet(PoolRegistry.pools, i)
            entry_name = Dereference(entry)
            
            IfCondition EqualTo(StringCompare(pool_name, entry_name), 0) ThenBlock: {
                ReturnValue(entry)
            }
            
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

Function.Pool_GetSize {
    Input: pool_name: Address
    Output: Integer
    Body: {
        entry = Pool_Find(pool_name)
        IfCondition EqualTo(entry, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Dereference(Add(entry, 16)))
    }
}

Function.Pool_GetFieldCount {
    Input: pool_name: Address
    Output: Integer
    Body: {
        entry = Pool_Find(pool_name)
        IfCondition EqualTo(entry, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Dereference(Add(entry, 8)))
    }
}

Function.Pool_FindField {
    Input: pool_name: Address
    Input: field_name: Address
    Output: Address
    Body: {
        pool_entry = Pool_Find(pool_name)
        IfCondition EqualTo(pool_entry, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        fields = Dereference(Add(pool_entry, 24))
        count = XArray.XSize(fields)
        i = 0
        WhileLoop LessThan(i, count) {
            field_entry = XArray.XGet(fields, i)
            entry_name = Dereference(field_entry)
            
            IfCondition EqualTo(StringCompare(field_name, entry_name), 0) ThenBlock: {
                ReturnValue(field_entry)
            }
            
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}


Function.CompilePool_TryFieldRead {
    Input: name: Address
    Input: dot_pos: Integer
    Output: Integer
    Body: {
        // Extract base_var
        base_var = Allocate(Add(dot_pos, 1))
        j = 0
        WhileLoop LessThan(j, dot_pos) {
            SetByte(base_var, j, GetByte(name, j))
            j = Add(j, 1)
        }
        SetByte(base_var, dot_pos, 0)
        
        // Check if it's a pool pointer
        pool_type = Scope_GetVarPoolType(base_var)
        IfCondition EqualTo(pool_type, 0) ThenBlock: {
            ReturnValue(0)  // Not a pool pointer
        }
        
        field_name = Add(name, Add(dot_pos, 1))
        ReturnValue(CompilePool_FieldReadSimple(base_var, field_name))
    }
}


// Extract "CustomerRecord" from "LinkagePool.CustomerRecord"
Function.Pool_ExtractPoolName {
    Input: full_type: Address
    Output: Address
    Body: {
        // Find the dot, return everything after
        len = StringLength(full_type)
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(full_type, i)
            IfCondition EqualTo(c, 46) ThenBlock: {  // '.'
                ReturnValue(Add(full_type, Add(i, 1)))
            }
            i = Add(i, 1)
        }
        // No dot found, return as-is
        ReturnValue(full_type)
    }
}

// Build "LinkagePool.X" from "X"
Function.Pool_BuildFullName {
    Input: pool_name: Address
    Output: Address
    Body: {
        prefix = "LinkagePool."
        prefix_len = 12
        name_len = StringLength(pool_name)
        total_len = Add(prefix_len, Add(name_len, 1))
        
        result = Allocate(total_len)
        
        // Copy prefix
        i = 0
        WhileLoop LessThan(i, prefix_len) {
            SetByte(result, i, GetByte(prefix, i))
            i = Add(i, 1)
        }
        
        // Copy name
        j = 0
        WhileLoop LessThan(j, name_len) {
            SetByte(result, Add(prefix_len, j), GetByte(pool_name, j))
            j = Add(j, 1)
        }
        
        // Null terminate
        SetByte(result, Add(prefix_len, name_len), 0)
        
        ReturnValue(result)
    }
}

// List available pools for error messages
Function.Pool_ListAvailable {
    Body: {
        count = XArray.XSize(PoolRegistry.pools)
        IfCondition EqualTo(count, 0) ThenBlock: {
            PrintMessage("(none defined)")
            ReturnValue(0)
        }
        
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition GreaterThan(i, 0) ThenBlock: {
                PrintMessage(", ")
            }
            entry = XArray.XGet(PoolRegistry.pools, i)
            name = Dereference(entry)
            PrintString(name)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// ALLOCATE LINKAGE
// AllocateLinkage(LinkagePool.TypeName) -> Allocate + field init
// =============================================================================
Function.CompilePool_AllocateLinkage {
    Input: node: Address
    Output: Integer
    Body: {
        // Get pool type from argument
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[ERROR] AllocateLinkage requires exactly 1 argument\n")
            PrintMessage("        Usage: ptr = AllocateLinkage(LinkagePool.TypeName)\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        full_type = AST_GetData1(arg0)
        pool_name = Pool_ExtractPoolName(full_type)
        
        PrintMessage("[POOL] AllocateLinkage for ")
        PrintString(full_type)
        PrintMessage("\n")
        
        // Verify pool exists
        pool_entry = Pool_Find(pool_name)
        IfCondition EqualTo(pool_entry, 0) ThenBlock: {
            PrintMessage("[ERROR] Unknown LinkagePool type: ")
            PrintString(full_type)
            PrintMessage("\n")
            PrintMessage("        Defined pools: ")
            Pool_ListAvailable()
            PrintMessage("\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Get pool size
        pool_size = Dereference(Add(pool_entry, 16))
        
        // Ensure arena is initialized (lazy init)
        ensure_label = Compile_FindFunction("Arena_EnsureInit")
        IfCondition GreaterEqual(ensure_label, 0) ThenBlock: {
            Emit_MovRegReg(Reg.R12, Reg.RSP)
            Emit_AndRspImm8(240)
            Emit_Call(ensure_label)
            Emit_MovRegReg(Reg.RSP, Reg.R12)
        }
        
        // Find Arena_Alloc
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            PrintMessage("[ERROR] Arena_Alloc not found\n")
            PrintMessage("        LinkagePool requires Arena library\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Emit allocation call
        Emit_MovRdiImm64(pool_size)
        Emit_MovRegReg(Reg.R12, Reg.RSP)
        Emit_AndRspImm8(240)
        Emit_Call(arena_label)
        Emit_MovRegReg(Reg.RSP, Reg.R12)
        
        // RAX now has pointer - save to R12 for field init
        Emit_PushRax()
        Emit_MovR12Rax()
        
        // Initialize fields
       // Pool_EmitFieldInit(pool_name, pool_entry)
        
        // Restore pointer to RAX
        Emit_PopRax()
        
        // Track pending type for assignment
        Compile.pending_pool_type = full_type
        
        ReturnValue(1)
    }
}

// =============================================================================
// FREE LINKAGE
// FreeLinkage(ptr, LinkagePool.TypeName) -> Deallocate
// =============================================================================
Function.CompilePool_FreeLinkage {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        
        // REQUIRE 2 arguments - explicit type always!
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[ERROR] FreeLinkage requires pool type\n")
            PrintMessage("        Usage: FreeLinkage(ptr, LinkagePool.TypeName)\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)  // ptr
        arg1 = AST_GetChild(node, 1)  // type
        
        full_type = AST_GetData1(arg1)
        pool_name = Pool_ExtractPoolName(full_type)
        
        // Verify pool exists
        pool_entry = Pool_Find(pool_name)
        IfCondition EqualTo(pool_entry, 0) ThenBlock: {
            PrintMessage("[ERROR] Unknown LinkagePool type: ")
            PrintString(full_type)
            PrintMessage("\n")
            PrintMessage("        Defined pools: ")
            Pool_ListAvailable()
            PrintMessage("\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        pool_size = Dereference(Add(pool_entry, 16))
        
        // Find Arena_Free
        arena_free_label = Compile_FindFunction("Arena_Free")
        IfCondition LessThan(arena_free_label, 0) ThenBlock: {
            PrintMessage("[ERROR] Arena_Free not found\n")
            PrintMessage("        LinkagePool requires Arena library\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Compile ptr expression -> RAX
        Compile_Expression(arg0)
        
        // Setup args: RDI = ptr, RSI = size
        Emit_MovRdiRax()
        Emit_MovRsiImm64(pool_size)
        
        // Call Arena_Free with stack alignment
        Emit_MovRegReg(Reg.R12, Reg.RSP)
        Emit_AndRspImm8(240)
        Emit_Call(arena_free_label)
        Emit_MovRegReg(Reg.RSP, Reg.R12)
        
        ReturnValue(1)
    }
}

// =============================================================================
// FIELD INITIALIZATION
// Initialize all fields to their declared Initialize values
// =============================================================================
Function.Pool_EmitFieldInit {
    Input: pool_name: Address
    Input: pool_entry: Address
    Body: {
        fields = Dereference(Add(pool_entry, 24))
        count = XArray.XSize(fields)
        
        i = 0
        WhileLoop LessThan(i, count) {
            field_entry = XArray.XGet(fields, i)
            field_offset = Dereference(Add(field_entry, 8))
            field_type = Dereference(Add(field_entry, 24))
            init_value = Dereference(Add(field_entry, 40))
            
            IfCondition EqualTo(field_type, PoolConst.TYPE_STRING) ThenBlock: {
                // String: init_value is data section offset
                // Load address of string into RAX
                Emit_LoadDataAddress(init_value)
                // Store to [R12 + offset]
                Pool_EmitStoreR12Offset(field_offset)
            } ElseBlock: {
                IfCondition EqualTo(field_type, PoolConst.TYPE_NESTED) ThenBlock: {
                    // Nested pool: recursively initialize
                    nested_name_ptr = Dereference(Add(field_entry, 32))
                    nested_name = Pool_ExtractPoolName(nested_name_ptr)
                    nested_entry = Pool_Find(nested_name)
                    
                    IfCondition NotEqual(nested_entry, 0) ThenBlock: {
                        // Calculate nested base: R12 + field_offset
                        Emit_MovRaxR12()
                        Emit_AddRaxImm(field_offset)
                        Emit_PushR12()
                        Emit_MovR12Rax()
                        
                        // Recursive init
                        Pool_EmitFieldInit(nested_name, nested_entry)
                        
                        // Restore R12
                        Emit_PopR12()
                    }
                } ElseBlock: {
                    // Integer: init_value is the integer
                    Emit_MovRaxImm64(init_value)
                    Pool_EmitStoreR12Offset(field_offset)
                }
            }
            
            i = Add(i, 1)
        }
        
        ReturnValue(1)
    }
}

// Helper: Store RAX to [R12 + offset]
Function.Pool_EmitStoreR12Offset {
    Input: offset: Integer
    Body: {
        IfCondition EqualTo(offset, 0) ThenBlock: {
            // MOV [R12], RAX
            Emit_MovDerefR12Rax()
        } ElseBlock: {
            // MOV [R12 + offset], RAX
            Emit_MovDerefR12OffsetRax(offset)
        }
    }
}

// =============================================================================
// FIELD ACCESS - READ
// Handles: ptr.field and ptr.nested.field (chained)
// =============================================================================
Function.CompilePool_FieldRead {
    Input: base_var: Address      // Variable name holding pointer
    Input: field_chain: Address   // XArray of field names for chained access
    Output: Integer
    Body: {
        // Get pool type for this variable
        pool_type = Scope_GetVarPoolType(base_var)
        IfCondition EqualTo(pool_type, 0) ThenBlock: {
            PrintMessage("[ERROR] Variable '")
            PrintString(base_var)
            PrintMessage("' is not a LinkagePool pointer\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        pool_name = Pool_ExtractPoolName(pool_type)
        
        // Calculate total offset and final field info through chain
        result = Pool_ResolveFieldChain(pool_name, field_chain, base_var)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)  // Error already printed
        }
        
        total_offset = Dereference(result)
        final_field = Dereference(Add(result, 8))
        final_direction = Dereference(Add(final_field, 16))
        
        // DIRECTION CHECK: If this is a parameter, check read permission
        is_param = Scope_IsParameter(base_var)
        IfCondition And(is_param, EqualTo(final_direction, PoolConst.DIR_OUTPUT)) ThenBlock: {
            final_name = Dereference(final_field)
            PrintMessage("[ERROR] Cannot read from Output field '")
            PrintString(final_name)
            PrintMessage("' in parameter '")
            PrintString(base_var)
            PrintMessage("'\n")
            PrintMessage("        Field has Direction=Output (write-only)\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Load pointer from variable
        var_offset = Scope_Resolve(base_var)
        Emit_MovRaxRbpOffset(var_offset)
        
        // Null check
        Emit_TestRaxRax()
        null_label = Emit_CreateLabel()
        end_label = Emit_CreateLabel()
        Emit_Jz(null_label)
        
        // Load field value at total_offset
        IfCondition EqualTo(total_offset, 0) ThenBlock: {
            Emit_MovRaxDerefRax()
        } ElseBlock: {
            Emit_MovRaxDerefRaxOffset(total_offset)
        }
        Emit_Jmp(end_label)
        
        // Null handler - return 0
        Emit_MarkLabel(null_label)
        Emit_XorRaxRax()
        
        Emit_MarkLabel(end_label)
        
        ReturnValue(1)
    }
}

// =============================================================================
// FIELD ACCESS - WRITE
// Handles: ptr.field = value and ptr.nested.field = value
// Value already in RAX when called
// =============================================================================
Function.CompilePool_FieldWrite {
    Input: base_var: Address
    Input: field_chain: Address   // XArray of field names
    Output: Integer
    Body: {
        // Get pool type
        pool_type = Scope_GetVarPoolType(base_var)
        IfCondition EqualTo(pool_type, 0) ThenBlock: {
            PrintMessage("[ERROR] Variable '")
            PrintString(base_var)
            PrintMessage("' is not a LinkagePool pointer\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        pool_name = Pool_ExtractPoolName(pool_type)
        
        // Resolve field chain
        result = Pool_ResolveFieldChain(pool_name, field_chain, base_var)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        total_offset = Dereference(result)
        final_field = Dereference(Add(result, 8))
        final_direction = Dereference(Add(final_field, 16))
        
        // DIRECTION CHECK: If parameter, check write permission
        is_param = Scope_IsParameter(base_var)
        IfCondition And(is_param, EqualTo(final_direction, PoolConst.DIR_INPUT)) ThenBlock: {
            final_name = Dereference(final_field)
            PrintMessage("[ERROR] Cannot write to Input field '")
            PrintString(final_name)
            PrintMessage("' in parameter '")
            PrintString(base_var)
            PrintMessage("'\n")
            PrintMessage("        Field has Direction=Input (read-only)\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Value to store is in RAX, save to R10
        Emit_MovR10Rax()
        
        // Load pointer to R11
        var_offset = Scope_Resolve(base_var)
        Emit_MovR11RbpOffset(var_offset)
        
        // Null check
        Emit_TestR11R11()
        null_label = Emit_CreateLabel()
        Emit_Jz(null_label)
        
        // Store value at total_offset
        IfCondition EqualTo(total_offset, 0) ThenBlock: {
            Emit_MovDerefR11R10()
        } ElseBlock: {
            Emit_MovDerefR11OffsetR10(total_offset)
        }
        
        Emit_MarkLabel(null_label)
        
        ReturnValue(1)
    }
}

// =============================================================================
// FIELD CHAIN RESOLUTION
// Walks ptr.a.b.c and returns [total_offset, final_field_entry]
// =============================================================================
Function.Pool_ResolveFieldChain {
    Input: start_pool: Address
    Input: field_chain: Address
    Input: base_var: Address      // For error messages
    Output: Address
    Body: {
        chain_len = XArray.XSize(field_chain)
        IfCondition EqualTo(chain_len, 0) ThenBlock: {
            PrintMessage("[ERROR] Empty field chain\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        total_offset = 0
        current_pool = start_pool
        final_field = 0
        
        i = 0
        WhileLoop LessThan(i, chain_len) {
            field_name = XArray.XGet(field_chain, i)
            
            // Find field in current pool
            field_entry = Pool_FindField(current_pool, field_name)
            IfCondition EqualTo(field_entry, 0) ThenBlock: {
                PrintMessage("[ERROR] Field '")
                PrintString(field_name)
                PrintMessage("' not in LinkagePool.")
                PrintString(current_pool)
                PrintMessage("\n")
                PrintMessage("        Available fields: ")
                Pool_ListFields(current_pool)
                PrintMessage("\n")
                Compile.error = 1
                ReturnValue(0)
            }
            
            // Add field offset to total
            field_offset = Dereference(Add(field_entry, 8))
            total_offset = Add(total_offset, field_offset)
            final_field = field_entry
            
            // If not last field and is nested, update current_pool
            IfCondition LessThan(Add(i, 1), chain_len) ThenBlock: {
                field_type = Dereference(Add(field_entry, 24))
                IfCondition NotEqual(field_type, PoolConst.TYPE_NESTED) ThenBlock: {
                    PrintMessage("[ERROR] Field '")
                    PrintString(field_name)
                    PrintMessage("' is not a nested pool, cannot access '")
                    next_field = XArray.XGet(field_chain, Add(i, 1))
                    PrintString(next_field)
                    PrintMessage("'\n")
                    Compile.error = 1
                    ReturnValue(0)
                }
                
                nested_type = Dereference(Add(field_entry, 32))
                current_pool = Pool_ExtractPoolName(nested_type)
            }
            
            i = Add(i, 1)
        }
        
        // Return [total_offset, final_field_entry]
        result = Allocate(16)
        StoreValue(result, total_offset)
        StoreValue(Add(result, 8), final_field)
        ReturnValue(result)
    }
}

// List fields for error messages
Function.Pool_ListFields {
    Input: pool_name: Address
    Body: {
        pool_entry = Pool_Find(pool_name)
        IfCondition EqualTo(pool_entry, 0) ThenBlock: {
            PrintMessage("(unknown pool)")
            ReturnValue(0)
        }
        
        fields = Dereference(Add(pool_entry, 24))
        count = XArray.XSize(fields)
        
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition GreaterThan(i, 0) ThenBlock: {
                PrintMessage(", ")
            }
            field_entry = XArray.XGet(fields, i)
            name = Dereference(field_entry)
            PrintString(name)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// SIMPLE FIELD ACCESS WRAPPERS
// For single field (non-chained) access - convenience functions
// =============================================================================
Function.CompilePool_FieldReadSimple {
    Input: base_var: Address
    Input: field_name: Address
    Output: Integer
    Body: {
        // Build single-element chain
        chain = XArray.XCreate(1)
        XArray.XPush(chain, field_name)
        result = CompilePool_FieldRead(base_var, chain)
        XArray.XDestroy(chain)
        ReturnValue(result)
    }
}

Function.CompilePool_FieldWriteSimple {
    Input: base_var: Address
    Input: field_name: Address
    Output: Integer
    Body: {
        chain = XArray.XCreate(1)
        XArray.XPush(chain, field_name)
        result = CompilePool_FieldWrite(base_var, chain)
        XArray.XDestroy(chain)
        ReturnValue(result)
    }
}

// =============================================================================
// INTROSPECTION PRIMITIVES
// Resolve to immediate values at compile time - zero runtime cost
// =============================================================================
Function.CompilePool_PoolSize {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[ERROR] PoolSize requires exactly 1 argument\n")
            PrintMessage("        Usage: size = PoolSize(LinkagePool.TypeName)\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        full_type = AST_GetData1(arg0)
        pool_name = Pool_ExtractPoolName(full_type)
        
        size = Pool_GetSize(pool_name)
        IfCondition EqualTo(size, 0) ThenBlock: {
            IfCondition EqualTo(Pool_Exists(pool_name), 0) ThenBlock: {
                PrintMessage("[ERROR] Unknown LinkagePool type: ")
                PrintString(full_type)
                PrintMessage("\n")
                Compile.error = 1
                ReturnValue(0)
            }
        }
        
        // Emit immediate value - no runtime call!
        Emit_MovRaxImm64(size)
        ReturnValue(1)
    }
}

Function.CompilePool_PoolFieldCount {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            PrintMessage("[ERROR] PoolFieldCount requires exactly 1 argument\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        full_type = AST_GetData1(arg0)
        pool_name = Pool_ExtractPoolName(full_type)
        
        IfCondition EqualTo(Pool_Exists(pool_name), 0) ThenBlock: {
            PrintMessage("[ERROR] Unknown LinkagePool type: ")
            PrintString(full_type)
            PrintMessage("\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        count = Pool_GetFieldCount(pool_name)
        Emit_MovRaxImm64(count)
        ReturnValue(1)
    }
}

Function.CompilePool_PoolFieldOffset {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[ERROR] PoolFieldOffset requires 2 arguments\n")
            PrintMessage("        Usage: offset = PoolFieldOffset(LinkagePool.Type, \"field\")\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)  // Pool type
        arg1 = AST_GetChild(node, 1)  // Field name (string)
        
        full_type = AST_GetData1(arg0)
        pool_name = Pool_ExtractPoolName(full_type)
        field_name = AST_GetData1(arg1)
        
        field_entry = Pool_FindField(pool_name, field_name)
        IfCondition EqualTo(field_entry, 0) ThenBlock: {
            PrintMessage("[ERROR] Field '")
            PrintString(field_name)
            PrintMessage("' not in ")
            PrintString(full_type)
            PrintMessage("\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        offset = Dereference(Add(field_entry, 8))
        Emit_MovRaxImm64(offset)
        ReturnValue(1)
    }
}

// =============================================================================
// POOL OPERATIONS
// All require explicit type - NO INFERENCE
// =============================================================================

// CopyLinkage(src, LinkagePool.Type) -> new allocated copy
Function.CompilePool_CopyLinkage {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[ERROR] CopyLinkage requires 2 arguments\n")
            PrintMessage("        Usage: dest = CopyLinkage(src, LinkagePool.TypeName)\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)  // src
        arg1 = AST_GetChild(node, 1)  // type
        
        full_type = AST_GetData1(arg1)
        pool_name = Pool_ExtractPoolName(full_type)
        pool_size = Pool_GetSize(pool_name)
        
        IfCondition EqualTo(pool_size, 0) ThenBlock: {
            PrintMessage("[ERROR] Unknown LinkagePool type: ")
            PrintString(full_type)
            PrintMessage("\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Compile src -> RAX, save to R13
        Compile_Expression(arg0)
        Emit_MovR13Rax()
        
        // Allocate new pool -> RAX
        Emit_MovRdiImm64(pool_size)
        Emit_Call("Allocate")
        Emit_MovR12Rax()  // Save dest in R12
        
        // MemoryCopy(dest=R12, src=R13, size)
        Emit_MovRdiR12()
        Emit_MovRsiR13()
        Emit_MovRdxImm64(pool_size)
        Emit_Call("MemoryCopy")
        
        // Return dest pointer
        Emit_MovRaxR12()
        
        // Track type for assignment
        Compile.pending_pool_type = full_type
        
        ReturnValue(1)
    }
}

// CopyLinkageInto(dest, src, LinkagePool.Type) -> copy into existing
Function.CompilePool_CopyLinkageInto {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            PrintMessage("[ERROR] CopyLinkageInto requires 3 arguments\n")
            PrintMessage("        Usage: CopyLinkageInto(dest, src, LinkagePool.TypeName)\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)  // dest
        arg1 = AST_GetChild(node, 1)  // src
        arg2 = AST_GetChild(node, 2)  // type
        
        full_type = AST_GetData1(arg2)
        pool_name = Pool_ExtractPoolName(full_type)
        pool_size = Pool_GetSize(pool_name)
        
        IfCondition EqualTo(pool_size, 0) ThenBlock: {
            PrintMessage("[ERROR] Unknown LinkagePool type: ")
            PrintString(full_type)
            PrintMessage("\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Compile dest -> R12
        Compile_Expression(arg0)
        Emit_MovR12Rax()
        
        // Compile src -> R13
        Compile_Expression(arg1)
        Emit_MovR13Rax()
        
        // MemoryCopy(dest, src, size)
        Emit_MovRdiR12()
        Emit_MovRsiR13()
        Emit_MovRdxImm64(pool_size)
        Emit_Call("MemoryCopy")
        
        ReturnValue(1)
    }
}

// ResetLinkage(ptr, LinkagePool.Type) -> restore Initialize values
Function.CompilePool_ResetLinkage {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            PrintMessage("[ERROR] ResetLinkage requires 2 arguments\n")
            PrintMessage("        Usage: ResetLinkage(ptr, LinkagePool.TypeName)\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)  // ptr
        arg1 = AST_GetChild(node, 1)  // type
        
        full_type = AST_GetData1(arg1)
        pool_name = Pool_ExtractPoolName(full_type)
        pool_entry = Pool_Find(pool_name)
        
        IfCondition EqualTo(pool_entry, 0) ThenBlock: {
            PrintMessage("[ERROR] Unknown LinkagePool type: ")
            PrintString(full_type)
            PrintMessage("\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Compile ptr -> R12
        Compile_Expression(arg0)
        Emit_MovR12Rax()
        
        // Re-initialize all fields
        Pool_EmitFieldInit(pool_name, pool_entry)
        
        ReturnValue(1)
    }
}

// CompareLinkage(a, b, LinkagePool.Type) -> 1 if equal, 0 if different
Function.CompilePool_CompareLinkage {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            PrintMessage("[ERROR] CompareLinkage requires 3 arguments\n")
            PrintMessage("        Usage: eq = CompareLinkage(a, b, LinkagePool.TypeName)\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)  // a
        arg1 = AST_GetChild(node, 1)  // b
        arg2 = AST_GetChild(node, 2)  // type
        
        full_type = AST_GetData1(arg2)
        pool_name = Pool_ExtractPoolName(full_type)
        pool_size = Pool_GetSize(pool_name)
        
        IfCondition EqualTo(pool_size, 0) ThenBlock: {
            PrintMessage("[ERROR] Unknown LinkagePool type: ")
            PrintString(full_type)
            PrintMessage("\n")
            Compile.error = 1
            ReturnValue(0)
        }
        
        // Compile a -> R12
        Compile_Expression(arg0)
        Emit_MovR12Rax()
        
        // Compile b -> R13
        Compile_Expression(arg1)
        Emit_MovR13Rax()
        
        // MemCompare(a, b, size) - returns 0 if equal
        Emit_MovRdiR12()
        Emit_MovRsiR13()
        Emit_MovRdxImm64(pool_size)
        Emit_Call("MemCompare")
        
        // Invert result: MemCompare returns 0 if equal
        // We want 1 if equal, 0 if different
        Emit_TestRaxRax()
        Emit_Setz()          // AL = 1 if ZF set (RAX was 0 = equal)
        Emit_MovzxRaxAl()    // Zero-extend AL to RAX
        
        ReturnValue(1)
    }
}

// =============================================================================
// TRY COMPILE DISPATCHER
// Called from CCompileMain to check if we handle this function
// Returns 1 if handled, 0 if not our function
// =============================================================================
Function.CompilePool_TryCompile {
    Input: func_name: Address
    Input: node: Address
    Output: Integer
    Body: {
        // AllocateLinkage
        IfCondition EqualTo(StringCompare(func_name, "AllocateLinkage"), 0) ThenBlock: {
            ReturnValue(CompilePool_AllocateLinkage(node))
        }
        
        // FreeLinkage
        IfCondition EqualTo(StringCompare(func_name, "FreeLinkage"), 0) ThenBlock: {
            ReturnValue(CompilePool_FreeLinkage(node))
        }
        
        // PoolSize
        IfCondition EqualTo(StringCompare(func_name, "PoolSize"), 0) ThenBlock: {
            ReturnValue(CompilePool_PoolSize(node))
        }
        
        // PoolFieldCount
        IfCondition EqualTo(StringCompare(func_name, "PoolFieldCount"), 0) ThenBlock: {
            ReturnValue(CompilePool_PoolFieldCount(node))
        }
        
        // PoolFieldOffset
        IfCondition EqualTo(StringCompare(func_name, "PoolFieldOffset"), 0) ThenBlock: {
            ReturnValue(CompilePool_PoolFieldOffset(node))
        }
        
        // CopyLinkage
        IfCondition EqualTo(StringCompare(func_name, "CopyLinkage"), 0) ThenBlock: {
            ReturnValue(CompilePool_CopyLinkage(node))
        }
        
        // CopyLinkageInto
        IfCondition EqualTo(StringCompare(func_name, "CopyLinkageInto"), 0) ThenBlock: {
            ReturnValue(CompilePool_CopyLinkageInto(node))
        }
        
        // ResetLinkage
        IfCondition EqualTo(StringCompare(func_name, "ResetLinkage"), 0) ThenBlock: {
            ReturnValue(CompilePool_ResetLinkage(node))
        }
        
        // CompareLinkage
        IfCondition EqualTo(StringCompare(func_name, "CompareLinkage"), 0) ThenBlock: {
            ReturnValue(CompilePool_CompareLinkage(node))
        }
        
        // Not handled by this module
        ReturnValue(0)
    }
}

