/// =============================================================================
// ASSIGNMENT
// target = value
// =============================================================================
Function.CompileStmt_Assignment {
    Input: node: Address
    Output: Integer
    Body: {
        // Check for pointer field write (ptr@field = value)
        // Target node stored in DATA2 when it's POINTER_FIELD_ACCESS
        target_node = AST_GetData2(node)
        
        IfCondition NotEqual(target_node, 0) ThenBlock: {
            target_type = AST_GetType(target_node)
            
            IfCondition EqualTo(target_type, AST.POINTER_FIELD_ACCESS) ThenBlock: {
                base_var = AST_GetData1(target_node)
                field_name = AST_GetData2(target_node)
                
                // Compile value expression -> RAX
                value_node = AST_GetChild(node, 0)
                result = Compile_Expression(value_node)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                
                // Write to field
                ReturnValue(CompilePool_FieldWriteSimple(base_var, field_name))
            }
        }
        
        // Normal variable assignment
        target_name = AST_GetData1(node)
        value_node = AST_GetChild(node, 0)
        Optimize_RaxDrop()
        Optimize_PtrClear(target_name)
        // A new value replaces the parked compare. The park may be set again
        // after this expression leaves the new value in RAX.
        IfCondition EqualTo(LoopHome.rdx_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(target_name, LoopHome.rdx_name), 1) ThenBlock: {
                LoopHome.rdx_on = 0
                LoopHome.rdx_name = 0
            }
        }
        
        IfCondition EqualTo(value_node, 0) ThenBlock: {
            PrintMessage("[COMPILE ERROR] Assignment with null value\n")
            Compile.error = 1
            ReturnValue(0)
        }

        Optimize_OutAssign(target_name, value_node)
        Optimize_XmmDrop(target_name)
        Optimize_CoalDrop(target_name)
        IfCondition EqualTo(Optimize_ZeroSkip(target_name, value_node), 1) ThenBlock: {
            Optimize_FlushHold()
            Optimize_AliasClear(target_name)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IndexDead(target_name, value_node), 1) ThenBlock: {
            Optimize_FlushHold()
            Optimize_AliasClear(target_name)
            ReturnValue(1)
        }
        fused = Optimize_TryFoldAssign(target_name, value_node)
        IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            Optimize_RcxDrop()
        }
        Optimize_FlushHold()
        fused = Optimize_TryDerivedDef(target_name)
        IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
        fused = Optimize_TryIpDef(target_name)
        IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
        fused = Optimize_TryIpDrop(target_name)
        IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
        fused = Optimize_TryReloadDrop(target_name, value_node)
        IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
        fused = Optimize_TryHomeAssign(target_name, value_node)
        IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
        fused = Optimize_TryLocArith(target_name, value_node)
        IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
        fused = Optimize_TryHomeMask(target_name, value_node)
        IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
        fused = Optimize_TryFieldUpdate(target_name, value_node)
        IfCondition EqualTo(fused, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_IsIntHome(target_name), 1) ThenBlock: {
            Optimize_AliasFlush()
        }
        
        // A float temp whose only consumer is a float op stays in xmm0.
        // The same predicate arms the hold after the expression succeeds.
        saved_xmm = OptState.xmm_out
        IfCondition EqualTo(Optimize_ArmReady(target_name, value_node), 1) ThenBlock: {
            OptState.xmm_out = 1
        }
        result = Compile_Expression(value_node)
        OptState.xmm_out = saved_xmm
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        Optimize_AliasClear(target_name)
        IfCondition EqualTo(Optimize_ArmHold(target_name, value_node), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_TryIntHold(target_name), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_TryCmpSkip(target_name), 1) ThenBlock: {
            Optimize_NotePtrCopy(target_name, value_node)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_TryRdxSkip(target_name), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_TryOffSkip(target_name), 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // Track pool type for LinkagePool assignments
        IfCondition NotEqual(Compile.pending_pool_type, 0) ThenBlock: {
            Scope_SetVarPoolType(target_name, Compile.pending_pool_type)
            Compile.pending_pool_type = 0
        }
        
        // Store RAX to variable
        stored = CompileExpr_StoreVariable(target_name)
        IfCondition EqualTo(stored, 0) ThenBlock: { ReturnValue(0) }
        Optimize_NotePtrCopy(target_name, value_node)
        ReturnValue(1)
    }
}


// =============================================================================
// POINTER FIELD ASSIGNMENT
// ptr@field = value
// =============================================================================
Function.CompileStmt_PointerFieldAssign {
    Input: node: Address
    Output: Integer
    Body: {
        base_var = AST_GetData1(node)
        field_name = AST_GetData2(node)
        value_node = AST_GetChild(node, 0)
        
        PrintMessage("[ASSIGN] ")
        PrintString(base_var)
        PrintMessage("@")
        PrintString(field_name)
        PrintMessage("\n")
        
        // Compile value expression -> RAX
        result = Compile_Expression(value_node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Write to field
        ReturnValue(CompilePool_FieldWriteSimple(base_var, field_name))
    }
}

// =============================================================================
// RETURN
// ReturnValue(expr)
// =============================================================================
Function.CompileStmt_Return {
    Input: node: Address
    Output: Integer
    Body: {
        // Get return value expression (first child)
        return_value = AST_GetChild(node, 0)
        
        IfCondition NotEqual(return_value, 0) ThenBlock: {
            // Compile return value -> RAX
            result = Compile_Expression(return_value)
            IfCondition EqualTo(result, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        
        // Jump to function exit label
        exit_label = Compile.current_return_label
        IfCondition GreaterEqual(exit_label, 0) ThenBlock: {
            Emit_Jmp(exit_label)
        } ElseBlock: {
            // Direct return if no exit label
            Emit_Ret()
        }
        
        ReturnValue(1)
    }
}

// =============================================================================
// IF STATEMENT
// IfCondition expr ThenBlock: { ... } ElseBlock: { ... }
// =============================================================================
Function.CompileStmt_If {
    Input: node: Address
    Output: Integer
    Body: {
        Optimize_OutKill()
        Optimize_XmmKill()
        Optimize_ZeroKill()
        condition = AST_GetChild(node, 0)
        then_block = AST_GetChild(node, 1)
        
        child_count = AST_GetChildCount(node)
        has_else = GreaterThan(child_count, 2)
        else_block = 0
        IfCondition EqualTo(has_else, 1) ThenBlock: {
            else_block = AST_GetChild(node, 2)
        }

        // Same accumulator, both arms a constant update: cmov, no diamond.
        picked = Optimize_TryIfSelect(condition, then_block, else_block)
        IfCondition EqualTo(picked, 1) ThenBlock: {
            Optimize_RcxDrop()
            ReturnValue(1)
        }
        IfCondition EqualTo(picked, 2) ThenBlock: {
            Optimize_RcxDrop()
            ReturnValue(0)
        }
        
        else_label = Compile_NewLabel()
        
        // Only create end_label if we have an else block
        end_label = 0
        IfCondition EqualTo(has_else, 1) ThenBlock: {
            end_label = Compile_NewLabel()
        }
        
        // A leaf compare does not write rcx. Anything else might, and the
        // false path must not keep a note the condition already killed.
        cx_quiet = Optimize_RcxQuiet(condition)
        IfCondition EqualTo(cx_quiet, 0) ThenBlock: {
            Optimize_RcxDrop()
        }
        saved_cx = LoopHome.rcx_on
        saved_cx_name = LoopHome.rcx_name
        saved_cx_base = LoopHome.rcx_base

        // A leaf compare jumps on flags. Anything else still materializes 0/1.
        handled = Optimize_TryBranchCondition(condition, else_label)
        IfCondition EqualTo(handled, 2) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(handled, 0) ThenBlock: {
            result = Compile_Expression(condition)
            IfCondition EqualTo(result, 0) ThenBlock: {
                ReturnValue(0)
            }
            Emit_TestRaxRax()
            Emit_Jz(else_label)
            Optimize_RcxDrop()
            saved_cx = 0
        }
        
        // The false jump left the compared local in RAX. Keep it for the
        // then-block. A then-block that does not fall through leaves that
        // same RAX at the else label, so the next load can skip the reload.
        saved_on = 0
        saved_name = 0
        saved_off = 0
        IfCondition EqualTo(LoopHome.rax_fresh, 1) ThenBlock: {
            saved_on = 1
            saved_name = LoopHome.rax_name
            saved_off = LoopHome.rax_off
        } ElseBlock: {
            Optimize_RaxDrop()
        }
        // Nested joins inside the then are not the false path. Restore
        // this note at the else label, then drop it only if the then joins.
        saved_rdx = LoopHome.rdx_on
        saved_rdx_name = LoopHome.rdx_name

        // Compile then block
        result = CompileStmt_Block(then_block)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Jump over else only if else exists
        IfCondition EqualTo(has_else, 1) ThenBlock: {
            Emit_Jmp(end_label)
        }
        
        // Mark else label (always - this is where we land if condition false)
        Emit_MarkLabel(else_label)
        IfCondition EqualTo(saved_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NoFall(then_block), 1) ThenBlock: {
                Optimize_RaxPin(saved_name, saved_off)
            } ElseBlock: {
                Optimize_RaxDrop()
            }
        } ElseBlock: {
            Optimize_RaxDrop()
        }
        // The false path did not run the then-block. A return leaves rcx
        // as it was. A fall-through may have written rcx, so the note dies.
        IfCondition EqualTo(saved_cx, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NoFall(then_block), 1) ThenBlock: {
                LoopHome.rcx_on = 1
                LoopHome.rcx_name = saved_cx_name
                LoopHome.rcx_base = saved_cx_base
            } ElseBlock: {
                Optimize_RcxDrop()
            }
        } ElseBlock: {
            Optimize_RcxDrop()
        }
        // False path did not run the then. Put the parked compare back,
        // then drop it when this then falls through after writing RDX.
        LoopHome.rdx_on = saved_rdx
        LoopHome.rdx_name = saved_rdx_name
        IfCondition EqualTo(has_else, 0) ThenBlock: {
            Optimize_RdxDropJoin(then_block)
        }
        
        // Compile else block if present
        IfCondition EqualTo(has_else, 1) ThenBlock: {
            result = CompileStmt_Block(else_block)
            IfCondition EqualTo(result, 0) ThenBlock: {
                ReturnValue(0)
            }
            Emit_MarkLabel(end_label)
            Optimize_RaxDrop()
            Optimize_RcxDrop()
            LoopHome.rdx_on = saved_rdx
            LoopHome.rdx_name = saved_rdx_name
            Optimize_RdxDropJoin(then_block)
            Optimize_RdxDropJoin(else_block)
        }
        
        ReturnValue(1)
    }
}

// =============================================================================
// WHILE LOOP
// WhileLoop condition { ... }
// =============================================================================
Function.CompileStmt_While {
    Input: node: Address
    Output: Integer
    Body: {
        // An inner loop can write RDX. The note does not cross it.
        // The back edge reaches this condition again, so rax must be reloaded.
        LoopHome.rdx_on = 0
        LoopHome.rdx_name = 0
        Optimize_RaxDrop()
        repeated = Optimize_TryRepeatSum(node)
        IfCondition EqualTo(repeated, 1) ThenBlock: { ReturnValue(1) }
        condition = AST_GetChild(node, 0)
        body = AST_GetChild(node, 1)
        Optimize_FoldBlock(body)
        // Constant-radix countdown. Fold first so the shape is the one
        // the rest of the compiler would have seen. The nest, when it
        // matches, owns the whole counted loop. Otherwise the digit
        // loop itself still compiles.
        nest = CompileArith_TryDigitNest(node)
        IfCondition EqualTo(nest, 1) ThenBlock: { ReturnValue(1) }
        digit = CompileArith_TryDigitLoop(node)
        IfCondition EqualTo(digit, 1) ThenBlock: { ReturnValue(1) }
        
        loop_start = Compile_NewLabel()
        loop_end = Compile_NewLabel()

        // A pure leaf compare can be re-run at the back edge with no side
        // effects, so the loop can be rotated: one-time entry test, then a
        // bottom test that jumps back on true. This drops the per-iteration
        // unconditional jmp that a top-tested loop always pays.
        rotate_elig = 0
        IfCondition EqualTo(AST_GetType(condition), AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(condition)), 1) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(condition), 2) ThenBlock: {
                    IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(condition, 0)), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(condition, 1)), 1) ThenBlock: {
                            rotate_elig = 1
                        }
                    }
                }
            }
        }

        // Homes stay off when an outer home already owns r13/xmm2.
        outer = LoopHome.active
        IfCondition EqualTo(outer, 0) ThenBlock: {
            Optimize_LoopHomes(condition, body)
            IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_LiveIn(LoopHome.int_name, condition, body), 1) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.int_off)
                    Emit_HomeMove(2, 0)
                }
            }
            IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_LiveIn(LoopHome.flt_name, condition, body), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_ZeroHas(LoopHome.flt_name), 1) ThenBlock: {
                        X86_PxorXmm(2)
                    } ElseBlock: {
                        Emit_MovRaxRbpOffset(LoopHome.flt_off)
                        Emit_HomeMove(6, 0)
                    }
                }
            }
            IfCondition NotEqual(LoopHome.acc_name, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_LiveIn(LoopHome.acc_name, condition, body), 1) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.acc_off)
                    Emit_HomeMove(17, 0)
                }
            }
            IfCondition EqualTo(LoopHome.rbx_free, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.lim_off)
                    Emit_MovRbxRax()
                }
            }
            Optimize_AllocXmmIn(condition)
            Optimize_AllocGprIn(condition)
            IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                Emit_MovRaxRbpOffset(LoopHome.tab_off)
                Emit_MovR14Rax()
            }
            IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: { LoopHome.active = 1 }
            IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: { LoopHome.active = 1 }
            IfCondition NotEqual(LoopHome.acc_name, 0) ThenBlock: { LoopHome.active = 1 }
            IfCondition EqualTo(Optimize_ExtraAny(), 1) ThenBlock: { LoopHome.active = 1 }
            IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: { LoopHome.active = 1 }
            IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: { LoopHome.active = 1 }
            IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: { LoopHome.active = 1 }
            IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
                Optimize_EmitDerived()
            }
            Optimize_EmitIp()
            Optimize_EmitProd()
            IfCondition EqualTo(LoopHome.kmul_on, 1) ThenBlock: {
                Emit_MovR11RbpOffset(LoopHome.kmul_off)
            }
            Optimize_TripArm()
        }

        // Trip loops already have an optimal pointer-compare back edge, and
        // a nested home inherits trip_on from the outer loop, so neither
        // case rotates here.
        rotate = 0
        IfCondition EqualTo(rotate_elig, 1) ThenBlock: {
            IfCondition EqualTo(outer, 0) ThenBlock: {
                IfCondition EqualTo(LoopHome.trip_on, 0) ThenBlock: { rotate = 1 }
            }
        }
        test_label = loop_start
        IfCondition EqualTo(rotate, 1) ThenBlock: {
            test_label = Compile_NewLabel()
        }

        // Push loop context for break/continue. Continue re-checks the
        // condition, so it targets the test (the back edge when rotated,
        // otherwise the same label as the top test).
        Compile_PushLoop(loop_end, test_label)

        // Inner k=0 pointers stay in r8/r10 across this loop.
        Optimize_OutHoist(body)

        // The trip back edge is the hot fetch. Land it on a 32-byte line.
        IfCondition EqualTo(LoopHome.trip_on, 1) ThenBlock: {
            X86_Align32()
        }

        IfCondition EqualTo(rotate, 0) ThenBlock: {
            Emit_MarkLabel(loop_start)
        }

        // A leaf compare jumps on flags. Anything else still materializes 0/1.
        handled = Optimize_TryBranchCondition(condition, loop_end)
        IfCondition EqualTo(handled, 2) ThenBlock: {
            IfCondition EqualTo(outer, 0) ThenBlock: { Optimize_HomeRelease() }
            Compile_PopLoop()
            ReturnValue(0)
        }
        IfCondition EqualTo(handled, 0) ThenBlock: {
            result = Compile_Expression(condition)
            IfCondition EqualTo(result, 0) ThenBlock: {
                IfCondition EqualTo(outer, 0) ThenBlock: { Optimize_HomeRelease() }
                Compile_PopLoop()
                ReturnValue(0)
            }
            Emit_TestRaxRax()
            Emit_Jz(loop_end)
        }

        // The back edge jumps straight to the body, past the one-time
        // entry test above.
        IfCondition EqualTo(rotate, 1) ThenBlock: {
            Emit_MarkLabel(loop_start)
        }

        // Compile body. A trip loop reloads its factors before the products.
        IfCondition EqualTo(LoopHome.trip_on, 1) ThenBlock: {
            Optimize_PinWarm()
        }
        saved_loop_cond = OutKeep.loop_cond
        OutKeep.loop_cond = condition
        result = CompileStmt_Block(body)
        OutKeep.loop_cond = saved_loop_cond
        IfCondition EqualTo(result, 0) ThenBlock: {
            IfCondition EqualTo(outer, 0) ThenBlock: { Optimize_HomeRelease() }
            Compile_PopLoop()
            ReturnValue(0)
        }
        
        // The next condition reads frame slots. A held temp is still only in a register.
        IfCondition EqualTo(LoopHome.fwd_on, 1) ThenBlock: {
            Optimize_FwdFail()
        }
        Optimize_IholdFlush()
        IfCondition EqualTo(rotate, 1) ThenBlock: {
            Emit_MarkLabel(test_label)
            back_handled = Optimize_TryBranchConditionBack(condition, loop_start)
            IfCondition EqualTo(back_handled, 2) ThenBlock: {
                IfCondition EqualTo(outer, 0) ThenBlock: { Optimize_HomeRelease() }
                Compile_PopLoop()
                ReturnValue(0)
            }
            IfCondition EqualTo(back_handled, 0) ThenBlock: {
                Emit_Jmp(loop_start)
            }
        } ElseBlock: {
            // A trip loop compares the stepped pointer with the end in r13.
            IfCondition EqualTo(LoopHome.trip_on, 1) ThenBlock: {
                X86_CmpRegReg(LoopHome.trip_reg, 13)
                X86_JneBack(loop_start)
            } ElseBlock: {
                Emit_Jmp(loop_start)
            }
        }

        // Mark loop end. Break lands here, then the homes spill once.
        Emit_MarkLabel(loop_end)

        IfCondition EqualTo(outer, 0) ThenBlock: {
            LoopHome.coal_on = 0
            LoopHome.coal_name = 0
            LoopHome.coal_slot = 0
            Optimize_AllocCoalClear()
            IfCondition EqualTo(LoopHome.fwd_on, 1) ThenBlock: {
                Optimize_FwdFail()
            }
            Optimize_IholdFlush()
            Optimize_FlushHold()
            Optimize_AliasFlush()
            saved_int = LoopHome.int_name
            saved_int_off = LoopHome.int_off
            saved_flt = LoopHome.flt_name
            saved_flt_off = LoopHome.flt_off
            saved_acc = LoopHome.acc_name
            saved_acc_off = LoopHome.acc_off
            saved_body = LoopHome.body
            saved_trip = LoopHome.trip_on
            saved_exit = LoopHome.trip_exit
            xmm_n = AllocTab.n
            Optimize_AllocXmmOut(LoopHome.body, xmm_n, 8, 14)
            Optimize_AllocGprOut(LoopHome.body, xmm_n)
            Optimize_HomeRelease()
            IfCondition NotEqual(saved_int, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_LiveOut(saved_int, saved_body), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_NextDefDead(saved_int), 0) ThenBlock: {
                        IfCondition EqualTo(saved_trip, 1) ThenBlock: {
                            Emit_MovRaxImm64(saved_exit)
                            Emit_HomeMove(2, 0)
                        }
                        Emit_HomeMove(1, 0)
                        Emit_MovRbpOffsetRax(saved_int_off)
                    }
                }
            }
            IfCondition NotEqual(saved_flt, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_LiveOut(saved_flt, saved_body), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_NextDefDead(saved_flt), 0) ThenBlock: {
                        Emit_HomeMove(5, 0)
                        Emit_MovRbpOffsetRax(saved_flt_off)
                    }
                }
            }
            IfCondition NotEqual(saved_acc, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_LiveOut(saved_acc, saved_body), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_NextDefDead(saved_acc), 0) ThenBlock: {
                        Emit_HomeMove(16, 0)
                        Emit_MovRbpOffsetRax(saved_acc_off)
                    }
                }
            }
            Optimize_AllocXmmOut(saved_body, xmm_n, 3, 7)
        }
        
        Compile_PopLoop()
        LoopHome.rdx_on = 0
        LoopHome.rdx_name = 0
        
        ReturnValue(1)
    }
}

// =============================================================================
// BLOCK
// { statement; statement; ... }
// =============================================================================
Function.CompileStmt_Block {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(1)  // Empty block OK
        }

        saved_block = OutKeep.block
        OutKeep.block = node
        Optimize_ZeroKill()
        Optimize_OutZeroArm(node)
        
        count = AST_GetChildCount(node)
        i = 0
        skip_at = -1
        swap_end = -1

        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Compile.error, 1) ThenBlock: {
                ExitLoop
            }
            
            child = AST_GetChild(node, i)
            IfCondition NotEqual(child, 0) ThenBlock: {
                child_type = AST_GetType(child)
                IfCondition NotEqual(child_type, AST.ASSIGNMENT) ThenBlock: {
                    // A hold spill writes rax before this statement. rcx is
                    // not part of that spill, so the raw-offset note dies.
                    spill = 0
                    IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: { spill = 1 }
                    IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: { spill = 1 }
                    IfCondition EqualTo(spill, 1) ThenBlock: {
                        Optimize_RcxDrop()
                    }
                    IfCondition EqualTo(LoopHome.fwd_on, 1) ThenBlock: {
                        Optimize_FwdFail()
                    }
                    // SetByte can consume the held byte. Anything else would
                    // clobber rax, and the float spill moves xmm0 through rax.
                    IfCondition EqualTo(Optimize_KeepIhold(child), 0) ThenBlock: {
                        Optimize_IholdFlush()
                    }
                    IfCondition EqualTo(Optimize_KeepIhold(child), 1) ThenBlock: {
                        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
                            IfCondition EqualTo(LoopHome.ihold_reg, 0) ThenBlock: {
                                Optimize_IholdPark()
                            }
                        }
                    }
                    Optimize_FlushHold()
                    keep = 0
                    IfCondition EqualTo(child_type, AST.WHILE) ThenBlock: { keep = 1 }
                    IfCondition EqualTo(child_type, AST.BLOCK) ThenBlock: { keep = 1 }
                    IfCondition EqualTo(child_type, AST.CALL) ThenBlock: {
                        cname = AST_GetData1(child)
                        IfCondition NotEqual(cname, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(cname, "StoreValue"), 0) ThenBlock: { keep = 1 }
                        }
                    }
                    IfCondition EqualTo(keep, 0) ThenBlock: {
                        Optimize_OutKill()
                        Optimize_XmmKill()
                    }
                }
                IfCondition EqualTo(Optimize_RcxKeep(child), 0) ThenBlock: {
                    Optimize_RcxDrop()
                }
            }
            handled = 0
            IfCondition GreaterEqual(swap_end, 0) ThenBlock: {
                IfCondition GreaterThan(i, swap_end) ThenBlock: {
                    swap_end = -1
                } ElseBlock: {
                    handled = 1
                }
            }
            IfCondition EqualTo(handled, 0) ThenBlock: {
                IfCondition EqualTo(i, OptState.divmod_mid) ThenBlock: {
                    OptState.divmod_mid = -1
                    handled = 1
                }
            }
            IfCondition EqualTo(handled, 0) ThenBlock: {
                IfCondition EqualTo(i, skip_at) ThenBlock: {
                    CompileArith_CommitQuot(child)
                    skip_at = -1
                    handled = 1
                }
            }
            IfCondition EqualTo(handled, 0) ThenBlock: {
                IfCondition LessThan(skip_at, 0) ThenBlock: {
                    paired = CompileArith_TryDivMod(node, i)
                    IfCondition GreaterEqual(paired, 0) ThenBlock: {
                        skip_at = paired
                        handled = 1
                    }
                    IfCondition EqualTo(paired, -2) ThenBlock: {
                        handled = 1
                    }
                }
            }
            IfCondition EqualTo(handled, 0) ThenBlock: {
                swapped = Optimize_TrySwapBlock(node, i, count)
                IfCondition GreaterEqual(swapped, 0) ThenBlock: {
                    swap_end = swapped
                    handled = 1
                }
            }
            IfCondition EqualTo(handled, 0) ThenBlock: {
                copied = Optimize_TryCopyBlock(node, i, count)
                IfCondition GreaterEqual(copied, 0) ThenBlock: {
                    swap_end = copied
                    handled = 1
                }
            }
            IfCondition EqualTo(handled, 0) ThenBlock: {
                shifted = Optimize_TryShiftBlock(node, i, count)
                IfCondition GreaterEqual(shifted, 0) ThenBlock: {
                    swap_end = shifted
                    handled = 1
                }
            }
            IfCondition EqualTo(handled, 0) ThenBlock: {
                saved_at = OutKeep.at
                OutKeep.at = i
                Compile_Node(child)
                OutKeep.at = saved_at
            }
            i = Add(i, 1)
        }

        Optimize_PinFlush()
        OutKeep.block = saved_block
        ReturnValue(1)
    }
}

// =============================================================================
// BREAK (ExitLoop/BreakLoop)
// Jumps to loop end label
// =============================================================================
Function.CompileStmt_Break {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Compile.loop_depth, 0) ThenBlock: {
            PrintMessage("[COMPILE ERROR] ExitLoop outside of loop\n")
            Compile.error = 1
            ReturnValue(0)
        }
        Optimize_IholdFlush()
        
        // Get break label from loop stack (first of pair)
        ctx_index = Subtract(Compile.loop_depth, 1)
        break_label = Array.Get(Compile.loop_stack, Multiply(ctx_index, 2))
        
        Emit_Jmp(break_label)
        ReturnValue(1)
    }
}

// =============================================================================
// CONTINUE (ContinueLoop)
// Jumps to loop start label (re-evaluate condition)
// =============================================================================
Function.CompileStmt_Continue {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Compile.loop_depth, 0) ThenBlock: {
            PrintMessage("[COMPILE ERROR] ContinueLoop outside of loop\n")
            Compile.error = 1
            ReturnValue(0)
        }
        Optimize_IholdFlush()
        
        // Get continue label from loop stack (second of pair)
        ctx_index = Subtract(Compile.loop_depth, 1)
        continue_label = Array.Get(Compile.loop_stack, Add(Multiply(ctx_index, 2), 1))
        
        Emit_Jmp(continue_label)
        ReturnValue(1)
    }
}

// =============================================================================
// FOREVERY
// ForEvery var in collection { body }
// 
// Strategy: Use dedicated stack frame slots for loop state
// This avoids R12/R13/R14 being clobbered by body compilation
// 
// Frame layout (relative to RBP):
//   [RBP-8]   = loop variable (element)
//   [RBP-16]  = index
//   [RBP-24]  = length  
//   [RBP-32]  = array address
// =============================================================================
Function.CompileStmt_ForEvery {
    Input: node: Address
    Output: Integer
    Body: {
        // AST: DATA1=var_name, children=[iterable, body]
        var_name = AST_GetData1(node)
        iterable = AST_GetChild(node, 0)
        body = AST_GetChild(node, 1)
        
        // Allocate stack space for loop state (4 slots = 32 bytes)
        base_offset = Compile.stack_offset
        Compile.stack_offset = Add(Compile.stack_offset, 32)
        
        off_var = Subtract(0, Add(base_offset, 8))
        off_index = Subtract(0, Add(base_offset, 16))
        off_length = Subtract(0, Add(base_offset, 24))
        off_array = Subtract(0, Add(base_offset, 32))
        
        // Register loop variable so body can access it
        Compile_RegisterLocal(var_name, off_var)
        
        // Labels
        loop_start = Emit_CreateLabel()
        loop_end = Emit_CreateLabel()
        
        Compile_PushLoop(loop_end, loop_start)
        
        // Compile iterable -> RAX
        Compile_Expression(iterable)
        
        // Store array address
        Emit_MovRbpOffsetRax(off_array)
        
        // Get length (stored at array[0])
        Emit_MovRaxDerefRax()
        Emit_MovRbpOffsetRax(off_length)
        
        // Initialize index = 0
        Emit_MovRaxImm64(0)
        Emit_MovRbpOffsetRax(off_index)
        
        // LOOP START
        Emit_MarkLabel(loop_start)
        
        // Load index and length, compare
        Emit_MovRaxRbpOffset(off_index)
        Emit_MovRbxRax()
        Emit_MovRaxRbpOffset(off_length)
        Emit_CmpRbxRax()
        Emit_Jge(loop_end)
        
        // Get element: array + 8 + index*8
        Emit_MovRaxRbpOffset(off_array)
        Emit_AddRaxImm8(8)
        Emit_MovRegReg(Reg.RCX, Reg.RBX)
        Emit_ShlRcxImm8(3)
        Emit_AddRaxRcx()
        Emit_MovRaxDerefRax()
        
        // Store to loop variable
        Emit_MovRbpOffsetRax(off_var)
        
        // Compile body
        CompileStmt_Block(body)
        
        // Increment index
        Emit_MovRaxRbpOffset(off_index)
        Emit_IncRax()
        Emit_MovRbpOffsetRax(off_index)
        
        Emit_Jmp(loop_start)
        
        // LOOP END
        Emit_MarkLabel(loop_end)
        
        Compile_PopLoop()
        
        ReturnValue(1)
    }
}


// =============================================================================
// SWITCH / BRANCH
// Branch expr { Case val: { ... } Case val: { ... } Default: { ... } }
//
// Two lowering strategies, picked by a one-line scan of case values:
//
//   FAST PATH — all Case values are AST.NUMBER literals (the common
//   case, covers every enum-style dispatch). Expression is compiled
//   once into RAX, then each case emits exactly `CMP RAX, imm32; JE`
//   — 2 instructions per case. No stack use, so ReturnValue inside a
//   Case body tears down the frame with a clean stack automatically.
//
//   SLOW PATH — at least one Case value is a non-literal expression
//   (function call, arithmetic, identifier). Expression is pushed to
//   the stack so it survives re-evaluation across cases. Each case
//   peeks the saved value, compiles its value into RAX, compares.
//   Every landing point pops once before user code runs so a Case-body
//   ReturnValue still tears down cleanly.
//
// Fast path is typically 7x fewer instructions per case than the
// slow path — that's the measured difference that caused the earlier
// Branch-vs-IfCondition-chain regression.
// =============================================================================

// Fast path: all Case values are AST.NUMBER literals.
// Per case: 2 instructions (CMP RAX, imm32 ; JE label).
// Expression stays in RAX across all comparisons — no stack, no
// push/pop. Case bodies run with a clean stack so ReturnValue
// propagates to the function epilogue naturally.
Function.CompileStmt_SwitchFast {
    Input: node: Address
    Output: Integer
    Body: {
        child_count = AST_GetChildCount(node)
        expr = AST_GetChild(node, 0)

        // Compile expression -> RAX. It stays there across all CMPs.
        result = Compile_Expression(expr)
        IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(0) }

        end_label = Compile_NewLabel()

        // Locate the Default clause (if any) and allocate its label.
        default_node = 0
        default_label = 0
        i = 1
        WhileLoop LessThan(i, child_count) {
            case_child = AST_GetChild(node, i)
            IfCondition EqualTo(AST_GetType(case_child), AST.DEFAULT) ThenBlock: {
                default_node = case_child
            }
            i = Add(i, 1)
        }
        IfCondition NotEqual(default_node, 0) ThenBlock: {
            default_label = Compile_NewLabel()
        }

        // ----- COMPARISON CHAIN: CMP RAX, imm32 ; JE case_body -----
        i = 1
        WhileLoop LessThan(i, child_count) {
            case_child = AST_GetChild(node, i)
            IfCondition EqualTo(AST_GetType(case_child), AST.CASE) ThenBlock: {
                case_value_node = AST_GetChild(case_child, 0)
                val_str = AST_GetData1(case_value_node)
                val     = StringToNumber(val_str)
                case_body_label = Compile_NewLabel()

                Emit_CmpRaxImm32(val)
                Emit_Je(case_body_label)

                AST_SetData2(case_child, case_body_label)
            }
            i = Add(i, 1)
        }

        // ----- NO MATCH: fall through to default_or_end -----
        IfCondition NotEqual(default_node, 0) ThenBlock: {
            Emit_Jmp(default_label)
        } ElseBlock: {
            Emit_Jmp(end_label)
        }

        // ----- CASE BODIES ----- (no stack cleanup needed)
        i = 1
        WhileLoop LessThan(i, child_count) {
            case_child = AST_GetChild(node, i)
            IfCondition EqualTo(AST_GetType(case_child), AST.CASE) ThenBlock: {
                case_body_label = AST_GetData2(case_child)
                Emit_MarkLabel(case_body_label)
                case_body = AST_GetChild(case_child, 1)
                IfCondition NotEqual(case_body, 0) ThenBlock: {
                    result = CompileStmt_Block(case_body)
                    IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(0) }
                }
                Emit_Jmp(end_label)
            }
            i = Add(i, 1)
        }

        // ----- DEFAULT BODY -----
        IfCondition NotEqual(default_node, 0) ThenBlock: {
            Emit_MarkLabel(default_label)
            default_body = AST_GetChild(default_node, 0)
            IfCondition NotEqual(default_body, 0) ThenBlock: {
                result = CompileStmt_Block(default_body)
                IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(0) }
            }
            // Falls through to end_label.
        }

        // ----- END -----
        Emit_MarkLabel(end_label)
        ReturnValue(1)
    }
}

Function.CompileStmt_Switch {
    Input: node: Address
    Output: Integer
    Body: {
        // Get child count: first child is expression, rest are cases/default
        child_count = AST_GetChildCount(node)

        IfCondition LessThan(child_count, 1) ThenBlock: {
            PrintMessage("[COMPILE ERROR] Branch with no expression\n")
            Compile.error = 1
            ReturnValue(0)
        }

        // Pre-scan: are all Case values AST.NUMBER literals? If so
        // we can skip the stack-save dance entirely.
        all_literal = 1
        pi = 1
        WhileLoop LessThan(pi, child_count) {
            case_child = AST_GetChild(node, pi)
            IfCondition EqualTo(AST_GetType(case_child), AST.CASE) ThenBlock: {
                case_value_node = AST_GetChild(case_child, 0)
                IfCondition NotEqual(AST_GetType(case_value_node), AST.NUMBER) ThenBlock: {
                    all_literal = 0
                }
            }
            pi = Add(pi, 1)
        }

        IfCondition EqualTo(all_literal, 1) ThenBlock: {
            ReturnValue(CompileStmt_SwitchFast(node))
        }

        // ===== SLOW PATH (non-literal case values) =====
        // Get expression (first child)
        expr = AST_GetChild(node, 0)

        // Compile expression -> RAX
        result = Compile_Expression(expr)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Push expression value to stack (we'll compare against this repeatedly)
        Emit_PushRax()
        
        // Create end label
        end_label = Compile_NewLabel()
        
        // Count cases and find default
        case_count = Subtract(child_count, 1)
        default_node = 0
        default_label = 0
        
        // First pass: create labels for each case body and find default
        // We'll store labels in a simple approach - compile inline
        
        // Create labels for case bodies
        i = 1
        WhileLoop LessThan(i, child_count) {
            case_child = AST_GetChild(node, i)
            case_type = AST_GetType(case_child)
            
            IfCondition EqualTo(case_type, AST.DEFAULT) ThenBlock: {
                default_node = case_child
            }
            
            i = Add(i, 1)
        }
        
        // Create default label if we have a default
        IfCondition NotEqual(default_node, 0) ThenBlock: {
            default_label = Compile_NewLabel()
        }
        
        // ===== COMPARISON CHAIN =====
        // For each CASE, compare and jump if match
        i = 1
        WhileLoop LessThan(i, child_count) {
            case_child = AST_GetChild(node, i)
            case_type = AST_GetType(case_child)
            
            IfCondition EqualTo(case_type, AST.CASE) ThenBlock: {
                // Get case value (child 0 of CASE node)
                case_value_node = AST_GetChild(case_child, 0)
                
                // Create label for this case's body
                case_body_label = Compile_NewLabel()
                
                // Load saved expression value: MOV RAX, [RSP]
                // (peek at stack without popping)
                Emit_MovRaxDerefRsp()
                
                // Compile case value -> RCX
                // We need to preserve RAX, so push it
                Emit_PushRax()
                result = Compile_Expression(case_value_node)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                // RAX now has case value, move to RCX
                Emit_MovRcxRax()
                // Restore expression value to RAX
                Emit_PopRax()
                
                // CMP RAX, RCX
                Emit_CmpRaxRcx()
                
                // JE to case body
                Emit_Je(case_body_label)
                
                // Store the case info for body compilation
                // We'll compile bodies in a second pass
                AST_SetData2(case_child, case_body_label)
            }
            
            i = Add(i, 1)
        }
        
        // ===== NO MATCH - GO TO DEFAULT OR END =====
        // Invariant: every *landing point* inside the Branch pops the
        // saved expression exactly once before user code runs, so
        // `ReturnValue` inside a Case body tears down the frame with a
        // clean stack. The only path that doesn't land at a pop is
        // "no match, no default" -> end_label directly, so that path
        // pops here before jumping. The "no match, with default" path
        // jumps straight to default_label, which pops itself.
        IfCondition NotEqual(default_node, 0) ThenBlock: {
            Emit_Jmp(default_label)
        } ElseBlock: {
            Emit_PopRax()
            Emit_Jmp(end_label)
        }

        // ===== COMPILE CASE BODIES =====
        i = 1
        WhileLoop LessThan(i, child_count) {
            case_child = AST_GetChild(node, i)
            case_type = AST_GetType(case_child)

            IfCondition EqualTo(case_type, AST.CASE) ThenBlock: {
                // Get the label we stored
                case_body_label = AST_GetData2(case_child)

                // Mark label
                Emit_MarkLabel(case_body_label)

                // Clean stack BEFORE running user code so ReturnValue
                // inside the body tears down the frame correctly.
                Emit_PopRax()

                // Get body (child 1 of CASE node)
                case_body = AST_GetChild(case_child, 1)

                // Compile body
                IfCondition NotEqual(case_body, 0) ThenBlock: {
                    result = CompileStmt_Block(case_body)
                    IfCondition EqualTo(result, 0) ThenBlock: {
                        ReturnValue(0)
                    }
                }

                // Jump to end (no fall-through)
                Emit_Jmp(end_label)
            }

            i = Add(i, 1)
        }

        // ===== DEFAULT BODY =====
        IfCondition NotEqual(default_node, 0) ThenBlock: {
            Emit_MarkLabel(default_label)

            // Clean stack before default user code (same reason as Case).
            Emit_PopRax()

            // Get default body (child 0 of DEFAULT node)
            default_body = AST_GetChild(default_node, 0)

            IfCondition NotEqual(default_body, 0) ThenBlock: {
                result = CompileStmt_Block(default_body)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
            // Fall through to end_label. No pop here — already done above.
        }

        // ===== END =====
        // Every incoming path has already popped. No further cleanup.
        Emit_MarkLabel(end_label)

        ReturnValue(1)
    }
}


// =============================================================================
// FORK
// Fork condition TrueBlock: { ... } FalseBlock: { ... }
// Same as IfCondition but different syntax
// =============================================================================
Function.CompileStmt_Fork {
    Input: node: Address
    Output: Integer
    Body: {
        condition = AST_GetChild(node, 0)
        true_block = AST_GetChild(node, 1)
        
        child_count = AST_GetChildCount(node)
        has_false = GreaterThan(child_count, 2)
        false_block = 0
        IfCondition EqualTo(has_false, 1) ThenBlock: {
            false_block = AST_GetChild(node, 2)
        }
        
        false_label = Emit_CreateLabel()
        end_label = 0
        IfCondition EqualTo(has_false, 1) ThenBlock: {
            end_label = Emit_CreateLabel()
        }
        
        // A leaf compare jumps on flags. Anything else still materializes 0/1.
        handled = Optimize_TryBranchCondition(condition, false_label)
        IfCondition EqualTo(handled, 2) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(handled, 0) ThenBlock: {
            result = Compile_Expression(condition)
            IfCondition EqualTo(result, 0) ThenBlock: {
                ReturnValue(0)
            }
            Emit_TestRaxRax()
            Emit_Jz(false_label)
        }
        
        result = CompileStmt_Block(true_block)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition EqualTo(has_false, 1) ThenBlock: {
            Emit_Jmp(end_label)
        }
        
        Emit_MarkLabel(false_label)
        
        IfCondition EqualTo(has_false, 1) ThenBlock: {
            result = CompileStmt_Block(false_block)
            IfCondition EqualTo(result, 0) ThenBlock: {
                ReturnValue(0)
            }
            Emit_MarkLabel(end_label)
        }
        
        ReturnValue(1)
    }
}

// =============================================================================
// TRY/CATCH/FINALLY
// TryBlock { ... } CatchError e { ... } FinallyBlock { ... }
// Basic implementation - no actual exception handling, just structured flow
// =============================================================================
Function.CompileStmt_Try {
    Input: node: Address
    Output: Integer
    Body: {
        // AST structure: children=[try_body, catch_block?, finally_block?]
        try_body = AST_GetChild(node, 0)
        
        child_count = AST_GetChildCount(node)
        catch_block = 0
        finally_block = 0
        
        IfCondition GreaterEqual(child_count, 2) ThenBlock: {
            catch_block = AST_GetChild(node, 1)
        }
        IfCondition GreaterEqual(child_count, 3) ThenBlock: {
            finally_block = AST_GetChild(node, 2)
        }
        
        catch_label = Emit_CreateLabel()
        finally_label = Emit_CreateLabel()
        end_label = Emit_CreateLabel()
        
        // Save error state location (use a global or thread-local)
        // For simple impl: Compile.error_handler_addr = catch_label
        
        result = CompileStmt_Block(try_body)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // No error: skip catch, go to finally
        Emit_Jmp(finally_label)
        
        // Catch block (jumped to on error)
        Emit_MarkLabel(catch_label)
        IfCondition NotEqual(catch_block, 0) ThenBlock: {
            result = CompileStmt_Block(catch_block)
            IfCondition EqualTo(result, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        
        // Finally block (always runs)
        Emit_MarkLabel(finally_label)
        IfCondition NotEqual(finally_block, 0) ThenBlock: {
            result = CompileStmt_Block(finally_block)
            IfCondition EqualTo(result, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        
        Emit_MarkLabel(end_label)
        
        ReturnValue(1)
    }
}


// =============================================================================
// LOOP CONTEXT HELPERS
// =============================================================================
Function.Compile_PushLoop {
    Input: break_label: Integer
    Input: continue_label: Integer
    Body: {
        Array.Push(Compile.loop_stack, break_label)
        Array.Push(Compile.loop_stack, continue_label)
        Compile.loop_depth = Add(Compile.loop_depth, 1)
    }
}

Function.Compile_PopLoop {
    Body: {
        IfCondition GreaterThan(Compile.loop_depth, 0) ThenBlock: {
            Array.Pop(Compile.loop_stack)
            Array.Pop(Compile.loop_stack)
            Compile.loop_depth = Subtract(Compile.loop_depth, 1)
        }
    }
}

// =============================================================================
// INLINE ASSEMBLY EMITTER
// Parses space-separated hex bytes from AST DATA1 string and emits them
// directly into the code stream.  e.g. InlineAsm["48 ff c0"] -> INC RAX
// =============================================================================
Function.InlineAsm_HexNibble {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
            ReturnValue(Subtract(c, 48))
        }
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 102)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 97), 10))
        }
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 70)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 65), 10))
        }
        ReturnValue(0)
    }
}

Function.CompileStmt_InlineAsm {
    Input: node: Address
    Output: Integer
    Body: {
        asm_str = AST_GetData1(node)
        IfCondition EqualTo(asm_str, 0) ThenBlock: {
            ReturnValue(1)
        }

        len = StringLength(asm_str)
        IfCondition EqualTo(len, 0) ThenBlock: {
            ReturnValue(1)
        }

        // Inline asm can read a frame slot the tag scan cannot see.
        EmitTag_Add(Emit.code_size, 0, TagClass.ASM, 0)

        // Peek at first non-whitespace char to decide hex vs mnemonic mode
        first_c = 0
        pi = 0
        WhileLoop LessThan(pi, len) {
            fc = GetByte(asm_str, pi)
            IfCondition And(NotEqual(fc, 32), NotEqual(fc, 9)) ThenBlock: {
                first_c = fc
                pi = len
            }
            pi = Add(pi, 1)
        }

        // A-Z or a-z -> mnemonic; everything else -> raw hex
        is_mnemonic = 0
        IfCondition And(GreaterEqual(first_c, 65), LessEqual(first_c, 90)) ThenBlock: {
            is_mnemonic = 1
        }
        IfCondition And(GreaterEqual(first_c, 97), LessEqual(first_c, 122)) ThenBlock: {
            is_mnemonic = 1
        }

        IfCondition EqualTo(is_mnemonic, 1) ThenBlock: {
            X86Enc_Assemble(asm_str)
            ReturnValue(1)
        }

        // --- Raw hex path (legacy, e.g. InlineAsm["90"] or InlineAsm["48 ff c0"]) ---
        i = 0
        WhileLoop LessThan(i, len) {
            c = GetByte(asm_str, i)

            IfCondition EqualTo(c, 32) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
                IfCondition EqualTo(c, 9) ThenBlock: {
                    i = Add(i, 1)
                } ElseBlock: {
                    IfCondition LessThan(i, Subtract(len, 1)) ThenBlock: {
                        hi = GetByte(asm_str, i)
                        lo = GetByte(asm_str, Add(i, 1))
                        byte_val = Add(Multiply(InlineAsm_HexNibble(hi), 16), InlineAsm_HexNibble(lo))
                        Emit_Byte(byte_val)
                        i = Add(i, 2)
                    } ElseBlock: {
                        i = Add(i, 1)
                    }
                }
            }
        }

        ReturnValue(1)
    }
}