// Library.CCompileStringCore.ailang
// Uses ONLY Emit_* functions - NO raw bytes in compile modules
// FIXED: All allocations now use Arena_Alloc instead of raw mmap (no more leaks!)

LibraryImport.Arena


LibraryImport.Compiler.Compile.CCompileMain
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch


// =============================================================================
// INLINE STRING COMPARISON HELPER
// Used to avoid chicken-and-egg: can't use StringCompare to dispatch StringCompare!
// =============================================================================
Function.StringCore_MatchName {
    Input: func_name: Address
    Input: target: Address
    Output: Integer
    Body: {
        // Safety checks - pointer equality first (fast path)
        IfCondition EqualTo(func_name, target) ThenBlock: { 
            ReturnValue(1) 
        }
        
        // Null checks
        IfCondition EqualTo(func_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        
        // Manual byte-by-byte comparison
        i = 0
        WhileLoop LessThan(i, 64) {
            ptr1 = Add(func_name, i)
            ptr2 = Add(target, i)
            
            c1 = BitwiseAnd(Dereference(ptr1), 255)
            c2 = BitwiseAnd(Dereference(ptr2), 255)
            
            IfCondition EqualTo(c1, 0) ThenBlock: {
                IfCondition EqualTo(c2, 0) ThenBlock: {
                    ReturnValue(1)
                }
                ReturnValue(0)
            }
            
            IfCondition EqualTo(c2, 0) ThenBlock: {
                ReturnValue(0)
            }
            
            IfCondition NotEqual(c1, c2) ThenBlock: {
                ReturnValue(0)
            }
            
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// MODULE DISPATCHER
// Scalar fallback - SSE2 handles: StringLength, StringCompare, StringEquals,
//     StringCopy, StringIndexOf, StringContains
// =============================================================================
Function.CompileStringCore_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        func_name = AST_GetData1(node)
        IfCondition EqualTo(func_name, 0) ThenBlock: { ReturnValue(0) }
        
        // Existing
        match = StringCore_MatchName(func_name, "StringConcat")
        IfCondition EqualTo(match, 1) ThenBlock: {
            ReturnValue(CompileStringCore_Concat(node))
        }
        
                
        match = StringCore_MatchName(func_name, "NumberToString")
        IfCondition EqualTo(match, 1) ThenBlock: {
            ReturnValue(CompileStringCore_NumberToString(node))
        }
        
        match = StringCore_MatchName(func_name, "StringToNumber")
        IfCondition EqualTo(match, 1) ThenBlock: {
            ReturnValue(CompileStringCore_StringToNumber(node))
        }
        
        // NEW: StringSubstring
        match = StringCore_MatchName(func_name, "StringSubstring")
        IfCondition EqualTo(match, 1) ThenBlock: {
            ReturnValue(CompileStringCore_Substring(node))
        }
        
        match = StringCore_MatchName(func_name, "StringExtract")
        IfCondition EqualTo(match, 1) ThenBlock: {
            ReturnValue(CompileStringCore_Substring(node))
        }
        
        // NEW: StringCharAt
        match = StringCore_MatchName(func_name, "StringCharAt")
        IfCondition EqualTo(match, 1) ThenBlock: {
            ReturnValue(CompileStringCore_CharAt(node))
        }
        
        // NEW: StringFromChar
        match = StringCore_MatchName(func_name, "StringFromChar")
        IfCondition EqualTo(match, 1) ThenBlock: {
            ReturnValue(CompileStringCore_FromChar(node))
        }
        
        // NEW: StringToUpper
        match = StringCore_MatchName(func_name, "StringToUpper")
        IfCondition EqualTo(match, 1) ThenBlock: {
            ReturnValue(CompileStringCore_ToUpper(node))
        }
        
        // NEW: StringToLower
        match = StringCore_MatchName(func_name, "StringToLower")
        IfCondition EqualTo(match, 1) ThenBlock: {
            ReturnValue(CompileStringCore_ToLower(node))
        }
        
        // NEW: StringTrim
        match = StringCore_MatchName(func_name, "StringTrim")
        IfCondition EqualTo(match, 1) ThenBlock: {
            ReturnValue(CompileStringCore_Trim(node))
        }
        
        ReturnValue(0)
    }
}



// =============================================================================
// STRINGCONCAT (2 args, internal allocation via mmap)
// StringConcat(str1, str2) - allocates buffer, returns new string
// Matches Python compiler behavior
// =============================================================================
// =============================================================================
// STRINGCONCAT (2 args, stack-based) - FIXED
// =============================================================================
Function.CompileStringCore_Concat {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            Compile_Error("StringConcat requires 2 arguments", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        // Save ALL callee-saved registers we use
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushR14()
        
        // Compile args and save on stack
        Compile_Expression(arg0)
        Emit_PushRax()  // str1 on stack
        
        Compile_Expression(arg1)
        Emit_PushRax()  // str2 on stack
        
        // Pop into registers
        Emit_PopR14()   // str2
        Emit_PopR13()   // str1
        
        // Calculate len1
        Emit_MovRdiR13()
        Emit_XorRcxRcx()
        
        len1_loop = Emit_CreateLabel()
        len1_done = Emit_CreateLabel()
        
        Emit_MarkLabel(len1_loop)
        Emit_CmpByteRdiRcxZero()
        Emit_Je(len1_done)
        Emit_IncRcx()
        Emit_Jmp(len1_loop)
        Emit_MarkLabel(len1_done)
        
        Emit_MovRbxRcx()  // RBX = len1
        
        // Calculate len2
        Emit_MovRdiR14()
        Emit_XorRcxRcx()
        
        len2_loop = Emit_CreateLabel()
        len2_done = Emit_CreateLabel()
        
        Emit_MarkLabel(len2_loop)
        Emit_CmpByteRdiRcxZero()
        Emit_Je(len2_done)
        Emit_IncRcx()
        Emit_Jmp(len2_loop)
        Emit_MarkLabel(len2_done)
        
        // Total = len1 + len2 + 1
        Emit_AddRcxRbx()
        Emit_IncRcx()
        
        // --- Arena allocation with R13/R14 protection ---
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            Compile_Error("Arena_Alloc not found", AST_GetLine(node))
            ReturnValue(0)
        }

        // Move size to RDI FIRST (while RCX still valid)
        Emit_MovRegReg(Reg.RDI, Reg.RCX)

        // Save R13, R14 across the call (RCX no longer needed)
        Emit_PushR13()
        Emit_PushR14()

        // Align stack, call Arena_Alloc
        Emit_MovRegReg(Reg.R12, Reg.RSP)
        Emit_AndRspImm8(240)
        // RDI already has size
        Emit_Call(arena_label)
        Emit_MovRegReg(Reg.RSP, Reg.R12)

        // Restore string pointers
        Emit_PopR14()   // str2
        Emit_PopR13()   // str1
        // --- End arena allocation ---
                
        // RAX = buffer, save in R12
        Emit_MovR12Rax()
        Emit_MovRdiRax()
        
        // Copy str1 from R13
        Emit_MovRsiR13()
        
        copy1_loop = Emit_CreateLabel()
        copy1_done = Emit_CreateLabel()
        
        Emit_MarkLabel(copy1_loop)
        Emit_MovClDerefRsi()
        Emit_TestClCl()
        Emit_Jz(copy1_done)
        Emit_MovDerefRdiCl()
        Emit_IncRsi()
        Emit_IncRdi()
        Emit_Jmp(copy1_loop)
        Emit_MarkLabel(copy1_done)
        
        // Copy str2 from R14
        Emit_MovRsiR14()
        
        copy2_loop = Emit_CreateLabel()
        copy2_done = Emit_CreateLabel()
        
        Emit_MarkLabel(copy2_loop)
        Emit_MovClDerefRsi()
        Emit_TestClCl()
        Emit_Jz(copy2_done)
        Emit_MovDerefRdiCl()
        Emit_IncRsi()
        Emit_IncRdi()
        Emit_Jmp(copy2_loop)
        Emit_MarkLabel(copy2_done)
        
        // Null terminate
        Emit_MovByteDerefRdiZero()
        
        // Return buffer from R12
        Emit_MovRaxR12()
        
        // Restore ALL callee-saved
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}



// =============================================================================
// NUMBERTOSTRING 
// =============================================================================
Function.CompileStringCore_NumberToString {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("NumberToString requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        // Compile the number argument -> RAX
        Compile_Expression(arg0)
        
        // Save callee-saved registers
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushR14()
        
        // R12 = number to convert
        Emit_MovR12Rax()
        
        // Find Arena_Alloc
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            Compile_Error("Arena_Alloc not found - ensure LibraryImport.Arena", AST_GetLine(node))
            ReturnValue(0)
        }
        
        // Allocate 24 bytes (enough for -9223372036854775808 + null)
        Emit_PushR12()  // save number across call
        Emit_MovRegReg(Reg.R13, Reg.RSP)
        Emit_AndRspImm8(240)
        Emit_MovRdiImm64(24)
        Emit_Call(arena_label)
        Emit_MovRegReg(Reg.RSP, Reg.R13)
        Emit_PopR12()   // restore number
        
        // RAX = buffer
        // R14 = pointer to end of buffer (buffer + 22), position 23 is null
        Emit_MovR14Rax()
        Emit_AddRaxImm8(22)
        Emit_MovR14Rax()
        
        // Store null terminator at buffer + 23
        Emit_IncReg(Reg.R14)
        Emit_XorRdxRdx()
        Emit_MovByteR14Dl()   // store 0 at [R14]
        Emit_DecReg(Reg.R14)   // back to position 22
        
        // RBX = 10 (divisor)
        Emit_MovRbxImm64(10)
        
        // R13 = 0 (sign flag: 0=positive, 1=negative)
        Emit_XorRegReg(Reg.R13, Reg.R13)
        
        // Labels
        is_positive = Emit_CreateLabel()
        is_zero = Emit_CreateLabel()
        do_convert = Emit_CreateLabel()
        convert_loop = Emit_CreateLabel()
        loop_done = Emit_CreateLabel()
        skip_minus = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        // Check if negative
        Emit_TestR12R12()
        Emit_Jns(is_positive)
        
        // Negative: set flag, negate
        Emit_MovRaxImm64(1)
        Emit_MovR13Rax()
        Emit_NegReg(Reg.R12)
        
        Emit_MarkLabel(is_positive)
        
        // Check for zero special case
        Emit_TestR12R12()
        Emit_Jz(is_zero)
        Emit_Jmp(do_convert)
        
        Emit_MarkLabel(is_zero)
        // Store '0' (ASCII 48)
        Emit_MovRdxImm64(48)
        Emit_MovByteR14Dl()
        Emit_Jmp(done_label)
        
        Emit_MarkLabel(do_convert)
        
        // Convert loop: divide by 10, store digit
        Emit_MarkLabel(convert_loop)
        Emit_TestR12R12()
        Emit_Jz(loop_done)
        
        // RAX = R12, divide by 10
        Emit_MovRaxR12()
        Emit_XorRdxRdx()
        Emit_DivRbx()
        
        // RDX = remainder (digit), add '0' (48)
        Emit_AddRdxImm32(48)
        
        // Store digit at [R14]
        Emit_MovByteR14Dl()
        Emit_DecReg(Reg.R14)
        
        // R12 = quotient
        Emit_MovR12Rax()
        Emit_Jmp(convert_loop)
        
        Emit_MarkLabel(loop_done)
        
        // R14 now points one before first digit, move forward
        Emit_IncReg(Reg.R14)
        
        // If negative, add '-' before first digit
        Emit_TestR13R13()
        Emit_Jz(skip_minus)
        Emit_DecReg(Reg.R14)
        Emit_MovRdxImm64(45)   // '-' = 45
        Emit_MovByteR14Dl()
        Emit_MarkLabel(skip_minus)
        
        Emit_MarkLabel(done_label)
        
        // Return R14 (pointer to start of string)
        Emit_MovRaxR14()
        
        // Restore callee-saved
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGTONUMBER - STUB  
// =============================================================================
Function.CompileStringCore_StringToNumber {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("StringToNumber requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        // Compile the string argument -> RAX (pointer to string)
        Compile_Expression(arg0)
        
        // Save callee-saved registers
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        
        // RSI = string pointer
        Emit_MovRegReg(Reg.RSI, Reg.RAX)
        
        // R12 = result accumulator (starts at 0)
        Emit_XorRegReg(Reg.R12, Reg.R12)
        
        // R13 = sign (0 = positive, 1 = negative)
        Emit_XorRegReg(Reg.R13, Reg.R13)
        
        // RBX = 10 (multiplier)
        Emit_MovRegImm64(Reg.RBX, 10)
        
        // Skip leading whitespace
        skip_space = Emit_CreateLabel()
        check_sign = Emit_CreateLabel()
        next_char_skip = Emit_CreateLabel()
        
        Emit_MarkLabel(skip_space)
        Emit_MovzxRaxBytePtrRsi()            // RAX = *RSI (zero-extended byte)
        
        // Check for space (32) or tab (9)
        Emit_CmpRaxImm8(32)
        Emit_Je(next_char_skip)
        Emit_CmpRaxImm8(9)
        Emit_Je(next_char_skip)
        Emit_Jmp(check_sign)
        
        Emit_MarkLabel(next_char_skip)
        Emit_IncRsi()
        Emit_Jmp(skip_space)
        
        Emit_MarkLabel(check_sign)
        
        // Check for sign
        check_minus = Emit_CreateLabel()
        check_plus = Emit_CreateLabel()
        digit_loop = Emit_CreateLabel()
        
        Emit_CmpRaxImm8(45)                  // '-'
        Emit_Jne(check_plus)
        Emit_MovRegImm64(Reg.R13, 1)         // negative
        Emit_IncRsi()
        Emit_Jmp(digit_loop)
        
        Emit_MarkLabel(check_plus)
        Emit_CmpRaxImm8(43)                  // '+'
        Emit_Jne(digit_loop)
        Emit_IncRsi()                        // skip '+'
        
        // Digit parsing loop
        Emit_MarkLabel(digit_loop)
        Emit_MovzxRaxBytePtrRsi()            // RAX = *RSI
        
        // Check if digit (48 <= c <= 57)
        loop_done = Emit_CreateLabel()
        is_digit = Emit_CreateLabel()
        
        Emit_CmpRaxImm8(48)                  // < '0'?
        Emit_Jl(loop_done)
        Emit_CmpRaxImm8(57)                  // > '9'?
        Emit_Jg(loop_done)
        
        // It's a digit: result = result * 10 + (c - '0')
        Emit_SubRaxImm8(48)                  // c - '0'
        Emit_PushRax()                       // save digit
        
        // R12 = R12 * 10
        Emit_MovRegReg(Reg.RAX, Reg.R12)
        Emit_MulRbx()                        // RDX:RAX = RAX * RBX
        Emit_MovRegReg(Reg.R12, Reg.RAX)
        
        // R12 = R12 + digit
        Emit_PopRax()
        Emit_AddRegReg(Reg.R12, Reg.RAX)
        
        // Next character
        Emit_IncRsi()
        Emit_Jmp(digit_loop)
        
        Emit_MarkLabel(loop_done)
        
        // Apply sign
        apply_sign = Emit_CreateLabel()
        done = Emit_CreateLabel()
        
        Emit_TestRegReg(Reg.R13, Reg.R13)
        Emit_Je(done)
        Emit_NegReg(Reg.R12)                 // negate if negative
        
        Emit_MarkLabel(done)
        
        // Result in RAX
        Emit_MovRegReg(Reg.RAX, Reg.R12)
        
        // Restore callee-saved
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}



// =============================================================================
// STRINGSUBSTRING(str, start, length) -> new string
// =============================================================================
Function.CompileStringCore_Substring {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 3) ThenBlock: {
            Compile_Error("StringSubstring requires 3 arguments", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)  // str
        arg1 = AST_GetChild(node, 1)  // start
        arg2 = AST_GetChild(node, 2)  // length
        
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushR14()
        
        // Compile args and save on stack
        Compile_Expression(arg0)
        Emit_PushRax()
        
        Compile_Expression(arg1)
        Emit_PushRax()
        
        Compile_Expression(arg2)
        Emit_PushRax()
        
        // Pop into registers
        Emit_PopR14()   // length
        Emit_PopR13()   // start
        Emit_PopR12()   // str
        
        // Find Arena_Alloc early
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            Compile_Error("Arena_Alloc not found - ensure LibraryImport.Arena", AST_GetLine(node))
            ReturnValue(0)
        }
        
        // Labels
        null_case = Emit_CreateLabel()
        empty_result = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        copy_loop = Emit_CreateLabel()
        copy_done = Emit_CreateLabel()
        
        // NULL check
        Emit_TestR12R12()
        Emit_Jz(null_case)
        
        // Bounds: start >= 0
        Emit_TestR13R13()
        Emit_Js(empty_result)
        
        // length > 0 check
        Emit_TestRegReg(Reg.R14, Reg.R14)
        Emit_Jz(empty_result)
        Emit_Js(empty_result)
        
        // RBX = length
        Emit_MovRbxR14()
        
        // Save registers across Arena call
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushRbx()
        
        // --- Arena allocation ---
        Emit_MovR11Rsp()
        Emit_AndRspImm8(240)
        
        // Size = length + 1
        Emit_MovRdiRbx()
        Emit_IncRdi()
        
        Emit_Call(arena_label)
        
        Emit_MovRspR11()
        
        // Restore registers
        Emit_PopRbx()
        Emit_PopR13()
        Emit_PopR12()
        // --- End arena allocation ---
        
        // RAX = buffer
        Emit_MovRdiRax()
        Emit_PushRdi()  // save for return
        
        // RSI = str + start
        Emit_MovRsiR12()
        Emit_AddRsiR13()
        
        // RCX = length
        Emit_MovRcxRbx()
        
        // Copy loop
        Emit_MarkLabel(copy_loop)
        Emit_TestRcxRcx()
        Emit_Jz(copy_done)
        
        Emit_MovAlDerefRsi()
        Emit_TestAlAl()
        Emit_Jz(copy_done)
        
        Emit_MovDerefRdiAl()
        Emit_IncRsi()
        Emit_IncRdi()
        Emit_DecRcx()
        Emit_Jmp(copy_loop)
        
        Emit_MarkLabel(copy_done)
        Emit_MovByteDerefRdiZero()
        
        Emit_PopRax()
        Emit_Jmp(done_label)
        
        Emit_MarkLabel(empty_result)
        Emit_MarkLabel(null_case)
        // Return empty string via Arena_Alloc(1)
        Emit_MovR11Rsp()
        Emit_AndRspImm8(240)
        Emit_MovRdiImm64(1)
        Emit_Call(arena_label)
        Emit_MovRspR11()
        
        Emit_MovRdiRax()
        Emit_MovByteDerefRdiZero()
        
        Emit_MarkLabel(done_label)
        
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGCHARAT(str, index) -> ASCII code
// =============================================================================
Function.CompileStringCore_CharAt {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            Compile_Error("StringCharAt requires 2 arguments", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)  // str
        arg1 = AST_GetChild(node, 1)  // index
        
        Emit_PushRbx()
        
        // Get index first
        Compile_Expression(arg1)
        Emit_MovRbxRax()
        
        // Get string
        Compile_Expression(arg0)
        
        // NULL check
        null_label = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        Emit_TestRaxRax()
        Emit_Jz(null_label)
        
        // RAX = str + index
        Emit_AddRaxRbx()
        
        // Zero-extend byte to RAX
        Emit_MovzxRaxByteDerefRax()
        Emit_Jmp(done_label)
        
        Emit_MarkLabel(null_label)
        Emit_XorRaxRax()
        
        Emit_MarkLabel(done_label)
        Emit_PopRbx()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGFROMCHAR(ascii) -> single char string
// =============================================================================
Function.CompileStringCore_FromChar {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("StringFromChar requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        // Get ASCII code
        Compile_Expression(arg0)
        Emit_PushRax()
        
        // Arena_Alloc(2)
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            Compile_Error("Arena_Alloc not found", AST_GetLine(node))
            ReturnValue(0)
        }
        
        Emit_MovRegReg(Reg.R12, Reg.RSP)
        Emit_AndRspImm8(240)
        
        Emit_MovRdiImm64(2)
        Emit_Call(arena_label)
        
        Emit_MovRegReg(Reg.RSP, Reg.R12)
        
        Emit_MovRdiRax()
        Emit_PopRax()
        
        // Store char and null
        Emit_MovDerefRdiAl()
        Emit_IncRdi()
        Emit_MovByteDerefRdiZero()
        Emit_DecRdi()
        
        Emit_MovRaxRdi()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGTOUPPER(str) -> new uppercase string
// =============================================================================
Function.CompileStringCore_ToUpper {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("StringToUpper requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        
        // Get string
        Compile_Expression(arg0)
        Emit_MovR12Rax()  // R12 = source
        
        // Calculate length
        Emit_MovRdiR12()
        Emit_XorRcxRcx()
        
        len_loop = Emit_CreateLabel()
        len_done = Emit_CreateLabel()
        
        Emit_MarkLabel(len_loop)
        Emit_CmpByteDerefRdiRcxZero()
        Emit_Je(len_done)
        Emit_IncRcx()
        Emit_Jmp(len_loop)
        Emit_MarkLabel(len_done)
        
        Emit_MovRbxRcx()  // RBX = length
        
        // Arena_Alloc(length + 1)
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            Compile_Error("Arena_Alloc not found", AST_GetLine(node))
            ReturnValue(0)
        }
        
        Emit_MovRegReg(Reg.R13, Reg.RSP)
        Emit_AndRspImm8(240)
        
        Emit_MovRdiRbx()
        Emit_IncRdi()
        Emit_Call(arena_label)
        
        Emit_MovRegReg(Reg.RSP, Reg.R13)
        
        Emit_MovRdiRax()
        Emit_PushRdi()  // save result
        Emit_MovRsiR12()
        
        // Copy and convert
        copy_loop = Emit_CreateLabel()
        copy_done = Emit_CreateLabel()
        not_lower = Emit_CreateLabel()
        
        Emit_MarkLabel(copy_loop)
        Emit_MovAlDerefRsi()
        Emit_TestAlAl()
        Emit_Jz(copy_done)
        
        // Check if 'a'-'z' (97-122)
        Emit_CmpAlImm8(97)
        Emit_Jb(not_lower)
        Emit_CmpAlImm8(122)
        Emit_Ja(not_lower)
        
        // Convert: subtract 32
        Emit_SubAlImm8(32)
        
        Emit_MarkLabel(not_lower)
        Emit_MovDerefRdiAl()
        Emit_IncRsi()
        Emit_IncRdi()
        Emit_Jmp(copy_loop)
        
        Emit_MarkLabel(copy_done)
        Emit_MovByteDerefRdiZero()
        
        Emit_PopRax()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGTOLOWER(str) -> new lowercase string
// =============================================================================
Function.CompileStringCore_ToLower {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("StringToLower requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        
        Compile_Expression(arg0)
        Emit_MovR12Rax()
        
        // Calculate length
        Emit_MovRdiR12()
        Emit_XorRcxRcx()
        
        len_loop = Emit_CreateLabel()
        len_done = Emit_CreateLabel()
        
        Emit_MarkLabel(len_loop)
        Emit_CmpByteDerefRdiRcxZero()
        Emit_Je(len_done)
        Emit_IncRcx()
        Emit_Jmp(len_loop)
        Emit_MarkLabel(len_done)
        
        Emit_MovRbxRcx()
        
        // Arena_Alloc(length + 1)
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            Compile_Error("Arena_Alloc not found", AST_GetLine(node))
            ReturnValue(0)
        }
        
        Emit_MovRegReg(Reg.R13, Reg.RSP)
        Emit_AndRspImm8(240)
        
        Emit_MovRdiRbx()
        Emit_IncRdi()
        Emit_Call(arena_label)
        
        Emit_MovRegReg(Reg.RSP, Reg.R13)
        
        Emit_MovRdiRax()
        Emit_PushRdi()
        Emit_MovRsiR12()
        
        copy_loop = Emit_CreateLabel()
        copy_done = Emit_CreateLabel()
        not_upper = Emit_CreateLabel()
        
        Emit_MarkLabel(copy_loop)
        Emit_MovAlDerefRsi()
        Emit_TestAlAl()
        Emit_Jz(copy_done)
        
        // Check if 'A'-'Z' (65-90)
        Emit_CmpAlImm8(65)
        Emit_Jb(not_upper)
        Emit_CmpAlImm8(90)
        Emit_Ja(not_upper)
        
        // Convert: add 32
        Emit_AddAlImm8(32)
        
        Emit_MarkLabel(not_upper)
        Emit_MovDerefRdiAl()
        Emit_IncRsi()
        Emit_IncRdi()
        Emit_Jmp(copy_loop)
        
        Emit_MarkLabel(copy_done)
        Emit_MovByteDerefRdiZero()
        
        Emit_PopRax()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// STRINGTRIM(str) -> new trimmed string
// =============================================================================
Function.CompileStringCore_Trim {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 1) ThenBlock: {
            Compile_Error("StringTrim requires 1 argument", AST_GetLine(node))
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushR14()
        
        Compile_Expression(arg0)
        Emit_MovRdiRax()
        
        // NULL check
        null_case = Emit_CreateLabel()
        done_label = Emit_CreateLabel()
        
        Emit_TestRdiRdi()
        Emit_Jz(null_case)
        
        // Find start (skip leading whitespace)
        start_loop = Emit_CreateLabel()
        start_done = Emit_CreateLabel()
        
        Emit_MarkLabel(start_loop)
        Emit_MovAlDerefRdi()
        Emit_TestAlAl()
        Emit_Jz(start_done)
        Emit_CmpAlImm8(32)  // space
        Emit_Ja(start_done)
        Emit_IncRdi()
        Emit_Jmp(start_loop)
        Emit_MarkLabel(start_done)
        
        Emit_MovR12Rdi()  // R12 = start of trimmed
        
        // Find end of string
        Emit_MovRdiR12()
        end_find = Emit_CreateLabel()
        end_found = Emit_CreateLabel()
        
        Emit_MarkLabel(end_find)
        Emit_MovAlDerefRdi()
        Emit_TestAlAl()
        Emit_Jz(end_found)
        Emit_IncRdi()
        Emit_Jmp(end_find)
        Emit_MarkLabel(end_found)
        
        // Scan backwards for non-whitespace
        end_loop = Emit_CreateLabel()
        end_done = Emit_CreateLabel()
        
        Emit_MarkLabel(end_loop)
        Emit_CmpRdiR12()
        Emit_Jbe(end_done)
        Emit_DecRdi()
        Emit_MovAlDerefRdi()
        Emit_CmpAlImm8(32)
        Emit_Ja(end_done)
        Emit_Jmp(end_loop)
        Emit_MarkLabel(end_done)
        
        Emit_IncRdi()
        Emit_MovR13Rdi()  // R13 = end
        
        // Length = end - start
        Emit_MovRcxR13()
        Emit_SubRcxR12()
        
        // Arena_Alloc(length + 1)
        arena_label = Compile_FindFunction("Arena_Alloc")
        IfCondition LessThan(arena_label, 0) ThenBlock: {
            Compile_Error("Arena_Alloc not found", AST_GetLine(node))
            ReturnValue(0)
        }
        
        Emit_PushRcx()
        
        Emit_MovRegReg(Reg.R14, Reg.RSP)
        Emit_AndRspImm8(240)
        
        Emit_MovRdiRcx()
        Emit_IncRdi()
        Emit_Call(arena_label)
        
        Emit_MovRegReg(Reg.RSP, Reg.R14)
        
        Emit_MovRdiRax()
        Emit_PushRdi()
        Emit_MovRsiR12()
        Emit_PopRdi()
        Emit_PushRdi()
        Emit_PopRax()
        Emit_PushRax()
        Emit_MovRdiRax()
        Emit_PopRcx()
        Emit_PushRcx()
        
        // Simple copy with REP MOVSB would be ideal but use loop
        Emit_PopRdi()
        Emit_PopRcx()
        Emit_PushRdi()
        
        copy_loop = Emit_CreateLabel()
        copy_done = Emit_CreateLabel()
        
        Emit_MarkLabel(copy_loop)
        Emit_TestRcxRcx()
        Emit_Jz(copy_done)
        Emit_MovAlDerefRsi()
        Emit_MovDerefRdiAl()
        Emit_IncRsi()
        Emit_IncRdi()
        Emit_DecRcx()
        Emit_Jmp(copy_loop)
        
        Emit_MarkLabel(copy_done)
        Emit_MovByteDerefRdiZero()
        
        Emit_PopRax()
        Emit_Jmp(done_label)
        
        Emit_MarkLabel(null_case)
        // Return empty
        Emit_MovRegReg(Reg.R14, Reg.RSP)
        Emit_AndRspImm8(240)
        Emit_MovRdiImm64(1)
        Emit_Call(arena_label)
        Emit_MovRegReg(Reg.RSP, Reg.R14)
        
        Emit_MovRdiRax()
        Emit_MovByteDerefRdiZero()
        
        Emit_MarkLabel(done_label)
        
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
        
        Compile.nodes_compiled = Add(Compile.nodes_compiled, 1)
        ReturnValue(1)
    }
}