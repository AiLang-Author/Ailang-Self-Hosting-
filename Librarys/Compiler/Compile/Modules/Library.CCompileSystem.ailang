// Library.CCompileSystem.ailang
// System call compilation for the AILang self-hosting compiler
// Mirrors syscall_handler.py logic using Emit_* emit functions
// Location: Librarys/Compiler/Compile/Modules/Library.CCompileSystem.ailang

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.Compile.CCompileMain
LibraryImport.Compiler.Compile.Modules.CSysDispatch
LibraryImport.Compiler.Compile.Modules.CHaikuEmit

// =============================================================================
// DISPATCHER
// Returns 1 if handled, 0 if not this module's responsibility
// =============================================================================

Function.CompileSystem_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        func_name = AST_GetData1(node)
        
        IfCondition EqualTo(func_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        cmp = StringCompare(func_name, "SystemCall")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            result = CompileSystem_Syscall(node, 0)
            ReturnValue(result)
        }

        // Untranslated SYSCALL with native numbers (the --haiku runtime shim).
        cmp = StringCompare(func_name, "HaikuSyscall")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            result = CompileSystem_Syscall(node, 1)
            ReturnValue(result)
        }

        cmp = StringCompare(func_name, "HaikuAnonMap")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            result = CompileSystem_HaikuAnonMap(node)
            ReturnValue(result)
        }
        
        cmp = StringCompare(func_name, "Exit")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            result = CompileSystem_Exit(node)
            ReturnValue(result)
        }
        
        cmp = StringCompare(func_name, "HaltProgram")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            result = CompileSystem_Halt(node)
            ReturnValue(result)
        }
        
        cmp = StringCompare(func_name, "ProcessExit")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            result = CompileSystem_ProcessExit(node)
            ReturnValue(result)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// SYSCALL COMPILATION
// Mirrors syscall_handler.py exactly:
// 1. Zero all argument registers
// 2. Compile args and push to stack (prevents clobbering)
// 3. Pop into argument registers in reverse order
// 4. Load syscall number into RAX last
// 5. Execute syscall instruction
// Result left in RAX for caller
// =============================================================================

Function.CompileSystem_Syscall {
    Input: node: Address
    Input: raw: Integer
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        
        IfCondition LessThan(arg_count, 1) ThenBlock: {
            Compile_Error("SystemCall requires at least syscall number", 0)
            ReturnValue(0)
        }
        
        num_syscall_args = Subtract(arg_count, 1)
        
        IfCondition GreaterThan(num_syscall_args, 6) ThenBlock: {
            // The Linux shim path stays at 6. Raw HaikuSyscall may pass
            // 7 or 8; _kern_load_image is the one that needs 8.
            IfCondition EqualTo(raw, 0) ThenBlock: {
                Compile_Error("SystemCall supports max 6 arguments", 0)
                ReturnValue(0)
            }
            IfCondition GreaterThan(num_syscall_args, 8) ThenBlock: {
                Compile_Error("HaikuSyscall supports max 8 arguments", 0)
                ReturnValue(0)
            }
        }
        
        // Step 1: Zero ALL syscall argument registers
        Emit_XorRdiRdi()
        Emit_XorRsiRsi()
        Emit_XorRdxRdx()
        Emit_XorR10R10()
        Emit_XorR8R8()
        Emit_XorR9R9()
        
        // Step 2: Compile all arguments and push to stack
        // Args are at indices 1..num_syscall_args (index 0 is syscall number)
        i = 1
        push_limit = Add(num_syscall_args, 1)
        WhileLoop LessThan(i, push_limit) {
            arg = AST_GetChild(node, i)
            Compile_Expression(arg)
            Emit_PushRax()
            i = Add(i, 1)
        }

        // 7 and 8 argument raw Haiku path. The pop loop below is unchanged,
        // so a Linux program's syscall bytes stay the same.
        IfCondition GreaterThan(num_syscall_args, 6) ThenBlock: {
            Haiku_EmitSyscall7Plus(num_syscall_args)
            syscall_num_node = AST_GetChild(node, 0)
            Compile_Expression(syscall_num_node)
            Emit_SysInstr()
            Emit_AddRspImm8(32)
            ReturnValue(1)
        }
        
        // Step 3: Pop from stack into registers in REVERSE order
        // Syscall ABI: RDI=arg1, RSI=arg2, RDX=arg3, R10=arg4, R8=arg5, R9=arg6
        j = num_syscall_args
        WhileLoop GreaterThan(j, 0) {
            IfCondition EqualTo(j, 1) ThenBlock: {
                Emit_PopRdi()
            }
            IfCondition EqualTo(j, 2) ThenBlock: {
                Emit_PopRsi()
            }
            IfCondition EqualTo(j, 3) ThenBlock: {
                Emit_PopRdx()
            }
            IfCondition EqualTo(j, 4) ThenBlock: {
                Emit_PopR10()
            }
            IfCondition EqualTo(j, 5) ThenBlock: {
                Emit_PopR8()
            }
            IfCondition EqualTo(j, 6) ThenBlock: {
                Emit_PopR9()
            }
            j = Subtract(j, 1)
        }
        
        // Step 4: Load syscall number into RAX (do this LAST)
        syscall_num_node = AST_GetChild(node, 0)
        Compile_Expression(syscall_num_node)
        
        // Step 5: Execute syscall instruction (--haiku: via the runtime shim)
        IfCondition EqualTo(raw, 1) ThenBlock: {
            Emit_SysInstr()
        } ElseBlock: {
            Emit_OsSyscall()
        }
        
        ReturnValue(1)
    }
}

// HaikuAnonMap(len, prot) -> address or -ENOMEM. Haiku targets only.
Function.CompileSystem_HaikuAnonMap {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: {
            Compile_Error("HaikuAnonMap requires (len, prot)", AST_GetLine(node))
            ReturnValue(0)
        }
        IfCondition NotEqual(Emit.os, OS.HAIKU) ThenBlock: {
            Compile_Error("HaikuAnonMap is only available with --haiku", AST_GetLine(node))
            ReturnValue(0)
        }
        Compile_Expression(AST_GetChild(node, 0))
        Emit_PushRax()
        Compile_Expression(AST_GetChild(node, 1))
        Emit_MovRegReg(Reg.RDX, Reg.RAX)
        Emit_PopRsi()
        Haiku_EmitAnonMap()
        ReturnValue(1)
    }
}

// =============================================================================
// EXIT WRAPPER
// Exit(code) -> Sys_Exit() (portable)
// Exit() with no args -> exit(0)
// =============================================================================

Function.CompileSystem_Exit {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        
        IfCondition EqualTo(arg_count, 0) ThenBlock: {
            Emit_XorRdiRdi()
        } ElseBlock: {
            code_node = AST_GetChild(node, 0)
            Compile_Expression(code_node)
            Emit_MovRdiRax()
        }
        
        // Portable: Sys_Exit() handles syscall number + instruction
        Sys_Exit()
        
        ReturnValue(1)
    }
}

// =============================================================================
// PROCESS EXIT WRAPPER
// ProcessExit(code) -> Sys_ExitGroup() (portable)
// ProcessExit() with no args -> exit_group(0)
// Terminates entire process including all threads
// =============================================================================

Function.CompileSystem_ProcessExit {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        
        IfCondition EqualTo(arg_count, 0) ThenBlock: {
            Emit_XorRdiRdi()
        } ElseBlock: {
            code_node = AST_GetChild(node, 0)
            Compile_Expression(code_node)
            Emit_MovRdiRax()
        }
        
        // Portable: Sys_ExitGroup() handles syscall number + instruction
        Sys_ExitGroup()
        
        ReturnValue(1)
    }
}

// =============================================================================
// HALT WRAPPER
// HaltProgram -> exit(0) (portable)
// =============================================================================

Function.CompileSystem_Halt {
    Input: node: Address
    Output: Integer
    Body: {
        Emit_XorRdiRdi()
        
        // Portable: Sys_Exit() handles syscall number + instruction
        Sys_Exit()
        
        ReturnValue(1)
    }
}